+  <script>
+    (function () {
+      const panel = document.querySelector('.seasonal-panel');
+      const tocLinks = Array.from(document.querySelectorAll('.toc-sidebar a[href^="#"]'));
+      const sections = Array.from(document.querySelectorAll('.seasonal-panel .drink-section'));
+
+      if (!panel || !tocLinks.length || !sections.length) return;
+
+      let pendingTargetId = null;
+      let pendingTimer = null;
+
+      function setActiveSection(activeId) {
+        if (!activeId) return;
+
+        tocLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === '#' + activeId;
+          link.classList.toggle('active', isMatch);
+          if (link.parentElement && link.parentElement.tagName === 'LI') {
+            link.parentElement.classList.toggle('active', isMatch);
+          }
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        sections.forEach((section) => {
+          if (section.id === activeId) {
+            section.setAttribute('data-active', 'true');
+          } else {
+            section.removeAttribute('data-active');
+          }
+        });
+      }
+
+      function getTargetScrollTop(section) {
+        const panelRect = panel.getBoundingClientRect();
+        const sectionRect = section.getBoundingClientRect();
+        return panel.scrollTop + (sectionRect.top - panelRect.top);
+      }
+
+      function updateActiveFromScroll() {
+        const panelRect = panel.getBoundingClientRect();
+
+        if (pendingTargetId) {
+          const targetSection = document.getElementById(pendingTargetId);
+          if (targetSection) {
+            const dist = Math.abs(targetSection.getBoundingClientRect().top - panelRect.top);
+            if (dist <= 6) {
+              pendingTargetId = null;
+              if (pendingTimer) {
+                clearTimeout(pendingTimer);
+                pendingTimer = null;
+              }
+            } else {
+              return;
+            }
+          }
+        }
+
+        let closestSection = sections[0];
+        let minDistance = Infinity;
+
+        sections.forEach((section) => {
+          const distance = Math.abs(section.getBoundingClientRect().top - panelRect.top);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestSection = section;
+          }
+        });
+
+        if (closestSection && closestSection.id) {
+          setActiveSection(closestSection.id);
+        }
+      }
+
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const href = link.getAttribute('href');
+          if (!href || !href.startsWith('#')) return;
+
+          const targetId = href.slice(1);
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          event.preventDefault();
+
+          pendingTargetId = targetId;
+          if (pendingTimer) clearTimeout(pendingTimer);
+          pendingTimer = setTimeout(() => {
+            pendingTargetId = null;
+            pendingTimer = null;
+          }, 700);
+
+          setActiveSection(targetId);
+
+          const targetTop = getTargetScrollTop(targetSection);
+          panel.scrollTo({
+            top: targetTop,
+            behavior: 'smooth'
+          });
+
+          if (history.replaceState) {
+            history.replaceState(null, '', href);
+          }
+        });
+      });
+
+      panel.addEventListener('scroll', updateActiveFromScroll, { passive: true });
+      panel.addEventListener('scrollend', () => {
+        pendingTargetId = null;
+        if (pendingTimer) {
+          clearTimeout(pendingTimer);
+          pendingTimer = null;
+        }
+        updateActiveFromScroll();
+      }, { passive: true });
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            if (pendingTargetId) return;
+            let bestEntry = null;
+            entries.forEach((entry) => {
+              if (entry.isIntersecting) {
+                if (!bestEntry || entry.intersectionRatio > bestEntry.intersectionRatio) {
+                  bestEntry = entry;
+                }
+              }
+            });
+            if (bestEntry && bestEntry.intersectionRatio >= 0.5 && bestEntry.target.id) {
+              setActiveSection(bestEntry.target.id);
+            } else {
+              updateActiveFromScroll();
+            }
+          },
+          {
+            root: panel,
+            threshold: [0.25, 0.5, 0.75, 0.9]
+          }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      updateActiveFromScroll();
+    })();
+  </script>
 </body>
 
