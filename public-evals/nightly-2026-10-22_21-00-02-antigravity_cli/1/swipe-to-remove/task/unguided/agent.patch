+  <script>
+    (function () {
+      const list = document.querySelector('.SwipeableList');
+      if (!list) return;
+
+      const SWIPE_THRESHOLD_RATIO = 0.3;
+      const MIN_THRESHOLD_PX = 80;
+
+      function collapseAndRemoveItem(item, content, direction) {
+        if (item.dataset.removing === 'true') return;
+        item.dataset.removing = 'true';
+
+        const width = item.offsetWidth || 300;
+        const height = item.offsetHeight;
+
+        item.style.height = height + 'px';
+        item.style.maxHeight = height + 'px';
+        item.classList.add('is-threshold-reached');
+
+        content.classList.remove('is-dragging');
+        content.style.transform = `translateX(${direction * width}px)`;
+
+        // Force reflow so height transition starts cleanly from current height
+        void item.offsetHeight;
+
+        requestAnimationFrame(() => {
+          item.classList.add('is-collapsing');
+        });
+
+        let cleanedUp = false;
+        const cleanup = () => {
+          if (cleanedUp) return;
+          cleanedUp = true;
+          item.remove();
+          if (list.querySelectorAll('.SwipeableList-item').length === 0) {
+            const emptyMsg = document.getElementById('cart-empty');
+            if (emptyMsg) emptyMsg.style.display = 'block';
+          }
+        };
+
+        item.addEventListener('transitionend', (e) => {
+          if (e.target === item && (e.propertyName === 'height' || e.propertyName === 'max-height')) {
+            cleanup();
+          }
+        });
+
+        setTimeout(cleanup, 350);
+      }
+
+      function attachSwipeHandlers(item) {
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        if (!track || !content) return;
+
+        let startX = 0;
+        let currentX = 0;
+        let isDragging = false;
+        let activePointerId = null;
+
+        function getThreshold() {
+          return Math.max(MIN_THRESHOLD_PX, (item.offsetWidth || 300) * SWIPE_THRESHOLD_RATIO);
+        }
+
+        function onStart(clientX, pointerId) {
+          if (item.dataset.removing === 'true') return;
+          isDragging = true;
+          startX = clientX;
+          currentX = 0;
+          activePointerId = pointerId;
+          content.classList.add('is-dragging');
+        }
+
+        function onMove(clientX) {
+          if (!isDragging) return;
+          currentX = clientX - startX;
+          content.style.transform = `translateX(${currentX}px)`;
+
+          const threshold = getThreshold();
+          if (Math.abs(currentX) >= threshold) {
+            item.classList.add('is-threshold-reached');
+          } else {
+            item.classList.remove('is-threshold-reached');
+          }
+        }
+
+        function onEnd() {
+          if (!isDragging) return;
+          isDragging = false;
+          activePointerId = null;
+          content.classList.remove('is-dragging');
+
+          const threshold = getThreshold();
+          if (Math.abs(currentX) >= threshold) {
+            const direction = currentX >= 0 ? 1 : -1;
+            collapseAndRemoveItem(item, content, direction);
+          } else {
+            item.classList.remove('is-threshold-reached');
+            content.style.transform = 'translateX(0px)';
+          }
+          currentX = 0;
+        }
+
+        item.addEventListener('pointerdown', (e) => {
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          onStart(e.clientX, e.pointerId);
+          if (item.setPointerCapture && e.pointerId !== undefined) {
+            try {
+              item.setPointerCapture(e.pointerId);
+            } catch (_) {}
+          }
+        });
+
+        item.addEventListener('pointermove', (e) => {
+          if (!isDragging || (activePointerId !== null && e.pointerId !== activePointerId)) return;
+          onMove(e.clientX);
+        });
+
+        item.addEventListener('pointerup', (e) => {
+          if (activePointerId !== null && e.pointerId !== activePointerId) return;
+          onEnd();
+        });
+
+        item.addEventListener('pointercancel', (e) => {
+          if (activePointerId !== null && e.pointerId !== activePointerId) return;
+          onEnd();
+        });
+
+        // Fallback mouse events if pointer events are not used
+        item.addEventListener('mousedown', (e) => {
+          if (isDragging || e.button !== 0) return;
+          onStart(e.clientX, 'mouse');
+          const handleMouseMove = (moveEvent) => {
+            if (!isDragging || activePointerId !== 'mouse') return;
+            onMove(moveEvent.clientX);
+          };
+          const handleMouseUp = () => {
+            window.removeEventListener('mousemove', handleMouseMove);
+            window.removeEventListener('mouseup', handleMouseUp);
+            if (!isDragging || activePointerId !== 'mouse') return;
+            onEnd();
+          };
+          window.addEventListener('mousemove', handleMouseMove);
+          window.addEventListener('mouseup', handleMouseUp);
+        });
+
+        // Fallback touch events for environments dispatching TouchEvents directly
+        item.addEventListener('touchstart', (e) => {
+          if (isDragging || !e.touches || !e.touches[0]) return;
+          onStart(e.touches[0].clientX, null);
+        }, { passive: true });
+
+        item.addEventListener('touchmove', (e) => {
+          if (!isDragging || activePointerId !== null || !e.touches || !e.touches[0]) return;
+          onMove(e.touches[0].clientX);
+        }, { passive: true });
+
+        item.addEventListener('touchend', () => {
+          if (!isDragging || activePointerId !== null) return;
+          onEnd();
+        });
+
+        item.addEventListener('touchcancel', () => {
+          if (!isDragging || activePointerId !== null) return;
+          onEnd();
+        });
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(attachSwipeHandlers);
+    })();
+  </script>
