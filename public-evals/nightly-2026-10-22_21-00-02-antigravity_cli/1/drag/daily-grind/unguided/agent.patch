+  <div id="floating-widget" class="floating-element draggable" role="region" aria-label="Draggable Daily Perks Widget">
+    <div class="floating-header">
+      <span>☕ Daily Grind Perks</span>
+      <span class="drag-handle-icon" title="Drag to move">⋮⋮</span>
+    </div>
+    <div class="floating-body">
+      <span class="floating-badge">DOUBLE BEANS TODAY</span>
+      <p>Order any seasonal drink and earn 2x loyalty points! Drag this card anywhere on the screen.</p>
+      <a href="/rewards" class="btn" style="margin-top: 4px; padding: 6px 14px; font-size: 0.8rem;">Claim Offer</a>
+    </div>
+  </div>
+
+  <script>
+    (function () {
+      const floatingEl = document.getElementById('floating-widget');
+      if (!floatingEl) return;
+
+      let isDragging = false;
+      let startX = 0;
+      let startY = 0;
+      let initialLeft = 0;
+      let initialTop = 0;
+
+      function startDrag(clientX, clientY, target) {
+        if (isDragging) return true;
+        if (target && target.closest('a, button, input, textarea, select')) {
+          return false;
+        }
+        const rect = floatingEl.getBoundingClientRect();
+        isDragging = true;
+        startX = clientX;
+        startY = clientY;
+        initialLeft = rect.left;
+        initialTop = rect.top;
+
+        floatingEl.style.left = initialLeft + 'px';
+        floatingEl.style.top = initialTop + 'px';
+        floatingEl.style.right = 'auto';
+        floatingEl.style.bottom = 'auto';
+        floatingEl.classList.add('dragging');
+        return true;
+      }
+
+      function onMove(clientX, clientY) {
+        if (!isDragging) return;
+        const dx = clientX - startX;
+        const dy = clientY - startY;
+        floatingEl.style.left = (initialLeft + dx) + 'px';
+        floatingEl.style.top = (initialTop + dy) + 'px';
+      }
+
+      function stopDrag() {
+        if (!isDragging) return;
+        isDragging = false;
+        floatingEl.classList.remove('dragging');
+      }
+
+      // Mouse events
+      floatingEl.addEventListener('mousedown', function (e) {
+        if (e.button !== 0) return;
+        if (startDrag(e.clientX, e.clientY, e.target)) {
+          e.preventDefault();
+        }
+      });
+
+      window.addEventListener('mousemove', function (e) {
+        if (!isDragging) return;
+        onMove(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('mouseup', stopDrag);
+
+      // Pointer events (for modern pointer automation / touch / pen)
+      floatingEl.addEventListener('pointerdown', function (e) {
+        if (e.pointerType === 'mouse' && e.button !== 0) return;
+        startDrag(e.clientX, e.clientY, e.target);
+      });
+
+      window.addEventListener('pointermove', function (e) {
+        if (!isDragging) return;
+        onMove(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('pointerup', stopDrag);
+      window.addEventListener('pointercancel', stopDrag);
+
+      // Touch events fallback
+      floatingEl.addEventListener('touchstart', function (e) {
+        if (e.touches.length !== 1) return;
+        const touch = e.touches[0];
+        startDrag(touch.clientX, touch.clientY, e.target);
+      }, { passive: true });
+
+      window.addEventListener('touchmove', function (e) {
+        if (!isDragging || e.touches.length !== 1) return;
+        const touch = e.touches[0];
+        onMove(touch.clientX, touch.clientY);
+      }, { passive: true });
+
+      window.addEventListener('touchend', stopDrag);
+    })();
+  </script>
+
