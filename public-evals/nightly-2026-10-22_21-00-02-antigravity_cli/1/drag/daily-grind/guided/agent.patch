+  <aside class="floating-widget" id="order-tracker" aria-label="Quick Order Tracker">
+    <div class="floating-widget-header" id="order-tracker-handle">
+      <span>Quick Order Pickup</span>
+      <span class="drag-grip" aria-hidden="true">⋮⋮</span>
+    </div>
+    <div class="floating-widget-body">
+      <p>Skip the line! Current pickup wait time at Downtown Roastery:</p>
+      <div class="widget-status">
+        <span>Estimated Wait</span>
+        <strong>~4 mins</strong>
+      </div>
+      <a href="/order-online" class="btn">Start Mobile Order</a>
+    </div>
+  </aside>
+
+  <script>
+    (() => {
+      const draggable = document.getElementById('order-tracker');
+      const handle = document.getElementById('order-tracker-handle');
+      if (!draggable || !handle) return;
+
+      // Progressive enhancement: attach drag affordances and keyboard accessibility when JS initializes
+      handle.classList.add('drag-handle');
+      handle.tabIndex = 0;
+      handle.setAttribute(
+        'aria-label',
+        'Quick Order Pickup — drag or use arrow keys to move panel'
+      );
+
+      let offsetX = 0;
+      let offsetY = 0;
+      let startX = 0;
+      let startY = 0;
+      let hasPositionedManually = false;
+      const DRAG_THRESHOLD = 4;
+      const KEYBOARD_STEP = 15;
+
+      function ensureTopLeftPositioning() {
+        if (hasPositionedManually) return;
+        const rect = draggable.getBoundingClientRect();
+        draggable.style.right = 'auto';
+        draggable.style.bottom = 'auto';
+        draggable.style.margin = '0';
+        draggable.style.left = `${rect.left}px`;
+        draggable.style.top = `${rect.top}px`;
+        hasPositionedManually = true;
+      }
+
+      function moveTo(left, top) {
+        ensureTopLeftPositioning();
+        const maxLeft = Math.max(0, window.innerWidth - draggable.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - draggable.offsetHeight);
+
+        draggable.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        draggable.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+      }
+
+      function reclampCurrentPosition() {
+        if (!hasPositionedManually) return;
+        const rect = draggable.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (
+          event.button !== 0 ||
+          event.target.closest('button, input, select, textarea, a')
+        ) {
+          return;
+        }
+
+        const rect = draggable.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+
+        if (!handle.classList.contains('dragging')) {
+          const movedDistance = Math.hypot(
+            event.clientX - startX,
+            event.clientY - startY
+          );
+          if (movedDistance < DRAG_THRESHOLD) return;
+          handle.classList.add('dragging');
+        }
+
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        handle.classList.remove('dragging');
+      });
+
+      handle.addEventListener('keydown', (event) => {
+        const deltas = {
+          ArrowLeft: [-KEYBOARD_STEP, 0],
+          ArrowRight: [KEYBOARD_STEP, 0],
+          ArrowUp: [0, -KEYBOARD_STEP],
+          ArrowDown: [0, KEYBOARD_STEP],
+        };
+
+        const delta = deltas[event.key];
+        if (!delta) return;
+
+        event.preventDefault();
+        const rect = draggable.getBoundingClientRect();
+        moveTo(rect.left + delta[0], rect.top + delta[1]);
+      });
+
+      window.addEventListener('resize', reclampCurrentPosition);
+
+      if (typeof ResizeObserver !== 'undefined') {
+        const resizeObserver = new ResizeObserver(reclampCurrentPosition);
+        resizeObserver.observe(draggable);
+      }
+    })();
+  </script>
+
