+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      if (!nav) return;
+
+      var supportsScrollTimeline =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('animation-timeline: scroll()');
+
+      // Fallback for browsers that do not support CSS Scroll-Driven Animations
+      if (!supportsScrollTimeline) {
+        var scrollRange = 150;
+        var ticking = false;
+
+        // Disable transition lag during continuous custom-property updates if supported
+        var supportsCustomProps =
+          typeof CSS !== 'undefined' &&
+          typeof CSS.supports === 'function' &&
+          CSS.supports('--scroll-progress: 0');
+
+        if (supportsCustomProps) {
+          nav.style.transition = 'none';
+          var logo = nav.querySelector('.logo');
+          if (logo) logo.style.transition = 'none';
+        }
+
+        function updateNavOnScroll() {
+          var scrollY = window.scrollY !== undefined ? window.scrollY : window.pageYOffset || 0;
+          var progress = Math.min(Math.max(scrollY / scrollRange, 0), 1);
+
+          // Continuous scroll-linked interpolation via CSS variable
+          nav.style.setProperty('--scroll-progress', progress.toFixed(4));
+
+          // Class-based fallback for older browsers without CSS variable / calc() support
+          if (!supportsCustomProps) {
+            if (scrollY > 50) {
+              nav.classList.add('scrolled');
+            } else {
+              nav.classList.remove('scrolled');
+            }
+          }
+
+          ticking = false;
+        }
+
+        window.addEventListener(
+          'scroll',
+          function () {
+            if (!ticking) {
+              if (window.requestAnimationFrame) {
+                window.requestAnimationFrame(updateNavOnScroll);
+              } else {
+                updateNavOnScroll();
+              }
+              ticking = true;
+            }
+          },
+          { passive: true }
+        );
+
+        updateNavOnScroll();
+      }
+    })();
+  </script>
