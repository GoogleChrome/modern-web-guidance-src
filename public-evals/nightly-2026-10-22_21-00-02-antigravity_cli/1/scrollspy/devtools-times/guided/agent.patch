diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..737c7ec
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,88 @@
+---
+export interface SectionItem {
+  id: string;
+  label: string;
+}
+
+export interface Props {
+  sections: SectionItem[];
+  ariaLabel?: string;
+  class?: string;
+}
+
+const { sections, ariaLabel = "Page sections", class: className = "" } = Astro.props;
+---
+
+<nav
+  aria-label={ariaLabel}
+  class:list={[
+    "scrollspy-nav sticky top-0 z-20 bg-white/95 backdrop-blur border-b border-gray-200",
+    className,
+  ]}
+>
+  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-6 overflow-x-auto text-sm">
+    {sections.map((section) => (
+      <a
+        href={`#${section.id}`}
+        class="py-3 border-b-2 border-transparent text-gray-600 hover:text-gray-900 whitespace-nowrap transition-colors"
+      >
+        {section.label}
+      </a>
+    ))}
+  </div>
+</nav>
+
+<script>
+  function initScrollspy() {
+    const navs = document.querySelectorAll<HTMLElement>("nav.scrollspy-nav");
+    if (!navs.length) return;
+
+    const supportsScrollTargetGroup = CSS.supports("scroll-target-group: auto");
+
+    navs.forEach((nav) => {
+      if (nav.dataset.scrollspyInitialized === "true") return;
+      nav.dataset.scrollspyInitialized = "true";
+
+      const navLinks = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
+      const sections = navLinks
+        .map((link) => {
+          const hash = link.getAttribute("href");
+          return hash ? document.getElementById(hash.slice(1)) : null;
+        })
+        .filter((el): el is HTMLElement => el !== null);
+
+      if (supportsScrollTargetGroup) {
+        const syncAriaCurrent = () => {
+          const currentLink = nav.querySelector<HTMLAnchorElement>("a:target-current");
+          navLinks.forEach((link) => {
+            link.setAttribute("aria-current", link === currentLink ? "true" : "false");
+          });
+        };
+
+        syncAriaCurrent();
+        document.addEventListener("scrollend", syncAriaCurrent);
+      } else {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            entries.forEach((entry) => {
+              if (entry.isIntersecting) {
+                const id = entry.target.getAttribute("id");
+                navLinks.forEach((link) => {
+                  const isActive = link.getAttribute("href") === `#${id}`;
+                  link.classList.toggle(":target-current", isActive);
+                  link.setAttribute("aria-current", String(isActive));
+                });
+              }
+            });
+          },
+          { rootMargin: "-50% 0px -50% 0px", threshold: 0 }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+      }
+    });
+  }
+
+  initScrollspy();
+  document.addEventListener("astro:page-load", initScrollspy);
+</script>
