+
+/* MANDATORY: The container of markers must have scroll-target-group: auto */
+nav.scrollspy-nav {
+  scroll-target-group: auto;
+}
+
+/* Combine native :target-current with fallback class .\:target-current using :is() so older browsers don't invalidate the rule */
+nav.scrollspy-nav a:is(:target-current, .\:target-current) {
+  color: var(--accent, #b45309);
+  border-bottom-color: var(--accent, #b45309);
+  font-weight: 700;
+}
