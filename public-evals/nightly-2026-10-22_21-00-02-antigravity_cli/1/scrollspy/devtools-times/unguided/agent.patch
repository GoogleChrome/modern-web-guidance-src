diff --git a/src/components/SectionNav.tsx b/src/components/SectionNav.tsx
new file mode 100644
index 0000000..4cf886e
--- /dev/null
+++ b/src/components/SectionNav.tsx
@@ -0,0 +1,290 @@
+import React, { useEffect, useState, useCallback } from 'react';
+
+export interface SectionNavItem {
+  id: string;
+  label: string;
+  level?: number;
+}
+
+interface SectionNavProps {
+  sections?: SectionNavItem[];
+  autoDetectSelector?: string;
+  variant?: 'bar' | 'sidebar' | 'auto';
+  title?: string;
+}
+
+function slugify(text: string): string {
+  return text
+    .toLowerCase()
+    .trim()
+    .replace(/[^\w\s-]/g, '')
+    .replace(/[\s_-]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+}
+
+const SectionNav: React.FC<SectionNavProps> = ({
+  sections: initialSections,
+  autoDetectSelector,
+  variant = 'bar',
+  title = 'On this page',
+}) => {
+  const [sections, setSections] = useState<SectionNavItem[]>(initialSections || []);
+  const [activeId, setActiveId] = useState<string>('');
+
+  // Discover sections if autoDetectSelector is provided or update when DOM changes
+  useEffect(() => {
+    if (initialSections && initialSections.length > 0) {
+      setSections(initialSections);
+      return;
+    }
+
+    const selector =
+      autoDetectSelector ||
+      'main section[id], main [data-section-nav], article h2, article h3, .prose h2, .prose h3';
+
+    const elements = Array.from(document.querySelectorAll<HTMLElement>(selector));
+    const detected: SectionNavItem[] = [];
+    const usedIds = new Set<string>();
+
+    elements.forEach((el, index) => {
+      const label =
+        el.getAttribute('data-section-title') ||
+        el.getAttribute('aria-label') ||
+        (el.tagName.match(/^H[1-6]$/)
+          ? el.textContent?.trim()
+          : el.querySelector('h1, h2, h3')?.textContent?.trim()) ||
+        '';
+
+      if (!label) return;
+
+      let id = el.id;
+      if (!id) {
+        const baseId = slugify(label) || `section-${index + 1}`;
+        id = baseId;
+        let counter = 2;
+        while (usedIds.has(id) || document.getElementById(id)) {
+          id = `${baseId}-${counter}`;
+          counter++;
+        }
+        el.id = id;
+      }
+
+      if (!usedIds.has(id)) {
+        usedIds.add(id);
+        const level = el.tagName === 'H3' ? 3 : 2;
+        detected.push({ id, label, level });
+      }
+    });
+
+    setSections(detected);
+  }, [initialSections, autoDetectSelector]);
+
+  // Compute currently visible section based on scroll and IntersectionObserver
+  const updateActiveSection = useCallback(() => {
+    if (sections.length === 0) return;
+
+    const elements = sections
+      .map((s) => document.getElementById(s.id))
+      .filter((el): el is HTMLElement => el !== null);
+
+    if (elements.length === 0) return;
+
+    // Check if scrolled to the very bottom of the page
+    const scrollBottom = window.innerHeight + window.scrollY;
+    const docHeight = document.documentElement.scrollHeight;
+    if (docHeight - scrollBottom <= 20) {
+      setActiveId(elements[elements.length - 1].id);
+      return;
+    }
+
+    const viewportHeight = window.innerHeight;
+    // Reference line around 25% from the top of the viewport (accounting for sticky header)
+    const triggerLine = Math.min(180, viewportHeight * 0.3);
+
+    // Find the section that spans across the trigger line or has most recently passed it
+    let candidateId = elements[0].id;
+    let bestVisibleOverlap = -1;
+    let bestOverlapId = '';
+
+    for (const el of elements) {
+      const rect = el.getBoundingClientRect();
+
+      // Calculate visible overlap in the upper-middle viewport zone (from 60px to 65% of viewport)
+      const zoneTop = 56;
+      const zoneBottom = viewportHeight * 0.65;
+      const overlapTop = Math.max(rect.top, zoneTop);
+      const overlapBottom = Math.min(rect.bottom, zoneBottom);
+      const overlap = Math.max(0, overlapBottom - overlapTop);
+
+      if (overlap > bestVisibleOverlap && overlap > 0) {
+        bestVisibleOverlap = overlap;
+        bestOverlapId = el.id;
+      }
+
+      if (rect.top <= triggerLine) {
+        candidateId = el.id;
+      }
+    }
+
+    // If a section is prominently occupying the active viewport zone and its top has entered the zone,
+    // or if it's a short heading/section that passed the trigger line:
+    const candidateEl = document.getElementById(candidateId);
+    if (candidateEl) {
+      const candidateRect = candidateEl.getBoundingClientRect();
+      // If candidate is still visible on screen (bottom > 80px), prefer candidateId if it's a heading or active container
+      if (candidateRect.bottom > 80) {
+        setActiveId(candidateId);
+        return;
+      }
+    }
+
+    if (bestOverlapId) {
+      setActiveId(bestOverlapId);
+    } else {
+      setActiveId(candidateId);
+    }
+  }, [sections]);
+
+  useEffect(() => {
+    if (sections.length === 0) return;
+
+    updateActiveSection();
+
+    const observer = new IntersectionObserver(
+      () => {
+        updateActiveSection();
+      },
+      {
+        root: null,
+        rootMargin: '-10% 0px -25% 0px',
+        threshold: [0, 0.1, 0.25, 0.5, 0.75, 1],
+      }
+    );
+
+    sections.forEach((section) => {
+      const el = document.getElementById(section.id);
+      if (el) observer.observe(el);
+    });
+
+    let ticking = false;
+    const handleScroll = () => {
+      if (!ticking) {
+        window.requestAnimationFrame(() => {
+          updateActiveSection();
+          ticking = false;
+        });
+        ticking = true;
+      }
+    };
+
+    window.addEventListener('scroll', handleScroll, { passive: true });
+    window.addEventListener('resize', handleScroll, { passive: true });
+
+    return () => {
+      observer.disconnect();
+      window.removeEventListener('scroll', handleScroll);
+      window.removeEventListener('resize', handleScroll);
+    };
+  }, [sections, updateActiveSection]);
+
+  const handleNavClick = (e: React.MouseEvent<HTMLAnchorElement>, id: string) => {
+    e.preventDefault();
+    const target = document.getElementById(id);
+    if (target) {
+      setActiveId(id);
+      const headerOffset = 72;
+      const elementPosition = target.getBoundingClientRect().top;
+      const offsetPosition = elementPosition + window.scrollY - headerOffset;
+
+      window.scrollTo({
+        top: offsetPosition,
+        behavior: 'smooth',
+      });
+      window.history.replaceState(null, '', `#${id}`);
+    }
+  };
+
+  if (sections.length === 0) {
+    return null;
+  }
+
+  if (variant === 'sidebar') {
+    return (
+      <nav
+        aria-label={title}
+        data-section-nav-menu="sidebar"
+        className="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-6"
+      >
+        <p className="text-xs font-bold uppercase tracking-wider text-gray-500 mb-3">
+          {title}
+        </p>
+        <ul className="space-y-1.5 text-sm border-l-2 border-gray-200">
+          {sections.map((section) => {
+            const isActive = activeId === section.id;
+            return (
+              <li key={section.id} className={section.level === 3 ? 'pl-3' : ''}>
+                <a
+                  href={`#${section.id}`}
+                  onClick={(e) => handleNavClick(e, section.id)}
+                  aria-current={isActive ? 'location' : undefined}
+                  data-active={isActive ? 'true' : 'false'}
+                  className={`block pl-3 py-1 -ml-[2px] border-l-2 transition-all duration-200 ${
+                    isActive
+                      ? 'border-amber-500 text-amber-700 font-semibold bg-amber-50/60 rounded-r'
+                      : 'border-transparent text-gray-600 hover:text-gray-900 hover:border-gray-400'
+                  }`}
+                >
+                  {section.label}
+                </a>
+              </li>
+            );
+          })}
+        </ul>
+      </nav>
+    );
+  }
+
+  return (
+    <div
+      data-section-nav-menu="bar"
+      className="sticky top-0 z-30 bg-white/95 backdrop-blur-sm border-b border-gray-200 shadow-xs transition-all"
+    >
+      <nav
+        aria-label={title}
+        className="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between h-11 overflow-x-auto no-scrollbar"
+      >
+        <div className="flex items-center space-x-1 sm:space-x-2 mx-auto">
+          <span className="hidden md:inline-block text-[11px] font-bold uppercase tracking-wider text-gray-400 mr-2 select-none">
+            {title}:
+          </span>
+          {sections.map((section) => {
+            const isActive = activeId === section.id;
+            return (
+              <a
+                key={section.id}
+                href={`#${section.id}`}
+                onClick={(e) => handleNavClick(e, section.id)}
+                aria-current={isActive ? 'location' : undefined}
+                data-active={isActive ? 'true' : 'false'}
+                className={`relative px-3 py-1.5 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap transition-all duration-200 flex items-center space-x-1.5 ${
+                  isActive
+                    ? 'bg-amber-400/15 text-amber-900 font-semibold ring-1 ring-amber-400/50 shadow-2xs'
+                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100'
+                }`}
+              >
+                <span
+                  className={`w-1.5 h-1.5 rounded-full transition-transform duration-200 ${
+                    isActive ? 'bg-amber-500 scale-100' : 'bg-transparent scale-0 w-0'
+                  }`}
+                />
+                <span>{section.label}</span>
+              </a>
+            );
+          })}
+        </div>
+      </nav>
+    </div>
+  );
+};
+
+export default SectionNav;
