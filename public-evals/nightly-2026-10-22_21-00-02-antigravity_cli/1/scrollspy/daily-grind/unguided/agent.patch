+  <script>
+    (function () {
+      const nav = document.querySelector('nav');
+      const navLinks = Array.from(document.querySelectorAll('nav ul a:not(.logout-link)'));
+      const sections = Array.from(document.querySelectorAll('main section[id]'));
+
+      function getTargetId(link) {
+        if (link.dataset.section) return link.dataset.section;
+        const href = link.getAttribute('href') || '';
+        if (href.startsWith('#')) return href.slice(1);
+        if (href.startsWith('/')) return href.slice(1);
+        return '';
+      }
+
+      function setActiveSection(activeId) {
+        navLinks.forEach((link) => {
+          const isMatch = Boolean(activeId) && getTargetId(link) === activeId;
+          link.classList.toggle('active', isMatch);
+          if (link.parentElement) {
+            link.parentElement.classList.toggle('active', isMatch);
+          }
+          if (isMatch) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function updateActiveOnScroll() {
+        const navHeight = nav ? nav.offsetHeight : 0;
+        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
+        const scrollPosition = window.scrollY + navHeight + Math.min(160, viewportHeight * 0.25);
+
+        // If near the bottom of the page, highlight the last section if visible
+        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 20 && sections.length > 0) {
+          setActiveSection(sections[sections.length - 1].id);
+          return;
+        }
+
+        let currentId = '';
+        let bestVisibleHeight = 0;
+
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          const visibleTop = Math.max(rect.top, navHeight);
+          const visibleBottom = Math.min(rect.bottom, viewportHeight);
+          const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+          if (section.offsetTop <= scrollPosition && section.offsetTop + section.offsetHeight > scrollPosition) {
+            currentId = section.id;
+            break;
+          }
+
+          if (visibleHeight > bestVisibleHeight) {
+            bestVisibleHeight = visibleHeight;
+            currentId = section.id;
+          }
+        }
+
+        setActiveSection(currentId);
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          () => {
+            updateActiveOnScroll();
+          },
+          {
+            root: null,
+            rootMargin: '-10% 0px -25% 0px',
+            threshold: [0, 0.1, 0.25, 0.5, 0.75, 1]
+          }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      navLinks.forEach((link) => {
+        link.addEventListener('click', () => {
+          const targetId = getTargetId(link);
+          if (targetId) {
+            setActiveSection(targetId);
+          }
+        });
+      });
+
+      window.addEventListener('scroll', updateActiveOnScroll, { passive: true });
+      window.addEventListener('resize', updateActiveOnScroll, { passive: true });
+      window.addEventListener('hashchange', updateActiveOnScroll);
+      window.addEventListener('DOMContentLoaded', updateActiveOnScroll);
+      updateActiveOnScroll();
+    })();
+  </script>
