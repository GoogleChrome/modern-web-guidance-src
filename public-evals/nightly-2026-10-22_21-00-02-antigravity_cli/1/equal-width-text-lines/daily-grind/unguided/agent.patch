+  <script>
+    (function () {
+      const lockup = document.querySelector('.hero h1');
+      if (!lockup) return;
+      const lines = Array.from(lockup.querySelectorAll('.hero-line'));
+
+      function fitLines() {
+        const targetWidth = lockup.getBoundingClientRect().width;
+        if (!targetWidth) return;
+
+        lines.forEach((line) => {
+          const baseSize = 100;
+          line.style.fontSize = baseSize + 'px';
+          const measuredWidth = line.getBoundingClientRect().width;
+          if (measuredWidth > 0) {
+            let fittedSize = (baseSize * targetWidth) / measuredWidth;
+            line.style.fontSize = fittedSize + 'px';
+            const refinedWidth = line.getBoundingClientRect().width;
+            if (refinedWidth > 0 && Math.abs(refinedWidth - targetWidth) > 0.05) {
+              fittedSize = (fittedSize * targetWidth) / refinedWidth;
+              line.style.fontSize = fittedSize + 'px';
+            }
+          }
+        });
+      }
+
+      fitLines();
+      let lastWidth = lockup.getBoundingClientRect().width;
+      window.addEventListener('resize', fitLines);
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(() => {
+          const currentWidth = lockup.getBoundingClientRect().width;
+          if (Math.abs(currentWidth - lastWidth) > 0.5) {
+            lastWidth = currentWidth;
+            fitLines();
+          }
+        }).observe(lockup);
+      }
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(fitLines);
+      }
+    })();
+  </script>
+
 </body>
 
