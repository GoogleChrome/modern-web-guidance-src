+
+  <!-- Early connection hints for the A/B testing SDK origin -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin>
+  <link rel="dns-prefetch" href="https://cdn.example.com">
+
+  <!-- Anti-flicker controller: keeps experiment target hidden until variant is applied, fails, or times out -->
+  <script>
+    (function () {
+      var root = document.documentElement;
+      root.classList.add('ab-loading');
+      var settled = false;
+
+      function revealVariant() {
+        if (settled) return;
+        settled = true;
+        clearTimeout(fallbackTimer);
+        root.classList.remove('ab-loading');
+        root.classList.add('ab-ready');
+      }
+
+      function onSdkLoaded() {
+        if (document.readyState === 'loading') {
+          document.addEventListener('DOMContentLoaded', function () {
+            queueMicrotask(revealVariant);
+          }, { once: true });
+        } else {
+          queueMicrotask(revealVariant);
+        }
+      }
+
+      // Bounded timeout prevents prolonged blank content on slow/unreachable networks
+      var fallbackTimer = setTimeout(revealVariant, 800);
+
+      window.revealExperiment = revealVariant;
+      window.onExperimentReady = revealVariant;
+      window.__abSdkLoaded = onSdkLoaded;
+      window.__abSdkError = revealVariant;
+    })();
+  </script>
+
+  <!-- Load A/B testing SDK without blocking HTML parsing; reveal immediately after execution or error -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    defer
+    onload="window.__abSdkLoaded && window.__abSdkLoaded()"
+    onerror="window.__abSdkError && window.__abSdkError()"
+  ></script>
+
