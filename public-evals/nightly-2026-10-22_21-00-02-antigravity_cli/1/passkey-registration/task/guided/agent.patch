+  <script type="importmap">
+    {
+      "imports": {
+        "webauthn-polyfills": "./node_modules/webauthn-polyfills/esm/index.js",
+        "ua-parser-js": "./node_modules/ua-parser-js/dist/ua-parser.min.mjs",
+        "compare-versions": "./node_modules/compare-versions/lib/esm/index.js"
+      }
+    }
+  </script>
+  <script type="module">
+    import 'webauthn-polyfills';
+
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const statusEl = document.getElementById('passkey-status');
+
+    async function checkPasskeySupport() {
+      if (!window.PublicKeyCredential || typeof PublicKeyCredential.getClientCapabilities !== 'function') {
+        if (registerButton) {
+          registerButton.disabled = true;
+        }
+        return false;
+      }
+
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!capabilities.passkeyPlatformAuthenticator || !capabilities.conditionalGet) {
+          if (registerButton) {
+            registerButton.disabled = true;
+          }
+          return false;
+        }
+        return true;
+      } catch (err) {
+        console.error('Failed to check WebAuthn client capabilities:', err);
+        if (registerButton) {
+          registerButton.disabled = true;
+        }
+        return false;
+      }
+    }
+
+    async function registerPasskey(isPromotion = true) {
+      if (statusEl) {
+        statusEl.textContent = '';
+      }
+
+      const supported = await checkPasskeySupport();
+      if (!supported) {
+        return;
+      }
+
+      const optionsRes = await fetch('/api/register/options', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify({ promotion: isPromotion }),
+      });
+
+      const creationOptionsJSON = await optionsRes.json();
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+      const rpId = creationOptionsJSON?.rp?.id || publicKey?.rp?.id || window.location.hostname;
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({ publicKey });
+      } catch (err) {
+        if (err.name === 'InvalidStateError') {
+          console.log('A passkey already exists for this account.');
+          if (statusEl) {
+            statusEl.textContent = 'A passkey already exists for this account.';
+          }
+        } else if (err.name === 'SecurityError') {
+          console.error('Configuration RP ID or Secure Context error.');
+          if (statusEl) {
+            statusEl.textContent = 'Configuration RP ID or Secure Context error.';
+          }
+        } else if (err.name === 'NotAllowedError') {
+          console.log('User cancelled the passkey dialog.');
+        } else if (err.name === 'AbortError') {
+          console.log('The creation operation has been aborted.');
+        }
+        return;
+      }
+
+      const encodedResponse = credential.toJSON();
+      try {
+        const response = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify(encodedResponse),
+        });
+
+        if (!response.ok) {
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId,
+              credentialId: encodedResponse.id,
+            });
+          }
+          if (statusEl) {
+            statusEl.textContent = 'Passkey verification failed.';
+          }
+          return;
+        }
+
+        if (statusEl) {
+          statusEl.textContent = 'Passkey created successfully!';
+        }
+      } catch (serverErr) {
+        console.error('Server verification network failure:', serverErr);
+        if (PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId,
+            credentialId: encodedResponse.id,
+          });
+        }
+        if (statusEl) {
+          statusEl.textContent = 'Network error while verifying passkey.';
+        }
+      }
+    }
+
+    checkPasskeySupport();
+
+    if (registerButton) {
+      registerButton.addEventListener('click', () => {
+        registerPasskey(true);
+      });
+    }
+  </script>
 </body>
 
