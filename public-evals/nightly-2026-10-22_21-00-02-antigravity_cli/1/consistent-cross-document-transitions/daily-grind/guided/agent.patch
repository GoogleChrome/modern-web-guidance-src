@@ -0,0 +1,205 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+@view-transition {
+  navigation: auto;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+  view-transition-name: site-nav;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+  color: white;
+  text-decoration: none;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover,
+nav a[aria-current="page"] {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+  view-transition-name: page-hero;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+  view-transition-name: page-title;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card img {
+  width: 100%;
+  height: 180px;
+  object-fit: cover;
+  border-radius: 6px;
+  margin-bottom: 12px;
+  background-color: var(--secondary);
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+.detail-hero-img {
+  width: 100%;
+  max-width: 600px;
+  height: 360px;
+  object-fit: cover;
+  border-radius: 8px;
+  margin: 20px auto;
+  display: block;
+  background-color: var(--secondary);
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+  view-transition-name: site-footer;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  ::view-transition-old(root) {
+    animation: 0.25s ease-out both fade-out;
+  }
+
+  ::view-transition-new(root) {
+    animation: 0.25s ease-in both fade-in;
+  }
+}
+
+@keyframes fade-out {
+  to {
+    opacity: 0;
+  }
+}
+
+@keyframes fade-in {
+  from {
+    opacity: 0;
+  }
+}
diff --git a/transition-setup.js b/transition-setup.js
new file mode 100644
index 0000000..3b322a8
--- /dev/null
+++ b/transition-setup.js
@@ -0,0 +1,39 @@
+// Ensure initial page theme/state is applied before view transition snapshots
+document.documentElement.dataset.theme =
+  localStorage.getItem('theme') || 'light';
+
+window.addEventListener('pagereveal', async (event) => {
+  if (!event.viewTransition) return;
+
+  const from = window.navigation?.activation?.from;
+  if (!from) return;
+
+  const fromUrl = new URL(from.url);
+  const toUrl = new URL(window.location.href);
+
+  // Dynamically pair menu item cards and headings during detail navigations
+  const detailMatch =
+    toUrl.pathname.match(/^\/menu\/(seasonal|espresso|cold-brew)/) ||
+    fromUrl.pathname.match(/^\/menu\/(seasonal|espresso|cold-brew)/);
+
+  if (detailMatch) {
+    const slug = detailMatch[1];
+    const cardTitle = document.querySelector(`[data-item="${slug}"] h3`);
+    const detailHeading = document.querySelector('[data-detail-title]');
+
+    const targetEl = cardTitle || detailHeading;
+    if (targetEl) {
+      targetEl.style.viewTransitionName = `drink-title-${slug}`;
+      try {
+        await event.viewTransition.ready;
+      } catch (error) {
+        if (error.name !== 'InvalidStateError') {
+          throw error;
+        }
+      } finally {
+        await event.viewTransition.finished;
+        targetEl.style.viewTransitionName = '';
+      }
+    }
+  }
+});
