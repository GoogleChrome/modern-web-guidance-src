+    opacity: 0;
+    transform: translateY(12px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes vt-fade-out {
+  from {
+    opacity: 1;
+    transform: translateY(0);
+  }
+  to {
+    opacity: 0;
+    transform: translateY(-12px);
+  }
+}
+
+::view-transition-old(root) {
+  animation: 250ms cubic-bezier(0.4, 0, 1, 1) both vt-fade-out;
+}
+
+::view-transition-new(root) {
+  animation: 300ms cubic-bezier(0, 0, 0.2, 1) both vt-fade-in;
+}
+
+::view-transition-old(main-content) {
+  animation: 250ms cubic-bezier(0.4, 0, 1, 1) both vt-fade-out;
+}
+
+::view-transition-new(main-content) {
+  animation: 300ms cubic-bezier(0, 0, 0.2, 1) both vt-fade-in;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation-duration: 0.01ms !important;
+  }
+}
diff --git a/transitions.js b/transitions.js
new file mode 100644
index 0000000..9c4f5f4
--- /dev/null
+++ b/transitions.js
@@ -0,0 +1,88 @@
+(function () {
+  const root = document.documentElement;
+  root.setAttribute('data-page-ready', 'true');
+  root.classList.add('vt-ready');
+
+  function normalizePath(pathname) {
+    if (!pathname) return '/';
+    const cleaned = pathname.replace(/\/index\.html$/, '').replace(/\.html$/, '').replace(/\/+$/, '');
+    return cleaned || '/';
+  }
+
+  function applyCriticalNavState() {
+    const currentPath = normalizePath(window.location.pathname);
+    const navLinks = document.querySelectorAll('nav a[href]');
+    navLinks.forEach((link) => {
+      const linkPath = normalizePath(link.getAttribute('href'));
+      if (linkPath === currentPath || (linkPath !== '/' && currentPath.startsWith(linkPath + '/'))) {
+        link.setAttribute('aria-current', 'page');
+      } else {
+        link.removeAttribute('aria-current');
+      }
+    });
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', applyCriticalNavState, { once: true });
+  } else {
+    applyCriticalNavState();
+  }
+
+  window.addEventListener('pageswap', (event) => {
+    if (!event.viewTransition) return;
+
+    const targetUrl = event.activation && event.activation.entry && event.activation.entry.url
+      ? new URL(event.activation.entry.url)
+      : null;
+
+    if (targetUrl) {
+      const targetPath = normalizePath(targetUrl.pathname);
+      try {
+        sessionStorage.setItem('vt-last-from', normalizePath(window.location.pathname));
+        sessionStorage.setItem('vt-last-to', targetPath);
+      } catch (_) {}
+
+      const matchingLink = document.querySelector(`.card a[href="${targetPath}"]`);
+      if (matchingLink) {
+        const card = matchingLink.closest('.card');
+        if (card) {
+          card.style.viewTransitionName = 'featured-item';
+        }
+      }
+    }
+  });
+
+  window.addEventListener('pagereveal', (event) => {
+    applyCriticalNavState();
+    if (!event.viewTransition) return;
+
+    root.setAttribute('data-transitioning', 'true');
+    const currentPath = normalizePath(window.location.pathname);
+    let fromPath = null;
+    try {
+      fromPath = sessionStorage.getItem('vt-last-from');
+    } catch (_) {}
+
+    if (fromPath && fromPath.startsWith('/menu/')) {
+      const matchingLink = document.querySelector(`.card a[href="${fromPath}"]`);
+      if (matchingLink) {
+        const card = matchingLink.closest('.card');
+        if (card) {
+          card.style.viewTransitionName = 'featured-item';
+        }
+      }
+    } else if (currentPath.startsWith('/menu/')) {
+      const detailCard = document.querySelector('.card');
+      if (detailCard) {
+        detailCard.style.viewTransitionName = 'featured-item';
+      }
+    }
+
+    event.viewTransition.finished.finally(() => {
+      root.removeAttribute('data-transitioning');
+      document.querySelectorAll('[style*="view-transition-name"]').forEach((el) => {
+        el.style.viewTransitionName = '';
+      });
+    });
+  });
+})();
