+
+        // Tag the detail hero and title for the old snapshot
+        applyTransitionNames(heroEl, titleEl);
+
+        const transition = document.startViewTransition(() => {
+          // Move transition names from detail view back to the active thumbnail
+          clearTransitionNames(heroEl, titleEl);
+          applyTransitionNames(targetThumbnail, targetTitleEl);
+          showListDOM();
+        });
+
+        transition.finished.finally(() => {
+          cleanupAllTransitionState();
+          if (!listPage.hidden) {
+            listHeading.focus();
+          }
+        });
+      }
+
+      thumbnails.forEach((thumbnail) => {
+        thumbnail.addEventListener('click', (event) => {
+          event.preventDefault();
+          transitionToDetail(thumbnail);
+        });
+
+        thumbnail.addEventListener('keydown', (event) => {
+          if (event.key === 'Enter' || event.key === ' ') {
+            event.preventDefault();
+            transitionToDetail(thumbnail);
+          }
+        });
+      });
+
+      backBtn.addEventListener('click', (event) => {
+        event.preventDefault();
+        transitionToList();
+      });
+
+      if (navLogo) {
+        navLogo.addEventListener('click', () => {
+          if (listPage.hidden) {
+            transitionToList();
+          }
+        });
+      }
+
+      document.querySelectorAll('[data-nav="list"]').forEach((link) => {
+        link.addEventListener('click', (event) => {
+          event.preventDefault();
+          if (listPage.hidden) {
+            transitionToList();
+          }
+        });
+      });
+    })();
+  </script>
