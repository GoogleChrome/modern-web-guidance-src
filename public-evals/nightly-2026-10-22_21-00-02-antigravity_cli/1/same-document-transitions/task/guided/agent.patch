+  <script>
+    const thumbnails = document.querySelectorAll('.thumbnail');
+    const backButton = document.getElementById('back-button');
+    const hero = document.getElementById('hero');
+    const heroImg = document.getElementById('hero-img');
+    const detailTitle = document.getElementById('title');
+    const detailPrice = document.getElementById('detail-price');
+    const detailCalories = document.getElementById('detail-calories');
+    const detailDescription = document.getElementById('detail-description');
+    const listHeading = document.getElementById('list-heading');
+
+    function populateDetail(card) {
+      const { title, description, price, calories, image, alt } = card.dataset;
+      detailTitle.textContent = title;
+      detailDescription.textContent = description;
+      detailPrice.textContent = price;
+      detailCalories.textContent = calories;
+      if (image) {
+        heroImg.src = image;
+        heroImg.alt = alt || title;
+        hero.style.backgroundImage = `url('${image}')`;
+      }
+      const bgColor = getComputedStyle(card).backgroundColor;
+      hero.style.backgroundColor = bgColor;
+      document.title = `${title} | The Daily Grind`;
+    }
+
+    function goFromListToDetail(e) {
+      const card = e.currentTarget;
+
+      // Ensure no stale selected classes exist before starting a new transition
+      document.querySelectorAll('.selected').forEach((el) => {
+        el.classList.remove('selected');
+      });
+
+      card.classList.add('selected');
+      populateDetail(card);
+
+      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+      // Trigger the transition, checking for support and motion preference
+      if (!document.startViewTransition || prefersReducedMotion) {
+        document.body.classList.add('detail');
+        detailTitle?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.add('detail');
+      });
+
+      transition.finished.finally(() => {
+        detailTitle?.focus();
+      });
+    }
+
+    function goFromDetailToList() {
+      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+      if (!document.startViewTransition || prefersReducedMotion) {
+        document.body.classList.remove('detail');
+        document.title = 'The Daily Grind | Artisanal Coffee';
+        listHeading?.focus();
+        document.querySelectorAll('.selected').forEach((element) => {
+          element.classList.remove('selected');
+        });
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.remove('detail');
+        document.title = 'The Daily Grind | Artisanal Coffee';
+      });
+
+      transition.finished.finally(() => {
+        listHeading?.focus();
+        document.querySelectorAll('.selected').forEach((element) => {
+          element.classList.remove('selected');
+        });
+      });
+    }
+
+    thumbnails.forEach((card) => {
+      card.addEventListener('click', goFromListToDetail);
+      card.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter') {
+          goFromListToDetail(e);
+        } else if (e.key === ' ') {
+          e.preventDefault();
+        }
+      });
+      card.addEventListener('keyup', (e) => {
+        if (e.key === ' ') {
+          goFromListToDetail(e);
+        }
+      });
+    });
+
+    backButton.addEventListener('click', goFromDetailToList);
+  </script>
 </body>
 
