+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const statusEl = document.getElementById('status');
+      const originCards = Array.from(scroller.querySelectorAll('.origin-card'));
+
+      let isScrolling = false;
+      let scrollEndTimer = null;
+      let lastScrollTime = 0;
+      const visibilityRatios = new Map();
+
+      function getOriginName(card) {
+        return card.dataset.origin || card.querySelector('h3')?.textContent?.trim() || card.textContent.trim();
+      }
+
+      if ('IntersectionObserver' in window) {
+        const thresholds = Array.from({ length: 21 }, (_, i) => i / 20);
+        const observer = new IntersectionObserver(
+          (entries) => {
+            for (const entry of entries) {
+              visibilityRatios.set(entry.target, entry.intersectionRatio);
+            }
+          },
+          { root: scroller, threshold: thresholds }
+        );
+        originCards.forEach((card) => observer.observe(card));
+      }
+
+      function findMostVisibleOrigin() {
+        const scrollerRect = scroller.getBoundingClientRect();
+        let bestCard = originCards[0];
+        let maxVisibleArea = -1;
+
+        for (const card of originCards) {
+          const rect = card.getBoundingClientRect();
+          const visibleTop = Math.max(rect.top, scrollerRect.top);
+          const visibleBottom = Math.min(rect.bottom, scrollerRect.bottom);
+          const visibleLeft = Math.max(rect.left, scrollerRect.left);
+          const visibleRight = Math.min(rect.right, scrollerRect.right);
+
+          const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+          const visibleWidth = Math.max(0, visibleRight - visibleLeft);
+          const visibleArea = visibleHeight * visibleWidth;
+
+          if (visibleArea > maxVisibleArea) {
+            maxVisibleArea = visibleArea;
+            bestCard = card;
+          }
+        }
+
+        if (maxVisibleArea <= 0 && visibilityRatios.size > 0) {
+          let maxRatio = -1;
+          for (const [card, ratio] of visibilityRatios.entries()) {
+            if (ratio > maxRatio) {
+              maxRatio = ratio;
+              bestCard = card;
+            }
+          }
+        }
+
+        return bestCard ? getOriginName(bestCard) : '';
+      }
+
+      function handleScrollEnd() {
+        if (scrollEndTimer !== null) {
+          clearTimeout(scrollEndTimer);
+          scrollEndTimer = null;
+        }
+        isScrolling = false;
+        const visibleOrigin = findMostVisibleOrigin();
+        statusEl.textContent = `Scroll ended. Visible: ${visibleOrigin}`;
+      }
+
+      scroller.addEventListener(
+        'scroll',
+        () => {
+          lastScrollTime = performance.now();
+          if (!isScrolling) {
+            isScrolling = true;
+            statusEl.textContent = 'Scrolling...';
+          }
+          if (scrollEndTimer !== null) {
+            clearTimeout(scrollEndTimer);
+          }
+          scrollEndTimer = setTimeout(handleScrollEnd, 120);
+        },
+        { passive: true }
+      );
+
+      scroller.addEventListener(
+        'scrollend',
+        (event) => {
+          if (!event.isTrusted || performance.now() - lastScrollTime >= 100) {
+            handleScrollEnd();
+          }
+        },
+        { passive: true }
+      );
+    })();
+  </script>
+
