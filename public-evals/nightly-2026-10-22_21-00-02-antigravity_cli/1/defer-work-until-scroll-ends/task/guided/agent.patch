+  <script>
+    function findMostVisibleOrigin(scroller) {
+      const scrollerRect = scroller.getBoundingClientRect();
+      const cards = scroller.querySelectorAll('.origin-card');
+      let mostVisibleOrigin = '';
+      let maxVisibleHeight = -1;
+
+      cards.forEach((card) => {
+        const rect = card.getBoundingClientRect();
+        const visibleTop = Math.max(rect.top, scrollerRect.top);
+        const visibleBottom = Math.min(rect.bottom, scrollerRect.bottom);
+        const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+        if (visibleHeight > maxVisibleHeight) {
+          maxVisibleHeight = visibleHeight;
+          mostVisibleOrigin = card.dataset.origin || card.querySelector('h3').textContent;
+        }
+      });
+
+      return mostVisibleOrigin;
+    }
+
+    function initializeScroller() {
+      const scroller = document.querySelector('#scroller');
+      const status = document.querySelector('#status');
+      let isScrolling = false;
+
+      // 1. Lightweight informative feedback during scroll
+      scroller.addEventListener('scroll', () => {
+        if (!isScrolling) {
+          isScrolling = true;
+          status.textContent = 'Scrolling...';
+        }
+      }, { passive: true });
+
+      // 2. Defer layout recalculation until scrolling rests
+      scroller.addEventListener('scrollend', () => {
+        isScrolling = false;
+        const currentVisibleOrigin = findMostVisibleOrigin(scroller);
+        if (currentVisibleOrigin) {
+          status.textContent = `Scroll ended. Visible: ${currentVisibleOrigin}`;
+        }
+      });
+    }
+
+    if ('onscrollend' in window) {
+      initializeScroller();
+    } else {
+      initializeScroller();
+      const scroller = document.querySelector('#scroller');
+      scroller.addEventListener('scroll', () => {
+        clearTimeout(window.scrollendtimer);
+        window.scrollendtimer = setTimeout(() => {
+          scroller.dispatchEvent(new CustomEvent('scrollend'));
+        }, 100);
+      }, { passive: true });
+    }
+  </script>
