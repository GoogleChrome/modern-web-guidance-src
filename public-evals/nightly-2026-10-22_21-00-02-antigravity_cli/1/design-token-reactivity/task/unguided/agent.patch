+  <script>
+    const toggleBtn = document.getElementById('toggle-spacious');
+    const targetContainer = document.getElementById('target-container');
+
+    if (toggleBtn && targetContainer) {
+      toggleBtn.addEventListener('click', () => {
+        const current = targetContainer.style.getPropertyValue('--layout-density').trim();
+        const next = current === 'spacious' ? 'compact' : 'spacious';
+        targetContainer.style.setProperty('--layout-density', next);
+      });
+    }
+  </script>
