+        :host([open]) .details {
+          display: block;
+        }
+        .actions {
+          display: flex;
+          justify-content: center;
+          align-items: center;
+          gap: 10px;
+          flex-wrap: wrap;
+          margin-top: 15px;
+        }
+        .btn {
+          display: inline-block;
