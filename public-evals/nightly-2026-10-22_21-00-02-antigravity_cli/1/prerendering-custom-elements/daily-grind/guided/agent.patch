+          color: white;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          border: none;
+          font: inherit;
+          cursor: pointer;
+          transition: background 0.3s;
+        }
+        .btn:hover {
+          background: #3e2723;
+        }
+        .btn-outline {
+          background: transparent;
+          color: var(--primary, #4e342e);
+          border: 1px solid var(--primary, #4e342e);
+        }
+        .btn-outline:hover {
+          background: var(--secondary, #d7ccc8);
+        }
+      </style>
+      <article class="card">
+        <slot name="header"></slot>
+        <div class="body">
+          <slot></slot>
+          <div class="details" id="details-panel">
+            <slot name="details"></slot>
+          </div>
+        </div>
+        <div class="actions">
+          <button type="button" id="toggle" class="btn btn-outline" aria-expanded="false" aria-controls="details-panel">Tasting Notes</button>
+          <slot name="action"></slot>
+        </div>
+      </article>
+    `;
+
+    class CoffeeCard extends HTMLElement {
+      static observedAttributes = ['open'];
+
+      constructor() {
+        super();
+        // Reuse the server-rendered Declarative Shadow DOM root if present;
+        // only create a shadow root if absent (client-created or engine without shadowrootmode).
+        if (!this.shadowRoot) {
+          const dsdTemplate = !Object.hasOwn(HTMLTemplateElement.prototype, 'shadowRootMode')
+            ? this.querySelector('template[shadowrootmode]')
+            : null;
+          this.attachShadow({ mode: 'open' });
+          if (dsdTemplate) {
+            this.shadowRoot.append(dsdTemplate.content);
+            dsdTemplate.remove();
+          } else {
+            this.shadowRoot.append(fallbackTemplate.content.cloneNode(true));
+          }
+        }
+
+        // Hydrate in place: attach event listeners once against the existing shadow markup
+        // without re-rendering or discarding the server-rendered DOM.
+        const toggleBtn = this.shadowRoot.getElementById('toggle');
+        toggleBtn?.addEventListener('click', () => {
+          const isOpen = this.toggleAttribute('open');
+          toggleBtn.setAttribute('aria-expanded', String(isOpen));
+        });
+      }
+
+      get open() {
+        return this.hasAttribute('open');
+      }
+
+      set open(val) {
+        this.toggleAttribute('open', Boolean(val));
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (name === 'open' && oldVal !== newVal) {
+          const isOpen = newVal !== null;
+          this.shadowRoot?.getElementById('toggle')?.setAttribute('aria-expanded', String(isOpen));
+        }
+      }
+    }
+
+    customElements.define('coffee-card', CoffeeCard);
+  </script>
