+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const journalContent = document.getElementById('journal-content');
+    const summaryContainer = document.getElementById('journal-summary');
+    const summaryOutput = document.getElementById('summary-output');
+
+    function renderBulletPoints(summaryText) {
+      const lines = summaryText
+        .split(/\r?\n/)
+        .map((line) => line.replace(/^[\s*\-•–—\d.)]+/, '').trim())
+        .filter((line) => line.length > 0);
+
+      const ul = document.createElement('ul');
+      for (const line of lines) {
+        const li = document.createElement('li');
+        li.textContent = line.replace(/\*\*(.*?)\*\*/g, '$1');
+        ul.appendChild(li);
+      }
+
+      summaryOutput.innerHTML = '';
+      summaryOutput.appendChild(ul);
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      summaryContainer.hidden = false;
+      summarizeBtn.disabled = true;
+      summarizeBtn.textContent = 'Summarizing...';
+      summaryOutput.innerHTML = '<p class="summary-status">Generating summary with built-in AI...</p>';
+
+      try {
+        if (!('Summarizer' in self)) {
+          throw new Error('The built-in Summarizer API is not supported in this browser.');
+        }
+
+        const availability = await Summarizer.availability();
+        if (availability === 'unavailable') {
+          throw new Error('The browser Summarizer AI model is unavailable on this device.');
+        }
+
+        const summarizer = await Summarizer.create({
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          sharedContext: 'An article from a coffee roaster journal explaining their ethical bean sourcing and roasting process.',
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const percent = Math.round((e.loaded || 0) * 100);
+              summaryOutput.innerHTML = `<p class="summary-status">Downloading on-device AI model (${percent}%)...</p>`;
+            });
+          }
+        });
+
+        const textToSummarize = journalContent.innerText.trim();
+        const summary = await summarizer.summarize(textToSummarize);
+
+        renderBulletPoints(summary);
+
+        if (typeof summarizer.destroy === 'function') {
+          summarizer.destroy();
+        }
+        summarizeBtn.textContent = 'Summarize';
+      } catch (error) {
+        summaryOutput.innerHTML = `<p class="summary-status">${error.message || 'Unable to generate summary using browser AI.'}</p>`;
+        summarizeBtn.textContent = 'Summarize';
+      } finally {
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
