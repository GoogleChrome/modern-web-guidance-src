+  <script type="module">
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const summaryBox = document.getElementById('journal-summary-box');
+    const summaryStatus = document.getElementById('journal-summary-status');
+    const summaryList = document.getElementById('journal-summary-list');
+    const journalArticle = document.getElementById('journal-article');
+
+    const summarizerOptions = {
+      sharedContext: 'A coffee roastery journal entry describing the direct-trade bean sourcing, quality evaluation, and roasting process.',
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      expectedInputLanguages: ['en'],
+      outputLanguage: 'en',
+    };
+
+    function showStatus(message) {
+      summaryBox.hidden = false;
+      summaryStatus.hidden = false;
+      summaryStatus.textContent = message;
+    }
+
+    function renderBullets(summaryText) {
+      summaryList.innerHTML = '';
+      const lines = summaryText
+        .split(/\r?\n/)
+        .map((line) => line.replace(/^[\s•*\-–—]+|\d+\.\s+/g, '').trim())
+        .filter(Boolean);
+
+      const items = lines.length > 0 ? lines : [summaryText.trim()].filter(Boolean);
+      for (const item of items) {
+        const li = document.createElement('li');
+        li.textContent = item;
+        summaryList.appendChild(li);
+      }
+      summaryBox.hidden = false;
+      summaryStatus.hidden = true;
+    }
+
+    async function checkSupportAndAvailability() {
+      if (!('Summarizer' in self)) {
+        summarizeBtn.disabled = true;
+        showStatus('Local summarization is currently unsupported in this browser.');
+        return 'unavailable';
+      }
+
+      try {
+        const availability = await Summarizer.availability(summarizerOptions);
+        if (availability === 'unavailable') {
+          summarizeBtn.disabled = true;
+          showStatus('Local summarization is currently unavailable on this device.');
+        }
+        return availability;
+      } catch {
+        summarizeBtn.disabled = true;
+        showStatus('Local summarization is currently unavailable in this browser.');
+        return 'unavailable';
+      }
+    }
+
+    let cachedSummarizer = null;
+
+    summarizeBtn.addEventListener('click', async () => {
+      if (!('Summarizer' in self)) {
+        summarizeBtn.disabled = true;
+        showStatus('Local summarization is currently unsupported in this browser.');
+        return;
+      }
+
+      summarizeBtn.disabled = true;
+      const originalLabel = summarizeBtn.textContent;
+      summarizeBtn.textContent = 'Summarizing...';
+
+      try {
+        const availability = await Summarizer.availability(summarizerOptions);
+        if (availability === 'unavailable') {
+          showStatus('Local summarization is currently unavailable on this device.');
+          summarizeBtn.textContent = originalLabel;
+          return;
+        }
+
+        if (!cachedSummarizer) {
+          showStatus(
+            availability === 'downloadable' || availability === 'downloading'
+              ? 'Preparing on-device AI model (0%)...'
+              : 'Initializing on-device AI summarizer...'
+          );
+
+          cachedSummarizer = await Summarizer.create({
+            ...summarizerOptions,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const percent = e.total ? Math.round((e.loaded / e.total) * 100) : Math.round(e.loaded * 100);
+                showStatus(`Downloading on-device AI model: ${percent}%`);
+              });
+            },
+          });
+        }
+
+        showStatus('Distilling key points from the journal...');
+        const summary = await cachedSummarizer.summarize(journalArticle.innerText, {
+          context: 'Summarize the coffee bean sourcing and roasting process into concise bullet points for customers.',
+        });
+
+        renderBullets(summary);
+      } catch (error) {
+        showStatus(`Unable to generate summary: ${error.message || 'On-device AI is unavailable.'}`);
+      } finally {
+        summarizeBtn.textContent = originalLabel;
+        if ('Summarizer' in self) {
+          summarizeBtn.disabled = false;
+        }
+      }
+    });
+
+    checkSupportAndAvailability();
+  </script>
 </body>
 
