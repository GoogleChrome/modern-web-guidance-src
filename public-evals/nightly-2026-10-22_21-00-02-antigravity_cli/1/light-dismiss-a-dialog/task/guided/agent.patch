+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const dialog = document.querySelector('#logout-dialog');
+    const trigger = document.querySelector('.test-dialog-trigger');
+
+    if (trigger && dialog && !('commandForElement' in HTMLButtonElement.prototype)) {
+      trigger.addEventListener('click', () => {
+        if (!dialog.open) {
+          dialog.showModal();
+        }
+      });
+    }
+
+    // Fallback for browsers without closedby support
+    if (dialog && !('closedBy' in HTMLDialogElement.prototype)) {
+      dialog.addEventListener('click', (event) => {
+        if (event.target !== dialog) return;
+
+        const rect = dialog.getBoundingClientRect();
+        const isDialogContent = (
+          rect.top <= event.clientY &&
+          event.clientY <= rect.top + rect.height &&
+          rect.left <= event.clientX &&
+          event.clientX <= rect.left + rect.width
+        );
+
+        if (isDialogContent) return;
+
+        dialog.close();
+      });
+    }
+  </script>
