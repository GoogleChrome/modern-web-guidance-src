+  <dialog id="logout-dialog" closedby="any">
+    <div class="dialog-content">
+      <h2>Are you sure?</h2>
+      <p>Are you sure you want to log out of your account?</p>
+      <form method="dialog" class="dialog-actions">
+        <button type="submit" value="cancel" class="btn btn-cancel">Cancel</button>
+        <a href="/logout" class="btn">Logout</a>
+      </form>
+    </div>
+  </dialog>
+
+  <script>
+    const dialogTrigger = document.querySelector('.test-dialog-trigger');
+    const logoutDialog = document.getElementById('logout-dialog');
+
+    dialogTrigger.addEventListener('click', (event) => {
+      event.preventDefault();
+      logoutDialog.showModal();
+    });
+
+    logoutDialog.addEventListener('click', (event) => {
+      const rect = logoutDialog.getBoundingClientRect();
+      const clickedInDialog =
+        rect.top <= event.clientY &&
+        event.clientY <= rect.top + rect.height &&
+        rect.left <= event.clientX &&
+        event.clientX <= rect.left + rect.width;
+
+      if (event.target === logoutDialog || !clickedInDialog) {
+        logoutDialog.close();
+      }
+    });
+  </script>
