+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+
+    const promos = [
+      {
+        title: 'Happy Hour 50% Off',
+        description: 'Half off all iced lattes and cold brews every weekday from 2 PM to 4 PM.'
+      },
+      {
+        title: 'Double Rewards Points',
+        description: 'Earn 2x loyalty points on all whole-bean coffee bag purchases this week.'
+      },
+      {
+        title: 'Free Oat Milk Upgrade',
+        description: 'Switch to barista-grade oat or almond milk at no extra charge all month.'
+      }
+    ];
+    let promoIndex = 0;
+
+    addBtn.addEventListener('click', () => {
+      const promo = promos[promoIndex % promos.length];
+      promoIndex++;
+
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = `
+        <h3>${promo.title}</h3>
+        <p>${promo.description}</p>
+        <a href="/rewards" class="btn">Claim Offer</a>
+      `;
+      domContainer.appendChild(card);
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card');
+      if (cards.length > 0) {
+        cards[cards.length - 1].remove();
+      }
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      toggleCard.toggleAttribute('hidden');
+    });
+  </script>
