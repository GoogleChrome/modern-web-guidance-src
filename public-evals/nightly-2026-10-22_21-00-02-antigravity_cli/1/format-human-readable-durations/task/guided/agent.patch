+  <script>
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const unitRadios = document.querySelectorAll('input[name="largestUnit"]');
+    const humanValue = document.getElementById('humanValue');
+    const steepingForm = document.getElementById('steepingForm');
+
+    steepingForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      updateSteepingDuration();
+    });
+
+    function formatManualFallback(balanced, largestUnit) {
+      const h = balanced.hours;
+      const m = balanced.minutes;
+
+      const hoursStr = `${h} hour${h === 1 ? '' : 's'}`;
+      const minutesStr = `${m} minute${m === 1 ? '' : 's'}`;
+
+      if (largestUnit === 'minutes' || h === 0) {
+        return minutesStr;
+      }
+      if (m === 0) {
+        return hoursStr;
+      }
+      return `${hoursStr} and ${minutesStr}`;
+    }
+
+    function updateSteepingDuration() {
+      if (typeof Temporal === 'undefined') {
+        return;
+      }
+
+      const rawHours = parseInt(hoursInput.value, 10);
+      const rawMinutes = parseInt(minutesInput.value, 10);
+      const hours = Number.isNaN(rawHours) || rawHours < 0 ? 0 : rawHours;
+      const minutes = Number.isNaN(rawMinutes) || rawMinutes < 0 ? 0 : rawMinutes;
+
+      const selectedRadio = document.querySelector('input[name="largestUnit"]:checked');
+      const largestUnit = selectedRadio ? selectedRadio.value : 'hours';
+
+      // 1. Create a duration from user input
+      const duration = Temporal.Duration.from({ hours, minutes });
+
+      // 2. Balance units based on largestUnit ('hours' or 'minutes')
+      const balanced = duration.round({ largestUnit });
+
+      // 3. Format using Intl.DurationFormat with fallback to manual string construction
+      if (typeof Intl !== 'undefined' && typeof Intl.DurationFormat !== 'undefined') {
+        const formatter = new Intl.DurationFormat('en', { style: 'long' });
+        humanValue.textContent = formatter.format(balanced);
+      } else {
+        humanValue.textContent = formatManualFallback(balanced, largestUnit);
+      }
+    }
+
+    function initializeApp() {
+      hoursInput.addEventListener('input', updateSteepingDuration);
+      hoursInput.addEventListener('change', updateSteepingDuration);
+      minutesInput.addEventListener('input', updateSteepingDuration);
+      minutesInput.addEventListener('change', updateSteepingDuration);
+      unitRadios.forEach((radio) => {
+        radio.addEventListener('change', updateSteepingDuration);
+      });
+      updateSteepingDuration();
+    }
+
+    // Check if Temporal is supported natively
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        try {
+          // Load the polyfill conditionally
+          const module = await import("https://esm.sh/@js-temporal/polyfill");
+          globalThis.Temporal = module.Temporal;
+          // Extend Date.prototype if needed
+          Date.prototype.toTemporalInstant = module.toTemporalInstant;
+        } catch (err) {
+          console.error("Failed to load Temporal polyfill:", err);
+        }
+      }
+      initializeApp();
+    })();
+  </script>
