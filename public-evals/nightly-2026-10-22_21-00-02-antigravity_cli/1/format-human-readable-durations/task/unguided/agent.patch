+    <section class="calculator-section">
+      <h2 style="text-align: center;">Coffee Steeping Time Calculator</h2>
+      <div class="calculator-card">
+        <div class="input-row">
+          <div class="form-group">
+            <label for="hoursInput">Hours</label>
+            <input type="number" id="hoursInput" min="0" value="1" placeholder="0">
+          </div>
+          <div class="form-group">
+            <label for="minutesInput">Minutes</label>
+            <input type="number" id="minutesInput" min="0" value="30" placeholder="0">
+          </div>
+        </div>
+
+        <div class="form-group">
+          <label>Largest Display Unit</label>
+          <div class="radio-group">
+            <label class="radio-label">
+              <input type="radio" name="largestUnit" value="hours" checked>
+              Hours
+            </label>
+            <label class="radio-label">
+              <input type="radio" name="largestUnit" value="minutes">
+              Minutes
+            </label>
+          </div>
+        </div>
+
+        <div class="result-box">
+          <div class="result-label">Steeping Duration</div>
+          <div id="humanValue"></div>
+        </div>
+      </div>
+    </section>
   </main>
 
+  <script>
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const largestUnitRadios = document.querySelectorAll('input[name="largestUnit"]');
+    const humanValue = document.getElementById('humanValue');
+
+    function updateSteepingTime() {
+      const hours = Number(hoursInput.value) || 0;
+      const minutes = Number(minutesInput.value) || 0;
+      const selectedRadio = document.querySelector('input[name="largestUnit"]:checked');
+      const largestUnit = selectedRadio ? selectedRadio.value : 'hours';
+
+      let durationObj;
+      if (typeof Temporal !== 'undefined' && Temporal.Duration) {
+        durationObj = Temporal.Duration.from({ hours, minutes }).round({ largestUnit });
+      } else {
+        const totalMinutes = hours * 60 + minutes;
+        if (largestUnit === 'minutes') {
+          durationObj = { minutes: totalMinutes };
+        } else {
+          durationObj = {
+            hours: Math.floor(totalMinutes / 60),
+            minutes: totalMinutes % 60
+          };
+        }
+      }
+
+      if (typeof Intl !== 'undefined' && Intl.DurationFormat) {
+        humanValue.textContent = new Intl.DurationFormat(undefined, { style: 'long' }).format(durationObj);
+      } else if (durationObj.toLocaleString) {
+        humanValue.textContent = durationObj.toLocaleString(undefined, { style: 'long' });
+      } else {
+        const parts = [];
+        if (durationObj.hours) {
+          parts.push(`${durationObj.hours} ${durationObj.hours === 1 ? 'hour' : 'hours'}`);
+        }
+        if (durationObj.minutes || parts.length === 0) {
+          parts.push(`${durationObj.minutes ?? 0} ${durationObj.minutes === 1 ? 'minute' : 'minutes'}`);
+        }
+        humanValue.textContent = parts.join(', ');
+      }
+    }
+
+    hoursInput.addEventListener('input', updateSteepingTime);
+    hoursInput.addEventListener('change', updateSteepingTime);
+    minutesInput.addEventListener('input', updateSteepingTime);
+    minutesInput.addEventListener('change', updateSteepingTime);
+    largestUnitRadios.forEach((radio) => {
+      radio.addEventListener('change', updateSteepingTime);
+      radio.addEventListener('input', updateSteepingTime);
+    });
+
+    updateSteepingTime();
+  </script>
