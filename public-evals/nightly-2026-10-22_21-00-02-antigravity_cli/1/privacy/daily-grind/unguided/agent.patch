+    clearAllCookies();
+
+    // Clear Cache Storage if supported
+    try {
+      if ('caches' in window && window.caches && typeof window.caches.keys === 'function') {
+        const cacheNames = await window.caches.keys();
+        await Promise.all(cacheNames.map(function (name) {
+          return window.caches.delete(name);
+        }));
+      }
+    } catch (_e) {}
+
+    // Clear IndexedDB databases if supported
+    try {
+      if ('indexedDB' in window && window.indexedDB && typeof window.indexedDB.databases === 'function') {
+        const dbs = await window.indexedDB.databases();
+        if (Array.isArray(dbs)) {
+          dbs.forEach(function (db) {
+            if (db && db.name) {
+              window.indexedDB.deleteDatabase(db.name);
+            }
+          });
+        }
+      }
+    } catch (_e) {}
+
+    // Reset any forms on the page so entered data does not remain in DOM inputs
+    try {
+      const forms = document.querySelectorAll('form');
+      forms.forEach(function (form) {
+        form.reset();
+      });
+    } catch (_e) {}
+
+    return {
+      localStorageCleared: true,
+      sessionStorageCleared: true,
+      cookiesCleared: true
+    };
+  }
+
+  /**
+   * Performs a secure logout:
+   * 1. Wipes all localStorage, sessionStorage, cookies, caches, and form state
+   * 2. Sends a non-cached POST request to /logout (preventing CSRF-prone GET logout)
+   * 3. Updates the UI state without leaking session identifiers
+   */
+  async function secureLogout(event) {
+    if (event && typeof event.preventDefault === 'function') {
+      event.preventDefault();
+    }
+
+    await clearAllClientData();
+
+    try {
+      await fetch('/logout', {
+        method: 'POST',
+        credentials: 'same-origin',
+        cache: 'no-store',
+        referrerPolicy: 'no-referrer',
+        headers: {
+          'Content-Type': 'application/json',
+          'X-Requested-With': 'XMLHttpRequest'
+        },
+        body: JSON.stringify({ action: 'logout' })
+      });
+    } catch (_networkErr) {
+      // Even if offline or static server, client-side session data is completely wiped
+    }
+
+    updateStatusMessage('Session ended. All local storage, session data, and cookies have been securely erased.');
+    syncConsentUI(DEFAULT_CONSENT);
+    renderAuditSummary();
+  }
+
+  // --- 3. Third-Party Audits & Hardening ---
+
+  /**
+   * Inspects and hardens all DOM elements and stylesheets for third-party connections:
+   * - Enforces rel="noopener noreferrer" and referrerpolicy="no-referrer" on external links/media
+   * - Verifies Subresource Integrity (SRI) on any external scripts or stylesheets
+   * - Removes unauthorized third-party scripts, iframes, embeds, or tracking pixels
+   * - Audits CSS background-image URLs and PerformanceResourceTiming entries
+   */
+  function runThirdPartyAudit() {
+    const report = {
+      timestamp: new Date().toISOString(),
+      sameOrigin: window.location.origin,
+      externalResources: [],
+      unauthorizedBlocked: [],
+      hardenedElements: 0,
+      missingSriWarnings: [],
+      cspViolations: cspViolations.slice(),
+      storageKeysCount: 0
+    };
+
+    // 1. Harden and audit anchor links
+    const links = document.querySelectorAll('a[href]');
+    links.forEach(function (anchor) {
+      const rawHref = anchor.getAttribute('href') || '';
+      // Remove any HTML ping tracking attributes
+      if (anchor.hasAttribute('ping')) {
+        anchor.removeAttribute('ping');
+        report.hardenedElements++;
+      }
+
+      if (/^https?:\/\//i.test(rawHref)) {
+        try {
+          const parsedUrl = new URL(rawHref, window.location.origin);
+          if (parsedUrl.origin !== window.location.origin) {
+            anchor.setAttribute('rel', 'noopener noreferrer external');
+            anchor.setAttribute('referrerpolicy', 'no-referrer');
+            report.hardenedElements++;
+          }
+        } catch (_e) {}
+      } else if (rawHref === '/logout' || rawHref === '/account' || rawHref === '/rewards') {
+        const currentRel = anchor.getAttribute('rel') || '';
+        if (!currentRel.includes('nofollow') || !currentRel.includes('noreferrer')) {
+          anchor.setAttribute('rel', 'nofollow noopener noreferrer');
+          anchor.setAttribute('referrerpolicy', 'no-referrer');
+          report.hardenedElements++;
+        }
+      }
+    });
+
+    // 2. Audit scripts, stylesheets, iframes, images, objects, embeds
+    const resourceSelectors = 'script[src], link[href], img[src], iframe[src], object[data], embed[src]';
+    const elements = document.querySelectorAll(resourceSelectors);
+
+    elements.forEach(function (el) {
+      const attrName = el.hasAttribute('src') ? 'src' : (el.hasAttribute('href') ? 'href' : 'data');
+      const rawUrl = el.getAttribute(attrName);
+      if (!rawUrl || rawUrl.startsWith('data:')) return;
+
+      try {
+        const resolved = new URL(rawUrl, window.location.origin);
+        if (resolved.origin === window.location.origin) {
+          return; // First-party resource
+        }
+
+        const tagName = el.tagName.toLowerCase();
+        const isAllowedOrigin = ALLOWED_THIRD_PARTY_ORIGINS.has(resolved.origin);
+
+        // Enforce referrer protection on external elements
+        if (el.getAttribute('referrerpolicy') !== 'no-referrer') {
+          el.setAttribute('referrerpolicy', 'no-referrer');
+          report.hardenedElements++;
+        }
+        if ((tagName === 'img' || tagName === 'script' || tagName === 'link') && !el.hasAttribute('crossorigin')) {
+          el.setAttribute('crossorigin', 'anonymous');
+          report.hardenedElements++;
+        }
+
+        // Check SRI on external scripts and stylesheets
+        if ((tagName === 'script' || (tagName === 'link' && el.getAttribute('rel') === 'stylesheet')) && !el.hasAttribute('integrity')) {
+          report.missingSriWarnings.push({
+            tag: tagName,
+            origin: resolved.origin
+          });
+        }
+
+        // Block any third-party script, iframe, object, embed, or unapproved third-party origin
+        if (tagName === 'script' || tagName === 'iframe' || tagName === 'object' || tagName === 'embed' || !isAllowedOrigin) {
+          report.unauthorizedBlocked.push({
+            tag: tagName,
+            origin: resolved.origin
+          });
+          el.removeAttribute(attrName);
+          if (el.parentNode) {
+            el.parentNode.removeChild(el);
+          }
+          return;
+        }
+
+        report.externalResources.push({
+          tag: tagName,
+          origin: resolved.origin,
+          status: 'audited-allowed',
+          referrerPolicy: 'no-referrer'
+        });
+      } catch (_err) {
+        // Ignore malformed URLs
+      }
+    });
+
+    // 3. Audit CSS stylesheets for external url(...) references (e.g., Unsplash hero background)
+    try {
+      const sheets = Array.from(document.styleSheets || []);
+      sheets.forEach(function (sheet) {
+        let rules;
+        try {
+          rules = sheet.cssRules || [];
+        } catch (_corsErr) {
+          return;
+        }
+        Array.from(rules).forEach(function (rule) {
+          if (!rule.cssText) return;
+          const matches = rule.cssText.match(/url\(['"]?(https?:\/\/[^)'"]+)['"]?\)/gi) || [];
+          matches.forEach(function (match) {
+            const urlMatch = match.match(/https?:\/\/[^)'"]+/i);
+            if (!urlMatch) return;
+            try {
+              const cssUrl = new URL(urlMatch[0]);
+              if (cssUrl.origin !== window.location.origin) {
+                const allowed = ALLOWED_THIRD_PARTY_ORIGINS.has(cssUrl.origin);
+                report.externalResources.push({
+                  tag: 'css-background',
+                  origin: cssUrl.origin,
+                  status: allowed ? 'audited-allowed (no-referrer meta enforced)' : 'restricted'
+                });
+              }
+            } catch (_e) {}
+          });
+        });
+      });
+    } catch (_styleErr) {}
+
+    // 4. Count remaining allowlisted storage keys
+    try {
+      report.storageKeysCount = (window.localStorage ? window.localStorage.length : 0) +
+        (window.sessionStorage ? window.sessionStorage.length : 0);
+    } catch (_e) {}
+
+    return report;
+  }
+
+  /**
+   * Monitors DOM mutations to prevent runtime injection of unauthorized third-party scripts or trackers.
+   */
+  function startDomAuditObserver() {
+    if (typeof MutationObserver === 'undefined' || !document.documentElement) return;
+
+    const observer = new MutationObserver(function (mutations) {
+      let needsAudit = false;
+      for (const mutation of mutations) {
+        if (mutation.addedNodes && mutation.addedNodes.length > 0) {
+          for (const node of mutation.addedNodes) {
+            if (node.nodeType === 1) {
+              const tag = node.tagName ? node.tagName.toLowerCase() : '';
+              if (tag === 'script' || tag === 'iframe' || tag === 'img' || tag === 'link' || tag === 'object' || tag === 'embed') {
+                needsAudit = true;
+                break;
+              }
+            }
+          }
+        }
+        if (needsAudit) break;
+      }
+      if (needsAudit) {
+        runThirdPartyAudit();
+      }
+    });
+
+    observer.observe(document.documentElement, {
+      childList: true,
+      subtree: true
+    });
+  }
+
+  // --- UI Synchronization & Event Wiring ---
+
+  function updateStatusMessage(message, isError) {
+    const statusEl = document.getElementById('privacy-status-message');
+    if (!statusEl) return;
+    statusEl.textContent = redactPII(message);
+    statusEl.hidden = false;
+    statusEl.setAttribute('data-state', isError ? 'error' : 'success');
+  }
+
+  function syncConsentUI(prefs) {
+    const current = prefs || getConsentPreferences();
+    const prefCheckbox = document.getElementById('consent-preferences');
+    const analyticsCheckbox = document.getElementById('consent-analytics');
+    const marketingCheckbox = document.getElementById('consent-marketing');
+
+    if (prefCheckbox) prefCheckbox.checked = Boolean(current.preferences);
+    if (analyticsCheckbox) analyticsCheckbox.checked = Boolean(current.analytics);
+    if (marketingCheckbox) marketingCheckbox.checked = Boolean(current.marketing);
+  }
+
+  function renderAuditSummary() {
+    const auditOutput = document.getElementById('audit-results');
+    if (!auditOutput) return;
+
+    const report = runThirdPartyAudit();
+    const externalSummary = report.externalResources.length > 0
+      ? report.externalResources.map(function (r) { return r.origin + ' (' + r.tag + ': ' + r.status + ')'; }).join(', ')
+      : 'None (100% first-party)';
+
+    auditOutput.textContent =
+      'Third-Party Origins: ' + externalSummary +
+      ' | Unauthorized Trackers Blocked: ' + report.unauthorizedBlocked.length +
+      ' | Active Storage Keys: ' + report.storageKeysCount +
+      ' | Referrer Policy: no-referrer';
+  }
+
+  function initEventListeners() {
+    // 1. Secure Logout Handler (.logout-link and #logout-form)
+    const logoutLinks = document.querySelectorAll('.logout-link, #logout-link');
+    logoutLinks.forEach(function (el) {
+      el.addEventListener('click', secureLogout);
+    });
+
+    const logoutForm = document.getElementById('logout-form');
+    if (logoutForm) {
+      logoutForm.addEventListener('submit', secureLogout);
+    }
+
+    // 2. Newsletter / Rewards Data-Minimized Form Handler
+    const newsletterForm = document.getElementById('newsletter-form');
+    if (newsletterForm) {
+      newsletterForm.addEventListener('submit', function (event) {
+        event.preventDefault();
+        const emailInput = document.getElementById('subscriber-email');
+        const consentInput = document.getElementById('marketing-consent');
+
+        const email = sanitizeInput(emailInput ? emailInput.value : '', 120);
+        const consented = Boolean(consentInput && consentInput.checked);
+
+        if (!consented) {
+          updateStatusMessage('Explicit opt-in consent is required before submitting your email.', true);
+          return;
+        }
+
+        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+          updateStatusMessage('Please enter a valid email address.', true);
+          return;
+        }
+
+        // Redact email before displaying confirmation and immediately clear input from DOM
+        const masked = redactPII(email);
+        newsletterForm.reset();
+        updateStatusMessage('Subscribed ' + masked + ' with explicit opt-in consent. Zero unnecessary PII collected.', false);
+      });
+    }
+
+    // 3. Privacy Preferences Form Handler
+    const privacyForm = document.getElementById('privacy-preferences-form');
+    if (privacyForm) {
+      privacyForm.addEventListener('submit', function (event) {
+        event.preventDefault();
+        const prefCheckbox = document.getElementById('consent-preferences');
+        const analyticsCheckbox = document.getElementById('consent-analytics');
+        const marketingCheckbox = document.getElementById('consent-marketing');
+
+        const updated = setConsentPreferences({
+          necessary: true,
+          preferences: Boolean(prefCheckbox && prefCheckbox.checked),
+          analytics: Boolean(analyticsCheckbox && analyticsCheckbox.checked),
+          marketing: Boolean(marketingCheckbox && marketingCheckbox.checked)
+        });
+
+        syncConsentUI(updated);
+        renderAuditSummary();
+        updateStatusMessage('Privacy preferences saved with 24-hour automatic expiration.', false);
+      });
+    }
+
+    // 4. Clear All Stored Data Handler
+    const clearDataBtn = document.getElementById('clear-data-btn');
+    if (clearDataBtn) {
+      clearDataBtn.addEventListener('click', async function (event) {
+        event.preventDefault();
+        await clearAllClientData();
+        syncConsentUI(DEFAULT_CONSENT);
+        renderAuditSummary();
+        updateStatusMessage('All client-side storage, cookies, and caches have been erased.', false);
+      });
+    }
+
+    // 5. Manual Audit Trigger
+    const runAuditBtn = document.getElementById('run-audit-btn');
+    if (runAuditBtn) {
+      runAuditBtn.addEventListener('click', function (event) {
+        event.preventDefault();
+        enforceStorageMinimization();
+        renderAuditSummary();
+        updateStatusMessage('Third-party and storage privacy audit completed.', false);
+      });
+    }
+
+    // 6. CSP Violation Monitoring (redacted)
+    document.addEventListener('securitypolicyviolation', function (event) {
+      cspViolations.push({
+        blockedURI: redactPII(event.blockedURI || ''),
+        violatedDirective: event.violatedDirective || '',
+        timestamp: new Date().toISOString()
+      });
+      renderAuditSummary();
+    });
+
+    // 7. Clear ephemeral sessionStorage on pagehide
+    window.addEventListener('pagehide', function () {
+      enforceStorageMinimization();
+    });
+  }
+
+  function initializePrivacyByDesign() {
+    sanitizeUrlParams();
+    enforceStorageMinimization();
+    syncConsentUI(getConsentPreferences());
+    initEventListeners();
+    renderAuditSummary();
+    startDomAuditObserver();
+  }
+
+  // Expose public API for programmatic inspection and testing
+  window.DailyGrindPrivacy = Object.freeze({
+    sanitizeUrlParams: sanitizeUrlParams,
+    enforceStorageMinimization: enforceStorageMinimization,
+    getConsentPreferences: getConsentPreferences,
+    setConsentPreferences: setConsentPreferences,
+    runThirdPartyAudit: runThirdPartyAudit,
+    clearAllClientData: clearAllClientData,
+    secureLogout: secureLogout,
+    redactPII: redactPII,
+    sanitizeInput: sanitizeInput
+  });
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initializePrivacyByDesign);
+  } else {
+    initializePrivacyByDesign();
+  }
+})();
+</script>
 </body>
 
