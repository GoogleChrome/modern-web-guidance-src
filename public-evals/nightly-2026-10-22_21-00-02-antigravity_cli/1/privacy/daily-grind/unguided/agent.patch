+/**
+ * The Daily Grind - Privacy by Design Client-Side Module
+ * Implements:
+ * 1. Data Minimization (URL tracking param stripping, storage allowlisting, TTL expiration, opt-in consent)
+ * 2. Third-Party Audits (DOM/CSS/Resource origin auditing, SRI checks, referrer enforcement, MutationObserver)
+ * 3. Secure Data Handling (POST-based logout with full storage/cookie/cache wipe, PII redaction, input sanitization)
+ */
+(function () {
+  'use strict';
+
+  if (window.__dailyGrindPrivacyInitialized) {
+    return;
+  }
+  window.__dailyGrindPrivacyInitialized = true;
+
+  // --- Configuration & Policy Constants ---
+  const STORAGE_ALLOWLIST = new Set([
+    'dg_privacy_preferences',
+    'dg_theme'
+  ]);
+
+  const SENSITIVE_KEY_PATTERN = /(password|passwd|secret|token|auth|jwt|bearer|session|ssn|social|credit|card|cvv|ccn|email|phone|tel|mobile|address|street|zip|postal|dob|birth|name|fullname|user_id|userid|account|location|lat|lng|coords|gps|fingerprint|device_id|ga_|_ga|_gid|_gat|fbp|_fbp|fbc|track|utm_|clickid|gclid|fbclid)/i;
+
+  const TRACKING_URL_PARAMS = [
+    'utm_source',
+    'utm_medium',
+    'utm_campaign',
+    'utm_term',
+    'utm_content',
+    'utm_id',
+    'fbclid',
+    'gclid',
+    'msclkid',
+    'dclid',
+    'twclid',
+    'mc_eid',
+    'mc_cid',
+    '_ga',
+    '_gl',
+    'yclid',
+    'igshid',
+    'ref',
+    'referrer',
+    'session_id',
+    'sessionid',
+    'token',
+    'auth_token',
+    'access_token',
+    'password',
+    'email',
+    'phone',
+    'ssn'
+  ];
+
+  // Maximum storage retention TTL: 24 hours (in milliseconds)
+  const STORAGE_MAX_TTL_MS = 24 * 60 * 60 * 1000;
+
+  // Explicitly audited and permitted external origins (read-only static media only)
+  const ALLOWED_THIRD_PARTY_ORIGINS = new Set([
+    'https://images.unsplash.com'
+  ]);
+
+  const DEFAULT_CONSENT = Object.freeze({
+    necessary: true,
+    preferences: false,
+    analytics: false,
+    marketing: false
+  });
+
+  const cspViolations = [];
+
+  // --- 1. Data Minimization ---
+
+  /**
+   * Strips tracking identifiers and sensitive PII parameters from the browser URL
+   * using history.replaceState so they are never stored in browsing history or leaked via Referer.
+   */
+  function sanitizeUrlParams(urlString) {
+    try {
+      const target = urlString || window.location.href;
+      const url = new URL(target, window.location.origin);
+      const removedParams = [];
+
+      for (const param of TRACKING_URL_PARAMS) {
+        if (url.searchParams.has(param)) {
+          url.searchParams.delete(param);
+          removedParams.push(param);
+        }
+      }
+
+      // Also check for any dynamic parameter matching sensitive patterns
+      const currentKeys = Array.from(url.searchParams.keys());
+      for (const key of currentKeys) {
+        if (SENSITIVE_KEY_PATTERN.test(key)) {
+          url.searchParams.delete(key);
+          removedParams.push(key);
+        }
+      }
+
+      if (!urlString && removedParams.length > 0 && window.history && typeof window.history.replaceState === 'function') {
+        const cleanRelativeUrl = url.pathname + (url.search ? url.search : '') + (url.hash ? url.hash : '');
+        window.history.replaceState(null, document.title, cleanRelativeUrl);
+      }
+
+      return {
+        cleanUrl: url.toString(),
+        removedParams: removedParams
+      };
+    } catch (_err) {
+      return { cleanUrl: window.location.href, removedParams: [] };
+    }
+  }
+
+  /**
+   * Enforces data minimization across localStorage and sessionStorage:
+   * - Purges any key matching sensitive PII patterns or not on the strict allowlist
+   * - Enforces TTL expiration on allowed structured records
+   */
+  function enforceStorageMinimization() {
+    const purgedKeys = { localStorage: [], sessionStorage: [] };
+    const now = Date.now();
+
+    function auditStorage(storageObj, bucketName) {
+      if (!storageObj) return;
+      try {
+        const keys = [];
+        for (let i = 0; i < storageObj.length; i++) {
+          const k = storageObj.key(i);
+          if (k !== null) keys.push(k);
+        }
+
+        for (const key of keys) {
+          // Immediately remove sensitive PII keys or unapproved keys
+          if (SENSITIVE_KEY_PATTERN.test(key) || !STORAGE_ALLOWLIST.has(key)) {
+            storageObj.removeItem(key);
+            purgedKeys[bucketName].push(key);
+            continue;
+          }
+
+          // Validate TTL and structure for allowlisted keys
+          const rawValue = storageObj.getItem(key);
+          if (!rawValue) continue;
+
+          try {
+            const parsed = JSON.parse(rawValue);
+            if (parsed && typeof parsed === 'object') {
+              const expiresAt = Number(parsed.expiresAt || 0);
+              const timestamp = Number(parsed.timestamp || 0);
+              const isExpired =
+                (expiresAt > 0 && now > expiresAt) ||
+                (timestamp > 0 && now - timestamp > STORAGE_MAX_TTL_MS) ||
+                (!expiresAt && !timestamp);
+
+              if (isExpired) {
+                storageObj.removeItem(key);
+                purgedKeys[bucketName].push(key);
+              }
+            } else {
+              storageObj.removeItem(key);
+              purgedKeys[bucketName].push(key);
+            }
+          } catch (_parseErr) {
+            // Non-JSON or malformed entries without TTL metadata are purged
+            storageObj.removeItem(key);
+            purgedKeys[bucketName].push(key);
+          }
+        }
+      } catch (_storageErr) {
+        // Ignore storage access errors in restricted/sandboxed contexts
+      }
+    }
+
+    auditStorage(window.localStorage, 'localStorage');
+    auditStorage(window.sessionStorage, 'sessionStorage');
+
+    return purgedKeys;
+  }
+
+  /**
+   * Reads user consent preferences, defaulting strictly to opt-in (all non-essential false).
+   */
+  function getConsentPreferences() {
+    try {
+      const raw = window.localStorage.getItem('dg_privacy_preferences');
+      if (!raw) return Object.assign({}, DEFAULT_CONSENT);
+      const parsed = JSON.parse(raw);
+      if (!parsed || typeof parsed !== 'object' || (parsed.expiresAt && Date.now() > parsed.expiresAt)) {
+        window.localStorage.removeItem('dg_privacy_preferences');
+        return Object.assign({}, DEFAULT_CONSENT);
+      }
+      const data = parsed.data || {};
+      return {
+        necessary: true,
+        preferences: Boolean(data.preferences),
+        analytics: Boolean(data.analytics),
+        marketing: Boolean(data.marketing)
+      };
+    } catch (_err) {
+      return Object.assign({}, DEFAULT_CONSENT);
+    }
+  }
+
+  /**
+   * Saves minimized consent preferences with an automatic 24-hour expiration TTL.
+   * If preferences are revoked, non-essential data is immediately purged.
+   */
+  function setConsentPreferences(prefs) {
+    const normalized = {
+      necessary: true,
+      preferences: Boolean(prefs && prefs.preferences),
+      analytics: Boolean(prefs && prefs.analytics),
+      marketing: Boolean(prefs && prefs.marketing)
+    };
+
+    try {
+      const now = Date.now();
+      const record = {
+        data: normalized,
+        timestamp: now,
+        expiresAt: now + STORAGE_MAX_TTL_MS
+      };
+      window.localStorage.setItem('dg_privacy_preferences', JSON.stringify(record));
+
+      if (!normalized.preferences) {
+        window.localStorage.removeItem('dg_theme');
+      }
+      enforceStorageMinimization();
+    } catch (_err) {
+      // Storage unavailable
+    }
+
+    return normalized;
+  }
+
+  // --- 2. Secure Data Handling ---
+
+  /**
+   * Masks PII (emails, phone numbers, payment cards, SSNs, bearer tokens) so sensitive values
+   * are never written to logs, error messages, or UI telemetry.
+   */
+  function redactPII(input) {
