diff --git a/src/pages/api/logout.ts b/src/pages/api/logout.ts
new file mode 100644
index 0000000..1212425
--- /dev/null
+++ b/src/pages/api/logout.ts
@@ -0,0 +1,22 @@
+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ session }) => {
+  if (session) {
+    await session.destroy();
+  }
+
+  return new Response(
+    JSON.stringify({
+      cleared: true,
+      message: 'Session destroyed and browser site data cleared.',
+    }),
+    {
+      status: 200,
+      headers: {
+        'Content-Type': 'application/json',
+        'Clear-Site-Data': '"cookies", "storage", "cache"',
+        'Cache-Control': 'no-store, max-age=0',
+      },
+    }
+  );
+};
