+    /* Options Dropdown Trigger & Popover Panel */
+    #trigger-btn {
+      anchor-name: --options-anchor;
+      background: transparent;
+      color: white;
+      border: 1px solid var(--secondary);
+      padding: 6px 14px;
+      border-radius: 4px;
+      font-family: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: color 0.3s, border-color 0.3s;
+    }
+
+    #trigger-btn:hover:not(:disabled) {
+      color: var(--accent);
+      border-color: var(--accent);
+    }
+
+    #action-panel {
+      /* Fallback for @oddbird/css-anchor-positioning polyfill */
+      position-anchor: --options-anchor;
+      bottom: auto;
+      right: auto;
+      top: anchor(bottom);
+      left: anchor(left);
+
+      /* Native CSS Anchor Positioning: below trigger, aligned to its start/left edge */
+      position-area: block-end span-inline-end;
+      inset: auto;
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+
+      margin: 0;
+      padding: 6px;
+      min-width: 190px;
+      background: white;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
+    }
+
+    #action-panel:where(:popover-open, .\:popover-open) {
+      display: flex;
+      flex-direction: column;
+      gap: 2px;
+    }
+
+    .action-item {
+      display: block;
+      width: 100%;
+      background: transparent;
+      color: var(--text);
+      border: none;
+      border-radius: 5px;
+      padding: 8px 12px;
+      min-block-size: 24px;
+      text-align: start;
+      font-family: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: background 0.2s, color 0.2s;
+    }
+
+    .action-item:hover:not(:disabled) {
+      background: var(--secondary);
+      color: var(--primary);
+    }
+
+    :where(a:any-link, button):focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
