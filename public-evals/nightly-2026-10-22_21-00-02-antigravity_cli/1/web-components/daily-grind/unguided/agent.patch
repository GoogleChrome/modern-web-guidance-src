+                  <span aria-live="polite">${item.qty}</span>
+                  <button type="button" class="qty-btn" data-action="inc" data-id="${item.id}" aria-label="Increase quantity of ${item.title}">+</button>
+                </div>
+              </div>
+            `).join('')}
+          </div>
+
+          <div class="drawer-footer">
+            <div class="subtotal-row">
+              <span>Estimated Total</span>
+              <span>$${subtotal.toFixed(2)}</span>
+            </div>
+            <a href="/order-online" class="checkout-btn">Proceed to Pickup Checkout</a>
+          </div>
+        </aside>
+      </div>
+    `;
+
+    const backdrop = this.shadowRoot.querySelector('#backdrop');
+    const closeBtn = this.shadowRoot.querySelector('.close-btn');
+    if (closeBtn) closeBtn.addEventListener('click', () => this.close());
+    if (backdrop) {
+      backdrop.addEventListener('click', (e) => {
+        if (e.target === backdrop) this.close();
+      });
+    }
+
+    this.shadowRoot.querySelectorAll('.qty-btn').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const id = btn.dataset.id;
+        const action = btn.dataset.action;
+        const target = this._items.find((i) => i.id === id);
+        if (!target) return;
+        if (action === 'inc') target.qty += 1;
+        if (action === 'dec') {
+          target.qty -= 1;
+          if (target.qty <= 0) {
+            this._items = this._items.filter((i) => i.id !== id);
+          }
+        }
+        this._broadcastState();
+        this.render();
+      });
+    });
+  }
+}
