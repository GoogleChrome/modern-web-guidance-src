+  }
+
+  connectedCallback() {
+    this.render();
+  }
+
+  _getFilteredItems() {
+    return COFFEE_MENU_DATA.filter((item) => {
+      const matchesCat = this._activeCategory === 'all' || item.category === this._activeCategory;
+      const q = this._searchQuery.trim().toLowerCase();
+      const matchesSearch = !q ||
+        item.title.toLowerCase().includes(q) ||
+        item.description.toLowerCase().includes(q) ||
+        item.notes.toLowerCase().includes(q) ||
+        item.roast.toLowerCase().includes(q);
+      return matchesCat && matchesSearch;
+    }).sort((a, b) => {
+      if (this._sortBy === 'price-asc') return a.price - b.price;
+      if (this._sortBy === 'price-desc') return b.price - a.price;
+      if (this._sortBy === 'calories-asc') return a.calories - b.calories;
+      return 0;
+    });
+  }
+
