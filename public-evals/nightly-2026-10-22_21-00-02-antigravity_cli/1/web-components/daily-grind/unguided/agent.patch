+/**
+ * 5. <dg-brew-customizer> — Interactive "Build Your Perfect Cup" Section
+ *    Allows customers to customize base espresso/brew, milk, temperature,
+ *    sweetness/syrup, and espresso shots with live nutrition + price preview
+ *    and direct "Add Custom Cup to Order" functionality.
+ */
+class DgBrewCustomizer extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._state = {
+      base: { name: 'Signature Double Espresso', price: 3.75, calories: 15, caffeine: 150 },
+      temp: 'Hot',
+      milk: { name: 'Barista Oat Milk', price: 0.75, calories: 90 },
+      syrup: { name: 'Vermont Maple Syrup', price: 0.50, calories: 45 },
+      extraShots: 0
+    };
+  }
+
+  connectedCallback() {
+    this.render();
+  }
+
+  get totalPrice() {
+    return (
+      this._state.base.price +
+      this._state.milk.price +
+      this._state.syrup.price +
+      this._state.extraShots * 1.00
+    ).toFixed(2);
+  }
+
+  get totalCalories() {
+    return (
+      this._state.base.calories +
+      this._state.milk.calories +
+      this._state.syrup.calories +
+      this._state.extraShots * 5
+    );
+  }
+
+  get totalCaffeine() {
+    return this._state.base.caffeine + this._state.extraShots * 75;
+  }
+
+  _updatePreview() {
+    const summaryTitle = this.shadowRoot.querySelector('#custom-cup-title');
+    const summaryMeta = this.shadowRoot.querySelector('#custom-cup-meta');
+    const priceDisplay = this.shadowRoot.querySelector('#custom-price');
+    const calDisplay = this.shadowRoot.querySelector('#custom-cal');
+    const cafDisplay = this.shadowRoot.querySelector('#custom-caf');
+    const shotVal = this.shadowRoot.querySelector('#shot-count');
+
+    if (summaryTitle) {
+      summaryTitle.textContent = `${this._state.temp} ${this._state.base.name}`;
+    }
+    if (summaryMeta) {
+      const syrupText = this._state.syrup.name === 'Unsweetened' ? 'No Syrup' : this._state.syrup.name;
+      const shotsText = this._state.extraShots > 0 ? ` + ${this._state.extraShots} Extra Shot${this._state.extraShots > 1 ? 's' : ''}` : '';
+      summaryMeta.textContent = `With ${this._state.milk.name}, ${syrupText}${shotsText}`;
+    }
+    if (priceDisplay) priceDisplay.textContent = `$${this.totalPrice}`;
