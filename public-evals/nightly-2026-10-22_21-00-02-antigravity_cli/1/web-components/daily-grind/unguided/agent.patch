+/**
+ * 4. <dg-menu-showcase> — Interactive Menu Section with Accessible Filter Tabs,
+ *    Live Search, Roast Filter, and Slotted or Data-Driven <dg-coffee-card> Grid
+ */
+class DgMenuShowcase extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._activeCategory = 'all';
+    this._searchQuery = '';
