+class DgCoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return [
+      'drink-id',
+      'title',
+      'description',
+      'price',
+      'category',
+      'roast',
+      'calories',
+      'badge',
+      'notes',
+      'origin',
+      'caffeine',
+      'allergens',
+      'href',
+      'image'
+    ];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._selectedSize = 'Medium';
+    this._sizeModifiers = {
+      Small: -0.50,
+      Medium: 0,
+      Large: 0.75
+    };
+    this._detailsExpanded = false;
+    this._favorited = false;
+  }
+
+  connectedCallback() {
+    this.render();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal && this.isConnected) {
+      this.render();
+    }
+  }
+
+  get basePrice() {
+    return parseFloat(this.getAttribute('price') || '4.50');
+  }
+
+  get currentPrice() {
+    const mod = this._sizeModifiers[this._selectedSize] || 0;
+    return (this.basePrice + mod).toFixed(2);
+  }
+
+  _updatePriceUI() {
+    const priceEl = this.shadowRoot.querySelector('.price-value');
+    if (priceEl) {
+      priceEl.textContent = `$${this.currentPrice}`;
+    }
+    const sizeButtons = this.shadowRoot.querySelectorAll('.size-btn');
+    sizeButtons.forEach((btn) => {
+      const isSelected = btn.dataset.size === this._selectedSize;
+      btn.setAttribute('aria-checked', String(isSelected));
+      btn.classList.toggle('active', isSelected);
+    });
+  }
