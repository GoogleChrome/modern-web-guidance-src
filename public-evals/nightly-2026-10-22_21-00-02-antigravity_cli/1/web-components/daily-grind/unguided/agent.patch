+/**
+ * 1. <dg-navbar> — Accessible Responsive Navigation Bar with Live Bag Counter
+ */
+class DgNavbar extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._cartCount = 0;
+    this._mobileMenuOpen = false;
+    this._onCartUpdated = this._onCartUpdated.bind(this);
+  }
+
+  connectedCallback() {
+    this.render();
+    window.addEventListener('dg-cart-state', this._onCartUpdated);
+  }
+
+  disconnectedCallback() {
+    window.removeEventListener('dg-cart-state', this._onCartUpdated);
+  }
+
+  _onCartUpdated(e) {
+    if (e.detail && typeof e.detail.totalCount === 'number') {
+      this._cartCount = e.detail.totalCount;
+      const badge = this.shadowRoot.querySelector('.cart-badge');
+      const live = this.shadowRoot.querySelector('#cart-live');
+      if (badge) {
+        badge.textContent = String(this._cartCount);
+        badge.classList.toggle('pulse', true);
+        setTimeout(() => badge.classList.remove('pulse'), 300);
+      }
+      if (live) {
+        live.textContent = `Order bag updated: ${this._cartCount} ${this._cartCount === 1 ? 'item' : 'items'} in bag.`;
+      }
+    }
+  }
+
