+          this._activeCategory = 'all';
+          this._searchQuery = '';
+          this._sortBy = 'featured';
+          const searchInput = this.shadowRoot.querySelector('#menu-search');
+          const sortSelect = this.shadowRoot.querySelector('#menu-sort');
+          if (searchInput) searchInput.value = '';
+          if (sortSelect) sortSelect.value = 'featured';
+          this._syncTabs();
+          this._renderGrid();
+        });
+      }
+      return;
+    }
+
+    grid.innerHTML = items.map((drink) => `
+      <dg-coffee-card
+        drink-id="${drink.id}"
+        title="${drink.title}"
+        description="${drink.description}"
+        price="${drink.price.toFixed(2)}"
+        category="${drink.category}"
+        roast="${drink.roast}"
+        calories="${drink.calories}"
+        badge="${drink.badge}"
