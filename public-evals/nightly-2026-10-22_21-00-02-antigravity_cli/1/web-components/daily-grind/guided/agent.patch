+
+    :where(a:any-link, button):focus-visible {
+      outline: 3px solid var(--_card-accent);
+      outline-offset: 3px;
+    }
+
+    /* Native <dialog> inside the shadow root for rich product details */
+    dialog {
+      margin: auto;
+      padding: 0;
+      border: none;
+      border-radius: 12px;
