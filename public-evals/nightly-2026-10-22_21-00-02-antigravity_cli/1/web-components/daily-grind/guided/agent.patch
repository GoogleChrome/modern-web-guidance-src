+    }
+  }
+
+  get expanded() {
+    return this.#expanded;
+  }
+  set expanded(val) {
+    const on = Boolean(val);
+    this.#expanded = on;
+    this.toggleAttribute('expanded', on);
+    this.#syncState();
+  }
+
+  #syncState() {
+    if (this.#internals?.states) {
+      if (this.#expanded) {
+        this.#internals.states.add('expanded');
+      } else {
+        this.#internals.states.delete('expanded');
+      }
+    }
+    const toggleBtn = this.shadowRoot?.querySelector('.menu-toggle');
+    if (toggleBtn) {
+      toggleBtn.setAttribute('aria-expanded', String(this.#expanded));
+    }
+  }
