+navTemplate.innerHTML = `
+  <nav part="nav" aria-label="Primary">
+    <div class="brand-row">
+      <slot name="brand"><div class="logo" part="logo">THE DAILY GRIND</div></slot>
+      <button type="button" class="menu-toggle" part="toggle" aria-expanded="false" aria-controls="nav-links-region">
+        Menu
+      </button>
+    </div>
+    <div id="nav-links-region" class="nav-links" part="links">
+      <slot></slot>
+    </div>
+  </nav>
+`;
+
+export class DailyGrindNav extends HTMLElement {
+  static observedAttributes = ['brand', 'expanded'];
+
+  #internals;
+  #expanded = false;
+  #initialized = false;
