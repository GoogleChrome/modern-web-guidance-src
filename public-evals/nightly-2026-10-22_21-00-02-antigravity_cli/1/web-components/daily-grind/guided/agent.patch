+      const category = (card.getAttribute('category') || '').toLowerCase();
+      const name = (card.name || card.textContent || '').toLowerCase();
+      const desc = (card.description || card.textContent || '').toLowerCase();
+      const isFav = Boolean(card.favorited || card.hasAttribute('favorited'));
