+    }
+  }
+`);
+
+const coffeeCardTemplate = document.createElement('template');
+coffeeCardTemplate.innerHTML = `
+  <article class="card" part="card">
+    <div class="media-wrap" part="media">
+      <img class="card-img" part="image" src="" alt="" loading="lazy">
+      <span class="badge" part="badge" hidden></span>
+      <button type="button" class="fav-btn" part="favorite-button" aria-pressed="false">
+        <svg aria-hidden="true" viewBox="0 0 24 24">
+          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
+        </svg>
+      </button>
+    </div>
+    <div class="content" part="content">
+      <div class="header-row">
+        <slot name="title"><h3 class="fallback-title" part="title"></h3></slot>
+        <span class="price-tag" part="price" hidden></span>
+      </div>
+      <div class="description" part="description">
+        <slot></slot>
+      </div>
+      <div class="meta-pills" part="meta" hidden></div>
+      <div class="actions" part="actions">
+        <button type="button" class="btn btn-secondary quick-view-btn" part="details-button">Quick View</button>
+        <a class="btn details-link" part="cta" href="/menu">View Details</a>
+      </div>
+    </div>
+
+    <dialog id="details-dialog" aria-labelledby="dialog-title" aria-describedby="dialog-desc">
+      <div class="dialog-body">
+        <div class="dialog-header">
+          <h2 id="dialog-title" class="dialog-title"></h2>
+          <button type="button" class="dialog-close">Close</button>
+        </div>
+        <p id="dialog-desc" class="dialog-details"></p>
+        <div class="dialog-specs">
+          <div><strong>Roast:</strong> <span class="spec-roast">Medium</span></div>
+          <div><strong>Price:</strong> <span class="spec-price">$4.50</span></div>
+          <div><strong>Notes:</strong> <span class="spec-notes">Balanced, Smooth</span></div>
+          <div><strong>Sourcing:</strong> Direct Trade</div>
+        </div>
+        <div class="dialog-footer">
+          <button type="button" class="btn btn-secondary dialog-order-btn">Add to Order</button>
+          <a class="btn dialog-link" href="/menu">Full Menu Page</a>
+        </div>
+      </div>
+    </dialog>
+  </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = [
+    'name',
+    'description',
+    'href',
+    'cta-label',
+    'price',
+    'roast',
+    'badge',
+    'image',
+    'image-alt',
+    'notes',
+    'favorited',
+    'disabled',
+  ];
+
+  #internals;
+  #favorited = false;
+  #initialized = false;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals?.() ?? null;
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.adoptedStyleSheets = [coffeeCardSheet];
+      this.shadowRoot.append(coffeeCardTemplate.content.cloneNode(true));
+    } else {
+      this.shadowRoot.adoptedStyleSheets = [coffeeCardSheet];
+    }
+  }
+
+  connectedCallback() {
+    if (!this.#initialized) {
+      this.#initialized = true;
+      this.#setupListeners();
+    }
+    this.#favorited = this.hasAttribute('favorited');
+    this.#syncFavoriteState();
+    this.#render();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'favorited') {
+      this.#favorited = newVal !== null;
+      this.#syncFavoriteState();
+    }
+    if (this.isConnected) {
+      this.#render();
+    }
+  }
+
+  get name() {
+    const titleSlot = this.shadowRoot?.querySelector('slot[name="title"]');
+    const assigned = titleSlot?.assignedElements?.() ?? [];
+    if (assigned.length > 0) {
+      return assigned[0].textContent.trim();
+    }
+    return this.getAttribute('name') ?? '';
+  }
+  set name(val) {
+    val ? this.setAttribute('name', String(val)) : this.removeAttribute('name');
+  }
+
+  get description() {
+    const defaultSlot = this.shadowRoot?.querySelector('slot:not([name])');
+    const assigned = defaultSlot?.assignedElements?.() ?? [];
+    if (assigned.length > 0) {
+      return assigned.map((el) => el.textContent.trim()).join(' ');
+    }
+    return this.getAttribute('description') ?? '';
+  }
+  set description(val) {
+    val ? this.setAttribute('description', String(val)) : this.removeAttribute('description');
+  }
+
+  get href() {
+    return this.getAttribute('href') ?? '/menu';
+  }
+  set href(val) {
+    val ? this.setAttribute('href', String(val)) : this.removeAttribute('href');
+  }
+
+  get price() {
+    return this.getAttribute('price') ?? '';
+  }
+  set price(val) {
+    val ? this.setAttribute('price', String(val)) : this.removeAttribute('price');
+  }
+
+  get roast() {
+    return this.getAttribute('roast') ?? '';
+  }
+  set roast(val) {
+    val ? this.setAttribute('roast', String(val)) : this.removeAttribute('roast');
+  }
+
+  get favorited() {
+    return this.#favorited;
+  }
+  set favorited(val) {
+    const on = Boolean(val);
+    this.#favorited = on;
+    this.toggleAttribute('favorited', on);
+    this.#syncFavoriteState();
+  }
+
+  get disabled() {
+    return this.hasAttribute('disabled');
+  }
+  set disabled(val) {
+    this.toggleAttribute('disabled', Boolean(val));
+  }
+
+  toggleFavorite() {
+    if (this.disabled) return;
+    this.favorited = !this.#favorited;
+    this.dispatchEvent(
+      new CustomEvent('coffee-favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          name: this.name,
+          favorited: this.#favorited,
+        },
+      })
+    );
+  }
+
+  openDetails() {
+    if (this.disabled) return;
+    const dialog = this.shadowRoot.getElementById('details-dialog');
+    if (dialog && typeof dialog.showModal === 'function') {
+      dialog.showModal();
+    }
+  }
+
+  closeDetails() {
+    const dialog = this.shadowRoot.getElementById('details-dialog');
+    if (dialog && dialog.open) {
+      dialog.close();
+    }
+  }
+
+  #setupListeners() {
+    const favBtn = this.shadowRoot.querySelector('.fav-btn');
+    const quickViewBtn = this.shadowRoot.querySelector('.quick-view-btn');
+    const dialog = this.shadowRoot.getElementById('details-dialog');
+    const closeBtn = this.shadowRoot.querySelector('.dialog-close');
+    const orderBtn = this.shadowRoot.querySelector('.dialog-order-btn');
+    const titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+    const defaultSlot = this.shadowRoot.querySelector('slot:not([name])');
+
+    favBtn?.addEventListener('click', () => this.toggleFavorite());
+    quickViewBtn?.addEventListener('click', () => this.openDetails());
+    closeBtn?.addEventListener('click', () => this.closeDetails());
+
+    dialog?.addEventListener('click', (e) => {
+      if (e.target === dialog) {
+        this.closeDetails();
+      }
+    });
+
+    orderBtn?.addEventListener('click', () => {
+      this.dispatchEvent(
+        new CustomEvent('coffee-order-select', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            name: this.name,
+            price: this.price,
+            roast: this.roast,
+          },
+        })
+      );
+      this.closeDetails();
+    });
+
+    titleSlot?.addEventListener('slotchange', () => this.#render());
+    defaultSlot?.addEventListener('slotchange', () => this.#render());
+  }
+
+  #syncFavoriteState() {
+    if (this.#internals?.states) {
+      if (this.#favorited) {
+        this.#internals.states.add('favorited');
+      } else {
+        this.#internals.states.delete('favorited');
+      }
+    }
+    const favBtn = this.shadowRoot?.querySelector('.fav-btn');
+    if (favBtn) {
+      favBtn.setAttribute('aria-pressed', String(this.#favorited));
+      const itemName = this.name || 'coffee item';
+      favBtn.setAttribute('aria-label', `Favorite ${itemName}`);
+    }
+  }
+
+  #render() {
+    const root = this.shadowRoot;
+    if (!root) return;
+
+    const itemName = this.name || 'Coffee Selection';
+    const itemDesc = this.description || '';
+    const ctaLabel = this.getAttribute('cta-label') || 'View Details';
+    const href = this.href;
+    const price = this.price;
+    const roast = this.roast;
+    const badge = this.getAttribute('badge') || '';
+    const image = this.getAttribute('image') || '';
+    const imageAlt = this.getAttribute('image-alt') ?? `${itemName} served fresh`;
+    const notes = this.getAttribute('notes') || '';
+
+    const fallbackTitle = root.querySelector('.fallback-title');
+    if (fallbackTitle) {
+      fallbackTitle.textContent = itemName;
+    }
+
+    const defaultSlot = root.querySelector('slot:not([name])');
+    if (defaultSlot && (defaultSlot.assignedNodes().length === 0)) {
+      defaultSlot.textContent = itemDesc;
+    }
+
+    const mediaWrap = root.querySelector('.media-wrap');
+    const imgEl = root.querySelector('.card-img');
+    if (image) {
+      mediaWrap.hidden = false;
+      imgEl.src = image;
+      imgEl.alt = imageAlt;
+    } else {
+      mediaWrap.hidden = true;
+    }
+
+    const badgeEl = root.querySelector('.badge');
+    if (badge) {
+      badgeEl.hidden = false;
+      badgeEl.textContent = badge;
+    } else {
+      badgeEl.hidden = true;
+    }
+
+    const priceEl = root.querySelector('.price-tag');
+    if (price) {
+      priceEl.hidden = false;
+      priceEl.textContent = price;
+    } else {
+      priceEl.hidden = true;
+    }
+
+    const metaPills = root.querySelector('.meta-pills');
+    metaPills.innerHTML = '';
+    if (roast || notes) {
+      metaPills.hidden = false;
+      if (roast) {
+        const pill = document.createElement('span');
+        pill.className = 'pill';
+        pill.textContent = `${roast} Roast`;
+        metaPills.append(pill);
+      }
+      if (notes) {
+        const pill = document.createElement('span');
+        pill.className = 'pill';
+        pill.textContent = notes;
+        metaPills.append(pill);
+      }
+    } else {
+      metaPills.hidden = true;
+    }
+
+    // Disambiguate CTA links and buttons so screen reader users hear the item name
+    const detailsLink = root.querySelector('.details-link');
+    if (detailsLink) {
+      detailsLink.href = href;
+      detailsLink.textContent = ctaLabel;
+      detailsLink.setAttribute('aria-label', `${ctaLabel} for ${itemName}`);
+    }
+
+    const quickViewBtn = root.querySelector('.quick-view-btn');
+    if (quickViewBtn) {
+      quickViewBtn.setAttribute('aria-label', `Quick View ${itemName}`);
+    }
+
+    // Populate native dialog details
+    const dialogTitle = root.querySelector('.dialog-title');
+    const dialogDesc = root.querySelector('.dialog-details');
+    const specRoast = root.querySelector('.spec-roast');
+    const specPrice = root.querySelector('.spec-price');
+    const specNotes = root.querySelector('.spec-notes');
+    const dialogLink = root.querySelector('.dialog-link');
+    const dialogOrderBtn = root.querySelector('.dialog-order-btn');
+
+    if (dialogTitle) dialogTitle.textContent = itemName;
+    if (dialogDesc) dialogDesc.textContent = itemDesc;
+    if (specRoast) specRoast.textContent = roast ? `${roast} Roast` : 'House Signature';
+    if (specPrice) specPrice.textContent = price || 'Market Price';
+    if (specNotes) specNotes.textContent = notes || 'Smooth, aromatic finish';
+    if (dialogLink) {
+      dialogLink.href = href;
+      dialogLink.setAttribute('aria-label', `Full Menu Page for ${itemName}`);
+    }
+    if (dialogOrderBtn) {
+      dialogOrderBtn.setAttribute('aria-label', `Add ${itemName} to Order`);
+    }
+
+    this.#syncFavoriteState();
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
