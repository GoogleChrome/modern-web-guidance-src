+
+    .dialog-footer {
+      display: flex;
+      justify-content: flex-end;
+      gap: 10px;
+    }
+
+    @container (min-width: 28rem) {
+      .card {
+        flex-direction: row;
+        text-align: left;
+      }
+      .media-wrap {
+        width: 40%;
+        aspect-ratio: auto;
+      }
+      .content {
+        text-align: left;
+        align-items: flex-start;
+      }
+      .header-row {
+        flex-direction: row;
+        justify-content: space-between;
