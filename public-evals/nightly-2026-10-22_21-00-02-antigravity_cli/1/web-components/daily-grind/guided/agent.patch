+if (typeof document !== 'undefined') {
+  document.addEventListener('coffee-order-select', (e) => {
+    const hero = document.querySelector('daily-grind-hero');
+    if (hero && typeof hero.openOrderModal === 'function') {
+      hero.openOrderModal(e.detail?.name);
+    }
+  });
+}
