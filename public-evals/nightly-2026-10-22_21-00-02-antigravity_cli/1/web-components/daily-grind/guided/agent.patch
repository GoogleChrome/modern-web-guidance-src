+        matchesFilter =
+          roast.includes(this.#activeFilter) || category.includes(this.#activeFilter);
+      }
+
+      let matchesSearch = true;
+      if (this.#searchQuery) {
+        matchesSearch = name.includes(this.#searchQuery) || desc.includes(this.#searchQuery);
+      }
