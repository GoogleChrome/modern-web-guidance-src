+  <script>
+    (function () {
+      const roastInput = document.getElementById('roast-level');
+      const roastDisplay = document.getElementById('roast-level-display');
+      const progress = document.getElementById('setup-progress');
+      const progressText = document.getElementById('progress-text');
+      const form = document.getElementById('coffee-subscription-form');
+      const roastNames = {
+        1: 'Light',
+        2: 'Medium-Light',
+        3: 'Medium',
+        4: 'Medium-Dark',
+        5: 'Dark'
+      };
+
+      function updateFormState() {
+        const val = roastInput.value;
+        if (roastDisplay && roastNames[val]) {
+          roastDisplay.textContent = `${roastNames[val]} (${val}/5)`;
+        }
+
+        let completedSteps = 0;
+        const selectedFreq = form.querySelector('input[name="delivery-frequency"]:checked');
+        if (selectedFreq) completedSteps += 1;
+        if (roastInput && roastInput.value) completedSteps += 1;
+        const emailCheckbox = document.getElementById('email-updates');
+        if (emailCheckbox && emailCheckbox.checked) completedSteps += 1;
+
+        const pct = Math.round((completedSteps / 3) * 100);
+        if (progress) {
+          progress.value = pct;
+          progress.textContent = `${pct}%`;
+        }
+        if (progressText) {
+          progressText.textContent = `${pct}% Complete`;
+        }
+      }
+
+      if (form) {
+        form.addEventListener('input', updateFormState);
+        form.addEventListener('change', updateFormState);
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          if (progress) progress.value = 100;
+          if (progressText) progressText.textContent = '100% Complete — Subscribed!';
+        });
+        updateFormState();
+      }
+    })();
+  </script>
+
