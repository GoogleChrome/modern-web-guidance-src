+  <script>
+    (function () {
+      const form = document.getElementById('subscription-form');
+      const roastSlider = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-output');
+      const progressBar = document.getElementById('subscription-progress');
+      const progressOutput = document.getElementById('progress-output');
+      const emailCheckbox = document.getElementById('receive-emails');
+      const statusMessage = document.getElementById('subscription-status');
+      const submitBtn = document.getElementById('submit-subscription');
+
+      const roastLabels = {
+        1: 'Light (1 / 5)',
+        2: 'Medium-Light (2 / 5)',
+        3: 'Medium (3 / 5)',
+        4: 'Medium-Dark (4 / 5)',
+        5: 'Dark (5 / 5)'
+      };
+
+      let roastInteracted = false;
+
+      function updateSliderProgress(slider) {
+        const min = Number(slider.min) || 0;
+        const max = Number(slider.max) || 100;
+        const val = Number(slider.value) || 0;
+        const pct = ((val - min) / (max - min)) * 100;
+        slider.style.setProperty('--progress', `${pct}%`);
+      }
+
+      function updateCompletionProgress() {
+        let stepsCompleted = 0;
+        const totalSteps = 3;
+
+        // 1. Delivery frequency selected
+        const selectedFreq = form.querySelector('input[name="delivery_frequency"]:checked');
+        if (selectedFreq) stepsCompleted += 1;
+
+        // 2. Roast preference level set
+        if (roastSlider.value) stepsCompleted += 1;
+
+        // 3. Email opt-in checked or user interacted with roast/form
+        if (emailCheckbox.checked || roastInteracted) stepsCompleted += 1;
+
+        const pct = Math.round((stepsCompleted / totalSteps) * 100);
+        progressBar.value = pct;
+        progressBar.textContent = `${pct}%`;
+        progressOutput.value = `${pct}%`;
+      }
+
+      roastSlider.addEventListener('input', (e) => {
+        roastInteracted = true;
+        const val = e.target.value;
+        roastOutput.value = roastLabels[val] || `${val} / 5`;
+        if (!CSS.supports('accent-color', '#4e342e')) {
+          updateSliderProgress(roastSlider);
+        }
+        updateCompletionProgress();
+      });
+
+      form.addEventListener('change', () => {
+        updateCompletionProgress();
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        progressBar.value = 100;
+        progressBar.textContent = '100%';
+        progressOutput.value = '100%';
+        submitBtn.disabled = true;
+        statusMessage.textContent = 'Your personalized coffee subscription preferences have been saved!';
+      });
+
+      if (!CSS.supports('accent-color', '#4e342e')) {
+        updateSliderProgress(roastSlider);
+      }
+      updateCompletionProgress();
+    })();
+  </script>
+
