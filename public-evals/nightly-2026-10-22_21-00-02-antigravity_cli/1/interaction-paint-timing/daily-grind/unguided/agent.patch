+        }
+
+        const linkEl = event.target.closest('a[href]');
+        if (linkEl) {
+          const href = linkEl.getAttribute('href');
+          if (href && href.startsWith('/')) {
+            event.preventDefault();
+            history.pushState({ path: href }, '', href);
+            renderRouteContent(href, event.timeStamp, false);
+            return;
+          }
+        }
+
+        const filterBtn = event.target.closest('[data-interaction]');
+        if (filterBtn) {
+          const action = filterBtn.getAttribute('data-interaction');
+          document.querySelectorAll('.filter-btn').forEach((btn) => {
+            btn.classList.toggle('active', btn === filterBtn);
+          });
+          const label =
+            action === 'barista-pick'
+              ? "Barista's Featured Selection: Single-Origin Ethiopian Pour-Over"
+              : 'Filtered Menu: ' + filterBtn.textContent.trim();
+          handleUserInteractionUpdate(action, label, event.timeStamp);
+          return;
+        }
+
+        const orderBtn = event.target.closest('[data-order-item]');
+        if (orderBtn) {
+          const itemName = orderBtn.getAttribute('data-order-item');
+          handleUserInteractionUpdate(
+            'quick-add',
+            'Added to Order: ' + itemName,
+            event.timeStamp
+          );
+        }
+      });
+
+      window.addEventListener('popstate', (event) => {
+        const path = (event.state && event.state.path) || window.location.pathname || '/';
+        renderRouteContent(path, event.timeStamp, true);
+      });
+    })();
+  </script>
