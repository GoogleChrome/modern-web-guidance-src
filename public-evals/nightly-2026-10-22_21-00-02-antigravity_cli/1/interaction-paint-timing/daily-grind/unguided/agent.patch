+          });
+          elementObserver.observe({ type: 'element', buffered: true });
+        } catch (err) {}
+
+        try {
+          const containerObserver = new PerformanceObserver((list) => {
+            for (const entry of list.getEntries()) {
+              metricsStore.containerTimings.push(entry);
+            }
+          });
+          containerObserver.observe({ type: 'container', buffered: true });
+        } catch (err) {}
+      }
