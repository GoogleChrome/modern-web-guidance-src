+      // =========================================================================
+      // 3. Frame-Accurate Paint Timing Tracker for Interactions & Client Navigations
+      //    Measures exact time from interaction startTime to next contentful paint
+      //    (including image decode/load when new images are rendered).
+      // =========================================================================
+      function measureContentfulRender(options) {
+        const startTime =
+          typeof options.eventTimeStamp === 'number' && options.eventTimeStamp > 0
+            ? options.eventTimeStamp
+            : performance.now();
+
+        const actionInfo = {
+          category: options.category || 'interaction',
+          label: options.label || 'Interaction',
+          url: options.url || window.location.pathname,
+          startTime: startTime,
+          paintTime: null,
+          isSoftNavigation: Boolean(options.isSoftNavigation)
+        };
+        pendingManualAction = actionInfo;
+
+        const container = options.container || document.getElementById('main-content');
+
+        // Wait for the browser to commit layout and paint the new DOM content in the next frame
+        requestAnimationFrame(() => {
+          requestAnimationFrame(() => {
+            const domPaintTime = performance.now();
+            actionInfo.paintTime = domPaintTime;
+
+            let largestElement = container ? container.querySelector('img, h2, h3, p') : null;
+            let largestArea = 0;
+
+            if (container) {
+              const candidates = container.querySelectorAll('img, h1, h2, h3, p, .card, .contentful-banner');
+              candidates.forEach((el) => {
+                const rect = el.getBoundingClientRect();
+                const area = Math.round(rect.width * rect.height);
+                if (area > largestArea) {
+                  largestArea = area;
+                  largestElement = el;
+                }
+              });
+            }
+
+            // Record the immediate DOM contentful paint measurement if native observers haven't already logged this exact action
+            const hasNativeICPSupported =
+              typeof PerformanceObserver !== 'undefined' &&
+              Array.isArray(PerformanceObserver.supportedEntryTypes) &&
+              PerformanceObserver.supportedEntryTypes.includes('interaction-contentful-paint');
+
+            const duration = Math.max(0, domPaintTime - startTime);
+
+            if (!hasNativeICPSupported) {
+              const fallbackRecord = {
+                category: options.isSoftNavigation ? 'soft-navigation' : 'interaction-contentful-paint',
+                label: actionInfo.label,
+                url: actionInfo.url,
+                startTime: startTime,
+                paintTime: domPaintTime,
+                duration: duration,
+                size: largestArea,
+                element: largestElement,
+                elementDescription: describeElement(largestElement),
+                isSoftNavigation: Boolean(options.isSoftNavigation)
+              };
+
+              console.log(
+                options.isSoftNavigation
+                  ? '[Client-Side Navigation Contentful Paint]'
+                  : '[User Interaction Contentful Paint]',
+                {
+                  label: fallbackRecord.label,
+                  url: fallbackRecord.url,
+                  startTime: fallbackRecord.startTime,
+                  paintTime: fallbackRecord.paintTime,
+                  timeToContentfulUpdateMs: fallbackRecord.duration,
+                  size: fallbackRecord.size,
+                  element: largestElement
+                }
+              );
+
+              updateTelemetryUI(fallbackRecord);
+            }
+          });
+        });
+      }
