+      function renderRouteContent(path, eventTimeStamp, isPopState) {
+        const normalizedPath = ROUTES[path] ? path : '/menu';
+        const routeData = ROUTES[normalizedPath];
+
+        // Update active nav link
+        document.querySelectorAll('nav a').forEach((link) => {
+          link.classList.toggle('active', link.getAttribute('href') === path);
+        });
+
+        // Replace Hero content with new DOM nodes to trigger contentful paint
+        const hero = document.getElementById('hero-section');
+        if (hero) {
+          hero.innerHTML =
+            '<h1 elementtiming="hero-heading">' + routeData.heroTitle + '</h1>' +
+            '<p>' + routeData.heroSubtitle + '</p>' +
+            '<a href="' + routeData.heroCtaHref + '" class="btn">' + routeData.heroCtaText + '</a>';
+        }
+
+        // Replace Main container view with new contentful elements (headings, images, cards)
+        const main = document.getElementById('main-content');
+        if (main) {
+          const filterToolbarHtml = routeData.showFilters
+            ? '<div class="interaction-toolbar" role="toolbar" aria-label="Filter items">' +
+                '<button type="button" class="filter-btn active" data-interaction="filter-all">All Favorites</button>' +
+                '<button type="button" class="filter-btn" data-interaction="filter-hot">Hot Crafted</button>' +
+                '<button type="button" class="filter-btn" data-interaction="filter-iced">Chilled &amp; Cold Brew</button>' +
+                '<button type="button" class="filter-btn" data-interaction="barista-pick">Reveal Barista\'s Pick</button>' +
+              '</div>'
+            : '';
+
+          const cardsHtml = routeData.cards
+            .map(
+              (card) =>
+                '<div class="card" data-category="' + (card.category || 'all') + '">' +
+                  (card.image
+                    ? '<img src="' + card.image + '" alt="' + card.title + '" crossorigin="anonymous" elementtiming="card-image">'
+                    : '') +
+                  '<h3>' + card.title + '</h3>' +
+                  '<p>' + card.description + '</p>' +
+                  '<a href="' + card.href + '" class="btn">' + card.btnText + '</a>' +
+                  '<button type="button" class="btn btn-secondary" data-order-item="' + card.title + '">Quick Add</button>' +
+                '</div>'
+            )
+            .join('');
+
+          main.innerHTML =
+            '<section id="view-section">' +
+              '<h2 style="text-align: center;" elementtiming="section-heading">' + routeData.sectionTitle + '</h2>' +
