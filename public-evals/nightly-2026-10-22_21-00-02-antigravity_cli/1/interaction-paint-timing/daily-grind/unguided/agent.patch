+  <script>
+    (function () {
+      'use strict';
+
+      // =========================================================================
+      // 1. Performance Measurement State & Public Telemetry Store
+      // =========================================================================
+      const softNavigationsById = new Map();
+      const softNavigationsByInteractionId = new Map();
+      const interactionsById = new Map();
+      let latestSoftNavigation = null;
+      let pendingManualAction = null;
+
+      const metricsStore = {
+        softNavigations: [],
+        interactionContentfulPaints: [],
+        interactions: [],
+        lcpEntries: [],
+        elementTimings: [],
+        containerTimings: [],
+        records: [],
+        getLatestSoftNavigationLCP() {
+          if (latestSoftNavigation && typeof latestSoftNavigation.getLargestInteractionContentfulPaint === 'function') {
+            return latestSoftNavigation.getLargestInteractionContentfulPaint();
+          }
+          for (let i = this.interactionContentfulPaints.length - 1; i >= 0; i--) {
+            const item = this.interactionContentfulPaints[i];
+            if (!latestSoftNavigation || item.navigationId === latestSoftNavigation.navigationId) {
+              return item;
+            }
+          }
+          return null;
+        }
+      };
+
+      window.__perfMetrics = metricsStore;
+      window.performanceMetrics = metricsStore;
+
+      function formatMs(value) {
+        if (typeof value !== 'number' || !Number.isFinite(value)) return '—';
+        return value.toFixed(1) + ' ms';
+      }
+
+      function describeElement(el) {
+        if (!el || !el.tagName) return 'contentful node';
+        const tag = el.tagName.toLowerCase();
+        const id = el.id ? '#' + el.id : '';
+        const cls = el.className && typeof el.className === 'string'
+          ? '.' + el.className.trim().split(/\s+/).join('.')
+          : '';
+        const text = (el.textContent || el.alt || '').trim().slice(0, 28);
+        return tag + id + cls + (text ? ' ("' + text + '")' : '');
+      }
+
+      function updateTelemetryUI(record) {
+        metricsStore.records.push(record);
+
+        const totalEl = document.getElementById('stat-total-count');
+        const totalMetaEl = document.getElementById('stat-total-meta');
+        if (totalEl) {
+          totalEl.textContent = String(metricsStore.records.length);
+        }
+        if (totalMetaEl) {
+          totalMetaEl.textContent =
+            metricsStore.softNavigations.length + ' soft navs, ' +
+            metricsStore.interactionContentfulPaints.length + ' ICP entries';
+        }
+
+        if (record.category === 'soft-navigation' || record.isSoftNavigation) {
+          const navTimeEl = document.getElementById('stat-softnav-time');
+          const navMetaEl = document.getElementById('stat-softnav-meta');
+          if (navTimeEl) navTimeEl.textContent = formatMs(record.duration);
+          if (navMetaEl) {
+            navMetaEl.textContent =
+              (record.url || record.label) +
+              (record.navigationId ? ' | navId: ' + String(record.navigationId).slice(0, 8) : '');
+          }
+        }
+
+        if (record.category === 'interaction-contentful-paint' || record.category === 'interaction') {
+          const icpTimeEl = document.getElementById('stat-icp-time');
+          const icpMetaEl = document.getElementById('stat-icp-meta');
+          if (icpTimeEl) icpTimeEl.textContent = formatMs(record.duration);
+          if (icpMetaEl) {
+            icpMetaEl.textContent =
+              (record.label || 'Interaction') +
+              (record.interactionId ? ' | interactionId: ' + record.interactionId : '') +
+              (record.size ? ' | size: ' + record.size + 'px²' : '');
+          }
+        }
+
+        const tbody = document.getElementById('perf-log-body');
+        if (!tbody) return;
+        const emptyRow = document.getElementById('perf-log-empty');
+        if (emptyRow) emptyRow.remove();
+
+        const tr = document.createElement('tr');
+        const badgeClass =
+          record.category === 'soft-navigation'
+            ? 'badge-nav'
+            : record.category === 'interaction-contentful-paint'
+            ? 'badge-icp'
+            : 'badge-interaction';
+
+        tr.innerHTML =
+          '<td><span class="badge ' + badgeClass + '">' + record.category + '</span></td>' +
+          '<td>' + (record.url || record.label || '—') + '</td>' +
+          '<td>' + formatMs(record.startTime) + '</td>' +
+          '<td>' + formatMs(record.paintTime) + '</td>' +
+          '<td><strong>' + formatMs(record.duration) + '</strong></td>' +
+          '<td>' + (record.elementDescription || '—') + (record.size ? ' (' + record.size + 'px²)' : '') + '</td>';
+
+        tbody.insertBefore(tr, tbody.firstChild);
+      }
+
+      // =========================================================================
+      // 2. Web Performance API Observers
+      //    - 'soft-navigation' (PerformanceSoftNavigation)
+      //    - 'interaction-contentful-paint' (InteractionContentfulPaint)
+      //    - 'largest-contentful-paint' (LargestContentfulPaint)
+      //    - 'event' (PerformanceEventTiming)
+      //    - 'container' & 'element'
+      // =========================================================================
+      function handleSoftNavigationEntry(entry) {
+        latestSoftNavigation = entry;
+        if (entry.navigationId) {
+          softNavigationsById.set(entry.navigationId, entry);
+        }
+        if (entry.interactionId) {
+          softNavigationsByInteractionId.set(entry.interactionId, entry);
+        }
+
+        const lcpFromNav =
+          typeof entry.getLargestInteractionContentfulPaint === 'function'
+            ? entry.getLargestInteractionContentfulPaint()
+            : null;
+
+        const paintTimestamp =
+          entry.presentationTime ||
+          entry.paintTime ||
+          (lcpFromNav && (lcpFromNav.presentationTime || lcpFromNav.renderTime || lcpFromNav.paintTime || lcpFromNav.startTime)) ||
+          (pendingManualAction && pendingManualAction.paintTime) ||
+          performance.now();
+
+        const duration =
+          entry.duration > 0
+            ? entry.duration
+            : Math.max(0, paintTimestamp - entry.startTime);
+
+        const navRecord = {
+          category: 'soft-navigation',
+          entryType: entry.entryType,
+          url: entry.name,
+          label: entry.name,
+          startTime: entry.startTime,
+          paintTime: paintTimestamp,
+          duration: duration,
+          navigationId: entry.navigationId,
+          interactionId: entry.interactionId,
+          elementDescription: lcpFromNav && lcpFromNav.element ? describeElement(lcpFromNav.element) : 'Soft Navigation View',
+          rawEntry: entry
+        };
+
+        metricsStore.softNavigations.push(navRecord);
+        console.log('[Soft Navigation]', {
+          url: entry.name,
+          navigationId: entry.navigationId,
+          interactionId: entry.interactionId,
+          startTime: entry.startTime,
+          paintTime: paintTimestamp,
+          timeToContentfulUpdateMs: duration,
+          entry: entry
+        });
+
+        updateTelemetryUI(navRecord);
+      }
+
+      function handleInteractionContentfulPaintEntry(entry) {
+        // Support both nested entry.largestContentfulPaint (WICG / Chrome 151+)
+        // and direct LCP properties on the InteractionContentfulPaint entry.
+        const lcpObj = entry.largestContentfulPaint || entry;
+
+        const matchingSoftNav =
+          (entry.navigationId && softNavigationsById.get(entry.navigationId)) ||
+          (entry.interactionId && softNavigationsByInteractionId.get(entry.interactionId)) ||
+          latestSoftNavigation;
+
+        const matchingEvent =
+          entry.interactionId ? interactionsById.get(entry.interactionId) : null;
+
+        const paintTimestamp =
+          entry.presentationTime ||
+          entry.paintTime ||
+          lcpObj.presentationTime ||
+          lcpObj.renderTime ||
+          lcpObj.paintTime ||
+          lcpObj.loadTime ||
+          entry.renderTime ||
+          entry.loadTime ||
+          entry.startTime;
+
+        let startTime = entry.startTime;
+        let duration = entry.duration;
+
+        // If duration is 0 (when startTime represents renderTime instead of interaction start),
+        // compute elapsed time relative to the triggering soft-navigation or interaction startTime.
+        if (!duration || duration <= 0) {
+          if (matchingSoftNav && matchingSoftNav.startTime <= paintTimestamp) {
+            startTime = matchingSoftNav.startTime;
+            duration = paintTimestamp - matchingSoftNav.startTime;
+          } else if (matchingEvent && matchingEvent.startTime <= paintTimestamp) {
+            startTime = matchingEvent.startTime;
+            duration = paintTimestamp - matchingEvent.startTime;
+          } else if (pendingManualAction && pendingManualAction.startTime <= paintTimestamp) {
+            startTime = pendingManualAction.startTime;
+            duration = paintTimestamp - pendingManualAction.startTime;
+          } else {
+            duration = Math.max(0, paintTimestamp - startTime);
+          }
+        }
+
+        const targetElement = lcpObj.element || entry.element || null;
+        const size = lcpObj.size || entry.size || 0;
+        const isSoftNav = Boolean(matchingSoftNav && entry.navigationId === matchingSoftNav.navigationId);
+
+        const icpRecord = {
+          category: 'interaction-contentful-paint',
+          entryType: entry.entryType,
+          label: (matchingSoftNav && matchingSoftNav.name) || (pendingManualAction && pendingManualAction.label) || 'User Interaction Paint',
+          url: matchingSoftNav ? matchingSoftNav.name : window.location.pathname,
+          startTime: startTime,
+          paintTime: paintTimestamp,
+          renderTime: lcpObj.renderTime || entry.renderTime || paintTimestamp,
+          loadTime: lcpObj.loadTime || entry.loadTime || 0,
+          duration: duration,
+          interactionId: entry.interactionId,
+          navigationId: entry.navigationId,
+          size: size,
+          element: targetElement,
+          elementDescription: describeElement(targetElement),
+          isSoftNavigation: isSoftNav,
+          rawEntry: entry
+        };
+
+        metricsStore.interactionContentfulPaints.push(icpRecord);
+        console.log('[Interaction Contentful Paint]', {
+          interactionId: entry.interactionId,
+          navigationId: entry.navigationId,
+          startTime: startTime,
+          paintTime: paintTimestamp,
+          renderTime: icpRecord.renderTime,
+          loadTime: icpRecord.loadTime,
+          timeToContentfulUpdateMs: duration,
+          size: size,
+          element: targetElement,
+          largestContentfulPaint: entry.largestContentfulPaint,
+          entry: entry
+        });
+
+        updateTelemetryUI(icpRecord);
+      }
+
+      function handleLCPEntry(entry) {
+        const paintTime = entry.renderTime || entry.loadTime || entry.startTime;
+        const matchingSoftNav =
+          entry.navigationId && softNavigationsById.get(entry.navigationId);
+        const baselineStart = matchingSoftNav ? matchingSoftNav.startTime : 0;
+        const duration = Math.max(0, paintTime - baselineStart);
+
+        metricsStore.lcpEntries.push({
+          startTime: baselineStart,
+          paintTime: paintTime,
+          renderTime: entry.renderTime,
+          loadTime: entry.loadTime,
+          duration: duration,
+          size: entry.size,
+          element: entry.element,
+          navigationId: entry.navigationId,
+          rawEntry: entry
+        });
+
+        const lcpTimeEl = document.getElementById('stat-lcp-time');
+        const lcpMetaEl = document.getElementById('stat-lcp-meta');
+        if (lcpTimeEl) lcpTimeEl.textContent = formatMs(duration);
+        if (lcpMetaEl) {
+          lcpMetaEl.textContent =
+            describeElement(entry.element) +
+            (entry.size ? ' | ' + entry.size + 'px²' : '');
+        }
+
+        console.log('[Largest Contentful Paint]', {
+          duration: duration,
+          renderTime: entry.renderTime,
+          loadTime: entry.loadTime,
+          size: entry.size,
+          element: entry.element,
+          navigationId: entry.navigationId
+        });
+      }
+
+      function handleEventTimingEntry(entry) {
+        if (entry.interactionId) {
+          const existing = interactionsById.get(entry.interactionId);
+          if (!existing || entry.duration > existing.duration) {
+            interactionsById.set(entry.interactionId, entry);
+          }
+          metricsStore.interactions.push({
+            name: entry.name,
+            interactionId: entry.interactionId,
+            startTime: entry.startTime,
+            processingStart: entry.processingStart,
+            processingEnd: entry.processingEnd,
+            duration: entry.duration,
+            navigationId: entry.navigationId,
+            target: entry.target
+          });
+        }
+      }
+
+      if (typeof PerformanceObserver !== 'undefined') {
+        // 1. Observe 'soft-navigation' entries for client-side route transitions
+        try {
+          const softNavObserver = new PerformanceObserver((list) => {
+            for (const entry of list.getEntries()) {
+              handleSoftNavigationEntry(entry);
+            }
+          });
+          softNavObserver.observe({ type: 'soft-navigation', buffered: true });
+        } catch (err) {
+          // Soft navigation entryType not supported in this browser mode
+        }
+
+        // 2. Observe 'interaction-contentful-paint' entries for contentful updates after interactions & soft navigations
+        try {
+          const icpObserver = new PerformanceObserver((list) => {
+            for (const entry of list.getEntries()) {
+              handleInteractionContentfulPaintEntry(entry);
+            }
+          });
+          icpObserver.observe({ type: 'interaction-contentful-paint', buffered: true });
+        } catch (err) {
+          // interaction-contentful-paint entryType not supported in this browser mode
+        }
+
+        // 3. Observe 'largest-contentful-paint' (including soft navigation observations where supported)
+        try {
+          const lcpObserver = new PerformanceObserver((list) => {
+            for (const entry of list.getEntries()) {
+              handleLCPEntry(entry);
+            }
+          });
+          lcpObserver.observe({
+            type: 'largest-contentful-paint',
+            buffered: true,
+            includeSoftNavigationObservations: true
+          });
+        } catch (err) {
+          // largest-contentful-paint not supported
+        }
+
+        // 4. Observe 'event' (Event Timing / INP) to correlate interactionId and startTime
+        try {
+          const eventObserver = new PerformanceObserver((list) => {
+            for (const entry of list.getEntries()) {
+              handleEventTimingEntry(entry);
+            }
+          });
+          eventObserver.observe({
+            type: 'event',
+            buffered: true,
+            durationThreshold: 16,
+            includeSoftNavigationObservations: true
+          });
+        } catch (err) {
+          // Event Timing not supported
+        }
+
+        // 5. Observe 'element' and 'container' timing if supported
+        try {
