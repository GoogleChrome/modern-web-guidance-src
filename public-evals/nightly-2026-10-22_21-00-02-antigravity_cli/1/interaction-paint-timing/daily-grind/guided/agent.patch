+
+    function renderRoute(pathname, pushState = true) {
+      const view = ROUTE_VIEWS[pathname] || {
+        title: `The Daily Grind — ${pathname.replace(/^\//, '').replace(/-/g, ' ') || 'Home'}`,
+        items: [
+          {
+            name: 'Freshly Roasted Selection',
+            desc: `Explore our curated offerings for ${pathname}.`,
+            href: '/menu',
+            cta: 'Back to Full Menu',
+            details: 'Small-batch roasted daily and shipped within 24 hours of roasting.',
+          },
+        ],
+      };
+
+      if (pushState && window.location.pathname !== pathname) {
+        history.pushState({ pathname }, '', pathname);
+      }
+
+      const appContent = document.getElementById('app-content');
+      if (!appContent) return;
+
+      appContent.innerHTML = `
+        <h2 style="text-align: center;">${view.title}</h2>
+        <div class="grid">
+          ${view.items
+            .map(
+              (item, idx) => `
+            <div class="card" data-card-index="${idx}">
+              <h3>${item.name}</h3>
+              <p>${item.desc}</p>
+              <div class="card-extra" hidden style="margin-top: 10px; font-size: 0.9rem; color: var(--primary);">
+                ${item.details}
+              </div>
+              <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
+                <a href="${item.href}" class="btn" data-spa-link>${item.cta}</a>
+                <button type="button" class="btn" data-toggle-details style="border: none; cursor: pointer; font-family: inherit;">
+                  Quick Tasting Notes
+                </button>
+              </div>
+            </div>
+          `
+            )
+            .join('')}
+        </div>
+      `;
+    }
+
+    // Intercept client-side navigation links and in-page interaction buttons
+    document.addEventListener('click', (event) => {
+      const toggleBtn = event.target.closest('[data-toggle-details]');
+      if (toggleBtn) {
+        const card = toggleBtn.closest('.card');
+        const extra = card?.querySelector('.card-extra');
+        if (extra) {
+          extra.hidden = !extra.hidden;
+          toggleBtn.textContent = extra.hidden ? 'Quick Tasting Notes' : 'Hide Tasting Notes';
+        }
+        return;
+      }
+
+      const link = event.target.closest('a[data-spa-link]');
+      if (link && link.origin === window.location.origin) {
+        event.preventDefault();
+        renderRoute(link.pathname, true);
+      }
+    });
+
+    window.addEventListener('popstate', () => {
+      renderRoute(window.location.pathname, false);
+    });
+  </script>
