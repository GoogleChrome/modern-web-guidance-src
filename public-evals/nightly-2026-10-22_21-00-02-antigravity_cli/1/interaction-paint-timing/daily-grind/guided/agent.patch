+        ],
+      },
+      '/menu': {
+        title: 'Full Artisanal Menu',
+        items: [
+          {
+            name: 'Pour-Over Single Origin',
+            desc: 'Hand-poured Ethiopian Yirgacheffe with floral and citrus notes.',
+            href: '/menu/seasonal',
+            cta: 'Customize Drink',
+            details: 'Brewed to order using V60 • Tasting notes: Bergamot, jasmine, peach.',
