+
+      const CAFE_LOCATIONS = [
+        {
+          name: "Downtown Roastery",
+          address: "101 Main St, Burlington, VT 05401",
+          hours: "6:00 AM – 7:00 PM",
+          amenities: ["wifi", "patio"]
+        },
+        {
+          name: "Riverside Cafe",
+          address: "240 River Rd, Burlington, VT 05402",
+          hours: "6:30 AM – 6:00 PM",
+          amenities: ["wifi", "drive-thru", "patio"]
+        },
+        {
+          name: "University Corner",
+          address: "88 College Ave, Burlington, VT 05405",
+          hours: "7:00 AM – 9:00 PM",
+          amenities: ["wifi"]
+        }
+      ];
+
+      function showBanner(elementId, message) {
+        const el = document.getElementById(elementId);
+        if (el) {
+          el.textContent = message;
+          el.classList.add("visible");
+        }
+        const globalEl = document.getElementById("global-status");
+        if (globalEl && elementId !== "global-status") {
+          globalEl.textContent = message;
+          globalEl.classList.add("visible");
+        }
+      }
+
+      function replyToAgentIfInvoked(event, payload) {
+        if (event.agentInvoked && typeof event.respondWith === "function") {
+          event.respondWith(Promise.resolve(payload));
+        }
+      }
+
+      // 1. Menu Search & Filter Form
+      const menuSearchForm = document.getElementById("menu-search-form");
+      if (menuSearchForm) {
+        menuSearchForm.addEventListener("submit", function (event) {
+          event.preventDefault();
+          const formData = new FormData(menuSearchForm);
+          const query = (formData.get("query") || "").toString().trim().toLowerCase();
+          const category = (formData.get("category") || "all").toString();
+          const dietary = (formData.get("dietary") || "any").toString();
+
+          const cards = document.querySelectorAll("#menu-grid .card");
+          const matchedItems = [];
+
+          cards.forEach(function (card) {
+            const title = card.querySelector("h3").textContent;
+            const text = card.textContent.toLowerCase();
+            const cardCategory = card.getAttribute("data-category") || "";
+            const cardDietary = card.getAttribute("data-dietary") || "";
+
+            const matchesQuery = !query || text.includes(query);
+            const matchesCategory = category === "all" || cardCategory === category;
+            const matchesDietary = dietary === "any" || cardDietary.includes(dietary);
+
+            if (matchesQuery && matchesCategory && matchesDietary) {
+              card.style.display = "";
+              matchedItems.push(DRINK_CATALOG[title] || { name: title });
+            } else {
+              card.style.display = "none";
+            }
+          });
+
+          const summary = matchedItems.length > 0
+            ? "Found " + matchedItems.length + " menu item(s): " + matchedItems.map(function (i) { return i.name; }).join(", ") + "."
+            : "No menu items matched your filter criteria.";
+          showBanner("menu-search-status", summary);
+
+          replyToAgentIfInvoked(event, {
+            status: "success",
+            tool: "search_menu",
+            filters: { query: query, category: category, dietary: dietary },
+            count: matchedItems.length,
+            items: matchedItems,
+            message: summary
+          });
+        });
+      }
+
+      // 2. Quick Drink Details Forms on Cards
+      const detailForms = document.querySelectorAll(".quick-detail-form");
+      detailForms.forEach(function (form) {
+        form.addEventListener("submit", function (event) {
+          event.preventDefault();
+          const formData = new FormData(form);
+          const drinkName = (formData.get("drink") || "").toString();
+          const details = DRINK_CATALOG[drinkName] || {
+            name: drinkName,
+            description: "Artisanal coffee crafted to order."
+          };
+
+          const message = details.name + " ($" + (details.price ? details.price.toFixed(2) : "4.50") + "): " +
+            details.description + " [" + (details.calories || 0) + " cal, " + (details.caffeineMg || 0) + "mg caffeine]";
+          showBanner("drink-details-panel", message);
+
+          replyToAgentIfInvoked(event, {
+            status: "success",
+            drink: details,
+            message: message
+          });
+        });
+      });
+
+      // 3. Place Coffee Order Form
+      const orderForm = document.getElementById("order-form");
+      if (orderForm) {
+        orderForm.addEventListener("submit", function (event) {
+          event.preventDefault();
+          const formData = new FormData(orderForm);
+          const drink = (formData.get("drink") || "Maple Oat Latte").toString();
+          const size = (formData.get("size") || "Medium").toString();
+          const milk = (formData.get("milk") || "Oat Milk").toString();
+          const temperature = (formData.get("temperature") || "Hot").toString();
+          const quantity = Math.max(1, parseInt(formData.get("quantity") || "1", 10) || 1);
+          const location = (formData.get("location") || "Downtown Roastery").toString();
+          const customerName = (formData.get("customerName") || "Guest").toString().trim();
+          const specialInstructions = (formData.get("specialInstructions") || "").toString().trim();
+
+          const basePrice = (DRINK_CATALOG[drink] && DRINK_CATALOG[drink].price) || 4.75;
+          const sizeAdjustment = size === "Large" ? 0.75 : (size === "Small" ? -0.50 : 0);
+          const unitPrice = basePrice + sizeAdjustment;
+          const totalPrice = +(unitPrice * quantity).toFixed(2);
+          const orderId = "DG-" + Math.floor(100000 + Math.random() * 900000);
+
+          const summary = "Order " + orderId + " confirmed for " + customerName + ": " +
+            quantity + "x " + size + " " + temperature + " " + drink + " (" + milk + ") for pickup at " +
+            location + ". Total: $" + totalPrice.toFixed(2) + ".";
+          showBanner("order-status", summary);
+
+          replyToAgentIfInvoked(event, {
+            status: "success",
+            tool: "place_coffee_order",
+            orderId: orderId,
+            order: {
+              drink: drink,
+              size: size,
+              milk: milk,
+              temperature: temperature,
+              quantity: quantity,
+              location: location,
+              customerName: customerName,
+              specialInstructions: specialInstructions,
+              totalPrice: totalPrice
+            },
+            message: summary
+          });
+        });
+      }
+
+      // 4. Find Cafe Locations Form
+      const locationsForm = document.getElementById("locations-form");
+      if (locationsForm) {
+        locationsForm.addEventListener("submit", function (event) {
+          event.preventDefault();
+          const formData = new FormData(locationsForm);
+          const query = (formData.get("locationQuery") || "").toString().trim().toLowerCase();
+          const amenity = (formData.get("amenity") || "all").toString();
+
+          const matches = CAFE_LOCATIONS.filter(function (loc) {
+            const matchesAmenity = amenity === "all" || loc.amenities.includes(amenity);
+            const matchesText = !query ||
+              loc.name.toLowerCase().includes(query) ||
+              loc.address.toLowerCase().includes(query) ||
+              query === "burlington" ||
+              query === "vt" ||
+              query === "nearby" ||
+              query === "all";
+            return matchesAmenity && matchesText;
+          });
+
+          const results = matches.length > 0 ? matches : CAFE_LOCATIONS;
+          const summary = "Available locations (" + results.length + "): " +
+            results.map(function (l) { return l.name + " at " + l.address + " (" + l.hours + ")"; }).join("; ");
+          showBanner("locations-status", summary);
+
+          replyToAgentIfInvoked(event, {
+            status: "success",
+            tool: "find_cafe_locations",
+            locations: results,
+            message: summary
+          });
+        });
+      }
+
+      // 5. Daily Grind Rewards Form
+      const rewardsForm = document.getElementById("rewards-form");
+      if (rewardsForm) {
+        rewardsForm.addEventListener("submit", function (event) {
+          event.preventDefault();
+          const formData = new FormData(rewardsForm);
+          const memberEmail = (formData.get("memberEmail") || "").toString().trim();
+          const rewardAction = (formData.get("rewardAction") || "check_balance").toString();
+
+          const currentPoints = 240;
+          let remainingPoints = currentPoints;
+          let summary = "";
+
+          if (rewardAction === "check_balance") {
+            summary = "Rewards member " + memberEmail + " currently has " + currentPoints + " points (Gold Bean Tier).";
+          } else if (rewardAction === "redeem_free_drink") {
+            remainingPoints = currentPoints - 100;
+            summary = "Redeemed Free Handcrafted Drink (100 pts) for " + memberEmail + ". Remaining balance: " + remainingPoints + " pts.";
+          } else if (rewardAction === "redeem_pastry") {
+            remainingPoints = currentPoints - 50;
+            summary = "Redeemed Artisanal Pastry (50 pts) for " + memberEmail + ". Remaining balance: " + remainingPoints + " pts.";
+          } else if (rewardAction === "redeem_beans") {
+            remainingPoints = currentPoints - 200;
+            summary = "Redeemed Whole Bean Coffee Bag (200 pts) for " + memberEmail + ". Remaining balance: " + remainingPoints + " pts.";
+          }
+
+          showBanner("rewards-status", summary);
+
+          replyToAgentIfInvoked(event, {
+            status: "success",
+            tool: "manage_rewards",
+            memberEmail: memberEmail,
+            action: rewardAction,
+            pointsBalance: remainingPoints,
+            message: summary
+          });
+        });
+      }
+
+      // 6. My Account Preferences Form
+      const accountForm = document.getElementById("account-form");
+      if (accountForm) {
+        accountForm.addEventListener("submit", function (event) {
+          event.preventDefault();
+          const formData = new FormData(accountForm);
+          const fullName = (formData.get("fullName") || "").toString().trim();
+          const email = (formData.get("email") || "").toString().trim();
+          const defaultMilk = (formData.get("defaultMilk") || "Oat Milk").toString();
+
+          const summary = "Updated account settings for " + fullName + " (" + email + "). Default milk set to " + defaultMilk + ".";
+          showBanner("account-status", summary);
+
+          replyToAgentIfInvoked(event, {
+            status: "success",
+            tool: "update_account_preferences",
+            profile: {
+              fullName: fullName,
+              email: email,
+              defaultMilk: defaultMilk
+            },
+            message: summary
+          });
+        });
+      }
+
+      // 7. Contact Us & Inquiries Form
+      const contactForm = document.getElementById("contact-form");
+      if (contactForm) {
+        contactForm.addEventListener("submit", function (event) {
+          event.preventDefault();
+          const formData = new FormData(contactForm);
+          const senderName = (formData.get("senderName") || "").toString().trim();
+          const senderEmail = (formData.get("senderEmail") || "").toString().trim();
+          const topic = (formData.get("topic") || "General Feedback").toString();
+          const message = (formData.get("message") || "").toString().trim();
+
+          const summary = "Thank you, " + senderName + "! Your inquiry regarding '" + topic + "' has been received. We will reply to " + senderEmail + " shortly.";
+          showBanner("contact-status", summary);
+
+          replyToAgentIfInvoked(event, {
+            status: "success",
+            tool: "submit_contact_inquiry",
+            inquiry: {
+              senderName: senderName,
+              senderEmail: senderEmail,
+              topic: topic,
+              message: message
+            },
+            message: summary
+          });
+        });
+      }
+
+      // 8. Logout Form
+      const logoutForm = document.getElementById("logout-form");
+      if (logoutForm) {
+        logoutForm.addEventListener("submit", function (event) {
+          event.preventDefault();
+          const summary = "You have been logged out of your Daily Grind account.";
+          showBanner("global-status", summary);
+
+          replyToAgentIfInvoked(event, {
+            status: "success",
+            tool: "logout_user",
+            loggedOut: true,
+            message: summary
+          });
+        });
+      }
+
+      // Listen for WebMCP lifecycle events when supported by the browser
+      const modelCtx = document.modelContext || navigator.modelContext;
+      if (modelCtx && typeof modelCtx.addEventListener === "function") {
+        modelCtx.addEventListener("toolactivated", function (event) {
+          showBanner("global-status", "AI Agent activated tool: " + event.toolName);
+        });
+        modelCtx.addEventListener("toolcancel", function (event) {
+          showBanner("global-status", "AI Agent cancelled tool: " + event.toolName);
+        });
+      }
+    })();
