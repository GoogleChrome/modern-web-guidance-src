+          price: 5.75,
+          calories: 190,
+          caffeineMg: 150,
+          description: "Creamy steamed oat milk paired with our signature double espresso and pure Vermont Grade-A maple syrup.",
+          dietary: ["Dairy-Free", "Vegan", "Decaf Available"]
+        },
+        "Dark Roast Espresso": {
+          name: "Dark Roast Espresso",
+          category: "espresso",
+          price: 3.50,
+          calories: 10,
+          caffeineMg: 185,
+          description: "Bold, smokey single-origin dark roast pulled as a rich double shot with velvety crema.",
+          dietary: ["Dairy-Free", "Unsweetened", "Decaf Available"]
+        },
+        "Cold Brew": {
+          name: "Cold Brew",
+          category: "cold-brew",
+          price: 4.75,
+          calories: 15,
+          caffeineMg: 210,
+          description: "Coarse-ground artisanal beans steeped in cold filtered water for 18 hours for maximum smoothness and low acidity.",
+          dietary: ["Dairy-Free", "Unsweetened"]
+        },
+        "Artisanal Pour Over": {
+          name: "Artisanal Pour Over",
+          category: "espresso",
+          price: 4.50,
+          calories: 5,
+          caffeineMg: 160,
+          description: "Hand-poured single-origin light roast highlighting bright citrus and floral notes.",
+          dietary: ["Dairy-Free", "Unsweetened"]
+        },
+        "Cappuccino": {
+          name: "Cappuccino",
+          category: "espresso",
+          price: 4.75,
+          calories: 120,
