+  <script>
+    const drawer = document.getElementById('drawer-menu');
+    const drawerPanel = document.getElementById('drawer-panel');
+    const drawerDismiss = document.getElementById('drawer-dismiss');
+    const menuButton = document.getElementById('menu-button');
+
+    function closeDrawer() {
+      if (drawer.matches(':popover-open')) {
+        drawer.hidePopover();
+      }
+    }
+
+    // Sync ARIA state and reset scroll-snap position when the popover toggles
+    drawer.addEventListener('toggle', (event) => {
+      const isOpen = event.newState === 'open';
+      menuButton.setAttribute('aria-expanded', String(isOpen));
+      if (isOpen) {
+        drawer.scrollLeft = 0;
+        drawerPanel.style.transform = '';
+        drawerPanel.style.transition = '';
+      }
+    });
+
+    // Close the popover when native scroll-snap finishes swiping to the dismiss target
+    drawer.addEventListener('scrollend', () => {
+      if (drawer.scrollLeft >= drawer.clientWidth * 0.5) {
+        closeDrawer();
+      }
+    });
+
+    // Clicking the dismiss snap spacer or a nav link closes the drawer
+    drawerDismiss.addEventListener('click', closeDrawer);
+    drawerPanel.querySelectorAll('a').forEach((link) => {
+      link.addEventListener('click', closeDrawer);
+    });
+
+    // Fallback touch / pointer swipe handling for environments that dispatch raw touch/pointer events
+    let startX = null;
+    let startY = null;
+    let currentDeltaX = 0;
+    let isDragging = false;
+
+    function handleStart(clientX, clientY) {
+      if (!drawer.matches(':popover-open')) return;
+      startX = clientX;
+      startY = clientY;
+      currentDeltaX = 0;
+      isDragging = true;
+    }
+
+    function handleMove(clientX, clientY) {
+      if (!isDragging || startX === null || startY === null) return;
+      // If native scroll-snap is already handling the swipe, yield to native scrolling
+      if (drawer.scrollLeft > 0) {
+        drawerPanel.style.transform = '';
+        return;
+      }
+      const deltaX = clientX - startX;
+      const deltaY = clientY - startY;
+      if (Math.abs(deltaX) > Math.abs(deltaY) && deltaX < 0) {
+        currentDeltaX = deltaX;
+        drawerPanel.style.transition = 'none';
+        drawerPanel.style.transform = `translateX(${deltaX}px)`;
+      }
+    }
+
+    function handleEnd() {
+      if (!isDragging) return;
+      isDragging = false;
+      startX = null;
+      startY = null;
+      drawerPanel.style.transition = '';
+      drawerPanel.style.transform = '';
+
+      if (drawer.scrollLeft === 0 && currentDeltaX < -50) {
+        closeDrawer();
+      }
+      currentDeltaX = 0;
+    }
+
+    drawer.addEventListener('touchstart', (e) => {
+      if (e.touches.length === 1) {
+        handleStart(e.touches[0].clientX, e.touches[0].clientY);
+      }
+    }, { passive: true });
+
+    drawer.addEventListener('touchmove', (e) => {
+      if (e.touches.length === 1) {
+        handleMove(e.touches[0].clientX, e.touches[0].clientY);
+      }
+    }, { passive: true });
+
+    drawer.addEventListener('touchend', handleEnd);
+    drawer.addEventListener('touchcancel', handleEnd);
+
+    drawer.addEventListener('pointerdown', (e) => {
+      if (e.pointerType === 'touch') return;
+      handleStart(e.clientX, e.clientY);
+    });
+
+    drawer.addEventListener('pointermove', (e) => {
+      if (e.pointerType === 'touch') return;
+      handleMove(e.clientX, e.clientY);
+    });
+
+    drawer.addEventListener('pointerup', (e) => {
+      if (e.pointerType === 'touch') return;
+      handleEnd();
+    });
+
+    drawer.addEventListener('pointercancel', (e) => {
+      if (e.pointerType === 'touch') return;
+      handleEnd();
+    });
+  </script>
+
