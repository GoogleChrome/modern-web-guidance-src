+  <script>
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const applySiblingFallback = (container) => {
+        const children = Array.from(container.children);
+        const count = children.length;
+        children.forEach((child, index) => {
+          child.style.setProperty('--sibling-index', index + 1);
+          child.style.setProperty('--sibling-count', count);
+        });
+      };
+
+      const containers = document.querySelectorAll('.grid, .fan-container, .circle-container');
+      const observer = new MutationObserver((mutations) => {
+        const updated = new Set();
+        for (const mutation of mutations) {
+          if (mutation.type === 'childList' && mutation.target instanceof Element) {
+            updated.add(mutation.target);
+          }
+        }
+        updated.forEach(applySiblingFallback);
+      });
+
+      containers.forEach((container) => {
+        applySiblingFallback(container);
+        observer.observe(container, { childList: true });
+      });
+    }
+  </script>
+
