+          resizeObserver.observe(canvas, { box: 'device-pixel-content-box' });
+        } catch (e) {
+          resizeObserver.observe(canvas);
+        }
+      }
+
+      // Update #export_element DOM and schedule a synchronized canvas paint
+      function updateCardContent() {
+        const name = recipientInput.value.trim() || 'Valued Guest';
+        const message = messageInput.value.trim() || 'Enjoy a freshly roasted cup on me!';
+        const amount = amountSelect.value || '$25';
+        const bgColor = bgColorInput.value || '#4e342e';
+
+        recipientDisplay.textContent = name;
+        messageDisplay.textContent = `“${message}”`;
+        amountDisplay.textContent = amount;
+        exportElement.style.setProperty('--card-bg', bgColor);
+        exportElement.style.backgroundColor = bgColor;
+
+        requestCanvasPaint();
+      }
+
+      recipientInput.addEventListener('input', updateCardContent);
+      messageInput.addEventListener('input', updateCardContent);
+      amountSelect.addEventListener('change', updateCardContent);
+
+      bgColorInput.addEventListener('input', () => {
+        swatches.forEach((s) => {
+          s.classList.toggle('active', s.dataset.color.toLowerCase() === bgColorInput.value.toLowerCase());
+        });
+        updateCardContent();
+      });
+
+      swatches.forEach((swatch) => {
+        swatch.addEventListener('click', () => {
+          const color = swatch.dataset.color;
+          bgColorInput.value = color;
+          swatches.forEach((s) => s.classList.remove('active'));
+          swatch.classList.add('active');
+          updateCardContent();
+        });
+      });
+
+      // Trigger download of the rendered canvas bitmap
+      function triggerImageDownload() {
+        const filename = 'daily-grind-gift-card.png';
+        if (typeof canvas.toBlob === 'function') {
+          canvas.toBlob((blob) => {
+            if (!blob) return;
+            const url = URL.createObjectURL(blob);
+            const link = document.createElement('a');
+            link.href = url;
+            link.download = filename;
+            document.body.appendChild(link);
+            link.click();
+            document.body.removeChild(link);
+            URL.revokeObjectURL(url);
+          }, 'image/png');
+        } else {
+          const dataUrl = canvas.toDataURL('image/png');
+          const link = document.createElement('a');
+          link.href = dataUrl;
+          link.download = filename;
+          document.body.appendChild(link);
+          link.click();
+          document.body.removeChild(link);
+        }
+      }
+
+      exportBtn.addEventListener('click', () => {
+        // Synchronize export with paint event when HTML-in-Canvas is active
+        if (isHtmlInCanvasSupported && typeof canvas.requestPaint === 'function') {
+          let exported = false;
+          const onExportPaint = () => {
+            if (exported) return;
+            exported = true;
