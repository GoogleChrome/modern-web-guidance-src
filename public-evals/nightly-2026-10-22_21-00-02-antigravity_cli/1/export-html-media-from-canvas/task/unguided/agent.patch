+  <script>
+    (function () {
+      const canvas = document.getElementById('gift-card-canvas');
+      const exportElement = document.getElementById('export_element');
+      const ctx = canvas ? canvas.getContext('2d') : null;
+
+      const recipientInput = document.getElementById('recipient-name-input');
+      const messageInput = document.getElementById('custom-message-input');
+      const amountSelect = document.getElementById('card-amount-select');
+      const bgColorInput = document.getElementById('bg-color-input');
+      const swatches = document.querySelectorAll('.color-swatch');
+      const exportBtn = document.getElementById('export-card-btn');
+      const statusNote = document.getElementById('canvas-status-note');
+
+      const recipientDisplay = document.getElementById('card-recipient-display');
+      const messageDisplay = document.getElementById('card-message-display');
+      const amountDisplay = document.getElementById('card-amount-display');
+
+      if (!canvas || !exportElement || !ctx) return;
+
+      // Feature detection for the HTML-in-Canvas API
+      const supportsDrawElementImage =
+        typeof CanvasRenderingContext2D !== 'undefined' &&
+        'drawElementImage' in CanvasRenderingContext2D.prototype;
+      const supportsDrawableContent =
+        typeof HTMLCanvasElement !== 'undefined' &&
+        ('content' in HTMLCanvasElement.prototype || 'layoutSubtree' in HTMLCanvasElement.prototype);
+      const isHtmlInCanvasSupported = supportsDrawElementImage && supportsDrawableContent;
+
+      // Ensure proper drawable attributes across Chromium versions
+      if (!canvas.hasAttribute('content') && !canvas.hasAttribute('layoutsubtree')) {
+        if ('content' in HTMLCanvasElement.prototype) {
+          canvas.setAttribute('content', 'drawable');
+        } else {
+          canvas.setAttribute('layoutsubtree', '');
+        }
+      }
+      if (!exportElement.hasAttribute('drawable')) {
+        exportElement.setAttribute('drawable', '');
+      }
+
+      if (!isHtmlInCanvasSupported && statusNote) {
+        statusNote.textContent = 'Preview rendered via Canvas 2D fallback (enable chrome://flags/#canvas-draw-element for native HTML-in-Canvas)';
+      }
+
+      // Fallback 2D renderer if native drawElementImage is unavailable
+      function renderFallbackCard() {
+        const w = canvas.width || 600;
+        const h = canvas.height || 360;
+        const scale = w / 600;
+
+        ctx.save();
+        ctx.scale(scale, scale);
+
+        const bgColor = bgColorInput.value || '#4e342e';
+        ctx.fillStyle = bgColor;
+        ctx.beginPath();
+        if (typeof ctx.roundRect === 'function') {
+          ctx.roundRect(0, 0, 600, 360, 16);
+        } else {
+          ctx.rect(0, 0, 600, 360);
+        }
+        ctx.fill();
+
+        const grad = ctx.createRadialGradient(510, 72, 10, 510, 72, 260);
+        grad.addColorStop(0, 'rgba(255, 171, 64, 0.22)');
+        grad.addColorStop(1, 'rgba(255, 171, 64, 0)');
+        ctx.fillStyle = grad;
+        ctx.fillRect(0, 0, 600, 360);
+
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        ctx.moveTo(32, 72);
+        ctx.lineTo(568, 72);
+        ctx.moveTo(32, 305);
+        ctx.lineTo(568, 305);
+        ctx.stroke();
+
+        ctx.fillStyle = '#ffffff';
+        ctx.font = 'bold 18px "Segoe UI", sans-serif';
+        ctx.fillText('THE DAILY GRIND', 32, 50);
+
+        ctx.fillStyle = '#ffab40';
+        ctx.beginPath();
+        if (typeof ctx.roundRect === 'function') {
+          ctx.roundRect(508, 28, 60, 32, 16);
+        } else {
+          ctx.rect(508, 28, 60, 32);
+        }
+        ctx.fill();
+
+        ctx.fillStyle = '#3e2723';
+        ctx.font = 'bold 16px "Segoe UI", sans-serif';
+        ctx.textAlign = 'center';
+        ctx.fillText(amountSelect.value || '$25', 538, 50);
+
+        ctx.textAlign = 'left';
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
+        ctx.font = '600 13px "Segoe UI", sans-serif';
+        ctx.fillText('A SPECIAL TREAT FOR', 32, 130);
+
+        ctx.fillStyle = '#ffffff';
+        ctx.font = 'bold 28px "Segoe UI", sans-serif';
+        ctx.fillText(recipientInput.value.trim() || 'Valued Guest', 32, 168);
+
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.92)';
+        ctx.font = 'italic 17px "Segoe UI", sans-serif';
+        const msg = '“' + (messageInput.value.trim() || 'Enjoy a cup on me!') + '”';
+        ctx.fillText(msg.slice(0, 65), 32, 210);
+        if (msg.length > 65) {
+          ctx.fillText(msg.slice(65, 130), 32, 234);
+        }
+
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.75)';
+        ctx.font = '12px "Segoe UI", sans-serif';
+        ctx.fillText('ARTISANAL COFFEE GIFT CARD', 32, 330);
+        ctx.textAlign = 'right';
+        ctx.fillText('REDEEMABLE AT ALL LOCATIONS', 568, 330);
+
+        ctx.restore();
+      }
+
+      // Paint event handler synchronizing #export_element into the canvas
+      function handleCanvasPaint() {
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        }
+
+        if (typeof ctx.drawElementImage === 'function') {
+          try {
