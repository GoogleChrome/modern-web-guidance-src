+          requestAnimationFrame(() => {
+            if (!exported) {
+              canvas.removeEventListener('paint', onExportPaint);
+              onExportPaint();
+            }
+          });
+        } else {
+          handleCanvasPaint();
+          triggerImageDownload();
+        }
+      });
+
+      // Request initial paint
+      requestCanvasPaint();
+    })();
