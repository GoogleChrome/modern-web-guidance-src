+  <script>
+    const canvas = document.getElementById('gift-card-canvas');
+    const ctx = canvas.getContext('2d');
+    const exportElement = document.getElementById('export_element');
+    const cardInlineInput = document.getElementById('card-inline-input');
+    const cardMessageControl = document.getElementById('card-message-control');
+    const cardBgColorInput = document.getElementById('card-bg-color');
+    const colorSwatches = document.querySelectorAll('.color-swatch');
+    const exportBtn = document.getElementById('export-card-btn');
+    const fallbackWarning = document.getElementById('canvas-fallback-warning');
+
+    const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+    function renderFallbackCard() {
+      const dpr = window.devicePixelRatio || 1;
+      const width = canvas.width / dpr || 440;
+      const height = canvas.height / dpr || 260;
+
+      ctx.save();
+      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      ctx.clearRect(0, 0, width, height);
+
+      // Card background
+      ctx.fillStyle = cardBgColorInput.value || '#4e342e';
+      ctx.beginPath();
+      ctx.roundRect(0, 0, width, height, 16);
+      ctx.fill();
+
+      // Inner accent border
+      ctx.strokeStyle = 'rgba(255, 171, 64, 0.4)';
+      ctx.lineWidth = 2;
+      ctx.stroke();
+
+      // Header text
+      ctx.fillStyle = '#ffffff';
+      ctx.font = 'bold 16px "Segoe UI", sans-serif';
+      ctx.fillText('THE DAILY GRIND', 28, 46);
+
+      // Value badge
+      ctx.fillStyle = '#ffab40';
+      ctx.font = 'bold 18px "Segoe UI", sans-serif';
+      ctx.textAlign = 'right';
+      ctx.fillText('$25', width - 28, 46);
+
+      // Label
+      ctx.textAlign = 'left';
+      ctx.fillStyle = 'rgba(255, 255, 255, 0.75)';
+      ctx.font = '11px "Segoe UI", sans-serif';
+      ctx.fillText('PERSONALIZED FOR YOU', 28, 115);
+
+      // Custom message
+      ctx.fillStyle = '#ffffff';
+      ctx.font = 'italic 22px Georgia, serif';
+      const message = cardInlineInput.value || 'Enjoy a warm cup on me!';
+      ctx.fillText(message, 28, 152, width - 56);
+
+      // Footer divider & text
+      ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
+      ctx.lineWidth = 1;
+      ctx.beginPath();
+      ctx.moveTo(28, height - 48);
+      ctx.lineTo(width - 28, height - 48);
+      ctx.stroke();
+
+      ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
+      ctx.font = '12px "Segoe UI", sans-serif';
+      ctx.fillText('ARTISANAL COFFEE GIFT CARD', 28, height - 24);
+
+      ctx.fillStyle = '#ffab40';
+      ctx.font = 'bold 12px "Segoe UI", sans-serif';
+      ctx.textAlign = 'right';
+      ctx.fillText('TDG • 2026', width - 28, height - 24);
+
+      ctx.restore();
+    }
+
+    function requestCardRepaint() {
+      if (supportsHtmlInCanvas && typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      } else if (!supportsHtmlInCanvas) {
+        renderFallbackCard();
+      }
+    }
+
+    // 1. Feature detection for HTML-in-Canvas API
+    if (supportsHtmlInCanvas) {
+      // Render the drawable #export_element inside the canvas onpaint handler.
+      // In 2D context, drawElementImage automatically syncs DOM geometry and hit-test bounds.
+      canvas.onpaint = () => {
+        ctx.reset();
+        ctx.drawElementImage(exportElement, 0, 0);
+      };
+    } else {
+      // Fallback when HTML-in-Canvas is not supported in the current browser
+      fallbackWarning.hidden = false;
+      renderFallbackCard();
+    }
+
+    // 2. Scale canvas backing store to device pixels using ResizeObserver (initialized outside onpaint)
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+      requestCardRepaint();
+    });
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== 'undefined' &&
+      'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+    const options = supportsDevicePixelContentBox
+      ? { box: 'device-pixel-content-box' }
+      : {};
+    observer.observe(canvas, options);
+
+    // 3. Synchronize custom message / name inputs and trigger paint update
+    function updateMessage(newText) {
+      if (cardInlineInput.value !== newText) {
+        cardInlineInput.value = newText;
+      }
+      if (cardMessageControl.value !== newText) {
+        cardMessageControl.value = newText;
+      }
+      requestCardRepaint();
+    }
+
+    cardInlineInput.addEventListener('input', (event) => {
+      updateMessage(event.target.value);
+    });
+
+    cardMessageControl.addEventListener('input', (event) => {
+      updateMessage(event.target.value);
+    });
+
+    // 4. Synchronize background color picker and preset swatches
+    function updateBackgroundColor(color) {
+      exportElement.style.backgroundColor = color;
+      cardBgColorInput.value = color;
+      colorSwatches.forEach((swatch) => {
+        swatch.classList.toggle('active', swatch.dataset.color.toLowerCase() === color.toLowerCase());
+      });
+      requestCardRepaint();
+    }
+
+    cardBgColorInput.addEventListener('input', (event) => {
+      updateBackgroundColor(event.target.value);
+    });
+
+    colorSwatches.forEach((swatch) => {
+      swatch.addEventListener('click', () => {
+        updateBackgroundColor(swatch.dataset.color);
+      });
+    });
+
+    // 5. Export the canvas content as a PNG image file
+    exportBtn.addEventListener('click', () => {
+      const dataURL = canvas.toDataURL('image/png');
+      const link = document.createElement('a');
+      link.download = 'daily-grind-gift-card.png';
+      link.href = dataURL;
+      link.click();
+    });
+  </script>
