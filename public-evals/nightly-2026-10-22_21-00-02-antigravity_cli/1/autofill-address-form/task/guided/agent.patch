+  <script>
+    const shippingForm = document.getElementById('shipping-address-form');
+    const submitBtn = document.getElementById('shipping-submit-btn');
+    const statusBox = document.getElementById('shipping-form-status');
+
+    if (shippingForm) {
+      shippingForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (!shippingForm.checkValidity()) {
+          shippingForm.reportValidity();
+          return;
+        }
+        submitBtn.disabled = true;
+        statusBox.textContent = 'Shipping address saved! Proceeding to payment...';
+        statusBox.classList.add('success');
+        statusBox.hidden = false;
+      });
+
+      shippingForm.addEventListener('input', () => {
+        if (submitBtn.disabled) {
+          submitBtn.disabled = false;
+          statusBox.hidden = true;
+        }
+      });
+    }
+  </script>
