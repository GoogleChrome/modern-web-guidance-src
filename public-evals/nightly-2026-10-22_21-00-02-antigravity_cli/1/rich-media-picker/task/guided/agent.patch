+  <script>
+    document.addEventListener("DOMContentLoaded", () => {
+      const roastSelect = document.getElementById("roast-picker");
+      if (!roastSelect) return;
+
+      // Check if browser supports base-select value
+      if (!CSS.supports("appearance", "base-select")) {
+        roastSelect.querySelectorAll("option").forEach((option) => {
+          const title = option.querySelector(".option-title")?.textContent?.trim();
+          const desc = option.querySelector(".option-desc")?.textContent?.trim();
+          if (title && desc) {
+            option.textContent = `${title} — ${desc}`;
+          }
+        });
+      }
+    });
+  </script>
