+  <script>
+    (function () {
+      function hydrateMediaElement(mediaEl) {
+        if (!mediaEl || mediaEl.dataset.loaded === 'true') return;
+        mediaEl.dataset.loaded = 'true';
+
+        if (mediaEl.dataset.poster) {
+          mediaEl.setAttribute('poster', mediaEl.dataset.poster);
+          mediaEl.removeAttribute('data-poster');
+        }
+
+        var sources = mediaEl.querySelectorAll('source[data-src]');
+        sources.forEach(function (sourceEl) {
+          sourceEl.setAttribute('src', sourceEl.dataset.src);
+          sourceEl.removeAttribute('data-src');
+        });
+
+        if (mediaEl.dataset.src) {
+          mediaEl.setAttribute('src', mediaEl.dataset.src);
+          mediaEl.removeAttribute('data-src');
+        }
+
+        if (mediaEl.dataset.preload) {
+          mediaEl.setAttribute('preload', mediaEl.dataset.preload);
+        }
+
+        if (typeof mediaEl.load === 'function') {
+          mediaEl.load();
+        }
+
+        if (mediaEl.id === 'roasting-video') {
+          var vStatus = document.getElementById('roasting-video-status');
+          if (vStatus) vStatus.textContent = 'Roasting video ready to play.';
+        } else if (mediaEl.id === 'podcast-audio') {
+          var aStatus = document.getElementById('podcast-audio-status');
+          if (aStatus) aStatus.textContent = 'Episode audio ready to play.';
+        }
+      }
+
+      function hydrateImageElement(imgEl) {
+        if (!imgEl || imgEl.dataset.loaded === 'true') return;
+        imgEl.dataset.loaded = 'true';
+        if (imgEl.dataset.src) {
+          imgEl.setAttribute('src', imgEl.dataset.src);
+          imgEl.removeAttribute('data-src');
+        }
+      }
+
+      var lazyMediaElements = document.querySelectorAll('.lazy-media');
+      var lazyImages = document.querySelectorAll('.lazy-poster');
+
+      if ('IntersectionObserver' in window) {
+        var mediaObserver = new IntersectionObserver(
+          function (entries, observer) {
+            entries.forEach(function (entry) {
+              if (entry.isIntersecting) {
+                var target = entry.target;
+                if (target.classList.contains('lazy-media')) {
+                  hydrateMediaElement(target);
+                } else if (target.classList.contains('lazy-poster')) {
+                  hydrateImageElement(target);
+                }
+                observer.unobserve(target);
+              }
+            });
+          },
+          {
+            rootMargin: '200px 0px',
+            threshold: 0.01
+          }
+        );
+
+        lazyMediaElements.forEach(function (el) {
+          mediaObserver.observe(el);
+        });
+
+        lazyImages.forEach(function (img) {
+          mediaObserver.observe(img);
+        });
+      } else {
+        lazyMediaElements.forEach(hydrateMediaElement);
+        lazyImages.forEach(hydrateImageElement);
+      }
+
+      // Also hydrate immediately if user interacts directly before observer triggers
+      lazyMediaElements.forEach(function (el) {
+        ['play', 'pointerdown', 'focus'].forEach(function (evt) {
+          el.addEventListener(evt, function () {
+            hydrateMediaElement(el);
+          }, { once: true });
+        });
+      });
+    })();
+  </script>
