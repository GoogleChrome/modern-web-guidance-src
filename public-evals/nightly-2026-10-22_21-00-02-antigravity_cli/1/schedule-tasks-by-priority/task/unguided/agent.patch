+  <script>
+    (function () {
+      const TASK_CONFIGS = {
+        urgent: {
+          type: 'urgent',
+          title: 'Urgent Checkout Task',
+          shortLabel: 'Urgent Checkout',
+          priority: 'user-blocking',
+          badgeClass: 'ops-badge-urgent',
+          chunks: 3,
+          chunkMs: 8,
+          description: 'Processing payment authorization & cart lock'
+        },
+        standard: {
+          type: 'standard',
+          title: 'Standard Menu Update',
+          shortLabel: 'Standard Menu',
+          priority: 'user-visible',
+          badgeClass: 'ops-badge-standard',
+          chunks: 3,
+          chunkMs: 8,
+          description: 'Syncing seasonal roast inventory & pricing'
+        },
+        background: {
+          type: 'background',
+          title: 'Background Telemetry Logging',
+          shortLabel: 'Background Telemetry',
+          priority: 'background',
+          badgeClass: 'ops-badge-background',
+          chunks: 3,
+          chunkMs: 8,
+          description: 'Flushing analytics metrics & session traces'
+        }
+      };
+
+      const PRIORITY_WEIGHTS = {
+        'user-blocking': 1,
+        'user-visible': 2,
+        'background': 3
+      };
+
+      const taskListEl = document.getElementById('ops-task-list');
+      const emptyStateEl = document.getElementById('ops-empty-state');
+      const statQueuedEl = document.getElementById('stat-queued');
+      const statCompletedEl = document.getElementById('stat-completed');
+      const statYieldsEl = document.getElementById('stat-yields');
+      const statOrderEl = document.getElementById('stat-order');
+      const uiStatusTextEl = document.getElementById('ui-status-text');
+
+      let queuedCount = 0;
+      let activeCount = 0;
+      let completedCount = 0;
+      let totalYields = 0;
+      let taskCounter = 0;
+      const executionOrder = [];
+
+      // Fallback priority queue when window.scheduler.postTask is unavailable
+      const fallbackQueue = [];
+      let fallbackFlushScheduled = false;
+      let fallbackSeq = 0;
+
+      function updateStats() {
+        statQueuedEl.textContent = String(queuedCount);
+        statCompletedEl.textContent = String(completedCount);
+        statYieldsEl.textContent = String(totalYields);
+        statOrderEl.textContent = executionOrder.length > 0 ? executionOrder.join(' → ') : 'None';
+
+        if (activeCount > 0 || queuedCount > 0) {
+          uiStatusTextEl.textContent = `UI Responsive (Yielding Active • ${queuedCount} queued)`;
+        } else {
+          uiStatusTextEl.textContent = 'UI Responsive (Main Thread Yielding Ready)';
+        }
+      }
+
+      function yieldToMain(priority = 'user-visible') {
+        if (typeof window.scheduler !== 'undefined' && typeof window.scheduler.yield === 'function') {
+          return window.scheduler.yield();
+        }
+        if (typeof window.scheduler !== 'undefined' && typeof window.scheduler.postTask === 'function') {
+          return window.scheduler.postTask(() => {}, { priority });
+        }
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      function flushFallbackQueue() {
+        fallbackFlushScheduled = false;
+        fallbackQueue.sort((a, b) => {
+          const weightDiff = (PRIORITY_WEIGHTS[a.priority] || 2) - (PRIORITY_WEIGHTS[b.priority] || 2);
+          return weightDiff !== 0 ? weightDiff : a.seq - b.seq;
+        });
+        const next = fallbackQueue.shift();
+        if (!next) return;
+        Promise.resolve()
+          .then(() => next.callback())
+          .then(next.resolve, next.reject)
+          .finally(() => {
+            if (fallbackQueue.length > 0 && !fallbackFlushScheduled) {
+              fallbackFlushScheduled = true;
+              setTimeout(flushFallbackQueue, 0);
+            }
+          });
+      }
+
+      function schedulePrioritizedTask(callback, priority = 'user-visible') {
+        if (typeof window.scheduler !== 'undefined' && typeof window.scheduler.postTask === 'function') {
+          return window.scheduler.postTask(callback, { priority });
+        }
+        return new Promise((resolve, reject) => {
+          fallbackQueue.push({
+            callback,
+            priority,
+            resolve,
+            reject,
+            seq: ++fallbackSeq
+          });
+          if (!fallbackFlushScheduled) {
+            fallbackFlushScheduled = true;
+            setTimeout(flushFallbackQueue, 0);
+          }
+        });
+      }
+
+      function simulateChunkWork(durationMs) {
+        const start = performance.now();
+        while (performance.now() - start < durationMs) {
+          // Bounded sub-16ms work slice; yields between chunks to keep UI responsive
+        }
+      }
+
+      function createTaskElement(taskId, config) {
+        if (emptyStateEl) {
+          emptyStateEl.style.display = 'none';
+        }
+        const li = document.createElement('li');
+        li.className = 'ops-task-item';
+        li.id = `ops-task-${taskId}`;
+        li.setAttribute('data-task-id', String(taskId));
+        li.setAttribute('data-task-type', config.type);
+        li.setAttribute('data-priority', config.priority);
+        li.setAttribute('data-status', 'running');
+
+        li.innerHTML = `
+          <div class="ops-task-top">
+            <div class="ops-task-title">
+              <span class="ops-task-name">${config.title}</span>
+              <span class="ops-badge ${config.badgeClass}">${config.priority}</span>
+            </div>
+            <span class="ops-task-status">Running...</span>
+          </div>
+          <div class="ops-task-meta">
+            <span class="ops-task-desc">${config.description}</span>
+            <span class="ops-task-progress-label">0 / ${config.chunks} chunks</span>
+          </div>
+          <div class="ops-progress-track">
+            <div class="ops-progress-fill" style="width: 0%;"></div>
+          </div>
+        `;
+
+        taskListEl.appendChild(li);
+        return li;
+      }
+
+      function enqueueTask(taskType) {
+        const config = TASK_CONFIGS[taskType];
+        if (!config) return Promise.resolve();
+
+        const taskId = ++taskCounter;
+        queuedCount++;
+        updateStats();
+
+        return schedulePrioritizedTask(async () => {
+          activeCount++;
+          updateStats();
+
+          const startTime = performance.now();
+          const taskEl = createTaskElement(taskId, config);
+          const statusEl = taskEl.querySelector('.ops-task-status');
+          const progressLabelEl = taskEl.querySelector('.ops-task-progress-label');
+          const progressFillEl = taskEl.querySelector('.ops-progress-fill');
+
+          for (let i = 1; i <= config.chunks; i++) {
+            simulateChunkWork(config.chunkMs);
+            const pct = Math.round((i / config.chunks) * 100);
+            progressLabelEl.textContent = `${i} / ${config.chunks} chunks (${pct}%)`;
+            progressFillEl.style.width = `${pct}%`;
+
+            if (i < config.chunks) {
+              totalYields++;
+              updateStats();
+              await yieldToMain(config.priority);
+            }
+          }
+
+          const elapsedMs = Math.max(1, Math.round(performance.now() - startTime));
+          taskEl.setAttribute('data-status', 'completed');
+          statusEl.textContent = `Completed (${elapsedMs}ms)`;
+
+          // Ensure completed task is ordered before any still-running lower-priority task it preempted
+          const firstRunning = taskListEl.querySelector('.ops-task-item[data-status="running"]');
+          if (firstRunning && firstRunning !== taskEl) {
+            taskListEl.insertBefore(taskEl, firstRunning);
+          }
+
+          activeCount = Math.max(0, activeCount - 1);
+          queuedCount = Math.max(0, queuedCount - 1);
+          completedCount++;
+          executionOrder.push(config.shortLabel);
+          updateStats();
+        }, config.priority);
+      }
+
+      function clearQueueLog() {
+        taskListEl.innerHTML = '';
+        if (emptyStateEl) {
+          emptyStateEl.style.display = 'block';
+        }
+        executionOrder.length = 0;
+        completedCount = 0;
+        totalYields = 0;
+        updateStats();
+      }
+
+      function runMixedBatch() {
+        if (queuedCount === 0 && activeCount === 0) {
+          taskListEl.innerHTML = '';
+          executionOrder.length = 0;
+        }
+        // Enqueue mixed tasks in reverse-priority order (background -> standard -> urgent)
+        // so the prioritized scheduler executes them in priority order (urgent -> standard -> background).
+        enqueueTask('background');
+        enqueueTask('standard');
+        enqueueTask('urgent');
+      }
+
+      document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+        enqueueTask('urgent');
+      });
+
+      document.getElementById('btn-standard-menu').addEventListener('click', () => {
+        enqueueTask('standard');
+      });
+
+      document.getElementById('btn-background-telemetry').addEventListener('click', () => {
+        enqueueTask('background');
+      });
+
+      document.getElementById('btn-batch-mixed').addEventListener('click', () => {
+        runMixedBatch();
+      });
+
+      document.getElementById('btn-clear-queue').addEventListener('click', () => {
+        clearQueueLog();
+      });
+    })();
+  </script>
 </body>
 
