+  <script>
+    (function () {
+      let taskCounter = 0;
+      let activeCount = 0;
+      let completedCount = 0;
+      let yieldCount = 0;
+
+      const statQueuedEl = document.getElementById('stat-queued');
+      const statCompletedEl = document.getElementById('stat-completed');
+      const statYieldsEl = document.getElementById('stat-yields');
+      const statStatusEl = document.getElementById('stat-execution-order');
+      const logListEl = document.getElementById('queue-log-list');
+
+      // Feature detect the Prioritized Task Scheduling API and load polyfill if needed
+      let schedulerReadyPromise;
+      if (!('scheduler' in window && 'postTask' in window.scheduler)) {
+        schedulerReadyPromise = new Promise((resolve) => {
+          const script = document.createElement('script');
+          script.src = 'https://unpkg.com/scheduler-polyfill';
+          script.onload = () => resolve();
+          script.onerror = () => resolve();
+          document.head.appendChild(script);
+        });
+      } else {
+        schedulerReadyPromise = Promise.resolve();
+      }
+
+      // Yield to the main thread using scheduler.yield() with a setTimeout fallback
+      async function yieldToMain() {
+        yieldCount++;
+        statYieldsEl.textContent = String(yieldCount);
+        if ('scheduler' in window && 'yield' in window.scheduler) {
+          return await window.scheduler.yield();
+        }
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      // Break up long synchronous work using a 50ms deadline budget
+      async function runChunkedWork(durationMs, onProgress) {
+        const startTime = performance.now();
+        let elapsed = 0;
+        let deadline = performance.now() + 50; // 50ms budget before yielding
+
+        while (elapsed < durationMs) {
+          // Simulate synchronous CPU computation step
+          const stepStart = performance.now();
+          while (performance.now() - stepStart < 10) {
+            Math.sqrt(Math.random() * 10000);
+          }
+          elapsed = performance.now() - startTime;
+
+          if (onProgress) {
+            const pct = Math.min(100, Math.round((elapsed / durationMs) * 100));
+            onProgress(pct);
+          }
+
+          // MANDATORY: Yield to the main thread periodically when 50ms deadline is exceeded
+          if (performance.now() >= deadline && elapsed < durationMs) {
+            await yieldToMain();
+            deadline = performance.now() + 50;
+          }
+        }
+      }
+
+      function updateStats() {
+        statQueuedEl.textContent = String(activeCount);
+        statCompletedEl.textContent = String(completedCount);
+        statStatusEl.textContent = activeCount > 0 ? 'Processing' : 'Idle';
+      }
+
+      function createLogEntry(taskId, label, priority) {
+        const placeholder = document.getElementById('empty-log-placeholder');
+        if (placeholder) {
+          placeholder.remove();
+        }
+
+        const li = document.createElement('li');
+        li.className = 'log-entry';
+        li.dataset.priority = priority;
+        li.id = `task-log-${taskId}`;
+
+        const meta = document.createElement('div');
+        meta.className = 'log-meta';
+
+        const badge = document.createElement('span');
+        badge.className = `badge-priority badge-${priority}`;
+        badge.textContent = priority;
+
+        const title = document.createElement('span');
+        title.textContent = `#${taskId} ${label}`;
+
+        meta.appendChild(badge);
+        meta.appendChild(title);
+
+        const status = document.createElement('span');
+        status.className = 'log-status';
+        status.textContent = 'Queued...';
+
+        li.appendChild(meta);
+        li.appendChild(status);
+        logListEl.prepend(li);
+
+        return { li, status };
+      }
+
+      async function scheduleOperation({ label, priority, durationMs }) {
+        const taskId = ++taskCounter;
+        activeCount++;
+        updateStats();
+
+        const queuedAt = performance.now();
+        const { li, status } = createLogEntry(taskId, label, priority);
+
+        await schedulerReadyPromise;
+
+        const executeTask = async () => {
+          const startedAt = performance.now();
+          const waitTime = Math.round(startedAt - queuedAt);
+          status.textContent = `Running (waited ${waitTime}ms)...`;
+
+          // Promote running item to top of active view so execution order is clear
+          logListEl.prepend(li);
+
+          await runChunkedWork(durationMs, (pct) => {
+            status.textContent = `Running ${pct}% (waited ${waitTime}ms)`;
+          });
+
+          const totalTime = Math.round(performance.now() - startedAt);
+          status.textContent = `Completed in ${totalTime}ms (waited ${waitTime}ms)`;
+          activeCount = Math.max(0, activeCount - 1);
+          completedCount++;
+          updateStats();
+        };
+
+        if ('scheduler' in window && 'postTask' in window.scheduler) {
+          return window.scheduler.postTask(executeTask, { priority });
+        } else {
+          // Fallback if external polyfill failed to load offline
+          const delay = priority === 'user-blocking' ? 0 : priority === 'user-visible' ? 15 : 40;
+          return new Promise((resolve) => {
+            setTimeout(() => resolve(executeTask()), delay);
+          });
+        }
+      }
+
+      // Button Event Listeners
+      document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+        scheduleOperation({
+          label: 'Urgent Checkout Payment & Cart Validation',
+          priority: 'user-blocking',
+          durationMs: 90
+        });
+      });
+
+      document.getElementById('btn-standard-menu').addEventListener('click', () => {
+        scheduleOperation({
+          label: 'Standard Seasonal Menu & Inventory Sync',
+          priority: 'user-visible',
+          durationMs: 140
+        });
+      });
+
+      document.getElementById('btn-background-telemetry').addEventListener('click', () => {
+        scheduleOperation({
+          label: 'Background Telemetry & Analytics Flush',
+          priority: 'background',
+          durationMs: 180
+        });
+      });
+
+      document.getElementById('btn-batch-mixed').addEventListener('click', () => {
+        // Enqueue in reverse priority order (background -> user-visible -> user-blocking)
+        // so scheduler.postTask demonstrates reordering by priority (urgent runs first!)
+        scheduleOperation({
+          label: 'Batch [1/4]: Background Telemetry Snapshot',
+          priority: 'background',
+          durationMs: 140
+        });
+        scheduleOperation({
+          label: 'Batch [2/4]: Standard Menu Price Refresh',
+          priority: 'user-visible',
+          durationMs: 120
+        });
+        scheduleOperation({
+          label: 'Batch [3/4]: Background Cache Prefetch',
+          priority: 'background',
+          durationMs: 140
+        });
+        scheduleOperation({
+          label: 'Batch [4/4]: Urgent Checkout Order Confirmation',
+          priority: 'user-blocking',
+          durationMs: 90
+        });
+      });
+
+      document.getElementById('btn-clear-queue').addEventListener('click', () => {
+        logListEl.replaceChildren();
+        const li = document.createElement('li');
+        li.className = 'log-entry';
+        li.id = 'empty-log-placeholder';
+        const meta = document.createElement('span');
+        meta.className = 'log-meta';
+        meta.textContent = 'Queue log cleared. Trigger an operation above.';
+        const status = document.createElement('span');
+        status.className = 'log-status';
+        status.textContent = '--';
+        li.appendChild(meta);
+        li.appendChild(status);
+        logListEl.appendChild(li);
+      });
+    })();
+  </script>
 </body>
 
