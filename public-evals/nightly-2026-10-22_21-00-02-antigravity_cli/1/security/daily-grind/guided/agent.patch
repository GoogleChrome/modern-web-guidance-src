+  <script>
+    if (!window.trustedTypes) {
+      window.trustedTypes = {
+        createPolicy: (name, rules) => rules,
+      };
+    }
+
+    const htmlPolicy = window.trustedTypes.createPolicy('app-html', {
+      createHTML(input) {
+        return String(input)
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;')
+          .replace(/"/g, '&quot;')
+          .replace(/'/g, '&#39;');
+      },
+    });
+
+    function safeSetText(element, text) {
+      if (!element) return;
+      element.textContent = String(text);
+    }
+
+    function safeSetHTML(element, html) {
+      if (!element) return;
+      if ('setHTML' in Element.prototype) {
+        element.setHTML(String(html));
+      } else {
+        element.innerHTML = htmlPolicy.createHTML(html);
+      }
+    }
+
+    function isTrustedSameOrigin(event) {
+      try {
+        if ('Origin' in globalThis) {
+          let senderOrigin;
+          try {
+            senderOrigin = Origin.from(event);
+          } catch {
+            senderOrigin = Origin.from(event.origin);
+          }
+          return senderOrigin.isSameOrigin(Origin.from(self));
+        }
+        return event.origin !== 'null' && event.origin === window.location.origin;
+      } catch {
+        return false;
+      }
+    }
+
+    window.addEventListener('message', (event) => {
+      if (!isTrustedSameOrigin(event)) return;
+      const data = event.data;
+      if (data && typeof data === 'object' && data.action === 'update-status' && typeof data.message === 'string') {
+        const target = document.getElementById('status-banner');
+        safeSetText(target, data.message);
+      }
+    });
+  </script>
+
 </body>
 
