+(function () {
+  'use strict';
+
+  // Trusted Types default policy to safely handle DOM sinks
+  if (window.trustedTypes && window.trustedTypes.createPolicy) {
+    try {
+      if (!window.trustedTypes.defaultPolicy) {
+        window.trustedTypes.createPolicy('default', {
+          createHTML: (input) => {
+            const div = document.createElement('div');
+            div.textContent = String(input);
+            return div.innerHTML;
+          },
+          createScriptURL: (input) => {
+            const url = new URL(input, window.location.origin);
+            if (url.origin === window.location.origin) {
+              return url.href;
+            }
+            throw new TypeError('Untrusted script URL blocked by policy');
+          },
+          createScript: () => {
+            throw new TypeError('Dynamic script evaluation is blocked by policy');
+          },
+        });
+      }
+    } catch (_) {
+      // Policy already registered
+    }
+  }
+
+  document.addEventListener('DOMContentLoaded', () => {
+    // Harden external links against tabnabbing and referrer leakage
+    const links = document.querySelectorAll('a[href]');
+    links.forEach((link) => {
+      try {
+        const url = new URL(link.href, window.location.origin);
+        if (url.origin !== window.location.origin) {
+          const existingRel = (link.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
+          if (!existingRel.includes('noopener')) existingRel.push('noopener');
+          if (!existingRel.includes('noreferrer')) existingRel.push('noreferrer');
+          link.setAttribute('rel', existingRel.join(' '));
+        }
+      } catch (_) {
+        // Ignore invalid URLs
+      }
+    });
+
+    // Ensure state-changing logout action uses POST with CSRF/Same-Origin intent header
+    const logoutForm = document.getElementById('logout-form');
+    if (logoutForm) {
+      logoutForm.addEventListener('submit', async (event) => {
+        if (!window.fetch) return;
+        event.preventDefault();
+        try {
+          const response = await fetch('/logout', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: {
+              'X-Requested-With': 'XMLHttpRequest',
+            },
+          });
+          if (response.ok) {
+            document.body.textContent = 'Logged out';
+          }
+        } catch (_) {
+          logoutForm.submit();
+        }
+      });
+    }
+  });
+})();
