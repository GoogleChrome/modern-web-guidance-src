     <Footer />
+    <script>
+      import { swapFunctions } from "astro:transitions/client";
+
+      interface CachedView {
+        title: string;
+        wrapper: HTMLDivElement;
+        children: Node[];
+      }
+
+      const viewCache = new Map<string, CachedView>();
+      const getCacheKey = (url: URL) => url.pathname + url.search;
+
+      let cacheContainer: HTMLDivElement | null = null;
+      function getCacheContainer() {
+        if (!cacheContainer || !cacheContainer.isConnected) {
+          cacheContainer = document.createElement("div");
+          cacheContainer.id = "spa-view-cache";
+          cacheContainer.hidden = true;
+          cacheContainer.style.display = "none";
+          cacheContainer.setAttribute("aria-hidden", "true");
+          cacheContainer.setAttribute("data-astro-transition-persist", "spa-view-cache");
+          document.body.appendChild(cacheContainer);
+        }
+        return cacheContainer;
+      }
+
+      function moveChildren(source: Element, target: Element) {
+        const moveBefore = typeof (target as any).moveBefore === "function"
+          ? (node: Node) => (target as any).moveBefore(node, null)
+          : null;
+        const nodes = Array.from(source.childNodes);
+        for (const node of nodes) {
+          if (moveBefore && node.isConnected) {
+            moveBefore(node);
+          } else {
+            target.appendChild(node);
+          }
+        }
+        return nodes;
+      }
+
+      document.addEventListener("astro:before-preparation", (event) => {
+        const toKey = getCacheKey(event.to);
+        if (viewCache.has(toKey) && !event.formData) {
+          event.loader = async () => {};
+        }
+      });
+
+      document.addEventListener("astro:before-swap", (event) => {
+        const fromKey = getCacheKey(event.from);
+        const toKey = getCacheKey(event.to);
+        const currentMain = document.getElementById("spa-main-content") as HTMLElement | null;
+
+        const originalSwap = event.swap;
+        event.swap = () => {
+          const container = getCacheContainer();
+
+          if (currentMain && fromKey !== toKey) {
+            let existing = viewCache.get(fromKey);
+            if (!existing) {
+              const wrapper = document.createElement("div");
+              wrapper.dataset.cacheKey = fromKey;
+              container.appendChild(wrapper);
+              existing = {
+                title: document.title,
+                wrapper,
+                children: [],
+              };
+              viewCache.set(fromKey, existing);
+            } else {
+              existing.title = document.title;
+              if (!existing.wrapper.isConnected) {
+                container.appendChild(existing.wrapper);
+              }
+            }
+            existing.children = moveChildren(currentMain, existing.wrapper);
+          }
+
+          const cached = viewCache.get(toKey);
+          if (cached && currentMain && !event.formData) {
+            document.title = cached.title;
+            moveChildren(cached.wrapper, currentMain);
+          } else {
+            const newMain = event.newDocument.getElementById("spa-main-content");
+            if (currentMain && newMain) {
+              swapFunctions.deselectScripts(event.newDocument);
+              swapFunctions.swapRootAttributes(event.newDocument);
+              swapFunctions.swapHeadElements(event.newDocument);
+              const restoreFocus = swapFunctions.saveFocus();
+              currentMain.replaceChildren(...Array.from(newMain.childNodes));
+              restoreFocus();
+            } else {
+              originalSwap();
+            }
+          }
+        };
+      });
+    </script>
   </body>
 </html>
