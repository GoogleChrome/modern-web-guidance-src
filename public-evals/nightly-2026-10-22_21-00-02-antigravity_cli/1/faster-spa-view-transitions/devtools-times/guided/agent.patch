+    <script>
+      import {
+        swapFunctions,
+        type TransitionBeforePreparationEvent,
+        type TransitionBeforeSwapEvent,
+      } from "astro:transitions/client";
+
+      const MAX_CACHED_VIEWS = 10;
+      const viewCache = new Map<
+        string,
+        {
+          element: HTMLElement;
+          title: string;
+          styles: HTMLStyleElement[];
+        }
+      >();
+
+      function normalizePath(url: URL | Location): string {
+        const path = url.pathname.replace(/\/+$/, "") || "/";
+        return path + url.search;
+      }
+
+      function captureHeadStyles(doc: Document): HTMLStyleElement[] {
+        return Array.from(doc.head.querySelectorAll("style")).map(
+          (style) => style.cloneNode(true) as HTMLStyleElement,
+        );
+      }
+
+      function ensureHeadStyles(styles: HTMLStyleElement[]) {
+        const existingContents = new Set(
+          Array.from(document.head.querySelectorAll("style")).map(
+            (s) => s.textContent,
+          ),
+        );
+        for (const style of styles) {
+          if (style.textContent && !existingContents.has(style.textContent)) {
+            document.head.appendChild(style.cloneNode(true));
+            existingContents.add(style.textContent);
+          }
+        }
+      }
+
+      function touchView(
+        key: string,
+        entry: {
+          element: HTMLElement;
+          title: string;
+          styles: HTMLStyleElement[];
+        },
+      ) {
+        viewCache.delete(key);
+        viewCache.set(key, entry);
+
+        // LRU eviction strategy to prevent memory bloat in dynamic applications
+        while (viewCache.size > MAX_CACHED_VIEWS) {
+          const oldestKey = viewCache.keys().next().value;
+          if (!oldestKey || oldestKey === key) break;
+          const oldestEntry = viewCache.get(oldestKey);
+          if (oldestEntry) {
+            oldestEntry.element.remove();
+          }
+          viewCache.delete(oldestKey);
+        }
+      }
+
+      function initInitialView() {
+        const root = document.getElementById("spa-view-root");
+        if (!root) return;
+        const activeView = root.querySelector<HTMLElement>(
+          ".spa-view:not(.inactive)",
+        );
+        if (activeView) {
+          const key =
+            activeView.dataset.viewPath || normalizePath(window.location);
+          activeView.dataset.viewPath = key;
+          const title = activeView.dataset.viewTitle || document.title;
+          activeView.dataset.viewTitle = title;
+          if (!viewCache.has(key)) {
+            touchView(key, {
+              element: activeView,
+              title,
+              styles: captureHeadStyles(document),
+            });
+          }
+        }
+      }
+
+      function switchToView(
+        root: HTMLElement,
+        targetKey: string,
+        incomingView?: HTMLElement | null,
+        incomingTitle?: string,
+        incomingStyles?: HTMLStyleElement[],
+      ) {
+        // Hide all currently rendered views inside the container
+        root.querySelectorAll<HTMLElement>(".spa-view").forEach((view) => {
+          if (view.dataset.viewPath !== targetKey) {
+            view.classList.add("inactive");
+            view.setAttribute("aria-hidden", "true");
+            view.setAttribute("inert", "");
+          }
+        });
+
+        let cached = viewCache.get(targetKey);
+        let activeView = cached?.element;
+
+        if (activeView && !root.contains(activeView)) {
+          root.appendChild(activeView);
+        }
+
+        if (!activeView && incomingView) {
+          activeView = incomingView;
+          activeView.dataset.viewPath = targetKey;
+          const title =
+            incomingTitle ||
+            activeView.dataset.viewTitle ||
+            document.title;
+          activeView.dataset.viewTitle = title;
+          root.appendChild(activeView);
+          cached = {
+            element: activeView,
+            title,
+            styles: incomingStyles || captureHeadStyles(document),
+          };
+
+          // Ensure media elements and declarative shadow DOM inside the newly inserted view are initialized
+          activeView.querySelectorAll("template[shadowrootmode]").forEach((template) => {
+            const mode = template.getAttribute("shadowrootmode");
+            const parent = template.parentNode;
+            if ((mode === "closed" || mode === "open") && parent instanceof HTMLElement && !parent.shadowRoot) {
+              const shadowRoot = parent.attachShadow({ mode });
+              shadowRoot.appendChild((template as HTMLTemplateElement).content);
+              template.remove();
+            }
+          });
+          activeView.querySelectorAll("video, audio").forEach((media) => {
+            const fresh = document.createElement(media.localName);
+            for (const attr of Array.from(media.attributes)) {
+              fresh.setAttribute(attr.name, attr.value);
+            }
+            fresh.innerHTML = media.innerHTML;
+            if (fresh.hasAttribute("muted") && "muted" in fresh) {
+              (fresh as HTMLMediaElement).muted = true;
+            }
+            media.replaceWith(fresh);
+          });
+        }
+
+        if (activeView && cached) {
+          ensureHeadStyles(cached.styles);
+          activeView.classList.remove("inactive");
+          activeView.setAttribute("aria-hidden", "false");
+          activeView.removeAttribute("inert");
+          if (!activeView.hasAttribute("tabindex")) {
+            activeView.setAttribute("tabindex", "-1");
+          }
+
+          touchView(targetKey, cached);
+          document.title = cached.title;
+
+          // Move focus to the active view to preserve a logical keyboard tab-order
+          activeView.focus({ preventScroll: true });
+        }
+      }
+
+      initInitialView();
+
+      document.addEventListener("astro:before-preparation", ((
+        event: TransitionBeforePreparationEvent,
+      ) => {
+        // Skip caching on POST/form submissions so mutations always fetch fresh state
+        if (event.formData) return;
+
+        const targetKey = normalizePath(event.to);
+        const cached = viewCache.get(targetKey);
+
+        if (cached && document.getElementById("spa-view-root")?.contains(cached.element)) {
+          event.loader = async () => {
+            // Instant transition back to cached view without network fetch or DOM rebuild
+            const cloneDoc = document.cloneNode(true) as Document;
+            cloneDoc.title = cached.title;
+            event.newDocument = cloneDoc;
+          };
+        }
+      }) as EventListener);
+
+      document.addEventListener("astro:before-swap", ((
+        event: TransitionBeforeSwapEvent,
+      ) => {
+        const root = document.getElementById("spa-view-root");
+        const incomingRoot =
+          event.newDocument.getElementById("spa-view-root");
+
+        if (!root || !incomingRoot) return;
+
+        // Ensure current view is registered in the cache before swapping away
+        const currentKey = normalizePath(event.from);
+        const currentActive = root.querySelector<HTMLElement>(
+          `.spa-view[data-view-path="${CSS.escape(currentKey)}"]`,
+        ) || root.querySelector<HTMLElement>(".spa-view:not(.inactive)");
+
+        if (currentActive && !viewCache.has(currentKey)) {
+          currentActive.dataset.viewPath = currentKey;
+          const currentTitle =
+            currentActive.dataset.viewTitle || document.title;
+          touchView(currentKey, {
+            element: currentActive,
+            title: currentTitle,
+            styles: captureHeadStyles(document),
+          });
+        }
+
+        const targetKey = normalizePath(event.to);
+        const incomingView =
+          incomingRoot.querySelector<HTMLElement>(".spa-view");
+        const incomingTitle =
+          event.newDocument.title ||
+          incomingView?.dataset.viewTitle ||
+          document.title;
+        const incomingStyles = captureHeadStyles(event.newDocument);
+
+        event.swap = () => {
+          swapFunctions.deselectScripts(event.newDocument);
+          swapFunctions.swapRootAttributes(event.newDocument);
+          swapFunctions.swapHeadElements(event.newDocument);
+
+          switchToView(
+            root,
+            targetKey,
+            incomingView,
+            incomingTitle,
+            incomingStyles,
+          );
+        };
+      }) as EventListener);
+    </script>
