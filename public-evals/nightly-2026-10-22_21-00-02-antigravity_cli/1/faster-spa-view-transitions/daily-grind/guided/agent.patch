+  <script>
+    const ROUTE_TO_VIEW = {
+      '/': 'view-home',
+      '/menu': 'view-menu',
+      '/menu/seasonal': 'view-menu',
+      '/menu/espresso': 'view-menu',
+      '/menu/cold-brew': 'view-menu',
+      '/order-online': 'view-menu',
+      '/locations': 'view-locations',
+      '/about': 'view-locations',
+      '/careers': 'view-locations',
+      '/contact': 'view-locations',
+      '/rewards': 'view-rewards',
+      '/account': 'view-account',
+      '/privacy-policy': 'view-account',
+      '/logout': 'view-home'
+    };
+
+    function filterMenuCategory(category) {
+      const buttons = document.querySelectorAll('.filter-btn');
+      buttons.forEach(btn => {
+        btn.setAttribute('aria-pressed', String(btn.dataset.filter === category));
+      });
+      document.querySelectorAll('#menu-grid .card').forEach(card => {
+        const matches = category === 'all' || card.dataset.itemCategory === category;
+        card.hidden = !matches;
+      });
+    }
+
+    function switchToView(viewId) {
+      const activeView = document.getElementById(viewId);
+      if (!activeView) return;
+
+      // Hide all views while retaining their cached rendering & structural DOM state
+      document.querySelectorAll('.spa-view').forEach(view => {
+        view.classList.add('inactive');
+        view.setAttribute('aria-hidden', 'true');
+      });
+
+      // Show the target view
+      activeView.classList.remove('inactive');
+      activeView.setAttribute('aria-hidden', 'false');
+
+      // Update active navigation link state
+      document.querySelectorAll('nav a[data-view]').forEach(link => {
+        if (link.dataset.view === viewId && !link.classList.contains('logout-link')) {
+          link.setAttribute('aria-current', 'page');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+
+      // MANDATORY: Move focus to the new view to ensure a logical tab-order
+      activeView.focus();
+    }
+
+    document.addEventListener('click', event => {
+      const link = event.target.closest('a[data-view]');
+      if (link) {
+        event.preventDefault();
+        const targetViewId = link.dataset.view;
+        const category = link.dataset.category;
+        if (category) {
+          filterMenuCategory(category);
+        }
+        const href = link.getAttribute('href') || '/';
+        if (window.location.pathname !== href) {
+          history.pushState({ viewId: targetViewId, category }, '', href);
+        }
+        switchToView(targetViewId);
+        return;
+      }
+
+      const filterBtn = event.target.closest('.filter-btn');
+      if (filterBtn) {
+        filterMenuCategory(filterBtn.dataset.filter);
+      }
+    });
+
+    window.addEventListener('popstate', event => {
+      const stateViewId = event.state && event.state.viewId;
+      const viewId = stateViewId || ROUTE_TO_VIEW[window.location.pathname] || 'view-home';
+      if (event.state && event.state.category) {
+        filterMenuCategory(event.state.category);
+      }
+      switchToView(viewId);
+    });
+
+    document.getElementById('account-form').addEventListener('submit', event => {
+      event.preventDefault();
+    });
+  </script>
+
