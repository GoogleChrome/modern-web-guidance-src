+        el.dataset.route = route;
+        el.innerHTML = `
+          <main class="container">
+            <div class="card">
+              <h2>${route.replace(/^\//, '').replace(/-/g, ' ').toUpperCase() || 'HOME'}</h2>
+              <p>Explore handcrafted offerings at The Daily Grind.</p>
+              <a href="/" class="btn">Back to Home</a>
+            </div>
+          </main>
+        `;
+        return el;
+      }
+
+      function updateActiveNav(route) {
+        document.querySelectorAll('nav a').forEach(link => {
+          const linkPath = normalizePath(link.getAttribute('href'));
+          if (linkPath !== '/' && route.startsWith(linkPath)) {
+            link.classList.add('active');
+          } else {
+            link.classList.remove('active');
+          }
+        });
+      }
+
+      function navigateTo(rawRoute, options = { pushState: true }) {
+        const targetRoute = normalizePath(rawRoute);
+
+        // Save scroll position of current view before hiding
+        scrollPositions.set(currentRoute, window.scrollY);
+
+        // Hide all cached views without removing or destroying their DOM nodes
+        viewCache.forEach((viewEl, routeKey) => {
+          if (routeKey !== targetRoute) {
+            viewEl.hidden = true;
+            viewEl.setAttribute('aria-hidden', 'true');
+          }
+        });
+
+        // Retrieve existing DOM node from cache or build once on first visit
+        const activeView = getOrCreateView(targetRoute);
+        activeView.hidden = false;
+        activeView.setAttribute('aria-hidden', 'false');
+
+        // Ensure it remains attached inside #spa-root
+        if (activeView.parentNode !== spaRoot) {
+          spaRoot.appendChild(activeView);
+        }
+
+        currentRoute = targetRoute;
+        updateActiveNav(targetRoute);
+
+        if (options.pushState && window.location.pathname !== targetRoute) {
+          window.history.pushState({ route: targetRoute }, '', targetRoute);
+        }
+
+        // Restore scroll position if revisiting a cached view
+        const savedScroll = scrollPositions.get(targetRoute) ?? 0;
+        window.scrollTo(0, savedScroll);
+      }
+
+      // Intercept internal link clicks to perform SPA transitions preserving DOM state
+      document.addEventListener('click', (event) => {
+        const anchor = event.target.closest('a[href]');
+        if (!anchor) return;
+        if (anchor.target || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+
+        const href = anchor.getAttribute('href');
+        if (!href || href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) return;
+
+        event.preventDefault();
+        navigateTo(href, { pushState: true });
+      });
+
+      window.addEventListener('popstate', () => {
+        navigateTo(window.location.pathname, { pushState: false });
+      });
+
+      // Expose viewCache for programmatic inspection if needed
+      window.__spaRouter = {
+        viewCache,
+        navigateTo,
+        getOrCreateView
+      };
+
+      // Initialize current URL path
+      const initialRoute = normalizePath(window.location.pathname);
+      if (initialRoute !== '/') {
+        navigateTo(initialRoute, { pushState: false });
+      } else {
+        updateActiveNav('/');
+      }
+    })();
+  </script>
 </body>
 
