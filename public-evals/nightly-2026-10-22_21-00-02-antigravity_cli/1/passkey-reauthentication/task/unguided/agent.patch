+  <script>
+    function base64UrlToUint8Array(input) {
+      if (input instanceof ArrayBuffer) {
+        return new Uint8Array(input);
+      }
+      if (ArrayBuffer.isView(input)) {
+        return new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
+      }
+      if (Array.isArray(input)) {
+        return new Uint8Array(input);
+      }
+      if (typeof input === 'string') {
+        const base64 = input.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), '=');
+        const binary = atob(padded);
+        const bytes = new Uint8Array(binary.length);
+        for (let i = 0; i < binary.length; i++) {
+          bytes[i] = binary.charCodeAt(i);
+        }
+        return bytes;
+      }
+      return new Uint8Array();
+    }
+
+    function bufferToBase64Url(input) {
+      if (!input) return '';
+      if (typeof input === 'string') return input;
+      const bytes = input instanceof ArrayBuffer
+        ? new Uint8Array(input)
+        : ArrayBuffer.isView(input)
+          ? new Uint8Array(input.buffer, input.byteOffset, input.byteLength)
+          : new Uint8Array(input);
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+    const reauthStatus = document.getElementById('reauth-status');
+    const sensitiveControls = document.getElementById('sensitive-controls');
+    const accountEmailInput = document.getElementById('account-email');
+    const saveSensitiveButton = document.getElementById('save-sensitive-change');
+
+    if (reauthButton) {
+      reauthButton.addEventListener('click', async () => {
+        try {
+          if (reauthStatus) {
+            reauthStatus.textContent = 'Requesting verification challenge...';
+          }
+
+          const optionsResponse = await fetch('/api/reauth/options', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            credentials: 'same-origin',
+          });
+
+          if (!optionsResponse.ok) {
+            throw new Error('Failed to fetch re-authentication options');
+          }
+
+          const rawOptions = await optionsResponse.json();
+          const opts = rawOptions.publicKey || rawOptions;
+          const rawAllowCredentials = opts.allowCredentials || opts.credentials || [];
+
+          const allowCredentials = rawAllowCredentials.map((cred) => {
+            if (typeof cred === 'string') {
+              return {
+                type: 'public-key',
+                id: base64UrlToUint8Array(cred),
+              };
+            }
+            return {
+              ...cred,
+              type: cred.type || 'public-key',
+              id: base64UrlToUint8Array(cred.id),
+            };
+          });
+
+          const publicKey = {
+            ...opts,
+            challenge: base64UrlToUint8Array(opts.challenge),
+            allowCredentials,
+          };
+
+          const assertion = await navigator.credentials.get({ publicKey });
+          if (!assertion) {
+            throw new Error('No credential assertion returned');
+          }
+
+          const assertionResponse = assertion.response || {};
+          const verificationPayload = {
+            id: assertion.id || bufferToBase64Url(assertion.rawId),
+            rawId: bufferToBase64Url(assertion.rawId || assertion.id),
+            type: assertion.type || 'public-key',
+            authenticatorAttachment: assertion.authenticatorAttachment || undefined,
+            clientExtensionResults:
+              typeof assertion.getClientExtensionResults === 'function'
+                ? assertion.getClientExtensionResults()
+                : assertion.clientExtensionResults || {},
+            response: {
+              clientDataJSON: bufferToBase64Url(assertionResponse.clientDataJSON),
+              authenticatorData: bufferToBase64Url(assertionResponse.authenticatorData),
+              signature: bufferToBase64Url(assertionResponse.signature),
+              userHandle: assertionResponse.userHandle
+                ? bufferToBase64Url(assertionResponse.userHandle)
+                : null,
+            },
+          };
+
+          const verifyResponse = await fetch('/api/reauth/verify', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            credentials: 'same-origin',
+            body: JSON.stringify(verificationPayload),
+          });
+
+          if (!verifyResponse.ok) {
+            throw new Error('Identity verification failed');
+          }
+
+          let verifyResult = null;
+          try {
+            verifyResult = await verifyResponse.json();
+          } catch (_) {
+            verifyResult = { verified: true };
+          }
+
+          if (verifyResult && verifyResult.verified === false) {
+            throw new Error('Identity verification rejected');
+          }
+
+          if (reauthStatus) {
+            reauthStatus.textContent = 'Identity verified. You may now make sensitive account changes.';
+          }
+          if (sensitiveControls) {
+            sensitiveControls.hidden = false;
+          }
+          if (accountEmailInput) {
+            accountEmailInput.disabled = false;
+          }
+          if (saveSensitiveButton) {
+            saveSensitiveButton.disabled = false;
+          }
+        } catch (err) {
+          if (reauthStatus) {
+            reauthStatus.textContent = err && err.message ? err.message : 'Re-authentication failed.';
+          }
+        }
+      });
+    }
+  </script>
