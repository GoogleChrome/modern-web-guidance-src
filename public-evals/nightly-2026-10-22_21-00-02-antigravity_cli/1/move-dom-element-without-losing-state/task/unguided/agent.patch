+  <script>
+    (function () {
+      const toggleBtn = document.getElementById('theater-mode-btn');
+      const iframe = document.getElementById('roasting-video');
+      const heroSection = document.querySelector('.hero');
+      const defaultContainer = document.getElementById('video-home');
+
+      let isTheaterMode = false;
+
+      /**
+       * Moves a DOM element to a target parent using the state-preserving
+       * `moveBefore()` API when supported, falling back to `appendChild()`
+       * for older browsers.
+       */
+      function reparentElement(parent, element, referenceNode = null) {
+        if (typeof parent.moveBefore === 'function') {
+          parent.moveBefore(element, referenceNode);
+        } else {
+          parent.insertBefore(element, referenceNode);
+        }
+      }
+
+      toggleBtn.addEventListener('click', () => {
+        isTheaterMode = !isTheaterMode;
+
+        if (isTheaterMode) {
+          reparentElement(heroSection, iframe, null);
+          heroSection.classList.add('theater-active');
+          toggleBtn.textContent = 'Exit Theater Mode';
+          toggleBtn.setAttribute('aria-pressed', 'true');
+        } else {
+          reparentElement(defaultContainer, iframe, null);
+          heroSection.classList.remove('theater-active');
+          toggleBtn.textContent = 'Theater Mode';
+          toggleBtn.setAttribute('aria-pressed', 'false');
+        }
+      });
+    })();
+  </script>
+
