+  <script>
+    const theaterToggleBtn = document.getElementById('theater-toggle');
+    const heroSection = document.getElementById('hero-section');
+    const videoContainer = document.getElementById('video-container');
+    const roastingVideo = document.getElementById('roasting-video');
+
+    let isTheaterMode = false;
+
+    function reparentElement(targetParent, nodeToMove) {
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(nodeToMove, null);
+      } else {
+        targetParent.insertBefore(nodeToMove, null);
+      }
+    }
+
+    theaterToggleBtn.addEventListener('click', () => {
+      isTheaterMode = !isTheaterMode;
+      const targetParent = isTheaterMode ? heroSection : videoContainer;
+
+      reparentElement(targetParent, roastingVideo);
+
+      theaterToggleBtn.setAttribute('aria-pressed', String(isTheaterMode));
+      theaterToggleBtn.textContent = isTheaterMode ? 'Exit Theater Mode' : 'Theater Mode';
+    });
+  </script>
