+  <script>
+    (async () => {
+      const textarea = document.getElementById('feedback-message');
+      const detectBtn = document.getElementById('detect-btn');
+      const resultEl = document.getElementById('detection-result');
+      const progressContainer = document.getElementById('download-progress-container');
+      const progressBar = document.getElementById('download-progress');
+      const progressText = document.getElementById('download-progress-text');
+
+      const languageNames = typeof Intl !== 'undefined' && Intl.DisplayNames
+        ? new Intl.DisplayNames(['en'], { type: 'language' })
+        : null;
+
+      function formatLanguageName(tag) {
+        if (!tag) return 'Unknown';
+        try {
+          return languageNames ? (languageNames.of(tag) || tag) : tag;
+        } catch {
+          return tag;
+        }
+      }
+
+      function showResult(message) {
+        resultEl.textContent = message;
+        resultEl.hidden = false;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        detectBtn.disabled = true;
+        showResult('Client-side language detection is not supported in this browser.');
+        return;
+      }
+
+      let availability;
+      try {
+        availability = await LanguageDetector.availability();
+      } catch (err) {
+        detectBtn.disabled = true;
+        showResult('Unable to check language detection availability.');
+        return;
+      }
+
+      if (availability === 'unavailable') {
+        detectBtn.disabled = true;
+        showResult('The built-in Language Detector model is unavailable on this device.');
+        return;
+      }
+
+      let detector = null;
+
+      detectBtn.addEventListener('click', async () => {
+        const text = textarea.value.trim();
+        if (!text) {
+          showResult('Please enter a feedback message to detect its language.');
+          return;
+        }
+
+        detectBtn.disabled = true;
+
+        try {
+          const currentAvailability = await LanguageDetector.availability();
+          if (currentAvailability === 'unavailable') {
+            showResult('The built-in Language Detector model is unavailable on this device.');
+            return;
+          }
+
+          if (!detector) {
+            if (currentAvailability === 'downloadable' || currentAvailability === 'downloading') {
+              progressContainer.hidden = false;
+              progressBar.value = 0;
+              progressText.textContent = 'Downloading model: 0%';
+            }
+
+            detector = await LanguageDetector.create({
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const percent = Math.round((e.loaded || 0) * 100);
+                  progressContainer.hidden = false;
+                  progressBar.value = percent;
+                  progressText.textContent = `Downloading model: ${percent}%`;
+                });
+              },
+            });
+
+            progressContainer.hidden = true;
+          }
+
+          const results = await detector.detect(text);
+          if (!results || results.length === 0) {
+            showResult('Could not detect the language of the message.');
+            return;
+          }
+
+          const topResult = results[0];
+          const langName = formatLanguageName(topResult.detectedLanguage);
+          const confidencePct = (topResult.confidence * 100).toFixed(1);
+          showResult(`Detected Language: ${langName} (${topResult.detectedLanguage}) — Confidence: ${confidencePct}%`);
+        } catch (error) {
+          progressContainer.hidden = true;
+          showResult(`Language detection failed: ${error.message || 'Unknown error'}`);
+        } finally {
+          if (availability !== 'unavailable') {
+            detectBtn.disabled = false;
+          }
+        }
+      });
+    })();
+  </script>
