+  <script>
+    const feedbackInput = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const detectStatus = document.getElementById('detect-status');
+    const detectResult = document.getElementById('detect-result');
+
+    let detectorInstance = null;
+
+    function formatLanguageName(code) {
+      if (!code) return 'Unknown';
+      try {
+        const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+        return displayNames.of(code) || code;
+      } catch {
+        return code;
+      }
+    }
+
+    async function handleDetect() {
+      const text = feedbackInput.value.trim();
+      detectStatus.textContent = '';
+      detectResult.textContent = '';
+
+      if (!text) {
+        detectStatus.textContent = 'Please enter a message to detect its language.';
+        return;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        detectStatus.textContent = 'Language detection is not supported in this browser.';
+        return;
+      }
+
+      try {
+        detectBtn.disabled = true;
+
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          detectStatus.textContent = 'Language detection is currently unavailable on this device.';
+          return;
+        }
+
+        if (!detectorInstance) {
+          if (availability === 'downloadable' || availability === 'downloading') {
+            detectStatus.textContent = 'Downloading model: 0%';
+          }
+
+          detectorInstance = await LanguageDetector.create({
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const percent = e.total
+                  ? Math.round((e.loaded / e.total) * 100)
+                  : Math.round(e.loaded * 100);
+                detectStatus.textContent = `Downloading model: ${percent}%`;
+              });
+            }
+          });
+        }
+
+        detectStatus.textContent = '';
+        const results = await detectorInstance.detect(text);
+
+        if (results && results.length > 0) {
+          const topResult = results[0];
+          const languageName = formatLanguageName(topResult.detectedLanguage);
+          const confidencePercent = Math.round((topResult.confidence || 0) * 100);
+          detectResult.textContent = `Detected Language: ${languageName} (${confidencePercent}% confidence)`;
+        } else {
+          detectResult.textContent = 'Could not determine the language.';
+        }
+      } catch (error) {
+        detectStatus.textContent = `Error detecting language: ${error.message || error}`;
+      } finally {
+        detectBtn.disabled = false;
+      }
+    }
+
+    detectBtn.addEventListener('click', handleDetect);
+  </script>
 </body>
 
