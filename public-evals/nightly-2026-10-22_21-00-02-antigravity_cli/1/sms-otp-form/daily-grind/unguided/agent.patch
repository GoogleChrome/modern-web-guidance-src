+  <script>
+    (function () {
+      const form = document.getElementById('otp-verification-form');
+      const phoneInput = document.getElementById('phone-input');
+      const otpInput = document.getElementById('otp-input');
+      const sendCodeBtn = document.getElementById('send-code-btn');
+      const statusMessage = document.getElementById('verification-status');
+
+      let activeAbortController = null;
+
+      function setStatus(message, type) {
+        if (!statusMessage) return;
+        statusMessage.textContent = message;
+        statusMessage.className = 'status-message visible ' + (type || 'info');
+      }
+
+      // Extract a numeric passcode from pasted or SMS-formatted text
+      function extractCodeFromText(text) {
+        if (!text) return '';
+        const match = String(text).match(/\b(\d{4,8})\b/) || String(text).match(/(\d{4,8})/);
+        return match ? match[1] : String(text).replace(/\D/g, '').slice(0, 6);
+      }
+
+      // Start WebOTP API listener to automatically extract one-time passcode from incoming SMS
+      function listenForWebOTP() {
+        if (!('OTPCredential' in window) || !navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          return;
+        }
+
+        if (activeAbortController) {
+          activeAbortController.abort();
+        }
+        activeAbortController = new AbortController();
+
+        navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: activeAbortController.signal
+        }).then(function (otp) {
+          if (otp && otp.code && otpInput) {
+            otpInput.value = otp.code;
+            setStatus('Passcode automatically extracted from SMS.', 'info');
+            if (phoneInput && phoneInput.value.trim()) {
+              verifySubmission();
+            }
+          }
+        }).catch(function (err) {
+          // Ignore AbortError or unsupported environments gracefully
+        });
+      }
+
+      function verifySubmission() {
+        if (activeAbortController) {
+          activeAbortController.abort();
+          activeAbortController = null;
+        }
+
+        const phone = phoneInput ? phoneInput.value.trim() : '';
+        const code = otpInput ? otpInput.value.trim() : '';
+
+        if (!phone) {
+          setStatus('Please enter a valid phone number.', 'error');
+          if (phoneInput) phoneInput.focus();
+          return false;
+        }
+
+        if (!code || !/^\d{4,8}$/.test(code)) {
+          setStatus('Please enter a valid numeric verification code.', 'error');
+          if (otpInput) otpInput.focus();
+          return false;
+        }
+
+        setStatus('Phone number ' + phone + ' verified with passcode!', 'success');
+        return true;
+      }
+
+      if (otpInput) {
+        otpInput.addEventListener('paste', function (e) {
+          const clipboardData = e.clipboardData || window.clipboardData;
+          if (!clipboardData) return;
+          const pastedText = clipboardData.getData('text');
+          const extracted = extractCodeFromText(pastedText);
+          if (extracted && extracted !== pastedText.trim()) {
+            e.preventDefault();
+            otpInput.value = extracted;
+            setStatus('Passcode extracted from pasted SMS message.', 'info');
+          }
+        });
+
+        otpInput.addEventListener('input', function () {
+          const val = otpInput.value;
+          // If a full SMS message or non-digits were inserted by autofill/paste, extract the digits
+          if (/\D/.test(val)) {
+            const extracted = extractCodeFromText(val);
+            otpInput.value = extracted;
+          }
+        });
+      }
+
+      if (sendCodeBtn) {
+        sendCodeBtn.addEventListener('click', function () {
+          const phone = phoneInput ? phoneInput.value.trim() : '';
+          if (!phone) {
+            setStatus('Please enter your phone number first to receive an SMS code.', 'error');
+            if (phoneInput) phoneInput.focus();
+            return;
+          }
+          setStatus('Verification SMS sent to ' + phone + '. Waiting for code...', 'info');
+          listenForWebOTP();
+          if (otpInput) otpInput.focus();
+        });
+      }
+
+      if (form) {
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          verifySubmission();
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', listenForWebOTP);
+      } else {
+        listenForWebOTP();
+      }
+    })();
+  </script>
