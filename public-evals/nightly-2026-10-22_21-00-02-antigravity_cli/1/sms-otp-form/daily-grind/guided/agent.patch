+  <script>
+    const phoneForm = document.getElementById('phone-form');
+    const phoneInput = document.getElementById('phone-input');
+    const phoneError = document.getElementById('phone-error');
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const otpError = document.getElementById('otp-error');
+    const resendCodeBtn = document.getElementById('resend-code-btn');
+    const verifyCodeBtn = document.getElementById('verify-code-btn');
+    const verificationStatus = document.getElementById('verification-status');
+    const smsPayloadPreview = document.getElementById('sms-payload-preview');
+
+    let otpAbortController = null;
+
+    function formatOriginBoundSms(code) {
+      const hostDomain = window.location.hostname || 'example.com';
+      return `Your verification code is ${code}.\n\n@${hostDomain} #${code}`;
+    }
+
+    function showStatus(message, isSuccess = false) {
+      verificationStatus.textContent = message;
+      verificationStatus.classList.toggle('success', isSuccess);
+      verificationStatus.hidden = false;
+    }
+
+    function validateField(input, errorEl, customMessage) {
+      input.setCustomValidity('');
+      if (!input.checkValidity()) {
+        input.setCustomValidity(customMessage);
+        errorEl.textContent = customMessage;
+        errorEl.hidden = false;
+        input.setAttribute('aria-invalid', 'true');
+        return false;
+      }
+      errorEl.textContent = '';
+      errorEl.hidden = true;
+      input.removeAttribute('aria-invalid');
+      return true;
+    }
+
+    function clearFieldError(input, errorEl) {
+      input.setCustomValidity('');
+      errorEl.textContent = '';
+      errorEl.hidden = true;
+      input.removeAttribute('aria-invalid');
+    }
+
+    phoneInput.addEventListener('input', () => {
+      clearFieldError(phoneInput, phoneError);
+    });
+
+    phoneInput.addEventListener('blur', () => {
+      if (phoneInput.value.trim().length > 0) {
+        validateField(phoneInput, phoneError, 'Please enter a valid phone number (7 to 20 digits).');
+      }
+    });
+
+    otpInput.addEventListener('input', () => {
+      clearFieldError(otpInput, otpError);
+    });
+
+    otpInput.addEventListener('blur', () => {
+      if (otpInput.value.trim().length > 0) {
+        validateField(otpInput, otpError, 'Please enter the 6-digit numeric verification code.');
+      }
+    });
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      // Feature-detect WebOTP support
+      if (!otpInput || !('OTPCredential' in window)) {
+        return;
+      }
+
+      // Cancel any previous pending WebOTP request (e.g., when re-sending an SMS code)
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+
+      try {
+        const otp = await navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: ac.signal,
+        });
+
+        if (!otp) return;
+        otpInput.value = otp.code;
+
+        // Trigger standard form submission so submit event listeners and validation run
+        if (otpForm) {
+          otpForm.requestSubmit();
+        }
+      } catch (err) {
+        // Expected when aborted by manual submission, resend, unmount, or user dismissal
+        if (err && err.name === 'AbortError') {
+          return;
+        }
+        console.error('WebOTP verification error:', err);
+      }
+    }
+
+    phoneForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!validateField(phoneInput, phoneError, 'Please enter a valid phone number (7 to 20 digits).')) {
+        phoneInput.focus();
+        return;
+      }
+
+      const phone = phoneInput.value.trim();
+      showStatus(`Verification code sent to ${phone}. Listening for incoming SMS...`);
+      smsPayloadPreview.textContent = formatOriginBoundSms('123456');
+      smsPayloadPreview.hidden = false;
+
+      // Restart the WebOTP listener for the newly requested SMS code and move focus to the OTP input
+      startSmsOtpListener();
+      otpInput.focus();
+    });
+
+    resendCodeBtn.addEventListener('click', () => {
+      const phone = phoneInput.value.trim() || 'your phone';
+      otpInput.value = '';
+      clearFieldError(otpInput, otpError);
+      verifyCodeBtn.disabled = false;
+      showStatus(`A new verification code was sent to ${phone}.`);
+      smsPayloadPreview.textContent = formatOriginBoundSms('123456');
+      smsPayloadPreview.hidden = false;
+
+      // Abort previous WebOTP listener and start a fresh one
+      startSmsOtpListener();
+      otpInput.focus();
+    });
+
+    otpForm.addEventListener('submit', async (event) => {
+      // MANDATORY: Abort any in-flight WebOTP request when the form is submitted
+      stopSmsOtpListener();
+
+      event.preventDefault();
+      if (!validateField(otpInput, otpError, 'Please enter the 6-digit numeric verification code.')) {
+        otpInput.focus();
+        return;
+      }
+
+      // Disable submit button after a valid submission to prevent double-posts
+      verifyCodeBtn.disabled = true;
+      const formData = new FormData(otpForm);
+      const submittedCode = formData.get('otp');
+      showStatus(`Phone number verified with code ${submittedCode}.`, true);
+    });
+
+    window.addEventListener('pagehide', stopSmsOtpListener);
+
+    // Start listening when the OTP verification step is active
+    startSmsOtpListener();
+  </script>
 </body>
 
