+++ b/src/pages/api/send-otp.ts
@@ -0,0 +1,82 @@
+import type { APIRoute } from 'astro';
+
+function generateSixDigitCode(): string {
+  return String(Math.floor(100000 + Math.random() * 900000));
+}
+
+function getHostDomain(request: Request, url: URL): string {
+  const originHeader = request.headers.get('origin') || request.headers.get('referer');
+  if (originHeader) {
+    try {
+      return new URL(originHeader).hostname;
+    } catch {
+      // Fallback to request URL hostname
+    }
+  }
+  return url.hostname || 'localhost';
+}
+
+/**
+ * Formats an origin-bound SMS OTP message per the WebOTP / origin-bound one-time-code specification:
+ * - Starts with human-readable text containing the verification code.
+ * - Places `@<domain> #<otp>` on the very last line with no scheme, port, or path,
+ *   separated by a single space and no trailing text.
+ */
+export function formatOriginBoundSms(domain: string, code: string): string {
+  const cleanDomain = domain.replace(/^https?:\/\//, '').split('/')[0].split(':')[0].trim() || 'localhost';
+  const cleanCode = code.trim();
+  return `Your DevTools Times verification code is ${cleanCode}.\n\n@${cleanDomain} #${cleanCode}`;
+}
+
+export const POST: APIRoute = async ({ request, url, session }) => {
+  try {
