+function extractOtpFromText(raw: string): string {
+  if (!raw) return '';
+  // Match WebOTP standard format `#123456` first
+  const hashMatch = raw.match(/#(\d{4,8})\b/);
+  if (hashMatch && hashMatch[1]) {
+    return hashMatch[1].slice(0, OTP_LENGTH);
+  }
+  // Match standalone 6-digit passcode in an SMS message
+  const sixDigitMatch = raw.match(/\b(\d{6})\b/);
+  if (sixDigitMatch && sixDigitMatch[1]) {
+    return sixDigitMatch[1];
+  }
+  // Fallback: strip non-digits and take up to OTP_LENGTH digits
+  return raw.replace(/\D/g, '').slice(0, OTP_LENGTH);
