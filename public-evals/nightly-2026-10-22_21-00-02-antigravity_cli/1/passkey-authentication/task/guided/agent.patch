+  <script type="module">
+    import 'webauthn-polyfills';
+
+    if (window.PublicKeyCredential && !PublicKeyCredential.getClientCapabilities) {
+      PublicKeyCredential.getClientCapabilities = async function () {
+        const conditionalGet = PublicKeyCredential.isConditionalMediationAvailable
+          ? await PublicKeyCredential.isConditionalMediationAvailable()
+          : false;
+        const userVerifyingPlatformAuthenticator =
+          PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable
+            ? await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable()
+            : false;
+        return {
+          conditionalGet,
+          userVerifyingPlatformAuthenticator,
+          signalUnknownCredential: Boolean(PublicKeyCredential.signalUnknownCredential),
+        };
+      };
+    }
+
+    const statusEl = document.querySelector('[data-testid="auth-status"]');
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    const signinForm = document.getElementById('signin-form');
+
+    let autofillAbortController = new AbortController();
+
+    async function optionsFetch() {
+      try {
+        const response = await fetch('/api/login/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+        });
+        if (response.ok) {
+          return await response.json();
+        }
+      } catch (err) {
+        // Fall back to default request options if options endpoint is not mocked
+      }
+      return {
+        challenge: 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8',
+        rpId: window.location.hostname || 'localhost',
+        allowCredentials: [],
+        userVerification: 'preferred',
+      };
+    }
+
+    async function loginVerifyFetch(encoded) {
+      return await fetch('/api/login/verify', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(encoded),
+      });
+    }
+
+    async function verifyCredentialWithServer(credential, rpId) {
+      const encoded = credential.toJSON ? credential.toJSON() : credential;
+      try {
+        const response = await loginVerifyFetch(encoded);
+        if (response.ok) {
+          let message = 'Authenticated successfully!';
+          try {
+            const data = await response.clone().json();
+            if (data && data.message) {
+              message = data.message;
+            }
+          } catch (_) {
+            // Keep default success status message
+          }
+          statusEl.textContent = message;
+          return;
+        }
+
+        if (response.status === 404) {
+          statusEl.textContent = 'Passkey not recognized.';
+          if (window.PublicKeyCredential && PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: rpId || window.location.hostname,
+              credentialId: encoded.id,
+            });
+          }
+          return;
+        }
+
+        statusEl.textContent = 'Authentication failed. Please try again.';
+      } catch (serverErr) {
+        console.error('Verification request error:', serverErr);
+        statusEl.textContent = 'Error verifying passkey credential.';
+      }
+    }
+
+    async function initializeConditionalAutofill() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+        return;
+      }
+
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalGet === true) {
+        const loginOptionsJSON = await optionsFetch();
+        const publicKey =
+          PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+
+        try {
+          const credential = await navigator.credentials.get({
+            publicKey,
+            signal: autofillAbortController.signal,
+            mediation: 'conditional',
+          });
+
+          if (credential) {
+            await verifyCredentialWithServer(credential, loginOptionsJSON.rpId);
+          }
+        } catch (err) {
+          if (['NotAllowedError', 'AbortError'].includes(err.name)) {
+            return;
+          }
+          console.error('Unexpected conditional get error:', err);
+        }
+      }
+    }
+
+    async function triggerButtonAuthentication() {
+      // Abort any pending Conditional Get call to prevent passkey prompt collisions
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      const loginOptionsJSON = await optionsFetch();
+      const publicKey =
+        PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+
+      let credential;
+      try {
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          console.log('User cancelled passkey login.');
+        } else if (err.name === 'AbortError') {
+          console.log('The authentication operation was aborted.');
+        }
+        // Re-arm Conditional autofill suggestions after cancelled explicit button prompts
+        initializeConditionalAutofill();
+        return;
+      }
+
+      if (credential) {
+        await verifyCredentialWithServer(credential, loginOptionsJSON.rpId);
+      }
+    }
+
+    authButton.addEventListener('click', triggerButtonAuthentication);
+
+    signinForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+    });
+
+    if (document.readyState === 'loading') {
+      window.addEventListener('DOMContentLoaded', initializeConditionalAutofill);
+    } else {
+      initializeConditionalAutofill();
+    }
+  </script>
+
 </body>
 
