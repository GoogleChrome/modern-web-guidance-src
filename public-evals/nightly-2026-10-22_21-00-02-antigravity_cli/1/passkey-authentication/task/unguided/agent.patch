+  <script>
+    (function () {
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const authStatus = document.querySelector('[data-testid="auth-status"]');
+      const authForm = document.getElementById('auth-form');
+
+      let conditionalAbortController = null;
+
+      function createChallenge() {
+        const challenge = new Uint8Array(32);
+        if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
+          window.crypto.getRandomValues(challenge);
+        } else {
+          for (let i = 0; i < challenge.length; i++) {
+            challenge[i] = (i + 1) & 0xff;
+          }
+        }
+        return challenge;
+      }
+
+      function bufferToBase64url(buffer) {
+        if (!buffer) return null;
+        if (typeof buffer === 'string') return buffer;
+        let bytes;
+        if (buffer instanceof ArrayBuffer) {
+          bytes = new Uint8Array(buffer);
+        } else if (ArrayBuffer.isView(buffer)) {
+          bytes = new Uint8Array(buffer.buffer, buffer.byteOffset, buffer.byteLength);
+        } else if (Array.isArray(buffer)) {
+          bytes = new Uint8Array(buffer);
+        } else {
+          return String(buffer);
+        }
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function serializeCredential(credential) {
+        const response = (credential && credential.response) || {};
+        return {
+          id: credential.id || '',
+          rawId: bufferToBase64url(credential.rawId) || credential.id || '',
+          type: credential.type || 'public-key',
+          authenticatorAttachment: credential.authenticatorAttachment || undefined,
+          response: {
+            clientDataJSON: bufferToBase64url(response.clientDataJSON),
+            authenticatorData: bufferToBase64url(response.authenticatorData),
+            signature: bufferToBase64url(response.signature),
+            userHandle: response.userHandle ? bufferToBase64url(response.userHandle) : null,
+          },
+          clientExtensionResults:
+            typeof credential.getClientExtensionResults === 'function'
+              ? credential.getClientExtensionResults()
+              : credential.clientExtensionResults || {},
+          username: usernameField ? usernameField.value : undefined,
+        };
+      }
+
+      function updateStatus(message, isSuccess) {
+        if (!authStatus) return;
+        authStatus.textContent = message;
+        authStatus.dataset.status = isSuccess ? 'success' : 'error';
+        authStatus.classList.toggle('success', Boolean(isSuccess));
+        authStatus.classList.toggle('error', !isSuccess);
+      }
+
+      async function verifyCredential(credential) {
+        const payload = serializeCredential(credential);
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify(payload),
+        });
+
+        let data = null;
+        try {
+          const text = await response.text();
+          if (text) {
+            data = JSON.parse(text);
+          }
+        } catch (_) {
+          // Non-JSON response body
+        }
+
+        if (response.ok && (!data || (data.success !== false && data.verified !== false))) {
+          const msg =
+            data && typeof data.message === 'string' && data.message.trim()
+              ? `${data.message} - Authentication successful! Signed in with passkey.`
+              : 'Authentication successful! Signed in with passkey (verified).';
+          updateStatus(msg, true);
+        } else {
+          const errMsg =
+            (data && (data.error || data.message)) || 'Passkey verification failed.';
+          updateStatus(errMsg, false);
+        }
+      }
+
+      async function handleConditionalPasskey() {
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          return;
+        }
+
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+          conditionalAbortController = null;
+        }
+
+        const abortController = new AbortController();
+        conditionalAbortController = abortController;
+
+        if (
+          window.PublicKeyCredential &&
+          typeof window.PublicKeyCredential.isConditionalMediationAvailable === 'function'
+        ) {
+          window.PublicKeyCredential.isConditionalMediationAvailable().catch(() => {});
+        }
+
+        try {
+          const credential = await navigator.credentials.get({
+            mediation: 'conditional',
+            publicKey: {
+              challenge: createChallenge(),
+              rpId: window.location.hostname || 'localhost',
+              allowCredentials: [],
+              userVerification: 'preferred',
+              timeout: 60000,
+            },
+            signal: abortController.signal,
+          });
+
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          if (err && err.name === 'AbortError') {
+            return;
+          }
+        } finally {
+          if (conditionalAbortController === abortController) {
+            conditionalAbortController = null;
+          }
+        }
+      }
+
+      async function handleDirectPasskey(event) {
+        if (event) {
+          event.preventDefault();
+        }
+
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+          conditionalAbortController = null;
+        }
+
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          updateStatus('Passkey authentication is not supported in this browser.', false);
+          return;
+        }
+
+        try {
+          const credential = await navigator.credentials.get({
+            publicKey: {
+              challenge: createChallenge(),
+              rpId: window.location.hostname || 'localhost',
+              allowCredentials: [],
+              userVerification: 'required',
+              timeout: 60000,
+            },
+          });
+
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          if (err && err.name === 'AbortError') {
+            return;
+          }
+          updateStatus('Authentication failed or was cancelled.', false);
+        }
+      }
+
+      if (usernameField) {
+        usernameField.addEventListener('focus', handleConditionalPasskey);
+      }
+
+      if (authButton) {
+        authButton.addEventListener('click', handleDirectPasskey);
+      }
+
+      if (authForm) {
+        authForm.addEventListener('submit', handleDirectPasskey);
+      }
+    })();
+  </script>
