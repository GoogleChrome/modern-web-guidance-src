+  <script>
+    async function checkLocalNetworkPermissions() {
+      const permissions = ['local-network', 'loopback-network', 'local-network-access'];
+      const results = {};
+      if (navigator.permissions && navigator.permissions.query) {
+        for (const name of permissions) {
+          try {
+            const status = await navigator.permissions.query({ name });
+            results[name] = status.state;
+          } catch (e) {
+            results[name] = 'unsupported';
+          }
+        }
+      }
+      return results;
+    }
+
+    async function fetchLocalResource(url, addressSpace = 'loopback') {
+      const request = new Request(url, {
+        method: 'GET',
+        mode: 'cors',
+        targetAddressSpace: addressSpace,
+      });
+      return fetch(request, {
+        targetAddressSpace: addressSpace,
+      });
+    }
+
+    window.checkLocalNetworkPermissions = checkLocalNetworkPermissions;
+    window.fetchLocalResource = fetchLocalResource;
+
+    const connectBtn = document.getElementById('connect-local-btn');
+    const statusEl = document.getElementById('local-network-status');
+
+    if (connectBtn && statusEl) {
+      connectBtn.addEventListener('click', async () => {
+        statusEl.textContent = 'Checking local network and loopback permissions...';
+        const permStates = await checkLocalNetworkPermissions();
+        try {
+          await Promise.any([
+            fetchLocalResource('http://127.0.0.1:11222/', 'loopback'),
+            fetchLocalResource('http://localhost:11222/', 'local'),
+          ]);
+          statusEl.textContent = 'Connected to local resource (' + JSON.stringify(permStates) + ')';
+        } catch (err) {
+          statusEl.textContent = 'Permission states: ' + JSON.stringify(permStates);
+        }
+      });
+    }
+  </script>
+
 </body>
 
