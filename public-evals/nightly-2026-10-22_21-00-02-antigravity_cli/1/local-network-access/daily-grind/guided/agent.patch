@@ -0,0 +1,172 @@
+/**
+ * Local Network Access (LNA) Client Module
+ *
+ * Implements granular permission checks ('local-network' and 'loopback-network'),
+ * explicit targetAddressSpace declarations ('local' and 'loopback') for fetch/Request,
+ * real-time connections via WebSocket and WebTransport, and cross-browser fallback handling.
+ *
+ * Note: Web applications initiating local or loopback network requests must be served
+ * from a Secure Context (https://). Do NOT rely on deprecated Private Network Access (PNA)
+ * preflight headers or query the legacy 'local-network-access' permission name.
+ */
+
+/**
+ * Safely queries a granular Local Network Access permission ('local-network' or 'loopback-network')
+ * with progressive fallback for browsers that do not yet recognize LNA PermissionNames.
+ * Never queries the legacy 'local-network-access' permission name, which can crash older Chrome versions.
+ *
+ * @param {'local-network' | 'loopback-network'} permissionName
+ * @param {(permissionName: 'local-network' | 'loopback-network', state: PermissionState) => void} [onChange]
+ * @returns {Promise<PermissionState>}
+ */
+export async function queryLnaPermissionSafe(permissionName, onChange) {
+  if (!navigator.permissions?.query) {
+    return 'prompt';
+  }
+  try {
+    const status = await navigator.permissions.query({ name: permissionName });
+    status.addEventListener('change', () => {
+      updatePermissionUI(permissionName, status.state);
+      if (typeof onChange === 'function') {
+        onChange(permissionName, status.state);
+      }
+    });
+    return status.state;
+  } catch {
+    // Unrecognized permission name in browsers without LNA support; proceed on user gesture
+    return 'prompt';
+  }
+}
+
+/**
+ * Queries the granular Local Network Access permission for the target space and synchronizes UI.
+ *
+ * @param {'local-network' | 'loopback-network'} permissionName
+ * @returns {Promise<PermissionState>}
+ */
+export async function checkNetworkPermission(permissionName) {
+  const state = await queryLnaPermissionSafe(permissionName);
+  updatePermissionUI(permissionName, state);
+  return state;
+}
+
+/**
+ * Synchronizes permission badge and remediation instructions in the DOM.
+ *
+ * @param {'local-network' | 'loopback-network'} permissionName
+ * @param {PermissionState} state
+ */
+export function updatePermissionUI(permissionName, state) {
+  const statusBadge = document.querySelector(`[data-permission-status="${permissionName}"]`);
+  const remediationBox = document.querySelector(`[data-remediation="${permissionName}"]`);
+  if (statusBadge) {
+    statusBadge.textContent = state;
+    statusBadge.dataset.state = state;
+  }
+  if (remediationBox) {
+    // Show remediation instructions whenever permission is explicitly denied
+    remediationBox.hidden = state !== 'denied';
+  }
+}
+
+/**
+ * Connects to a local network device (e.g., LAN brewer, printer, or IoT hub) over HTTP.
+ * Declares targetAddressSpace: 'local' to exempt the request from Mixed Content blocking
+ * once the user grants 'local-network' permission and to verify the resolved IP address space.
+ *
+ * @param {string} [deviceUrl='http://192.168.1.100:8080/api/status']
+ * @param {RequestInit} [options={}]
+ */
+export async function fetchLocalDeviceStatus(
+  deviceUrl = 'http://192.168.1.100:8080/api/status',
+  options = {}
+) {
+  const request = new Request(deviceUrl, {
+    method: 'GET',
+    mode: 'cors',
+    ...options,
+    // MANDATORY: Declare 'local' when targeting RFC 1918 / link-local / ULA / .local LAN addresses
+    targetAddressSpace: 'local',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Local device responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Connects to a local companion daemon running on the user's loopback interface.
+ * Declares targetAddressSpace: 'loopback' when targeting 127.0.0.1, [::1], or localhost.
+ *
+ * @param {string} [daemonUrl='http://127.0.0.1:45678/health']
+ * @param {RequestInit} [options={}]
+ */
+export async function fetchLoopbackDaemon(
+  daemonUrl = 'http://127.0.0.1:45678/health',
+  options = {}
+) {
+  const request = new Request(daemonUrl, {
+    method: 'GET',
+    mode: 'cors',
+    ...options,
+    // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+    targetAddressSpace: 'loopback',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Loopback companion service responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Opens a WebSocket connection to a local network or loopback device
+ * (IP literal, .local mDNS hostname, or localhost).
+ *
+ * Note: The WebSocket(url, protocols) constructor only accepts subprotocol string(s)
+ * as its second argument—never pass a { targetAddressSpace } options object.
+ *
+ * @param {string} [wsUrl='ws://192.168.1.100:8080/stream']
+ * @param {string | string[]} [protocols=['v1.telemetry']]
+ * @returns {WebSocket}
+ */
+export function openLocalWebSocket(
+  wsUrl = 'ws://192.168.1.100:8080/stream',
+  protocols = ['v1.telemetry']
+) {
+  const socket = new WebSocket(wsUrl, protocols);
+  return socket;
+}
+
+/**
+ * Opens a WebTransport session to a local network or loopback endpoint using TLS
+ * or a pinned self-signed certificate hash.
+ *
+ * @param {string} [wtUrl='https://192.168.1.100:4433/wt']
+ * @param {BufferSource} [certSha256Bytes]
+ * @returns {Promise<WebTransport>}
+ */
+export async function openLocalWebTransport(
+  wtUrl = 'https://192.168.1.100:4433/wt',
+  certSha256Bytes
+) {
+  const options = certSha256Bytes
+    ? {
+        serverCertificateHashes: [
+          {
+            algorithm: 'sha-256',
+            value: certSha256Bytes,
+          },
+        ],
+      }
+    : {};
+
+  const transport = new WebTransport(wtUrl, options);
+  // transport.ready resolves only after the user grants the 'local-network' or 'loopback-network'
+  // permission and rejects with WebTransportError if the permission is denied.
+  await transport.ready;
+  return transport;
+}
