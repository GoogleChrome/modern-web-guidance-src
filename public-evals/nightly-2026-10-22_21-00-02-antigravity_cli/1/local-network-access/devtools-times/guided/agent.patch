+/**
+ * Local Network Access (LNA) utilities for connecting to resources on a user's
+ * local network (`local` address space) or loopback interface (`loopback` address space).
+ */
+
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type TargetAddressSpace = 'local' | 'loopback';
+
+export interface LocalFetchRequestInit extends RequestInit {
+  targetAddressSpace?: TargetAddressSpace;
+}
+
+/**
+ * Determines whether a URL targets the 'loopback' or 'local' address space,
+ * or 'public' if neither matches.
+ */
+export function detectTargetAddressSpace(inputUrl: string | URL): TargetAddressSpace | 'public' {
+  try {
+    const parsed = typeof inputUrl === 'string' ? new URL(inputUrl, 'https://example.com') : inputUrl;
+    const hostname = parsed.hostname.toLowerCase().replace(/^\[|\]$/g, '');
+
+    // Loopback: 127.0.0.0/8, ::1, localhost, *.localhost
+    if (
+      hostname === 'localhost' ||
+      hostname.endsWith('.localhost') ||
+      hostname === '::1' ||
+      hostname === '0:0:0:0:0:0:0:1' ||
+      /^127\.\d{1,3}\.\d{1,3}\.\d{1,3}$/.test(hostname)
+    ) {
+      return 'loopback';
+    }
+
+    // Local network: RFC 1918 (10/8, 172.16/12, 192.168/16), link-local (169.254/16, fe80::/10),
+    // IPv6 Unique Local (fc00::/7 -> fc.. or fd..), and .local mDNS hostnames
+    if (
+      hostname.endsWith('.local') ||
+      /^10\.\d{1,3}\.\d{1,3}\.\d{1,3}$/.test(hostname) ||
+      /^192\.168\.\d{1,3}\.\d{1,3}$/.test(hostname) ||
+      /^172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3}$/.test(hostname) ||
+      /^169\.254\.\d{1,3}\.\d{1,3}$/.test(hostname) ||
+      /^f[cd][0-9a-f]{2}:/i.test(hostname) ||
+      /^fe[89ab][0-9a-f]:/i.test(hostname)
+    ) {
+      return 'local';
+    }
+
+    return 'public';
+  } catch {
+    return 'public';
+  }
+}
+
+/**
+ * Cross-browser permission check for the granular LNA permissions ('local-network' | 'loopback-network').
+ * Never queries the legacy 'local-network-access' permission name, which crashes older Chrome renderers.
+ */
+export async function queryLnaPermissionSafe(
+  permissionName: LnaPermissionName,
+  onChange?: (state: PermissionState) => void
+): Promise<PermissionState> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return 'prompt';
+  }
+  try {
+    const status = await navigator.permissions.query({
+      name: permissionName as PermissionName,
+    });
+    if (onChange) {
+      status.addEventListener('change', () => {
+        onChange(status.state);
+      });
+    }
+    return status.state;
+  } catch {
+    // Unrecognized permission name in browsers without LNA support; proceed on user gesture
+    return 'prompt';
+  }
+}
+
+/**
+ * Queries the granular Local Network Access permission for the target space
+ * and synchronizes DOM status badges / remediation containers if present.
+ */
+export async function checkNetworkPermission(
+  permissionName: LnaPermissionName
+): Promise<PermissionState> {
+  const state = await queryLnaPermissionSafe(permissionName, (newState) => {
+    updatePermissionUI(permissionName, newState);
+  });
+  updatePermissionUI(permissionName, state);
+  return state;
+}
+
+export function updatePermissionUI(permissionName: LnaPermissionName, state: PermissionState): void {
+  if (typeof document === 'undefined') return;
+  const statusBadge = document.querySelector(`[data-permission-status="${permissionName}"]`);
+  const remediationBox = document.querySelector(
+    `[data-remediation="${permissionName}"]`
+  ) as HTMLElement | null;
+
+  if (statusBadge) {
+    statusBadge.textContent = state;
+  }
+  if (remediationBox) {
+    remediationBox.hidden = state !== 'denied';
+  }
+}
+
+/**
+ * Connects to a local network device (e.g., LAN printer, edge node, or IoT hub) over HTTP/HTTPS.
+ * Declares `targetAddressSpace: 'local'` to exempt Mixed Content (after permission grant)
+ * and verify the resolved IP belongs to the local address space.
+ */
+export async function fetchLocalDeviceStatus(
+  deviceUrl = 'http://192.168.1.100:8080/api/status',
+  init?: RequestInit
+): Promise<unknown> {
+  const request = new Request(deviceUrl, {
+    method: 'GET',
+    mode: 'cors',
+    ...init,
+    // MANDATORY: Declare 'local' when targeting RFC 1918 / .local LAN addresses
+    targetAddressSpace: 'local',
+  } as LocalFetchRequestInit);
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Device responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Connects to a local companion daemon running on the user's loopback interface.
+ * Declares `targetAddressSpace: 'loopback'` when targeting 127.0.0.1, [::1], or localhost.
+ */
+export async function fetchLoopbackDaemon(
+  daemonUrl = 'http://127.0.0.1:45678/health',
+  init?: RequestInit
+): Promise<unknown> {
+  const request = new Request(daemonUrl, {
+    method: 'GET',
+    mode: 'cors',
+    ...init,
+    // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+    targetAddressSpace: 'loopback',
+  } as LocalFetchRequestInit);
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Companion app responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Generic helper to fetch a resource on the user's local network or loopback interface
+ * with automatic or explicit `targetAddressSpace`.
+ */
+export async function fetchLocalOrLoopbackResource(
+  url: string,
+  targetAddressSpace?: TargetAddressSpace,
+  init?: RequestInit
+): Promise<Response> {
+  const resolvedSpace: TargetAddressSpace =
+    targetAddressSpace ??
+    (detectTargetAddressSpace(url) === 'loopback' ? 'loopback' : 'local');
+
+  const request = new Request(url, {
+    method: 'GET',
+    mode: 'cors',
+    ...init,
+    targetAddressSpace: resolvedSpace,
+  } as LocalFetchRequestInit);
+
+  return fetch(request);
+}
+
+/**
+ * Opens a WebSocket connection to a local network or loopback device (IP literal, .local, or localhost).
+ * Passes only subprotocol string(s) as the second argument (never an options object).
+ */
+export function openLocalWebSocket(
+  wsUrl = 'ws://192.168.1.100:8080/stream',
+  protocols: string | string[] = ['v1.telemetry'],
+  onError?: (event: Event) => void,
+  onMessage?: (data: unknown) => void
+): WebSocket {
+  const socket = new WebSocket(wsUrl, protocols);
+  if (onError) {
+    socket.addEventListener('error', onError);
+  }
+  if (onMessage) {
+    socket.addEventListener('message', (event) => onMessage(event.data));
+  }
+  return socket;
+}
+
+/**
+ * Opens a WebTransport session to a local network endpoint using a pinned self-signed certificate hash.
+ */
+export async function openLocalWebTransport(
+  wtUrl = 'https://192.168.1.100:4433/wt',
+  certSha256Bytes?: BufferSource
+): Promise<WebTransport> {
+  const options: WebTransportOptions = certSha256Bytes
+    ? {
+        serverCertificateHashes: [
+          {
+            algorithm: 'sha-256',
+            value: certSha256Bytes,
+          },
+        ],
+      }
+    : {};
+
+  const transport = new WebTransport(wtUrl, options);
+  await transport.ready;
+  return transport;
+}
