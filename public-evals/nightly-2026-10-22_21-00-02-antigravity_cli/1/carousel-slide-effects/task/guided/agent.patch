     .btn:hover {
       background: #3e2723;
     }
 
+    /* Product Carousel */
+    @keyframes scale-card {
+      0% {
+        scale: 0.75;
+      }
+      50% {
+        scale: 1;
+      }
+      100% {
+        scale: 0.75;
+      }
+    }
+
+    .scroller {
+      display: flex;
+      gap: 24px;
+      overflow-x: scroll;
+      scroll-snap-type: x mandatory;
+      scroll-behavior: smooth;
+      list-style: none;
+      padding-block: 30px;
+      padding-inline: max(20px, calc(50% - 140px));
+      margin-top: 20px;
+      scrollbar-width: thin;
+      scrollbar-color: var(--primary) var(--secondary);
+    }
+
+    .scroller > * {
+      flex: 0 0 280px;
+      scroll-snap-align: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+    }
+
+    .card-img {
+      width: 100%;
+      height: 180px;
+      object-fit: cover;
+      border-radius: 6px;
+      margin-bottom: 15px;
+    }
+
+    .price {
+      font-weight: bold;
+      color: var(--primary);
+      font-size: 1.1rem;
+      margin-top: 8px;
+    }
+
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      @media (prefers-reduced-motion: no-preference) {
+        .scroller > * {
+          animation: scale-card auto linear both;
+          animation-timeline: view(inline);
+        }
+      }
+    }
+
+    :where(a:any-link, button, .scroller):focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .scroller {
+        scroll-behavior: auto;
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
