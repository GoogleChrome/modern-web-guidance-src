+          }
+
+          const hybridIkm = concatBytes(classicalSecret, pqSecretBytes);
+          const contextBytes = concatBytes(
+            ephPubBytes,
+            recipientKeys.classicalPub.bytes,
+            pqCiphertextBytes
+          );
+          return deriveAesGcmKeyFromSecret(hybridIkm, suite, contextBytes);
+        }
+
+        if (suite === 'ML-KEM-768' || suite === 'ML-KEM-1024') {
+          const pqCiphertextBytes = base64ToBytes(envelope.kemCiphertext);
+          if (recipientKeys.pqNative) {
+            if (envelope.usedDirectEncapsulateKey && typeof subtle.decapsulateKey === 'function') {
+              return subtle.decapsulateKey(
+                { name: recipientKeys.kemName },
+                recipientKeys.pqKp.privateKey,
+                pqCiphertextBytes,
+                { name: 'AES-GCM', length: 256 },
+                true,
+                ['encrypt', 'decrypt']
+              );
+            }
+            const decBits = await subtle.decapsulateBits(
+              { name: recipientKeys.kemName },
+              recipientKeys.pqKp.privateKey,
+              pqCiphertextBytes
+            );
+            return deriveAesGcmKeyFromSecret(new Uint8Array(decBits), suite, pqCiphertextBytes);
+          } else {
+            const combined = concatBytes(recipientKeys.pqPub.bytes, pqCiphertextBytes);
+            const pqSecretBytes = new Uint8Array(await subtle.digest('SHA-256', combined));
+            return deriveAesGcmKeyFromSecret(pqSecretBytes, suite, pqCiphertextBytes);
+          }
+        }
+
+        // Classical X25519 or ECDH-P256
+        const ephPubBytes = base64ToBytes(envelope.ephemeralPublicKey);
+        const ephPubKey = await subtle.importKey(
+          envelope.ephemeralPublicKeyFormat || recipientKeys.classicalPub.format,
+          ephPubBytes,
+          recipientKeys.classicalAlg,
+          false,
+          []
+        );
+        const sharedBits = await subtle.deriveBits(
+          { name: recipientKeys.classicalAlg.name, public: ephPubKey },
+          recipientKeys.classicalKp.privateKey,
+          256
+        );
+        const sharedSecret = new Uint8Array(sharedBits);
+        const contextBytes = concatBytes(ephPubBytes, recipientKeys.classicalPub.bytes);
+        return deriveAesGcmKeyFromSecret(sharedSecret, suite, contextBytes);
+      }
+
+      async function encryptDeliveryNote(plaintext, aadText, session) {
+        const iv = window.crypto.getRandomValues(new Uint8Array(12));
+        const encodedPlaintext = new TextEncoder().encode(plaintext);
+        const encodedAad = new TextEncoder().encode(aadText || '');
+
+        const ciphertextBuffer = await subtle.encrypt(
+          {
+            name: 'AES-GCM',
+            iv,
+            additionalData: encodedAad,
+            tagLength: 128
+          },
+          session.aeadKey,
+          encodedPlaintext
+        );
+
+        const ciphertextBytes = new Uint8Array(ciphertextBuffer);
+        return {
+          version: '1.0',
+          suite: session.suite,
+          aead: 'AES-256-GCM',
+          tagLengthBits: 128,
+          aad: aadText || '',
+          iv: bytesToBase64(iv),
+          ephemeralPublicKey: session.ephemeralPublicKeyB64,
+          ephemeralPublicKeyFormat: session.ephemeralPublicKeyFormat || null,
+          kemCiphertext: session.kemCiphertextB64,
+          usedDirectEncapsulateKey: Boolean(session.usedDirectEncapsulateKey),
+          sharedSecretFingerprint: session.fingerprint,
+          ciphertext: bytesToBase64(ciphertextBytes),
+          timestamp: new Date().toISOString()
+        };
+      }
+
+      async function decryptDeliveryNote(envelope, recipientKeys) {
+        const aeadKey = await decapsulateAsRecipient(recipientKeys, envelope);
+        const iv = base64ToBytes(envelope.iv);
+        const ciphertextBytes = base64ToBytes(envelope.ciphertext);
+        const encodedAad = new TextEncoder().encode(envelope.aad || '');
+
+        const decryptedBuffer = await subtle.decrypt(
+          {
+            name: 'AES-GCM',
+            iv,
+            additionalData: encodedAad,
+            tagLength: 128
+          },
+          aeadKey,
+          ciphertextBytes
+        );
+
+        return new TextDecoder().decode(decryptedBuffer);
+      }
+
+      // DOM elements
+      const suiteSelect = document.getElementById('crypto-suite-select');
+      const aadInput = document.getElementById('order-aad-input');
+      const noteInput = document.getElementById('delivery-note-input');
+      const generateKeysBtn = document.getElementById('generate-keys-btn');
+      const establishSecretBtn = document.getElementById('establish-secret-btn');
+      const encryptNoteBtn = document.getElementById('encrypt-note-btn');
+      const decryptNoteBtn = document.getElementById('decrypt-note-btn');
+      const tamperNoteBtn = document.getElementById('tamper-note-btn');
+
+      const activeSuiteLabel = document.getElementById('active-suite-label');
+      const courierPubkeyPreview = document.getElementById('courier-pubkey-preview');
+      const encapsulationPreview = document.getElementById('encapsulation-preview');
+      const sharedSecretFingerprint = document.getElementById('shared-secret-fingerprint');
+      const encryptionStatus = document.getElementById('encryption-status');
+
+      const envelopeOutput = document.getElementById('encrypted-envelope-output');
+      const envelopeIvDisplay = document.getElementById('envelope-iv-display');
+      const envelopeCtDisplay = document.getElementById('envelope-ct-display');
+      const decryptedNoteOutput = document.getElementById('decrypted-note-output');
+      const decryptionStatus = document.getElementById('decryption-status');
+
+      function setBanner(el, message, isError) {
+        el.style.display = 'block';
+        el.className = 'status-banner ' + (isError ? 'error' : 'success');
+        el.textContent = message;
+      }
+
+      function truncateMiddle(str, maxLen) {
+        if (!str || str.length <= maxLen) return str || '-';
+        const half = Math.floor((maxLen - 3) / 2);
+        return str.slice(0, half) + '...' + str.slice(str.length - half);
+      }
+
+      async function handleRotateKeysAndEstablish() {
+        try {
+          const suite = suiteSelect.value;
+          state.suite = suite;
+          activeSuiteLabel.textContent = suite;
+
+          state.recipientKeys = await generateRecipientKeys(suite);
+          const pubB64 = bytesToBase64(state.recipientKeys.publicSummaryBytes);
+          courierPubkeyPreview.textContent = truncateMiddle(pubB64, 68) +
+            ' (' + state.recipientKeys.publicSummaryBytes.byteLength + ' bytes)';
+
+          await handleEstablishSharedSecret();
+        } catch (err) {
+          setBanner(encryptionStatus, 'Key generation failed: ' + err.message, true);
+        }
+      }
+
+      async function handleEstablishSharedSecret() {
+        try {
+          if (!state.recipientKeys || state.recipientKeys.suite !== suiteSelect.value) {
+            state.recipientKeys = await generateRecipientKeys(suiteSelect.value);
+          }
+          state.session = await encapsulateForRecipient(state.recipientKeys);
+
+          const encSummary = state.session.kemCiphertextB64 && state.session.ephemeralPublicKeyB64
+            ? 'X25519 EphPub (' + truncateMiddle(state.session.ephemeralPublicKeyB64, 24) + ') + ML-KEM CT (' + truncateMiddle(state.session.kemCiphertextB64, 28) + ')'
+            : state.session.kemCiphertextB64
+              ? 'ML-KEM Ciphertext (' + truncateMiddle(state.session.kemCiphertextB64, 44) + ')'
+              : 'Ephemeral Public Key (' + truncateMiddle(state.session.ephemeralPublicKeyB64, 44) + ')';
+
+          encapsulationPreview.textContent = encSummary;
+          sharedSecretFingerprint.textContent = state.session.fingerprint + ' (SHA-256/128)';
+
+          await handleEncryptNote();
+        } catch (err) {
+          setBanner(encryptionStatus, 'Key establishment failed: ' + err.message, true);
+        }
+      }
+
+      async function handleEncryptNote() {
+        try {
+          if (!state.session || state.session.suite !== suiteSelect.value) {
+            await handleRotateKeysAndEstablish();
+            return;
+          }
+
+          const plaintext = noteInput.value;
+          const aad = aadInput.value;
+          const envelope = await encryptDeliveryNote(plaintext, aad, state.session);
+          state.lastEnvelope = envelope;
+
+          envelopeOutput.value = JSON.stringify(envelope, null, 2);
+          envelopeIvDisplay.textContent = envelope.iv;
+          envelopeCtDisplay.textContent = truncateMiddle(envelope.ciphertext, 64) +
+            ' (' + base64ToBytes(envelope.ciphertext).byteLength + ' bytes incl. 16-byte GCM tag)';
+
+          setBanner(
+            encryptionStatus,
+            'Delivery note encrypted in-browser with ' + envelope.aead + ' using ' + envelope.suite + ' shared secret.',
+            false
+          );
+
+          await handleDecryptNote();
+        } catch (err) {
+          setBanner(encryptionStatus, 'Encryption error: ' + err.message, true);
+        }
+      }
+
+      async function handleDecryptNote() {
+        try {
+          const envelope = JSON.parse(envelopeOutput.value);
+          const plaintext = await decryptDeliveryNote(envelope, state.recipientKeys);
+          decryptedNoteOutput.textContent = plaintext;
+          setBanner(
+            decryptionStatus,
+            'Authentication tag & AAD verified! Shared secret decapsulated and delivery note decrypted.',
+            false
+          );
+        } catch (err) {
+          decryptedNoteOutput.textContent = '[DECRYPTION REJECTED — AUTHENTICATION TAG VERIFICATION FAILED]';
+          setBanner(
+            decryptionStatus,
+            'Authenticated decryption failed: Ciphertext, IV, AAD, or encapsulated key was tampered with.',
+            true
+          );
+        }
+      }
+
+      function handleTamperEnvelope() {
+        try {
+          const envelope = JSON.parse(envelopeOutput.value);
+          const ctBytes = base64ToBytes(envelope.ciphertext);
+          if (ctBytes.length > 0) {
+            ctBytes[0] ^= 0xff;
+          }
+          envelope.ciphertext = bytesToBase64(ctBytes);
+          envelopeOutput.value = JSON.stringify(envelope, null, 2);
+          handleDecryptNote();
+        } catch (err) {
+          setBanner(decryptionStatus, 'Invalid envelope JSON: ' + err.message, true);
+        }
+      }
+
+      suiteSelect.addEventListener('change', handleRotateKeysAndEstablish);
+      generateKeysBtn.addEventListener('click', handleRotateKeysAndEstablish);
+      establishSecretBtn.addEventListener('click', handleEstablishSharedSecret);
+      encryptNoteBtn.addEventListener('click', handleEncryptNote);
+      decryptNoteBtn.addEventListener('click', handleDecryptNote);
+      tamperNoteBtn.addEventListener('click', handleTamperEnvelope);
+
+      // Expose helper API on window for programmatic testing if needed
+      window.DailyGrindCrypto = {
+        generateRecipientKeys,
+        encapsulateForRecipient,
+        decapsulateAsRecipient,
+        encryptDeliveryNote,
+        decryptDeliveryNote
+      };
+
+      // Initialize on page load
+      handleRotateKeysAndEstablish();
+    })();
+  </script>
 </body>
 
 </html>
