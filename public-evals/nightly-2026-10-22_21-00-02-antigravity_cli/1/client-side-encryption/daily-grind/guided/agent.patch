index 0000000..c2c7d33
--- /dev/null
+++ b/delivery-crypto.js
@@ -0,0 +1,506 @@
+/**
+ * End-to-end envelope encryption module for The Daily Grind Delivery Notes.
+ *
+ * Implements:
+ * - Post-quantum hybrid KEM ('MLKEM768-X25519') and standalone KEMs ('ML-KEM-768', 'ML-KEM-1024')
+ *   with 'ChaCha20-Poly1305' (or 'AES-GCM') AEAD via Web Cryptography API.
+ * - Feature detection using static SubtleCrypto.supports() and graceful fallback to
+ *   ephemeral-static Diffie-Hellman key agreement ('X25519' + 'HKDF' + 'AES-GCM', or 'ECDH' P-256).
+ * - IndexedDB persistence of non-extractable recipient CryptoKeyPair objects.
+ */
+
+export const KEM_PUBLIC_KEY_ALGORITHMS = {
+  1184: 'ML-KEM-768',
+  1216: 'MLKEM768-X25519',
+  1568: 'ML-KEM-1024',
+};
+
+const DB_NAME = 'daily-grind-crypto-store';
+const DB_VERSION = 1;
+const KEY_STORE_NAME = 'courier-keys';
+
+/**
+ * Converts a Uint8Array or ArrayBuffer to a Base64 string.
+ * Uses native Uint8Array.prototype.toBase64() when available, with standard fallback.
+ * @param {Uint8Array | ArrayBuffer} bytes
+ * @returns {string}
+ */
+export function bytesToBase64(bytes) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  if (typeof u8.toBase64 === 'function') {
+    return u8.toBase64();
+  }
+  let binary = '';
+  for (let i = 0; i < u8.byteLength; i++) {
+    binary += String.fromCharCode(u8[i]);
+  }
+  return btoa(binary);
+}
+
+/**
+ * Converts a Base64 string to a Uint8Array.
+ * Uses native Uint8Array.fromBase64() when available, with standard fallback.
+ * @param {string} base64
+ * @returns {Uint8Array}
+ */
+export function base64ToBytes(base64) {
+  const cleaned = base64.trim();
+  if (typeof Uint8Array.fromBase64 === 'function') {
+    return Uint8Array.fromBase64(cleaned);
+  }
+  const binary = atob(cleaned);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+/**
+ * Checks whether the browser supports a specific post-quantum KEM + AEAD envelope suite
+ * via the synchronous static SubtleCrypto.supports() method.
+ * @param {string} [kemAlgorithm='MLKEM768-X25519']
+ * @param {string} [aeadAlgorithm='ChaCha20-Poly1305']
+ * @returns {boolean}
+ */
+export function supportsPostQuantumEnvelope(
+  kemAlgorithm = 'MLKEM768-X25519',
+  aeadAlgorithm = 'ChaCha20-Poly1305',
+) {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('encapsulateKey', kemAlgorithm, aeadAlgorithm)
+  );
+}
+
+/**
+ * Opens the IndexedDB database for storing non-extractable CryptoKeyPair objects.
+ * @returns {Promise<IDBDatabase>}
+ */
+function openKeyDatabase() {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open(DB_NAME, DB_VERSION);
+    request.onupgradeneeded = () => {
+      const db = request.result;
+      if (!db.objectStoreNames.contains(KEY_STORE_NAME)) {
+        db.createObjectStore(KEY_STORE_NAME);
+      }
+    };
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+/**
+ * Persists the non-extractable recipient key record in IndexedDB via structured cloning.
+ * @param {string} recordKey
+ * @param {{ suite: string, kemAlgorithm: string, aeadAlgorithm: string, keyPair: CryptoKeyPair }} record
+ * @returns {Promise<void>}
+ */
+export async function saveRecipientKeyRecord(recordKey, record) {
+  try {
+    const db = await openKeyDatabase();
+    await new Promise((resolve, reject) => {
+      const tx = db.transaction(KEY_STORE_NAME, 'readwrite');
+      const store = tx.objectStore(KEY_STORE_NAME);
+      store.put(record, recordKey);
+      tx.oncomplete = () => resolve();
+      tx.onerror = () => reject(tx.error);
+    });
+    db.close();
+  } catch {
+    // Ignore IndexedDB errors in restricted contexts
+  }
+}
+
+/**
+ * Loads a previously persisted recipient key record from IndexedDB.
+ * @param {string} recordKey
+ * @returns {Promise<{ suite: string, kemAlgorithm: string, aeadAlgorithm: string, keyPair: CryptoKeyPair } | null>}
+ */
+export async function loadRecipientKeyRecord(recordKey) {
+  try {
+    const db = await openKeyDatabase();
+    const result = await new Promise((resolve, reject) => {
+      const tx = db.transaction(KEY_STORE_NAME, 'readonly');
+      const store = tx.objectStore(KEY_STORE_NAME);
+      const req = store.get(recordKey);
+      req.onsuccess = () => resolve(req.result || null);
+      req.onerror = () => reject(req.error);
+    });
+    db.close();
+    return result;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Generates or restores a recipient key pair and exports its public key bytes.
+ * Uses 'MLKEM768-X25519' by default when supported, or falls back to 'X25519' key agreement.
+ *
+ * @param {object} [options]
+ * @param {string} [options.preferredKem='MLKEM768-X25519'] - 'MLKEM768-X25519', 'ML-KEM-768', 'ML-KEM-1024', or 'X25519'
+ * @param {string} [options.preferredAead='ChaCha20-Poly1305'] - 'ChaCha20-Poly1305' or 'AES-GCM'
+ * @param {boolean} [options.forceRegenerate=false]
+ * @returns {Promise<{
+ *   suite: string,
+ *   kemAlgorithm: string,
+ *   aeadAlgorithm: string,
+ *   keyPair: CryptoKeyPair,
+ *   publicKeyBytes: Uint8Array,
+ *   isPostQuantum: boolean
+ * }>}
+ */
+export async function generateRecipientKeys({
+  preferredKem = 'MLKEM768-X25519',
+  preferredAead = 'ChaCha20-Poly1305',
+  forceRegenerate = false,
+} = {}) {
+  const canUseKem =
+    preferredKem !== 'X25519' &&
+    supportsPostQuantumEnvelope(preferredKem, preferredAead);
+
+  const targetKem = canUseKem ? preferredKem : 'X25519';
+  const targetAead = canUseKem
+    ? preferredAead
+    : typeof globalThis.SubtleCrypto?.supports === 'function' &&
+        SubtleCrypto.supports('encrypt', {
+          name: 'ChaCha20-Poly1305',
+          iv: new Uint8Array(12),
+        }) &&
+        preferredAead === 'ChaCha20-Poly1305'
+      ? 'ChaCha20-Poly1305'
+      : 'AES-GCM';
+
+  const storageId = `recipient-kem-key:${targetKem}:${targetAead}`;
+
+  if (!forceRegenerate) {
+    const saved = await loadRecipientKeyRecord(storageId);
+    if (saved && saved.keyPair?.publicKey && saved.keyPair?.privateKey) {
+      try {
+        const format = targetKem === 'X25519' ? 'raw' : 'raw-public';
+        const publicKeyBytes = new Uint8Array(
+          await crypto.subtle.exportKey(format, saved.keyPair.publicKey),
+        );
+        return {
+          ...saved,
+          publicKeyBytes,
+          isPostQuantum: targetKem !== 'X25519',
+        };
+      } catch {
+        // Proceed to generate fresh keys if stored key cannot be exported
+      }
+    }
+  }
+
+  if (canUseKem) {
+    const keyPair = await crypto.subtle.generateKey(
+      targetKem,
+      false,
+      ['encapsulateKey', 'decapsulateKey'],
+    );
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+    );
+    const suite = `${targetKem}+${targetAead}`;
+    const record = {
+      suite,
+      kemAlgorithm: targetKem,
+      aeadAlgorithm: targetAead,
+      keyPair,
+    };
+    await saveRecipientKeyRecord(storageId, record);
+    return {
+      ...record,
+      publicKeyBytes,
+      isPostQuantum: true,
+    };
+  }
+
+  // Classical fallback: X25519 key agreement + HKDF + AES-GCM
+  const keyPair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw', keyPair.publicKey),
+  );
+  const suite = 'X25519+HKDF+AES-GCM';
+  const record = {
+    suite,
+    kemAlgorithm: 'X25519',
+    aeadAlgorithm: 'AES-GCM',
+    keyPair,
+  };
+  await saveRecipientKeyRecord(storageId, record);
+  return {
+    ...record,
+    publicKeyBytes,
+    isPostQuantum: false,
+  };
+}
+
+/**
+ * Derives a 256-bit AES-GCM key via X25519 + HKDF-SHA256 for the classical fallback path.
+ * @param {CryptoKey} privateKey
+ * @param {CryptoKey} peerPublicKey
+ * @param {Uint8Array} [infoBytes]
+ * @returns {Promise<CryptoKey>}
+ */
+async function deriveFallbackAesKey(
+  privateKey,
+  peerPublicKey,
+  infoBytes = new Uint8Array(0),
+) {
+  const sharedSecret = await crypto.subtle.deriveBits(
+    { name: 'X25519', public: peerPublicKey },
+    privateKey,
+    256,
+  );
+  const hkdfKey = await crypto.subtle.importKey(
+    'raw',
+    sharedSecret,
+    'HKDF',
+    false,
+    ['deriveKey'],
+  );
+  return crypto.subtle.deriveKey(
+    {
+      name: 'HKDF',
+      hash: 'SHA-256',
+      salt: new Uint8Array(32),
+      info: infoBytes,
+    },
+    hkdfKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt'],
+  );
+}
+
+/**
+ * Derives an AEAD key from an encapsulated HKDF base key when domain separation is enabled.
+ * @param {CryptoKey} hkdfBaseKey
+ * @param {string} aeadAlgorithm
+ * @param {Uint8Array} infoBytes
+ * @returns {Promise<CryptoKey>}
+ */
+async function deriveDomainSeparatedKey(hkdfBaseKey, aeadAlgorithm, infoBytes) {
+  const derivedKeyType =
+    aeadAlgorithm === 'ChaCha20-Poly1305'
+      ? { name: 'ChaCha20-Poly1305' }
+      : { name: 'AES-GCM', length: 256 };
+
+  return crypto.subtle.deriveKey(
+    {
+      name: 'HKDF',
+      hash: 'SHA-256',
+      salt: new Uint8Array(32),
+      info: infoBytes,
+    },
+    hkdfBaseKey,
+    derivedKeyType,
+    false,
+    ['encrypt', 'decrypt'],
+  );
+}
+
+/**
+ * Imports a recipient public key (or accepts a CryptoKey) and encapsulates a fresh
+ * one-time shared AEAD key and ciphertext capsule.
+ *
+ * @param {CryptoKey | Uint8Array | ArrayBuffer} recipientPublicKeyOrBytes
+ * @param {Uint8Array} [infoBytes]
+ * @param {object} [options]
+ * @param {string} [options.aeadAlgorithm='ChaCha20-Poly1305']
+ * @param {boolean} [options.useHkdfDomainSeparation=false]
+ * @returns {Promise<{ sharedKey: CryptoKey, capsuleBytes: Uint8Array, kemAlgorithm: string, aeadAlgorithm: string }>}
+ */
+export async function encapsulateEnvelopeKey(
+  recipientPublicKeyOrBytes,
+  infoBytes = new Uint8Array(0),
+  { aeadAlgorithm = 'ChaCha20-Poly1305', useHkdfDomainSeparation = false } = {},
+) {
+  const pubKey =
+    recipientPublicKeyOrBytes instanceof CryptoKey
+      ? recipientPublicKeyOrBytes
+      : await (() => {
+          const bytes =
+            recipientPublicKeyOrBytes instanceof Uint8Array
+              ? recipientPublicKeyOrBytes
+              : new Uint8Array(recipientPublicKeyOrBytes);
+          const kemName = KEM_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+          return kemName
+            ? crypto.subtle.importKey('raw-public', bytes, kemName, true, ['encapsulateKey'])
+            : crypto.subtle.importKey('raw', bytes, 'X25519', true, []);
+        })();
+
+  if (pubKey.algorithm.name !== 'X25519') {
+    const targetSharedAlg =
+      aeadAlgorithm === 'AES-GCM'
+        ? { name: 'AES-GCM', length: 256 }
+        : 'ChaCha20-Poly1305';
+
+    if (useHkdfDomainSeparation && infoBytes.byteLength > 0) {
+      const { sharedKey: hkdfBaseKey, ciphertext } =
+        await crypto.subtle.encapsulateKey(
+          pubKey.algorithm.name,
+          pubKey,
+          'HKDF',
+          false,
+          ['deriveKey'],
+        );
+      const sharedKey = await deriveDomainSeparatedKey(
+        hkdfBaseKey,
+        aeadAlgorithm,
+        infoBytes,
+      );
+      return {
+        sharedKey,
+        capsuleBytes: new Uint8Array(ciphertext),
+        kemAlgorithm: pubKey.algorithm.name,
+        aeadAlgorithm: sharedKey.algorithm.name,
+      };
+    }
+
+    const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+      pubKey.algorithm.name,
+      pubKey,
+      targetSharedAlg,
+      false,
+      ['encrypt', 'decrypt'],
+    );
+    return {
+      sharedKey,
+      capsuleBytes: new Uint8Array(ciphertext),
+      kemAlgorithm: pubKey.algorithm.name,
+      aeadAlgorithm: sharedKey.algorithm.name,
+    };
+  }
+
+  // Classical fallback: generate ephemeral X25519 key pair and send ephemeral public key as capsule
+  const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  const capsuleBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw', ephemeral.publicKey),
+  );
+  const sharedKey = await deriveFallbackAesKey(ephemeral.privateKey, pubKey, infoBytes);
+  return {
+    sharedKey,
+    capsuleBytes,
+    kemAlgorithm: 'X25519',
+    aeadAlgorithm: 'AES-GCM',
+  };
+}
+
+/**
+ * Decapsulates the ciphertext capsule using the recipient's private key to recover the AEAD key.
+ *
+ * @param {CryptoKey} recipientPrivateKey
+ * @param {Uint8Array} capsuleBytes
+ * @param {Uint8Array} [infoBytes]
+ * @param {object} [options]
+ * @param {string} [options.aeadAlgorithm='ChaCha20-Poly1305']
+ * @param {boolean} [options.useHkdfDomainSeparation=false]
+ * @returns {Promise<CryptoKey>}
+ */
+export async function decapsulateEnvelopeKey(
+  recipientPrivateKey,
+  capsuleBytes,
+  infoBytes = new Uint8Array(0),
+  { aeadAlgorithm = 'ChaCha20-Poly1305', useHkdfDomainSeparation = false } = {},
+) {
+  if (recipientPrivateKey.algorithm.name !== 'X25519') {
+    const targetSharedAlg =
+      aeadAlgorithm === 'AES-GCM'
+        ? { name: 'AES-GCM', length: 256 }
+        : 'ChaCha20-Poly1305';
+
+    if (useHkdfDomainSeparation && infoBytes.byteLength > 0) {
+      const hkdfBaseKey = await crypto.subtle.decapsulateKey(
+        recipientPrivateKey.algorithm.name,
+        recipientPrivateKey,
+        capsuleBytes,
+        'HKDF',
+        false,
+        ['deriveKey'],
+      );
+      return deriveDomainSeparatedKey(hkdfBaseKey, aeadAlgorithm, infoBytes);
+    }
+
+    return crypto.subtle.decapsulateKey(
+      recipientPrivateKey.algorithm.name,
+      recipientPrivateKey,
+      capsuleBytes,
+      targetSharedAlg,
+      false,
+      ['encrypt', 'decrypt'],
+    );
+  }
+
+  const ephemeralPubKey = await crypto.subtle.importKey(
+    'raw',
+    capsuleBytes,
+    'X25519',
+    true,
+    [],
+  );
+  return deriveFallbackAesKey(recipientPrivateKey, ephemeralPubKey, infoBytes);
+}
+
+/**
+ * Encrypts UTF-8 text with an AEAD CryptoKey ('ChaCha20-Poly1305' or 'AES-GCM').
+ * Always generates a fresh 12-byte (96-bit) cryptographically random IV per message.
+ *
+ * @param {CryptoKey} key
+ * @param {string} plaintext
+ * @param {Uint8Array} [additionalData]
+ * @returns {Promise<{ iv: Uint8Array, ciphertext: Uint8Array }>}
+ */
+export async function encryptMessage(
+  key,
+  plaintext,
+  additionalData = new Uint8Array(0),
+) {
+  // Always generate a fresh 12-byte (96-bit) IV per message
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const encoded = new TextEncoder().encode(plaintext);
+
+  const ciphertextBuffer = await crypto.subtle.encrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    encoded,
+  );
+
+  return { iv, ciphertext: new Uint8Array(ciphertextBuffer) };
+}
+
+/**
+ * Decrypts and authenticates an AEAD payload. Throws OperationError if ciphertext
+ * or additionalData has been tampered with.
+ *
+ * @param {CryptoKey} key
+ * @param {Uint8Array} iv
+ * @param {Uint8Array} ciphertext
+ * @param {Uint8Array} [additionalData]
+ * @returns {Promise<string>}
+ */
+export async function decryptMessage(
+  key,
+  iv,
+  ciphertext,
+  additionalData = new Uint8Array(0),
+) {
+  const plaintextBuffer = await crypto.subtle.decrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    ciphertext,
+  );
+
+  return new TextDecoder().decode(plaintextBuffer);
+}
