+        customMessage: 'Gate PIN must be 3–16 digits or # / * keypad characters.',
+      },
+      {
+        input: document.getElementById('delivery-instructions'),
+        errorEl: document.getElementById('delivery-instructions-error'),
+        customMessage: 'Please enter confidential delivery instructions (at least 5 characters).',
+      },
+    ];
+
+    for (const { input, errorEl, customMessage } of validatedFields) {
+      input.addEventListener('invalid', () => {
+        input.setCustomValidity(customMessage);
+      });
+      // Reset error state on active typing (input)
+      input.addEventListener('input', () => {
+        input.setCustomValidity('');
+        errorEl.textContent = '';
+      });
+      // Validate on blur when user exits field
+      input.addEventListener('blur', () => {
+        input.setCustomValidity('');
+        if (!input.checkValidity()) {
+          input.setCustomValidity(customMessage);
+          errorEl.textContent = input.validationMessage;
+        } else {
+          errorEl.textContent = '';
+        }
+      });
+    }
+
+    async function initializeCourierKeys(forceRegenerate = false) {
+      const preferredKem = getSelectedKem();
+      const preferredAead = getSelectedAead();
+
+      try {
+        currentCourierKeys = await generateRecipientKeys({
+          preferredKem,
+          preferredAead,
+          forceRegenerate,
+        });
+
+        const { suite, publicKeyBytes, isPostQuantum, kemAlgorithm } = currentCourierKeys;
+        const pqSupported = supportsPostQuantumEnvelope();
+
+        if (isPostQuantum) {
+          suiteBadge.textContent = `Post-Quantum Hybrid Active: ${suite}`;
+          suiteBadge.dataset.fallback = 'false';
+        } else {
+          suiteBadge.textContent = pqSupported
+            ? `Classical Key Agreement Mode: ${suite}`
+            : `Classical Fallback Active: ${suite}`;
+          suiteBadge.dataset.fallback = 'true';
+        }
+
+        metricSuite.textContent = suite;
+        metricPubkeySize.textContent = `${publicKeyBytes.byteLength} bytes (${kemAlgorithm === 'X25519' ? 'raw' : 'raw-public'})`;
+        courierPublicKeyCode.textContent = bytesToBase64(publicKeyBytes);
+      } catch (err) {
+        setBanner(`Key initialization error: ${err.message}`, 'error');
+      }
+    }
+
+    async function handleEncryptNote(event) {
+      if (event) {
+        event.preventDefault();
+      }
+
+      // Check form validity on submit
+      let firstInvalid = null;
+      for (const { input, errorEl, customMessage } of validatedFields) {
+        input.setCustomValidity('');
+        if (!input.checkValidity()) {
+          input.setCustomValidity(customMessage);
+          errorEl.textContent = input.validationMessage;
+          if (!firstInvalid) firstInvalid = input;
+        } else {
+          errorEl.textContent = '';
+        }
+      }
+
+      if (firstInvalid) {
+        firstInvalid.focus();
+        setBanner('Please resolve the highlighted form fields before encrypting.', 'error');
+        return;
+      }
+
+      encryptSubmitBtn.disabled = true;
+
+      try {
+        await initializeCourierKeys(false);
+
+        const orderReference = document.getElementById('order-reference').value.trim();
+        const recipientName = document.getElementById('recipient-name').value.trim();
+        const streetAddress = document.getElementById('street-address').value.trim();
+        const gatePin = document.getElementById('gate-pin').value.trim();
+        const instructions = document.getElementById('delivery-instructions').value.trim();
+
+        const payloadObject = {
+          recipientName,
+          streetAddress,
+          gatePin: gatePin || 'None',
+          instructions,
+          timestamp: new Date().toISOString(),
+        };
+
+        const plaintextJson = JSON.stringify(payloadObject);
+        const aadBytes = new TextEncoder().encode(`daily-grind-order:${orderReference}`);
+        const hkdfInfoBytes = new TextEncoder().encode('daily-grind-delivery-note-v1');
+
+        // Step 3: Sender imports courier's raw-public key bytes and encapsulates a fresh shared secret
+        const {
+          sharedKey: senderKey,
+          capsuleBytes,
+          kemAlgorithm,
+          aeadAlgorithm,
+        } = await encapsulateEnvelopeKey(
+          currentCourierKeys.publicKeyBytes,
+          hkdfInfoBytes,
+          { aeadAlgorithm: currentCourierKeys.aeadAlgorithm },
+        );
+
+        // Step 4: Encrypt note payload with a fresh 12-byte random IV and AAD binding
+        const { iv, ciphertext } = await encryptMessage(
+          senderKey,
+          plaintextJson,
+          aadBytes,
+        );
+
+        latestEnvelope = {
+          version: 'daily-grind-kem-v1',
+          suite: `${kemAlgorithm}+${aeadAlgorithm}`,
+          kemAlgorithm,
+          aeadAlgorithm,
+          orderReference,
+          aadBase64: bytesToBase64(aadBytes),
+          capsuleBase64: bytesToBase64(capsuleBytes),
+          ivBase64: bytesToBase64(iv),
+          ciphertextBase64: bytesToBase64(ciphertext),
+        };
+
+        metricCapsuleSize.textContent = `${capsuleBytes.byteLength} bytes`;
+        metricCiphertextSize.textContent = `12B IV + ${ciphertext.byteLength}B`;
+
+        envelopeJsonCode.textContent = JSON.stringify(latestEnvelope, null, 2);
+        decryptVerifyBtn.disabled = false;
+        tamperTestBtn.disabled = false;
+        decryptedResultCard.hidden = true;
+
+        setBanner(
+          `Encrypted note with ${latestEnvelope.suite}. Generated ${capsuleBytes.byteLength}-byte capsule and 12-byte random IV.`,
+          'success',
+        );
+      } catch (err) {
+        setBanner(`Encryption failed: ${err.message}`, 'error');
+      } finally {
+        encryptSubmitBtn.disabled = false;
+      }
+    }
+
+    async function handleDecryptVerify() {
+      if (!latestEnvelope || !currentCourierKeys) return;
+
+      try {
+        const capsuleBytes = base64ToBytes(latestEnvelope.capsuleBase64);
+        const ivBytes = base64ToBytes(latestEnvelope.ivBase64);
+        const ciphertextBytes = base64ToBytes(latestEnvelope.ciphertextBase64);
+        const aadBytes = base64ToBytes(latestEnvelope.aadBase64);
+        const hkdfInfoBytes = new TextEncoder().encode('daily-grind-delivery-note-v1');
+
+        // Courier decapsulates capsule using non-extractable private key to recover AEAD key
+        const recipientKey = await decapsulateEnvelopeKey(
+          currentCourierKeys.keyPair.privateKey,
+          capsuleBytes,
+          hkdfInfoBytes,
+          { aeadAlgorithm: latestEnvelope.aeadAlgorithm },
+        );
+
+        // Courier decrypts and verifies authentication tag + AAD
+        const decryptedJson = await decryptMessage(
+          recipientKey,
+          ivBytes,
+          ciphertextBytes,
+          aadBytes,
+        );
+
+        const parsed = JSON.parse(decryptedJson);
+
+        decryptedAad.textContent = latestEnvelope.orderReference;
+        decryptedRecipient.textContent = parsed.recipientName;
+        decryptedAddress.textContent = parsed.streetAddress;
+        decryptedPin.textContent = parsed.gatePin;
+        decryptedInstructions.textContent = parsed.instructions;
+        decryptedResultCard.hidden = false;
+
+        setBanner(
+          `Decapsulation & AEAD authentication succeeded (${latestEnvelope.suite}). Integrity verified.`,
+          'success',
+        );
+      } catch (err) {
+        decryptedResultCard.hidden = true;
+        setBanner(
+          `AEAD Authentication Rejected (${err.name || 'OperationError'}): Ciphertext or associated data was tampered with!`,
+          'error',
+        );
+      }
+    }
+
+    async function handleTamperTest() {
+      if (!latestEnvelope) return;
+      const tamperedBytes = base64ToBytes(latestEnvelope.ciphertextBase64);
+      if (tamperedBytes.byteLength > 0) {
+        tamperedBytes[0] ^= 0xff;
+        latestEnvelope.ciphertextBase64 = bytesToBase64(tamperedBytes);
+        envelopeJsonCode.textContent = JSON.stringify(latestEnvelope, null, 2);
+        await handleDecryptVerify();
+      }
+    }
+
+    form.addEventListener('submit', handleEncryptNote);
+
+    for (const radio of form.querySelectorAll('input[type="radio"]')) {
+      radio.addEventListener('change', async () => {
+        await initializeCourierKeys(false);
+        await handleEncryptNote();
+      });
+    }
+
+    rotateKeysBtn.addEventListener('click', async () => {
+      await initializeCourierKeys(true);
+      await handleEncryptNote();
+    });
+
+    decryptVerifyBtn.addEventListener('click', handleDecryptVerify);
+    tamperTestBtn.addEventListener('click', handleTamperTest);
+
+    // Initialize courier key pair and encrypt the default sample note on load
+    (async () => {
+      await initializeCourierKeys(false);
+      await handleEncryptNote();
+    })();
+  </script>
+
 </body>
 
 </html>
