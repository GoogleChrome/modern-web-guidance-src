+  <script>
+    const canvas = document.getElementById('canvas');
+    const ctx = canvas.getContext('2d');
+    const cupUi = document.getElementById('cup-ui');
+    const nameInput = document.getElementById('customer-name');
+    const milkSelect = document.getElementById('milk-option');
+    const syrupSelect = document.getElementById('syrup-option');
+    const orderBtn = document.getElementById('place-order-btn');
+    const orderStatus = document.getElementById('order-status');
+
+    function updateOrderSummary() {
+      const name = nameInput.value.trim() || 'Guest';
+      const milk = milkSelect.value;
+      const syrup = syrupSelect.value;
+      const syrupText = syrup === 'None' ? 'Unflavored' : syrup;
+      orderStatus.textContent = `${name}'s ${syrupText} ${milk}`;
+      requestCanvasPaint();
+    }
+
+    nameInput.addEventListener('input', updateOrderSummary);
+    milkSelect.addEventListener('change', updateOrderSummary);
+    syrupSelect.addEventListener('change', updateOrderSummary);
+    orderBtn.addEventListener('click', () => {
+      const name = nameInput.value.trim() || 'Guest';
+      orderStatus.textContent = `Order ready for ${name}!`;
+      requestCanvasPaint();
+    });
+
+    function drawCoffeeCup(w, h) {
+      const cx = w / 2;
+
+      // Subtle warm background circle behind the cup
+      ctx.save();
+      ctx.fillStyle = '#f5ebe6';
+      ctx.beginPath();
+      ctx.arc(cx, h / 2 + 10, 210, 0, Math.PI * 2);
+      ctx.fill();
+
+      // Steam wisps
+      ctx.strokeStyle = '#d7ccc8';
+      ctx.lineWidth = 3;
+      ctx.lineCap = 'round';
+      [-35, 0, 35].forEach((offset, idx) => {
+        ctx.beginPath();
+        ctx.moveTo(cx + offset, 62);
+        ctx.bezierCurveTo(cx + offset - 12, 45, cx + offset + 12, 32, cx + offset, 16 + idx * 3);
+        ctx.stroke();
+      });
+
+      // Cup shadow
+      ctx.fillStyle = 'rgba(62, 39, 35, 0.14)';
+      ctx.beginPath();
+      ctx.ellipse(cx, 482, 115, 16, 0, 0, Math.PI * 2);
+      ctx.fill();
+
+      // Cup body (trapezoid with rounded bottom)
+      const topY = 98;
+      const bottomY = 475;
+      const topHalfW = 148;
+      const bottomHalfW = 105;
+
+      ctx.fillStyle = '#fffdf9';
+      ctx.strokeStyle = '#4e342e';
+      ctx.lineWidth = 4;
+      ctx.beginPath();
+      ctx.moveTo(cx - topHalfW, topY);
+      ctx.lineTo(cx + topHalfW, topY);
+      ctx.lineTo(cx + bottomHalfW, bottomY);
+      ctx.quadraticCurveTo(cx, bottomY + 14, cx - bottomHalfW, bottomY);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+
+      // Cardboard sleeve band on the cup
+      const sleeveTopY = 145;
+      const sleeveBottomY = 430;
+      const topT = (sleeveTopY - topY) / (bottomY - topY);
+      const botT = (sleeveBottomY - topY) / (bottomY - topY);
+      const sleeveTopW = topHalfW - (topHalfW - bottomHalfW) * topT;
+      const sleeveBotW = topHalfW - (topHalfW - bottomHalfW) * botT;
+
+      ctx.fillStyle = '#c89f7c';
+      ctx.strokeStyle = '#4e342e';
+      ctx.lineWidth = 3;
+      ctx.beginPath();
+      ctx.moveTo(cx - sleeveTopW, sleeveTopY);
+      ctx.lineTo(cx + sleeveTopW, sleeveTopY);
+      ctx.lineTo(cx + sleeveBotW, sleeveBottomY);
+      ctx.lineTo(cx - sleeveBotW, sleeveBottomY);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+
+      // Cup lid
+      ctx.fillStyle = '#4e342e';
+      ctx.beginPath();
+      ctx.roundRect(cx - topHalfW - 14, topY - 22, (topHalfW + 14) * 2, 24, 8);
+      ctx.fill();
+
+      ctx.fillStyle = '#3e2723';
+      ctx.beginPath();
+      ctx.roundRect(cx - topHalfW + 8, topY - 36, (topHalfW - 8) * 2, 16, [8, 8, 0, 0]);
+      ctx.fill();
+
+      ctx.restore();
+    }
+
+    function renderCanvas() {
+      const dpr = window.devicePixelRatio || 1;
+      const cssWidth = canvas.clientWidth || 560;
+      const cssHeight = canvas.clientHeight || 520;
+
+      if (typeof ctx.reset === 'function') {
+        ctx.reset();
+      } else {
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+      }
+
+      ctx.scale(dpr, dpr);
+
+      drawCoffeeCup(cssWidth, cssHeight);
+
+      // Center the interactive HTML label inside the coffee cup sleeve
+      const uiWidth = cupUi.offsetWidth || 220;
+      const uiHeight = cupUi.offsetHeight || 260;
+      const uiX = Math.round((cssWidth - uiWidth) / 2);
+      const uiY = Math.round(155 + Math.max(0, (265 - uiHeight) / 2));
+
+      let drawFn = null;
+      if (typeof ctx.drawElementImage === 'function') {
+        drawFn = ctx.drawElementImage.bind(ctx);
+      } else if (typeof ctx.drawElement === 'function') {
+        drawFn = ctx.drawElement.bind(ctx);
+      }
+
+      if (drawFn) {
+        const transform = drawFn(cupUi, uiX, uiY);
+        if (transform) {
+          cupUi.style.transform = transform.toString();
+          if (typeof canvas.updateElementGeometry === 'function') {
+            canvas.updateElementGeometry(cupUi, { canvasTransform: transform });
+          }
+        } else {
+          cupUi.style.transform = `translate(${uiX}px, ${uiY}px)`;
+        }
+      } else {
+        cupUi.style.transform = `translate(${uiX}px, ${uiY}px)`;
+      }
+    }
+
+    function requestCanvasPaint() {
+      if (typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      } else {
+        renderCanvas();
+      }
+    }
+
+    canvas.onpaint = () => {
+      renderCanvas();
+    };
+
+    // Scale canvas properly to prevent blurriness on high-resolution displays
+    const resizeObserver = new ResizeObserver((entries) => {
+      for (const entry of entries) {
+        const dpr = window.devicePixelRatio || 1;
+        let width;
+        let height;
+        if (entry.devicePixelContentBoxSize && entry.devicePixelContentBoxSize[0]) {
+          width = entry.devicePixelContentBoxSize[0].inlineSize;
+          height = entry.devicePixelContentBoxSize[0].blockSize;
+        } else {
+          width = Math.round(entry.contentRect.width * dpr);
+          height = Math.round(entry.contentRect.height * dpr);
+        }
+
+        if (width > 0 && height > 0 && (canvas.width !== width || canvas.height !== height)) {
+          canvas.width = width;
+          canvas.height = height;
+        }
+        requestCanvasPaint();
+      }
+    });
+
+    try {
+      resizeObserver.observe(canvas, { box: 'device-pixel-content-box' });
+    } catch (e) {
+      resizeObserver.observe(canvas);
+    }
+
+    renderCanvas();
+  </script>
+
