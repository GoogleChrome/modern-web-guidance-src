+  <script>
+    const canvas = document.getElementById("canvas");
+    const ctx = canvas.getContext("2d");
+    const uiElement = document.getElementById("coffee-customizer");
+    const canvasWrapper = document.getElementById("canvas-wrapper");
+    const nameInput = document.getElementById("customer-name");
+    const milkSelect = document.getElementById("milk-select");
+    const syrupSelect = document.getElementById("syrup-select");
+    const orderSummary = document.getElementById("order-summary");
+    const brewBtn = document.getElementById("brew-btn");
+
+    let orderConfirmed = false;
+
+    function getOrderState() {
+      const name = (nameInput.value || "").trim() || "Guest";
+      const milkOption = milkSelect.options[milkSelect.selectedIndex];
+      const syrupOption = syrupSelect.options[syrupSelect.selectedIndex];
+      return {
+        name,
+        milk: milkSelect.value,
+        milkColor: milkOption ? milkOption.getAttribute("data-color") : "#e6d7c3",
+        syrup: syrupSelect.value,
+        syrupColor: syrupOption ? syrupOption.getAttribute("data-accent") : "#c87d32"
+      };
+    }
+
+    function updateSummaryText() {
+      const state = getOrderState();
+      const statusSuffix = orderConfirmed ? " — Ready at Counter!" : "";
+      orderSummary.innerHTML = `Cup for <strong>${state.name}</strong>: ${state.milk} + ${state.syrup}${statusSuffix}`;
+    }
+
+    function drawCoffeeCup(context, width, height) {
+      const state = getOrderState();
+      const scaleX = width / 560;
+      const scaleY = height / 540;
+      const scale = Math.min(scaleX, scaleY);
+
+      context.save();
+      context.scale(scaleX, scaleY);
+
+      // Background card glow
+      const bgGrad = context.createRadialGradient(280, 270, 40, 280, 270, 280);
+      bgGrad.addColorStop(0, "#fffdf9");
+      bgGrad.addColorStop(1, "#f5ebe1");
+      context.fillStyle = bgGrad;
+      context.fillRect(0, 0, 560, 540);
+
+      // Steam wisps
+      context.strokeStyle = "rgba(141, 110, 99, 0.35)";
+      context.lineWidth = 3;
+      context.lineCap = "round";
+      [-45, 0, 45].forEach((offset, idx) => {
+        context.beginPath();
+        context.moveTo(280 + offset, 52);
+        context.bezierCurveTo(
+          265 + offset, 34 - idx * 3,
+          295 + offset, 22 - idx * 3,
+          278 + offset, 8
+        );
+        context.stroke();
+      });
+
+      // Drop shadow under cup
+      context.fillStyle = "rgba(62, 39, 35, 0.14)";
+      context.beginPath();
+      context.ellipse(280, 505, 130, 18, 0, 0, Math.PI * 2);
+      context.fill();
+
+      // Cup body (tapered trapezoid)
+      context.beginPath();
+      context.moveTo(115, 110);
+      context.lineTo(445, 110);
+      context.lineTo(395, 495);
+      context.quadraticCurveTo(280, 512, 165, 495);
+      context.closePath();
+      context.fillStyle = state.milkColor;
+      context.fill();
+      context.lineWidth = 3;
+      context.strokeStyle = "#5d4037";
+      context.stroke();
+
+      // Syrup flavor band near top of cup
+      context.beginPath();
+      context.moveTo(120, 145);
+      context.lineTo(440, 145);
+      context.lineTo(434, 172);
+      context.lineTo(126, 172);
+      context.closePath();
+      context.fillStyle = state.syrupColor;
+      context.fill();
+
+      // Kraft cardboard sleeve backdrop behind the interactive HTML layer
+      context.beginPath();
+      context.moveTo(128, 180);
+      context.lineTo(432, 180);
+      context.lineTo(404, 435);
+      context.lineTo(156, 435);
+      context.closePath();
+      context.fillStyle = "#c8a98e";
+      context.fill();
+      context.lineWidth = 2;
+      context.strokeStyle = "#8d6e63";
+      context.stroke();
+
+      // Coffee cup lid
+      context.fillStyle = "#4e342e";
+      context.beginPath();
+      context.roundRect(100, 82, 360, 30, 10);
+      context.fill();
+
+      context.fillStyle = "#3e2723";
+      context.beginPath();
+      context.roundRect(122, 62, 316, 22, [10, 10, 2, 2]);
+      context.fill();
+
+      context.restore();
+    }
+
+    // Render HTML content inside the canvas on paint events
+    canvas.onpaint = () => {
+      ctx.reset();
+      drawCoffeeCup(ctx, canvas.width, canvas.height);
+
+      const uiX = Math.max(0, Math.round((canvas.clientWidth - uiElement.offsetWidth) / 2)) || 150;
+      const uiY = Math.max(0, Math.round((canvas.clientHeight - uiElement.offsetHeight) / 2) + 20) || 165;
+
+      // Draw the drawable HTML element onto the canvas and automatically sync geometry
+      ctx.drawElementImage(uiElement, uiX, uiY);
+    };
+
+    function requestCanvasUpdate() {
+      updateSummaryText();
+      if ("content" in HTMLCanvasElement.prototype) {
+        if (typeof canvas.requestPaint === "function") {
+          canvas.requestPaint();
+        }
+      } else {
+        drawCoffeeCup(ctx, canvas.width, canvas.height);
+      }
+    }
+
+    // Check browser support for the HTML-in-Canvas API
+    if ("content" in HTMLCanvasElement.prototype) {
+      if (typeof canvas.requestPaint === "function") {
+        canvas.requestPaint();
+      }
+    } else {
+      // Fallback strategy: position interactive HTML on top of the canvas with CSS
+      canvasWrapper.classList.add("fallback-mode");
+      drawCoffeeCup(ctx, canvas.width, canvas.height);
+    }
+
+    // Scale canvas grid to match the device scale factor to prevent blurriness
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+
+      if ("content" in HTMLCanvasElement.prototype && typeof canvas.requestPaint === "function") {
+        canvas.requestPaint();
+      } else {
+        drawCoffeeCup(ctx, canvas.width, canvas.height);
+      }
+    });
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== "undefined" &&
+      "devicePixelContentBoxSize" in ResizeObserverEntry.prototype;
+    const options = supportsDevicePixelContentBox
+      ? { box: "device-pixel-content-box" }
+      : {};
+    observer.observe(canvas, options);
+
+    // Wire up interactive HTML controls
+    nameInput.addEventListener("input", () => {
+      orderConfirmed = false;
+      requestCanvasUpdate();
+    });
+
+    milkSelect.addEventListener("change", () => {
+      orderConfirmed = false;
+      requestCanvasUpdate();
+    });
+
+    syrupSelect.addEventListener("change", () => {
+      orderConfirmed = false;
+      requestCanvasUpdate();
+    });
+
+    brewBtn.addEventListener("click", () => {
+      orderConfirmed = true;
+      brewBtn.textContent = "Order Added! (Update Cup)";
+      requestCanvasUpdate();
+    });
+  </script>
+
