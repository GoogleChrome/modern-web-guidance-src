+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorEl = document.getElementById('newsletter-error');
+      const successEl = document.getElementById('newsletter-success');
+      const errorMessage = 'Please enter a valid email address.';
+
+      let hasInteracted = false;
+
+      function isVisuallyInvalid() {
+        let matchesUserInvalid = false;
+        try {
+          matchesUserInvalid = emailInput.matches(':user-invalid');
+        } catch (e) {
+          // Fallback if :user-invalid is not supported
+        }
+        return !emailInput.validity.valid && (hasInteracted || matchesUserInvalid);
+      }
+
+      function syncErrorState() {
+        const showError = isVisuallyInvalid();
+
+        if (showError) {
+          emailInput.classList.add('is-invalid');
+          emailInput.setAttribute('aria-invalid', 'true');
+          errorEl.classList.add('visible');
+          errorEl.hidden = false;
+          if (errorEl.textContent !== errorMessage) {
+            errorEl.textContent = errorMessage;
+          }
+          successEl.classList.remove('visible');
+          successEl.hidden = true;
+          successEl.textContent = '';
+        } else {
+          emailInput.classList.remove('is-invalid');
+          emailInput.setAttribute('aria-invalid', 'false');
+          errorEl.classList.remove('visible');
+          errorEl.hidden = true;
+          errorEl.textContent = '';
+        }
+      }
+
+      emailInput.addEventListener('blur', function () {
+        if (emailInput.value.length > 0) {
+          hasInteracted = true;
+        }
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('input', function () {
+        // Clear success message when user edits input
+        if (!successEl.hidden) {
+          successEl.classList.remove('visible');
+          successEl.hidden = true;
+          successEl.textContent = '';
+        }
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('invalid', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        syncErrorState();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        syncErrorState();
+
+        if (emailInput.validity.valid) {
+          successEl.textContent = 'Thank you for subscribing!';
+          successEl.classList.add('visible');
+          successEl.hidden = false;
+          emailInput.value = '';
+          hasInteracted = false;
+          syncErrorState();
+        } else {
+          emailInput.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
