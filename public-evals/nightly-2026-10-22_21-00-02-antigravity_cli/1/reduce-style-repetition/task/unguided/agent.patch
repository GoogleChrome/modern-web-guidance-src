diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13,8 +13,20 @@
       --text: #3e2723;
       --light: #fafafa;
     }
 
+    @function --cool-gradient(--start: var(--secondary), --end: var(--light), --angle: 135deg) {
+      result: linear-gradient(var(--angle), var(--start), var(--end));
+    }
+
+    @function --responsive-columns() {
+      result: 1fr;
+
+      @media (min-width: 768px) {
+        result: repeat(2, 1fr);
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
@@ -24,10 +36,17 @@
       font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
       line-height: 1.6;
       color: var(--text);
       background-color: var(--light);
+      background-image: --cool-gradient(var(--light), var(--secondary), 135deg);
     }
 
+    h2 {
+      background-image: --cool-gradient(var(--secondary), var(--accent), 90deg);
+      padding: 10px 15px;
+      border-radius: 6px;
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
@@ -93,17 +112,33 @@
       margin-bottom: 1rem;
     }
 
