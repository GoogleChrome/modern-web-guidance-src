+    main,
     .container {
       max-width: 1100px;
       margin: 40px auto;
       padding: 0 20px;
+      display: grid;
+      grid-template-columns: --responsive-columns();
+      gap: 20px;
     }
 
+    main > section {
+      grid-column: 1 / -1;
+      display: grid;
+      grid-template-columns: --responsive-columns();
+      gap: 20px;
+    }
+
+    main > section > h2 {
+      grid-column: 1 / -1;
+    }
+
     .grid {
+      grid-column: 1 / -1;
       display: grid;
-      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+      grid-template-columns: --responsive-columns();
       gap: 20px;
       margin-top: 20px;
     }
 
