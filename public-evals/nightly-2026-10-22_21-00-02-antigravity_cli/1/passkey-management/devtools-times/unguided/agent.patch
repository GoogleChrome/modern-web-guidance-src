diff --git a/src/pages/api/passkeys.json.ts b/src/pages/api/passkeys.json.ts
new file mode 100644
index 0000000..39a71bd
--- /dev/null
+++ b/src/pages/api/passkeys.json.ts
@@ -0,0 +1,258 @@
+import type { APIRoute } from 'astro';
+
+export interface PasskeyRecord {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string;
+  device: string;
+  backedUp: boolean;
+}
+
+export interface AccountProfile {
+  userId: string;
+  username: string;
+  displayName: string;
+  email: string;
+}
+
+const DEFAULT_PROFILE: AccountProfile = {
+  userId: 'dGVzdC1yZWFkZXItdXNlci1pZC0wMDE',
+  username: 'alex.rivera@devtoolstimes.dev',
+  displayName: 'Alex Rivera',
+  email: 'alex.rivera@devtoolstimes.dev',
+};
+
+const DEFAULT_PASSKEYS: PasskeyRecord[] = [
+  {
+    id: 'vI0qOggiE3OT01ZRWBYz5l4MEgU0c7PmAA',
+    name: 'MacBook Pro (Chrome)',
+    createdAt: '2026-06-14T09:30:00Z',
+    lastUsedAt: '2026-10-22T18:15:00Z',
+    device: 'Google Password Manager',
+    backedUp: true,
+  },
+  {
+    id: 'k9LmN2pQrS4tUvWxYz0123456789AbCdEf',
+    name: 'Pixel 9 Pro',
+    createdAt: '2026-08-02T14:20:00Z',
+    lastUsedAt: '2026-10-19T11:05:00Z',
+    device: 'Google Password Manager',
+    backedUp: true,
+  },
+  {
+    id: 'x7YzW6vU5tS4rQ3pO2nM1lK0jI9hG8fE7d',
+    name: 'YubiKey 5C NFC',
+    createdAt: '2026-03-10T16:45:00Z',
+    lastUsedAt: '2026-09-01T08:00:00Z',
+    device: 'Hardware Security Key',
+    backedUp: false,
+  },
+];
+
+async function getAccountState(session: App.Locals['session'] | undefined) {
+  let profile = (await session?.get('accountProfile')) as AccountProfile | undefined;
+  if (!profile) {
+    profile = { ...DEFAULT_PROFILE };
+    await session?.set('accountProfile', profile);
+  }
+
+  let passkeys = (await session?.get('passkeys')) as PasskeyRecord[] | undefined;
+  if (!passkeys) {
+    passkeys = DEFAULT_PASSKEYS.map((k) => ({ ...k }));
+    await session?.set('passkeys', passkeys);
+  }
+
+  return { profile, passkeys };
+}
+
+export const GET: APIRoute = async ({ session }) => {
+  const { profile, passkeys } = await getAccountState(session);
+
+  return new Response(
+    JSON.stringify({
+      profile,
+      passkeys,
+      allAcceptedCredentialIds: passkeys.map((k) => k.id),
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await request.json().catch(() => ({}));
+  const { action } = body;
+  const { profile, passkeys } = await getAccountState(session);
+
+  if (action === 'updateProfile' || action === 'updateDisplayName') {
+    const displayName = typeof body.displayName === 'string' ? body.displayName.trim() : profile.displayName;
+    const username = typeof body.username === 'string' ? body.username.trim() : profile.username;
+
+    if (!displayName) {
+      return new Response(JSON.stringify({ error: 'Display name is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const updatedProfile: AccountProfile = {
+      ...profile,
+      displayName,
+      username: username || profile.username,
+    };
+    await session?.set('accountProfile', updatedProfile);
+
+    return new Response(
+      JSON.stringify({
+        profile: updatedProfile,
+        passkeys,
+        allAcceptedCredentialIds: passkeys.map((k) => k.id),
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  if (action === 'renamePasskey' || action === 'updatePasskey') {
+    const { credentialId, id, name } = body;
+    const targetId = credentialId || id;
+    const trimmedName = typeof name === 'string' ? name.trim() : '';
+
+    if (!targetId || !trimmedName) {
+      return new Response(JSON.stringify({ error: 'Credential ID and new name are required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const updatedPasskeys = passkeys.map((k) =>
+      k.id === targetId ? { ...k, name: trimmedName } : k
+    );
+    await session?.set('passkeys', updatedPasskeys);
+
+    return new Response(
+      JSON.stringify({
+        profile,
+        passkeys: updatedPasskeys,
+        allAcceptedCredentialIds: updatedPasskeys.map((k) => k.id),
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  if (action === 'removePasskey' || action === 'deletePasskey') {
+    const { credentialId, id } = body;
+    const targetId = credentialId || id;
+
+    if (!targetId) {
+      return new Response(JSON.stringify({ error: 'Credential ID is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const updatedPasskeys = passkeys.filter((k) => k.id !== targetId);
+    await session?.set('passkeys', updatedPasskeys);
+
+    return new Response(
+      JSON.stringify({
+        profile,
+        passkeys: updatedPasskeys,
+        removedCredentialId: targetId,
+        allAcceptedCredentialIds: updatedPasskeys.map((k) => k.id),
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  if (action === 'registerPasskey' || action === 'addPasskey') {
+    const newKey: PasskeyRecord = {
+      id: body.credentialId || `cred_${Math.random().toString(36).substring(2, 15)}`,
+      name: (typeof body.name === 'string' && body.name.trim()) || 'New Passkey',
+      createdAt: new Date().toISOString(),
+      lastUsedAt: new Date().toISOString(),
+      device: body.device || 'Browser Authenticator',
+      backedUp: body.backedUp ?? true,
+    };
+
+    const updatedPasskeys = [newKey, ...passkeys];
+    await session?.set('passkeys', updatedPasskeys);
+
+    return new Response(
+      JSON.stringify({
+        profile,
+        passkeys: updatedPasskeys,
+        allAcceptedCredentialIds: updatedPasskeys.map((k) => k.id),
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  if (action === 'resetPasskeys') {
+    const resetProfile = { ...DEFAULT_PROFILE };
+    const resetKeys = DEFAULT_PASSKEYS.map((k) => ({ ...k }));
+    await session?.set('accountProfile', resetProfile);
+    await session?.set('passkeys', resetKeys);
+
+    return new Response(
+      JSON.stringify({
+        profile: resetProfile,
+        passkeys: resetKeys,
+        allAcceptedCredentialIds: resetKeys.map((k) => k.id),
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  return new Response(JSON.stringify({ error: 'Invalid action' }), {
+    status: 400,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const DELETE: APIRoute = async ({ request, session }) => {
+  const body = await request.json().catch(() => ({}));
+  const { credentialId, id } = body;
+  const targetId = credentialId || id;
+  const { profile, passkeys } = await getAccountState(session);
+
+  if (!targetId) {
+    return new Response(JSON.stringify({ error: 'Credential ID is required' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const updatedPasskeys = passkeys.filter((k) => k.id !== targetId);
+  await session?.set('passkeys', updatedPasskeys);
+
+  return new Response(
+    JSON.stringify({
+      profile,
+      passkeys: updatedPasskeys,
+      removedCredentialId: targetId,
+      allAcceptedCredentialIds: updatedPasskeys.map((k) => k.id),
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
