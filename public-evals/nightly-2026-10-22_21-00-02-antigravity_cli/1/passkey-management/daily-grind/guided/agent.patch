+/**
+ * Render the list of registered passkeys in the management panel.
+ */
+export function renderUI(list) {
+  const listContainer = document.getElementById('passkey-list');
+  const countBadge = document.getElementById('passkey-count-badge');
+  if (countBadge) {
+    countBadge.textContent = `${list.length} ${list.length === 1 ? 'passkey' : 'passkeys'}`;
+  }
+  if (!listContainer) return;
+
+  if (!Array.isArray(list) || list.length === 0) {
+    listContainer.innerHTML = `
+      <div class="passkey-empty-state" role="status">
+        <div class="passkey-empty-icon" aria-hidden="true">🔑</div>
+        <h4>No passkeys found</h4>
+        <p>You don't have any active passkeys registered to your Daily Grind account yet. Add a passkey for faster, phishing-resistant sign-in.</p>
+      </div>
+    `;
+    return;
+  }
+
+  listContainer.innerHTML = list
+    .map(cred => {
+      const meta = getAaguidMetadata(cred);
+      const iconSrc = meta.providerIcon || FALLBACK_PASSKEY_ICON;
+      const registeredDateStr = formatEpochDate(cred.registeredAt);
+      const lastUsedDateStr = cred.lastUsedAt ? formatEpochDate(cred.lastUsedAt) : 'Never used';
+      const isEditing = activeEditingCredentialId === cred.id;
+      const showProviderSubtitle = meta.providerName && meta.displayName !== meta.providerName;
+      const syncBadge = cred.credentialBackedUp ? 'Synced' : 'Device-bound';
+
+      return `
+        <article class="passkey-item" data-credential-id="${escapeHtml(cred.id)}">
+          <div class="passkey-item-main">
+            <div class="passkey-provider-icon-wrap">
+              <img
+                src="${escapeHtml(iconSrc)}"
+                alt="${escapeHtml(meta.providerName)} icon"
+                class="passkey-provider-icon"
+                width="36"
+                height="36"
+              />
+            </div>
+            <div class="passkey-details">
+              ${
+                isEditing
+                  ? `
+                  <form class="passkey-rename-form" data-rename-form="${escapeHtml(cred.id)}">
+                    <label for="rename-input-${escapeHtml(cred.id)}" class="sr-only">Passkey nickname</label>
+                    <input
+                      id="rename-input-${escapeHtml(cred.id)}"
+                      type="text"
+                      name="credentialName"
+                      class="passkey-rename-input"
+                      value="${escapeHtml(meta.displayName)}"
+                      maxlength="64"
+                      required
+                      autocomplete="off"
+                    />
+                    <div class="passkey-rename-actions">
+                      <button type="submit" class="btn-sm btn-primary-sm">Save</button>
+                      <button type="button" class="btn-sm btn-outline-sm" data-cancel-rename="${escapeHtml(cred.id)}">Cancel</button>
+                    </div>
+                  </form>
+                `
+                  : `
+                  <div class="passkey-title-row">
+                    <h4 class="passkey-name">${escapeHtml(meta.displayName)}</h4>
+                    <span class="passkey-tag">${escapeHtml(syncBadge)}</span>
+                    ${
+                      showProviderSubtitle
+                        ? `<span class="passkey-provider-pill">${escapeHtml(meta.providerName)}</span>`
+                        : ''
+                    }
+                  </div>
+                `
+              }
+              <div class="passkey-meta-row">
+                <span class="passkey-meta-item">
+                  <strong>Registered:</strong> <time datetime="${new Date(cred.registeredAt).toISOString()}">${escapeHtml(registeredDateStr)}</time>
+                </span>
+                <span class="passkey-meta-divider" aria-hidden="true">&bull;</span>
+                <span class="passkey-meta-item">
+                  <strong>Last used:</strong> ${
+                    cred.lastUsedAt
+                      ? `<time datetime="${new Date(cred.lastUsedAt).toISOString()}">${escapeHtml(lastUsedDateStr)}</time>`
+                      : `<span>${escapeHtml(lastUsedDateStr)}</span>`
+                  }
+                </span>
+              </div>
+            </div>
+          </div>
+          <div class="passkey-actions">
+            <button
+              type="button"
+              class="btn-action btn-rename"
+              data-action="rename"
+              data-credential-id="${escapeHtml(cred.id)}"
+              aria-label="Rename passkey ${escapeHtml(meta.displayName)}"
+            >
+              Rename
+            </button>
+            <button
+              type="button"
+              class="btn-action btn-delete"
+              data-action="delete"
+              data-credential-id="${escapeHtml(cred.id)}"
+              aria-label="Delete passkey ${escapeHtml(meta.displayName)}"
+            >
+              Delete
+            </button>
+          </div>
+        </article>
+      `;
+    })
+    .join('');
+
+  if (activeEditingCredentialId) {
+    const input = document.getElementById(`rename-input-${activeEditingCredentialId}`);
+    if (input) {
+      input.focus();
+      input.select();
+    }
+  }
+}
