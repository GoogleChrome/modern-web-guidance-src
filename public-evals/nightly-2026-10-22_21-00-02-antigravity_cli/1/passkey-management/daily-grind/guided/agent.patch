+    name: customName || provider?.name || 'Unknown passkey provider',
+    providerName: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+    providerIconDark: provider?.icon_dark
+  };
+}
+
+function makeJsonResponse(data, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json' }
+  });
+}
+
+/**
+ * Extract AAGUID from a Base64URL-encoded attestationObject if present,
+ * or fall back to a default AAGUID.
+ */
+function extractAaguidFromRegistration(encodedResponse) {
+  if (encodedResponse?.aaguid) {
+    return encodedResponse.aaguid;
+  }
+  // Default to Google Password Manager or zeroed AAGUID if attestation wasn't provided
+  return 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4';
+}
+
+function generateBase64UrlChallenge() {
+  const bytes = new Uint8Array(32);
+  if (window.crypto && window.crypto.getRandomValues) {
+    window.crypto.getRandomValues(bytes);
+  } else {
+    for (let i = 0; i < 32; i++) bytes[i] = Math.floor(Math.random() * 256);
+  }
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+// Endpoint helper functions matching server-side CRUD operations:
+
+export async function listFetch() {
+  return fetch('/api/credentials', {
+    method: 'GET',
+    headers: { 'Accept': 'application/json' }
+  });
+}
+
+export async function renameCredentialFetch(credentialId, body) {
+  return fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body)
+  });
+}
+
+export async function deleteFetch(credentialId) {
+  return fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+    method: 'DELETE',
+    headers: { 'Accept': 'application/json' }
+  });
+}
+
+export async function getUserFetch() {
+  return fetch('/api/user', {
+    method: 'GET',
+    headers: { 'Accept': 'application/json' }
+  });
+}
+
+export async function updateUserFetch(body) {
+  return fetch('/api/user', {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body)
+  });
+}
+
+export async function optionsFetch({ promotion = false } = {}) {
+  const response = await fetch('/api/register/options', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ promotion })
+  });
+  return response.json();
+}
+
+export async function registerVerifyFetch(encodedResponse) {
+  return fetch('/api/register/verify', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(encodedResponse)
+  });
+}
+
+// Install local API route interceptor on window.fetch so standard fetch('/api/...') calls
+// work seamlessly against statikk without a separate Node backend process.
+const originalFetch = window.fetch.bind(window);
+window.fetch = async function (input, init = {}) {
+  const urlString = typeof input === 'string' ? input : (input instanceof URL ? input.href : input.url);
+  const url = new URL(urlString, window.location.origin);
+  const method = (init.method || (typeof input === 'object' && input.method) || 'GET').toUpperCase();
+
+  // 1. GET /api/credentials
+  if (url.pathname === '/api/credentials' && method === 'GET') {
+    const list = getStoredCredentials().filter(c => c.passkeyUserId === base64UrlUserId);
+    return makeJsonResponse(list, 200);
+  }
+
+  // 2. PUT /api/credential/:id
+  if (url.pathname.startsWith('/api/credential/') && method === 'PUT') {
+    const id = decodeURIComponent(url.pathname.slice('/api/credential/'.length));
+    const body = init.body ? JSON.parse(init.body) : {};
+    const list = getStoredCredentials();
+    const cred = list.find(c => c.id === id && c.passkeyUserId === base64UrlUserId);
+    if (!cred) {
+      return makeJsonResponse({ error: 'Credential not found.' }, 404);
+    }
+    const trimmedName = typeof body.name === 'string' ? body.name.trim() : '';
+    if (!trimmedName) {
+      return makeJsonResponse({ error: 'Credential name is required.' }, 400);
+    }
+    cred.name = trimmedName;
+    saveStoredCredentials(list);
+    return makeJsonResponse(cred, 200);
+  }
+
+  // 3. DELETE /api/credential/:id
+  if (url.pathname.startsWith('/api/credential/') && method === 'DELETE') {
+    const id = decodeURIComponent(url.pathname.slice('/api/credential/'.length));
+    const list = getStoredCredentials();
+    const index = list.findIndex(c => c.id === id && c.passkeyUserId === base64UrlUserId);
+    if (index === -1) {
+      return makeJsonResponse({ error: 'Credential not found.' }, 404);
+    }
+    list.splice(index, 1);
+    saveStoredCredentials(list);
+    return makeJsonResponse({ success: true }, 200);
+  }
+
+  // 4. GET / PUT /api/user
+  if (url.pathname === '/api/user') {
+    if (method === 'GET') {
+      return makeJsonResponse(getStoredUser(), 200);
+    }
+    if (method === 'PUT') {
+      const body = init.body ? JSON.parse(init.body) : {};
+      const currentUser = getStoredUser();
+      const updatedUser = {
+        ...currentUser,
+        name: typeof body.name === 'string' && body.name.trim() ? body.name.trim() : currentUser.name,
+        displayName: typeof body.displayName === 'string' && body.displayName.trim() ? body.displayName.trim() : currentUser.displayName
+      };
+      saveStoredUser(updatedUser);
+      return makeJsonResponse(updatedUser, 200);
+    }
+  }
+
+  // 5. POST /api/register/options
+  if (url.pathname === '/api/register/options' && method === 'POST') {
+    const body = init.body ? JSON.parse(init.body) : {};
+    const isPromotionFlow = Boolean(body.promotion);
+    const user = getStoredUser();
+    const userExistingCredentials = getStoredCredentials().filter(c => c.passkeyUserId === base64UrlUserId);
+
+    const options = {
+      challenge: generateBase64UrlChallenge(),
+      rp: { id: rpId, name: 'The Daily Grind' },
+      user: {
+        id: base64UrlUserId,
+        name: user.name,
+        displayName: user.displayName
+      },
+      pubKeyCredParams: [
+        { type: 'public-key', alg: -7 },
+        { type: 'public-key', alg: -257 }
+      ],
+      excludeCredentials: userExistingCredentials.map(cred => ({
+        type: 'public-key',
+        id: cred.id,
+        transports: cred.transports
+      })),
+      authenticatorSelection: {
+        residentKey: 'required',
+        requireResidentKey: true,
+        userVerification: 'preferred',
+        ...(isPromotionFlow && { authenticatorAttachment: 'platform' })
+      }
+    };
+    return makeJsonResponse(options, 200);
+  }
+
+  // 6. POST /api/register/verify
+  if (url.pathname === '/api/register/verify' && method === 'POST') {
+    const encodedResponse = init.body ? JSON.parse(init.body) : {};
+    if (!encodedResponse || !encodedResponse.id) {
+      return makeJsonResponse({ error: 'Invalid registration response.' }, 400);
+    }
+
+    const aaguid = extractAaguidFromRegistration(encodedResponse);
+    let name = 'Unknown passkey provider';
+    let providerIcon = undefined;
+
+    if (aaguid === '00000000-0000-0000-0000-000000000000') {
+      name = 'Unknown passkey provider';
+      providerIcon = undefined;
+    } else {
+      const provider = aaguids[aaguid];
+      name = provider?.name || 'Unknown passkey provider';
+      providerIcon = provider?.icon_light;
+    }
+
+    const now = Date.now();
+    const newCredential = {
+      id: encodedResponse.id,
+      passkeyUserId: base64UrlUserId,
+      credentialPublicKey: encodedResponse.response?.attestationObject || 'pQECAyYgASFYIJV8x9mN2pL5kQ1wE4rT7yU0iO3pA6sD8fG1hJ4kL7zX',
+      credentialType: 'public-key',
+      credentialDeviceType: 'multiDevice',
+      credentialBackedUp: true,
+      aaguid,
+      providerIcon,
+      name,
+      transports: encodedResponse.response?.transports || ['internal', 'hybrid'],
+      registeredAt: now,
+      lastUsedAt: now,
+      counter: 0
+    };
+
+    const list = getStoredCredentials();
+    list.unshift(newCredential);
+    saveStoredCredentials(list);
+    return makeJsonResponse(newCredential, 200);
+  }
+
+  return originalFetch(input, init);
+};
