+import 'webauthn-polyfills';
+import aaguids from './aaguids.json' with { type: 'json' };
+import {
+  rpId,
+  base64UrlUserId,
+  listFetch,
+  renameCredentialFetch,
+  deleteFetch,
+  getUserFetch,
+  updateUserFetch,
+  optionsFetch,
+  registerVerifyFetch
+} from './api.js';
+
+// Fallback SVG data URI when provider icon is unavailable (e.g. zeroed AAGUID)
+const FALLBACK_PASSKEY_ICON = `data:image/svg+xml;utf8,${encodeURIComponent(
+  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#4e342e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>'
+)}`;
+
+let activeEditingCredentialId = null;
+const signalEventsLog = [];
+
+function recordSignalEvent(methodName, payload, supported) {
+  const entry = {
+    timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }),
+    methodName,
+    payload,
+    supported
+  };
+  signalEventsLog.unshift(entry);
+  renderSignalStatusBanner(entry);
+}
+
+function renderSignalStatusBanner(latestEntry) {
+  const statusEl = document.getElementById('signal-sync-status');
+  const logListEl = document.getElementById('signal-sync-log-list');
+  if (statusEl && latestEntry) {
+    const badgeClass = latestEntry.supported ? 'signal-badge-synced' : 'signal-badge-fallback';
+    const badgeLabel = latestEntry.supported ? 'Authenticator Synced' : 'Signal API Guarded (Browser Fallback)';
+    statusEl.innerHTML = `
+      <span class="signal-status-dot ${badgeClass}"></span>
+      <span class="signal-status-text">
+        <strong>${escapeHtml(latestEntry.methodName)}</strong> — ${badgeLabel} at ${escapeHtml(latestEntry.timestamp)}
+      </span>
+    `;
+  }
+  if (logListEl) {
+    logListEl.innerHTML = signalEventsLog
+      .slice(0, 5)
+      .map(
+        item => `
+        <li class="signal-log-item">
+          <div class="signal-log-header">
+            <code>PublicKeyCredential.${escapeHtml(item.methodName)}</code>
+            <span class="signal-log-time">${escapeHtml(item.timestamp)}</span>
+          </div>
+          <pre class="signal-log-payload">${escapeHtml(JSON.stringify(item.payload, null, 2))}</pre>
+        </li>
+      `
+      )
+      .join('');
+  }
+}
+
+function showToast(message, type = 'success') {
+  const container = document.getElementById('account-toast');
+  if (!container) return;
+  container.textContent = message;
+  container.className = `account-toast show ${type}`;
+  clearTimeout(container._hideTimer);
+  container._hideTimer = setTimeout(() => {
+    container.className = 'account-toast';
+  }, 4000);
+}
+
+function escapeHtml(str) {
+  return String(str ?? '')
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;');
+}
+
+function formatEpochDate(epochMs) {
+  if (!epochMs) return 'Never used';
+  try {
+    return new Intl.DateTimeFormat('en-US', {
+      month: 'short',
+      day: 'numeric',
+      year: 'numeric'
+    }).format(new Date(epochMs));
+  } catch {
+    return new Date(epochMs).toLocaleDateString();
+  }
+}
+
+/**
+ * Determine passkey provider details from AAGUID registry.
+ * Checks if AAGUID equals '00000000-0000-0000-0000-000000000000' before lookup.
+ */
+function getAaguidMetadata(cred) {
+  const { aaguid } = cred;
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      providerName: 'Unknown passkey provider',
+      displayName: cred.name || 'Unknown passkey provider',
+      providerIcon: undefined
+    };
+  }
+  const provider = aaguids[aaguid];
+  const providerName = provider?.name || 'Unknown passkey provider';
+  return {
+    providerName,
+    displayName: cred.name || providerName,
+    providerIcon: cred.providerIcon || provider?.icon_light
+  };
+}
+
+/**
+ * Synchronize accepted credential IDs with the browser's authenticator / password manager
+ * via PublicKeyCredential.signalAllAcceptedCredentials().
+ */
+export async function syncAcceptedCredentials(currentCredentialsList) {
+  const credentialIds = currentCredentialsList.map(c => c.id); // Array of Base64URL credential ID strings
+  const payload = {
+    rpId,
+    userId: base64UrlUserId,
+    allAcceptedCredentialIds: credentialIds
+  };
+
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) {
+    recordSignalEvent('signalAllAcceptedCredentials', payload, false);
+    return;
+  }
+
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials(payload);
+    recordSignalEvent('signalAllAcceptedCredentials', payload, true);
+  } catch (e) {
+    console.error('SignalAllAcceptedCredentials sync failure:', e);
+  }
+}
