+/**
+ * Render the signed-in user profile details in the My Account panel.
+ */
+function renderUserProfile(user) {
+  if (!user) return;
+  const nameInput = document.getElementById('account-username-input');
+  const displayNameInput = document.getElementById('account-displayname-input');
+  const headerName = document.getElementById('account-header-name');
+  const headerEmail = document.getElementById('account-header-email');
+  const avatarInitials = document.getElementById('account-avatar-initials');
+
+  if (nameInput) nameInput.value = user.name || '';
+  if (displayNameInput) displayNameInput.value = user.displayName || '';
+  if (headerName) headerName.textContent = user.displayName || 'Customer';
+  if (headerEmail) headerEmail.textContent = user.name || '';
+  if (avatarInitials) {
+    const initials = (user.displayName || 'DG')
+      .split(/\s+/)
+      .map(part => part[0])
+      .join('')
+      .slice(0, 2)
+      .toUpperCase();
+    avatarInitials.textContent = initials;
+  }
+}
+
+/**
+ * Delete a passkey on the server and synchronize remaining accepted credentials
+ * with the browser authenticator via PublicKeyCredential.signalAllAcceptedCredentials().
+ */
+export async function performDelete(credentialId) {
+  const response = await deleteFetch(credentialId);
+  if (response.ok) {
+    if (activeEditingCredentialId === credentialId) {
+      activeEditingCredentialId = null;
+    }
+    const updatedResponse = await listFetch();
+    const updatedList = await updatedResponse.json();
+
+    renderUI(updatedList);
+    // Sync remaining accepted credentials after deletion
+    await syncAcceptedCredentials(updatedList);
+    showToast('Passkey removed and browser authenticator synced.');
+  } else {
+    showToast('Could not delete passkey. Please try again.', 'error');
+  }
+}
+
+/**
+ * Rename a passkey's nickname on the server only.
+ * Note: Renaming an individual passkey's nickname is a server-side label change
+ * and does NOT invoke signalCurrentUserDetails().
+ */
+export async function performCredentialRename(credentialId, newCredentialName) {
+  const trimmed = String(newCredentialName ?? '').trim();
+  if (!trimmed) return;
+
+  const response = await renameCredentialFetch(credentialId, { name: trimmed });
+  if (response.ok) {
+    activeEditingCredentialId = null;
+    const updatedResponse = await listFetch();
+    renderUI(await updatedResponse.json());
+    showToast(`Passkey renamed to "${trimmed}".`);
+  } else {
+    showToast('Could not rename passkey.', 'error');
+  }
+}
+
+/**
+ * Rename the user's account username (name) or displayName on the server
+ * and immediately synchronize with the authenticator via PublicKeyCredential.signalCurrentUserDetails().
+ */
+export async function performUserRename(currentRpId, userId, updatedName, updatedDisplayName) {
+  const response = await updateUserFetch({ name: updatedName, displayName: updatedDisplayName });
+  if (response.ok) {
+    const updatedUser = await response.json();
+    renderUserProfile(updatedUser);
+
+    const signalPayload = {
+      rpId: currentRpId,
+      userId,
+      name: updatedUser.name,
+      displayName: updatedUser.displayName
+    };
+
+    if (window.PublicKeyCredential && PublicKeyCredential.signalCurrentUserDetails) {
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails(signalPayload);
+        recordSignalEvent('signalCurrentUserDetails', signalPayload, true);
+      } catch (e) {
+        console.error('SignalCurrentUserDetails sync failure:', e);
+      }
+    } else {
+      recordSignalEvent('signalCurrentUserDetails', signalPayload, false);
+    }
+
+    showToast('Account profile updated and synced with your authenticator.');
+  } else {
+    showToast('Failed to update account profile.', 'error');
+  }
+}
+
+/**
+ * Feature-detect passkey capabilities using PublicKeyCredential.getClientCapabilities()
+ * and conditionally display/enable the "Create passkey" button or fallback guidance.
+ */
+async function checkPasskeyCapabilities() {
+  const createBtn = document.getElementById('create-passkey-btn');
+  const fallbackNotice = document.getElementById('passkey-unsupported-fallback');
+
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    if (createBtn) {
+      createBtn.hidden = true;
+      createBtn.disabled = true;
+    }
+    if (fallbackNotice) fallbackNotice.hidden = false;
+    return false;
+  }
+
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    const isSupported =
+      Boolean(capabilities?.passkeyPlatformAuthenticator || capabilities?.userVerifyingPlatformAuthenticator) &&
+      capabilities?.conditionalGet !== false;
+
+    if (!isSupported) {
+      if (createBtn) {
+        createBtn.disabled = true;
+        createBtn.hidden = true;
+      }
+      if (fallbackNotice) fallbackNotice.hidden = false;
+      return false;
+    }
+
+    if (createBtn) {
+      createBtn.disabled = false;
+      createBtn.hidden = false;
+    }
+    if (fallbackNotice) fallbackNotice.hidden = true;
+    return true;
+  } catch (e) {
+    console.warn('Error checking client capabilities:', e);
+    return false;
+  }
+}
+
+/**
+ * Register a new passkey from the management panel.
+ * Omits authenticatorSelection.authenticatorAttachment when isPromotion is false
+ * so users can register either platform authenticators or security keys.
+ */
+export async function registerPasskey(isPromotion = false) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    showToast('Passkeys are not supported in this browser.', 'error');
+    return;
+  }
+
+  const capabilities = await PublicKeyCredential.getClientCapabilities();
+  if (
+    (!capabilities.passkeyPlatformAuthenticator && !capabilities.userVerifyingPlatformAuthenticator) ||
+    !capabilities.conditionalGet
+  ) {
+    const fallbackNotice = document.getElementById('passkey-unsupported-fallback');
+    if (fallbackNotice) fallbackNotice.hidden = false;
+    return;
+  }
+
+  const creationOptionsJSON = await optionsFetch({ promotion: isPromotion });
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    if (err.name === 'InvalidStateError') {
+      console.log('A passkey already exists for this account.');
+      showToast('A passkey already exists on this authenticator for your account.', 'error');
+    } else if (err.name === 'SecurityError') {
+      console.error('Configuration RP ID or Secure Context error.');
+      showToast('Security configuration or RP ID error.', 'error');
+    } else if (err.name === 'NotAllowedError') {
+      console.log('User cancelled the passkey dialog.');
+      showToast('Passkey registration was cancelled.', 'info');
+    } else if (err.name === 'AbortError') {
+      console.log('The creation operation has been aborted.');
+    }
+    return; // Safe API exit, do not signal unknown for standard WebAuthn cancels
+  }
+
+  if (!credential) return;
+
+  // Server Verification phase (Segregated Try/Catch)
+  const encodedResponse = credential.toJSON();
+  try {
+    const response = await registerVerifyFetch(encodedResponse);
+    if (!response.ok) {
+      if (window.PublicKeyCredential && PublicKeyCredential.signalUnknownCredential) {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId,
+          credentialId: encodedResponse.id
+        });
+      }
+      showToast('Server verification failed for the new passkey.', 'error');
+      return;
+    }
+
+    const updatedResponse = await listFetch();
+    const updatedList = await updatedResponse.json();
+    renderUI(updatedList);
+    await syncAcceptedCredentials(updatedList);
+    showToast('New passkey registered and synced!');
+  } catch (serverErr) {
+    console.error('Server verification network failure:', serverErr);
+    if (window.PublicKeyCredential && PublicKeyCredential.signalUnknownCredential) {
+      await PublicKeyCredential.signalUnknownCredential({
+        rpId,
+        credentialId: encodedResponse.id
+      });
+    }
+    showToast('Network error verifying passkey.', 'error');
+  }
+}
