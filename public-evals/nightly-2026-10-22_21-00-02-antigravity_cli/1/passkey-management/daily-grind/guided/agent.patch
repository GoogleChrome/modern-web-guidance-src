+/**
+ * Initialize the My Account passkey management panel on page load.
+ */
+export async function loadManagementPanel() {
+  await checkPasskeyCapabilities();
+
+  const [userRes, credRes] = await Promise.all([getUserFetch(), listFetch()]);
+  if (userRes.ok) {
+    const user = await userRes.json();
+    renderUserProfile(user);
+  }
+
+  const list = await credRes.json();
+  renderUI(list);
+
+  // Sync accepted credentials on initial load
+  await syncAcceptedCredentials(list);
+}
+
+function bindEvents() {
+  const listContainer = document.getElementById('passkey-list');
+  if (listContainer) {
+    listContainer.addEventListener('click', async event => {
+      const actionBtn = event.target.closest('[data-action]');
+      if (actionBtn) {
+        const action = actionBtn.getAttribute('data-action');
+        const credentialId = actionBtn.getAttribute('data-credential-id');
+        if (!credentialId) return;
+
+        if (action === 'delete') {
+          await performDelete(credentialId);
+        } else if (action === 'rename') {
+          activeEditingCredentialId = credentialId;
+          const response = await listFetch();
+          renderUI(await response.json());
+        }
+        return;
+      }
+
+      const cancelBtn = event.target.closest('[data-cancel-rename]');
+      if (cancelBtn) {
+        activeEditingCredentialId = null;
+        const response = await listFetch();
+        renderUI(await response.json());
+      }
+    });
+
+    // Safe Enter/form submission for inline passkey rename
+    listContainer.addEventListener('submit', async event => {
+      const form = event.target.closest('[data-rename-form]');
+      if (!form) return;
+      event.preventDefault();
+      const credentialId = form.getAttribute('data-rename-form');
+      const input = form.querySelector('input[name="credentialName"]');
+      if (credentialId && input) {
+        await performCredentialRename(credentialId, input.value);
+      }
+    });
+
+    listContainer.addEventListener('keydown', async event => {
+      if (event.key === 'Escape' && activeEditingCredentialId) {
+        activeEditingCredentialId = null;
+        const response = await listFetch();
+        renderUI(await response.json());
+      }
+    });
+  }
+
+  // User profile form submission ->PUT /api/user + signalCurrentUserDetails
+  const profileForm = document.getElementById('account-profile-form');
+  if (profileForm) {
+    profileForm.addEventListener('submit', async event => {
+      event.preventDefault();
+      const nameInput = document.getElementById('account-username-input');
+      const displayNameInput = document.getElementById('account-displayname-input');
+      const updatedName = nameInput ? nameInput.value.trim() : '';
+      const updatedDisplayName = displayNameInput ? displayNameInput.value.trim() : '';
+      if (!updatedName || !updatedDisplayName) {
+        showToast('Please provide both an email/username and a display name.', 'error');
+        return;
+      }
+      await performUserRename(rpId, base64UrlUserId, updatedName, updatedDisplayName);
+    });
+  }
+
+  // Create passkey button
+  const createBtn = document.getElementById('create-passkey-btn');
+  if (createBtn) {
+    createBtn.addEventListener('click', async () => {
+      await registerPasskey(false);
+    });
+  }
+}
+
+if (document.readyState === 'loading') {
+  window.addEventListener('DOMContentLoaded', () => {
+    bindEvents();
+    loadManagementPanel();
+  });
+} else {
+  bindEvents();
+  loadManagementPanel();
+}
