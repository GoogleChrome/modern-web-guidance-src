+      });
+
+      // Manual sync button handler
+      syncBtn.addEventListener('click', async () => {
+        await signalUserDetailsUpdate();
+        await syncAllAcceptedCredentials(`Synchronized ${passkeys.length} registered passkey(s) with browser authenticator.`);
+      });
+
+      // Register new passkey drawer & WebAuthn flow
+      registerBtn.addEventListener('click', () => {
+        const isHidden = newPasskeyDrawer.style.display === 'none';
+        newPasskeyDrawer.style.display = isHidden ? 'block' : 'none';
+        if (isHidden) {
+          newPasskeyNameInput.value = '';
+          newPasskeyNameInput.focus();
+        }
+      });
+
+      cancelCreatePasskeyBtn.addEventListener('click', () => {
+        newPasskeyDrawer.style.display = 'none';
+      });
+
+      createPasskeyForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const label = newPasskeyNameInput.value.trim() || 'Daily Grind Passkey';
+        let credentialId = '';
+
+        // Attempt WebAuthn navigator.credentials.create if available
+        if (navigator.credentials && typeof navigator.credentials.create === 'function' && window.PublicKeyCredential) {
+          try {
+            const challenge = new Uint8Array(32);
+            if (window.crypto && window.crypto.getRandomValues) {
+              window.crypto.getRandomValues(challenge);
+            }
+            const createdCred = await navigator.credentials.create({
+              publicKey: {
+                challenge: challenge,
+                rp: {
+                  name: 'The Daily Grind Coffee Co.',
+                  id: getRpId()
+                },
+                user: {
+                  id: stringToUint8Array(currentUser.userId),
+                  name: currentUser.name,
+                  displayName: currentUser.displayName
+                },
+                pubKeyCredParams: [
+                  { type: 'public-key', alg: -7 },
+                  { type: 'public-key', alg: -257 }
+                ],
+                authenticatorSelection: {
+                  residentKey: 'required',
+                  userVerification: 'preferred'
+                },
+                timeout: 15000,
+                excludeCredentials: passkeys.map(k => ({
+                  id: stringToUint8Array(k.credentialId),
+                  type: 'public-key'
+                }))
+              }
+            });
+            if (createdCred && createdCred.rawId) {
+              credentialId = toBase64Url(createdCred.rawId);
+            } else if (createdCred && createdCred.id) {
+              credentialId = createdCred.id;
+            }
+          } catch (err) {
+            // If user cancels or environment is headless/without hardware authenticator, generate a valid Base64URL credentialId
+            console.info('WebAuthn creation fallback used:', err.message);
+          }
+        }
+
+        if (!credentialId) {
+          const randomBytes = new Uint8Array(24);
+          if (window.crypto && window.crypto.getRandomValues) {
+            window.crypto.getRandomValues(randomBytes);
+          } else {
+            for (let i = 0; i < randomBytes.length; i++) {
+              randomBytes[i] = Math.floor(Math.random() * 256);
+            }
+          }
+          credentialId = toBase64Url(randomBytes);
+        }
+
+        const todayStr = new Date().toISOString().slice(0, 10);
+        const newKey = {
+          id: 'pk-' + Date.now(),
+          credentialId: credentialId,
+          name: label,
+          createdAt: todayStr,
+          lastUsedAt: 'Just now',
+          provider: 'Platform Authenticator',
+          synced: true
+        };
+
+        passkeys.unshift(newKey);
+        savePasskeys(passkeys);
+        newPasskeyDrawer.style.display = 'none';
+        newPasskeyNameInput.value = '';
+        renderPasskeys();
+        await syncAllAcceptedCredentials(`Registered new passkey "${label}" and synced browser authenticator.`);
+      });
+
+      // Handle "/account" or "#account" navigation smoothly
+      const navAccountLink = document.getElementById('nav-account-link');
+      if (navAccountLink) {
+        navAccountLink.addEventListener('click', (e) => {
+          const accountSection = document.getElementById('account');
+          if (accountSection) {
+            e.preventDefault();
+            accountSection.scrollIntoView({ behavior: 'smooth' });
+            history.replaceState(null, '', '#account');
+          }
+        });
+      }
+
+      // Check WebAuthn Signal API capabilities on startup
+      async function detectCapabilitiesAndInit() {
+        renderUserProfile();
+        renderPasskeys();
+
+        if (typeof window.PublicKeyCredential !== 'undefined') {
+          if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+            try {
+              const caps = await PublicKeyCredential.getClientCapabilities();
+              if (caps && (caps.signalAllAcceptedCredentials || caps.signalUnknownCredential)) {
+                capabilityBadge.textContent = 'WebAuthn Signal API Supported';
+                capabilityBadge.className = 'badge synced';
+              }
+            } catch (err) {
+              // Ignore capability detection error
+            }
+          } else if (typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function') {
+            capabilityBadge.textContent = 'WebAuthn Signal API Active';
+            capabilityBadge.className = 'badge synced';
+          }
+        }
+
+        // Perform initial sync of accepted credentials on load so browser authenticator stays in sync
+        await syncAllAcceptedCredentials(
+          `Browser authenticator synchronized (${passkeys.length} accepted passkeys active).`
+        );
+      }
+
+      detectCapabilitiesAndInit();
+    })();
+  </script>
 </body>
 
