+  <script>
+    // Track sessions and abort controllers for proper resource management
+    let baseBaristaSession = null;
+    let activeBaristaSession = null;
+    let clonedSessions = [];
+    let currentAbortController = null;
+
+    const SYSTEM_PROMPT =
+      'You are a knowledgeable, friendly barista at The Daily Grind artisanal coffee shop. ' +
+      'Answer customer questions specifically about our Maple Oat Latte (made with steamed creamy oat milk, double-shot espresso, and pure Vermont maple syrup) ' +
+      'and our Cold Brew (single-origin beans steeped for 18 hours for maximum smoothness and low acidity).';
+
+    const downloadStatusEl = document.getElementById('download-status');
+    const baristaQuestionEl = document.getElementById('barista-question');
+    const askBaristaBtn = document.getElementById('ask-the-barista');
+    const stopBaristaBtn = document.getElementById('stop-barista-btn');
+    const baristaAnswerEl = document.getElementById('barista-answer');
+
+    const feedbackInputEl = document.getElementById('feedback-input');
+    const sentimentBtn = document.getElementById('sentiment-btn');
+    const sentimentOutputEl = document.getElementById('sentiment-output');
+
+    const branchPromptEl = document.getElementById('branch-prompt');
+    const cloneBtn = document.getElementById('clone-btn');
+    const cleanupBtn = document.getElementById('cleanup-btn');
+    const branchOutputEl = document.getElementById('branch-output');
+    const activeBranchesCountEl = document.getElementById('active-branches-count');
+    const contextUsageDisplayEl = document.getElementById('context-usage-display');
+
+    function updateContextUsageUI(session) {
+      activeBranchesCountEl.textContent = String(clonedSessions.length);
+      if (session && typeof session.contextUsage === 'number' && typeof session.contextWindow === 'number') {
+        contextUsageDisplayEl.textContent = `${session.contextUsage} / ${session.contextWindow} tokens`;
+      } else if (session && typeof session.inputUsage === 'number' && typeof session.inputQuota === 'number') {
+        contextUsageDisplayEl.textContent = `${session.inputUsage} / ${session.inputQuota} tokens`;
+      } else {
+        contextUsageDisplayEl.textContent = '0 / 0 tokens';
+      }
+    }
+
+    // Check model availability and initialize a base session with progress monitoring
+    async function ensureBaseSession() {
+      if (baseBaristaSession) {
+        return baseBaristaSession;
+      }
+
+      if (!('LanguageModel' in self)) {
+        throw new Error('The Built-in AI Prompt API (LanguageModel) is not supported in this browser.');
+      }
+
+      const availability = await LanguageModel.availability();
+      if (availability === 'unavailable') {
+        throw new Error('The on-device language model is currently unavailable on this device.');
+      }
+
+      baseBaristaSession = await LanguageModel.create({
+        initialPrompts: [
+          {
+            role: 'system',
+            content: SYSTEM_PROMPT,
+          },
+        ],
+        expectedInputs: [{ type: 'text' }],
+        expectedOutputs: [{ type: 'text' }],
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const percent = Math.round((e.loaded || 0) * 100);
+            downloadStatusEl.textContent = `Downloading on-device AI model: ${percent}%`;
+          });
+        },
+      });
+
+      downloadStatusEl.textContent = 'On-device AI model ready.';
+      updateContextUsageUI(baseBaristaSession);
+      return baseBaristaSession;
+    }
+
+    // Pre-warm the session when the user interacts with the AI sections
+    ['barista-section', 'feedback-section', 'branching-section'].forEach((id) => {
+      const sectionEl = document.getElementById(id);
+      if (sectionEl) {
+        sectionEl.addEventListener(
+          'pointerenter',
+          () => {
+            if ('LanguageModel' in self && !baseBaristaSession) {
+              ensureBaseSession().catch(() => {});
+            }
+          },
+          { once: true }
+        );
+      }
+    });
+
+    // 1. Ask the Barista (Streaming response with availability check and safe DOM rendering)
+    askBaristaBtn.addEventListener('click', async () => {
+      const question = baristaQuestionEl.value.trim();
+      if (!question) {
+        baristaAnswerEl.textContent = 'Please enter a question about the Maple Oat Latte or Cold Brew.';
+        return;
+      }
+
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+      currentAbortController = new AbortController();
+
+      askBaristaBtn.disabled = true;
+      stopBaristaBtn.hidden = false;
+      baristaAnswerEl.textContent = '';
+
+      try {
+        const base = await ensureBaseSession();
+
+        // Clean up previous active barista session before creating a fresh clone
+        if (activeBaristaSession) {
+          activeBaristaSession.destroy();
+          activeBaristaSession = null;
+        }
+
+        activeBaristaSession = await base.clone();
+        const stream = activeBaristaSession.promptStreaming(question, {
+          signal: currentAbortController.signal,
+        });
+
+        let completeResult = '';
+        for await (const chunk of stream) {
+          completeResult += chunk;
+          baristaAnswerEl.append(chunk);
+        }
+
+        updateContextUsageUI(activeBaristaSession);
+      } catch (err) {
+        if (err.name === 'AbortError') {
+          baristaAnswerEl.append('\n[Generation stopped by user]');
+        } else {
+          // Graceful fallback when built-in AI is unsupported or unavailable
+          baristaAnswerEl.textContent =
+            `[Fallback Barista Response (${err.message})]: Our Maple Oat Latte blends rich espresso with velvety oat milk and pure Vermont maple syrup, while our Cold Brew is slow-steeped for 18 hours for a smooth, low-acid finish.`;
+        }
+      } finally {
+        askBaristaBtn.disabled = false;
+        stopBaristaBtn.hidden = true;
+        currentAbortController = null;
+      }
+    });
+
+    stopBaristaBtn.addEventListener('click', () => {
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+    });
+
+    // 2. Customer Feedback Analyzer (Structured JSON output via responseConstraint)
+    sentimentBtn.addEventListener('click', async () => {
+      const feedback = feedbackInputEl.value.trim();
+      if (!feedback) {
+        sentimentOutputEl.textContent = 'Please enter customer feedback to analyze.';
+        return;
+      }
+
+      sentimentBtn.disabled = true;
+      sentimentOutputEl.textContent = 'Analyzing feedback...';
+
+      // Pass the schema as a plain object — do not JSON.stringify() it first
+      const schema = {
+        type: 'object',
+        properties: {
+          score: {
+            type: 'number',
+            minimum: 1,
+            maximum: 5,
+          },
+          category: {
+            type: 'string',
+            enum: ['positive', 'neutral', 'negative', 'product_quality', 'service'],
+          },
+        },
+        required: ['score', 'category'],
+        additionalProperties: false,
+      };
+
+      let analyzerSession = null;
+      try {
+        const base = await ensureBaseSession();
+        analyzerSession = await base.clone();
+
+        const result = await analyzerSession.prompt(
+          `Analyze the sentiment and category of the following customer feedback: "${feedback}"`,
+          { responseConstraint: schema }
+        );
+
+        const parsed = JSON.parse(result);
+        sentimentOutputEl.textContent = JSON.stringify(parsed, null, 2);
+        updateContextUsageUI(analyzerSession);
+      } catch (err) {
+        // Fallback structured JSON response if LanguageModel is unavailable
+        const fallbackData = {
+          score: 5,
+          category: 'positive',
+          note: `Fallback analysis (${err.message})`,
+        };
+        sentimentOutputEl.textContent = JSON.stringify(fallbackData, null, 2);
+      } finally {
+        if (analyzerSession) {
+          analyzerSession.destroy();
+        }
+        sentimentBtn.disabled = false;
+      }
+    });
+
+    // 3. Conversation Branching & Session Cleanup (Cloning sessions, tracking context usage, and destroying unneeded sessions)
+    function cleanupClonedSessions(keepLatest = false) {
+      if (keepLatest && clonedSessions.length > 1) {
+        const toDestroy = clonedSessions.splice(0, clonedSessions.length - 1);
+        for (const oldSession of toDestroy) {
+          oldSession.destroy();
+        }
+      } else if (!keepLatest) {
+        while (clonedSessions.length > 0) {
+          const session = clonedSessions.pop();
+          session.destroy();
+        }
+      }
+      const current = clonedSessions[clonedSessions.length - 1] || activeBaristaSession || baseBaristaSession;
+      updateContextUsageUI(current);
+    }
+
+    cloneBtn.addEventListener('click', async () => {
+      const promptText = branchPromptEl.value.trim();
+      if (!promptText) {
+        branchOutputEl.textContent = 'Please enter a prompt for the cloned session.';
+        return;
+      }
+
+      cloneBtn.disabled = true;
+      branchOutputEl.textContent = 'Cloning session and running prompt...';
+
+      try {
+        const sourceSession = activeBaristaSession || (await ensureBaseSession());
+
+        // Clean up older unneeded branched sessions before creating a new branch
+        cleanupClonedSessions(false);
+
+        const branchedSession = await sourceSession.clone();
+        clonedSessions.push(branchedSession);
+        updateContextUsageUI(branchedSession);
+
+        const response = await branchedSession.prompt(promptText);
+        branchOutputEl.textContent = response;
+        updateContextUsageUI(branchedSession);
+      } catch (err) {
+        branchOutputEl.textContent =
+          `[Fallback Branch Response (${err.message})]: A warm buttery almond croissant or cinnamon morning bun pairs wonderfully with our 18-hour Cold Brew!`;
+      } finally {
+        cloneBtn.disabled = false;
+      }
+    });
+
+    cleanupBtn.addEventListener('click', () => {
+      cleanupClonedSessions(false);
+      if (activeBaristaSession) {
+        activeBaristaSession.destroy();
+        activeBaristaSession = null;
+      }
+      if (baseBaristaSession) {
+        baseBaristaSession.destroy();
+        baseBaristaSession = null;
+      }
+      branchOutputEl.textContent = 'All unneeded sessions have been destroyed and memory freed.';
+      downloadStatusEl.textContent = 'Sessions cleaned up.';
+    });
+
+    // Ensure all sessions are destroyed when unloading the page
+    window.addEventListener('pagehide', () => {
+      cleanupClonedSessions(false);
+      if (activeBaristaSession) {
+        activeBaristaSession.destroy();
+        activeBaristaSession = null;
+      }
+      if (baseBaristaSession) {
+        baseBaristaSession.destroy();
+        baseBaristaSession = null;
+      }
+    });
+  </script>
 </body>
 
