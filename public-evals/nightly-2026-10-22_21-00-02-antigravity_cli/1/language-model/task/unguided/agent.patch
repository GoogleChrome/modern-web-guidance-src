+  <script>
+    // Built-in AI (LanguageModel / Prompt API) State & Session Management
+    const BARISTA_SYSTEM_PROMPT =
+      "You are a friendly, knowledgeable barista at 'The Daily Grind' artisanal coffee shop. " +
+      "You specialize in answering customer questions about two signature drinks: " +
+      "1. 'Maple Oat Latte': Made with rich espresso, steamed creamy oat milk, and pure Vermont maple syrup, topped with a light dusting of cinnamon. Dairy-free and vegan-friendly. " +
+      "2. 'Cold Brew': Crafted from ethically sourced single-origin beans, coarse-ground and steeped in cool filtered water for 18 hours for maximum smoothness and low acidity. " +
+      "Keep answers concise, helpful, and focused on the Maple Oat Latte and Cold Brew.";
+
+    let activeBaristaSession = null;
+    let clonedSessions = [];
+    let currentAbortController = null;
+
+    const askBtn = document.getElementById('ask-the-barista');
+    const cancelBtn = document.getElementById('cancel-barista-btn');
+    const questionInput = document.getElementById('barista-question');
+    const baristaAnswer = document.getElementById('barista-answer');
+    const modelStatus = document.getElementById('model-status');
+    const progressContainer = document.getElementById('download-progress-container');
+    const progressBar = document.getElementById('download-progress-bar');
+
+    const sentimentBtn = document.getElementById('sentiment-btn');
+    const feedbackInput = document.getElementById('feedback-input');
+    const sentimentResult = document.getElementById('sentiment-result');
+
+    const cloneBtn = document.getElementById('clone-btn');
+    const cleanupBtn = document.getElementById('cleanup-btn');
+    const contextUsageEl = document.getElementById('context-usage');
+    const branchOutput = document.getElementById('branch-output');
+
+    // Helper: Resolve the Built-in AI LanguageModel namespace across standard and legacy Chrome APIs
+    function getLanguageModelNamespace() {
+      if (typeof LanguageModel !== 'undefined') {
+        return LanguageModel;
+      }
+      if (typeof window !== 'undefined' && window.ai && window.ai.languageModel) {
+        return window.ai.languageModel;
+      }
+      if (typeof self !== 'undefined' && self.ai && self.ai.languageModel) {
+        return self.ai.languageModel;
+      }
+      return null;
+    }
+
+    // Helper: Check model availability before starting
+    async function checkModelAvailability(options = {
+      expectedInputs: [{ type: 'text', languages: ['en'] }],
+      expectedOutputs: [{ type: 'text', languages: ['en'] }]
+    }) {
+      const lm = getLanguageModelNamespace();
+      if (!lm) {
+        modelStatus.textContent = 'Model status: Built-in AI API not supported in this browser';
+        return 'unavailable';
+      }
+
+      if (typeof lm.availability === 'function') {
+        const status = await lm.availability(options);
+        modelStatus.textContent = `Model status: ${status}`;
+        return status;
+      }
+
+      if (typeof lm.capabilities === 'function') {
+        const caps = await lm.capabilities();
+        const status = caps && caps.available ? caps.available : 'unavailable';
+        modelStatus.textContent = `Model status: ${status}`;
+        return status;
+      }
+
+      return 'available';
+    }
+
+    // Helper: Shared download progress monitor callback for LanguageModel.create()
+    function createDownloadMonitor(m) {
+      m.addEventListener('downloadprogress', (e) => {
+        progressContainer.style.display = 'block';
+        const fraction = e.total ? e.loaded / e.total : (typeof e.loaded === 'number' ? e.loaded : 0);
+        const percent = Math.min(100, Math.round(fraction * 100));
+        progressBar.style.width = `${percent}%`;
+        modelStatus.textContent = `Downloading model: ${percent}%`;
+        if (percent >= 100) {
+          setTimeout(() => {
+            progressContainer.style.display = 'none';
+          }, 600);
+        }
+      });
+    }
+
+    // Helper: Read context usage and quota across standard (contextUsage/contextWindow) and legacy (inputUsage/inputQuota) properties
+    function getSessionUsageStats(session) {
+      if (!session) {
+        return { usage: 0, quota: 0, remaining: 0, percentage: 0 };
+      }
+      const usage = session.contextUsage ?? session.inputUsage ?? session.tokensSoFar ?? 0;
+      const quota = session.contextWindow ?? session.inputQuota ?? session.maxTokens ?? 0;
+      const remaining = Math.max(0, quota - usage);
+      const percentage = quota > 0 ? Math.round((usage / quota) * 100) : 0;
+      return { usage, quota, remaining, percentage };
+    }
+
+    // Helper: Update the UI display for context usage & active cloned sessions
+    function updateContextUsageDisplay(session = activeBaristaSession) {
+      const stats = getSessionUsageStats(session);
+      contextUsageEl.textContent =
+        `Context Usage: ${stats.usage} / ${stats.quota} tokens (${stats.percentage}%) | Active Clones: ${clonedSessions.length}`;
+      return stats;
+    }
+
+    // Helper: Safely destroy a session and release resources
+    function destroySessionSafely(session) {
+      if (session && typeof session.destroy === 'function') {
+        try {
+          session.destroy();
+        } catch (err) {
+          console.warn('Error destroying AI session:', err);
+        }
+      }
+    }
+
+    // Helper: Clean up unneeded cloned sessions or sessions exceeding context threshold
+    function cleanupUnneededSessions(keepLatestCount = 0) {
+      let cleanedCount = 0;
+      while (clonedSessions.length > keepLatestCount) {
+        const oldSession = clonedSessions.shift();
+        destroySessionSafely(oldSession);
+        cleanedCount++;
+      }
+      updateContextUsageDisplay();
+      return cleanedCount;
+    }
+
+    // Helper: Ensure an active barista session exists (and recreate if context window is nearly full)
+    async function ensureBaristaSession(signal) {
+      const availability = await checkModelAvailability();
+      if (availability === 'unavailable' || availability === 'no') {
+        throw new Error('The built-in AI language model is unavailable on this device.');
+      }
+
+      // If existing session is over 90% of its context quota, clean it up and create a fresh session
+      if (activeBaristaSession) {
+        const stats = getSessionUsageStats(activeBaristaSession);
+        if (stats.quota > 0 && stats.usage / stats.quota > 0.9) {
+          destroySessionSafely(activeBaristaSession);
+          activeBaristaSession = null;
+        }
+      }
+
+      if (!activeBaristaSession) {
+        const lm = getLanguageModelNamespace();
+        activeBaristaSession = await lm.create({
+          initialPrompts: [
+            { role: 'system', content: BARISTA_SYSTEM_PROMPT }
+          ],
+          expectedInputs: [{ type: 'text', languages: ['en'] }],
+          expectedOutputs: [{ type: 'text', languages: ['en'] }],
+          signal,
+          monitor: createDownloadMonitor
+        });
+
+        // Listen for contextoverflow event if supported
+        if (typeof activeBaristaSession.addEventListener === 'function') {
+          activeBaristaSession.addEventListener('contextoverflow', () => {
+            modelStatus.textContent = 'Model status: Context overflow warning (pruning old history)';
+            updateContextUsageDisplay();
+          });
+        }
+      }
+
+      updateContextUsageDisplay(activeBaristaSession);
+      return activeBaristaSession;
+    }
+
+    // 1. Ask the Barista (Streaming answers about Maple Oat Latte or Cold Brew)
+    askBtn.addEventListener('click', async () => {
+      const rawQuestion = questionInput.value.trim();
+      const userPrompt = rawQuestion || 'Tell me about the Maple Oat Latte and the Cold Brew.';
+
+      // Cancel any in-flight generation before starting a new one
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+      currentAbortController = new AbortController();
+      const { signal } = currentAbortController;
+
+      askBtn.disabled = true;
+      cancelBtn.style.display = 'inline-block';
+      baristaAnswer.textContent = '';
+
+      try {
+        const session = await ensureBaristaSession(signal);
+        modelStatus.textContent = 'Model status: Streaming response...';
+
+        const contextualPrompt =
+          `Customer question (focus on Maple Oat Latte or Cold Brew): ${userPrompt}`;
+
+        const stream = session.promptStreaming(contextualPrompt, { signal });
+
+        let accumulated = '';
+        for await (const chunk of stream) {
+          // Handle both delta chunks (modern standard) and cumulative chunks (legacy)
+          if (accumulated && chunk.startsWith(accumulated)) {
+            accumulated = chunk;
+          } else {
+            accumulated += chunk;
+          }
+          baristaAnswer.textContent = accumulated;
+        }
+
+        modelStatus.textContent = 'Model status: Response complete';
+        updateContextUsageDisplay(session);
+      } catch (error) {
+        if (error.name === 'AbortError') {
+          baristaAnswer.textContent += '\n[Generation cancelled]';
+          modelStatus.textContent = 'Model status: Cancelled';
+        } else {
+          baristaAnswer.textContent = `Unable to get barista response: ${error.message}`;
+          modelStatus.textContent = 'Model status: Error';
+        }
+      } finally {
+        askBtn.disabled = false;
+        cancelBtn.style.display = 'none';
+        currentAbortController = null;
+      }
+    });
+
+    cancelBtn.addEventListener('click', () => {
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+    });
+
+    // 2. Customer Feedback Analyzer (Structured JSON output with score & category using responseConstraint)
+    sentimentBtn.addEventListener('click', async () => {
+      const feedbackText = feedbackInput.value.trim() || 'Great Maple Oat Latte and super smooth Cold Brew!';
+      sentimentBtn.disabled = true;
+      sentimentResult.textContent = 'Analyzing feedback...';
+
+      let analyzerSession = null;
+      const controller = new AbortController();
+
+      const feedbackSchema = {
+        type: 'object',
+        properties: {
+          score: {
+            type: 'number',
+            description: 'Sentiment score from 1 (very negative) to 10 (very positive) or 0.0 to 1.0'
+          },
+          category: {
+            type: 'string',
+            enum: ['Positive', 'Neutral', 'Negative', 'Product Quality', 'Customer Service']
+          }
+        },
+        required: ['score', 'category'],
+        additionalProperties: false
+      };
+
+      try {
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable' || availability === 'no') {
+          throw new Error('Built-in AI model is unavailable on this device.');
+        }
+
+        const lm = getLanguageModelNamespace();
+        analyzerSession = await lm.create({
+          initialPrompts: [
+            {
+              role: 'system',
+              content:
+                'You are a customer feedback analyzer for The Daily Grind coffee shop. ' +
+                'Analyze the customer review and respond strictly with a JSON object containing a numeric "score" and a "category".'
+            }
+          ],
+          signal: controller.signal,
+          monitor: createDownloadMonitor
+        });
+
+        const rawResponse = await analyzerSession.prompt(
+          `Analyze the following customer feedback and return JSON with score and category:\n"${feedbackText}"`,
+          {
+            responseConstraint: feedbackSchema,
+            signal: controller.signal
+          }
+        );
+
+        let parsedJson;
+        try {
+          parsedJson = JSON.parse(rawResponse);
+        } catch {
+          // Fallback extraction if model wrapped JSON in markdown fences
+          const match = String(rawResponse).match(/\{[\s\S]*\}/);
+          parsedJson = match ? JSON.parse(match[0]) : { score: 0, category: 'Neutral', raw: rawResponse };
+        }
+
+        sentimentResult.textContent = JSON.stringify(parsedJson, null, 2);
+      } catch (error) {
+        sentimentResult.textContent = JSON.stringify(
+          { error: error.message, score: null, category: 'Unavailable' },
+          null,
+          2
+        );
+      } finally {
+        // Best practice: immediately destroy one-off analyzer session to free memory/VRAM
+        destroySessionSafely(analyzerSession);
+        sentimentBtn.disabled = false;
+      }
+    });
+
+    // 3. Conversation Branching & Context Usage Tracking (Clone active sessions & clean up unneeded sessions)
+    cloneBtn.addEventListener('click', async () => {
+      cloneBtn.disabled = true;
+      const controller = new AbortController();
+
+      try {
+        // Ensure we have an active base session to clone from
+        const baseSession = await ensureBaristaSession(controller.signal);
+
+        // Clean up older unneeded cloned sessions before creating a new branch to conserve resources
+        const cleanedBefore = cleanupUnneededSessions(1);
+
+        // Clone the active session using session.clone()
+        const clonedSession = await baseSession.clone({ signal: controller.signal });
+        clonedSessions.push(clonedSession);
+
+        // Measure or track context usage on both base and cloned sessions
+        const branchPrompt = 'What makes the Maple Oat Latte and Cold Brew pair well with breakfast pastries?';
+        let measuredPromptTokens = 0;
+        if (typeof clonedSession.measureInputUsage === 'function') {
+          measuredPromptTokens = await clonedSession.measureInputUsage(branchPrompt, { signal: controller.signal });
+        } else if (typeof clonedSession.countPromptTokens === 'function') {
+          measuredPromptTokens = await clonedSession.countPromptTokens(branchPrompt, { signal: controller.signal });
+        }
+
+        const branchReply = await clonedSession.prompt(branchPrompt, { signal: controller.signal });
+        const clonedStats = getSessionUsageStats(clonedSession);
+        const baseStats = updateContextUsageDisplay(baseSession);
+
+        // If cloned session is only needed for this branch exploration or exceeds threshold, clean up older clones
+        if (clonedSessions.length > 1 || (clonedStats.quota > 0 && clonedStats.usage / clonedStats.quota > 0.8)) {
+          cleanupUnneededSessions(1);
+        }
+
+        branchOutput.textContent =
+          `Cloned Session Branch Created!\n` +
+          `• Base Session Context: ${baseStats.usage} / ${baseStats.quota} tokens (${baseStats.percentage}%)\n` +
+          `• Cloned Session Context: ${clonedStats.usage} / ${clonedStats.quota} tokens (${clonedStats.percentage}%)\n` +
+          (measuredPromptTokens ? `• Branch Prompt Token Cost: ${measuredPromptTokens} tokens\n` : '') +
+          `• Unneeded Sessions Cleaned Up: ${cleanedBefore}\n\n` +
+          `Branch Response:\n${branchReply}`;
+      } catch (error) {
+        branchOutput.textContent = `Session cloning error: ${error.message}`;
+      } finally {
+        cloneBtn.disabled = false;
+      }
+    });
+
+    cleanupBtn.addEventListener('click', () => {
+      const cleanedClones = cleanupUnneededSessions(0);
+      let baseDestroyed = false;
+      if (activeBaristaSession) {
+        destroySessionSafely(activeBaristaSession);
+        activeBaristaSession = null;
+        baseDestroyed = true;
+      }
+      updateContextUsageDisplay(null);
+      branchOutput.textContent =
+        `Cleaned up ${cleanedClones} cloned session(s)` +
+        (baseDestroyed ? ' and destroyed the active barista session.' : '.');
+    });
+
+    // Clean up all active and cloned AI sessions when the page unloads to prevent memory leaks
+    window.addEventListener('pagehide', () => {
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+      cleanupUnneededSessions(0);
+      destroySessionSafely(activeBaristaSession);
+      activeBaristaSession = null;
+    });
+  </script>
