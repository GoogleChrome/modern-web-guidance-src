diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,132 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    function getElementSelector(el) {
+      if (!el || !(el instanceof Element)) return 'unknown';
+      if (el.id) return `#${el.id}`;
+      let selector = el.tagName.toLowerCase();
+      if (el.className && typeof el.className === 'string') {
+        const classes = el.className.trim().split(/\s+/).filter(Boolean);
+        if (classes.length) selector += `.${classes.join('.')}`;
+      }
+      const href = el.getAttribute('href');
+      if (href) selector += `[href="${href}"]`;
+      return selector;
+    }
+
+    // 1. Event Timing API observer to measure interaction sub-parts and identify slow interactions
+    if ('PerformanceObserver' in window && PerformanceObserver.supportedEntryTypes) {
+      if (PerformanceObserver.supportedEntryTypes.includes('event')) {
+        const interactionMap = new Map();
+
+        const eventObserver = new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            if (!entry.interactionId) continue;
+
+            const inputDelay = entry.processingStart - entry.startTime;
+            const processingDuration = entry.processingEnd - entry.processingStart;
+            const presentationDelay = Math.max(0, entry.startTime + entry.duration - entry.processingEnd);
+            const targetSelector = getElementSelector(entry.target);
+
+            const diagnostic = {
+              interactionId: entry.interactionId,
+              eventType: entry.name,
+              interactionTarget: targetSelector,
+              targetElement: entry.target,
+              duration: entry.duration,
+              startTime: entry.startTime,
+              inputDelay,
+              processingDuration,
+              presentationDelay,
+              rating: entry.duration > 500 ? 'poor' : entry.duration > 200 ? 'needs-improvement' : 'good',
+            };
+
+            const existing = interactionMap.get(entry.interactionId);
+            if (!existing || entry.duration > existing.duration) {
+              interactionMap.set(entry.interactionId, diagnostic);
+            }
+
+            if (entry.duration > 200) {
+              console.warn('[INP Diagnostic] Slow interaction detected:', diagnostic);
+            } else {
+              console.log('[INP Diagnostic] Interaction recorded:', diagnostic);
+            }
+          }
+        });
+
+        eventObserver.observe({
+          type: 'event',
+          buffered: true,
+          durationThreshold: 16,
+        });
+      }
+
+      // 2. Long Animation Frames (LoAF) API observer to pinpoint scripts & rendering causing main-thread blocking
+      if (PerformanceObserver.supportedEntryTypes.includes('long-animation-frame')) {
+        const loafObserver = new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            const scripts = (entry.scripts || []).map((script) => ({
+              invoker: script.invoker,
+              invokerType: script.invokerType,
+              sourceURL: script.sourceURL,
+              sourceFunctionName: script.sourceFunctionName,
+              sourceCharPosition: script.sourceCharPosition,
+              duration: script.duration,
+              executionStart: script.executionStart,
+              forcedStyleAndLayoutDuration: script.forcedStyleAndLayoutDuration,
+            }));
+
+            console.log('[INP Diagnostic] Long Animation Frame (LoAF):', {
+              startTime: entry.startTime,
+              duration: entry.duration,
+              blockingDuration: entry.blockingDuration,
+              renderStart: entry.renderStart,
+              styleAndLayoutStart: entry.styleAndLayoutStart,
+              firstUIEventTimestamp: entry.firstUIEventTimestamp,
+              scripts,
+            });
+          }
+        });
+
+        loafObserver.observe({
+          type: 'long-animation-frame',
+          buffered: true,
+        });
+      }
+    }
+
+    // 3. web-vitals INP attribution build for full field INP attribution reporting
+    import('https://unpkg.com/web-vitals@4/dist/web-vitals.attribution.js')
+      .then(({ onINP }) => {
+        onINP(
+          (metric) => {
+            const { attribution } = metric;
+            console.log('[INP Attribution]', {
+              value: metric.value,
+              rating: metric.rating,
+              interactionTarget: attribution.interactionTarget,
+              interactionTargetElement: attribution.interactionTargetElement,
+              interactionType: attribution.interactionType,
+              interactionTime: attribution.interactionTime,
+              nextPaintTime: attribution.nextPaintTime,
+              inputDelay: attribution.inputDelay,
+              processingDuration: attribution.processingDuration,
+              presentationDelay: attribution.presentationDelay,
+              loadState: attribution.loadState,
+              longestScript: attribution.longestScript,
+              longAnimationFrameEntries: attribution.longAnimationFrameEntries,
+            });
+          },
+          { reportAllChanges: true }
+        );
+      })
+      .catch(() => {
+        // Fallback if offline or CDN is unreachable; native PerformanceObservers above remain active.
+      });
+  </script>
+
 </body>
 
 </html>
