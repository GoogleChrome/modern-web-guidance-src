+    .preview-bottom { display:flex; align-items:center; justify-content:space-between; gap:10px; }
+    .legend { font-family:var(--mono); font-size:8px; color:#7c886f; display:flex; align-items:center; gap:6px; } .legend i { width:12px; height:1px; background:#839a70; display:inline-block; }
+    .size { font-family:var(--mono); font-size:8px; color:#7c886f; }
