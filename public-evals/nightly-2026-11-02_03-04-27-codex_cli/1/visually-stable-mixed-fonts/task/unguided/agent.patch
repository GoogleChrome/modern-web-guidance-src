+    .switch:checked { background:var(--green); } .switch::after { content:''; position:absolute; top:3px; left:3px; width:10px; height:10px; background:white; border-radius:50%; transition:transform .2s; } .switch:checked::after { transform:translateX(11px); }
+    .preview { margin:0 18px; min-height:239px; border:1px solid #e0e6d8; border-radius:7px; position:relative; overflow:hidden; background:#f0f4e9; padding:23px; display:flex; flex-direction:column; justify-content:space-between; }
+    .preview-kicker { font-family:var(--mono); font-size:8px; letter-spacing:1.2px; color:#7e8b70; text-transform:uppercase; }
