+    @media(min-width:1500px) { .shell {max-width:1320px;} main {padding-top:70px;} .preview {min-height:270px;} }
+    @media(max-width:850px) { .shell{padding:0 25px;} .workspace{grid-template-columns:1fr 1fr;gap:14px;} .hero-note{display:none;} .panel-head{padding:20px 16px;} .controls{padding:0 16px 17px;flex-wrap:wrap;} .preview{margin:0 10px;padding:18px;min-height:260px;} .sample{font-size:24px;} .theme-sample{font-size:29px;} .panel-description{padding:17px 18px;} .tag{font-size:8px;} .explainer{gap:18px;} }
+    @media(max-width:600px) { header{height:78px;} .edition{display:none;} .shell{padding:0 20px;} main{padding-top:35px;} h1{letter-spacing:-1.8px;font-size:43px;} .hero{margin-bottom:28px;} .intro{font-size:13px;} .workspace{grid-template-columns:1fr;gap:20px;} .controls{flex-wrap:nowrap;} .preview{min-height:225px;margin:0 14px;} .sample{font-size:27px;} .theme-sample{font-size:32px;} .explainer{grid-template-columns:1fr;gap:20px;padding:26px 0;} .fact p{max-width:none;} .settings{gap:10px;} .size-control{gap:10px;} input[type=range]{width:95px;} footer{font-size:8px;} }
+  </style>
+</head>
+<body>
+<div class="shell">
+  <header>
+    <div class="brand"><span class="brand-icon" aria-hidden="true">t*</span>typeform<span style="color:#829375">.</span></div>
+    <div class="header-right"><span class="edition">Experiments in typography</span><span class="lab-label"><span class="dot"></span> The type lab</span></div>
+  </header>
+  <main>
+    <div class="eyebrow">A small detail. A better reading experience.</div>
+    <div class="hero"><div><h1>Different fonts.<br>Same <span>harmony.</span></h1><p class="intro">Bring your fonts into balance with <span style="font-family:var(--mono);font-size:12px;color:#4d6247">font-size-adjust</span>.<br>Consistent visual height, even when the typefaces change.</p></div><div class="hero-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-14-2 18"/></svg> Pure CSS. Naturally balanced.</div></div>
+    <div class="workspace">
+      <section class="panel" aria-labelledby="mixed-heading">
+        <div class="panel-head"><div class="panel-heading"><span class="number">01</span><h2 id="mixed-heading">Mixed fonts, one rhythm</h2></div><span class="tag">Automatic</span></div>
+        <div class="controls"><div class="segmented" aria-label="Text font family"><button class="active" data-font="sans" aria-pressed="true">Sans serif</button><button data-font="serif" aria-pressed="false">Serif</button></div><label class="toggle-label"><input id="normalize" class="switch" type="checkbox" checked>Normalize height</label></div>
+        <div class="preview"><span class="preview-kicker">The mixed-font playground</span><p id="mixed-fonts-container" class="sample">Good design is in the details.<br>Even a little <code>inline code</code><br>should feel right at home.</p><div class="preview-bottom"><span class="legend"><i></i><span id="font-legend">Arial + IBM Plex Mono</span></span><span class="size" id="mixed-size">27px / auto</span></div></div>
+        <p class="panel-description">One shared x-height. Your inline code follows the surrounding text,<br class="desktop-break"> keeping every line comfortable and beautifully consistent.</p>
+        <div class="code-box"><div class="code-header"><span>CSS</span><button class="copy" data-copy="mixed" aria-label="Copy mixed fonts CSS"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor"><rect x="5" y="5" width="8" height="8" rx="1.5"/><path d="M10 5V3a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"/></svg><span>Copy</span></button></div><pre><span class="selector">#mixed-fonts-container</span> {
+  font-size-adjust: <span class="value" id="mixed-code-value">from-font</span>;
+}</pre></div>
+      </section>
+      <section class="panel" aria-labelledby="theme-heading">
+        <div class="panel-head"><div class="panel-heading"><span class="number">02</span><h2 id="theme-heading">A world of its own</h2></div><span class="tag">Independent</span></div>
+        <div class="controls"><span class="control-label">An independent theme</span><span style="font:10px var(--mono);color:#5b7152">Ratio <span style="background:#edf2e8;padding:4px 7px;border-radius:4px;margin-left:5px">0.5</span></span></div>
+        <div id="independent-theme-container" class="preview dark"><span class="preview-kicker">The independent theme</span><p class="theme-sample">Its own style.<br>Its own <em>proportions.</em><br>Always <code>in balance.</code></p><div class="preview-bottom"><span class="legend"><i></i>Georgia + IBM Plex Mono</span><span class="size">x-height / 0.5</span></div></div>
+        <p class="panel-description">A fixed aspect value gives this theme its own visual identity.<br class="desktop-break"> Predictable proportions, independent of the surrounding text.</p>
+        <div class="code-box"><div class="code-header"><span>CSS</span><button class="copy" data-copy="theme" aria-label="Copy independent theme CSS"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor"><rect x="5" y="5" width="8" height="8" rx="1.5"/><path d="M10 5V3a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2"/></svg><span>Copy</span></button></div><pre><span class="selector">#independent-theme-container</span> {
+  font-size-adjust: <span class="value">0.5</span>;
+}</pre></div>
+      </section>
+    </div>
+    <div class="settings"><label class="size-control" for="font-size">Play with the text size <input id="font-size" type="range" min="20" max="34" value="27"><output id="size-output" for="font-size">27px</output></label><button class="reset" id="reset"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3 6a5 5 0 1 1 0 4M3 2v4h4"/></svg>Reset playground</button></div>
+    <div class="explainer">
+      <div class="fact"><span class="fact-icon">x</span><div><h3>Height over size</h3><p>Matches the visual height of lowercase letters, so different fonts feel like they belong together.</p></div></div>
+      <div class="fact"><span class="fact-icon"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor"><path d="m7 5-5 5 5 5m6-10 5 5-5 5m-2-13-2 16"/></svg></span><div><h3>Less tweaking. More creating.</h3><p>Let the browser handle the font metrics. No manual scaling or font-specific workarounds.</p></div></div>
+      <div class="fact"><span class="fact-icon"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor"><rect x="3" y="3" width="14" height="14" rx="3"/><path d="M10 3v14M3 10h14"/></svg></span><div><h3>Local control, by design</h3><p>Set a numeric ratio to give a component its own proportions, wherever it lives.</p></div></div>
+    </div>
+  </main>
+  <footer><span class="footer-mark"><span>✳</span> Little experiments. Better interfaces.</span><span>Made for the love of type.</span></footer>
+</div>
+<script>
+  const sample = document.getElementById('mixed-fonts-container');
+  const normalize = document.getElementById('normalize');
+  const slider = document.getElementById('font-size');
+  let selectedFont = 'sans';
+  function update() {
+    sample.style.fontFamily = selectedFont === 'sans' ? 'Arial, sans-serif' : 'Georgia, serif';
+    sample.style.fontSize = slider.value + 'px';
+    sample.style.fontSizeAdjust = normalize.checked ? 'from-font' : 'none';
+    document.getElementById('size-output').value = slider.value + 'px';
+    document.getElementById('mixed-size').textContent = slider.value + 'px / ' + (normalize.checked ? 'auto' : 'unadjusted');
+    document.getElementById('mixed-code-value').textContent = normalize.checked ? 'from-font' : 'none';
+    document.getElementById('font-legend').textContent = (selectedFont === 'sans' ? 'Arial' : 'Georgia') + ' + IBM Plex Mono';
+    document.querySelectorAll('[data-font]').forEach(button => {
+      const active = button.dataset.font === selectedFont;
+      button.classList.toggle('active', active);
+      button.setAttribute('aria-pressed', String(active));
+    });
+  }
+  document.querySelectorAll('[data-font]').forEach(button => button.addEventListener('click', () => { selectedFont = button.dataset.font; update(); }));
+  normalize.addEventListener('change', update);
+  slider.addEventListener('input', update);
+  document.getElementById('reset').addEventListener('click', () => { selectedFont = 'sans'; normalize.checked = true; slider.value = '27'; update(); });
+  document.querySelectorAll('[data-copy]').forEach(button => button.addEventListener('click', async () => {
+    const css = button.dataset.copy === 'mixed'
+      ? '#mixed-fonts-container {\n  font-size-adjust: ' + (normalize.checked ? 'from-font' : 'none') + ';\n}'
+      : '#independent-theme-container {\n  font-size-adjust: 0.5;\n}';
+    const label = button.querySelector('span');
+    try { await navigator.clipboard.writeText(css); label.textContent = 'Copied!'; }
+    catch { label.textContent = 'Copy unavailable'; }
+    setTimeout(() => { label.textContent = 'Copy'; }, 2000);
+  }));
+</script>
+</body>
+</html>
