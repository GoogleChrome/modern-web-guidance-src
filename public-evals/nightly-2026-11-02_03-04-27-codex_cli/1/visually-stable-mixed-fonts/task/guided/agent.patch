+    h1 { font-size: clamp(2rem, 1.6rem + 1.7vw, 3.1rem); font-weight: 500; letter-spacing: -.055em; line-height: 1.15; margin: 15px 0 13px; text-wrap: balance; }
+    .intro { color: var(--muted); margin: 0; font-size: .92rem; }
+    .title-row { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 37px; }
