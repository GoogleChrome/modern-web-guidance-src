+    .brand span:last-child { color: #8b9591; font-size: .65rem; letter-spacing: .08em; border-left: 1px solid var(--line); padding-left: 16px; margin-left: 8px; font-weight: 400; }
+    .header-link { color: #63706a; display: flex; align-items: center; gap: 10px; font-size: .8rem; }
+    main { max-width: 1160px; padding: 57px 32px 35px; margin: auto; }
