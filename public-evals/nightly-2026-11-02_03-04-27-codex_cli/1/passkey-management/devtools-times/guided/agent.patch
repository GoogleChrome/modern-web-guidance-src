index 0000000..18dc495
--- /dev/null
+++ b/src/pages/api/account/login.ts
@@ -0,0 +1,29 @@
+import type { APIRoute } from 'astro';
+import { readerForVerifiedLogin } from '../../../lib/server/accounts';
+import { json, sameOrigin } from '../../../lib/server/account-http';
+
+export const POST: APIRoute = async (context) => {
+  if (!sameOrigin(context)) return json({ error: 'Request origin is not allowed.' }, 403);
+  if (!context.session) return json({ error: 'Sign-in is temporarily unavailable.' }, 503);
+  let body;
+  try { body = await context.request.json(); } catch { return json({ error: 'Invalid request.' }, 400); }
+  if (typeof body?.username !== 'string' || !body.username.trim() || body.username.length > 200 ||
+      typeof body.password !== 'string' || !body.password || body.password.length > 1000) {
+    return json({ error: 'Enter your username and password.' }, 400);
+  }
+  try {
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: body.username, password: body.password }),
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok) return json({ error: 'Unable to sign in. Check your username and password.' }, response.status >= 500 ? 502 : 401);
+    const reader = readerForVerifiedLogin(body.username);
+    await context.session.regenerate();
+    context.session.delete('passkeyRegistration');
+    context.session.set('reader', { id: reader.id, expiresAt: Date.now() + 8 * 60 * 60 * 1000 });
+    return json({ success: true });
+  } catch {
+    return json({ error: 'Sign-in is temporarily unavailable. Please try again.' }, 502);
+  }
+};
