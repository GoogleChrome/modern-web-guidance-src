diff --git a/src/components/PasskeySettings.tsx b/src/components/PasskeySettings.tsx
new file mode 100644
index 0000000..043ce9d
--- /dev/null
+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,258 @@
+import { useEffect, useRef, useState } from 'react';
+
+interface Passkey {
+  id: string;
+  name: string;
+  provider: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt: number | null;
+}
+interface ManagementData {
+  user: { id: string; username: string };
+  rpId: string;
+  passkeys: Passkey[];
+}
+type SignalCredential = typeof PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalUnknownCredential?: (options: { rpId: string; credentialId: string }) => Promise<void>;
+};
+
+const api = `${import.meta.env.BASE_URL}api/passkeys`;
+const button = 'rounded border border-gray-300 px-3 py-2 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:cursor-wait disabled:opacity-50';
+
+function dateLabel(timestamp: number | null, fallback: string) {
+  if (timestamp === null) return fallback;
+  const date = new Date(timestamp);
+  return Number.isNaN(date.getTime()) ? fallback : date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+}
+
+async function request(url: string, options?: RequestInit) {
+  const response = await fetch(url, { ...options, cache: 'no-store', credentials: 'same-origin',
+    headers: { 'Content-Type': 'application/json', ...options?.headers } });
+  if (response.status === 401) {
+    window.location.assign(`${import.meta.env.BASE_URL}signin`);
+    throw new Error('Your session has expired. Please sign in again.');
+  }
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.error || 'Could not update your passkeys. Please try again.');
+  return data;
+}
+
+export default function PasskeySettings() {
+  const [data, setData] = useState<ManagementData | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const [syncNotice, setSyncNotice] = useState('');
+  const [syncFailed, setSyncFailed] = useState(false);
+  const [canCreate, setCanCreate] = useState(false);
+  const [edit, setEdit] = useState<{ id: string; action: 'rename' | 'remove' } | null>(null);
+  const [name, setName] = useState('');
+  const focusAfterEdit = useRef<string | null>(null);
+  const listHeading = useRef<HTMLHeadingElement>(null);
+
+  async function syncAccepted(current: ManagementData) {
+    setSyncFailed(false);
+    const credential = window.PublicKeyCredential as SignalCredential | undefined;
+    if (!window.isSecureContext || !credential?.signalAllAcceptedCredentials) {
+      setSyncNotice('This browser cannot update your password manager automatically. Remove unused passkeys there too.');
+      return;
+    }
+    try {
+      // IDs are persisted as Base64URL strings, including the original WebAuthn user handle.
+      await credential.signalAllAcceptedCredentials({ rpId: current.rpId, userId: current.user.id,
+        allAcceptedCredentialIds: current.passkeys.map(key => key.id) });
+      setSyncNotice('Your browser’s password manager has been notified of your registered passkeys.');
+    } catch {
+      setSyncFailed(true);
+      setSyncNotice('Your account is up to date, but your password manager could not be updated. Retry syncing or remove unused passkeys there manually.');
+    }
+  }
+
+  useEffect(() => {
+    const controller = new AbortController();
+    async function load() {
+      try {
+        const current = await request(api, { signal: controller.signal }) as ManagementData;
+        if (controller.signal.aborted) return;
+        setData(current);
+        await syncAccepted(current);
+      } catch (err) {
+        if (!controller.signal.aborted) setError(err instanceof Error ? err.message : 'Could not load your passkeys.');
+      } finally {
+        if (!controller.signal.aborted) setLoading(false);
+      }
+    }
+    void load();
+    async function capabilities() {
+      if (!window.isSecureContext || !window.PublicKeyCredential) return;
+      try {
+        await import('webauthn-polyfills');
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!controller.signal.aborted) setCanCreate(Boolean(capabilities.passkeyPlatformAuthenticator && capabilities.conditionalGet));
+      } catch { /* Password sign-in and credential management remain available. */ }
+    }
+    void capabilities();
+    return () => controller.abort();
+  }, []);
+
+  useEffect(() => {
+    if (!edit && focusAfterEdit.current) {
+      const target = document.getElementById(focusAfterEdit.current);
+      (target || listHeading.current)?.focus();
+      focusAfterEdit.current = null;
+    }
+  }, [edit]);
+
+  async function reload() {
+    setBusy(true); setError('');
+    try {
+      const current = await request(api) as ManagementData;
+      setData(current);
+      await syncAccepted(current);
+    } catch (err) { setError(err instanceof Error ? err.message : 'Could not refresh your passkeys.'); }
+    finally { setBusy(false); }
+  }
+
+  async function save() {
+    if (!edit || !data) return;
+    if (edit.action === 'rename' && (!name.trim() || name.trim().length > 100)) {
+      setError('Choose a display name between 1 and 100 characters.'); return;
+    }
+    setBusy(true); setError(''); setMessage('');
+    try {
+      const current = await request(api, { method: edit.action === 'rename' ? 'PATCH' : 'DELETE',
+        body: JSON.stringify({ id: edit.id, name: name.trim() }) }) as ManagementData;
+      setData(current);
+      setMessage(edit.action === 'rename' ? 'Passkey display name updated.' : 'Passkey removed from your account.');
+      const removed = edit.action === 'remove';
+      setEdit(null);
+      // A nickname is only an account label. It must not signal user profile changes.
+      if (removed) await syncAccepted(current);
+    } catch (err) { setError(err instanceof Error ? err.message : 'Could not save your change.'); }
+    finally { setBusy(false); }
+  }
+
+  async function createPasskey() {
+    setBusy(true); setError(''); setMessage('');
+    try {
+      const options = await request(`${api}/register`, { method: 'POST', body: JSON.stringify({ action: 'options' }) });
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+      const credential = await navigator.credentials.create({ publicKey }) as PublicKeyCredential | null;
+      if (!credential) throw new Error('Passkey creation was cancelled.');
+      let current: ManagementData;
+      try {
+        current = await request(`${api}/register`, { method: 'POST', body: JSON.stringify({ credential: credential.toJSON() }) });
+      } catch (err) {
+        // A lost response may still mean the server saved the credential. Read back before cleanup.
+        let confirmedAbsent = false;
+        try {
+          const latest = await request(api) as ManagementData;
+          if (latest.passkeys.some(key => key.id === credential.id)) {
+            setData(latest); setMessage('Passkey created.'); await syncAccepted(latest); return;
+          }
+          confirmedAbsent = true;
+        } catch { /* Do not discard a possibly accepted credential while the server is unreachable. */ }
+        const signals = PublicKeyCredential as SignalCredential;
+        if (confirmedAbsent && signals.signalUnknownCredential) {
+          try { await signals.signalUnknownCredential({ rpId: options.rp.id, credentialId: credential.id }); } catch { /* Best effort cleanup. */ }
+        }
+        throw err;
+      }
+      setData(current); setMessage('Passkey created.');
+      await syncAccepted(current);
+    } catch (err) {
+      const code = err instanceof DOMException ? err.name : '';
+      setError(code === 'NotAllowedError' || code === 'AbortError' ? 'Passkey creation was cancelled or timed out. You can try again.'
+        : code === 'InvalidStateError' ? 'This authenticator already has a passkey for your account.'
+        : code === 'SecurityError' ? 'Passkeys require a secure connection on this site’s registered domain.'
+        : err instanceof Error ? err.message : 'Could not create a passkey. Please try again.');
+    } finally { setBusy(false); }
+  }
+
+  async function signOut() {
+    setBusy(true); setError('');
+    try {
+      await request(`${import.meta.env.BASE_URL}api/account/logout`, { method: 'POST', body: '{}' });
+      window.location.assign(import.meta.env.BASE_URL);
+    } catch { setError('Could not sign out. Please try again.'); setBusy(false); }
+  }
+
+  return <>
+    <section aria-labelledby="passkeys-heading" className="rounded-lg border border-gray-300 bg-white">
+      <div className="border-b border-gray-200 p-5 sm:p-6">
+        <div className="flex flex-wrap items-center justify-between gap-4">
+          <h2 id="passkeys-heading" ref={listHeading} tabIndex={-1} className="text-2xl font-bold text-gray-900">Passkeys</h2>
+          {canCreate && <button type="button" className={`${button} bg-gray-900 text-white hover:bg-gray-700`} disabled={loading || busy || !data || Boolean(edit)} onClick={createPasskey}>Create passkey</button>}
+        </div>
+        <p className="mt-3 text-sm leading-6 text-gray-600">Review your registered passkeys, give them a recognizable name, or remove keys you no longer use.</p>
+        {!canCreate && <p className="mt-2 text-sm text-gray-600">Passkey creation requires a compatible browser and device. You can continue using your password to sign in.</p>}
+      </div>
+      <div className="p-5 sm:p-6">
+        <p role="status" className="text-sm text-green-800">{message}</p>
+        {error && <p role="alert" className="mb-4 rounded bg-red-50 p-3 text-sm text-red-800">{error}</p>}
+        {loading ? <p role="status" className="text-sm text-gray-600">Loading your passkeys…</p>
+          : data ? <>
+            <div className="mb-4 flex items-center justify-between gap-4">
+              <p className="text-xs font-semibold uppercase tracking-wide text-gray-500">{data.passkeys.length} registered {data.passkeys.length === 1 ? 'passkey' : 'passkeys'}</p>
+              <button type="button" disabled={busy || Boolean(edit)} onClick={reload} className={button}>Refresh</button>
+            </div>
+            {data.passkeys.length === 0 ? <div className="rounded border border-dashed border-gray-300 p-6 text-center">
+              <h3 className="font-semibold">No passkeys registered</h3>
+              <p className="mt-2 text-sm text-gray-600">Your registered passkeys will appear here. You can still sign in with your password.</p>
+            </div> : <ul className="divide-y divide-gray-200">
+              {data.passkeys.map(key => {
+                const displayName = key.name || key.provider;
+                const active = edit?.id === key.id;
+                return <li key={key.id} className="py-5 first:pt-0 last:pb-0">
+                  <div className="flex flex-wrap items-start gap-3">
+                    <div className="flex size-10 shrink-0 items-center justify-center rounded-lg bg-gray-100" aria-hidden="true">
+                      {key.providerIcon ? <img src={key.providerIcon} alt="" width={24} height={24} />
+                        : <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5"><circle cx="8" cy="8" r="4"/><path d="m11 11 9 9m-4-4 3-3m-6 0 3-3"/></svg>}
+                    </div>
+                    <div className="min-w-0 flex-1">
+                      <h3 className="break-words font-semibold text-gray-900">{displayName}</h3>
+                      <p className="text-sm text-gray-600">{key.provider}</p>
+                      <dl className="mt-2 text-xs leading-6 text-gray-600">
+                        <div><dt className="inline">Registered: </dt><dd className="inline">{dateLabel(key.registeredAt, 'Unknown date')}</dd></div>
+                        <div><dt className="inline">Last used: </dt><dd className="inline">{dateLabel(key.lastUsedAt, 'Not used yet')}</dd></div>
+                      </dl>
+                    </div>
+                    {!active && <div className="flex flex-wrap gap-2">
+                      <button type="button" id={`rename-${key.id}`} aria-label={`Rename ${displayName}`} className={button} disabled={busy || Boolean(edit)} onClick={() => {
+                        focusAfterEdit.current = `rename-${key.id}`; setName(displayName); setEdit({ id: key.id, action: 'rename' }); setError(''); setMessage('');
+                      }}>Rename</button>
+                      <button type="button" id={`remove-${key.id}`} aria-label={`Remove ${displayName}`} className={`${button} text-red-800`} disabled={busy || Boolean(edit)} onClick={() => {
+                        focusAfterEdit.current = `remove-${key.id}`; setEdit({ id: key.id, action: 'remove' }); setError(''); setMessage('');
+                      }}>Remove</button>
+                    </div>}
+                  </div>
+                  {active && <form className="mt-4 rounded bg-gray-50 p-4" onSubmit={e => { e.preventDefault(); void save(); }}>
+                    <fieldset disabled={busy}>
+                      <legend className="font-semibold">{edit.action === 'rename' ? 'Rename passkey' : `Remove ${displayName}?`}</legend>
+                      {edit.action === 'rename' ? <div className="mt-3">
+                        <label htmlFor="passkey-name" className="block text-sm font-medium">Passkey display name</label>
+                        <input id="passkey-name" autoFocus required maxLength={100} value={name} onChange={e => setName(e.target.value)} className="mt-2 w-full rounded border border-gray-400 bg-white px-3 py-2" aria-describedby="passkey-name-help" />
+                        <p id="passkey-name-help" className="mt-2 text-xs text-gray-600">This label is saved to your Times account. It doesn’t rename the entry in your password manager.</p>
+                      </div> : <p className="mt-3 text-sm text-gray-700">This passkey will no longer work for your Times account. You can still sign in with your password. Your browser will be notified where supported; you may also need to remove it from your password manager.</p>}
+                      <div className="mt-4 flex flex-wrap gap-2">
+                        <button type="submit" autoFocus={edit.action === 'remove'} className={`${button} ${edit.action === 'remove' ? 'text-red-800' : ''}`}>{busy ? 'Saving…' : edit.action === 'rename' ? 'Save name' : 'Remove passkey'}</button>
+                        <button type="button" className={button} onClick={() => { setEdit(null); setError(''); }}>Cancel</button>
+                      </div>
+                    </fieldset>
+                  </form>}
+                </li>;
+              })}
+            </ul>}
+            <div className="mt-6 border-t border-gray-200 pt-4">
+              <p role="status" className="text-xs leading-5 text-gray-600">{syncNotice}</p>
+              {syncFailed && <button type="button" disabled={busy || Boolean(edit)} onClick={reload} className={`${button} mt-3`}>Retry browser sync</button>}
+            </div>
+          </> : <button type="button" onClick={reload} disabled={busy} className={button}>Try again</button>}
+      </div>
+    </section>
+    <button type="button" disabled={loading || busy || Boolean(edit)} onClick={signOut} className={`${button} mt-8`}>Sign out</button>
+  </>;
+}
