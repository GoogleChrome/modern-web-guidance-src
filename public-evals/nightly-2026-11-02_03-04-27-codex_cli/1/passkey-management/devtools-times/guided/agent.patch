--- /dev/null
+++ b/src/lib/server/account-http.ts
@@ -0,0 +1,41 @@
+import type { APIContext } from 'astro';
+import { findReader, listPasskeys, type Reader } from './accounts';
+import registry from '../../utils/aaguids.json';
+
+const providers = registry.providers as Record<string, { name: string; icon?: string }>;
+const icons = registry.icons as Record<string, string>;
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function sameOrigin(context: Pick<APIContext, 'request' | 'url'>) {
+  // Explicitly enforce this because the app disables Astro's global origin check.
+  return context.request.headers.get('Origin') === context.url.origin;
+}
+
+export async function signedInReader(context: Pick<APIContext, 'session'>) {
+  const auth = await context.session?.get('reader');
+  if (!auth || auth.expiresAt <= Date.now()) return undefined;
+  return findReader(auth.id);
+}
+
+export function relyingParty(url: URL) {
+  const rpId = process.env.WEBAUTHN_RP_ID || url.hostname;
+  if (url.hostname !== rpId && !url.hostname.endsWith(`.${rpId}`)) {
+    throw new Error('Invalid relying party configuration');
+  }
+  return rpId;
+}
+
+export function managementData(reader: Reader, rpId: string) {
+  return { user: reader, rpId, passkeys: listPasskeys(reader.id, rpId).map(passkey => {
+    // AAGUID metadata is a display hint only; zero/unknown values get a neutral fallback.
+    const provider = passkey.aaguid === '00000000-0000-0000-0000-000000000000'
+      ? undefined : providers[passkey.aaguid.toLowerCase()];
+    return { ...passkey, provider: provider?.name || 'Unknown passkey provider',
+      providerIcon: provider?.icon ? icons[provider.icon] : undefined };
+  }) };
+}
