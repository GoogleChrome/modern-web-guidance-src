+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { randomBytes } from 'node:crypto';
+import type { WebAuthnCredential } from '@simplewebauthn/server';
+
+export interface Reader { id: string; username: string }
+export interface Passkey {
+  id: string;
+  name: string;
+  aaguid: string;
+  registeredAt: number;
+  lastUsedAt: number | null;
+}
+
+let database: DatabaseSync | undefined;
+function db() {
+  if (database) return database;
+  const path = resolve(process.env.ACCOUNT_DB_PATH || './data/accounts.sqlite');
+  mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
+  database = new DatabaseSync(path);
+  database.exec(`
+    PRAGMA journal_mode = WAL;
+    PRAGMA foreign_keys = ON;
+    PRAGMA busy_timeout = 5000;
+    CREATE TABLE IF NOT EXISTS readers (
+      id TEXT PRIMARY KEY, username TEXT NOT NULL UNIQUE
+    );
+    CREATE TABLE IF NOT EXISTS passkeys (
+      id TEXT PRIMARY KEY, readerId TEXT NOT NULL REFERENCES readers(id),
+      rpId TEXT NOT NULL, name TEXT NOT NULL, aaguid TEXT NOT NULL,
+      publicKey TEXT NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL,
+      deviceType TEXT NOT NULL, backedUp INTEGER NOT NULL,
+      registeredAt INTEGER NOT NULL, lastUsedAt INTEGER
+    );
+    CREATE INDEX IF NOT EXISTS passkey_owner ON passkeys(readerId, rpId);
+  `);
+  return database;
+}
+
+// Only call after the existing identity service has verified the password.
+export function readerForVerifiedLogin(username: string): Reader {
+  db().prepare('INSERT OR IGNORE INTO readers (id, username) VALUES (?, ?)')
+    .run(randomBytes(32).toString('base64url'), username);
+  return db().prepare('SELECT id, username FROM readers WHERE username = ?').get(username) as unknown as Reader;
+}
+
+export function findReader(id: string): Reader | undefined {
+  return db().prepare('SELECT id, username FROM readers WHERE id = ?').get(id) as unknown as Reader | undefined;
+}
+
+export function listPasskeys(readerId: string, rpId: string): Passkey[] {
+  return db().prepare(`SELECT id, name, aaguid, registeredAt, lastUsedAt FROM passkeys
+    WHERE readerId = ? AND rpId = ? ORDER BY registeredAt DESC, id`).all(readerId, rpId) as unknown as Passkey[];
+}
+
+export function renamePasskey(readerId: string, rpId: string, id: string, name: string) {
+  return db().prepare('UPDATE passkeys SET name = ? WHERE id = ? AND readerId = ? AND rpId = ?')
+    .run(name, id, readerId, rpId).changes > 0;
+}
+
+export function deletePasskey(readerId: string, rpId: string, id: string) {
+  return db().prepare('DELETE FROM passkeys WHERE id = ? AND readerId = ? AND rpId = ?')
+    .run(id, readerId, rpId).changes > 0;
+}
+
+export function savePasskey(readerId: string, rpId: string, credential: WebAuthnCredential,
+  aaguid: string, deviceType: string, backedUp: boolean) {
+  db().prepare(`INSERT INTO passkeys
+    (id, readerId, rpId, name, aaguid, publicKey, counter, transports, deviceType, backedUp, registeredAt)
+    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`)
+    .run(credential.id, readerId, rpId, '', aaguid, Buffer.from(credential.publicKey).toString('base64url'),
+      credential.counter, JSON.stringify(credential.transports || []), deviceType, Number(backedUp), Date.now());
+}
