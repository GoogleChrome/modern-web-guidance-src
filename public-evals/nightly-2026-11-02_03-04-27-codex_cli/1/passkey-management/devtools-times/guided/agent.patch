@@ -0,0 +1,35 @@
+import type { APIRoute } from 'astro';
+import { json, managementData, relyingParty, sameOrigin, signedInReader } from '../../../lib/server/account-http';
+import { deletePasskey, renamePasskey } from '../../../lib/server/accounts';
+
+export const GET: APIRoute = async (context) => {
+  const reader = await signedInReader(context);
+  if (!reader) return json({ error: 'Please sign in to manage your passkeys.' }, 401);
+  return json(managementData(reader, relyingParty(context.url)));
+};
+
+const mutate: APIRoute = async (context) => {
+  if (!sameOrigin(context)) return json({ error: 'Request origin is not allowed.' }, 403);
+  const reader = await signedInReader(context);
+  if (!reader) return json({ error: 'Your session has expired. Please sign in again.' }, 401);
+  let body;
+  try { body = await context.request.json(); } catch { return json({ error: 'Invalid request.' }, 400); }
+  if (typeof body?.id !== 'string' || !/^[A-Za-z0-9_-]{1,2048}$/.test(body.id)) {
+    return json({ error: 'Invalid passkey.' }, 400);
+  }
+  const rpId = relyingParty(context.url);
+  let found;
+  if (context.request.method === 'PATCH') {
+    if (typeof body.name !== 'string' || !body.name.trim() || body.name.trim().length > 100) {
+      return json({ error: 'Choose a display name between 1 and 100 characters.' }, 400);
+    }
+    found = renamePasskey(reader.id, rpId, body.id, body.name.trim());
+  } else {
+    found = deletePasskey(reader.id, rpId, body.id);
+  }
+  if (!found) return json({ error: 'This passkey no longer exists. Refresh the list to continue.' }, 404);
+  return json(managementData(reader, rpId));
+};
+
+export const PATCH = mutate;
+export const DELETE = mutate;
diff --git a/src/pages/api/passkeys/register.ts b/src/pages/api/passkeys/register.ts
new file mode 100644
index 0000000..c0b231a
--- /dev/null
+++ b/src/pages/api/passkeys/register.ts
@@ -0,0 +1,46 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions, verifyRegistrationResponse } from '@simplewebauthn/server';
+import { listPasskeys, savePasskey } from '../../../lib/server/accounts';
+import { json, managementData, relyingParty, sameOrigin, signedInReader } from '../../../lib/server/account-http';
+
+export const POST: APIRoute = async (context) => {
+  if (!sameOrigin(context)) return json({ error: 'Request origin is not allowed.' }, 403);
+  const reader = await signedInReader(context);
+  if (!reader || !context.session) return json({ error: 'Please sign in again to create a passkey.' }, 401);
+  const rpId = relyingParty(context.url);
+  let body;
+  try { body = await context.request.json(); } catch { return json({ error: 'Invalid request.' }, 400); }
+  if (body?.action === 'options') {
+    const options = await generateRegistrationOptions({
+      rpName: 'The DevTools Times', rpID: rpId,
+      userName: reader.username, userDisplayName: reader.username,
+      userID: Buffer.from(reader.id, 'base64url'),
+      attestationType: 'none',
+      excludeCredentials: listPasskeys(reader.id, rpId).map(({ id }) => ({ id })),
+      authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'required' },
+    });
+    context.session.set('passkeyRegistration', {
+      challenge: options.challenge, rpId, origin: context.url.origin, readerId: reader.id,
+      expiresAt: Date.now() + 5 * 60 * 1000,
+    });
+    return json(options);
+  }
+  const pending = await context.session.get('passkeyRegistration');
+  context.session.delete('passkeyRegistration');
+  if (!pending || pending.expiresAt <= Date.now() || pending.readerId !== reader.id ||
+      pending.rpId !== rpId || pending.origin !== context.url.origin) {
+    return json({ error: 'Passkey creation expired. Please try again.' }, 400);
+  }
+  try {
+    const result = await verifyRegistrationResponse({
+      response: body.credential, expectedChallenge: pending.challenge,
+      expectedOrigin: pending.origin, expectedRPID: rpId, requireUserVerification: true,
+    });
+    if (!result.verified || !result.registrationInfo) return json({ error: 'Could not verify this passkey.' }, 400);
+    const info = result.registrationInfo;
+    savePasskey(reader.id, rpId, info.credential, info.aaguid, info.credentialDeviceType, info.credentialBackedUp);
+    return json(managementData(reader, rpId));
+  } catch {
+    return json({ error: 'Could not save this passkey. It may already be registered. Please refresh and try again.' }, 400);
+  }
+};
