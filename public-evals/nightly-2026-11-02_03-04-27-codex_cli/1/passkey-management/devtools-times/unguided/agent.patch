--- /dev/null
+++ b/src/pages/api/account/index.ts
@@ -0,0 +1,24 @@
+import type { APIRoute } from 'astro';
+import { json, sameOrigin, signedIn, snapshot, validName } from '../../../lib/account-api';
+import { renameAccount } from '../../../lib/account-store';
+
+export const GET: APIRoute = async (context) => {
+  const username = await signedIn(context);
+  return username ? json(snapshot(context, username)) : json({ error: 'Please sign in to manage your account.' }, 401);
+};
+export const PATCH: APIRoute = async (context) => {
+  if (!sameOrigin(context)) return json({ error: 'Invalid request origin.' }, 403);
+  const username = await signedIn(context);
+  if (!username) return json({ error: 'Please sign in again.' }, 401);
+  try {
+    const { displayName } = await context.request.json();
+    if (!validName(displayName)) return json({ error: 'Use a display name between 1 and 64 characters.' }, 400);
+    renameAccount(username, displayName.trim());
+    return json(snapshot(context, username));
+  } catch { return json({ error: 'Unable to update your display name.' }, 500); }
+};
+export const DELETE: APIRoute = async (context) => {
+  if (!sameOrigin(context)) return json({ error: 'Invalid request origin.' }, 403);
+  await context.session?.destroy();
+  return json({ success: true });
+};
diff --git a/src/pages/api/account/login.ts b/src/pages/api/account/login.ts
new file mode 100644
index 0000000..82b22b1
--- /dev/null
+++ b/src/pages/api/account/login.ts
@@ -0,0 +1,18 @@
+import type { APIRoute } from 'astro';
+import { json, sameOrigin, signIn } from '../../../lib/account-api';
+
+export const POST: APIRoute = async (context) => {
+  if (!sameOrigin(context)) return json({ error: 'Invalid request origin.' }, 403);
+  try {
+    const { username, password } = await context.request.json();
+    if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) return json({ error: 'Username and password are required.' }, 400);
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username, password }), signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok) return json({ error: 'Unable to sign in. Check your username and password.' }, 401);
+    const data = await response.json();
+    const canonicalUsername = data.user?.username || data.username || username;
+    await signIn(context, canonicalUsername);
+    return json({ success: true });
+  } catch { return json({ error: 'Sign-in is unavailable. Please try again.' }, 503); }
+};
diff --git a/src/pages/api/account/passkey-login.ts b/src/pages/api/account/passkey-login.ts
new file mode 100644
index 0000000..fa2b051
--- /dev/null
+++ b/src/pages/api/account/passkey-login.ts
@@ -0,0 +1,28 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { json, origin, sameOrigin, signIn } from '../../../lib/account-api';
+import { findKey, updateCounter } from '../../../lib/account-store';
+
+export const POST: APIRoute = async (context) => {
+  if (!sameOrigin(context)) return json({ error: 'Invalid request origin.' }, 403);
+  try {
+    const body = await context.request.json();
+    const rpID = new URL(origin(context)).hostname;
+    if (body.action === 'options') {
+      const options = await generateAuthenticationOptions({ rpID, userVerification: 'required' });
+      await context.session?.set('authentication', { challenge: options.challenge, expires: Date.now() + 300000 });
+      return json(options);
+    }
+    if (body.action !== 'verify') return json({ error: 'Invalid action.' }, 400);
+    const pending = await context.session?.get('authentication') as { challenge: string; expires: number } | undefined;
+    await context.session?.delete('authentication');
+    if (!pending || pending.expires < Date.now()) return json({ error: 'Sign-in expired. Please try again.' }, 400);
+    const key = findKey(body.response.id);
+    if (!key) return json({ error: 'This passkey is no longer registered.', rpId: rpID, credentialId: body.response.id }, 404);
+    const result = await verifyAuthenticationResponse({ response: body.response, expectedChallenge: pending.challenge, expectedOrigin: origin(context), expectedRPID: rpID, credential: key.credential, requireUserVerification: true });
+    if (!result.verified) return json({ error: 'Unable to verify your passkey.' }, 401);
+    updateCounter(body.response.id, result.authenticationInfo.newCounter);
+    await signIn(context, key.username);
+    return json({ success: true });
+  } catch { return json({ error: 'Unable to sign in with this passkey.' }, 400); }
+};
diff --git a/src/pages/api/account/passkeys.ts b/src/pages/api/account/passkeys.ts
new file mode 100644
index 0000000..e9f57bb
--- /dev/null
+++ b/src/pages/api/account/passkeys.ts
@@ -0,0 +1,47 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions, verifyRegistrationResponse } from '@simplewebauthn/server';
+import { json, origin, sameOrigin, signedIn, snapshot, validName } from '../../../lib/account-api';
+import { account, keys, removeKey, renameKey, saveKey } from '../../../lib/account-store';
+
+export const POST: APIRoute = async (context) => {
+  if (!sameOrigin(context)) return json({ error: 'Invalid request origin.' }, 403);
+  const username = await signedIn(context);
+  if (!username) return json({ error: 'Please sign in again.' }, 401);
+  try {
+    const body = await context.request.json();
+    const rpID = new URL(origin(context)).hostname;
+    if (body.action === 'options') {
+      const user = account(username);
+      const options = await generateRegistrationOptions({
+        rpName: 'The DevTools Times', rpID, userName: username, userDisplayName: user.displayName,
+        userID: new Uint8Array(Buffer.from(user.id, 'base64url')),
+        excludeCredentials: keys(username).map(({ id }) => ({ id })),
+        authenticatorSelection: { residentKey: 'required', userVerification: 'required' },
+      });
+      await context.session?.set('registration', { challenge: options.challenge, expires: Date.now() + 300000 });
+      return json(options);
+    }
+    if (body.action !== 'verify') return json({ error: 'Invalid action.' }, 400);
+    const pending = await context.session?.get('registration') as { challenge: string; expires: number } | undefined;
+    await context.session?.delete('registration');
+    if (!pending || pending.expires < Date.now()) return json({ error: 'Registration expired. Please try again.' }, 400);
+    const result = await verifyRegistrationResponse({ response: body.response, expectedChallenge: pending.challenge, expectedOrigin: origin(context), expectedRPID: rpID, requireUserVerification: true });
+    if (!result.verified || !result.registrationInfo) return json({ error: 'Could not verify this passkey.' }, 400);
+    saveKey(username, result.registrationInfo.credential);
+    return json(snapshot(context, username));
+  } catch { return json({ error: 'Could not register this passkey. Please try again.' }, 400); }
+};
+const mutate = (method: 'rename' | 'remove'): APIRoute => async (context) => {
+  if (!sameOrigin(context)) return json({ error: 'Invalid request origin.' }, 403);
+  const username = await signedIn(context);
+  if (!username) return json({ error: 'Please sign in again.' }, 401);
+  try {
+    const { id, name } = await context.request.json();
+    if (typeof id !== 'string' || (method === 'rename' && !validName(name))) return json({ error: 'A key and a name of 1–64 characters are required.' }, 400);
+    const changed = method === 'rename' ? renameKey(username, id, name.trim()) : removeKey(username, id);
+    if (!changed) return json({ error: 'This passkey no longer exists. Reload your account settings.' }, 404);
+    return json(snapshot(context, username));
+  } catch { return json({ error: 'Unable to update this passkey.' }, 500); }
+};
+export const PATCH = mutate('rename');
+export const DELETE = mutate('remove');
