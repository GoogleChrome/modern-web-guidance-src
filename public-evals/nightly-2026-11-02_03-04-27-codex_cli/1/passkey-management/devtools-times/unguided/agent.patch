+    setBusy(true); setError(''); setMessage('');
+    try {
+      const optionsJSON = await request('/passkeys', 'POST', { action: 'options' });
+      const response = await startRegistration({ optionsJSON });
+      const next = await request('/passkeys', 'POST', { action: 'verify', response });
