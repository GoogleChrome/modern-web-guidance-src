+      setSync(await syncPasskeys(next, true));
+    } catch (e) { setError((e as Error).message); }
+    finally { setLoading(false); }
+  }
+  useEffect(() => { void load(); }, []);
+
+  async function change(path: string, method: string, body: unknown, success: string, details = false) {
+    setBusy(true); setError(''); setMessage('');
+    try {
+      const next: AccountSnapshot = await request(path, method, body);
+      setData(next); setDisplayName(next.user.displayName); setEditing(null); setRemoving(null);
+      setMessage(success);
+      setSync(await syncPasskeys(next, details));
+    } catch (e) { setError((e as Error).message); }
+    finally { setBusy(false); }
+  }
