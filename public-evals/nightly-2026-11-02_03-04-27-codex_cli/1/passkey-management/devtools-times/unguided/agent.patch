diff --git a/src/lib/account-api.ts b/src/lib/account-api.ts
new file mode 100644
index 0000000..76b3ce6
--- /dev/null
+++ b/src/lib/account-api.ts
@@ -0,0 +1,27 @@
+import type { APIContext } from 'astro';
+import { account, keys } from './account-store';
+
+export const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } });
+export function origin(context: APIContext) {
+  return process.env.WEBAUTHN_ORIGIN || context.url.origin;
+}
+export function sameOrigin(context: APIContext) {
+  return context.request.headers.get('Origin') === origin(context);
+}
+export async function signedIn(context: APIContext): Promise<string | null> {
+  const auth = await context.session?.get('account') as { username: string; expires: number } | undefined;
+  return auth && auth.expires > Date.now() ? auth.username : null;
+}
+export async function signIn(context: APIContext, username: string) {
+  if (!context.session) throw new Error('Session storage is unavailable.');
+  await context.session.delete('registration');
+  await context.session.delete('authentication');
+  await context.session.regenerate();
+  await context.session?.set('account', { username, expires: Date.now() + 24 * 60 * 60 * 1000 });
+}
+export function snapshot(context: APIContext, username: string) {
+  return { user: account(username), passkeys: keys(username), rpId: new URL(origin(context)).hostname };
+}
+export function validName(value: unknown): value is string {
+  return typeof value === 'string' && value.trim().length > 0 && value.trim().length <= 64;
+}
diff --git a/src/lib/account-store.ts b/src/lib/account-store.ts
new file mode 100644
index 0000000..b3aa78d
--- /dev/null
+++ b/src/lib/account-store.ts
@@ -0,0 +1,48 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+let database: DatabaseSync;
+function db() {
+  if (!database) {
+    const path = process.env.ACCOUNT_DB_PATH || './data/accounts.sqlite';
+    mkdirSync(dirname(path), { recursive: true });
+    database = new DatabaseSync(path);
+    database.exec(`PRAGMA journal_mode=WAL;
+      CREATE TABLE IF NOT EXISTS accounts (username TEXT PRIMARY KEY, id TEXT UNIQUE NOT NULL, displayName TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, username TEXT NOT NULL, name TEXT NOT NULL, createdAt TEXT NOT NULL, credential TEXT NOT NULL);`);
+  }
+  return database;
+}
+export interface Account { username: string; id: string; displayName: string }
+export interface Passkey { id: string; name: string; createdAt: string }
+export function account(username: string): Account {
+  db().prepare('INSERT OR IGNORE INTO accounts VALUES (?, ?, ?)').run(username, randomBytes(32).toString('base64url'), username);
+  return db().prepare('SELECT * FROM accounts WHERE username = ?').get(username) as unknown as Account;
+}
+export function keys(username: string): Passkey[] {
+  return db().prepare('SELECT id, name, createdAt FROM passkeys WHERE username = ? ORDER BY createdAt').all(username) as unknown as Passkey[];
+}
+export function renameAccount(username: string, displayName: string) {
+  db().prepare('UPDATE accounts SET displayName = ? WHERE username = ?').run(displayName, username);
+}
+export function renameKey(username: string, id: string, name: string) {
+  return db().prepare('UPDATE passkeys SET name = ? WHERE username = ? AND id = ?').run(name, username, id).changes > 0;
+}
+export function removeKey(username: string, id: string) {
+  return db().prepare('DELETE FROM passkeys WHERE username = ? AND id = ?').run(username, id).changes > 0;
+}
+export function saveKey(username: string, credential: { id: string; publicKey: Uint8Array; counter: number; transports?: string[] }) {
+  db().prepare('INSERT INTO passkeys VALUES (?, ?, ?, ?, ?)').run(credential.id, username, 'My passkey', new Date().toISOString(), JSON.stringify({ ...credential, publicKey: Buffer.from(credential.publicKey).toString('base64url') }));
+}
+export function findKey(id: string) {
+  const row = db().prepare('SELECT username, credential FROM passkeys WHERE id = ?').get(id) as { username: string; credential: string } | undefined;
+  if (!row) return null;
+  const credential = JSON.parse(row.credential);
+  return { username: row.username, credential: { ...credential, publicKey: new Uint8Array(Buffer.from(credential.publicKey, 'base64url')) } };
+}
+export function updateCounter(id: string, counter: number) {
+  const key = findKey(id);
+  if (key) db().prepare('UPDATE passkeys SET credential = ? WHERE id = ?').run(JSON.stringify({ ...key.credential, publicKey: Buffer.from(key.credential.publicKey).toString('base64url'), counter }), id);
+}
diff --git a/src/lib/passkey-sync.ts b/src/lib/passkey-sync.ts
new file mode 100644
index 0000000..3eb199e
--- /dev/null
+++ b/src/lib/passkey-sync.ts
@@ -0,0 +1,32 @@
+export interface AccountSnapshot {
+  user: { id: string; username: string; displayName: string };
+  passkeys: { id: string; name: string; createdAt: string }[];
+  rpId: string;
+}
+type SignalAPI = {
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (options: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+  signalUnknownCredential?: (options: { rpId: string; credentialId: string }) => Promise<void>;
+};
+export function signalAPI(): SignalAPI | undefined {
+  return typeof PublicKeyCredential === 'undefined' ? undefined : PublicKeyCredential as unknown as SignalAPI;
+}
+// Only call with a complete, authenticated server snapshot. IDs are stored as base64url.
+export async function syncPasskeys(data: AccountSnapshot, details = false): Promise<string> {
+  const api = signalAPI();
+  const tasks: Promise<void>[] = [];
+  if (api?.signalAllAcceptedCredentials) {
+    tasks.push(Promise.resolve().then(() => api.signalAllAcceptedCredentials!({ rpId: data.rpId, userId: data.user.id, allAcceptedCredentialIds: data.passkeys.map(key => key.id) })));
+  }
+  if (details && api?.signalCurrentUserDetails) {
+    tasks.push(Promise.resolve().then(() => api.signalCurrentUserDetails!({ rpId: data.rpId, userId: data.user.id, name: data.user.username, displayName: data.user.displayName })));
+  }
+  const results = await Promise.allSettled(tasks);
+  if (results.some(result => result.status === 'rejected')) {
+    return 'Your account is saved, but your password manager could not be synced. You can retry sync or update it manually.';
+  }
+  if (!api?.signalAllAcceptedCredentials || (details && !api.signalCurrentUserDetails)) {
+    return 'Your browser cannot sync all passkey changes automatically. Update names or remove old keys in your password manager too.';
+  }
+  return '';
+}
