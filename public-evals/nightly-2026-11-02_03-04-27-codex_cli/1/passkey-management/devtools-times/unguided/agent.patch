+      <div className="settings-security-note"><ShieldCheckIcon /><p>Your biometric information stays on your device. Only you can use your passkeys.</p></div>
+      {sync && <div className="settings-sync" role="status"><p>{sync}</p><button className="settings-text" disabled={busy} onClick={async () => { setBusy(true); try { const next = await request(); setData(next); setSync(await syncPasskeys(next, true)); } catch (e) { setError((e as Error).message); } finally { setBusy(false); } }}>Retry sync</button></div>}
+    </section>
