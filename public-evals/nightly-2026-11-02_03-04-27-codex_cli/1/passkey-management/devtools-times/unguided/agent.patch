+  const response = await fetch(`${base}api/account${path}`, { method, headers: body ? { 'Content-Type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined });
+  const data = await response.json();
+  if (!response.ok) throw new Error(response.status === 401 ? 'Your session has expired. Please sign in again.' : data.error || 'Unable to save changes. Please try again.');
+  return data;
