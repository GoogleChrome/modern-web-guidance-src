+        {removing === key.id && <div className="settings-confirm" role="group" aria-label={`Confirm removal of ${key.name}`}><h4>Remove “{key.name}”?</h4><p>You won’t be able to sign in with this passkey. You can still use your password{data.passkeys.length > 1 ? ' or another passkey' : ''}.</p><div><button className="settings-danger" disabled={busy} onClick={() => change('/passkeys', 'DELETE', { id: key.id }, 'Passkey removed from your account.')}>{busy ? 'Removing…' : 'Remove passkey'}</button><button className="settings-text" disabled={busy} onClick={() => setRemoving(null)}>Keep passkey</button></div></div>}
