diff --git a/ACCOUNT-API.txt b/ACCOUNT-API.txt
new file mode 100644
index 0000000..78ce3d7
--- /dev/null
+++ b/ACCOUNT-API.txt
@@ -0,0 +1,83 @@
+Daily Grind passkey management
+=============================
+
+This checkout contains a static site, with no customer authentication service
+or credentials database. With no configuration, the account UI is explicitly
+in demo mode. Its sample passkeys persist in localStorage; browser signals are
+never sent for demo records. Blocked storage falls back to visit-only changes.
+
+To connect the UI to the site's authenticated account service, inject this
+configuration BEFORE the account.js module executes:
+
+<script>
+  window.DAILY_GRIND_ACCOUNT = {
+    apiBase: '/api/account/passkeys',
+    csrfToken: '<server-rendered session CSRF token>'
+  };
+</script>
+
+The API must be same-origin and use the customer's authenticated session.
+GET /api/account/passkeys returns:
+
+{
+  "complete": true,
+  "rpId": "your-production-rp-domain.example",
+  "user": { "id": "BASE64URL_WEBAUTHN_USER_ID", "displayName": "Customer name" },
+  "credentials": [
+    {
+      "id": "BASE64URL_CREDENTIAL_ID",
+      "name": "Work laptop",
+      "aaguid": "fbfc3007-154e-4ecc-8c0b-6e020557d7bd",
+      "device": "laptop",
+      "registeredAt": 1789171200000,
+      "lastUsedAt": 1793577600000
+    }
+  ]
+}
+
+complete MUST be true only for the entire, unpaginated credential list belonging
+to the signed-in customer. IDs use unpadded Base64URL strings. user.id MUST be the
+same WebAuthn user handle used during registration, not an unrelated account ID.
+rpId MUST be the relying party ID used during registration. Timestamps are epoch
+milliseconds; lastUsedAt can be null or absent. device can be laptop, phone, or
+security-key; other values receive a generic key icon. Unknown/zero AAGUIDs have
+a generic provider fallback. Provider metadata is decorative and never used for
+authentication or access decisions.
+
+PATCH /api/account/passkeys/:credentialId
+  JSON body: { "name": "Trimmed label, 1–60 characters" }
+DELETE /api/account/passkeys/:credentialId
+  No request body.
+
+Both mutations should return a successful 2xx status (e.g. 204). The client
+reloads GET afterward to obtain the authoritative list. A failed refresh blocks
+further changes and skips browser signaling until the list is reloaded.
+
+The server MUST authenticate every request, check that each credential belongs
+to the signed-in user, validate labels, and enforce CSRF protection for mutations.
+The client sends same-origin cookies and X-CSRF-Token when configured. The server
+must protect the final sign-in method if the account has no recovery option.
+Never use a credential ID alone as authorization. Return 401/403 for invalid
+sessions/permissions; errors never switch a live customer to demo data.
+
+In live mode the client feature-detects signalAllAcceptedCredentials and sends
+the server's complete credential list on initial load and after deletion. Success
+means the browser was notified; it does not prove every password manager has
+removed a credential. Unsupported or failed signals display manual-removal
+instructions; failures also offer a retry that reloads server data first.
+Renaming a passkey changes only the server's label. It must NOT call
+signalCurrentUserDetails, which is intended for changes to the account's name.
+Registration and sign-in ceremonies belong to the existing authentication service
+and are outside this management UI.
+
+Assets
+------
+Image source: https://images.unsplash.com/photo-1442512595331-e89e73853f31
+Provider icons and AAGUID metadata:
+https://github.com/passkeydeveloper/passkey-authenticator-aaguids
+
+Checks (no server or browser required)
+-------------------------------------
+node --test passkey-store.test.mjs
+node --check --input-type=module < account.js
+node --check passkey-store.mjs
diff --git a/account.js b/account.js
new file mode 100644
index 0000000..aedd6b2
--- /dev/null
+++ b/account.js
@@ -0,0 +1,221 @@
+import { createPasskeyStore, syncAcceptedCredentials } from './passkey-store.mjs';
+
+const $ = id => document.getElementById(id);
+const list = $('passkey-list');
+const renameDialog = $('rename-dialog');
+const deleteDialog = $('delete-dialog');
+let store;
+let account;
+let selectedId;
+let busy = false;
+let toastTimer;
+let syncVersion = 0;
+
+// Set by the host before this module loads. No endpoint means an explicit demo,
+// never a fallback from a failed authenticated API request.
+const config = window.DAILY_GRIND_ACCOUNT || {};
+const providers = {
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': { name: 'Apple Passwords', icon: 'assets/provider-apple.svg' },
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': { name: 'Google Password Manager', icon: 'assets/provider-google.svg' },
+  'bada5566-a7aa-401f-bd96-45619a55120d': { name: '1Password', icon: 'assets/provider-1password.svg' },
+  '2fc0579f-8113-47ea-b116-bb5a8db9202a': { name: 'YubiKey · Physical security key', icon: 'assets/provider-yubikey.png' }
+};
+const dateFormat = new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
+function formatDate(epoch) {
+  return epoch == null ? 'Never used' : dateFormat.format(new Date(epoch));
+}
+function announce(message) {
+  clearTimeout(toastTimer);
+  $('status').textContent = message;
+  toastTimer = setTimeout(() => { $('status').textContent = ''; }, 6500);
+}
+function render() {
+  $('customer-name').textContent = account.user.displayName;
+  $('avatar').textContent = account.user.displayName.trim().split(/\s+/).map(part => part[0]).slice(0, 2).join('').toUpperCase();
+  $('passkey-count').textContent = account.credentials.length;
+  $('empty-state').hidden = account.credentials.length > 0;
+  $('empty-reset').hidden = store.live;
+  list.hidden = account.credentials.length === 0;
+  list.setAttribute('aria-busy', 'false');
+  list.querySelector('.loading-state')?.remove();
+  const remaining = new Set(account.credentials.map(key => key.id));
+  for (const row of list.children) if (!remaining.has(row.dataset.id)) row.remove();
+  account.credentials.forEach(key => {
+    let row = [...list.children].find(item => item.dataset.id === key.id);
+    if (!row) {
+      row = document.createElement('li');
+      row.className = 'passkey-row';
+      row.dataset.id = key.id;
+      row.innerHTML = `<span class="device-icon"><svg class="icon" aria-hidden="true"><use/></svg></span>
+        <div class="credential-details"><div class="credential-title"><h4></h4></div><p class="provider"><img alt="" width="12" height="12"><span></span></p><div class="credential-dates"><span class="created"></span><span class="last-used"></span></div></div>
+        <div class="row-actions"><button class="rename-button" type="button" data-action="rename"><svg class="icon" aria-hidden="true"><use href="#edit"/></svg>Rename</button><button class="delete-button" type="button" data-action="delete"><svg class="icon" aria-hidden="true"><use href="#trash"/></svg></button></div>`;
+      list.append(row);
+    }
+    const provider = providers[key.aaguid?.toLowerCase()];
+    const device = ['laptop', 'phone', 'security-key'].includes(key.device) ? key.device : 'key';
+    row.querySelector('.device-icon use').setAttribute('href', `#${device}`);
+    row.querySelector('h4').textContent = key.name || provider?.name || 'Passkey';
+    row.querySelector('.provider span').textContent = provider?.name || 'Unknown passkey provider';
+    const providerIcon = row.querySelector('.provider img');
+    providerIcon.hidden = !provider;
+    if (provider) providerIcon.src = provider.icon;
+    row.querySelector('.created').textContent = `Added ${formatDate(key.registeredAt)}`;
+    row.querySelector('.last-used').textContent = key.lastUsedAt == null ? 'Never used' : `Last used ${formatDate(key.lastUsedAt)}`;
+    row.querySelector('[data-action="rename"]').setAttribute('aria-label', `Rename ${key.name || 'passkey'}`);
+    row.querySelector('[data-action="delete"]').setAttribute('aria-label', `Delete ${key.name || 'passkey'}`);
+  });
+}
+function showLoadError(message) {
+  $('load-error').hidden = false;
+  $('load-error-text').textContent = message;
+  list.hidden = true;
+  list.setAttribute('aria-busy', 'false');
+  $('empty-state').hidden = true;
+  $('passkey-count').textContent = '—';
+}
+async function sync() {
+  const version = ++syncVersion;
+  $('retry-sync').hidden = true;
+  try {
+    const result = await syncAcceptedCredentials(account, { live: store.live, browser: window });
+    if (version !== syncVersion) return;
+    const messages = {
+      demo: ['Your passkeys, kept in step.', 'In your live account, removing a passkey also notifies supported browsers. Demo changes won’t affect your real passkeys.'],
+      unsupported: ['Changes saved. One more thing…', 'This browser can’t update your authenticator automatically. Remove deleted Daily Grind passkeys from your password manager too.'],
+      signaled: ['Your browser has been notified.', 'We’ve shared your current passkey list with your browser. If a removed key still appears in your password manager, you can delete it there too.']
+    };
+    [$('sync-title').textContent, $('sync-detail').textContent] = messages[result];
+  } catch {
+    if (version !== syncVersion) return;
+    $('sync-title').textContent = 'Your account is saved. Browser sync needs a moment.';
+    $('sync-detail').textContent = 'We couldn’t notify your authenticator. Try again, or remove deleted passkeys from your password manager manually.';
+    $('retry-sync').hidden = false;
+  }
+}
+async function load() {
+  $('load-error').hidden = true;
+  $('retry-load').disabled = true;
+  try {
+    account = await store.list();
+    render();
+    void sync();
+  } catch (error) {
+    showLoadError(error.message || 'We couldn’t load your passkeys. Please try again.');
+  } finally { $('retry-load').disabled = false; }
+}
+function setBusy(value) {
+  busy = value;
+  for (const control of document.querySelectorAll('dialog button, dialog input')) control.disabled = value;
+  $('save-name').textContent = value ? 'Saving…' : 'Save name';
+  $('confirm-delete').textContent = value ? 'Deleting…' : 'Delete passkey';
+}
+list.addEventListener('click', event => {
+  const button = event.target.closest('button[data-action]');
+  if (!button || busy) return;
+  selectedId = button.closest('li').dataset.id;
+  const key = account.credentials.find(item => item.id === selectedId);
+  if (!key) return;
+  if (button.dataset.action === 'rename') {
+    $('passkey-name').value = key.name;
+    $('passkey-name').setCustomValidity('');
+    $('passkey-name').removeAttribute('aria-invalid');
+    $('rename-error').textContent = '';
+    renameDialog.showModal();
+    $('passkey-name').select();
+  } else {
+    $('delete-error').textContent = '';
+    $('delete-description').textContent = `“${key.name || 'Passkey'}” will no longer be able to sign in to your Daily Grind account. This can’t be undone here.`;
+    $('delete-warning').textContent = account.credentials.length === 1
+      ? 'This is your last passkey. Make sure you can sign in another way before deleting it.'
+      : 'Your other passkeys will keep working. If this key still appears in your password manager afterward, remove it there too.';
+    deleteDialog.showModal();
+  }
+});
+for (const button of document.querySelectorAll('[data-close]')) {
+  button.addEventListener('click', () => { if (!busy) $(button.dataset.close).close(); });
+}
+for (const dialog of [renameDialog, deleteDialog]) {
+  dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+  dialog.addEventListener('close', () => { dialog.returnValue = ''; });
+}
+$('passkey-name').addEventListener('input', () => {
+  $('passkey-name').setCustomValidity('');
+  $('passkey-name').removeAttribute('aria-invalid');
+  $('rename-error').textContent = '';
+});
+async function finishMutation(dialog, message, persisted, deleting) {
+  try {
+    account = await store.list();
+    // A deleted opener no longer exists. Move focus to a stable heading below.
+    render();
+    dialog.close();
+    if (deleting) $('page-title').focus({ preventScroll: true });
+    if (deleting) void sync();
+    announce(`${message}${persisted ? '' : ' Changes will last for this visit only; browser storage is unavailable.'}`);
+  } catch {
+    ++syncVersion;
+    dialog.close();
+    showLoadError(`${message} We couldn’t refresh the list. Please retry before making another change.`);
+    $('sync-title').textContent = 'Please refresh your passkey list.';
+    $('sync-detail').textContent = 'Browser sync will resume after we can load the complete list from your account.';
+    $('retry-sync').hidden = true;
+    $('retry-load').focus();
+    announce(`${message} Please refresh the list.`);
+  }
+}
+$('rename-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  const name = $('passkey-name').value.trim();
+  if (!name || name.length > 60) {
+    $('passkey-name').setCustomValidity('Enter a name between 1 and 60 characters.');
+    $('passkey-name').setAttribute('aria-invalid', 'true');
+    $('rename-error').textContent = 'Enter a name between 1 and 60 characters.';
+    $('passkey-name').reportValidity();
+    return;
+  }
+  setBusy(true);
+  try {
+    const persisted = await store.rename(selectedId, name);
+    await finishMutation(renameDialog, 'Passkey renamed.', persisted, false);
+  } catch (error) { $('rename-error').textContent = error.message || 'We couldn’t rename this passkey. Try again.'; }
+  finally { setBusy(false); }
+});
+$('confirm-delete').addEventListener('click', async () => {
+  if (busy) return;
+  setBusy(true);
+  try {
+    const persisted = await store.remove(selectedId);
+    await finishMutation(deleteDialog, 'Passkey deleted.', persisted, true);
+  } catch (error) { $('delete-error').textContent = error.message || 'We couldn’t delete this passkey. Try again.'; }
+  finally { setBusy(false); }
+});
+async function resetDemo() {
+  if (busy || store.live) return;
+  const persisted = store.reset();
+  await load();
+  announce(persisted ? 'Demo passkeys restored.' : 'Demo passkeys restored for this visit.');
+}
+$('reset-demo').addEventListener('click', resetDemo);
+$('empty-reset').addEventListener('click', resetDemo);
+$('retry-load').addEventListener('click', load);
+$('retry-sync').addEventListener('click', async () => {
+  // Reload first, rather than signaling a potentially outdated credential list.
+  $('retry-sync').disabled = true;
+  await load();
+  $('retry-sync').disabled = false;
+});
+try {
+  store = createPasskeyStore(config);
+  $('demo-notice').hidden = store.live;
+  if (store.live) {
+    $('customer-name').textContent = 'Your account';
+    $('avatar').textContent = 'DG';
+    $('passkey-count').textContent = '—';
+  }
+  await load();
+} catch (error) {
+  $('demo-notice').hidden = true;
+  showLoadError(error.message || 'The account service is unavailable.');
+  $('retry-load').hidden = true;
+}
