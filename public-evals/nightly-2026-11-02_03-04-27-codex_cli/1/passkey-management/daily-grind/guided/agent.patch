+.passkey-row {
+  display:flex;
+  gap:16px;
+  align-items:center;
+  padding:20px 0;
+  border-bottom:1px solid #eee9e2
+}
+
+.passkey-row:last-child {
+  border-bottom:0
+}
+
+.device-icon {
+  width:45px;
+  height:48px;
+  background:#f6f3ed;
+  border:1px solid #ece6db;
+  border-radius:7px;
+  display:grid;
+  place-items:center;
+  color:#77634c;
+  flex-shrink:0
+}
+
+.device-icon .icon {
+  width:25px;
+  height:25px;
+  stroke-width:1.3
+}
+
+.credential-details {
+  min-width:0;
+  flex:1
+}
+
+.credential-title {
+  display:flex;
+  align-items:center;
+  gap:8px
+}
+
+.credential-title h4 {
+  margin:0;
+  font-size:14px;
+  font-weight:600;
+  overflow-wrap:anywhere
+}
+
+.provider {
+  display:flex;
+  align-items:center;
+  gap:5px;
+  color:#7b7266;
+  margin:3px 0 6px;
+  font-size:11px
+}
+
+.provider img {
+  width:12px;
+  height:12px;
+  object-fit:contain
+}
+
+.credential-dates {
+  display:flex;
+  gap:10px;
+  color:#948878;
+  font-size:10px;
+  flex-wrap:wrap
+}
+
+.credential-dates span+span:before {
+  content:'·';
+  margin-right:10px
+}
+
+.row-actions {
+  display:flex;
+  gap:12px;
+  align-items:center;
+  flex-shrink:0
+}
+
+.rename-button {
+  display:flex;
+  align-items:center;
+  gap:6px;
+  padding:6px 9px;
+  background:#fffdfa;
+  border:1px solid #e8e1d7;
+  border-radius:4px;
+  font-size:11px;
+  color:#6e5c47;
+  min-height:34px
+}
+
+.rename-button:hover {
+  background:#f0e8da;
+  border-color:#c9b69c
+}
+
+.rename-button .icon {
+  width:12px;
+  height:12px
+}
+
+.delete-button {
+  display:grid;
+  place-items:center;
+  background:none;
+  border:0;
+  color:#978674;
+  min-width:29px;
+  min-height:32px;
+  border-radius:4px
+}
+
+.delete-button .icon {
+  width:16px;
+  height:16px
+}
+
+.delete-button:hover {
+  background:#fbefea;
+  color:#a74937
+}
+
+.sync-note {
+  display:flex;
+  gap:10px;
+  background:#f8f8f3;
+  border-top:1px solid #e9e9de;
+  padding:15px 26px;
+  color:#7a806b
+}
+
+.sync-note>.icon {
+  width:16px;
+  height:16px;
+  margin-top:2px
+}
+
+.sync-note p:first-child {
+  color:#657053;
+  font-size:11px;
+  font-weight:550;
+  margin:0 0 3px
+}
+
+.sync-note p {
+  font-size:11px;
+  line-height:1.6;
+  margin:0;
+  max-width:550px
+}
+
+.text-button {
+  font-size:11px;
+  padding:6px 0;
+  background:none;
+  border:0;
+  text-decoration:underline;
+  text-underline-offset:3px
+}
+
+.passkey-explainer {
+  margin-top:20px;
+  background:#fffefc;
+  border:1px solid var(--line);
+  border-radius:5px;
+  font-size:11px
+}
+
+.passkey-explainer summary {
+  display:flex;
+  align-items:center;
+  gap:9px;
+  cursor:pointer;
+  list-style:none;
+  padding:17px 20px;
+  font-weight:500;
+  min-height:53px
+}
+
+.passkey-explainer summary::-webkit-details-marker {
+  display:none
+}
+
+.passkey-explainer summary>.icon {
+  width:16px;
+  height:16px;
+  color:#94816a
+}
+
+.passkey-explainer summary>span {
+  font-weight:400;
+  color:#8a7f71;
+  font-size:10px;
+  margin-left:2px
+}
+
+.passkey-explainer summary>.disclosure-arrow {
+  width:12px;
+  height:12px;
+  margin-left:auto
+}
+
+.passkey-explainer[open] .disclosure-arrow {
+  transform:rotate(90deg)
+}
+
+.passkey-explainer>div {
+  padding:0 22px 10px;
+  color:var(--muted);
+  line-height:1.8
+}
+
+.help-line {
+  display:flex;
+  align-items:center;
+  gap:9px;
+  justify-content:center;
+  font-size:10px;
+  color:#8c806e;
+  margin:23px 0 0
+}
+
+.help-line p {
+  margin:0
+}
+
+.help-line .icon {
+  width:16px;
+  height:16px;
+  color:#b29a79
+}
+
+.help-line a {
+  color:#6d573f;
+  text-decoration:underline;
+  text-underline-offset:3px
+}
+
+.site-footer {
+  border-top:1px solid var(--line);
+  background:#f6f2ec
+}
+
+.footer-inner {
+  max-width:1160px;
+  margin:auto;
+  padding:27px 30px;
+  display:flex;
+  align-items:center;
+  justify-content:space-between;
+  gap:20px;
+  color:#938473;
+  font-size:9px
+}
+
+.footer-brand {
+  display:flex;
+  gap:10px;
+  align-items:center;
+  font-family:Georgia,serif;
+  font-style:italic;
+  font-size:11px;
+  color:#7c6a55
+}
+
+.footer-brand .icon {
+  width:21px;
+  height:21px
+}
+
+.footer-links {
+  display:flex;
+  gap:23px;
+  color:#7a6b5b
+}
+
+.footer-inner p {
+  margin:0
+}
+
+.loading-state {
+  padding:36px;
+  text-align:center;
+  color:var(--muted);
+  font-size:12px
+}
+
+.load-error {
+  padding:20px 26px;
+  font-size:12px
+}
+
+.empty-state {
+  text-align:center;
+  padding:30px 20px 38px
+}
+
+.empty-icon {
+  display:grid;
+  place-items:center;
+  margin:auto auto 15px;
+  width:48px;
+  height:48px;
+  border-radius:50%;
+  background:#f1ecdf;
+  color:#806644
+}
+
+.empty-state h4 {
+  font-family:'Libre Caslon Display',Georgia,serif;
+  font-size:26px;
+  margin:0 0 8px;
+  font-weight:400
+}
+
+.empty-state p {
+  font-size:12px;
+  color:var(--muted);
+  margin:0 0 18px
+}
+
+.toast {
+  position:fixed;
+  bottom:22px;
+  left:50%;
+  transform:translateX(-50%);
+  background:var(--brown);
+  color:#fff8ef;
+  border-radius:6px;
+  box-shadow:0 4px 20px #34281c25;
+  font-size:12px;
+  max-width:calc(100% - 32px);
+  z-index:5
+}
+
+.toast:not(:empty) {
+  padding:13px 22px
+}
+
+.noscript-message {
+  padding:20px;
+  text-align:center
+}
+
+dialog {
+  margin:auto;
+  padding:32px;
+  width:min(440px,calc(100% - 32px));
+  max-height:calc(100dvh - 40px);
+  overflow:auto;
+  border:1px solid #e0d5c6;
+  border-radius:10px;
+  background:var(--paper);
+  color:var(--ink);
+  box-shadow:0 20px 80px #241b1530
+}
+
+dialog:modal {
+  overscroll-behavior:contain
+}
+
+dialog::backdrop {
+  background:#2d251e75;
+  backdrop-filter:blur(3px);
+  overflow:hidden;
+  overscroll-behavior:contain
+}
+
+.dialog-icon {
+  display:grid;
+  place-items:center;
+  width:45px;
+  height:45px;
+  background:#efe7d9;
+  color:#8b6840;
+  border-radius:50%;
+  margin-bottom:20px
+}
+
+.dialog-icon .icon {
+  width:21px;
+  height:21px
+}
+
+dialog h2 {
+  font-size:33px;
+  margin-bottom:10px
+}
+
+dialog p {
+  font-size:12px;
+  color:var(--muted);
+  line-height:1.8;
+  margin:0 0 22px
+}
+
+.dialog-close {
+  position:absolute;
+  right:16px;
+  top:16px;
+  display:grid;
+  place-items:center;
+  border:0;
+  background:none;
+  min-width:32px;
+  min-height:32px;
+  color:var(--muted)
+}
+
+.dialog-close .icon {
+  width:18px;
+  height:18px
+}
+
+form label {
+  display:block;
+  font-size:12px;
+  font-weight:550;
+  margin:25px 0 8px
+}
+
+form input {
+  width:100%;
+  background:#fffefc;
+  border:1px solid #cfc2b1;
+  padding:11px 13px;
+  border-radius:4px;
+  color:var(--ink);
+  font-size:13px
+}
+
+form .input-hint {
+  font-size:10px;
+  margin:8px 0 0
+}
+
+.form-error {
+  color:#a43f2e;
+  font-size:12px;
+  min-height:0
+}
+
+.form-error:not(:empty) {
+  margin:12px 0
+}
+
+.dialog-actions {
+  display:flex;
+  justify-content:flex-end;
+  gap:10px;
+  margin-top:26px
+}
+
+.button {
+  border:1px solid transparent;
+  border-radius:4px;
+  padding:10px 16px;
+  font-size:12px;
+  font-weight:500;
+  min-height:40px
+}
+
+.button.primary {
+  background:var(--brown);
+  color:white
+}
+
+.button.primary:hover {
+  background:#654832
+}
+
+.button.secondary {
+  background:#fffdf8;
+  color:#6c5741;
+  border-color:#ded3c4
+}
+
+.button.secondary:hover {
+  background:#f1eade
+}
+
+.button.danger {
+  background:#a44936;
+  color:white
+}
+
+.button.danger:hover {
+  background:#8b3827
+}
+
+.danger-icon {
+  background:#f5e7df;
+  color:#a44936
+}
+
+p.delete-warning {
+  background:#f5eee2;
+  padding:12px;
+  border-radius:4px;
+  color:#826443;
+  font-size:11px;
+  margin-bottom:12px
+}
+
+@media(min-width:1400px) {
+  .page-shell {
+    max-width:1220px;
+    padding-top:5px
+  }
+  .header-inner {
+    max-width:1300px
+  }
+  .account-layout {
+    grid-template-columns:250px minmax(0,1fr);
+    gap:60px
+  }
+  .page-heading {
+    margin-top:24px;
+    margin-bottom:28px
+  }
+  .passkey-row {
+    padding:20px 0
+  }
+  .security-intro {
+    padding:20px
+  }
+  .footer-inner {
+    max-width:1220px
+  }
+}
+
+@media(max-width:1000px) {
+  .header-inner {
+    padding:0 26px;
+    gap:20px
+  }
+  .primary-nav {
+    gap:20px
+  }
+  .brand-type {
+    font-size:16px
+  }
+  .brand-type small {
+    font-size:7px
+  }
+  .header-order {
+    display:none
+  }
+  .account-layout {
+    grid-template-columns:210px minmax(0,1fr);
+    gap:30px
+  }
+  .secure-label {
+    display:none
+  }
+  .panel-heading {
+    padding-left:20px;
+    padding-right:20px
+  }
+  .panel-description {
+    margin-left:20px;
+    margin-right:20px
+  }
+  .passkey-list {
+    padding:0 20px
+  }
+  .demo-notice {
+    margin-left:20px;
+    margin-right:20px
+  }
+  .passkey-row {
+    gap:12px
+  }
+  .row-actions {
+    gap:5px
+  }
+  .credential-dates {
+    display:block
+  }
+  .credential-dates span {
+    display:block
+  }
+  .credential-dates span+span:before {
+    content:none
+  }
+  .security-intro {
+    padding:20px;
+    gap:13px
+  }
+  .intro-decoration {
+    opacity:.55
+  }
+  .desktop-break {
+    display:none
+  }
+  .footer-inner {
+    flex-wrap:wrap
+  }
+  .coffee-card p {
+    font-size:27px
+  }
+}
+
+@media(max-width:700px) {
+  .announcement {
+    font-size:7px;
+    letter-spacing:1.5px;
+    padding:9px
+  }
+  .announcement span {
+    margin:0 5px
+  }
+  .header-inner {
+    padding:20px;
+    min-height:0;
+    flex-wrap:wrap;
+    justify-content:center;
+    gap:19px
+  }
+  .brand-mark {
+    width:35px;
+    height:35px
+  }
+  .brand-mark .icon {
+    width:22px;
+    height:22px
+  }
+  .brand-type {
+    font-size:17px
+  }
+  .primary-nav {
+    width:100%;
+    justify-content:center;
+    gap:25px;
+    font-size:11px;
+    min-height:33px
+  }
+  .nav-active:after {
+    bottom:-20px
+  }
+  .primary-nav .icon {
+    width:15px;
+    height:15px
+  }
+  .page-shell {
+    padding:0 20px 35px
+  }
+  .breadcrumb {
+    padding-top:23px
+  }
+  .page-heading {
+    margin:27px 0 25px;
+    padding-bottom:22px
+  }
+  .page-heading>p {
+    display:none
+  }
+  h1 {
+    font-size:45px
+  }
+  .eyebrow {
+    font-size:8px
+  }
+  .account-layout {
+    grid-template-columns:1fr;
+    gap:27px
+  }
+  .profile {
+    padding-bottom:17px
+  }
+  .sidebar {
+    border-bottom:1px solid var(--line);
+    padding-bottom:14px
+  }
+  .account-nav {
+    flex-direction:row;
+    overflow-x:auto;
+    gap:5px;
+    padding:3px 0
+  }
+  .account-nav a {
+    white-space:nowrap;
+    min-height:40px;
+    padding:8px 11px;
+    font-size:10px;
+    gap:7px
+  }
+  .account-nav a.selected {
+    order:-1
+  }
+  .account-nav .icon {
+    width:15px;
+    height:15px
+  }
+  .account-nav .nav-chevron {
+    display:none
+  }
+  .signout,.coffee-card {
+    display:none
+  }
+  .profile div>span {
+    font-size:10px
+  }
+  .section-heading h2 {
+    font-size:29px
+  }
+  .section-heading {
+    margin-bottom:20px
+  }
+  .security-intro {
+    padding:19px 16px
+  }
+  .security-intro h3 {
+    font-size:12px
+  }
+  .security-intro p {
+    font-size:10px
+  }
+  .intro-icon {
+    width:38px;
+    height:38px
+  }
+  .intro-icon .icon {
+    width:21px;
+    height:21px
+  }
+  .panel-heading {
+    padding-top:21px
+  }
+  .panel-title h3 {
+    font-size:14px
+  }
+  .panel-description {
+    font-size:10px
+  }
+  .demo-notice {
+    font-size:8px;
+    padding:7px
+  }
+  .notice-detail {
+    display:none
+  }
+  .demo-notice button {
+    font-size:8px
+  }
+  .passkey-row {
+    flex-wrap:wrap;
+    position:relative;
+    padding:23px 0;
+    gap:12px
+  }
+  .device-icon {
+    width:38px;
+    height:43px
+  }
+  .device-icon .icon {
+    width:22px;
+    height:22px
+  }
+  .credential-title h4 {
+    font-size:12px
+  }
+  .credential-details {
+    flex-basis:calc(100% - 60px)
+  }
+  .row-actions {
+    margin-left:50px;
+    margin-top:1px;
+    gap:14px
+  }
+  .rename-button {
+    font-size:10px;
+    padding:6px 10px
+  }
+  .delete-button {
+    min-height:32px;
+    min-width:32px
+  }
+  .credential-dates {
+    display:flex;
+    gap:8px;
+    font-size:8px
+  }
+  .credential-dates span+span:before {
+    content:'·';
+    margin-right:8px
+  }
+  .sync-note {
+    padding:15px 19px
+  }
+  .passkey-explainer summary {
+    padding:16px;
+    font-size:11px;
+    gap:8px
+  }
+  .passkey-explainer summary>span {
+    font-size:9px
+  }
+  .footer-inner {
+    justify-content:center;
+    text-align:center;
+    padding:24px 20px;
+    gap:17px
+  }
+  .footer-brand {
+    width:100%;
+    justify-content:center
+  }
+  .footer-inner>p {
+    width:100%
+  }
+  .help-line {
+    margin-top:22px
+  }
+}
+
+@media(pointer:coarse) {
+  button {
+    min-height:44px
+  }
+  .delete-button {
+    min-width:44px
+  }
+  .rename-button {
+    padding-inline:12px
+  }
+  .demo-notice button {
+    padding-inline:8px
+  }
+}
+
