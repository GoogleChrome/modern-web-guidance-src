+// Demo records never reach WebAuthn. Live credentials come only from the signed-in API.
+export const DEMO_STORAGE_KEY = 'daily-grind.passkeys.demo.v1';
+export const demoAccount = {
+  complete: true,
+  rpId: 'demo.invalid',
+  user: { id: 'ZGVtby1hbGV4', displayName: 'Alex Morgan' },
+  credentials: [
+    { id: 'ZGVtby1tYWM', name: 'MacBook Pro', aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd', device: 'laptop', registeredAt: Date.UTC(2026, 8, 12), lastUsedAt: Date.UTC(2026, 10, 2) },
+    { id: 'ZGVtby1waG9uZQ', name: 'iPhone 15', aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd', device: 'phone', registeredAt: Date.UTC(2026, 8, 12), lastUsedAt: Date.UTC(2026, 9, 30) },
+    { id: 'ZGVtby15dWJpa2V5', name: 'YubiKey 5C', aaguid: '2fc0579f-8113-47ea-b116-bb5a8db9202a', device: 'security-key', registeredAt: Date.UTC(2026, 9, 5), lastUsedAt: Date.UTC(2026, 9, 24) }
+  ]
+};
+
+const isEncoded = value => typeof value === 'string' && /^[A-Za-z0-9_-]+$/.test(value) && value.length % 4 !== 1;
+const isTimestamp = value => Number.isFinite(value) && value >= 0 && value <= 8.64e15;
+export function validateAccount(data) {
+  // An incomplete/paginated list MUST NOT be sent to the authenticator: missing IDs
+  // could remove valid passkeys. This contract explicitly requires the full list.
+  if (!data || data.complete !== true || !Array.isArray(data.credentials) ||
+      !data.user || !isEncoded(data.user.id) || typeof data.user.displayName !== 'string' ||
+      typeof data.rpId !== 'string' || !data.rpId ||
+      data.credentials.some(key => !key || !isEncoded(key.id) ||
+        typeof key.name !== 'string' || !isTimestamp(key.registeredAt) ||
+        (key.lastUsedAt != null && !isTimestamp(key.lastUsedAt))) ||
+      new Set(data.credentials.map(key => key.id)).size !== data.credentials.length) {
+    throw new Error('We couldn’t load a complete passkey list. Please try again.');
+  }
+  return data;
+}
+
+export function createPasskeyStore(config = {}, environment = globalThis) {
+  const live = Boolean(config.apiBase);
+  const base = live ? new URL(config.apiBase, environment.location.href) : null;
+  if (base && (base.origin !== environment.location.origin || base.search || base.hash)) {
+    throw new Error('The account service must use a same-origin URL without query parameters.');
+  }
+  let demo = structuredClone(demoAccount);
+  if (!live) {
+    try {
+      const saved = environment.localStorage.getItem(DEMO_STORAGE_KEY);
+      if (saved) demo = validateAccount(JSON.parse(saved));
+    } catch { /* Unavailable or invalid storage starts a fresh in-memory demo. */ }
+  }
+  async function request(path, method = 'GET', body) {
+    const headers = { Accept: 'application/json' };
+    if (body) headers['Content-Type'] = 'application/json';
+    if (method !== 'GET' && config.csrfToken) headers['X-CSRF-Token'] = config.csrfToken;
+    const response = await environment.fetch(`${base.href.replace(/\/$/, '')}${path}`, {
+      method, credentials: 'same-origin', cache: 'no-store', redirect: 'error', headers,
+      body: body ? JSON.stringify(body) : undefined,
+      signal: AbortSignal.timeout(15000)
+    });
+    if (response.status === 401 || response.status === 403) {
+      throw new Error('Your session has expired or this action isn’t allowed. Please sign in again.');
+    }
+    if (!response.ok) throw new Error('We couldn’t save that change. Please try again.');
+    return method === 'GET' ? response.json() : undefined;
+  }
+  function saveDemo(next) {
+    // If persistent storage is blocked, changes still work for this visit.
+    let persisted = true;
+    try { environment.localStorage.setItem(DEMO_STORAGE_KEY, JSON.stringify(next)); }
+    catch { persisted = false; }
+    demo = next;
+    return persisted;
+  }
+  return {
+    live,
+    async list() {
+      return validateAccount(live ? await request('') : structuredClone(demo));
+    },
+    async rename(id, name) {
+      const clean = name.trim();
+      if (!clean || clean.length > 60) throw new Error('Enter a name between 1 and 60 characters.');
+      if (live) { await request(`/${encodeURIComponent(id)}`, 'PATCH', { name: clean }); return true; }
+      if (!demo.credentials.some(key => key.id === id)) throw new Error('This passkey no longer exists.');
+      return saveDemo({ ...demo, credentials: demo.credentials.map(key => key.id === id ? { ...key, name: clean } : key) });
+    },
+    async remove(id) {
+      if (live) { await request(`/${encodeURIComponent(id)}`, 'DELETE'); return true; }
+      if (!demo.credentials.some(key => key.id === id)) throw new Error('This passkey no longer exists.');
+      return saveDemo({ ...demo, credentials: demo.credentials.filter(key => key.id !== id) });
+    },
+    reset() {
+      if (live) throw new Error('Demo reset is unavailable for live accounts.');
+      return saveDemo(structuredClone(demoAccount));
+    }
+  };
+}
+
+export async function syncAcceptedCredentials(account, { live, browser = globalThis }) {
+  if (!live) return 'demo';
+  validateAccount(account);
+  if (!browser.isSecureContext || typeof browser.PublicKeyCredential?.signalAllAcceptedCredentials !== 'function') return 'unsupported';
+  // Labels are site-local. signalCurrentUserDetails is for ACCOUNT name changes,
+  // never for renaming an individual credential.
+  await browser.PublicKeyCredential.signalAllAcceptedCredentials({
+    rpId: account.rpId,
+    userId: account.user.id,
+    allAcceptedCredentialIds: account.credentials.map(key => key.id)
+  });
+  return 'signaled';
+}
diff --git a/passkey-store.test.mjs b/passkey-store.test.mjs
new file mode 100644
index 0000000..0c814a9
--- /dev/null
+++ b/passkey-store.test.mjs
@@ -0,0 +1,121 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createPasskeyStore, demoAccount, syncAcceptedCredentials, validateAccount } from './passkey-store.mjs';
+
+function environment() {
+  const saved = new Map();
+  return {
+    location: { href: 'https://coffee.example/account', origin: 'https://coffee.example' },
+    localStorage: { getItem: key => saved.get(key), setItem: (key, value) => saved.set(key, value) }
+  };
+}
+
+test('demo renames and deletions persist without contacting WebAuthn', async () => {
+  const env = environment();
+  const store = createPasskeyStore({}, env);
+  const first = demoAccount.credentials[0];
+  await store.rename(first.id, '  Work laptop  ');
+  const reloaded = createPasskeyStore({}, env);
+  assert.equal((await reloaded.list()).credentials[0].name, 'Work laptop');
+  await reloaded.remove(first.id);
+  const account = await reloaded.list();
+  assert.equal(account.credentials.length, 2);
+  const browser = { isSecureContext: true, PublicKeyCredential: { signalAllAcceptedCredentials() { assert.fail('Demo must never signal'); } } };
+  assert.equal(await syncAcceptedCredentials(account, { live: false, browser }), 'demo');
+  reloaded.reset();
+  assert.equal((await reloaded.list()).credentials.length, 3);
+});
+
+test('blocked local storage still allows changes for the current visit', async () => {
+  const env = environment();
+  env.localStorage.setItem = () => { throw new Error('Storage blocked'); };
+  const store = createPasskeyStore({}, env);
+  assert.equal(await store.remove(demoAccount.credentials[0].id), false);
+  assert.equal((await store.list()).credentials.length, 2);
+});
+
+test('blank or excessive labels are rejected without modifying credentials', async () => {
+  const store = createPasskeyStore({}, environment());
+  await assert.rejects(store.rename(demoAccount.credentials[0].id, '   '));
+  await assert.rejects(store.rename(demoAccount.credentials[0].id, 'a'.repeat(61)));
+  assert.deepEqual(await store.list(), demoAccount);
+});
+
+test('incomplete, duplicate, malformed, and invalid-date lists cannot be signaled', async () => {
+  for (const corrupt of [
+    account => { delete account.complete; },
+    account => { account.complete = false; },
+    account => { account.credentials.push(account.credentials[0]); },
+    account => { account.user.id = 'not base64url!'; },
+    account => { account.credentials[0].id = 'a'; },
+    account => { account.credentials[0].registeredAt = 1e30; },
+    account => { account.credentials[0].lastUsedAt = '2026-11-02'; }
+  ]) {
+    const account = structuredClone(demoAccount);
+    corrupt(account);
+    assert.throws(() => validateAccount(account));
+    await assert.rejects(syncAcceptedCredentials(account, { live: true, browser: {} }));
+  }
+});
+
+test('live deletion reloads the full authoritative list before syncing', async () => {
+  const env = environment();
+  let serverAccount = { ...structuredClone(demoAccount), rpId: 'coffee.example' };
+  const requests = [];
+  env.fetch = async (url, options) => {
+    requests.push({ url, options });
+    if (options.method === 'DELETE') {
+      serverAccount.credentials = serverAccount.credentials.filter(key => !url.endsWith(key.id));
+      return { ok: true, status: 204 };
+    }
+    if (options.method === 'PATCH') {
+      serverAccount.credentials[0].name = JSON.parse(options.body).name;
+      return { ok: true, status: 204 };
+    }
+    return { ok: true, status: 200, json: async () => structuredClone(serverAccount) };
+  };
+  const store = createPasskeyStore({ apiBase: '/api/account/passkeys', csrfToken: 'test-token' }, env);
+  const signals = [];
+  const browser = { isSecureContext: true, PublicKeyCredential: { signalAllAcceptedCredentials: async payload => signals.push(payload) } };
+  const initial = await store.list();
+  await syncAcceptedCredentials(initial, { live: store.live, browser });
+  await store.remove(initial.credentials[0].id);
+  await syncAcceptedCredentials(await store.list(), { live: store.live, browser });
+  assert.deepEqual(signals[1].allAcceptedCredentialIds, initial.credentials.slice(1).map(key => key.id));
+  assert.equal(signals[1].rpId, 'coffee.example');
+  assert.equal(signals[1].userId, initial.user.id);
+  assert.deepEqual(requests.map(item => item.options.method), ['GET', 'DELETE', 'GET']);
+  assert.equal(requests[1].options.credentials, 'same-origin');
+  assert.equal(requests[1].options.headers['X-CSRF-Token'], 'test-token');
+  await store.rename(serverAccount.credentials[0].id, 'New label');
+  assert.equal((await store.list()).credentials[0].name, 'New label');
+  assert.equal(signals.length, 2, 'Nickname updates must not send account-name signals');
+});
+
+test('deleting the final key signals an authoritative empty list', async () => {
+  const account = { ...structuredClone(demoAccount), credentials: [] };
+  let payload;
+  await syncAcceptedCredentials(account, { live: true, browser: {
+    isSecureContext: true, PublicKeyCredential: { signalAllAcceptedCredentials: async value => { payload = value; } }
+  } });
+  assert.deepEqual(payload.allAcceptedCredentialIds, []);
+});
+
+test('unsupported browsers and authenticator failures are distinguishable', async () => {
+  assert.equal(await syncAcceptedCredentials(demoAccount, { live: true, browser: { isSecureContext: true } }), 'unsupported');
+  const browser = { isSecureContext: true, PublicKeyCredential: { signalAllAcceptedCredentials: async () => { throw new Error('Sync failed'); } } };
+  await assert.rejects(syncAcceptedCredentials(demoAccount, { live: true, browser }), /Sync failed/);
+});
+
+test('failed authenticated requests never fall back to demo data', async () => {
+  const env = environment();
+  env.fetch = async () => ({ ok: false, status: 401 });
+  const store = createPasskeyStore({ apiBase: '/api/account/passkeys' }, env);
+  await assert.rejects(store.list(), /session has expired/);
+  await assert.rejects(store.remove(demoAccount.credentials[0].id), /session has expired/);
+  await assert.rejects(store.rename(demoAccount.credentials[0].id, 'New name'), /session has expired/);
+});
+
+test('cross-origin account services are rejected', () => {
+  assert.throws(() => createPasskeyStore({ apiBase: 'https://other.example/passkeys' }, environment()), /same-origin/);
+});
