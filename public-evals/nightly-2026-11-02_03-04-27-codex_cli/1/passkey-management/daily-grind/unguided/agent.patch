+'use strict';
+
+(() => {
+  const $ = (selector) => document.querySelector(selector);
+  const apiBase = $('meta[name="api-base"]').content.trim().replace(/\/$/, '');
+  const demo = !apiBase;
+  const storageKey = 'daily-grind-demo-passkeys-v1';
+  const initialKeys = [
+    { id: 'demo-macbook', name: 'MacBook Pro', device: 'laptop', provider: 'iCloud Keychain', created: '2026-10-12', lastUsed: 'Today', detail: 'Just now', current: true },
+    { id: 'demo-iphone', name: 'iPhone 15', device: 'phone', provider: 'iCloud Keychain', created: '2026-10-12', lastUsed: 'Yesterday', detail: '2:34 PM' },
+    { id: 'demo-security-key', name: 'YubiKey 5', device: 'usb', provider: 'Security key', created: '2026-10-05', lastUsed: 'Oct 28, 2026', detail: '10:12 AM' },
+  ];
+  let keys = [];
+  let snapshot = null;
+  let action = null;
+  let selectedId = null;
+  let toastTimer;
+  let returnFocus;
+  let busy = false;
+  const dialog = $('#key-dialog');
+
+  function notify(message) {
+    clearTimeout(toastTimer);
+    $('#toast').textContent = message;
+    $('#toast').hidden = false;
+    toastTimer = setTimeout(() => { $('#toast').hidden = true; }, 6500);
+  }
+
+  function icon(type) {
+    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+    svg.setAttribute('aria-hidden', 'true');
+    const use = document.createElementNS(svg.namespaceURI, 'use');
+    use.setAttribute('href', `#${type}`);
+    svg.append(use);
+    return svg;
+  }
+
+  function element(tag, className, text) {
+    const node = document.createElement(tag);
+    if (className) node.className = className;
+    if (text !== undefined) node.textContent = text;
+    return node;
+  }
+
+  async function request(path, options = {}) {
+    // Cookies supply the session; live mutations must also be protected by the server.
+    const csrf = document.querySelector('meta[name="csrf-token"]')?.content;
+    const response = await fetch(`${apiBase}${path}`, {
+      ...options,
+      credentials: 'same-origin',
+      headers: { 'Content-Type': 'application/json', ...(csrf ? { 'X-CSRF-Token': csrf } : {}), ...options.headers },
+    });
+    if (!response.ok) {
+      if (response.status === 401) throw new Error('Your session has expired. Please sign in again.');
+      throw new Error('We couldn’t save that change. Please try again.');
+    }
+    return response.status === 204 ? null : response.json();
+  }
+
+  function acceptSnapshot(data) {
+    if (!data || !Array.isArray(data.passkeys) || !data.user?.id || !data.rpId ||
+      data.passkeys.some(key => typeof key.id !== 'string' || typeof key.name !== 'string')) {
+      throw new Error('Your passkeys could not be loaded. Please try again.');
+    }
+    snapshot = data;
+    keys = data.passkeys;
+  }
+
+  function persist(next) {
+    // Persist before displaying success, including when browser storage is blocked/full.
+    try { localStorage.setItem(storageKey, JSON.stringify(next)); }
+    catch { throw new Error('This browser couldn’t save your demo changes. Allow site storage and try again.'); }
+    keys = next;
+  }
+
+  function dateLabel(value) {
+    const date = new Date(value);
+    return Number.isNaN(date.getTime()) ? 'Unknown date' : date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
+  }
+
+  function render() {
+    $('#key-count').textContent = keys.length;
+    const list = $('#passkey-list');
+    list.replaceChildren();
+    if (!keys.length) {
+      const empty = element('div', 'empty-state');
+      empty.append(icon('key'), element('h4', '', 'A fresh start for your sign-in.'), element('p', '', 'You don’t have any passkeys yet. Add one to make your next visit easier.'));
+      list.append(empty);
+      return;
+    }
+    for (const key of keys) {
+      const row = element('div', 'passkey-row');
+      const device = element('div', 'device');
+      const deviceIcon = element('span', 'device-icon');
+      deviceIcon.append(icon(['phone', 'usb'].includes(key.device) ? key.device : 'laptop'));
+      const detail = element('div', 'device-detail');
+      const nameLine = element('div', 'device-name-line');
+      nameLine.append(element('span', 'device-name', key.name));
+      if (key.current) nameLine.append(element('span', 'current-badge', 'THIS DEVICE'));
+      detail.append(nameLine, element('p', 'device-description', `${key.provider || 'Passkey'} · Added ${dateLabel(key.created)}`));
+      device.append(deviceIcon, detail);
+      const lastUsed = element('div', 'last-used', demo ? key.lastUsed : (key.lastUsed ? dateLabel(key.lastUsed) : 'Never used'));
+      if (demo && key.detail) lastUsed.append(element('small', '', key.detail));
+      const actions = element('div', 'row-actions');
+      for (const type of ['rename', 'delete']) {
+        const button = element('button', `icon-button ${type}`);
+        button.type = 'button';
+        button.setAttribute('aria-label', `${type === 'rename' ? 'Rename' : 'Delete'} ${key.name}`);
+        button.title = `${type === 'rename' ? 'Rename' : 'Delete'} passkey`;
+        button.append(icon(type === 'rename' ? 'edit' : 'trash'));
+        button.addEventListener('click', () => openDialog(type, key));
+        actions.append(button);
+      }
+      row.append(device, lastUsed, actions);
+      list.append(row);
+    }
+  }
+
+  async function synchronize() {
+    if (demo || !snapshot) return;
+    const message = $('#sync-message');
+    if (!window.isSecureContext || typeof window.PublicKeyCredential?.signalAllAcceptedCredentials !== 'function') {
+      message.textContent = 'Your account is up to date. This browser cannot sync passkey removals automatically. Remove unused keys from your password manager too.';
+      return;
+    }
+    try {
+      // Only the authenticated server's complete snapshot may reach a real authenticator.
+      await PublicKeyCredential.signalAllAcceptedCredentials({
+        rpId: snapshot.rpId,
+        userId: snapshot.user.id,
+        allAcceptedCredentialIds: snapshot.passkeys.map(key => key.id),
+      });
+      message.textContent = 'Your account is up to date. Your browser has been notified of your registered passkeys.';
+    } catch {
+      message.replaceChildren(document.createTextNode('Your account is up to date, but browser sync didn’t finish. '));
+      const retry = element('button', 'icon-button', 'Retry sync');
+      retry.addEventListener('click', () => { retry.disabled = true; void synchronize(); });
+      message.append(retry, document.createTextNode(' You can also remove the old key in your password manager.'));
+    }
+  }
+
+  function openDialog(type, key) {
+    action = type;
+    selectedId = key?.id;
+    returnFocus = document.activeElement;
+    $('#dialog-error').textContent = '';
+    const isDelete = type === 'delete';
+    $('#name-field').hidden = isDelete;
+    $('#key-name').required = !isDelete;
+    $('#key-name').value = key?.name || '';
+    $('#dialog-submit').classList.toggle('danger', isDelete);
+    $('#dialog-title').textContent = isDelete ? 'Remove this passkey?' : type === 'add' ? 'Add a passkey' : 'Rename passkey';
+    $('#dialog-submit').textContent = isDelete ? 'Remove passkey' : type === 'add' ? (demo ? 'Add demo passkey' : 'Continue') : 'Save name';
+    $('#dialog-description').textContent = isDelete
+      ? `“${key.name}” will no longer be able to sign in.${keys.length === 1 ? ' This is your last passkey. Make sure you have another way to sign in before removing it.' : ' Your other passkeys will keep working.'}${demo ? ' This only changes the demo account.' : ''}`
+      : type === 'add'
+        ? (demo ? 'Try adding a device to this demo account. No real passkey will be created in your password manager.' : 'Give this passkey a name, then follow your device’s instructions to register it.')
+        : 'Give your passkey a familiar name. This label is shown in your Daily Grind account.';
+    dialog.showModal();
+    if (!isDelete) { $('#key-name').focus(); $('#key-name').select(); }
+    else $('.dialog-cancel').focus();
+  }
+
+  function closeDialog() {
+    if (busy) return;
+    dialog.close();
+  }
+
+  dialog.addEventListener('close', () => {
+    if (returnFocus?.isConnected) returnFocus.focus();
+    else $('#add-passkey').focus();
+  });
+  dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+  $('.dialog-close').addEventListener('click', closeDialog);
+  $('.dialog-cancel').addEventListener('click', closeDialog);
+  $('#add-passkey').addEventListener('click', () => openDialog('add'));
+
+  function bytes(encoded) {
+    const base64 = encoded.replace(/-/g, '+').replace(/_/g, '/');
+    return Uint8Array.from(atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, '=')), char => char.charCodeAt(0));
+  }
+
+  async function register(name) {
+    if (!window.isSecureContext || !window.PublicKeyCredential) throw new Error('Passkey registration requires a supported browser and a secure connection.');
+    const options = await request('/passkeys/registration/options', { method: 'POST', body: JSON.stringify({ name }) });
+    const publicKey = typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function'
+      ? PublicKeyCredential.parseCreationOptionsFromJSON(options)
+      : { ...options, challenge: bytes(options.challenge), user: { ...options.user, id: bytes(options.user.id) }, excludeCredentials: options.excludeCredentials?.map(key => ({ ...key, id: bytes(key.id) })) };
+    const credential = await navigator.credentials.create({ publicKey });
+    if (!credential) throw new Error('Passkey creation was canceled. Please try again.');
+    const encode = value => btoa(String.fromCharCode(...new Uint8Array(value))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    const result = typeof credential.toJSON === 'function' ? credential.toJSON() : {
+      id: credential.id, rawId: encode(credential.rawId), type: credential.type,
+      response: { clientDataJSON: encode(credential.response.clientDataJSON), attestationObject: encode(credential.response.attestationObject), transports: credential.response.getTransports?.() || [] },
+      clientExtensionResults: credential.getClientExtensionResults(), authenticatorAttachment: credential.authenticatorAttachment,
+    };
+    acceptSnapshot(await request('/passkeys/registration/verify', { method: 'POST', body: JSON.stringify({ name, credential: result }) }));
+  }
+
+  $('#key-form').addEventListener('submit', async event => {
+    event.preventDefault();
+    if (busy) return;
+    const name = $('#key-name').value.trim();
+    if (action !== 'delete' && (!name || name.length > 60)) {
+      $('#dialog-error').textContent = 'Enter a name between 1 and 60 characters.';
+      $('#key-name').focus();
+      return;
+    }
+    busy = true;
+    $('#dialog-submit').disabled = true;
+    $('.dialog-cancel').disabled = true;
+    $('.dialog-close').disabled = true;
+    const submitText = $('#dialog-submit').textContent;
+    $('#dialog-submit').textContent = 'Saving…';
+    try {
+      if (demo) {
+        let next = keys.map(key => ({ ...key }));
+        if (action === 'rename') next = next.map(key => key.id === selectedId ? { ...key, name } : key);
+        else if (action === 'delete') next = next.filter(key => key.id !== selectedId);
+        else next.push({ id: `demo-${crypto.randomUUID()}`, name, device: 'laptop', provider: 'Demo device', created: new Date().toISOString(), lastUsed: 'Never used' });
+        persist(next);
+      } else if (action === 'add') await register(name);
+      else acceptSnapshot(await request(`/passkeys/${encodeURIComponent(selectedId)}`, { method: action === 'delete' ? 'DELETE' : 'PATCH', ...(action === 'rename' ? { body: JSON.stringify({ name }) } : {}) }));
+      render();
+      dialog.close();
+      notify(action === 'rename' ? 'Passkey name updated.' : action === 'delete' ? 'Passkey removed from your account.' : (demo ? 'Demo passkey added.' : 'Your new passkey is ready.'));
+      if (!demo) await synchronize();
+    } catch (error) {
+      $('#dialog-error').textContent = error.name === 'NotAllowedError' ? 'Passkey creation was canceled or timed out. You can try again.' : error.message;
+    } finally {
+      busy = false;
+      $('#dialog-submit').disabled = false;
+      $('.dialog-cancel').disabled = false;
+      $('.dialog-close').disabled = false;
+      $('#dialog-submit').textContent = submitText;
+    }
+  });
+
+  const tabs = [$('#passkeys-tab'), $('#password-tab')];
+  function selectTab(tab) {
+    tabs.forEach(item => {
+      const selected = item === tab;
+      item.classList.toggle('active', selected);
+      item.setAttribute('aria-selected', String(selected));
+      item.tabIndex = selected ? 0 : -1;
+      document.getElementById(item.getAttribute('aria-controls')).hidden = !selected;
+    });
+  }
+  tabs.forEach((tab, index) => {
+    tab.addEventListener('click', () => selectTab(tab));
+    tab.addEventListener('keydown', event => {
+      if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) {
+        event.preventDefault();
+        const target = tabs[event.key === 'Home' ? 0 : event.key === 'End' ? 1 : 1 - index];
+        selectTab(target);
+        target.focus();
+      }
+    });
+  });
+  $('#back-to-passkeys').addEventListener('click', () => { selectTab(tabs[0]); tabs[0].focus(); });
+
+  const sections = {
+    profile: ['Personal details', 'The person behind the daily ritual.', 'Jamie Davis', 'jamie.davis@email.com'],
+    orders: ['My orders', 'Your coffee moments, all in one place.', 'Ready for your next cup?', 'Your order history will appear here when connected to your customer account.'],
+    rewards: ['My rewards', 'A little thank-you for your daily ritual.', '240 points. Plenty of good ahead.', 'Keep sipping your favorites to earn more Daily Grind rewards.'],
+    addresses: ['Saved addresses', 'A good cup, wherever you call home.', 'No saved addresses yet', 'Your delivery addresses will appear here when connected to your customer account.'],
+  };
+  function selectSection() {
+    const section = location.hash.slice(1);
+    const selected = sections[section] ? section : 'security';
+    document.querySelectorAll('[data-section]').forEach(link => {
+      const active = link.dataset.section === selected;
+      link.classList.toggle('selected', active);
+      if (active) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    });
+    $('#security-panel').hidden = selected !== 'security';
+    $('#other-panel').hidden = selected === 'security';
+    if (sections[selected]) {
+      const [title, description, heading, content] = sections[selected];
+      $('#other-title').textContent = title;
+      $('#other-description').textContent = description;
+      $('#other-content').replaceChildren(element('h3', '', heading), element('p', '', content));
+    }
+  }
+  window.addEventListener('hashchange', selectSection);
+  selectSection();
+
+  async function load() {
+    $('#add-passkey').disabled = true;
+    $('#demo-note').hidden = !demo;
+    $('#passkey-list').textContent = 'Loading your passkeys…';
+    try {
+      if (demo) {
+        let saved;
+        try { saved = JSON.parse(localStorage.getItem(storageKey)); } catch { /* Start fresh if local data is unavailable. */ }
+        keys = Array.isArray(saved) && saved.every(key => key && typeof key.id === 'string' && typeof key.name === 'string') ? saved : initialKeys.map(key => ({ ...key }));
+        $('#sync-message').textContent = 'In a connected account, supported browsers are notified when a passkey is removed. Demo changes don’t affect your authenticator.';
+      } else {
+        if (new URL(apiBase, location.href).origin !== location.origin) throw new Error('The account API must use the same origin as this site.');
+        acceptSnapshot(await request('/passkeys'));
+        const profile = snapshot.user;
+        if (profile.name) { $('.profile strong').textContent = profile.name; }
+        if (profile.email) $('.profile span').textContent = profile.email;
+        if (profile.initials) document.querySelectorAll('.avatar,.profile-avatar').forEach(item => { item.textContent = profile.initials; });
+      }
+      render();
+      $('#add-passkey').disabled = false;
+      await synchronize();
+    } catch (error) {
+      $('#key-count').textContent = '—';
+      const empty = element('div', 'empty-state');
+      empty.append(element('h4', '', 'We couldn’t load your passkeys.'), element('p', '', error.message));
+      const retry = element('button', 'secondary', 'Try again');
+      retry.addEventListener('click', load);
+      empty.append(retry);
+      $('#passkey-list').replaceChildren(empty);
+    }
+  }
+  void load();
+})();
