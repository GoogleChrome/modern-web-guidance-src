@@ -0,0 +1,13 @@
+import { mkdir, copyFile } from 'node:fs/promises';
+import { execFileSync } from 'node:child_process';
+execFileSync(process.execPath, ['--check', 'account.js'], { stdio: 'inherit' });
+await mkdir('dist', { recursive: true });
+for (const file of ['index.html', 'home.html', 'styles.css', 'account.js']) {
+  await copyFile(file, `dist/${file}`);
+}
+// Static hosts can resolve /account/ without a fallback router.
+await mkdir('dist/account', { recursive: true });
+for (const file of ['index.html', 'home.html', 'styles.css', 'account.js']) {
+  await copyFile(file, `dist/account/${file}`);
+}
+console.log('Static site built in dist/');
