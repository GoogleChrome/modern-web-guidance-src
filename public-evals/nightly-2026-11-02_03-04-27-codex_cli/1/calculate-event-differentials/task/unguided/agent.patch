+  <script>
+    (() => {
+      // Numeric date components use the visitor's local time zone; months are zero-based.
+      const promotionEnd = new Date(2026, 2, 1, 0, 0, 0);
+      // Set the confirmed local promotion start date here to enable elapsed time.
+      // For example: new Date(2026, 0, 15, 0, 0, 0) for January 15, 2026.
+      const promotionStart = null;
+      const hour = 60 * 60 * 1000;
+
+      function formatDuration(milliseconds) {
+        const totalHours = Math.floor(Math.max(0, milliseconds) / hour);
+        const days = Math.floor(totalHours / 24);
+        const hours = totalHours % 24;
+        return `${days} ${days === 1 ? 'day' : 'days'} and ${hours} ${hours === 1 ? 'hour' : 'hours'}`;
+      }
+
+      function updatePromotionTimer() {
+        const now = Date.now();
+        const remaining = promotionEnd.getTime() - now;
+        document.getElementById('promotion-remaining').textContent = remaining <= 0
+          ? 'Offer ended · 0 days and 0 hours left'
+          : `${formatDuration(remaining)} left`;
+
+        const elapsed = document.getElementById('promotion-elapsed');
+        if (promotionStart === null) {
+          elapsed.textContent = 'Elapsed time unavailable: promotion start date needed.';
+        } else if (now < promotionStart.getTime()) {
+          elapsed.textContent = 'Promotion has not started · 0 days and 0 hours elapsed.';
+        } else {
+          elapsed.textContent = `${formatDuration(now - promotionStart.getTime())} since the promotion started.`;
+        }
+        document.getElementById('promotion-time').hidden = false;
+      }
+
+      // Run on every page load, and keep an open page current without a reload.
+      updatePromotionTimer();
+      window.setInterval(updatePromotionTimer, 60 * 1000);
+      window.addEventListener('pageshow', updatePromotionTimer);
+      document.addEventListener('visibilitychange', () => {
+        if (!document.hidden) updatePromotionTimer();
+      });
+    })();
+  </script>
+
 </body>
 
