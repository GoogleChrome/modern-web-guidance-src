diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -26,8 +26,73 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    .scroller {
+      height: 100vh;
+      height: 100dvh;
+      overflow-y: auto;
+      container-type: scroll-state;
+      container-name: page-scroll;
+      padding-bottom: 20px;
+    }
+
+    .scroll-sentinel {
+      height: 1px;
+      margin-bottom: -1px;
+      visibility: hidden;
+      pointer-events: none;
+    }
+
+    .back-to-top {
+      position: sticky;
+      bottom: 20px;
+      z-index: 1001;
+      display: block;
+      width: max-content;
+      margin: 0 20px 0 auto;
+      padding: 12px 18px;
+      border: 0;
+      border-radius: 999px;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      cursor: pointer;
+      box-shadow: 0 3px 12px rgb(0 0 0 / 20%);
+      visibility: hidden;
+      opacity: 0;
+      translate: 0 20px;
+      transition: opacity 0.25s ease, translate 0.25s ease;
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @container page-scroll scroll-state(scrollable: top) {
+      .back-to-top {
+        visibility: visible;
+        opacity: 1;
+        translate: 0 0;
+      }
+    }
+
+    @supports not (container-type: scroll-state) {
+      .scroller.scrolled .back-to-top {
+        visibility: visible;
+        opacity: 1;
+        translate: 0 0;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .back-to-top {
+        transition: none;
+        translate: none;
+      }
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
