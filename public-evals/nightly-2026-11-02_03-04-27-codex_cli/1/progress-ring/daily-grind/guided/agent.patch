+    /* Loyalty Rewards */
+    .rewards {
+      display: grid;
+      grid-template-columns: auto minmax(0, 1fr);
+      align-items: center;
+      gap: 32px;
+      margin-top: 40px;
+      padding: 32px;
+      border-top: 4px solid var(--accent);
+      text-align: left;
+    }
+
+    .rewards h2 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .rewards h3 {
+      margin-bottom: 8px;
+    }
+
+    .rewards-eyebrow {
+      font-size: 0.8rem;
+      font-weight: 700;
+      letter-spacing: 0.1em;
+      text-transform: uppercase;
+      margin-bottom: 4px;
+    }
+
+    .rewards-ring {
+      position: relative;
+      display: grid;
+      place-items: center;
+      width: 200px;
+      height: 200px;
+      max-width: 100%;
+      margin-inline: auto;
+      text-align: center;
+    }
+
+    .rewards-ring::before {
+      content: "";
+      position: absolute;
+      inset: 0;
+      border-radius: 50%;
+      background: conic-gradient(var(--primary) var(--reward-progress), var(--secondary) 0);
+      mask-image: radial-gradient(farthest-side, transparent calc(100% - 14px), black 0);
+    }
+
+    .rewards-ring-content {
+      padding: 24px;
+    }
+
+    .rewards-ring-content strong {
+      display: block;
+      color: var(--primary);
+      font-size: 2.5rem;
+      line-height: 1.2;
+    }
+
+    .rewards-ring-content span {
+      font-size: 0.9rem;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    @media (max-width: 600px) {
+      .rewards {
+        grid-template-columns: minmax(0, 1fr);
+        gap: 24px;
+        padding: 24px;
+        text-align: center;
+      }
+    }
+
