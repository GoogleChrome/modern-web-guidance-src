+  <dialog id="drink-dialog" class="drink-dialog" closedby="any" aria-labelledby="dialog-title" aria-describedby="dialog-intro">
+    <div class="dialog-header">
+      <h2 id="dialog-title">Drink details &amp; ordering options</h2>
+      <form method="dialog">
+        <button type="submit" class="btn">Close</button>
+      </form>
+    </div>
+    <p id="dialog-intro">Choose your drink and customize your selection. Online checkout is not available on this page.</p>
+    <form id="drink-order-form">
+      <label for="drink-choice">Drink</label>
+      <select id="drink-choice" name="drink" autofocus>
+        <option value="maple">Maple Oat Latte</option>
+        <option value="espresso">Dark Roast Espresso</option>
+        <option value="cold-brew">Cold Brew</option>
+      </select>
+      <h3 id="drink-name">Maple Oat Latte</h3>
+      <p id="drink-description">Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <label for="drink-size">Size</label>
+      <select id="drink-size" name="size"></select>
+      <label for="drink-temperature">Preparation</label>
+      <select id="drink-temperature" name="preparation"></select>
+      <label for="drink-quantity">Quantity</label>
+      <input id="drink-quantity" name="quantity" type="number" min="1" max="10" step="1" value="1" required>
+      <button type="submit" class="btn">Review selection</button>
+      <p id="order-summary" role="status" aria-atomic="true"></p>
+    </form>
+  </dialog>
+
+  <script>
+    const drinks = {
+      maple: {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        sizes: ['Small', 'Medium', 'Large'],
+        preparations: ['Hot', 'Iced']
+      },
+      espresso: {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        sizes: ['Single shot', 'Double shot'],
+        preparations: ['Hot']
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        sizes: ['Small', 'Medium', 'Large'],
+        preparations: ['Over ice', 'Without ice']
+      }
+    };
+    const dialog = document.getElementById('drink-dialog');
+    const orderForm = document.getElementById('drink-order-form');
+    const drinkChoice = document.getElementById('drink-choice');
+    const sizeChoice = document.getElementById('drink-size');
+    const preparationChoice = document.getElementById('drink-temperature');
+    const quantity = document.getElementById('drink-quantity');
+    const summary = document.getElementById('order-summary');
+
+    function updateDrink() {
+      const drink = drinks[drinkChoice.value];
+      document.getElementById('drink-name').textContent = drink.name;
+      document.getElementById('drink-description').textContent = drink.description;
+      sizeChoice.replaceChildren(...drink.sizes.map(size => new Option(size, size)));
+      preparationChoice.replaceChildren(...drink.preparations.map(preparation => new Option(preparation, preparation)));
+      summary.textContent = '';
+    }
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        orderForm.reset();
+        drinkChoice.value = button.dataset.drink;
+        updateDrink();
+        // Pointer activation does not focus buttons on every platform. Give the
+        // native dialog a focused invoker to restore when it closes.
+        button.focus();
+        dialog.showModal();
+      });
+    });
+
+    drinkChoice.addEventListener('change', updateDrink);
+    orderForm.addEventListener('input', () => { summary.textContent = ''; });
+    orderForm.addEventListener('submit', event => {
+      event.preventDefault();
+      summary.textContent = `Your selection: ${quantity.value} × ${drinks[drinkChoice.value].name}, ${sizeChoice.value}, ${preparationChoice.value}. No order has been placed.`;
+    });
+
+    // Preserve backdrop dismissal in browsers that do not support closedby.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = event => {
+        const bounds = dialog.getBoundingClientRect();
+        return event.clientX < bounds.left || event.clientX > bounds.right ||
+          event.clientY < bounds.top || event.clientY > bounds.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', event => {
+        pressedOutside = event.isPrimary && event.button === 0 && outside(event);
+      });
+      dialog.addEventListener('pointerup', event => {
+        if (pressedOutside && event.isPrimary && outside(event)) dialog.close();
+        pressedOutside = false;
+      });
+      dialog.addEventListener('pointercancel', () => { pressedOutside = false; });
+      dialog.addEventListener('close', () => { pressedOutside = false; });
+    }
+  </script>
+
 </body>
 
