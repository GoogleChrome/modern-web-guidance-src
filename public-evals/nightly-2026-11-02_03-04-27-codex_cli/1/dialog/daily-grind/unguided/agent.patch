+  <dialog id="drink-dialog" class="drink-dialog" aria-labelledby="dialog-title" aria-describedby="drink-description" closedby="any">
+    <div class="dialog-content">
+      <div class="dialog-header">
+        <h2 id="dialog-title" tabindex="-1" autofocus>Drink details &amp; ordering options</h2>
+        <button type="button" class="dialog-close" id="close-dialog" aria-label="Close drink details">Close</button>
+      </div>
+      <form id="drink-options">
+        <label for="drink-choice">Drink</label>
+        <select id="drink-choice" name="drink">
+          <option value="maple">Maple Oat Latte</option>
+          <option value="espresso">Dark Roast Espresso</option>
+          <option value="cold-brew">Cold Brew</option>
+        </select>
+        <p id="drink-description"></p>
+        <label for="drink-size">Size</label>
+        <select id="drink-size" name="size"></select>
+        <label for="drink-temperature">Preparation</label>
+        <select id="drink-temperature" name="preparation"></select>
+        <label for="drink-quantity">Quantity</label>
+        <input id="drink-quantity" name="quantity" type="number" min="1" max="10" value="1" required>
+        <button type="submit" class="btn">Review selection</button>
+        <p id="order-summary" role="status" aria-live="polite" aria-atomic="true"></p>
+      </form>
+    </div>
+  </dialog>
+
+  <script>
+    const drinks = {
+      maple: {
+        description: 'Maple Oat Latte: creamy oat milk with a hint of Vermont maple syrup.',
+        sizes: ['Small', 'Medium', 'Large'],
+        preparations: ['Hot', 'Iced']
+      },
+      espresso: {
+        description: 'Dark Roast Espresso: bold, smokey, and perfect for a morning boost.',
+        sizes: ['Single shot', 'Double shot'],
+        preparations: ['Hot']
+      },
+      'cold-brew': {
+        description: 'Cold Brew: steeped for 18 hours for maximum smoothness.',
+        sizes: ['Small', 'Medium', 'Large'],
+        preparations: ['Iced']
+      }
+    };
+
+    const dialog = document.getElementById('drink-dialog');
+    const drinkChoice = document.getElementById('drink-choice');
+    const size = document.getElementById('drink-size');
+    const preparation = document.getElementById('drink-temperature');
+    const quantity = document.getElementById('drink-quantity');
+    const summary = document.getElementById('order-summary');
+    let opener;
+
+    function updateDrink() {
+      const drink = drinks[drinkChoice.value];
+      document.getElementById('drink-description').textContent = drink.description;
+      size.replaceChildren(...drink.sizes.map(value => new Option(value, value)));
+      preparation.replaceChildren(...drink.preparations.map(value => new Option(value, value)));
+      summary.textContent = '';
+    }
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        opener = button;
+        drinkChoice.value = button.dataset.drink;
+        quantity.value = '1';
+        updateDrink();
+        dialog.showModal();
+        document.getElementById('dialog-title').focus();
+      });
+    });
+
+    drinkChoice.addEventListener('change', updateDrink);
+    document.getElementById('drink-options').addEventListener('input', () => {
+      summary.textContent = '';
+    });
+    document.getElementById('drink-options').addEventListener('submit', event => {
+      event.preventDefault();
+      const name = drinkChoice.selectedOptions[0].textContent;
+      summary.textContent = `Your selection: ${quantity.value} × ${name}, ${size.value.toLowerCase()}, ${preparation.value.toLowerCase()}. No order or payment has been submitted.`;
+    });
+
+    document.getElementById('close-dialog').addEventListener('click', () => dialog.close());
+    dialog.addEventListener('close', () => {
+      if (opener?.isConnected) opener.focus();
+    });
+
+    // Keep native Escape/platform cancel behavior. Support backdrop dismissal
+    // in browsers that do not yet implement closedby="any" as well.
+    function isOutsideDialog(event) {
+      const bounds = dialog.getBoundingClientRect();
+      return event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom;
+    }
+
+    let pointerStartedOutside = false;
+    dialog.addEventListener('pointerdown', event => {
+      pointerStartedOutside = event.target === dialog && isOutsideDialog(event);
+    });
+    dialog.addEventListener('pointercancel', () => {
+      pointerStartedOutside = false;
+    });
+    dialog.addEventListener('click', event => {
+      if (pointerStartedOutside && event.target === dialog && isOutsideDialog(event)) {
+        dialog.close();
+      }
+      pointerStartedOutside = false;
+    });
+  </script>
+
 </body>
 
