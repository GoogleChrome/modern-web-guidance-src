+const drinks={iced:{name:'Iced oat latte',price:'$5.50',description:'A little pick-me-up. A whole lot of smooth.',image:'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=800&q=85',alt:'Iced latte in a glass on a warm café table'},hot:{name:'Maple oat latte',price:'$5.00',description:'Warm oat milk. A touch of maple. Your moment.',image:'https://images.unsplash.com/photo-1511081692775-05d0f180a065?auto=format&fit=crop&w=800&q=85',alt:'Warm latte with delicate foam art in a ceramic cup'}};
