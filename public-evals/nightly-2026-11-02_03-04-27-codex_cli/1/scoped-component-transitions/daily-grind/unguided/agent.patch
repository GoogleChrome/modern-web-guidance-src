+document.querySelectorAll('[data-drink]').forEach(button=>button.addEventListener('click',()=>{if(drink!==button.dataset.drink)setDrink(button.dataset.drink)}));
+$('duration').addEventListener('input',event=>{$('duration-value').textContent=event.target.value+' ms'});
+$('boundary').addEventListener('click',()=>{const active=$('boundary').getAttribute('aria-checked')!=='true';$('boundary').setAttribute('aria-checked',active);$('coffee-card').classList.toggle('boundary',active)});
+$('replay').addEventListener('click',()=>setDrink(drink));
+document.addEventListener('keydown',event=>{if(event.key.toLowerCase()==='r'&&!event.ctrlKey&&!event.metaKey&&!event.altKey&&!['INPUT','SELECT','TEXTAREA','BUTTON'].includes(document.activeElement.tagName)){event.preventDefault();setDrink(drink)}});
+document.querySelector('.favorite').addEventListener('click',event=>{const button=event.currentTarget;const saved=button.getAttribute('aria-pressed')!=='true';button.setAttribute('aria-pressed',saved);button.textContent=saved?'♥':'♡';motion(button,[{transform:'scale(.8)'},{transform:'scale(1.15)'},{transform:'scale(1)'}],{duration:reducedMotion.matches?0:300})});
+function toast(message){const element=document.querySelector('.toast');clearTimeout(toastTimer);element.textContent=message;element.hidden=false;reveal(element);toastTimer=setTimeout(()=>element.hidden=true,3000)}
+$('add-order').addEventListener('click',()=>{orderCount++;toast(drinks[drink].name+' added · '+orderCount+' item'+(orderCount===1?'':'s')+' in your order');$('add-order').innerHTML='Added to order <span>✓</span>';setTimeout(()=>$('add-order').innerHTML='Add to order <span>+</span>',1600)});
+const tracks=[['Slow mornings','Sunday Collective','#d9c0a1'],['Golden hour','Low Tide Club','#c2cbb0'],['Somewhere quiet','The Paper Kites','#c5c1cf']];
+$('next-track').addEventListener('click',()=>{track=(track+1)%tracks.length;const item=tracks[track];$('track-name').textContent=item[0];$('track-artist').textContent=item[1];document.querySelector('.album').style.background=item[2];reveal($('music-content'))});
+let audioContext,oscillator,gain;
+$('play').addEventListener('click',()=>{const button=$('play');const playing=button.getAttribute('aria-pressed')!=='true';if(playing){try{audioContext??=new (window.AudioContext||window.webkitAudioContext)();audioContext.resume();oscillator=audioContext.createOscillator();gain=audioContext.createGain();oscillator.type='sine';oscillator.frequency.value=[261.63,293.66,329.63][track];gain.gain.value=.035;oscillator.connect(gain);gain.connect(audioContext.destination);oscillator.start()}catch{toast('Audio preview is unavailable in this browser');return}}else{oscillator?.stop();oscillator=null}button.setAttribute('aria-pressed',playing);button.setAttribute('aria-label',playing?'Pause music preview':'Play music preview');button.textContent=playing?'Ⅱ':'▶';reveal(document.querySelector('.album'))});
