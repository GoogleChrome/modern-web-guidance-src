+
+const contexts = {
+  neutral: { name: 'Neutral', description: 'A little context goes a long way.', title: 'You’re all caught up', body: 'Everything is in place. You’re ready for what’s next.', button: 'View details', status: 'In progress', label: 'Information', icon: InformationCircleIcon },
+  success: { name: 'Success', description: 'Good news deserves a little clarity.', title: 'Changes saved successfully', body: 'Your workspace is up to date. Keep the good work going.', button: 'Continue', status: 'Completed', label: 'Success', icon: CheckCircleIcon },
