+  critical: { name: 'Critical', description: 'Make the important things unmistakable.', title: 'Something needs your attention', body: 'We couldn’t save your changes. Please try again.', button: 'Try again', status: 'Action required', label: 'Critical', icon: ExclamationTriangleIcon },
+};
+type Context = keyof typeof contexts;
+const navItems = [{ name: 'Overview', icon: Squares2X2Icon }, { name: 'Components', icon: CubeIcon, count: '24' }, { name: 'Contexts', icon: SwatchIcon }, { name: 'Patterns', icon: RectangleGroupIcon }, { name: 'Documentation', icon: BookOpenIcon }];
+const components = [ { title: 'Notification', category: 'Feedback', icon: BellIcon, kind: 'notification' }, { title: 'Button', category: 'Action', icon: BoltIcon, kind: 'button' }, { title: 'Status badge', category: 'Indicator', icon: CheckCircleIcon, kind: 'badge' } ];
+export default function ContextWorkspace() {
+  const [context, setContext] = useState<Context>('success');
+  const [tab, setTab] = useState('Preview');
+  const [nav, setNav] = useState('Overview');
+  const [search, setSearch] = useState('');
+  const [category, setCategory] = useState('All');
+  const [showFilters, setShowFilters] = useState(false);
+  const [dismissed, setDismissed] = useState(false);
+  useEffect(() => setDismissed(false), [context]);
