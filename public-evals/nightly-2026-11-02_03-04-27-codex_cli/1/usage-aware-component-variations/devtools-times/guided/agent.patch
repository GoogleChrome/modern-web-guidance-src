+      <main>
+        <section className="page-heading"><div><div className="eyebrow">YOUR DESIGN, IN CONTEXT</div><h1>{nav === 'Overview' ? 'A little context. A lot of possibility.' : nav === 'Components' ? 'Your component collection.' : nav === 'Contexts' ? 'Meaning makes the difference.' : 'Good patterns. Great experiences.'}</h1><p>Thoughtful components that adapt to where they are and what they mean.</p></div><button className="primary-button" onClick={() => setModal('component')}><PlusIcon/> New component</button></section>
+        <section className="stats" aria-label="Workspace statistics">{[{ label: 'Components', value: 24 + custom.length, note: '+4 this month', icon: CubeIcon, cls: 'green' }, { label: 'Semantic contexts', value: '04', note: 'One shared language', icon: SwatchIcon, cls: 'purple' }, { label: 'Adaptive patterns', value: '12', note: 'Made to work together', icon: RectangleGroupIcon, cls: 'orange' }, { label: 'System health', value: '100', suffix: '%', note: 'Everything looks good', icon: CheckCircleIcon, cls: 'green' }].map(s => <article className="stat" key={s.label}><div className="stat-label">{s.label}<span className={`stat-icon ${s.cls}`}><s.icon/></span></div><div className="stat-value">{s.value}<span>{s.suffix}</span></div><div className={`stat-note ${s.label === 'Components' || s.label === 'System health' ? 'positive' : ''}`}>{s.label === 'Components' && <ArrowUpRightIcon/>}{s.label === 'System health' && <i/>}{s.note}</div></article>)}</section>
+        <div className="content-grid"><div className="primary-content">
+          <section className="playground panel"><div className="section-heading"><div><h2>Context playground <span className="pill">LIVE PREVIEW</span></h2><p>Same component. Different meaning. See it adapt.</p></div><button className="icon-button" aria-label="Reset playground" onClick={() => { setContext('success'); setTab('Preview'); setDismissed(false); notify('Playground reset'); }}><ArrowPathIcon/></button></div>
+            <div className="context-tabs" role="tablist" aria-label="Semantic context">{Object.entries(contexts).map(([key, item]) => <button role="tab" aria-selected={context === key} key={key} className={context === key ? 'selected' : ''} onClick={() => setContext(key as Context)}><i className={`context-dot ${key}`}/>{item.name}{context === key && <CheckIcon/>}</button>)}</div>
+            <div className="preview-toolbar"><div className="view-tabs">{['Preview', 'Code'].map(t => <button key={t} className={tab === t ? 'selected' : ''} onClick={() => setTab(t)}>{t === 'Preview' ? <ComputerDesktopIcon/> : <CommandLineIcon/>}{t}</button>)}</div><span><span className="context-token">{context}</span><span className="toolbar-divider"/><SunIcon/></span></div>
+            <div className={`preview-stage semantic-surface intent-${context}`} style={{ '--intent': context } as React.CSSProperties}>
