+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+
+    // Measure each line at a shared size, then fit the glyphs to the heading.
+    // Letter spacing stays unchanged, including after fonts or viewport resize.
+    function fitHeroHeading() {
+      const width = heroHeading.clientWidth;
+      if (!width) return;
+
+      const lines = [...heroHeading.querySelectorAll('span')];
+      lines.forEach(line => { line.style.fontSize = '100px'; });
+      const sizes = lines.map(line => 100 * width / line.getBoundingClientRect().width);
+      lines.forEach((line, index) => { line.style.fontSize = `${sizes[index]}px`; });
+    }
+
+    let headingWidth;
+    new ResizeObserver(([entry]) => {
+      if (entry.contentRect.width === headingWidth) return;
+      headingWidth = entry.contentRect.width;
+      fitHeroHeading();
+    }).observe(heroHeading);
+
+    fitHeroHeading();
+    document.fonts.ready.then(fitHeroHeading);
+  </script>
 </body>
 
