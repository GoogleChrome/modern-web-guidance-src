+}
+:focus-visible {
+  outline: 3px solid #92400e;
+  outline-offset: 3px;
+}
+
+.skip-link {
+  position: fixed;
+  top: 1rem;
+  left: 1rem;
+  z-index: 100;
+  transform: translateY(-200%);
+  padding: .75rem 1rem;
+  background: white;
+  color: #111827;
+}
+
+.skip-link:focus { transform: translateY(0); }
+
+.overlay-dialog {
+  width: min(42rem, calc(100vw - 2rem));
+  max-height: 80dvh;
+  margin: 10dvh auto auto;
+  padding: 0;
+  border: 0;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+
+.overlay-dialog::backdrop {
+  background: rgb(255 255 255 / .45);
+  backdrop-filter: blur(4px);
+}
+
+body:has(.overlay-dialog[open]) { overflow: hidden; }
+
+.navigation-popover {
+  position: fixed;
+  inset: auto;
+  left: 50%;
+  transform: translateX(-50%);
+  margin: 0;
+  width: max-content;
+  max-width: calc(100vw - 2rem);
+  max-height: 65dvh;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+
+.navigation-popover-wide { width: min(72rem, calc(100vw - 2rem)); }
