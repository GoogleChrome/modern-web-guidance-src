+++ b/src/components/Modal.tsx
@@ -0,0 +1,46 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  title: string;
+  onClose: () => void;
+  children: ReactNode;
+  initialFocus?: string;
+}
+
+export default function Modal({ id, title, onClose, children, initialFocus }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const closeCallback = useRef(onClose);
+  closeCallback.current = onClose;
+
+  useEffect(() => {
+    const dialog = dialogRef.current!;
+    const trigger = document.activeElement instanceof HTMLElement ? document.activeElement : null;
+    dialog.showModal();
+    if (initialFocus) dialog.querySelector<HTMLElement>(initialFocus)?.focus();
+    const handleClose = () => closeCallback.current();
+    dialog.addEventListener('close', handleClose);
+    return () => {
+      dialog.removeEventListener('close', handleClose);
+      dialog.close();
+      if (trigger?.isConnected) trigger.focus();
+    };
+  }, []);
+
+  return (
+    <dialog ref={dialogRef} id={id} aria-labelledby={`${id}-title`} className="overlay-dialog bg-white shadow-xl"
+      onClick={event => {
+        if (event.target !== event.currentTarget) return;
+        const bounds = event.currentTarget.getBoundingClientRect();
+        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
+          event.currentTarget.close();
+        }
+      }}>
+      <div className="flex items-center justify-between gap-4 p-4 border-b border-gray-200">
+        <h2 id={`${id}-title`} className="text-lg font-semibold">{title}</h2>
+        <button type="button" aria-label={`Close ${title.toLowerCase()}`} onClick={() => dialogRef.current?.close()} className="p-2 text-gray-600 hover:text-amber-700">✕</button>
+      </div>
+      {children}
+    </dialog>
+  );
+}
diff --git a/src/components/NativePopover.tsx b/src/components/NativePopover.tsx
new file mode 100644
index 0000000..e4b5e41
--- /dev/null
+++ b/src/components/NativePopover.tsx
@@ -0,0 +1,35 @@
+import { useId, useRef, useState, type ReactNode } from 'react';
+
+interface Props {
+  label: string;
+  children: ReactNode;
+  icon?: ReactNode;
+  active?: boolean;
+  wide?: boolean;
+}
+
+export default function NativePopover({ label, children, icon, active = false, wide = false }: Props) {
+  const id = useId();
+  const trigger = useRef<HTMLButtonElement>(null);
+  const [open, setOpen] = useState(false);
+  return (
+    <>
+      <button ref={trigger} type="button" popoverTarget={id} aria-controls={id} aria-expanded={open}
+        className={`flex items-center gap-1 whitespace-nowrap hover:text-amber-700 ${active ? 'text-amber-700' : ''}`}
+        aria-label={icon ? label : undefined}>
+        {icon ?? <>{label}<span aria-hidden="true">⌄</span></>}
+      </button>
+      <div id={id} popover="auto" aria-label={label} className={`navigation-popover bg-white border border-gray-300 shadow-lg p-6 ${wide ? 'navigation-popover-wide' : ''}`}
+        onToggle={event => {
+          const isOpen = event.newState === 'open';
+          setOpen(isOpen);
+          if (isOpen && trigger.current) {
+            const bounds = trigger.current.getBoundingClientRect();
+            event.currentTarget.style.top = `${Math.min(bounds.bottom + 4, window.innerHeight - 80)}px`;
+          }
+        }}>
+        {children}
+      </div>
+    </>
+  );
+}
