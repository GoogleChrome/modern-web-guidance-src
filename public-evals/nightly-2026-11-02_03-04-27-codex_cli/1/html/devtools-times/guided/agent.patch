diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..9fb5f27
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,52 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  titleId: string;
+  open: boolean;
+  onClose: () => void;
+  children: ReactNode;
+}
+
+export default function Modal({ id, titleId, open, onClose, children }: Props) {
+  const ref = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const dialog = ref.current!;
+    if (open && !dialog.open) dialog.showModal();
+    else if (!open && dialog.open) dialog.close();
+  }, [open]);
+
+  useEffect(() => {
+    const dialog = ref.current!;
+    // Preserve backdrop dismissal on browsers without closedby support.
+    if ('closedBy' in dialog) return;
+    const outside = (event: PointerEvent) => {
+      const rect = dialog.getBoundingClientRect();
+      return event.clientX < rect.left || event.clientX > rect.right ||
+        event.clientY < rect.top || event.clientY > rect.bottom;
+    };
+    let pressedOutside = false;
+    const down = (event: PointerEvent) => { pressedOutside = outside(event); };
+    const up = (event: PointerEvent) => {
+      if (pressedOutside && outside(event)) dialog.close();
+      pressedOutside = false;
+    };
+    dialog.addEventListener('pointerdown', down);
+    dialog.addEventListener('pointerup', up);
+    return () => {
+      dialog.removeEventListener('pointerdown', down);
+      dialog.removeEventListener('pointerup', up);
+    };
+  }, []);
+
+  return (
+    <dialog ref={ref} id={id} aria-labelledby={titleId} closedBy="any"
+      className="app-dialog bg-white shadow-xl" onClose={onClose}>
+      {children}
+      <form method="dialog" className="absolute top-2 right-2">
+        <button type="submit" className="p-2 text-gray-600 hover:text-amber-700" aria-label="Close dialog">✕</button>
+      </form>
+    </dialog>
+  );
+}
diff --git a/src/components/Popover.tsx b/src/components/Popover.tsx
new file mode 100644
index 0000000..22727d7
--- /dev/null
+++ b/src/components/Popover.tsx
@@ -0,0 +1,29 @@
+import { useId, useRef, type ReactNode } from 'react';
+
+export default function Popover({ label, children, active = false }: {
+  label: ReactNode;
+  children: ReactNode;
+  active?: boolean;
+}) {
+  const id = useId();
+  const ref = useRef<HTMLDivElement>(null);
+  return (
+    <>
+      <button type="button" popoverTarget={id}
+        className={`flex items-center gap-1 whitespace-nowrap p-2 hover:text-amber-700 ${active ? 'text-amber-700' : ''}`}
+        onClick={event => {
+          const bottom = event.currentTarget.getBoundingClientRect().bottom;
+          ref.current?.style.setProperty('--popover-top', `${bottom + 8}px`);
+        }}>
+        {label}
+        <svg aria-hidden="true" className="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3">
+          <path strokeLinecap="round" strokeLinejoin="round" d="m5 9 7 7 7-7" />
+        </svg>
+      </button>
+      <div ref={ref} id={id} popover="auto" className="nav-popover bg-white border border-gray-300 shadow-lg">
+        {children}
+        <button type="button" popoverTarget={id} popoverTargetAction="hide" className="m-4 p-2 text-sm underline">Close menu</button>
+      </div>
+    </>
+  );
+}
