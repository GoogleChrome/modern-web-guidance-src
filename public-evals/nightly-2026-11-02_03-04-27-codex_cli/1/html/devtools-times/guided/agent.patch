+          value={searchTerm} onChange={event => setSearchTerm(event.target.value)} />
+        <p role="status" className="text-sm text-gray-600 mt-2">
+          {query ? `${results.length} ${results.length === 1 ? 'result' : 'results'} found.` : 'Browse featured articles or enter a search.'}
+        </p>
+      </search>
+      <div className="p-4">
