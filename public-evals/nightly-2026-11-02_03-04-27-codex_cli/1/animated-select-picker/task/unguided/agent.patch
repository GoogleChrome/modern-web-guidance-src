@@ -92,8 +92,99 @@
       font-size: 3rem;
       margin-bottom: 1rem;
     }
 
+    .store-selector {
+      width: min(100%, 320px);
+      margin-top: 1.25rem;
+      text-align: left;
+    }
+
+    .store-selector label {
+      display: block;
+      margin-bottom: 0.4rem;
+      font-size: 0.9rem;
+      font-weight: 600;
+    }
+
+    .store-select {
+      width: 100%;
+      padding: 0.75rem 1rem;
+      border: 1px solid var(--secondary);
+      border-radius: 5px;
+      background: var(--light);
+      color: var(--text);
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .store-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    /* Opt into the browser's customizable native picker where supported. */
+    @supports (appearance: base-select) {
+      .store-select,
+      .store-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .store-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 250ms ease;
+      }
+
+      .store-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .store-select::picker(select) {
+        margin-top: 6px;
+        border: 1px solid var(--secondary);
+        border-radius: 5px;
+        background: var(--light);
+        color: var(--text);
+        box-shadow: 0 8px 24px rgb(0 0 0 / 20%);
+        opacity: 0;
+        /* Keep the picker visible and in the top layer during its exit fade. */
+        transition: opacity 250ms ease,
+          display 250ms allow-discrete,
+          overlay 250ms allow-discrete;
+      }
+
+      .store-select:open::picker(select) {
+        opacity: 1;
+      }
+
+      @starting-style {
+        .store-select:open::picker(select) {
+          opacity: 0;
+        }
+      }
+
+      .store-select option {
+        padding: 0.75rem 1rem;
+      }
+
+      .store-select option:checked {
+        background: var(--secondary);
+      }
+
+      .store-select option:hover,
+      .store-select option:focus-visible {
+        background: var(--primary);
+        color: white;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker-icon,
+      .store-select::picker(select) {
+        transition: none;
+      }
+    }
+
