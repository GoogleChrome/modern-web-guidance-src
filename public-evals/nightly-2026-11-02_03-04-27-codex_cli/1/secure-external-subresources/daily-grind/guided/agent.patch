+  <script>
+    // Release-time SHA-384 digests pin the exact font and fixed JPEG renditions.
+    // fetch integrity works across browsers; img integrity and CSS URL modifiers
+    // are not universally supported. Never display an unverified remote fallback.
+    // If a provider changes these bytes, review the asset before updating its hash.
+    const assets = {
+      "font": {
+        "url": "https://cdn.jsdelivr.net/npm/@fontsource/lora@5.2.6/files/lora-latin-400-normal.woff2",
+        "integrity": "sha384-aFxA3BDBa0FQEb3YpbJCAXLunGfquJVh+SIk8+aJiR4VNizJ/CAi9XDHEN9FvMPY"
+      },
+      "hero": {
+        "url": "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?fm=jpg&fit=crop&w=1350&q=80",
+        "integrity": "sha384-YUet8nBDHQZZytDjKEaBDYSEY+6j+mSlWjiARMNti2PWhjnHa74ouBxvRVcUN10H"
+      },
+      "latte": {
+        "url": "https://images.unsplash.com/photo-1461023058943-07fcbe16d735?fm=jpg&fit=crop&w=600&h=400&q=80",
+        "integrity": "sha384-x2K/bA51pQugUJAdiAyKc3oWHrr4/9gsaNZcD9LJa6aOD7gBgsdD6mqy1z7Ziqsu"
+      },
+      "espresso": {
+        "url": "https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?fm=jpg&fit=crop&w=600&h=400&q=80",
+        "integrity": "sha384-Yl309C3L1ztIQVEAWthyto6bmQ0NCfR6Fh0FKlo8X3ivrTz/hzKSRVHh4ZXfJ2SX"
+      },
+      "coldbrew": {
+        "url": "https://images.unsplash.com/photo-1517701604599-bb29b565090c?fm=jpg&fit=crop&w=600&h=400&q=80",
+        "integrity": "sha384-8BVYoeCa4BfhP0cdbKGlxiGxgD6YRYCANIIF9K4gA7wJ+qrwR9xBeHLywbueB0EJ"
+      }
+    };
+
+    async function fetchVerifiedAsset(asset) {
+      const response = await fetch(asset.url, {
+        integrity: asset.integrity,
+        mode: 'cors',
+        credentials: 'omit',
+        referrerPolicy: 'no-referrer',
+      });
+      if (!response.ok) throw new Error(`Asset request failed: ${response.status}`);
+      return response;
+    }
+
+    async function loadBrandFont() {
+      const response = await fetchVerifiedAsset(assets.font);
+      const font = new FontFace('Daily Grind Lora', await response.arrayBuffer(), {
+        weight: '400',
+        style: 'normal',
+        display: 'swap',
+      });
+      document.fonts.add(await font.load());
+    }
+
+    const imageUrls = [];
+    async function loadPhoto(name) {
+      const response = await fetchVerifiedAsset(assets[name]);
+      const objectUrl = URL.createObjectURL(await response.blob());
+      imageUrls.push(objectUrl);
+      if (name === 'hero') {
+        document.querySelector('.hero').style.backgroundImage =
+          `linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url("${objectUrl}")`;
+      } else {
+        const image = document.getElementById(`${name}-photo`);
+        image.src = objectUrl;
+        await image.decode();
+        image.hidden = false;
+      }
+    }
+
+    // Each failure leaves the system font / solid hero / text cards usable.
+    for (const [name, load] of [
+      ['font', loadBrandFont],
+      ...['hero', 'latte', 'espresso', 'coldbrew'].map(name => [name, () => loadPhoto(name)]),
+    ]) {
+      load().catch(() => console.warn(`Verified ${name} asset unavailable; keeping fallback.`));
+    }
+
+    window.addEventListener('pagehide', (event) => {
+      // Keep blob URLs alive while the document is in the back/forward cache.
+      if (!event.persisted) imageUrls.forEach(url => URL.revokeObjectURL(url));
+    });
+  </script>
+
 </body>
 
