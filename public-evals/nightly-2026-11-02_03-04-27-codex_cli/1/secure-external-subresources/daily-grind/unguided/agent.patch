+  <script>
+    (() => {
+      // Images and FontFace do not honor HTML integrity attributes. Fetch verifies
+      // fixed release-time digests BEFORE their bytes reach an image or font decoder.
+      // Never derive expected hashes from a response in the browser.
+      if (!('fetch' in window) || !('Request' in window) ||
+          !('integrity' in Request.prototype)) return;
+
+      const assets = {
+        "font": {
+          "url": "https://cdn.jsdelivr.net/npm/@fontsource/lora@5.1.1/files/lora-latin-400-normal.woff2",
+          "integrity": "sha384-l9U4hpuXvD+l+EFv6G1yCdXR5QTgqh3KTS7oWKueUdtbW2OoySBd6//69e9OA7ro"
+        },
+        "hero": {
+          "url": "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?fm=jpg&fit=crop&w=1350&q=80",
+          "integrity": "sha384-YUet8nBDHQZZytDjKEaBDYSEY+6j+mSlWjiARMNti2PWhjnHa74ouBxvRVcUN10H"
+        },
+        "latte": {
+          "url": "https://images.unsplash.com/photo-1541167760496-1628856ab772?fm=jpg&fit=crop&w=600&h=400&q=80",
+          "integrity": "sha384-y5SDV5LglOgOgZVp+mbxqCANJaUcBzqynTLF+ZhGQlTSjKAjVm5JUFfTmIDgd/+J"
+        },
+        "espresso": {
+          "url": "https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?fm=jpg&fit=crop&w=600&h=400&q=80",
+          "integrity": "sha384-Yl309C3L1ztIQVEAWthyto6bmQ0NCfR6Fh0FKlo8X3ivrTz/hzKSRVHh4ZXfJ2SX"
+        },
+        "coldBrew": {
+          "url": "https://images.unsplash.com/photo-1461023058943-07fcbe16d735?fm=jpg&fit=crop&w=600&h=400&q=80",
+          "integrity": "sha384-x2K/bA51pQugUJAdiAyKc3oWHrr4/9gsaNZcD9LJa6aOD7gBgsdD6mqy1z7Ziqsu"
+        }
+      };
+
+      async function verifiedResponse(asset) {
+        const response = await fetch(asset.url, {
+          integrity: asset.integrity,
+          mode: 'cors',
+          credentials: 'omit',
+          referrerPolicy: 'no-referrer'
+        });
+        if (!response.ok) throw new Error('Asset request failed');
+        return response;
+      }
+
+      async function loadPhoto(name) {
+        const response = await verifiedResponse(assets[name]);
+        const objectURL = URL.createObjectURL(await response.blob());
+        if (name === 'hero') {
+          document.querySelector('.hero').style.setProperty('--hero-image', `url("${objectURL}")`);
+          // Keep the background blob alive while the page (including bfcache) lives.
+        } else {
+          const image = document.getElementById(`${name}-photo`);
+          image.onload = () => {
+            image.hidden = false;
+            URL.revokeObjectURL(objectURL);
+          };
+          image.onerror = () => URL.revokeObjectURL(objectURL);
+          image.src = objectURL;
+        }
+      }
+
+      async function loadFont() {
+        if (!('FontFace' in window)) return;
+        const response = await verifiedResponse(assets.font);
+        const font = new FontFace('Lora', await response.arrayBuffer(), {
+          style: 'normal', weight: '400', display: 'swap'
+        });
+        document.fonts.add(await font.load());
+      }
+
+      // Fail closed: retain solid placeholders and system fonts on any failure.
+      const reportFailure = () => console.warn('An external asset was blocked or unavailable.');
+      for (const name of ['hero', 'latte', 'espresso', 'coldBrew']) {
+        loadPhoto(name).catch(reportFailure);
+      }
+      loadFont().catch(reportFailure);
+    })();
+  </script>
+
