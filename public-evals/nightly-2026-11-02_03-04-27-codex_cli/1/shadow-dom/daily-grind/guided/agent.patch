@@ -0,0 +1,103 @@
+const drinkCardTemplate = document.createElement('template');
+drinkCardTemplate.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      min-width: 0;
+    }
+
+    *, *::before, *::after {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    article {
+      height: 100%;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      font: 16px/1.6 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      color: #3e2723;
+    }
+
+    h3 {
+      margin-bottom: 10px;
+      color: #4e342e;
+    }
+
+    .badge {
+      display: inline-block;
+      margin-bottom: 10px;
+      padding: 2px 8px;
+      border-radius: 4px;
+      background: #ffab40;
+      color: #3e2723;
+      font-size: 0.75em;
+      font-weight: bold;
+    }
+
+    .badge[hidden] {
+      display: none;
+    }
+
+    a {
+      display: inline-block;
+      background: #4e342e;
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    a:hover {
+      background: #3e2723;
+    }
+  </style>
+  <article>
+    <span class="badge" hidden>Limited</span>
+    <h3></h3>
+    <p></p>
+    <a></a>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = [
+    'drink-title', 'description', 'href', 'action-label', 'limited',
+  ];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' })
+      .append(drinkCardTemplate.content.cloneNode(true));
+  }
+
+  connectedCallback() {
+    this.render();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.render();
+  }
+
+  render() {
+    // Read page data as text, keeping consumer content out of innerHTML.
+    this.shadowRoot.querySelector('h3').textContent = this.getAttribute('drink-title') ?? '';
+    this.shadowRoot.querySelector('p').textContent = this.getAttribute('description') ?? '';
+    const action = this.shadowRoot.querySelector('a');
+    action.textContent = this.getAttribute('action-label') ?? 'View Details';
+    if (this.hasAttribute('href')) {
+      action.setAttribute('href', this.getAttribute('href'));
+    } else {
+      action.removeAttribute('href');
+    }
+    this.shadowRoot.querySelector('.badge').hidden = !this.hasAttribute('limited');
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
