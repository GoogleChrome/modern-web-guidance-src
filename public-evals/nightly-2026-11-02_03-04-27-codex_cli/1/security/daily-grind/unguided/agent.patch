+const { createSecurityHeaders } = require('./security');
+
+// Separated from the listening entrypoint so tests never open a socket.
+function createHandler(html, options) {
+  const securityHeaders = createSecurityHeaders(html, options);
+  return (req, res) => {
+    const send = (status, body, headers = {}) => {
+      res.writeHead(status, {
+        ...securityHeaders,
+        'Content-Type': 'text/plain; charset=utf-8',
+        ...headers,
+      });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    };
+
+    let pathname;
+    try {
+      // Request Host is untrusted and is unnecessary for routing.
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      send(400, 'Bad request');
+      return;
+    }
+
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      send(405, 'Method not allowed', { Allow: 'GET, HEAD' });
+      return;
+    }
+
+    if (pathname === '/logout' || pathname === '/logout/') {
+      send(200, 'Logged out');
+      return;
+    }
+
+    send(200, html, { 'Content-Type': 'text/html; charset=utf-8' });
+  };
+}
+
+module.exports = { createHandler };
