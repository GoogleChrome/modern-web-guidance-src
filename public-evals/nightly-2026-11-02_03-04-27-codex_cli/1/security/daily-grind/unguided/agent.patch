new file mode 100644
index 0000000..ad5d24d
--- /dev/null
+++ b/security.test.js
@@ -0,0 +1,84 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { createHash } = require('node:crypto');
+const { createSecurityHeaders } = require('./security');
+const { createHandler } = require('./handler');
+
+const html = readFileSync(`${__dirname}/index.html`, 'utf8');
+
+function request(handler, url = '/', method = 'GET') {
+  const response = {};
+  handler({ url, method, headers: { host: '[invalid-host' } }, {
+    writeHead(status, headers) { Object.assign(response, { status, headers }); },
+    end(body) { response.body = body; },
+  });
+  return response;
+}
+
+test('enforced policy blocks injection and permits only the actual stylesheet and image host', () => {
+  const headers = createSecurityHeaders(html);
+  const policy = headers['Content-Security-Policy'];
+  const directives = new Map(policy.split('; ').map(value => {
+    const [name, ...sources] = value.split(' ');
+    return [name, sources.join(' ')];
+  }));
+  for (const name of ['default-src', 'script-src', 'style-src-attr', 'connect-src',
+    'object-src', 'base-uri', 'form-action', 'frame-ancestors', 'trusted-types']) {
+    assert.equal(directives.get(name), "'none'", name);
+  }
+  assert.equal(directives.get('require-trusted-types-for'), "'script'");
+  assert.equal(directives.get('img-src'), 'https://images.unsplash.com');
+  const styles = [...html.matchAll(/<style>([\s\S]*?)<\/style>/g)];
+  assert.equal(styles.length, 1);
+  const hash = createHash('sha256').update(styles[0][1]).digest('base64');
+  assert.equal(directives.get('style-src'), `'sha256-${hash}'`);
+  assert.doesNotMatch(policy, /unsafe-inline|unsafe-eval|\*/);
+  assert.equal(headers['Content-Security-Policy-Report-Only'], undefined);
+  assert.notEqual(createSecurityHeaders(html.replace('--primary:', '--updated:'))['Content-Security-Policy'], policy);
+});
+
+test('markup stays compatible with the restrictive policy', () => {
+  assert.doesNotMatch(html, /<script\b|\son\w+\s*=|\sstyle\s*=|javascript\s*:|<base\b|<iframe\b|<object\b|<form\b/i);
+  const remoteUrls = [...html.matchAll(/https?:\/\/[^\s'"<>]+/g)];
+  assert.ok(remoteUrls.length > 0);
+  for (const [url] of remoteUrls) assert.equal(new URL(url).origin, 'https://images.unsplash.com');
+});
+
+test('report-only rollout is explicit and invalid modes fail closed', () => {
+  const headers = createSecurityHeaders(html, { cspMode: 'report-only' });
+  assert.equal(headers['Content-Security-Policy'], undefined);
+  assert.equal(headers['Content-Security-Policy-Report-Only'], createSecurityHeaders(html)['Content-Security-Policy']);
+  assert.equal(headers['X-Frame-Options'], 'DENY');
+  assert.throws(() => createSecurityHeaders(html, { cspMode: 'disabled' }), /CSP_MODE/);
+});
+
+test('HSTS requires explicit HTTPS deployment configuration', () => {
+  assert.equal(createSecurityHeaders(html)['Strict-Transport-Security'], undefined);
+  assert.equal(createSecurityHeaders(html, { hsts: true })['Strict-Transport-Security'], 'max-age=31536000');
+});
+
+test('security headers cover pages, logout, HEAD, bad URLs and unsupported methods', () => {
+  const handler = createHandler(html);
+  for (const [url, method, status] of [
+    ['/', 'GET', 200], ['/menu', 'GET', 200], ['/logout', 'GET', 200],
+    ['/logout/', 'GET', 200], ['/', 'HEAD', 200],
+    ['http://[invalid', 'GET', 400], ['/', 'POST', 405],
+  ]) {
+    const response = request(handler, url, method);
+    assert.equal(response.status, status);
+    for (const [name, value] of Object.entries(createSecurityHeaders(html))) {
+      assert.equal(response.headers[name], value, `${method} ${url}: ${name}`);
+    }
+    assert.equal(response.headers['X-Content-Type-Options'], 'nosniff');
+    assert.equal(response.headers['Referrer-Policy'], 'no-referrer');
+    assert.equal(response.headers['Cross-Origin-Opener-Policy'], 'same-origin');
+    assert.equal(response.headers['Cross-Origin-Resource-Policy'], 'same-origin');
+    assert.match(response.headers['Permissions-Policy'], /camera=\(\), microphone=\(\)/);
+    if (method === 'HEAD') assert.equal(response.body, undefined);
+    if (status === 405) assert.equal(response.headers.Allow, 'GET, HEAD');
+  }
+  assert.equal(request(handler).body, html);
+  assert.equal(request(handler).headers['Content-Type'], 'text/html; charset=utf-8');
+  assert.equal(request(handler, '/logout').body, 'Logged out');
+});
