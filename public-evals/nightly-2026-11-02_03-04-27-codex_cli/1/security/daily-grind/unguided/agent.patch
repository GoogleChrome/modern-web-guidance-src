+const { createHash } = require('node:crypto');
+
+function createSecurityHeaders(html, { cspMode = 'enforce', hsts = false } = {}) {
+  if (!['enforce', 'report-only'].includes(cspMode)) {
+    throw new Error('CSP_MODE must be enforce or report-only');
+  }
+
+  // Hash the exact bytes served, including whitespace. No unsafe-inline fallback.
+  const styles = [...html.matchAll(/<style>([\s\S]*?)<\/style>/g)];
+  const hashes = styles.map(([, css]) =>
+    `'sha256-${createHash('sha256').update(css).digest('base64')}'`);
+  const policy = [
+    "default-src 'none'",
+    "script-src 'none'",
+    `style-src ${hashes.length ? hashes.join(' ') : "'none'"}`,
+    "style-src-attr 'none'",
+    'img-src https://images.unsplash.com',
+    "connect-src 'none'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "form-action 'none'",
+    "frame-ancestors 'none'",
+    "require-trusted-types-for 'script'",
+    "trusted-types 'none'",
+  ].join('; ');
+
+  const headers = {
+    [cspMode === 'enforce' ? 'Content-Security-Policy' : 'Content-Security-Policy-Report-Only']: policy,
+    'X-Content-Type-Options': 'nosniff',
+    'X-Frame-Options': 'DENY',
+    'Referrer-Policy': 'no-referrer',
+    'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=()',
+    'Cross-Origin-Opener-Policy': 'same-origin',
+    'Cross-Origin-Resource-Policy': 'same-origin',
+    // Avoid serving stale policy/document pairs during rollout or rollback.
+    'Cache-Control': 'no-store',
+  };
+  // Enable only behind an HTTPS-only deployment; never trust forwarded headers.
+  if (hsts) headers['Strict-Transport-Security'] = 'max-age=31536000';
+  return headers;
+}
+
+module.exports = { createSecurityHeaders };
