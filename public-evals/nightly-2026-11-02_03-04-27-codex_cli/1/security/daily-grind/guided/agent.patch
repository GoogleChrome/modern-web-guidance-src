+test('report-only mode retains baseline protections; invalid config fails closed', async () => {
+  const res = await request(createHandler({ cspMode: 'report-only' }));
+  assert.match(res.headers['Content-Security-Policy-Report-Only'], /script-src 'none'/);
+  assert.match(res.headers['Content-Security-Policy'], /frame-ancestors 'none'/);
+  assert.doesNotMatch(res.headers['Content-Security-Policy'], /script-src/);
+  assert.throws(() => createHandler({ cspMode: 'off' }));
+  assert.throws(() => createHandler({ publicOrigin: 'https://coffee.example/path' }));
+});
+
+test('logout rejects GET, cross-origin and missing Origin, clearing data only on valid POST', async () => {
+  const handler = createHandler({ publicOrigin: origin });
+  for (const url of ['/logout', '/logout/']) {
+    const get = await request(handler, { url });
+    assert.equal(get.status, 405);
+    assert.equal(get.headers['Clear-Site-Data'], undefined);
+    for (const headers of [{}, { origin: 'https://evil.example' },
+      { origin, 'sec-fetch-site': 'same-site' }]) {
+      assert.equal((await request(handler, { url, method: 'POST', headers })).status, 403);
+    }
+    const post = await request(handler, { url, method: 'POST', headers: { origin, 'sec-fetch-site': 'same-origin' } });
+    assert.equal(post.status, 200);
+    assert.equal(post.headers['Clear-Site-Data'], '"cookies", "storage", "cache"');
+  }
+});
+
+test('fetch metadata blocks cross-site resources while preserving incoming navigations', async () => {
+  const handler = createHandler();
+  const blocked = await request(handler, { headers: { 'sec-fetch-site': 'cross-site' } });
+  assert.equal(blocked.status, 403);
+  assert.equal(blocked.headers['X-Content-Type-Options'], 'nosniff');
+  assert.match(blocked.headers.Vary, /Sec-Fetch-Site/);
+  const nav = await request(handler, { headers: { 'sec-fetch-site': 'cross-site',
+    'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'document' } });
+  assert.equal(nav.status, 200);
+});
