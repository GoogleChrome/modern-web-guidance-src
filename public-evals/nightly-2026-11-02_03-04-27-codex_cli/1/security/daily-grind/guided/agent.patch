+test('both report formats log only allowlisted fields, never supplied secrets', async () => {
+  const reports = [];
+  const handler = createHandler({ onReport: (report) => reports.push(report) });
+  const body = { 'effective-directive': 'script-src-elem', disposition: 'report',
+    'document-uri': 'https://coffee.example/?secret=token', 'script-sample': 'private' };
+  assert.equal((await request(handler, { url: '/security-reports', method: 'POST',
+    headers: { 'content-type': 'application/csp-report' }, body: JSON.stringify({ 'csp-report': body }) })).status, 204);
+  assert.equal((await request(handler, { url: '/security-reports', method: 'POST',
+    headers: { 'content-type': 'application/reports+json' }, body: JSON.stringify([
+      { type: 'csp-violation', body: { effectiveDirective: 'trusted-types', disposition: 'enforce', sourceFile: 'secret' } },
+      { type: 'deprecation', body: { effectiveDirective: 'script-src' } }, null,
+    ]) })).status, 204);
+  assert.deepEqual(reports, [{ directive: 'script-src-elem', disposition: 'report' },
+    { directive: 'trusted-types', disposition: 'enforce' }]);
+});
