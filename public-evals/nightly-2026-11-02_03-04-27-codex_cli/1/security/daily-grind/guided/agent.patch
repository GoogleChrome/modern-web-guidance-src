@@ -0,0 +1,156 @@
+const fs = require('node:fs/promises');
+const path = require('node:path');
+
+const REPORT_PATH = '/security-reports';
+const MAX_REPORT_BYTES = 16 * 1024;
+const DIRECTIVES = new Set([
+  'default-src', 'script-src', 'script-src-elem', 'script-src-attr',
+  'style-src', 'style-src-elem', 'style-src-attr', 'img-src', 'font-src',
+  'connect-src', 'object-src', 'base-uri', 'frame-src', 'frame-ancestors',
+  'form-action', 'worker-src', 'manifest-src', 'media-src',
+  'require-trusted-types-for', 'trusted-types',
+]);
+
+function createHandler({ publicOrigin = 'http://localhost:11222', cspMode = 'enforce',
+  onReport = (report) => console.info('security-report', JSON.stringify(report)) } = {}) {
+  const originUrl = new URL(publicOrigin);
+  if (!['https:', 'http:'].includes(originUrl.protocol) || originUrl.origin !== publicOrigin) {
+    throw new Error('PUBLIC_ORIGIN must be an HTTP(S) origin without a path or trailing slash');
+  }
+  if (!['enforce', 'report-only'].includes(cspMode)) {
+    throw new Error('CSP_MODE must be enforce or report-only');
+  }
+  const policy = [
+    "default-src 'none'",
+    // The site needs no JavaScript, so authorize no script sources or policies.
+    "script-src 'none'", "script-src-attr 'none'",
+    "style-src 'self'", "style-src-attr 'none'",
+    'img-src https://images.unsplash.com',
+    "object-src 'none'", "base-uri 'none'", "frame-ancestors 'none'",
+    "form-action 'self'", "require-trusted-types-for 'script'", "trusted-types 'none'",
+    `report-uri ${REPORT_PATH}`, 'report-to security',
+  ].join('; ');
+  // Bound logging globally per process without retaining IPs or raw payloads.
+  let windowStart = Date.now();
+  let reportCount = 0;
+
+  return async function handle(req, res) {
+    const headers = {
+      'X-Content-Type-Options': 'nosniff',
+      'X-Frame-Options': 'DENY',
+      'Referrer-Policy': 'strict-origin-when-cross-origin',
+      'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=(), focus-without-user-activation=()',
+      'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+      'Cross-Origin-Resource-Policy': 'same-origin',
+      'Cache-Control': 'no-store',
+      'Vary': 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site',
+      'Content-Security-Policy': cspMode === 'enforce' ? policy
+        : "object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'",
+    };
+    if (cspMode === 'report-only') headers['Content-Security-Policy-Report-Only'] = policy;
+    if (originUrl.protocol === 'https:') {
+      headers['Reporting-Endpoints'] = `security="${publicOrigin}${REPORT_PATH}"`;
+      // Start small; the TLS edge must redirect HTTP to HTTPS.
+      headers['Strict-Transport-Security'] = 'max-age=300';
+    }
+    for (const [name, value] of Object.entries(headers)) res.setHeader(name, value);
+    const send = (status, body = '', type = 'text/plain; charset=utf-8') => {
+      res.writeHead(status, { 'Content-Type': type });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    };
+
+    try {
+      // Do not trust Host or forwarded headers for policy URLs or origin checks.
+      const pathname = new URL(req.url, publicOrigin).pathname;
+      const site = req.headers['sec-fetch-site'];
+      const navigation = ['GET', 'HEAD'].includes(req.method)
+        && req.headers['sec-fetch-mode'] === 'navigate'
+        && req.headers['sec-fetch-dest'] === 'document';
+      if (site && !['same-origin', 'none'].includes(site) && !navigation) {
+        send(403, 'Forbidden');
+        return;
+      }
+
+      if (pathname === REPORT_PATH) {
+        if (req.method !== 'POST') {
+          res.setHeader('Allow', 'POST');
+          send(405, 'Method not allowed');
+          return;
+        }
+        if (!['application/csp-report', 'application/reports+json'].includes(
+          (req.headers['content-type'] || '').split(';')[0].trim())) {
+          send(415, 'Unsupported report type');
+          return;
+        }
+        if (Date.now() - windowStart >= 60_000) {
+          windowStart = Date.now();
+          reportCount = 0;
+        }
+        if (++reportCount > 100) {
+          send(429, 'Too many reports');
+          return;
+        }
+        let bytes = 0;
+        const chunks = [];
+        for await (const chunk of req) {
+          bytes += chunk.length;
+          if (bytes > MAX_REPORT_BYTES) {
+            send(413, 'Report too large');
+            return;
+          }
+          chunks.push(chunk);
+        }
+        let payload;
+        try {
+          payload = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+        } catch {
+          send(400, 'Invalid report');
+          return;
+        }
+        const reports = Array.isArray(payload) ? payload : [payload];
+        if (reports.length > 20) {
+          send(413, 'Too many batched reports');
+          return;
+        }
+        for (const report of reports) {
+          const body = report?.['csp-report']
+            || (report?.type === 'csp-violation' ? report.body : null);
+          const directive = body?.['effective-directive'] || body?.effectiveDirective;
+          if (!DIRECTIVES.has(directive)) continue;
+          // Drop URLs, samples, cookies, IPs, referrers, and arbitrary strings.
+          onReport({ directive, disposition: body.disposition === 'report' ? 'report' : 'enforce' });
+        }
+        send(204);
+        return;
+      }
+
+      if (pathname === '/logout' || pathname === '/logout/') {
+        if (req.method !== 'POST') {
+          res.setHeader('Allow', 'POST');
+          send(405, 'Use the Logout button to sign out.');
+          return;
+        }
+        if (req.headers.origin !== publicOrigin || (site && site !== 'same-origin')) {
+          send(403, 'Forbidden');
+          return;
+        }
+        res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+        send(200, 'Logged out');
+        return;
+      }
+
+      if (!['GET', 'HEAD'].includes(req.method)) {
+        res.setHeader('Allow', 'GET, HEAD');
+        send(405, 'Method not allowed');
+        return;
+      }
+      const stylesheet = pathname === '/styles.css';
+      const data = await fs.readFile(path.join(__dirname, stylesheet ? 'styles.css' : 'index.html'));
+      send(200, data, stylesheet ? 'text/css; charset=utf-8' : 'text/html; charset=utf-8');
+    } catch {
+      send(500, 'Server error');
+    }
+  };
+}
+
+module.exports = { createHandler };
