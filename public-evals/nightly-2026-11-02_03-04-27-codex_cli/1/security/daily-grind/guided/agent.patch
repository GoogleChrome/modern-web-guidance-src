--- /dev/null
+++ b/test/security.test.js
@@ -0,0 +1,125 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { Readable } = require('node:stream');
+const { readFile } = require('node:fs/promises');
+// This module exports a handler only; it never imports server.js or opens sockets.
+const { createHandler } = require('../app');
+
+const origin = 'https://coffee.example';
+async function request(handler, { url = '/', method = 'GET', headers = {}, body = '' } = {}) {
+  const req = Readable.from([Buffer.from(body)]);
+  Object.assign(req, { url, method, headers });
+  const response = { headers: {}, setHeader(name, value) { this.headers[name] = value; },
+    writeHead(status, headers) { this.status = status; Object.assign(this.headers, headers); },
+    end(body) { this.body = body?.toString() || ''; } };
+  await handler(req, response);
+  return response;
+}
+
+test('markup and CSS remain compatible with a no-script, no-inline policy', async () => {
+  const html = await readFile('index.html', 'utf8');
+  assert.doesNotMatch(html, /<script\b|<style\b|\sstyle\s*=|\son\w+\s*=|javascript:/i);
+  assert.match(html, /<link rel="stylesheet" href="\/styles.css">/);
+  assert.match(html, /<form method="post" action="\/logout">/);
+  const res = await request(createHandler({ publicOrigin: origin }));
+  assert.equal(res.status, 200);
+  const csp = res.headers['Content-Security-Policy'];
+  for (const directive of ["default-src 'none'", "script-src 'none'", "style-src 'self'",
+    "trusted-types 'none'", "require-trusted-types-for 'script'", "frame-ancestors 'none'",
+    'img-src https://images.unsplash.com', 'report-uri /security-reports', 'report-to security']) {
+    assert.ok(csp.includes(directive), directive);
+  }
+  assert.equal(res.headers['Reporting-Endpoints'], 'security="https://coffee.example/security-reports"');
+  assert.equal(res.headers['Strict-Transport-Security'], 'max-age=300');
+  assert.equal(res.headers['X-Content-Type-Options'], 'nosniff');
+  assert.equal(res.headers['X-Frame-Options'], 'DENY');
+  assert.equal(res.headers['Cross-Origin-Opener-Policy'], 'same-origin-allow-popups');
+  assert.equal(res.headers['Cross-Origin-Resource-Policy'], 'same-origin');
+  assert.equal(res.headers['Referrer-Policy'], 'strict-origin-when-cross-origin');
+  assert.match(res.headers['Permissions-Policy'], /camera=\(\)/);
+});
