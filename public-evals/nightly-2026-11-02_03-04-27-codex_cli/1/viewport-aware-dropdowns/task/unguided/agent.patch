+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+
+    function positionPanel() {
+      if (!panel.matches(':popover-open')) return;
+
+      const anchor = trigger.getBoundingClientRect();
+      const viewport = window.visualViewport;
+      const edge = 8;
+      const leftEdge = (viewport?.offsetLeft ?? 0) + edge;
+      const topEdge = (viewport?.offsetTop ?? 0) + edge;
+      const rightEdge = (viewport?.offsetLeft ?? 0)
+        + (viewport?.width ?? document.documentElement.clientWidth) - edge;
+      const bottomEdge = (viewport?.offsetTop ?? 0)
+        + (viewport?.height ?? document.documentElement.clientHeight) - edge;
+
+      // Measure the natural height before choosing a side, then scroll if neither fits.
+      panel.style.maxWidth = `${Math.max(0, rightEdge - leftEdge)}px`;
+      panel.style.maxHeight = `${Math.max(0, bottomEdge - topEdge)}px`;
+      const size = panel.getBoundingClientRect();
+      const below = Math.max(0, bottomEdge - anchor.bottom);
+      const above = Math.max(0, anchor.top - topEdge);
+      const flipUp = size.height > below && above > below;
+      panel.style.maxHeight = `${flipUp ? above : below}px`;
+      const height = panel.getBoundingClientRect().height;
+
+      // Prefer left-edge alignment; flip to right-edge alignment on collision.
+      const preferredLeft = anchor.left + size.width > rightEdge
+        ? anchor.right - size.width : anchor.left;
+      panel.style.left = `${Math.max(leftEdge, Math.min(preferredLeft, rightEdge - size.width))}px`;
+      const preferredTop = flipUp ? anchor.top - height : anchor.bottom;
+      panel.style.top = `${Math.max(topEdge, Math.min(preferredTop, bottomEdge - height))}px`;
+    }
+
+    panel.addEventListener('beforetoggle', (event) => {
+      trigger.setAttribute('aria-expanded', String(event.newState === 'open'));
+      if (event.newState === 'open') requestAnimationFrame(positionPanel);
+    });
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (action) {
+        panel.hidePopover();
+        window.location.assign(action.dataset.href);
+      }
+    });
+    window.addEventListener('resize', positionPanel);
+    document.addEventListener('scroll', positionPanel, true);
+    window.visualViewport?.addEventListener('resize', positionPanel);
+    window.visualViewport?.addEventListener('scroll', positionPanel);
+    new ResizeObserver(positionPanel).observe(trigger);
+  </script>
