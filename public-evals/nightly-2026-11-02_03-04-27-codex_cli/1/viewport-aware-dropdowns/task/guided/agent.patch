+  <script type="module">
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@0.6.1/dist/popover.min.js");
+    }
+
+    const trigger = document.getElementById("trigger-btn");
+    const panel = document.getElementById("action-panel");
+
+    panel.addEventListener("click", (event) => {
+      const action = event.target.closest("button[data-href]");
+      if (action) window.location.assign(action.dataset.href);
+    });
+
+    if (!CSS.supports("position-area", "block-end span-inline-end") ||
+        !CSS.supports("position-try-fallbacks", "flip-block, flip-inline, flip-block flip-inline")) {
+      let open = false;
+      const positionPanel = () => {
+        if (!open) return;
+        const viewport = window.visualViewport;
+        const leftEdge = (viewport?.offsetLeft ?? 0) + 8;
+        const topEdge = (viewport?.offsetTop ?? 0) + 8;
+        const rightEdge = leftEdge + (viewport?.width ?? document.documentElement.clientWidth) - 16;
+        const bottomEdge = topEdge + (viewport?.height ?? window.innerHeight) - 16;
+        const anchor = trigger.getBoundingClientRect();
+        panel.style.maxWidth = `${Math.max(0, rightEdge - leftEdge)}px`;
+        panel.style.maxHeight = `${Math.max(0, bottomEdge - topEdge)}px`;
+        const { width, height } = panel.getBoundingClientRect();
+        const left = anchor.left + width <= rightEdge ? anchor.left : anchor.right - width;
+        const top = anchor.bottom + height <= bottomEdge ? anchor.bottom : anchor.top - height;
+        panel.style.left = `${Math.max(leftEdge, Math.min(left, rightEdge - width))}px`;
+        panel.style.top = `${Math.max(topEdge, Math.min(top, bottomEdge - height))}px`;
+      };
+      // Disable partially supported CSS positioning before applying coordinates.
+      panel.style.setProperty("position-area", "none");
+      panel.style.setProperty("position-anchor", "auto");
+      panel.style.setProperty("position-try-fallbacks", "none");
+      panel.addEventListener("beforetoggle", (event) => {
+        open = event.newState === "open";
+        if (open) requestAnimationFrame(positionPanel);
+      });
+      window.addEventListener("resize", positionPanel);
+      document.addEventListener("scroll", positionPanel, true);
+      window.visualViewport?.addEventListener("resize", positionPanel);
+      window.visualViewport?.addEventListener("scroll", positionPanel);
+      const observer = new ResizeObserver(positionPanel);
+      observer.observe(trigger);
+      observer.observe(panel);
+    }
+  </script>
