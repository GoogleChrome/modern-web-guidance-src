+<script>
+    (() => {
+      const canvas = document.getElementById('gift-canvas');
+      const card = document.getElementById('export_element');
+      const stage = document.getElementById('gift-stage');
+      const nameInput = document.getElementById('gift-name');
+      const messageInput = document.getElementById('gift-message');
+      const button = document.getElementById('download-card');
+      const status = document.getElementById('export-status');
+      const context = canvas.getContext('2d');
+      let nativeRendering = Boolean(
+        context && 'content' in HTMLCanvasElement.prototype &&
+        typeof context.drawElementImage === 'function' &&
+        typeof canvas.requestPaint === 'function' &&
+        typeof ResizeObserver === 'function'
+      );
+      let paintWaiter = null;
+      let fallbackLoader;
+      let resizeObserver;
+
+      function useFallback() {
+        nativeRendering = false;
+        resizeObserver?.disconnect();
+        stage.append(card);
+        canvas.hidden = true;
+      }
+
+      // Native snapshots only exist after a paint event; never export on a timer alone.
+      canvas.onpaint = () => {
+        if (!nativeRendering) return;
+        try {
+          context.reset();
+          context.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+          paintWaiter?.resolve();
+        } catch (error) {
+          paintWaiter?.reject(error);
+          useFallback();
+        }
+      };
+
+      if (nativeRendering) {
+        canvas.append(card);
+        canvas.hidden = false;
+        resizeObserver = new ResizeObserver(([entry]) => {
+          const pixels = entry.devicePixelContentBoxSize?.[0];
+          canvas.width = pixels ? pixels.inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+          canvas.height = pixels ? pixels.blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+          canvas.requestPaint();
+        });
+        const supportsDevicePixelBox = typeof ResizeObserverEntry !== 'undefined' &&
+          'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+        resizeObserver.observe(canvas, supportsDevicePixelBox ? { box: 'device-pixel-content-box' } : {});
+      }
+
+      function updateCard() {
+        document.getElementById('card-recipient').textContent = nameInput.value.trim()
+          ? `For ${nameInput.value.trim()}` : 'For someone special';
+        document.getElementById('card-message').textContent = messageInput.value;
+        card.style.backgroundColor = document.querySelector('input[name="gift-color"]:checked').value;
+        if (nativeRendering) canvas.requestPaint();
+      }
+      nameInput.addEventListener('input', updateCard);
+      messageInput.addEventListener('input', updateCard);
+      document.querySelectorAll('input[name="gift-color"]').forEach(input => {
+        input.addEventListener('change', updateCard);
+      });
+
+      async function paintLatestCard() {
+        await new Promise((resolve, reject) => {
+          const timeout = setTimeout(() => reject(new Error('Card paint timed out')), 3000);
+          paintWaiter = {
+            resolve: () => { clearTimeout(timeout); resolve(); },
+            reject: error => { clearTimeout(timeout); reject(error); }
+          };
+          try { canvas.requestPaint(); } catch (error) { paintWaiter.reject(error); }
+        }).finally(() => { paintWaiter = null; });
+        return canvas;
+      }
+
+      function loadFallback() {
+        if (!fallbackLoader) {
+          fallbackLoader = new Promise((resolve, reject) => {
+            const script = document.createElement('script');
+            script.src = 'vendor/html2canvas.min.js';
+            script.onload = resolve;
+            script.onerror = () => {
+              script.remove();
+              fallbackLoader = null;
+              reject(new Error('Unable to load card renderer'));
+            };
+            document.head.append(script);
+          });
+        }
+        return fallbackLoader;
+      }
+
+      async function renderCard() {
+        await document.fonts.ready;
+        if (nativeRendering) {
+          try { return await paintLatestCard(); } catch { useFallback(); }
+        }
+        await loadFallback();
+        // Local, image-free HTML keeps the export origin-clean and available offline.
+        return window.html2canvas(card, {
+          scale: Math.max(2, window.devicePixelRatio || 1),
+          backgroundColor: null,
+          logging: false,
+          onclone: doc => { doc.getElementById('export_element').style.boxShadow = 'none'; }
+        });
+      }
+
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        status.textContent = 'Preparing your card…';
+        const inputs = document.querySelectorAll('.gift-controls input, .gift-controls textarea');
+        inputs.forEach(input => { input.disabled = true; });
+        try {
+          const renderedCanvas = await renderCard();
+          const blob = await new Promise((resolve, reject) => {
+            renderedCanvas.toBlob(result => result ? resolve(result) : reject(new Error('Empty image')), 'image/png');
+          });
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.href = url;
+          link.download = 'daily-grind-gift-card.png';
+          document.body.append(link);
+          link.click();
+          link.remove();
+          setTimeout(() => URL.revokeObjectURL(url), 60000);
+          status.textContent = 'Your card is ready. Download started!';
+        } catch (error) {
+          status.textContent = 'Couldn’t download your card. Please try again.';
+          console.error('Gift card export failed:', error);
+        } finally {
+          button.disabled = false;
+          inputs.forEach(input => { input.disabled = false; });
+        }
+      });
+    })();
+  </script>
 </body>
 
