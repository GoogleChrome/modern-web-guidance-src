+  <script>
+    const menuButton = document.querySelector('.menu-button');
+    const drawer = document.querySelector('.drawer');
+    const closeButton = document.querySelector('.drawer-close');
+    const dismissArea = document.querySelector('.drawer-dismiss');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let revealed = false;
+    let backdropPointerDown = false;
+
+    const closedPosition = () => drawer.scrollWidth - drawer.clientWidth;
+    const scrollBehavior = () => reducedMotion.matches ? 'instant' : 'smooth';
+
+    function syncDrawer() {
+      if (!drawer.open) return;
+      const end = closedPosition();
+      const progress = end > 0 ? Math.max(0, Math.min(1, 1 - drawer.scrollLeft / end)) : 1;
+      drawer.style.setProperty('--backdrop-opacity', progress);
+      if (drawer.scrollLeft < end - 1) revealed = true;
+      // Native scrolling and snapping handle touch, trackpad and momentum.
+      if (revealed && drawer.scrollLeft >= end - 1) drawer.close();
+    }
+
+    function closeDrawer() {
+      if (!drawer.open) return;
+      if (!revealed) {
+        drawer.close();
+        return;
+      }
+      drawer.scrollTo({ left: closedPosition(), behavior: scrollBehavior() });
+      syncDrawer();
+    }
+
+    menuButton.addEventListener('click', () => {
+      if (drawer.open) return;
+      revealed = false;
+      drawer.style.setProperty('--backdrop-opacity', 0);
+      drawer.showModal();
+      menuButton.setAttribute('aria-expanded', 'true');
+      drawer.scrollTo({ left: closedPosition(), behavior: 'instant' });
+      requestAnimationFrame(() => {
+        if (!drawer.open) return;
+        drawer.scrollTo({ left: 0, behavior: scrollBehavior() });
+        syncDrawer();
+      });
+    });
+
+    drawer.addEventListener('scroll', syncDrawer, { passive: true });
+    closeButton.addEventListener('click', closeDrawer);
+    // Require both ends of a tap on the backdrop so a swipe isn't a click.
+    drawer.addEventListener('pointerdown', (event) => {
+      backdropPointerDown = event.target === dismissArea;
+    }, { passive: true });
+    drawer.addEventListener('pointercancel', () => { backdropPointerDown = false; });
+    drawer.addEventListener('click', (event) => {
+      if (backdropPointerDown && event.target === dismissArea) closeDrawer();
+      backdropPointerDown = false;
+    });
+    drawer.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeDrawer();
+    });
+    drawer.addEventListener('close', () => {
+      menuButton.setAttribute('aria-expanded', 'false');
+      menuButton.focus({ preventScroll: true });
+    });
+    drawer.querySelector('nav').addEventListener('click', (event) => {
+      if (event.target.closest('a')) drawer.close();
+    });
+  </script>
