+  <div class="drawer" id="navigation-drawer" popover="manual">
+    <div class="drawer-scroller">
+      <nav class="drawer-sheet" aria-labelledby="drawer-title" tabindex="-1">
+        <div class="drawer-heading">
+          <h2 id="drawer-title">Explore</h2>
+          <button class="drawer-close" type="button">Close menu</button>
+        </div>
+        <ul>
+          <li><a href="/menu">Menu</a></li>
+          <li><a href="/locations">Locations</a></li>
+          <li><a href="/rewards">Rewards</a></li>
+          <li><a href="/account">My Account</a></li>
