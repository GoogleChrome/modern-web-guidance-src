+  <script>
+    const drawer = document.getElementById('navigation-drawer');
+    const openButton = document.getElementById('drawer-open');
+    const page = document.getElementById('page-content');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    const closeButton = drawer.querySelector('.drawer-close');
+    let state = 'closed';
+    let hasBeenVisible = false;
+    let hasFocused = false;
+
+    function finishClosing() {
+      if (state === 'closed') return;
+      state = 'closed';
+      drawer.hidePopover();
+      page.inert = false;
+      openButton.setAttribute('aria-expanded', 'false');
+      openButton.focus();
+    }
+
+    async function openDrawer() {
+      if (state !== 'closed') return;
+      state = 'opening';
+      hasBeenVisible = false;
+      hasFocused = false;
+      drawer.showPopover();
+      page.inert = true;
+      openButton.setAttribute('aria-expanded', 'true');
+
+      // Safari and Firefox need an explicit initial closed scroll stop.
+      if (!CSS.supports('scroll-initial-target', 'nearest')) {
+        scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'instant' });
+        await new Promise(resolve => {
+          requestAnimationFrame(() => requestAnimationFrame(resolve));
+        });
+      }
+
+      if (state === 'opening') {
+        scroller.scrollTo({ left: 0, behavior: 'auto' });
+      }
+    }
+
+    function closeDrawer() {
+      if (state === 'closed') return;
+      state = 'closing';
+      if (scroller.scrollLeft >= sheet.offsetWidth - 1) {
+        finishClosing();
+      } else {
+        scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'auto' });
+      }
+    }
+
+    // Observe actual visibility so a native swipe and button dismissal
+    // share the same cleanup, including keyboard focus restoration.
+    const visibleThreshold = 0.001;
+    new IntersectionObserver(entries => {
+      if (state === 'closed') return;
+      const entry = entries.at(-1);
+      if (entry.intersectionRatio >= visibleThreshold) {
+        hasBeenVisible = true;
+      } else if (hasBeenVisible || state === 'closing') {
+        finishClosing();
+        return;
+      }
+      if (entry.intersectionRatio === 1 && state !== 'closing') {
+        state = 'open';
+        if (!hasFocused) {
+          hasFocused = true;
+          sheet.focus();
+        }
+      }
+    }, { root: scroller, threshold: [visibleThreshold, 1] }).observe(sheet);
+
+    if (!CSS.supports('animation-timeline: scroll()')) {
+      const updateBackdrop = () => {
+        const opacity = 1 - scroller.scrollLeft / sheet.offsetWidth;
+        drawer.style.setProperty('--drawer-backdrop', Math.max(0, Math.min(1, opacity)));
+      };
+      scroller.addEventListener('scroll', updateBackdrop, { passive: true });
+    }
+
+    openButton.addEventListener('click', openDrawer);
+    closeButton.addEventListener('click', closeDrawer);
+    drawer.addEventListener('click', event => {
+      if (!sheet.contains(event.target)) closeDrawer();
+    });
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && state !== 'closed') {
+        event.preventDefault();
+        closeDrawer();
+      }
+    });
+  </script>
