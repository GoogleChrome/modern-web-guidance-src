+  <script>
+    (() => {
+      const panel = document.getElementById('coffee-cart');
+      const handle = document.getElementById('cart-handle');
+      const get = id => document.getElementById(id);
+      const money = value => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value);
+      const drinks = { maple: { name: 'Maple Oat Latte', price: 5.5 }, espresso: { name: 'Dark Roast Espresso', price: 3 }, cold: { name: 'Cold Brew', price: 4.5 } };
+      let quantity = 1, temperature = 'Hot', bag = [], drag = null;
+      const temperatureButtons = [...panel.querySelectorAll('[data-temperature]')];
+      function refresh() {
+        get('cart-quantity').value = quantity;
+        get('cart-minus').disabled = quantity === 1;
+        get('cart-plus').disabled = quantity === 20;
+        get('cart-total').textContent = money((drinks[get('cart-drink').value].price + Number(get('cart-size').value)) * quantity);
+        temperatureButtons.forEach(button => {
+          button.disabled = get('cart-drink').value === 'cold' && button.dataset.temperature === 'Hot';
+          button.setAttribute('aria-pressed', String(button.dataset.temperature === temperature));
+        });
+      }
+      temperatureButtons.forEach(button => button.addEventListener('click', () => { temperature = button.dataset.temperature; refresh(); }));
+      get('cart-minus').addEventListener('click', () => { quantity = Math.max(1, quantity - 1); refresh(); });
+      get('cart-plus').addEventListener('click', () => { quantity = Math.min(20, quantity + 1); refresh(); });
+      get('cart-size').addEventListener('change', refresh);
+      get('cart-drink').addEventListener('change', () => {
+        const value = get('cart-drink').value;
+        temperature = value === 'cold' ? 'Iced' : 'Hot';
+        get('cart-milk').value = value === 'maple' ? 'Oat' : 'No milk';
+        refresh();
+      });
+      function renderBag() {
+        const count = bag.reduce((sum, item) => sum + item.quantity, 0);
+        get('cart-count').textContent = `Your bag · ${count} ${count === 1 ? 'item' : 'items'}`;
+        get('cart-bag-total').textContent = money(bag.reduce((sum, item) => sum + item.total, 0));
+        get('cart-items').replaceChildren(...bag.map(item => {
+          const li = document.createElement('li');
+          li.textContent = `${item.quantity} × ${item.name} — ${item.size}, ${item.temperature.toLowerCase()}, ${item.milk.toLowerCase()} · ${money(item.total)}`;
+          return li;
+        }));
+        get('cart-clear').disabled = !count;
+      }
+      get('cart-add').addEventListener('click', () => {
+        const drink = drinks[get('cart-drink').value];
+        bag.push({ name: drink.name, quantity, temperature, milk: get('cart-milk').value, size: get('cart-size').selectedIndex ? 'Large' : 'Regular', total: (drink.price + Number(get('cart-size').value)) * quantity });
+        renderBag();
+        get('cart-status').textContent = `${quantity} ${drink.name} added to your bag.`;
+      });
+      get('cart-bag').addEventListener('click', () => {
+        const expanded = get('cart-summary').hidden;
+        get('cart-summary').hidden = !expanded;
+        get('cart-bag').setAttribute('aria-expanded', String(expanded));
+      });
+      get('cart-clear').addEventListener('click', () => { bag = []; renderBag(); get('cart-status').textContent = 'Your bag has been cleared.'; });
+      function move(left, top) {
+        panel.style.left = `${Math.max(0, Math.min(left, window.innerWidth - panel.offsetWidth))}px`;
+        panel.style.top = `${Math.max(0, Math.min(top, window.innerHeight - panel.offsetHeight))}px`;
+        panel.style.right = 'auto'; panel.style.bottom = 'auto';
+      }
+      handle.addEventListener('pointerdown', event => {
+        if (event.target.closest('button') || !event.isPrimary || event.button !== 0) return;
+        const rect = panel.getBoundingClientRect();
+        drag = { x: event.clientX - rect.left, y: event.clientY - rect.top };
+        handle.setPointerCapture(event.pointerId);
+      });
+      handle.addEventListener('pointermove', event => { if (drag) move(event.clientX - drag.x, event.clientY - drag.y); });
+      const stopDrag = () => { drag = null; };
+      handle.addEventListener('pointerup', stopDrag);
+      handle.addEventListener('pointercancel', stopDrag);
+      handle.addEventListener('lostpointercapture', stopDrag);
+      handle.addEventListener('keydown', event => {
+        if (event.target !== handle || !['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(event.key)) return;
+        event.preventDefault();
+        const rect = panel.getBoundingClientRect(), step = event.shiftKey ? 40 : 10;
+        move(rect.left + (event.key === 'ArrowRight' ? step : event.key === 'ArrowLeft' ? -step : 0), rect.top + (event.key === 'ArrowDown' ? step : event.key === 'ArrowUp' ? -step : 0));
+      });
+      function constrain() { if (!panel.hidden) { const rect = panel.getBoundingClientRect(); move(rect.left, rect.top); } }
+      window.addEventListener('resize', constrain);
+      new ResizeObserver(constrain).observe(panel);
+      get('cart-close').addEventListener('click', () => { panel.hidden = true; get('cart-launcher').hidden = false; get('cart-launcher').focus(); });
+      function openCart() { panel.hidden = false; get('cart-launcher').hidden = true; constrain(); handle.focus(); }
+      get('cart-launcher').addEventListener('click', openCart);
+      document.querySelector('.hero .btn').addEventListener('click', event => { event.preventDefault(); openCart(); });
+      renderBag(); refresh();
+    })();
+  </script>
