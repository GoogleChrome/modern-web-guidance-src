+  <script>
+    (() => {
+      const panel = document.querySelector('.coffee-cart');
+      const handle = document.querySelector('.cart-handle');
+      const body = document.querySelector('.cart-body');
+      const toggle = document.querySelector('.cart-toggle');
+      const form = document.querySelector('#quick-order');
+      const drink = document.querySelector('#cart-drink');
+      const quantityOutput = document.querySelector('#cart-quantity');
+      const quantityInput = document.querySelector('#cart-quantity-input');
+      const minus = document.querySelector('#cart-minus');
+      const plus = document.querySelector('#cart-plus');
+      const add = document.querySelector('.cart-add');
+      const status = document.querySelector('.cart-status');
+      const checkout = document.querySelector('.cart-checkout');
+      const list = document.querySelector('.cart-items');
+      const money = value => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value / 100);
+      let quantity = 1;
+      let cart = [];
+      let offsetX = 0;
+      let offsetY = 0;
+
+      function moveTo(left, top) {
+        const rect = panel.getBoundingClientRect();
+        const x = Math.max(0, Math.min(left, window.innerWidth - rect.width));
+        const y = Math.max(0, Math.min(top, window.innerHeight - rect.height));
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        panel.style.left = `${x}px`;
+        panel.style.top = `${y}px`;
+      }
+      function clampPosition() {
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+      handle.tabIndex = 0;
+      handle.setAttribute('role', 'group');
+      handle.setAttribute('aria-label', 'Move quick order panel. Drag or use arrow keys.');
+      handle.classList.add('is-ready');
+      panel.classList.add('is-ready');
+      handle.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        handle.setPointerCapture(event.pointerId);
+        handle.classList.add('dragging');
+      });
+      handle.addEventListener('pointermove', event => {
+        if (handle.hasPointerCapture(event.pointerId)) moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+      handle.addEventListener('pointerup', event => {
+        if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
+      });
+      handle.addEventListener('pointercancel', () => handle.classList.remove('dragging'));
+      handle.addEventListener('lostpointercapture', () => handle.classList.remove('dragging'));
+      handle.addEventListener('keydown', event => {
+        const directions = { ArrowLeft: [-15, 0], ArrowRight: [15, 0], ArrowUp: [0, -15], ArrowDown: [0, 15] };
+        const direction = directions[event.key];
+        if (!direction) return;
+        event.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left + direction[0], rect.top + direction[1]);
+      });
+      window.addEventListener('resize', clampPosition);
+      new ResizeObserver(clampPosition).observe(panel);
+      toggle.addEventListener('click', () => {
+        body.hidden = !body.hidden;
+        toggle.textContent = body.hidden ? '+' : '−';
+        toggle.setAttribute('aria-expanded', String(!body.hidden));
+        toggle.setAttribute('aria-label', body.hidden ? 'Expand quick order' : 'Minimize quick order');
+      });
+
+      function selection() {
+        return {
+          drink: drink.value,
+          name: drink.selectedOptions[0].textContent.split(' · ')[0],
+          temperature: form.elements.temperature.value,
+          size: form.elements.size.value,
+          price: Number(drink.selectedOptions[0].dataset.price) + (form.elements.size.value === 'large' ? 100 : 0)
+        };
+      }
+      function updateSelection() {
+        quantityOutput.value = quantity;
+        quantityInput.value = quantity;
+        minus.disabled = quantity <= 1;
+        plus.disabled = quantity >= 20;
+        add.textContent = `Add to cart · ${money(selection().price * quantity)}`;
+      }
+      function renderCart() {
+        list.replaceChildren();
+        cart.forEach((item, index) => {
+          const row = document.createElement('li');
+          const description = document.createElement('span');
+          description.textContent = `${item.quantity} × ${item.name} · ${item.size}, ${item.temperature}`;
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.className = 'cart-remove';
+          remove.textContent = 'Remove';
+          remove.setAttribute('aria-label', `Remove ${item.name}, ${item.size}, ${item.temperature}`);
+          remove.addEventListener('click', () => {
+            cart.splice(index, 1);
+            renderCart();
+            status.textContent = `${item.name} removed from your cart.`;
+            add.focus();
+          });
+          row.append(description, remove);
+          list.append(row);
+        });
+        const count = cart.reduce((sum, item) => sum + item.quantity, 0);
+        document.querySelector('#cart-count').textContent = `(${count})`;
+        document.querySelector('#cart-total').textContent = money(cart.reduce((sum, item) => sum + item.price * item.quantity, 0));
+        checkout.hidden = count === 0;
+        checkout.href = '/order-online?' + new URLSearchParams({ cart: JSON.stringify(cart) });
+      }
+      minus.addEventListener('click', () => { quantity = Math.max(1, quantity - 1); updateSelection(); });
+      plus.addEventListener('click', () => { quantity = Math.min(20, quantity + 1); updateSelection(); });
+      form.addEventListener('change', () => {
+        if (drink.value === 'cold-brew') {
+          form.elements.temperature.value = 'iced';
+        }
+        form.querySelector('input[value="hot"]').disabled = drink.value === 'cold-brew';
+        updateSelection();
+      });
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const item = selection();
+        const existing = cart.find(entry => entry.drink === item.drink && entry.temperature === item.temperature && entry.size === item.size);
+        if (existing) existing.quantity += quantity;
+        else cart.push({ ...item, quantity });
+        renderCart();
+        status.textContent = `${quantity} × ${item.name} added to your cart.`;
+      });
+      document.querySelector('.cart-quantity').hidden = false;
+      document.querySelector('.cart-summary').hidden = false;
+      updateSelection();
+    })();
+  </script>
+
 </body>
 
