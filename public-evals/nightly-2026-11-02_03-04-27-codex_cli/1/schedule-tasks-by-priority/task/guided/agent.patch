+  <script type="module">
+    const definitions = {
+      checkout: { label: 'Checkout', priority: 'user-blocking', rank: 0, budget: 240 },
+      menu: { label: 'Menu update', priority: 'user-visible', rank: 1, budget: 480 },
+      telemetry: { label: 'Telemetry logging', priority: 'background', rank: 2, budget: 720 }
+    };
+    const tasks = [];
+    let nextId = 0;
+    let completed = 0;
+    let running = false;
+    let current = null;
+    const byId = (id) => document.getElementById(id);
+    const controls = [...document.querySelectorAll('[data-operation]'), byId('run-batch')];
+    const priorityOrder = (a, b) => a.rank - b.rank || a.id - b.id;
+
+    // A local priority-queue polyfill preserves ordering without an external script.
+    // Selection happens at execution time, including when Scheduler is unavailable.
+    function scheduleSlice(callback, priority) {
+      if (typeof globalThis.scheduler?.postTask === 'function') {
+        return globalThis.scheduler.postTask(callback, { priority });
+      }
+      return new Promise((resolve, reject) => setTimeout(() => {
+        try { resolve(callback()); } catch (error) { reject(error); }
+      }, 0));
+    }
+
+    function yieldToBrowser() {
+      if (typeof globalThis.scheduler?.yield === 'function') {
+        return globalThis.scheduler.yield();
+      }
+      return new Promise((resolve) => setTimeout(resolve, 0));
+    }
+
+    function renderQueue() {
+      byId('queue-pending').textContent = tasks.length;
+      byId('queue-completed').textContent = completed;
+      byId('queue-state').textContent = tasks.length ? 'Processing' : 'Idle';
+      const waiting = tasks.filter((task) => task !== current).sort(priorityOrder);
+      byId('queue-empty').hidden = waiting.length > 0;
+      byId('queue-waiting').replaceChildren(...waiting.map((task) => {
+        const row = document.createElement('li');
+        row.textContent = `#${task.id} ${task.label} · ${task.rank === 0 ? 'Urgent' : task.rank === 1 ? 'Standard' : 'Background'}${task.work ? ' · Paused' : ''}`;
+        return row;
+      }));
+      controls.forEach((button) => {
+        button.disabled = tasks.length + (button.id === 'run-batch' ? 3 : 1) > 60;
+      });
+    }
+
+    function renderProgress(task) {
+      const percent = Math.min(100, Math.round(task.work / task.budget * 100));
+      byId('current-task').textContent = `#${task.id} ${task.label}`;
+      byId('task-progress').value = percent;
+      byId('task-progress-text').textContent = `${percent}% complete`;
+    }
+
+    async function drainQueue() {
+      if (running) return;
+      running = true;
+      try {
+        while (tasks.length) {
+          tasks.sort(priorityOrder);
+          const priority = tasks[0].priority;
+          await scheduleSlice(async () => {
+            // Re-check after dispatch: an urgent click may have arrived while waiting.
+            tasks.sort(priorityOrder);
+            const task = tasks[0];
+            if (current !== task) {
+              current = task;
+              renderQueue();
+            }
+            // Simulate CPU work in slices well below the 50ms long-task threshold.
+            const start = performance.now();
+            const deadline = start + Math.min(6, task.budget - task.work);
+            do {
+              task.checksum = (task.checksum * 1664525 + 1013904223) >>> 0;
+            } while (performance.now() < deadline);
+            task.work += performance.now() - start;
+            renderProgress(task);
+            if (task.work >= task.budget) {
+              tasks.splice(tasks.indexOf(task), 1);
+              completed++;
+              current = null;
+              const entry = document.createElement('li');
+              entry.textContent = `#${task.id} ${task.label} · Completed`;
+              const history = byId('queue-history');
+              history.append(entry);
+              // Bound the DOM and retain the actual execution order of recent tasks.
+              if (history.children.length > 12) history.firstElementChild.remove();
+              history.start = Math.max(1, completed - 11);
+              byId('history-empty').hidden = true;
+              renderQueue();
+            }
+            await yieldToBrowser();
+          }, priority);
+        }
+        byId('current-task').textContent = 'All tasks complete. Ready for more.';
+        byId('task-progress-text').textContent = 'Queue finished';
+        byId('queue-status').textContent = `Queue finished. ${completed} simulated ${completed === 1 ? 'task' : 'tasks'} completed.`;
+      } catch (error) {
+        tasks.length = 0;
+        current = null;
+        byId('current-task').textContent = 'Queue stopped.';
+        byId('task-progress').value = 0;
+        byId('task-progress-text').textContent = 'No task running';
+        byId('queue-status').textContent = 'The simulation could not finish. Try running a task again.';
+        console.error('Operations simulator failed:', error);
+      } finally {
+        running = false;
+        renderQueue();
+      }
+    }
+
+    function enqueue(types) {
+      if (tasks.length + types.length > 60) return;
+      types.forEach((type) => tasks.push({ ...definitions[type], id: ++nextId, work: 0, checksum: 1 }));
+      renderQueue();
+      byId('queue-status').textContent = `${types.length === 1 ? definitions[types[0]].label : 'Mixed batch'} queued. You can add urgent work while other tasks run.`;
+      void drainQueue();
+    }
+
+    document.querySelectorAll('[data-operation]').forEach((button) => {
+      button.addEventListener('click', () => enqueue([button.dataset.operation]));
+    });
+    // Intentionally enqueue out of priority order to demonstrate prioritization.
+    byId('run-batch').addEventListener('click', () => enqueue(['telemetry', 'menu', 'checkout']));
+  </script>
