+  <script>
+    (() => {
+      const types = {
+        urgent: { name: 'Checkout', label: 'Urgent', rank: 0, slices: 45, priority: 'user-blocking' },
+        standard: { name: 'Menu update', label: 'Standard', rank: 1, slices: 90, priority: 'user-visible' },
+        background: { name: 'Telemetry logging', label: 'Background', rank: 2, slices: 135, priority: 'background' }
+      };
+      const queue = [];
+      const history = [];
+      const capacity = 24;
+      let nextId = 1;
+      let completed = 0;
+      let processing = false;
+      let checksum = 0;
+      const taskList = document.getElementById('task-list');
+      const activityList = document.getElementById('activity-list');
+      const buttons = document.querySelectorAll('[data-task]');
+      const batchButton = document.getElementById('run-batch');
+
+      function render() {
+        queue.sort((a, b) => types[a.type].rank - types[b.type].rank || a.id - b.id);
+        document.getElementById('pending-count').textContent = queue.length;
+        document.getElementById('completed-count').textContent = completed;
+        const status = queue.length ? `Processing ${types[queue[0].type].name.toLowerCase()}` : 'Ready for tasks';
+        const statusElement = document.getElementById('queue-status');
+        if (statusElement.textContent !== status) statusElement.textContent = status;
+        taskList.innerHTML = queue.length ? queue.map((task, index) => {
+          const type = types[task.type];
+          const percent = Math.floor(task.done / type.slices * 100);
+          return `<li class="task-item"><div class="task-heading"><strong>${type.name} #${task.id}</strong><span>${index === 0 ? 'Running' : task.done ? 'Paused' : 'Queued'} · ${percent}%</span></div><div class="task-meta"><span class="priority priority-${task.type}">${type.label}</span><small>Task ${task.id}</small></div><progress class="task-progress" max="100" value="${percent}" aria-label="${type.name} ${task.id} progress">${percent}%</progress></li>`;
+        }).join('') : '<li class="empty-state">The queue is clear. Add a task to get started.</li>';
+        buttons.forEach(button => { button.disabled = queue.length >= capacity; });
+        batchButton.disabled = queue.length > capacity - 3;
+      }
+
+      function runSlice() {
+        // Select again after each yield so newly arrived urgent work can preempt.
+        queue.sort((a, b) => types[a.type].rank - types[b.type].rank || a.id - b.id);
+        const task = queue[0];
+        if (!task) { processing = false; return; }
+        const type = types[task.type];
+        // Bound CPU work to 3ms, then return control to the browser for input/paint.
+        const deadline = performance.now() + 3;
+        do { checksum = (checksum + Math.sqrt(task.id + checksum)) % 10000; }
+        while (performance.now() < deadline);
+        task.done += 1;
+        if (task.done === type.slices) {
+          queue.shift();
+          completed += 1;
+          history.unshift({ id: task.id, name: type.name, label: type.label, time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) });
+          history.splice(8);
+          activityList.innerHTML = history.map(item => `<li>✓ ${item.name} #${item.id}<small>${item.label} · Completed at ${item.time}</small></li>`).join('');
+        }
+        // Keep DOM updates bounded as well as the simulated work.
+        if (task.done % 5 === 0 || task.done === type.slices) render();
+        if (queue.length) scheduleSlice();
+        else { processing = false; render(); }
+      }
+
+      function scheduleSlice() {
+        // The timer also gives browsers without the Scheduling API a chance to paint.
+        setTimeout(() => {
+          const priority = types[queue[0].type].priority;
+          if (globalThis.scheduler && typeof globalThis.scheduler.postTask === 'function') {
+            globalThis.scheduler.postTask(runSlice, { priority }).catch(() => {
+              processing = false;
+              document.getElementById('queue-status').textContent = 'Queue interrupted. Add a task to resume.';
+            });
+          } else {
+            runSlice();
+          }
+        }, 16);
+      }
+
+      function enqueue(taskTypes) {
+        if (queue.length + taskTypes.length > capacity) return;
+        taskTypes.forEach(type => queue.push({ type, id: nextId++, done: 0 }));
+        render();
+        if (!processing) {
+          processing = true;
+          scheduleSlice();
+        }
+      }
+
+      buttons.forEach(button => button.addEventListener('click', () => enqueue([button.dataset.task])));
+      // Enqueue in reverse priority to demonstrate that scheduling determines order.
+      batchButton.addEventListener('click', () => enqueue(['background', 'standard', 'urgent']));
+    })();
+  </script>
+
