+  <script>
+    (() => {
+      'use strict';
+      const form = document.getElementById('rewards-form');
+      const panels = [...form.querySelectorAll('[data-step]')];
+      const indicators = [...document.querySelectorAll('.steps li')];
+      const next = document.getElementById('next-step');
+      const back = document.getElementById('previous-step');
+      const summary = document.getElementById('error-summary');
+      const result = document.getElementById('registration-result');
+      const password = document.getElementById('password');
+      const toggle = document.getElementById('toggle-password');
+      const announcement = document.getElementById('step-announcement');
+      let step = 0;
+      let completed = false;
+      form.noValidate = true;
+      next.disabled = false;
+
+      function errorFor(input) {
+        if (input.required && !input.value.trim()) return input.type === 'password' ? 'Enter a password.' : `Enter your ${input.id === 'email' ? 'email address' : input.id === 'given-name' ? 'first name' : 'last name'}.`;
+        if (input.type === 'email' && input.validity.typeMismatch) return 'Enter a valid email address, such as you@example.com.';
+        if (input.type === 'password' && (input.value.length < 15 || input.value.length > 128)) return 'Use between 15 and 128 characters for your password.';
+        if (input.maxLength > 0 && input.value.length > input.maxLength) return `Use no more than ${input.maxLength} characters.`;
+        return '';
+      }
+
+      function updateError(input, message) {
+        const error = document.getElementById(`${input.id}-error`);
+        if (!error) return;
+        error.textContent = message;
+        error.hidden = !message;
+        if (message) input.setAttribute('aria-invalid', 'true');
+        else input.removeAttribute('aria-invalid');
+      }
+
+      function showStep(index, focus = true) {
+        step = index;
+        summary.hidden = true;
+        summary.replaceChildren();
+        panels.forEach((panel, i) => {
+          panel.hidden = i !== step;
+          panel.disabled = i !== step;
+        });
+        indicators.forEach((item, i) => {
+          item.classList.toggle('complete', i < step);
+          if (i === step) item.setAttribute('aria-current', 'step');
+          else item.removeAttribute('aria-current');
+        });
+        back.hidden = step === 0;
+        next.textContent = step === 2 ? 'Finish preview' : 'Continue →';
+        // Never reflect user input as HTML, and never display the password.
+        if (step === 2) {
+          document.getElementById('review-name').textContent = `${form.elements.givenName.value.trim()} ${form.elements.familyName.value.trim()}`;
+          document.getElementById('review-email').textContent = form.elements.email.value.trim();
+        }
+        password.type = 'password';
+        toggle.textContent = 'Show password';
+        toggle.setAttribute('aria-pressed', 'false');
+        announcement.textContent = `Step ${step + 1} of 3`;
+        if (focus) panels[step].querySelector('legend').focus();
+      }
+
+      function validatePanel(index) {
+        const errors = [];
+        panels[index].querySelectorAll('input[required]').forEach(input => {
+          const message = errorFor(input);
+          updateError(input, message);
+          if (message) errors.push({ input, message });
+        });
+        if (!errors.length) return true;
+        showStep(index, false);
+        const heading = document.createElement('p');
+        heading.textContent = 'Please check the following:';
+        const list = document.createElement('ul');
+        errors.forEach(({ input, message }) => {
+          const item = document.createElement('li');
+          const link = document.createElement('a');
+          link.href = `#${input.id}`;
+          link.textContent = message;
+          link.addEventListener('click', event => { event.preventDefault(); input.focus(); });
+          item.append(link);
+          list.append(item);
+        });
+        summary.replaceChildren(heading, list);
+        summary.hidden = false;
+        summary.focus();
+        return false;
+      }
+
+      form.addEventListener('submit', event => {
+        // Static preview only: no network request, URL parameters, or persistence.
+        // A production endpoint must enforce server-side validation, CSRF protection,
+        // rate limits, email verification, and secure password hashing over HTTPS.
+        event.preventDefault();
+        if (completed || !validatePanel(step)) return;
+        if (step < 2) { showStep(step + 1); return; }
+        // Recheck every step, including values changed by autofill.
+        for (let i = 0; i < panels.length; i++) {
+          if (!validatePanel(i)) return;
+        }
+        completed = true;
+        form.reset();
+        password.type = 'password';
+        document.getElementById('review-name').textContent = '';
+        document.getElementById('review-email').textContent = '';
+        form.hidden = true;
+        document.querySelector('.steps').hidden = true;
+        announcement.textContent = '';
+        result.hidden = false;
+        result.focus();
+      });
+      back.addEventListener('click', () => showStep(Math.max(0, step - 1)));
+      document.getElementById('edit-details').addEventListener('click', () => showStep(0));
+      toggle.addEventListener('click', () => {
+        const show = password.type === 'password';
+        password.type = show ? 'text' : 'password';
+        toggle.textContent = show ? 'Hide password' : 'Show password';
+        toggle.setAttribute('aria-pressed', String(show));
+      });
+      form.addEventListener('input', event => {
+        if (event.target.matches('input[aria-invalid="true"]')) {
+          updateError(event.target, errorFor(event.target));
+          // Remove outdated summary links as a field is corrected.
+          summary.hidden = true;
+        }
+      });
+      document.getElementById('restart-registration').addEventListener('click', () => {
+        completed = false;
+        result.hidden = true;
+        form.hidden = false;
+        document.querySelector('.steps').hidden = false;
+        showStep(0);
+      });
+      window.addEventListener('pagehide', () => form.reset());
+      window.addEventListener('pageshow', event => {
+        if (event.persisted && !completed) showStep(0, false);
+      });
+    })();
+  </script>
+
 </body>
 
