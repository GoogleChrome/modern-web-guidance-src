diff --git a/crypto.mjs b/crypto.mjs
new file mode 100644
index 0000000..ea1c35f
--- /dev/null
+++ b/crypto.mjs
@@ -0,0 +1,37 @@
+const encoder = new TextEncoder();
+export const algorithm = { name: 'ECDSA', namedCurve: 'P-256' };
+export const signingAlgorithm = { name: 'ECDSA', hash: 'SHA-256' };
+export function canonical(value) {
+  if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
+  if (value && typeof value === 'object') return '{' + Object.keys(value).sort().map(k => JSON.stringify(k) + ':' + canonical(value[k])).join(',') + '}';
+  return JSON.stringify(value);
+}
+export function encode(bytes) { return btoa(String.fromCharCode(...new Uint8Array(bytes))); }
+export function decode(value) {
+  if (typeof value !== 'string' || value.length > 10000) throw new Error('Invalid encoded key or signature.');
+  return Uint8Array.from(atob(value), c => c.charCodeAt(0));
+}
+export async function fingerprint(key) {
+  const raw = await crypto.subtle.exportKey('spki', key);
+  return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', raw)), b => b.toString(16).padStart(2, '0')).join('');
+}
+export async function createKeys() { return crypto.subtle.generateKey(algorithm, false, ['sign', 'verify']); }
+export async function exportPublic(key) {
+  return { format: 'daily-grind-public-key-v1', algorithm: 'ECDSA-P256-SHA256', publicKey: encode(await crypto.subtle.exportKey('spki', key)) };
+}
+export async function importPublic(value) {
+  if (value.format !== 'daily-grind-public-key-v1' || value.algorithm !== 'ECDSA-P256-SHA256') throw new Error('Choose a Daily Grind P-256 public key file.');
+  return crypto.subtle.importKey('spki', decode(value.publicKey), algorithm, true, ['verify']);
+}
+export async function signDocument(document, keys) {
+  const envelope = { format: 'daily-grind-signed-document-v1', algorithm: 'ECDSA-P256-SHA256', keyId: await fingerprint(keys.publicKey), document };
+  const signature = await crypto.subtle.sign(signingAlgorithm, keys.privateKey, encoder.encode(canonical(envelope)));
+  return { ...envelope, signature: encode(signature) };
+}
+export async function verifyDocument(envelope, trustedKey) {
+  if (!envelope || envelope.format !== 'daily-grind-signed-document-v1' || envelope.algorithm !== 'ECDSA-P256-SHA256' || !envelope.document || !['receipt', 'voucher'].includes(envelope.document.type)) throw new Error('This is not a supported signed receipt or gift voucher.');
+  if (Object.keys(envelope).sort().join(',') !== 'algorithm,document,format,keyId,signature') throw new Error('The signed file contains unexpected fields.');
+  if (envelope.keyId !== await fingerprint(trustedKey)) throw new Error('Unknown signing key. Import the issuer’s public key from a trusted source, then try again.');
+  const { signature, ...payload } = envelope;
+  return crypto.subtle.verify(signingAlgorithm, trustedKey, decode(signature), encoder.encode(canonical(payload)));
+}
diff --git a/crypto.test.mjs b/crypto.test.mjs
new file mode 100644
index 0000000..c384994
--- /dev/null
+++ b/crypto.test.mjs
@@ -0,0 +1,47 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createKeys, exportPublic, importPublic, fingerprint, signDocument, verifyDocument } from './crypto.mjs';
+const keys = await createKeys();
+const document = { type: 'receipt', reference: 'DG-001', customer: 'Alex', amountMinor: 1250, currency: 'USD', issuedOn: '2026-11-02' };
+test('receipt and voucher signatures survive JSON export and public-key import', async () => {
+  const publicKey = await importPublic(JSON.parse(JSON.stringify(await exportPublic(keys.publicKey))));
+  assert.equal(await fingerprint(publicKey), await fingerprint(keys.publicKey));
+  for (const type of ['receipt', 'voucher']) {
+    const envelope = await signDocument({ ...document, type }, keys);
+    assert.equal(await verifyDocument(JSON.parse(JSON.stringify(envelope)), publicKey), true);
+  }
+});
+test('changes to signed content are rejected', async () => {
+  const envelope = await signDocument(document, keys);
+  for (const field of ['customer','amountMinor','reference','type','issuedOn']) {
+    const changed = structuredClone(envelope);
+    changed.document[field] = field === 'amountMinor' ? 1 : field === 'type' ? 'voucher' : 'altered';
+    assert.equal(await verifyDocument(changed, keys.publicKey), false);
+  }
+  const changed = structuredClone(envelope);
+  changed.document.extra = 'unsigned addition';
+  assert.equal(await verifyDocument(changed, keys.publicKey), false);
+});
+test('another signer cannot impersonate the trusted key', async () => {
+  const attacker = await createKeys();
+  const envelope = await signDocument(document, attacker);
+  await assert.rejects(verifyDocument(envelope, keys.publicKey), /Unknown signing key/);
+  envelope.keyId = await fingerprint(keys.publicKey);
+  assert.equal(await verifyDocument(envelope, keys.publicKey), false);
+});
+test('malformed files, unsupported algorithms and extra fields fail closed', async () => {
+  for (const value of [null, {}, { format: 'other' }]) await assert.rejects(verifyDocument(value, keys.publicKey));
+  const envelope = await signDocument(document, keys);
+  await assert.rejects(verifyDocument({ ...envelope, algorithm: 'RSA' }, keys.publicKey));
+  await assert.rejects(verifyDocument({ ...envelope, extra: 'unsigned' }, keys.publicKey));
+  await assert.rejects(importPublic({ format: 'unknown' }));
+});
+test('private key is not exportable', async () => {
+  assert.equal(keys.privateKey.extractable, false);
+  await assert.rejects(crypto.subtle.exportKey('jwk', keys.privateKey));
+});
+test('object property ordering does not invalidate a signature', async () => {
+  const envelope = await signDocument(document, keys);
+  envelope.document = Object.fromEntries(Object.entries(envelope.document).reverse());
+  assert.equal(await verifyDocument(envelope, keys.publicKey), true);
+});
