+const $ = id => document.getElementById(id);
+let type = 'receipt', keys, trustedKey, pendingKey;
+const date = new Date();
+const today = `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
+$('issue-date').value = today;
+$('expiry').min = today;
+function message(title, detail, error = false) {
+  const box = $('status'); box.replaceChildren();
+  const heading = document.createElement('strong'); heading.textContent = title;
+  const text = document.createElement('span'); text.textContent = detail;
+  box.append(heading, text); box.className = error ? 'error' : ''; box.hidden = false;
+}
+function download(value, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(value, null, 2)], {type:'application/json'}));
+  const anchor = document.createElement('a'); anchor.href = url; anchor.download = filename; anchor.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+function amountText() {
+  return new Intl.NumberFormat('en-US', {style:'currency',currency:$('currency').value}).format(Number($('amount').value) || 0);
+}
+function updatePreview() {
+  $('preview-reference').textContent = $('reference').value || 'Document number';
+  $('preview-date').textContent = $('issue-date').value;
+  $('preview-customer').textContent = $('customer').value || 'Your name here';
+  $('preview-description').textContent = $('description').value || 'A little something to make your day.';
+  $('preview-amount').textContent = amountText();
+  $('preview-expiry').textContent = type === 'voucher' && $('expiry').value ? `Valid until ${$('expiry').value}` : '';
