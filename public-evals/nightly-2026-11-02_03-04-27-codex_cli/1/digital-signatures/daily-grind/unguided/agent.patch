+$('document-file').addEventListener('change', async () => {
+  try { $('document-json').value = JSON.stringify(await readJSON($('document-file').files[0]), null, 2); $('status').hidden = true; }
+  catch(e) { $('document-json').value = ''; message('Could not read document', e.message, true); }
+});
+$('verify-form').addEventListener('submit', async e => {
+  e.preventDefault(); const button = e.submitter; button.disabled = true;
+  try {
+    const raw = $('document-json').value;
+    if (!raw.trim()) throw new Error('Upload a signed document or paste its JSON.');
+    if (raw.length > 1024*1024) throw new Error('Document is too large. The limit is 1 MB.');
+    let envelope; try { envelope = JSON.parse(raw); } catch { throw new Error('The document does not contain valid JSON.'); }
+    let key;
+    if (keys && envelope?.keyId === await fingerprint(keys.publicKey)) key = keys.publicKey;
+    else if (trustedKey) key = trustedKey;
+    if (!key) throw new Error('No trusted key available. Import and confirm the issuer’s public key under Your keys.');
