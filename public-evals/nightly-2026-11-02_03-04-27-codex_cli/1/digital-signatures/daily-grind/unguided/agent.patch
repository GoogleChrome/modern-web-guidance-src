+  if (!globalThis.isSecureContext || !crypto.subtle) throw new Error('Signing requires HTTPS or localhost and a browser with Web Crypto support.');
+  if (!keys) keys = await createKeys();
+  $('key-state').textContent = 'Your session signing key is ready. SHA-256 public-key fingerprint:';
+  $('key-fingerprint').textContent = await fingerprint(keys.publicKey); $('key-fingerprint').hidden = false;
+  $('export-key').disabled = false; $('generate-key').disabled = true; $('generate-key').textContent = 'Signing key ready';
+  return keys;
+}
+$('generate-key').addEventListener('click', async () => {
+  try { await ensureKeys(); message('Signing key created', 'Export the public key so recipients can verify your documents. Save it before closing this page.'); }
+  catch(e) { message('Could not create key', e.message, true); }
+});
+$('export-key').addEventListener('click', async () => {
+  try { download(await exportPublic(keys.publicKey), 'daily-grind-public-key.json'); }
+  catch(e) { message('Could not export public key', e.message, true); }
+});
+$('sign-form').addEventListener('submit', async e => {
+  e.preventDefault(); const button = $('sign-button'); button.disabled = true;
