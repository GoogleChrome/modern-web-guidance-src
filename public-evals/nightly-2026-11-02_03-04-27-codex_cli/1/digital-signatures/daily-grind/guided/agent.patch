diff --git a/tests/crypto.test.mjs b/tests/crypto.test.mjs
new file mode 100644
index 0000000..3c80cdc
--- /dev/null
+++ b/tests/crypto.test.mjs
@@ -0,0 +1,37 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createIdentity, signDocument, verifyDocument, validateTrustKey } from '../crypto.mjs';
+for (const suite of ['Ed25519', 'ECDSA']) {
+  test(`${suite}: sign both document types and reject tampering and unknown signers`, async () => {
+    const identity = await createIdentity(suite);
+    assert.equal(identity.keys.privateKey.extractable, false);
+    await assert.rejects(crypto.subtle.exportKey('pkcs8', identity.keys.privateKey));
+    const trust = { version: 1, ...identity }; delete trust.keys;
+    await validateTrustKey(trust);
+    for (const kind of ['receipt', 'voucher']) {
+      const signed = await signDocument(identity, kind, { reference: 'DG-1', amountCents: 1100 });
+      assert.equal((await verifyDocument(signed, trust)).amountCents, 1100);
+      await assert.rejects(verifyDocument({ ...signed, payload: signed.payload.replace('1100', '9900') }, trust), /Signature invalid/);
+      await assert.rejects(verifyDocument({ ...signed, kind: kind === 'receipt' ? 'voucher' : 'receipt' }, trust), /Signature invalid/);
+      await assert.rejects(verifyDocument({ ...signed, version: 2 }, trust), /not a supported/);
+      await assert.rejects(verifyDocument(signed, undefined), /Unknown signer/);
+      await assert.rejects(verifyDocument({ ...signed, keyId: 'fake' }, trust), /Unknown signer/);
+      await assert.rejects(verifyDocument({ ...signed, signature: 'AAAA' }, trust));
+    }
+    await assert.rejects(validateTrustKey({ ...trust, keyId: 'fake' }), /Invalid verification/);
+    const restored = structuredClone(identity);
+    assert.equal((await verifyDocument(await signDocument(restored, 'receipt', {}), trust)).id.length, 36);
+  });
+}
+test('Automatic suite chooses an available algorithm; unsupported choices fail explicitly', async () => {
+  const identity = await createIdentity();
+  assert.ok(['ML-DSA-65', 'Ed25519', 'ECDSA'].includes(identity.suite));
+  const trust = { version: 1, suite: identity.suite, keyId: identity.keyId, publicKey: identity.publicKey };
+  const signed = await signDocument(identity, 'voucher', { amountCents: 2500 });
+  assert.equal((await verifyDocument(signed, JSON.parse(JSON.stringify(trust)))).amountCents, 2500);
+  await assert.rejects(verifyDocument({ ...signed, payload: signed.payload.replace('2500', '9500') }, trust), /Signature invalid/);
+  const impostor = await createIdentity(identity.suite);
+  await assert.rejects(verifyDocument(signed, { ...trust, publicKey: impostor.publicKey }), /Invalid verification/);
+  await assert.rejects(createIdentity('unknown'), /Unsupported/);
+  await assert.rejects(verifyDocument({ version: 1, kind: 'voucher', suite: 'bogus' }, {}), /not a supported/);
+});
