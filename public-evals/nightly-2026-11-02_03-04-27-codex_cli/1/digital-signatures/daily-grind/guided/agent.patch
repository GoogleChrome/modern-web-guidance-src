+import { createIdentity, signDocument, verifyDocument, validateTrustKey } from './crypto.mjs';
+const $ = selector => document.querySelector(selector);
+let kind = 'receipt', signed, identity, db, persistent = false;
+const identities = new Map(), trusted = new Map();
+function status(selector, message, error = false) {
+  const el = $(selector); el.textContent = message; el.classList.toggle('error', error); el.hidden = false;
+}
+function publicRecord(value) {
+  return { version: 1, suite: value.suite, keyId: value.keyId, publicKey: value.publicKey };
+}
+function transaction(mode, work) {
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction('keys', mode);
+    const request = work(tx.objectStore('keys'));
+    tx.oncomplete = () => resolve(request.result);
+    tx.onerror = () => reject(tx.error);
+    tx.onabort = () => reject(tx.error || new Error('Key storage was interrupted.'));
+  });
+}
+function describeIdentity() {
+  $('#key-status').textContent = identity
+    ? `${identity.suite} · ${identity.keyId.slice(0, 16)}… · ${persistent ? 'Saved on this device' : 'Session only — export your public key before leaving'}`
+    : 'Created when you sign your first document.';
+}
+const ready = (async () => {
+  try {
+    db = await new Promise((resolve, reject) => {
+      const request = indexedDB.open('daily-grind-signatures', 1);
+      request.onupgradeneeded = () => request.result.createObjectStore('keys');
+      request.onsuccess = () => resolve(request.result);
+      request.onerror = () => reject(request.error);
+      request.onblocked = () => reject(new Error('Key storage is blocked by another tab.'));
+    });
+    const stored = await transaction('readonly', store => store.get('state'));
+    if (stored) {
+      for (const item of stored.identities) identities.set(item.preference, item.identity);
+      for (const key of stored.trusted) trusted.set(key.keyId, key);
+      identity = identities.get('auto') || identities.values().next().value;
+    }
+    persistent = true;
+    describeIdentity();
+  } catch {
+    status('#key-message', 'Persistent key storage is unavailable. Signing works for this session; export your public verification key to verify documents later.');
+  }
+})();
+async function save() {
+  if (!persistent) return;
+  try {
+    await transaction('readwrite', store => store.put({
+      identities: [...identities].map(([preference, identity]) => ({ preference, identity })),
+      trusted: [...trusted.values()]
+    }, 'state'));
+  } catch {
+    persistent = false;
+    status('#key-message', 'Keys could not be saved. Export your public verification key before leaving this page.', true);
+  }
+}
+function download(value, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(value, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a'); link.href = url; link.download = filename; link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+async function readFile(file) {
+  if (!file) throw new Error('Choose a JSON file first.');
+  if (file.size > 1024 * 1024) throw new Error('The file is too large. Choose a JSON file smaller than 1 MB.');
+  return JSON.parse(await file.text());
+}
+function clearVerification() { $('#verify-status').hidden = true; }
+for (const tab of document.querySelectorAll('[role=tab]')) {
+  tab.addEventListener('click', () => {
+    kind = tab.dataset.kind;
+    for (const item of document.querySelectorAll('[role=tab]')) {
+      item.setAttribute('aria-selected', String(item === tab)); item.tabIndex = item === tab ? 0 : -1;
+    }
+    $('#create-panel').setAttribute('aria-labelledby', tab.id);
+    const voucher = kind === 'voucher';
+    $('#create-title').textContent = voucher ? 'A little joy, signed and sealed.' : 'A receipt you can stand behind.';
+    $('#create-description').textContent = voucher ? 'Create a signed gift record for someone’s next coffee moment.' : 'Keep a tamper-evident record of your daily pick-me-up.';
+    $('#name-label').textContent = voucher ? 'Recipient name' : 'Customer name';
+    $('#reference-label').textContent = voucher ? 'Voucher reference' : 'Order reference';
+    $('#details-label').textContent = voucher ? 'Gift message' : 'Your coffee order';
+    $('#amount-label').textContent = voucher ? 'Gift value (USD)' : 'Order total (USD)';
+    $('[name=details]').placeholder = voucher ? 'e.g. A little pick-me-up, just for you.' : 'e.g. 2 × Maple Oat Latte';
+    $('[name=reference]').placeholder = voucher ? 'e.g. GIFT-1042' : 'e.g. DG-1042';
+    $('#sign-button').firstChild.textContent = voucher ? 'Sign gift voucher ' : 'Sign receipt ';
+    $('#signed-result').hidden = true; $('#sign-status').hidden = true;
+  });
+  tab.addEventListener('keydown', event => {
+    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+    event.preventDefault();
+    const target = event.key === 'Home' ? $('#receipt-tab') : event.key === 'End' ? $('#voucher-tab') : tab === $('#receipt-tab') ? $('#voucher-tab') : $('#receipt-tab');
+    target.click(); target.focus();
+  });
+}
+$('#sign-form').addEventListener('input', () => {
+  $('#sign-status').hidden = true; $('#signed-result').hidden = true;
+});
+$('#sign-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  const button = $('#sign-button'); button.disabled = true; $('#algorithm').disabled = true;
+  $('#signed-result').hidden = true;
+  status('#sign-status', 'Creating your signature…');
+  const currentKind = kind;
+  const details = Object.fromEntries(new FormData(event.currentTarget));
+  try {
+    await ready;
+    for (const name of ['customer', 'reference', 'details']) {
+      details[name] = details[name].trim();
+      if (!details[name]) throw new Error('Please complete every field with a non-empty value.');
+    }
+    const cents = Math.round(Number(details.amount) * 100);
+    if (!Number.isSafeInteger(cents) || cents < 1 || cents > 1000000) throw new Error('Enter an amount between $0.01 and $10,000.00.');
+    const preference = $('#algorithm').value;
+    identity = identities.get(preference) || await createIdentity(preference);
+    identities.set(preference, identity);
+    trusted.set(identity.keyId, publicRecord(identity));
+    await save(); describeIdentity();
+    signed = await signDocument(identity, currentKind, {
+      customer: details.customer, reference: details.reference, details: details.details,
+      amountCents: cents, currency: 'USD', issuer: 'Local browser signing identity'
+    });
+    status('#sign-status', `${currentKind === 'voucher' ? 'Gift voucher' : 'Receipt'} signed with ${identity.suite}. Download it to keep the signed original.`);
+    $('#signed-result').hidden = false;
+  } catch (error) { status('#sign-status', error.message, true); }
+  finally { button.disabled = false; $('#algorithm').disabled = false; }
+});
+$('#download-document').addEventListener('click', () => {
+  if (signed) download(signed, `daily-grind-${signed.kind}-${JSON.parse(signed.payload).id}.json`);
+});
+$('#check-document').addEventListener('click', () => {
+  $('#verify-input').value = JSON.stringify(signed, null, 2);
+  $('#document-file').value = ''; clearVerification(); $('#verify-button').click();
+});
+$('#export-key').addEventListener('click', async () => {
+  await ready;
+  if (!identity) return status('#key-message', 'Sign a document first to create your browser’s signing identity.');
+  download(publicRecord(identity), `daily-grind-public-key-${identity.keyId.slice(0, 12)}.json`);
+  status('#key-message', 'Public verification key exported. Share it through a trusted channel. Your private key was not exported.');
+});
+$('#key-file').addEventListener('change', async event => {
+  try {
+    await ready;
+    const key = await validateTrustKey(await readFile(event.target.files[0]));
+    trusted.set(key.keyId, publicRecord(key)); await save();
+    status('#key-message', `Trusted ${key.suite} key: ${key.keyId}. Only use this key if you obtained it directly from the signer.`);
+    clearVerification();
+  } catch (error) { status('#key-message', `Key import failed: ${error.message}`, true); }
+  finally { event.target.value = ''; }
+});
+$('#document-file').addEventListener('change', async event => {
+  clearVerification();
+  try {
+    const envelope = await readFile(event.target.files[0]);
+    $('#verify-input').value = JSON.stringify(envelope, null, 2);
+    status('#verify-status', 'Document loaded. Select Verify signature to check it.');
+  } catch (error) {
+    $('#verify-input').value = ''; status('#verify-status', `Could not read document: ${error.message}`, true);
+  }
+});
+$('#verify-input').addEventListener('input', clearVerification);
+$('#verify-button').addEventListener('click', async () => {
+  const button = $('#verify-button'); button.disabled = true;
+  try {
+    await ready;
+    const text = $('#verify-input').value.trim();
+    if (!text) throw new Error('Choose a signed document or paste its JSON first.');
+    if (new TextEncoder().encode(text).length > 1024 * 1024) throw new Error('Document exceeds the 1 MB limit.');
+    const envelope = JSON.parse(text);
+    const details = await verifyDocument(envelope, trusted.get(envelope.keyId));
+    const amount = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(details.amountCents / 100);
+    status('#verify-status', `Signature valid · ${envelope.suite}. ${envelope.kind === 'voucher' ? 'Gift voucher' : 'Receipt'} ${details.reference} · ${amount} · ${details.customer}. Details: ${details.details}. Signed ${details.issuedAt}. Matches trusted key ${envelope.keyId.slice(0, 16)}…. Payment and redemption are not verified.`);
+  } catch (error) {
+    status('#verify-status', error instanceof SyntaxError ? 'Invalid JSON. Choose a signed Daily Grind document or paste its complete JSON.' : error.message, true);
+  } finally { button.disabled = false; }
+});
diff --git a/crypto.mjs b/crypto.mjs
new file mode 100644
index 0000000..ec7b19b
--- /dev/null
+++ b/crypto.mjs
@@ -0,0 +1,60 @@
+const encoder = new TextEncoder();
+export const suites = ['ML-DSA-65', 'Ed25519', 'ECDSA'];
+const algorithm = suite => suite === 'ECDSA' ? { name: 'ECDSA', namedCurve: 'P-256' } : suite;
+const operation = suite => suite === 'ECDSA' ? { name: 'ECDSA', hash: 'SHA-256' } : suite;
+export const toBase64 = bytes => btoa(String.fromCharCode(...new Uint8Array(bytes)));
+export const fromBase64 = value => Uint8Array.from(atob(value), c => c.charCodeAt(0));
+export async function fingerprint(publicKey) {
+  const digest = await crypto.subtle.digest('SHA-256', fromBase64(publicKey));
+  return Array.from(new Uint8Array(digest), b => b.toString(16).padStart(2, '0')).join('');
+}
+export async function createIdentity(preference = 'auto') {
+  if (!globalThis.crypto?.subtle) throw new Error('Secure signing requires HTTPS or localhost and Web Crypto support.');
+  const candidates = preference === 'auto' ? suites : [preference];
+  for (const suite of candidates) {
+    if (!suites.includes(suite)) throw new Error('Unsupported signing algorithm.');
+    try {
+      const keys = await crypto.subtle.generateKey(algorithm(suite), false, ['sign', 'verify']);
+      const publicKey = toBase64(await crypto.subtle.exportKey('spki', keys.publicKey));
+      return { suite, keys, publicKey, keyId: await fingerprint(publicKey) };
+    } catch (error) {
+      if (error.name !== 'NotSupportedError') throw error;
+    }
+  }
+  throw new Error('This browser does not support the selected algorithm. Choose Automatic for a compatible classical algorithm.');
+}
+function input(envelope) {
+  // Sign exact UTF-8 payload bytes, framed with a versioned purpose and suite.
+  const context = encoder.encode(`daily-grind/v1/${envelope.kind}/${envelope.suite}`);
+  const payload = encoder.encode(envelope.payload);
+  const framed = new Uint8Array(1 + context.length + payload.length);
+  framed[0] = context.length;
+  framed.set(context, 1);
+  framed.set(payload, 1 + context.length);
+  return framed;
+}
+export async function signDocument(identity, kind, details) {
+  if (!['receipt', 'voucher'].includes(kind)) throw new Error('Unknown document type.');
+  const envelope = { version: 1, kind, suite: identity.suite, keyId: identity.keyId,
+    payload: JSON.stringify({ ...details, id: crypto.randomUUID(), issuedAt: new Date().toISOString() }) };
+  envelope.signature = toBase64(await crypto.subtle.sign(operation(identity.suite), identity.keys.privateKey, input(envelope)));
+  return envelope;
+}
+export async function validateTrustKey(key) {
+  if (key?.version !== 1 || !suites.includes(key.suite) || typeof key.publicKey !== 'string' ||
+      await fingerprint(key.publicKey) !== key.keyId) throw new Error('Invalid verification key file.');
+  await crypto.subtle.importKey('spki', fromBase64(key.publicKey), algorithm(key.suite), false, ['verify']);
+  return key;
+}
+export async function verifyDocument(envelope, trusted) {
+  if (envelope?.version !== 1 || !['receipt', 'voucher'].includes(envelope.kind) ||
+      !suites.includes(envelope.suite) || typeof envelope.payload !== 'string' ||
+      typeof envelope.signature !== 'string') throw new Error('This is not a supported signed Daily Grind document.');
+  if (!trusted || envelope.keyId !== trusted.keyId || envelope.suite !== trusted.suite)
+    throw new Error('Unknown signer. Import a verification key from a source you trust.');
+  await validateTrustKey(trusted);
+  const key = await crypto.subtle.importKey('spki', fromBase64(trusted.publicKey), algorithm(trusted.suite), false, ['verify']);
+  const valid = await crypto.subtle.verify(operation(trusted.suite), key, fromBase64(envelope.signature), input(envelope));
+  if (!valid) throw new Error('Signature invalid. The document was changed or the signature does not match.');
+  return JSON.parse(envelope.payload);
+}
