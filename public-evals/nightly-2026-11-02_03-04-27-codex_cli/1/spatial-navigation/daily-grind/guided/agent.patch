diff --git a/spatial-navigation.mjs b/spatial-navigation.mjs
new file mode 100644
index 0000000..caffd88
--- /dev/null
+++ b/spatial-navigation.mjs
@@ -0,0 +1,100 @@
+const directions = {
+  ArrowLeft: { axis: 'x', sign: -1 },
+  ArrowRight: { axis: 'x', sign: 1 },
+  ArrowUp: { axis: 'y', sign: -1 },
+  ArrowDown: { axis: 'y', sign: 1 },
+};
+
+// Work with physical edges so CSS grid, flex wrapping, RTL and visual reordering
+// all use the same navigation rules. Rectangles must be read for each keypress.
+export function findSpatialTarget(current, candidates, key) {
+  const direction = directions[key];
+  if (!direction) return;
+
+  const horizontal = direction.axis === 'x';
+  const start = horizontal ? 'left' : 'top';
+  const end = horizontal ? 'right' : 'bottom';
+  const crossStart = horizontal ? 'top' : 'left';
+  const crossEnd = horizontal ? 'bottom' : 'right';
+  const center = (rect) => (rect[crossStart] + rect[crossEnd]) / 2;
+  const ranked = [];
+
+  for (const candidate of candidates) {
+    if (candidate.element === current.element) continue;
+    const rect = candidate.rect;
+    const gap = direction.sign > 0
+      ? rect[start] - current.rect[end]
+      : current.rect[start] - rect[end];
+    if (gap < -1) continue; // Allow subpixel rounding, not overlapping items.
+
+    const overlap = Math.min(rect[crossEnd], current.rect[crossEnd])
+      - Math.max(rect[crossStart], current.rect[crossStart]);
+    const offset = Math.abs(center(rect) - center(current.rect));
+    ranked.push({ ...candidate, aligned: overlap > 0, gap: Math.max(0, gap), offset });
+  }
+
+  ranked.sort((a, b) => {
+    if (a.aligned !== b.aligned) return a.aligned ? -1 : 1;
+    return a.aligned
+      ? a.gap - b.gap || a.offset - b.offset
+      : (a.gap + 2 * a.offset) - (b.gap + 2 * b.offset);
+  });
+  return ranked[0]?.element;
+}
+
+function isAvailable(element) {
+  if (element.matches(':disabled') || element.closest('[inert], [hidden], [aria-hidden="true"]')) {
+    return false;
+  }
+  if (typeof element.checkVisibility === 'function') {
+    if (!element.checkVisibility({ visibilityProperty: true, opacityProperty: true })) return false;
+  } else {
+    // Fallback for browsers without checkVisibility (e.g. older Safari).
+    for (let ancestor = element; ancestor; ancestor = ancestor.parentElement) {
+      const style = getComputedStyle(ancestor);
+      if (style.visibility !== 'visible' || style.opacity === '0') return false;
+    }
+  }
+  const rect = element.getBoundingClientRect();
+  return rect.width > 0 && rect.height > 0;
+}
+
+export function initSpatialNavigation(container) {
+  const items = () => [...container.querySelectorAll('[data-spatial-item]')];
+  const activate = (active) => {
+    for (const item of items()) item.tabIndex = item === active ? 0 : -1;
+  };
+  const initialItems = items().filter(isAvailable);
+  activate(initialItems.includes(document.activeElement) ? document.activeElement : initialItems[0]);
+
+  // Pointer and programmatic focus also become the group's next Tab entry point.
+  container.addEventListener('focusin', (event) => {
+    const target = event.composedPath()[0];
+    if (items().includes(target) && isAvailable(target)) activate(target);
+  });
+
+  container.addEventListener('keydown', (event) => {
+    if (!Object.hasOwn(directions, event.key) || event.defaultPrevented || event.isComposing
+      || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
+
+    const target = event.composedPath()[0];
+    // Leave nested controls and editable content to their own keyboard handlers.
+    if (!(target instanceof HTMLElement)
+      || target.matches(':read-write, select, input, textarea, [role="slider"], [role="spinbutton"], [role="combobox"]')) return;
+
+    const candidates = items().filter(isAvailable).map((element) => ({
+      element,
+      rect: element.getBoundingClientRect(),
+    }));
+    const current = candidates.find(({ element }) => element === target);
+    if (!current) return;
+
+    const next = findSpatialTarget(current, candidates, event.key);
+    if (!next) return; // Keep native viewport scrolling at the group's edges.
+
+    event.preventDefault();
+    activate(next);
+    next.focus({ preventScroll: true });
+    next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+  });
+}
diff --git a/spatial-navigation.test.mjs b/spatial-navigation.test.mjs
new file mode 100644
index 0000000..7d0c3f4
--- /dev/null
+++ b/spatial-navigation.test.mjs
@@ -0,0 +1,128 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { findSpatialTarget, initSpatialNavigation } from './spatial-navigation.mjs';
+
+function item(element, left, top, width = 100, height = 50) {
+  return { element, rect: { left, top, right: left + width, bottom: top + height, width, height } };
+}
+
+test('moves in all four physical directions in a grid without wrapping at edges', () => {
+  const cells = [item('a', 0, 0), item('b', 120, 0), item('c', 0, 70), item('d', 120, 70)];
+  assert.equal(findSpatialTarget(cells[0], cells, 'ArrowRight'), 'b');
+  assert.equal(findSpatialTarget(cells[0], cells, 'ArrowDown'), 'c');
+  assert.equal(findSpatialTarget(cells[3], cells, 'ArrowLeft'), 'c');
+  assert.equal(findSpatialTarget(cells[3], cells, 'ArrowUp'), 'b');
+  assert.equal(findSpatialTarget(cells[0], cells, 'ArrowLeft'), undefined);
+  assert.equal(findSpatialTarget(cells[3], cells, 'ArrowDown'), undefined);
+});
+
+test('follows visual order in reversed/RTL layouts and recomputes after reflow', () => {
+  const cells = [item('a', 240, 0), item('b', 120, 0), item('c', 0, 0)];
+  assert.equal(findSpatialTarget(cells[0], cells, 'ArrowLeft'), 'b');
+  assert.equal(findSpatialTarget(cells[2], cells, 'ArrowRight'), 'b');
+  cells[0] = item('a', 0, 0);
+  cells[1] = item('b', 0, 70);
+  cells[2] = item('c', 0, 140);
+  assert.equal(findSpatialTarget(cells[0], cells, 'ArrowDown'), 'b');
+  assert.equal(findSpatialTarget(cells[0], cells, 'ArrowRight'), undefined);
+});
+
+test('prefers overlapping rows, then gap and cross-axis alignment', () => {
+  const current = item('current', 0, 0);
+  const cells = [current, item('diagonal', 105, 60), item('aligned', 180, 0)];
+  assert.equal(findSpatialTarget(current, cells, 'ArrowRight'), 'aligned');
+  cells.push(item('closer', 120, 10), item('centered', 120, 0));
+  assert.equal(findSpatialTarget(current, cells, 'ArrowRight'), 'centered');
+});
+
+test('uses edges rather than centers for spanning/overlapping cards', () => {
+  const current = item('current', 0, 0, 300);
+  const cells = [current, item('overlap', 200, 0, 300), item('next', 320, 0)];
+  assert.equal(findSpatialTarget(current, cells, 'ArrowRight'), 'next');
+});
+
+test('scores diagonal candidates in wrapped and incomplete rows', () => {
+  const current = item('current', 200, 0);
+  const cells = [current, item('near-row', 0, 70), item('aligned-diagonal', 180, 150, 10)];
+  assert.equal(findSpatialTarget(current, cells, 'ArrowDown'), 'aligned-diagonal');
+});
+
+test('permits subpixel edge rounding and ignores unrelated keys', () => {
+  const current = item('current', 0, 0);
+  const cells = [current, item('next', 99.5, 0)];
+  assert.equal(findSpatialTarget(current, cells, 'ArrowRight'), 'next');
+  assert.equal(findSpatialTarget(current, cells, 'Enter'), undefined);
+});
+
+test('event integration: roving focus, live layout, visibility, boundaries and native controls', (t) => {
+  class MockElement {
+    constructor(left) {
+      this.rect = item(this, left, 0).rect;
+      this.visible = true;
+      this.tabIndex = 0;
+    }
+    matches() { return this.editable ?? false; }
+    closest() { return this.inert ? this : null; }
+    checkVisibility() { return this.visible; }
+    getBoundingClientRect() { return this.rect; }
+    focus(options) { this.focusOptions = options; }
+    scrollIntoView(options) { this.scrollOptions = options; }
+  }
+  const originalElement = Object.getOwnPropertyDescriptor(globalThis, 'HTMLElement');
+  const originalDocument = Object.getOwnPropertyDescriptor(globalThis, 'document');
+  Object.defineProperty(globalThis, 'HTMLElement', { configurable: true, value: MockElement });
+  Object.defineProperty(globalThis, 'document', { configurable: true, value: { activeElement: null } });
+  t.after(() => {
+    if (originalElement) Object.defineProperty(globalThis, 'HTMLElement', originalElement);
+    else delete globalThis.HTMLElement;
+    if (originalDocument) Object.defineProperty(globalThis, 'document', originalDocument);
+    else delete globalThis.document;
+  });
+
+  const cells = [new MockElement(0), new MockElement(120), new MockElement(240)];
+  const listeners = {};
+  const container = {
+    querySelectorAll: () => cells,
+    addEventListener: (name, handler) => { listeners[name] = handler; },
+  };
+  const press = (target, key = 'ArrowRight', extra = {}) => {
+    const event = {
+      key, composedPath: () => [target],
+      preventDefault() { this.defaultPrevented = true; },
+      ...extra,
+    };
+    listeners.keydown(event);
+    return event;
+  };
+  initSpatialNavigation(container);
+  assert.deepEqual(cells.map((cell) => cell.tabIndex), [0, -1, -1]);
+  assert.equal(press(cells[0]).defaultPrevented, true);
+  assert.deepEqual(cells.map((cell) => cell.tabIndex), [-1, 0, -1]);
+  assert.deepEqual(cells[1].focusOptions, { preventScroll: true });
+  assert.deepEqual(cells[1].scrollOptions, { block: 'nearest', inline: 'nearest' });
+
+  listeners.focusin({ composedPath: () => [cells[2]] });
+  assert.deepEqual(cells.map((cell) => cell.tabIndex), [-1, -1, 0]);
+  assert.equal(press(cells[2]).defaultPrevented, undefined);
+  for (const flag of ['altKey', 'ctrlKey', 'metaKey', 'shiftKey', 'isComposing']) {
+    assert.equal(press(cells[0], 'ArrowRight', { [flag]: true }).defaultPrevented, undefined);
+  }
+  assert.equal(press(cells[0], 'Tab').defaultPrevented, undefined);
+  press(cells[0], 'ArrowRight', { defaultPrevented: true });
+  assert.deepEqual(cells.map((cell) => cell.tabIndex), [-1, -1, 0]);
+  cells[0].editable = true;
+  assert.equal(press(cells[0]).defaultPrevented, undefined);
+  cells[0].editable = false;
+  assert.equal(press(new MockElement(0)).defaultPrevented, undefined);
+
+  cells[1].visible = false;
+  press(cells[0]);
+  assert.deepEqual(cells.map((cell) => cell.tabIndex), [-1, -1, 0]);
+  cells[2].inert = true;
+  assert.equal(press(cells[0]).defaultPrevented, undefined);
+  cells[2].inert = false;
+  cells[1].visible = true;
+  cells[1].rect = item(cells[1], 0, 70).rect;
+  assert.equal(press(cells[0], 'ArrowDown').defaultPrevented, true);
+  assert.deepEqual(cells.map((cell) => cell.tabIndex), [-1, 0, -1]);
+});
