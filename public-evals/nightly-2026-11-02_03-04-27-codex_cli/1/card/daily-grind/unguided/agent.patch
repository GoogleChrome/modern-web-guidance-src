+  <script>
+    const forms = [...document.querySelectorAll('.drink-form')];
+    const drinkNames = forms.map(form => form.dataset.drink);
+    const sizes = ['small', 'medium', 'large'];
+    const storageKey = 'daily-grind-order';
+    let order = [];
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey) || '[]');
+      if (Array.isArray(saved)) {
+        order = saved.filter(item => item && drinkNames.includes(item.drink) && sizes.includes(item.size) && Number.isSafeInteger(item.quantity) && item.quantity > 0);
+      }
+    } catch { /* Orders still work when storage is unavailable. */ }
+    const items = document.getElementById('order-items');
+    const status = document.getElementById('order-status');
+    const total = () => order.reduce((sum, item) => sum + item.quantity, 0);
+    function saveOrder() {
+      try { localStorage.setItem(storageKey, JSON.stringify(order)); }
+      catch { /* Keep the current order in memory. */ }
+    }
+    function renderOrder() {
+      items.replaceChildren();
+      order.forEach((item, index) => {
+        const row = document.createElement('li');
+        const label = document.createElement('span');
+        label.textContent = `${item.quantity} × ${item.drink} · ${item.size}`;
+        const remove = document.createElement('button');
+        remove.type = 'button';
+        remove.textContent = 'Remove';
+        remove.setAttribute('aria-label', `Remove ${item.size} ${item.drink} from order`);
+        remove.addEventListener('click', () => {
+          order.splice(index, 1);
+          saveOrder();
+          renderOrder();
+          status.textContent = `Removed ${item.size} ${item.drink} from your order.`;
+          const buttons = items.querySelectorAll('button');
+          (buttons[Math.min(index, buttons.length - 1)] || forms[0].querySelector('button')).focus();
+        });
+        row.append(label, remove);
+        items.append(row);
+      });
+      document.getElementById('order-count').textContent = `(${total()})`;
+      document.getElementById('empty-order').hidden = order.length > 0;
+    }
+    forms.forEach(form => {
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const drink = form.dataset.drink;
+        const size = new FormData(form).get('size');
+        if (!sizes.includes(size)) return;
+        const existing = order.find(item => item.drink === drink && item.size === size);
+        if (existing) existing.quantity += 1;
+        else order.push({ drink, size, quantity: 1 });
+        saveOrder();
+        renderOrder();
+        status.textContent = `Added ${size} ${drink}. Your order now contains ${total()} drinks.`;
+      });
+    });
+    renderOrder();
+  </script>
