diff --git a/performance-monitor.js b/performance-monitor.js
new file mode 100644
index 0000000..b1815c3
--- /dev/null
+++ b/performance-monitor.js
@@ -0,0 +1,140 @@
+(() => {
+  'use strict';
+
+  // Keep installation idempotent if a future client-side router reloads scripts.
+  if (window.dailyGrindPerformance) return;
+
+  const supported = window.PerformanceObserver?.supportedEntryTypes ?? [];
+  const support = Object.freeze({
+    interactionPaint: supported.includes('interaction-contentful-paint'),
+    softNavigation: supported.includes('soft-navigation'),
+  });
+  const reports = [];
+  const sources = new Map();
+  const inputs = [];
+  let activeNavigation = null;
+  let largestPaint = null;
+
+  const sourceFor = (target) =>
+    target?.closest?.('[data-performance-source]')?.dataset.performanceSource ?? null;
+
+  function rememberSource(id, source) {
+    if (!id || !source) return;
+    sources.set(id, source);
+    if (sources.size > 200) sources.delete(sources.keys().next().value);
+  }
+
+  function report(metric) {
+    const record = Object.freeze({ ...metric, timeOrigin: performance.timeOrigin });
+    reports.push(record);
+    if (reports.length > 200) reports.shift();
+    // Local integration point: no endpoint or third-party analytics is assumed.
+    window.dispatchEvent(new CustomEvent('daily-grind:performance', { detail: record }));
+  }
+
+  // Event Timing supplies interaction IDs. Captured timestamps also identify fast
+  // inputs below Event Timing's minimum duration threshold, without guessing from
+  // the most recently clicked control (which could misattribute async content).
+  if (support.interactionPaint) {
+    for (const type of ['pointerdown', 'pointerup', 'click', 'keydown', 'keyup']) {
+      document.addEventListener(type, (event) => {
+        if (!event.isTrusted) return;
+        const source = sourceFor(event.target);
+        if (!source) return;
+        inputs.push({ startTime: event.timeStamp, source });
+        if (inputs.length > 100) inputs.shift();
+      }, { capture: true, passive: true });
+    }
+  }
+
+  function interactionSource(entry) {
+    const source = sources.get(entry.interactionId) ?? inputs.findLast(
+      (input) => Math.abs(input.startTime - entry.startTime) < 1,
+    )?.source ?? null;
+    rememberSource(entry.interactionId, source);
+    return source;
+  }
+
+  function considerPaint(entry) {
+    // navigationId may still describe the previous route for early paints.
+    if (activeNavigation && entry?.interactionId === activeNavigation.interactionId &&
+        (!largestPaint || entry.largestContentfulPaint.size >= largestPaint.largestContentfulPaint.size)) {
+      largestPaint = entry;
+    }
+  }
+
+  function finalizeNavigation() {
+    if (!activeNavigation) return;
+    // Refresh the browser's candidate even if the paint observer hasn't delivered.
+    considerPaint(activeNavigation.getLargestInteractionContentfulPaint());
+    report({
+      type: 'soft-navigation',
+      path: new URL(activeNavigation.name, location.href).pathname,
+      navigationId: activeNavigation.navigationId,
+      interactionId: activeNavigation.interactionId,
+      source: interactionSource(activeNavigation),
+      startTime: activeNavigation.startTime,
+      fcpDuration: activeNavigation.duration,
+      lcpDuration: largestPaint?.duration ?? null,
+      lcpSize: largestPaint?.largestContentfulPaint.size ?? null,
+    });
+    activeNavigation = null;
+    largestPaint = null;
+  }
+
+  function observe(type, callback, options = {}) {
+    if (!supported.includes(type)) return null;
+    const observer = new PerformanceObserver((list) => callback(list.getEntries()));
+    observer.observe({ type, buffered: true, ...options });
+    return { observer, callback };
+  }
+
+  const events = support.interactionPaint ? observe('event', (entries) => {
+    for (const entry of entries) rememberSource(entry.interactionId, sourceFor(entry.target));
+  }, { durationThreshold: 16 }) : null;
+
+  const paints = observe('interaction-contentful-paint', (entries) => {
+    // Observer callbacks can arrive in either order.
+    if (events) events.callback(events.observer.takeRecords());
+    for (const entry of entries) {
+      considerPaint(entry);
+      report({
+        type: 'interaction-contentful-paint',
+        path: location.pathname,
+        source: interactionSource(entry),
+        interactionId: entry.interactionId,
+        startTime: entry.startTime,
+        duration: entry.duration,
+        paintTime: entry.paintTime,
+        presentationTime: entry.presentationTime,
+        size: entry.largestContentfulPaint.size,
+      });
+    }
+  });
+
+  const navigations = support.interactionPaint ? observe('soft-navigation', (entries) => {
+    for (const entry of entries) {
+      finalizeNavigation();
+      activeNavigation = entry;
+      // Includes content painted before the URL was updated.
+      largestPaint = entry.getLargestInteractionContentfulPaint();
+    }
+  }) : null;
+
+  function flush() {
+    for (const subscription of [events, paints, navigations]) {
+      if (subscription) subscription.callback(subscription.observer.takeRecords());
+    }
+    finalizeNavigation();
+  }
+
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState === 'hidden') flush();
+  });
+  window.addEventListener('pagehide', flush);
+
+  window.dailyGrindPerformance = Object.freeze({
+    support,
+    getReports: () => reports.slice(),
+  });
+})();
diff --git a/performance-monitor.test.cjs b/performance-monitor.test.cjs
new file mode 100644
index 0000000..500f651
--- /dev/null
+++ b/performance-monitor.test.cjs
@@ -0,0 +1,125 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+
+const script = readFileSync(`${__dirname}/performance-monitor.js`, 'utf8');
+
+function setup(types = ['event', 'interaction-contentful-paint', 'soft-navigation']) {
+  const observers = new Map();
+  const listeners = new Map();
+  const emitted = [];
+  const addEventListener = (type, callback) => {
+    if (!listeners.has(type)) listeners.set(type, []);
+    listeners.get(type).push(callback);
+  };
+  class PerformanceObserver {
+    static supportedEntryTypes = types;
+    constructor(callback) { this.callback = callback; this.records = []; }
+    observe(options) { this.options = options; observers.set(options.type, this); }
+    takeRecords() { return this.records.splice(0); }
+  }
+  const document = { addEventListener, visibilityState: 'visible' };
+  const window = { PerformanceObserver, addEventListener, dispatchEvent: (event) => emitted.push(event.detail) };
+  const context = {
+    window, document, PerformanceObserver, URL,
+    performance: { timeOrigin: 1000 },
+    location: { href: 'https://daily.example/', pathname: '/' },
+    CustomEvent: class { constructor(type, options) { this.type = type; this.detail = options.detail; } },
+  };
+  runInNewContext(script, context);
+  return {
+    window, document, emitted, observers,
+    deliver(type, entries) { observers.get(type).callback({ getEntries: () => entries }); },
+    fire(type, event = {}) { for (const callback of listeners.get(type) ?? []) callback(event); },
+    reinstall() { runInNewContext(script, context); },
+  };
+}
+
+const target = (source) => ({ closest: () => ({ dataset: { performanceSource: source } }) });
+const paint = (interactionId, duration, size = 100) => ({
+  interactionId, startTime: 50, duration, paintTime: 50 + duration - 2,
+  presentationTime: 50 + duration, navigationId: 'previous-route',
+  largestContentfulPaint: { size },
+});
+const navigation = (interactionId, candidate, name = '/menu') => ({
+  interactionId, name, navigationId: `route-${interactionId}`, startTime: 50,
+  duration: 30, getLargestInteractionContentfulPaint: () => candidate,
+});
+
+test('unsupported browsers gracefully skip observers; installation is idempotent', () => {
+  const app = setup([]);
+  const api = app.window.dailyGrindPerformance;
+  app.reinstall();
+  assert.equal(app.window.dailyGrindPerformance, api);
+  assert.equal(app.observers.size, 0);
+  assert.equal(api.support.interactionPaint, false);
+  app.fire('pagehide');
+  assert.equal(app.emitted.length, 0);
+  // Also exercise a browser with no PerformanceObserver at all.
+  const context = { window: {}, document: { addEventListener() {} } };
+  context.window.addEventListener = () => {};
+  runInNewContext(script, context);
+  assert.equal(context.window.dailyGrindPerformance.support.softNavigation, false);
+});
+
+test('all requested controls report interaction-to-presentation durations', () => {
+  for (const source of ['navigation:menu', 'order-now', 'seasonal:maple-oat-latte']) {
+    const app = setup();
+    // Queue Event Timing without delivering its callback first.
+    app.observers.get('event').records.push({ interactionId: 7, target: target(source) });
+    app.deliver('interaction-contentful-paint', [paint(7, 250)]);
+    assert.equal(app.emitted[0].source, source);
+    assert.equal(app.emitted[0].duration, 250);
+    assert.equal(app.emitted[0].presentationTime, 300);
+    assert.equal(app.emitted[0].timeOrigin, 1000);
+  }
+});
+
+test('fast keyboard inputs are attributed by timestamp, never by latest control', () => {
+  const app = setup(['interaction-contentful-paint']);
+  app.fire('keydown', { isTrusted: true, timeStamp: 50, target: target('order-now') });
+  app.fire('click', { isTrusted: true, timeStamp: 80, target: target('navigation:menu') });
+  app.deliver('interaction-contentful-paint', [paint(7, 5)]);
+  assert.equal(app.emitted[0].source, 'order-now');
+  app.deliver('interaction-contentful-paint', [{ ...paint(8, 5), startTime: 90 }]);
+  assert.equal(app.emitted[1].source, null);
+});
+
+test('soft navigation seeds early paints and excludes unrelated interactions', () => {
+  const app = setup();
+  const early = paint(7, 80, 200);
+  app.deliver('soft-navigation', [navigation(7, early, '/menu?private=value')]);
+  app.deliver('interaction-contentful-paint', [paint(8, 900, 1000), paint(7, 100, 300)]);
+  app.fire('pagehide');
+  const metric = app.emitted.find((entry) => entry.type === 'soft-navigation');
+  assert.equal(metric.lcpDuration, 100);
+  assert.equal(metric.fcpDuration, 30);
+  assert.equal(metric.lcpSize, 300);
+  assert.equal(metric.path, '/menu');
+  assert.equal(metric.navigationId, 'route-7');
+});
+
+test('route changes and hiding drain pending entries and finalize each route once', () => {
+  const app = setup();
+  app.deliver('soft-navigation', [navigation(7, paint(7, 80))]);
+  app.observers.get('soft-navigation').records.push(navigation(8, paint(8, 120), '/order-online'));
+  app.document.visibilityState = 'hidden';
+  app.fire('visibilitychange');
+  app.fire('pagehide');
+  assert.equal(app.emitted.length, 2);
+  assert.equal(app.emitted[0].lcpDuration, 80);
+  assert.equal(app.emitted[1].lcpDuration, 120);
+  for (const observer of app.observers.values()) assert.equal(observer.options.buffered, true);
+});
+
+test('report buffer is bounded and returned arrays cannot mutate stored reports', () => {
+  const app = setup();
+  app.deliver('interaction-contentful-paint', Array.from({ length: 250 }, (_, id) => paint(id, 10)));
+  const reports = app.window.dailyGrindPerformance.getReports();
+  assert.equal(reports.length, 200);
+  assert.equal(reports[0].interactionId, 50);
+  reports.pop();
+  assert.equal(app.window.dailyGrindPerformance.getReports().length, 200);
+  assert.equal(Object.isFrozen(reports[0]), true);
+});
