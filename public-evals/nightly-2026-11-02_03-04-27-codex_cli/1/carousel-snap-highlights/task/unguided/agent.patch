+  <script>
+    const carousel = document.querySelector('.carousel');
+    const items = [...carousel.querySelectorAll('.carousel-item')];
+    let framePending = false;
+
+    function updateActiveCard() {
+      const bounds = carousel.getBoundingClientRect();
+      const center = bounds.left + carousel.clientWidth / 2;
+      let closestItem = items[0];
+      let closestDistance = Infinity;
+
+      for (const item of items) {
+        const bounds = item.getBoundingClientRect();
+        const distance = Math.abs(bounds.left + bounds.width / 2 - center);
+        if (distance < closestDistance) {
+          closestItem = item;
+          closestDistance = distance;
+        }
+      }
+
+      for (const item of items) {
+        item.classList.toggle('is-active', item === closestItem);
+      }
+      framePending = false;
+    }
+
+    function scheduleUpdate() {
+      if (!framePending) {
+        framePending = true;
+        requestAnimationFrame(updateActiveCard);
+      }
+    }
+
+    carousel.addEventListener('scroll', scheduleUpdate, { passive: true });
+    new ResizeObserver(scheduleUpdate).observe(carousel);
+    updateActiveCard();
+  </script>
+
