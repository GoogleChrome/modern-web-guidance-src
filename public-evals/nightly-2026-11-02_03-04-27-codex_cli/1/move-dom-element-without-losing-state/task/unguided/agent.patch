+  <script>
+    (() => {
+      const hero = document.querySelector('.hero');
+      const home = document.getElementById('main-video-slot');
+      const theater = document.getElementById('hero-video-slot');
+      const player = document.getElementById('roasting-player');
+      const toggle = document.querySelector('.theater-toggle');
+      let theaterMode = false;
+      const canMove = typeof theater.moveBefore === 'function';
+
+      // Legacy DOM insertion methods reload iframes. Keep the player connected
+      // to its original parent and position it over the hero slot instead.
+      function positionLegacyPlayer() {
+        if (canMove || !theaterMode) return;
+        const origin = home.getBoundingClientRect();
+        const target = theater.getBoundingClientRect();
+        player.style.left = `${target.left - origin.left}px`;
+        player.style.top = `${target.top - origin.top}px`;
+        player.style.width = `${target.width}px`;
+        player.style.height = `${target.height}px`;
+      }
+
+      toggle.hidden = false;
+      toggle.addEventListener('click', () => {
+        theaterMode = !theaterMode;
+        // Make both destinations visible before performing the atomic move.
+        theater.hidden = false;
+        hero.classList.toggle('is-theater', theaterMode);
+        home.classList.toggle('is-vacant', theaterMode);
+
+        if (canMove) {
+          (theaterMode ? theater : home).moveBefore(player, null);
+        } else if (theaterMode) {
+          positionLegacyPlayer();
+        } else {
+          player.style.left = '';
+          player.style.top = '';
+          player.style.width = '';
+          player.style.height = '';
+        }
+
+        theater.hidden = !theaterMode;
+        toggle.setAttribute('aria-pressed', String(theaterMode));
+        toggle.textContent = theaterMode ? 'Exit theater mode' : 'Theater mode';
+      });
+
+      window.addEventListener('resize', positionLegacyPlayer);
+      if (typeof ResizeObserver === 'function') {
+        const observer = new ResizeObserver(positionLegacyPlayer);
+        observer.observe(home);
+        observer.observe(theater);
+        observer.observe(hero);
+      }
+    })();
+  </script>
