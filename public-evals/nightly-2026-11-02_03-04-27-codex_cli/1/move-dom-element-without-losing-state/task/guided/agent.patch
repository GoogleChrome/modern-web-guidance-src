+  <script>
+    const hero = document.querySelector('.hero');
+    const videoHome = document.getElementById('video-home');
+    const videoPanel = document.getElementById('video-panel');
+    const theaterToggle = document.getElementById('theater-toggle');
+    const supportsStatePreservingMove = typeof hero.moveBefore === 'function';
+
+    theaterToggle.hidden = false;
+    document.getElementById('video-fallback-note').hidden = supportsStatePreservingMove;
+
+    theaterToggle.addEventListener('click', () => {
+      const theaterMode = theaterToggle.getAttribute('aria-pressed') !== 'true';
+      const destination = theaterMode ? hero : videoHome;
+
+      if (supportsStatePreservingMove) {
+        // An atomic move preserves the iframe's browsing context and playback.
+        destination.moveBefore(videoPanel, null);
+      } else {
+        // Legacy DOM moves work, but cannot preserve an iframe's browsing context.
+        destination.appendChild(videoPanel);
+      }
+
+      hero.classList.toggle('theater-active', theaterMode);
+      theaterToggle.setAttribute('aria-pressed', String(theaterMode));
+      theaterToggle.focus({ preventScroll: true });
+      videoPanel.scrollIntoView({ block: 'nearest', behavior: 'instant' });
+    });
+  </script>
