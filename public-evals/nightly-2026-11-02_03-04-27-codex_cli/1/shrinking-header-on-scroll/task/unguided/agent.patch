+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      var logo = nav.querySelector('.logo');
+      var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
+      var nativeScrollAnimation = window.CSS && window.CSS.supports &&
+        window.CSS.supports('animation-timeline', 'scroll(root block)') &&
+        window.CSS.supports('animation-range', '0px 160px');
+
+      if (nativeScrollAnimation) return;
+
+      // Older browsers get the same continuous, clamped scroll interpolation.
+      var scheduled = false;
+      var requestFrame = window.requestAnimationFrame || function (callback) {
+        return window.setTimeout(callback, 16);
+      };
+
+      function update() {
+        scheduled = false;
+        if (reducedMotion && reducedMotion.matches) {
+          nav.style.height = '';
+          logo.style.fontSize = '';
+          return;
+        }
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.max(0, Math.min(scrollTop / 160, 1));
+        var mobile = window.matchMedia && window.matchMedia('(max-width: 640px)').matches;
+        nav.style.height = ((mobile ? 6.8 : 4.4) - 1.2 * progress) + 'rem';
+        logo.style.fontSize = (1.5 - 0.375 * progress) + 'rem';
+      }
+
+      function scheduleUpdate() {
+        if (!scheduled) {
+          scheduled = true;
+          requestFrame.call(window, update);
+        }
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, false);
+      window.addEventListener('resize', scheduleUpdate, false);
+      window.addEventListener('pageshow', scheduleUpdate, false);
+      if (reducedMotion && reducedMotion.addListener) reducedMotion.addListener(scheduleUpdate);
+      update();
+    }());
+  </script>
