+  <script>
+    (function () {
+      // Use the same continuous shrink in browsers without full timeline support.
+      var hasScrollTimeline = window.CSS && typeof CSS.supports === 'function' &&
+        CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+      if (hasScrollTimeline) return;
+
+      var navigation = document.querySelector('nav');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var framePending = false;
+
+      function updateNavigation() {
+        framePending = false;
+        if (reducedMotion.matches) {
+          navigation.style.height = '';
+          return;
+        }
+        var rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.max(0, Math.min(1, scrollTop / (1.25 * rem)));
+        navigation.style.height = 'calc(var(--nav-height) - ' + (1.25 * progress) + 'rem)';
+      }
+
+      function scheduleUpdate() {
+        if (framePending) return;
+        framePending = true;
+        window.requestAnimationFrame(updateNavigation);
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      // addListener also covers older Safari versions.
+      reducedMotion.addListener(scheduleUpdate);
+      updateNavigation();
+    }());
+  </script>
+
