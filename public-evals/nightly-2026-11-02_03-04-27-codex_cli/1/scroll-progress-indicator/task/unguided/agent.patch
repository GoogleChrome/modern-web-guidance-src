 </head>
 
 <body>
+  <div class="scroll-progress" aria-hidden="true"></div>
 
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
@@ -206,7 +233,42 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      if (window.CSS && CSS.supports('animation-timeline', 'scroll(root block)')) return;
+
+      var indicator = document.querySelector('.scroll-progress');
+      var framePending = false;
+
+      function updateProgress() {
+        var root = document.documentElement;
+        var scrollHeight = Math.max(root.scrollHeight, document.body.scrollHeight);
+        var scrollable = scrollHeight - root.clientHeight;
+        var progress = scrollable > 0 ? window.pageYOffset / scrollable : 0;
+        indicator.style.transform = 'scaleX(' + Math.max(0, Math.min(1, progress)) + ')';
+        framePending = false;
+      }
+
+      function scheduleUpdate() {
+        if (!framePending) {
+          framePending = true;
+          window.requestAnimationFrame(updateProgress);
+        }
+      }
+
+      indicator.style.display = 'block';
+      updateProgress();
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('load', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      if ('ResizeObserver' in window) {
+        var observer = new ResizeObserver(scheduleUpdate);
+        observer.observe(document.body);
+      }
+    }());
+  </script>
 </body>
 
 </html>
