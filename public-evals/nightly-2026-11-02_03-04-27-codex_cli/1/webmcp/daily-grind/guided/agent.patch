diff --git a/webmcp.js b/webmcp.js
new file mode 100644
index 0000000..dcc5bd6
--- /dev/null
+++ b/webmcp.js
@@ -0,0 +1,181 @@
+(() => {
+  'use strict';
+
+  // Read the actual cards so the agent's menu stays aligned with the page.
+  const cards = [...document.querySelectorAll('[data-drink-id]')];
+  const menu = cards.map((card) => ({
+    id: card.dataset.drinkId,
+    name: card.querySelector('h3').textContent.trim(),
+    description: card.querySelector('p').textContent.trim(),
+    detailsUrl: card.querySelector('a').getAttribute('href'),
+  }));
+  const order = new Map();
+  const status = document.querySelector('#order-status');
+  const items = document.querySelector('#order-items');
+  const empty = document.querySelector('#order-empty');
+  const clearButton = document.querySelector('#clear-order');
+  let selectedDrinkId = null;
+
+  const getOrder = () => ({
+    items: [...order].map(([id, quantity]) => ({
+      drinkId: id,
+      name: menu.find((drink) => drink.id === id).name,
+      quantity,
+    })),
+    totalQuantity: [...order.values()].reduce((sum, quantity) => sum + quantity, 0),
+    status: 'local_draft',
+  });
+
+  function renderOrder() {
+    const rows = getOrder().items.map((item) => {
+      const row = document.createElement('li');
+      row.textContent = `${item.quantity} × ${item.name}`;
+      return row;
+    });
+    items.replaceChildren(...rows);
+    empty.hidden = order.size > 0;
+    clearButton.disabled = order.size === 0;
+  }
+
+  const drinkError = () => ({
+    error: 'Choose a drinkId from the seasonal menu.',
+    availableDrinkIds: menu.map((drink) => drink.id),
+  });
+
+  function selectDrink(drinkId) {
+    const drink = menu.find((entry) => entry.id === drinkId);
+    if (!drink) return drinkError();
+    selectedDrinkId = drinkId;
+    for (const card of cards) {
+      if (card.dataset.drinkId === drinkId) {
+        card.setAttribute('aria-current', 'true');
+      } else {
+        card.removeAttribute('aria-current');
+      }
+    }
+    const card = cards.find((entry) => entry.dataset.drinkId === drinkId);
+    card.focus({ preventScroll: true });
+    card.scrollIntoView({ block: 'nearest', behavior: 'instant' });
+    status.textContent = `Selected ${drink.name}.`;
+    return { selectedDrink: { ...drink } };
+  }
+
+  function orderDrink(drinkId, quantity = 1) {
+    const drink = menu.find((entry) => entry.id === drinkId);
+    if (!drink) return drinkError();
+    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+      return { error: 'Quantity must be a whole number from 1 to 10.' };
+    }
+    const nextQuantity = (order.get(drinkId) || 0) + quantity;
+    if (nextQuantity > 10) {
+      return { error: 'An order can contain at most 10 of each drink. Clear the order to start again.' };
+    }
+    order.set(drinkId, nextQuantity);
+    renderOrder();
+    selectDrink(drinkId);
+    status.textContent = `Added ${quantity} × ${drink.name} to your on-page order.`;
+    return { added: { drinkId, quantity }, order: getOrder() };
+  }
+
+  for (const button of document.querySelectorAll('[data-order-drink]')) {
+    button.addEventListener('click', () => {
+      const result = orderDrink(button.dataset.orderDrink);
+      if (result.error) status.textContent = result.error;
+    });
+  }
+  clearButton.addEventListener('click', () => {
+    order.clear();
+    renderOrder();
+    status.textContent = 'Your on-page order has been cleared.';
+  });
+
+  // Validate here as well as in the schemas: WebMCP does not enforce schemas.
+  const validate = (allowed, execute) => (input = {}) => {
+    if (!input || typeof input !== 'object' || Array.isArray(input)) {
+      return { error: 'Supply a JSON object as the tool input.' };
+    }
+    if (Object.keys(input).some((key) => !allowed.includes(key))) {
+      return { error: 'Unknown input field.', allowedFields: allowed };
+    }
+    return execute(input);
+  };
+  const drinkIdSchema = {
+    type: 'string',
+    enum: menu.map((drink) => drink.id),
+    description: 'The seasonal drink to act on.',
+  };
+  const tools = [
+    {
+      name: 'get_seasonal_menu',
+      description: 'Find Seasonal Favorites by name or description, or list the menu to choose a drink.',
+      inputSchema: {
+        type: 'object',
+        properties: { query: { type: 'string', description: 'Words to match in the drink name or description.', default: '' } },
+        additionalProperties: false,
+      },
+      execute: validate(['query'], ({ query = '' }) => {
+        if (typeof query !== 'string') return { error: 'Query must be text.' };
+        const search = query.trim().toLowerCase();
+        const drinks = menu.filter((drink) => `${drink.name} ${drink.description}`.toLowerCase().includes(search));
+        return { section: 'Seasonal Favorites', drinks: drinks.map((drink) => ({ ...drink })), count: drinks.length };
+      }),
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'order_drink',
+      description: 'Add a seasonal drink to the on-page draft order and update the visible order summary. No payment or café submission occurs.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          drinkId: drinkIdSchema,
+          quantity: { type: 'integer', minimum: 1, maximum: 10, default: 1, description: 'Number of drinks to add.' },
+        },
+        required: ['drinkId'],
+        additionalProperties: false,
+      },
+      execute: validate(['drinkId', 'quantity'], ({ drinkId, quantity = 1 }) => orderDrink(drinkId, quantity)),
+      annotations: { readOnlyHint: false },
+    },
+    {
+      name: 'highlight_drink',
+      description: 'Highlight and focus a seasonal drink card so the user can see it on the page.',
+      inputSchema: {
+        type: 'object', properties: { drinkId: drinkIdSchema }, required: ['drinkId'], additionalProperties: false,
+      },
+      execute: validate(['drinkId'], ({ drinkId }) => selectDrink(drinkId)),
+      annotations: { readOnlyHint: false },
+    },
+    {
+      name: 'get_drink_order',
+      description: 'Read the current on-page draft order and selected seasonal drink.',
+      inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+      execute: validate([], () => ({ order: getOrder(), selectedDrinkId })),
+      annotations: { readOnlyHint: true },
+    },
+  ];
+
+  // Prefer the current API, retaining support for earlier WebMCP previews.
+  const context = document.modelContext ?? navigator.modelContext;
+  let registration;
+  async function registerTools() {
+    if (!context || typeof context.registerTool !== 'function' || registration) return;
+    const controller = new AbortController();
+    registration = controller;
+    try {
+      for (const tool of tools) {
+        if (controller.signal.aborted) return;
+        await context.registerTool(tool, { signal: controller.signal });
+      }
+    } catch (error) {
+      controller.abort();
+      if (registration === controller) registration = null;
+      console.warn('Daily Grind WebMCP tools could not be registered.', error);
+    }
+  }
+  window.addEventListener('pagehide', () => {
+    registration?.abort();
+    registration = null;
+  });
+  window.addEventListener('pageshow', () => { void registerTools(); });
+  void registerTools();
+})();
