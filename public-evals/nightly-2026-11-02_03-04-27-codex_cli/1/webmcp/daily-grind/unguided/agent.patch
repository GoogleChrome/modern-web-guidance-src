@@ -0,0 +1,96 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+
+const source = readFileSync(new URL('../webmcp.js', `file://${__filename}`), 'utf8');
+const html = readFileSync(new URL('../index.html', `file://${__filename}`), 'utf8');
+
+// A DOM test double exercises the client script without a browser or server.
+function element() {
+  return {
+    children: [], listeners: {}, dataset: {}, value: '', textContent: '',
+    append(child) { this.children.push(child); },
+    replaceChildren() { this.children = []; },
+    addEventListener(name, handler) { this.listeners[name] = handler; },
+    focus() { this.focused = true; },
+    scrollIntoView() { this.scrolled = true; },
+    classList: { toggle(name, active) { this[name] = active; } },
+  };
+}
+
+function setup(api = 'document') {
+  const nodes = Object.fromEntries([...html.matchAll(/id="([^"]+)"/g)].map(match => [match[1], element()]));
+  const cards = [...html.matchAll(/<div class="card" data-drink-id="([^"]+)"[^>]*>\s*<h3>(.*?)<\/h3>\s*<p>(.*?)<\/p>\s*<a href="([^"]+)"/g)].map(([, id, name, description, href]) => {
+    const card = element();
+    card.dataset.drinkId = id;
+    card.querySelector = selector => ({ h3: { textContent: name }, p: { textContent: description }, a: { getAttribute: () => href } })[selector];
+    return card;
+  });
+  const buttons = cards.map(card => Object.assign(element(), { dataset: { orderDrink: card.dataset.drinkId } }));
+  const tools = {};
+  const context = { registerTool(tool) { tools[tool.name] = tool; } };
+  const document = {
+    getElementById: id => nodes[id], createElement: element,
+    querySelectorAll: selector => selector === '[data-drink-id]' ? cards : buttons,
+  };
+  const navigator = {};
+  if (api === 'document') document.modelContext = context;
+  if (api === 'navigator') navigator.modelContext = context;
+  vm.runInNewContext(source, { document, navigator, console });
+  return { nodes, cards, buttons, tools };
+}
+
+test('registers tools with either WebMCP API and reads the displayed menu', async () => {
+  for (const api of ['document', 'navigator']) {
+    const { tools } = setup(api);
+    assert.deepEqual(Object.keys(tools), ['get_seasonal_menu', 'order_drink', 'highlight_drink']);
+    const { structuredContent: data } = await tools.get_seasonal_menu.execute({});
+    assert.equal(data.drinks.length, 3);
+    assert.equal(data.drinks[0].name, 'Maple Oat Latte');
+    assert.equal(data.drinks[2].id, 'cold-brew');
+    assert.equal(tools.get_seasonal_menu.annotations.readOnlyHint, true);
+  }
+});
+
+test('tool and manual actions share the order, reject invalid input, and clear it', async () => {
+  const { tools, nodes, buttons } = setup();
+  const response = await tools.order_drink.execute({ drinkId: 'cold-brew', quantity: 2 });
+  assert.equal(response.structuredContent.submitted, false);
+  assert.equal(nodes['order-items'].children[0].textContent, '2 × Cold Brew');
+  buttons[2].listeners.click();
+  assert.equal(nodes['order-items'].children[0].textContent, '3 × Cold Brew');
+  for (const input of [null, {}, { drinkId: '<script>' }, { drinkId: 'cold-brew', quantity: 0 }, { drinkId: 'cold-brew', quantity: 1.5 }, { drinkId: 'cold-brew', quantity: '2' }, { drinkId: 'cold-brew', quantity: 8 }]) {
+    assert.equal((await tools.order_drink.execute(input)).isError, true);
+    assert.equal(nodes['order-items'].children[0].textContent, '3 × Cold Brew');
+  }
+  nodes['order-drink'].value = 'maple-oat-latte';
+  nodes['order-quantity'].value = '2';
+  let prevented = false;
+  nodes['order-form'].listeners.submit({ preventDefault() { prevented = true; } });
+  assert.equal(prevented, true);
+  assert.equal(nodes['order-items'].children[1].textContent, '2 × Maple Oat Latte');
+  nodes['clear-order'].listeners.click();
+  assert.equal(nodes['order-items'].children.length, 0);
+  assert.equal(nodes['order-empty'].hidden, false);
+  assert.equal(nodes['clear-order'].disabled, true);
+});
+
+test('highlight changes focus and selection, and rejects unknown drinks', async () => {
+  const { tools, cards } = setup();
+  await tools.highlight_drink.execute({ drinkId: 'cold-brew' });
+  assert.equal(cards[2].focused, true);
+  assert.equal(cards[2].scrolled, true);
+  await tools.highlight_drink.execute({ drinkId: 'maple-oat-latte' });
+  assert.equal(cards[2].classList['is-highlighted'], false);
+  assert.equal(cards[0].classList['is-highlighted'], true);
+  assert.equal((await tools.highlight_drink.execute({ drinkId: 'unknown' })).isError, true);
+});
+
+test('manual ordering works without WebMCP', () => {
+  const { buttons, nodes, tools } = setup('unsupported');
+  assert.equal(Object.keys(tools).length, 0);
+  assert.equal(nodes['order-drink'].children.length, 3);
+  buttons[0].listeners.click();
+  assert.equal(nodes['order-items'].children[0].textContent, '1 × Maple Oat Latte');
+});
diff --git a/webmcp.js b/webmcp.js
new file mode 100644
index 0000000..67ede1c
--- /dev/null
+++ b/webmcp.js
@@ -0,0 +1,140 @@
+(() => {
+  'use strict';
+
+  // Read the displayed menu so browser agents and people see the same drinks.
+  const cards = [...document.querySelectorAll('[data-drink-id]')];
+  const menu = cards.map(card => ({
+    id: card.dataset.drinkId,
+    name: card.querySelector('h3').textContent.trim(),
+    description: card.querySelector('p').textContent.trim(),
+    detailsUrl: card.querySelector('a').getAttribute('href'),
+  }));
+  const select = document.getElementById('order-drink');
+  const quantityInput = document.getElementById('order-quantity');
+  const status = document.getElementById('order-status');
+  const orderItems = document.getElementById('order-items');
+  const empty = document.getElementById('order-empty');
+  const clear = document.getElementById('clear-order');
+  const order = new Map();
+
+  for (const drink of menu) {
+    const option = document.createElement('option');
+    option.value = drink.id;
+    option.textContent = drink.name;
+    select.append(option);
+  }
+
+  function result(data, isError = false) {
+    return { content: [{ type: 'text', text: JSON.stringify(data) }], structuredContent: data, isError };
+  }
+
+  function error(message) {
+    return result({ error: message }, true);
+  }
+
+  function getOrder() {
+    return [...order].map(([id, quantity]) => ({
+      drinkId: id, name: menu.find(drink => drink.id === id).name, quantity,
+    }));
+  }
+
+  function renderOrder() {
+    orderItems.replaceChildren();
+    for (const item of getOrder()) {
+      const li = document.createElement('li');
+      li.textContent = `${item.quantity} × ${item.name}`;
+      orderItems.append(li);
+    }
+    empty.hidden = order.size > 0;
+    clear.disabled = order.size === 0;
+  }
+
+  function addDrink(input = {}) {
+    if (!input || typeof input !== 'object' || Array.isArray(input)) return error('Provide a drinkId and optional quantity.');
+    const { drinkId, quantity = 1 } = input;
+    const drink = menu.find(item => item.id === drinkId);
+    if (!drink) return error('Unknown drinkId. Use get_seasonal_menu to find available drinks.');
+    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) return error('Quantity must be an integer from 1 to 10.');
+    const total = (order.get(drinkId) || 0) + quantity;
+    if (total > 10) return error('A draft can contain at most 10 of each drink. Clear the order to start again.');
+    order.set(drinkId, total);
+    select.value = drinkId;
+    quantityInput.value = '1';
+    renderOrder();
+    status.textContent = `Added ${quantity} × ${drink.name} to your local order draft.`;
+    document.getElementById('order-panel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+    return result({ status: 'draft', message: status.textContent, items: getOrder(), submitted: false });
+  }
+
+  function highlightDrink(input = {}) {
+    if (!input || typeof input !== 'object' || Array.isArray(input)) return error('Provide a drinkId.');
+    const index = menu.findIndex(drink => drink.id === input.drinkId);
+    if (index < 0) return error('Unknown drinkId. Use get_seasonal_menu to find available drinks.');
+    cards.forEach((card, i) => card.classList.toggle('is-highlighted', i === index));
+    cards[index].focus({ preventScroll: true });
+    cards[index].scrollIntoView({ behavior: 'smooth', block: 'center' });
+    status.textContent = `Selected ${menu[index].name} in Seasonal Favorites.`;
+    return result({ highlightedDrink: menu[index] });
+  }
+
+  document.getElementById('order-form').addEventListener('submit', event => {
+    event.preventDefault();
+    const response = addDrink({ drinkId: select.value, quantity: Number(quantityInput.value) });
+    if (response.isError) status.textContent = response.structuredContent.error;
+  });
+  document.querySelectorAll('[data-order-drink]').forEach(button => {
+    button.addEventListener('click', () => {
+      const response = addDrink({ drinkId: button.dataset.orderDrink });
+      if (response.isError) status.textContent = response.structuredContent.error;
+    });
+  });
+  clear.addEventListener('click', () => {
+    order.clear();
+    renderOrder();
+    status.textContent = 'Your order draft has been cleared.';
+  });
+
+  const drinkIdSchema = { type: 'string', enum: menu.map(drink => drink.id) };
+  const tools = [
+    {
+      name: 'get_seasonal_menu',
+      description: 'Read the Seasonal Favorites drinks displayed on the Daily Grind homepage, including IDs, descriptions, and details links.',
+      inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+      execute: async () => result({ title: 'Seasonal Favorites', drinks: menu }),
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'order_drink',
+      description: 'Add a seasonal drink to the visible local order draft and show the order panel. Repeated calls add quantities. Does not submit an order or charge money.',
+      inputSchema: {
+        type: 'object',
+        properties: { drinkId: drinkIdSchema, quantity: { type: 'integer', minimum: 1, maximum: 10, default: 1 } },
+        required: ['drinkId'], additionalProperties: false,
+      },
+      execute: async input => addDrink(input),
+      annotations: { readOnlyHint: false },
+    },
+    {
+      name: 'highlight_drink',
+      description: 'Highlight and focus a seasonal drink card and scroll it into view on the homepage.',
+      inputSchema: { type: 'object', properties: { drinkId: drinkIdSchema }, required: ['drinkId'], additionalProperties: false },
+      execute: async input => highlightDrink(input),
+      annotations: { readOnlyHint: false },
+    },
+  ];
+
+  // Prefer the current API while supporting early-preview browsers.
+  const modelContext = document.modelContext ?? navigator.modelContext;
+  if (typeof modelContext?.registerTool === 'function') {
+    for (const tool of tools) {
+      try {
+        // Older implementations register synchronously; newer ones return promises.
+        Promise.resolve(modelContext.registerTool(tool)).catch(error => {
+          console.warn(`Could not register WebMCP tool ${tool.name}:`, error);
+        });
+      } catch (error) {
+        console.warn(`Could not register WebMCP tool ${tool.name}:`, error);
+      }
+    }
+  }
+})();
