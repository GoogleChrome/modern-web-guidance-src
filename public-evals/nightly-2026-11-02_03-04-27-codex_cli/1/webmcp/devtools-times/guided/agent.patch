+export interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export const apiUrl = (path: string) => `${import.meta.env.BASE_URL}api/${path}`;
+
+export async function requestJson(path: string, options: RequestInit = {}) {
+  const response = await fetch(apiUrl(path), options);
+  const text = await response.text();
+  let data;
+  try { data = JSON.parse(text); } catch { data = null; }
+  if (!response.ok) {
+    throw new Error(data?.message || data?.error || `Request failed (${response.status} ${response.statusText}).`);
+  }
+  if (data === null) throw new Error('The API did not return JSON.');
+  return data;
+}
+
+export async function searchArticles(query: string, signal?: AbortSignal) {
+  if (typeof query !== 'string' || !query.trim()) throw new Error('Enter a search query.');
+  const articles: ArticleSummary[] = await requestJson('articles.json', { signal });
+  const term = query.trim().toLowerCase();
+  return articles.filter(article => `${article.title}\n${article.summary}`.toLowerCase().includes(term));
+}
+
+export async function getReadingList(signal?: AbortSignal): Promise<{ readingList: string[] }> {
+  return requestJson('reading-list.json', { signal });
+}
+
+export async function updateReadingList(slug: string, action: 'add' | 'remove' | 'toggle', signal?: AbortSignal) {
+  const data = await requestJson('reading-list.json', {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug, action }), signal,
+  });
+  signal?.throwIfAborted();
+  window.dispatchEvent(new CustomEvent('reading-list-changed', { detail: data.readingList }));
+  return data;
+}
+
+export interface AgentSubmitEvent extends SubmitEvent {
+  agentInvoked?: boolean;
+  respondWith?: (response: Promise<unknown>) => void;
+}
+
+export function respondToAgent(event: Event, result: Promise<unknown>) {
+  const submit = event as AgentSubmitEvent;
+  if (submit.agentInvoked && typeof submit.respondWith === 'function') {
+    submit.respondWith(result.catch(error => ({ error: error instanceof Error ? error.message : String(error) })));
+  }
+}
