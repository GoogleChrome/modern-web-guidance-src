+  inputSchema: Record<string, unknown>;
+  execute: (input: Input, options: { signal: AbortSignal }) => unknown;
+  annotations?: { readOnlyHint: boolean };
+};
+type ModelContext = {
+  registerTool: (tool: Tool, options: { signal: AbortSignal }) => Promise<void> | void;
+};
+
+const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+let lifetime: AbortController | undefined;
+
+async function registerTools() {
+  lifetime?.abort();
+  lifetime = new AbortController();
+  const registrationSignal = lifetime.signal;
+  // Keep browser API access in the Astro client script, outside React islands.
+  const context = (document as Document & { modelContext?: ModelContext }).modelContext;
+  if (!context?.registerTool) return;
+
+  const tools: Tool[] = [
+    {
+      name: 'search_articles',
+      description: 'Search The DevTools Times article titles and summaries and display matching articles.',
+      inputSchema: {
+        type: 'object', properties: { query: { type: 'string', minLength: 1, description: 'Words to find in article titles or summaries.' } },
+        required: ['query'], additionalProperties: false,
+      },
+      async execute({ query }, { signal }) {
+        if (typeof query !== 'string' || !query.trim()) return { error: 'Enter a non-empty search query.' };
+        const articles = await searchArticles(query, signal);
+        signal.throwIfAborted();
+        window.dispatchEvent(new CustomEvent('article-search', { detail: { query, articles } }));
+        return { query, articles: articles.map(article => ({ ...article, url: `${import.meta.env.BASE_URL}articles/${article.slug}` })) };
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'get_reading_list', description: 'Retrieve and display the articles saved in the current session reading list.',
+      inputSchema: emptySchema,
+      async execute(_input, { signal }) {
+        const data = await getReadingList(signal);
+        signal.throwIfAborted();
+        window.dispatchEvent(new CustomEvent('open-reading-list', { detail: data.readingList }));
+        return data;
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'set_article_saved', description: 'Save an article to, or remove it from, the current session reading list.',
+      inputSchema: {
+        type: 'object', properties: {
+          slug: { type: 'string', minLength: 1, description: 'Article slug returned by article search.' },
+          saved: { type: 'boolean', description: 'Whether the article should be in the reading list.' },
+        }, required: ['slug', 'saved'], additionalProperties: false,
+      },
+      async execute({ slug, saved }, { signal }) {
+        if (typeof slug !== 'string' || !slug.trim() || typeof saved !== 'boolean') return { error: 'Provide an article slug and a boolean saved value.' };
+        return updateReadingList(slug, saved ? 'add' : 'remove', signal);
+      },
+      annotations: { readOnlyHint: false },
+    },
+  ];
+
+  const slug = document.querySelector<HTMLElement>('[data-article-slug]')?.dataset.articleSlug;
+  const utilities: Record<string, { name: string; endpoint: string; description: string }> = {
+    'coffee-alchemy': { name: 'get_coffee_brew', endpoint: 'coffee-brew', description: 'Request the coffee article brewing statistics and report the API status.' },
+    'silent-architects': { name: 'get_plant_stats', endpoint: 'plant-stats', description: 'Request plant statistics for the current article and report the API status.' },
+    'coastal-pulse': { name: 'get_tide_levels', endpoint: 'tide-levels', description: 'Request tide levels for the coastal article and report redirects or API failures.' },
+    'super-bowl-lx': { name: 'get_article_popularity', endpoint: `article-popularity?id=${encodeURIComponent(slug ?? '')}`, description: 'Retrieve popularity statistics for the current article.' },
+  };
+  const utility = slug ? utilities[slug] : undefined;
+  if (utility) tools.push({
+    name: utility.name, description: utility.description, inputSchema: emptySchema,
+    async execute(_input, { signal }) {
+      const response = await fetch(apiUrl(utility.endpoint), { signal });
+      const text = await response.text();
+      let data = null;
+      try { data = JSON.parse(text); } catch { /* Some diagnostic endpoints return HTML or no body. */ }
+      return {
+        ok: response.ok, status: response.status, redirected: response.redirected, url: response.url, data,
+        ...(!response.ok ? { error: data?.message || data?.error || `Request failed (${response.status} ${response.statusText}).` } : {}),
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  for (const tool of tools) {
+    const execute = tool.execute;
+    tool.execute = async (input, options) => {
+      const signal = AbortSignal.any([options.signal, registrationSignal]);
+      try {
+        signal.throwIfAborted();
+        return await execute(input ?? {}, { signal });
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return { error: error instanceof Error ? error.message : String(error) };
+      }
+    };
+    try {
+      await context.registerTool(tool, { signal: registrationSignal });
+    } catch (error) {
+      if (!registrationSignal.aborted) console.warn(`WebMCP could not register ${tool.name}:`, error);
+    }
+    if (registrationSignal.aborted) break;
+  }
+}
+
+document.addEventListener('astro:page-load', registerTools);
+document.addEventListener('astro:before-swap', () => lifetime?.abort());
+window.addEventListener('pagehide', () => lifetime?.abort());
+window.addEventListener('pageshow', event => { if (event.persisted) void registerTools(); });
