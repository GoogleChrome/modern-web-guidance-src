diff --git a/src/lib/article-tools.ts b/src/lib/article-tools.ts
new file mode 100644
index 0000000..7df0910
--- /dev/null
+++ b/src/lib/article-tools.ts
@@ -0,0 +1,70 @@
+import { getArticles, getReadingList, searchArticles, toggleReadingList } from './articles';
+import { registerTools, requiredString } from './webmcp';
+
+const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+const stringSchema = (name: string, description: string) => ({
+  type: 'object', properties: { [name]: { type: 'string', minLength: 1, description } },
+  required: [name], additionalProperties: false,
+});
+
+export function registerArticleTools() {
+  return registerTools([
+    {
+      name: 'search_articles', description: 'Search The DevTools Times by article title and summary.',
+      inputSchema: stringSchema('query', 'Words to find in article titles and summaries.'),
+      annotations: { readOnlyHint: true },
+      async execute(input, { signal }) {
+        return { articles: searchArticles(await getArticles(signal), requiredString(input, 'query')) };
+      },
+    },
+    {
+      name: 'get_article', description: 'Look up article metadata and its reading URL.',
+      inputSchema: stringSchema('slug', 'Article identifier returned by search_articles.'),
+      annotations: { readOnlyHint: true },
+      async execute(input, { signal }) {
+        const slug = requiredString(input, 'slug');
+        const article = (await getArticles(signal)).find(article => article.slug === slug);
+        if (!article) throw new Error('Article not found.');
+        return { ...article, url: new URL(`${import.meta.env.BASE_URL}articles/${article.slug}`, location.origin).href };
+      },
+    },
+    {
+      name: 'get_reading_list', description: 'List articles saved in the current browser session.',
+      inputSchema: emptySchema, annotations: { readOnlyHint: true },
+      async execute(_input, { signal }) {
+        const [articles, slugs] = await Promise.all([getArticles(signal), getReadingList(signal)]);
+        return { articles: articles.filter(article => slugs.includes(article.slug)) };
+      },
+    },
+    {
+      name: 'toggle_reading_list', description: 'Toggle an article in the current session reading list: saved articles are removed and unsaved articles are added.',
+      inputSchema: stringSchema('slug', 'Article identifier returned by search_articles.'),
+      annotations: { readOnlyHint: false },
+      async execute(input, { signal }) {
+        const slug = requiredString(input, 'slug');
+        if (!(await getArticles(signal)).some(article => article.slug === slug)) throw new Error('Article not found.');
+        const readingList = await toggleReadingList(slug, signal);
+        return { readingList, saved: readingList.includes(slug) };
+      },
+    },
+    ...[
+      ['get_tide_levels', 'tide-levels', 'Request the coastal article tide utility. Returns HTTP status, redirects, and response data, including failures.'],
+      ['get_coffee_brew', 'coffee-brew', 'Request the coffee article brewing utility. Returns HTTP status and response data, including failures.'],
+      ['get_plant_stats', 'plant-stats', 'Request the plant article statistics utility using current session cookies. Returns HTTP status and response data, including failures.'],
+      ['get_article_popularity', 'article-popularity', 'Request article popularity statistics. Returns HTTP status and response data, including failures.'],
+    ].map(([name, endpoint, description]) => ({
+      name, description,
+      inputSchema: endpoint === 'article-popularity' ? stringSchema('id', 'Article identifier to retrieve popularity for.') : emptySchema,
+      annotations: { readOnlyHint: true },
+      async execute(input: Record<string, unknown>, { signal }: { signal?: AbortSignal }) {
+        const url = new URL(`${import.meta.env.BASE_URL}api/${endpoint}`, location.origin);
+        if (endpoint === 'article-popularity') url.searchParams.set('id', requiredString(input, 'id'));
+        const response = await fetch(url, { signal });
+        const body = await response.text();
+        let data: unknown = body;
+        try { data = JSON.parse(body); } catch { /* Redirects may end on an HTML error page. */ }
+        return { ok: response.ok, status: response.status, redirected: response.redirected, url: response.url, data };
+      },
+    })),
+  ]);
+}
diff --git a/src/lib/articles.ts b/src/lib/articles.ts
new file mode 100644
index 0000000..ab3631f
--- /dev/null
+++ b/src/lib/articles.ts
@@ -0,0 +1,37 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export async function getArticles(signal?: AbortSignal): Promise<Article[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/articles.json`, { signal });
+  if (!response.ok) throw new Error(`Could not load articles (${response.status}).`);
+  return response.json();
+}
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  ) : [];
+}
+
+export async function getReadingList(signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, { signal });
+  if (!response.ok) throw new Error(`Could not load reading list (${response.status}).`);
+  const data = await response.json();
+  return data.readingList;
+}
+
+export async function toggleReadingList(slug: string, signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }), signal,
+  });
+  if (!response.ok) throw new Error(`Could not update reading list (${response.status}).`);
+  const data = await response.json();
+  window.dispatchEvent(new CustomEvent('reading-list:changed', { detail: data.readingList }));
+  return data.readingList;
+}
diff --git a/src/lib/webmcp.ts b/src/lib/webmcp.ts
new file mode 100644
index 0000000..46c83dc
--- /dev/null
+++ b/src/lib/webmcp.ts
@@ -0,0 +1,55 @@
+// Local types keep the experimental API optional without requiring a polyfill.
+export interface AgentSubmitEvent extends SubmitEvent {
+  agentInvoked?: boolean;
+  respondWith?: (response: Promise<unknown>) => void;
+}
+
+interface Tool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations?: { readOnlyHint: boolean };
+  execute: (input: Record<string, unknown>, options: { signal?: AbortSignal }) => unknown;
+}
+interface ModelContext extends EventTarget {
+  registerTool(tool: Tool, options?: { signal: AbortSignal }): void | Promise<void>;
+  unregisterTool?: (name: string) => void;
+}
+
+export function modelContext(): ModelContext | undefined {
+  // navigator is retained as a fallback for early WebMCP implementations.
+  return (document as Document & { modelContext?: ModelContext }).modelContext
+    ?? (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+}
+
+export function registerTools(tools: Tool[]) {
+  const context = modelContext();
+  if (!context) return () => {};
+  const controller = new AbortController();
+  for (const tool of tools) {
+    try {
+      Promise.resolve(context.registerTool(tool, { signal: controller.signal }))
+        .catch(error => console.warn(`WebMCP: could not register ${tool.name}`, error));
+    } catch (error) {
+      console.warn(`WebMCP: could not register ${tool.name}`, error);
+    }
+  }
+  return () => {
+    controller.abort();
+    // Older implementations use explicit unregistration instead of signals.
+    if (context.unregisterTool) {
+      for (const tool of tools) context.unregisterTool(tool.name);
+    }
+  };
+}
+
+export function respondToAgent(event: Event, result: Promise<unknown>) {
+  const submit = event as AgentSubmitEvent;
+  if (submit.agentInvoked && submit.respondWith) submit.respondWith(result);
+}
+
+export function requiredString(input: Record<string, unknown>, key: string) {
+  const value = input[key];
+  if (typeof value !== 'string' || !value.trim()) throw new Error(`${key} must be a non-empty string.`);
+  return value.trim();
+}
