diff --git a/tests/webmcp.test.mjs b/tests/webmcp.test.mjs
new file mode 100644
index 0000000..4818e0d
--- /dev/null
+++ b/tests/webmcp.test.mjs
@@ -0,0 +1,45 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { registerTools, respondToAgent, requiredString } from '../src/lib/webmcp.ts';
+
+test('unsupported browsers skip registration', () => {
+  globalThis.document = {};
+  assert.doesNotThrow(() => registerTools([])());
+});
+
+test('tools register with a lifetime signal and clean up', () => {
+  let received;
+  globalThis.document = { modelContext: {
+    registerTool(tool, options) { received = { tool, options }; },
+  } };
+  const tool = { name: 'example', execute() { return 'done'; } };
+  const cleanup = registerTools([tool]);
+  assert.equal(received.tool, tool);
+  assert.equal(received.options.signal.aborted, false);
+  cleanup();
+  assert.equal(received.options.signal.aborted, true);
+});
+
+test('early implementations unregister explicitly', () => {
+  const removed = [];
+  globalThis.document = { modelContext: {
+    registerTool() {}, unregisterTool(name) { removed.push(name); },
+  } };
+  registerTools([{ name: 'example' }])();
+  assert.deepEqual(removed, ['example']);
+});
+
+test('agent form submission receives the operation result', async () => {
+  let result;
+  const promise = Promise.resolve({ articles: [] });
+  respondToAgent({ agentInvoked: true, respondWith(value) { result = value; } }, promise);
+  assert.deepEqual(await result, { articles: [] });
+  assert.doesNotThrow(() => respondToAgent({}, promise));
+});
+
+test('tool arguments are validated at execution time', () => {
+  for (const query of [undefined, null, 12, '', '  ']) {
+    assert.throws(() => requiredString({ query }, 'query'));
+  }
+  assert.equal(requiredString({ query: '  coffee  ' }, 'query'), 'coffee');
+});
