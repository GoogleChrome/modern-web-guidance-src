     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingList = document.querySelector('.mailing-list');
+    const email = document.getElementById('mailing-list-email');
+    const emailErrorText = document.getElementById('mailing-list-error-text');
+    const signupStatus = mailingList.querySelector('.mailing-list-status');
+
+    function syncEmailError() {
+      emailErrorText.textContent = email.validity.valueMissing
+        ? 'Please enter your email address.'
+        : 'Please enter a valid email address.';
+      if (email.matches(':user-invalid')) {
+        email.setAttribute('aria-invalid', 'true');
+      } else {
+        email.removeAttribute('aria-invalid');
+      }
+    }
+
+    // Wait for the browser to update its user-interaction validation state.
+    email.addEventListener('blur', () => requestAnimationFrame(syncEmailError));
+    email.addEventListener('input', () => {
+      signupStatus.textContent = '';
+      syncEmailError();
+    });
+    email.addEventListener('invalid', () => requestAnimationFrame(syncEmailError));
+    mailingList.addEventListener('reset', () => requestAnimationFrame(() => {
+      email.removeAttribute('aria-invalid');
+      signupStatus.textContent = '';
+    }));
+    mailingList.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Connect a mailing-list provider before accepting subscriptions.
+      signupStatus.textContent = 'Mailing list signup is not available yet. Please try again later.';
+    });
+  </script>
+
 </body>
 
 </html>
