+  <script>
+    const strengthSlider = document.getElementById('brew-strength');
+    const strengthValue = document.getElementById('strength-value');
+    const strengthNames = ['Mellow', 'Smooth', 'Balanced', 'Bold', 'Extra bold'];
+
+    function updateStrength() {
+      const value = Number(strengthSlider.value);
+      const min = Number(strengthSlider.min);
+      const max = Number(strengthSlider.max);
+      const strength = strengthNames[value - min];
+      strengthSlider.style.setProperty('--strength-progress', `${((value - min) / (max - min)) * 100}%`);
+      strengthSlider.setAttribute('aria-valuetext', `${strength}, ${value} of ${max}`);
+      strengthValue.value = `${strength} · ${value} of ${max}`;
+    }
+
+    strengthSlider.addEventListener('input', updateStrength);
+    // Restore the matching fill and label if the browser restores a saved value.
+    window.addEventListener('pageshow', updateStrength);
+    updateStrength();
+  </script>
+
