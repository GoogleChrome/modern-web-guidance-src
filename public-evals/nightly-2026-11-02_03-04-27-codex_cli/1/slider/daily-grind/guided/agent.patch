+  <script>
+    const strengthSlider = document.getElementById('brew-strength');
+    const strengthOutput = document.getElementById('brew-strength-value');
+    const strengthLabels = ['Mild', 'Smooth', 'Balanced', 'Bold', 'Extra bold'];
+
+    function syncStrength() {
+      const value = strengthSlider.valueAsNumber;
+      const min = Number(strengthSlider.min);
+      const max = Number(strengthSlider.max);
+      const label = strengthLabels[value - min];
+
+      // Compute the fill without relying on newer CSS attr() or progress() support.
+      strengthSlider.style.setProperty('--slider-progress', `${(value - min) / (max - min) * 100}%`);
+      strengthSlider.setAttribute('aria-valuetext', `${label}, ${value} of ${max}`);
+      strengthOutput.value = `${label} · ${value} / ${max}`;
+    }
+
+    strengthSlider.addEventListener('input', syncStrength);
+    window.addEventListener('pageshow', syncStrength);
+    syncStrength();
+  </script>
+
