+  <script>
+    const cupForm = document.getElementById('cup-preferences');
+    const cupPreview = document.getElementById('cup-preview');
+
+    function previewCup(data) {
+      const name = String(data.get('name') || '').trim();
+      if (!name) return;
+      const drink = String(data.get('drink') || 'Maple Oat Latte');
+      const notes = String(data.get('notes') || '').trim();
+      cupPreview.textContent = `${name}’s cup: ${drink}${notes ? `\n${notes}` : ''}\nJust a preview — no order has been placed.`;
+    }
+
+    cupForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      previewCup(new FormData(cupForm));
+    });
+
+    // Restore form values and the preview when opening a native GET submission URL.
+    const cupParams = new URLSearchParams(window.location.search);
+    if (cupParams.has('name')) {
+      for (const field of cupForm.elements) {
+        if (field.name && cupParams.has(field.name)) field.value = cupParams.get(field.name);
+      }
+      previewCup(cupParams);
+    }
+  </script>
