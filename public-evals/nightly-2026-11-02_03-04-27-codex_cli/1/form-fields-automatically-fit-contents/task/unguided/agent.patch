+  <script>
+    const form = document.querySelector('#preference-form');
+    const controls = [...form.querySelectorAll('.content-control')];
+    const status = document.querySelector('#form-status');
+    const measure = document.createElement('canvas').getContext('2d');
+
+    function fitControl(control) {
+      const style = getComputedStyle(control);
+      measure.font = style.font;
+      const content = control.tagName === 'SELECT'
+        ? control.selectedOptions[0].text
+        : control.value || control.placeholder || ' ';
+      const textWidth = Math.max(...content.split('\n').map(line => measure.measureText(line).width));
+      const extra = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight)
+        + parseFloat(style.borderLeftWidth) + parseFloat(style.borderRightWidth);
+      control.style.width = `${Math.ceil(textWidth + extra + 3)}px`;
+      if (control.tagName === 'TEXTAREA') {
+        control.style.height = 'auto';
+        control.style.height = `${control.scrollHeight + parseFloat(style.borderTopWidth) + parseFloat(style.borderBottomWidth)}px`;
+      }
+    }
+
+    function fitAll() {
+      controls.forEach(fitControl);
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-preferences'));
+      if (saved && typeof saved === 'object') {
+        controls.forEach(control => {
+          if (typeof saved[control.name] === 'string' &&
+              (control.tagName !== 'SELECT' || [...control.options].some(option => option.value === saved[control.name]))) {
+            control.value = saved[control.name];
+          }
+        });
+      }
+    } catch {
+      // The form also works when browser storage is unavailable.
+    }
+
+    form.addEventListener('input', event => {
+      if (controls.includes(event.target)) fitControl(event.target);
+      status.textContent = 'Unsaved changes. Save to keep them in this browser.';
+    });
+    form.addEventListener('change', fitAll);
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      try {
+        localStorage.setItem('daily-grind-preferences', JSON.stringify(Object.fromEntries(new FormData(form))));
+        status.textContent = 'Your preferences are saved. Here’s to your next cup.';
+      } catch {
+        status.textContent = 'This browser could not save your preferences. Please try again with browser storage enabled.';
+      }
+    });
+    window.addEventListener('resize', fitAll);
+    fitAll();
+    document.fonts.ready.then(fitAll);
+  </script>
