+  <script>
+    const orderForm = document.querySelector('#coffee-order');
+    const strength = document.querySelector('#strength');
+    const summary = document.querySelector('#order-summary');
+
+    strength.addEventListener('input', () => {
+      document.querySelector('#strength-value').value = strength.value;
+    });
+
+    orderForm.addEventListener('input', () => {
+      summary.value = '';
+    });
+
+    orderForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const order = new FormData(orderForm);
+      const extras = order.getAll('extras');
+      const notes = order.get('notes').trim();
+      summary.value = `${order.get('size')} ${order.get('drink')} with ${order.get('milk').toLowerCase()}, ` +
+        `strength ${order.get('strength')}/5. ` +
+        (extras.length ? `Extras: ${extras.join(', ')}. ` : '') +
+        `Pickup preference: ${order.get('pickup-date')} at ${order.get('pickup-time')}. ` +
+        `Cup label color: ${order.get('cup-color')}.` +
+        (notes ? ` Barista notes: ${notes}` : '');
+    });
+  </script>
