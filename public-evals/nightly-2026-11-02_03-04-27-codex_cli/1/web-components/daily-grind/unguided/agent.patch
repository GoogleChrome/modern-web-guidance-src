+# The Daily Grind
+
+A static homepage using native Web Components. No build step or runtime dependency is required. Load `components/daily-grind.js` as a module to register the components.
+
+- `<coffee-card>` accepts `heading`, `description`, and `action` slots. Supply a heading at the correct document level and a native link with a distinct accessible name.
+- `<grind-hero>` uses the same slots. Use an `h1` for the homepage heading. The existing stock background is decorative; replace it through `--hero-image: url(...)`.
+- `<grind-navigation>` accepts a `brand` slot and native links in its default slot. Set `aria-label` before connecting it to customize the landmark name. Below 761px, a native disclosure button controls the links; Escape closes the disclosure and returns focus. Viewport listeners are removed when disconnected.
+
+Components encapsulate their styles in Shadow DOM and inherit typography and the `--primary`, `--secondary`, `--accent`, and `--text` theme variables. The card and hero also expose `card` and `hero` CSS parts. Slotted content remains in the document and usable without JavaScript. Keep the supplied content slots populated; the components do not invent missing content.
+
+Install development dependencies with `pnpm install` and run `pnpm test` for Node-based DOM checks of upgrade, semantics, disclosure behavior, viewport changes, and reconnection. These checks do not launch a server or a browser and do not verify visual rendering or screen reader output.
diff --git a/components/daily-grind.js b/components/daily-grind.js
new file mode 100644
index 0000000..9cd8ad8
--- /dev/null
+++ b/components/daily-grind.js
@@ -0,0 +1,127 @@
+// Styles live in each shadow root; the page supplies only theme variables.
+const baseStyles = `
+  :host { display: block; color: var(--text, #3e2723); font: inherit; }
+  *, *::before, *::after { box-sizing: border-box; }
+  ::slotted(*) { box-sizing: border-box; }
+  ::slotted(a:focus-visible), button:focus-visible {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 4px;
+  }
+`;
+const actionStyles = `
+  ::slotted([slot="action"]) {
+    display: inline-block; background: var(--primary, #4e342e); color: white;
+    padding: 10px 20px; text-decoration: none; border-radius: 5px;
+    margin-top: 15px; line-height: 1.6;
+  }
+  ::slotted([slot="action"]:hover) { background: #3e2723; }
+`;
+
+class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        ${baseStyles}
+        :host { height: 100%; }
+        article { height: 100%; background: white; padding: 20px; border-radius: 8px;
+          box-shadow: 0 2px 5px rgb(0 0 0 / 10%); text-align: center;
+          display: flex; flex-direction: column; align-items: center; }
+        ::slotted([slot="heading"]) { margin: 0 0 10px; color: var(--primary, #4e342e); }
+        ::slotted([slot="description"]) { margin: 0; flex: 1; }
+        ${actionStyles}
+      </style>
+      <article part="card">
+        <slot name="heading"></slot>
+        <slot name="description"></slot>
+        <slot name="action"></slot>
+      </article>`;
+  }
+}
+
+class GrindHero extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        ${baseStyles}
+        header { min-height: 60vh; padding: 40px 20px; display: flex; flex-direction: column;
+          justify-content: center; align-items: center; color: white; text-align: center;
+          background: linear-gradient(rgb(0 0 0 / 50%), rgb(0 0 0 / 50%)),
+            var(--hero-image, url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80')) center / cover; }
+        ::slotted([slot="heading"]) { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.2; margin: 0 0 1rem; }
+        ::slotted([slot="description"]) { margin: 0; }
+        ${actionStyles}
+      </style>
+      <header part="hero">
+        <slot name="heading"></slot>
+        <slot name="description"></slot>
+        <slot name="action"></slot>
+      </header>`;
+  }
+}
+
+class GrindNavigation extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        ${baseStyles}
+        nav { background: var(--primary, #4e342e); color: white; padding: 1rem 5%;
+          display: flex; justify-content: space-between; align-items: center; gap: 20px; }
+        ::slotted([slot="brand"]) { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+        .links { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; }
+        ::slotted(a) { color: white; text-decoration: none; font-size: .9rem; padding: 8px 0; }
+        ::slotted(a:hover) { color: var(--accent, #ffab40); }
+        ::slotted(.logout-link) { border: 1px solid var(--accent, #ffab40); padding: 5px 12px; border-radius: 4px; }
+        button { font: inherit; color: white; background: transparent;
+          border: 1px solid var(--accent, #ffab40); border-radius: 4px; padding: 10px 12px; cursor: pointer; }
+        button[hidden], .links[hidden] { display: none; }
+        @media (max-width: 760px) {
+          nav { flex-wrap: wrap; }
+          ::slotted([slot="brand"]) { font-size: 1.2rem; }
+          .links { width: 100%; flex-direction: column; align-items: stretch; }
+        }
+      </style>
+      <nav>
+        <slot name="brand"></slot>
+        <button type="button" aria-expanded="false" aria-controls="navigation-links" hidden>Menu</button>
+        <div class="links" id="navigation-links" hidden><slot></slot></div>
+      </nav>`;
+    this.button = this.shadowRoot.querySelector('button');
+    this.links = this.shadowRoot.querySelector('.links');
+    this.media = window.matchMedia('(max-width: 760px)');
+    this.close = () => this.setOpen(false);
+    this.button.addEventListener('click', () => this.setOpen(this.button.getAttribute('aria-expanded') !== 'true'));
+    this.addEventListener('click', event => {
+      if (event.target.closest('a')) this.close();
+    });
+    this.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && this.button.getAttribute('aria-expanded') === 'true') {
+        this.close();
+        this.button.focus();
+      }
+    });
+  }
+
+  connectedCallback() {
+    this.shadowRoot.querySelector('nav').setAttribute('aria-label', this.getAttribute('aria-label') || 'Main navigation');
+    this.media.addEventListener('change', this.close);
+    this.close();
+  }
+
+  disconnectedCallback() {
+    this.media.removeEventListener('change', this.close);
+  }
+
+  setOpen(open) {
+    this.button.hidden = !this.media.matches;
+    this.button.setAttribute('aria-expanded', String(open));
+    // Desktop links must be exposed to accessibility APIs as well as visible.
+    this.links.hidden = this.media.matches && !open;
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
+customElements.define('grind-hero', GrindHero);
+customElements.define('grind-navigation', GrindNavigation);
