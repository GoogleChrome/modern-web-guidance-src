@@ -0,0 +1,32 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+* { box-sizing: border-box; }
+body {
+  margin: 0;
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background: var(--light);
+}
+h1, h2, h3, p { margin: 0; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid currentColor; outline-offset: 4px; }
+.skip-link { position: fixed; top: -100px; left: 1rem; z-index: 2000; padding: .75rem; background: white; }
+.skip-link:focus { top: 1rem; }
+grind-navigation { display: block; position: sticky; top: 0; z-index: 1000; }
+grind-hero, coffee-card { display: block; }
+.container { max-width: 1100px; margin: 40px auto; padding: 0 20px; scroll-margin-top: 6rem; }
+h2 { text-align: center; }
+.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 20px; margin-top: 20px; }
+footer { background: var(--secondary); text-align: center; padding: 40px 20px; margin-top: 40px; }
+.footer-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 20px; margin-bottom: 20px; }
+.footer-links a { font-size: .85rem; }
+/* Keep content and links usable before upgrade or when JavaScript is unavailable. */
+grind-navigation:not(:defined), grind-hero:not(:defined), coffee-card:not(:defined) { padding: 20px; }
+grind-navigation:not(:defined) { display: flex; flex-wrap: wrap; gap: 20px; background: var(--primary); color: white; }
+grind-hero:not(:defined), coffee-card:not(:defined) { text-align: center; background: var(--secondary); }
diff --git a/tests/components.test.cjs b/tests/components.test.cjs
new file mode 100644
index 0000000..9000a75
--- /dev/null
+++ b/tests/components.test.cjs
@@ -0,0 +1,110 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { JSDOM } = require('jsdom');
+
+const html = readFileSync('index.html', 'utf8');
+const componentSource = readFileSync('components/daily-grind.js', 'utf8');
+
+function setup(mobile = false) {
+  const dom = new JSDOM(html, { runScripts: 'outside-only', url: 'https://daily-grind.test' });
+  const media = new dom.window.EventTarget();
+  media.matches = mobile;
+  dom.window.matchMedia = () => media;
+  dom.window.eval(componentSource);
+  const nav = dom.window.document.querySelector('grind-navigation');
+  return {
+    dom, document: dom.window.document, nav,
+    button: nav.shadowRoot.querySelector('button'),
+    links: nav.shadowRoot.querySelector('#navigation-links'),
+    resize(matches) {
+      media.matches = matches;
+      media.dispatchEvent(new dom.window.Event('change'));
+    },
+  };
+}
+
+test('all cards upgrade independently and preserve semantic content and destinations', () => {
+  const { dom, document } = setup();
+  try {
+    const cards = [...document.querySelectorAll('coffee-card')];
+    assert.equal(cards.length, 3);
+    assert.equal(new Set(cards.map(card => card.shadowRoot)).size, 3);
+    const names = new Set();
+    for (const card of cards) {
+      assert.ok(card.shadowRoot.querySelector('article'));
+      const heading = card.querySelector('h3');
+      const link = card.querySelector('a');
+      assert.equal(card.shadowRoot.querySelector('slot[name="heading"]').assignedElements()[0], heading);
+      assert.ok(link.getAttribute('aria-label').includes(heading.textContent));
+      assert.match(link.getAttribute('href'), /^\/menu\//);
+      names.add(link.getAttribute('aria-label'));
+    }
+    assert.equal(names.size, 3);
+    const hero = document.querySelector('grind-hero');
+    assert.ok(hero.shadowRoot.querySelector('header'));
+    assert.equal(hero.querySelector('a').getAttribute('href'), '/order-online');
+    assert.equal(document.querySelectorAll('h1').length, 1);
+    assert.ok(document.querySelector(document.querySelector('.skip-link').getAttribute('href')));
+  } finally { dom.window.close(); }
+});
+
+test('desktop navigation exposes links and mobile toggle references its controlled region', () => {
+  const { dom, nav, button, links } = setup();
+  try {
+    assert.equal(links.hidden, false);
+    assert.equal(button.getAttribute('aria-controls'), links.id);
+    assert.equal(nav.shadowRoot.querySelector('nav').getAttribute('aria-label'), 'Main navigation');
+  } finally { dom.window.close(); }
+});
+
+test('mobile disclosure toggles, Escape closes it and restores focus', () => {
+  const { dom, nav, button, links } = setup(true);
+  try {
+    assert.equal(links.hidden, true);
+    button.click();
+    assert.equal(button.getAttribute('aria-expanded'), 'true');
+    assert.equal(links.hidden, false);
+    nav.querySelector('a').focus();
+    nav.querySelector('a').dispatchEvent(new dom.window.KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
+    assert.equal(button.getAttribute('aria-expanded'), 'false');
+    assert.equal(links.hidden, true);
+    assert.equal(nav.shadowRoot.activeElement, button);
+    button.click();
+    button.click();
+    assert.equal(links.hidden, true);
+  } finally { dom.window.close(); }
+});
+
+test('link activation closes the mobile menu without intercepting navigation', () => {
+  const { dom, nav, button, links } = setup(true);
+  try {
+    button.click();
+    // A synthetic Event exercises delegation without requesting a new document.
+    const click = new dom.window.Event('click', { bubbles: true, cancelable: true });
+    nav.querySelector('a').dispatchEvent(click);
+    assert.equal(links.hidden, true);
+    assert.equal(click.defaultPrevented, false);
+  } finally { dom.window.close(); }
+});
+
+test('viewport changes and reconnects reset menu state without losing behavior', () => {
+  const { dom, document, nav, button, links, resize } = setup(true);
+  try {
+    button.click();
+    resize(false);
+    assert.equal(links.hidden, false);
+    assert.equal(button.getAttribute('aria-expanded'), 'false');
+    resize(true);
+    assert.equal(links.hidden, true);
+    nav.remove();
+    resize(false);
+    assert.equal(links.hidden, true, 'detached component removes its viewport listener');
+    document.body.prepend(nav);
+    assert.equal(links.hidden, false);
+    resize(true);
+    button.click();
+    assert.equal(links.hidden, false);
+    assert.equal(button.getAttribute('aria-expanded'), 'true');
+  } finally { dom.window.close(); }
+});
