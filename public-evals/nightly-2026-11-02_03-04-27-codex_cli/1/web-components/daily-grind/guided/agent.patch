@@ -0,0 +1,43 @@
+import { actionStyles, baseStyles, createTemplate } from './shared.js';
+
+const template = createTemplate(`
+  <style>
+    ${baseStyles}
+    :host { height: 100%; }
+    article {
+      height: 100%;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      background: var(--card-background, white);
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgb(0 0 0 / 10%);
+      text-align: center;
+    }
+    ::slotted([slot="heading"]) {
+      margin: 0 0 10px;
+      color: var(--primary, #4e342e);
+    }
+    ::slotted(p) { margin: 0; }
+    .description { flex: 1; }
+    ${actionStyles}
+  </style>
+  <article part="card">
+    <slot name="heading"></slot>
+    <div class="description"><slot></slot></div>
+    <slot name="action"></slot>
+  </article>
+`);
+
+export class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(template.content.cloneNode(true));
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
