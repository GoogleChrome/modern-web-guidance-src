@@ -0,0 +1,32 @@
+// Templates contain only trusted, static markup. Page content stays in slots.
+export function createTemplate(markup) {
+  const template = document.createElement('template');
+  template.innerHTML = markup;
+  return template;
+}
+
+export const baseStyles = `
+  :host { display: block; color: var(--text, #3e2723); }
+  :host([hidden]) { display: none; }
+  *, *::before, *::after { box-sizing: border-box; }
+  a:focus-visible, button:focus-visible, ::slotted(a:focus-visible) {
+    outline: 3px solid var(--_focus-color, var(--primary, #4e342e));
+    outline-offset: 4px;
+  }
+`;
+
+export const actionStyles = `
+  ::slotted(a) {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+  }
+  ::slotted(a:hover) { background: var(--button-hover, #3e2723); }
+  @media (prefers-reduced-motion: no-preference) {
+    ::slotted(a) { transition: background 0.3s; }
+  }
+`;
