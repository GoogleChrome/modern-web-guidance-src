+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: white;
+      text-align: center;
+      padding: 40px 20px;
+    }
+    ::slotted([slot="heading"]) {
+      font-size: clamp(2rem, 6vw, 3rem);
+      line-height: 1.2;
+      margin: 0 0 1rem;
+    }
+    ::slotted(p) { margin: 0; }
+    ${actionStyles}
+  </style>
+  <header part="hero">
+    <slot name="heading"></slot>
+    <slot></slot>
+    <slot name="action"></slot>
+  </header>
+`);
+
+export class CoffeeHero extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(template.content.cloneNode(true));
+  }
+}
+
+if (!customElements.get('coffee-hero')) {
+  customElements.define('coffee-hero', CoffeeHero);
+}
diff --git a/components/grind-navigation.js b/components/grind-navigation.js
new file mode 100644
index 0000000..6d6e663
--- /dev/null
+++ b/components/grind-navigation.js
@@ -0,0 +1,121 @@
+import { baseStyles, createTemplate } from './shared.js';
+
+const template = createTemplate(`
+  <style>
+    ${baseStyles}
+    :host {
+      --_focus-color: var(--accent, #ffab40);
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+    }
+    nav {
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 20px;
+    }
+    ::slotted([slot="brand"]) {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+    .links { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
+    ::slotted(a) {
+      color: white;
+      text-decoration: none;
+      font-size: 0.9rem;
+      padding-block: 6px;
+    }
+    ::slotted(a:hover) { color: var(--accent, #ffab40); }
+    ::slotted([slot="account-action"]) {
+      border: 1px solid var(--accent, #ffab40);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+    button {
+      display: none;
+      font: inherit;
+      color: inherit;
+      background: transparent;
+      border: 1px solid var(--accent, #ffab40);
+      border-radius: 4px;
+      padding: 8px 12px;
+      cursor: pointer;
+    }
+    @media (max-width: 48rem) {
+      nav { flex-wrap: wrap; }
+      button { display: inline-block; }
+      .links { display: none; width: 100%; align-items: stretch; gap: 8px; }
+      button[aria-expanded="true"] + .links { display: flex; flex-direction: column; }
+      ::slotted(a) { padding: 10px 0; }
+    }
+    @media (prefers-reduced-motion: no-preference) {
+      ::slotted(a) { transition: color 0.3s; }
+    }
+  </style>
+  <nav aria-label="Main navigation" part="navigation">
+    <slot name="brand"></slot>
+    <button type="button" aria-expanded="false" aria-controls="navigation-links">Menu</button>
+    <div class="links" id="navigation-links">
+      <slot></slot>
+      <slot name="account-action"></slot>
+    </div>
+  </nav>
+`);
+
+export class GrindNavigation extends HTMLElement {
+  #listeners;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(template.content.cloneNode(true));
+  }
+
+  connectedCallback() {
+    // Reconnecting the same instance must not accumulate event handlers.
+    this.#listeners?.abort();
+    this.#listeners = new AbortController();
+    const { signal } = this.#listeners;
+    const button = this.shadowRoot.querySelector('button');
+    const compactLayout = matchMedia('(max-width: 48rem)');
+
+    compactLayout.addEventListener('change', () => {
+      // Keep a focused link visible when switching to the compact layout.
+      const focusedLink = this.contains(document.activeElement)
+        && document.activeElement instanceof HTMLAnchorElement;
+      button.setAttribute('aria-expanded', String(compactLayout.matches && focusedLink));
+    }, { signal });
+
+    button.addEventListener('click', () => {
+      button.setAttribute('aria-expanded', String(button.getAttribute('aria-expanded') !== 'true'));
+    }, { signal });
+
+    this.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
+        button.setAttribute('aria-expanded', 'false');
+        button.focus();
+        event.preventDefault();
+      }
+    }, { signal });
+
+    this.addEventListener('click', (event) => {
+      // composedPath also supports consumers putting markup inside their links.
+      if (event.composedPath().some((node) => node instanceof HTMLAnchorElement)) {
+        button.setAttribute('aria-expanded', 'false');
+      }
+    }, { signal });
+  }
+
+  disconnectedCallback() {
+    this.#listeners?.abort();
+  }
+}
+
+if (!customElements.get('grind-navigation')) {
+  customElements.define('grind-navigation', GrindNavigation);
+}
