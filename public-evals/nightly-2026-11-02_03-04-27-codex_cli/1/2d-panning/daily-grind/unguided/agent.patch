+  <script>
+    const map = document.getElementById('locations-map');
+    const resetMap = document.getElementById('map-reset');
+    let drag = null;
+
+    function centerMap() {
+      map.scrollLeft = (map.scrollWidth - map.clientWidth) / 2;
+      map.scrollTop = (map.scrollHeight - map.clientHeight) / 2;
+    }
+
+    map.addEventListener('pointerdown', (event) => {
+      if (!event.isPrimary || event.button !== 0 || drag) return;
+      // Leave native scrollbar interaction available along the viewport edges.
+      const bounds = map.getBoundingClientRect();
+      const x = event.clientX - bounds.left - map.clientLeft;
+      const y = event.clientY - bounds.top - map.clientTop;
+      if (x < 0 || y < 0 || x >= map.clientWidth || y >= map.clientHeight) return;
+      drag = { id: event.pointerId, x: event.clientX, y: event.clientY };
+      map.setPointerCapture(event.pointerId);
+      map.classList.add('is-dragging');
+      map.focus({ preventScroll: true });
+      event.preventDefault();
+    });
+
+    map.addEventListener('pointermove', (event) => {
+      if (!drag || event.pointerId !== drag.id) return;
+      // Apply both deltas on every move; never choose or lock an axis.
+      map.scrollLeft += drag.x - event.clientX;
+      map.scrollTop += drag.y - event.clientY;
+      drag.x = event.clientX;
+      drag.y = event.clientY;
+    });
+
+    function endDrag(event) {
+      if (!drag || event.pointerId !== drag.id) return;
+      drag = null;
+      map.classList.remove('is-dragging');
+      if (map.hasPointerCapture(event.pointerId)) map.releasePointerCapture(event.pointerId);
+    }
+
+    map.addEventListener('pointerup', endDrag);
+    map.addEventListener('pointercancel', endDrag);
+    map.addEventListener('lostpointercapture', endDrag);
+
+    map.addEventListener('wheel', (event) => {
+      if (event.ctrlKey) return; // Preserve browser pinch-to-zoom.
+      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? map.clientHeight : 1;
+      const dx = (event.shiftKey && !event.deltaX ? event.deltaY : event.deltaX) * unit;
+      const dy = (event.shiftKey && !event.deltaX ? 0 : event.deltaY) * unit;
+      const beforeX = map.scrollLeft;
+      const beforeY = map.scrollTop;
+      map.scrollLeft += dx;
+      map.scrollTop += dy;
+      if (map.scrollLeft !== beforeX || map.scrollTop !== beforeY) event.preventDefault();
+    }, { passive: false });
+
+    map.addEventListener('keydown', (event) => {
+      const moves = { ArrowLeft: [-60, 0], ArrowRight: [60, 0], ArrowUp: [0, -60], ArrowDown: [0, 60] };
+      const move = moves[event.key];
+      if (!move) return;
+      event.preventDefault();
+      map.scrollLeft += move[0];
+      map.scrollTop += move[1];
+    });
+
+    resetMap.addEventListener('click', centerMap);
+    centerMap();
+  </script>
