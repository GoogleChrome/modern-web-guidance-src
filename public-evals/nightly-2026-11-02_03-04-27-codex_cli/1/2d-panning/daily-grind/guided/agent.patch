+  <script>
+    const map = document.getElementById('cafe-map');
+    const resetMap = () => {
+      map.scrollLeft = (map.scrollWidth - map.clientWidth) / 2;
+      map.scrollTop = (map.scrollHeight - map.clientHeight) / 2;
+    };
+    resetMap();
+    document.getElementById('map-reset').addEventListener('click', resetMap);
+
+    const needsPanFallback = !CSS.supports('scroll-axis-lock', 'none');
+    if (needsPanFallback) {
+      map.classList.add('has-pan-fallback');
+      map.addEventListener('wheel', (event) => {
+        // Keep browser zoom shortcuts available.
+        if (event.ctrlKey || event.metaKey) return;
+        event.preventDefault();
+        const unitX = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? map.clientWidth : 1;
+        const unitY = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? map.clientHeight : 1;
+        map.scrollLeft += event.deltaX * unitX;
+        map.scrollTop += event.deltaY * unitY;
+      }, { passive: false });
+    }
+
+    // Mouse dragging works everywhere; touch uses native scrolling where supported.
+    let pan = null;
+    map.addEventListener('pointerdown', (event) => {
+      if (!event.isPrimary || event.button !== 0 ||
+        (!needsPanFallback && event.pointerType !== 'mouse')) return;
+      const bounds = map.getBoundingClientRect();
+      const x = event.clientX - bounds.left - map.clientLeft;
+      const y = event.clientY - bounds.top - map.clientTop;
+      // Let native scrollbar interactions pass through.
+      if (x < 0 || y < 0 || x >= map.clientWidth || y >= map.clientHeight) return;
+      pan = { id: event.pointerId, x: event.clientX, y: event.clientY };
+      map.setPointerCapture(event.pointerId);
+      map.classList.add('is-panning');
+      map.focus({ preventScroll: true });
+    });
+    map.addEventListener('pointermove', (event) => {
+      if (!pan || event.pointerId !== pan.id) return;
+      map.scrollLeft -= event.clientX - pan.x;
+      map.scrollTop -= event.clientY - pan.y;
+      pan.x = event.clientX;
+      pan.y = event.clientY;
+    });
+    const endPan = (event) => {
+      if (!pan || event.pointerId !== pan.id) return;
+      pan = null;
+      map.classList.remove('is-panning');
+      if (map.hasPointerCapture(event.pointerId)) map.releasePointerCapture(event.pointerId);
+    };
+    map.addEventListener('pointerup', endPan);
+    map.addEventListener('pointercancel', endPan);
+    map.addEventListener('lostpointercapture', endPan);
+  </script>
