diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,35 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Keep cards full size unless scroll animations and motion are enabled. */
+    @media (prefers-reduced-motion: no-preference) {
+      @supports (animation-timeline: view()) {
+        @keyframes card-reveal {
+          0%, 100% {
+            transform: scale(0.5);
+          }
+
+          20%, 80% {
+            transform: scale(1);
+          }
+        }
+
+        .grid > .card {
+          animation: card-reveal auto linear both;
+          animation-timeline: view();
+          animation-range: cover 0% cover 100%;
+        }
+
+        /* Keep focused links and their cards at a comfortable reading size. */
+        .grid > .card:focus-within {
+          animation: none;
+          transform: scale(1);
+        }
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
