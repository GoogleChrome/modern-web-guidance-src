+cd "$(dirname "$0")/.."
+emcc native/browser.cpp -O3 -Wno-narrowing -Wno-return-type --no-entry \
+  -s MODULARIZE=1 -s EXPORT_ES6=1 -s ENVIRONMENT=web,worker,node \
+  -s EXPORTED_RUNTIME_METHODS='["HEAPU8"]' -s ALLOW_MEMORY_GROWTH=1 -s STACK_SIZE=5242880 \
