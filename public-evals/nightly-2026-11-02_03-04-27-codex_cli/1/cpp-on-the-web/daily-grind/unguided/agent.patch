+const $ = (id) => document.getElementById(id);
+const canvas = $('render');
+const ctx = canvas.getContext('2d');
+const originalColors = [[.75,.25,.25],[.25,.25,.75],[.999,.999,.999],[.999,.999,.999]];
+let colors = structuredClone(originalColors);
+let worker, renderId = 0;
+const preview = new Image();
+function palette() {
+  [...$('palette').querySelectorAll('div > span')].forEach((swatch, i) => {
+    const rgb = colors[i].map(c => Math.round(c * 255));
+    swatch.style.setProperty('--swatch', `rgb(${rgb.join(',')})`);
+    swatch.title = `RGB ${rgb.join(', ')}`;
+  });
+}
+function render() {
+  worker?.terminate();
+  const current = ++renderId;
+  const width = Number($('resolution').value), height = width * .75;
+  const samples = Number($('samples').value);
+  $('status').textContent = 'Starting a new light study…';
+  $('elapsed').textContent = '0.0s';
+  $('progress').style.width = '0%';
+  $('status-dot').style.background = '#bce89b';
+  try {
+    worker = new Worker(new URL('./assets/render-worker.js', import.meta.url), { type: 'module' });
+    worker.onmessage = ({ data }) => {
+      if (current !== renderId) return;
+      if (data.error) return fail(data.error);
+      if (canvas.width !== width || canvas.height !== height) { canvas.width = width; canvas.height = height; }
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), width, height), 0, 0);
+      $('progress').style.width = `${data.samples / samples * 100}%`;
+      $('elapsed').textContent = `${data.elapsed.toFixed(1)}s`;
+      $('status').textContent = data.done ? `Render complete · ${samples} samples per pixel` : `Tracing light · ${data.samples} / ${samples} samples`;
+      if (data.done) { worker.terminate(); worker = null; }
+    };
+    worker.onerror = () => fail('Unable to load the WebAssembly renderer. Please reload and try again.');
+    const seed = crypto.getRandomValues(new Uint32Array(1))[0];
+    worker.postMessage({ width, height, samples, colors, seed });
+  } catch (error) { fail(error.message); }
+}
+function fail(message) {
+  worker?.terminate();
+  $('status').textContent = `Render error: ${message}`;
+  $('status-dot').style.background = '#e5a077';
+}
+$('randomize').onclick = () => {
+  // Saturated, bright reflectances keep mirror and glass clearly visible.
+  colors = Array.from({ length: 4 }, () => {
+    const hue = crypto.getRandomValues(new Uint32Array(1))[0] / 4294967296;
+    return [0, 8, 4].map(n => { const k = (n + hue * 12) % 12; return .86 - .48 * Math.max(-1, Math.min(k - 3, 9 - k, 1)); }).map(c => Math.min(.95, c));
+  });
+  palette(); render();
+};
+$('rerender').onclick = render;
+$('reset').onclick = () => { colors = structuredClone(originalColors); palette(); render(); };
+$('samples').onchange = render;
+$('resolution').onchange = render;
+$('download').onclick = () => canvas.toBlob(blob => {
+  if (!blob) return;
+  const url = URL.createObjectURL(blob), link = document.createElement('a');
+  link.href = url; link.download = 'smallpt-light-study.png'; link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}, 'image/png');
+function showTab(about) {
+  $('about-panel').hidden = !about; $('render-panel').hidden = about;
+  for (const [id, active] of [['about-tab', about], ['render-tab', !about]]) {
+    $(id).classList.toggle('active', active); $(id).setAttribute('aria-selected', String(active));
+    $(id).tabIndex = active ? 0 : -1;
+  }
+}
+$('about-tab').onclick = () => showTab(true);
+$('render-tab').onclick = () => showTab(false);
+document.querySelector('.tabs').onkeydown = (event) => {
+  if (['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) {
+    event.preventDefault();
+    const about = event.key === 'End' || (event.key !== 'Home' && $('about-panel').hidden);
+    showTab(about); $(about ? 'about-tab' : 'render-tab').focus();
+  }
+};
+showTab(false);
+palette();
+preview.onload = () => { if (!renderId) { ctx.drawImage(preview, 0, 0, canvas.width, canvas.height); render(); } };
+preview.onerror = render;
+preview.src = 'assets/initial-render.png';
