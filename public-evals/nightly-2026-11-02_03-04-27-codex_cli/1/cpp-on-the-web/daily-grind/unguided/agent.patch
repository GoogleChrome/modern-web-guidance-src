@@ -0,0 +1,16 @@
+import createSmallpt from './smallpt.mjs';
+const engine = createSmallpt();
+self.onmessage = async ({ data }) => {
+  try {
+    const m = await engine;
+    const { width, height, samples, colors, seed } = data;
+    m._setup(width, height, seed);
+    [0, 1, 6, 7].forEach((id, i) => m._set_color(id, ...colors[i]));
+    const started = performance.now();
+    for (let pass = 0; pass < samples / 4; pass++) {
+      m._render_pass();
+      const pixels = m.HEAPU8.slice(m._framebuffer(), m._framebuffer() + width * height * 4);
+      self.postMessage({ pixels, width, height, samples: (pass + 1) * 4, elapsed: (performance.now() - started) / 1000, done: (pass + 1) * 4 === samples }, [pixels.buffer]);
+    }
+  } catch (error) { self.postMessage({ error: error.message }); }
+};
