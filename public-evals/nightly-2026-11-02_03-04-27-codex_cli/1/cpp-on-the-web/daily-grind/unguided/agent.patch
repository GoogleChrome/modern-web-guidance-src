diff --git a/native/browser.cpp b/native/browser.cpp
new file mode 100644
index 0000000..3843483
--- /dev/null
+++ b/native/browser.cpp
@@ -0,0 +1,44 @@
+// Browser adapter for Kevin Beason's smallpt. See vendor/smallpt/LICENSE.txt.
+#define main smallpt_original_main
+#include "../vendor/smallpt/smallpt.cpp"
+#undef main
+#include <vector>
+#include <stdint.h>
+
+static int width, height, passes;
+static uint32_t seed;
+static std::vector<Vec> accumulation;
+static std::vector<unsigned char> pixels;
+extern "C" {
+void setup(int w, int h, unsigned int randomSeed) {
+  width=w; height=h; seed=randomSeed; passes=0;
+  accumulation.assign(w*h*4, Vec()); pixels.assign(w*h*4, 255);
+}
+void set_color(int id, double r, double g, double b) {
+  if (id>=0 && id<8) spheres[id].c=Vec(r,g,b);
+}
+unsigned char* framebuffer() { return pixels.data(); }
+void render_pass() {
+  Ray cam(Vec(50,52,295.6),Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height),cy=(cx%cam.d).norm()*.5135;
+  for(int y=0;y<height;y++) {
+    unsigned short Xi[3]={(unsigned short)(seed+passes*1973),
+      (unsigned short)(seed>>16),(unsigned short)(y*y*y+passes*9277)};
+    for(int x=0;x<width;x++) {
+      int i=(height-y-1)*width+x;
+      Vec color;
+      for(int sy=0;sy<2;sy++) for(int sx=0;sx<2;sx++) {
+        double r1=2*erand48(Xi),dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+        double r2=2*erand48(Xi),dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+        Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+        Vec &a=accumulation[i*4+sy*2+sx];
+        a=a+radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+        Vec c=a*(1./(passes+1));
+        color=color+Vec(clamp(c.x),clamp(c.y),clamp(c.z))*.25;
+      }
+      pixels[i*4]=toInt(color.x); pixels[i*4+1]=toInt(color.y); pixels[i*4+2]=toInt(color.z);
+    }
+  }
+  passes++;
+}
+}
