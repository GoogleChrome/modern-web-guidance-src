diff --git a/scripts/check-wasm.mjs b/scripts/check-wasm.mjs
new file mode 100644
index 0000000..b043a06
--- /dev/null
+++ b/scripts/check-wasm.mjs
@@ -0,0 +1,47 @@
+import assert from 'node:assert/strict';
+import { readFile, writeFile } from 'node:fs/promises';
+import { deflateSync } from 'node:zlib';
+import createSmallpt from '../assets/smallpt.mjs';
+const wasmBinary = await readFile(new URL('../assets/smallpt.wasm', import.meta.url));
+assert(WebAssembly.validate(wasmBinary), 'Valid WebAssembly binary');
+const m = await createSmallpt({ wasmBinary });
+function frame() { return m.HEAPU8.slice(m._framebuffer(), m._framebuffer() + 64 * 48 * 4); }
+m._setup(64, 48, 12345);
+m._render_pass();
+const original = frame();
+assert.equal(original.length, 64 * 48 * 4);
+assert(original.some((v, i) => i % 4 !== 3 && v > 0), 'Render contains light');
+assert(original.every((v, i) => i % 4 !== 3 || v === 255), 'Opaque RGBA');
+m._setup(64, 48, 12345); m._render_pass();
+assert.deepEqual(frame(), original, 'Same scene and seed produce the same output');
+m._setup(64, 48, 12345);
+m._set_color(0, .2, .8, .3); m._set_color(6, .9, .4, .3);
+m._render_pass();
+assert.notDeepEqual(frame(), original, 'Color changes affect actual path-traced output');
+const firstPass = frame();
+m._render_pass();
+assert.notDeepEqual(frame(), firstPass, 'Additional samples refine the image');
+console.log('WASM checks passed: render, RGBA buffer, determinism, randomized colors, progressive sampling.');
+if (process.argv.includes('--preview')) {
+  // Produce an authentic initial image using the same compiled WASM renderer.
+  m._set_color(0,.75,.25,.25); m._set_color(6,.999,.999,.999);
+  m._setup(640,480,314159);
+  const start = performance.now();
+  for(let i=0;i<64;i++) m._render_pass();
+  const rgba = m.HEAPU8.slice(m._framebuffer(),m._framebuffer()+640*480*4);
+  const scanlines = Buffer.alloc((640*4+1)*480);
+  for (let y=0;y<480;y++) scanlines.set(rgba.subarray(y*640*4,(y+1)*640*4),y*(640*4+1)+1);
+  function chunk(type, data) {
+    const body=Buffer.concat([Buffer.from(type),data]);
+    let crc=0xffffffff;
+    for(const byte of body) { crc^=byte; for(let b=0;b<8;b++) crc=(crc>>>1)^((crc&1)?0xedb88320:0); }
+    const size=Buffer.alloc(4), checksum=Buffer.alloc(4);
+    size.writeUInt32BE(data.length); checksum.writeUInt32BE((crc^0xffffffff)>>>0);
+    return Buffer.concat([size,body,checksum]);
+  }
+  const header=Buffer.alloc(13); header.writeUInt32BE(640); header.writeUInt32BE(480,4); header[8]=8; header[9]=6;
+  await writeFile(new URL('../assets/initial-render.png',import.meta.url),Buffer.concat([
+    Buffer.from([137,80,78,71,13,10,26,10]), chunk('IHDR',header), chunk('IDAT',deflateSync(scanlines)),chunk('IEND',Buffer.alloc(0))
+  ]));
+  console.log(`Rendered 256-sample preview in ${((performance.now()-start)/1000).toFixed(1)}s`);
+}
