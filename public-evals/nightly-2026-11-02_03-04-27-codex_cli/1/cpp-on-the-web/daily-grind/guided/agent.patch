diff --git a/worker.js b/worker.js
new file mode 100644
index 0000000..c039fef
--- /dev/null
+++ b/worker.js
@@ -0,0 +1,22 @@
+import createSmallpt from './public/smallpt.js';
+
+self.onmessage = async ({ data }) => {
+  try {
+    const wasm = await createSmallpt();
+    const { width, height, samples, seed, colors } = data;
+    wasm._init_render(width, height, seed);
+    colors.forEach(({ sphere, rgb }) => wasm._set_color(sphere, ...rgb));
+    const started = performance.now();
+    for (let pass = 1; pass <= samples / 4; pass++) {
+      const pointer = wasm._render_pass();
+      const pixels = new Uint8ClampedArray(wasm.HEAPU8.buffer, pointer, width * height * 4).slice();
+      self.postMessage({
+        pixels, width, height, samples: pass * 4,
+        elapsed: (performance.now() - started) / 1000,
+        done: pass * 4 >= samples,
+      }, [pixels.buffer]);
+    }
+  } catch (error) {
+    self.postMessage({ error: error.message || 'Could not start the WebAssembly renderer.' });
+  }
+};
