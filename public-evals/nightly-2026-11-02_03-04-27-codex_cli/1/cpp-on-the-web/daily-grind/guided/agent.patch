+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+mkdir -p public
+em++ src/renderer.cpp -o public/smallpt.js -O3 -flto -Wall -Werror -fno-exceptions -fno-rtti \
+  -sSTRICT -sEXPORT_ES6 -sENVIRONMENT=worker -sALLOW_MEMORY_GROWTH \
+  -sSTACK_SIZE=1MB -sFILESYSTEM=0 \
+  -sEXPORTED_FUNCTIONS=_init_render,_set_color,_render_pass \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8 --no-entry
