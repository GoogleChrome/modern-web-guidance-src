new file mode 100644
index 0000000..4fd40c4
--- /dev/null
+++ b/app.js
@@ -0,0 +1,144 @@
+const $ = (selector) => document.querySelector(selector);
+const canvas = $('#render');
+const context = canvas.getContext('2d');
+const colorIds = ['left-color', 'right-color', 'mirror-color', 'glass-color'];
+const defaults = ['#91b69a', '#d6a783', '#ffffff', '#ffffff'];
+const sphereIds = [0, 1, 6, 7];
+let samples = 32;
+let worker;
+let timer;
+let startedAt;
+let hasRendered = false;
+let completedSamples = 0;
+
+function setStatus(message, state) {
+  $('#render-status').textContent = message;
+  $('#viewer-state').textContent = state;
+}
+
+function fail(message) {
+  clearInterval(timer);
+  worker?.terminate();
+  setStatus(message, 'RENDER ERROR');
+  $('#render-status').classList.add('error');
+  $('#live-dot').style.background = '#ec9c86';
+}
+
+function render() {
+  worker?.terminate();
+  clearInterval(timer);
+  $('#render-status').classList.remove('error');
+  $('#live-dot').style.background = '';
+  const width = Number($('#resolution').value);
+  const height = width * 3 / 4;
+  completedSamples = 0;
+  startedAt = performance.now();
+  setStatus('Tracing light…', 'RENDERING');
+  $('#progress').style.width = '0%';
+  const updateTime = () => {
+    $('#render-time').textContent = `${((performance.now() - startedAt) / 1000).toFixed(1)}s / ${completedSamples} samples`;
+  };
+  updateTime();
+  timer = setInterval(updateTime, 100);
+  try {
+    if (!('WebAssembly' in window) || !('Worker' in window)) {
+      throw new Error('This browser needs WebAssembly and Web Worker support.');
+    }
+    worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });
+    worker.onerror = () => fail('Renderer could not load. Please reload to try again.');
+    worker.onmessage = ({ data }) => {
+      if (data.error) return fail(data.error);
+      if (canvas.width !== data.width || canvas.height !== data.height) {
+        canvas.width = data.width;
+        canvas.height = data.height;
+      }
+      context.putImageData(new ImageData(data.pixels, data.width, data.height), 0, 0);
+      canvas.classList.add('ready');
+      hasRendered = true;
+      completedSamples = data.samples;
+      $('#progress').style.width = `${data.samples / samples * 100}%`;
+      updateTime();
+      if (data.done) {
+        clearInterval(timer);
+        $('#render-time').textContent = `${data.elapsed.toFixed(1)}s / ${data.samples} samples`;
+        setStatus('Render complete', 'COMPLETE');
+        worker.terminate();
+      }
+    };
+    const seed = crypto.getRandomValues(new Uint32Array(1))[0];
+    const colors = colorIds.map((id, index) => {
+      const hex = document.getElementById(id).value.slice(1);
+      // Color inputs use display sRGB; smallpt works with linear reflectances.
+      const rgb = [0, 2, 4].map((offset) =>
+        Math.min(.999, (parseInt(hex.slice(offset, offset + 2), 16) / 255) ** 2.2));
+      return { sphere: sphereIds[index], rgb };
+    });
+    worker.postMessage({ width, height, samples, seed, colors });
+  } catch (error) {
+    fail(error.message);
+  }
+}
+
+document.querySelectorAll('[data-samples]').forEach((button) => {
+  button.setAttribute('aria-pressed', button.classList.contains('selected'));
+  button.addEventListener('click', () => {
+    samples = Number(button.dataset.samples);
+    document.querySelectorAll('[data-samples]').forEach((item) => {
+      const active = item === button;
+      item.classList.toggle('selected', active);
+      item.setAttribute('aria-pressed', active);
+    });
+    $('#sample-display').textContent = `${samples} SPP`;
+    render();
+  });
+});
+$('#resolution').addEventListener('change', render);
+colorIds.forEach((id) => document.getElementById(id).addEventListener('change', render));
+$('#reset').addEventListener('click', () => {
+  colorIds.forEach((id, i) => { document.getElementById(id).value = defaults[i]; });
+  render();
+});
+function randomColor(lightness, saturation) {
+  const hue = crypto.getRandomValues(new Uint32Array(1))[0] % 360;
+  const c = (1 - Math.abs(2 * lightness - 1)) * saturation;
+  const x = c * (1 - Math.abs(hue / 60 % 2 - 1));
+  const m = lightness - c / 2;
+  const components = hue < 60 ? [c,x,0] : hue < 120 ? [x,c,0] :
+    hue < 180 ? [0,c,x] : hue < 240 ? [0,x,c] : hue < 300 ? [x,0,c] : [c,0,x];
+  return '#' + components.map((v) => Math.round((v + m) * 255).toString(16).padStart(2, '0')).join('');
+}
+$('#randomize').addEventListener('click', () => {
+  colorIds.forEach((id, index) => {
+    document.getElementById(id).value = randomColor(index < 2 ? .64 : .86, index < 2 ? .38 : .68);
+  });
+  render();
+});
+$('#download').addEventListener('click', async () => {
+  const button = $('#download');
+  button.disabled = true;
+  try {
+    let output = canvas;
+    if (!hasRendered) {
+      const preview = $('#preview');
+      await preview.decode();
+      output = document.createElement('canvas');
+      output.width = preview.naturalWidth;
+      output.height = preview.naturalHeight;
+      output.getContext('2d').drawImage(preview, 0, 0);
+    }
+    const blob = await new Promise((resolve) => output.toBlob(resolve, 'image/png'));
+    if (!blob) throw new Error('Unable to save this image.');
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = 'smallpt-' + Date.now() + '.png';
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 10000);
+  } catch (error) {
+    $('#render-status').textContent = error.message;
+  } finally {
+    button.disabled = false;
+  }
+});
+window.addEventListener('pagehide', () => { worker?.terminate(); clearInterval(timer); });
+render();
