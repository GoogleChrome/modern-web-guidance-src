+cp -R public src dist/
diff --git a/scripts/check-wasm.mjs b/scripts/check-wasm.mjs
new file mode 100644
index 0000000..41b8192
--- /dev/null
+++ b/scripts/check-wasm.mjs
@@ -0,0 +1,27 @@
+// Exercise the shipped browser Wasm without starting a server or browser.
+import { readFile } from 'node:fs/promises';
+import assert from 'node:assert/strict';
+import createSmallpt from '../public/smallpt.js';
+
+globalThis.fetch = async (url) => new Response(await readFile(new URL(url)), {
+  headers: { 'Content-Type': 'application/wasm' },
+});
+const wasm = await createSmallpt();
+const width = 80, height = 60;
+function frame(color) {
+  wasm._init_render(width, height, 42);
+  wasm._set_color(6, ...color);
+  wasm._set_color(7, ...color);
+  let pointer;
+  for (let i = 0; i < 4; i++) pointer = wasm._render_pass();
+  return wasm.HEAPU8.slice(pointer, pointer + width * height * 4);
+}
+const initial = frame([.999, .999, .999]);
+const changed = frame([.9, .2, .1]);
+assert.equal(initial.length, width * height * 4);
+assert(initial.some((v, i) => i % 4 !== 3 && v > 0), 'Image must contain light');
+assert(initial.every((v, i) => i % 4 !== 3 || v === 255), 'Alpha must be opaque');
+assert.notDeepEqual(initial, changed, 'Sphere colors must alter the rendered output');
+wasm._init_render(960, 720, 42);
+assert(wasm.HEAPU8.length > 960 * 720 * 28, 'Large resolution memory allocation must grow the heap');
+console.log('Wasm checks passed: rendering, opaque pixels, changed sphere colors, memory growth.');
diff --git a/scripts/encode-preview.py b/scripts/encode-preview.py
new file mode 100644
index 0000000..9a77f57
--- /dev/null
+++ b/scripts/encode-preview.py
@@ -0,0 +1,19 @@
+"""Convert the native renderer's PPM output to a PNG, without image dependencies."""
+from pathlib import Path
+import struct
+import zlib
+
+ppm = Path('/tmp/smallpt-preview.ppm').read_bytes()
+magic, dimensions, maximum, pixels = ppm.split(b'\n', 3)
+assert magic == b'P6' and maximum == b'255'
+width, height = map(int, dimensions.split())
+assert len(pixels) == width * height * 3
+def chunk(kind, data):
+    return struct.pack('!I', len(data)) + kind + data + struct.pack('!I', zlib.crc32(kind + data) & 0xffffffff)
+rows = b''.join(b'\0' + pixels[y*width*3:(y+1)*width*3] for y in range(height))
+png = b'\x89PNG\r\n\x1a\n'
+png += chunk(b'IHDR', struct.pack('!IIBBBBB', width, height, 8, 2, 0, 0, 0))
+png += chunk(b'IDAT', zlib.compress(rows, 9))
+png += chunk(b'IEND', b'')
+Path('public/preview.png').write_bytes(png)
+print(f'Created public/preview.png ({width} × {height})')
