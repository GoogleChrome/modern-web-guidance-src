new file mode 100644
index 0000000..e7e8b1f
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,21 @@
+import createSmallpt from './smallpt.js';
+self.onmessage = async ({ data }) => {
+  try {
+    const renderer = await createSmallpt();
+    const { width, height, samples, seed, colors } = data;
+    renderer._setup(width, height, samples, seed);
+    colors.forEach((rgb, index) => renderer._color(6 + index, ...rgb));
+    const started = performance.now();
+    for (let row = 0; row < height; row += 4) {
+      const rows = Math.min(4, height - row);
+      renderer._render_rows(row, rows);
+      const offset = renderer._buffer() + row * width * 4;
+      const pixels = renderer.HEAPU8.slice(offset, offset + rows * width * 4);
+      self.postMessage({ type: 'progress', row, rows, pixels, progress: (row + rows) / height,
+        elapsed: (performance.now() - started) / 1000 }, [pixels.buffer]);
+    }
+    self.postMessage({ type: 'done', elapsed: (performance.now() - started) / 1000 });
+  } catch (error) {
+    self.postMessage({ type: 'error', message: error.message || String(error) });
+  }
+};
diff --git a/scripts/build-preview.mjs b/scripts/build-preview.mjs
new file mode 100644
index 0000000..c54add4
--- /dev/null
+++ b/scripts/build-preview.mjs
@@ -0,0 +1,10 @@
+// Produce the initial image using the exact WASM renderer shipped to browsers.
+import createSmallpt from '../public/smallpt/smallpt.js';
+import sharp from 'sharp';
+const module = await createSmallpt();
+const width = 720, height = 540;
+module._setup(width, height, 128, 42);
+module._render_rows(0, height);
+const bytes = module.HEAPU8.slice(module._buffer(), module._buffer() + width * height * 4);
+await sharp(bytes, { raw: { width, height, channels: 4 } }).png().toFile('public/smallpt/preview.png');
+console.log('Built preview.png with smallpt WebAssembly (720 × 540, 128 spp).');
