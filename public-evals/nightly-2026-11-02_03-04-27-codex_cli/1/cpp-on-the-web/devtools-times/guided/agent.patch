new file mode 100644
index 0000000..f0db95d
--- /dev/null
+++ b/src/scripts/lab.ts
@@ -0,0 +1,132 @@
+const main = document.querySelector('main')!;
+const base = main.dataset.base!;
+const canvas = document.querySelector<HTMLCanvasElement>('#render-canvas')!;
+const context = canvas.getContext('2d')!;
+const quality = document.querySelector<HTMLSelectElement>('#quality')!;
+const resolution = document.querySelector<HTMLSelectElement>('#resolution')!;
+const randomize = document.querySelector<HTMLButtonElement>('#randomize')!;
+const renderButton = document.querySelector<HTMLButtonElement>('#render')!;
+const download = document.querySelector<HTMLButtonElement>('#download')!;
+const status = document.querySelector<HTMLElement>('#render-status')!;
+const errorBox = document.querySelector<HTMLElement>('#error-message')!;
+const announcement = document.querySelector<HTMLElement>('#announcement')!;
+const progressBar = document.querySelector<HTMLElement>('[role="progressbar"]')!;
+const text = (id: string, value: string) => { document.getElementById(id)!.textContent = value; };
+let worker: Worker | null = null;
+let busy = false;
+let colors = [0.999, 0.999, 0.999, 0.999, 0.999, 0.999];
+let paletteNumber = 0;
+let completed = false;
+
+function setStatus(label: string) {
+  status.replaceChildren(Object.assign(document.createElement('span'), { className: 'dot' }), document.createTextNode(label));
+}
+function setBusy(value: boolean) {
+  busy = value;
+  text('render-button-label', value ? 'Stop rendering' : 'Render scene');
+  text('render-button-icon', value ? '□' : '▷');
+  download.disabled = value || !completed;
+}
+function stop() {
+  worker?.terminate();
+  worker = null;
+  setBusy(false);
+}
+function fail(message: string) {
+  stop();
+  setStatus('Render unavailable');
+  text('frame-state', 'Render failed');
+  errorBox.textContent = message;
+  errorBox.hidden = false;
+  announcement.textContent = 'Rendering failed. See the error below the playground.';
+}
+function render() {
+  stop();
+  completed = false;
+  errorBox.hidden = true;
+  const width = Number(resolution.value);
+  const height = width * 3 / 4;
+  const samples = Number(quality.value);
+  if (canvas.width !== width || canvas.height !== height) {
+    canvas.width = width;
+    canvas.height = height;
+  }
+  setBusy(true);
+  setStatus('Rendering');
+  text('frame-state', 'Rendering · 0%');
+  text('dimensions', `${width} × ${height}`);
+  text('sample-count', `${samples} samples / pixel`);
+  text('elapsed', '0.0 s');
+  document.getElementById('progress-fill')!.style.width = '0%';
+  progressBar.setAttribute('aria-valuenow', '0');
+  announcement.textContent = 'Rendering the scene on your device.';
+  try {
+    worker = new Worker(`${base}smallpt/worker.js`, { type: 'module' });
+    worker.onerror = () => fail('The renderer could not load. Please reload the page and try again. WebAssembly and module workers must be supported by your browser.');
+    worker.onmessage = ({ data }) => {
+      if (data.error) { fail(`Unable to render: ${data.error}`); return; }
+      context.putImageData(new ImageData(data.pixels, data.width, data.rows), 0, data.row);
+      const percent = Math.round(data.progress * 100);
+      text('frame-state', `Rendering · ${percent}%`);
+      text('elapsed', `${data.elapsed.toFixed(1)} s`);
+      document.getElementById('progress-fill')!.style.width = `${percent}%`;
+      progressBar.setAttribute('aria-valuenow', String(percent));
+      if (data.progress === 1) {
+        completed = true;
+        stop();
+        setStatus('Render complete');
+        text('frame-state', 'Render complete');
+        announcement.textContent = `Render complete in ${data.elapsed.toFixed(1)} seconds. Your image is ready to save.`;
+      }
+    };
+    worker.postMessage({ width, height, samples, colors, seed: crypto.getRandomValues(new Uint32Array(1))[0] });
+  } catch (error) {
+    fail(error instanceof Error ? error.message : 'WebAssembly is not available in this browser.');
+  }
+}
+function updatePalette() {
+  for (const [index, name] of ['mirror', 'glass'].entries()) {
+    const hex = '#' + colors.slice(index * 3, index * 3 + 3).map(value => Math.round(value * 255).toString(16).padStart(2, '0')).join('').toUpperCase();
+    text(`${name}-hex`, hex);
+    document.getElementById(`${name}-swatch`)!.style.setProperty('--sphere-color', hex);
+  }
+  text('palette-number', paletteNumber ? `PALETTE ${String(paletteNumber).padStart(3, '0')}` : 'ORIGINAL');
+}
+randomize.addEventListener('click', () => {
+  // Bright tints preserve visibility through the original specular/glass materials.
+  const values = crypto.getRandomValues(new Uint32Array(6));
+  colors = Array.from(values, value => 0.5 + (value / 0xffffffff) * 0.49);
+  paletteNumber++;
+  updatePalette();
+  render();
+});
+renderButton.addEventListener('click', () => {
+  if (busy) {
+    stop();
+    setStatus('Stopped');
+    text('frame-state', 'Render stopped');
+    announcement.textContent = 'Rendering stopped. Render again or try a fresh palette.';
+  } else render();
+});
+document.getElementById('reset')!.addEventListener('click', () => {
+  colors = Array(6).fill(0.999);
+  paletteNumber = 0;
+  quality.value = '32';
+  resolution.value = '640';
+  updatePalette();
+  render();
+});
+download.addEventListener('click', () => {
+  if (!completed || busy) return;
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = `smallpt-palette-${paletteNumber}-${canvas.width}x${canvas.height}.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+window.addEventListener('pagehide', stop);
+render();
