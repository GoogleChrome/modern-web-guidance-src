+unsigned char* render_rows(int first, int count, int spp) {
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  int samps=spp/4;
+  for (int row=first; row<first+count && row<height; ++row) {
+    int y=height-row-1;
+    unsigned short Xi[3]={static_cast<unsigned short>(renderSeed),
+      static_cast<unsigned short>(renderSeed>>16), static_cast<unsigned short>(y*y*y)};
+    for (int x=0; x<width; ++x) {
+      Vec color;
+      for (int sy=0;sy<2;++sy) for(int sx=0;sx<2;++sx) {
+        Vec r;
+        for(int s=0;s<samps;++s) {
+          double r1=2*erand48(Xi), dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+          double r2=2*erand48(Xi), dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+          Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+          r=r+radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*(1./samps);
+        }
+        color=color+Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+      }
+      int i=(row*width+x)*4;
+      pixels[i]=toInt(color.x); pixels[i+1]=toInt(color.y);
+      pixels[i+2]=toInt(color.z); pixels[i+3]=255;
+    }
+  }
+  return pixels.data()+first*width*4;
+}
+}
diff --git a/public/smallpt/worker.js b/public/smallpt/worker.js
new file mode 100644
index 0000000..17ffc4d
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,21 @@
+import createRenderer from './renderer.js';
+
+self.onmessage = async ({ data }) => {
+  try {
+    const { width, height, samples, colors, seed } = data;
+    const wasm = await createRenderer();
+    wasm._init_render(width, height, seed);
+    wasm._set_colors(...colors);
+    const started = performance.now();
+    for (let row = 0; row < height; row += 8) {
+      const rows = Math.min(8, height - row);
+      const pointer = wasm._render_rows(row, rows, samples);
+      // Read the heap after rendering: memory growth can detach an older view.
+      const pixels = new Uint8ClampedArray(wasm.HEAPU8.buffer, pointer, width * rows * 4).slice();
+      self.postMessage({ pixels, row, rows, width, height, progress: (row + rows) / height,
+        elapsed: (performance.now() - started) / 1000 }, [pixels.buffer]);
+    }
+  } catch (error) {
+    self.postMessage({ error: error instanceof Error ? error.message : String(error) });
+  }
+};
