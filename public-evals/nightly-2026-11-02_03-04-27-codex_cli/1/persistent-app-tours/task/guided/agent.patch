+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTourButton = tourStep.querySelector('button');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+    const supportsAnchoring = CSS.supports('anchor-name: --rewards') &&
+      CSS.supports('position-area: bottom');
+    let tourOpen = true;
+    let positionFrame;
+
+    // Keep the fallback tethered even when scrolling or other content changes layout.
+    function trackRewards() {
+      if (!tourOpen) return;
+      const target = rewardsLink.getBoundingClientRect();
+      const width = tourStep.offsetWidth;
+      const height = tourStep.offsetHeight;
+      const left = Math.max(12, Math.min(target.left + target.width / 2 - width / 2,
+        window.innerWidth - width - 12));
+      const top = target.bottom + 12 + height <= window.innerHeight - 12
+        ? target.bottom + 12
+        : Math.max(12, target.top - height - 12);
+      tourStep.style.left = `${left}px`;
+      tourStep.style.top = `${top}px`;
+      positionFrame = requestAnimationFrame(trackRewards);
+    }
+
+    rewardsLink.addEventListener('click', (event) => {
+      if (tourOpen) event.preventDefault();
+    });
+    rewardsLink.addEventListener('auxclick', (event) => {
+      if (tourOpen) event.preventDefault();
+    });
+
+    closeTourButton.addEventListener('click', () => {
+      tourOpen = false;
+      cancelAnimationFrame(positionFrame);
+      if (supportsPopover) tourStep.hidePopover();
+      tourStep.hidden = true;
+      rewardsLink.removeAttribute('aria-describedby');
+      rewardsLink.focus({ preventScroll: true });
+    });
+
+    tourStep.hidden = false;
+    if (supportsPopover) tourStep.showPopover();
+    if (!supportsAnchoring || !supportsPopover) {
+      tourStep.style.positionArea = 'none';
+      tourStep.style.margin = '0';
+      trackRewards();
+    }
+    closeTourButton.focus({ preventScroll: true });
+  </script>
 </body>
 
