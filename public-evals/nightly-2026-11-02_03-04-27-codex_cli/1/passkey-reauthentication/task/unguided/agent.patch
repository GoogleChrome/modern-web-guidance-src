+  <script>
+    (() => {
+      const button = document.querySelector('[data-testid="reauth-button"]');
+      const status = document.getElementById('reauth-status');
+
+      function decodeBase64url(value) {
+        if (typeof value !== 'string' || !/^[A-Za-z0-9_-]+={0,2}$/.test(value)) {
+          throw new Error('The server returned invalid verification options.');
+        }
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        return Uint8Array.from(atob(base64), character => character.charCodeAt(0));
+      }
+
+      function encodeBase64url(value) {
+        const bytes = new Uint8Array(value);
+        let binary = '';
+        for (const byte of bytes) binary += String.fromCharCode(byte);
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      button.addEventListener('click', async () => {
+        if (button.disabled) return;
+        button.disabled = true;
+        status.textContent = 'Preparing identity confirmation…';
+
+        try {
+          if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.get) {
+            throw new Error('Passkey verification requires a supported browser and a secure connection.');
+          }
+
+          // API contract: return request options with a fresh, session-bound challenge and
+          // allowCredentials restricted to the signed-in user's registered credentials.
+          // The server identifies the user from the session, never a client-supplied user ID.
+          const optionsResponse = await fetch('/api/reauth/options', {
+            method: 'POST',
+            credentials: 'same-origin',
+            cache: 'no-store',
+            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+            body: JSON.stringify({})
+          });
+          if (!optionsResponse.ok) throw new Error('Could not start identity confirmation. Please try again.');
+          const options = await optionsResponse.json();
+          const publicKey = options.publicKey ?? options;
+
+          // An empty allowlist would permit account discovery instead of scoped reauthentication.
+          if (!Array.isArray(publicKey.allowCredentials) || publicKey.allowCredentials.length === 0) {
+            throw new Error('No registered passkey or security key is available for this account.');
+          }
+          const requestOptions = {
+            ...publicKey,
+            challenge: decodeBase64url(publicKey.challenge),
+            allowCredentials: publicKey.allowCredentials.map(credential => {
+              if (credential.type !== 'public-key') {
+                throw new Error('The server returned invalid verification options.');
+              }
+              return { ...credential, id: decodeBase64url(credential.id) };
+            }),
+            userVerification: 'required'
+          };
+
+          status.textContent = 'Use your registered passkey or security key to continue…';
+          // Request only a public-key assertion; stored passwords cannot satisfy this ceremony.
+          const assertion = await navigator.credentials.get({ publicKey: requestOptions });
+          if (!assertion || assertion.type !== 'public-key') {
+            throw new Error('Identity confirmation was not completed. Please try again.');
+          }
+
+          status.textContent = 'Verifying your identity…';
+          // The server must consume the challenge once and validate credential ownership,
+          // signature, expected origin/RP ID, and user presence + verification flags.
+          // Only a successful verification should establish a short-lived session grant
+          // and return { verified: true }. Both POST endpoints need CSRF protection.
+          const verificationResponse = await fetch('/api/reauth/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            cache: 'no-store',
+            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+            body: JSON.stringify({
+              id: assertion.id,
+              rawId: encodeBase64url(assertion.rawId),
+              type: assertion.type,
+              response: {
+                clientDataJSON: encodeBase64url(assertion.response.clientDataJSON),
+                authenticatorData: encodeBase64url(assertion.response.authenticatorData),
+                signature: encodeBase64url(assertion.response.signature),
+                userHandle: assertion.response.userHandle == null
+                  ? null : encodeBase64url(assertion.response.userHandle)
+              },
+              clientExtensionResults: assertion.getClientExtensionResults()
+            })
+          });
+          if (!verificationResponse.ok) throw new Error('Identity verification failed. Please try again.');
+          const result = await verificationResponse.json();
+          if (result.verified !== true) throw new Error('Identity verification failed. Please try again.');
+
+          // The server must enforce the reauthentication grant on the sensitive change endpoint.
+          status.textContent = 'Identity confirmed. You may continue with your account change.';
+        } catch (error) {
+          status.textContent = error.name === 'NotAllowedError' || error.name === 'AbortError'
+            ? 'Identity confirmation was canceled or timed out. Please try again.'
+            : error instanceof TypeError
+              ? 'Could not complete identity confirmation. Check your connection and try again.'
+              : error.message || 'Identity confirmation failed. Please try again.';
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
