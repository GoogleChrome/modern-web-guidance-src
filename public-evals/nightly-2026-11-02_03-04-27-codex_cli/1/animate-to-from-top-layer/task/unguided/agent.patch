+  <dialog id="logout-dialog" class="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <div class="dialog-content">
+      <button type="button" id="close-dialog-btn" class="dismiss-btn" aria-label="Close logout confirmation" autofocus>&times;</button>
+      <h2 id="logout-title">Log out?</h2>
+      <p id="logout-description">Are you sure you want to log out of your account?</p>
+      <div class="dialog-actions">
+        <button type="button" id="cancel-logout-btn" class="btn btn-secondary">Cancel</button>
+        <a href="/logout" class="btn">Log out</a>
+      </div>
+    </div>
+  </dialog>
+
+  <aside id="ordering-notice" class="ordering-notice" aria-label="Online ordering information" hidden>
+    <p role="status">online ordering is currently offline</p>
+    <button type="button" id="dismiss-notice-btn" class="dismiss-btn" aria-label="Dismiss ordering information">&times;</button>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const orderingNotice = document.getElementById('ordering-notice');
+
+    function closeLogoutDialog() {
+      if (logoutDialog.open) logoutDialog.classList.add('is-closing');
+    }
+
+    logoutLink.addEventListener('click', (event) => {
+      event.preventDefault();
+      logoutDialog.classList.remove('is-closing');
+      logoutDialog.showModal();
+      document.body.classList.add('dialog-open');
+    });
+
+    document.getElementById('close-dialog-btn').addEventListener('click', closeLogoutDialog);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeLogoutDialog);
+    logoutDialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeLogoutDialog();
+    });
+    logoutDialog.addEventListener('click', (event) => {
+      if (event.target === logoutDialog) closeLogoutDialog();
+    });
+    logoutDialog.addEventListener('animationend', (event) => {
+      if (event.target === logoutDialog && event.animationName === 'overlay-exit') {
+        logoutDialog.close();
+      }
+    });
+    logoutDialog.addEventListener('close', () => {
+      logoutDialog.classList.remove('is-closing');
+      document.body.classList.remove('dialog-open');
+      logoutLink.focus();
+    });
+
+    orderButton.addEventListener('click', () => {
+      orderingNotice.classList.remove('is-closing');
+      orderingNotice.hidden = false;
+      orderButton.setAttribute('aria-expanded', 'true');
+    });
+
+    function dismissOrderingNotice() {
+      if (!orderingNotice.hidden) orderingNotice.classList.add('is-closing');
+    }
+
+    document.getElementById('dismiss-notice-btn').addEventListener('click', dismissOrderingNotice);
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && !logoutDialog.open) dismissOrderingNotice();
+    });
+    orderingNotice.addEventListener('animationend', (event) => {
+      if (event.target === orderingNotice && event.animationName === 'overlay-exit') {
+        const restoreFocus = orderingNotice.contains(document.activeElement);
+        orderingNotice.hidden = true;
+        orderingNotice.classList.remove('is-closing');
+        orderButton.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) orderButton.focus();
+      }
+    });
+  </script>
