+  <dialog id="logout-dialog" class="overlay-panel" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <div class="overlay-heading">
+      <h2 id="logout-title">Log out?</h2>
+      <button type="button" id="close-dialog-btn" class="close-button" aria-label="Close logout confirmation">&times;</button>
+    </div>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" id="cancel-logout-btn" class="btn btn-secondary" autofocus>Cancel</button>
+      <a href="/logout" id="confirm-logout-btn" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <aside id="ordering-notice" class="overlay-panel" popover="manual" aria-labelledby="ordering-title" hidden>
+    <div class="overlay-heading">
+      <h2 id="ordering-title">Ordering update</h2>
+      <button type="button" id="close-notice-btn" class="close-button" aria-label="Dismiss ordering update">&times;</button>
+    </div>
+    <p role="status">online ordering is currently offline</p>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const orderingNotice = document.getElementById('ordering-notice');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+
+    if (!supportsPopover) orderingNotice.removeAttribute('popover');
+
+    // Keep overlays in the top layer until CSS exits (including the backdrop)
+    // finish, even where discrete display/overlay transitions are unsupported.
+    async function closeOverlay(element, finish) {
+      if (element.hasAttribute('data-closing')) return;
+      element.setAttribute('data-closing', '');
+      const animations = element.getAnimations({ subtree: true });
+      let timeout;
+      await Promise.race([
+        Promise.allSettled(animations.map((animation) => animation.finished)),
+        new Promise((resolve) => { timeout = setTimeout(resolve, 1000); })
+      ]);
+      clearTimeout(timeout);
+      finish();
+      element.removeAttribute('data-visible');
+      element.removeAttribute('data-closing');
+    }
+
+    logoutLink.addEventListener('click', (event) => {
+      event.preventDefault();
+      if (logoutDialog.open) return;
+      logoutDialog.showModal();
+      logoutDialog.setAttribute('data-visible', '');
+    });
+
+    const dismissLogout = () => closeOverlay(logoutDialog, () => logoutDialog.close());
+    document.getElementById('close-dialog-btn').addEventListener('click', dismissLogout);
+    document.getElementById('cancel-logout-btn').addEventListener('click', dismissLogout);
+    logoutDialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      dismissLogout();
+    });
+    document.getElementById('confirm-logout-btn').addEventListener('click', (event) => {
+      event.preventDefault();
+      closeOverlay(logoutDialog, () => {
+        logoutDialog.close();
+        window.location.assign(logoutLink.href);
+      });
+    });
+
+    const dismissNotice = () => closeOverlay(orderingNotice, () => {
+      const restoreFocus = orderingNotice.contains(document.activeElement);
+      if (supportsPopover) orderingNotice.hidePopover();
+      orderingNotice.hidden = true;
+      orderButton.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) orderButton.focus();
+    });
+
+    orderButton.addEventListener('click', () => {
+      if (!orderingNotice.hidden) {
+        dismissNotice();
+        return;
+      }
+      orderingNotice.hidden = false;
+      if (supportsPopover) orderingNotice.showPopover();
+      orderingNotice.setAttribute('data-visible', '');
+      orderButton.setAttribute('aria-expanded', 'true');
+    });
+    document.getElementById('close-notice-btn').addEventListener('click', dismissNotice);
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && !logoutDialog.open && !orderingNotice.hidden) {
+        dismissNotice();
+      }
+    });
+  </script>
