+    if (!file || req.method !== 'GET') { res.writeHead(404); res.end('Not found'); return; }
+    try { res.setHeader('Content-Type', file[1]); res.end(readFileSync(new URL(file[0], import.meta.url))); }
+    catch { res.writeHead(503); res.end('Run pnpm build before starting the app.'); }
