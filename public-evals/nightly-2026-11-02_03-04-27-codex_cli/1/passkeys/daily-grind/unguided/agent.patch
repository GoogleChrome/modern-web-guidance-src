+async function api(path, input, session, rotate) {
+  if (path === '/api/session') return session.userId && getUser(session.userId) ? account(getUser(session.userId)) : { user: null, passkeys: [] };
+  if (path === '/api/logout') { for (const key of Object.keys(session)) delete session[key]; rotate(); return { ok: true }; }
+  if (path === '/api/register/options') {
+    const values = profile(input);
+    if (db.prepare('SELECT id FROM users WHERE email = ?').get(values.email)) fail('An account with this email already exists. Sign in with your passkey.');
+    const user = { id: randomUUID(), ...values };
+    const name = keyName(input.keyName || 'My first passkey');
+    const options = await registrationOptions(user);
+    setChallenge(session, 'register', options.challenge, { user, name });
