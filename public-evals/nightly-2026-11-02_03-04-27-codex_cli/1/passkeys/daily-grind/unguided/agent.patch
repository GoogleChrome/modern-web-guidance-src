+db.exec(`PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;
+ CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, name TEXT NOT NULL, email TEXT UNIQUE NOT NULL, created INTEGER NOT NULL);
+ CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id), public_key BLOB NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL, name TEXT NOT NULL, created INTEGER NOT NULL, last_used INTEGER);
+ CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, data TEXT NOT NULL, expires INTEGER NOT NULL);`);
+const sessionAge = 1000 * 60 * 60 * 24 * 7;
+const challengeAge = 1000 * 60 * 5;
+const files = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/account', ['index.html', 'text/html; charset=utf-8']],
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+  ['/account.js', ['public/account.js', 'text/javascript; charset=utf-8']],
+]);
+const getUser = id => db.prepare('SELECT * FROM users WHERE id = ?').get(id);
+const keysFor = id => db.prepare('SELECT * FROM passkeys WHERE user_id = ? ORDER BY created DESC').all(id);
+function fail(message, status = 400) { throw Object.assign(new Error(message), { status }); }
+function profile(input) {
+  const name = String(input.name || '').trim();
+  const email = String(input.email || '').trim().toLowerCase();
+  if (!name || name.length > 80) fail('Enter your name (up to 80 characters).');
+  if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) fail('Enter a valid email address.');
+  return { name, email };
+}
+function keyName(value) {
+  const name = String(value || '').trim();
+  if (!name || name.length > 60) fail('Give your passkey a name (up to 60 characters).');
+  return name;
+}
+function requireUser(session) {
+  const user = session.userId && getUser(session.userId);
+  if (!user) fail('Please sign in to continue.', 401);
+  return user;
+}
+function requireApproval(session, action) {
+  if (session.approval?.action !== action || session.approval?.expires < Date.now()) fail('Verify with your passkey to continue.', 403);
+}
+function consumeApproval(session, action) {
+  requireApproval(session, action);
+  delete session.approval;
+}
+function takeChallenge(session, purpose) {
+  const pending = session.pending;
+  delete session.pending;
+  if (!pending || pending.purpose !== purpose || pending.expires < Date.now()) fail('This request expired. Please try again.');
+  return pending;
+}
+function setChallenge(session, purpose, challenge, extra = {}) {
+  session.pending = { purpose, challenge, expires: Date.now() + challengeAge, ...extra };
+}
+function account(user) {
+  return { user: { name: user.name, email: user.email, created: user.created }, passkeys: keysFor(user.id).map(k => ({ id: k.id, name: k.name, created: k.created, lastUsed: k.last_used, transports: JSON.parse(k.transports) })) };
+}
+function registrationOptions(user, keys = []) {
+  return generateRegistrationOptions({ rpName: 'The Daily Grind', rpID, userID: new TextEncoder().encode(user.id), userName: user.email, userDisplayName: user.name, attestationType: 'none', excludeCredentials: keys.map(k => ({ id: k.id, transports: JSON.parse(k.transports) })), authenticatorSelection: { residentKey: 'required', userVerification: 'required' } });
+}
+function saveKey(userId, info, name) {
+  const { credential } = info;
+  db.prepare('INSERT INTO passkeys (id,user_id,public_key,counter,transports,name,created) VALUES (?,?,?,?,?,?,?)').run(credential.id, userId, Buffer.from(credential.publicKey), credential.counter, JSON.stringify(credential.transports || []), name, Date.now());
