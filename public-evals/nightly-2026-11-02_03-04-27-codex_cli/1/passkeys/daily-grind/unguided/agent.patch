+import { startRegistration, startAuthentication, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+
+const $ = selector => document.querySelector(selector);
+const dialog = $('#account-dialog');
+const content = $('#dialog-content');
+let state = { user: null, passkeys: [] };
+let tab = 'overview';
+let busy = false;
+let toastTimer;
+let cancelDialog;
+const escape = value => String(value).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]);
+const icon = (name, className = 'icon') => `<svg class="${className}" aria-hidden="true"><use href="#i-${name}"/></svg>`;
+const date = timestamp => new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(timestamp));
+function toast(message, error = false) {
+  const node = $('#toast');
+  clearTimeout(toastTimer);
+  node.classList.toggle('error-toast', error);
+  node.querySelector('span').textContent = message;
+  node.hidden = false;
+  toastTimer = setTimeout(() => { node.hidden = true; }, 5500);
+}
+async function api(path, data) {
+  let response;
+  try {
+    response = await fetch(`/api/${path}`, { method: data === undefined ? 'GET' : 'POST', credentials: 'same-origin', headers: data === undefined ? {} : { 'Content-Type': 'application/json' }, ...(data === undefined ? {} : { body: JSON.stringify(data) }) });
+  } catch { throw new Error('We couldn’t reach your account. Check your connection and try again.'); }
+  if (!response.headers.get('content-type')?.includes('application/json')) throw new Error('Account services aren’t available right now. Please try again later.');
+  const result = await response.json();
+  if (!response.ok) {
+    if (response.status === 401 && state.user) { state = { user: null, passkeys: [] }; render(); }
+    throw new Error(result.error || 'Something went wrong. Please try again.');
+  }
+  $('#service-notice').hidden = true;
+  return result;
+}
+function checkSupport() {
+  if (!window.isSecureContext || !browserSupportsWebAuthn()) {
+    throw new Error('Passkeys need a supported browser on a secure (HTTPS) connection. Try the latest Safari, Chrome, Edge, or Firefox.');
+  }
+}
+function friendlyError(error) {
+  if (['NotAllowedError', 'AbortError', 'ERROR_CEREMONY_ABORTED'].includes(error.name) || /timed out|not allowed|cancelled/i.test(error.message)) return 'The passkey request was cancelled or timed out. You can try again when you’re ready.';
+  if (error.name === 'InvalidStateError') return 'This device already has that passkey. Try another device or a security key.';
+  return error.message || 'We couldn’t complete that request. Please try again.';
+}
+function showError(error) {
+  const message = friendlyError(error);
+  if (dialog.open) {
+    let alert = content.querySelector('.dialog-alert');
+    if (!alert) { alert = document.createElement('div'); alert.className = 'dialog-alert'; alert.setAttribute('role', 'alert'); content.querySelector('h2').after(alert); }
+    alert.textContent = message;
+  } else toast(message, true);
+}
+async function run(button, task, message = 'Please wait…') {
+  if (busy) return;
+  busy = true;
+  const html = button?.innerHTML;
+  if (button) { button.disabled = true; button.textContent = message; }
+  $('#close-dialog').disabled = true;
+  content.setAttribute('aria-busy', 'true');
+  try { await task(); } catch (error) { showError(error); }
+  finally {
+    busy = false;
+    if (button?.isConnected) { button.disabled = false; button.innerHTML = html; }
+    $('#close-dialog').disabled = false;
+    content.removeAttribute('aria-busy');
+  }
+}
+function openDialog(html) {
+  if (busy) return;
+  if (cancelDialog) cancelDialog();
+  content.innerHTML = html;
+  if (!dialog.open) dialog.showModal();
+}
+function closeDialog() {
+  if (busy) return;
+  dialog.close();
+  if (cancelDialog) { cancelDialog(); cancelDialog = null; }
+}
+function finishDialog() { dialog.close(); cancelDialog = null; }
+$('#close-dialog').addEventListener('click', closeDialog);
+dialog.addEventListener('cancel', event => { event.preventDefault(); closeDialog(); });
+dialog.addEventListener('click', event => { if (event.target === dialog && !busy) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) closeDialog(); } });
+function selectTab(next) {
+  tab = next;
+  document.querySelectorAll('.account-nav [data-tab]').forEach(button => {
+    const active = button.dataset.tab === tab;
+    button.classList.toggle('active', active);
+    if (active) button.setAttribute('aria-current', 'page'); else button.removeAttribute('aria-current');
+  });
+  document.querySelectorAll('.member-panel').forEach(panel => { panel.hidden = panel.id !== `panel-${tab}`; });
+  if (!state.user && tab !== 'overview') {
+    const names = { profile: 'Your personal details, all in one place.', passkeys: 'Your passkeys, safe and sound.', security: 'A little peace of mind.' };
+    $('#guest-view .welcome-heading h3').textContent = names[tab];
+    $('#guest-view .welcome-heading p').textContent = 'Sign in or create an account to get started.';
+  } else {
+    $('#guest-view .welcome-heading h3').textContent = 'A warm welcome back.';
+    $('#guest-view .welcome-heading p').textContent = 'Less time signing in. More time for coffee.';
+  }
+}
+document.addEventListener('click', event => {
+  const button = event.target.closest('[data-tab]');
+  if (button) selectTab(button.dataset.tab);
+});
+function render() {
+  const signedIn = Boolean(state.user);
+  $('#guest-view').hidden = signedIn;
+  $('#member-view').hidden = !signedIn;
+  $('#sign-out').hidden = !signedIn;
+  $('#member-name').textContent = signedIn ? state.user.name : 'Hey, coffee lover';
+  $('#member-status').textContent = signedIn ? 'Make yourself at home.' : 'Your next good day starts here.';
+  $('#avatar').innerHTML = signedIn ? escape(state.user.name.split(/\s+/).slice(0, 2).map(name => name[0]).join('').toUpperCase()) : icon('user');
+  if (signedIn) {
+    $('#welcome-name').textContent = `Welcome back, ${state.user.name.split(/\s+/)[0]}.`;
+    $('#profile-name').value = state.user.name;
+    $('#profile-email').value = state.user.email;
+    $('#key-count').textContent = state.passkeys.length;
+    $('#key-badge').textContent = state.passkeys.length;
+    $('#passkey-list').innerHTML = state.passkeys.length ? state.passkeys.map(key => `<div class="key-row"><span class="key-icon">${icon(key.transports.includes('usb') ? 'key' : 'laptop')}</span><div class="key-details"><h4>${escape(key.name)}</h4><p>Added ${date(key.created)} · ${key.lastUsed ? `Last used ${date(key.lastUsed)}` : 'Not used to sign in yet'}</p></div><div class="key-actions"><button class="text-button" data-rename="${escape(key.id)}" aria-label="Rename ${escape(key.name)}">Rename</button><button class="text-button remove" data-remove="${escape(key.id)}" aria-label="Remove ${escape(key.name)}" ${state.passkeys.length === 1 ? 'disabled title="Add another passkey before removing your last one."' : ''}>Remove</button></div></div>`).join('') : '<p class="empty-state">No passkeys saved yet. Add a passkey to protect your account.</p>';
+  }
+  selectTab(tab);
+}
+function register() {
+  openDialog(`<div class="dialog-icon">${icon('coffee')}</div><h2 id="dialog-title">Your next good day<br>starts here.</h2><p class="dialog-description">Make yourself at home. Create your account and a passkey for easy, secure sign-in.</p><form id="register-form"><label>Full name<input name="name" placeholder="Your name" required maxlength="80" autocomplete="name" autofocus></label><label>Email address<input name="email" type="email" placeholder="you@example.com" required maxlength="254" autocomplete="email"><small>Your account identifier. We don't verify email ownership.</small></label><label>Passkey name<input name="keyName" value="My first passkey" required maxlength="60" autocomplete="off"><small>Give it a name you'll recognize, like “Personal laptop”.</small></label><button class="button primary full" type="submit">Create account with a passkey ${icon('arrow')}</button></form><p class="dialog-fineprint">Your device will ask for your face, fingerprint, or PIN.<br>No password. No biometric information shared with us.</p>`);
+  $('#register-form').addEventListener('submit', event => {
+    event.preventDefault();
+    const values = Object.fromEntries(new FormData(event.target));
+    run(event.submitter, async () => {
+      checkSupport();
+      const optionsJSON = await api('register/options', values);
+      const response = await startRegistration({ optionsJSON });
+      state = await api('register/verify', { response });
+      tab = 'overview'; render(); finishDialog(); toast('Welcome to The Daily Grind. Your account is ready.');
+    }, 'Creating your passkey…');
+  });
+}
+$('#open-register').addEventListener('click', register);
+$('#sign-in').addEventListener('click', event => run(event.currentTarget, async () => {
+  checkSupport();
+  const optionsJSON = await api('login/options', {});
+  const response = await startAuthentication({ optionsJSON });
+  state = await api('login/verify', { response });
+  render(); toast('You’re signed in. Good to have you back.');
+}, 'Waiting for your passkey…'));
+function verify(action, task, { title = 'A quick check that it’s you.', description = 'Confirm with a saved passkey before making this change.', label = 'Verify and continue' } = {}) {
+  openDialog(`<div class="dialog-icon"><svg class="fingerprint"><use href="#i-fingerprint"/></svg></div><h2 id="dialog-title">${title}</h2><p class="dialog-description">${description}</p><button id="reauthenticate" class="button primary full">${icon('key')}${label}${icon('arrow')}</button><p class="dialog-fineprint">Use your face, fingerprint, or device PIN.<br>This verification is only for this action.</p>`);
+  $('#reauthenticate').addEventListener('click', event => run(event.currentTarget, async () => {
+    checkSupport();
+    const optionsJSON = await api('reauth/options', { action });
+    const response = await startAuthentication({ optionsJSON });
+    await api('reauth/verify', { response });
+    await task();
+  }, 'Verifying with your passkey…'));
+}
+$('#profile-form').addEventListener('submit', event => {
+  event.preventDefault();
+  const values = Object.fromEntries(new FormData(event.target));
+  if (values.name.trim() === state.user.name && values.email.trim().toLowerCase() === state.user.email) { toast('Your details are already up to date.'); return; }
+  verify('profile', async () => {
+    state = await api('profile', values); render(); finishDialog(); toast('Your personal details have been updated.');
+  }, { description: 'Verify with your passkey to save your updated personal details.' });
+});
+$('#add-passkey').addEventListener('click', () => {
+  openDialog(`<div class="dialog-icon">${icon('key')}</div><h2 id="dialog-title">Another way back in.</h2><p class="dialog-description">Add a passkey on another device, in a passkey manager, or on a security key. First, we'll verify it's you.</p><form id="add-form"><label>Passkey name<input name="name" placeholder="e.g. Work laptop or backup key" required maxlength="60" autocomplete="off" autofocus></label><button class="button primary full" type="submit">Continue ${icon('arrow')}</button></form>`);
+  $('#add-form').addEventListener('submit', event => {
+    event.preventDefault();
+    const name = new FormData(event.target).get('name').trim();
+    if (!name) return;
+    verify('add', async () => {
+      // Use a separate click for the second ceremony so browsers retain user activation.
+      finishDialog();
+      content.innerHTML = `<div class="dialog-icon">${icon('plus')}</div><h2 id="dialog-title">Let's create your passkey.</h2><p class="dialog-description">You’re verified. Save <strong>${escape(name)}</strong> using your device's passkey options. Choose another device or a security key if you already have a passkey on this device.</p><button id="create-extra-key" class="button primary full">${icon('key')}Create passkey${icon('arrow')}</button><p class="dialog-fineprint">Complete this step within five minutes.</p>`;
+      dialog.showModal();
+      $('#create-extra-key').addEventListener('click', click => run(click.currentTarget, async () => {
+        checkSupport();
+        const optionsJSON = await api('passkeys/options', { name });
+        const response = await startRegistration({ optionsJSON });
+        state = await api('passkeys/verify', { response });
+        render(); finishDialog(); toast('Your new passkey is ready to use.');
+      }, 'Creating your passkey…'));
+    }, { description: `Verify with an existing passkey before adding “${escape(name)}”.` });
+  });
+});
+$('#passkey-list').addEventListener('click', event => {
+  const rename = event.target.closest('[data-rename]');
+  const remove = event.target.closest('[data-remove]');
+  if (!rename && !remove) return;
+  const key = state.passkeys.find(item => item.id === (rename?.dataset.rename || remove?.dataset.remove));
+  if (!key) return;
+  if (rename) {
+    openDialog(`<div class="dialog-icon">${icon('key')}</div><h2 id="dialog-title">Give it a familiar name.</h2><p class="dialog-description">Choose a name that helps you recognize this passkey.</p><form id="rename-form"><label>Passkey name<input name="name" value="${escape(key.name)}" required maxlength="60" autofocus></label><button class="button primary full" type="submit">Save passkey name ${icon('arrow')}</button></form>`);
+    $('#rename-form').addEventListener('submit', event => {
+      event.preventDefault();
+      const name = new FormData(event.target).get('name').trim();
+      if (name === key.name) { closeDialog(); return; }
+      verify('rename', async () => { state = await api('passkeys/rename', { id: key.id, name }); render(); finishDialog(); toast('Passkey renamed.'); }, { description: 'Confirm with your passkey to save its new name.' });
+    });
+  } else {
+    if (state.passkeys.length < 2) { toast('Add another passkey before removing your last one.', true); return; }
+    openDialog(`<div class="dialog-icon">${icon('key')}</div><h2 id="dialog-title">Remove this passkey?</h2><p class="dialog-description">You won’t be able to sign in with <strong>${escape(key.name)}</strong> anymore. Your other saved passkeys will still work. This only removes it from your Daily Grind account; you can also delete it from your device or passkey manager.</p><div class="dialog-actions"><button id="cancel-remove" class="button secondary">Keep passkey</button><button id="confirm-remove" class="button danger">Remove passkey</button></div>`);
+    $('#cancel-remove').addEventListener('click', closeDialog);
+    $('#confirm-remove').addEventListener('click', () => verify('remove', async () => {
+      state = await api('passkeys/remove', { id: key.id }); render(); finishDialog(); toast('Passkey removed from your account.');
+    }, { description: `Verify with a saved passkey to remove “${escape(key.name)}” from your account.` }));
+  }
+});
+$('#verify-identity').addEventListener('click', () => verify('verify', async () => {
+  finishDialog(); $('#verified-at').textContent = `Identity confirmed at ${new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}.`; toast('Verified. Your passkey is working.');
+}, { title: 'A little peace of mind.', description: 'Use a saved passkey to confirm your identity and check that it works.', label: 'Verify with a passkey' }));
+async function signOut(event) {
+  run(event.currentTarget, async () => {
+    await api('logout', {}); state = { user: null, passkeys: [] }; tab = 'overview'; render(); toast('You’re signed out. See you for your next cup.');
+  }, 'Signing out…');
+}
+$('#sign-out').addEventListener('click', signOut);
+$('#security-sign-out').addEventListener('click', signOut);
+$('#learn-passkeys').addEventListener('click', () => {
+  openDialog(`<div class="dialog-icon"><svg class="fingerprint"><use href="#i-fingerprint"/></svg></div><h2 id="dialog-title">Your familiar way in.</h2><p class="dialog-description">A passkey replaces your password with a secure key, saved by your device or passkey manager.</p><div class="dialog-steps"><div><span class="step-number">1</span><div><strong>Make yourself at home.</strong><p>Create an account and save a passkey. Your device will guide you through it.</p></div></div><div><span class="step-number">2</span><div><strong>A face, a fingerprint, or a PIN.</strong><p>Sign in the same way you unlock your device. Your biometric information is never sent to us.</p></div></div><div><span class="step-number">3</span><div><strong>Ready for your everyday.</strong><p>Sync through your passkey provider or use another device or security key. We recommend a backup passkey.</p></div></div></div><button id="got-it" class="button primary full">Got it ${icon('check')}</button><p class="dialog-fineprint">Lost access to all your passkeys? There is no email or password recovery, so keep a backup.</p>`);
+  $('#got-it').addEventListener('click', closeDialog);
+});
+$('#privacy-info').addEventListener('click', () => {
+  openDialog(`<div class="dialog-icon">${icon('shield')}</div><h2 id="dialog-title">A little privacy, please.</h2><p class="dialog-description">We store your name, email address, passkey public keys, passkey names, and creation and last-use dates to provide your account. Your private keys and biometric information stay with your device or passkey provider.</p><p class="dialog-description">An essential, HTTP-only session cookie keeps you signed in for up to seven days. Signing out ends this session. Coffee photos and fonts load from Unsplash and Google Fonts.</p><button id="privacy-close" class="button primary full">Got it ${icon('check')}</button>`);
+  $('#privacy-close').addEventListener('click', closeDialog);
+});
+render();
+api('session').then(result => { state = result; render(); }).catch(() => {
+  $('#service-notice').textContent = 'Account services are currently unavailable. You can explore the page and try again shortly.';
+  $('#service-notice').hidden = false;
+});
