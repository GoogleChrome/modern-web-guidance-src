diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..6aef9fe
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,111 @@
+import type { PublicKeyCredentialCreationOptionsJSON, PublicKeyCredentialRequestOptionsJSON } from '@simplewebauthn/server';
+
+export interface AccountData {
+  user: { id: string; username: string; displayName: string } | null;
+  rpId: string;
+  verifiedUntil: number;
+  passkeys: Array<{
+    id: string; name: string; aaguid: string; deviceType: string; backedUp: boolean;
+    registeredAt: number; lastUsedAt?: number;
+  }>;
+}
+
+type WebAuthnAPI = typeof PublicKeyCredential & {
+  getClientCapabilities(): Promise<Record<string, boolean>>;
+  parseCreationOptionsFromJSON(options: PublicKeyCredentialCreationOptionsJSON): PublicKeyCredentialCreationOptions;
+  parseRequestOptionsFromJSON(options: PublicKeyCredentialRequestOptionsJSON): PublicKeyCredentialRequestOptions;
+  signalUnknownCredential?: (options: { rpId: string; credentialId: string }) => Promise<void>;
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (options: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+const webauthn = () => PublicKeyCredential as WebAuthnAPI;
+export const accountUrl = `${import.meta.env.BASE_URL}account/settings`;
+export class ApiError extends Error {
+  constructor(message: string, public status: number, public code?: string) { super(message); }
+}
+
+export async function authRequest<T = Record<string, unknown>>(action: string, body?: unknown, signal?: AbortSignal): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/auth/${action}`, {
+    method: body === undefined ? 'GET' : 'POST', credentials: 'same-origin',
+    headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body), signal,
+  });
+  const data = await response.json();
+  if (!response.ok) throw new ApiError(data.error || 'Please try again.', response.status, data.code);
+  return data;
+}
+
+export async function passkeyCapabilities() {
+  if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials) {
+    return { supported: false, create: false, conditional: false };
+  }
+  // This module is also rendered on the server; load browser polyfills only here.
+  await import('webauthn-polyfills');
+  try {
+    const capabilities = await webauthn().getClientCapabilities();
+    return { supported: true, create: !!capabilities.passkeyPlatformAuthenticator && !!capabilities.conditionalGet, conditional: !!capabilities.conditionalGet };
+  } catch {
+    return { supported: true, create: false, conditional: false };
+  }
+}
+
+export function passkeyError(error: unknown): string {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError') return 'The passkey request was cancelled or timed out. You can try again or use your password.';
+    if (error.name === 'InvalidStateError') return 'A passkey already exists in this password manager. Try a different provider or security key.';
+    if (error.name === 'AbortError') return 'The passkey request was cancelled. Please try again.';
+    if (error.name === 'SecurityError') return 'Passkeys require a secure connection on this site. Please use your password for now.';
+    if (error.name === 'NotSupportedError') return 'This device cannot create this passkey. Please try another device or use your password.';
+  }
+  return error instanceof ApiError ? error.message : 'We could not complete the request. Check your connection and try again.';
+}
+
+type Options<T> = { options: T; ceremonyId: string; rpId: string };
+type JsonCredential = PublicKeyCredential & { toJSON(): { id: string } };
+async function signalUnknown(rpId: string, credentialId: string) {
+  try { await webauthn().signalUnknownCredential?.({ rpId, credentialId }); } catch { /* Optional password-manager sync. */ }
+}
+
+export async function registerPasskey(promotion = false, signal?: AbortSignal) {
+  const { options, ceremonyId, rpId } = await authRequest<Options<PublicKeyCredentialCreationOptionsJSON>>('registration/options', { promotion }, signal);
+  const credential = await navigator.credentials.create({
+    publicKey: webauthn().parseCreationOptionsFromJSON(options), signal,
+  }) as JsonCredential | null;
+  if (!credential) throw new DOMException('No passkey created.', 'NotAllowedError');
+  const encoded = credential.toJSON();
+  try {
+    await authRequest('registration/verify', { ceremonyId, credential: encoded }, signal);
+  } catch (error) {
+    // A transport failure may have happened after a successful server commit.
+    // Only signal when the server explicitly rejected the registration.
+    if (error instanceof ApiError && error.status !== 409) await signalUnknown(rpId, encoded.id);
+    throw error;
+  }
+}
+
+export async function authenticatePasskey(kind: 'authentication' | 'reauthentication' = 'authentication', conditional = false, signal?: AbortSignal) {
+  const { options, ceremonyId, rpId } = await authRequest<Options<PublicKeyCredentialRequestOptionsJSON>>(`${kind}/options`, {}, signal);
+  const credential = await navigator.credentials.get({
+    publicKey: webauthn().parseRequestOptionsFromJSON(options),
+    ...(conditional ? { mediation: 'conditional' as const } : {}), signal,
+  }) as JsonCredential | null;
+  if (!credential) throw new DOMException('No passkey selected.', 'NotAllowedError');
+  const encoded = credential.toJSON();
+  try {
+    return await authRequest(`${kind}/verify`, { ceremonyId, credential: encoded }, signal);
+  } catch (error) {
+    if (kind === 'authentication' && error instanceof ApiError && error.status === 404) await signalUnknown(rpId, encoded.id);
+    throw error;
+  }
+}
+
+export async function syncPasskeys(data: AccountData, profile = false) {
+  if (!data.user || !window.PublicKeyCredential) return;
+  try {
+    if (profile) {
+      await webauthn().signalCurrentUserDetails?.({ rpId: data.rpId, userId: data.user.id, name: data.user.username, displayName: data.user.displayName });
+    } else {
+      await webauthn().signalAllAcceptedCredentials?.({ rpId: data.rpId, userId: data.user.id, allAcceptedCredentialIds: data.passkeys.map(p => p.id) });
+    }
+  } catch { /* Unsupported or unavailable manager: account changes still succeeded. */ }
+}
