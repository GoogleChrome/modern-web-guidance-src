+import {
+  generateRegistrationOptions, verifyRegistrationResponse,
+  generateAuthenticationOptions, verifyAuthenticationResponse,
+  type AuthenticationResponseJSON, type RegistrationResponseJSON,
+} from '@simplewebauthn/server';
+import { authTransaction, type Account, type Ceremony } from '../../../lib/auth-store';
+
+const PASSWORD_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+const FIVE_MINUTES = 5 * 60 * 1000;
+class AuthError extends Error {
+  constructor(message: string, public status = 400, public code?: string) { super(message); }
+}
+const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+
+async function passwordRequest(action: 'login' | 'register', username: string, password: string) {
+  let response: Response;
+  try {
+    response = await fetch(`${PASSWORD_API}/${action}`, {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }), signal: AbortSignal.timeout(15000),
+    });
+  } catch {
+    throw new AuthError('The password service is unavailable. Please try again.', 503);
+  }
+  if (!response.ok) throw new AuthError(action === 'login'
+    ? 'The username or password is incorrect. Please try again.'
+    : 'Could not create your account. Try a different username and a password with at least 8 characters and a number.', 400);
+}
+
+export const ALL: APIRoute = async ({ request, params, session, url }) => {
+  try {
+    if (!session) throw new AuthError('Account sessions are unavailable.', 503);
+    const action = params.action;
+    const origin = process.env.AUTH_ORIGIN || url.origin;
+    const rpId = new URL(origin).hostname;
+    if (request.method !== 'GET' && request.headers.get('Origin') !== origin) {
+      throw new AuthError('This request must come from this site.', 403);
+    }
+    const methods: Record<string, string> = {
+      session: 'GET', login: 'POST', register: 'POST', logout: 'POST',
+      'password/reauthenticate': 'POST', 'registration/options': 'POST',
+      'registration/verify': 'POST', 'authentication/options': 'POST',
+      'authentication/verify': 'POST', 'reauthentication/options': 'POST',
+      'reauthentication/verify': 'POST', passkeys: 'GET',
+      'passkeys/rename': 'POST', 'passkeys/delete': 'POST', profile: 'POST',
+    };
+    if (!action || !methods[action]) throw new AuthError('Not found.', 404);
+    if (methods[action] !== request.method) throw new AuthError('Method not allowed.', 405);
+    let body: Record<string, any> = {};
+    if (request.method !== 'GET') {
+      if (!request.headers.get('Content-Type')?.includes('application/json')) throw new AuthError('Expected JSON.', 415);
+      const raw = await request.text();
+      if (raw.length > 65536) throw new AuthError('Request too large.', 413);
+      try { body = JSON.parse(raw); } catch { throw new AuthError('Invalid request.'); }
+      if (!body || typeof body !== 'object' || Array.isArray(body)) throw new AuthError('Invalid request.');
+    }
+    return await authTransaction(async store => {
+      const auth = await session.get<{ userId: string; verifiedAt: number }>('auth');
+      const user = store.users.find(u => u.id === auth?.userId);
+      const requireUser = () => {
+        if (!user) throw new AuthError('Please sign in to continue.', 401);
+        return user;
+      };
+      const requireRecent = () => {
+        requireUser();
+        if (!auth || Date.now() - auth.verifiedAt > FIVE_MINUTES) {
+          throw new AuthError('Verify your identity to continue.', 403, 'REAUTH_REQUIRED');
+        }
+      };
+      const establish = async (account: Account) => {
+        await session.regenerate();
+        session.set('auth', { userId: account.id, verifiedAt: Date.now() });
+      };
+      const saveCeremony = (kind: Ceremony['kind'], challenge: string, userId?: string) => {
+        const id = randomUUID();
+        // Replace an older prompt of the same kind in this browser session.
+        for (const [key, entry] of Object.entries(store.ceremonies)) {
+          if (entry.sessionId === session.sessionID && entry.kind === kind) delete store.ceremonies[key];
+        }
+        if (!session.sessionID) session.set('passkeyFlow', true);
+        store.ceremonies[id] = { kind, challenge, sessionId: session.sessionID!, userId,
+          expires: Date.now() + FIVE_MINUTES, requireUserVerification: true };
+        return id;
+      };
+      const consumeCeremony = (kind: Ceremony['kind']) => {
+        const entry = store.ceremonies[body.ceremonyId];
+        if (!entry || entry.kind !== kind || entry.sessionId !== session.sessionID || entry.expires < Date.now()) {
+          throw new AuthError('This passkey request expired. Please try again.', 400);
+        }
+        delete store.ceremonies[body.ceremonyId];
+        return entry;
+      };
+      const accountData = () => ({
+        user: user ? { ...user } : null, rpId,
+        verifiedUntil: auth ? auth.verifiedAt + FIVE_MINUTES : 0,
+        passkeys: user ? store.passkeys.filter(p => p.userId === user.id).map(({ publicKey, counter, userId, ...p }) => p) : [],
+      });
+      if (action === 'session') return json(accountData());
+      if (action === 'logout') { session.destroy(); return json({ ok: true }); }
+      if (action === 'login' || action === 'register') {
+        const { username, password } = body;
+        if (typeof username !== 'string' || !username.trim() || username.length > 128 || typeof password !== 'string' || !password || password.length > 1024) {
+          throw new AuthError('Enter your username and password.');
+        }
+        if (action === 'register') {
+          if (password.length < 8 || !/\d/.test(password)) throw new AuthError('Use at least 8 characters and a number.');
+          await passwordRequest('register', username.trim(), password);
+        }
+        // Establish local identity only after the existing password service verifies it.
+        try {
+          await passwordRequest('login', username.trim(), password);
+        } catch (error) {
+          if (action === 'register') throw new AuthError('Your account was created, but we could not sign you in. Use the Sign in link below to continue.', 503);
+          throw error;
+        }
+        let account = store.users.find(u => u.username === username.trim());
+        if (!account) {
+          account = { id: randomBytes(32).toString('base64url'), username: username.trim(), displayName: username.trim() };
+          store.users.push(account);
+        }
+        await establish(account);
+        return json({ user: account });
+      }
+      if (action === 'password/reauthenticate') {
+        const account = requireUser();
+        if (typeof body.password !== 'string' || !body.password || body.password.length > 1024) throw new AuthError('Enter your password.');
+        await passwordRequest('login', account.username, body.password);
+        session.set('auth', { userId: account.id, verifiedAt: Date.now() });
+        return json({ ok: true });
+      }
+      if (action === 'registration/options') {
+        const account = requireUser();
+        requireRecent();
+        const options = await generateRegistrationOptions({
+          rpName: 'The DevTools Times', rpID: rpId,
+          userID: new Uint8Array(Buffer.from(account.id, 'base64url')),
+          userName: account.username, userDisplayName: account.displayName,
+          attestationType: 'none',
+          excludeCredentials: store.passkeys.filter(p => p.userId === account.id).map(p => ({ id: p.id, transports: p.transports })),
+          authenticatorSelection: {
+            residentKey: 'required', requireResidentKey: true, userVerification: 'required',
+            ...(body.promotion === true ? { authenticatorAttachment: 'platform' as const } : {}),
+          },
+        });
+        return json({ options, ceremonyId: saveCeremony('registration', options.challenge, account.id), rpId });
+      }
+      if (action === 'registration/verify') {
+        const account = requireUser();
+        const ceremony = consumeCeremony('registration');
+        if (ceremony.userId !== account.id) throw new AuthError('Account mismatch.', 403);
+        const result = await verifyRegistrationResponse({
+          response: body.credential as RegistrationResponseJSON, expectedChallenge: ceremony.challenge,
+          expectedOrigin: origin, expectedRPID: rpId, requireUserVerification: ceremony.requireUserVerification,
+        }).catch(() => { throw new AuthError('Could not verify this passkey. Please try again.'); });
+        if (!result.verified) throw new AuthError('Could not verify this passkey.');
+        const info = result.registrationInfo;
+        if (store.passkeys.some(p => p.id === info.credential.id)) throw new AuthError('This passkey is already registered.', 409);
+        store.passkeys.push({
+          id: info.credential.id, userId: account.id,
+          publicKey: Buffer.from(info.credential.publicKey).toString('base64url'),
+          counter: info.credential.counter, transports: info.credential.transports,
+          name: 'My passkey', aaguid: info.aaguid, deviceType: info.credentialDeviceType,
+          backedUp: info.credentialBackedUp, registeredAt: Date.now(),
+        });
+        return json({ ok: true });
+      }
+      if (action === 'authentication/options' || action === 'reauthentication/options') {
+        const reauth = action.startsWith('reauthentication');
+        const account = reauth ? requireUser() : undefined;
+        const keys = store.passkeys.filter(p => p.userId === account?.id);
+        if (reauth && !keys.length) throw new AuthError('No passkeys yet. Verify with your password instead.');
+        const options = await generateAuthenticationOptions({
+          rpID: rpId, userVerification: 'required',
+          allowCredentials: reauth ? keys.map(p => ({ id: p.id, transports: p.transports })) : [],
+        });
+        return json({ options, ceremonyId: saveCeremony(reauth ? 'reauthentication' : 'authentication', options.challenge, account?.id), rpId });
+      }
+      if (action === 'authentication/verify' || action === 'reauthentication/verify') {
+        const reauth = action.startsWith('reauthentication');
+        if (reauth) requireUser();
+        const ceremony = consumeCeremony(reauth ? 'reauthentication' : 'authentication');
+        const credential = body.credential as AuthenticationResponseJSON;
+        const key = store.passkeys.find(p => p.id === credential?.id);
+        if (!key) throw new AuthError('This passkey is no longer registered. Try another passkey or your password.', 404);
+        if (reauth && (key.userId !== user!.id || ceremony.userId !== user!.id)) throw new AuthError('Use a passkey for your current account.', 403);
+        if (credential.response.userHandle && credential.response.userHandle !== key.userId) throw new AuthError('Passkey account mismatch.', 403);
+        const account = store.users.find(u => u.id === key.userId);
+        if (!account) throw new AuthError('Account unavailable.', 401);
+        const result = await verifyAuthenticationResponse({
+          response: credential, expectedChallenge: ceremony.challenge, expectedOrigin: origin, expectedRPID: rpId,
+          credential: { id: key.id, publicKey: new Uint8Array(Buffer.from(key.publicKey, 'base64url')), counter: key.counter, transports: key.transports },
+          requireUserVerification: ceremony.requireUserVerification,
+        }).catch(() => { throw new AuthError('Could not verify this passkey. Please try again.'); });
+        if (!result.verified) throw new AuthError('Could not verify this passkey.', 401);
+        key.counter = result.authenticationInfo.newCounter;
+        key.backedUp = result.authenticationInfo.credentialBackedUp;
+        key.lastUsedAt = Date.now();
+        await establish(account);
+        return json({ user: account });
+      }
+      requireUser();
+      if (action === 'passkeys') return json(accountData());
+      requireRecent();
+      if (action === 'profile') {
+        if (typeof body.displayName !== 'string' || !body.displayName.trim() || body.displayName.trim().length > 80) throw new AuthError('Use a display name between 1 and 80 characters.');
+        user!.displayName = body.displayName.trim();
+        return json(accountData());
+      }
+      const key = store.passkeys.find(p => p.id === body.id && p.userId === user!.id);
+      if (!key) throw new AuthError('Passkey not found.', 404);
+      if (action === 'passkeys/rename') {
+        if (typeof body.name !== 'string' || !body.name.trim() || body.name.trim().length > 60) throw new AuthError('Use a passkey name between 1 and 60 characters.');
+        key.name = body.name.trim();
+      } else if (action === 'passkeys/delete') {
+        store.passkeys = store.passkeys.filter(p => p.id !== key.id);
+      }
+      return json(accountData());
+    });
+  } catch (error) {
+    if (error instanceof AuthError) return json({ error: error.message, code: error.code }, error.status);
+    console.error('Account request failed:', error instanceof Error ? error.message : 'Unknown error');
+    return json({ error: 'We could not complete this request. Please try again.' }, 500);
+  }
+};
