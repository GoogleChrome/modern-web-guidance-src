+++ b/src/lib/auth-store.ts
@@ -0,0 +1,68 @@
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { randomUUID } from 'node:crypto';
+
+export interface Account {
+  id: string;
+  username: string;
+  displayName: string;
+}
+
+export interface Passkey {
+  id: string;
+  userId: string;
+  publicKey: string;
+  counter: number;
+  transports?: string[];
+  name: string;
+  aaguid: string;
+  deviceType: string;
+  backedUp: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export interface Ceremony {
+  challenge: string;
+  sessionId: string;
+  kind: 'registration' | 'authentication' | 'reauthentication';
+  userId?: string;
+  expires: number;
+  requireUserVerification: boolean;
+}
+
+interface AuthStore {
+  users: Account[];
+  passkeys: Passkey[];
+  ceremonies: Record<string, Ceremony>;
+}
+
+// Single-process sample storage. Keep this file on a persistent volume, or replace
+// this transaction with a shared transactional database before scaling out.
+let queue: Promise<unknown> = Promise.resolve();
+export function authTransaction<T>(run: (store: AuthStore) => Promise<T>): Promise<T> {
+  const result = queue.then(async () => {
+    const file = resolve(process.env.AUTH_STORE_PATH || '.data/auth.json');
+    let store: AuthStore;
+    try {
+      store = JSON.parse(await readFile(file, 'utf8'));
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+      store = { users: [], passkeys: [], ceremonies: {} };
+    }
+    for (const [id, ceremony] of Object.entries(store.ceremonies)) {
+      if (ceremony.expires < Date.now()) delete store.ceremonies[id];
+    }
+    // Persist consumed challenges even when verification fails.
+    try {
+      return await run(store);
+    } finally {
+      await mkdir(dirname(file), { recursive: true, mode: 0o700 });
+      const temporary = `${file}.${randomUUID()}.tmp`;
+      await writeFile(temporary, JSON.stringify(store), { mode: 0o600 });
+      await rename(temporary, file);
+    }
+  });
+  queue = result.catch(() => {});
+  return result;
+}
