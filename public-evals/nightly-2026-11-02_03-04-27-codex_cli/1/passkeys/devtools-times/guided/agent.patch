new file mode 100644
index 0000000..d562486
--- /dev/null
+++ b/src/components/ReauthenticationDialog.tsx
@@ -0,0 +1,49 @@
+import { useEffect, useRef, useState } from 'react';
+import { KeyIcon, ShieldCheckIcon } from '@heroicons/react/24/outline';
+import { authenticatePasskey, authRequest, passkeyError } from '../lib/passkeys';
+
+export default function ReauthenticationDialog({ title, description, username, canUsePasskey, onVerified, onDismiss }: {
+  title: string; description: string; username: string; canUsePasskey: boolean;
+  onVerified: () => void; onDismiss: () => void;
+}) {
+  const dialog = useRef<HTMLDialogElement>(null);
+  const request = useRef<AbortController | null>(null);
+  const [password, setPassword] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  useEffect(() => {
+    const element = dialog.current!;
+    element.showModal();
+    return () => { request.current?.abort(); element.close(); };
+  }, []);
+
+  async function verify(method: 'passkey' | 'password') {
+    setBusy(true); setError('');
+    const controller = new AbortController();
+    request.current = controller;
+    try {
+      if (method === 'passkey') await authenticatePasskey('reauthentication', false, controller.signal);
+      else await authRequest('password/reauthenticate', { password }, controller.signal);
+      if (!controller.signal.aborted) { setPassword(''); onVerified(); }
+    } catch (error) {
+      if (!controller.signal.aborted) { setError(passkeyError(error)); setBusy(false); }
+    }
+  }
+
+  return <dialog ref={dialog} className="account-dialog" aria-labelledby="verify-title" aria-describedby="verify-description" onClose={onDismiss}>
+    <ShieldCheckIcon className="size-9 mb-4" aria-hidden="true" />
+    <h2 id="verify-title">{title}</h2>
+    <p id="verify-description" className="auth-description">{description}</p>
+    {error && <p className="account-notice account-error" role="alert">{error}</p>}
+    {canUsePasskey && <>
+      <button type="button" className="account-button account-button-primary w-full" disabled={busy} onClick={() => void verify('passkey')}><KeyIcon className="size-5" aria-hidden="true" />{busy ? 'Verifying…' : 'Verify with a passkey'}</button>
+      <div className="auth-divider"><span>or use your password</span></div>
+    </>}
+    <form className="account-form" onSubmit={e => { e.preventDefault(); void verify('password'); }} aria-busy={busy}>
+      <input type="hidden" name="username" autoComplete="username" value={username} />
+      <div><label htmlFor="reauth-password">Current password</label><input type="password" id="reauth-password" name="password" autoComplete="current-password" value={password} onChange={e => setPassword(e.target.value)} required disabled={busy} /></div>
+      <button className="account-button account-button-secondary w-full" type="submit" disabled={busy}>{busy ? 'Verifying…' : 'Verify with password'}</button>
+    </form>
+    <form method="dialog" className="mt-3"><button type="submit" className="account-button account-button-quiet w-full" autoFocus>Cancel</button></form>
+  </dialog>;
+}
