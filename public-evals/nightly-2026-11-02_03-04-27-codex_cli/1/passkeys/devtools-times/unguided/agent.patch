new file mode 100644
index 0000000..4cc831e
--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,102 @@
+const API = import.meta.env.PUBLIC_AUTH_API_URL || 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+export const accountUrl = `${import.meta.env.BASE_URL}account/settings`;
+export type Passkey = { id: string; name: string; createdAt: string; lastUsedAt?: string; deviceType?: string };
+type CredentialDescriptorJSON = Omit<PublicKeyCredentialDescriptor, 'id'> & { id: string };
+type CreationOptionsJSON = Omit<PublicKeyCredentialCreationOptions, 'challenge' | 'user' | 'excludeCredentials'> & {
+  challenge: string;
+  user: Omit<PublicKeyCredentialUserEntity, 'id'> & { id: string };
+  excludeCredentials?: CredentialDescriptorJSON[];
+};
+type RequestOptionsJSON = Omit<PublicKeyCredentialRequestOptions, 'challenge' | 'allowCredentials'> & {
+  challenge: string;
+  allowCredentials?: CredentialDescriptorJSON[];
+};
+
+export async function request<T = Record<string, unknown>>(path: string, body?: unknown, method = 'POST'): Promise<T> {
+  const token = sessionStorage.getItem('times-token');
+  const controller = new AbortController();
+  const timeout = window.setTimeout(() => controller.abort(), 20000);
+  try {
+  const response = await fetch(`${API.replace(/\/$/, '')}${path}`, {
+    method, credentials: 'include',
+    signal: controller.signal,
+    headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    if (response.status === 401) throw new Error(path === '/login' ? 'Your username or password wasn’t recognized. Please try again.' : 'Please sign in again to manage your account.');
+    if (response.status === 404) throw new Error('This service is currently unavailable. Please try again later.');
+    throw new Error(typeof data.message === 'string' ? data.message : 'We couldn’t complete your request. Please try again.');
+  }
+  return data;
+  } catch (error) {
+    if (controller.signal.aborted) throw new Error('The service took too long to respond. Please try again.');
+    if (error instanceof TypeError) throw new Error('We couldn’t reach the service. Check your connection and try again.');
+    throw error;
+  } finally {
+    window.clearTimeout(timeout);
+  }
+}
+export function saveSession(data: { token?: string }) {
+  if (data.token) sessionStorage.setItem('times-token', data.token);
+}
+export function supportsPasskeys() {
+  return window.isSecureContext && typeof window.PublicKeyCredential !== 'undefined' && !!navigator.credentials;
+}
+function decode(value: string): ArrayBuffer {
+  const binary = atob(value.replace(/-/g, '+').replace(/_/g, '/'));
+  return Uint8Array.from(binary, c => c.charCodeAt(0)).buffer;
+}
+function encode(value: ArrayBuffer) {
+  return btoa(String.fromCharCode(...new Uint8Array(value))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+function serialize(credential: PublicKeyCredential) {
+  const response = credential.response;
+  return {
+    id: credential.id, rawId: encode(credential.rawId), type: credential.type,
+    authenticatorAttachment: credential.authenticatorAttachment,
+    clientExtensionResults: credential.getClientExtensionResults(),
+    response: response instanceof AuthenticatorAttestationResponse ? {
+      clientDataJSON: encode(response.clientDataJSON), attestationObject: encode(response.attestationObject),
+      transports: response.getTransports?.() ?? [],
+    } : {
+      clientDataJSON: encode(response.clientDataJSON),
+      authenticatorData: encode((response as AuthenticatorAssertionResponse).authenticatorData),
+      signature: encode((response as AuthenticatorAssertionResponse).signature),
+      userHandle: (response as AuthenticatorAssertionResponse).userHandle ? encode((response as AuthenticatorAssertionResponse).userHandle!) : null,
+    },
+  };
+}
+export async function passkeyFlow(kind: 'register' | 'authenticate' | 'reauthenticate', details: { username?: string; name?: string; verificationToken?: string } = {}) {
+  if (!supportsPasskeys()) throw new Error('Passkeys require a supported browser and a secure connection. You can still use your password.');
+  const result = await request<{ options: CreationOptionsJSON | RequestOptionsJSON; challengeId: string }>(`/passkeys/${kind}/options`, details);
+  const { challengeId } = result;
+  let credential: Credential | null;
+  if (kind === 'register') {
+    const options = result.options as CreationOptionsJSON;
+    credential = await navigator.credentials.create({ publicKey: {
+      ...options, timeout: options.timeout ?? 60000,
+      challenge: decode(options.challenge), user: { ...options.user, id: decode(options.user.id) },
+      excludeCredentials: options.excludeCredentials?.map(c => ({ ...c, id: decode(c.id) })),
+    } });
+  } else {
+    const options = result.options as RequestOptionsJSON;
+    credential = await navigator.credentials.get({ publicKey: {
+      ...options, timeout: options.timeout ?? 60000, challenge: decode(options.challenge),
+      allowCredentials: options.allowCredentials?.map(c => ({ ...c, id: decode(c.id) })),
+    } });
+  }
+  if (!credential) throw new Error('No passkey was selected. Please try again.');
+  const data = await request<{ token?: string; verificationToken?: string }>(`/passkeys/${kind}/verify`, { ...details, challengeId, credential: serialize(credential as PublicKeyCredential) });
+  if (kind !== 'reauthenticate') saveSession(data);
+  return data;
+}
+export function authError(error: unknown) {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError' || error.name === 'AbortError') return 'The passkey request was canceled or timed out. Try again when you’re ready.';
+    if (error.name === 'InvalidStateError') return 'This device already has a passkey for this account. Try signing in with it.';
+    if (error.name === 'SecurityError') return 'Passkeys aren’t available on this domain. Please use your password.';
+  }
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+}
