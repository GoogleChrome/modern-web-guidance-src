@@ -0,0 +1,55 @@
+import { useEffect, useState } from 'react';
+import { ArrowRightIcon, FingerPrintIcon, LockClosedIcon, ArrowUpRightIcon } from '@heroicons/react/24/outline';
+import { accountUrl, authError, passkeyFlow, request, saveSession, supportsPasskeys } from '../lib/auth';
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState('');
+  const [supported, setSupported] = useState(true);
+  const [registered, setRegistered] = useState(false);
+  useEffect(() => { setSupported(supportsPasskeys()); setRegistered(new URLSearchParams(window.location.search).has('registered')); }, []);
+  async function submit(passkey: boolean) {
+    setError(''); setBusy(passkey ? 'passkey' : 'password');
+    try {
+      if (passkey) await passkeyFlow(signup ? 'register' : 'authenticate', { username: username.trim() || undefined });
+      else {
+        const data = await request<{ token?: string }>(signup ? '/register' : '/login', { username: username.trim(), password });
+        saveSession(data);
+        if (signup && !data.token) {
+          window.location.assign(`${import.meta.env.BASE_URL}signin?registered=1`); return;
+        }
+      }
+      window.location.assign(accountUrl);
+    } catch (e) { setError(authError(e)); }
+    finally { setBusy(''); }
+  }
+  return <div className="auth-layout">
+    <div className="auth-editorial">
+      <span className="eyebrow">YOUR DAILY PERSPECTIVE</span>
+      <h1>A curious mind.<br />A world of stories.</h1>
+      <p>Independent journalism for people who want to understand what’s next.</p>
+      <div className="editorial-rule" /><span className="font-brand editorial-signature">The DevTools Times</span>
+    </div>
+    <div className="auth-form-panel">
+      <span className="eyebrow">{signup ? 'JOIN THE CONVERSATION' : 'WELCOME BACK'}</span>
+      <h2>{signup ? 'Your next chapter starts here.' : 'Good to see you again.'}</h2>
+      <p className="muted">{signup ? 'Create an account. Stay curious.' : 'Sign in to your DevTools Times account.'}</p>
+      {registered && !signup && <div role="status" className="notice success">Your account is ready. Sign in to continue.</div>}
+      {error && <div role="alert" className="notice error">{error}</div>}
+      {!supported && <p className="notice">Your browser doesn’t support passkeys. Continue with a password below.</p>}
+      <form onSubmit={e => { e.preventDefault(); void submit(false); }} className="auth-fields">
+        <label htmlFor="username">Username<input id="username" name="username" autoComplete="username webauthn" value={username} onChange={e => setUsername(e.target.value)} required placeholder="Enter your username" disabled={!!busy} /></label>
+        <button type="button" className="button primary full" disabled={!!busy || !supported} onClick={() => { if (signup && !username.trim()) { document.getElementById('username')?.focus(); setError('Enter a username to create your account with a passkey.'); return; } void submit(true); }}><FingerPrintIcon />{busy === 'passkey' ? 'Waiting for your device…' : signup ? 'Create account with a passkey' : 'Sign in with a passkey'}<ArrowRightIcon /></button>
+        <p className="passkey-caption">Use your face, fingerprint, or device PIN. No password needed.</p>
+        <div className="form-divider"><span>or continue with a password</span></div>
+        <label htmlFor="password">Password<input id="password" name="password" type="password" autoComplete={signup ? 'new-password' : 'current-password'} value={password} onChange={e => setPassword(e.target.value)} required minLength={signup ? 8 : undefined} pattern={signup ? '(?=.*[0-9]).{8,}' : undefined} disabled={!!busy} placeholder="Enter your password" /></label>
+        {signup && <p className="field-hint">Use at least 8 characters, including a number.</p>}
+        <button className="button secondary full" disabled={!!busy}>{busy === 'password' ? 'Please wait…' : signup ? 'Create account with a password' : 'Sign in with a password'}<ArrowRightIcon /></button>
+      </form>
+      <p className="auth-switch">{signup ? 'Already a reader?' : 'New to The DevTools Times?'} <a href={`${import.meta.env.BASE_URL}${signup ? 'signin' : 'signup'}`}>{signup ? 'Sign in' : 'Create an account'} <ArrowUpRightIcon /></a></p>
+      <p className="auth-assurance"><LockClosedIcon /> Your privacy is always part of the story.</p>
+    </div>
+  </div>;
+}
