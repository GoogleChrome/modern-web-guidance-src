+.security-dialog { margin: auto; width: min(460px, calc(100% - 32px)); border: 1px solid #dde4d8; border-radius: 12px; padding: 32px; color: var(--account-ink); box-shadow: 0 20px 90px #192b2540; font-family: Arial,sans-serif; }.security-dialog::backdrop { background: #14271d70; backdrop-filter: blur(3px); }.security-dialog form { position: relative; }.dialog-close { position: absolute; top: -15px; right: -15px; }.dialog-symbol { width: 44px; height: 44px; padding: 10px; color: #547749; background: #edf3e8; border-radius: 12px; margin-bottom: 21px; }.security-dialog h2 { font-family: Georgia,serif; font-size: 27px; margin: 8px 0 11px; line-height: 1.25; }.muted { color: #7c8476; font-size: 12px; line-height: 1.8; }.dialog-label { display: block; font-size: 11px; font-weight: 600; margin-top: 20px; }.dialog-label input, .auth-fields input { display: block; border: 1px solid #dce2d6; border-radius: 5px; padding: 11px 12px; width: 100%; margin-top: 7px; font-size: 12px; color: #263827; background: #fff; }.verify-methods { margin: 20px 0; padding: 0; border: 0; }.verify-methods legend { font-size: 11px; font-weight: 600; margin-bottom: 8px; }.method-options { display: flex; gap: 10px; }.method-options label { border: 1px solid #dfe5d9; border-radius: 6px; padding: 10px; display: flex; align-items: center; gap: 8px; flex: 1; font-size: 11px; }.method-options label:has(input:checked) { border-color: #65845b; background: #f1f6ed; }.method-options svg { width: 16px; }.method-options input { accent-color: #365e3e; }.security-dialog .button { margin-top: 18px; }.button.destructive { color: white; background: #a44e3e; }.dialog-cancel { display: block; margin: 15px auto 0; font-size: 11px; color: #6c7767; }
+.auth-layout { max-width: 940px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; border: 1px solid #e5e9df; border-radius: 10px; overflow: hidden; box-shadow: 0 8px 25px #283a2010; }.auth-editorial { padding: 60px 40px; background: #edf2e8; display: flex; flex-direction: column; justify-content: center; }.auth-editorial h1 { font-family: Georgia,serif; font-size: 40px; letter-spacing: -1.3px; line-height: 1.2; margin: 24px 0; }.auth-editorial > p { color: #78846e; font-size: 13px; max-width: 280px; line-height: 1.9; }.editorial-rule { width: 40px; height: 1px; background: #8a9e7c; margin: 45px 0 16px; }.editorial-signature { font-size: 23px; color: #566d48; }.auth-form-panel { padding: 45px 35px 30px; }.auth-form-panel h2 { font-family: Georgia,serif; font-size: 27px; line-height: 1.25; letter-spacing: -.6px; margin: 10px 0; }.auth-fields { margin-top: 28px; }.auth-fields label { font-size: 11px; font-weight: 600; display: block; }.auth-fields .button { margin-top: 18px; }.passkey-caption { font-size: 9px; text-align: center; color: #838c79; margin-top: 9px; line-height: 1.7; }.form-divider { display: flex; align-items: center; gap: 10px; font-size: 9px; color: #9a9f92; margin: 25px 0; }.form-divider::before, .form-divider::after { content: ''; height: 1px; background: #e7eadf; flex: 1; }.field-hint { margin-top: 7px; font-size: 9px; color: #7e8975; }.auth-switch { font-size: 10px; text-align: center; margin-top: 25px; color: #818a78; }.auth-switch a { color: #365e3e; font-weight: 600; display: inline-flex; gap: 3px; align-items: center; }.auth-switch svg { width: 12px; }.auth-assurance { display: flex; align-items: center; justify-content: center; font-size: 9px; gap: 6px; color: #9a9f93; margin-top: 25px; padding-top: 20px; border-top: 1px solid #eef0e7; }.auth-assurance svg { width: 12px; }
