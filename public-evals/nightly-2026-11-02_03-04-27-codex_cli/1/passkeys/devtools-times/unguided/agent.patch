+.device-icon { padding: 9px; background: #f4f6f0; border-radius: 6px; color: #6c8366; }.device-icon svg { width: 20px; }.key-detail { flex: 1; min-width: 0; }.key-detail h4 { font-size: 12px; font-weight: 600; overflow-wrap: anywhere; }.key-detail p { font-size: 9px; color: #8a9085; }.key-detail p span { padding: 0 6px; }
