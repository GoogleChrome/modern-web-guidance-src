+    .promo-badge-slot {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      min-height: 160px;
+      padding: 20px 40px;
+    }
+
+    .target {
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      width: 112px;
+      height: 112px;
+      flex-shrink: 0;
+      border: 2px dashed var(--primary);
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      text-align: center;
+      line-height: 1.3;
+      box-shadow: 0 3px 8px rgb(62 39 35 / 15%);
+      /* Independent properties keep both animations and hover scaling composable.
+         Identity values establish the stacking context before hover. */
+      translate: 0;
+      rotate: 0deg;
+      scale: 1;
+      animation: promo-spin 12s linear infinite,
+        promo-slide 3s ease-in-out infinite alternate;
+      transition: scale 250ms ease;
+    }
+
+    .target small {
+      margin-top: 4px;
+      font-size: 0.75rem;
+    }
+
+    .target:hover {
+      scale: 1.12;
+    }
+
+    @keyframes promo-spin {
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -20px 0; }
+      to { translate: 20px 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .target {
+        animation: none;
+        transition: none;
+      }
+    }
+
