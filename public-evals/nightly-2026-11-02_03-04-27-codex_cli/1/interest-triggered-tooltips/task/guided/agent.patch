+  <script type="module">
+    // Load compatibility support only where the corresponding native API is absent.
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    if (!CSS.supports("position-area: right") || !CSS.supports("anchor-name: --details")) {
+      document.querySelectorAll("[interestfor]").forEach((trigger) => {
+        const tooltip = document.getElementById(trigger.getAttribute("interestfor"));
+        let open = false;
+        const position = () => {
+          if (!open) return;
+          const rect = trigger.getBoundingClientRect();
+          const width = tooltip.offsetWidth;
+          const height = tooltip.offsetHeight;
+          const fitsRight = rect.right + 8 + width <= window.innerWidth - 12;
+          const fitsLeft = rect.left - width - 8 >= 12;
+          const left = fitsRight ? rect.right + 8 : fitsLeft ? rect.left - width - 8 : rect.left;
+          const top = fitsRight || fitsLeft ? rect.top + (rect.height - height) / 2
+            : rect.bottom + 8 + height <= window.innerHeight - 12 ? rect.bottom + 8 : rect.top - height - 8;
+          tooltip.style.left = `${Math.max(12, Math.min(left, window.innerWidth - width - 12))}px`;
+          tooltip.style.top = `${Math.max(12, Math.min(top, window.innerHeight - height - 12))}px`;
+        };
+        tooltip.addEventListener("toggle", (event) => {
+          open = event.newState === "open";
+          position();
+        });
+        window.addEventListener("resize", position);
+        window.addEventListener("scroll", position, { capture: true, passive: true });
+      });
+    }
+
+    if (!Object.hasOwn(HTMLButtonElement.prototype, "interestForElement")) {
+      // Supply the native accessibility association in browsers using the polyfill.
+      document.querySelectorAll("[interestfor]").forEach((trigger) => {
+        const id = trigger.getAttribute("interestfor");
+        trigger.setAttribute("aria-describedby", id);
+        document.getElementById(id).setAttribute("role", "tooltip");
+      });
+      await import("https://unpkg.com/interestfor@latest");
+    }
+  </script>
