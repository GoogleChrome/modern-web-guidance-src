+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = document.getElementById('cup-stage');
+      const form = document.getElementById('coffee-form');
+      const context = canvas.getContext('2d');
+      let nativeHTML = Boolean(context && 'content' in HTMLCanvasElement.prototype &&
+        typeof context.drawElementImage === 'function' && typeof canvas.requestPaint === 'function');
+      let cssWidth = 0;
+      let cssHeight = 0;
+
+      // Keep a single live form: native drawable descendant or ordinary DOM overlay.
+      if (nativeHTML) {
+        canvas.append(form);
+        stage.style.paddingBlock = '0';
+      } else {
+        canvas.setAttribute('aria-hidden', 'true');
+      }
+
+      function drawCup() {
+        if (!context || !cssWidth || !cssHeight) return;
+        context.setTransform(canvas.width / cssWidth, 0, 0, canvas.height / cssHeight, 0, 0);
+        context.clearRect(0, 0, cssWidth, cssHeight);
+        const w = cssWidth;
+        const h = cssHeight;
+        // Cup geometry and the HTML use the same unscaled CSS-pixel coordinates.
+        context.fillStyle = '#d7ccc8';
+        context.beginPath();
+        context.ellipse(w / 2, h - 38, w * 0.36, 15, 0, 0, Math.PI * 2);
+        context.fill();
+        context.fillStyle = '#fffaf2';
+        context.strokeStyle = '#866c60';
+        context.lineWidth = 2;
+        context.beginPath();
+        context.moveTo(w * 0.07, 80);
+        context.lineTo(w * 0.93, 80);
+        context.lineTo(w * 0.85, h - 70);
+        context.quadraticCurveTo(w / 2, h - 42, w * 0.15, h - 70);
+        context.closePath();
+        context.fill();
+        context.stroke();
+        context.fillStyle = '#4e342e';
+        context.beginPath();
+        context.roundRect(w * 0.04, 60, w * 0.92, 24, 10);
+        context.fill();
+        context.fillStyle = '#735348';
+        context.beginPath();
+        context.roundRect(w * 0.10, 44, w * 0.80, 20, [12, 12, 0, 0]);
+        context.fill();
+      }
+
+      function useOverlay() {
+        nativeHTML = false;
+        canvas.onpaint = null;
+        stage.append(form);
+        stage.style.paddingBlock = '';
+        stage.style.height = '';
+        form.style.width = '';
+        canvas.setAttribute('aria-hidden', 'true');
+        drawCup();
+      }
+
+      function requestDraw() {
+        if (nativeHTML) canvas.requestPaint();
+        else drawCup();
+      }
+
+      if (nativeHTML) {
+        canvas.onpaint = () => {
+          drawCup();
+          try {
+            // This also synchronizes hit testing, selection, and accessible bounds.
+            context.drawElementImage(form, cssWidth * 0.16, 110);
+          } catch {
+            useOverlay();
+          }
+        };
+      }
+
+      function sizeNativeForm() {
+        if (!nativeHTML) return;
+        form.style.width = `${stage.clientWidth * 0.68}px`;
+        stage.style.height = `${Math.ceil(form.offsetHeight) + 205}px`;
+      }
+
+      function resizeCanvas(entry) {
+        cssWidth = canvas.clientWidth;
+        cssHeight = canvas.clientHeight;
+        const pixels = entry?.devicePixelContentBoxSize?.[0];
+        canvas.width = Math.max(1, pixels?.inlineSize ?? Math.round(cssWidth * window.devicePixelRatio));
+        canvas.height = Math.max(1, pixels?.blockSize ?? Math.round(cssHeight * window.devicePixelRatio));
+        requestDraw();
+      }
+
+      // Content changes (including translation and text zoom) resize the cup too.
+      const layoutObserver = new ResizeObserver(() => {
+        sizeNativeForm();
+        requestDraw();
+      });
+      layoutObserver.observe(stage);
+      layoutObserver.observe(form);
+      const pixelObserver = new ResizeObserver(([entry]) => resizeCanvas(entry));
+      const devicePixelsSupported = 'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      pixelObserver.observe(canvas, devicePixelsSupported ? { box: 'device-pixel-content-box' } : {});
+      // Also covers DPR changes when moving between displays in fallback browsers.
+      let resolution;
+      function watchResolution() {
+        resolution?.removeEventListener('change', onResolutionChange);
+        resolution = matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`);
+        resolution.addEventListener('change', onResolutionChange);
+      }
+      function onResolutionChange() {
+        resizeCanvas();
+        watchResolution();
+      }
+      watchResolution();
+      sizeNativeForm();
+      resizeCanvas();
+
+      // Printing uses ordinary document flow so controls remain readable on paper.
+      window.addEventListener('beforeprint', () => {
+        if (nativeHTML) stage.append(form);
+      });
+      window.addEventListener('afterprint', () => {
+        if (nativeHTML) {
+          canvas.append(form);
+          sizeNativeForm();
+          resizeCanvas();
+        }
+      });
+
+      form.addEventListener('input', () => {
+        document.getElementById('order-status').hidden = true;
+        requestDraw();
+      });
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const name = form.elements.namedItem('name').value.trim();
+        document.getElementById('preview-name').textContent = name || 'Coffee lover';
+        for (const field of ['milk', 'syrup']) {
+          const selected = form.querySelector(`input[name="${field}"]:checked`);
+          document.getElementById(`preview-${field}`).textContent = selected.labels[0].textContent.trim();
+        }
+        document.getElementById('order-status').hidden = false;
+        requestDraw();
+      });
+    })();
+  </script>
