+  <script>
+    const canvas = document.getElementById('canvas');
+    const context = canvas.getContext('2d');
+    const stage = document.querySelector('.cup-stage');
+    const form = document.getElementById('coffee-form');
+    const nameInput = document.getElementById('coffee-name');
+    const milk = document.getElementById('coffee-milk');
+    const syrup = document.getElementById('coffee-syrup');
+    const summary = document.getElementById('coffee-summary');
+    const status = document.getElementById('coffee-status');
+
+    function drawCup() {
+      if (!context) return;
+      const bounds = stage.getBoundingClientRect();
+      const controls = form.getBoundingClientRect();
+      const ratio = window.devicePixelRatio || 1;
+      // CSS pixels are the shared coordinate system for the DOM and drawing.
+      canvas.width = Math.round(bounds.width * ratio);
+      canvas.height = Math.round(bounds.height * ratio);
+      context.setTransform(canvas.width / bounds.width, 0, 0, canvas.height / bounds.height, 0, 0);
+      const left = controls.left - bounds.left - 10;
+      const right = controls.right - bounds.left + 10;
+      const top = controls.top - bounds.top - 22;
+      const bottom = controls.bottom - bounds.top + 22;
+      const center = (left + right) / 2;
+      const radius = (right - left) / 2;
+      const handleWidth = Math.min(64, bounds.width - right - 12);
+
+      // Handle and saucer sit behind a cup measured around the actual form.
+      context.strokeStyle = '#8c6b59';
+      context.lineWidth = 12;
+      context.beginPath();
+      context.ellipse(right - 2, top + 110, handleWidth, 65, 0, -Math.PI / 2, Math.PI / 2);
+      context.stroke();
+      context.fillStyle = '#d7c4b5';
+      context.beginPath();
+      context.ellipse(center, bottom + 10, radius + 12, 15, 0, 0, Math.PI * 2);
+      context.fill();
+
+      context.fillStyle = '#fffaf2';
+      context.strokeStyle = '#8c6b59';
+      context.lineWidth = 2;
+      context.beginPath();
+      context.moveTo(left, top);
+      context.lineTo(left, bottom - 24);
+      context.quadraticCurveTo(left, bottom + 8, center, bottom + 8);
+      context.quadraticCurveTo(right, bottom + 8, right, bottom - 24);
+      context.lineTo(right, top);
+      context.closePath();
+      context.fill();
+      context.stroke();
+      context.beginPath();
+      context.ellipse(center, top, radius, 22, 0, 0, Math.PI * 2);
+      context.fill();
+      context.stroke();
+      context.fillStyle = { oat: '#c49a71', whole: '#d1ad88', almond: '#b98b63', none: '#503025' }[milk.value];
+      context.beginPath();
+      context.ellipse(center, top, radius - 8, 15, 0, 0, Math.PI * 2);
+      context.fill();
+    }
+
+    function updateCoffee() {
+      const name = nameInput.value.trim();
+      const milkLabel = milk.selectedOptions[0].textContent;
+      const syrupLabel = syrup.selectedOptions[0].textContent;
+      summary.textContent = `${name ? name + '’s coffee' : 'Your coffee'}: ${milkLabel}, ${syrupLabel.toLowerCase()}${syrup.value === 'none' ? '' : ' syrup'}.`;
+      status.textContent = '';
+      drawCup();
+    }
+
+    form.addEventListener('input', updateCoffee);
+    form.addEventListener('change', updateCoffee);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!nameInput.value.trim()) {
+        nameInput.setCustomValidity('Please enter a name for your cup.');
+        nameInput.reportValidity();
+        return;
+      }
+      try {
+        localStorage.setItem('daily-grind-coffee', JSON.stringify({
+          name: nameInput.value.trim(), milk: milk.value, syrup: syrup.value
+        }));
+        status.textContent = 'Coffee saved on this device. Ready for your next visit!';
+      } catch {
+        status.textContent = 'Your coffee is customized, but this browser could not save it.';
+      }
+    });
+    nameInput.addEventListener('input', () => nameInput.setCustomValidity(''));
+
+    const observer = new ResizeObserver(drawCup);
+    observer.observe(stage);
+    observer.observe(form);
+    window.addEventListener('resize', drawCup);
+    // A monitor or zoom change can change pixel density without a layout resize.
+    let densityQuery;
+    function watchDensity() {
+      if (densityQuery) densityQuery.removeEventListener('change', watchDensity);
+      densityQuery = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+      densityQuery.addEventListener('change', watchDensity);
+      drawCup();
+    }
+    watchDensity();
+    if (document.fonts) document.fonts.ready.then(drawCup);
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-coffee'));
+      if (saved && typeof saved.name === 'string') {
+        nameInput.value = saved.name.slice(0, 60);
+        if ([...milk.options].some(option => option.value === saved.milk)) milk.value = saved.milk;
+        if ([...syrup.options].some(option => option.value === saved.syrup)) syrup.value = saved.syrup;
+      }
+    } catch {
+      // The form also works when local storage is unavailable.
+    }
+    updateCoffee();
+  </script>
+
 </body>
 
