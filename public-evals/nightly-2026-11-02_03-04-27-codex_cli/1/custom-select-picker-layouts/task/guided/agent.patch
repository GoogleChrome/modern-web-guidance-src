+  <script>
+    const roast = document.getElementById('roast');
+    const orderNow = document.getElementById('order-now');
+    roast.addEventListener('change', () => {
+      orderNow.href = '/order-online?roast=' + encodeURIComponent(roast.value);
+    });
+
+    // Preserve the three-column photo picker where base-select is unavailable.
+    if (!CSS.supports('appearance', 'base-select')) {
+      const field = roast.parentElement;
+      const trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.id = 'roast-trigger';
+      trigger.className = 'roast-trigger';
+      trigger.setAttribute('role', 'combobox');
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-controls', 'roast-options');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-trigger');
+      trigger.setAttribute('aria-expanded', 'false');
+      const picker = document.createElement('div');
+      picker.id = 'roast-options';
+      picker.className = 'roast-options';
+      picker.setAttribute('role', 'listbox');
+      picker.setAttribute('aria-labelledby', 'roast-label');
+      picker.setAttribute('aria-orientation', 'horizontal');
+      picker.hidden = true;
+      const options = Array.from(roast.options);
+      const cards = options.map((option) => {
+        const card = document.createElement('div');
+        card.className = 'roast-option';
+        card.setAttribute('role', 'option');
+        card.tabIndex = -1;
+        card.setAttribute('aria-label', option.getAttribute('aria-label'));
+        const photo = document.createElement('img');
+        photo.className = 'roast-photo';
+        photo.src = option.dataset.photo;
+        photo.alt = '';
+        photo.width = 120;
+        photo.height = 78;
+        const name = document.createElement('span');
+        name.className = 'roast-name';
+        name.textContent = option.value[0].toUpperCase() + option.value.slice(1);
+        const notes = document.createElement('span');
+        notes.className = 'roast-notes';
+        notes.textContent = option.dataset.notes;
+        card.append(photo, name, notes);
+        card.addEventListener('click', () => {
+          roast.value = option.value;
+          roast.dispatchEvent(new Event('change'));
+          syncSelection();
+          closePicker(true);
+        });
+        picker.append(card);
+        return card;
+      });
+      function syncSelection() {
+        trigger.textContent = options[roast.selectedIndex].value.replace(/^./, c => c.toUpperCase()) + ' roast ▾';
+        cards.forEach((card, index) => card.setAttribute('aria-selected', String(index === roast.selectedIndex)));
+      }
+      function closePicker(restoreFocus = false) {
+        picker.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) trigger.focus();
+      }
+      function openPicker(index = roast.selectedIndex) {
+        picker.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        cards[index].focus();
+      }
+      trigger.addEventListener('click', () => picker.hidden ? openPicker() : closePicker());
+      trigger.addEventListener('keydown', event => {
+        if (['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight'].includes(event.key)) {
+          event.preventDefault();
+          openPicker();
+        }
+      });
+      picker.addEventListener('keydown', event => {
+        const index = cards.indexOf(document.activeElement);
+        let next = index;
+        if (['ArrowRight', 'ArrowDown'].includes(event.key)) next = (index + 1) % cards.length;
+        else if (['ArrowLeft', 'ArrowUp'].includes(event.key)) next = (index + cards.length - 1) % cards.length;
+        else if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = cards.length - 1;
+        else if (event.key === 'Escape') { event.preventDefault(); closePicker(true); return; }
+        else if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); cards[index].click(); return; }
+        else if (/^[lmd]$/i.test(event.key)) next = options.findIndex(option => option.value.startsWith(event.key.toLowerCase()));
+        else return;
+        event.preventDefault();
+        cards[next].focus();
+      });
+      document.addEventListener('click', event => {
+        if (!field.contains(event.target)) closePicker();
+      });
+      field.addEventListener('focusout', event => {
+        if (!field.contains(event.relatedTarget)) closePicker();
+      });
+      roast.hidden = true;
+      document.getElementById('roast-label').htmlFor = trigger.id;
+      field.append(trigger, picker);
+      syncSelection();
+    }
+  </script>
