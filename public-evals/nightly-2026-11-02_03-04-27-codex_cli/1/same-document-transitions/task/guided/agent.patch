+  <script>
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const heroImage = document.getElementById('hero-image');
+    const title = document.getElementById('title');
+    const listHeading = document.getElementById('list-heading');
+    const cards = new Map([...document.querySelectorAll('.thumbnail')]
+      .map(card => [card.dataset.favorite, card]));
+    const descriptions = {
+      'maple-oat-latte': 'A little sweetness for a slower morning. Our Maple Oat Latte pairs rich espresso with creamy oat milk and a hint of Vermont maple syrup. Enjoy it hot or over ice.',
+      'dark-roast-espresso': 'Bold, smokey, and full of character. Our dark roast is carefully pulled into a rich espresso with a silky crema. The perfect start to your morning, or a welcome afternoon pause.',
+      'cold-brew': 'Good things take time. Steeped for 18 hours, our Cold Brew brings out the naturally sweet, smooth character of our coffee. Served over ice for a refreshing finish.'
+    };
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    let currentId = null;
+    let requestedId = null;
+    let navigating = false;
+    let activeTransition = null;
+    let listScroll = 0;
+
+    function readRoute() {
+      const id = location.hash.startsWith('#favorite/') ? location.hash.slice(10) : null;
+      return cards.has(id) ? id : null;
+    }
+
+    function updateView(id) {
+      if (id) {
+        const card = cards.get(id);
+        const image = card.querySelector('img');
+        heroImage.src = image.src;
+        heroImage.alt = image.alt;
+        title.textContent = card.querySelector('.title').textContent;
+        document.getElementById('detail-description').textContent = descriptions[id];
+      }
+      listPage.hidden = Boolean(id);
+      detailPage.hidden = !id;
+      document.title = id ? `${title.textContent} | The Daily Grind` : 'The Daily Grind | Artisanal Coffee';
+      currentId = id;
+      window.scrollTo({ top: id ? 0 : listScroll, behavior: 'instant' });
+    }
+
+    function cleanTransition() {
+      document.querySelectorAll('.selected, .transition-target').forEach(element => {
+        element.classList.remove('selected', 'transition-target');
+      });
+    }
+
+    async function navigate(id) {
+      // Back/Forward can emit both popstate and hashchange for the same route.
+      if (navigating && requestedId === id) return;
+      requestedId = id;
+      if (navigating) {
+        activeTransition?.skipTransition();
+        return;
+      }
+      navigating = true;
+      try {
+        while (currentId !== requestedId) {
+          const nextId = requestedId;
+          const card = cards.get(currentId || nextId);
+          if (!currentId) listScroll = window.scrollY;
+          const focusHeading = () => (nextId ? title : listHeading).focus({ preventScroll: true });
+          if (reducedMotion.matches || !document.startViewTransition) {
+            updateView(nextId);
+            focusHeading();
+            continue;
+          }
+          card.classList.add('selected');
+          hero.classList.add('transition-target');
+          title.classList.add('transition-target');
+          try {
+            activeTransition = document.startViewTransition(() => updateView(nextId));
+            // Observe both promises: a skipped snapshot can reject `ready`.
+            activeTransition.ready.catch(() => {});
+            await activeTransition.finished;
+          } catch {
+            // Navigation still works if snapshots cannot be captured.
+            if (currentId !== nextId) updateView(nextId);
+          } finally {
+            activeTransition = null;
+            cleanTransition();
+            focusHeading();
+          }
+        }
+      } finally {
+        navigating = false;
+        cleanTransition();
+      }
+    }
+
+    document.addEventListener('click', event => {
+      const link = event.target.closest('.thumbnail, .back-link');
+      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      event.preventDefault();
+      if (link.matches('.back-link')) {
+        if (history.state?.fromFavorites) {
+          history.back();
+          return;
+        }
+        history.pushState(null, '', '#favorites');
+      } else {
+        history.pushState({ fromFavorites: !currentId }, '', link.getAttribute('href'));
+      }
+      navigate(readRoute());
+    });
+    window.addEventListener('popstate', () => navigate(readRoute()));
+    window.addEventListener('hashchange', () => navigate(readRoute()));
+    reducedMotion.addEventListener('change', event => {
+      if (event.matches) activeTransition?.skipTransition();
+    });
+    // Direct detail links also announce the newly active view.
+    const initialId = readRoute();
+    if (initialId) {
+      updateView(initialId);
+      title.focus({ preventScroll: true });
+    }
+  </script>
