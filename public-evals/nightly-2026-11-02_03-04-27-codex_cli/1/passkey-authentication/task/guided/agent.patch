+  <script type="module">
+    import './assets/passkey-polyfills.js';
+
+    const form = document.querySelector('#signin-form');
+    const button = document.querySelector('[data-testid="auth-button"]');
+    const status = document.querySelector('[data-testid="auth-status"]');
+    let activeController;
+    let activeRequest;
+    let explicitPending = false;
+    let authenticated = false;
+
+    const supported = window.isSecureContext &&
+      typeof PublicKeyCredential !== 'undefined' && navigator.credentials?.get;
+
+    async function authenticate(mediation, controller) {
+      const { signal } = controller;
+      const conditional = mediation === 'conditional';
+
+      try {
+        // The server must generate and retain a fresh challenge in this session.
+        // It must also persist the requested verification policy for verification.
+        const optionsResponse = await fetch('/api/login/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ userVerification: conditional ? 'preferred' : 'required' }),
+          signal,
+        });
+        if (!optionsResponse.ok) throw new Error('Could not start passkey sign-in. Please try again.');
+
+        const options = await optionsResponse.json();
+        if (signal.aborted) return;
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON({
+          ...options,
+          // Discoverable passkeys let the user choose an account without typing.
+          allowCredentials: [],
+          userVerification: conditional ? (options.userVerification ?? 'preferred') : 'required',
+        });
+        const credential = await navigator.credentials.get({ publicKey, mediation, signal });
+        if (!credential || signal.aborted) return;
+
+        button.disabled = true;
+        status.textContent = 'Verifying your passkey…';
+        const encoded = credential.toJSON();
+        const verification = await fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+          signal,
+        });
+        if (signal.aborted) return;
+        if (!verification.ok) {
+          if (verification.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+            // Synchronization is optional and must not hide the sign-in error.
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: publicKey.rpId ?? window.location.hostname,
+                credentialId: encoded.id,
+              });
+            } catch { /* The password manager may not support synchronization. */ }
+          }
+          throw new Error('Passkey verification failed. Please try again.');
+        }
+        // The server must only return 2xx after validating the assertion and
+        // establishing the authenticated session, including its secure cookie.
+        authenticated = true;
+        status.textContent = 'Signed in successfully.';
+      } catch (error) {
+        if (signal.aborted || error.name === 'AbortError') return;
+        if (error.name === 'NotAllowedError') {
+          if (!conditional) status.textContent = 'Sign-in was cancelled or timed out. Please try again.';
+        } else {
+          status.textContent = error instanceof TypeError
+            ? 'Could not connect to sign in. Please try again.'
+            : error.message || 'Could not sign in with your passkey. Please try again.';
+        }
+      } finally {
+        if (!authenticated && !explicitPending) button.disabled = false;
+      }
+    }
+
+    function startRequest(mediation) {
+      const controller = new AbortController();
+      activeController = controller;
+      const request = authenticate(mediation, controller);
+      activeRequest = request;
+      return request.finally(() => {
+        if (activeController === controller) {
+          activeController = undefined;
+          activeRequest = undefined;
+        }
+      });
+    }
+
+    async function initializeAutofill() {
+      if (!supported || authenticated || explicitPending || activeRequest) return;
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalGet && !authenticated && !explicitPending && !activeRequest) {
+          // Register silently on load so focusing the username offers passkeys.
+          await startRequest('conditional');
+        }
+      } catch {
+        // The explicit button remains available without conditional UI support.
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!supported || authenticated || explicitPending || button.disabled) return;
+      explicitPending = true;
+      button.disabled = true;
+      status.textContent = 'Use your device to confirm your passkey.';
+      // Finish cancelling autofill before starting the modal authentication UI.
+      activeController?.abort();
+      await activeRequest;
+      try {
+        await startRequest('required');
+      } finally {
+        explicitPending = false;
+        button.disabled = authenticated;
+        if (!authenticated) void initializeAutofill();
+      }
+    });
+
+    if (supported) {
+      void initializeAutofill();
+    } else {
+      button.disabled = true;
+      status.textContent = 'Passkey sign-in requires a supported browser and HTTPS (or localhost).';
+    }
+  </script>
 </body>
 
