+  <script>
+    const signInForm = document.querySelector('#sign-in-form');
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    const authStatus = document.querySelector('[data-testid="auth-status"]');
+    let pendingRequest = null;
+    let explicitSignIn = false;
+    let signedIn = false;
+
+    function decodeBase64url(value) {
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+      return Uint8Array.from(atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, '=')),
+        character => character.charCodeAt(0));
+    }
+
+    function encodeBase64url(value) {
+      return btoa(Array.from(new Uint8Array(value), byte => String.fromCharCode(byte)).join(''))
+        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    async function authenticate(conditional) {
+      const controller = new AbortController();
+      let verifying = false;
+      pendingRequest = controller;
+      try {
+        const optionsResponse = await fetch('/api/login/options', {
+          credentials: 'same-origin',
+          cache: 'no-store',
+          signal: controller.signal
+        });
+        if (!optionsResponse.ok) throw new Error('Could not start passkey sign-in. Please try again.');
+        const options = await optionsResponse.json();
+        const publicKey = { ...(options.publicKey || options) };
+        publicKey.challenge = decodeBase64url(publicKey.challenge);
+        publicKey.userVerification = 'required';
+        // Discoverable credentials let the user choose an account without entering a username.
+        publicKey.allowCredentials = conditional ? [] : (publicKey.allowCredentials || []).map(credential => ({
+          ...credential,
+          id: decodeBase64url(credential.id)
+        }));
+        if (controller.signal.aborted) return;
+        const credential = await navigator.credentials.get({
+          publicKey,
+          mediation: conditional ? 'conditional' : 'required',
+          signal: controller.signal
+        });
+        if (!credential || controller.signal.aborted) return;
+        verifying = true;
+        authStatus.textContent = 'Verifying your passkey…';
+        authButton.disabled = true;
+        const verification = await fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          signal: controller.signal,
+          body: JSON.stringify({
+            id: credential.id,
+            rawId: encodeBase64url(credential.rawId),
+            type: credential.type,
+            response: {
+              authenticatorData: encodeBase64url(credential.response.authenticatorData),
+              clientDataJSON: encodeBase64url(credential.response.clientDataJSON),
+              signature: encodeBase64url(credential.response.signature),
+              userHandle: credential.response.userHandle == null ? null :
+                encodeBase64url(credential.response.userHandle)
+            },
+            clientExtensionResults: credential.getClientExtensionResults()
+          })
+        });
+        if (!verification.ok) throw new Error('Passkey sign-in failed. Please try again.');
+        const result = verification.status === 204 ? {} : await verification.json();
+        if (result.verified === false || result.success === false) {
+          throw new Error('Passkey sign-in failed. Please try again.');
+        }
+        signedIn = true;
+        authStatus.textContent = 'Signed in successfully.';
+      } catch (error) {
+        if (controller.signal.aborted || error.name === 'AbortError') return;
+        if (!conditional || verifying) {
+          authStatus.textContent = error.name === 'NotAllowedError'
+            ? 'Passkey sign-in was canceled or unavailable. Please try again.'
+            : 'Unable to sign in with your passkey. Please try again.';
+        }
+      } finally {
+        if (pendingRequest === controller) {
+          pendingRequest = null;
+          authButton.disabled = signedIn;
+        }
+      }
+    }
+
+    async function startPasskeyAutofill() {
+      if (explicitSignIn || signedIn || pendingRequest) return;
+      try {
+        if (await PublicKeyCredential.isConditionalMediationAvailable?.()) {
+          if (!explicitSignIn && !signedIn && !pendingRequest) void authenticate(true);
+        }
+      } catch {
+        // The explicit sign-in button remains available when autofill is unsupported.
+      }
+    }
+
+    signInForm.addEventListener('submit', async event => {
+      event.preventDefault();
+      if (explicitSignIn || signedIn || authButton.disabled) return;
+      explicitSignIn = true;
+      pendingRequest?.abort();
+      authButton.disabled = true;
+      authStatus.textContent = 'Use your passkey to sign in…';
+      try {
+        await authenticate(false);
+      } finally {
+        explicitSignIn = false;
+        if (!signedIn) void startPasskeyAutofill();
+      }
+    });
+
+    if (window.PublicKeyCredential && navigator.credentials?.get) {
+      void startPasskeyAutofill();
+      document.querySelector('#username').addEventListener('focus', startPasskeyAutofill);
+    } else {
+      authButton.disabled = true;
+      authStatus.textContent = 'Passkeys are not supported in this browser. Try a supported browser over HTTPS.';
+    }
+  </script>
+
