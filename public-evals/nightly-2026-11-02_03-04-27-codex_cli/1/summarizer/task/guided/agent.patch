+  <script>
+    (() => {
+      const button = document.getElementById('summarize-journal');
+      const status = document.getElementById('journal-status');
+      const summary = document.getElementById('journal-summary');
+      const points = document.getElementById('journal-summary-points');
+      const options = {
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', (event) => {
+            const progress = Math.round(event.loaded * 100);
+            status.textContent = `Downloading browser AI model: ${progress}%. The first download may take a few minutes.`;
+          });
+        },
+      };
+
+      async function checkSupport() {
+        if (!window.isSecureContext || !('Summarizer' in window)) {
+          status.textContent = 'Native AI summaries are not supported in this browser. Try a compatible desktop browser, such as Chrome, over HTTPS. The full journal is available above.';
+          return;
+        }
+
+        try {
+          const availability = await window.Summarizer.availability(options);
+          if (availability === 'unavailable') {
+            status.textContent = 'Your browser’s AI model is unavailable on this device. You can still read the full journal above.';
+            return;
+          }
+          status.textContent = availability === 'available'
+            ? 'Get a few key points with AI running on your device.'
+            : 'Your browser needs to download its AI model first. Select Summarize to start; this may take a few minutes.';
+          button.disabled = false;
+        } catch {
+          status.textContent = 'Browser AI support could not be checked. Reload the page to try again; the full journal is available above.';
+        }
+      }
+
+      button.addEventListener('click', async () => {
+        let summarizer;
+        button.disabled = true;
+        button.textContent = 'Summarizing…';
+        summary.setAttribute('aria-busy', 'true');
+        status.textContent = 'Preparing browser AI…';
+
+        try {
+          // Create directly within the click handler to preserve user activation.
+          summarizer = await window.Summarizer.create(options);
+          status.textContent = 'Summarizing the journal on your device…';
+          const text = document.getElementById('journal-copy').innerText;
+          const result = await summarizer.summarize(text);
+          const bulletPoints = result.split(/\n+/)
+            .map((line) => line.replace(/^\s*(?:[-*•]|\d+[.)])\s*/, '').trim())
+            .filter(Boolean);
+          if (!bulletPoints.length) throw new Error('Empty summary');
+
+          points.replaceChildren(...bulletPoints.map((point) => {
+            const item = document.createElement('li');
+            item.textContent = point;
+            return item;
+          }));
+          summary.hidden = false;
+          status.textContent = 'AI summary ready below. Generated on your device; read the full journal for context.';
+        } catch {
+          status.textContent = 'The browser couldn’t generate a summary. Please try again. A model download may require an internet connection.';
+        } finally {
+          if (summarizer) summarizer.destroy();
+          summary.setAttribute('aria-busy', 'false');
+          button.disabled = false;
+          button.textContent = 'Summarize';
+        }
+      });
+
+      checkSupport();
+    })();
+  </script>
