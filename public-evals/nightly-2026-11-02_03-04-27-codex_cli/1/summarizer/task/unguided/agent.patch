+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const summaryStatus = document.getElementById('summary-status');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('summary-points');
+
+    summarizeButton.addEventListener('click', async () => {
+      if (!window.isSecureContext || !('Summarizer' in window)) {
+        summaryStatus.textContent = 'Built-in AI summarization is not available in this browser. Try a supported browser with on-device AI enabled over HTTPS or localhost. The full journal is available above.';
+        return;
+      }
+
+      let summarizer;
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.setAttribute('aria-busy', 'true');
+      summaryStatus.textContent = 'Preparing your browser’s AI… First use may take a moment.';
+
+      try {
+        // Create directly in the click handler to preserve user activation for model downloads.
+        summarizer = await window.Summarizer.create({
+          type: 'key-points',
+          format: 'plain-text',
+          length: 'short',
+          expectedInputLanguages: ['en'],
+          outputLanguage: 'en',
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              summaryStatus.textContent = `Downloading browser AI model: ${Math.round(event.loaded * 100)}%`;
+            });
+          }
+        });
+        summaryStatus.textContent = 'Summarizing the journal…';
+        const result = await summarizer.summarize(document.getElementById('journal-text').innerText);
+        const points = result.split(/\n+/)
+          .map((line) => line.replace(/^\s*(?:[-*•‣]\s*|\d+[.)]\s+)/, '').trim())
+          .filter(Boolean);
+        if (!points.length) throw new Error('Empty summary');
+
+        summaryPoints.replaceChildren(...points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        }));
+        summaryPanel.hidden = false;
+        summaryStatus.textContent = 'Summary ready below.';
+      } catch (error) {
+        summaryStatus.textContent = error.name === 'NotSupportedError'
+          ? 'Your browser’s AI model is not available on this device or for this language. You can still read the full journal above.'
+          : 'Your browser could not generate a summary. Check that built-in AI is available and that any model download can finish, then try again.';
+      } finally {
+        summarizer?.destroy();
+        summaryPanel.removeAttribute('aria-busy');
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+      }
+    });
+  </script>
