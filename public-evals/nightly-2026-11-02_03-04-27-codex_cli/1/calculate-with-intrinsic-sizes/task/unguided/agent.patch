+  <script>
+    const accordionToggle = document.getElementById('accordion-toggle');
+    const accordionContent = document.getElementById('sourcing-content');
+    const accordionInner = accordionContent.querySelector('.accordion-inner');
+    const supportsIntrinsicSizing = CSS.supports('block-size', 'calc-size(auto, size + 2rem)');
+
+    // Measure only as a fallback for browsers without calc-size().
+    function syncAccordionSize() {
+      if (supportsIntrinsicSizing) return;
+      const expanded = accordionToggle.getAttribute('aria-expanded') === 'true';
+      const breathingRoom = 2 * parseFloat(getComputedStyle(document.documentElement).fontSize);
+      const contentSize = getComputedStyle(accordionInner).blockSize;
+      accordionContent.style.blockSize = expanded
+        ? `${parseFloat(contentSize) + breathingRoom}px`
+        : '0px';
+    }
+
+    accordionToggle.addEventListener('click', () => {
+      const expanded = accordionToggle.getAttribute('aria-expanded') !== 'true';
+      accordionToggle.setAttribute('aria-expanded', String(expanded));
+      accordionContent.setAttribute('aria-hidden', String(!expanded));
+      accordionContent.inert = !expanded;
+      syncAccordionSize();
+    });
+
+    if (!supportsIntrinsicSizing) {
+      new ResizeObserver(syncAccordionSize).observe(accordionInner);
+      window.addEventListener('resize', syncAccordionSize);
+    }
+  </script>
