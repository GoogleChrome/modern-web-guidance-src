+  <script>
+    const drinks = [
+      { name: 'Maple Oat Latte', price: 5.50, size: 'Regular', milk: 'Oat', temperature: 'Hot', sweetness: 'Standard', shots: 'Standard' },
+      { name: 'Dark Roast Espresso', price: 3.50, size: 'Regular', milk: 'None', temperature: 'Hot', sweetness: 'Unsweetened', shots: 'Standard' },
+      { name: 'Cold Brew', price: 4.50, size: 'Regular', milk: 'None', temperature: 'Iced', sweetness: 'Unsweetened', shots: 'Standard' }
+    ];
+    const descriptions = [...document.querySelectorAll('.card > p:first-of-type')].map(p => p.textContent);
+    const status = document.getElementById('order-status');
+    let statusTimer, orderCount = 0;
+    function announce(message) {
+      clearTimeout(statusTimer);
+      status.textContent = message;
+      statusTimer = setTimeout(() => { status.textContent = ''; }, 6000);
+    }
+    function summary(drink) {
+      return `${drink.size} · ${drink.temperature} · ${drink.milk === 'None' ? 'No milk' : drink.milk + ' milk'} · ${drink.sweetness}${drink.shots === 'Extra shot' ? ' · Extra shot' : ''}`;
+    }
+    function updateSummary(i) { document.getElementById(`summary-${i}`).textContent = summary(drinks[i]); }
+    function showDetails(i) {
+      document.getElementById('details-title').textContent = drinks[i].name;
+      document.getElementById('details-description').textContent = descriptions[i];
+      document.getElementById('details-options').textContent = `${summary(drinks[i])}. $${drinks[i].price.toFixed(2)}. All customizations included in this demo.`;
+      document.getElementById('drink-details').showModal();
+    }
+
+    // One shared menu component for navigation and every drink card.
+    let openMenus = [];
+    function closeFrom(depth, restoreFocus = false) {
+      const closing = openMenus.splice(depth);
+      closing.reverse().forEach(({ panel, trigger }) => {
+        trigger.setAttribute('aria-expanded', 'false');
+        panel.remove();
+      });
+      if (restoreFocus && closing.length) closing[closing.length - 1].trigger.focus();
+    }
+    function placePanel(panel, trigger, nested) {
+      const rect = trigger.getBoundingClientRect();
+      const width = panel.offsetWidth, height = panel.offsetHeight;
+      let left = nested ? rect.right + 5 : rect.left;
+      if (left + width > innerWidth - 8) left = nested ? rect.left - width - 5 : rect.right - width;
+      let top = nested ? rect.top : rect.bottom + 8;
+      if (top + height > innerHeight - 8) top = nested ? innerHeight - height - 8 : rect.top - height - 8;
+      panel.style.left = `${Math.max(8, Math.min(left, innerWidth - width - 8))}px`;
+      panel.style.top = `${Math.max(8, top)}px`;
+    }
+    function openMenu(trigger, items, title, depth = 0, focus = true) {
+      closeFrom(depth);
+      const panel = document.createElement('div');
+      panel.className = 'menu-panel';
+      panel.id = `active-menu-${depth}`;
+      panel.setAttribute('role', 'menu');
+      panel.setAttribute('aria-label', title);
+      trigger.setAttribute('aria-controls', panel.id);
+      trigger.setAttribute('aria-expanded', 'true');
+      const heading = document.createElement('div');
+      heading.className = 'menu-title'; heading.textContent = title;
+      panel.append(heading);
+      const buttons = [];
+      items.forEach(item => {
+        if (item.separator) {
+          const divider = document.createElement('div');
+          divider.className = 'menu-separator'; divider.setAttribute('role', 'separator'); panel.append(divider); return;
+        }
+        const button = document.createElement('button');
+        button.type = 'button'; button.className = 'menu-item'; button.tabIndex = -1;
+        button.setAttribute('role', item.checked ? 'menuitemradio' : 'menuitem');
+        if (item.checked) button.setAttribute('aria-checked', String(item.checked()));
+        const label = document.createElement('span'); label.textContent = item.label; button.append(label);
+        const trailing = document.createElement('span'); trailing.className = 'trailing'; trailing.setAttribute('aria-hidden', 'true');
+        trailing.textContent = item.children ? '›' : item.checked?.() ? '✓' : '';
+        button.append(trailing);
+        if (item.children) { button.setAttribute('aria-haspopup', 'menu'); button.setAttribute('aria-expanded', 'false'); }
+        button.addEventListener('pointerenter', () => {
+          if (item.children && openMenus[depth + 1]?.trigger !== button) openMenu(button, item.children, item.label, depth + 1, false);
+          else if (!item.children) closeFrom(depth + 1);
+        });
+        button.addEventListener('click', () => {
+          if (item.children) { openMenu(button, item.children, item.label, depth + 1); return; }
+          if (item.checked) {
+            item.action();
+            buttons.forEach(({ button: sibling, item: option }) => {
+              if (option.checked) { sibling.setAttribute('aria-checked', String(option.checked())); sibling.lastChild.textContent = option.checked() ? '✓' : ''; }
+            });
+          } else { closeFrom(0, true); item.action(); }
+        });
+        panel.append(button); buttons.push({ button, item });
+      });
+      panel.addEventListener('keydown', event => {
+        const index = buttons.findIndex(entry => entry.button === document.activeElement);
+        let next;
+        if (event.key === 'ArrowDown') next = (index + 1) % buttons.length;
+        if (event.key === 'ArrowUp') next = (index - 1 + buttons.length) % buttons.length;
+        if (event.key === 'Home') next = 0;
+        if (event.key === 'End') next = buttons.length - 1;
+        if (next !== undefined) { event.preventDefault(); closeFrom(depth + 1); buttons[next].button.focus(); }
+        else if (event.key === 'ArrowRight' && buttons[index]?.item.children) { event.preventDefault(); buttons[index].button.click(); }
+        else if (event.key === 'ArrowLeft' && depth > 0) { event.preventDefault(); closeFrom(depth, true); }
+        else if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); closeFrom(depth, true); }
+        else if (event.key === 'Tab') { openMenus[0].trigger.focus(); closeFrom(0); }
+        else if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && event.key !== ' ') {
+          const match = [...buttons.slice(index + 1), ...buttons.slice(0, index + 1)].find(entry => entry.item.label.toLowerCase().startsWith(event.key.toLowerCase()));
+          if (match) { event.preventDefault(); closeFrom(depth + 1); match.button.focus(); }
+        }
+      });
+      document.body.append(panel);
+      openMenus.push({ panel, trigger });
+      placePanel(panel, trigger, depth > 0);
+      if (focus) buttons[0]?.button.focus();
+    }
+    function attachMenu(trigger, items, title) {
+      trigger.addEventListener('click', () => {
+        if (openMenus[0]?.trigger === trigger) closeFrom(0);
+        else openMenu(trigger, items, title);
+      });
+      trigger.addEventListener('keydown', event => {
+        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+          event.preventDefault(); openMenu(trigger, items, title);
+          if (event.key === 'ArrowUp') openMenus[0].panel.lastElementChild.focus();
+        }
+      });
+    }
+    function choices(i, key, values) {
+      return values.map(value => ({ label: value, checked: () => drinks[i][key] === value, action: () => { drinks[i][key] = value; updateSummary(i); announce(`${drinks[i].name}: ${value}${key === 'milk' ? ' milk' : ''} selected.`); } }));
+    }
+    drinks.forEach((drink, i) => {
+      updateSummary(i);
+      attachMenu(document.getElementById(`drink-actions-${i}`), [
+        { label: 'View drink details', action: () => showDetails(i) },
+        { label: 'Customize your drink', children: [
+          { label: 'Size', children: choices(i, 'size', ['Small', 'Regular', 'Large']) },
+          { label: 'Milk', children: [
+            { label: 'Plant based', children: choices(i, 'milk', ['Oat', 'Almond', 'Soy']) },
+            { label: 'Dairy', children: choices(i, 'milk', ['Whole', 'Skim']) },
+            ...choices(i, 'milk', ['None'])
+          ] },
+          { label: 'Temperature', children: choices(i, 'temperature', i === 2 ? ['Iced', 'Light ice', 'No ice'] : ['Hot', 'Iced']) },
+          { label: 'Sweetness', children: choices(i, 'sweetness', ['Unsweetened', 'Less sweet', 'Standard', 'Extra sweet']) },
+          { label: 'Espresso shots', children: choices(i, 'shots', ['Standard', 'Extra shot']) }
+        ] },
+        { separator: true },
+        { label: 'Add to order', action: () => {
+          orderCount++;
+          document.getElementById('order-count').textContent = `${orderCount} in order`;
+          announce(`${drink.name} added to your order. ${summary(drink)}. Demo order only.`);
+        } }
+      ], drink.name);
+    });
+    const drinkLink = i => ({ label: drinks[i].name, action: () => showDetails(i) });
+    attachMenu(document.getElementById('drink-menu-button'), [
+      { label: 'Seasonal favorites', children: drinks.map((_, i) => drinkLink(i)) },
+      { label: 'Drink categories', children: [
+        { label: 'Coffee', children: [
+          { label: 'Espresso drinks', children: [drinkLink(1), drinkLink(0)] },
+          { label: 'Cold coffee', children: [drinkLink(2)] }
+        ] }
+      ] },
+      { separator: true },
+      { label: 'Browse seasonal favorites', action: () => { document.getElementById('seasonal-heading').scrollIntoView({ block: 'center' }); document.getElementById('drink-actions-0').focus({ preventScroll: true }); } }
+    ], 'Made for your daily ritual');
+    document.addEventListener('pointerdown', event => {
+      if (!openMenus.some(({ panel, trigger }) => panel.contains(event.target) || trigger.contains(event.target))) closeFrom(0);
+    });
+    document.addEventListener('focusin', event => {
+      if (openMenus.length && !openMenus.some(({ panel, trigger }) => panel.contains(event.target) || trigger === event.target)) closeFrom(0);
+    });
+    window.addEventListener('resize', () => closeFrom(0));
+    window.addEventListener('scroll', event => {
+      if (!(event.target instanceof Element && event.target.closest('.menu-panel'))) closeFrom(0);
+    }, true);
+  </script>
