+  <script>
+    let cancelNavigation = () => {};
+
+    document.querySelector('nav').addEventListener('click', (event) => {
+      const link = event.target.closest('a[href^="#"]');
+      if (!link || event.defaultPrevented || event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+
+      const target = document.getElementById(link.hash.slice(1));
+      if (!target) return;
+      event.preventDefault();
+      cancelNavigation();
+
+      document.querySelectorAll('.navigation-target').forEach((element) => {
+        element.classList.remove('navigation-target');
+      });
+
+      const controller = new AbortController();
+      const { signal } = controller;
+      const nav = document.querySelector('nav');
+      const top = Math.max(0, Math.min(
+        target.getBoundingClientRect().top + window.scrollY - nav.offsetHeight - 16,
+        document.documentElement.scrollHeight - window.innerHeight
+      ));
+      let frame;
+      let settledSince;
+      let previousY = window.scrollY;
+      const startedAt = performance.now();
+
+      const cancel = () => {
+        controller.abort();
+        cancelAnimationFrame(frame);
+      };
+      cancelNavigation = cancel;
+
+      const finish = () => {
+        if (signal.aborted || Math.abs(window.scrollY - top) > 1) return;
+        cancel();
+        history.pushState(null, '', link.hash);
+        target.focus({ preventScroll: true });
+        target.classList.add('navigation-target');
+        target.addEventListener('animationend', () => {
+          target.classList.remove('navigation-target');
+        }, { once: true });
+      };
+
+      // Native completion handles supported browsers; frame sampling also covers
+      // browsers without scrollend and links whose target is already in view.
+      document.addEventListener('scrollend', finish, { signal });
+      const checkPosition = (now) => {
+        if (signal.aborted) return;
+        const currentY = window.scrollY;
+        if (Math.abs(currentY - top) <= 1 && currentY === previousY) {
+          settledSince ??= now;
+          if (now - settledSince >= 120) {
+            finish();
+            return;
+          }
+        } else {
+          settledSince = undefined;
+        }
+        previousY = currentY;
+        // Stop waiting if scrolling cannot reach the requested position.
+        if (now - startedAt > 10000) {
+          cancel();
+          return;
+        }
+        frame = requestAnimationFrame(checkPosition);
+      };
+
+      ['wheel', 'touchstart', 'pointerdown'].forEach((type) => {
+        window.addEventListener(type, cancel, { passive: true, signal });
+      });
+      window.addEventListener('keydown', (keyEvent) => {
+        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'PageUp',
+          'PageDown', 'Home', 'End', ' ', 'Tab', 'Escape'].includes(keyEvent.key)) cancel();
+      }, { signal });
+
+      window.scrollTo({
+        top,
+        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+      });
+      frame = requestAnimationFrame(checkPosition);
+    });
+  </script>
+
