+  <script>
+    const navigation = document.querySelector('nav');
+    let currentNavigation = 0;
+    let pendingScroll;
+
+    // Keep native fragment navigation clear of the sticky header, including when it wraps.
+    function updateNavigationOffset() {
+      document.documentElement.style.setProperty('--nav-offset', `${navigation.offsetHeight + 20}px`);
+    }
+
+    updateNavigationOffset();
+    window.addEventListener('resize', updateNavigationOffset);
+
+    async function scrollToTarget(top, signal) {
+      const result = window.scrollTo({
+        top,
+        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+      });
+
+      // Prefer the browser's completion promise when it is available.
+      if (result && typeof result.then === 'function') {
+        await result;
+        return;
+      }
+
+      // Older browsers return undefined. Observe completion, with an idle fallback
+      // for browsers without scrollend and targets already at the requested position.
+      await new Promise((resolve) => {
+        let idleTimer;
+        function finish() {
+          clearTimeout(idleTimer);
+          document.removeEventListener('scrollend', finish);
+          document.removeEventListener('scroll', onScroll);
+          signal.removeEventListener('abort', finish);
+          resolve();
+        }
+        function onScroll() {
+          clearTimeout(idleTimer);
+          idleTimer = setTimeout(finish, 150);
+        }
+        document.addEventListener('scrollend', finish, { once: true });
+        document.addEventListener('scroll', onScroll, { passive: true });
+        signal.addEventListener('abort', finish, { once: true });
+        onScroll();
+        if (signal.aborted) finish();
+      });
+    }
+
+    navigation.addEventListener('click', async (event) => {
+      const link = event.target.closest('a[href^="#"]');
+      if (!link || event.defaultPrevented || event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      const target = document.getElementById(link.hash.slice(1));
+      if (!target) return;
+
+      event.preventDefault();
+      const navigationId = ++currentNavigation;
+      pendingScroll?.abort();
+      const controller = new AbortController();
+      pendingScroll = controller;
+      document.querySelectorAll('.navigation-arrival').forEach((element) => {
+        element.classList.remove('navigation-arrival');
+      });
+
+      // Use window.scrollTo to avoid early scrollIntoView promise resolution
+      // reported for Chromium's root scroller.
+      const top = Math.max(0, Math.min(
+        target.getBoundingClientRect().top + window.scrollY - navigation.offsetHeight - 20,
+        document.documentElement.scrollHeight - window.innerHeight
+      ));
+      await scrollToTarget(top, controller.signal);
+      if (navigationId !== currentNavigation || controller.signal.aborted ||
+          Math.abs(window.scrollY - top) > 2) return;
+
+      pendingScroll = undefined;
+      if (window.location.hash !== link.hash) history.pushState(null, '', link.hash);
+      target.focus({ preventScroll: true });
+      target.classList.add('navigation-arrival');
+    });
+
+    // A user taking over scrolling should not receive a delayed focus change.
+    function cancelPendingNavigation() {
+      if (!pendingScroll) return;
+      ++currentNavigation;
+      pendingScroll.abort();
+      pendingScroll = undefined;
+    }
+    window.addEventListener('wheel', cancelPendingNavigation, { passive: true });
+    window.addEventListener('touchstart', cancelPendingNavigation, { passive: true });
+    window.addEventListener('popstate', cancelPendingNavigation);
+    window.addEventListener('keydown', (event) => {
+      if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'PageUp', 'PageDown', 'Home', 'End', ' ', 'Tab', 'Escape'].includes(event.key)) {
+        cancelPendingNavigation();
+      }
+    });
+  </script>
