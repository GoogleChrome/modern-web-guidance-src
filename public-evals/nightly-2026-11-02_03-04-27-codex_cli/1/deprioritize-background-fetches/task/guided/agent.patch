diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,42 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Load data</title>
+  </head>
+  <body>
+    <button type="button" id="load">Load data</button>
+    <pre id="result" role="status" hidden></pre>
+
+    <script type="module">
+      const button = document.getElementById('load');
+      const result = document.getElementById('result');
+
+      button.addEventListener('click', () => {
+        button.disabled = true;
+        result.hidden = false;
+        result.textContent = 'Loading…';
+
+        // Start both requests immediately; only data controls the UI.
+        fetch('/api/data', { priority: 'high' })
+          .then(response => {
+            if (!response.ok) throw new Error(`Data request failed (${response.status})`);
+            return response.text();
+          })
+          .then(data => { result.textContent = data; })
+          .catch(error => { result.textContent = error.message; })
+          .finally(() => { button.disabled = false; });
+
+        fetch('/api/analytics', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ click: 1 }),
+          priority: 'low'
+        }).then(response => {
+          if (!response.ok) throw new Error(`Analytics request failed (${response.status})`);
+        }).catch(error => { console.warn(error); });
+      });
+    </script>
+  </body>
+</html>
