+    /* Class hooks work without container style queries or @property support.
+       Assign --icon-start / --icon-end in CSS; customize --icon-style-* on
+       an element or ancestor. All icons here repeat visible text, so their
+       generated content has empty alternative text. For a future informative
+       standalone icon, use role="img" and aria-label on its element. */
+    :where(.icon-start)::before,
+    :where(.icon-end)::after {
+      content: "";
+      content: "" / "";
+      display: inline-block;
+      width: var(--icon-style-size, 1em);
+      height: var(--icon-style-size, 1em);
+      background-color: var(--icon-style-color, currentColor);
+      -webkit-mask: var(--icon-image) no-repeat center / contain;
+      mask: var(--icon-image) no-repeat center / contain;
+      vertical-align: middle;
+      vertical-align: calc(0.5cap - var(--icon-style-size, 1em) / 2 + var(--icon-style-voffset, -0.02em));
+      flex: none;
+      pointer-events: none;
+      forced-color-adjust: none;
+    }
+
+    :where(.icon-start)::before {
+      --icon-image: var(--icon-start, none);
+    }
+
+    :where(.icon-end)::after {
+      --icon-image: var(--icon-end, none);
+    }
+
+    :where(.icon-start:not(:empty))::before {
+      margin-inline-end: var(--icon-style-spacing, 0.4em);
+    }
+
+    :where(.icon-end:not(:empty))::after {
+      margin-inline-start: var(--icon-style-spacing, 0.4em);
+    }
