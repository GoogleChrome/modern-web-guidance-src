+    .card .btn { --icon-end: var(--icon-arrow); }
+    .card--maple { --icon-start: var(--icon-leaf); }
+    .card--espresso { --icon-start: var(--icon-coffee); }
+    .card--cold-brew { --icon-start: var(--icon-snowflake); }
