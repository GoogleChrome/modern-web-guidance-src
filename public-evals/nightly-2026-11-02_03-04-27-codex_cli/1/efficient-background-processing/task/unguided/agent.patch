+  <script>
+    (() => {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const temperatureValue = document.getElementById('roast-temp-value');
+      const context = canvas.getContext('2d');
+      let frameId = null;
+      let temperatureInterval = null;
+      let inView = false;
+      let renderingSkipped = false;
+      let pageActive = true;
+      let running = false;
+      let lastTime = null;
+      let elapsed = 0;
+      let temperature = 185;
+      let width = 0;
+      let height = 0;
+      let pixelRatio = 1;
+      const beans = Array.from({ length: 38 }, () => ({
+        x: Math.random(),
+        y: Math.random(),
+        phase: Math.random() * Math.PI * 2,
+        speed: 0.045 + Math.random() * 0.055,
+        size: 7 + Math.random() * 5,
+      }));
+
+      function draw() {
+        if (!context) return;
+        const bounds = canvas.getBoundingClientRect();
+        const ratio = Math.min(window.devicePixelRatio || 1, 2);
+        if (width !== bounds.width || height !== bounds.height || ratio !== pixelRatio) {
+          width = bounds.width;
+          height = bounds.height;
+          pixelRatio = ratio;
+          canvas.width = Math.round(width * ratio);
+          canvas.height = Math.round(height * ratio);
+          context.setTransform(ratio, 0, 0, ratio, 0, 0);
+        }
+        context.clearRect(0, 0, width, height);
+        beans.forEach(bean => {
+          const x = ((bean.x + elapsed * bean.speed) % 1) * (width + 40) - 20;
+          const y = 28 + bean.y * Math.max(0, height - 56) + Math.sin(elapsed * 2 + bean.phase) * 12;
+          context.save();
+          context.translate(x, y);
+          context.rotate(bean.phase + elapsed * 1.4);
+          context.fillStyle = `hsl(24, 43%, ${35 - (temperature - 185) * 0.25}%)`;
+          context.beginPath();
+          context.ellipse(0, 0, bean.size, bean.size * 0.65, 0, 0, Math.PI * 2);
+          context.fill();
+          context.strokeStyle = '#281b17';
+          context.lineWidth = 2;
+          context.beginPath();
+          context.moveTo(-bean.size * 0.65, 0);
+          context.bezierCurveTo(-2, -4, 2, 4, bean.size * 0.65, 0);
+          context.stroke();
+          context.restore();
+        });
+      }
+
+      function animate(time) {
+        frameId = null;
+        if (!running) return;
+        if (lastTime !== null) elapsed += Math.min((time - lastTime) / 1000, 0.05);
+        lastTime = time;
+        draw();
+        frameId = requestAnimationFrame(animate);
+      }
+
+      function syncActivity() {
+        const shouldRun = inView && !renderingSkipped && !document.hidden && pageActive;
+        if (shouldRun === running) return;
+        running = shouldRun;
+        if (running) {
+          lastTime = null;
+          if (context) frameId = requestAnimationFrame(animate);
+          temperatureInterval = window.setInterval(() => {
+            temperature = Math.min(215, Math.max(185, temperature + (Math.random() - 0.35) * 2));
+            temperatureValue.textContent = temperature.toFixed(1);
+          }, 1000);
+        } else {
+          if (frameId !== null) cancelAnimationFrame(frameId);
+          if (temperatureInterval !== null) window.clearInterval(temperatureInterval);
+          frameId = null;
+          temperatureInterval = null;
+          lastTime = null;
+        }
+      }
+
+      function checkViewport() {
+        const bounds = widget.getBoundingClientRect();
+        inView = bounds.bottom > 0 && bounds.top < window.innerHeight &&
+          bounds.right > 0 && bounds.left < window.innerWidth;
+        syncActivity();
+      }
+
+      // Native content-visibility notifications are an extra guard, not a dependency.
+      widget.addEventListener('contentvisibilityautostatechange', event => {
+        renderingSkipped = event.skipped;
+        syncActivity();
+      });
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(entries => {
+          inView = entries[entries.length - 1].isIntersecting;
+          syncActivity();
+        });
+        observer.observe(widget);
+      } else {
+        // Older browsers need no continuous polling or animation while offscreen.
+        window.addEventListener('scroll', checkViewport, { passive: true, capture: true });
+        window.addEventListener('resize', checkViewport, { passive: true });
+      }
+
+      document.addEventListener('visibilitychange', syncActivity);
+      window.addEventListener('pagehide', () => {
+        pageActive = false;
+        syncActivity();
+      });
+      window.addEventListener('pageshow', () => {
+        pageActive = true;
+        checkViewport();
+      });
+      checkViewport();
+    })();
+  </script>
+
