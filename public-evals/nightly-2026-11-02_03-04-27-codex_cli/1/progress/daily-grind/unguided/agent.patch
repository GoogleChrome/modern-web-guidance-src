+    /* Rewards and order progress previews */
+    .progress-panel {
+      margin-bottom: 40px;
+      padding: 28px;
+      background: #fff8ef;
+      border: 1px solid #e8d9cb;
+      border-radius: 12px;
+    }
+
+    .progress-heading,
+    .progress-label {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      flex-wrap: wrap;
+      gap: 8px 16px;
+    }
+
+    .progress-heading {
+      margin-bottom: 24px;
+    }
+
+    .progress-eyebrow {
+      color: #795548;
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.12em;
+      text-transform: uppercase;
+    }
+
+    .preview-badge {
+      padding: 4px 12px;
+      border: 1px solid #d9c6b5;
+      border-radius: 20px;
+      color: #6d4c41;
+      font-size: 0.75rem;
+    }
+
+    .progress-items {
+      display: grid;
+      grid-template-columns: repeat(2, minmax(0, 1fr));
+      gap: 28px;
+    }
+
+    .progress-label {
+      margin-bottom: 10px;
+    }
+
+    .progress-label h3 {
+      font-size: 1rem;
+    }
+
+    .progress-value {
+      color: #795548;
+      font-size: 0.85rem;
+      font-weight: 600;
+    }
+
+    .progress-track {
+      height: 10px;
+      overflow: hidden;
+      background: #e9ddd1;
+      border-radius: 10px;
+    }
+
+    .progress-fill {
+      height: 100%;
+      border-radius: inherit;
+      background: var(--primary);
+    }
+
+    .progress-fill--rewards {
+      width: 60%;
+    }
+
+    .progress-fill--pending {
+      width: 40%;
+      background: #a85b19;
+      animation: brewing 1.8s ease-in-out infinite alternate;
+    }
+
+    .progress-description {
+      margin-top: 10px;
+      color: #6d4c41;
+      font-size: 0.85rem;
+    }
+
+    @keyframes brewing {
+      from { transform: translateX(-100%); }
+      to { transform: translateX(250%); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .progress-fill--pending {
+        animation: none;
+        transform: translateX(75%);
+      }
+    }
+
+    @media (max-width: 600px) {
+      .progress-panel { padding: 20px; }
+      .progress-items { grid-template-columns: 1fr; }
+    }
+
