+      margin: 6px 0;
+      font-size: clamp(1.7rem, 4vw, 2.2rem);
+    }
+
+    .showcase-grid {
+      display: grid;
+      grid-template-columns: 1.3fr 1fr;
+      gap: 32px;
+      align-items: center;
+    }
+
+    .showcase-grid > * {
+      min-width: 0;
+    }
+
+    .nested-curve-parent {
+      padding: 18px 22px 22px;
+      border: 1px solid #dfd2c6;
+      border-radius: 38px;
+      background: #eee5db;
+      overflow: clip;
+      overflow-clip-margin: content-box;
+    }
+
+    .showcase-photo {
+      display: block;
+      width: 100%;
+      height: 210px;
+      object-fit: cover;
+    }
+
+    .showcase-story {
+      padding: 24px;
+      background: #fffdf9;
+    }
+
+    .showcase-story h3 {
+      margin: 6px 0 8px;
+      font-size: 1.5rem;
+    }
+
+    .nested-curve-parent .showcase-footer {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      flex-wrap: wrap;
+      gap: 8px 16px;
+      margin: 0;
+      padding: 16px 24px;
+      background: var(--primary);
+      color: white;
+      text-align: left;
+      font-size: 0.85rem;
+    }
+
+    .showcase-footer a {
+      color: #ffd398;
+      text-underline-offset: 4px;
+    }
+
+    .safety-zone-parent {
+      padding: 32px;
+      border: 1px solid #e4c6a0;
+      border-radius: 24px;
+      background: #fff0da;
+      overflow: clip;
+      /* Permit ink (including the button glow) up to 15px past the edge. */
+      overflow-clip-margin: 15px;
+    }
+
+    /* A separate text clip keeps the parent's safety zone for the glow. */
+    .promo-copy {
+      overflow: clip;
+      overflow-wrap: anywhere;
+    }
+
+    .promo-copy h3 {
+      margin: 10px 0 12px;
+      font-size: clamp(1.8rem, 4vw, 2.4rem);
+      line-height: 1.15;
+    }
+
+    .promo-copy p:last-child {
+      color: #6d5144;
+    }
+
+    .promo-button {
+      display: block;
+      width: 100%;
+      margin-top: 28px;
+      padding: 15px 20px;
+      border: 0;
+      border-radius: 12px;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      font-weight: 700;
+      cursor: pointer;
+      box-shadow: 0 0 36px 12px rgb(255 171 64 / 65%);
+      transition: background 0.2s;
+    }
+
+    .promo-button:hover {
+      background: #6d4538;
+    }
+
+    .promo-button:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 4px;
+    }
+
+    @media (max-width: 700px) {
+      .showcase-grid {
+        grid-template-columns: 1fr;
+      }
+    }
+
