new file mode 100644
index 0000000..ee2e99b
--- /dev/null
+++ b/connections.js
@@ -0,0 +1,140 @@
+(() => {
+  'use strict';
+  const $ = (id) => document.getElementById(id);
+  const devices = [
+    { id: 'brewer', space: 'local', permission: 'local-network', label: 'brewer' },
+    { id: 'utility', space: 'loopback', permission: 'loopback-network', label: 'companion' },
+  ];
+  const permissionLabels = { granted: 'Allowed', denied: 'Blocked', prompt: 'Ask on connect', unknown: 'Browser managed' };
+  function updateCount() {
+    const count = devices.filter((device) => device.connected).length;
+    $('connection-count').textContent = `${count} of 2 connected`;
+    $('connection-count').parentElement.classList.toggle('has-connected', count > 0);
+  }
+  function feedback(device, message, error = false) {
+    $(`${device.id}-feedback`).textContent = message;
+    $(`${device.id}-feedback`).dataset.error = String(error);
+  }
+  function state(device, value) {
+    const badge = $(`${device.id}-state`);
+    badge.dataset.state = value;
+    badge.textContent = { idle: 'Not connected', connecting: 'Connecting…', connected: 'Connected', error: 'Connection failed' }[value];
+    const busy = value === 'connecting';
+    device.connected = value === 'connected';
+    $(`${device.id}-connect`).disabled = busy || device.connected;
+    $(`${device.id}-connect`).firstElementChild.textContent = busy ? 'Connecting…' : device.connected ? 'Connected' : `Connect ${device.label}`;
+    $(`${device.id}-url`).disabled = busy || device.connected;
+    $(`${device.id}-disconnect`).hidden = !busy && !device.connected;
+    $(`${device.id}-disconnect`).textContent = busy ? 'Cancel connection' : 'Disconnect';
+    $(`${device.id}-form`).setAttribute('aria-busy', String(busy));
+    updateCount();
+  }
+  function showPermission(device, value) {
+    device.permissionState = value;
+    const output = $(`${device.id}-permission`);
+    output.textContent = window.isSecureContext ? permissionLabels[value] : 'HTTPS required';
+    output.dataset.permission = value;
+    if (value === 'denied' && (device.connected || device.controller)) {
+      device.controller?.abort();
+      device.controller = null;
+      state(device, 'error');
+      feedback(device, 'Access is blocked. Allow network access in your browser’s site settings, then reconnect.', true);
+    }
+  }
+  async function observePermission(device) {
+    if (!window.isSecureContext || !navigator.permissions?.query) {
+      showPermission(device, 'unknown');
+      return;
+    }
+    // Older browsers expose one shared permission instead of the two granular permissions.
+    for (const name of [device.permission, 'local-network-access']) {
+      try {
+        const result = await navigator.permissions.query({ name });
+        device.permissionStatus = result;
+        showPermission(device, result.state);
+        result.addEventListener('change', () => showPermission(device, result.state));
+        return;
+      } catch { /* Unsupported permission descriptor; try the legacy name. */ }
+    }
+    showPermission(device, 'unknown');
+  }
+  function endpoint(raw, device) {
+    let url;
+    try { url = new URL(raw.trim()); } catch { throw new Error('Enter a full status URL, including http:// or https://.'); }
+    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+      throw new Error('Use an HTTP or HTTPS status URL without credentials or a fragment.');
+    }
+    const host = url.hostname.toLowerCase();
+    const ipv4 = host.split('.').map(Number);
+    const isIPv4 = ipv4.length === 4 && ipv4.every((part) => Number.isInteger(part) && part >= 0 && part <= 255);
+    const loopback = host === 'localhost' || host.endsWith('.localhost') || host === '[::1]' || (isIPv4 && ipv4[0] === 127);
+    const privateIP = isIPv4 && (ipv4[0] === 10 || (ipv4[0] === 172 && ipv4[1] >= 16 && ipv4[1] <= 31) || (ipv4[0] === 192 && ipv4[1] === 168) || (ipv4[0] === 169 && ipv4[1] === 254));
+    const localIPv6 = /^\[(?:f[cd][0-9a-f]{2}:|fe[89ab][0-9a-f]:)/i.test(host);
+    if (device.space === 'loopback' && !loopback) throw new Error('Use this device’s loopback address: localhost, 127.0.0.1, or [::1], with your utility’s port.');
+    if (device.space === 'local' && !(privateIP || localIPv6 || host.endsWith('.local'))) throw new Error('Use your brewer’s private network IP address or .local hostname, for example 192.168.1.100.');
+    return url;
+  }
+  for (const device of devices) {
+    device.connected = false;
+    observePermission(device);
+    $(`${device.id}-form`).addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (device.controller || device.connected) return;
+      let url;
+      try {
+        url = endpoint($(`${device.id}-url`).value, device);
+        if (!window.isSecureContext) throw new Error('Open this page over HTTPS or localhost to use browser network permissions.');
+        if (device.permissionState === 'denied') throw new Error('Access is blocked. Allow network access in your browser’s site settings, then try again.');
+      } catch (error) {
+        state(device, 'error');
+        feedback(device, error.message, true);
+        $(`${device.id}-url`).focus();
+        return;
+      }
+      const controller = new AbortController();
+      device.controller = controller;
+      let timedOut = false;
+      const timer = setTimeout(() => { timedOut = true; controller.abort(); }, 15000);
+      state(device, 'connecting');
+      feedback(device, 'Waiting for the status endpoint. If your browser asks, allow network access.');
+      try {
+        const response = await fetch(url.href, {
+          method: 'GET', mode: 'cors', credentials: 'omit', cache: 'no-store',
+          redirect: 'error', signal: controller.signal, targetAddressSpace: device.space,
+        });
+        if (device.controller !== controller) return;
+        if (!response.ok) throw new Error(`The endpoint returned HTTP ${response.status}. Check the status URL and device configuration, then try again.`);
+        state(device, 'connected');
+        feedback(device, `Status endpoint reached at ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}. Disconnect and reconnect to check again.`);
+      } catch (error) {
+        if (device.controller !== controller) return;
+        state(device, 'error');
+        const message = timedOut ? 'Connection timed out after 15 seconds. Check the address, Wi-Fi or utility, and try again.'
+          : device.permissionState === 'denied' ? 'Access is blocked. Allow network access in your browser’s site settings, then try again.'
+          : error instanceof TypeError ? `Could not reach the ${device.label}. Check ${device.space === 'local' ? 'the shared Wi-Fi and brewer address' : 'that the companion is running and its port is correct'}. Browser permissions, HTTPS restrictions, or endpoint CORS settings can also block access. See Connection help.`
+          : error.message;
+        feedback(device, message, true);
+      } finally {
+        clearTimeout(timer);
+        if (device.controller === controller) device.controller = null;
+      }
+    });
+    $(`${device.id}-disconnect`).addEventListener('click', () => {
+      device.controller?.abort();
+      device.controller = null;
+      state(device, 'idle');
+      feedback(device, 'Disconnected. Choose Connect whenever you’re ready to check again.');
+    });
+    $(`${device.id}-url`).addEventListener('input', () => {
+      if (!device.controller && !device.connected) {
+        state(device, 'idle');
+        feedback(device, 'Address updated. Choose Connect to check this endpoint.');
+      }
+    });
+  }
+  $('help-toggle').addEventListener('click', () => {
+    const expanded = $('help-toggle').getAttribute('aria-expanded') === 'true';
+    $('help-toggle').setAttribute('aria-expanded', String(!expanded));
+    $('connection-help').hidden = expanded;
+  });
+})();
