--- /dev/null
+++ b/equipment.mjs
@@ -0,0 +1,193 @@
+/** Validate destinations without scanning the network or sending a request. */
+export function parseEndpoint(value, space) {
+  let url;
+  try {
+    url = new URL(value);
+  } catch {
+    throw new Error('Enter a complete status URL, including http:// or https://.');
+  }
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use an HTTP or HTTPS URL without a username, password, or fragment.');
+  }
+  const host = url.hostname.toLowerCase().replace(/\.$/, '');
+  const ipv4 = /^\d+\.\d+\.\d+\.\d+$/.test(host) ? host.split('.').map(Number) : null;
+  const loopback = host === 'localhost' || host.endsWith('.localhost') ||
+    host === '[::1]' || ipv4?.[0] === 127;
+  const local = host.endsWith('.local') || (ipv4 && (
+    ipv4[0] === 10 || (ipv4[0] === 172 && ipv4[1] >= 16 && ipv4[1] <= 31) ||
+    (ipv4[0] === 192 && ipv4[1] === 168) || (ipv4[0] === 169 && ipv4[1] === 254)
+  )) || /^\[f[cd][0-9a-f]{2}:/.test(host) || /^\[fe[89ab][0-9a-f]:/.test(host);
+  if (space === 'loopback' ? !loopback : !local) {
+    throw new Error(space === 'loopback'
+      ? 'Use a loopback address on this computer: localhost, 127.0.0.1, or [::1].'
+      : 'Use your brewer’s private IP address or a .local hostname on the same network.');
+  }
+  return url;
+}
+
+/** Unsupported permission names must never prevent a user-initiated attempt. */
+export async function queryPermission(space, permissions = globalThis.navigator?.permissions) {
+  try {
+    return await permissions?.query({ name: `${space}-network` }) ?? null;
+  } catch {
+    return null;
+  }
+}
+
+export async function requestStatus(url, space, signal) {
+  const response = await fetch(url, {
+    method: 'GET',
+    mode: 'cors',
+    targetAddressSpace: space,
+    credentials: 'omit',
+    referrerPolicy: 'no-referrer',
+    redirect: 'error',
+    cache: 'no-store',
+    signal,
+  });
+  // A successful status endpoint need not implement a particular JSON schema.
+  if (response.body) await response.body.cancel();
+  if (!response.ok) throw new Error(`The endpoint responded with HTTP ${response.status}. Check the status URL and equipment configuration, then retry.`);
+}
+
+function initializeCard(form) {
+  const space = form.dataset.space;
+  const input = form.elements.endpoint;
+  const button = form.querySelector('button');
+  const status = form.querySelector('.connection-status');
+  const feedback = form.querySelector('.connection-feedback');
+  const permissionLabel = form.querySelector('[data-permission]');
+  const permissionHelp = form.querySelector('[data-permission-help]');
+  const name = space === 'local' ? 'brewer' : 'companion';
+  const permissionName = space === 'local' ? 'Local network' : 'Loopback network';
+  let permission = null;
+  let controller = null;
+  let generation = 0;
+
+  function updatePermission() {
+    const state = permission?.state;
+    permissionLabel.textContent = {
+      granted: 'Allowed', prompt: 'Ask when connecting', denied: 'Blocked',
+    }[state] ?? 'Not reported by this browser';
+    permissionHelp.textContent = state === 'denied'
+      ? `Open this site’s browser settings and allow ${permissionName} access, then retry.`
+      : state === 'granted' ? 'Permission allowed. Connect to check whether the equipment is reachable.'
+      : state === 'prompt' ? `Select Connect to request access to your ${name}.`
+      : 'You can still try connecting. Your browser may ask for access or block this connection.';
+    if (!globalThis.isSecureContext) {
+      permissionHelp.textContent = 'Open this homepage over HTTPS to connect securely.';
+    }
+    if (state === 'denied' && form.dataset.state === 'success') {
+      form.dataset.state = 'error';
+      status.textContent = 'Permission blocked';
+      feedback.textContent = `Access was revoked. Allow ${permissionName} access in this site’s browser settings, then retry.`;
+    }
+  }
+
+  async function refreshPermission() {
+    const next = await queryPermission(space);
+    if (permission !== next) {
+      permission?.removeEventListener('change', updatePermission);
+      permission = next;
+      permission?.addEventListener('change', updatePermission);
+    }
+    updatePermission();
+  }
+
+  function reset() {
+    generation++;
+    controller?.abort();
+    controller = null;
+    button.disabled = false;
+    button.textContent = `Connect ${name} →`;
+    form.removeAttribute('aria-busy');
+    form.dataset.state = 'idle';
+    status.textContent = 'Not connected';
+    feedback.textContent = 'Address changed. Connect to check this endpoint.';
+    input.setCustomValidity('');
+  }
+
+  input.addEventListener('input', reset);
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (controller) return;
+    let url;
+    try {
+      url = parseEndpoint(input.value.trim(), space);
+    } catch (error) {
+      form.dataset.state = 'error';
+      status.textContent = 'Check the address';
+      feedback.textContent = error.message;
+      input.setCustomValidity(error.message);
+      input.reportValidity();
+      return;
+    }
+    if (!globalThis.isSecureContext) {
+      form.dataset.state = 'error';
+      status.textContent = 'Secure page required';
+      feedback.textContent = 'Open this homepage over HTTPS to request equipment access, then retry.';
+      return;
+    }
+    if (permission?.state === 'denied') {
+      form.dataset.state = 'error';
+      status.textContent = 'Permission blocked';
+      feedback.textContent = `Allow ${permissionName} access in this site’s browser settings, then retry.`;
+      // Refresh without issuing a device request; settings may have just changed.
+      void refreshPermission();
+      return;
+    }
+
+    const attempt = ++generation;
+    const attemptController = new AbortController();
+    controller = attemptController;
+    const signal = attemptController.signal;
+    let timedOut = false;
+    const timeout = setTimeout(() => {
+      timedOut = true;
+      attemptController.abort();
+    }, 20000);
+    form.dataset.state = 'connecting';
+    form.setAttribute('aria-busy', 'true');
+    status.textContent = 'Connecting…';
+    feedback.textContent = 'Allow access if your browser asks. Waiting for the status endpoint…';
+    button.textContent = 'Connecting…';
+    button.disabled = true;
+
+    try {
+      // This first request starts directly in the user’s submit handler.
+      await requestStatus(url, space, signal);
+      if (attempt !== generation) return;
+      form.dataset.state = 'success';
+      status.textContent = 'Connected · status checked';
+      feedback.textContent = `Your ${name} responded successfully at ${new Date().toLocaleTimeString()}. This is a one-time check; no brewing was started.`;
+    } catch (error) {
+      if (attempt !== generation) return;
+      await refreshPermission();
+      if (attempt !== generation) return;
+      form.dataset.state = 'error';
+      status.textContent = permission?.state === 'denied' ? 'Permission blocked' : 'Connection failed';
+      feedback.textContent = permission?.state === 'denied'
+        ? `Allow ${permissionName} access in this site’s browser settings, then retry.`
+        : timedOut ? 'The connection timed out after 20 seconds. Check the address, confirm your equipment is running, and retry. Allow access if your browser asks.'
+        : error instanceof TypeError
+          ? `Could not reach the ${name}. ${space === 'local' ? 'Check that it is powered on and on the same Wi-Fi network.' : 'Open the companion on this computer and check its port.'} Also check browser access, HTTPS/certificate settings, and whether the endpoint allows cross-origin requests. The browser cannot identify the exact cause.`
+          : error.message;
+    } finally {
+      clearTimeout(timeout);
+      if (attempt === generation) {
+        controller = null;
+        form.removeAttribute('aria-busy');
+        button.disabled = false;
+        button.textContent = form.dataset.state === 'success' ? 'Check connection again →' : `Retry ${name} →`;
+        void refreshPermission();
+      }
+    }
+  });
+
+  void refreshPermission();
+  window.addEventListener('focus', () => { void refreshPermission(); });
+}
+
+if (typeof document !== 'undefined') {
+  document.querySelectorAll('.equipment-card').forEach(initializeCard);
+}
diff --git a/equipment.test.mjs b/equipment.test.mjs
new file mode 100644
index 0000000..2c23277
--- /dev/null
+++ b/equipment.test.mjs
@@ -0,0 +1,76 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { parseEndpoint, queryPermission, requestStatus } from './equipment.mjs';
+
+test('brewer accepts LAN addresses, including IPv6, but excludes loopback and public hosts', () => {
+  for (const host of ['coffee-brewer.local', '10.0.0.5', '172.16.0.2', '172.31.255.1', '192.168.1.42', '169.254.1.1', '[fd12::1]', '[fe80::1]']) {
+    assert.equal(parseEndpoint(`http://${host}/status`, 'local').pathname, '/status');
+  }
+  for (const host of ['localhost', '127.0.0.1', '[::1]', 'example.com', '8.8.8.8', '172.15.0.2', '172.32.0.1', 'brewer.local.example.com']) {
+    assert.throws(() => parseEndpoint(`http://${host}/status`, 'local'));
+  }
+});
+
+test('companion accepts only loopback destinations', () => {
+  for (const host of ['localhost', 'localhost.', 'brew.localhost', '127.0.0.1', '127.1.2.3', '[::1]']) {
+    assert.equal(parseEndpoint(`http://${host}:45678/health`, 'loopback').port, '45678');
+  }
+  for (const host of ['192.168.1.42', 'brewer.local', 'localhost.example.com', '[fd12::1]', 'example.com']) {
+    assert.throws(() => parseEndpoint(`http://${host}/health`, 'loopback'));
+  }
+});
+
+test('invalid URLs, credentials, fragments, and non-HTTP protocols are rejected', () => {
+  for (const value of ['not a url', 'ftp://brewer.local/status', 'http://user:pass@brewer.local/status', 'http://brewer.local/#status']) {
+    assert.throws(() => parseEndpoint(value, 'local'));
+  }
+});
+
+test('permission queries stay granular and gracefully handle unavailable APIs', async () => {
+  for (const space of ['local', 'loopback']) {
+    const expected = { state: 'prompt' };
+    const result = await queryPermission(space, {
+      query: async ({ name }) => {
+        assert.equal(name, `${space}-network`);
+        return expected;
+      },
+    });
+    assert.equal(result, expected);
+  }
+  assert.equal(await queryPermission('local', {}), null);
+  assert.equal(await queryPermission('loopback', { query() { throw new TypeError('Unsupported permission'); } }), null);
+});
+
+test('status requests declare the address space and never send credentials or follow redirects', async (t) => {
+  for (const space of ['local', 'loopback']) {
+    const signal = new AbortController().signal;
+    const url = space === 'local' ? 'http://brewer.local/status' : 'http://localhost/health';
+    t.mock.method(globalThis, 'fetch', async (actualUrl, options) => {
+      assert.equal(actualUrl, url);
+      assert.deepEqual(options, {
+        method: 'GET', mode: 'cors', targetAddressSpace: space,
+        credentials: 'omit', referrerPolicy: 'no-referrer', redirect: 'error', cache: 'no-store', signal,
+      });
+      return new Response(null, { status: 204 });
+    });
+    await requestStatus(url, space, signal);
+    t.mock.restoreAll();
+  }
+});
+
+test('HTTP and network failures are never reported as successful checks', async (t) => {
+  t.mock.method(globalThis, 'fetch', async () => new Response('Unavailable', { status: 503 }));
+  await assert.rejects(requestStatus('http://brewer.local/status', 'local'), /HTTP 503/);
+  t.mock.restoreAll();
+  t.mock.method(globalThis, 'fetch', async () => { throw new TypeError('Failed to fetch'); });
+  await assert.rejects(requestStatus('http://localhost/health', 'loopback'), /Failed to fetch/);
+});
+
+test('cancellation signals are passed through to the connection request', async (t) => {
+  const controller = new AbortController();
+  controller.abort();
+  t.mock.method(globalThis, 'fetch', async (url, { signal }) => {
+    signal.throwIfAborted();
+  });
+  await assert.rejects(requestStatus('http://localhost/health', 'loopback', controller.signal), { name: 'AbortError' });
+});
