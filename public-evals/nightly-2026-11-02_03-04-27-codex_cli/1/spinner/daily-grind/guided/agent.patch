+  <script>
+    const loadingLinks = document.querySelectorAll('[data-loading-link]');
+    const loadingStatus = document.getElementById('loading-status');
+    const seasonalFavorites = document.getElementById('seasonal-favorites');
+
+    function resetLoading() {
+      loadingLinks.forEach((link) => {
+        link.removeAttribute('aria-busy');
+        link.removeAttribute('aria-disabled');
+        link.querySelector('[data-link-label]').textContent = link.dataset.idleText;
+        link.querySelector('progress').hidden = true;
+      });
+      seasonalFavorites.setAttribute('aria-busy', 'false');
+      loadingStatus.textContent = '';
+    }
+
+    loadingLinks.forEach((link) => {
+      link.dataset.idleText = link.querySelector('[data-link-label]').textContent;
+      link.addEventListener('click', (event) => {
+        // Leave new-tab, download, and already-cancelled navigation untouched.
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+            event.ctrlKey || event.shiftKey || event.altKey || link.hasAttribute('download') ||
+            (link.target && link.target !== '_self')) return;
+
+        if (link.getAttribute('aria-disabled') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        resetLoading();
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        link.querySelector('[data-link-label]').textContent = link.dataset.loadingText;
+        link.querySelector('progress').hidden = false;
+        if (link.dataset.drink) seasonalFavorites.setAttribute('aria-busy', 'true');
+        // Keep this announcement outside the busy region so it is not deferred.
+        loadingStatus.textContent = link.dataset.drink
+          ? `Loading details for ${link.dataset.drink}…`
+          : 'Starting your order…';
+        // The native link navigation continues without an artificial delay.
+      });
+    });
+
+    // History restoration can preserve DOM state from before navigation.
+    window.addEventListener('pageshow', resetLoading);
+  </script>
