+  <p id="loading-status" class="sr-only" role="status" aria-atomic="true"></p>
+
+  <script>
+    const loadingLinks = document.querySelectorAll('[data-loading-message]');
+    const loadingStatus = document.getElementById('loading-status');
+
+    function resetLoading() {
+      loadingLinks.forEach((link) => {
+        link.removeAttribute('aria-busy');
+        link.removeAttribute('aria-disabled');
+        link.querySelector('[data-label]').textContent = link.dataset.originalLabel;
+        link.closest('[data-loading-region]')?.removeAttribute('aria-busy');
+      });
+      loadingStatus.textContent = '';
+    }
+
+    loadingLinks.forEach((link) => {
+      link.dataset.originalLabel = link.querySelector('[data-label]').textContent;
+      link.addEventListener('click', (event) => {
+        // Preserve opening links in another tab or window and cancelled clicks.
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+            event.ctrlKey || event.shiftKey || event.altKey) return;
+
+        if (link.getAttribute('aria-busy') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        resetLoading();
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        link.querySelector('[data-label]').textContent = link.dataset.loadingMessage;
+        link.closest('[data-loading-region]')?.setAttribute('aria-busy', 'true');
+        loadingStatus.textContent = link.dataset.loadingMessage;
+        // Let the browser follow the existing URL, including keyboard activation.
+      });
+    });
+
+    // Restore controls when navigating back, including the back/forward cache.
+    window.addEventListener('pageshow', resetLoading);
+  </script>
