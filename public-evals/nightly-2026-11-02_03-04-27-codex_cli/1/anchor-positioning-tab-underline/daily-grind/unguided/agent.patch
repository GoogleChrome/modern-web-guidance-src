+  <script>
+    const navList = document.querySelector('nav ul');
+    const navItems = [...navList.querySelectorAll('[data-nav-item]')];
+    let activeItem = navItems.find(item =>
+      location.pathname === item.pathname || location.pathname.startsWith(item.pathname + '/')
+    ) || navItems[0];
+
+    function updateIndicator() {
+      const listBounds = navList.getBoundingClientRect();
+      const itemBounds = activeItem.getBoundingClientRect();
+      navList.style.setProperty('--indicator-x', `${itemBounds.left - listBounds.left}px`);
+      navList.style.setProperty('--indicator-width', `${itemBounds.width}px`);
+    }
+
+    function selectItem(item) {
+      activeItem = item;
+      navItems.forEach(link => {
+        if (link === activeItem) {
+          link.setAttribute('aria-current', 'true');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+      updateIndicator();
+    }
+
+    navItems.forEach(item => {
+      item.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        selectItem(item);
+      });
+    });
+
+    selectItem(activeItem);
+    requestAnimationFrame(() => {
+      requestAnimationFrame(() => navList.classList.add('indicator-ready'));
+    });
+    new ResizeObserver(updateIndicator).observe(navList);
+    document.fonts.ready.then(updateIndicator);
+  </script>
 </body>
 
