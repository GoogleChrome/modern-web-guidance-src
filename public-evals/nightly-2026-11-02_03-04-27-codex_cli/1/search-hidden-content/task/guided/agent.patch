+  <script>
+    const couponPanel = document.getElementById('coupon-panel');
+    const couponButton = document.getElementById('reveal-coupon');
+
+    // Both clicks and browser search reveal permanently; there is no hide action.
+    function revealCoupon() {
+      couponPanel.removeAttribute('hidden');
+      couponButton.setAttribute('aria-expanded', 'true');
+      couponButton.textContent = 'View coupon';
+    }
+
+    couponPanel.addEventListener('beforematch', revealCoupon);
+    couponButton.addEventListener('click', () => {
+      revealCoupon();
+      couponPanel.focus();
+    });
+
+    const tablist = document.querySelector('.business-tabs');
+    const tabs = [...tablist.querySelectorAll('.wholesale-tab')];
+    const panels = tabs.map(tab => document.getElementById(tab.getAttribute('aria-controls')));
+    const supportsSearchableHiding = 'onbeforematch' in HTMLElement.prototype;
+
+    function selectTab(index) {
+      tabs.forEach((tab, i) => {
+        const selected = i === index;
+        tab.setAttribute('aria-selected', String(selected));
+        tab.tabIndex = selected ? 0 : -1;
+        if (selected) panels[i].removeAttribute('hidden');
+        else panels[i].setAttribute('hidden', 'until-found');
+      });
+    }
+
+    if (supportsSearchableHiding) {
+      tabs.forEach((tab, index) => {
+        tab.addEventListener('click', () => selectTab(index));
+        // Native find-in-page and fragment navigation must select the matched tab too.
+        panels[index].addEventListener('beforematch', () => selectTab(index));
+      });
+      tablist.addEventListener('keydown', event => {
+        const index = tabs.indexOf(document.activeElement);
+        if (index < 0) return;
+        let next;
+        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
+        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
+        else if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = tabs.length - 1;
+        else return;
+        event.preventDefault();
+        selectTab(next);
+        tabs[next].focus();
+      });
+    } else {
+      // Unsupported browsers get searchable, linear content with anchor navigation.
+      revealCoupon();
+      tablist.removeAttribute('role');
+      tablist.removeAttribute('aria-label');
+      tabs.forEach((tab, index) => {
+        const link = document.createElement('a');
+        link.className = tab.className;
+        link.href = '#' + panels[index].id;
+        link.textContent = tab.textContent;
+        panels[index].removeAttribute('hidden');
+        panels[index].removeAttribute('role');
+        panels[index].removeAttribute('aria-labelledby');
+        panels[index].removeAttribute('tabindex');
+        tab.replaceWith(link);
+      });
+    }
+  </script>
