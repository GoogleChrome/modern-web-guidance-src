diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..bcdbe7a
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,171 @@
+/** A form-associated rating: the host owns the value and validation. */
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required', 'disabled'];
+
+  #internals;
+  #buttons;
+  #value = '';
+  #dirty = false;
+  #disabled = false;
+  #showError = false;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.innerHTML = `
+      <style>
+        :host { display: block; }
+        .stars { display: flex; gap: 6px; width: fit-content; }
+        button { width: 44px; height: 46px; border: 1px solid #c9bcb3; border-radius: 6px;
+          background: #fffdfb; color: #88776c; cursor: pointer; font: 30px/1 Georgia, serif; }
+        button.filled { color: #a15f12; background: #fff4dc; border-color: #bd8c4b; }
+        button:hover:not(:disabled) { background: #f5e3c4; }
+        button:focus-visible { outline: 3px solid #a56b35; outline-offset: 3px; }
+        button:disabled { cursor: not-allowed; opacity: .45; }
+        p { margin: 8px 0 0; font: .8rem/1.5 'Segoe UI', sans-serif; color: #79685f; }
+        #error { color: #a02c22; }
+        [hidden] { display: none; }
+        @media (forced-colors: active) { button.filled { border: 3px solid Highlight; } }
+      </style>
+      <div class="stars" role="radiogroup" aria-label="Coffee rating" aria-describedby="hint error">
+        ${[1, 2, 3, 4, 5].map(value => `<button type="button" role="radio" aria-checked="false" aria-label="${value} ${value === 1 ? 'star' : 'stars'}" data-value="${value}"><span aria-hidden="true">☆</span></button>`).join('')}
+      </div>
+      <p id="hint" aria-live="polite">Choose 1 to 5 stars · Use arrow keys to adjust</p>
+      <p id="error" hidden>Please choose a star rating.</p>
+    `;
+    this.#buttons = [...root.querySelectorAll('button')];
+    root.addEventListener('click', event => {
+      const button = event.target.closest('button');
+      if (button && !this.#disabled) this.#select(button.dataset.value);
+    });
+    root.addEventListener('keydown', event => {
+      if (this.#disabled || !['ArrowRight', 'ArrowUp', 'ArrowLeft', 'ArrowDown', 'Home', 'End'].includes(event.key)) return;
+      event.preventDefault();
+      const current = Number(this.#value);
+      let next;
+      if (event.key === 'Home') next = 1;
+      else if (event.key === 'End') next = 5;
+      else if (event.key === 'ArrowRight' || event.key === 'ArrowUp') next = current % 5 + 1;
+      else next = current <= 1 ? 5 : current - 1;
+      this.#select(String(next));
+      this.#buttons[next - 1].focus();
+    });
+    this.addEventListener('invalid', () => {
+      this.#showError = true;
+      this.#render();
+    });
+  }
+
+  connectedCallback() {
+    this.#sync();
+  }
+
+  attributeChangedCallback(name) {
+    if (name === 'value' && !this.#dirty) this.#value = this.#normalize(this.defaultValue);
+    if (name === 'disabled') this.#disabled = this.matches(':disabled');
+    this.#sync();
+  }
+
+  get value() { return this.#value; }
+  set value(value) {
+    this.#dirty = true;
+    this.#value = this.#normalize(value);
+    this.#sync();
+  }
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(value) { this.setAttribute('value', value); }
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.setAttribute('name', value); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+  focus(options) { this.#buttons[(Number(this.#value) || 1) - 1].focus(options); }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#showError = false;
+    this.#value = this.#normalize(this.defaultValue);
+    this.#sync();
+  }
+
+  formDisabledCallback(disabled) {
+    // Includes inherited fieldset state; never reflect this onto the host attribute.
+    this.#disabled = disabled;
+    this.#sync();
+  }
+
+  formStateRestoreCallback(state) {
+    this.value = typeof state === 'string' ? state : '';
+    this.#showError = false;
+    this.#render();
+  }
+
+  #normalize(value) {
+    const text = String(value);
+    return /^[1-5]$/.test(text) ? text : '';
+  }
+
+  #select(value) {
+    if (value === this.#value) return;
+    this.value = value;
+    this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  #sync() {
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    const missing = this.required && !this.#value;
+    this.#internals.setValidity(
+      missing ? { valueMissing: true } : {},
+      missing ? 'Please choose a star rating.' : '',
+      this.#buttons[(Number(this.#value) || 1) - 1]
+    );
+    this.#render();
+  }
+
+  #render() {
+    const selected = Number(this.#value);
+    this.#buttons.forEach((button, index) => {
+      button.disabled = this.#disabled;
+      button.tabIndex = !this.#disabled && index === (selected || 1) - 1 ? 0 : -1;
+      button.setAttribute('aria-checked', String(index + 1 === selected));
+      button.classList.toggle('filled', index < selected);
+      button.firstElementChild.textContent = index < selected ? '★' : '☆';
+    });
+    const group = this.shadowRoot.querySelector('[role="radiogroup"]');
+    group.setAttribute('aria-required', String(this.required));
+    group.setAttribute('aria-disabled', String(this.#disabled));
+    const invalid = this.#showError && this.required && !selected && !this.#disabled;
+    group.setAttribute('aria-invalid', String(invalid));
+    this.shadowRoot.getElementById('error').hidden = !invalid;
+    this.shadowRoot.getElementById('hint').textContent = selected
+      ? `${selected} out of 5 stars · ${['', 'Not my cup', 'Could be better', 'Pretty good', 'Loved it', 'Made my day'][selected]}`
+      : 'Choose 1 to 5 stars · Use arrow keys to adjust';
+  }
+}
+
+customElements.define('star-rating', StarRating);
+
+const form = document.getElementById('coffee-feedback');
+const result = document.getElementById('feedback-result');
+
+form.addEventListener('submit', event => {
+  event.preventDefault();
+  // The custom element contributes its value through ElementInternals.
+  const data = new FormData(form);
+  const comments = data.get('comments')?.trim();
+  result.textContent = `Feedback preview: ${data.get('coffee')} — ${data.get('rating')} out of 5 stars.${comments ? ` Your note: ${comments}` : ''} This demo hasn’t sent or saved your feedback.`;
+});
+
+form.addEventListener('reset', () => { result.textContent = ''; });
+form.addEventListener('input', () => { result.textContent = ''; });
