+++ b/verification.js
@@ -0,0 +1,236 @@
+'use strict';
+
+const phoneForm = document.querySelector('#phone-form');
+const otpForm = document.querySelector('#otp-form');
+const phone = document.querySelector('#phone');
+const otp = document.querySelector('#otp');
+const sendButton = document.querySelector('#send-code');
+const verifyButton = document.querySelector('#verify-code');
+const status = document.querySelector('#verification-status');
+const phoneError = document.querySelector('#phone-error');
+const otpError = document.querySelector('#otp-error');
+const otpHint = document.querySelector('#otp-hint');
+const intentInputs = [...document.querySelectorAll('input[name="intent"]')];
+let challenge = null;
+let smsController = null;
+let requestController = null;
+let cooldownUntil = 0;
+let busy = false;
+let automaticCode = false;
+let generation = 0;
+
+const intent = () => intentInputs.find(input => input.checked).value;
+const normalizedPhone = () => phone.value.replace(/[\s().-]/g, '');
+
+function stopSmsListener() {
+  smsController?.abort();
+  smsController = null;
+}
+
+function showError(input, element, message) {
+  element.textContent = message;
+  input.setAttribute('aria-invalid', 'true');
+  input.focus();
+}
+
+function clearError(input, element) {
+  element.textContent = '';
+  input.removeAttribute('aria-invalid');
+}
+
+function updateButtons() {
+  const remaining = Math.max(0, Math.ceil((cooldownUntil - Date.now()) / 1000));
+  sendButton.disabled = busy || remaining > 0;
+  sendButton.textContent = busy ? 'Please wait…' : remaining ? `Resend in ${remaining}s` : challenge ? 'Resend code' : 'Send code ↗';
+  verifyButton.disabled = busy;
+  verifyButton.textContent = busy ? 'Please wait…' : intent() === 'order' ? 'Verify & continue to order →' : 'Verify & sign in →';
+  phone.readOnly = busy;
+  otp.readOnly = busy;
+  intentInputs.forEach(input => { input.disabled = busy; });
+  phoneForm.setAttribute('aria-busy', String(busy));
+  otpForm.setAttribute('aria-busy', String(busy));
+}
+
+// Listen before sending the SMS so fast deliveries are not missed. Every
+// request is bound to the current phone/purpose and cancelled when they change.
+async function startSmsListener(version) {
+  stopSmsListener();
+  if (!window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+  const controller = new AbortController();
+  smsController = controller;
+  const timeout = setTimeout(() => controller.abort(), 120000);
+  try {
+    const credential = await navigator.credentials.get({
+      otp: { transport: ['sms'] },
+      signal: controller.signal,
+    });
+    if (!credential || controller.signal.aborted || version !== generation || !/^[0-9]{6}$/.test(credential.code)) return;
+    otp.value = credential.code;
+    automaticCode = true;
+    clearError(otp, otpError);
+    if (challenge && !busy) otpForm.requestSubmit();
+  } catch {
+    // Denial, timeout, or lack of platform support leaves autofill and manual
+    // entry available. These are optional enhancements, not form errors.
+  } finally {
+    clearTimeout(timeout);
+    if (smsController === controller) smsController = null;
+  }
+}
+
+async function post(url, payload) {
+  const controller = new AbortController();
+  requestController = controller;
+  const timeout = setTimeout(() => controller.abort(), 20000);
+  try {
+    const response = await fetch(url, {
+      method: 'POST',
+      credentials: 'same-origin',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify(payload),
+      signal: controller.signal,
+    });
+    if (response.status === 429) {
+      const retryAfter = Number(response.headers.get('Retry-After'));
+      cooldownUntil = Date.now() + Math.max(30, Number.isFinite(retryAfter) ? retryAfter : 30) * 1000;
+      throw new Error('Too many attempts. Please wait a moment and try again.');
+    }
+    if (!response.headers.get('content-type')?.includes('application/json')) {
+      throw new Error('Text verification is unavailable right now. Please try again later.');
+    }
+    let data;
+    try { data = await response.json(); } catch {
+      throw new Error('Text verification is unavailable right now. Please try again later.');
+    }
+    if (!data || typeof data !== 'object') throw new Error('Text verification is unavailable right now. Please try again later.');
+    if (!response.ok) {
+      if (response.status === 400 || response.status === 401 || response.status === 410) {
+        throw new Error(url === '/api/auth/sms/verify' ? 'That code is invalid or expired. Try again or request a new code.' : 'We couldn’t send a code to that number. Please check it and try again.');
+      }
+      throw new Error('Text verification is unavailable right now. Please try again later.');
+    }
+    return data;
+  } finally {
+    clearTimeout(timeout);
+    if (requestController === controller) requestController = null;
+  }
+}
+
+function resetChallenge() {
+  generation += 1;
+  stopSmsListener();
+  challenge = null;
+  automaticCode = false;
+  otp.value = '';
+  otpHint.textContent = 'Enter the 6-digit code sent to your phone.';
+  status.textContent = '';
+  clearError(otp, otpError);
+  updateButtons();
+}
+
+phone.addEventListener('input', () => {
+  clearError(phone, phoneError);
+  phone.setCustomValidity('');
+  resetChallenge();
+});
+otp.addEventListener('input', () => {
+  automaticCode = false;
+  clearError(otp, otpError);
+  otp.setCustomValidity('');
+});
+otp.addEventListener('invalid', () => {
+  stopSmsListener();
+  showError(otp, otpError, 'Enter the full 6-digit code from your text message.');
+});
+phone.addEventListener('invalid', () => {
+  showError(phone, phoneError, 'Enter your mobile number, including the country code (for example, +1).');
+});
+intentInputs.forEach(input => input.addEventListener('change', resetChallenge));
+document.querySelectorAll('[data-intent]').forEach(link => link.addEventListener('click', () => {
+  if (busy) return;
+  if (intent() !== link.dataset.intent) {
+    intentInputs.find(input => input.value === link.dataset.intent).checked = true;
+    resetChallenge();
+  }
+  requestAnimationFrame(() => phone.focus({ preventScroll: true }));
+}));
+
+phoneForm.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy || Date.now() < cooldownUntil) return;
+  const number = normalizedPhone();
+  if (!/^\+[1-9][0-9]{7,14}$/.test(number)) {
+    showError(phone, phoneError, 'Include your country code, for example +1 555 123 4567.');
+    return;
+  }
+  resetChallenge();
+  const version = generation;
+  const purpose = intent();
+  busy = true;
+  updateButtons();
+  status.textContent = 'Sending your verification code…';
+  startSmsListener(version);
+  try {
+    const data = await post('/api/auth/sms/request', { phone: number, purpose });
+    if (typeof data.challengeId !== 'string' || !data.challengeId) throw new Error('Text verification is unavailable right now. Please try again later.');
+    challenge = { id: data.challengeId, phone: number, purpose };
+    cooldownUntil = Date.now() + 30000;
+    otpHint.textContent = `Enter the 6-digit code sent to the number ending in ${number.slice(-4)}.`;
+    status.textContent = 'Code sent. Check your texts. You can request another code in 30 seconds.';
+    otp.focus();
+  } catch (error) {
+    stopSmsListener();
+    automaticCode = false;
+    status.textContent = '';
+    showError(phone, phoneError, error.name === 'AbortError' ? 'The request timed out. Please try again.' : error instanceof TypeError ? 'Unable to connect. Check your connection and try again.' : error.message);
+  } finally {
+    busy = false;
+    updateButtons();
+  }
+  if (automaticCode && challenge) otpForm.requestSubmit();
+});
+
+otpForm.addEventListener('submit', async event => {
+  event.preventDefault();
+  stopSmsListener();
+  if (busy) return;
+  clearError(otp, otpError);
+  if (!challenge) {
+    showError(phone, phoneError, 'Request a code for your mobile number first.');
+    return;
+  }
+  if (!/^[0-9]{6}$/.test(otp.value)) {
+    showError(otp, otpError, 'Enter the full 6-digit code from your text message.');
+    return;
+  }
+  busy = true;
+  updateButtons();
+  status.textContent = 'Verifying your code…';
+  try {
+    const data = await post('/api/auth/sms/verify', {
+      challengeId: challenge.id, phone: challenge.phone, purpose: challenge.purpose, code: otp.value,
+    });
+    if (data.verified !== true) throw new Error('That code is invalid or expired. Try again or request a new code.');
+    status.textContent = 'You’re verified. Taking you to your next great cup…';
+    // Only a confirmed server response can advance the flow. Never accept a
+    // redirect supplied by the response or a code validated solely in the browser.
+    window.location.assign(challenge.purpose === 'order' ? '/order-online' : '/rewards');
+  } catch (error) {
+    status.textContent = '';
+    showError(otp, otpError, error.name === 'AbortError' ? 'The request timed out. Please try again.' : error instanceof TypeError ? 'Unable to connect. Check your connection and try again.' : error.message);
+  } finally {
+    busy = false;
+    updateButtons();
+  }
+});
+
+const cooldownTimer = setInterval(updateButtons, 1000);
+window.addEventListener('pagehide', () => {
+  generation += 1;
+  stopSmsListener();
+  requestController?.abort();
+  clearInterval(cooldownTimer);
+});
+window.addEventListener('pageshow', event => {
+  if (event.persisted) window.location.reload();
+});
