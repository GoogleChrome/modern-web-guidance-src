new file mode 100644
index 0000000..eb7d7c4
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,88 @@
+import type { APIRoute } from 'astro';
+import { getSecret } from 'astro:env/server';
+import {
+  createChallenge, matchesCode, normalizePhone, RESEND_DELAY_MS, sendVerificationSms,
+} from '../../utils/phone-verification';
+
+const json = (body: object, status = 200, headers: Record<string, string> = {}) =>
+  new Response(JSON.stringify(body), {
+    status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...headers },
+  });
+
+export const POST: APIRoute = async ({ request, session }) => {
+  // The site disables Astro's global origin check; enforce it for this mutation.
+  const expectedOrigin = getSecret('SIGNUP_ORIGIN') || new URL(request.url).origin;
+  if (request.headers.get('origin') !== expectedOrigin ||
+      !request.headers.get('content-type')?.startsWith('application/json')) {
+    return json({ error: 'Please submit the sign-up form from this website.' }, 403);
+  }
+  if (!session) return json({ error: 'Sign-up is temporarily unavailable.' }, 503);
+
+  let body;
+  try { body = await request.json(); } catch {
+    return json({ error: 'Invalid request.' }, 400);
+  }
+  if (!body || typeof body !== 'object') return json({ error: 'Invalid request.' }, 400);
+
+  if (body.action === 'send') {
+    const phone = typeof body.phone === 'string' ? normalizePhone(body.phone) : '';
+    if (!/^\+[1-9][0-9]{7,14}$/.test(phone)) {
+      return json({ error: 'Enter a phone number with its country code, such as +14155552671.' }, 400);
+    }
+    const now = Date.now();
+    const previous = await session.get('signupSmsLimit');
+    const limit = previous && previous.windowStart > now - 60 * 60 * 1000
+      ? previous : { windowStart: now, sentAt: 0, count: 0 };
+    const retryAfter = Math.ceil((limit.sentAt + RESEND_DELAY_MS - now) / 1000);
+    if (retryAfter > 0 || limit.count >= 5) {
+      const wait = retryAfter > 0 ? retryAfter : Math.ceil((limit.windowStart + 60 * 60 * 1000 - now) / 1000);
+      return json({ error: 'Too many code requests. Please wait before trying again.', retryAfter: wait }, 429,
+        { 'Retry-After': String(wait) });
+    }
+    // Count delivery attempts too, so provider failures cannot create an unbounded retry loop.
+    session.set('signupSmsLimit', { ...limit, sentAt: now, count: limit.count + 1 }, { ttl: 3600 });
+    session.delete('signupPhoneChallenge');
+    const { code, challenge } = createChallenge(phone);
+    try {
+      await sendVerificationSms(phone, code);
+      session.set('signupPhoneChallenge', challenge, { ttl: 300 });
+      return json({ phone, retryAfter: RESEND_DELAY_MS / 1000 });
+    } catch {
+      return json({ error: 'We could not send a code. Please try again in a minute.', retryAfter: 60 }, 503);
+    }
+  }
+
+  if (body.action !== 'register') return json({ error: 'Invalid request.' }, 400);
+  const { username, password, code } = body;
+  if (typeof username !== 'string' || !username.trim() || username.length > 100 ||
+      typeof password !== 'string' || password.length < 8 || password.length > 1024 || !/[0-9]/.test(password) ||
+      typeof code !== 'string' || !/^[0-9]{6}$/.test(code)) {
+    return json({ error: 'Enter your username, a password with at least 8 characters and a number, and a 6-digit code.' }, 400);
+  }
+  const challenge = await session.get('signupPhoneChallenge');
+  if (!challenge || challenge.expiresAt <= Date.now() || challenge.attempts >= 5) {
+    session.delete('signupPhoneChallenge');
+    return json({ error: 'This code has expired or has too many attempts. Request a new code.' }, 400);
+  }
+  challenge.attempts += 1;
+  session.set('signupPhoneChallenge', challenge, { ttl: Math.max(1, Math.ceil((challenge.expiresAt - Date.now()) / 1000)) });
+  if (!matchesCode(challenge, code)) {
+    return json({ error: 'That code is incorrect. Please check the SMS and try again.' }, 400);
+  }
+  // Consume the challenge before calling registration. Never accept a client-supplied verified flag.
+  session.delete('signupPhoneChallenge');
+  try {
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: username.trim(), password, phone: challenge.phone }),
+      signal: AbortSignal.timeout(15_000),
+    });
+    if (!response.ok) {
+      return json({ error: 'Registration failed. Check your account details and request a new code to try again.' }, 400);
+    }
+    return json({ success: true });
+  } catch {
+    return json({ error: 'Registration could not be completed. Request a new code before trying again.' }, 502);
+  }
+};
diff --git a/src/utils/phone-verification.ts b/src/utils/phone-verification.ts
new file mode 100644
index 0000000..8efc82a
--- /dev/null
+++ b/src/utils/phone-verification.ts
@@ -0,0 +1,70 @@
+import { createHash, randomBytes, randomInt, timingSafeEqual } from 'node:crypto';
+import { getSecret } from 'astro:env/server';
+
+export const CODE_LIFETIME_MS = 5 * 60 * 1000;
+export const RESEND_DELAY_MS = 60 * 1000;
+
+export interface PhoneChallenge {
+  phone: string;
+  salt: string;
+  digest: string;
+  expiresAt: number;
+  attempts: number;
+}
+
+export function normalizePhone(value: string) {
+  return value.replace(/[\s().-]/g, '');
+}
+
+export function hashCode(salt: string, code: string) {
+  return createHash('sha256').update(`${salt}:${code}`).digest('hex');
+}
+
+export function createChallenge(phone: string) {
+  const code = randomInt(0, 1_000_000).toString().padStart(6, '0');
+  const salt = randomBytes(32).toString('hex');
+  const challenge: PhoneChallenge = {
+    phone, salt, digest: hashCode(salt, code),
+    expiresAt: Date.now() + CODE_LIFETIME_MS, attempts: 0,
+  };
+  return { code, challenge };
+}
+
+export function matchesCode(challenge: PhoneChallenge, code: string) {
+  return timingSafeEqual(
+    Buffer.from(challenge.digest, 'hex'),
+    Buffer.from(hashCode(challenge.salt, code), 'hex'),
+  );
+}
+
+export async function sendVerificationSms(phone: string, code: string) {
+  const account = getSecret('TWILIO_ACCOUNT_SID');
+  const token = getSecret('TWILIO_AUTH_TOKEN');
+  const service = getSecret('TWILIO_MESSAGING_SERVICE_SID');
+  // Explicit configuration prevents a client-controlled Host header from changing SMS binding.
+  const origin = getSecret('SIGNUP_ORIGIN');
+  if (!account || !token || !service || !origin) {
+    throw new Error('SMS verification is not configured.');
+  }
+  const host = new URL(origin).hostname;
+  const response = await fetch(
+    `https://api.twilio.com/2010-04-01/Accounts/${encodeURIComponent(account)}/Messages.json`,
+    {
+      method: 'POST',
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${account}:${token}`).toString('base64')}`,
+        'Content-Type': 'application/x-www-form-urlencoded',
+      },
+      body: new URLSearchParams({
+        To: phone,
+        MessagingServiceSid: service,
+        Body: `Your DevTools Times verification code is ${code}. It expires in 5 minutes.\n\n@${host} #${code}`,
+      }),
+      signal: AbortSignal.timeout(15_000),
+    },
+  );
+  const data = await response.json();
+  if (!response.ok || !data.sid || ['failed', 'undelivered'].includes(data.status)) {
+    throw new Error('SMS delivery failed.');
+  }
+}
