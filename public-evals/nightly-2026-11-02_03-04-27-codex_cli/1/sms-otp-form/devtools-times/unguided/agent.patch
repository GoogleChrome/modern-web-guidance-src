index 0000000..843a7a6
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,114 @@
+import type { APIRoute } from 'astro';
+
+type Challenge = {
+  phone: string;
+  sid: string;
+  sentAt: number;
+  expiresAt: number;
+  attempts: number;
+  verified: boolean;
+};
+
+const reply = (body: object, status = 200) => Response.json(body, {
+  status,
+  headers: { 'Cache-Control': 'no-store' },
+});
+
+// Credentials stay on the server; Verify handles code generation, delivery and expiry.
+async function verifyRequest(resource: string, parameters: Record<string, string>) {
+  const { TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_VERIFY_SERVICE_SID } = process.env;
+  if (!TWILIO_ACCOUNT_SID || !TWILIO_AUTH_TOKEN || !TWILIO_VERIFY_SERVICE_SID) {
+    throw new Error('SMS_NOT_CONFIGURED');
+  }
+  return fetch(`https://verify.twilio.com/v2/Services/${encodeURIComponent(TWILIO_VERIFY_SERVICE_SID)}/${resource}`, {
+    method: 'POST',
+    headers: {
+      Authorization: `Basic ${Buffer.from(`${TWILIO_ACCOUNT_SID}:${TWILIO_AUTH_TOKEN}`).toString('base64')}`,
+      'Content-Type': 'application/x-www-form-urlencoded',
+    },
+    body: new URLSearchParams(parameters),
+    signal: AbortSignal.timeout(15_000),
+  });
+}
+
+export const POST: APIRoute = async ({ request, session }) => {
+  // The app disables Astro's origin check globally; enforce it for this mutation.
+  if (request.headers.get('Origin') !== new URL(request.url).origin) {
+    return reply({ error: 'Please submit the form from this website.' }, 403);
+  }
+  if (!session) return reply({ error: 'Sign-up is temporarily unavailable.' }, 503);
+
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return reply({ error: 'Invalid request.' }, 400);
+  }
+  if (!body || typeof body !== 'object') return reply({ error: 'Invalid request.' }, 400);
+  const { action, phone, username, password, code } = body;
+  if (typeof phone !== 'string' || !/^\+[1-9]\d{6,14}$/.test(phone)) {
+    return reply({ error: 'Enter a valid phone number with its country code, starting with +.' }, 400);
+  }
+  if (action !== 'send' && action !== 'register') return reply({ error: 'Invalid request.' }, 400);
+
+  const challenge = await session.get('signupChallenge') as Challenge | undefined;
+  const now = Date.now();
+  try {
+    if (action === 'send') {
+      if (challenge && now - challenge.sentAt < 30_000) {
+        return reply({ error: 'Please wait 30 seconds before requesting another code.' }, 429);
+      }
+      const response = await verifyRequest('Verifications', { To: phone, Channel: 'sms' });
+      if (!response.ok) {
+        return reply({ error: response.status === 429 ? 'Too many SMS requests. Please try again later.' : 'Unable to send a code. Check your number and try again.' }, response.status === 429 ? 429 : 502);
+      }
+      const data = await response.json();
+      if (data.status !== 'pending' || typeof data.sid !== 'string') {
+        return reply({ error: 'Unable to send a code. Please try again.' }, 502);
+      }
+      await session.set('signupChallenge', {
+        phone, sid: data.sid, sentAt: now, expiresAt: now + 600_000, attempts: 0, verified: false,
+      } satisfies Challenge);
+      return reply({ sent: true });
+    }
+
+    if (typeof username !== 'string' || !username.trim() || typeof password !== 'string' || password.length < 8 || !/\d/.test(password)) {
+      return reply({ error: 'Enter a username and a password with at least 8 characters and a number.' }, 400);
+    }
+    if (typeof code !== 'string' || !/^\d{6}$/.test(code)) {
+      return reply({ error: 'Enter the 6-digit code from your SMS.' }, 400);
+    }
+    if (!challenge || challenge.phone !== phone || challenge.expiresAt <= now) {
+      return reply({ error: 'Your code has expired. Request another code to continue.' }, 400);
+    }
+    if (!challenge.verified) {
+      if (challenge.attempts >= 5) return reply({ error: 'Too many attempts. Request another code.' }, 429);
+      challenge.attempts += 1;
+      await session.set('signupChallenge', challenge);
+      const response = await verifyRequest('VerificationCheck', { VerificationSid: challenge.sid, Code: code });
+      if (response.status === 404) return reply({ error: 'Your code has expired or was already used. Request another code.' }, 400);
+      if (!response.ok) return reply({ error: 'Unable to verify the code. Try again or request another code.' }, response.status === 429 ? 429 : 502);
+      const data = await response.json();
+      if (data.status !== 'approved') return reply({ error: 'That code is incorrect. Please try again.' }, 400);
+      // Preserve approval for a retry if the registration service is unavailable.
+      challenge.verified = true;
+      await session.set('signupChallenge', challenge);
+    }
+
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password, phone }),
+      signal: AbortSignal.timeout(15_000),
+    });
+    if (!response.ok) {
+      return reply({ error: 'Your phone is verified, but registration failed. Try again, or go back to change your account details.' }, response.status >= 500 ? 502 : 400);
+    }
+    await session.delete('signupChallenge');
+    return reply({ registered: true });
+  } catch (error) {
+    return reply({ error: error instanceof Error && error.message === 'SMS_NOT_CONFIGURED'
+      ? 'SMS verification is not configured yet. Please try again later.'
+      : 'The verification service is unavailable. Please try again.' }, 503);
+  }
+};
