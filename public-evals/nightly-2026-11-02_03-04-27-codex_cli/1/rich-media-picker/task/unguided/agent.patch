+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = picker.querySelector('.roast-trigger');
+    const list = picker.querySelector('[role="listbox"]');
+    const options = [...list.querySelectorAll('[role="option"]')];
+    let selected = 0;
+
+    function closePicker(restoreFocus = false) {
+      list.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) trigger.focus();
+    }
+
+    function openPicker(index = selected) {
+      list.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options[index].focus();
+    }
+
+    function selectRoast(index) {
+      selected = index;
+      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
+      trigger.querySelector('.roast-icon').replaceWith(options[index].querySelector('svg').cloneNode(true));
+      document.getElementById('roast-value').innerHTML = options[index].querySelector('.roast-copy').innerHTML;
+      document.getElementById('order-button').href = '/order-online?roast=' + options[index].dataset.value;
+      closePicker(true);
+    }
+
+    trigger.addEventListener('click', () => list.hidden ? openPicker() : closePicker());
+    trigger.addEventListener('keydown', event => {
+      if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+        event.preventDefault();
+        openPicker(event.key === 'Home' ? 0 : event.key === 'End' ? options.length - 1 : selected);
+      }
+    });
+
+    options.forEach((option, index) => {
+      option.addEventListener('click', () => selectRoast(index));
+      option.addEventListener('keydown', event => {
+        let next;
+        if (event.key === 'ArrowDown') next = (index + 1) % options.length;
+        if (event.key === 'ArrowUp') next = (index - 1 + options.length) % options.length;
+        if (event.key === 'Home') next = 0;
+        if (event.key === 'End') next = options.length - 1;
+        if (next !== undefined) { event.preventDefault(); options[next].focus(); }
+        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); selectRoast(index); }
+        if (event.key === 'Escape') { event.preventDefault(); closePicker(true); }
+        if (event.key.length === 1 && event.key !== ' ') {
+          const match = options.find(item => item.textContent.trim().toLowerCase().startsWith(event.key.toLowerCase()));
+          if (match) match.focus();
+        }
+      });
+    });
+    document.addEventListener('click', event => { if (!picker.contains(event.target)) closePicker(); });
+    picker.addEventListener('focusout', event => { if (!picker.contains(event.relatedTarget)) closePicker(); });
+  </script>
