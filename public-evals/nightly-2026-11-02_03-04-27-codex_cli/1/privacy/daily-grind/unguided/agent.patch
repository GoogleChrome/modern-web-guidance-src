+++ b/scripts/audit-privacy.mjs
@@ -0,0 +1,62 @@
+import assert from 'node:assert/strict';
+import { readFile, readdir, stat } from 'node:fs/promises';
+
+// Static source audit, not a browser or a proof of production header enforcement.
+const root = new URL('../', import.meta.url);
+const read = (file) => readFile(new URL(file, root), 'utf8');
+const htmlFiles = (await readdir(root)).filter((file) => file.endsWith('.html'));
+assert(htmlFiles.includes('index.html') && htmlFiles.includes('privacy-policy.html'));
+const headers = await read('_headers');
+const header = (name) => {
+  const match = headers.match(new RegExp(`^  ${name}: (.+)$`, 'm'));
+  assert(match, `Missing response header: ${name}`);
+  return match[1];
+};
+assert(headers.startsWith('/*\n'), 'Headers must cover all paths');
+const csp = header('Content-Security-Policy');
+for (const directive of ["default-src 'none'", "script-src 'none'", "style-src 'self'", "img-src 'self'", "connect-src 'none'", "object-src 'none'", "base-uri 'none'", "form-action 'none'", "worker-src 'none'", "frame-ancestors 'none'", 'upgrade-insecure-requests']) {
+  assert(csp.split(';').map((value) => value.trim()).includes(directive), `Missing CSP directive: ${directive}`);
+}
+assert(!/unsafe-|https?:|\*/.test(csp), 'CSP must not permit broad external sources or unsafe execution');
+assert.equal(header('Referrer-Policy'), 'no-referrer');
+assert.equal(header('X-Content-Type-Options'), 'nosniff');
+assert.equal(header('X-Frame-Options'), 'DENY');
+assert.equal(header('Cache-Control'), 'no-store');
+assert.equal(header('Cross-Origin-Opener-Policy'), 'same-origin');
+assert.equal(header('Cross-Origin-Resource-Policy'), 'same-origin');
+assert.equal(header('Strict-Transport-Security'), 'max-age=31536000');
+for (const feature of ['camera', 'microphone', 'geolocation', 'payment', 'usb', 'browsing-topics']) {
+  assert(header('Permissions-Policy').split(', ').includes(`${feature}=()`), `Missing permission restriction: ${feature}`);
+}
+for (const file of htmlFiles) {
+  const html = await read(file);
+  assert(!/<(?:script|iframe|object|embed|form|input|textarea|select|style|video|audio)\b/i.test(html), `${file}: active content or data collection requires review`);
+  assert(!/\s(?:on[\w-]+|style|srcdoc|ping|action)\s*=/i.test(html), `${file}: inline behavior or submission requires review`);
+  assert(!/<link\b[^>]*\brel\s*=\s*["'](?:preconnect|dns-prefetch|prefetch|prerender)/i.test(html), `${file}: speculative network requests require review`);
+  assert(html.includes('<meta name="referrer" content="no-referrer">'), `${file}: missing referrer fallback`);
+  const metaCsp = html.match(/<meta http-equiv="Content-Security-Policy" content="([^"]+)">/)?.[1];
+  assert.equal(metaCsp, csp.split('; frame-ancestors')[0], `${file}: CSP fallback differs from response policy`);
+  for (const [, attribute, url] of html.matchAll(/\b(src|href|srcset|poster|data)\s*=\s*["']([^"']*)["']/gi)) {
+    assert(/^\/(?!\/)[^\\]*$/.test(url), `${file}: external or nonlocal ${attribute}: ${url}`);
+    assert(!/[?]/.test(url), `${file}: URL parameters require data-minimization review`);
+    if (url.startsWith('/assets/')) {
+      assert((await stat(new URL(`.${url}`, root))).isFile(), `${file}: missing asset`);
+    }
+  }
+}
+const assets = await readdir(new URL('assets/', root));
+for (const file of assets) {
+  assert(/\.(?:css|jpg|png|webp|ico)$/.test(file), `Unreviewed asset type: ${file}`);
+  if (!file.endsWith('.css')) continue;
+  const css = await read(`assets/${file}`);
+  assert(!/@import|https?:|\/\/|expression\s*\(/i.test(css), `${file}: third-party or executable CSS requires review`);
+  for (const [, url] of css.matchAll(/url\(\s*['"]?([^'"\s)]+)['"]?\s*\)/gi)) {
+    assert(/^\.\/[\w.-]+$/.test(url), `${file}: unexpected resource URL`);
+    assert((await stat(new URL(`assets/${url}`, root))).isFile(), `${file}: missing resource`);
+  }
+}
+const pkg = JSON.parse(await read('package.json'));
+for (const field of ['dependencies', 'devDependencies', 'optionalDependencies', 'peerDependencies']) {
+  assert.equal(Object.keys(pkg[field] ?? {}).length, 0, `${field}: dependencies require a third-party audit`);
+}
+console.log(`Privacy audit passed: ${htmlFiles.length} HTML pages, ${assets.length} local assets, no client scripts or package dependencies; security policies present.`);
