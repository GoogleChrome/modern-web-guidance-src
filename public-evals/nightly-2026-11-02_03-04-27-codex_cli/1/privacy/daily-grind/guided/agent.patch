+++ b/scripts/build.mjs
@@ -0,0 +1,10 @@
+// Publish only public assets; never expose source tooling or audit documentation.
+import { cp, mkdir, rm } from 'node:fs/promises';
+const root = new URL('../', import.meta.url);
+const output = new URL('dist/', root);
+await rm(output, { recursive: true, force: true });
+await mkdir(output, { recursive: true });
+for (const path of ['index.html', 'privacy-policy', 'assets', '_headers']) {
+  await cp(new URL(path, root), new URL(path, output), { recursive: true });
+}
+console.log('Static site built in dist/');
diff --git a/scripts/check-privacy.mjs b/scripts/check-privacy.mjs
new file mode 100644
index 0000000..fcb9f3a
--- /dev/null
+++ b/scripts/check-privacy.mjs
@@ -0,0 +1,57 @@
+// Static regression checks only: no browser, network, or server entrypoints.
+import assert from 'node:assert/strict';
+import { readFile, readdir, stat } from 'node:fs/promises';
+import { resolve, extname } from 'node:path';
+
+const root = resolve(import.meta.dirname, '..');
+const read = (path) => readFile(resolve(root, path), 'utf8');
+const vercel = JSON.parse(await read('vercel.json'));
+const headers = Object.fromEntries(vercel.headers[0].headers.map(({ key, value }) => [key, value]));
+const expectedHeaders = '/*\n' + Object.entries(headers).map(([key, value]) => `  ${key}: ${value}\n`).join('');
+assert.equal(await read('_headers'), expectedHeaders, 'Deployment header configurations must agree');
+const csp = headers['Content-Security-Policy'];
+for (const rule of ["default-src 'none'", "script-src 'none'", "connect-src 'none'", "style-src 'self'", "img-src 'self'", "form-action 'none'", "base-uri 'none'", "frame-ancestors 'none'", "require-trusted-types-for 'script'"]) {
+  assert(csp.split('; ').includes(rule), `Missing CSP rule: ${rule}`);
+}
+assert(!/unsafe-inline|unsafe-eval|https:|\*/.test(csp), 'CSP must not allow broad sources or inline execution');
+assert.equal(headers['Referrer-Policy'], 'no-referrer');
+assert.equal(headers['X-Content-Type-Options'], 'nosniff');
+assert.equal(headers['X-Frame-Options'], 'DENY');
+for (const feature of ['camera', 'microphone', 'geolocation', 'payment', 'browsing-topics']) {
+  assert(headers['Permissions-Policy'].split(', ').includes(`${feature}=()`), `Disable unused ${feature}`);
+}
+
+async function checkAsset(url) {
+  assert(url.startsWith('/') && !url.startsWith('//'), `Only same-origin asset paths allowed: ${url}`);
+  assert(!/[?#]/.test(url), 'Assets must not contain query identifiers');
+  const path = resolve(root, '.' + url);
+  assert(path.startsWith(root + '/'), 'Asset must stay within the site');
+  assert((await stat(path)).isFile(), `Missing local asset: ${url}`);
+}
+
+async function checkMarkup(path) {
+  const html = await read(path);
+  assert(!/<\s*(script|iframe|object|embed|form|input|textarea|select|base|style)\b/i.test(html), `${path}: unexpected executable, embedded, inline-style, or collecting markup`);
+  for (const tag of html.matchAll(/<[a-z][^>]*>/gi)) {
+    assert(!/\s(?:on[a-z]+|style|ping|srcdoc)\s*=/i.test(tag[0]), `${path}: unsafe inline attribute`);
+    assert(!/javascript:|data:|https?:\/\/|\/\//i.test(tag[0]), `${path}: unexpected remote resource or active URL`);
+    for (const attr of tag[0].matchAll(/\b(?:src|href)="([^"]+)"/g)) {
+      if (/\bsrc=/.test(attr[0]) || /^<link\b/i.test(tag[0])) await checkAsset(attr[1]);
+    }
+  }
+  const meta = /<meta http-equiv="Content-Security-Policy" content="([^"]+)">/.exec(html);
+  assert.equal(meta?.[1], csp.replace("; frame-ancestors 'none'", ''), `${path}: fallback CSP differs from HTTP policy`);
+  assert(html.includes('<meta name="referrer" content="no-referrer">'));
+  assert(html.indexOf('http-equiv="Content-Security-Policy"') < html.indexOf('<link'), 'Fallback policy must precede resources');
+}
+await checkMarkup('index.html');
+await checkMarkup('privacy-policy/index.html');
+assert((await read('index.html')).includes('href="/privacy-policy/"'), 'Privacy notice must be discoverable');
+const css = await read('assets/styles.css');
+assert(!/@import|https?:|\/\/|data:/i.test(css), 'Styles must not contact third parties');
+for (const match of css.matchAll(/url\(['"]?([^'"\)]+)['"]?\)/g)) await checkAsset(match[1]);
+const assets = await readdir(resolve(root, 'assets'));
+assert(assets.every((name) => ['.css', '.jpg'].includes(extname(name))), 'Review new asset types for tracking or script execution');
+const pkg = JSON.parse(await read('package.json'));
+assert.equal(Object.keys(pkg.dependencies ?? {}).length, 0, 'Audit new runtime dependencies before accepting them');
+console.log('Privacy checks passed: local assets, no collection or scripts, strict CSP, and matching deployment headers.');
