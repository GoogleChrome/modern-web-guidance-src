@@ -0,0 +1,24 @@
+// The server supplies the light DOM and blocking head CSS. Upgrade only adds
+// behavior: keep every existing node in place so content never needs re-rendering.
+class DrinkCard extends HTMLElement {
+  #button;
+
+  #toggleFavorite = (event) => {
+    const button = event.currentTarget;
+    button.setAttribute('aria-pressed', String(button.getAttribute('aria-pressed') !== 'true'));
+  };
+
+  connectedCallback() {
+    this.#button = this.querySelector('.favorite-toggle');
+    if (!this.#button) return;
+
+    this.#button.addEventListener('click', this.#toggleFavorite);
+    this.#button.disabled = false;
+  }
+
+  disconnectedCallback() {
+    this.#button?.removeEventListener('click', this.#toggleFavorite);
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
