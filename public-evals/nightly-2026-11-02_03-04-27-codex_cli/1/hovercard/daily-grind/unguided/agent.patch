+  <script>
+    const previews = document.querySelectorAll('.drink-preview');
+
+    previews.forEach((preview) => {
+      const trigger = preview.querySelector('.btn');
+      const card = preview.querySelector('.hovercard');
+      let closeTimer;
+
+      function close() {
+        clearTimeout(closeTimer);
+        card.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+      }
+
+      function open() {
+        clearTimeout(closeTimer);
+        card.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+      }
+
+      preview.addEventListener('mouseenter', open);
+      preview.addEventListener('mouseleave', () => {
+        closeTimer = setTimeout(() => {
+          if (!preview.contains(document.activeElement)) close();
+        }, 150);
+      });
+      preview.addEventListener('focusin', open);
+      preview.addEventListener('focusout', (event) => {
+        if (!preview.contains(event.relatedTarget)) close();
+      });
+      preview.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && !card.hidden) {
+          if (card.contains(document.activeElement)) trigger.focus();
+          close();
+          event.preventDefault();
+          event.stopPropagation();
+        }
+      });
+    });
+  </script>
