+  <script type="module">
+    // Only load compatibility code when the browser needs it. Links continue
+    // to navigate normally if a polyfill cannot be downloaded.
+    async function initializeDrinkPreviews() {
+      if (!("popover" in HTMLElement.prototype)) {
+        await import("https://unpkg.com/@oddbird/popover-polyfill@0.6.1/dist/popover.min.js");
+      }
+
+      const previews = document.querySelectorAll(".drink-preview");
+      for (const preview of previews) {
+        // Older Popover implementations treat the hint value as manual.
+        if (preview.popover !== "hint") preview.popover = "auto";
+      }
+
+      if (!CSS.supports("position-area", "block-end span-inline-end")) {
+        // Keep the preview beside its link and inside the viewport when CSS
+        // anchor positioning is unavailable, including after scroll/resize.
+        const positionPreview = (preview) => {
+          if (!preview.matches(":is(:popover-open, .\\:popover-open)")) return;
+          const trigger = document.querySelector(`[interestfor="${preview.id}"]`);
+          const bounds = trigger.getBoundingClientRect();
+          const width = preview.offsetWidth;
+          const height = preview.offsetHeight;
+          const viewportHeight = document.documentElement.clientHeight;
+          const viewportWidth = document.documentElement.clientWidth;
+          const below = bounds.bottom + 10;
+          const top = below + height <= viewportHeight - 12
+            ? below : bounds.top - height - 10;
+          preview.style.top = `${Math.max(12, Math.min(top, viewportHeight - height - 12))}px`;
+          preview.style.left = `${Math.max(12, Math.min(bounds.left, viewportWidth - width - 12))}px`;
+        };
+        previews.forEach((preview) => {
+          preview.addEventListener("toggle", () => positionPreview(preview));
+        });
+        const reposition = () => previews.forEach(positionPreview);
+        window.addEventListener("resize", reposition);
+        window.addEventListener("scroll", reposition, { capture: true, passive: true });
+      }
+
+      if (!Object.hasOwn(HTMLButtonElement.prototype, "interestForElement")) {
+        await import("https://unpkg.com/interestfor@1.0.12/src/interestfor.min.js");
+      }
+    }
+
+    initializeDrinkPreviews().catch((error) => {
+      console.warn("Drink previews unavailable; menu links remain available.", error);
+    });
+  </script>
