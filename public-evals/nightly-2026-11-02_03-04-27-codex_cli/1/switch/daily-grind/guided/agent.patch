+  <script>
+    const descriptionSwitch = document.getElementById('show-descriptions');
+    const descriptionSetting = document.getElementById('description-setting');
+    const descriptions = descriptionSwitch.getAttribute('aria-controls')
+      .split(' ').map(id => document.getElementById(id));
+
+    // Retain native checkbox keyboard/state behavior where HTML switch is unsupported.
+    if (!('switch' in HTMLInputElement.prototype)) {
+      descriptionSwitch.setAttribute('role', 'switch');
+    }
+
+    function updateDescriptions() {
+      descriptions.forEach(description => {
+        description.hidden = !descriptionSwitch.checked;
+      });
+      descriptionSetting.querySelector('.switch-state').textContent =
+        descriptionSwitch.checked ? 'On' : 'Off';
+    }
+
+    descriptionSwitch.addEventListener('change', updateDescriptions);
+    window.addEventListener('pageshow', updateDescriptions);
+    updateDescriptions();
+    descriptionSetting.hidden = false;
+  </script>
