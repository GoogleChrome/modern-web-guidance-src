+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterError = document.getElementById('newsletter-email-error');
+    const newsletterAnnouncement = document.getElementById('newsletter-announcement');
+    const newsletterStatus = document.getElementById('newsletter-status');
+
+    const syncEmailError = () => {
+      // Use the same post-interaction state that reveals the visual error in CSS.
+      const showError = newsletterEmail.matches(':user-invalid');
+      if (showError) {
+        newsletterEmail.setAttribute('aria-invalid', 'true');
+        newsletterEmail.setAttribute('aria-describedby', newsletterError.id);
+      } else {
+        newsletterEmail.removeAttribute('aria-invalid');
+        newsletterEmail.removeAttribute('aria-describedby');
+      }
+
+      const announcement = showError ? newsletterError.textContent : '';
+      // Avoid repeating the error on every keystroke while it remains visible.
+      if (newsletterAnnouncement.textContent !== announcement) {
+        newsletterAnnouncement.textContent = announcement;
+      }
+    };
+
+    for (const eventName of ['input', 'change', 'blur', 'focus', 'invalid']) {
+      newsletterEmail.addEventListener(eventName, () => {
+        syncEmailError();
+        // Native validation can update :user-invalid after the event dispatch.
+        requestAnimationFrame(syncEmailError);
+      });
+    }
+
+    newsletterEmail.addEventListener('input', () => {
+      newsletterStatus.textContent = '';
+    });
+
+    newsletterForm.addEventListener('reset', () => {
+      newsletterEmail.removeAttribute('aria-invalid');
+      newsletterEmail.removeAttribute('aria-describedby');
+      newsletterAnnouncement.textContent = '';
+      newsletterStatus.textContent = '';
+      requestAnimationFrame(syncEmailError);
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      syncEmailError();
+      // Connect a newsletter service here before accepting subscriptions.
+      newsletterStatus.textContent = 'Newsletter signup is not available yet. Please check back soon.';
+    });
+  </script>
+
 </body>
 
