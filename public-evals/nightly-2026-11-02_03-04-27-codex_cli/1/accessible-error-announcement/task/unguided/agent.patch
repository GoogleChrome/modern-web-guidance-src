@@ -206,7 +277,57 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterError = document.getElementById('newsletter-error');
+    const newsletterStatus = document.getElementById('newsletter-status');
+    let emailInteracted = false;
+
+    function updateNewsletterError() {
+      const showError = emailInteracted && !newsletterEmail.validity.valid;
+      const message = showError
+        ? (newsletterEmail.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address.')
+        : '';
+
+      // Keep the visible error and live announcement in the same DOM node.
+      if (newsletterError.textContent !== message) {
+        newsletterError.textContent = message;
+      }
+      newsletterEmail.setAttribute('aria-invalid', String(showError));
+      if (showError) {
+        newsletterEmail.setAttribute('aria-describedby', 'newsletter-error');
+      } else {
+        newsletterEmail.removeAttribute('aria-describedby');
+      }
+      return !showError;
+    }
+
+    newsletterEmail.addEventListener('blur', () => {
+      emailInteracted = true;
+      updateNewsletterError();
+    });
+
+    newsletterEmail.addEventListener('input', () => {
+      newsletterStatus.textContent = '';
+      updateNewsletterError();
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      emailInteracted = true;
+      newsletterStatus.textContent = '';
+      if (!updateNewsletterError()) {
+        newsletterEmail.focus();
+        return;
+      }
+      newsletterStatus.textContent = 'Thanks for your interest in The Daily Grind newsletter.';
+    });
+  </script>
+
 </body>
 
