+    .sr-only {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    .customizations {
+      border: 0;
+      min-width: 0;
+      margin-top: 22px;
+      text-align: left;
+    }
+
+    .customizations legend {
+      padding: 0;
+      margin-bottom: 8px;
+      font-size: 0.8rem;
+      font-weight: 700;
+      letter-spacing: 0.06em;
+      text-transform: uppercase;
+      color: var(--primary);
+    }
+
+    .customization {
+      position: relative;
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      min-height: 48px;
+      margin-top: 8px;
+      padding: 10px 12px;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: #fcf9f6;
+      cursor: pointer;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .customization:hover {
+      border-color: var(--primary);
+    }
+
+    .customization:has(input:checked) {
+      background: #fff1dc;
+      border-color: #99601d;
+    }
+
+    .customization input {
+      appearance: none;
+      -webkit-appearance: none;
+      flex: 0 0 22px;
+      width: 22px;
+      height: 22px;
+      margin: 0;
+      border: 2px solid #80645a;
+      border-radius: 6px;
+      background: white;
+      cursor: pointer;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .customization input:checked {
+      background: var(--primary);
+      border-color: var(--primary);
+    }
+
+    .customization input:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    .checkbox-check {
+      position: absolute;
+      left: 16px;
+      top: 50%;
+      width: 16px;
+      height: 16px;
+      color: var(--accent);
+      pointer-events: none;
+      opacity: 0;
+      transform: translateY(-50%) scale(0.65);
+      transition: opacity 180ms ease, transform 180ms ease;
+    }
+
+    .checkbox-check path {
+      stroke-dasharray: 18;
+      stroke-dashoffset: 18;
+      transition: stroke-dashoffset 180ms ease;
+    }
+
+    .customization input:checked + .checkbox-check {
+      opacity: 1;
+      transform: translateY(-50%) scale(1);
+    }
+
+    .customization input:checked + .checkbox-check path {
+      stroke-dashoffset: 0;
+    }
+
+    .customization-text {
+      flex: 1;
+      font-size: 0.9rem;
+      font-weight: 600;
+    }
+
+    .option-icon {
+      flex: 0 0 20px;
+      width: 20px;
+      height: 20px;
+      color: #80645a;
+      pointer-events: none;
+    }
+
+    .customization:has(input:checked) .option-icon {
+      color: var(--primary);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .customization,
+      .customization input,
+      .checkbox-check,
+      .checkbox-check path {
+        transition: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .customization input {
+        appearance: auto;
+        -webkit-appearance: auto;
+      }
+
+      .checkbox-check {
+        display: none;
+      }
+
+      .customization input:focus-visible {
+        outline-color: Highlight;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
