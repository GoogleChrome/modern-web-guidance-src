+  <button type="button" class="btn feedback-launcher" id="feedback-open"
+    aria-haspopup="dialog" aria-controls="feedback-dialog">Share feedback</button>
+
+  <!-- Both hosts stay connected so moveBefore can preserve top-layer state. -->
+  <div id="feedback-right">
+    <dialog id="feedback-dialog" class="feedback-dialog" aria-labelledby="feedback-title"
+      aria-describedby="feedback-description">
+      <form method="dialog">
+        <div class="feedback-heading">
+          <div>
+            <p class="feedback-eyebrow">A little feedback. A better daily grind.</p>
+            <h2 id="feedback-title">How was your visit?</h2>
+          </div>
+          <button type="submit" class="feedback-close" aria-label="Close feedback" value="close">&times;</button>
+        </div>
+        <p id="feedback-description" class="feedback-description">Good coffee starts with listening. Leave a thought about your experience.</p>
+        <label for="feedback-message">Your feedback</label>
+        <textarea id="feedback-message" name="feedback" placeholder="What made your day? What could be better?" autofocus></textarea>
+        <p class="feedback-note">Your draft stays here when you move or close this window. It isn’t sent anywhere.</p>
+        <p id="feedback-status" class="feedback-status" role="status">On the right. Make yourself at home.</p>
+        <div class="feedback-actions">
+          <button type="button" id="feedback-move" class="feedback-move">Move to the left &larr;</button>
+          <button type="submit" class="btn" value="done">Keep browsing</button>
+        </div>
+      </form>
+    </dialog>
+  </div>
+  <div id="feedback-left"></div>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackOpen = document.getElementById('feedback-open');
+    const feedbackMove = document.getElementById('feedback-move');
+    const feedbackMessage = document.getElementById('feedback-message');
+    const feedbackStatus = document.getElementById('feedback-status');
+    let usedMoveFallback = false;
+
+    feedbackOpen.addEventListener('click', () => {
+      if (!feedbackDialog.open) feedbackDialog.showModal();
+    });
+
+    feedbackMove.addEventListener('click', () => {
+      const moveLeft = feedbackDialog.parentElement.id === 'feedback-right';
+      const destination = document.getElementById(moveLeft ? 'feedback-left' : 'feedback-right');
+
+      if (typeof destination.moveBefore === 'function') {
+        // Atomic reparenting retains modality, top-layer membership and focus.
+        destination.moveBefore(feedbackDialog, null);
+      } else {
+        const wasOpen = feedbackDialog.open;
+        const wasModal = feedbackDialog.matches(':modal');
+        const focusedElement = document.activeElement;
+        const returnValue = feedbackDialog.returnValue;
+        const selection = [feedbackMessage.selectionStart, feedbackMessage.selectionEnd,
+          feedbackMessage.selectionDirection];
+        const scrollPositions = [feedbackDialog, feedbackMessage].map(element =>
+          [element, element.scrollTop, element.scrollLeft]);
+
+        // Explicitly close first: a traditional move can leave a stale open
+        // attribute while removing modality. Reopen through the native API.
+        if (wasOpen) feedbackDialog.close();
+        destination.insertBefore(feedbackDialog, null);
+        if (wasOpen) {
+          if (wasModal) feedbackDialog.showModal();
+          else feedbackDialog.show();
+        }
+        feedbackDialog.returnValue = returnValue;
+        if (wasOpen && feedbackDialog.contains(focusedElement)) {
+          focusedElement.focus({ preventScroll: true });
+        }
+        feedbackMessage.setSelectionRange(...selection);
+        scrollPositions.forEach(([element, top, left]) => {
+          element.scrollTop = top;
+          element.scrollLeft = left;
+        });
+        usedMoveFallback = true;
+      }
+
+      feedbackMove.textContent = moveLeft ? 'Move to the right →' : 'Move to the left ←';
+      feedbackStatus.textContent = `Moved to the ${moveLeft ? 'left' : 'right'}. Your draft is still here.`;
+    });
+
+    feedbackDialog.addEventListener('close', () => {
+      // Ignore the queued close event from a fallback move that already reopened.
+      if (feedbackDialog.open) return;
+      feedbackDialog.returnValue = '';
+      // Reopening during fallback replaces the browser's remembered invoker.
+      if (usedMoveFallback) {
+        feedbackOpen.focus();
+        usedMoveFallback = false;
+      }
+    });
+  </script>
+
