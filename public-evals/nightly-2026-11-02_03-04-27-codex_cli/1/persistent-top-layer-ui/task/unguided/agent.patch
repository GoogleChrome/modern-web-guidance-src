+  <script>
+    const dialog = document.querySelector('#feedback-dialog');
+    const launcher = document.querySelector('#open-feedback');
+    const moveButton = document.querySelector('#move-feedback');
+    const form = document.querySelector('#feedback-form');
+    const message = document.querySelector('#feedback-message');
+    const status = document.querySelector('#feedback-status');
+    const storageKey = 'daily-grind-feedback';
+
+    function updateCount() {
+      document.querySelector('#feedback-count').textContent = `${message.value.length} / 1000`;
+    }
+
+    // Storage can be unavailable in private or restricted contexts.
+    try {
+      const draft = JSON.parse(localStorage.getItem(storageKey));
+      if (draft && typeof draft.message === 'string') message.value = draft.message.slice(0, 1000);
+      if (draft && /^[1-5]$/.test(draft.rating)) form.elements.rating.value = draft.rating;
+    } catch { /* The form remains usable without storage. */ }
+    updateCount();
+
+    function saveDraft() {
+      try {
+        localStorage.setItem(storageKey, JSON.stringify({ message: message.value, rating: form.elements.rating.value }));
+        document.querySelector('#draft-status').textContent = 'Draft saved on this device';
+        return true;
+      } catch {
+        document.querySelector('#draft-status').textContent = 'Draft kept while this page is open';
+        return false;
+      }
+    }
+
+    form.addEventListener('input', () => {
+      updateCount();
+      status.textContent = '';
+      saveDraft();
+    });
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      status.textContent = saveDraft()
+        ? 'Thank you! Your feedback is saved on this device.'
+        : 'Your feedback is kept here for this session. Device storage is unavailable.';
+    });
+
+    launcher.addEventListener('click', () => { if (!dialog.open) dialog.showModal(); });
+    document.querySelector('#close-feedback').addEventListener('click', () => dialog.close());
+    dialog.addEventListener('close', () => {
+      // Fallback relocation also queues a close event; only restore outside focus on dismissal.
+      if (!dialog.open) launcher.focus({ preventScroll: true });
+    });
+
+    moveButton.addEventListener('click', () => {
+      const movingLeft = dialog.parentElement.id === 'feedback-away';
+      const destination = document.querySelector(movingLeft ? '#feedback-home' : '#feedback-away');
+      const focused = dialog.contains(document.activeElement) ? document.activeElement : null;
+      const selection = focused instanceof HTMLTextAreaElement ||
+        (focused instanceof HTMLInputElement && focused.selectionStart !== null)
+        ? [focused.selectionStart, focused.selectionEnd, focused.selectionDirection] : null;
+      const scroll = { top: dialog.scrollTop, messageTop: message.scrollTop, x: window.scrollX, y: window.scrollY };
+      const wasOpen = dialog.open;
+      const wasModal = dialog.matches(':modal');
+      const returnValue = dialog.returnValue;
+
+      if (typeof destination.moveBefore === 'function') {
+        // An atomic native move preserves the top layer, modality, and active focus.
+        destination.moveBefore(dialog, null);
+      } else {
+        // A conventional DOM move loses top-layer state. Recreate it explicitly.
+        if (wasOpen) dialog.close();
+        destination.appendChild(dialog);
+        if (wasOpen) {
+          if (wasModal) dialog.showModal();
+          else dialog.show();
+        }
+        dialog.returnValue = returnValue;
+        if (focused) focused.focus({ preventScroll: true });
+        if (selection) focused.setSelectionRange(...selection);
+        window.scrollTo(scroll.x, scroll.y);
+      }
+
+      dialog.dataset.side = movingLeft ? 'left' : 'right';
+      dialog.scrollTop = scroll.top;
+      message.scrollTop = scroll.messageTop;
+      moveButton.textContent = movingLeft ? 'Move →' : '← Move';
+      moveButton.title = `Move feedback to the ${movingLeft ? 'right' : 'left'}`;
+      moveButton.setAttribute('aria-label', moveButton.title);
+    });
+
+    // Open once on arrival; users can dismiss and reopen without losing their draft.
+    dialog.showModal();
+  </script>
