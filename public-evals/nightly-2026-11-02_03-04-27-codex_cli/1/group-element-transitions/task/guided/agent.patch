+  <script>
+    const beans = [
+      { id: 'house', name: 'House Blend', origin: 'The everyday favorite', roast: 'Medium roast', notes: 'Chocolate · Caramel · Almond', price: 16, color: '#6b765d', background: '#e4e8dc', mark: '☀' },
+      { id: 'ethiopia', name: 'Ethiopia Sidamo', origin: 'Ethiopia', roast: 'Light roast', notes: 'Blueberry · Bergamot · Honey', price: 20, color: '#ac694e', background: '#f0dfd2', mark: '✳' },
+      { id: 'colombia', name: 'Colombia Huila', origin: 'Colombia', roast: 'Medium roast', notes: 'Orange · Brown sugar · Cocoa', price: 18, color: '#b28a45', background: '#eee5d1', mark: '◈' },
+      { id: 'sumatra', name: 'Sumatra Mandheling', origin: 'Indonesia', roast: 'Dark roast', notes: 'Cedar · Dark chocolate · Spice', price: 19, color: '#526b68', background: '#dfe7e3', mark: '❋' },
+      { id: 'brazil', name: 'Brazil Cerrado', origin: 'Brazil', roast: 'Medium roast', notes: 'Hazelnut · Toffee · Chocolate', price: 17, color: '#8c674d', background: '#e9ddd0', mark: '◉' },
+      { id: 'decaf', name: 'Slow Sunday Decaf', origin: 'All the ritual. No rush.', roast: 'Medium roast · Decaf', notes: 'Cocoa · Walnut · Caramel', price: 18, color: '#7e708d', background: '#e6e0eb', mark: '☾' }
+    ];
+    let selected = ['house', 'ethiopia', 'colombia'];
+    const grid = document.getElementById('bean-grid');
+    const form = document.getElementById('bean-form');
+    const choice = document.getElementById('bean-choice');
+    const addButton = document.getElementById('add-bean');
+    const status = document.getElementById('bean-status');
+    const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let updates = Promise.resolve();
+
+    function renderSelection() {
+      const currentChoice = choice.value;
+      grid.innerHTML = selected.map(id => {
+        const bean = beans.find(item => item.id === id);
+        return `<li class="bean-card" style="view-transition-name: bean-${bean.id}; --bean-bg: ${bean.background}; --bean-ink: ${bean.color}">
+          <div class="bean-art" aria-hidden="true">
+            <div class="coffee-bag"><div class="bag-label"><span class="bag-brand">THE DAILY GRIND</span><span class="bag-icon">${bean.mark}</span><span class="bag-origin">${bean.name}</span></div><span class="bag-weight">WHOLE BEAN / 250 G</span></div>
+          </div>
+          <button type="button" class="remove-bean" data-remove="${bean.id}" aria-label="Remove ${bean.name}">×</button>
+          <div class="bean-details"><p class="bean-roast">${bean.roast}</p><h3>${bean.name}</h3><p class="bean-tasting">${bean.notes}</p><p class="bean-price">${currency.format(bean.price)} <span>/ 250g bag</span></p></div>
+        </li>`;
+      }).join('') || '<li class="bean-empty">Your next favorite is waiting. Add some beans to get started.</li>';
+      const available = beans.filter(bean => !selected.includes(bean.id));
+      choice.replaceChildren(...available.map(bean => new Option(`${bean.name} — ${currency.format(bean.price)}`, bean.id)));
+      if (available.some(bean => bean.id === currentChoice)) choice.value = currentChoice;
+      if (!available.length) choice.add(new Option('You’ve selected every roast', ''));
+      choice.disabled = addButton.disabled = available.length === 0;
+      document.getElementById('bean-count').textContent = `${selected.length} ${selected.length === 1 ? 'bag' : 'bags'} in your selection`;
+      document.getElementById('bean-total').textContent = currency.format(selected.reduce((sum, id) => sum + beans.find(bean => bean.id === id).price, 0));
+    }
+
+    // Serialize updates so even quick clicks get their own complete transition.
+    function changeSelection(update) {
+      updates = updates.then(async () => {
+        if (!document.startViewTransition || reducedMotion.matches) {
+          update();
+          return;
+        }
+        const transition = document.startViewTransition(update);
+        // A skipped animation must never prevent the selection from updating.
+        await transition.finished.catch(() => {});
+      });
+    }
+
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      const id = choice.value;
+      if (!id) return;
+      changeSelection(() => {
+        if (selected.includes(id)) return;
+        selected.push(id);
+        renderSelection();
+        status.textContent = `${beans.find(bean => bean.id === id).name} added. ${selected.length} bags selected.`;
+        if (addButton.disabled) grid.querySelector(`[data-remove="${id}"]`).focus({ preventScroll: true });
+      });
+    });
+
+    grid.addEventListener('click', event => {
+      const button = event.target.closest('[data-remove]');
+      if (!button) return;
+      const id = button.dataset.remove;
+      changeSelection(() => {
+        const index = selected.indexOf(id);
+        if (index < 0) return;
+        const needsFocus = grid.contains(document.activeElement);
+        selected.splice(index, 1);
+        renderSelection();
+        status.textContent = `${beans.find(bean => bean.id === id).name} removed. ${selected.length} bags selected.`;
+        if (needsFocus) {
+          const buttons = grid.querySelectorAll('[data-remove]');
+          (buttons[Math.min(index, buttons.length - 1)] || choice).focus({ preventScroll: true });
+        }
+      });
+    });
+
+    renderSelection();
+    form.hidden = false;
+  </script>
+
