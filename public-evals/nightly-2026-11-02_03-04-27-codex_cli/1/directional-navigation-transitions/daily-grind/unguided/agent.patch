+  <script>
+    const favorites = Array.from(document.querySelectorAll('#favorites-items .card'));
+    const favoritesStatus = document.querySelector('#favorites-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let favoriteIndex = 0;
+    let favoriteAnimation;
+
+    function showFavorite(direction) {
+      favoriteAnimation?.cancel();
+      favorites[favoriteIndex].hidden = true;
+      favoriteIndex = (favoriteIndex + direction + favorites.length) % favorites.length;
+      const favorite = favorites[favoriteIndex];
+      favorite.hidden = false;
+      favoritesStatus.textContent = `${favoriteIndex + 1} of ${favorites.length}: ${favorite.querySelector('h3').textContent}`;
+
+      if (!reducedMotion.matches) {
+        favoriteAnimation = favorite.animate(
+          [
+            { transform: `translateX(${direction * 100}%)`, opacity: 0 },
+            { transform: 'translateX(0)', opacity: 1 }
+          ],
+          { duration: 300, easing: 'ease-out' }
+        );
+      }
+    }
+
+    document.querySelector('#favorites-previous').addEventListener('click', () => showFavorite(-1));
+    document.querySelector('#favorites-next').addEventListener('click', () => showFavorite(1));
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) favoriteAnimation?.cancel();
+    });
+  </script>
