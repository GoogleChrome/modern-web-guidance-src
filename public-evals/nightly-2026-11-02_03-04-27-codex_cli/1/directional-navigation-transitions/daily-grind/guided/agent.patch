+  <script>
+    const seasonalSlides = document.getElementById('seasonal-slides');
+    const favorites = Array.from(seasonalSlides.querySelectorAll('.card'));
+    const seasonalStatus = document.getElementById('seasonal-status');
+    let currentFavorite = 0;
+
+    function showFavorite(direction) {
+      favorites[currentFavorite].hidden = true;
+      const step = direction === 'next' ? 1 : -1;
+      currentFavorite = (currentFavorite + step + favorites.length) % favorites.length;
+      seasonalSlides.dataset.direction = direction;
+      favorites[currentFavorite].hidden = false;
+      const title = favorites[currentFavorite].querySelector('h3').textContent;
+      seasonalStatus.textContent = `${currentFavorite + 1} of ${favorites.length}: ${title}`;
+    }
+
+    document.getElementById('seasonal-previous').addEventListener('click', () => showFavorite('previous'));
+    document.getElementById('seasonal-next').addEventListener('click', () => showFavorite('next'));
+  </script>
