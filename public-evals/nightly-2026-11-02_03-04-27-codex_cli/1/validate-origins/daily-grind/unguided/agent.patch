diff --git a/message-security.mjs b/message-security.mjs
new file mode 100644
index 0000000..e6234a6
--- /dev/null
+++ b/message-security.mjs
@@ -0,0 +1,79 @@
+// Parse complete URLs; never infer hosts by splitting strings or matching suffixes.
+export function parseWebURL(value, baseURL) {
+  if (typeof value !== 'string' || value.trim() === '') return null;
+  try {
+    const url = new URL(value, baseURL);
+    if (!['https:', 'http:'].includes(url.protocol)) return null;
+    if (url.username || url.password) return null;
+    return url;
+  } catch {
+    return null;
+  }
+}
+
+export function validateRedirectURL(value, pageURL) {
+  const page = parseWebURL(pageURL);
+  const target = page && parseWebURL(value, page.href);
+  // An exact origin check deliberately excludes sibling subdomains and other ports.
+  return target && target.origin === page.origin ? target.href : null;
+}
+
+export function validateExternalURL(value, pageURL) {
+  const page = parseWebURL(pageURL);
+  const target = page && parseWebURL(value, page.href);
+  return target && target.origin !== page.origin ? target.href : null;
+}
+
+export function createMessageHandler({
+  orderingOrigin,
+  pageURL,
+  widget = null,
+  redirect,
+  openExternal,
+}) {
+  // Configuration must name an origin, not an arbitrary URL with a path.
+  const ordering = parseWebURL(orderingOrigin);
+  const trustedOrigin = ordering && orderingOrigin === ordering.origin
+    ? ordering.origin
+    : null;
+  let widgetSource = null;
+
+  return function handleMessage(event) {
+    const data = event.data;
+    if (!data || typeof data !== 'object' || Array.isArray(data)) return;
+
+    if (event.origin === 'null') {
+      // Opaque origins are shared by unrelated sandboxed documents. Identity
+      // must come from the iframe we own, never the first sender claiming init.
+      if (data.type === 'widget:init') {
+        if (!widgetSource && widget?.contentWindow && event.source === widget.contentWindow) {
+          widgetSource = event.source;
+        }
+        return;
+      }
+      if (!widgetSource || event.source !== widgetSource) return;
+    } else if (!trustedOrigin || event.origin !== trustedOrigin) {
+      return;
+    }
+
+    if (data.type === 'redirect') {
+      const url = validateRedirectURL(data.url, pageURL);
+      if (url) redirect(url);
+    } else if (data.type === 'external-link') {
+      const url = validateExternalURL(data.url, pageURL);
+      if (url) openExternal(url);
+    }
+  };
+}
+
+export function installMessageValidation(pageWindow, pageDocument) {
+  const handler = createMessageHandler({
+    orderingOrigin: pageDocument.querySelector('meta[name="ordering-origin"]')?.content,
+    pageURL: pageWindow.location.href,
+    widget: pageDocument.querySelector('iframe[data-ordering-widget]'),
+    redirect: url => pageWindow.location.assign(url),
+    openExternal: url => pageWindow.open(url, '_blank', 'noopener,noreferrer'),
+  });
+  pageWindow.addEventListener('message', handler);
+  return () => pageWindow.removeEventListener('message', handler);
+}
diff --git a/message-security.test.mjs b/message-security.test.mjs
new file mode 100644
index 0000000..e4c4e50
--- /dev/null
+++ b/message-security.test.mjs
@@ -0,0 +1,115 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {
+  createMessageHandler,
+  installMessageValidation,
+  validateExternalURL,
+  validateRedirectURL,
+} from './message-security.mjs';
+
+const pageURL = 'https://dailygrind.example/account';
+const orderingOrigin = 'https://orders.dailygrind.example';
+
+test('redirects require the exact parsed page origin', () => {
+  assert.equal(validateRedirectURL('/checkout?next=/menu#cart', pageURL),
+    'https://dailygrind.example/checkout?next=/menu#cart');
+  assert.equal(validateRedirectURL('https://DAILYGRIND.example:443/menu', pageURL),
+    'https://dailygrind.example/menu');
+  for (const url of [
+    '//evil.example/menu', 'https://dailygrind.example.evil.example',
+    'https://dailygrind.example@evil.example', 'https://evil.example@dailygrind.example',
+    'https://orders.dailygrind.example', 'http://dailygrind.example',
+    'https://dailygrind.example:444', 'javascript:alert(1)', 'data:text/html,test',
+    String.raw`/\evil.example/menu`, 'https://[', '', null, {},
+  ]) assert.equal(validateRedirectURL(url, pageURL), null, String(url));
+});
+
+test('external URLs must be credential-free HTTP(S) URLs on another origin', () => {
+  assert.equal(validateExternalURL('https://coffee.example/menu?q=a/b', pageURL),
+    'https://coffee.example/menu?q=a/b');
+  for (const url of ['/menu', pageURL, 'javascript:alert(1)',
+    'data:text/html,test', 'https://name:password@coffee.example', 'https://[', null]) {
+    assert.equal(validateExternalURL(url, pageURL), null);
+  }
+});
+
+function fixture(origin = orderingOrigin) {
+  const redirects = [];
+  const external = [];
+  const widget = { contentWindow: {} };
+  const handle = createMessageHandler({
+    orderingOrigin: origin, pageURL, widget,
+    redirect: url => redirects.push(url),
+    openExternal: url => external.push(url),
+  });
+  const send = (source, origin, data) => handle({ source, origin, data });
+  return { redirects, external, widget, send };
+}
+
+test('ordering messages require an exact trusted origin and valid payload', () => {
+  const f = fixture();
+  for (const origin of ['https://evil.example', orderingOrigin + '.evil.example',
+    'http://orders.dailygrind.example', orderingOrigin + ':444', '']) {
+    f.send({}, origin, { type: 'redirect', url: '/checkout' });
+  }
+  for (const data of [null, [], 'redirect', {}, { type: 'redirect', url: '//evil.example' }]) {
+    f.send({}, orderingOrigin, data);
+  }
+  assert.deepEqual(f.redirects, []);
+  f.send({}, orderingOrigin, { type: 'redirect', url: '/checkout' });
+  f.send({}, orderingOrigin, { type: 'external-link', url: 'https://coffee.example' });
+  assert.deepEqual(f.redirects, ['https://dailygrind.example/checkout']);
+  assert.deepEqual(f.external, ['https://coffee.example/']);
+});
+
+test('sandbox initialization pins only the expected widget and cannot be overwritten', () => {
+  const f = fixture();
+  const expected = f.widget.contentWindow;
+  const attacker = {};
+  const init = { type: 'widget:init' };
+  const action = { type: 'redirect', url: '/checkout' };
+  f.send(expected, 'null', action);
+  f.send(attacker, 'null', init);
+  f.send(attacker, 'null', action);
+  f.send(null, 'null', init);
+  assert.deepEqual(f.redirects, []);
+  f.send(expected, 'null', init);
+  f.send(attacker, 'null', init);
+  f.send(attacker, 'null', action);
+  f.widget.contentWindow = attacker;
+  f.send(attacker, 'null', init);
+  f.send(attacker, 'null', action);
+  f.send(expected, 'https://evil.example', action);
+  assert.deepEqual(f.redirects, []);
+  f.send(expected, 'null', action);
+  f.send(expected, 'null', { type: 'redirect', url: '//evil.example' });
+  assert.deepEqual(f.redirects, ['https://dailygrind.example/checkout']);
+});
+
+test('missing or invalid ordering configuration fails closed', () => {
+  for (const origin of [undefined, '', 'null', orderingOrigin + '/path', 'javascript:foo']) {
+    const f = fixture(origin === undefined ? null : origin);
+    f.send({}, orderingOrigin, { type: 'redirect', url: '/checkout' });
+    assert.deepEqual(f.redirects, []);
+  }
+});
+
+test('page integration registers a removable handler and opens links without an opener', () => {
+  const calls = [];
+  let handler;
+  const win = {
+    location: { href: pageURL, assign: url => calls.push(['redirect', url]) },
+    open: (...args) => calls.push(args),
+    addEventListener: (type, fn) => { assert.equal(type, 'message'); handler = fn; },
+    removeEventListener: (type, fn) => {
+      assert.equal(type, 'message'); assert.equal(fn, handler);
+    },
+  };
+  const doc = { querySelector: selector => selector.startsWith('meta')
+    ? { content: orderingOrigin } : null };
+  const remove = installMessageValidation(win, doc);
+  handler({ origin: orderingOrigin, source: {},
+    data: { type: 'external-link', url: 'https://coffee.example' } });
+  assert.deepEqual(calls, [['https://coffee.example/', '_blank', 'noopener,noreferrer']]);
+  remove();
+});
