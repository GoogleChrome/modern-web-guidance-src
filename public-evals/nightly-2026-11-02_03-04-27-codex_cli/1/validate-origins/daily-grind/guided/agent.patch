--- /dev/null
+++ b/daily-grind.mjs
@@ -0,0 +1,58 @@
+import { createValidation } from './origin-validation.mjs';
+
+const validation = createValidation({ appUrl: window.location.href });
+const status = document.querySelector('#order-status');
+const widget = document.querySelector('#rewards-widget');
+const acceptWidget = validation.createWidgetValidator(widget.contentWindow);
+
+window.addEventListener('message', event => {
+  const data = event.data;
+  if (!data || typeof data !== 'object' || Array.isArray(data)) return;
+
+  if (validation.isTrustedOrderingMessage(event)) {
+    if (data.type === 'order:status' && typeof data.message === 'string' && data.message.length <= 300) {
+      status.textContent = data.message;
+    } else if (data.type === 'order:redirect' && typeof data.url === 'string') {
+      const target = validation.allowedRedirect(data.url);
+      if (target) window.location.assign(target);
+    }
+    return;
+  }
+
+  if (acceptWidget(event) && data.type === 'widget:status' &&
+      typeof data.message === 'string' && data.message.length <= 300) {
+    document.querySelector('#rewards-status').textContent = data.message;
+  }
+});
+
+function validateLink(link) {
+  const kind = validation.classifyLink(link);
+  link.dataset.site = kind;
+  if (kind === 'external') link.relList.add('external', 'noopener', 'noreferrer');
+  return kind;
+}
+
+document.querySelectorAll('a[href]').forEach(validateLink);
+// Revalidate at activation so dynamically changed links follow the same policy.
+document.addEventListener('click', event => {
+  const link = event.target.closest?.('a[href]');
+  if (link && validateLink(link) === 'blocked') event.preventDefault();
+});
+document.addEventListener('auxclick', event => {
+  const link = event.target.closest?.('a[href]');
+  if (link && validateLink(link) === 'blocked') event.preventDefault();
+});
+
+// Register the listener and capture the expected WindowProxy before loading the
+// opaque document. The widget sends no sensitive data and targets this origin.
+const parentOrigin = JSON.stringify(window.location.origin).replace(/</g, '\\u003c');
+widget.srcdoc = `<!doctype html><html lang="en"><meta charset="utf-8">
+  <title>Daily Grind Rewards</title><p>Make your next cup count.</p>
+  <a href="/rewards" id="join">Explore rewards</a>
+  <script>
+    parent.postMessage({ type: 'init' }, ${parentOrigin});
+    document.querySelector('#join').addEventListener('click', event => {
+      event.preventDefault();
+      parent.postMessage({ type: 'widget:status', message: 'Visit Rewards in the navigation to join.' }, ${parentOrigin});
+    });
+  </script></html>`;
