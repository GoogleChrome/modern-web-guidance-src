+(() => {
+  const views = new Map(
+    [...document.querySelectorAll('[data-view]')].map(view => [view.dataset.view, view])
+  );
+  const navigation = [...document.querySelectorAll('nav a[href^="#/"]')];
+  const scrollPositions = new Map();
+  const titles = {
+    '/': 'Artisanal Coffee',
+    '/menu': 'Menu',
+    '/locations': 'Locations',
+    '/rewards': 'Rewards',
+    '/account': 'My Account'
+  };
+  let activeRoute;
+
+  // Hash routes also work when this static site is refreshed without server rewrites.
+  const routeFromURL = () => {
+    const route = window.location.hash.slice(1) || '/';
+    return views.has(route) ? route : '/';
+  };
+
+  function showView(route) {
+    if (route === activeRoute) return;
+
+    const previousView = views.get(activeRoute);
+    if (previousView) previousView.hidden = true;
+
+    // Keep every view mounted: never replace its children or recreate form controls.
+    const nextView = views.get(route);
+    nextView.hidden = false;
+    activeRoute = route;
+    document.title = `The Daily Grind | ${titles[route]}`;
+
+    for (const link of navigation) {
+      if (link.hash === `#${route}`) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    }
+
+    if (previousView) {
+      nextView.querySelector('h1')?.focus({ preventScroll: true });
+    }
+    window.scrollTo(0, scrollPositions.get(route) || 0);
+  }
+
+  if ('scrollRestoration' in window.history) window.history.scrollRestoration = 'manual';
+
+  window.addEventListener('scroll', () => {
+    if (activeRoute) scrollPositions.set(activeRoute, window.scrollY);
+  }, { passive: true });
+
+  document.addEventListener('click', event => {
+    const link = event.target.closest('a[href]');
+    if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey ||
+        event.ctrlKey || event.shiftKey || event.altKey || link.hasAttribute('download') ||
+        (link.target && link.target !== '_self')) return;
+
+    const url = new URL(link.href, window.location.href);
+    if (url.origin !== window.location.origin || url.pathname !== window.location.pathname ||
+        url.search !== window.location.search || !views.has(url.hash.slice(1))) return;
+
+    event.preventDefault();
+    const route = url.hash.slice(1);
+    if (route === activeRoute) return;
+    scrollPositions.set(activeRoute, window.scrollY);
+    window.history.pushState(null, '', url.hash);
+    showView(route);
+  });
+
+  // Both events are needed for history traversal and directly edited hash URLs.
+  window.addEventListener('popstate', () => showView(routeFromURL()));
+  window.addEventListener('hashchange', () => showView(routeFromURL()));
+
+  document.querySelector('#menu-filter').addEventListener('change', event => {
+    for (const drink of document.querySelectorAll('[data-drink]')) {
+      drink.hidden = event.target.value !== 'all' && drink.dataset.drink !== event.target.value;
+    }
+  });
+
+  document.querySelector('#location-search').addEventListener('input', event => {
+    const search = event.target.value.trim().toLowerCase();
+    let matches = 0;
+    for (const location of document.querySelectorAll('[data-location]')) {
+      location.hidden = !location.dataset.location.includes(search);
+      if (!location.hidden) matches++;
+    }
+    document.querySelector('#location-empty').hidden = matches > 0;
+  });
+
+  document.querySelector('#preferences-form').addEventListener('submit', event => {
+    event.preventDefault();
+    document.querySelector('#preferences-status').textContent = 'Preferences saved for this visit.';
+  });
+
+  showView(routeFromURL());
+})();
