+(() => {
+  const views = new Map(
+    [...document.querySelectorAll('.spa-view')].map(view => [view.id.slice(5), view])
+  );
+  const navigation = document.querySelectorAll('[data-view-link]');
+  const scrollPositions = new Map();
+  let currentView;
+
+  // Hash routes work on static hosting, including reloads and Back/Forward.
+  history.scrollRestoration = 'manual';
+
+  function showView({ initial = false } = {}) {
+    const route = location.hash.slice(2) || 'home';
+    const nextView = views.has(route) ? route : 'home';
+    if (nextView === currentView) return;
+    if (currentView) scrollPositions.set(currentView, window.scrollY);
+
+    for (const [name, view] of views) {
+      const inactive = name !== nextView;
+      view.classList.toggle('inactive', inactive);
+      view.toggleAttribute('inert', inactive);
+      view.setAttribute('aria-hidden', String(inactive));
+    }
+    for (const link of navigation) {
+      if (link.dataset.viewLink === nextView) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    }
+
+    currentView = nextView;
+    const heading = views.get(nextView).querySelector('h1');
+    document.title = `${nextView === 'home' ? 'Artisanal Coffee' : heading.textContent} | The Daily Grind`;
+    if (!initial) heading.focus({ preventScroll: true });
+    window.scrollTo({ top: scrollPositions.get(nextView) || 0, behavior: 'instant' });
+  }
+
+  const category = document.getElementById('menu-category');
+  function filterMenu() {
+    document.querySelectorAll('[data-category]').forEach(card => {
+      card.hidden = category.value !== 'all' && card.dataset.category !== category.value;
+    });
+  }
+  category.addEventListener('change', filterMenu);
+
+  document.querySelectorAll('[data-menu-category]').forEach(link => {
+    link.addEventListener('click', event => {
+      // Preserve native modified-click behavior (new tabs/windows).
+      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      category.value = link.dataset.menuCategory;
+      filterMenu();
+    });
+  });
+
+  document.getElementById('account-form').addEventListener('submit', event => {
+    event.preventDefault();
+    document.getElementById('account-status').textContent = 'Preferences kept for this visit. They reset when you reload the page.';
+  });
+
+  window.addEventListener('hashchange', () => showView());
+  showView({ initial: true });
+})();
