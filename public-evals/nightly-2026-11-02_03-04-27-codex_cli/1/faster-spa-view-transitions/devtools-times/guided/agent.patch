 @import "tailwindcss";
 
+/* Keep inactive DOM and rendering state without contributing to page layout. */
+.spa-view[data-inactive] {
+  content-visibility: hidden;
+  position: absolute;
+  width: 100%;
+  height: 0;
+  overflow: clip;
+  visibility: hidden;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view[data-inactive] {
+    display: none;
+  }
+}
