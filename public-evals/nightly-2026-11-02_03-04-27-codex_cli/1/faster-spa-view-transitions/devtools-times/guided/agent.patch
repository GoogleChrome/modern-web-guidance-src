diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..9423cb0
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,70 @@
+import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';
+
+// Includes the active view. Map insertion order tracks least-recently used views.
+const MAX_VIEWS = 5;
+const views = new Map<string, HTMLElement>();
+const hostSelector = '[data-view-cache]';
+const viewSelector = ':scope > [data-view-key]';
+let focusAfterSwap = false;
+
+document.addEventListener('astro:before-swap', (event) => {
+  const navigation = event as TransitionBeforeSwapEvent;
+  const host = document.querySelector<HTMLElement>(hostSelector);
+  const incomingHost = navigation.newDocument.querySelector<HTMLElement>(hostSelector);
+  const incoming = incomingHost?.querySelector<HTMLElement>(viewSelector);
+  if (!host || !incomingHost || !incoming) return;
+
+  // Run inside Astro's swap so preparation/cancelled navigation cannot hide a view.
+  const swap = navigation.swap;
+  navigation.swap = () => {
+    const current = host.querySelector<HTMLElement>(':scope > [data-view-key]:not([data-inactive])');
+    if (current) {
+      current.dataset.inactive = '';
+      current.inert = true;
+      current.setAttribute('aria-hidden', 'true');
+      if (current.dataset.cacheView === 'true') {
+        views.set(current.dataset.viewKey!, current);
+      } else {
+        current.remove();
+      }
+    }
+
+    const key = incoming.dataset.viewKey!;
+    // A same-URL navigation is a refresh; use the new server-rendered content.
+    const refreshing = navigation.from.pathname + navigation.from.search === key;
+    const cached = views.get(key);
+    const next = !refreshing && incoming.dataset.cacheView === 'true' && cached?.isConnected
+      ? cached
+      : incoming;
+    if (cached && cached !== next) cached.remove();
+
+    next.removeAttribute('data-inactive');
+    next.removeAttribute('aria-hidden');
+    next.inert = false;
+
+    // Touch the selected view and evict oldest entries, releasing their islands.
+    views.delete(key);
+    if (next.dataset.cacheView === 'true') views.set(key, next);
+    const cacheLimit = MAX_VIEWS - (next.dataset.cacheView === 'true' ? 0 : 1);
+    while (views.size > cacheLimit) {
+      const oldestKey = views.keys().next().value!;
+      views.get(oldestKey)!.remove();
+      views.delete(oldestKey);
+    }
+
+    // Astro transfers the persistent host, including all retained child nodes.
+    swap();
+    // Leave fresh content in the incoming document until Astro has marked its
+    // previously executed scripts. New islands connect before astro:after-swap.
+    if (next === incoming) host.append(next);
+    focusAfterSwap = true;
+  };
+});
+
+document.addEventListener('astro:after-swap', () => {
+  if (!focusAfterSwap) return;
+  focusAfterSwap = false;
+  // Avoid changing the router's scroll restoration and fragment navigation.
+  document.querySelector<HTMLElement>(`${hostSelector} > [data-view-key]:not([data-inactive])`)
+    ?.focus({ preventScroll: true });
+});
