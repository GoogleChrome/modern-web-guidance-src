+  <script>
+    const message = document.getElementById('feedback-message');
+    const detectButton = document.getElementById('detect-language');
+    const status = document.getElementById('feedback-status');
+    const download = document.getElementById('feedback-download');
+    const progress = document.getElementById('download-progress');
+    const percentage = document.getElementById('download-percentage');
+    let modelAvailability;
+
+    async function checkLanguageDetection() {
+      if (!('LanguageDetector' in window)) {
+        status.textContent = 'Built-in language detection is not supported in this browser. Try a supported desktop browser such as Chrome or Edge.';
+        return;
+      }
+
+      try {
+        modelAvailability = await LanguageDetector.availability();
+        if (!['available', 'downloadable', 'downloading'].includes(modelAvailability)) {
+          status.textContent = 'Built-in language detection is unavailable on this device or is blocked by browser settings.';
+          return;
+        }
+        status.textContent = modelAvailability === 'available'
+          ? 'Language detection is ready.'
+          : 'Click Detect to download the language model and detect your message’s language.';
+        detectButton.disabled = false;
+      } catch {
+        status.textContent = 'Could not check language detection availability. Reload the page to try again.';
+      }
+    }
+
+    message.addEventListener('input', () => {
+      if (!detectButton.disabled) status.textContent = '';
+    });
+
+    detectButton.addEventListener('click', async () => {
+      const text = message.value.trim();
+      if (!text) {
+        status.textContent = 'Enter a message before detecting its language.';
+        message.focus();
+        return;
+      }
+
+      detectButton.disabled = true;
+      message.readOnly = true;
+      progress.value = 0;
+      percentage.textContent = '0%';
+      download.hidden = modelAvailability === 'available';
+      status.textContent = 'Preparing language detection…';
+      let detector;
+
+      try {
+        // Start creation directly from the click to preserve user activation.
+        detector = await LanguageDetector.create({
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              const percent = Math.round(Math.min(1, Math.max(0, event.loaded)) * 100);
+              download.hidden = false;
+              progress.value = percent;
+              percentage.textContent = `${percent}%`;
+            });
+          },
+        });
+        modelAvailability = 'available';
+        download.hidden = true;
+        status.textContent = 'Detecting language…';
+        const [result] = await detector.detect(text);
+        if (!result || result.detectedLanguage === 'und' || !Number.isFinite(result.confidence)) {
+          status.textContent = 'Could not identify a language. Try a longer message with more context.';
+          return;
+        }
+
+        const languageName = new Intl.DisplayNames(['en'], { type: 'language' })
+          .of(result.detectedLanguage);
+        const confidence = new Intl.NumberFormat('en', {
+          style: 'percent', maximumFractionDigits: 1,
+        }).format(result.confidence);
+        status.textContent = `Language: ${languageName}. AI confidence: ${confidence}.`;
+      } catch {
+        status.textContent = 'Language detection failed. Check your connection and browser settings, then click Detect to try again.';
+      } finally {
+        detector?.destroy();
+        download.hidden = true;
+        message.readOnly = false;
+        detectButton.disabled = false;
+      }
+    });
+
+    checkLanguageDetection();
+  </script>
+
 </body>
 
