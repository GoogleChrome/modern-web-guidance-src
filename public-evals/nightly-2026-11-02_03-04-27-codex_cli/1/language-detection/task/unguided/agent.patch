+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const messageInput = document.getElementById('feedback-message');
+    const detectButton = document.getElementById('detect-button');
+    const detectionStatus = document.getElementById('feedback-status');
+    const modelProgress = document.getElementById('model-progress');
+    let detector;
+    let modelAvailability;
+    let detecting = false;
+
+    async function checkLanguageDetection() {
+      if (!('LanguageDetector' in self)) {
+        detectionStatus.textContent = 'Built-in language detection is not supported in this browser. Try a browser that supports the Language Detector API.';
+        return;
+      }
+
+      try {
+        modelAvailability = await LanguageDetector.availability();
+        if (modelAvailability === 'unavailable') {
+          detectionStatus.textContent = 'Language detection is unavailable on this device or is blocked by your browser settings.';
+          return;
+        }
+        detectionStatus.textContent = modelAvailability === 'available'
+          ? 'Ready to detect your message’s language.'
+          : 'Click Detect to download the language detection model before analyzing your message.';
+        detectButton.disabled = false;
+      } catch {
+        detectionStatus.textContent = 'Could not check language detection availability. Reload the page to try again.';
+      }
+    }
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (detecting || detectButton.disabled) return;
+      const message = messageInput.value.trim();
+      if (!message) {
+        detectionStatus.textContent = 'Please enter a message to detect its language.';
+        messageInput.focus();
+        return;
+      }
+
+      detecting = true;
+      detectButton.disabled = true;
+      messageInput.readOnly = true;
+      feedbackForm.setAttribute('aria-busy', 'true');
+      try {
+        if (!detector) {
+          if (modelAvailability !== 'available') {
+            modelProgress.value = 0;
+            modelProgress.hidden = false;
+            detectionStatus.textContent = 'Downloading language model: 0%';
+          } else {
+            detectionStatus.textContent = 'Preparing language detection…';
+          }
+          // Create directly from the user action so a model download is allowed.
+          detector = await LanguageDetector.create({
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                const percent = Math.round(Math.min(1, Math.max(0, event.loaded)) * 100);
+                modelProgress.hidden = false;
+                modelProgress.value = percent;
+                detectionStatus.textContent = `Downloading language model: ${percent}%`;
+              });
+            }
+          });
+          modelAvailability = 'available';
+        }
+        modelProgress.hidden = true;
+        detectionStatus.textContent = 'Detecting language…';
+        const results = await detector.detect(message);
+        const topResult = results[0];
+        if (!topResult || !topResult.detectedLanguage || topResult.detectedLanguage === 'und') {
+          detectionStatus.textContent = 'Could not identify a language. Try a longer message.';
+          return;
+        }
+        const language = new Intl.DisplayNames(['en'], { type: 'language' }).of(topResult.detectedLanguage);
+        const confidence = new Intl.NumberFormat('en', { style: 'percent', maximumFractionDigits: 1 }).format(topResult.confidence);
+        detectionStatus.textContent = `Language: ${language}. AI confidence: ${confidence}.`;
+      } catch {
+        detectionStatus.textContent = 'Language detection failed. Please try again. If a model download is needed, check your connection.';
+      } finally {
+        modelProgress.hidden = true;
+        detecting = false;
+        detectButton.disabled = false;
+        messageInput.readOnly = false;
+        feedbackForm.removeAttribute('aria-busy');
+      }
+    });
+
+    checkLanguageDetection();
+  </script>
 </body>
 
