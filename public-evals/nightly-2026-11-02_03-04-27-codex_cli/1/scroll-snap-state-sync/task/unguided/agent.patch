+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const sections = [...panel.querySelectorAll('.drink-section')];
+    const tocLinks = [...document.querySelectorAll('.toc-sidebar a')];
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function updateCurrentSection() {
+      const panelTop = panel.getBoundingClientRect().top + panel.clientTop;
+      const current = sections.reduce((nearest, section) =>
+        Math.abs(section.getBoundingClientRect().top - panelTop) <
+        Math.abs(nearest.getBoundingClientRect().top - panelTop) ? section : nearest
+      );
+
+      tocLinks.forEach(link => {
+        if (link.hash === `#${current.id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    let scrollFrame;
+    panel.addEventListener('scroll', () => {
+      if (scrollFrame) return;
+      scrollFrame = requestAnimationFrame(() => {
+        updateCurrentSection();
+        scrollFrame = null;
+      });
+    }, { passive: true });
+
+    tocLinks.forEach(link => {
+      link.addEventListener('click', event => {
+        // Preserve native behavior for opening a link in another tab/window.
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const section = sections.find(section => `#${section.id}` === link.hash);
+        const top = panel.scrollTop + section.getBoundingClientRect().top -
+          panel.getBoundingClientRect().top - panel.clientTop;
+        panel.scrollTo({ top, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+        section.querySelector('h3').focus({ preventScroll: true });
+      });
+    });
+
+    window.addEventListener('resize', updateCurrentSection);
+    updateCurrentSection();
+  </script>
