+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const tocLinks = [...document.querySelectorAll('.toc-sidebar a')];
+    const headers = [...panel.querySelectorAll('.drink-section header')];
+
+    function setActiveHeader(header) {
+      tocLinks.forEach((link) => {
+        if (link.hash === `#${header.id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function syncActiveHeader() {
+      const panelTop = panel.getBoundingClientRect().top + panel.clientTop;
+      const closest = headers.reduce((current, header) =>
+        Math.abs(header.getBoundingClientRect().top - panelTop) <
+        Math.abs(current.getBoundingClientRect().top - panelTop) ? header : current
+      );
+      setActiveHeader(closest);
+    }
+
+    if ('onscrollsnapchange' in panel) {
+      panel.addEventListener('scrollsnapchange', (event) => {
+        if (event.snapTargetBlock) setActiveHeader(event.snapTargetBlock);
+      });
+    } else {
+      // Observe within the panel, independently of the page's scroll position.
+      const observer = new IntersectionObserver(syncActiveHeader, {
+        root: panel,
+        threshold: [0, 0.25, 0.5, 0.75, 1]
+      });
+      panel.querySelectorAll('.drink-section, .drink-section header')
+        .forEach((target) => observer.observe(target));
+    }
+
+    // Also keep the TOC accurate when proximity scrolling stops between targets.
+    panel.addEventListener('scrollend', syncActiveHeader);
+
+    tocLinks.forEach((link) => {
+      link.addEventListener('click', (event) => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const header = headers.find((target) => `#${target.id}` === link.hash);
+        panel.scrollTo({
+          top: panel.scrollTop + header.getBoundingClientRect().top -
+            panel.getBoundingClientRect().top - panel.clientTop,
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    syncActiveHeader();
+  </script>
