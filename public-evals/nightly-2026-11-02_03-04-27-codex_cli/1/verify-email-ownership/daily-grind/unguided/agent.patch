diff --git a/rewards.js b/rewards.js
new file mode 100644
index 0000000..7ef81d9
--- /dev/null
+++ b/rewards.js
@@ -0,0 +1,32 @@
+const form = document.querySelector('#rewards-form');
+form?.addEventListener('submit', () => {
+  // Keep native submission: Chrome fills the verification token during submit.
+  // In particular, do not read the hidden token early or replace this with fetch.
+  const button = form.querySelector('button[type="submit"]');
+  button.textContent = 'Creating your account…';
+  button.setAttribute('aria-disabled', 'true');
+  form.setAttribute('aria-busy', 'true');
+});
+const password = document.querySelector('#rewards-password');
+const toggle = document.querySelector('#toggle-password');
+if (toggle && password) {
+  toggle.hidden = false;
+  toggle.addEventListener('click', () => {
+    const show = password.type === 'password';
+    password.type = show ? 'text' : 'password';
+    toggle.textContent = show ? 'Hide' : 'Show';
+    toggle.setAttribute('aria-pressed', String(show));
+  });
+}
+const result = document.querySelector('#signup-result');
+if (result) {
+  result.focus({ preventScroll: true });
+  document.querySelector('#rewards').scrollIntoView({ block: 'start', behavior: 'instant' });
+}
+window.addEventListener('pageshow', () => {
+  if (!form) return;
+  const button = form.querySelector('button[type="submit"]');
+  button.textContent = 'Create my rewards account';
+  button.removeAttribute('aria-disabled');
+  form.removeAttribute('aria-busy');
+});
