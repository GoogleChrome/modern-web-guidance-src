diff --git a/lib/public-json.mjs b/lib/public-json.mjs
new file mode 100644
index 0000000..cc8711e
--- /dev/null
+++ b/lib/public-json.mjs
@@ -0,0 +1,55 @@
+import https from 'node:https';
+import { lookup } from 'node:dns';
+import ipaddr from 'ipaddr.js';
+
+export function publicHttpsUrl(value) {
+  const url = new URL(value);
+  if (url.protocol !== 'https:' || url.username || url.password || url.port || url.hash ||
+      !url.hostname.includes('.') || ipaddr.isValid(url.hostname.replace(/^\[|\]$/g, ''))) {
+    throw new Error('A public HTTPS URL is required');
+  }
+  return url;
+}
+
+// Pin the actual connection to a validated public IP. Never follow redirects or
+// let untrusted issuer metadata reach local services (including via DNS rebinding).
+export function publicJson(value) {
+  const url = publicHttpsUrl(value);
+  return new Promise((resolve, reject) => {
+    const request = https.get(url, {
+      agent: false,
+      headers: { Accept: 'application/json' },
+      lookup(host, options, callback) {
+        lookup(host, { all: true, verbatim: true }, (error, addresses) => {
+          if (error) return callback(error);
+          if (!addresses.length || addresses.some(({ address }) => ipaddr.process(address).range() !== 'unicast')) {
+            return callback(new Error('Non-public issuer address'));
+          }
+          const selected = addresses[0];
+          if (options.all) callback(null, [selected]);
+          else callback(null, selected.address, selected.family);
+        });
+      },
+    }, (response) => {
+      if (response.statusCode !== 200) {
+        response.resume();
+        return reject(new Error('Issuer discovery failed'));
+      }
+      let size = 0;
+      const chunks = [];
+      response.on('data', chunk => {
+        size += chunk.length;
+        if (size > 128 * 1024) request.destroy(new Error('Issuer response too large'));
+        else chunks.push(chunk);
+      });
+      response.on('error', reject);
+      response.on('end', () => {
+        try { resolve(JSON.parse(Buffer.concat(chunks).toString('utf8'))); }
+        catch (error) { reject(error); }
+      });
+    });
+    const timer = setTimeout(() => request.destroy(new Error('Issuer request timed out')), 5000);
+    request.on('close', () => clearTimeout(timer));
+    request.on('error', reject);
+  });
+}
diff --git a/lib/store.mjs b/lib/store.mjs
new file mode 100644
index 0000000..d0cf578
--- /dev/null
+++ b/lib/store.mjs
@@ -0,0 +1,42 @@
+import { DatabaseSync } from 'node:sqlite';
+
+export function createStore(path) {
+  const db = new DatabaseSync(path);
+  db.exec(`PRAGMA journal_mode = WAL;
+    CREATE TABLE IF NOT EXISTS challenges (
+      nonce TEXT PRIMARY KEY, session_hash TEXT NOT NULL, expires INTEGER NOT NULL
+    );
+    CREATE TABLE IF NOT EXISTS rewards_accounts (
+      id TEXT PRIMARY KEY, email TEXT NOT NULL UNIQUE COLLATE NOCASE,
+      name TEXT NOT NULL, password_hash TEXT NOT NULL, issuer TEXT NOT NULL,
+      email_verified_at INTEGER NOT NULL, created_at INTEGER NOT NULL
+    );`);
+  return {
+    challenge(nonce, sessionHash, now) {
+      db.prepare('DELETE FROM challenges WHERE expires < ?').run(now);
+      db.prepare('INSERT INTO challenges VALUES (?, ?, ?)').run(nonce, sessionHash, now + 600);
+    },
+    valid(nonce, sessionHash, now) {
+      return !!db.prepare('SELECT 1 FROM challenges WHERE nonce = ? AND session_hash = ? AND expires > ?')
+        .get(nonce, sessionHash, now);
+    },
+    register({ nonce, sessionHash, now, id, email, name, passwordHash, issuer }) {
+      db.exec('BEGIN IMMEDIATE');
+      try {
+        const consumed = db.prepare('DELETE FROM challenges WHERE nonce = ? AND session_hash = ? AND expires > ?')
+          .run(nonce, sessionHash, now);
+        if (consumed.changes !== 1) throw new Error('Challenge expired or already used');
+        // A duplicate address must never update an existing account or its password.
+        db.prepare('INSERT INTO rewards_accounts VALUES (?, ?, ?, ?, ?, ?, ?)')
+          .run(id, email, name, passwordHash, issuer, now, now);
+        db.exec('COMMIT');
+        return true;
+      } catch (error) {
+        db.exec('ROLLBACK');
+        if (error.code === 'ERR_SQLITE_ERROR' && error.message.includes('UNIQUE')) return false;
+        throw error;
+      }
+    },
+    close() { db.close(); },
+  };
+}
diff --git a/lib/verify-email.mjs b/lib/verify-email.mjs
new file mode 100644
index 0000000..671c2e3
--- /dev/null
+++ b/lib/verify-email.mjs
@@ -0,0 +1,87 @@
+import { createHash } from 'node:crypto';
+import { Resolver } from 'node:dns/promises';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { compactVerify, importJWK } from 'jose';
+import { publicHttpsUrl, publicJson } from './public-json.mjs';
+
+const algorithms = ['EdDSA', 'Ed25519', 'ES256'];
+const resolver = new Resolver({ timeout: 2000, tries: 2 });
+const resolveTxt = name => resolver.resolveTxt(name);
+const hasher = (data, algorithm) => {
+  if (algorithm !== 'sha-256') throw new Error('Unsupported digest');
+  return createHash('sha256').update(data).digest();
+};
+
+export async function verifyEmailOwnership({ token, email, nonce, origin }, {
+  txt = resolveTxt, json = publicJson,
+} = {}) {
+  if (typeof token !== 'string' || token.length > 24576 || !token.includes('~')) throw new Error('Missing proof');
+  if (!nonce || !origin) throw new Error('Missing session binding');
+  const decoded = decodeSdJwtSync(token, hasher);
+  const issuerPayload = decoded.jwt.payload;
+  const issuerHeader = decoded.jwt.header;
+  const binding = decoded.kbJwt;
+  if (issuerHeader.typ !== 'evt+jwt' || !algorithms.includes(issuerHeader.alg) ||
+      !binding || binding.header.typ !== 'kb+jwt' || !algorithms.includes(binding.header.alg)) {
+    throw new Error('Invalid proof type or algorithm');
+  }
+  const issuer = publicHttpsUrl(issuerPayload.iss);
+  if (issuer.origin !== issuerPayload.iss) throw new Error('Issuer must be an origin');
+  const domain = email.split('@')[1]?.toLowerCase();
+  if (!domain || !/^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,63}$/.test(domain)) {
+    throw new Error('Invalid email domain');
+  }
+  const records = await txt(`_email-verification.${domain}`);
+  if (!records.some(parts => parts.join('').trim() === `iss=${issuer.hostname}`)) {
+    throw new Error('Issuer is not delegated by the email domain');
+  }
+  const metadata = await json(`${issuer.origin}/.well-known/email-verification`);
+  if (metadata.issuer !== undefined && metadata.issuer !== issuerPayload.iss) throw new Error('Issuer mismatch');
+  publicHttpsUrl(metadata.jwks_uri);
+  const jwks = await json(metadata.jwks_uri);
+  if (!Array.isArray(jwks.keys) || jwks.keys.length > 30) throw new Error('Invalid key set');
+  const verifier = new SDJwtInstance({
+    hasher,
+    allowedDisclosureHashAlgorithms: ['sha-256'],
+    verifier: async (data, signature) => {
+      // Some participating providers omit kid. Try every eligible public key.
+      for (const jwk of jwks.keys) {
+        if (jwk.d || jwk.k || (issuerHeader.kid && jwk.kid !== issuerHeader.kid) ||
+            (jwk.alg && jwk.alg !== issuerHeader.alg) || (jwk.use && jwk.use !== 'sig')) continue;
+        try {
+          const key = await importJWK(jwk, issuerHeader.alg);
+          await compactVerify(`${data}.${signature}`, key, { algorithms });
+          return true;
+        } catch { /* Try the next public key. */ }
+      }
+      return false;
+    },
+    kbVerifier: async (data, signature, verifiedPayload) => {
+      const jwk = verifiedPayload.cnf?.jwk;
+      if (!jwk || jwk.d || jwk.k) return false;
+      try {
+        const key = await importJWK(jwk, binding.header.alg);
+        await compactVerify(`${data}.${signature}`, key, { algorithms });
+        return true;
+      } catch { return false; }
+    },
+  });
+  // These are the installed library's options, including mandatory key binding.
+  const result = await verifier.verify(token, {
+    requiredClaimKeys: ['iss', 'iat', 'exp', 'email', 'email_verified', 'cnf'],
+    expectedIssuer: issuer.origin,
+    allowedIssuerAlgorithms: algorithms,
+    allowedKeyBindingAlgorithms: algorithms,
+    keyBindingNonce: nonce,
+    expectedKeyBindingAudience: origin,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 30,
+  });
+  const payload = result.payload;
+  if (payload.email_verified !== true || typeof payload.email !== 'string' ||
+      payload.email.toLowerCase() !== email.toLowerCase() ||
+      !Number.isFinite(payload.iat) || !Number.isFinite(payload.exp) || payload.exp <= payload.iat) {
+    throw new Error('Email ownership claims do not match');
+  }
+  return { email, issuer: issuer.origin };
+}
