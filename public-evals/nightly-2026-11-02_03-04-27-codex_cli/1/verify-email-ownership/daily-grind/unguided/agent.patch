+import { spawnSync } from 'node:child_process';
+import { mkdir, cp, rm } from 'node:fs/promises';
+
+// Only syntax checks and isolated library tests. This never imports server.mjs,
+// opens a listening socket, launches a browser, or contacts an email provider.
+for (const args of [
+  ['--check', 'server.mjs'], ['--check', 'rewards.js'],
+  ['--check', 'lib/public-json.mjs'], ['--check', 'lib/verify-email.mjs'],
+  ['--check', 'lib/store.mjs'], ['--test', 'tests/verification.test.mjs'],
+]) {
+  const result = spawnSync(process.execPath, args, { stdio: 'inherit' });
+  if (result.status !== 0) process.exit(result.status || 1);
+}
+await rm('dist', { recursive: true, force: true });
+await mkdir('dist', { recursive: true });
+for (const file of ['index.html', 'rewards.css', 'rewards.js', 'server.mjs', 'lib', 'package.json', 'pnpm-lock.yaml']) {
+  await cp(file, `dist/${file}`, { recursive: true });
+}
+console.log('Build passed. Server and homepage packaged in dist/. No server was started.');
diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..3a057ba
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,145 @@
+import { createServer } from 'node:http';
+import { readFile, mkdir } from 'node:fs/promises';
+import { randomBytes, randomUUID, createHash, scrypt } from 'node:crypto';
+import { promisify } from 'node:util';
+import { resolve } from 'node:path';
+import { createStore } from './lib/store.mjs';
+import { verifyEmailOwnership } from './lib/verify-email.mjs';
+
+const port = Number(process.env.PORT || 11222);
+const origin = new URL(process.env.APP_ORIGIN || `http://localhost:${port}`).origin;
+if (process.env.NODE_ENV === 'production' && !origin.startsWith('https://')) {
+  throw new Error('Set APP_ORIGIN to the public HTTPS origin in production');
+}
+const secure = origin.startsWith('https://');
+const cookieName = secure ? '__Host-dg_signup' : 'dg_signup';
+const dataDirectory = resolve(process.env.DATA_DIR || './data');
+await mkdir(dataDirectory, { recursive: true, mode: 0o700 });
+const store = createStore(resolve(dataDirectory, 'rewards.sqlite'));
+const template = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+const css = await readFile(new URL('./rewards.css', import.meta.url));
+const js = await readFile(new URL('./rewards.js', import.meta.url));
+const hash = value => createHash('sha256').update(value).digest('hex');
+const scryptAsync = promisify(scrypt);
+const escapeHtml = value => String(value).replace(/[&<>"']/g, char => ({
+  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
+}[char]));
+const rateLimits = new Map();
+function allowed(key, maximum) {
+  const now = Date.now();
+  if (rateLimits.size > 10000) {
+    for (const [entry, value] of rateLimits) if (value.until < now) rateLimits.delete(entry);
+    if (rateLimits.size > 10000) return false;
+  }
+  let entry = rateLimits.get(key);
+  if (!entry || entry.until < now) {
+    entry = { count: 0, until: now + 600000 };
+    rateLimits.set(key, entry);
+  }
+  return ++entry.count <= maximum;
+}
+function send(response, status, body, type = 'text/html; charset=utf-8') {
+  response.writeHead(status, { 'Content-Type': type });
+  response.end(body);
+}
+function page(response, session, { status = 200, message = '', success = false, values = {} } = {}) {
+  const nonce = randomBytes(32).toString('base64url');
+  store.challenge(nonce, hash(session), Math.floor(Date.now() / 1000));
+  const notice = message ? `<div class="form-notice ${success ? 'is-success' : 'is-error'}" role="${success ? 'status' : 'alert'}" tabindex="-1" id="signup-result">${escapeHtml(message)}</div>` : '';
+  const replacements = {
+    '__REWARDS_NONCE__': nonce,
+    '__REWARDS_NOTICE__': notice,
+    '__REWARDS_NAME__': escapeHtml(values.name || ''),
+    '__REWARDS_EMAIL__': escapeHtml(values.email || ''),
+    '__REWARDS_SUCCESS__': success ? 'hidden' : '',
+    '__ORIGIN_TRIAL__': process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL
+      ? `<meta http-equiv="origin-trial" content="${escapeHtml(process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL)}">` : '',
+  };
+  const body = template.replace(/__REWARDS_\w+__|__ORIGIN_TRIAL__/g, key => replacements[key] ?? '');
+  send(response, status, body);
+}
+async function readForm(request) {
+  if (!request.headers['content-type']?.startsWith('application/x-www-form-urlencoded')) {
+    throw new Error('Unsupported form encoding');
+  }
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of request) {
+    size += chunk.length;
+    if (size > 32768) throw new Error('Form too large');
+    chunks.push(chunk);
+  }
+  return new URLSearchParams(Buffer.concat(chunks).toString('utf8'));
+}
+
+const server = createServer(async (request, response) => {
+  response.setHeader('Cache-Control', 'no-store');
+  response.setHeader('X-Content-Type-Options', 'nosniff');
+  response.setHeader('Referrer-Policy', 'same-origin');
+  response.setHeader('Content-Security-Policy', "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://images.unsplash.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'");
+  const url = new URL(request.url, origin);
+  const ip = request.socket.remoteAddress || 'unknown';
+  try {
+    if (request.method === 'GET' && url.pathname === '/rewards.css') return send(response, 200, css, 'text/css; charset=utf-8');
+    if (request.method === 'GET' && url.pathname === '/rewards.js') return send(response, 200, js, 'text/javascript; charset=utf-8');
+    if (url.pathname !== '/' && url.pathname !== '/api/rewards/signup') return send(response, 404, 'Page not found', 'text/plain');
+    if (!['GET', 'POST'].includes(request.method) || (url.pathname === '/' && request.method !== 'GET') ||
+        (url.pathname === '/api/rewards/signup' && request.method !== 'POST')) {
+      return send(response, 405, 'Method not allowed', 'text/plain');
+    }
+    const supplied = request.headers.cookie?.split(';').map(value => value.trim())
+      .find(value => value.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+    const session = supplied && /^[A-Za-z0-9_-]{43}$/.test(supplied) ? supplied : randomBytes(32).toString('base64url');
+    response.setHeader('Set-Cookie', `${cookieName}=${session}; HttpOnly; SameSite=Lax; Path=/; Max-Age=3600${secure ? '; Secure' : ''}`);
+    if (request.method === 'GET') {
+      if (!allowed(`page:${ip}`, 100)) return send(response, 429, 'Please wait a few minutes before trying again.', 'text/plain');
+      return page(response, session);
+    }
+    if (request.headers.origin !== origin || request.headers['sec-fetch-site'] === 'cross-site') {
+      return send(response, 403, 'This form must be submitted from the Daily Grind site.', 'text/plain');
+    }
+    if (!allowed(`signup:${ip}`, 15)) {
+      response.setHeader('Retry-After', '600');
+      return page(response, session, { status: 429, message: 'Too many attempts. Please try again in 10 minutes.' });
+    }
+    let form;
+    try { form = await readForm(request); }
+    catch { return page(response, session, { status: 400, message: 'We could not read your sign-up form. Please try again.' }); }
+    const name = form.get('name')?.trim() || '';
+    const email = form.get('email')?.trim() || '';
+    const password = form.get('password') || '';
+    const nonce = form.get('form_nonce') || '';
+    const token = form.get('email_verification_token') || '';
+    const values = { name, email };
+    const fail = (status, message) => page(response, session, { status, message, values });
+    if (!name || name.length > 100 || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ||
+        password.length < 12 || password.length > 128) {
+      return fail(400, 'Enter your name, a valid email, and a password between 12 and 128 characters.');
+    }
+    if (!store.valid(nonce, hash(session), Math.floor(Date.now() / 1000))) {
+      return fail(400, 'Your sign-up session expired. Re-enter your email and password to try again.');
+    }
+    if (!token) return fail(422, 'Your browser could not verify this email. Use a supported browser, sign in to your email provider in the same browser, then re-enter your email and try again. No account was created and no email was sent.');
+    let verified;
+    try { verified = await verifyEmailOwnership({ token, email, nonce, origin }); }
+    catch { return fail(422, 'We could not confirm ownership of this email. Re-enter your email and try again in a supported browser. No account was created and no email was sent.'); }
+    const salt = randomBytes(16).toString('hex');
+    const derived = await scryptAsync(password, salt, 64);
+    const passwordHash = `scrypt:${salt}:${derived.toString('hex')}`;
+    const created = store.register({
+      nonce, sessionHash: hash(session), now: Math.floor(Date.now() / 1000),
+      id: randomUUID(), email: verified.email, name, passwordHash, issuer: verified.issuer,
+    });
+    if (!created) return fail(409, 'A rewards account already uses this email. Your existing account has not been changed.');
+    return page(response, session, {
+      status: 201, success: true,
+      message: `Welcome to the club, ${name}! Your email is verified and your Daily Grind rewards account is ready.`,
+    });
+  } catch {
+    // Do not log passwords, email addresses, cookies, or verification tokens.
+    send(response, 503, 'Sign-up is temporarily unavailable. Please return to the homepage and try again.', 'text/plain');
+  }
+});
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(port, '0.0.0.0', () => console.log(`Daily Grind listening on port ${port}`));
diff --git a/tests/verification.test.mjs b/tests/verification.test.mjs
new file mode 100644
index 0000000..7361048
--- /dev/null
+++ b/tests/verification.test.mjs
@@ -0,0 +1,99 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { SignJWT, generateKeyPair, exportJWK } from 'jose';
+import { verifyEmailOwnership } from '../lib/verify-email.mjs';
+import { createStore } from '../lib/store.mjs';
+import { publicHttpsUrl } from '../lib/public-json.mjs';
+
+const issuer = await generateKeyPair('EdDSA');
+const browser = await generateKeyPair('ES256');
+const other = await generateKeyPair('ES256');
+const issuerJwk = await exportJWK(issuer.publicKey);
+const browserJwk = await exportJWK(browser.publicKey);
+const origin = 'https://coffee.example';
+const nonce = 'random-session-bound-nonce';
+const email = 'alex@provider.example';
+const now = Math.floor(Date.now() / 1000);
+const dependencies = {
+  txt: async () => [['iss=issuer.example']],
+  json: async url => url.endsWith('/.well-known/email-verification')
+    ? { issuer: 'https://issuer.example', jwks_uri: 'https://keys.example/jwks' }
+    : { keys: [issuerJwk] },
+};
+async function proof({ claims = {}, binding = {}, key = browser.privateKey, signingKey = issuer.privateKey } = {}) {
+  const evt = await new SignJWT({
+    iss: 'https://issuer.example', iat: now, exp: now + 300,
+    cnf: { jwk: browserJwk }, email, email_verified: true, ...claims,
+  }).setProtectedHeader({ typ: 'evt+jwt', alg: 'EdDSA' }).sign(signingKey);
+  const base = `${evt}~`;
+  const kb = await new SignJWT({
+    iat: now, aud: origin, nonce,
+    sd_hash: createHash('sha256').update(base).digest('base64url'), ...binding,
+  }).setProtectedHeader({ typ: 'kb+jwt', alg: 'ES256' }).sign(key);
+  return base + kb;
+}
+const verify = token => verifyEmailOwnership({ token, email, nonce, origin }, dependencies);
+
+test('valid issuer and browser proof verifies, including a JWKS without kid', async () => {
+  assert.deepEqual(await verify(await proof()), { email, issuer: 'https://issuer.example' });
+});
+for (const [description, options] of [
+  ['another email', { claims: { email: 'someone@provider.example' } }],
+  ['email not verified', { claims: { email_verified: false } }],
+  ['expired issuer token', { claims: { iat: now - 600, exp: now - 60 } }],
+  ['missing expiry', { claims: { exp: undefined } }],
+  ['future issuer issuance', { claims: { iat: now + 3600, exp: now + 3900 } }],
+  ['another origin', { binding: { aud: 'https://attacker.example' } }],
+  ['another nonce', { binding: { nonce: 'wrong' } }],
+  ['incorrect sd_hash', { binding: { sd_hash: 'wrong' } }],
+  ['stale browser proof', { binding: { iat: now - 600 } }],
+  ['future browser proof', { binding: { iat: now + 3600 } }],
+  ['wrong browser key', { key: other.privateKey }],
+]) {
+  test(`rejects ${description}`, async () => assert.rejects(() => proof(options).then(verify)));
+}
+test('rejects an invalid issuer signature', async () => {
+  const wrongIssuer = await generateKeyPair('EdDSA');
+  await assert.rejects(() => proof({ signingKey: wrongIssuer.privateKey }).then(verify));
+});
+test('requires browser key binding and does not accept only an issuer JWT', async () => {
+  const token = await proof();
+  await assert.rejects(() => verify(token.slice(0, token.indexOf('~') + 1)));
+});
+test('requires DNS delegation before trusting issuer keys', async () => {
+  await assert.rejects(() => verifyEmailOwnership({ token: '', email, nonce, origin }, dependencies));
+  const token = await proof();
+  await assert.rejects(() => verifyEmailOwnership({ token, email, nonce, origin }, {
+    ...dependencies, txt: async () => [['iss=someone-else.example']],
+  }));
+});
+test('rejects metadata for another issuer', async () => {
+  const token = await proof();
+  await assert.rejects(() => verifyEmailOwnership({ token, email, nonce, origin }, {
+    ...dependencies, json: async () => ({ issuer: 'https://other.example' }),
+  }));
+});
+test('discovery rejects local, non-HTTPS, credentialed, and nonstandard-port URLs', () => {
+  for (const url of ['http://issuer.example', 'https://127.0.0.1', 'https://[::1]',
+    'https://localhost', 'https://user:pass@issuer.example', 'https://issuer.example:8443']) {
+    assert.throws(() => publicHttpsUrl(url));
+  }
+});
+test('registration binds challenges to sessions, expires them, and consumes them atomically', () => {
+  const store = createStore(':memory:');
+  try {
+    store.challenge('nonce', 'session', now);
+    assert.equal(store.valid('nonce', 'another-session', now), false);
+    assert.equal(store.valid('nonce', 'session', now + 601), false);
+    const account = {
+      nonce: 'nonce', sessionHash: 'session', now,
+      id: 'account-1', email, name: 'Alex', passwordHash: 'hashed', issuer: 'https://issuer.example',
+    };
+    assert.equal(store.register(account), true);
+    assert.equal(store.valid('nonce', 'session', now), false);
+    assert.throws(() => store.register({ ...account, id: 'account-2', email: 'new@provider.example' }));
+    store.challenge('second-nonce', 'session', now);
+    assert.equal(store.register({ ...account, nonce: 'second-nonce', id: 'account-3', email: email.toUpperCase() }), false);
+  } finally { store.close(); }
+});
