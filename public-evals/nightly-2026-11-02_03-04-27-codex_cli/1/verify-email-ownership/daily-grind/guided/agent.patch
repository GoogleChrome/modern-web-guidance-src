--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,35 @@
+import { createServer } from 'node:http';
+import { readFile, mkdir } from 'node:fs/promises';
+import { Readable } from 'node:stream';
+import { createApp } from './lib/app.mjs';
+import { createStore } from './lib/store.mjs';
+
+const port = Number(process.env.PORT || 11222);
+const origin = process.env.PUBLIC_ORIGIN || `http://localhost:${port}`;
+const dataDirectory = new URL('./data/', import.meta.url);
+await mkdir(dataDirectory, { recursive: true });
+const store = createStore(process.env.DATABASE_PATH || new URL('rewards.sqlite', dataDirectory).pathname);
+const app = createApp({
+  template: await readFile(new URL('./index.html', import.meta.url), 'utf8'),
+  clientScript: await readFile(new URL('./rewards.js', import.meta.url), 'utf8'),
+  store, origin, originTrialToken: process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL_TOKEN || '',
+});
+
+const server = createServer(async (req, res) => {
+  try {
+    const request = new Request(new URL(req.url, origin), {
+      method: req.method, headers: req.headers,
+      ...(req.method === 'GET' || req.method === 'HEAD' ? {} : { body: Readable.toWeb(req), duplex: 'half' }),
+    });
+    const response = await app(request, { ip: req.socket.remoteAddress });
+    res.writeHead(response.status, Object.fromEntries(response.headers));
+    res.end(Buffer.from(await response.arrayBuffer()));
+  } catch {
+    res.writeHead(500, { 'Content-Type': 'text/plain', 'Cache-Control': 'no-store' });
+    res.end('Something went wrong. Please try again.');
+  }
+});
+server.requestTimeout = 15_000;
+server.headersTimeout = 10_000;
+server.listen(port, '0.0.0.0');
+process.on('SIGTERM', () => server.close(() => { store.close(); process.exit(0); }));
diff --git a/test/rewards.test.mjs b/test/rewards.test.mjs
new file mode 100644
index 0000000..3f00f5d
--- /dev/null
+++ b/test/rewards.test.mjs
@@ -0,0 +1,222 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { generateKeyPair, exportJWK, SignJWT } from 'jose';
+import { createApp } from '../lib/app.mjs';
+import { createStore } from '../lib/store.mjs';
+import { hasher, verifyEmailVerificationToken } from '../lib/verify-email.mjs';
+import { publicJson } from '../lib/public-json.mjs';
+
+const origin = 'https://coffee.example';
+const issuer = 'https://issuer.example';
+const email = 'Customer@example.com';
+const issuerKey = await generateKeyPair('ES256');
+const otherIssuerKey = await generateKeyPair('ES256');
+const holder = await generateKeyPair('ES256');
+const jwk = { ...await exportJWK(holder.publicKey), alg: 'ES256' };
+const issuerJwk = await exportJWK(issuerKey.publicKey);
+const otherIssuerJwk = await exportJWK(otherIssuerKey.publicKey);
+const template = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+const clientScript = await readFile(new URL('../rewards.js', import.meta.url), 'utf8');
+
+const sources = {
+  txt: async (domain) => {
+    assert.equal(domain, '_email-verification.example.com');
+    return [['iss=issuer.', 'example']];
+  },
+  json: async (url) => {
+    if (url === `${issuer}/.well-known/email-verification`) return { issuer, jwks_uri: `${issuer}/keys` };
+    assert.equal(url, `${issuer}/keys`);
+    // No kid, and multiple matching keys: the verifier must try both.
+    return { keys: [otherIssuerJwk, issuerJwk] };
+  },
+};
+
+async function presentation({ nonce = 'fresh-nonce', audience = origin, claimEmail = email,
+  verified = true, age = 0, key = holder.privateKey, sdHash, issuerSigner = issuerKey.privateKey,
+  holderJwk = jwk, holderAge = 0, binding = true } = {}) {
+  const now = Math.floor(Date.now() / 1000);
+  const evt = await new SignJWT({ iss: issuer, email: claimEmail, email_verified: verified,
+    cnf: { jwk: holderJwk }, iat: now - age, exp: now + 300 })
+    .setProtectedHeader({ alg: 'ES256', typ: 'ev+sd-jwt' }).sign(issuerSigner);
+  if (!binding) return `${evt}~`;
+  const kb = await new SignJWT({ nonce, aud: audience, iat: now - holderAge,
+    sd_hash: sdHash || Buffer.from(hasher(`${evt}~`, 'sha-256')).toString('base64url') })
+    .setProtectedHeader({ alg: 'ES256', typ: 'kb+jwt' }).sign(key);
+  return `${evt}~${kb}`;
+}
+
+const verify = (rawToken, expectedNonce = 'fresh-nonce', dependencies = sources) => verifyEmailVerificationToken({
+  rawToken, submittedEmail: email.toLowerCase(), expectedNonce, expectedAudience: origin,
+}, dependencies);
+
+test('verifies issuer signature, holder binding, case-insensitive email, and missing kid', async () => {
+  const payload = await verify(await presentation());
+  assert.equal(payload.email, email);
+  assert.equal(payload.email_verified, true);
+});
+
+for (const [name, options] of [
+  ['wrong nonce', { nonce: 'replayed-nonce' }],
+  ['wrong origin', { audience: 'https://attacker.example' }],
+  ['wrong email', { claimEmail: 'someone-else@example.com' }],
+  ['unverified email', { verified: false }],
+  ['stale issuer token', { age: 600 }],
+  ['stale holder token', { holderAge: 600 }],
+  ['future holder token', { holderAge: -600 }],
+  ['forged issuer signature', { issuerSigner: otherIssuerKey.privateKey }],
+  ['forged holder signature', { key: issuerKey.privateKey }],
+  ['incorrect SD hash', { sdHash: 'tampered' }],
+  ['missing binding', { binding: false }],
+  ['mismatched holder algorithm', { holderJwk: { ...jwk, alg: 'EdDSA' } }],
+]) {
+  test(`rejects ${name}`, async () => {
+    const dependencies = name === 'forged issuer signature'
+      ? { ...sources, json: async (url) => url.endsWith('/keys') ? { keys: [issuerJwk] } : sources.json(url) }
+      : sources;
+    await assert.rejects(verify(await presentation(options), 'fresh-nonce', dependencies));
+  });
+}
+
+test('requires expected nonce and a valid SD-JWT', async () => {
+  await assert.rejects(verify(await presentation(), ''));
+  await assert.rejects(verify('not-a-token'));
+});
+
+test('checks DNS delegation before making any issuer HTTP requests', async () => {
+  let requests = 0;
+  await assert.rejects(verify(await presentation(), 'fresh-nonce', {
+    txt: async () => [['iss=untrusted.example']],
+    json: async () => { requests++; },
+  }));
+  assert.equal(requests, 0);
+});
+
+test('rejects mismatched issuer metadata', async () => {
+  await assert.rejects(verify(await presentation(), 'fresh-nonce', {
+    ...sources, json: async () => ({ issuer: 'https://attacker.example', jwks_uri: `${issuer}/keys` }),
+  }));
+});
+
+test('discovery rejects unsafe URLs and loopback addresses without HTTP requests', async () => {
+  for (const url of ['http://example.com', 'https://user:password@example.com', 'https://example.com:8443', 'https://127.0.0.1/keys', 'https://[::1]/keys']) {
+    await assert.rejects(publicJson(url));
+  }
+});
+
+function setup(t, verifier = (args) => verifyEmailVerificationToken(args, sources)) {
+  const store = createStore();
+  t.after(() => store.close());
+  let saved;
+  const originalCreate = store.createAccount;
+  store.createAccount = (account) => { saved = account; return originalCreate(account); };
+  const app = createApp({ template, clientScript, store, origin, verify: verifier });
+  const get = (path = '/') => app(new Request(new URL(path, origin)));
+  const post = (cookie, token, extra = {}) => app(new Request(`${origin}/api/verify-email`, {
+    method: 'POST', headers: { Origin: origin, Cookie: cookie, ...extra.headers },
+    body: new URLSearchParams({ name: 'Alex Coffee', email, password: 'a-long-unique-password', token, ...extra.fields }),
+  }));
+  return { app, store, get, post, saved: () => saved };
+}
+
+async function formSession(get) {
+  const response = await get();
+  const html = await response.text();
+  return { response, html, cookie: response.headers.get('set-cookie').split(';')[0],
+    nonce: html.match(/nonce="([^"]+)" autocomplete="email-verification-token"/)[1] };
+}
+
+test('renders fresh server nonces with secure cookies and no caching', async (t) => {
+  const { get } = setup(t);
+  const first = await formSession(get);
+  const second = await formSession(get);
+  assert.notEqual(first.nonce, second.nonce);
+  assert.ok(first.nonce.length >= 32);
+  assert.equal(first.response.headers.get('cache-control'), 'no-store');
+  assert.match(first.response.headers.get('set-cookie'), /HttpOnly; Secure; SameSite=Lax/);
+  assert.match(first.html, /autocomplete="new-password"/);
+});
+
+test('real signed token creates a persisted verified account and cannot be replayed', async (t) => {
+  const { get, post, store, saved } = setup(t);
+  const { cookie, nonce } = await formSession(get);
+  const token = await presentation({ nonce });
+  const response = await post(cookie, token);
+  assert.equal(response.status, 303);
+  const html = await (await get(response.headers.get('location'))).text();
+  assert.match(html, /Your email is verified and your rewards account is ready/);
+  assert.match(saved().passwordHash, /^scrypt\$32768\$8\$3\$/);
+  assert.ok(!saved().passwordHash.includes('a-long-unique-password'));
+  assert.equal(store.createAccount({ email: email.toLowerCase(), name: 'Duplicate', passwordHash: 'irrelevant' }), false);
+  const replay = await post(cookie, token);
+  assert.match(await (await get(replay.headers.get('location'))).text(), /expired or was already used/);
+  const replayNotice = await get(response.headers.get('location'));
+  assert.doesNotMatch(await replayNotice.text(), /Your email is verified and your rewards account is ready/);
+});
+
+test('missing token fails safely, preserves escaped values, and consumes nonce', async (t) => {
+  let calls = 0;
+  const { get, post, saved, store } = setup(t, async () => { calls++; });
+  const { cookie } = await formSession(get);
+  const response = await post(cookie, '', { fields: { name: '<script>alert(1)</script>' } });
+  const html = await (await get(response.headers.get('location'))).text();
+  assert.match(html, /No account was created and no verification email was sent/);
+  assert.match(html, /&lt;script&gt;alert\(1\)&lt;\/script&gt;/);
+  assert.doesNotMatch(html, /<script>alert/);
+  assert.equal(calls, 0);
+  assert.equal(saved(), undefined);
+  assert.equal(store.consume(cookie.split('=')[1]), null);
+});
+
+test('invalid signature never creates an account', async (t) => {
+  const { get, post, saved } = setup(t);
+  const { cookie, nonce } = await formSession(get);
+  const response = await post(cookie, await presentation({ nonce, key: issuerKey.privateKey }));
+  assert.match(await (await get(response.headers.get('location'))).text(), /couldn’t verify ownership/);
+  assert.equal(saved(), undefined);
+});
+
+test('cross-origin POST is rejected before consuming the legitimate form', async (t) => {
+  const { get, post, store } = setup(t);
+  const { cookie, nonce } = await formSession(get);
+  assert.equal((await post(cookie, '', { headers: { Origin: 'https://attacker.example' } })).status, 403);
+  assert.equal(store.consume(cookie.split('=')[1]), nonce);
+});
+
+test('server validates all required fields and does not call verifier on invalid data', async (t) => {
+  let calls = 0;
+  const { get, post, saved } = setup(t, async () => { calls++; });
+  for (const fields of [{ password: 'short' }, { email: 'not-an-email' }, { name: '' }]) {
+    const { cookie } = await formSession(get);
+    const response = await post(cookie, 'token', { fields });
+    assert.match(await (await get(response.headers.get('location'))).text(), /Enter your name, a valid email address/);
+  }
+  assert.equal(calls, 0);
+  assert.equal(saved(), undefined);
+});
+
+test('method and route boundaries are enforced', async (t) => {
+  const { get } = setup(t);
+  assert.equal((await get('/api/verify-email')).status, 405);
+  assert.equal((await get('/missing')).status, 404);
+  assert.equal((await get('/rewards.js')).headers.get('content-type'), 'text/javascript; charset=utf-8');
+});
+
+test('expired challenges are deleted and cannot be consumed', (t) => {
+  const store = createStore();
+  t.after(() => store.close());
+  const { id } = store.issue();
+  const now = Date.now();
+  t.mock.method(Date, 'now', () => now + 601_000);
+  assert.equal(store.consume(id), null);
+  assert.equal(store.consume(id), null);
+});
+
+test('origin trial header is configurable and insecure public origins are rejected', async (t) => {
+  const store = createStore();
+  t.after(() => store.close());
+  const app = createApp({ template, clientScript, store, origin, originTrialToken: 'configured-trial-token' });
+  const response = await app(new Request(origin));
+  assert.equal(response.headers.get('origin-trial'), 'configured-trial-token');
+  assert.throws(() => createApp({ template, clientScript, store, origin: 'http://coffee.example' }), /HTTPS/);
+});
