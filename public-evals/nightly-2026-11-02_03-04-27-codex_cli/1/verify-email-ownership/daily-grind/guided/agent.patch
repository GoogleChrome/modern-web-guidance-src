+++ b/lib/app.mjs
@@ -0,0 +1,109 @@
+import { randomBytes, scrypt } from 'node:crypto';
+import { promisify } from 'node:util';
+import { verifyEmailVerificationToken } from './verify-email.mjs';
+
+const deriveKey = promisify(scrypt);
+const escape = (value) => String(value).replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
+const cookieName = '__Host-dg-registration';
+
+async function readForm(request) {
+  if (!request.headers.get('content-type')?.startsWith('application/x-www-form-urlencoded')) throw new Error('Invalid form encoding');
+  if (!request.body) throw new Error('Missing body');
+  const reader = request.body.getReader();
+  let size = 0;
+  const chunks = [];
+  while (true) {
+    const { value, done } = await reader.read();
+    if (done) break;
+    size += value.length;
+    if (size > 48 * 1024) { await reader.cancel(); throw new Error('Form too large'); }
+    chunks.push(value);
+  }
+  return new URLSearchParams(Buffer.concat(chunks).toString('utf8'));
+}
+
+export function createApp({ template, clientScript, store, origin, originTrialToken = '', verify = verifyEmailVerificationToken }) {
+  const expectedOrigin = new URL(origin).origin;
+  if (expectedOrigin !== origin) throw new Error('PUBLIC_ORIGIN must be an exact origin without a trailing slash');
+  const publicUrl = new URL(origin);
+  if (publicUrl.protocol !== 'https:' && !(publicUrl.protocol === 'http:' && ['localhost', '127.0.0.1', '[::1]'].includes(publicUrl.hostname))) {
+    throw new Error('PUBLIC_ORIGIN must use HTTPS (except loopback development origins)');
+  }
+  const limits = new Map();
+  function limited(ip, action, max) {
+    const now = Date.now();
+    for (const [key, entry] of limits) if (entry.expires <= now) limits.delete(key);
+    const key = `${ip}:${action}`;
+    const entry = limits.get(key) || { count: 0, expires: now + 60_000 };
+    entry.count++;
+    limits.set(key, entry);
+    return entry.count > max;
+  }
+  const headers = {
+    'Cache-Control': 'no-store',
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'no-referrer',
+    'Content-Security-Policy': "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://images.unsplash.com; script-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
+  };
+  const text = (body, status) => new Response(body, { status, headers });
+  const redirect = (notice) => new Response(null, { status: 303, headers: {
+    ...headers, Location: `/?registration=${store.notice(notice)}#rewards`,
+  } });
+
+  return async function handleRequest(request, { ip = 'local' } = {}) {
+    const url = new URL(request.url);
+    if (request.method === 'GET' && url.pathname === '/rewards.js') {
+      return new Response(clientScript, { headers: { ...headers, 'Content-Type': 'text/javascript; charset=utf-8' } });
+    }
+    if (request.method === 'GET' && (url.pathname === '/' || url.pathname === '/index.html')) {
+      if (limited(ip, 'page', 60)) return text('Too many requests. Please try again in a minute.', 429);
+      const { id, nonce } = store.issue();
+      const notice = store.consumeNotice(url.searchParams.get('registration'));
+      const message = notice ? `<div id="registration-status" class="form-status ${notice.kind === 'success' ? 'success' : 'error'}" role="${notice.kind === 'success' ? 'status' : 'alert'}" tabindex="-1">${escape(notice.message)}</div>` : '';
+      const html = template.replace('nonce="" autocomplete="email-verification-token"', `nonce="${nonce}" autocomplete="email-verification-token"`)
+        .replace('<!--REWARDS_NOTICE-->', message)
+        .replace('id="signup-name"', `id="signup-name" value="${escape(notice?.name || '')}"`)
+        .replace('id="signup-email"', `id="signup-email" value="${escape(notice?.email || '')}"`);
+      return new Response(html, { headers: {
+        ...headers, 'Content-Type': 'text/html; charset=utf-8',
+        'Set-Cookie': `${cookieName}=${id}; HttpOnly; Secure; SameSite=Lax; Path=/; Max-Age=600`,
+        ...(originTrialToken ? { 'Origin-Trial': originTrialToken } : {}),
+      } });
+    }
+    if (url.pathname !== '/api/verify-email') return text('Page not found.', 404);
+    if (request.method !== 'POST') return new Response('Use POST to register.', { status: 405, headers: { ...headers, Allow: 'POST' } });
+    if (request.headers.get('origin') !== expectedOrigin || request.headers.get('sec-fetch-site') === 'cross-site') {
+      return text('Please submit the form from the Daily Grind homepage.', 403);
+    }
+    const sessionId = request.headers.get('cookie')?.split(';').map((part) => part.trim()).find((part) => part.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+    // Consume before parsing, rate limiting, or any asynchronous verification.
+    const expectedNonce = store.consume(sessionId);
+    if (limited(ip, 'registration', 10)) return text('Too many attempts. Please try again in a minute.', 429);
+    if (!expectedNonce) return redirect({ kind: 'error', message: 'Your sign-up session expired or was already used. Please try again below.' });
+    let form;
+    try { form = await readForm(request); }
+    catch { return redirect({ kind: 'error', message: 'We couldn’t read your sign-up form. Please try again below.' }); }
+    const name = (form.get('name') || '').trim();
+    const email = (form.get('email') || '').trim();
+    const password = form.get('password') || '';
+    const rawToken = (form.get('token') || '').trim();
+    const error = (message) => redirect({ kind: 'error', message, name: name.slice(0, 100), email: email.slice(0, 254) });
+    if (!name || name.length > 100 || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || password.length < 12 || password.length > 128) {
+      return error('Enter your name, a valid email address, and a password between 12 and 128 characters.');
+    }
+    if (!rawToken) return error('Your browser couldn’t verify this email. Use a supported browser and an email account you’re signed into, then try again. No account was created and no verification email was sent.');
+    try { await verify({ rawToken, submittedEmail: email, expectedNonce, expectedAudience: expectedOrigin }); }
+    catch {
+      return error('We couldn’t verify ownership of this email. Please check the address and try again. No account was created and no verification email was sent.');
+    }
+    try {
+      const salt = randomBytes(16).toString('hex');
+      const hash = await deriveKey(password, salt, 64, { N: 32768, r: 8, p: 3, maxmem: 64 * 1024 * 1024 });
+      const created = store.createAccount({ email, name, passwordHash: `scrypt$32768$8$3$${salt}$${hash.toString('hex')}` });
+      if (!created) return error('A rewards account already uses this email address. Your existing account has not changed.');
+    } catch {
+      return error('We couldn’t save your account right now. Please try again in a moment.');
+    }
+    return redirect({ kind: 'success', message: `Welcome to the club, ${name}! Your email is verified and your rewards account is ready.` });
+  };
+}
diff --git a/lib/public-json.mjs b/lib/public-json.mjs
new file mode 100644
index 0000000..f2fa7f1
--- /dev/null
+++ b/lib/public-json.mjs
@@ -0,0 +1,48 @@
+import { lookup } from 'node:dns/promises';
+import { request } from 'node:https';
+import ipaddr from 'ipaddr.js';
+
+// Pin the connection to a checked public address. Reject redirects, local IPs,
+// credentials, and nonstandard ports, including for issuer-controlled JWKS URLs.
+export async function publicJson(address) {
+  const url = new URL(address);
+  if (url.protocol !== 'https:' || url.port || url.username || url.password || url.hash) {
+    throw new Error('Unsafe issuer URL');
+  }
+  const hostname = url.hostname.replace(/^\[|\]$/g, '');
+  const addresses = await lookup(hostname, { all: true });
+  if (!addresses.length || addresses.some(({ address }) => ipaddr.process(address).range() !== 'unicast')) {
+    throw new Error('Issuer must use public addresses');
+  }
+  const target = addresses[0];
+  return new Promise((resolve, reject) => {
+    const req = request(url, {
+      method: 'GET',
+      agent: false,
+      headers: { Accept: 'application/json' },
+      lookup: (_hostname, options, callback) => options.all
+        ? callback(null, [target]) : callback(null, target.address, target.family),
+      signal: AbortSignal.timeout(5000),
+    }, (res) => {
+      if (res.statusCode !== 200) {
+        res.resume();
+        reject(new Error('Issuer discovery failed'));
+        return;
+      }
+      let size = 0;
+      const chunks = [];
+      res.on('data', (chunk) => {
+        size += chunk.length;
+        if (size > 128 * 1024) res.destroy(new Error('Issuer response too large'));
+        else chunks.push(chunk);
+      });
+      res.on('error', reject);
+      res.on('end', () => {
+        try { resolve(JSON.parse(Buffer.concat(chunks).toString('utf8'))); }
+        catch (error) { reject(error); }
+      });
+    });
+    req.on('error', reject);
+    req.end();
+  });
+}
diff --git a/lib/store.mjs b/lib/store.mjs
new file mode 100644
index 0000000..a3c6cf3
--- /dev/null
+++ b/lib/store.mjs
@@ -0,0 +1,43 @@
+import { DatabaseSync } from 'node:sqlite';
+import { randomBytes, randomUUID } from 'node:crypto';
+
+export function createStore(filename = ':memory:') {
+  const db = new DatabaseSync(filename);
+  db.exec(`PRAGMA journal_mode=WAL;
+    CREATE TABLE IF NOT EXISTS challenges (id TEXT PRIMARY KEY, nonce TEXT NOT NULL, expires INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS accounts (
+      id TEXT PRIMARY KEY, email TEXT NOT NULL, email_key TEXT NOT NULL UNIQUE,
+      name TEXT NOT NULL, password_hash TEXT NOT NULL, verified_at TEXT NOT NULL
+    );
+    CREATE TABLE IF NOT EXISTS notices (id TEXT PRIMARY KEY, content TEXT NOT NULL, expires INTEGER NOT NULL);`);
+  return {
+    issue() {
+      db.prepare('DELETE FROM challenges WHERE expires <= ?').run(Date.now());
+      const id = randomBytes(32).toString('base64url');
+      const nonce = randomBytes(32).toString('base64url');
+      db.prepare('INSERT INTO challenges VALUES (?, ?, ?)').run(id, nonce, Date.now() + 600_000);
+      return { id, nonce };
+    },
+    consume(id) {
+      // DELETE RETURNING is a single atomic statement, including across processes.
+      const row = db.prepare('DELETE FROM challenges WHERE id = ? RETURNING nonce, expires').get(id || '');
+      return row && row.expires > Date.now() ? row.nonce : null;
+    },
+    createAccount({ email, name, passwordHash }) {
+      const result = db.prepare(`INSERT INTO accounts VALUES (?, ?, ?, ?, ?, ?)
+        ON CONFLICT(email_key) DO NOTHING`).run(randomUUID(), email, email.toLowerCase(), name, passwordHash, new Date().toISOString());
+      return result.changes === 1;
+    },
+    notice(content) {
+      db.prepare('DELETE FROM notices WHERE expires <= ?').run(Date.now());
+      const id = randomBytes(32).toString('base64url');
+      db.prepare('INSERT INTO notices VALUES (?, ?, ?)').run(id, JSON.stringify(content), Date.now() + 600_000);
+      return id;
+    },
+    consumeNotice(id) {
+      const row = db.prepare('DELETE FROM notices WHERE id = ? RETURNING content, expires').get(id || '');
+      return row && row.expires > Date.now() ? JSON.parse(row.content) : null;
+    },
+    close() { db.close(); },
+  };
+}
diff --git a/lib/verify-email.mjs b/lib/verify-email.mjs
new file mode 100644
index 0000000..fa1d2d8
--- /dev/null
+++ b/lib/verify-email.mjs
@@ -0,0 +1,84 @@
+import { createHash } from 'node:crypto';
+import { resolveTxt } from 'node:dns/promises';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { createLocalJWKSet, importJWK, jwtVerify } from 'jose';
+import { publicJson } from './public-json.mjs';
+
+const ALGORITHMS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalize = (alg) => alg === 'Ed25519' ? 'EdDSA' : alg;
+export const hasher = (data, algorithm) => {
+  const alg = { 'sha-256': 'sha256', 'sha-384': 'sha384', 'sha-512': 'sha512' }[algorithm];
+  if (!alg) throw new Error('Unsupported disclosure hash');
+  return createHash(alg).update(data).digest();
+};
+
+export async function verifyEmailVerificationToken({ rawToken, submittedEmail, expectedNonce, expectedAudience },
+  { txt = resolveTxt, json = publicJson } = {}) {
+  if (!expectedNonce || !rawToken || rawToken.length > 32768) throw new Error('Missing verification');
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const payload = decoded.jwt?.payload;
+  const issuer = payload?.iss;
+  if (!decoded.kbJwt || typeof issuer !== 'string') throw new Error('Missing issuer or key binding');
+  const domain = submittedEmail.split('@')[1]?.toLowerCase();
+  if (!domain || !/^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/.test(domain)) {
+    throw new Error('Invalid email domain');
+  }
+  const issuerUrl = new URL(issuer);
+  if (issuerUrl.protocol !== 'https:' || issuerUrl.origin !== issuer || issuerUrl.port || issuerUrl.username || issuerUrl.password) {
+    throw new Error('Invalid issuer origin');
+  }
+  // Establish authority before any issuer-controlled HTTP request.
+  const records = (await txt(`_email-verification.${domain}`)).map((record) => record.join(''));
+  if (!records.some((record) => record.startsWith('iss=') && `https://${record.slice(4).trim()}` === issuer)) {
+    throw new Error('Issuer not delegated by email domain');
+  }
+  const metadata = await json(`${issuer}/.well-known/email-verification`);
+  if (metadata.issuer !== issuer || typeof metadata.jwks_uri !== 'string') throw new Error('Invalid issuer metadata');
+  const keys = createLocalJWKSet(await json(metadata.jwks_uri));
+  const issuerOptions = {
+    issuer, typ: 'ev+sd-jwt', algorithms: ALGORITHMS,
+    maxTokenAge: '5m', clockTolerance: 60,
+  };
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    allowedDisclosureHashAlgorithms: ['sha-256', 'sha-384', 'sha-512'],
+    verifier: async (data, signature) => {
+      const token = `${data}.${signature}`;
+      try { await jwtVerify(token, keys, issuerOptions); }
+      catch (error) {
+        if (error.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw error;
+        let matched = false;
+        for await (const key of error) {
+          try { await jwtVerify(token, key, issuerOptions); matched = true; break; }
+          catch { /* Try other candidate keys when the issuer omits kid. */ }
+        }
+        if (!matched) throw error;
+      }
+      return true;
+    },
+    kbVerifier: async (data, signature) => {
+      const jwk = payload.cnf?.jwk;
+      const alg = decoded.kbJwt.header.alg;
+      if (!jwk || jwk.d || jwk.k || !ALGORITHMS.includes(jwk.alg) || !ALGORITHMS.includes(alg) || normalize(jwk.alg) !== normalize(alg)) {
+        throw new Error('Invalid holder key or algorithm');
+      }
+      await jwtVerify(`${data}.${signature}`, await importJWK(jwk, alg), {
+        typ: 'kb+jwt', audience: expectedAudience, algorithms: [alg],
+        maxTokenAge: '5m', clockTolerance: 60,
+      });
+      return true;
+    },
+  });
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+  if (verified.payload.email_verified !== true || typeof verified.payload.email !== 'string' ||
+      verified.payload.email.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Email ownership does not match');
+  }
+  return verified.payload;
+}
