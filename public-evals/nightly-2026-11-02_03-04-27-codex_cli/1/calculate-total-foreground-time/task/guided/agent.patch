+  <script>
+    // Start the fallback early; browsers without visibility history can only
+    // measure time from this script's execution onward.
+    (() => {
+      let foregroundTime = 0;
+      let visibleSince = document.visibilityState === 'visible' ? performance.now() : null;
+
+      document.addEventListener('visibilitychange', () => {
+        const now = performance.now();
+        if (document.visibilityState === 'visible') {
+          if (visibleSince === null) visibleSince = now;
+        } else if (visibleSince !== null) {
+          foregroundTime += now - visibleSince;
+          visibleSince = null;
+        }
+      });
+
+      /**
+       * Total visible page time in milliseconds, including the current interval.
+       * Visibility measures foreground time, not attention or user activity.
+       * Without visibility history, measurement starts when this script runs.
+       * @returns {number}
+       */
+      window.getTotalForegroundTime = function getTotalForegroundTime() {
+        const entries = performance.getEntriesByType('visibility-state');
+        const now = performance.now();
+
+        if (entries.length === 0) {
+          return foregroundTime + (visibleSince === null ? 0 : now - visibleSince);
+        }
+
+        let total = 0;
+        for (let i = 0; i < entries.length; i++) {
+          if (entries[i].name === 'visible') {
+            const end = i + 1 < entries.length ? entries[i + 1].startTime : now;
+            total += end - entries[i].startTime;
+          }
+        }
+        return total;
+      };
+    })();
+  </script>
