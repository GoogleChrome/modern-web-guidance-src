@@ -0,0 +1,34 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRecipient, encryptNote, decryptNote } from '../src/encryption.js';
+
+test('hybrid envelope round trip preserves Unicode and uses fresh encryption', async () => {
+  const recipient = createRecipient();
+  const text = 'Quiet knock. Gate: 0123 ☕ 门口';
+  const first = await encryptNote(recipient.publicKey, text);
+  const second = await encryptNote(recipient.publicKey, text);
+  assert.equal(await decryptNote(recipient.secretKey, first), text);
+  assert.equal(await decryptNote(recipient.secretKey, second), text);
+  for (const field of ['iv', 'salt', 'capsule', 'ciphertext']) assert.notDeepEqual(first[field], second[field]);
+  assert.equal(JSON.stringify(first).includes(text), false);
+});
+test('rejects tampered ciphertext, capsule, IV, salt, metadata and wrong recipient', async () => {
+  const recipient = createRecipient();
+  const note = await encryptNote(recipient.publicKey, 'Side door, please.');
+  for (const field of ['ciphertext', 'capsule', 'iv', 'salt']) {
+    const altered = structuredClone(note);
+    altered[field][0] ^= 1;
+    await assert.rejects(decryptNote(recipient.secretKey, altered));
+  }
+  for (const field of ['id', 'createdAt', 'suite', 'version']) {
+    const altered = structuredClone(note);
+    altered[field] = field === 'version' ? 2 : 'altered';
+    await assert.rejects(decryptNote(recipient.secretKey, altered));
+  }
+  await assert.rejects(decryptNote(createRecipient().secretKey, note));
+});
+test('rejects empty and oversized notes', async () => {
+  const recipient = createRecipient();
+  await assert.rejects(encryptNote(recipient.publicKey, '  '));
+  await assert.rejects(encryptNote(recipient.publicKey, 'x'.repeat(1001)));
+});
