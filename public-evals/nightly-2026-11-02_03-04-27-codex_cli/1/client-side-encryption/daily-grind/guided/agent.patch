--- /dev/null
+++ b/src/notes.js
@@ -0,0 +1,101 @@
+import { encryptNote, decryptNote } from './encryption.js';
+import { openVault, read, write, recipient, unlockRecipient } from './storage.js';
+
+const $ = (id) => document.getElementById(id);
+const form = $('note-form');
+const input = $('delivery-note');
+const status = $('note-status');
+let db, keys, saved, busy = false, hideTimer;
+function message(text, error = false) {
+  status.textContent = text;
+  status.classList.toggle('error', error);
+}
+function hideNote() {
+  clearTimeout(hideTimer);
+  $('revealed-note').textContent = '';
+  $('revealed-note').hidden = true;
+  $('reveal-note').textContent = 'Reveal note';
+  $('reveal-note').setAttribute('aria-expanded', 'false');
+}
+function render() {
+  hideNote();
+  $('saved-note').hidden = !saved;
+  $('save-note').textContent = saved ? 'Encrypt & replace note' : 'Encrypt & save note';
+  if (saved) $('saved-time').textContent = `Saved ${new Date(saved.createdAt).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' })}`;
+}
+function count() { $('note-count').textContent = `${input.value.length} / 1,000`; }
+input.addEventListener('input', count);
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (busy) return;
+  if (!input.value.trim()) { message('Please enter a delivery note.', true); input.focus(); return; }
+  busy = true;
+  $('note-controls').disabled = true;
+  message('Encrypting your note…');
+  try {
+    const encrypted = await encryptNote(keys.publicKey, input.value);
+    await write(db, 'note', encrypted);
+    saved = encrypted;
+    input.value = '';
+    count(); render();
+    message('Your note is encrypted and saved on this device.');
+  } catch { message('Your note could not be saved. Your draft is still here; please try again.', true); }
+  finally { busy = false; $('note-controls').disabled = false; }
+});
+async function plaintext() {
+  const secret = await unlockRecipient(keys);
+  try { return await decryptNote(secret, saved); }
+  finally { secret.fill(0); }
+}
+$('reveal-note').addEventListener('click', async () => {
+  if (!$('revealed-note').hidden) { hideNote(); return; }
+  if (busy) return;
+  busy = true;
+  try {
+    const text = await plaintext();
+    if (document.hidden) return;
+    $('revealed-note').textContent = text;
+    $('revealed-note').hidden = false;
+    $('reveal-note').textContent = 'Hide note';
+    $('reveal-note').setAttribute('aria-expanded', 'true');
+    hideTimer = setTimeout(hideNote, 30000);
+    message('Note revealed. It will hide automatically in 30 seconds.');
+  } catch { message('This note could not be authenticated. It has not been displayed.', true); }
+  finally { busy = false; }
+});
+$('edit-note').addEventListener('click', async () => {
+  if (busy) return;
+  busy = true;
+  try {
+    const text = await plaintext();
+    if (document.hidden) return;
+    input.value = text; hideNote(); count(); input.focus();
+    message('Edit your note, then encrypt and save it again.');
+  }
+  catch { message('This note could not be authenticated. It has not been opened.', true); }
+  finally { busy = false; }
+});
+$('delete-note').addEventListener('click', async () => {
+  if (busy) return;
+  busy = true;
+  try {
+    await write(db, 'note', undefined);
+    saved = undefined; input.value = ''; count(); render();
+    message('Your saved note and draft have been deleted.');
+  } catch { message('The note could not be deleted. Please try again.', true); }
+  finally { busy = false; }
+});
+document.addEventListener('visibilitychange', () => { if (document.hidden) { hideNote(); input.value = ''; count(); } });
+window.addEventListener('pagehide', () => { hideNote(); input.value = ''; });
+async function init() {
+  try {
+    if (!globalThis.isSecureContext || !crypto?.subtle || !globalThis.indexedDB) throw new Error('Unsupported');
+    db = await openVault();
+    keys = await recipient(db);
+    saved = await read(db, 'note');
+    render();
+    $('note-controls').disabled = false;
+    message('Ready to keep your delivery details private.');
+  } catch { message('Private notes are unavailable. Use HTTPS and allow browser storage to enable encryption.', true); }
+}
+init();
diff --git a/src/storage.js b/src/storage.js
new file mode 100644
index 0000000..6b62834
--- /dev/null
+++ b/src/storage.js
@@ -0,0 +1,61 @@
+import { createRecipient } from './encryption.js';
+
+export function openVault() {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open('daily-grind-private-notes', 1);
+    request.onupgradeneeded = () => request.result.createObjectStore('vault');
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+    request.onblocked = () => reject(new Error('Storage blocked'));
+  });
+}
+export function read(db, key) {
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction('vault', 'readonly');
+    const request = tx.objectStore('vault').get(key);
+    tx.oncomplete = () => resolve(request.result);
+    tx.onerror = tx.onabort = () => reject(tx.error);
+  });
+}
+export function write(db, key, value) {
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction('vault', 'readwrite');
+    if (value === undefined) tx.objectStore('vault').delete(key);
+    else tx.objectStore('vault').put(value, key);
+    tx.oncomplete = () => resolve();
+    tx.onerror = tx.onabort = () => reject(tx.error);
+  });
+}
+export async function recipient(db) {
+  // Serialize initialization across tabs so existing notes never lose their recipient key.
+  const existing = await read(db, 'recipient');
+  if (existing) return existing;
+  const pair = createRecipient();
+  try {
+    const wrappingKey = await crypto.subtle.generateKey({ name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']);
+    const iv = crypto.getRandomValues(new Uint8Array(12));
+    const encryptedSecret = await crypto.subtle.encrypt(
+      { name: 'AES-GCM', iv, additionalData: new TextEncoder().encode('daily-grind/recipient/v1') },
+      wrappingKey, pair.secretKey,
+    );
+    const candidate = { publicKey: pair.publicKey, wrappingKey, iv, encryptedSecret };
+    return await new Promise((resolve, reject) => {
+      const tx = db.transaction('vault', 'readwrite');
+      const store = tx.objectStore('vault');
+      const request = store.get('recipient');
+      let result;
+      request.onsuccess = () => {
+        result = request.result || candidate;
+        if (!request.result) store.put(candidate, 'recipient');
+      };
+      tx.oncomplete = () => resolve(result);
+      tx.onerror = tx.onabort = () => reject(tx.error);
+    });
+  } finally { pair.secretKey.fill(0); }
+}
+export async function unlockRecipient(record) {
+  return new Uint8Array(await crypto.subtle.decrypt(
+    { name: 'AES-GCM', iv: record.iv, additionalData: new TextEncoder().encode('daily-grind/recipient/v1') },
+    record.wrappingKey, record.encryptedSecret,
+  ));
+}
