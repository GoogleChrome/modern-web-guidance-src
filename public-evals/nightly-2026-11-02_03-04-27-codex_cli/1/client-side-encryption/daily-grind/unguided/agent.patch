+    document.querySelector('#saved-description').textContent = `${labels[mode]} · AES-256-GCM · This tab only`;
+    note.value = ''; document.querySelector('#counter').textContent = '0 / 500';
+    announce('Your note is encrypted and saved in this tab. It has not been sent.');
+  } catch { destroyRecipient(recipient); announce('Could not encrypt your note. Use HTTPS or localhost and try again. Your draft is still here.', true); }
+  finally { busy = false; saveButton.disabled = false; }
+});
+viewButton.addEventListener('click', async () => {
+  if (!saved) return;
+  if (!plaintext.hidden) { hidePlaintext(); return; }
+  const current = saved;
+  try {
+    const text = await decryptNote(current.envelope, current.recipient);
