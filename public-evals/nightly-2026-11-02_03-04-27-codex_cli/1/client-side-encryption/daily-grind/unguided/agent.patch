+import { createRecipient, encryptNote, decryptNote, destroyRecipient, labels } from './crypto.js';
+const icons = {
+  lock: '<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4m-4 5v2"/>',
+  shield: '<path d="M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6L12 2Z"/><path d="m8 12 3 3 5-6"/>',
+  key: '<circle cx="8" cy="8" r="4"/><path d="m11 11 10 10m-3-3 3-3m-6 0 3-3"/>'
+};
+document.querySelectorAll('[data-icon]').forEach(el => { el.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true">${icons[el.dataset.icon]}</svg>`; });
+const form = document.querySelector('#note-form');
+const note = document.querySelector('#note');
+const status = document.querySelector('#status');
+const saveButton = document.querySelector('#save-button');
+const savedPanel = document.querySelector('#saved-note');
+const viewButton = document.querySelector('#view-note');
+const plaintext = document.querySelector('#decrypted-note');
+let saved = null, busy = false;
+function announce(message, error = false) { status.textContent = message; status.classList.toggle('error', error); }
+function hidePlaintext() { plaintext.textContent = ''; plaintext.hidden = true; viewButton.textContent = 'View note'; }
+note.addEventListener('input', () => { document.querySelector('#counter').textContent = `${note.value.length} / 500`; });
+document.querySelector('#learn-button').addEventListener('click', event => {
+  const details = document.querySelector('#security-details');
+  details.hidden = !details.hidden;
+  event.currentTarget.setAttribute('aria-expanded', String(!details.hidden));
+});
+form.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  if (!note.value.trim()) { announce('Add a delivery note before encrypting.', true); note.focus(); return; }
+  busy = true; saveButton.disabled = true; announce('Establishing a shared secret and encrypting your note…');
