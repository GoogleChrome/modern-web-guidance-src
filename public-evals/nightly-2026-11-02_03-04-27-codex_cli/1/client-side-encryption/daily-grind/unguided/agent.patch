@@ -0,0 +1,34 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createRecipient, encryptNote, decryptNote, destroyRecipient } from './crypto.js';
+
+for (const mode of ['hybrid', 'pq', 'classical']) {
+  test(`${mode}: authenticated round trip, fresh encryption, and wrong recipient rejection`, async () => {
+    const recipient = await createRecipient(mode);
+    const other = await createRecipient(mode);
+    try {
+      const message = 'Gate 1234 · Please knock quietly ☕';
+      const first = await encryptNote(message, recipient);
+      const second = await encryptNote(message, recipient);
+      assert.equal(await decryptNote(first, recipient), message);
+      assert.notEqual(first.iv, second.iv);
+      assert.notEqual(first.ciphertext, second.ciphertext);
+      assert.ok(!JSON.stringify(first).includes(message));
+      await assert.rejects(decryptNote(first, other));
+      for (const field of ['ciphertext', 'iv', 'salt']) {
+        const raw = Buffer.from(first[field], 'base64');
+        raw[0] ^= 1;
+        await assert.rejects(decryptNote({ ...first, [field]: raw.toString('base64') }, recipient));
+      }
+      const header = JSON.parse(first.header);
+      const encapsulation = Buffer.from(header.encapsulation, 'base64');
+      encapsulation[0] ^= 1;
+      header.encapsulation = encapsulation.toString('base64');
+      await assert.rejects(decryptNote({ ...first, header: JSON.stringify(header) }, recipient));
+      await assert.rejects(decryptNote({ ...first, header: first.header.replace('note-v1', 'note-v2') }, recipient));
+    } finally { destroyRecipient(recipient); destroyRecipient(other); }
+  });
+}
+test('Unknown protection schemes fail closed', async () => {
+  await assert.rejects(createRecipient('invalid'));
+});
