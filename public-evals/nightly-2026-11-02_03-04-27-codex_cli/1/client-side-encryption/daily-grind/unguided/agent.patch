+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+import { ml_kem768_x25519 } from '@noble/post-quantum/hybrid.js';
+
+const encoder = new TextEncoder();
+const schemes = { hybrid: ml_kem768_x25519, pq: ml_kem768 };
+export const labels = { hybrid: 'Hybrid · ML-KEM-768 + X25519', pq: 'Post-quantum · ML-KEM-768', classical: 'Classical · ECDH P-256' };
+const b64 = bytes => btoa(String.fromCharCode(...bytes));
+const bytes = value => Uint8Array.from(atob(value), c => c.charCodeAt(0));
+
+// Local demonstration recipient. Private keys never leave this tab's memory.
+export async function createRecipient(mode) {
+  if (!crypto.subtle) throw new Error('Encryption requires HTTPS or localhost.');
+  if (!labels[mode]) throw new Error('Unknown protection option.');
+  if (mode === 'classical') {
+    const pair = await crypto.subtle.generateKey({ name: 'ECDH', namedCurve: 'P-256' }, false, ['deriveBits']);
+    return { mode, publicKey: new Uint8Array(await crypto.subtle.exportKey('raw', pair.publicKey)), privateKey: pair.privateKey };
+  }
+  const pair = schemes[mode].keygen();
+  return { mode, publicKey: pair.publicKey, privateKey: pair.secretKey };
+}
+async function aesKey(secret, salt, header) {
+  const input = await crypto.subtle.importKey('raw', secret, 'HKDF', false, ['deriveKey']);
+  const info = await crypto.subtle.digest('SHA-256', encoder.encode(header));
+  return crypto.subtle.deriveKey({ name: 'HKDF', hash: 'SHA-256', salt, info }, input, { name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']);
+}
+export async function encryptNote(text, recipient) {
+  let secret, encapsulation;
+  if (recipient.mode === 'classical') {
+    const ephemeral = await crypto.subtle.generateKey({ name: 'ECDH', namedCurve: 'P-256' }, false, ['deriveBits']);
+    const publicKey = await crypto.subtle.importKey('raw', recipient.publicKey, { name: 'ECDH', namedCurve: 'P-256' }, false, []);
+    secret = new Uint8Array(await crypto.subtle.deriveBits({ name: 'ECDH', public: publicKey }, ephemeral.privateKey, 256));
+    encapsulation = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+  } else {
+    const result = schemes[recipient.mode].encapsulate(recipient.publicKey);
+    secret = result.sharedSecret; encapsulation = result.cipherText;
+  }
+  const salt = crypto.getRandomValues(new Uint8Array(32));
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  // Bind protocol, algorithm, recipient and encapsulation to both the KDF and authentication tag.
+  const header = JSON.stringify({ protocol: 'daily-grind-note-v1', mode: recipient.mode, recipient: b64(recipient.publicKey), encapsulation: b64(encapsulation) });
+  try {
+    const key = await aesKey(secret, salt, header);
+    const ciphertext = await crypto.subtle.encrypt({ name: 'AES-GCM', iv, additionalData: encoder.encode(header), tagLength: 128 }, key, encoder.encode(text));
+    return { header, salt: b64(salt), iv: b64(iv), ciphertext: b64(new Uint8Array(ciphertext)) };
+  } finally { secret.fill(0); }
+}
+export async function decryptNote(envelope, recipient) {
+  const header = JSON.parse(envelope.header);
+  if (header.protocol !== 'daily-grind-note-v1' || header.mode !== recipient.mode || header.recipient !== b64(recipient.publicKey)) throw new Error('Recipient mismatch.');
+  let secret;
+  if (recipient.mode === 'classical') {
+    const publicKey = await crypto.subtle.importKey('raw', bytes(header.encapsulation), { name: 'ECDH', namedCurve: 'P-256' }, false, []);
+    secret = new Uint8Array(await crypto.subtle.deriveBits({ name: 'ECDH', public: publicKey }, recipient.privateKey, 256));
+  } else secret = schemes[recipient.mode].decapsulate(bytes(header.encapsulation), recipient.privateKey);
+  try {
+    const key = await aesKey(secret, bytes(envelope.salt), envelope.header);
+    const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: bytes(envelope.iv), additionalData: encoder.encode(envelope.header), tagLength: 128 }, key, bytes(envelope.ciphertext));
+    return new TextDecoder().decode(plain);
+  } finally { secret.fill(0); }
+}
+export function destroyRecipient(recipient) { if (recipient?.privateKey instanceof Uint8Array) recipient.privateKey.fill(0); }
