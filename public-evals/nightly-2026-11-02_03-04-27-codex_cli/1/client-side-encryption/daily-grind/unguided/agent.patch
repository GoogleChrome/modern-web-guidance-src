+  } catch { announce('The note could not be authenticated. Its contents have not been displayed.', true); }
+});
+document.querySelector('#delete-note').addEventListener('click', () => {
+  destroyRecipient(saved?.recipient); saved = null; hidePlaintext(); savedPanel.hidden = true; announce('Your encrypted note and its recipient keys have been removed from this tab.');
+});
+document.addEventListener('visibilitychange', () => { if (document.hidden) hidePlaintext(); });
+if (!globalThis.crypto?.subtle) { saveButton.disabled = true; announce('Secure notes require HTTPS or localhost. Encryption is unavailable on this connection.', true); }
