diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,82 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      // Support the current WebMCP API and browsers with the earlier API.
+      const modelContext = document.modelContext ?? navigator.modelContext;
+      if (!modelContext?.registerTool) return;
+
+      const toolName = 'get_menu_item';
+      let registrationController;
+
+      const tool = {
+        name: toolName,
+        description: 'Look up a Daily Grind menu item and return its name, description, and details URL. Use this to answer questions about the items shown on this page.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              minLength: 1,
+              description: 'The menu item name, such as Maple Oat Latte, Dark Roast Espresso, or Cold Brew. Matching ignores capitalization and surrounding whitespace.'
+            }
+          },
+          required: ['name'],
+          additionalProperties: false
+        },
+        annotations: { readOnlyHint: true },
+        async execute({ name } = {}) {
+          const result = (data, isError = false) => ({
+            content: [{ type: 'text', text: JSON.stringify(data) }],
+            ...(isError ? { isError: true } : {})
+          });
+
+          if (typeof name !== 'string' || !name.trim()) {
+            return result({ error: 'Provide a non-empty menu item name.' }, true);
+          }
+
+          // Read the displayed menu to keep assistant answers in sync with it.
+          const items = Array.from(document.querySelectorAll('.grid .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href
+          }));
+          const item = items.find((item) => item.name.toLowerCase() === name.trim().toLowerCase());
+
+          return item
+            ? result(item)
+            : result({ error: 'Menu item not found.', availableItems: items.map((item) => item.name) }, true);
+        }
+      };
+
+      async function registerMenuTool() {
+        if (registrationController) return;
+        const controller = new AbortController();
+        registrationController = controller;
+        try {
+          await modelContext.registerTool(tool, { signal: controller.signal });
+        } catch (error) {
+          if (registrationController === controller) registrationController = undefined;
+          if (!controller.signal.aborted) console.warn('Could not register the menu lookup tool.', error);
+        }
+      }
+
+      function unregisterMenuTool() {
+        if (!registrationController) return;
+        registrationController.abort();
+        registrationController = undefined;
+        // Earlier implementations use explicit unregistration instead of signals.
+        if (!document.modelContext) modelContext.unregisterTool?.(toolName);
+      }
+
+      window.addEventListener('pagehide', unregisterMenuTool);
+      // Restore the registration when returning from the back/forward cache.
+      window.addEventListener('pageshow', registerMenuTool);
+      registerMenuTool();
+    })();
+  </script>
 </body>
 
 </html>
