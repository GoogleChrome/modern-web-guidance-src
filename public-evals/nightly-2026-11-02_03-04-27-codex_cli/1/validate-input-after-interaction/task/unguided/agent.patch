@@ -206,7 +274,41 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterError = document.getElementById('newsletter-error');
+    const newsletterStatus = document.getElementById('newsletter-status');
+
+    // Keep the field neutral while the user types; show errors only on blur.
+    newsletterEmail.addEventListener('input', () => {
+      newsletterEmail.removeAttribute('aria-invalid');
+      newsletterError.textContent = '';
+      newsletterStatus.textContent = '';
+    });
+
+    newsletterEmail.addEventListener('blur', () => {
+      const isValid = newsletterEmail.validity.valid;
+      newsletterEmail.setAttribute('aria-invalid', String(!isValid));
+      newsletterError.textContent = isValid ? '' :
+        (newsletterEmail.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address, like you@example.com.');
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!newsletterEmail.validity.valid) {
+        newsletterEmail.focus();
+        return;
+      }
+
+      // Replace this message with the signup request when a service is connected.
+      newsletterStatus.textContent = 'Newsletter signup is currently unavailable. Please try again later.';
+    });
+  </script>
+
 </body>
 
 </html>
