+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-level');
+    const roastValue = document.getElementById('roast-value');
+    const progress = document.getElementById('setup-progress');
+    const progressText = document.getElementById('progress-text');
+    const status = document.getElementById('subscription-status');
+    const roastLabels = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updateSetup() {
+      const roastLabel = roastLabels[Number(roast.value) - 1];
+      roastValue.value = roastLabel;
+      roast.setAttribute('aria-valuetext', roastLabel);
+      const complete = Number(email.value.trim() !== '' && email.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked')))
+        + Number(roast.validity.valid);
+      const percent = Math.round(complete / 3 * 100);
+      progress.value = complete;
+      progress.textContent = `${percent}%`;
+      progressText.textContent = `${complete} of 3 details complete · ${percent}%`;
+    }
+
+    form.addEventListener('input', () => {
+      updateSetup();
+      status.textContent = '';
+    });
+    form.addEventListener('change', updateSetup);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      updateSetup();
+      const preferences = Object.fromEntries(new FormData(form));
+      preferences.email_updates = document.getElementById('email-updates').checked;
+      try {
+        localStorage.setItem('daily-grind-coffee-preferences', JSON.stringify(preferences));
+        status.textContent = 'Your coffee preferences are saved on this device. No order has been placed.';
+      } catch {
+        status.textContent = 'Your browser could not save your preferences. Please allow site storage and try again.';
+      }
+    });
+
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-coffee-preferences'));
+      if (saved && typeof saved === 'object') {
+        if (typeof saved.email === 'string') email.value = saved.email;
+        const frequency = Array.from(form.querySelectorAll('input[name="frequency"]'))
+          .find((input) => input.value === saved.frequency);
+        if (frequency) frequency.checked = true;
+        if (['1', '2', '3', '4', '5'].includes(saved.roast)) roast.value = saved.roast;
+        document.getElementById('email-updates').checked = saved.email_updates === true;
+      }
+    } catch {
+      // Preferences remain usable when storage is blocked or unavailable.
+    }
+    updateSetup();
+  </script>
+
