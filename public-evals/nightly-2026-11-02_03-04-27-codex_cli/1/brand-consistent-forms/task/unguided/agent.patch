+<script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-level');
+    const progress = document.getElementById('subscription-progress');
+    const status = document.getElementById('subscription-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      document.getElementById('roast-description').value = `${roastName} · ${roast.value} of 5`;
+      roast.setAttribute('aria-valuetext', `${roastName}, ${roast.value} of 5`);
+      const complete = Number(email.validity.valid) + Number(Boolean(form.querySelector('input[name="frequency"]:checked'))) + 1;
+      progress.value = complete;
+      progress.textContent = `${complete} of 3`;
+      document.getElementById('progress-description').textContent = `${complete} of 3 details complete`;
+    }
+
+    form.addEventListener('input', () => {
+      updateSetup();
+      status.textContent = '';
+    });
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const preferences = {
+        email: email.value.trim(),
+        frequency: form.querySelector('input[name="frequency"]:checked').value,
+        roast: Number(roast.value),
+        emailUpdates: document.getElementById('email-updates').checked
+      };
+      try {
+        localStorage.setItem('daily-grind-subscription-preferences', JSON.stringify(preferences));
+        status.textContent = 'Your coffee preferences are saved on this device. No subscription order has been placed.';
+      } catch {
+        status.textContent = 'Your browser could not save these preferences. Please allow local storage and try again.';
+      }
+    });
+    updateSetup();
+  </script>
