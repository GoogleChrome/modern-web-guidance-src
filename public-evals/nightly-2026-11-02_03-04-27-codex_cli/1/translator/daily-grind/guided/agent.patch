diff --git a/translation.js b/translation.js
new file mode 100644
index 0000000..5a80a6d
--- /dev/null
+++ b/translation.js
@@ -0,0 +1,146 @@
+(() => {
+  const select = document.getElementById('language-select');
+  const translateButton = document.getElementById('translate-button');
+  const resetButton = document.getElementById('reset-language');
+  const status = document.getElementById('translation-status');
+  const progress = document.getElementById('translation-progress');
+  const content = Array.from(document.querySelectorAll('[data-translate]'));
+  // Always translate the original copy, never a previous translation.
+  const originals = content.map((element) => element.textContent);
+  const translations = new Map([['en', originals]]);
+  const supported = window.isSecureContext &&
+    typeof window.Translator?.availability === 'function' &&
+    typeof window.Translator?.create === 'function';
+  let revision = 0;
+  let options = null;
+
+  function render(texts, language) {
+    content.forEach((element, index) => {
+      // Translation output is plain text, never executable HTML.
+      element.textContent = texts[index];
+      element.lang = language;
+    });
+    resetButton.disabled = language === 'en';
+  }
+
+  function restoreOriginal() {
+    revision++;
+    options = null;
+    select.value = 'en';
+    progress.hidden = true;
+    translateButton.disabled = true;
+    translateButton.textContent = 'Translate';
+    render(originals, 'en');
+    status.textContent = 'Showing the original English descriptions and story.';
+  }
+
+  async function prepareLanguage() {
+    const currentRevision = ++revision;
+    const language = select.value;
+    options = null;
+    progress.hidden = true;
+    translateButton.disabled = true;
+    translateButton.textContent = 'Translate';
+    resetButton.disabled = false;
+
+    if (language === 'en') {
+      restoreOriginal();
+      return;
+    }
+
+    if (translations.has(language)) {
+      render(translations.get(language), language);
+      status.textContent = 'Showing the saved translation from this visit. Translation stays on your device.';
+      return;
+    }
+
+    status.textContent = 'Checking on-device translation for this language. The current text is still shown.';
+    const pair = { sourceLanguage: 'en', targetLanguage: language };
+
+    try {
+      const availability = await window.Translator.availability(pair);
+      if (currentRevision !== revision) return;
+
+      if (!['available', 'downloadable', 'downloading'].includes(availability)) {
+        status.textContent = 'This language is unavailable on your device. The current text is still shown. Choose another language or show original English.';
+        return;
+      }
+
+      options = pair;
+      translateButton.disabled = false;
+      translateButton.textContent = availability === 'available' ? 'Translate' : 'Download & translate';
+      status.textContent = availability === 'available'
+        ? 'Ready. Select Translate to read the descriptions and story in this language.'
+        : 'A language pack is needed. Select Download & translate to download it and translate on your device.';
+    } catch {
+      if (currentRevision !== revision) return;
+      status.textContent = 'Could not check translation availability. Choose a language again to retry, or show original English.';
+    }
+  }
+
+  async function translate() {
+    if (!options || translateButton.disabled) return;
+
+    const pair = options;
+    const currentRevision = ++revision;
+    let translator;
+    translateButton.disabled = true;
+    resetButton.disabled = false;
+    status.textContent = 'Preparing on-device translation. The current text is still shown.';
+
+    try {
+      // Called directly from the button click: downloads require user activation.
+      // Availability was already checked with this same language pair.
+      translator = await window.Translator.create({
+        ...pair,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', (event) => {
+            if (currentRevision !== revision) return;
+            if (progress.hidden) {
+              status.textContent = 'Downloading the language pack for on-device translation…';
+            }
+            progress.hidden = false;
+            progress.value = event.loaded;
+          });
+        },
+      });
+      if (currentRevision !== revision) return;
+
+      progress.hidden = true;
+      status.textContent = 'Translating the coffee descriptions and story on your device…';
+      const results = [];
+      for (const original of originals) {
+        const result = await translator.translate(original);
+        if (currentRevision !== revision) return;
+        if (typeof result !== 'string' || !result.trim()) {
+          throw new Error('Empty translation');
+        }
+        results.push(result);
+      }
+
+      // Commit only a complete translation; errors leave the displayed copy intact.
+      translations.set(pair.targetLanguage, results);
+      render(results, pair.targetLanguage);
+      status.textContent = 'Descriptions and story translated on your device. You can choose another language or show original English.';
+    } catch {
+      if (currentRevision !== revision) return;
+      status.textContent = 'Translation could not finish. The current text is still shown. Select Translate to retry, or show original English.';
+      translateButton.disabled = false;
+      translateButton.textContent = 'Translate';
+    } finally {
+      if (translator) translator.destroy();
+      if (currentRevision === revision) progress.hidden = true;
+    }
+  }
+
+  if (!supported) {
+    status.textContent = 'On-device translation is unavailable in this browser. Original English is shown. Try a desktop browser with the built-in Translator API enabled.';
+    return;
+  }
+
+  select.disabled = false;
+  status.textContent = 'Original English is shown. Choose a language to translate the descriptions and story on your device.';
+  select.addEventListener('change', prepareLanguage);
+  translateButton.addEventListener('click', translate);
+  resetButton.addEventListener('click', restoreOriginal);
+})();
