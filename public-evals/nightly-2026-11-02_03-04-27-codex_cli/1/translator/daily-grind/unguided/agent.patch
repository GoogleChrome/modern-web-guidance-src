diff --git a/translation.js b/translation.js
new file mode 100644
index 0000000..b4760d0
--- /dev/null
+++ b/translation.js
@@ -0,0 +1,117 @@
+(() => {
+  const form = document.querySelector('#language-form');
+  const select = document.querySelector('#language');
+  const button = document.querySelector('#translate-button');
+  const restore = document.querySelector('#restore-button');
+  const status = document.querySelector('#translation-status');
+  const nodes = [...document.querySelectorAll('[data-translatable]')];
+  const originals = nodes.map(node => node.textContent);
+  const cache = new Map([['en', originals]]);
+  const supported = window.isSecureContext && typeof window.Translator?.create === 'function';
+  let currentLanguage = 'en';
+  let operation = 0;
+  let activeTranslator = null;
+  let busy = false;
+
+  function updateControls() {
+    select.disabled = busy || !supported;
+    button.disabled = busy || !supported || select.value === currentLanguage;
+    restore.disabled = !busy && currentLanguage === 'en';
+    form.setAttribute('aria-busy', String(busy));
+  }
+
+  function applyTranslation(language, texts) {
+    nodes.forEach((node, index) => {
+      node.textContent = texts[index];
+      node.lang = language;
+      node.dir = language === 'ar' ? 'rtl' : 'ltr';
+    });
+    currentLanguage = language;
+  }
+
+  function destroyTranslator(translator) {
+    // Cleanup must not interfere with restoring the original content.
+    try { translator?.destroy(); } catch { /* Already closed by the browser. */ }
+  }
+
+  restore.addEventListener('click', () => {
+    operation++;
+    destroyTranslator(activeTranslator);
+    activeTranslator = null;
+    busy = false;
+    select.value = 'en';
+    applyTranslation('en', originals);
+    status.textContent = 'Original English restored.';
+    updateControls();
+  });
+
+  select.addEventListener('change', updateControls);
+
+  form.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (busy || !supported) return;
+    const language = select.value;
+    const languageName = select.selectedOptions[0].textContent;
+    const request = ++operation;
+    let translator;
+    busy = true;
+    updateControls();
+    status.textContent = `Preparing ${languageName} translation… Your browser may download a language pack.`;
+
+    try {
+      let texts = cache.get(language);
+      if (!texts) {
+        // Call create directly from the submit gesture: downloads require user activation.
+        translator = await window.Translator.create({
+          sourceLanguage: 'en',
+          targetLanguage: language,
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', event => {
+              if (request === operation) {
+                status.textContent = `Downloading ${languageName} language pack: ${Math.round(event.loaded * 100)}%`;
+              }
+            });
+          }
+        });
+        if (request !== operation) return;
+        activeTranslator = translator;
+        status.textContent = `Translating to ${languageName} on your device…`;
+        texts = [];
+        // Always translate from the original English, avoiding accumulated translation errors.
+        for (const original of originals) {
+          const translated = await translator.translate(original);
+          if (request !== operation) return;
+          if (typeof translated !== 'string' || !translated.trim()) {
+            throw new Error('Empty translation');
+          }
+          texts.push(translated);
+        }
+        cache.set(language, texts);
+      }
+      if (request !== operation) return;
+      // Commit all descriptions together only after every translation succeeds.
+      applyTranslation(language, texts);
+      status.textContent = language === 'en'
+        ? 'Original English restored.'
+        : `Coffee descriptions and story translated to ${languageName} on your device. Machine translations may vary.`;
+    } catch (error) {
+      if (request !== operation) return;
+      select.value = currentLanguage;
+      status.textContent = error.name === 'NotSupportedError'
+        ? 'This language is not available on your device. Try another language. The current text has been kept.'
+        : 'Translation could not finish. Check your connection for the language pack download and try again. The current text has been kept.';
+    } finally {
+      destroyTranslator(translator);
+      if (request === operation) {
+        activeTranslator = null;
+        busy = false;
+        updateControls();
+      }
+    }
+  });
+
+  if (!supported) {
+    status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop browser, such as Chrome, over HTTPS. The original English is shown.';
+  }
+  updateControls();
+})();
