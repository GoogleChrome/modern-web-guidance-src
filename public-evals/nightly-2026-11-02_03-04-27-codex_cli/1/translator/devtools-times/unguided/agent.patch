diff --git a/src/scripts/article-translation.ts b/src/scripts/article-translation.ts
new file mode 100644
index 0000000..8d6c73d
--- /dev/null
+++ b/src/scripts/article-translation.ts
@@ -0,0 +1,216 @@
+// The experimental browser API is not yet included in TypeScript's DOM library.
+type Availability = 'unavailable' | 'downloadable' | 'downloading' | 'available';
+type LanguagePair = { sourceLanguage: string; targetLanguage: string };
+interface LocalTranslator {
+  translate(text: string): Promise<string>;
+  destroy(): void;
+}
+interface TranslatorAPI {
+  availability(options: LanguagePair): Promise<Availability>;
+  create(options: LanguagePair & {
+    signal: AbortSignal;
+    monitor: (monitor: EventTarget) => void;
+  }): Promise<LocalTranslator>;
+}
+type OriginalRegion = { element: HTMLElement; lang: string | null; dir: string | null };
+
+class ArticleTranslation extends HTMLElement {
+  private select!: HTMLSelectElement;
+  private start!: HTMLButtonElement;
+  private reset!: HTMLButtonElement;
+  private status!: HTMLElement;
+  private label!: HTMLElement;
+  private progress!: HTMLProgressElement;
+  private api?: TranslatorAPI;
+  private originals = new Map<Text, string>();
+  private regions: OriginalRegion[] = [];
+  private controller?: AbortController;
+  private translator?: LocalTranslator;
+  private currentLanguage = 'en';
+  private checkVersion = 0;
+
+  connectedCallback() {
+    this.regions = Array.from(document.querySelectorAll<HTMLElement>('[data-translate]'))
+      .map(element => ({ element, lang: element.getAttribute('lang'), dir: element.getAttribute('dir') }));
+    if (!this.regions.length) return;
+    this.hidden = false;
+    this.select = this.querySelector('select')!;
+    this.start = this.querySelector('[data-translation-start]')!;
+    this.reset = this.querySelector('[data-translation-reset]')!;
+    this.status = this.querySelector('[role="status"]')!;
+    this.label = this.querySelector('[data-translation-label]')!;
+    this.progress = this.querySelector('progress')!;
+    this.api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+    try {
+      const preferred = localStorage.getItem('devtools-times-translation-language');
+      if (preferred && Array.from(this.select.options).some(option => option.value === preferred)) {
+        this.select.value = preferred;
+      }
+    } catch { /* Translation still works when browser storage is disabled. */ }
+
+    this.select.addEventListener('change', this.onLanguageChange);
+    this.start.addEventListener('click', this.translateArticles);
+    this.reset.addEventListener('click', this.restore);
+    void this.checkAvailability();
+  }
+
+  disconnectedCallback() {
+    this.checkVersion++;
+    this.cancel();
+    this.select?.removeEventListener('change', this.onLanguageChange);
+    this.start?.removeEventListener('click', this.translateArticles);
+    this.reset?.removeEventListener('click', this.restore);
+  }
+
+  private onLanguageChange = () => {
+    try { localStorage.setItem('devtools-times-translation-language', this.select.value); } catch { /* Optional preference. */ }
+    void this.checkAvailability();
+  };
+
+  private async checkAvailability() {
+    const version = ++this.checkVersion;
+    this.start.disabled = true;
+    const targetLanguage = this.select.value;
+    if (targetLanguage === 'en') {
+      this.start.disabled = this.currentLanguage === 'en';
+      this.status.textContent = 'English is the original language. Select Translate to restore it.';
+      return;
+    }
+    if (!this.api) {
+      this.status.textContent = 'On-device translation isn’t available in this browser. Try a recent desktop version of Chrome or Edge.';
+      return;
+    }
+    this.status.textContent = 'Checking language availability…';
+    try {
+      const availability = await this.api.availability({ sourceLanguage: 'en', targetLanguage });
+      if (version !== this.checkVersion || !this.isConnected) return;
+      this.start.disabled = availability === 'unavailable' || targetLanguage === this.currentLanguage;
+      this.status.textContent = availability === 'unavailable'
+        ? 'This language isn’t supported on your device. Choose another language.'
+        : targetLanguage === this.currentLanguage
+          ? `Showing ${this.languageName()}. Machine translated on your device.`
+          : availability === 'available'
+            ? 'Ready to translate on your device.'
+            : 'First use may download a language pack. Translation stays on your device.';
+    } catch {
+      if (version === this.checkVersion && this.isConnected) {
+        this.status.textContent = 'Couldn’t check this language. Choose a language to try again.';
+      }
+    }
+  }
+
+  private languageName() {
+    return this.select.selectedOptions[0].textContent;
+  }
+
+  private collectText() {
+    if (this.originals.size) return;
+    for (const { element } of this.regions) {
+      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
+      let node: Node | null;
+      while ((node = walker.nextNode())) {
+        // Preserve interactive elements, executable content, and code examples.
+        if (node.textContent?.trim() && !node.parentElement?.closest('script, style, pre, code, button, textarea, [translate="no"]')) {
+          this.originals.set(node as Text, node.textContent);
+        }
+      }
+    }
+  }
+
+  private translateArticles = async () => {
+    const targetLanguage = this.select.value;
+    if (targetLanguage === 'en') { this.restore(); return; }
+    if (!this.api || this.controller) return;
+    this.checkVersion++;
+    const controller = new AbortController();
+    this.controller = controller;
+    this.start.disabled = true;
+    this.select.disabled = true;
+    this.reset.hidden = false;
+    this.reset.textContent = 'Cancel';
+    this.label.textContent = 'Translating…';
+    this.setAttribute('aria-busy', 'true');
+    this.status.textContent = 'Preparing on-device translation…';
+    this.progress.value = 0;
+    this.progress.hidden = false;
+    try {
+      // Call create directly from the click, before awaiting anything: language
+      // pack downloads require transient user activation.
+      const translator = await this.api.create({
+        sourceLanguage: 'en', targetLanguage, signal: controller.signal,
+        monitor: monitor => monitor.addEventListener('downloadprogress', event => {
+          if (controller.signal.aborted) return;
+          const { loaded, total } = event as ProgressEvent;
+          const fraction = Math.min(1, Math.max(0, total ? loaded / total : loaded));
+          this.progress.value = fraction;
+          this.status.textContent = `Downloading language pack… ${Math.round(fraction * 100)}%`;
+        }),
+      });
+      if (controller.signal.aborted) { translator.destroy(); return; }
+      this.translator = translator;
+      this.collectText();
+      const translations = new Map<string, string>();
+      const texts = [...new Set(this.originals.values())];
+      for (const [index, text] of texts.entries()) {
+        if (controller.signal.aborted) return;
+        const translated = await translator.translate(text.trim());
+        if (!translated.trim()) throw new Error('Empty translation');
+        translations.set(text, text.replace(text.trim(), () => translated));
+        this.progress.value = (index + 1) / texts.length;
+        this.status.textContent = `Translating articles… ${Math.round(this.progress.value * 100)}%`;
+      }
+      if (controller.signal.aborted || !this.isConnected) return;
+      // Commit together so a failed request never leaves a half-translated page.
+      for (const [node, original] of this.originals) node.data = translations.get(original)!;
+      for (const { element } of this.regions) {
+        element.lang = targetLanguage;
+        element.dir = ['ar', 'he'].includes(targetLanguage) ? 'rtl' : 'ltr';
+      }
+      this.currentLanguage = targetLanguage;
+      this.status.textContent = `Showing ${this.languageName()}. Machine translated on your device.`;
+    } catch {
+      if (!controller.signal.aborted) {
+        this.status.textContent = 'Translation couldn’t finish. Your text is unchanged. Check your connection for language downloads and try again.';
+      }
+    } finally {
+      if (this.controller === controller) {
+        this.cancel();
+        this.select.disabled = false;
+        this.start.disabled = this.currentLanguage === targetLanguage;
+        this.label.textContent = 'Translate';
+        this.reset.textContent = 'Show original';
+        this.reset.hidden = this.currentLanguage === 'en';
+        this.progress.hidden = true;
+        this.removeAttribute('aria-busy');
+      }
+    }
+  };
+
+  private cancel() {
+    this.controller?.abort();
+    this.controller = undefined;
+    this.translator?.destroy();
+    this.translator = undefined;
+  }
+
+  private restore = () => {
+    this.cancel();
+    for (const [node, original] of this.originals) node.data = original;
+    for (const { element, lang, dir } of this.regions) {
+      if (lang === null) element.removeAttribute('lang'); else element.setAttribute('lang', lang);
+      if (dir === null) element.removeAttribute('dir'); else element.setAttribute('dir', dir);
+    }
+    this.currentLanguage = 'en';
+    this.select.disabled = false;
+    this.reset.hidden = true;
+    this.progress.hidden = true;
+    this.label.textContent = 'Translate';
+    this.removeAttribute('aria-busy');
+    this.start.disabled = !this.api || this.select.value === 'en';
+    this.status.textContent = 'Showing the original English articles.';
+  };
+}
+
+if (!customElements.get('article-translation')) {
+  customElements.define('article-translation', ArticleTranslation);
+}
