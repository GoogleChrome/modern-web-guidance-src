diff --git a/src/components/TranslationControl.astro b/src/components/TranslationControl.astro
new file mode 100644
index 0000000..b38c8cb
--- /dev/null
+++ b/src/components/TranslationControl.astro
@@ -0,0 +1,75 @@
+---
+const languages = [
+  ['en', 'English'], ['es', 'Español'], ['fr', 'Français'], ['de', 'Deutsch'],
+  ['it', 'Italiano'], ['pt', 'Português'], ['nl', 'Nederlands'], ['pl', 'Polski'],
+  ['uk', 'Українська'], ['ru', 'Русский'], ['ar', 'العربية'], ['he', 'עברית'],
+  ['hi', 'हिन्दी'], ['bn', 'বাংলা'], ['ja', '日本語'], ['ko', '한국어'],
+  ['zh', '中文（简体）'], ['zh-Hant', '中文（繁體）'], ['tr', 'Türkçe'],
+  ['vi', 'Tiếng Việt'], ['id', 'Bahasa Indonesia'], ['th', 'ไทย'],
+];
+---
+
+<article-translation class="translation-panel" hidden>
+  <div class="translation-intro">
+    <span class="translation-icon" aria-hidden="true">
+      <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
+        <path d="m5 8 6 6m-7 0 6-6 2-3M2 5h12M7 2v3m6 16 5-12 5 12m-8-4h6" />
+      </svg>
+    </span>
+    <div>
+      <div class="translation-eyebrow">A WORLD OF PERSPECTIVES</div>
+      <h2 class="font-brand">Read in your language.</h2>
+      <p>Translate articles and headlines, right on your device.</p>
+    </div>
+  </div>
+  <div class="translation-actions">
+    <label for="translation-language">Translate to</label>
+    <div class="translation-inputs">
+      <select id="translation-language" aria-describedby="translation-status">
+        {languages.map(([code, name]) => <option value={code} lang={code} selected={code === 'es'}>{name}</option>)}
+      </select>
+      <button type="button" data-translation-start disabled>
+        <span data-translation-label>Translate</span><span aria-hidden="true"> →</span>
+      </button>
+      <button type="button" data-translation-reset hidden>Show original</button>
+    </div>
+    <p id="translation-status" role="status" aria-live="polite" aria-atomic="true">Checking on-device translation…</p>
+    <progress max="1" value="0" aria-label="Translation progress" hidden></progress>
+    <p class="translation-privacy">
+      <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V6a4 4 0 0 1 8 0v4"/></svg>
+      On-device · No article text sent to a translation service
+    </p>
+  </div>
+</article-translation>
+
+<script>
+  import '../scripts/article-translation';
+</script>
+
+<style>
+  .translation-panel { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin: 1.5rem 1.5rem 0; padding: 1.25rem 1.5rem; border: 1px solid #e5dfd3; border-radius: 4px; background: #faf8f3; color: #292524; }
+  .translation-panel[hidden], [hidden] { display: none; }
+  .translation-intro { display: flex; align-items: center; gap: 1rem; }
+  .translation-icon { display: grid; place-items: center; width: 48px; height: 48px; flex-shrink: 0; border: 1px solid #e4d8bf; border-radius: 50%; color: #885d20; background: #f4edde; }
+  .translation-eyebrow { color: #85652f; font-size: 9px; font-weight: 700; letter-spacing: .15em; }
+  h2 { margin: 2px 0; font-size: 27px; line-height: 1.2; }
+  .translation-intro p { font-size: 12px; color: #78716c; margin-top: 5px; }
+  .translation-actions { flex: 0 1 420px; min-width: 0; }
+  label { display: block; font-size: 11px; font-weight: 600; margin-bottom: 6px; }
+  .translation-inputs { display: flex; gap: 8px; flex-wrap: wrap; }
+  select { flex: 1; min-width: 120px; padding: 9px 28px 9px 10px; border: 1px solid #d6d3d1; border-radius: 3px; background: white; font-size: 13px; color: #292524; }
+  button { padding: 9px 14px; border: 1px solid #292524; border-radius: 3px; background: #292524; color: white; font-size: 12px; font-weight: 600; cursor: pointer; }
+  button:hover:enabled { background: #44403c; }
+  button:disabled { opacity: .5; cursor: not-allowed; }
+  select:focus-visible, button:focus-visible { outline: 2px solid #a16207; outline-offset: 3px; }
+  [data-translation-reset] { background: transparent; color: #57534e; border-color: #d6d3d1; }
+  [data-translation-reset]:hover:enabled { background: #eee9df; }
+  #translation-status { margin-top: 7px; font-size: 11px; line-height: 1.5; color: #57534e; }
+  .translation-privacy { display: flex; align-items: center; gap: 4px; margin-top: 5px; font-size: 9px; color: #78716c; }
+  progress { width: 100%; height: 4px; margin-top: 7px; accent-color: #926b2d; }
+  @media (max-width: 767px) {
+    .translation-panel { flex-direction: column; align-items: stretch; gap: 18px; margin: 1rem 1rem 0; padding: 18px; }
+    .translation-actions { flex-basis: auto; }
+    h2 { font-size: 25px; }
+  }
+</style>
