diff --git a/src/scripts/article-translation.ts b/src/scripts/article-translation.ts
new file mode 100644
index 0000000..7c5a833
--- /dev/null
+++ b/src/scripts/article-translation.ts
@@ -0,0 +1,200 @@
+type Availability = 'unavailable' | 'downloadable' | 'downloading' | 'available';
+type LanguagePair = { sourceLanguage: string; targetLanguage: string };
+type LocalTranslator = {
+  translate(text: string): Promise<string>;
+  destroy(): void;
+};
+type TranslatorAPI = {
+  availability(options: LanguagePair): Promise<Availability>;
+  create(options: LanguagePair & {
+    signal: AbortSignal;
+    monitor: (monitor: { addEventListener(type: 'downloadprogress', callback: (event: { loaded: number }) => void): void }) => void;
+  }): Promise<LocalTranslator>;
+};
+
+class ArticleTranslator extends HTMLElement {
+  private lifecycle?: AbortController;
+  private operation?: AbortController;
+  private revision = 0;
+  private originals = new Map<Text, string>();
+  private regions = new Map<HTMLElement, { lang: string | null; dir: string | null }>();
+  private language!: HTMLSelectElement;
+  private translateButton!: HTMLButtonElement;
+  private restoreButton!: HTMLButtonElement;
+  private status!: HTMLElement;
+  private progress!: HTMLProgressElement;
+  private options?: LanguagePair;
+  private api?: TranslatorAPI;
+
+  connectedCallback() {
+    this.lifecycle = new AbortController();
+    const { signal } = this.lifecycle;
+    this.language = this.querySelector('select')!;
+    this.translateButton = this.querySelector('[data-translate]')!;
+    this.restoreButton = this.querySelector('[data-restore]')!;
+    this.status = this.querySelector('[role="status"]')!;
+    this.progress = this.querySelector('progress')!;
+    // The script can run before the rest of the page is parsed.
+    const initialize = () => {
+      if (!document.querySelector('[data-article-text]')) return;
+      this.hidden = false;
+      this.api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+      if (!this.api) {
+        this.status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop browser such as Chrome. The English originals are still available.';
+        return;
+      }
+      this.language.disabled = false;
+      void this.checkAvailability();
+    };
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initialize, { once: true, signal });
+    } else initialize();
+    this.language.addEventListener('change', () => void this.checkAvailability(), { signal });
+    this.translateButton.addEventListener('click', () => void this.translateArticles(), { signal });
+    this.restoreButton.addEventListener('click', () => this.restore(), { signal });
+    // Release models before Astro swaps the DOM, including during downloads.
+    document.addEventListener('astro:before-swap', () => this.operation?.abort(), { signal });
+  }
+
+  disconnectedCallback() {
+    this.lifecycle?.abort();
+    this.operation?.abort();
+    this.revision++;
+    this.originals.clear();
+    this.regions.clear();
+  }
+
+  private async checkAvailability() {
+    const revision = ++this.revision;
+    this.options = undefined;
+    this.translateButton.disabled = true;
+    if (this.language.value === 'en') {
+      this.status.textContent = 'English is the original language. Choose Show original to restore it.';
+      return;
+    }
+    const options = { sourceLanguage: 'en', targetLanguage: this.language.value };
+    this.status.textContent = 'Checking this language on your device…';
+    try {
+      const availability = await this.api!.availability(options);
+      if (revision !== this.revision || !this.isConnected) return;
+      if (availability === 'unavailable') {
+        this.status.textContent = 'This language is unavailable on your device. Choose another language.';
+        return;
+      }
+      this.options = options;
+      this.translateButton.disabled = false;
+      this.status.textContent = availability === 'available'
+        ? 'Ready to translate on your device.'
+        : 'A language pack is needed. Choose Translate to download it and translate this page.';
+    } catch {
+      if (revision === this.revision && this.isConnected) {
+        this.status.textContent = 'Could not check translation availability. Choose a language to try again.';
+      }
+    }
+  }
+
+  private collectOriginals() {
+    for (const region of document.querySelectorAll<HTMLElement>('[data-article-text]')) {
+      if (!this.regions.has(region)) this.regions.set(region, { lang: region.getAttribute('lang'), dir: region.getAttribute('dir') });
+      const walker = document.createTreeWalker(region, NodeFilter.SHOW_TEXT, {
+        acceptNode: (node) => node.textContent?.trim() && !node.parentElement?.closest('script, style, code, pre, button, input, textarea, select, [contenteditable], [translate="no"]')
+          ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT,
+      });
+      let node: Node | null;
+      while ((node = walker.nextNode())) {
+        const text = node as Text;
+        if (!this.originals.has(text)) this.originals.set(text, text.data);
+      }
+    }
+  }
+
+  private async translateArticles() {
+    const options = this.options;
+    if (!options || !this.api || this.operation) return;
+    const operation = new AbortController();
+    this.operation = operation;
+    this.language.disabled = true;
+    this.translateButton.disabled = true;
+    this.restoreButton.disabled = false;
+    this.restoreButton.textContent = 'Cancel / show original';
+    this.progress.hidden = false;
+    this.progress.removeAttribute('value');
+    this.status.textContent = 'Preparing on-device translation…';
+    let translator: LocalTranslator | undefined;
+    try {
+      // Invoke create directly in the click handler, after the earlier availability
+      // check, so downloads retain the required transient user activation.
+      translator = await this.api.create({
+        ...options,
+        signal: operation.signal,
+        monitor: (monitor) => monitor.addEventListener('downloadprogress', (event) => {
+          if (operation.signal.aborted) return;
+          this.status.textContent = 'Downloading the language pack…';
+          this.progress.max = 1;
+          this.progress.value = event.loaded;
+        }),
+      });
+      if (operation.signal.aborted) return;
+      this.collectOriginals();
+      const entries = [...this.originals].filter(([node]) => node.isConnected);
+      const results: [Text, string][] = [];
+      const cache = new Map<string, string>();
+      this.status.textContent = 'Translating articles and teasers on your device…';
+      this.progress.max = entries.length || 1;
+      this.progress.value = 0;
+      for (const [node, original] of entries) {
+        const text = original.trim();
+        let translated = cache.get(text);
+        if (translated === undefined) {
+          translated = await translator.translate(text);
+          cache.set(text, translated);
+        }
+        if (operation.signal.aborted) return;
+        // Keep inline markup, links, event handlers, and surrounding whitespace.
+        results.push([node, original.replace(text, () => translated!)]);
+        this.progress.value = results.length;
+      }
+      // Commit only after everything succeeds: a failure keeps the previous view.
+      for (const [node, text] of results) node.data = text;
+      for (const region of this.regions.keys()) {
+        region.lang = options.targetLanguage;
+        region.dir = options.targetLanguage === 'ar' ? 'rtl' : 'ltr';
+      }
+      const name = this.language.selectedOptions[0].textContent;
+      this.status.textContent = `Articles and teasers are now in ${name}. Machine translations may contain errors.`;
+    } catch (error) {
+      if (!operation.signal.aborted) {
+        this.status.textContent = error instanceof DOMException && error.name === 'NotAllowedError'
+          ? 'Your browser could not start translation. Choose Translate again to allow the language-pack download.'
+          : 'Translation could not finish. Your text has been kept. Check your connection or choose another language and try again.';
+      }
+    } finally {
+      translator?.destroy();
+      if (this.operation === operation) {
+        this.operation = undefined;
+        this.progress.hidden = true;
+        this.language.disabled = false;
+        this.translateButton.disabled = !this.options;
+        this.restoreButton.textContent = 'Show original';
+        this.restoreButton.disabled = this.originals.size === 0;
+      }
+    }
+  }
+
+  private restore() {
+    this.operation?.abort();
+    for (const [node, original] of this.originals) node.data = original;
+    for (const [region, attributes] of this.regions) {
+      for (const attribute of ['lang', 'dir'] as const) {
+        const value = attributes[attribute];
+        if (value === null) region.removeAttribute(attribute);
+        else region.setAttribute(attribute, value);
+      }
+    }
+    this.status.textContent = 'Showing the original English articles and teasers.';
+  }
+}
+
+if (!customElements.get('article-translator')) {
+  customElements.define('article-translator', ArticleTranslator);
+}
