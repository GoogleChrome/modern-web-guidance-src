+---
+const languages = [
+  ['en', 'English'], ['ar', 'Arabic'], ['zh', 'Chinese'], ['nl', 'Dutch'],
+  ['fr', 'French'], ['de', 'German'], ['hi', 'Hindi'], ['it', 'Italian'],
+  ['ja', 'Japanese'], ['ko', 'Korean'], ['pl', 'Polish'], ['pt', 'Portuguese'],
+  ['es', 'Spanish'], ['tr', 'Turkish'], ['uk', 'Ukrainian'],
+];
+---
+
+<article-translator class="block border-b border-gray-200 bg-amber-50/60 px-4 py-3 md:px-6" hidden>
+  <details>
+    <summary class="cursor-pointer text-sm font-semibold text-gray-800 py-1">
+      Translate articles <span class="ml-2 text-xs font-normal text-amber-900">On your device</span>
+    </summary>
+    <div class="pt-3">
+      <p id="translation-help" class="text-sm text-gray-600 mb-3">Read this page’s articles and teasers in another language. Text stays on your device; your browser may download a language pack first.</p>
+      <div class="flex flex-wrap items-end gap-3">
+        <label for="translation-language" class="text-sm font-medium text-gray-800">
+          Translate from English to
+          <select id="translation-language" class="block mt-1 rounded border border-gray-400 bg-white px-3 py-2 min-h-10" aria-describedby="translation-help translation-status" disabled>
+            {languages.map(([code, name]) => <option value={code} selected={code === 'es'}>{name}</option>)}
+          </select>
+        </label>
+        <button type="button" data-translate class="rounded bg-gray-800 px-4 py-2 text-sm font-semibold text-white min-h-10 hover:bg-gray-700 disabled:opacity-50 disabled:cursor-not-allowed" disabled>Translate</button>
+        <button type="button" data-restore class="rounded border border-gray-400 bg-white px-4 py-2 text-sm text-gray-800 min-h-10 hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed" disabled>Show original</button>
+      </div>
+      <p id="translation-status" role="status" class="mt-3 text-sm text-gray-700">Checking on-device translation…</p>
+      <progress data-progress class="mt-2 w-full max-w-sm accent-amber-800" aria-label="Translation progress" hidden></progress>
+    </div>
+  </details>
+</article-translator>
+
+<style>
+  article-translator[hidden] { display: none; }
+</style>
+
+<script>
+  import '../scripts/article-translation';
+</script>
