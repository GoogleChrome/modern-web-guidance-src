+  <script>
+    const navigation = document.querySelector('nav');
+    const stickyHeaders = [...document.querySelectorAll('.sticky-container')];
+    const needsStickyFallback = !CSS.supports('container-type', 'scroll-state');
+    let navigationHeight = 0;
+    let pendingFrame = false;
+
+    // The document is the scroll root; keep headers below the actual nav height.
+    function updateStickyFallback() {
+      pendingFrame = false;
+      for (const container of stickyHeaders) {
+        const section = container.parentElement.getBoundingClientRect();
+        const header = container.getBoundingClientRect();
+        const stuck = section.top < navigationHeight && header.top >= navigationHeight - 1;
+        container.classList.toggle('is-stuck', stuck);
+      }
+    }
+
+    function queueStickyFallback() {
+      if (!pendingFrame) {
+        pendingFrame = true;
+        requestAnimationFrame(updateStickyFallback);
+      }
+    }
+
+    function updateNavigationHeight() {
+      navigationHeight = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--site-nav-height', `${navigationHeight}px`);
+      if (needsStickyFallback) queueStickyFallback();
+    }
+
+    new ResizeObserver(updateNavigationHeight).observe(navigation);
+    updateNavigationHeight();
+
+    if (needsStickyFallback) {
+      window.addEventListener('scroll', queueStickyFallback, { passive: true });
+      window.addEventListener('resize', queueStickyFallback);
+    }
+  </script>
+
