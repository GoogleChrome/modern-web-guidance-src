+  <script>
+    const cartList = document.querySelector('.SwipeableList');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function removeCartItem(item, direction = -1) {
+      if (item.classList.contains('is-removing')) return;
+      const content = item.querySelector('.SwipeableList-content');
+      const restoreFocus = item.contains(document.activeElement);
+      item.style.height = `${item.getBoundingClientRect().height}px`;
+      item.classList.remove('is-dragging', 'is-ready');
+      item.classList.add('is-removing');
+      content.style.transform = `translateX(${direction * item.offsetWidth}px)`;
+      item.querySelector('button').disabled = true;
+
+      // Keep the action color visible briefly before collapsing the whole row.
+      window.setTimeout(() => {
+        item.style.height = '0px';
+        item.style.opacity = '0';
+        window.setTimeout(() => {
+          const nextButton = (item.nextElementSibling || item.previousElementSibling)
+            ?.querySelector('button:not(:disabled)');
+          item.remove();
+          const count = cartList.children.length;
+          document.querySelector('.cart-count').textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
+          document.querySelector('.cart-empty').hidden = count > 0;
+          document.querySelector('#cart-status').textContent = `${item.dataset.name} removed. ${count} ${count === 1 ? 'item' : 'items'} remaining.`;
+          if (restoreFocus) (nextButton || document.querySelector('#cart-title')).focus();
+        }, reducedMotion.matches ? 0 : 300);
+      }, reducedMotion.matches ? 0 : 180);
+    }
+
+    cartList.querySelectorAll('.SwipeableList-item').forEach(item => {
+      const content = item.querySelector('.SwipeableList-content');
+      let gesture = null;
+      const threshold = () => Math.min(96, content.offsetWidth * 0.3);
+
+      function resetGesture() {
+        gesture = null;
+        item.classList.remove('is-dragging', 'is-ready');
+        content.style.transform = '';
+      }
+
+      content.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0 || event.target.closest('button') || item.classList.contains('is-removing')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, distance: 0, horizontal: false };
+        content.setPointerCapture(event.pointerId);
+      });
+
+      content.addEventListener('pointermove', event => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.horizontal) {
+          if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) {
+            resetGesture();
+            return;
+          }
+          if (Math.abs(dx) < 8) return;
+          gesture.horizontal = true;
+          item.classList.add('is-dragging');
+        }
+        gesture.distance = dx;
+        content.style.transform = `translateX(${dx}px)`;
+        const ready = Math.abs(dx) >= threshold();
+        item.classList.toggle('is-ready', ready);
+        item.querySelectorAll('.swipe-action span').forEach(label => {
+          label.textContent = ready ? 'Release to remove' : 'Remove';
+        });
+      });
+
+      content.addEventListener('pointerup', event => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const distance = gesture.distance;
+        const shouldRemove = gesture.horizontal && Math.abs(distance) >= threshold();
+        gesture = null;
+        if (shouldRemove) removeCartItem(item, Math.sign(distance));
+        else resetGesture();
+      });
+
+      content.addEventListener('pointercancel', resetGesture);
+      content.addEventListener('lostpointercapture', () => {
+        if (gesture) resetGesture();
+      });
+      item.querySelector('.cart-remove').addEventListener('click', () => removeCartItem(item));
+    });
+  </script>
+
