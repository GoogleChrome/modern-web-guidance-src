+      const sessionLink = document.getElementById('session-link');
+      const continueLink = document.getElementById('signin-continue');
+      let authenticated = false;
+      let pendingDestination = null;
+      let passkeyRequest = null;
+      let busy = false;
+
+      function announce(message, error = false) {
+        status.textContent = message;
+        status.dataset.error = String(error);
+      }
+
+      function setBusy(value) {
+        busy = value;
+        form.setAttribute('aria-busy', String(value));
+        form.querySelectorAll('button').forEach(button => { button.disabled = value; });
+      }
+
+      // Server contract: same-origin JSON endpoints must validate credentials and
+      // establish a Secure, HttpOnly session cookie. Never trust client state.
+      // session, password, and passkey/verify return { authenticated: true } only
+      // after verification. Protect POSTs with server-side Origin/CSRF checks.
+      async function api(path, body, signal) {
+        const response = await fetch('/api/auth/' + path, {
+          method: body === undefined ? 'GET' : 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: body === undefined ? { Accept: 'application/json' } : {
+            Accept: 'application/json', 'Content-Type': 'application/json'
+          },
+          body: body === undefined ? undefined : JSON.stringify(body),
+          signal
+        });
+        if (!response.ok) {
+          throw new Error(response.status === 401 ? 'We couldn’t sign you in. Please check your details and try again.' :
+            'Sign-in is temporarily unavailable. Please try again later.');
+        }
+        if (!response.headers.get('content-type')?.includes('application/json')) {
+          throw new Error('Sign-in is temporarily unavailable. Please try again later.');
+        }
+        return response.json();
+      }
+
+      function signedIn(result) {
+        if (result.authenticated !== true) throw new Error('Sign-in could not be confirmed. Please try again.');
+        authenticated = true;
+        passkeyRequest?.abort();
+        form.hidden = true;
+        form.reset();
+        sessionLink.textContent = 'Sign out';
+        announce('You’re signed in. Enjoy your Daily Grind.');
+        description.textContent = 'Your rewards, account, and next coffee are ready when you are.';
+        if (pendingDestination) {
+          continueLink.href = pendingDestination.href;
+          continueLink.textContent = 'Continue to ' + pendingDestination.label;
+          continueLink.hidden = false;
+        }
+      }
+
+      document.querySelectorAll('[data-signin]').forEach(link => {
+        link.addEventListener('click', event => {
+          if (authenticated || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
+          event.preventDefault();
+          pendingDestination = { href: link.getAttribute('href'), label: link.dataset.signin };
+          description.textContent = 'Sign in here to continue to ' + link.dataset.signin + '. You’ll stay on this page while signing in.';
+          document.getElementById('username').focus();
+        });
+      });
+
+      sessionLink.addEventListener('click', async event => {
