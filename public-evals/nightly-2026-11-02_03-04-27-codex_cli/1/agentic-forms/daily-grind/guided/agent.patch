+(() => {
+  const form = document.getElementById('coffee-finder-form');
+  const heading = document.getElementById('results-heading');
+  const status = document.getElementById('finder-status');
+  const results = document.getElementById('coffee-results');
+  const initialStatus = status.textContent;
+  const initialHeading = heading.textContent;
+
+  // Keep the recommendations aligned with the featured menu on this page.
+  const coffees = [
+    {
+      name: 'Maple Oat Latte',
+      flavor: 'sweet',
+      temperature: 'hot',
+      description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+      url: '/menu/seasonal',
+    },
+    {
+      name: 'Dark Roast Espresso',
+      flavor: 'bold',
+      temperature: 'hot',
+      description: 'Bold, smokey, and perfect for a morning boost.',
+      url: '/menu/espresso',
+    },
+    {
+      name: 'Cold Brew',
+      flavor: 'smooth',
+      temperature: 'iced',
+      description: 'Steeped for 18 hours for maximum smoothness.',
+      url: '/menu/cold-brew',
+    },
+  ];
+
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    const data = new FormData(form);
+    const flavor = data.get('flavor');
+    const temperature = data.get('temperature');
+    const valid = form.checkValidity()
+      && ['any', 'sweet', 'bold', 'smooth'].includes(flavor)
+      && ['any', 'hot', 'iced'].includes(temperature);
+
+    results.replaceChildren();
+    let response;
+
+    if (!valid) {
+      heading.textContent = 'Let’s check your preferences';
+      status.textContent = 'Choose a flavor and a temperature from the available options, then try again.';
+      form.reportValidity();
+      response = { status: 'error', message: status.textContent };
+    } else {
+      const matches = coffees.filter((coffee) =>
+        (flavor === 'any' || coffee.flavor === flavor)
+        && (temperature === 'any' || coffee.temperature === temperature));
+
+      heading.textContent = matches.length ? 'Meet your coffee match' : 'Let’s try another pairing';
+      status.textContent = matches.length
+        ? `${matches.length} featured ${matches.length === 1 ? 'coffee matches' : 'coffees match'} your preferences.`
+        : 'No featured coffees match this combination. Try “Either works” for temperature or “Surprise me” for flavor.';
+
+      for (const coffee of matches) {
+        const item = document.createElement('li');
+        const link = document.createElement('a');
+        link.href = coffee.url;
+        link.textContent = coffee.name;
+        const description = document.createElement('p');
+        description.textContent = coffee.description;
+        const details = document.createElement('small');
+        details.textContent = `Served ${coffee.temperature} · View menu details above`;
+        item.append(link, description, details);
+        results.append(item);
+      }
+
+      response = {
+        status: 'success',
+        preferences: { flavor, temperature },
+        count: matches.length,
+        message: status.textContent,
+        recommendations: matches,
+      };
+    }
+
+    // Return the same visible results to agents in supporting WebMCP browsers.
+    if (event.agentInvoked && typeof event.respondWith === 'function') {
+      event.respondWith(Promise.resolve(JSON.stringify(response)));
+    }
+  });
+
+  form.addEventListener('reset', () => {
+    results.replaceChildren();
+    heading.textContent = initialHeading;
+    status.textContent = initialStatus;
+  });
+
+  document.getElementById('find-coffee-submit').disabled = false;
+})();
