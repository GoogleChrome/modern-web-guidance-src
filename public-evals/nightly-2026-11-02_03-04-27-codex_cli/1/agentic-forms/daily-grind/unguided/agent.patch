+(() => {
+  'use strict';
+
+  const coffees = [
+    {
+      name: 'Maple Oat Latte', temperature: 'hot', flavor: 'sweet',
+      description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+      url: '/menu/seasonal',
+    },
+    {
+      name: 'Dark Roast Espresso', temperature: 'hot', flavor: 'bold',
+      description: 'Bold, smokey, and perfect for a morning boost.',
+      url: '/menu/espresso',
+    },
+    {
+      name: 'Cold Brew', temperature: 'cold', flavor: 'smooth',
+      description: 'Steeped for 18 hours for maximum smoothness.',
+      url: '/menu/cold-brew',
+    },
+  ];
+
+  const form = document.getElementById('coffee-finder-form');
+  const recommendation = document.getElementById('coffee-recommendation');
+
+  function findCoffee() {
+    const data = new FormData(form);
+    const temperature = data.get('temperature');
+    const flavor = data.get('flavor');
+
+    // Validate again for programmatic submissions that bypass native validation.
+    if (!['hot', 'cold', 'either'].includes(temperature) ||
+        !['bold', 'smooth', 'sweet', 'any'].includes(flavor)) {
+      return { status: 'error', message: 'Choose a valid temperature and flavor.' };
+    }
+
+    const temperatureMatches = (coffee) => temperature === 'either' || coffee.temperature === temperature;
+    const flavorMatches = (coffee) => flavor === 'any' || coffee.flavor === flavor;
+    // Honor serving temperature first, then choose the closest flavor.
+    const score = (coffee) => Number(temperatureMatches(coffee)) * 2 + Number(flavorMatches(coffee));
+    const coffee = coffees.reduce((best, candidate) => score(candidate) > score(best) ? candidate : best);
+    const exactMatch = temperatureMatches(coffee) && flavorMatches(coffee);
+    const message = exactMatch
+      ? 'Your coffee match'
+      : `Closest match: no ${temperature} seasonal favorite has a ${flavor} profile. Try this ${coffee.flavor} favorite instead.`;
+
+    document.getElementById('coffee-match').textContent = message;
+    document.getElementById('coffee-name').textContent = coffee.name;
+    document.getElementById('coffee-description').textContent = coffee.description;
+    document.getElementById('coffee-preferences').textContent =
+      `Your preferences: ${temperature === 'either' ? 'any temperature' : temperature} · ${flavor === 'any' ? 'any flavor' : flavor}. Served ${coffee.temperature}.`;
+    const details = document.getElementById('coffee-details');
+    details.href = coffee.url;
+    details.textContent = `Explore ${coffee.name}`;
+    recommendation.hidden = false;
+
+    return {
+      status: 'success', preferences: { temperature, flavor },
+      exactMatch, recommendation: { ...coffee }, message,
+    };
+  }
+
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    const result = findCoffee();
+    if (result.status === 'error') {
+      recommendation.hidden = true;
+      form.reportValidity();
+    }
+    // Declarative WebMCP agents receive the same result displayed to visitors.
+    if (event.agentInvoked && typeof event.respondWith === 'function') {
+      event.respondWith(Promise.resolve(result));
+    }
+  });
+
+  function clearRecommendation() {
+    recommendation.hidden = true;
+  }
+
+  form.addEventListener('input', clearRecommendation);
+  form.addEventListener('change', clearRecommendation);
+  form.addEventListener('reset', clearRecommendation);
+})();
