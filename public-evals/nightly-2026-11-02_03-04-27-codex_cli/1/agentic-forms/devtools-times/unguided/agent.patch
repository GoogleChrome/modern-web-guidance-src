diff --git a/src/hooks/useAuthForm.ts b/src/hooks/useAuthForm.ts
new file mode 100644
index 0000000..77c9de8
--- /dev/null
+++ b/src/hooks/useAuthForm.ts
@@ -0,0 +1,78 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import type { FormEvent } from 'react';
+import { isCredentials, submitAuth } from '../utils/auth';
+import type { AuthAction, AuthResult, Credentials } from '../utils/auth';
+import { registerAgentTool } from '../utils/webmcp';
+
+export function useAuthForm(action: AuthAction) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const pending = useRef(false);
+
+  const submit = useCallback(async (credentials: Credentials): Promise<AuthResult> => {
+    if (pending.current) return { ok: false, message: 'A submission is already in progress.' };
+    pending.current = true;
+    setError(null);
+    setSuccess(null);
+    setLoading(true);
+    try {
+      setUsername(credentials.username);
+      setPassword(credentials.password);
+      const result = await submitAuth(action, credentials);
+      if (result.ok) {
+        setSuccess(result.message);
+        if (action === 'register') {
+          setUsername('');
+          setPassword('');
+        }
+      } else {
+        setError(result.message);
+      }
+      return result;
+    } finally {
+      pending.current = false;
+      setLoading(false);
+    }
+  }, [action]);
+
+  useEffect(() => {
+    const cleanup = registerAgentTool({
+      name: action === 'login' ? 'sign_in' : 'sign_up',
+      description: action === 'login'
+        ? 'Sign in to The DevTools Times using a username and password. Returns the login result and updates the sign-in form.'
+        : 'Create a DevTools Times account using a username and password. Passwords must be at least 8 characters and contain a number. Returns the registration result and updates the sign-up form.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          username: { type: 'string', minLength: 1, description: 'Account username.' },
+          password: { type: 'string', minLength: 1, description: 'Account password.' },
+        },
+        required: ['username', 'password'],
+        additionalProperties: false,
+      },
+      execute: async (input) => {
+        if (!isCredentials(input)) {
+          return { isError: true, content: [{ type: 'text', text: 'Username and password are required.' }] };
+        }
+        const result = await submit({ username: input.username, password: input.password });
+        return { isError: !result.ok, content: [{ type: 'text', text: result.message }] };
+      },
+    });
+    // Astro's router swaps pages without a full document reload.
+    document.addEventListener('astro:before-swap', cleanup, { once: true });
+    return () => {
+      document.removeEventListener('astro:before-swap', cleanup);
+      cleanup();
+    };
+  }, [action, submit]);
+
+  const handleSubmit = async (event: FormEvent) => {
+    event.preventDefault();
+    await submit({ username, password });
+  };
+
+  return { username, setUsername, password, setPassword, error, success, loading, handleSubmit };
+}
diff --git a/src/utils/auth.ts b/src/utils/auth.ts
new file mode 100644
index 0000000..42e74da
--- /dev/null
+++ b/src/utils/auth.ts
@@ -0,0 +1,41 @@
+export type AuthAction = 'login' | 'register';
+export interface Credentials {
+  username: string;
+  password: string;
+}
+export interface AuthResult {
+  ok: boolean;
+  message: string;
+}
+
+export function isCredentials(value: unknown): value is Credentials {
+  if (!value || typeof value !== 'object') return false;
+  const { username, password } = value as Partial<Credentials>;
+  return typeof username === 'string' && username.length > 0 &&
+    typeof password === 'string' && password.length > 0;
+}
+
+// Both the UI and agent tools use this request. Never return credentials or tokens.
+export async function submitAuth(action: AuthAction, credentials: Credentials): Promise<AuthResult> {
+  if (!isCredentials(credentials)) {
+    return { ok: false, message: 'Username and password are required.' };
+  }
+  try {
+    const response = await fetch(`https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(credentials),
+    });
+    const data = await response.json();
+    if (!response.ok) {
+      const prefix = action === 'login' ? 'Login failed' : 'Registration failed';
+      return { ok: false, message: `${prefix}: ${data?.error || 'Unknown error'}` };
+    }
+    return {
+      ok: true,
+      message: action === 'login' ? 'Login successful!' : 'User registered successfully! You can now sign in.',
+    };
+  } catch {
+    return { ok: false, message: 'An unexpected error occurred. Please try again later.' };
+  }
+}
diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..3bb40ea
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,49 @@
+export interface AgentTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  execute: (input: unknown) => Promise<unknown>;
+}
+
+interface ModelContext {
+  registerTool: (tool: AgentTool, options?: { signal: AbortSignal }) => void | Promise<void>;
+  unregisterTool?: (name: string) => void;
+}
+
+// Support both the current draft and the navigator-based early preview.
+export function registerAgentTool(tool: AgentTool): () => void {
+  const context = (document as Document & { modelContext?: ModelContext }).modelContext ??
+    (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+  if (!context?.registerTool) return () => {};
+
+  const controller = new AbortController();
+  let registered = false;
+  let disposed = false;
+  const unregister = () => {
+    controller.abort();
+    if (registered) {
+      context.unregisterTool?.(tool.name);
+      registered = false;
+    }
+  };
+  try {
+    const registration = context.registerTool(tool, { signal: controller.signal });
+    if (registration instanceof Promise) {
+      void registration.then(() => {
+        registered = true;
+        if (disposed) unregister();
+      }).catch(() => {
+        // Tool availability must not prevent normal form interaction.
+        console.warn(`Could not register agent tool: ${tool.name}`);
+      });
+    } else {
+      registered = true;
+    }
+  } catch {
+    console.warn(`Could not register agent tool: ${tool.name}`);
+  }
+  return () => {
+    disposed = true;
+    unregister();
+  };
+}
diff --git a/tests/agent-tools.test.mjs b/tests/agent-tools.test.mjs
new file mode 100644
index 0000000..0e31427
--- /dev/null
+++ b/tests/agent-tools.test.mjs
@@ -0,0 +1,94 @@
+import { test, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { submitAuth } from '../src/utils/auth.ts';
+import { registerAgentTool } from '../src/utils/webmcp.ts';
+
+const originalFetch = globalThis.fetch;
+const originalDocument = Object.getOwnPropertyDescriptor(globalThis, 'document');
+const originalNavigator = Object.getOwnPropertyDescriptor(globalThis, 'navigator');
+afterEach(() => {
+  globalThis.fetch = originalFetch;
+  for (const [key, descriptor] of [['document', originalDocument], ['navigator', originalNavigator]]) {
+    if (descriptor) Object.defineProperty(globalThis, key, descriptor);
+    else delete globalThis[key];
+  }
+});
+function environment(documentContext, navigatorContext) {
+  Object.defineProperty(globalThis, 'document', { configurable: true, value: { modelContext: documentContext } });
+  Object.defineProperty(globalThis, 'navigator', { configurable: true, value: { modelContext: navigatorContext } });
+}
+const credentials = { username: 'reader', password: 'secret123' };
+const tool = { name: 'sign_in', description: 'Sign in', inputSchema: {}, execute: async () => ({ ok: true }) };
+
+for (const action of ['login', 'register']) {
+  test(`${action} sends existing API payload and omits tokens from results`, async () => {
+    globalThis.fetch = async (url, options) => {
+      assert.equal(url, `https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`);
+      assert.equal(options.method, 'POST');
+      assert.equal(options.headers['Content-Type'], 'application/json');
+      assert.deepEqual(JSON.parse(options.body), credentials);
+      return { ok: true, json: async () => ({ token: 'private-token' }) };
+    };
+    const result = await submitAuth(action, credentials);
+    assert.equal(result.ok, true);
+    assert.equal(JSON.stringify(result).includes('private-token'), false);
+    assert.match(result.message, action === 'login' ? /Login successful/ : /registered successfully/);
+  });
+}
+
+test('validation rejects empty and malformed credentials without a request', async () => {
+  globalThis.fetch = () => assert.fail('Validation must happen before fetch');
+  for (const input of [null, {}, { username: 'reader', password: '' }, { username: 4, password: 'test' }]) {
+    assert.equal((await submitAuth('login', input)).ok, false);
+  }
+});
+
+test('API errors remain visible in agent results', async () => {
+  globalThis.fetch = async () => ({ ok: false, json: async () => ({ error: 'APP_ERR_2001' }) });
+  assert.deepEqual(await submitAuth('login', credentials), { ok: false, message: 'Login failed: APP_ERR_2001' });
+  assert.deepEqual(await submitAuth('register', credentials), { ok: false, message: 'Registration failed: APP_ERR_2001' });
+});
+
+test('network and malformed JSON errors produce safe failure messages', async () => {
+  for (const response of [() => { throw Error('private network details'); }, () => ({ json: async () => { throw Error('invalid JSON'); } })]) {
+    globalThis.fetch = response;
+    assert.deepEqual(await submitAuth('login', credentials), {
+      ok: false, message: 'An unexpected error occurred. Please try again later.',
+    });
+  }
+});
+
+test('unsupported browsers leave forms usable', () => {
+  environment();
+  assert.doesNotThrow(() => registerAgentTool(tool)());
+});
+
+test('preview tools are registered and unregistered once', () => {
+  let registered;
+  const removed = [];
+  environment(undefined, {
+    registerTool: (value) => { registered = value; },
+    unregisterTool: (name) => removed.push(name),
+  });
+  const cleanup = registerAgentTool(tool);
+  assert.equal(registered, tool);
+  cleanup();
+  cleanup();
+  assert.deepEqual(removed, ['sign_in']);
+});
+
+test('current draft registration aborts on cleanup even before registration resolves', async () => {
+  let signal;
+  let resolveRegistration;
+  environment({ registerTool: (value, options) => {
+    assert.equal(value, tool);
+    signal = options.signal;
+    return new Promise(resolve => { resolveRegistration = resolve; });
+  } });
+  const cleanup = registerAgentTool(tool);
+  assert.equal(signal.aborted, false);
+  cleanup();
+  assert.equal(signal.aborted, true);
+  resolveRegistration();
+  await Promise.resolve();
+});
