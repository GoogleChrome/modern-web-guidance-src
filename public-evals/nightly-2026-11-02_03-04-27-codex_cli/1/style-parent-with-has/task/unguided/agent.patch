+    /* Contact form */
+    .contact {
+      max-width: 640px;
+      margin: 40px auto 0;
+      padding: 24px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .contact h2 {
+      margin-bottom: 8px;
+    }
+
+    .contact-field {
+      margin-top: 16px;
+      padding: 12px;
+      border: 2px solid var(--secondary);
+      border-radius: 5px;
+    }
+
+    .contact-field label {
+      display: block;
+      margin-bottom: 6px;
+      font-weight: 600;
+    }
+
+    .contact-field input,
+    .contact-field textarea {
+      display: block;
+      width: 100%;
+      padding: 8px;
+      border: 1px solid var(--secondary);
+      border-radius: 3px;
+      font: inherit;
+      color: inherit;
+      background: var(--light);
+    }
+
+    .contact-field textarea {
+      resize: vertical;
+    }
+
+    .contact-field input:focus-visible,
+    .contact-field textarea:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    /* Wait for interaction or a submission attempt before showing errors. */
+    .contact-field:has(:user-invalid) {
+      border-color: #b91c1c;
+    }
+
+    .contact-error {
+      display: none;
+      margin-top: 6px;
+      color: #b91c1c;
+      font-size: 0.875rem;
+    }
+
+    .contact-field:has(:user-invalid) .contact-error {
+      display: block;
+    }
+
+    .contact button {
+      border: 0;
+      font: inherit;
+      cursor: pointer;
+    }
+
     footer {
