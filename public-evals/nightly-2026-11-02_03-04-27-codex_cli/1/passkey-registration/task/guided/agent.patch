+  <!-- Only the JSON polyfills are needed; capability APIs are feature-detected below. -->
+  <script type="importmap">
+    {
+      "imports": {
+        "webauthn-polyfills": "./node_modules/webauthn-polyfills/esm/json_serialization.js"
+      }
+    }
+  </script>
+  <script type="module">
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const status = document.querySelector('#passkey-status');
+
+    async function initializePasskeys() {
+      if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.create) {
+        status.textContent = 'Passkeys require a supported browser and a secure connection.';
+        return;
+      }
+
+      try {
+        await import('webauthn-polyfills');
+        if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          if (!capabilities.conditionalGet || !capabilities.passkeyPlatformAuthenticator) {
+            status.textContent = 'Passkey creation is not available on this device. You can keep using your usual sign-in method.';
+            return;
+          }
+        } else {
+          // Older browsers can still support platform passkeys and conditional sign-in.
+          const platform = await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable?.();
+          const conditional = await PublicKeyCredential.isConditionalMediationAvailable?.();
+          if (!platform || !conditional) {
+            status.textContent = 'Passkey creation is not available on this device. You can keep using your usual sign-in method.';
+            return;
+          }
+        }
+        registerButton.disabled = false;
+        status.textContent = '';
+      } catch {
+        status.textContent = 'Unable to check passkey support. Please reload to try again.';
+      }
+    }
+
+    async function postJSON(url, body) {
+      return fetch(url, {
+        method: 'POST',
+        credentials: 'same-origin',
+        mode: 'same-origin',
+        redirect: 'error',
+        cache: 'no-store',
+        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+        body: JSON.stringify(body),
+      });
+    }
+
+    registerButton.addEventListener('click', async () => {
+      if (registerButton.disabled) return;
+      registerButton.disabled = true;
+      registerButton.setAttribute('aria-busy', 'true');
+      status.textContent = 'Follow your device’s instructions to create a passkey…';
+
+      try {
+        const optionsResponse = await postJSON('/api/register/options', { promotion: true });
+        if (!optionsResponse.ok) throw new Error('Unable to start passkey registration. Please try again.');
+
+        // Challenges, account IDs, RP settings, and exclusions come from the server.
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsResponse.json());
+        const credential = await navigator.credentials.create({ publicKey });
+        if (!credential) {
+          status.textContent = 'No passkey was created. You can try again.';
+          return;
+        }
+        const encodedResponse = credential.toJSON();
+
+        // Only verification failures should signal an unrecognized credential.
+        try {
+          const verificationResponse = await postJSON('/api/register/verify', encodedResponse);
+          if (!verificationResponse.ok) throw new Error('Verification failed.');
+          if (verificationResponse.headers.get('content-type')?.includes('application/json')) {
+            const result = await verificationResponse.json();
+            if (result?.verified === false) throw new Error('Verification failed.');
+          }
+        } catch {
+          if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: publicKey.rp.id || location.hostname,
+                credentialId: encodedResponse.id,
+              });
+            } catch {
+              // Synchronization is best-effort; retain the original verification error.
+            }
+          }
+          throw new Error('Unable to verify your passkey. Please try registering again.');
+        }
+
+        status.textContent = 'Your passkey was registered successfully.';
+      } catch (error) {
+        const messages = {
+          InvalidStateError: 'A passkey already exists for this account on this authenticator.',
+          NotAllowedError: 'Passkey creation was cancelled or timed out. You can try again.',
+          AbortError: 'Passkey creation was interrupted. You can try again.',
+          SecurityError: 'Passkey creation is unavailable because of a secure connection or site configuration issue.',
+          NotSupportedError: 'This device does not support the requested passkey settings.',
+        };
+        // Never render server-provided text as markup or expose credential data.
+        status.textContent = messages[error.name] || (error.name === 'Error'
+          ? error.message : 'Unable to register your passkey. Please try again.');
+      } finally {
+        registerButton.disabled = false;
+        registerButton.removeAttribute('aria-busy');
+      }
+    });
+
+    initializePasskeys();
+  </script>
 </body>
 
