+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const shippingReview = document.getElementById('shipping-review');
+
+    shippingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const details = new FormData(shippingForm);
+      const address = ['name', 'street-address', 'city', 'region', 'postal-code', 'country', 'email', 'phone']
+        .map((field) => details.get(field).trim())
+        .filter(Boolean);
+      shippingReview.textContent = ['Review your shipping details:', ...address, 'Your address has not been saved and no order has been placed.'].join('\n');
+    });
+
+    shippingForm.addEventListener('input', () => {
+      shippingReview.textContent = '';
+    });
+  </script>
