+
+    /* Native disclosures keep keyboard behavior and expanded state in sync. */
+    #faq-trigger,
+    #alert-dismiss {
+      cursor: pointer;
+      list-style: none;
+    }
+
+    #faq-trigger::-webkit-details-marker,
+    #alert-dismiss::-webkit-details-marker {
+      display: none;
+    }
+
+    #faq-trigger:focus-visible,
+    #alert-dismiss:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: -4px;
+    }
+
+    #promo-alert {
+      position: relative;
+      background: var(--accent);
+      block-size: auto;
+      overflow: hidden;
+    }
+
+    #promo-alert:not([open]) {
+      block-size: 0;
+    }
+
+    .promo-message {
+      padding: 14px 64px 14px 5%;
+    }
+
+    #alert-dismiss {
+      position: absolute;
+      inset-block-start: 4px;
+      inset-inline-end: 12px;
+      display: grid;
+      place-items: center;
+      inline-size: 44px;
+      block-size: 44px;
+      font-size: 1.5rem;
+      border-radius: 4px;
+    }
+
+    #alert-dismiss:hover {
+      background: rgb(78 52 46 / 10%);
+    }
+
+    /* Remove the dismissed control from keyboard and assistive navigation. */
+    #promo-alert:not([open]) > summary {
+      visibility: hidden;
+    }
+
+    .faq {
+      margin-top: 40px;
+    }
+
+    .faq details {
+      margin-top: 16px;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+    }
+
+    #faq-trigger {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 16px;
+      padding: 20px;
+      font-weight: 600;
+    }
+
+    #faq-trigger::after {
+      content: '+';
+      font-size: 1.5rem;
+      line-height: 1;
+    }
+
+    details[open] > #faq-trigger::after {
+      content: '\2212';
+    }
+
+    #faq-content {
+      overflow: hidden;
+    }
+
+    .faq-answer {
+      padding: 0 20px 20px;
+    }
+
+    /* Unsupported browsers retain the instant, fully functional disclosures. */
+    @supports (interpolate-size: allow-keywords) and selector(details::details-content) {
+      #promo-alert,
+      #faq-content {
+        transition: block-size 400ms ease;
+      }
+
+      .faq details #faq-content {
+        block-size: 0;
+      }
+
+      .faq details[open] #faq-content {
+        block-size: auto;
+      }
+
+      /* Keep content rendered until its closing height transition finishes. */
+      #promo-alert::details-content,
+      .faq details::details-content {
+        transition: content-visibility 400ms allow-discrete;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #promo-alert,
+      #faq-content,
+      #promo-alert::details-content,
+      .faq details::details-content {
+        transition: none;
+      }
+    }
   </style>
