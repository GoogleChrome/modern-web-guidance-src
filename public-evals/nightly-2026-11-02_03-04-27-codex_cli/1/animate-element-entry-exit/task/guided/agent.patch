+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const toggleBtn = document.getElementById('toggleBtn');
+    let promoNumber = 0;
+
+    function updateControls() {
+      removeBtn.disabled = !domContainer.querySelector('.card:not([data-removing])');
+      toggleBtn.disabled = !toggleCard.isConnected || toggleCard.hasAttribute('data-removing');
+    }
+
+    async function hideCard(card) {
+      // Keep the card rendered until its exit finishes, including in browsers
+      // that parse allow-discrete but cannot transition display.
+      card.setAttribute('data-closing', '');
+      const animations = card.getAnimations();
+      if (animations.length) {
+        let timeout;
+        await Promise.race([
+          Promise.allSettled(animations.map(animation => animation.finished)),
+          new Promise(resolve => { timeout = setTimeout(resolve, 1000); })
+        ]);
+        clearTimeout(timeout);
+      }
+      // A second toggle can cancel an in-progress hide.
+      if (card.hasAttribute('data-closing')) {
+        card.hidden = true;
+        card.removeAttribute('data-closing');
+      }
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = `Coffee Break Promo ${++promoNumber}`;
+      const description = document.createElement('p');
+      description.textContent = 'Explore our seasonal roasts and find your next daily favorite.';
+      card.append(heading, description);
+      domContainer.append(card);
+      updateControls();
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const cards = domContainer.querySelectorAll('.card:not([data-removing])');
+      const card = cards[cards.length - 1];
+      if (!card) return;
+      card.setAttribute('data-removing', '');
+      updateControls();
+      await hideCard(card);
+      card.remove();
+      updateControls();
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      if (toggleCard.hidden || toggleCard.hasAttribute('data-closing')) {
+        toggleCard.removeAttribute('data-closing');
+        toggleCard.hidden = false;
+        toggleBtn.setAttribute('aria-expanded', 'true');
+        toggleBtn.textContent = 'Hide featured promo';
+      } else {
+        hideCard(toggleCard);
+        toggleBtn.setAttribute('aria-expanded', 'false');
+        toggleBtn.textContent = 'Show featured promo';
+      }
+    });
+  </script>
+
 </body>
 
