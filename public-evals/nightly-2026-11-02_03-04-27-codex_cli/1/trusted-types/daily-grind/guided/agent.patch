--- /dev/null
+++ b/test/safe-html.test.js
@@ -0,0 +1,115 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import test from 'node:test';
+import { JSDOM } from 'jsdom';
+import { safeSetHTML } from '../src/safe-html.js';
+import { seasonalFavorites } from '../src/seasonal-favorites.js';
+
+function fixture() {
+  return new JSDOM('<div id="cards"></div>', { url: 'https://daily-grind.example/' });
+}
+
+test('renders all three cards with their original content, styles and destinations', async () => {
+  const dom = fixture();
+  const container = dom.window.document.getElementById('cards');
+  await safeSetHTML(container, seasonalFavorites.join(''));
+  assert.equal(container.querySelectorAll('.card').length, 3);
+  assert.deepEqual([...container.querySelectorAll('h3')].map((el) => el.textContent),
+    ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew']);
+  assert.deepEqual([...container.querySelectorAll('a.btn')].map((el) => el.getAttribute('href')),
+    ['/menu/seasonal', '/menu/espresso', '/menu/cold-brew']);
+  assert.equal(container.querySelectorAll('p').length, 3);
+  dom.window.close();
+});
+
+const attacks = [
+  '<script>alert(1)</script><p onclick="alert(1)">Coffee</p>',
+  '<img src=x onerror=alert(1)><div onmouseover="alert(1)">Coffee</div>',
+  '<a href="javascript:alert(1)">Coffee</a>',
+  '<a href="java&#x73;cript:alert(1)">Coffee</a>',
+  '<a href="jav&#x09;ascript:alert(1)">Coffee</a>',
+  '<a href="data:text/html,<script>alert(1)</script>">Coffee</a>',
+  '<svg><a href="javascript:alert(1)">Coffee</a></svg>',
+  '<math><mtext><table><mglyph><style><!--</style><img title="--><img src=x onerror=alert(1)>">',
+  '<iframe srcdoc="<script>alert(1)</script>"></iframe><object data="javascript:alert(1)"></object>',
+  '<form id="seasonal-favorites"><input name="innerHTML"></form>',
+  '<div id="cards" name="cards" style="color:red" data-payload="x" aria-label="x">Coffee</div>',
+  '<template><img src=x onerror=alert(1)></template>',
+];
+
+for (const [index, attack] of attacks.entries()) {
+  test(`fallback strips XSS payload ${index + 1}`, async () => {
+    const dom = fixture();
+    const container = dom.window.document.getElementById('cards');
+    await safeSetHTML(container, attack);
+    for (const element of container.querySelectorAll('*')) {
+      assert.ok(['DIV', 'H3', 'P', 'A'].includes(element.tagName));
+      for (const attribute of element.attributes) {
+        assert.ok(['class', 'href'].includes(attribute.name));
+        if (attribute.name === 'href') {
+          assert.ok(!/^(javascript|data|vbscript):/i.test(attribute.value.replace(/\s/g, '')));
+        }
+      }
+    }
+    dom.window.close();
+  });
+}
+
+test('native branch passes the restrictive sanitizer configuration without touching innerHTML', async () => {
+  let received;
+  const element = {
+    setHTML(html, options) { received = { html, options }; },
+    set innerHTML(_) { assert.fail('Native branch must not use innerHTML'); },
+  };
+  await safeSetHTML(element, '<p>Native</p>');
+  assert.deepEqual(received, {
+    html: '<p>Native</p>',
+    options: { sanitizer: { elements: ['div', 'h3', 'p', 'a'], attributes: ['class', 'href'] } },
+  });
+});
+
+test('fallback returns TrustedHTML when Trusted Types is available and reuses its policy', async () => {
+  const dom = fixture();
+  const container = dom.window.document.getElementById('cards');
+  class TrustedHTML {
+    constructor(value) { this.value = value; }
+    toString() { return this.value; }
+  }
+  const policies = [];
+  dom.window.trustedTypes = {
+    createPolicy(name, rules) {
+      assert.equal(name, 'dompurify');
+      assert.ok(!policies.includes(name), 'Policy must only be created once');
+      policies.push(name);
+      return {
+        createHTML: (input) => new TrustedHTML(rules.createHTML(input)),
+        createScriptURL: rules.createScriptURL,
+      };
+    },
+  };
+  const descriptor = Object.getOwnPropertyDescriptor(dom.window.Element.prototype, 'innerHTML');
+  Object.defineProperty(container, 'innerHTML', {
+    get() { return descriptor.get.call(this); },
+    set(value) {
+      assert.ok(value instanceof TrustedHTML);
+      descriptor.set.call(this, String(value));
+    },
+  });
+  await safeSetHTML(container, '<p onclick="alert(1)">Coffee</p>');
+  await safeSetHTML(container, '<p>Latte</p>');
+  assert.equal(container.innerHTML, '<p>Latte</p>');
+  assert.deepEqual(policies, ['dompurify']);
+  dom.window.close();
+});
+
+test('homepage enforces Trusted Types before loading application scripts', async () => {
+  const html = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+  const dom = new JSDOM(html);
+  const meta = dom.window.document.querySelector('meta[http-equiv="Content-Security-Policy"]');
+  assert.ok(meta.content.includes("require-trusted-types-for 'script'"));
+  assert.ok(meta.content.includes('trusted-types dompurify;'));
+  assert.ok(html.indexOf('Content-Security-Policy') < html.indexOf('<script'));
+  assert.equal(dom.window.document.querySelectorAll('#seasonal-favorites .card').length, 0);
+  assert.ok(dom.window.document.querySelector('script[type="module"][src="/src/main.js"]'));
+  dom.window.close();
+});
