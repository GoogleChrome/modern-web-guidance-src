+import { safeSetHTML } from './safe-html.js';
+import { seasonalFavorites } from './seasonal-favorites.js';
+
+const container = document.getElementById('seasonal-favorites');
+
+safeSetHTML(container, seasonalFavorites.join('')).catch((error) => {
+  // A failed sanitizer must never fall back to inserting the original HTML.
+  container.textContent = 'Seasonal favorites are unavailable. Please try again later.';
+  console.error('Unable to render seasonal favorites:', error);
+});
diff --git a/src/safe-html.js b/src/safe-html.js
new file mode 100644
index 0000000..6de54f1
--- /dev/null
+++ b/src/safe-html.js
@@ -0,0 +1,31 @@
+const elements = ['div', 'h3', 'p', 'a'];
+const attributes = ['class', 'href'];
+const purifiers = new WeakMap();
+
+// Keep all HTML-string insertion here. Never modify markup after sanitizing it.
+export async function safeSetHTML(element, html) {
+  if ('setHTML' in element) {
+    element.setHTML(html, { sanitizer: { elements, attributes } });
+    return;
+  }
+
+  // Load the fallback only in browsers without the native Sanitizer API.
+  const { default: createDOMPurify } = await import('dompurify');
+  const view = element.ownerDocument.defaultView;
+  let purifier = purifiers.get(view);
+  if (!purifier) {
+    purifier = createDOMPurify(view);
+    purifiers.set(view, purifier);
+  }
+
+  // DOMPurify returns TrustedHTML when supported, a sanitized string otherwise.
+  // The page's CSP permits only its internal 'dompurify' Trusted Types policy.
+  element.innerHTML = purifier.sanitize(html, {
+    ALLOWED_TAGS: [...elements, '#text'],
+    ALLOWED_ATTR: attributes,
+    ALLOW_ARIA_ATTR: false,
+    ALLOW_DATA_ATTR: false,
+    KEEP_CONTENT: false,
+    RETURN_TRUSTED_TYPE: true,
+  });
+}
