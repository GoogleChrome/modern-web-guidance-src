+import { copyFile, mkdir } from 'node:fs/promises';
+
+const vendor = new URL('../vendor/', import.meta.url);
+await mkdir(vendor, { recursive: true });
+for (const filename of ['purify.min.js', 'purify.min.js.map']) {
+  await copyFile(
+    new URL(`../node_modules/dompurify/dist/${filename}`, import.meta.url),
+    new URL(filename, vendor),
+  );
+}
+await copyFile(
+  new URL('../node_modules/dompurify/LICENSE', import.meta.url),
+  new URL('DOMPurify-LICENSE', vendor),
+);
diff --git a/seasonal-favorites.js b/seasonal-favorites.js
new file mode 100644
index 0000000..d3ed68f
--- /dev/null
+++ b/seasonal-favorites.js
@@ -0,0 +1,30 @@
+import { createHTMLSanitizer, renderCards } from './safe-html.js';
+
+export const seasonalFavorites = [
+  `<div class="card">
+    <h3>Maple Oat Latte</h3>
+    <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+    <a href="/menu/seasonal" class="btn">View Details</a>
+  </div>`,
+  `<div class="card">
+    <h3>Dark Roast Espresso</h3>
+    <p>Bold, smokey, and perfect for a morning boost.</p>
+    <a href="/menu/espresso" class="btn">View Details</a>
+  </div>`,
+  `<div class="card">
+    <h3>Cold Brew</h3>
+    <p>Steeped for 18 hours for maximum smoothness.</p>
+    <a href="/menu/cold-brew" class="btn">View Details</a>
+  </div>`,
+];
+
+const container = document.getElementById('seasonal-favorites');
+
+try {
+  const sanitizeHTML = createHTMLSanitizer(window.DOMPurify, window.trustedTypes);
+  renderCards(container, seasonalFavorites, sanitizeHTML);
+} catch (error) {
+  // Fail closed if the sanitizer or policy cannot initialize.
+  container.textContent = 'Seasonal favorites are unavailable. Please browse our menu.';
+  console.error('Unable to render seasonal favorites:', error);
+}
diff --git a/tests/seasonal-favorites.test.js b/tests/seasonal-favorites.test.js
new file mode 100644
index 0000000..c47cf41
--- /dev/null
+++ b/tests/seasonal-favorites.test.js
@@ -0,0 +1,120 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import test from 'node:test';
+import { JSDOM } from 'jsdom';
+import createDOMPurify from 'dompurify';
+import { createHTMLSanitizer, renderCards } from '../safe-html.js';
+
+const homepage = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+const vendorScript = await readFile(new URL('../vendor/purify.min.js', import.meta.url), 'utf8');
+
+test('homepage renders the original cards using the shipped sanitizer', async () => {
+  const dom = new JSDOM(homepage, { runScripts: 'outside-only' });
+  dom.window.eval(vendorScript);
+  globalThis.window = dom.window;
+  globalThis.document = dom.window.document;
+  try {
+    await import('../seasonal-favorites.js');
+    const cards = [...document.querySelectorAll('#seasonal-favorites .card')];
+    assert.deepEqual(cards.map((card) => card.querySelector('h3').textContent), [
+      'Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew',
+    ]);
+    assert.deepEqual(cards.map((card) => card.querySelector('a').getAttribute('href')), [
+      '/menu/seasonal', '/menu/espresso', '/menu/cold-brew',
+    ]);
+    assert.ok(cards.every((card) => card.querySelector('p').textContent.length > 0));
+  } finally {
+    delete globalThis.window;
+    delete globalThis.document;
+    dom.window.close();
+  }
+});
+
+test('sanitizes XSS payloads even when Trusted Types is unavailable', () => {
+  const { window } = new JSDOM('<div id="cards"></div>');
+  const sanitizeHTML = createHTMLSanitizer(createDOMPurify(window));
+  const container = window.document.getElementById('cards');
+  const payloads = [
+    '<script>alert(1)</script><p>Safe description</p>',
+    '<img src=x onerror=alert(1)><div class="card" onclick="alert(1)">Coffee</div>',
+    '<a href="javascript:alert(1)">bad link</a>',
+    '<a href="java&#x09;script:alert(1)">encoded link</a>',
+    '<a href="data:text/html,<script>alert(1)</script>">data link</a>',
+    '<svg onload=alert(1)><a xlink:href="javascript:alert(1)">svg</a></svg>',
+    '<iframe srcdoc="<script>alert(1)</script>"></iframe>',
+    '<form id="seasonal-favorites"><input name="innerHTML"></form>',
+    '<math><mtext><table><mglyph><style><!--</style><img title="--><img src=x onerror=alert(1)>">',
+    '<p style="background:url(javascript:alert(1))" data-x="payload">Text</p>',
+  ];
+
+  for (const payload of payloads) {
+    renderCards(container, [payload], sanitizeHTML);
+    for (const element of container.querySelectorAll('*')) {
+      assert.ok(['DIV', 'H3', 'P', 'A'].includes(element.tagName), payload);
+      for (const attribute of element.attributes) {
+        assert.ok(['class', 'href'].includes(attribute.name), payload);
+        if (attribute.name === 'href') {
+          assert.doesNotMatch(attribute.value.replace(/\s/g, ''), /^(javascript|data|vbscript):/i);
+        }
+      }
+    }
+  }
+  renderCards(container, ['<div class="card"><h3>Coffee &amp; cream</h3><a class="btn" href="/menu">Details</a></div>'], sanitizeHTML);
+  assert.equal(container.querySelector('h3').textContent, 'Coffee & cream');
+  assert.equal(container.querySelector('a').getAttribute('href'), '/menu');
+  window.close();
+});
+
+test('Trusted Types policy sanitizes before branding and inserting HTML', () => {
+  const { window } = new JSDOM('');
+  const policies = [];
+  const trustedTypes = {
+    createPolicy(name, rules) {
+      policies.push(name);
+      assert.deepEqual(Object.keys(rules), ['createHTML']);
+      return { createHTML: (input) => Object.freeze({ trustedHTML: rules.createHTML(input) }) };
+    },
+  };
+  const sanitizeHTML = createHTMLSanitizer(createDOMPurify(window), trustedTypes);
+  const container = {};
+  renderCards(container, ['<p onclick="alert(1)">Coffee</p><script>alert(1)</script>'], sanitizeHTML);
+  assert.deepEqual(policies, ['seasonal-favorites']);
+  assert.equal(container.innerHTML.trustedHTML, '<p>Coffee</p>');
+  window.close();
+});
+
+test('fails closed if DOMPurify is absent or unsupported', () => {
+  assert.throws(() => createHTMLSanitizer(undefined), /unavailable/);
+  assert.throws(() => createHTMLSanitizer({ isSupported: false }), /unavailable/);
+});
+
+test('homepage displays safe fallback text when its sanitizer fails to load', async () => {
+  const dom = new JSDOM(homepage);
+  globalThis.window = dom.window;
+  globalThis.document = dom.window.document;
+  const originalConsoleError = console.error;
+  console.error = () => {};
+  try {
+    await import('../seasonal-favorites.js?sanitizer-unavailable');
+    const container = document.getElementById('seasonal-favorites');
+    assert.equal(container.children.length, 0);
+    assert.match(container.textContent, /Seasonal favorites are unavailable/);
+  } finally {
+    console.error = originalConsoleError;
+    delete globalThis.window;
+    delete globalThis.document;
+    dom.window.close();
+  }
+});
+
+test('CSP enforces Trusted Types and blocks inline scripts', () => {
+  const { window } = new JSDOM(homepage);
+  const policy = window.document.querySelector('meta[http-equiv="Content-Security-Policy"]').content;
+  assert.match(policy, /require-trusted-types-for 'script'/);
+  assert.match(policy, /trusted-types dompurify seasonal-favorites(?:;|$)/);
+  assert.match(policy, /script-src 'self';/);
+  assert.match(policy, /object-src 'none'/);
+  assert.match(policy, /base-uri 'none'/);
+  assert.ok([...window.document.scripts].every((script) => script.src && !script.textContent.trim()));
+  window.close();
+});
