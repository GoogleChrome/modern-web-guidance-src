diff --git a/safe-html.js b/safe-html.js
new file mode 100644
index 0000000..2970599
--- /dev/null
+++ b/safe-html.js
@@ -0,0 +1,26 @@
+// Every HTML insertion goes through this sanitizer, including without Trusted Types.
+export function createHTMLSanitizer(purifier, trustedTypes) {
+  if (!purifier?.isSupported) {
+    throw new Error('HTML sanitization is unavailable.');
+  }
+
+  const sanitize = (html) => purifier.sanitize(html, {
+    ALLOWED_TAGS: ['div', 'h3', 'p', 'a'],
+    ALLOWED_ATTR: ['class', 'href'],
+    ALLOW_DATA_ATTR: false,
+    ALLOW_ARIA_ATTR: false,
+    RETURN_TRUSTED_TYPE: false,
+  });
+
+  // No default policy: other DOM sinks reject raw strings under our CSP.
+  // DOMPurify's internal policy is also allowed so it can parse inert HTML.
+  const policy = trustedTypes?.createPolicy('seasonal-favorites', {
+    createHTML: sanitize,
+  });
+
+  return policy ? (html) => policy.createHTML(html) : sanitize;
+}
+
+export function renderCards(container, cards, sanitizeHTML) {
+  container.innerHTML = sanitizeHTML(cards.join(''));
+}
