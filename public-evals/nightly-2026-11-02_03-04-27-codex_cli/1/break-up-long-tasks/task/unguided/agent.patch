+<script>
+    (() => {
+      const form = document.getElementById('blend-form');
+      const runButton = document.getElementById('run-blends');
+      const cancelButton = document.getElementById('cancel-blends');
+      const status = document.getElementById('lab-status');
+      const badge = document.getElementById('lab-badge');
+      const results = document.getElementById('lab-results');
+      const progress = document.getElementById('blend-progress');
+      const count = document.getElementById('recipe-count');
+      const percent = document.getElementById('progress-percent');
+      const output = document.getElementById('blend-output');
+      const empty = document.getElementById('lab-empty');
+      const profile = document.getElementById('flavor-profile');
+      const list = document.getElementById('blend-list');
+      const flavorNames = ['Chocolate', 'Fruit', 'Sweetness', 'Body', 'Acidity', 'Bitterness'];
+      // Representative intensities, not measured tasting or quality predictions.
+      const beans = [[85, 25, 70, 80, 30, 45], [25, 95, 65, 35, 90, 20], [60, 60, 85, 60, 60, 30]];
+      const roastEffects = { light: [-10, 10, -5, -10, 15, -10], medium: [0, 0, 5, 0, 0, 0], dark: [15, -20, -10, 15, -20, 25] };
+      const brewEffects = { pour: [0, 5, 0, -5, 5, 0], espresso: [5, 0, 0, 15, 0, 10], cold: [5, -5, 10, 5, -20, -10] };
+      let running = false;
+      let cancelled = false;
+      const yieldToMain = () => typeof globalThis.scheduler?.yield === 'function'
+        ? globalThis.scheduler.yield() : new Promise(resolve => setTimeout(resolve, 0));
+
+      cancelButton.addEventListener('click', () => { cancelled = true; cancelButton.disabled = true; });
+      form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (running) return;
+        running = true;
+        cancelled = false;
+        const total = Number(form.elements.batch.value);
+        const roast = roastEffects[form.elements.roast.value];
+        const brew = brewEffects[form.elements.brew.value];
+        const fields = [...form.querySelectorAll('select')];
+        fields.forEach(field => { field.disabled = true; });
+        runButton.disabled = true;
+        cancelButton.hidden = false;
+        cancelButton.disabled = false;
+        results.setAttribute('aria-busy', 'true');
+        output.hidden = true;
+        empty.hidden = false;
+        badge.textContent = 'Simulating';
+        badge.dataset.state = 'running';
+        status.textContent = 'Exploring recipes. You can keep browsing while we blend.';
+        let completed = 0;
+        let best = [];
+        let seed = 42;
+        const random = () => { seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0; return seed / 4294967296; };
+        const updateProgress = () => {
+          const value = Math.floor(completed / total * 100);
+          progress.value = value;
+          count.textContent = `${completed.toLocaleString()} / ${total.toLocaleString()} recipes`;
+          percent.textContent = `${value}%`;
+        };
+        updateProgress();
+        try {
+          // Yield before starting, then cap each slice by both time and recipe count.
+          await yieldToMain();
+          while (completed < total && !cancelled) {
+            const deadline = performance.now() + 6;
+            let chunk = 0;
+            do {
+              // Exponentials give varied, normalized three-origin proportions.
+              const weights = beans.map(() => -Math.log(Math.max(random(), 1e-9)));
+              const sum = weights.reduce((a, b) => a + b, 0);
+              const ratios = weights.map(weight => weight / sum);
+              const flavors = flavorNames.map((_, i) => Math.max(0, Math.min(100,
+                beans.reduce((value, bean, j) => value + bean[i] * ratios[j], 0) + roast[i] + brew[i])));
+              const target = [65, 60, 80, 65, 50, 30];
+              const score = Math.max(0, 100 - Math.sqrt(flavors.reduce((error, value, i) => error + (value - target[i]) ** 2, 0) / flavors.length));
+              // Retain only three leaders so even large batches use bounded memory.
+              if (best.length < 3 || score > best[best.length - 1].score) {
+                best.push({ ratios, flavors, score });
+                best.sort((a, b) => b.score - a.score);
+                best.length = Math.min(best.length, 3);
+              }
+              completed++;
+              chunk++;
+            } while (completed < total && chunk < 500 && performance.now() < deadline);
+            updateProgress();
+            await yieldToMain();
+          }
+          badge.textContent = cancelled ? 'Cancelled' : 'Complete';
+          badge.dataset.state = cancelled ? 'cancelled' : 'complete';
+          status.textContent = cancelled
+            ? `Stopped after ${completed.toLocaleString()} recipes. Start again to explore a new batch.`
+            : `${total.toLocaleString()} recipes explored. Meet your three most balanced blends.`;
+          if (best.length) {
+            profile.replaceChildren();
+            best[0].flavors.forEach((value, i) => {
+              const item = document.createElement('div');
+              item.innerHTML = `<div class="flavor-label"><span>${flavorNames[i]}</span><span>${Math.round(value)}</span></div><div class="flavor-track"><div class="flavor-fill" style="width:${value}%"></div></div>`;
+              profile.append(item);
+            });
+            list.replaceChildren();
+            best.forEach((blend, i) => {
+              const brazil = Math.round(blend.ratios[0] * 100);
+              const ethiopia = Math.min(100 - brazil, Math.round(blend.ratios[1] * 100));
+              const item = document.createElement('li');
+              item.innerHTML = `<span class="blend-rank">0${i + 1}</span><div><div class="blend-name">${['The balanced cup', 'A close contender', 'One more to savor'][i]}</div><div class="blend-recipe">${brazil}% Brazil · ${ethiopia}% Ethiopia · ${100 - brazil - ethiopia}% Colombia</div></div><span class="blend-score">${blend.score.toFixed(1)}</span>`;
+              list.append(item);
+            });
+            empty.hidden = true;
+            output.hidden = false;
+          }
+        } catch (error) {
+          badge.textContent = 'Try again';
+          badge.dataset.state = 'error';
+          status.textContent = 'The simulation could not finish. Please try again.';
+          console.error('Blend simulation failed:', error);
+        } finally {
+          running = false;
+          fields.forEach(field => { field.disabled = false; });
+          runButton.disabled = false;
+          cancelButton.hidden = true;
+          results.setAttribute('aria-busy', 'false');
+          if (document.activeElement === cancelButton) runButton.focus();
+        }
+      });
+    })();
+  </script>
 </body>
 
