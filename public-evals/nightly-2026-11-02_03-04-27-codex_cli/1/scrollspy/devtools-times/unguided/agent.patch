diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..3b1e757
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,153 @@
+---
+const sections = [
+  { id: 'top-stories', label: 'Top Stories' },
+  { id: 'top-news', label: 'Top News' },
+  { id: 'world', label: 'World' },
+  { id: 'politics', label: 'Politics' },
+];
+---
+
+<section-navigation>
+  <nav aria-label="On this page" class="section-nav">
+    <span class="section-nav-label">On this page</span>
+    {sections.map(({ id, label }, index) => (
+      <a href={`#${id}`} aria-current={index === 0 ? 'location' : undefined}>
+        {label}
+      </a>
+    ))}
+  </nav>
+</section-navigation>
+
+<style>
+  section-navigation {
+    display: block;
+    position: sticky;
+    top: 0;
+    z-index: 20;
+    background: white;
+    border-bottom: 1px solid #d1d5db;
+  }
+
+  .section-nav {
+    display: flex;
+    align-items: center;
+    gap: 0.25rem;
+    overflow-x: auto;
+    padding: 0 1rem;
+  }
+
+  .section-nav-label {
+    margin-right: 1rem;
+    color: #6b7280;
+    font-size: 0.6875rem;
+    font-weight: 600;
+    text-transform: uppercase;
+    letter-spacing: 0.06em;
+    white-space: nowrap;
+  }
+
+  a {
+    padding: 0.875rem 0.75rem;
+    border-bottom: 3px solid transparent;
+    color: #4b5563;
+    font-size: 0.8125rem;
+    font-weight: 600;
+    white-space: nowrap;
+    text-decoration: none;
+  }
+
+  a:hover {
+    background: #f9fafb;
+    color: #111827;
+  }
+
+  a[aria-current='location'] {
+    border-bottom-color: #d97706;
+    background: #fffbeb;
+    color: #92400e;
+  }
+
+  a:focus-visible {
+    outline: 2px solid #92400e;
+    outline-offset: -4px;
+  }
+
+  @media (max-width: 480px) {
+    .section-nav-label {
+      display: none;
+    }
+  }
+</style>
+
+<script>
+  class SectionNavigation extends HTMLElement {
+    private cleanup?: () => void;
+    private stopListening?: () => void;
+
+    connectedCallback() {
+      // Wait until the parser has added the sections following this element.
+      const initialize = () => {
+        this.cleanup?.();
+        const links = Array.from(this.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
+        const sections = links.map(link => document.getElementById(link.hash.slice(1)));
+        let frame = 0;
+
+        const update = () => {
+          frame = 0;
+          const boundary = this.getBoundingClientRect().bottom + 24;
+          let current = 0;
+          sections.forEach((section, index) => {
+            if (section && section.getBoundingClientRect().top <= boundary) current = index;
+          });
+
+          // A short final section may never reach the top of the viewport.
+          const last = sections.at(-1);
+          if (last && last.getBoundingClientRect().top < window.innerHeight &&
+              window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
+            current = sections.length - 1;
+          }
+
+          links.forEach((link, index) => {
+            if (index === current) link.setAttribute('aria-current', 'location');
+            else link.removeAttribute('aria-current');
+          });
+        };
+
+        const scheduleUpdate = () => {
+          if (!frame) frame = requestAnimationFrame(update);
+        };
+        const observer = new ResizeObserver(scheduleUpdate);
+        sections.forEach(section => { if (section) observer.observe(section); });
+        observer.observe(this);
+        window.addEventListener('scroll', scheduleUpdate, { passive: true });
+        window.addEventListener('resize', scheduleUpdate);
+        window.addEventListener('hashchange', scheduleUpdate);
+        update();
+
+        this.cleanup = () => {
+          cancelAnimationFrame(frame);
+          observer.disconnect();
+          window.removeEventListener('scroll', scheduleUpdate);
+          window.removeEventListener('resize', scheduleUpdate);
+          window.removeEventListener('hashchange', scheduleUpdate);
+        };
+      };
+
+      document.addEventListener('astro:page-load', initialize);
+      const readyFrame = requestAnimationFrame(initialize);
+      this.stopListening = () => {
+        cancelAnimationFrame(readyFrame);
+        document.removeEventListener('astro:page-load', initialize);
+      };
+    }
+
+    disconnectedCallback() {
+      this.cleanup?.();
+      this.stopListening?.();
+    }
+  }
+
+  if (!customElements.get('section-navigation')) {
+    customElements.define('section-navigation', SectionNavigation);
+  }
+</script>
