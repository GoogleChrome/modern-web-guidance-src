diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..86cf538
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,141 @@
+---
+const sections = [
+    { id: 'top-stories', label: 'Top Stories' },
+    { id: 'top-news', label: 'Top News' },
+    { id: 'world', label: 'World' },
+    { id: 'politics', label: 'Politics' },
+];
+---
+
+<nav aria-label="On this page" data-section-nav>
+    <ul>
+        {sections.map(({ id, label }) => (
+            <li><a href={`#${id}`}>{label}</a></li>
+        ))}
+    </ul>
+</nav>
+
+<style>
+    nav {
+        position: sticky;
+        top: 0;
+        z-index: 20;
+        background: white;
+        border-bottom: 1px solid #d1d5db;
+    }
+
+    ul {
+        display: flex;
+        overflow-x: auto;
+        gap: 1.5rem;
+        padding-inline: 1rem;
+        scroll-target-group: auto;
+    }
+
+    a {
+        display: block;
+        padding-block: 0.875rem;
+        border-bottom: 3px solid transparent;
+        color: #4b5563;
+        font-size: 0.875rem;
+        font-weight: 600;
+        white-space: nowrap;
+    }
+
+    a:hover {
+        color: #111827;
+    }
+
+    a:is(:target-current, .target-current) {
+        color: #111827;
+        border-bottom-color: #b45309;
+    }
+
+    a:focus-visible {
+        outline: 2px solid #b45309;
+        outline-offset: -4px;
+    }
+
+    :global(:is(#top-stories, #top-news, #world, #politics)) {
+        scroll-margin-top: 4.5rem;
+    }
+</style>
+
+<script>
+    let cleanup: (() => void) | undefined;
+
+    function setupSectionNav() {
+        cleanup?.();
+        const nav = document.querySelector<HTMLElement>('[data-section-nav]');
+        if (!nav) return;
+
+        const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
+        const targets = links.map(link => document.getElementById(link.hash.slice(1)));
+        const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+            CSS.supports('selector(:target-current)');
+        const events = new AbortController();
+        let observer: IntersectionObserver | undefined;
+        let timer: ReturnType<typeof setTimeout>;
+
+        function setCurrent(current: HTMLAnchorElement | undefined) {
+            links.forEach(link => {
+                const active = link === current;
+                link.classList.toggle('target-current', !nativeTracking && active);
+                if (active) link.setAttribute('aria-current', 'location');
+                else link.removeAttribute('aria-current');
+            });
+        }
+
+        function syncCurrent() {
+            if (nativeTracking) {
+                setCurrent(links.find(link => link.matches(':target-current')));
+                return;
+            }
+
+            // Keep the previous section selected through the spaces between sections.
+            const line = window.innerHeight * 0.3;
+            let current = links[0];
+            targets.forEach((target, index) => {
+                if (target && target.getBoundingClientRect().top <= line) current = links[index];
+            });
+            setCurrent(current);
+        }
+
+        function observeSections() {
+            observer?.disconnect();
+            // A one-pixel band makes crossing the reading position deterministic.
+            const line = Math.floor(window.innerHeight * 0.3);
+            observer = new IntersectionObserver(syncCurrent, {
+                rootMargin: `-${line}px 0px -${window.innerHeight - line - 1}px 0px`,
+                threshold: 0,
+            });
+            targets.forEach(target => { if (target) observer!.observe(target); });
+            syncCurrent();
+        }
+
+        const options = { signal: events.signal };
+        if (nativeTracking) {
+            // Debouncing also covers browsers without the scrollend event.
+            document.addEventListener('scroll', () => {
+                clearTimeout(timer);
+                timer = setTimeout(syncCurrent, 120);
+            }, { ...options, passive: true });
+            window.addEventListener('resize', syncCurrent, options);
+        } else {
+            observeSections();
+            window.addEventListener('resize', observeSections, options);
+        }
+        document.addEventListener('scrollend', syncCurrent, options);
+        window.addEventListener('hashchange', syncCurrent, options);
+        syncCurrent();
+
+        cleanup = () => {
+            observer?.disconnect();
+            events.abort();
+            clearTimeout(timer);
+        };
+    }
+
+    document.addEventListener('astro:page-load', setupSectionNav);
+    document.addEventListener('astro:before-swap', () => cleanup?.());
+</script>
