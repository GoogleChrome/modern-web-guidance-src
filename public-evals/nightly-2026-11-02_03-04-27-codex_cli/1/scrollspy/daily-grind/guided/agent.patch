+  <script type="module">
+    const navigation = document.querySelector('nav');
+    const links = [...document.querySelectorAll('.section-links a')];
+    const sections = links.map(link => document.querySelector(link.hash));
+    const supportsNativeTracking = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(:target-current)');
+    let navigationHeight = navigation.getBoundingClientRect().height;
+    let observer;
+    let frame;
+
+    function updateCurrentSection() {
+      frame = null;
+      let currentLink;
+
+      if (supportsNativeTracking) {
+        currentLink = document.querySelector('.section-links a:target-current');
+      } else {
+        const readingLine = navigationHeight + 24;
+        // The first section stays selected above the menu, matching native tracking.
+        let currentIndex = 0;
+        sections.forEach((section, index) => {
+          if (section.getBoundingClientRect().top <= readingLine) currentIndex = index;
+        });
+        // A short final section may never reach the reading line.
+        if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
+          currentIndex = sections.length - 1;
+        }
+        currentLink = links[currentIndex];
+      }
+
+      links.forEach(link => {
+        const isCurrent = link === currentLink;
+        link.classList.toggle('is-active', !supportsNativeTracking && isCurrent);
+        if (isCurrent) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    function scheduleUpdate() {
+      if (frame == null) frame = requestAnimationFrame(updateCurrentSection);
+    }
+
+    function updateNavigationHeight() {
+      navigationHeight = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navigationHeight}px`);
+      if (!supportsNativeTracking) {
+        observer?.disconnect();
+        observer = new IntersectionObserver(scheduleUpdate, {
+          rootMargin: `-${navigationHeight}px 0px 0px 0px`,
+          threshold: [0, 0.25, 0.5, 0.75, 1]
+        });
+        sections.forEach(section => observer.observe(section));
+      }
+      scheduleUpdate();
+    }
+
+    new ResizeObserver(updateNavigationHeight).observe(navigation);
+    // Also handle restored scroll positions, fragment navigation, and the page end.
+    document.addEventListener('scroll', scheduleUpdate, { passive: true });
+    document.addEventListener('scrollend', scheduleUpdate);
+    window.addEventListener('resize', scheduleUpdate);
+    window.addEventListener('pageshow', scheduleUpdate);
+    window.addEventListener('hashchange', scheduleUpdate);
+    updateNavigationHeight();
+  </script>
