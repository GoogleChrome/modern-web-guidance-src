+  <script>
+    // Older browsers need a fallback for CSS contrast-color(). Read the resolved
+    // backgrounds so stylesheet edits, CSSOM updates, and media queries all work.
+    if (!CSS.supports('color', 'contrast-color(red)')) {
+      const root = document.documentElement;
+      const surfaces = [
+        [document.querySelector('nav'), '--on-primary'],
+        [document.querySelector('footer'), '--on-secondary'],
+      ];
+      const canvas = document.createElement('canvas');
+      canvas.width = canvas.height = 1;
+      const context = canvas.getContext('2d', { willReadFrequently: true });
+      const previousBackgrounds = new Map();
+
+      function updateContrast() {
+        for (const [element, property] of surfaces) {
+          const background = getComputedStyle(element).backgroundColor;
+          if (previousBackgrounds.get(property) === background) continue;
+          previousBackgrounds.set(property, background);
+
+          // Canvas converts CSS colors (including wide-gamut colors) to sRGB.
+          // Composite translucent themes on white before measuring luminance.
+          context.fillStyle = '#fff';
+          context.fillRect(0, 0, 1, 1);
+          context.fillStyle = background;
+          context.fillRect(0, 0, 1, 1);
+          const channels = context.getImageData(0, 0, 1, 1).data.slice(0, 3);
+          const linear = Array.from(channels, channel => {
+            const value = channel / 255;
+            return value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;
+          });
+          const luminance = 0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2];
+          const blackContrast = (luminance + 0.05) / 0.05;
+          const whiteContrast = 1.05 / (luminance + 0.05);
+          root.style.setProperty(property, blackContrast >= whiteContrast ? '#000' : '#fff');
+        }
+        requestAnimationFrame(updateContrast);
+      }
+
+      updateContrast();
+    }
+  </script>
+
