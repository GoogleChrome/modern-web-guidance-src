+  <script>
+    const preferencesForm = document.getElementById('coffee-preferences-form');
+    const pickupReminderTime = document.getElementById('pickup-reminder-time');
+    const coffeeAnniversaryDate = document.getElementById('coffee-anniversary-date');
+    const preferencesStatus = document.getElementById('preferences-status');
+    const preferencesStorageKey = 'daily-grind-coffee-preferences';
+
+    // These are a wall-clock time and a calendar date, never instants.
+    // Keep the native input strings intact; Date/UTC conversion would cause travel drift.
+    try {
+      const saved = JSON.parse(localStorage.getItem(preferencesStorageKey));
+      if (saved && typeof saved === 'object') {
+        if (typeof saved.pickupReminderTime === 'string') {
+          pickupReminderTime.value = saved.pickupReminderTime;
+        }
+        if (typeof saved.coffeeAnniversaryDate === 'string') {
+          coffeeAnniversaryDate.value = saved.coffeeAnniversaryDate;
+        }
+      }
+    } catch {
+      preferencesStatus.textContent = 'Saved preferences could not be loaded. You can select them again below.';
+    }
+
+    preferencesForm.addEventListener('input', () => {
+      preferencesStatus.textContent = 'Unsaved changes.';
+    });
+
+    preferencesForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      try {
+        localStorage.setItem(preferencesStorageKey, JSON.stringify({
+          pickupReminderTime: pickupReminderTime.value,
+          coffeeAnniversaryDate: coffeeAnniversaryDate.value,
+        }));
+        preferencesStatus.textContent = 'Preferences saved on this device.';
+      } catch {
+        preferencesStatus.textContent = 'Preferences could not be saved on this device. Please try again.';
+      }
+    });
+  </script>
+
