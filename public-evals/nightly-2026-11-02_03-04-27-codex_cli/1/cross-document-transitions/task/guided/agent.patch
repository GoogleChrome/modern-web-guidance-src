+  <script>
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      const motionPreference = window.matchMedia('(prefers-reduced-motion: no-preference)');
+
+      function applyNavigationType(transition, from, to) {
+        if (!motionPreference.matches || !transition?.types || !from || !to) return;
+
+        const source = new URL(from);
+        const destination = new URL(to);
+        if (source.origin !== destination.origin || source.pathname !== destination.pathname) return;
+
+        const pageNumber = (url) => Math.max(1, Number.parseInt(url.searchParams.get('page'), 10) || 1);
+        const difference = pageNumber(destination) - pageNumber(source);
+        if (difference !== 0) transition.types.add(difference > 0 ? 'next' : 'previous');
+      }
+
+      // Register early so incoming snapshots receive their type before animation starts.
+      window.addEventListener('pagereveal', (event) => {
+        const activation = window.navigation?.activation;
+        applyNavigationType(event.viewTransition, activation?.from?.url, activation?.entry?.url);
+      });
+
+      window.addEventListener('pageswap', (event) => {
+        applyNavigationType(event.viewTransition, window.location.href, event.activation?.entry?.url);
+      });
+    }
+  </script>
   <style>
+    @media (prefers-reduced-motion: no-preference) {
+      @view-transition {
+        navigation: auto;
+      }
+
+      ::view-transition-old(root),
+      ::view-transition-new(root) {
+        animation-duration: 320ms;
+        animation-timing-function: ease-in-out;
+        animation-fill-mode: both;
+        mix-blend-mode: normal;
+      }
+
+      ::view-transition-old(root) { animation-name: page-fade-out; }
+      ::view-transition-new(root) { animation-name: page-fade-in; }
+
+      html:active-view-transition-type(next)::view-transition-old(root) {
+        animation-name: page-out-left;
+      }
+
+      html:active-view-transition-type(next)::view-transition-new(root) {
+        animation-name: page-in-right;
+      }
+
+      html:active-view-transition-type(previous)::view-transition-old(root) {
+        animation-name: page-out-right;
+      }
+
+      html:active-view-transition-type(previous)::view-transition-new(root) {
+        animation-name: page-in-left;
+      }
+    }
+
+    @keyframes page-fade-out { to { opacity: 0; } }
+    @keyframes page-fade-in { from { opacity: 0; } }
+    @keyframes page-out-left { to { transform: translateX(-15%); opacity: 0; } }
+    @keyframes page-in-right { from { transform: translateX(15%); opacity: 0; } }
+    @keyframes page-out-right { to { transform: translateX(15%); opacity: 0; } }
+    @keyframes page-in-left { from { transform: translateX(-15%); opacity: 0; } }
