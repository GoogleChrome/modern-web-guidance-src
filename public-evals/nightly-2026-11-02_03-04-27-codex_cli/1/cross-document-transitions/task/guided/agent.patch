+  <script>
+    const seasonalPages = [
+      null, // The first page is rendered in HTML.
+      [
+        ['Pumpkin Spice Latte', 'Espresso with warming pumpkin spice and silky steamed milk.', '/menu/pumpkin-spice'],
+        ['Honey Cinnamon Cappuccino', 'A cozy cappuccino finished with honey and cinnamon.', '/menu/honey-cinnamon'],
+        ['Salted Caramel Mocha', 'Rich chocolate and caramel with a touch of sea salt.', '/menu/salted-caramel']
+      ],
+      [
+        ['Gingerbread Latte', 'Spiced gingerbread and espresso topped with velvety foam.', '/menu/gingerbread'],
+        ['Peppermint Mocha', 'Dark chocolate meets bright peppermint and fresh espresso.', '/menu/peppermint'],
+        ['Toasted Hazelnut Cold Brew', 'Slow-steeped coffee with a mellow toasted hazelnut finish.', '/menu/hazelnut']
+      ]
+    ];
+    const currentPage = Math.min(seasonalPages.length, Math.max(1,
+      Number.parseInt(new URL(window.location.href).searchParams.get('page'), 10) || 1));
+
+    if (currentPage > 1) {
+      const cards = seasonalPages[currentPage - 1].map(([name, description, href]) => {
+        const card = document.createElement('div');
+        card.className = 'card';
+        const heading = document.createElement('h3');
+        heading.textContent = name;
+        const text = document.createElement('p');
+        text.textContent = description;
+        const link = document.createElement('a');
+        link.className = 'btn';
+        link.href = href;
+        link.textContent = 'View Details';
+        card.append(heading, text, link);
+        return card;
+      });
+      document.getElementById('seasonal-favorites').replaceChildren(...cards);
+    }
+
+    document.getElementById('page-number').textContent = `Page ${currentPage} of ${seasonalPages.length}`;
+    for (const [id, destination] of [['previous', currentPage - 1], ['next', currentPage + 1]]) {
+      const link = document.getElementById(id);
+      if (destination < 1 || destination > seasonalPages.length) {
+        link.removeAttribute('href');
+        link.setAttribute('aria-disabled', 'true');
+      } else {
+        const url = new URL(window.location.href);
+        url.searchParams.set('page', destination);
+        link.href = url.pathname + url.search + url.hash;
+        link.removeAttribute('aria-disabled');
+      }
+    }
+  </script>
