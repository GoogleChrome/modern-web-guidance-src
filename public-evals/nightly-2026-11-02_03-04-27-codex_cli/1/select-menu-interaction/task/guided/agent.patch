+  <script>
+    const shop = document.getElementById('local-shop');
+
+    const updateShopError = () => {
+      if (shop.validity.valid) {
+        shop.removeAttribute('aria-invalid');
+        shop.removeAttribute('aria-describedby');
+      } else {
+        shop.setAttribute('aria-invalid', 'true');
+        shop.setAttribute('aria-describedby', 'shop-error');
+      }
+    };
+
+    // Native validation blocks empty submissions before the submit event fires.
+    shop.addEventListener('invalid', updateShopError);
+    shop.addEventListener('blur', updateShopError);
+    shop.addEventListener('change', updateShopError);
+    shop.addEventListener('input', updateShopError);
+  </script>
