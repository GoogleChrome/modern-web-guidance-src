+  <script>
+    const shopSelect = document.getElementById('local-shop');
+    const shopError = document.getElementById('local-shop-error');
+    let shopInteracted = false;
+
+    function updateShopValidation() {
+      const showError = shopInteracted && !shopSelect.validity.valid;
+      shopError.hidden = !showError;
+      shopSelect.setAttribute('aria-invalid', String(showError));
+    }
+
+    function handleShopInteraction() {
+      shopInteracted = true;
+      updateShopValidation();
+    }
+
+    shopSelect.addEventListener('blur', handleShopInteraction);
+    shopSelect.addEventListener('change', handleShopInteraction);
+    shopSelect.addEventListener('invalid', (event) => {
+      event.preventDefault();
+      handleShopInteraction();
+      shopSelect.focus();
+    });
+  </script>
