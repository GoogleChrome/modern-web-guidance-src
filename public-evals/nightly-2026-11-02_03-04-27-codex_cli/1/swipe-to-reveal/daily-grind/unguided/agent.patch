+  <script>
+    const drinkCards = [...document.querySelectorAll('.drink-card')];
+
+    function setActionsOpen(card, open) {
+      if (open) {
+        drinkCards.forEach(other => {
+          if (other !== card) setActionsOpen(other, false);
+        });
+      }
+      const actions = card.querySelector('.drink-actions');
+      const toggle = card.querySelector('.actions-toggle');
+      if (!open && actions.contains(document.activeElement)) toggle.focus();
+      card.classList.toggle('is-open', open);
+      toggle.setAttribute('aria-expanded', String(open));
+      actions.inert = !open;
+    }
+
+    drinkCards.forEach(card => {
+      let gesture = null;
+      let suppressClick = false;
+      const toggle = card.querySelector('.actions-toggle');
+
+      toggle.addEventListener('click', () => {
+        setActionsOpen(card, !card.classList.contains('is-open'));
+      });
+
+      card.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0) return;
+        suppressClick = false;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY };
+      });
+
+      card.addEventListener('pointermove', event => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (Math.abs(dy) > 12 && Math.abs(dy) > Math.abs(dx)) {
+          gesture = null;
+        } else if (Math.abs(dx) > 12 && Math.abs(dx) > Math.abs(dy)) {
+          // Capture only a horizontal gesture so ordinary taps still reach links.
+          card.setPointerCapture(event.pointerId);
+        }
+      });
+
+      card.addEventListener('pointerup', event => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        gesture = null;
+        if (Math.abs(dx) > 12 && Math.abs(dx) > Math.abs(dy)) {
+          // A swipe must never activate the link or button underneath it.
+          suppressClick = true;
+          if (Math.abs(dx) >= 40) setActionsOpen(card, dx < 0);
+        }
+      });
+
+      card.addEventListener('pointercancel', () => { gesture = null; });
+      card.addEventListener('lostpointercapture', () => { gesture = null; });
+      card.addEventListener('click', event => {
+        if (!suppressClick || event.detail === 0) return;
+        event.preventDefault();
+        event.stopImmediatePropagation();
+        suppressClick = false;
+      }, true);
+      card.addEventListener('keydown', event => {
+        if (event.key === 'Escape') setActionsOpen(card, false);
+      });
+      card.addEventListener('dragstart', event => event.preventDefault());
+    });
+
+    document.addEventListener('click', event => {
+      if (!event.target.closest('.drink-card')) {
+        drinkCards.forEach(card => setActionsOpen(card, false));
+      }
+    });
+  </script>
