diff --git a/media-loading.js b/media-loading.js
new file mode 100644
index 0000000..a5ce3db
--- /dev/null
+++ b/media-loading.js
@@ -0,0 +1,67 @@
+// URLs start in data attributes so even speculative parsing cannot fetch them.
+const deferredMedia = document.querySelectorAll('video[loading="lazy"], audio[loading="lazy"]');
+
+function attachResources(media) {
+  for (const attribute of ['poster', 'preload', 'src']) {
+    if (media.dataset[attribute]) {
+      media.setAttribute(attribute, media.dataset[attribute]);
+      delete media.dataset[attribute];
+    }
+  }
+  for (const source of media.querySelectorAll('source[data-src]')) {
+    source.src = source.dataset.src;
+    delete source.dataset.src;
+  }
+}
+
+const observer = 'IntersectionObserver' in window
+  ? new IntersectionObserver((entries) => {
+      for (const entry of entries) {
+        if (!entry.isIntersecting) continue;
+        attachResources(entry.target);
+        entry.target.load();
+        observer.unobserve(entry.target);
+      }
+    }, { rootMargin: '200px 0px' })
+  : null;
+
+const pending = new Set();
+for (const media of deferredMedia) {
+  if ('loading' in media) {
+    // Supported browsers defer posters and preload requests themselves.
+    attachResources(media);
+  } else if (observer) {
+    observer.observe(media);
+  } else {
+    pending.add(media);
+  }
+}
+
+// Preserve viewport deferral even in older browsers without IntersectionObserver.
+if (pending.size) {
+  let scheduled = false;
+  function checkViewport() {
+    scheduled = false;
+    for (const media of pending) {
+      const box = media.getBoundingClientRect();
+      if (box.bottom >= -200 && box.top <= window.innerHeight + 200 &&
+          box.right >= 0 && box.left <= window.innerWidth) {
+        attachResources(media);
+        media.load();
+        pending.delete(media);
+      }
+    }
+    if (!pending.size) {
+      window.removeEventListener('scroll', scheduleCheck);
+      window.removeEventListener('resize', scheduleCheck);
+    }
+  }
+  function scheduleCheck() {
+    if (scheduled) return;
+    scheduled = true;
+    window.requestAnimationFrame(checkViewport);
+  }
+  window.addEventListener('scroll', scheduleCheck, { passive: true });
+  window.addEventListener('resize', scheduleCheck);
+  checkViewport();
+}
