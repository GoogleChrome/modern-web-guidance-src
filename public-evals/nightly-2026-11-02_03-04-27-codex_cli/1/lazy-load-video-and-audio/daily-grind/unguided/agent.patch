index 0000000..035561e
--- /dev/null
+++ b/media.js
@@ -0,0 +1,57 @@
+(() => {
+  // Keep poster and source URLs inert until the individual player is nearby.
+  // preload="none" alone does not prevent a browser from fetching a poster.
+  const players = [...document.querySelectorAll('[data-lazy-media]')];
+  const margin = 200;
+
+  function activate(player) {
+    if (!player.hasAttribute('data-lazy-media')) return;
+    player.removeAttribute('data-lazy-media');
+    if (player.dataset.poster) {
+      player.poster = player.dataset.poster;
+      delete player.dataset.poster;
+    }
+    for (const source of player.querySelectorAll('source[data-src]')) {
+      source.src = source.dataset.src;
+      delete source.dataset.src;
+    }
+    // Only nearby players may request metadata. Playback remains user initiated.
+    player.preload = 'metadata';
+    player.load();
+  }
+
+  if ('IntersectionObserver' in window) {
+    const observer = new IntersectionObserver((entries) => {
+      for (const entry of entries) {
+        if (!entry.isIntersecting) continue;
+        activate(entry.target);
+        observer.unobserve(entry.target);
+      }
+    }, { rootMargin: `${margin}px 0px`, threshold: 0 });
+    players.forEach((player) => observer.observe(player));
+  } else {
+    // Older browsers must also avoid eagerly loading every offscreen asset.
+    let scheduled = false;
+    function check() {
+      scheduled = false;
+      for (const player of players) {
+        if (!player.hasAttribute('data-lazy-media')) continue;
+        const rect = player.getBoundingClientRect();
+        if (rect.bottom >= -margin && rect.top <= window.innerHeight + margin &&
+            rect.right >= 0 && rect.left <= window.innerWidth) activate(player);
+      }
+      if (players.every((player) => !player.hasAttribute('data-lazy-media'))) {
+        window.removeEventListener('scroll', schedule);
+        window.removeEventListener('resize', schedule);
+      }
+    }
+    function schedule() {
+      if (scheduled) return;
+      scheduled = true;
+      window.requestAnimationFrame(check);
+    }
+    window.addEventListener('scroll', schedule, { passive: true });
+    window.addEventListener('resize', schedule);
+    check();
+  }
+})();
