@@ -0,0 +1,110 @@
+'use strict';
+
+const http = require('node:http');
+const { readFile, mkdir, appendFile } = require('node:fs/promises');
+const path = require('node:path');
+
+const port = Number(process.env.PORT || 11222);
+const dataDirectory = process.env.DATA_DIR || path.join(__dirname, '.data');
+const policy = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "script-src-attr 'none'",
+  "style-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "connect-src 'self'",
+  "form-action 'self'",
+  "base-uri 'none'",
+  "object-src 'none'",
+  "frame-ancestors 'none'",
+].join('; ');
+
+// Only public assets are exposed; signup storage and source files are never served.
+const assets = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+  ['/newsletter.js', ['newsletter.js', 'text/javascript; charset=utf-8']],
+]);
+
+function json(response, code, message) {
+  response.writeHead(code, { 'Content-Type': 'application/json; charset=utf-8' });
+  response.end(JSON.stringify({ message }));
+}
+
+async function signup(request, response) {
+  // JSON-only requests and no CORS permission prevent cross-origin form submissions.
+  if (request.headers['content-type']?.split(';')[0].trim().toLowerCase() !== 'application/json') {
+    request.resume();
+    return json(response, 415, 'Use application/json.');
+  }
+  if (request.headers['sec-fetch-site'] === 'cross-site') {
+    request.resume();
+    return json(response, 403, 'Cross-site requests are not allowed.');
+  }
+  const chunks = [];
+  let bytes = 0;
+  for await (const chunk of request) {
+    bytes += chunk.length;
+    if (bytes > 4096) {
+      json(response, 413, 'Request too large.');
+      request.resume();
+      return;
+    }
+    chunks.push(chunk);
+  }
+  let email;
+  try {
+    const payload = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+    email = typeof payload?.email === 'string' ? payload.email.trim() : '';
+  } catch {
+    return json(response, 400, 'Enter a valid email address.');
+  }
+  if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+    return json(response, 400, 'Enter a valid email address.');
+  }
+  await mkdir(dataDirectory, { recursive: true, mode: 0o700 });
+  await appendFile(path.join(dataDirectory, 'newsletter.jsonl'),
+    JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n',
+    { mode: 0o600 });
+  json(response, 201, 'You are signed up.');
+}
+
+const server = http.createServer(async (request, response) => {
+  response.setHeader('Content-Security-Policy', policy);
+  response.setHeader('X-Content-Type-Options', 'nosniff');
+  response.setHeader('Referrer-Policy', 'no-referrer');
+  response.setHeader('X-Frame-Options', 'DENY');
+  response.setHeader('Cache-Control', 'no-store');
+  try {
+    const pathname = new URL(request.url, 'http://localhost').pathname;
+    if (pathname === '/api/newsletter') {
+      if (request.method !== 'POST') {
+        response.setHeader('Allow', 'POST');
+        return json(response, 405, 'Use POST to sign up.');
+      }
+      return await signup(request, response);
+    }
+    const asset = assets.get(pathname);
+    if (!asset) return json(response, 404, 'Not found.');
+    if (request.method !== 'GET' && request.method !== 'HEAD') {
+      response.setHeader('Allow', 'GET, HEAD');
+      return json(response, 405, 'Method not allowed.');
+    }
+    const content = await readFile(path.join(__dirname, asset[0]));
+    response.writeHead(200, { 'Content-Type': asset[1] });
+    response.end(request.method === 'HEAD' ? undefined : content);
+  } catch {
+    if (!response.headersSent && !response.destroyed) {
+      json(response, 500, 'We could not complete your request. Please try again.');
+    } else {
+      response.end();
+    }
+  }
+});
+
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(port, '0.0.0.0', () => {
+  console.log(`Daily Grind listening on port ${port}`);
+});
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..cfcc350
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,171 @@
+:root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+    }
+
+    /* Navigation */
+    nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+    }
+
+    .logo {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    nav ul {
+      display: flex;
+      list-style: none;
+    }
+
+    nav ul li {
+      margin-left: 20px;
+    }
+
+    nav a {
+      color: white;
+      text-decoration: none;
+      font-size: 0.9rem;
+      transition: color 0.3s;
+    }
+
+    nav a:hover {
+      color: var(--accent);
+    }
+
+    .logout-link {
+      border: 1px solid var(--accent);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+
+    /* Hero Section */
+    .hero {
+      height: 60vh;
+      background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+        url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: white;
+      text-align: center;
+      padding: 0 20px;
+    }
+
+    .hero h1 {
+      font-size: 3rem;
+      margin-bottom: 1rem;
+    }
+
+    /* Content Sections */
+    .container {
+      max-width: 1100px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+      gap: 20px;
+      margin-top: 20px;
+    }
+
+    .card {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    .card h3 {
+      margin-bottom: 10px;
+      color: var(--primary);
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    footer {
+      background: var(--secondary);
+      text-align: center;
+      padding: 40px 20px;
+      margin-top: 40px;
+    }
+
+    .footer-links {
+      margin-bottom: 20px;
+    }
+
+    .footer-links a {
+      margin: 0 10px;
+      color: var(--text);
+      text-decoration: none;
+      font-size: 0.85rem;
+    }
+
+.section-title { text-align: center; }
+
+.newsletter {
+  margin-top: 40px;
+  padding: 32px;
+  background: var(--secondary);
+  border-radius: 8px;
+}
+
+.newsletter form { margin-top: 16px; }
+.newsletter label { display: block; font-weight: 600; }
+.newsletter-fields { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
+.newsletter input {
+  flex: 1 1 220px;
+  min-width: 0;
+  padding: 12px;
+  border: 1px solid var(--primary);
+  border-radius: 5px;
+  font: inherit;
+}
+.newsletter button { margin-top: 0; border: 0; font: inherit; cursor: pointer; }
+.newsletter button:disabled { opacity: 0.65; cursor: wait; }
+.newsletter-status { margin-top: 12px; min-height: 1.6em; }
+:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
