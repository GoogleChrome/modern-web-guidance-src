index 0000000..2c0a578
--- /dev/null
+++ b/newsletter.js
@@ -0,0 +1,49 @@
+'use strict';
+
+const form = document.querySelector('#newsletter-form');
+const status = document.querySelector('#newsletter-status');
+const button = form.querySelector('button');
+let submitting = false;
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (submitting || !form.reportValidity()) return;
+  submitting = true;
+  button.disabled = true;
+  status.textContent = 'Signing you up…';
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), 10000);
+
+  try {
+    const response = await fetch('/api/newsletter', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      credentials: 'same-origin',
+      redirect: 'error',
+      signal: controller.signal,
+      body: JSON.stringify({ email: form.elements.email.value.trim() }),
+    });
+    if (!response.ok) {
+      status.textContent = response.status === 400
+        ? 'Please enter a valid email address and try again.'
+        : 'We couldn’t save your signup. Please try again in a moment.';
+      return;
+    }
+    status.textContent = 'You’re signed up! Thanks for joining The Daily Grind.';
+    form.reset();
+  } catch (error) {
+    status.textContent = error.name === 'AbortError'
+      ? 'Your request took too long. Please try again.'
+      : 'Your signup couldn’t go through. Check your connection and try again.';
+  } finally {
+    clearTimeout(timeout);
+    submitting = false;
+    button.disabled = false;
+  }
+});
+
+document.addEventListener('securitypolicyviolation', (event) => {
+  if (event.effectiveDirective === 'connect-src' || event.effectiveDirective === 'form-action') {
+    status.textContent = 'This request was blocked for your security. Please try again or contact us.';
+  }
+});
