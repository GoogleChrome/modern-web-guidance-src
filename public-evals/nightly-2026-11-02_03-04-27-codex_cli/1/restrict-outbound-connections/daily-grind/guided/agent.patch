index 0000000..67b271e
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,118 @@
+import { createServer } from 'node:http';
+import { randomBytes } from 'node:crypto';
+import { readFile, mkdir, appendFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = dirname(fileURLToPath(import.meta.url));
+const template = await readFile(resolve(root, 'index.html'), 'utf8');
+// Only these public files are served; customer data and server source stay private.
+const assets = new Map(await Promise.all([
+  ['styles.css', 'text/css; charset=utf-8'],
+  ['newsletter.js', 'text/javascript; charset=utf-8'],
+].map(async ([name, type]) => [`/${name}`, { type, body: await readFile(resolve(root, name)) }])));
+const signupFile = resolve(process.env.NEWSLETTER_FILE || resolve(root, 'data/newsletter.jsonl'));
+
+function securityHeaders(res, nonce) {
+  // Apply to every response, including any response requested as a worker/document.
+  // No redirects or WebRTC exceptions: both remain blocked by default.
+  res.setHeader('Connection-Allowlist', '(response-origin "https://images.unsplash.com")');
+  res.setHeader('Content-Security-Policy', [
+    "default-src 'none'",
+    `script-src 'nonce-${nonce}' 'strict-dynamic'`,
+    "style-src 'self'",
+    "img-src 'self' https://images.unsplash.com",
+    "connect-src 'self'",
+    "form-action 'self'",
+    "worker-src 'none'",
+    "frame-src 'none'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'none'",
+    "require-trusted-types-for 'script'",
+  ].join('; '));
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('X-Frame-Options', 'DENY');
+  res.setHeader('Referrer-Policy', 'no-referrer');
+  res.setHeader('X-DNS-Prefetch-Control', 'off');
+  res.setHeader('Cache-Control', 'no-store');
+}
+
+function reply(res, code, body, type = 'text/plain; charset=utf-8', head = false) {
+  res.writeHead(code, { 'Content-Type': type });
+  res.end(head ? undefined : body);
+}
+
+function signupReply(req, res, code, message) {
+  if (req.headers.accept?.includes('application/json')) {
+    return reply(res, code, JSON.stringify({ ok: code === 201, message }), 'application/json; charset=utf-8');
+  }
+  // Messages are fixed server strings; never interpolate submitted customer data.
+  reply(res, code, `<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Daily Grind Newsletter</title><link rel="stylesheet" href="/styles.css"><main class="container"><h1>Daily Grind Newsletter</h1><p>${message}</p><a href="/">Return to the homepage</a></main></html>`, 'text/html; charset=utf-8');
+}
+
+const server = createServer(async (req, res) => {
+  const nonce = randomBytes(18).toString('base64');
+  securityHeaders(res, nonce);
+  try {
+    const pathname = new URL(req.url, 'http://localhost').pathname;
+    if (pathname === '/api/newsletter') {
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        return signupReply(req, res, 405, 'Please submit the newsletter form from our homepage.');
+      }
+      // Reject cross-origin form posts as well as cross-origin fetches.
+      if ((req.headers['sec-fetch-site'] && !['same-origin', 'none'].includes(req.headers['sec-fetch-site'])) ||
+          (req.headers.origin && new URL(req.headers.origin).host !== req.headers.host)) {
+        return signupReply(req, res, 403, 'Please submit the newsletter form from our homepage.');
+      }
+      const type = req.headers['content-type']?.split(';')[0].trim();
+      if (!['application/json', 'application/x-www-form-urlencoded'].includes(type)) {
+        return signupReply(req, res, 415, 'Please submit a valid newsletter signup.');
+      }
+      let size = 0;
+      const chunks = [];
+      for await (const chunk of req) {
+        size += chunk.length;
+        if (size > 4096) {
+          signupReply(req, res, 413, 'Your signup was too large. Please try again with just your email address.');
+          return;
+        }
+        chunks.push(chunk);
+      }
+      const body = Buffer.concat(chunks).toString('utf8');
+      let data;
+      try {
+        data = type === 'application/json' ? JSON.parse(body) : Object.fromEntries(new URLSearchParams(body));
+      } catch {
+        return signupReply(req, res, 400, 'Please enter a valid email address and try again.');
+      }
+      const email = typeof data?.email === 'string' ? data.email.trim() : '';
+      if (email.length > 254 || !/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(email)) {
+        return signupReply(req, res, 400, 'Please enter a valid email address and try again.');
+      }
+      await mkdir(dirname(signupFile), { recursive: true, mode: 0o700 });
+      await appendFile(signupFile, JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n', { mode: 0o600 });
+      return signupReply(req, res, 201, 'Thanks for subscribing! You’re on the list.');
+    }
+
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      return reply(res, 405, 'Method not allowed.');
+    }
+    if (pathname === '/' || pathname === '/index.html') {
+      return reply(res, 200, template.replace('{{SCRIPT_NONCE}}', nonce), 'text/html; charset=utf-8', req.method === 'HEAD');
+    }
+    const asset = assets.get(pathname);
+    if (asset) return reply(res, 200, asset.body, asset.type, req.method === 'HEAD');
+    reply(res, 404, 'Page not found.', undefined, req.method === 'HEAD');
+  } catch {
+    // Do not log email addresses or request bodies.
+    if (!res.headersSent) signupReply(req, res, 500, 'We couldn’t save your signup. Please try again later.');
+    else res.end();
+  }
+});
+
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(Number(process.env.PORT || 11222), process.env.HOST || '0.0.0.0');
