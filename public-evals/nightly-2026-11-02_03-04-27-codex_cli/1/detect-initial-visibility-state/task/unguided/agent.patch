+        });
+        return;
+      }
+
+      // UNRELIABLE LEGACY FALLBACK: this only samples the current state.
+      // Async/delayed execution may miss earlier visibility changes entirely;
+      // performance.now() is the observation time, not the actual hidden time.
+      const currentlyHidden = document.visibilityState === 'hidden';
+      console.warn('Visibility history unavailable: fallback detection and timing may be inaccurate.');
+      console.log({
+        initiallyBackgrounded: currentlyHidden,
+        timeBackgrounded: currentlyHidden ? performance.now() : null,
+        fallbackActive: true,
+      });
+    })();
