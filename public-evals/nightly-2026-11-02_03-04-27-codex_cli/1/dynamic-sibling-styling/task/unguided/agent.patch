+  <script>
+    // Keep older browsers and live DOM edits in sync with the CSS formulas.
+    // Each group is counted independently; no item-specific angles or hues.
+    function updateCollections() {
+      document.querySelectorAll('.card:not(.spectrum-card)').forEach(card => {
+        card.classList.add('spectrum-card');
+      });
+      for (const selector of ['.spectrum-card', '.fan-card', '.circle-orb']) {
+        const parents = new Set([...document.querySelectorAll(selector)].map(item => item.parentElement));
+        parents.forEach(parent => {
+          const items = [...parent.children].filter(item => item.matches(selector));
+          items.forEach((item, index) => {
+            item.style.setProperty('--item-index', index);
+            item.style.setProperty('--item-count', items.length);
+          });
+        });
+      }
+    }
+    updateCollections();
+    new MutationObserver(updateCollections).observe(document.querySelector('main'), {
+      childList: true,
+      subtree: true,
+      attributes: true,
+      attributeFilter: ['class']
+    });
+  </script>
