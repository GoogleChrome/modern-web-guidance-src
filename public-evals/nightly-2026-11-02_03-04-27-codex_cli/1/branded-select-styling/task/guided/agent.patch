+  <script>
+    // Keep every part themed when customizable native selects are unavailable.
+    if (!CSS.supports('appearance', 'base-select')) {
+      const select = document.querySelector('#coffee-roast');
+      const label = document.querySelector('#roast-label');
+      const dropdown = document.createElement('details');
+      dropdown.className = 'roast-fallback';
+      const trigger = document.createElement('summary');
+      trigger.id = 'roast-trigger';
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-value');
+      const value = document.createElement('span');
+      value.id = 'roast-value';
+      value.textContent = select.selectedOptions[0].textContent;
+      trigger.append(value);
+      const options = document.createElement('div');
+      options.className = 'roast-options';
+      options.setAttribute('role', 'radiogroup');
+      options.setAttribute('aria-labelledby', 'roast-label');
+      for (const option of select.options) {
+        const row = document.createElement('label');
+        row.className = 'roast-option';
+        const radio = document.createElement('input');
+        radio.type = 'radio';
+        radio.name = 'roast-choice';
+        radio.value = option.value;
+        radio.checked = option.selected;
+        radio.addEventListener('change', () => {
+          select.value = radio.value;
+          value.textContent = option.textContent;
+          select.dispatchEvent(new Event('change', { bubbles: true }));
+        });
+        row.append(radio, document.createTextNode(option.textContent));
+        options.append(row);
+      }
+      dropdown.append(trigger, options);
+      select.after(dropdown);
+      select.hidden = true;
+      label.removeAttribute('for');
+      label.addEventListener('click', () => trigger.focus());
+      options.addEventListener('click', (event) => {
+        if (event.target.matches('input')) {
+          dropdown.open = false;
+          trigger.focus();
+        }
+      });
+      dropdown.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+          dropdown.open = false;
+          trigger.focus();
+        }
+      });
+      document.addEventListener('click', (event) => {
+        if (!dropdown.contains(event.target)) dropdown.open = false;
+      });
+    }
+  </script>
