+  <script>
+    const selector = document.querySelector('.roast-selector');
+    const trigger = document.getElementById('roast-trigger');
+    const list = document.getElementById('roast-options');
+    const value = document.getElementById('roast-value');
+    const options = Array.from(list.querySelectorAll('[role="option"]'));
+    let selectedIndex = 1;
+    let activeIndex = selectedIndex;
+
+    function activate(index) {
+      activeIndex = (index + options.length) % options.length;
+      options.forEach((option, i) => option.classList.toggle('is-active', i === activeIndex));
+      list.setAttribute('aria-activedescendant', options[activeIndex].id);
+    }
+
+    function openRoasts() {
+      list.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      activate(selectedIndex);
+      list.focus();
+    }
+
+    function closeRoasts(restoreFocus = false) {
+      list.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) trigger.focus();
+    }
+
+    function selectRoast(index) {
+      selectedIndex = index;
+      value.textContent = options[index].dataset.value;
+      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
+      closeRoasts(true);
+    }
+
+    trigger.addEventListener('click', () => list.hidden ? openRoasts() : closeRoasts(true));
+    trigger.addEventListener('keydown', (event) => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openRoasts();
+      }
+    });
+
+    list.addEventListener('click', (event) => {
+      const option = event.target.closest('[role="option"]');
+      if (option) selectRoast(options.indexOf(option));
+    });
+
+    list.addEventListener('keydown', (event) => {
+      switch (event.key) {
+        case 'ArrowDown': activate(activeIndex + 1); break;
+        case 'ArrowUp': activate(activeIndex - 1); break;
+        case 'Home': activate(0); break;
+        case 'End': activate(options.length - 1); break;
+        case 'Enter':
+        case ' ': selectRoast(activeIndex); break;
+        case 'Escape': closeRoasts(true); break;
+        case 'Tab': closeRoasts(true); return;
+        default: {
+          const index = options.findIndex(option => option.dataset.value.toLowerCase().startsWith(event.key.toLowerCase()));
+          if (event.key.length !== 1 || index < 0) return;
+          activate(index);
+        }
+      }
+      event.preventDefault();
+    });
+
+    document.addEventListener('click', (event) => {
+      if (!selector.contains(event.target)) closeRoasts();
+    });
+    selector.addEventListener('focusout', (event) => {
+      if (!selector.contains(event.relatedTarget)) closeRoasts();
+    });
+  </script>
