+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.gallery-thumbnails .thumbnail')];
+    let frame = null;
+    let settleTimer;
+
+    function markPending(index) {
+      if (index < 0) return;
+      thumbnails.forEach((thumbnail, i) => thumbnail.classList.toggle('pending', i === index));
+    }
+
+    function markActive(index) {
+      if (index < 0) return;
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', i === index);
+        if (i === index) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+    }
+
+    function closestItemIndex() {
+      const center = gallery.scrollLeft + gallery.clientWidth / 2;
+      let closest = 0;
+      let distance = Infinity;
+      items.forEach((item, index) => {
+        const nextDistance = Math.abs(item.offsetLeft + item.offsetWidth / 2 - center);
+        if (nextDistance < distance) {
+          closest = index;
+          distance = nextDistance;
+        }
+      });
+      return closest;
+    }
+
+    function finishScroll() {
+      clearTimeout(settleTimer);
+      cancelAnimationFrame(frame);
+      frame = null;
+      markActive(closestItemIndex());
+    }
+
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      markPending(items.indexOf(event.snapTargetInline));
+    });
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      markActive(items.indexOf(event.snapTargetInline));
+    });
+
+    const supportsSnapChanging = 'onscrollsnapchanging' in gallery;
+    const supportsScrollEnd = 'onscrollend' in gallery;
+    gallery.addEventListener('scroll', () => {
+      // Approximate the pending target where native snap prediction is unavailable.
+      if (!supportsSnapChanging && frame === null) {
+        frame = requestAnimationFrame(() => {
+          frame = null;
+          markPending(closestItemIndex());
+        });
+      }
+      if (!supportsScrollEnd) {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(finishScroll, 180);
+      }
+    }, { passive: true });
+    // Also clears pending when a gesture returns to the already active slide.
+    gallery.addEventListener('scrollend', finishScroll);
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        gallery.scrollTo({
+          left: items[index].offsetLeft + items[index].offsetWidth / 2 - gallery.clientWidth / 2,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    markActive(closestItemIndex());
+    window.addEventListener('pageshow', finishScroll);
+  </script>
+
