+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.gallery-thumbnails .thumbnail')];
+    const supportsSnapChanging = 'onscrollsnapchanging' in gallery;
+    const supportsScrollEnd = 'onscrollend' in gallery;
+    let previousScrollLeft = gallery.scrollLeft;
+    let settleTimer;
+    let pointerDown = false;
+
+    function markPending(index) {
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.toggle('pending', i === index);
+      });
+    }
+
+    function nearestIndex() {
+      const left = gallery.getBoundingClientRect().left;
+      return items.reduce((nearest, item, index) =>
+        Math.abs(item.getBoundingClientRect().left - left) <
+        Math.abs(items[nearest].getBoundingClientRect().left - left) ? index : nearest, 0);
+    }
+
+    function selectItem(index) {
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', i === index);
+        if (i === index) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+      previousScrollLeft = gallery.scrollLeft;
+    }
+
+    // Snap events report the browser's predicted target before scrolling ends.
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      const index = items.indexOf(event.snapTargetInline);
+      if (index !== -1) markPending(index);
+    });
+
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      const index = items.indexOf(event.snapTargetInline);
+      if (index !== -1) selectItem(index);
+    });
+
+    function finishScroll() {
+      clearTimeout(settleTimer);
+      if (!pointerDown) selectItem(nearestIndex());
+    }
+
+    gallery.addEventListener('scrollend', finishScroll);
+    gallery.addEventListener('scroll', () => {
+      if (!supportsSnapChanging) {
+        const direction = Math.sign(gallery.scrollLeft - previousScrollLeft);
+        const left = gallery.getBoundingClientRect().left;
+        const positions = items.map(item => item.getBoundingClientRect().left - left);
+        // Highlight the next snap point in the swipe direction immediately.
+        const next = direction > 0
+          ? positions.findIndex(position => position >= -1)
+          : positions.findLastIndex(position => position <= 1);
+        if (direction && next !== -1) markPending(next);
+      }
+      previousScrollLeft = gallery.scrollLeft;
+      if (!supportsScrollEnd) {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(finishScroll, 180);
+      }
+    }, { passive: true });
+
+    gallery.addEventListener('pointerdown', () => { pointerDown = true; });
+    function releasePointer() {
+      if (!pointerDown) return;
+      pointerDown = false;
+      if (!supportsScrollEnd) {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(finishScroll, 180);
+      }
+    }
+    window.addEventListener('pointerup', releasePointer);
+    window.addEventListener('pointercancel', releasePointer);
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        if (nearestIndex() === index &&
+            Math.abs(items[index].getBoundingClientRect().left - gallery.getBoundingClientRect().left) < 1) {
+          selectItem(index);
+          return;
+        }
+        markPending(index);
+        gallery.scrollTo({
+          left: gallery.scrollLeft + items[index].getBoundingClientRect().left - gallery.getBoundingClientRect().left,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+  </script>
