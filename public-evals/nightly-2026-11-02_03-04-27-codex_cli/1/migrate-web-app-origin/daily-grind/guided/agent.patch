+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="referrer" content="no-referrer">
+  <title>Transfer settings | The Daily Grind</title>
+  <script src="/migration-config.js" defer></script>
+  <script src="/migration.js" defer></script>
+  <style>
+    body { font: 1rem/1.6 system-ui, sans-serif; background: #fafafa; color: #3e2723; max-width: 38rem; margin: 10vh auto; padding: 1.5rem; }
+    button { font: inherit; padding: .75rem 1rem; background: #4e342e; color: white; border-radius: .3rem; cursor: pointer; }
+  </style>
+</head>
+<body>
+  <h1>Bring your settings with you</h1>
+  <p id="transfer-destination">Open this page using “Bring my settings” on our new site.</p>
+  <p>Your original settings stay here. Any settings already saved on the new site take priority.</p>
+  <button id="transfer-approve" type="button" hidden>Copy my settings</button>
+  <p id="migration-status" role="status" aria-live="polite"></p>
+</body>
+</html>
