@@ -0,0 +1,136 @@
+(() => {
+  'use strict';
+  const config = globalThis.appMigration;
+  if (!config?.enabled) return;
+  const { oldOrigin, newOrigin, storageKeys } = config;
+  const status = document.getElementById('migration-status');
+  const report = (message) => { status.textContent = message; };
+
+  function fromOrigin(event, expected) {
+    try {
+      if ('Origin' in globalThis) {
+        return Origin.from(event).isSameOrigin(Origin.from(expected));
+      }
+      const origin = new URL(event.origin).origin;
+      return origin !== 'null' && origin === new URL(expected).origin;
+    } catch {
+      return false;
+    }
+  }
+
+  const approve = document.getElementById('transfer-approve');
+  if (approve) {
+    if (location.origin !== oldOrigin || !window.opener) return;
+    const peer = window.opener;
+    let requestId;
+    let sent = false;
+    document.getElementById('transfer-destination').textContent = `Copy your preferences to ${newOrigin}.`;
+    window.addEventListener('message', (event) => {
+      if (event.source !== peer || !fromOrigin(event, newOrigin)) return;
+      if (event.data?.type === 'daily-grind:request' && typeof event.data.id === 'string' && !requestId) {
+        requestId = event.data.id;
+        approve.hidden = false;
+      }
+      if (sent && event.data?.type === 'daily-grind:complete' && event.data.id === requestId) {
+        report('Settings copied. You can close this window and return to the new app.');
+      }
+    });
+    approve.addEventListener('click', () => {
+      try {
+        const entries = storageKeys.map((key) => [key, localStorage.getItem(key)]);
+        peer.postMessage({ type: 'daily-grind:settings', id: requestId, entries }, newOrigin);
+        sent = true;
+        approve.disabled = true;
+        report('Waiting for the new app to confirm the transfer…');
+      } catch {
+        report('Your browser blocked access to settings. Allow site storage and try again.');
+      }
+    });
+    peer.postMessage({ type: 'daily-grind:ready' }, newOrigin);
+    return;
+  }
+
+  const banner = document.getElementById('migration');
+  if (location.origin !== oldOrigin && location.origin !== newOrigin) return;
+  banner.hidden = false;
+  const message = document.getElementById('migration-message');
+  if (location.origin === oldOrigin) {
+    message.textContent = 'The Daily Grind is moving. Visit our new home to bring your settings. If your browser offers an app update, accept it to keep your existing shortcuts. Otherwise, install the new site using your browser’s menu after copying your settings.';
+    const link = document.getElementById('migration-link');
+    link.href = `${newOrigin}/`;
+    link.hidden = false;
+    return;
+  }
+
+  message.textContent = 'Welcome to our new home. Copy your preferences from the previous site. Your browser may offer an app update to preserve your shortcuts; other browsers require installing this site again.';
+  const transfer = document.getElementById('migration-transfer');
+  transfer.hidden = false;
+  transfer.addEventListener('click', () => {
+    transfer.disabled = true;
+    const id = crypto.randomUUID();
+    let popup;
+    let timer;
+    let poll;
+    const cleanup = () => {
+      clearTimeout(timer);
+      clearInterval(poll);
+      window.removeEventListener('message', receive);
+      transfer.disabled = false;
+    };
+    const receive = (event) => {
+      if (!popup || event.source !== popup || !fromOrigin(event, oldOrigin)) return;
+      const data = event.data;
+      if (data?.type === 'daily-grind:ready') {
+        popup.postMessage({ type: 'daily-grind:request', id }, oldOrigin);
+        return;
+      }
+      if (data?.type !== 'daily-grind:settings' || data.id !== id) return;
+      const entries = data.entries;
+      if (!Array.isArray(entries) || entries.length !== storageKeys.length ||
+          entries.some((entry, index) => !Array.isArray(entry) || entry.length !== 2 ||
+            entry[0] !== storageKeys[index] || (entry[1] !== null && typeof entry[1] !== 'string'))) {
+        report('The settings response was invalid. Nothing was copied.');
+        cleanup();
+        return;
+      }
+      const added = [];
+      try {
+        // Never replace preferences already set on the destination.
+        for (const [key, value] of entries) {
+          if (value !== null && localStorage.getItem(key) === null) {
+            localStorage.setItem(key, value);
+            added.push(key);
+          }
+        }
+        popup.postMessage({ type: 'daily-grind:complete', id }, oldOrigin);
+        report('Settings copied. Existing preferences on this site were kept. You can close the transfer window.');
+      } catch {
+        // Roll back partial writes, leaving the source intact for a retry.
+        for (const key of added) {
+          try { localStorage.removeItem(key); } catch { /* Storage may be unavailable. */ }
+        }
+        report('Settings could not be saved. Allow site storage or free up space, then try again. Your original settings are safe.');
+      }
+      cleanup();
+    };
+    window.addEventListener('message', receive);
+    // Keep an opener only for this controlled, exact-origin handshake.
+    popup = window.open(`${oldOrigin}/transfer.html`, '_blank', 'popup,width=560,height=560');
+    if (!popup) {
+      cleanup();
+      report('Allow popups for this site, then try again.');
+      return;
+    }
+    report('Approve the settings copy in the window that just opened.');
+    timer = setTimeout(() => {
+      cleanup();
+      report('The transfer timed out. Your original settings are safe; you can try again.');
+    }, 120000);
+    poll = setInterval(() => {
+      if (popup.closed) {
+        cleanup();
+        report('The transfer window was closed. You can try again.');
+      }
+    }, 1000);
+  });
+})();
