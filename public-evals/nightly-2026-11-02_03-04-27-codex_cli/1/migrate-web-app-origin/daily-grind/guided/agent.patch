diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..2e5d62b
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,51 @@
+import { cp, mkdir, readFile, rm, writeFile } from 'node:fs/promises';
+import { getDomain } from 'tldts';
+
+function origin(name) {
+  const value = process.env[name];
+  if (!value) throw new Error(`${name} is required. Set both migration origins before building.`);
+  const url = new URL(value);
+  if (url.protocol !== 'https:' || url.username || url.password || url.pathname !== '/' || url.search || url.hash) {
+    throw new Error(`${name} must be an HTTPS origin without credentials, path, query or fragment.`);
+  }
+  return url;
+}
+
+const old = origin('OLD_ORIGIN');
+const next = origin('NEW_ORIGIN');
+const site = (url) => getDomain(url.hostname, { allowPrivateDomains: true });
+if (old.origin === next.origin || !site(old) || site(old) !== site(next)) {
+  throw new Error('Migration requires different origins on the same registrable domain (including private suffixes).');
+}
+const oldId = new URL(process.env.OLD_APP_ID || '/', old);
+if (oldId.origin !== old.origin || oldId.hash || oldId.username || oldId.password) {
+  throw new Error('OLD_APP_ID must be the existing installed app ID on OLD_ORIGIN, without a fragment or credentials.');
+}
+const storageKeys = JSON.parse(process.env.MIGRATION_STORAGE_KEYS || '[]');
+if (!Array.isArray(storageKeys) || storageKeys.some((key) => typeof key !== 'string' || !key) ||
+    new Set(storageKeys).size !== storageKeys.length) {
+  throw new Error('MIGRATION_STORAGE_KEYS must be a JSON array of unique, nonempty localStorage keys.');
+}
+const base = JSON.parse(await readFile('manifest.webmanifest', 'utf8'));
+const manifests = {
+  old: { ...base, id: oldId.href, migrate_to: { id: `${next.origin}/`, install_url: `${next.origin}/` } },
+  new: { ...base, migrate_from: [{ id: oldId.href, install_url: `${old.origin}/`, behavior: 'suggest' }] },
+};
+// Validate all inputs before touching deployment output.
+await rm('dist', { recursive: true, force: true });
+for (const role of ['old', 'new']) {
+  const dir = `dist/${role}`;
+  await mkdir(dir, { recursive: true });
+  for (const file of ['index.html', 'transfer.html', 'migration.js', 'assets']) {
+    await cp(file, `${dir}/${file}`, { recursive: true });
+  }
+  await writeFile(`${dir}/manifest.webmanifest`, JSON.stringify(manifests[role], null, 2));
+  await writeFile(`${dir}/migration-config.js`, `globalThis.appMigration = ${JSON.stringify({
+    enabled: true, oldOrigin: old.origin, newOrigin: next.origin, storageKeys,
+  })};\n`);
+}
+await mkdir('dist/old/.well-known', { recursive: true });
+await writeFile('dist/old/.well-known/web-app-origin-association', JSON.stringify({
+  [`${next.origin}/`]: { allow_migration: true },
+}, null, 2));
+console.log('Built dist/old and dist/new. Deploy each to its corresponding origin; keep the old origin available.');
