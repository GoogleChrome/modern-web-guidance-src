+(() => {
+  'use strict';
+  const $ = id => document.getElementById(id);
+  const CONFIG_KEY = 'dailygrind.preferences';
+  const defaults = { theme: 'system', notifications: true, language: 'en' };
+  let destination = '';
+  let toastTimer;
+  function preferences() {
+    try { return sanitize(JSON.parse(localStorage.getItem(CONFIG_KEY)) || defaults); }
+    catch { return { ...defaults }; }
+  }
+  function sanitize(value) {
+    if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('Invalid preferences.');
+    if (!['system', 'light', 'dark'].includes(value.theme) || typeof value.notifications !== 'boolean' || !['en', 'es', 'fr'].includes(value.language)) throw new Error('This file contains unsupported preferences.');
+    return { theme: value.theme, notifications: value.notifications, language: value.language };
+  }
+  function normalizeOrigin(value) {
+    let url;
+    try { url = new URL(value); } catch { throw new Error('Enter a valid origin, such as https://app.example.com.'); }
+    if (url.protocol !== 'https:') throw new Error('Use a secure HTTPS origin.');
+    if (url.username || url.password || url.pathname !== '/' || url.search || url.hash) throw new Error('Enter an origin only, without credentials, a path, query, or fragment.');
+    if (url.origin === location.origin) throw new Error('Choose a different origin from your current installation.');
+    return url.origin;
+  }
+  function toast(message) {
+    $('toast').textContent = message;
+    $('toast').classList.remove('hidden');
+    clearTimeout(toastTimer);
+    toastTimer = setTimeout(() => $('toast').classList.add('hidden'), 5500);
+  }
+  function info(title, content) {
+    $('info-title').textContent = title;
+    $('info-content').replaceChildren();
+    const paragraph = document.createElement('p');
+    paragraph.textContent = content;
+    $('info-content').append(paragraph);
+    $('info-dialog').showModal();
+  }
+  $('current-origin').textContent = location.origin;
+  $('transfer-form').addEventListener('submit', event => {
+    event.preventDefault();
+    try {
+      destination = normalizeOrigin($('destination').value.trim());
+      $('origin-error').classList.add('hidden');
+      $('destination').removeAttribute('aria-invalid');
+      $('review-origin').textContent = destination;
+      const settings = preferences();
+      $('config-count').textContent = `${Object.keys(settings).length} preferences included: appearance, notifications, and language.`;
+      $('review-dialog').showModal();
+    } catch (error) {
+      $('origin-error').textContent = error.message;
+      $('origin-error').classList.remove('hidden');
+      $('destination').setAttribute('aria-invalid', 'true');
+      $('destination').focus();
+    }
+  });
+  $('destination').addEventListener('input', () => {
+    $('origin-error').classList.add('hidden');
+    $('destination').removeAttribute('aria-invalid');
+  });
+  $('cancel-review').onclick = () => $('review-dialog').close();
+  $('close-info').onclick = () => $('info-dialog').close();
+  $('export-button').onclick = () => {
+    const bundle = { format: 'dailygrind-origin-transfer', version: 1, sourceOrigin: location.origin, destinationOrigin: destination, exportedAt: new Date().toISOString(), preferences: preferences() };
+    const blob = new Blob([JSON.stringify(bundle, null, 2)], { type: 'application/json' });
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = 'dailygrind-transfer.json';
+    document.body.append(link);
+    link.click();
+    link.remove();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+    $('review-dialog').close();
+    toast('Transfer file exported. Import it at your new origin to continue.');
+  };
+  $('import-button').onclick = () => $('import-file').click();
+  $('import-file').onchange = async event => {
+    const file = event.target.files[0];
+    if (!file) return;
+    try {
+      if (file.size > 100000) throw new Error('Choose a Daily Grind transfer file smaller than 100 KB.');
+      const bundle = JSON.parse(await file.text());
+      if (bundle.format !== 'dailygrind-origin-transfer' || bundle.version !== 1) throw new Error('This is not a supported Daily Grind transfer file.');
+      if (bundle.destinationOrigin !== location.origin) throw new Error('This transfer file belongs to a different destination origin. Open the app at its intended address to import.');
+      const settings = sanitize(bundle.preferences);
+      localStorage.setItem(CONFIG_KEY, JSON.stringify(settings));
+      toast('Configuration imported. Your preferences are saved on this device.');
+    } catch (error) {
+      info('Couldn’t import configuration', error instanceof SyntaxError ? 'The file is not valid JSON. Choose your exported Daily Grind transfer file.' : error.message);
+    } finally { event.target.value = ''; }
+  };
+  const showGuide = event => {
+    event.preventDefault();
+    info('Your migration guide', '1. Deploy this app at the new HTTPS origin. 2. Enter that origin here and export your transfer file. 3. Open the new app and import the file. 4. Install the new app from your browser, then pin or recreate its shortcuts. 5. Confirm your preferences before removing the original app. This page cannot change browser-managed installations or OS shortcuts.');
+  };
+  $('guide').onclick = showGuide;
+  $('help-link').onclick = showGuide;
+  $('notifications').onclick = () => info('You’re all caught up', 'No new notifications. Your original installation remains available while you prepare your move.');
+  document.querySelectorAll('[data-view]').forEach(link => link.onclick = event => {
+    event.preventDefault();
+    const name = link.dataset.view;
+    const content = name === 'Overview' ? `Daily Grind is running at ${location.origin}. Use App management to prepare a move to a new address.` : name === 'My applications' ? `The Daily Grind · Current origin: ${location.origin}` : 'No transfers have been performed by this page. Exporting a file leaves your current installation in place.';
+    info(name, content);
+  });
+  function showSettings(event) {
+    event.preventDefault();
+    info('App settings', 'These preferences will be included in your transfer file.');
+    const settings = preferences();
+    const form = document.createElement('form');
+    form.className = 'settings-details';
+    for (const [key, values] of Object.entries({ theme: ['system', 'light', 'dark'], language: ['en', 'es', 'fr'], notifications: ['true', 'false'] })) {
+      const label = document.createElement('label');
+      label.textContent = key.charAt(0).toUpperCase() + key.slice(1);
+      const select = document.createElement('select');
+      select.name = key;
+      values.forEach(value => { const option = document.createElement('option'); option.value = value; option.textContent = value; select.append(option); });
+      select.value = String(settings[key]);
+      select.onchange = () => {
+        try {
+          const current = preferences();
+          current[key] = key === 'notifications' ? select.value === 'true' : select.value;
+          localStorage.setItem(CONFIG_KEY, JSON.stringify(current));
+          toast('Preference saved.');
+        } catch { toast('Unable to save preferences. Check your browser storage settings.'); }
+      };
+      label.append(select);
+      form.append(label, document.createElement('br'));
+    }
+    $('info-content').append(form);
+  }
+  $('back-settings').onclick = showSettings;
+  document.querySelector('a[aria-current]').onclick = showSettings;
+})();
