+    /* Each manual popover is an independent top-layer element. Toasts are
+       prepended to body so their sibling index is also their stack position. */
+    .toast {
+      --toast-height: 64px;
+      position: fixed;
+      inset: auto;
+      right: max(1rem, env(safe-area-inset-right));
+      bottom: calc(max(1rem, env(safe-area-inset-bottom)) +
+        (sibling-index() - 1) * (var(--toast-height) + 12px));
+      width: min(320px, calc(100vw - 2rem));
+      height: var(--toast-height);
+      margin: 0;
+      padding: 12px 16px;
+      border: 1px solid var(--secondary);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(62 39 35 / 20%);
+      align-items: center;
+      justify-content: space-between;
+      gap: 12px;
+      opacity: 0;
+      transform: translateX(24px);
+      transition: opacity 200ms ease, transform 200ms ease,
+        bottom 200ms ease, display 200ms allow-discrete,
+        overlay 200ms allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      opacity: 1;
+      transform: translateX(0);
+    }
+
+    .toast::backdrop {
+      background: transparent;
+      pointer-events: none;
+    }
+
+    .toast-close {
+      display: grid;
+      place-items: center;
+      flex: 0 0 32px;
+      height: 32px;
+      border: 0;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font-size: 1.5rem;
+      cursor: pointer;
+    }
+
+    .toast-close:hover {
+      background: rgb(255 255 255 / 15%);
+    }
+
+    .toast-close:focus-visible,
+    .toast-trigger:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        transform: translateX(24px);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transition: none;
+        transform: none;
+      }
+    }
