+  <template id="toast-template">
+    <div class="toast" popover="manual">
+      <span role="status" aria-live="polite" aria-atomic="true"></span>
+      <button type="button" class="toast-close" popovertargetaction="hide"
+        aria-label="Close notification">&times;</button>
+    </div>
+  </template>
+
+  <script>
+    const toastTemplate = document.querySelector('#toast-template');
+    let toastId = 0;
+
+    function showToast(trigger) {
+      const toast = toastTemplate.content.firstElementChild.cloneNode(true);
+      const closeButton = toast.querySelector('.toast-close');
+      toast.id = `cart-toast-${++toastId}`;
+      closeButton.setAttribute('popovertarget', toast.id);
+
+      // No wrapper or measured coordinates: CSS handles every stack offset.
+      document.body.prepend(toast);
+      toast.showPopover();
+      toast.querySelector('[role="status"]').textContent = 'added to cart!';
+
+      const timer = setTimeout(dismiss, 3000);
+
+      async function dismiss() {
+        if (toast.hasAttribute('data-closing')) return;
+        clearTimeout(timer);
+        if (toast.contains(document.activeElement)) trigger.focus({ preventScroll: true });
+        // Keep the popover in the top layer until its exit finishes, including
+        // browsers that do not support discrete display/overlay transitions.
+        toast.setAttribute('data-closing', '');
+        await Promise.allSettled(toast.getAnimations().map(animation => animation.finished));
+        toast.hidePopover();
+        toast.remove();
+      }
+
+      closeButton.addEventListener('click', event => {
+        event.preventDefault();
+        dismiss();
+      });
+    }
+
+    document.querySelectorAll('.toast-trigger').forEach(trigger => {
+      trigger.addEventListener('click', () => showToast(trigger));
+    });
+  </script>
+
