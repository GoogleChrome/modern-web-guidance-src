+    /* Each toast is an independent native top-layer element. Toasts are
+       prepended to body so their sibling index counts only other toasts. */
+    .toast {
+      position: fixed;
+      inset: auto 1rem 1rem auto;
+      bottom: calc(1rem + (sibling-index() - 1) * 5.25rem);
+      margin: 0;
+      inline-size: min(22rem, calc(100vw - 2rem));
+      block-size: 4.5rem;
+      padding: 0.75rem 1rem;
+      border: 1px solid var(--secondary);
+      border-inline-start: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(0 0 0 / 0.2);
+      align-items: center;
+      justify-content: space-between;
+      gap: 1rem;
+      pointer-events: none;
+      opacity: 0;
+      transform: translateX(1rem);
+      transition: opacity 180ms ease, transform 180ms ease, bottom 180ms ease,
+        display 180ms, overlay 180ms;
+      transition-behavior: allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+    }
+
+    .toast:popover-open:not([data-closing]) {
+      opacity: 1;
+      transform: translateX(0);
+    }
+
+    @starting-style {
+      .toast:popover-open:not([data-closing]) {
