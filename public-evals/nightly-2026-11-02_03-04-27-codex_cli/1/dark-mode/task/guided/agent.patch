+  <script>
+    const themeSelect = document.getElementById('theme-select');
+    const schemeMeta = document.querySelector('meta[name="color-scheme"]');
+    const systemScheme = window.matchMedia('(prefers-color-scheme: dark)');
+
+    function applyTheme(value) {
+      const theme = value === 'light' || value === 'dark' ? value : 'system';
+      if (theme === 'system') delete document.documentElement.dataset.theme;
+      else document.documentElement.dataset.theme = theme;
+      schemeMeta.content = theme === 'system' ? 'light dark' : theme;
+      themeSelect.value = theme;
+    }
+
+    function updateSystemLabel() {
+      themeSelect.options[0].textContent = `System default (${systemScheme.matches ? 'dark' : 'light'})`;
+    }
+
+    applyTheme(document.documentElement.dataset.theme);
+    updateSystemLabel();
+    systemScheme.addEventListener('change', updateSystemLabel);
+    themeSelect.addEventListener('change', () => {
+      applyTheme(themeSelect.value);
+      try {
+        if (themeSelect.value === 'system') localStorage.removeItem('daily-grind-theme');
+        else localStorage.setItem('daily-grind-theme', themeSelect.value);
+      } catch { /* The theme still works when storage is unavailable. */ }
+    });
+    window.addEventListener('storage', (event) => {
+      if (event.key === 'daily-grind-theme' || event.key === null) applyTheme(event.newValue);
+    });
+
+    const specialsSelect = document.getElementById('specials-select');
+    specialsSelect.addEventListener('change', () => {
+      document.querySelectorAll('.special').forEach((special) => {
+        special.hidden = specialsSelect.value !== 'all' && special.dataset.category !== specialsSelect.value;
+      });
+      document.querySelector('.late-night .scroll-container').scrollTop = 0;
+    });
+  </script>
