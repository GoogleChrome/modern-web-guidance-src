+      width: 100%;
+      height: 200px;
+      object-fit: cover;
+      border-radius: 5px;
+      margin-bottom: 20px;
+    }
+
+    .card p {
+      flex-grow: 1;
+    }
+
+    .scroller:focus-visible,
+    a:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 5px;
+    }
+
+    nav a:focus-visible {
+      outline-color: var(--accent);
+    }
+
+    @keyframes center-card {
+      0%, 100% { scale: 0.85; }
+      50% { scale: 1; }
+    }
+
+    /* Enhance only when supported and when the user allows motion. */
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: view()) and (animation-range: entry)) {
+        .scroller > li {
+          /* Track the unscaled list item to keep the timeline stable. */
+          view-timeline: --product inline;
+          view-timeline-inset: 0;
+        }
+
+        .scroller .card {
+          animation: center-card auto linear both;
+          animation-timeline: --product;
+          animation-range: cover;
+        }
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
