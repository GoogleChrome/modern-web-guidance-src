diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,10 +11,51 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      --scrollbar-thumb: var(--primary);
+      --scrollbar-track: var(--light);
+
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+      scrollbar-width: auto;
+      scrollbar-gutter: stable;
     }
 
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-thumb: #000;
+        --scrollbar-track: #fff;
+      }
+    }
+
+    /* Let the user's system palette control forced-colors scrollbars. */
+    @media (forced-colors: active) {
+      :root {
+        --scrollbar-thumb: CanvasText;
+        --scrollbar-track: Canvas;
+        scrollbar-color: auto;
+      }
+    }
+
+    /* Fallback for browsers without standard scrollbar colors. */
+    @supports not (scrollbar-color: auto) {
+      :root::-webkit-scrollbar {
+        width: 14px;
+        height: 14px;
+      }
+
+      :root::-webkit-scrollbar-thumb {
+        background-color: var(--scrollbar-thumb);
+        border: 2px solid var(--scrollbar-track);
+        border-radius: 7px;
+      }
+
+      :root::-webkit-scrollbar-track,
+      :root::-webkit-scrollbar-corner {
+        background-color: var(--scrollbar-track);
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
