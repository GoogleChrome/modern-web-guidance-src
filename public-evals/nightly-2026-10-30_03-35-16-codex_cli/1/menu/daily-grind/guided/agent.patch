+      const rootOf = menu => menu.parentMenu ? rootOf(menu.parentMenu) : menu;
+      const focusTrigger = (menu, pointer = false) => menu.trigger.focus({ preventScroll: true, focusVisible: !pointer });
+
+      function position(menu) {
+        if (anchored) return;
+        const rect = menu.trigger.getBoundingClientRect();
+        const width = menu.offsetWidth;
+        const height = menu.offsetHeight;
+        const vw = document.documentElement.clientWidth;
+        const vh = window.innerHeight;
+        let left = rect.left;
+        let top = rect.bottom + 6;
+        if (menu.parentMenu) {
+          if (rect.right + width + 6 <= vw - 12) {
+            left = rect.right + 6;
+            top = rect.top;
+          } else if (rect.left - width - 6 >= 12) {
+            left = rect.left - width - 6;
+            top = rect.top;
+          } else {
+            // On small screens, open below the row so its trigger stays visible.
+            left = rect.left + 16;
+          }
+        } else if (top + height > vh - 12 && rect.top - height - 6 >= 12) {
+          top = rect.top - height - 6;
+        }
+        menu.style.setProperty('--menu-left', `${Math.max(12, Math.min(left, vw - width - 12))}px`);
+        menu.style.setProperty('--menu-top', `${Math.max(12, Math.min(top, vh - height - 12))}px`);
+      }
+
+      function sync(menu, open) {
