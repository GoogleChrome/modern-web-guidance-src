+
+      function createMenu(mount, label, entries, { parentMenu = null, className = '', heading = label, accessibleLabel = label } = {}) {
+        const id = `action-menu-${++sequence}`;
+        const trigger = document.createElement('button');
+        trigger.type = 'button';
+        trigger.id = `${id}-trigger`;
