+      let sequence = 0;
+      let orderCount = 0;
+      const announce = message => { status.textContent = message; };
+      const isOpen = menu => nativePopover ? menu.matches(':popover-open') : menu.hasAttribute('data-open');
+      const itemsOf = menu => [...menu.group.querySelectorAll('button, a')]
