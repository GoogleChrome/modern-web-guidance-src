+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.cafe-gallery .thumbnail')];
+
+    function setPending(index) {
+      if (index < 0) return;
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.toggle('pending', i === index);
+      });
+    }
+
+    function setActive(index) {
+      if (index < 0) return;
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', i === index);
+        if (i === index) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+    }
+
+    function closestItemIndex() {
+      // The positioned gallery is the offset parent for these start-aligned slides.
+      return items.reduce((closest, item, index) =>
+        Math.abs(item.offsetLeft - gallery.scrollLeft) <
+        Math.abs(items[closest].offsetLeft - gallery.scrollLeft) ? index : closest, 0);
+    }
+
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      setPending(items.indexOf(event.snapTargetInline));
+    });
+
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      setActive(items.indexOf(event.snapTargetInline));
+    });
+
+    let pendingFrame = null;
+    let settleTimeout;
+    const hasSnapChanging = 'onscrollsnapchanging' in gallery;
+    const hasScrollEnd = 'onscrollend' in gallery;
+
+    function settleSelection() {
+      clearTimeout(settleTimeout);
+      // Cancel queued feedback so it cannot reapply pending after settling.
+      if (pendingFrame !== null) cancelAnimationFrame(pendingFrame);
+      pendingFrame = null;
+      setActive(closestItemIndex());
+    }
+
+    gallery.addEventListener('scroll', () => {
+      if (!hasSnapChanging && pendingFrame === null) {
+        pendingFrame = requestAnimationFrame(() => {
+          pendingFrame = null;
+          setPending(closestItemIndex());
+        });
+      }
+      if (!hasScrollEnd) {
+        clearTimeout(settleTimeout);
+        settleTimeout = setTimeout(settleSelection, 180);
+      }
+    }, { passive: true });
+
+    // Also clears pending when a gesture returns to the already active slide.
+    gallery.addEventListener('scrollend', settleSelection);
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        if (Math.abs(gallery.scrollLeft - items[index].offsetLeft) < 1) {
+          settleSelection();
+          return;
+        }
+        setPending(index);
+        gallery.scrollTo({
+          left: items[index].offsetLeft,
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    setActive(closestItemIndex());
+    window.addEventListener('pageshow', settleSelection);
+    window.addEventListener('resize', settleSelection);
+  </script>
+
