+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+    const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+    const supportsSnapChanging = 'onscrollsnapchanging' in gallery;
+    const supportsScrollEnd = 'onscrollend' in gallery;
+    let settleTimer;
+    let pointerDown = false;
+
+    function nearestIndex() {
+      const galleryLeft = gallery.getBoundingClientRect().left + gallery.clientLeft;
+      let closest = 0;
+      items.forEach((item, index) => {
+        if (Math.abs(item.getBoundingClientRect().left - galleryLeft) <
+            Math.abs(items[closest].getBoundingClientRect().left - galleryLeft)) {
+          closest = index;
+        }
+      });
+      return closest;
+    }
+
+    function showPending(index) {
+      thumbnails.forEach((thumbnail, itemIndex) => {
+        thumbnail.classList.toggle('pending', itemIndex === index);
+      });
+    }
+
+    function selectSettledPhoto() {
+      clearTimeout(settleTimer);
+      const selected = nearestIndex();
+      thumbnails.forEach((thumbnail, index) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', index === selected);
+        if (index === selected) {
+          thumbnail.setAttribute('aria-current', 'true');
+        } else {
+          thumbnail.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    // This event reports the browser's intended snap target during the gesture.
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      const index = items.indexOf(event.snapTargetInline);
+      if (index !== -1) showPending(index);
+    });
+
+    function scheduleSettle() {
+      clearTimeout(settleTimer);
+      if (!supportsScrollEnd && !pointerDown) {
+        settleTimer = setTimeout(selectSettledPhoto, 180);
+      }
+    }
+
+    gallery.addEventListener('scroll', () => {
+      if (!supportsSnapChanging) showPending(nearestIndex());
+      scheduleSettle();
+    }, { passive: true });
+    gallery.addEventListener('scrollend', selectSettledPhoto);
+    gallery.addEventListener('pointerdown', () => {
+      pointerDown = true;
+      clearTimeout(settleTimer);
+    }, { passive: true });
+    function releasePointer() {
+      if (!pointerDown) return;
+      pointerDown = false;
+      scheduleSettle();
+    }
+    window.addEventListener('pointerup', releasePointer);
+    window.addEventListener('pointercancel', releasePointer);
+
+    function goToPhoto(index) {
+      if (index === nearestIndex() &&
+          Math.abs(items[index].getBoundingClientRect().left - gallery.getBoundingClientRect().left) < 1) {
+        selectSettledPhoto();
+        return;
+      }
+      showPending(index);
+      gallery.scrollTo({
+        left: gallery.scrollLeft + items[index].getBoundingClientRect().left -
+          gallery.getBoundingClientRect().left - gallery.clientLeft,
+        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+      });
+      scheduleSettle();
+    }
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => goToPhoto(index));
+    });
+    gallery.addEventListener('keydown', (event) => {
+      let index = nearestIndex();
+      if (event.key === 'ArrowRight') index = Math.min(index + 1, items.length - 1);
+      else if (event.key === 'ArrowLeft') index = Math.max(index - 1, 0);
+      else if (event.key === 'Home') index = 0;
+      else if (event.key === 'End') index = items.length - 1;
+      else return;
+      event.preventDefault();
+      goToPhoto(index);
+    });
+  </script>
