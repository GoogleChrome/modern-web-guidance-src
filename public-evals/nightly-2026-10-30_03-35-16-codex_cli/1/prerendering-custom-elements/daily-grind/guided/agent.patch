diff --git a/drink-card.js b/drink-card.js
new file mode 100644
index 0000000..c153daf
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,54 @@
+// All content and styles arrive in HTML. Upgrade only wires up behavior.
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['favorited'];
+
+  #button;
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+
+  set favorited(value) {
+    this.toggleAttribute('favorited', Boolean(value));
+  }
+
+  connectedCallback() {
+    // Reconnecting a card must preserve its nodes, state, and single listener.
+    if (this.#button) return;
+
+    // Older parsers leave DSD templates inert. Reuse the same server markup.
+    if (!this.shadowRoot) {
+      const template = this.querySelector('template[shadowrootmode="open"]');
+      if (!template) return;
+      this.attachShadow({ mode: 'open', delegatesFocus: true })
+        .append(template.content);
+      template.remove();
+    }
+
+    this.#button = this.shadowRoot.getElementById('favorite');
+    if (!this.#button) return;
+
+    this.#button.addEventListener('click', () => {
+      this.favorited = !this.favorited;
+      this.dispatchEvent(new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { favorited: this.favorited },
+      }));
+    });
+    this.#syncFavorite();
+    this.#button.disabled = false;
+  }
+
+  attributeChangedCallback() {
+    this.#syncFavorite();
+  }
+
+  #syncFavorite() {
+    this.#button?.setAttribute('aria-pressed', String(this.favorited));
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
