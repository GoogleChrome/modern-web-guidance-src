@@ -134,8 +134,117 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    .card-actions {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 10px;
+      margin-top: 15px;
+    }
+
+    .card-actions .btn {
+      margin-top: 0;
+    }
+
+    .info-button {
+      display: inline-grid;
+      place-items: center;
+      width: 36px;
+      height: 36px;
+      border: 1px solid var(--primary);
+      border-radius: 50%;
+      background: white;
+      color: var(--primary);
+      font: bold 1rem Georgia, serif;
+      cursor: pointer;
+    }
+
+    .info-button:hover {
+      background: var(--secondary);
+    }
+
+    .info-button:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    #maple-tooltip {
+      position: fixed;
+      width: min(18rem, calc(100vw - 2rem));
+      margin: auto;
+      padding: 0;
+      border: 0;
+      overflow: visible;
+      background: transparent;
+      color: white;
+      text-align: start;
+    }
+
+    .tooltip-content {
+      position: relative;
+      padding: 12px 16px;
+      border-radius: 12px 12px 4px 4px;
+      background: var(--primary);
+      font-size: 0.9rem;
+      box-shadow: 0 4px 16px rgb(0 0 0 / 18%);
+    }
+
+    @supports (anchor-name: --tooltip-anchor) {
+      #maple-tooltip {
+        inset: auto;
+        margin: 0;
+        position-area: block-start;
+        position-try-fallbacks: flip-block;
+        container-type: anchored;
+      }
+
+      .tooltip-content {
+        margin-block: 0 12px;
+      }
+
+      /* Only show an arrow when CSS can track the active fallback. */
+      @supports (container-type: anchored) {
+        .tooltip-content::before {
+          content: "";
+          position: absolute;
+          inset-block-start: 100%;
+          inset-inline-start: 50%;
+          transform: translateX(-50%);
+          border: 8px solid transparent;
+          border-block-start-color: var(--primary);
+        }
+
+        @container anchored(fallback: flip-block) {
+          .tooltip-content {
+            margin-block: 12px 0;
+            border-radius: 4px 4px 12px 12px;
+          }
+
+          .tooltip-content::before {
+            inset-block-start: auto;
+            inset-block-end: 100%;
+            border-block-start-color: transparent;
+            border-block-end-color: var(--primary);
+          }
+        }
+      }
+    }
+
+    /* Keep the description readable in browsers without native popovers. */
+    @supports not selector(:popover-open) {
+      .info-button {
+        display: none;
+      }
+
+      #maple-tooltip {
+        position: static;
+        margin-top: 12px;
+        max-width: 100%;
+      }
+    }
+
