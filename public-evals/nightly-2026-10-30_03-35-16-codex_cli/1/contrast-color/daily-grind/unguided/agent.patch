+  <script>
+    // Older browsers use the same WCAG black/white contrast choice as contrast-color().
+    if (!CSS.supports('color', 'contrast-color(red)')) {
+      const root = document.documentElement;
+      const context = document.createElement('canvas').getContext('2d', { willReadFrequently: true });
+      const surfaces = [
+        [document.querySelector('nav'), '--on-primary'],
+        [document.querySelector('footer'), '--on-secondary'],
+      ];
+
+      function updateContrast() {
+        for (const [surface, property] of surfaces) {
+          context.clearRect(0, 0, 1, 1);
+          context.fillStyle = getComputedStyle(surface).backgroundColor;
+          context.fillRect(0, 0, 1, 1);
+          const channels = [...context.getImageData(0, 0, 1, 1).data].slice(0, 3);
+          const linear = channels.map(channel => {
+            const value = channel / 255;
+            return value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;
+          });
+          const luminance = 0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2];
+          const foreground = (luminance + 0.05) / 0.05 >= 1.05 / (luminance + 0.05) ? '#000' : '#fff';
+          if (root.style.getPropertyValue(property) !== foreground) {
+            root.style.setProperty(property, foreground);
+          }
+        }
+      }
+
+      // Recalculate after theme variables, classes, or stylesheet contents change.
+      new MutationObserver(updateContrast).observe(root, {
+        attributes: true,
+        childList: true,
+        characterData: true,
+        subtree: true,
+      });
+      document.addEventListener('load', updateContrast, true);
+      window.addEventListener('resize', updateContrast);
+      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateContrast);
+      updateContrast();
+    }
+  </script>
+
