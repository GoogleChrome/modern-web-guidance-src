+    }
+
+    #alert-dismiss {
+      flex-shrink: 0;
+      min-inline-size: 44px;
+      min-block-size: 44px;
+      border: 1px solid currentColor;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font-size: 1.5rem;
+      cursor: pointer;
+    }
+
+    .faq {
