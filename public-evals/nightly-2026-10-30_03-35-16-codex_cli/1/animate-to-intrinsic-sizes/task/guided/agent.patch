+      font-weight: 600;
+      cursor: pointer;
+    }
+
+    #faq-content {
+      padding: 0 1.25rem 1.25rem;
+    }
+
+    /* Native details manages expanded state and hides collapsed content
+       from keyboard navigation and assistive technology. */
+    .faq details::details-content {
+      block-size: 0;
+      overflow: hidden;
+      transition: block-size 400ms ease,
+        content-visibility 400ms allow-discrete;
+    }
+
+    .faq details[open]::details-content {
+      block-size: auto;
+    }
+
+    #faq-trigger:focus-visible,
+    #alert-dismiss:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #promo-alert,
+      .faq details::details-content {
+        transition: none;
+      }
+    }
   </style>
