+    /* Assign --icon on a component; customize size/color on its .icon.
+       Decorative icons use aria-hidden. For a meaningful standalone icon,
+       use role="img" and aria-label instead; icon-only controls need a label. */
+    .icon {
+      display: inline-block;
+      inline-size: var(--icon-size, 1em);
+      block-size: var(--icon-size, 1em);
+      flex: none;
+      background-color: var(--icon-color, currentColor);
+      -webkit-mask: var(--icon) no-repeat center / contain;
+      mask: var(--icon) no-repeat center / contain;
+      vertical-align: -0.125em;
+      pointer-events: none;
+      /* Preserve the mask fill while currentColor follows system text colors. */
+      forced-color-adjust: none;
+    }
