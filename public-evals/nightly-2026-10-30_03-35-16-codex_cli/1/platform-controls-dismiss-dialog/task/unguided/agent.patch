+  <script>
+    const dialog = document.querySelector('#coffee-details');
+    const title = document.querySelector('#coffee-title');
+    const description = document.querySelector('#coffee-description');
+    const menuLink = document.querySelector('#coffee-menu');
+    const detailsButtons = Array.from(document.querySelectorAll('[data-menu-url]'));
+    // Scope history entries to this page load so unrelated state is left alone.
+    const historyKey = `coffee-details-${Date.now()}`;
+    let returningFromDialog = false;
+
+    function showCoffee(index) {
+      const button = detailsButtons[index];
+      const card = button.closest('.card');
+      title.textContent = card.querySelector('h3').textContent;
+      description.textContent = card.querySelector('p').textContent;
+      menuLink.href = button.dataset.menuUrl;
+      if (!dialog.open) dialog.showModal();
+    }
+
+    detailsButtons.forEach((button, index) => {
+      button.addEventListener('click', () => {
+        if (returningFromDialog || dialog.open) return;
+        history.pushState({ ...history.state, [historyKey]: index }, '');
+        showCoffee(index);
+      });
+    });
+
+    // Native close requests include Escape and supported mobile back gestures.
+    // Consume the dialog's history entry for these and for the Close button.
+    dialog.addEventListener('close', () => {
+      if (Number.isInteger(history.state?.[historyKey])) {
+        returningFromDialog = true;
+        history.back();
+      }
+    });
+
+    // History also handles Back on browsers without native mobile close requests.
+    window.addEventListener('popstate', () => {
+      returningFromDialog = false;
+      const index = history.state?.[historyKey];
+      if (Number.isInteger(index) && detailsButtons[index]) {
+        showCoffee(index);
+      } else if (dialog.open) {
+        dialog.close();
+      }
+    });
+  </script>
+
