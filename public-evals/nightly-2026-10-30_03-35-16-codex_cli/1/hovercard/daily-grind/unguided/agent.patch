+  <script>
+    (() => {
+      let activePreview = null;
+
+      document.querySelectorAll('.drink-preview').forEach((wrapper) => {
+        const trigger = wrapper.querySelector('.preview-trigger');
+        const panel = wrapper.querySelector('.hovercard');
+        const closeButton = wrapper.querySelector('.preview-close');
+        let closeTimer;
+        let dismissed = false;
+
+        const position = () => {
+          if (panel.hidden) return;
+          const bounds = trigger.getBoundingClientRect();
+          const margin = 12;
+          const gap = 10;
+          const width = panel.offsetWidth;
+          const height = panel.offsetHeight;
+          const left = Math.max(margin, Math.min(
+            bounds.left + bounds.width / 2 - width / 2,
+            window.innerWidth - width - margin
+          ));
+          const below = bounds.bottom + gap;
+          const top = below + height <= window.innerHeight - margin
+            ? below
+            : Math.max(margin, bounds.top - height - gap);
+          panel.style.left = `${left}px`;
+          panel.style.top = `${top}px`;
+        };
+
+        const close = () => {
+          clearTimeout(closeTimer);
+          panel.hidden = true;
+          trigger.setAttribute('aria-expanded', 'false');
+          if (activePreview?.panel === panel) activePreview = null;
+        };
+
+        const open = () => {
+          clearTimeout(closeTimer);
+          if (dismissed) return;
+          if (activePreview?.panel !== panel) activePreview?.close();
+          panel.hidden = false;
+          trigger.setAttribute('aria-expanded', 'true');
+          activePreview = { panel, close, position };
+          position();
+        };
+
+        const scheduleClose = () => {
+          clearTimeout(closeTimer);
+          closeTimer = setTimeout(() => {
+            if (!wrapper.matches(':hover') && !wrapper.contains(document.activeElement)) close();
+          }, 180);
+        };
+
+        wrapper.addEventListener('pointerenter', (event) => {
+          if (event.pointerType === 'touch') return;
+          dismissed = false;
+          open();
+        });
+        wrapper.addEventListener('pointerleave', () => {
+          dismissed = false;
+          scheduleClose();
+        });
+        wrapper.addEventListener('focusin', open);
+        wrapper.addEventListener('focusout', () => {
+          dismissed = false;
+          scheduleClose();
+        });
+
+        const dismiss = () => {
+          dismissed = true;
+          if (panel.contains(document.activeElement)) trigger.focus();
+          close();
+        };
+
+        closeButton.addEventListener('click', dismiss);
+        wrapper.addEventListener('keydown', (event) => {
+          if (event.key === 'Escape' && !panel.hidden) {
+            event.preventDefault();
+            dismiss();
+          }
+        });
+      });
+
+      // Escape also dismisses a preview opened with the pointer alone.
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') activePreview?.close();
+      });
+      document.addEventListener('pointerdown', (event) => {
+        if (activePreview && !activePreview.panel.parentElement.contains(event.target)) {
+          activePreview.close();
+        }
+      });
+      window.addEventListener('resize', () => activePreview?.position());
+      window.addEventListener('scroll', () => activePreview?.position(), true);
+    })();
+  </script>
