+  <script type="module">
+    // Load only the missing platform features; navigation never depends on JS.
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@0.7.3/dist/popover.min.js");
+    }
+
+    const previews = [...document.querySelectorAll('.drink-preview')];
+    const isOpen = preview => preview.matches(':is(:popover-open)') || preview.classList.contains(':popover-open');
+
+    // Keep previews beside their links when CSS anchor positioning is unavailable.
+    if (!CSS.supports('position-area', 'block-end span-inline-end')) {
+      const positionPreview = preview => {
+        if (!isOpen(preview)) return;
+        const trigger = document.querySelector(`[interestfor="${preview.id}"]`);
+        const rect = trigger.getBoundingClientRect();
+        const width = preview.offsetWidth;
+        const height = preview.offsetHeight;
+        const gutter = 12;
+        const gap = 8;
+        const below = rect.bottom + gap;
+        const top = below + height <= window.innerHeight - gutter
+          ? below : rect.top - height - gap;
+        preview.style.setProperty('--preview-left', `${Math.max(gutter, Math.min(rect.left, window.innerWidth - width - gutter))}px`);
+        preview.style.setProperty('--preview-top', `${Math.max(gutter, Math.min(top, window.innerHeight - height - gutter))}px`);
+      };
+
+      previews.forEach(preview => {
+        preview.addEventListener('beforetoggle', event => {
+          if (event.newState === 'open') requestAnimationFrame(() => positionPreview(preview));
+        });
+        new ResizeObserver(() => positionPreview(preview)).observe(preview);
+      });
+      window.addEventListener('resize', () => previews.forEach(positionPreview));
+      document.addEventListener('scroll', () => previews.forEach(positionPreview), { capture: true, passive: true });
+    }
+
+    if (!Object.hasOwn(HTMLButtonElement.prototype, 'interestForElement')) {
+      await import("https://unpkg.com/interestfor@1.0.12/src/interestfor.min.js");
+    }
+  </script>
