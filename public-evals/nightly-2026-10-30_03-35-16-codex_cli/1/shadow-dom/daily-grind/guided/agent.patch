+const template = document.createElement('template');
+
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      color: var(--text, #3e2723);
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+    }
+
+    *, ::slotted(*) {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    article {
+      height: 100%;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    h3 {
+      margin-bottom: 10px;
+      color: var(--primary, #4e342e);
+    }
+
+    .badge {
+      display: inline-block;
+      margin-bottom: 10px;
+      padding: 2px 10px;
+      border-radius: 999px;
+      background: var(--accent, #ffab40);
+      color: #3e2723;
+      font-size: 0.75rem;
+      font-weight: bold;
+    }
+
+    .badge[hidden] {
+      display: none;
+    }
+
+    ::slotted([slot="action"]) {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    ::slotted([slot="action"]:hover) {
+      background: #3e2723;
+    }
+  </style>
+  <article>
+    <div class="badge" hidden><slot name="badge"></slot></div>
+    <h3><slot name="title"></slot></h3>
+    <p><slot name="description"></slot></p>
+    <slot name="action"></slot>
+  </article>
+`;
+
+// Supply title, description, and a native action link through named slots.
+// Add or remove an element with slot="badge" at any time to toggle the badge.
+class DrinkCard extends HTMLElement {
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(template.content.cloneNode(true));
+
+    const badge = root.querySelector('.badge');
+    const badgeSlot = root.querySelector('slot[name="badge"]');
+    badgeSlot.addEventListener('slotchange', () => {
+      badge.hidden = badgeSlot.assignedElements().length === 0;
+    });
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
