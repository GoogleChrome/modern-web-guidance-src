+  <script type="module">
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const hostWarning = document.getElementById('hostWarning');
+    const grid = document.getElementById('grid');
+    const plannerFields = document.getElementById('plannerFields');
+    const locations = [
+      { name: 'New York', zone: 'America/New_York' },
+      { name: 'London', zone: 'Europe/London' },
+      { name: 'Tokyo', zone: 'Asia/Tokyo' },
+      { name: 'UTC', zone: 'UTC' },
+    ];
+
+    function showWarning(message = '') {
+      hostWarning.textContent = message;
+      hostWarning.hidden = !message;
+    }
+
+    try {
+      // Prefer native Temporal. Only browsers without it load the compatibility module.
+      const Temporal = globalThis.Temporal ??
+        (await import('https://esm.sh/temporal-polyfill@0.3.0')).Temporal;
+      const timeFormat = { hour: 'numeric', minute: '2-digit', hour12: true };
+      const dateFormat = { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' };
+
+      function updatePlanner() {
+        grid.replaceChildren();
+        if (!dateInput.value || !timeInput.value || !dateInput.validity.valid || !timeInput.validity.valid) {
+          showWarning('Choose a valid tasting date and host local time to see the local times.');
+          return;
+        }
+
+        try {
+          const input = `${dateInput.value}T${timeInput.value}[${hostTzSelect.value}]`;
+          let hostTime;
+          let warning = '';
+          try {
+            hostTime = Temporal.ZonedDateTime.from(input, { disambiguation: 'reject' });
+          } catch (error) {
+            if (!(error instanceof RangeError)) throw error;
+            // These methods return new objects; no existing Temporal value is mutated.
+            hostTime = Temporal.ZonedDateTime.from(input, { disambiguation: 'compatible' });
+            const earlier = Temporal.ZonedDateTime.from(input, { disambiguation: 'earlier' });
+            const later = Temporal.ZonedDateTime.from(input, { disambiguation: 'later' });
+            const resolved = `${hostTime.toLocaleString('en-US', dateFormat)} at ${hostTime.toLocaleString('en-US', timeFormat)} (UTC${hostTime.offset})`;
+            if (earlier.toPlainDateTime().equals(later.toPlainDateTime())) {
+              warning = `Daylight saving overlap: ${timeInput.value} on ${dateInput.value} occurs twice in ${hostTzSelect.value}. Using the first occurrence: ${resolved}. The second occurrence has offset UTC${later.offset}. All cards use the first occurrence.`;
+            } else {
+              warning = `Daylight saving gap: ${timeInput.value} on ${dateInput.value} does not exist in ${hostTzSelect.value} because the clocks move forward. The tasting has been shifted forward by the clock change to ${resolved}. All cards use this resolved time.`;
+            }
+          }
+
+          const cards = locations.map(({ name, zone }) => {
+            // withTimeZone preserves the instant and leaves hostTime unchanged.
+            const local = hostTime.withTimeZone(zone);
+            const card = document.createElement('article');
+            card.className = 'tasting-time';
+            const heading = document.createElement('h3');
+            heading.textContent = name;
+            const time = document.createElement('time');
+            time.className = 'local-time';
+            time.dateTime = local.toString({ timeZoneName: 'never', calendarName: 'never' });
+            time.textContent = local.toLocaleString('en-US', timeFormat);
+            const date = document.createElement('p');
+            date.className = 'local-date';
+            date.textContent = local.toLocaleString('en-US', dateFormat);
+            const offset = document.createElement('p');
+            offset.className = 'zone-offset';
+            offset.textContent = `UTC${local.offset}`;
+            card.append(heading, time, date, offset);
+            return card;
+          });
+          grid.replaceChildren(...cards);
+          showWarning(warning);
+        } catch {
+          grid.replaceChildren();
+          showWarning('This date or time could not be scheduled. Please choose a valid date, time, and host timezone.');
+        }
+      }
+
+      dateInput.value = Temporal.Now.plainDateISO(hostTzSelect.value).toString();
+      plannerFields.disabled = false;
+      for (const input of [dateInput, timeInput, hostTzSelect]) {
+        input.addEventListener('input', updatePlanner);
+        input.addEventListener('change', updatePlanner);
+      }
+      updatePlanner();
+    } catch {
+      showWarning('The timezone planner could not load. Please check your connection and reload, or try a browser with native Temporal support.');
+    }
+  </script>
+
 </body>
 
