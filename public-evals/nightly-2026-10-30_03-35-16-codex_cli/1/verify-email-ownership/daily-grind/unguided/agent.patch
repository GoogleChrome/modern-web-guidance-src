diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..1612a1c
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,35 @@
+import { createServer } from 'node:http';
+import { mkdir } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { Readable } from 'node:stream';
+import { createStore } from './lib/store.mjs';
+import { createApplication } from './lib/application.mjs';
+
+const port = Number(process.env.PORT || 11222);
+if (process.env.NODE_ENV === 'production' && !process.env.APP_ORIGIN) throw new Error('APP_ORIGIN is required in production');
+const origin = process.env.APP_ORIGIN || `http://localhost:${port}`;
+const originURL = new URL(origin);
+if (originURL.origin !== origin || (originURL.protocol !== 'https:' && !['localhost', '127.0.0.1'].includes(originURL.hostname))) throw new Error('APP_ORIGIN must be an HTTPS origin (HTTP is allowed on localhost)');
+const databasePath = resolve(process.env.DATABASE_PATH || './data/rewards.sqlite');
+await mkdir(dirname(databasePath), { recursive: true });
+const store = createStore(databasePath);
+const handle = await createApplication({ store, origin, originTrialToken: process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL_TOKEN });
+const server = createServer(async (req, res) => {
+  try {
+    const request = new Request(new URL(req.url, origin), {
+      method: req.method, headers: req.headers,
+      ...(!['GET', 'HEAD'].includes(req.method) ? { body: Readable.toWeb(req), duplex: 'half' } : {}),
+    });
+    // Use the real peer address; untrusted forwarding headers cannot bypass limits.
+    const response = await handle(request, { clientIP: req.socket.remoteAddress });
+    res.writeHead(response.status, Object.fromEntries(response.headers));
+    res.end(Buffer.from(await response.arrayBuffer()));
+  } catch {
+    if (!res.headersSent) res.writeHead(500, { 'Content-Type': 'text/plain', 'Cache-Control': 'no-store' });
+    res.end('Something went wrong. Please try again.');
+  }
+});
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(port, '0.0.0.0', () => console.log(`Daily Grind listening on port ${port}`));
+for (const signal of ['SIGINT', 'SIGTERM']) process.on(signal, () => server.close(() => { store.close(); process.exit(0); }));
