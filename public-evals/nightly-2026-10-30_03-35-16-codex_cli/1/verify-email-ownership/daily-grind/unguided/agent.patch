diff --git a/test-support/proofs.mjs b/test-support/proofs.mjs
new file mode 100644
index 0000000..8ee3034
--- /dev/null
+++ b/test-support/proofs.mjs
@@ -0,0 +1,20 @@
+import { generateKeyPairSync, sign, createHash } from 'node:crypto';
+
+export const origin = 'https://daily-grind.example';
+export const issuer = 'https://issuer.example';
+const issuerKey = generateKeyPairSync('ed25519');
+const holder = generateKeyPairSync('ed25519');
+export const publicIssuer = { ...issuerKey.publicKey.export({ format: 'jwk' }), kid: 'issuer-1', alg: 'Ed25519' };
+const holderJWK = { ...holder.publicKey.export({ format: 'jwk' }), alg: 'Ed25519' };
+const encode = value => Buffer.from(JSON.stringify(value)).toString('base64url');
+function jwt(payload, header, privateKey) {
+  const data = `${encode(header)}.${encode(payload)}`;
+  return data + '.' + sign(null, Buffer.from(data), privateKey).toString('base64url');
+}
+export function makeProof({ nonce = 'a'.repeat(43), email = 'jamie@example.com', evtChanges = {}, kbChanges = {}, holderKey = holder.privateKey } = {}) {
+  const iat = Math.floor(Date.now() / 1000);
+  const evt = jwt({ iss: issuer, iat, email, email_verified: true, cnf: { jwk: holderJWK }, ...evtChanges }, { alg: 'Ed25519', typ: 'evt+jwt', kid: 'issuer-1' }, issuerKey.privateKey);
+  const kb = jwt({ aud: origin, nonce, iat, sd_hash: createHash('sha256').update(evt + '~').digest('base64url'), ...kbChanges }, { alg: 'Ed25519', typ: 'kb+jwt' }, holderKey);
+  return evt + '~' + kb;
+}
+export const discover = async () => ({ issuer, keys: [publicIssuer], signingAlgorithms: ['Ed25519'] });
diff --git a/test/application.test.mjs b/test/application.test.mjs
new file mode 100644
index 0000000..9085c0c
--- /dev/null
+++ b/test/application.test.mjs
@@ -0,0 +1,86 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createStore } from '../lib/store.mjs';
+import { createApplication } from '../lib/application.mjs';
+import { verifyEmailOwnership } from '../lib/email-verification.mjs';
+import { origin, makeProof, discover } from '../test-support/proofs.mjs';
+
+async function fixture(t) {
+  const store = createStore(':memory:');
+  t.after(() => store.close());
+  let created = 0;
+  const handle = await createApplication({ store: { ...store, createAccount: data => { created++; return store.createAccount(data); } }, origin, originTrialToken: 'trial-token', verify: args => verifyEmailOwnership({ ...args, discover }) });
+  async function open(cookie = '') {
+    const response = await handle(new Request(origin, { headers: { cookie } }));
+    const html = await response.text();
+    return { response, html, cookie: response.headers.get('set-cookie').split(';')[0], nonce: /name="nonce" value="([^"]+)"/.exec(html)[1] };
+  }
+  async function submit(page, values = {}, { json = true, requestOrigin = origin } = {}) {
+    return handle(new Request(origin + '/api/rewards/signup', { method: 'POST', headers: { Cookie: page.cookie, Origin: requestOrigin, Accept: json ? 'application/json' : 'text/html', 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ firstName: 'Jamie', lastName: 'Morgan', email: 'jamie@example.com', terms: 'yes', nonce: page.nonce, evt: makeProof({ nonce: page.nonce }), ...values }) }));
+  }
+  return { handle, open, submit, created: () => created };
+}
+test('serves unique session-bound forms with an origin trial header', async t => {
+  const f = await fixture(t);
+  const a = await f.open(); const b = await f.open();
+  assert.notEqual(a.nonce, b.nonce);
+  assert.match(a.html, /autocomplete="email-verification-token" nonce="[A-Za-z0-9_-]{43}"/);
+  assert.equal(a.response.headers.get('origin-trial'), 'trial-token');
+  assert.equal(a.response.headers.get('cache-control'), 'no-store');
+  assert.match(a.response.headers.get('set-cookie'), /HttpOnly; SameSite=Lax; Max-Age=600; Secure/);
+  assert.doesNotMatch(a.html, /__FORM_NONCE__|__EMAIL__/);
+});
+test('creates an account only after verification and prevents replay', async t => {
+  const f = await fixture(t); const page = await f.open();
+  const response = await f.submit(page);
+  assert.equal(response.status, 201);
+  assert.equal((await response.json()).ok, true);
+  const replay = await f.submit(page);
+  assert.equal((await replay.json()).code, 'expired');
+  assert.equal(f.created(), 1);
+  const duplicate = await f.submit(await f.open());
+  assert.equal(duplicate.status, 409);
+  assert.equal((await duplicate.json()).code, 'duplicate');
+});
+test('fails closed without a token, with invalid proof, or without consent', async t => {
+  const f = await fixture(t);
+  for (const [values, expected] of [[{ evt: '' }, 'unsupported'], [{ evt: 'invalid' }, 'invalid'], [{ terms: '' }, 'fields'], [{ email: 'invalid' }, 'fields']]) {
+    const response = await f.submit(await f.open(), values);
+    assert.equal((await response.json()).code, expected);
+  }
+  assert.equal(f.created(), 0);
+});
+test('rejects a challenge from another browser session and cross-origin requests', async t => {
+  const f = await fixture(t); const a = await f.open(); const b = await f.open();
+  assert.equal((await (await f.submit(b, { nonce: a.nonce })).json()).code, 'expired');
+  assert.equal((await f.submit(a, {}, { requestOrigin: 'https://attacker.example' })).status, 403);
+  assert.equal(f.created(), 0);
+});
+test('native submit redirects to server-confirmed success, even without JavaScript', async t => {
+  const f = await fixture(t); const page = await f.open();
+  const response = await f.submit(page, {}, { json: false });
+  assert.equal(response.status, 303);
+  assert.equal(response.headers.get('location'), '/#rewards');
+  const next = await f.open(response.headers.get('set-cookie').split(';')[0]);
+  assert.match(next.html, /Welcome to the grind, Jamie/);
+  assert.match(next.html, /id="rewards-form" hidden/);
+  assert.doesNotMatch(next.html, /class="success-details" hidden/);
+  const forged = await f.handle(new Request(origin + '/?rewards=joined'));
+  assert.doesNotMatch(await forged.text(), /data-state="success"/);
+});
+test('returns escaped error details and a new nonce for retry', async t => {
+  const f = await fixture(t); const page = await f.open();
+  const response = await f.submit(page, { evt: '', firstName: '<script>alert(1)</script>' }, { json: false });
+  const next = await f.open(response.headers.get('set-cookie').split(';')[0]);
+  assert.match(next.html, /&lt;script&gt;/);
+  assert.doesNotMatch(next.html, /<script>alert/);
+  assert.notEqual(next.nonce, page.nonce);
+  assert.match(next.html, /data-state="error"/);
+});
+test('rate limits repeated sign-up attempts', async t => {
+  const f = await fixture(t); let response;
+  for (let i = 0; i < 21; i++) response = await f.submit(await f.open(), { evt: '' });
+  assert.equal(response.status, 429);
+  assert.equal(response.headers.get('retry-after'), '600');
+  assert.equal(f.created(), 0);
+});
diff --git a/test/verification.test.mjs b/test/verification.test.mjs
new file mode 100644
index 0000000..f01c9c3
--- /dev/null
+++ b/test/verification.test.mjs
@@ -0,0 +1,71 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { generateKeyPairSync, sign, createHash } from 'node:crypto';
+import { verifyEmailOwnership } from '../lib/email-verification.mjs';
+import { discoverIssuer, safeURL, isPublicIPv4 } from '../lib/issuer-discovery.mjs';
+
+import { origin, issuer, publicIssuer, makeProof, discover } from '../test-support/proofs.mjs';
+const verify = (token, overrides = {}) => verifyEmailOwnership({ token, email: 'jamie@example.com', nonce: 'a'.repeat(43), origin, discover, ...overrides });
+
+test('accepts real issuer and holder signatures', async () => {
+  assert.deepEqual(await verify(makeProof()), { email: 'jamie@example.com', issuer });
+});
+for (const [name, options] of [
+  ['wrong email', { evtChanges: { email: 'someone@example.com' } }],
+  ['unverified email', { evtChanges: { email_verified: false } }],
+  ['string verification flag', { evtChanges: { email_verified: 'true' } }],
+  ['wrong audience', { kbChanges: { aud: 'https://attacker.example' } }],
+  ['wrong nonce', { kbChanges: { nonce: 'b'.repeat(43) } }],
+  ['expired EVT', { evtChanges: { exp: 1 } }],
+  ['stale EVT', { evtChanges: { iat: 1 } }],
+  ['future binding', { kbChanges: { iat: Math.floor(Date.now() / 1000) + 1000 } }],
+  ['wrong hash', { kbChanges: { sd_hash: 'bad' } }],
+  ['unauthorized issuer', { evtChanges: { iss: 'https://attacker.example' } }],
+  ['wrong holder signature', { holderKey: generateKeyPairSync('ed25519').privateKey }],
+]) {
+  test('rejects ' + name, async () => { await assert.rejects(verify(makeProof(options))); });
+}
+test('rejects unsigned tokens and malformed presentations', async () => {
+  for (const token of ['', 'bad', makeProof() + '~', 'e30.e30.AA~e30.e30.AA']) await assert.rejects(verify(token));
+});
+test('rejects an issuer key substitution', async () => {
+  const other = generateKeyPairSync('ed25519').publicKey.export({ format: 'jwk' });
+  await assert.rejects(verify(makeProof(), { discover: async () => ({ issuer, keys: [{ ...other, kid: 'issuer-1' }] }) }));
+});
+test('discovers only the email domain’s DNS delegated issuer and anchors metadata', async () => {
+  const calls = [];
+  const result = await discoverIssuer('example.com', {
+    resolveTxt: async name => { assert.equal(name, '_email-verification.example.com'); return [['iss=issuer.', 'example']]; },
+    fetchJSON: async url => {
+      calls.push(url);
+      return calls.length === 1 ? { issuer, jwks_uri: issuer + '/keys' } : { keys: [publicIssuer] };
+    },
+  });
+  assert.equal(result.issuer, issuer);
+  assert.deepEqual(calls, [issuer + '/.well-known/email-verification', issuer + '/keys']);
+  await assert.rejects(discoverIssuer('example.com', { resolveTxt: async () => [['iss=issuer.example']], fetchJSON: async () => ({ issuer: 'https://attacker.example' }) }));
+  await assert.rejects(discoverIssuer('example.com', { resolveTxt: async () => [['iss=issuer.example'], ['iss=other.example']] }));
+});
+test('rejects unsafe issuer destinations and private IPs', () => {
+  for (const url of ['http://issuer.example/keys', 'https://127.0.0.1/keys', 'https://localhost/keys', 'https://issuer.example:8443/keys', 'https://user:pass@issuer.example/keys']) assert.throws(() => safeURL(url));
+  for (const ip of ['127.0.0.1', '10.0.0.1', '172.16.0.1', '192.168.1.1', '169.254.169.254', '100.64.0.1', '0.0.0.0', '198.18.0.1', '::1']) assert.equal(isPublicIPv4(ip), false, ip);
+  assert.equal(isPublicIPv4('8.8.8.8'), true);
+});
+
+test('verifies the supported EC, RSA, and trial EdDSA algorithms', async () => {
+  for (const alg of ['ES256', 'RS256', 'EdDSA']) {
+    const parameters = alg === 'ES256' ? ['ec', { namedCurve: 'P-256' }]
+      : alg === 'RS256' ? ['rsa', { modulusLength: 2048 }] : ['ed25519'];
+    const pair = generateKeyPairSync(...parameters);
+    const jwk = { ...pair.publicKey.export({ format: 'jwk' }), alg, kid: 'key' };
+    function signed(payload, typ) {
+      const data = [Buffer.from(JSON.stringify({ alg, kid: 'key', typ })).toString('base64url'), Buffer.from(JSON.stringify(payload)).toString('base64url')].join('.');
+      return data + '.' + sign(alg === 'EdDSA' ? null : 'sha256', Buffer.from(data), { key: pair.privateKey, dsaEncoding: 'ieee-p1363' }).toString('base64url');
+    }
+    const iat = Math.floor(Date.now() / 1000);
+    const evt = signed({ iss: issuer, iat, email: 'jamie@example.com', email_verified: true, cnf: { jwk } }, 'evt+jwt');
+    const kb = signed({ aud: origin, iat, nonce: 'a'.repeat(43), sd_hash: createHash('sha256').update(evt + '~').digest('base64url') }, 'kb+jwt');
+    const result = await verify(evt + '~' + kb, { discover: async () => ({ issuer, keys: [jwk] }) });
+    assert.equal(result.email, 'jamie@example.com');
+  }
+});
