+import { readFile } from 'node:fs/promises';
+import { verifyEmailOwnership, validEmail } from './email-verification.mjs';
+
+const escapeHTML = value => String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+const sessionCookie = request => /(?:^|;\s*)dg_signup=([A-Za-z0-9_-]{43})(?:;|$)/.exec(request.headers.get('cookie') || '')?.[1] || '';
+const statuses = {
+  unsupported: 'Your browser or email provider didn’t provide an ownership proof. No account was created and no email was sent. Use a supported browser, sign in to your email provider in the same browser, and try again.',
+  invalid: 'We couldn’t verify your email. No account was created. Please check your email address and try again.',
+  expired: 'This sign-up session has expired or was already used. Please try again with the refreshed form.',
+  fields: 'Please enter your first and last name, a valid email address, and accept the Rewards Terms.',
+  duplicate: 'An account already exists for this verified email address. Your existing account hasn’t been changed.',
+  limited: 'Too many attempts. Please wait ten minutes before trying again.',
+};
+async function readForm(request) {
+  if (request.headers.get('content-type')?.split(';')[0] !== 'application/x-www-form-urlencoded') throw new Error('Unsupported form encoding');
+  const reader = request.body?.getReader();
+  if (!reader) throw new Error('Missing form body');
+  let size = 0;
+  const chunks = [];
+  while (true) {
+    const { value, done } = await reader.read();
+    if (done) break;
+    size += value.length;
+    if (size > 20000) { await reader.cancel(); throw new Error('Form too large'); }
+    chunks.push(Buffer.from(value));
+  }
+  const form = new URLSearchParams(Buffer.concat(chunks).toString('utf8'));
+  for (const key of form.keys()) if (form.getAll(key).length !== 1) throw new Error('Duplicate field');
+  return form;
+}
+export async function createApplication({ store, origin, originTrialToken = '', verify = verifyEmailOwnership }) {
+  const assets = new Map(await Promise.all(['index.html', 'styles.css', 'app.js'].map(async name => [name, await readFile(new URL('../' + name, import.meta.url), 'utf8')])));
+  const secure = new URL(origin).protocol === 'https:';
+  const headers = {
+    'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'strict-origin-when-cross-origin', 'X-Frame-Options': 'DENY',
+    'Content-Security-Policy': "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https://images.unsplash.com; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
+    ...(originTrialToken ? { 'Origin-Trial': originTrialToken } : {}),
+  };
+  const cookie = session => `dg_signup=${session}; Path=/; HttpOnly; SameSite=Lax; Max-Age=600${secure ? '; Secure' : ''}`;
+  function page(flash) {
+    const challenge = store.createChallenge();
+    const replacements = {
+      FORM_NONCE: challenge.nonce, RESULT_STATE: flash?.state || '', RESULT_MESSAGE: flash?.message || '',
+      FIRST_NAME: flash?.firstName || '', LAST_NAME: flash?.lastName || '', EMAIL: flash?.email || '',
+    };
+    let html = assets.get('index.html').replace(/__(FORM_NONCE|RESULT_STATE|RESULT_MESSAGE|FIRST_NAME|LAST_NAME|EMAIL)__/g, (_, key) => escapeHTML(replacements[key]));
+    // Success also works without client JavaScript.
+    if (flash?.state === 'success') html = html.replace('id="rewards-form"', 'id="rewards-form" hidden').replace('class="success-details" hidden', 'class="success-details"');
+    return new Response(html, { headers: { ...headers, 'Content-Type': 'text/html; charset=utf-8', 'Set-Cookie': cookie(challenge.session) } });
+  }
+  return async function handle(request, { clientIP = 'unknown' } = {}) {
+    const url = new URL(request.url);
+    const session = sessionCookie(request);
+    if (request.method === 'GET' && url.pathname === '/') {
+      if (!store.allow('page:' + clientIP, 100)) return new Response(statuses.limited, { status: 429, headers });
+      return page(store.takeFlash(session));
+    }
+    if (request.method === 'GET' && (url.pathname === '/styles.css' || url.pathname === '/app.js')) {
+      return new Response(assets.get(url.pathname.slice(1)), { headers: { ...headers, 'Content-Type': url.pathname.endsWith('.css') ? 'text/css' : 'text/javascript' } });
+    }
+    if (request.method === 'GET' && ['/rewards-terms', '/privacy-policy'].includes(url.pathname)) {
+      const privacy = url.pathname === '/privacy-policy';
+      const title = privacy ? 'Your privacy' : 'Grind Rewards terms';
+      const text = privacy
+        ? 'We store your name, verified email address, email verification issuer, registration date, acceptance of the terms, and optional marketing preference to manage your rewards account. Your email provider confirms ownership through a signed proof; we do not receive your email password or access your inbox, and we do not store the proof. A short-lived, essential sign-up cookie protects registration. Marketing is optional. Contact us to request access, correction, or deletion of your information. Fonts are loaded from Google Fonts and photographs from Unsplash, which receive your network request when those assets load.'
+        : 'Grind Rewards is free to join. You must own the email address you register with and provide accurate details. Registration requires browser-assisted email verification. Availability depends on your browser and email provider. Joining creates a rewards membership; it does not make a purchase or subscribe you to marketing unless you opt in. Any future offers will state their own eligibility and redemption conditions. No cash value, points balance, or specific offer is promised by registration.';
+      return new Response(`<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${title} | The Daily Grind</title><link rel="stylesheet" href="/styles.css"></head><body><main class="favorites-section"><a href="/#rewards">← Back to Grind Rewards</a><h1>${title}</h1><p>Effective October 30, 2026</p><p>${text}</p><a href="/contact">Contact us</a></main></body></html>`, { headers: { ...headers, 'Content-Type': 'text/html; charset=utf-8' } });
+    }
+    if (url.pathname === '/api/rewards/signup') {
+      if (request.method !== 'POST') return new Response('Method not allowed', { status: 405, headers: { ...headers, Allow: 'POST' } });
+      if (request.headers.get('origin') !== origin || request.headers.get('sec-fetch-site') === 'cross-site') return new Response('Registration requires a same-origin form.', { status: 403, headers });
+      if (!store.allow('signup:' + clientIP)) return new Response(statuses.limited, { status: 429, headers: { ...headers, 'Retry-After': '600' } });
+      let form;
+      try { form = await readForm(request); }
+      catch { return new Response('Invalid registration request.', { status: 400, headers }); }
+      const firstName = (form.get('firstName') || '').trim();
+      const lastName = (form.get('lastName') || '').trim();
+      // Keep the address byte-for-byte for comparison with the signed claim.
+      const email = form.get('email') || '';
+      function finish(code, status = 400) {
+        const success = code === 'success';
+        const flash = { state: success ? 'success' : 'error', message: success ? `Welcome to the grind, ${firstName}.` : statuses[code], firstName: firstName.slice(0, 80), lastName: lastName.slice(0, 80), email: email.slice(0, 254) };
+        if (request.headers.get('accept')?.includes('application/json')) return Response.json({ ok: success, code, message: flash.message }, { status: success ? 201 : status, headers });
+        // Only a server-generated cookie-backed flash can display account success.
+        const next = store.createChallenge(flash);
+        return new Response(null, { status: 303, headers: { ...headers, Location: '/#rewards', 'Set-Cookie': cookie(next.session) } });
+      }
+      if (!store.consumeChallenge(session, form.get('nonce') || '')) return finish('expired');
+      if (!firstName || !lastName || firstName.length > 80 || lastName.length > 80 || /[\x00-\x1f]/.test(firstName + lastName) || !validEmail(email) || form.get('terms') !== 'yes') return finish('fields');
+      if (!form.get('evt')) return finish('unsupported', 422);
+      let proof;
+      try { proof = await verify({ token: form.get('evt'), email, nonce: form.get('nonce'), origin }); }
+      catch { return finish('invalid', 422); }
+      try {
+        const created = store.createAccount({ email: proof.email, firstName, lastName, issuer: proof.issuer, marketing: form.get('marketing') === 'yes' });
+        return created ? finish('success') : finish('duplicate', 409);
+      } catch {
+        return new Response('Registration is temporarily unavailable. Please reload the homepage and try again.', { status: 503, headers });
+      }
+    }
+    return new Response('Page not found.', { status: 404, headers });
+  };
+}
diff --git a/lib/email-verification.mjs b/lib/email-verification.mjs
new file mode 100644
index 0000000..a2217fb
--- /dev/null
+++ b/lib/email-verification.mjs
@@ -0,0 +1,65 @@
+import { createHash, createPublicKey, verify as verifySignature } from 'node:crypto';
+import { discoverIssuer } from './issuer-discovery.mjs';
+
+const algorithms = {
+  ES256: { hash: 'sha256', kty: 'EC', crv: 'P-256' },
+  RS256: { hash: 'RSA-SHA256', kty: 'RSA' },
+  Ed25519: { hash: null, kty: 'OKP', crv: 'Ed25519' },
+  // The current Chrome trial also issues the older EdDSA identifier.
+  EdDSA: { hash: null, kty: 'OKP', crv: 'Ed25519' },
+};
+export function validEmail(email) {
+  return typeof email === 'string' && email.length <= 254 && /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$/.test(email);
+}
+function requireTrue(condition) {
+  if (!condition) throw new Error('Invalid email ownership proof');
+}
+function parseJWT(token, type) {
+  const parts = token.split('.');
+  requireTrue(parts.length === 3 && parts.every(p => /^[A-Za-z0-9_-]+$/.test(p)));
+  const header = JSON.parse(Buffer.from(parts[0], 'base64url').toString('utf8'));
+  const payload = JSON.parse(Buffer.from(parts[1], 'base64url').toString('utf8'));
+  requireTrue(header && payload && header.typ === type && Object.hasOwn(algorithms, header.alg));
+  requireTrue(header.crit === undefined && header.b64 === undefined);
+  return { header, payload, signature: Buffer.from(parts[2], 'base64url'), data: Buffer.from(parts.slice(0, 2).join('.')) };
+}
+function verifyJWT(jwt, jwk) {
+  const algorithm = algorithms[jwt.header.alg];
+  requireTrue(jwk && jwk.kty === algorithm.kty && (!algorithm.crv || jwk.crv === algorithm.crv));
+  requireTrue(!jwk.d && (!jwk.alg || jwk.alg === jwt.header.alg) && (!jwk.use || jwk.use === 'sig'));
+  requireTrue(!jwk.key_ops || (Array.isArray(jwk.key_ops) && jwk.key_ops.includes('verify')));
+  const key = createPublicKey({ key: jwk, format: 'jwk' });
+  requireTrue(jwk.kty !== 'RSA' || key.asymmetricKeyDetails.modulusLength >= 2048);
+  requireTrue(verifySignature(algorithm.hash, jwt.data, { key, dsaEncoding: 'ieee-p1363' }, jwt.signature));
+}
+function checkTime(claims, now) {
+  requireTrue(Number.isFinite(claims.iat) && claims.iat <= now + 30 && claims.iat >= now - 300);
+  if (claims.exp !== undefined) requireTrue(Number.isFinite(claims.exp) && claims.exp > now && claims.exp > claims.iat);
+  if (claims.nbf !== undefined) requireTrue(Number.isFinite(claims.nbf) && claims.nbf <= now + 30);
+}
+
+export async function verifyEmailOwnership({ token, email, nonce, origin, now = Math.floor(Date.now() / 1000), discover = discoverIssuer }) {
+  requireTrue(validEmail(email) && typeof nonce === 'string' && nonce.length >= 22);
+  requireTrue(typeof token === 'string' && token.length <= 16384);
+  const parts = token.split('~');
+  requireTrue(parts.length === 2 && parts.every(Boolean));
+  const evt = parseJWT(parts[0], 'evt+jwt');
+  const kb = parseJWT(parts[1], 'kb+jwt');
+  const claims = evt.payload;
+  requireTrue(claims.email === email && claims.email_verified === true);
+  requireTrue(typeof claims.iss === 'string' && typeof evt.header.kid === 'string' && evt.header.kid.length > 0);
+  requireTrue(kb.payload.aud === origin && kb.payload.nonce === nonce);
+  checkTime(claims, now);
+  checkTime(kb.payload, now);
+  requireTrue(kb.payload.sd_hash === createHash('sha256').update(parts[0] + '~').digest('base64url'));
+  requireTrue(claims.cnf?.jwk && (!claims.cnf.jwk.alg || kb.header.alg === claims.cnf.jwk.alg));
+  verifyJWT(kb, claims.cnf.jwk);
+  // Trust comes from DNS for the submitted email, never from an untrusted JWT URL.
+  const { issuer, keys, signingAlgorithms } = await discover(email.split('@')[1]);
+  requireTrue(claims.iss === issuer);
+  if (signingAlgorithms) requireTrue(signingAlgorithms.includes(evt.header.alg));
+  const matchingKeys = keys.filter(key => key.kid === evt.header.kid && (!key.alg || key.alg === evt.header.alg));
+  requireTrue(matchingKeys.length === 1);
+  verifyJWT(evt, matchingKeys[0]);
+  return { email: claims.email, issuer };
+}
diff --git a/lib/issuer-discovery.mjs b/lib/issuer-discovery.mjs
new file mode 100644
index 0000000..cbf6a75
--- /dev/null
+++ b/lib/issuer-discovery.mjs
@@ -0,0 +1,73 @@
+import { Resolver } from 'node:dns/promises';
+import { request } from 'node:https';
+
+const resolver = new Resolver({ timeout: 3000, tries: 1 });
+const hostnamePattern = /^(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,63}$/;
+export function isPublicIPv4(address) {
+  const parts = address.split('.').map(Number);
+  if (parts.length !== 4 || parts.some(n => !Number.isInteger(n) || n < 0 || n > 255)) return false;
+  const [a, b] = parts;
+  return !(a === 0 || a === 10 || a === 127 || a >= 224 ||
+    (a === 100 && b >= 64 && b <= 127) || (a === 169 && b === 254) ||
+    (a === 172 && b >= 16 && b <= 31) || (a === 192 && (b === 0 || b === 168)) ||
+    (a === 192 && b === 88 && parts[2] === 99) ||
+    (a === 198 && (b === 18 || b === 19 || (b === 51 && parts[2] === 100))) ||
+    (a === 203 && b === 0 && parts[2] === 113));
+}
+export function safeURL(value) {
+  const url = new URL(value);
+  if (url.protocol !== 'https:' || url.port || url.username || url.password || url.hash || !hostnamePattern.test(url.hostname)) {
+    throw new Error('Unsafe issuer URL');
+  }
+  return url;
+}
+export async function fetchPublicJSON(value) {
+  const url = safeURL(value);
+  // Resolve once, reject private networks, then pin the checked address to prevent rebinding.
+  const addresses = await resolver.resolve4(url.hostname);
+  if (!addresses.length || addresses.some(address => !isPublicIPv4(address))) throw new Error('Unsafe issuer address');
+  const address = addresses[0];
+  return new Promise((resolve, reject) => {
+    const req = request(url, {
+      method: 'GET', headers: { Accept: 'application/json' },
+      lookup: (_host, options, callback) => options.all
+        ? callback(null, [{ address, family: 4 }]) : callback(null, address, 4),
+    }, response => {
+      // Never follow redirects to arbitrary destinations.
+      if (response.statusCode !== 200 || !response.headers['content-type']?.toLowerCase().includes('application/json')) {
+        response.resume(); reject(new Error('Issuer metadata unavailable')); return;
+      }
+      let size = 0;
+      const chunks = [];
+      response.on('data', chunk => {
+        size += chunk.length;
+        if (size > 65536) response.destroy(new Error('Issuer response too large'));
+        else chunks.push(chunk);
+      });
+      response.on('end', () => {
+        try { resolve(JSON.parse(Buffer.concat(chunks).toString('utf8'))); }
+        catch (error) { reject(error); }
+      });
+      response.on('error', reject);
+    });
+    const timer = setTimeout(() => req.destroy(new Error('Issuer request timed out')), 5000);
+    req.on('close', () => clearTimeout(timer));
+    req.on('error', reject);
+    req.end();
+  });
+}
+export async function discoverIssuer(domain, { resolveTxt = name => resolver.resolveTxt(name), fetchJSON = fetchPublicJSON } = {}) {
+  if (!hostnamePattern.test(domain)) throw new Error('Invalid email domain');
+  const records = await resolveTxt('_email-verification.' + domain);
+  if (records.length !== 1) throw new Error('Ambiguous issuer delegation');
+  const record = records[0].join('');
+  if (!record.startsWith('iss=') || !hostnamePattern.test(record.slice(4))) throw new Error('Invalid issuer delegation');
+  const issuer = 'https://' + record.slice(4);
+  const metadata = await fetchJSON(issuer + '/.well-known/email-verification');
+  if (metadata.issuer !== issuer) throw new Error('Issuer mismatch');
+  safeURL(metadata.jwks_uri);
+  const jwks = await fetchJSON(metadata.jwks_uri);
+  if (!Array.isArray(jwks.keys) || jwks.keys.length > 100) throw new Error('Invalid issuer keys');
+  if (metadata.signing_alg_values_supported !== undefined && !Array.isArray(metadata.signing_alg_values_supported)) throw new Error('Invalid algorithms');
+  return { issuer, keys: jwks.keys, signingAlgorithms: metadata.signing_alg_values_supported };
+}
diff --git a/lib/store.mjs b/lib/store.mjs
new file mode 100644
index 0000000..f198394
--- /dev/null
+++ b/lib/store.mjs
@@ -0,0 +1,55 @@
+import { DatabaseSync } from 'node:sqlite';
+import { randomBytes, randomUUID } from 'node:crypto';
+
+export function createStore(path) {
+  const db = new DatabaseSync(path);
+  db.exec(`PRAGMA journal_mode = WAL;
+    CREATE TABLE IF NOT EXISTS challenges (
+      session TEXT PRIMARY KEY, nonce TEXT NOT NULL, expires INTEGER NOT NULL,
+      used INTEGER NOT NULL DEFAULT 0, flash TEXT
+    );
+    CREATE TABLE IF NOT EXISTS rewards_accounts (
+      id TEXT PRIMARY KEY, email TEXT NOT NULL UNIQUE, first_name TEXT NOT NULL,
+      last_name TEXT NOT NULL, issuer TEXT NOT NULL, email_verified_at INTEGER NOT NULL,
+      marketing_consent INTEGER NOT NULL, terms_version TEXT NOT NULL, created_at INTEGER NOT NULL
+    );
+    CREATE TABLE IF NOT EXISTS rate_limits (key TEXT PRIMARY KEY, count INTEGER NOT NULL, expires INTEGER NOT NULL);`);
+  return {
+    createChallenge(flash = null) {
+      const now = Date.now();
+      db.prepare('DELETE FROM challenges WHERE expires < ?').run(now);
+      const session = randomBytes(32).toString('base64url');
+      const nonce = randomBytes(32).toString('base64url');
+      db.prepare('INSERT INTO challenges (session,nonce,expires,flash) VALUES (?,?,?,?)').run(session, nonce, now + 600000, flash ? JSON.stringify(flash) : null);
+      return { session, nonce };
+    },
+    takeFlash(session) {
+      const row = db.prepare('SELECT flash FROM challenges WHERE session = ? AND expires > ?').get(session, Date.now());
+      if (!row?.flash) return null;
+      db.prepare('UPDATE challenges SET flash = NULL WHERE session = ?').run(session);
+      return JSON.parse(row.flash);
+    },
+    consumeChallenge(session, nonce) {
+      // Atomic consumption happens before any asynchronous signature/DNS checks.
+      return db.prepare('UPDATE challenges SET used = 1 WHERE session = ? AND nonce = ? AND used = 0 AND expires > ?').run(session, nonce, Date.now()).changes === 1;
+    },
+    setFlash(session, flash) {
+      db.prepare('UPDATE challenges SET flash = ? WHERE session = ?').run(JSON.stringify(flash), session);
+    },
+    createAccount({ email, firstName, lastName, issuer, marketing }) {
+      const now = Date.now();
+      // No conflict update: a repeat registration cannot overwrite an existing account.
+      return db.prepare(`INSERT INTO rewards_accounts
+        (id,email,first_name,last_name,issuer,email_verified_at,marketing_consent,terms_version,created_at)
+        VALUES (?,?,?,?,?,?,?,?,?) ON CONFLICT(email) DO NOTHING`).run(randomUUID(), email, firstName, lastName, issuer, now, marketing ? 1 : 0, '2026-10-30', now,).changes === 1;
+    },
+    allow(key, limit = 20) {
+      const now = Date.now();
+      db.prepare('DELETE FROM rate_limits WHERE expires < ?').run(now);
+      const row = db.prepare(`INSERT INTO rate_limits (key,count,expires) VALUES (?,1,?)
+        ON CONFLICT(key) DO UPDATE SET count = count + 1 RETURNING count`).get(key, now + 600000);
+      return row.count <= limit;
+    },
+    close() { db.close(); },
+  };
+}
