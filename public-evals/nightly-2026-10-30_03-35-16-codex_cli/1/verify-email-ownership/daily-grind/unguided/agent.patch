+.cream-button:hover{background:#e9e0cf}
+.hero-note{position:absolute;right:10%;top:27%;width:130px;height:130px;border:1px solid #e4d9bc8c;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;transform:rotate(11deg);font-family:var(--serif);font-size:16px;font-style:italic;line-height:1.35;color:#f0e6d1}
