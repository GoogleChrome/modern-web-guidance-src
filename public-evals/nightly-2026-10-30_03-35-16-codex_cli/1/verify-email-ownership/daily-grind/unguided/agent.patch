+const result = document.querySelector('#form-result');
+const form = document.querySelector('#rewards-form');
+// Use native form submission so the browser can inject its proof at submission.
+if (result.dataset.state === 'success') {
+  form.hidden = true;
+  document.querySelector('.success-details').hidden = false;
+}
+// A static host cannot perform server verification or register an account.
+if (form.elements.nonce.value === '__FORM_NONCE__') {
+  for (const input of form.querySelectorAll('input:not([type="hidden"])')) {
+    if (input.value.startsWith('__')) input.value = '';
+  }
+  form.addEventListener('submit', event => {
+    event.preventDefault();
+    result.dataset.state = 'error';
+    result.textContent = 'Registration is unavailable on this static preview. Please use the secure Daily Grind website to join.';
+    result.scrollIntoView({ block: 'nearest' });
+  });
+}
