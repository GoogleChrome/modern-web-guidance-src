+.brand{display:flex;align-items:center;gap:12px;font-size:17px;font-weight:700;letter-spacing:1.6px;line-height:1.35;white-space:nowrap}
+.brand small{display:block;font-weight:400;font-size:8px;letter-spacing:2.8px;margin-top:5px}
+.brand-mark{font-family:var(--serif);font-style:italic;font-size:38px;letter-spacing:-5px;color:var(--orange);position:relative;padding-right:9px;line-height:1}
+.brand-mark span{position:absolute;font-size:18px;top:-4px;right:0;letter-spacing:0}
+.site-header nav{display:flex;gap:31px;font-size:12px}
+.site-header nav a{padding:8px 0}
+.site-header nav .active{color:var(--orange);border-bottom:1px solid var(--orange)}
+.nav-cta{border:1px solid #cdc6b9;border-radius:4px;padding:12px 16px;font-size:11px;font-weight:600;display:flex;gap:24px;align-items:center}
+.nav-cta:hover{background:#eee9de}
+.hero{position:relative;max-width:1320px;margin:0 auto;background:linear-gradient(90deg,rgba(26,25,19,.81),rgba(26,25,19,.17) 78%),url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1800&q=85') center 52%/cover;min-height:414px;color:#fffaf0;display:flex;align-items:center;padding:48px 7.7%;overflow:hidden}
