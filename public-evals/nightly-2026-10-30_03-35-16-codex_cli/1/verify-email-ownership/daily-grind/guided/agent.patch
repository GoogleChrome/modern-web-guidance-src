index 0000000..c68969f
--- /dev/null
+++ b/lib/app.mjs
@@ -0,0 +1,65 @@
+import { verifyEmailToken } from './verify-email.mjs';
+
+const escape = value => String(value).replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' })[char]);
+const cookieValue = (header, name) => (header || '').split(';').map(part => part.trim()).find(part => part.startsWith(`${name}=`))?.slice(name.length + 1);
+
+// Request/Response handler has no listener or startup side effects.
+export function createHandler({ origin, trialToken = '', template, store, assets, verify = verifyEmailToken }) {
+  const secure = origin.startsWith('https:');
+  const cookieName = secure ? '__Host-dg_signup' : 'dg_signup';
+  const headers = {
+    'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'same-origin', 'X-Frame-Options': 'DENY',
+    ...(trialToken ? { 'Origin-Trial': trialToken } : {}),
+  };
+  function render(request, { message = '', name = '', email = '', success = false, status = 200 } = {}) {
+    store.consume(cookieValue(request.headers.get('cookie'), cookieName));
+    const challenge = success ? null : store.issue();
+    const values = {
+      MESSAGE: escape(message), NAME: escape(name), EMAIL: escape(email),
+      NONCE: challenge?.nonce || '', FORM_HIDDEN: success ? 'hidden' : '',
+    };
+    const body = template.replace(/\{\{([A-Z_]+)\}\}/g, (_, key) => values[key] || '');
+    return new Response(body, {
+      status, headers: { ...headers, 'Content-Type': 'text/html; charset=utf-8',
+        'Set-Cookie': `${cookieName}=${challenge?.id || ''}; Path=/; HttpOnly; SameSite=Lax; Max-Age=${success ? 0 : 600}${secure ? '; Secure' : ''}` },
+    });
+  }
+  return async request => {
+    const url = new URL(request.url);
+    if (request.method === 'GET' && (url.pathname === '/' || url.pathname === '/index.html')) return render(request);
+    if (request.method === 'GET' && assets.has(url.pathname)) {
+      const asset = assets.get(url.pathname);
+      return new Response(asset.body, { headers: { ...headers, 'Content-Type': asset.type } });
+    }
+    if (url.pathname !== '/api/verify-email') return new Response('Not found', { status: 404, headers });
+    if (request.method !== 'POST') return new Response('Method not allowed', { status: 405, headers: { ...headers, Allow: 'POST' } });
+    if (request.headers.get('origin') !== origin) return new Response('Request origin not allowed', { status: 403, headers });
+    // Consume before parsing or any asynchronous operation; every attempt is single use.
+    const expectedNonce = store.consume(cookieValue(request.headers.get('cookie'), cookieName));
+    if (!expectedNonce) return render(request, { status: 409, message: 'This sign-up session has expired or was already used. Please enter your details and try again.' });
+    if (!request.headers.get('content-type')?.startsWith('application/x-www-form-urlencoded')) return render(request, { status: 415, message: 'Please use the sign-up form below to create your account.' });
+    const rawBody = await request.text();
+    if (Buffer.byteLength(rawBody) > 65536) return render(request, { status: 413, message: 'We couldn’t process this form. Please try again.' });
+    const data = new URLSearchParams(rawBody);
+    const name = (data.get('name') || '').trim();
+    const email = (data.get('email') || '').trim();
+    const rawToken = data.get('token') || '';
+    if (['name', 'email', 'token'].some(key => data.getAll(key).length !== 1) ||
+        !name || name.length > 100 || /[\u0000-\u001f\u007f]/.test(name) || email.length > 254 ||
+        !/^[^\s@]+@(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,63}$/.test(email)) {
+      return render(request, { status: 400, message: 'Please enter your name and a valid email address.', name: name.slice(0, 100), email: email.slice(0, 254) });
+    }
+    if (!rawToken) return render(request, { status: 422, name, email, message: 'Your browser didn’t provide email verification. Use a browser and email provider that support browser email verification, sign in to your email provider in this browser, and allow verification if prompted. Then try again. No verification email was sent, and no account was created.' });
+    try {
+      await verify({ rawToken, submittedEmail: email, expectedNonce, expectedAudience: origin });
+    } catch {
+      return render(request, { status: 422, name, email, message: 'We couldn’t verify ownership of that email address. Check that you’re signed in to the matching email account in this browser, then try again. No account was created and no verification email was sent.' });
+    }
+    try { store.createAccount(name, email); }
+    catch {
+      return render(request, { status: 503, name, email, message: 'We couldn’t save your rewards account right now. Please try again in a moment.' });
+    }
+    return render(request, { success: true, message: 'You’re part of the crew! Your email is verified and your rewards account is ready. We’re glad you’re here.' });
+  };
+}
diff --git a/lib/network.mjs b/lib/network.mjs
new file mode 100644
index 0000000..de4870e
--- /dev/null
+++ b/lib/network.mjs
@@ -0,0 +1,53 @@
+import { lookup } from 'node:dns/promises';
+import { BlockList, isIP } from 'node:net';
+import { request } from 'node:https';
+
+const blocked = new BlockList();
+for (const [ip, prefix] of [['0.0.0.0',8],['10.0.0.0',8],['100.64.0.0',10],['127.0.0.0',8],['169.254.0.0',16],['172.16.0.0',12],['192.0.0.0',24],['192.168.0.0',16],['198.18.0.0',15],['224.0.0.0',4],['240.0.0.0',4]]) blocked.addSubnet(ip, prefix, 'ipv4');
+// Permit only global unicast IPv6, excluding special-use ranges below.
+for (const [ip, prefix] of [['2001::',23],['2001:db8::',32],['2002::',16]]) blocked.addSubnet(ip, prefix, 'ipv6');
+export function isPublicAddress(address) {
+  const family = isIP(address);
+  if (family === 4) return !blocked.check(address, 'ipv4');
+  return family === 6 && /^[23]/i.test(address) && !blocked.check(address, 'ipv6');
+}
+
+export function httpsUrl(value, originOnly = false) {
+  const url = new URL(value);
+  if (url.protocol !== 'https:' || url.username || url.password || url.port || url.hash ||
+      (originOnly && value !== url.origin)) throw new Error('Invalid HTTPS URL');
+  return url;
+}
+
+// Resolve and pin a public address so an email domain cannot use issuer discovery
+// to reach the local network, including through DNS rebinding or HTTP redirects.
+export async function fetchPublicJson(value) {
+  const url = httpsUrl(value);
+  const addresses = await lookup(url.hostname, { all: true });
+  if (!addresses.length || addresses.some(({ address }) => !isPublicAddress(address))) throw new Error('Non-public issuer address');
+  const selected = addresses[0];
+  return new Promise((resolve, reject) => {
+    const req = request(url, {
+      headers: { Accept: 'application/json' },
+      lookup: (_hostname, options, callback) => options.all
+        ? callback(null, [selected]) : callback(null, selected.address, selected.family),
+    }, (res) => {
+      if (res.statusCode !== 200) { res.resume(); reject(new Error('Issuer request failed')); return; }
+      let size = 0;
+      const chunks = [];
+      res.on('data', chunk => {
+        size += chunk.length;
+        if (size > 131072) { req.destroy(new Error('Issuer response too large')); return; }
+        chunks.push(chunk);
+      });
+      res.on('error', reject);
+      res.on('end', () => {
+        try { resolve(JSON.parse(Buffer.concat(chunks).toString('utf8'))); } catch (err) { reject(err); }
+      });
+    });
+    const timeout = setTimeout(() => req.destroy(new Error('Issuer request timed out')), 5000);
+    req.on('close', () => clearTimeout(timeout));
+    req.on('error', reject);
+    req.end();
+  });
+}
