+  assert.equal(response.headers.get('origin-trial'), 'test-origin-trial');
+  assert.match(response.headers.get('set-cookie'), /HttpOnly; SameSite=Lax; Max-Age=600; Secure/);
+  assert.equal(nonce.length, 43);
+  assert.ok(!cookie.includes(nonce));
+  assert.match(html, /<form[^>]*method="post"[\s\S]*autocomplete="email"[\s\S]*autocomplete="email-verification-token"[\s\S]*<\/form>/);
