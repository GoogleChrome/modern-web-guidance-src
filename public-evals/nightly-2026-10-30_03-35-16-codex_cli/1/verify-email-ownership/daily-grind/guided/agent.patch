diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..9a41a0b
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,53 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { createHandler } from './lib/app.mjs';
+import { createStore } from './lib/store.mjs';
+
+const port = Number(process.env.PORT || 11222);
+const origin = process.env.APP_ORIGIN || `http://localhost:${port}`;
+const originUrl = new URL(origin);
+if (originUrl.origin !== origin || (!origin.startsWith('https:') && !['localhost', '127.0.0.1', '[::1]'].includes(originUrl.hostname))) {
+  throw new Error('APP_ORIGIN must be an HTTPS origin (HTTP is allowed only on loopback for local development).');
+}
+if (process.env.NODE_ENV === 'production' && !process.env.APP_ORIGIN) throw new Error('APP_ORIGIN is required in production');
+const store = createStore(process.env.DATABASE_PATH || './data/rewards.sqlite');
+const assets = new Map(await Promise.all([
+  ['/styles.css', 'text/css; charset=utf-8', './styles.css'],
+  ['/signup.js', 'text/javascript; charset=utf-8', './signup.js'],
+].map(async ([path, type, file]) => [path, { type, body: await readFile(new URL(file, import.meta.url)) }])));
+const handler = createHandler({ origin, trialToken: process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL_TOKEN,
+  template: await readFile(new URL('./index.html', import.meta.url), 'utf8'), store, assets });
+const attempts = new Map();
+const server = createServer(async (req, res) => {
+  try {
+    if (req.method === 'POST') {
+      const now = Date.now();
+      for (const [key, value] of attempts) if (value.expires < now) attempts.delete(key);
+      const address = req.socket.remoteAddress;
+      const bucket = attempts.get(address) || { count: 0, expires: now + 60000 };
+      attempts.set(address, bucket);
+      if (++bucket.count > 20) { res.writeHead(429, { 'Retry-After': '60', 'Cache-Control': 'no-store' }); res.end('Too many attempts. Wait a minute, then reload the homepage to try again.'); req.resume(); return; }
+    }
+    const chunks = [];
+    let size = 0;
+    for await (const chunk of req) {
+      size += chunk.length;
+      if (size > 65536) { res.writeHead(413, { 'Cache-Control': 'no-store' }); res.end('Form too large. Reload the homepage to try again.'); return; }
+      chunks.push(chunk);
+    }
+    // Never infer the expected audience from untrusted Host/Forwarded headers.
+    const url = new URL(req.url, origin);
+    const request = new Request(url, { method: req.method, headers: req.headers,
+      ...(!['GET', 'HEAD'].includes(req.method) ? { body: Buffer.concat(chunks) } : {}) });
+    const response = await handler(request);
+    res.writeHead(response.status, Object.fromEntries(response.headers));
+    res.end(Buffer.from(await response.arrayBuffer()));
+  } catch {
+    res.writeHead(500, { 'Cache-Control': 'no-store', 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Something went wrong. Reload the homepage to try again.');
+  }
+});
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(port, () => console.log(`Daily Grind listening on port ${port}`));
+for (const signal of ['SIGINT', 'SIGTERM']) process.on(signal, () => server.close(() => { store.close(); process.exit(0); }));
