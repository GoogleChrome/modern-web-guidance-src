@@ -0,0 +1,33 @@
+import { DatabaseSync } from 'node:sqlite';
+import { randomBytes, randomUUID } from 'node:crypto';
+import { mkdirSync } from 'node:fs';
+import { dirname } from 'node:path';
+
+export function createStore(path) {
+  if (path !== ':memory:') mkdirSync(dirname(path), { recursive: true });
+  const db = new DatabaseSync(path);
+  db.exec(`PRAGMA journal_mode=WAL;
+    CREATE TABLE IF NOT EXISTS challenges (id TEXT PRIMARY KEY, nonce TEXT NOT NULL, expires INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS accounts (id TEXT PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL, email_key TEXT NOT NULL UNIQUE, verified_at INTEGER NOT NULL);
+  `);
+  return {
+    issue() {
+      const now = Date.now();
+      db.prepare('DELETE FROM challenges WHERE expires <= ?').run(now);
+      const id = randomBytes(32).toString('base64url');
+      const nonce = randomBytes(32).toString('base64url');
+      db.prepare('INSERT INTO challenges VALUES (?, ?, ?)').run(id, nonce, now + 10 * 60 * 1000);
+      return { id, nonce };
+    },
+    consume(id) {
+      // DELETE RETURNING is atomic, even across concurrent requests/processes.
+      const row = db.prepare('DELETE FROM challenges WHERE id = ? RETURNING nonce, expires').get(id || '');
+      return row && row.expires > Date.now() ? row.nonce : null;
+    },
+    createAccount(name, email) {
+      db.prepare('INSERT INTO accounts VALUES (?, ?, ?, ?, ?) ON CONFLICT(email_key) DO NOTHING')
+        .run(randomUUID(), name, email, email.toLowerCase(), Date.now());
+    },
+    close: () => db.close(),
+  };
+}
diff --git a/lib/verify-email.mjs b/lib/verify-email.mjs
new file mode 100644
index 0000000..53f6903
--- /dev/null
+++ b/lib/verify-email.mjs
@@ -0,0 +1,73 @@
+import { createHash } from 'node:crypto';
+import { Resolver } from 'node:dns/promises';
+import { SDJwtInstance, decodeSdJwtSync } from '@sd-jwt/core';
+import { createLocalJWKSet, importJWK, jwtVerify } from 'jose';
+import { fetchPublicJson, httpsUrl } from './network.mjs';
+
+const resolver = new Resolver({ timeout: 2000, tries: 2 });
+const algorithms = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = alg => alg === 'Ed25519' ? 'EdDSA' : alg;
+const hasher = (data, alg) => {
+  if (!['sha-256', 'sha-384', 'sha-512'].includes(alg)) throw new Error('Unsupported digest');
+  return createHash(alg.replace('-', '')).update(data).digest();
+};
+
+// Dependencies can be replaced by offline cryptographic fixtures in tests.
+export async function verifyEmailToken({ rawToken, submittedEmail, expectedNonce, expectedAudience }, {
+  resolveTxt = name => resolver.resolveTxt(name), getJson = fetchPublicJson,
+} = {}) {
+  if (!expectedNonce || typeof rawToken !== 'string' || rawToken.length > 32768) throw new Error('Missing or oversized presentation');
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evt = decoded.jwt.payload;
+  if (!decoded.kbJwt || typeof evt.iss !== 'string') throw new Error('Missing issuer or key binding');
+  if (!['ev+sd-jwt', 'evt+jwt'].includes(decoded.jwt.header.typ)) throw new Error('Invalid EVT type');
+  httpsUrl(evt.iss, true);
+  const domain = submittedEmail.slice(submittedEmail.lastIndexOf('@') + 1).toLowerCase();
+  const records = await resolveTxt(`_email-verification.${domain}`);
+  if (!records.some(parts => `https://${parts.join('').replace(/^iss=/, '')}` === evt.iss && parts.join('').startsWith('iss='))) throw new Error('Issuer is not delegated by the email domain');
+  const metadata = await getJson(`${evt.iss}/.well-known/email-verification`);
+  if (metadata.issuer !== evt.iss) throw new Error('Issuer metadata mismatch');
+  httpsUrl(metadata.jwks_uri);
+  const keys = createLocalJWKSet(await getJson(metadata.jwks_uri));
+  const evtOptions = {
+    // Current EVP uses ev+sd-jwt; accept the earlier origin-trial evt+jwt type.
+    typ: decoded.jwt.header.typ, issuer: evt.iss, algorithms,
+    requiredClaims: ['iat', 'exp', 'email', 'email_verified', 'cnf'],
+    maxTokenAge: '5m', clockTolerance: 60,
+  };
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, signature) => {
+      const compact = `${data}.${signature}`;
+      try { await jwtVerify(compact, keys, evtOptions); }
+      catch (err) {
+        if (err.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const key of err) {
+          try { await jwtVerify(compact, key, evtOptions); matched = true; break; } catch { /* Try the next provider key. */ }
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, signature) => {
+      const jwk = evt.cnf?.jwk;
+      const alg = decoded.kbJwt.header.alg;
+      if (!jwk || jwk.d || jwk.k || !algorithms.includes(alg) ||
+          !algorithms.includes(jwk.alg) || normalizeAlg(jwk.alg) !== normalizeAlg(alg)) throw new Error('Invalid holder key algorithm');
+      const key = await importJWK(jwk, alg);
+      await jwtVerify(`${data}.${signature}`, key, {
+        typ: 'kb+jwt', algorithms: [alg], audience: expectedAudience,
+        maxTokenAge: '5m', clockTolerance: 60,
+      });
+      return true;
+    },
+  });
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'], keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience, keyBindingMaxAgeSeconds: 300, skewSeconds: 60,
+  });
+  if (verified.payload.email_verified !== true || typeof verified.payload.email !== 'string' ||
+      verified.payload.email.toLowerCase() !== submittedEmail.toLowerCase()) throw new Error('Email ownership claim mismatch');
+  return verified.payload.email;
+}
