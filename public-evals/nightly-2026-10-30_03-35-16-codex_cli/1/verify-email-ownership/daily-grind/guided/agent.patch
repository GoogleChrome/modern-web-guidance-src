+const template = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+async function setup(t) {
+  const store = createStore(':memory:');
+  const saved = [];
+  const createAccount = store.createAccount;
+  store.createAccount = (...args) => { createAccount(...args); saved.push(args); };
+  t.after(() => store.close());
+  const handler = createHandler({ origin, trialToken: 'test-origin-trial', template, assets: new Map(), store,
+    verify: args => verifyEmailToken(args, dependencies) });
+  const response = await handler(new Request(origin));
+  const html = await response.text();
+  const cookie = response.headers.get('set-cookie').split(';')[0];
+  const nonce = html.match(/name="token"[^>]*nonce="([^"]+)"/)[1];
+  const post = (token, custom = {}) => handler(new Request(`${origin}/api/verify-email`, {
+    method: 'POST', headers: { origin, cookie, 'Content-Type': 'application/x-www-form-urlencoded', ...custom.headers },
+    body: new URLSearchParams({ name: 'Coffee Regular', email: 'member@email.example', token, ...custom.fields }),
+  }));
+  return { handler, response, html, cookie, nonce, post, saved };
