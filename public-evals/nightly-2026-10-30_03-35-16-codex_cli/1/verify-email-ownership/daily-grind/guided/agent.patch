diff --git a/test/rewards.test.mjs b/test/rewards.test.mjs
new file mode 100644
index 0000000..d7d6d53
--- /dev/null
+++ b/test/rewards.test.mjs
@@ -0,0 +1,182 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { readFile, mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import { generateKeyPair, exportJWK, SignJWT } from 'jose';
+import { verifyEmailToken } from '../lib/verify-email.mjs';
+import { createStore } from '../lib/store.mjs';
+import { createHandler } from '../lib/app.mjs';
+import { isPublicAddress, httpsUrl } from '../lib/network.mjs';
+
+const origin = 'https://dailygrind.example';
+const issuer = 'https://email.example';
+const keys = await generateKeyPair('Ed25519');
+const otherKeys = await generateKeyPair('Ed25519');
+const attackerKeys = await generateKeyPair('Ed25519');
+const holder = await generateKeyPair('Ed25519');
+const publicJwk = { ...await exportJWK(keys.publicKey), alg: 'Ed25519' };
+const holderJwk = { ...await exportJWK(holder.publicKey), alg: 'Ed25519' };
+const otherJwk = { ...await exportJWK(otherKeys.publicKey), alg: 'Ed25519' };
+const dependencies = {
+  resolveTxt: async name => { assert.equal(name, '_email-verification.email.example'); return [['iss=email.', 'example']]; },
+  getJson: async url => {
+    if (url === `${issuer}/.well-known/email-verification`) return { issuer, jwks_uri: `${issuer}/keys` };
+    assert.equal(url, `${issuer}/keys`);
+    return { keys: [otherJwk, publicJwk] }; // Multiple keys and no kid, as with Gmail.
+  },
+};
+async function presentation(options = {}) {
+  const now = Math.floor(Date.now() / 1000);
+  const evt = await new SignJWT({ iss: issuer, email: 'Member@Email.Example', email_verified: true,
+    iat: now, exp: now + 240, cnf: { jwk: holderJwk }, ...options.evt })
+    .setProtectedHeader({ alg: 'Ed25519', typ: 'ev+sd-jwt', ...options.header })
+    .sign(options.issuerKey || keys.privateKey);
+  const kb = await new SignJWT({ iat: now, aud: origin, nonce: 'fresh-nonce',
+    sd_hash: createHash('sha256').update(`${evt}~`).digest('base64url'), ...options.kb })
+    .setProtectedHeader({ alg: 'Ed25519', typ: 'kb+jwt' }).sign(options.holderKey || holder.privateKey);
+  return `${evt}~${kb}`;
+}
+const verify = async (token, overrides = {}, deps = dependencies) => verifyEmailToken({
+  rawToken: token, submittedEmail: 'member@email.example', expectedNonce: 'fresh-nonce', expectedAudience: origin, ...overrides,
+}, deps);
+
+test('valid EVP presentation, case-insensitive email, and issuer keys without kid', async () => {
+  assert.equal(await verify(await presentation()), 'Member@Email.Example');
+});
+for (const [label, options] of [
+  ['wrong email', { evt: { email: 'someone@email.example' } }],
+  ['unverified email', { evt: { email_verified: false } }],
+  ['expired issuer token', { evt: { exp: 1 } }],
+  ['missing expiry', { evt: { exp: undefined } }],
+  ['stale issuer token', { evt: { iat: 1 } }],
+  ['wrong issuer signature', { issuerKey: attackerKeys.privateKey }],
+  ['wrong holder signature', { holderKey: otherKeys.privateKey }],
+  ['wrong nonce', { kb: { nonce: 'attacker-nonce' } }],
