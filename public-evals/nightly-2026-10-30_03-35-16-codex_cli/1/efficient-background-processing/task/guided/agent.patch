+  <script>
+    (() => {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const temperature = document.getElementById('roast-temp-value');
+      const context = canvas.getContext('2d');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const beans = Array.from({ length: 36 }, (_, index) => ({
+        x: 35 + (index * 137 % 930),
+        y: 40 + (index * 59 % 150),
+        phase: index * 1.7
+      }));
+      let inView = false;
+      let renderingSkipped = false;
+      let pageActive = true;
+      let running = false;
+      let frameId = null;
+      let intervalId = null;
+      let lastTime = null;
+      let elapsed = 0;
+      let heatTick = 0;
+
+      function drawBeans() {
+        if (!context) return;
+        context.clearRect(0, 0, canvas.width, canvas.height);
+        beans.forEach((bean) => {
+          const angle = elapsed * 0.0015 + bean.phase;
+          context.save();
+          context.translate(bean.x + Math.cos(angle) * 18, bean.y + Math.sin(angle) * 22);
+          context.rotate(angle);
+          context.fillStyle = '#a66b40';
+          context.beginPath();
+          context.ellipse(0, 0, 17, 11, 0, 0, Math.PI * 2);
+          context.fill();
+          context.strokeStyle = '#422719';
+          context.lineWidth = 3;
+          context.beginPath();
+          context.moveTo(-11, 0);
+          context.bezierCurveTo(-4, -6, 4, 6, 11, 0);
+          context.stroke();
+          context.restore();
+        });
+      }
+
+      function animate(time) {
+        frameId = null;
+        if (!running || reducedMotion.matches) return;
+        if (lastTime !== null) elapsed += Math.min(time - lastTime, 64);
+        lastTime = time;
+        drawBeans();
+        frameId = requestAnimationFrame(animate);
+      }
+
+      function stop() {
+        running = false;
+        if (frameId !== null) cancelAnimationFrame(frameId);
+        if (intervalId !== null) clearInterval(intervalId);
+        frameId = intervalId = lastTime = null;
+      }
+
+      function syncActivity() {
+        if (!inView || renderingSkipped || document.hidden || !pageActive) {
+          stop();
+          return;
+        }
+        if (running) return;
+        running = true;
+        drawBeans();
+        if (context && !reducedMotion.matches) frameId = requestAnimationFrame(animate);
+        intervalId = setInterval(() => {
+          heatTick += 1;
+          temperature.textContent = (185 + Math.sin(heatTick / 12) * 18).toFixed(1);
+        }, 1000);
+      }
+
+      // Listen on the container itself: this event does not always bubble.
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', (event) => {
+          renderingSkipped = event.skipped;
+          syncActivity();
+        });
+      }
+
+      // Rendering may start before an element enters the viewport. Also track
+      // actual visibility so no animation or temperature timer runs offscreen.
+      function checkViewport() {
+        const rect = widget.getBoundingClientRect();
+        inView = rect.bottom > 0 && rect.top < window.innerHeight &&
+          rect.right > 0 && rect.left < window.innerWidth;
+        syncActivity();
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          inView = entries[0].isIntersecting && entries[0].intersectionRatio > 0;
+          syncActivity();
+        }, { threshold: 0 });
+        observer.observe(widget);
+      } else {
+        // Legacy fallback does no recurring work while offscreen.
+        window.addEventListener('scroll', checkViewport, { passive: true, capture: true });
+        window.addEventListener('resize', checkViewport, { passive: true });
+      }
+
+      document.addEventListener('visibilitychange', syncActivity);
+      window.addEventListener('pagehide', () => {
+        pageActive = false;
+        stop();
+      });
+      window.addEventListener('pageshow', () => {
+        pageActive = true;
+        checkViewport();
+      });
+      const motionChanged = () => {
+        stop();
+        syncActivity();
+      };
+      if (reducedMotion.addEventListener) reducedMotion.addEventListener('change', motionChanged);
+      else reducedMotion.addListener(motionChanged);
+      checkViewport();
+    })();
+  </script>
 </body>
 
