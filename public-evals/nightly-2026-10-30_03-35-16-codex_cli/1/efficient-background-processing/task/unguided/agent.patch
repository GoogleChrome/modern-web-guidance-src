+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var temperatureValue = document.getElementById('roast-temp-value');
+      var context = canvas.getContext('2d');
+      var frameId = null;
+      var temperatureInterval = null;
+      var running = false;
+      var inViewport = false;
+      var renderingSkipped = false;
+      var pageActive = true;
+      var lastFrameTime = null;
+      var elapsed = 0;
+      var temperature = 180;
+      var beans = [];
+
+      for (var i = 0; i < 42; i++) {
+        beans.push({
+          x: Math.random() * canvas.width,
+          y: 35 + Math.random() * (canvas.height - 70),
+          size: 8 + Math.random() * 7,
+          speed: 30 + Math.random() * 45,
+          phase: Math.random() * Math.PI * 2
+        });
+      }
+
+      function drawBeans() {
+        if (!context) return;
+        context.clearRect(0, 0, canvas.width, canvas.height);
+        beans.forEach(function (bean) {
+          var x = (bean.x + elapsed * bean.speed) % (canvas.width + 40) - 20;
+          var y = bean.y + Math.sin(elapsed * 2 + bean.phase) * 18;
+          context.save();
+          context.translate(x, y);
+          context.rotate(elapsed + bean.phase);
+          context.scale(1.4, 1);
+          context.beginPath();
+          context.arc(0, 0, bean.size, 0, Math.PI * 2);
+          context.fillStyle = temperature > 205 ? '#79452b' : '#b77a43';
+          context.fill();
+          context.beginPath();
+          context.moveTo(0, -bean.size * 0.75);
+          context.bezierCurveTo(-5, -3, 5, 3, 0, bean.size * 0.75);
+          context.strokeStyle = '#3e2723';
+          context.lineWidth = 2;
+          context.stroke();
+          context.restore();
+        });
+      }
+
+      function animate(timestamp) {
+        if (!running) return;
+        if (lastFrameTime !== null) {
+          elapsed += Math.min((timestamp - lastFrameTime) / 1000, 0.05);
+        }
+        lastFrameTime = timestamp;
+        drawBeans();
+        frameId = window.requestAnimationFrame(animate);
+      }
+
+      function syncActivity() {
+        var shouldRun = inViewport && !renderingSkipped && !document.hidden && pageActive;
+        if (shouldRun === running) return;
+        running = shouldRun;
+        if (running) {
+          lastFrameTime = null;
+          if (context) frameId = window.requestAnimationFrame(animate);
+          temperatureInterval = window.setInterval(function () {
+            temperature += 0.5 + Math.random() * 1.5;
+            if (temperature > 225) temperature = 180;
+            temperatureValue.textContent = temperature.toFixed(1);
+          }, 1000);
+        } else {
+          if (frameId !== null) window.cancelAnimationFrame(frameId);
+          window.clearInterval(temperatureInterval);
+          frameId = null;
+          temperatureInterval = null;
+          lastFrameTime = null;
+        }
+      }
+
+      function checkViewport() {
+        var bounds = widget.getBoundingClientRect();
+        inViewport = bounds.bottom > 0 && bounds.top < (window.innerHeight || document.documentElement.clientHeight) &&
+          bounds.right > 0 && bounds.left < (window.innerWidth || document.documentElement.clientWidth);
+        syncActivity();
+      }
+
+      // Rendering-state events avoid work while content-visibility skips the subtree.
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', function (event) {
+          renderingSkipped = event.skipped;
+          syncActivity();
+        });
+      }
+
+      // Also gate on actual visibility: rendering may resume near the viewport.
+      if ('IntersectionObserver' in window) {
+        var observer = new IntersectionObserver(function (entries) {
+          entries.forEach(function (entry) {
+            inViewport = entry.isIntersecting && entry.intersectionRatio > 0;
+          });
+          syncActivity();
+        }, { threshold: 0 });
+        observer.observe(widget);
+      } else {
+        // Older browsers need no polling interval to detect visibility changes.
+        document.addEventListener('scroll', checkViewport, true);
+        window.addEventListener('resize', checkViewport);
+      }
+
+      document.addEventListener('visibilitychange', syncActivity);
+      window.addEventListener('pagehide', function () {
+        pageActive = false;
+        syncActivity();
+      });
+      window.addEventListener('pageshow', function () {
+        pageActive = true;
+        checkViewport();
+      });
+      checkViewport();
+    }());
+  </script>
+
 </body>
 
