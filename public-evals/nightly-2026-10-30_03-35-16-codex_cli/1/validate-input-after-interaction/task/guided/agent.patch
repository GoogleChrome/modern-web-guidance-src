+  <script>
+    const newsletterEmail = document.getElementById('newsletter-email');
+
+    newsletterEmail.addEventListener('blur', () => {
+      newsletterEmail.setAttribute('aria-invalid', String(!newsletterEmail.validity.valid));
+    });
+
+    // Clear feedback while the user edits; validate again when they leave.
+    newsletterEmail.addEventListener('focus', () => {
+      newsletterEmail.removeAttribute('aria-invalid');
+    });
+    newsletterEmail.addEventListener('input', () => {
+      newsletterEmail.removeAttribute('aria-invalid');
+    });
+  </script>
