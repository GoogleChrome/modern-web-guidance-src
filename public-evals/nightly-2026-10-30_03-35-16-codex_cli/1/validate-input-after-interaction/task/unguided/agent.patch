@@ -206,7 +271,48 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterError = document.getElementById('newsletter-error');
+    const newsletterStatus = document.getElementById('newsletter-status');
+
+    function clearNewsletterError() {
+      newsletterEmail.removeAttribute('aria-invalid');
+      newsletterError.textContent = '';
+    }
+
+    function validateNewsletterEmail() {
+      const valid = newsletterEmail.validity.valid;
+      if (valid) {
+        clearNewsletterError();
+      } else {
+        newsletterEmail.setAttribute('aria-invalid', 'true');
+        newsletterError.textContent = newsletterEmail.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address.';
+      }
+      return valid;
+    }
+
+    newsletterEmail.addEventListener('blur', validateNewsletterEmail);
+    newsletterEmail.addEventListener('focus', clearNewsletterError);
+    newsletterEmail.addEventListener('input', () => {
+      clearNewsletterError();
+      newsletterStatus.textContent = '';
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      newsletterEmail.blur();
+      if (!validateNewsletterEmail()) return;
+
+      // Connect a newsletter service here before accepting subscriptions.
+      newsletterStatus.textContent = 'Newsletter signup is not available yet. Please try again later.';
+    });
+  </script>
+
 </body>
 
 </html>
