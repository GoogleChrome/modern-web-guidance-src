+    const orderForm = document.getElementById('coffee-order');
+    const pickupDate = document.getElementById('pickup-date');
+    const today = new Date();
+    const localDate = [today.getFullYear(), String(today.getMonth() + 1).padStart(2, '0'), String(today.getDate()).padStart(2, '0')].join('-');
+    pickupDate.min = localDate;
+    pickupDate.value = localDate;
+
+    orderForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const order = new FormData(orderForm);
+      const date = new Date(`${order.get('pickup-date')}T${order.get('pickup-time')}`);
+      const pickup = date.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
+      const extra = order.has('extra-shot') ? ', with an extra espresso shot' : '';
+      const notes = order.get('notes').trim();
+      document.getElementById('order-status').textContent =
+        `Your coffee: ${order.get('size')} ${order.get('coffee')}, ${order.get('milk').toLowerCase()}, sweetness ${order.get('sweetness')}/4${extra}. Pickup: ${pickup}.${notes ? ` Special requests: ${notes}` : ''} This is a preview; no order has been placed.`;
+    });
