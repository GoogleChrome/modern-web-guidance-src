+  <script>
+    const orderForm = document.getElementById('coffee-order');
+    const sweetness = document.getElementById('sweetness');
+    const sweetnessValue = document.getElementById('sweetness-value');
+    const orderSummary = document.getElementById('order-summary');
+
+    sweetness.addEventListener('input', () => {
+      sweetnessValue.value = sweetness.value;
+    });
+
+    orderForm.addEventListener('input', () => {
+      orderSummary.textContent = '';
+    });
+
+    orderForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(orderForm);
+      const coffee = orderForm.elements.coffee.selectedOptions[0].textContent;
+      const milk = orderForm.elements.milk.selectedOptions[0].textContent;
+      const extras = data.getAll('extras').map(value => value === 'extra-shot' ? 'extra espresso shot' : 'cinnamon');
+      const pickupDate = data.get('pickup-date');
+      const pickupTime = data.get('pickup-time');
+      const pickup = [pickupDate, pickupTime].filter(Boolean).join(' at ');
+      const notes = data.get('notes').trim();
+      orderSummary.textContent = `${data.get('name').trim()}, your coffee: ${data.get('size')} ${coffee}, ${milk.toLowerCase()}, sweetness ${data.get('sweetness')} of 4${extras.length ? ', with ' + extras.join(' and ') : ''}.${pickup ? ' Preferred pickup: ' + pickup + '.' : ''}${notes ? ' Special requests: ' + notes : ''} This is a preview; your order has not been placed.`;
+    });
+  </script>
