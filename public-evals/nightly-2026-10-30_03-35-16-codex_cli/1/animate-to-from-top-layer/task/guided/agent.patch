+  <dialog id="logout-dialog" class="overlay" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" id="close-dialog-btn" class="overlay-close" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" id="cancel-logout-btn" class="btn btn-secondary" autofocus>Cancel</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <aside id="ordering-notice" class="overlay" popover="manual" aria-label="Online ordering status" hidden>
+    <button type="button" id="dismiss-notice-btn" class="overlay-close" aria-label="Dismiss ordering notice">&times;</button>
+    <p role="status">online ordering is currently offline</p>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const dialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const notice = document.getElementById('ordering-notice');
+    const hasPopover = 'popover' in HTMLElement.prototype;
+
+    // Keep overlays in the top layer until their CSS exit animations finish.
+    // This also handles browsers without discrete display/overlay transitions.
+    async function dismiss(element, finish) {
+      if (element.hasAttribute('data-closing')) return;
+      element.setAttribute('data-closing', '');
+      const animations = element.getAnimations({ subtree: true });
+      await Promise.race([
+        Promise.allSettled(animations.map(animation => animation.finished)),
+        new Promise(resolve => setTimeout(resolve, 500))
+      ]);
+      finish();
+      element.removeAttribute('data-closing');
+    }
+
+    function closeDialog() {
+      return dismiss(dialog, () => dialog.close());
+    }
+
+    function closeNotice() {
+      return dismiss(notice, () => {
+        if (hasPopover) notice.hidePopover();
+        notice.removeAttribute('data-visible');
+        notice.hidden = true;
+        orderButton.setAttribute('aria-expanded', 'false');
+        if (notice.contains(document.activeElement)) orderButton.focus();
+      });
+    }
+
+    logoutLink.addEventListener('click', event => {
+      event.preventDefault();
+      if (orderButton.getAttribute('aria-expanded') === 'true') closeNotice();
+      dialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeDialog);
+    dialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeDialog();
+    });
+
+    orderButton.addEventListener('click', () => {
+      if (orderButton.getAttribute('aria-expanded') === 'true') {
+        closeNotice();
+        return;
+      }
+      notice.hidden = false;
+      if (hasPopover) notice.showPopover();
+      else notice.setAttribute('data-visible', '');
+      orderButton.setAttribute('aria-expanded', 'true');
+    });
+    document.getElementById('dismiss-notice-btn').addEventListener('click', closeNotice);
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && orderButton.getAttribute('aria-expanded') === 'true') {
+        closeNotice();
+      }
+    });
+    document.addEventListener('pointerdown', event => {
+      if (orderButton.getAttribute('aria-expanded') === 'true' &&
+          !notice.contains(event.target) && !orderButton.contains(event.target)) {
+        closeNotice();
+      }
+    });
+  </script>
