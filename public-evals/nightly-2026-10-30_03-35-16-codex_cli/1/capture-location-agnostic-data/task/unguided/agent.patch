+  <script>
+    (() => {
+      const status = document.getElementById('preferences-status');
+      const preferences = [
+        ['pickup-reminder', 'daily-grind.pickup-reminder'],
+        ['coffee-anniversary', 'daily-grind.coffee-anniversary']
+      ];
+
+      for (const [id, key] of preferences) {
+        const input = document.getElementById(id);
+
+        // Keep wall-clock time (HH:mm) and calendar date (YYYY-MM-DD) as strings.
+        // Date objects, timestamps and UTC conversions would shift these on travel.
+        try {
+          input.value = localStorage.getItem(key) || '';
+        } catch {
+          status.textContent = 'Saved preferences are unavailable. Changes may not persist after you leave this page.';
+        }
+
+        input.addEventListener('change', () => {
+          if (!input.validity.valid) return;
+
+          try {
+            if (input.value) {
+              localStorage.setItem(key, input.value);
+            } else {
+              localStorage.removeItem(key);
+            }
+            status.textContent = 'Coffee preferences saved in this browser.';
+          } catch {
+            status.textContent = 'Your selection is set for this visit, but could not be saved in this browser.';
+          }
+        });
+      }
+    })();
+  </script>
