+  <script>
+    (() => {
+      const storageKey = 'daily-grind-coffee-preferences';
+      const form = document.getElementById('coffee-preferences');
+      const reminder = document.getElementById('pickup-reminder');
+      const anniversary = document.getElementById('coffee-anniversary');
+      const status = document.getElementById('preferences-status');
+
+      // These are a wall-clock time and a calendar date, never instants.
+      // Keep native input strings (HH:mm / YYYY-MM-DD) throughout storage and
+      // restoration. Date, valueAsDate, UTC conversion, and offsets would add
+      // time zone semantics that these preferences must not have.
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey));
+        if (saved && typeof saved === 'object') {
+          if (typeof saved.pickupReminder === 'string') {
+            reminder.value = saved.pickupReminder;
+          }
+          if (typeof saved.coffeeAnniversary === 'string') {
+            anniversary.value = saved.coffeeAnniversary;
+          }
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can still choose new values.';
+      }
+
+      form.addEventListener('input', () => {
+        status.textContent = 'You have unsaved changes.';
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        try {
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupReminder: reminder.value,
+            coffeeAnniversary: anniversary.value,
+          }));
+          status.textContent = 'Preferences saved on this device.';
+        } catch {
+          status.textContent = 'Preferences could not be saved. Please allow browser storage and try again.';
+        }
+      });
+    })();
+  </script>
+
