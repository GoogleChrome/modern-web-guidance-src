+  <script>
+    const form = document.getElementById('subscription-form');
+    const roast = document.getElementById('roast-level');
+    const roastValue = document.getElementById('roast-value');
+    const progress = document.getElementById('setup-progress');
+    const status = document.getElementById('subscription-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updatePreferences() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      roastValue.value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      const frequency = form.querySelector('input[name="frequency"]:checked');
+      const completion = frequency ? 100 : 50;
+      progress.value = completion;
+      progress.textContent = completion + '%';
+      document.getElementById('progress-text').textContent = completion + '% complete';
+      document.getElementById('progress-help').textContent = frequency
+        ? '2 of 2 preferences set. Ready to review your choices.'
+        : '1 of 2 preferences set. ' + roastName + ' roast is selected; choose your delivery frequency.';
+      status.textContent = '';
+    }
+
+    form.addEventListener('input', updatePreferences);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const frequency = new FormData(form).get('frequency');
+      const emailChoice = document.getElementById('email-opt-in').checked;
+      status.textContent = 'Your preferences: ' + roastValue.value + ' roast, delivered ' + frequency
+        + '. Email offers: ' + (emailChoice ? 'yes' : 'no')
+        + '. Your choices are ready; no subscription has been placed.';
+    });
+    updatePreferences();
+  </script>
+
