+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-level');
+    const roastOutput = document.getElementById('roast-output');
+    const progress = document.getElementById('setup-progress');
+    const progressText = document.getElementById('progress-text');
+    const review = document.getElementById('subscription-review');
+    const roasts = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updateSetup() {
+      const roastName = roasts[Number(roast.value) - 1];
+      roastOutput.value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      roast.style.setProperty('--range-fill', `${(Number(roast.value) - 1) / 4 * 100}%`);
+      const completed = Number(email.value.trim() !== '' && email.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked'))) + 1;
+      const percentage = Math.round(completed / 3 * 100);
+      progress.value = completed;
+      progress.textContent = `${percentage}%`;
+      progressText.textContent = `${completed} of 3 ready · ${percentage}%`;
+      review.textContent = '';
+    }
+
+    form.addEventListener('input', updateSetup);
+    form.addEventListener('change', updateSetup);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const frequency = form.querySelector('input[name="frequency"]:checked').value;
+      const wantsEmails = document.getElementById('subscription-emails').checked;
+      review.textContent = `Your preferences: ${roastOutput.value.toLowerCase()} roast, delivered ${frequency}. Email: ${email.value}. Coffee emails: ${wantsEmails ? 'yes' : 'no'}. Your setup is ready to review; no subscription or email enrollment has been created.`;
+    });
+    updateSetup();
+  </script>
