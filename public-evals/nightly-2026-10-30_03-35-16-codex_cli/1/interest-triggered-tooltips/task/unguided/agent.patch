+    .details {
+      position: relative;
+      display: inline-block;
+      margin-top: 15px;
+    }
+
+    .details .btn {
+      margin-top: 0;
+    }
+
+    .details .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .details-tooltip {
+      position: absolute;
+      top: calc(100% + 10px);
+      left: 50%;
+      transform: translateX(-50%);
+      z-index: 10;
+      width: 220px;
+      padding: 12px 14px;
+      border-radius: 6px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
+      font-size: 0.85rem;
+      line-height: 1.5;
+      text-align: left;
+      visibility: hidden;
+      opacity: 0;
+    }
+
+    /* Keep the tooltip open while the pointer crosses the gap. */
+    .details-tooltip::before {
+      content: '';
+      position: absolute;
+      top: -10px;
+      left: 0;
+      width: 100%;
+      height: 10px;
+    }
+
+    .details-tooltip::after {
+      content: '';
+      position: absolute;
+      bottom: 100%;
+      left: calc(50% - 6px);
+      border: 6px solid transparent;
+      border-bottom-color: var(--primary);
+    }
+
+    .details-tooltip strong {
+      display: block;
+      color: var(--accent);
+      margin-bottom: 4px;
+    }
+
+    .details:not([data-dismissed]):hover .details-tooltip,
+    .details:not([data-dismissed]):focus-within .details-tooltip {
+      visibility: visible;
+      opacity: 1;
+    }
+
