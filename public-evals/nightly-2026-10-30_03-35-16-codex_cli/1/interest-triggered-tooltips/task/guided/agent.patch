+  <script type="module">
+    // Load compatibility support only where the native APIs are missing.
+    if (!('popover' in HTMLElement.prototype)) {
+      await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+
+    // Older engines need explicit coordinates to keep popovers beside their links.
+    if (!CSS.supports('position-area', 'right')) {
+      const tooltips = document.querySelectorAll('.details-tooltip');
+      const positionTooltip = (tooltip) => {
+        const trigger = document.querySelector(`[interestfor="${tooltip.id}"]`);
+        const rect = trigger.getBoundingClientRect();
+        const gap = 8;
+        const edge = 12;
+        const width = tooltip.offsetWidth;
+        const height = tooltip.offsetHeight;
+        let left = rect.right + gap;
+        let top = rect.top + (rect.height - height) / 2;
+
+        if (left + width > window.innerWidth - edge) {
+          left = rect.left - width - gap;
+        }
+        if (left < edge) {
+          left = rect.left + (rect.width - width) / 2;
+          top = rect.top - height - gap;
+          if (top < edge) top = rect.bottom + gap;
+        }
+        tooltip.style.left = `${Math.max(edge, Math.min(left, window.innerWidth - width - edge))}px`;
+        tooltip.style.top = `${Math.max(edge, Math.min(top, window.innerHeight - height - edge))}px`;
+      };
+
+      tooltips.forEach((tooltip) => {
+        tooltip.addEventListener('toggle', (event) => {
+          if (event.newState === 'open') positionTooltip(tooltip);
+        });
+      });
+      const reposition = () => tooltips.forEach((tooltip) => {
+        if (tooltip.getClientRects().length) positionTooltip(tooltip);
+      });
+      window.addEventListener('resize', reposition);
+      window.addEventListener('scroll', reposition, { passive: true, capture: true });
+    }
+
+    if (!Object.hasOwn(HTMLButtonElement.prototype, 'interestForElement')) {
+      await import('https://unpkg.com/interestfor@latest');
+    }
+  </script>
