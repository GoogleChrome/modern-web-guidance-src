+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Daily coffee recommendation</title>
+  <style>
+    body { margin: 12px; font: 16px 'Segoe UI', sans-serif; color: #3e2723; }
+    button { padding: 10px 20px; border: 0; border-radius: 5px; background: #4e342e; color: white; font: inherit; cursor: pointer; }
+  </style>
+</head>
+<body>
+  <button type="button">Today's coffee pick</button>
+  <script>
+    // The sandbox makes this sender opaque. Only this document's parent may
+    // receive these non-sensitive messages; no wildcard target is needed.
+    const parentOrigin = new URL(document.referrer).origin;
+    parent.postMessage({ type: 'init' }, parentOrigin);
+    document.querySelector('button').addEventListener('click', () => {
+      parent.postMessage({ type: 'recommendation', message: 'Try our Maple Oat Latte today.' }, parentOrigin);
+    });
+  </script>
+</body>
+</html>
diff --git a/daily-grind.mjs b/daily-grind.mjs
new file mode 100644
index 0000000..138059e
--- /dev/null
+++ b/daily-grind.mjs
@@ -0,0 +1,45 @@
+import { createValidation } from './origin-validation.mjs';
+
+const validation = createValidation({ pageUrl: window.location.href });
+const widget = document.querySelector('#coffee-widget');
+const acceptsWidgetMessage = validation.pinWidget(widget.contentWindow);
+const status = document.querySelector('#order-status');
+
+function updateStatus(message) {
+  if (typeof message === 'string' && message.length <= 200) {
+    status.textContent = message;
+  }
+}
+
+window.addEventListener('message', (event) => {
+  if (!event.data || typeof event.data !== 'object') return;
+  if (acceptsWidgetMessage(event)) {
+    if (event.data.type === 'recommendation') updateStatus(event.data.message);
+    return;
+  }
+  if (!validation.isTrustedOrderingMessage(event)) return;
+  if (event.data.type === 'order-status') updateStatus(event.data.message);
+  if (event.data.type === 'redirect' && typeof event.data.url === 'string') {
+    const target = validation.sameSiteUrl(event.data.url);
+    if (target) window.location.assign(target.href);
+  }
+});
+
+function validateLink(link) {
+  const kind = validation.classifyLink(link);
+  link.dataset.site = kind;
+  if (kind === 'external') link.relList.add('external', 'noopener', 'noreferrer');
+  return kind !== 'invalid';
+}
+
+document.querySelectorAll('a[href]').forEach(validateLink);
+// Recheck at activation so changed or newly added URLs cannot bypass validation.
+for (const type of ['click', 'auxclick']) {
+  document.addEventListener(type, (event) => {
+    const link = event.target.closest?.('a[href]');
+    if (link && !validateLink(link)) event.preventDefault();
+  });
+}
+
+// Install the listener before loading the widget so its init cannot be missed.
+widget.src = './coffee-widget.html';
