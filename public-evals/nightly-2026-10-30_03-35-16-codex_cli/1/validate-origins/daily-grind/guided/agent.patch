diff --git a/origin-validation.mjs b/origin-validation.mjs
new file mode 100644
index 0000000..e0c8f5c
--- /dev/null
+++ b/origin-validation.mjs
@@ -0,0 +1,95 @@
+// Configure this fixed value for the deployed ordering service; never read it
+// from a message, query parameter, or iframe URL.
+export const ORDERING_ORIGIN = 'https://orders.dailygrind.example';
+
+export function createValidation({ pageUrl, orderingOrigin = ORDERING_ORIGIN,
+  OriginAPI = globalThis.Origin } = {}) {
+  const page = new URL(pageUrl);
+  const ordering = new URL(orderingOrigin);
+  const hasOriginAPI = typeof OriginAPI?.from === 'function';
+
+  function webUrl(candidate) {
+    const value = typeof candidate === 'string' ? candidate : candidate?.href;
+    if (typeof value !== 'string' || !value.trim()) throw new TypeError('Missing URL');
+    const url = new URL(value, page);
+    if ((url.protocol !== 'https:' && url.protocol !== 'http:') ||
+        url.username || url.password || url.origin === 'null') {
+      throw new TypeError('Unsafe navigation URL');
+    }
+    return url;
+  }
+
+  function messageOrigin(event) {
+    try {
+      return OriginAPI.from(event);
+    } catch {
+      // Synthetic MessageEvents have no underlying browser origin. Parsing
+      // their tuple origin is safe here, but never for opaque widget messages.
+      if (!(event instanceof MessageEvent)) throw new TypeError('Invalid event');
+      return OriginAPI.from(event.origin);
+    }
+  }
+
+  function isTrustedOrderingMessage(event) {
+    try {
+      if (ordering.protocol !== 'https:') return false;
+      if (hasOriginAPI) {
+        const sender = messageOrigin(event);
+        return !sender.opaque && sender.isSameOrigin(OriginAPI.from(ordering));
+      }
+      const sender = new URL(event.origin);
+      return sender.origin !== 'null' && sender.origin === ordering.origin;
+    } catch {
+      return false;
+    }
+  }
+
+  function sameSiteUrl(candidate) {
+    try {
+      const url = webUrl(candidate);
+      if (hasOriginAPI) {
+        const origin = OriginAPI.from(url);
+        if (origin.opaque || !origin.isSameSite(OriginAPI.from(page))) return null;
+      } else if (url.origin !== page.origin) {
+        // URL has no public suffix list. Fail closed to same-origin rather
+        // than guessing the registrable domain (co.uk, github.io, etc.).
+        return null;
+      }
+      return url;
+    } catch {
+      return null;
+    }
+  }
+
+  function classifyLink(candidate) {
+    try {
+      const url = webUrl(candidate);
+      return sameSiteUrl(url) ? 'internal' : 'external';
+    } catch {
+      return 'invalid';
+    }
+  }
+
+  function pinWidget(expectedWindow) {
+    let pinned = false;
+    let pinnedOrigin;
+    return function acceptsWidgetMessage(event) {
+      try {
+        if (!expectedWindow || event.source !== expectedWindow) return false;
+        // Do not fall back to the serialized "null" value when Origin exists.
+        const sender = hasOriginAPI ? OriginAPI.from(event) : null;
+        if (hasOriginAPI ? !sender.opaque : event.origin !== 'null') return false;
+        if (!pinned) {
+          if (event.data?.type !== 'init') return false;
+          pinnedOrigin = sender;
+          pinned = true;
+        }
+        return !hasOriginAPI || sender.isSameOrigin(pinnedOrigin);
+      } catch {
+        return false;
+      }
+    };
+  }
+
+  return { isTrustedOrderingMessage, sameSiteUrl, classifyLink, pinWidget };
+}
diff --git a/origin-validation.test.mjs b/origin-validation.test.mjs
new file mode 100644
index 0000000..2d2b64e
--- /dev/null
+++ b/origin-validation.test.mjs
@@ -0,0 +1,130 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { createValidation, ORDERING_ORIGIN } from './origin-validation.mjs';
+
+const pageUrl = 'https://www.dailygrind.co.uk/menu';
+const fallback = () => createValidation({ pageUrl, OriginAPI: null });
+
+test('ordering messages require an exact normalized origin', () => {
+  const check = fallback().isTrustedOrderingMessage;
+  assert.equal(check(new MessageEvent('message', { origin: ORDERING_ORIGIN })), true);
+  assert.equal(check(new MessageEvent('message', { origin: `${ORDERING_ORIGIN}:443` })), true);
+  for (const origin of [
+    'null', '', 'garbage', 'http://orders.dailygrind.example',
+    'https://orders.dailygrind.example:8443',
+    'https://orders.dailygrind.example.attacker.test',
+    'https://orders.dailygrind.example@attacker.test',
+    'https://blog.dailygrind.example',
+  ]) assert.equal(check(new MessageEvent('message', { origin })), false, origin);
+});
+
+test('fallback redirects normalize relative URLs and fail closed across origins', () => {
+  const check = fallback().sameSiteUrl;
+  assert.equal(check('/account').href, 'https://www.dailygrind.co.uk/account');
+  assert.equal(check('https://WWW.dailygrind.co.uk:443/account').href,
+    'https://www.dailygrind.co.uk/account');
+  for (const candidate of [
+    '', null, {}, 'https://[', 'javascript:alert(1)', 'data:text/html,hello',
+    'blob:https://www.dailygrind.co.uk/id', '//attacker.test/path',
+    'https://www.dailygrind.co.uk.attacker.test',
+    'https://www.dailygrind.co.uk@attacker.test',
+    'https://user:password@www.dailygrind.co.uk',
+    'http://www.dailygrind.co.uk', 'https://other.co.uk',
+    'https://billing.dailygrind.co.uk', 'https://www.dailygrind.co.uk:8443',
+    '/\\attacker.test/path',
+  ]) assert.equal(check(candidate), null, String(candidate));
+});
+
+test('links accept URL and anchor-like objects and distinguish invalid schemes', () => {
+  const check = fallback().classifyLink;
+  assert.equal(check({ href: 'https://www.dailygrind.co.uk/menu' }), 'internal');
+  assert.equal(check(new URL('https://external.test')), 'external');
+  assert.equal(check('https://www.dailygrind.co.uk.attacker.test'), 'external');
+  assert.equal(check('javascript:alert(1)'), 'invalid');
+});
+
+test('fallback widget pins only an init from the expected opaque window', () => {
+  const expected = {};
+  const check = fallback().pinWidget(expected);
+  const event = (source, type, origin = 'null') => ({ source, data: { type }, origin });
+  assert.equal(check(event({}, 'init')), false);
+  assert.equal(check(event(expected, 'recommendation')), false);
+  assert.equal(check(event(expected, 'init', pageUrl)), false);
+  assert.equal(check(event(expected, 'init')), true);
+  assert.equal(check(event(expected, 'recommendation')), true);
+  assert.equal(check(event({}, 'init')), false);
+  assert.equal(check(event({}, 'recommendation')), false);
+  assert.equal(fallback().pinWidget(null)({ source: null, origin: 'null', data: { type: 'init' } }), false);
+});
+
+// Contract double: Node has no browser Origin API. Explicit site fixtures test
+// delegation to isSameSite, not a home-grown public suffix implementation.
+class TestOrigin {
+  static events = new WeakMap();
+  static sites = new Map([
+    ['www.dailygrind.co.uk', 'dailygrind.co.uk'],
+    ['billing.dailygrind.co.uk', 'dailygrind.co.uk'],
+    ['attacker.co.uk', 'attacker.co.uk'],
+    ['tenant-a.github.io', 'tenant-a.github.io'],
+    ['tenant-b.github.io', 'tenant-b.github.io'],
+  ]);
+  constructor(url) {
+    this.url = url;
+    this.opaque = !url;
+  }
+  static from(value) {
+    if (this.events.has(value)) return this.events.get(value);
+    if (typeof value !== 'string' && !(value instanceof URL)) throw new TypeError();
+    const url = new URL(value);
+    return new TestOrigin(url.origin === 'null' ? undefined : url);
+  }
+  isSameOrigin(other) {
+    return this.opaque || other.opaque ? this === other : this.url.origin === other.url.origin;
+  }
+  isSameSite(other) {
+    if (this.opaque || other.opaque) return false;
+    return this.url.protocol === other.url.protocol &&
+      (TestOrigin.sites.get(this.url.hostname) ?? this.url.hostname) ===
+      (TestOrigin.sites.get(other.url.hostname) ?? other.url.hostname);
+  }
+}
+
+test('native path delegates schemeful site comparisons including public suffix boundaries', () => {
+  const check = createValidation({ pageUrl, OriginAPI: TestOrigin }).sameSiteUrl;
+  assert.ok(check('https://billing.dailygrind.co.uk:8443/checkout'));
+  assert.equal(check('http://billing.dailygrind.co.uk'), null);
+  assert.equal(check('https://attacker.co.uk'), null);
+  const tenant = createValidation({ pageUrl: 'https://tenant-a.github.io', OriginAPI: TestOrigin });
+  assert.equal(tenant.sameSiteUrl('https://tenant-b.github.io'), null);
+});
+
+test('native ordering handles synthetic tuple events but rejects serialized opaque origins', () => {
+  const check = createValidation({ pageUrl, OriginAPI: TestOrigin }).isTrustedOrderingMessage;
+  assert.equal(check(new MessageEvent('message', { origin: ORDERING_ORIGIN })), true);
+  assert.equal(check(new MessageEvent('message', { origin: 'null' })), false);
+  const opaqueEvent = {};
+  TestOrigin.events.set(opaqueEvent, new TestOrigin());
+  assert.equal(check(opaqueEvent), false);
+});
+
+test('native widget pins opaque identity once and rejects other origins even with the same source', () => {
+  const expected = {};
+  const widgetOrigin = new TestOrigin();
+  const attackerOrigin = new TestOrigin();
+  const check = createValidation({ pageUrl, OriginAPI: TestOrigin }).pinWidget(expected);
+  const event = (source, type, origin) => {
+    const value = { source, data: { type }, origin: 'null' };
+    TestOrigin.events.set(value, origin);
+    return value;
+  };
+  assert.equal(check(event({}, 'init', attackerOrigin)), false);
+  assert.equal(check(event(expected, 'recommendation', widgetOrigin)), false);
+  assert.equal(check(event(expected, 'init', TestOrigin.from(pageUrl))), false);
+  assert.equal(check(event(expected, 'init', widgetOrigin)), true);
+  assert.equal(check(event(expected, 'recommendation', widgetOrigin)), true);
+  assert.equal(check(event({}, 'recommendation', attackerOrigin)), false);
+  assert.equal(check(event(expected, 'init', attackerOrigin)), false);
+  assert.equal(check(event(expected, 'recommendation', attackerOrigin)), false);
+  assert.equal(check({ source: expected, origin: 'null', data: { type: 'init' } }), false);
+  assert.equal(check(event(expected, 'recommendation', widgetOrigin)), true);
+});
