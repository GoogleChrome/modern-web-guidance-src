+  <script>
+    const themeSwitch = document.getElementById('dark-mode');
+    const switchState = document.querySelector('.switch-state');
+    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
+    let savedTheme = null;
+
+    try {
+      savedTheme = localStorage.getItem('daily-grind-theme');
+    } catch {
+      // The switch still works when browser storage is unavailable.
+    }
+
+    function applyTheme(dark) {
+      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
+      themeSwitch.checked = dark;
+      switchState.textContent = dark ? 'On' : 'Off';
+    }
+
+    applyTheme(savedTheme === 'dark' || (savedTheme !== 'light' && systemTheme.matches));
+
+    themeSwitch.addEventListener('change', () => {
+      savedTheme = themeSwitch.checked ? 'dark' : 'light';
+      applyTheme(themeSwitch.checked);
+      try {
+        localStorage.setItem('daily-grind-theme', savedTheme);
+      } catch {
+        // Keep the current preference for this visit.
+      }
+    });
+
+    systemTheme.addEventListener('change', (event) => {
+      if (savedTheme !== 'dark' && savedTheme !== 'light') applyTheme(event.matches);
+    });
+  </script>
+
