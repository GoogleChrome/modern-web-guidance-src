+  <script>
+    const themeSelect = document.getElementById('theme-select');
+    themeSelect.value = document.documentElement.style.colorScheme || 'system';
+
+    themeSelect.addEventListener('change', () => {
+      const theme = themeSelect.value;
+      if (theme === 'system') {
+        document.documentElement.style.removeProperty('color-scheme');
+      } else {
+        document.documentElement.style.colorScheme = theme;
+      }
+      try {
+        localStorage.setItem('daily-grind-theme', theme);
+      } catch { /* Storage is optional; the current selection is already applied. */ }
+    });
+
+    document.getElementById('special-select').addEventListener('change', (event) => {
+      document.querySelectorAll('#specials-list .special').forEach((special) => {
+        special.hidden = event.target.value !== 'all' && special.dataset.category !== event.target.value;
+      });
+      document.getElementById('specials-list').scrollTop = 0;
+    });
+  </script>
+
