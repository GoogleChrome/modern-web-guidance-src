+  <script>
+    const promoContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const busyCards = new WeakSet();
+    let promoCount = 0;
+
+    function updateControls() {
+      const lastCard = promoContainer.lastElementChild;
+      removeBtn.disabled = !lastCard || busyCards.has(lastCard);
+      toggleBtn.disabled = !promoContainer.contains(toggleCard) || busyCards.has(toggleCard);
+      toggleBtn.setAttribute('aria-expanded', String(!toggleCard.hidden && toggleCard.isConnected));
+      toggleBtn.textContent = toggleCard.hidden ? 'Show featured promo' : 'Hide featured promo';
+    }
+
+    async function animateCard(card, entering) {
+      busyCards.add(card);
+      updateControls();
+      const frames = [
+        { opacity: 0, transform: 'scale(0.92)' },
+        { opacity: 1, transform: 'scale(1)' }
+      ];
+      try {
+        await card.animate(entering ? frames : [...frames].reverse(), {
+          duration: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 300,
+          easing: 'ease-in-out',
+          fill: 'forwards'
+        }).finished;
+      } finally {
+        busyCards.delete(card);
+      }
+    }
+
+    addBtn.addEventListener('click', async () => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = `Coffee Break Special ${++promoCount}`;
+      const description = document.createElement('p');
+      description.textContent = 'Explore a new roast, revisit your favorite blend, and make time for a delicious break.';
+      card.append(heading, description);
+      promoContainer.append(card);
+      await animateCard(card, true);
+      card.getAnimations().forEach(animation => animation.cancel());
+      updateControls();
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const card = promoContainer.lastElementChild;
+      if (!card || busyCards.has(card)) return;
+      if (!card.hidden) await animateCard(card, false);
+      card.remove();
+      updateControls();
+    });
+
+    toggleBtn.addEventListener('click', async () => {
+      if (!promoContainer.contains(toggleCard) || busyCards.has(toggleCard)) return;
+      const showing = toggleCard.hidden;
+      if (showing) toggleCard.hidden = false;
+      await animateCard(toggleCard, showing);
+      if (!showing) toggleCard.hidden = true;
+      toggleCard.getAnimations().forEach(animation => animation.cancel());
+      updateControls();
+    });
+
+    updateControls();
+  </script>
+
 </body>
 
