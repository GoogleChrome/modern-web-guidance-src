+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const pendingExits = new WeakMap();
+    let promoNumber = 1;
+
+    function updateControls() {
+      removeBtn.disabled = !domContainer.querySelector('.card:not([data-removing])');
+      toggleBtn.disabled = !toggleCard.isConnected || toggleCard.hasAttribute('data-removing');
+    }
+
+    function showCard(card) {
+      pendingExits.delete(card);
+      card.removeAttribute('data-closing');
+      card.hidden = false;
+      // Older browsers without @starting-style still get an entry animation.
+      if (!('CSSStartingStyleRule' in window)) {
+        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+        card.animate([
+          { opacity: 0, transform: reducedMotion ? 'none' : 'scale(0.94)' },
+          { opacity: 1, transform: 'scale(1)' }
+        ], { duration: reducedMotion ? 100 : 280, easing: 'ease' });
+      }
+    }
+
+    async function hideCard(card) {
+      const exit = {};
+      pendingExits.set(card, exit);
+      // Stage the exit before setting hidden so browsers without discrete
+      // display transitions also finish the fade and scale before hiding.
+      card.setAttribute('data-closing', '');
+      const animations = card.getAnimations();
+      let timeout;
+      await Promise.race([
+        Promise.allSettled(animations.map(animation => animation.finished)),
+        new Promise(resolve => { timeout = setTimeout(resolve, 1000); })
+      ]);
+      clearTimeout(timeout);
+      if (pendingExits.get(card) === exit) {
+        pendingExits.delete(card);
+        card.hidden = true;
+        card.removeAttribute('data-closing');
+      }
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('div');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = `Coffee Break Special ${promoNumber++}`;
+      const description = document.createElement('p');
+      description.textContent = 'Pair your favorite coffee with a fresh pastry for a delicious afternoon treat.';
+      card.append(heading, description);
+      domContainer.append(card);
+      showCard(card);
+      updateControls();
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const cards = domContainer.querySelectorAll('.card:not([data-removing])');
+      const card = cards[cards.length - 1];
+      if (!card) return;
+      card.setAttribute('data-removing', '');
+      updateControls();
+      await hideCard(card);
+      card.remove();
+      updateControls();
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      if (!toggleCard.isConnected || toggleCard.hasAttribute('data-removing')) return;
+      const show = toggleCard.hidden || toggleCard.hasAttribute('data-closing');
+      if (show) showCard(toggleCard);
+      else hideCard(toggleCard);
+      toggleBtn.setAttribute('aria-expanded', String(show));
+      toggleBtn.textContent = show ? 'Hide Default Promo' : 'Show Default Promo';
+    });
+  </script>
+
