       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    .card.spring {
+      transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    .card.bounce {
+      transition: transform 0.75s cubic-bezier(0.34, 1.4, 0.64, 1);
+    }
+
+    /* Damped spring and successive bounce impacts, with cubic fallbacks above. */
+    @supports (transition-timing-function: linear(0, 1)) {
+      .card.spring {
+        transition-timing-function: linear(
+          0, 0.45 12%, 0.9 24%, 1.16 38%, 1.08 52%,
+          0.97 68%, 1.015 84%, 1
+        );
+      }
+
+      .card.bounce {
+        transition-timing-function: linear(
+          0, 0.06 9%, 0.25 18%, 0.56 27%, 1 36%,
+          0.75 54%, 1 73%, 0.94 82%, 1 91%, 0.985 95%, 1
+        );
+      }
+    }
+
+    .card.spring:hover,
+    .card.spring:focus-within {
+      transform: scale(1.04);
+    }
+
+    .card.bounce:hover,
+    .card.bounce:focus-within {
+      transform: translateY(-8px);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card.spring,
+      .card.bounce,
+      .card.spring:is(:hover, :focus-within),
+      .card.bounce:is(:hover, :focus-within) {
+        transition: none;
+        transform: none;
+      }
+
+      .card.spring .btn,
+      .card.bounce .btn {
+        transition: none;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
