+          0.956 88%, 0.993 95.5%, 1
+        );
+        transform-origin: center bottom;
+      }
+
+      .spring:is(:hover, :focus-within) {
+        transform: scale(1.04);
+      }
+
+      .bounce:is(:hover, :focus-within) {
+        transform: translateY(-8px) scale(1.03);
+      }
+    }
