+
+      .bounce {
+        /* Successively smaller rebounds mimic a physical bounce. */
+        transition: transform 0.7s ease-out;
+        transition-timing-function: linear(
+          0, 0.214 14.7%, 0.386 23.7%, 0.598 31.9%, 0.999 44.7%,
