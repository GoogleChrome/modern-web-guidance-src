+    .card:nth-child(2) .line-ink { animation-delay: 300ms; }
+    .card:nth-child(3) .text-line { --line-style: wavy; --line-weight: 1px; }
+    .card:nth-child(3) .line-ink { animation-delay: 450ms; }
+
+    @keyframes reveal-line {
+      from { clip-path: inset(-0.5em 100% -0.7em var(--line-inset-start)); }
