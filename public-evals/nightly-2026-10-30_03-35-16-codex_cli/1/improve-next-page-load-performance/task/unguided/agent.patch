+  <script>
+    (() => {
+      const prefetched = new Set();
+      const connection = navigator.connection;
+
+      // Avoid speculative requests when the user is conserving data.
+      if (connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType || '')) return;
+
+      function prefetchPage(event) {
+        const anchor = event.target.closest('a[data-prefetch="true"]');
+        if (!anchor || anchor.hasAttribute('download') ||
+            (anchor.target && anchor.target !== '_self')) return;
+
+        let url;
+        try {
+          url = new URL(anchor.href, window.location.href);
+        } catch {
+          return;
+        }
+
+        if (!['http:', 'https:'].includes(url.protocol) ||
+            url.origin !== window.location.origin) return;
+
+        // Fragments do not identify a separate document to fetch.
+        url.hash = '';
+        const currentPage = new URL(window.location.href);
+        currentPage.hash = '';
+        if (url.href === currentPage.href || prefetched.has(url.href)) return;
+
+        prefetched.add(url.href);
+        const hint = document.createElement('link');
+        hint.rel = 'prefetch';
+        hint.as = 'document';
+        hint.href = url.href;
+        document.head.appendChild(hint);
+      }
+
+      document.addEventListener('pointerover', prefetchPage);
+      document.addEventListener('focusin', prefetchPage);
+    })();
+  </script>
