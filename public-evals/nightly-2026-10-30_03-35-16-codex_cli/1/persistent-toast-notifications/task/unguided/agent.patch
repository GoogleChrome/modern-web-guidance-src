+    /* Each manual popover is an independent, non-modal top-layer element.
+       Toasts are appended last in body, so the sibling difference counts
+       only newer toasts, regardless of the page content before them. */
+    .toast {
+      --toast-height: 4.5rem;
+      --toast-gap: 0.75rem;
+      position: fixed;
+      inset: auto 1rem calc(1rem + (sibling-count() - sibling-index()) * (var(--toast-height) + var(--toast-gap))) auto;
+      margin: 0;
+      width: min(22rem, calc(100vw - 2rem));
+      height: var(--toast-height);
+      padding: 1rem;
+      border: 1px solid var(--secondary);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(0 0 0 / 20%);
+      align-items: center;
+      justify-content: space-between;
+      gap: 1rem;
+      font: inherit;
+      opacity: 0;
+      translate: 1rem 0;
+      transition: opacity 200ms ease, translate 200ms ease, bottom 200ms ease,
+        display 200ms allow-discrete, overlay 200ms allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      opacity: 1;
+      translate: 0 0;
+    }
+
+    .toast::backdrop {
+      background: transparent;
+      pointer-events: none;
+    }
+
+    .toast:not(:popover-open) {
+      pointer-events: none;
+    }
+
+    .toast-close {
+      flex-shrink: 0;
+      width: 2.5rem;
+      height: 2.5rem;
+      border: 0;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font: inherit;
+      font-size: 1.5rem;
+      cursor: pointer;
+    }
+
+    .toast-close:hover {
+      background: rgb(255 255 255 / 15%);
+    }
+
+    .toast-trigger:focus-visible,
+    .toast-close:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        translate: 1rem 0;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transition-duration: 0s;
+      }
+    }
