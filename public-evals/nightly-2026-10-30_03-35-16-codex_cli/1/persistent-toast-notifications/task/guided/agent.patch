+    /* Each toast is an independent native top-layer element, not a stack wrapper.
+       Toasts are prepended to body, so their sibling indices always start at 1. */
+    .toast {
+      --toast-height: 4rem;
+      --toast-gap: 0.75rem;
+      position: fixed;
+      inset: auto 1rem 1rem auto;
+      bottom: calc(1rem + (sibling-index() - 1) * (var(--toast-height) + var(--toast-gap)));
+      margin: 0;
+      width: min(20rem, calc(100vw - 2rem));
+      height: var(--toast-height);
+      padding: 0.5rem 0.75rem 0.5rem 1rem;
+      border: 1px solid var(--secondary);
+      border-inline-start: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 4px 18px rgb(0 0 0 / 0.2);
+      align-items: center;
+      justify-content: space-between;
+      gap: 1rem;
+      opacity: 0;
+      transform: translateX(1.5rem);
+      transition: opacity 200ms ease, transform 200ms ease, bottom 200ms ease,
+        display 200ms allow-discrete, overlay 200ms allow-discrete;
+      pointer-events: none;
+    }
+
+    .toast:popover-open {
+      display: flex;
+    }
+
+    .toast:popover-open:not([data-closing]) {
+      opacity: 1;
+      transform: translateX(0);
+    }
+
+    @starting-style {
+      .toast:popover-open:not([data-closing]) {
+        opacity: 0;
+        transform: translateX(1.5rem);
+      }
+    }
+
+    .toast::backdrop {
+      background: transparent;
+      pointer-events: none;
+    }
+
+    .toast-close {
+      flex: none;
+      width: 2.75rem;
+      height: 2.75rem;
+      border: 0;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font: inherit;
+      font-size: 1.5rem;
+      cursor: pointer;
+      pointer-events: auto;
+    }
+
+    .toast-close:hover {
