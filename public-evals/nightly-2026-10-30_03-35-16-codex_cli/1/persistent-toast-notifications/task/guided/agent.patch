+  <template id="toast-template">
+    <div class="toast" popover="manual">
+      <span role="status" aria-atomic="true"></span>
+      <button type="button" class="toast-close" aria-label="Close notification">&times;</button>
+    </div>
+  </template>
+
+  <script>
+    const toastTemplate = document.getElementById('toast-template');
+
+    function showToast(trigger) {
+      const toast = toastTemplate.content.firstElementChild.cloneNode(true);
+      const closeButton = toast.querySelector('.toast-close');
+      let dismissTimer;
+
+      async function dismissToast() {
+        if (toast.hasAttribute('data-closing')) return;
+        clearTimeout(dismissTimer);
+        // Keep the popover in the top layer until its exit animation completes.
+        // This also supports browsers without discrete display/overlay transitions.
+        toast.setAttribute('data-closing', '');
+        if (toast.contains(document.activeElement)) trigger.focus();
+        closeButton.disabled = true;
+        await Promise.allSettled(toast.getAnimations().map(animation => animation.finished));
+        toast.hidePopover();
+        toast.remove();
+      }
+
+      closeButton.addEventListener('click', dismissToast);
+      // No wrapper, position measurements, or JS stack indices are needed.
+      document.body.prepend(toast);
+      toast.showPopover();
+      requestAnimationFrame(() => {
+        if (toast.isConnected) toast.querySelector('[role="status"]').textContent = 'added to cart!';
+      });
+      dismissTimer = setTimeout(dismissToast, 3000);
+    }
+
+    document.querySelectorAll('button.toast-trigger').forEach(trigger => {
+      trigger.addEventListener('click', () => showToast(trigger));
+    });
+  </script>
+
