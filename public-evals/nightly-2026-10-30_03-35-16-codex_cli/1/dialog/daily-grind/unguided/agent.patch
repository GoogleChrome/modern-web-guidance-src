+  <dialog id="drink-dialog" class="drink-dialog" aria-labelledby="drink-title" aria-describedby="drink-description" closedby="any">
+    <div class="dialog-header">
+      <h2 id="drink-title" tabindex="-1" autofocus>Drink details</h2>
+      <button type="button" class="dialog-close" id="close-drink-dialog" aria-label="Close drink details">Close</button>
+    </div>
+    <p id="drink-description"></p>
+    <form action="/order-online" method="get">
+      <label for="drink-choice">Drink</label>
+      <select id="drink-choice" name="drink" required>
+        <option value="maple-oat-latte">Maple Oat Latte</option>
+        <option value="dark-roast-espresso">Dark Roast Espresso</option>
+        <option value="cold-brew">Cold Brew</option>
+      </select>
+      <label for="drink-size">Size</label>
+      <select id="drink-size" name="size" required></select>
+      <label for="drink-quantity">Quantity</label>
+      <input id="drink-quantity" name="quantity" type="number" min="1" max="10" step="1" value="1" required>
+      <p style="margin-top: 1rem;">Review pricing and pickup or delivery options at checkout.</p>
+      <button type="submit" class="btn">Continue to checkout</button>
+    </form>
+  </dialog>
+
+  <script>
+    const drinks = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        sizes: ['Small', 'Medium', 'Large']
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        sizes: ['Single shot', 'Double shot']
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        sizes: ['Small', 'Medium', 'Large']
+      }
+    };
+
+    const dialog = document.getElementById('drink-dialog');
+    const title = document.getElementById('drink-title');
+    const description = document.getElementById('drink-description');
+    const drinkChoice = document.getElementById('drink-choice');
+    const sizeChoice = document.getElementById('drink-size');
+    const quantity = document.getElementById('drink-quantity');
+    let opener;
+    let ordering = false;
+
+    function updateDrink() {
+      const drink = drinks[drinkChoice.value];
+      title.textContent = ordering ? 'Order your coffee' : drink.name;
+      description.textContent = drink.description;
+      sizeChoice.replaceChildren(...drink.sizes.map(size => new Option(size, size)));
+    }
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        opener = button;
+        ordering = button.hasAttribute('data-order');
+        drinkChoice.value = button.dataset.drink;
+        quantity.value = '1';
+        updateDrink();
+        dialog.showModal();
+        title.focus();
+      });
+    });
+
+    drinkChoice.addEventListener('change', updateDrink);
+    document.getElementById('close-drink-dialog').addEventListener('click', () => dialog.close());
+    dialog.addEventListener('close', () => {
+      if (opener && opener.isConnected) opener.focus();
+    });
+
+    // Support backdrop dismissal in browsers without closedby="any".
+    // Both ends of the gesture must be outside, so dragging from a control stays safe.
+    function isBackdrop(event) {
+      if (event.target !== dialog) return false;
+      const bounds = dialog.getBoundingClientRect();
+      return event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom;
+    }
+
+    let startedOnBackdrop = false;
+    dialog.addEventListener('pointerdown', event => {
+      startedOnBackdrop = isBackdrop(event);
+    });
+    dialog.addEventListener('click', event => {
+      if (startedOnBackdrop && isBackdrop(event)) dialog.close();
+      startedOnBackdrop = false;
+    });
+    dialog.addEventListener('pointercancel', () => { startedOnBackdrop = false; });
+    // Native dialog cancellation handles Escape and platform close requests.
+  </script>
+
