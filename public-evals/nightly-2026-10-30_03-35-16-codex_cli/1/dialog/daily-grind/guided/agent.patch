+  <script>
+    const drinks = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        sizes: ['Small (8 oz)', 'Medium (12 oz)', 'Large (16 oz)']
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        sizes: ['Single shot', 'Double shot']
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness. Served over ice.',
+        sizes: ['Small (12 oz)', 'Medium (16 oz)', 'Large (20 oz)']
+      }
+    };
+
+    const drinkDialog = document.getElementById('drink-dialog');
+    const drinkChoice = document.getElementById('drink-choice');
+    const drinkSize = document.getElementById('drink-size');
+
+    function updateDrink() {
+      const drink = drinks[drinkChoice.value];
+      document.getElementById('drink-name').textContent = drink.name;
+      document.getElementById('drink-description').textContent = drink.description;
+      drinkSize.replaceChildren(...drink.sizes.map(size => new Option(size, size)));
+    }
+
+    drinkChoice.addEventListener('change', updateDrink);
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        drinkChoice.value = button.dataset.drink;
+        document.getElementById('drink-quantity').value = '1';
+        updateDrink();
+        // Some browsers do not focus buttons on pointer activation. Establish the
+        // invoker so the native dialog can restore focus to it on every close path.
+        button.focus();
+        drinkDialog.showModal();
+      });
+    });
+
+    // Preserve backdrop dismissal on browsers without closedby support. Both
+    // ends of the pointer gesture must be outside, so dragging text stays safe.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      let outsidePointer = null;
+      const isOutside = event => {
+        const rect = drinkDialog.getBoundingClientRect();
+        return event.clientX < rect.left || event.clientX > rect.right ||
+          event.clientY < rect.top || event.clientY > rect.bottom;
+      };
+
+      drinkDialog.addEventListener('pointerdown', event => {
+        outsidePointer = event.isPrimary && event.button === 0 && isOutside(event)
+          ? event.pointerId : null;
+      });
+      drinkDialog.addEventListener('pointerup', event => {
+        if (outsidePointer === event.pointerId && isOutside(event)) {
+          drinkDialog.close();
+        }
+        outsidePointer = null;
+      });
+      drinkDialog.addEventListener('pointercancel', () => { outsidePointer = null; });
+      drinkDialog.addEventListener('close', () => { outsidePointer = null; });
+    }
+  </script>
+
