+  <script>
+    (() => {
+      const button = document.querySelector('[data-testid="register-button"]');
+      const status = document.getElementById('registration-status');
+      let registering = false;
+
+      function decodeBase64url(value) {
+        if (typeof value !== 'string' || !/^[A-Za-z0-9_-]+$/.test(value) || value.length % 4 === 1) {
+          throw new Error('Invalid registration options. Please try again.');
+        }
+        const binary = atob(value.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - value.length % 4) % 4));
+        return Uint8Array.from(binary, character => character.charCodeAt(0));
+      }
+
+      function encodeBase64url(value) {
+        const bytes = value instanceof ArrayBuffer
+          ? new Uint8Array(value)
+          : new Uint8Array(value.buffer, value.byteOffset, value.byteLength);
+        let binary = '';
+        for (const byte of bytes) binary += String.fromCharCode(byte);
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function creationOptions(options) {
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseCreationOptionsFromJSON(options);
+        }
+        // Compatibility for browsers without the WebAuthn JSON helpers.
+        const publicKey = {
+          ...options,
+          challenge: decodeBase64url(options.challenge),
+          user: { ...options.user, id: decodeBase64url(options.user.id) }
+        };
+        if (options.excludeCredentials) {
+          publicKey.excludeCredentials = options.excludeCredentials.map(credential => ({
+            ...credential, id: decodeBase64url(credential.id)
+          }));
+        }
+        if (options.extensions) {
+          publicKey.extensions = { ...options.extensions };
+          if (options.extensions.credBlob) {
+            publicKey.extensions.credBlob = decodeBase64url(options.extensions.credBlob);
+          }
+          if (options.extensions.prf) {
+            // PRF inputs may contain additional binary values; use a browser
+            // with the native parser rather than silently changing these inputs.
+            throw new Error('Please update your browser to create this passkey.');
+          }
+        }
+        return publicKey;
+      }
+
+      function jsonBuffers(value) {
+        if (value instanceof ArrayBuffer || ArrayBuffer.isView(value)) return encodeBase64url(value);
+        if (Array.isArray(value)) return value.map(jsonBuffers);
+        if (value && typeof value === 'object') {
+          return Object.fromEntries(Object.entries(value).map(([key, entry]) => [key, jsonBuffers(entry)]));
+        }
+        return value;
+      }
+
+      function registrationJSON(credential) {
+        if (typeof credential.toJSON === 'function') return credential.toJSON();
+        return {
+          id: credential.id,
+          rawId: encodeBase64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment,
+          response: {
+            clientDataJSON: encodeBase64url(credential.response.clientDataJSON),
+            attestationObject: encodeBase64url(credential.response.attestationObject),
+            transports: credential.response.getTransports?.() || []
+          },
+          clientExtensionResults: jsonBuffers(credential.getClientExtensionResults())
+        };
+      }
+
+      async function postJSON(url, body) {
+        const response = await fetch(url, {
+          method: 'POST',
+          mode: 'same-origin',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          redirect: 'error',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(body)
+        });
+        if (!response.ok) throw new Error('Registration could not be completed. Please try again.');
+        return response.json();
+      }
+
+      button.addEventListener('click', async () => {
+        if (registering) return;
+        registering = true;
+        button.disabled = true;
+        button.setAttribute('aria-busy', 'true');
+        status.textContent = 'Preparing your passkey…';
+
+        try {
+          if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.create) {
+            throw new Error('Passkeys require a supported browser and a secure HTTPS connection.');
+          }
+          const options = await postJSON('/api/register/options', { promotion: true });
+          const publicKey = creationOptions(options.publicKey ?? options);
+          status.textContent = 'Follow your device’s instructions to create a passkey.';
+          const credential = await navigator.credentials.create({ publicKey });
+          if (!credential || credential.type !== 'public-key') {
+            throw new Error('No passkey was created. Please try again.');
+          }
+          status.textContent = 'Verifying your passkey…';
+          // The server must bind the challenge to the signed-in session and
+          // validate the origin, RP ID, attestation and required user verification.
+          const result = await postJSON('/api/register/verify', registrationJSON(credential));
+          if (result.verified !== true) {
+            throw new Error('Your passkey could not be verified. Please try again.');
+          }
+          status.textContent = 'Passkey created successfully.';
+        } catch (error) {
+          if (error.name === 'NotAllowedError' || error.name === 'AbortError') {
+            status.textContent = 'Passkey creation was canceled or timed out. You can try again.';
+          } else if (error.name === 'InvalidStateError') {
+            status.textContent = 'A passkey for this account already exists on this authenticator.';
+          } else {
+            status.textContent = error instanceof Error && error.name === 'Error'
+              ? error.message
+              : 'Unable to create a passkey. Please try again.';
+          }
+        } finally {
+          registering = false;
+          button.disabled = false;
+          button.removeAttribute('aria-busy');
+        }
+      });
+    })();
+  </script>
+
 </body>
 
