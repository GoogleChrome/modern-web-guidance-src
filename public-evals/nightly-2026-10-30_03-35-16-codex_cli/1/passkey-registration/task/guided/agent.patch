+  <script type="module">
+    import './assets/webauthn-polyfills.js';
+
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const registerStatus = document.getElementById('register-status');
+    let supported = false;
+    let registering = false;
+    let registered = false;
+
+    async function checkPasskeySupport() {
+      if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.create) {
+        registerStatus.textContent = 'Passkey creation requires a supported browser and a secure connection.';
+        return;
+      }
+
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        supported = Boolean(capabilities.conditionalGet && capabilities.passkeyPlatformAuthenticator);
+        registerButton.disabled = !supported;
+        registerStatus.textContent = supported
+          ? 'Your device supports passkeys.'
+          : 'Passkey creation is unavailable on this device. You can continue using your current sign-in method.';
+      } catch {
+        registerStatus.textContent = 'Unable to check passkey support. Reload the page to try again.';
+      }
+    }
+
+    async function postJSON(url, body) {
+      // Keep both requests bound to the signed-in session; never cache challenges.
+      const response = await fetch(url, {
+        method: 'POST',
+        credentials: 'same-origin',
+        mode: 'same-origin',
+        cache: 'no-store',
+        redirect: 'error',
+        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+        body: JSON.stringify(body),
+      });
+      if (!response.ok) throw new Error('Registration request failed.');
+      return response.json();
+    }
+
+    async function signalFailedRegistration(rpId, credentialId) {
+      if (typeof PublicKeyCredential.signalUnknownCredential !== 'function') return;
+      try {
+        await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+      } catch {
+        // Optional password-manager synchronization must not hide the original error.
+      }
+    }
+
+    registerButton.addEventListener('click', async () => {
+      if (!supported || registering || registered) return;
+      registering = true;
+      registerButton.disabled = true;
+      registerButton.setAttribute('aria-busy', 'true');
+      registerStatus.textContent = 'Preparing your passkey…';
+
+      try {
+        const options = await postJSON('/api/register/options', { promotion: true });
+        // Preserve the server's challenge, RP, user, exclusions, and verification policy.
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+        registerStatus.textContent = 'Follow your device’s instructions to create a passkey.';
+        const credential = await navigator.credentials.create({ publicKey });
+        if (!credential || credential.type !== 'public-key') {
+          throw new Error('No passkey was created.');
+        }
+        const encodedResponse = credential.toJSON();
+
+        registerStatus.textContent = 'Verifying your passkey…';
+        try {
+          const result = await postJSON('/api/register/verify', encodedResponse);
+          // Creation alone is not success: only the server can validate registration.
+          if (result?.verified !== true) throw new Error('Registration was not verified.');
+        } catch {
+          await signalFailedRegistration(publicKey.rp.id || window.location.hostname, encodedResponse.id);
+          registerStatus.textContent = 'We could not verify your passkey. Please try again.';
+          return;
+        }
+
+        registered = true;
+        registerStatus.textContent = 'Your passkey was created successfully.';
+      } catch (error) {
+        const messages = {
+          InvalidStateError: 'A passkey already exists for this account on this authenticator.',
+          NotAllowedError: 'Passkey creation was cancelled or timed out. You can try again.',
+          AbortError: 'Passkey creation was interrupted. You can try again.',
+          SecurityError: 'Passkey creation is unavailable because of a secure connection or domain configuration issue.',
+        };
+        registerStatus.textContent = messages[error?.name] || 'Unable to create a passkey. Please try again.';
+      } finally {
+        registering = false;
+        registerButton.removeAttribute('aria-busy');
+        registerButton.disabled = registered || !supported;
+      }
+    });
+
+    checkPasskeySupport();
+  </script>
+
 </body>
 
