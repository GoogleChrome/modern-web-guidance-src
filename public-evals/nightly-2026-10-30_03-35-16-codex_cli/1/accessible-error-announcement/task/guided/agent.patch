+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterError = document.getElementById('newsletter-error');
+    const newsletterStatus = document.getElementById('newsletter-status');
+    let validationFrame;
+
+    function syncNewsletterError() {
+      // Use the same post-interaction state as the visual field styling.
+      const showError = newsletterEmail.matches(':user-invalid');
+      const message = showError ? 'Please enter a valid email address.' : '';
+
+      newsletterEmail.setAttribute('aria-invalid', String(showError));
+      if (showError) {
+        newsletterEmail.setAttribute('aria-describedby', 'newsletter-error');
+      } else {
+        newsletterEmail.removeAttribute('aria-describedby');
+      }
+      // Keep the live region mounted and avoid repeating unchanged announcements.
+      if (newsletterError.textContent !== message) {
+        newsletterError.textContent = message;
+      }
+    }
+
+    function scheduleNewsletterValidation() {
+      // Clear immediately on correction; read again after native interaction
+      // validation has settled (including failed submissions and resets).
+      if (newsletterEmail.validity.valid) syncNewsletterError();
+      cancelAnimationFrame(validationFrame);
+      validationFrame = requestAnimationFrame(syncNewsletterError);
+    }
+
+    for (const eventName of ['input', 'change', 'blur', 'invalid']) {
+      newsletterEmail.addEventListener(eventName, scheduleNewsletterValidation);
+    }
+    newsletterEmail.addEventListener('input', () => {
+      newsletterStatus.textContent = '';
+    });
+    newsletterForm.addEventListener('reset', () => {
+      newsletterStatus.textContent = '';
+      scheduleNewsletterValidation();
+    });
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      syncNewsletterError();
+      // This static site has no newsletter service configured yet.
+      newsletterStatus.textContent = 'Newsletter signup is not available yet. Please check back soon.';
+    });
+  </script>
+
