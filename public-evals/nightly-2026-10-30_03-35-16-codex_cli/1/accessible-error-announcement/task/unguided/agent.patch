@@ -206,7 +268,58 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = document.getElementById('newsletter-email');
+    const error = document.getElementById('newsletter-error');
+    const status = document.getElementById('newsletter-status');
+    let hasInteracted = false;
+
+    // Keep native validation as a fallback when JavaScript is unavailable.
+    newsletter.noValidate = true;
+
+    function updateEmailError() {
+      const showError = hasInteracted && !email.validity.valid;
+      const message = showError
+        ? (email.validity.valueMissing ? 'Please enter your email address.' : 'Please enter a valid email address.')
+        : '';
+
+      email.setAttribute('aria-invalid', String(showError));
+      if (showError) {
+        email.setAttribute('aria-describedby', 'newsletter-error');
+      } else {
+        email.removeAttribute('aria-describedby');
+      }
+
+      // This single node supplies both the visible error and its announcement.
+      // Avoid announcing the same error again on every invalid keystroke.
+      if (error.textContent !== message) error.textContent = message;
+      return !showError;
+    }
+
+    email.addEventListener('blur', () => {
+      hasInteracted = true;
+      updateEmailError();
+    });
+
+    email.addEventListener('input', () => {
+      status.textContent = '';
+      updateEmailError();
+    });
+
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      hasInteracted = true;
+      status.textContent = '';
+      if (!updateEmailError()) {
+        email.focus();
+        return;
+      }
+      status.textContent = 'Thanks for your interest! Newsletter signup will be available soon.';
+    });
+  </script>
+
 </body>
 
 </html>
