diff --git a/drink-favorite.js b/drink-favorite.js
new file mode 100644
index 0000000..3c6d228
--- /dev/null
+++ b/drink-favorite.js
@@ -0,0 +1,76 @@
+class DrinkFavorite extends HTMLElement {
+  static observedAttributes = ['favorite', 'drink-name'];
+
+  #button;
+  #icon;
+  #label;
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  connectedCallback() {
+    // Reconnecting an existing element must not duplicate its control or listener.
+    if (this.#button) return;
+
+    this.#button = document.createElement('button');
+    this.#button.type = 'button';
+    this.#icon = document.createElement('span');
+    this.#icon.className = 'favorite-icon';
+    this.#icon.setAttribute('aria-hidden', 'true');
+    this.#label = document.createElement('span');
+    this.#button.append(this.#icon, this.#label);
+    this.append(this.#button);
+
+    try {
+      const saved = this.#storageKey && localStorage.getItem(this.#storageKey);
+      if (saved !== null && saved !== '') this.favorite = saved === 'true';
+    } catch {
+      // The toggle still works when browser storage is unavailable.
+    }
+
+    this.#button.addEventListener('click', () => {
+      this.favorite = !this.favorite;
+      try {
+        if (this.#storageKey) {
+          localStorage.setItem(this.#storageKey, String(this.favorite));
+        }
+      } catch {
+        // Keep the in-page selection even if it cannot be saved.
+      }
+      this.dispatchEvent(new CustomEvent('change', {
+        bubbles: true,
+        detail: {
+          drinkId: this.getAttribute('drink-id'),
+          favorite: this.favorite,
+        },
+      }));
+    });
+    this.#render();
+  }
+
+  attributeChangedCallback() {
+    this.#render();
+  }
+
+  get #storageKey() {
+    const drinkId = this.getAttribute('drink-id');
+    return drinkId ? `daily-grind:favorite:${drinkId}` : '';
+  }
+
+  #render() {
+    if (!this.#button) return;
+    this.#button.setAttribute('aria-pressed', String(this.favorite));
+    this.#button.setAttribute('aria-label', `Favorite ${this.getAttribute('drink-name') || 'drink'}`);
+    this.#icon.textContent = this.favorite ? '♥' : '♡';
+    this.#label.textContent = this.favorite ? 'Favorited' : 'Favorite';
+  }
+}
+
+if (!customElements.get('drink-favorite')) {
+  customElements.define('drink-favorite', DrinkFavorite);
+}
