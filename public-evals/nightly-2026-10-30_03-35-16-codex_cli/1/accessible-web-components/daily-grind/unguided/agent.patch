+++ b/favorite-toggle.js
@@ -0,0 +1,78 @@
+class FavoriteToggle extends HTMLElement {
+  static get observedAttributes() {
+    return ['selected', 'drink-name'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        :host { display: block; margin-top: 15px; }
+        button {
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          gap: 8px;
+          min-height: 44px;
+          padding: 8px 14px;
+          border: 1px solid var(--primary, #4e342e);
+          border-radius: 5px;
+          background: white;
+          color: var(--primary, #4e342e);
+          font: inherit;
+          cursor: pointer;
+        }
+        button:hover { background: var(--secondary, #d7ccc8); }
+        button[aria-pressed="true"] {
+          background: var(--primary, #4e342e);
+          color: white;
+        }
+        button:focus-visible {
+          outline: 3px solid var(--primary, #4e342e);
+          outline-offset: 3px;
+        }
+        svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; }
+        button[aria-pressed="true"] svg { fill: currentColor; }
+      </style>
+      <button type="button" aria-pressed="false">
+        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" />
+        </svg>
+        <span>Favorite</span>
+      </button>
+    `;
+    this.button = this.shadowRoot.querySelector('button');
+    this.button.addEventListener('click', () => {
+      this.selected = !this.selected;
+      this.dispatchEvent(new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { selected: this.selected, drinkName: this.getAttribute('drink-name') }
+      }));
+    });
+  }
+
+  get selected() {
+    return this.hasAttribute('selected');
+  }
+
+  set selected(value) {
+    this.toggleAttribute('selected', Boolean(value));
+  }
+
+  connectedCallback() {
+    this.update();
+  }
+
+  attributeChangedCallback() {
+    this.update();
+  }
+
+  update() {
+    this.button.setAttribute('aria-pressed', String(this.selected));
+    this.button.setAttribute('aria-label', `Favorite ${this.getAttribute('drink-name') || 'drink'}`);
+    this.button.querySelector('span').textContent = this.selected ? 'Favorited' : 'Favorite';
+  }
+}
+
+customElements.define('favorite-toggle', FavoriteToggle);
