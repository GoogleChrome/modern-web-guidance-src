+  <script>
+    const hero = document.querySelector('.hero');
+    const videoPanel = document.getElementById('roasting-video');
+    const theaterToggle = document.getElementById('theater-toggle');
+    const originalParent = videoPanel.parentNode;
+    // Keep a stable marker so the panel returns to its exact original position.
+    const homeMarker = document.createComment('Roasting video home');
+    originalParent.insertBefore(homeMarker, videoPanel);
+    theaterToggle.hidden = false;
+
+    theaterToggle.addEventListener('click', () => {
+      const theaterMode = theaterToggle.getAttribute('aria-pressed') !== 'true';
+      const target = theaterMode ? hero : originalParent;
+      const reference = theaterMode ? null : homeMarker.nextSibling;
+
+      if (typeof target.moveBefore === 'function') {
+        // An atomic move preserves the iframe's browsing context and playback.
+        target.moveBefore(videoPanel, reference);
+      } else {
+        // Legacy browsers can still toggle, but this move may reload the iframe.
+        target.insertBefore(videoPanel, reference);
+        theaterToggle.focus({ preventScroll: true });
+      }
+
+      hero.classList.toggle('theater-mode', theaterMode);
+      theaterToggle.setAttribute('aria-pressed', String(theaterMode));
+    });
+  </script>
