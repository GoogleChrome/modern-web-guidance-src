+  <script>
+    const hero = document.querySelector('.hero');
+    const home = document.getElementById('video-home');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const player = document.getElementById('roasting-player');
+    const toggle = document.getElementById('theater-toggle');
+    const canMoveWithoutReload = typeof heroSlot.moveBefore === 'function';
+    let theaterActive = false;
+
+    function positionFallback() {
+      if (!theaterActive || canMoveWithoutReload) return;
+      const bounds = heroSlot.getBoundingClientRect();
+      player.style.width = bounds.width + 'px';
+      player.style.left = (bounds.left + window.scrollX) + 'px';
+      player.style.top = (bounds.top + window.scrollY) + 'px';
+      heroSlot.style.height = player.getBoundingClientRect().height + 'px';
+    }
+
+    toggle.hidden = false;
+    toggle.addEventListener('click', () => {
+      theaterActive = !theaterActive;
+      hero.classList.toggle('theater-active', theaterActive);
+
+      if (canMoveWithoutReload) {
+        // Atomic movement preserves the nested iframe's browsing context.
+        // appendChild/insertBefore would reload it, even with the same node.
+        const destination = theaterActive ? heroSlot : home;
+        destination.moveBefore(player, null);
+      } else {
+        // Keep the iframe connected to its original parent on older browsers.
+        // Visually place it in the hero instead of resetting playback by reparenting.
+        player.classList.toggle('theater-overlay', theaterActive);
+        if (!theaterActive) {
+          player.style.removeProperty('width');
+          player.style.removeProperty('left');
+          player.style.removeProperty('top');
+          heroSlot.style.removeProperty('height');
+        }
+      }
+
+      toggle.setAttribute('aria-pressed', String(theaterActive));
+      toggle.textContent = theaterActive ? 'Exit theater mode' : 'Theater mode';
+      positionFallback();
+      player.scrollIntoView({ block: 'center', behavior: 'auto' });
+    });
+
+    if (!canMoveWithoutReload) {
+      window.addEventListener('resize', positionFallback);
+      window.addEventListener('load', positionFallback);
+      if (typeof ResizeObserver === 'function') {
+        const observer = new ResizeObserver(positionFallback);
+        observer.observe(hero);
+        observer.observe(player);
+      }
+    }
+  </script>
+
