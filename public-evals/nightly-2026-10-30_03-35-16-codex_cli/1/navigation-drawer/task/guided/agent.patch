+  <script type="module">
+    const drawer = document.getElementById('navigation-drawer');
+    const openButton = document.getElementById('drawer-open');
+    const page = document.getElementById('page-content');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    let state = 'closed';
+    let hasEntered = false;
+
+    function finishClosing() {
+      observer.disconnect();
+      drawer.hidePopover();
+      state = 'closed';
+      page.inert = false;
+      openButton.setAttribute('aria-expanded', 'false');
+      openButton.focus();
+    }
+
+    // Visibility is shared by native swipes and programmatic scrolling.
+    // Ignore the initial off-screen position while starting to open.
+    const observer = new IntersectionObserver((entries) => {
+      const entry = entries.at(-1);
+      if (state === 'closed') return;
+      if (entry.intersectionRatio > 0) hasEntered = true;
+      if (entry.intersectionRatio === 0 && (hasEntered || state === 'closing')) {
+        finishClosing();
+      } else if (entry.intersectionRatio === 1 && state === 'opening') {
+        state = 'open';
+        sheet.focus();
+      }
+    }, { root: scroller, threshold: [0, 1] });
+
+    openButton.addEventListener('click', async () => {
+      if (state !== 'closed') return;
+      state = 'opening';
+      hasEntered = false;
+      drawer.showPopover();
+      page.inert = true;
+      openButton.setAttribute('aria-expanded', 'true');
+
+      if (!CSS.supports('scroll-initial-target', 'nearest')) {
+        scroller.scrollTo({ left: scroller.scrollWidth - scroller.clientWidth, behavior: 'instant' });
+      }
+      // Let the closed position commit before starting the entrance.
+      await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
+      if (state !== 'opening') return;
+      observer.observe(sheet);
+      scroller.scrollTo({ left: 0, behavior: 'auto' });
+    });
+
+    function closeDrawer() {
+      if (state === 'closed' || state === 'closing') return;
+      state = 'closing';
+      // Closing before the entrance starts needs no scroll animation.
+      if (!hasEntered) {
+        finishClosing();
+        return;
+      }
+      scroller.scrollTo({ left: scroller.scrollWidth - scroller.clientWidth, behavior: 'auto' });
+    }
+
+    drawer.querySelector('.drawer-close').addEventListener('click', closeDrawer);
+    drawer.addEventListener('click', (event) => {
+      if (!sheet.contains(event.target) || event.target.closest('a')) closeDrawer();
+    });
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && state !== 'closed') {
+        event.preventDefault();
+        closeDrawer();
+      }
+    });
+
+    // Firefox and other engines without scroll timelines still fade as
+    // the browser scrolls; this listener never handles the swipe itself.
+    if (!CSS.supports('animation-timeline: scroll()')) {
+      const updateBackdrop = () => {
+        const progress = 1 - scroller.scrollLeft / sheet.offsetWidth;
+        drawer.style.setProperty('--drawer-backdrop', Math.max(0, Math.min(1, progress)));
+      };
+      scroller.addEventListener('scroll', updateBackdrop, { passive: true });
+    }
+  </script>
