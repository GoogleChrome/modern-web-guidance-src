+  <script>
+    const menuButton = document.getElementById('menu-button');
+    const drawer = document.getElementById('navigation-drawer');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    const closeButton = drawer.querySelector('.drawer-close');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    let hasEntered = false;
+    let closing = false;
+    let openingFrame;
+
+    function syncDrawer() {
+      if (!drawer.open) return;
+      const travel = scroller.scrollWidth - scroller.clientWidth;
+      const progress = travel > 0 ? scroller.scrollLeft / travel : 0;
+      drawer.style.setProperty('--drawer-progress', Math.max(0, Math.min(1, progress)));
+      if (scroller.scrollLeft > 1) hasEntered = true;
+      // All dismissals, including a native swipe, finish at the closed stop.
+      if (scroller.scrollLeft <= 0.5 && (hasEntered || closing)) drawer.close();
+    }
+
+    function scrollDrawer(left) {
+      scroller.scrollTo({ left, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+      syncDrawer();
+    }
+
+    function closeDrawer() {
+      if (!drawer.open) return;
+      closing = true;
+      cancelAnimationFrame(openingFrame);
+      scrollDrawer(0);
+    }
+
+    menuButton.addEventListener('click', () => {
+      if (drawer.open) return;
+      hasEntered = false;
+      closing = false;
+      drawer.style.setProperty('--drawer-progress', 0);
+      drawer.showModal();
+      menuButton.setAttribute('aria-expanded', 'true');
+      // Reset any scroll caused by native autofocus before painting the entry.
+      scroller.scrollTo({ left: 0, behavior: 'instant' });
+      openingFrame = requestAnimationFrame(() => {
+        openingFrame = requestAnimationFrame(() => {
+          if (drawer.open && !closing) {
+            scrollDrawer(scroller.scrollWidth - scroller.clientWidth);
+          }
+        });
+      });
+    });
+
+    scroller.addEventListener('scroll', syncDrawer, { passive: true });
+    closeButton.addEventListener('click', closeDrawer);
+    drawer.addEventListener('click', (event) => {
+      // Ignore synthetic clicks generated at the end of a swipe.
+      if (!sheet.contains(event.target) && event.target === backdropPressTarget) closeDrawer();
+      backdropPressTarget = null;
+    });
+    let backdropPressTarget = null;
+    drawer.addEventListener('pointerdown', (event) => {
+      backdropPressTarget = sheet.contains(event.target) ? null : event.target;
+    });
+    drawer.addEventListener('pointercancel', () => { backdropPressTarget = null; });
+    drawer.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeDrawer();
+    });
+    drawer.addEventListener('close', () => {
+      cancelAnimationFrame(openingFrame);
+      menuButton.setAttribute('aria-expanded', 'false');
+      menuButton.focus({ preventScroll: true });
+    });
+  </script>
