+  <script>
+    (() => {
+      const promotion = document.getElementById('maple-promotion');
+      const status = document.getElementById('promotion-status');
+      const remaining = document.getElementById('promotion-remaining');
+      const elapsed = document.getElementById('promotion-elapsed');
+      const hour = 60 * 60 * 1000;
+
+      function duration(milliseconds) {
+        const hours = Math.floor(Math.max(0, milliseconds) / hour);
+        const days = Math.floor(hours / 24);
+        const extraHours = hours % 24;
+        return `${days} ${days === 1 ? 'day' : 'days'} ${extraHours} ${extraHours === 1 ? 'hour' : 'hours'}`;
+      }
+
+      function updatePromotion() {
+        // Component dates use the visitor's local time zone. Midnight is the
+        // beginning of March 1, not the end of that day (months are zero-based).
+        const end = new Date(2026, 2, 1, 0, 0, 0).getTime();
+        const now = Date.now();
+        // Set data-start to the confirmed local ISO date/time, without a zone,
+        // e.g. YYYY-MM-DDTHH:mm:ss. Do not infer an unknown promotion start.
+        const start = promotion.dataset.start ? new Date(promotion.dataset.start).getTime() : NaN;
+        const hasStart = Number.isFinite(start) && start < end;
+
+        status.textContent = now >= end ? 'Offer ended' :
+          hasStart && now < start ? 'Promotion has not started yet' : 'Time left';
+        remaining.textContent = `${duration(end - now)} remaining`;
+        elapsed.textContent = hasStart
+          ? `${duration(now - start)} elapsed since the promotion started${now < start ? ' (starts in the future)' : ''}.`
+          : 'Promotion start date unavailable.';
+      }
+
+      updatePromotion();
+      window.setInterval(updatePromotion, 60 * 1000);
+      window.addEventListener('pageshow', updatePromotion);
+      document.addEventListener('visibilitychange', () => {
+        if (!document.hidden) updatePromotion();
+      });
+    })();
+  </script>
 </body>
 
