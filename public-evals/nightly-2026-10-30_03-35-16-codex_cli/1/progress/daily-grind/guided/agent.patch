+    /* Native progress bars: value = determinate; no value = indeterminate. */
+    .progress-panel {
+      margin-bottom: 40px;
+      padding: 24px;
+      background: #fff8ef;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+    }
+
+    .progress-panel h2 {
+      margin-bottom: 4px;
+      color: var(--primary);
+    }
+
+    .progress-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
+      gap: 24px;
+      margin-top: 20px;
+    }
+
+    .progress-heading {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      gap: 4px 12px;
+      margin-bottom: 8px;
+    }
+
+    .progress-heading label {
+      font-weight: 600;
+    }
+
+    .progress-heading span,
+    .progress-description {
+      font-size: 0.9rem;
+    }
+
+    .progress-description {
+      margin-top: 8px;
+    }
+
+    .process-progress {
+      --progress-bar-indeterminate-size: 30%;
+      --progress-bar-indeterminate-animation-duration: 1.8s;
+      appearance: none;
+      display: block;
+      inline-size: 100%;
+      block-size: 12px;
+      border: 0 solid;
+      border-radius: 100px;
+      overflow: clip;
+      background: var(--secondary);
+      container-type: inline-size;
+    }
+
+    .process-progress::-webkit-progress-bar {
+      background: transparent;
+    }
+
+    .process-progress::-webkit-progress-value {
+      background: var(--primary);
+      border-radius: 100px;
+      animation: var(--progress-bar-animation, none);
+    }
+
+    .process-progress::-moz-progress-bar {
+      background: var(--primary);
+      border-radius: 100px;
+      animation: var(--progress-bar-animation, none);
+    }
+
+    .process-progress:indeterminate {
+      --progress-bar-animation: progress-pending var(--progress-bar-indeterminate-animation-duration) infinite linear;
+    }
+
+    .process-progress:indeterminate:dir(rtl) {
+      --progress-bar-animation: progress-pending var(--progress-bar-indeterminate-animation-duration) infinite linear reverse;
+    }
+
+    @keyframes progress-pending {
+      from, to {
+        inline-size: var(--progress-bar-indeterminate-size);
+        margin-right: auto;
+      }
+      from { translate: -100%; }
+      to { translate: 100cqi; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .process-progress {
+        --progress-bar-indeterminate-animation-duration: 10s;
+      }
+    }
+
