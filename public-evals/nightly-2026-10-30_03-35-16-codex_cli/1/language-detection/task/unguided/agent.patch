+  <script>
+    const form = document.querySelector('#feedback-form');
+    const message = document.querySelector('#feedback-message');
+    const button = document.querySelector('#detect-button');
+    const status = document.querySelector('#detection-status');
+    const progress = document.querySelector('#model-progress');
+    const result = document.querySelector('#detection-result');
+    let detector;
+    let availability;
+
+    async function checkAvailability() {
+      if (!('LanguageDetector' in window)) {
+        status.textContent = 'Language detection is not supported in this browser. Try a browser with built-in language detection enabled.';
+        return;
+      }
+
+      try {
+        availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          status.textContent = 'Language detection is unavailable on this device or is blocked by your browser settings.';
+          return;
+        }
+        status.textContent = availability === 'available'
+          ? 'Ready to detect. Your message is processed on your device.'
+          : 'The language model needs to download. Click Detect to continue.';
+        button.disabled = false;
+      } catch (error) {
+        status.textContent = 'Unable to check language detection availability. Reload the page to try again.';
+      }
+    }
+
+    message.addEventListener('input', () => {
+      message.setCustomValidity('');
+      result.hidden = true;
+    });
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const text = message.value.trim();
+      if (!text) {
+        message.setCustomValidity('Please enter a message to detect its language.');
+        message.reportValidity();
+        return;
+      }
+
+      button.disabled = true;
+      form.setAttribute('aria-busy', 'true');
+      result.hidden = true;
+      progress.hidden = true;
+      try {
+        if (!detector) {
+          if (availability === 'downloadable' || availability === 'downloading') {
+            progress.value = 0;
+            progress.hidden = false;
+            status.textContent = 'Downloading language model: 0%';
+          } else {
+            status.textContent = 'Preparing language detection…';
+          }
+          // Create from the user's click so the browser can authorize a download.
+          detector = await LanguageDetector.create({
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                const percentage = Math.round(Math.min(1, Math.max(0, event.loaded)) * 100);
+                progress.hidden = false;
+                progress.value = percentage;
+                status.textContent = `Downloading language model: ${percentage}%`;
+              });
+            },
+          });
+        }
+        progress.hidden = true;
+        status.textContent = 'Detecting language…';
+        const languages = await detector.detect(text);
+        const best = [...languages].sort((a, b) => b.confidence - a.confidence)[0];
+        if (!best || best.detectedLanguage === 'und') {
+          status.textContent = 'The language could not be identified. Try a longer message in one language.';
+          return;
+        }
+
+        let languageName = best.detectedLanguage;
+        try {
+          languageName = new Intl.DisplayNames(['en'], { type: 'language' }).of(best.detectedLanguage);
+        } catch {
+          // Keep the language code if display names are not supported.
+        }
+        const confidence = new Intl.NumberFormat('en', {
+          style: 'percent', maximumFractionDigits: 1,
+        }).format(best.confidence);
+        result.textContent = `Language: ${languageName} · AI confidence: ${confidence}`;
+        result.hidden = false;
+        status.textContent = 'Detection complete. Short or mixed-language messages may be less reliable.';
+      } catch (error) {
+        status.textContent = 'Language detection failed. Please try again. If a download was needed, check your connection and browser settings.';
+      } finally {
+        progress.hidden = true;
+        button.disabled = false;
+        form.removeAttribute('aria-busy');
+      }
+    });
+
+    checkAvailability();
+  </script>
 </body>
 
