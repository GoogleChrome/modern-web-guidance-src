+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const message = document.getElementById('feedback-message');
+    const detectButton = document.getElementById('detect-button');
+    const status = document.getElementById('feedback-status');
+    const downloadStatus = document.getElementById('download-status');
+    const downloadPercent = document.getElementById('download-percent');
+    const modelProgress = document.getElementById('model-progress');
+    let availability = 'unavailable';
+    let detector;
+    let busy = false;
+
+    async function checkAvailability() {
+      if (!('LanguageDetector' in window)) {
+        status.textContent = 'Built-in language detection is not supported in this browser. Try a supported desktop browser such as Chrome.';
+        return;
+      }
+
+      try {
+        availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          status.textContent = 'Language detection is unavailable on this device.';
+          return;
+        }
+        status.textContent = availability === 'available'
+          ? 'Ready to detect your message’s language.'
+          : 'Click Detect to download the language model and analyze your message.';
+        detectButton.disabled = false;
+      } catch {
+        status.textContent = 'Could not check language detection availability. Reload the page to try again.';
+      }
+    }
+
+    message.addEventListener('input', () => {
+      message.setCustomValidity('');
+      if (!busy && availability !== 'unavailable') {
+        status.textContent = 'Click Detect to analyze your message.';
+      }
+    });
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (busy || availability === 'unavailable') return;
+
+      const text = message.value.trim();
+      if (!text) {
+        message.setCustomValidity('Please enter a message to detect its language.');
+        message.reportValidity();
+        return;
+      }
+
+      busy = true;
+      detectButton.disabled = true;
+      message.readOnly = true;
+      status.textContent = 'Preparing language detection…';
+
+      try {
+        if (!detector) {
+          modelProgress.value = 0;
+          downloadPercent.textContent = '0%';
+          downloadStatus.hidden = availability === 'available';
+          // Create in the submit gesture so the browser can authorize a download.
+          detector = await LanguageDetector.create({
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                const percent = Math.round(Math.max(0, Math.min(1, event.loaded)) * 100);
+                downloadStatus.hidden = false;
+                modelProgress.value = percent;
+                downloadPercent.textContent = `${percent}%`;
+              });
+            },
+          });
+          availability = 'available';
+          if (!downloadStatus.hidden) {
+            modelProgress.value = 100;
+            downloadPercent.textContent = '100%';
+          }
+        }
+
+        status.textContent = 'Detecting language…';
+        const [result] = await detector.detect(text);
+        if (!result || result.detectedLanguage === 'und') {
+          status.textContent = 'Could not identify a language. Try a longer message with a few complete sentences.';
+          return;
+        }
+
+        let language = result.detectedLanguage;
+        try {
+          language = new Intl.DisplayNames(['en'], { type: 'language' }).of(language) || language;
+        } catch {
+          // Keep the language code if a display name is unavailable.
+        }
+        const confidence = new Intl.NumberFormat('en', {
+          style: 'percent', maximumFractionDigits: 1,
+        }).format(result.confidence);
+        status.textContent = `Language: ${language}. AI confidence: ${confidence}.`;
+      } catch {
+        downloadStatus.hidden = true;
+        status.textContent = 'Language detection failed. Check your connection if the model needs downloading, then click Detect to retry.';
+      } finally {
+        busy = false;
+        message.readOnly = false;
+        detectButton.disabled = false;
+      }
+    });
+
+    checkAvailability();
+  </script>
 </body>
 
