@@ -206,7 +279,50 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingListForm = document.querySelector('.mailing-list');
+    const emailInput = document.querySelector('#mailing-list-email');
+    const emailError = document.querySelector('#mailing-list-error');
+    const mailingListStatus = document.querySelector('#mailing-list-status');
+    let emailTouched = false;
+
+    function updateEmailError() {
+      const message = emailTouched && !emailInput.validity.valid
+        ? (emailInput.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address.')
+        : '';
+
+      emailError.textContent = message;
+      if (message) {
+        emailInput.setAttribute('aria-invalid', 'true');
+      } else {
+        emailInput.removeAttribute('aria-invalid');
+      }
+    }
+
+    emailInput.addEventListener('blur', () => {
+      emailTouched = true;
+      updateEmailError();
+    });
+
+    emailInput.addEventListener('input', () => {
+      mailingListStatus.textContent = '';
+      updateEmailError();
+    });
+
+    mailingListForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!emailInput.validity.valid) {
+        emailInput.focus();
+        return;
+      }
+
+      mailingListStatus.textContent = 'Mailing list signup is not available yet. Please try again later.';
+    });
+  </script>
+
 </body>
 
 </html>
