+  <script>
+    const mailingListForm = document.getElementById('mailing-list-form');
+    const mailingListEmail = document.getElementById('mailing-list-email');
+    const mailingListStatus = document.getElementById('mailing-list-status');
+
+    const syncEmailError = () => {
+      // Read after the browser updates its interaction-based validation state.
+      requestAnimationFrame(() => {
+        if (mailingListEmail.matches(':user-invalid')) {
+          mailingListEmail.setAttribute('aria-invalid', 'true');
+        } else {
+          mailingListEmail.removeAttribute('aria-invalid');
+        }
+      });
+    };
+
+    mailingListEmail.addEventListener('blur', syncEmailError);
+    mailingListEmail.addEventListener('input', () => {
+      syncEmailError();
+      mailingListStatus.textContent = '';
+    });
+    mailingListEmail.addEventListener('invalid', syncEmailError);
+
+    mailingListForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Connect a mailing-list service here before accepting subscriptions.
+      mailingListStatus.textContent = 'Mailing list signup is currently unavailable. Please try again later.';
+    });
+  </script>
+
 </body>
 
