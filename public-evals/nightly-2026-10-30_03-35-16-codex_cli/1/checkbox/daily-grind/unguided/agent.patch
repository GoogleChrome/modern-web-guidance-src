+      position: relative;
+      display: grid;
+      grid-template-columns: 24px minmax(0, 1fr) 20px;
+      align-items: center;
+      gap: 10px;
+      min-height: 48px;
+      padding: 10px 12px;
+      margin-top: 8px;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: #fcf9f6;
+      cursor: pointer;
+      font-size: 0.875rem;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .customization:hover {
+      border-color: var(--primary);
+      background: #f5eee8;
+    }
+
+    .customization input {
+      position: absolute;
+      left: 12px;
+      top: 50%;
+      transform: translateY(-50%);
+      width: 24px;
+      height: 24px;
+      margin: 0;
+      opacity: 0;
+    }
+
+    .checkbox-mark {
+      display: grid;
+      place-items: center;
+      width: 24px;
+      height: 24px;
+      border: 2px solid #8d7368;
+      border-radius: 6px;
+      background: white;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .checkbox-mark svg {
+      width: 16px;
+      height: 16px;
+      fill: none;
+      stroke: var(--primary);
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 20;
+      stroke-dashoffset: 20;
+      opacity: 0;
+      transform: scale(0.65);
+      transition: stroke-dashoffset 200ms ease, opacity 150ms ease, transform 200ms ease;
+    }
+
+    .customization input:checked + .checkbox-mark {
+      background: var(--accent);
+      border-color: var(--primary);
+    }
+
+    .customization input:checked + .checkbox-mark svg {
+      stroke-dashoffset: 0;
+      opacity: 1;
+      transform: scale(1);
+    }
+
+    .customization:has(input:checked) {
+      background: #fff1dd;
+      border-color: #99601c;
+    }
+
+    .customization:has(input:focus-visible) {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    .customization input:focus-visible + .checkbox-mark {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    .ingredient-icon {
+      width: 20px;
+      height: 20px;
+      fill: none;
+      stroke: #795548;
+      stroke-width: 1.7;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+    }
+
+    .icon-library {
+      position: absolute;
+      width: 0;
+      height: 0;
+      overflow: hidden;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .customization,
+      .checkbox-mark,
+      .checkbox-mark svg {
+        transition: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .customization input {
+        position: static;
+        transform: none;
+        opacity: 1;
+        accent-color: auto;
+      }
+
+      .checkbox-mark {
+        display: none;
+      }
+
+      .ingredient-icon {
+        stroke: CanvasText;
+      }
+    }
