+  <script>
+    const strengthSlider = document.getElementById('brew-strength');
+    const strengthValue = document.getElementById('brew-strength-value');
+    const strengthLabels = ['Light', 'Mellow', 'Balanced', 'Strong', 'Bold'];
+
+    function syncStrength() {
+      const value = strengthSlider.valueAsNumber;
+      const label = strengthLabels[value - 1];
+      strengthSlider.style.setProperty('--attr-min', strengthSlider.min);
+      strengthSlider.style.setProperty('--attr-max', strengthSlider.max);
+      strengthSlider.style.setProperty('--control-value', strengthSlider.value);
+      strengthSlider.setAttribute('aria-valuetext', `${label}, ${value} of ${strengthSlider.max}`);
+      strengthValue.textContent = `${label} · ${value} of ${strengthSlider.max}`;
+      strengthValue.hidden = false;
+    }
+
+    strengthSlider.addEventListener('input', syncStrength);
+    window.addEventListener('pageshow', syncStrength);
+    syncStrength();
+  </script>
