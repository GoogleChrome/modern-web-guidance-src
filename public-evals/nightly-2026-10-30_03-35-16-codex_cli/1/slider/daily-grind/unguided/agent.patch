+  <script>
+    const brewStrength = document.getElementById('brew-strength');
+    const brewValue = document.getElementById('brew-value');
+    const strengthNames = ['Mild', 'Smooth', 'Balanced', 'Rich', 'Bold'];
+
+    function updateBrewStrength() {
+      const value = Number(brewStrength.value);
+      const progress = (value - Number(brewStrength.min)) /
+        (Number(brewStrength.max) - Number(brewStrength.min)) * 100;
+      const name = strengthNames[value - 1];
+      brewStrength.style.setProperty('--progress', `${progress}%`);
+      brewStrength.setAttribute('aria-valuetext', `${name}, ${value} of 5`);
+      brewValue.value = `${name} · ${value}/5`;
+    }
+
+    brewStrength.addEventListener('input', updateBrewStrength);
+    updateBrewStrength();
+  </script>
