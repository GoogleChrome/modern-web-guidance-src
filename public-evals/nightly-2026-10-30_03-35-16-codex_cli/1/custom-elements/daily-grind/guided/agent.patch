+/**
+ * Autonomous card with light DOM so its static content and page styles survive
+ * without JavaScript. Attributes are the single source of truth.
+ * price is an optional, non-negative USD amount; featured uses HTML presence semantics.
+ */
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href', 'price', 'featured'];
+
+  #heading;
+  #description;
+  #link;
+  #price;
+  #featured;
+
+  connectedCallback() {
+    // Preserve values assigned before this element's definition was loaded.
+    for (const property of CoffeeCard.observedAttributes) {
+      if (Object.hasOwn(this, property)) {
+        const value = this[property];
+        delete this[property];
+        this[property] = value;
+      }
+    }
+
+    if (!this.#heading) {
+      this.#heading = this.querySelector('h3') ?? this.appendChild(document.createElement('h3'));
+      this.#description = this.querySelector('p') ?? this.appendChild(document.createElement('p'));
+      this.#featured = document.createElement('p');
+      this.#featured.dataset.featured = '';
+      this.#featured.textContent = 'Seasonal favorite';
+      this.#price = document.createElement('p');
+      this.#price.dataset.price = '';
+      this.#link = this.querySelector('a') ?? document.createElement('a');
+      this.#link.classList.add('btn');
+      this.#link.textContent = 'View Details';
+      this.append(this.#featured, this.#price, this.#link);
+    }
+
+    this.#link.addEventListener('click', this.#onSelect);
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    this.#link?.removeEventListener('click', this.#onSelect);
+  }
+
+  attributeChangedCallback(attribute, oldValue, newValue) {
+    if (oldValue !== newValue && this.#heading) this.#render();
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.#setString('name', value); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(value) { this.#setString('description', value); }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(value) { this.#setString('href', value); }
+
+  get price() {
+    const value = this.getAttribute('price');
+    if (value === null || value.trim() === '') return null;
+    const amount = Number(value);
+    return Number.isFinite(amount) && amount >= 0 ? amount : null;
+  }
+  set price(value) {
+    if (value == null || String(value).trim() === '') {
+      this.removeAttribute('price');
+      return;
+    }
+    const amount = Number(value);
+    if (!Number.isFinite(amount) || amount < 0) {
+      throw new TypeError('price must be a finite, non-negative number');
+    }
+    this.setAttribute('price', String(amount));
+  }
+
+  get featured() { return this.hasAttribute('featured'); }
+  set featured(value) { this.toggleAttribute('featured', Boolean(value)); }
+
+  #setString(attribute, value) {
+    if (value == null) this.removeAttribute(attribute);
+    else this.setAttribute(attribute, String(value));
+  }
+
+  #render() {
+    this.#heading.textContent = this.name;
+    this.#description.textContent = this.description;
+    this.#featured.hidden = !this.featured;
+    this.#price.hidden = this.price === null;
+    this.#price.textContent = this.price === null ? '' : `$${this.price.toFixed(2)}`;
+    // Only navigation protocols are accepted; attributes cannot inject script URLs.
+    try {
+      const url = new URL(this.href, this.ownerDocument.baseURI);
+      if (!this.href || !['http:', 'https:'].includes(url.protocol)) throw new Error();
+      this.#link.setAttribute('href', this.href);
+    } catch {
+      this.#link.removeAttribute('href');
+    }
+  }
+
+  #onSelect = () => {
+    this.dispatchEvent(new CustomEvent('coffee-select', {
+      bubbles: true,
+      detail: { name: this.name, href: this.href, price: this.price, featured: this.featured },
+    }));
+  };
+}
+
+if (!customElements.get('coffee-card')) customElements.define('coffee-card', CoffeeCard);
diff --git a/coffee-card.test.js b/coffee-card.test.js
new file mode 100644
index 0000000..93dc600
--- /dev/null
+++ b/coffee-card.test.js
@@ -0,0 +1,128 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { test } from 'node:test';
+import { Window } from 'happy-dom';
+
+// A DOM emulator only: no browser, server, or network navigation is started.
+const window = new Window({ url: 'https://daily-grind.example/' });
+for (const key of ['document', 'HTMLElement', 'customElements', 'CustomEvent']) {
+  globalThis[key] = window[key];
+}
+
+document.body.innerHTML = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+const earlyCard = document.createElement('coffee-card');
+earlyCard.name = 'Assigned before upgrade';
+earlyCard.price = 4.5;
+earlyCard.featured = true;
+document.body.append(earlyCard);
+await import('./coffee-card.js');
+
+test('existing markup upgrades and retains all three cards and links', () => {
+  const cards = [...document.querySelectorAll('.grid coffee-card')];
+  assert.equal(cards.length, 3);
+  assert.deepEqual(cards.map(card => card.name), ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew']);
+  for (const card of cards) {
+    assert.equal(card.querySelectorAll('h3').length, 1);
+    assert.equal(card.querySelector('h3').textContent, card.name);
+    assert.equal(card.querySelector('a').getAttribute('href'), card.href);
+    assert.equal(card.querySelector('[data-price]').hidden, true);
+    assert.equal(card.querySelector('[data-featured]').hidden, true);
+  }
+});
+
+test('properties assigned before registration survive upgrade', () => {
+  assert.equal(earlyCard.getAttribute('name'), 'Assigned before upgrade');
+  assert.equal(earlyCard.price, 4.5);
+  assert.equal(earlyCard.getAttribute('price'), '4.5');
+  assert.equal(earlyCard.hasAttribute('featured'), true);
+});
+
+test('string attributes and properties reflect both ways and render text safely', () => {
+  const card = document.createElement('coffee-card');
+  card.name = '<img src=x onerror=alert(1)>';
+  card.description = 'Fresh coffee';
+  card.href = '/menu/new';
+  document.body.append(card);
+  assert.equal(card.getAttribute('name'), card.name);
+  assert.equal(card.querySelector('img'), null);
+  assert.equal(card.querySelector('h3').textContent, card.name);
+  card.setAttribute('description', 'Updated coffee');
+  assert.equal(card.description, 'Updated coffee');
+  assert.equal(card.querySelector('p').textContent, 'Updated coffee');
+  card.name = 0;
+  assert.equal(card.name, '0');
+  card.name = null;
+  assert.equal(card.hasAttribute('name'), false);
+  assert.equal(card.querySelector('h3').textContent, '');
+  card.href = 'javascript:alert(1)';
+  assert.equal(card.querySelector('a').hasAttribute('href'), false);
+  card.href = '/menu/restored';
+  assert.equal(card.querySelector('a').getAttribute('href'), '/menu/restored');
+  card.remove();
+});
+
+test('numeric reflection handles zero, missing, invalid, and fractional prices', () => {
+  const card = document.createElement('coffee-card');
+  document.body.append(card);
+  for (const [value, expected] of [[4.5, '$4.50'], [0, '$0.00'], ['6.25', '$6.25']]) {
+    card.price = value;
+    assert.equal(card.getAttribute('price'), String(Number(value)));
+    assert.equal(card.price, Number(value));
+    assert.equal(card.querySelector('[data-price]').textContent, expected);
+    assert.equal(card.querySelector('[data-price]').hidden, false);
+  }
+  for (const value of ['', 'invalid', '-1', 'Infinity']) {
+    card.setAttribute('price', value);
+    assert.equal(card.price, null);
+    assert.equal(card.querySelector('[data-price]').hidden, true);
+  }
+  for (const value of [-1, NaN, Infinity, 'invalid']) {
+    assert.throws(() => { card.price = value; }, TypeError);
+  }
+  card.price = null;
+  assert.equal(card.hasAttribute('price'), false);
+  card.remove();
+});
+
+test('boolean reflection uses presence even for the literal attribute value false', () => {
+  const card = document.createElement('coffee-card');
+  document.body.append(card);
+  card.featured = true;
+  assert.equal(card.getAttribute('featured'), '');
+  assert.equal(card.querySelector('[data-featured]').hidden, false);
+  card.featured = false;
+  assert.equal(card.hasAttribute('featured'), false);
+  card.setAttribute('featured', 'false');
+  assert.equal(card.featured, true);
+  card.removeAttribute('featured');
+  assert.equal(card.featured, false);
+  assert.equal(card.querySelector('[data-featured]').hidden, true);
+  card.remove();
+});
+
+test('disconnect cleans up listeners and reconnect preserves nodes without duplicate events', () => {
+  const card = document.createElement('coffee-card');
+  card.name = 'Test coffee';
+  document.body.append(card);
+  const link = card.querySelector('a');
+  let selections = 0;
+  card.addEventListener('coffee-select', event => {
+    selections++;
+    assert.equal(event.detail.name, card.name);
+  });
+  link.click();
+  assert.equal(selections, 1);
+  for (let i = 0; i < 3; i++) {
+    card.remove();
+    link.click();
+    assert.equal(selections, i + 1);
+    card.name = `Reconnected ${i}`;
+    document.body.append(card);
+    assert.equal(card.querySelector('a'), link);
+    assert.equal(card.querySelectorAll('[data-price]').length, 1);
+    assert.equal(card.querySelector('h3').textContent, card.name);
+    link.click();
+    assert.equal(selections, i + 2);
+  }
+  card.remove();
+});
