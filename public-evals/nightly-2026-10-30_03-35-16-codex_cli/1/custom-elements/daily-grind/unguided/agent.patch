index 0000000..25b9e42
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,136 @@
+class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href', 'price', 'featured', 'disabled'];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        :host {
+          display: block;
+          background: white;
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+        }
+        :host([featured]) {
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1), inset 0 0 0 2px var(--accent, #ffab40);
+        }
+        * { box-sizing: border-box; margin: 0; padding: 0; }
+        h3 { margin-bottom: 10px; color: var(--primary, #4e342e); }
+        .price { margin-top: 10px; font-weight: bold; }
+        a {
+          display: inline-block;
+          background: var(--primary, #4e342e);
+          color: white;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          margin-top: 15px;
+          transition: background 0.3s;
+        }
+        a:hover { background: #3e2723; }
+        a:focus-visible { outline: 3px solid var(--accent, #ffab40); outline-offset: 3px; }
+        a[aria-disabled="true"] { opacity: 0.5; cursor: not-allowed; }
+      </style>
+      <article>
+        <h3></h3>
+        <p class="description"></p>
+        <p class="price" hidden></p>
+        <a>View Details</a>
+      </article>
+    `;
+    this._link = this.shadowRoot.querySelector('a');
+    this._onClick = (event) => {
+      if (this.disabled || !this.href) event.preventDefault();
+    };
+  }
+
+  connectedCallback() {
+    // Honor properties assigned before customElements.define() upgraded this node.
+    for (const property of CoffeeCard.observedAttributes) {
+      if (Object.prototype.hasOwnProperty.call(this, property)) {
+        const value = this[property];
+        delete this[property];
+        this[property] = value;
+      }
+    }
+    this._link.addEventListener('click', this._onClick);
+    this._render();
+  }
+
+  disconnectedCallback() {
+    this._link.removeEventListener('click', this._onClick);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this._render();
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this._reflectString('name', value); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(value) { this._reflectString('description', value); }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(value) { this._reflectString('href', value); }
+
+  get price() {
+    const raw = this.getAttribute('price');
+    if (raw === null || raw.trim() === '') return null;
+    const value = Number(raw);
+    return Number.isFinite(value) && value >= 0 ? value : null;
+  }
+
+  set price(value) {
+    if (value === null || value === undefined) {
+      this.removeAttribute('price');
+      return;
+    }
+    const number = Number(value);
+    if (String(value).trim() === '' || !Number.isFinite(number) || number < 0) {
+      throw new RangeError('price must be a finite, non-negative number or null');
+    }
+    this.setAttribute('price', String(number));
+  }
+
+  get featured() { return this.hasAttribute('featured'); }
+  set featured(value) { this.toggleAttribute('featured', Boolean(value)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+
+  _reflectString(attribute, value) {
+    if (value === null || value === undefined) this.removeAttribute(attribute);
+    else this.setAttribute(attribute, String(value));
+  }
+
+  _render() {
+    // Keep the DOM (and focus) stable and treat attribute content as plain text.
+    this.shadowRoot.querySelector('h3').textContent = this.name;
+    this.shadowRoot.querySelector('.description').textContent = this.description;
+    const price = this.shadowRoot.querySelector('.price');
+    price.hidden = this.price === null;
+    price.textContent = this.price === null ? '' : new Intl.NumberFormat('en-US', {
+      style: 'currency', currency: 'USD',
+    }).format(this.price);
+
+    const inactive = this.disabled || !this.href;
+    if (inactive) {
+      this._link.removeAttribute('href');
+      this._link.setAttribute('role', 'link');
+      this._link.setAttribute('aria-disabled', 'true');
+      this._link.setAttribute('tabindex', '-1');
+    } else {
+      this._link.setAttribute('href', this.href);
+      this._link.removeAttribute('role');
+      this._link.removeAttribute('aria-disabled');
+      this._link.removeAttribute('tabindex');
+    }
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
