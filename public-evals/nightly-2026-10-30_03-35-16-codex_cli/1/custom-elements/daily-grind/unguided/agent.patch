diff --git a/tests/coffee-card.test.cjs b/tests/coffee-card.test.cjs
new file mode 100644
index 0000000..a7d5e06
--- /dev/null
+++ b/tests/coffee-card.test.cjs
@@ -0,0 +1,137 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+const { parseHTML } = require('linkedom');
+
+const source = readFileSync(new URL('../components/coffee-card.js', `file://${__filename}`), 'utf8');
+
+function setup(markup = '') {
+  const { window } = parseHTML(`<html><body>${markup}</body></html>`);
+  const register = () => runInNewContext(source, {
+    HTMLElement: window.HTMLElement,
+    customElements: window.customElements,
+    Intl,
+  });
+  return { window, document: window.document, register };
+}
+
+test('existing markup upgrades and preserves each coffee and destination', () => {
+  const html = readFileSync(new URL('../index.html', `file://${__filename}`), 'utf8');
+  const { document, register } = setup(html);
+  register();
+  const cards = [...document.querySelectorAll('coffee-card')];
+  assert.equal(cards.length, 3);
+  assert.deepEqual(cards.map(card => card.shadowRoot.querySelector('h3').textContent), [
+    'Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew',
+  ]);
+  assert.deepEqual(cards.map(card => card.shadowRoot.querySelector('a').getAttribute('href')), [
+    '/menu/seasonal', '/menu/espresso', '/menu/cold-brew',
+  ]);
+});
+
+test('string attributes and properties reflect both ways without interpreting HTML', () => {
+  const { document, register } = setup();
+  register();
+  const card = document.createElement('coffee-card');
+  for (const property of ['name', 'description', 'href']) {
+    card[property] = 'first';
+    assert.equal(card.getAttribute(property), 'first');
+    card.setAttribute(property, 'second');
+    assert.equal(card[property], 'second');
+    card[property] = null;
+    assert.equal(card.hasAttribute(property), false);
+    assert.equal(card[property], '');
+  }
+  card.name = '<img src=x onerror=alert(1)>';
+  assert.equal(card.shadowRoot.querySelector('h3').textContent, card.name);
+  assert.equal(card.shadowRoot.querySelector('img'), null);
+});
+
+test('numeric reflection handles zero, removal and invalid values', () => {
+  const { document, register } = setup();
+  register();
+  const card = document.createElement('coffee-card');
+  const price = card.shadowRoot.querySelector('.price');
+  card.price = 4.5;
+  assert.equal(card.getAttribute('price'), '4.5');
+  assert.equal(price.textContent, '$4.50');
+  card.setAttribute('price', '0');
+  assert.equal(card.price, 0);
+  assert.equal(price.hidden, false);
+  assert.equal(price.textContent, '$0.00');
+  for (const value of ['', 'invalid', '-1', 'Infinity']) {
+    card.setAttribute('price', value);
+    assert.equal(card.price, null);
+    assert.equal(price.hidden, true);
+  }
+  for (const value of [-1, NaN, Infinity, '']) {
+    assert.throws(() => { card.price = value; }, /finite, non-negative/);
+  }
+  card.price = null;
+  assert.equal(card.hasAttribute('price'), false);
+});
+
+test('boolean attributes use presence and disabled cards cannot navigate', () => {
+  const { document, window, register } = setup();
+  register();
+  const card = document.createElement('coffee-card');
+  card.href = '/menu/espresso';
+  document.body.append(card);
+  for (const property of ['featured', 'disabled']) {
+    card[property] = true;
+    assert.equal(card.getAttribute(property), '');
+    card[property] = false;
+    assert.equal(card.hasAttribute(property), false);
+    card.setAttribute(property, 'false');
+    assert.equal(card[property], true);
+    card.removeAttribute(property);
+    assert.equal(card[property], false);
+  }
+  const link = card.shadowRoot.querySelector('a');
+  card.disabled = true;
+  assert.equal(link.hasAttribute('href'), false);
+  assert.equal(link.getAttribute('aria-disabled'), 'true');
+  assert.equal(link.dispatchEvent(new window.Event('click', { cancelable: true })), false);
+  card.disabled = false;
+  assert.equal(link.getAttribute('href'), '/menu/espresso');
+  assert.equal(link.hasAttribute('aria-disabled'), false);
+  assert.equal(link.dispatchEvent(new window.Event('click', { cancelable: true })), true);
+});
+
+test('disconnect removes listeners and reconnect restores them without replacing DOM', () => {
+  const { document, window, register } = setup();
+  register();
+  const card = document.createElement('coffee-card');
+  card.disabled = true;
+  const link = card.shadowRoot.querySelector('a');
+  const click = () => link.dispatchEvent(new window.Event('click', { cancelable: true }));
+  for (let i = 0; i < 3; i++) {
+    document.body.append(card);
+    assert.equal(click(), false);
+    card.remove();
+    assert.equal(click(), true);
+    card.name = `Updated ${i}`;
+    assert.equal(card.shadowRoot.querySelector('a'), link);
+    assert.equal(card.shadowRoot.querySelector('h3').textContent, `Updated ${i}`);
+  }
+});
+
+test('first connection reflects own properties left by pre-registration assignments', () => {
+  const { document, register } = setup();
+  register();
+  const card = document.createElement('coffee-card');
+  card.setAttribute('name', 'Old');
+  // Linkedom invokes setters during upgrade, unlike browsers. Reproduce the
+  // browser's own-property state explicitly before the first connection.
+  Object.defineProperties(card, {
+    name: { value: 'New', writable: true, configurable: true },
+    price: { value: 3.25, writable: true, configurable: true },
+    featured: { value: true, writable: true, configurable: true },
+  });
+  document.body.append(card);
+  assert.equal(card.getAttribute('name'), 'New');
+  assert.equal(card.getAttribute('price'), '3.25');
+  assert.equal(card.hasAttribute('featured'), true);
+  assert.equal(card.shadowRoot.querySelector('h3').textContent, 'New');
+});
