+  <script>
+    const coffees = [
+      { name: 'Maple Oat Latte', flavor: 'sweet', temperature: 'hot',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.', url: '/menu/seasonal' },
+      { name: 'Dark Roast Espresso', flavor: 'bold', temperature: 'hot',
+        description: 'Bold, smoky, and perfect for a morning boost.', url: '/menu/espresso' },
+      { name: 'Cold Brew', flavor: 'smooth', temperature: 'iced',
+        description: 'Steeped for 18 hours for maximum smoothness.', url: '/menu/cold-brew' }
+    ];
+    const finderForm = document.getElementById('coffee-finder-form');
+    const finderStatus = document.getElementById('finder-status');
+    const finderResult = document.getElementById('finder-result');
+
+    finderForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(finderForm);
+      const flavor = data.get('flavor');
+      const temperature = data.get('temperature');
+      const reply = (result) => {
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(JSON.stringify(result)));
+        }
+      };
+
+      if (!finderForm.checkValidity() || !['any', 'sweet', 'bold', 'smooth'].includes(flavor) ||
+          !['any', 'hot', 'iced'].includes(temperature)) {
+        finderResult.hidden = true;
+        finderStatus.textContent = 'Please choose a flavor and a valid temperature preference.';
+        finderForm.reportValidity();
+        reply({ error: 'Choose a listed flavor and temperature preference, then try again.' });
+        return;
+      }
+
+      // Flavor is the primary preference; temperature breaks ties.
+      const score = (coffee) => (flavor === 'any' || coffee.flavor === flavor ? 2 : 0) +
+        (temperature === 'any' || coffee.temperature === temperature ? 1 : 0);
+      const coffee = [...coffees].sort((a, b) => score(b) - score(a))[0];
+      const temperatureMatches = temperature === 'any' || temperature === coffee.temperature;
+      const explanation = temperatureMatches
+        ? 'A match for your flavor and temperature preferences.'
+        : `A match for your flavor preference. This featured drink is served ${coffee.temperature === 'hot' ? 'hot' : 'iced'}, so it doesn't match your temperature preference.`;
+
+      document.getElementById('result-name').textContent = coffee.name;
+      document.getElementById('result-description').textContent = coffee.description;
+      document.getElementById('result-match').textContent = explanation;
+      document.getElementById('result-link').href = coffee.url;
+      finderResult.hidden = false;
+      finderStatus.textContent = `Your coffee match: ${coffee.name}. ${explanation}`;
+      reply({
+        recommendation: coffee.name,
+        description: coffee.description,
+        served: coffee.temperature,
+        preferences: { flavor, temperature },
+        temperatureMatches,
+        explanation,
+        menuUrl: new URL(coffee.url, window.location.href).href
+      });
+    });
+  </script>
