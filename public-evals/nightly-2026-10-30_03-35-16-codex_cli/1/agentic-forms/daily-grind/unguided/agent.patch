+  <script>
+    const finderForm = document.getElementById('coffee-finder-form');
+    const resultRegion = document.getElementById('coffee-result');
+    const coffees = {
+      latte: {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk and Vermont maple sweetness make this a cozy, mellow choice.',
+        menuUrl: '/menu/seasonal'
+      },
+      espresso: {
+        name: 'Dark Roast Espresso',
+        description: 'A bold, smoky espresso for an intense coffee flavor.',
+        menuUrl: '/menu/espresso'
+      },
+      coldBrew: {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for a naturally smooth, refreshing cup.',
+        menuUrl: '/menu/cold-brew'
+      }
+    };
+
+    finderForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(finderForm);
+      const temperature = data.get('temperature');
+      const flavor = data.get('flavor');
+      let response;
+
+      if (!['hot', 'iced'].includes(temperature) || !['sweet', 'bold', 'smooth'].includes(flavor)) {
+        resultRegion.className = 'finder-result';
+        resultRegion.textContent = 'Choose a temperature and flavor so we can find your coffee.';
+        finderForm.reportValidity();
+        response = { error: 'Select a valid temperature (hot or iced) and flavor (sweet, bold, or smooth).' };
+      } else {
+        const coffee = flavor === 'bold' ? coffees.espresso
+          : flavor === 'smooth' && temperature === 'iced' ? coffees.coldBrew : coffees.latte;
+        const serving = temperature === 'iced' ? 'Serve over ice.' : 'Serve hot.';
+        response = {
+          coffee: coffee.name,
+          temperature,
+          flavor,
+          description: `${coffee.description} ${serving}`,
+          menuUrl: coffee.menuUrl
+        };
+
+        const heading = document.createElement('h3');
+        heading.textContent = `Your match: ${coffee.name}`;
+        const description = document.createElement('p');
+        description.textContent = response.description;
+        const link = document.createElement('a');
+        link.href = coffee.menuUrl;
+        link.textContent = 'Explore this coffee';
+        const linkParagraph = document.createElement('p');
+        linkParagraph.append(link);
+        resultRegion.className = 'finder-result';
+        resultRegion.replaceChildren(heading, description, linkParagraph);
+      }
+
+      // Ordinary submissions and agent invocations share validation and visible results.
+      if (event.agentInvoked && typeof event.respondWith === 'function') {
+        event.respondWith(Promise.resolve(response));
+      }
+    });
+
+    // A changed preference makes the previous recommendation stale.
+    finderForm.addEventListener('change', () => {
+      resultRegion.replaceChildren();
+      resultRegion.className = '';
+    });
+  </script>
+
