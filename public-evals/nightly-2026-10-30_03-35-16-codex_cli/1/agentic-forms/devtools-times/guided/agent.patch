diff --git a/src/utils/agentForms.ts b/src/utils/agentForms.ts
new file mode 100644
index 0000000..ad0154b
--- /dev/null
+++ b/src/utils/agentForms.ts
@@ -0,0 +1,12 @@
+type AgentSubmitEvent = Event & {
+  agentInvoked?: boolean;
+  respondWith?: (response: Promise<string>) => void;
+};
+
+// React wraps the browser's SubmitEvent; WebMCP methods live on the native event.
+export function respondToAgent(event: Event, response: Promise<string>) {
+  const submitEvent = event as AgentSubmitEvent;
+  if (submitEvent.agentInvoked && typeof submitEvent.respondWith === 'function') {
+    submitEvent.respondWith(response);
+  }
+}
