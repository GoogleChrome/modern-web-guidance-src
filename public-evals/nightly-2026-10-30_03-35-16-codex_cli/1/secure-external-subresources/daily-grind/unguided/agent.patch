+  <script>
+    // <img> integrity attributes do not verify images. Fetch verifies the pinned
+    // bytes before a local blob URL is displayed; never fall back to a remote src.
+    async function fetchVerifiedAsset(url, integrity) {
+      if (!('integrity' in Request.prototype)) {
+        throw new Error('This browser does not support integrity-checked Fetch.');
+      }
+      const response = await fetch(url, {
+        integrity,
+        mode: 'cors',
+        credentials: 'omit',
+        referrerPolicy: 'no-referrer'
+      });
+      if (!response.ok) throw new Error(`Asset request failed: ${response.status}`);
+      return response;
+    }
+
+    async function loadVerifiedImage(image) {
+      let objectURL;
+      try {
+        const response = await fetchVerifiedAsset(image.dataset.src, image.dataset.integrity);
+        objectURL = URL.createObjectURL(await response.blob());
+        image.src = objectURL;
+        await image.decode();
+      } catch (error) {
+        // Keep the solid hero background or card alt text if verification fails.
+        console.warn('Image unavailable:', image.dataset.asset, error);
+      } finally {
+        if (objectURL) URL.revokeObjectURL(objectURL);
+      }
+    }
+
+    async function loadVerifiedFont() {
+      try {
+        // A stylesheet's SRI does not cover fonts referenced inside that stylesheet.
+        const response = await fetchVerifiedAsset(
+          'https://cdn.jsdelivr.net/fontsource/fonts/lora@5.2.6/latin-600-normal.woff2',
+          'sha384-jcoBhRDSEf1s7E8BSKhvHtvEgR35dLJFGJcgv39PYAlkYKp7DCVHV3LS3wDijTWS'
+        );
+        const font = new FontFace('Lora', await response.arrayBuffer(), {
+          weight: '600', style: 'normal', display: 'swap'
+        });
+        document.fonts.add(await font.load());
+      } catch (error) {
+        console.warn('Font unavailable; using Georgia.', error);
+      }
+    }
+
+    document.addEventListener('DOMContentLoaded', () => {
+      loadVerifiedFont();
+      document.querySelectorAll('img[data-integrity]').forEach(loadVerifiedImage);
+
+      // This enhancement is optional; content stays visible if the CDN is blocked.
+      if (typeof window.anime === 'function' &&
+          !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        window.anime({
+          targets: '.hero h1, .hero p, .hero .btn',
+          translateY: [12, 0],
+          duration: 650,
+          delay: window.anime.stagger(100),
+          easing: 'easeOutQuad'
+        });
+      }
+    });
+  </script>
