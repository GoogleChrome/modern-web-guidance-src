+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+    const headingLines = [...heroHeading.querySelectorAll('span')];
+
+    // Fit the actual font size of each line, preserving natural letter spacing.
+    function fitHeadingLines() {
+      const availableWidth = heroHeading.clientWidth;
+      if (!availableWidth) return;
+
+      const sizes = headingLines.map(line => {
+        const currentSize = parseFloat(getComputedStyle(line).fontSize);
+        return currentSize * availableWidth / line.getBoundingClientRect().width;
+      });
+      headingLines.forEach((line, index) => {
+        line.style.fontSize = `${sizes[index]}px`;
+      });
+    }
+
+    fitHeadingLines();
+    document.fonts.ready.then(fitHeadingLines);
+
+    let previousWidth = heroHeading.clientWidth;
+    new ResizeObserver(() => {
+      const width = heroHeading.clientWidth;
+      if (width === previousWidth) return;
+      previousWidth = width;
+      fitHeadingLines();
+    }).observe(heroHeading);
+  </script>
