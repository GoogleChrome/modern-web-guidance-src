+  <script>
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const banner = document.querySelector('header.hero');
+    const thumbnails = [...document.querySelectorAll('.thumbnail')];
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const descriptions = {
+      'maple-oat-latte': 'Our seasonal favorite brings together rich espresso, silky oat milk, and a touch of Vermont maple syrup. A little warmth for the cooler days, made fresh with every cup.',
+      'dark-roast-espresso': 'A rich, full-bodied espresso with a bold, smoky finish. Our locally roasted beans are freshly ground and carefully extracted for a beautifully balanced morning boost.',
+      'cold-brew': 'Slowly steeped for 18 hours, our cold brew is smooth, mellow, and naturally sweet. Served over ice for a refreshing cup, just the way you like it.'
+    };
+    let selected = null;
+    let listScroll = 0;
+    let activeTransition = null;
+    let navigation = Promise.resolve();
+    history.scrollRestoration = 'manual';
+
+    function routeFromLocation() {
+      const slug = location.hash.slice(1).replace(/^favorite\//, '');
+      return thumbnails.find(card => card.dataset.favorite === slug) || null;
+    }
+
+    function clearTransitionNames() {
+      for (const element of [hero, title, ...thumbnails, ...document.querySelectorAll('.thumbnail .title')]) {
+        element.style.removeProperty('view-transition-name');
+      }
+    }
+
+    function namePair(image, heading) {
+      image.style.viewTransitionName = 'favorite-image';
+      heading.style.viewTransitionName = 'favorite-title';
+    }
+
+    async function showPage(card, animate = true) {
+      if (selected === card) return;
+      const previous = selected;
+      if (!previous) listScroll = window.scrollY;
+      const update = () => {
+        // Remove outgoing names before assigning the incoming pair: each name must be unique.
+        clearTransitionNames();
+        selected = card;
+        if (card) {
+          title.textContent = card.querySelector('.title').textContent;
+          hero.style.backgroundImage = card.style.backgroundImage;
+          hero.setAttribute('aria-label', title.textContent);
+          document.getElementById('detail-description').textContent = descriptions[card.dataset.favorite];
+        }
+        listPage.hidden = Boolean(card);
+        banner.hidden = Boolean(card);
+        detailPage.hidden = !card;
+        document.title = card ? `${title.textContent} | The Daily Grind` : 'The Daily Grind | Artisanal Coffee';
+        if (animate) {
+          if (card) namePair(hero, title);
+          else if (previous) namePair(previous, previous.querySelector('.title'));
+        }
+        window.scrollTo({ top: card ? 0 : listScroll, behavior: 'instant' });
+      };
+      const focusHeading = () => document.getElementById(card ? 'title' : 'list-heading').focus({ preventScroll: true });
+
+      if (!animate || reducedMotion.matches || !document.startViewTransition) {
+        try { update(); } finally { clearTransitionNames(); focusHeading(); }
+        return;
+      }
+
+      if (previous) namePair(hero, title);
+      else namePair(card, card.querySelector('.title'));
+      try {
+        activeTransition = document.startViewTransition(update);
+        // A skipped/failed visual transition must still complete the route update.
+        activeTransition.ready.catch(() => {});
+        await activeTransition.updateCallbackDone;
+        await activeTransition.finished;
+      } catch (error) {
+        if (selected !== card) update();
+      } finally {
+        activeTransition = null;
+        clearTransitionNames();
+        focusHeading();
+      }
+    }
+
+    function navigate(card) {
+      activeTransition?.skipTransition();
+      navigation = navigation.then(() => showPage(card));
+    }
+
+    for (const card of thumbnails) {
+      card.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        history.pushState({ favoriteFromList: true }, '', card.getAttribute('href'));
+        navigate(card);
+      });
+    }
+    document.getElementById('back-button').addEventListener('click', () => {
+      if (history.state?.favoriteFromList) history.back();
+      else {
+        history.replaceState(null, '', '#favorites');
+        navigate(null);
+      }
+    });
+    window.addEventListener('popstate', () => navigate(routeFromLocation()));
+    reducedMotion.addEventListener('change', event => {
+      if (event.matches) activeTransition?.skipTransition();
+    });
+    const initialCard = routeFromLocation();
+    if (initialCard) showPage(initialCard, false);
+  </script>
