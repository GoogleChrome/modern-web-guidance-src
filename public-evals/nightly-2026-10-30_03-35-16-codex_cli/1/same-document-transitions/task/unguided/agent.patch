+  <script>
+    const listPage = document.querySelector('#list-page');
+    const detailPage = document.querySelector('#detail-page');
+    const hero = document.querySelector('#hero');
+    const title = document.querySelector('#title');
+    const listHeading = document.querySelector('#list-heading');
+    const cards = [...document.querySelectorAll('.thumbnail')];
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const stories = {
+      'maple-oat-latte': 'Our seasonal latte pairs rich espresso with steamed oat milk and Vermont maple syrup. A cozy favorite for crisp mornings.',
+      'dark-roast-espresso': 'A deeply roasted espresso with a rich aroma and a lingering finish. Enjoy it slowly, one small sip at a time.',
+      'cold-brew': 'We steep our coffee for 18 hours to bring out its smooth, mellow character. Served over ice for a refreshing lift.'
+    };
+    let activeCard = null;
+    let runningTransition = null;
+    let navigationQueue = Promise.resolve();
+    let listScroll = 0;
+    history.scrollRestoration = 'manual';
+
+    function cardFromLocation() {
+      return cards.find(card => location.hash === card.getAttribute('href')) || null;
+    }
+
+    function render(card) {
+      activeCard = card;
+      if (card) {
+        hero.style.backgroundImage = card.style.backgroundImage;
+        title.textContent = card.querySelector('.title').textContent;
+        document.querySelector('#description').textContent = card.querySelector('p').textContent;
+        document.querySelector('#story').textContent = stories[card.dataset.favorite];
+      }
+      listPage.hidden = Boolean(card);
+      detailPage.hidden = !card;
+      document.title = card
+        ? `${title.textContent} | The Daily Grind`
+        : 'The Daily Grind | Artisanal Coffee';
+    }
+
+    function namePair(surface, heading) {
+      surface.style.viewTransitionName = 'coffee-hero';
+      heading.style.viewTransitionName = 'coffee-title';
+    }
+
+    function cleanTransition() {
+      document.documentElement.classList.remove('is-transitioning');
+      for (const element of [hero, title, ...cards, ...cards.map(card => card.querySelector('.title'))]) {
+        element.style.removeProperty('view-transition-name');
+      }
+    }
+
+    async function navigate(card) {
+      if (card === activeCard) return;
+      const previousCard = activeCard;
+      if (!previousCard) listScroll = window.scrollY;
+      const focusHeading = card ? title : listHeading;
+      const update = () => {
+        cleanTransition();
+        render(card);
+        if (card) {
+          document.querySelector('main').scrollIntoView({ behavior: 'instant', block: 'start' });
+        } else {
+          // Restore the exact list position so the returning card stays in place.
+          window.scrollTo({ top: listScroll, behavior: 'instant' });
+        }
+        focusHeading.focus({ preventScroll: true });
+        if (!reducedMotion.matches && document.startViewTransition) {
+          document.documentElement.classList.add('is-transitioning');
+          if (card) namePair(hero, title);
+          else namePair(previousCard, previousCard.querySelector('.title'));
+        }
+      };
+      if (!document.startViewTransition || reducedMotion.matches) {
+        update();
+        cleanTransition();
+        return;
+      }
+      // Only the outgoing and incoming pair receive names, avoiding duplicates.
+      if (previousCard) namePair(hero, title);
+      else namePair(card, card.querySelector('.title'));
+      document.documentElement.classList.add('is-transitioning');
+      try {
+        runningTransition = document.startViewTransition(update);
+        await runningTransition.finished;
+      } catch {
+        // A skipped or failed snapshot must still leave a usable destination.
+        if (activeCard !== card) update();
+      } finally {
+        runningTransition = null;
+        cleanTransition();
+        focusHeading.focus({ preventScroll: true });
+      }
+    }
+
+    function onRouteChange() {
+      const destination = cardFromLocation();
+      runningTransition?.skipTransition();
+      navigationQueue = navigationQueue.then(() => navigate(destination));
+    }
+
+    window.addEventListener('hashchange', onRouteChange);
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) runningTransition?.skipTransition();
+    });
+    document.querySelector('#back-link').addEventListener('click', event => {
+      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      if (history.state?.favoriteNavigation) {
+        event.preventDefault();
+        history.back();
+      }
+    });
+    for (const card of cards) {
+      card.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        history.pushState({ favoriteNavigation: !activeCard }, '', card.getAttribute('href'));
+        onRouteChange();
+      });
+    }
+    render(cardFromLocation());
+    if (activeCard) title.focus({ preventScroll: true });
+  </script>
