+  <script>
+    // Older browsers get the same live counts, including after DOM edits.
+    if (!CSS.supports('top: calc(sibling-index() * sibling-count() * 1px)')) {
+      const groups = new Set(
+        [...document.querySelectorAll('.spectrum-card, .fan-card, .circle-orb')]
+          .map(item => item.parentElement)
+      );
+      const updateGroup = group => {
+        const items = [...group.children];
+        items.forEach((item, index) => {
+          item.style.setProperty('--sibling-index', index + 1);
+          item.style.setProperty('--sibling-count', items.length);
+        });
+      };
+      groups.forEach(group => {
+        updateGroup(group);
+        new MutationObserver(() => updateGroup(group)).observe(group, { childList: true });
+      });
+    }
+  </script>
