+<script>
+    // Native sibling functions recalculate automatically. Older browsers receive
+    // the same inputs whenever children are inserted, removed, or reordered.
+    if (!CSS.supports('order', 'sibling-index()')) {
+      const main = document.querySelector('main');
+      const updateDistributions = () => {
+        main.querySelectorAll('.grid, .fan-container, .circle-container').forEach(container => {
+          const items = [...container.children].filter(item =>
+            item.matches('.card, .fan-card, .circle-orb'));
+          items.forEach((item, index) => {
+            item.style.setProperty('--item-index', index + 1);
+            item.style.setProperty('--item-count', items.length);
+          });
+        });
+      };
+      updateDistributions();
+      new MutationObserver(updateDistributions).observe(main, { childList: true, subtree: true });
+    }
+  </script>
