+  <script>
+    const order = new Map();
+    const orderItems = document.getElementById('order-items');
+    const orderSummary = document.getElementById('order-summary');
+    const orderCount = document.getElementById('order-count');
+    const orderStatus = document.getElementById('order-status');
+
+    function renderOrder() {
+      orderItems.replaceChildren();
+      let count = 0;
+      for (const [key, item] of order) {
+        count += item.quantity;
+        const row = document.createElement('li');
+        const description = document.createElement('span');
+        description.textContent = `${item.name} · ${item.size} × ${item.quantity}`;
+        const remove = document.createElement('button');
+        remove.type = 'button';
+        remove.className = 'remove-item';
+        remove.textContent = 'Remove';
+        remove.setAttribute('aria-label', `Remove ${item.size} ${item.name} from order`);
+        remove.addEventListener('click', () => {
+          const index = Array.from(order.keys()).indexOf(key);
+          order.delete(key);
+          renderOrder();
+          orderStatus.textContent = `Removed ${item.size} ${item.name}. ${orderCount.textContent} drinks in your order.`;
+          const remaining = orderItems.querySelectorAll('button');
+          const nextFocus = remaining[Math.min(index, remaining.length - 1)]
+            || document.querySelector(`[data-drink="${item.drink}"] button`);
+          nextFocus.focus();
+        });
+        row.append(description, remove);
+        orderItems.append(row);
+      }
+      orderCount.textContent = String(count);
+      orderSummary.hidden = count === 0;
+    }
+
+    document.querySelectorAll('form[data-drink]').forEach(form => {
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const size = new FormData(form).get('size');
+        const drink = form.dataset.drink;
+        const name = document.getElementById(`${drink}-title`).textContent;
+        const key = `${drink}:${size}`;
+        const item = order.get(key) || { drink, name, size, quantity: 0 };
+        item.quantity += 1;
+        order.set(key, item);
+        renderOrder();
+        orderStatus.textContent = `Added ${size} ${name}. ${orderCount.textContent} drinks in your order.`;
+      });
+    });
+  </script>
