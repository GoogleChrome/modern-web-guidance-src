+  <script>
+    const order = new Map();
+    const orderSummary = document.querySelector('.order-summary');
+    const orderItems = document.querySelector('#order-items');
+    const orderCount = document.querySelector('#order-count');
+
+    document.querySelectorAll('.drink-order').forEach((form) => {
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const size = new FormData(form).get('size');
+        const drink = form.dataset.drink;
+        const key = `${drink}:${size}`;
+        const item = order.get(key) || { drink, size, quantity: 0 };
+        item.quantity += 1;
+        order.set(key, item);
+
+        orderItems.replaceChildren();
+        let count = 0;
+        for (const entry of order.values()) {
+          const row = document.createElement('li');
+          row.textContent = `${entry.quantity} × ${entry.drink} — ${entry.size}`;
+          orderItems.append(row);
+          count += entry.quantity;
+        }
+        orderCount.textContent = count;
+        orderSummary.hidden = false;
+        form.closest('.card-content').querySelector('.card-status').textContent =
+          `Added ${size} ${drink}. ${count} ${count === 1 ? 'drink' : 'drinks'} in your order.`;
+      });
+    });
+  </script>
