+  <script>
+    (() => {
+      const map = document.getElementById('cafe-map');
+      const pins = [...map.querySelectorAll('.map-pin')];
+      let gesture = null;
+      let suppressClick = false;
+
+      function recenter() {
+        map.scrollLeft = 850 - map.clientWidth / 2;
+        map.scrollTop = 580 - map.clientHeight / 2;
+      }
+      document.getElementById('map-reset').addEventListener('click', recenter);
+      recenter();
+
+      map.addEventListener('pointerdown', (event) => {
+        if (!event.isPrimary || event.button !== 0) return;
+        suppressClick = false;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY,
+          dragging: false };
+        // Capture on the original target so a stationary tap still activates its pin.
+        event.target.setPointerCapture(event.pointerId);
+      });
+      map.addEventListener('pointermove', (event) => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.dragging && Math.hypot(dx, dy) > 4) {
+          gesture.dragging = true;
+          map.classList.add('is-dragging');
+        }
+        if (!gesture.dragging) return;
+        // Both coordinates update on every move, with no axis selection or lock.
+        map.scrollLeft -= dx;
+        map.scrollTop -= dy;
+        gesture.x = event.clientX;
+        gesture.y = event.clientY;
+      });
+      function endGesture(event) {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        suppressClick = gesture.dragging;
+        gesture = null;
+        map.classList.remove('is-dragging');
+      }
+      map.addEventListener('pointerup', endGesture);
+      map.addEventListener('pointercancel', endGesture);
+      map.addEventListener('lostpointercapture', endGesture);
+      map.addEventListener('click', (event) => {
+        if (suppressClick && event.detail !== 0) {
+          event.preventDefault();
+          event.stopPropagation();
+          suppressClick = false;
+        }
+      }, true);
+      pins.forEach((pin) => pin.addEventListener('click', () => {
+        pins.forEach((item) => item.setAttribute('aria-pressed', String(item === pin)));
+        document.getElementById('cafe-name').textContent = pin.dataset.name;
+        document.getElementById('cafe-description').textContent = pin.dataset.description;
+      }));
+    })();
+  </script>
+
