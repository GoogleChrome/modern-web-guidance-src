+  <script>
+    (() => {
+      const progress = document.getElementById('scroll-progress');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const nativeTimeline = window.CSS && CSS.supports('animation-timeline', 'scroll(root block)');
+      let framePending = false;
+
+      function updateProgress() {
+        framePending = false;
+        if (nativeTimeline && !reducedMotion.matches) return;
+
+        const root = document.scrollingElement || document.documentElement;
+        const distance = root.scrollHeight - document.documentElement.clientHeight;
+        const fraction = distance > 0 ? Math.min(1, Math.max(0, root.scrollTop / distance)) : 0;
+        // Track position directly, without easing or extra motion.
+        progress.style.transform = `scaleX(${fraction})`;
+      }
+
+      function scheduleUpdate() {
+        if (framePending || (nativeTimeline && !reducedMotion.matches)) return;
+        framePending = true;
+        window.requestAnimationFrame(updateProgress);
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('load', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', scheduleUpdate);
+      } else {
+        reducedMotion.addListener(scheduleUpdate);
+      }
+      if ('ResizeObserver' in window) {
+        const observer = new ResizeObserver(scheduleUpdate);
+        observer.observe(document.body);
+        observer.observe(document.documentElement);
+      }
+      updateProgress();
+    })();
+  </script>
 </body>
 
