@@ -0,0 +1,129 @@
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { REPORT_PATH, securityHeaders } = require('./security');
+
+const MAX_REPORT_BYTES = 16 * 1024;
+const DIRECTIVES = new Set([
+  'default-src', 'script-src', 'script-src-elem', 'script-src-attr', 'style-src',
+  'style-src-elem', 'style-src-attr', 'img-src', 'connect-src', 'font-src',
+  'media-src', 'frame-src', 'worker-src', 'object-src', 'base-uri',
+  'frame-ancestors', 'form-action', 'require-trusted-types-for', 'trusted-types',
+]);
+
+function createHandler({ readFile = fs.readFile, logReport = (report) => console.warn(JSON.stringify(report)),
+  now = Date.now, ...options } = {}) {
+  const headers = securityHeaders(options);
+  let reportWindow = 0;
+  let reportsReceived = 0;
+
+  return async function handleRequest(req, res) {
+    for (const [name, value] of Object.entries(headers)) res.setHeader(name, value);
+    const send = (status, body = '', type = 'text/plain; charset=utf-8') => {
+      res.writeHead(status, { 'Content-Type': type });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    };
+
+    let pathname;
+    try {
+      // The request Host header is untrusted and never used to generate response headers.
+      if (!req.url.startsWith('/') || req.url.startsWith('//')) throw new Error('Invalid target');
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      send(400, 'Bad request');
+      return;
+    }
+
+    if (pathname === REPORT_PATH) {
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        send(405, 'Method not allowed');
+        return;
+      }
+      const type = (req.headers['content-type'] || '').split(';')[0].trim().toLowerCase();
+      if (!['application/csp-report', 'application/reports+json', 'application/json'].includes(type)) {
+        req.resume();
+        send(415, 'Unsupported report type');
+        return;
+      }
+      const currentWindow = Math.floor(now() / 60000);
+      if (reportWindow !== currentWindow) {
+        reportWindow = currentWindow;
+        reportsReceived = 0;
+      }
+      // Bound parsing and log volume per process, without storing visitor identifiers.
+      if (++reportsReceived > 30) {
+        req.resume();
+        res.setHeader('Retry-After', '60');
+        send(429, 'Too many reports');
+        return;
+      }
+      let bytes = 0;
+      const chunks = [];
+      try {
+        for await (const chunk of req.iterator({ destroyOnReturn: false })) {
+          bytes += Buffer.byteLength(chunk);
+          if (bytes > MAX_REPORT_BYTES) {
+            req.resume();
+            send(413, 'Report too large');
+            return;
+          }
+          chunks.push(Buffer.from(chunk));
+        }
+        const payload = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+        const reports = Array.isArray(payload) ? payload : [payload];
+        if (reports.length > 20) {
+          send(413, 'Too many reports in batch');
+          return;
+        }
+        for (const report of reports) {
+          const body = report?.['csp-report'] ?? (report?.type === 'csp-violation' ? report.body : null);
+          if (!body || typeof body !== 'object') continue;
+          const directive = body['effective-directive'] ?? body.effectiveDirective;
+          const disposition = body.disposition;
+          // Only log finite, known categories. Never log URLs, samples, headers, or the raw body.
+          if (DIRECTIVES.has(directive)) {
+            logReport({ type: 'csp-violation', directive,
+              disposition: ['enforce', 'report'].includes(disposition) ? disposition : 'unknown' });
+          }
+        }
+      } catch {
+        send(400, 'Invalid report');
+        return;
+      }
+      send(204);
+      return;
+    }
+
+    const logout = pathname === '/logout' || pathname === '/logout/';
+    const site = req.headers['sec-fetch-site'];
+    if (site && !['same-origin', 'none'].includes(site)) {
+      const navigation = req.headers['sec-fetch-mode'] === 'navigate' &&
+        req.headers['sec-fetch-dest'] === 'document' && ['GET', 'HEAD'].includes(req.method);
+      if (!navigation || logout) {
+        send(403, 'Forbidden');
+        return;
+      }
+    }
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      send(405, 'Method not allowed');
+      return;
+    }
+    if (logout) {
+      res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+      send(200, 'Logged out');
+      return;
+    }
+
+    // Preserve existing document-route fallback; only this explicit asset can be served.
+    const stylesheet = pathname === '/styles.css';
+    try {
+      const data = await readFile(path.join(__dirname, stylesheet ? 'styles.css' : 'index.html'));
+      send(200, data, stylesheet ? 'text/css; charset=utf-8' : 'text/html; charset=utf-8');
+    } catch {
+      send(500, 'Server error');
+    }
+  };
+}
+
+module.exports = { createHandler };
