+test('report ingestion rejects invalid, oversized, and excessive submissions', async () => {
+  const logs = [];
+  const handler = createHandler({ logReport: (r) => logs.push(r) });
+  const base = { url: '/security-reports', method: 'POST', headers: { 'content-type': 'application/json' } };
+  assert.equal((await request(handler, { ...base, body: '{' })).status, 400);
+  assert.equal((await request(handler, { ...base, headers: { 'content-type': 'text/plain' } })).status, 415);
+  assert.equal((await request(handler, { ...base, body: ['a'.repeat(8192), 'b'.repeat(8193)] })).status, 413);
+  assert.equal((await request(handler, { ...base, body: JSON.stringify(Array(21).fill({})) })).status, 413);
+  assert.equal((await request(handler, { url: '/security-reports' })).status, 405);
+  await request(handler, { ...base, body: JSON.stringify({ 'csp-report': {
+    'effective-directive': 'SECRET\nforged log', disposition: 'SECRET',
+  } }) });
+  assert.deepEqual(logs, []);
+  let time = 0;
+  const limited = createHandler({ now: () => time, logReport() {} });
+  for (let i = 0; i < 30; i++) assert.equal((await request(limited, { ...base, body: '{}' })).status, 204);
+  assert.equal((await request(limited, { ...base, body: '{}' })).status, 429);
+  time += 60000;
+  assert.equal((await request(limited, { ...base, body: '{}' })).status, 204);
+});
+
+test('request-controlled Host never becomes a reporting endpoint', async () => {
+  const res = await request(createHandler({ publicOrigin: 'https://coffee.example' }), {
+    headers: { host: 'attacker.example', 'x-forwarded-proto': 'https' },
+  });
+  assert.equal(res.headers['reporting-endpoints'], 'security="https://coffee.example/security-reports"');
+  assert.doesNotMatch(JSON.stringify(res.headers), /attacker/);
+});
