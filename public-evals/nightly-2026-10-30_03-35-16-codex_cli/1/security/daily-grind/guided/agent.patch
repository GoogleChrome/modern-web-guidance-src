+test('CSP reporting accepts both formats and logs only safe categorical fields', async () => {
+  const logs = [];
+  const handler = createHandler({ logReport: (report) => logs.push(report) });
+  const legacy = { 'csp-report': {
+    'effective-directive': 'script-src-elem', disposition: 'enforce',
+    'document-uri': 'https://coffee.example/account?token=SECRET',
+    'script-sample': 'SECRET', 'blocked-uri': 'https://evil.example/SECRET',
+  } };
+  const modern = [{ type: 'csp-violation', url: 'SECRET', body: {
+    effectiveDirective: 'require-trusted-types-for', disposition: 'report', sample: 'SECRET',
+  } }];
+  for (const [payload, type] of [[legacy, 'application/csp-report'], [modern, 'application/reports+json']]) {
+    const res = await request(handler, { url: '/security-reports', method: 'POST',
+      headers: { 'content-type': type }, body: JSON.stringify(payload) });
+    assert.equal(res.status, 204);
+    assert.equal(res.body, '');
+  }
+  assert.deepEqual(logs, [
+    { type: 'csp-violation', directive: 'script-src-elem', disposition: 'enforce' },
+    { type: 'csp-violation', directive: 'require-trusted-types-for', disposition: 'report' },
+  ]);
+});
