+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { Readable } = require('node:stream');
+const { createHandler } = require('../request-handler');
+const { securityHeaders } = require('../security');
+
+// Exercise the handler without importing server.js, opening a socket, or starting a server.
+async function request(handler, { url = '/', method = 'GET', headers = {}, body = '' } = {}) {
+  const req = Readable.from(Array.isArray(body) ? body : [Buffer.from(body)]);
+  Object.assign(req, { url, method, headers });
+  const res = {
+    headers: {}, status: null, body: null,
+    setHeader(name, value) { this.headers[name.toLowerCase()] = value; },
+    writeHead(status, values = {}) {
+      this.status = status;
+      for (const [name, value] of Object.entries(values)) this.setHeader(name, value);
+    },
+    end(data) { this.body = data === undefined ? '' : String(data); },
+  };
+  await handler(req, res);
+  return res;
+}
+
+test('audited markup and stylesheet comply with the enforced resource policy', async () => {
+  const handler = createHandler();
+  const page = await request(handler);
+  assert.equal(page.status, 200);
+  assert.doesNotMatch(page.body, /<script\b|<style\b|\bstyle\s*=|\bon\w+\s*=|javascript:/i);
+  assert.match(page.body, /<link rel="stylesheet" href="\/styles.css">/);
+  const css = await request(handler, { url: '/styles.css' });
+  assert.equal(css.headers['content-type'], 'text/css; charset=utf-8');
+  assert.match(css.body, /\.section-title\s*\{\s*text-align: center;/);
+  const origins = [...css.body.matchAll(/url\(['"]?(https?:[^'"\s)]+)/g)].map((m) => new URL(m[1]).origin);
+  assert.deepEqual(origins, ['https://images.unsplash.com']);
+  assert.doesNotMatch(css.body, /@import/i);
+  const csp = page.headers['content-security-policy'];
+  for (const directive of ["default-src 'none'", "script-src 'none'", "style-src 'self'",
+    'img-src https://images.unsplash.com', "object-src 'none'", "base-uri 'none'",
+    "frame-ancestors 'self'", "require-trusted-types-for 'script'", "trusted-types 'none'",
+    'report-uri /security-reports']) assert.ok(csp.split('; ').includes(directive), directive);
+  assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval|\*/);
+});
+
+test('companion headers cover pages, styles, logout, malformed requests and errors', async () => {
+  const handler = createHandler();
+  for (const url of ['/', '/account', '/styles.css', '/logout', '//bad-target']) {
+    const res = await request(handler, { url });
+    assert.equal(res.headers['x-content-type-options'], 'nosniff');
+    assert.equal(res.headers['x-frame-options'], 'SAMEORIGIN');
+    assert.equal(res.headers['referrer-policy'], 'strict-origin-when-cross-origin');
+    assert.equal(res.headers['cross-origin-opener-policy'], 'same-origin-allow-popups');
+    assert.equal(res.headers['cross-origin-resource-policy'], 'same-origin');
+    assert.match(res.headers['permissions-policy'], /camera=\(\)/);
+    assert.equal(res.headers['cache-control'], 'no-store');
+  }
+  const failed = await request(createHandler({ readFile: async () => { throw Error('private path'); } }));
+  assert.equal(failed.status, 500);
+  assert.equal(failed.body, 'Server error');
+  assert.ok(failed.headers['content-security-policy']);
+  assert.equal((await request(handler, { url: '//bad-target' })).status, 400);
+});
+
+test('HTTPS deployment uses a trusted configured origin, with staged HSTS', () => {
+  const headers = securityHeaders({ publicOrigin: 'https://coffee.example' });
+  assert.equal(headers['Reporting-Endpoints'], 'security="https://coffee.example/security-reports"');
+  assert.match(headers['Content-Security-Policy'], /report-to security/);
+  assert.equal(headers['Strict-Transport-Security'], 'max-age=300');
+  assert.equal(securityHeaders()['Strict-Transport-Security'], undefined);
+  for (const publicOrigin of ['http://coffee.example', 'https://user:secret@coffee.example',
+    'https://coffee.example/path', 'https://coffee.example?secret=1']) {
+    assert.throws(() => securityHeaders({ publicOrigin }));
+  }
+  for (const hstsMaxAge of [-1, NaN, 31536001, 1.5]) {
+    assert.throws(() => securityHeaders({ hstsMaxAge }));
+  }
+  assert.throws(() => securityHeaders({ policyMode: 'typo' }));
+});
+
+test('report-only mode retains clickjacking and base/plugin protection', () => {
+  const headers = securityHeaders({ policyMode: 'report-only' });
+  assert.match(headers['Content-Security-Policy-Report-Only'], /script-src 'none'/);
+  assert.match(headers['Content-Security-Policy'], /frame-ancestors 'self'/);
+  assert.doesNotMatch(headers['Content-Security-Policy'], /script-src/);
+});
+
+test('Fetch Metadata blocks cross-site resources while permitting document navigation', async () => {
+  const handler = createHandler();
+  for (const site of ['cross-site', 'same-site']) {
+    const headers = { 'sec-fetch-site': site, 'sec-fetch-mode': 'no-cors', 'sec-fetch-dest': 'style' };
+    const blocked = await request(handler, { url: '/styles.css', headers });
+    assert.equal(blocked.status, 403);
+    assert.match(blocked.headers.vary, /Sec-Fetch-Site/);
+    const navigation = { ...headers, 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'document' };
+    assert.equal((await request(handler, { headers: navigation })).status, 200);
+    assert.equal((await request(handler, { url: '/logout', headers: navigation })).status, 403);
+  }
+  assert.equal((await request(handler, { headers: { 'sec-fetch-site': 'same-origin' } })).status, 200);
+  assert.equal((await request(handler)).status, 200); // legacy clients without Fetch Metadata
+});
+
+test('HEAD has no body and logout clears client data on both supported paths', async () => {
+  const handler = createHandler();
+  assert.equal((await request(handler, { method: 'HEAD' })).body, '');
+  for (const url of ['/logout', '/logout/']) {
+    const logout = await request(handler, { url });
+    assert.equal(logout.body, 'Logged out');
+    assert.equal(logout.headers['clear-site-data'], '"cookies", "storage", "cache"');
+  }
+  assert.equal((await request(handler, { method: 'POST' })).status, 405);
+});
