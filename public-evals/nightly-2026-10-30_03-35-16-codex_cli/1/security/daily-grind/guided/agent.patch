+const REPORT_PATH = '/security-reports';
+
+function securityHeaders({ policyMode = 'enforce', publicOrigin, hstsMaxAge = 300 } = {}) {
+  if (!['enforce', 'report-only'].includes(policyMode)) {
+    throw new Error('SECURITY_POLICY_MODE must be enforce or report-only');
+  }
+  if (!Number.isSafeInteger(hstsMaxAge) || hstsMaxAge < 0 || hstsMaxAge > 31536000) {
+    throw new Error('HSTS_MAX_AGE must be an integer from 0 to 31536000');
+  }
+  let origin;
+  if (publicOrigin) {
+    const url = new URL(publicOrigin);
+    if (url.protocol !== 'https:' || url.username || url.password ||
+        url.pathname !== '/' || url.search || url.hash) {
+      throw new Error('PUBLIC_ORIGIN must be an HTTPS origin without credentials, path, query, or fragment');
+    }
+    origin = url.origin;
+  }
+
+  const policy = [
+    "default-src 'none'",
+    // There are no scripts to authorize. Do not add a nonce or permissive default policy.
+    "script-src 'none'",
+    "script-src-attr 'none'",
+    "style-src 'self'",
+    "style-src-attr 'none'",
+    'img-src https://images.unsplash.com',
+    "connect-src 'none'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'self'",
+    "form-action 'none'",
+    "require-trusted-types-for 'script'",
+    "trusted-types 'none'",
+    ...(origin ? ['report-to security'] : []),
+    `report-uri ${REPORT_PATH}`,
+  ].join('; ');
+
+  const headers = {
+    'X-Content-Type-Options': 'nosniff',
+    'X-Frame-Options': 'SAMEORIGIN',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Permissions-Policy': 'camera=(), geolocation=(), microphone=(), focus-without-user-activation=()',
+    'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+    'Cross-Origin-Resource-Policy': 'same-origin',
+    'Cache-Control': 'no-store',
+    'Vary': 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site',
+  };
+  if (policyMode === 'report-only') {
+    headers['Content-Security-Policy-Report-Only'] = policy;
+    // Keep low-risk protections enforced while evaluating a future policy change.
+    headers['Content-Security-Policy'] = "object-src 'none'; base-uri 'none'; frame-ancestors 'self'";
+  } else {
+    headers['Content-Security-Policy'] = policy;
+  }
+  if (origin) {
+    headers['Reporting-Endpoints'] = `security="${origin}${REPORT_PATH}"`;
+    // Opt into HSTS only for a configured HTTPS deployment, with a short initial lifetime.
+    headers['Strict-Transport-Security'] = `max-age=${hstsMaxAge}`;
+  }
+  return headers;
+}
+
+module.exports = { REPORT_PATH, securityHeaders };
