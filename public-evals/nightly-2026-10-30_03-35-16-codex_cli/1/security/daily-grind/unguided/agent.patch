diff --git a/test/security.test.js b/test/security.test.js
new file mode 100644
index 0000000..712fe66
--- /dev/null
+++ b/test/security.test.js
@@ -0,0 +1,91 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { createHandler } = require('../handler');
+const { CONTENT_SECURITY_POLICY, securityHeaders } = require('../security');
+
+async function request(url, { method = 'GET', ...options } = {}) {
+  const result = { headers: {} };
+  const response = {
+    setHeader(name, value) { result.headers[name] = value; },
+    writeHead(status, headers) { result.status = status; Object.assign(result.headers, headers); },
+    end(body) { result.body = body?.toString(); },
+  };
+  await createHandler(options)({ url, method, headers: { host: '[invalid-host' } }, response);
+  return result;
+}
+
+test('markup and asset dependencies remain compatible with the strict policy', async () => {
+  const html = await fs.readFile(path.join(__dirname, '../index.html'), 'utf8');
+  const css = await fs.readFile(path.join(__dirname, '../assets/styles.css'), 'utf8');
+  assert.doesNotMatch(html, /<\s*(?:script|style|base|iframe|object|embed|form)\b/i);
+  assert.doesNotMatch(html, /\s(?:on[a-z]+|style)\s*=/i);
+  assert.doesNotMatch(html, /(?:javascript|data):/i);
+  assert.match(html, /<link rel="stylesheet" href="\/assets\/styles\.css">/);
+  for (const match of html.matchAll(/(?:href|src)="([^"]+)"/g)) {
+    assert.match(match[1], /^\/(?!\/)/, 'HTML URLs must stay same-origin');
+  }
+  assert.doesNotMatch(css, /@import|expression\s*\(/i);
+  const images = [...css.matchAll(/url\(['"]?([^'"\)]+)['"]?\)/g)];
+  assert.equal(images.length, 1);
+  assert.equal(new URL(images[0][1]).origin, 'https://images.unsplash.com');
+});
+
+test('CSP denies executable content and injection escape routes', () => {
+  for (const directive of ["default-src 'none'", "script-src 'none'", "style-src 'self'",
+    "style-src-attr 'none'", "object-src 'none'", "base-uri 'none'", "form-action 'none'",
+    "frame-ancestors 'none'", "connect-src 'none'", "require-trusted-types-for 'script'", "trusted-types 'none'"]) {
+    assert.ok(CONTENT_SECURITY_POLICY.split('; ').includes(directive), directive);
+  }
+  assert.doesNotMatch(CONTENT_SECURITY_POLICY, /unsafe-inline|unsafe-eval|\*/);
+});
+
+test('staging mode reports without enforcing CSP and rejects invalid modes', () => {
+  const headers = securityHeaders({ cspMode: 'report-only' });
+  assert.equal(headers['Content-Security-Policy-Report-Only'], CONTENT_SECURITY_POLICY);
+  assert.equal(headers['Content-Security-Policy'], undefined);
+  assert.equal(headers['X-Frame-Options'], 'DENY');
+  assert.throws(() => securityHeaders({ cspMode: 'typo' }), /CSP_MODE/);
+});
+
+test('HSTS is explicitly enabled for an HTTPS deployment', () => {
+  assert.equal(securityHeaders()['Strict-Transport-Security'], undefined);
+  assert.equal(securityHeaders({ enableHsts: true })['Strict-Transport-Security'], 'max-age=86400');
+});
+
+test('pages, logout, assets, and errors all carry the security headers', async () => {
+  for (const [url, options, status, type] of [
+    ['/', {}, 200, 'text/html'],
+    ['/menu?query=%3Cscript%3E', {}, 200, 'text/html'],
+    ['/logout', {}, 200, 'text/plain'],
+    ['/logout/', {}, 200, 'text/plain'],
+    ['/assets/styles.css?v=1', {}, 200, 'text/css'],
+    ['/assets/missing.js', {}, 404, 'text/plain'],
+    ['http://[invalid', {}, 400, 'text/plain'],
+    ['/', { method: 'POST' }, 405, 'text/plain'],
+    ['/', { readFile: async () => { throw new Error('private filesystem detail'); } }, 500, 'text/plain'],
+  ]) {
+    const result = await request(url, options);
+    assert.equal(result.status, status, url);
+    assert.ok(result.headers['Content-Type'].startsWith(type), url);
+    for (const [name, value] of Object.entries(securityHeaders())) {
+      assert.equal(result.headers[name], value, `${url}: ${name}`);
+    }
+    assert.doesNotMatch(result.body, /private filesystem detail|<script>/);
+  }
+});
+
+test('stylesheet is served as CSS, with the existing design intact', async () => {
+  const result = await request('/assets/styles.css');
+  assert.match(result.body, /--primary: #4e342e/);
+  assert.match(result.body, /\.section-title\s*\{\s*text-align: center/);
+});
+
+test('HEAD returns the same policy without a body', async () => {
+  for (const url of ['/', '/assets/styles.css', '/logout', '/assets/missing']) {
+    const result = await request(url, { method: 'HEAD' });
+    assert.equal(result.body, undefined);
+    assert.equal(result.headers['Content-Security-Policy'], CONTENT_SECURITY_POLICY);
+  }
+});
