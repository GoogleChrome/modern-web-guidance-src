new file mode 100644
index 0000000..a9ea052
--- /dev/null
+++ b/handler.js
@@ -0,0 +1,51 @@
+'use strict';
+
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const { securityHeaders } = require('./security');
+
+// Keep request handling separate from the entrypoint so checks never start a server.
+function createHandler({ cspMode, enableHsts, readFile = fs.readFile } = {}) {
+  const headers = securityHeaders({ cspMode, enableHsts });
+  return async (req, res) => {
+    for (const [name, value] of Object.entries(headers)) res.setHeader(name, value);
+
+    const send = (status, type, body) => {
+      res.writeHead(status, { 'Content-Type': type });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    };
+    if (req.method !== 'GET' && req.method !== 'HEAD') {
+      res.setHeader('Allow', 'GET, HEAD');
+      send(405, 'text/plain; charset=utf-8', 'Method not allowed');
+      return;
+    }
+
+    let pathname;
+    try {
+      // Never use the untrusted Host header as the URL parsing base.
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      send(400, 'text/plain; charset=utf-8', 'Bad request');
+      return;
+    }
+    if (pathname === '/logout' || pathname === '/logout/') {
+      send(200, 'text/plain; charset=utf-8', 'Logged out');
+      return;
+    }
+
+    // Only explicitly mapped assets can be read; URL paths never reach the filesystem.
+    const isStylesheet = pathname === '/assets/styles.css';
+    if (pathname.startsWith('/assets/') && !isStylesheet) {
+      send(404, 'text/plain; charset=utf-8', 'Not found');
+      return;
+    }
+    try {
+      const data = await readFile(path.join(__dirname, isStylesheet ? 'assets/styles.css' : 'index.html'));
+      send(200, isStylesheet ? 'text/css; charset=utf-8' : 'text/html; charset=utf-8', data);
+    } catch {
+      send(500, 'text/plain; charset=utf-8', 'Server error');
+    }
+  };
+}
+
+module.exports = { createHandler };
