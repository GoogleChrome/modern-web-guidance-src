+++ b/security.js
@@ -0,0 +1,37 @@
+'use strict';
+
+// This site needs CSS and one image origin, but no JavaScript or network APIs.
+const CONTENT_SECURITY_POLICY = [
+  "default-src 'none'",
+  "script-src 'none'",
+  "script-src-attr 'none'",
+  "style-src 'self'",
+  "style-src-attr 'none'",
+  'img-src https://images.unsplash.com',
+  "connect-src 'none'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "form-action 'none'",
+  "frame-ancestors 'none'",
+  "require-trusted-types-for 'script'",
+  "trusted-types 'none'",
+].join('; ');
+
+function securityHeaders({ cspMode = 'enforce', enableHsts = false } = {}) {
+  if (!['enforce', 'report-only'].includes(cspMode)) {
+    throw new Error('CSP_MODE must be enforce or report-only');
+  }
+  return {
+    [cspMode === 'enforce' ? 'Content-Security-Policy' : 'Content-Security-Policy-Report-Only']:
+      CONTENT_SECURITY_POLICY,
+    'X-Content-Type-Options': 'nosniff',
+    'X-Frame-Options': 'DENY',
+    'Referrer-Policy': 'no-referrer',
+    'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=()',
+    // Avoid caching account/logout content or retaining an old policy on HTML.
+    'Cache-Control': 'no-store',
+    ...(enableHsts ? { 'Strict-Transport-Security': 'max-age=86400' } : {}),
+  };
+}
+
+module.exports = { CONTENT_SECURITY_POLICY, securityHeaders };
