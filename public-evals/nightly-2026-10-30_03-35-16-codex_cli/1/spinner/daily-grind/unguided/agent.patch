+  <script>
+    const loadingStatus = document.getElementById('loading-status');
+    const seasonalFavorites = document.getElementById('seasonal-favorites');
+    const loadingLinks = Array.from(document.querySelectorAll('[data-loading-message]'), (link) => ({
+      link,
+      label: link.querySelector('.btn-label'),
+      originalText: link.querySelector('.btn-label').textContent,
+      originalAriaLabel: link.getAttribute('aria-label')
+    }));
+
+    loadingLinks.forEach(({ link, label }) => {
+      link.addEventListener('click', (event) => {
+        // Preserve native new-tab, download, and modified-click behavior.
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey ||
+            event.shiftKey || event.altKey || link.hasAttribute('download') ||
+            (link.target && link.target !== '_self')) return;
+
+        if (link.getAttribute('aria-busy') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        link.setAttribute('aria-label', link.dataset.loadingMessage);
+        label.textContent = link.closest('#seasonal-favorites') ? 'Loading details…' : 'Starting order…';
+        if (seasonalFavorites.contains(link)) seasonalFavorites.setAttribute('aria-busy', 'true');
+        loadingStatus.textContent = link.dataset.loadingMessage;
+        // Let the anchor perform its normal navigation while the page is busy.
+      });
+    });
+
+    // A page restored from the back/forward cache must be ready to use again.
+    window.addEventListener('pageshow', () => {
+      loadingLinks.forEach(({ link, label, originalText, originalAriaLabel }) => {
+        link.setAttribute('aria-busy', 'false');
+        link.removeAttribute('aria-disabled');
+        if (originalAriaLabel === null) link.removeAttribute('aria-label');
+        else link.setAttribute('aria-label', originalAriaLabel);
+        label.textContent = originalText;
+      });
+      seasonalFavorites.setAttribute('aria-busy', 'false');
+      loadingStatus.textContent = '';
+    });
+  </script>
