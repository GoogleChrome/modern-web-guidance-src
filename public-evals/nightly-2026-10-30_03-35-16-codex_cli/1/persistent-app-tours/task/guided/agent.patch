+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTour = tourStep.querySelector('button');
+    const hasPopover = 'popover' in HTMLElement.prototype;
+    const hasAnchors = CSS.supports('anchor-name: --rewards') &&
+      CSS.supports('top: anchor(bottom)');
+    let tourOpen = true;
+    let trackingFrame;
+
+    // Track layout changes as well as scrolling and resizing in older browsers.
+    function trackRewards() {
+      const target = rewardsLink.getBoundingClientRect();
+      const panel = tourStep.getBoundingClientRect();
+      const left = Math.max(12, Math.min(target.left + target.width / 2,
+        window.innerWidth - panel.width - 12));
+      tourStep.style.left = `${left}px`;
+      tourStep.style.top = `${target.bottom + 12}px`;
+      trackingFrame = requestAnimationFrame(trackRewards);
+    }
+
+    if (!hasPopover) tourStep.removeAttribute('popover');
+    tourStep.hidden = false;
+    if (hasPopover) tourStep.showPopover();
+    if (!hasAnchors) trackRewards();
+    closeTour.focus({ preventScroll: true });
+
+    function preventTourNavigation(event) {
+      if (tourOpen) event.preventDefault();
+    }
+    rewardsLink.addEventListener('click', preventTourNavigation);
+    rewardsLink.addEventListener('auxclick', preventTourNavigation);
+
+    closeTour.addEventListener('click', (event) => {
+      event.preventDefault();
+      tourOpen = false;
+      cancelAnimationFrame(trackingFrame);
+      if (hasPopover) tourStep.hidePopover();
+      tourStep.hidden = true;
+      rewardsLink.focus({ preventScroll: true });
+    });
+  </script>
 </body>
 
