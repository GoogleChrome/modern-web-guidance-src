--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,12 @@
+import { cp, mkdir, rm } from 'node:fs/promises';
+import { resolve, join } from 'node:path';
+
+const root = resolve(import.meta.dirname, '..');
+const output = join(root, 'dist');
+await rm(output, { recursive: true, force: true });
+await mkdir(output, { recursive: true });
+// Publish only reviewed public files, never source tools, configuration, or Git data.
+for (const path of ['index.html', 'privacy-policy', 'assets', '_headers']) {
+  await cp(join(root, path), join(output, path), { recursive: true });
+}
+console.log('Built static site in dist/. No server started.');
diff --git a/scripts/check-privacy.mjs b/scripts/check-privacy.mjs
new file mode 100644
index 0000000..7f532a7
--- /dev/null
+++ b/scripts/check-privacy.mjs
@@ -0,0 +1,87 @@
+import assert from 'node:assert/strict';
+import { readFile, readdir, stat } from 'node:fs/promises';
+import { resolve, join } from 'node:path';
+
+const root = resolve(import.meta.dirname, '..');
+const read = (path) => readFile(join(root, path), 'utf8');
+const headers = JSON.parse(await read('security-headers.json'));
+const csp = headers['Content-Security-Policy'];
+for (const directive of [
+  "default-src 'none'", "script-src 'none'", "connect-src 'none'",
+  "style-src 'self'", "img-src 'self'", "object-src 'none'",
+  "base-uri 'none'", "form-action 'none'", "frame-src 'none'",
+  "frame-ancestors 'none'", "require-trusted-types-for 'script'",
+]) assert(csp.split('; ').includes(directive), `Missing CSP boundary: ${directive}`);
+assert(!/unsafe-inline|unsafe-eval|https:|\*/i.test(csp), 'CSP must not permit broad sources');
+assert.equal(headers['Referrer-Policy'], 'no-referrer');
+assert.equal(headers['X-Content-Type-Options'], 'nosniff');
+assert.equal(headers['X-Frame-Options'], 'DENY');
+for (const feature of ['camera', 'microphone', 'geolocation', 'payment', 'usb']) {
+  assert(headers['Permissions-Policy'].split(', ').includes(`${feature}=()`));
+}
+assert.equal(headers['Cross-Origin-Resource-Policy'], 'same-origin');
+assert.match(headers['Strict-Transport-Security'], /^max-age=\d+$/);
+const expectedHeaders = '/*\n' + Object.entries(headers).map(([key, value]) => `  ${key}: ${value}\n`).join('');
+assert.equal(await read('_headers'), expectedHeaders, '_headers must match security-headers.json');
+const vercel = JSON.parse(await read('vercel.json'));
+assert.equal(vercel.headers[0].source, '/(.*)');
+assert.deepEqual(Object.fromEntries(vercel.headers[0].headers.map(({ key, value }) => [key, value])), headers);
+assert.equal(vercel.outputDirectory, 'dist');
+
+// Intentionally conservative: this small static site requires no executable content.
+// This is a regression guard for reviewed source, not a general HTML sanitizer.
+function checkMarkup(source, path) {
+  assert(!/<\s*(script|iframe|object|embed|form|input|textarea|select|base)\b/i.test(source), `${path}: executable, embedded, or collecting markup needs review`);
+  assert(!/\s(?:on[\w-]+|style|ping|srcdoc)\s*=/i.test(source), `${path}: inline code/style or link tracking`);
+  assert(!/\s(?:srcset|imagesrcset|background)\s*=/i.test(source), `${path}: unreviewed resource attribute`);
+  assert(!/<\s*(?:animate|set|foreignObject)\b/i.test(source), `${path}: active SVG needs review`);
+  assert(!/<link\b[^>]*\brel\s*=\s*["'](?:preconnect|dns-prefetch|prefetch|prerender|modulepreload)/i.test(source), `${path}: speculative network request`);
+  assert(!/<meta\b[^>]*http-equiv\s*=\s*["']refresh["']/i.test(source), `${path}: automatic navigation needs review`);
+  assert(!/\s(?:href|src|action|poster|data|xlink:href)\s*=\s*[^\s"']/i.test(source), `${path}: URL attributes must be quoted for auditing`);
+  for (const match of source.matchAll(/\b(?:href|src|action|poster|data|xlink:href)\s*=\s*(["'])(.*?)\1/gi)) {
+    assert(/^\/(?!\/)[a-z0-9/._-]*$|^#[a-z0-9_-]+$/i.test(match[2]), `${path}: nonlocal or unreviewed URL: ${match[2]}`);
+  }
+}
+
+// Ensure the guard actually rejects the main privacy regressions.
+for (const sample of [
+  '<script src="/tracking.js"></script>', '<img src="https://tracker.example/pixel">',
+  '<img src=https://tracker.example/pixel>', '<meta http-equiv="refresh" content="0;url=https://tracker.example">',
+  '<img src="//tracker.example/pixel">', '<a href="/" ping="/track">Home</a>',
+  '<form action="/collect"></form>', '<button onclick="track()">Go</button>',
+]) assert.throws(() => checkMarkup(sample, 'regression fixture'));
+
+const files = [];
+async function collect(path) {
+  if ((await stat(join(root, path))).isDirectory()) {
+    for (const name of await readdir(join(root, path))) await collect(`${path}/${name}`);
+  } else files.push(path);
+}
+for (const path of ['index.html', 'privacy-policy', 'assets']) await collect(path);
+for (const path of files) {
+  assert(/\.(?:html|css|svg|jpg)$/.test(path), `${path}: new asset type needs a privacy review`);
+  if (/\.(?:html|svg)$/.test(path)) {
+    const source = await read(path);
+    checkMarkup(source, path);
+    if (path.endsWith('.html')) {
+      assert(source.includes('<meta name="referrer" content="no-referrer">'), `${path}: missing referrer fallback`);
+      const fallback = csp.replace("; frame-ancestors 'none'", '');
+      assert(source.includes(`<meta http-equiv="Content-Security-Policy" content="${fallback}">`), `${path}: CSP fallback differs from HTTP policy`);
+      assert(source.indexOf('http-equiv="Content-Security-Policy"') < source.indexOf('<link'), `${path}: CSP must precede resources`);
+    }
+    for (const match of source.matchAll(/\b(?:src|href)="(\/assets\/[^"?#]+)"/g)) {
+      assert((await stat(join(root, match[1]))).isFile(), `${path}: missing local asset`);
+    }
+  }
+  if (path.endsWith('.css')) {
+    const source = await read(path);
+    assert(!/@import|https?:|\/\/|expression\s*\(/i.test(source), `${path}: third-party CSS or active content`);
+    for (const match of source.matchAll(/url\(\s*['"]?([^)'"\s]+)/gi)) {
+      assert.match(match[1], /^\/assets\/[a-z0-9._-]+$/i, `${path}: nonlocal CSS resource`);
+      assert((await stat(join(root, match[1]))).isFile(), `${path}: missing CSS asset`);
+    }
+  }
+}
+const pkg = JSON.parse(await read('package.json'));
+assert.equal(Object.keys(pkg.dependencies ?? {}).length, 0, 'Runtime dependency additions need a privacy audit');
+console.log(`Privacy checks passed: ${files.length} public files; no client scripts, collection forms, or external resources; deployment policies match.`);
