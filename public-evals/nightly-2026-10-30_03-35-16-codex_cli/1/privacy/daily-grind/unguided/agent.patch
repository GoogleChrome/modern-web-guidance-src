+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="referrer" content="no-referrer">
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; base-uri 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'none'; connect-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; form-action 'none'">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Privacy | The Daily Grind</title>
+  <link rel="stylesheet" href="/assets/styles.css">
+</head>
+<body>
+  <nav aria-label="Main navigation">
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <a href="/">Back to home</a>
+  </nav>
+  <main class="container privacy-copy">
+    <h1>Your privacy at The Daily Grind</h1>
+    <p>This notice covers this static website. Last updated October 30, 2026.</p>
+    <h2>Browse without tracking</h2>
+    <p>This website does not use analytics, advertising trackers, cookies, browser storage, fingerprinting, or client-side scripts. You do not need to provide personal information to view these pages.</p>
+    <h2>Resources stay on this site</h2>
+    <p>Our images and styles are served from this website. Viewing a page does not load fonts, images, embeds, or code from third-party services.</p>
+    <h2>Connection information</h2>
+    <p>Serving a page requires the hosting provider to receive connection information, such as your IP address, requested URL, and browser request headers. Hosting infrastructure may keep access and security logs. This site's code does not store that information; hosting log access and retention are controlled by the hosting operator.</p>
+    <h2>Personal information and accounts</h2>
+    <p>These static pages do not collect form submissions or process accounts, rewards, orders, or payments. Navigation links to those services do not mean they are implemented here. Any future service that collects personal information needs its own notice explaining the purpose, required fields, retention, and deletion options before collection begins.</p>
+    <h2>Keep sensitive information out of URLs</h2>
+    <p>Do not put passwords, payment details, or other sensitive information into page addresses or query strings. URLs can appear in browser history and hosting logs.</p>
+    <h2>Privacy questions</h2>
+    <p>For questions about hosting logs or data handled by a separate service, contact the operator of that service using its published contact details. This static website has no personal-data submission endpoint.</p>
+  </main>
+  <footer><p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p></footer>
+</body>
+</html>
diff --git a/scripts/audit-privacy.mjs b/scripts/audit-privacy.mjs
new file mode 100644
index 0000000..40703c4
--- /dev/null
+++ b/scripts/audit-privacy.mjs
@@ -0,0 +1,75 @@
+import assert from 'node:assert/strict';
+import { readFile, readdir } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+
+export const root = fileURLToPath(new URL('../', import.meta.url));
+export const publicFiles = ['index.html', 'privacy-policy/index.html', 'assets/styles.css', 'assets/coffee.jpg', '_headers'];
+
+// This is a deliberately script-free static site. Review the privacy model before
+// expanding this allowlist; new browser code must not silently enter a release.
+async function inventory(directory = root, prefix = '') {
+  const files = [];
+  for (const entry of await readdir(directory, { withFileTypes: true })) {
+    if (['.git', 'node_modules', 'dist'].includes(entry.name)) continue;
+    const relative = prefix + entry.name;
+    if (entry.isDirectory()) files.push(...await inventory(path.join(directory, entry.name), relative + '/'));
+    else files.push(relative);
+  }
+  return files;
+}
+
+export async function auditPrivacy() {
+  const files = await inventory();
+  for (const file of files) {
+    if (/\.(?:html?|css|js|mjs|cjs|ts|tsx|jsx|svg|wasm)$/i.test(file)) {
+      assert(publicFiles.includes(file) || ['scripts/audit-privacy.mjs', 'scripts/build.mjs'].includes(file), `Review new browser-capable file: ${file}`);
+    }
+  }
+  const headers = await readFile(path.join(root, '_headers'), 'utf8');
+  assert(headers.startsWith('/*\n'), 'Headers must cover every route');
+  const values = new Map([...headers.matchAll(/^  ([\w-]+): (.+)$/gm)].map(([, key, value]) => [key.toLowerCase(), value]));
+  const policy = values.get('content-security-policy');
+  assert(policy, 'Missing CSP response header');
+  for (const directive of ["default-src 'none'", "script-src 'none'", "connect-src 'none'", "form-action 'none'", "base-uri 'none'", "frame-ancestors 'none'", "style-src 'self'", "img-src 'self'"]) {
+    assert(policy.split('; ').includes(directive), `Missing privacy restriction: ${directive}`);
+  }
+  assert(!/unsafe-|https?:|\*/i.test(policy), 'CSP must not allow inline code or remote resources');
+  for (const [name, expected] of Object.entries({
+    'referrer-policy': 'no-referrer',
+    'x-content-type-options': 'nosniff',
+    'x-frame-options': 'DENY',
+    'cache-control': 'no-store',
+    'strict-transport-security': 'max-age=31536000',
+    'cross-origin-opener-policy': 'same-origin',
+    'cross-origin-resource-policy': 'same-origin',
+    'x-dns-prefetch-control': 'off',
+  })) assert.equal(values.get(name), expected, `Unexpected ${name}`);
+  for (const feature of ['camera', 'microphone', 'geolocation', 'payment', 'browsing-topics']) {
+    assert(values.get('permissions-policy')?.split(', ').includes(`${feature}=()`), `Disable ${feature}`);
+  }
+  for (const file of publicFiles.filter(file => file.endsWith('.html'))) {
+    const html = await readFile(path.join(root, file), 'utf8');
+    assert(!/<(?:script|style|iframe|object|embed|form|input|textarea|select|base)\b/i.test(html), `Unexpected active content or collection in ${file}`);
+    assert(!/\s(?:on[\w]+|style|ping|srcdoc|srcset)\s*=/i.test(html), `Unexpected inline code or secondary request in ${file}`);
+    for (const match of html.matchAll(/\s(?:src|href|action|poster|data)\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s>]+))/gi)) {
+      const url = match[1] ?? match[2] ?? match[3];
+      assert(/^\/(?!\/)[a-z0-9/._-]*$/i.test(url) || /^#[a-z0-9_-]+$/i.test(url), `Only local URLs allowed in ${file}: ${url}`);
+    }
+    assert(!/rel\s*=\s*["'][^"']*(?:preconnect|dns-prefetch|prefetch|prerender)/i.test(html), `Speculative requests in ${file}`);
+    assert(html.includes('<meta name="referrer" content="no-referrer">'), `Missing referrer fallback in ${file}`);
+    const metaPolicy = html.match(/<meta http-equiv="Content-Security-Policy" content="([^"]+)">/)?.[1];
+    assert.equal(metaPolicy, policy.replace("; frame-ancestors 'none'", ''), `Meta/header CSP drift in ${file}`);
+  }
+  const css = await readFile(path.join(root, 'assets/styles.css'), 'utf8');
+  assert(!/@import|https?:|\/\/|\\/i.test(css), 'Styles must not import third-party resources or escape URLs');
+  for (const [, raw] of css.matchAll(/url\(([^)]+)\)/gi)) {
+    const url = raw.trim().replace(/^['"]|['"]$/g, '');
+    assert(publicFiles.includes(url.slice(1)) && url.startsWith('/assets/'), `Unreviewed CSS asset: ${url}`);
+  }
+  const photo = await readFile(path.join(root, 'assets/coffee.jpg'));
+  assert(photo[0] === 0xff && photo[1] === 0xd8, 'Expected a local JPEG image');
+  console.log('Privacy audit passed: local resources only; no browser scripts, forms, inline code, or external requests; restrictive headers match HTML.');
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) await auditPrivacy();
