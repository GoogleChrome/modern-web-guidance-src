new file mode 100644
index 0000000..c1cc883
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,13 @@
+import { cp, mkdir, rm } from 'node:fs/promises';
+import path from 'node:path';
+import { auditPrivacy, publicFiles, root } from './audit-privacy.mjs';
+
