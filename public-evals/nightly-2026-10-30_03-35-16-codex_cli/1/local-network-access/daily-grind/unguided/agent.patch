diff --git a/tests/equipment.test.cjs b/tests/equipment.test.cjs
new file mode 100644
index 0000000..379d3f5
--- /dev/null
+++ b/tests/equipment.test.cjs
@@ -0,0 +1,98 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+const source = readFileSync('equipment.js', 'utf8');
+
+function setup({ device = 'brewer', permission = 'prompt', secure = true, response, fetchError, pending = false } = {}) {
+  const calls = [];
+  const events = {};
+  const nodes = new Map();
+  const node = selector => {
+    if (!nodes.has(selector)) nodes.set(selector, {
+      dataset: {}, value: device === 'brewer' ? 'http://coffee-brewer.local/health' : 'http://127.0.0.1:8765/health',
+      textContent: '', addEventListener(name, handler) { this[name] = handler; },
+      setAttribute() {}, removeAttribute() {}, focus() {}
+    });
+    return nodes.get(selector);
+  };
+  const form = { dataset: { device }, querySelector: node, setAttribute() {}, addEventListener(name, handler) { events[name] = handler; } };
+  const permissionStatus = { state: permission, addEventListener(name, callback) { this[name] = callback; } };
+  const timers = [];
+  vm.runInNewContext(source, {
+    URL, AbortController, TypeError, Date, console,
+    setTimeout(callback) { timers.push(callback); return timers.length; }, clearTimeout() {},
+    document: { querySelectorAll: () => [form] },
+    window: { isSecureContext: secure, addEventListener() {} },
+    navigator: { permissions: { async query() { if (permission === 'unsupported') throw new TypeError(); return permissionStatus; } } },
+    fetch: async (url, options) => {
+      calls.push({ url, options });
+      if (pending) return new Promise((resolve, reject) => options.signal.addEventListener('abort', () => reject(new Error('aborted'))));
+      if (fetchError) throw fetchError;
+      return response || { ok: true, json: async () => ({ status: 'ready' }) };
+    }
+  });
+  return { node, calls, permissionStatus, timers, ready: () => new Promise(resolve => setImmediate(resolve)), submit: () => events.submit({ preventDefault() {} }) };
+}
+
+test('does not contact equipment on load; local request has CORS and no credentials', async () => {
+  const h = setup(); await h.ready();
+  assert.equal(h.calls.length, 0);
+  assert.equal(h.node('[data-permission]').textContent, 'Ask on connect');
+  await h.submit();
+  assert.equal(h.calls[0].options.targetAddressSpace, 'local');
+  assert.equal(h.calls[0].options.credentials, 'omit');
+  assert.equal(h.calls[0].options.mode, 'cors');
+  assert.equal(h.calls[0].options.redirect, 'error');
+  assert.equal(h.node('[data-status]').textContent, 'Connected');
+});
+test('companion uses a distinct loopback address space', async () => {
+  const h = setup({ device: 'companion' }); await h.ready(); await h.submit();
+  assert.equal(h.calls[0].options.targetAddressSpace, 'loopback');
+});
+test('rejects non-loopback companion addresses and nonlocal brewer IPs', async () => {
+  for (const [device, address] of [['companion', 'http://192.168.1.5/health'], ['brewer', 'http://127.0.0.1/health'], ['brewer', 'http://8.8.8.8/health'], ['brewer', 'ftp://coffee.local/health']]) {
+    const h = setup({ device }); await h.ready(); h.node('input').value = address; await h.submit();
+    assert.equal(h.calls.length, 0); assert.equal(h.node('[data-status]').textContent, 'Connection failed');
+  }
+});
+test('supports IPv6 loopback and local IPv6', async () => {
+  for (const [device, address] of [['companion', 'http://[::1]:8765/health'], ['brewer', 'http://[fd00::1]/health']]) {
+    const h = setup({ device }); await h.ready(); h.node('input').value = address; await h.submit(); assert.equal(h.calls.length, 1);
+  }
+});
+test('denied permission and insecure pages prevent requests', async () => {
+  for (const options of [{ permission: 'denied' }, { secure: false }]) {
+    const h = setup(options); await h.ready(); await h.submit(); assert.equal(h.calls.length, 0);
+  }
+});
+test('unsupported permission query remains unknown and allows an explicit attempt', async () => {
+  const h = setup({ permission: 'unsupported' }); await h.ready();
+  assert.equal(h.node('[data-permission]').textContent, 'Unavailable'); await h.submit(); assert.equal(h.calls.length, 1);
+});
+test('HTTP, JSON and network failures never report connected', async () => {
+  for (const options of [
+    { response: { ok: false, status: 503 } },
+    { response: { ok: true, json: async () => { throw new SyntaxError(); } } },
+    { response: { ok: true, json: async () => [] } },
+    { fetchError: new TypeError('Failed to fetch') }
+  ]) {
+    const h = setup(options); await h.ready(); await h.submit();
+    assert.equal(h.node('[data-status]').textContent, 'Connection failed'); assert.equal(h.node('[type="submit"]').disabled, false);
+  }
+});
+test('cancel aborts a pending request and prevents stale feedback', async () => {
+  const h = setup({ pending: true }); await h.ready(); const request = h.submit();
+  h.node('[data-disconnect]').click(); await request;
+  assert.equal(h.calls[0].options.signal.aborted, true); assert.equal(h.node('[data-status]').textContent, 'Not connected');
+});
+test('timeout aborts and reports actionable feedback', async () => {
+  const h = setup({ pending: true }); await h.ready(); const request = h.submit(); h.timers[0](); await request;
+  assert.match(h.node('[data-feedback]').textContent, /Timed out after 15 seconds/);
+});
+test('permission revocation resets a successful connection', async () => {
+  const h = setup({ permission: 'granted' }); await h.ready(); await h.submit();
+  h.permissionStatus.state = 'denied'; h.permissionStatus.change();
+  assert.equal(h.node('[data-status]').textContent, 'Connection failed');
+  assert.equal(h.node('[data-permission]').textContent, 'Blocked');
+});
