diff --git a/equipment.js b/equipment.js
new file mode 100644
index 0000000..0175bdf
--- /dev/null
+++ b/equipment.js
@@ -0,0 +1,166 @@
+(() => {
+  'use strict';
+
+  // These are read-only HTTP connectivity checks, not persistent sessions.
+  function endpointFor(value, device) {
+    let url;
+    try { url = new URL(value.trim()); } catch { throw new Error('Enter a complete status URL, including http:// or https://.'); }
+    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+      throw new Error('Use an HTTP or HTTPS URL without credentials or a fragment.');
+    }
+    const host = url.hostname.toLowerCase().replace(/\.$/, '');
+    const loopback = host === 'localhost' || host.endsWith('.localhost') || host === '[::1]' || /^127\./.test(host);
+    if (device === 'companion' && !loopback) {
+      throw new Error('The companion must run on this device. Use localhost, 127.0.0.1, or [::1] with its port.');
+    }
+    if (device === 'brewer') {
+      const octets = host.split('.').map(Number);
+      const ipv4 = /^\d+\.\d+\.\d+\.\d+$/.test(host);
+      const privateIPv4 = octets[0] === 10 || (octets[0] === 172 && octets[1] >= 16 && octets[1] <= 31) ||
+        (octets[0] === 192 && octets[1] === 168) || (octets[0] === 169 && octets[1] === 254);
+      const privateIPv6 = /^\[(?:f[cd][0-9a-f]{2}:|fe[89ab][0-9a-f]:)/.test(host);
+      if (loopback || (ipv4 && !privateIPv4) || (host.startsWith('[') && !privateIPv6)) {
+        throw new Error('Use your brewer’s local network address, such as 192.168.1.50 or coffee-brewer.local.');
+      }
+    }
+    return url.href;
+  }
+
+  document.querySelectorAll('[data-device]').forEach(form => {
+    const device = form.dataset.device;
+    const label = device === 'brewer' ? 'brewer' : 'companion';
+    const space = device === 'brewer' ? 'local' : 'loopback';
+    const permissionName = device === 'brewer' ? 'local-network' : 'loopback-network';
+    const input = form.querySelector('input');
+    const button = form.querySelector('[type="submit"]');
+    const buttonLabel = form.querySelector('[data-button-label]');
+    const disconnect = form.querySelector('[data-disconnect]');
+    const badge = form.querySelector('[data-status]');
+    const feedback = form.querySelector('[data-feedback]');
+    const permissionLabel = form.querySelector('[data-permission]');
+    const permissionHelp = form.querySelector('[data-permission-help]');
+    let permissionStatus;
+    let permissionState = 'unknown';
+    let controller;
+    let attempt = 0;
+    let state = 'idle';
+
+    function render(next, message) {
+      state = next;
+      badge.dataset.state = next;
+      feedback.dataset.state = next;
+      badge.textContent = { idle: 'Not connected', connecting: 'Connecting…', connected: 'Connected', error: 'Connection failed' }[next];
+      feedback.textContent = message;
+      button.disabled = next === 'connecting';
+      input.disabled = next === 'connecting';
+      form.setAttribute('aria-busy', String(next === 'connecting'));
+      buttonLabel.textContent = next === 'connecting' ? 'Connecting…' : next === 'connected' ? 'Check connection again' : `Connect ${label}`;
+      disconnect.hidden = !['connecting', 'connected'].includes(next);
+      disconnect.textContent = next === 'connecting' ? 'Cancel connection' : 'Disconnect';
+    }
+
+    function showPermission() {
+      permissionState = permissionStatus?.state || 'unknown';
+      permissionLabel.dataset.state = permissionState;
+      permissionLabel.textContent = { granted: 'Allowed', denied: 'Blocked', prompt: 'Ask on connect', unknown: 'Unavailable' }[permissionState];
+      permissionHelp.textContent = {
+        granted: 'Browser permission is allowed. Connect to check availability.',
+        denied: `Allow ${space === 'local' ? 'Local network' : 'Loopback network'} access in your browser’s site settings, then retry.`,
+        prompt: `Your browser may ask to access ${space === 'local' ? 'devices on your Wi-Fi' : 'the utility on this device'} when you connect.`,
+        unknown: 'Permission status is not exposed by this browser. You can still try connecting.'
+      }[permissionState];
+      if (permissionState === 'denied' && ['connected', 'connecting'].includes(state)) {
+        attempt++;
+        controller?.abort();
+        render('error', 'Network permission was blocked. Allow access in site settings and connect again.');
+      }
+    }
+
+    async function observePermission() {
+      if (!window.isSecureContext) {
+        permissionLabel.textContent = 'HTTPS required';
+        permissionHelp.textContent = 'Open this homepage over HTTPS to connect to local equipment.';
+        return;
+      }
+      if (!permissionStatus && navigator.permissions?.query) {
+        // Older browsers expose a single permission; others expose neither.
+        for (const name of [permissionName, 'local-network-access']) {
+          try {
+            permissionStatus = await navigator.permissions.query({ name });
+            permissionStatus.addEventListener('change', showPermission);
+            break;
+          } catch { /* Unknown permission names are expected on some browsers. */ }
+        }
+      }
+      showPermission();
+    }
+
+    form.addEventListener('submit', async event => {
+      event.preventDefault();
+      if (state === 'connecting') return;
+      input.removeAttribute('aria-invalid');
+      let endpoint;
+      try { endpoint = endpointFor(input.value, device); }
+      catch (error) {
+        input.setAttribute('aria-invalid', 'true');
+        render('error', error.message);
+        input.focus();
+        return;
+      }
+      if (!window.isSecureContext) {
+        render('error', 'A secure page is required. Open this homepage over HTTPS, then try again.');
+        return;
+      }
+      if (permissionState === 'denied') {
+        render('error', 'Network access is blocked. Allow access in your browser’s site settings, then retry.');
+        return;
+      }
+      const currentAttempt = ++attempt;
+      controller = new AbortController();
+      let timedOut = false;
+      const timeout = setTimeout(() => { timedOut = true; controller.abort(); }, 15000);
+      render('connecting', 'Waiting for your equipment. Approve the browser’s permission prompt if one appears.');
+      try {
+        const response = await fetch(endpoint, {
+          method: 'GET', mode: 'cors', targetAddressSpace: space,
+          credentials: 'omit', redirect: 'error', cache: 'no-store',
+          referrerPolicy: 'no-referrer', signal: controller.signal
+        });
+        if (!response.ok) throw new Error(`The ${label} returned HTTP ${response.status}. Check the status endpoint and service configuration.`);
+        let data;
+        try { data = await response.json(); }
+        catch (error) {
+          if (controller.signal.aborted) throw error;
+          throw new Error('The endpoint responded, but did not return valid JSON. Use the equipment’s JSON status endpoint.');
+        }
+        if (!data || typeof data !== 'object' || Array.isArray(data)) throw new Error('The status endpoint must return a JSON object. Check the endpoint URL.');
+        if (currentAttempt !== attempt) return;
+        render('connected', `Status endpoint reached at ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}. This is a one-time check; check again to refresh.`);
+      } catch (error) {
+        if (currentAttempt !== attempt) return;
+        let message;
+        if (timedOut) message = `Timed out after 15 seconds. Check ${device === 'brewer' ? 'the brewer’s power, Wi-Fi, and address' : 'that the companion is running and the port is correct'}, then retry.`;
+        else if (permissionStatus?.state === 'denied') message = 'Permission denied. Allow network access in your browser’s site settings, then retry.';
+        else if (error instanceof TypeError) message = `Could not reach the ${label}. Check its address, ${device === 'brewer' ? 'Wi-Fi connection' : 'running utility and port'}, browser network permission, and that the service allows this site through CORS. Browser security may also block HTTP requests on unsupported browsers.`;
+        else message = error.message || 'Connection failed. Check the service and try again.';
+        render('error', message);
+      } finally {
+        clearTimeout(timeout);
+        if (currentAttempt === attempt) await observePermission();
+      }
+    });
+
+    disconnect.addEventListener('click', () => {
+      const wasConnecting = state === 'connecting';
+      attempt++;
+      controller?.abort();
+      render('idle', wasConnecting ? 'Connection cancelled. You can try again whenever you’re ready.' : 'Disconnected. Browser permission is unchanged; manage it in site settings.');
+    });
+    input.addEventListener('input', () => {
+      input.removeAttribute('aria-invalid');
+      if (state !== 'connecting') render('idle', 'Address changed. Connect to check this endpoint.');
+    });
+    window.addEventListener('focus', observePermission);
+    void observePermission();
+  });
+})();
