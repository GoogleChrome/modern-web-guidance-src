       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      isolation: isolate;
+      transition: --inner-size 0.2s ease-in-out, --outer-size 0.2s ease-in-out;
+    }
+
+    /* Keep the original content above the purely decorative reveal. */
+    .product-card > :not(.reveal-layer) {
+      position: relative;
+      z-index: 1;
+    }
+
+    .reveal-layer {
+      position: absolute;
+      inset: 0;
+      z-index: 0;
+      border-radius: inherit;
+      pointer-events: none;
+      background-color: #fff3e0;
+      background-image: radial-gradient(circle, #d7ccc8 1px, transparent 1px);
+      background-size: 12px 12px;
+      box-shadow: inset 0 0 0 2px var(--accent);
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), black var(--inner-size, 0px), transparent var(--outer-size, 0px));
+      mask-image: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), black var(--inner-size, 0px), transparent var(--outer-size, 0px));
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+    }
+
+    @media (hover: hover) {
+      .product-card:hover {
+        --inner-size: 80px;
+        --outer-size: 140px;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
