diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,72 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      if (typeof document.modelContext?.registerTool !== 'function') return;
+
+      let registration;
+      const normalizeName = (name) => name.trim().replace(/\s+/g, ' ').toLowerCase();
+
+      async function registerMenuTool() {
+        if (registration && !registration.signal.aborted) return;
+        const controller = new AbortController();
+        registration = controller;
+
+        try {
+          await document.modelContext.registerTool({
+            name: 'get_menu_item',
+            description: 'Look up a menu item and return its name, description, and details link. Use when someone asks about a drink on The Daily Grind menu.',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                itemName: {
+                  type: 'string',
+                  description: 'The menu item to look up; capitalization and surrounding whitespace are ignored.',
+                  minLength: 1,
+                  examples: ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew']
+                }
+              },
+              required: ['itemName'],
+              additionalProperties: false
+            },
+            execute(input) {
+              if (!input || typeof input !== 'object' || Array.isArray(input) ||
+                  typeof input.itemName !== 'string' || !input.itemName.trim() ||
+                  Object.keys(input).some((key) => key !== 'itemName')) {
+                return { error: 'Provide a non-empty itemName and no other parameters.' };
+              }
+
+              // Read the displayed menu so tool results stay in sync with the page.
+              const items = Array.from(document.querySelectorAll('main .card'), (card) => ({
+                name: card.querySelector('h3').textContent.trim(),
+                description: card.querySelector('p').textContent.trim(),
+                detailsUrl: card.querySelector('a').href
+              }));
+              const item = items.find((entry) => normalizeName(entry.name) === normalizeName(input.itemName));
+              return item || {
+                error: `Menu item "${input.itemName}" not found.`,
+                availableItems: items.map((entry) => entry.name)
+              };
+            },
+            annotations: { readOnlyHint: true }
+          }, { signal: controller.signal });
+        } catch (error) {
+          controller.abort();
+          if (registration === controller) registration = undefined;
+          if (error?.name !== 'AbortError') console.warn('Menu tool registration failed:', error);
+        }
+      }
+
+      window.addEventListener('pagehide', () => registration?.abort());
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) registerMenuTool();
+      });
+      registerMenuTool();
+    })();
+  </script>
+
 </body>
 
 </html>
