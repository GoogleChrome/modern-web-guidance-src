@@ -206,7 +206,84 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      // Use the current WebMCP API, with support for older browser versions.
+      const modelContext = document.modelContext ?? navigator.modelContext;
+      if (typeof modelContext?.registerTool !== 'function') return;
+
+      const toolName = 'get_menu_item';
+      let registrationController;
+
+      const normalizeName = (name) => name.trim().replace(/\s+/g, ' ').toLowerCase();
+      const respond = (data, isError = false) => ({
+        content: [{ type: 'text', text: JSON.stringify(data) }],
+        ...(isError ? { isError: true } : {})
+      });
+
+      const tool = {
+        name: toolName,
+        description: 'Look up a menu item by name and return its name, description, and details-page URL from the current menu.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              description: 'The menu item name, such as Maple Oat Latte, Dark Roast Espresso, or Cold Brew. Matching ignores case and extra whitespace.',
+              minLength: 1
+            }
+          },
+          required: ['name'],
+          additionalProperties: false
+        },
+        execute: async (input) => {
+          if (typeof input?.name !== 'string' || !input.name.trim()) {
+            return respond({ error: 'Provide a non-empty menu item name.' }, true);
+          }
+
+          const items = Array.from(document.querySelectorAll('main .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href
+          }));
+          const item = items.find((entry) => normalizeName(entry.name) === normalizeName(input.name));
+
+          return item
+            ? respond(item)
+            : respond({ error: `No menu item found for "${input.name}".`, availableItems: items.map((entry) => entry.name) }, true);
+        },
+        annotations: { readOnlyHint: true }
+      };
+
+      async function registerTool() {
+        if (registrationController) return;
+        const controller = new AbortController();
+        registrationController = controller;
+        try {
+          await modelContext.registerTool(tool, { signal: controller.signal });
+        } catch (error) {
+          if (registrationController === controller) registrationController = undefined;
+          if (!controller.signal.aborted) console.warn('Could not register the menu lookup tool.', error);
+        }
+      }
+
+      function cleanupTool() {
+        if (!registrationController) return;
+        registrationController.abort();
+        registrationController = undefined;
+        // Older implementations use explicit unregistration instead of AbortSignal.
+        if (typeof modelContext.unregisterTool === 'function') {
+          modelContext.unregisterTool(toolName);
+        }
+      }
+
+      window.addEventListener('pagehide', cleanupTool);
+      window.addEventListener('pageshow', registerTool);
+      registerTool();
+    })();
+  </script>
+
 </body>
 
 </html>
