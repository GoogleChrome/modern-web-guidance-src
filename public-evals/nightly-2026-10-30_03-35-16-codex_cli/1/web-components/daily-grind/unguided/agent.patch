+# The Daily Grind
+
+A static homepage using native Web Components and ES modules; no framework or build step is required. Serve `index.html` and `components/` together from the same static host.
+
+## Components
+
+- `<coffee-card name="Cold Brew" href="/menu/cold-brew">Description</coffee-card>` renders an article with an `h3`, slotted description, and a link named for the coffee. `name` and `href` react to attribute changes.
+- `<coffee-hero href="/order-online" action-label="Order Now">…</coffee-hero>` accepts a heading in `slot="heading"` and default content for the description. Supply an `h1` for the page hero. The action attributes react to changes.
+- `<site-navigation>` accepts brand text in `slot="brand"` and direct child anchors in its default slot. Add `data-outlined` to outline a link. Its mobile disclosure supports native button keyboard activation and Escape to close and restore focus. Links retain normal browser navigation behavior.
+
+Each component owns an open Shadow DOM and local styles. The page owns the grid, section headings, footer, and theme tokens (`--primary`, `--secondary`, `--accent`, `--text`, `--light`). The hero's optional `--hero-image` accepts a CSS `url(...)`; its default preserves the original Unsplash photo. Navigation is labelled “Primary”; use this component once per page. Shadow-local IDs can safely repeat across component instances.
+
+Run `npm run check` for JavaScript syntax checks. This does not start a server or exercise browser behavior.
diff --git a/components/coffee-card.js b/components/coffee-card.js
new file mode 100644
index 0000000..50a28a1
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,52 @@
+import { baseStyles, buttonStyles } from './shared.js';
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    ${baseStyles}
+    ${buttonStyles}
+    :host { height: 100%; }
+    article {
+      height: 100%;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+    h3 { margin-bottom: 10px; color: var(--primary, #4e342e); }
+    p { flex: 1; }
+  </style>
+  <article aria-labelledby="name">
+    <h3 id="name"></h3>
+    <p><slot></slot></p>
+    <a class="btn">View Details</a>
+  </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'href'];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+  }
+
+  connectedCallback() { this.render(); }
+  attributeChangedCallback() { this.render(); }
+
+  render() {
+    const name = this.getAttribute('name') || 'Coffee';
+    this.shadowRoot.querySelector('h3').textContent = name;
+    const link = this.shadowRoot.querySelector('a');
+    link.setAttribute('aria-label', `View details for ${name}`);
+    // An omitted destination stays non-interactive rather than navigating to "null".
+    if (this.hasAttribute('href')) link.setAttribute('href', this.getAttribute('href'));
+    else link.removeAttribute('href');
+  }
+}
+
+if (!customElements.get('coffee-card')) customElements.define('coffee-card', CoffeeCard);
