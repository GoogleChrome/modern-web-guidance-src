+// Theme tokens inherit through the shadow boundary; selectors stay local.
+export const baseStyles = `
+  :host { display: block; }
+  *, *::before, *::after { box-sizing: border-box; }
+  h1, h3, p { margin: 0; }
+  a:focus-visible, button:focus-visible {
+    outline: 3px solid var(--primary, #4e342e);
+    outline-offset: 4px;
+    box-shadow: 0 0 0 6px white;
+  }
+`;
+
+export const buttonStyles = `
+  .btn {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+  }
+  .btn:hover { background: #3e2723; }
+`;
diff --git a/components/site-navigation.js b/components/site-navigation.js
new file mode 100644
index 0000000..f90aaf6
--- /dev/null
+++ b/components/site-navigation.js
@@ -0,0 +1,104 @@
+import { baseStyles } from './shared.js';
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    ${baseStyles}
+    :host { position: sticky; top: 0; z-index: 1000; }
+    nav {
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 20px;
+    }
+    .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+    .links { display: flex; align-items: center; gap: 20px; }
+    ::slotted(a) { color: white; text-decoration: none; font-size: 0.9rem; }
+    ::slotted(a:hover) { color: var(--accent, #ffab40); }
+    ::slotted(a:focus-visible) {
+      outline: 3px solid var(--accent, #ffab40);
+      outline-offset: 4px;
+    }
+    ::slotted([data-outlined]) {
+      border: 1px solid var(--accent, #ffab40);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+    button {
+      display: none;
+      font: inherit;
+      color: white;
+      background: transparent;
+      border: 1px solid var(--accent, #ffab40);
+      border-radius: 4px;
+      padding: 10px 12px;
+      cursor: pointer;
+    }
+    @media (max-width: 760px) {
+      nav { flex-wrap: wrap; }
+      .logo { font-size: 1.2rem; }
+      button { display: block; }
+      .links { display: none; flex-basis: 100%; align-items: stretch; flex-direction: column; gap: 8px; }
+      nav[data-expanded] .links { display: flex; }
+      ::slotted(a) { padding: 10px 12px; }
+    }
+  </style>
+  <nav aria-label="Primary">
+    <div class="logo"><slot name="brand">THE DAILY GRIND</slot></div>
+    <button type="button" aria-expanded="false" aria-controls="navigation-links">Menu</button>
+    <div class="links" id="navigation-links"><slot></slot></div>
+  </nav>
+`;
+
+export class SiteNavigation extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+    this.button = this.shadowRoot.querySelector('button');
+    this.nav = this.shadowRoot.querySelector('nav');
+  }
+
+  connectedCallback() {
+    // Reconnecting the element must not accumulate event listeners.
+    this.controller?.abort();
+    this.controller = new AbortController();
+    const { signal } = this.controller;
+    this.button.addEventListener('click', () => {
+      this.setExpanded(this.button.getAttribute('aria-expanded') !== 'true');
+    }, { signal });
+    this.shadowRoot.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && this.button.getAttribute('aria-expanded') === 'true') {
+        this.setExpanded(false);
+        this.button.focus();
+      }
+    }, { signal });
+    this.addEventListener('click', (event) => {
+      if (event.composedPath().some(node => node instanceof HTMLAnchorElement && node.hasAttribute('href'))) {
+        this.setExpanded(false);
+      }
+    }, { signal });
+    this.mobile = window.matchMedia('(max-width: 760px)');
+    this.mobile.addEventListener('change', () => {
+      const activeElement = this.shadowRoot.activeElement || document.activeElement;
+      const focusInLinks = activeElement instanceof HTMLAnchorElement && this.contains(activeElement);
+      this.setExpanded(false);
+      if (this.mobile.matches && focusInLinks) this.button.focus();
+      if (!this.mobile.matches && activeElement === this.button) {
+        this.querySelector('a[href]')?.focus();
+      }
+    }, { signal });
+    this.setExpanded(false);
+  }
+
+  disconnectedCallback() { this.controller?.abort(); }
+
+  setExpanded(expanded) {
+    this.button.setAttribute('aria-expanded', String(expanded));
+    this.nav.toggleAttribute('data-expanded', expanded);
+  }
+}
+
+if (!customElements.get('site-navigation')) customElements.define('site-navigation', SiteNavigation);
