+// Templates are parsed once, then cloned for each independent instance.
+const baseStyles = `
+  :host { display: block; color: var(--text, #3e2723); }
+  *, *::before, *::after { box-sizing: border-box; }
+  ::slotted(*) { box-sizing: border-box; }
+  ::slotted(a:focus-visible), button:focus-visible {
+    outline: 3px solid var(--focus, #a34e00);
+    outline-offset: 4px;
+  }
+`;
+
+const actionStyles = `
+  ::slotted(a[slot="action"]) {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+  }
+  ::slotted(a[slot="action"]:hover) { background: var(--text, #3e2723); }
+`;
+
+function template(styles, markup) {
+  const element = document.createElement('template');
+  element.innerHTML = `<style>${baseStyles}${styles}</style>${markup}`;
+  return element;
+}
+
+const cardTemplate = template(actionStyles + `
+  :host { height: 100%; }
+  article {
+    height: 100%;
+    background: var(--card-background, white);
+    padding: 20px;
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgb(0 0 0 / 10%);
+    text-align: center;
+  }
+  ::slotted([slot="heading"]) { margin: 0 0 10px; color: var(--primary, #4e342e); }
+  ::slotted([slot="description"]) { margin: 0; }
+`, `
+  <article part="card">
+    <slot name="heading"></slot>
+    <slot name="description"></slot>
+    <slot name="action"></slot>
+  </article>
+`);
+
+export class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(cardTemplate.content.cloneNode(true));
+  }
+}
+
+const heroTemplate = template(actionStyles + `
+  header {
+    min-height: 60vh;
+    background: linear-gradient(rgb(0 0 0 / 50%), rgb(0 0 0 / 50%)),
+      var(--hero-image, url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80'));
+    background-size: cover;
+    background-position: center;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    color: white;
+    text-align: center;
+    padding: 40px 20px;
+  }
+  ::slotted([slot="heading"]) { font-size: clamp(2rem, 6vw, 3rem); margin: 0 0 1rem; }
+  ::slotted([slot="description"]) { margin: 0; }
+  ::slotted(a:focus-visible) { outline-color: white; }
+`, `
+  <header part="hero">
+    <slot name="heading"></slot>
+    <slot name="description"></slot>
+    <slot name="action"></slot>
+  </header>
+`);
+
+export class CoffeeHero extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(heroTemplate.content.cloneNode(true));
+  }
+}
+
+const navigationTemplate = template(`
+  :host { position: sticky; top: 0; z-index: 1000; }
+  nav {
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 1rem 5%;
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: 1rem;
+  }
+  ::slotted([slot="brand"]) { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; }
+  ::slotted(a) { color: white; text-decoration: none; font-size: 0.9rem; }
+  ::slotted(a:hover) { color: var(--accent, #ffab40); }
+  ::slotted(a:focus-visible), button:focus-visible { outline-color: var(--accent, #ffab40); }
+  ::slotted([slot="account-action"]) { border: 1px solid var(--accent, #ffab40); padding: 5px 12px; border-radius: 4px; }
+  button { display: none; font: inherit; color: inherit; background: transparent; border: 1px solid currentColor; border-radius: 4px; padding: 6px 12px; cursor: pointer; }
+  .links[hidden] { display: none; }
+  @media (max-width: 44rem) {
+    button { display: inline-block; }
+    .links { flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 12px; }
+    ::slotted(a) { padding: 6px 0; }
+  }
+`, `
+  <nav aria-label="Primary">
+    <slot name="brand"></slot>
+    <button type="button" aria-expanded="false" aria-controls="navigation-links">Menu</button>
+    <div class="links" id="navigation-links">
+      <slot></slot>
+      <slot name="account-action"></slot>
+    </div>
+  </nav>
+`);
+
+export class GrindNavigation extends HTMLElement {
+  #controller;
+  #media;
+  #button;
+  #links;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(navigationTemplate.content.cloneNode(true));
+    this.#button = root.querySelector('button');
+    this.#links = root.querySelector('.links');
+  }
+
+  connectedCallback() {
+    // Abort the previous setup if this instance is connected again.
+    this.#controller?.abort();
+    this.#controller = new AbortController();
+    const { signal } = this.#controller;
+    this.#media = window.matchMedia('(max-width: 44rem)');
+    this.#setExpanded(!this.#media.matches);
+    this.#media.addEventListener('change', () => {
+      const focusWasInMenu = this.contains(document.activeElement);
+      this.#setExpanded(!this.#media.matches);
+      if (this.#media.matches && focusWasInMenu) this.#button.focus();
+    }, { signal });
+    this.#button.addEventListener('click', () => {
+      this.#setExpanded(this.#button.getAttribute('aria-expanded') !== 'true');
+    }, { signal });
+    this.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && this.#media.matches && !this.#links.hidden) {
+        this.#setExpanded(false);
+        this.#button.focus();
+        event.preventDefault();
+      }
+    }, { signal });
+    this.addEventListener('click', (event) => {
+      if (this.#media.matches && event.composedPath().some(node => node instanceof HTMLAnchorElement)) {
+        this.#setExpanded(false);
+        this.#button.focus();
+      }
+    }, { signal });
+  }
+
+  disconnectedCallback() {
+    this.#controller?.abort();
+  }
+
+  #setExpanded(expanded) {
+    this.#button.setAttribute('aria-expanded', String(expanded));
+    this.#links.hidden = !expanded;
+  }
+}
+
+for (const [name, component] of [
+  ['coffee-card', CoffeeCard],
+  ['coffee-hero', CoffeeHero],
+  ['grind-navigation', GrindNavigation],
+]) {
+  if (!customElements.get(name)) customElements.define(name, component);
+}
