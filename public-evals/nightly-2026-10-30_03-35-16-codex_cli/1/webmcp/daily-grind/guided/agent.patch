diff --git a/webmcp.js b/webmcp.js
new file mode 100644
index 0000000..3388ddd
--- /dev/null
+++ b/webmcp.js
@@ -0,0 +1,200 @@
+(() => {
+  'use strict';
+
+  // Read the displayed menu so agent results and customer-facing copy stay in sync.
+  const cards = [...document.querySelectorAll('[data-drink-id]')];
+  const menu = cards.map((card) => ({
+    id: card.dataset.drinkId,
+    name: card.querySelector('h3').textContent.trim(),
+    description: card.querySelector('p').textContent.trim(),
+    detailsUrl: card.querySelector('a').getAttribute('href'),
+  }));
+  const selection = document.querySelector('#order-drink');
+  const quantityInput = document.querySelector('#order-quantity');
+  const status = document.querySelector('#order-status');
+  const orderItems = document.querySelector('#order-items');
+  const clearButton = document.querySelector('#clear-order');
+  const draft = new Map();
+
+  for (const drink of menu) {
+    const option = document.createElement('option');
+    option.value = drink.id;
+    option.textContent = drink.name;
+    selection.append(option);
+  }
+
+  function getOrder() {
+    return [...draft].map(([drinkId, quantity]) => ({
+      drinkId,
+      name: menu.find((drink) => drink.id === drinkId).name,
+      quantity,
+    }));
+  }
+
+  function renderOrder() {
+    orderItems.replaceChildren();
+    for (const item of getOrder()) {
+      const row = document.createElement('li');
+      row.textContent = `${item.quantity} × ${item.name}`;
+      orderItems.append(row);
+    }
+    document.querySelector('#empty-order').hidden = draft.size > 0;
+    clearButton.disabled = draft.size === 0;
+  }
+
+  function validateInput(input, allowedKeys) {
+    if (!input || typeof input !== 'object' || Array.isArray(input)) {
+      return { error: 'Pass an object containing the tool arguments.' };
+    }
+    if (Object.keys(input).some((key) => !allowedKeys.includes(key))) {
+      return { error: 'Unexpected argument. Use only the fields in the tool schema.' };
+    }
+    return null;
+  }
+
+  function findDrink(drinkId) {
+    return menu.find((drink) => drink.id === drinkId);
+  }
+
+  function missingDrink() {
+    return { error: 'Choose a drink from Seasonal Favorites.', availableDrinkIds: menu.map((drink) => drink.id) };
+  }
+
+  function highlightDrink(input) {
+    const error = validateInput(input, ['drinkId']);
+    if (error) return error;
+    const drink = findDrink(input.drinkId);
+    if (!drink) return missingDrink();
+    cards.forEach((card) => card.toggleAttribute('data-highlighted', card.dataset.drinkId === drink.id));
+    selection.value = drink.id;
+    const card = cards.find((entry) => entry.dataset.drinkId === drink.id);
+    card.focus({ preventScroll: true });
+    card.scrollIntoView({ block: 'center', behavior: 'instant' });
+    status.textContent = `${drink.name} selected.`;
+    return { highlightedDrink: { ...drink } };
+  }
+
+  function orderDrink(input) {
+    const error = validateInput(input, ['drinkId', 'quantity']);
+    if (error) return error;
+    const drink = findDrink(input.drinkId);
+    if (!drink) return missingDrink();
+    const quantity = input.quantity === undefined ? 1 : input.quantity;
+    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+      return { error: 'Quantity must be a whole number from 1 to 10.' };
+    }
+    const total = (draft.get(drink.id) || 0) + quantity;
+    if (total > 10) {
+      return { error: 'The draft can contain at most 10 of each drink.', currentQuantity: draft.get(drink.id) };
+    }
+    draft.set(drink.id, total);
+    selection.value = drink.id;
+    quantityInput.value = String(quantity);
+    renderOrder();
+    status.textContent = `Added ${quantity} × ${drink.name} to your order draft.`;
+    document.querySelector('#order-panel').scrollIntoView({ block: 'nearest', behavior: 'instant' });
+    return { status: 'draft', submitted: false, items: getOrder() };
+  }
+
+  document.querySelector('#drink-order-form').addEventListener('submit', (event) => {
+    event.preventDefault();
+    const result = orderDrink({ drinkId: selection.value, quantity: quantityInput.valueAsNumber });
+    if (result.error) status.textContent = result.error;
+  });
+  document.querySelectorAll('[data-order-drink]').forEach((button) => {
+    button.hidden = false;
+    button.addEventListener('click', () => {
+      const result = orderDrink({ drinkId: button.dataset.orderDrink });
+      if (result.error) status.textContent = result.error;
+    });
+  });
+  clearButton.addEventListener('click', () => {
+    draft.clear();
+    renderOrder();
+    status.textContent = 'Order draft cleared.';
+  });
+  document.querySelector('#order-panel').hidden = false;
+
+  const drinkIdSchema = {
+    type: 'string',
+    enum: menu.map((drink) => drink.id),
+    description: 'The menu identifier of the drink to select.',
+  };
+  const tools = [
+    {
+      name: 'get_seasonal_favorites',
+      description: 'Find drinks in the Daily Grind Seasonal Favorites menu. Use to read or compare the displayed coffee descriptions.',
+      inputSchema: {
+        type: 'object',
+        properties: { query: { type: 'string', description: 'Words to match against the drink name or description.', default: '' } },
+        additionalProperties: false,
+      },
+      execute(input) {
+        const error = validateInput(input, ['query']);
+        if (error) return error;
+        const query = input.query === undefined ? '' : input.query;
+        if (typeof query !== 'string') return { error: 'Query must be text.' };
+        const words = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
+        return {
+          section: 'Seasonal Favorites',
+          drinks: menu.filter((drink) => words.every((word) => `${drink.name} ${drink.description}`.toLowerCase().includes(word)))
+            .map((drink) => ({ ...drink })),
+        };
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'order_drink',
+      description: 'Add a seasonal drink to the visible order draft in this tab. Use when the user wants a drink; the draft is not submitted to the shop.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          drinkId: drinkIdSchema,
+          quantity: { type: 'integer', minimum: 1, maximum: 10, default: 1, description: 'Number of drinks to add to the draft, which holds up to ten of each drink.' },
+        },
+        required: ['drinkId'],
+        additionalProperties: false,
+      },
+      execute: orderDrink,
+      annotations: { readOnlyHint: false },
+    },
+    {
+      name: 'highlight_drink',
+      description: 'Highlight a seasonal drink card, bring it into view, and select it in the order form. Use to show a recommendation on the page.',
+      inputSchema: {
+        type: 'object',
+        properties: { drinkId: drinkIdSchema },
+        required: ['drinkId'],
+        additionalProperties: false,
+      },
+      execute: highlightDrink,
+      annotations: { readOnlyHint: false },
+    },
+  ];
+
+  // Prefer the current API, with compatibility for older WebMCP preview browsers.
+  // Regular order controls work even when neither API is available.
+  const modelContext = document.modelContext ?? navigator.modelContext;
+  if (typeof modelContext?.registerTool !== 'function') return;
+
+  let registrationController;
+  async function registerTools() {
+    registrationController?.abort();
+    const controller = new AbortController();
+    registrationController = controller;
+    try {
+      for (const tool of tools) {
+        if (controller.signal.aborted) return;
+        await modelContext.registerTool(tool, { signal: controller.signal });
+      }
+    } catch (error) {
+      controller.abort();
+      console.warn('Daily Grind WebMCP tools could not be registered.', error);
+    }
+  }
+  window.addEventListener('pagehide', () => registrationController?.abort());
+  window.addEventListener('pageshow', (event) => {
+    if (event.persisted) void registerTools();
+  });
+  void registerTools();
+})();
