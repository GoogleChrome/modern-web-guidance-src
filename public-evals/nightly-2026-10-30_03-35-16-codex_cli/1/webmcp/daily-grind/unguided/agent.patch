diff --git a/webmcp.js b/webmcp.js
new file mode 100644
index 0000000..aad7fbc
--- /dev/null
+++ b/webmcp.js
@@ -0,0 +1,173 @@
+(() => {
+  'use strict';
+
+  // Read the visible menu so agent responses and the page use the same data.
+  const cards = [...document.querySelectorAll('[data-drink-id]')];
+  const menu = cards.map((card) => ({
+    id: card.dataset.drinkId,
+    name: card.querySelector('h3').textContent.trim(),
+    description: card.querySelector('p').textContent.trim(),
+    detailsUrl: card.querySelector('a').getAttribute('href'),
+  }));
+  const drinkSelect = document.getElementById('order-drink');
+  const quantityInput = document.getElementById('order-quantity');
+  const status = document.getElementById('order-status');
+  const orderList = document.getElementById('order-list');
+  const orders = [];
+
+  for (const drink of menu) {
+    const option = document.createElement('option');
+    option.value = drink.id;
+    option.textContent = drink.name;
+    drinkSelect.append(option);
+  }
+
+  function findDrink(drinkId) {
+    const drink = menu.find((item) => item.id === drinkId);
+    if (!drink) throw new Error('Unknown drink. Use an id returned by get_seasonal_menu.');
+    return drink;
+  }
+
+  // Shared actions keep tool calls and normal page controls in sync.
+  function selectDrink(drinkId) {
+    const drink = findDrink(drinkId);
+    drinkSelect.value = drink.id;
+    for (const card of cards) {
+      card.classList.toggle('is-selected', card.dataset.drinkId === drink.id);
+    }
+    status.textContent = `${drink.name} selected. Choose a quantity and add it to your demo order.`;
+    return drink;
+  }
+
+  function revealOrder() {
+    document.getElementById('order').scrollIntoView({ block: 'nearest' });
+    document.getElementById('order-heading').focus({ preventScroll: true });
+  }
+
+  function orderDrink(drinkId, quantity = 1) {
+    const drink = findDrink(drinkId);
+    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+      throw new Error('Quantity must be a whole number from 1 to 10.');
+    }
+    // Validate everything before making any UI or order changes.
+    selectDrink(drink.id);
+    quantityInput.value = String(quantity);
+    const order = {
+      id: `demo-${orders.length + 1}`,
+      drinkId: drink.id,
+      name: drink.name,
+      quantity,
+      status: 'demo-only',
+    };
+    orders.push(order);
+    const row = document.createElement('li');
+    row.textContent = `${quantity} × ${drink.name} (${order.id})`;
+    orderList.append(row);
+    status.textContent = `Added ${quantity} × ${drink.name} to your demo order. Nothing was sent to a café.`;
+    return { order: { ...order }, totalDrinks: orders.reduce((sum, item) => sum + item.quantity, 0) };
+  }
+
+  document.getElementById('order').hidden = false;
+  for (const button of document.querySelectorAll('[data-select-drink]')) {
+    button.hidden = false;
+    button.addEventListener('click', () => {
+      selectDrink(button.dataset.selectDrink);
+      revealOrder();
+    });
+  }
+  drinkSelect.addEventListener('change', () => selectDrink(drinkSelect.value));
+  document.getElementById('order-form').addEventListener('submit', (event) => {
+    event.preventDefault();
+    try {
+      orderDrink(drinkSelect.value, Number(quantityInput.value));
+    } catch (error) {
+      status.textContent = error.message;
+    }
+  });
+
+  const drinkIdSchema = {
+    type: 'string',
+    enum: menu.map((drink) => drink.id),
+    description: 'The seasonal drink to select or order.',
+  };
+  const schema = (properties, required = []) => ({
+    type: 'object', properties, required, additionalProperties: false,
+  });
+  const result = (value, isError = false) => ({
+    content: [{ type: 'text', text: JSON.stringify(value) }],
+    ...(isError ? { isError: true } : {}),
+  });
+
+  // WebMCP does not validate schemas or apply defaults for us.
+  function execute(allowedKeys, action) {
+    return (input = {}, options = {}) => {
+      options.signal?.throwIfAborted();
+      try {
+        if (!input || typeof input !== 'object' || Array.isArray(input) ||
+            Object.keys(input).some((key) => !allowedKeys.includes(key))) {
+          throw new Error('Pass an object containing only the parameters listed in the tool schema.');
+        }
+        return result(action(input));
+      } catch (error) {
+        return result({ error: error.message }, true);
+      }
+    };
+  }
+
+  const tools = [
+    {
+      name: 'get_seasonal_menu',
+      description: 'Query the Daily Grind Seasonal Favorites by name or description. Returns menu details and drink ids for selection or demo ordering. Does not change the page.',
+      inputSchema: schema({ query: { type: 'string', description: 'Text to match against drink names and descriptions.', default: '' } }),
+      execute: execute(['query'], ({ query = '' }) => {
+        if (typeof query !== 'string') throw new Error('Query must be text.');
+        const search = query.trim().toLowerCase();
+        const drinks = menu.filter((drink) => `${drink.name} ${drink.description}`.toLowerCase().includes(search));
+        return { section: 'Seasonal Favorites', drinks, count: drinks.length, ordering: 'Local demo only; no payment or café fulfillment.' };
+      }),
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'select_drink',
+      description: 'Highlight a seasonal drink and select it in the visible order form. Opens the order section without adding an order.',
+      inputSchema: schema({ drinkId: drinkIdSchema }, ['drinkId']),
+      execute: execute(['drinkId'], ({ drinkId }) => {
+        const drink = selectDrink(drinkId);
+        revealOrder();
+        return { selectedDrink: drink, orderAdded: false };
+      }),
+      annotations: { readOnlyHint: false },
+    },
+    {
+      name: 'order_drink',
+      description: 'Add a seasonal drink to the visible local demo order list and show confirmation. Each call adds a new entry. No payment is taken and no order is sent to a café; entries reset on reload.',
+      inputSchema: schema({
+        drinkId: drinkIdSchema,
+        quantity: { type: 'integer', minimum: 1, maximum: 10, default: 1, description: 'Number of drinks to add.' },
+      }, ['drinkId']),
+      execute: execute(['drinkId', 'quantity'], ({ drinkId, quantity = 1 }) => {
+        const order = orderDrink(drinkId, quantity);
+        revealOrder();
+        return order;
+      }),
+      annotations: { readOnlyHint: false },
+    },
+  ];
+
+  // The API moved to document; retain support for early navigator-based browsers.
+  // Unsupported browsers still get the complete interactive ordering UI.
+  const modelContext = typeof document.modelContext?.registerTool === 'function'
+    ? document.modelContext
+    : navigator.modelContext;
+  if (typeof modelContext?.registerTool !== 'function') return;
+
+  for (const tool of tools) {
+    try {
+      Promise.resolve(modelContext.registerTool(tool)).catch((error) => {
+        console.warn(`WebMCP could not register ${tool.name}.`, error);
+      });
+    } catch (error) {
+      console.warn(`WebMCP could not register ${tool.name}.`, error);
+    }
+  }
+})();
diff --git a/webmcp.test.cjs b/webmcp.test.cjs
new file mode 100644
index 0000000..5918e32
--- /dev/null
+++ b/webmcp.test.cjs
@@ -0,0 +1,160 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+
+const html = readFileSync(`${__dirname}/index.html`, 'utf8');
+const script = readFileSync(`${__dirname}/webmcp.js`, 'utf8');
+
+// A small DOM double exercises client actions without a browser or server.
+function element() {
+  const classes = new Set();
+  return {
+    textContent: '', value: '', hidden: true, children: [], listeners: {},
+    dataset: {},
+    classList: {
+      toggle(name, enabled) { enabled ? classes.add(name) : classes.delete(name); },
+      contains(name) { return classes.has(name); },
+    },
+    append(child) { this.children.push(child); },
+    addEventListener(name, callback) { this.listeners[name] = callback; },
+    scrollIntoView() { this.scrolled = true; },
+    focus() { this.focused = true; },
+  };
+}
+
+function setup({ api = 'document', failRegistration = false } = {}) {
+  const elements = Object.fromEntries(
+    ['order', 'order-drink', 'order-quantity', 'order-heading', 'order-status', 'order-list', 'order-form']
+      .map((id) => [id, element()]),
+  );
+  const cards = [...html.matchAll(/<div class="card" data-drink-id="([^"]+)">([\s\S]*?)<\/div>/g)].map(([, id, markup]) => {
+    const card = element();
+    card.dataset.drinkId = id;
+    card.querySelector = (selector) => {
+      if (selector === 'a') return { getAttribute: () => markup.match(/href="([^"]+)"/)[1] };
+      return { textContent: markup.match(new RegExp(`<${selector}>(.*?)</${selector}>`))[1] };
+    };
+    return card;
+  });
+  const buttons = cards.map((card) => Object.assign(element(), { dataset: { selectDrink: card.dataset.drinkId } }));
+  const tools = new Map();
+  const warnings = [];
+  const context = {
+    registerTool(tool) {
+      assert.equal(this, context, 'registerTool retains its API receiver');
+      if (failRegistration) return Promise.reject(new Error('Unavailable'));
+      assert.ok(!tools.has(tool.name), 'each tool is registered once');
+      tools.set(tool.name, tool);
+    },
+  };
+  const document = {
+    querySelectorAll: (selector) => selector === '[data-drink-id]' ? cards : buttons,
+    getElementById: (id) => elements[id],
+    createElement: () => element(),
+  };
+  const navigator = {};
+  if (api === 'document') document.modelContext = context;
+  if (api === 'navigator') navigator.modelContext = context;
+  runInNewContext(script, { document, navigator, console: { warn: (...args) => warnings.push(args) } });
+  const call = (name, input, options) => {
+    const response = tools.get(name).execute(input, options);
+    return { ...JSON.parse(response.content[0].text), isError: response.isError === true };
+  };
+  return { tools, call, elements, cards, buttons, warnings };
+}
+
+test('registers current and legacy WebMCP APIs with schemas and read-only metadata', () => {
+  for (const api of ['document', 'navigator']) {
+    const { tools } = setup({ api });
+    assert.deepEqual([...tools.keys()], ['get_seasonal_menu', 'select_drink', 'order_drink']);
+    assert.equal(tools.get('get_seasonal_menu').annotations.readOnlyHint, true);
+    assert.equal(tools.get('order_drink').annotations.readOnlyHint, false);
+    assert.equal(tools.get('order_drink').inputSchema.additionalProperties, false);
+  }
+});
+
+test('queries the actual menu without mutating UI, including empty and invalid queries', () => {
+  const { call, elements } = setup();
+  assert.equal(call('get_seasonal_menu').count, 3);
+  const filtered = call('get_seasonal_menu', { query: '  OAT  ' });
+  assert.equal(filtered.count, 1);
+  assert.equal(filtered.drinks[0].name, 'Maple Oat Latte');
+  assert.equal(filtered.drinks[0].detailsUrl, '/menu/seasonal');
+  assert.equal(call('get_seasonal_menu', { query: '18 hours' }).drinks[0].id, 'cold-brew');
+  assert.equal(call('get_seasonal_menu', { query: 'tea' }).count, 0);
+  assert.equal(call('get_seasonal_menu', { query: 123 }).isError, true);
+  assert.equal(elements['order-status'].textContent, '');
+  assert.equal(elements['order-list'].children.length, 0);
+});
+
+test('selection updates the dropdown and highlight, reveals and focuses the form without ordering', () => {
+  const { call, elements, cards } = setup();
+  const response = call('select_drink', { drinkId: 'cold-brew' });
+  assert.equal(response.selectedDrink.name, 'Cold Brew');
+  assert.equal(response.orderAdded, false);
+  assert.equal(elements['order-drink'].value, 'cold-brew');
+  assert.equal(cards[2].classList.contains('is-selected'), true);
+  assert.equal(cards[0].classList.contains('is-selected'), false);
+  assert.equal(elements.order.scrolled, true);
+  assert.equal(elements['order-heading'].focused, true);
+  assert.equal(elements['order-list'].children.length, 0);
+});
+
+test('orders update visible confirmation and entries, apply defaults, and accumulate totals', () => {
+  const { call, elements } = setup();
+  const first = call('order_drink', { drinkId: 'maple-oat-latte', quantity: 2 });
+  assert.equal(first.order.quantity, 2);
+  assert.equal(first.order.status, 'demo-only');
+  assert.equal(first.totalDrinks, 2);
+  assert.match(elements['order-status'].textContent, /Nothing was sent/);
+  const second = call('order_drink', { drinkId: 'cold-brew' });
+  assert.equal(second.order.quantity, 1);
+  assert.equal(second.order.id, 'demo-2');
+  assert.equal(second.totalDrinks, 3);
+  assert.equal(elements['order-list'].children.length, 2);
+  assert.match(elements['order-list'].children[0].textContent, /2 × Maple Oat Latte/);
+});
+
+test('invalid input and cancelled execution leave orders and selection untouched', () => {
+  const { call, elements, tools } = setup();
+  const invalid = [null, [], {}, { drinkId: 'unknown' }, { drinkId: 'cold-brew', extra: true }];
+  for (const quantity of [0, -1, 11, 1.5, '2', null]) invalid.push({ drinkId: 'cold-brew', quantity });
+  for (const input of invalid) {
+    const response = call('order_drink', input);
+    assert.equal(response.isError, true);
+    assert.ok(response.error);
+  }
+  const controller = new AbortController();
+  controller.abort();
+  assert.throws(() => tools.get('order_drink').execute({ drinkId: 'cold-brew' }, { signal: controller.signal }));
+  assert.equal(elements['order-status'].textContent, '');
+  assert.equal(elements['order-list'].children.length, 0);
+});
+
+test('ordinary controls work without WebMCP and share the tool behavior', () => {
+  const { tools, elements, buttons, cards } = setup({ api: 'none' });
+  assert.equal(tools.size, 0);
+  assert.equal(elements.order.hidden, false);
+  assert.equal(elements['order-drink'].children.length, 3);
+  assert.equal(buttons[1].hidden, false);
+  buttons[1].listeners.click();
+  assert.equal(elements['order-drink'].value, 'dark-roast-espresso');
+  assert.equal(cards[1].classList.contains('is-selected'), true);
+  elements['order-quantity'].value = '3';
+  let prevented = false;
+  elements['order-form'].listeners.submit({ preventDefault() { prevented = true; } });
+  assert.equal(prevented, true);
+  assert.match(elements['order-list'].children[0].textContent, /3 × Dark Roast Espresso/);
+  elements['order-drink'].value = 'cold-brew';
+  elements['order-drink'].listeners.change();
+  assert.equal(cards[1].classList.contains('is-selected'), false);
+  assert.equal(cards[2].classList.contains('is-selected'), true);
+});
+
+test('registration rejection does not break page interactions or escape unhandled', async () => {
+  const { elements, warnings } = setup({ failRegistration: true });
+  await new Promise((resolve) => setImmediate(resolve));
+  assert.equal(warnings.length, 3);
+  assert.equal(elements.order.hidden, false);
+});
