index 0000000..cba16f9
--- /dev/null
+++ b/src/lib/webmcp.ts
@@ -0,0 +1,36 @@
+import type { FormEvent } from 'react';
+
+// Local types for the experimental browser API; no runtime polyfill required.
+export interface Tool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations?: { readOnlyHint: boolean };
+  execute: (args: Record<string, unknown>) => Promise<unknown>;
+}
+export interface ModelContext {
+  registerTool(tool: Tool): void | Promise<void>;
+  unregisterTool(name: string): void;
+}
+export function modelContext() {
+  return (navigator as Navigator & { modelContext?: ModelContext }).modelContext
