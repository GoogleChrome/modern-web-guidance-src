diff --git a/src/components/WebMCP.tsx b/src/components/WebMCP.tsx
new file mode 100644
index 0000000..3e7f4ea
--- /dev/null
+++ b/src/components/WebMCP.tsx
@@ -0,0 +1,88 @@
+import { useEffect } from 'react';
+import { getArticles, getReadingList, searchArticles, updateReadingList } from '../lib/articles';
+import { modelContext, type Tool } from '../lib/webmcp';
+
+export default function WebMCP() {
+  useEffect(() => {
+    const context = modelContext();
+    if (!context) return;
+    const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+    const tools: Tool[] = [
+      {
+        name: 'search_articles',
+        description: 'Search The DevTools Times article titles and summaries. Returns matching articles and URLs.',
+        inputSchema: { type: 'object', properties: { query: { type: 'string', minLength: 1, description: 'Words to match in article titles or summaries.' } }, required: ['query'], additionalProperties: false },
+        annotations: { readOnlyHint: true },
+        execute: async ({ query }) => {
+          if (typeof query !== 'string' || !query.trim()) throw new Error('A nonempty query is required.');
+          return searchArticles(await getArticles(), query).map(article => ({ ...article, url: new URL(`${import.meta.env.BASE_URL}articles/${article.slug}`, location.origin).href }));
+        },
+      },
+      {
+        name: 'get_reading_list', description: 'Read the current session’s saved articles.', inputSchema: emptySchema,
+        annotations: { readOnlyHint: true },
+        execute: async () => {
+          const [articles, slugs] = await Promise.all([getArticles(), getReadingList()]);
+          return articles.filter(article => slugs.includes(article.slug));
+        },
+      },
+      {
+        name: 'update_reading_list', description: 'Add or remove an article from the current session’s reading list. Repeating an action is safe.',
+        inputSchema: { type: 'object', properties: { slug: { type: 'string', description: 'An article slug returned by search_articles.' }, action: { type: 'string', enum: ['add', 'remove'], description: 'Whether to save or remove the article.' } }, required: ['slug', 'action'], additionalProperties: false },
+        execute: async ({ slug, action }) => {
+          if (typeof slug !== 'string' || (action !== 'add' && action !== 'remove')) throw new Error('An article slug and add/remove action are required.');
+          return { readingList: await updateReadingList(slug, action) };
+        },
+      },
+      ...(['search', 'reading-list'] as const).map(panel => ({
+        name: `open_${panel.replace('-', '_')}`,
+        description: `Open the ${panel} panel to discover and use its form.`,
+        inputSchema: emptySchema,
+        execute: async () => {
+          const name = panel === 'search' ? 'search_articles_form' : 'manage_reading_list_form';
+          await new Promise<void>((resolve, reject) => {
+            const observer = new MutationObserver(check);
+            const timeout = window.setTimeout(() => {
+              observer.disconnect();
+              reject(new Error(`Unable to open ${panel} panel. Please try again.`));
+            }, 15000);
+            function check() {
+              if (document.querySelector(`form[toolname="${name}"]`)) {
+                observer.disconnect();
+                window.clearTimeout(timeout);
+                resolve();
+              }
+            }
+            observer.observe(document.body, { childList: true, subtree: true });
+            window.dispatchEvent(new Event(`open-${panel}`));
+            check();
+          });
+          return `Opened ${panel} panel. The ${name} tool is ready.`;
+        },
+      })),
+    ];
+    if (document.querySelector('[data-article-body]')) tools.push({
+      name: 'read_current_article', description: 'Read the title, summary and body text of the current article.',
+      inputSchema: emptySchema, annotations: { readOnlyHint: true },
+      execute: async () => ({ title: document.querySelector('h1')?.textContent?.trim(), summary: document.querySelector('[data-article-summary]')?.textContent?.trim(), body: document.querySelector<HTMLElement>('[data-article-body]')?.innerText?.trim(), url: location.href }),
+    });
+    let disposed = false;
+    const registered: string[] = [];
+    const registration = (async () => {
+      for (const tool of tools) {
+        if (disposed) break;
+        try {
+          await context.registerTool(tool);
+          if (disposed) context.unregisterTool(tool.name);
+          else registered.push(tool.name);
+        } catch (error) { console.warn(`WebMCP: unable to register ${tool.name}`, error); }
+      }
+    })();
+    return () => {
+      disposed = true;
+      for (const name of registered) context.unregisterTool(name);
+      void registration;
+    };
+  }, []);
+  return null;
+}
diff --git a/src/lib/articles.ts b/src/lib/articles.ts
new file mode 100644
index 0000000..2dfe33f
--- /dev/null
+++ b/src/lib/articles.ts
@@ -0,0 +1,37 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export async function getArticles(): Promise<Article[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/articles.json`);
+  if (!response.ok) throw new Error(`Unable to load articles (${response.status})`);
+  return response.json();
+}
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  ) : [];
+}
+
+export async function getReadingList(): Promise<string[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`);
+  if (!response.ok) throw new Error(`Unable to load reading list (${response.status})`);
+  return (await response.json()).readingList;
+}
+
+export async function updateReadingList(slug: string, action: 'add' | 'remove' | 'toggle'): Promise<string[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug, action }),
+  });
+  if (!response.ok) throw new Error(`Unable to update reading list (${response.status})`);
+  const { readingList } = await response.json();
+  window.dispatchEvent(new CustomEvent('reading-list-changed', { detail: readingList }));
+  return readingList;
+}
