@@ -0,0 +1,40 @@
+// Declarative submit extensions are not yet included in webmcp-types.
+export type AgentSubmitEvent = SubmitEvent & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<unknown>) => void;
+};
+
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export async function getArticles(signal?: AbortSignal): Promise<Article[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/articles.json`, { signal });
+  if (!response.ok) throw new Error(`Could not load articles (HTTP ${response.status}). Please retry.`);
+  return response.json();
+}
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article => `${article.title} ${article.summary}`.toLowerCase().includes(term)) : [];
+}
+
+export async function readingListRequest(slug?: string, action?: string, signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+    method: slug ? 'POST' : 'GET',
+    headers: slug ? { 'Content-Type': 'application/json' } : undefined,
+    body: slug ? JSON.stringify({ slug, action }) : undefined,
+    signal,
+  });
+  if (!response.ok) throw new Error(`Could not update the reading list (HTTP ${response.status}). Please retry.`);
+  const data = await response.json();
+  window.dispatchEvent(new CustomEvent('reading-list-updated', { detail: data.readingList }));
+  return data.readingList;
+}
+
+export function errorResult(error: unknown) {
+  return { error: error instanceof Error ? error.message : 'The request failed. Please retry.' };
+}
