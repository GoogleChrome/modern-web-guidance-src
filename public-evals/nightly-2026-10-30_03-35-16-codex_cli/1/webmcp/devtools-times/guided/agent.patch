diff --git a/src/components/ArticleTools.tsx b/src/components/ArticleTools.tsx
new file mode 100644
index 0000000..d665288
--- /dev/null
+++ b/src/components/ArticleTools.tsx
@@ -0,0 +1,86 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { errorResult } from '../lib/articles';
+
+interface Props {
+  slug: string;
+  title: string;
+  summary: string;
+}
+
+const emptyInput = { type: 'object', properties: {}, additionalProperties: false } as const;
+
+// Keep HTTP failures and redirects visible to agents, including the intentional
+// failing endpoints used by this DevTools demo. Never mistake an HTML error for JSON.
+export async function fetchArticleUtility(path: string, signal: AbortSignal) {
+  try {
+    const response = await fetch(`${import.meta.env.BASE_URL}api/${path}`, { signal });
+    const body = response.headers.get('content-type')?.includes('application/json')
+      ? await response.json()
+      : await response.text();
+    signal.throwIfAborted();
+    return {
+      ...(response.ok ? {} : { error: `Article utility returned HTTP ${response.status}.` }),
+      status: response.status,
+      redirected: response.redirected,
+      url: response.url,
+      data: body,
+    };
+  } catch (error) {
+    if (signal.aborted) throw error;
+    return errorResult(error);
+  }
+}
+
+export default function ArticleTools({ slug, title, summary }: Props) {
+  useWebMCP({
+    name: 'read_current_article',
+    description: 'Read the text and metadata of the article currently open in The DevTools Times.',
+    inputSchema: emptyInput,
+    execute() {
+      const body = document.querySelector<HTMLElement>('[data-article-body]');
+      if (!body) return { error: 'Open an article before reading its text.' };
+      // Exclude scripts, style rules, and hidden markup from article text.
+      const content = body.cloneNode(true) as HTMLElement;
+      content.querySelectorAll('script, style, [hidden]').forEach(node => node.remove());
+      return { slug, title, summary, url: window.location.href, text: content.textContent?.trim() ?? '' };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_article_popularity',
+    description: 'Fetch popularity statistics for the current article.',
+    inputSchema: emptyInput,
+    execute: (_, { signal }) => fetchArticleUtility(`article-popularity?id=${encodeURIComponent(slug)}`, signal),
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_coffee_brew',
+    description: 'Fetch coffee brewing data for the coffee article, including service errors.',
+    enabled: slug === 'coffee-alchemy',
+    inputSchema: emptyInput,
+    execute: (_, { signal }) => fetchArticleUtility('coffee-brew', signal),
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_tide_levels',
+    description: 'Fetch tide data for the coastal article, including redirect and service status.',
+    enabled: slug === 'coastal-pulse',
+    inputSchema: emptyInput,
+    execute: (_, { signal }) => fetchArticleUtility('tide-levels', signal),
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_plant_stats',
+    description: 'Fetch plant statistics for the plant article.',
+    enabled: slug === 'silent-architects',
+    inputSchema: emptyInput,
+    execute: (_, { signal }) => fetchArticleUtility('plant-stats', signal),
+    annotations: { readOnlyHint: true },
+  });
+
+  return null;
+}
