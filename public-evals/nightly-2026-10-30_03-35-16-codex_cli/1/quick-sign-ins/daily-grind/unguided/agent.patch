+        } catch (error) {
+          if (controller.signal.aborted) return;
+          // Background autofill must never interrupt browsing or password sign-in.
+          if (!conditional) {
+            message(error.name === 'NotAllowedError'
+              ? 'Passkey sign-in was canceled or unavailable. Try again or use your password.'
+              : 'Passkey sign-in is unavailable. Please try again or use your password.', true);
