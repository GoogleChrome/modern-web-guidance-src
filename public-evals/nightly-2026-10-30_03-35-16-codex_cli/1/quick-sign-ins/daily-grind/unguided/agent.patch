+  <script>
+    (() => {
+      const form = document.querySelector('#signin-form');
+      const email = document.querySelector('#signin-email');
+      const password = document.querySelector('#signin-password');
+      const passkeyButton = document.querySelector('#signin-passkey');
+      const status = document.querySelector('#signin-status');
+      let pendingPasskey;
+      let busy = false;
+      let authenticated = false;
+
+      // Backend contract (same-origin HTTPS, HttpOnly session cookie):
+      // POST /api/auth/passkey/options -> PublicKeyCredentialRequestOptions JSON
+      // with a server-generated, session-bound challenge and base64url binary fields.
+      // POST /api/auth/passkey/verify -> { authenticated: true } only after verifying
+      // the assertion, challenge, origin and RP ID. POST /api/auth/password takes
+      // { username, password } and returns the same result after credential validation.
+      // Both authentication endpoints must validate origin/CSRF and rate-limit attempts.
+      async function request(path, body, signal) {
+        const response = await fetch(path, {
+          method: 'POST',
+          credentials: 'same-origin',
+          redirect: 'error',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(body),
+          signal
+        });
+        if (!response.ok) {
+          if (response.status === 401 || response.status === 403) {
+            throw new Error('Unable to sign in. Check your details or try another sign-in method.');
+          }
+          throw new Error('Sign-in is temporarily unavailable. Please try again later.');
+        }
+        if (!response.headers.get('content-type')?.includes('application/json')) {
+          throw new Error('Sign-in is temporarily unavailable. Please try again later.');
+        }
+        return response.json();
+      }
+
+      function message(text, error = false) {
+        status.textContent = text;
+        status.dataset.error = String(error);
+      }
+
+      function setBusy(value) {
+        busy = value;
+        form.setAttribute('aria-busy', String(value));
+        form.querySelector('button').disabled = value;
+        passkeyButton.disabled = value;
+      }
+
+      function finish(result) {
+        if (result.authenticated !== true) {
+          throw new Error('Sign-in could not be confirmed. Please try again.');
+        }
+        authenticated = true;
+        pendingPasskey?.abort();
+        password.value = '';
+        form.hidden = true;
+        passkeyButton.hidden = true;
+        document.querySelector('#signin-intro').textContent = 'You’re signed in. Enjoy your next cup.';
+        message('Signed in successfully. You can keep browsing this page.');
+        // Restore the requested destinations only after the server confirms sign-in.
+        const destinations = { Rewards: '/rewards', 'My Account': '/account', 'Order Now': '/order-online' };
+        document.querySelectorAll('[data-signin]').forEach(link => {
+          link.href = destinations[link.dataset.signin];
+        });
+      }
+
+      document.querySelectorAll('[data-signin]').forEach(link => {
+        link.addEventListener('click', event => {
+          if (authenticated || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+          event.preventDefault();
+          document.querySelector('#signin').scrollIntoView({ block: 'center' });
+          email.focus({ preventScroll: true });
+          message(`Sign in here to access ${link.dataset.signin}.`);
+        });
+      });
+
+      const decode = value => Uint8Array.from(atob(value.replace(/-/g, '+').replace(/_/g, '/')), char => char.charCodeAt(0));
+      const encode = buffer => btoa(String.fromCharCode(...new Uint8Array(buffer))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
