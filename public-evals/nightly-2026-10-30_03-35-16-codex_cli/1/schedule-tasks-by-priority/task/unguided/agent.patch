+  <script>
+    (() => {
+      const types = {
+        checkout: { name: 'Checkout', priority: 0, label: 'Urgent', slices: 80 },
+        menu: { name: 'Menu update', priority: 1, label: 'Standard', slices: 140 },
+        telemetry: { name: 'Telemetry logging', priority: 2, label: 'Background', slices: 200 }
+      };
+      const queue = [];
+      const list = document.getElementById('queue-list');
+      const status = document.getElementById('queue-status');
+      const count = document.getElementById('queue-count');
+      const log = document.getElementById('activity-log');
+      const controls = document.querySelectorAll('[data-task], #run-batch');
+      let sequence = 0;
+      let completed = 0;
+      let running = false;
+      let activeId = null;
+
+      function record(message) {
+        if (!sequence || log.firstElementChild?.textContent === 'Waiting for your first task.') log.replaceChildren();
+        const entry = document.createElement('li');
+        const time = document.createElement('time');
+        time.dateTime = new Date().toISOString();
+        time.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
+        entry.append(time, document.createTextNode(message));
+        log.prepend(entry);
+        while (log.children.length > 30) log.lastElementChild.remove();
+      }
+
+      function render() {
+        queue.sort((a, b) => a.priority - b.priority || a.id - b.id);
+        const fragment = document.createDocumentFragment();
+        for (const task of queue) {
+          const row = document.createElement('li');
+          row.className = 'queue-row';
+          const name = document.createElement('span');
+          name.textContent = `${task.name} #${task.id}`;
+          const state = document.createElement('span');
+          state.className = 'task-state';
+          state.textContent = `${task.label} · ${task.id === activeId ? 'Running' : task.done ? 'Paused' : 'Queued'}`;
+          const progress = document.createElement('progress');
+          progress.max = task.slices;
+          progress.value = task.done;
+          progress.setAttribute('aria-label', `${task.name} #${task.id} progress`);
+          row.append(name, state, progress);
+          fragment.append(row);
+        }
+        if (!queue.length) {
+          const empty = document.createElement('li');
+          empty.className = 'queue-empty';
+          empty.textContent = completed ? 'All tasks served. Ready for the next rush.' : 'All quiet at the counter. Add a task to get started.';
+          fragment.append(empty);
+        }
+        list.replaceChildren(fragment);
+        count.textContent = `${queue.length} pending · ${completed} completed`;
+        status.textContent = queue.length ? 'Queue in motion' : completed ? 'All caught up' : 'Ready to brew';
+        controls.forEach(button => { button.disabled = queue.length > 97; });
+      }
+
+      // Yield to the browser between every bounded slice. Re-select the highest
+      // priority task after yielding, so newly added checkouts can interrupt work.
+      function yieldToBrowser(priority) {
+        if (globalThis.scheduler?.postTask) {
+          return globalThis.scheduler.postTask(() => {}, {
+            priority: ['user-blocking', 'user-visible', 'background'][priority], delay: 16
+          }).catch(() => new Promise(resolve => setTimeout(resolve, 16)));
+        }
+        return new Promise(resolve => setTimeout(resolve, 16));
+      }
+
+      async function drain() {
+        if (running) return;
+        running = true;
+        try {
+          while (queue.length) {
+            queue.sort((a, b) => a.priority - b.priority || a.id - b.id);
+            const task = queue[0];
+            if (activeId !== task.id) {
+              if (activeId !== null) {
+                const previous = queue.find(item => item.id === activeId);
+                if (previous) record(`Paused ${previous.name.toLowerCase()} #${previous.id} for urgent work.`);
+              }
+              activeId = task.id;
+              record(`${task.done ? 'Resumed' : 'Started'} ${task.name.toLowerCase()} #${task.id}.`);
+            }
+            // A small CPU workload stands in for a long operation, bounded to 3 ms.
+            const deadline = performance.now() + 3;
+            while (performance.now() < deadline) Math.sqrt(Math.random());
+            task.done++;
+            if (task.done === task.slices) {
+              queue.splice(queue.indexOf(task), 1);
+              completed++;
+              activeId = null;
+              record(`Completed ${task.name.toLowerCase()} #${task.id}.`);
+            }
+            render();
+            await yieldToBrowser(queue[0]?.priority ?? 2);
+          }
+        } finally {
+          running = false;
+          activeId = null;
+          render();
+        }
+      }
+
+      function enqueue(keys) {
+        if (queue.length + keys.length > 100) return;
+        for (const key of keys) {
+          const task = { ...types[key], id: ++sequence, done: 0 };
+          queue.push(task);
+          record(`Queued ${task.name.toLowerCase()} #${task.id} · ${task.label.toLowerCase()}.`);
+        }
+        render();
+        void drain();
+      }
+      document.querySelectorAll('[data-task]').forEach(button => {
+        button.addEventListener('click', () => enqueue([button.dataset.task]));
+      });
+      document.getElementById('run-batch').addEventListener('click', () => enqueue(['telemetry', 'menu', 'checkout']));
+    })();
+  </script>
