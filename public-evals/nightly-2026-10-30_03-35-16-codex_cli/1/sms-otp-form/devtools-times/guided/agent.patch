diff --git a/src/pages/api/signup/phone.ts b/src/pages/api/signup/phone.ts
new file mode 100644
index 0000000..1e9eb57
--- /dev/null
+++ b/src/pages/api/signup/phone.ts
@@ -0,0 +1,121 @@
+import type { APIRoute } from 'astro';
+
+const REGISTER_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register';
+const WINDOW = 10 * 60 * 1000;
+
+type Challenge = {
+  phone: string;
+  sid: string;
+  expiresAt: number;
+  lastSentAt: number;
+  attempts: number;
+  verified: boolean;
+};
+
+declare global {
+  namespace App {
+    interface SessionData { signupPhone?: Challenge }
+  }
+}
+
+function json(body: Record<string, unknown>, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  // This app disables Astro's global origin check, so enforce it for this endpoint.
+  if (request.headers.get('origin') !== url.origin || !request.headers.get('content-type')?.includes('application/json')) {
+    return json({ error: 'Please submit this form from the sign-up page.' }, 403);
+  }
+  if (!session) return json({ error: 'Verification is temporarily unavailable.' }, 503);
+
+  const account = process.env.TWILIO_ACCOUNT_SID;
+  const token = process.env.TWILIO_AUTH_TOKEN;
+  const service = process.env.TWILIO_VERIFY_SERVICE_SID;
+  const template = process.env.TWILIO_VERIFY_TEMPLATE_SID;
+  if (!account || !token || !service || !template) {
+    return json({ error: 'SMS verification is not configured yet. Please try again later.' }, 503);
+  }
+
+  async function verifyApi(path: string, fields: Record<string, string>) {
+    return fetch(`https://verify.twilio.com/v2/Services/${encodeURIComponent(service!)}/${path}`, {
+      method: 'POST',
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${account}:${token}`).toString('base64')}`,
+        'Content-Type': 'application/x-www-form-urlencoded',
+      },
+      body: new URLSearchParams(fields),
+      signal: AbortSignal.timeout(15000),
+    });
+  }
+
+  try {
+    const body = await request.json();
+    if (!body || typeof body !== 'object') return json({ error: 'Invalid request.' }, 400);
+    const challenge = await session.get('signupPhone');
+    const now = Date.now();
+
+    if (body.action === 'send') {
+      const phone = typeof body.phone === 'string' ? body.phone.replace(/[\s().-]/g, '') : '';
+      if (!/^\+[1-9][0-9]{7,14}$/.test(phone)) {
+        return json({ error: 'Enter a valid mobile number with a + and country code.' }, 400);
+      }
+      const retryAfter = challenge ? Math.ceil((challenge.lastSentAt + 30000 - now) / 1000) : 0;
+      if (retryAfter > 0) return json({ error: 'Please wait before requesting another code.', retryAfter }, 429);
+      const response = await verifyApi('Verifications', {
+        To: phone, Channel: 'sms', TemplateSid: template,
+        TemplateCustomSubstitutions: JSON.stringify({ domain: url.hostname }),
+      });
+      const data = await response.json();
+      if (!response.ok || data.status !== 'pending' || typeof data.sid !== 'string') {
+        return json({ error: response.status === 429 ? 'Too many requests. Please try again later.' : 'The SMS could not be sent. Check your number and try again.' }, response.status === 429 ? 429 : 502);
+      }
+      await session.set('signupPhone', {
+        phone, sid: data.sid,
+        // Resends may reuse Twilio's original code; do not extend its lifetime.
+        expiresAt: challenge?.phone === phone && challenge.expiresAt > now ? challenge.expiresAt : now + WINDOW,
+        lastSentAt: now, attempts: challenge?.phone === phone && challenge.expiresAt > now ? challenge.attempts : 0, verified: false,
+      });
+      return json({ phone, retryAfter: 30 });
+    }
+
+    if (body.action !== 'register') return json({ error: 'Invalid request.' }, 400);
+    if (!challenge || challenge.expiresAt <= now) {
+      return json({ error: 'Your code has expired. Request a new code to continue.' }, 400);
+    }
+    const { username, password, code } = body;
+    if (typeof username !== 'string' || !username.trim() || typeof password !== 'string' || password.length < 8 || !/[0-9]/.test(password) || typeof code !== 'string' || !/^[0-9]{6}$/.test(code)) {
+      return json({ error: 'Check your account details and enter the six-digit SMS code.' }, 400);
+    }
+    if (!challenge.verified) {
+      if (challenge.attempts >= 5) return json({ error: 'Too many incorrect attempts. Please wait for the code to expire, then request a new one.' }, 429);
+      challenge.attempts += 1;
+      await session.set('signupPhone', challenge);
+      const response = await verifyApi('VerificationCheck', { VerificationSid: challenge.sid, Code: code });
+      const data = await response.json();
+      if (!response.ok || data.status !== 'approved') {
+        return json({ error: 'The code is incorrect or expired. Check the SMS or request a new code.' }, 400);
+      }
+      challenge.verified = true;
+      await session.set('signupPhone', challenge);
+    }
+
+    // The phone is taken from server state, never trusted from the registration payload.
+    const response = await fetch(REGISTER_URL, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password, phoneNumber: challenge.phone }),
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok) {
+      return json({ error: 'Account creation failed. Your username may be unavailable. Change your account details or try again.' }, 400);
+    }
+    await session.delete('signupPhone');
+    return json({ success: true });
+  } catch {
+    return json({ error: 'The request could not be completed. Please try again.' }, 502);
+  }
+};
