+import type { APIRoute } from 'astro';
+import { handleSignup } from '../../lib/signup';
+
+export const POST: APIRoute = ({ request }) => handleSignup(request, {
+  accountSid: process.env.TWILIO_ACCOUNT_SID,
+  authToken: process.env.TWILIO_AUTH_TOKEN,
+  serviceSid: process.env.TWILIO_VERIFY_SERVICE_SID,
+});
diff --git a/tests/signup.test.mjs b/tests/signup.test.mjs
new file mode 100644
index 0000000..f4ade0f
--- /dev/null
+++ b/tests/signup.test.mjs
@@ -0,0 +1,94 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { handleSignup } from '../src/lib/signup.ts';
+
+const config = { accountSid: 'ACtest', authToken: 'secret', serviceSid: 'VAtest' };
+const details = { action: 'verify', phone: '+12025550123', username: 'reader', password: 'password1', code: '012345' };
+const request = (body, origin = 'https://news.example') => new Request('https://news.example/devtools-times/api/signup', {
+  method: 'POST', headers: { 'Content-Type': 'application/json', Origin: origin }, body: JSON.stringify(body),
+});
+const reply = (body, status = 200) => new Response(JSON.stringify(body), { status });
+const neverFetch = () => { throw new Error('Unexpected network request'); };
+
+test('rejects cross-origin requests before contacting provider', async () => {
+  assert.equal((await handleSignup(request(details, 'https://other.example'), config, neverFetch)).status, 403);
+});
+
+test('requires a valid international phone and six numeric code characters', async () => {
+  for (const values of [{ phone: '2025550123' }, { code: '12345' }, { code: '12a456' }, { password: 'short1' }, { username: ' ' }]) {
+    assert.equal((await handleSignup(request({ ...details, ...values }), config, neverFetch)).status, 400);
+  }
+});
+
+test('handles malformed JSON and absent SMS configuration', async () => {
+  const malformed = new Request('https://news.example/api/signup', { method: 'POST', headers: { Origin: 'https://news.example' }, body: '{' });
+  assert.equal((await handleSignup(malformed, config, neverFetch)).status, 400);
+  assert.equal((await handleSignup(request(details), {}, neverFetch)).status, 503);
+});
+
+test('requests SMS delivery with server-side authentication', async () => {
+  let calls = 0;
+  const result = await handleSignup(request({ action: 'send', phone: details.phone }), config, async (url, options) => {
+    calls++;
+    assert.match(url, /\/VAtest\/Verifications$/);
+    assert.equal(options.headers.Authorization, `Basic ${Buffer.from('ACtest:secret').toString('base64')}`);
+    assert.equal(options.body.get('To'), details.phone);
+    assert.equal(options.body.get('Channel'), 'sms');
+    return reply({ status: 'pending' });
+  });
+  assert.equal(calls, 1);
+  assert.deepEqual(await result.json(), { sent: true });
+  assert.equal(result.headers.get('cache-control'), 'no-store');
+});
+
+test('never registers on incorrect, expired, exhausted, or failed verification', async () => {
+  for (const [body, status, expected] of [
+    [{ status: 'pending' }, 200, 400],
+    [{ code: 20404 }, 404, 400],
+    [{ code: 60202 }, 429, 429],
+    [{ status: 'expired' }, 200, 400],
+  ]) {
+    let calls = 0;
+    const result = await handleSignup(request(details), config, async (url) => {
+      calls++;
+      assert.match(url, /VerificationCheck$/);
+      return reply(body, status);
+    });
+    assert.equal(calls, 1);
+    assert.equal(result.status, expected);
+  }
+});
+
+test('registers only after approval and does not forward the OTP', async () => {
+  const calls = [];
+  const result = await handleSignup(request(details), config, async (url, options) => {
+    calls.push(url);
+    if (calls.length === 1) {
+      assert.equal(options.body.get('To'), details.phone);
+      assert.equal(options.body.get('Code'), '012345');
+      return reply({ status: 'approved' });
+    }
+    assert.match(url, /\/api\/register$/);
+    assert.deepEqual(JSON.parse(options.body), { username: 'reader', password: 'password1', phone: details.phone });
+    return reply({ success: true });
+  });
+  assert.equal(calls.length, 2);
+  assert.deepEqual(await result.json(), { registered: true });
+});
+
+test('does not report success when registration or the provider fails', async () => {
+  let calls = 0;
+  const failedRegistration = await handleSignup(request(details), config, async () => {
+    calls++;
+    return calls === 1 ? reply({ status: 'approved' }) : reply({ error: 'APP_ERR_1001' }, 409);
+  });
+  assert.equal(failedRegistration.status, 400);
+  assert.match((await failedRegistration.json()).error, /request a new code/);
+  const networkFailure = await handleSignup(request(details), config, async () => { throw new Error('offline'); });
+  assert.equal(networkFailure.status, 502);
+});
+
+test('handles provider send rate limits without attempting registration', async () => {
+  const result = await handleSignup(request({ action: 'send', phone: details.phone }), config, async () => reply({ code: 60203 }, 429));
+  assert.equal(result.status, 429);
