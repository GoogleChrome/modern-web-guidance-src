diff --git a/src/lib/signup.ts b/src/lib/signup.ts
new file mode 100644
index 0000000..2fed740
--- /dev/null
+++ b/src/lib/signup.ts
@@ -0,0 +1,82 @@
+import { Buffer } from 'node:buffer';
+
+export interface SmsConfig {
+  accountSid?: string;
+  authToken?: string;
+  serviceSid?: string;
+}
+
+const json = (body: object, status = 200) => new Response(JSON.stringify(body), {
+  status,
+  headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+
+// Keep provider credentials and code verification on the server.
+export async function handleSignup(request: Request, config: SmsConfig, fetcher: typeof fetch = fetch) {
+  if (request.headers.get('origin') !== new URL(request.url).origin) {
+    return json({ error: 'Please submit this form from the sign-up page.' }, 403);
+  }
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request.' }, 400);
+  }
+  if (!body || typeof body !== 'object') return json({ error: 'Invalid request.' }, 400);
+  const { action, phone, username, password, code } = body;
+  if (!['send', 'verify'].includes(action) || typeof phone !== 'string' || !/^\+[1-9]\d{7,14}$/.test(phone)) {
+    return json({ error: 'Enter a valid phone number including its country code.' }, 400);
+  }
+  if (action === 'verify' && (
+    typeof code !== 'string' || !/^\d{6}$/.test(code) ||
+    typeof username !== 'string' || !username.trim() || username.length > 100 ||
+    typeof password !== 'string' || password.length < 8 || password.length > 1024 || !/\d/.test(password)
+  )) return json({ error: 'Check your username, password, and six-digit code.' }, 400);
+
+  const { accountSid, authToken, serviceSid } = config;
+  if (!accountSid || !authToken || !serviceSid) {
+    return json({ error: 'SMS verification is currently unavailable. Please try again later.' }, 503);
+  }
+
+  try {
+    const sending = action === 'send';
+    const response = await fetcher(`https://verify.twilio.com/v2/Services/${encodeURIComponent(serviceSid)}/${sending ? 'Verifications' : 'VerificationCheck'}`, {
+      method: 'POST',
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${accountSid}:${authToken}`).toString('base64')}`,
+        'Content-Type': 'application/x-www-form-urlencoded',
+      },
+      body: new URLSearchParams(sending ? { To: phone, Channel: 'sms' } : { To: phone, Code: code }),
+      signal: AbortSignal.timeout(15000),
+    });
+    const result = await response.json();
+    if (response.status === 429 || result.code === 60202 || result.code === 60203) {
+      return json({ error: 'Too many attempts. Please wait a few minutes before trying again.' }, 429);
+    }
+    if (!response.ok) {
+      if (!sending && response.status === 404) {
+        return json({ error: 'This code has expired or was already used. Request a new code.' }, 400);
+      }
+      return json({ error: sending ? 'Unable to send a code. Check your phone number and try again.' : 'Unable to verify this code. Please request a new code.' }, 400);
+    }
+    if (sending) {
+      if (result.status !== 'pending') return json({ error: 'Unable to send a code. Please try again later.' }, 502);
+      return json({ sent: true });
+    }
+    if (result.status !== 'approved') return json({ error: 'That code is incorrect or expired. Please try again or request a new code.' }, 400);
+
+    // Registration is only attempted after the provider approves the code for this phone.
+    const registration = await fetcher('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: username.trim(), password, phone }),
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!registration.ok) {
+      return json({ error: 'Registration failed. The username may be unavailable. Change your details and request a new code.' }, 400);
+    }
+    return json({ registered: true });
+  } catch {
+    return json({ error: 'The service could not be reached. If you already submitted a code, request a new one before trying again.' }, 502);
+  }
+}
