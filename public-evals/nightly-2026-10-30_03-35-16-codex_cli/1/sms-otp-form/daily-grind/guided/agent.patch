+++ b/verification.js
@@ -0,0 +1,233 @@
+'use strict';
+
+// Set <meta name="auth-api-base" content="/api/auth"> when a real SMS service is available.
+const apiBase = document.querySelector('meta[name="auth-api-base"]')?.content.replace(/\/$/, '');
+const demo = !apiBase;
+const phoneForm = document.getElementById('phone-form');
+const codeForm = document.getElementById('code-form');
+const phone = document.getElementById('phone');
+const code = document.getElementById('code');
+const sendButton = document.getElementById('send-button');
+const verifyButton = document.getElementById('verify-button');
+const resendButton = document.getElementById('resend-button');
+const status = document.getElementById('status');
+const success = document.getElementById('success');
+const demoNote = document.getElementById('demo-note');
+let challengeId = null;
+let verifiedPhone = '';
+let otpController = null;
+let cooldownTimer = null;
+let busy = false;
+let demoExpires = 0;
+let demoAttempts = 0;
+
+if (!demo) demoNote.hidden = true;
+
+function stopListening() {
+  otpController?.abort();
+  otpController = null;
+}
+
+async function listenForSms() {
+  stopListening();
+  if (demo || !window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+  const controller = new AbortController();
+  otpController = controller;
+  const timeout = setTimeout(() => controller.abort(), 120000);
+  try {
+    const credential = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: controller.signal });
+    if (credential && !controller.signal.aborted && !codeForm.hidden) {
+      code.value = credential.code;
+      codeForm.requestSubmit();
+    }
+  } catch {
+    // Permission dismissal, unsupported policies, and timeouts leave manual entry available.
+  } finally {
+    clearTimeout(timeout);
+    if (otpController === controller) otpController = null;
+  }
+}
+
+async function apiRequest(path, body) {
+  const response = await fetch(`${apiBase}/${path}`, {
+    method: 'POST',
+    credentials: 'same-origin',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body),
+    signal: AbortSignal.timeout(15000)
+  });
+  if (!response.ok) {
+    if (response.status === 429) throw new Error('Too many attempts. Please wait a few minutes and try again.');
+    if (response.status === 400 || response.status === 401 || response.status === 410) {
+      throw new Error(path === 'verify-code' ? 'That code is incorrect or expired. Try again or request a new code.' : 'We couldn’t send a code to that number. Check it and try again.');
+    }
+    throw new Error('We couldn’t connect. Please try again in a moment.');
+  }
+  return response.json();
+}
+
+function setBusy(value) {
+  busy = value;
+  sendButton.disabled = value;
+  verifyButton.disabled = value;
+  document.getElementById('change-phone').disabled = value;
+  document.querySelectorAll('input[name="intent"]').forEach(input => { input.disabled = value; });
+  phoneForm.setAttribute('aria-busy', String(value));
+  codeForm.setAttribute('aria-busy', String(value));
+  if (value) resendButton.disabled = true;
+  else if (!cooldownTimer) resendButton.disabled = false;
+}
+
+function startCooldown() {
+  clearInterval(cooldownTimer);
+  let remaining = 30;
+  const countdown = document.getElementById('countdown');
+  resendButton.disabled = true;
+  countdown.textContent = `(${remaining}s)`;
+  cooldownTimer = setInterval(() => {
+    remaining -= 1;
+    countdown.textContent = remaining > 0 ? `(${remaining}s)` : '';
+    if (remaining <= 0) {
+      clearInterval(cooldownTimer);
+      cooldownTimer = null;
+      resendButton.disabled = busy;
+    }
+  }, 1000);
+}
+
+function showError(input, message) {
+  document.getElementById(`${input.id}-error`).textContent = message;
+  input.setAttribute('aria-invalid', 'true');
+  input.focus();
+}
+
+[phone, code].forEach(input => input.addEventListener('input', () => {
+  input.removeAttribute('aria-invalid');
+  input.setCustomValidity('');
+  document.getElementById(`${input.id}-error`).textContent = '';
+}));
+code.addEventListener('invalid', () => {
+  code.setCustomValidity('Enter the complete 6-digit code using numbers only.');
+});
+code.addEventListener('paste', event => {
+  const pasted = event.clipboardData?.getData('text').trim().replace(/[\s-]/g, '');
+  if (pasted && /^[0-9]{6}$/.test(pasted)) {
+    event.preventDefault();
+    code.value = pasted;
+    code.dispatchEvent(new Event('input', { bubbles: true }));
+  }
+});
+
+async function requestCode(resending = false) {
+  if (busy) return;
+  stopListening();
+  status.textContent = '';
+  document.getElementById(resending ? 'code-error' : 'phone-error').textContent = '';
+  setBusy(true);
+  try {
+    if (demo) {
+      challengeId = 'preview';
+      demoExpires = Date.now() + 300000;
+      demoAttempts = 0;
+    } else {
+      const result = await apiRequest('send-code', { phone: verifiedPhone, intent: currentIntent() });
+      if (typeof result.challengeId !== 'string' || !result.challengeId) throw new Error('We couldn’t start verification. Please try again.');
+      challengeId = result.challengeId;
+    }
+    phoneForm.hidden = true;
+    codeForm.hidden = false;
+    document.getElementById('form-title').textContent = 'Check your messages';
+    document.getElementById('form-subtitle').textContent = demo ? 'Try the code below to preview verification.' : 'Your next good coffee is just one code away.';
+    document.getElementById('sent-to').textContent = `${demo ? 'Preview for' : 'Code sent to'} ${verifiedPhone}`;
+    code.value = '';
+    code.setCustomValidity('');
+    code.removeAttribute('aria-invalid');
+    status.textContent = demo ? 'Demo code: 123456. No text was sent. This code expires in 5 minutes.' : (resending ? 'A new code is on its way. Use the most recent code.' : 'Code sent. Check your text messages.');
+    startCooldown();
+    code.focus();
+    if (!demo) void listenForSms();
+  } catch (error) {
+    stopListening();
+    showError(resending ? code : phone, error.name === 'TimeoutError' ? 'The request timed out. Please try again.' : error.message);
+  } finally {
+    setBusy(false);
+  }
+}
+
+phoneForm.addEventListener('submit', event => {
+  event.preventDefault();
+  const normalized = phone.value.trim().replace(/[\s().-]/g, '');
+  if (!/^\+[1-9][0-9]{7,14}$/.test(normalized)) {
+    showError(phone, 'Enter a valid mobile number with its country code, such as +1 202 555 0123.');
+    return;
+  }
+  verifiedPhone = normalized;
+  void requestCode();
+});
+
+codeForm.addEventListener('submit', async event => {
+  event.preventDefault();
+  stopListening();
+  if (busy) return;
+  setBusy(true);
+  status.textContent = '';
+  try {
+    if (demo) {
+      if (Date.now() > demoExpires) throw new Error('This demo code has expired. Request a new code.');
+      if (demoAttempts >= 5) throw new Error('Too many attempts. Request a new demo code.');
+      demoAttempts += 1;
+      if (code.value !== '123456') throw new Error('That code doesn’t match. For this demo, enter 123456.');
+    } else {
+      const result = await apiRequest('verify-code', { challengeId, code: code.value, intent: currentIntent() });
+      if (result.verified !== true) throw new Error('That code is incorrect or expired. Try again or request a new code.');
+    }
+    clearInterval(cooldownTimer);
+    cooldownTimer = null;
+    challengeId = null;
+    code.value = '';
+    codeForm.hidden = true;
+    success.hidden = false;
+    document.getElementById('form-title').textContent = demo ? 'A taste of an easier sign-in' : 'Welcome to your daily ritual';
+    document.getElementById('form-subtitle').textContent = 'A little less waiting. A little more coffee.';
+    document.getElementById('success-title').textContent = demo ? 'That’s how easy it is.' : 'Your number is verified.';
+    document.getElementById('success-copy').textContent = demo ? `Demo complete for ${currentIntent() === 'order' ? 'online ordering' : 'Grind Rewards'}. No account was signed in or order placed.` : 'You’re signed in. Taking you to your next coffee…';
+    success.focus();
+    if (!demo) window.location.assign(currentIntent() === 'order' ? '/order-online' : '/rewards');
+  } catch (error) {
+    showError(code, error.name === 'TimeoutError' ? 'The request timed out. Please try again.' : error.message);
+  } finally {
+    setBusy(false);
+  }
+});
+
+function resetFlow() {
+  stopListening();
+  clearInterval(cooldownTimer);
+  cooldownTimer = null;
+  challengeId = null;
+  verifiedPhone = '';
+  code.value = '';
+  code.setCustomValidity('');
+  code.removeAttribute('aria-invalid');
+  document.getElementById('code-error').textContent = '';
+  document.getElementById('countdown').textContent = '';
+  status.textContent = '';
+  codeForm.hidden = true;
+  success.hidden = true;
+  phoneForm.hidden = false;
+  document.getElementById('form-title').textContent = 'Let’s get you signed in';
+  document.getElementById('form-subtitle').textContent = 'Your number. Your coffee. No password needed.';
+  setBusy(false);
+  phone.focus();
+}
+function currentIntent() { return document.querySelector('input[name="intent"]:checked').value; }
+resendButton.addEventListener('click', () => void requestCode(true));
+document.getElementById('change-phone').addEventListener('click', resetFlow);
+document.getElementById('start-again').addEventListener('click', resetFlow);
+document.querySelectorAll('input[name="intent"]').forEach(input => input.addEventListener('change', resetFlow));
+document.querySelectorAll('[data-intent]').forEach(link => link.addEventListener('click', () => {
+  if (busy) return;
+  const choice = document.querySelector(`input[name="intent"][value="${link.dataset.intent}"]`);
+  if (!choice.checked) { choice.checked = true; resetFlow(); }
+}));
+window.addEventListener('pagehide', () => { stopListening(); clearInterval(cooldownTimer); });
