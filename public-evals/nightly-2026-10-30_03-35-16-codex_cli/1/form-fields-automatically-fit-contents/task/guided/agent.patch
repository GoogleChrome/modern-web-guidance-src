+  <script>
+    const preferencesForm = document.getElementById('coffee-preferences');
+    const preferencesStatus = document.getElementById('preferences-status');
+    const preferenceControls = ['coffee-name', 'coffee-choice', 'coffee-notes']
+      .map(id => document.getElementById(id));
+
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-preferences'));
+      if (saved && typeof saved === 'object') {
+        preferenceControls.forEach(control => {
+          if (typeof saved[control.name] === 'string') control.value = saved[control.name];
+        });
+      }
+    } catch {
+      // The form remains usable when device storage is unavailable.
+    }
+
+    preferencesForm.addEventListener('submit', event => {
+      event.preventDefault();
+      try {
+        localStorage.setItem('daily-grind-preferences', JSON.stringify(
+          Object.fromEntries(new FormData(preferencesForm))
+        ));
+        preferencesStatus.textContent = 'Your coffee preferences are saved on this device.';
+      } catch {
+        preferencesStatus.textContent = 'Preferences could not be saved. Device storage may be unavailable.';
+      }
+    });
+
+    preferencesForm.addEventListener('input', () => {
+      preferencesStatus.textContent = '';
+    });
+  </script>
+
 </body>
 
