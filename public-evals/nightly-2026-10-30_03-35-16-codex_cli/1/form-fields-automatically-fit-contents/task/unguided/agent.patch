+  <script>
+    // Supply content sizing for browsers that do not support field-sizing yet.
+    if (!CSS.supports('field-sizing', 'content')) {
+      const controls = document.querySelectorAll('.content-sized');
+      const measure = document.createElement('span');
+      measure.setAttribute('aria-hidden', 'true');
+      Object.assign(measure.style, {
+        position: 'absolute', visibility: 'hidden', whiteSpace: 'pre',
+        pointerEvents: 'none', top: '0', left: '0'
+      });
+      document.body.append(measure);
+
+      function sizeControl(control) {
+        const style = getComputedStyle(control);
+        measure.style.font = style.font;
+        measure.style.letterSpacing = style.letterSpacing;
+        const content = control.tagName === 'SELECT'
+          ? control.selectedOptions[0].text
+          : control.value || control.placeholder || ' ';
+        let textWidth = 0;
+        for (const line of content.split('\n')) {
+          measure.textContent = line || ' ';
+          textWidth = Math.max(textWidth, measure.getBoundingClientRect().width);
+        }
+        const edges = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight)
+          + parseFloat(style.borderLeftWidth) + parseFloat(style.borderRightWidth);
+        const extra = control.tagName === 'SELECT' ? 28 : 2;
+        control.style.width = `${Math.ceil(textWidth + edges + extra)}px`;
+        if (control.tagName === 'TEXTAREA') {
+          control.style.height = 'auto';
+          control.style.height = `${control.scrollHeight
+            + parseFloat(style.borderTopWidth) + parseFloat(style.borderBottomWidth)}px`;
+        }
+      }
+
+      controls.forEach(control => {
+        sizeControl(control);
+        control.addEventListener('input', () => sizeControl(control));
+        control.addEventListener('change', () => sizeControl(control));
+      });
+      window.addEventListener('resize', () => controls.forEach(sizeControl));
+      document.fonts.ready.then(() => controls.forEach(sizeControl));
+    }
+  </script>
