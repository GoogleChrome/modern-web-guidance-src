diff --git a/card-navigation.js b/card-navigation.js
new file mode 100644
index 0000000..000c247
--- /dev/null
+++ b/card-navigation.js
@@ -0,0 +1,65 @@
+const directions = {
+  ArrowLeft: { horizontal: true, sign: -1 },
+  ArrowRight: { horizontal: true, sign: 1 },
+  ArrowUp: { horizontal: false, sign: -1 },
+  ArrowDown: { horizontal: false, sign: 1 },
+};
+
+// Measure the rendered layout, rather than assuming a column count or DOM order.
+export function findNeighbor(rects, currentIndex, key) {
+  const direction = directions[key];
+  const current = rects[currentIndex];
+  if (!direction || !current) return -1;
+
+  const { horizontal, sign } = direction;
+  const start = horizontal ? 'left' : 'top';
+  const end = horizontal ? 'right' : 'bottom';
+  const crossStart = horizontal ? 'top' : 'left';
+  const crossEnd = horizontal ? 'bottom' : 'right';
+  const center = (rect, a, b) => (rect[a] + rect[b]) / 2;
+  let best = -1;
+  let bestScore = Infinity;
+
+  rects.forEach((rect, index) => {
+    if (index === currentIndex || rect.right <= rect.left || rect.bottom <= rect.top) return;
+    const gap = sign > 0 ? rect[start] - current[end] : current[start] - rect[end];
+    if (gap < -1) return;
+
+    const overlap = Math.min(current[crossEnd], rect[crossEnd])
+      - Math.max(current[crossStart], rect[crossStart]);
+    // Left/right stay in the same visual row; they never wrap to another row.
+    if (horizontal && overlap <= 0) return;
+
+    const distance = sign * (center(rect, start, end) - center(current, start, end));
+    if (distance <= 0) return;
+    const crossDistance = Math.abs(center(rect, crossStart, crossEnd)
+      - center(current, crossStart, crossEnd));
+    // Prefer the nearest direction, including a diagonal card in an incomplete row.
+    const score = distance * distance + crossDistance * crossDistance;
+    if (score < bestScore) {
+      best = index;
+      bestScore = score;
+    }
+  });
+  return best;
+}
+
+export function setupCardNavigation(grid) {
+  grid.addEventListener('keydown', (event) => {
+    if (!directions[event.key] || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
+    const links = [...grid.querySelectorAll('.card a[href]')].filter((link) =>
+      link.getClientRects().length && link.closest('.card').getClientRects().length);
+    const currentIndex = links.indexOf(event.target);
+    if (currentIndex === -1) return;
+
+    const rects = links.map((link) => link.closest('.card').getBoundingClientRect());
+    const nextIndex = findNeighbor(rects, currentIndex, event.key);
+    // Consume arrows at the boundary too, keeping focus and the viewport stable.
+    event.preventDefault();
+    if (nextIndex !== -1) links[nextIndex].focus();
+  });
+}
+
+if (typeof document !== 'undefined') {
+  document.querySelectorAll('[data-card-navigation]').forEach(setupCardNavigation);
+}
diff --git a/card-navigation.test.js b/card-navigation.test.js
new file mode 100644
index 0000000..65d66a5
--- /dev/null
+++ b/card-navigation.test.js
@@ -0,0 +1,87 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { findNeighbor, setupCardNavigation } from './card-navigation.js';
+
+const rect = (left, top, width = 250, height = 200) => ({
+  left, top, right: left + width, bottom: top + height,
+});
+
+test('three columns navigate horizontally without wrapping at edges', () => {
+  const cards = [rect(0, 0), rect(270, 0), rect(540, 0)];
+  assert.equal(findNeighbor(cards, 0, 'ArrowRight'), 1);
+  assert.equal(findNeighbor(cards, 2, 'ArrowLeft'), 1);
+  assert.equal(findNeighbor(cards, 2, 'ArrowRight'), -1);
+  assert.equal(findNeighbor(cards, 0, 'ArrowLeft'), -1);
+  assert.equal(findNeighbor(cards, 1, 'ArrowDown'), -1);
+});
+
+test('two columns support vertical navigation and an incomplete final row', () => {
+  const cards = [rect(0, 0), rect(270, 0), rect(0, 220)];
+  assert.equal(findNeighbor(cards, 0, 'ArrowDown'), 2);
+  assert.equal(findNeighbor(cards, 1, 'ArrowDown'), 2);
+  assert.equal(findNeighbor(cards, 2, 'ArrowUp'), 0);
+  assert.equal(findNeighbor(cards, 1, 'ArrowRight'), -1);
+  assert.equal(findNeighbor(cards, 2, 'ArrowRight'), -1);
+});
+
+test('single column supports up/down and keeps left/right at the boundary', () => {
+  const cards = [rect(0, 0), rect(0, 220), rect(0, 440)];
+  assert.equal(findNeighbor(cards, 0, 'ArrowDown'), 1);
+  assert.equal(findNeighbor(cards, 2, 'ArrowUp'), 1);
+  assert.equal(findNeighbor(cards, 1, 'ArrowRight'), -1);
+  assert.equal(findNeighbor(cards, 1, 'ArrowLeft'), -1);
+  assert.equal(findNeighbor(cards, 2, 'ArrowDown'), -1);
+});
+
+test('physical direction follows visual order, including RTL and CSS reordering', () => {
+  const cards = [rect(540, 0), rect(0, 0), rect(270, 0)];
+  assert.equal(findNeighbor(cards, 0, 'ArrowLeft'), 2);
+  assert.equal(findNeighbor(cards, 1, 'ArrowRight'), 2);
+  assert.equal(findNeighbor(cards, 2, 'ArrowRight'), 0);
+});
+
+test('unequal card sizes and hidden rectangles do not disrupt neighbors', () => {
+  const cards = [rect(0, 0, 250, 240), rect(270, 0), rect(0, 260), rect(0, 0, 0, 0)];
+  assert.equal(findNeighbor(cards, 0, 'ArrowRight'), 1);
+  assert.equal(findNeighbor(cards, 0, 'ArrowDown'), 2);
+  assert.equal(findNeighbor(cards, 0, 'Home'), -1);
+});
+
+test('keyboard handler measures each keypress, focuses links, and preserves native keys', () => {
+  let positions = [rect(0, 0), rect(270, 0), rect(540, 0)];
+  let focused = -1;
+  let handler;
+  const links = positions.map((_, index) => ({
+    getClientRects: () => [positions[index]],
+    closest: () => ({
+      getClientRects: () => [positions[index]],
+      getBoundingClientRect: () => positions[index],
+    }),
+    focus: () => { focused = index; },
+  }));
+  setupCardNavigation({
+    addEventListener: (name, listener) => { assert.equal(name, 'keydown'); handler = listener; },
+    querySelectorAll: () => links,
+  });
+  const press = (key, target = links[0], modifiers = {}) => {
+    let prevented = false;
+    handler({ key, target, ...modifiers, preventDefault: () => { prevented = true; } });
+    return prevented;
+  };
+  assert.equal(press('ArrowRight'), true);
+  assert.equal(focused, 1);
+  positions = [rect(0, 0), rect(0, 220), rect(0, 440)];
+  focused = -1;
+  assert.equal(press('ArrowRight'), true);
+  assert.equal(focused, -1);
+  assert.equal(press('ArrowDown'), true);
+  assert.equal(focused, 1);
+  for (const key of ['Tab', 'Enter', ' ']) assert.equal(press(key), false);
+  for (const modifier of ['altKey', 'ctrlKey', 'metaKey', 'shiftKey']) {
+    assert.equal(press('ArrowDown', links[0], { [modifier]: true }), false);
+  }
+  assert.equal(press('ArrowDown', {}), false);
+  links[1].getClientRects = () => [];
+  assert.equal(press('ArrowDown'), true);
+  assert.equal(focused, 2);
+});
