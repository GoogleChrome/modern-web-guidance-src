+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const sections = [...panel.querySelectorAll('.drink-section')];
+    const tocLinks = [...document.querySelectorAll('.toc-sidebar a')];
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function updateCurrentDrink() {
+      const panelTop = panel.getBoundingClientRect().top;
+      const snapPadding = parseFloat(getComputedStyle(panel).scrollPaddingTop) || 0;
+      let currentIndex = 0;
+      let closestDistance = Infinity;
+
+      sections.forEach((section, index) => {
+        const headerTop = section.querySelector('header').getBoundingClientRect().top;
+        const distance = Math.abs(headerTop - panelTop - snapPadding);
+        if (distance < closestDistance) {
+          closestDistance = distance;
+          currentIndex = index;
+        }
+      });
+
+      tocLinks.forEach((link, index) => {
+        if (index === currentIndex) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    tocLinks.forEach((link, index) => {
+      link.addEventListener('click', (event) => {
+        // Preserve browser behavior for modified link clicks.
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const header = sections[index].querySelector('header');
+        const snapPadding = parseFloat(getComputedStyle(panel).scrollPaddingTop) || 0;
+        panel.scrollTo({
+          top: panel.scrollTop + header.getBoundingClientRect().top
+            - panel.getBoundingClientRect().top - snapPadding,
+          behavior: reducedMotion.matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    let scrollFrame = null;
+    panel.addEventListener('scroll', () => {
+      if (scrollFrame !== null) return;
+      scrollFrame = requestAnimationFrame(() => {
+        updateCurrentDrink();
+        scrollFrame = null;
+      });
+    }, { passive: true });
+    panel.addEventListener('scrollend', updateCurrentDrink);
+    window.addEventListener('resize', updateCurrentDrink);
+    window.addEventListener('hashchange', updateCurrentDrink);
+    updateCurrentDrink();
+  </script>
