+  <script>
+    (() => {
+      const button = document.getElementById('summarize-journal');
+      const status = document.getElementById('journal-status');
+      const summary = document.getElementById('journal-summary');
+      const points = document.getElementById('journal-summary-points');
+      const options = {
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en'
+      };
+
+      async function checkAvailability() {
+        if (!window.isSecureContext || !('Summarizer' in window)) {
+          status.textContent = 'On-device summaries are not supported in this browser. Try a browser with built-in AI summarization on a secure connection.';
+          return;
+        }
+
+        try {
+          const availability = await window.Summarizer.availability(options);
+          if (availability === 'unavailable') {
+            status.textContent = 'On-device AI summarization is unavailable on this device. You can still read the full journal above.';
+            return;
+          }
+          button.disabled = false;
+          status.textContent = availability === 'available'
+            ? 'Get a few key points with your browser’s on-device AI.'
+            : 'Get a few key points with on-device AI. First use may download the browser’s AI model.';
+        } catch {
+          status.textContent = 'Your browser could not check AI availability. Reload the page to try again.';
+        }
+      }
+
+      button.addEventListener('click', async () => {
+        let summarizer;
+        button.disabled = true;
+        button.textContent = 'Summarizing…';
+        summary.setAttribute('aria-busy', 'true');
+        status.textContent = 'Preparing your on-device summary…';
+
+        try {
+          // Create directly from the click so model downloads have user activation.
+          summarizer = await window.Summarizer.create({
+            ...options,
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                status.textContent = `Downloading the browser’s AI model… ${Math.round(event.loaded * 100)}%`;
+              });
+            }
+          });
+          status.textContent = 'Summarizing the journal on your device…';
+          const text = Array.from(document.querySelectorAll('#journal-copy p'))
+            .map((paragraph) => paragraph.textContent.trim()).join('\n\n');
+          const result = await summarizer.summarize(text);
+          const bullets = result.split(/\r?\n/)
+            .map((line) => line.replace(/^\s*(?:[-*•]\s+|\d+[.)]\s+)/, '').trim())
+            .filter(Boolean);
+
+          if (!bullets.length) throw new Error('Empty summary');
+
+          const items = bullets.map((bullet) => {
+            const item = document.createElement('li');
+            item.textContent = bullet;
+            return item;
+          });
+          points.replaceChildren(...items);
+          summary.hidden = false;
+          status.textContent = 'Summary ready. Generated by on-device AI; refer to the full journal for details.';
+        } catch {
+          status.textContent = 'The summary could not be created. Please try again. Your browser’s AI model may still need to finish downloading.';
+        } finally {
+          if (summarizer) summarizer.destroy();
+          summary.setAttribute('aria-busy', 'false');
+          button.disabled = false;
+          button.textContent = 'Summarize';
+        }
+      });
+
+      checkAvailability();
+    })();
+  </script>
+
