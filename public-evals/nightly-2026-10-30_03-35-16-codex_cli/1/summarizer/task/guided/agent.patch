+        <p id="journal-status" class="journal-status" role="status">Checking on-device summarization support…</p>
+        <progress id="journal-progress" aria-label="On-device AI model download" max="1" hidden></progress>
+        <noscript><p>Enable JavaScript to use on-device summarization. You can read the full journal above.</p></noscript>
+      </div>
+      <div id="journal-summary" class="journal-summary" hidden>
+        <h3>The sourcing story, at a glance</h3>
+        <ul id="journal-summary-points"></ul>
