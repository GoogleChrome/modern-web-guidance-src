+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalStatus = document.getElementById('journal-status');
+    const journalProgress = document.getElementById('journal-progress');
+    const journalSummary = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-summary-points');
+    const summaryOptions = {
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      expectedInputLanguages: ['en'],
+      outputLanguage: 'en',
+      monitor(monitor) {
+        journalStatus.textContent = 'Downloading the on-device AI model. The first use may take a few minutes.';
+        journalProgress.hidden = false;
+        monitor.addEventListener('downloadprogress', (event) => {
+          // Download progress is normalized to a value between zero and one.
+          journalProgress.value = event.loaded;
+        });
+      }
+    };
+
+    async function checkSummarizationSupport() {
+      if (!window.isSecureContext || !('Summarizer' in window)) {
+        journalStatus.textContent = 'On-device AI summaries are not supported in this browser. Try a compatible desktop browser over HTTPS; the full journal is available above.';
+        return;
+      }
+
+      try {
+        const availability = await window.Summarizer.availability(summaryOptions);
+        if (availability === 'unavailable') {
+          journalStatus.textContent = 'On-device AI summarization is unavailable on this device. You can still read the full journal above.';
+          return;
+        }
+        summarizeButton.disabled = false;
+        journalStatus.textContent = availability === 'available'
+          ? 'Get a few key points with your browser’s on-device AI. The journal text stays on your device.'
+          : 'The first summary requires a browser AI model download, which may take a few minutes. The journal text stays on your device.';
+      } catch {
+        journalStatus.textContent = 'Your browser could not check on-device AI availability. Reload the page to try again.';
+      }
+    }
+
+    summarizeButton.addEventListener('click', async () => {
+      let summarizer;
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      journalStatus.textContent = 'Preparing your on-device summary…';
+      journalSummary.setAttribute('aria-busy', 'true');
+
+      try {
+        // Create directly within the click handler to preserve user activation.
+        summarizer = await window.Summarizer.create(summaryOptions);
+        journalProgress.hidden = true;
+        journalStatus.textContent = 'Reading the journal with on-device AI…';
+        const text = document.getElementById('journal-story').innerText;
+        const summary = await summarizer.summarize(text);
+        const points = summary.split(/\r?\n/)
+          .map((line) => line.replace(/^\s*(?:[-*•‣–—]|\d+[.)])\s+/, '').trim())
+          .filter(Boolean);
+        if (!points.length) throw new Error('Empty summary');
+
+        // Treat model output as text, never as HTML.
+        summaryPoints.replaceChildren(...points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        }));
+        journalSummary.hidden = false;
+        journalStatus.textContent = 'Your AI-generated key points are ready below. Check the full journal for details.';
+      } catch (error) {
+        journalStatus.textContent = error.name === 'NotAllowedError'
+          ? 'Your browser could not start on-device AI. Allow the model download if prompted, then select Summarize to retry.'
+          : 'The on-device summary could not be completed. Check your connection if the model needs downloading, then select Summarize to retry.';
+      } finally {
+        if (summarizer) summarizer.destroy();
+        journalProgress.hidden = true;
+        journalSummary.setAttribute('aria-busy', 'false');
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+      }
+    });
+
+    checkSummarizationSupport();
+  </script>
 </body>
 
