+      <div class="cart-total"><span>Subtotal <span id="cart-count">(1 item)</span></span><strong id="cart-total" aria-live="polite">$5.50</strong></div>
+      <p class="cart-note">Taxes calculated at checkout.</p>
+      <button class="cart-review" type="button"><span>Review order</span><span aria-hidden="true">↗</span></button>
+      <div class="cart-summary" hidden role="status"><p id="cart-summary-text"></p><a id="cart-checkout" href="/order-online">Continue to ordering →</a></div>
+      <p class="cart-footer">Good coffee. A better kind of daily ritual.</p>
+    </div>
+  </aside>
+  <noscript>
+    <aside class="coffee-cart" aria-label="Quick coffee order">
+      <div class="cart-body">
+        <h2 class="cart-title">Your coffee, your way.</h2>
+        <p>Maple Oat Latte · $5.50<br>Dark Roast Espresso · $3.50<br>Cold Brew · $4.50</p>
+        <a class="btn" href="/order-online">Order online</a>
+      </div>
+    </aside>
+  </noscript>
+  <script>
+    (() => {
+      const cart = document.querySelector('.coffee-cart');
+      const handle = cart.querySelector('.cart-handle');
+      const body = document.querySelector('#cart-body');
+      const collapse = cart.querySelector('.cart-collapse');
+      const review = cart.querySelector('.cart-review');
+      const summary = cart.querySelector('.cart-summary');
+      const coffees = [
+        { name: 'Maple Oat Latte', price: 550, quantity: 1 },
+        { name: 'Dark Roast Espresso', price: 350, quantity: 0 },
+        { name: 'Cold Brew', price: 450, quantity: 0 }
+      ];
+      const money = cents => (cents / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
+      const cup = '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 12h16v8a7 7 0 0 1-7 7h-2a7 7 0 0 1-7-7zM23 13h2a4 4 0 0 1 0 8h-2M5 28h21M11 8c-3-3 3-3 0-6M17 8c-3-3 3-3 0-6"/></svg>';
+      const rows = coffees.map((coffee, index) => {
+        const row = document.createElement('div');
+        row.className = 'cart-item';
+        row.innerHTML = `<span class="cart-coffee-icon">${cup}</span><div class="cart-item-info"><h3>${coffee.name}</h3><span class="cart-item-price">${money(coffee.price)}</span></div><div class="cart-stepper"><button type="button" aria-label="Remove one ${coffee.name}">−</button><output aria-label="${coffee.name} quantity">${coffee.quantity}</output><button type="button" aria-label="Add one ${coffee.name}">+</button></div>`;
+        const buttons = row.querySelectorAll('button');
+        buttons.forEach((button, direction) => button.addEventListener('click', () => {
+          coffees[index].quantity = Math.max(0, Math.min(20, coffees[index].quantity + (direction ? 1 : -1)));
+          summary.hidden = true;
+          update();
+        }));
+        document.querySelector('#cart-items').append(row);
+        return row;
+      });
+      function update() {
+        let count = 0, total = 0;
+        coffees.forEach((coffee, index) => {
+          count += coffee.quantity;
+          total += coffee.price * coffee.quantity;
+          rows[index].querySelector('output').value = coffee.quantity;
+          const buttons = rows[index].querySelectorAll('button');
+          buttons[0].disabled = coffee.quantity === 0;
+          buttons[1].disabled = coffee.quantity === 20;
+        });
+        document.querySelector('#cart-count').textContent = `(${count} ${count === 1 ? 'item' : 'items'})`;
+        document.querySelector('#cart-total').textContent = money(total);
+        review.disabled = count === 0;
+      }
+      review.addEventListener('click', () => {
+        const selection = coffees.filter(coffee => coffee.quantity);
+        document.querySelector('#cart-summary-text').textContent = selection.map(coffee => `${coffee.quantity} × ${coffee.name}`).join(', ') + '. Complete your pickup order on our ordering page.';
+        const params = new URLSearchParams();
+        selection.forEach(coffee => params.append(coffee.name, coffee.quantity));
+        document.querySelector('#cart-checkout').href = `/order-online?${params}`;
+        summary.hidden = false;
+      });
+      collapse.addEventListener('click', () => {
+        body.hidden = !body.hidden;
+        collapse.setAttribute('aria-expanded', String(!body.hidden));
+        collapse.setAttribute('aria-label', body.hidden ? 'Expand coffee cart' : 'Minimize coffee cart');
+        collapse.textContent = body.hidden ? '+' : '−';
+      });
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - cart.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - cart.offsetHeight);
+        cart.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        cart.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+        cart.style.right = 'auto';
+        cart.style.bottom = 'auto';
+      }
+      let offsetX = 0, offsetY = 0;
+      handle.addEventListener('pointerdown', event => {
+        if (event.button !== 0 || !event.isPrimary) return;
+        const rect = cart.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        handle.setPointerCapture(event.pointerId);
+        handle.classList.add('dragging');
+      });
+      handle.addEventListener('pointermove', event => {
+        if (handle.hasPointerCapture(event.pointerId)) moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+      function stopDrag(event) {
+        if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
+        handle.classList.remove('dragging');
+      }
+      handle.addEventListener('pointerup', stopDrag);
+      handle.addEventListener('pointercancel', stopDrag);
+      handle.addEventListener('lostpointercapture', () => handle.classList.remove('dragging'));
+      handle.addEventListener('keydown', event => {
+        const directions = { ArrowLeft: [-15, 0], ArrowRight: [15, 0], ArrowUp: [0, -15], ArrowDown: [0, 15] };
+        if (!directions[event.key]) return;
+        event.preventDefault();
+        const rect = cart.getBoundingClientRect();
+        const [x, y] = directions[event.key];
+        moveTo(rect.left + x, rect.top + y);
+      });
+      const keepReachable = () => {
+        const rect = cart.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      };
+      window.addEventListener('resize', keepReachable);
+      new ResizeObserver(keepReachable).observe(cart);
+      handle.classList.add('ready');
+      cart.hidden = false;
+      update();
+    })();
+  </script>
