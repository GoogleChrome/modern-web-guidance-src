+  <script>
+    const contactForm = document.getElementById('contact-form');
+    const syncInvalidState = (event) => {
+      const field = event.target;
+      if (!field.matches('input, textarea')) return;
+      // Defer until the browser has updated its native interaction state.
+      requestAnimationFrame(() => {
+        field.setAttribute('aria-invalid', String(field.matches(':user-invalid')));
+      });
+    };
+    ['focusout', 'input', 'invalid'].forEach((type) => {
+      contactForm.addEventListener(type, syncInvalidState, true);
+    });
+    contactForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      document.getElementById('contact-status').textContent =
+        'Your message has not been sent: message delivery is not connected yet.';
+    });
+  </script>
+
