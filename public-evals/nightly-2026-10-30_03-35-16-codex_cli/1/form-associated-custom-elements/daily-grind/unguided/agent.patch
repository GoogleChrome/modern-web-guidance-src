diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..02619c5
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,128 @@
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required', 'disabled'];
+
+  #internals = this.attachInternals();
+  #value = '';
+  #dirty = false;
+  #disabled = false;
+  #showError = false;
+  #radios;
+  #error;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.innerHTML = `
+      <style>
+        :host { display: block; }
+        .stars { display: flex; gap: 8px; width: max-content; max-width: 100%; }
+        label { position: relative; display: grid; place-items: center; cursor: pointer; }
+        input { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: inherit; }
+        .star { font-size: 38px; line-height: 1.3; color: #b7a69c; transition: color .15s; }
+        .filled .star { color: #a56318; }
+        input:focus-visible + .star { outline: 3px solid #bc7622; outline-offset: 2px; border-radius: 4px; }
+        label:hover .star { color: #a56318; }
+        .disabled { opacity: .45; }
+        .disabled label { cursor: not-allowed; }
+        .error { color: #a52822; font: .85rem/1.5 'Segoe UI', sans-serif; margin: 6px 0 0; }
+        [hidden] { display: none; }
+      </style>
+      <div class="stars" role="radiogroup" aria-label="Coffee rating" aria-describedby="error">
+        ${[1, 2, 3, 4, 5].map(value => `
+          <label><input type="radio" name="stars" value="${value}" aria-label="${value} ${value === 1 ? 'star' : 'stars'}"><span class="star" aria-hidden="true">☆</span></label>
+        `).join('')}
+      </div>
+      <p class="error" id="error" hidden>Please choose a star rating.</p>`;
+    this.#radios = [...root.querySelectorAll('input')];
+    this.#error = root.querySelector('.error');
+    root.addEventListener('input', event => {
+      event.stopPropagation();
+      this.value = event.target.value;
+      this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+    });
+    root.addEventListener('change', event => {
+      event.stopPropagation();
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+    this.addEventListener('invalid', () => {
+      this.#showError = true;
+      this.#render();
+    });
+  }
+
+  connectedCallback() { this.#render(); }
+
+  attributeChangedCallback(name) {
+    if (name === 'value' && !this.#dirty) this.#value = this.#normalize(this.getAttribute('value'));
+    this.#render();
+  }
+
+  get value() { return this.#value; }
+  set value(value) {
+    this.#dirty = true;
+    this.#value = this.#normalize(value);
+    this.#render();
+  }
+  get name() { return this.getAttribute('name') || ''; }
+  set name(value) { this.setAttribute('name', value); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  formDisabledCallback(disabled) {
+    this.#disabled = disabled;
+    this.#render();
+  }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#value = this.#normalize(this.getAttribute('value'));
+    this.#showError = false;
+    this.#render();
+  }
+
+  formStateRestoreCallback(state) {
+    this.#dirty = true;
+    this.#value = this.#normalize(state);
+    this.#showError = false;
+    this.#render();
+  }
+
+  #normalize(value) { return /^[1-5]$/.test(String(value)) ? String(value) : ''; }
+
+  #render() {
+    if (!this.#radios) return;
+    const disabled = this.#disabled || this.disabled;
+    const missing = this.required && !this.#value;
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    this.#internals.setValidity(
+      missing ? { valueMissing: true } : {},
+      missing ? 'Please choose a star rating.' : '',
+      this.#radios[0]
+    );
+    this.#radios.forEach(radio => {
+      radio.checked = radio.value === this.#value;
+      radio.disabled = disabled;
+      const filled = Number(radio.value) <= Number(this.#value);
+      radio.parentElement.classList.toggle('filled', filled);
+      radio.nextElementSibling.textContent = filled ? '★' : '☆';
+    });
+    const group = this.shadowRoot.querySelector('.stars');
+    group.classList.toggle('disabled', disabled);
+    group.setAttribute('aria-required', String(this.required));
+    group.setAttribute('aria-disabled', String(disabled));
+    group.setAttribute('aria-invalid', String(missing && this.#showError && !disabled));
+    this.#error.hidden = !missing || !this.#showError || disabled;
+  }
+}
+
+customElements.define('star-rating', StarRating);
