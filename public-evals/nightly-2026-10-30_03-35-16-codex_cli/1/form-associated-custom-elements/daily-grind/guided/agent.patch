diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..efcbc12
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,132 @@
+const descriptions = ['Not my cup', 'Could be better', 'Pretty good', 'Loved it', 'Made my day'];
+
+// Leave the native select in place when form-associated elements are unavailable.
+if ('attachInternals' in HTMLElement.prototype &&
+    'ElementInternals' in window && 'setFormValue' in ElementInternals.prototype) {
+  class StarRating extends HTMLElement {
+    static formAssociated = true;
+    static observedAttributes = ['value', 'required'];
+
+    #internals;
+    #value = '';
+    #disabled = false;
+    #initialized = false;
+    #radios;
+    #output;
+
+    constructor() {
+      super();
+      this.#internals = this.attachInternals();
+      const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+      root.innerHTML = `
+        <style>
+          :host { display: block; }
+          .stars { display: flex; gap: 8px; width: fit-content; }
+          label { position: relative; display: grid; place-items: center; cursor: pointer; }
+          input { position: absolute; width: 1px; height: 1px; opacity: 0; }
+          .star {
+            display: grid; place-items: center; width: 48px; height: 48px;
+            box-sizing: border-box; border: 1px solid #d9ccc1; border-radius: 8px;
+            background: #fffdfa; color: #8c7a6c; transition: background .15s;
+          }
+          svg { width: 27px; height: 27px; fill: transparent; stroke: currentColor; stroke-width: 1.5; }
+          label[data-filled] .star { background: #fff4de; border-color: #d9a149; color: #986020; }
+          label[data-filled] svg { fill: #efb64e; }
+          input:focus-visible + .star { outline: 3px solid #b46726; outline-offset: 3px; }
+          label:hover .star { border-color: #986020; }
+          input:disabled + .star { opacity: .45; }
+          label:has(input:disabled) { cursor: not-allowed; }
+          p { margin: 8px 0 0; min-height: 1.6em; color: #78685f; font: .8rem/1.6 'Segoe UI', sans-serif; }
+          @media (max-width: 380px) { .stars { gap: 5px; } .star { width: 40px; height: 44px; } }
+          @media (prefers-reduced-motion: reduce) { .star { transition: none; } }
+          @media (forced-colors: active) {
+            label[data-filled] .star { outline: 2px solid Highlight; }
+            label[data-filled] svg { fill: Highlight; }
+          }
+        </style>
+        <div class="stars" role="radiogroup" aria-label="Coffee rating" aria-describedby="rating-description">
+          ${descriptions.map((description, index) => `
+            <label>
+              <input type="radio" name="stars" value="${index + 1}"
+                aria-label="${index + 1} ${index === 0 ? 'star' : 'stars'} — ${description}">
+              <span class="star" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 2.8 5.7 6.3.9-4.55 4.45 1.07 6.28L12 17.36l-5.62 2.97 1.07-6.28L2.9 9.6l6.3-.9Z"/></svg></span>
+            </label>`).join('')}
+        </div>
+        <p id="rating-description">Select your rating</p>`;
+      this.#radios = [...root.querySelectorAll('input')];
+      this.#output = root.querySelector('p');
+      // Native radios provide Space, arrow-key navigation and a single tab stop.
+      root.addEventListener('input', (event) => event.stopPropagation());
+      root.addEventListener('change', (event) => {
+        event.stopPropagation();
+        if (this.#disabled || !(event.target instanceof HTMLInputElement)) return;
+        this.value = event.target.value;
+        this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+        this.dispatchEvent(new Event('change', { bubbles: true }));
+      });
+    }
+
+    connectedCallback() {
+      if (this.#initialized) return;
+      this.#initialized = true;
+      // Upgrade properties assigned before customElements.define().
+      const pendingValue = Object.hasOwn(this, 'value') ? this.value : this.getAttribute('value');
+      if (Object.hasOwn(this, 'value')) delete this.value;
+      this.replaceChildren();
+      this.value = pendingValue;
+    }
+
+    attributeChangedCallback(name, oldValue, newValue) {
+      if (oldValue === newValue) return;
+      if (name === 'value') this.value = newValue;
+      else this.#sync();
+    }
+
+    get value() { return this.#value; }
+    set value(value) {
+      const normalized = String(value ?? '');
+      this.#value = /^[1-5]$/.test(normalized) ? normalized : '';
+      this.#sync();
+    }
+    get name() { return this.getAttribute('name') ?? ''; }
+    set name(value) { this.setAttribute('name', value); }
+    get required() { return this.hasAttribute('required'); }
+    set required(value) { this.toggleAttribute('required', Boolean(value)); }
+    get disabled() { return this.hasAttribute('disabled'); }
+    set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+    get form() { return this.#internals.form; }
+    get labels() { return this.#internals.labels; }
+    get validity() { return this.#internals.validity; }
+    get validationMessage() { return this.#internals.validationMessage; }
+    get willValidate() { return this.#internals.willValidate; }
+    checkValidity() { return this.#internals.checkValidity(); }
+    reportValidity() { return this.#internals.reportValidity(); }
+
+    #sync() {
+      this.#internals.setFormValue(this.#value || null, this.#value);
+      this.#radios.forEach((radio) => {
+        radio.checked = radio.value === this.#value;
+        radio.parentElement.toggleAttribute('data-filled', Number(radio.value) <= Number(this.#value));
+      });
+      this.shadowRoot.querySelector('[role="radiogroup"]').setAttribute('aria-required', String(this.required));
+      this.#output.textContent = this.#value
+        ? `${this.#value} of 5 — ${descriptions[Number(this.#value) - 1]}` : 'Select your rating';
+      if (this.required && !this.#value) {
+        this.#internals.setValidity({ valueMissing: true }, 'Please choose a coffee rating.', this.#radios[0]);
+      } else {
+        this.#internals.setValidity({});
+      }
+    }
+
+    formResetCallback() { this.value = this.getAttribute('value'); }
+    formDisabledCallback(disabled) {
+      // Includes ancestor fieldsets. Never reflect this state onto the host attribute.
+      this.#disabled = disabled;
+      this.#radios.forEach((radio) => { radio.disabled = disabled; });
+      this.shadowRoot.querySelector('[role="radiogroup"]').setAttribute('aria-disabled', String(disabled));
+    }
+    formStateRestoreCallback(state, _mode) { this.value = typeof state === 'string' ? state : ''; }
+  }
+
+  if (!customElements.get('star-rating')) customElements.define('star-rating', StarRating);
+}
