diff --git a/feedback.js b/feedback.js
new file mode 100644
index 0000000..1175a40
--- /dev/null
+++ b/feedback.js
@@ -0,0 +1,15 @@
+const form = document.querySelector('#coffee-feedback');
+const result = document.querySelector('#feedback-result');
+
+// The submit event only fires after native constraint validation succeeds.
+form.addEventListener('submit', (event) => {
+  event.preventDefault();
+  const data = new FormData(form);
+  const coffee = data.get('coffee');
+  const rating = data.get('rating');
+  const comments = String(data.get('comments') ?? '').trim();
+  result.textContent = `Your feedback: ${coffee}, ${rating} of 5 stars.${comments ? ` “${comments}”` : ''} Thanks for sharing! This summary stays on this page and has not been sent.`;
+});
+
+form.addEventListener('reset', () => { result.textContent = ''; });
+form.addEventListener('input', () => { result.textContent = ''; });
