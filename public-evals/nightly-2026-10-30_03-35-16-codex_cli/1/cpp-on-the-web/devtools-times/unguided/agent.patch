+const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
+const canvas = $<HTMLCanvasElement>('render-canvas');
+const ctx = canvas.getContext('2d')!;
+const base = document.body.dataset.base || '/';
+let worker: Worker | undefined;
+let samples = 64;
+let seed = 42;
+let palette = 1;
+let paused = false;
+let complete = false;
+let hasFrame = false;
+let colors = [
+  { id: 0, rgb: [.75, .28, .20] },
+  { id: 1, rgb: [.30, .55, .38] },
+  { id: 6, rgb: [.999, .999, .999] },
+  { id: 7, rgb: [.999, .999, .999] },
+];
+function start() {
+  worker?.terminate();
+  worker = new Worker(`${base}wasm/render-worker.js`, { type: 'module' });
+  paused = false; complete = false; hasFrame = false;
+  $('pause').removeAttribute('disabled');
+  $('pause-label').textContent = 'Pause render';
+  $('pause-symbol').textContent = 'Ⅱ';
+  $('render-state').textContent = 'Rendering';
+  $('samples-current').textContent = '0';
+  $('samples-total').textContent = String(samples);
+  $('progress').style.width = '0%';
+  $('elapsed').textContent = '0.0s';
+  $('render-dot').style.background = '#5f9672';
+  const width = Number($<HTMLSelectElement>('resolution').value);
+  const height = width * .75;
+  $('dimensions').textContent = `${width} × ${height}`;
+  worker.onmessage = ({ data }) => {
+    if (data.type === 'error') { fail(data.message); return; }
+    if (canvas.width !== data.width || canvas.height !== data.height) {
+      canvas.width = data.width; canvas.height = data.height;
+    }
+    // Keep the preview/previous render visible until a complete first pass exists.
+    if (data.spp > 4 || data.progress >= 4 / samples) {
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), data.width, data.height), 0, 0);
+      hasFrame = true;
+      $<HTMLButtonElement>('download').disabled = false;
+    }
+    $('samples-current').textContent = String(data.spp);
+    $('elapsed').textContent = `${(data.elapsed / 1000).toFixed(1)}s`;
+    $('progress').style.width = `${data.progress * 100}%`;
+    if (data.done) {
+      complete = true;
+      $('render-state').textContent = 'Render complete';
+      $('pause-label').textContent = 'Render again';
+      $('pause-symbol').textContent = '↻';
+    }
+  };
+  worker.onerror = event => fail(event.message);
+  worker.postMessage({ type: 'render', width, height, samples, seed, colors });
+}
+function fail(message: string) {
+  $('render-state').textContent = 'Renderer could not load';
+  $('render-dot').style.background = '#bc6e58';
+  $('pause-label').textContent = 'Try again';
+  $('pause-symbol').textContent = '↻';
+  complete = true;
+  console.error('smallpt:', message);
+}
+$('randomize').addEventListener('click', () => {
+  seed = crypto.getRandomValues(new Uint32Array(1))[0];
+  palette++;
+  $('palette-number').textContent = String(palette).padStart(2, '0');
+  colors = colors.map(({ id }) => ({ id, rgb: Array.from({ length: 3 }, () => .25 + Math.random() * .65) }));
+  ['swatch-left', 'swatch-right', 'swatch-mirror', 'swatch-glass'].forEach((id, i) => {
+    const rgb = colors[i].rgb.map(c => Math.round(Math.pow(c, 1 / 2.2) * 255));
+    $(id).style.setProperty('--swatch', `rgb(${rgb.join(',')})`);
+  });
+  start();
+});
+document.querySelectorAll<HTMLButtonElement>('[data-samples]').forEach(button => {
+  button.addEventListener('click', () => {
+    samples = Number(button.dataset.samples);
+    document.querySelectorAll('[data-samples]').forEach(el => {
+      el.classList.toggle('selected', el === button);
+      el.setAttribute('aria-pressed', String(el === button));
+    });
+    start();
+  });
+});
+$('resolution').addEventListener('change', start);
+$('pause').addEventListener('click', () => {
+  if (complete) { start(); return; }
+  paused = !paused;
+  worker?.postMessage({ type: 'pause', paused });
+  $('pause-label').textContent = paused ? 'Resume render' : 'Pause render';
+  $('pause-symbol').textContent = paused ? '▷' : 'Ⅱ';
+  $('render-state').textContent = paused ? 'Render paused' : 'Rendering';
+  $('render-dot').style.background = paused ? '#c4a968' : '#5f9672';
+});
+$('download').addEventListener('click', () => {
+  if (!hasFrame) return;
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const a = document.createElement('a'); a.href = url; a.download = `smallpt-${seed}.png`; a.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  });
+});
+const about = $<HTMLDialogElement>('about-dialog');
+$('about-open').addEventListener('click', () => about.showModal());
+$('about-close').addEventListener('click', () => about.close());
+about.addEventListener('click', event => { if (event.target === about) about.close(); });
+start();
