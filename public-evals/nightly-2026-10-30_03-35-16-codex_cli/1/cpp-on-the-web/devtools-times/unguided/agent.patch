diff --git a/public/wasm/render-worker.js b/public/wasm/render-worker.js
new file mode 100644
index 0000000..6181ada
--- /dev/null
+++ b/public/wasm/render-worker.js
@@ -0,0 +1,36 @@
+import createSmallpt from './smallpt.js';
+let modulePromise;
+let job = 0;
+let paused = false;
+self.onmessage = async ({ data }) => {
+  if (data.type === 'pause') { paused = data.paused; return; }
+  const currentJob = ++job;
+  paused = false;
+  try {
+    modulePromise ||= createSmallpt();
+    const mod = await modulePromise;
+    if (currentJob !== job) return;
+    const { width, height, samples, seed, colors } = data;
+    const ptr = mod._init_scene(width, height, seed);
+    colors.forEach(({ id, rgb }) => mod._set_color(id, ...rgb));
+    const start = performance.now();
+    let lastFrame = 0;
+    for (let pass = 0; pass < samples / 4; pass++) {
+      for (let row = 0; row < height; row += 8) {
+        while (paused && currentJob === job) await new Promise(r => setTimeout(r, 80));
+        if (currentJob !== job) return;
+        mod._render_rows(row, Math.min(8, height - row), pass);
+        const now = performance.now();
+        const done = pass === samples / 4 - 1 && row + 8 >= height;
+        if (now - lastFrame > 140 || done) {
+          const pixels = mod.HEAPU8.slice(ptr, ptr + width * height * 4);
+          self.postMessage({ type: 'frame', pixels, width, height, progress: (pass + Math.min(row + 8, height) / height) / (samples / 4), spp: (pass + 1) * 4, elapsed: now - start, done }, [pixels.buffer]);
+          lastFrame = now;
+        }
+        await new Promise(r => setTimeout(r, 0));
+      }
+    }
+  } catch (error) {
+    self.postMessage({ type: 'error', message: String(error) });
+  }
+};
