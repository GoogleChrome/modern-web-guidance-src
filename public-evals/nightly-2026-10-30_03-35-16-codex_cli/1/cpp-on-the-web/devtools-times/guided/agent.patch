+import { spawnSync } from 'node:child_process';
+import { mkdirSync, readFileSync } from 'node:fs';
+mkdirSync('public/wasm', { recursive: true });
+const result = spawnSync('em++', ['native/smallpt.cpp', '-o', 'public/wasm/smallpt.js', '-O3', '-fno-exceptions', '-fno-rtti', '-sDISABLE_EXCEPTION_THROWING', '-flto', '-Wall', '-Werror', '--no-entry', '-sSTRICT', '-sEXPORT_ES6', '-sENVIRONMENT=worker', '-sINCOMING_MODULE_JS_API=wasmBinary', '-sALLOW_MEMORY_GROWTH', '-sSTACK_SIZE=1MB', '-sEXPORTED_FUNCTIONS=_render_rows,_set_color,_malloc,_free', '-sEXPORTED_RUNTIME_METHODS=HEAPU8'], { stdio: 'inherit' });
+if (result.error) throw result.error;
+if (result.status !== 0) process.exit(result.status ?? 1);
+// Exercise the actual Wasm binary without a server or browser.
+const { default: createSmallpt } = await import('../public/wasm/smallpt.js?build=' + Date.now());
+const runtime = await createSmallpt({ wasmBinary: readFileSync('public/wasm/smallpt.wasm') });
+const width = 32, height = 24, length = width * height * 4;
+const ptr = runtime._malloc(length);
+try {
+  runtime._render_rows(ptr, width, height, 0, height, 2, 42);
+  const original = runtime.HEAPU8.slice(ptr, ptr + length);
+  if (!original.some((value, i) => i % 4 !== 3 && value > 0)) throw new Error('Render produced no light');
+  for (let i = 3; i < length; i += 4) if (original[i] !== 255) throw new Error('Invalid RGBA output');
+  runtime._set_color(6, .8, .2, .1);
+  runtime._set_color(7, .1, .3, .8);
+  runtime._render_rows(ptr, width, height, 0, height, 2, 42);
+  if (!runtime.HEAPU8.subarray(ptr, ptr + length).some((value, i) => value !== original[i])) throw new Error('Sphere colors did not change render');
+  console.log('Wasm build check passed: lit RGBA output and sphere color changes.');
+} finally { runtime._free(ptr); }
