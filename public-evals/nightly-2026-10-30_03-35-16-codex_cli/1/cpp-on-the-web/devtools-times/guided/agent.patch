+import createSmallpt from './smallpt.js';
+let runtime;
+self.onmessage = async ({ data }) => {
+  let ptr;
+  try {
+    runtime ??= await createSmallpt();
+    const { width, height, samples, colors, seed } = data;
+    for (const [id, color] of Object.entries(colors)) runtime._set_color(Number(id), ...color);
+    ptr = runtime._malloc(width * height * 4);
+    if (!ptr) throw new Error('Unable to allocate render memory. Try a smaller resolution.');
+    for (let row = 0; row < height; row += 4) {
+      const count = Math.min(4, height - row);
+      runtime._render_rows(ptr, width, height, row, count, samples / 4, seed);
+      const pixels = runtime.HEAPU8.slice(ptr + row * width * 4, ptr + (row + count) * width * 4);
+      self.postMessage({ type: 'rows', row, count, width, height, pixels }, [pixels.buffer]);
+    }
+    self.postMessage({ type: 'done' });
+  } catch (error) {
+    self.postMessage({ type: 'error', message: error.message });
+  } finally {
+    if (ptr) runtime._free(ptr);
+  }
+};
