+const canvas = document.querySelector<HTMLCanvasElement>('#render')!;
+const context = canvas.getContext('2d')!;
+const status = document.querySelector<HTMLElement>('#status')!;
+const progress = document.querySelector<HTMLElement>('#progress')!;
+const elapsed = document.querySelector<HTMLElement>('#elapsed')!;
+const mirror = document.querySelector<HTMLInputElement>('#mirror-color')!;
+const glass = document.querySelector<HTMLInputElement>('#glass-color')!;
+const samples = document.querySelector<HTMLSelectElement>('#samples')!;
+const resolution = document.querySelector<HTMLSelectElement>('#resolution')!;
+let worker: Worker | undefined;
+let timer: ReturnType<typeof setInterval>;
+let complete = false;
+let colors: Record<number, number[]> = { 0: [.75,.25,.25], 1: [.25,.25,.75], 6: [.999,.999,.999], 7: [.999,.999,.999] };
+const rgb = (hex: string) => [1,3,5].map(i => parseInt(hex.slice(i, i+2),16)/255 * .999);
+const hex = (color: number[]) => '#' + color.map(v => Math.round(v*255).toString(16).padStart(2,'0')).join('');
+function render() {
+  worker?.terminate();
+  clearInterval(timer);
+  complete = false;
+  const width = Number(resolution.value), height = width * .75;
+  const spp = Number(samples.value);
+  colors[6] = rgb(mirror.value); colors[7] = rgb(glass.value);
+  canvas.classList.remove('visible');
+  canvas.width = width; canvas.height = height;
+  document.querySelector('#dimensions')!.textContent = `${width} × ${height}`;
+  document.querySelector('#spp')!.textContent = `${spp} spp`;
+  progress.style.width = '0%';
+  status.textContent = 'Loading WebAssembly…';
+  const started = performance.now();
+  elapsed.textContent = '0.0 s';
+  timer = setInterval(() => { elapsed.textContent = `${((performance.now()-started)/1000).toFixed(1)} s`; },100);
+  try {
+    worker = new Worker('/wasm/worker.js', { type: 'module' });
+    worker.onmessage = ({data}) => {
+      if (data.type === 'rows') {
+        context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), data.width, data.count),0,data.row);
+        // Keep the original underneath until the first complete frame is ready.
+        const percent = Math.round((data.row + data.count)/data.height*100);
+        progress.style.width = `${percent}%`;
+        status.textContent = `Tracing light · ${percent}%`;
+      } else if (data.type === 'done') {
+        clearInterval(timer);
+        elapsed.textContent = `${((performance.now()-started)/1000).toFixed(1)} s`;
+        complete = true;
+        canvas.classList.add('visible');
+        status.textContent = 'Render complete';
+      } else if (data.type === 'error') { fail(data.message); }
+    };
+    worker.onerror = () => fail('Could not load the renderer. Click Randomize to retry.');
+    const seed = crypto.getRandomValues(new Uint32Array(1))[0];
+    worker.postMessage({width,height,samples:spp,colors,seed});
+  } catch (error) { fail(error instanceof Error ? error.message : 'WebAssembly is unavailable.'); }
+}
+function fail(message: string) { clearInterval(timer); status.textContent = message; worker?.terminate(); }
+document.querySelector('#randomize')!.addEventListener('click',() => {
+  const random = () => { const values=crypto.getRandomValues(new Uint8Array(3)); return Array.from(values,v=>.38+v/255*.57); };
+  colors[6]=random(); colors[7]=random(); mirror.value=hex(colors[6]); glass.value=hex(colors[7]); render();
+});
+document.querySelector('#reset')!.addEventListener('click',() => {
+  colors={0:[.75,.25,.25],1:[.25,.25,.75],6:[.999,.999,.999],7:[.999,.999,.999]}; mirror.value='#ffffff'; glass.value='#ffffff'; render();
+});
+[mirror,glass,samples,resolution].forEach(input=>input.addEventListener('change',render));
+document.querySelector('#download')!.addEventListener('click',() => {
+  const link=document.createElement('a');
+  if(complete) { link.href=canvas.toDataURL('image/png'); link.download='smallpt-render.png'; }
+  else { link.href='/images/cornell-reference.png'; link.download='smallpt-original.png'; }
+  link.click();
+});
+if(typeof WebAssembly === 'object' && typeof Worker !== 'undefined') render();
+else status.textContent='WebAssembly and Web Workers are required to render.';
