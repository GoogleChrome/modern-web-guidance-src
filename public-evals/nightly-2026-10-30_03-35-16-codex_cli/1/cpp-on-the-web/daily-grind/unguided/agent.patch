diff --git a/render-worker.js b/render-worker.js
new file mode 100644
index 0000000..d202bdc
--- /dev/null
+++ b/render-worker.js
@@ -0,0 +1,36 @@
+import createSmallpt from './assets/smallpt.js';
+let modulePromise;
+let generation = 0;
+self.onmessage = async ({data}) => {
+  const token = ++generation;
+  try {
+    modulePromise ??= createSmallpt();
+    const wasm = await modulePromise;
+    if (token !== generation) return;
+    const {width, height, samples, seed, colors} = data;
+    wasm._init(width, height, seed);
+    colors.forEach((color, index) => wasm._set_color(6 + index, ...color));
+    const started = performance.now();
+    let lastFrame = 0;
+    for (let sample = 0; sample < samples; sample += 4) {
+      for (let y = 0; y < height; y += 8) {
+        if (token !== generation) return;
+        wasm._render_rows(y, Math.min(8, height-y));
+        const now = performance.now();
+        const complete = sample + 4 >= samples && y + 8 >= height;
+        // Publish complete passes so no partially refreshed scanlines appear.
+        if (y + 8 >= height && (now - lastFrame > 100 || complete)) {
+          const offset = wasm._pixels();
+          const pixels = wasm.HEAPU8.slice(offset, offset + width * height * 4);
+          self.postMessage({id:data.id, pixels, width, height, samples:sample+4,
+            progress:(sample+4)/samples, elapsed:(now-started)/1000, complete}, [pixels.buffer]);
+          lastFrame = now;
+        }
+        // Yield to receive newer render requests and cancel old work.
+        await new Promise(resolve => setTimeout(resolve, 0));
+      }
+    }
+  } catch (error) {
+    self.postMessage({id:data.id, error:error.message || 'Could not start the renderer.'});
+  }
+};
