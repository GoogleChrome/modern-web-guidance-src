+const $ = id => document.getElementById(id);
+const canvas = $('render');
+const context = canvas.getContext('2d');
+let worker;
+let requestId = 0;
+let hasRendered = false;
+let previewLoaded;
+const preview = new Image();
+previewLoaded = new Promise(resolve => {
+  preview.onload = () => {
+    if (!hasRendered) context.drawImage(preview, 0, 0, canvas.width, canvas.height);
+    resolve();
+  };
+  preview.onerror = resolve;
+});
+preview.src = './assets/preview.png';
+
+function colorComponents(hex) {
+  return [1,3,5].map(offset => Math.min(.999, parseInt(hex.slice(offset, offset+2),16)/255));
+}
+function updateColors() {
+  ['mirror','glass'].forEach(name => {
+    const color = $(name+'-color').value;
+    $(name+'-hex').textContent = color.toUpperCase();
+    $(name+'-sphere').style.background = `radial-gradient(circle at 32% 25%, #fff 1%, ${color} 32%, #454d3e 82%, ${color} 96%)`;
+  });
+}
+function showError(message) {
+  $('render-state').textContent = 'Renderer unavailable';
+  $('render-dot').style.background = '#ed653b';
+  $('canvas-error').hidden = false;
+  $('canvas-error').textContent = `The renderer could not finish. ${message} Try rendering again.`;
+}
+function render() {
+  try {
+    if (!worker) {
+      worker = new Worker(new URL('./render-worker.js', import.meta.url), {type:'module'});
+      worker.onmessage = ({data}) => {
+        if (data.id !== requestId) return;
+        if (data.error) return showError(data.error);
+        hasRendered = true;
+        if (canvas.width !== data.width || canvas.height !== data.height) {
+          canvas.width = data.width; canvas.height = data.height;
+        }
+        context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer),data.width,data.height),0,0);
+        $('render-state').textContent = data.complete ? 'Render complete' : 'Tracing light';
+        $('sample-status').textContent = `${data.samples} / ${$('samples').value} samples`;
+        $('elapsed').textContent = `${data.elapsed.toFixed(1)}s`;
+        $('progress').style.width = `${data.progress*100}%`;
+        $('render-dot').style.background = data.complete ? '#a2bd86' : '#edb778';
+      };
+      worker.onerror = () => {
+        showError('WebAssembly or the rendering worker failed to load.');
+        worker.terminate(); worker = undefined;
+      };
+    }
+    const width = Number($('resolution').value), height = width * .75;
+    $('canvas-error').hidden = true;
+    $('render-state').textContent = 'Tracing light';
+    $('sample-status').textContent = `0 / ${$('samples').value} samples`;
+    $('elapsed').textContent = '0.0s';
+    $('progress').style.width = '0%';
+    $('top-resolution').textContent = `${width} × ${height}`;
+    worker.postMessage({id:++requestId,width,height,samples:Number($('samples').value),
+      seed:crypto.getRandomValues(new Uint32Array(1))[0],
+      colors:[$('mirror-color').value,$('glass-color').value].map(colorComponents)});
+  } catch(error) { showError(error.message); }
+}
+function randomColor() {
+  // Bright tints retain the original reflective and refractive materials.
+  const hue = crypto.getRandomValues(new Uint32Array(1))[0] % 360;
+  const c = .65, x = c * (1-Math.abs((hue/60)%2-1)), m = .28;
+  const rgb = hue<60?[c,x,0]:hue<120?[x,c,0]:hue<180?[0,c,x]:hue<240?[0,x,c]:hue<300?[x,0,c]:[c,0,x];
+  return '#'+rgb.map(v=>Math.round((v+m)*255).toString(16).padStart(2,'0')).join('');
+}
+$('randomize').onclick = () => {
+  $('mirror-color').value = randomColor(); $('glass-color').value = randomColor();
+  updateColors(); render();
+};
+['mirror','glass'].forEach(name => {
+  $(name+'-color').addEventListener('input',updateColors);
+  $(name+'-color').addEventListener('change',render);
+});
+$('rerender').onclick = render;
+$('resolution').onchange = render;
+$('samples').onchange = () => {
+  $('quality-label').textContent = {16:'PREVIEW',32:'FAST',64:'BALANCED',128:'FINE',256:'HIGH QUALITY'}[$('samples').value];
+  render();
+};
+$('reset').onclick = () => {
+  $('mirror-color').value = '#ffffff'; $('glass-color').value = '#ffffff';
+  $('resolution').value = '640'; $('samples').value = '64';
+  $('quality-label').textContent = 'BALANCED'; updateColors(); render();
+};
+$('download').onclick = async () => {
+  await previewLoaded;
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url=URL.createObjectURL(blob), link=document.createElement('a');
+    link.href=url; link.download=`smallpt-${Date.now()}.png`; link.click();
+    setTimeout(()=>URL.revokeObjectURL(url),1000);
+  },'image/png');
+};
+$('fullscreen').onclick = async () => {
+  try {
+    if(document.fullscreenElement) await document.exitFullscreen();
+    else await $('viewport').requestFullscreen();
+  } catch { $('viewport').scrollIntoView({behavior:'smooth',block:'center'}); }
+};
+render();
