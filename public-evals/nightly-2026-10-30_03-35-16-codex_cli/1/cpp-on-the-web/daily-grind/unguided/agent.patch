+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+emcc src/smallpt.cpp -O3 --no-entry -s WASM=1 -s ALLOW_MEMORY_GROWTH=1 -s STACK_SIZE=1048576 -s EXPORTED_FUNCTIONS='["_init","_set_color","_pixels","_render_rows"]' -s EXPORTED_RUNTIME_METHODS='["HEAPU8"]' -s MODULARIZE=1 -s EXPORT_ES6=1 -s ENVIRONMENT=worker,node -o assets/smallpt.js
