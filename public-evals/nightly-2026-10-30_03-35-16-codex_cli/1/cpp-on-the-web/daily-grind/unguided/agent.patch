+}
+
+static int width, height, pass;
+static unsigned int seed;
+static std::vector<Vec> accumulated;
+static std::vector<unsigned char> rgba;
+extern "C" {
+void init(int w, int h, unsigned int s) {
+  width=w; height=h; seed=s; pass=0;
+  accumulated.assign(w*h,Vec()); rgba.assign(w*h*4,0);
+}
+void set_color(int id, double r, double g, double b) {
+  if (id==6 || id==7) spheres[id].c=Vec(r,g,b);
+}
+unsigned char* pixels() { return rgba.data(); }
+void render_rows(int start, int rows) {
+  Ray cam(Vec(50,52,295.6),Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  for(int y=start;y<start+rows && y<height;y++) {
+    unsigned short Xi[3]={(unsigned short)(seed+pass*1741),(unsigned short)(y*391+seed/65536),(unsigned short)(y*y*y+pass*7919)};
+    for(int x=0;x<width;x++) {
+      Vec value;
+      for(int sy=0;sy<2;sy++) for(int sx=0;sx<2;sx++) {
+        double r1=2*erand48(Xi),dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+        double r2=2*erand48(Xi),dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+        Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+        value=value+radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*.25;
+      }
+      int i=(height-y-1)*width+x;
+      accumulated[i]=accumulated[i]+value;
+      Vec c=accumulated[i]*(1./(pass+1));
+      rgba[i*4]=toInt(c.x); rgba[i*4+1]=toInt(c.y); rgba[i*4+2]=toInt(c.z); rgba[i*4+3]=255;
+    }
+  }
+  if(start+rows>=height) pass++;
+}
+}
+#ifdef NATIVE_PREVIEW
+int main(int argc,char** argv) {
+  int w=argc>1?atoi(argv[1]):720,h=w*3/4,spp=argc>2?atoi(argv[2]):256;
+  init(w,h,42);
+  if(argc>3) { set_color(6,.95,.55,.28);set_color(7,.45,.8,.7); }
+  for(int p=0;p<spp/4;p++) render_rows(0,h);
+  printf("P6\n%d %d\n255\n",w,h);
+  for(int i=0;i<w*h;i++) fwrite(rgba.data()+i*4,1,3,stdout);
+}
+#endif
