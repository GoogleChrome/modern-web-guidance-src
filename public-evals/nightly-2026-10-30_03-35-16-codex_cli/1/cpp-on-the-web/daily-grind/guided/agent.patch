+#!/usr/bin/env bash
+set -eu
+mkdir -p assets
+em++ src/renderer.cpp -o assets/smallpt.js -O3 -flto -fno-exceptions -Wall -Werror -Wno-dangling-else --no-entry -sSTRICT -sEXPORT_ES6 -sENVIRONMENT=worker -sALLOW_MEMORY_GROWTH -sSTACK_SIZE=1MB -sEXPORTED_FUNCTIONS=_init_scene,_set_color,_pixel_buffer,_render_rows -sEXPORTED_RUNTIME_METHODS=HEAPU8
+node --check app.js
