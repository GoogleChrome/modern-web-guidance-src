+const $ = selector => document.querySelector(selector);
+const canvas = $('#render');
+const context = canvas.getContext('2d');
+const original = [[0,.75,.25,.25],[1,.25,.25,.75],[2,.75,.75,.75],[6,.999,.999,.999],[7,.999,.999,.999]];
+let colors = original.map(c => [...c]);
+let worker, job = 0, paletteNumber = 0, hasFrame = false;
+const target = () => Number($('#quality').value);
+function updatePalette() {
+  document.querySelectorAll('.palette>span').forEach((el, i) => {
+    el.style.setProperty('--swatch', `rgb(${colors[i].slice(1).map(c => Math.round(c * 255)).join(',')})`);
+  });
+}
+function fail(message) {
+  $('#render-status').textContent = 'Renderer unavailable';
+  $('.render-panel').classList.add('failed');
+  $('#render-status').title = message;
+  $('#sample-count').textContent = 'Try reloading the page';
+}
+function render() {
+  job++;
+  $('#progress').max = target();
+  $('#progress').value = 0;
+  $('#sample-count').textContent = `0 / ${target()} spp`;
+  $('#elapsed').textContent = '0.0s';
+  $('#render-status').innerHTML = '<span class="status-dot"></span> Tracing light paths';
+  $('.render-panel').classList.remove('failed');
+  if (!worker) {
+    try {
+      worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });
+      worker.onmessage = ({ data }) => {
+        if (data.job !== job) return;
+        if (data.error) { fail(data.error); return; }
+        context.putImageData(new ImageData(data.pixels, canvas.width, canvas.height), 0, 0);
+        $('#preview').hidden = true;
+        hasFrame = true;
+        $('#download').disabled = false;
+        $('#progress').value = data.samples;
+        $('#sample-count').textContent = `${data.samples} / ${target()} spp`;
+        $('#elapsed').textContent = `${(data.elapsed / 1000).toFixed(1)}s`;
+        if (data.done) $('#render-status').innerHTML = '<span class="status-dot"></span> Render complete';
+      };
+      worker.onerror = event => { fail(event.message); worker.terminate(); worker = null; };
+    } catch (error) { fail(error.message); return; }
+  }
+  worker.postMessage({ width: canvas.width, height: canvas.height, seed: crypto.getRandomValues(new Uint32Array(1))[0], colors, target: target(), job });
+}
+function randomColor() {
+  const hue = Math.random() * 360;
+  const saturation = .35 + Math.random() * .4;
+  const light = .42 + Math.random() * .2;
+  const a = saturation * Math.min(light, 1 - light);
+  return [0, 8, 4].map(n => { const k = (n + hue / 30) % 12; return light - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)); });
+}
+$('#randomize').addEventListener('click', () => {
+  colors = original.map(([id]) => [id, ...randomColor()]);
+  $('#palette-name').textContent = `Variation ${String(++paletteNumber).padStart(2, '0')}`;
+  updatePalette(); render();
+});
+$('#reset').addEventListener('click', () => {
+  colors = original.map(c => [...c]);
+  $('#palette-name').textContent = 'Original';
+  updatePalette(); render();
+});
+$('#quality').addEventListener('change', render);
+$('#download').addEventListener('click', () => {
+  if (!hasFrame) return;
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const a = document.createElement('a'); a.href = url; a.download = `smallpt-${paletteNumber ? `variation-${paletteNumber}` : 'original'}.png`; a.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+$('#expand').addEventListener('click', async () => {
+  const viewport = $('.viewport');
+  try {
+    if (document.fullscreenElement) await document.exitFullscreen();
+    else if (viewport.requestFullscreen) await viewport.requestFullscreen();
+    else window.open(canvas.toDataURL('image/png'), '_blank');
+  } catch { $('#expand').title = 'Fullscreen is unavailable in this view'; }
+});
+render();
