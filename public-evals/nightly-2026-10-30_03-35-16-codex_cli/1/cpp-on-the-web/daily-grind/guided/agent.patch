diff --git a/worker.js b/worker.js
new file mode 100644
index 0000000..d3035c3
--- /dev/null
+++ b/worker.js
@@ -0,0 +1,28 @@
+import createSmallpt from './assets/smallpt.js';
+let modulePromise;
+let generation = 0;
+const yieldTask = () => new Promise(resolve => setTimeout(resolve, 0));
+self.onmessage = async ({ data }) => {
+  const current = ++generation;
+  try {
+    modulePromise ??= createSmallpt();
+    const wasm = await modulePromise;
+    if (current !== generation) return;
+    const { width, height, seed, colors, target, job } = data;
+    wasm._init_scene(width, height, seed);
+    for (const [id, r, g, b] of colors) wasm._set_color(id, r, g, b);
+    const started = performance.now();
+    for (let samples = 4; samples <= target; samples += 4) {
+      for (let row = 0; row < height; row += 12) {
+        if (current !== generation) return;
+        wasm._render_rows(row, Math.min(12, height - row));
+        await yieldTask();
+      }
+      if (current !== generation) return;
+      const pixels = new Uint8ClampedArray(wasm.HEAPU8.buffer, wasm._pixel_buffer(), width * height * 4).slice();
+      self.postMessage({ pixels, samples, elapsed: performance.now() - started, job, done: samples === target }, [pixels.buffer]);
+    }
+  } catch (error) {
+    if (current === generation) self.postMessage({ error: error.message, job: data.job });
+  }
+};
