diff --git a/scripts/check-wasm.mjs b/scripts/check-wasm.mjs
new file mode 100644
index 0000000..6a0e72c
--- /dev/null
+++ b/scripts/check-wasm.mjs
@@ -0,0 +1,29 @@
+import { readFile } from 'node:fs/promises';
+import assert from 'node:assert/strict';
+// Load the actual worker-targeted module without a browser or HTTP server.
+const originalFetch = globalThis.fetch;
+globalThis.fetch = async (url, options) => {
+  if (String(url).startsWith('file:')) return new Response(await readFile(new URL(url)), { headers: { 'Content-Type': 'application/wasm' } });
+  return originalFetch(url, options);
+};
+try {
+  const { default: createRenderer } = await import('../assets/smallpt.js');
+  const wasm = await createRenderer();
+  const frame = (tinted = false) => {
+    wasm._init_scene(48, 32, 42);
+    wasm._set_color(6, tinted ? .15 : .999, .999, tinted ? .3 : .999);
+    for (let pass = 0; pass < 2; pass++) {
+      for (let row = 0; row < 32; row += 8) wasm._render_rows(row, 8);
+    }
+    return wasm.HEAPU8.slice(wasm._pixel_buffer(), wasm._pixel_buffer() + 48 * 32 * 4);
+  };
+  const original = frame();
+  assert.equal(original.length, 6144);
+  assert(original.some((v, i) => i % 4 !== 3 && v > 0), 'Render must contain visible pixels');
+  assert(original.every((v, i) => i % 4 !== 3 || v === 255), 'All pixels must be opaque');
+  assert.notDeepEqual(frame(true), original, 'Changing sphere color must change rendered pixels');
+  assert.deepEqual(frame(), original, 'Resetting scene and seed must reproduce the original render');
+  console.log('WASM check passed: render, sphere color change, deterministic reset.');
+} finally {
+  globalThis.fetch = originalFetch;
+}
