+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = document.getElementById('coffee-stage');
+      const form = document.getElementById('coffee-form');
+      const name = document.getElementById('coffee-name');
+      const milk = document.getElementById('coffee-milk');
+      const syrup = document.getElementById('coffee-syrup');
+      const summary = document.getElementById('coffee-summary');
+      const ctx = canvas.getContext('2d');
+      let nativeCanvas = !!ctx && 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function' && typeof canvas.requestPaint === 'function';
+      let pixelSize;
+      let frame;
+
+      function useOverlay() {
+        nativeCanvas = false;
+        canvas.onpaint = null;
+        stage.append(form);
+        stage.classList.remove('native-canvas');
+        stage.style.height = '';
+        form.style.width = '';
+        canvas.setAttribute('aria-hidden', 'true');
+      }
+
+      function drawCup() {
+        if (!ctx) return;
+        const width = stage.clientWidth;
+        const height = stage.clientHeight;
+        const x = (width - form.offsetWidth) / 2;
+        const bottom = 110 + form.offsetHeight + 18;
+        // Use CSS pixel coordinates for both cup and HTML; only the backing store scales.
+        ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
+        ctx.clearRect(0, 0, width, height);
+        const left = x - 16;
+        const right = x + form.offsetWidth + 16;
+        ctx.lineWidth = 9;
+        ctx.strokeStyle = '#b49a87';
+        ctx.beginPath();
+        ctx.ellipse(right - 2, 185, Math.min(29, x - 22), 48, 0, 0, Math.PI * 2);
+        ctx.stroke();
+        ctx.fillStyle = '#d7c2ae';
+        ctx.beginPath();
+        ctx.ellipse(width / 2, bottom + 20, (right - left) / 2 + 18, 12, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.fillStyle = '#fffaf3';
+        ctx.strokeStyle = '#b49a87';
+        ctx.lineWidth = 3;
+        ctx.beginPath();
+        ctx.moveTo(left, 88);
+        ctx.lineTo(left + 10, bottom - 20);
+        ctx.quadraticCurveTo(left + 10, bottom + 8, width / 2, bottom + 8);
+        ctx.quadraticCurveTo(right - 10, bottom + 8, right - 10, bottom - 20);
+        ctx.lineTo(right, 88);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+        ctx.fillStyle = milk.value === 'oat' ? '#bc8a5c' : milk.value === 'almond' ? '#b48665' : '#c99b77';
+        ctx.beginPath();
+        ctx.ellipse(width / 2, 88, (right - left) / 2, 18, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.stroke();
+        // drawElementImage synchronizes native hit testing and accessibility bounds.
+        if (nativeCanvas) {
+          try {
+            ctx.drawElementImage(form, x, 110);
+          } catch {
+            useOverlay();
+            scheduleRender();
+          }
+        }
+      }
+
+      function render() {
+        frame = undefined;
+        if (nativeCanvas) {
+          form.style.width = Math.min(400, stage.clientWidth - 88) + 'px';
+          stage.style.height = form.offsetHeight + 180 + 'px';
+        }
+        const ratio = window.devicePixelRatio || 1;
+        const width = pixelSize?.inlineSize || Math.round(stage.clientWidth * ratio);
+        const height = pixelSize?.blockSize || Math.round(stage.clientHeight * ratio);
+        if (canvas.width !== width) canvas.width = width;
+        if (canvas.height !== height) canvas.height = height;
+        if (nativeCanvas) canvas.requestPaint();
+        else drawCup();
+      }
+
+      function scheduleRender() {
+        if (frame === undefined) frame = requestAnimationFrame(render);
+      }
+
+      function updateSummary(reviewed = false) {
+        const person = name.value.trim();
+        summary.textContent = (reviewed ? 'Your selection is ready' : 'Your latte') +
+          (person ? ', ' + person : '') + ': ' + milk.selectedOptions[0].textContent +
+          ' · ' + syrup.selectedOptions[0].textContent;
+        scheduleRender();
+      }
+
+      form.addEventListener('input', () => updateSummary());
+      form.addEventListener('change', () => updateSummary());
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        updateSummary(true);
+      });
+
+      if (nativeCanvas) {
+        stage.style.height = stage.clientHeight + 'px';
+        stage.classList.add('native-canvas');
+        canvas.removeAttribute('aria-hidden');
+        canvas.append(form);
+        canvas.onpaint = drawCup;
+      }
+
+      if (typeof ResizeObserver !== 'undefined') {
+        const observer = new ResizeObserver((entries) => {
+          for (const entry of entries) {
+            if (entry.target === canvas) pixelSize = entry.devicePixelContentBoxSize?.[0];
+          }
+          scheduleRender();
+        });
+        const devicePixels = typeof ResizeObserverEntry !== 'undefined' &&
+          'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+        observer.observe(canvas, devicePixels ? { box: 'device-pixel-content-box' } : {});
+        observer.observe(stage);
+        observer.observe(form);
+      }
+
+      // Re-arm the query after every density change, including browser zoom or a new display.
+      function watchDensity() {
+        const query = matchMedia('(resolution: ' + window.devicePixelRatio + 'dppx)');
+        query.addEventListener('change', () => {
+          pixelSize = undefined;
+          scheduleRender();
+          watchDensity();
+        }, { once: true });
+      }
+      watchDensity();
+      window.addEventListener('resize', () => {
+        pixelSize = undefined;
+        scheduleRender();
+      });
+      scheduleRender();
+    })();
+  </script>
