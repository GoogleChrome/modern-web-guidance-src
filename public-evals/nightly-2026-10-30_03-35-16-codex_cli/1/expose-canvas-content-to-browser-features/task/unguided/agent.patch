+  <script>
+    (() => {
+      const stage = document.querySelector('.coffee-stage');
+      const canvas = document.getElementById('canvas');
+      const form = document.getElementById('coffee-form');
+      const milk = document.getElementById('coffee-milk');
+      const syrup = document.getElementById('coffee-syrup');
+      const result = document.getElementById('coffee-result');
+      const context = canvas.getContext('2d');
+      let frame;
+
+      function drawCup() {
+        if (!context) return;
+        const bounds = stage.getBoundingClientRect();
+        const controls = form.getBoundingClientRect();
+        if (!bounds.width || !bounds.height) return;
+        const ratio = window.devicePixelRatio || 1;
+        canvas.width = Math.round(bounds.width * ratio);
+        canvas.height = Math.round(bounds.height * ratio);
+        // Draw in CSS pixels, using the actual rounded backing-store scale.
+        context.setTransform(canvas.width / bounds.width, 0, 0,
+          canvas.height / bounds.height, 0, 0);
+
+        // DOM bounds are the single source of truth for both the cup and sleeve.
+        const left = controls.left - bounds.left;
+        const top = controls.top - bounds.top;
+        const right = left + controls.width;
+        const bottom = top + controls.height;
+        const middle = (left + right) / 2;
+
+        context.fillStyle = '#d7c6b6';
+        context.beginPath();
+        context.ellipse(middle, bottom + 37, controls.width / 2 + 25, 12, 0, 0, Math.PI * 2);
+        context.fill();
+
+        // Handle fits within the stage even at narrow viewport widths.
+        const handleWidth = Math.min(40, bounds.width - right - 8);
+        context.strokeStyle = '#8d6e63';
+        context.lineWidth = 12;
+        context.beginPath();
+        context.ellipse(right + 5, top + controls.height * 0.45,
+          handleWidth, Math.min(65, controls.height * 0.25), 0, 0, Math.PI * 2);
+        context.stroke();
+        context.fillStyle = '#fff8ed';
+        context.strokeStyle = '#8d6e63';
+        context.lineWidth = 2;
+        context.beginPath();
+        context.moveTo(left - 20, top - 22);
+        context.lineTo(right + 20, top - 22);
+        context.lineTo(right + 6, bottom + 10);
+        context.quadraticCurveTo(middle, bottom + 40, left - 6, bottom + 10);
+        context.closePath();
+        context.fill();
+        context.stroke();
+
+        context.fillStyle = milk.value === 'none' ? '#4e2e20' : '#b88457';
+        context.beginPath();
+        context.ellipse(middle, top - 22, controls.width / 2 + 20, 15, 0, 0, Math.PI * 2);
+        context.fill();
+        context.stroke();
+
+        context.strokeStyle = '#a58c7c';
+        context.lineWidth = 3;
+        context.lineCap = 'round';
+        for (const offset of [-32, 0, 32]) {
+          context.beginPath();
+          context.moveTo(middle + offset, top - 52);
+          context.bezierCurveTo(middle + offset - 16, top - 67,
+            middle + offset + 16, top - 77, middle + offset, top - 92);
+          context.stroke();
+        }
+      }
+
+      function scheduleDraw() {
+        cancelAnimationFrame(frame);
+        frame = requestAnimationFrame(drawCup);
+      }
+
+      function updateBlend() {
+        // Copy visible option text so browser-translated labels stay consistent.
+        document.getElementById('milk-summary').textContent = milk.selectedOptions[0].textContent;
+        document.getElementById('syrup-summary').textContent = syrup.selectedOptions[0].textContent;
+        result.hidden = true;
+        scheduleDraw();
+      }
+
+      milk.addEventListener('change', updateBlend);
+      syrup.addEventListener('change', updateBlend);
+      document.getElementById('coffee-name').addEventListener('input', () => { result.hidden = true; });
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const name = document.getElementById('coffee-name').value.trim();
+        document.getElementById('coffee-recipient-name').textContent = name;
+        document.getElementById('coffee-recipient').hidden = !name;
+        document.getElementById('review-milk').textContent = milk.selectedOptions[0].textContent;
+        document.getElementById('review-syrup').textContent = syrup.selectedOptions[0].textContent;
+        result.hidden = false;
+      });
+
+      // ResizeObserver covers responsive layouts, zoom, and translated/wrapped text.
+      if ('ResizeObserver' in window) {
+        const observer = new ResizeObserver(scheduleDraw);
+        observer.observe(stage);
+        observer.observe(form);
+      }
+      window.addEventListener('resize', scheduleDraw);
+      if (document.fonts) document.fonts.ready.then(scheduleDraw);
+
+      // A monitor change can alter pixel density without changing CSS dimensions.
+      function watchPixelRatio() {
+        const query = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        query.addEventListener('change', () => {
+          scheduleDraw();
+          watchPixelRatio();
+        }, { once: true });
+      }
+      watchPixelRatio();
+      scheduleDraw();
+    })();
+  </script>
+
 </body>
 
