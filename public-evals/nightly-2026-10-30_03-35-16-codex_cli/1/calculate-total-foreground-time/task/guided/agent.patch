+  <script>
+    window.getTotalForegroundTime = (() => {
+      // Start early so the fallback observes visibility changes during loading.
+      let accumulatedTime = 0;
+      let visibleSince = document.visibilityState === 'visible' ? performance.now() : null;
+
+      function updateVisibility() {
+        const now = performance.now();
+        if (document.visibilityState === 'visible') {
+          if (visibleSince === null) visibleSince = now;
+        } else if (visibleSince !== null) {
+          accumulatedTime += now - visibleSince;
+          visibleSince = null;
+        }
+      }
+
+      document.addEventListener('visibilitychange', updateVisibility);
+
+      /**
+       * Returns total visible time in milliseconds for this document's lifetime.
+       * Visibility history includes time before this script ran when supported.
+       * Otherwise, tracking starts here and excludes subsequent hidden periods.
+       * Visibility measures foreground time, not attention or user activity.
+       */
+      return function getTotalForegroundTime() {
+        const entries = performance.getEntriesByType('visibility-state');
+        const now = performance.now();
+
+        if (entries.length === 0) {
+          return accumulatedTime + (visibleSince === null ? 0 : now - visibleSince);
+        }
+
+        let total = 0;
+        for (let i = 0; i < entries.length; i++) {
+          if (entries[i].name === 'visible') {
+            const end = i + 1 < entries.length ? entries[i + 1].startTime : now;
+            total += end - entries[i].startTime;
+          }
+        }
+        return total;
+      };
+    })();
