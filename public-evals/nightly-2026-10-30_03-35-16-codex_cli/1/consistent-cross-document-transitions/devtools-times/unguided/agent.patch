diff --git a/src/scripts/transition-ready.js b/src/scripts/transition-ready.js
new file mode 100644
index 0000000..8cb1c31
--- /dev/null
+++ b/src/scripts/transition-ready.js
@@ -0,0 +1,49 @@
+// This head module blocks rendering until the initial controls and font are ready.
+// If a resource fails or the browser reveals the page early, skip the animation.
+let ready = false;
+window.addEventListener('pagereveal', (event) => {
+  if (!ready) event.viewTransition?.skipTransition();
+});
+
+const controller = new AbortController();
+const { signal } = controller;
+const timeout = setTimeout(() => controller.abort(), 3000);
+
+function waitForEvent(target, name) {
+  return new Promise((resolve, reject) => {
+    signal.throwIfAborted();
+    target.addEventListener(name, resolve, { once: true, signal });
+    signal.addEventListener('abort', () => reject(signal.reason), { once: true });
+  });
+}
+
+try {
+  // Module evaluation can begin while the document is still being parsed.
+  if (document.readyState === 'loading') {
+    await waitForEvent(document, 'DOMContentLoaded');
+  }
+
+  const controls = [...document.querySelectorAll(
+    '[data-transition-critical] astro-island[client="load"][ssr]',
+  )];
+  const hydration = Promise.all(controls.map((island) => waitForEvent(island, 'astro:hydrate')));
+  const fonts = document.fonts.load('500 1em "Grenze"');
+
+  await Promise.race([
+    Promise.all([hydration, fonts]),
+    new Promise((_, reject) => {
+      signal.throwIfAborted();
+      signal.addEventListener('abort', () => reject(signal.reason), { once: true });
+    }),
+  ]);
+  ready = true;
+} catch {
+  // Leave the server-rendered page usable even if critical JavaScript fails.
+} finally {
+  clearTimeout(timeout);
+  controller.abort();
+  const marker = document.createElement('span');
+  marker.id = 'page-state-ready';
+  marker.hidden = true;
+  (document.body ?? document.documentElement).append(marker);
+}
