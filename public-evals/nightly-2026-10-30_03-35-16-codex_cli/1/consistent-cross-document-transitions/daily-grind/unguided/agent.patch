+    <section aria-labelledby="locations-heading">
+      <h2 id="locations-heading" style="text-align: center;">Visit Us</h2>
+      <div class="grid">
+        <article class="card">
+          <h3>Your Neighborhood Coffee</h3>
+          <p>Enjoy ethically sourced, locally roasted coffee and discover your next favorite.</p>
+          <a href="/menu/" class="btn">Explore the Menu</a>
+        </article>
+        <article class="card">
+          <h3>Plan Your Visit</h3>
+          <p>Café addresses and opening hours will be listed here when available.</p>
+        </article>
+      </div>
+    </section>
+    <span id="page-ready" hidden></span>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+</body>
+</html>
