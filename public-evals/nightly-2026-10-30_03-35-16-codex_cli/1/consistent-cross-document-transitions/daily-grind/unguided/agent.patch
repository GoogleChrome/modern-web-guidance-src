diff --git a/initial-visuals.js b/initial-visuals.js
new file mode 100644
index 0000000..d6a4310
--- /dev/null
+++ b/initial-visuals.js
@@ -0,0 +1,19 @@
+// Run from the head without waiting for parsing to reach the footer.
+(() => {
+  const hero = new Image();
+  let heroReady = false;
+  hero.src = document.getElementById('hero-preload').href;
+  hero.decode().then(() => {
+    heroReady = true;
+  }).catch(() => {
+    // Leave ordinary navigation available when the photo cannot load.
+  });
+
+  // Never animate an incoming snapshot whose hero could change mid-transition.
+  // Cold/failed image requests fall back to an ordinary page reveal.
+  window.addEventListener('pagereveal', (event) => {
+    if (event.viewTransition && !heroReady) {
+      event.viewTransition.skipTransition();
+    }
+  });
+})();
