--- /dev/null
+++ b/src/pages/api/account/passkeys.ts
@@ -0,0 +1,33 @@
+import type { APIRoute } from 'astro';
+import { deletePasskey, listPasskeys, renamePasskey, updateDisplayName } from '../../../lib/server/accounts';
+import { json, relyingParty, sameOrigin, signedInAccount } from '../../../lib/server/auth';
+
+export const ALL: APIRoute = async ({ request, session, url }) => {
+  if (!['GET', 'PUT', 'DELETE', 'PATCH'].includes(request.method)) return json({ error: 'Method not allowed.' }, 405);
+  if (request.method !== 'GET' && !sameOrigin(request)) return json({ error: 'Invalid request origin.' }, 403);
+  const user = await signedInAccount(session);
+  if (!user) return json({ error: 'Please sign in to manage your passkeys.' }, 401);
+  const { rpId } = relyingParty(url);
+  if (request.method !== 'GET') {
+    try {
+      const { id, name } = await request.json();
+      if (request.method !== 'DELETE' && (typeof name !== 'string' || !name.trim() || name.trim().length > 80)) {
+        return json({ error: 'Enter a name between 1 and 80 characters.' }, 400);
+      }
+      if (request.method === 'PATCH') {
+        updateDisplayName(user.id, name.trim());
+        user.displayName = name.trim();
+      } else {
+        if (typeof id !== 'string') return json({ error: 'A passkey ID is required.' }, 400);
+        const changed = request.method === 'DELETE'
+          ? deletePasskey(id, user.id, rpId)
+          : renamePasskey(id, user.id, rpId, name.trim());
+        if (!changed) return json({ error: 'Passkey not found. Refresh your list and try again.' }, 404);
+      }
+    } catch { return json({ error: 'Unable to update your settings. Please try again.' }, 400); }
+  }
+  // Always return the complete, authoritative list for this account and RP.
+  const passkeys = listPasskeys(user.id, rpId).map(({ id, name, aaguid, registeredAt, lastUsedAt }) =>
+    ({ id, name, aaguid, registeredAt, lastUsedAt }));
+  return json({ user, rpId, passkeys });
+};
diff --git a/src/pages/api/account/webauthn.ts b/src/pages/api/account/webauthn.ts
new file mode 100644
index 0000000..345c928
--- /dev/null
+++ b/src/pages/api/account/webauthn.ts
@@ -0,0 +1,73 @@
+import type { APIRoute } from 'astro';
+import {
+  generateRegistrationOptions, verifyRegistrationResponse,
+  generateAuthenticationOptions, verifyAuthenticationResponse,
+} from '@simplewebauthn/server';
+import { findAccount, findPasskey, listPasskeys, recordSignIn, savePasskey } from '../../../lib/server/accounts';
+import { json, relyingParty, sameOrigin, signedInAccount, signIn } from '../../../lib/server/auth';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!sameOrigin(request)) return json({ error: 'Invalid request origin.' }, 403);
+  if (!session) return json({ error: 'Passkeys are unavailable.' }, 503);
+  const { rpId, origin } = relyingParty(url);
+  try {
+    const { action, credential: response } = await request.json();
+    const user = await signedInAccount(session);
+    if (action === 'register-options') {
+      if (!user) return json({ error: 'Please sign in first.' }, 401);
+      const options = await generateRegistrationOptions({
+        rpName: 'The DevTools Times', rpID: rpId,
+        userID: Buffer.from(user.id, 'base64url'), userName: user.username, userDisplayName: user.displayName,
+        attestationType: 'none',
+        excludeCredentials: listPasskeys(user.id, rpId).map(({ id, transports }) => ({ id, transports })),
+        authenticatorSelection: { residentKey: 'required', userVerification: 'required' },
+      });
+      await session.set('passkeyChallenge', {
+        challenge: options.challenge, purpose: 'register', userId: user.id,
+        expiresAt: Date.now() + 300000, rpId, origin,
+      });
+      return json({ options, rpId });
+    }
+    if (action === 'authenticate-options') {
+      const options = await generateAuthenticationOptions({ rpID: rpId, allowCredentials: [], userVerification: 'required' });
+      await session.set('passkeyChallenge', {
+        challenge: options.challenge, purpose: 'authenticate', expiresAt: Date.now() + 300000, rpId, origin,
+      });
+      return json({ options, rpId });
+    }
+    const challenge = await session.get('passkeyChallenge');
+    await session.delete('passkeyChallenge');
+    if (!challenge || challenge.expiresAt < Date.now() || challenge.rpId !== rpId || challenge.origin !== origin) {
+      return json({ error: 'Your passkey request expired. Please try again.' }, 400);
+    }
+    if (action === 'register-verify' && challenge.purpose === 'register') {
+      if (!user || challenge.userId !== user.id) return json({ error: 'Please sign in again.' }, 401);
+      const { verified, registrationInfo } = await verifyRegistrationResponse({
+        response, expectedChallenge: challenge.challenge, expectedOrigin: origin,
+        expectedRPID: rpId, requireUserVerification: true,
+      });
+      if (!verified || !registrationInfo) return json({ error: 'Unable to verify this passkey.' }, 400);
+      const { credential, aaguid, credentialDeviceType, credentialBackedUp } = registrationInfo;
+      savePasskey({ ...credential, userId: user.id, rpId, aaguid, credentialDeviceType, credentialBackedUp,
+        name: 'My passkey', registeredAt: Date.now(), lastUsedAt: null });
+      return json({ success: true });
+    }
+    if (action === 'authenticate-verify' && challenge.purpose === 'authenticate') {
+      const key = typeof response?.id === 'string' ? findPasskey(response.id) : undefined;
+      if (!key || key.rpId !== rpId) return json({ error: 'This passkey is no longer registered.' }, 404);
+      if (response.response?.userHandle !== key.userId) return json({ error: 'Unable to verify this passkey.' }, 400);
+      const { verified, authenticationInfo } = await verifyAuthenticationResponse({
+        response, credential: key, expectedChallenge: challenge.challenge,
+        expectedOrigin: origin, expectedRPID: rpId, requireUserVerification: true,
+      });
+      if (!verified || !findAccount(key.userId) || !recordSignIn(key.id, key.counter, authenticationInfo.newCounter, authenticationInfo.credentialBackedUp)) {
+        return json({ error: 'Unable to verify this passkey.' }, 400);
+      }
+      await signIn(session, key.userId);
+      return json({ success: true });
+    }
+    return json({ error: 'Invalid passkey request.' }, 400);
+  } catch {
+    return json({ error: 'Unable to verify this passkey. Please try again.' }, 400);
+  }
+};
diff --git a/tests/passkeys.test.ts b/tests/passkeys.test.ts
new file mode 100644
index 0000000..0055ea2
--- /dev/null
+++ b/tests/passkeys.test.ts
@@ -0,0 +1,86 @@
+import { after, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { accountForUsername, listPasskeys, savePasskey, renamePasskey, deletePasskey, findPasskey, recordSignIn, updateDisplayName, findAccount } from '../src/lib/server/accounts';
+import { sameOrigin, signedInAccount } from '../src/lib/server/auth';
+import { syncPasskeys, syncUserDetails, type PasskeySettings } from '../src/lib/passkeys';
+
+const directory = mkdtempSync(join(tmpdir(), 'times-passkeys-'));
+process.env.ACCOUNT_DB_PATH = join(directory, 'accounts.sqlite');
+after(() => rmSync(directory, { recursive: true, force: true }));
+
+test('passkeys persist by account and RP; mutations cannot change another reader’s key', () => {
+  const alice = accountForUsername('alice');
+  const bob = accountForUsername('bob');
+  assert.equal(accountForUsername('alice').id, alice.id);
+  assert.match(alice.id, /^[A-Za-z0-9_-]+$/);
+  const key = { id: 'a2V5', userId: alice.id, rpId: 'example.com', publicKey: new Uint8Array([1, 2]),
+    counter: 0, name: 'Laptop', aaguid: '', registeredAt: Date.now(), lastUsedAt: null,
+    credentialDeviceType: 'multiDevice' as const, credentialBackedUp: true };
+  savePasskey(key);
+  assert.equal(listPasskeys(bob.id, key.rpId).length, 0);
+  assert.equal(listPasskeys(alice.id, 'different.example.com').length, 0);
+  assert.equal(renamePasskey(key.id, bob.id, key.rpId, 'Stolen'), false);
+  assert.equal(deletePasskey(key.id, bob.id, key.rpId), false);
+  assert.equal(deletePasskey(key.id, alice.id, 'wrong.example.com'), false);
+  assert.equal(renamePasskey(key.id, alice.id, key.rpId, 'Travel key'), true);
+  assert.equal(findPasskey(key.id)?.name, 'Travel key');
+  assert.equal(recordSignIn(key.id, 0, 1, true), true);
+  assert.equal(recordSignIn(key.id, 0, 2, true), false);
+  assert.ok(findPasskey(key.id)?.lastUsedAt);
+  updateDisplayName(alice.id, 'Alice Reader');
+  assert.equal(findAccount(alice.id)?.displayName, 'Alice Reader');
+  assert.equal(deletePasskey(key.id, alice.id, key.rpId), true);
+  assert.equal(findPasskey(key.id), undefined);
+  assert.deepEqual(listPasskeys(alice.id, key.rpId), []);
+  assert.equal(recordSignIn(key.id, 1, 2, true), false);
+});
+
+test('authentication requires a live server-side session and an existing account', async () => {
+  assert.equal(await signedInAccount(undefined), undefined);
+  const fakeSession = (value: unknown) => ({ get: async () => value }) as unknown as Parameters<typeof signedInAccount>[0];
+  const alice = accountForUsername('alice');
+  assert.equal(await signedInAccount(fakeSession({ userId: alice.id, expiresAt: 1 })), undefined);
+  assert.equal(await signedInAccount(fakeSession({ userId: 'missing', expiresAt: Date.now() + 10000 })), undefined);
+  assert.equal((await signedInAccount(fakeSession({ userId: alice.id, expiresAt: Date.now() + 10000 })))?.id, alice.id);
+});
+
+test('mutations reject missing and cross-origin requests', () => {
+  assert.equal(sameOrigin(new Request('https://example.com/api')), false);
+  assert.equal(sameOrigin(new Request('https://example.com/api', { headers: { Origin: 'https://attacker.com' } })), false);
+  assert.equal(sameOrigin(new Request('https://example.com/api', { headers: { Origin: 'https://example.com' } })), true);
+});
+
+const settings: PasskeySettings = { user: { id: 'dXNlcg', username: 'alice', displayName: 'Alice' }, rpId: 'example.com',
+  passkeys: [{ id: 'a2V5', name: 'Laptop', aaguid: '', registeredAt: 1, lastUsedAt: null }] };
+
+test('sync uses the complete server list and handles removing the final key', async () => {
+  const calls: unknown[] = [];
+  const api = { signalAllAcceptedCredentials: async (options: unknown) => { calls.push(options); } };
+  Object.assign(globalThis, { window: { PublicKeyCredential: api }, PublicKeyCredential: api });
+  await syncPasskeys(settings);
+  await syncPasskeys({ ...settings, passkeys: [] });
+  assert.deepEqual(calls, [
+    { rpId: 'example.com', userId: 'dXNlcg', allAcceptedCredentialIds: ['a2V5'] },
+    { rpId: 'example.com', userId: 'dXNlcg', allAcceptedCredentialIds: [] },
+  ]);
+});
+
+test('unsupported and rejected signals explain manual sync without failing saved changes', async () => {
+  Object.assign(globalThis, { window: {} });
+  assert.match(await syncPasskeys(settings), /manually/);
+  assert.match(await syncUserDetails(settings), /manually/);
+  const api = { signalAllAcceptedCredentials: async () => { throw new Error('unavailable'); } };
+  Object.assign(globalThis, { window: { PublicKeyCredential: api }, PublicKeyCredential: api });
+  assert.match(await syncPasskeys(settings), /settings are saved/);
+});
+
+test('account profile synchronization passes account names, not individual passkey nicknames', async () => {
+  const calls: unknown[] = [];
+  const api = { signalCurrentUserDetails: async (options: unknown) => { calls.push(options); } };
+  Object.assign(globalThis, { window: { PublicKeyCredential: api }, PublicKeyCredential: api });
+  await syncUserDetails(settings);
+  assert.deepEqual(calls, [{ rpId: 'example.com', userId: 'dXNlcg', name: 'alice', displayName: 'Alice' }]);
+});
