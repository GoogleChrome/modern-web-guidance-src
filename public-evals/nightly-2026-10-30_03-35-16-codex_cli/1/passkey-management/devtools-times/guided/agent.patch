diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..cdfbbba
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,58 @@
+export interface PasskeySummary {
+  id: string; name: string; aaguid: string; registeredAt: number; lastUsedAt: number | null;
+}
+export interface PasskeySettings {
+  user: { id: string; username: string; displayName: string };
+  rpId: string;
+  passkeys: PasskeySummary[];
+}
+
+export class RequestError extends Error {
+  constructor(message: string, public status: number) { super(message); }
+}
+
+export async function accountRequest<T>(path: string, method = 'GET', body?: unknown): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/account/${path}`, {
+    method, credentials: 'same-origin', cache: 'no-store',
+    headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const data = await response.json();
+  if (!response.ok) throw new RequestError(data.error || 'Unable to save your changes. Please try again.', response.status);
+  return data;
+}
+
+export async function syncPasskeys(settings: PasskeySettings): Promise<string> {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) {
+    return 'Your browser cannot automatically sync passkeys. You can remove unused keys from your password manager manually.';
+  }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: settings.rpId, userId: settings.user.id,
+      allAcceptedCredentialIds: settings.passkeys.map(key => key.id),
+    });
+    return 'Your browser has been notified of your current passkeys.';
+  } catch {
+    return 'Your settings are saved, but browser sync could not finish. Refresh to retry, or update your password manager manually.';
+  }
+}
+
+export async function syncUserDetails(settings: PasskeySettings): Promise<string> {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails) return 'Your display name is saved. Update it in your password manager manually if needed.';
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId: settings.rpId, userId: settings.user.id,
+      name: settings.user.username, displayName: settings.user.displayName,
+    });
+    return 'Your display name is saved and your browser has been notified.';
+  } catch { return 'Your display name is saved, but browser sync could not finish. Update your password manager manually if needed.'; }
+}
+
+export function passkeyError(error: unknown): string {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError' || error.name === 'AbortError') return 'The passkey request was cancelled or timed out. You can try again.';
+    if (error.name === 'InvalidStateError') return 'A passkey already exists in this authenticator. Try another device or security key.';
+    if (error.name === 'SecurityError') return 'Passkeys require a secure connection on the correct site domain.';
+  }
+  return error instanceof Error ? error.message : 'The passkey request could not be completed.';
+}
diff --git a/src/lib/server/accounts.ts b/src/lib/server/accounts.ts
new file mode 100644
index 0000000..0f85ddc
--- /dev/null
+++ b/src/lib/server/accounts.ts
@@ -0,0 +1,90 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { randomBytes } from 'node:crypto';
+import type { AuthenticatorTransport, WebAuthnCredential } from '@simplewebauthn/server';
+
+export interface Account { id: string; username: string; displayName: string }
+export interface Passkey extends WebAuthnCredential {
+  userId: string;
+  rpId: string;
+  name: string;
+  aaguid: string;
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  registeredAt: number;
+  lastUsedAt: number | null;
+}
+
+let database: DatabaseSync;
+function db() {
+  if (!database) {
+    const path = resolve(process.env.ACCOUNT_DB_PATH || '.data/accounts.sqlite');
+    mkdirSync(dirname(path), { recursive: true });
+    database = new DatabaseSync(path);
+    database.exec(`PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;
+      CREATE TABLE IF NOT EXISTS accounts (
+        id TEXT PRIMARY KEY, username TEXT NOT NULL UNIQUE, displayName TEXT NOT NULL
+      );
+      CREATE TABLE IF NOT EXISTS passkeys (
+        id TEXT PRIMARY KEY, userId TEXT NOT NULL REFERENCES accounts(id), rpId TEXT NOT NULL,
+        name TEXT NOT NULL, aaguid TEXT NOT NULL, publicKey BLOB NOT NULL,
+        counter INTEGER NOT NULL, transports TEXT NOT NULL,
+        registeredAt INTEGER NOT NULL, lastUsedAt INTEGER,
+        credentialDeviceType TEXT NOT NULL, credentialBackedUp INTEGER NOT NULL
+      );`);
+  }
+  return database;
+}
+
+export function findAccount(id: string): Account | undefined {
+  return db().prepare('SELECT * FROM accounts WHERE id = ?').get(id) as Account | undefined;
+}
+
+// Called only after the existing password service has authenticated this username.
+export function accountForUsername(username: string): Account {
+  db().prepare('INSERT OR IGNORE INTO accounts VALUES (?, ?, ?)')
+    .run(randomBytes(32).toString('base64url'), username, username);
+  return db().prepare('SELECT * FROM accounts WHERE username = ?').get(username) as unknown as Account;
+}
+
+export function updateDisplayName(userId: string, displayName: string) {
+  db().prepare('UPDATE accounts SET displayName = ? WHERE id = ?').run(displayName, userId);
+}
+
+function decode(row: Record<string, unknown>): Passkey {
+  return { ...row, publicKey: new Uint8Array(row.publicKey as Uint8Array), credentialBackedUp: Boolean(row.credentialBackedUp),
+    transports: JSON.parse(row.transports as string) as AuthenticatorTransport[] } as Passkey;
+}
+
+export function listPasskeys(userId: string, rpId: string): Passkey[] {
+  return db().prepare('SELECT * FROM passkeys WHERE userId = ? AND rpId = ? ORDER BY registeredAt DESC')
+    .all(userId, rpId).map(decode);
+}
+
+export function findPasskey(id: string): Passkey | undefined {
+  const row = db().prepare('SELECT * FROM passkeys WHERE id = ?').get(id);
+  return row ? decode(row) : undefined;
+}
+
+export function savePasskey(key: Passkey) {
+  db().prepare('INSERT INTO passkeys VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)')
+    .run(key.id, key.userId, key.rpId, key.name, key.aaguid, key.publicKey, key.counter,
+      JSON.stringify(key.transports || []), key.registeredAt, key.lastUsedAt,
+      key.credentialDeviceType, Number(key.credentialBackedUp));
+}
+
+export function renamePasskey(id: string, userId: string, rpId: string, name: string) {
+  return db().prepare('UPDATE passkeys SET name = ? WHERE id = ? AND userId = ? AND rpId = ?')
+    .run(name, id, userId, rpId).changes > 0;
+}
+
+export function deletePasskey(id: string, userId: string, rpId: string) {
+  return db().prepare('DELETE FROM passkeys WHERE id = ? AND userId = ? AND rpId = ?')
+    .run(id, userId, rpId).changes > 0;
+}
+
+export function recordSignIn(id: string, oldCounter: number, newCounter: number, backedUp: boolean) {
+  return db().prepare('UPDATE passkeys SET counter = ?, lastUsedAt = ?, credentialBackedUp = ? WHERE id = ? AND counter = ?')
+    .run(newCounter, Date.now(), Number(backedUp), id, oldCounter).changes > 0;
+}
diff --git a/src/lib/server/auth.ts b/src/lib/server/auth.ts
new file mode 100644
index 0000000..22c9485
--- /dev/null
+++ b/src/lib/server/auth.ts
@@ -0,0 +1,27 @@
+import type { APIContext } from 'astro';
+import { findAccount } from './accounts';
+
+export function json(data: unknown, status = 200) {
+  return Response.json(data, { status, headers: { 'Cache-Control': 'no-store' } });
+}
+
+export function sameOrigin(request: Request) {
+  return request.headers.get('origin') === new URL(request.url).origin;
+}
+
+export function relyingParty(url: URL) {
+  // Pin these in production when operating behind a reverse proxy.
+  const origin = process.env.WEBAUTHN_ORIGIN || url.origin;
+  return { origin, rpId: process.env.WEBAUTHN_RP_ID || new URL(origin).hostname };
+}
+
+export async function signedInAccount(session: APIContext['session']) {
+  const auth = await session?.get('accountAuth');
+  if (!auth || auth.expiresAt < Date.now()) return undefined;
+  return findAccount(auth.userId);
+}
+
+export async function signIn(session: NonNullable<APIContext['session']>, userId: string) {
+  await session.regenerate();
+  await session.set('accountAuth', { userId, expiresAt: Date.now() + 1000 * 60 * 60 * 24 });
+}
