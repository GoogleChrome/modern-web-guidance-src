diff --git a/src/components/PasskeySettings.tsx b/src/components/PasskeySettings.tsx
new file mode 100644
index 0000000..9beb0d3
--- /dev/null
+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,164 @@
+import { useEffect, useRef, useState } from 'react';
+import { FingerPrintIcon, KeyIcon, ShieldCheckIcon, ComputerDesktopIcon } from '@heroicons/react/24/outline';
+import { accountRequest, passkeyError, RequestError, syncPasskeys, syncUserDetails, type PasskeySettings as Settings } from '../lib/passkeys';
+import providers from '../lib/passkey-providers.json';
+
+const button = 'rounded border border-gray-300 px-4 py-2 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:opacity-50 disabled:cursor-not-allowed';
+const input = 'w-full rounded border border-gray-300 bg-white px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-gray-900';
+
+function date(value: number | null) {
+  return value === null ? 'Not used yet' : new Date(value).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+}
+
+export default function PasskeySettings() {
+  const [settings, setSettings] = useState<Settings | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const [syncNotice, setSyncNotice] = useState('');
+  const [unauthorized, setUnauthorized] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [canCreate, setCanCreate] = useState(false);
+  const [editing, setEditing] = useState<string | null>(null);
+  const [name, setName] = useState('');
+  const [displayName, setDisplayName] = useState('');
+  const [removing, setRemoving] = useState<string | null>(null);
+  const dialog = useRef<HTMLDialogElement>(null);
+  const cancelRemoval = useRef<HTMLButtonElement>(null);
+
+  function showError(cause: unknown) {
+    setError(passkeyError(cause));
+    if (cause instanceof RequestError && cause.status === 401) {
+      setUnauthorized(true);
+      setSettings(null);
+    }
+  }
+
+  async function load() {
+    setLoading(true);
+    setError('');
+    try {
+      const data = await accountRequest<Settings>('passkeys');
+      setSettings(data);
+      setDisplayName(data.user.displayName);
+      setUnauthorized(false);
+      setSyncNotice(await syncPasskeys(data));
+    } catch (cause) { showError(cause); }
+    finally { setLoading(false); }
+  }
+
+  useEffect(() => {
+    void load();
+    let active = true;
+    async function capabilities() {
+      if (!window.isSecureContext || !window.PublicKeyCredential) return;
+      await import('webauthn-polyfills');
+      const supported = await PublicKeyCredential.getClientCapabilities();
+      if (active) setCanCreate(Boolean(supported.passkeyPlatformAuthenticator || supported.userVerifyingPlatformAuthenticator));
+    }
+    void capabilities().catch(() => {});
+    return () => { active = false; };
+  }, []);
+
+  async function update(method: string, body: unknown, message: string) {
+    setBusy(true);
+    setError('');
+    setNotice('');
+    try {
+      const data = await accountRequest<Settings>('passkeys', method, body);
+      setSettings(data);
+      setNotice(message);
+      setEditing(null);
+      if (method === 'DELETE') setSyncNotice(await syncPasskeys(data));
+      if (method === 'PATCH') setSyncNotice(await syncUserDetails(data));
+    } catch (cause) { showError(cause); }
+    finally { setBusy(false); }
+  }
+
+  async function create() {
+    setBusy(true);
+    setError('');
+    setNotice('');
+    try {
+      await import('webauthn-polyfills');
+      const { options } = await accountRequest<{ options: PublicKeyCredentialCreationOptionsJSON }>('webauthn', 'POST', { action: 'register-options' });
+      const credential = await navigator.credentials.create({ publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(options) }) as PublicKeyCredential | null;
+      if (!credential) throw new Error('No passkey was created. Please try again.');
+      try {
+        await accountRequest('webauthn', 'POST', { action: 'register-verify', credential: credential.toJSON() });
+      } catch (cause) {
+        // A lost response can follow a successful save. Reconcile from the server
+        // instead of telling the authenticator to discard a possibly valid key.
+        try {
+          const current = await accountRequest<Settings>('passkeys');
+          setSettings(current);
+          setSyncNotice(await syncPasskeys(current));
+          if (current.passkeys.some(key => key.id === credential.id)) {
+            setNotice('Passkey created. You can rename it below.');
+            return;
+          }
+        } catch { /* Keep existing credentials untouched if the server is unreachable. */ }
+        throw cause;
+      }
+      const data = await accountRequest<Settings>('passkeys');
+      setSettings(data);
+      setNotice('Passkey created. You can give it a name to recognize it later.');
+      setSyncNotice(await syncPasskeys(data));
+    } catch (cause) { showError(cause); }
+    finally { setBusy(false); }
+  }
+
+  function confirmRemoval(id: string) {
+    setRemoving(id);
+    dialog.current?.showModal();
+    cancelRemoval.current?.focus();
+  }
+
+  return (
+    <div className="space-y-8">
+      <div role="alert">{error && <div className="rounded border border-red-200 bg-red-50 p-4 text-sm text-red-800">{error}</div>}</div>
+      <div role="status" aria-live="polite">{notice && <p className="rounded border border-green-200 bg-green-50 p-4 text-sm text-green-900">{notice}</p>}</div>
+      {loading && <p role="status" className="text-gray-600">Loading your account settings…</p>}
+      {unauthorized && <a className={button} href={`${import.meta.env.BASE_URL}signin`}>Sign in to continue</a>}
+      {!loading && !settings && !unauthorized && <button className={button} onClick={load}>Try again</button>}
+      {settings && <>
+        <section aria-labelledby="profile-title" className="rounded-lg border border-gray-200 bg-white p-6">
+          <h2 id="profile-title" className="text-xl font-bold">Reader profile</h2>
+          <p className="mt-1 text-sm text-gray-500">Signed in as <span className="font-medium text-gray-800">{settings.user.username}</span></p>
+          <form className="mt-5 flex max-w-lg flex-wrap items-end gap-3" onSubmit={event => { event.preventDefault(); void update('PATCH', { name: displayName }, 'Display name updated.'); }}>
+            <div className="min-w-0 flex-1"><label htmlFor="display-name" className="mb-2 block text-sm font-medium">Display name</label><input id="display-name" autoComplete="nickname" className={input} value={displayName} onChange={e => setDisplayName(e.target.value)} required maxLength={80} disabled={busy} /></div>
+            <button className={button} disabled={busy || !displayName.trim() || displayName.trim() === settings.user.displayName}>Save name</button>
+          </form>
+        </section>
+        <section aria-labelledby="passkeys-title" className="overflow-hidden rounded-lg border border-gray-200 bg-white">
+          <div className="flex flex-wrap items-start justify-between gap-4 border-b border-gray-200 p-6">
+            <div className="max-w-lg"><div className="flex items-center gap-2"><FingerPrintIcon className="h-6 w-6" aria-hidden="true" /><h2 id="passkeys-title" className="text-xl font-bold">Passkeys</h2><span className="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold">{settings.passkeys.length}</span></div><p className="mt-2 text-sm leading-6 text-gray-600">Sign in securely with your fingerprint, face, screen lock, or security key. Manage the passkeys connected to your account.</p></div>
+            {canCreate && <button className={`${button} bg-gray-900 text-white hover:bg-gray-700`} disabled={busy} onClick={create}>Create passkey</button>}
+          </div>
+          {settings.passkeys.length === 0 ? <div className="px-6 py-12 text-center"><KeyIcon className="mx-auto mb-4 h-10 w-10 text-gray-400" aria-hidden="true" /><h3 className="font-semibold">No passkeys yet</h3><p className="mx-auto mt-2 max-w-sm text-sm leading-6 text-gray-600">{canCreate ? 'Create your first passkey for a faster, more secure way to sign in.' : 'You can continue signing in with your password. Use a browser and device that support passkeys to create one.'}</p></div> :
+          <ul className="divide-y divide-gray-200">{settings.passkeys.map(key => {
+            const provider = (providers as Record<string, { name: string; icon: string }>)[key.aaguid];
+            return <li key={key.id} className="flex flex-wrap items-start gap-4 p-6">
+              <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-gray-50">{provider?.icon ? <img src={provider.icon} alt="" className="h-7 w-7" /> : <ComputerDesktopIcon className="h-6 w-6 text-gray-600" aria-hidden="true" />}</div>
+              <div className="min-w-0 flex-1">
+                {editing === key.id ? <form onSubmit={event => { event.preventDefault(); void update('PUT', { id: key.id, name }, 'Passkey name updated.'); }} className="max-w-md space-y-3">
+                  <label htmlFor="passkey-name" className="block text-sm font-medium">Passkey display name</label><input id="passkey-name" autoFocus className={input} value={name} onChange={e => setName(e.target.value)} required maxLength={80} disabled={busy} />
+                  <div className="flex gap-2"><button className={button} disabled={busy || !name.trim()}>Save</button><button type="button" className={button} disabled={busy} onClick={() => setEditing(null)}>Cancel</button></div>
+                </form> : <h3 className="break-words font-semibold">{key.name}</h3>}
+                <p className="mt-1 text-sm text-gray-500">{provider?.name || 'Unknown passkey provider'}</p>
+                <div className="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-xs text-gray-500"><span>Added {date(key.registeredAt)}</span><span>Last used: {date(key.lastUsedAt)}</span></div>
+              </div>
+              <div className="flex gap-2"><button className={button} disabled={busy || editing !== null} aria-label={`Rename ${key.name}`} onClick={() => { setEditing(key.id); setName(key.name); }}>Rename</button><button className={`${button} text-red-700 hover:bg-red-50`} disabled={busy} aria-label={`Remove ${key.name}`} onClick={() => confirmRemoval(key.id)}>Remove</button></div>
+            </li>;
+          })}</ul>}
+          <div className="flex gap-3 border-t border-gray-200 bg-gray-50 p-5 text-xs leading-5 text-gray-600"><ShieldCheckIcon className="mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" /><div><p>Passkey names help you recognize your keys here. Removing a passkey prevents it from signing in to this account. You can still use your password.</p><p className="mt-1" role="status">{syncNotice}</p></div></div>
+        </section>
+      </>}
+      <dialog ref={dialog} onClose={() => setRemoving(null)} className="fixed inset-0 m-auto w-[calc(100%_-_2rem)] max-w-md rounded-lg border border-gray-200 bg-white p-6 shadow-xl backdrop:bg-black/40" aria-labelledby="remove-title" aria-describedby="remove-description">
+        <h2 id="remove-title" className="text-xl font-bold">Remove this passkey?</h2>
+        <p id="remove-description" className="mt-3 text-sm leading-6 text-gray-600">“{settings?.passkeys.find(key => key.id === removing)?.name}” will no longer be able to sign in. Make sure you can use your password or another passkey before continuing.</p>
+        <div className="mt-6 flex justify-end gap-3"><button ref={cancelRemoval} className={button} onClick={() => dialog.current?.close()}>Cancel</button><button className={`${button} bg-red-700 text-white hover:bg-red-800`} onClick={() => { const id = removing; dialog.current?.close(); if (id) void update('DELETE', { id }, 'Passkey removed.'); }}>Remove passkey</button></div>
+      </dialog>
+    </div>
+  );
+}
