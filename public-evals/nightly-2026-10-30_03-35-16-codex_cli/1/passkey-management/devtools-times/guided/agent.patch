diff --git a/src/pages/api/account/login.ts b/src/pages/api/account/login.ts
new file mode 100644
index 0000000..48b171a
--- /dev/null
+++ b/src/pages/api/account/login.ts
@@ -0,0 +1,29 @@
+import type { APIRoute } from 'astro';
+import { accountForUsername } from '../../../lib/server/accounts';
+import { json, sameOrigin, signIn } from '../../../lib/server/auth';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Invalid request origin.' }, 403);
+  if (!session) return json({ error: 'Sign-in is unavailable.' }, 503);
+  try {
+    const { username, password } = await request.json();
+    if (typeof username !== 'string' || !username.trim() || username.length > 200 ||
+        typeof password !== 'string' || !password || password.length > 1000) {
+      return json({ error: 'Enter your username and password.' }, 400);
+    }
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: username.trim(), password }), signal: AbortSignal.timeout(10000),
+    });
+    if (!response.ok) return json({ error: 'Unable to sign in. Check your username and password.' }, 401);
+    const data = await response.json();
+    // Prefer the password service's canonical username when available.
+    const canonicalName = data.user?.username ?? data.username ?? username.trim();
+    if (typeof canonicalName !== 'string' || !canonicalName) return json({ error: 'Invalid sign-in response.' }, 502);
+    const account = accountForUsername(canonicalName);
+    await signIn(session, account.id);
+    return json({ success: true });
+  } catch {
+    return json({ error: 'Sign-in is unavailable. Please try again.' }, 503);
+  }
+};
