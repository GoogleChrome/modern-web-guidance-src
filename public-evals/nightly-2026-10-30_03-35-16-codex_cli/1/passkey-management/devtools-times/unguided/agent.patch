--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,69 @@
+export interface Passkey {
+  id: string;
+  displayName: string;
+  createdAt?: string;
+  lastUsedAt?: string | null;
+}
+
+export interface PasskeyAccount {
+  rpId: string;
+  user: { id: string; name: string; displayName: string };
+  passkeys: Passkey[];
+}
+
+const isBase64url = (value: unknown): value is string =>
+  typeof value === 'string' && /^[A-Za-z0-9_-]+$/.test(value);
+
+// Never send an unvalidated or partial credential list to an authenticator.
+export function parsePasskeyAccount(value: unknown): PasskeyAccount {
+  const data = value as PasskeyAccount;
+  if (!data || typeof data.rpId !== 'string' || !data.rpId ||
+      !data.user || !isBase64url(data.user.id) ||
+      typeof data.user.name !== 'string' || typeof data.user.displayName !== 'string' ||
+      !Array.isArray(data.passkeys) || data.passkeys.some(key =>
+        !key || !isBase64url(key.id) || typeof key.displayName !== 'string')) {
+    throw new Error('The passkey service returned an invalid response. Please try again later.');
+  }
+  return data;
+}
+
+type SignalAPI = {
+  signalAllAcceptedCredentials?: (options: {
+    rpId: string; userId: string; allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+  signalCurrentUserDetails?: (options: {
+    rpId: string; userId: string; name: string; displayName: string;
+  }) => Promise<void>;
+  signalUnknownCredential?: (options: { rpId: string; credentialId: string }) => Promise<void>;
+};
+
+export async function syncAuthenticator(account: PasskeyAccount, removedId?: string) {
+  const api: SignalAPI | undefined = typeof PublicKeyCredential === 'undefined'
+    ? undefined : PublicKeyCredential as unknown as SignalAPI;
+  if (!api) return 'This browser cannot sync passkey changes. Manage saved copies in your password manager.';
+  const signals: Promise<void>[] = [];
+  // Schedule calls separately so a rejected signal does not prevent other updates.
+  if (removedId && api.signalUnknownCredential) {
+    signals.push(Promise.resolve().then(() => api.signalUnknownCredential!({ rpId: account.rpId, credentialId: removedId })));
+  }
+  if (api.signalAllAcceptedCredentials) {
+    signals.push(Promise.resolve().then(() => api.signalAllAcceptedCredentials!({
+      rpId: account.rpId, userId: account.user.id,
+      allAcceptedCredentialIds: account.passkeys.map(key => key.id),
+    })));
+  }
+  if (api.signalCurrentUserDetails) {
+    signals.push(Promise.resolve().then(() => api.signalCurrentUserDetails!({
+      rpId: account.rpId, userId: account.user.id,
+      name: account.user.name, displayName: account.user.displayName,
+    })));
+  }
+  const results = await Promise.allSettled(signals);
+  if (results.some(result => result.status === 'rejected')) {
+    return 'Your account is up to date, but browser sync failed. Manage saved copies in your password manager or retry sync.';
+  }
+  if (!api.signalAllAcceptedCredentials || !api.signalCurrentUserDetails) {
+    return 'This browser has limited passkey sync support. You may need to update saved copies in your password manager.';
+  }
+  return 'Passkey details shared with your browser. Your password manager controls when changes are applied.';
+}
