@@ -0,0 +1,37 @@
+export const ACCOUNT_API = import.meta.env.PUBLIC_ACCOUNT_API_URL ||
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+const TOKEN_KEY = 'devtools-times-session';
+
+export function getToken() {
+  return sessionStorage.getItem(TOKEN_KEY);
+}
+
+export function saveToken(token: string) {
+  sessionStorage.setItem(TOKEN_KEY, token);
+}
+
+export class SignInRequired extends Error {}
+
+export async function accountRequest(path: string, init: RequestInit = {}) {
+  const token = getToken();
+  if (!token) throw new SignInRequired('Please sign in to manage your passkeys.');
+  const response = await fetch(`${ACCOUNT_API}${path}`, {
+    ...init,
+    cache: 'no-store',
+    headers: {
+      ...init.headers,
+      Authorization: `Bearer ${token}`,
+      ...(init.body ? { 'Content-Type': 'application/json' } : {}),
+    },
+  });
+  if (response.status === 401) {
+    sessionStorage.removeItem(TOKEN_KEY);
+    throw new SignInRequired('Your session has expired. Please sign in again.');
+  }
+  if (response.status === 404 && path === '/passkeys') {
+    throw new Error('Passkey management is not available from the account service yet. Please try again later.');
+  }
+  if (!response.ok) throw new Error('Unable to update your account. Please try again.');
+  return response;
+}
