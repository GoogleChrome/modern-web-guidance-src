+import { useEffect, useState } from 'react';
+import { FingerPrintIcon, KeyIcon, ShieldCheckIcon } from '@heroicons/react/24/outline';
+import { accountRequest, SignInRequired } from '../lib/account';
+import { syncAuthenticator, type PasskeyAccount } from '../lib/passkeys';
+import { loadPasskeys } from '../lib/passkey-api';
+
+function dateLabel(value?: string | null) {
+  if (!value || Number.isNaN(Date.parse(value))) return 'Not available';
+  return new Date(value).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
+}
+
+export default function PasskeySettings() {
+  const [account, setAccount] = useState<PasskeyAccount | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [signedOut, setSignedOut] = useState(false);
+  const [notice, setNotice] = useState('');
+  const [syncNotice, setSyncNotice] = useState('');
+  const [editing, setEditing] = useState<string | null>(null);
+  const [name, setName] = useState('');
+  const [removing, setRemoving] = useState<string | null>(null);
+
+  function handleError(err: unknown) {
+    if (err instanceof SignInRequired) {
+      setSignedOut(true);
+      setAccount(null);
+    }
+    setError(err instanceof Error ? err.message : 'Something went wrong. Please try again.');
+  }
+
+  async function refresh() {
+    setLoading(true);
+    setError('');
+    setSyncNotice('');
+    try {
+      const next = await loadPasskeys();
+      setAccount(next);
+      setSignedOut(false);
+      setSyncNotice(await syncAuthenticator(next));
+    } catch (err) { handleError(err); }
+    finally { setLoading(false); }
+  }
+
+  useEffect(() => { void refresh(); }, []);
+
+  async function mutate(id: string, action: 'rename' | 'remove') {
+    if (!account || busy) return;
+    setBusy(true);
+    setError('');
+    setNotice('');
+    setSyncNotice('');
+    let saved = false;
+    try {
+      await accountRequest(`/passkeys/${encodeURIComponent(id)}`, action === 'rename'
+        ? { method: 'PATCH', body: JSON.stringify({ displayName: name.trim() }) }
+        : { method: 'DELETE' });
+      saved = true;
+      // Commit the successful account change even if refreshing later fails.
+      setAccount({ ...account, passkeys: action === 'remove'
+        ? account.passkeys.filter(key => key.id !== id)
+        : account.passkeys.map(key => key.id === id ? { ...key, displayName: name.trim() } : key) });
+      setEditing(null);
+      setRemoving(null);
+      setNotice(action === 'rename' ? 'Passkey name updated.' : 'Passkey removed. It can no longer be used to sign in.');
+      // Fetch the complete authoritative list before signaling accepted credentials.
+      const next = await loadPasskeys();
+      setAccount(next);
+      setSyncNotice(await syncAuthenticator(next, action === 'remove' ? id : undefined));
+    } catch (err) {
+      if (saved && !(err instanceof SignInRequired)) {
+        setError('Your change was saved, but we could not refresh or sync your passkeys. Retry to get the latest details.');
+      } else handleError(err);
+    } finally { setBusy(false); }
+  }
+
+  return (
+    <div className="mx-auto max-w-5xl px-5 py-10 sm:px-10 sm:py-14">
+      <div className="mb-9 border-b border-gray-200 pb-8">
+        <p className="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">Your reader account</p>
+        <h1 className="font-brand text-4xl sm:text-5xl">Account settings</h1>
+        <p className="mt-3 text-sm text-gray-600">A little housekeeping for a safer reading experience.</p>
+      </div>
+      <div className="grid gap-8 md:grid-cols-[180px_1fr] md:gap-12">
+        <aside aria-label="Settings sections">
+          <p className="mb-4 text-xs font-semibold uppercase tracking-widest text-gray-500">Settings</p>
+          <a href="#passkeys" aria-current="page" className="flex items-center gap-3 rounded-md bg-gray-100 px-3 py-3 text-sm font-semibold text-gray-900">
+            <ShieldCheckIcon className="h-5 w-5" /> Sign-in & security
+          </a>
+          <a href={import.meta.env.BASE_URL} className="mt-5 inline-block px-3 text-xs text-gray-500 hover:underline">← Back to the Times</a>
+        </aside>
+        <section id="passkeys" aria-labelledby="passkeys-title" aria-busy={loading || busy}>
+          <div className="mb-6 flex items-start gap-4">
+            <div className="rounded-full bg-emerald-50 p-3 text-emerald-900"><FingerPrintIcon className="h-7 w-7" /></div>
+            <div><h2 id="passkeys-title" className="font-brand text-3xl">Passkeys</h2>
+              <p className="mt-1 text-sm leading-6 text-gray-600">A secure way to sign in, using your fingerprint, face, or device screen lock.</p>
+            </div>
+          </div>
+
+          {error && <div role="alert" className="mb-5 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800">
+            <p>{error}</p>
+            {signedOut ? <a className="mt-2 inline-block font-semibold underline" href={`${import.meta.env.BASE_URL}signin`}>Sign in to continue →</a>
+              : <button type="button" disabled={busy || loading} onClick={() => void refresh()} className="mt-2 font-semibold underline disabled:opacity-50">Retry</button>}
+          </div>}
+          <div role="status" aria-live="polite">
+            {notice && <p className="mb-4 rounded-md bg-emerald-50 p-3 text-sm text-emerald-900">{notice}</p>}
+          </div>
+          {loading && <p role="status" className="rounded-lg border border-gray-200 p-6 text-sm text-gray-500">Loading your passkeys…</p>}
+          {!loading && account && <>
+            <div className="mb-3 flex items-center justify-between gap-3">
+              <h3 className="text-xs font-semibold uppercase tracking-widest text-gray-500">Registered passkeys <span className="ml-1 text-gray-900">({account.passkeys.length})</span></h3>
+              <button type="button" disabled={busy} onClick={() => void refresh()} className="text-xs font-semibold underline underline-offset-4 disabled:opacity-50">Refresh & sync</button>
+            </div>
+            {account.passkeys.length === 0 ? <div className="rounded-lg border border-dashed border-gray-300 px-6 py-10 text-center">
+              <KeyIcon className="mx-auto mb-3 h-8 w-8 text-gray-400" />
+              <h3 className="font-semibold">No registered passkeys</h3>
+              <p className="mt-2 text-sm text-gray-500">Passkeys registered to your account will appear here.</p>
+            </div> : <ul className="divide-y divide-gray-200 overflow-hidden rounded-lg border border-gray-200">
+              {account.passkeys.map(key => <li key={key.id} className="p-5 sm:p-6">
+                <div className="flex items-start gap-3">
+                  <KeyIcon className="mt-1 h-5 w-5 shrink-0 text-gray-500" />
+                  <div className="min-w-0 flex-1">
+                    {editing === key.id ? <form onSubmit={event => { event.preventDefault(); void mutate(key.id, 'rename'); }}>
+                      <label htmlFor="passkey-name" className="mb-2 block text-sm font-semibold">Passkey display name</label>
+                      <input id="passkey-name" autoFocus maxLength={64} required value={name} disabled={busy} onChange={event => setName(event.target.value)} className="w-full rounded border border-gray-400 px-3 py-2 text-sm focus:outline-2 focus:outline-emerald-800" />
+                      <div className="mt-3 flex gap-4">
+                        <button disabled={busy || !name.trim()} className="rounded bg-gray-900 px-4 py-2 text-xs font-semibold text-white disabled:opacity-50">{busy ? 'Saving…' : 'Save name'}</button>
+                        <button type="button" disabled={busy} onClick={() => setEditing(null)} className="text-xs font-semibold">Cancel</button>
+                      </div>
+                    </form> : <>
+                      <h4 className="break-words text-sm font-semibold text-gray-900">{key.displayName || 'Unnamed passkey'}</h4>
+                      <p className="mt-2 text-xs leading-5 text-gray-500">Added {dateLabel(key.createdAt)}<br />Last used {dateLabel(key.lastUsedAt)}</p>
+                      {removing !== key.id && <div className="mt-4 flex gap-5 text-xs font-semibold">
+                        <button type="button" disabled={busy} aria-label={`Rename ${key.displayName || 'passkey'}`} onClick={() => { setEditing(key.id); setName(key.displayName); setRemoving(null); }} className="underline underline-offset-4 disabled:opacity-50">Rename</button>
+                        <button type="button" disabled={busy} aria-label={`Remove ${key.displayName || 'passkey'}`} onClick={() => { setRemoving(key.id); setEditing(null); }} className="text-red-700 underline underline-offset-4 disabled:opacity-50">Remove</button>
+                      </div>}
+                    </>}
+                    {removing === key.id && <div className="mt-4 rounded-md bg-red-50 p-4">
+                      <p className="text-sm font-semibold text-red-900">Remove this passkey?</p>
+                      <p className="mt-1 text-xs leading-5 text-red-800">You won’t be able to sign in with it again. Make sure you can use your password or another passkey.{account.passkeys.length === 1 ? ' This is your last registered passkey.' : ''}</p>
+                      <div className="mt-3 flex gap-4">
+                        <button type="button" disabled={busy} onClick={() => void mutate(key.id, 'remove')} className="rounded bg-red-700 px-3 py-2 text-xs font-semibold text-white disabled:opacity-50">{busy ? 'Removing…' : 'Yes, remove passkey'}</button>
+                        <button type="button" disabled={busy} onClick={() => setRemoving(null)} className="text-xs font-semibold">Cancel</button>
+                      </div>
+                    </div>}
+                  </div>
+                </div>
+              </li>)}
+            </ul>}
+            <p className="mt-3 text-xs leading-5 text-gray-500">Display names help you recognize your passkeys here. They don’t change the account name shown by your password manager.</p>
+            {syncNotice && <p role="status" className="mt-4 text-xs leading-5 text-gray-600">{syncNotice}</p>}
+          </>}
+          <div className="mt-8 border-t border-gray-200 pt-6">
+            <div className="flex gap-2 text-sm font-semibold"><ShieldCheckIcon className="h-5 w-5 text-emerald-800" /> Your security, in your hands</div>
+            <p className="mt-2 text-xs leading-6 text-gray-500">Your fingerprint and face data stay on your device. When supported, we share your latest passkey details with your browser to help keep your password manager up to date.</p>
+          </div>
+        </section>
+      </div>
+    </div>
+  );
+}
