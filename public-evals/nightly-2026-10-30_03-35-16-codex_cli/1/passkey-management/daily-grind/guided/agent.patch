+++ b/account.js
@@ -0,0 +1,231 @@
+const $ = (id) => document.getElementById(id);
+const endpoint = '/api/account/passkeys';
+const storageKey = 'daily-grind:demo-passkeys:v1';
+const seed = [
+  { id: 'demo-macbook', name: 'My MacBook', provider: 'iCloud Keychain', kind: 'laptop', registeredAt: Date.UTC(2026, 8, 12), lastUsedAt: Date.UTC(2026, 9, 30) },
+  { id: 'demo-phone', name: 'My iPhone', provider: 'iCloud Keychain', kind: 'phone', registeredAt: Date.UTC(2026, 8, 12), lastUsedAt: Date.UTC(2026, 9, 28) },
+  { id: 'demo-security-key', name: 'Work security key', provider: 'Security key', kind: 'key', registeredAt: Date.UTC(2026, 7, 24), lastUsedAt: Date.UTC(2026, 9, 15) },
+];
+const icons = {
+  laptop: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M1 20h22M9 17v3m6-3v3"/>',
+  phone: '<rect x="6" y="2" width="12" height="20" rx="3"/><path d="M10 5h4m-3 14h2"/>',
+  key: '<rect x="7" y="3" width="10" height="18" rx="4"/><circle cx="12" cy="15" r="2"/><path d="M10 3V1m4 2V1"/>',
+};
+let state;
+let demo = false;
+let selectedId;
+let busy = false;
+let syncAttempt = 0;
+const dateFormatter = new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'short', year: 'numeric' });
+const date = (timestamp) => Number.isFinite(timestamp) && !Number.isNaN(new Date(timestamp).valueOf()) ? dateFormatter.format(timestamp) : 'Not available';
+function node(tag, className, text) {
+  const element = document.createElement(tag);
+  if (className) element.className = className;
+  if (text !== undefined) element.textContent = text;
+  return element;
+}
+function validateSnapshot(data) {
+  const base64url = /^[A-Za-z0-9_-]+$/;
+  if (!data || data.authenticated !== true || data.complete !== true || !data.user ||
+      typeof data.user.id !== 'string' || !base64url.test(data.user.id) || typeof data.rpId !== 'string' ||
+      !(location.hostname === data.rpId || location.hostname.endsWith(`.${data.rpId}`)) ||
+      typeof data.csrfToken !== 'string' || !data.csrfToken || !Array.isArray(data.credentials) ||
+      data.credentials.some(key => !key || typeof key.id !== 'string' || !base64url.test(key.id) || typeof key.name !== 'string') ||
+      new Set(data.credentials.map(key => key.id)).size !== data.credentials.length) {
+    throw new Error('We couldn’t verify your passkey list. Please try again.');
+  }
+  return data;
+}
+async function request(url, options = {}) {
+  const response = await fetch(url, { ...options, credentials: 'same-origin', cache: 'no-store', headers: {
+    Accept: 'application/json', ...(options.method ? { 'Content-Type': 'application/json', 'X-CSRF-Token': state.csrfToken } : {}),
+  }});
+  if (response.status === 401 || response.status === 403) throw new Error('Your session has expired or access was denied. Please sign in again to manage your passkeys.');
+  // This checkout is a static site. Demo mode is never used for an authentication or server error.
+  if (!options.method && (response.status === 404 || (response.ok && response.headers.get('content-type')?.includes('text/html')))) return null;
+  if (!response.ok) throw new Error('We couldn’t save this change. Please try again.');
+  return validateSnapshot(await response.json());
+}
+function readDemo() {
+  try {
+    const saved = JSON.parse(localStorage.getItem(storageKey));
+    if (Array.isArray(saved) && saved.length <= seed.length && saved.every(key => seed.some(item => item.id === key.id) && typeof key.name === 'string' && key.name.trim().length > 0 && key.name.length <= 64) && new Set(saved.map(key => key.id)).size === saved.length) {
+      return saved.map(key => ({ ...seed.find(item => item.id === key.id), name: key.name }));
+    }
+  } catch { /* Storage can be unavailable in private browsing. */ }
+  return seed.map(key => ({ ...key }));
+}
+function render() {
+  $('demo-notice').hidden = !demo;
+  $('key-count').textContent = state.credentials.length;
+  $('member-name').textContent = state.user.displayName || 'Coffee lover';
+  const list = $('passkey-list');
+  list.replaceChildren();
+  list.setAttribute('aria-busy', 'false');
+  if (!state.credentials.length) {
+    const empty = node('div', 'list-message');
+    empty.append(node('strong', '', 'No passkeys registered'), node('p', '', 'There are no passkeys connected to this account. Use your other sign-in method to return.'));
+    list.append(empty);
+  }
+  for (const key of state.credentials) {
+    const row = node('div', 'passkey-row');
+    const icon = node('div', 'provider-icon');
+    icon.setAttribute('aria-hidden', 'true');
+    // The icon markup is a local, fixed set; server labels are always rendered as text.
+    icon.innerHTML = `<svg viewBox="0 0 24 24">${icons[key.kind] || icons.key}</svg>`;
+    const info = node('div', 'key-info');
+    const title = node('div', 'key-title');
+    title.append(node('h4', '', key.name || key.provider || 'Passkey'));
+    const dates = node('div', 'key-dates');
+    dates.append(node('span', '', `Added ${date(key.registeredAt)}`), node('span', '', key.lastUsedAt ? `Last used ${date(key.lastUsedAt)}` : 'Not used yet'));
+    info.append(title, node('p', 'key-provider', key.provider || 'Unknown passkey provider'), dates);
+    const actions = node('div', 'row-actions');
+    for (const [action, label, path] of [
+      ['rename', 'Rename', '<path d="m15 4 5 5M4 15 15 4a3 3 0 0 1 5 5L9 20H4z"/>'],
+      ['delete', 'Remove', '<path d="M3 6h18M9 6V3h6v3M6 6l1 15h10l1-15M10 10v7m4-7v7"/>'],
+    ]) {
+      const button = node('button', action === 'delete' ? 'remove' : '', label);
+      button.type = 'button';
+      button.setAttribute('aria-label', `${label} ${key.name}`);
+      button.dataset.action = action;
+      button.dataset.id = key.id;
+      button.insertAdjacentHTML('afterbegin', `<svg viewBox="0 0 24 24" aria-hidden="true">${path}</svg>`);
+      actions.append(button);
+    }
+    row.append(icon, info, actions);
+    list.append(row);
+  }
+}
+async function syncAccepted() {
+  const attempt = ++syncAttempt;
+  $('retry-sync').hidden = true;
+  if (demo) {
+    $('sync-status').textContent = 'In your live account, removing a passkey also updates supported browsers and password managers. Preview changes don’t touch your saved credentials.';
+    return;
+  }
+  if (!window.isSecureContext || typeof window.PublicKeyCredential?.signalAllAcceptedCredentials !== 'function') {
+    $('sync-status').textContent = 'Your account is up to date. This browser doesn’t support automatic passkey updates. You may also need to remove unused passkeys in your device or password manager settings.';
+    return;
+  }
+  $('sync-status').textContent = 'Updating your browser’s saved sign-in options…';
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId: state.rpId, userId: state.user.id, allAcceptedCredentialIds: state.credentials.map(key => key.id) });
+    if (attempt !== syncAttempt) return;
+    $('sync-status').textContent = 'Your account and this browser’s supported passkey provider are up to date. Other password managers may need to be updated separately.';
+  } catch {
+    if (attempt !== syncAttempt) return;
+    $('sync-status').textContent = 'Your account changes are saved, but we couldn’t update your browser’s passkey provider. Retry or remove the saved key in your password manager settings.';
+    $('retry-sync').hidden = false;
+  }
+}
+async function load() {
+  $('load-error').hidden = true;
+  $('passkey-list').setAttribute('aria-busy', 'true');
+  $('passkey-list').replaceChildren(node('p', 'list-message', 'Loading your passkeys…'));
+  try {
+    const data = await request(endpoint);
+    demo = data === null;
+    state = data || { user: { displayName: 'Coffee lover' }, credentials: readDemo() };
+    render();
+    await syncAccepted();
+  } catch (error) {
+    $('passkey-list').replaceChildren();
+    $('passkey-list').setAttribute('aria-busy', 'false');
+    $('load-error-text').textContent = error.message;
+    $('load-error').hidden = false;
+    $('sync-status').textContent = 'Your browser’s saved passkeys haven’t been changed.';
+  }
+}
+$('passkey-list').addEventListener('click', (event) => {
+  const button = event.target.closest('button[data-action]');
+  if (!button || busy) return;
+  const key = state.credentials.find(item => item.id === button.dataset.id);
+  if (!key) return;
+  selectedId = key.id;
+  if (button.dataset.action === 'rename') {
+    $('rename-error').textContent = '';
+    $('passkey-name').value = key.name;
+    $('passkey-name').setCustomValidity('');
+    $('rename-dialog').showModal();
+    $('passkey-name').select();
+  } else {
+    $('delete-error').textContent = '';
+    $('delete-name').textContent = key.name;
+    $('delete-warning').textContent = state.credentials.length === 1
+      ? 'This is your last passkey. Make sure you have another way to sign in before removing it.'
+      : 'Your other passkeys will still work. You can keep using them to sign in.';
+    $('delete-dialog').showModal();
+  }
+});
+$('passkey-name').addEventListener('input', () => $('passkey-name').setCustomValidity(''));
+for (const dialog of document.querySelectorAll('dialog')) {
+  dialog.querySelector('[data-close]').addEventListener('click', () => { if (!busy) dialog.close(); });
+  dialog.addEventListener('cancel', (event) => { if (busy) event.preventDefault(); });
+}
+async function saveChange(action, event) {
+  event.preventDefault();
+  if (busy) return;
+  const key = state.credentials.find(item => item.id === selectedId);
+  if (!key) return;
+  const name = $('passkey-name').value.trim();
+  if (action === 'rename' && !name) {
+    $('passkey-name').setCustomValidity('Enter a name for this passkey.');
+    $('passkey-name').reportValidity();
+    return;
+  }
+  const dialog = $(`${action}-dialog`);
+  const submit = dialog.querySelector('[type="submit"]');
+  const previousLabel = submit.textContent;
+  busy = true;
+  for (const button of dialog.querySelectorAll('button')) button.disabled = true;
+  $('passkey-name').disabled = true;
+  submit.textContent = action === 'rename' ? 'Saving…' : 'Removing…';
+  $(`${action}-error`).textContent = '';
+  try {
+    if (demo) {
+      const next = action === 'rename' ? state.credentials.map(item => item.id === key.id ? { ...item, name } : item) : state.credentials.filter(item => item.id !== key.id);
+      // Persist first: a failed write must not look like a successful save.
+      localStorage.setItem(storageKey, JSON.stringify(next));
+      state = { ...state, credentials: next };
+    } else {
+      state = await request(`${endpoint}/${encodeURIComponent(key.id)}`, { method: action === 'rename' ? 'PUT' : 'DELETE', ...(action === 'rename' ? { body: JSON.stringify({ name }) } : {}) });
+    }
+    dialog.close();
+    render();
+    // A rename only changes the account's label, not the authenticator's user profile.
+    $('action-status').textContent = `${action === 'rename' ? `Passkey renamed to “${name}”.` : `“${key.name}” was removed.`}${demo ? ' Demo changes saved on this browser.' : ''}`;
+    if (action === 'rename') {
+      Array.from($('passkey-list').querySelectorAll('button')).find(button => button.dataset.id === key.id && button.dataset.action === 'rename')?.focus();
+    } else {
+      const nextButton = $('passkey-list').querySelector('button');
+      if (nextButton) nextButton.focus();
+      else { $('passkeys-title').tabIndex = -1; $('passkeys-title').focus(); }
+      await syncAccepted();
+    }
+  } catch (error) {
+    $(`${action}-error`).textContent = demo ? 'We couldn’t save the demo change. Allow browser storage and try again.' : `${error.message} Refresh your passkeys before trying again if the connection was interrupted.`;
+  } finally {
+    busy = false;
+    for (const button of dialog.querySelectorAll('button')) button.disabled = false;
+    $('passkey-name').disabled = false;
+    submit.textContent = previousLabel;
+  }
+}
+$('rename-form').addEventListener('submit', event => saveChange('rename', event));
+$('delete-form').addEventListener('submit', event => saveChange('delete', event));
+$('retry-load').addEventListener('click', load);
+$('retry-sync').addEventListener('click', async () => {
+  $('retry-sync').hidden = true;
+  // Refresh the authoritative full list before retrying; never signal a stale snapshot.
+  await load();
+});
+$('reset-demo').addEventListener('click', () => {
+  if (!demo || busy) return;
+  try {
+    localStorage.removeItem(storageKey);
+    state.credentials = seed.map(key => ({ ...key }));
+    render();
+    $('action-status').textContent = 'Sample passkeys restored.';
+  } catch { $('action-status').textContent = 'Browser storage is unavailable. Your demo couldn’t be reset.'; }
+});
+load();
