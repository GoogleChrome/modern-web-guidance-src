+const $ = (selector) => document.querySelector(selector);
+const endpoint = '/api/account/passkeys';
+const icons = { platform: 'i-laptop', phone: 'i-phone', securityKey: 'i-usb' };
+const previewStorageKey = 'daily-grind.passkeys-preview.v1';
+const previewKeys = [
+  { id: 'preview-mac', name: 'MacBook Pro', provider: 'iCloud Keychain', deviceType: 'platform', createdAt: '2026-09-12T10:00:00Z', lastUsedAt: new Date().toISOString(), current: true },
+  { id: 'preview-phone', name: 'iPhone', provider: 'iCloud Keychain', deviceType: 'phone', createdAt: '2026-09-12T10:00:00Z', lastUsedAt: new Date(Date.now() - 86400000 * 2).toISOString(), current: false },
+  { id: 'preview-usb', name: 'YubiKey 5', provider: 'Security key', deviceType: 'securityKey', createdAt: '2026-08-28T10:00:00Z', lastUsedAt: new Date(Date.now() - 86400000 * 14).toISOString(), current: false },
+];
+let snapshot = null;
+let preview = false;
