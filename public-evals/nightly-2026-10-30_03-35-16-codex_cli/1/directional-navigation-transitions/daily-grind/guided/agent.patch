+  <script>
+    const cards = [...document.querySelectorAll('#seasonal-items .card')];
+    const controls = document.querySelector('.seasonal-controls');
+    const previous = document.querySelector('#seasonal-previous');
+    const next = document.querySelector('#seasonal-next');
+    const status = document.querySelector('#seasonal-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let currentIndex = 0;
+    let changing = false;
+    let activeMotion;
+
+    controls.hidden = false;
+
+    async function changeItem(step) {
+      if (changing) return;
+
+      const update = () => {
+        cards[currentIndex].hidden = true;
+        currentIndex = (currentIndex + step + cards.length) % cards.length;
+        cards[currentIndex].hidden = false;
+        status.textContent = `${currentIndex + 1} of ${cards.length} — ${cards[currentIndex].querySelector('h3').textContent}`;
+      };
+
+      if (reducedMotion.matches) {
+        update();
+        return;
+      }
+
+      changing = true;
+      previous.setAttribute('aria-disabled', 'true');
+      next.setAttribute('aria-disabled', 'true');
+
+      try {
+        if (document.startViewTransition &&
+            CSS.supports('selector(:active-view-transition-type(forward))')) {
+          activeMotion = document.startViewTransition({
+            update,
+            types: [step > 0 ? 'forward' : 'backward']
+          });
+          await activeMotion.finished;
+        } else {
+          update();
+          // Keep directional entry in browsers without typed View Transitions.
+          if (cards[currentIndex].animate) {
+            activeMotion = cards[currentIndex].animate([
+              { transform: `translateX(${step > 0 ? '100%' : '-100%'})` },
+              { transform: 'translateX(0)' }
+            ], { duration: 280, easing: 'ease' });
+            await activeMotion.finished;
+          }
+        }
+      } catch (error) {
+        // Cancelling motion must not prevent subsequent navigation.
+        if (error.name !== 'AbortError') console.error(error);
+      } finally {
+        changing = false;
+        activeMotion = undefined;
+        previous.removeAttribute('aria-disabled');
+        next.removeAttribute('aria-disabled');
+      }
+    }
+
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) {
+        activeMotion?.skipTransition?.();
+        activeMotion?.cancel?.();
+      }
+    });
+
+    previous.addEventListener('click', () => changeItem(-1));
+    next.addEventListener('click', () => changeItem(1));
+  </script>
