+  <script>
+    const favorites = Array.from(document.querySelectorAll('#favorites-items .card'));
+    const position = document.getElementById('favorites-position');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let currentFavorite = 0;
+    let favoriteAnimation;
+
+    function showFavorite(direction) {
+      favoriteAnimation?.cancel();
+      favorites[currentFavorite].hidden = true;
+      currentFavorite = (currentFavorite + direction + favorites.length) % favorites.length;
+      const incoming = favorites[currentFavorite];
+      incoming.hidden = false;
+      position.textContent = `${currentFavorite + 1} / ${favorites.length}`;
+
+      if (!reducedMotion.matches) {
+        favoriteAnimation = incoming.animate(
+          [
+            { transform: `translateX(${direction * 100}%)`, opacity: 0 },
+            { transform: 'translateX(0)', opacity: 1 }
+          ],
+          { duration: 350, easing: 'ease-out' }
+        );
+      }
+    }
+
+    document.getElementById('favorites-next').addEventListener('click', () => showFavorite(1));
+    document.getElementById('favorites-previous').addEventListener('click', () => showFavorite(-1));
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) favoriteAnimation?.cancel();
+    });
+  </script>
