diff --git a/src/components/TopStoriesSlider.astro b/src/components/TopStoriesSlider.astro
new file mode 100644
index 0000000..81f85de
--- /dev/null
+++ b/src/components/TopStoriesSlider.astro
@@ -0,0 +1,106 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+<top-stories-slider class="block bg-white border-b border-gray-300" role="region" aria-roledescription="carousel" aria-label="Top stories">
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+        <div class="overflow-hidden">
+            {articles.map((article, index) => (
+                <div data-story hidden={index !== 0} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${articles.length}`}>
+                    <a href={`${import.meta.env.BASE_URL}articles/${article.id}`} class="inline-block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500">
+                        <h3 class="font-bold text-gray-900 hover:text-amber-400">{article.data.title}</h3>
+                    </a>
+                    <time datetime={article.data.date.toISOString()} class="block text-xs text-gray-500">{article.data.date.toLocaleDateString()}</time>
+                </div>
+            ))}
+        </div>
+        <div data-controls hidden class="mt-3">
+            <div class="flex items-center gap-3">
+                <button type="button" data-previous class="border border-gray-300 rounded px-3 py-1 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500">Previous</button>
+                <span data-position class="text-xs text-gray-500" aria-hidden="true">1 / {articles.length}</span>
+                <button type="button" data-next class="border border-gray-300 rounded px-3 py-1 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500">Next</button>
+            </div>
+        </div>
+        <p data-announcement class="sr-only" aria-live="polite" aria-atomic="true"></p>
+    </div>
+</top-stories-slider>
+
+<style>
+    [data-story][hidden] {
+        display: none;
+    }
+
+    [data-story][data-direction='next'] {
+        animation: slide-in-next 300ms ease-out;
+    }
+
+    [data-story][data-direction='previous'] {
+        animation: slide-in-previous 300ms ease-out;
+    }
+
+    @keyframes slide-in-next {
+        from { transform: translateX(100%); }
+        to { transform: translateX(0); }
+    }
+
+    @keyframes slide-in-previous {
+        from { transform: translateX(-100%); }
+        to { transform: translateX(0); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        [data-story][data-direction] {
+            animation: none;
+        }
+    }
+</style>
+
+<script>
+    class TopStoriesSlider extends HTMLElement {
+        private index = 0;
+        private controller?: AbortController;
+
+        connectedCallback() {
+            this.controller?.abort();
+            this.controller = new AbortController();
+            const { signal } = this.controller;
+            const stories = Array.from(this.querySelectorAll<HTMLElement>('[data-story]'));
+            const controls = this.querySelector<HTMLElement>('[data-controls]');
+            const position = this.querySelector<HTMLElement>('[data-position]');
+            const announcement = this.querySelector<HTMLElement>('[data-announcement]');
+
+            if (stories.length < 2 || !controls) return;
+            controls.hidden = false;
+
+            const navigate = (direction: 'next' | 'previous') => {
+                const current = stories[this.index];
+                current.hidden = true;
+                delete current.dataset.direction;
+                this.index = (this.index + (direction === 'next' ? 1 : -1) + stories.length) % stories.length;
+                const incoming = stories[this.index];
+                incoming.dataset.direction = direction;
+                incoming.hidden = false;
+
+                if (position) position.textContent = `${this.index + 1} / ${stories.length}`;
+                if (announcement) announcement.textContent = `Story ${this.index + 1} of ${stories.length}: ${incoming.querySelector('h3')?.textContent ?? ''}`;
+            };
+
+            this.querySelector('[data-next]')?.addEventListener('click', () => navigate('next'), { signal });
+            this.querySelector('[data-previous]')?.addEventListener('click', () => navigate('previous'), { signal });
+        }
+
+        disconnectedCallback() {
+            this.controller?.abort();
+        }
+    }
+
+    if (!customElements.get('top-stories-slider')) {
+        customElements.define('top-stories-slider', TopStoriesSlider);
+    }
+</script>
