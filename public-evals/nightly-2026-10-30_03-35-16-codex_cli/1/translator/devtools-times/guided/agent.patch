+---
+const languages = [
+  ['en', 'English (original)'], ['ar', 'العربية · Arabic'],
+  ['zh', '中文 · Chinese'], ['nl', 'Nederlands · Dutch'],
+  ['fr', 'Français · French'], ['de', 'Deutsch · German'],
+  ['hi', 'हिन्दी · Hindi'], ['it', 'Italiano · Italian'],
+  ['ja', '日本語 · Japanese'], ['ko', '한국어 · Korean'],
+  ['pl', 'Polski · Polish'], ['pt', 'Português · Portuguese'],
+  ['es', 'Español · Spanish'], ['tr', 'Türkçe · Turkish'],
+  ['uk', 'Українська · Ukrainian'],
+];
+---
+<article-translation hidden class="border-b border-amber-200 bg-amber-50 px-4 py-4 md:px-6">
+  <div class="flex flex-wrap items-end gap-3">
+    <div class="grow">
+      <p class="font-brand text-xl text-gray-900">Read in your language</p>
+      <p id="translation-help" class="text-sm text-gray-700">Translate articles and teasers on this page, on your device. First use may download a language pack.</p>
+    </div>
+    <div>
+      <label for="translation-language" class="block text-sm font-semibold text-gray-800 mb-1">Read in</label>
+      <select id="translation-language" name="language" aria-describedby="translation-help translation-status" disabled class="min-h-12 max-w-full rounded border border-gray-500 bg-white px-3 text-base">
+        {languages.map(([code, name]) => <option value={code}>{name}</option>)}
+      </select>
+    </div>
+    <button type="button" data-start disabled class="min-h-12 rounded bg-gray-800 px-4 text-white font-semibold hover:bg-gray-700 disabled:opacity-50">Translate</button>
+    <button type="button" data-restore disabled class="min-h-12 rounded border border-gray-500 px-4 text-gray-800 hover:bg-white disabled:opacity-50">Show original</button>
+  </div>
+  <p id="translation-status" role="status" class="mt-2 text-sm text-gray-700">Choose a language to translate from English.</p>
+  <div data-progress hidden class="mt-2 text-sm text-gray-700">
+    <label for="translation-progress" data-progress-label>Preparing translation…</label>
+    <progress id="translation-progress" max="1" class="block w-full mt-1 accent-amber-800"></progress>
+  </div>
+</article-translation>
+<style>
+  article-translation { display: block; }
+  article-translation[hidden] { display: none; }
+</style>
+<script>
+  import '../scripts/translation';
+</script>
