diff --git a/src/scripts/translation.ts b/src/scripts/translation.ts
new file mode 100644
index 0000000..fa85595
--- /dev/null
+++ b/src/scripts/translation.ts
@@ -0,0 +1,194 @@
+type LanguagePair = { sourceLanguage: string; targetLanguage: string };
+type LocalTranslator = {
+  translate(text: string, options: { signal: AbortSignal }): Promise<string>;
+  destroy(): void;
+};
+type TranslatorAPI = {
+  availability(options: LanguagePair): Promise<'available' | 'downloadable' | 'downloading' | 'unavailable'>;
+  create(options: LanguagePair & {
+    signal: AbortSignal;
+    monitor(monitor: { addEventListener(type: 'downloadprogress', callback: (event: { loaded: number }) => void): void }): void;
+  }): Promise<LocalTranslator>;
+};
+
+// A custom element gives every Astro page its own state and releases models on navigation.
+class ArticleTranslation extends HTMLElement {
+  private lifecycle = new AbortController();
+  private operation?: AbortController;
+  private roots: { element: HTMLElement; lang: string | null; dir: string | null }[] = [];
+  private originals = new Map<Text, string>();
+  private checkVersion = 0;
+  private pair?: LanguagePair;
+  private api?: TranslatorAPI;
+  private select!: HTMLSelectElement;
+  private start!: HTMLButtonElement;
+  private restore!: HTMLButtonElement;
+  private status!: HTMLElement;
+  private progressArea!: HTMLElement;
+  private progress!: HTMLProgressElement;
+  private progressLabel!: HTMLElement;
+
+  connectedCallback() {
+    // The parser may connect the element before the rest of the page is available.
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', () => this.initialize(), { once: true, signal: this.lifecycle.signal });
+    } else this.initialize();
+  }
+
+  private initialize() {
+    this.roots = Array.from(document.querySelectorAll<HTMLElement>('[data-translate]')).map(element => ({
+      element, lang: element.getAttribute('lang'), dir: element.getAttribute('dir'),
+    }));
+    if (!this.roots.length) return;
+    this.hidden = false;
+    this.select = this.querySelector('select')!;
+    this.start = this.querySelector('[data-start]')!;
+    this.restore = this.querySelector('[data-restore]')!;
+    this.status = this.querySelector('[role="status"]')!;
+    this.progressArea = this.querySelector('[data-progress]')!;
+    this.progress = this.querySelector('progress')!;
+    this.progressLabel = this.querySelector('[data-progress-label]')!;
+    this.api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+    if (!this.api || !window.isSecureContext) {
+      this.status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop browser such as Chrome. You can still read the English originals.';
+      return;
+    }
+    for (const { element } of this.roots) {
+      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
+        acceptNode: node => node.textContent?.trim() && !node.parentElement?.closest('script, style, code, pre, button, select, textarea, input, svg, [translate="no"], [hidden]')
+          ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT,
+      });
+      let node: Node | null;
+      while ((node = walker.nextNode())) this.originals.set(node as Text, node.textContent!);
+    }
+    this.select.disabled = false;
+    const options = { signal: this.lifecycle.signal };
+    this.select.addEventListener('change', () => void this.checkAvailability(), options);
+    this.start.addEventListener('click', () => void this.translate(), options);
+    this.restore.addEventListener('click', () => this.showOriginal(), options);
+  }
+
+  private async checkAvailability() {
+    const version = ++this.checkVersion;
+    this.pair = undefined;
+    this.start.disabled = true;
+    const targetLanguage = this.select.value;
+    if (targetLanguage === 'en') {
+      this.start.disabled = false;
+      this.status.textContent = 'English is the original language. Choose Translate or Show original to restore it.';
+      return;
+    }
+    this.status.textContent = 'Checking this language on your device…';
+    const pair = { sourceLanguage: 'en', targetLanguage };
+    try {
+      const availability = await this.api!.availability(pair);
+      if (version !== this.checkVersion || !this.isConnected) return;
+      if (availability === 'unavailable') {
+        this.status.textContent = 'This language is unavailable on your device. Choose another language.';
+        return;
+      }
+      this.pair = pair;
+      this.start.disabled = false;
+      this.status.textContent = availability === 'available'
+        ? 'Ready to translate on your device.'
+        : 'Choose Translate to download the language pack. An internet connection is needed for the download.';
+    } catch {
+      if (version === this.checkVersion && this.isConnected) {
+        this.status.textContent = 'Could not check language support. Choose a language again to retry.';
+      }
+    }
+  }
+
+  private async translate() {
+    if (this.select.value === 'en') { this.showOriginal(); return; }
+    if (!this.api || !this.pair || this.operation) return;
+    const pair = this.pair;
+    const operation = new AbortController();
+    this.operation = operation;
+    this.select.disabled = this.start.disabled = true;
+    this.restore.disabled = false;
+    this.progressArea.hidden = false;
+    this.progress.removeAttribute('value');
+    this.progressLabel.textContent = 'Preparing translation…';
+    this.status.textContent = '';
+    let translator: LocalTranslator | undefined;
+    try {
+      // Availability was checked on selection, so create runs directly in the click gesture.
+      translator = await this.api.create({
+        ...pair,
+        signal: operation.signal,
+        monitor: monitor => monitor.addEventListener('downloadprogress', event => {
+          if (operation.signal.aborted) return;
+          const loaded = Math.min(1, Math.max(0, event.loaded));
+          this.progress.value = loaded;
+          this.progressLabel.textContent = `Downloading language pack: ${Math.round(loaded * 100)}%`;
+        }),
+      });
+      operation.signal.throwIfAborted();
+      const results = new Map<Text, string>();
+      const cache = new Map<string, string>();
+      let completed = 0;
+      for (const [node, original] of this.originals) {
+        operation.signal.throwIfAborted();
+        const text = original.trim();
+        let translated = cache.get(text);
+        if (translated === undefined) {
+          translated = await translator.translate(text, { signal: operation.signal });
+          if (!translated.trim()) throw new Error('Empty translation');
+          cache.set(text, translated);
+        }
+        // Retain whitespace around inline elements and never insert model output as HTML.
+        results.set(node, original.replace(text, () => translated!));
+        this.progress.value = ++completed / this.originals.size;
+        this.progressLabel.textContent = `Translating articles and teasers: ${Math.round(this.progress.value * 100)}%`;
+      }
+      operation.signal.throwIfAborted();
+      // Commit together: failed or cancelled requests leave the current reading intact.
+      for (const [node, translated] of results) node.data = translated;
+      for (const { element } of this.roots) {
+        element.lang = pair.targetLanguage;
+        element.dir = pair.targetLanguage === 'ar' ? 'rtl' : 'ltr';
+      }
+      this.status.textContent = `Translated to ${this.select.selectedOptions[0].textContent} on your device. Machine translations may contain mistakes.`;
+    } catch (error) {
+      if (!operation.signal.aborted) {
+        this.status.textContent = error instanceof DOMException && error.name === 'NotAllowedError'
+          ? 'Translation could not start. Choose Translate again to allow the language pack download.'
+          : 'Translation failed. Your current text is unchanged. Check your connection if a download is needed, then try again.';
+      }
+    } finally {
+      translator?.destroy();
+      if (this.operation === operation) {
+        this.operation = undefined;
+        this.progressArea.hidden = true;
+        this.select.disabled = this.start.disabled = false;
+      }
+    }
+  }
+
+  private showOriginal() {
+    this.operation?.abort();
+    this.operation = undefined;
+    ++this.checkVersion;
+    for (const [node, original] of this.originals) node.data = original;
+    for (const { element, lang, dir } of this.roots) {
+      if (lang === null) element.removeAttribute('lang'); else element.lang = lang;
+      if (dir === null) element.removeAttribute('dir'); else element.dir = dir;
+    }
+    this.select.value = 'en';
+    this.pair = undefined;
+    this.select.disabled = false;
+    this.start.disabled = true;
+    this.restore.disabled = true;
+    this.progressArea.hidden = true;
+    this.status.textContent = 'Showing the original English articles and teasers.';
+  }
+
+  disconnectedCallback() {
+    ++this.checkVersion;
+    this.operation?.abort();
+    this.lifecycle.abort();
+  }
+}
+
+if (!customElements.get('article-translation')) customElements.define('article-translation', ArticleTranslation);
