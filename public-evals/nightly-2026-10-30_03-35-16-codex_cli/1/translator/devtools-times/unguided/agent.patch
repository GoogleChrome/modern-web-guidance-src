diff --git a/src/scripts/article-translation.ts b/src/scripts/article-translation.ts
new file mode 100644
index 0000000..a70c5f9
--- /dev/null
+++ b/src/scripts/article-translation.ts
@@ -0,0 +1,191 @@
+type Availability = 'available' | 'downloadable' | 'downloading' | 'unavailable';
+type TranslationSession = { translate(text: string): Promise<string>; destroy(): void };
+type LanguagePair = { sourceLanguage: string; targetLanguage: string };
+type TranslatorAPI = {
+  availability(pair: LanguagePair): Promise<Availability>;
+  create(options: LanguagePair & {
+    signal: AbortSignal;
+    monitor: (monitor: { addEventListener(type: 'downloadprogress', callback: (event: { loaded: number }) => void): void }) => void;
+  }): Promise<TranslationSession>;
+};
+
+class ArticleTranslation extends HTMLElement {
+  private originals: { node: Text; text: string }[] = [];
+  private roots: { element: HTMLElement; lang: string | null; dir: string | null }[] = [];
+  private session?: TranslationSession;
+  private controller?: AbortController;
+  private revision = 0;
+  private checkRevision = 0;
+  private busy = false;
+  private currentLanguage = 'en';
+  private select!: HTMLSelectElement;
+  private translateButton!: HTMLButtonElement;
+  private restoreButton!: HTMLButtonElement;
+  private status!: HTMLElement;
+  private api?: TranslatorAPI;
+
+  connectedCallback() {
+    // Wait for the rest of the document on both initial load and Astro navigation.
+    document.addEventListener('astro:page-load', this.initialize);
+    if (document.readyState !== 'loading') this.initialize();
+    else document.addEventListener('DOMContentLoaded', this.initialize, { once: true });
+  }
+
+  disconnectedCallback() {
+    document.removeEventListener('astro:page-load', this.initialize);
+    document.removeEventListener('DOMContentLoaded', this.initialize);
+    this.cancel();
+  }
+
+  private initialize = () => {
+    this.select = this.querySelector('select')!;
+    this.translateButton = this.querySelector('[data-translate]')!;
+    this.restoreButton = this.querySelector('[data-restore]')!;
+    this.status = this.querySelector('[role="status"]')!;
+    this.hidden = !document.querySelector('[data-translation-content]');
+    if (this.hidden) return;
+    this.api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+    this.translateButton.onclick = () => void this.translateArticles();
+    this.restoreButton.onclick = () => this.restore();
+    this.select.onchange = () => void this.checkAvailability();
+    void this.checkAvailability();
+  };
+
+  private async checkAvailability() {
+    const check = ++this.checkRevision;
+    this.translateButton.disabled = true;
+    if (!this.api || !window.isSecureContext) {
+      this.status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop browser, such as Chrome, over HTTPS.';
+      return;
+    }
+    if (this.select.value === 'en') {
+      this.translateButton.disabled = this.busy || this.currentLanguage === 'en';
+      this.status.textContent = this.currentLanguage === 'en'
+        ? 'You are reading the English original. Choose another language to translate.'
+        : 'English is the original language. Select Translate to restore the original.';
+      return;
+    }
+    this.status.textContent = 'Checking language availability…';
+    try {
+      const availability = await this.api.availability({ sourceLanguage: 'en', targetLanguage: this.select.value });
+      if (check !== this.checkRevision || !this.isConnected) return;
+      this.translateButton.disabled = this.busy || availability === 'unavailable';
+      this.status.textContent = availability === 'unavailable'
+        ? 'This language is unavailable on your device. Please choose another language.'
+        : availability === 'available'
+          ? 'Ready to translate on your device. Original language: English.'
+          : 'First use downloads a language pack. Translation runs on your device. Original language: English.';
+    } catch {
+      if (check === this.checkRevision && this.isConnected) this.status.textContent = 'Could not check language availability. Choose a language to try again.';
+    }
+  }
+
+  private captureOriginals() {
+    if (this.roots.length) return;
+    document.querySelectorAll<HTMLElement>('[data-translation-content]').forEach(element => {
+      this.roots.push({ element, lang: element.getAttribute('lang'), dir: element.getAttribute('dir') });
+      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
+        acceptNode: node => node.textContent?.trim() && !node.parentElement?.closest('script, style, code, pre, [translate="no"], [data-translation-ignore]')
+          ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT,
+      });
+      while (walker.nextNode()) {
+        const node = walker.currentNode as Text;
+        this.originals.push({ node, text: node.data });
+      }
+    });
+  }
+
+  private cancel() {
+    ++this.revision;
+    ++this.checkRevision;
+    this.controller?.abort();
+    this.session?.destroy();
+    this.session = undefined;
+    this.busy = false;
+  }
+
+  private restore() {
+    this.cancel();
+    for (const { node, text } of this.originals) node.data = text;
+    for (const { element, lang, dir } of this.roots) {
+      if (lang === null) element.removeAttribute('lang'); else element.setAttribute('lang', lang);
+      if (dir === null) element.removeAttribute('dir'); else element.setAttribute('dir', dir);
+    }
+    this.currentLanguage = 'en';
+    this.select.disabled = false;
+    this.restoreButton.hidden = true;
+    this.translateButton.textContent = 'Translate ↗';
+    this.translateButton.removeAttribute('aria-busy');
+    void this.checkAvailability();
+  }
+
+  private async translateArticles() {
+    if (this.busy || !this.api) return;
+    const targetLanguage = this.select.value;
+    if (targetLanguage === 'en') { this.restore(); return; }
+    this.captureOriginals();
+    const revision = ++this.revision;
+    ++this.checkRevision;
+    this.controller = new AbortController();
+    this.busy = true;
+    this.select.disabled = true;
+    this.translateButton.disabled = true;
+    this.translateButton.textContent = 'Translating…';
+    this.restoreButton.hidden = false;
+    this.translateButton.setAttribute('aria-busy', 'true');
+    this.status.textContent = 'Preparing on-device translation…';
+    let session: TranslationSession | undefined;
+    try {
+      // Call create directly from the click so language downloads retain user activation.
+      session = await this.api.create({
+        sourceLanguage: 'en', targetLanguage, signal: this.controller.signal,
+        monitor: monitor => monitor.addEventListener('downloadprogress', event => {
+          if (revision === this.revision) this.status.textContent = `Downloading language pack… ${Math.round(event.loaded * 100)}%`;
+        }),
+      });
+      if (revision !== this.revision || !this.isConnected) return;
+      this.session = session;
+      const cache = new Map<string, string>();
+      const results: string[] = [];
+      for (const [index, { text }] of this.originals.entries()) {
+        if (revision !== this.revision) return;
+        const source = text.trim();
+        let translated = cache.get(source);
+        if (translated === undefined) {
+          translated = await session.translate(source);
+          if (revision !== this.revision || !this.isConnected) return;
+          cache.set(source, translated);
+        }
+        results.push(text.replace(source, () => translated!));
+        this.status.textContent = `Translating articles and headlines… ${Math.round((index + 1) / this.originals.length * 100)}%`;
+      }
+      if (revision !== this.revision || !this.isConnected) return;
+      // Commit together so failed or cancelled jobs leave the previous reading intact.
+      this.originals.forEach(({ node }, index) => { node.data = results[index]; });
+      this.roots.forEach(({ element }) => {
+        element.lang = targetLanguage;
+        element.dir = targetLanguage === 'ar' ? 'rtl' : 'ltr';
+      });
+      this.currentLanguage = targetLanguage;
+      this.status.textContent = `Translated to ${this.select.selectedOptions[0].textContent} on your device. AI translations may contain errors.`;
+    } catch (error) {
+      if (revision !== this.revision) return;
+      this.status.textContent = error instanceof DOMException && error.name === 'NotAllowedError'
+        ? 'Your browser could not start translation. Select Translate again to allow the language pack download.'
+        : 'Translation could not finish. Your article is unchanged. Select Translate to try again or choose another language.';
+    } finally {
+      session?.destroy();
+      if (revision === this.revision) {
+        this.session = undefined;
+        this.busy = false;
+        this.select.disabled = false;
+        this.translateButton.disabled = false;
+        this.translateButton.textContent = 'Translate ↗';
+        this.restoreButton.hidden = this.currentLanguage === 'en';
+        this.translateButton.removeAttribute('aria-busy');
+      }
+    }
+  }
+}
+
+if (!customElements.get('article-translation')) customElements.define('article-translation', ArticleTranslation);
