diff --git a/translation.js b/translation.js
new file mode 100644
index 0000000..73dceb5
--- /dev/null
+++ b/translation.js
@@ -0,0 +1,140 @@
+(() => {
+  const select = document.getElementById('menu-language');
+  const button = document.getElementById('translate-button');
+  const restore = document.getElementById('restore-english');
+  const status = document.getElementById('translation-status');
+  const nodes = [...document.querySelectorAll('[data-translate]')];
+  // Always translate from the originals, never from an earlier translation.
+  const originals = nodes.map(node => node.textContent);
+  const cache = new Map([['en', originals]]);
+  let revision = 0;
+  let options;
+  let controller;
+  let currentLanguage = 'en';
+
+  function show(texts, language) {
+    nodes.forEach((node, index) => {
+      node.textContent = texts[index];
+      node.lang = language;
+      node.dir = language === 'ar' ? 'rtl' : 'ltr';
+    });
+    currentLanguage = language;
+  }
+
+  function restoreEnglish() {
+    revision++;
+    controller?.abort();
+    controller = undefined;
+    options = undefined;
+    show(originals, 'en');
+    select.value = 'en';
+    select.disabled = false;
+    button.disabled = true;
+    restore.disabled = true;
+    status.textContent = 'English originals are shown.';
+  }
+
+  if (!('Translator' in window) || !window.isSecureContext) {
+    status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop browser such as Chrome over a secure connection. English originals are shown.';
+    return;
+  }
+
+  select.disabled = false;
+  status.textContent = 'English originals are shown. Choose a language to get started.';
+  restore.addEventListener('click', restoreEnglish);
+
+  select.addEventListener('change', async () => {
+    const request = ++revision;
+    const language = select.value;
+    options = undefined;
+    button.disabled = true;
+    if (language === 'en') {
+      restoreEnglish();
+      return;
+    }
+    if (cache.has(language)) {
+      button.disabled = false;
+      status.textContent = 'This translation is ready on your device. Select Translate on device to show it.';
+      return;
+    }
+    const pair = { sourceLanguage: 'en', targetLanguage: language };
+    status.textContent = 'Checking on-device language availability…';
+    try {
+      const availability = await window.Translator.availability(pair);
+      if (request !== revision) return;
+      if (availability === 'unavailable') {
+        status.textContent = 'This language is unavailable on your device. Choose another language; the displayed text has not changed.';
+        return;
+      }
+      options = pair;
+      button.disabled = false;
+      status.textContent = availability === 'available'
+        ? 'Ready to translate on your device.'
+        : 'Select Translate on device to download the language pack and translate. An internet connection is needed for the download.';
+    } catch {
+      if (request !== revision) return;
+      status.textContent = 'Could not check this language. Choose another language or reselect this one to try again.';
+    }
+  });
+
+  button.addEventListener('click', async () => {
+    const language = select.value;
+    if (language === 'en') return;
+    if (cache.has(language)) {
+      show(cache.get(language), language);
+      restore.disabled = false;
+      status.textContent = `Coffee descriptions and story are now in ${select.selectedOptions[0].textContent}.`;
+      return;
+    }
+    if (!options) return;
+    const request = ++revision;
+    controller = new AbortController();
+    select.disabled = true;
+    button.disabled = true;
+    restore.disabled = false;
+    let translator;
+    let lastProgress = -1;
+    status.textContent = 'Preparing on-device translation…';
+    try {
+      // Call create directly from the click: downloads require user activation.
+      translator = await window.Translator.create({
+        ...options,
+        signal: controller.signal,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', event => {
+            if (request !== revision) return;
+            const percent = Math.round(event.loaded * 100);
+            // Limit live-region announcements while a language pack downloads.
+            const step = Math.floor(percent / 10) * 10;
+            if (step !== lastProgress) {
+              lastProgress = step;
+              status.textContent = `Downloading language pack: ${step}%. You can restore English to cancel.`;
+            }
+          });
+        }
+      });
+      if (request !== revision) return;
+      status.textContent = 'Translating coffee descriptions and story on your device…';
+      const translated = [];
+      for (const original of originals) {
+        translated.push(await translator.translate(original));
+        if (request !== revision) return;
+      }
+      // Apply only a complete result so failures never leave mixed languages.
+      cache.set(language, translated);
+      show(translated, language);
+      status.textContent = `Coffee descriptions and story are now in ${select.selectedOptions[0].textContent}.`;
+    } catch {
+      if (request !== revision) return;
+      status.textContent = 'Translation could not finish. Your displayed text has not changed. Check your connection and try again, or restore English.';
+    } finally {
+      translator?.destroy();
+      if (request === revision) {
+        controller = undefined;
+        select.disabled = false;
+        button.disabled = false;
+        restore.disabled = currentLanguage === 'en';
+      }
+    }
+  });
+})();
