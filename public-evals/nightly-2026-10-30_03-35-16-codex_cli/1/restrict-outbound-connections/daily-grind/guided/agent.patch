diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..633abad
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,147 @@
+import { createServer } from 'node:http';
+import { randomBytes } from 'node:crypto';
+import { appendFile, mkdir, readFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const homepage = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+// Explicit routes keep source files and customer data out of the static server.
+const assets = new Map([
+  ['/styles.css', ['text/css; charset=utf-8', await readFile(new URL('./styles.css', import.meta.url))]],
+  ['/newsletter.js', ['text/javascript; charset=utf-8', await readFile(new URL('./newsletter.js', import.meta.url))]],
+]);
+const dataDirectory = resolve(process.env.NEWSLETTER_DATA_DIR || fileURLToPath(new URL('./data', import.meta.url)));
+const successMessage = 'You’re on the list! Thanks for signing up for Daily Grind news.';
+
+function securityHeaders(res, nonce) {
+  // Applied to every response, including any script requested as a worker.
+  // Redirects and WebRTC remain blocked by the allowlist defaults.
+  res.setHeader('Connection-Allowlist', '(response-origin "https://images.unsplash.com"); report-to=connections');
+  res.setHeader('Reporting-Endpoints', 'connections="/api/security-reports"');
+  res.setHeader('Content-Security-Policy', [
+    "default-src 'none'",
+    `script-src 'nonce-${nonce}' 'report-sample'`,
+    "script-src-attr 'none'",
+    "style-src 'self'",
+    "img-src 'self' https://images.unsplash.com",
+    "connect-src 'self'",
+    "form-action 'self'",
+    "worker-src 'none'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'self'",
+    "require-trusted-types-for 'script'",
+    "trusted-types 'none'",
+    'report-to connections',
+  ].join('; '));
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'no-referrer');
+  res.setHeader('X-DNS-Prefetch-Control', 'off');
+  res.setHeader('X-Frame-Options', 'SAMEORIGIN');
+  res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  res.setHeader('Permissions-Policy', 'camera=(), microphone=(), geolocation=()');
+  res.setHeader('Cache-Control', 'no-store');
+}
+
+async function readBody(req, limit = 4096) {
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > limit) throw Object.assign(new Error('Body too large'), { status: 413 });
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+function signupResponse(req, res, status, message) {
+  res.statusCode = status;
+  if (req.headers.accept?.includes('application/json')) {
+    res.setHeader('Content-Type', 'application/json; charset=utf-8');
+    res.end(JSON.stringify({ ok: status === 200, message }));
+  } else {
+    res.setHeader('Content-Type', 'text/html; charset=utf-8');
+    // Messages are fixed server strings; submitted values are never reflected.
+    res.end(`<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Daily Grind newsletter</title><link rel="stylesheet" href="/styles.css"><main class="container"><h1>Daily Grind newsletter</h1><p>${message}</p><a href="/#newsletter-heading">Back to Daily Grind</a></main></html>`);
+  }
+}
+
+const server = createServer(async (req, res) => {
+  const nonce = randomBytes(18).toString('base64');
+  securityHeaders(res, nonce);
+  try {
+    // A fixed parsing origin avoids trusting Host for routing or security headers.
+    const { pathname } = new URL(req.url, 'http://localhost');
+
+    if (pathname === '/api/newsletter' || pathname === '/api/security-reports') {
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        return signupResponse(req, res, 405, 'Please submit the newsletter form to sign up.');
+      }
+      const site = req.headers['sec-fetch-site'];
+      if (site && site !== 'same-origin' && site !== 'none') {
+        return signupResponse(req, res, 403, 'Please sign up from the Daily Grind homepage.');
+      }
+      if (req.headers.origin) {
+        let origin;
+        try { origin = new URL(req.headers.origin); } catch { /* Reject below. */ }
+        if (!origin || !['http:', 'https:'].includes(origin.protocol) || origin.host !== req.headers.host) {
+          return signupResponse(req, res, 403, 'Please sign up from the Daily Grind homepage.');
+        }
+      }
+      if (pathname === '/api/security-reports') {
+        // Consume bounded reports without storing URLs, query strings, or PII.
+        await readBody(req, 65536);
+        res.writeHead(204).end();
+        return;
+      }
+      const type = req.headers['content-type']?.split(';')[0].trim();
+      if (!['application/json', 'application/x-www-form-urlencoded'].includes(type)) {
+        return signupResponse(req, res, 415, 'Please use the newsletter form to sign up.');
+      }
+      const raw = await readBody(req);
+      let data;
+      try {
+        data = type === 'application/json' ? JSON.parse(raw) : Object.fromEntries(new URLSearchParams(raw));
+      } catch {
+        return signupResponse(req, res, 400, 'We couldn’t read your signup. Please try again.');
+      }
+      const email = typeof data?.email === 'string' ? data.email.trim() : '';
+      if (!email || email.length > 254 || !/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(email)) {
+        return signupResponse(req, res, 400, 'Please enter a valid email address and try again.');
+      }
+      if (!data.website) {
+        await mkdir(dataDirectory, { recursive: true, mode: 0o700 });
+        await appendFile(resolve(dataDirectory, 'newsletter.ndjson'), JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n', { mode: 0o600 });
+      }
+      return signupResponse(req, res, 200, successMessage);
+    }
+
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      res.writeHead(405, { 'Content-Type': 'text/plain; charset=utf-8' }).end('Method not allowed');
+      return;
+    }
+    let body;
+    let type;
+    if (pathname === '/' || pathname === '/index.html') {
+      body = homepage.replace('__CSP_NONCE__', nonce);
+      type = 'text/html; charset=utf-8';
+    } else if (assets.has(pathname)) {
+      [type, body] = assets.get(pathname);
+    } else {
+      res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' }).end('Page not found');
+      return;
+    }
+    res.writeHead(200, { 'Content-Type': type });
+    res.end(req.method === 'HEAD' ? undefined : body);
+  } catch (error) {
+    signupResponse(req, res, error.status === 413 ? 413 : 503,
+      'We couldn’t save your signup right now. Please try again later.');
+  }
+});
+
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(Number(process.env.PORT || 11222), '0.0.0.0');
