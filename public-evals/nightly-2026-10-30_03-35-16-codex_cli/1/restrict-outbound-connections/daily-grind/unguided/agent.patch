diff --git a/newsletter.js b/newsletter.js
new file mode 100644
index 0000000..f65cf52
--- /dev/null
+++ b/newsletter.js
@@ -0,0 +1,46 @@
+'use strict';
+
+const form = document.querySelector('#newsletter-form');
+const status = document.querySelector('#newsletter-status');
+const button = form.querySelector('button');
+
+function showFailure() {
+  status.textContent = 'Your request couldn’t go through. Please try again in a moment.';
+}
+
+document.addEventListener('securitypolicyviolation', (event) => {
+  if (['connect-src', 'form-action'].includes(event.effectiveDirective)) {
+    showFailure();
+  }
+});
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (!form.reportValidity()) return;
+
+  button.disabled = true;
+  status.textContent = 'Signing you up…';
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), 10000);
+
+  try {
+    const response = await fetch(form.action, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ email: form.elements.email.value.trim() }),
+      credentials: 'same-origin',
+      redirect: 'error',
+      signal: controller.signal,
+    });
+    if (!response.ok) throw new Error('Signup failed');
+    const result = await response.json();
+    if (result.success !== true) throw new Error('Signup failed');
+    status.textContent = 'You’re on the list! Thanks for signing up.';
+    form.reset();
+  } catch {
+    showFailure();
+  } finally {
+    clearTimeout(timeout);
+    button.disabled = false;
+  }
+});
