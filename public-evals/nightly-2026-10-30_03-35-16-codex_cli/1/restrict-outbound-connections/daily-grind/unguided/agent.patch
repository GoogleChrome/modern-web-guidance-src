@@ -0,0 +1,99 @@
+import { createServer } from 'node:http';
+import { randomBytes } from 'node:crypto';
+import { readFile, mkdir, appendFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { join } from 'node:path';
+
+const root = fileURLToPath(new URL('.', import.meta.url));
+const dataDirectory = process.env.DATA_DIR || join(root, 'data');
+const assets = new Map([
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+  ['/newsletter.js', ['newsletter.js', 'text/javascript; charset=utf-8']],
+]);
+
+function send(res, code, body, type = 'text/plain; charset=utf-8') {
+  res.writeHead(code, { 'Content-Type': type });
+  res.end(body);
+}
+
+async function signup(req, res) {
+  const json = req.headers.accept?.includes('application/json');
+  const reply = (code, success, message) => send(res, code,
+    json ? JSON.stringify({ success, message }) : message,
+    json ? 'application/json; charset=utf-8' : 'text/plain; charset=utf-8');
+
+  const type = req.headers['content-type']?.split(';')[0].trim();
+  if (!['application/json', 'application/x-www-form-urlencoded'].includes(type)) {
+    reply(415, false, 'Please submit a valid signup form.');
+    return;
+  }
+  const chunks = [];
+  let bytes = 0;
+  for await (const chunk of req) {
+    bytes += chunk.length;
+    if (bytes > 4096) {
+      reply(413, false, 'Your request is too large. Please try again.');
+      return;
+    }
+    chunks.push(chunk);
+  }
+  const body = Buffer.concat(chunks).toString('utf8');
+  let email;
+  try {
+    email = type === 'application/json' ? JSON.parse(body).email : new URLSearchParams(body).get('email');
+  } catch {
+    reply(400, false, 'Please enter a valid email address.');
+    return;
+  }
+  if (typeof email !== 'string' || email.trim().length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim())) {
+    reply(400, false, 'Please enter a valid email address.');
+    return;
+  }
+  await mkdir(dataDirectory, { recursive: true, mode: 0o700 });
+  await appendFile(join(dataDirectory, 'newsletter.jsonl'),
+    JSON.stringify({ email: email.trim(), subscribedAt: new Date().toISOString() }) + '\n',
+    { mode: 0o600 });
+  reply(201, true, 'You’re on the list! Thanks for signing up.');
+}
+
+const server = createServer(async (req, res) => {
+  const nonce = randomBytes(24).toString('base64');
+  res.setHeader('Content-Security-Policy', [
+    "default-src 'none'",
+    `script-src 'nonce-${nonce}'`,
+    "script-src-attr 'none'",
+    "style-src 'self'",
+    "img-src 'self' https://images.unsplash.com",
+    "connect-src 'self'",
+    "form-action 'self'",
+    "base-uri 'none'",
+    "object-src 'none'",
+    "frame-ancestors 'none'",
+  ].join('; '));
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'no-referrer');
+  res.setHeader('Cache-Control', 'no-store');
+
+  try {
+    const pathname = new URL(req.url, 'http://localhost').pathname;
+    if (pathname === '/api/newsletter' && req.method === 'POST') {
+      await signup(req, res);
+    } else if (req.method !== 'GET' && req.method !== 'HEAD') {
+      res.setHeader('Allow', pathname === '/api/newsletter' ? 'POST' : 'GET, HEAD');
+      send(res, 405, 'Method not allowed.');
+    } else if (pathname === '/' || pathname === '/index.html') {
+      const html = (await readFile(join(root, 'index.html'), 'utf8')).replace('{{NONCE}}', nonce);
+      send(res, 200, req.method === 'HEAD' ? '' : html, 'text/html; charset=utf-8');
+    } else if (assets.has(pathname)) {
+      const [file, type] = assets.get(pathname);
+      const body = await readFile(join(root, file));
+      send(res, 200, req.method === 'HEAD' ? '' : body, type);
+    } else {
+      send(res, 404, 'Page not found.');
+    }
+  } catch {
+    send(res, 500, 'Your request couldn’t go through. Please try again in a moment.');
+  }
+});
+server.requestTimeout = 15000;
+server.listen(Number(process.env.PORT || 11222), process.env.HOST || '0.0.0.0');
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..ddbacec
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,177 @@
+:root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+    }
+
+    /* Navigation */
+    nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+    }
+
+    .logo {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    nav ul {
+      display: flex;
+      list-style: none;
+    }
+
+    nav ul li {
+      margin-left: 20px;
+    }
+
+    nav a {
+      color: white;
+      text-decoration: none;
+      font-size: 0.9rem;
+      transition: color 0.3s;
+    }
+
+    nav a:hover {
+      color: var(--accent);
+    }
+
+    .logout-link {
+      border: 1px solid var(--accent);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+
+    /* Hero Section */
+    .hero {
+      height: 60vh;
+      background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+        url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: white;
+      text-align: center;
+      padding: 0 20px;
+    }
+
+    .hero h1 {
+      font-size: 3rem;
+      margin-bottom: 1rem;
+    }
+
+    /* Content Sections */
+    .container {
+      max-width: 1100px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+      gap: 20px;
+      margin-top: 20px;
+    }
+
+    .card {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    .card h3 {
+      margin-bottom: 10px;
+      color: var(--primary);
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    footer {
+      background: var(--secondary);
+      text-align: center;
+      padding: 40px 20px;
+      margin-top: 40px;
+    }
+
+    .footer-links {
+      margin-bottom: 20px;
+    }
+
+    .footer-links a {
+      margin: 0 10px;
+      color: var(--text);
+      text-decoration: none;
+      font-size: 0.85rem;
+    }
+
+.section-title { text-align: center; }
+.newsletter {
+  margin-top: 48px;
+  padding: 32px;
+  border-radius: 8px;
+  background: var(--secondary);
+}
+.newsletter > p { margin: 8px 0 20px; }
+.newsletter label { display: block; font-weight: 600; margin-bottom: 6px; }
+.signup-fields { display: flex; gap: 12px; }
+.signup-fields input {
+  flex: 1;
+  min-width: 0;
+  border: 1px solid var(--primary);
+  border-radius: 5px;
+  padding: 12px;
+  font: inherit;
+}
+.signup-fields .btn { margin: 0; border: 0; font: inherit; cursor: pointer; }
+.signup-fields .btn:disabled { opacity: 0.65; cursor: wait; }
+.signup-note { margin-top: 10px; font-size: 0.85rem; }
+#newsletter-status { margin: 12px 0 0; font-weight: 600; }
+:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
+@media (max-width: 600px) {
+  nav { flex-wrap: wrap; gap: 12px; }
+  nav ul { flex-wrap: wrap; gap: 12px; }
+  nav ul li { margin-left: 0; }
+  .newsletter { padding: 24px 20px; }
+  .signup-fields { flex-direction: column; }
+}
