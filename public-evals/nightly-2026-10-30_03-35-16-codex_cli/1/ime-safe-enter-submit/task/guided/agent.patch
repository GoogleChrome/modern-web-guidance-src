   </footer>
 
+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackMessage = document.getElementById('feedback-message');
+    const feedbackStatus = document.getElementById('feedback-status');
+
+    feedbackMessage.addEventListener('input', () => {
+      feedbackMessage.setCustomValidity('');
+      feedbackStatus.textContent = '';
+    });
+
+    feedbackMessage.addEventListener('keydown', (event) => {
+      if (event.key !== 'Enter' || event.shiftKey) return;
+      // Safari can report an IME-confirming Enter with keyCode 229.
+      if (event.isComposing || event.keyCode === 229) return;
+      event.preventDefault();
+      if (!event.repeat) feedbackForm.requestSubmit();
+    });
+
+    feedbackForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const message = feedbackMessage.value.trim();
+      if (!message) {
+        feedbackMessage.setCustomValidity('Please enter your feedback before sending.');
+        feedbackMessage.reportValidity();
+        return;
+      }
+
+      try {
+        const savedFeedback = JSON.parse(localStorage.getItem('daily-grind-feedback') || '[]');
+        savedFeedback.push({ message, submittedAt: new Date().toISOString() });
+        localStorage.setItem('daily-grind-feedback', JSON.stringify(savedFeedback));
+        feedbackForm.reset();
+        feedbackStatus.textContent = 'Thanks! Your feedback has been saved in this browser.';
+      } catch {
+        feedbackStatus.textContent = 'Your feedback could not be saved. Please try again.';
+      }
+    });
+  </script>
+
 </body>
 
