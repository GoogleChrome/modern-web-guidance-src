diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..72290fe
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,84 @@
+---
+interface Props {
+    sections: { id: string; label: string }[];
+}
+
+const { sections } = Astro.props;
+---
+
+<section-nav class="sticky top-0 z-20 block border-b border-gray-300 bg-white shadow-sm">
+    <nav aria-label="Page sections" class="flex items-center gap-6 overflow-x-auto px-4 md:px-6">
+        <span class="shrink-0 text-xs font-semibold uppercase tracking-wide text-gray-500">On this page</span>
+        {sections.map(({ id, label }, index) => (
+            <a href={`#${id}`} aria-current={index === 0 ? 'location' : undefined}
+                class="section-link shrink-0 border-b-2 border-transparent py-3 text-sm font-semibold text-gray-600 hover:text-gray-950 focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-amber-600">
+                {label}
+            </a>
+        ))}
+    </nav>
+</section-nav>
+
+<style>
+    .section-link[aria-current="location"] {
+        border-bottom-color: var(--color-amber-500);
+        color: var(--color-gray-950);
+    }
+</style>
+
+<script>
+    class SectionNav extends HTMLElement {
+        private cleanup?: () => void;
+
+        connectedCallback() {
+            const links = Array.from(this.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
+            const entries = links.flatMap(link => {
+                const section = document.getElementById(link.hash.slice(1));
+                return section ? [{ link, section }] : [];
+            });
+            if (!entries.length) return;
+
+            let frame = 0;
+            const update = () => {
+                frame = 0;
+                // The section reaching the area just below the sticky menu is current.
+                const readingLine = this.getBoundingClientRect().bottom + 24;
+                let current = entries[0];
+                for (const entry of entries) {
+                    if (entry.section.getBoundingClientRect().top <= readingLine) current = entry;
+                }
+                // A short final section may never reach the reading line.
+                if (window.scrollY > 0 && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
+                    current = entries[entries.length - 1];
+                }
+                for (const entry of entries) {
+                    if (entry === current) entry.link.setAttribute('aria-current', 'location');
+                    else entry.link.removeAttribute('aria-current');
+                }
+            };
+            const schedule = () => {
+                if (!frame) frame = requestAnimationFrame(update);
+            };
+            window.addEventListener('scroll', schedule, { passive: true });
+            window.addEventListener('resize', schedule);
+            window.addEventListener('hashchange', schedule);
+            // Recalculate when images, ads, or fonts change the page layout.
+            const observer = new ResizeObserver(schedule);
+            observer.observe(document.body);
+            update();
+
+            this.cleanup = () => {
+                window.removeEventListener('scroll', schedule);
+                window.removeEventListener('resize', schedule);
+                window.removeEventListener('hashchange', schedule);
+                observer.disconnect();
+                cancelAnimationFrame(frame);
+            };
+        }
+
+        disconnectedCallback() {
+            this.cleanup?.();
+        }
+    }
+
+    if (!customElements.get('section-nav')) customElements.define('section-nav', SectionNav);
+</script>
