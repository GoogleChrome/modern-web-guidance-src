+  <script type="module">
+    const nav = document.querySelector('nav');
+    const links = [...nav.querySelectorAll('a[href^="#"]')];
+    const sections = links.map(link => document.getElementById(link.hash.slice(1)));
+    const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(:target-current)');
+    let observer;
+    let frame;
+
+    function setCurrent(current) {
+      links.forEach(link => {
+        const active = link === current;
+        link.classList.toggle('is-active', !nativeTracking && active);
+        if (active) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    function syncCurrent() {
+      frame = null;
+      if (nativeTracking) {
+        setCurrent(nav.querySelector('a:target-current'));
+        return;
+      }
+
+      // Prefer the visible section nearest the space below the sticky bar.
+      const top = nav.getBoundingClientRect().bottom + 20;
+      const visible = sections.filter(section => {
+        const rect = section.getBoundingClientRect();
+        return rect.bottom > top && rect.top < window.innerHeight;
+      });
+      let current = visible.find(section => section.getBoundingClientRect().top <= top) || visible[0];
+      // The final section must remain selectable even on a short page.
+      if (visible.length && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
+        current = visible[visible.length - 1];
+      }
+      setCurrent(links[sections.indexOf(current)]);
+    }
+
+    function scheduleSync() {
+      if (frame == null) frame = requestAnimationFrame(syncCurrent);
+    }
+
+    function updateNavHeight() {
+      const height = nav.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${height}px`);
+      if (!nativeTracking) {
+        observer?.disconnect();
+        observer = new IntersectionObserver(scheduleSync, {
+          rootMargin: `-${height}px 0px 0px 0px`,
+          threshold: [0, 0.25, 0.5, 0.75, 1]
+        });
+        sections.forEach(section => observer.observe(section));
+      }
+      scheduleSync();
+    }
+
+    new ResizeObserver(updateNavHeight).observe(nav);
+    document.addEventListener('scroll', scheduleSync, { passive: true });
+    document.addEventListener('scrollend', scheduleSync);
+    window.addEventListener('resize', scheduleSync);
+    window.addEventListener('hashchange', scheduleSync);
+    window.addEventListener('pageshow', scheduleSync);
+    updateNavHeight();
+  </script>
+
