+(() => {
+  'use strict';
+  const CONFIG_KEY = 'daily-grind.configuration';
+  const ROUTE_KEY = 'daily-grind.destination';
+  const defaults = { theme: 'light', compact: false, notifications: true, startPage: 'overview' };
+  const $ = (id) => document.getElementById(id);
+  const modal = $('modal');
+  let configuration = { ...defaults };
+  let pending = null;
+  let timer;
+  function status(message) {
+    $('status').textContent = message;
+    $('status').classList.remove('hidden');
+  }
+  function validateConfig(value) {
+    if (!value || typeof value !== 'object' || Array.isArray(value) ||
+        !['light', 'dark'].includes(value.theme) || typeof value.compact !== 'boolean' ||
+        typeof value.notifications !== 'boolean' || !['overview', 'preferences'].includes(value.startPage)) {
+      throw new Error('This backup does not contain valid Daily Grind settings.');
+    }
+    return { theme: value.theme, compact: value.compact, notifications: value.notifications, startPage: value.startPage };
+  }
+  function applyConfig(value) {
+    localStorage.setItem(CONFIG_KEY, JSON.stringify(value));
+    configuration = value;
+    document.body.dataset.theme = value.theme;
+    document.body.dataset.compact = String(value.compact);
+  }
+  function escape(value) {
+    return String(value).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+  }
+  function openDialog(html) {
+    $('modal-content').innerHTML = html;
+    if (!modal.open) modal.showModal();
+    modal.querySelectorAll('[data-close]').forEach(button => button.onclick = () => {
+      modal.close();
+      if (!pending) setStep(1);
+    });
+  }
+  function setStep(step) {
+    [1, 2, 3].forEach(n => $('step' + n).classList.toggle('current', n === step));
+  }
+  try {
+    const saved = localStorage.getItem(CONFIG_KEY);
+    if (saved) configuration = validateConfig(JSON.parse(saved));
+    document.body.dataset.theme = configuration.theme;
+    document.body.dataset.compact = String(configuration.compact);
+    const redirect = localStorage.getItem(ROUTE_KEY);
+    if (redirect && !new URLSearchParams(location.search).has('manage-migration') && !location.hash.startsWith('#daily-grind-transfer=')) {
+      const target = new URL(redirect);
+      if (target.protocol === 'https:' && target.origin !== location.origin) location.replace(target.origin);
+    }
+    if (redirect && new URLSearchParams(location.search).has('manage-migration')) {
+      status('Your shortcuts forward to ' + new URL(redirect).origin + '.');
+      const stop = document.createElement('button');
+      stop.className = 'text-link'; stop.style.marginLeft = '12px'; stop.textContent = 'Stop forwarding';
+      stop.onclick = () => { localStorage.removeItem(ROUTE_KEY); status('Shortcut forwarding has been turned off.'); };
+      $('status').append(stop);
+    }
+  } catch { status('Saved settings could not be loaded. You can restore a backup or save fresh preferences.'); }
+  $('current-origin').textContent = location.origin;
+
+  $('migration-form').onsubmit = (event) => {
+    event.preventDefault();
+    $('error').classList.add('hidden');
+    try {
+      const destination = new URL($('destination').value.trim());
+      if (destination.protocol !== 'https:' || destination.username || destination.password) throw new Error('Use an HTTPS address without a username or password.');
+      if (destination.origin === location.origin) throw new Error('Choose a different origin from your current app.');
+      if (destination.pathname !== '/' || destination.search || destination.hash) throw new Error('Enter only the origin, for example https://app.example.com, without a path, query, or fragment.');
+      // Verify storage before offering a transfer that depends on it.
+      applyConfig(configuration);
+      setStep(2);
+      openDialog(`<h2>Ready for your new home?</h2><p>Your configuration will be sent to:</p><code>${escape(destination.origin)}</code><p>Only continue if you trust this address and the same Daily Grind app is deployed there. Review and accept your settings in the new tab to finish.</p><p>Your browser manages installed apps. Existing OS shortcuts will keep using this origin and forward to the new address after the transfer is confirmed. The old address must remain available.</p><div class="actions"><button class="secondary" data-close>Go back</button><button class="primary" id="confirm-transfer">Open & transfer ↗</button></div>`);
+      $('confirm-transfer').onclick = () => beginTransfer(destination.origin);
+    } catch (error) { $('error').textContent = error.message; $('error').classList.remove('hidden'); }
+  };
+  function beginTransfer(destination) {
+    if (pending) return;
+    const nonce = crypto.randomUUID();
+    const payload = { app: 'daily-grind', version: 1, configuration, source: location.origin, destination, nonce };
+    const target = destination + '/#daily-grind-transfer=' + encodeURIComponent(JSON.stringify(payload));
+    const popup = window.open(target, '_blank');
+    if (!popup) { status('The new tab was blocked. Allow pop-ups for this site, then try again.'); return; }
+    pending = { destination, nonce, popup };
+    modal.close();
+    status('Waiting for you to accept your configuration in the new tab. Your old shortcuts have not changed yet.');
+    timer = setTimeout(() => {
+      if (pending) {
+        pending = null;
+        setStep(1);
+        status('Confirmation was not received. Shortcut forwarding is still off. Check that the new origin hosts this app and allows communication with the opening tab, then try again. You can also export and restore your settings.');
+      }
+    }, 120000);
+  }
+  window.addEventListener('message', event => {
+    if (!pending || event.source !== pending.popup || event.origin !== pending.destination ||
+        event.data?.type !== 'daily-grind-accepted' || event.data.nonce !== pending.nonce) return;
+    try {
+      localStorage.setItem(ROUTE_KEY, pending.destination);
+      const destination = pending.destination;
+      pending = null;
+      clearTimeout(timer);
+      setStep(3);
+      status('You’re all settled in. Settings were saved at ' + destination + '. Existing shortcuts now forward there while this old address stays online.');
+      openDialog('<h2>Welcome to your next chapter.</h2><p>Your settings are saved at the new origin, and your old app will forward your existing shortcuts there. Keep the old origin online. You can manage forwarding here using ?manage-migration.</p><div class="actions"><button class="primary" data-close>All done ✓</button></div>');
+    } catch { pending = null; clearTimeout(timer); status('The new app saved your settings, but shortcut forwarding could not be saved here. Enable local storage and try again.'); }
+  });
+
+  if (location.hash.startsWith('#daily-grind-transfer=')) {
+    try {
+      if (location.hash.length > 16000) throw new Error('Transfer data is too large.');
+      const payload = JSON.parse(decodeURIComponent(location.hash.slice('#daily-grind-transfer='.length)));
+      history.replaceState(null, '', location.pathname + location.search);
+      if (payload.app !== 'daily-grind' || payload.version !== 1 || payload.destination !== location.origin ||
+          typeof payload.nonce !== 'string' || payload.nonce.length > 100) throw new Error('This transfer is not valid for this origin.');
+      const source = new URL(payload.source);
+      if (!['http:', 'https:'].includes(source.protocol) || source.origin === location.origin || source.origin !== payload.source) throw new Error('The transfer source is invalid.');
+      const incoming = validateConfig(payload.configuration);
+      openDialog(`<h2>Make yourself at home.</h2><p>Accept configuration from:</p><code>${escape(source.origin)}</code><p>This replaces preferences saved on this origin. Theme: ${escape(incoming.theme)}. Compact layout: ${incoming.compact ? 'on' : 'off'}. Notifications preference: ${incoming.notifications ? 'on' : 'off'}.</p><div class="actions"><button class="secondary" data-close>Cancel</button><button class="primary" id="accept-transfer">Accept configuration</button></div>`);
+      $('accept-transfer').onclick = () => {
+        try {
+          applyConfig(incoming);
+          localStorage.removeItem(ROUTE_KEY);
+          if (window.opener) window.opener.postMessage({ type: 'daily-grind-accepted', nonce: payload.nonce }, source.origin);
+          modal.close(); setStep(3);
+          status('Your configuration is saved. Return to the old tab to check shortcut forwarding. Your browser may offer to install this app separately at its new origin.');
+        } catch { status('Configuration could not be saved. Allow local storage and accept again.'); }
+      };
+    } catch (error) { history.replaceState(null, '', location.pathname + location.search); status(error.message); }
+  }
+  $('export').onclick = () => {
+    const blob = new Blob([JSON.stringify({ app: 'daily-grind', version: 1, configuration }, null, 2)], { type: 'application/json' });
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a'); link.href = url; link.download = 'daily-grind-configuration.json'; link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+    status('Configuration backup downloaded. Keep it somewhere safe for your move.');
+  };
+  $('import').onclick = () => $('backup-file').click();
+  $('backup-file').onchange = async event => {
+    try {
+      const file = event.target.files[0]; if (!file) return;
+      if (file.size > 16000) throw new Error('Please choose a configuration backup smaller than 16 KB.');
+      const backup = JSON.parse(await file.text());
+      if (backup.app !== 'daily-grind' || backup.version !== 1) throw new Error('This is not a supported Daily Grind backup.');
+      const incoming = validateConfig(backup.configuration);
+      openDialog('<h2>Restore your preferences?</h2><p>This will replace the preferences saved on this origin with your backup.</p><div class="actions"><button class="secondary" data-close>Cancel</button><button class="primary" id="restore">Restore configuration</button></div>');
+      $('restore').onclick = () => { try { applyConfig(incoming); modal.close(); status('Your configuration has been restored.'); } catch { status('Settings could not be saved. Allow local storage and try again.'); } };
+    } catch (error) { status(error.message); }
+    event.target.value = '';
+  };
+  document.querySelectorAll('[data-help]').forEach(button => button.onclick = () => openDialog('<h2>A little help with your move.</h2><p>Deploy this app at your new HTTPS origin, enter that origin here, and review your transfer. Accept the settings in the new tab, then return here for confirmation.</p><p>The transfer includes your theme, layout, notification preference, and start page. It does not transfer accounts, browser permissions, or cookies. Notification permission must be granted separately at the new origin.</p><p>OS shortcuts remain pointed at the old origin, which forwards them after confirmation. Keep the old origin online. Open it with ?manage-migration to stop forwarding. Backups can be exported and restored using the links on this page.</p><div class="actions"><button class="primary" data-close>Got it</button></div>'));
+  document.querySelectorAll('[data-view]').forEach(link => link.onclick = event => {
+    event.preventDefault();
+    if (link.dataset.view === 'preferences') {
+      openDialog(`<h2>Your everyday preferences</h2><label>Theme<select id="theme"><option value="light">Light</option><option value="dark">Sage</option></select></label><label><input id="compact" type="checkbox"> Compact layout</label><label><input id="notifications" type="checkbox"> Enable notification preference</label><label>Start page<select id="start-page"><option value="overview">Overview</option><option value="preferences">Preferences</option></select></label><div class="actions"><button class="secondary" data-close>Cancel</button><button class="primary" id="save-preferences">Save preferences</button></div>`);
+      $('theme').value = configuration.theme; $('compact').checked = configuration.compact;
+      $('notifications').checked = configuration.notifications; $('start-page').value = configuration.startPage;
+      $('save-preferences').onclick = () => {
+        try { applyConfig({ theme: $('theme').value, compact: $('compact').checked, notifications: $('notifications').checked, startPage: $('start-page').value }); modal.close(); status('Your preferences are saved and ready to come along.'); }
+        catch { status('Preferences could not be saved. Allow local storage and try again.'); }
+      };
+    } else {
+      const installed = matchMedia('(display-mode: standalone)').matches || navigator.standalone;
+      openDialog(`<h2>${link.dataset.view === 'overview' ? 'Your workspace at a glance' : 'Your installed app'}</h2><p>Current origin:</p><code>${escape(location.origin)}</code><p>${installed ? 'The app is running in a standalone window.' : 'The app is currently open in a browser tab.'} Your browser controls installation and OS shortcuts.</p><p>Your saved preferences are ready to export or transfer to a new origin.</p><div class="actions"><button class="primary" data-close>Back to move app</button></div>`);
+    }
+  });
+})();
