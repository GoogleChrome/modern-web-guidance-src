+  <script>
+    const favoritePages = [
+      null, // Page one is already rendered in the HTML.
+      [
+        ['Pumpkin Spice Latte', 'Espresso with pumpkin, warming spices, and steamed milk.', '/menu/seasonal'],
+        ['Honey Cinnamon Cappuccino', 'A foamy cappuccino finished with honey and cinnamon.', '/menu/espresso'],
+        ['Vanilla Cream Cold Brew', 'Slow-steeped coffee topped with silky vanilla cream.', '/menu/cold-brew'],
+      ],
+      [
+        ['Salted Caramel Latte', 'Buttery caramel and espresso with a touch of sea salt.', '/menu/seasonal'],
+        ['Maple Flat White', 'Rich espresso and velvety milk with a maple finish.', '/menu/espresso'],
+        ['Spiced Mocha', 'Dark chocolate and espresso with a cozy hint of spice.', '/menu/seasonal'],
+      ],
+    ];
+    const requestedPage = Number(new URL(window.location.href).searchParams.get('page') || 1);
+    const page = Number.isInteger(requestedPage)
+      ? Math.max(1, Math.min(favoritePages.length, requestedPage))
+      : 1;
+
+    if (page > 1) {
+      document.querySelectorAll('.grid .card').forEach((card, index) => {
+        const [name, description, href] = favoritePages[page - 1][index];
+        card.querySelector('h3').textContent = name;
+        card.querySelector('p').textContent = description;
+        card.querySelector('a').href = href;
+      });
+    }
+
+    document.getElementById('page-status').textContent = `Page ${page} of ${favoritePages.length}`;
+    for (const [id, target] of [['previous', page - 1], ['next', page + 1]]) {
+      const link = document.getElementById(id);
+      if (target >= 1 && target <= favoritePages.length) {
+        const url = new URL(window.location.href);
+        url.searchParams.set('page', target);
+        link.href = url.href;
+        link.removeAttribute('aria-disabled');
+      } else {
+        link.removeAttribute('href');
+        link.setAttribute('aria-disabled', 'true');
+      }
+    }
+  </script>
