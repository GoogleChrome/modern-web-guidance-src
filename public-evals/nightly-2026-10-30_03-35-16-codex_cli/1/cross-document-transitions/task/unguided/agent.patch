+  <script>
+    // Register early so incoming documents can set their type before revealing.
+    const motionPreference = window.matchMedia('(prefers-reduced-motion: no-preference)');
+    if (motionPreference.matches) {
+      function applyTransitionType(event, activation) {
+        if (!event.viewTransition) return;
+        if (!motionPreference.matches) {
+          event.viewTransition.skipTransition();
+          return;
+        }
+        if (!event.viewTransition.types || !activation?.from || !activation?.entry) return;
+
+        const from = new URL(activation.from.url);
+        const to = new URL(activation.entry.url);
+        if (from.origin !== to.origin || from.pathname !== to.pathname) return;
+        const previousPage = Number(from.searchParams.get('page') || 1);
+        const nextPage = Number(to.searchParams.get('page') || 1);
+        if (nextPage > previousPage) event.viewTransition.types.add('next');
+        if (nextPage < previousPage) event.viewTransition.types.add('previous');
+      }
+
+      window.addEventListener('pageswap', (event) => {
+        applyTransitionType(event, event.activation);
+      });
+      window.addEventListener('pagereveal', (event) => {
+        applyTransitionType(event, window.navigation?.activation);
+      });
+    }
+  </script>
 </head>
 
