+  <script>
+    const seasonalPages = [
+      null, // Page one is already rendered in the HTML.
+      [
+        ['Pumpkin Spice Latte', 'Espresso with warming pumpkin spice and steamed milk.', '/menu/seasonal'],
+        ['Salted Caramel Mocha', 'Rich chocolate and caramel finished with a pinch of sea salt.', '/menu/seasonal'],
+        ['Honey Cinnamon Cappuccino', 'Silky foam with golden honey and a dusting of cinnamon.', '/menu/seasonal']
+      ],
+      [
+        ['Toasted Hazelnut Latte', 'Roasted hazelnut flavor with espresso and velvety milk.', '/menu/seasonal'],
+        ['Vanilla Sweet Cream Cold Brew', 'Slow-steeped coffee topped with vanilla sweet cream.', '/menu/cold-brew'],
+        ['Spiced Apple Chai', 'Fragrant chai with apple and cozy autumn spices.', '/menu/seasonal']
+      ]
+    ];
+    const requestedPage = Number(new URL(location.href).searchParams.get('page') || 1);
+    const currentPage = Number.isInteger(requestedPage)
+      ? Math.min(seasonalPages.length, Math.max(1, requestedPage))
+      : 1;
+
+    if (currentPage > 1) {
+      document.querySelectorAll('.grid .card').forEach((card, index) => {
+        const [name, description, href] = seasonalPages[currentPage - 1][index];
+        card.querySelector('h3').textContent = name;
+        card.querySelector('p').textContent = description;
+        card.querySelector('a').href = href;
+      });
+    }
+
+    const paginationUrl = (page) => {
+      const url = new URL(location.href);
+      url.searchParams.set('page', page);
+      return url.href;
+    };
+    const previous = document.getElementById('previous');
+    const next = document.getElementById('next');
+    previous.hidden = currentPage === 1;
+    previous.href = paginationUrl(Math.max(1, currentPage - 1));
+    next.hidden = currentPage === seasonalPages.length;
+    next.href = paginationUrl(Math.min(seasonalPages.length, currentPage + 1));
+    document.getElementById('page-status').textContent = `Page ${currentPage} of ${seasonalPages.length}`;
+  </script>
+
