+    </style>
+  </head>
+  <body>
+    <header>
+      <div class="brand"><span class="brand-mark" aria-hidden="true">Tt</span> type / together</div>
+      <div class="header-note"><span class="dot"></span> Small experiments. Better typography.</div>
+    </header>
+    <main>
+      <div class="page-heading">
+        <div><div class="eyebrow">The typography playground / 001</div><h1>Different fonts.<br><span>Same harmony.</span></h1><p class="intro">A little CSS goes a long way. Explore how font-size-adjust keeps mixed type feeling perfectly in tune.</p></div>
+        <span class="version">CSS / font-size-adjust</span>
+      </div>
+      <div class="workspace">
+        <section class="specimens" aria-label="Live typography specimens">
+          <div class="section-label"><h2><span>01</span> Mixed fonts, one rhythm</h2><span class="pill" id="adjustment-status">Auto-adjusted</span></div>
+          <div class="sample"><p id="mixed-fonts-container">Good typography makes <code>code</code> feel right at home. Even when <code>font-family</code> changes, everything stays in harmony.</p></div>
+          <div class="caption"><span>Arial + <span id="font-caption">Courier New</span></span><code id="adjustment-caption">font-size-adjust: from-font;</code></div>
+          <hr class="divider">
+          <div class="section-label"><h2><span>02</span> A theme of its own</h2><span class="pill">Independent</span></div>
+          <div id="independent-theme-container"><span class="theme-label">The editorial theme</span><h3>A different voice.<br>The same sense of balance.</h3><p>Some stories need a softer touch. This independent theme sets its own proportions, keeping every letter considered and every line comfortable.</p></div>
+          <div class="caption"><span>Georgia / serif</span><code>font-size-adjust: 0.5;</code></div>
+        </section>
+        <aside class="controls" aria-label="Typography controls">
+          <h2>Make it your type <span aria-hidden="true">↗</span></h2>
+          <div class="control-heading" id="normalization-label">Visual normalization</div>
+          <div class="segmented" role="group" aria-labelledby="normalization-label"><button type="button" id="auto" aria-pressed="true">Automatic</button><button type="button" id="natural" aria-pressed="false">Natural</button></div>
+          <p class="hint">Match the x-height of different fonts automatically with <code>from-font</code>.</p>
+          <label class="control-heading" for="code-font">Inline code font</label>
+          <select id="code-font"><option value="'Courier New', monospace">Courier New</option><option value="Consolas, monospace">Consolas</option><option value="monospace">System monospace</option></select>
+          <label class="control-heading" for="font-size">Text size <output class="value" id="size-output" for="font-size">24px</output></label>
+          <input id="font-size" type="range" min="16" max="32" value="24"><div class="range-labels"><span>16px</span><span>32px</span></div>
+          <hr class="control-divider">
+          <div class="ratio"><strong>A fixed point of reference</strong><p class="hint">The independent theme uses an explicit x-height ratio.</p><code>font-size-adjust: 0.5;</code></div>
+          <p class="hint">An x-height of 50% of the font size, regardless of the surrounding theme.</p>
+          <button class="reset" id="reset" type="button">↺ &nbsp; Reset playground</button>
+        </aside>
+      </div>
+      <section class="code-section" aria-labelledby="css-title"><div class="code-header"><h2 id="css-title">A small property. A visible difference.</h2><button class="copy" id="copy" type="button">Copy CSS</button></div><div class="code-grid"><pre><code><span class="comment">/* Let the first font set the rhythm */</span>
+#mixed-fonts-container {
+  font-size-adjust: from-font;
+}</code></pre><pre><code><span class="comment">/* Give a separate theme its own proportions */</span>
+#independent-theme-container {
+  font-size-adjust: 0.5;
+}</code></pre></div></section>
+      <footer><span>Built with native CSS. No font-measuring tricks required.</span><a href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noreferrer">Meet font-size-adjust ↗</a></footer>
+      <span id="announcement" role="status" aria-live="polite"></span>
+    </main>
+    <script>
+      const mixed = document.getElementById('mixed-fonts-container');
+      const auto = document.getElementById('auto');
+      const natural = document.getElementById('natural');
+      const font = document.getElementById('code-font');
+      const size = document.getElementById('font-size');
+      function setAdjustment(enabled) {
+        mixed.style.fontSizeAdjust = enabled ? 'from-font' : 'none';
+        auto.setAttribute('aria-pressed', String(enabled));
+        natural.setAttribute('aria-pressed', String(!enabled));
+        document.getElementById('adjustment-status').textContent = enabled ? 'Auto-adjusted' : 'Natural proportions';
+        document.getElementById('adjustment-caption').textContent = `font-size-adjust: ${enabled ? 'from-font' : 'none'};`;
+      }
+      function setFont() {
+        mixed.querySelectorAll('code').forEach(code => { code.style.fontFamily = font.value; });
+        document.getElementById('font-caption').textContent = font.options[font.selectedIndex].text;
+      }
+      function setSize() {
+        mixed.style.fontSize = `${Number(size.value) / 16}rem`;
+        document.getElementById('size-output').value = `${size.value}px`;
+      }
+      auto.addEventListener('click', () => setAdjustment(true));
+      natural.addEventListener('click', () => setAdjustment(false));
+      font.addEventListener('change', setFont);
+      size.addEventListener('input', setSize);
+      document.getElementById('reset').addEventListener('click', () => {
+        setAdjustment(true); font.selectedIndex = 0; size.value = '24'; setFont(); setSize();
+      });
+      document.getElementById('copy').addEventListener('click', async () => {
+        const css = '#mixed-fonts-container {\n  font-size-adjust: from-font;\n}\n\n#independent-theme-container {\n  font-size-adjust: 0.5;\n}';
+        try {
+          await navigator.clipboard.writeText(css);
+          document.getElementById('copy').textContent = 'Copied!';
+          document.getElementById('announcement').textContent = 'CSS copied to clipboard.';
+          setTimeout(() => { document.getElementById('copy').textContent = 'Copy CSS'; }, 2000);
+        } catch {
+          document.getElementById('announcement').textContent = 'Clipboard unavailable. Select and copy the CSS shown above.';
+        }
+      });
+    </script>
+  </body>
+</html>
