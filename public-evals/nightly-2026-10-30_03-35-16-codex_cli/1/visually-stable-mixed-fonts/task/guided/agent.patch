+      .segmented button[aria-pressed="true"] { background: #fffefa; box-shadow: 0 1px 3px #1b2f1b14; color: #36583c; }
+      .hint { font-size: .68rem; line-height: 1.65; color: #8a9280; margin: 10px 0 0; }
+      select { width: 100%; padding: 9px 10px; background: #fffefa; border: 1px solid #dce2d3; border-radius: 6px; color: #55614e; font-size: .72rem; }
