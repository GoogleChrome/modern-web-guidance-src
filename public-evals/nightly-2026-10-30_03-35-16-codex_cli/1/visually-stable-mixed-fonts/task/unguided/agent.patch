+function update(){const enabled=toggle.getAttribute('aria-checked')==='true';sample.style.fontFamily=`"${bodyFont.value}", ${bodyFont.value==='Georgia'?'serif':'sans-serif'}`;sample.querySelector('code').style.fontFamily=`"${codeFont.value}", monospace`;sample.style.fontSize=size.value+'px';sample.style.fontSizeAdjust=enabled?'from-font':'none';document.querySelector('#size-value').value=size.value+'px';document.querySelector('#adjust-code').textContent=enabled?'from-font':'none';document.querySelector('#sample-caption').textContent=enabled?'Different families, perfectly in tune.':'Original font proportions, without adjustment.';document.querySelector('#full-code').textContent=cssSnippet()}
+[bodyFont,codeFont,size].forEach(el=>el.addEventListener('input',update));toggle.addEventListener('click',()=>{toggle.setAttribute('aria-checked',toggle.getAttribute('aria-checked')!=='true');update()});document.querySelector('#reset').addEventListener('click',()=>{bodyFont.value='Arial';codeFont.value='IBM Plex Mono';size.value='25';toggle.setAttribute('aria-checked','true');update()});
+const tabs=[...document.querySelectorAll('[role=tab]')];function activateTab(tab){tabs.forEach(t=>{const active=t===tab;t.classList.toggle('active',active);t.setAttribute('aria-selected',active);t.tabIndex=active?0:-1;const panel=document.getElementById(t.getAttribute('aria-controls'));panel.hidden=!active;panel.style.display=active?'block':'none'})}tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>activateTab(tab));tab.addEventListener('keydown',event=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(event.key)){event.preventDefault();let next=event.key==='Home'?0:event.key==='End'?tabs.length-1:(index+(event.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;activateTab(tabs[next]);tabs[next].focus()}})});
+document.querySelectorAll('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{const value=button.dataset.copy==='all'?cssSnippet():`font-size-adjust: ${toggle.getAttribute('aria-checked')==='true'?'from-font':'none'};`;try{await navigator.clipboard.writeText(value);const label=button.querySelector('span')||button;const old=label.textContent;label.textContent='Copied!';setTimeout(()=>label.textContent=old,1600)}catch{const label=button.querySelector('span')||button;label.textContent='Select CSS to copy'}}));update();
