+  <script>
+    const roast = document.getElementById('roast');
+    const orderNow = document.getElementById('order-now');
+    roast.addEventListener('change', () => {
+      orderNow.href = '/order-online?roast=' + encodeURIComponent(roast.value);
+    });
+
+    // Keep the three-column picker in browsers without customizable selects.
+    if (!CSS.supports('appearance', 'base-select')) {
+      const field = roast.parentElement;
+      const label = field.querySelector('label');
+      const trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.id = 'roast-trigger';
+      trigger.className = 'roast-trigger';
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-controls', 'roast-menu');
+      label.htmlFor = trigger.id;
+      label.id = 'roast-label';
+      const menu = document.createElement('div');
+      menu.id = 'roast-menu';
+      menu.className = 'roast-menu';
+      menu.role = 'listbox';
+      menu.setAttribute('aria-labelledby', label.id);
+      menu.setAttribute('aria-orientation', 'horizontal');
+      menu.hidden = true;
+      const options = Array.from(roast.options);
+      const cards = options.map(option => {
+        const card = document.createElement('button');
+        card.type = 'button';
+        card.className = 'roast-option';
+        card.role = 'option';
+        card.tabIndex = -1;
+        card.setAttribute('aria-label', option.getAttribute('aria-label'));
+        const art = document.createElement('span');
+        art.className = 'roast-art roast-art--' + option.value;
+        art.setAttribute('aria-hidden', 'true');
+        const name = document.createElement('span');
+        name.className = 'roast-name';
+        name.textContent = option.value[0].toUpperCase() + option.value.slice(1);
+        const notes = document.createElement('span');
+        notes.className = 'roast-notes';
+        notes.textContent = option.dataset.notes;
+        card.append(art, name, notes);
+        card.addEventListener('click', () => {
+          roast.value = option.value;
+          roast.dispatchEvent(new Event('change', { bubbles: true }));
+          update();
+          close(true);
+        });
+        menu.append(card);
+        return card;
+      });
+      function update() {
+        trigger.textContent = options[roast.selectedIndex].value.replace(/^./, c => c.toUpperCase()) + ' roast';
+        cards.forEach((card, index) => {
+          card.setAttribute('aria-selected', String(index === roast.selectedIndex));
+        });
+      }
+      function close(restoreFocus = false) {
+        menu.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) trigger.focus();
+      }
+      function open() {
+        menu.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        cards[roast.selectedIndex].focus();
+      }
+      trigger.addEventListener('click', () => menu.hidden ? open() : close());
+      trigger.addEventListener('keydown', event => {
+        if (['ArrowDown', 'ArrowUp'].includes(event.key)) {
+          event.preventDefault();
+          open();
+        }
+      });
+      menu.addEventListener('keydown', event => {
+        const index = cards.indexOf(document.activeElement);
+        const forward = ['ArrowRight', 'ArrowDown'].includes(event.key);
+        const backward = ['ArrowLeft', 'ArrowUp'].includes(event.key);
+        if (forward || backward || event.key === 'Home' || event.key === 'End') {
+          event.preventDefault();
+          const next = event.key === 'Home' ? 0 : event.key === 'End' ? cards.length - 1
+            : (index + (forward ? 1 : -1) + cards.length) % cards.length;
+          cards[next].focus();
+        } else if (event.key === 'Escape') {
+          event.preventDefault();
+          close(true);
+        } else if (event.key.length === 1 && /[a-z]/i.test(event.key)) {
+          const next = options.findIndex(option => option.value.startsWith(event.key.toLowerCase()));
+          if (next >= 0) cards[next].focus();
+        }
+      });
+      document.addEventListener('click', event => {
+        if (!field.contains(event.target)) close();
+      });
+      field.addEventListener('focusout', event => {
+        if (!field.contains(event.relatedTarget)) close();
+      });
+      roast.hidden = true;
+      field.append(trigger, menu);
+      update();
+    }
+  </script>
