+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const menu = document.getElementById('roast-options');
+    const options = Array.from(menu.querySelectorAll('[role="option"]'));
+
+    function closePicker(returnFocus = false) {
+      menu.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (returnFocus) trigger.focus();
+    }
+
+    function openPicker() {
+      menu.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options.find(option => option.getAttribute('aria-selected') === 'true').focus();
+    }
+
+    function selectRoast(option) {
+      options.forEach(item => {
+        const selected = item === option;
+        item.setAttribute('aria-selected', String(selected));
+        item.tabIndex = selected ? 0 : -1;
+      });
+      document.getElementById('roast-value').textContent = option.querySelector('strong').textContent + ' roast';
+      document.getElementById('order-now').href = '/order-online?roast=' + option.dataset.roast;
+      closePicker(true);
+    }
+
+    trigger.addEventListener('click', () => menu.hidden ? openPicker() : closePicker());
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openPicker();
+      }
+    });
+    options.forEach(option => option.addEventListener('click', () => selectRoast(option)));
+    menu.addEventListener('keydown', event => {
+      const index = options.indexOf(document.activeElement);
+      let next;
+      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % options.length;
+      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index + options.length - 1) % options.length;
+      if (event.key === 'Home') next = 0;
+      if (event.key === 'End') next = options.length - 1;
+      if (next !== undefined) {
+        event.preventDefault();
+        options[next].focus();
+      }
+      if ((event.key === 'Enter' || event.key === ' ') && index >= 0) {
+        event.preventDefault();
+        selectRoast(options[index]);
+      }
+    });
+    picker.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !menu.hidden) {
+        event.preventDefault();
+        closePicker(true);
+      }
+    });
+    document.addEventListener('click', event => {
+      if (!picker.contains(event.target)) closePicker();
+    });
+    picker.addEventListener('focusout', event => {
+      if (!picker.contains(event.relatedTarget)) closePicker();
+    });
+  </script>
