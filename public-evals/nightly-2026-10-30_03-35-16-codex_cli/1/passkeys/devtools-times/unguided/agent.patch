+import { useEffect, useState } from 'react';
+import { api, authenticate, registerPasskey, supportsPasskeys, errorMessage } from '../lib/auth-client';
+import { FingerPrintIcon, ArrowRightIcon, ShieldCheckIcon, CheckIcon } from './AccountIcons';
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState('');
+  const [supported, setSupported] = useState(false);
+  const [created, setCreated] = useState(false);
+  const base = import.meta.env.BASE_URL;
+  useEffect(() => setSupported(supportsPasskeys()), []);
+  const go = () => { window.location.href = `${base}account`; };
+  async function submit(e: React.FormEvent) {
+    e.preventDefault(); setError(''); setBusy('password');
+    try { await api(signup ? 'register' : 'login', { username, password }); if (signup) setCreated(true); else go(); }
+    catch (e) { setError(errorMessage(e)); } finally { setBusy(''); }
+  }
+  async function passkey() {
+    setError(''); setBusy('passkey');
+    try { if (created) await registerPasskey('My first passkey'); else await authenticate(); go(); }
+    catch (e) { setError(errorMessage(e)); } finally { setBusy(''); }
+  }
+  return <div className="auth-shell">
+    <div className="auth-intro"><span className="eyebrow">YOUR WORLD. BETTER INFORMED.</span><h1>Independent thinking.<br/><em>A personal connection.</em></h1><p>Make room for stories that matter. Your DevTools Times account keeps everything in one place.</p><div className="auth-benefit"><ShieldCheckIcon/><span>A little more secure.<br/><strong>A lot less to remember.</strong></span></div><p className="auth-caption">Sign in with your fingerprint, face, or device PIN.<br/>Your passkey stays yours. Always.</p><div className="auth-ornament">T<span>THE DEVTOOLS TIMES</span></div></div>
+    <div className="auth-form-panel"><a className="back-link" href={base}>← Back to the Times</a>
+    <div className="icon-tile"><FingerPrintIcon/></div>
+    <h2>{created ? 'Welcome to the Times.' : signup ? 'A fresh perspective starts here.' : 'Welcome back.'}</h2>
+    <p className="muted">{created ? 'Your account is ready. Make your next sign-in effortless with a passkey.' : signup ? 'Create your free account and stay curious.' : 'Sign in to pick up where you left off.'}</p>
+    {error && <div className="notice error" role="alert">{error}</div>}
+    {created ? <><div className="notice success"><CheckIcon/> Account created successfully</div><button className="primary-btn full" onClick={passkey} disabled={!!busy || !supported}><FingerPrintIcon/>{busy ? 'Waiting for your device…' : 'Create a passkey'}</button><p className="field-help">Use your fingerprint, face, or device PIN. No password to type.</p><button className="text-btn full" onClick={go} disabled={!!busy}>I’ll do this later <ArrowRightIcon/></button></> : <>
+    {!signup && <><button className="primary-btn full" disabled={!!busy || !supported} onClick={passkey}><FingerPrintIcon/>{busy === 'passkey' ? 'Waiting for your device…' : 'Sign in with a passkey'}<ArrowRightIcon/></button><p className="field-help">Quick, secure, and no password required.</p><div className="form-divider"><span>or use your password</span></div></>}
+    <form onSubmit={submit}><label htmlFor="username">Username</label><input id="username" name="username" autoComplete="username webauthn" placeholder="Enter your username" required maxLength={100} value={username} onChange={e => setUsername(e.target.value)} disabled={!!busy}/><label htmlFor="password">Password</label><input id="password" name="password" autoComplete={signup ? 'new-password' : 'current-password'} type="password" placeholder={signup ? 'Create a password' : 'Enter your password'} required minLength={signup ? 8 : undefined} pattern={signup ? '(?=.*[0-9]).{8,}' : undefined} value={password} onChange={e => setPassword(e.target.value)} disabled={!!busy}/>{signup && <p className="field-help left">At least 8 characters, including a number.</p>}<button className={`${signup ? 'primary-btn' : 'secondary-btn'} full`} disabled={!!busy} type="submit">{busy === 'password' ? 'Please wait…' : signup ? 'Create account' : 'Sign in with password'}<ArrowRightIcon/></button></form>
+    <p className="auth-switch">{signup ? 'Already a reader?' : 'New to the Times?'} <a href={`${base}${signup ? 'signin' : 'signup'}`}>{signup ? 'Sign in' : 'Create an account'}</a></p></>}
+    {!supported && <p className="notice">Passkeys need a supported browser and a secure connection. You can still use your password.</p>}
+    <p className="auth-terms">By continuing, you agree to our <a href={`${base}legal/terms`}>Terms of Service</a> and <a href={`${base}legal/privacy`}>Privacy Policy</a>.</p></div>
+  </div>;
+}
