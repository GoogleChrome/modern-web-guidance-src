+++ b/src/lib/auth-client.ts
@@ -0,0 +1,25 @@
+import { startAuthentication, startRegistration, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+export type Account = { username: string; createdAt: string; passkeys: { id: string; name: string; createdAt: string; lastUsedAt?: string; backedUp: boolean; transports?: string[] }[] };
+export class AuthError extends Error { reauthenticate = false; }
+export async function api(action: string, body?: unknown) {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/auth/${action}`, { method: body === undefined ? 'GET' : 'POST', headers: { 'Content-Type': 'application/json' }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
+  const data = await response.json();
+  if (!response.ok) { const error = new AuthError(data.error || 'Something went wrong. Please try again.'); error.reauthenticate = !!data.reauthenticate; throw error; }
+  return data;
+}
+export function supportsPasskeys() { return window.isSecureContext && browserSupportsWebAuthn(); }
+export async function authenticate(reauthenticate = false) {
+  const optionsJSON = await api('passkeys/authenticate/options', { reauthenticate });
+  const credential = await startAuthentication({ optionsJSON });
+  return api('passkeys/authenticate/verify', { credential });
+}
+export async function registerPasskey(name: string) {
+  const optionsJSON = await api('passkeys/register/options', {});
+  const credential = await startRegistration({ optionsJSON });
+  return api('passkeys/register/verify', { credential, name });
+}
+export function errorMessage(error: any) {
+  if (error.name === 'NotAllowedError' || error.code === 'ERROR_CEREMONY_ABORTED') return 'The passkey request was canceled or timed out. You can try again.';
+  if (error.name === 'InvalidStateError') return 'A passkey already exists on this device. Try another device or sign in.';
+  return error.message || 'Something went wrong. Please try again.';
+}
diff --git a/src/lib/auth-store.ts b/src/lib/auth-store.ts
new file mode 100644
index 0000000..fb142cc
--- /dev/null
+++ b/src/lib/auth-store.ts
@@ -0,0 +1,42 @@
+import { randomBytes, scryptSync, timingSafeEqual } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+
+export type Passkey = { id: string; publicKey: string; counter: number; transports?: string[]; name: string; createdAt: string; lastUsedAt?: string; backedUp: boolean };
+export type User = { id: string; username: string; password: string; passkeys: Passkey[]; createdAt: string };
+export type Session = { userId?: string; expires: number; verifiedAt?: number; challenge?: { value: string; kind: string; expires: number } };
+const sessions = new Map<string, Session>();
+const attempts = new Map<string, { count: number; expires: number }>();
+const file = resolve(process.env.AUTH_DATA_FILE || '.data/accounts.json');
+let queue: Promise<unknown> = Promise.resolve();
+export async function database<T>(fn: (users: User[]) => T | Promise<T>): Promise<T> {
+  const task = queue.then(async () => {
+    let users: User[];
+    try { users = JSON.parse(await readFile(file, 'utf8')); }
+    catch (error: any) { if (error.code !== 'ENOENT') throw error; users = []; }
+    const result = await fn(users);
+    await mkdir(dirname(file), { recursive: true, mode: 0o700 });
+    await writeFile(`${file}.tmp`, JSON.stringify(users), { mode: 0o600 });
+    await rename(`${file}.tmp`, file);
+    return result;
+  });
+  queue = task.catch(() => {});
+  return task;
+}
+export function newSession(userId?: string) {
+  for (const [key, value] of sessions) if (value.expires < Date.now()) sessions.delete(key);
+  const id = randomBytes(32).toString('hex');
+  const session: Session = { userId, expires: Date.now() + 86400000, verifiedAt: userId ? Date.now() : undefined };
+  sessions.set(id, session);
+  return { id, session };
+}
+export function getSession(id?: string) { const s = id ? sessions.get(id) : undefined; return s && s.expires > Date.now() ? s : undefined; }
+export function deleteSession(id: string) { sessions.delete(id); }
+export function hashPassword(password: string) { const salt = randomBytes(16).toString('hex'); return `${salt}:${scryptSync(password, salt, 64).toString('hex')}`; }
+export function checkPassword(password: string, stored: string) { const [salt, hash] = stored.split(':'); return timingSafeEqual(scryptSync(password, salt, 64), Buffer.from(hash, 'hex')); }
+export function rateLimit(key: string) {
+  for (const [k, v] of attempts) if (v.expires < Date.now()) attempts.delete(k);
+  const entry = attempts.get(key) || { count: 0, expires: Date.now() + 60000 };
+  entry.count++; attempts.set(key, entry);
+  if (entry.count > 20) throw new Error('Too many attempts. Please wait a minute and try again.');
+}
