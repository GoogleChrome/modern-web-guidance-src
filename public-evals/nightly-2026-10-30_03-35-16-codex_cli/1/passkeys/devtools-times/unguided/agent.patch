new file mode 100644
index 0000000..0876a72
--- /dev/null
+++ b/src/pages/api/auth/[...action].ts
@@ -0,0 +1,91 @@
+import type { APIRoute } from 'astro';
+import { randomUUID } from 'node:crypto';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { database, newSession, getSession, deleteSession, hashPassword, checkPassword, rateLimit } from '../../../lib/auth-store';
+
+export const prerender = false;
+export const ALL: APIRoute = async ({ request, cookies, params, url }) => {
+  const respond = (data: unknown, status = 200) => new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } });
+  const action = params.action;
+  const origin = process.env.AUTH_ORIGIN || url.origin;
+  const rpID = new URL(origin).hostname;
+  let sid = cookies.get('times_session')?.value;
+  let session = getSession(sid);
+  const setSession = (userId?: string) => {
+    if (sid) deleteSession(sid);
+    const fresh = newSession(userId); sid = fresh.id; session = fresh.session;
+    cookies.set('times_session', sid, { path: import.meta.env.BASE_URL, httpOnly: true, sameSite: 'lax', secure: url.protocol === 'https:', maxAge: 86400 });
+  };
+  const publicUser = (u: any) => ({ username: u.username, createdAt: u.createdAt, passkeys: u.passkeys.map(({ publicKey, counter, ...p }: any) => p) });
+  try {
+    if (request.method === 'GET' && action === 'session') {
+      return await database(users => { const user = users.find(u => u.id === session?.userId); return respond({ user: user ? publicUser(user) : null, authenticated: !!user }); });
+    }
+    if (request.method !== 'POST') return respond({ error: 'Method not allowed.' }, 405);
+    if (request.headers.get('origin') !== origin) return respond({ error: 'Invalid request origin.' }, 403);
+    rateLimit(`${request.headers.get('x-forwarded-for')?.split(',')[0] || 'local'}:${action}`);
+    const body = await request.json();
+    if (action === 'logout') { if (sid) deleteSession(sid); cookies.delete('times_session', { path: import.meta.env.BASE_URL }); return respond({ ok: true }); }
+    return await database(async users => {
+      let user = users.find(u => u.id === session?.userId);
+      if (action === 'register' || action === 'login') {
+        const username = String(body.username || '').trim().toLowerCase();
+        const password = String(body.password || '');
+        if (!username || username.length > 100 || password.length > 256) throw new Error('Enter a valid username and password.');
+        if (action === 'register') {
+          if (password.length < 8 || !/\d/.test(password)) throw new Error('Use at least 8 characters and one number for your password.');
+          if (users.some(u => u.username === username)) throw new Error('This username is already taken. Try another or sign in.');
+          user = { id: randomUUID(), username, password: hashPassword(password), passkeys: [], createdAt: new Date().toISOString() }; users.push(user);
+        } else {
+          user = users.find(u => u.username === username);
+          if (!checkPassword(password, user?.password || hashPassword('invalid-password')) || !user) throw new Error('The username or password is incorrect.');
+        }
+        setSession(user.id); return respond({ user: publicUser(user), authenticated: true });
+      }
+      if (action === 'passkeys/authenticate/options') {
+        if (!session) setSession();
+        if (body.reauthenticate && !user) return respond({ error: 'Please sign in again.' }, 401);
+        const options = await generateAuthenticationOptions({ rpID, userVerification: 'required', ...(body.reauthenticate ? { allowCredentials: user!.passkeys.map(p => ({ id: p.id, transports: p.transports as any })) } : {}) });
+        session!.challenge = { value: options.challenge, kind: body.reauthenticate ? 'reauthenticate' : 'authenticate', expires: Date.now() + 300000 };
+        return respond(options);
+      }
+      if (action === 'passkeys/authenticate/verify') {
+        const challenge = session?.challenge; delete session?.challenge;
+        if (!challenge || !['authenticate', 'reauthenticate'].includes(challenge.kind) || challenge.expires < Date.now()) throw new Error('Your request expired. Please try again.');
+        const owner = users.find(u => u.passkeys.some(p => p.id === body.credential?.id));
+        const key = owner?.passkeys.find(p => p.id === body.credential?.id);
+        if (!owner || !key || (challenge.kind === 'reauthenticate' && owner.id !== session?.userId)) throw new Error('This passkey does not match your account.');
+        const result = await verifyAuthenticationResponse({ response: body.credential, expectedChallenge: challenge.value, expectedOrigin: origin, expectedRPID: rpID, credential: { id: key.id, publicKey: new Uint8Array(Buffer.from(key.publicKey, 'base64url')), counter: key.counter, transports: key.transports as any }, requireUserVerification: true });
+        if (!result.verified) throw new Error('We could not verify your passkey.');
+        key.counter = result.authenticationInfo.newCounter; key.lastUsedAt = new Date().toISOString();
+        setSession(owner.id); return respond({ user: publicUser(owner), authenticated: true });
+      }
+      if (!user || !session) return respond({ error: 'Sign in to manage your account.' }, 401);
+      if (action === 'reauthenticate') {
+        if (!checkPassword(String(body.password || ''), user.password)) throw new Error('The password is incorrect. Please try again.');
+        session.verifiedAt = Date.now(); return respond({ ok: true });
+      }
+      if (!session.verifiedAt || Date.now() - session.verifiedAt > 300000) return respond({ error: 'Please verify it’s you to continue.', reauthenticate: true }, 403);
+      if (action === 'passkeys/register/options') {
+        const options = await generateRegistrationOptions({ rpName: 'The DevTools Times', rpID, userID: new TextEncoder().encode(user.id), userName: user.username, attestationType: 'none', excludeCredentials: user.passkeys.map(p => ({ id: p.id, transports: p.transports as any })), authenticatorSelection: { residentKey: 'required', userVerification: 'required' } });
+        session.challenge = { value: options.challenge, kind: 'register', expires: Date.now() + 300000 }; return respond(options);
+      }
+      if (action === 'passkeys/register/verify') {
+        const challenge = session.challenge; delete session.challenge;
+        if (!challenge || challenge.kind !== 'register' || challenge.expires < Date.now()) throw new Error('Your request expired. Please try again.');
+        const result = await verifyRegistrationResponse({ response: body.credential, expectedChallenge: challenge.value, expectedOrigin: origin, expectedRPID: rpID, requireUserVerification: true });
+        if (!result.verified) throw new Error('We could not verify your new passkey.');
+        const { credential, credentialBackedUp } = result.registrationInfo;
+        if (users.some(u => u.passkeys.some(p => p.id === credential.id))) throw new Error('This passkey is already registered.');
+        user.passkeys.push({ id: credential.id, publicKey: Buffer.from(credential.publicKey).toString('base64url'), counter: credential.counter, transports: credential.transports, name: String(body.name || 'My passkey').trim().slice(0, 60) || 'My passkey', backedUp: credentialBackedUp, createdAt: new Date().toISOString() });
+        return respond({ user: publicUser(user) });
+      }
+      const key = user.passkeys.find(p => p.id === body.id);
+      if (!key) throw new Error('Passkey not found. Refresh and try again.');
+      if (action === 'passkeys/rename') { const name = String(body.name || '').trim().slice(0, 60); if (!name) throw new Error('Enter a name for this passkey.'); key.name = name; }
+      else if (action === 'passkeys/remove') user.passkeys = user.passkeys.filter(p => p.id !== key.id);
+      else return respond({ error: 'Not found.' }, 404);
+      return respond({ user: publicUser(user) });
+    });
+  } catch (error: any) { return respond({ error: error.message?.includes('Too many') ? error.message : error.name === 'Error' ? error.message : 'We couldn’t complete this request. Please try again.' }, 400); }
+};
