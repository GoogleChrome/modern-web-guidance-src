+import { MODES, createRecipient, destroyRecipient, publicKeys, importRecipient, fingerprint, sealNote, openNote } from './crypto.js';
+
+const $ = id => document.getElementById(id);
+let recipient, envelope, busy = false;
+const note = $('note');
+const descriptions = {
+  classical: 'Established elliptic-curve protection for your private note.',
+  hybrid: 'Two layers of key protection. One private note.',
+  quantum: 'Post-quantum key encapsulation for your private note.',
+};
+function status(message, error = false) {
+  $('message').textContent = message;
+  $('message').classList.toggle('error', error);
+}
+function clearResult() {
+  envelope = undefined;
+  $('encrypted-result').hidden = true;
+  $('revealed-note').textContent = '';
+  $('revealed-note').hidden = true;
+  $('reveal-note').textContent = 'Reveal note';
+}
+function download(value, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(value, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a');
+  link.href = url; link.download = filename; link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+async function showFingerprint() {
+  const selected = document.querySelector('input[name="protection"]:checked').value;
+  const current = recipient;
+  const digest = await fingerprint(current.keys[selected].publicKey);
+  if (current === recipient) $('recipient-fingerprint').textContent = `${MODES[selected].name} recipient · SHA-256: ${digest.match(/.{1,4}/g).join(' ')}`;
+}
+function setRecipient(next) {
+  destroyRecipient(recipient);
+  recipient = next;
+  clearResult(); status('');
+  $('session-label').textContent = recipient.local
+    ? 'Local preview · Keys and notes stay in memory for this visit. Nothing is sent or saved to an order.'
+    : 'Recipient keys imported · Verify the fingerprint with your delivery team. Export your encrypted note to share it.';
+  $('recipient-json').value = '';
+  $('recipient-error').textContent = '';
+  showFingerprint().catch(error => status(error.message, true));
+}
+
+note.addEventListener('input', () => {
+  $('character-count').textContent = `${note.value.length} / 500`;
+  note.setCustomValidity('');
+});
+document.querySelectorAll('input[name="protection"]').forEach(input => input.addEventListener('change', () => {
+  document.querySelectorAll('.protection-option').forEach(option => option.classList.toggle('selected', option.querySelector('input').checked));
+  $('protection-description').textContent = descriptions[input.value];
+  if (recipient) showFingerprint().catch(error => status(error.message, true));
+}));
+$('note-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy || !recipient) return;
+  if (!note.value.trim()) { note.setCustomValidity('Please write a delivery note first.'); note.reportValidity(); return; }
+  busy = true;
+  $('encrypt-button').disabled = true;
+  $('recipient-settings').disabled = true;
+  status('Encrypting securely on your device…');
+  clearResult();
+  const text = note.value;
+  const mode = document.querySelector('input[name="protection"]:checked').value;
+  try {
+    envelope = await sealNote(text, mode, recipient);
+    $('result-algorithm').textContent = `${MODES[mode].name} · AES-256-GCM`;
+    $('result-description').textContent = recipient.local
+      ? 'Encrypted for this local session. You can reveal it here or export the ciphertext. Reloading discards the preview key, so exported preview notes cannot be reopened afterward.'
+      : 'Encrypted for your imported recipient. Export the encrypted note and share it with your delivery team. Nothing has been sent from this page.';
+    $('reveal-note').hidden = !recipient.local;
+    $('encrypted-result').hidden = false;
+    // Avoid discarding newer text entered while encryption was in progress.
+    if (note.value === text) { note.value = ''; $('character-count').textContent = '0 / 500'; }
+    status('');
+  } catch (error) { status(`Could not encrypt your note. ${error.message}`, true); }
+  finally { busy = false; $('encrypt-button').disabled = false; $('recipient-settings').disabled = false; }
+});
+$('reveal-note').addEventListener('click', async () => {
+  if (!envelope || busy) return;
+  if (!$('revealed-note').hidden) {
+    $('revealed-note').textContent = ''; $('revealed-note').hidden = true; $('reveal-note').textContent = 'Reveal note'; return;
+  }
+  const current = envelope;
+  try {
+    const plaintext = await openNote(current, recipient);
+    if (current !== envelope) return;
+    $('revealed-note').textContent = plaintext;
+    $('revealed-note').hidden = false;
+    $('reveal-note').textContent = 'Hide note';
+  } catch { status('This note could not be authenticated. Its contents or recipient key may have changed.', true); }
+});
+$('download-note').addEventListener('click', () => { if (envelope) download(envelope, 'daily-grind-encrypted-note.json'); });
+$('delete-note').addEventListener('click', () => { clearResult(); status('Encrypted note deleted from this session.'); note.focus(); });
+for (const id of ['learn-more', 'footer-privacy']) $(id).addEventListener('click', () => $('privacy-dialog').showModal());
+$('recipient-settings').addEventListener('click', () => { if (!busy) $('recipient-dialog').showModal(); });
+document.querySelectorAll('dialog').forEach(dialog => {
+  dialog.querySelector('.dialog-close').addEventListener('click', () => dialog.close());
+  dialog.addEventListener('click', event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
+});
+$('import-recipient').addEventListener('click', () => {
+  if (busy) return;
+  try {
+    const value = $('recipient-json').value.trim();
+    if (!value) throw new Error('Paste the public-key JSON supplied by your delivery team.');
+    if (value.length > 16000) throw new Error('The public-key file is too large.');
+    setRecipient(importRecipient(value));
+    $('recipient-dialog').close();
+    status('Recipient keys imported. Verify their fingerprint in Recipient settings before encrypting.');
+  } catch (error) { $('recipient-error').textContent = error.message; }
+});
+$('use-preview').addEventListener('click', () => {
+  if (busy) return;
+  try { setRecipient(createRecipient()); $('recipient-dialog').close(); status('New local preview keys created.'); }
+  catch (error) { $('recipient-error').textContent = error.message; }
+});
+$('export-public').addEventListener('click', () => { if (recipient) download(publicKeys(recipient), 'daily-grind-recipient-public-keys.json'); });
+try { setRecipient(createRecipient()); }
+catch (error) {
+  $('encrypt-button').disabled = true;
+  $('recipient-settings').disabled = true;
+  status(error.message, true);
+}
diff --git a/src/crypto.js b/src/crypto.js
new file mode 100644
index 0000000..658809a
--- /dev/null
+++ b/src/crypto.js
@@ -0,0 +1,119 @@
+import { x25519 } from '@noble/curves/ed25519.js';
+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+import { ml_kem768_x25519 } from '@noble/post-quantum/hybrid.js';
+
+const utf8 = new TextEncoder();
+export const MODES = Object.freeze({
+  classical: { name: 'Classic', algorithm: 'X25519', length: 32 },
+  hybrid: { name: 'Hybrid', algorithm: 'X-Wing (X25519 + ML-KEM-768)', kem: ml_kem768_x25519, length: ml_kem768_x25519.lengths.publicKey },
+  quantum: { name: 'Post-quantum', algorithm: 'ML-KEM-768', kem: ml_kem768, length: ml_kem768.lengths.publicKey },
+});
+export function toBase64(bytes) { return btoa(String.fromCharCode(...bytes)); }
+export function fromBase64(value) {
+  if (typeof value !== 'string' || value.length > 12000 || !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(value)) throw new Error('Invalid Base64 key data.');
+  return Uint8Array.from(atob(value), c => c.charCodeAt(0));
+}
+function modeConfig(mode) {
+  if (!Object.hasOwn(MODES, mode)) throw new Error('Unknown protection mode.');
+  return MODES[mode];
+}
+function ensureCrypto() {
+  if (!globalThis.crypto?.subtle) throw new Error('Encryption requires HTTPS or localhost and a browser with Web Crypto support.');
+}
+export function createRecipient() {
+  ensureCrypto();
+  return { local: true, keys: Object.fromEntries(Object.entries(MODES).map(([mode, config]) => [mode, config.kem ? config.kem.keygen() : x25519.keygen()])) };
+}
+export function destroyRecipient(recipient) {
+  for (const key of Object.values(recipient?.keys ?? {})) key.secretKey?.fill(0);
+}
+export function publicKeys(recipient) {
+  return { version: 1, ...Object.fromEntries(Object.keys(MODES).map(mode => [mode, toBase64(recipient.keys[mode].publicKey)])) };
+}
+export function importRecipient(json) {
+  ensureCrypto();
+  const input = JSON.parse(json);
+  if (!input || input.version !== 1) throw new Error('Use a version 1 recipient public-key file.');
+  if (Object.keys(input).some(key => !['version', ...Object.keys(MODES)].includes(key))) throw new Error('Only version and the three public keys are allowed. Never include private keys.');
+  const keys = {};
+  for (const [mode, config] of Object.entries(MODES)) {
+    const publicKey = fromBase64(input[mode]);
+    if (publicKey.length !== config.length) throw new Error(`The ${config.name} public key must contain ${config.length} bytes.`);
+    // Validate the supplied public key using the primitive before accepting it.
+    if (config.kem) config.kem.encapsulate(publicKey).sharedSecret.fill(0);
+    else {
+      const ephemeral = x25519.keygen();
+      try { x25519.getSharedSecret(ephemeral.secretKey, publicKey).fill(0); }
+      finally { ephemeral.secretKey.fill(0); }
+    }
+    keys[mode] = { publicKey };
+  }
+  return { local: false, keys };
+}
+export async function fingerprint(publicKey) {
+  ensureCrypto();
+  const hash = new Uint8Array(await crypto.subtle.digest('SHA-256', publicKey));
+  return Array.from(hash, byte => byte.toString(16).padStart(2, '0')).join('');
+}
+function authenticatedHeader(envelope) {
+  const config = modeConfig(envelope.mode);
+  if (envelope.version !== 1 || envelope.algorithm !== config.algorithm || envelope.cipher !== 'AES-256-GCM' || envelope.kdf !== 'HKDF-SHA-256') throw new Error('Unsupported encrypted note format.');
+  return utf8.encode(JSON.stringify({
+    context: 'daily-grind/delivery-note/v1', version: envelope.version,
+    mode: envelope.mode, algorithm: envelope.algorithm, cipher: envelope.cipher,
+    kdf: envelope.kdf, recipient: envelope.recipient, salt: envelope.salt,
+    nonce: envelope.nonce, encapsulation: envelope.encapsulation,
+  }));
+}
+async function deriveKey(secret, salt, header, usage) {
+  const material = await crypto.subtle.importKey('raw', secret, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey({ name: 'HKDF', hash: 'SHA-256', salt, info: header }, material, { name: 'AES-GCM', length: 256 }, false, [usage]);
+}
+export async function sealNote(note, mode, recipient) {
+  ensureCrypto();
+  if (typeof note !== 'string' || !note.trim() || note.length > 500) throw new Error('Enter a note between 1 and 500 characters.');
+  const config = modeConfig(mode);
+  const publicKey = recipient.keys[mode].publicKey;
+  let sharedSecret, encapsulation;
+  if (config.kem) {
+    const result = config.kem.encapsulate(publicKey);
+    sharedSecret = result.sharedSecret;
+    encapsulation = result.cipherText;
+  } else {
+    const ephemeral = x25519.keygen();
+    try { sharedSecret = x25519.getSharedSecret(ephemeral.secretKey, publicKey); encapsulation = ephemeral.publicKey; }
+    finally { ephemeral.secretKey.fill(0); }
+  }
+  let plaintext;
+  try {
+    const salt = crypto.getRandomValues(new Uint8Array(32));
+    const nonce = crypto.getRandomValues(new Uint8Array(12));
+    const envelope = {
+      version: 1, mode, algorithm: config.algorithm, cipher: 'AES-256-GCM', kdf: 'HKDF-SHA-256',
+      recipient: await fingerprint(publicKey), salt: toBase64(salt), nonce: toBase64(nonce), encapsulation: toBase64(encapsulation),
+    };
+    const header = authenticatedHeader(envelope);
+    const key = await deriveKey(sharedSecret, salt, header, 'encrypt');
+    plaintext = utf8.encode(note);
+    const ciphertext = await crypto.subtle.encrypt({ name: 'AES-GCM', iv: nonce, additionalData: header, tagLength: 128 }, key, plaintext);
+    return { ...envelope, ciphertext: toBase64(new Uint8Array(ciphertext)) };
+  } finally { sharedSecret.fill(0); plaintext?.fill(0); }
+}
+export async function openNote(envelope, recipient) {
+  ensureCrypto();
+  const header = authenticatedHeader(envelope);
+  const config = modeConfig(envelope.mode);
+  const keys = recipient.keys[envelope.mode];
+  if (!keys.secretKey) throw new Error('Only the delivery team’s private key can open this note.');
+  if (await fingerprint(keys.publicKey) !== envelope.recipient) throw new Error('This note belongs to a different recipient.');
+  const nonce = fromBase64(envelope.nonce), salt = fromBase64(envelope.salt);
+  if (nonce.length !== 12 || salt.length !== 32) throw new Error('Invalid encrypted note parameters.');
+  const encapsulation = fromBase64(envelope.encapsulation);
+  const secret = config.kem ? config.kem.decapsulate(encapsulation, keys.secretKey) : x25519.getSharedSecret(keys.secretKey, encapsulation);
+  let plaintext;
+  try {
+    const key = await deriveKey(secret, salt, header, 'decrypt');
+    plaintext = new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-GCM', iv: nonce, additionalData: header, tagLength: 128 }, key, fromBase64(envelope.ciphertext)));
+    return new TextDecoder('utf-8', { fatal: true }).decode(plaintext);
+  } finally { secret.fill(0); plaintext?.fill(0); }
+}
