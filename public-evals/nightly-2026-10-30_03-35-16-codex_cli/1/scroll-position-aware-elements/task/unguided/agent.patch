diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -26,8 +26,64 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    .scroller {
+      position: relative;
+      height: 100vh;
+      height: 100dvh;
+      overflow-y: auto;
+    }
+
+    /* This marker leaves the scrollport after the first 120px. */
+    .scroll-marker {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 1px;
+      height: 120px;
+      pointer-events: none;
+    }
+
+    .back-to-top {
+      position: fixed;
+      right: max(24px, env(safe-area-inset-right));
+      bottom: max(24px, env(safe-area-inset-bottom));
+      z-index: 1001;
+      padding: 12px 18px;
+      border: 0;
+      border-radius: 999px;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      box-shadow: 0 4px 16px rgb(0 0 0 / 20%);
+      cursor: pointer;
+      opacity: 0;
+      visibility: hidden;
+      transform: translateY(16px);
+      pointer-events: none;
+      transition: opacity 200ms ease, transform 200ms ease,
+        visibility 200ms;
+    }
+
+    .back-to-top.is-visible {
+      opacity: 1;
+      visibility: visible;
+      transform: translateY(0);
+      pointer-events: auto;
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .back-to-top {
+        transition: none;
+      }
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
@@ -155,10 +211,12 @@
   </style>
 </head>
 
 <body>
+  <div class="scroller" role="region" aria-label="Coffee shop page" tabindex="0">
+  <span class="scroll-marker" aria-hidden="true"></span>
 
-  <nav>
+  <nav id="page-top" tabindex="-1">
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
       <li><a href="/locations">Locations</a></li>
@@ -206,7 +264,43 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button class="back-to-top" type="button" disabled aria-hidden="true">
+    <span aria-hidden="true">↑</span> Back to top
+  </button>
+  </div>
+
+  <script>
+    const scroller = document.querySelector('.scroller');
+    const backToTop = scroller.querySelector('.back-to-top');
+    const pageTop = scroller.querySelector('#page-top');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    // Observe a boundary instead of running work on every scroll event.
+    const observer = new IntersectionObserver(([entry]) => {
+      const visible = !entry.isIntersecting &&
+        entry.boundingClientRect.bottom <= entry.rootBounds.top;
+
+      // Disable immediately, even while the fade-out is still running.
+      if (!visible && document.activeElement === backToTop) {
+        pageTop.focus({ preventScroll: true });
+      }
+      backToTop.disabled = !visible;
+      backToTop.setAttribute('aria-hidden', String(!visible));
+      backToTop.classList.toggle('is-visible', visible);
+    }, { root: scroller, threshold: 0 });
+
+    observer.observe(scroller.querySelector('.scroll-marker'));
+
+    backToTop.addEventListener('click', () => {
+      pageTop.focus({ preventScroll: true });
+      scroller.scrollTo({
+        top: 0,
+        behavior: reducedMotion.matches ? 'instant' : 'smooth'
+      });
+    });
+  </script>
+
 </body>
 
 </html>
