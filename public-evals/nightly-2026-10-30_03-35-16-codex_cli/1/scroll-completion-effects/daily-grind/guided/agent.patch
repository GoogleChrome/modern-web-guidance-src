+  <script>
+    let activeNavigation;
+
+    async function scrollToTarget(top, signal) {
+      // Observe before scrolling so even a short scroll cannot be missed.
+      let finish;
+      const settled = new Promise((resolve) => {
+        let idleTimer;
+        finish = () => {
+          clearTimeout(idleTimer);
+          document.removeEventListener('scroll', onScroll);
+          document.removeEventListener('scrollend', finish);
+          signal.removeEventListener('abort', finish);
+          resolve();
+        };
+        const onScroll = () => {
+          clearTimeout(idleTimer);
+          idleTimer = setTimeout(finish, 120);
+        };
+        document.addEventListener('scroll', onScroll, { passive: true });
+        document.addEventListener('scrollend', finish);
+        signal.addEventListener('abort', finish, { once: true });
+        // Also handles destinations that need no movement.
+        onScroll();
+      });
+
+      try {
+        const result = window.scrollTo({
+          top,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+        if (result && typeof result.then === 'function') {
+          await result;
+          // Guard against root-scroller promises that resolve prematurely.
+          if (!signal.aborted && Math.abs(window.scrollY - top) > 1) await settled;
+        } else {
+          // Older browsers: scrollend, or an idle debounce reset by each scroll.
+          await settled;
+        }
+      } finally {
+        finish();
+      }
+    }
+
+    document.addEventListener('click', async (event) => {
+      const link = event.target.closest('a[href^="#"]');
+      if (!link || event.defaultPrevented || event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ||
+          link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
+      const target = document.getElementById(link.hash.slice(1));
+      if (!target) return;
+      event.preventDefault();
+
+      activeNavigation?.abort();
+      const navigation = new AbortController();
+      activeNavigation = navigation;
+      document.querySelectorAll('.is-arrived').forEach((element) => element.classList.remove('is-arrived'));
+
+      // User input cancels delayed effects so focus is never stolen afterward.
+      const cancel = () => navigation.abort();
+      const cancelOnKey = (keyEvent) => {
+        if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' ', 'Tab', 'Escape'].includes(keyEvent.key)) cancel();
+      };
+      const options = { passive: true, signal: navigation.signal };
+      window.addEventListener('wheel', cancel, options);
+      window.addEventListener('touchstart', cancel, options);
+      window.addEventListener('pointerdown', cancel, options);
+      window.addEventListener('keydown', cancelOnKey, { signal: navigation.signal });
+
+      const navHeight = document.querySelector('nav').getBoundingClientRect().height;
+      const maxTop = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
+      const top = Math.min(maxTop, Math.max(0, window.scrollY + target.getBoundingClientRect().top - navHeight - 20));
+      try {
+        await scrollToTarget(top, navigation.signal);
+        if (navigation.signal.aborted || activeNavigation !== navigation || Math.abs(window.scrollY - top) > 1) return;
+        history.pushState(null, '', link.hash);
+        target.focus({ preventScroll: true });
+        target.classList.add('is-arrived');
+      } finally {
+        navigation.abort();
+        if (activeNavigation === navigation) activeNavigation = null;
+      }
+    });
+  </script>
