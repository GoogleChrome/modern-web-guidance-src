+  <script>
+    const navigation = document.querySelector('nav');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let cancelNavigation = () => {};
+    let targetAnimation;
+
+    navigation.addEventListener('click', (event) => {
+      const link = event.target.closest('a[href^="#"]');
+      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      const target = document.getElementById(link.hash.slice(1));
+      if (!target) return;
+
+      event.preventDefault();
+      cancelNavigation();
+      targetAnimation?.cancel();
+
+      const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
+      const destination = Math.min(maxScroll, Math.max(0,
+        window.scrollY + target.getBoundingClientRect().top - navigation.getBoundingClientRect().height - 16));
+      let frame;
+      let lastPosition = window.scrollY;
+      let lastMovement = performance.now();
+      let moved = false;
+      const alreadyThere = Math.abs(lastPosition - destination) <= 1;
+      const controller = new AbortController();
+
+      const cleanup = () => {
+        cancelAnimationFrame(frame);
+        controller.abort();
+        cancelNavigation = () => {};
+      };
+
+      const cancel = () => {
+        cleanup();
+        // Stop any remaining native smooth scroll when the user takes control.
+        window.scrollTo({ top: window.scrollY, left: window.scrollX, behavior: 'instant' });
+      };
+      cancelNavigation = cancel;
+
+      for (const type of ['wheel', 'touchstart', 'pointerdown']) {
+        window.addEventListener(type, cancel, { passive: true, signal: controller.signal });
+      }
+      window.addEventListener('keydown', (event) => {
+        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'PageUp', 'PageDown', 'Home', 'End', ' ', 'Tab', 'Escape'].includes(event.key)) cancel();
+      }, { signal: controller.signal });
+
+      const finish = () => {
+        cleanup();
+        history.pushState(null, '', link.hash);
+        target.focus({ preventScroll: true });
+        if (!reducedMotion.matches) {
+          targetAnimation = target.animate([
+            { boxShadow: '0 0 0 5px rgba(255, 171, 64, 0.65)' },
+            { boxShadow: '0 0 0 12px rgba(255, 171, 64, 0)' }
+          ], { duration: 700, easing: 'ease-out' });
+        }
+      };
+
+      // Observe actual movement instead of guessing the browser's scroll duration.
+      // This also works in browsers without the scrollend event.
+      const waitForScroll = (now) => {
+        const position = window.scrollY;
+        if (position !== lastPosition) {
+          moved = true;
+          lastMovement = now;
+          lastPosition = position;
+        }
+        if (alreadyThere || ((moved || now - lastMovement >= 250) && now - lastMovement >= 120)) {
+          if (Math.abs(position - destination) <= 1) finish();
+          else cleanup();
+          return;
+        }
+        frame = requestAnimationFrame(waitForScroll);
+      };
+
+      window.scrollTo({ top: destination, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+      frame = requestAnimationFrame(waitForScroll);
+    });
+  </script>
+
