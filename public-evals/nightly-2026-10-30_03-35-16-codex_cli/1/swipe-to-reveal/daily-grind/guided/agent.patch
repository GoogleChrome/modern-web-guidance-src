+  <script>
+    for (const card of document.querySelectorAll('.swipe-reveal')) {
+      const content = card.querySelector('.drink-content');
+      const revealButton = card.querySelector('.reveal-actions');
+      const saveButton = card.querySelector('.save-drink');
+
+      const closeActions = () => {
+        revealButton.focus({ preventScroll: true });
+        card.scrollTo({ left: 0 });
+      };
+
+      revealButton.addEventListener('click', () => {
+        card.scrollTo({ left: card.scrollWidth - card.clientWidth });
+      });
+
+      content.addEventListener('focusin', (event) => {
+        if (event.target.matches(':focus-visible')) {
+          content.scrollIntoView({ block: 'nearest', inline: 'start' });
+        }
+      });
+
+      card.querySelector('.close-actions').addEventListener('click', closeActions);
+      card.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          closeActions();
+        }
+      });
+
+      saveButton.addEventListener('click', () => {
+        const saved = saveButton.getAttribute('aria-pressed') !== 'true';
+        saveButton.setAttribute('aria-pressed', String(saved));
+        saveButton.textContent = saved ? 'Saved' : 'Save drink';
+      });
+    }
+  </script>
+
