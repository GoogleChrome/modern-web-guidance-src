+  <script>
+    const drinkCards = document.querySelectorAll('.drink-card');
+
+    function setActionsOpen(card, open) {
+      const toggle = card.querySelector('.actions-toggle');
+      const actions = card.querySelector('.card-actions');
+      if (!open && actions.contains(document.activeElement)) toggle.focus();
+      toggle.setAttribute('aria-expanded', String(open));
+      actions.hidden = !open;
+    }
+
+    drinkCards.forEach((card) => {
+      const toggle = card.querySelector('.actions-toggle');
+      let gesture = null;
+      let suppressClickUntil = 0;
+
+      function openActions(open) {
+        if (open) {
+          drinkCards.forEach((other) => {
+            if (other !== card) setActionsOpen(other, false);
+          });
+        }
+        setActionsOpen(card, open);
+      }
+
+      toggle.addEventListener('click', () => {
+        openActions(toggle.getAttribute('aria-expanded') !== 'true');
+      });
+
+      card.addEventListener('pointerdown', (event) => {
+        if (!event.isPrimary || event.button !== 0) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY };
+      });
+
+      card.addEventListener('pointermove', (event) => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        // Let vertical gestures scroll the page without revealing actions.
+        if (Math.abs(dy) > 12 && Math.abs(dy) >= Math.abs(dx)) {
+          gesture = null;
+          return;
+        }
+        if (Math.abs(dx) > 12 && Math.abs(dx) > Math.abs(dy) * 1.5) {
+          card.setPointerCapture(event.pointerId);
+        }
+      });
+
+      card.addEventListener('pointerup', (event) => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        gesture = null;
+        if (Math.abs(dx) < 40 || Math.abs(dx) <= Math.abs(dy) * 1.5) return;
+        // A swipe only reveals or dismisses the tray; actions require a tap.
+        suppressClickUntil = Date.now() + 500;
+        openActions(toggle.getAttribute('aria-expanded') !== 'true');
+      });
+
+      card.addEventListener('pointercancel', () => { gesture = null; });
+      card.addEventListener('lostpointercapture', () => { gesture = null; });
+      card.addEventListener('click', (event) => {
+        if (event.detail !== 0 && Date.now() < suppressClickUntil) {
+          event.preventDefault();
+          event.stopImmediatePropagation();
+        }
+      }, true);
+      card.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') openActions(false);
+      });
+    });
+
+    document.addEventListener('click', (event) => {
+      drinkCards.forEach((card) => {
+        if (!card.contains(event.target)) setActionsOpen(card, false);
+      });
+    });
+  </script>
