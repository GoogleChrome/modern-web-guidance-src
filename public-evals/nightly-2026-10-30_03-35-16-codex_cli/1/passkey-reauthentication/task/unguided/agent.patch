+  <script>
+    const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+    const reauthStatus = document.getElementById('reauth-status');
+
+    function decodeBase64url(value) {
+      if (typeof value !== 'string' || !/^[A-Za-z0-9_-]+={0,2}$/.test(value)) {
+        throw new Error('The server returned invalid verification options.');
+      }
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/').replace(/=+$/, '');
+      const bytes = atob(base64 + '='.repeat((4 - base64.length % 4) % 4));
+      return Uint8Array.from(bytes, character => character.charCodeAt(0));
+    }
+
+    function encodeBase64url(value) {
+      const bytes = new Uint8Array(value);
+      let binary = '';
+      for (const byte of bytes) binary += String.fromCharCode(byte);
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    reauthButton.addEventListener('click', async () => {
+      if (reauthButton.disabled) return;
+      reauthButton.disabled = true;
+      reauthStatus.textContent = 'Preparing identity verification…';
+
+      try {
+        if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.get) {
+          throw new Error('Use a browser that supports passkeys on a secure connection.');
+        }
+
+        // The session identifies the user. The server must generate a fresh,
+        // single-use challenge and list only that user's registered credentials.
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify({})
+        });
+        if (!optionsResponse.ok) throw new Error('Unable to start verification. Please try again.');
+
+        const optionsJSON = await optionsResponse.json();
+        const options = optionsJSON.publicKey ?? optionsJSON;
+        // An absent or empty allowCredentials list would allow account discovery
+        // instead of restricting this ceremony to the signed-in user's keys.
+        if (!Array.isArray(options.allowCredentials) || options.allowCredentials.length === 0) {
+          throw new Error('No registered passkey or security key is available for this account.');
+        }
+        const publicKey = {
+          ...options,
+          challenge: decodeBase64url(options.challenge),
+          allowCredentials: options.allowCredentials.map(credential => {
+            if (credential.type !== 'public-key') {
+              throw new Error('The server returned invalid verification options.');
+            }
+            return { ...credential, id: decodeBase64url(credential.id) };
+          }),
+          userVerification: 'required'
+        };
+
+        reauthStatus.textContent = 'Follow your browser’s prompt to use your passkey or security key.';
+        const assertion = await navigator.credentials.get({ publicKey });
+        if (!assertion || assertion.type !== 'public-key') {
+          throw new Error('Identity verification was not completed. Please try again.');
+        }
+
+        const response = assertion.response;
+        const payload = {
+          id: assertion.id,
+          rawId: encodeBase64url(assertion.rawId),
+          type: assertion.type,
+          response: {
+            clientDataJSON: encodeBase64url(response.clientDataJSON),
+            authenticatorData: encodeBase64url(response.authenticatorData),
+            signature: encodeBase64url(response.signature),
+            userHandle: response.userHandle == null ? null : encodeBase64url(response.userHandle)
+          },
+          clientExtensionResults: assertion.getClientExtensionResults()
+        };
+
+        reauthStatus.textContent = 'Verifying your identity…';
+        const verificationResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(payload)
+        });
+        if (!verificationResponse.ok) throw new Error('Identity verification failed. Please try again.');
+        const verification = await verificationResponse.json();
+        if (verification.verified !== true) {
+          throw new Error('Identity verification failed. Please try again.');
+        }
+        // The server must validate the signature, origin, RP ID, challenge,
+        // credential ownership and UV flag, then bind reauthentication to the
+        // session. Sensitive-change endpoints must enforce that server state.
+        reauthStatus.textContent = 'Identity confirmed. You can continue with your account change.';
+      } catch (error) {
+        reauthStatus.textContent = error.name === 'NotAllowedError' || error.name === 'AbortError'
+          ? 'Verification was canceled or timed out. Please try again.'
+          : error instanceof TypeError
+            ? 'Unable to complete verification. Check your connection and try again.'
+            : error.message || 'Unable to verify your identity. Please try again.';
+      } finally {
+        reauthButton.disabled = false;
+      }
+    });
+  </script>
