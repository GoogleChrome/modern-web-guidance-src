+  <button class="feedback-launcher" id="feedback-open" type="button" aria-haspopup="dialog" aria-controls="feedback-dialog">Share your thoughts &nbsp;↗</button>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackLauncher = document.getElementById('feedback-open');
+    const moveButton = document.getElementById('feedback-move');
+    const positionStatus = document.getElementById('feedback-position');
+
+    feedbackLauncher.addEventListener('click', () => {
+      if (!feedbackDialog.open) feedbackDialog.showModal();
+    });
+    function closeFeedback() {
+      feedbackDialog.close();
+      feedbackLauncher.focus({ preventScroll: true });
+    }
+    feedbackDialog.querySelector('.feedback-close').addEventListener('click', closeFeedback);
+    document.getElementById('feedback-done').addEventListener('click', closeFeedback);
+    feedbackDialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeFeedback();
+    });
+
+    moveButton.addEventListener('click', () => {
+      const movingLeft = feedbackDialog.parentElement.id === 'feedback-right';
+      const destination = document.getElementById(movingLeft ? 'feedback-left' : 'feedback-right');
+      const focusedElement = document.activeElement;
+      const wasOpen = feedbackDialog.open;
+      const wasModal = feedbackDialog.matches(':modal');
+      const returnValue = feedbackDialog.returnValue;
+      const scrollTop = feedbackDialog.scrollTop;
+      const scrollLeft = feedbackDialog.scrollLeft;
+      const selection = focusedElement instanceof HTMLTextAreaElement
+        ? [focusedElement.selectionStart, focusedElement.selectionEnd, focusedElement.selectionDirection]
+        : null;
+      const fieldScroll = selection ? [focusedElement.scrollTop, focusedElement.scrollLeft] : null;
+
+      if (typeof destination.moveBefore === 'function') {
+        // Both parents are connected to the same document. The native move
+        // preserves top-layer membership, modality, focus, and field state.
+        destination.moveBefore(feedbackDialog, null);
+      } else {
+        // An ordinary DOM move can lose top-layer state while leaving `open`
+        // set. Explicitly close first so showModal reliably restores modality.
+        if (wasOpen) feedbackDialog.close();
+        destination.appendChild(feedbackDialog);
+        if (wasOpen) {
+          if (wasModal) feedbackDialog.showModal();
+          else feedbackDialog.show();
+        }
+        feedbackDialog.returnValue = returnValue;
+        if (wasOpen && feedbackDialog.contains(focusedElement)) {
+          focusedElement.focus({ preventScroll: true });
+          if (selection) {
+            focusedElement.setSelectionRange(...selection);
+            [focusedElement.scrollTop, focusedElement.scrollLeft] = fieldScroll;
+          }
+        }
+        feedbackDialog.scrollTop = scrollTop;
+        feedbackDialog.scrollLeft = scrollLeft;
+      }
+
+      moveButton.textContent = movingLeft ? 'Move to right' : 'Move to left';
+      positionStatus.textContent = `On the ${movingLeft ? 'left' : 'right'} · Draft kept for this visit`;
+    });
+  </script>
