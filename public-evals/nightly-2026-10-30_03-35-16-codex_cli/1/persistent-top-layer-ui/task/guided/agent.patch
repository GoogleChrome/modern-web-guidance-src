@@ -206,7 +300,128 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button type="button" class="feedback-launcher" id="open-feedback" aria-haspopup="dialog" aria-controls="feedback-dialog">
+    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 11.5a8.5 8.5 0 0 1-8.5 8.5H4l1.3-4.1A8.5 8.5 0 1 1 20 11.5Z"/><path d="M8 10h8M8 14h5"/></svg>
+    Share feedback
+  </button>
+
+  <div id="feedback-left"></div>
+  <div id="feedback-right">
+    <dialog class="feedback-dialog" id="feedback-dialog" aria-labelledby="feedback-title" aria-describedby="feedback-description" closedby="closerequest">
+      <div class="feedback-heading">
+        <div class="feedback-topline">
+          <span class="feedback-eyebrow">A LITTLE FEEDBACK. A BETTER GRIND.</span>
+          <form method="dialog"><button type="submit" class="feedback-close" aria-label="Close feedback">&times;</button></form>
+        </div>
+        <h2 id="feedback-title">How was your daily grind?</h2>
+        <p class="feedback-description" id="feedback-description">Great coffee starts with a conversation.<br>We’d love to hear what’s on your mind.</p>
+      </div>
+      <form class="feedback-form" id="feedback-form">
+        <fieldset>
+          <legend>How are we doing?</legend>
+          <div class="feedback-ratings">
+            <label class="feedback-rating" for="rating-better"><input id="rating-better" type="radio" name="rating" value="Could be better"><span>Could be better</span></label>
+            <label class="feedback-rating" for="rating-good"><input id="rating-good" type="radio" name="rating" value="Pretty good"><span>Pretty good</span></label>
+            <label class="feedback-rating" for="rating-great"><input id="rating-great" type="radio" name="rating" value="Love it"><span>Love it!</span></label>
+          </div>
+        </fieldset>
+        <label for="feedback-message">Tell us a little more</label>
+        <textarea id="feedback-message" name="message" placeholder="A bright spot, a fresh idea, or something we can do better…" required maxlength="3000" autofocus></textarea>
+        <button class="feedback-save" type="submit">Save feedback <span aria-hidden="true">↗</span></button>
+        <p class="feedback-note">Saved on this device only. Nothing is sent to a server.</p>
+        <p class="feedback-status" id="feedback-status" role="status"></p>
+      </form>
+      <div class="feedback-bottom">
+        <span class="feedback-position" id="feedback-position" role="status">On the right · draft stays with you</span>
+        <button type="button" class="feedback-move" id="move-feedback">
+          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h16M8 8l-4 4 4 4m8-8 4 4-4 4"/></svg>
+          <span id="feedback-move-label">Move to left</span>
+        </button>
+      </div>
+    </dialog>
+  </div>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackLauncher = document.getElementById('open-feedback');
+    const feedbackStatus = document.getElementById('feedback-status');
+    let usedMoveFallback = false;
+
+    feedbackLauncher.addEventListener('click', () => {
+      usedMoveFallback = false;
+      feedbackDialog.showModal();
+    });
+
+    document.getElementById('move-feedback').addEventListener('click', () => {
+      const onRight = feedbackDialog.parentElement.id === 'feedback-right';
+      const target = document.getElementById(onRight ? 'feedback-left' : 'feedback-right');
+
+      if (typeof target.moveBefore === 'function') {
+        // An atomic move preserves the native top layer, modal state, and focus.
+        target.moveBefore(feedbackDialog, null);
+      } else {
+        const wasOpen = feedbackDialog.open;
+        const wasModal = feedbackDialog.matches(':modal');
+        const returnValue = feedbackDialog.returnValue;
+        const focused = document.activeElement;
+        const selection = focused instanceof HTMLTextAreaElement
+          ? [focused.selectionStart, focused.selectionEnd, focused.selectionDirection]
+          : null;
+        const scrollPositions = [feedbackDialog, ...feedbackDialog.querySelectorAll('textarea')]
+          .map(element => [element, element.scrollTop, element.scrollLeft]);
+
+        // Explicitly close first: removal can leave an open attribute without
+        // top-layer membership in some browsers. Reuse the same node and fields.
+        if (wasOpen) feedbackDialog.close();
+        target.insertBefore(feedbackDialog, null);
+        if (wasOpen) {
+          if (wasModal) feedbackDialog.showModal();
+          else feedbackDialog.show();
+          usedMoveFallback = true;
+          if (focused instanceof HTMLElement && feedbackDialog.contains(focused)) {
+            focused.focus({ preventScroll: true });
+            if (selection) focused.setSelectionRange(...selection);
+          }
+        }
+        feedbackDialog.returnValue = returnValue;
+        scrollPositions.forEach(([element, top, left]) => {
+          element.scrollTop = top;
+          element.scrollLeft = left;
+        });
+      }
+
+      const side = onRight ? 'left' : 'right';
+      document.getElementById('feedback-position').textContent = `On the ${side} · draft stays with you`;
+      document.getElementById('feedback-move-label').textContent = `Move to ${onRight ? 'right' : 'left'}`;
+    });
+
+    feedbackDialog.addEventListener('close', () => {
+      // Ignore the fallback's queued close event after the modal has reopened.
+      if (feedbackDialog.open) return;
+      feedbackDialog.returnValue = '';
+      // Reopening in the fallback replaces the browser's original invoker.
+      if (usedMoveFallback) feedbackLauncher.focus({ preventScroll: true });
+    });
+
+    document.getElementById('feedback-form').addEventListener('submit', event => {
+      event.preventDefault();
+      const data = new FormData(event.currentTarget);
+      try {
+        localStorage.setItem('daily-grind-feedback', JSON.stringify({
+          rating: data.get('rating'),
+          message: data.get('message'),
+          savedAt: new Date().toISOString()
+        }));
+        feedbackStatus.textContent = 'Thank you! Your feedback is saved on this device.';
+      } catch {
+        feedbackStatus.textContent = 'Couldn’t save on this device. Your draft is still here.';
+      }
+    });
+    document.getElementById('feedback-form').addEventListener('input', () => {
+      feedbackStatus.textContent = '';
+    });
+  </script>
 </body>
 
