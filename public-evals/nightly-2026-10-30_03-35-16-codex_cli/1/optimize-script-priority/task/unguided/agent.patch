diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,39 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Dashboard</title>
+    <script async src="/js/app.js"></script>
+    <script async src="/js/tracker.js"></script>
+    <style>
+      * { box-sizing: border-box; }
+      body { margin: 0; background: #fafafa; color: #202020; font: 15px/1.5 system-ui, sans-serif; }
+      main { max-width: 960px; margin: 80px auto; padding: 0 24px; }
+      header { margin-bottom: 40px; }
+      h1 { margin: 0 0 6px; font-size: 28px; font-weight: 600; letter-spacing: -1px; }
+      p { margin: 0; color: #737373; }
+      .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
+      article { padding: 24px; border: 1px solid #e5e5e5; border-radius: 8px; background: white; }
+      h2 { margin: 0 0 16px; color: #737373; font-size: 13px; font-weight: 500; }
+      strong { font-size: 30px; font-weight: 500; letter-spacing: -1px; }
+      footer { margin-top: 24px; color: #737373; font-size: 12px; }
+      @media (max-width: 600px) { main { margin-top: 40px; } .metrics { grid-template-columns: 1fr; } }
+    </style>
+  </head>
+  <body>
+    <main>
+      <header>
+        <h1>Dashboard</h1>
+        <p>A simple overview of your workspace.</p>
+      </header>
+      <section class="metrics" aria-label="Workspace overview">
+        <article><h2>Total projects</h2><strong>12</strong></article>
+        <article><h2>Active tasks</h2><strong>24</strong></article>
+        <article><h2>Completed</h2><strong>86</strong></article>
+      </section>
+      <footer>Workspace overview · Sample data</footer>
+    </main>
+    <script src="/js/legacy-widgets.js"></script>
+  </body>
+</html>
