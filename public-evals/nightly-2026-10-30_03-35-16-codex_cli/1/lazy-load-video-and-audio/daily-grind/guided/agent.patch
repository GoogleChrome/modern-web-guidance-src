diff --git a/media-loading.js b/media-loading.js
new file mode 100644
index 0000000..92903b7
--- /dev/null
+++ b/media-loading.js
@@ -0,0 +1,53 @@
+// URLs start in data attributes so the HTML preload scanner cannot fetch them.
+// This also protects poster images in browsers without native lazy media support.
+const deferredMedia = document.querySelectorAll('[data-deferred-media]');
+
+function activateMedia(media) {
+  if (!media.hasAttribute('data-deferred-media')) return;
+  media.removeAttribute('data-deferred-media');
+
+  if (media.dataset.poster) {
+    media.setAttribute('poster', media.dataset.poster);
+    delete media.dataset.poster;
+  }
+  media.preload = media.dataset.preload || 'none';
+  delete media.dataset.preload;
+
+  for (const source of media.querySelectorAll('source[data-src]')) {
+    source.setAttribute('src', source.dataset.src);
+    delete source.dataset.src;
+  }
+
+  // Changing an existing <source> requires load() to restart source selection.
+  // We only do this near the viewport (or after explicit user activation).
+  media.load();
+}
+
+const observer = 'IntersectionObserver' in window
+  ? new IntersectionObserver((entries) => {
+      for (const entry of entries) {
+        if (!entry.isIntersecting) continue;
+        activateMedia(entry.target);
+        observer.unobserve(entry.target);
+      }
+    }, { rootMargin: '200px 0px', threshold: 0 })
+  : null;
+
+for (const media of deferredMedia) {
+  // Use the same threshold in every browser, including native lazy loaders.
+  if (observer) {
+    observer.observe(media);
+  } else {
+    // Very old browsers retain strict deferral and offer explicit activation.
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = 'load-player';
+    button.textContent = media.tagName === 'VIDEO' ? 'Load video player' : 'Load podcast player';
+    button.addEventListener('click', () => {
+      activateMedia(media);
+      media.focus();
+      button.remove();
+    }, { once: true });
+    media.after(button);
+  }
+}
