+  <script>
+    (() => {
+      const hero = document.querySelector('[data-ambient]');
+      const toggle = document.querySelector('.hero-toggle');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let userPaused = false;
+
+      function hydrate(element) {
+        if (element.dataset.loaded) return;
+        element.dataset.loaded = 'true';
+        if (element.dataset.poster) element.poster = element.dataset.poster;
+        if (element.matches('img')) {
+          element.src = element.dataset.src;
+          return;
+        }
+        element.querySelectorAll('source[data-src]').forEach(source => {
+          source.src = source.dataset.src;
+        });
+        // Keep preload disabled, even after hydration. Playback is the only
+        // reason to fetch media data; posters can load as the player approaches.
+        element.load();
+      }
+
+      const deferred = document.querySelectorAll('[data-deferred-media], [data-deferred-image]');
+      if ('IntersectionObserver' in window) {
+        const loader = new IntersectionObserver(entries => {
+          entries.forEach(entry => {
+            if (!entry.isIntersecting) return;
+            hydrate(entry.target);
+            loader.unobserve(entry.target);
+          });
+        }, { rootMargin: '200px 0px', threshold: 0 });
+        deferred.forEach(element => loader.observe(element));
+      } else {
+        // Older browsers still defer assets until they are close to the view.
+        const pending = new Set(deferred);
+        const loadNearby = () => {
+          pending.forEach(element => {
+            const rect = element.getBoundingClientRect();
+            if (rect.top <= innerHeight + 200 && rect.bottom >= -200) {
+              hydrate(element);
+              pending.delete(element);
+            }
+          });
+          if (!pending.size) {
+            removeEventListener('scroll', loadNearby);
+            removeEventListener('resize', loadNearby);
+          }
+        };
+        addEventListener('scroll', loadNearby, { passive: true });
+        addEventListener('resize', loadNearby);
+        loadNearby();
+      }
+
+      function playHero() {
+        hydrate(hero);
+        hero.play().catch(() => { /* The play button remains available if autoplay is blocked. */ });
+      }
+      hero.addEventListener('play', () => { toggle.textContent = 'Pause background video'; });
+      hero.addEventListener('pause', () => { toggle.textContent = 'Play background video'; });
+      toggle.addEventListener('click', () => {
+        userPaused = !hero.paused;
+        if (hero.paused) playHero();
+        else hero.pause();
+      });
+      // Ambient playback runs only while the hero is actually visible.
+      if ('IntersectionObserver' in window) {
+        const playback = new IntersectionObserver(entries => {
+          if (entries[0].isIntersecting && !document.hidden && !reducedMotion.matches && !userPaused) playHero();
+          else hero.pause();
+        }, { threshold: 0.1 });
+        playback.observe(hero);
+      }
+      document.addEventListener('visibilitychange', () => { if (document.hidden) hero.pause(); });
+      reducedMotion.addEventListener('change', () => { if (reducedMotion.matches) hero.pause(); });
+    })();
+  </script>
