+  <script>
+    (function () {
+      var navigation = document.querySelector('nav');
+      var root = document.documentElement;
+      var motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var nativeScrollAnimation = window.CSS && typeof window.CSS.supports === 'function' &&
+        window.CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+      var framePending = false;
+
+      function reserveNavigationSpace() {
+        var style = window.getComputedStyle(navigation);
+        var rem = parseFloat(window.getComputedStyle(root).fontSize);
+        var expandedHeight = navigation.getBoundingClientRect().height -
+          parseFloat(style.paddingTop) - parseFloat(style.paddingBottom) + 2 * rem;
+        root.style.setProperty('--nav-expanded-height', expandedHeight + 'px');
+      }
+
+      function updateNavigation() {
+        framePending = false;
+        if (motionPreference.matches) {
+          navigation.style.paddingTop = '';
+          navigation.style.paddingBottom = '';
+          return;
+        }
+        var progress = Math.max(0, Math.min(1, (window.pageYOffset || 0) / 120));
+        var padding = (1 - 0.75 * progress) + 'rem';
+        navigation.style.paddingTop = padding;
+        navigation.style.paddingBottom = padding;
+      }
+
+      function scheduleUpdate() {
+        if (!framePending) {
+          framePending = true;
+          window.requestAnimationFrame(updateNavigation);
+        }
+      }
+
+      reserveNavigationSpace();
+      window.addEventListener('resize', reserveNavigationSpace);
+      window.addEventListener('pageshow', reserveNavigationSpace);
+
+      // Partial timeline support also uses this fallback. Native browsers need no scroll listener.
+      if (!nativeScrollAnimation) {
+        window.addEventListener('scroll', scheduleUpdate, { passive: true });
+        window.addEventListener('pageshow', scheduleUpdate);
+        if (motionPreference.addEventListener) {
+          motionPreference.addEventListener('change', scheduleUpdate);
+        } else {
+          motionPreference.addListener(scheduleUpdate);
+        }
+        updateNavigation();
+      }
+    }());
+  </script>
+
