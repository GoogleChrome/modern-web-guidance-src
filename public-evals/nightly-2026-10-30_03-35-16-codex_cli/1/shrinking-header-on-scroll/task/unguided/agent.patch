+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      var logo = nav.querySelector('.logo');
+      var shell = document.querySelector('.nav-shell');
+      var motion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
+      var nativeScroll = window.CSS && CSS.supports &&
+        CSS.supports('animation-timeline', 'scroll(root block)') &&
+        CSS.supports('animation-range', '0px 160px');
+      var framePending = false;
+      var requestFrame = window.requestAnimationFrame || function (callback) {
+        return window.setTimeout(callback, 16);
+      };
+
+      // Reserve the expanded height, including wrapped links, at every viewport size.
+      function measure() {
+        var navStyles = nav.style.cssText;
+        var logoStyles = logo.style.cssText;
+        nav.style.animation = logo.style.animation = 'none';
+        nav.style.paddingTop = nav.style.paddingBottom = '1rem';
+        logo.style.fontSize = '1.5rem';
+        shell.style.height = Math.ceil(nav.getBoundingClientRect().height) + 'px';
+        nav.style.cssText = navStyles;
+        logo.style.cssText = logoStyles;
+      }
+
+      function update() {
+        framePending = false;
+        if (!nativeScroll) {
+          var scroll = window.pageYOffset || document.documentElement.scrollTop || 0;
+          var progress = motion && motion.matches ? 0 : Math.max(0, Math.min(scroll / 160, 1));
+          nav.style.paddingTop = nav.style.paddingBottom = (1 - 0.625 * progress) + 'rem';
+          logo.style.fontSize = (1.5 - 0.25 * progress) + 'rem';
+        }
+      }
+
+      function scheduleUpdate() {
+        if (!framePending) {
+          framePending = true;
+          requestFrame(update);
+        }
+      }
+
+      measure();
+      update();
+      if (!nativeScroll) {
+        // Boolean capture also works in browsers predating passive event options.
+        window.addEventListener('scroll', scheduleUpdate, false);
+      }
+      window.addEventListener('resize', function () { measure(); scheduleUpdate(); }, false);
+      window.addEventListener('pageshow', scheduleUpdate, false);
+      if (motion) {
+        if (motion.addEventListener) motion.addEventListener('change', scheduleUpdate);
+        else if (motion.addListener) motion.addListener(scheduleUpdate);
+      }
+    }());
+  </script>
