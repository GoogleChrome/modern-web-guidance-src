+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+    let positionFrame;
+
+    function positionPanel() {
+      if (!panel.matches(':popover-open')) return;
+
+      // Fixed coordinates are relative to the layout viewport. Include the
+      // visual viewport offsets to handle zoom and on-screen keyboards too.
+      const viewport = window.visualViewport;
+      const viewportLeft = viewport?.offsetLeft ?? 0;
+      const viewportTop = viewport?.offsetTop ?? 0;
+      const viewportWidth = viewport?.width ?? document.documentElement.clientWidth;
+      const viewportHeight = viewport?.height ?? document.documentElement.clientHeight;
+      const gutter = Math.min(8, viewportWidth / 4, viewportHeight / 4);
+      const leftEdge = viewportLeft + gutter;
+      const rightEdge = viewportLeft + viewportWidth - gutter;
+      const topEdge = viewportTop + gutter;
+      const bottomEdge = viewportTop + viewportHeight - gutter;
+      const anchor = trigger.getBoundingClientRect();
+
+      panel.style.maxWidth = `${rightEdge - leftEdge}px`;
+      panel.style.maxHeight = `${bottomEdge - topEdge}px`;
+      const size = panel.getBoundingClientRect();
+      const below = Math.max(0, bottomEdge - anchor.bottom);
+      const above = Math.max(0, anchor.top - topEdge);
+      const flipUp = size.height > below && above > below;
+      const availableHeight = Math.min(bottomEdge - topEdge, flipUp ? above : below);
+      panel.style.maxHeight = `${availableHeight}px`;
+      const height = panel.getBoundingClientRect().height;
+
+      // Prefer below-left; flip to above or right-aligned when necessary.
+      let left = anchor.left;
+      if (left + size.width > rightEdge) left = anchor.right - size.width;
+      left = Math.max(leftEdge, Math.min(left, rightEdge - size.width));
+      let top = flipUp ? anchor.top - height : anchor.bottom;
+      top = Math.max(topEdge, Math.min(top, bottomEdge - height));
+
+      panel.style.left = `${left}px`;
+      panel.style.top = `${top}px`;
+      panel.setAttribute('data-positioned', '');
+    }
+
+    function schedulePosition() {
+      cancelAnimationFrame(positionFrame);
+      positionFrame = requestAnimationFrame(positionPanel);
+    }
+
+    panel.addEventListener('toggle', () => {
+      const open = panel.matches(':popover-open');
+      trigger.setAttribute('aria-expanded', String(open));
+      if (open) positionPanel();
+      else panel.removeAttribute('data-positioned');
+    });
+
+    window.addEventListener('resize', schedulePosition);
+    document.addEventListener('scroll', schedulePosition, true);
+    window.visualViewport?.addEventListener('resize', schedulePosition);
+    window.visualViewport?.addEventListener('scroll', schedulePosition);
+    const resizeObserver = new ResizeObserver(schedulePosition);
+    resizeObserver.observe(trigger);
+    resizeObserver.observe(panel);
+    resizeObserver.observe(document.querySelector('nav'));
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (!action) return;
+      panel.hidePopover();
+      window.location.assign(action.dataset.href);
+    });
+  </script>
