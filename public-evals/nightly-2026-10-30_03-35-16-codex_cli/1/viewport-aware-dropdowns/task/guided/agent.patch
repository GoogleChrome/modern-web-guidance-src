+  <script type="module">
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (action) window.location.assign(action.dataset.href);
+    });
+
+    // Keep older engines tethered to the trigger without an anchor polyfill.
+    const supportsAnchors = CSS.supports('anchor-name: --options-trigger') &&
+      CSS.supports('position-area: block-end span-inline-end') &&
+      CSS.supports('position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline');
+
+    if (!supportsAnchors) {
+      panel.style.positionArea = 'none';
+      panel.style.positionAnchor = 'auto';
+      let open = false;
+      const positionPanel = () => {
+        if (!open) return;
+        const viewport = window.visualViewport;
+        const leftEdge = (viewport?.offsetLeft ?? 0) + 8;
+        const topEdge = (viewport?.offsetTop ?? 0) + 8;
+        const rightEdge = leftEdge + (viewport?.width ?? window.innerWidth) - 16;
+        const bottomEdge = topEdge + (viewport?.height ?? window.innerHeight) - 16;
+        const rect = trigger.getBoundingClientRect();
+        panel.style.maxWidth = `${Math.max(0, rightEdge - leftEdge)}px`;
+        panel.style.maxHeight = `${Math.max(0, bottomEdge - topEdge)}px`;
+        const width = panel.offsetWidth;
+        const height = panel.offsetHeight;
+        const below = Math.max(0, bottomEdge - rect.bottom);
+        const above = Math.max(0, rect.top - topEdge);
+        const flipUp = height > below && above > below;
+        panel.style.maxHeight = `${flipUp ? above : below}px`;
+        const preferredLeft = rect.left + width > rightEdge ? rect.right - width : rect.left;
+        panel.style.left = `${Math.max(leftEdge, Math.min(preferredLeft, rightEdge - width))}px`;
+        const preferredTop = flipUp ? rect.top - panel.offsetHeight : rect.bottom;
+        panel.style.top = `${Math.max(topEdge, Math.min(preferredTop, bottomEdge - panel.offsetHeight))}px`;
+      };
+      panel.addEventListener('beforetoggle', (event) => {
+        open = event.newState === 'open';
+        if (open) requestAnimationFrame(positionPanel);
+      });
+      window.addEventListener('resize', positionPanel);
+      document.addEventListener('scroll', positionPanel, true);
+      window.visualViewport?.addEventListener('resize', positionPanel);
+      window.visualViewport?.addEventListener('scroll', positionPanel);
+      new ResizeObserver(positionPanel).observe(trigger);
+    }
+  </script>
+
