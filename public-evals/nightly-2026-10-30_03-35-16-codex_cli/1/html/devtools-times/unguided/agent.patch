diff --git a/src/utils/article-search.ts b/src/utils/article-search.ts
new file mode 100644
index 0000000..073bbd5
--- /dev/null
+++ b/src/utils/article-search.ts
@@ -0,0 +1,23 @@
+export interface SearchArticle {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+  imageSrcSet?: string;
+}
+
+let articlesRequest: Promise<SearchArticle[]> | undefined;
+
+// Both header dialogs load the index on demand and share one request per page.
+export function loadArticles() {
+  articlesRequest ??= fetch(`${import.meta.env.BASE_URL}api/articles.json`)
+    .then(response => {
+      if (!response.ok) throw new Error('Could not load articles. Please try again.');
+      return response.json() as Promise<SearchArticle[]>;
+    })
+    .catch(error => {
+      articlesRequest = undefined;
+      throw error;
+    });
+  return articlesRequest;
+}
