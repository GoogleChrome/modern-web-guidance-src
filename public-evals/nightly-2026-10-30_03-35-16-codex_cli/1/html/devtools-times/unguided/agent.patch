diff --git a/src/components/ModalDialog.tsx b/src/components/ModalDialog.tsx
new file mode 100644
index 0000000..fb18131
--- /dev/null
+++ b/src/components/ModalDialog.tsx
@@ -0,0 +1,46 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  labelledBy: string;
+  onClose: () => void;
+  children: ReactNode;
+  focusCloseButton?: boolean;
+}
+
+export default function ModalDialog({ id, labelledBy, onClose, children, focusCloseButton = true }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const dialog = dialogRef.current!;
+    // showModal provides background inertness, focus containment, Escape dismissal,
+    // and focus restoration to the invoking control when the dialog closes.
+    dialog.showModal();
+    return () => { if (dialog.open) dialog.close(); };
+  }, []);
+
+  return (
+    <dialog
+      ref={dialogRef}
+      id={id}
+      aria-labelledby={labelledBy}
+      className="modal-dialog bg-white shadow-xl"
+      onClose={onClose}
+      onClick={event => {
+        if (event.target !== event.currentTarget) return;
+        const rect = event.currentTarget.getBoundingClientRect();
+        if (event.clientX < rect.left || event.clientX > rect.right ||
+            event.clientY < rect.top || event.clientY > rect.bottom) {
+          event.currentTarget.close();
+        }
+      }}
+    >
+      <form method="dialog" className="flex justify-end p-2">
+        <button type="submit" autoFocus={focusCloseButton} className="p-2 text-gray-700 hover:text-amber-700" aria-label="Close dialog">
+          <span aria-hidden="true">✕</span>
+        </button>
+      </form>
+      {children}
+    </dialog>
+  );
+}
diff --git a/src/components/NavigationPopover.tsx b/src/components/NavigationPopover.tsx
new file mode 100644
index 0000000..427704a
--- /dev/null
+++ b/src/components/NavigationPopover.tsx
@@ -0,0 +1,46 @@
+import { useEffect, useId, useRef, useState, type ReactNode } from 'react';
+
+interface Props {
+  label: string;
+  children: ReactNode;
+  active?: boolean;
+}
+
+export default function NavigationPopover({ label, children, active = false }: Props) {
+  const id = useId();
+  const buttonRef = useRef<HTMLButtonElement>(null);
+  const popoverRef = useRef<HTMLDivElement>(null);
+  const [open, setOpen] = useState(false);
+
+  const positionPopover = () => {
+    if (buttonRef.current && popoverRef.current) {
+      popoverRef.current.style.setProperty('--popover-top', `${buttonRef.current.getBoundingClientRect().bottom}px`);
+    }
+  };
+
+  useEffect(() => {
+    if (!open) return;
+    window.addEventListener('resize', positionPopover);
+    window.addEventListener('scroll', positionPopover, true);
+    return () => {
+      window.removeEventListener('resize', positionPopover);
+      window.removeEventListener('scroll', positionPopover, true);
+    };
+  }, [open]);
+
+  return (
+    <div className="h-full flex items-center">
+      <button ref={buttonRef} type="button" popoverTarget={id} aria-expanded={open}
+        aria-controls={id} className={`flex items-center gap-1 whitespace-nowrap hover:text-gray-600 ${active ? 'text-amber-800' : ''}`}>
+        {label}
+        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" className="w-3 h-3">
+          <path strokeLinecap="round" strokeLinejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
+        </svg>
+      </button>
+      <div ref={popoverRef} id={id} popover="auto" className="navigation-popover bg-white border-b border-gray-300 shadow-lg"
+        onBeforeToggle={positionPopover} onToggle={event => setOpen(event.newState === 'open')}>
+        <nav aria-label={label} className="px-4 py-6">{children}</nav>
+      </div>
+    </div>
+  );
+}
