new file mode 100644
index 0000000..0de85b4
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,33 @@
+import { useId, useRef, useState, type ReactNode } from 'react';
+
+interface Props {
+  title: string;
+  icon: ReactNode;
+  children: (active: boolean) => ReactNode;
+}
+
+/** Keep the dialog mounted so the browser owns focus containment and restoration. */
+export default function Modal({ title, icon, children }: Props) {
+  const id = useId();
+  const dialog = useRef<HTMLDialogElement>(null);
+  const [active, setActive] = useState(false);
+
+  return <>
+    <button type="button" aria-label={title} aria-haspopup="dialog" aria-controls={id}
+      className="p-1 text-gray-700 hover:text-amber-600"
+      onClick={() => { dialog.current?.showModal(); setActive(true); }}>
+      {icon}
+    </button>
+    <dialog ref={dialog} id={id} aria-labelledby={`${id}-title`} {...{ closedby: 'any' }}
+      className="overlay-dialog bg-white shadow-xl p-4"
+      onClose={() => setActive(false)}>
+      <div className="flex items-center justify-between gap-4 mb-4">
+        <h2 id={`${id}-title`} className="text-lg font-semibold text-gray-800">{title}</h2>
+        <form method="dialog">
+          <button type="submit" aria-label={`Close ${title.toLowerCase()}`} className="p-2 text-gray-600 hover:text-amber-700">✕</button>
+        </form>
+      </div>
+      {children(active)}
+    </dialog>
+  </>;
+}
