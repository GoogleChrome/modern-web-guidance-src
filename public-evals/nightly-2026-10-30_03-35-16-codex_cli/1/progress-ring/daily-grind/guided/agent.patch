+    /* Loyalty Rewards */
+    .rewards {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      flex-wrap: wrap;
+      gap: 32px;
+      margin-top: 40px;
+      padding: 32px;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-top: 4px solid var(--accent);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .rewards-copy {
+      flex: 1 1 250px;
+      max-width: 500px;
+    }
+
+    .rewards h2 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .rewards-eyebrow {
+      font-size: 0.8rem;
+      font-weight: 700;
+      letter-spacing: 1.5px;
+      text-transform: uppercase;
+      margin-bottom: 4px;
+    }
+
+    .rewards-ring {
+      position: relative;
+      display: grid;
+      place-items: center;
+      width: 200px;
+      height: 200px;
+      flex: 0 0 200px;
+      text-align: center;
+    }
+
+    .rewards-ring::before {
+      content: "";
+      position: absolute;
+      inset: 0;
+      border-radius: 50%;
+      background: conic-gradient(var(--primary) var(--earned), var(--secondary) 0);
+      mask-image: radial-gradient(transparent 84px, black 85px);
+    }
+
+    @supports (background-clip: border-area) {
+      .rewards-ring::before {
+        border: 15px solid transparent;
+        background-clip: border-area;
+        background-origin: border-box;
+        mask-image: none;
+      }
+    }
+
+    .rewards-ring strong {
+      display: block;
+      color: var(--primary);
+      font-size: 2.5rem;
+      line-height: 1.2;
+    }
+
+    .rewards-ring span {
+      display: block;
+      font-size: 0.85rem;
+    }
+
+    .rewards-ring .rewards-remaining {
+      display: inline-block;
+      margin-top: 8px;
+      padding: 2px 10px;
+      background: var(--accent);
+      border-radius: 20px;
+      font-weight: 600;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    @media (max-width: 600px) {
+      .rewards {
+        padding: 24px 20px;
+        gap: 24px;
+        text-align: center;
+      }
+    }
+
