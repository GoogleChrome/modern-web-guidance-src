+    /* Showcase: native clipping follows the box model, including its curves. */
+    .showcase {
+      margin-block-end: 48px;
+    }
+
+    .showcase-heading {
+      text-align: center;
+      margin-block-end: 24px;
+    }
+
+    .showcase-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
+      gap: 32px;
+      align-items: center;
+    }
+
+    .nested-curve-parent {
+      padding: 24px;
+      border-radius: 40px;
+      background: var(--secondary);
+      min-inline-size: 0;
+      overflow: hidden;
+    }
+
+    .showcase-photo {
+      display: block;
+      inline-size: 100%;
+      block-size: 220px;
+      object-fit: cover;
+    }
+
+    .nested-curve-footer {
+      margin: 0;
+      padding: 24px;
+      background: var(--primary);
+      color: white;
+      text-align: start;
+    }
+
+    .showcase-eyebrow {
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.12em;
+      text-transform: uppercase;
+      margin-block-end: 8px;
+    }
+
+    .nested-curve-footer h3 {
+      margin-block-end: 8px;
+    }
+
+    .safety-zone-parent {
+      min-inline-size: 0;
+      padding: 28px 24px 0;
+      border-radius: 24px;
+      background: var(--primary);
+      color: white;
+      overflow: hidden;
+    }
+
+    /* Text keeps a strict boundary even when the parent's ink clip expands. */
+    .promo-copy {
+      overflow: hidden;
+      overflow: clip;
+      overflow-wrap: anywhere;
+      padding-block-end: 24px;
+    }
+
+    .promo-copy h3 {
+      font-size: 1.6rem;
+      margin-block-end: 8px;
+    }
+
+    .promo-form {
+      margin: 0;
+    }
+
+    .promo-button {
+      display: block;
+      inline-size: 100%;
+      border: 0;
+      border-radius: 12px 12px 0 0;
+      padding: 16px 20px;
+      background: var(--accent);
+      color: var(--text);
+      font: inherit;
+      font-weight: 700;
+      cursor: pointer;
+      box-shadow: 0 0 24px 6px rgb(255 171 64 / 65%);
+    }
+
+    .promo-button:hover {
+      background: #ffc16e;
+    }
+
+    .promo-button:focus-visible {
+      outline: 3px solid white;
+      outline-offset: -6px;
+    }
+
+    /* Unsupported browsers retain basic clipping without radius arithmetic. */
+    @supports (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        overflow: clip;
+        overflow-clip-margin: content-box;
+      }
+    }
+
+    @supports (overflow-clip-margin: 15px) {
+      .safety-zone-parent {
+        overflow: clip;
+        overflow-clip-margin: 15px;
+      }
+    }
+
