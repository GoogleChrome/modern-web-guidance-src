+      align-items: center;
+    }
+
+    .showcase-grid > * {
+      min-width: 0;
+    }
+
+    .nested-curve-parent {
+      padding: 18px 24px 22px;
+      border: 1px solid #d7ccc8;
+      border-radius: 40px;
+      background: #eee5df;
+      overflow: hidden;
+      overflow: clip;
+      overflow-clip-margin: content-box;
+    }
+
+    .showcase-photo {
+      display: block;
+      width: 100%;
+      height: 230px;
+      object-fit: cover;
+    }
+
+    .nested-curve-parent .showcase-card-footer {
+      margin: 0;
+      padding: 24px;
+      background: white;
+      text-align: left;
+    }
+
+    .showcase-card-footer h3 {
+      margin: 4px 0 8px;
+      font-size: 1.5rem;
+    }
+
+    .safety-zone-parent {
+      padding: 28px 28px 0;
+      border-radius: 24px;
+      background: #4e342e;
+      color: white;
+      overflow: clip;
+      /* Length-only fallback for engines without visual-box keyword support. */
+      overflow-clip-margin: 15px;
+      overflow-clip-margin: padding-box 15px;
+    }
+
+    /* The parent's bleed applies to all paint; contain text independently. */
+    .promo-copy {
+      overflow: hidden;
+      overflow: clip;
+      overflow-wrap: anywhere;
+    }
+
+    .promo-copy .eyebrow {
+      color: #ffcb88;
+    }
+
+    .promo-copy h3 {
+      font-size: 1.8rem;
