+
+    .promo-copy p:last-child {
+      color: #eddfd6;
+    }
+
+    .promo-button {
+      display: block;
+      width: 100%;
+      margin-top: 28px;
+      padding: 16px 20px;
+      border: 0;
+      border-radius: 12px;
+      background: var(--accent);
+      color: #3e2723;
+      font: inherit;
+      font-weight: 700;
+      cursor: pointer;
+      box-shadow: 0 0 28px 8px rgba(255, 171, 64, 0.65);
+    }
+
+    .promo-button:hover {
+      background: #ffc477;
+    }
+
+    .promo-button:focus-visible {
+      outline: 3px solid white;
+      outline-offset: 4px;
+    }
+
+    @media (max-width: 640px) {
+      .showcase-grid {
+        grid-template-columns: 1fr;
+      }
+    }
