+import { generateSigningKey, signDocument, verifyDocument, fingerprint, importPublicKey, normalizePublicKey } from './signing.mjs';
+const $ = id => document.getElementById(id);
+const svg = name => `<svg aria-hidden="true"><use href="#i-${name}"/></svg>`;
+const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+const localDate = (date = new Date()) => `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
+$('document-date').value = localDate();
+const nextYear = new Date(); nextYear.setFullYear(nextYear.getFullYear()+1); $('expiry').value = localDate(nextYear);
+let signedDocument = null, keyPromise = null, revision = 0, currentMode = 'create';
+const dbPromise = new Promise((resolve, reject) => {
+  if (!globalThis.crypto?.subtle) return reject(new Error('Secure signing requires HTTPS and a browser with Web Crypto support.'));
+  const request = indexedDB.open('daily-grind-signing', 1);
+  request.onupgradeneeded = () => request.result.createObjectStore('keys');
+  request.onsuccess = () => resolve(request.result);
+  request.onerror = () => reject(new Error('Allow browser storage to keep your signing key securely on this device.'));
+});
+// Surface storage errors when the user invokes signing, rather than as an unhandled rejection.
+dbPromise.catch(() => {});
+async function dbAction(mode, action) {
+  const db = await dbPromise;
+  return new Promise((resolve, reject) => {
+    const transaction = db.transaction('keys', mode);
+    const request = action(transaction.objectStore('keys'));
+    transaction.oncomplete = () => resolve(request.result);
+    transaction.onerror = () => reject(new Error('Could not access your locally stored keys.'));
+    transaction.onabort = () => reject(new Error('Key storage was interrupted. Please try again.'));
+  });
+}
+const get = key => dbAction('readonly', store => store.get(key));
+const put = (key, value) => dbAction('readwrite', store => store.put(value, key));
+async function getSigningKey() {
+  if (!keyPromise) keyPromise = (async () => {
+    // Serialize first-time key creation across tabs on browsers with the Web Locks API.
+    const load = async () => {
+      let key = await get('signer');
+      if (!key) { key = await generateSigningKey(); await put('signer', key); }
+      return key;
+    };
+    return navigator.locks ? navigator.locks.request('daily-grind-signing-key', load) : load();
+  })().catch(error => { keyPromise = null; throw error; });
+  return keyPromise;
+}
+function notify(message, type = '') {
+  $('status').hidden = false; $('status').className = 'status ' + type; $('status').textContent = message;
+}
+function setSignature(text, state = '') {
+  $('signature-preview').className = 'signature-placeholder ' + state;
+  $('signature-preview').replaceChildren();
+  $('signature-preview').insertAdjacentHTML('beforeend', svg('shield'));
+  const label = document.createElement('span'); label.textContent = text; $('signature-preview').append(label);
+}
+function formPayload() {
+  const type = document.querySelector('[name=documentType]:checked').value;
+  return {
+    type, reference: $('reference').value.trim(), date: $('document-date').value,
+    description: $('description').value.trim(), customer: $('customer').value.trim(),
+    amountCents: Math.round(Number($('amount').value) * 100), currency: 'USD', issuedAt: new Date().toISOString(),
+    ...(type === 'voucher' ? { expires: $('expiry').value } : {})
+  };
+}
+function renderPreview(payload) {
+  const voucher = payload.type === 'voucher';
+  $('preview-kind').textContent = voucher ? 'GIFT VOUCHER' : 'COFFEE RECEIPT';
+  $('preview-reference').textContent = payload.reference || '—';
+  $('preview-date').textContent = payload.date ? new Date(payload.date + 'T12:00:00').toLocaleDateString('en-US',{ month:'short', day:'numeric', year:'numeric' }) : '—';
+  $('preview-customer-label').textContent = voucher ? 'For' : 'Customer';
+  $('preview-customer').textContent = payload.customer || '—';
+  $('preview-description').textContent = payload.description || 'Your document details';
+  $('preview-item-amount').textContent = money(payload.amountCents || 0);
+  $('preview-amount').textContent = money(payload.amountCents || 0);
+  document.querySelector('.receipt-total>span').textContent = voucher ? 'Gift value' : 'Total paid';
+  $('preview-expiry').hidden = !voucher;
+  $('preview-expiry').textContent = voucher ? 'Valid until ' + payload.expires : '';
+}
+function invalidate() {
+  revision++; signedDocument = null;
+  $('download-document').hidden = true; $('status').hidden = true;
+  $('preview-state').textContent = 'Live preview'; $('preview-label').textContent = 'DOCUMENT PREVIEW';
+  setSignature('Your digital signature will appear here'); renderPreview(formPayload());
+}
+$('document-form').addEventListener('input', invalidate);
+document.querySelectorAll('[name=documentType]').forEach(input => input.addEventListener('change', () => {
+  const voucher = input.value === 'voucher';
+  document.querySelectorAll('.type-card').forEach(card => card.classList.toggle('selected', card.contains(input)));
+  $('reference-label').textContent = voucher ? 'Voucher reference' : 'Order reference';
+  $('description-label').textContent = voucher ? 'Gift message' : 'Order details';
+  $('customer-label').textContent = voucher ? 'Recipient name' : 'Customer name';
+  $('amount-label').textContent = voucher ? 'Gift value (USD)' : 'Total amount (USD)';
+  $('expiry-field').hidden = !voucher; $('expiry').required = voucher;
+  $('reference').value = voucher ? 'GV-1042' : 'DG-1042';
+  $('description').value = voucher ? 'A little coffee, a little joy. Just for you.' : 'Maple Oat Latte × 1';
+  $('amount').value = voucher ? '25.00' : '5.50'; invalidate();
+}));
+$('document-form').addEventListener('submit', async event => {
+  event.preventDefault(); const started = revision; const payload = formPayload();
+  $('sign-button').disabled = true;
+  try {
+    const key = await getSigningKey(); const result = await signDocument(payload, key);
+    if (started !== revision || currentMode !== 'create') return;
+    signedDocument = result; renderPreview(payload); $('preview-state').textContent = 'Digitally signed';
+    setSignature('Signed with your local key · ECDSA P-256', 'signed');
+    $('download-document').hidden = false;
+    notify('Document signed. Download and share it with its public key. This local signature does not confirm payment or merchant identity.');
+  } catch (error) { notify(error.message, 'error'); }
+  finally { $('sign-button').disabled = false; }
+});
+function download(object, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(object, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a'); link.href = url; link.download = filename; link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+$('download-document').addEventListener('click', () => {
+  if (signedDocument) download(signedDocument, `daily-grind-${signedDocument.payload.type}-${signedDocument.payload.reference.replace(/[^a-z0-9-]/gi, '_')}.json`);
+});
+function switchTab(mode) {
+  currentMode = mode; revision++;
+  ['create','verify'].forEach(name => {
+    const active = mode === name;
+    $('tab-'+name).classList.toggle('active', active); $('tab-'+name).setAttribute('aria-selected', String(active));
+    $('tab-'+name).tabIndex = active ? 0 : -1; $(name+'-panel').hidden = !active;
+  });
+  invalidate();
+  if (mode === 'verify') {
+    $('preview-label').textContent = 'VERIFICATION PREVIEW'; $('preview-state').textContent = 'Awaiting document';
+    setSignature('Add a signed document to check its signature');
+  }
+}
+['create','verify'].forEach(mode => {
+  $('tab-'+mode).addEventListener('click', () => switchTab(mode));
+  $('tab-'+mode).addEventListener('keydown', event => {
+    if (['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) {
+      event.preventDefault(); const next = event.key === 'Home' ? 'create' : event.key === 'End' ? 'verify' : mode === 'create' ? 'verify' : 'create';
+      switchTab(next); $('tab-'+next).focus();
+    }
+  });
+});
+function resetVerification() {
+  revision++; $('status').hidden = true; $('preview-state').textContent = 'Awaiting verification';
+  setSignature('Document has not been verified'); $('download-document').hidden = true; signedDocument = null;
+}
+$('verify-json').addEventListener('input', resetVerification);
+async function readFile(file) {
+  if (!file) return;
+  resetVerification(); const fileRevision = revision;
+  if (file.size > 1024*1024) return notify('Choose a JSON document smaller than 1 MB.', 'error');
+  try {
+    const text = await file.text();
+    if (fileRevision !== revision || currentMode !== 'verify') return;
+    $('verify-json').value = text; await verify();
+  }
+  catch { notify('Could not read this file. Choose a signed JSON document.', 'error'); }
+}
+$('verify-file').addEventListener('change', event => { readFile(event.target.files[0]); event.target.value = ''; });
+$('upload-zone').addEventListener('dragover', event => { event.preventDefault(); $('upload-zone').classList.add('dragging'); });
+$('upload-zone').addEventListener('dragleave', () => $('upload-zone').classList.remove('dragging'));
+$('upload-zone').addEventListener('drop', event => { event.preventDefault(); $('upload-zone').classList.remove('dragging'); readFile(event.dataTransfer.files[0]); });
+async function verify() {
+  resetVerification(); const started = revision; $('verify-button').disabled = true;
+  try {
+    const text = $('verify-json').value.trim();
+    if (!text) throw new Error('Upload a signed document or paste its JSON to get started.');
+    if (new TextEncoder().encode(text).length > 1024*1024) throw new Error('Choose a JSON document smaller than 1 MB.');
+    let parsed; try { parsed = JSON.parse(text); } catch { throw new Error('This is not valid JSON. Paste the complete signed document.'); }
+    // Verification remains available even when local storage is unavailable.
+    const local = await get('signer').catch(() => null);
+    const trusted = await get('trusted').catch(() => []) || [];
+    const result = await verifyDocument(parsed, [...trusted.map(key => key.keyId), ...(local ? [local.keyId] : [])]);
+    if (started !== revision || currentMode !== 'verify') return;
+    renderPreview(parsed.payload);
+    if (!result.valid) {
+      $('preview-state').textContent = 'Invalid signature'; setSignature('Signature invalid · document may have changed', 'failed');
+      notify('Verification failed. The document, signing key, or signature has changed. Do not trust these details.', 'error');
+    } else if (result.expired) {
+      $('preview-state').textContent = 'Voucher expired'; setSignature('Signature valid · voucher expired');
+      notify('The signature is valid, but this voucher has expired.' + (result.trusted ? ' Its key is trusted on this device.' : ' The issuing key is unfamiliar.'), 'warning');
+    } else if (!result.trusted) {
+      $('preview-state').textContent = 'Unknown issuer'; setSignature('Signature valid · issuer not trusted');
+      notify('The document is unchanged, but its issuer is unknown. Confirm the key fingerprint with the issuer and import their public key in Manage keys. Fingerprint: ' + parsed.keyId, 'warning');
+    } else {
+      $('preview-state').textContent = 'Verified'; setSignature('Valid signature · trusted key on this device', 'signed');
+      notify('Signature verified. The document is unchanged and its signing key is trusted on this device. This does not confirm payment or voucher redemption.');
+    }
+  } catch (error) {
+    if (started === revision) { $('preview-state').textContent = 'Unable to verify'; setSignature('Document could not be verified', 'failed'); notify(error.message, 'error'); }
+  } finally { $('verify-button').disabled = false; }
+}
+$('verify-button').addEventListener('click', verify);
+async function refreshKeys() {
+  const key = await get('signer');
+  if (key) $('key-fingerprint').textContent = 'SHA-256 fingerprint: ' + key.keyId;
+  const trusted = await get('trusted') || []; $('trusted-keys').replaceChildren();
+  for (const entry of trusted) {
+    const row = document.createElement('li'); const label = document.createElement('span'); label.textContent = entry.keyId;
+    const remove = document.createElement('button'); remove.textContent = 'Remove'; remove.setAttribute('aria-label', 'Remove trusted key ' + entry.keyId.slice(0,12));
+    remove.addEventListener('click', async () => {
+      try { const latest = await get('trusted') || []; await put('trusted', latest.filter(key => key.keyId !== entry.keyId)); await refreshKeys(); resetVerification(); }
+      catch (error) { $('key-status').textContent = error.message; }
+    });
+    row.append(label, remove); $('trusted-keys').append(row);
+  }
+}
+$('manage-keys').addEventListener('click', async () => {
+  $('key-dialog').showModal(); $('key-status').textContent = '';
+  try { await refreshKeys(); } catch (error) { $('key-status').textContent = error.message; }
+});
+$('close-keys').addEventListener('click', () => $('key-dialog').close());
+$('key-dialog').addEventListener('click', event => { if (event.target === $('key-dialog')) { const r = event.target.getBoundingClientRect(); if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) event.target.close(); } });
+$('export-key').addEventListener('click', async () => {
+  $('export-key').disabled = true;
+  try { const key = await getSigningKey(); download({ publicKey: key.publicKey, keyId: key.keyId }, 'daily-grind-public-key.json'); await refreshKeys(); $('key-status').textContent = 'Public key exported. Your private signing key stays on this device.'; }
+  catch (error) { $('key-status').textContent = error.message; }
+  finally { $('export-key').disabled = false; }
+});
+$('import-key').addEventListener('change', async event => {
+  const file = event.target.files[0]; if (!file) return;
+  try {
+    if (file.size > 16384) throw new Error('Choose a public key JSON file smaller than 16 KB.');
