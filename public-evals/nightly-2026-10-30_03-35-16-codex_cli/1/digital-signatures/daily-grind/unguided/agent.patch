--- /dev/null
+++ b/signing.mjs
@@ -0,0 +1,66 @@
+const encoder = new TextEncoder();
+export const ALGORITHM = 'ECDSA-P256-SHA256';
+const params = { name: 'ECDSA', namedCurve: 'P-256' };
+const operation = { name: 'ECDSA', hash: 'SHA-256' };
+export function canonical(value) {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
+  return '{' + Object.keys(value).sort().map(key => JSON.stringify(key) + ':' + canonical(value[key])).join(',') + '}';
+}
+function bytes(value) { return encoder.encode(canonical(value)); }
+function encode(buffer) { return btoa(String.fromCharCode(...new Uint8Array(buffer))); }
+function decode(string) {
+  if (typeof string !== 'string' || string.length > 1000 || !/^[A-Za-z0-9+/]+={0,2}$/.test(string)) throw new Error('Invalid signature encoding.');
+  return Uint8Array.from(atob(string), char => char.charCodeAt(0));
+}
+export function normalizePublicKey(jwk) {
+  if (!jwk || jwk.kty !== 'EC' || jwk.crv !== 'P-256' || typeof jwk.x !== 'string' || typeof jwk.y !== 'string' || jwk.d) throw new Error('Expected a public ECDSA P-256 key. Private keys cannot be imported here.');
+  return { kty: 'EC', crv: 'P-256', x: jwk.x, y: jwk.y };
+}
+export async function fingerprint(jwk) {
+  const digest = await crypto.subtle.digest('SHA-256', bytes(normalizePublicKey(jwk)));
+  return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('');
+}
+export async function generateSigningKey() {
+  const pair = await crypto.subtle.generateKey(params, false, ['sign', 'verify']);
+  const publicKey = normalizePublicKey(await crypto.subtle.exportKey('jwk', pair.publicKey));
+  return { privateKey: pair.privateKey, publicKey, keyId: await fingerprint(publicKey) };
+}
+export async function importPublicKey(jwk) {
+  return crypto.subtle.importKey('jwk', normalizePublicKey(jwk), params, true, ['verify']);
+}
+function exactKeys(value, keys) {
+  return value && !Array.isArray(value) && typeof value === 'object' && Object.keys(value).sort().join(',') === [...keys].sort().join(',');
+}
+function validDate(value) {
+  return typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value) && Number.isFinite(Date.parse(value)) && new Date(value).toISOString().slice(0, 10) === value;
+}
+export function validatePayload(payload) {
+  const keys = ['type','reference','date','description','customer','amountCents','currency','issuedAt'];
+  if (payload?.type === 'voucher') keys.push('expires');
+  if (!exactKeys(payload, keys) || !['receipt', 'voucher'].includes(payload.type) || payload.currency !== 'USD') throw new Error('Unrecognized document format. Choose a signed Daily Grind receipt or voucher.');
+  for (const [field, limit] of [['reference',60],['description',200],['customer',80]]) {
+    if (typeof payload[field] !== 'string' || !payload[field].trim() || payload[field].length > limit) throw new Error('Missing or invalid document details.');
+  }
+  if (!Number.isSafeInteger(payload.amountCents) || payload.amountCents <= 0 || payload.amountCents > 10000000) throw new Error('Enter an amount between $0.01 and $100,000.00.');
+  if (!validDate(payload.date) || typeof payload.issuedAt !== 'string' || !Number.isFinite(Date.parse(payload.issuedAt))) throw new Error('The document contains an invalid date.');
+  if (payload.type === 'voucher' && (!validDate(payload.expires) || payload.expires < payload.date)) throw new Error('Choose a voucher expiry on or after its issue date.');
+}
+export async function signDocument(payload, key) {
+  validatePayload(payload);
+  const signed = { version: 1, algorithm: ALGORITHM, keyId: key.keyId, payload };
+  const signature = encode(await crypto.subtle.sign(operation, key.privateKey, bytes(signed)));
+  return { ...signed, publicKey: key.publicKey, signature };
+}
+export async function verifyDocument(document, trustedIds = []) {
+  if (!exactKeys(document, ['version','algorithm','keyId','payload','publicKey','signature']) || document.version !== 1 || document.algorithm !== ALGORITHM) throw new Error('Unsupported signed document. Expected ECDSA P-256, version 1.');
+  validatePayload(document.payload);
+  const keyId = await fingerprint(document.publicKey);
+  if (keyId !== document.keyId) return { valid: false, trusted: false, expired: false };
+  const publicKey = await importPublicKey(document.publicKey);
+  const { version, algorithm, payload } = document;
+  const valid = await crypto.subtle.verify(operation, publicKey, decode(document.signature), bytes({ version, algorithm, keyId, payload }));
+  const now = new Date();
+  const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
+  return { valid, trusted: valid && trustedIds.includes(keyId), expired: payload.type === 'voucher' && payload.expires < today };
+}
