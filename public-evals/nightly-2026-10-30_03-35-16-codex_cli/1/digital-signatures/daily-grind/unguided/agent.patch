diff --git a/tests/signing.test.mjs b/tests/signing.test.mjs
new file mode 100644
index 0000000..aafeff7
--- /dev/null
+++ b/tests/signing.test.mjs
@@ -0,0 +1,63 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { generateSigningKey, signDocument, verifyDocument, canonical, fingerprint } from '../signing.mjs';
+const key = await generateSigningKey();
+const other = await generateSigningKey();
+const receipt = { type:'receipt', reference:'DG-1042', date:'2026-10-30', description:'Maple Oat Latte × 1', customer:'Jamie Davis', amountCents:550, currency:'USD', issuedAt:'2026-10-30T12:00:00.000Z' };
+const clone = value => JSON.parse(JSON.stringify(value));
+test('receipt and voucher round trips use a trusted asymmetric key', async () => {
+  for (const payload of [receipt, { ...receipt, type:'voucher', expires:'2099-10-30' }]) {
+    const signed = await signDocument(payload, key);
+    const exported = clone(signed);
+    assert.deepEqual(await verifyDocument(exported, [key.keyId]), { valid:true, trusted:true, expired:false });
+    assert.equal(signed.signature.length, 88);
+  }
+});
+test('private key is nonextractable while public key fingerprint is stable', async () => {
+  assert.equal(key.privateKey.extractable, false);
+  await assert.rejects(crypto.subtle.exportKey('jwk', key.privateKey));
+  assert.equal(await fingerprint(key.publicKey), key.keyId);
+  assert.notEqual(key.keyId, other.keyId);
+  assert.equal(key.publicKey.d, undefined);
+});
+test('signature validity alone never trusts an unknown issuer', async () => {
+  const signed = await signDocument(receipt, other);
+  assert.deepEqual(await verifyDocument(signed, [key.keyId]), { valid:true, trusted:false, expired:false });
+});
+test('changes to every receipt detail invalidate its signature', async () => {
+  const signed = await signDocument(receipt, key);
+  for (const [field, value] of Object.entries({ reference:'DG-9999', date:'2026-10-31', description:'Other order', customer:'Other customer', amountCents:999, issuedAt:'2026-10-30T13:00:00.000Z' })) {
+    const changed = clone(signed); changed.payload[field] = value;
+    assert.equal((await verifyDocument(changed, [key.keyId])).valid, false, field);
+  }
+});
+test('replacement key, fingerprint and corrupted signature are rejected', async () => {
+  const signed = await signDocument(receipt, key);
+  const replacement = { ...signed, publicKey: other.publicKey };
+  assert.equal((await verifyDocument(replacement)).valid, false);
+  replacement.keyId = other.keyId;
+  assert.equal((await verifyDocument(replacement)).valid, false);
+  const damaged = clone(signed); damaged.signature = (signed.signature[0] === 'A' ? 'B' : 'A') + signed.signature.slice(1);
+  assert.equal((await verifyDocument(damaged)).valid, false);
+});
+test('JSON key reordering preserves the canonical signed content', async () => {
+  const signed = await signDocument(receipt, key);
+  signed.payload = Object.fromEntries(Object.entries(signed.payload).reverse());
+  assert.equal((await verifyDocument(signed)).valid, true);
+  assert.equal(canonical({ b:2, a:1 }), canonical({ a:1, b:2 }));
+});
+test('expired vouchers are distinguished from invalid signatures', async () => {
+  const signed = await signDocument({ ...receipt, type:'voucher', date:'2020-01-01', expires:'2020-12-31' }, key);
+  assert.deepEqual(await verifyDocument(signed, [key.keyId]), { valid:true, trusted:true, expired:true });
+  signed.payload.expires = '2099-12-31';
+  assert.equal((await verifyDocument(signed)).valid, false);
+});
+test('invalid schemas, dates, algorithms and amounts are rejected', async () => {
+  const signed = await signDocument(receipt, key);
+  for (const changed of [null, {}, { ...signed, algorithm:'RSA' }, { ...signed, version:2 }, { ...signed, extra:'unsigned' }, { ...signed, publicKey:{ ...key.publicKey, d:'private' } }, { ...signed, signature:'not base64!' }]) {
+    await assert.rejects(verifyDocument(changed));
+  }
+  for (const changes of [{ amountCents:-1 }, { amountCents:1.5 }, { currency:'EUR' }, { date:'2026-02-30' }, { description:'' }, { issuedAt:'never' }, { type:'voucher', expires:'2026-01-01' }]) {
+    await assert.rejects(signDocument({ ...receipt, ...changes }, key));
+  }
+});
