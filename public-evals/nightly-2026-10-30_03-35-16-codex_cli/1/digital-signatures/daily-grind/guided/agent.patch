+}
+test('automatic selection produces a working signature', async () => {
+  const signer = await createSigner();
+  const trusted = await importVerificationKey(serialize(signer.verificationKey));
+  const artifact = await signArtifact(signer, details);
+  assert.equal((await verifyArtifact(serialize(artifact), trusted)).payload.type, 'receipt');
