diff --git a/receipts.mjs b/receipts.mjs
new file mode 100644
index 0000000..fc54790
--- /dev/null
+++ b/receipts.mjs
@@ -0,0 +1,132 @@
+import { createSigner, importVerificationKey, signArtifact, verifyArtifact, MAX_DOCUMENT_SIZE } from './signatures.mjs';
+const $ = id => document.getElementById(id);
+let signer;
+let trustedKey;
+let trustLabel = '';
+let generated;
+const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+function status(id, message, state = '') {
+  const element = $(id);
+  element.textContent = message;
+  element.dataset.state = state;
+}
+function download(value, name) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(value, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = name;
+  link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+function invalidateVerification() {
+  status('verify-status', 'Ready to check a document against the selected key.');
+}
+function showTrust(label) {
+  trustLabel = label;
+  $('trusted-fingerprint').textContent = `${label} · SHA-256 ${trustedKey.keyId}`;
+  invalidateVerification();
+}
+async function useSessionKey() {
+  trustedKey = await importVerificationKey(JSON.stringify(signer.verificationKey));
+  showTrust('This session’s demo key');
+}
+function updateType() {
+  const voucher = $('artifact-type').value === 'voucher';
+  $('description-label').textContent = voucher ? 'Recipient / gift message' : 'Coffee order';
+  $('artifact-description').value = voucher ? 'A little coffee, on me.' : 'Maple Oat Latte × 1';
+  $('artifact-amount').value = voucher ? '25.00' : '5.50';
+  $('expiry-field').hidden = !voucher;
+  $('artifact-expiry').required = voucher;
+}
+$('artifact-type').addEventListener('change', updateType);
+$('artifact-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  $('sign-artifact').disabled = true;
+  generated = undefined;
+  $('download-artifact').disabled = true;
+  $('check-created').disabled = true;
+  status('sign-status', 'Signing your document…');
+  try {
+    const rawAmount = $('artifact-amount').value;
+    if (!/^\d+(\.\d{1,2})?$/.test(rawAmount)) throw new Error('Enter an amount with at most two decimal places.');
+    const type = $('artifact-type').value;
+    const expiresAt = type === 'voucher' ? new Date(`${$('artifact-expiry').value}T23:59:59.999Z`).toISOString() : undefined;
+    if (expiresAt && Date.parse(expiresAt) <= Date.now()) throw new Error('Choose a future voucher expiry date.');
+    generated = await signArtifact(signer, { type, description: $('artifact-description').value.trim(),
+      amountCents: Math.round(Number(rawAmount) * 100), expiresAt });
+    $('signed-output').value = JSON.stringify(generated, null, 2);
+    $('download-artifact').disabled = false;
+    $('check-created').disabled = false;
+    status('sign-status', `Signed ${type === 'receipt' ? 'receipt' : 'gift voucher'} · ${money(JSON.parse(generated.payload).amountCents)}. Your document is ready.`, 'success');
+  } catch (error) { status('sign-status', error.message, 'error'); }
+  finally { $('sign-artifact').disabled = false; }
+});
+$('download-artifact').addEventListener('click', () => {
+  if (generated) download(generated, `daily-grind-${JSON.parse(generated.payload).type}-${JSON.parse(generated.payload).id}.json`);
+});
+$('download-key').addEventListener('click', () => download(signer.verificationKey, 'daily-grind-demo-public-key.json'));
+$('session-key').addEventListener('click', () => useSessionKey().catch(error => status('verify-status', error.message, 'error')));
+$('check-created').addEventListener('click', () => {
+  $('verify-input').value = $('signed-output').value;
+  invalidateVerification();
+  $('verify-input').focus();
+});
+$('verify-input').addEventListener('input', invalidateVerification);
+$('verify-file').addEventListener('change', async event => {
+  invalidateVerification();
+  try {
+    const file = event.target.files[0];
+    if (!file) return;
+    if (file.size > MAX_DOCUMENT_SIZE) throw new Error('Document is too large (maximum 64 KB).');
+    $('verify-input').value = await file.text();
+  } catch (error) { status('verify-status', error.message, 'error'); }
+  finally { event.target.value = ''; }
+});
+$('trusted-key-file').addEventListener('change', async event => {
+  // Clear previous trust as soon as a replacement is requested.
+  trustedKey = undefined;
+  $('trusted-fingerprint').textContent = 'No trusted key selected.';
+  invalidateVerification();
+  try {
+    const file = event.target.files[0];
+    if (!file) return;
+    if (file.size > MAX_DOCUMENT_SIZE) throw new Error('Key file is too large.');
+    trustedKey = await importVerificationKey(await file.text());
+    showTrust('Imported key — confirm this fingerprint with the issuer');
+  } catch (error) { status('verify-status', error.message, 'error'); }
+  finally { event.target.value = ''; }
+});
+$('verify-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  $('verify-button').disabled = true;
+  const snapshot = $('verify-input').value;
+  const key = trustedKey;
+  const label = trustLabel;
+  status('verify-status', 'Checking the signature…');
+  try {
+    const { payload, expired } = await verifyArtifact(snapshot, key);
+    if (snapshot !== $('verify-input').value || key !== trustedKey) return invalidateVerification();
+    status('verify-status', `${expired ? 'Signature valid · voucher expired' : 'Signature verified'} · ${payload.type === 'receipt' ? 'Receipt' : 'Gift voucher'} · ${money(payload.amountCents)} · ${payload.description}. Signed ${new Date(payload.issuedAt).toLocaleString()}.${payload.type === 'voucher' ? ` Expires ${payload.expiresAt.slice(0, 10)} (UTC).` : ''} Verified against: ${label}. This confirms integrity and possession of this key; it does not confirm payment or redemption.`, expired ? 'warning' : 'success');
+  } catch (error) {
+    if (snapshot === $('verify-input').value && key === trustedKey) status('verify-status', error.message, 'error');
+    else invalidateVerification();
+  } finally { $('verify-button').disabled = false; }
+});
+async function init() {
+  const expiry = new Date();
+  expiry.setUTCFullYear(expiry.getUTCFullYear() + 1);
+  $('artifact-expiry').value = expiry.toISOString().slice(0, 10);
+  try {
+    signer = await createSigner();
+    await useSessionKey();
+    $('crypto-suite').textContent = signer.suite === 'ML-DSA-65' ? 'ML-DSA-65 · Quantum resistant' : `${signer.suite === 'ECDSA' ? 'ECDSA P-256 / SHA-256' : signer.suite} · Classical signatures`;
+    $('sign-artifact').disabled = false;
+    $('download-key').disabled = false;
+    $('session-key').disabled = false;
+    status('sign-status', 'Your private signing key stays in this tab.');
+  } catch (error) {
+    $('crypto-suite').textContent = 'Signing unavailable';
+    status('sign-status', error.message, 'error');
+  }
+}
+init();
diff --git a/signatures.mjs b/signatures.mjs
new file mode 100644
index 0000000..8e112d1
--- /dev/null
+++ b/signatures.mjs
@@ -0,0 +1,103 @@
+// Browser-native signatures. Private keys remain non-exportable and in memory.
+const encoder = new TextEncoder();
+const suites = ['ML-DSA-65', 'Ed25519', 'ECDSA'];
+const keyParams = suite => suite === 'ECDSA' ? { name: suite, namedCurve: 'P-256' } : suite;
+const signParams = suite => suite === 'ECDSA' ? { name: suite, hash: 'SHA-256' } : suite;
+const keyFormat = suite => suite === 'ML-DSA-65' ? 'raw-public' : 'raw';
+export const MAX_DOCUMENT_SIZE = 64000;
+
+function assertSuite(suite) {
+  if (!suites.includes(suite)) throw new Error('Unsupported signature algorithm.');
+}
+function encode(bytes) {
+  return btoa(String.fromCharCode(...new Uint8Array(bytes)));
+}
+function decode(value) {
+  if (typeof value !== 'string' || value.length > 16000 || !/^[A-Za-z0-9+/]*={0,2}$/.test(value)) {
+    throw new Error('Invalid encoded key or signature.');
+  }
+  return Uint8Array.from(atob(value), c => c.charCodeAt(0));
+}
+async function fingerprint(bytes) {
+  return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)), b => b.toString(16).padStart(2, '0')).join('');
+}
+function parse(text) {
+  if (typeof text !== 'string' || text.length > MAX_DOCUMENT_SIZE) throw new Error('Document is too large (maximum 64 KB).');
+  try { return JSON.parse(text); } catch { throw new Error('Please provide a valid JSON document.'); }
+}
+function validatePayload(payload) {
+  if (!payload || payload.domain !== 'daily-grind/artifact/v1' || payload.issuer !== 'The Daily Grind' ||
+      !['receipt', 'voucher'].includes(payload.type) || payload.currency !== 'USD' ||
+      !Number.isSafeInteger(payload.amountCents) || payload.amountCents < 1 || payload.amountCents > 1000000 ||
+      typeof payload.description !== 'string' || !payload.description.trim() || payload.description.length > 200 ||
+      typeof payload.id !== 'string' || !/^[0-9a-f-]{36}$/i.test(payload.id) ||
+      typeof payload.issuedAt !== 'string' || !Number.isFinite(Date.parse(payload.issuedAt)) ||
+      (payload.type === 'voucher' && (typeof payload.expiresAt !== 'string' || !Number.isFinite(Date.parse(payload.expiresAt)) || Date.parse(payload.expiresAt) <= Date.parse(payload.issuedAt)))) {
+    throw new Error('Invalid receipt or voucher details.');
+  }
+  assertSuite(payload.suite);
+}
+// Length-prefixed purpose header prevents replay across artifact types and protocols.
+function signatureInput(suite, payloadText, type) {
+  const context = encoder.encode(`daily-grind/${type}/v1`);
+  const payload = encoder.encode(payloadText);
+  if (suite === 'ML-DSA-65') return { algorithm: { name: suite, context }, data: payload };
+  const framed = new Uint8Array(1 + context.length + payload.length);
+  framed[0] = context.length;
+  framed.set(context, 1);
+  framed.set(payload, 1 + context.length);
+  return { algorithm: signParams(suite), data: framed };
+}
+export async function createSigner(preferred) {
+  if (!globalThis.crypto?.subtle) throw new Error('Signing needs HTTPS and a browser with Web Crypto support.');
+  if (preferred) assertSuite(preferred);
+  const candidates = preferred ? [preferred] : [
+    ...(globalThis.SubtleCrypto?.supports?.('sign', 'ML-DSA-65') ? ['ML-DSA-65'] : []),
+    'Ed25519', 'ECDSA',
+  ];
+  for (const suite of candidates) {
+    try {
+      const keys = await crypto.subtle.generateKey(keyParams(suite), false, ['sign', 'verify']);
+      const bytes = await crypto.subtle.exportKey(keyFormat(suite), keys.publicKey);
+      return { suite, keys, verificationKey: { version: 1, suite, publicKey: encode(bytes), keyId: await fingerprint(bytes) } };
+    } catch (error) {
+      if (error.name !== 'NotSupportedError') throw error;
+    }
+  }
+  throw new Error('This browser does not support the requested signing algorithm.');
+}
+export async function importVerificationKey(text) {
+  const document = parse(text);
+  if (!document || document.version !== 1) throw new Error('Invalid verification key format.');
+  assertSuite(document.suite);
+  const bytes = decode(document.publicKey);
+  const keyId = await fingerprint(bytes);
+  if (document.keyId !== keyId) throw new Error('The key fingerprint does not match.');
+  const publicKey = await crypto.subtle.importKey(keyFormat(document.suite), bytes, keyParams(document.suite), false, ['verify']);
+  return { suite: document.suite, keyId, publicKey };
+}
+export async function signArtifact(signer, details) {
+  const payload = { domain: 'daily-grind/artifact/v1', issuer: 'The Daily Grind', suite: signer.suite,
+    id: crypto.randomUUID(), issuedAt: new Date().toISOString(), type: details.type,
+    description: details.description, amountCents: details.amountCents, currency: 'USD',
+    ...(details.type === 'voucher' ? { expiresAt: details.expiresAt } : {}) };
+  validatePayload(payload);
+  const serialized = JSON.stringify(payload);
+  const { algorithm, data } = signatureInput(signer.suite, serialized, payload.type);
+  const signature = await crypto.subtle.sign(algorithm, signer.keys.privateKey, data);
+  return { version: 1, suite: signer.suite, keyId: signer.verificationKey.keyId, payload: serialized, signature: encode(signature) };
+}
+export async function verifyArtifact(text, trustedKey, now = Date.now()) {
+  if (!trustedKey) throw new Error('Select a trusted verification key first.');
+  const document = parse(text);
+  if (!document || document.version !== 1 || document.keyId !== trustedKey.keyId || document.suite !== trustedKey.suite) {
+    throw new Error('Document does not match the trusted key or signature format.');
+  }
+  const payload = parse(document.payload);
+  validatePayload(payload);
+  if (payload.suite !== document.suite) throw new Error('Signature algorithm mismatch.');
+  const { algorithm, data } = signatureInput(document.suite, document.payload, payload.type);
+  const valid = await crypto.subtle.verify(algorithm, trustedKey.publicKey, decode(document.signature), data);
+  if (!valid) throw new Error('Signature invalid. The document was changed or signed by another key.');
+  return { payload, expired: payload.type === 'voucher' && Date.parse(payload.expiresAt) <= now };
+}
diff --git a/tests/signatures.test.mjs b/tests/signatures.test.mjs
new file mode 100644
index 0000000..9685d8c
--- /dev/null
+++ b/tests/signatures.test.mjs
@@ -0,0 +1,47 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createSigner, importVerificationKey, signArtifact, verifyArtifact } from '../signatures.mjs';
+const details = { type: 'receipt', description: 'Maple Oat Latte × 1', amountCents: 550 };
+const serialize = document => JSON.stringify(document);
+const supportedSuites = ['Ed25519', 'ECDSA'];
+if (globalThis.SubtleCrypto?.supports?.('sign', 'ML-DSA-65')) supportedSuites.push('ML-DSA-65');
+for (const suite of supportedSuites) {
+  test(`${suite}: authentic receipts and vouchers survive export/import; tampering fails`, async () => {
+    const signer = await createSigner(suite);
+    assert.equal(signer.keys.privateKey.extractable, false);
+    const trusted = await importVerificationKey(serialize(signer.verificationKey));
+    const receipt = await signArtifact(signer, details);
+    assert.equal((await verifyArtifact(serialize(receipt), trusted)).payload.amountCents, 550);
+    const changed = structuredClone(receipt);
+    const payload = JSON.parse(changed.payload);
+    payload.amountCents = 1;
