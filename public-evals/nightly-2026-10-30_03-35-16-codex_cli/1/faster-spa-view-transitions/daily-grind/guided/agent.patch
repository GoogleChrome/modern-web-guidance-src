index 0000000..98d9059
--- /dev/null
+++ b/navigation.js
@@ -0,0 +1,61 @@
+(() => {
+  const views = new Map(
+    [...document.querySelectorAll('[data-view]')].map(view => [view.dataset.view, view])
+  );
+  const links = document.querySelectorAll('[data-route]');
+  const scrollPositions = new Map();
+  let activeRoute;
+
+  // Hash URLs support bookmarks, reloads, and Back/Forward on static hosting.
+  // Only these five fixed views are cached, so the cache cannot grow unbounded.
+  function showRoute({ initial = false } = {}) {
+    const requestedRoute = window.location.hash.slice(2);
+    const route = views.has(requestedRoute) ? requestedRoute : 'home';
+
+    if (window.location.hash !== `#/${route}`) {
+      window.history.replaceState(null, '', `#/${route}`);
+    }
+    if (route === activeRoute) return;
+
+    if (activeRoute) scrollPositions.set(activeRoute, window.scrollY);
+
+    const nextView = views.get(route);
+    nextView.classList.remove('inactive');
+    nextView.removeAttribute('inert');
+    nextView.removeAttribute('aria-hidden');
+
+    // Move focus before hiding its previous owner from assistive technology.
+    // Leave focus alone on the initial home page load.
+    if (!initial || route !== 'home') {
+      nextView.querySelector('h1').focus({ preventScroll: true });
+    }
+
+    for (const [name, view] of views) {
+      if (name === route) continue;
+      view.setAttribute('inert', '');
+      view.setAttribute('aria-hidden', 'true');
+      view.classList.add('inactive');
+    }
+
+    for (const link of links) {
+      if (link.dataset.route === route) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    }
+
+    document.title = `${nextView.dataset.title} | The Daily Grind`;
+    activeRoute = route;
+    window.scrollTo({ top: scrollPositions.get(route) ?? 0, behavior: 'instant' });
+  }
+
+  // The router owns scroll restoration; native history restoration would race it.
+  if ('scrollRestoration' in window.history) window.history.scrollRestoration = 'manual';
+  window.addEventListener('hashchange', () => showRoute());
+  showRoute({ initial: true });
+
+  const category = document.getElementById('menu-category');
+  category.addEventListener('change', () => {
+    for (const card of document.querySelectorAll('[data-category]')) {
+      card.hidden = category.value !== 'all' && card.dataset.category !== category.value;
+    }
+  });
+})();
