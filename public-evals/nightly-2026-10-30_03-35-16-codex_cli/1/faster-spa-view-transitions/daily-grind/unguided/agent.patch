+<script>
+    (() => {
+      const outlet = document.querySelector('#views');
+      // Each view is mounted once. Hiding it preserves inputs, listeners, and open details.
+      const views = new Map([['home', outlet.querySelector('[data-view="home"]')]]);
+      const scrollPositions = new Map();
+      const routes = new Set(['home', 'menu', 'locations', 'rewards', 'account']);
+      let activeRoute;
+      views.get('home').hidden = true;
+
+      function mount(route) {
+        if (views.has(route)) return views.get(route);
+        const view = document.querySelector(`#view-${route}`).content.firstElementChild.cloneNode(true);
+        view.hidden = true;
+        outlet.append(view);
+        views.set(route, view);
+
+        if (route === 'menu') {
+          view.querySelector('select').addEventListener('change', (event) => {
+            view.querySelectorAll('[data-category]').forEach((card) => {
+              card.hidden = event.target.value !== 'all' && card.dataset.category !== event.target.value;
+            });
+          });
+        }
+        if (route === 'locations') {
+          view.querySelector('input').addEventListener('input', (event) => {
+            const query = event.target.value.trim().toLowerCase();
+            const cards = [...view.querySelectorAll('[data-location]')];
+            cards.forEach((card) => { card.hidden = !card.dataset.location.includes(query); });
+            view.querySelector('#location-empty').hidden = cards.some((card) => !card.hidden);
+          });
+        }
+        if (route === 'account') {
+          view.querySelector('form').addEventListener('submit', (event) => {
+            event.preventDefault();
+            view.querySelector('[role="status"]').textContent = 'Preferences saved for this visit.';
+          });
+        }
+        return view;
+      }
+
+      function navigate() {
+        const requested = location.hash.replace(/^#\/?/, '') || 'home';
+        const route = routes.has(requested) ? requested : 'home';
+        if (route === activeRoute) return;
+        const isInitial = activeRoute === undefined;
+        if (!isInitial) {
+          scrollPositions.set(activeRoute, window.scrollY);
+          views.get(activeRoute).hidden = true;
+        }
+        const view = mount(route);
+        view.hidden = false;
+        activeRoute = route;
+        document.querySelectorAll('nav [data-route]').forEach((link) => {
+          if (link.dataset.route === route) link.setAttribute('aria-current', 'page');
+          else link.removeAttribute('aria-current');
+        });
+        document.title = route === 'home' ? 'The Daily Grind | Artisanal Coffee'
+          : `${route === 'account' ? 'My Account' : route[0].toUpperCase() + route.slice(1)} | The Daily Grind`;
+        if (!isInitial) {
+          view.querySelector('h1').focus({ preventScroll: true });
+          window.scrollTo(0, scrollPositions.get(route) ?? 0);
+        }
+      }
+
+      // The router owns scroll restoration for its retained views, including back/forward.
+      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+      outlet.querySelector('h1').tabIndex = -1;
+      window.addEventListener('hashchange', navigate);
+      navigate();
+    })();
+  </script>
 </body>
 
