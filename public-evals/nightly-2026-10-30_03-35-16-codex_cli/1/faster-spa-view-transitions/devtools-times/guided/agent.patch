diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..aa76359
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,69 @@
+import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
+
+// Includes the active view. Article routes are unbounded, so never retain them all.
+const MAX_VIEWS = 5;
+const views = new Map<string, HTMLElement>();
+const viewKey = (url: URL) => url.pathname + url.search;
+const host = () => document.querySelector<HTMLElement>("[data-view-cache]");
+let activeKey = viewKey(new URL(location.href));
+let focusAfterNavigation = false;
+
+const initialView = host()?.querySelector<HTMLElement>(".spa-view");
+if (initialView) views.set(activeKey, initialView);
+
+document.addEventListener("astro:before-swap", (event) => {
+  const navigation = event as TransitionBeforeSwapEvent;
+  const incoming = navigation.newDocument.querySelector<HTMLElement>(
+    "[data-view-cache] > .spa-view",
+  );
+  if (!host() || !incoming) return;
+
+  // Wrap Astro's swap so it still handles head, scripts, shell, history and scrolling.
+  // The persistent host keeps every retained view connected, including React islands.
+  const swap = navigation.swap;
+  navigation.swap = () => {
+    const key = viewKey(navigation.to);
+    const outgoing = views.get(activeKey);
+    // Same-URL navigation is an explicit refresh; never substitute stale DOM for it.
+    const cached = key !== activeKey && incoming.dataset.cacheable === "true"
+      ? views.get(key)
+      : undefined;
+
+    swap();
+    const container = host();
+    if (!container) return;
+
+    if (outgoing?.dataset.cacheable === "false" || key === activeKey) {
+      outgoing?.remove();
+      views.delete(activeKey);
+    }
+
+    const next = cached ?? incoming;
+    if (!cached) container.append(next);
+    // Reinsertion in the Map records the most recently used view.
+    views.delete(key);
+    views.set(key, next);
+    activeKey = key;
+
+    for (const view of views.values()) {
+      const inactive = view !== next;
+      view.classList.toggle("inactive", inactive);
+      view.inert = inactive;
+      if (inactive) view.setAttribute("aria-hidden", "true");
+      else view.removeAttribute("aria-hidden");
+    }
+
+    while (views.size > MAX_VIEWS) {
+      const oldest = views.keys().next().value!;
+      views.get(oldest)?.remove();
+      views.delete(oldest);
+    }
+    focusAfterNavigation = true;
+  };
+});
+
+document.addEventListener("astro:page-load", () => {
+  if (!focusAfterNavigation) return;
+  focusAfterNavigation = false;
+  views.get(activeKey)?.focus({ preventScroll: true });
+});
