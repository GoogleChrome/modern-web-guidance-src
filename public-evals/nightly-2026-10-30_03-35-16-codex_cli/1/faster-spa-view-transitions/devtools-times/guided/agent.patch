+
+/* Keep inactive DOM and rendering state without occupying the page or accepting input. */
+.spa-view.inactive {
+  content-visibility: hidden;
+  position: absolute;
+  inset: 0 0 auto;
+  block-size: 0;
+  overflow: clip;
+  pointer-events: none;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
