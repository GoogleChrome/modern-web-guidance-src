diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..9bc5095
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,66 @@
+import type { TransitionBeforePreparationEvent, TransitionBeforeSwapEvent } from "astro:transitions/client";
+
+// Keep live nodes (including hydrated islands) inside Astro's persistent main.
+// Map insertion order supplies a least-recently-used eviction policy.
+const MAX_VIEWS = 5;
+const views = new Map<string, HTMLElement>();
+const viewKey = (url: URL) => url.pathname + url.search;
+let invalidateOnSwap = false;
+
+document.addEventListener("astro:before-preparation", (event) => {
+  invalidateOnSwap = Boolean((event as TransitionBeforePreparationEvent).formData);
+});
+
+document.addEventListener("astro:before-swap", (event) => {
+  const navigation = event as TransitionBeforeSwapEvent;
+  const container = document.querySelector<HTMLElement>("[data-view-container]");
+  const incoming = navigation.newDocument.querySelector<HTMLElement>("[data-page-view]");
+  if (!container || !incoming) return;
+
+  const swap = navigation.swap;
+  navigation.swap = () => {
+    const current = container.querySelector<HTMLElement>("[data-page-view]:not([hidden])");
+    const fromKey = viewKey(navigation.from);
+    const toKey = viewKey(navigation.to);
+
+    // Submissions may change server state: do not restore an earlier view.
+    if (invalidateOnSwap) {
+      for (const view of views.values()) {
+        if (view !== current) view.remove();
+      }
+      views.clear();
+    }
+
+    if (current) {
+      current.hidden = true;
+      current.inert = true;
+      if (current.dataset.cacheView === "true" && !invalidateOnSwap) {
+        views.delete(fromKey);
+        views.set(fromKey, current);
+      } else {
+        current.remove();
+      }
+    }
+
+    const cached = incoming.dataset.cacheView === "true" ? views.get(toKey) : undefined;
+    const next = cached ?? incoming;
+
+    // Let Astro handle the head, history, scroll, focus, scripts and persistence.
+    // Insert new content afterwards so Astro doesn't try to persist its islands
+    // against the islands in the outgoing document.
+    swap();
+    if (!cached) container.append(next);
+    next.hidden = false;
+    next.inert = false;
+
+    if (next.dataset.cacheView === "true") {
+      views.delete(toKey);
+      views.set(toKey, next);
+    }
+    while (views.size > MAX_VIEWS) {
+      const oldestKey = views.keys().next().value!;
+      views.get(oldestKey)!.remove();
+      views.delete(oldestKey);
+    }
+  };
+});
