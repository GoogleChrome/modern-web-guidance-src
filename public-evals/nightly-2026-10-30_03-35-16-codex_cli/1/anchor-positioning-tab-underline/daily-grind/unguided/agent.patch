+  <script>
+    const navList = document.querySelector('nav ul');
+    const navItems = [...navList.querySelectorAll('[data-nav-item]')];
+    const currentPath = window.location.pathname.replace(/\/$/, '');
+    let selectedItem = navItems.find(item => item.pathname === currentPath) || navItems[0];
+
+    function updateIndicator() {
+      const listBounds = navList.getBoundingClientRect();
+      const itemBounds = selectedItem.getBoundingClientRect();
+      navList.style.setProperty('--indicator-left', `${itemBounds.left - listBounds.left}px`);
+      navList.style.setProperty('--indicator-width', `${itemBounds.width}px`);
+    }
+
+    function selectItem(item) {
+      navItems.forEach(link => link.removeAttribute('aria-current'));
+      selectedItem = item;
+      selectedItem.setAttribute('aria-current', 'page');
+      updateIndicator();
+    }
+
+    navItems.forEach(item => {
+      item.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        selectItem(item);
+      });
+    });
+
+    selectItem(selectedItem);
+    // Commit the initial position before enabling transitions between selections.
+    navList.getBoundingClientRect();
+    navList.classList.add('indicator-ready');
+    new ResizeObserver(updateIndicator).observe(navList);
+    document.fonts.ready.then(updateIndicator);
+  </script>
 </body>
 
