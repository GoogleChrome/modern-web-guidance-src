+  <script>
+    const navList = document.querySelector('nav ul');
+    const navLinks = [...navList.querySelectorAll('a:not(.logout-link)')];
+    const currentPath = window.location.pathname.replace(/\/$/, '');
+    let activeLink = navLinks.find(link =>
+      currentPath === link.pathname || currentPath.startsWith(`${link.pathname}/`)
+    ) || navLinks[0];
+
+    function positionIndicator() {
+      const listBounds = navList.getBoundingClientRect();
+      const linkBounds = activeLink.getBoundingClientRect();
+      navList.style.setProperty('--indicator-x', `${linkBounds.left - listBounds.left}px`);
+      navList.style.setProperty('--indicator-width', linkBounds.width);
+    }
+
+    function selectLink(link) {
+      navLinks.forEach(item => item.removeAttribute('aria-current'));
+      activeLink = link;
+      activeLink.setAttribute('aria-current', 'page');
+      positionIndicator();
+    }
+
+    navLinks.forEach(link => {
+      link.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        selectLink(link);
+      });
+    });
+
+    selectLink(activeLink);
+    requestAnimationFrame(() => {
+      requestAnimationFrame(() => {
+        navList.setAttribute('data-indicator-ready', '');
+      });
+    });
+    window.addEventListener('resize', positionIndicator);
+    document.fonts.ready.then(positionIndicator);
+  </script>
+
 </body>
 
