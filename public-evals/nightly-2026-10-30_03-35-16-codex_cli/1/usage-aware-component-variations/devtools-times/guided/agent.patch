@@ -0,0 +1,24 @@
+---
+import type { CollectionEntry } from 'astro:content';
+interface Props { article: CollectionEntry<'articles'>; image?: string; imageAlt?: string; priority?: boolean; }
+const { article, image, imageAlt = '', priority = false } = Astro.props;
+const base = import.meta.env.BASE_URL;
+const source = image || article.data.image;
+const imageSrc = source.startsWith('http') ? source : `${base}${source.replace(/^\//, '')}`;
+const label = article.data.category === 'Urban Development' ? 'Cities & society' : article.data.category;
+---
+<article class="context-story" data-category={article.data.category.toLowerCase()}>
+  <img class="story-image" src={imageSrc} alt={imageAlt} width="960" height="640" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
+  <header class="story-header">
+    <span class="story-category">{label}<span class="story-feature-label"> / THE BIG PICTURE</span></span>
+    <h2><a class="story-link" href={`${base}articles/${article.id}`}>{article.data.title}</a></h2>
+  </header>
+  <p class="story-summary">{article.data.summary}</p>
+  <footer class="story-footer">
+    <span class="story-author">By {article.data.author}<span class="meta-dot">·</span></span>
+    <span>{article.data.readingTime || 5} min read</span>
+    <button class="save-story" data-save-story={article.id} data-title={article.data.title} aria-label={`Save ${article.data.title}`} aria-pressed="false" title="Save story">
+      <svg width="17" height="19" viewBox="0 0 20 22" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 3h12v17l-6-4-6 4V3Z" /></svg>
+    </button>
+  </footer>
+</article>
