+    document.querySelectorAll<HTMLButtonElement>('[data-save-story]').forEach(button => button.addEventListener('click', () => {
+      const id = button.dataset.saveStory!;
+      const saved = getSaved();
+      const next = saved.includes(id) ? saved.filter(item => item !== id) : [...saved, id];
+      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(next)); } catch { document.querySelector('#save-announcement')!.textContent = 'Your browser could not save this story. Please enable local storage.'; return; }
+      syncSaved();
+      document.querySelector('#save-announcement')!.textContent = next.includes(id) ? 'Story saved to your reading list.' : 'Story removed from your reading list.';
+    }));
+    document.querySelectorAll<HTMLButtonElement>('[data-open-reader]').forEach(button => button.addEventListener('click', () => {
+      mode = button.dataset.openReader!;
+      document.querySelector('#reader-title')!.textContent = mode === 'saved' ? 'Your reading list.' : 'Find your next read.';
+      input.value = '';
+      input.placeholder = mode === 'saved' ? 'Search your saved stories…' : 'Search stories, topics, or authors…';
+      filterResults(); dialog.showModal(); input.focus();
+    }));
+    document.querySelector('[data-close-reader]')?.addEventListener('click', () => dialog.close());
+    dialog.addEventListener('click', event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
+    input.addEventListener('input', filterResults);
+    window.addEventListener('storage', event => { if (event.key === STORAGE_KEY) syncSaved(); });
+    window.addEventListener('times:saved', syncSaved);
+    syncSaved();
+  }
+  initReader();
+  document.addEventListener('astro:page-load', initReader);
+</script>
