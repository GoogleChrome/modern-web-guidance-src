+import React, { useState } from 'react';
+import { Squares2X2Icon, SwatchIcon, CubeIcon, BoltIcon, BookOpenIcon, ArrowUpRightIcon, ChevronRightIcon, ChevronDownIcon, MagnifyingGlassIcon, AdjustmentsHorizontalIcon, ArrowRightIcon, CheckIcon, CheckCircleIcon, ExclamationTriangleIcon, InformationCircleIcon, XMarkIcon, PlusIcon, CodeBracketIcon, SunIcon, MoonIcon, ArrowPathIcon, DocumentDuplicateIcon, HeartIcon } from '@heroicons/react/24/outline';
+
+const intents = {
+  success: { title: 'Changes saved successfully', description: 'Your workspace is up to date. You’re all set.', label: 'View changes', icon: CheckCircleIcon, badge: 'Success' },
+  warning: { title: 'A little attention needed', description: 'Your trial ends in 3 days. Keep your work flowing.', label: 'Manage plan', icon: ExclamationTriangleIcon, badge: 'Warning' },
+  info: { title: 'Something new to explore', description: 'Your workspace just got a few helpful upgrades.', label: 'See what’s new', icon: InformationCircleIcon, badge: 'Information' },
+  danger: { title: 'Connection interrupted', description: 'We couldn’t sync your changes. Give it another try.', label: 'Try again', icon: ExclamationTriangleIcon, badge: 'Danger' },
+};
+type Intent = keyof typeof intents;
+const categories = ['All components', 'Feedback', 'Actions', 'Data display', 'Inputs'];
+const componentData = [
+  { name: 'Alert', description: 'The right message, in the right moment.', category: 'Feedback', variants: 4, type: 'alert' },
+  { name: 'Button', description: 'Actions with a clear sense of purpose.', category: 'Actions', variants: 6, type: 'button' },
+  { name: 'Badge', description: 'Small signals. Meaningful context.', category: 'Data display', variants: 8, type: 'badge' },
+  { name: 'Toast', description: 'A little feedback goes a long way.', category: 'Feedback', variants: 4, type: 'toast' },
+  { name: 'Input', description: 'Guidance at every step of the way.', category: 'Inputs', variants: 5, type: 'input' },
+  { name: 'Progress', description: 'Make every step feel like progress.', category: 'Data display', variants: 3, type: 'progress' },
+];
+
+export default function ContextApp() {
+  const [section, setSection] = useState('Overview');
+  const [category, setCategory] = useState('All components');
+  const [query, setQuery] = useState('');
+  const [intent, setIntent] = useState<Intent>('success');
+  const [tab, setTab] = useState('Preview');
+  const [selected, setSelected] = useState('Alert');
+  const [dark, setDark] = useState(false);
+  const [toast, setToast] = useState('');
+  const [size, setSize] = useState('Medium');
+  const [variant, setVariant] = useState('Soft');
+  const [showIcon, setShowIcon] = useState(true);
+  const [showAction, setShowAction] = useState(true);
+  const [versionOpen, setVersionOpen] = useState(false);
+  const [email, setEmail] = useState('');
+  const notify = (message: string) => { setToast(message); window.setTimeout(() => setToast(''), 3200); };
+  const current = intents[intent];
+  const StatusIcon = current.icon;
+  const code = `<${selected}\n  intent="${intent}"\n  variant="${variant.toLowerCase()}"\n  size="${size.toLowerCase()}"\n  icon={${showIcon}}\n>\n  ${current.title}\n</${selected}>`;
+  const copy = async () => { try { await navigator.clipboard.writeText(code); notify('Component code copied to clipboard'); } catch { notify('Select and copy the code from the Code tab'); setTab('Code'); } };
+  const items = componentData.filter(c => (category === 'All components' || c.category === category) && `${c.name} ${c.description} ${c.category}`.toLowerCase().includes(query.toLowerCase()));
+  const nav = [{ name: 'Overview', icon: Squares2X2Icon }, { name: 'Components', icon: CubeIcon }, { name: 'Foundations', icon: SwatchIcon }, { name: 'Patterns', icon: BoltIcon }];
+
+  function Preview({ type, interactive = false }: { type: string; interactive?: boolean }) {
+    if (type === 'button') return <div className="button-samples"><button className="sample-button primary" onClick={() => notify('Your changes have been saved')}><PlusIcon />{interactive ? current.label : 'Create project'}</button><button className="sample-button secondary" onClick={() => notify('Changes saved successfully')}><CheckIcon />Save changes</button><button className="sample-button danger" onClick={() => notify('Delete action previewed — no data was removed')}>Delete</button></div>;
+    if (type === 'badge') return <div className="badge-samples"><span className={`badge ${interactive ? intent : 'green'}`}><i />{interactive ? current.badge : 'Published'}</span><span className="badge amber"><i />In progress</span><span className="badge blue">New feature</span><span className="badge gray">Draft</span><span className="badge coral"><BoltIcon />Pro</span></div>;
+    if (type === 'toast') return <div className="toast-sample"><span className="toast-check">{interactive ? <StatusIcon /> : <CheckIcon />}</span><div><strong>{interactive ? current.title : 'Looking good!'}</strong><p>{interactive ? current.description : 'Your changes have been saved.'}</p></div><XMarkIcon /></div>;
+    if (type === 'input') return <div className="input-sample"><label htmlFor={interactive ? 'play-email' : 'card-email'}>Email address <span>*</span></label><div className="input-wrapper"><input id={interactive ? 'play-email' : 'card-email'} type="email" defaultValue={email} onBlur={e => setEmail(e.target.value)} placeholder="you@example.com" /><CheckCircleIcon /></div><small>{email && !email.includes('@') ? 'Please enter a valid email address.' : 'We’ll only send the good stuff.'}</small></div>;
+    if (type === 'progress') return <div className="progress-sample"><div><strong>{interactive ? current.title : 'Setting up your workspace'}</strong><span>Step 2 of 3</span></div><div className="progress-track"><i /></div><p><CheckCircleIcon />Profile created<span /><span className="current-step">Workspace details</span></p></div>;
+    return <div className={`semantic-alert ${interactive ? intent : 'success'} ${interactive ? variant.toLowerCase() : ''} ${interactive ? size.toLowerCase() : ''}`}>
+      {(!interactive || showIcon) && <StatusIcon />}
+      <div><strong>{interactive ? current.title : intents.success.title}</strong><p>{interactive ? current.description : intents.success.description}</p>{interactive && showAction && <button onClick={() => notify(`${current.label}: action completed`)}>{current.label}<ArrowRightIcon /></button>}</div>
+      {!interactive && <XMarkIcon className="alert-x" />}
+    </div>;
+  }
+
+  return <div className={`app ${dark ? 'dark' : ''}`}>
+    <aside className="sidebar">
+      <a className="brand" href={import.meta.env.BASE_URL}><span className="brand-mark"><span /><span /><span /><span /></span>context<span className="brand-dot">.</span></a>
+      <button className="workspace" onClick={() => setVersionOpen(!versionOpen)}><span className="workspace-icon"><CubeIcon /></span><span>Workspace<small>Personal workspace</small></span><ChevronDownIcon /></button>
+      {versionOpen && <div className="workspace-menu">Personal workspace <CheckIcon /><span>Context library · v1.2.0</span></div>}
+      <div className="nav-caption">WORKSPACE</div>
+      <nav>{nav.map(n => <button key={n.name} className={section === n.name ? 'nav-item active' : 'nav-item'} onClick={() => {setSection(n.name); setQuery(''); setCategory('All components');}}><n.icon />{n.name}{n.name === 'Components' && <span className="nav-count">24</span>}</button>)}</nav>
+      <div className="nav-caption resources-caption">RESOURCES</div>
+      <button className={`nav-item ${section === 'Documentation' ? 'active' : ''}`} onClick={() => setSection('Documentation')}><BookOpenIcon />Documentation<ArrowUpRightIcon className="external" /></button>
+      <button className={`nav-item ${section === 'Changelog' ? 'active' : ''}`} onClick={() => setSection('Changelog')}><ArrowPathIcon />Changelog<span className="new-dot" /></button>
+      <div className="sidebar-bottom"><div className="sidebar-promo"><span className="promo-icon">✧</span><strong>A little context.<br />A lot of possibility.</strong><p>Thoughtful components for<br />whatever you’re building.</p><button onClick={() => {setSection('Documentation');}}>Explore the docs <ArrowUpRightIcon /></button></div><button className="user" onClick={() => notify('You’re using the personal workspace')}><span className="avatar">JD</span><span>Jamie Davis<small>Personal account</small></span><ChevronDownIcon /></button></div>
+    </aside>
+    <div className="main-shell">
+      <header className="topbar"><div className="breadcrumb">Workspace<ChevronRightIcon /><span>{section}</span></div><div className="topbar-right"><span className="version">v1.2.0 <i /></span><span className="topbar-divider" /><button aria-label="Toggle color theme" className="icon-button" onClick={() => setDark(!dark)}>{dark ? <MoonIcon /> : <SunIcon />}</button><button className="top-avatar" onClick={() => notify('Welcome back, Jamie')}>JD</button></div></header>
+      <main>
+        <div className="page-heading"><div><div className="eyebrow"><span /> THE CONTEXT LIBRARY</div><h1>{section === 'Overview' ? 'Good design understands context.' : section === 'Components' ? 'Small parts. Thoughtful possibilities.' : section === 'Foundations' ? 'A shared language for good design.' : section === 'Patterns' ? 'Thoughtful parts, working together.' : section === 'Documentation' ? 'A little context to get you started.' : 'Always getting a little better.'}</h1><p>Components that adapt to meaning, intent, and the moment. Built to feel right.</p></div><button className="docs-button" onClick={() => setSection(section === 'Documentation' ? 'Overview' : 'Documentation')}><BookOpenIcon />{section === 'Documentation' ? 'Back to overview' : 'View documentation'}<ArrowUpRightIcon /></button></div>
+        {(section === 'Overview' || section === 'Components') && <>
+          <section className="hero-banner"><div className="hero-copy"><span className="hero-tag"><span /> MORE THAN A DIFFERENT COLOR</span><h2>Same component.<br />A whole new meaning.</h2><p>Let context do the heavy lifting. Explore components<br className="desktop-break" /> that respond to the story you’re telling.</p><button onClick={() => document.getElementById('playground')?.scrollIntoView({ behavior: 'smooth', block: 'start' })}>Explore the playground <ArrowRightIcon /></button></div><div className="hero-art" aria-label="One component adapting to success, warning and information"><span className="orbit orbit-one" /><span className="orbit orbit-two" /><div className="art-label"><span /> context-aware</div><div className="floating-card float-success"><span><CheckCircleIcon /></span><div><strong>You’re all set</strong><p>Everything is in its right place.</p></div><span className="mini-badge">Success</span></div><div className="floating-card float-warning"><span><ExclamationTriangleIcon /></span><div><strong>A little heads-up</strong><p>Some things need your attention.</p></div><span className="mini-badge">Warning</span></div><div className="floating-card float-info"><span><InformationCircleIcon /></span><div><strong>Good to know</strong><p>A little context makes a difference.</p></div><span className="mini-badge">Info</span></div><span className="art-spark spark-one">✧</span><span className="art-spark spark-two">+</span></div></section>
+          <div className="stats-row"><div><span className="stat-icon"><CubeIcon /></span><strong>24<span>Thoughtful components</span></strong></div><div><span className="stat-icon"><SwatchIcon /></span><strong>6<span>Semantic intents</span></strong></div><div><span className="stat-icon"><BoltIcon /></span><strong>100%<span>Context-aware</span></strong></div><div><span className="stat-icon"><CodeBracketIcon /></span><strong>Built for you<span>Accessible by default</span></strong></div></div>
+          <section className="component-section"><div className="section-title"><div><h2>The building blocks <span>Made to work together.</span></h2></div><button className="text-button" onClick={() => {setSection('Components'); setCategory('All components'); setQuery('');}}>View all components <ArrowRightIcon /></button></div><div className="filter-bar"><div className="category-tabs">{categories.map(c => <button key={c} className={category === c ? 'selected' : ''} onClick={() => setCategory(c)}>{c}</button>)}</div><div className="search-box"><MagnifyingGlassIcon /><input aria-label="Search components" placeholder="Find a component..." value={query} onChange={e => setQuery(e.target.value)} /><span>/</span></div></div><div className="component-grid">{items.map(c => <article key={c.name} className={`component-card ${selected === c.name ? 'is-selected' : ''}`}><div className={`card-preview ${c.type}-preview`}><Preview type={c.type} /></div><button className="card-description" onClick={() => { setSelected(c.name); document.getElementById('playground')?.scrollIntoView({ behavior: 'smooth', block: 'center' }); }}><div><h3>{c.name}<span>{c.variants} variants</span></h3><p>{c.description}</p></div><ArrowUpRightIcon /></button></article>)}</div>{!items.length && <div className="empty-state"><MagnifyingGlassIcon /><h3>No components found</h3><p>Try another search or choose a different category.</p><button onClick={() => {setQuery(''); setCategory('All components');}}>Clear filters</button></div>}</section>
+          <section id="playground" className="playground-section"><div className="section-title"><h2>A little room to play <span>Change the context. See what happens.</span></h2><span className="live-label"><i />Live playground</span></div><div className="playground"><div className="play-controls"><div className="play-control-heading"><AdjustmentsHorizontalIcon /><strong>Make it yours</strong><button aria-label="Reset playground" onClick={() => {setIntent('success'); setSize('Medium');setVariant('Soft');setShowIcon(true);setShowAction(true);setSelected('Alert');}}><ArrowPathIcon /></button></div><label>Component<select value={selected} onChange={e => setSelected(e.target.value)}>{componentData.map(c => <option key={c.name}>{c.name}</option>)}</select></label><label>Semantic intent<div className="intent-options">{(Object.keys(intents) as Intent[]).map(i => <button key={i} title={intents[i].badge} aria-label={intents[i].badge} aria-pressed={intent === i} className={`intent-dot ${i} ${intent === i ? 'chosen' : ''}`} onClick={() => setIntent(i)}>{intent === i && <CheckIcon />}</button>)}<span>{current.badge}</span></div></label><div className="paired-controls"><label>Variant<select value={variant} onChange={e => setVariant(e.target.value)}><option>Soft</option><option>Outline</option><option>Solid</option></select></label><label>Size<select value={size} onChange={e => setSize(e.target.value)}><option>Small</option><option>Medium</option><option>Large</option></select></label></div><div className="switch-row">Show icon<button role="switch" aria-label="Show icon" aria-checked={showIcon} className={`switch ${showIcon ? 'on' : ''}`} onClick={() => setShowIcon(!showIcon)}><span /></button></div><div className="switch-row">Show action<button role="switch" aria-label="Show action" aria-checked={showAction} className={`switch ${showAction ? 'on' : ''}`} onClick={() => setShowAction(!showAction)}><span /></button></div></div><div className="play-output"><div className="output-header"><div>{['Preview','Code'].map(t => <button key={t} className={tab === t ? 'active' : ''} onClick={() => setTab(t)}>{t === 'Preview' ? <Squares2X2Icon /> : <CodeBracketIcon />}{t}</button>)}</div><button className="copy-button" onClick={copy}><DocumentDuplicateIcon />Copy code</button></div><div className={`output-canvas ${tab === 'Code' ? 'code-canvas' : ''}`}>{tab === 'Code' ? <pre><code>{code}</code></pre> : <div className={`live-preview intent-${intent} variant-${variant.toLowerCase()} size-${size.toLowerCase()} ${!showIcon ? 'hide-icons' : ''} ${!showAction ? 'hide-actions' : ''}`}><Preview type={selected.toLowerCase()} interactive /></div>}</div><div className="output-footer"><span><span className={`tiny-dot ${intent}`} />{selected}<span className="slash">/</span>{current.badge}<span className="slash">/</span>{variant}</span><span><CheckCircleIcon /> WCAG AA compliant</span></div></div></div></section>
+        </>}
+        {section === 'Foundations' && <section className="resource-grid"><article className="resource-card"><SwatchIcon /><h2>Semantic color</h2><p>Colors carry meaning across every component.</p>{(Object.keys(intents) as Intent[]).map(i => <div className={`foundation-swatch ${i}`} key={i}><span className={`tiny-dot ${i}`} />{intents[i].badge}<code>{i}</code></div>)}</article><article className="resource-card"><h2>Typography</h2><p>Clear hierarchy. Room to breathe.</p><h1>Made to make sense.</h1><h2>A little more understanding.</h2><p>Manrope for expressive headings. DM Sans for everyday clarity.</p><hr /><h2>Spacing</h2><p>Our spacing system follows a consistent 4px rhythm.</p><div className="spacing-demo">{[4,8,16,24,32].map(n => <span key={n}><i style={{width:n, height:n}} />{n}px</span>)}</div></article></section>}
+        {section === 'Patterns' && <section className="resource-grid"><article className="resource-card"><h2>A thoughtful form</h2><p>Inputs, feedback, and actions working together.</p><Preview type="input" interactive /><br /><button className="sample-button primary" onClick={() => notify(email.includes('@') ? 'You’re on the list! Thanks for joining.' : 'Enter a valid email address to continue.')}>Join the list <ArrowRightIcon /></button></article><article className="resource-card"><h2>Keep people in the loop</h2><p>Make the next step clear and the progress visible.</p><Preview type="progress" /><br /><Preview type="alert" /><br /><Preview type="badge" /></article></section>}
+        {section === 'Documentation' && <section className="resource-grid"><article className="resource-card"><BookOpenIcon /><h2>Start with meaning</h2><p>Choose a component, then choose the intent that matches your message. Context handles its visual language.</p><ol><li>Choose your building block: Alert, Button, Badge, Toast, Input, or Progress.</li><li>Set a semantic intent: success, warning, information, or danger.</li><li>Fine-tune its variant, size, icon, and action in the playground.</li><li>Copy the configuration and adapt it for your project.</li></ol><button className="sample-button primary" onClick={() => {setSection('Overview'); setTimeout(() => document.getElementById('playground')?.scrollIntoView({behavior:'smooth'}), 100);}}>Open the playground <ArrowRightIcon /></button></article><article className="resource-card"><CodeBracketIcon /><h2>Designed for every context</h2><p>Semantic components communicate through a combination of clear text, color, and familiar icons.</p><pre>{'<Alert\n  intent="success"\n  variant="soft"\n  size="medium"\n>\n  Changes saved successfully\n</Alert>'}</pre><p>The code panel provides a framework-neutral component configuration for your implementation.</p></article></section>}
+        {section === 'Changelog' && <section className="resource-card changelog"><span className="badge green">v1.2.0 · Latest</span><h2>A more thoughtful playground</h2><p>October 30, 2026</p><ul><li>Explore six foundational components in the live gallery.</li><li>Switch semantic intents, variants, and sizes.</li><li>Find the right building block with search and categories.</li><li>Try light and dark workspaces.</li></ul><hr /><span className="badge gray">v1.1.0</span><h2>Foundations, with meaning</h2><p>Introduced semantic color, typography, and a consistent spacing system.</p></section>}
+        <footer><span><span className="footer-symbol">✳</span> Thoughtfully made. Contextually aware.</span><span>Built with a little context <HeartIcon /><span className="footer-divider">·</span> v1.2.0</span></footer>
+      </main>
+    </div>
+    {toast && <div className="notification" role="status"><CheckCircleIcon />{toast}<button aria-label="Dismiss notification" onClick={() => setToast('')}><XMarkIcon /></button></div>}
+  </div>;
+}
