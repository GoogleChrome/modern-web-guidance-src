+  <script>
+    const cartList = document.querySelector('.SwipeableList');
+    const cartStatus = document.querySelector('.cart-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function removeCartItem(item, direction = -1) {
+      if (item.classList.contains('is-removing')) return;
+      const content = item.querySelector('.SwipeableList-content');
+      const button = item.querySelector('button');
+      const moveFocus = item.contains(document.activeElement);
+      const nextButton = item.nextElementSibling?.querySelector('button')
+        || item.previousElementSibling?.querySelector('button');
+      item.style.height = `${item.getBoundingClientRect().height}px`;
+      item.classList.remove('is-dragging');
+      item.classList.add('is-removing');
+      button.disabled = true;
+      content.style.transform = `translateX(${direction * 100}%)`;
+
+      // Reveal the action color before collapsing the entire row, including its spacing.
+      window.setTimeout(() => {
+        item.style.height = '0px';
+        item.style.opacity = '0';
+        window.setTimeout(() => {
+          item.remove();
+          const count = cartList.children.length;
+          cartStatus.textContent = count
+            ? `${item.dataset.name} removed. ${count} ${count === 1 ? 'item' : 'items'} in your cart.`
+            : 'Your cart is empty.';
+          if (moveFocus) {
+            if (nextButton?.isConnected && !nextButton.disabled) nextButton.focus();
+            else {
+              cartStatus.tabIndex = -1;
+              cartStatus.focus();
+            }
+          }
+        }, reducedMotion.matches ? 0 : 300);
+      }, reducedMotion.matches ? 0 : 220);
+    }
+
+    cartList.querySelectorAll('.SwipeableList-item').forEach(item => {
+      const content = item.querySelector('.SwipeableList-content');
+      let gesture = null;
+
+      function resetGesture() {
+        gesture = null;
+        item.classList.remove('is-dragging', 'is-ready', 'is-swiping-right');
+        content.style.transform = '';
+      }
+
+      content.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0 || event.target.closest('button')
+          || item.classList.contains('is-removing')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, delta: 0, locked: false };
+      });
+
+      content.addEventListener('pointermove', event => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.locked) {
+          if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) {
+            resetGesture();
+            return;
+          }
+          if (Math.abs(dx) < 8) return;
+          gesture.locked = true;
+          content.setPointerCapture(event.pointerId);
+          item.classList.add('is-dragging');
+        }
+        gesture.delta = dx;
+        content.style.transform = `translateX(${dx}px)`;
+        item.classList.toggle('is-swiping-right', dx > 0);
+        item.classList.toggle('is-ready', Math.abs(dx) >= Math.min(110, content.clientWidth * 0.35));
+      });
+
+      content.addEventListener('pointerup', event => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const { delta, locked } = gesture;
+        gesture = null;
+        if (locked && Math.abs(delta) >= Math.min(110, content.clientWidth * 0.35)) {
+          removeCartItem(item, Math.sign(delta));
+        } else resetGesture();
+      });
+
+      content.addEventListener('pointercancel', resetGesture);
+      content.addEventListener('lostpointercapture', () => {
+        if (gesture) resetGesture();
+      });
+      content.addEventListener('pointerleave', () => {
+        if (gesture && !gesture.locked) resetGesture();
+      });
+      item.querySelector('button').addEventListener('click', () => removeCartItem(item));
+    });
+  </script>
