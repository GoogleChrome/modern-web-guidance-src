+  <script>
+    const signinForm = document.querySelector('#signin-form');
+    const signinButton = document.querySelector('[data-testid="signin-button"]');
+    const signinStatus = document.querySelector('#signin-status');
+
+    function decodeBase64url(value) {
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+      return Uint8Array.from(atob(base64), character => character.charCodeAt(0));
+    }
+
+    function encodeBase64url(value) {
+      return btoa(String.fromCharCode(...new Uint8Array(value)))
+        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function parseCreationOptions(options) {
+      if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+        return PublicKeyCredential.parseCreationOptionsFromJSON(options);
+      }
+      // Older conditional-create clients may lack the JSON convenience methods.
+      return {
+        ...options,
+        challenge: decodeBase64url(options.challenge),
+        user: { ...options.user, id: decodeBase64url(options.user.id) },
+        excludeCredentials: (options.excludeCredentials ?? []).map(credential => ({
+          ...credential, id: decodeBase64url(credential.id)
+        }))
+      };
+    }
+
+    function serializeCredential(credential) {
+      if (typeof credential.toJSON === 'function') return credential.toJSON();
+      return {
+        id: credential.id,
+        rawId: encodeBase64url(credential.rawId),
+        type: credential.type,
+        authenticatorAttachment: credential.authenticatorAttachment,
+        clientExtensionResults: credential.getClientExtensionResults(),
+        response: {
+          clientDataJSON: encodeBase64url(credential.response.clientDataJSON),
+          attestationObject: encodeBase64url(credential.response.attestationObject),
+          transports: credential.response.getTransports?.() ?? []
+        }
+      };
+    }
+
+    async function promotePasskey() {
+      try {
+        if (!window.isSecureContext ||
+            typeof window.PublicKeyCredential?.getClientCapabilities !== 'function' ||
+            typeof navigator.credentials?.create !== 'function') return;
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalCreate !== true) return;
+
+        // The server must bind this challenge to the authenticated account and
+        // include its existing credential IDs in excludeCredentials.
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ conditional: true })
+        });
+        if (!optionsResponse.ok) return;
+        const options = await optionsResponse.json();
+        const publicKey = parseCreationOptions(options);
+        const credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional'
+        });
+        if (!credential) return;
+
+        const encodedCredential = serializeCredential(credential);
+        // The server must allow absent user presence only for this authenticated
+        // conditional-create ceremony, while still validating challenge/origin/RP.
+        const verification = await fetch('/api/register/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ ...encodedCredential, conditional: true })
+        });
+        const result = verification.ok ? await verification.json() : null;
+        if ((!verification.ok || result?.verified === false || result?.success === false) &&
+            typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id ?? location.hostname,
+            credentialId: encodedCredential.id
+          });
+        }
+      } catch {
+        // Promotion is best effort: no prompts, retries, or error UI.
+      }
+    }
+
+    signinForm.addEventListener('submit', async event => {
+      event.preventDefault();
+      if (signinButton.disabled) return;
+      signinButton.disabled = true;
+      signinStatus.textContent = 'Signing in…';
+      try {
+        const response = await fetch(signinForm.action, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            username: signinForm.elements.username.value,
+            password: signinForm.elements.password.value
+          })
+        });
+        if (!response.ok) throw new Error('Sign-in failed');
+        // /api/login must return success only after full password authentication
+        // (including any required additional factors) and establish a session.
+        void promotePasskey();
+        signinForm.elements.password.value = '';
+        signinForm.hidden = true;
+        signinStatus.textContent = 'You’re signed in.';
+      } catch {
+        signinStatus.textContent = 'Unable to sign in. Check your details and try again.';
+      } finally {
+        signinButton.disabled = false;
+      }
+    });
+  </script>
