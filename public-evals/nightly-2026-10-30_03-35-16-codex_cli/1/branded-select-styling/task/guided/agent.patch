+  <script>
+    // Keep the entire picker branded where customizable selects are unavailable.
+    if (!CSS.supports('appearance', 'base-select') || !CSS.supports('selector(::picker(select))')) {
+      const select = document.getElementById('coffee-roast');
+      const fallback = document.querySelector('.roast-fallback');
+      const summary = fallback.querySelector('summary');
+      const value = document.getElementById('roast-value');
+      select.hidden = true;
+      fallback.hidden = false;
+      const label = document.getElementById('roast-label');
+      label.removeAttribute('for');
+      label.addEventListener('click', () => summary.focus());
+
+      fallback.addEventListener('change', (event) => {
+        select.value = event.target.value;
+        value.textContent = select.selectedOptions[0].textContent;
+        select.dispatchEvent(new Event('change', { bubbles: true }));
+      });
+      fallback.addEventListener('click', (event) => {
+        if (event.target.matches('input')) {
+          fallback.open = false;
+          summary.focus();
+        }
+      });
+      document.addEventListener('click', (event) => {
+        if (!fallback.contains(event.target)) fallback.open = false;
+      });
+      fallback.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+          fallback.open = false;
+          summary.focus();
+        }
+      });
+    }
+  </script>
