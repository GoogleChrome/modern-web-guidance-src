+  <script>
+    const selector = document.querySelector('.roast-selector');
+    const trigger = document.getElementById('roast-trigger');
+    const list = document.getElementById('roast-options');
+    const options = [...list.querySelectorAll('[role="option"]')];
+
+    function closeRoasts(returnFocus = false) {
+      list.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (returnFocus) trigger.focus();
+    }
+
+    function openRoasts() {
+      list.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options.find(option => option.getAttribute('aria-selected') === 'true').focus();
+    }
+
+    function selectRoast(option) {
+      options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+      document.getElementById('roast-value').textContent = option.textContent;
+      document.getElementById('roast').value = option.dataset.roast;
+      closeRoasts(true);
+    }
+
+    trigger.addEventListener('click', () => list.hidden ? openRoasts() : closeRoasts());
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openRoasts();
+      }
+    });
+
+    options.forEach((option, index) => {
+      option.addEventListener('click', () => selectRoast(option));
+      option.addEventListener('keydown', event => {
+        const key = event.key;
+        if (['ArrowDown', 'ArrowUp', 'Home', 'End', 'Enter', ' ', 'Escape'].includes(key)) event.preventDefault();
+        if (key === 'ArrowDown') options[(index + 1) % options.length].focus();
+        else if (key === 'ArrowUp') options[(index + options.length - 1) % options.length].focus();
+        else if (key === 'Home') options[0].focus();
+        else if (key === 'End') options[options.length - 1].focus();
+        else if (key === 'Enter' || key === ' ') selectRoast(option);
+        else if (key === 'Escape') closeRoasts(true);
+        else {
+          const match = options.find(item => item.dataset.roast.startsWith(key.toLowerCase()));
+          if (key.length === 1 && match) match.focus();
+        }
+      });
+    });
+
+    document.addEventListener('click', event => {
+      if (!selector.contains(event.target)) closeRoasts();
+    });
+    selector.addEventListener('focusout', event => {
+      if (!selector.contains(event.relatedTarget)) closeRoasts();
+    });
+  </script>
