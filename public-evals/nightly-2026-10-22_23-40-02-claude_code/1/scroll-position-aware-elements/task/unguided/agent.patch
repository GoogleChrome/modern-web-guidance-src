diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -151,13 +151,82 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Scroll container */
+    .scroller {
+      position: relative;
+      height: 100vh;
+      overflow-y: auto;
+    }
+
+    /* Zero-cost sentinel: observed instead of listening to scroll events */
+    .scroll-sentinel {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 1px;
+      height: 300px;
+      pointer-events: none;
+      visibility: hidden;
+    }
+
+    /* Back to top */
+    .back-to-top {
+      position: fixed;
+      right: 24px;
+      bottom: 24px;
+      z-index: 1100;
+      width: 48px;
+      height: 48px;
+      border: 0;
+      border-radius: 50%;
+      background: var(--primary);
+      color: white;
+      font-size: 1.4rem;
+      line-height: 1;
+      cursor: pointer;
+      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
+      opacity: 0;
+      transform: translateY(16px);
+      /* visibility removes the button from tab order and a11y tree when hidden;
+         it flips only after the fade-out finishes */
+      visibility: hidden;
+      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0.3s;
+    }
+
+    .back-to-top.is-visible {
+      opacity: 1;
+      transform: translateY(0);
+      visibility: visible;
+      transition-delay: 0s;
+    }
+
+    .back-to-top:hover {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .back-to-top {
+        transition-duration: 0s;
+        transition-delay: 0s;
+      }
+    }
   </style>
 </head>
 
 <body>
 
+  <div class="scroller" id="scroller">
+  <div class="scroll-sentinel" aria-hidden="true"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +275,29 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button type="button" class="back-to-top" aria-label="Back to top">&uarr;</button>
+  </div>
+
+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var button = scroller.querySelector('.back-to-top');
+      var sentinel = scroller.querySelector('.scroll-sentinel');
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      new IntersectionObserver(function (entries) {
+        button.classList.toggle('is-visible', !entries[entries.length - 1].isIntersecting);
+      }, { root: scroller }).observe(sentinel);
+
+      button.addEventListener('click', function () {
+        scroller.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+        // Button hides once at top; move focus somewhere sensible first
+        scroller.querySelector('nav a').focus({ preventScroll: true });
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
