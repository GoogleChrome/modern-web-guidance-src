+  <script>
+    // Mirror the CSS :user-invalid state into aria-invalid for assistive tech
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const sync = (input) =>
+        input.setAttribute('aria-invalid', input.matches(':user-invalid') ? 'true' : 'false');
+      form.addEventListener('blur', (e) => {
+        if (e.target.matches('input')) sync(e.target);
+      }, true);
+      form.addEventListener('input', (e) => {
+        if (e.target.hasAttribute('aria-invalid')) sync(e.target);
+      });
+      form.addEventListener('invalid', (e) => sync(e.target), true);
+    })();
+  </script>
+
