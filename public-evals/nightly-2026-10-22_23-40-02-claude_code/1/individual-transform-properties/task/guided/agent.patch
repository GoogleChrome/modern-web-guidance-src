@@ -134,8 +134,64 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Featured promo badge */
+    .seasonal {
+      position: relative;
+    }
+
+    .target {
+      position: absolute;
+      top: 0;
+      right: 0;
+      width: 5.5rem;
+      aspect-ratio: 1;
+      display: grid;
+      place-items: center;
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 0.75rem;
+      font-weight: bold;
+      text-align: center;
+      text-transform: uppercase;
+      line-height: 1.2;
+      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
+      /* Explicit stacking context so hover doesn't change layering (no will-change) */
+      isolation: isolate;
+      z-index: 1;
+      /* Individual transform properties compose, so spin, slide and hover scale never override each other */
+      scale: 1;
+      transition: scale 0.3s ease;
+
+      @media (prefers-reduced-motion: no-preference) {
+        animation:
+          target-spin 6s linear infinite,
+          target-slide 4s ease-in-out infinite alternate;
+      }
+    }
+
+    .target:hover {
+      scale: 1.25;
+    }
+
+    @keyframes target-spin {
+      to {
+        rotate: 360deg;
+      }
+    }
+
+    @keyframes target-slide {
+      from {
+        translate: 0 0;
+      }
+
+      to {
+        translate: -12rem 0;
+      }
+    }
+
     footer {
