+    /* Roast Selector */
+    .roast-selector {
+      position: relative;
+      width: 220px;
+      margin-top: 1.5rem;
+      text-align: left;
+    }
+
+    .roast-label {
+      display: block;
+      font-size: 0.8rem;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      margin-bottom: 6px;
+    }
+
+    .roast-toggle {
+      width: 100%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      background: var(--primary);
+      color: white;
+      border: 1px solid var(--accent);
+      border-radius: 5px;
+      padding: 10px 14px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .roast-toggle:focus-visible,
+    .roast-option:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .roast-arrow {
+      width: 10px;
+      height: 10px;
+      border-right: 2px solid var(--accent);
+      border-bottom: 2px solid var(--accent);
+      transform: translateY(-2px) rotate(45deg);
+      transition: transform 0.2s;
+    }
+
+    .roast-toggle[aria-expanded="true"] .roast-arrow {
+      transform: translateY(2px) rotate(225deg);
+    }
+
+    .roast-list {
+      position: absolute;
+      top: 100%;
+      left: 0;
+      right: 0;
+      margin-top: 4px;
+      list-style: none;
+      background: var(--primary);
+      border: 1px solid var(--accent);
+      border-radius: 5px;
+      overflow: hidden;
+      z-index: 10;
+    }
+
+    .roast-list[hidden] {
+      display: none;
+    }
+
+    .roast-option {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding: 10px 14px;
+      color: white;
+      cursor: pointer;
+    }
+
+    .roast-option:hover,
+    .roast-option.active {
+      background: var(--accent);
+      color: var(--primary);
+    }
+
+    .roast-option::after {
+      content: '';
+      width: 6px;
+      height: 11px;
+      border-right: 2px solid var(--accent);
+      border-bottom: 2px solid var(--accent);
+      transform: rotate(45deg);
+      opacity: 0;
+    }
+
+    .roast-option[aria-selected="true"]::after {
+      opacity: 1;
+    }
+
+    .roast-option:hover::after,
+    .roast-option.active::after {
+      border-color: var(--primary);
+    }
+
