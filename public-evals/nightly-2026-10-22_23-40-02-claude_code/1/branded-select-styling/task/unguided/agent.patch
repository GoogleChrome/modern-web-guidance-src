+  <script>
+    (function () {
+      var toggle = document.getElementById('roast-toggle');
+      var list = document.getElementById('roast-list');
+      var valueEl = document.getElementById('roast-value');
+      var options = Array.prototype.slice.call(list.querySelectorAll('.roast-option'));
+      var active = 1;
+
+      function setActive(i) {
+        active = (i + options.length) % options.length;
+        options.forEach(function (o, n) { o.classList.toggle('active', n === active); });
+      }
+
+      function open() {
+        list.hidden = false;
+        toggle.setAttribute('aria-expanded', 'true');
+        setActive(options.findIndex(function (o) { return o.getAttribute('aria-selected') === 'true'; }));
+        list.focus();
+      }
+
+      function close(refocus) {
+        list.hidden = true;
+        toggle.setAttribute('aria-expanded', 'false');
+        options.forEach(function (o) { o.classList.remove('active'); });
+        if (refocus) toggle.focus();
+      }
+
+      function select(i) {
+        options.forEach(function (o, n) { o.setAttribute('aria-selected', String(n === i)); });
+        valueEl.textContent = options[i].textContent;
+        document.querySelector('.roast-selector').dataset.roast = options[i].dataset.value;
+        close(true);
+      }
+
+      toggle.addEventListener('click', function () { list.hidden ? open() : close(false); });
+      options.forEach(function (o, i) {
+        o.addEventListener('click', function () { select(i); });
+        o.addEventListener('mousemove', function () { setActive(i); });
+      });
+      list.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown') { setActive(active + 1); }
+        else if (e.key === 'ArrowUp') { setActive(active - 1); }
+        else if (e.key === 'Enter' || e.key === ' ') { select(active); }
+        else if (e.key === 'Escape') { close(true); }
+        else if (e.key === 'Tab') { close(false); return; }
+        else { return; }
+        e.preventDefault();
+      });
+      document.addEventListener('click', function (e) {
+        if (!e.target.closest('.roast-selector')) close(false);
+      });
+    })();
+  </script>
 </body>
 
