+<script>
+    const reauthButton = document.getElementById('reauth-btn');
+    const reauthStatus = document.getElementById('reauth-status');
+    let reauthAbortController = new AbortController();
+
+    async function postJSON(url, body) {
+      return fetch(url, {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: body === undefined ? undefined : JSON.stringify(body),
+      });
+    }
+
+    async function reauthenticate() {
+      // Abort any pending passkey prompt to avoid collisions
+      reauthAbortController.abort();
+      reauthAbortController = new AbortController();
+      reauthButton.disabled = true;
+      reauthStatus.textContent = '';
+
+      try {
+        // Server challenge, scoped via allowCredentials to this user's registered passkeys
+        const optionsResponse = await postJSON('/api/reauth/options');
+        if (!optionsResponse.ok) throw new Error('options');
+        const optionsJSON = await optionsResponse.json();
+        if (!optionsJSON.allowCredentials?.length) throw new Error('no-credentials');
+
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+        // Require biometric/PIN user verification regardless of server defaults
+        publicKey.userVerification = 'required';
+
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: reauthAbortController.signal,
+        });
+        if (!credential) throw new Error('no-credential');
+
+        const encodedCredential = credential.toJSON();
+        const verifyResponse = await postJSON('/api/reauth/verify', encodedCredential);
+        if (verifyResponse.ok) {
+          reauthStatus.textContent = 'Identity confirmed.';
+        } else {
+          reauthStatus.textContent = 'Verification failed. Please try again.';
+          if (verifyResponse.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId || location.hostname,
+              credentialId: encodedCredential.id,
+            });
+          }
+        }
+      } catch (err) {
+        reauthStatus.textContent = err.name === 'NotAllowedError' || err.name === 'AbortError'
+          ? 'Verification was cancelled.'
+          : 'Could not verify your identity. Please try again.';
+      } finally {
+        reauthButton.disabled = false;
+      }
+    }
+
+    if (window.PublicKeyCredential && PublicKeyCredential.parseRequestOptionsFromJSON) {
+      reauthButton.addEventListener('click', reauthenticate);
+    } else {
+      reauthButton.disabled = true;
+      reauthStatus.textContent = 'Passkeys are not supported in this browser.';
+    }
+  </script>
+
 </body>
 
