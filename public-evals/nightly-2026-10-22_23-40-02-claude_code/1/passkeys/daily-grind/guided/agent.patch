diff --git a/public/signin.js b/public/signin.js
new file mode 100644
index 0000000..f6fcc50
--- /dev/null
+++ b/public/signin.js
@@ -0,0 +1,85 @@
+import { api, ensureWebAuthn, getCapabilities, createPasskey, assertPasskey } from './passkeys.js';
+
+const $ = (id) => document.getElementById(id);
+const signinView = $('signin-view');
+const signupView = $('signup-view');
+
+function setStatus(el, message, kind = 'error') {
+  el.textContent = message || '';
+  el.dataset.kind = message ? kind : '';
+}
+
+function done() {
+  const next = new URLSearchParams(location.search).get('next');
+  // Only same-site relative paths are honoured.
+  location.href = next && /^\/(?!\/)/.test(next) ? next : '/account';
+}
+
+function show(view) {
+  signinView.hidden = view !== 'signin';
+  signupView.hidden = view !== 'signup';
+  if (view === 'signin') startConditional();
+  else autofill.abort();
+}
+$('show-signup').addEventListener('click', (e) => (e.preventDefault(), show('signup')));
+$('show-signin').addEventListener('click', (e) => (e.preventDefault(), show('signin')));
+
+let autofill = new AbortController();
+
+// Conditional UI: passkeys appear in the username field's autofill list.
+async function startConditional() {
+  const caps = await getCapabilities();
+  if (!caps.conditionalGet) return;
+  autofill = new AbortController();
+  const result = await assertPasskey({
+    optionsUrl: '/api/login/options',
+    verifyUrl: '/api/login/verify',
+    signal: autofill.signal,
+    mediation: 'conditional',
+    signalOn404: true,
+  });
+  if (result.ok) return done();
+  if (result.error) setStatus($('signin-status'), result.error);
+}
+
+$('signin-form').addEventListener('submit', async (e) => {
+  e.preventDefault();
+  const status = $('signin-status');
+  setStatus(status, '');
+  // Avoid colliding with the pending conditional request.
+  autofill.abort();
+  const result = await assertPasskey({
+    optionsUrl: '/api/login/options',
+    verifyUrl: '/api/login/verify',
+    signalOn404: true,
+  });
+  if (result.ok) return done();
+  setStatus(status, result.error);
+  startConditional();
+});
+
+$('signup-form').addEventListener('submit', async (e) => {
+  e.preventDefault();
+  const status = $('signup-status');
+  const form = new FormData(e.target);
+  setStatus(status, '');
+  const result = await createPasskey(
+    '/api/signup/options',
+    { username: form.get('username'), displayName: form.get('displayName') },
+    '/api/signup/verify',
+  );
+  if (result.ok) return done();
+  setStatus(status, result.error);
+});
+
+const supported = await ensureWebAuthn();
+const caps = supported ? await getCapabilities() : {};
+if (!supported || !(caps.passkeyPlatformAuthenticator || caps.conditionalGet || caps.hybridTransport)) {
+  $('unsupported').hidden = false;
+  $('signin-btn').disabled = true;
+  $('signup-btn').disabled = true;
+} else {
+  const { data } = await api('GET', '/api/me');
+  if (data.user) done();
+  else startConditional();
+}
