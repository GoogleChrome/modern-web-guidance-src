+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <link rel="stylesheet" href="/style.css">
+</head>
+
+<body>
+  <nav>
+    <a href="/" class="logo" style="text-decoration:none">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account" id="nav-account">My Account</a></li>
+      <li><a href="/signin" class="logout-link" id="nav-auth">Sign in</a></li>
+    </ul>
+  </nav>
+
+  <main class="container">
+    <section class="panel" aria-labelledby="profile-h">
+      <h1 id="profile-h">My Account</h1>
+      <form id="profile-form">
+        <label class="field">
+          <span>Username</span>
+          <input type="text" name="name" required maxlength="40" pattern="[\w.@+\-]+" autocomplete="username">
+        </label>
+        <label class="field">
+          <span>Display name</span>
+          <input type="text" name="displayName" required maxlength="60" autocomplete="name">
+        </label>
+        <button type="submit" class="btn">Save profile</button>
+      </form>
+      <p class="status" id="profile-status" role="status"></p>
+    </section>
+
+    <section class="panel" aria-labelledby="passkeys-h">
+      <h2 id="passkeys-h">Passkeys</h2>
+      <p class="muted">Passkeys let you sign in with your fingerprint, face, or screen lock instead of a password.</p>
+      <ul class="passkey-list" id="passkey-list"></ul>
+      <p id="passkey-empty" class="muted" hidden>No passkeys found.</p>
+      <div class="row-actions">
+        <button type="button" class="btn" id="add-passkey">Create passkey</button>
+      </div>
+      <p class="muted" id="no-passkey-support" hidden>
+        This device can't create passkeys. You can still manage the ones you've already registered.
+      </p>
+      <p class="status" id="passkey-status" role="status"></p>
+    </section>
+
+    <section class="panel" aria-labelledby="danger-h">
+      <h2 id="danger-h">Danger zone</h2>
+      <p class="muted">Deleting your account removes all passkeys. You'll be asked to verify with a passkey first.</p>
+      <button type="button" class="btn danger" id="delete-account">Delete account</button>
+    </section>
+  </main>
+
+  <dialog id="reauth-dialog" aria-labelledby="reauth-h">
+    <h2 id="reauth-h">Verify it's you</h2>
+    <p>Confirm with one of your passkeys to continue with this change.</p>
+    <p class="status" id="reauth-status" role="status"></p>
+    <div class="row-actions">
+      <button type="button" class="btn secondary" id="reauth-cancel">Cancel</button>
+      <button type="button" class="btn" id="reauth-go">Verify with passkey</button>
+    </div>
+  </dialog>
+
+  <dialog id="rename-dialog" aria-labelledby="rename-h">
+    <form method="dialog" id="rename-form">
+      <h2 id="rename-h">Rename passkey</h2>
+      <label class="field">
+        <span>Name</span>
+        <input type="text" name="name" required maxlength="60">
+      </label>
+      <div class="row-actions">
+        <button type="button" class="btn secondary" id="rename-cancel">Cancel</button>
+        <button type="submit" class="btn">Save</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script type="module" src="/nav.js"></script>
+  <script type="module" src="/account.js"></script>
+</body>
+
+</html>
diff --git a/public/account.js b/public/account.js
new file mode 100644
index 0000000..3babd04
--- /dev/null
+++ b/public/account.js
@@ -0,0 +1,205 @@
+import {
+  api,
+  getCapabilities,
+  createPasskey,
+  assertPasskey,
+  signalAccepted,
+  signalUserDetails,
+} from './passkeys.js';
+
+const $ = (id) => document.getElementById(id);
+const dateFmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+
+let user;
+
+function setStatus(el, message, kind = 'error') {
+  el.textContent = message || '';
+  el.dataset.kind = message ? kind : '';
+}
+
+/* ---------- Reauthentication ---------- */
+
+const reauthDialog = $('reauth-dialog');
+
+function askReauth() {
+  return new Promise((resolve) => {
+    const status = $('reauth-status');
+    setStatus(status, '');
+    const cleanup = (value) => {
+      $('reauth-go').onclick = $('reauth-cancel').onclick = reauthDialog.onclose = null;
+      resolve(value);
+    };
+    $('reauth-cancel').onclick = () => reauthDialog.close();
+    reauthDialog.onclose = () => cleanup(false);
+    $('reauth-go').onclick = async () => {
+      const result = await assertPasskey({
+        optionsUrl: '/api/reauth/options',
+        verifyUrl: '/api/reauth/verify',
+        // Signed in, so the unauthenticated-only unknown-credential signal is not sent.
+      });
+      if (result.ok) {
+        reauthDialog.onclose = null;
+        reauthDialog.close();
+        cleanup(true);
+      } else {
+        setStatus(status, result.error);
+      }
+    };
+    reauthDialog.showModal();
+  });
+}
+
+/** Run a request; if the server wants a recent passkey check, verify and retry once. */
+async function withReauth(request) {
+  let res = await request();
+  if (res.status === 403 && res.data.code === 'reauth_required') {
+    if (!(await askReauth())) return { ...res, cancelled: true };
+    res = await request();
+  }
+  return res;
+}
+
+/* ---------- Passkey list ---------- */
+
+function renderCredentials(list) {
+  const ul = $('passkey-list');
+  ul.replaceChildren();
+  $('passkey-empty').hidden = list.length > 0;
+  for (const c of list) {
+    const li = document.createElement('li');
+    li.className = 'passkey-item';
+
+    if (c.providerIcon) {
+      const img = document.createElement('img');
+      img.src = c.providerIcon;
+      img.alt = '';
+      li.append(img);
+    } else {
+      const fb = document.createElement('span');
+      fb.className = 'icon-fallback';
+      fb.setAttribute('aria-hidden', 'true');
+      fb.textContent = '🔑';
+      li.append(fb);
+    }
+
+    const info = document.createElement('div');
+    const name = document.createElement('strong');
+    name.textContent = c.name;
+    const meta = document.createElement('div');
+    meta.className = 'muted';
+    meta.textContent =
+      `Created ${dateFmt.format(c.registeredAt)} · ` +
+      (c.lastUsedAt ? `Last used ${dateFmt.format(c.lastUsedAt)}` : 'Never used');
+    info.append(name, meta);
+
+    const actions = document.createElement('div');
+    actions.className = 'actions';
+    const rename = document.createElement('button');
+    rename.type = 'button';
+    rename.className = 'btn secondary';
+    rename.textContent = 'Rename';
+    rename.setAttribute('aria-label', `Rename ${c.name}`);
+    rename.onclick = () => renamePasskey(c);
+    const del = document.createElement('button');
+    del.type = 'button';
+    del.className = 'btn danger';
+    del.textContent = 'Delete';
+    del.setAttribute('aria-label', `Delete ${c.name}`);
+    del.onclick = () => deletePasskey(c);
+    actions.append(rename, del);
+
+    li.append(info, actions);
+    ul.append(li);
+  }
+}
+
+async function loadCredentials({ sync = false } = {}) {
+  const res = await api('GET', '/api/credentials');
+  if (res.status === 401) {
+    location.href = '/signin?next=/account';
+    return;
+  }
+  user = res.data.user;
+  const form = $('profile-form');
+  form.elements.name.value = user.name;
+  form.elements.displayName.value = user.displayName;
+  renderCredentials(res.data.credentials);
+  if (sync) await signalAccepted(user.id, res.data.credentials.map((c) => c.id));
+  return res.data.credentials;
+}
+
+const renameDialog = $('rename-dialog');
+function renamePasskey(c) {
+  const form = $('rename-form');
+  form.elements.name.value = c.name;
+  $('rename-cancel').onclick = () => renameDialog.close();
+  form.onsubmit = async () => {
+    const res = await api('PUT', `/api/credential/${encodeURIComponent(c.id)}`, {
+      name: form.elements.name.value,
+    });
+    if (res.ok) {
+      setStatus($('passkey-status'), 'Passkey renamed.', 'ok');
+      await loadCredentials();
+    } else {
+      setStatus($('passkey-status'), res.data.error);
+    }
+  };
+  renameDialog.showModal();
+}
+
+async function deletePasskey(c) {
+  const status = $('passkey-status');
+  setStatus(status, '');
+  const res = await withReauth(() => api('DELETE', `/api/credential/${encodeURIComponent(c.id)}`));
+  if (res.cancelled) return;
+  if (!res.ok) return setStatus(status, res.data.error);
+  await loadCredentials({ sync: true });
+  setStatus(status, `Deleted “${c.name}”. You may also want to remove it from your passkey provider.`, 'ok');
+}
+
+$('add-passkey').addEventListener('click', async () => {
+  const status = $('passkey-status');
+  setStatus(status, '');
+  const result = await createPasskey('/api/credentials/options', {}, '/api/credentials/verify');
+  if (result.ok) {
+    setStatus(status, 'Passkey created.', 'ok');
+    await loadCredentials({ sync: true });
+  } else if (result.error) {
+    setStatus(status, result.error);
+  }
+});
+
+/* ---------- Profile ---------- */
+
+$('profile-form').addEventListener('submit', async (e) => {
+  e.preventDefault();
+  const status = $('profile-status');
+  setStatus(status, '');
+  const body = { name: e.target.elements.name.value, displayName: e.target.elements.displayName.value };
+  const res = await withReauth(() => api('PUT', '/api/user', body));
+  if (res.cancelled) return;
+  if (!res.ok) return setStatus(status, res.data.error);
+  await signalUserDetails(user.id, res.data.name, res.data.displayName);
+  user = { ...user, ...res.data };
+  setStatus(status, 'Profile saved.', 'ok');
+});
+
+$('delete-account').addEventListener('click', async () => {
+  if (!confirm('Delete your account and all passkeys? This cannot be undone.')) return;
+  const res = await withReauth(() => api('DELETE', '/api/user'));
+  if (res.cancelled) return;
+  if (!res.ok) return setStatus($('passkey-status'), res.data.error);
+  await signalAccepted(user.id, []);
+  location.href = '/';
+});
+
+/* ---------- Init ---------- */
+
+const caps = await getCapabilities();
+if (!caps.passkeyPlatformAuthenticator && !caps.hybridTransport && !caps.userVerifyingPlatformAuthenticator) {
+  // Platform passkeys unavailable: hide creation, management of existing ones still works.
+  $('add-passkey').hidden = true;
+  $('no-passkey-support').hidden = false;
+}
+// Sync the provider with the server's accepted credentials on load.
+await loadCredentials({ sync: true });
