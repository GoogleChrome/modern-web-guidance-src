--- /dev/null
+++ b/public/passkeys.js
@@ -0,0 +1,164 @@
+// Shared WebAuthn client helpers. Native browser APIs only; the server does verification.
+
+export async function api(method, url, body) {
+  const res = await fetch(url, {
+    method,
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  let data = {};
+  try {
+    data = await res.json();
+  } catch {}
+  return { ok: res.ok, status: res.status, data };
+}
+
+let ready;
+/** Load the polyfill only when JSON serialization or client capabilities are missing. */
+export function ensureWebAuthn() {
+  ready ??= (async () => {
+    if (!window.PublicKeyCredential) return false;
+    if (
+      !PublicKeyCredential.parseCreationOptionsFromJSON ||
+      !PublicKeyCredential.parseRequestOptionsFromJSON ||
+      !PublicKeyCredential.getClientCapabilities ||
+      !PublicKeyCredential.prototype.toJSON
+    ) {
+      await import('/vendor/webauthn-polyfills/index.js');
+    }
+    return true;
+  })();
+  return ready;
+}
+
+export async function getCapabilities() {
+  if (!(await ensureWebAuthn())) return {};
+  try {
+    return (await PublicKeyCredential.getClientCapabilities()) || {};
+  } catch {
+    return {};
+  }
+}
+
+let rpIdPromise;
+export function getRpId() {
+  rpIdPromise ??= api('GET', '/api/me').then((r) => r.data.rpId);
+  return rpIdPromise;
+}
+
+export async function signalUnknown(credentialId) {
+  if (!window.PublicKeyCredential?.signalUnknownCredential) return;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({ rpId: await getRpId(), credentialId });
+  } catch (e) {
+    console.warn('signalUnknownCredential failed', e);
+  }
+}
+
+export async function signalAccepted(userId, credentialIds) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: await getRpId(),
+      userId,
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials failed', e);
+  }
+}
+
+export async function signalUserDetails(userId, name, displayName) {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId: await getRpId(), userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails failed', e);
+  }
+}
+
+const MESSAGES = {
+  InvalidStateError: 'A passkey for this account already exists on that device or provider.',
+  SecurityError: 'Passkeys are unavailable here (needs HTTPS and a matching site domain).',
+};
+
+/** Returns a user-facing message, or null for silent cancellations. */
+export function describeWebAuthnError(err) {
+  if (err.name === 'NotAllowedError' || err.name === 'AbortError') return null;
+  return MESSAGES[err.name] || err.message || 'Something went wrong.';
+}
+
+/**
+ * Create a passkey. `optionsUrl` returns creation options; `verifyUrl` verifies the attestation.
+ * Resolves { ok, data?, error? }; `error` is null when the user cancelled.
+ */
+export async function createPasskey(optionsUrl, optionsBody, verifyUrl) {
+  await ensureWebAuthn();
+  const opts = await api('POST', optionsUrl, optionsBody);
+  if (!opts.ok) return { ok: false, error: opts.data.error };
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({
+      publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(opts.data),
+    });
+  } catch (err) {
+    return { ok: false, error: describeWebAuthnError(err) };
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    const res = await api('POST', verifyUrl, encoded);
+    if (!res.ok) {
+      // The provider holds a passkey the server rejected; tell it to drop the orphan.
+      await signalUnknown(encoded.id);
+      return { ok: false, error: res.data.error || 'Could not register the passkey.' };
+    }
+    return { ok: true, data: res.data };
+  } catch {
+    await signalUnknown(encoded.id);
+    return { ok: false, error: 'Network error while registering the passkey.' };
+  }
+}
+
+/**
+ * Run a passkey assertion. `mediation: 'conditional'` registers autofill without a dialog.
+ * Resolves { ok, data?, status?, error? }.
+ */
+export async function assertPasskey({ optionsUrl, verifyUrl, signal, mediation, signalOn404 = false }) {
+  await ensureWebAuthn();
+  const opts = await api('POST', optionsUrl);
+  if (!opts.ok) return { ok: false, error: opts.data.error };
+
+  let credential;
+  try {
+    credential = await navigator.credentials.get({
+      publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(opts.data),
+      signal,
+      ...(mediation && { mediation }),
+    });
+  } catch (err) {
+    return { ok: false, error: describeWebAuthnError(err) };
+  }
+
+  const encoded = credential.toJSON();
+  let res;
+  try {
+    res = await api('POST', verifyUrl, encoded);
+  } catch {
+    return { ok: false, error: 'Network error while verifying the passkey.' };
+  }
+  if (!res.ok) {
+    // Only unauthenticated flows may tell the provider the credential is unknown.
+    if (res.status === 404 && signalOn404) await signalUnknown(encoded.id);
+    return {
+      ok: false,
+      status: res.status,
+      error:
+        res.status === 404
+          ? 'That passkey is no longer registered with this account.'
+          : res.data.error || 'Verification failed.',
+    };
+  }
+  return { ok: true, data: res.data };
+}
