--- /dev/null
+++ b/server.js
@@ -0,0 +1,539 @@
+import http from 'node:http';
+import crypto from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from '@simplewebauthn/server';
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const PUBLIC_DIR = path.join(ROOT, 'public');
+const POLYFILL_DIR = path.join(ROOT, 'node_modules/webauthn-polyfills/esm');
+const DB_FILE = path.join(ROOT, 'data/db.json');
+
+const PORT = Number(process.env.PORT || 11222);
+// The RP ID is a fixed constant for the deployment, never derived from the request.
+const RP_ID = process.env.RP_ID || 'localhost';
+const RP_NAME = 'The Daily Grind';
+const ORIGIN = process.env.ORIGIN || `http://localhost:${PORT}`;
+const SECURE_COOKIE = ORIGIN.startsWith('https://');
+
+const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const SESSION_TTL_MS = 24 * 60 * 60 * 1000;
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+const AAGUID_REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+
+/* ---------- Storage (JSON file) ---------- */
+
+let db = { users: {}, credentials: {} };
+try {
+  db = JSON.parse(await fs.readFile(DB_FILE, 'utf8'));
+} catch {}
+
+let saving = Promise.resolve();
+function saveDb() {
+  saving = saving.then(async () => {
+    await fs.mkdir(path.dirname(DB_FILE), { recursive: true });
+    const tmp = `${DB_FILE}.tmp`;
+    await fs.writeFile(tmp, JSON.stringify(db, null, 2));
+    await fs.rename(tmp, DB_FILE);
+  });
+  return saving;
+}
+
+const credentialsOf = (userId) =>
+  Object.values(db.credentials).filter((c) => c.passkeyUserId === userId);
+
+const findUserByName = (name) =>
+  Object.values(db.users).find((u) => u.name.toLowerCase() === name.toLowerCase());
+
+/* ---------- AAGUID registry (UX hints only, never a security signal) ---------- */
+
+let aaguidRegistry = null;
+async function lookupProvider(aaguid) {
+  if (!aaguid || aaguid === ZERO_AAGUID) return {};
+  if (!aaguidRegistry) {
+    try {
+      const res = await fetch(AAGUID_REGISTRY_URL, { signal: AbortSignal.timeout(4000) });
+      aaguidRegistry = res.ok ? await res.json() : {};
+    } catch {
+      aaguidRegistry = null;
+      return {};
+    }
+  }
+  const entry = aaguidRegistry[aaguid];
+  return entry ? { name: entry.name, providerIcon: entry.icon_light } : {};
+}
+
+/* ---------- Sessions ---------- */
+
+const sessions = new Map();
+
+function parseCookies(req) {
+  const out = {};
+  for (const part of (req.headers.cookie || '').split(';')) {
+    const i = part.indexOf('=');
+    if (i > 0) out[part.slice(0, i).trim()] = decodeURIComponent(part.slice(i + 1).trim());
+  }
+  return out;
+}
+
+function getSession(req, res) {
+  const sid = parseCookies(req).sid;
+  let s = sid && sessions.get(sid);
+  if (s && s.expires < Date.now()) {
+    sessions.delete(sid);
+    s = null;
+  }
+  if (!s) s = createSession(res);
+  s.expires = Date.now() + SESSION_TTL_MS;
+  return s;
+}
+
+function createSession(res) {
+  const sid = crypto.randomBytes(32).toString('base64url');
+  const s = { sid, userId: null, reauthAt: 0, challenge: null, expires: Date.now() + SESSION_TTL_MS };
+  sessions.set(sid, s);
+  res.setHeader(
+    'Set-Cookie',
+    `sid=${sid}; Path=/; HttpOnly; SameSite=Lax; Max-Age=${SESSION_TTL_MS / 1000}${SECURE_COOKIE ? '; Secure' : ''}`,
+  );
+  return s;
+}
+
+/** Issue a fresh session id on privilege change to prevent fixation. */
+function signIn(req, res, userId) {
+  const old = parseCookies(req).sid;
+  if (old) sessions.delete(old);
+  const s = createSession(res);
+  s.userId = userId;
+  s.reauthAt = Date.now(); // a fresh sign-in counts as recent verification
+  return s;
+}
+
+/* ---------- HTTP helpers ---------- */
+
+class HttpError extends Error {
+  constructor(status, message, code) {
+    super(message);
+    this.status = status;
+    this.code = code;
+  }
+}
+
+function sendJson(res, status, body) {
+  res.writeHead(status, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' });
+  res.end(JSON.stringify(body));
+}
+
+async function readJson(req) {
+  if (!(req.headers['content-type'] || '').startsWith('application/json')) {
+    throw new HttpError(415, 'Expected application/json');
+  }
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > 100_000) throw new HttpError(413, 'Body too large');
+    chunks.push(chunk);
+  }
+  try {
+    return chunks.length ? JSON.parse(Buffer.concat(chunks).toString()) : {};
+  } catch {
+    throw new HttpError(400, 'Invalid JSON');
+  }
+}
+
+const publicUser = (u) => ({ id: u.id, name: u.name, displayName: u.displayName });
+
+function requireUser(s) {
+  const user = s.userId && db.users[s.userId];
+  if (!user) throw new HttpError(401, 'Not signed in');
+  return user;
+}
+
+function requireRecentReauth(s) {
+  if (Date.now() - s.reauthAt > REAUTH_WINDOW_MS) {
+    throw new HttpError(403, 'Please verify your identity with a passkey.', 'reauth_required');
+  }
+}
+
+function takeChallenge(s, purpose) {
+  const c = s.challenge;
+  s.challenge = null;
+  if (!c || c.purpose !== purpose || c.expires < Date.now()) {
+    throw new HttpError(400, 'Challenge expired. Please try again.');
+  }
+  return c;
+}
+
+function setChallenge(s, purpose, challenge, extra = {}) {
+  s.challenge = { purpose, challenge, expires: Date.now() + 5 * 60 * 1000, ...extra };
+}
+
+function validateName(name, label, max = 60) {
+  if (typeof name !== 'string' || !name.trim() || name.trim().length > max) {
+    throw new HttpError(400, `${label} must be 1–${max} characters.`);
+  }
+  return name.trim();
+}
+
+const toDescriptor = (c) => ({ id: c.id, transports: c.transports });
+
+const publicCredential = (c) => ({
+  id: c.id,
+  name: c.name,
+  providerIcon: c.providerIcon,
+  aaguid: c.aaguid,
+  credentialDeviceType: c.credentialDeviceType,
+  credentialBackedUp: c.credentialBackedUp,
+  transports: c.transports,
+  registeredAt: c.registeredAt,
+  lastUsedAt: c.lastUsedAt,
+});
+
+async function storeCredential(userId, info, response, customName) {
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = info;
+  const provider = await lookupProvider(aaguid);
+  db.credentials[credential.id] = {
+    id: credential.id,
+    passkeyUserId: userId,
+    credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    credentialType: 'public-key',
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    providerIcon: provider.providerIcon,
+    name: customName || provider.name || 'Unknown passkey provider',
+    transports: response.response?.transports || credential.transports || [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  };
+}
+
+/** Shared verification for assertions; `expectedUserId` constrains the credential owner. */
+async function verifyAssertion(s, purpose, body, expectedUserId) {
+  const c = takeChallenge(s, purpose);
+  const stored = body && typeof body.id === 'string' ? db.credentials[body.id] : null;
+  if (!stored) throw new HttpError(404, 'Credential not found.');
+  if (expectedUserId && stored.passkeyUserId !== expectedUserId) {
+    throw new HttpError(403, 'This passkey does not belong to the signed-in account.');
+  }
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: body,
+      expectedChallenge: c.challenge,
+      expectedOrigin: ORIGIN,
+      expectedRPID: RP_ID,
+      credential: {
+        id: stored.id,
+        publicKey: Buffer.from(stored.credentialPublicKey, 'base64url'),
+        counter: stored.counter,
+        transports: stored.transports,
+      },
+      // Options requested "preferred", so UV-less authenticators are acceptable.
+      requireUserVerification: false,
+    });
+  } catch (e) {
+    throw new HttpError(400, `Verification failed: ${e.message}`);
+  }
+  if (!verification.verified) throw new HttpError(400, 'Verification failed.');
+  stored.counter = verification.authenticationInfo.newCounter;
+  stored.credentialBackedUp = verification.authenticationInfo.credentialBackedUp;
+  stored.lastUsedAt = Date.now();
+  await saveDb();
+  return stored;
+}
+
+/* ---------- API routes ---------- */
+
+const routes = {
+  'GET /api/me': async (req, res, s) => {
+    const user = s.userId && db.users[s.userId];
+    return {
+      user: user ? publicUser(user) : null,
+      rpId: RP_ID,
+      reauthValid: !!user && Date.now() - s.reauthAt <= REAUTH_WINDOW_MS,
+    };
+  },
+
+  // --- Registration of a new account (passkey-only sign-up) ---
+  'POST /api/signup/options': async (req, res, s) => {
+    const body = await readJson(req);
+    const name = validateName(body.username, 'Username', 40);
+    const displayName = validateName(body.displayName || body.username, 'Display name');
+    if (!/^[\w.@+-]+$/.test(name)) throw new HttpError(400, 'Username may only use letters, numbers and . _ @ + -');
+    if (findUserByName(name)) throw new HttpError(409, 'That username is taken.');
+    const userId = crypto.randomBytes(32);
+    const options = await generateRegistrationOptions({
+      rpName: RP_NAME,
+      rpID: RP_ID,
+      userName: name,
+      userDisplayName: displayName,
+      userID: userId,
+      attestationType: 'none',
+      authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'preferred' },
+    });
+    setChallenge(s, 'signup', options.challenge, { pending: { id: userId.toString('base64url'), name, displayName } });
+    return options;
+  },
+
+  'POST /api/signup/verify': async (req, res, s) => {
+    const body = await readJson(req);
+    const c = takeChallenge(s, 'signup');
+    if (findUserByName(c.pending.name)) throw new HttpError(409, 'That username is taken.');
+    let verification;
+    try {
+      verification = await verifyRegistrationResponse({
+        response: body,
+        expectedChallenge: c.challenge,
+        expectedOrigin: ORIGIN,
+        expectedRPID: RP_ID,
+        requireUserVerification: false,
+      });
+    } catch (e) {
+      throw new HttpError(400, `Verification failed: ${e.message}`);
+    }
+    if (!verification.verified) throw new HttpError(400, 'Verification failed.');
+    const { id, name, displayName } = c.pending;
+    db.users[id] = { id, name, displayName, createdAt: Date.now() };
+    await storeCredential(id, verification.registrationInfo, body);
+    await saveDb();
+    const ns = signIn(req, res, id);
+    return { user: publicUser(db.users[ns.userId]) };
+  },
+
+  // --- Sign-in (discoverable credentials; conditional UI or button) ---
+  'POST /api/login/options': async (req, res, s) => {
+    const options = await generateAuthenticationOptions({
+      rpID: RP_ID,
+      allowCredentials: [],
+      userVerification: 'preferred',
+    });
+    setChallenge(s, 'login', options.challenge);
+    return options;
+  },
+
+  'POST /api/login/verify': async (req, res, s) => {
+    const body = await readJson(req);
+    const stored = await verifyAssertion(s, 'login', body, null);
+    signIn(req, res, stored.passkeyUserId);
+    return { user: publicUser(db.users[stored.passkeyUserId]) };
+  },
+
+  // --- Reauthentication (constrained to the signed-in user's credentials) ---
+  'POST /api/reauth/options': async (req, res, s) => {
+    const user = requireUser(s);
+    const options = await generateAuthenticationOptions({
+      rpID: RP_ID,
+      allowCredentials: credentialsOf(user.id).map(toDescriptor),
+      userVerification: 'preferred',
+    });
+    setChallenge(s, 'reauth', options.challenge);
+    return options;
+  },
+
+  'POST /api/reauth/verify': async (req, res, s) => {
+    const user = requireUser(s);
+    const body = await readJson(req);
+    await verifyAssertion(s, 'reauth', body, user.id);
+    s.reauthAt = Date.now();
+    return { ok: true };
+  },
+
+  // --- Management ---
+  'GET /api/credentials': async (req, res, s) => {
+    const user = requireUser(s);
+    const list = credentialsOf(user.id)
+      .sort((a, b) => a.registeredAt - b.registeredAt)
+      .map(publicCredential);
+    return { user: publicUser(user), credentials: list };
+  },
+
+  'POST /api/credentials/options': async (req, res, s) => {
+    const user = requireUser(s);
+    const body = await readJson(req);
+    const options = await generateRegistrationOptions({
+      rpName: RP_NAME,
+      rpID: RP_ID,
+      userName: user.name,
+      userDisplayName: user.displayName,
+      userID: Buffer.from(user.id, 'base64url'),
+      attestationType: 'none',
+      excludeCredentials: credentialsOf(user.id).map(toDescriptor),
+      authenticatorSelection: {
+        residentKey: 'required',
+        requireResidentKey: true,
+        userVerification: 'preferred',
+        // Promotion flows target the platform authenticator; the settings page allows security keys too.
+        ...(body.promotion && { authenticatorAttachment: 'platform' }),
+      },
+    });
+    setChallenge(s, 'add', options.challenge);
+    return options;
+  },
+
+  'POST /api/credentials/verify': async (req, res, s) => {
+    const user = requireUser(s);
+    const body = await readJson(req);
+    const c = takeChallenge(s, 'add');
+    let verification;
+    try {
+      verification = await verifyRegistrationResponse({
+        response: body,
+        expectedChallenge: c.challenge,
+        expectedOrigin: ORIGIN,
+        expectedRPID: RP_ID,
+        requireUserVerification: false,
+      });
+    } catch (e) {
+      throw new HttpError(400, `Verification failed: ${e.message}`);
+    }
+    if (!verification.verified) throw new HttpError(400, 'Verification failed.');
+    if (db.credentials[verification.registrationInfo.credential.id]) {
+      throw new HttpError(409, 'This passkey is already registered.');
+    }
+    await storeCredential(user.id, verification.registrationInfo, body);
+    await saveDb();
+    return { credential: publicCredential(db.credentials[verification.registrationInfo.credential.id]) };
+  },
+
+  'PUT /api/credential/:id': async (req, res, s, params) => {
+    const user = requireUser(s);
+    const body = await readJson(req);
+    const cred = db.credentials[params.id];
+    if (!cred || cred.passkeyUserId !== user.id) throw new HttpError(404, 'Credential not found.');
+    cred.name = validateName(body.name, 'Passkey name');
+    await saveDb();
+    return publicCredential(cred);
+  },
+
+  'DELETE /api/credential/:id': async (req, res, s, params) => {
+    const user = requireUser(s);
+    requireRecentReauth(s);
+    const cred = db.credentials[params.id];
+    if (!cred || cred.passkeyUserId !== user.id) throw new HttpError(404, 'Credential not found.');
+    if (credentialsOf(user.id).length <= 1) {
+      throw new HttpError(409, 'You cannot delete your only passkey — it is the only way to sign in.');
+    }
+    delete db.credentials[params.id];
+    await saveDb();
+    return { success: true };
+  },
+
+  'PUT /api/user': async (req, res, s) => {
+    const user = requireUser(s);
+    requireRecentReauth(s);
+    const body = await readJson(req);
+    const name = validateName(body.name, 'Username', 40);
+    const displayName = validateName(body.displayName, 'Display name');
+    if (!/^[\w.@+-]+$/.test(name)) throw new HttpError(400, 'Username may only use letters, numbers and . _ @ + -');
+    const existing = findUserByName(name);
+    if (existing && existing.id !== user.id) throw new HttpError(409, 'That username is taken.');
+    user.name = name;
+    user.displayName = displayName;
+    await saveDb();
+    return publicUser(user);
+  },
+
+  'DELETE /api/user': async (req, res, s) => {
+    const user = requireUser(s);
+    requireRecentReauth(s);
+    const deletedCredentialIds = credentialsOf(user.id).map((c) => c.id);
+    for (const id of deletedCredentialIds) delete db.credentials[id];
+    delete db.users[user.id];
+    await saveDb();
+    sessions.delete(s.sid);
+    return { success: true, deletedCredentialIds };
+  },
+};
+
+function matchRoute(method, pathname) {
+  for (const [key, handler] of Object.entries(routes)) {
+    const [m, pattern] = key.split(' ');
+    if (m !== method) continue;
+    const names = [];
+    const re = new RegExp(
+      '^' + pattern.replace(/:(\w+)/g, (_, n) => (names.push(n), '([^/]+)')) + '$',
+    );
+    const match = re.exec(pathname);
+    if (match) {
+      return { handler, params: Object.fromEntries(names.map((n, i) => [n, decodeURIComponent(match[i + 1])])) };
+    }
+  }
+  return null;
+}
+
+/* ---------- Static files ---------- */
+
+const MIME = {
+  '.html': 'text/html; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.json': 'application/json',
+};
+
+async function serveStatic(res, baseDir, rel) {
+  const file = path.normalize(path.join(baseDir, rel));
+  if (!file.startsWith(baseDir + path.sep)) return false;
+  try {
+    const data = await fs.readFile(file);
+    res.writeHead(200, { 'Content-Type': MIME[path.extname(file)] || 'application/octet-stream' });
+    res.end(data);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+const PAGES = { '/': 'index.html', '/signin': 'signin.html', '/account': 'account.html' };
+
+/* ---------- Server ---------- */
+
+http
+  .createServer(async (req, res) => {
+    try {
+      const url = new URL(req.url, ORIGIN);
+      const pathname = url.pathname;
+
+      if (pathname.startsWith('/api/')) {
+        const route = matchRoute(req.method, pathname);
+        if (!route) throw new HttpError(404, 'Not found');
+        const s = getSession(req, res);
+        const result = await route.handler(req, res, s, route.params);
+        return sendJson(res, 200, result);
+      }
+
+      if (req.method === 'GET' && pathname === '/logout') {
+        const sid = parseCookies(req).sid;
+        if (sid) sessions.delete(sid);
+        res.setHeader('Set-Cookie', 'sid=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0');
+        res.writeHead(302, { Location: '/' });
+        return res.end();
+      }
+
+      if (req.method === 'GET' || req.method === 'HEAD') {
+        if (pathname.startsWith('/vendor/webauthn-polyfills/')) {
+          if (await serveStatic(res, POLYFILL_DIR, pathname.slice('/vendor/webauthn-polyfills/'.length))) return;
+        } else if (PAGES[pathname]) {
+          if (await serveStatic(res, PUBLIC_DIR, PAGES[pathname])) return;
+        } else if (await serveStatic(res, PUBLIC_DIR, pathname.slice(1))) {
+          return;
+        }
+      }
+      res.writeHead(404, { 'Content-Type': 'text/plain' });
+      res.end('Not found');
+    } catch (e) {
+      if (!(e instanceof HttpError)) console.error(e);
+      const status = e instanceof HttpError ? e.status : 500;
+      sendJson(res, status, { error: status === 500 ? 'Server error' : e.message, code: e.code });
+    }
+  })
+  .listen(PORT, () => console.log(`The Daily Grind on ${ORIGIN} (RP ID: ${RP_ID})`));
