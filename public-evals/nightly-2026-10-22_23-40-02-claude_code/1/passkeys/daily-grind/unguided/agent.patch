+// Client-side passkey helpers shared by all pages.
+(function () {
+  const b64uToBuf = (s) => {
+    s = s.replace(/-/g, '+').replace(/_/g, '/');
+    const bin = atob(s + '='.repeat((4 - (s.length % 4)) % 4));
+    return Uint8Array.from(bin, (c) => c.charCodeAt(0)).buffer;
+  };
+  const bufToB64u = (buf) => {
+    let s = '';
+    for (const b of new Uint8Array(buf)) s += String.fromCharCode(b);
+    return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  };
+
+  async function api(method, url, body) {
+    const res = await fetch(url, {
+      method,
+      headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+      body: body === undefined ? undefined : JSON.stringify(body),
+      credentials: 'same-origin',
+    });
+    const data = await res.json().catch(() => ({}));
+    if (!res.ok) {
+      const err = new Error(data.error || 'Request failed');
+      err.code = data.code;
+      err.status = res.status;
+      throw err;
+    }
+    return data;
+  }
+
+  const supported = () => !!window.PublicKeyCredential;
+
+  function friendly(e) {
+    if (e && (e.name === 'NotAllowedError' || e.name === 'AbortError')) return 'Passkey request was cancelled or timed out.';
+    if (e && e.name === 'InvalidStateError') return 'This passkey is already registered on this device.';
+    return (e && e.message) || 'Something went wrong';
+  }
+
+  const decodeCreation = (pk) => ({
+    ...pk,
+    challenge: b64uToBuf(pk.challenge),
+    user: { ...pk.user, id: b64uToBuf(pk.user.id) },
+    excludeCredentials: (pk.excludeCredentials || []).map((c) => ({ ...c, id: b64uToBuf(c.id) })),
+  });
+  const decodeRequest = (pk) => ({
+    ...pk,
+    challenge: b64uToBuf(pk.challenge),
+    allowCredentials: (pk.allowCredentials || []).map((c) => ({ ...c, id: b64uToBuf(c.id) })),
+  });
+
+  function encodeAttestation(cred) {
+    return {
+      id: cred.id,
+      transports: cred.response.getTransports ? cred.response.getTransports() : [],
+      clientDataJSON: bufToB64u(cred.response.clientDataJSON),
+      attestationObject: bufToB64u(cred.response.attestationObject),
+    };
+  }
+  function encodeAssertion(cred) {
+    return {
+      id: cred.id,
+      clientDataJSON: bufToB64u(cred.response.clientDataJSON),
+      authenticatorData: bufToB64u(cred.response.authenticatorData),
+      signature: bufToB64u(cred.response.signature),
+      userHandle: cred.response.userHandle ? bufToB64u(cred.response.userHandle) : null,
+    };
+  }
+
+  async function register(username, displayName, name) {
+    const opts = await api('POST', '/api/register/options', { username, displayName });
+    const cred = await navigator.credentials.create({ publicKey: decodeCreation(opts.publicKey) });
+    return api('POST', '/api/register/verify', { challengeId: opts.challengeId, credential: encodeAttestation(cred), name });
+  }
+
+  // opts.conditional: use browser autofill UI (pass an AbortSignal to cancel)
+  async function login({ conditional = false, signal } = {}) {
+    const opts = await api('POST', '/api/login/options', {});
+    const cred = await navigator.credentials.get({
+      publicKey: decodeRequest(opts.publicKey),
+      mediation: conditional ? 'conditional' : undefined,
+      signal,
+    });
+    return api('POST', '/api/login/verify', { challengeId: opts.challengeId, credential: encodeAssertion(cred) });
+  }
+
+  async function reauth() {
+    const opts = await api('POST', '/api/reauth/options', {});
+    const cred = await navigator.credentials.get({ publicKey: decodeRequest(opts.publicKey) });
+    return api('POST', '/api/reauth/verify', { challengeId: opts.challengeId, credential: encodeAssertion(cred) });
+  }
+
+  async function addPasskey(name) {
+    const opts = await api('POST', '/api/passkeys/options', {});
+    const cred = await navigator.credentials.create({ publicKey: decodeCreation(opts.publicKey) });
+    return api('POST', '/api/passkeys/verify', { challengeId: opts.challengeId, credential: encodeAttestation(cred), name });
+  }
+
+  // Run a sensitive action; if the server asks for a fresh passkey check, reauthenticate and retry once.
+  async function withReauth(fn) {
+    try {
+      return await fn();
+    } catch (e) {
+      if (e.code !== 'reauth_required') throw e;
+      await reauth();
+      return fn();
+    }
+  }
+
+  window.Passkeys = {
+    api, supported, friendly, register, login, reauth, withReauth,
+    addPasskey: (name) => withReauth(() => addPasskey(name)),
+    list: () => api('GET', '/api/passkeys'),
+    rename: (id, name) => api('PATCH', '/api/passkeys/' + encodeURIComponent(id), { name }),
+    remove: (id) => withReauth(() => api('DELETE', '/api/passkeys/' + encodeURIComponent(id))),
+    conditionalSupported: async () =>
+      !!(window.PublicKeyCredential && PublicKeyCredential.isConditionalMediationAvailable &&
+        (await PublicKeyCredential.isConditionalMediationAvailable())),
+  };
+
+  // Nav: show Sign in / Logout depending on session
+  document.addEventListener('DOMContentLoaded', async () => {
+    const slot = document.getElementById('auth-link');
+    if (!slot) return;
+    try {
+      const { user } = await api('GET', '/api/me');
+      if (!user) { slot.href = '/login'; slot.textContent = 'Sign in'; }
+    } catch { /* leave default */ }
+  });
+})();
