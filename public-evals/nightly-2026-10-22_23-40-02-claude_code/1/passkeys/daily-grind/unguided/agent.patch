+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <style>
+    :root { --primary: #4e342e; --secondary: #d7ccc8; --accent: #ffab40; --text: #3e2723; --light: #fafafa; }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: var(--text); background: var(--light); }
+    nav { background: var(--primary); color: white; padding: 1rem 5%; display: flex; justify-content: space-between; align-items: center; }
+    nav a { color: white; text-decoration: none; }
+    .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+    .logout-link { border: 1px solid var(--accent); padding: 5px 12px; border-radius: 4px; font-size: .9rem; }
+    main { max-width: 700px; margin: 40px auto; padding: 0 20px; }
+    .card { background: white; padding: 28px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0, 0, 0, .1); margin-bottom: 20px; }
+    h1 { color: var(--primary); margin-bottom: 4px; }
+    h2 { color: var(--primary); font-size: 1.2rem; margin-bottom: 8px; }
+    .hint { font-size: .9rem; margin-bottom: 14px; }
+    ul { list-style: none; }
+    li.pk { display: flex; align-items: center; gap: 10px; padding: 12px 0; border-top: 1px solid var(--secondary); flex-wrap: wrap; }
+    li.pk .info { flex: 1; min-width: 180px; }
+    li.pk small { display: block; color: #6d4c41; }
+    button { background: var(--primary); color: white; border: 0; padding: 8px 14px; border-radius: 5px; font-size: .9rem; cursor: pointer; }
+    button.secondary { background: white; color: var(--primary); border: 1px solid var(--primary); }
+    button.danger { background: white; color: #b71c1c; border: 1px solid #b71c1c; }
+    button:disabled { opacity: .6; cursor: default; }
+    input { padding: 8px; border: 1px solid var(--secondary); border-radius: 5px; font-size: .95rem; }
+    #msg { font-size: .9rem; min-height: 1.2em; margin-top: 8px; }
+    #msg.err { color: #b71c1c; }
+    #msg.ok { color: #2e7d32; }
+  </style>
+</head>
+
+<body>
+  <nav>
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <a href="/logout" class="logout-link">Logout</a>
+  </nav>
+  <main>
+    <section class="card">
+      <h1 id="hello">My Account</h1>
+      <p class="hint" id="who"></p>
+    </section>
+
+    <section class="card">
+      <h2>Passkeys</h2>
+      <p class="hint">Passkeys let you sign in with your fingerprint, face, or device PIN. Adding or removing one asks you to confirm with an existing passkey.</p>
+      <ul id="list"></ul>
+      <div style="display:flex; gap:8px; margin-top:16px; flex-wrap:wrap;">
+        <input id="new-name" placeholder="Name (e.g. Work laptop)" maxlength="60" aria-label="New passkey name">
+        <button id="add">Add a passkey</button>
+        <button id="verify" class="secondary">Confirm it's me</button>
+      </div>
+      <div id="msg" role="status"></div>
+    </section>
+  </main>
+
+  <script src="/passkeys.js"></script>
+  <script>
+    const $ = (id) => document.getElementById(id);
+    const show = (t, kind) => { $('msg').textContent = t || ''; $('msg').className = kind || ''; };
+    const fmt = (t) => (t ? new Date(t).toLocaleString() : 'never');
+
+    async function run(fn, okText) {
+      show();
+      try { const r = await fn(); if (okText) show(okText, 'ok'); return r; }
+      catch (e) {
+        if (e.code === 'unauthenticated') return (location.href = '/login');
+        show(Passkeys.friendly(e), 'err');
+      }
+    }
+
+    async function render() {
+      const me = await Passkeys.api('GET', '/api/me');
+      if (!me.user) return (location.href = '/login');
+      $('hello').textContent = `Hello, ${me.user.displayName}`;
+      $('who').textContent = `Signed in as ${me.user.username}`;
+      const { passkeys } = await Passkeys.list();
+      const ul = $('list');
+      ul.replaceChildren();
+      for (const p of passkeys) {
+        const li = document.createElement('li');
+        li.className = 'pk';
+        const info = document.createElement('div');
+        info.className = 'info';
+        const name = document.createElement('strong');
+        name.textContent = p.name;
+        const meta = document.createElement('small');
+        meta.textContent = `Added ${fmt(p.createdAt)} · Last used ${fmt(p.lastUsedAt)}`;
+        info.append(name, meta);
+
+        const rename = document.createElement('button');
+        rename.className = 'secondary';
+        rename.textContent = 'Rename';
+        rename.onclick = async () => {
+          const n = prompt('Passkey name', p.name);
+          if (n && n.trim()) { await run(() => Passkeys.rename(p.id, n)); render(); }
+        };
+        const del = document.createElement('button');
+        del.className = 'danger';
+        del.textContent = 'Remove';
+        del.disabled = passkeys.length === 1;
+        del.title = del.disabled ? 'Add another passkey before removing this one' : '';
+        del.onclick = async () => {
+          if (!confirm(`Remove passkey "${p.name}"?`)) return;
+          if (await run(() => Passkeys.remove(p.id), 'Passkey removed.')) render();
+        };
+        li.append(info, rename, del);
+        ul.append(li);
+      }
+    }
+
+    $('add').onclick = async () => {
+      if (await run(() => Passkeys.addPasskey($('new-name').value.trim()), 'Passkey added.')) { $('new-name').value = ''; render(); }
+    };
+    $('verify').onclick = () => run(() => Passkeys.reauth(), 'Verified — sensitive actions are unlocked for 5 minutes.');
+
+    render().catch(() => (location.href = '/login'));
+  </script>
+</body>
+
+</html>
