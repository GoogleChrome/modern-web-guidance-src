+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Sign in | The Daily Grind</title>
+  <style>
+    :root { --primary: #4e342e; --secondary: #d7ccc8; --accent: #ffab40; --text: #3e2723; --light: #fafafa; }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: var(--text); background: var(--light); }
+    nav { background: var(--primary); color: white; padding: 1rem 5%; }
+    nav a { color: white; text-decoration: none; font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+    main { max-width: 440px; margin: 40px auto; padding: 0 20px; }
+    .card { background: white; padding: 28px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0, 0, 0, .1); margin-bottom: 20px; }
+    h1 { font-size: 1.5rem; margin-bottom: 8px; color: var(--primary); }
+    h2 { font-size: 1.15rem; margin-bottom: 8px; color: var(--primary); }
+    p.hint { font-size: .9rem; margin-bottom: 14px; }
+    label { display: block; font-size: .85rem; margin: 10px 0 4px; }
+    input { width: 100%; padding: 10px; border: 1px solid var(--secondary); border-radius: 5px; font-size: 1rem; }
+    button { width: 100%; margin-top: 16px; background: var(--primary); color: white; border: 0; padding: 11px; border-radius: 5px; font-size: 1rem; cursor: pointer; }
+    button:hover { background: #3e2723; }
+    button:disabled { opacity: .6; cursor: default; }
+    button.secondary { background: white; color: var(--primary); border: 1px solid var(--primary); }
+    #msg { color: #b71c1c; font-size: .9rem; margin-top: 12px; min-height: 1.2em; }
+  </style>
+</head>
+
+<body>
+  <nav><a href="/">THE DAILY GRIND</a></nav>
+  <main>
+    <div id="unsupported" class="card" hidden>Your browser doesn't support passkeys. Please try a recent browser.</div>
+
+    <section class="card">
+      <h1>Sign in</h1>
+      <p class="hint">Use a passkey saved on this device or your password manager.</p>
+      <label for="username" hidden>Username</label>
+      <input id="username" name="username" autocomplete="username webauthn" placeholder="Choose a saved passkey from autofill" hidden>
+      <button id="login">Sign in with a passkey</button>
+    </section>
+
+    <section class="card">
+      <h2>New here?</h2>
+      <p class="hint">Create an account with a passkey — no password needed.</p>
+      <form id="register">
+        <label for="reg-username">Username</label>
+        <input id="reg-username" required minlength="3" maxlength="32" pattern="[A-Za-z0-9._\-]+" autocomplete="off">
+        <label for="reg-display">Display name (optional)</label>
+        <input id="reg-display" maxlength="60" autocomplete="name">
+        <button type="submit" class="secondary">Create account with a passkey</button>
+      </form>
+    </section>
+    <div id="msg" role="alert"></div>
+  </main>
+
+  <script src="/passkeys.js"></script>
+  <script>
+    const $ = (id) => document.getElementById(id);
+    const msg = (t) => { $('msg').textContent = t || ''; };
+    const done = () => { location.href = '/account'; };
+    let conditionalAbort;
+
+    if (!Passkeys.supported()) { $('unsupported').hidden = false; document.querySelectorAll('button').forEach((b) => (b.disabled = true)); }
+
+    async function startConditional() {
+      if (!(await Passkeys.conditionalSupported())) return;
+      $('username').hidden = false; // autofill hook for passkey suggestions
+      conditionalAbort = new AbortController();
+      try { await Passkeys.login({ conditional: true, signal: conditionalAbort.signal }); done(); }
+      catch (e) { if (e.name !== 'AbortError') msg(Passkeys.friendly(e)); }
+    }
+
+    $('login').addEventListener('click', async () => {
+      msg();
+      if (conditionalAbort) conditionalAbort.abort();
+      $('login').disabled = true;
+      try { await Passkeys.login(); done(); }
+      catch (e) { msg(Passkeys.friendly(e)); $('login').disabled = false; startConditional(); }
+    });
+
+    $('register').addEventListener('submit', async (ev) => {
+      ev.preventDefault();
+      msg();
+      if (conditionalAbort) conditionalAbort.abort();
+      try { await Passkeys.register($('reg-username').value.trim(), $('reg-display').value.trim(), 'First passkey'); done(); }
+      catch (e) { msg(Passkeys.friendly(e)); startConditional(); }
+    });
+
+    Passkeys.api('GET', '/api/me').then((r) => { if (r.user) done(); else if (Passkeys.supported()) startConditional(); });
+  </script>
+</body>
+
+</html>
