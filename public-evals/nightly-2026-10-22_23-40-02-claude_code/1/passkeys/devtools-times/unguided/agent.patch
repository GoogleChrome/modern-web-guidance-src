+import type { APIRoute } from 'astro';
+import { getUser, json, LOGIN_URL, refreshAuth } from '../../../lib/passkeys';
+
+// Password reauthentication. (Passkey reauthentication goes through /api/passkeys/auth-*.)
+export const POST: APIRoute = async ({ request, session }) => {
+  const user = await getUser(session);
+  if (!session || !user) return json({ error: 'Not signed in' }, 401);
+  const { password } = await request.json().catch(() => ({}));
+  if (typeof password !== 'string' || !password) return json({ error: 'Password is required' }, 400);
+  const res = await fetch(LOGIN_URL, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username: user.username, password }),
+  }).catch(() => null);
+  if (!res) return json({ error: 'Authentication service unavailable' }, 502);
+  if (!res.ok) return json({ error: 'Incorrect password' }, 401);
+  await refreshAuth(session, user, 'password');
+  return json({ ok: true });
+};
