@@ -0,0 +1,49 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { b64u, getRp, getUser, json, refreshAuth, signInSession, takeChallenge, withStore } from '../../../lib/passkeys';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return json({ error: 'Sessions unavailable' }, 500);
+  const expectedChallenge = await takeChallenge(session, 'authenticate');
+  if (!expectedChallenge) return json({ error: 'Authentication expired. Please try again.' }, 400);
+
+  const { response } = await request.json().catch(() => ({}));
+  const current = await getUser(session);
+  const { rpID, origin } = getRp(request);
+  const fail = () => json({ error: 'Passkey authentication failed' }, 401);
+
+  const passkey = await withStore((s) => s.passkeys.find((p) => p.id === response?.id));
+  if (!passkey) return fail();
+  // When reauthenticating, the passkey must belong to the signed-in user.
+  if (current && passkey.username !== current.username) return fail();
+
+  try {
+    const verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      credential: {
+        id: passkey.id,
+        publicKey: b64u.decode(passkey.publicKey),
+        counter: passkey.counter,
+        transports: passkey.transports as any,
+      },
+    });
+    if (!verification.verified) return fail();
+
+    await withStore((s) => {
+      const p = s.passkeys.find((x) => x.id === passkey.id);
+      if (p) {
+        p.counter = verification.authenticationInfo.newCounter;
+        p.lastUsedAt = new Date().toISOString();
+      }
+    }, true);
+
+    if (current) await refreshAuth(session, current, 'passkey');
+    else await signInSession(session, passkey.username, 'passkey');
+    return json({ username: passkey.username });
+  } catch {
+    return fail();
+  }
+};
diff --git a/src/pages/api/passkeys/index.ts b/src/pages/api/passkeys/index.ts
