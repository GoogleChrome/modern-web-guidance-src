@@ -0,0 +1,34 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import {
+  b64u, getRp, getUser, isRecentlyAuthenticated, json, RP_NAME, setChallenge, withStore,
+} from '../../../lib/passkeys';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const user = await getUser(session);
+  if (!session || !user) return json({ error: 'Not signed in' }, 401);
+  if (!isRecentlyAuthenticated(user)) return json({ error: 'Reauthentication required', code: 'REAUTH_REQUIRED' }, 403);
+
+  const { rpID } = getRp(request);
+  const { handle, existing } = await withStore(async (s) => {
+    let u = s.users[user.username];
+    let created = false;
+    if (!u) {
+      u = s.users[user.username] = { userHandle: b64u.encode(crypto.getRandomValues(new Uint8Array(32))) };
+      created = true;
+    }
+    return { handle: u.userHandle, existing: s.passkeys.filter((p) => p.username === user.username), created };
+  }, true);
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userName: user.username,
+    userID: b64u.decode(handle),
+    attestationType: 'none',
+    excludeCredentials: existing.map((p) => ({ id: p.id, transports: p.transports as any })),
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+  });
+  setChallenge(session, 'register', options.challenge);
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/register-verify.ts b/src/pages/api/passkeys/register-verify.ts
new file mode 100644
index 0000000..1e3c29b
--- /dev/null
+++ b/src/pages/api/passkeys/register-verify.ts
@@ -0,0 +1,50 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import {
+  b64u, getRp, getUser, isRecentlyAuthenticated, json, publicPasskey, takeChallenge, withStore,
+} from '../../../lib/passkeys';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const user = await getUser(session);
+  if (!session || !user) return json({ error: 'Not signed in' }, 401);
+  if (!isRecentlyAuthenticated(user)) return json({ error: 'Reauthentication required', code: 'REAUTH_REQUIRED' }, 403);
+
+  const expectedChallenge = await takeChallenge(session, 'register');
+  if (!expectedChallenge) return json({ error: 'Registration expired. Please try again.' }, 400);
+
+  const { response, name } = await request.json().catch(() => ({}));
+  const { rpID, origin } = getRp(request);
+  try {
+    const verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: false,
+    });
+    if (!verification.verified) return json({ error: 'Could not verify passkey' }, 400);
+    const { credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+
+    const saved = await withStore((s) => {
+      if (s.passkeys.some((p) => p.id === credential.id)) return null;
+      const count = s.passkeys.filter((p) => p.username === user.username).length;
+      const passkey = {
+        id: credential.id,
+        publicKey: b64u.encode(credential.publicKey),
+        counter: credential.counter,
+        transports: credential.transports,
+        username: user.username,
+        name: typeof name === 'string' && name.trim() ? name.trim().slice(0, 60) : `Passkey ${count + 1}`,
+        deviceType: credentialDeviceType,
+        backedUp: credentialBackedUp,
+        createdAt: new Date().toISOString(),
+      };
+      s.passkeys.push(passkey);
+      return passkey;
+    }, true);
+    if (!saved) return json({ error: 'This passkey is already registered' }, 409);
+    return json({ passkey: publicPasskey(saved) });
+  } catch (e) {
+    return json({ error: 'Could not verify passkey' }, 400);
+  }
+};
