--- /dev/null
+++ b/src/components/AuthNav.tsx
@@ -0,0 +1,49 @@
+import React, { useEffect, useState } from 'react';
+import { api, pageUrl, post } from '../lib/passkeyClient';
+
+const skip = { 'data-skip-tracking': 'true' } as const;
+
+export default function AuthNav() {
+  const [username, setUsername] = useState<string | null | undefined>(undefined);
+
+  useEffect(() => {
+    fetch(api('auth/me'))
+      .then((r) => r.json())
+      .then((d) => setUsername(d.user?.username ?? null))
+      .catch(() => setUsername(null));
+  }, []);
+
+  if (username === undefined) return <div className="h-8 w-40" aria-hidden="true" />;
+
+  if (username) {
+    return (
+      <div className="flex items-center space-x-3">
+        <a href={pageUrl('account')} {...skip} className="bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded whitespace-nowrap hover:bg-gray-700">
+          {username}
+        </a>
+        <button
+          type="button"
+          {...skip}
+          onClick={async () => {
+            await post('auth/logout').catch(() => {});
+            window.location.href = pageUrl('');
+          }}
+          className="bg-gray-500 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-400"
+        >
+          Sign out
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex items-center space-x-3">
+      <a href={pageUrl('signup')} {...skip} className="bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded whitespace-nowrap hover:bg-gray-700">
+        Sign up
+      </a>
+      <a href={pageUrl('signin')} {...skip} className="bg-gray-500 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-400">
+        Sign in
+      </a>
+    </div>
+  );
+}
