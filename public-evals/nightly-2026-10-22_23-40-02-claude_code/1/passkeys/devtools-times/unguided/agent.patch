index 0000000..4ed7752
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,118 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import type { AstroSession } from 'astro';
+
+export const RP_NAME = 'The DevTools Times';
+/** How long after a sign-in/reauthentication sensitive actions are allowed. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export const LOGIN_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+export interface StoredPasskey {
+  id: string; // base64url credential ID
+  publicKey: string; // base64url COSE public key
+  counter: number;
+  transports?: string[];
+  username: string;
+  name: string;
+  deviceType: string;
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt?: string;
+}
+
+interface Store {
+  users: Record<string, { userHandle: string }>; // username -> base64url user handle
+  passkeys: StoredPasskey[];
+}
+
+const STORE_PATH = process.env.PASSKEY_STORE_PATH || path.join(process.cwd(), '.data', 'passkeys.json');
+
+// Serialize read-modify-write cycles so concurrent requests don't clobber each other.
+let queue: Promise<unknown> = Promise.resolve();
+
+async function read(): Promise<Store> {
+  try {
+    return JSON.parse(await fs.readFile(STORE_PATH, 'utf8'));
+  } catch {
+    return { users: {}, passkeys: [] };
+  }
+}
+
+export function withStore<T>(fn: (store: Store) => T | Promise<T>, write = false): Promise<T> {
+  const run = async () => {
+    const store = await read();
+    const result = await fn(store);
+    if (write) {
+      await fs.mkdir(path.dirname(STORE_PATH), { recursive: true });
+      await fs.writeFile(STORE_PATH, JSON.stringify(store, null, 2));
+    }
+    return result;
+  };
+  const next = queue.then(run, run);
+  queue = next.catch(() => {});
+  return next;
+}
+
+export const b64u = {
+  encode: (bytes: Uint8Array) => Buffer.from(bytes).toString('base64url'),
+  decode: (s: string) => new Uint8Array(Buffer.from(s, 'base64url')),
+};
+
+export function getRp(request: Request) {
+  const url = new URL(request.url);
+  return { rpID: url.hostname, origin: url.origin };
+}
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+// --- session helpers -------------------------------------------------------
+
+export interface SessionUser {
+  username: string;
+  authenticatedAt: number; // last time the user proved presence (sign-in or reauth)
+  method: 'password' | 'passkey';
+}
+
+export async function getUser(session: AstroSession | undefined): Promise<SessionUser | null> {
+  return ((await session?.get('user')) as SessionUser | undefined) ?? null;
+}
+
+/** Establish a fresh authenticated session (rotating the session ID against fixation). */
+export async function signInSession(session: AstroSession, username: string, method: SessionUser['method']) {
+  await session.regenerate();
+  session.set('user', { username, authenticatedAt: Date.now(), method } satisfies SessionUser);
+}
+
+export function isRecentlyAuthenticated(user: SessionUser) {
+  return Date.now() - user.authenticatedAt < REAUTH_WINDOW_MS;
+}
+
+export async function refreshAuth(session: AstroSession, user: SessionUser, method: SessionUser['method']) {
+  session.set('user', { ...user, authenticatedAt: Date.now(), method });
+}
+
+export type ChallengeType = 'register' | 'authenticate';
+
+export function setChallenge(session: AstroSession, type: ChallengeType, challenge: string) {
+  session.set('webauthnChallenge', { type, challenge, ts: Date.now() });
+}
+
+/** Single-use: the challenge is cleared whether or not verification later succeeds. */
+export async function takeChallenge(session: AstroSession, type: ChallengeType): Promise<string | null> {
+  const c = (await session.get('webauthnChallenge')) as { type: ChallengeType; challenge: string; ts: number } | undefined;
+  session.delete('webauthnChallenge');
+  if (!c || c.type !== type || Date.now() - c.ts > CHALLENGE_TTL_MS) return null;
+  return c.challenge;
+}
+
+export const publicPasskey = (p: StoredPasskey) => ({
+  id: p.id,
+  name: p.name,
+  deviceType: p.deviceType,
+  backedUp: p.backedUp,
+  createdAt: p.createdAt,
+  lastUsedAt: p.lastUsedAt ?? null,
+});
