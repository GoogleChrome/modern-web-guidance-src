--- /dev/null
+++ b/src/pages/api/passkeys/index.ts
@@ -0,0 +1,39 @@
+import type { APIRoute } from 'astro';
+import { getUser, isRecentlyAuthenticated, json, publicPasskey, withStore } from '../../../lib/passkeys';
+
+export const GET: APIRoute = async ({ session }) => {
+  const user = await getUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  const passkeys = await withStore((s) => s.passkeys.filter((p) => p.username === user.username).map(publicPasskey));
+  return json({ passkeys });
+};
+
+// Rename
+export const PATCH: APIRoute = async ({ request, session }) => {
+  const user = await getUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  const { id, name } = await request.json().catch(() => ({}));
+  if (typeof id !== 'string' || typeof name !== 'string' || !name.trim() || name.length > 60) {
+    return json({ error: 'Invalid name' }, 400);
+  }
+  const ok = await withStore((s) => {
+    const p = s.passkeys.find((x) => x.id === id && x.username === user.username);
+    if (p) p.name = name.trim();
+    return !!p;
+  }, true);
+  return ok ? json({ ok: true }) : json({ error: 'Passkey not found' }, 404);
+};
+
+// Delete (requires recent authentication)
+export const DELETE: APIRoute = async ({ request, session }) => {
+  const user = await getUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  if (!isRecentlyAuthenticated(user)) return json({ error: 'Reauthentication required', code: 'REAUTH_REQUIRED' }, 403);
+  const { id } = await request.json().catch(() => ({}));
+  const removed = await withStore((s) => {
+    const before = s.passkeys.length;
+    s.passkeys = s.passkeys.filter((p) => !(p.id === id && p.username === user.username));
+    return s.passkeys.length < before;
+  }, true);
+  return removed ? json({ ok: true }) : json({ error: 'Passkey not found' }, 404);
+};
