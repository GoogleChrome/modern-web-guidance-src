diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..9dbb6c4
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,199 @@
+import React, { useEffect, useState } from 'react';
+import { ApiError, api, describeError, pageUrl, passkeysSupported, post, registerPasskey } from '../lib/passkeyClient';
+import ReauthDialog from './ReauthDialog';
+import PasskeyIcon from './PasskeyIcon';
+
+interface Passkey {
+  id: string;
+  name: string;
+  deviceType: string;
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+type Pending = { type: 'add' } | { type: 'delete'; id: string };
+
+const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+
+export default function AccountSettings() {
+  const [username, setUsername] = useState<string | null>(null);
+  const [passkeys, setPasskeys] = useState<Passkey[]>([]);
+  const [ready, setReady] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [reauth, setReauth] = useState<Pending | null>(null);
+  const [editing, setEditing] = useState<{ id: string; name: string } | null>(null);
+  const supported = passkeysSupported();
+
+  const load = async () => {
+    const me = await fetch(api('auth/me')).then((r) => r.json());
+    setUsername(me.user?.username ?? null);
+    if (me.user) {
+      const d = await fetch(api('passkeys')).then((r) => r.json());
+      setPasskeys(d.passkeys ?? []);
+    }
+    setReady(true);
+  };
+
+  useEffect(() => {
+    load().catch(() => {
+      setError('Could not load your account.');
+      setReady(true);
+    });
+  }, []);
+
+  const perform = async (action: Pending) => {
+    setError(null);
+    setSuccess(null);
+    setBusy(true);
+    try {
+      if (action.type === 'add') {
+        await registerPasskey();
+        setSuccess('Passkey added.');
+      } else {
+        await post('passkeys', { id: action.id }, 'DELETE');
+        setSuccess('Passkey removed.');
+      }
+      await load();
+    } catch (e) {
+      if (e instanceof ApiError && e.code === 'REAUTH_REQUIRED') setReauth(action);
+      else {
+        const msg = describeError(e);
+        if (msg) setError(msg);
+      }
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const rename = async () => {
+    if (!editing) return;
+    try {
+      await post('passkeys', editing, 'PATCH');
+      setEditing(null);
+      await load();
+    } catch (e) {
+      setError(describeError(e));
+    }
+  };
+
+  if (!ready) return <div className="max-w-xl mx-auto mt-10 text-center text-sm text-gray-500">Loading…</div>;
+
+  if (!username) {
+    return (
+      <div className="max-w-md mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm text-center">
+        <p className="text-gray-700">Please sign in to manage your account.</p>
+        <a href={pageUrl('signin')} className="mt-4 inline-block rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
+          Sign in
+        </a>
+      </div>
+    );
+  }
+
+  return (
+    <div className="max-w-xl mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <h2 className="text-2xl font-bold text-gray-800">Account settings</h2>
+      <p className="mt-1 text-sm text-gray-600">Signed in as <strong>{username}</strong></p>
+
+      <section className="mt-8" aria-labelledby="passkeys-heading">
+        <h3 id="passkeys-heading" className="text-lg font-semibold text-gray-800">Passkeys</h3>
+        <p className="mt-1 text-sm text-gray-600">
+          Passkeys let you sign in with your fingerprint, face, or device PIN instead of a password.
+        </p>
+
+        {error && <div className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">{error}</div>}
+        {success && <div className="mt-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">{success}</div>}
+
+        {passkeys.length === 0 ? (
+          <p className="mt-4 text-sm text-gray-500">You haven’t added any passkeys yet.</p>
+        ) : (
+          <ul className="mt-4 divide-y divide-gray-200 border border-gray-200 rounded-md">
+            {passkeys.map((p) => (
+              <li key={p.id} className="flex items-center justify-between gap-3 p-3">
+                <div className="min-w-0 flex-1">
+                  {editing?.id === p.id ? (
+                    <form onSubmit={(e) => { e.preventDefault(); rename(); }} className="flex gap-2">
+                      <input
+                        aria-label="Passkey name"
+                        autoFocus
+                        maxLength={60}
+                        value={editing.name}
+                        onChange={(e) => setEditing({ id: p.id, name: e.target.value })}
+                        className="min-w-0 flex-1 px-2 py-1 text-sm border border-gray-300 rounded-md"
+                      />
+                      <button type="submit" className="text-sm font-medium text-gray-900">Save</button>
+                      <button type="button" onClick={() => setEditing(null)} className="text-sm text-gray-500">Cancel</button>
+                    </form>
+                  ) : (
+                    <>
+                      <p className="flex items-center gap-2 text-sm font-medium text-gray-800">
+                        <PasskeyIcon className="h-4 w-4 shrink-0" /> <span className="truncate">{p.name}</span>
+                      </p>
+                      <p className="text-xs text-gray-500">
+                        Added {fmt(p.createdAt)} · {p.lastUsedAt ? `Last used ${fmt(p.lastUsedAt)}` : 'Never used'}
+                        {p.backedUp ? ' · Synced' : ''}
+                      </p>
+                    </>
+                  )}
+                </div>
+                {editing?.id !== p.id && (
+                  <div className="flex shrink-0 gap-3 text-sm">
+                    <button type="button" onClick={() => setEditing({ id: p.id, name: p.name })} className="text-gray-600 hover:text-gray-900">
+                      Rename
+                    </button>
+                    <button
+                      type="button"
+                      disabled={busy}
+                      onClick={() => confirm(`Remove “${p.name}”? You won’t be able to sign in with it anymore.`) && perform({ type: 'delete', id: p.id })}
+                      className="text-red-600 hover:text-red-800"
+                    >
+                      Remove
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+
+        {supported ? (
+          <button
+            type="button"
+            disabled={busy}
+            onClick={() => perform({ type: 'add' })}
+            className="mt-4 flex items-center gap-2 rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 disabled:opacity-75"
+          >
+            <PasskeyIcon /> Add a passkey
+          </button>
+        ) : (
+          <p className="mt-4 text-sm text-gray-500">This browser doesn’t support passkeys.</p>
+        )}
+      </section>
+
+      <button
+        type="button"
+        onClick={async () => {
+          await post('auth/logout').catch(() => {});
+          window.location.href = pageUrl('');
+        }}
+        className="mt-8 text-sm text-gray-600 underline hover:text-gray-900"
+      >
+        Sign out
+      </button>
+
+      {reauth && (
+        <ReauthDialog
+          hasPasskeys={passkeys.length > 0}
+          onCancel={() => setReauth(null)}
+          onSuccess={() => {
+            const action = reauth;
+            setReauth(null);
+            perform(action);
+          }}
+        />
+      )}
+    </div>
+  );
+}
diff --git a/src/components/AuthNav.tsx b/src/components/AuthNav.tsx
new file mode 100644
