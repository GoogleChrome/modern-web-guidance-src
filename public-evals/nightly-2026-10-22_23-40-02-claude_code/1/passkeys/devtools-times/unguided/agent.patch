diff --git a/src/components/ReauthDialog.tsx b/src/components/ReauthDialog.tsx
new file mode 100644
index 0000000..c490c60
--- /dev/null
+++ b/src/components/ReauthDialog.tsx
@@ -0,0 +1,89 @@
+import React, { useState } from 'react';
+import { authenticateWithPasskey, describeError, passkeysSupported, post } from '../lib/passkeyClient';
+import PasskeyIcon from './PasskeyIcon';
+
+interface Props {
+  hasPasskeys: boolean;
+  onSuccess: () => void;
+  onCancel: () => void;
+}
+
+/** Confirms identity (password or passkey) before a sensitive action. */
+export default function ReauthDialog({ hasPasskeys, onSuccess, onCancel }: Props) {
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+
+  const run = async (fn: () => Promise<unknown>) => {
+    setError(null);
+    setLoading(true);
+    try {
+      await fn();
+      onSuccess();
+    } catch (e) {
+      setError(describeError(e));
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div
+      className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="reauth-title"
+      onKeyDown={(e) => e.key === 'Escape' && onCancel()}
+    >
+      <div className="w-full max-w-sm rounded-lg bg-white p-6 shadow-lg">
+        <h3 id="reauth-title" className="text-lg font-bold text-gray-800">Confirm it’s you</h3>
+        <p className="mt-1 text-sm text-gray-600">For your security, please verify your identity to continue.</p>
+
+        {error && (
+          <div className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">{error}</div>
+        )}
+
+        {hasPasskeys && passkeysSupported() && (
+          <button
+            type="button"
+            disabled={loading}
+            onClick={() => run(() => authenticateWithPasskey())}
+            className="mt-4 flex w-full items-center justify-center gap-2 rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 disabled:opacity-75"
+          >
+            <PasskeyIcon /> Use a passkey
+          </button>
+        )}
+
+        <form
+          className="mt-4 space-y-3"
+          onSubmit={(e) => {
+            e.preventDefault();
+            run(() => post('auth/reauth', { password }));
+          }}
+        >
+          <label htmlFor="reauth-password" className="block text-sm font-medium text-gray-700">Password</label>
+          <input
+            id="reauth-password"
+            type="password"
+            autoComplete="current-password"
+            autoFocus={!hasPasskeys}
+            required
+            value={password}
+            onChange={(e) => setPassword(e.target.value)}
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+          />
+          <button
+            type="submit"
+            disabled={loading}
+            className="w-full rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-800 hover:bg-gray-50 disabled:opacity-75"
+          >
+            Confirm with password
+          </button>
+        </form>
+        <button type="button" onClick={onCancel} className="mt-3 w-full text-sm text-gray-500 hover:text-gray-800">
+          Cancel
+        </button>
+      </div>
+    </div>
+  );
+}
