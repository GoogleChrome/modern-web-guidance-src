+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRp, getUser, json, setChallenge, withStore } from '../../../lib/passkeys';
+
+// Works signed-out (discoverable credential sign-in) and signed-in (reauthentication,
+// restricted to the current user's passkeys).
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return json({ error: 'Sessions unavailable' }, 500);
+  const user = await getUser(session);
+  const { rpID } = getRp(request);
+  const allow = user
+    ? await withStore((s) => s.passkeys.filter((p) => p.username === user.username))
+    : null;
+  if (user && !allow!.length) return json({ error: 'No passkeys registered' }, 404);
+
+  const options = await generateAuthenticationOptions({
+    rpID,
+    userVerification: 'preferred',
+    allowCredentials: allow?.map((p) => ({ id: p.id, transports: p.transports as any })),
+  });
+  setChallenge(session, 'authenticate', options.challenge);
+  return json(options);
+};
