+import type { APIRoute } from 'astro';
+import { json, LOGIN_URL, signInSession } from '../../../lib/passkeys';
+
+export const prerender = false;
+
+// Verifies the password against the Times backend, then starts a local session.
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return json({ error: 'Sessions unavailable' }, 500);
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+  const res = await fetch(LOGIN_URL, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  }).catch(() => null);
+  if (!res) return json({ error: 'Authentication service unavailable' }, 502);
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) return json({ error: data.error || 'Unknown error' }, res.status);
+  await signInSession(session, username, 'password');
+  return json({ username });
+};
