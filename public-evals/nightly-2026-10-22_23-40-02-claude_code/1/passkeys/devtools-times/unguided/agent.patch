diff --git a/src/lib/passkeyClient.ts b/src/lib/passkeyClient.ts
new file mode 100644
index 0000000..df93433
--- /dev/null
+++ b/src/lib/passkeyClient.ts
@@ -0,0 +1,47 @@
+import { startAuthentication, startRegistration, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+
+const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
+export const api = (p: string) => `${base}api/${p}`;
+export const pageUrl = (p: string) => `${base}${p}`;
+
+export class ApiError extends Error {
+  constructor(message: string, public status: number, public code?: string) {
+    super(message);
+  }
+}
+
+export async function post<T = any>(path: string, body?: unknown, method = 'POST'): Promise<T> {
+  const res = await fetch(api(path), {
+    method,
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body ?? {}),
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) throw new ApiError(data.error || 'Request failed', res.status, data.code);
+  return data;
+}
+
+export const passkeysSupported = () => typeof window !== 'undefined' && browserSupportsWebAuthn();
+
+const cancelled = (e: unknown) => e instanceof Error && (e.name === 'NotAllowedError' || e.name === 'AbortError');
+
+/** Returns a user-friendly message for a failed ceremony, or null if the user just cancelled. */
+export function describeError(e: unknown): string | null {
+  if (cancelled(e)) return null;
+  if (e instanceof ApiError) return e.message;
+  if (e instanceof Error && e.name === 'InvalidStateError') return 'This passkey is already registered on this device.';
+  return 'Something went wrong with your passkey. Please try again.';
+}
+
+export async function registerPasskey(name?: string) {
+  const optionsJSON = await post('passkeys/register-options');
+  const response = await startRegistration({ optionsJSON });
+  return post('passkeys/register-verify', { response, name });
+}
+
+/** Passkey sign-in (signed out) or reauthentication (signed in). */
+export async function authenticateWithPasskey(opts: { useBrowserAutofill?: boolean } = {}) {
+  const optionsJSON = await post('passkeys/auth-options');
+  const response = await startAuthentication({ optionsJSON, useBrowserAutofill: opts.useBrowserAutofill });
+  return post<{ username: string }>('passkeys/auth-verify', { response });
+}
