@@ -0,0 +1,59 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import {
+  describeProvider,
+  json,
+  relyingParty,
+  requireUser,
+  saveCredential,
+  type StoredPasskeyCredential,
+} from '../../../lib/passkeys';
+
+export const prerender = false;
+
+export const POST: APIRoute = async (context) => {
+  const user = await requireUser(context);
+  if (user instanceof Response) return user;
+
+  const { session, request } = context;
+  const expectedChallenge = await session?.get('registrationChallenge');
+  session?.set('registrationChallenge', undefined); // single use
+  if (!expectedChallenge) return json({ error: 'No registration in progress' }, 400);
+
+  const { response, conditional = false } = await request.json();
+  const { rpID, origin } = relyingParty(context);
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: false, // options asked for "preferred"
+      requireUserPresence: !conditional, // relaxed only for conditional create
+    });
+  } catch (err) {
+    return json({ error: (err as Error).message }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Verification failed' }, 400);
+
+  const { aaguid, credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  const provider = await describeProvider(aaguid, request.headers.get('user-agent'));
+  const stored: StoredPasskeyCredential = {
+    id: credential.id,
+    passkeyUserId: user.id,
+    credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    credentialType: 'public-key',
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    providerIcon: provider.providerIcon,
+    name: provider.name,
+    transports: response.response?.transports ?? credential.transports ?? [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  };
+  await saveCredential(stored);
+  return json({ verified: true, credential: stored });
+};
