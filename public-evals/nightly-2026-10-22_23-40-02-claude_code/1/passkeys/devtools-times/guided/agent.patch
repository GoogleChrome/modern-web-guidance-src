+import type { APIRoute } from 'astro';
+import {
+  deleteCredential,
+  isRecentlyReauthenticated,
+  json,
+  requireUser,
+  updateCredential,
+} from '../../../../lib/passkeys';
+
+export const prerender = false;
+
+export const PUT: APIRoute = async (context) => {
+  const user = await requireUser(context);
+  if (user instanceof Response) return user;
+
+  const { name } = await context.request.json();
+  if (typeof name !== 'string' || !name.trim() || name.length > 60) {
+    return json({ error: 'Enter a name up to 60 characters' }, 400);
+  }
+  const updated = await updateCredential(context.params.id!, user.id, { name: name.trim() });
+  return updated ? json({ ok: true }) : json({ error: 'Credential not found' }, 404);
+};
+
+export const DELETE: APIRoute = async (context) => {
+  const user = await requireUser(context);
+  if (user instanceof Response) return user;
+
+  // Sensitive action: require a recent reauthentication.
+  if (!(await isRecentlyReauthenticated(context))) {
+    return json({ error: 'Please confirm it’s you first', code: 'reauth_required' }, 403);
+  }
+  const removed = await deleteCredential(context.params.id!, user.id);
+  return removed ? json({ ok: true }) : json({ error: 'Credential not found' }, 404);
+};
