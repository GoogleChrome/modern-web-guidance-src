index 0000000..65c6846
--- /dev/null
+++ b/src/pages/api/passkeys/login-verify.ts
@@ -0,0 +1,52 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import {
+  findCredential,
+  getUserById,
+  json,
+  relyingParty,
+  startSession,
+  touchCredential,
+} from '../../../lib/passkeys';
+
+export const prerender = false;
+
+export const POST: APIRoute = async (context) => {
+  const { session, request } = context;
+  const pending = await session?.get('authChallenge');
+  session?.set('authChallenge', undefined); // single use
+  if (!pending) return json({ error: 'No authentication in progress' }, 400);
+
+  const response = await request.json();
+  const stored = await findCredential(response.id);
+  // 404 lets the client signal the unknown credential to the passkey provider.
+  if (!stored) return json({ error: 'Credential not found' }, 404);
+
+  const { rpID, origin } = relyingParty(context);
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: pending.userVerification === 'required',
+      credential: {
+        id: stored.id,
+        publicKey: Buffer.from(stored.credentialPublicKey, 'base64url'),
+        counter: stored.counter,
+        transports: stored.transports as any,
+      },
+    });
+  } catch (err) {
+    return json({ error: (err as Error).message }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Verification failed' }, 400);
+
+  const user = await getUserById(stored.passkeyUserId);
+  if (!user) return json({ error: 'Credential not found' }, 404);
+
+  await touchCredential(stored.id, verification.authenticationInfo.newCounter);
+  await startSession(context, user);
+  return json({ verified: true, user: { name: user.name, displayName: user.displayName } });
+};
