diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..e33f0b9
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,215 @@
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { randomBytes } from 'node:crypto';
+import path from 'node:path';
+import type { APIContext } from 'astro';
+
+export const RP_NAME = 'The DevTools Times';
+export const AUTH_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+const AAGUID_REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL credential ID
+  passkeyUserId: string;
+  credentialPublicKey: string; // Base64URL
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: string;
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+export interface PasskeyUser {
+  id: string; // Base64URL user handle
+  name: string; // username
+  displayName: string;
+}
+
+export interface SessionUser {
+  id: string;
+  name: string;
+  displayName: string;
+}
+
+interface Store {
+  users: Record<string, PasskeyUser>; // keyed by username
+  credentials: Record<string, StoredPasskeyCredential>; // keyed by credential ID
+}
+
+const STORE_PATH = path.join(process.cwd(), '.data', 'passkeys.json');
+
+// Serialize writes so concurrent requests don't clobber each other.
+let queue: Promise<unknown> = Promise.resolve();
+
+async function readStore(): Promise<Store> {
+  try {
+    return JSON.parse(await readFile(STORE_PATH, 'utf8'));
+  } catch {
+    return { users: {}, credentials: {} };
+  }
+}
+
+function mutate<T>(fn: (store: Store) => T | Promise<T>): Promise<T> {
+  const run = queue.then(async () => {
+    const store = await readStore();
+    const result = await fn(store);
+    await mkdir(path.dirname(STORE_PATH), { recursive: true });
+    const tmp = `${STORE_PATH}.${process.pid}.tmp`;
+    await writeFile(tmp, JSON.stringify(store, null, 2));
+    await rename(tmp, STORE_PATH);
+    return result;
+  });
+  queue = run.catch(() => {});
+  return run;
+}
+
+export async function getOrCreateUser(username: string): Promise<PasskeyUser> {
+  const key = username.toLowerCase();
+  return mutate((store) => {
+    store.users[key] ??= {
+      id: randomBytes(32).toString('base64url'),
+      name: username,
+      displayName: username,
+    };
+    return store.users[key];
+  });
+}
+
+export async function getUserById(id: string): Promise<PasskeyUser | undefined> {
+  const store = await readStore();
+  return Object.values(store.users).find((u) => u.id === id);
+}
+
+export async function updateUser(id: string, patch: Partial<Pick<PasskeyUser, 'displayName'>>) {
+  return mutate((store) => {
+    const user = Object.values(store.users).find((u) => u.id === id);
+    if (!user) return undefined;
+    Object.assign(user, patch);
+    return user;
+  });
+}
+
+export async function listCredentials(userId: string) {
+  const store = await readStore();
+  return Object.values(store.credentials)
+    .filter((c) => c.passkeyUserId === userId)
+    .sort((a, b) => a.registeredAt - b.registeredAt);
+}
+
+export async function findCredential(id: string) {
+  return (await readStore()).credentials[id];
+}
+
+export function saveCredential(cred: StoredPasskeyCredential) {
+  return mutate((store) => {
+    store.credentials[cred.id] = cred;
+  });
+}
+
+export function updateCredential(id: string, userId: string, patch: Partial<StoredPasskeyCredential>) {
+  return mutate((store) => {
+    const cred = store.credentials[id];
+    if (!cred || cred.passkeyUserId !== userId) return undefined;
+    Object.assign(cred, patch);
+    return cred;
+  });
+}
+
+export function deleteCredential(id: string, userId: string) {
+  return mutate((store) => {
+    const cred = store.credentials[id];
+    if (!cred || cred.passkeyUserId !== userId) return false;
+    delete store.credentials[id];
+    return true;
+  });
+}
+
+/** Persist counter + last-used after a successful assertion (counter 0 means unsupported). */
+export function touchCredential(id: string, counter: number) {
+  return mutate((store) => {
+    const cred = store.credentials[id];
+    if (!cred) return;
+    cred.counter = counter;
+    cred.lastUsedAt = Date.now();
+  });
+}
+
+// AAGUID registry: used for UX hints (name/icon) only, never for security decisions.
+let registryPromise: Promise<Record<string, { name: string; icon_light?: string }>> | undefined;
+
+function loadRegistry() {
+  registryPromise ??= fetch(AAGUID_REGISTRY_URL)
+    .then((r) => (r.ok ? r.json() : {}))
+    .catch(() => {
+      registryPromise = undefined; // retry next time
+      return {};
+    });
+  return registryPromise;
+}
+
+export async function describeProvider(aaguid: string, userAgent: string | null) {
+  if (aaguid === ZERO_AAGUID) {
+    return { name: deviceNameFromUA(userAgent), providerIcon: undefined };
+  }
+  const provider = (await loadRegistry())[aaguid];
+  return { name: provider?.name || 'Unknown passkey provider', providerIcon: provider?.icon_light };
+}
+
+function deviceNameFromUA(ua: string | null) {
+  if (!ua) return 'Unknown passkey provider';
+  const os = /iPhone|iPad/.test(ua)
+    ? 'iOS'
+    : /Android/.test(ua)
+      ? 'Android'
+      : /Windows/.test(ua)
+        ? 'Windows'
+        : /Mac OS X/.test(ua)
+          ? 'macOS'
+          : /Linux/.test(ua)
+            ? 'Linux'
+            : null;
+  return os ? `${os} device` : 'Unknown passkey provider';
+}
+
+/** RP ID / origin come from the validated request URL unless overridden by env. */
+export function relyingParty(context: APIContext) {
+  const url = context.url;
+  return {
+    rpID: import.meta.env.PASSKEY_RP_ID || url.hostname,
+    origin: import.meta.env.PASSKEY_ORIGIN || url.origin,
+  };
+}
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+export async function requireUser(context: APIContext): Promise<SessionUser | Response> {
+  const user = await context.session?.get('user');
+  return user ?? json({ error: 'Not signed in' }, 401);
+}
+
+export async function isRecentlyReauthenticated(context: APIContext) {
+  const at = await context.session?.get('reauthAt');
+  return typeof at === 'number' && Date.now() - at < REAUTH_WINDOW_MS;
+}
+
+/** Start an authenticated session after a full sign-in. */
+export async function startSession(context: APIContext, user: PasskeyUser) {
+  const session = context.session;
+  if (!session) return;
+  await session.regenerate();
+  session.set('user', { id: user.id, name: user.name, displayName: user.displayName } satisfies SessionUser);
+  session.set('reauthAt', Date.now());
+}
