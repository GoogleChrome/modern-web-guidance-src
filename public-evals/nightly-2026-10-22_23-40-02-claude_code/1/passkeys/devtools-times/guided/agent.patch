+import type { APIRoute } from 'astro';
+import { json, requireUser, updateUser } from '../../../lib/passkeys';
+
+export const prerender = false;
+
+export const PUT: APIRoute = async (context) => {
+  const user = await requireUser(context);
+  if (user instanceof Response) return user;
+
+  const { displayName } = await context.request.json();
+  if (typeof displayName !== 'string' || !displayName.trim() || displayName.length > 60) {
+    return json({ error: 'Enter a display name up to 60 characters' }, 400);
+  }
+  const updated = await updateUser(user.id, { displayName: displayName.trim() });
+  if (!updated) return json({ error: 'User not found' }, 404);
+
+  context.session?.set('user', { ...user, displayName: updated.displayName });
+  return json({ id: updated.id, name: updated.name, displayName: updated.displayName });
+};
