@@ -0,0 +1,26 @@
+import type { APIRoute } from 'astro';
+import { AUTH_API, getOrCreateUser, json, startSession } from '../../../lib/passkeys';
+
+export const prerender = false;
+
+// Password sign-up: registers upstream, then signs the new user in so a passkey can be offered.
+export const POST: APIRoute = async (context) => {
+  const { username, password } = await context.request.json();
+  if (typeof username !== 'string' || typeof password !== 'string') {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+
+  const headers = { 'Content-Type': 'application/json' };
+  const body = JSON.stringify({ username, password });
+  const registered = await fetch(`${AUTH_API}/register`, { method: 'POST', headers, body });
+  const data = await registered.json().catch(() => ({}));
+  if (!registered.ok) return json(data, registered.status);
+
+  // Sign in to confirm the credentials work; if that fails, registration still succeeded.
+  const login = await fetch(`${AUTH_API}/login`, { method: 'POST', headers, body });
+  if (!login.ok) return json({ ...data, signedIn: false });
+
+  const user = await getOrCreateUser(username);
+  await startSession(context, user);
+  return json({ ...data, signedIn: true, user: { name: user.name, displayName: user.displayName } });
+};
