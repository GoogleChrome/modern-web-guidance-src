+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { json, listCredentials, relyingParty, requireUser } from '../../../lib/passkeys';
+
+export const prerender = false;
+
+export const POST: APIRoute = async (context) => {
+  const user = await requireUser(context);
+  if (user instanceof Response) return user;
+
+  const credentials = await listCredentials(user.id);
+  if (credentials.length === 0) return json({ error: 'No passkeys registered' }, 400);
+
+  const { rpID } = relyingParty(context);
+  const options = await generateAuthenticationOptions({
+    rpID,
+    // Constrained to this user's own credentials.
+    allowCredentials: credentials.map((c) => ({ id: c.id, transports: c.transports as any })),
+    userVerification: 'preferred',
+  });
+  context.session?.set('reauthChallenge', options.challenge);
+  return json({ ...options, rpId: rpID });
+};
