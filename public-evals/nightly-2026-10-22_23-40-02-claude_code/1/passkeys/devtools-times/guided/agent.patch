@@ -0,0 +1,184 @@
+// Client-side WebAuthn helpers. Calls the native browser APIs directly; the server
+// (src/pages/api/passkeys) handles options generation and verification.
+
+const API = `${import.meta.env.BASE_URL}api`;
+
+export class ApiError extends Error {
+  constructor(
+    message: string,
+    public status: number,
+    public code?: string,
+  ) {
+    super(message);
+  }
+}
+
+export async function api<T = any>(path: string, init?: { method?: string; body?: unknown }): Promise<T> {
+  const response = await fetch(`${API}/${path}`, {
+    method: init?.method ?? (init?.body ? 'POST' : 'GET'),
+    headers: { 'Content-Type': 'application/json' },
+    body: init?.body === undefined ? undefined : JSON.stringify(init.body),
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) throw new ApiError(data.error || 'Request failed', response.status, data.code);
+  return data;
+}
+
+/** Loads polyfills for parse*OptionsFromJSON / toJSON / getClientCapabilities when missing. */
+async function ensurePolyfills() {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return;
+  if (
+    !PublicKeyCredential.parseCreationOptionsFromJSON ||
+    !PublicKeyCredential.parseRequestOptionsFromJSON ||
+    !PublicKeyCredential.getClientCapabilities
+  ) {
+    await import('webauthn-polyfills');
+  }
+}
+
+export async function getCapabilities(): Promise<Record<string, boolean>> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return {};
+  await ensurePolyfills();
+  try {
+    return (await PublicKeyCredential.getClientCapabilities()) ?? {};
+  } catch {
+    return {};
+  }
+}
+
+export type RegisterResult =
+  | { status: 'created'; credential: any }
+  | { status: 'cancelled' }
+  | { status: 'exists' };
+
+/** Registers a passkey. `promotion` limits to platform authenticators; `conditional` is silent post-login creation. */
+export async function registerPasskey(opts: { promotion?: boolean; conditional?: boolean } = {}): Promise<RegisterResult> {
+  await ensurePolyfills();
+  const optionsJSON = await api('passkeys/register-options', { body: { promotion: !!opts.promotion } });
+  const rpId: string = optionsJSON.rpId;
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+  let credential: any;
+  try {
+    credential = await navigator.credentials.create({
+      publicKey,
+      ...(opts.conditional && { mediation: 'conditional' as any }),
+    });
+  } catch (err) {
+    const name = (err as Error).name;
+    if (name === 'InvalidStateError') return { status: 'exists' };
+    if (name === 'NotAllowedError' || name === 'AbortError') return { status: 'cancelled' };
+    throw err;
+  }
+  if (!credential) return { status: 'cancelled' };
+
+  const encoded = credential.toJSON();
+  try {
+    const result = await api('passkeys/register-verify', {
+      body: { response: encoded, conditional: !!opts.conditional },
+    });
+    return { status: 'created', credential: result.credential };
+  } catch (err) {
+    // Server rejected or was unreachable: tell the passkey provider the credential is orphaned.
+    await signalUnknown(rpId, encoded.id);
+    throw err;
+  }
+}
+
+async function signalUnknown(rpId: string, credentialId: string) {
+  if (!PublicKeyCredential.signalUnknownCredential) return;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+  } catch (err) {
+    console.error('signalUnknownCredential failed:', err);
+  }
+}
+
+let autofillAbort: AbortController | undefined;
+
+export function abortConditionalSignIn() {
+  autofillAbort?.abort();
+  autofillAbort = undefined;
+}
+
+/** Runs a passkey assertion against the given options/verify endpoints. */
+async function assert(
+  optionsPath: string,
+  verifyPath: string,
+  mediation?: 'conditional',
+): Promise<any | null> {
+  await ensurePolyfills();
+  const optionsJSON = await api(optionsPath, { method: 'POST', body: {} });
+  const rpId: string = optionsJSON.rpId;
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+  const controller = new AbortController();
+  if (mediation) autofillAbort = controller;
+
+  let credential: any;
+  try {
+    credential = await navigator.credentials.get({
+      publicKey,
+      signal: controller.signal,
+      ...(mediation && { mediation }),
+    });
+  } catch (err) {
+    const name = (err as Error).name;
+    if (name === 'NotAllowedError' || name === 'AbortError') return null;
+    throw err;
+  } finally {
+    if (autofillAbort === controller) autofillAbort = undefined;
+  }
+  if (!credential) return null;
+
+  const encoded = credential.toJSON();
+  try {
+    return await api(verifyPath, { body: encoded });
+  } catch (err) {
+    // Only an explicit 404 means the server doesn't know this credential.
+    if (err instanceof ApiError && err.status === 404) await signalUnknown(rpId, encoded.id);
+    throw err;
+  }
+}
+
+/** Starts passkey autofill on the username field. Resolves with the user when signed in, or null. */
+export async function startConditionalSignIn(): Promise<any | null> {
+  const caps = await getCapabilities();
+  if (!caps.conditionalGet) return null;
+  abortConditionalSignIn();
+  return assert('passkeys/login-options', 'passkeys/login-verify', 'conditional');
+}
+
+/** Explicit "Sign in with passkey" button flow. */
+export async function signInWithPasskey(): Promise<any | null> {
+  abortConditionalSignIn(); // avoid colliding with the autofill request
+  return assert('passkeys/login-options', 'passkeys/login-verify');
+}
+
+/** Step-up verification with one of the signed-in user's own passkeys. */
+export async function reauthWithPasskey(): Promise<boolean> {
+  abortConditionalSignIn();
+  return (await assert('passkeys/reauth-options', 'passkeys/reauth-verify')) !== null;
+}
+
+export async function syncAcceptedCredentials(rpId: string, userId: string, credentialIds: string[]) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId,
+      userId,
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (err) {
+    console.error('signalAllAcceptedCredentials failed:', err);
+  }
+}
+
+export async function syncUserDetails(rpId: string, userId: string, name: string, displayName: string) {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (err) {
+    console.error('signalCurrentUserDetails failed:', err);
+  }
+}
