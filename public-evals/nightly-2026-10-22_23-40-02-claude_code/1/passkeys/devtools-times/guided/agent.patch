+import type { APIRoute } from 'astro';
+import { AUTH_API, getOrCreateUser, json, startSession } from '../../../lib/passkeys';
+
+export const prerender = false;
+
+// Password sign-in: proxies to the upstream auth API, then starts a local session.
+export const POST: APIRoute = async (context) => {
+  const { username, password } = await context.request.json();
+  if (typeof username !== 'string' || typeof password !== 'string') {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+
+  const upstream = await fetch(`${AUTH_API}/login`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) return json(data, upstream.status);
+
+  const user = await getOrCreateUser(username);
+  await startSession(context, user);
+  return json({ ...data, user: { name: user.name, displayName: user.displayName } });
+};
