+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { findCredential, json, relyingParty, requireUser, touchCredential } from '../../../lib/passkeys';
+
+export const prerender = false;
+
+export const POST: APIRoute = async (context) => {
+  const user = await requireUser(context);
+  if (user instanceof Response) return user;
+
+  const { session, request } = context;
+  const expectedChallenge = await session?.get('reauthChallenge');
+  session?.set('reauthChallenge', undefined);
+  if (!expectedChallenge) return json({ error: 'No reauthentication in progress' }, 400);
+
+  const response = await request.json();
+  const stored = await findCredential(response.id);
+  // Credential must exist and belong to the signed-in user.
+  if (!stored || stored.passkeyUserId !== user.id) return json({ error: 'Credential not found' }, 404);
+
+  const { rpID, origin } = relyingParty(context);
+  try {
+    const verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: false,
+      credential: {
+        id: stored.id,
+        publicKey: Buffer.from(stored.credentialPublicKey, 'base64url'),
+        counter: stored.counter,
+        transports: stored.transports as any,
+      },
+    });
+    if (!verification.verified) return json({ error: 'Verification failed' }, 400);
+    await touchCredential(stored.id, verification.authenticationInfo.newCounter);
+  } catch (err) {
+    return json({ error: (err as Error).message }, 400);
+  }
+
+  session?.set('reauthAt', Date.now());
+  return json({ verified: true });
+};
