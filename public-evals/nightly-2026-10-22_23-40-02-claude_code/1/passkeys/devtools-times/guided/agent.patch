diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..c62dcd6
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,320 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import {
+  ApiError,
+  api,
+  getCapabilities,
+  reauthWithPasskey,
+  registerPasskey,
+  syncAcceptedCredentials,
+  syncUserDetails,
+} from '../utils/passkeys';
+
+interface Passkey {
+  id: string;
+  name: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+  credentialBackedUp: boolean;
+}
+
+interface Account {
+  rpId: string;
+  user: { id: string; name: string; displayName: string };
+  credentials: Passkey[];
+}
+
+const baseUrl = import.meta.env.BASE_URL;
+const formatDate = (ms: number) =>
+  new Date(ms).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+
+const buttonClass =
+  'py-1.5 px-3 border border-gray-300 rounded-md text-sm font-medium text-gray-900 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 disabled:opacity-75';
+const primaryClass =
+  'py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75';
+const inputClass =
+  'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500';
+
+export default function AccountSettings() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [canCreate, setCanCreate] = useState(false);
+  const [displayName, setDisplayName] = useState('');
+  const [renaming, setRenaming] = useState<{ id: string; name: string } | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  // A sensitive action waiting on reauthentication.
+  const [pending, setPending] = useState<(() => Promise<void>) | null>(null);
+  const [password, setPassword] = useState('');
+
+  const load = useCallback(async () => {
+    try {
+      const data: Account = await api('passkeys/credentials');
+      setAccount(data);
+      setDisplayName(data.user.displayName);
+      return data;
+    } catch (err) {
+      if (err instanceof ApiError && err.status === 401) {
+        window.location.assign(`${baseUrl}signin`);
+      } else {
+        setError((err as Error).message);
+      }
+    }
+  }, []);
+
+  useEffect(() => {
+    load().then((data) => {
+      // Keep the passkey provider in sync with the server on every visit.
+      if (data) {
+        syncAcceptedCredentials(data.rpId, data.user.id, data.credentials.map((c) => c.id));
+      }
+    });
+    getCapabilities().then((caps) => setCanCreate(!!caps.passkeyPlatformAuthenticator));
+  }, [load]);
+
+  const run = async (fn: () => Promise<void>) => {
+    setError(null);
+    setNotice(null);
+    setBusy(true);
+    try {
+      await fn();
+    } catch (err) {
+      setError((err as Error).message);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const sync = (data?: Account) =>
+    data && syncAcceptedCredentials(data.rpId, data.user.id, data.credentials.map((c) => c.id));
+
+  const createPasskey = () =>
+    run(async () => {
+      // No platform restriction here, so security keys can be registered too.
+      const result = await registerPasskey();
+      if (result.status === 'exists') setError('A passkey from this provider already exists for your account.');
+      if (result.status === 'created') {
+        setNotice('Passkey created.');
+        sync(await load());
+      }
+    });
+
+  const saveDisplayName = (e: React.FormEvent) => {
+    e.preventDefault();
+    return run(async () => {
+      if (!account) return;
+      const user = await api('passkeys/user', { method: 'PUT', body: { displayName } });
+      await syncUserDetails(account.rpId, user.id, user.name, user.displayName);
+      setNotice('Display name updated.');
+      await load();
+    });
+  };
+
+  const saveRename = (e: React.FormEvent) => {
+    e.preventDefault();
+    return run(async () => {
+      if (!renaming) return;
+      await api(`passkeys/credentials/${encodeURIComponent(renaming.id)}`, {
+        method: 'PUT',
+        body: { name: renaming.name },
+      });
+      setRenaming(null);
+      await load();
+    });
+  };
+
+  const deletePasskey = (id: string): Promise<void> =>
+    run(async () => {
+      try {
+        await api(`passkeys/credentials/${encodeURIComponent(id)}`, { method: 'DELETE' });
+      } catch (err) {
+        if (err instanceof ApiError && err.code === 'reauth_required') {
+          // Ask the user to confirm it's them, then retry.
+          setPending(() => () => deletePasskey(id));
+          return;
+        }
+        throw err;
+      }
+      setNotice('Passkey deleted.');
+      sync(await load());
+    });
+
+  const finishReauth = async () => {
+    const retry = pending;
+    setPending(null);
+    setPassword('');
+    await retry?.();
+  };
+
+  const reauthPasskey = () =>
+    run(async () => {
+      if (await reauthWithPasskey()) await finishReauth();
+    });
+
+  const reauthPassword = (e: React.FormEvent) => {
+    e.preventDefault();
+    return run(async () => {
+      await api('auth/reauth', { body: { password } });
+      await finishReauth();
+    });
+  };
+
+  const signOut = async () => {
+    await api('auth/logout', { method: 'POST', body: {} });
+    window.location.assign(`${baseUrl}signin`);
+  };
+
+  if (!account) {
+    return (
+      <div className="max-w-2xl mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm text-gray-600">
+        {error ?? 'Loading account…'}
+      </div>
+    );
+  }
+
+  const hasPasskeys = account.credentials.length > 0;
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-6">
+      <div role="status" aria-live="polite">
+        {error && <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">{error}</div>}
+        {notice && <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg">{notice}</div>}
+      </div>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex items-start justify-between mb-4">
+          <div>
+            <h2 className="text-2xl font-bold text-gray-800">Account</h2>
+            <p className="text-sm text-gray-500">Signed in as {account.user.name}</p>
+          </div>
+          <button type="button" onClick={signOut} className={buttonClass}>Sign out</button>
+        </div>
+        <form onSubmit={saveDisplayName} className="flex items-end gap-3">
+          <div className="flex-1">
+            <label htmlFor="displayName" className="block text-sm font-medium text-gray-700 mb-1">
+              Display name
+            </label>
+            <input
+              id="displayName"
+              value={displayName}
+              onChange={(e) => setDisplayName(e.target.value)}
+              maxLength={60}
+              required
+              className={inputClass}
+            />
+          </div>
+          <button type="submit" disabled={busy} className={primaryClass}>Save</button>
+        </form>
+      </section>
+
+      {pending && (
+        <section className="p-6 bg-white border border-amber-300 rounded-lg shadow-sm" aria-labelledby="reauth-title">
+          <h3 id="reauth-title" className="text-lg font-semibold text-gray-800 mb-1">Confirm it’s you</h3>
+          <p className="text-sm text-gray-600 mb-4">Verify your identity to continue with this change.</p>
+          {hasPasskeys && (
+            <button type="button" onClick={reauthPasskey} disabled={busy} className={`${primaryClass} mb-4`}>
+              Verify with a passkey
+            </button>
+          )}
+          <form onSubmit={reauthPassword} className="flex items-end gap-3">
+            <div className="flex-1">
+              <label htmlFor="reauth-password" className="block text-sm font-medium text-gray-700 mb-1">
+                {hasPasskeys ? 'Or enter your password' : 'Password'}
+              </label>
+              <input
+                id="reauth-password"
+                type="password"
+                autoComplete="current-password"
+                value={password}
+                onChange={(e) => setPassword(e.target.value)}
+                required
+                className={inputClass}
+              />
+            </div>
+            <button type="submit" disabled={busy} className={buttonClass}>Confirm</button>
+            <button type="button" onClick={() => setPending(null)} className={buttonClass}>Cancel</button>
+          </form>
+        </section>
+      )}
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex items-center justify-between mb-4">
+          <h3 className="text-lg font-semibold text-gray-800">Passkeys</h3>
+          {canCreate && (
+            <button type="button" onClick={createPasskey} disabled={busy} className={primaryClass}>
+              Create passkey
+            </button>
+          )}
+        </div>
+        {!canCreate && (
+          <p className="text-sm text-gray-500 mb-4">
+            This device or browser doesn’t support passkeys, so you’ll keep signing in with your password.
+          </p>
+        )}
+
+        {!hasPasskeys ? (
+          <p className="text-sm text-gray-600">No passkeys found.</p>
+        ) : (
+          <ul className="divide-y divide-gray-200">
+            {account.credentials.map((pk) => (
+              <li key={pk.id} className="py-4 flex items-start gap-3">
+                {pk.providerIcon ? (
+                  <img src={pk.providerIcon} alt="" width={32} height={32} className="w-8 h-8 shrink-0" />
+                ) : (
+                  <div className="w-8 h-8 shrink-0 rounded bg-gray-200" aria-hidden="true" />
+                )}
+                <div className="flex-1 min-w-0">
+                  {renaming?.id === pk.id ? (
+                    <form onSubmit={saveRename} className="flex gap-2">
+                      <label htmlFor={`rename-${pk.id}`} className="sr-only">Passkey name</label>
+                      <input
+                        id={`rename-${pk.id}`}
+                        value={renaming.name}
+                        onChange={(e) => setRenaming({ id: pk.id, name: e.target.value })}
+                        maxLength={60}
+                        required
+                        autoFocus
+                        className={inputClass}
+                      />
+                      <button type="submit" disabled={busy} className={buttonClass}>Save</button>
+                      <button type="button" onClick={() => setRenaming(null)} className={buttonClass}>Cancel</button>
+                    </form>
+                  ) : (
+                    <>
+                      <p className="font-medium text-gray-900 truncate">{pk.name}</p>
+                      <p className="text-xs text-gray-500">
+                        Created {formatDate(pk.registeredAt)}
+                        {pk.lastUsedAt ? ` · Last used ${formatDate(pk.lastUsedAt)}` : ' · Never used'}
+                      </p>
+                    </>
+                  )}
+                </div>
+                {renaming?.id !== pk.id && (
+                  <div className="flex gap-2">
+                    <button
+                      type="button"
+                      onClick={() => setRenaming({ id: pk.id, name: pk.name })}
+                      className={buttonClass}
+                      aria-label={`Rename ${pk.name}`}
+                    >
+                      Rename
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => deletePasskey(pk.id)}
+                      disabled={busy}
+                      className={buttonClass}
+                      aria-label={`Delete ${pk.name}`}
+                    >
+                      Delete
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+    </div>
+  );
+}
