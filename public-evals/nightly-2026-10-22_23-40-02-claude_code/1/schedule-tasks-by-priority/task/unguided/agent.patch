+  <script>
+    (function () {
+      // Lower rank = runs first. `units` is the number of work chunks in a task.
+      var TYPES = {
+        urgent: { rank: 0, label: 'Checkout', units: 40 },
+        standard: { rank: 1, label: 'Menu update', units: 120 },
+        background: { rank: 2, label: 'Telemetry log', units: 250 }
+      };
+      var SLICE_BUDGET_MS = 8; // max continuous work before yielding to the browser
+      var UNIT_WORK = 20000;   // busy-loop iterations per unit
+
+      var queue = [];
+      var running = false;
+      var current = null;
+      var seq = 0;
+      var maxSlice = 0;
+      var completed = 0;
+
+      var queueEl = document.getElementById('ops-queue');
+      var doneEl = document.getElementById('ops-done');
+      var summaryEl = document.getElementById('ops-summary');
+      var sliceEl = document.getElementById('ops-slice');
+
+      var channel = new MessageChannel();
+      channel.port1.onmessage = runSlice;
+
+      function addTask(type) {
+        var t = TYPES[type];
+        queue.push({ id: ++seq, type: type, rank: t.rank, label: t.label, units: t.units, done: 0 });
+        render();
+        if (!running) {
+          running = true;
+          schedule();
+        }
+      }
+
+      function pickNext() {
+        // Highest priority first; FIFO within the same priority.
+        var best = -1;
+        for (var i = 0; i < queue.length; i++) {
+          if (best < 0 || queue[i].rank < queue[best].rank) best = i;
+        }
+        return best < 0 ? null : queue[best];
+      }
+
+      function schedule() {
+        // Yield to rendering/input between slices.
+        requestAnimationFrame(function () { channel.port2.postMessage(0); });
+      }
+
+      function simulateUnit() {
+        var x = 0;
+        for (var i = 0; i < UNIT_WORK; i++) x += Math.sqrt(i) * Math.sin(i);
+        return x;
+      }
+
+      function runSlice() {
+        var start = performance.now();
+        // Re-evaluate priority each slice so newly added urgent tasks preempt.
+        while (performance.now() - start < SLICE_BUDGET_MS) {
+          var task = pickNext();
+          if (!task) break;
+          current = task;
+          simulateUnit();
+          task.done++;
+          if (task.done >= task.units) {
+            queue.splice(queue.indexOf(task), 1);
+            current = null;
+            completed++;
+            logDone(task);
+          }
+          // Urgent work arriving mid-slice is picked up on the next iteration.
+        }
+        maxSlice = Math.max(maxSlice, performance.now() - start);
+        render();
+        if (queue.length) {
+          schedule();
+        } else {
+          running = false;
+          current = null;
+          render();
+        }
+      }
+
+      function logDone(task) {
+        var li = document.createElement('li');
+        li.className = 'p-' + task.type;
+        li.textContent = '#' + task.id + ' ' + task.label + ' (' + task.type + ') - completed as job ' + completed;
+        if (doneEl.firstChild && doneEl.firstChild.className === 'empty') doneEl.innerHTML = '';
+        doneEl.insertBefore(li, doneEl.firstChild);
+        while (doneEl.children.length > 50) doneEl.removeChild(doneEl.lastChild);
+      }
+
+      function render() {
+        var sorted = queue.slice().sort(function (a, b) { return a.rank - b.rank || a.id - b.id; });
+        queueEl.innerHTML = '';
+        if (!sorted.length) {
+          queueEl.innerHTML = '<li class="empty">Queue is empty</li>';
+        }
+        sorted.forEach(function (task) {
+          var li = document.createElement('li');
+          li.className = 'p-' + task.type;
+          var active = task === current ? ' - running' : '';
+          li.textContent = '#' + task.id + ' ' + task.label + ' (' + task.type + ')' + active;
+          var bar = document.createElement('div');
+          bar.className = 'ops-bar';
+          var fill = document.createElement('span');
+          fill.style.width = Math.round(task.done / task.units * 100) + '%';
+          bar.appendChild(fill);
+          li.appendChild(bar);
+          queueEl.appendChild(li);
+        });
+        if (!doneEl.children.length) doneEl.innerHTML = '<li class="empty">Nothing completed yet</li>';
+        summaryEl.textContent = running
+          ? queue.length + ' pending, ' + completed + ' done'
+          : 'Idle, ' + completed + ' done';
+        sliceEl.textContent = maxSlice.toFixed(1);
+      }
+
+      document.querySelectorAll('[data-task]').forEach(function (btn) {
+        btn.addEventListener('click', function () { addTask(btn.getAttribute('data-task')); });
+      });
+
+      document.getElementById('ops-batch').addEventListener('click', function () {
+        // Enqueued in shuffled order on purpose; the scheduler sorts by priority.
+        ['background', 'standard', 'urgent', 'background', 'urgent', 'standard'].forEach(addTask);
+      });
+
+      document.getElementById('ops-clear').addEventListener('click', function () {
+        doneEl.innerHTML = '';
+        completed = 0;
+        maxSlice = 0;
+        render();
+      });
+
+      render();
+    })();
+  </script>
+
 </body>
 
 </html>
