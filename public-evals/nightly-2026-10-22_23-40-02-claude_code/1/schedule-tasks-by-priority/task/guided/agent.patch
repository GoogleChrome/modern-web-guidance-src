+  <script>
+    (() => {
+      const TYPES = {
+        checkout: { label: 'Urgent checkout', priority: 'user-blocking', slices: 12 },
+        menu: { label: 'Menu update', priority: 'user-visible', slices: 20 },
+        telemetry: { label: 'Telemetry logging', priority: 'background', slices: 30 }
+      };
+      const SLICE_MS = 20;
+      const list = document.getElementById('ops-list');
+      const log = document.getElementById('ops-log');
+      const pendingOut = document.getElementById('ops-pending');
+      const beatOut = document.getElementById('ops-beat');
+      let pending = 0;
+      let counter = 0;
+
+      // Scheduler API is not in Safari: load the polyfill only when needed.
+      const schedulerReady = ('scheduler' in window && 'postTask' in window.scheduler)
+        ? Promise.resolve()
+        : new Promise((resolve) => {
+          const script = document.createElement('script');
+          script.src = 'https://unpkg.com/scheduler-polyfill';
+          script.onload = script.onerror = resolve;
+          document.head.appendChild(script);
+        });
+
+      // Plain macrotask fallback if the polyfill could not load (offline).
+      const post = (fn, priority) => window.scheduler?.postTask
+        ? scheduler.postTask(fn, { priority })
+        : new Promise((resolve) => setTimeout(resolve)).then(fn);
+
+      const t0 = performance.now();
+      const addLog = (text) => {
+        const li = document.createElement('li');
+        li.textContent = `[${Math.round(performance.now() - t0)}ms] ${text}`;
+        log.append(li);
+        log.scrollTop = log.scrollHeight;
+      };
+
+      const busyWait = (ms) => {
+        const end = performance.now() + ms;
+        while (performance.now() < end);
+      };
+
+      async function runTask(type) {
+        const { label, priority, slices } = TYPES[type];
+        const id = ++counter;
+        const li = document.createElement('li');
+        li.className = 'op';
+        li.dataset.priority = priority;
+        li.innerHTML = '<div class="op-head"><strong></strong><span>queued</span></div><progress max="1" value="0"></progress>';
+        const [name, state] = li.querySelectorAll('strong, span');
+        name.textContent = `#${id} ${label} (${priority})`;
+        const bar = li.querySelector('progress');
+        list.prepend(li);
+        pendingOut.textContent = ++pending;
+        await schedulerReady;
+
+        for (let i = 0; i < slices; i++) {
+          // Each slice is its own prioritized task, so higher-priority work can interleave.
+          await post(() => {
+            if (i === 0) {
+              state.textContent = 'running';
+              addLog(`start  #${id} ${label}`);
+            }
+            busyWait(SLICE_MS);
+            bar.value = (i + 1) / slices;
+          }, priority);
+        }
+        state.textContent = 'done';
+        addLog(`finish #${id} ${label}`);
+        pendingOut.textContent = --pending;
+      }
+
+      document.querySelector('.ops-controls').addEventListener('click', (event) => {
+        const run = event.target.closest('button')?.dataset.run;
+        if (!run) return;
+        if (run === 'batch') {
+          // Submitted in mixed order; the scheduler runs them by priority.
+          const mix = ['telemetry', 'menu', 'checkout', 'telemetry', 'checkout', 'menu'];
+          addLog('batch submitted: ' + mix.join(', '));
+          mix.forEach(runTask);
+        } else {
+          runTask(run);
+        }
+      });
+
+      // Heartbeat proves the main thread keeps painting frames while tasks run.
+      let frames = 0;
+      const tick = () => {
+        beatOut.textContent = ++frames;
+        requestAnimationFrame(tick);
+      };
+      requestAnimationFrame(tick);
+    })();
+  </script>
+
 </body>
 
