+    /* Sticky section headers (viewport is the scroll root) */
+    .menu-section {
+      margin-top: 40px;
+      /* Padding changes when stuck; stop scroll anchoring from fighting them */
+      overflow-anchor: none;
+    }
+
+    .sticky-container {
+      position: sticky;
+      top: var(--nav-height);
+      z-index: 10;
+      container-type: scroll-state;
+      container-name: section-header;
+    }
+
+    .sticky-header {
+      background: var(--secondary);
+      color: var(--primary);
+      padding: 1.25rem 20px;
+      border-radius: 8px;
+      transition: background-color 0.3s, box-shadow 0.3s, padding 0.3s, color 0.3s;
+    }
+
+    @container section-header scroll-state(stuck: top) {
+      .sticky-header {
+        background: #0056b3;
+        color: white;
+        box-shadow: 0 4px 6px rgb(0 0 0 / 0.25);
+        padding: 0.4rem 20px;
+      }
+    }
