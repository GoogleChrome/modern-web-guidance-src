+        background: #1976d2;
+        color: white;
+        border-radius: 0 0 8px 8px;
+        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
+      }
+
+      .sticky-header h2 {
+        font-size: 1.1rem;
+      }
+    }
