+  <script type="module">
+    // Temporal is not available in Safari yet; load the polyfill when missing.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    // Both values are stored as plain strings ("HH:MM" and "YYYY-MM-DD") and handled
+    // only through Temporal Plain types, so they never shift with the viewer's time zone.
+    const STORAGE_KEY = 'dailyGrindPrefs';
+    const form = document.getElementById('prefs-form');
+    const summary = document.getElementById('prefs-summary');
+
+    function render({ pickupTime, coffeeAnniversary }) {
+      const time = Temporal.PlainTime.from(pickupTime);
+      const date = Temporal.PlainDate.from(coffeeAnniversary);
+      summary.textContent =
+        `Pickup reminder: ${time.toLocaleString(undefined, { timeStyle: 'short' })} every day. ` +
+        `Coffee anniversary: ${date.toLocaleString(undefined, { dateStyle: 'long' })}.`;
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
+      if (saved) {
+        form.pickupTime.value = saved.pickupTime;
+        form.coffeeAnniversary.value = saved.coffeeAnniversary;
+        render(saved);
+      }
+    } catch {
+      localStorage.removeItem(STORAGE_KEY);
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Normalize through Plain types (drops seconds, validates the date).
+      const prefs = {
+        pickupTime: Temporal.PlainTime.from(form.pickupTime.value).toString({ smallestUnit: 'minute' }),
+        coffeeAnniversary: Temporal.PlainDate.from(form.coffeeAnniversary.value).toString(),
+      };
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
+      render(prefs);
+    });
+  </script>
 </body>
 
