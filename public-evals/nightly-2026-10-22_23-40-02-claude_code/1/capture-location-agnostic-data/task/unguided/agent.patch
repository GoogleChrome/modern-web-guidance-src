+  <script>
+    // Both values are floating (location-agnostic): stored and shown as the
+    // exact "HH:MM" / "YYYY-MM-DD" strings the user picked. They are never
+    // converted to a Date/timestamp, so time zone changes can't shift them.
+    const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
+      'August', 'September', 'October', 'November', 'December'];
+
+    function formatTime(value) {
+      const [h, m] = value.split(':').map(Number);
+      return `${h % 12 || 12}:${String(m).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`;
+    }
+
+    function formatDate(value) {
+      const [y, m, d] = value.split('-').map(Number);
+      return `${MONTHS[m - 1]} ${d}, ${y}`;
+    }
+
+    function bindPreference(inputId, outputId, storageKey, format, label) {
+      const input = document.getElementById(inputId);
+      const output = document.getElementById(outputId);
+      const render = () => {
+        output.textContent = input.value ? `${label}: ${format(input.value)}` : '';
+      };
+      input.value = localStorage.getItem(storageKey) || '';
+      input.addEventListener('change', () => {
+        if (input.value) localStorage.setItem(storageKey, input.value);
+        else localStorage.removeItem(storageKey);
+        render();
+      });
+      render();
+    }
+
+    bindPreference('pickup-time', 'pickup-saved', 'pickupReminderTime', formatTime, 'Daily at');
+    bindPreference('coffee-anniversary', 'anniversary-saved', 'coffeeAnniversaryDate', formatDate, 'Since');
+  </script>
