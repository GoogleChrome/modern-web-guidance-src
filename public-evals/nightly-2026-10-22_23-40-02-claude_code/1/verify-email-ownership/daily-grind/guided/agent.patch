@@ -0,0 +1,153 @@
+import { createServer } from 'node:http';
+import { randomBytes, scryptSync } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import { verifyEmailVerificationToken } from './evt-verifier.js';
+
+const PORT = Number(process.env.PORT || 11222);
+// Public origin of this site; the browser binds the EVT to it (KB-JWT `aud`).
+const RP_ORIGIN = process.env.RP_ORIGIN || `http://localhost:${PORT}`;
+const ORIGIN_TRIAL_TOKEN = process.env.ORIGIN_TRIAL_TOKEN || '';
+const SECURE_COOKIE = RP_ORIGIN.startsWith('https://');
+const SESSION_TTL_MS = 30 * 60 * 1000;
+const MAX_BODY_BYTES = 32 * 1024;
+
+// In-memory stores (replace with a database / session store in production).
+const sessions = new Map(); // sid -> { nonce, expires }
+const accounts = new Map(); // lowercased email -> account
+
+const escapeHtml = (s) =>
+  String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+
+function parseCookies(header = '') {
+  return Object.fromEntries(
+    header.split(';').map((p) => p.trim().split('=')).filter(([k]) => k).map(([k, ...v]) => [k, v.join('=')]),
+  );
+}
+
+function sessionCookie(sid) {
+  return `sid=${sid}; HttpOnly; SameSite=Lax; Path=/; Max-Age=${SESSION_TTL_MS / 1000}${SECURE_COOKIE ? '; Secure' : ''}`;
+}
+
+/** Issue a fresh single-use nonce bound to the (new or existing) server-side session. */
+function issueNonce(req) {
+  let sid = parseCookies(req.headers.cookie).sid;
+  if (!sid || !sessions.has(sid)) sid = randomBytes(32).toString('base64url');
+  const nonce = randomBytes(32).toString('base64url');
+  sessions.set(sid, { nonce, expires: Date.now() + SESSION_TTL_MS });
+  return { sid, nonce };
+}
+
+/** Atomically read and delete the session's nonce so a token can never be replayed. */
+function consumeNonce(req) {
+  const sid = parseCookies(req.headers.cookie).sid;
+  const session = sid && sessions.get(sid);
+  if (!session) return null;
+  sessions.delete(sid);
+  return session.expires > Date.now() ? session.nonce : null;
+}
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [sid, s] of sessions) if (s.expires <= now) sessions.delete(sid);
+}, 60_000).unref();
+
+async function readForm(req) {
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > MAX_BODY_BYTES) throw Object.assign(new Error('Body too large'), { status: 413 });
+    chunks.push(chunk);
+  }
+  return new URLSearchParams(Buffer.concat(chunks).toString('utf8'));
+}
+
+function sendHtml(res, status, body, headers = {}) {
+  res.writeHead(status, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store', ...headers });
+  res.end(body);
+}
+
+function resultPage(title, message) {
+  return `<!DOCTYPE html>
+<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>${escapeHtml(title)} | The Daily Grind</title>
+<style>body{font-family:'Segoe UI',Tahoma,sans-serif;background:#fafafa;color:#3e2723;display:grid;place-items:center;min-height:100vh;padding:20px}
+main{max-width:480px;background:#fff;padding:32px;border-radius:8px;box-shadow:0 2px 5px rgba(0,0,0,.1);text-align:center}
+h1{color:#4e342e;margin-bottom:12px}a{display:inline-block;margin-top:20px;background:#4e342e;color:#fff;padding:10px 20px;border-radius:5px;text-decoration:none}</style>
+</head><body><main><h1>${escapeHtml(title)}</h1><p>${escapeHtml(message)}</p><a href="/">Back to home</a></main></body></html>`;
+}
+
+function sendFallbackVerificationEmail(email) {
+  // Hook up your email provider here to send a traditional OTP code or magic link.
+  console.log(`[fallback] would send verification email to ${email}`);
+}
+
+function createAccount({ name, email, password, emailVerified }) {
+  const salt = randomBytes(16);
+  accounts.set(email.toLowerCase(), {
+    name,
+    email,
+    emailVerified,
+    passwordHash: `${salt.toString('hex')}:${scryptSync(password, salt, 64).toString('hex')}`,
+    createdAt: new Date().toISOString(),
+  });
+}
+
+async function handleSignup(req, res) {
+  const form = await readForm(req);
+  const name = (form.get('name') || '').trim();
+  const email = (form.get('email') || '').trim();
+  const password = form.get('new-password') || '';
+  const rawToken = (form.get('token') || '').trim();
+  // Always consume the nonce first, even if validation below fails.
+  const expectedNonce = consumeNonce(req);
+
+  const emailOk = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) && email.length <= 254;
+  if (!name || name.length > 100 || !emailOk || password.length < 8 || password.length > 200) {
+    return sendHtml(res, 400, resultPage('Check your details', 'Please provide your name, a valid email address and a password of at least 8 characters.'));
+  }
+  if (accounts.has(email.toLowerCase())) {
+    return sendHtml(res, 409, resultPage('Account exists', 'An account with that email address already exists.'));
+  }
+
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({ rawToken, submittedEmail: email, expectedNonce, expectedAudience: RP_ORIGIN });
+      createAccount({ name, email, password, emailVerified: true });
+      return sendHtml(res, 201, resultPage('Welcome to Daily Grind Rewards!', `Your email address ${email} was verified by your browser. Your rewards account is ready.`));
+    } catch (err) {
+      console.error('Email verification token check failed:', err);
+    }
+  }
+
+  // Fallback: no usable token, so verify with a traditional email.
+  createAccount({ name, email, password, emailVerified: false });
+  sendFallbackVerificationEmail(email);
+  return sendHtml(res, 202, resultPage('Check your inbox', `We couldn't verify your email automatically, so we've sent a confirmation email to ${email}.`));
+}
+
+const server = createServer(async (req, res) => {
+  try {
+    const { pathname } = new URL(req.url, RP_ORIGIN);
+
+    if (req.method === 'GET' && (pathname === '/' || pathname === '/index.html')) {
+      const { sid, nonce } = issueNonce(req);
+      const html = (await readFile(new URL('./index.html', import.meta.url), 'utf8')).replaceAll('__EVT_NONCE__', nonce);
+      const headers = { 'Set-Cookie': sessionCookie(sid) };
+      if (ORIGIN_TRIAL_TOKEN) headers['Origin-Trial'] = ORIGIN_TRIAL_TOKEN;
+      return sendHtml(res, 200, html, headers);
+    }
+
+    if (req.method === 'POST' && pathname === '/api/verify-email') {
+      return await handleSignup(req, res);
+    }
+
+    res.writeHead(pathname === '/api/verify-email' ? 405 : 404, { 'Content-Type': 'text/plain' });
+    res.end('Not found');
+  } catch (err) {
+    console.error(err);
+    sendHtml(res, err.status || 500, resultPage('Something went wrong', 'Please try again.'));
+  }
+});
+
+server.listen(PORT, () => console.log(`Daily Grind listening on ${RP_ORIGIN}`));
