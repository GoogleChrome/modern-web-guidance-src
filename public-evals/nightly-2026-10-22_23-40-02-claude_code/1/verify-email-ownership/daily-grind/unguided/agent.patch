+  <script>
+    (function () {
+      var form = document.getElementById('signup-form');
+      var status = document.getElementById('signup-status');
+      var btn = document.getElementById('signup-submit');
+      function say(msg, cls) { status.textContent = msg; status.className = cls || ''; }
+      function post(url, body) {
+        return fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) })
+          .then(function (r) { return r.json().then(function (d) { if (!r.ok) throw new Error(d.error || 'Something went wrong.'); return d; }); });
+      }
+      // Browser-assisted email verification (WebCG Email Verification Protocol).
+      // The browser obtains an issuer-signed, key-bound token for the email and a
+      // key-binding proof over our nonce and origin; the server verifies both.
+      function requestEmailCredential(email, nonce) {
+        return navigator.credentials.get({
+          mediation: 'required',
+          identity: { providers: [{ format: 'email_verification', email: email, nonce: nonce }] }
+        }).then(function (cred) {
+          var token = cred && (cred.token || (cred.data && cred.data.token));
+          if (!token) throw new Error('Your browser did not return a verification.');
+          return token;
+        });
+      }
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var name = form.name.value.trim(), email = form.email.value.trim();
+        if (!name || !form.email.checkValidity() || !email) return say('Please enter your name and a valid email.', 'error');
+        if (!window.IdentityCredential || !navigator.credentials) {
+          return say('Your browser does not support email verification yet. Please try a recent version of Chrome.', 'error');
+        }
+        btn.disabled = true; say('Verifying your email with your browser…');
+        post('/api/email-verification/nonce', { email: email })
+          .then(function (n) {
+            return requestEmailCredential(email, n.nonce).then(function (credential) {
+              return post('/api/rewards/signup', { name: name, email: email, nonce: n.nonce, credential: credential });
+            });
+          })
+          .then(function (d) { say(d.message, 'ok'); form.reset(); })
+          .catch(function (err) { say(err.name === 'NotAllowedError' ? 'Email verification was cancelled.' : err.message, 'error'); })
+          .then(function () { btn.disabled = false; });
+      });
+    })();
+  </script>
