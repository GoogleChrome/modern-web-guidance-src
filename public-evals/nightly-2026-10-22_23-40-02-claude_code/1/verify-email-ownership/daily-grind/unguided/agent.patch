+// Static file server + rewards sign-up API with browser-assisted email verification.
+// Zero dependencies. Run: node server.js
+const http = require('http');
+const fs = require('fs');
+const path = require('path');
+const dns = require('dns').promises;
+const crypto = require('crypto');
+
+const PORT = process.env.PORT || 11222;
+const ORIGIN = process.env.PUBLIC_ORIGIN || null; // e.g. https://dailygrind.example (recommended in production)
+const NONCE_TTL_MS = 5 * 60 * 1000;
+const MAX_TOKEN_AGE_S = 10 * 60;
+
+const nonces = new Map();   // nonce -> { email, expires }
+const accounts = new Map(); // email -> account (in-memory demo store; swap for a database)
+
+const b64u = (s) => Buffer.from(s, 'base64url');
+const parseJwt = (jwt) => {
+  const p = jwt.split('.');
+  if (p.length !== 3) throw new Error('malformed JWT');
+  return { header: JSON.parse(b64u(p[0])), payload: JSON.parse(b64u(p[1])), sig: b64u(p[2]), signingInput: p[0] + '.' + p[1] };
+};
+
+function verifySig(alg, jwk, signingInput, sig) {
+  const key = crypto.createPublicKey({ key: jwk, format: 'jwk' });
+  if (alg === 'ES256') return crypto.verify('sha256', Buffer.from(signingInput), { key, dsaEncoding: 'ieee-p1363' }, sig);
+  if (alg === 'RS256') return crypto.verify('sha256', Buffer.from(signingInput), key, sig);
+  throw new Error('unsupported alg');
+}
+
+const isPublicHostname = (h) =>
+  /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/i.test(h) && !/^\d+(\.\d+)*$/.test(h) && !/\.(local|internal|localhost)$/i.test(h);
+
+async function getJson(url) {
+  const res = await fetch(url, { redirect: 'error', signal: AbortSignal.timeout(5000), headers: { accept: 'application/json' } });
+  if (!res.ok) throw new Error('fetch failed: ' + url);
+  return res.json();
+}
+
+// The email domain delegates to an issuer via DNS: TXT _email-verification.<domain> = "iss=<issuer-host>"
+async function discoverIssuer(domain) {
+  const records = (await dns.resolveTxt('_email-verification.' + domain)).map((r) => r.join(''));
+  const rec = records.find((r) => r.startsWith('iss='));
+  const host = rec && rec.slice(4).trim();
+  if (!host || !isPublicHostname(host)) throw new Error('email domain has no valid verification issuer');
+  return host;
+}
+
+async function verifyEmailCredential(sdJwtKb, email, nonceEntry, nonce, origin) {
+  const parts = sdJwtKb.split('~');
+  if (parts.length !== 2 || !parts[1]) throw new Error('expected SD-JWT+KB');
+  const [issuerJwt, kbJwt] = parts;
+  const domain = email.split('@')[1].toLowerCase();
+
+  const issuerHost = await discoverIssuer(domain);
+  const iss = parseJwt(issuerJwt);
+  if (iss.payload.iss !== issuerHost) throw new Error('issuer does not match DNS delegation');
+  const meta = await getJson(`https://${issuerHost}/.well-known/web-identity`);
+  const jwksUri = new URL(meta.jwks_uri || `https://${issuerHost}/.well-known/jwks.json`);
+  if (jwksUri.protocol !== 'https:' || jwksUri.hostname !== issuerHost) throw new Error('bad jwks_uri');
+  const { keys } = await getJson(jwksUri.href);
+  const jwk = keys.find((k) => k.kid === iss.header.kid) || (keys.length === 1 ? keys[0] : null);
+  if (!jwk || !verifySig(iss.header.alg, jwk, iss.signingInput, iss.sig)) throw new Error('issuer signature invalid');
+
+  const now = Math.floor(Date.now() / 1000);
+  const c = iss.payload;
+  if (typeof c.email !== 'string' || c.email.toLowerCase() !== email.toLowerCase()) throw new Error('email mismatch');
+  if (c.email_verified !== true) throw new Error('email not verified by issuer');
+  if (typeof c.iat !== 'number' || now - c.iat > MAX_TOKEN_AGE_S || c.iat - now > 60) throw new Error('credential expired');
+  if (typeof c.exp === 'number' && c.exp < now) throw new Error('credential expired');
+  if (!c.cnf || !c.cnf.jwk) throw new Error('credential not key-bound');
+
+  // Key-binding JWT proves the browser holding the bound key was asked by *this* site, for *this* nonce.
+  const kb = parseJwt(kbJwt);
+  if (!verifySig(kb.header.alg, c.cnf.jwk, kb.signingInput, kb.sig)) throw new Error('key-binding signature invalid');
+  if (kb.payload.nonce !== nonce) throw new Error('nonce mismatch');
+  if (origin && kb.payload.aud !== origin) throw new Error('audience mismatch');
+  if (typeof kb.payload.iat !== 'number' || Math.abs(now - kb.payload.iat) > 120) throw new Error('key-binding stale');
+  const sdHash = crypto.createHash('sha256').update(issuerJwt + '~').digest('base64url');
+  if (kb.payload.sd_hash !== sdHash) throw new Error('sd_hash mismatch');
+}
+
+const readBody = (req) => new Promise((resolve, reject) => {
+  let n = 0; const chunks = [];
+  req.on('data', (d) => { n += d.length; if (n > 32768) { reject(new Error('too large')); req.destroy(); } else chunks.push(d); });
+  req.on('end', () => { try { resolve(JSON.parse(Buffer.concat(chunks))); } catch { reject(new Error('bad json')); } });
+});
+const send = (res, code, obj) => { res.writeHead(code, { 'content-type': 'application/json', 'cache-control': 'no-store' }); res.end(JSON.stringify(obj)); };
+const EMAIL_RE = /^[^\s@]{1,64}@[^\s@]+\.[^\s@]+$/;
+
+async function api(req, res) {
+  const origin = ORIGIN || `${req.headers['x-forwarded-proto'] || 'http'}://${req.headers.host}`;
+  try {
+    if (req.method === 'POST' && req.url === '/api/email-verification/nonce') {
+      const { email } = await readBody(req);
+      if (typeof email !== 'string' || !EMAIL_RE.test(email) || email.length > 254) return send(res, 400, { error: 'Enter a valid email address.' });
+      for (const [k, v] of nonces) if (v.expires < Date.now()) nonces.delete(k);
+      const nonce = crypto.randomBytes(24).toString('base64url');
+      nonces.set(nonce, { email: email.toLowerCase(), expires: Date.now() + NONCE_TTL_MS });
+      return send(res, 200, { nonce });
+    }
+    if (req.method === 'POST' && req.url === '/api/rewards/signup') {
+      const { name, email, nonce, credential } = await readBody(req);
+      if (typeof name !== 'string' || !name.trim() || name.length > 100) return send(res, 400, { error: 'Enter your name.' });
+      if (typeof email !== 'string' || !EMAIL_RE.test(email) || typeof nonce !== 'string' || typeof credential !== 'string') return send(res, 400, { error: 'Invalid request.' });
+      const entry = nonces.get(nonce);
+      nonces.delete(nonce); // single use, even on failure
+      if (!entry || entry.expires < Date.now() || entry.email !== email.toLowerCase()) return send(res, 400, { error: 'Verification expired. Please try again.' });
+      try {
+        await verifyEmailCredential(credential, email, entry, nonce, origin);
+      } catch (e) {
+        console.warn('email verification failed:', e.message);
+        return send(res, 403, { error: 'We could not verify that you own this email address.' });
+      }
+      const key = email.toLowerCase();
+      if (accounts.has(key)) return send(res, 409, { error: 'A rewards account already exists for this email.' });
+      accounts.set(key, { name: name.trim(), email: key, emailVerified: true, createdAt: new Date().toISOString() });
+      return send(res, 201, { ok: true, message: `Welcome, ${name.trim()}! Your rewards account is ready.` });
+    }
+    send(res, 404, { error: 'Not found' });
+  } catch (e) {
+    send(res, 400, { error: 'Bad request.' });
+  }
+}
+
+http.createServer((req, res) => {
+  if (req.url.startsWith('/api/')) return api(req, res);
+  if (req.method === 'GET' && (req.url === '/' || req.url.startsWith('/?') || req.url === '/index.html')) {
+    return fs.createReadStream(path.join(__dirname, 'index.html')).on('error', () => res.writeHead(500).end()).once('open', () => res.writeHead(200, { 'content-type': 'text/html; charset=utf-8' })).pipe(res);
+  }
+  res.writeHead(404).end('Not found');
+}).listen(PORT, () => console.log('Daily Grind on :' + PORT));
