index 66c9173..ff612de 100644
--- a/index.html
+++ b/index.html
@@ -207,6 +207,116 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // WebMCP: expose client-side functionality as tools to AI agents.
+    (function () {
+      if (!('modelContext' in navigator)) return;
+
+      const text = (value) => ({
+        content: [{ type: 'text', text: typeof value === 'string' ? value : JSON.stringify(value) }]
+      });
+
+      const pages = {
+        menu: '/menu',
+        locations: '/locations',
+        rewards: '/rewards',
+        account: '/account',
+        'order-online': '/order-online',
+        about: '/about',
+        careers: '/careers',
+        contact: '/contact',
+        'privacy-policy': '/privacy-policy'
+      };
+
+      const seasonalFavorites = () =>
+        Array.from(document.querySelectorAll('.grid .card')).map((card) => {
+          const link = card.querySelector('a');
+          return {
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            url: link ? link.getAttribute('href') : null
+          };
+        });
+
+      const tools = [
+        {
+          name: 'list_seasonal_favorites',
+          description: 'List the seasonal favorite drinks shown on the home page, with descriptions and detail page URLs.',
+          inputSchema: { type: 'object', properties: {} },
+          annotations: { readOnlyHint: true },
+          execute: async () => text(seasonalFavorites())
+        },
+        {
+          name: 'view_menu_item',
+          description: 'Open the detail page for a seasonal favorite drink.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              name: {
+                type: 'string',
+                description: 'Drink name, e.g. "Maple Oat Latte", "Dark Roast Espresso" or "Cold Brew" (case-insensitive).'
+              }
+            },
+            required: ['name']
+          },
+          execute: async ({ name }) => {
+            const query = String(name || '').trim().toLowerCase();
+            const item = seasonalFavorites().find((i) => i.name.toLowerCase() === query) ||
+              seasonalFavorites().find((i) => i.name.toLowerCase().includes(query) && query);
+            if (!item || !item.url) {
+              return { isError: true, ...text(`No seasonal favorite found matching "${name}".`) };
+            }
+            window.location.href = item.url;
+            return text(`Navigating to ${item.name} at ${item.url}`);
+          }
+        },
+        {
+          name: 'navigate_to_page',
+          description: 'Navigate to a page of The Daily Grind website.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              page: { type: 'string', enum: Object.keys(pages), description: 'The page to open.' }
+            },
+            required: ['page']
+          },
+          execute: async ({ page }) => {
+            const url = pages[page];
+            if (!url) return { isError: true, ...text(`Unknown page "${page}".`) };
+            window.location.href = url;
+            return text(`Navigating to ${url}`);
+          }
+        },
+        {
+          name: 'start_order',
+          description: 'Start an online order (same as pressing the "Order Now" button).',
+          inputSchema: { type: 'object', properties: {} },
+          execute: async () => {
+            window.location.href = '/order-online';
+            return text('Navigating to /order-online');
+          }
+        },
+        {
+          name: 'logout',
+          description: 'Log the current user out of their account.',
+          inputSchema: { type: 'object', properties: {} },
+          annotations: { destructiveHint: true },
+          execute: async () => {
+            window.location.href = '/logout';
+            return text('Logging out via /logout');
+          }
+        }
+      ];
+
+      for (const tool of tools) {
+        try {
+          navigator.modelContext.registerTool(tool);
+        } catch (err) {
+          console.warn('WebMCP: failed to register tool', tool.name, err);
+        }
+      }
+    })();
+  </script>
 </body>
 
 </html>
