diff --git a/src/components/WebMCPTools.tsx b/src/components/WebMCPTools.tsx
new file mode 100644
index 0000000..8081cba
--- /dev/null
+++ b/src/components/WebMCPTools.tsx
@@ -0,0 +1,174 @@
+import { useEffect, useState } from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+import { fetchReadingList, toggleReadingList } from '../utils/readingList';
+
+interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+}
+
+const baseUrl = import.meta.env.BASE_URL;
+
+async function fetchArticles(signal?: AbortSignal): Promise<Article[]> {
+  const response = await fetch(`${baseUrl}api/articles.json`, { signal });
+  return response.json();
+}
+
+const withUrl = ({ slug, title, summary }: Article) => ({
+  slug,
+  title,
+  summary,
+  url: `${baseUrl}articles/${slug}`,
+});
+
+const currentArticle = () => document.querySelector<HTMLElement>('article[data-article-slug]');
+
+const articleText = (article: HTMLElement) =>
+  (article.querySelector<HTMLElement>('.prose')?.innerText ?? '').trim();
+
+// Registers WebMCP tools that work on any page, plus article tools while an article is open.
+export default function WebMCPTools() {
+  const [onArticle, setOnArticle] = useState(false);
+
+  useEffect(() => {
+    setOnArticle(currentArticle() !== null);
+  }, []);
+
+  useWebMCP({
+    name: 'list-articles',
+    description: 'Lists the newspaper’s articles with their slugs, so a story can be picked for reading or saving.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    execute: async (_input, { signal }) => (await fetchArticles(signal)).map(withUrl),
+  });
+
+  useWebMCP({
+    name: 'get-reading-list',
+    description: 'Returns the articles the reader has saved to their reading list.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    execute: async (_input, { signal }) => {
+      const [slugs, articles] = await Promise.all([fetchReadingList(), fetchArticles(signal)]);
+      return articles.filter(a => slugs.includes(a.slug)).map(withUrl);
+    },
+  });
+
+  useWebMCP<{ slug: string }>({
+    name: 'add-to-reading-list',
+    description: 'Saves an article to the reader’s reading list. Does nothing if it is already saved.',
+    inputSchema: {
+      type: 'object',
+      properties: { slug: { type: 'string', description: 'Slug of the article to save.' } },
+      required: ['slug'],
+    },
+    execute: async ({ slug }, { signal }) => {
+      const articles = await fetchArticles(signal);
+      if (typeof slug !== 'string' || !articles.some(a => a.slug === slug)) {
+        return { error: `Unknown article "${slug}".`, availableSlugs: articles.map(a => a.slug) };
+      }
+      let list = await fetchReadingList();
+      if (!list.includes(slug)) {
+        list = await toggleReadingList(slug);
+      }
+      return { slug, saved: true, readingList: list };
+    },
+  });
+
+  useWebMCP<{ slug: string }>({
+    name: 'remove-from-reading-list',
+    description: 'Removes an article from the reader’s reading list. Does nothing if it is not saved.',
+    inputSchema: {
+      type: 'object',
+      properties: { slug: { type: 'string', description: 'Slug of the article to remove.' } },
+      required: ['slug'],
+    },
+    execute: async ({ slug }) => {
+      if (typeof slug !== 'string' || !slug) {
+        return { error: 'Pass the slug of an article on the reading list.' };
+      }
+      let list = await fetchReadingList();
+      if (list.includes(slug)) {
+        list = await toggleReadingList(slug);
+      }
+      return { slug, saved: false, readingList: list };
+    },
+  });
+
+  useWebMCP({
+    name: 'get-article-details',
+    description: 'Returns the headline, author, date, category, reading time and full text of the article currently open.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    enabled: onArticle,
+    execute: () => {
+      const article = currentArticle();
+      if (!article) {
+        return { error: 'No article is open on this page.' };
+      }
+      const text = articleText(article);
+      const words = text ? text.split(/\s+/).length : 0;
+      return {
+        slug: article.dataset.articleSlug,
+        title: article.querySelector('h1')?.textContent?.trim(),
+        summary: article.querySelector('h1 + p')?.textContent?.trim(),
+        byline: article.querySelector('h1 ~ div')?.textContent?.replace(/\s+/g, ' ').trim(),
+        wordCount: words,
+        readingTimeMinutes: Math.max(1, Math.round(words / 230)),
+        text,
+      };
+    },
+  });
+
+  useWebMCP<{ query: string }>({
+    name: 'find-in-article',
+    description: 'Finds passages in the article currently open that mention a phrase, returning each with surrounding context.',
+    inputSchema: {
+      type: 'object',
+      properties: { query: { type: 'string', description: 'Word or phrase to look for; case-insensitive.' } },
+      required: ['query'],
+    },
+    annotations: { readOnlyHint: true },
+    enabled: onArticle,
+    execute: ({ query }) => {
+      const article = currentArticle();
+      if (!article) {
+        return { error: 'No article is open on this page.' };
+      }
+      const needle = typeof query === 'string' ? query.trim().toLowerCase() : '';
+      if (!needle) {
+        return { error: 'Pass a non-empty query.' };
+      }
+      const matches: string[] = [];
+      article.querySelectorAll<HTMLElement>('.prose p, .prose li, .prose h2, .prose h3').forEach(el => {
+        const text = el.innerText.trim();
+        const index = text.toLowerCase().indexOf(needle);
+        if (index !== -1) {
+          const start = Math.max(0, index - 80);
+          matches.push(`${start > 0 ? '…' : ''}${text.slice(start, index + needle.length + 80)}…`);
+        }
+      });
+      return { query, matchCount: matches.length, matches: matches.slice(0, 20) };
+    },
+  });
+
+  useWebMCP({
+    name: 'list-article-headings',
+    description: 'Returns the section headings of the article currently open, in reading order.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    enabled: onArticle,
+    execute: () => {
+      const article = currentArticle();
+      if (!article) {
+        return { error: 'No article is open on this page.' };
+      }
+      return Array.from(article.querySelectorAll<HTMLElement>('.prose h2, .prose h3')).map(h => ({
+        level: Number(h.tagName[1]),
+        text: h.innerText.trim(),
+      }));
+    },
+  });
+
+  return null;
+}
