diff --git a/src/utils/readingList.ts b/src/utils/readingList.ts
new file mode 100644
index 0000000..9c63404
--- /dev/null
+++ b/src/utils/readingList.ts
@@ -0,0 +1,21 @@
+export const READING_LIST_CHANGED = 'reading-list-changed';
+
+const endpoint = () => `${import.meta.env.BASE_URL}api/reading-list.json`;
+
+export async function fetchReadingList(): Promise<string[]> {
+  const response = await fetch(endpoint());
+  const data = await response.json();
+  return data.readingList;
+}
+
+// The API toggles: posting a saved slug removes it, posting an unsaved slug adds it.
+export async function toggleReadingList(slug: string): Promise<string[]> {
+  const response = await fetch(endpoint(), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+  });
+  const data = await response.json();
+  window.dispatchEvent(new CustomEvent(READING_LIST_CHANGED, { detail: data.readingList }));
+  return data.readingList;
+}
