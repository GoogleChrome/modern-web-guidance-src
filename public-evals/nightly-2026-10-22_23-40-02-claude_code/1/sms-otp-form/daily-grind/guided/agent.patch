+  <script>
+    // The SMS sent by the backend must end with an origin-bound line, e.g.:
+    //   Your Daily Grind code is 123456.
+    //
+    //   @<this-domain> #123456
+    const phoneForm = document.getElementById('phone-form');
+    const phoneInput = document.getElementById('phone-input');
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const statusEl = document.getElementById('verify-status');
+    let otpAbortController = null;
+
+    function setStatus(message, isError = false) {
+      statusEl.textContent = message;
+      statusEl.classList.toggle('error', isError);
+    }
+
+    function stopSmsOtpListener() {
+      otpAbortController?.abort();
+      otpAbortController = null;
+    }
+
+    async function startSmsOtpListener() {
+      if (!('OTPCredential' in window)) return;
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+      try {
+        const otp = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: ac.signal });
+        if (!otp) return;
+        otpInput.value = otp.code;
+        otpForm.requestSubmit();
+      } catch (err) {
+        if (err?.name !== 'AbortError') console.error('WebOTP error:', err);
+      }
+    }
+
+    async function post(form, data) {
+      const res = await fetch(form.action, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(data),
+      });
+      if (!res.ok) throw new Error(`Request failed (${res.status})`);
+    }
+
+    async function sendCode() {
+      setStatus('Sending code…');
+      try {
+        await post(phoneForm, { phone: phoneInput.value.trim() });
+      } catch {
+        setStatus('We couldn’t send the code. Check the number and try again.', true);
+        return false;
+      }
+      document.getElementById('sent-to').textContent = phoneInput.value.trim();
+      phoneForm.hidden = true;
+      otpForm.hidden = false;
+      otpInput.value = '';
+      otpInput.focus();
+      setStatus('Code sent.');
+      startSmsOtpListener();
+      return true;
+    }
+
+    phoneForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      sendCode();
+    });
+
+    otpForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      stopSmsOtpListener();
+      setStatus('Verifying…');
+      try {
+        await post(otpForm, { phone: phoneInput.value.trim(), otp: otpInput.value });
+        otpForm.hidden = true;
+        setStatus('Your phone number is verified. Thank you!');
+      } catch {
+        setStatus('That code didn’t work. Check it and try again, or resend a new code.', true);
+        otpInput.select();
+        startSmsOtpListener();
+      }
+    });
+
+    document.getElementById('resend').addEventListener('click', async () => {
+      if (await sendCode()) setStatus('A new code has been sent.');
+    });
+
+    document.getElementById('change-number').addEventListener('click', () => {
+      stopSmsOtpListener();
+      otpForm.hidden = true;
+      phoneForm.hidden = false;
+      phoneInput.focus();
+      setStatus('');
+    });
+  </script>
