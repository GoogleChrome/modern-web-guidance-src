     .btn:hover {
       background: #3e2723;
     }
 
+    /* Spotlight reveal for product cards */
+    @property --inner-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      overflow: hidden;
+      transition: --inner-size 0.4s ease, --outer-size 0.4s ease;
+    }
+
+    .product-card:hover {
+      --inner-size: 90px;
+      --outer-size: 150px;
+    }
+
+    .spotlight {
+      position: absolute;
+      inset: 0;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      padding: 20px;
+      border-radius: inherit;
+      background: var(--accent);
+      color: var(--primary);
+      font-weight: 600;
+      pointer-events: none;
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), #000 var(--inner-size), transparent var(--outer-size));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), #000 var(--inner-size), transparent var(--outer-size));
+    }
+
+    .spotlight small {
+      font-weight: 400;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
     footer {
