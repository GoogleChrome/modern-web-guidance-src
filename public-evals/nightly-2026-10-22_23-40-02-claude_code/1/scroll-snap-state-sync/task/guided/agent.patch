+  <script>
+    (() => {
+      const panel = document.querySelector('.seasonal-panel');
+      const links = [...document.querySelectorAll('.toc-sidebar a')];
+      const sections = [...panel.querySelectorAll('.drink-section')];
+
+      const setActive = (id) => {
+        links.forEach((link) => {
+          if (link.hash === '#' + id) link.setAttribute('aria-current', 'location');
+          else link.removeAttribute('aria-current');
+        });
+      };
+
+      // Smooth scrolling comes from CSS scroll-behavior (disabled for reduced motion)
+      links.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          event.preventDefault();
+          const target = document.getElementById(link.hash.slice(1));
+          panel.scrollTo({
+            top: target.offsetTop - panel.offsetTop,
+            behavior: 'auto' // defers to CSS scroll-behavior
+          });
+          setActive(target.id);
+        });
+      });
+
+      if ('onscrollsnapchange' in HTMLElement.prototype) {
+        panel.addEventListener('scrollsnapchange', (event) => {
+          const section = event.snapTargetBlock?.closest('.drink-section');
+          if (section) setActive(section.id);
+        });
+      } else {
+        // Fallback: the section whose top is nearest the panel's top edge
+        const update = () => {
+          const top = panel.getBoundingClientRect().top;
+          const nearest = sections.reduce((best, s) =>
+            Math.abs(s.getBoundingClientRect().top - top) <
+            Math.abs(best.getBoundingClientRect().top - top) ? s : best);
+          setActive(nearest.id);
+        };
+        new IntersectionObserver(update, { root: panel, threshold: [0, 0.5, 1] })
+          .observe(sections[0]);
+        sections.forEach((s) => new IntersectionObserver(update, { root: panel, threshold: [0.5] }).observe(s));
+      }
+    })();
+  </script>
