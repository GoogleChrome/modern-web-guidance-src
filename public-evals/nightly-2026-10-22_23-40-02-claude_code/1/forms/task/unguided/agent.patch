+  <script>
+    (function () {
+      var form = document.getElementById('signup-form');
+      var steps = Array.prototype.slice.call(form.querySelectorAll('[data-step]'));
+      var crumbs = Array.prototype.slice.call(document.querySelectorAll('#progress li'));
+      var back = document.getElementById('back');
+      var next = document.getElementById('next');
+      var submit = document.getElementById('submit');
+      var summary = document.getElementById('form-summary');
+      var current = 0;
+
+      var messages = {
+        email: { valueMissing: 'Enter your email address.', typeMismatch: 'Enter an email address like name@example.com.' },
+        password: { valueMissing: 'Create a password.', tooShort: 'Your password must be at least 10 characters.' },
+        'given-name': { valueMissing: 'Enter your first name.' },
+        'family-name': { valueMissing: 'Enter your last name.' },
+        'postal-code': { valueMissing: 'Enter your ZIP or postal code.', patternMismatch: 'Enter a valid ZIP or postal code.' },
+        phone: { patternMismatch: 'Enter a valid phone number, e.g. 555 123 4567.' },
+        birthday: { rangeOverflow: 'Birthday cannot be in the future.', rangeUnderflow: 'Enter a valid birthday.', badInput: 'Enter a valid date.' },
+        terms: { valueMissing: 'You must agree to the terms to join.' }
+      };
+
+      // Patterns set here so the form still works if JS fails (server validates regardless)
+      document.getElementById('postal-code').pattern = '[A-Za-z0-9][A-Za-z0-9 \\-]{2,9}';
+      document.getElementById('phone').pattern = '[0-9+()\\-. ]{7,20}';
+      var bday = document.getElementById('birthday');
+      bday.max = new Date().toISOString().slice(0, 10);
+      bday.min = '1900-01-01';
+
+      function errorFor(input) { return document.getElementById(input.id + '-err'); }
+
+      function validateField(input) {
+        var err = errorFor(input);
+        if (!err) return true;
+        var v = input.validity, text = '';
+        if (!v.valid) {
+          var map = messages[input.id] || {};
+          for (var key in map) { if (v[key]) { text = map[key]; break; } }
+          text = text || input.validationMessage;
+        }
+        err.textContent = text;
+        if (text) input.setAttribute('aria-invalid', 'true'); else input.removeAttribute('aria-invalid');
+        return !text;
+      }
+
+      function validateStep(i) {
+        var bad = [];
+        steps[i].querySelectorAll('input, select').forEach(function (el) {
+          if (!validateField(el)) bad.push(el);
+        });
+        if (bad.length) {
+          summary.textContent = 'Please fix ' + bad.length + (bad.length === 1 ? ' error' : ' errors') + ' before continuing.';
+          bad[0].focus();
+          return false;
+        }
+        summary.textContent = '';
+        return true;
+      }
+
+      function show(i, moveFocus) {
+        current = i;
+        steps.forEach(function (s, n) { s.hidden = n !== i; });
+        crumbs.forEach(function (c, n) {
+          if (n === i) c.setAttribute('aria-current', 'step'); else c.removeAttribute('aria-current');
+          c.classList.toggle('done', n < i);
+        });
+        back.hidden = i === 0;
+        next.hidden = i === steps.length - 1;
+        submit.hidden = i !== steps.length - 1;
+        if (moveFocus) {
+          var legend = steps[i].querySelector('legend');
+          legend.tabIndex = -1;
+          legend.focus();
+        }
+      }
+
+      form.querySelectorAll('input, select').forEach(function (el) {
+        el.addEventListener('blur', function () { if (el.value || el.getAttribute('aria-invalid')) validateField(el); });
+        el.addEventListener('input', function () { if (el.getAttribute('aria-invalid')) validateField(el); });
+        el.addEventListener('change', function () { if (el.getAttribute('aria-invalid')) validateField(el); });
+      });
+
+      next.addEventListener('click', function () { if (validateStep(current)) show(current + 1, true); });
+      back.addEventListener('click', function () { summary.textContent = ''; show(current - 1, true); });
+
