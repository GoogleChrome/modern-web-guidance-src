diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..75d957b
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,73 @@
+---
+export interface Props {
+    sections: { id: string; label: string }[];
+}
+
+const { sections } = Astro.props;
+---
+<nav aria-label="Sections on this page" class="section-nav sticky top-0 z-20 bg-white/95 backdrop-blur border-b border-gray-300">
+    <ul class="max-w-6xl mx-auto px-4 sm:px-6 flex gap-6 text-sm font-semibold overflow-x-auto">
+        {sections.map(({ id, label }) => (
+            <li>
+                <a href={`#${id}`} class="block py-2 border-b-2 border-transparent whitespace-nowrap hover:text-gray-600">
+                    {label}
+                </a>
+            </li>
+        ))}
+    </ul>
+</nav>
+
+<style is:global>
+    .section-nav {
+        scroll-target-group: auto;
+    }
+    /* :is() keeps the rule valid in browsers that don't know :target-current */
+    .section-nav a:is(:target-current, [data-current]) {
+        color: #111827;
+        border-bottom-color: #fbbf24;
+    }
+    /* Keep headings clear of the sticky bar when jumping to a section */
+    [data-section] {
+        scroll-margin-top: 3rem;
+    }
+</style>
+
+<script>
+    const nav = document.querySelector<HTMLElement>('.section-nav');
+    if (nav) {
+        const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
+
+        if (CSS.supports('scroll-target-group: auto')) {
+            const syncAriaCurrent = () => {
+                const current = nav.querySelector('a:target-current');
+                links.forEach((link) => {
+                    if (link === current) link.setAttribute('aria-current', 'true');
+                    else link.removeAttribute('aria-current');
+                });
+            };
+            syncAriaCurrent();
+            document.addEventListener('scrollend', syncAriaCurrent);
+        } else {
+            const setCurrent = (id: string) => {
+                links.forEach((link) => {
+                    const active = link.getAttribute('href') === `#${id}`;
+                    link.toggleAttribute('data-current', active);
+                    if (active) link.setAttribute('aria-current', 'true');
+                    else link.removeAttribute('aria-current');
+                });
+            };
+            const observer = new IntersectionObserver(
+                (entries) => {
+                    entries.forEach((entry) => {
+                        if (entry.isIntersecting) setCurrent(entry.target.id);
+                    });
+                },
+                { rootMargin: '-50% 0px -50% 0px', threshold: 0 },
+            );
+            links.forEach((link) => {
+                const target = document.getElementById(link.hash.slice(1));
+                if (target) observer.observe(target);
+            });
+        }
+    }
+</script>
