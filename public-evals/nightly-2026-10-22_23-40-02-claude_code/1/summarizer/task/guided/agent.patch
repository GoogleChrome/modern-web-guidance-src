+  <script>
+    (() => {
+      const btn = document.getElementById('summarize-btn');
+      const status = document.getElementById('summary-status');
+      const box = document.getElementById('summary');
+      const list = document.getElementById('summary-list');
+      const options = { type: 'key-points', format: 'plain-text', length: 'short' };
+
+      const render = (text) => {
+        const items = text.split('\n')
+          .map((line) => line.replace(/^\s*[-*•]\s*/, '').trim())
+          .filter(Boolean);
+        list.replaceChildren(...items.map((item) => {
+          const li = document.createElement('li');
+          li.textContent = item;
+          return li;
+        }));
+      };
+
+      if (!('Summarizer' in self)) {
+        btn.disabled = true;
+        status.textContent = 'Local summarization is currently unsupported in this browser.';
+        return;
+      }
+
+      btn.addEventListener('click', async () => {
+        btn.disabled = true;
+        status.textContent = 'Preparing summarizer…';
+        try {
+          const availability = await Summarizer.availability(options);
+          if (availability === 'unavailable') {
+            status.textContent = 'Local summarization is unavailable on this device.';
+            return;
+          }
+          const summarizer = await Summarizer.create({
+            ...options,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                status.textContent = `Downloading model… ${Math.round(e.loaded * 100)}%`;
+              });
+            },
+          });
+          status.textContent = 'Summarizing…';
+          box.hidden = false;
+          let text = '';
+          for await (const chunk of summarizer.summarizeStreaming(
+            document.getElementById('journal-text').innerText,
+            { context: 'A coffee roaster describing how it sources green coffee beans.' })) {
+            text += chunk;
+            render(text);
+          }
+          summarizer.destroy();
+          status.textContent = '';
+        } catch (err) {
+          console.error(err);
+          status.textContent = 'Sorry, something went wrong while summarizing.';
+        } finally {
+          btn.disabled = false;
+        }
+      });
+    })();
+  </script>
