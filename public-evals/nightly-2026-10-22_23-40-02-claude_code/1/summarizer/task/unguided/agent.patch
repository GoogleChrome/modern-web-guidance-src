+  <script>
+    // Summarize the journal using the browser's built-in Summarizer API.
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const summaryBox = document.getElementById('journal-summary');
+    const journalText = document.getElementById('journal-text');
+
+    function showMessage(message) {
+      summaryBox.textContent = message;
+      summaryBox.hidden = false;
+    }
+
+    function showBullets(markdown) {
+      const items = markdown
+        .split('\n')
+        .map(line => line.replace(/^\s*[-*•]\s+/, '').trim())
+        .filter(Boolean);
+      const list = document.createElement('ul');
+      for (const item of items) {
+        const li = document.createElement('li');
+        li.textContent = item;
+        list.appendChild(li);
+      }
+      summaryBox.replaceChildren(list);
+      summaryBox.hidden = false;
+    }
+
+    if (!('Summarizer' in self)) {
+      summarizeBtn.disabled = true;
+      summarizeBtn.title = 'Your browser does not support built-in AI summarization.';
+      showMessage('Summarizing isn’t available: this browser doesn’t support the built-in Summarizer API.');
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      summarizeBtn.disabled = true;
+      showMessage('Summarizing…');
+      try {
+        const availability = await Summarizer.availability();
+        if (availability === 'unavailable') {
+          showMessage('Summarizing isn’t available on this device.');
+          return;
+        }
+        const summarizer = await Summarizer.create({
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          sharedContext: 'A coffee roaster describing how it sources green coffee beans.',
+          monitor(m) {
+            m.addEventListener('downloadprogress', e => {
+              showMessage(`Downloading AI model… ${Math.round(e.loaded * 100)}%`);
+            });
+          }
+        });
+        const result = await summarizer.summarize(journalText.innerText);
+        summarizer.destroy();
+        showBullets(result);
+      } catch (err) {
+        console.error(err);
+        showMessage('Sorry, we couldn’t summarize the journal right now.');
+      } finally {
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
