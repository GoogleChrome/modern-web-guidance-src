new file mode 100644
index 0000000..4e27926
--- /dev/null
+++ b/styles/components/site-footer.css
@@ -0,0 +1,17 @@
+.site-footer {
+  background: var(--color-secondary);
+  text-align: center;
+  padding: var(--space-6) var(--space-5);
+  margin-block-start: var(--space-6);
+
+  .footer-links {
+    margin-block-end: var(--space-5);
+
+    a {
+      margin-inline: 10px;
+      color: var(--color-text);
+      text-decoration: none;
+      font-size: var(--font-size-sm);
+    }
+  }
+}
diff --git a/styles/components/site-nav.css b/styles/components/site-nav.css
new file mode 100644
index 0000000..a1fa22f
--- /dev/null
+++ b/styles/components/site-nav.css
@@ -0,0 +1,41 @@
+.site-nav {
+  background: var(--color-primary);
+  color: var(--color-text-inverse);
+  padding-block: var(--space-4);
+  padding-inline: var(--gutter-nav);
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  inset-block-start: 0;
+  z-index: var(--z-nav);
+
+  .logo {
+    font-size: var(--font-size-lg);
+    font-weight: bold;
+    letter-spacing: 1px;
+  }
+
+  ul {
+    display: flex;
+    list-style: none;
+    gap: var(--space-5);
+  }
+
+  a {
+    color: inherit;
+    text-decoration: none;
+    font-size: var(--font-size-base);
+    transition: color var(--duration-base);
+
+    &:hover {
+      color: var(--color-accent);
+    }
+  }
+
+  .logout-link {
+    border: 1px solid var(--color-accent);
+    padding: 5px var(--space-3);
+    border-radius: var(--radius-sm);
+  }
+}
diff --git a/styles/layout.css b/styles/layout.css
new file mode 100644
index 0000000..91402a7
--- /dev/null
+++ b/styles/layout.css
@@ -0,0 +1,13 @@
+.container {
+  max-inline-size: var(--content-width);
+  margin-block: var(--space-6);
+  margin-inline: auto;
+  padding-inline: var(--space-5);
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: var(--space-5);
+  margin-block-start: var(--space-5);
+}
diff --git a/styles/main.css b/styles/main.css
new file mode 100644
index 0000000..162da9c
--- /dev/null
+++ b/styles/main.css
@@ -0,0 +1,13 @@
+/* Cascade order is declared once; later layers win regardless of specificity. */
+@layer reset, tokens, base, layout, components, utilities;
+
+@import url("reset.css") layer(reset);
+@import url("tokens.css") layer(tokens);
+@import url("base.css") layer(base);
+@import url("layout.css") layer(layout);
+@import url("components/site-nav.css") layer(components);
+@import url("components/hero.css") layer(components);
+@import url("components/button.css") layer(components);
+@import url("components/card.css") layer(components);
+@import url("components/site-footer.css") layer(components);
+@import url("utilities.css") layer(utilities);
diff --git a/styles/reset.css b/styles/reset.css
new file mode 100644
index 0000000..4a4d954
--- /dev/null
+++ b/styles/reset.css
@@ -0,0 +1,10 @@
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+:where(*) {
+  margin: 0;
+  padding: 0;
+}
diff --git a/styles/tokens.css b/styles/tokens.css
new file mode 100644
index 0000000..d4fdf99
--- /dev/null
+++ b/styles/tokens.css
@@ -0,0 +1,53 @@
+:root {
+  /* Primitive palette */
+  --brown-900: #3e2723;
+  --brown-700: #4e342e;
+  --brown-200: #d7ccc8;
+  --amber-400: #ffab40;
+  --white: #fff;
+  --gray-50: #fafafa;
+  --black: #000;
+
+  /* Semantic colors */
+  --color-primary: var(--brown-700);
+  --color-primary-strong: var(--brown-900);
+  --color-secondary: var(--brown-200);
+  --color-accent: var(--amber-400);
+  --color-text: var(--brown-900);
+  --color-text-inverse: var(--white);
+  --color-surface: var(--white);
+  --color-background: var(--gray-50);
+  --color-overlay: oklch(from var(--black) l c h / 0.5);
+  --color-shadow: oklch(from var(--black) l c h / 0.1);
+
+  /* Typography */
+  --font-body: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
+  --font-size-sm: 0.85rem;
+  --font-size-base: 0.9rem;
+  --font-size-lg: 1.5rem;
+  --font-size-xl: 3rem;
+  --line-height-base: 1.6;
+
+  /* Spacing */
+  --space-1: 0.25rem;
+  --space-2: 0.5rem;
+  --space-3: 0.75rem;
+  --space-4: 1rem;
+  --space-5: 1.25rem;
+  --space-6: 2.5rem;
+
+  /* Shape, elevation, motion */
+  --radius-sm: 4px;
+  --radius-md: 5px;
+  --radius-lg: 8px;
+  --shadow-card: 0 2px 5px var(--color-shadow);
+  --duration-base: 0.3s;
+
+  /* Layout */
+  --content-width: 1100px;
+  --gutter-nav: 5%;
+  --z-nav: 1000;
+
+  /* Media */
+  --hero-image: url("https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80");
+}
