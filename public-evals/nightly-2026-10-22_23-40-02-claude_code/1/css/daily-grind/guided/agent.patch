@@ -0,0 +1,202 @@
+@layer reset, tokens, base, layout, components;
+
+/* Reset: targeted element types only, no universal selector */
+@layer reset {
+  :where(body, h1, h2, h3, p, ul, li, nav, header, main, section, footer, div, a) {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+  }
+
+  :where(ul) {
+    list-style: none;
+  }
+
+  :where(a) {
+    color: inherit;
+    text-decoration: none;
+  }
+}
+
+/* Design tokens, tiered: literal -> semantic -> component */
+@layer tokens {
+  :root {
+    /* Tier 1: literal */
+    --brown-900: #3e2723;
+    --brown-800: #4e342e;
+    --brown-200: #d7ccc8;
+    --amber-400: #ffab40;
+    --white: #fff;
+    --gray-50: #fafafa;
+    --black-a50: rgb(0 0 0 / 0.5);
+    --black-a10: rgb(0 0 0 / 0.1);
+
+    --font-sans: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+
+    --space-xs: 0.3rem;
+    --space-s: 0.625rem;
+    --space-m: 1.25rem;
+    --space-l: 2.5rem;
+
+    --radius-s: 4px;
+    --radius-m: 5px;
+    --radius-l: 8px;
+
+    --duration-fast: 0.3s;
+
+    /* Tier 2: semantic */
+    --color-primary: var(--brown-800);
+    --color-primary-strong: var(--brown-900);
+    --color-secondary: var(--brown-200);
+    --color-accent: var(--amber-400);
+    --color-text: var(--brown-900);
+    --color-text-inverse: var(--white);
+    --color-bg: var(--gray-50);
+    --color-surface: var(--white);
+    --color-overlay: var(--black-a50);
+    --shadow-card: 0 2px 5px var(--black-a10);
+    --content-width: 1100px;
+    --gutter: 5%;
+  }
+}
+
+@layer base {
+  body {
+    font-family: var(--font-sans);
+    line-height: 1.6;
+    color: var(--color-text);
+    background-color: var(--color-bg);
+  }
+}
+
+@layer layout {
+  .container {
+    max-inline-size: var(--content-width);
+    margin-block: var(--space-l);
+    margin-inline: auto;
+    padding-inline: var(--space-m);
+
+    h2 {
+      text-align: center;
+    }
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+    gap: var(--space-m);
+    margin-block-start: var(--space-m);
+  }
+}
+
+@layer components {
+  /* Shared transition for interactive links */
+  :where(nav a, .btn) {
+    transition: color var(--duration-fast), background var(--duration-fast);
+  }
+
+  nav {
+    background: var(--color-primary);
+    color: var(--color-text-inverse);
+    padding-block: 1rem;
+    padding-inline: var(--gutter);
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    position: sticky;
+    inset-block-start: 0;
+    z-index: 1000;
+
+    .logo {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    ul {
+      display: flex;
+      gap: var(--space-m);
+    }
+
+    a {
+      font-size: 0.9rem;
+
+      &:hover {
+        color: var(--color-accent);
+      }
+    }
+
+    .logout-link {
+      border: 1px solid var(--color-accent);
+      padding-block: 5px;
+      padding-inline: 12px;
+      border-radius: var(--radius-s);
+    }
+  }
+
+  .hero {
+    block-size: 60vh;
+    background: linear-gradient(var(--color-overlay), var(--color-overlay)),
+      url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80')
+      center / cover;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    color: var(--color-text-inverse);
+    text-align: center;
+    padding-inline: var(--space-m);
+
+    h1 {
+      font-size: 3rem;
+      margin-block-end: 1rem;
+    }
+  }
+
+  .card {
+    background: var(--color-surface);
+    padding: var(--space-m);
+    border-radius: var(--radius-l);
+    box-shadow: var(--shadow-card);
+    text-align: center;
+
+    h3 {
+      margin-block-end: var(--space-s);
+      color: var(--color-primary);
+    }
+  }
+
+  .btn {
+    --btn-bg: var(--color-primary);
+
+    display: inline-block;
+    background: var(--btn-bg);
+    color: var(--color-text-inverse);
+    padding-block: var(--space-s);
+    padding-inline: var(--space-m);
+    border-radius: var(--radius-m);
+    margin-block-start: 15px;
+
+    &:hover {
+      --btn-bg: var(--color-primary-strong);
+    }
+  }
+
+  footer {
+    background: var(--color-secondary);
+    text-align: center;
+    padding-block: var(--space-l);
+    padding-inline: var(--space-m);
+    margin-block-start: var(--space-l);
+
+    .footer-links {
+      margin-block-end: var(--space-m);
+
+      a {
+        margin-inline: var(--space-s);
+        color: var(--color-text);
+        font-size: 0.85rem;
+      }
+    }
+  }
+}
