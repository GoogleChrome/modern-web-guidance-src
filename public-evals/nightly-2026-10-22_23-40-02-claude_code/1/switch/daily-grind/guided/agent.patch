       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Switch */
+    .preferences {
+      max-width: 420px;
+      margin: 40px auto 0;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .switch-field {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 16px;
+      cursor: pointer;
+    }
+
+    .switch-hint {
+      font-size: 0.85rem;
+      opacity: 0.8;
+    }
+
+    input[type="checkbox"][switch] {
+      accent-color: var(--primary);
+      margin: 0;
+      cursor: pointer;
+    }
+
+    input[type="checkbox"][switch]:focus-visible {
+      outline: 3px solid #ff8c00;
+      outline-offset: 4px;
+    }
+
+    /* Fallback for browsers without native `switch` support (set via script) */
+    input.switch-fallback {
+      appearance: none;
+      flex: none;
+      width: 3rem;
+      height: 1.6rem;
+      border: 2px solid var(--primary);
+      border-radius: 1rem;
+      background: var(--light);
+      position: relative;
+      transition: background 0.2s;
+    }
+
+    input.switch-fallback::before {
+      content: "";
+      position: absolute;
+      inset-block: 2px;
+      inset-inline-start: 2px;
+      aspect-ratio: 1;
+      border-radius: 50%;
+      background: var(--primary);
+      transition: transform 0.2s, background 0.2s;
+    }
+
+    input.switch-fallback:checked {
+      background: var(--primary);
+    }
+
+    input.switch-fallback:checked::before {
+      background: var(--light);
+      transform: translateX(1.4rem);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      input.switch-fallback,
+      input.switch-fallback::before {
+        transition: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      input.switch-fallback:checked {
+        background: Highlight;
+      }
+
+      input.switch-fallback::before {
+        background: ButtonText;
+      }
+
+      input.switch-fallback:checked::before {
+        background: HighlightText;
+      }
+    }
   </style>
