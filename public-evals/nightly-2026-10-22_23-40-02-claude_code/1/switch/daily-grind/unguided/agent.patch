+  <script>
+    (function () {
+      var toggle = document.getElementById('alerts-switch');
+      var status = document.getElementById('alerts-status');
+      var label = document.getElementById('alerts-label');
+
+      function set(on) {
+        toggle.setAttribute('aria-checked', String(on));
+        status.textContent = on ? 'On' : 'Off';
+      }
+
+      // Native <button> handles Space/Enter; clicking the label also toggles.
+      toggle.addEventListener('click', function () {
+        set(toggle.getAttribute('aria-checked') !== 'true');
+      });
+      label.addEventListener('click', function () {
+        toggle.click();
+        toggle.focus();
+      });
+    })();
+  </script>
