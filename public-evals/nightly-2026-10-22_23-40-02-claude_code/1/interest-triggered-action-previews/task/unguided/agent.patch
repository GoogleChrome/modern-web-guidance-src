+    }
+
+    #seasonal-preview .preview-default {
+      color: #6d4c41;
+    }
+
+    #seasonal-preview:has(:popover-open) .preview-default {
+      display: none;
+    }
+
+    #seasonal-preview .preview-item {
+      position: static;
+      inset: auto;
+      width: auto;
+      height: auto;
+      margin: 0;
+      padding: 0;
+      border: 0;
+      background: none;
+      overflow: visible;
+      font-weight: bold;
+    }
+
+    #seasonal-preview .preview-item:not(:popover-open) {
+      display: none;
+    }
+
+    #seasonal-preview .preview-item:popover-open {
+      display: block;
+    }
