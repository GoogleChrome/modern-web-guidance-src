+
+  <script>
+    const BEANS = [
+      { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', note: 'Floral, citrus' },
+      { id: 'colombia', name: 'Colombia Huila', note: 'Caramel, red apple' },
+      { id: 'sumatra', name: 'Sumatra Mandheling', note: 'Earthy, dark chocolate' },
+      { id: 'guatemala', name: 'Guatemala Antigua', note: 'Cocoa, spice' },
+      { id: 'kenya', name: 'Kenya AA', note: 'Blackcurrant, bright' },
+      { id: 'brazil', name: 'Brazil Santos', note: 'Nutty, smooth' },
+    ];
+
+    const available = document.getElementById('available-beans');
+    const selectedList = document.getElementById('selected-beans');
+    const count = document.getElementById('bean-count');
+    const selected = new Set();
+
+    // Each card is created once and moved between lists, so it keeps focus
+    // and its unique view-transition-name across states.
+    const cards = new Map(BEANS.map(bean => {
+      const li = document.createElement('li');
+      li.className = 'bean';
+      li.style.viewTransitionName = `bean-${bean.id}`;
+
+      const text = document.createElement('div');
+      const title = document.createElement('strong');
+      title.textContent = bean.name;
+      const note = document.createElement('small');
+      note.textContent = bean.note;
+      text.append(title, note);
+
+      const button = document.createElement('button');
+      button.type = 'button';
+      button.dataset.id = bean.id;
+
+      li.append(text, button);
+      return [bean.id, { li, button, name: bean.name }];
+    }));
+
+    function render() {
+      for (const bean of BEANS) {
+        const { li, button, name } = cards.get(bean.id);
+        const isSelected = selected.has(bean.id);
+        (isSelected ? selectedList : available).append(li);
+        button.textContent = isSelected ? 'Remove' : 'Add';
+        button.setAttribute('aria-label', `${isSelected ? 'Remove' : 'Add'} ${name}`);
+      }
+      count.textContent = selected.size;
+    }
+
+    function toggle(id) {
+      if (selected.has(id)) selected.delete(id);
+      else selected.add(id);
+
+      if (document.startViewTransition) {
+        document.startViewTransition(render);
+      } else {
+        render();
+      }
+    }
+
+    document.querySelector('.bean-board').addEventListener('click', event => {
+      const button = event.target.closest('.bean button');
+      if (button) toggle(button.dataset.id);
+    });
+
+    render();
+  </script>
 </body>
 
