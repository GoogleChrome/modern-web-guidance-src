+  <script>
+    const BEANS = [
+      { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', note: 'Floral · Light roast', color: '#a1704a' },
+      { id: 'colombia', name: 'Colombia Huila', note: 'Caramel · Medium roast', color: '#7b4a2d' },
+      { id: 'guatemala', name: 'Guatemala Antigua', note: 'Cocoa · Medium roast', color: '#6a3f27' },
+      { id: 'sumatra', name: 'Sumatra Mandheling', note: 'Earthy · Dark roast', color: '#47281a' },
+      { id: 'brazil', name: 'Brazil Santos', note: 'Nutty · Medium-dark roast', color: '#58341f' },
+      { id: 'kenya', name: 'Kenya AA', note: 'Berry · Light roast', color: '#946040' },
+    ];
+
+    const selected = new Set();
+    const lists = {
+      selected: document.getElementById('selected-beans'),
+      available: document.getElementById('available-beans'),
+    };
+    const countEl = document.getElementById('bean-count');
+
+    // One element per bean, reused across renders so it can move between lists.
+    const elements = new Map(BEANS.map(bean => [bean.id, createBeanElement(bean)]));
+
+    function createBeanElement(bean) {
+      const li = document.createElement('li');
+      li.className = 'bean';
+      li.dataset.id = bean.id;
+      // Unique name per bean pairs its old and new position; the shared
+      // view-transition-class (in CSS) styles them all as one group.
+      li.style.viewTransitionName = `bean-${bean.id}`;
+      li.style.setProperty('--roast', bean.color);
+      li.innerHTML = `
+        <div class="bean-swatch"></div>
+        <div class="bean-info">${bean.name}<span>${bean.note}</span></div>
+        <button type="button" class="bean-toggle"></button>`;
+      return li;
+    }
+
+    function render() {
+      for (const bean of BEANS) {
+        const li = elements.get(bean.id);
+        const isSelected = selected.has(bean.id);
+        const button = li.querySelector('button');
+        button.textContent = isSelected ? '−' : '+';
+        button.setAttribute('aria-label', `${isSelected ? 'Remove' : 'Add'} ${bean.name}`);
+        // Appending in catalog order keeps both lists stable.
+        (isSelected ? lists.selected : lists.available).append(li);
+      }
+      countEl.textContent = `${selected.size} of ${BEANS.length} selected`;
+    }
+
+    function toggle(id) {
+      selected.has(id) ? selected.delete(id) : selected.add(id);
+      if (!document.startViewTransition) return render();
+      // Single transition: every bean that moved animates simultaneously.
+      document.startViewTransition(render);
+    }
+
+    document.querySelector('.bean-section').addEventListener('click', event => {
+      const button = event.target.closest('.bean-toggle');
+      if (button) toggle(button.closest('.bean').dataset.id);
+    });
+
+    render();
+  </script>
