+  <script>
+    (() => {
+      const hero = document.getElementById('hero');
+      const canvas = document.getElementById('hero-canvas');
+      if (!hero || !canvas || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+
+      const gl = canvas.getContext('webgl', { alpha: false, antialias: false });
+      if (!gl) return;
+
+      const IMG_URL = 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80';
+      const MAX_RIPPLES = 8;
+      const BTN_COLOR = '#4e342e';
+      const BTN_HOVER = '#3e2723';
+
+      const VERT = `
+        attribute vec2 p;
+        varying vec2 uv;
+        void main() { uv = p * 0.5 + 0.5; gl_Position = vec4(p, 0.0, 1.0); }`;
+
+      const FRAG = `
+        precision highp float;
+        varying vec2 uv;
+        uniform sampler2D tex;
+        uniform float time;
+        uniform float aspect;
+        uniform vec4 ripples[${MAX_RIPPLES}]; // x, y, startTime, strength
+        void main() {
+          vec2 off = vec2(0.0);
+          // gentle ambient swell
+          off += 0.0015 * vec2(sin(uv.y * 14.0 + time * 0.9), cos(uv.x * 11.0 + time * 0.7));
+          for (int i = 0; i < ${MAX_RIPPLES}; i++) {
+            vec4 r = ripples[i];
+            if (r.w <= 0.0) continue;
+            float t = time - r.z;
+            if (t < 0.0 || t > 3.0) continue;
+            vec2 d = uv - r.xy;
+            d.x *= aspect;
+            float dist = length(d);
+            float front = t * 0.45;
+            float band = exp(-pow((dist - front) * 7.0, 2.0));
+            float wave = sin((dist - front) * 55.0) * band;
+            float fade = (1.0 - t / 3.0);
+            vec2 dir = dist > 0.0001 ? d / dist : vec2(0.0);
+            dir.x /= aspect;
+            off += dir * wave * fade * fade * 0.02 * r.w;
+          }
+          vec3 c = texture2D(tex, uv + off).rgb;
+          // subtle specular sheen on the wave crests
+          c += (abs(off.x) + abs(off.y)) * 1.5;
+          gl_FragColor = vec4(c, 1.0);
+        }`;
+
+      const sh = (type, src) => {
+        const s = gl.createShader(type);
+        gl.shaderSource(s, src);
+        gl.compileShader(s);
+        if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s));
+        return s;
+      };
+
+      let prog;
+      try {
+        prog = gl.createProgram();
+        gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
+        gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
+        gl.linkProgram(prog);
+        if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog));
+      } catch (e) {
+        console.warn('Hero shader unavailable', e);
+        return;
+      }
+      gl.useProgram(prog);
+
+      const buf = gl.createBuffer();
+      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
+      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
+      const loc = gl.getAttribLocation(prog, 'p');
+      gl.enableVertexAttribArray(loc);
+      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
+
+      const u = {
+        tex: gl.getUniformLocation(prog, 'tex'),
+        time: gl.getUniformLocation(prog, 'time'),
+        aspect: gl.getUniformLocation(prog, 'aspect'),
+        ripples: gl.getUniformLocation(prog, 'ripples')
+      };
+
+      const texture = gl.createTexture();
+      gl.bindTexture(gl.TEXTURE_2D, texture);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+      gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
+      gl.uniform1i(u.tex, 0);
+
+      // 2D canvas that mirrors the hero's DOM look; uploaded as the shader texture.
+      const src = document.createElement('canvas');
+      const ctx = src.getContext('2d');
+      const img = new Image();
+      img.crossOrigin = 'anonymous';
+
+      let dpr = 1, cssW = 0, cssH = 0, ready = false;
+      const ripples = new Float32Array(MAX_RIPPLES * 4);
+      let nextRipple = 0;
+      const now = () => performance.now() / 1000;
+
+      function drawText(el, rect0) {
+        const cs = getComputedStyle(el);
+        // color is transparent in GL mode, so pick it from the original design
+        ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
+        ctx.textBaseline = 'alphabetic';
+        const node = el.firstChild;
+        if (!node || node.nodeType !== 3) return;
+        const words = node.textContent.split(/(\s+)/);
+        const range = document.createRange();
+        let idx = 0, line = null;
+        const lines = [];
+        for (const w of words) {
+          if (w.trim()) {
+            range.setStart(node, idx);
+            range.setEnd(node, idx + w.length);
+            const r = range.getBoundingClientRect();
+            if (!line || Math.abs(r.top - line.top) > 2) {
+              line = { top: r.top, left: r.left, text: w };
+              lines.push(line);
+            } else {
+              line.text += ' ' + w;
+            }
+          }
+          idx += w.length;
+        }
+        for (const l of lines) {
+          const m = ctx.measureText(l.text);
+          ctx.fillText(l.text, l.left - rect0.left, l.top - rect0.top + (m.fontBoundingBoxAscent || parseFloat(cs.fontSize) * 0.9));
+        }
+      }
+
+      function paintSource() {
+        const rect = hero.getBoundingClientRect();
+        cssW = rect.width; cssH = rect.height;
+        dpr = Math.min(window.devicePixelRatio || 1, 2);
+        const w = Math.max(1, Math.round(cssW * dpr)), h = Math.max(1, Math.round(cssH * dpr));
+        src.width = canvas.width = w;
+        src.height = canvas.height = h;
+        gl.viewport(0, 0, w, h);
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+
+        // background-size: cover, centered
+        const s = Math.max(cssW / img.naturalWidth, cssH / img.naturalHeight);
+        const iw = img.naturalWidth * s, ih = img.naturalHeight * s;
+        ctx.drawImage(img, (cssW - iw) / 2, (cssH - ih) / 2, iw, ih);
+        ctx.fillStyle = 'rgba(0,0,0,0.5)';
+        ctx.fillRect(0, 0, cssW, cssH);
+
+        // button
+        const btn = hero.querySelector('.btn');
+        if (btn) {
+          const b = btn.getBoundingClientRect();
+          const cs = getComputedStyle(btn);
+          const rad = parseFloat(cs.borderTopLeftRadius) || 0;
+          ctx.fillStyle = btn.matches(':hover') ? BTN_HOVER : BTN_COLOR;
+          ctx.beginPath();
+          ctx.roundRect(b.left - rect.left, b.top - rect.top, b.width, b.height, rad);
+          ctx.fill();
+        }
+
+        ctx.fillStyle = '#fff';
+        hero.querySelectorAll('h1, p, .btn').forEach(el => drawText(el, rect));
+
+        gl.activeTexture(gl.TEXTURE0);
+        gl.bindTexture(gl.TEXTURE_2D, texture);
+        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, src);
+        gl.uniform1f(u.aspect, cssW / cssH);
+      }
+
+      function addRipple(clientX, clientY, strength) {
+        const r = hero.getBoundingClientRect();
+        const i = nextRipple++ % MAX_RIPPLES * 4;
+        ripples[i] = (clientX - r.left) / r.width;
+        ripples[i + 1] = 1 - (clientY - r.top) / r.height;
+        ripples[i + 2] = now();
+        ripples[i + 3] = strength;
+        start();
+      }
+
+      let raf = 0, visible = true;
+      function frame() {
+        raf = 0;
+        if (!ready || !visible) return;
+        gl.uniform1f(u.time, now());
+        gl.uniform4fv(u.ripples, ripples);
+        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
+        raf = requestAnimationFrame(frame);
+      }
+      function start() { if (!raf) raf = requestAnimationFrame(frame); }
+
+      // Interaction: listeners live on the hero, so text selection and clicks are untouched.
+      let lastX = -1e9, lastY = -1e9;
+      hero.addEventListener('pointermove', e => {
+        if (Math.hypot(e.clientX - lastX, e.clientY - lastY) < 70) return;
+        lastX = e.clientX; lastY = e.clientY;
+        addRipple(e.clientX, e.clientY, 0.6);
+      });
+      hero.addEventListener('pointerdown', e => addRipple(e.clientX, e.clientY, 1.4));
+
+      const btn = hero.querySelector('.btn');
+      if (btn) ['mouseenter', 'mouseleave'].forEach(ev => btn.addEventListener(ev, () => ready && paintSource()));
+
+      new ResizeObserver(() => ready && paintSource()).observe(hero);
+      new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) start(); }).observe(hero);
+
+      img.onload = async () => {
+        try { await document.fonts.ready; } catch (_) {}
+        try {
+          hero.classList.add('gl');
+          ready = true;
+          paintSource();
+          // idle intro ripple from the centre
+          const r = hero.getBoundingClientRect();
+          addRipple(r.left + r.width / 2, r.top + r.height / 2, 1.2);
+        } catch (e) {
+          console.warn('Hero shader disabled', e);
+          ready = false;
+          hero.classList.remove('gl');
+          canvas.remove();
+        }
+      };
+      img.onerror = () => canvas.remove();
+      img.src = IMG_URL;
+    })();
+  </script>
+
 </body>
 
 </html>
