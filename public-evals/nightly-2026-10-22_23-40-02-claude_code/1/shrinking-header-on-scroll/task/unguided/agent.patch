+  <script>
+    // Fallback for browsers without CSS scroll-driven animations:
+    // drive the same --nav-progress variable from the scroll position.
+    (function () {
+      if (window.CSS && CSS.supports && CSS.supports('animation-timeline: scroll()')) return;
+      var nav = document.querySelector('nav');
+      var range = 120, ticking = false;
+      function update() {
+        var y = window.pageYOffset || document.documentElement.scrollTop || 0;
+        nav.style.setProperty('--nav-progress', Math.min(Math.max(y / range, 0), 1));
+        ticking = false;
+      }
+      function onScroll() {
+        if (ticking) return;
+        ticking = true;
+        (window.requestAnimationFrame || function (f) { return setTimeout(f, 16); })(update);
+      }
+      window.addEventListener('scroll', onScroll, { passive: true });
+      update();
+    })();
+  </script>
