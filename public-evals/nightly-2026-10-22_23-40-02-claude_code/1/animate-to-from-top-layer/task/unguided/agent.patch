+    <span>online ordering is currently offline</span>
+    <button type="button" id="info-overlay-close" aria-label="Dismiss">&times;</button>
+  </div>
+
+  <script>
+    const dialog = document.getElementById('logout-dialog');
+
+    document.getElementById('open-dialog-btn').addEventListener('click', (e) => {
+      e.preventDefault();
+      dialog.classList.remove('closing');
+      dialog.showModal();
+    });
+
+    function closeDialog() {
+      if (!dialog.open || dialog.classList.contains('closing')) return;
+      dialog.classList.add('closing');
+      dialog.addEventListener('animationend', function done(e) {
+        if (e.target !== dialog) return;
+        dialog.removeEventListener('animationend', done);
+        dialog.classList.remove('closing');
+        dialog.close();
+      });
+    }
+
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+    // Esc: run the exit animation instead of closing instantly
+    dialog.addEventListener('cancel', (e) => {
+      e.preventDefault();
+      closeDialog();
+    });
+    // Click on backdrop
+    dialog.addEventListener('click', (e) => {
+      if (e.target === dialog) closeDialog();
+    });
+
+    const overlay = document.getElementById('info-overlay');
+    document.getElementById('foobar').addEventListener('click', () => overlay.classList.add('visible'));
+    document.getElementById('info-overlay-close').addEventListener('click', () => overlay.classList.remove('visible'));
+  </script>
