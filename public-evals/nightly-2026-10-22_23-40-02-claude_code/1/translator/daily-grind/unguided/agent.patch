+  <script>
+    // On-device translation using the browser's built-in Translator API.
+    // Text never leaves the device; the language model is downloaded once by the browser.
+    (function () {
+      const select = document.getElementById('lang-select');
+      const status = document.getElementById('lang-status');
+      const nodes = Array.from(document.querySelectorAll('[data-translate]'));
+      const originals = nodes.map(function (el) { return el.textContent; });
+      const cache = {};
+      let requestId = 0;
+
+      if (!('Translator' in self)) {
+        select.disabled = true;
+        select.title = 'On-device translation is not supported in this browser';
+        status.textContent = 'On-device translation is not available in this browser (try a recent version of Chrome).';
+        return;
+      }
+
+      function restore() {
+        nodes.forEach(function (el, i) { el.textContent = originals[i]; });
+        document.documentElement.lang = 'en';
+      }
+
+      async function getTranslator(lang) {
+        if (!cache[lang]) {
+          cache[lang] = Translator.create({
+            sourceLanguage: 'en',
+            targetLanguage: lang,
+            monitor: function (m) {
+              m.addEventListener('downloadprogress', function (e) {
+                status.textContent = 'Downloading language pack… ' + Math.round(e.loaded * 100) + '%';
+              });
+            }
+          });
+        }
+        return cache[lang];
+      }
+
+      select.addEventListener('change', async function () {
+        const lang = select.value;
+        const id = ++requestId;
+        if (lang === 'en') {
+          restore();
+          status.textContent = '';
+          return;
+        }
+        select.disabled = true;
+        try {
+          const availability = await Translator.availability({ sourceLanguage: 'en', targetLanguage: lang });
+          if (availability === 'unavailable') throw new Error('unsupported');
+          status.textContent = 'Translating…';
+          const translator = await getTranslator(lang);
+          const results = await Promise.all(originals.map(function (t) { return translator.translate(t); }));
+          if (id !== requestId) return;
+          nodes.forEach(function (el, i) { el.textContent = results[i]; });
+          document.documentElement.lang = lang;
+          status.textContent = '';
+        } catch (err) {
+          delete cache[lang];
+          restore();
+          select.value = 'en';
+          status.textContent = 'Sorry, ' + select.querySelector('option[value="' + lang + '"]').textContent + ' translation isn\'t available on this device.';
+        } finally {
+          select.disabled = false;
+        }
+      });
+    })();
+  </script>
+
