+<script>
+    (() => {
+      const picker = document.querySelector('.lang-picker');
+      const select = document.getElementById('lang-select');
+      const status = document.getElementById('lang-status');
+      const nodes = [...document.querySelectorAll('[data-translate]')];
+      const SOURCE = 'en';
+      const originals = nodes.map((el) => el.textContent);
+      const cache = new Map(); // target language -> translated strings
+      let requestId = 0;
+
+      // Translator is only available in some desktop browsers; hide the control elsewhere.
+      if (!('Translator' in self)) return;
+      picker.hidden = false;
+
+      function apply(lang, texts) {
+        document.documentElement.lang = lang;
+        nodes.forEach((el, i) => {
+          el.textContent = texts[i];
+          el.lang = lang;
+        });
+        status.textContent = '';
+      }
+
+      async function translateAll(target) {
+        const options = { sourceLanguage: SOURCE, targetLanguage: target };
+        const availability = await Translator.availability(options);
+        if (availability === 'unavailable') {
+          throw new Error('unavailable');
+        }
+        const translator = await Translator.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              status.textContent = `Downloading language pack… ${Math.round(e.loaded * 100)}%`;
+            });
+          },
+        });
+        try {
+          return await Promise.all(originals.map((text) => translator.translate(text)));
+        } finally {
+          translator.destroy();
+        }
+      }
+
+      select.addEventListener('change', async () => {
+        const target = select.value;
+        const id = ++requestId;
+        if (target === SOURCE) {
+          apply(SOURCE, originals);
+          return;
+        }
+        try {
+          status.textContent = 'Translating…';
+          if (!cache.has(target)) cache.set(target, await translateAll(target));
+          if (id === requestId) apply(target, cache.get(target));
+        } catch (err) {
+          if (id !== requestId) return;
+          status.textContent = err.name === 'NotAllowedError'
+            ? 'Please select the language again to start the language pack download.'
+            : 'Sorry, this language isn\u2019t available for on-device translation.';
+          select.value = document.documentElement.lang;
+        }
+      });
+    })();
+  </script>
