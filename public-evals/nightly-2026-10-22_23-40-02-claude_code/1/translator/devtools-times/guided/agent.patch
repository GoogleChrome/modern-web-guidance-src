diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..8775f21
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,149 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+
+const SOURCE_LANGUAGE = 'en';
+const TARGET_LANGUAGES = [
+  'ar', 'bn', 'zh', 'zh-Hant', 'cs', 'da', 'nl', 'fi', 'fr', 'de', 'el', 'he', 'hi', 'hu', 'id',
+  'it', 'ja', 'ko', 'no', 'pl', 'pt', 'ro', 'ru', 'es', 'sv', 'th', 'tr', 'uk', 'vi',
+];
+const SELECTOR = '[data-translatable]';
+
+type Status = 'idle' | 'checking' | 'downloading' | 'translating' | 'done' | 'unavailable' | 'error';
+
+// Original text of every text node we touched, so translation can be reverted or redone from the source.
+const originals = new Map<Text, string>();
+const originalLangs = new Map<Element, string | null>();
+
+function getTextNodes(): Text[] {
+  const nodes: Text[] = [];
+  document.querySelectorAll(SELECTOR).forEach((root) => {
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+      if (n.textContent?.trim()) nodes.push(n as Text);
+    }
+  });
+  return nodes;
+}
+
+function restore() {
+  originals.forEach((text, node) => {
+    node.textContent = text;
+  });
+  originals.clear();
+  originalLangs.forEach((lang, el) => {
+    if (lang === null) el.removeAttribute('lang');
+    else el.setAttribute('lang', lang);
+  });
+  originalLangs.clear();
+}
+
+export default function TranslateControl() {
+  const [supported, setSupported] = useState(false);
+  const [target, setTarget] = useState('');
+  const [status, setStatus] = useState<Status>('idle');
+  const [progress, setProgress] = useState(0);
+  const [names, setNames] = useState<Intl.DisplayNames | null>(null);
+  const runId = useRef(0);
+
+  useEffect(() => {
+    setSupported('Translator' in self);
+    setNames(new Intl.DisplayNames(navigator.languages, { type: 'language' }));
+    // The header is re-rendered on every navigation, so nothing is translated on a fresh page.
+    return () => {
+      runId.current++;
+      originals.clear();
+      originalLangs.clear();
+    };
+  }, []);
+
+  const translate = async (language: string) => {
+    const id = ++runId.current;
+    setTarget(language);
+    setProgress(0);
+
+    if (!language) {
+      restore();
+      setStatus('idle');
+      return;
+    }
+
+    try {
+      const options = { sourceLanguage: SOURCE_LANGUAGE, targetLanguage: language };
+      setStatus('checking');
+      const availability = await Translator.availability(options);
+      if (id !== runId.current) return;
+      if (availability === 'unavailable') {
+        setStatus('unavailable');
+        return;
+      }
+
+      // create() runs inside the click/change gesture handler's async chain; downloads need that user activation.
+      if (availability !== 'available') setStatus('downloading');
+      const translator = await Translator.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => setProgress(e.loaded));
+        },
+      });
+      if (id !== runId.current) {
+        translator.destroy();
+        return;
+      }
+
+      setStatus('translating');
+      for (const node of getTextNodes()) {
+        if (!originals.has(node)) originals.set(node, node.textContent ?? '');
+        const parent = node.parentElement?.closest(SELECTOR);
+        if (parent && !originalLangs.has(parent)) originalLangs.set(parent, parent.getAttribute('lang'));
+        const result = await translator.translate(originals.get(node)!);
+        if (id !== runId.current) {
+          translator.destroy();
+          return;
+        }
+        node.textContent = result;
+        parent?.setAttribute('lang', language);
+      }
+      translator.destroy();
+      setStatus('done');
+    } catch (error) {
+      if (id !== runId.current) return;
+      console.error('Translation failed', error);
+      restore();
+      setStatus('error');
+    }
+  };
+
+  if (!supported) return null;
+
+  const busy = status === 'checking' || status === 'downloading' || status === 'translating';
+
+  return (
+    <div className="flex items-center gap-1 text-xs text-gray-700">
+      <label htmlFor="translate-language" className="flex items-center gap-1">
+        <LanguageIcon className="h-5 w-5" aria-hidden="true" />
+        <span className="sr-only sm:not-sr-only">Translate</span>
+      </label>
+      <select
+        id="translate-language"
+        value={target}
+        onChange={(e) => translate(e.target.value)}
+        className="rounded border border-gray-300 bg-white px-1 py-1 max-w-32"
+      >
+        <option value="">Original (English)</option>
+        {TARGET_LANGUAGES.map((code) => (
+          <option key={code} value={code}>
+            {names?.of(code) ?? code}
+          </option>
+        ))}
+      </select>
+      <span role="status" aria-live="polite" className="text-gray-500 hidden md:inline">
+        {status === 'checking' && 'Checking…'}
+        {status === 'downloading' && `Downloading language pack… ${Math.round(progress * 100)}%`}
+        {status === 'translating' && 'Translating…'}
+        {status === 'unavailable' && 'This language pair isn’t available on your device.'}
+        {status === 'error' && 'Translation failed.'}
+      </span>
+      {busy && <span className="sr-only">Working</span>}
+    </div>
+  );
+}
