+  <script>
+    (function () {
+      var scroller = document.querySelector('.reviews-scroll');
+      var top = document.querySelector('.indicator-top');
+      var bottom = document.querySelector('.indicator-bottom');
+
+      function update() {
+        var canScrollDown = scroller.scrollTop + scroller.clientHeight < scroller.scrollHeight - 1;
+        top.classList.toggle('visible', scroller.scrollTop > 0);
+        bottom.classList.toggle('visible', canScrollDown);
+      }
+
+      scroller.addEventListener('scroll', update, { passive: true });
+      window.addEventListener('resize', update);
+      update();
+    })();
+  </script>
