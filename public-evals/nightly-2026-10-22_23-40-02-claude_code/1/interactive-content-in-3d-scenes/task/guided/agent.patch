+      }).observe(canvas, 'devicePixelContentBoxSize' in ResizeObserverEntry.prototype
+        ? { box: 'device-pixel-content-box' } : {});
+
+      const getElementImageSize = () => {
+        let img;
+        try {
+          img = canvas.captureElementImage(form);
+        } catch (err) {
+          canvas.requestPaint(); // No paint record yet: retry on the next paint
+          return null;
+        }
+        const width = Math.ceil(img.width), height = Math.ceil(img.height);
+        img.close();
+        return width > 0 && height > 0 ? { width, height } : null;
+      };
+
+      const uploadForm = () => {
+        const s = getElementImageSize();
+        if (!s) return;
+        gl.bindTexture(gl.TEXTURE_2D, texture);
+        if (textureState.width !== s.width || textureState.height !== s.height) {
+          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, s.width, s.height, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+          textureState.width = s.width;
+          textureState.height = s.height;
+        }
+        gl.texElementSubImage2D(gl.TEXTURE_2D, 0, 0, 0, form, { width: s.width, height: s.height });
+        textureReady = true;
+      };
+
+      // Maps the form's border box (CSS px) to the canvas (CSS px) for a unit quad drawn with mvp
+      const computeCanvasTransform = (mvp) => {
+        const toGLModel = new DOMMatrix()
+          .scale(1 / form.offsetWidth, -1 / form.offsetHeight, 1 / form.offsetHeight)
+          .translate(-form.offsetWidth / 2, -form.offsetHeight / 2);
+        const toCanvas = new DOMMatrix()
+          .translate(canvas.clientWidth / 2, canvas.clientHeight / 2)
+          .scale(canvas.clientWidth / 2, -canvas.clientHeight / 2, canvas.clientHeight / 2);
+        return toCanvas.multiply(new DOMMatrix(Array.from(mvp))).multiply(toGLModel);
+      };
+
+      // Pause the spin while the user is interacting with the form
+      let interacting = false, angle = -0.35, last = performance.now();
+      form.addEventListener('pointerenter', () => { interacting = true; });
+      form.addEventListener('pointerleave', () => { interacting = form.matches(':focus-within'); });
+      form.addEventListener('focusin', () => { interacting = true; });
+      form.addEventListener('focusout', () => { interacting = form.matches(':hover'); });
+
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+      canvas.onpaint = (event) => {
+        if (!textureReady || (event && event.changedElements && event.changedElements.length)) {
+          try { uploadForm(); } catch (err) { console.error('texElementSubImage2D copy failed:', err); }
+        }
+
+        const now = performance.now();
+        if (!interacting && !reduceMotion.matches) angle += (now - last) * 0.0006;
+        last = now;
+
+        const aspect = canvas.width / canvas.height;
+        const viewProj = mul(perspective(FOV, aspect, 0.1, 50), translate(0, 0, -DIST));
+        const model = mul(rotX(-0.12), rotY(angle));
+
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.clearColor(0, 0, 0, 0);
+        gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+        gl.enable(gl.DEPTH_TEST);
+        gl.enable(gl.CULL_FACE);
+        gl.bindVertexArray(vao);
+        gl.uniformMatrix4fv(uMvp, false, mul(viewProj, model));
+        gl.uniformMatrix4fv(uModel, false, model);
+
+        gl.uniform1i(uUseTex, 0);
+        gl.uniform3f(uColor, 0.55, 0.38, 0.27);
+        gl.drawElements(gl.TRIANGLES, 30, gl.UNSIGNED_SHORT, 6 * 2);
+        if (textureReady) {
+          gl.uniform1i(uUseTex, 1);
+          gl.drawElements(gl.TRIANGLES, 6, gl.UNSIGNED_SHORT, 0);
+        }
+
+        // Place the real form over its rendered pixels, or remove it from hit testing when facing away
+        const faceModel = mul(model, mul(translate(0, 0, D / 2), scale(W, H, 1)));
