+  <script type="module">
+    import * as THREE from 'three';
+    import { CSS3DRenderer, CSS3DObject } from 'three/addons/renderers/CSS3DRenderer.js';
+
+    const host = document.getElementById('scene');
+    const form = document.getElementById('box-form');
+    const status = document.getElementById('box-status');
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const name = form.name.value.trim() || 'friend';
+      status.textContent = `Thanks ${name}! ${form.qty.value} x ${form.roast.value} roast on its way.`;
+    });
+    form.addEventListener('reset', () => { status.textContent = ''; });
+
+    const W = 300, H = 380, D = 160;
+    const camera = new THREE.PerspectiveCamera(40, 1, 1, 3000);
+    camera.position.z = 900;
+
+    // WebGL layer: the box itself
+    const gl = new THREE.WebGLRenderer({ antialias: true, alpha: true });
+    gl.setPixelRatio(Math.min(devicePixelRatio, 2));
+    host.prepend(gl.domElement);
+    const scene = new THREE.Scene();
+    scene.add(new THREE.AmbientLight(0xffffff, 1.2));
+    const sun = new THREE.DirectionalLight(0xffffff, 2);
+    sun.position.set(300, 400, 600);
+    scene.add(sun);
+
+    const box = new THREE.Group();
+    scene.add(box);
+    box.add(new THREE.Mesh(
+      new THREE.BoxGeometry(W, H, D),
+      new THREE.MeshStandardMaterial({ color: 0x8d6e63, roughness: 0.8 })
+    ));
+
+    // CSS layer: the real form, projected with the same camera onto the box front.
+    // Real DOM elements under a 3D transform keep native hit-testing, so they stay clickable.
+    const css = new CSS3DRenderer({ element: document.getElementById('css-layer') });
+    const cssScene = new THREE.Scene();
+    const formObj = new CSS3DObject(form);
+    formObj.position.z = D / 2 + 1;
+    const cssBox = new THREE.Group();
+    cssScene.add(cssBox);
+    cssBox.add(formObj);
+
+    function resize() {
+      const w = host.clientWidth, h = host.clientHeight;
+      camera.aspect = w / h;
+      camera.updateProjectionMatrix();
+      gl.setSize(w, h);
+      css.setSize(w, h);
+    }
+    addEventListener('resize', resize);
+    resize();
+
+    const normal = new THREE.Vector3(), toCam = new THREE.Vector3(), pos = new THREE.Vector3();
+    let speed = 0.4, angle = 0, last = performance.now();
+    host.addEventListener('pointerenter', () => { speed = 0.15; });
+    host.addEventListener('pointerleave', () => { speed = 0.4; });
+
+    function frame(now) {
+      angle += (now - last) / 1000 * speed;
+      last = now;
+      box.rotation.y = angle;
+      box.rotation.x = 0.1;
+      box.updateMatrixWorld();
+      cssBox.rotation.copy(box.rotation);
+
+      // Hide the form when the front face points away from the camera
+      normal.set(0, 0, 1).transformDirection(box.matrixWorld);
+      pos.setFromMatrixPosition(box.matrixWorld);
+      toCam.subVectors(camera.position, pos).normalize();
+      form.classList.toggle('away', normal.dot(toCam) <= 0.05);
+
+      gl.render(scene, camera);
+      css.render(cssScene, camera);
+      requestAnimationFrame(frame);
+    }
+    requestAnimationFrame(frame);
+  </script>
+
