+  <script>
+    const searchInput = document.getElementById('search-input');
+    const cards = document.querySelectorAll('.grid .card');
+
+    function clearHighlights() {
+      if (CSS.highlights) {
+        CSS.highlights.delete('search-match');
+        return;
+      }
+      cards.forEach(card => {
+        card.querySelectorAll('mark').forEach(m => m.replaceWith(m.textContent));
+        card.normalize();
+      });
+    }
+
+    function highlight(term) {
+      clearHighlights();
+      if (!term) return;
+      const needle = term.toLowerCase();
+      const ranges = [];
+
+      cards.forEach(card => {
+        const walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+        const nodes = [];
+        for (let n = walker.nextNode(); n; n = walker.nextNode()) nodes.push(n);
+
+        for (const node of nodes) {
+          const text = node.textContent.toLowerCase();
+          const found = [];
+          for (let i = text.indexOf(needle); i !== -1; i = text.indexOf(needle, i + needle.length)) {
+            found.push(i);
+          }
+          if (CSS.highlights) {
+            for (const i of found) {
+              const range = new Range();
+              range.setStart(node, i);
+              range.setEnd(node, i + needle.length);
+              ranges.push(range);
+            }
+          } else if (found.length) {
+            const frag = document.createDocumentFragment();
+            let last = 0;
+            for (const i of found) {
+              frag.append(node.textContent.slice(last, i));
+              const mark = document.createElement('mark');
+              mark.textContent = node.textContent.slice(i, i + needle.length);
+              frag.append(mark);
+              last = i + needle.length;
+            }
+            frag.append(node.textContent.slice(last));
+            node.replaceWith(frag);
+          }
+        }
+      });
+
+      if (CSS.highlights && ranges.length) {
+        CSS.highlights.set('search-match', new Highlight(...ranges));
+      }
+    }
+
+    searchInput.addEventListener('input', () => highlight(searchInput.value.trim()));
+  </script>
+
 </body>
 
