+  <script>
+    // Size each hero line's font so its text is exactly as wide as the heading.
+    function fitLockup() {
+      document.querySelectorAll('.hero h1').forEach(function (h1) {
+        var width = h1.clientWidth;
+        h1.querySelectorAll('.line').forEach(function (line) {
+          var text = line.firstElementChild;
+          line.style.fontSize = '100px';
+          line.style.fontSize = (100 * width / text.getBoundingClientRect().width) + 'px';
+        });
+      });
+    }
+    fitLockup();
+    window.addEventListener('resize', fitLockup);
+    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitLockup);
+  </script>
