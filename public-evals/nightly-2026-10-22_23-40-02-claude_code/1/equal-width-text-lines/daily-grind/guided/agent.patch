+  <script>
+    // Size each line's font so its natural text width equals the heading width.
+    function fitLockup(h1) {
+      const lines = h1.querySelectorAll('.line');
+      const target = h1.clientWidth;
+      const probe = 100;
+      lines.forEach(line => {
+        line.style.fontSize = probe + 'px';
+        const range = document.createRange();
+        range.selectNodeContents(line);
+        const natural = range.getBoundingClientRect().width;
+        line.style.fontSize = (probe * target / natural) + 'px';
+      });
+    }
+
+    const lockup = document.querySelector('.hero h1');
+    new ResizeObserver(() => fitLockup(lockup)).observe(lockup);
+    document.fonts.ready.then(() => fitLockup(lockup));
+  </script>
