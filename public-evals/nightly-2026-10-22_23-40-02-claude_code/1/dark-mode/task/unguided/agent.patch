+<script>
+    // Theme selector: force light/dark on the root element, or fall back to the system setting
+    (function () {
+      var root = document.documentElement;
+      var select = document.getElementById('theme-select');
+      var saved = 'system';
+      try { saved = localStorage.getItem('theme') || 'system'; } catch (e) { }
+      if (saved !== 'light' && saved !== 'dark') saved = 'system';
+      select.value = saved;
+
+      select.addEventListener('change', function () {
+        var choice = select.value;
+        if (choice === 'light' || choice === 'dark') {
+          root.setAttribute('data-theme', choice);
+        } else {
+          root.removeAttribute('data-theme');
+        }
+        try {
+          if (choice === 'system') localStorage.removeItem('theme');
+          else localStorage.setItem('theme', choice);
+        } catch (e) { }
+      });
+
+      // Filter for the late night specials
+      var filter = document.getElementById('special-filter');
+      filter.addEventListener('change', function () {
+        document.querySelectorAll('.special').forEach(function (el) {
+          el.hidden = filter.value !== 'all' && el.dataset.category !== filter.value;
+        });
+      });
+    })();
+  </script>
+
