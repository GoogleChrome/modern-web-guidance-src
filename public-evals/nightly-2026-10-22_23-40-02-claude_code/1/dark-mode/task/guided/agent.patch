+<script>
+    const themeSelect = document.getElementById('theme-select');
+    const root = document.documentElement;
+    const schemeMeta = document.querySelector('meta[name="color-scheme"]');
+
+    function applyTheme(theme) {
+      if (theme === 'light' || theme === 'dark') {
+        root.dataset.theme = theme;
+        schemeMeta.content = theme;
+      } else {
+        delete root.dataset.theme;
+        schemeMeta.content = 'light dark';
+      }
+    }
+
+    function storedTheme() {
+      try { return localStorage.getItem('theme') || 'system'; } catch (e) { return 'system'; }
+    }
+
+    themeSelect.value = storedTheme();
+    themeSelect.addEventListener('change', () => {
+      const theme = themeSelect.value;
+      applyTheme(theme);
+      try {
+        if (theme === 'system') localStorage.removeItem('theme');
+        else localStorage.setItem('theme', theme);
+      } catch (e) {}
+    });
+    // Stay in sync with other tabs
+    window.addEventListener('storage', (e) => {
+      if (e.key === 'theme') {
+        themeSelect.value = storedTheme();
+        applyTheme(themeSelect.value);
+      }
+    });
+
+    const specials = {
+      affogato: ['Affogato', 'A scoop of vanilla bean gelato drowned in a fresh double espresso shot.', 'Served with a shortbread cookie and a tiny spoon for savoring every last drop.', 'Pairs well with quiet conversation after dinner.'],
+      mocha: ['Midnight Mocha', 'Dark chocolate ganache, bold espresso, and steamed milk topped with cocoa nibs.', 'Our richest drink, made with single-origin cacao.', 'Available hot or iced.'],
+      irish: ['Decaf Irish Cream', 'Swiss-water decaf with Irish cream syrup and whipped cream.', 'All of the comfort, none of the insomnia.', 'A gentle way to end the night.']
+    };
+    const specialSelect = document.getElementById('special-select');
+    const details = document.getElementById('special-details');
+    function showSpecial() {
+      const [title, ...lines] = specials[specialSelect.value];
+      details.replaceChildren();
+      const h = document.createElement('h3');
+      h.textContent = title;
+      details.append(h, ...lines.map((t) => Object.assign(document.createElement('p'), { textContent: t })));
+    }
+    specialSelect.addEventListener('change', showSpecial);
+    showSpecial();
+  </script>
+
 </body>
 
