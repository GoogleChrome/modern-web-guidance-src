+  <script>
+    (() => {
+      const $ = (id) => document.getElementById(id);
+      const MAX_BRANCHES = 3;
+      const LANG = { expectedInputs: [{ type: 'text', languages: ['en'] }], expectedOutputs: [{ type: 'text', languages: ['en'] }] };
+      const BARISTA_PROMPT = 'You are a friendly barista at The Daily Grind coffee shop. You only answer questions about two drinks: ' +
+        'the Maple Oat Latte (creamy oat milk with a hint of Vermont maple syrup) and the Cold Brew (steeped for 18 hours for maximum smoothness). ' +
+        'If asked about anything else, politely say you can only talk about those two drinks. Keep answers short.';
+      const SENTIMENT_SCHEMA = {
+        type: 'object',
+        properties: {
+          score: { type: 'number', minimum: -1, maximum: 1 },
+          category: { type: 'string', enum: ['positive', 'neutral', 'negative'] }
+        },
+        required: ['score', 'category'],
+        additionalProperties: false
+      };
+
+      // Returns a user-facing reason string if the model can't be used, else null.
+      async function checkAvailability(options) {
+        if (!('LanguageModel' in self)) return 'The built-in AI (Prompt API) is not supported in this browser.';
+        const availability = await LanguageModel.availability(options);
+        if (availability === 'unavailable') return 'The built-in AI model is unavailable on this device.';
+        return null;
+      }
+
+      // Creates a session, reporting download progress to the given progress element.
+      async function createSession(options, { signal, progress } = {}) {
+        try {
+          return await LanguageModel.create({
+            ...LANG,
+            ...options,
+            signal,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                if (!progress) return;
+                progress.hidden = e.loaded >= 1;
+                progress.value = e.loaded;
+              });
+            }
+          });
+        } finally {
+          if (progress) progress.hidden = true;
+        }
+      }
+
+      const errorMessage = (err) => err && err.name === 'AbortError' ? 'Cancelled.' : `Error: ${err && err.message || err}`;
+
+      /* ---------- Ask the Barista (also owns the shared, long-lived session) ---------- */
+      const askBtn = $('ask-the-barista');
+      const answerEl = $('barista-answer');
+      const baristaStatus = $('barista-status');
+      const baristaOptions = { initialPrompts: [{ role: 'system', content: BARISTA_PROMPT }] };
+
+      let baristaSession = null;
+      let askController = null;
+      let sessionPromise = null;
+
+      // Sessions that exist for branching: root first, active last.
+      const branches = [];
+      let activeSession = null;
+
+      function getBaristaSession(signal) {
+        if (baristaSession) return Promise.resolve(baristaSession);
+        // Share one in-flight creation so concurrent callers don't create duplicate sessions.
+        sessionPromise ||= createSession(baristaOptions, { signal, progress: $('model-progress') })
+          .then((s) => {
+            baristaSession = s;
+            activeSession = s;
+            watchOverflow(s);
+            branches.push(s);
+            renderBranches();
+            return s;
+          })
+          .finally(() => { sessionPromise = null; });
+        return sessionPromise;
+      }
+
+      askBtn.addEventListener('click', async () => {
+        const question = $('barista-question').value.trim();
+        if (!question) { baristaStatus.textContent = 'Please type a question first.'; return; }
+
+        askController?.abort();
+        const controller = askController = new AbortController();
+        askBtn.disabled = true;
+        answerEl.textContent = '';
+
+        try {
+          baristaStatus.textContent = 'Checking model availability...';
+          const problem = await checkAvailability(baristaOptions);
+          if (problem) { baristaStatus.textContent = problem; return; }
+
+          baristaStatus.textContent = 'Preparing model...';
+          const session = await getBaristaSession(controller.signal);
+
+          baristaStatus.textContent = 'Thinking...';
+          // Answer on the active branch so cloned conversations keep their own context.
+          const target = activeSession || session;
+          const stream = target.promptStreaming(question, { signal: controller.signal });
+          for await (const chunk of stream) answerEl.textContent += chunk;
+          baristaStatus.textContent = '';
+          renderBranches();
+        } catch (err) {
+          baristaStatus.textContent = errorMessage(err);
+        } finally {
+          if (askController === controller) askController = null;
+          askBtn.disabled = false;
+        }
+      });
+
+      /* ---------- Customer feedback analyzer ---------- */
+      const sentimentBtn = $('sentiment-btn');
+      const sentimentStatus = $('sentiment-status');
+      const sentimentOut = $('sentiment-output');
+
+      sentimentBtn.addEventListener('click', async () => {
+        const feedback = $('feedback-text').value.trim();
+        if (!feedback) { sentimentStatus.textContent = 'Please enter some feedback first.'; return; }
+
+        sentimentBtn.disabled = true;
+        sentimentOut.textContent = '';
+        let session;
+        try {
+          const options = {
+            temperature: 0.1,
+            topK: 1,
+            initialPrompts: [{ role: 'system', content: 'Classify the sentiment of coffee shop customer feedback. Respond only with JSON.' }]
+          };
+          sentimentStatus.textContent = 'Checking model availability...';
+          const problem = await checkAvailability(options);
+          if (problem) { sentimentStatus.textContent = problem; return; }
+
+          sentimentStatus.textContent = 'Analyzing...';
+          session = await createSession(options);
+          const raw = await session.prompt(feedback, { responseConstraint: SENTIMENT_SCHEMA });
+          const result = JSON.parse(raw);
+          sentimentOut.textContent = JSON.stringify({ score: result.score, category: result.category }, null, 2);
+          sentimentStatus.textContent = '';
+        } catch (err) {
+          sentimentStatus.textContent = errorMessage(err);
+        } finally {
+          session?.destroy(); // one-shot session: free it immediately
+          sentimentBtn.disabled = false;
+        }
+      });
+
+      /* ---------- Conversation branching ---------- */
+      const cloneBtn = $('clone-btn');
+      const branchStatus = $('branch-status');
+      const branchList = $('branch-list');
+
+      function usageText(session) {
+        return `${session.inputUsage} / ${session.inputQuota} tokens used`;
+      }
+
+      function renderBranches() {
+        branchList.replaceChildren(...branches.map((s, i) => {
+          const li = document.createElement('li');
+          li.textContent = `Branch ${i + 1}${s === activeSession ? ' (active)' : ''}: ${usageText(s)}`;
+          return li;
+        }));
+      }
+
+      function dropBranch(session) {
+        session.destroy();
+        const i = branches.indexOf(session);
+        if (i !== -1) branches.splice(i, 1);
+        if (session === baristaSession) baristaSession = null;
+        if (session === activeSession) activeSession = branches[branches.length - 1] || null;
+      }
+
+      function watchOverflow(session) {
+        session.addEventListener('contextoverflow', () => {
+          branchStatus.textContent = 'Context window overflowed; oldest messages were dropped.';
+          renderBranches();
+        });
+      }
+
+      cloneBtn.addEventListener('click', async () => {
+        cloneBtn.disabled = true;
+        try {
+          branchStatus.textContent = 'Checking model availability...';
+          const problem = await checkAvailability(baristaOptions);
+          if (problem) { branchStatus.textContent = problem; return; }
+
+          // Make sure there is a session to clone.
+          if (!activeSession) await getBaristaSession();
+          const source = activeSession;
+
+          const clone = await source.clone();
+          watchOverflow(clone);
+          branches.push(clone);
+          activeSession = clone;
+
+          // Clean up the oldest branches beyond the cap, never the one in use.
+          while (branches.length > MAX_BRANCHES) dropBranch(branches[0]);
+
+          const warn = clone.inputUsage / clone.inputQuota > 0.8 ? ' Context is nearly full.' : '';
+          branchStatus.textContent = `Cloned. Active branch: ${usageText(clone)}.${warn}`;
+          renderBranches();
+        } catch (err) {
+          branchStatus.textContent = errorMessage(err);
+        } finally {
+          cloneBtn.disabled = false;
+        }
+      });
+
+      // Release all on-device model resources when leaving the page.
+      addEventListener('pagehide', () => {
+        askController?.abort();
+        [...branches].forEach(dropBranch);
+      });
+    })();
+  </script>
 </body>
 
