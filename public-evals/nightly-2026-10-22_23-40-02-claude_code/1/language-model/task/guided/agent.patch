+  <script>
+    (() => {
+      const $ = (id) => document.getElementById(id);
+      const supported = 'LanguageModel' in self;
+      const MAX_BRANCHES = 3;
+      const OUTPUT_LANG = { expectedInputs: [{ type: 'text', languages: ['en'] }], expectedOutputs: [{ type: 'text', languages: ['en'] }] };
+
+      const BARISTA_PROMPT = 'You are a friendly barista at The Daily Grind coffee shop. ' +
+        'You only answer questions about two drinks: the Maple Oat Latte (oat milk, Vermont maple syrup) ' +
+        'and the Cold Brew (steeped 18 hours, very smooth). If asked about anything else, politely say you can only ' +
+        'help with the Maple Oat Latte or Cold Brew. Keep answers short.';
+      const SENTIMENT_PROMPT = 'You classify customer feedback for a coffee shop. Score ranges from -1 (very negative) to 1 (very positive).';
+
+      const sentimentSchema = {
+        type: 'object',
+        properties: {
+          score: { type: 'number', minimum: -1, maximum: 1 },
+          category: { type: 'string', enum: ['positive', 'neutral', 'negative'] },
+        },
+        required: ['score', 'category'],
+        additionalProperties: false,
+      };
+
+      const progressEl = $('ai-download');
+      const sessions = new Set(); // every live session, for cleanup
+      let conversation = null; // multi-turn barista session
+      let branches = []; // { session, label }
+      let askController = null;
+
+      // Checks availability first; reports via setStatus. Returns true when usable.
+      async function ensureAvailable(setStatus) {
+        if (!supported) {
+          setStatus('The built-in AI (Prompt API) is not supported in this browser.');
+          return false;
+        }
+        const availability = await LanguageModel.availability(OUTPUT_LANG);
+        if (availability === 'unavailable') {
+          setStatus('The on-device model is unavailable on this device.');
+          return false;
+        }
+        if (availability !== 'available') setStatus('Preparing the on-device model (download required)…');
+        return true;
+      }
+
+      async function createSession(systemPrompt) {
+        const session = await LanguageModel.create({
+          ...OUTPUT_LANG,
+          initialPrompts: [{ role: 'system', content: systemPrompt }],
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              progressEl.hidden = e.loaded >= 1;
+              progressEl.value = e.loaded;
+            });
+          },
+        });
+        progressEl.hidden = true;
+        sessions.add(session);
+        return session;
+      }
+
+      function destroySession(session) {
+        if (!session) return;
+        session.destroy();
+        sessions.delete(session);
+      }
+
+      function usage(session) {
+        return `${session.contextUsage}/${session.contextWindow} tokens`;
+      }
+
+      // ---- Ask the Barista (streaming, multi-turn) ----
+      const askBtn = $('ask-the-barista');
+      const stopBtn = $('stop-barista');
+      const answerEl = $('barista-answer');
+      const baristaStatus = (msg) => { $('barista-status').textContent = msg; };
+
+      async function getConversation() {
+        if (!conversation) conversation = await createSession(BARISTA_PROMPT);
+        return conversation;
+      }
+
+      askBtn.addEventListener('click', async () => {
+        const question = $('barista-question').value.trim();
+        if (!question) return baristaStatus('Please type a question first.');
+
+        askBtn.disabled = true;
+        answerEl.textContent = '';
+        try {
+          if (!(await ensureAvailable(baristaStatus))) return;
+          const session = await getConversation();
+          askController = new AbortController();
+          stopBtn.hidden = false;
+          baristaStatus('Thinking…');
+
+          const stream = session.promptStreaming(question, { signal: askController.signal });
+          for await (const chunk of stream) {
+            answerEl.append(chunk); // text node: model output is untrusted
+          }
+          baristaStatus(`Done. Context: ${usage(session)}`);
+        } catch (err) {
+          baristaStatus(err.name === 'AbortError' ? 'Stopped.' : `Something went wrong: ${err.message}`);
+        } finally {
+          askController = null;
+          stopBtn.hidden = true;
+          askBtn.disabled = false;
+        }
+      });
+
+      stopBtn.addEventListener('click', () => askController?.abort());
+
+      // ---- Customer feedback analyzer (structured output) ----
+      const sentimentBtn = $('sentiment-btn');
+      const sentimentStatus = (msg) => { $('sentiment-status').textContent = msg; };
+
+      sentimentBtn.addEventListener('click', async () => {
+        const feedback = $('feedback-text').value.trim();
+        if (!feedback) return sentimentStatus('Please enter some feedback first.');
+
+        sentimentBtn.disabled = true;
+        $('sentiment-result').textContent = '';
+        let session;
+        try {
+          if (!(await ensureAvailable(sentimentStatus))) return;
+          session = await createSession(SENTIMENT_PROMPT);
+          sentimentStatus('Analyzing…');
+          const raw = await session.prompt(`Feedback: ${feedback}`, { responseConstraint: sentimentSchema });
+          const { score, category } = JSON.parse(raw);
+          $('sentiment-result').textContent = JSON.stringify({ score, category }, null, 2);
+          sentimentStatus('Done.');
+        } catch (err) {
+          sentimentStatus(`Something went wrong: ${err.message}`);
+        } finally {
+          destroySession(session); // one-shot session, free it immediately
+          sentimentBtn.disabled = false;
+        }
+      });
+
+      // ---- Conversation branching ----
+      const cloneBtn = $('clone-btn');
+      const cloneStatus = (msg) => { $('clone-status').textContent = msg; };
+
+      function renderBranches() {
+        const list = $('branch-list');
+        list.replaceChildren(...branches.map((b) => {
+          const li = document.createElement('li');
+          li.textContent = `${b.label}: ${usage(b.session)}`;
+          return li;
+        }));
+      }
+
+      cloneBtn.addEventListener('click', async () => {
+        cloneBtn.disabled = true;
+        try {
+          if (!(await ensureAvailable(cloneStatus))) return;
+          const source = await getConversation();
+          const clone = await source.clone();
+          sessions.add(clone);
+          clone.addEventListener('contextoverflow', () => {
+            cloneStatus('A branch exceeded its context window; oldest messages were dropped.');
+          });
+          branches.push({ session: clone, label: `Branch ${branches.length ? Number(branches.at(-1).label.split(' ')[1]) + 1 : 1}` });
+
+          // Clean up the oldest branches beyond the limit.
+          while (branches.length > MAX_BRANCHES) destroySession(branches.shift().session);
+
+          renderBranches();
+          cloneStatus(`Cloned. Main conversation: ${usage(source)}. Active branches: ${branches.length}.`);
+        } catch (err) {
+          cloneStatus(`Something went wrong: ${err.message}`);
+        } finally {
+          cloneBtn.disabled = false;
+        }
+      });
+
+      // ---- Cleanup ----
+      addEventListener('pagehide', () => {
+        askController?.abort();
+        for (const session of sessions) session.destroy();
+        sessions.clear();
+        conversation = null;
+        branches = [];
+      });
+
+      if (!supported) {
+        for (const btn of [askBtn, sentimentBtn, cloneBtn]) btn.disabled = true;
+        const msg = 'The built-in AI (Prompt API) is not supported in this browser.';
+        baristaStatus(msg);
+        sentimentStatus(msg);
+        cloneStatus(msg);
+      }
+    })();
+  </script>
 </body>
 
