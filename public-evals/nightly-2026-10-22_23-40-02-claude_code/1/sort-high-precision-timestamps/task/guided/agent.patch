+  <script>
+    // Simulated batch from distributed services: out of order, nanosecond UTC timestamps.
+    // Several events fall within the same millisecond, so Date would collide them.
+    function fetchOrderEvents() {
+      return Promise.resolve([
+        { service: 'kitchen-display', event: 'drink.ready', ts: '2026-10-22T08:15:03.412907881Z' },
+        { service: 'order-api', event: 'order.received', ts: '2026-10-22T08:15:00.102000123Z' },
+        { service: 'barista-queue', event: 'drink.started', ts: '2026-10-22T08:15:01.870553210Z' },
+        { service: 'payment', event: 'payment.authorized', ts: '2026-10-22T08:15:00.102418456Z' },
+        { service: 'order-api', event: 'order.validated', ts: '2026-10-22T08:15:00.102000987Z' },
+        { service: 'barista-queue', event: 'order.queued', ts: '2026-10-22T08:15:00.102931002Z' },
+        { service: 'pickup-notifier', event: 'customer.notified', ts: '2026-10-22T08:15:03.413250004Z' },
+      ]);
+    }
+
+    async function ensureTemporal() {
+      if (typeof Temporal !== 'undefined') return;
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const loadButton = document.getElementById('load-events');
+    const statusEl = document.getElementById('trace-status');
+    const table = document.getElementById('trace-table');
+
+    function renderTrace(rawEvents) {
+      // Instant.from keeps all nine fractional digits.
+      const events = rawEvents
+        .map((e) => ({ ...e, instant: Temporal.Instant.from(e.ts) }))
+        .sort((a, b) => Temporal.Instant.compare(a.instant, b.instant));
+
+      const rows = events.map((e, i) => {
+        const tr = document.createElement('tr');
+        const gap = i === 0
+          ? '—'
+          : e.instant.since(events[i - 1].instant).toLocaleString(undefined, { style: 'narrow' });
+        for (const text of [i + 1, e.service, e.event, e.instant.toString(), gap]) {
+          const td = document.createElement('td');
+          td.textContent = text;
+          tr.append(td);
+        }
+        return tr;
+      });
+      table.tBodies[0].replaceChildren(...rows);
+      table.hidden = false;
+
+      const total = events.at(-1).instant.since(events[0].instant).toLocaleString(undefined, { style: 'narrow' });
+      statusEl.textContent = `Loaded ${events.length} events, sorted. Total span: ${total}.`;
+    }
+
+    loadButton.addEventListener('click', async () => {
+      loadButton.disabled = true;
+      statusEl.textContent = 'Loading events…';
+      try {
+        const [rawEvents] = await Promise.all([fetchOrderEvents(), ensureTemporal()]);
+        renderTrace(rawEvents);
+      } catch (err) {
+        statusEl.textContent = 'Could not load order events. Please try again.';
+        console.error(err);
+      } finally {
+        loadButton.disabled = false;
+      }
+    });
+  </script>
