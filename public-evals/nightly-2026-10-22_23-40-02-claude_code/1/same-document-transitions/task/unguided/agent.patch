+  <script>
+    const FAVORITES = [
+      {
+        slug: 'maple-oat-latte',
+        title: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup, poured over a double shot of our house espresso.',
+        image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1350&q=80'
+      },
+      {
+        slug: 'dark-roast-espresso',
+        title: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost. Pulled fresh from beans roasted this week.',
+        image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=1350&q=80'
+      },
+      {
+        slug: 'cold-brew',
+        title: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness, served over ice.',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1350&q=80'
+      }
+    ];
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const grid = document.getElementById('grid');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const description = document.getElementById('description');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    // Build the list view
+    for (const fav of FAVORITES) {
+      const a = document.createElement('a');
+      a.className = 'thumbnail';
+      a.href = `#/favorite/${fav.slug}`;
+      a.dataset.slug = fav.slug;
+      a.style.backgroundImage = `url('${fav.image}')`;
+      const h2 = document.createElement('h2');
+      h2.className = 'title';
+      h2.textContent = fav.title;
+      a.append(h2);
+      grid.append(a);
+    }
+
+    let currentSlug = null; // null = list view
+    let listScroll = 0;
+    let activeTransition = null;
+
+    function slugFromHash() {
+      const match = location.hash.match(/^#\/favorite\/([\w-]+)$/);
+      return match && FAVORITES.some(f => f.slug === match[1]) ? match[1] : null;
+    }
+
+    function setNames(el, parts) {
+      el.style.viewTransitionName = parts.hero;
+      el.querySelector('.title, #title').style.viewTransitionName = parts.title;
+    }
+
+    function clearNames(...els) {
+      for (const el of els) {
+        el.style.removeProperty('view-transition-name');
+        el.querySelector('.title, #title').style.removeProperty('view-transition-name');
+      }
+    }
+
+    const NAMES = { hero: 'hero', title: 'title' };
+
+    // Swap which view is visible and move focus to its heading
+    function showView(slug) {
+      const fav = FAVORITES.find(f => f.slug === slug);
+      if (fav) {
+        hero.style.backgroundImage = `url('${fav.image}')`;
+        title.textContent = fav.title;
+        description.textContent = fav.description;
+        document.title = `${fav.title} | The Daily Grind`;
+      } else {
+        document.title = 'The Daily Grind | Artisanal Coffee';
+      }
+      listPage.hidden = !!fav;
+      detailPage.hidden = !fav;
+      if (fav) {
+        window.scrollTo(0, 0);
+        title.focus({ preventScroll: true });
+      } else {
+        window.scrollTo(0, listScroll);
+        listHeading.focus({ preventScroll: true });
+      }
+    }
+
+    async function route(animate) {
+      const slug = slugFromHash();
+      if (slug === currentSlug) return;
+      const from = currentSlug;
+      currentSlug = slug;
+
+      if (activeTransition) activeTransition.skipTransition();
+      if (from === null) listScroll = window.scrollY;
+
+      const canAnimate = animate && (from === null || slug === null) && !reducedMotion.matches && document.startViewTransition;
+      if (!canAnimate) {
+        showView(slug);
+        return;
+      }
+
+      let cleanup;
+      const thumbOf = s => grid.querySelector(`[data-slug="${s}"]`);
+
+      if (slug) {
+        // list -> detail: morph the clicked thumbnail into the hero
+        const thumb = thumbOf(slug);
+        setNames(thumb, NAMES);
+        activeTransition = document.startViewTransition(() => {
+          clearNames(thumb);
+          setNames(hero, NAMES);
+          showView(slug);
+        });
+        cleanup = [thumb, hero];
+      } else {
+        // detail -> list: morph the hero back into its thumbnail
+        setNames(hero, NAMES);
+        activeTransition = document.startViewTransition(() => {
+          clearNames(hero);
+          showView(null);
+          setNames(thumbOf(from), NAMES);
+        });
+        cleanup = [hero, thumbOf(from)];
+      }
+
+      const transition = activeTransition;
+      try {
+        await transition.finished;
+      } catch (e) {
+        // skipped or interrupted; still clean up below
+      } finally {
+        if (activeTransition === transition) activeTransition = null;
+        // Remove temporary transition names (only if no newer transition owns them)
+        if (!activeTransition) clearNames(...cleanup);
+      }
+    }
+
+    window.addEventListener('hashchange', () => route(true));
+    route(false);
+  </script>
+
