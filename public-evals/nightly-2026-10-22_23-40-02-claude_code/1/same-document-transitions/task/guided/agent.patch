+
+  <script>
+    const ITEMS = [
+      {
+        id: 'maple-oat-latte',
+        title: 'Maple Oat Latte',
+        blurb: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        detail: 'Our signature seasonal drink: a double shot of espresso, steamed oat milk, and a drizzle of grade-A Vermont maple syrup.',
+        img: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1350&q=80'
+      },
+      {
+        id: 'dark-roast-espresso',
+        title: 'Dark Roast Espresso',
+        blurb: 'Bold, smokey, and perfect for a morning boost.',
+        detail: 'A rich, low-acid dark roast pulled slow for a syrupy body, with notes of cocoa and toasted oak.',
+        img: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=1350&q=80'
+      },
+      {
+        id: 'cold-brew',
+        title: 'Cold Brew',
+        blurb: 'Steeped for 18 hours for maximum smoothness.',
+        detail: 'Coarse-ground beans steeped cold for 18 hours, then filtered and served over ice for a smooth, naturally sweet cup.',
+        img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1350&q=80'
+      }
+    ];
+
+    const grid = document.getElementById('grid');
+    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    let currentId = null; // id of the item shown in the detail view, or null for the list
+    let listScroll = 0;
+
+    for (const item of ITEMS) {
+      const a = document.createElement('a');
+      a.className = 'thumbnail';
+      a.href = '#/' + item.id;
+      a.dataset.id = item.id;
+      a.innerHTML = '<img alt="" loading="lazy"><h2 class="title"></h2>';
+      a.querySelector('img').src = item.img;
+      a.querySelector('.title').textContent = item.title;
+      grid.append(a);
+    }
+
+    const thumbFor = (id) => grid.querySelector(`.thumbnail[data-id="${id}"]`);
+
+    function fillDetail(item) {
+      document.getElementById('hero-img').src = item.img;
+      document.getElementById('title').textContent = item.title;
+      document.getElementById('detail-text').textContent = item.blurb + ' ' + item.detail;
+      document.title = item.title + ' | The Daily Grind';
+    }
+
+    function focusHeading() {
+      const el = document.getElementById(currentId ? 'title' : 'list-heading');
+      el.focus({ preventScroll: !currentId });
+    }
+
+    // Swap views. `id` is an item id or null for the list.
+    function show(id, animate) {
+      const from = currentId;
+      if (id === from) return;
+      const item = ITEMS.find((i) => i.id === id);
+      const thumb = thumbFor(id ?? from);
+      const clearSelected = () =>
+        grid.querySelectorAll('.selected').forEach((el) => el.classList.remove('selected'));
+
+      const update = () => {
+        if (item) {
+          if (!from) listScroll = scrollY;
+          fillDetail(item);
+          document.body.classList.add('detail');
+          scrollTo(0, 0);
+        } else {
+          document.body.classList.remove('detail');
+          document.title = 'The Daily Grind | Artisanal Coffee';
+          scrollTo(0, listScroll);
+          // Name the matching thumbnail so it is the morph target
+          thumbFor(from)?.classList.add('selected');
+        }
+        currentId = id;
+      };
+
+      const finish = () => {
+        clearSelected();
+        focusHeading();
+      };
+
+      if (!animate || !document.startViewTransition || reduceMotion.matches) {
+        update();
+        finish();
+        return;
+      }
+
+      // Opening: name the clicked thumbnail before the old state is captured
+      if (item && from === null) thumb?.classList.add('selected');
+      // Switching directly between items (history jump): no shared morph
+      if (item && from) clearSelected();
+
+      document.startViewTransition(update).finished.finally(finish);
+    }
+
+    const idFromHash = () => {
+      const id = location.hash.replace(/^#\//, '');
+      return ITEMS.some((i) => i.id === id) ? id : null;
+    };
+
+    grid.addEventListener('click', (e) => {
+      const thumb = e.target.closest('.thumbnail');
+      if (!thumb || e.metaKey || e.ctrlKey || e.shiftKey || e.button) return;
+      e.preventDefault();
+      history.pushState(null, '', thumb.getAttribute('href'));
+      show(thumb.dataset.id, true);
+    });
+
+    document.getElementById('back').addEventListener('click', (e) => {
+      e.preventDefault();
+      history.pushState(null, '', '#/');
+      show(null, true);
+    });
+
+    addEventListener('popstate', () => show(idFromHash(), true));
+
+    // Deep link on first load: no animation, and don't steal focus
+    const initial = idFromHash();
+    if (initial) {
+      const item = ITEMS.find((i) => i.id === initial);
+      fillDetail(item);
+      document.body.classList.add('detail');
+      currentId = initial;
+    }
+  </script>
