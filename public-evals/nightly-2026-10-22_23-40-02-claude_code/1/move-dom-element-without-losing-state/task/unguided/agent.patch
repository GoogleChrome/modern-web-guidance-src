+  <script>
+    (function () {
+      var iframe = document.getElementById('roast-video');
+      var mainSlot = document.getElementById('main-video-slot');
+      var heroSlot = document.getElementById('hero-video-slot');
+      var button = document.getElementById('theater-toggle');
+      var theater = false;
+
+      // Fallback state: last known playback info reported by the YouTube player.
+      var lastTime = 0;
+      var playing = false;
+      var restore = null;
+
+      function post(func, args) {
+        iframe.contentWindow.postMessage(
+          JSON.stringify({ event: 'command', func: func, args: args || [] }),
+          'https://www.youtube.com'
+        );
+      }
+
+      function listen() {
+        iframe.contentWindow.postMessage(
+          JSON.stringify({ event: 'listening', id: 1, channel: 'widget' }),
+          'https://www.youtube.com'
+        );
+      }
+
+      window.addEventListener('message', function (e) {
+        if (e.origin !== 'https://www.youtube.com' || e.source !== iframe.contentWindow) return;
+        var data;
+        try { data = JSON.parse(e.data); } catch (err) { return; }
+        if (data.event === 'onReady') listen();
+        var info = data.info;
+        if (!info) return;
+        if (typeof info.currentTime === 'number') lastTime = info.currentTime;
+        if (typeof info.playerState === 'number') playing = info.playerState === 1;
+      });
+
+      iframe.addEventListener('load', function () {
+        listen();
+        if (restore) {
+          var r = restore;
+          restore = null;
+          post('seekTo', [r.time, true]);
+          post(r.playing ? 'playVideo' : 'pauseVideo');
+        }
+      });
+
+      function move(target) {
+        // moveBefore() relocates the node atomically, keeping the iframe's
+        // browsing context alive (no reload, playback continues).
+        if (typeof target.moveBefore === 'function') {
+          try {
+            target.moveBefore(iframe, null);
+            return;
+          } catch (err) { /* fall through to the legacy path */ }
+        }
+        // Legacy browsers: reparenting reloads the iframe, so remember the
+        // playback position and restore it once the new load finishes.
+        restore = { time: lastTime, playing: playing };
+        target.appendChild(iframe);
+      }
+
+      button.addEventListener('click', function () {
+        theater = !theater;
+        move(theater ? heroSlot : mainSlot);
+        button.textContent = theater ? 'Exit theater mode' : 'Theater mode';
+        button.setAttribute('aria-pressed', String(theater));
+        if (theater) heroSlot.scrollIntoView({ behavior: 'smooth', block: 'center' });
+      });
+    })();
+  </script>
+
