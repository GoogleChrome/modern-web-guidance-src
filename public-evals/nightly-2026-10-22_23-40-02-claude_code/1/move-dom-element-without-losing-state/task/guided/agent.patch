+  <script>
+    const iframe = document.getElementById('roast-video');
+    const mainSlot = document.getElementById('main-video-slot');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const hero = document.querySelector('.hero');
+    const btn = document.getElementById('theater-btn');
+
+    // moveBefore() moves the node atomically, so the iframe keeps playing and doesn't reload.
+    // Older browsers (e.g. Safari) fall back to insertBefore(), which reloads the iframe.
+    function moveIframe(parent) {
+      if ('moveBefore' in Element.prototype) {
+        parent.moveBefore(iframe, null);
+      } else {
+        parent.insertBefore(iframe, null);
+      }
+    }
+
+    btn.addEventListener('click', () => {
+      const on = !hero.classList.contains('theater');
+      // Reveal the hero slot before moving so the iframe is never moved into a display:none parent.
+      hero.classList.toggle('theater', on);
+      moveIframe(on ? heroSlot : mainSlot);
+      btn.setAttribute('aria-pressed', on);
+      btn.textContent = on ? 'Exit theater mode' : 'Theater mode';
+      if (on) hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
+    });
+  </script>
+
