+  <script>
+    (function () {
+      var list = document.querySelector('.SwipeableList');
+      var emptyMsg = document.querySelector('.cart-empty');
+      var THRESHOLD = 0.4; // fraction of item width that triggers removal
+
+      function remove(item, track) {
+        // Slide off screen, then collapse the height
+        var dir = track.dataset.dir === '-1' ? -1 : 1;
+        track.style.transform = 'translateX(' + dir * 100 + '%)';
+        item.style.height = item.offsetHeight + 'px';
+        item.offsetHeight; // force reflow so the height transition has a start value
+        item.classList.add('is-collapsing');
+
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          item.remove();
+          if (!list.children.length) emptyMsg.hidden = false;
+        }
+        item.addEventListener('transitionend', function (e) {
+          if (e.target === item && e.propertyName === 'height') finish();
+        });
+        setTimeout(finish, 600); // fallback (e.g. reduced motion)
+      }
+
+      Array.prototype.forEach.call(list.querySelectorAll('.SwipeableList-item'), function (item) {
+        var track = item.querySelector('.SwipeableList-track');
+        var startX = 0, dx = 0, active = false;
+
+        track.addEventListener('pointerdown', function (e) {
+          if (item.classList.contains('is-collapsing')) return;
+          active = true;
+          startX = e.clientX;
+          dx = 0;
+          item.classList.add('is-dragging');
+          track.setPointerCapture(e.pointerId);
+        });
+
+        track.addEventListener('pointermove', function (e) {
+          if (!active) return;
+          dx = e.clientX - startX;
+          track.dataset.dir = dx < 0 ? '-1' : '1';
+          track.style.transform = 'translateX(' + dx + 'px)';
+          item.classList.toggle('is-past-threshold', Math.abs(dx) > item.offsetWidth * THRESHOLD);
+        });
+
+        function end() {
+          if (!active) return;
+          active = false;
+          item.classList.remove('is-dragging');
+          if (Math.abs(dx) > item.offsetWidth * THRESHOLD) {
+            remove(item, track);
+          } else {
+            track.style.transform = '';
+            item.classList.remove('is-past-threshold');
+          }
+        }
+        track.addEventListener('pointerup', end);
+        track.addEventListener('pointercancel', end);
+      });
+    })();
+  </script>
