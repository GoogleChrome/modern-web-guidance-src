+  <script>
+    (() => {
+      const button = document.querySelector('[data-testid="register-button"]');
+      const status = document.getElementById('register-status');
+
+      const postJSON = (url, body) => fetch(url, {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(body)
+      });
+
+      // Gate the button on passkey support
+      (async () => {
+        if (!window.PublicKeyCredential ||
+          !PublicKeyCredential.parseCreationOptionsFromJSON ||
+          !PublicKeyCredential.getClientCapabilities) {
+          status.textContent = 'Passkeys are not supported in this browser.';
+          return;
+        }
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.passkeyPlatformAuthenticator && capabilities.conditionalGet) {
+          button.disabled = false;
+        } else {
+          status.textContent = 'Passkeys are not available on this device.';
+        }
+      })();
+
+      async function registerPasskey() {
+        status.textContent = '';
+        button.disabled = true;
+        try {
+          const optionsResponse = await postJSON('/api/register/options', { promotion: true });
+          if (!optionsResponse.ok) throw new Error('options request failed');
+          const optionsJSON = await optionsResponse.json();
+          const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+          let credential;
+          try {
+            credential = await navigator.credentials.create({ publicKey });
+          } catch (err) {
+            if (err.name === 'InvalidStateError') {
+              status.textContent = 'A passkey already exists for this account.';
+            } else if (err.name === 'SecurityError') {
+              status.textContent = 'Passkeys cannot be used on this site configuration.';
+            } else if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') {
+              status.textContent = 'Could not create a passkey.';
+            }
+            return; // cancellations are not errors
+          }
+
+          const encoded = credential.toJSON();
+          let verified = false;
+          try {
+            verified = (await postJSON('/api/register/verify', encoded)).ok;
+          } catch (err) {
+            console.error('Passkey verification request failed', err);
+          }
+
+          if (verified) {
+            status.textContent = 'Passkey created successfully.';
+          } else {
+            status.textContent = 'Passkey could not be verified. Please try again.';
+            // Tell the passkey provider to remove the orphaned credential
+            if (PublicKeyCredential.signalUnknownCredential) {
+              try {
+                await PublicKeyCredential.signalUnknownCredential({
+                  rpId: publicKey.rp?.id ?? optionsJSON.rp.id,
+                  credentialId: encoded.id
+                });
+              } catch (err) {
+                console.error('signalUnknownCredential failed', err);
+              }
+            }
+          }
+        } catch (err) {
+          console.error('Passkey registration failed', err);
+          status.textContent = 'Passkey registration failed. Please try again.';
+        } finally {
+          button.disabled = false;
+        }
+      }
+
+      button.addEventListener('click', registerPasskey);
+    })();
+  </script>
