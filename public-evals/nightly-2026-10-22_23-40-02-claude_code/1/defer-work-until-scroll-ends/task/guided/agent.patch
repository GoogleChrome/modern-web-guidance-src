+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const beans = [...scroller.querySelectorAll('.bean')];
+    let scrolling = false;
+    let endTimer;
+
+    function mostVisibleOrigin() {
+      const view = scroller.getBoundingClientRect();
+      let best = null;
+      let bestOverlap = -1;
+      for (const bean of beans) {
+        const r = bean.getBoundingClientRect();
+        const overlap = Math.min(r.right, view.right) - Math.max(r.left, view.left);
+        if (overlap > bestOverlap) {
+          bestOverlap = overlap;
+          best = bean;
+        }
+      }
+      return best.dataset.origin;
+    }
+
+    function onScrollEnd() {
+      scrolling = false;
+      status.textContent = `Scroll ended. Visible: ${mostVisibleOrigin()}`;
+    }
+
+    // Cheap per-event work: a flag check, plus a single DOM write when scrolling starts.
+    const supportsScrollEnd = 'onscrollend' in window;
+    scroller.addEventListener('scroll', () => {
+      if (!scrolling) {
+        scrolling = true;
+        status.textContent = 'Scrolling...';
+      }
+      if (!supportsScrollEnd) {
+        clearTimeout(endTimer);
+        endTimer = setTimeout(onScrollEnd, 150);
+      }
+    }, { passive: true });
+
+    if (supportsScrollEnd) scroller.addEventListener('scrollend', onScrollEnd);
+  </script>
