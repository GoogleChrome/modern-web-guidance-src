+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var status = document.getElementById('status');
+      var beans = scroller.querySelectorAll('.bean');
+      var scrolling = false;
+      var timer;
+
+      // Runs once per scroll gesture, only after scrolling stops.
+      function mostVisibleOrigin() {
+        var box = scroller.getBoundingClientRect();
+        var best = null, bestVisible = -1;
+        beans.forEach(function (bean) {
+          var r = bean.getBoundingClientRect();
+          var visible = Math.min(r.right, box.right) - Math.max(r.left, box.left);
+          if (visible > bestVisible) { bestVisible = visible; best = bean; }
+        });
+        return best.dataset.origin;
+      }
+
+      function onEnd() {
+        clearTimeout(timer);
+        scrolling = false;
+        status.textContent = 'Scroll ended. Visible: ' + mostVisibleOrigin();
+      }
+
+      // Hot path: a flag check and a single DOM write at scroll start; no layout reads.
+      scroller.addEventListener('scroll', function () {
+        if (!scrolling) {
+          scrolling = true;
+          status.textContent = 'Scrolling...';
+        }
+        if (!('onscrollend' in window)) {
+          clearTimeout(timer);
+          timer = setTimeout(onEnd, 150);
+        }
+      }, { passive: true });
+
+      if ('onscrollend' in window) {
+        scroller.addEventListener('scrollend', onEnd);
+      }
+    })();
+  </script>
