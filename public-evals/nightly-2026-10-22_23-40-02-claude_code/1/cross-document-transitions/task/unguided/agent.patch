+    /* Page transitions */
+    @media (prefers-reduced-motion: no-preference) {
+      @view-transition {
+        navigation: auto;
+      }
+
+      @keyframes slide-out-left { to { opacity: 0; transform: translateX(-60px); } }
+      @keyframes slide-out-right { to { opacity: 0; transform: translateX(60px); } }
+      @keyframes slide-in-right { from { opacity: 0; transform: translateX(60px); } }
+      @keyframes slide-in-left { from { opacity: 0; transform: translateX(-60px); } }
+      @keyframes fade-out { to { opacity: 0; } }
+      @keyframes fade-in { from { opacity: 0; } }
+
+      /* Default: simple cross-fade */
+      ::view-transition-old(root) {
+        animation: 250ms ease both fade-out;
+      }
+
+      ::view-transition-new(root) {
+        animation: 250ms ease both fade-in;
+      }
+
+      /* Next: old content exits left, new content enters from the right */
+      html:active-view-transition-type(next) {
+        &::view-transition-old(root) {
+          animation: 350ms ease both slide-out-left;
+        }
+
+        &::view-transition-new(root) {
+          animation: 350ms ease both slide-in-right;
+        }
+      }
+
+      /* Previous: old content exits right, new content enters from the left */
+      html:active-view-transition-type(previous) {
+        &::view-transition-old(root) {
+          animation: 350ms ease both slide-out-right;
+        }
+
+        &::view-transition-new(root) {
+          animation: 350ms ease both slide-in-left;
+        }
+      }
