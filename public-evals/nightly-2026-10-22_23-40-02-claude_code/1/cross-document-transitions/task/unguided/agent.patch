+  <script>
+    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      // Page number from the ?page= param (defaults to 1)
+      const pageOf = (url) => Number(new URL(url).searchParams.get('page')) || 1;
+
+      // Returns 'next' / 'previous' when navigating between pages of the listing
+      const transitionTypeFor = (fromUrl, toUrl) => {
+        if (!fromUrl || !toUrl) return null;
+        const from = new URL(fromUrl);
+        const to = new URL(toUrl);
+        if (from.origin !== to.origin || from.pathname !== to.pathname) return null;
+        const diff = pageOf(to) - pageOf(from);
+        return diff > 0 ? 'next' : diff < 0 ? 'previous' : null;
+      };
+
+      // Incoming page: apply the type once the new page is revealed
+      window.addEventListener('pagereveal', (event) => {
+        if (!event.viewTransition || !navigation.activation?.from) return;
+        const type = transitionTypeFor(navigation.activation.from.url, navigation.activation.entry.url);
+        if (type) event.viewTransition.types.add(type);
+      });
+
+      // Outgoing page: apply the same type so the old content animates out accordingly
+      window.addEventListener('pageswap', (event) => {
+        if (!event.viewTransition || !event.activation) return;
+        const type = transitionTypeFor(event.activation.from?.url, event.activation.entry?.url);
+        if (type) event.viewTransition.types.add(type);
+      });
+    }
+  </script>
+
