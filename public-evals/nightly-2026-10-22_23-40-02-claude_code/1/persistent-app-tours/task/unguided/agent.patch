     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <div id="tour-step" popover="manual" role="dialog" aria-label="Rewards tour">
+    <p>Earn points with every purchase and redeem them for free drinks!</p>
+    <button type="button" class="btn" popovertarget="tour-step" popovertargetaction="hide">Got it</button>
+  </div>
+
+  <script>
+    (function () {
+      var link = document.getElementById('feature');
+      var step = document.getElementById('tour-step');
+
+      // Keep the user on the page while the tour step is showing
+      link.addEventListener('click', function (e) {
+        if (step.matches(':popover-open')) e.preventDefault();
+      });
+
+      // Fallback for browsers without CSS anchor positioning
+      var native = CSS.supports('anchor-name', '--a');
+      function place() {
+        var r = link.getBoundingClientRect();
+        step.style.top = r.bottom + 'px';
+        step.style.left = Math.max(8, r.left + r.width / 2 - step.offsetWidth / 2) + 'px';
+      }
+      if (!native) {
+        window.addEventListener('scroll', place, true);
+        window.addEventListener('resize', place);
+      }
+
+      // Open by default; popover="manual" ignores outside clicks and Esc
+      step.showPopover();
+      if (!native) place();
+    })();
+  </script>
+
 </body>
 
