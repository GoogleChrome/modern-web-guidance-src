+  <script>
+    (function () {
+      const canvas = document.getElementById('canvas');
+      const form = document.getElementById('order-form');
+      const status = document.getElementById('order-status');
+      const section = document.getElementById('customizer');
+      const ctx = canvas.getContext('2d');
+
+      // Logical (CSS px) drawing space and where the form sits on the cup.
+      const W = 340, H = 460;
+      const FORM_X = 55, FORM_Y = 118;
+
+      const LIQUID = { none: '#3e2723', maple: '#8d4e1c', vanilla: '#a9825a', caramel: '#b9722b' };
+      const MILK_TINT = { whole: 0.25, oat: 0.2, almond: 0.15, none: 0 };
+
+      const submit = (e) => {
+        e.preventDefault();
+        const data = new FormData(form);
+        const name = (data.get('name') || '').toString().trim() || 'Guest';
+        const syrup = data.get('syrup') === 'none' ? 'no syrup' : data.get('syrup') + ' syrup';
+        const milk = data.get('milk') === 'none' ? 'no milk' : data.get('milk') + ' milk';
+        status.textContent = 'Added for ' + name + ': ' + milk + ', ' + syrup + '.';
+        requestDraw();
+      };
+      form.addEventListener('submit', submit);
+      form.addEventListener('change', () => requestDraw());
+
+      const supported = typeof ctx.drawElementImage === 'function';
+      if (!supported) {
+        // Canvas children are not rendered here, so show the same form as normal HTML.
+        section.classList.add('no-html-in-canvas');
+        canvas.after(form);
+        return;
+      }
+
+      function requestDraw() {
+        canvas.requestPaint();
+      }
+
+      function drawCup() {
+        const data = new FormData(form);
+        const liquid = LIQUID[data.get('syrup')] || LIQUID.none;
+        const milk = MILK_TINT[data.get('milk')] || 0;
+
+        // Saucer
+        ctx.fillStyle = '#d7ccc8';
+        ctx.beginPath();
+        ctx.ellipse(170, 424, 150, 22, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.fillStyle = '#bcaaa4';
+        ctx.beginPath();
+        ctx.ellipse(170, 420, 110, 14, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Handle
+        ctx.strokeStyle = '#fafafa';
+        ctx.lineWidth = 16;
+        ctx.beginPath();
+        ctx.arc(318, 220, 52, -Math.PI / 2, Math.PI / 2);
+        ctx.stroke();
+        ctx.strokeStyle = '#bcaaa4';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.arc(318, 220, 60, -Math.PI / 2, Math.PI / 2);
+        ctx.stroke();
+
+        // Cup body
+        ctx.fillStyle = '#fafafa';
+        ctx.strokeStyle = '#bcaaa4';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(20, 70);
+        ctx.lineTo(320, 70);
+        ctx.lineTo(300, 370);
+        ctx.quadraticCurveTo(295, 415, 250, 415);
+        ctx.lineTo(90, 415);
+        ctx.quadraticCurveTo(45, 415, 40, 370);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+
+        // Coffee surface (color follows syrup choice, lightened by milk)
+        ctx.fillStyle = liquid;
+        ctx.beginPath();
+        ctx.ellipse(170, 70, 150, 20, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.fillStyle = 'rgba(255, 248, 235, ' + milk + ')';
+        ctx.fill();
+        ctx.stroke();
+
+        // Steam
+        ctx.strokeStyle = 'rgba(78, 52, 46, 0.35)';
+        ctx.lineWidth = 4;
+        ctx.lineCap = 'round';
+        for (const x of [130, 170, 210]) {
+          ctx.beginPath();
+          ctx.moveTo(x, 40);
+          ctx.bezierCurveTo(x - 14, 28, x + 14, 16, x, 4);
+          ctx.stroke();
+        }
+        ctx.lineCap = 'butt';
+      }
+
+      function paint() {
+        ctx.reset();
+        const dpr = canvas.width / W;
+        ctx.scale(dpr, dpr);
+        drawCup();
+        // Draw the live HTML form onto the cup, then sync its DOM position/hit-testing
+        // with where it was drawn so clicks, focus rings and a11y bounds line up.
+        const transform = ctx.drawElementImage(form, FORM_X, FORM_Y);
+        form.style.transform = transform.toString();
+      }
+
+      // Keep the backing store at physical-pixel resolution (handles DPR and zoom changes).
+      function resize(entry) {
+        const box = entry && entry.devicePixelContentBoxSize && entry.devicePixelContentBoxSize[0];
+        const w = box ? box.inlineSize : Math.round(W * window.devicePixelRatio);
+        const h = box ? box.blockSize : Math.round(H * window.devicePixelRatio);
+        if (canvas.width !== w || canvas.height !== h) {
+          canvas.width = w;
+          canvas.height = h;
+        }
+        requestDraw();
+      }
+
+      canvas.onpaint = paint;
+      const observer = new ResizeObserver((entries) => resize(entries[0]));
+      try {
+        observer.observe(canvas, { box: 'device-pixel-content-box' });
+      } catch (e) {
+        observer.observe(canvas);
+      }
+      resize();
+    })();
+  </script>
+
