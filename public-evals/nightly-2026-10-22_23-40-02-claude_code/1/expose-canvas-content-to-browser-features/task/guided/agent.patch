+  <script>
+    const stage = document.getElementById('cup-stage');
+    const canvas = document.getElementById('canvas');
+    const form = document.getElementById('order-form');
+    const summary = document.getElementById('order-summary');
+    const ctx = canvas.getContext('2d');
+
+    // HTML-in-Canvas keeps the form in the canvas; otherwise layer it on top
+    const nativeHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+    if (!nativeHtmlInCanvas) {
+      form.removeAttribute('drawable');
+      stage.append(form);
+    }
+
+    // Cup geometry as fractions of the canvas CSS size, shared by drawing and form placement
+    const CUP = { top: 0.1, bottom: 0.96, topLeft: 0.04, topRight: 0.84, botLeft: 0.12, botRight: 0.76 };
+    const FORM = { x: 0.14, y: 0.2, w: 0.6, h: 0.72 };
+
+    function drawCup(w, h) {
+      // Lid
+      ctx.fillStyle = '#4e342e';
+      ctx.beginPath();
+      ctx.roundRect(w * (CUP.topLeft - 0.02), h * 0.04, w * (CUP.topRight - CUP.topLeft + 0.04), h * 0.06, 8);
+      ctx.fill();
+
+      // Handle
+      ctx.strokeStyle = '#d7ccc8';
+      ctx.lineWidth = w * 0.045;
+      ctx.beginPath();
+      ctx.ellipse(w * 0.84, h * 0.4, w * 0.12, h * 0.1, 0, -Math.PI / 2, Math.PI / 2);
+      ctx.stroke();
+
+      // Body
+      ctx.beginPath();
+      ctx.moveTo(w * CUP.topLeft, h * CUP.top);
+      ctx.lineTo(w * CUP.topRight, h * CUP.top);
+      ctx.lineTo(w * CUP.botRight, h * CUP.bottom);
+      ctx.lineTo(w * CUP.botLeft, h * CUP.bottom);
+      ctx.closePath();
+      ctx.fillStyle = '#fff8f0';
+      ctx.fill();
+      ctx.lineWidth = 3;
+      ctx.strokeStyle = '#4e342e';
+      ctx.stroke();
+    }
+
+    function placeForm(w, h) {
+      form.style.width = `${w * FORM.w}px`;
+      form.style.height = `${h * FORM.h}px`;
+      if (!nativeHtmlInCanvas) {
+        form.style.left = `${w * FORM.x}px`;
+        form.style.top = `${h * FORM.y}px`;
+      }
+    }
+
+    function paint() {
+      const w = canvas.clientWidth;
+      const h = canvas.clientHeight;
+      if (!w || !h) return;
+      // Draw in CSS pixels; the transform maps them onto the hi-dpi backing store
+      const scale = canvas.width / w;
+      ctx.reset();
+      ctx.setTransform(scale, 0, 0, scale, 0, 0);
+      drawCup(w, h);
+      placeForm(w, h);
+      if (nativeHtmlInCanvas) {
+        // Also syncs the DOM hit-test and accessibility bounds with the drawn position
+        ctx.drawElementImage(form, w * FORM.x, h * FORM.y);
+      }
+    }
+
+    if (nativeHtmlInCanvas) {
+      canvas.onpaint = paint;
+    }
+
+    // Match the backing store to device pixels to avoid blurriness
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+      if (nativeHtmlInCanvas) {
+        canvas.requestPaint();
+      } else {
+        paint();
+      }
+    });
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== 'undefined' &&
+      'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+    observer.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(form);
+      const name = data.get('name').trim();
+      const syrups = data.getAll('syrup');
+      summary.textContent =
+        `${name ? `${name}, your` : 'Your'} order: ${data.get('milk')}` +
+        (syrups.length ? ` with ${syrups.join(' & ')} syrup.` : ', no syrup.');
+    });
+  </script>
+
