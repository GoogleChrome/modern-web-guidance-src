+  <script>
+    // Defer poster, source and media data for offscreen players until they approach the viewport.
+    (function () {
+      var players = document.querySelectorAll('.lazy-media');
+
+      function load(el) {
+        if (el.dataset.poster) el.poster = el.dataset.poster;
+        var source = document.createElement('source');
+        source.src = el.dataset.src;
+        source.type = el.dataset.type;
+        el.appendChild(source);
+        el.preload = 'metadata';
+        el.load();
+      }
+
+      if (!('IntersectionObserver' in window)) {
+        players.forEach(load);
+        return;
+      }
+
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (!entry.isIntersecting) return;
+          observer.unobserve(entry.target);
+          load(entry.target);
+        });
+      }, { rootMargin: '300px 0px' });
+
+      players.forEach(function (el) { observer.observe(el); });
+    })();
+  </script>
+
