+  <script>
+    // Respect reduced motion: don't autoplay the hero loop
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    function syncReducedMotion() {
+      for (const video of document.querySelectorAll('video[autoplay]')) {
+        if (reducedMotion.matches) {
+          video.removeAttribute('autoplay');
+          video.pause();
+        }
+      }
+    }
+    syncReducedMotion();
+    reducedMotion.addEventListener('change', syncReducedMotion);
+
+    // Fallback for browsers without native loading="lazy" on media (Firefox, Safari)
+    if (!Object.hasOwn(HTMLMediaElement.prototype, 'loading')) {
+      const observer = new IntersectionObserver((entries, obs) => {
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          const media = entry.target;
+          if (media.dataset.poster) media.poster = media.dataset.poster;
+          media.preload = media.dataset.preload || 'metadata';
+          media.load();
+          obs.unobserve(media);
+        }
+      }, { rootMargin: '200px 0px' });
+
+      for (const media of document.querySelectorAll('video[loading="lazy"], audio[loading="lazy"][controls]')) {
+        if (media.hasAttribute('poster')) {
+          media.dataset.poster = media.getAttribute('poster');
+          media.removeAttribute('poster');
+        }
+        media.dataset.preload = media.getAttribute('preload') || 'metadata';
+        media.preload = 'none';
+        observer.observe(media);
+      }
+    }
+  </script>
