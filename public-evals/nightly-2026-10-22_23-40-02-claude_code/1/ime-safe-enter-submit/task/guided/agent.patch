@@ -206,7 +264,43 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackText = document.getElementById('feedback-text');
+    const feedbackStatus = document.getElementById('feedback-status');
+
+    // Enter sends; Shift+Enter inserts a newline.
+    feedbackText.addEventListener('keydown', (event) => {
+      if (event.key === 'Enter' && !event.shiftKey) {
+        event.preventDefault();
+        // Enter confirms IME composition; don't submit mid-composition.
+        if (event.isComposing || event.keyCode === 229) return;
+        feedbackForm.requestSubmit();
+      }
+    });
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const button = feedbackForm.querySelector('button[type="submit"]');
+      button.disabled = true;
+      feedbackStatus.textContent = '';
+      try {
+        const response = await fetch(feedbackForm.action, {
+          method: 'POST',
+          body: new FormData(feedbackForm),
+        });
+        if (!response.ok) throw new Error(response.status);
+        feedbackForm.reset();
+        feedbackStatus.textContent = 'Thanks for your feedback!';
+      } catch {
+        feedbackStatus.textContent = 'Sorry, something went wrong. Please try again.';
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
 </html>
