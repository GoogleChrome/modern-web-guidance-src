+      overflow: hidden;
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      height: 200px;
+      object-fit: cover;
+    }
+
+    .nested-curve-footer {
+      background: var(--primary);
+      color: white;
+      padding: 14px 16px;
+      text-align: center;
+    }
+
+    @supports (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        overflow: clip;
+        /* Clips children along the inner (content-box) curve, no calc() needed */
+        overflow-clip-margin: content-box;
+      }
+    }
+
+    .safety-zone-parent {
+      background: var(--secondary);
+      padding: 30px;
+      border-radius: 12px;
+      text-align: center;
+      /* Fallback: clips the glow too */
+      overflow: hidden;
+    }
+
+    .safety-zone-parent h3 {
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    .glow-btn {
+      margin-top: 20px;
+      padding: 12px 28px;
+      border: none;
+      border-radius: 6px;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 1rem;
+      font-weight: bold;
+      cursor: pointer;
+      box-shadow: 0 0 12px 6px rgba(255, 171, 64, 0.8),
+        0 0 15px 8px rgba(255, 171, 64, 0.5);
+    }
+
+    @supports (overflow-clip-margin: 15px) {
+      .safety-zone-parent {
+        overflow: clip;
+        /* 15px safety zone lets the glow bleed out while text stays clipped */
+        overflow-clip-margin: 15px;
+      }
+    }
   </style>
