+    /* Showcase */
+    .showcase {
+      margin-bottom: 40px;
+    }
+
+    .showcase h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    /* Clips children at the content box; the browser derives the concentric inner curve from radius - border - padding */
+    .nested-curve-parent {
+      background: white;
+      border: 6px solid var(--primary);
+      padding: 28px;
+      border-radius: 40px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: clip;
+      overflow-clip-margin: content-box;
+    }
+
+    .nested-curve-parent .showcase-media {
+      background: linear-gradient(135deg, var(--primary), var(--accent));
+      color: white;
+      padding: 40px 28px;
+    }
+
+    .nested-curve-parent .showcase-footer {
+      background: var(--secondary);
+      padding: 16px 28px;
+    }
+
+    /* Clips overflowing content, but lets the glow bleed 15px past the edge */
+    .safety-zone-parent {
+      background: var(--primary);
+      color: white;
+      text-align: center;
+      padding: 40px 20px;
+      border-radius: 12px;
+      margin-top: 40px;
+      overflow: clip;
+      overflow-clip-margin: 15px;
+    }
+
+    .glow-btn {
+      display: inline-block;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      font-size: 1.1rem;
+      padding: 14px 32px;
+      border: 0;
+      border-radius: 999px;
+      cursor: pointer;
+      margin-top: 15px;
+      box-shadow: 0 0 20px 6px rgba(255, 171, 64, 0.8),
+        0 0 45px 12px rgba(255, 171, 64, 0.45);
+    }
+
