+  <script type="module">
+    // Load the WebAuthn JSON helpers only where the browser lacks them.
+    async function ensureWebAuthnHelpers() {
+      if (
+        PublicKeyCredential.parseCreationOptionsFromJSON &&
+        PublicKeyCredential.getClientCapabilities &&
+        typeof PublicKeyCredential.prototype.toJSON === 'function'
+      ) return;
+      await import('https://esm.sh/webauthn-polyfills');
+    }
+
+    // Silently promote a passkey right after a successful password sign-in.
+    // Never surfaces UI or errors to the user.
+    async function triggerConditionalCreate(signal) {
+      try {
+        if (!window.PublicKeyCredential) return;
+        await ensureWebAuthnHelpers();
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalCreate !== true) return;
+
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ conditional: true }),
+          signal,
+        });
+        if (!optionsResponse.ok) return;
+        const optionsJSON = await optionsResponse.json();
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+        let credential;
+        try {
+          credential = await navigator.credentials.create({
+            publicKey,
+            mediation: 'conditional',
+            signal,
+          });
+        } catch (e) {
+          // InvalidStateError (already registered), NotAllowedError, AbortError: ignore.
+          return;
+        }
+        if (!credential) return;
+
+        const encoded = credential.toJSON();
+        let verified = false;
+        try {
+          const verifyResponse = await fetch('/api/register/verify', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ ...encoded, conditional: true }),
+          });
+          verified = verifyResponse.ok;
+        } catch (e) { /* treated as failed verification */ }
+
+        if (!verified && PublicKeyCredential.signalUnknownCredential) {
+          // Keep the passkey provider from retaining an orphaned credential.
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: optionsJSON.rp?.id ?? location.hostname,
+            credentialId: encoded.id,
+          });
+        }
+      } catch (e) {
+        // Background enhancement only; stay silent.
+      }
+    }
+
+    // Aborting this also clears any pending autofill (conditional get) request.
+    const signinAbort = new AbortController();
+
+    document.getElementById('signin-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Password sign-in is considered successful here; no sign-in backend is defined yet.
+      // Run in the background without awaiting.
+      triggerConditionalCreate(signinAbort.signal);
+    });
+  </script>
+
