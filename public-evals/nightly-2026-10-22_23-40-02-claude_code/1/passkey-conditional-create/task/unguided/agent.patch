+  <script>
+    // Silently create a passkey for the signed-in user (conditional creation).
+    // Every failure is swallowed: this must never surface any UI.
+    const b64urlToBuffer = (v) => {
+      const b64 = v.replace(/-/g, '+').replace(/_/g, '/');
+      const bin = atob(b64 + '='.repeat((4 - b64.length % 4) % 4));
+      return Uint8Array.from(bin, (c) => c.charCodeAt(0)).buffer;
+    };
+
+    const bufferToB64url = (buf) => {
+      let bin = '';
+      new Uint8Array(buf).forEach((b) => { bin += String.fromCharCode(b); });
+      return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    };
+
+    const parseCreationOptions = (json) => {
+      if (PublicKeyCredential.parseCreationOptionsFromJSON) {
+        return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+      }
+      return {
+        ...json,
+        challenge: b64urlToBuffer(json.challenge),
+        user: { ...json.user, id: b64urlToBuffer(json.user.id) },
+        excludeCredentials: (json.excludeCredentials || []).map((c) => ({ ...c, id: b64urlToBuffer(c.id) })),
+      };
+    };
+
+    const serializeCredential = (cred) => {
+      if (typeof cred.toJSON === 'function') return cred.toJSON();
+      const r = cred.response;
+      return {
+        id: cred.id,
+        rawId: bufferToB64url(cred.rawId),
+        type: cred.type,
+        authenticatorAttachment: cred.authenticatorAttachment,
+        clientExtensionResults: cred.getClientExtensionResults(),
+        response: {
+          clientDataJSON: bufferToB64url(r.clientDataJSON),
+          attestationObject: bufferToB64url(r.attestationObject),
+          transports: r.getTransports ? r.getTransports() : [],
+        },
+      };
+    };
+
+    async function promotePasskey(username) {
+      try {
+        if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) return;
+        const caps = await PublicKeyCredential.getClientCapabilities();
+        if (!caps || !caps.conditionalCreate) return;
+
+        const optRes = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({ username }),
+        });
+        if (!optRes.ok) return;
+        const options = await optRes.json();
+
+        const credential = await navigator.credentials.create({
+          publicKey: parseCreationOptions(options),
+          mediation: 'conditional',
+        });
+        if (!credential) return;
+
+        await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(serializeCredential(credential)),
+        });
+      } catch (e) {
+        // Intentionally silent.
+      }
+    }
+
+    document.getElementById('signin-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const username = new FormData(event.target).get('username');
+      // Password sign-in is considered successful here; promote in the background.
+      promotePasskey(username);
+    });
+  </script>
+
