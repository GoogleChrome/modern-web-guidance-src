+  <script type="module">
+    // Hydrates server-rendered <menu-card> elements. The markup (including the
+    // declarative shadow root) is already in the HTML, so we adopt the existing
+    // shadow root and only attach behavior; nothing is re-rendered.
+    class MenuCard extends HTMLElement {
+      #count = 0;
+
+      connectedCallback() {
+        // Fallback for browsers without declarative shadow DOM support.
+        if (!this.shadowRoot) {
+          const tpl = this.querySelector(':scope > template[shadowrootmode]');
+          if (tpl) {
+            this.attachShadow({ mode: tpl.getAttribute('shadowrootmode') }).append(tpl.content);
+            tpl.remove();
+          }
+        }
+        const root = this.shadowRoot;
+        if (!root) return;
+        this.#count = Number(this.getAttribute('count')) || 0;
+        this.button = root.querySelector('.add');
+        this.button.addEventListener('click', this.#onAdd);
+        this.button.dataset.ready = '';
+        this.#sync();
+      }
+
+      disconnectedCallback() {
+        this.button?.removeEventListener('click', this.#onAdd);
+      }
+
+      #onAdd = () => {
+        this.#count++;
+        this.setAttribute('count', this.#count);
+        this.#sync();
+        this.dispatchEvent(new CustomEvent('add-to-order', {
+          bubbles: true, composed: true,
+          detail: { price: Number(this.getAttribute('price')), count: this.#count }
+        }));
+      };
+
+      // Only touch the DOM when state differs from what the server rendered.
+      #sync() {
+        const label = this.#count ? `Add to Order (${this.#count})` : 'Add to Order';
+        if (this.button.textContent !== label) this.button.textContent = label;
+      }
+    }
+    customElements.define('menu-card', MenuCard);
+  </script>
 
