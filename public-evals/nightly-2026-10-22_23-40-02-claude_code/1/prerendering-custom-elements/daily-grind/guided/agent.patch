+  <script type="module">
+    // Server markup ships the shadow root (declarative shadow DOM). Hydration only
+    // attaches behavior to that existing tree; it never re-renders it.
+
+    class MenuCard extends HTMLElement {
+      static observedAttributes = ['favorite'];
+
+      constructor() {
+        super();
+        if (!this.shadowRoot) {
+          // Engines without DSD leave the template inert: attach from the same markup.
+          this.attachShadow({ mode: 'open' });
+          const tpl = this.querySelector(':scope > template[shadowrootmode]');
+          if (tpl) {
+            this.shadowRoot.append(tpl.content);
+            tpl.remove();
+          }
+        }
+        this.#button = this.shadowRoot.getElementById('fav');
+        this.#button?.addEventListener('click', () => this.toggleAttribute('favorite'));
+        this.#sync();
+      }
+
+      #button;
+
+      attributeChangedCallback() {
+        this.#sync();
+      }
+
+      #sync() {
+        if (!this.#button) return;
+        const on = this.hasAttribute('favorite');
+        this.#button.setAttribute('aria-pressed', on);
+        this.#button.textContent = on ? '\u2605' : '\u2606';
+      }
+    }
+
+    customElements.define('menu-card', MenuCard);
+  </script>
