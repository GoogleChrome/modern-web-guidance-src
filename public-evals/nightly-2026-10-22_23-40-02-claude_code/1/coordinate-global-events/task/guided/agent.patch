+  <script type="module">
+    // Temporal is not available everywhere yet (e.g. Safari); load a polyfill if needed.
+    if (typeof Temporal === 'undefined') {
+      const { Temporal: T } = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = T;
+    }
+
+    const TARGETS = [
+      { label: 'New York', zone: 'America/New_York' },
+      { label: 'London', zone: 'Europe/London' },
+      { label: 'Tokyo', zone: 'Asia/Tokyo' },
+      { label: 'UTC', zone: 'UTC' },
+    ];
+    const TIME_FMT = { hour: 'numeric', minute: '2-digit' };
+    const DAY_FMT = { weekday: 'short', month: 'short', day: 'numeric' };
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const hostWarning = document.getElementById('hostWarning');
+    const grid = document.getElementById('grid');
+
+    dateInput.value = Temporal.Now.plainDateISO().add({ days: 7 }).toString();
+
+    function fmt(zdt, options) {
+      return zdt.toLocaleString('en-US', options);
+    }
+
+    // Returns { zdt, warning } where zdt is the resolved ZonedDateTime.
+    function resolveHost(date, time, zone) {
+      const wall = `${date}T${time}[${zone}]`;
+      try {
+        return { zdt: Temporal.ZonedDateTime.from(wall, { disambiguation: 'reject' }), warning: '' };
+      } catch (e) {
+        if (!(e instanceof RangeError)) throw e;
+      }
+
+      // Time is in a gap or overlap; 'compatible' is the default resolution.
+      const zdt = Temporal.ZonedDateTime.from(wall, { disambiguation: 'compatible' });
+      const earlier = Temporal.ZonedDateTime.from(wall, { disambiguation: 'earlier' });
+      const later = Temporal.ZonedDateTime.from(wall, { disambiguation: 'later' });
+      const asked = fmt(Temporal.PlainTime.from(time), TIME_FMT);
+      const day = fmt(Temporal.PlainDate.from(date), { month: 'long', day: 'numeric', year: 'numeric' });
+      const resolved = `${fmt(zdt, TIME_FMT)} ${fmt(zdt, { timeZoneName: 'short' }).split(' ').pop()}`;
+
+      let warning;
+      if (earlier.toPlainTime().equals(later.toPlainTime())) {
+        // Same wall-clock time at two different offsets: clocks were set back.
+        warning = `${asked} happens twice in ${zone} on ${day} because clocks are set back. `
+          + `We used the first occurrence (${resolved}). The second occurrence is at ${fmt(later, { timeZoneName: 'short' })}.`;
+      } else {
+        // Wall-clock time was skipped: clocks jumped forward.
+        warning = `${asked} does not exist in ${zone} on ${day} because clocks jump forward. `
+          + `We moved it ahead by the length of the gap to ${resolved}.`;
+      }
+      return { zdt, warning };
+    }
+
+    function render() {
+      const { value: date } = dateInput;
+      const { value: time } = timeInput;
+      grid.replaceChildren();
+      hostWarning.hidden = true;
+      if (!date || !time) return;
+
+      const { zdt, warning } = resolveHost(date, time, hostTzSelect.value);
+      if (warning) {
+        hostWarning.textContent = warning;
+        hostWarning.hidden = false;
+      }
+
+      // withTimeZone returns new objects; the host ZonedDateTime is never mutated.
+      grid.append(...TARGETS.map(({ label, zone }) => {
+        const local = zdt.withTimeZone(zone);
+        const card = document.createElement('div');
+        card.className = 'card';
+        const h3 = document.createElement('h3');
+        h3.textContent = label;
+        const t = document.createElement('p');
+        t.className = 'time';
+        t.textContent = fmt(local, TIME_FMT);
+        const meta = document.createElement('p');
+        meta.className = 'meta';
+        meta.textContent = `${fmt(local, DAY_FMT)} · UTC${local.offset}`;
+        card.append(h3, t, meta);
+        return card;
+      }));
+    }
+
+    for (const el of [dateInput, timeInput, hostTzSelect]) {
+      el.addEventListener('input', render);
+      el.addEventListener('change', render);
+    }
+    render();
+  </script>
