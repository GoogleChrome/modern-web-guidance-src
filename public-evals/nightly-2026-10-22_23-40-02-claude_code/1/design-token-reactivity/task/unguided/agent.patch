+    /* Layout density toggle: hidden unless the browser supports style queries */
+    :root {
+      --style-query-check: supported;
+    }
+
+    #toggle-spacious {
+      display: none;
+      margin: 10px auto 0;
+      background: transparent;
+      color: var(--primary);
+      border: 1px solid var(--primary);
+      padding: 6px 14px;
+      border-radius: 5px;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+    }
+
+    #toggle-spacious[aria-pressed="true"] {
+      background: var(--primary);
+      color: white;
+    }
+
+    @container style(--style-query-check: supported) {
+      #toggle-spacious {
+        display: block;
+      }
+    }
+
+    #target-item {
+      transition: padding 0.3s;
+    }
+
+    /* The card reacts to the density property set on #target-container */
+    @container style(--layout-density: spacious) {
+      #target-item {
+        padding: 44px 32px;
+      }
+    }
+
