+  <script>
+    const detectBtn = document.getElementById('detect-btn');
+    const messageInput = document.getElementById('feedback-message');
+    const statusEl = document.getElementById('detect-status');
+
+    if (!('LanguageDetector' in self)) {
+      detectBtn.disabled = true;
+      statusEl.textContent = 'Language detection is not supported in this browser.';
+    } else {
+      LanguageDetector.availability().then((availability) => {
+        if (availability === 'unavailable') {
+          detectBtn.disabled = true;
+          statusEl.textContent = 'Language detection is not available on this device.';
+        }
+      });
+
+      detectBtn.addEventListener('click', async () => {
+        const text = messageInput.value.trim();
+        if (!text) {
+          statusEl.textContent = 'Please enter a message first.';
+          return;
+        }
+
+        detectBtn.disabled = true;
+        try {
+          // create() must run from the click (user activation) in case a download is needed
+          const detector = await LanguageDetector.create({
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                statusEl.textContent = `Downloading language model: ${Math.round(e.loaded * 100)}%`;
+              });
+            },
+          });
+          const [top] = await detector.detect(text);
+          if (!top || top.detectedLanguage === 'und') {
+            statusEl.textContent = 'Could not determine the language.';
+          } else {
+            const name = new Intl.DisplayNames(['en'], { type: 'language' }).of(top.detectedLanguage);
+            statusEl.textContent = `Language: ${name} (${(top.confidence * 100).toFixed(1)}% confident)`;
+          }
+        } catch (err) {
+          statusEl.textContent = `Detection failed: ${err.message}`;
+        } finally {
+          detectBtn.disabled = false;
+        }
+      });
+    }
+  </script>
+
 </body>
 
