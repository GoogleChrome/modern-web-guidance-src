+  <script>
+    const detectBtn = document.getElementById('detect-btn');
+    const messageEl = document.getElementById('feedback-message');
+    const statusEl = document.getElementById('detect-status');
+
+    const languageNames = new Intl.DisplayNames([navigator.language || 'en'], { type: 'language' });
+
+    function languageName(code) {
+      try {
+        return languageNames.of(code) || code;
+      } catch {
+        return code;
+      }
+    }
+
+    async function detectLanguage() {
+      const text = messageEl.value.trim();
+      if (!text) {
+        statusEl.textContent = 'Please enter a message first.';
+        return;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        statusEl.textContent = 'Language detection is not supported in this browser.';
+        detectBtn.disabled = true;
+        return;
+      }
+
+      detectBtn.disabled = true;
+      try {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          statusEl.textContent = 'Language detection is not available on this device.';
+          return;
+        }
+
+        if (availability !== 'available') {
+          statusEl.textContent = 'Downloading language model: 0%';
+        } else {
+          statusEl.textContent = 'Detecting…';
+        }
+
+        const detector = await LanguageDetector.create({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              statusEl.textContent = `Downloading language model: ${Math.round(e.loaded * 100)}%`;
+            });
+          }
+        });
+
+        const [best] = await detector.detect(text);
+        if (!best || best.detectedLanguage === 'und') {
+          statusEl.textContent = 'Could not determine the language.';
+          return;
+        }
+
+        const confidence = (best.confidence * 100).toFixed(1);
+        statusEl.textContent =
+          `Language: ${languageName(best.detectedLanguage)} (${best.detectedLanguage}) — ${confidence}% confident`;
+      } catch (err) {
+        statusEl.textContent = `Language detection failed: ${err.message}`;
+      } finally {
+        if ('LanguageDetector' in self) detectBtn.disabled = false;
+      }
+    }
+
+    detectBtn.addEventListener('click', detectLanguage);
+  </script>
+
