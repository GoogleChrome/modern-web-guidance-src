+  <script>
+    (function () {
+      var TIME_BUDGET_MS = 8; // work per slice, well under a 16ms frame
+      var AXES = ['acidity', 'sweetness', 'bitterness', 'body', 'aroma'];
+      var ORIGINS = ['Ethiopia', 'Colombia', 'Brazil', 'Kenya', 'Sumatra', 'Guatemala'];
+      var ROASTS = ['Light', 'Medium', 'Dark'];
+      var TARGET = { acidity: 0.45, sweetness: 0.65, bitterness: 0.3, body: 0.6, aroma: 0.75 };
+
+      var form = document.getElementById('lab-form');
+      var countInput = document.getElementById('lab-count');
+      var seedInput = document.getElementById('lab-seed');
+      var runBtn = document.getElementById('lab-run');
+      var cancelBtn = document.getElementById('lab-cancel');
+      var bar = document.getElementById('lab-bar');
+      var progress = document.getElementById('lab-progress');
+      var statusEl = document.getElementById('lab-status');
+      var resultsEl = document.getElementById('lab-results');
+      var cancelled = false;
+
+      // Small deterministic PRNG so runs are reproducible
+      function mulberry32(a) {
+        return function () {
+          a |= 0; a = (a + 0x6D2B79F5) | 0;
+          var t = Math.imul(a ^ (a >>> 15), 1 | a);
+          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+        };
+      }
+
+      function clamp(x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
+
+      // Simulate one blend: random recipe -> flavor vector -> score vs. target
+      function simulateBlend(rand) {
+        var roast = rand();            // 0 light .. 1 dark
+        var grind = rand();            // 0 coarse .. 1 fine
+        var temp = 88 + rand() * 10;   // brew temp C
+        var time = 20 + rand() * 280;  // brew seconds
+        var origin = (rand() * ORIGINS.length) | 0;
+        var extraction = clamp(0.3 * grind + 0.4 * (time / 300) + 0.3 * ((temp - 88) / 10));
+        var over = Math.max(0, extraction - 0.6);
+        var noise = function () { return (rand() - 0.5) * 0.1; };
+
+        var f = {
+          acidity: clamp(0.9 - roast * 0.7 + (origin === 0 || origin === 3 ? 0.2 : 0) - over * 0.3 + noise()),
+          sweetness: clamp(0.3 + Math.sin(roast * Math.PI) * 0.4 + extraction * 0.2 - over * 0.4 + noise()),
+          bitterness: clamp(roast * 0.5 + over * 1.2 + (origin === 4 ? 0.1 : 0) + noise()),
+          body: clamp(0.2 + roast * 0.3 + extraction * 0.4 + (origin === 4 || origin === 2 ? 0.15 : 0) + noise()),
+          aroma: clamp(0.85 - Math.abs(roast - 0.4) * 0.8 - Math.abs(extraction - 0.5) * 0.3 + noise())
+        };
+
+        var dist = 0;
+        for (var i = 0; i < AXES.length; i++) {
+          var d = f[AXES[i]] - TARGET[AXES[i]];
+          dist += d * d;
+        }
+        return {
+          score: 100 * (1 - Math.sqrt(dist / AXES.length)),
+          flavor: f,
+          origin: ORIGINS[origin],
+          roast: ROASTS[Math.min(2, (roast * 3) | 0)],
+          temp: temp,
+          time: time
+        };
+      }
+
+      // Hand control back to the browser so input and rendering can run.
+      function yieldToMain() {
+        if (window.scheduler && typeof scheduler.yield === 'function') return scheduler.yield();
+        return new Promise(function (resolve) { setTimeout(resolve, 0); });
+      }
+
+      function setProgress(pct, text) {
+        bar.style.width = pct + '%';
+        progress.setAttribute('aria-valuenow', Math.round(pct));
+        statusEl.textContent = text;
+      }
+
+      async function runSimulation(total, seed) {
+        var rand = mulberry32(seed);
+        var best = [];
+        var sums = {};
+        AXES.forEach(function (a) { sums[a] = 0; });
+        var scoreSum = 0;
+        var done = 0;
+        var start = performance.now();
+        var sliceStart = start;
+
+        while (done < total) {
+          if (cancelled) return null;
+          // Process in small inner batches, checking the clock between them
+          var end = Math.min(total, done + 200);
+          for (; done < end; done++) {
+            var r = simulateBlend(rand);
+            scoreSum += r.score;
+            for (var i = 0; i < AXES.length; i++) sums[AXES[i]] += r.flavor[AXES[i]];
+            if (best.length < 5 || r.score > best[best.length - 1].score) {
+              best.push(r);
+              best.sort(function (a, b) { return b.score - a.score; });
+              if (best.length > 5) best.pop();
+            }
+          }
+          if (performance.now() - sliceStart >= TIME_BUDGET_MS) {
+            setProgress(done / total * 100, 'Simulated ' + done.toLocaleString() + ' of ' + total.toLocaleString() + ' blends…');
+            await yieldToMain();
+            sliceStart = performance.now();
+          }
+        }
+
+        var avg = {};
+        AXES.forEach(function (a) { avg[a] = sums[a] / total; });
+        return { best: best, avg: avg, meanScore: scoreSum / total, ms: performance.now() - start };
+      }
+
+      function render(res, total) {
+        resultsEl.textContent = '';
+
+        var top = document.createElement('div');
+        top.className = 'card';
+        var h = document.createElement('h4');
+        h.textContent = 'Top 5 blends';
+        var ol = document.createElement('ol');
+        res.best.forEach(function (b) {
+          var li = document.createElement('li');
+          li.textContent = b.roast + ' ' + b.origin + ', ' + b.temp.toFixed(1) + '°C, ' +
+            Math.round(b.time) + 's — ' + b.score.toFixed(1);
+          ol.appendChild(li);
+        });
+        top.appendChild(h);
+        top.appendChild(ol);
+
+        var prof = document.createElement('div');
+        prof.className = 'card';
+        var h2 = document.createElement('h4');
+        h2.textContent = 'Average flavor profile';
+        prof.appendChild(h2);
+        AXES.forEach(function (a) {
+          var row = document.createElement('div');
+          row.className = 'axis-row';
+          var label = document.createElement('span');
+          label.textContent = a;
+          var track = document.createElement('div');
+          track.className = 'track';
+          var fill = document.createElement('div');
+          fill.className = 'fill';
+          fill.style.width = (res.avg[a] * 100).toFixed(0) + '%';
+          track.appendChild(fill);
+          var val = document.createElement('span');
+          val.textContent = res.avg[a].toFixed(2);
+          row.appendChild(label);
+          row.appendChild(track);
+          row.appendChild(val);
+          prof.appendChild(row);
+        });
+
+        var sum = document.createElement('div');
+        sum.className = 'card';
+        var h3 = document.createElement('h4');
+        h3.textContent = 'Summary';
+        var p = document.createElement('p');
+        p.textContent = total.toLocaleString() + ' blends, mean score ' + res.meanScore.toFixed(1) +
+          ', finished in ' + (res.ms / 1000).toFixed(2) + 's.';
+        sum.appendChild(h3);
+        sum.appendChild(p);
+
+        resultsEl.appendChild(top);
+        resultsEl.appendChild(prof);
+        resultsEl.appendChild(sum);
+      }
+
+      function setRunning(running) {
+        runBtn.disabled = running;
+        cancelBtn.disabled = !running;
+        countInput.disabled = running;
+        seedInput.disabled = running;
+      }
+
+      form.addEventListener('submit', async function (e) {
+        e.preventDefault();
+        var total = Math.max(100, Math.min(2000000, parseInt(countInput.value, 10) || 0));
+        var seed = parseInt(seedInput.value, 10) || 0;
+        countInput.value = total;
+        cancelled = false;
+        setRunning(true);
+        resultsEl.textContent = '';
+        setProgress(0, 'Starting…');
+        try {
+          var res = await runSimulation(total, seed);
+          if (res) {
+            setProgress(100, 'Done.');
+            render(res, total);
+          } else {
+            setProgress(0, 'Cancelled.');
+          }
+        } finally {
+          setRunning(false);
+        }
+      });
+
+      cancelBtn.addEventListener('click', function () { cancelled = true; });
+    })();
+  </script>
+
 </body>
 
