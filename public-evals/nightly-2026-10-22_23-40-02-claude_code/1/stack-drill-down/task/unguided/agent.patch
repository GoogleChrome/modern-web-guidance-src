+  <div id="stack"></div>
+
+  <script>
+    // Hash routes keep deep links working on any static host:
+    //   #/                      -> home
+    //   #/seasonal/<item-slug>  -> detail screen pushed on top of home
+    const ITEMS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte', price: '$5.75', cal: '210 cal',
+        img: 'photo-1572442388796-11668a67e53d',
+        desc: 'Creamy oat milk with a hint of Vermont maple syrup, pulled over a double shot of our house espresso and finished with a dusting of cinnamon.',
+        notes: ['Maple syrup', 'Toasted oat', 'Cinnamon']
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso', price: '$3.50', cal: '5 cal',
+        img: 'photo-1510591509098-f4fdc6d0ff04',
+        desc: 'Bold, smokey, and perfect for a morning boost. Roasted in small batches each week and pulled as a rich, syrupy double.',
+        notes: ['Dark chocolate', 'Smoke', 'Molasses']
+      },
+      'cold-brew': {
+        name: 'Cold Brew', price: '$4.75', cal: '15 cal',
+        img: 'photo-1461023058943-07fcbe16d735',
+        desc: 'Steeped for 18 hours for maximum smoothness, then served over ice. Low acidity, high refreshment.',
+        notes: ['Cocoa', 'Brown sugar', 'Smooth finish']
+      }
+    };
+
+    const stack = document.getElementById('stack');
+    const root = document.documentElement;
+    const screens = {};
+    let depth = 0;        // in-app entries pushed on top of the entry page
+    let lastTrigger = null;
+
+    function parseRoute() {
+      const m = location.hash.match(/^#\/seasonal\/([\w-]+)$/);
+      return m && ITEMS[m[1]] ? m[1] : null;
+    }
+
+    function esc(t) {
+      const d = document.createElement('div');
+      d.textContent = t;
+      return d.innerHTML;
+    }
+
+    function build(slug) {
+      const it = ITEMS[slug];
+      const el = document.createElement('section');
+      el.className = 'screen detail';
+      el.setAttribute('role', 'dialog');
+      el.setAttribute('aria-label', it.name);
+      el.innerHTML =
+        '<div class="detail-bar">' +
+          '<button type="button" class="back-btn" aria-label="Back to home">&larr; Back</button>' +
+          '<span class="detail-crumb">Seasonal Favorites</span>' +
+        '</div>' +
+        '<div class="detail-image" style="background-image:url(\'https://images.unsplash.com/' + it.img + '?auto=format&fit=crop&w=1350&q=80\')"></div>' +
+        '<div class="detail-body">' +
+          '<h1>' + esc(it.name) + '</h1>' +
+          '<p class="detail-meta">' + it.price + ' &middot; ' + it.cal + '</p>' +
+          '<p>' + esc(it.desc) + '</p>' +
+          '<ul>' + it.notes.map(n => '<li>' + esc(n) + '</li>').join('') + '</ul>' +
+          '<a href="/order-online" class="btn">Order Now</a>' +
+        '</div>';
+      el.querySelector('.back-btn').addEventListener('click', goBack);
+      enableSwipeBack(el);
+      stack.appendChild(el);
+      return el;
+    }
+
+    function goBack() {
+      if (depth > 0) history.back();
+      else location.replace('#/'); // deep link: no in-app history to pop
+    }
+
+    function render() {
+      const slug = parseRoute();
+      Object.entries(screens).forEach(([k, el]) => {
+        const on = k === slug;
+        el.classList.toggle('active', on);
+        el.inert = !on;
+        el.setAttribute('aria-hidden', String(!on));
+      });
+      if (slug) {
+        const el = screens[slug] || (screens[slug] = build(slug));
+        // ensure the initial (hidden) state paints before animating in
+        void el.offsetWidth;
+        el.classList.add('active');
+        el.inert = false;
+        el.setAttribute('aria-hidden', 'false');
+        el.scrollTop = 0;
+        document.title = ITEMS[slug].name + ' | The Daily Grind';
+        el.querySelector('.back-btn').focus({ preventScroll: true });
+      } else {
+        document.title = 'The Daily Grind | Artisanal Coffee';
+        if (lastTrigger) lastTrigger.focus({ preventScroll: true });
+      }
+      root.classList.toggle('stack-open', !!slug);
+    }
+
+    // Track how many in-app entries sit above the entry page so Back/swipe
+    // can use real history when it exists.
+    document.addEventListener('click', e => {
+      const a = e.target.closest('a[data-drill]');
+      if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.button) return;
+      e.preventDefault();
+      lastTrigger = a;
+      history.pushState({ depth: depth + 1 }, '', a.getAttribute('href'));
+      depth += 1;
+      render();
+    });
+
+    window.addEventListener('popstate', e => {
+      depth = (e.state && e.state.depth) || 0;
+      render();
+    });
+    window.addEventListener('hashchange', render);
+
+    document.addEventListener('keydown', e => {
+      if (e.key === 'Escape' && parseRoute()) goBack();
+    });
+
+    function enableSwipeBack(el) {
+      let x0 = 0, y0 = 0, dx = 0, t0 = 0, tracking = false, locked = false;
+      el.addEventListener('touchstart', e => {
+        if (e.touches.length !== 1) return;
+        x0 = e.touches[0].clientX;
+        y0 = e.touches[0].clientY;
+        dx = 0; t0 = Date.now(); locked = false;
+        tracking = x0 < 40 || x0 < window.innerWidth * 0.5;
+      }, { passive: true });
+      el.addEventListener('touchmove', e => {
+        if (!tracking) return;
+        const mx = e.touches[0].clientX - x0;
+        const my = e.touches[0].clientY - y0;
+        if (!locked) {
+          if (Math.abs(my) > 10 && Math.abs(my) > Math.abs(mx)) { tracking = false; return; }
+          if (mx > 10 && mx > Math.abs(my)) { locked = true; el.classList.add('dragging'); }
+          else return;
+        }
+        dx = Math.max(0, mx);
+        el.style.transform = 'translateX(' + dx + 'px)';
+      }, { passive: true });
+      const end = () => {
+        if (!tracking || !locked) { tracking = false; return; }
+        tracking = false;
+        el.classList.remove('dragging');
+        const fast = dx / Math.max(1, Date.now() - t0) > 0.5;
+        if (dx > window.innerWidth * 0.35 || (fast && dx > 40)) {
+          el.style.transform = '';
+          goBack();
+        } else {
+          el.style.transform = '';
+        }
+      };
+      el.addEventListener('touchend', end);
+      el.addEventListener('touchcancel', end);
+    }
+
+    // Normalize the entry page's state, then render any deep link.
+    history.replaceState({ depth: 0 }, '');
+    render();
+  </script>
+
