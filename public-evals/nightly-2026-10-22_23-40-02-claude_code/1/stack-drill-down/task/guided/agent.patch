+
+  <script>
+    const ITEMS = {
+      seasonal: {
+        title: 'Maple Oat Latte',
+        desc: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        long: 'Two shots of our house espresso, steamed barista-style oat milk and a drizzle of small-batch Vermont maple syrup. Cozy, lightly sweet and dairy-free.',
+        meta: ['Hot or iced', 'Dairy-free', '12 / 16 oz'],
+        img: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1350&q=80'
+      },
+      espresso: {
+        title: 'Dark Roast Espresso',
+        desc: 'Bold, smokey, and perfect for a morning boost.',
+        long: 'Our darkest roast, pulled as a rich double shot with a thick crema and notes of cocoa and toasted oak. Enjoy it straight or as the base for any drink.',
+        meta: ['Single or double', 'Vegan', 'Dark roast'],
+        img: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=1350&q=80'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        desc: 'Steeped for 18 hours for maximum smoothness.',
+        long: 'Coarsely ground beans steeped in cold water for 18 hours, then filtered and served over ice. Low acidity, naturally sweet and extra smooth.',
+        meta: ['Served iced', 'Vegan', '16 / 24 oz'],
+        img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1350&q=80'
+      }
+    };
+
+    const home = document.getElementById('home');
+    const detail = document.getElementById('detail');
+    const titleEl = document.getElementById('detail-title');
+    let current = { depth: 0, slug: null };
+    let homeScroll = 0;
+
+    // Routes live in the hash so deep links work on any static host.
+    function parseRoute() {
+      const m = location.hash.match(/^#\/menu\/([\w-]+)$/);
+      return m && Object.hasOwn(ITEMS, m[1]) ? m[1] : null;
+    }
+
+    function show(slug) {
+      if (slug) {
+        const item = ITEMS[slug];
+        homeScroll = home.scrollTop;
+        home.hidden = true;
+        detail.hidden = false;
+        detail.scrollTop = 0;
+        titleEl.textContent = item.title;
+        document.title = item.title + ' | The Daily Grind';
+        document.getElementById('detail-desc').textContent = item.desc;
+        document.getElementById('detail-long').textContent = item.long;
+        const hero = document.getElementById('detail-hero');
+        hero.style.backgroundImage = `url('${item.img}')`;
+        hero.setAttribute('aria-label', item.title);
+        document.getElementById('detail-meta').replaceChildren(
+          ...item.meta.map(t => Object.assign(document.createElement('li'), { textContent: t }))
+        );
+      } else {
+        detail.hidden = true;
+        home.hidden = false;
+        home.scrollTop = homeScroll;
+        document.title = 'The Daily Grind | Artisanal Coffee';
+      }
+    }
+
+    // Renders the route matching the URL, animating in the direction of travel.
+    function render() {
+      const slug = parseRoute();
+      const next = { depth: slug ? 1 : 0, slug };
+      const prev = current;
+      if (slug === prev.slug) return;
+      current = next;
+
+      const update = () => show(slug);
+      const settle = () => {
+        (slug ? titleEl : home.querySelector('h2')).focus({ preventScroll: true });
+        document.querySelectorAll('.card.selected').forEach(c => c.classList.remove('selected'));
+      };
+
+      if (!document.startViewTransition) {
+        update();
+        settle();
+        return;
+      }
+
+      // Shared title morphs between the card and the detail heading.
+      const shared = slug || prev.slug;
+      document.querySelector(`.card[data-slug="${shared}"]`)?.classList.add('selected');
+      const transition = document.startViewTransition({
+        update,
+        types: [next.depth >= prev.depth ? 'forward' : 'backward']
+      });
+      transition.finished.finally(settle);
+    }
+
+    function go(hash) {
+      if (location.hash === hash) return;
+      history.pushState({ app: true }, '', hash);
+      render();
+    }
+
+    function back() {
+      if (history.state?.app) history.back();
+      else {
+        // Deep link entry: no in-app history to pop, so replace with home.
+        history.replaceState({ app: true }, '', location.pathname + location.search);
+        render();
+      }
+    }
+
+    document.addEventListener('click', e => {
+      const a = e.target.closest('a[data-route]');
+      if (!a || e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+      e.preventDefault();
+      go(a.getAttribute('href'));
+    });
+
+    document.getElementById('back').addEventListener('click', back);
+    addEventListener('popstate', render);
+    addEventListener('keydown', e => { if (e.key === 'Escape' && !detail.hidden) back(); });
+
+    // Edge swipe (left edge, rightwards) pops the detail screen.
+    let swipe = null;
+    detail.addEventListener('touchstart', e => {
+      const t = e.touches[0];
+      swipe = t.clientX < 32 ? { x: t.clientX, y: t.clientY } : null;
+    }, { passive: true });
+    detail.addEventListener('touchend', e => {
+      if (!swipe) return;
+      const t = e.changedTouches[0];
+      const dx = t.clientX - swipe.x, dy = Math.abs(t.clientY - swipe.y);
+      swipe = null;
+      if (dx > 70 && dy < dx / 2) back();
+    }, { passive: true });
+
+    // Initial render (deep link).
+    if (parseRoute()) {
+      history.replaceState({ app: false }, '');
+      show(parseRoute());
+      current = { depth: 1, slug: parseRoute() };
+    }
+  </script>
