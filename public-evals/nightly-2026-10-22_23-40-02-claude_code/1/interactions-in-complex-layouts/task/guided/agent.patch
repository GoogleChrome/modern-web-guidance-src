+  <script>
+    (() => {
+      const board = document.getElementById('order-board');
+      const status = document.getElementById('board-status');
+      const columns = [...board.querySelectorAll('.board-column')];
+      const THRESHOLD = 4;
+
+      let drag = null; // { card, ghost, pointerId, startX, startY, offX, offY, rects, over, raf, x, y, active }
+
+      function updateCount(column) {
+        column.querySelector('.board-count').textContent =
+          column.querySelector('.card-list').childElementCount;
+      }
+
+      function moveCard(card, column) {
+        const from = card.closest('.board-column');
+        if (from === column) return;
+        // Only the two affected (contained) columns are touched
+        column.querySelector('.card-list').append(card);
+        updateCount(from);
+        updateCount(column);
+        status.textContent = `${card.querySelector('h3').textContent} moved to ${column.dataset.status}`;
+      }
+
+      function columnAt(x, y) {
+        // Rects were cached at drag start, so no layout reads while moving
+        for (let i = 0; i < drag.rects.length; i++) {
+          const r = drag.rects[i];
+          if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) return columns[i];
+        }
+        return null;
+      }
+
+      function frame() {
+        drag.raf = 0;
+        drag.ghost.style.transform = `translate3d(${drag.x - drag.offX}px, ${drag.y - drag.offY}px, 0)`;
+        const over = columnAt(drag.x, drag.y);
+        if (over !== drag.over) {
+          drag.over?.classList.remove('drop-target');
+          over?.classList.add('drop-target');
+          drag.over = over;
+        }
+      }
+
+      function startDrag(e) {
+        const { card } = drag;
+        const rect = card.getBoundingClientRect();
+        drag.offX = drag.startX - rect.left;
+        drag.offY = drag.startY - rect.top;
+        drag.rects = columns.map((c) => c.getBoundingClientRect());
+        const ghost = card.cloneNode(true);
+        ghost.removeAttribute('tabindex');
+        ghost.classList.add('drag-ghost');
+        ghost.style.width = `${rect.width}px`;
+        // Ghost lives on <body>, outside the columns' paint containment
+        document.body.append(ghost);
+        drag.ghost = ghost;
+        card.classList.add('is-dragging');
+        drag.active = true;
+      }
+
+      function endDrag(drop) {
+        if (!drag) return;
+        const d = drag;
+        drag = null;
+        if (d.raf) cancelAnimationFrame(d.raf);
+        if (d.active) {
+          d.ghost.remove();
+          d.card.classList.remove('is-dragging');
+          d.over?.classList.remove('drop-target');
+          if (drop && d.over) moveCard(d.card, d.over);
+        }
+      }
+
+      board.addEventListener('pointerdown', (e) => {
+        const card = e.target.closest('.card');
+        if (!card || e.button !== 0 || drag) return;
+        card.setPointerCapture(e.pointerId);
+        drag = { card, pointerId: e.pointerId, startX: e.clientX, startY: e.clientY,
+                 x: e.clientX, y: e.clientY, active: false, over: null, raf: 0 };
+      });
+
+      board.addEventListener('pointermove', (e) => {
+        if (!drag || e.pointerId !== drag.pointerId) return;
+        drag.x = e.clientX;
+        drag.y = e.clientY;
+        if (!drag.active) {
+          if (Math.hypot(drag.x - drag.startX, drag.y - drag.startY) < THRESHOLD) return;
+          startDrag(e);
+        }
+        if (!drag.raf) drag.raf = requestAnimationFrame(frame);
+      });
+
+      board.addEventListener('pointerup', (e) => {
+        if (drag && e.pointerId === drag.pointerId) endDrag(true);
+      });
+      board.addEventListener('pointercancel', () => endDrag(false));
+      board.addEventListener('lostpointercapture', () => endDrag(false));
+
+      // Keyboard alternative: left/right arrows move the focused card
+      board.addEventListener('keydown', (e) => {
+        const card = e.target.closest('.card');
+        if (!card || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
+        e.preventDefault();
+        const i = columns.indexOf(card.closest('.board-column')) + (e.key === 'ArrowRight' ? 1 : -1);
+        if (columns[i]) {
+          moveCard(card, columns[i]);
+          card.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
