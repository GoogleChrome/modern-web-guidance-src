+  <script>
+    (function () {
+      var board = document.getElementById('board');
+      var columns = Array.prototype.slice.call(board.querySelectorAll('.board-column'));
+      var drag = null;
+
+      function updateCount(col) {
+        col.querySelector('.board-count').textContent = col.querySelector('.board-list').children.length;
+      }
+
+      columns.forEach(updateCount);
+
+      // Insert before the first card whose midpoint is below y (binary search: O(log n) layout reads, once per drop)
+      function insertAt(list, card, y) {
+        var kids = list.children, lo = 0, hi = kids.length;
+        while (lo < hi) {
+          var mid = (lo + hi) >> 1;
+          if (kids[mid] === card) { lo = mid + 1; continue; }
+          var r = kids[mid].getBoundingClientRect();
+          if (y < r.top + r.height / 2) hi = mid; else lo = mid + 1;
+        }
+        list.insertBefore(card, kids[lo] || null);
+      }
+
+      function moveCard(card, col, y) {
+        var from = card.closest('.board-column');
+        var list = col.querySelector('.board-list');
+        if (y == null) list.appendChild(card); else insertAt(list, card, y);
+        if (from !== col) { updateCount(from); updateCount(col); }
+      }
+
+      function columnAt(d, x, y) {
+        // Uses rects cached at drag start, so pointer moves never read layout
+        for (var i = 0; i < d.rects.length; i++) {
+          var r = d.rects[i];
+          if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) return columns[i];
+        }
+        return null;
+      }
+
+      function setTarget(col) {
+        if (drag.target === col) return;
+        if (drag.target) drag.target.classList.remove('drop-target');
+        if (col) col.classList.add('drop-target');
+        drag.target = col;
+      }
+
+      function render() {
+        drag.raf = 0;
+        drag.ghost.style.transform = 'translate3d(' + (drag.x - drag.dx) + 'px,' + (drag.y - drag.dy) + 'px,0)';
+        setTarget(columnAt(drag, drag.x, drag.y));
+      }
+
+      function endDrag(drop) {
+        if (!drag) return;
+        var d = drag; drag = null;
+        if (d.raf) cancelAnimationFrame(d.raf);
+        window.removeEventListener('pointermove', onMove);
+        window.removeEventListener('pointerup', onUp);
+        window.removeEventListener('pointercancel', onCancel);
+        if (d.target) d.target.classList.remove('drop-target');
+        var col = drop ? columnAt(d, d.x, d.y) : null;
+        d.ghost.remove();
+        d.card.classList.remove('is-dragging');
+        if (col) moveCard(d.card, col, d.y);
+      }
+
+      function onMove(e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        drag.x = e.clientX; drag.y = e.clientY;
+        if (!drag.raf) drag.raf = requestAnimationFrame(render);
+      }
+      function onUp(e) { if (drag && e.pointerId === drag.id) endDrag(true); }
+      function onCancel(e) { if (drag && e.pointerId === drag.id) endDrag(false); }
+
+      board.addEventListener('pointerdown', function (e) {
+        var card = e.target.closest('.card');
+        if (!card || drag || (e.pointerType === 'mouse' && e.button !== 0)) return;
+        e.preventDefault();
+        var r = card.getBoundingClientRect();
+        var ghost = card.cloneNode(true);
+        ghost.removeAttribute('tabindex');
+        ghost.classList.add('drag-ghost');
+        ghost.style.width = r.width + 'px';
+        ghost.style.transform = 'translate3d(' + r.left + 'px,' + r.top + 'px,0)';
+        document.body.appendChild(ghost);
+        card.classList.add('is-dragging');
+        drag = {
+          id: e.pointerId, card: card, ghost: ghost, raf: 0, target: null,
+          dx: e.clientX - r.left, dy: e.clientY - r.top, x: e.clientX, y: e.clientY,
+          rects: columns.map(function (c) { return c.getBoundingClientRect(); })
+        };
+        setTarget(columnAt(drag, e.clientX, e.clientY));
+        window.addEventListener('pointermove', onMove);
+        window.addEventListener('pointerup', onUp);
+        window.addEventListener('pointercancel', onCancel);
+      });
+
+      // Keyboard: arrow left/right moves the focused card between columns
+      board.addEventListener('keydown', function (e) {
+        var card = e.target.closest && e.target.closest('.card');
+        if (!card || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
+        var i = columns.indexOf(card.closest('.board-column')) + (e.key === 'ArrowRight' ? 1 : -1);
+        if (i < 0 || i >= columns.length) return;
+        e.preventDefault();
+        moveCard(card, columns[i]);
+        card.focus();
+      });
+    })();
+  </script>
+
