+#!/bin/sh
+# Builds smallpt.cpp to public/smallpt/smallpt.{js,wasm} (requires emscripten)
+cd "$(dirname "$0")" && em++ -O3 smallpt.cpp -o ../public/smallpt/smallpt.js \
+  -sMODULARIZE=1 -sEXPORT_NAME=createSmallpt -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH=1 -sEXPORTED_RUNTIME_METHODS=cwrap,HEAPU8 \
+  -sEXPORTED_FUNCTIONS=_set_color,_init,_render_rows,_malloc,_free
