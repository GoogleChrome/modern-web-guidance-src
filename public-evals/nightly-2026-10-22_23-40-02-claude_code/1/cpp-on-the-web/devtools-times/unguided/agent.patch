new file mode 100644
index 0000000..ddb16ed
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,23 @@
+// Runs the smallpt WebAssembly module off the main thread.
+importScripts('smallpt.js');
+
+const ready = createSmallpt();
+
+onmessage = async ({ data: { w, h, spp, colors } }) => {
+  const m = await ready;
+  const setColor = m.cwrap('set_color', null, ['number', 'number', 'number', 'number']);
+  const init = m.cwrap('init', 'number', ['number', 'number', 'number']);
+  const renderRows = m.cwrap('render_rows', null, ['number', 'number']);
+
+  colors.forEach(([i, r, g, b]) => setColor(i, r, g, b));
+  const ptr = init(w, h, spp);
+  const start = performance.now();
+  const chunk = 8;
+  for (let y = 0; y < h; y += chunk) {
+    renderRows(y, Math.min(y + chunk, h));
+    postMessage({ progress: Math.min(y + chunk, h) / h });
+  }
+  // Copy out of wasm memory (the heap may have been resized, so read HEAPU8 now)
+  const pixels = m.HEAPU8.slice(ptr, ptr + w * h * 4);
+  postMessage({ done: true, pixels, ms: performance.now() - start }, [pixels.buffer]);
+};
