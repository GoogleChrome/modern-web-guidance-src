+import createModule from './smallpt.js';
+
+const modulePromise = createModule();
+
+self.onmessage = async ({ data: { id, w, h, samples, seed, colors } }) => {
+  const m = await modulePromise;
+  const ptr = m._alloc_colors();
+  m.HEAPF64.set(colors, ptr / 8);
+  const out = m._render(w, h, samples, seed, ptr);
+  m._free_colors(ptr);
+  // Copy out of wasm memory (it may be reused or grown) and transfer it.
+  const pixels = m.HEAPU8.slice(out, out + w * h * 4);
+  self.postMessage({ id, w, h, pixels }, [pixels.buffer]);
+};
