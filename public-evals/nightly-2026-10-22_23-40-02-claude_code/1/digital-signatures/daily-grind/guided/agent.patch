+  <script type="module">
+    const DB_NAME = 'daily-grind-signing';
+    const KEY_ID = 'issuer';
+    const CONTEXT_PREFIX = 'daily-grind/v1/';
+    const KINDS = ['receipt', 'voucher'];
+    const ML_DSA = { 1312: 'ML-DSA-44', 1952: 'ML-DSA-65', 2592: 'ML-DSA-87' };
+    const enc = new TextEncoder();
+
+    const $ = (id) => document.getElementById(id);
+    const toB64 = (b) => btoa(String.fromCharCode(...new Uint8Array(b)));
+    const fromB64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
+
+    const supportsPQ = () =>
+      typeof globalThis.SubtleCrypto?.supports === 'function' && SubtleCrypto.supports('sign', 'ML-DSA-65');
+
+    // Classical Ed25519 has no context parameter, so frame the payload with a length-prefixed context.
+    function frame(payload, context) {
+      const out = new Uint8Array(1 + context.length + payload.length);
+      out[0] = context.length;
+      out.set(context, 1);
+      out.set(payload, 1 + context.length);
+      return out;
+    }
+
+    // --- Key storage: non-extractable keys persisted in IndexedDB (private key bytes never exposed to script) ---
+    const openDb = () => new Promise((resolve, reject) => {
+      const req = indexedDB.open(DB_NAME, 1);
+      req.onupgradeneeded = () => req.result.createObjectStore('keys');
+      req.onsuccess = () => resolve(req.result);
+      req.onerror = () => reject(req.error);
+    });
+    async function dbOp(mode, fn) {
+      const db = await openDb();
+      return new Promise((resolve, reject) => {
+        const req = fn(db.transaction('keys', mode).objectStore('keys'));
+        req.onsuccess = () => resolve(req.result);
+        req.onerror = () => reject(req.error);
+      });
+    }
+
+    async function createIssuer() {
+      const suite = supportsPQ() ? 'ML-DSA-65' : 'Ed25519';
+      const keyPair = await crypto.subtle.generateKey(suite, false, ['sign', 'verify']);
+      const publicKey = new Uint8Array(
+        await crypto.subtle.exportKey(suite === 'Ed25519' ? 'raw' : 'raw-public', keyPair.publicKey));
+      const record = { suite, keyPair, publicKey };
+      try { await dbOp('readwrite', (s) => s.put(record, KEY_ID)); } catch { /* session-only key */ }
+      return record;
+    }
+
+    let issuerPromise;
+    function getIssuer() {
+      issuerPromise ??= (async () => {
+        let record;
+        try { record = await dbOp('readonly', (s) => s.get(KEY_ID)); } catch { /* IndexedDB unavailable */ }
+        return record ?? createIssuer();
+      })();
+      return issuerPromise;
+    }
+
+    async function fingerprint(publicKey) {
+      const hash = new Uint8Array(await crypto.subtle.digest('SHA-256', publicKey));
+      return [...hash.slice(0, 8)].map((b) => b.toString(16).padStart(2, '0')).join(':');
+    }
+
+    // --- Sign / verify ---
+    async function signDocument(kind, fields) {
+      const { suite, keyPair, publicKey } = await getIssuer();
+      const payload = JSON.stringify({
+        kind,
+        id: crypto.randomUUID(),
+        issuedAt: new Date().toISOString(),
+        issuer: 'The Daily Grind',
+        ...fields,
+      });
+      const context = enc.encode(CONTEXT_PREFIX + kind);
+      const data = enc.encode(payload);
+      const signature = suite === 'Ed25519'
+        ? await crypto.subtle.sign('Ed25519', keyPair.privateKey, frame(data, context))
+        : await crypto.subtle.sign({ name: suite, context }, keyPair.privateKey, data);
+      // The signed bytes are the exact payload string, so no canonicalisation is needed.
+      return { v: 1, suite, payload, publicKey: toB64(publicKey), signature: toB64(signature) };
+    }
+
+    async function verifyDocument(doc) {
+      const publicKeyBytes = fromB64(doc.publicKey);
+      const mlName = ML_DSA[publicKeyBytes.length];
+      const suite = mlName ?? 'Ed25519';
+      if (doc.suite !== suite) throw new Error('Algorithm does not match the public key.');
+      const parsed = JSON.parse(doc.payload);
+      if (!KINDS.includes(parsed.kind)) throw new Error('Unknown document type.');
+      const context = enc.encode(CONTEXT_PREFIX + parsed.kind);
+      const data = enc.encode(doc.payload);
+      const signature = fromB64(doc.signature);
+      const key = await crypto.subtle.importKey(
+        mlName ? 'raw-public' : 'raw', publicKeyBytes, suite, true, ['verify']);
+      const valid = mlName
+        ? await crypto.subtle.verify({ name: suite, context }, key, signature, data)
+        : await crypto.subtle.verify('Ed25519', key, signature, frame(data, context));
+      return { valid, parsed, suite, publicKeyBytes };
+    }
+
+    // --- UI ---
+    const status = $('verify-status');
+    const setStatus = (state, text, meta) => {
+      status.dataset.state = state;
+      status.textContent = text;
+      if (meta) {
+        const p = document.createElement('p');
+        p.className = 'meta';
+        p.textContent = meta;
+        status.append(p);
+      }
+    };
+
+    const supportsEd25519 = () => crypto.subtle.generateKey('Ed25519', false, ['sign']).then(() => true, () => false);
+    const unsupported = !crypto?.subtle || !(supportsPQ() || await supportsEd25519());
+    if (unsupported) {
+      $('sign-form').querySelector('button[type="submit"]').disabled = true;
+      $('verify-btn').disabled = true;
+      setStatus('invalid', 'This browser does not support Ed25519 or ML-DSA signatures.');
+    }
+
+    getIssuer().then(async (i) => {
+      $('key-info').textContent = `Signing with ${i.suite}. Key fingerprint ${await fingerprint(i.publicKey)}`;
+    }).catch(() => {});
+
+    $('sign-form').addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const f = new FormData(e.currentTarget);
+      const amount = Number(f.get('amount'));
+      if (!(amount > 0)) return;
+      const doc = await signDocument(f.get('kind'), {
+        description: String(f.get('description')).trim(),
+        amount: amount.toFixed(2),
+        currency: 'USD',
+      });
+      $('signed-doc').value = JSON.stringify(doc, null, 2);
+      $('sign-output').hidden = false;
+    });
+
+    $('copy-doc').addEventListener('click', () => navigator.clipboard?.writeText($('signed-doc').value));
+    $('load-doc').addEventListener('click', () => {
+      $('verify-input').value = $('signed-doc').value;
+      $('verify-btn').click();
+    });
+
+    $('verify-btn').addEventListener('click', async () => {
+      try {
+        const doc = JSON.parse($('verify-input').value);
+        const { valid, parsed, suite, publicKeyBytes } = await verifyDocument(doc);
+        if (!valid) {
+          setStatus('invalid', 'Invalid: the signature does not match. The document was altered or forged.');
+          return;
+        }
+        const fp = await fingerprint(publicKeyBytes);
+        const own = await getIssuer();
+        const mine = toB64(own.publicKey) === doc.publicKey;
+        setStatus('valid',
+          `Authentic ${parsed.kind}: ${parsed.description}, $${parsed.amount} ${parsed.currency}, issued ${parsed.issuedAt}.`,
+          `${suite} signature verified. Signer key ${fp}${mine ? ' (this browser’s key)' : ' (a different key; confirm it belongs to The Daily Grind)'}. ID ${parsed.id}`);
+      } catch {
+        setStatus('invalid', 'Invalid: this is not a well-formed signed document.');
+      }
+    });
+  </script>
+
