+  <script>
+    (() => {
+      const $ = (id) => document.getElementById(id);
+      const ALG = { name: 'ECDSA', namedCurve: 'P-256' };
+      const SIG = { name: 'ECDSA', hash: 'SHA-256' };
+      const enc = new TextEncoder();
+
+      // Deterministic JSON: sorted keys, so signer and verifier hash identical bytes.
+      const canon = (v) => Array.isArray(v) ? '[' + v.map(canon).join(',') + ']'
+        : v && typeof v === 'object' ? '{' + Object.keys(v).sort().map((k) => JSON.stringify(k) + ':' + canon(v[k])).join(',') + '}'
+        : JSON.stringify(v);
+      const b64 = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf)));
+      const unb64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
+
+      const idb = () => new Promise((res, rej) => {
+        const r = indexedDB.open('daily-grind-signing', 1);
+        r.onupgradeneeded = () => r.result.createObjectStore('keys');
+        r.onsuccess = () => res(r.result);
+        r.onerror = () => rej(r.error);
+      });
+      const idbOp = async (mode, fn) => {
+        const db = await idb();
+        return new Promise((res, rej) => {
+          const req = fn(db.transaction('keys', mode).objectStore('keys'));
+          req.onsuccess = () => res(req.result);
+          req.onerror = () => rej(req.error);
+        });
+      };
+
+      async function getKeys() {
+        let keys = await idbOp('readonly', (s) => s.get('issuer'));
+        if (!keys) {
+          keys = await crypto.subtle.generateKey(ALG, false, ['sign', 'verify']);
+          await idbOp('readwrite', (s) => s.put(keys, 'issuer'));
+        }
+        return keys;
+      }
+      async function fingerprint(jwk) {
+        const d = await crypto.subtle.digest('SHA-256', enc.encode(canon({ crv: jwk.crv, kty: jwk.kty, x: jwk.x, y: jwk.y })));
+        return Array.from(new Uint8Array(d).slice(0, 16), (b) => b.toString(16).padStart(2, '0')).join(':');
+      }
+      const pubJwk = async (keys) => crypto.subtle.exportKey('jwk', keys.publicKey)
+        .then((j) => ({ crv: j.crv, kty: j.kty, x: j.x, y: j.y }));
+
+      function verdict(cls, msg) { const v = $('verdict'); v.className = 'verdict ' + cls; v.textContent = msg; }
+
+      $('doc-type').addEventListener('change', (e) => {
+        $('receipt-fields').hidden = e.target.value !== 'receipt';
+        $('voucher-fields').hidden = e.target.value === 'receipt';
+      });
+
+      $('sign-btn').addEventListener('click', async () => {
+        try {
+          const keys = await getKeys();
+          const id = crypto.randomUUID();
+          const issuedAt = new Date().toISOString();
+          let payload;
+          if ($('doc-type').value === 'receipt') {
+            const [item, price] = $('item').value.split('|');
+            const qty = Math.max(1, Math.min(50, parseInt($('qty').value, 10) || 1));
+            payload = { type: 'receipt', id, issuedAt, item, qty, total: (qty * parseFloat(price)).toFixed(2), currency: 'USD' };
+          } else {
+            const amount = Math.max(1, Math.min(500, parseInt($('amount').value, 10) || 0));
+            payload = { type: 'voucher', id, issuedAt, recipient: $('recipient').value.trim().slice(0, 80), amount: amount.toFixed(2), currency: 'USD' };
+          }
+          const jwk = await pubJwk(keys);
+          const sig = await crypto.subtle.sign(SIG, keys.privateKey, enc.encode(canon(payload)));
+          $('doc').value = JSON.stringify({ payload, signature: b64(sig), alg: 'ECDSA-P256-SHA256', publicKey: jwk }, null, 2);
+          verdict('ok', 'Document signed.');
+        } catch (e) { verdict('bad', 'Signing failed: ' + e.message); }
+      });
+
+      $('verify-btn').addEventListener('click', async () => {
+        try {
+          const doc = JSON.parse($('doc').value);
+          if (!doc.payload || !doc.signature || !doc.publicKey || doc.alg !== 'ECDSA-P256-SHA256') throw new Error('Malformed document');
+          const jwk = { crv: doc.publicKey.crv, kty: doc.publicKey.kty, x: doc.publicKey.x, y: doc.publicKey.y };
+          const key = await crypto.subtle.importKey('jwk', jwk, ALG, false, ['verify']);
+          const valid = await crypto.subtle.verify(SIG, key, unb64(doc.signature), enc.encode(canon(doc.payload)));
+          if (!valid) return verdict('bad', 'INVALID: signature does not match – the document was altered or forged.');
+          const trusted = await pubJwk(await getKeys());
+          const fp = await fingerprint(jwk);
+          if (fp === await fingerprint(trusted)) verdict('ok', 'VALID: authentic, unmodified, and signed by this browser\'s Daily Grind key.');
+          else verdict('warn', 'Signature is internally valid, but the signer (' + fp + ') is not this browser\'s trusted key. Confirm that fingerprint with The Daily Grind.');
+        } catch (e) { verdict('bad', 'INVALID: ' + e.message); }
+      });
+
+      $('download-btn').addEventListener('click', () => {
+        if (!$('doc').value) return;
+        let name = 'signed-document';
+        try { const p = JSON.parse($('doc').value).payload; name = p.type + '-' + p.id; } catch (e) { /* keep default */ }
+        const a = document.createElement('a');
+        a.href = URL.createObjectURL(new Blob([$('doc').value], { type: 'application/json' }));
+        a.download = name + '.json';
+        a.click();
+        URL.revokeObjectURL(a.href);
+      });
+
+      if (!window.crypto || !crypto.subtle) {
+        $('fp').textContent = 'Web Crypto unavailable (requires HTTPS or localhost)';
+      } else {
+        getKeys().then(pubJwk).then(fingerprint).then((f) => { $('fp').textContent = f; })
+          .catch((e) => { $('fp').textContent = 'key error: ' + e.message; });
+      }
+    })();
+  </script>
