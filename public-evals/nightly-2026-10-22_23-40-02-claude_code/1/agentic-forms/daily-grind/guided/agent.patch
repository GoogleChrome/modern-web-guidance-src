+  <script>
+    // Report a result to the user, and to the agent when it invoked the form.
+    function respond(event, statusId, message) {
+      document.getElementById(statusId).textContent = message;
+      if (event.agentInvoked) event.respondWith(Promise.resolve(message));
+    }
+
+    document.getElementById('filter-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const query = new FormData(event.target).get('query').trim().toLowerCase();
+      const names = [];
+      document.querySelectorAll('.grid .card').forEach((card) => {
+        const match = card.textContent.toLowerCase().includes(query);
+        card.hidden = !match;
+        if (match) names.push(card.querySelector('h3').textContent);
+      });
+      respond(event, 'filter-status', names.length
+        ? `Showing ${names.length} drink(s): ${names.join(', ')}.`
+        : 'No drinks match that keyword.');
+    });
+
+    document.getElementById('order-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const form = event.target;
+      if (!form.checkValidity()) {
+        const invalid = [...form.elements].filter((el) => el.name && !el.validity.valid)
+          .map((el) => `${el.name} (${el.validationMessage})`);
+        respond(event, 'order-status', `Validation failed: ${invalid.join(', ')}`);
+        form.reportValidity();
+        return;
+      }
+      const data = new FormData(form);
+      respond(event, 'order-status',
+        `Order placed: ${data.get('quantity')} x ${data.get('size')} ${data.get('drink')} for ${data.get('pickup_name')}.`);
+      form.reset();
+    });
+
+    document.getElementById('newsletter-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const form = event.target;
+      if (!form.checkValidity()) {
+        respond(event, 'newsletter-status', `Validation failed: email (${form.elements.email.validationMessage})`);
+        form.reportValidity();
+        return;
+      }
+      respond(event, 'newsletter-status', `Subscribed ${new FormData(form).get('email')}. Welcome to the Grind!`);
+      form.reset();
+    });
+  </script>
