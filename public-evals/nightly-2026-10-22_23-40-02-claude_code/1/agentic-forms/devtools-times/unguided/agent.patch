diff --git a/src/lib/webmcp.ts b/src/lib/webmcp.ts
new file mode 100644
index 0000000..7a1e350
--- /dev/null
+++ b/src/lib/webmcp.ts
@@ -0,0 +1,26 @@
+// Minimal WebMCP (navigator.modelContext) helper for exposing page functionality to AI agents.
+export interface WebMcpTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  execute: (input: any) => Promise<{ content: { type: 'text'; text: string }[] }>;
+}
+
+export const textResult = (text: string) => ({ content: [{ type: 'text' as const, text }] });
+
+/** Registers a tool if WebMCP is available. Returns a cleanup function. */
+export function registerWebMcpTool(tool: WebMcpTool): () => void {
+  const ctx = (navigator as any).modelContext;
+  if (!ctx?.registerTool) return () => {};
+  try {
+    ctx.registerTool(tool);
+  } catch (err) {
+    console.warn(`Failed to register WebMCP tool ${tool.name}:`, err);
+    return () => {};
+  }
+  return () => {
+    try {
+      ctx.unregisterTool?.(tool.name);
+    } catch {}
+  };
+}
