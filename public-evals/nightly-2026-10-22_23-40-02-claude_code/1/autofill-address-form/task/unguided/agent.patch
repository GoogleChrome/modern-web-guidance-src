+    .shipping-form {
+      background: white;
+      max-width: 700px;
+      margin: 20px auto 0;
+      padding: 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      display: grid;
+      grid-template-columns: repeat(2, 1fr);
+      gap: 16px 20px;
+    }
+
+    .shipping-form .field {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .shipping-form .full {
+      grid-column: 1 / -1;
+    }
+
+    .shipping-form label {
+      font-size: 0.9rem;
+      font-weight: 600;
+      margin-bottom: 4px;
+      color: var(--primary);
+    }
+
+    .shipping-form input,
+    .shipping-form select {
+      font: inherit;
+      padding: 10px 12px;
+      border: 1px solid var(--secondary);
+      border-radius: 5px;
+      background: white;
+      color: var(--text);
+    }
+
+    .shipping-form input:focus,
+    .shipping-form select:focus {
+      outline: 2px solid var(--accent);
+      border-color: var(--accent);
+    }
+
+    .shipping-form button {
+      border: none;
+      cursor: pointer;
+      font: inherit;
+      margin-top: 0;
+      justify-self: start;
+    }
+
+    @media (max-width: 600px) {
+      .shipping-form {
+        grid-template-columns: 1fr;
+      }
+    }
