+  <!-- Synchronous (render-blocking) script: runs before the page is revealed, so the transition never starts on a page whose critical script hasn't run. -->
+  <script>
+    document.documentElement.classList.add('js');
+    // Skip the transition for same-page navigations (e.g. hash links).
+    addEventListener('pageswap', (e) => {
+      if (!e.viewTransition || !e.activation) return;
+      const from = e.activation.from && new URL(e.activation.from.url);
+      const to = e.activation.entry && new URL(e.activation.entry.url);
+      if (from && to && from.pathname === to.pathname) e.viewTransition.skipTransition();
+    });
+  </script>
