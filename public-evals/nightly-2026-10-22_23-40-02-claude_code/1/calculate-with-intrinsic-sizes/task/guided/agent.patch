+    }
+
+    #accordion-toggle {
+      inline-size: 100%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding: 16px 20px;
+      background: none;
+      border: 0;
+      font: inherit;
+      font-size: 1.25rem;
+      font-weight: bold;
+      color: var(--primary);
+      cursor: pointer;
+      text-align: start;
+    }
+
+    #accordion-toggle::after {
+      content: '+';
+      font-size: 1.5rem;
+      line-height: 1;
+    }
+
+    #accordion-toggle[aria-expanded="true"]::after {
+      content: '\2212';
+    }
+
+    #accordion-toggle:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    /*
+     * Note: browsers cannot directly transition between two different intrinsic
+     * keyword sizes (e.g. min-content to max-content, or auto to fit-content).
+     * One end of the transition must be a length or percentage, such as 0 to auto.
+     */
+    .accordion-content {
+      block-size: 0;
+      overflow: hidden;
+      visibility: hidden;
+      padding-inline: 20px;
+      transition: block-size 0.4s ease-out, visibility 0s linear 0.4s;
+    }
+
+    .accordion-content.is-open {
+      visibility: visible;
+      block-size: auto;
+      /* natural height plus 2rem of breathing room */
+      block-size: calc-size(auto, size + 2rem);
+      transition: block-size 0.4s ease-out, visibility 0s;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .accordion-content {
+        /* Snap the size instantly; use a subtle fade instead */
+        opacity: 0;
+        transition: opacity 0.3s ease, visibility 0s linear 0.3s;
+      }
+
+      .accordion-content.is-open {
+        opacity: 1;
+        transition: opacity 0.3s ease, visibility 0s;
+      }
+    }
