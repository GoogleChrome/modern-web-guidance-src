+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      border-radius: 999px;
+      white-space: nowrap;
+      text-align: center;
+      /* Fallback for browsers without calc-size(): clamp via min/max */
+      inline-size: max-content;
+      min-inline-size: 100px;
+      max-inline-size: 100%;
+      /* 1.2 x max-content, clamped between 100px and 100% of the parent */
+      inline-size: calc-size(max-content, clamp(100px, size * 1.2, 100%));
+    }
+
+    /* Accordion */
+    .accordion {
+      margin-block-start: 40px;
