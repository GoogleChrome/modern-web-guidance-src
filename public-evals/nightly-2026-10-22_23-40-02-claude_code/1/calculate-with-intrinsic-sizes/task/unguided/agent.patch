+    /*
+     * Opt in to animating to/from intrinsic keywords like auto, so simple
+     * toggles can transition height/block-size globally across the site.
+     * Note: transitioning directly between two different intrinsic keyword
+     * sizes (e.g. min-content to max-content, or auto to fit-content) is not
+     * supported, because keywords can't be interpolated with each other. Only
+     * a length/percentage <-> keyword (or calc-size()) transition works.
+     */
+    :root {
+      interpolate-size: allow-keywords;
+    }
+
+    /* Promo badge */
+    .promo-badge {
+      display: block;
+      inline-size: max-content;
+      inline-size: calc-size(max-content, size * 1.2);
+      min-inline-size: 100px;
+      max-inline-size: 100%;
+      margin-block-end: 10px;
+      margin-inline: auto;
+      padding: 2px 10px;
+      background: var(--accent);
+      color: var(--primary);
+      font-size: 0.8rem;
+      font-weight: bold;
+      text-align: center;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      border-radius: 999px;
+    }
+
+    /* Accordion */
+    .accordion {
+      max-inline-size: 700px;
+      margin-inline: auto;
+      margin-block-start: 40px;
+    }
+
+    .accordion-toggle {
+      inline-size: 100%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding: 14px 20px;
+      font: inherit;
+      font-weight: bold;
+      color: white;
+      background: var(--primary);
+      border: 0;
+      border-radius: 8px;
+      cursor: pointer;
+    }
+
+    .accordion-toggle::after {
+      content: '+';
+      font-size: 1.25rem;
+    }
+
+    .accordion-toggle[aria-expanded="true"]::after {
+      content: '\2212';
+    }
+
+    .accordion-content {
+      block-size: 0;
+      overflow: hidden;
+      transition: block-size 0.4s ease;
+    }
+
+    .accordion-content.open {
+      /* Fallback: natural height, with the extra space as padding */
+      block-size: auto;
+      padding-block-end: 2rem;
+    }
+
+    @supports (block-size: calc-size(auto, size)) {
+      .accordion-content.open {
+        block-size: calc-size(auto, size + 2rem);
+        padding-block-end: 0;
+      }
+    }
+
+    .accordion-content p {
+      padding-block-start: 1rem;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .accordion-content {
+        transition: none;
+      }
+    }
