       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Scrollytelling (pure CSS, scroll-driven animations) */
+    .story {
+      margin-top: 80px;
+      /* Lets #animated children attach to timelines defined inside #tracked */
+      timeline-scope: --step-1, --step-2, --step-3;
+    }
+
+    .story > h2 {
+      text-align: center;
+    }
+
+    .story-body {
+      display: grid;
+      grid-template-columns: 1fr 1fr;
+      gap: 40px;
+      margin-top: 20px;
+    }
+
+    #tracked section {
+      min-height: 80vh;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+    }
+
+    #tracked section:nth-child(1) { view-timeline: --step-1 block; }
+    #tracked section:nth-child(2) { view-timeline: --step-2 block; }
+    #tracked section:nth-child(3) { view-timeline: --step-3 block; }
+
+    #tracked h3 {
+      color: var(--primary);
+      font-size: 1.6rem;
+      margin-bottom: 10px;
+    }
+
+    #animated {
+      position: sticky;
+      top: 80px;
+      height: calc(100vh - 120px);
+      max-height: 560px;
+      align-self: start;
+      display: grid;
+      margin-block: 10vh;
+    }
+
+    #animated section {
+      grid-area: 1 / 1;
+      border-radius: 12px;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      text-align: center;
+      padding: 30px;
+      color: white;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
+    }
+
+    #animated section strong {
+      font-size: 4rem;
+      line-height: 1;
+      color: var(--accent);
+    }
+
+    #animated section span {
+      margin-top: 10px;
+      font-size: 1.2rem;
+      letter-spacing: 1px;
+    }
+
+    #animated section:nth-child(1) { background: linear-gradient(135deg, #6d4c41, #3e2723); }
+    #animated section:nth-child(2) { background: linear-gradient(135deg, #8d6e63, #4e342e); }
+    #animated section:nth-child(3) { background: linear-gradient(135deg, #a1887f, #5d4037); }
+
+    @keyframes reveal {
+      0%, 20%   { opacity: 0; transform: translateY(40px) scale(0.95); }
+      40%, 60%  { opacity: 1; transform: none; }
+      80%, 100% { opacity: 0; transform: translateY(-40px) scale(0.95); }
+    }
+
+    @supports (animation-timeline: view()) {
+      #animated section {
+        opacity: 0;
+        will-change: opacity, transform;
+        animation: reveal linear both;
+      }
+
+      #animated section:nth-child(1) { animation-timeline: --step-1; }
+      #animated section:nth-child(2) { animation-timeline: --step-2; }
+      #animated section:nth-child(3) { animation-timeline: --step-3; }
+
+      /* First and last panels stay visible at the ends of the story */
+      #animated section:nth-child(1) { animation-name: reveal-first; }
+      #animated section:nth-child(3) { animation-name: reveal-last; }
+    }
+
+    @keyframes reveal-first {
+      0%, 60%   { opacity: 1; transform: none; }
+      80%, 100% { opacity: 0; transform: translateY(-40px) scale(0.95); }
+    }
+
+    @keyframes reveal-last {
+      0%, 20%   { opacity: 0; transform: translateY(40px) scale(0.95); }
+      40%, 100% { opacity: 1; transform: none; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #animated section { animation: none !important; opacity: 0; }
+      #animated section:nth-child(1) { opacity: 1; }
+    }
+
+    /* Without scroll-driven animation support, show all panels as a plain list */
+    @supports not (animation-timeline: view()) {
+      .story-body { grid-template-columns: 1fr; }
+      #animated { position: static; height: auto; max-height: none; gap: 20px; margin: 0; order: -1; }
+      #animated section { grid-area: auto; }
+      #tracked section { min-height: 0; padding: 20px 0; }
+    }
+
+    @media (max-width: 700px) {
+      .story-body { grid-template-columns: 1fr; }
+      #animated { position: sticky; top: 70px; height: 35vh; z-index: 1; margin: 0; }
+      #animated section strong { font-size: 2.5rem; }
+      #tracked section { min-height: 70vh; background: rgba(250, 250, 250, 0.9); }
+    }
   </style>
 </head>
 
