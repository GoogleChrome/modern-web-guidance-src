+        #tracked section:nth-child(4) { view-timeline: --tl-4 block; }
+
+        @keyframes reveal-in {
+          from { opacity: 0; scale: 0.9; translate: 0 40px; }
+        }
+
+        @keyframes reveal-out {
+          to { opacity: 0; scale: 0.95; }
+        }
+
+        #animated section {
+          animation: reveal-in auto linear both, reveal-out auto linear forwards;
+          animation-range: entry 25% cover 50%, exit 50% exit 75%;
+        }
+
+        /* The last panel stays once revealed */
