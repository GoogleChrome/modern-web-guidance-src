+  <script type="module">
+    const CALENDARS = [
+      { id: 'islamic-umalqura', title: 'Islamic (Umm al-Qura)', dateId: 'islamic-date' },
+      { id: 'hebrew', title: 'Hebrew' },
+      { id: 'japanese', title: 'Japanese' }
+    ];
+
+    const input = document.getElementById('calendar-date-input');
+    const cards = document.getElementById('calendar-cards');
+    const status = document.getElementById('calendar-status');
+
+    // Progressive enhancement: use native Temporal, otherwise load the polyfill.
+    async function ensureTemporal() {
+      if (typeof globalThis.Temporal !== 'undefined') return true;
+      try {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        return true;
+      } catch {
+        return false;
+      }
+    }
+
+    // Feature-detect per calendar: the environment must honor the requested calendar.
+    function convert(isoDate, calendarId) {
+      try {
+        const converted = isoDate.withCalendar(calendarId);
+        return converted.calendarId === calendarId ? converted : null;
+      } catch {
+        return null;
+      }
+    }
+
+    function el(tag, text, className) {
+      const node = document.createElement(tag);
+      if (text !== undefined) node.textContent = text;
+      if (className) node.className = className;
+      return node;
+    }
+
+    function addRow(list, label, value) {
+      list.append(el('dt', label), el('dd', value));
+    }
+
+    function buildCard(cal, date, today) {
+      const card = el('div', undefined, 'card');
+      card.append(el('h3', cal.title));
+
+      const formatted = date.toLocaleString(`en-u-ca-${cal.id}`, {
+        day: 'numeric', month: 'long', year: 'numeric', era: 'long'
+      });
+      const dateEl = el('p', formatted, 'calendar-date');
+      if (cal.dateId) dateEl.id = cal.dateId;
+      card.append(dateEl);
+
+      const details = el('dl');
+      // Japanese years are era-relative for display; `year` is the continuous arithmetic year.
+      addRow(details, 'Year', date.eraYear !== undefined
+        ? `${date.eraYear} (${date.era}, year ${date.year})`
+        : String(date.year));
+      addRow(details, 'Month', String(date.month));
+      addRow(details, 'Month code', date.monthCode);
+      addRow(details, 'Months in year', String(date.monthsInYear));
+      card.append(details);
+
+      const cmp = Temporal.PlainDate.compare(date, today.withCalendar(cal.id));
+      card.append(el('span', cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today', 'timeline'));
+
+      card.append(el('h4', 'Month breakdown'));
+      const months = el('ul', undefined, 'month-list');
+      for (let m = 1; m <= date.monthsInYear; m++) {
+        const month = date.with({ month: m, day: 1 });
+        months.append(el('li', `${month.monthCode}: ${month.daysInMonth} days`));
+      }
+      card.append(months);
+      return card;
+    }
+
+    function render(ready) {
+      cards.replaceChildren();
+      status.textContent = '';
+      if (!ready) {
+        status.textContent = 'Calendar conversion is not available in this browser.';
+        return;
+      }
+      if (!input.value) {
+        status.textContent = 'Choose a date to see it in other calendars.';
+        return;
+      }
+      let iso;
+      try {
+        iso = Temporal.PlainDate.from(input.value);
+      } catch {
+        status.textContent = 'That date could not be read.';
+        return;
+      }
+      const today = Temporal.Now.plainDateISO();
+      const unsupported = [];
+      for (const cal of CALENDARS) {
+        const converted = convert(iso, cal.id);
+        if (converted) cards.append(buildCard(cal, converted, today));
+        else unsupported.push(cal.title);
+      }
+      if (unsupported.length) {
+        status.textContent = `Not supported in this browser: ${unsupported.join(', ')}.`;
+      }
+    }
+
+    const ready = await ensureTemporal();
+    if (ready) input.value = Temporal.Now.plainDateISO().toString();
+    input.addEventListener('input', () => render(ready));
+    render(ready);
+  </script>
+
