+  <script type="module">
+    // Calendars use Temporal; the polyfill is loaded only when the browser lacks native support.
+    const CALENDARS = [
+      { id: 'islamic-umalqura', title: 'Islamic (Umm al-Qura)', locale: navigator.language, dateId: 'islamic-date' },
+      { id: 'hebrew', title: 'Hebrew', locale: navigator.language },
+      { id: 'japanese', title: 'Japanese', locale: 'ja-JP', era: true },
+    ];
+
+    const input = document.getElementById('cal-date-input');
+    const status = document.getElementById('cal-status');
+    const container = document.getElementById('calendar-cards');
+
+    async function loadTemporal() {
+      if (typeof globalThis.Temporal !== 'undefined') return globalThis.Temporal;
+      const mod = await import('https://esm.sh/temporal-polyfill@0.3.0');
+      return mod.Temporal;
+    }
+
+    function el(tag, text, className) {
+      const node = document.createElement(tag);
+      if (text !== undefined) node.textContent = text;
+      if (className) node.className = className;
+      return node;
+    }
+
+    function init(Temporal) {
+      // Calendar support is checked per calendar so unsupported ones degrade individually.
+      const supported = CALENDARS.filter((c) => {
+        try {
+          Temporal.PlainDate.from('2000-01-01').withCalendar(c.id);
+          return true;
+        } catch {
+          return false;
+        }
+      });
+
+      const unsupportedNote = supported.length < CALENDARS.length
+        ? 'Some calendars are not supported by this browser.' : '';
+
+      const today = Temporal.Now.plainDateISO();
+      input.value = today.toString();
+
+      function format(date, cal) {
+        const opts = cal.era
+          ? { era: 'long', year: 'numeric', month: 'long', day: 'numeric' }
+          : { dateStyle: 'full' };
+        try {
+          return date.toLocaleString(cal.locale, opts);
+        } catch {
+          return date.toLocaleString(undefined, opts);
+        }
+      }
+
+      function timeline(iso) {
+        const cmp = Temporal.PlainDate.compare(iso, today);
+        return cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+      }
+
+      function card(iso, cal) {
+        const date = iso.withCalendar(cal.id);
+        const root = el('div', undefined, 'card cal-card');
+        root.append(el('h3', cal.title));
+        root.append(el('span', timeline(iso), 'cal-timeline'));
+
+        const main = el('div', format(date, cal), 'cal-date');
+        if (cal.dateId) main.id = cal.dateId;
+        root.append(main);
+
+        const dl = el('dl');
+        const rows = [
+          ['Year', cal.era ? `${date.eraYear} (${date.era}), ${date.year}` : String(date.year)],
+          ['Month', String(date.month)],
+          ['Month code', date.monthCode],
+          ['Months in year', String(date.monthsInYear)],
+        ];
+        for (const [k, v] of rows) {
+          dl.append(el('dt', k), el('dd', v));
+        }
+        root.append(dl);
+
+        const months = el('div', undefined, 'cal-months');
+        months.append(el('strong', 'Months this year'));
+        const ul = el('ul');
+        for (let m = 1; m <= date.monthsInYear; m++) {
+          const first = date.with({ month: m, day: 1 });
+          ul.append(el('li', `${first.monthCode}: ${first.daysInMonth} days`));
+        }
+        months.append(ul);
+        root.append(months);
+        return root;
+      }
+
+      function render() {
+        container.replaceChildren();
+        let iso;
+        try {
+          iso = Temporal.PlainDate.from(input.value);
+        } catch {
+          status.textContent = 'Please choose a valid date.';
+          return;
+        }
+        status.textContent = unsupportedNote;
+        for (const cal of supported) {
+          try {
+            container.append(card(iso, cal));
+          } catch {
+            status.textContent = 'Some calendars could not be displayed for this date.';
+          }
+        }
+      }
+
+      input.addEventListener('input', render);
+      render();
+    }
+
+    loadTemporal().then(init).catch(() => {
+      input.disabled = true;
+      status.textContent = 'Calendar conversion is unavailable in this browser.';
+    });
+  </script>
+
 </body>
 
