+  <button type="button" class="btn feedback-open" id="feedback-open">Give Feedback</button>
+
+  <dialog class="feedback-dialog" id="feedback-dialog" aria-labelledby="feedback-title">
+    <form method="dialog">
+      <h2 id="feedback-title">Send us feedback</h2>
+      <p class="location">Currently inside: <strong id="feedback-location">body</strong></p>
+
+      <label for="feedback-text">Your thoughts</label>
+      <textarea id="feedback-text" name="feedback" placeholder="Tell us how we're doing…"></textarea>
+
+      <fieldset>
+        <legend>Move this dialog to…</legend>
+        <div class="move-buttons">
+          <button type="button" data-move-target="nav">Nav</button>
+          <button type="button" data-move-target=".hero">Hero</button>
+          <button type="button" data-move-target="main">Main</button>
+          <button type="button" data-move-target="footer">Footer</button>
+          <button type="button" data-move-target="body">Body</button>
+        </div>
+        <p class="support-note" id="feedback-support"></p>
+      </fieldset>
+
+      <div class="actions">
+        <button type="submit" value="cancel" class="btn" style="background: var(--secondary); color: var(--text);">Close</button>
+        <button type="submit" value="send" class="btn">Send</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    (() => {
+      const dialog = document.getElementById('feedback-dialog');
+      const openBtn = document.getElementById('feedback-open');
+      const locationLabel = document.getElementById('feedback-location');
+      const supportNote = document.getElementById('feedback-support');
+      const hasMoveBefore = typeof Element.prototype.moveBefore === 'function';
+
+      supportNote.textContent = hasMoveBefore
+        ? 'Using state-preserving moveBefore().'
+        : 'moveBefore() unavailable; re-opening the dialog after each move.';
+
+      // Set while a fallback move is in flight so the temporary close isn't treated as a real dismissal.
+      let relocating = false;
+
+      const describe = (el) =>
+        el.tagName.toLowerCase() + (el.classList.length ? '.' + el.classList[0] : '');
+
+      openBtn.addEventListener('click', () => {
+        if (!dialog.open) dialog.showModal();
+      });
+
+      // Fallback: removing an open modal from the DOM drops it from the top layer
+      // and loses focus, so close it, move it, and re-open it with the saved state.
+      function moveWithReopen(target) {
+        const wasModal = dialog.open && dialog.matches(':modal');
+        const active = document.activeElement;
+        const focused = dialog.contains(active) ? active : null;
+        const field = focused && 'selectionStart' in focused
+          ? { start: focused.selectionStart, end: focused.selectionEnd, dir: focused.selectionDirection }
+          : null;
+        const scrollTop = dialog.scrollTop;
+        const returnValue = dialog.returnValue;
+
+        relocating = true;
+        if (dialog.open) dialog.close();
+        target.append(dialog);
+        dialog.returnValue = returnValue;
+        if (wasModal) dialog.showModal();
+        relocating = false;
+
+        dialog.scrollTop = scrollTop;
+        if (focused) {
+          focused.focus({ preventScroll: true });
+          if (field) {
+            try { focused.setSelectionRange(field.start, field.end, field.dir); } catch { /* not selectable */ }
+          }
+        }
+      }
+
+      function moveDialog(target, trigger) {
+        if (!target || target === dialog.parentElement) return;
+
+        if (hasMoveBefore) {
+          // Keeps the dialog open, in the top layer, and keeps focus/selection/scroll intact.
+          target.moveBefore(dialog, null);
+        } else {
+          moveWithReopen(target);
+        }
+
+        locationLabel.textContent = describe(target);
+        // Keep keyboard focus on the button that was clicked.
+        if (trigger && document.activeElement !== trigger) trigger.focus({ preventScroll: true });
+      }
+
+      dialog.addEventListener('click', (e) => {
+        const btn = e.target.closest('[data-move-target]');
+        if (!btn) return;
+        moveDialog(document.querySelector(btn.dataset.moveTarget), btn);
+      });
+
+      // Backdrop click dismisses the dialog.
+      dialog.addEventListener('mousedown', (e) => {
+        if (e.target === dialog) {
+          const r = dialog.getBoundingClientRect();
+          const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
+          if (!inside) dialog.close('cancel');
+        }
+      });
+
+      dialog.addEventListener('close', () => {
+        if (relocating) return;
+        openBtn.focus();
+      });
+    })();
+  </script>
+
