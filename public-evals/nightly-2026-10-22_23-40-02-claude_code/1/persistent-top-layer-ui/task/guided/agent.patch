+  <dialog class="feedback-dialog" id="feedback-dialog" aria-labelledby="feedback-title">
+    <form method="dialog">
+      <h2 id="feedback-title">How are we doing?</h2>
+      <label>Your feedback
+        <textarea name="message" placeholder="Tell us about your visit"></textarea>
+      </label>
+      <fieldset>
+        <legend>Move this overlay to</legend>
+        <div class="feedback-actions">
+          <button type="button" data-move-to="zone-header">Hero</button>
+          <button type="button" data-move-to="zone-main">Main</button>
+          <button type="button" data-move-to="zone-footer">Footer</button>
+          <button type="button" data-move-to="body">Page root</button>
+        </div>
+      </fieldset>
+      <div class="feedback-footer">
+        <button type="submit" value="cancel">Close</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    const dialog = document.getElementById('feedback-dialog');
+
+    function showFeedback() {
+      if (!dialog.open) dialog.showModal();
+    }
+
+    function moveDialog(target) {
+      if (dialog.parentElement === target) return;
+      const wasOpen = dialog.open;
+      const focused = dialog.contains(document.activeElement) ? document.activeElement : null;
+
+      if ('moveBefore' in Element.prototype) {
+        // Atomic move: stays open, in the top layer, and keeps focus.
+        target.moveBefore(dialog, null);
+      } else {
+        // Traditional reparenting removes the dialog from the top layer,
+        // but leaves the `open` attribute, which would make showModal() throw.
+        target.insertBefore(dialog, null);
+        if (wasOpen) {
+          dialog.removeAttribute('open');
+          dialog.showModal();
+          focused?.focus();
+        }
+      }
+    }
+
+    dialog.addEventListener('click', (e) => {
+      const btn = e.target.closest('[data-move-to]');
+      if (!btn) return;
+      const id = btn.dataset.moveTo;
+      moveDialog(id === 'body' ? document.body : document.getElementById(id));
+    });
+
+    document.getElementById('open-feedback').addEventListener('click', showFeedback);
+    showFeedback();
+  </script>
+
