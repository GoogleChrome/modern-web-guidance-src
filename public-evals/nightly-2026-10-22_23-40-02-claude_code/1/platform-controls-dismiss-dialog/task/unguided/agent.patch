+<script>
+    // Native <dialog> via showModal() gives focus trapping, inert background,
+    // Escape to close, and the platform back gesture (close watcher) on mobile.
+    (function () {
+      var modal = document.getElementById('details-modal');
+      var title = document.getElementById('modal-title');
+      var desc = document.getElementById('modal-desc');
+      var link = document.getElementById('modal-link');
+      var opener = null;
+
+      document.querySelectorAll('[data-details]').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          opener = btn;
+          title.textContent = btn.closest('.card').querySelector('h3').textContent;
+          desc.textContent = btn.dataset.details;
+          link.href = btn.dataset.href;
+          modal.showModal();
+        });
+      });
+
+      modal.querySelector('.modal-close').addEventListener('click', function () {
+        modal.close();
+      });
+
+      // Click on the backdrop (the dialog element itself) dismisses too.
+      modal.addEventListener('click', function (e) {
+        if (e.target === modal) modal.close();
+      });
+
+      modal.addEventListener('close', function () {
+        if (opener) opener.focus();
+      });
+    })();
+  </script>
