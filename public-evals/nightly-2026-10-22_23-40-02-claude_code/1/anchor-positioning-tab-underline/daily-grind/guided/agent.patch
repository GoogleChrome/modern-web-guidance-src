     nav ul {
       display: flex;
       list-style: none;
+      position: relative;
+    }
+
+    /* Sliding active indicator, tethered to the active nav item */
+    nav ul::before {
+      content: '';
+      position: absolute;
+      position-anchor: --active;
+      inset-block-start: calc(anchor(bottom) + 0.1lh);
+      inset-inline-start: anchor(left);
+      inset-inline-end: anchor(right);
+      block-size: 0.15lh;
+      background: var(--accent);
+      border-radius: 2px;
+
+      @media (prefers-reduced-motion: no-preference) {
+        transition: inset 0.3s ease;
+      }
+    }
+
+    nav ul li.active {
+      anchor-name: --active;
+    }
+
+    /* Fallback: static underline without anchor positioning */
+    @supports not (position-anchor: auto) {
+      nav ul::before {
+        display: none;
+      }
+
+      nav ul li.active {
+        border-bottom: 0.15lh solid var(--accent);
+      }
     }
 
     nav ul li {
