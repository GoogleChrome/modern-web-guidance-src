   </footer>
 
+  <script>
+    // Move the active state between nav items; CSS animates the underline.
+    const navItems = document.querySelectorAll('nav li:has(> a:not(.logout-link))');
+    navItems.forEach((item) => {
+      item.querySelector('a').addEventListener('click', (e) => {
+        e.preventDefault();
+        navItems.forEach((li) => {
+          li.classList.remove('active');
+          li.querySelector('a').removeAttribute('aria-current');
+        });
+        item.classList.add('active');
+        item.querySelector('a').setAttribute('aria-current', 'page');
+      });
+    });
+  </script>
