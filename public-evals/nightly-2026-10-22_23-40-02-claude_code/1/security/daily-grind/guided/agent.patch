+      ...BASE_HEADERS,
+      'Content-Type': 'text/html; charset=utf-8',
+      'Content-Security-Policy': ENFORCED_CSP,
+      'Content-Security-Policy-Report-Only': reportOnlyCsp(data.toString('utf8')),
+    });
     res.end(data);
   });
 });
