diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -26,10 +26,50 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    /* Root scroller: snap so the search bar is either fully shown or hidden.
+       "proximity" keeps the rest of the page free-scrolling. */
+    html {
+      scroll-snap-type: y proximity;
+    }
+
+    /* Pull-to-reveal search bar, hidden above the nav on load */
+    .search-bar {
+      background: var(--secondary);
+      padding: 0.75rem 5%;
+      scroll-snap-align: start;
+    }
+
+    .search-bar form {
+      display: flex;
+      gap: 8px;
+      max-width: 600px;
+      margin: 0 auto;
+    }
+
+    .search-bar input {
+      flex: 1;
+      padding: 8px 12px;
+      border: 1px solid var(--primary);
+      border-radius: 4px;
+      font: inherit;
+    }
+
+    .search-bar button {
+      background: var(--primary);
+      color: white;
+      border: 0;
+      border-radius: 4px;
+      padding: 8px 16px;
+      font: inherit;
+      cursor: pointer;
+    }
+
     /* Navigation */
     nav {
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
       background: var(--primary);
       color: white;
       padding: 1rem 5%;
       display: flex;
@@ -156,8 +196,15 @@
 </head>
 
