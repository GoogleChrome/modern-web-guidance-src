       color: var(--text);
       background-color: var(--light);
     }
 
+    /* Scroll snapping: the search bar sits above the nav and is revealed by scrolling up */
+    html {
+      scroll-snap-type: y proximity;
+    }
+
+    .search-bar {
+      background: var(--secondary);
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: center;
+      gap: 10px;
+      scroll-snap-align: start;
+    }
+
+    .search-bar input {
+      flex: 1;
+      max-width: 600px;
+      padding: 10px 14px;
+      border: 1px solid var(--primary);
+      border-radius: 4px;
+      font: inherit;
+    }
+
+    .search-bar button {
+      background: var(--primary);
+      color: white;
+      border: none;
+      border-radius: 4px;
+      padding: 10px 20px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .search-bar button:hover {
+      background: var(--text);
+    }
+
     /* Navigation */
     nav {
+      scroll-initial-target: nearest;
+      scroll-snap-align: start;
       background: var(--primary);
       color: white;
       padding: 1rem 5%;
       display: flex;
