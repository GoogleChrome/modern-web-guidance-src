+    /* Options dropdown */
+    #trigger-btn {
+      anchor-name: --options-trigger;
+      font: inherit;
+      font-size: 0.9rem;
+      color: white;
+      background: transparent;
+      border: 1px solid var(--secondary);
+      padding: 5px 12px;
+      border-radius: 4px;
+      cursor: pointer;
+      transition: color 0.3s, border-color 0.3s;
+    }
+
+    #trigger-btn:hover,
+    #trigger-btn[aria-expanded="true"] {
+      color: var(--accent);
+      border-color: var(--accent);
+    }
+
+    /* Popover renders in the top layer, so no z-index/overflow clipping */
+    #action-panel {
+      position: fixed;
+      position-anchor: --options-trigger;
+      inset: auto;
+      margin: 4px 0;
+      top: anchor(bottom);
+      left: anchor(left);
+      /* Flip vertically / horizontally when colliding with the viewport */
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      min-width: 12rem;
+      max-width: calc(100vw - 16px);
+      padding: 6px;
+      color: var(--text);
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
+    }
+
+    #action-panel:popover-open {
+      display: flex;
+      flex-direction: column;
+    }
+
+    #action-panel button {
+      font: inherit;
+      font-size: 0.9rem;
