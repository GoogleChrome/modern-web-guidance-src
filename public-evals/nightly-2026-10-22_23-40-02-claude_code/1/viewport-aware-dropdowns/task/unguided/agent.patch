+      color: var(--text);
+      background: transparent;
+      border: 0;
+      padding: 8px 12px;
+      border-radius: 4px;
+      cursor: pointer;
+    }
+
+    #action-panel button:hover,
+    #action-panel button:focus-visible {
+      background: var(--secondary);
+    }
