+  <div id="action-panel" popover>
+    <button type="button" data-action="seasonal-offers">Seasonal Offers</button>
+    <button type="button" data-action="account-settings">Account Settings</button>
+    <button type="button" data-action="support">Support</button>
+  </div>
+
+  <script>
+    (function () {
+      var trigger = document.getElementById('trigger-btn');
+      var panel = document.getElementById('action-panel');
+
+      panel.addEventListener('toggle', function (e) {
+        trigger.setAttribute('aria-expanded', e.newState === 'open');
+        if (e.newState === 'open' && !CSS.supports('anchor-name', '--a')) place();
+      });
+
+      // Fallback for browsers without CSS anchor positioning:
+      // anchor below the trigger's left edge, flipping if it would overflow.
+      function place() {
+        var t = trigger.getBoundingClientRect();
+        var p = panel.getBoundingClientRect();
+        var vw = document.documentElement.clientWidth;
+        var vh = document.documentElement.clientHeight;
+        var gap = 4;
+        var top = t.bottom + gap;
+        var left = t.left;
+        if (top + p.height > vh && t.top - gap - p.height >= 0) top = t.top - gap - p.height;
+        if (left + p.width > vw && t.right - p.width >= 0) left = t.right - p.width;
+        panel.style.top = Math.max(0, top) + 'px';
+        panel.style.left = Math.max(0, left) + 'px';
+      }
+
+      window.addEventListener('resize', function () {
+        if (panel.matches(':popover-open') && !CSS.supports('anchor-name', '--a')) place();
+      });
+    })();
+  </script>
