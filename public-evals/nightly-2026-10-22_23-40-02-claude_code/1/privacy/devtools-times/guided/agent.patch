diff --git a/public/analytics-consent.js b/public/analytics-consent.js
new file mode 100644
index 0000000..9fb6aa8
--- /dev/null
+++ b/public/analytics-consent.js
@@ -0,0 +1,67 @@
+// Opt-in loader for the third-party analytics script.
+// Off by default; honours Global Privacy Control / Do Not Track; never runs on account pages.
+(function () {
+  var KEY = "analytics-consent";
+  var self = document.currentScript;
+  var src = self.dataset.src;
+  var privacyUrl = self.dataset.privacyUrl;
+  var accountPage = "accountPage" in self.dataset;
+  var optedOut = navigator.globalPrivacyControl === true || navigator.doNotTrack === "1";
+
+  function get() {
+    try { return localStorage.getItem(KEY); } catch (e) { return null; }
+  }
+  function set(v) {
+    try { localStorage.setItem(KEY, v); } catch (e) {}
+  }
+  function load() {
+    if (accountPage || optedOut || document.querySelector("script[data-analytics]")) return;
+    var s = document.createElement("script");
+    s.src = src;
+    s.defer = true;
+    s.referrerPolicy = "no-referrer";
+    s.setAttribute("data-analytics", "");
+    document.head.appendChild(s);
+  }
+
+  window.showPrivacyPreferences = function () {
+    if (document.getElementById("privacy-banner")) return;
+    var b = document.createElement("div");
+    b.id = "privacy-banner";
+    b.setAttribute("role", "dialog");
+    b.setAttribute("aria-label", "Privacy preferences");
+    b.className = "fixed bottom-4 left-4 right-4 md:left-auto md:max-w-sm z-[100] bg-white border border-gray-300 rounded-lg shadow-lg p-4 text-sm text-gray-800";
+    var p = document.createElement("p");
+    p.className = "mb-3";
+    p.textContent = optedOut
+      ? "Your browser sends a Do Not Track / Global Privacy Control signal, so analytics stays off. "
+      : "We would like to use a third-party analytics script to understand how the site is used. It is off by default and you can change your choice at any time. ";
+    var a = document.createElement("a");
+    a.href = privacyUrl;
+    a.className = "underline";
+    a.textContent = "Privacy Policy";
+    p.appendChild(a);
+    var row = document.createElement("div");
+    row.className = "flex gap-2";
+    [["denied", "Decline", "border border-gray-900"], ["granted", "Allow analytics", "bg-gray-900 text-white"]].forEach(function (o) {
+      if (optedOut && o[0] === "granted") return;
+      var btn = document.createElement("button");
+      btn.type = "button";
+      btn.textContent = o[1];
+      btn.className = "px-3 py-1.5 rounded-md " + o[2];
+      btn.addEventListener("click", function () {
+        set(o[0]);
+        if (o[0] === "granted") load();
+        b.remove();
+      });
+      row.appendChild(btn);
+    });
+    b.append(p, row);
+    document.body.appendChild(b);
+  };
+
+  if (get() === "granted") load();
+  document.addEventListener("DOMContentLoaded", function () {
+    if (!accountPage && !optedOut && get() === null) window.showPrivacyPreferences();
+  });
+})();
