diff --git a/src/middleware.ts b/src/middleware.ts
index 1684cf6..8b1afae 100644
--- a/src/middleware.ts
+++ b/src/middleware.ts
@@ -1,6 +1,21 @@
-
 import { defineMiddleware } from 'astro:middleware';
 
+// Everything is first-party: scripts/styles/fonts are bundled, and the only
+// cross-origin request is the auth API used by the sign-in/sign-up forms.
+// Astro's hydration and ClientRouter need inline scripts and styles.
+const CSP = [
+  "default-src 'self'",
+  "script-src 'self' 'unsafe-inline'",
+  "style-src 'self' 'unsafe-inline'",
+  "img-src 'self' data:",
+  "font-src 'self'",
+  "connect-src 'self' https://us-central1-web-devrel-apps.cloudfunctions.net",
+  "object-src 'none'",
+  "base-uri 'self'",
+  "form-action 'self'",
+  "frame-ancestors 'none'",
+].join('; ');
+
 export const onRequest = defineMiddleware(async (context, next) => {
   if (context.session) {
     // Initialize the reading list if it doesn't exist
@@ -9,5 +24,20 @@ export const onRequest = defineMiddleware(async (context, next) => {
       await context.session.set('readingList', []);
     }
   }
-  return next();
+
+  const response = await next();
+  const headers = response.headers;
+  headers.set('Content-Security-Policy', CSP);
+  headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
+  headers.set('X-Content-Type-Options', 'nosniff');
+  headers.set('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()');
+  headers.set('Cross-Origin-Opener-Policy', 'same-origin');
+
+  // Credential pages must never be cached or leak via Referer.
+  const path = context.url.pathname.replace(/\/$/, '');
+  if (path.endsWith('/signin') || path.endsWith('/signup')) {
+    headers.set('Cache-Control', 'no-store');
+    headers.set('Referrer-Policy', 'no-referrer');
+  }
+  return response;
 });
