+
+  <script>
+    // Native select only moves linearly; make Left/Right work in the side-by-side grid.
+    document.querySelector('.roast-picker').addEventListener('keydown', (e) => {
+      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
+      const select = e.currentTarget;
+      if (!select.matches(':open')) return;
+      e.preventDefault();
+      const rtl = getComputedStyle(select).direction === 'rtl';
+      const step = (e.key === 'ArrowRight') !== rtl ? 1 : -1;
+      const options = [...select.options];
+      const next = options[options.indexOf(document.activeElement) + step];
+      next?.focus();
+    });
+  </script>
+
