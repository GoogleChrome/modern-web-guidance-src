+  <script>
+    (() => {
+      const form = document.getElementById('subscribe-form');
+      const progress = document.getElementById('setup-progress');
+      const text = document.getElementById('progress-text');
+      const roast = document.getElementById('roast-level');
+      const roastValue = document.getElementById('roast-value');
+      const confirmMsg = document.getElementById('form-confirm');
+      const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      let roastTouched = false;
+
+      function update() {
+        roast.setAttribute('aria-valuetext', roastNames[roast.value - 1]);
+        roastValue.textContent = roastNames[roast.value - 1];
+        const done = [
+          form.elements.frequency.value !== '',
+          roastTouched,
+          form.elements['email-optin'].checked,
+        ].filter(Boolean).length;
+        progress.value = done;
+        text.textContent = `${done} of 3 steps complete`;
+        progress.textContent = text.textContent;
+      }
+
+      roast.addEventListener('input', () => { roastTouched = true; });
+      form.addEventListener('input', update);
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        confirmMsg.textContent = progress.value < 3
+          ? 'Subscription saved. You can finish the remaining steps any time.'
+          : 'Subscription saved. Thanks for joining!';
+      });
+      update();
+    })();
+  </script>
+
