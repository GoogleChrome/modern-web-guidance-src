+    <section class="subscribe" aria-labelledby="subscribe-title">
+      <h2 id="subscribe-title">Your Personalized Coffee Subscription</h2>
+      <p class="intro">Tell us how you like your coffee and we'll deliver it fresh.</p>
+
+      <form id="subscribe-form" novalidate>
+        <div class="progress-wrap">
+          <label for="setup-progress" id="setup-progress-label">Setup progress: 0% complete</label>
+          <progress id="setup-progress" max="3" value="0">0%</progress>
+        </div>
+
+        <fieldset>
+          <legend>Delivery frequency</legend>
+          <div class="field">
+            <input type="radio" id="freq-weekly" name="frequency" value="weekly">
+            <label for="freq-weekly">Weekly</label>
+          </div>
+          <div class="field">
+            <input type="radio" id="freq-biweekly" name="frequency" value="biweekly">
+            <label for="freq-biweekly">Every two weeks</label>
+          </div>
+          <div class="field">
+            <input type="radio" id="freq-monthly" name="frequency" value="monthly">
+            <label for="freq-monthly">Monthly</label>
+          </div>
+        </fieldset>
+
+        <fieldset>
+          <legend><label for="roast-level">Roast preference: <span id="roast-value">Medium</span></label></legend>
+          <input type="range" id="roast-level" name="roast" min="1" max="5" step="1" value="3"
+            aria-describedby="roast-scale">
+          <div class="range-labels" id="roast-scale" aria-hidden="true">
+            <span>Light</span>
+            <span>Medium</span>
+            <span>Dark</span>
+          </div>
+        </fieldset>
+
+        <div class="field" style="margin: 0 0 20px;">
+          <input type="checkbox" id="email-optin" name="emails">
+          <label for="email-optin">Email me order updates, brewing tips and offers</label>
+        </div>
+
+        <button type="submit" id="subscribe-submit" disabled>Start my subscription</button>
+        <p class="status" id="subscribe-status" role="status"></p>
+      </form>
+    </section>
   </main>
 
+  <script>
+    (function () {
+      var form = document.getElementById('subscribe-form');
+      var progress = document.getElementById('setup-progress');
+      var progressLabel = document.getElementById('setup-progress-label');
+      var roast = document.getElementById('roast-level');
+      var roastValue = document.getElementById('roast-value');
+      var submit = document.getElementById('subscribe-submit');
+      var status = document.getElementById('subscribe-status');
+      var roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      var roastTouched = false;
+
+      function update() {
+        roastValue.textContent = roastNames[roast.value - 1];
+        var done = 0;
+        if (form.elements.frequency.value) done++;
+        if (roastTouched) done++;
+        if (document.getElementById('email-optin').checked) done++;
+        progress.value = done;
+        var pct = Math.round(done / 3 * 100);
+        progress.textContent = pct + '%';
+        progressLabel.textContent = 'Setup progress: ' + pct + '% complete';
+        submit.disabled = done < 3;
+      }
+
+      roast.addEventListener('input', function () { roastTouched = true; });
+      form.addEventListener('input', update);
+      form.addEventListener('change', update);
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        status.textContent = 'Thanks! Your ' + form.elements.frequency.value +
+          ' ' + roastNames[roast.value - 1].toLowerCase() + ' roast subscription is set up.';
+      });
+      update();
+    })();
+  </script>
