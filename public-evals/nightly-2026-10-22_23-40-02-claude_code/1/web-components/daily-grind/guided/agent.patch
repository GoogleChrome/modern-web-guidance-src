+import { sheet } from './shared.js';
+
+const styles = sheet(`
+  :host {
+    display: block;
+    background: var(--secondary, #d7ccc8);
+    text-align: center;
+    padding: 40px 20px;
+    margin-top: 40px;
+  }
+  nav { margin-bottom: 20px; }
+  ::slotted(a) {
+    margin: 0 10px;
+    color: var(--text, #3e2723);
+    text-decoration: none;
+    font-size: 0.85rem;
+  }
+  ::slotted(a:hover) { text-decoration: underline; }
+  ::slotted(a:focus-visible) { outline: 2px solid currentColor; outline-offset: 2px; }
+  ::slotted(p) { margin: 0; }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <footer>
+    <nav aria-label="Footer"><slot name="links"></slot></nav>
+    <slot></slot>
+  </footer>
+`;
+
+/**
+ * <site-footer>
+ *   <a slot="links" href="/about">Our Story</a> …
+ *   <p>© …</p>
+ * </site-footer>
+ */
+class SiteFooter extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+    this.shadowRoot.adoptedStyleSheets = [styles];
+  }
+}
+
+customElements.define('site-footer', SiteFooter);
diff --git a/components/site-nav.js b/components/site-nav.js
new file mode 100644
index 0000000..315389b
--- /dev/null
+++ b/components/site-nav.js
@@ -0,0 +1,129 @@
+import { sheet } from './shared.js';
+
+const styles = sheet(`
+  :host {
+    display: block;
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+    background: var(--primary, #4e342e);
+    color: white;
+    container-type: inline-size;
+  }
+  nav {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    padding: 1rem 5%;
+  }
+  .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+  ul { display: flex; list-style: none; margin: 0; padding: 0; }
+  li { margin-left: 20px; }
+  ::slotted(a) {
+    color: white;
+    text-decoration: none;
+    font-size: 0.9rem;
+    transition: color 0.3s;
+  }
+  ::slotted(a:hover) { color: var(--accent, #ffab40); }
+  ::slotted(a:focus-visible) { outline: 2px solid var(--accent, #ffab40); outline-offset: 3px; }
+  ::slotted(a[outline]) {
+    border: 1px solid var(--accent, #ffab40);
+    padding: 5px 12px;
+    border-radius: 4px;
+  }
+  button {
+    display: none;
+    font: inherit;
+    color: inherit;
+    background: none;
+    border: 1px solid var(--accent, #ffab40);
+    border-radius: 4px;
+    padding: 5px 12px;
+    cursor: pointer;
+  }
+  button:focus-visible { outline: 2px solid var(--accent, #ffab40); outline-offset: 2px; }
+
+  @container (max-width: 40rem) {
+    button { display: block; }
+    ul { display: none; flex-direction: column; width: 100%; padding-top: 0.75rem; }
+    :host(:state(open)) ul { display: flex; }
+    li { margin: 0; padding: 0.5rem 0; }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <nav part="nav">
+    <div class="logo"><slot name="logo"></slot></div>
+    <button type="button" aria-expanded="false" aria-controls="links">Menu</button>
+    <ul id="links"></ul>
+  </nav>
+`;
+
+/**
+ * <site-nav>
+ *   <span slot="logo">THE DAILY GRIND</span>
+ *   <a href="/menu">Menu</a> …
+ * </site-nav>
+ *
+ * Each child <a> is projected into its own <li> inside the shadow tree so the
+ * links keep list semantics. On narrow containers the links collapse behind a
+ * disclosure button (aria-expanded, Escape to close).
+ */
+class SiteNav extends HTMLElement {
+  #internals;
+  #button;
+  #list;
+  #observer;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+    this.shadowRoot.adoptedStyleSheets = [styles];
+    this.#button = this.shadowRoot.querySelector('button');
+    this.#list = this.shadowRoot.querySelector('ul');
+    this.#button.addEventListener('click', () => this.open = !this.open);
+    this.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape' && this.open) {
+        this.open = false;
+        this.#button.focus();
+      }
+    });
+  }
+
+  get open() { return this.#internals.states.has('open'); }
+  set open(on) {
+    on = !!on;
+    if (on) this.#internals.states.add('open');
+    else this.#internals.states.delete('open');
+    this.#button.setAttribute('aria-expanded', String(on));
+  }
+
+  connectedCallback() {
+    this.#syncLinks();
+    // Children can arrive after upgrade, so watch for later changes.
+    this.#observer = new MutationObserver(() => this.#syncLinks());
+    this.#observer.observe(this, { childList: true });
+  }
+
+  disconnectedCallback() {
+    this.#observer?.disconnect();
+  }
+
+  #syncLinks() {
+    const links = [...this.children].filter((el) => el.matches('a'));
+    this.#list.replaceChildren(...links.map((a, i) => {
+      a.slot = `link-${i}`;
+      const slot = document.createElement('slot');
+      slot.name = a.slot;
+      const li = document.createElement('li');
+      li.append(slot);
+      return li;
+    }));
+  }
+}
+
+customElements.define('site-nav', SiteNav);
