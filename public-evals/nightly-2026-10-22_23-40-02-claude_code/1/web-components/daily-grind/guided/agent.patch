@@ -0,0 +1,64 @@
+import { sheet, buttonSlotStyles } from './shared.js';
+
+const styles = sheet(`
+  :host { display: block; }
+  .hero {
+    min-height: 60vh;
+    background:
+      linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+      var(--_image, none);
+    background-size: cover;
+    background-position: center;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    color: white;
+    text-align: center;
+    padding: 0 20px;
+  }
+  ::slotted(h1) { font-size: 3rem; margin: 0 0 1rem; }
+  ::slotted(p) { margin: 0; }
+  ${buttonSlotStyles('::slotted([slot="action"])')}
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <header class="hero" part="hero">
+    <slot name="title"></slot>
+    <slot></slot>
+    <slot name="action"></slot>
+  </header>
+`;
+
+/**
+ * <hero-banner image="https://…">
+ *   <h1 slot="title">…</h1><p>…</p><a slot="action" href="…">Order Now</a>
+ * </hero-banner>
+ */
+class HeroBanner extends HTMLElement {
+  static observedAttributes = ['image'];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+    this.shadowRoot.adoptedStyleSheets = [styles];
+  }
+
+  get image() { return this.getAttribute('image') ?? ''; }
+  set image(v) { v ? this.setAttribute('image', v) : this.removeAttribute('image'); }
+
+  connectedCallback() { this.#applyImage(); }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal) this.#applyImage();
+  }
+
+  #applyImage() {
+    // Serialize as a CSS string so quotes/parens in the URL can't break out.
+    if (this.image) this.style.setProperty('--_image', `url(${JSON.stringify(this.image)})`);
+    else this.style.removeProperty('--_image');
+  }
+}
+
+customElements.define('hero-banner', HeroBanner);
