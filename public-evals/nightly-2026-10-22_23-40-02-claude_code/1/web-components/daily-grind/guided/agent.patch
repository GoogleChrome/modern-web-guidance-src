new file mode 100644
index 0000000..5c7b496
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,54 @@
+import { sheet, buttonSlotStyles } from './shared.js';
+
+const styles = sheet(`
+  :host {
+    --_card-bg: var(--card-bg, white);
+    --_card-fg: var(--card-fg, inherit);
+    display: block;
+  }
+  .card {
+    height: 100%;
+    background: var(--_card-bg);
+    color: var(--_card-fg);
+    padding: 20px;
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    text-align: center;
+  }
+  ::slotted([slot="title"]) {
+    margin: 0 0 10px;
+    color: var(--primary, #4e342e);
+  }
+  ::slotted(p) { margin: 0; }
+  ${buttonSlotStyles('::slotted([slot="action"])')}
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article class="card" part="card">
+    <slot name="title"></slot>
+    <slot></slot>
+    <slot name="action"></slot>
+  </article>
+`;
+
+/**
+ * <coffee-card>
+ *   <h3 slot="title">Name</h3>
+ *   <p>Description</p>
+ *   <a slot="action" href="/menu/x">View Details</a>
+ * </coffee-card>
+ *
+ * Content stays in the light DOM, so the heading level is chosen by the page
+ * and the markup remains readable if the script never loads.
+ * Theme with --card-bg / --card-fg; style the surface via ::part(card).
+ */
+class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+    this.shadowRoot.adoptedStyleSheets = [styles];
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
