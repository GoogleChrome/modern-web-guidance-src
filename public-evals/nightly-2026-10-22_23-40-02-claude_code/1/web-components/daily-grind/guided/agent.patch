new file mode 100644
index 0000000..0840b5d
--- /dev/null
+++ b/components/shared.js
@@ -0,0 +1,22 @@
+// Shared constructed stylesheets, adopted by every component instance.
+export function sheet(css) {
+  const s = new CSSStyleSheet();
+  s.replaceSync(css);
+  return s;
+}
+
+// Slotted <a> styled as a call-to-action button. Theme via --btn-bg / --btn-fg / --btn-hover-bg.
+export const buttonSlotStyles = (selector) => `
+  ${selector} {
+    display: inline-block;
+    background: var(--btn-bg, var(--primary, #4e342e));
+    color: var(--btn-fg, white);
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+    transition: background 0.3s;
+  }
+  ${selector}:hover { background: var(--btn-hover-bg, #3e2723); }
+  ${selector}:focus-visible { outline: 3px solid var(--accent, #ffab40); outline-offset: 2px; }
+`;
