     .btn:hover {
       background: #3e2723;
     }
 
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
+    /* Product carousel */
+    .carousel-section {
+      margin-top: 60px;
+    }
+
+    .carousel-section h2 {
+      text-align: center;
+    }
+
+    .scroller {
+      display: flex;
+      gap: 24px;
+      list-style: none;
+      overflow-x: auto;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      /* Lets the first and last cards reach the center */
+      padding: 40px calc(50% - 130px);
+      scroll-padding-inline: calc(50% - 130px);
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    .scroller > li {
+      flex: 0 0 260px;
+      scroll-snap-align: center;
+    }
+
+    .scroller .card {
+      height: 100%;
+      overflow: hidden;
+      padding: 0 0 20px;
+      display: flex;
+      flex-direction: column;
+    }
+
+    .scroller .card img {
+      width: 100%;
+      height: 170px;
+      object-fit: cover;
+      margin-bottom: 16px;
+      background: var(--secondary);
+    }
+
+    .scroller .card p,
+    .scroller .card h3 {
+      padding: 0 16px;
+    }
+
+    .scroller .card .btn {
+      align-self: center;
+      margin-top: auto;
+    }
+
+    .scroller .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Scale by position in the scrollport, no JavaScript. Without support or
+       with reduced motion, cards simply stay at full size. */
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .scroller > li {
+          animation: card-focus linear both;
+          animation-timeline: view(inline);
+          animation-range: entry 0% exit 100%;
+        }
+      }
+    }
+
+    @keyframes card-focus {
+      0%, 100% { transform: scale(0.8); opacity: 0.6; }
+      50% { transform: scale(1.1); opacity: 1; }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
