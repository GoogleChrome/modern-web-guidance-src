       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
+    /* Product Carousel */
+    .carousel-section {
+      margin-top: 60px;
+    }
+
+    .carousel-section h2 {
+      text-align: center;
+    }
+
+    .scroller {
+      --card-width: min(280px, 70vw);
+      display: flex;
+      gap: 24px;
+      list-style: none;
+      overflow-x: auto;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      /* Lets the first and last cards reach the center */
+      padding: 40px calc(50% - var(--card-width) / 2);
+      scroll-padding-inline: calc(50% - var(--card-width) / 2);
+    }
+
+    .scroller:focus-visible,
+    .product-card a:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    .product-card {
+      flex: 0 0 var(--card-width);
+      scroll-snap-align: center;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: hidden;
+      text-align: center;
+    }
+
+    .product-card img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .product-card .body {
+      padding: 16px 20px 20px;
+    }
+
+    .product-card h3 {
+      color: var(--primary);
+    }
+
+    .product-card .price {
+      font-weight: bold;
+      margin-top: 4px;
+    }
+
+    /* Scale cards up toward the center of the scroller and down away from it.
+       Purely decorative, so browsers without scroll-driven animations just show full-size cards. */
+    @keyframes carousel-scale {
+      0%, 100% {
+        scale: 0.8;
+        opacity: 0.6;
+      }
+
+      50% {
+        scale: 1.05;
+        opacity: 1;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: view()) and (animation-range: entry)) {
+        .product-card {
+          animation: carousel-scale linear both;
+          animation-timeline: view(inline);
+        }
+      }
+    }
   </style>
