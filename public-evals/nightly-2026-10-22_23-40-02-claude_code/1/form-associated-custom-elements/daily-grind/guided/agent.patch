+  <script>
+    class RatingInput extends HTMLElement {
+      static formAssociated = true;
+
+      #internals;
+      #value = '';
+      #max = 5;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+        this.#internals.role = 'radiogroup';
+        const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+        root.innerHTML = `
+          <style>
+            :host { display: inline-flex; gap: 2px; }
+            button {
+              all: unset; cursor: pointer; font-size: 1.8rem; line-height: 1;
+              color: #bdbdbd; padding: 2px;
+            }
+            button[aria-checked="true"], button[data-filled] { color: #ffab40; }
+            button:focus-visible { outline: 2px solid #4e342e; border-radius: 4px; }
+            button:disabled { cursor: not-allowed; opacity: 0.5; }
+          </style>`;
+        for (let i = 1; i <= this.#max; i++) {
+          const b = document.createElement('button');
+          b.type = 'button';
+          b.role = 'radio';
+          b.dataset.value = i;
+          b.ariaLabel = `${i} star${i > 1 ? 's' : ''}`;
+          b.textContent = '★';
+          root.append(b);
+        }
+        root.addEventListener('click', (e) => {
+          const b = e.target.closest('button');
+          if (b) this.#commit(b.dataset.value);
+        });
+        root.addEventListener('keydown', (e) => this.#onKey(e));
+      }
+
+      connectedCallback() {
+        if (this.hasAttribute('value')) this.#set(this.getAttribute('value'));
+        else this.#sync();
+      }
+
+      get value() { return this.#value; }
+      set value(v) { this.#set(v); }
+
+      get name() { return this.getAttribute('name') ?? ''; }
+      get form() { return this.#internals.form; }
+      get validity() { return this.#internals.validity; }
+      get validationMessage() { return this.#internals.validationMessage; }
+      checkValidity() { return this.#internals.checkValidity(); }
+      reportValidity() { return this.#internals.reportValidity(); }
+
+      #set(v) {
+        v = String(v ?? '');
+        this.#value = Number(v) >= 1 && Number(v) <= this.#max ? v : '';
+        this.#sync();
+      }
+
+      // User-initiated change: update and fire input/change like native controls.
+      #commit(v) {
+        if (v === this.#value) return;
+        this.#set(v);
+        this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+        this.dispatchEvent(new Event('change', { bubbles: true }));
+      }
+
+      #sync() {
+        // null clears the entry so an empty rating isn't submitted as "rating="
+        this.#internals.setFormValue(this.#value || null);
+        const buttons = [...this.shadowRoot.querySelectorAll('button')];
+        const current = Number(this.#value);
+        buttons.forEach((b, i) => {
+          const n = i + 1;
+          b.ariaChecked = String(n === current);
+          b.toggleAttribute('data-filled', n <= current);
+          // Roving tabindex: checked star, or the first one when empty.
+          b.tabIndex = n === current || (!current && i === 0) ? 0 : -1;
+        });
+        if (this.hasAttribute('required') && !this.#value) {
+          this.#internals.setValidity(
+            { valueMissing: true },
+            'Please choose a rating.',
+            buttons[0],
+          );
+        } else {
+          this.#internals.setValidity({});
+        }
+      }
+
+      #onKey(e) {
+        const step = { ArrowRight: 1, ArrowUp: 1, ArrowLeft: -1, ArrowDown: -1 }[e.key];
+        if (!step) return;
+        e.preventDefault();
+        const next = Math.min(this.#max, Math.max(1, (Number(this.#value) || 0) + step));
+        this.#commit(String(next));
+        this.shadowRoot.querySelector(`button[data-value="${next}"]`).focus();
+      }
+
+      static observedAttributes = ['required'];
+      attributeChangedCallback() {
+        if (this.isConnected) this.#sync();
+      }
+
+      formResetCallback() {
+        this.#set(this.getAttribute('value'));
+      }
+
+      formDisabledCallback(disabled) {
+        for (const b of this.shadowRoot.querySelectorAll('button')) b.disabled = disabled;
+      }
+
+      formStateRestoreCallback(state) {
+        this.#set(state);
+      }
+    }
+    customElements.define('rating-input', RatingInput);
+  </script>
+
