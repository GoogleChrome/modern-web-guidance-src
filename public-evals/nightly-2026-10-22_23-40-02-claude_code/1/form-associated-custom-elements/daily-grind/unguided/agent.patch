index 0000000..716e923
--- /dev/null
+++ b/quantity-stepper.js
@@ -0,0 +1,301 @@
+/**
+ * <quantity-stepper> — a form-associated custom element.
+ *
+ * Attributes: name, value (default value), min, max, step, required, disabled
+ * Participates in forms via ElementInternals: submits its value, reports
+ * constraint validity, and handles reset / disable / state-restore.
+ */
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: inline-flex;
+      align-items: stretch;
+      border: 1px solid #a1887f;
+      border-radius: 6px;
+      background: white;
+      font: inherit;
+      color: inherit;
+      overflow: hidden;
+    }
+    :host([hidden]) { display: none; }
+    button, [part="value"] {
+      font: inherit;
+      color: inherit;
+      border: 0;
+      background: none;
+      min-width: 2.5rem;
+      padding: 0.4rem 0.6rem;
+      text-align: center;
+    }
+    button { cursor: pointer; background: #efebe9; }
+    button:hover:not(:disabled) { background: #d7ccc8; }
+    button:disabled { cursor: not-allowed; opacity: 0.5; }
+    [part="value"] { min-width: 3.5rem; align-self: center; }
+    [part="value"]:focus-visible { outline: 2px solid #ffab40; outline-offset: -2px; }
+    :host(.disabled) { opacity: 0.6; background: #f5f5f5; }
+    :host(.invalid:not(:focus-within)) { border-color: #c62828; }
+  </style>
+  <button type="button" part="decrement" tabindex="-1" aria-label="Decrease">−</button>
+  <span part="value" role="spinbutton" tabindex="0"></span>
+  <button type="button" part="increment" tabindex="-1" aria-label="Increase">+</button>
+`;
+
+class QuantityStepper extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'min', 'max', 'step', 'required', 'disabled', 'aria-label', 'aria-labelledby'];
+
+  #internals = this.attachInternals();
+  #value = ''; // current value as a string; '' means empty
+  #formDisabled = false; // disabled via ancestor <fieldset disabled>
+  #dirty = false; // user/script changed value since last reset
+  #touched = false;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(template.content.cloneNode(true));
+    this.#display = root.querySelector('[part="value"]');
+    this.#dec = root.querySelector('[part="decrement"]');
+    this.#inc = root.querySelector('[part="increment"]');
+
+    this.#dec.addEventListener('click', () => this.#nudge(-1));
+    this.#inc.addEventListener('click', () => this.#nudge(1));
+    this.#display.addEventListener('keydown', (e) => this.#onKeydown(e));
+    this.#display.addEventListener('blur', () => {
+      this.#touched = true;
+      this.#syncUI();
+    });
+  }
+
+  #display;
+  #dec;
+  #inc;
+
+  connectedCallback() {
+    this.#internals.role = 'group';
+    if (!this.#dirty) this.#value = this.#normalize(this.getAttribute('value') ?? '');
+    this.#commit();
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    if (name === 'value') {
+      // The value attribute is the default; it only drives the value until the user/script edits it
+      if (!this.#dirty) this.#value = this.#normalize(value);
+    }
+    if (name === 'aria-label' || name === 'aria-labelledby') {
+      // Mirror labelling onto the inner spinbutton
+      if (value === null) this.#display.removeAttribute(name);
+      else this.#display.setAttribute(name, value);
+      return;
+    }
+    this.#commit();
+  }
+
+  // ---- Properties ---------------------------------------------------------
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(v) { this.setAttribute('name', v); }
+
+  get type() { return 'quantity-stepper'; }
+
+  get value() { return this.#value; }
+  set value(v) {
+    this.#dirty = true;
+    this.#value = this.#normalize(v);
+    this.#commit();
+  }
+
+  get valueAsNumber() { return this.#value === '' ? NaN : Number(this.#value); }
+
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(v) { this.setAttribute('value', v); }
+
+  get min() { return this.#num('min', 0); }
+  set min(v) { this.setAttribute('min', v); }
+  get max() { return this.#num('max', Infinity); }
+  set max(v) { this.setAttribute('max', v); }
+  get step() {
+    const s = this.#num('step', 1);
+    return s > 0 ? s : 1;
+  }
+  set step(v) { this.setAttribute('step', v); }
+
+  get required() { return this.hasAttribute('required'); }
+  set required(v) { this.toggleAttribute('required', Boolean(v)); }
+
+  get disabled() { return this.hasAttribute('disabled') || this.#formDisabled; }
+  set disabled(v) { this.toggleAttribute('disabled', Boolean(v)); }
+
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+  setCustomValidity(msg) {
+    this.#customError = String(msg);
+    this.#commit();
+  }
+  #customError = '';
+
+  // ---- Form-associated callbacks -----------------------------------------
+
+  formAssociatedCallback() {
+    this.#commit();
+  }
+
+  formDisabledCallback(disabled) {
+    this.#formDisabled = disabled;
+    this.#commit();
+  }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#touched = false;
+    this.#customError = '';
+    this.#value = this.#normalize(this.defaultValue);
+    this.#commit();
+  }
+
+  formStateRestoreCallback(state, _mode) {
+    // Runs for back/forward navigation and for browser autofill
+    this.#dirty = true;
+    this.#value = this.#normalize(state);
+    this.#commit();
+  }
+
+  // ---- Internals ----------------------------------------------------------
+
+  #num(attr, fallback) {
+    const n = parseFloat(this.getAttribute(attr));
+    return Number.isFinite(n) ? n : fallback;
+  }
+
+  #normalize(v) {
+    if (v === null || v === undefined) return '';
+    const s = String(v).trim();
+    if (s === '') return '';
+    const n = Number(s);
+    return Number.isFinite(n) ? String(n) : '';
+  }
+
+  #nudge(dir) {
+    if (this.disabled) return;
+    const cur = this.valueAsNumber;
+    let next;
+    if (Number.isNaN(cur)) {
+      next = dir > 0 ? this.min : Math.min(this.max, this.min);
+      if (!Number.isFinite(next)) next = 0;
+    } else {
+      next = cur + dir * this.step;
+    }
+    next = Math.min(this.max, Math.max(this.min, next));
+    // Avoid float drift for fractional steps
+    next = Number(next.toFixed(10));
+    this.#setFromUser(String(next));
+  }
+
+  #setFromUser(v) {
+    if (v === this.#value) return;
+    this.#dirty = true;
+    this.#value = v;
+    this.#commit();
+    this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  #onKeydown(e) {
+    if (this.disabled || e.altKey || e.ctrlKey || e.metaKey) return;
+    switch (e.key) {
+      case 'ArrowUp':
+      case 'ArrowRight':
+        this.#nudge(1);
+        break;
+      case 'ArrowDown':
+      case 'ArrowLeft':
+        this.#nudge(-1);
+        break;
+      case 'Home':
+        if (Number.isFinite(this.min)) this.#setFromUser(String(this.min));
+        break;
+      case 'End':
+        if (Number.isFinite(this.max)) this.#setFromUser(String(this.max));
+        break;
+      case 'Backspace':
+      case 'Delete':
+        if (!this.required) this.#setFromUser('');
+        break;
+      default:
+        return;
+    }
+    e.preventDefault();
+  }
+
+  /** Push current state to the form and update validity + UI. */
+  #commit() {
+    const i = this.#internals;
+    // Submit nothing when empty so the field is omitted, like an empty number input
+    i.setFormValue(this.#value === '' ? null : this.#value, this.#value);
+    this.#validate();
+    this.#syncUI();
+  }
+
+  #validate() {
+    const i = this.#internals;
+    const n = this.valueAsNumber;
+    const flags = {};
+    let message = '';
+    const anchor = this.#display;
+
+    if (this.#customError) {
+      flags.customError = true;
+      message = this.#customError;
+    } else if (this.required && this.#value === '') {
+      flags.valueMissing = true;
+      message = 'Please choose a quantity.';
+    } else if (!Number.isNaN(n)) {
+      if (n < this.min) {
+        flags.rangeUnderflow = true;
+        message = `Value must be ${this.min} or more.`;
+      } else if (n > this.max) {
+        flags.rangeOverflow = true;
+        message = `Value must be ${this.max} or less.`;
+      } else {
+        const base = Number.isFinite(this.min) ? this.min : 0;
+        const steps = (n - base) / this.step;
+        if (Math.abs(steps - Math.round(steps)) > 1e-9) {
+          flags.stepMismatch = true;
+          message = `Value must be a multiple of ${this.step}.`;
+        }
+      }
+    }
+    i.setValidity(flags, message, anchor);
+  }
+
+  #syncUI() {
+    const disabled = this.disabled;
+    const n = this.valueAsNumber;
+    this.#display.textContent = this.#value === '' ? '–' : this.#value;
+    this.#display.setAttribute('aria-valuenow', this.#value);
+    this.#display.setAttribute('aria-valuetext', this.#value === '' ? 'empty' : this.#value);
+    if (Number.isFinite(this.min)) this.#display.setAttribute('aria-valuemin', this.min);
+    if (Number.isFinite(this.max)) this.#display.setAttribute('aria-valuemax', this.max);
+    else this.#display.removeAttribute('aria-valuemax');
+    this.#display.setAttribute('aria-required', String(this.required));
+    this.#display.setAttribute('aria-disabled', String(disabled));
+    this.#display.setAttribute('aria-invalid', String(!this.#internals.validity.valid));
+    this.#display.tabIndex = disabled ? -1 : 0;
+
+    this.#dec.disabled = disabled || (!Number.isNaN(n) && n <= this.min);
+    this.#inc.disabled = disabled || (!Number.isNaN(n) && n >= this.max);
+    this.classList.toggle('disabled', disabled);
+    this.classList.toggle(
+      'invalid',
+      !disabled && this.#touched && !this.#internals.validity.valid,
+    );
+  }
+}
+
+customElements.define('quantity-stepper', QuantityStepper);
