+  <script>
+    const panel = document.getElementById('coupon-panel');
+    const revealBtn = document.getElementById('reveal-coupon');
+
+    function markRevealed() {
+      revealBtn.disabled = true;
+      revealBtn.textContent = 'Coupon revealed';
+    }
+
+    revealBtn.addEventListener('click', () => {
+      panel.removeAttribute('hidden');
+      markRevealed();
+      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+    });
+
+    // Find-in-page reveals the panel natively; keep the button in sync.
+    panel.addEventListener('beforematch', markRevealed);
+
+    // Browsers without hidden="until-found" (e.g. Safari): show the code outright.
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      panel.removeAttribute('hidden');
+      markRevealed();
+    }
+  </script>
+
