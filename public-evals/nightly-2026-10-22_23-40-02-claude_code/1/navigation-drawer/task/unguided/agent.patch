+<script>
+    const drawer = document.getElementById('drawer');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const openButton = document.getElementById('menu-button');
+
+    const maxScroll = () => scroller.scrollWidth - scroller.clientWidth;
+
+    openButton.addEventListener('click', () => {
+      scroller.classList.remove('animated');
+      drawer.showModal();
+      scroller.scrollLeft = maxScroll(); // panel open
+      openButton.setAttribute('aria-expanded', 'true');
+      requestAnimationFrame(() => scroller.classList.add('animated'));
+    });
+
+    drawer.addEventListener('close', () => {
+      openButton.setAttribute('aria-expanded', 'false');
+    });
+
+    // Swiping the panel away lands on the backdrop snap point: close.
+    // Falls back to a scroll listener where scrollend is unsupported.
+    const closeIfSwiped = () => {
+      if (drawer.open && scroller.scrollLeft <= 1) drawer.close();
+    };
+    if ('onscrollend' in window) {
+      scroller.addEventListener('scrollend', closeIfSwiped);
+    } else {
+      let t;
+      scroller.addEventListener('scroll', () => {
+        clearTimeout(t);
+        t = setTimeout(closeIfSwiped, 100);
+      });
+    }
+
+    // Tap on backdrop, or the close button: slide out, then close.
+    const slideClosed = () => {
+      if (scroller.scrollLeft <= 1) return drawer.close();
+      scroller.scrollTo({ left: 0 });
+      // No scroll animation (e.g. reduced motion) fires no scrollend if already there
+      if (getComputedStyle(scroller).scrollBehavior !== 'smooth') drawer.close();
+    };
+    drawer.querySelector('.drawer-backdrop').addEventListener('click', slideClosed);
+    drawer.querySelector('.drawer-close').addEventListener('click', slideClosed);
+  </script>
 </body>
 
