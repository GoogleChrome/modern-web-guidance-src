diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,128 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Launchpad — Ship your ideas faster</title>
+  <meta name="description" content="Launchpad helps teams go from idea to launch in days, not months.">
+
+  <!-- Anti-flicker: hide the page until the experiment has been applied.
+       The class is only set when JS runs, so no-JS visitors still see content. -->
+  <script>document.documentElement.classList.add('exp-pending');</script>
+  <style>
+    .exp-pending body { opacity: 0 !important; }
+    body { transition: opacity .15s ease; }
+  </style>
+  <noscript><style>.exp-pending body { opacity: 1 !important; }</style></noscript>
+
+  <script>
+    (function () {
+      var root = document.documentElement;
+      var done = false;
+      // Failsafe: never keep the page hidden longer than this (SDK slow/blocked/down).
+      var MAX_WAIT_MS = 1500;
+
+      function reveal() {
+        if (done) return;
+        done = true;
+        clearTimeout(timer);
+        root.classList.remove('exp-pending');
+      }
+
+      // Wait for the DOM to exist, then a frame so SDK mutations are painted-in before reveal.
+      function revealWhenReady() {
+        function go() { requestAnimationFrame(function () { requestAnimationFrame(reveal); }); }
+        if (document.readyState === 'loading') {
+          document.addEventListener('DOMContentLoaded', go);
+        } else {
+          go();
+        }
+      }
+
+      var timer = setTimeout(reveal, MAX_WAIT_MS);
+
+      var s = document.createElement('script');
+      s.src = 'https://cdn.example.com/experiment-sdk.js';
+      s.async = true;
+      s.onload = revealWhenReady;   // SDK has run and applied its variant
+      s.onerror = reveal;           // SDK failed: show the original content
+      document.head.appendChild(s);
+    })();
+  </script>
+
+  <style>
+    *, *::before, *::after { box-sizing: border-box; }
+    html { scroll-behavior: smooth; }
+    body {
+      margin: 0;
+      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+      color: #0f172a;
+      background: #fff;
+      line-height: 1.5;
+    }
+    header {
+      display: flex; align-items: center; justify-content: space-between;
+      max-width: 1100px; margin: 0 auto; padding: 1.25rem 1.5rem;
+    }
+    .logo { font-weight: 800; font-size: 1.25rem; letter-spacing: -.02em; }
+    nav a { margin-left: 1.5rem; color: #475569; text-decoration: none; font-size: .95rem; }
+    nav a:hover { color: #0f172a; }
+
+    .hero {
+      background: radial-gradient(1200px 500px at 50% -10%, #c7d2fe 0%, #eef2ff 45%, #fff 100%);
+      padding: 6rem 1.5rem 7rem;
+      text-align: center;
+    }
+    .hero-inner { max-width: 760px; margin: 0 auto; }
+    .eyebrow {
+      display: inline-block; padding: .3rem .8rem; border-radius: 999px;
+      background: #e0e7ff; color: #3730a3; font-size: .8rem; font-weight: 600;
+    }
+    h1 {
+      margin: 1.25rem 0 1rem;
+      font-size: clamp(2.25rem, 6vw, 4rem);
+      line-height: 1.08; letter-spacing: -.03em;
+    }
+    .hero p { margin: 0 auto 2.25rem; max-width: 560px; font-size: 1.2rem; color: #475569; }
+    .cta {
+      display: inline-block; padding: .95rem 2rem; border-radius: 10px;
+      background: #4f46e5; color: #fff; font-weight: 700; font-size: 1.05rem;
+      text-decoration: none; box-shadow: 0 8px 20px rgba(79, 70, 229, .35);
+      transition: transform .15s ease, background .15s ease;
+    }
+    .cta:hover { background: #4338ca; transform: translateY(-1px); }
+    .cta:focus-visible { outline: 3px solid #a5b4fc; outline-offset: 3px; }
+    .note { margin-top: 1rem; font-size: .85rem; color: #64748b; }
+
+    footer { text-align: center; padding: 2rem 1.5rem; color: #64748b; font-size: .85rem; }
+
+    @media (prefers-reduced-motion: reduce) {
+      body, .cta { transition: none; }
+      html { scroll-behavior: auto; }
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <div class="logo">Launchpad</div>
+    <nav>
+      <a href="#features">Features</a>
+      <a href="#pricing">Pricing</a>
+    </nav>
+  </header>
+
+  <main>
+    <section class="hero" id="hero" data-experiment="hero">
+      <div class="hero-inner">
+        <span class="eyebrow">New · Team workspaces</span>
+        <h1 id="hero-headline">Ship your ideas faster than ever</h1>
+        <p id="hero-subhead">Launchpad takes you from idea to live product in days, not months — no complicated setup required.</p>
+        <a class="cta" id="cta-button" href="#signup" data-experiment="cta">Get started free</a>
+        <div class="note">No credit card required</div>
+      </div>
+    </section>
+  </main>
+
+  <footer>© 2026 Launchpad, Inc.</footer>
+</body>
+</html>
