diff --git a/src/pages/api/passkeys.json.ts b/src/pages/api/passkeys.json.ts
new file mode 100644
index 0000000..c23e555
--- /dev/null
+++ b/src/pages/api/passkeys.json.ts
@@ -0,0 +1,64 @@
+import type { APIRoute } from 'astro';
+
+export interface StoredPasskey {
+  id: string; // base64url credential ID
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+const MAX_NAME_LENGTH = 60;
+
+async function load(session: Parameters<APIRoute>[0]["session"]) {
+  const user = await session?.get('user');
+  if (!user) return null;
+  const passkeys: StoredPasskey[] = (await session?.get('passkeys')) || [];
+  return { user, passkeys };
+}
+
+// The response includes what the browser needs to sync its authenticator.
+const payload = (user: { username: string }, passkeys: StoredPasskey[]) => ({
+  userId: user.username,
+  username: user.username,
+  passkeys,
+});
+
+export const GET: APIRoute = async ({ session }) => {
+  const state = await load(session);
+  if (!state) return json({ error: 'Not signed in' }, 401);
+  return json(payload(state.user, state.passkeys));
+};
+
+export const PATCH: APIRoute = async ({ request, session }) => {
+  const state = await load(session);
+  if (!state) return json({ error: 'Not signed in' }, 401);
+
+  const { id, name } = await request.json().catch(() => ({}));
+  const trimmed = typeof name === 'string' ? name.trim() : '';
+  if (typeof id !== 'string' || !trimmed) return json({ error: 'A name is required' }, 400);
+  if (trimmed.length > MAX_NAME_LENGTH) {
+    return json({ error: `Name must be ${MAX_NAME_LENGTH} characters or fewer` }, 400);
+  }
+  if (!state.passkeys.some((p) => p.id === id)) return json({ error: 'Passkey not found' }, 404);
+
+  const passkeys = state.passkeys.map((p) => (p.id === id ? { ...p, name: trimmed } : p));
+  await session?.set('passkeys', passkeys);
+  return json(payload(state.user, passkeys));
+};
+
+export const DELETE: APIRoute = async ({ request, session }) => {
+  const state = await load(session);
+  if (!state) return json({ error: 'Not signed in' }, 401);
+
+  const { id } = await request.json().catch(() => ({}));
+  if (typeof id !== 'string' || !state.passkeys.some((p) => p.id === id)) {
+    return json({ error: 'Passkey not found' }, 404);
+  }
+
+  const passkeys = state.passkeys.filter((p) => p.id !== id);
+  await session?.set('passkeys', passkeys);
+  return json(payload(state.user, passkeys));
+};
diff --git a/src/pages/api/session.ts b/src/pages/api/session.ts
new file mode 100644
index 0000000..ae1db4a
--- /dev/null
+++ b/src/pages/api/session.ts
@@ -0,0 +1,20 @@
+import type { APIRoute } from 'astro';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+// Records the signed-in reader in the session after a successful login.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || !username.trim()) {
+    return json({ error: 'Username is required' }, 400);
+  }
+  session?.regenerate?.();
+  await session?.set('user', { username: username.trim() });
+  return json({ username: username.trim() });
+};
+
+export const DELETE: APIRoute = async ({ session }) => {
+  session?.destroy();
+  return json({ ok: true });
+};
