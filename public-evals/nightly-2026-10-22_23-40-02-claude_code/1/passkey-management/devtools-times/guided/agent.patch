+import type { APIRoute } from 'astro';
+import { json } from '../../utils/passkeys';
+
+const UPSTREAM = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+// Proxies sign-in to the upstream service and, on success, records the reader in the session
+// so account pages can tell who is signed in.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json();
+  const upstream = await fetch(UPSTREAM, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await upstream.json().catch(() => ({}));
+
+  if (upstream.ok && typeof username === 'string') {
+    const existing = await session?.get('user');
+    if (existing?.name !== username) {
+      const id = Buffer.from(crypto.getRandomValues(new Uint8Array(16))).toString('base64url');
+      session?.set('user', { id, name: username, displayName: username });
+      session?.set('passkeys', []);
+    }
+  }
+  return json(data, upstream.status);
+};
