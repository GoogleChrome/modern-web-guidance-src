+import React, { useEffect, useState } from 'react';
+import { KeyIcon } from '@heroicons/react/24/outline';
+import type { SessionUser, StoredPasskey } from '../utils/passkeys';
+
+const api = (path: string) => `${import.meta.env.BASE_URL}api/${path}`;
+const send = (path: string, method: string, body?: unknown) =>
+  fetch(api(path), {
+    method,
+    headers: { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+
+const formatDate = (ms?: number) =>
+  ms ? new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(ms) : null;
+
+// Tells the browser's passkey provider which credentials the server still accepts,
+// so deleted passkeys get removed from the user's authenticator.
+async function syncAcceptedCredentials(user: SessionUser, list: StoredPasskey[]) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: location.hostname,
+      userId: user.id,
+      allAcceptedCredentialIds: list.map((c) => c.id),
+    });
+  } catch (e) {
+    console.error('signalAllAcceptedCredentials failed:', e);
+  }
+}
+
+async function syncUserDetails(user: SessionUser) {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId: location.hostname,
+      userId: user.id,
+      name: user.name,
+      displayName: user.displayName,
+    });
+  } catch (e) {
+    console.error('signalCurrentUserDetails failed:', e);
+  }
+}
+
+const inputClass =
+  'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500';
+const buttonClass =
+  'py-1.5 px-3 border border-gray-300 rounded-md text-sm font-medium text-gray-800 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500';
+
+export default function PasskeyManager() {
+  const [user, setUser] = useState<SessionUser | null>(null);
+  const [credentials, setCredentials] = useState<StoredPasskey[] | null>(null);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [draftName, setDraftName] = useState('');
+  const [profile, setProfile] = useState({ name: '', displayName: '' });
+  const [status, setStatus] = useState<{ type: 'error' | 'success'; text: string } | null>(null);
+
+  const reload = async () => {
+    const res = await fetch(api('credentials.json'));
+    if (!res.ok) {
+      setStatus({ type: 'error', text: 'Could not load your passkeys. Please sign in again.' });
+      return null;
+    }
+    const data: { user: SessionUser; credentials: StoredPasskey[] } = await res.json();
+    setUser(data.user);
+    setProfile({ name: data.user.name, displayName: data.user.displayName });
+    setCredentials(data.credentials);
+    return data;
+  };
+
+  useEffect(() => {
+    reload().then((data) => data && syncAcceptedCredentials(data.user, data.credentials));
+  }, []);
+
+  const saveCredentialName = async (e: React.FormEvent, id: string) => {
+    e.preventDefault();
+    const res = await send(`credential/${encodeURIComponent(id)}`, 'PUT', { name: draftName });
+    if (res.ok) {
+      setEditingId(null);
+      setStatus({ type: 'success', text: 'Passkey renamed.' });
+      await reload();
+    } else {
+      setStatus({ type: 'error', text: (await res.json()).error ?? 'Could not rename passkey.' });
+    }
+  };
+
+  const remove = async (cred: StoredPasskey) => {
+    if (!confirm(`Remove "${cred.name}"? You won't be able to sign in with it anymore.`)) return;
+    const res = await send(`credential/${encodeURIComponent(cred.id)}`, 'DELETE');
+    if (!res.ok) {
+      setStatus({ type: 'error', text: 'Could not remove passkey.' });
+      return;
+    }
+    setStatus({ type: 'success', text: 'Passkey removed.' });
+    const data = await reload();
+    if (data) await syncAcceptedCredentials(data.user, data.credentials);
+  };
+
+  const saveProfile = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const res = await send('user', 'PUT', profile);
+    if (!res.ok) {
+      setStatus({ type: 'error', text: (await res.json()).error ?? 'Could not update account.' });
+      return;
+    }
+    const updated: SessionUser = await res.json();
+    setUser(updated);
+    setStatus({ type: 'success', text: 'Account details updated.' });
+    await syncUserDetails(updated);
+  };
+
+  return (
+    <div className="max-w-2xl mx-auto space-y-8">
+      <h1 className="text-2xl font-bold text-gray-800">Account settings</h1>
+
+      <div aria-live="polite">
+        {status && (
+          <div
+            role={status.type === 'error' ? 'alert' : 'status'}
+            className={`p-3 text-sm rounded-lg ${
+              status.type === 'error' ? 'text-red-700 bg-red-100' : 'text-green-700 bg-green-100'
+            }`}
+          >
+            {status.text}
+          </div>
+        )}
+      </div>
+
+      <section aria-labelledby="profile-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 id="profile-heading" className="text-lg font-semibold mb-1 text-gray-800">Account name</h2>
+        <p className="text-sm text-gray-600 mb-4">
+          Shown by your password manager next to your passkeys.
+        </p>
+        <form onSubmit={saveProfile} className="space-y-4">
+          <div>
+            <label htmlFor="acct-name" className="block text-sm font-medium text-gray-700 mb-1">Username</label>
+            <input id="acct-name" className={inputClass} required maxLength={80} value={profile.name}
+              onChange={(e) => setProfile({ ...profile, name: e.target.value })} />
+          </div>
+          <div>
+            <label htmlFor="acct-display" className="block text-sm font-medium text-gray-700 mb-1">Display name</label>
+            <input id="acct-display" className={inputClass} required maxLength={80} value={profile.displayName}
+              onChange={(e) => setProfile({ ...profile, displayName: e.target.value })} />
+          </div>
+          <button type="submit" disabled={!user}
+            className="py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75">
+            Save
+          </button>
+        </form>
+      </section>
+
+      <section aria-labelledby="passkeys-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 id="passkeys-heading" className="text-lg font-semibold mb-4 text-gray-800">Passkeys</h2>
+        {credentials === null ? (
+          <p className="text-sm text-gray-600">Loading…</p>
+        ) : credentials.length === 0 ? (
+          <p className="text-sm text-gray-600">No passkeys found.</p>
+        ) : (
+          <ul className="divide-y divide-gray-200">
+            {credentials.map((cred) => (
+              <li key={cred.id} className="py-4 flex items-start gap-3">
+                {cred.providerIcon ? (
+                  <img src={cred.providerIcon} alt="" width={32} height={32} className="mt-0.5 shrink-0" />
+                ) : (
+                  <KeyIcon className="w-8 h-8 mt-0.5 shrink-0 text-gray-500" aria-hidden="true" />
+                )}
+                <div className="min-w-0 flex-1">
+                  {editingId === cred.id ? (
+                    <form onSubmit={(e) => saveCredentialName(e, cred.id)} className="flex gap-2">
+                      <label htmlFor={`rename-${cred.id}`} className="sr-only">Passkey name</label>
+                      <input id={`rename-${cred.id}`} className={inputClass} required maxLength={80} autoFocus
+                        value={draftName} onChange={(e) => setDraftName(e.target.value)} />
+                      <button type="submit" className={buttonClass}>Save</button>
+                      <button type="button" className={buttonClass} onClick={() => setEditingId(null)}>Cancel</button>
+                    </form>
+                  ) : (
+                    <>
+                      <p className="font-medium text-gray-900 break-words">{cred.name}</p>
+                      <p className="text-sm text-gray-600">
+                        Created {formatDate(cred.registeredAt)}
+                        {cred.lastUsedAt ? ` · Last used ${formatDate(cred.lastUsedAt)}` : ''}
+                      </p>
+                    </>
+                  )}
+                </div>
+                {editingId !== cred.id && (
+                  <div className="flex gap-2 shrink-0">
+                    <button type="button" className={buttonClass}
+                      onClick={() => { setEditingId(cred.id); setDraftName(cred.name); }}>
+                      Rename<span className="sr-only"> {cred.name}</span>
+                    </button>
+                    <button type="button" className={`${buttonClass} text-red-700`} onClick={() => remove(cred)}>
+                      Remove<span className="sr-only"> {cred.name}</span>
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+    </div>
+  );
+}
