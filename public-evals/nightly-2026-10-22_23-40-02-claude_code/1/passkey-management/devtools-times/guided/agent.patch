+++ b/src/pages/api/user.ts
@@ -0,0 +1,15 @@
+import type { APIRoute } from 'astro';
+import { getUser, json, unauthorized } from '../../utils/passkeys';
+
+export const PUT: APIRoute = async ({ request, session }) => {
+  const user = await getUser(session);
+  if (!user) return unauthorized();
+  const { name, displayName } = await request.json();
+  const valid = (v: unknown) => typeof v === 'string' && v.trim() && v.length <= 80;
+  if (!valid(name) || !valid(displayName)) {
+    return json({ error: 'Username and display name are required (max 80 characters).' }, 400);
+  }
+  const updated = { ...user, name: name.trim(), displayName: displayName.trim() };
+  session?.set('user', updated);
+  return json(updated);
+};
