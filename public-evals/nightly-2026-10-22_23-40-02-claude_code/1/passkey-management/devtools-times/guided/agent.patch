+++ b/src/pages/api/credential/[id].ts
@@ -0,0 +1,24 @@
+import type { APIRoute } from 'astro';
+import { getPasskeys, getUser, json, unauthorized } from '../../../utils/passkeys';
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  if (!(await getUser(session))) return unauthorized();
+  const { name } = await request.json();
+  if (typeof name !== 'string' || !name.trim() || name.length > 80) {
+    return json({ error: 'Enter a name up to 80 characters.' }, 400);
+  }
+  const list = await getPasskeys(session);
+  const cred = list.find((c) => c.id === params.id);
+  if (!cred) return json({ error: 'Credential not found.' }, 404);
+  cred.name = name.trim();
+  session?.set('passkeys', list);
+  return json(cred);
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  if (!(await getUser(session))) return unauthorized();
+  const list = await getPasskeys(session);
+  if (!list.some((c) => c.id === params.id)) return json({ error: 'Credential not found.' }, 404);
+  session?.set('passkeys', list.filter((c) => c.id !== params.id));
+  return json({ success: true });
+};
