@@ -0,0 +1,28 @@
+import type { AstroSession } from 'astro';
+
+export interface SessionUser {
+  /** Base64URL-encoded user handle, as used by the WebAuthn Signal API. */
+  id: string;
+  name: string;
+  displayName: string;
+}
+
+export interface StoredPasskey {
+  /** Base64URL-encoded credential ID. */
+  id: string;
+  name: string;
+  aaguid: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export const getUser = (session?: AstroSession) => session?.get('user') as Promise<SessionUser | undefined>;
+
+export const getPasskeys = async (session?: AstroSession): Promise<StoredPasskey[]> =>
+  ((await session?.get('passkeys')) as StoredPasskey[] | undefined) ?? [];
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+export const unauthorized = () => json({ error: 'Sign in required.' }, 401);
