diff --git a/account.html b/account.html
new file mode 100644
index 0000000..bb6bb94
--- /dev/null
+++ b/account.html
@@ -0,0 +1,421 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <style>
+    :root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+      --danger: #b3261e;
+    }
+
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+    }
+
+    nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+    }
+
+    .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; color: white; text-decoration: none; }
+    nav ul { display: flex; list-style: none; }
+    nav ul li { margin-left: 20px; }
+    nav a { color: white; text-decoration: none; font-size: 0.9rem; transition: color 0.3s; }
+    nav a:hover { color: var(--accent); }
+    nav a[aria-current="page"] { color: var(--accent); }
+    .logout-link { border: 1px solid var(--accent); padding: 5px 12px; border-radius: 4px; }
+
+    .container { max-width: 800px; margin: 40px auto; padding: 0 20px; }
+
+    .panel {
+      background: white;
+      padding: 24px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      margin-top: 20px;
+    }
+
+    .panel-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
+    .panel h2 { color: var(--primary); }
+    .muted { color: #6d4c41; font-size: 0.9rem; }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary);
+      color: white;
+      border: 1px solid var(--primary);
+      padding: 8px 16px;
+      font: inherit;
+      font-size: 0.9rem;
+      border-radius: 5px;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+    .btn:hover { background: #3e2723; }
+    .btn:disabled { opacity: 0.6; cursor: not-allowed; }
+    .btn.secondary { background: white; color: var(--primary); }
+    .btn.secondary:hover { background: var(--secondary); }
+    .btn.danger { background: white; color: var(--danger); border-color: var(--danger); }
+    .btn.danger:hover { background: var(--danger); color: white; }
+    .btn:focus-visible, input:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
+
+    .passkey-list { list-style: none; margin-top: 16px; }
+    .passkey {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 16px;
+      flex-wrap: wrap;
+      padding: 16px 0;
+      border-top: 1px solid var(--secondary);
+    }
+    .passkey-info { flex: 1 1 260px; min-width: 0; }
+    .passkey-name { font-weight: 600; overflow-wrap: anywhere; }
+    .passkey-actions { display: flex; gap: 8px; }
+
+    .rename-form { display: flex; gap: 8px; flex: 1 1 260px; flex-wrap: wrap; }
+    .rename-form input {
+      flex: 1 1 160px;
+      padding: 8px 10px;
+      font: inherit;
+      border: 1px solid var(--primary);
+      border-radius: 5px;
+    }
+
+    .badge {
+      display: inline-block;
+      font-size: 0.75rem;
+      background: var(--secondary);
+      border-radius: 10px;
+      padding: 0 8px;
+      margin-left: 6px;
+      vertical-align: middle;
+    }
+
+    .status {
+      margin-top: 16px;
+      padding: 10px 14px;
+      border-radius: 5px;
+      background: #f1ece9;
+    }
+    .status.error { background: #fdecea; color: var(--danger); }
+    .status[hidden] { display: none; }
+    .empty { margin-top: 16px; }
+
+    footer { background: var(--secondary); text-align: center; padding: 40px 20px; margin-top: 40px; }
+  </style>
+</head>
+
+<body>
+
+  <nav>
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account" aria-current="page">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <main class="container">
+    <h1>My Account</h1>
+
+    <section class="panel" aria-labelledby="passkeys-heading">
+      <div class="panel-header">
+        <div>
+          <h2 id="passkeys-heading">Passkeys</h2>
+          <p class="muted">Passkeys let you sign in with your fingerprint, face, or device PIN instead of a password.</p>
+        </div>
+        <button type="button" class="btn" id="add-passkey">Add a passkey</button>
+      </div>
+
+      <p id="status" class="status" role="status" aria-live="polite" hidden></p>
+      <p id="loading" class="empty muted">Loading your passkeys…</p>
+      <p id="empty" class="empty" hidden>You haven't registered any passkeys yet.</p>
+      <ul id="passkey-list" class="passkey-list"></ul>
+    </section>
+  </main>
+
+  <footer>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <script>
+    /*
+     * Expected backend API (same-origin, session cookie auth, JSON):
+     *   GET    /api/passkeys                  -> { userId, userName, displayName, passkeys: [{ id, name, createdAt, lastUsedAt }] }
+     *                                            `id` is the base64url credential ID; `userId` is the base64url WebAuthn user handle.
+     *   PATCH  /api/passkeys/:id  {name}      -> 200 updated passkey
+     *   DELETE /api/passkeys/:id              -> 204
+     *   POST   /api/passkeys/register/options -> PublicKeyCredentialCreationOptions (JSON form)
+     *   POST   /api/passkeys/register/verify  -> registration response; 200 on success
+     * A 401 means the session expired.
+     */
+    const API = '/api/passkeys';
+    const rpId = location.hostname;
+
+    const listEl = document.getElementById('passkey-list');
+    const statusEl = document.getElementById('status');
+    const loadingEl = document.getElementById('loading');
+    const emptyEl = document.getElementById('empty');
+    const addBtn = document.getElementById('add-passkey');
+
+    let account = null; // { userId, userName, displayName, passkeys }
+
+    function showStatus(message, isError = false) {
+      statusEl.textContent = message;
+      statusEl.classList.toggle('error', isError);
+      statusEl.hidden = !message;
+    }
+
+    async function api(path, options = {}) {
+      const res = await fetch(path, {
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+        ...options,
+      });
+      if (res.status === 401) {
+        location.href = '/login?next=/account';
+        throw new Error('Your session has expired. Please sign in again.');
+      }
+      if (!res.ok) {
+        let detail = '';
+        try { detail = (await res.json()).error || ''; } catch (_) {}
+        throw new Error(detail || `Request failed (${res.status})`);
+      }
+      return res.status === 204 ? null : res.json();
+    }
+
+    function formatDate(value) {
+      if (!value) return 'never';
+      return new Date(value).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+    }
+
+    /* ---- Browser authenticator sync (WebAuthn Signal API) ---- */
+
+    // Tell the browser/credential manager which passkeys the server still accepts,
+    // so deleted ones are hidden/removed from the authenticator.
+    async function signalAcceptedCredentials() {
+      if (!account || !window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+      try {
+        await PublicKeyCredential.signalAllAcceptedCredentials({
+          rpId,
+          userId: account.userId,
+          allAcceptedCredentialIds: account.passkeys.map(p => p.id),
+        });
+      } catch (err) {
+        console.warn('Could not sync passkeys with the browser:', err);
+      }
+    }
+
+    async function signalUnknownCredential(credentialId) {
+      if (!window.PublicKeyCredential?.signalUnknownCredential) return;
+      try {
+        await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+      } catch (err) {
+        console.warn('Could not sync deleted passkey with the browser:', err);
+      }
+    }
+
+    // Keep the account name/display name shown by the authenticator current.
+    async function signalUserDetails() {
+      if (!account || !window.PublicKeyCredential?.signalCurrentUserDetails) return;
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails({
+          rpId,
+          userId: account.userId,
+          name: account.userName,
+          displayName: account.displayName,
+        });
+      } catch (err) {
+        console.warn('Could not sync account details with the browser:', err);
+      }
+    }
+
+    /* ---- Rendering ---- */
+
+    function render() {
+      listEl.replaceChildren();
+      loadingEl.hidden = true;
+      emptyEl.hidden = account.passkeys.length > 0;
+      for (const passkey of account.passkeys) listEl.append(renderRow(passkey));
+    }
+
+    function renderRow(passkey) {
+      const li = document.createElement('li');
+      li.className = 'passkey';
+      li.dataset.id = passkey.id;
+
+      const info = document.createElement('div');
+      info.className = 'passkey-info';
+      const name = document.createElement('div');
+      name.className = 'passkey-name';
+      name.textContent = passkey.name || 'Unnamed passkey';
+      const meta = document.createElement('div');
+      meta.className = 'muted';
+      meta.textContent = `Added ${formatDate(passkey.createdAt)} · Last used ${formatDate(passkey.lastUsedAt)}`;
+      info.append(name, meta);
+
+      const actions = document.createElement('div');
+      actions.className = 'passkey-actions';
+      const renameBtn = button('Rename', 'btn secondary', () => startRename(li, passkey));
+      renameBtn.setAttribute('aria-label', `Rename passkey ${passkey.name || ''}`.trim());
+      const deleteBtn = button('Delete', 'btn danger', () => deletePasskey(passkey, deleteBtn));
+      deleteBtn.setAttribute('aria-label', `Delete passkey ${passkey.name || ''}`.trim());
+      actions.append(renameBtn, deleteBtn);
+
+      li.append(info, actions);
+      return li;
+    }
+
+    function button(label, className, onClick) {
+      const b = document.createElement('button');
+      b.type = 'button';
+      b.className = className;
+      b.textContent = label;
+      b.addEventListener('click', onClick);
+      return b;
+    }
+
+    function startRename(li, passkey) {
+      const form = document.createElement('form');
+      form.className = 'rename-form';
+      const input = document.createElement('input');
+      input.type = 'text';
+      input.value = passkey.name || '';
+      input.maxLength = 60;
+      input.required = true;
+      input.setAttribute('aria-label', 'Passkey name');
+      const save = button('Save', 'btn', () => {});
+      save.type = 'submit';
+      const cancel = button('Cancel', 'btn secondary', () => li.replaceWith(renderRow(passkey)));
+      form.append(input, save, cancel);
+      form.addEventListener('keydown', e => { if (e.key === 'Escape') cancel.click(); });
+      form.addEventListener('submit', async e => {
+        e.preventDefault();
+        const newName = input.value.trim();
+        if (!newName) return;
+        if (newName === passkey.name) return cancel.click();
+        save.disabled = cancel.disabled = true;
+        try {
+          const updated = await api(`${API}/${encodeURIComponent(passkey.id)}`, {
+            method: 'PATCH',
+            body: JSON.stringify({ name: newName }),
+          });
+          Object.assign(passkey, { name: updated?.name ?? newName });
+          const row = renderRow(passkey);
+          li.replaceWith(row);
+          row.querySelector('button')?.focus();
+          showStatus(`Renamed to "${passkey.name}".`);
+          await signalAcceptedCredentials();
+        } catch (err) {
+          save.disabled = cancel.disabled = false;
+          showStatus(err.message, true);
+        }
+      });
+
+      li.querySelector('.passkey-info').replaceWith(form);
+      li.querySelector('.passkey-actions').remove();
+      input.focus();
+      input.select();
+    }
+
+    async function deletePasskey(passkey, btn) {
+      const label = passkey.name || 'this passkey';
+      const last = account.passkeys.length === 1;
+      const warning = last
+        ? `Delete "${label}"? It's your only passkey, so you'll need another way to sign in afterwards.`
+        : `Delete "${label}"? You won't be able to use it to sign in anymore.`;
+      if (!confirm(warning)) return;
+
+      btn.disabled = true;
+      try {
+        await api(`${API}/${encodeURIComponent(passkey.id)}`, { method: 'DELETE' });
+        account.passkeys = account.passkeys.filter(p => p.id !== passkey.id);
+        render();
+        showStatus(`Deleted "${label}". Remove it from your device's password manager too if it still appears there.`);
+        await signalUnknownCredential(passkey.id);
+        await signalAcceptedCredentials();
+        addBtn.focus();
+      } catch (err) {
+        btn.disabled = false;
+        showStatus(err.message, true);
+      }
+    }
+
+    /* ---- Add a passkey ---- */
+
+    const b64uToBuf = s => {
+      const b64 = s.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(s.length / 4) * 4, '=');
+      return Uint8Array.from(atob(b64), c => c.charCodeAt(0)).buffer;
+    };
+
+    async function addPasskey() {
+      if (!window.PublicKeyCredential) {
+        return showStatus('This browser does not support passkeys.', true);
+      }
+      addBtn.disabled = true;
+      try {
+        const options = await api(`${API}/register/options`, { method: 'POST' });
+        // Prefer the browser's JSON parser (handles base64url fields) when available.
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON
+          ? PublicKeyCredential.parseCreationOptionsFromJSON(options)
+          : {
+              ...options,
+              challenge: b64uToBuf(options.challenge),
+              user: { ...options.user, id: b64uToBuf(options.user.id) },
+              excludeCredentials: (options.excludeCredentials || []).map(c => ({ ...c, id: b64uToBuf(c.id) })),
+            };
+        const credential = await navigator.credentials.create({ publicKey });
+        await api(`${API}/register/verify`, { method: 'POST', body: JSON.stringify(credential.toJSON()) });
+        await load();
+        showStatus('Passkey added.');
+      } catch (err) {
+        if (err.name === 'NotAllowedError') showStatus('Passkey setup was cancelled.', true);
+        else if (err.name === 'InvalidStateError') showStatus('This device already has a passkey for your account.', true);
+        else showStatus(err.message, true);
+      } finally {
+        addBtn.disabled = false;
+      }
+    }
+
+    /* ---- Init ---- */
+
+    async function load() {
+      account = await api(API);
+      render();
+      // Sync on every load so the authenticator reflects the server's current state.
+      await Promise.all([signalAcceptedCredentials(), signalUserDetails()]);
+    }
+
+    addBtn.addEventListener('click', addPasskey);
+    load().catch(err => {
+      loadingEl.hidden = true;
+      showStatus(err.message, true);
+    });
+  </script>
+
+</body>
+
+</html>
