@@ -119,8 +119,58 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Seasonal Favorites carousel */
+    .carousel {
+      display: flex;
+      gap: 20px;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      /* Vertical room so the scaled card and its shadow aren't clipped;
+         inline padding lets the first/last items reach the center */
+      padding: 40px max(20px, calc(50% - 140px));
+      margin-top: 20px;
+    }
+
+    .carousel-item {
+      flex: 0 0 280px;
+      scroll-snap-align: center;
+      container-type: scroll-state;
+    }
+
+    .carousel .card {
+      height: 100%;
+      background: #e0e0e0;
+      transition:
+        scale 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
+        background-color 0.4s,
+        color 0.4s,
+        box-shadow 0.4s;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @container scroll-state(snapped: x) {
+        .carousel .card {
+          background: #007bff;
+          color: white;
+          scale: 1.15;
+          box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
+        }
+
+        .carousel .card h3 {
+          color: white;
+        }
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .carousel .card {
+        transition: none !important;
+        scale: 1 !important;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
