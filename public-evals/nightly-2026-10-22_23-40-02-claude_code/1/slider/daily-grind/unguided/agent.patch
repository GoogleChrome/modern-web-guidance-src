+  <script>
+    // Sync the visual fill (and readout); the native input handles value, keyboard and a11y.
+    document.querySelectorAll('input[type="range"].range').forEach(function (range) {
+      var out = document.getElementById(range.id + '-out');
+      function update() {
+        var min = +range.min || 0, max = +range.max || 100;
+        range.style.setProperty('--fill', ((range.value - min) / (max - min)) * 100 + '%');
+        if (out) out.textContent = range.value + ' of ' + max;
+      }
+      range.addEventListener('input', update);
+      update();
+    });
+  </script>
