+    /* Range slider */
+    .slider-field {
+      max-width: 480px;
+      margin: 20px auto 0;
+      text-align: left;
+    }
+
+    .slider-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      margin-bottom: 8px;
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .slider-header output {
+      font-variant-numeric: tabular-nums;
+      color: var(--text);
+    }
+
+    input[type="range"].range {
+      --track-h: 8px;
+      --thumb: 24px;
+      --fill: 0%;
+      --track-bg: var(--secondary);
+      -webkit-appearance: none;
+      appearance: none;
+      width: 100%;
+      height: var(--thumb);
+      background: transparent;
+      cursor: pointer;
+      display: block;
+    }
+
+    /* Track + fill (WebKit/Blink: fill drawn with a hard-stop gradient driven by --fill) */
+    input[type="range"].range::-webkit-slider-runnable-track {
+      height: var(--track-h);
+      border-radius: var(--track-h);
+      background: linear-gradient(to right, var(--primary) var(--fill), var(--track-bg) var(--fill));
+    }
+
+    input[type="range"].range::-webkit-slider-thumb {
+      -webkit-appearance: none;
+      appearance: none;
+      width: var(--thumb);
+      height: var(--thumb);
+      margin-top: calc((var(--track-h) - var(--thumb)) / 2);
+      border-radius: 50%;
+      background: var(--accent);
+      border: 3px solid var(--primary);
+      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
+      transition: transform 0.15s, box-shadow 0.15s;
+    }
+
+    /* Firefox */
+    input[type="range"].range::-moz-range-track {
+      height: var(--track-h);
+      border-radius: var(--track-h);
+      background: var(--track-bg);
+    }
+
+    input[type="range"].range::-moz-range-progress {
+      height: var(--track-h);
+      border-radius: var(--track-h);
+      background: var(--primary);
+    }
+
+    input[type="range"].range::-moz-range-thumb {
+      box-sizing: border-box;
+      width: var(--thumb);
+      height: var(--thumb);
+      border-radius: 50%;
+      background: var(--accent);
+      border: 3px solid var(--primary);
+      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
+      transition: transform 0.15s, box-shadow 0.15s;
+    }
+
+    /* Hover / active */
+    input[type="range"].range:hover::-webkit-slider-thumb {
+      transform: scale(1.08);
+    }
+
+    input[type="range"].range:active::-webkit-slider-thumb {
+      transform: scale(1.15);
+    }
+
+    input[type="range"].range:hover::-moz-range-thumb {
+      transform: scale(1.08);
+    }
+
+    input[type="range"].range:active::-moz-range-thumb {
+      transform: scale(1.15);
+    }
+
+    /* Focus: keyboard focus only, high-contrast ring on the thumb */
+    input[type="range"].range:focus {
+      outline: none;
+    }
+
+    input[type="range"].range:focus-visible::-webkit-slider-thumb {
+      box-shadow: 0 0 0 3px var(--light), 0 0 0 6px var(--text);
+    }
+
+    input[type="range"].range:focus-visible::-moz-range-thumb {
+      box-shadow: 0 0 0 3px var(--light), 0 0 0 6px var(--text);
+    }
+
+    /* Disabled */
+    input[type="range"].range:disabled {
+      cursor: not-allowed;
+      opacity: 0.5;
+    }
+
+    @media (forced-colors: active) {
+      input[type="range"].range::-webkit-slider-thumb {
+        background: ButtonText;
+      }
+
+      input[type="range"].range::-moz-range-thumb {
+        background: ButtonText;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      input[type="range"].range::-webkit-slider-thumb,
+      input[type="range"].range::-moz-range-thumb {
+        transition: none;
+      }
+    }
+
+    .slider-scale {
+      display: flex;
+      justify-content: space-between;
+      font-size: 0.8rem;
+      margin-top: 4px;
+      color: var(--primary);
+    }
+
