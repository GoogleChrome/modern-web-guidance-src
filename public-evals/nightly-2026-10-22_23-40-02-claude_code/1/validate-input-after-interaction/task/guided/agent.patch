     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletter = document.getElementById('newsletter');
+    const newsletterEmail = newsletter.elements.email;
+    const syncAria = () =>
+      newsletterEmail.setAttribute('aria-invalid', newsletterEmail.matches(':user-invalid'));
+
+    newsletterEmail.addEventListener('blur', syncAria);
+    newsletterEmail.addEventListener('input', () => {
+      if (newsletterEmail.hasAttribute('aria-invalid')) syncAria();
+    });
+
+    newsletter.addEventListener('submit', (e) => {
+      e.preventDefault();
+      newsletter.querySelector('.newsletter-status').textContent = 'Thanks for signing up!';
+      newsletter.reset();
+      newsletterEmail.removeAttribute('aria-invalid');
+    });
+  </script>
 </body>
 
