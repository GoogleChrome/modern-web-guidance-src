     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var error = document.getElementById('newsletter-error');
+
+      function validate() {
+        var message = '';
+        if (input.validity.valueMissing) {
+          message = 'Please enter your email address.';
+        } else if (input.validity.typeMismatch) {
+          message = 'Please enter a valid email address.';
+        }
+        error.textContent = message;
+        input.setAttribute('aria-invalid', message ? 'true' : 'false');
+        return !message;
+      }
+
+      // Validate only after the user leaves the field, never while typing.
+      input.addEventListener('blur', function () {
+        input.classList.add('touched');
+        validate();
+      });
+
+      // Once an error is showing, clear it as soon as the value becomes valid.
+      input.addEventListener('input', function () {
+        if (input.classList.contains('touched') && input.checkValidity()) {
+          validate();
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        input.classList.add('touched');
+        if (!validate()) {
+          input.focus();
+          return;
+        }
+        // No backend yet: swap in a confirmation message.
+        form.innerHTML = '<p class="newsletter-success">Thanks for subscribing!</p>';
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
