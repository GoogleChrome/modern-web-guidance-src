+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterStatus = document.getElementById('newsletter-status');
+
+    // Mirror the visual :user-invalid state so aria-invalid (and thus the
+    // aria-errormessage announcement) only exists while the error is visible.
+    const syncAriaInvalid = () => {
+      if (newsletterEmail.matches(':user-invalid')) {
+        newsletterEmail.setAttribute('aria-invalid', 'true');
+      } else {
+        newsletterEmail.removeAttribute('aria-invalid');
+      }
+    };
+
+    newsletterEmail.addEventListener('blur', syncAriaInvalid);
+    // Clears immediately once the email becomes valid; also covers editing after an error
+    newsletterEmail.addEventListener('input', () => {
+      newsletterStatus.textContent = '';
+      syncAriaInvalid();
+    });
+    // Submit attempt with invalid value: wait a tick so :user-invalid has updated
+    newsletterEmail.addEventListener('invalid', () => queueMicrotask(syncAriaInvalid));
+
+    newsletterForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      newsletterForm.reset();
+      syncAriaInvalid();
+      newsletterStatus.textContent = 'Thanks for subscribing!';
+    });
+  </script>
+
 </body>
 
