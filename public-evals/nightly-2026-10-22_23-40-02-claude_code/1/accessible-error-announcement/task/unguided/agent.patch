     </section>
   </main>
 
   <footer>
+    <form class="newsletter" id="newsletter-form" novalidate>
+      <h3 id="newsletter-title">Join our newsletter</h3>
+      <div class="newsletter-row">
+        <input type="email" id="newsletter-email" name="email" required autocomplete="email"
+          placeholder="you@example.com" aria-labelledby="newsletter-title" aria-describedby="newsletter-error">
+        <button type="submit">Sign Up</button>
+      </div>
+      <!-- Only rendered (and therefore announced) while the visual error is showing -->
+      <p class="newsletter-error" id="newsletter-error" role="alert" hidden></p>
