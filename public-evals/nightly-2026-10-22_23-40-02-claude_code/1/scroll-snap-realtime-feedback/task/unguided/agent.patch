+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbs = Array.from(document.querySelectorAll('.thumbnail'));
+      let lastLeft = gallery.scrollLeft;
+      let settleTimer = null;
+
+      // scrollLeft at which an item is centered (matches scroll-snap-align: center)
+      const centerOf = (item) => item.offsetLeft + item.offsetWidth / 2 - gallery.clientWidth / 2;
+
+      // Item the scroll is heading towards, based on current position and direction
+      function targetIndex(dir) {
+        const pos = gallery.scrollLeft;
+        const eps = 2;
+        let idx = 0;
+        if (dir >= 0) {
+          idx = items.findIndex((item) => centerOf(item) >= pos - eps);
+          if (idx === -1) idx = items.length - 1;
+        } else {
+          items.forEach((item, i) => { if (centerOf(item) <= pos + eps) idx = i; });
+        }
+        return idx;
+      }
+
+      function setPending(index) {
+        thumbs.forEach((t, i) => t.classList.toggle('pending', i === index));
+      }
+
+      function settle() {
+        clearTimeout(settleTimer);
+        const pos = gallery.scrollLeft;
+        let idx = 0;
+        items.forEach((item, i) => {
+          if (Math.abs(centerOf(item) - pos) < Math.abs(centerOf(items[idx]) - pos)) idx = i;
+        });
+        thumbs.forEach((t, i) => {
+          t.classList.remove('pending');
+          t.classList.toggle('active', i === idx);
+          if (i === idx) t.setAttribute('aria-current', 'true');
+          else t.removeAttribute('aria-current');
+        });
+        lastLeft = pos;
+      }
+
+      gallery.addEventListener('scroll', () => {
+        const pos = gallery.scrollLeft;
+        if (pos !== lastLeft) {
+          setPending(targetIndex(pos - lastLeft));
+          lastLeft = pos;
+        }
+        // Fallback for browsers without scrollend
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(settle, 150);
+      }, { passive: true });
+
+      if ('onscrollend' in window) {
+        gallery.addEventListener('scrollend', settle);
+      }
+
+      thumbs.forEach((thumb, i) => {
+        thumb.addEventListener('click', () => {
+          items[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
+        });
+      });
+    })();
+  </script>
