+  <script>
+    (() => {
+      const container = document.getElementById('gallery');
+      const items = [...container.querySelectorAll('.gallery-item')];
+      const thumbnails = [...document.querySelectorAll('#gallery-thumbnails .thumbnail')];
+
+      const setPending = (index) => {
+        thumbnails.forEach((t) => t.classList.remove('pending'));
+        thumbnails[index]?.classList.add('pending');
+      };
+
+      const setActive = (index) => {
+        if (!thumbnails[index]) return;
+        thumbnails.forEach((t) => {
+          t.classList.remove('pending', 'active');
+          t.removeAttribute('aria-current');
+        });
+        thumbnails[index].classList.add('active');
+        thumbnails[index].setAttribute('aria-current', 'true');
+      };
+
+      // Items are center-aligned snap targets
+      const findClosestItemIndex = () => {
+        const center = container.scrollLeft + container.clientWidth / 2;
+        let closest = 0;
+        let min = Infinity;
+        items.forEach((item, i) => {
+          const d = Math.abs(center - (item.offsetLeft + item.offsetWidth / 2));
+          if (d < min) { min = d; closest = i; }
+        });
+        return closest;
+      };
+
+      thumbnails.forEach((thumb, i) => {
+        thumb.addEventListener('click', () => {
+          items[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
+        });
+      });
+
+      if ('onscrollsnapchanging' in Element.prototype) {
+        container.addEventListener('scrollsnapchanging', (e) => {
+          const i = items.indexOf(e.snapTargetInline);
+          if (i !== -1) setPending(i);
+        });
+        container.addEventListener('scrollsnapchange', (e) => {
+          const i = items.indexOf(e.snapTargetInline);
+          if (i !== -1) setActive(i);
+        });
+      } else {
+        let rafId = null;
+        let timeout;
+        container.addEventListener('scroll', () => {
+          if (!rafId) {
+            rafId = requestAnimationFrame(() => {
+              rafId = null;
+              setPending(findClosestItemIndex());
+            });
+          }
+          clearTimeout(timeout);
+          timeout = setTimeout(() => setActive(findClosestItemIndex()), 100);
+        }, { passive: true });
+        container.addEventListener('scrollend', () => {
+          clearTimeout(timeout);
+          setActive(findClosestItemIndex());
+        });
+      }
+
+      // Sync with restored scroll position on load
+      const init = () => setActive(findClosestItemIndex());
+      if (document.readyState === 'complete') init();
+      else window.addEventListener('load', init, { once: true });
+    })();
+  </script>
+
