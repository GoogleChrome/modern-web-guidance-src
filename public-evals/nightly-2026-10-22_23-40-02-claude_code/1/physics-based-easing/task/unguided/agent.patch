+    /* Spring: overshoots its target scale, then settles */
+    .card.spring {
+      transition: transform 0.7s cubic-bezier(0.34, 1.8, 0.64, 1), box-shadow 0.7s ease;
+      transition-timing-function: linear(
+        0, 0.009, 0.035 2.1%, 0.141, 0.281 6.7%, 0.723 12.9%, 0.938 16.7%,
+        1.017, 1.077, 1.121, 1.149 24.3%, 1.159, 1.163, 1.161, 1.154 29.9%,
+        1.129 32.8%, 1.051 39.6%, 1.017 43.1%, 0.991, 0.977 51%, 0.974 53.8%,
+        0.975 57.1%, 0.997 69.8%, 1.003 76.9%, 1.004 83.8%, 1
+      );
+      will-change: transform;
+    }
+
+    .card.spring:hover,
+    .card.spring:focus-within {
+      transform: scale(1.06);
+      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
+    }
+
+    /* Bounce: lifts and lands with a few diminishing bounces */
+    .card.bounce {
+      transition: transform 0.8s cubic-bezier(0.28, 0.84, 0.42, 1), box-shadow 0.8s ease;
+      transition-timing-function: linear(
+        0, 0.063 4.5%, 0.25 9.1%, 0.563 13.6%, 1 18.2%, 0.891 22.7%,
+        0.813 27.3%, 0.891 31.8%, 1 36.4%, 0.953 40.9%, 0.938 45.5%,
+        0.953 50%, 1 54.5%, 0.984 59%, 0.98 63.6%, 0.984 68%, 1 72.7%, 1
+      );
+      will-change: transform;
+    }
+
+    .card.bounce:hover,
+    .card.bounce:focus-within {
+      transform: translateY(-16px);
+      box-shadow: 0 16px 24px rgba(0, 0, 0, 0.18);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card.spring,
+      .card.bounce {
+        transition: none;
+      }
+
+      .card.spring:hover,
+      .card.spring:focus-within,
+      .card.bounce:hover,
+      .card.bounce:focus-within {
+        transform: none;
+      }
+    }
+
