+<script>
+    const root = document.querySelector<HTMLElement>('[data-top-stories]');
+    if (root) {
+        const viewport = root.querySelector<HTMLElement>('[data-viewport]')!;
+        const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
+        const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
+        const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
+        let current = 0;
+
+        const show = () => {
+            slides.forEach((slide, i) => {
+                slide.hidden = i !== current;
+                slide.setAttribute('aria-label', `${i + 1} of ${slides.length}`);
+            });
+        };
+
+        const go = (delta: number) => {
+            const target = (current + delta + slides.length) % slides.length;
+            const update = () => {
+                current = target;
+                show();
+            };
+            if (!document.startViewTransition) {
+                update();
+                return;
+            }
+            document.startViewTransition({
+                update,
+                types: [delta > 0 ? 'top-stories-next' : 'top-stories-prev'],
+            });
+        };
+
+        if (slides.length > 1) {
+            prev.hidden = next.hidden = false;
+            prev.addEventListener('click', () => go(-1));
+            next.addEventListener('click', () => go(1));
+            // Only the viewport is captured, so the rest of the page stays still.
+            viewport.style.viewTransitionName = 'top-stories';
+            root.setAttribute('aria-live', 'polite');
+        }
+        show();
+    }
+</script>
+
+<style is:global>
+    @keyframes top-stories-out-left { to { transform: translateX(-100%); } }
+    @keyframes top-stories-in-right { from { transform: translateX(100%); } }
+    @keyframes top-stories-out-right { to { transform: translateX(100%); } }
+    @keyframes top-stories-in-left { from { transform: translateX(-100%); } }
+
+    /* Clip the sliding snapshots to the slider's bounds */
+    ::view-transition-group(top-stories) {
+        animation-duration: 0.4s;
+        overflow: clip;
+    }
+    ::view-transition-old(top-stories),
+    ::view-transition-new(top-stories) {
+        animation: 0.4s ease-in-out both;
+    }
+    html:active-view-transition-type(top-stories-next)::view-transition-old(top-stories) {
+        animation-name: top-stories-out-left;
+    }
+    html:active-view-transition-type(top-stories-next)::view-transition-new(top-stories) {
+        animation-name: top-stories-in-right;
+    }
+    html:active-view-transition-type(top-stories-prev)::view-transition-old(top-stories) {
+        animation-name: top-stories-out-right;
+    }
+    html:active-view-transition-type(top-stories-prev)::view-transition-new(top-stories) {
+        animation-name: top-stories-in-left;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        ::view-transition-group(top-stories),
+        ::view-transition-old(top-stories),
+        ::view-transition-new(top-stories) {
+            animation: none !important;
+        }
+    }
+</style>
