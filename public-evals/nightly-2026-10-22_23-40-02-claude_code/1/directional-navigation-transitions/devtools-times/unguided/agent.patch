+</Layout>
+
+<style>
+    @keyframes slide-from-right {
+        from { transform: translateX(100%); opacity: 0; }
+        to { transform: translateX(0); opacity: 1; }
+    }
+    @keyframes slide-from-left {
+        from { transform: translateX(-100%); opacity: 0; }
+        to { transform: translateX(0); opacity: 1; }
+    }
+    .top-story.slide-next { animation: slide-from-right 300ms ease-out; }
+    .top-story.slide-prev { animation: slide-from-left 300ms ease-out; }
+    @media (prefers-reduced-motion: reduce) {
+        .top-story.slide-next,
+        .top-story.slide-prev { animation: none; }
+    }
+</style>
+
+<script>
+    document.querySelectorAll<HTMLElement>('.top-stories').forEach((root) => {
+        const slides = Array.from(root.querySelectorAll<HTMLElement>('.top-story'));
+        let current = 0;
+
+        const go = (direction: 1 | -1) => {
+            const next = (current + direction + slides.length) % slides.length;
+            if (next === current) return;
+            slides[current].hidden = true;
+            const slide = slides[next];
+            slide.classList.remove('slide-next', 'slide-prev');
+            slide.hidden = false;
+            // Force reflow so the animation restarts on revisited slides
+            void slide.offsetWidth;
+            slide.classList.add(direction === 1 ? 'slide-next' : 'slide-prev');
+            current = next;
+        };
+
+        root.querySelector('[data-next]')?.addEventListener('click', () => go(1));
+        root.querySelector('[data-prev]')?.addEventListener('click', () => go(-1));
+    });
+</script>
