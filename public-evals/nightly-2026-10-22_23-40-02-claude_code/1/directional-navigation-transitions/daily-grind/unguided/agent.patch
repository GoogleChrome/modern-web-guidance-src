+  <script>
+    (function () {
+      var carousel = document.querySelector('.carousel');
+      var items = Array.prototype.slice.call(carousel.querySelectorAll('.card'));
+      var status = carousel.querySelector('.carousel-status');
+      var current = 0;
+
+      function show(index, direction) {
+        current = (index + items.length) % items.length;
+        items.forEach(function (item, i) {
+          item.hidden = i !== current;
+          item.classList.remove('enter-next', 'enter-prev');
+        });
+        if (direction) {
+          items[current].classList.add(direction > 0 ? 'enter-next' : 'enter-prev');
+        }
+        status.textContent = (current + 1) + ' of ' + items.length;
+      }
+
+      carousel.querySelector('[data-next]').addEventListener('click', function () {
+        show(current + 1, 1);
+      });
+      carousel.querySelector('[data-prev]').addEventListener('click', function () {
+        show(current - 1, -1);
+      });
+
+      show(0, 0);
+    })();
+  </script>
+
