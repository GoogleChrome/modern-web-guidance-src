+
+    /* Clip the sliding item to the carousel's bounds */
+    ::view-transition-group(seasonal-item) {
+      overflow: clip;
+    }
+
+    @keyframes slide-to-left {
+      to { transform: translateX(-100%); }
+    }
+
+    @keyframes slide-from-right {
+      from { transform: translateX(100%); }
+    }
+
+    @keyframes slide-to-right {
+      to { transform: translateX(100%); }
+    }
+
+    @keyframes slide-from-left {
+      from { transform: translateX(-100%); }
+    }
+
+    ::view-transition-old(seasonal-item),
+    ::view-transition-new(seasonal-item) {
+      animation-duration: 0.4s;
+      animation-timing-function: ease-in-out;
+      animation-fill-mode: both;
+      mix-blend-mode: normal;
+    }
+
+    html:active-view-transition-type(next)::view-transition-old(seasonal-item) {
+      animation-name: slide-to-left;
+    }
+
+    html:active-view-transition-type(next)::view-transition-new(seasonal-item) {
+      animation-name: slide-from-right;
+    }
+
+    html:active-view-transition-type(previous)::view-transition-old(seasonal-item) {
+      animation-name: slide-to-right;
+    }
+
+    html:active-view-transition-type(previous)::view-transition-new(seasonal-item) {
+      animation-name: slide-from-left;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(seasonal-item),
+      ::view-transition-old(seasonal-item),
+      ::view-transition-new(seasonal-item) {
+        animation: none !important;
+      }
+    }
