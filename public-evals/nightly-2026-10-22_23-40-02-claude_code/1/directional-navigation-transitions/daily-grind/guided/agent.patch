+  <script>
+    (() => {
+      const items = [...document.querySelectorAll('.carousel-viewport .card')];
+      const status = document.getElementById('seasonal-status');
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      let current = 0;
+
+      function show(index) {
+        items.forEach((item, i) => { item.hidden = i !== index; });
+        status.textContent = `${index + 1} / ${items.length}`;
+      }
+
+      function go(step, direction) {
+        const index = (current + step + items.length) % items.length;
+        const update = () => { current = index; show(index); };
+        if (!document.startViewTransition || reducedMotion.matches) {
+          update();
+          return;
+        }
+        document.startViewTransition({ update, types: [direction] });
+      }
+
+      document.getElementById('seasonal-next').addEventListener('click', () => go(1, 'next'));
+      document.getElementById('seasonal-prev').addEventListener('click', () => go(-1, 'previous'));
+      show(current);
+    })();
+  </script>
 </body>
 
