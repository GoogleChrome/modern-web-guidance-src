       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Promo alert: collapses to zero height when dismissed (no JS) */
+    #promo-alert {
+      display: grid;
+      grid-template-rows: 1fr;
+      background: var(--accent);
+      color: var(--text);
+      transition: grid-template-rows 0.4s ease, opacity 0.4s ease, visibility 0s 0s;
+    }
+
+    #promo-alert .promo-inner {
+      overflow: hidden;
+      min-height: 0;
+    }
+
+    #promo-alert .promo-row {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 1rem;
+      padding: 0.6rem 5%;
+    }
+
+    #alert-dismiss {
+      background: transparent;
+      border: 1px solid currentColor;
+      border-radius: 4px;
+      color: inherit;
+      cursor: pointer;
+      font: inherit;
+      line-height: 1;
+      padding: 0.25rem 0.5rem;
+    }
+
+    /* Hidden popover used purely as a declarative "dismissed" flag for the button */
+    #promo-dismissed {
+      position: absolute;
+      inline-size: 1px;
+      block-size: 1px;
+      margin: 0;
+      padding: 0;
+      border: 0;
+      overflow: hidden;
+      clip-path: inset(50%);
+      pointer-events: none;
+    }
+
+    body:has(#promo-dismissed:popover-open) #promo-alert {
+      grid-template-rows: 0fr;
+      opacity: 0;
+      visibility: hidden;
+      /* delay visibility so the collapse plays, then remove from the a11y tree */
+      transition: grid-template-rows 0.4s ease, opacity 0.4s ease, visibility 0s 0.4s;
+    }
+
+    /* FAQ accordion */
+    :root {
+      interpolate-size: allow-keywords;
+    }
+
+    .faq {
+      max-width: 700px;
+      margin: 60px auto 0;
+    }
+
+    .faq details {
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    #faq-trigger {
+      cursor: pointer;
+      font-weight: 600;
+      color: var(--primary);
+      padding: 16px 20px;
+    }
+
+    #faq-content {
+      padding: 0 20px 16px;
+    }
+
+    .faq details::details-content {
+      block-size: 0;
+      overflow: hidden;
+      transition: block-size 0.4s ease, content-visibility 0.4s allow-discrete;
+    }
+
+    .faq details[open]::details-content {
+      block-size: auto;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      #promo-alert,
+      .faq details::details-content {
+        transition: none !important;
+      }
+    }
   </style>
 </head>
 
