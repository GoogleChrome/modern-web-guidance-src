+  <script>
+    const TOAST_MS = 3000;
+
+    function dismissToast(toast) {
+      if (!toast.isConnected || toast.dataset.leaving) return;
+      toast.dataset.leaving = 'true';
+      toast.hidePopover();
+      Promise.allSettled(toast.getAnimations().map((a) => a.finished))
+        .then(() => toast.remove());
+    }
+
+    function showToast(message) {
+      const toast = document.createElement('div');
+      toast.className = 'toast';
+      toast.setAttribute('popover', 'manual');
+      toast.setAttribute('role', 'status');
+
+      const text = document.createElement('span');
+      text.textContent = message;
+
+      const close = document.createElement('button');
+      close.type = 'button';
+      close.className = 'toast-close';
+      close.setAttribute('aria-label', 'Close notification');
+      close.textContent = '\u00d7';
+      close.addEventListener('click', () => dismissToast(toast));
+
+      toast.append(text, close);
+      document.body.append(toast);
+      toast.showPopover();
+      setTimeout(() => dismissToast(toast), TOAST_MS);
+    }
+
+    document.querySelectorAll('.toast-trigger').forEach((btn) =>
+      btn.addEventListener('click', () => showToast('Added to cart!'))
+    );
+  </script>
