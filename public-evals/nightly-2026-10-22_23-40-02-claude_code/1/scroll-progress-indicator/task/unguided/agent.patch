     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers without CSS scroll-driven animations
+    if (!(window.CSS && CSS.supports('animation-timeline: scroll()'))) {
+      var root = document.documentElement;
+      var ticking = false;
+      var update = function () {
+        var max = root.scrollHeight - root.clientHeight;
+        var progress = max > 0 ? Math.min(Math.max(window.pageYOffset / max, 0), 1) : 0;
+        root.style.setProperty('--scroll-progress', progress);
+        ticking = false;
+      };
+      var onScroll = function () {
+        if (!ticking) {
+          ticking = true;
+          window.requestAnimationFrame(update);
+        }
+      };
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('resize', onScroll);
+      update();
+    }
+  </script>
