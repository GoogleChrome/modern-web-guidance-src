     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    // Temporal isn't in every browser yet (e.g. Safari), so load a polyfill when missing.
+    if (typeof Temporal === 'undefined') {
+      const { Temporal: T } = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = T;
+    }
+
+    const timer = document.querySelector('.promo-timer');
+    const remainingEl = timer.querySelector('.promo-remaining');
+    const remainingValue = timer.querySelector('.promo-remaining-value');
+    const elapsedEl = timer.querySelector('.promo-elapsed');
+    const elapsedValue = timer.querySelector('.promo-elapsed-value');
+
+    // Midnight in the user's own time zone
+    const tz = Temporal.Now.timeZoneId();
+    const toZoned = (dateTime) => Temporal.PlainDateTime.from(dateTime).toZonedDateTime(tz);
+    const start = toZoned(timer.dataset.start);
+    const end = toZoned(timer.dataset.end);
+    const now = Temporal.Now.zonedDateTimeISO(tz);
+
+    const options = { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'floor' };
+    const format = (duration) => duration.toLocaleString(undefined, { style: 'long' });
+    const show = (el, value, duration) => {
+      value.textContent = format(duration);
+      value.dateTime = duration.toString();
+    };
+
+    if (Temporal.ZonedDateTime.compare(now, start) < 0) {
+      // Promotion hasn't started yet
+      elapsedEl.hidden = true;
+      remainingEl.firstChild.textContent = 'Offer starts in ';
+      show(remainingEl, remainingValue, now.until(start, options));
+    } else if (Temporal.ZonedDateTime.compare(now, end) >= 0) {
+      // Promotion is over
+      remainingEl.textContent = 'This offer has ended';
+      elapsedEl.firstChild.textContent = 'It ran for ';
+      show(elapsedEl, elapsedValue, end.since(start, options));
+    } else {
+      show(remainingEl, remainingValue, now.until(end, options));
+      show(elapsedEl, elapsedValue, now.since(start, options));
+    }
+    timer.hidden = false;
+  </script>
+
 </body>
 
 </html>
