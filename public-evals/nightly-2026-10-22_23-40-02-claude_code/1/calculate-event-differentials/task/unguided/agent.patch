     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+<script>
+    (function () {
+      var HOUR = 36e5, DAY = 24 * HOUR;
+      var el = document.getElementById('maple-timer');
+      var start = new Date(el.dataset.start);
+      var end = new Date(el.dataset.end);
+      var now = new Date();
+
+      function plural(n, word) {
+        return n + ' ' + word + (n === 1 ? '' : 's');
+      }
+
+      function span(ms) {
+        var days = Math.floor(ms / DAY);
+        var hours = Math.floor((ms % DAY) / HOUR);
+        return plural(days, 'day') + ', ' + plural(hours, 'hour');
+      }
+
+      var remaining = el.querySelector('.promo-remaining');
+      var elapsed = el.querySelector('.promo-elapsed');
+
+      if (now >= end) {
+        remaining.textContent = 'This offer has ended.';
+      } else {
+        remaining.textContent = span(end - now) + ' left';
+      }
+      if (now >= start) {
+        elapsed.textContent = 'Started ' + span(Math.min(now, end) - start) + ' ago'
+          + (now >= end ? ' (ran ' + span(end - start) + ' total)' : '');
+      } else {
+        elapsed.textContent = 'Starts in ' + span(start - now);
+      }
+    })();
+  </script>
+
 </body>
 
