+  <script>
+    // Keep aria-invalid in sync with the :user-invalid state
+    const shop = document.getElementById('shop');
+    const syncAria = () => shop.setAttribute('aria-invalid', shop.matches(':user-invalid'));
+    shop.addEventListener('blur', syncAria);
