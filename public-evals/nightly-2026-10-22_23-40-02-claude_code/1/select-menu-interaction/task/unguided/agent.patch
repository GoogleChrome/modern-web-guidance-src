+  <script>
+    (function () {
+      var form = document.getElementById('order-form');
+      var shop = document.getElementById('shop');
+      var error = document.getElementById('shop-error');
+      var success = document.getElementById('order-success');
+      var touched = false;
+      var submitted = false;
+
+      function render() {
+        var invalid = !shop.value;
+        var show = invalid && (touched || submitted);
+        error.textContent = show ? 'Please select a local shop.' : '';
+        shop.setAttribute('aria-invalid', show ? 'true' : 'false');
+      }
+
+      shop.addEventListener('blur', function () { touched = true; render(); });
+      shop.addEventListener('change', function () { touched = true; render(); });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        submitted = true;
+        render();
+        success.hidden = !shop.value;
+        if (!shop.value) shop.focus();
+      });
+    })();
+  </script>
