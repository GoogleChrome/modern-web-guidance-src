+  <script>
+    // Local Network Access: Chromium prompts the user for permission when a
+    // public page requests a local-network or loopback address. The
+    // `targetAddressSpace` fetch option declares which one we are targeting.
+    // Usage: fetchLocal('http://localhost:8080/status')
+    (function () {
+      function addressSpaceFor(url) {
+        const host = new URL(url, location.href).hostname;
+        if (host === 'localhost' || host.endsWith('.localhost') ||
+          host === '[::1]' || /^127\./.test(host)) {
+          return 'loopback';
+        }
+        return 'local';
+      }
+
+      window.fetchLocal = function (url, options) {
+        return fetch(url, Object.assign({
+          targetAddressSpace: addressSpaceFor(url)
+        }, options));
+      };
+    })();
+  </script>
+
 </body>
 
