+  <script>
+    // Local Network Access: endpoints are illustrative; replace with real device/companion URLs.
+    const TARGETS = {
+      'loopback-network': { url: 'http://127.0.0.1:45678/health', space: 'loopback' },
+      'local-network': { url: 'http://192.168.1.100:8080/api/status', space: 'local' }
+    };
+    const statusEl = document.getElementById('local-status');
+
+    async function queryPermission(name) {
+      if (!navigator.permissions?.query) return 'prompt';
+      try {
+        const status = await navigator.permissions.query({ name });
+        status.addEventListener('change', () => updateRemediation(name, status.state));
+        return status.state;
+      } catch {
+        // Unrecognized permission name; proceed on user gesture
+        return 'prompt';
+      }
+    }
+
+    function updateRemediation(name, state) {
+      const box = document.querySelector(`[data-remediation="${name}"]`);
+      if (box) box.hidden = state !== 'denied';
+    }
+
+    async function connect(name) {
+      const { url, space } = TARGETS[name];
+      const state = await queryPermission(name);
+      updateRemediation(name, state);
+      if (state === 'denied') {
+        statusEl.textContent = 'Access blocked in browser settings.';
+        return;
+      }
+      statusEl.textContent = 'Connecting…';
+      try {
+        const response = await fetch(new Request(url, {
+          mode: 'cors',
+          targetAddressSpace: space
+        }));
+        if (!response.ok) throw new Error(`HTTP ${response.status}`);
+        statusEl.textContent = 'Connected.';
+      } catch {
+        updateRemediation(name, await queryPermission(name));
+        statusEl.textContent = 'Could not connect. Check that the device or app is running, on your network, and allowed in browser permissions.';
+      }
+    }
+
+    for (const [id, name] of [['connect-loopback', 'loopback-network'], ['connect-local', 'local-network']]) {
+      document.getElementById(id).addEventListener('click', () => connect(name));
+    }
+  </script>
