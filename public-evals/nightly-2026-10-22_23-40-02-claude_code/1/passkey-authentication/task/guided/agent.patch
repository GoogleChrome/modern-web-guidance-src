+  <script>
+    const statusEl = document.querySelector('[data-testid="auth-status"]');
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+
+    let autofillAbortController = new AbortController();
+
+    function setStatus(message, state) {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    async function fetchOptions() {
+      const response = await fetch('/api/login/options', { method: 'POST' });
+      if (!response.ok) throw new Error('Could not start sign-in');
+      return PublicKeyCredential.parseRequestOptionsFromJSON(await response.json());
+    }
+
+    // Sends the assertion to the server; returns true when authenticated.
+    async function verifyCredential(credential) {
+      const encoded = credential.toJSON();
+      try {
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+        });
+        if (response.ok) {
+          setStatus('Signed in with passkey.', 'success');
+          return true;
+        }
+        if (response.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+          // Credential no longer exists on the server: tell the passkey provider to drop it.
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: location.hostname,
+            credentialId: encoded.id,
+          }).catch(() => { });
+        }
+        setStatus('Passkey sign-in failed. Please try again.', 'error');
+      } catch (err) {
+        console.error('Verification request error:', err);
+        setStatus('Could not reach the server. Please try again.', 'error');
+      }
+      return false;
+    }
+
+    // Conditional UI: passkeys are offered as autofill suggestions on the username field.
+    async function initializeConditionalAutofill() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) return;
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalGet !== true) return;
+
+      let credential;
+      try {
+        const publicKey = await fetchOptions();
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+          mediation: 'conditional',
+        });
+      } catch (err) {
+        if (!['NotAllowedError', 'AbortError'].includes(err.name)) {
+          console.error('Unexpected conditional get error:', err);
+        }
+        return;
+      }
+      if (credential) await verifyCredential(credential);
+    }
+
+    // Explicit button: abort autofill request, then prompt directly (biometrics).
+    async function triggerButtonAuthentication() {
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      let credential;
+      try {
+        const publicKey = await fetchOptions();
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          setStatus('Passkey sign-in was cancelled.', 'error');
+        } else if (err.name !== 'AbortError') {
+          console.error(err);
+          setStatus('Passkey sign-in failed. Please try again.', 'error');
+        }
+        initializeConditionalAutofill(); // re-arm autofill
+        return;
+      }
+      if (!(await verifyCredential(credential))) initializeConditionalAutofill();
+    }
+
+    if (window.PublicKeyCredential) {
+      authButton.addEventListener('click', triggerButtonAuthentication);
+      window.addEventListener('DOMContentLoaded', initializeConditionalAutofill);
+    } else {
+      authButton.disabled = true;
+      setStatus('Passkeys are not supported in this browser.', 'error');
+    }
+  </script>
 </body>
 
