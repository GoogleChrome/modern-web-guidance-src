+  <script>
+    (() => {
+      const statusEl = document.querySelector('[data-testid="auth-status"]');
+      const usernameEl = document.querySelector('[data-testid="username-field"]');
+      const button = document.querySelector('[data-testid="auth-button"]');
+      let conditionalAbort = null;
+
+      const b64urlToBuf = (str) => {
+        const b64 = str.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(str.length / 4) * 4, '=');
+        return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)).buffer;
+      };
+      const bufToB64url = (buf) =>
+        btoa(String.fromCharCode(...new Uint8Array(buf)))
+          .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+
+      const setStatus = (msg, isError) => {
+        statusEl.textContent = msg;
+        statusEl.classList.toggle('error', !!isError);
+      };
+
+      async function getOptions() {
+        const res = await fetch('/api/login/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({ username: usernameEl.value.trim() || undefined })
+        });
+        if (!res.ok) throw new Error('Could not start sign-in');
+        const opts = await res.json();
+        const pk = opts.publicKey || opts;
+        pk.challenge = b64urlToBuf(pk.challenge);
+        (pk.allowCredentials || []).forEach((c) => { c.id = b64urlToBuf(c.id); });
+        return pk;
+      }
+
+      async function authenticate({ conditional }) {
+        // Only one WebAuthn request can be pending at a time.
+        if (conditionalAbort) conditionalAbort.abort();
+        const abort = new AbortController();
+        conditionalAbort = abort;
+
+        const publicKey = await getOptions();
+        if (conditional) {
+          // Autofill UI lists all discoverable passkeys; no allow list.
+          delete publicKey.allowCredentials;
+        }
+        const cred = await navigator.credentials.get({
+          publicKey,
+          signal: abort.signal,
+          ...(conditional ? { mediation: 'conditional' } : {})
+        });
+        if (!cred) return;
+
+        const r = cred.response;
+        const res = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({
+            id: cred.id,
+            rawId: bufToB64url(cred.rawId),
+            type: cred.type,
+            authenticatorAttachment: cred.authenticatorAttachment,
+            clientExtensionResults: cred.getClientExtensionResults(),
+            response: {
+              clientDataJSON: bufToB64url(r.clientDataJSON),
+              authenticatorData: bufToB64url(r.authenticatorData),
+              signature: bufToB64url(r.signature),
+              userHandle: r.userHandle ? bufToB64url(r.userHandle) : null
+            }
+          })
+        });
+        if (!res.ok) throw new Error('Passkey verification failed');
+        setStatus('Signed in successfully with passkey.');
+      }
+
+      async function run(opts) {
+        try {
+          await authenticate(opts);
+        } catch (err) {
+          if (err.name === 'AbortError') return;
+          setStatus(err.name === 'NotAllowedError' ? 'Passkey sign-in was cancelled.' : err.message, true);
+          if (!opts.conditional) startConditional();
+        }
+      }
+
+      async function startConditional() {
+        if (!window.PublicKeyCredential || !PublicKeyCredential.isConditionalMediationAvailable) return;
+        if (!(await PublicKeyCredential.isConditionalMediationAvailable())) return;
+        run({ conditional: true });
+      }
+
+      if (!window.PublicKeyCredential) {
+        setStatus('Passkeys are not supported in this browser.', true);
+        button.disabled = true;
+      } else {
+        button.addEventListener('click', async () => {
+          setStatus('');
+          await run({ conditional: false });
+        });
+        startConditional();
+      }
+    })();
+  </script>
+
 </body>
 
