+  <script>
+    (() => {
+      const canvas = document.getElementById('card_canvas');
+      const card = document.getElementById('export_element');
+      const messageInput = document.getElementById('card_message');
+      const colorInput = document.getElementById('card_color');
+      const messageText = document.getElementById('card_message_text');
+      const exportButton = document.getElementById('export_button');
+      const status = document.getElementById('designer_status');
+
+      // Pick white or dark text depending on background luminance.
+      function applyDesign() {
+        const hex = colorInput.value;
+        const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
+        const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
+        card.style.background = hex;
+        card.style.color = luminance > 0.6 ? '#3e2723' : '#ffffff';
+        messageText.textContent = messageInput.value.trim() || 'Enjoy a coffee on us';
+      }
+      messageInput.addEventListener('input', applyDesign);
+      colorInput.addEventListener('input', applyDesign);
+      applyDesign();
+
+      // HTML-in-Canvas is not available everywhere; the card stays visible as
+      // plain HTML (canvas fallback content), but export is disabled.
+      const supported = 'content' in HTMLCanvasElement.prototype &&
+        typeof CanvasRenderingContext2D !== 'undefined' &&
+        'drawElementImage' in CanvasRenderingContext2D.prototype;
+      if (!supported) {
+        exportButton.disabled = true;
+        status.textContent = 'Image export needs a browser that supports HTML in Canvas (e.g. Chrome 157+).';
+        return;
+      }
+
+      const ctx = canvas.getContext('2d');
+
+      // Keep the canvas grid in device pixels so the export is crisp.
+      const resizeObserver = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        canvas.requestPaint();
+      });
+      const supportsDevicePixelBox = typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      resizeObserver.observe(canvas, supportsDevicePixelBox ? { box: 'device-pixel-content-box' } : {});
+
+      canvas.onpaint = () => {
+        ctx.reset();
+        // Scale the card's border box to fill the whole canvas grid.
+        ctx.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+      };
+
+      // Resolves after the next paint event, so the export reflects the latest edits.
+      const nextPaint = () => new Promise((resolve) => {
+        canvas.addEventListener('paint', resolve, { once: true });
+        canvas.requestPaint();
+      });
+
+      exportButton.addEventListener('click', async () => {
+        exportButton.disabled = true;
+        try {
+          await nextPaint();
+          const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
+          if (!blob) throw new Error('Canvas export returned no data');
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.href = url;
+          link.download = 'daily-grind-gift-card.png';
+          link.click();
+          URL.revokeObjectURL(url);
+          status.textContent = 'Your gift card image has been downloaded.';
+        } catch (err) {
+          console.error(err);
+          status.textContent = 'Sorry, the card could not be exported.';
+        } finally {
+          exportButton.disabled = false;
+        }
+      });
+    })();
+  </script>
+
