+    /* Roast picker */
+    .roast-picker {
+      position: relative;
+      width: min(340px, 100%);
+      margin-top: 1.5rem;
+      text-align: left;
+    }
+
+    .roast-label {
+      display: block;
+      font-size: 0.8rem;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+      margin-bottom: 6px;
+      color: var(--secondary);
+    }
+
+    .roast-toggle {
+      width: 100%;
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px 14px;
+      background: white;
+      color: var(--text);
+      border: 2px solid transparent;
+      border-radius: 8px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .roast-toggle:focus-visible,
+    .roast-option:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .roast-toggle .chevron {
+      margin-left: auto;
+      width: 16px;
+      height: 16px;
+      transition: transform 0.2s;
+    }
+
+    .roast-toggle[aria-expanded="true"] .chevron {
+      transform: rotate(180deg);
+    }
+
+    .roast-menu {
+      position: absolute;
+      top: calc(100% + 6px);
+      left: 0;
+      right: 0;
+      z-index: 10;
+      list-style: none;
+      background: white;
+      color: var(--text);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
+      overflow: hidden;
+    }
+
+    .roast-menu[hidden] {
+      display: none;
+    }
+
+    .roast-option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px 14px;
+      cursor: pointer;
+    }
+
+    .roast-option:hover,
+    .roast-option.active {
+      background: var(--secondary);
+    }
+
+    .roast-option[aria-selected="true"] .roast-title::after {
