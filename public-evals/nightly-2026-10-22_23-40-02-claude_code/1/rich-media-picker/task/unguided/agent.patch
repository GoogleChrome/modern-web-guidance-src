+  <script>
+    (function () {
+      var toggle = document.getElementById('roast-toggle');
+      var menu = document.getElementById('roast-menu');
+      var current = toggle.querySelector('.roast-current');
+      var options = Array.prototype.slice.call(menu.querySelectorAll('.roast-option'));
+      var activeIndex = 0;
+
+      function setActive(i) {
+        activeIndex = (i + options.length) % options.length;
+        options.forEach(function (o, n) { o.classList.toggle('active', n === activeIndex); });
+        options[activeIndex].scrollIntoView({ block: 'nearest' });
+      }
+
+      function select(i) {
+        options.forEach(function (o, n) { o.setAttribute('aria-selected', n === i); });
+        current.innerHTML = options[i].innerHTML;
+        toggle.dataset.value = options[i].dataset.value;
+      }
+
+      function open() {
+        menu.hidden = false;
+        toggle.setAttribute('aria-expanded', 'true');
+        var sel = options.findIndex(function (o) { return o.getAttribute('aria-selected') === 'true'; });
+        setActive(sel < 0 ? 0 : sel);
+        menu.focus();
+      }
+
+      function close(refocus) {
+        menu.hidden = true;
+        toggle.setAttribute('aria-expanded', 'false');
+        if (refocus) toggle.focus();
+      }
+
+      options.forEach(function (o, i) {
+        o.addEventListener('click', function () { select(i); close(true); });
+        o.addEventListener('mousemove', function () { setActive(i); });
+      });
+
+      toggle.addEventListener('click', function () { menu.hidden ? open() : close(); });
+      toggle.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); open(); }
+      });
+
+      menu.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIndex + 1); }
+        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(activeIndex - 1); }
+        else if (e.key === 'Home') { e.preventDefault(); setActive(0); }
+        else if (e.key === 'End') { e.preventDefault(); setActive(options.length - 1); }
+        else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(activeIndex); close(true); }
+        else if (e.key === 'Escape') { close(true); }
+        else if (e.key === 'Tab') { close(); }
+      });
+
+      document.addEventListener('click', function (e) {
+        if (!menu.hidden && !e.target.closest('.roast-picker')) close();
+      });
+
+      select(0);
+    })();
+  </script>
