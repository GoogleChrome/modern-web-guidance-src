+    /* Roast picker */
+    .roast-picker {
+      display: flex;
+      flex-direction: column;
+      gap: 6px;
+      width: min(100%, 340px);
+      margin-top: 1.5rem;
+      text-align: left;
+    }
+
+    .roast-picker label {
+      font-size: 0.85rem;
+      font-weight: 600;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+    }
+
+    .roast-select,
+    .roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .roast-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      padding: 10px 12px;
+      background: white;
+      color: var(--text);
+      border: 2px solid var(--accent);
+      border-radius: 8px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .roast-select::picker(select) {
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 6px;
+      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
+      width: anchor-size(width);
+    }
+
+    .roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px;
+      border-radius: 6px;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    .roast-select option::checkmark {
+      display: none;
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus-visible {
+      background: var(--secondary);
+    }
+
+    .roast-select option:checked {
+      background: var(--primary);
+      color: white;
+    }
+
+    .roast-select option:checked .option-title {
+      font-weight: 700;
+    }
+
+    .roast-select option svg,
+    .roast-select selectedcontent svg {
+      flex: none;
+      width: 28px;
+      height: 28px;
+      color: var(--accent);
+    }
+
+    .roast-select option:not(:checked) svg {
+      color: var(--primary);
+    }
+
+    .option-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .option-title {
+      font-weight: 600;
+    }
+
+    .option-desc {
+      font-size: 0.8rem;
+      opacity: 0.75;
+    }
+
+    .roast-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+    }
+
+    .roast-select selectedcontent svg {
+      color: var(--primary);
+    }
+
+    .roast-select selectedcontent .option-desc {
+      display: none;
+    }
+
