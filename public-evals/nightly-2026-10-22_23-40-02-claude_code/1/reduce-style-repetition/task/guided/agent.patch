diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13,8 +13,21 @@
       --text: #3e2723;
       --light: #fafafa;
     }
 
+    /* Reusable gradient: any two colors, optional angle */
+    @function --gradient(--from <color>, --to <color>, --angle: 135deg) returns <image> {
+      result: linear-gradient(in oklab var(--angle), var(--from), var(--to));
+    }
+
+    /* Reusable columns: one column by default, --count equal columns on wider screens */
+    @function --columns(--count <number>: 2) returns <track-list> {
+      result: 1fr;
+      @media (min-width: 700px) {
+        result: repeat(var(--count), 1fr);
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
@@ -23,11 +36,23 @@
