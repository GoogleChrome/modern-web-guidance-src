+  <script>
+    // All "View Details" links share this one interest target (declared via interestfor),
+    // so a single pair of listeners here replaces per-button hover/focus handlers.
+    const preview = document.getElementById('seasonal-preview');
+    const defaultText = preview.textContent;
+
+    preview.addEventListener('interest', (event) => {
+      const name = event.source.closest('.card').querySelector('h3').textContent;
+      preview.textContent = name;
+      preview.classList.add('is-previewing');
+    });
+
+    preview.addEventListener('loseinterest', () => {
+      preview.textContent = defaultText;
+      preview.classList.remove('is-previewing');
+    });
+  </script>
