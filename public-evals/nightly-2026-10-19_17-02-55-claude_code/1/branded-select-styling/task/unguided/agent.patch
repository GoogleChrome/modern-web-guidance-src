+    /* Roast Selector */
+    .roast-selector {
+      position: relative;
+      margin-top: 1.5rem;
+      width: 220px;
+      text-align: left;
+    }
+
+    .roast-label {
+      display: block;
+      font-size: 0.8rem;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      margin-bottom: 6px;
+      color: var(--accent);
+    }
+
+    .roast-toggle {
+      width: 100%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      background: var(--primary);
+      color: white;
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      padding: 10px 14px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .roast-toggle:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .roast-arrow {
+      width: 14px;
+      height: 14px;
+      fill: none;
+      stroke: var(--accent);
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      transition: transform 0.2s;
+    }
+
+    .roast-toggle[aria-expanded="true"] .roast-arrow {
+      transform: rotate(180deg);
+    }
+
+    .roast-list {
+      position: absolute;
+      top: calc(100% + 4px);
+      left: 0;
+      right: 0;
+      list-style: none;
+      background: var(--primary);
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      overflow: hidden;
+      z-index: 10;
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
+    }
+
+    .roast-list[hidden] {
+      display: none;
+    }
+
+    .roast-list li {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding: 10px 14px;
+      color: white;
+      cursor: pointer;
+    }
+
+    .roast-list li.active,
+    .roast-list li:hover {
+      background: var(--accent);
+      color: var(--primary);
+    }
+
+    .roast-check {
+      width: 14px;
+      height: 14px;
+      fill: none;
+      stroke: var(--accent);
+      stroke-width: 3;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      visibility: hidden;
+    }
+
+    .roast-list li.active .roast-check,
+    .roast-list li:hover .roast-check {
+      stroke: var(--primary);
+    }
+
+    .roast-list li[aria-selected="true"] .roast-check {
+      visibility: visible;
+    }
+
