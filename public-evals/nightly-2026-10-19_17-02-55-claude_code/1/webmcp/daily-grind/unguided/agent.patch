diff --git a/index.html b/index.html
index 66c9173..7917285 100644
--- a/index.html
+++ b/index.html
@@ -207,6 +207,99 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // WebMCP: expose client-side functionality as tools to in-browser AI agents.
+    (function () {
+      if (!('modelContext' in navigator)) return;
+
+      const result = (data) => ({
+        content: [{ type: 'text', text: typeof data === 'string' ? data : JSON.stringify(data) }]
+      });
+
+      const PAGES = {
+        menu: '/menu',
+        locations: '/locations',
+        rewards: '/rewards',
+        account: '/account',
+        'order-online': '/order-online',
+        about: '/about',
+        careers: '/careers',
+        contact: '/contact',
+        'privacy-policy': '/privacy-policy'
+      };
+
+      const drinks = () => Array.from(document.querySelectorAll('.card')).map((card) => ({
+        name: card.querySelector('h3').textContent.trim(),
+        description: card.querySelector('p').textContent.trim(),
+        url: card.querySelector('a').getAttribute('href')
+      }));
+
+      const tools = [
+        {
+          name: 'list_seasonal_favorites',
+          description: 'List the seasonal favorite drinks featured on the home page, with descriptions and detail page URLs.',
+          inputSchema: { type: 'object', properties: {} },
+          annotations: { readOnlyHint: true },
+          execute: async () => result(drinks())
+        },
+        {
+          name: 'view_drink_details',
+          description: 'Navigate the browser to the detail page of a seasonal favorite drink.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              name: { type: 'string', description: 'Drink name, e.g. "Cold Brew". Case-insensitive.' }
+            },
+            required: ['name']
+          },
+          execute: async ({ name }) => {
+            const drink = drinks().find((d) => d.name.toLowerCase() === String(name).trim().toLowerCase());
+            if (!drink) {
+              return { isError: true, ...result(`Unknown drink "${name}". Available: ${drinks().map((d) => d.name).join(', ')}`) };
+            }
+            window.location.href = drink.url;
+            return result(`Navigating to ${drink.name} details (${drink.url}).`);
+          }
+        },
+        {
+          name: 'navigate_to_page',
+          description: 'Navigate to a page of The Daily Grind site.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              page: { type: 'string', enum: Object.keys(PAGES), description: 'The page to open.' }
+            },
+            required: ['page']
+          },
+          execute: async ({ page }) => {
+            if (!Object.hasOwn(PAGES, page)) {
+              return { isError: true, ...result(`Unknown page "${page}". Available: ${Object.keys(PAGES).join(', ')}`) };
+            }
+            window.location.href = PAGES[page];
+            return result(`Navigating to ${PAGES[page]}.`);
+          }
+        },
+        {
+          name: 'start_order',
+          description: 'Start an online order by navigating to the order page (the "Order Now" button).',
+          inputSchema: { type: 'object', properties: {} },
+          execute: async () => {
+            window.location.href = document.querySelector('.hero .btn').getAttribute('href');
+            return result('Navigating to the online ordering page.');
+          }
+        }
+      ];
+
+      for (const tool of tools) {
+        try {
+          navigator.modelContext.registerTool(tool);
+        } catch (e) {
+          console.warn('WebMCP: failed to register tool', tool.name, e);
+        }
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
