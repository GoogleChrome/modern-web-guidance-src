diff --git a/index.html b/index.html
index 66c9173..9688ae4 100644
--- a/index.html
+++ b/index.html
@@ -207,6 +207,90 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // WebMCP: expose site functionality as tools for AI agents (no-op where unsupported).
+    if ('modelContext' in document) {
+      const controller = new AbortController();
+      const { signal } = controller;
+      addEventListener('pagehide', () => controller.abort(), { once: true });
+
+      // Navigate after the tool result has been returned to the agent.
+      const goTo = (href) => setTimeout(() => location.assign(href), 0);
+
+      const pages = Object.fromEntries(
+        [...document.querySelectorAll('nav ul a, .hero .btn, .footer-links a')]
+          .filter((a) => !a.classList.contains('logout-link'))
+          .map((a) => [a.textContent.trim().toLowerCase(), a.getAttribute('href')])
+      );
+
+      const drinks = () =>
+        [...document.querySelectorAll('.card')].map((card) => ({
+          name: card.querySelector('h3').textContent.trim(),
+          description: card.querySelector('p').textContent.trim(),
+          detailsUrl: card.querySelector('a').getAttribute('href'),
+        }));
+
+      document.modelContext.registerTool({
+        name: 'list-seasonal-favorites',
+        description: 'Lists the coffee drinks featured on the home page. Use when the user asks what is on offer or wants recommendations.',
+        inputSchema: { type: 'object', properties: {} },
+        execute: () => drinks(),
+        annotations: { readOnlyHint: true },
+      }, { signal });
+
+      document.modelContext.registerTool({
+        name: 'view-drink-details',
+        description: 'Opens the details page of a seasonal favorite drink.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: { type: 'string', description: 'Drink name, e.g. "Cold Brew". Matching is case-insensitive.' },
+          },
+          required: ['name'],
+        },
+        execute({ name } = {}) {
+          const drink = typeof name === 'string' &&
+            drinks().find((d) => d.name.toLowerCase() === name.trim().toLowerCase());
+          if (!drink) {
+            return { error: `Drink "${name}" not found.`, availableDrinks: drinks().map((d) => d.name) };
+          }
+          goTo(drink.detailsUrl);
+          return { opened: drink.name, url: drink.detailsUrl };
+        },
+      }, { signal });
+
+      document.modelContext.registerTool({
+        name: 'navigate-to-page',
+        description: 'Navigates to a section of the Daily Grind site. Use when the user wants to order, browse the menu, find a store, check rewards, or read company information.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            page: { type: 'string', enum: Object.keys(pages), description: 'Link label of the destination page.' },
+          },
+          required: ['page'],
+        },
+        execute({ page } = {}) {
+          const key = typeof page === 'string' ? page.trim().toLowerCase() : '';
+          if (!(key in pages)) {
+            return { error: `Unknown page "${page}".`, availablePages: Object.keys(pages) };
+          }
+          goTo(pages[key]);
+          return { navigatingTo: pages[key] };
+        },
+      }, { signal });
+
+      document.modelContext.registerTool({
+        name: 'log-out',
+        description: 'Logs the current user out of their Daily Grind account.',
+        inputSchema: { type: 'object', properties: {} },
+        execute() {
+          goTo(document.querySelector('.logout-link').getAttribute('href'));
+          return { loggingOut: true };
+        },
+        annotations: { readOnlyHint: false, consequentialHint: true },
+      }, { signal });
+    }
+  </script>
 </body>
 
 </html>
