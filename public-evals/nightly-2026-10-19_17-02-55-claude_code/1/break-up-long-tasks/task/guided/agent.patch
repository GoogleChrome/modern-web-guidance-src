+  <script>
+    const TOTAL_BLENDS = 1000;
+    const BLEND_COST_MS = 2;
+    const SLICE_MS = 50;
+
+    const startBtn = document.getElementById('start-btn');
+    const output = document.getElementById('output');
+
+    function yieldToMain() {
+      if ('scheduler' in window && 'yield' in scheduler) {
+        return scheduler.yield();
+      }
+      return new Promise(resolve => setTimeout(resolve, 0));
+    }
+
+    // Stand-in for scoring one recipe blend; busy-waits to model ~2ms of work.
+    function processBlend() {
+      const end = performance.now() + BLEND_COST_MS;
+      while (performance.now() < end) { /* simulate work */ }
+    }
+
+    async function runSimulation() {
+      startBtn.disabled = true;
+      output.textContent = 'Processing...';
+
+      let sliceStart = performance.now();
+      for (let i = 1; i <= TOTAL_BLENDS; i++) {
+        processBlend();
+
+        if (performance.now() - sliceStart >= SLICE_MS) {
+          output.textContent = `Processed ${i} of ${TOTAL_BLENDS}...`;
+          await yieldToMain();
+          sliceStart = performance.now();
+        }
+      }
+
+      output.textContent = 'Done! All items processed.';
+      startBtn.disabled = false;
+    }
+
+    startBtn.addEventListener('click', runSimulation);
+  </script>
