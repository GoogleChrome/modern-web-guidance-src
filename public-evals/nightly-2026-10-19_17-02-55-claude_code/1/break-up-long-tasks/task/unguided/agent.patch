+  <script>
+    (function () {
+      const TOTAL_BLENDS = 1000;
+      const BLEND_COST_MS = 2;   // approximate cost of processing one blend
+      const SLICE_MS = 50;       // max time to hold the main thread before yielding
+
+      const startBtn = document.getElementById('start-btn');
+      const output = document.getElementById('output');
+
+      // Yield to the browser so pending input/paint work can run.
+      function yieldToBrowser() {
+        if (window.scheduler && typeof scheduler.yield === 'function') {
+          return scheduler.yield();
+        }
+        return new Promise(resolve => setTimeout(resolve, 0));
+      }
+
+      // Score one random recipe blend; padded to take roughly BLEND_COST_MS.
+      function processBlend() {
+        const start = performance.now();
+        const profile = { acidity: 0, body: 0, sweetness: 0, bitterness: 0 };
+        const keys = Object.keys(profile);
+        while (performance.now() - start < BLEND_COST_MS) {
+          for (const key of keys) {
+            profile[key] += Math.random();
+          }
+        }
+        return profile;
+      }
+
+      async function runSimulation() {
+        startBtn.disabled = true;
+        output.textContent = 'Processing...';
+
+        const results = [];
+        let sliceStart = performance.now();
+
+        for (let i = 0; i < TOTAL_BLENDS; i++) {
+          results.push(processBlend());
+
+          if (performance.now() - sliceStart >= SLICE_MS && i < TOTAL_BLENDS - 1) {
+            output.textContent = `Processed ${i + 1} of ${TOTAL_BLENDS}...`;
+            await yieldToBrowser();
+            sliceStart = performance.now();
+          }
+        }
+
+        output.textContent = 'Done! All items processed.';
+        startBtn.disabled = false;
+      }
+
+      startBtn.addEventListener('click', runSimulation);
+    })();
+  </script>
