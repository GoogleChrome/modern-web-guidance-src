+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <style>
+    :root { --primary: #4e342e; --secondary: #d7ccc8; --accent: #ffab40; --text: #3e2723; --light: #fafafa; }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: var(--text); background: var(--light); }
+    nav { background: var(--primary); color: white; padding: 1rem 5%; display: flex; justify-content: space-between; align-items: center; }
+    nav a { color: white; text-decoration: none; }
+    nav .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+    .logout-link { border: 1px solid var(--accent); padding: 5px 12px; border-radius: 4px; font-size: .9rem; }
+    main { max-width: 520px; margin: 48px auto; padding: 0 20px; }
+    .panel { background: white; padding: 28px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,.1); }
+    h1 { color: var(--primary); margin-bottom: 12px; }
+    .ok { background: #e8f5e9; color: #1b5e20; padding: 10px 12px; border-radius: 5px; margin-bottom: 16px; }
+    dt { font-size: .85rem; color: #6d4c41; }
+    dd { margin-bottom: 12px; }
+  </style>
+</head>
+<body>
+  <nav><a class="logo" href="/">THE DAILY GRIND</a><a class="logout-link" href="/logout">Logout</a></nav>
+  <main>
+    <div class="panel">
+      <h1>My Account</h1>
+      <div class="ok" id="recovered" hidden>Access recovered. All other sessions were signed out.</div>
+      <dl>
+        <dt>Name</dt><dd id="name"></dd>
+        <dt>Verified email</dt><dd id="email"></dd>
+        <dt>Member since</dt><dd id="since"></dd>
+      </dl>
+    </div>
+  </main>
+  <script>
+    if (new URLSearchParams(location.search).has('recovered')) document.getElementById('recovered').hidden = false;
+    fetch('/api/me').then((r) => { if (!r.ok) throw 0; return r.json(); }).then((u) => {
+      document.getElementById('name').textContent = u.name;
+      document.getElementById('email').textContent = u.email;
+      document.getElementById('since').textContent = new Date(u.createdAt).toLocaleDateString();
+    }).catch(() => { location.href = '/login'; });
+  </script>
+</body>
+</html>
