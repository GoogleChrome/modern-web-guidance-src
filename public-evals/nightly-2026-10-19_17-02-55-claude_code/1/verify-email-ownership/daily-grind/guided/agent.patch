+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Sign in | The Daily Grind</title>
+  <style>
+    :root { --primary: #4e342e; --secondary: #d7ccc8; --accent: #ffab40; --text: #3e2723; --light: #fafafa; }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: var(--text); background: var(--light); }
+    nav { background: var(--primary); color: white; padding: 1rem 5%; }
+    nav a { color: white; text-decoration: none; font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+    main { max-width: 440px; margin: 48px auto; padding: 0 20px; }
+    .panel { background: white; padding: 28px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,.1); }
+    h1 { color: var(--primary); margin-bottom: 4px; }
+    .lede { margin-bottom: 20px; }
+    [role=tablist] { display: flex; gap: 4px; margin-bottom: 20px; border-bottom: 2px solid var(--secondary); }
+    [role=tab] { flex: 1; background: none; border: 0; padding: 10px 4px; font: inherit; cursor: pointer; color: var(--text); border-bottom: 3px solid transparent; margin-bottom: -2px; }
+    [role=tab][aria-selected=true] { border-color: var(--accent); font-weight: 600; }
+    label { display: block; font-size: .9rem; margin-bottom: 4px; }
+    input[type=email] { width: 100%; padding: 10px; border: 1px solid #bcaaa4; border-radius: 5px; font: inherit; margin-bottom: 16px; }
+    button.go { width: 100%; background: var(--primary); color: white; border: 0; padding: 12px; border-radius: 5px; font: inherit; cursor: pointer; }
+    button.go:hover { background: #3e2723; }
+    button.go:disabled { opacity: .5; cursor: not-allowed; }
+    .note { font-size: .85rem; margin-top: 14px; color: #6d4c41; }
+    .error { background: #ffebee; color: #b71c1c; padding: 10px 12px; border-radius: 5px; margin-bottom: 16px; }
+  </style>
+</head>
+<body>
+  <nav><a href="/">THE DAILY GRIND</a></nav>
+  <main>
+    <div class="panel">
+      <h1>Welcome</h1>
+      <p class="lede" id="lede"></p>
+      <div id="error" class="error" role="alert" hidden></div>
+      <div role="tablist" aria-label="Account action">
+        <button role="tab" id="tab-signin" aria-selected="true" data-intent="signin">Sign in</button>
+        <button role="tab" id="tab-signup" aria-selected="false" data-intent="signup">Create account</button>
+        <button role="tab" id="tab-recover" aria-selected="false" data-intent="recover">Recover</button>
+      </div>
+      <form id="form" action="/auth/start" method="get" role="tabpanel">
+        <input type="hidden" name="intent" id="intent" value="signin">
+        <label for="email">Email address (optional)</label>
+        <input type="email" id="email" name="email" autocomplete="email" placeholder="you@gmail.com">
+        <button class="go" id="go" type="submit">Continue with Google</button>
+      </form>
+      <p class="note" id="note"></p>
+    </div>
+  </main>
+  <script>
+    const COPY = {
+      signin: ['Sign in by confirming your email with Google. No code or link to wait for.', 'Continue with Google'],
+      signup: ['Create your account. We confirm you own the address through Google, with nothing to type or click in an inbox.', 'Sign up with Google'],
+      recover: ['Lost access? Prove you own your email with Google and we will sign you back in and sign out all other devices.', 'Recover my account'],
+    };
+    const ERRORS = {
+      not_configured: 'Sign-in is not configured on this server yet.',
+      bad_request: 'That request was not valid. Please try again.',
+      cancelled: 'Sign-in was cancelled.',
+      bad_state: 'Your sign-in session expired. Please try again.',
+      exchange_failed: 'Google could not complete the sign-in. Please try again.',
+      email_unverified: 'We could not verify ownership of that email. Use a Gmail or Google Workspace address.',
+      no_account: 'No account exists for that email. Create one first.',
+      server_error: 'Something went wrong. Please try again.',
+    };
+    const $ = (id) => document.getElementById(id);
+    function select(intent) {
+      for (const t of document.querySelectorAll('[role=tab]')) t.setAttribute('aria-selected', String(t.dataset.intent === intent));
+      $('intent').value = intent;
+      $('lede').textContent = COPY[intent][0];
+      $('go').textContent = COPY[intent][1];
+      $('note').textContent = 'The email you choose must be verified by Google. We never send you an email.';
+    }
+    for (const t of document.querySelectorAll('[role=tab]')) t.addEventListener('click', () => select(t.dataset.intent));
+    const err = new URLSearchParams(location.search).get('error');
+    if (err) { $('error').textContent = ERRORS[err] || ERRORS.server_error; $('error').hidden = false; }
+    fetch('/api/config').then((r) => r.json()).then((c) => { if (!c.configured) { $('go').disabled = true; $('note').textContent = ERRORS.not_configured; } });
+    select(err === 'no_account' ? 'signup' : 'signin');
+  </script>
+</body>
+</html>
