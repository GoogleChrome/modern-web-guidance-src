+import type { APIRoute } from 'astro';
+import { getCredentials, json } from '../../utils/passkeys';
+
+export const GET: APIRoute = async ({ session, url }) => {
+  const credentials = await getCredentials(session);
+  const userId = (await session?.get('passkeyUserId')) ?? null;
+  return json({ rpId: url.hostname, userId, credentials });
+};
