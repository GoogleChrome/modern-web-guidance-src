+import type { AstroSession } from 'astro';
+
+// Credential IDs and the user ID are Base64URL-encoded strings.
+export interface StoredPasskeyCredential {
+  id: string;
+  name: string;
+  aaguid?: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export async function getCredentials(session: AstroSession | undefined) {
+  return ((await session?.get('passkeys')) as StoredPasskeyCredential[] | undefined) ?? [];
+}
+
+export async function saveCredentials(session: AstroSession | undefined, list: StoredPasskeyCredential[]) {
+  await session?.set('passkeys', list);
+}
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
