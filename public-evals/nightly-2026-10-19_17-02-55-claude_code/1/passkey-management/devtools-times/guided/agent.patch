@@ -0,0 +1,23 @@
+import type { APIRoute } from 'astro';
+import { getCredentials, saveCredentials, json } from '../../../utils/passkeys';
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const { name } = await request.json().catch(() => ({}));
+  const trimmed = typeof name === 'string' ? name.trim() : '';
+  if (!trimmed || trimmed.length > 100) {
+    return json({ error: 'A name of 1–100 characters is required.' }, 400);
+  }
+  const list = await getCredentials(session);
+  const cred = list.find((c) => c.id === params.id);
+  if (!cred) return json({ error: 'Credential not found.' }, 404);
+  cred.name = trimmed;
+  await saveCredentials(session, list);
+  return json(cred);
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const list = await getCredentials(session);
+  if (!list.some((c) => c.id === params.id)) return json({ error: 'Credential not found.' }, 404);
+  await saveCredentials(session, list.filter((c) => c.id !== params.id));
+  return json({ success: true });
+};
