+import React, { useEffect, useState } from 'react';
+import type { StoredPasskeyCredential } from '../utils/passkeys';
+
+const API = `${import.meta.env.BASE_URL}api`;
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+// Keeps the user's password manager in sync with what the server accepts.
+async function signalAccepted(rpId: string, userId: string | null, list: StoredPasskeyCredential[]) {
+  if (!userId || !window.PublicKeyCredential || !(PublicKeyCredential as any).signalAllAcceptedCredentials) return;
+  try {
+    await (PublicKeyCredential as any).signalAllAcceptedCredentials({
+      rpId,
+      userId,
+      allAcceptedCredentialIds: list.map((c) => c.id),
+    });
+  } catch (e) {
+    console.error('signalAllAcceptedCredentials failed:', e);
+  }
+}
+
+export default function PasskeyManager() {
+  const [credentials, setCredentials] = useState<StoredPasskeyCredential[] | null>(null);
+  const [meta, setMeta] = useState<{ rpId: string; userId: string | null }>({ rpId: '', userId: null });
+  const [error, setError] = useState<string | null>(null);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [draftName, setDraftName] = useState('');
+
+  const load = async () => {
+    const res = await fetch(`${API}/credentials`);
+    if (!res.ok) throw new Error();
+    const data = await res.json();
+    setCredentials(data.credentials);
+    setMeta({ rpId: data.rpId, userId: data.userId });
+    return data;
+  };
+
+  useEffect(() => {
+    load()
+      .then((d) => signalAccepted(d.rpId, d.userId, d.credentials))
+      .catch(() => setError('Could not load your passkeys. Please try again later.'));
+  }, []);
+
+  const rename = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!editingId) return;
+    setError(null);
+    const res = await fetch(`${API}/credential/${encodeURIComponent(editingId)}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ name: draftName }),
+    });
+    if (!res.ok) {
+      setError((await res.json().catch(() => ({}))).error || 'Could not rename the passkey.');
+      return;
+    }
+    setEditingId(null);
+    await load();
+  };
+
+  const remove = async (cred: StoredPasskeyCredential) => {
+    if (!window.confirm(`Delete "${cred.name}"? You won't be able to sign in with it anymore.`)) return;
+    setError(null);
+    const res = await fetch(`${API}/credential/${encodeURIComponent(cred.id)}`, { method: 'DELETE' });
+    if (!res.ok) {
+      setError('Could not delete the passkey.');
+      return;
+    }
+    const data = await load();
+    await signalAccepted(data.rpId, data.userId, data.credentials);
+  };
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <h2 className="text-2xl font-bold mb-2 text-gray-800">Passkeys</h2>
+      <p className="mb-6 text-sm text-gray-600">
+        Passkeys let you sign in with your fingerprint, face, or screen lock instead of a password.
+      </p>
+
+      {error && (
+        <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+
+      {credentials === null ? (
+        !error && <p className="text-sm text-gray-500">Loading…</p>
+      ) : credentials.length === 0 ? (
+        <p className="text-sm text-gray-500">No passkeys found.</p>
+      ) : (
+        <ul className="divide-y divide-gray-200">
+          {credentials.map((cred) => (
+            <li key={cred.id} className="py-4 flex items-center gap-4">
+              {cred.providerIcon ? (
+                <img src={cred.providerIcon} alt="" width={32} height={32} className="shrink-0" />
+              ) : (
+                <div className="w-8 h-8 shrink-0 rounded bg-gray-200" aria-hidden="true" />
+              )}
+              <div className="min-w-0 flex-1">
+                {editingId === cred.id ? (
+                  <form onSubmit={rename} className="flex gap-2">
+                    <label htmlFor="passkey-name" className="sr-only">Passkey name</label>
+                    <input
+                      id="passkey-name"
+                      value={draftName}
+                      onChange={(e) => setDraftName(e.target.value)}
+                      maxLength={100}
+                      required
+                      autoFocus
+                      className="flex-1 min-w-0 px-2 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                    />
+                    <button type="submit" className="px-3 py-1 text-sm text-white bg-gray-900 rounded-md hover:bg-gray-800">Save</button>
+                    <button type="button" onClick={() => setEditingId(null)} className="px-3 py-1 text-sm text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50">Cancel</button>
+                  </form>
+                ) : (
+                  <>
+                    <p className="font-medium text-gray-900 truncate">{cred.name}</p>
+                    <p className="text-xs text-gray-500">
+                      Created {dateFormat.format(cred.registeredAt)}
+                      {cred.lastUsedAt ? ` · Last used ${dateFormat.format(cred.lastUsedAt)}` : ' · Never used'}
+                    </p>
+                  </>
+                )}
+              </div>
+              {editingId !== cred.id && (
+                <div className="flex gap-2 shrink-0">
+                  <button
+                    type="button"
+                    onClick={() => { setEditingId(cred.id); setDraftName(cred.name); }}
+                    aria-label={`Rename ${cred.name}`}
+                    className="px-3 py-1 text-sm text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50"
+                  >
+                    Rename
+                  </button>
+                  <button
+                    type="button"
+                    onClick={() => remove(cred)}
+                    aria-label={`Delete ${cred.name}`}
+                    className="px-3 py-1 text-sm text-red-700 border border-red-300 rounded-md hover:bg-red-50"
+                  >
+                    Delete
+                  </button>
+                </div>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
