@@ -0,0 +1,29 @@
+import type { APIRoute } from 'astro';
+import { json, MAX_NAME_LENGTH, type Passkey } from '../../../utils/passkeys';
+
+export const GET: APIRoute = async ({ session }) => {
+  const passkeys: Passkey[] = (await session?.get('passkeys')) || [];
+  return json({ passkeys });
+};
+
+// Registers a passkey the browser has just created (see PasskeyManager).
+export const POST: APIRoute = async ({ request, session }) => {
+  const { id, name, transports } = await request.json();
+  if (typeof id !== 'string' || !id) {
+    return json({ error: 'Credential ID is required' }, 400);
+  }
+  const passkeys: Passkey[] = (await session?.get('passkeys')) || [];
+  if (passkeys.some((p) => p.id === id)) {
+    return json({ error: 'This passkey is already registered' }, 409);
+  }
+  const passkey: Passkey = {
+    id,
+    name: (typeof name === 'string' && name.trim().slice(0, MAX_NAME_LENGTH)) || 'Passkey',
+    createdAt: new Date().toISOString(),
+    lastUsedAt: null,
+    transports: Array.isArray(transports) ? transports.filter((t) => typeof t === 'string') : [],
+  };
+  passkeys.push(passkey);
+  await session?.set('passkeys', passkeys);
+  return json({ passkey }, 201);
+};
diff --git a/src/utils/passkeys.ts b/src/utils/passkeys.ts
new file mode 100644
