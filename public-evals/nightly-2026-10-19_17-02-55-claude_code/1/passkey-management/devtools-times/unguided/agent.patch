--- /dev/null
+++ b/src/pages/api/passkeys/[id].ts
@@ -0,0 +1,25 @@
+import type { APIRoute } from 'astro';
+import { json, MAX_NAME_LENGTH, type Passkey } from '../../../utils/passkeys';
+
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const { name } = await request.json();
+  const trimmed = typeof name === 'string' ? name.trim() : '';
+  if (!trimmed || trimmed.length > MAX_NAME_LENGTH) {
+    return json({ error: `Name must be 1-${MAX_NAME_LENGTH} characters` }, 400);
+  }
+  const passkeys: Passkey[] = (await session?.get('passkeys')) || [];
+  const passkey = passkeys.find((p) => p.id === params.id);
+  if (!passkey) return json({ error: 'Passkey not found' }, 404);
+  passkey.name = trimmed;
+  await session?.set('passkeys', passkeys);
+  return json({ passkey });
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const passkeys: Passkey[] = (await session?.get('passkeys')) || [];
+  if (!passkeys.some((p) => p.id === params.id)) {
+    return json({ error: 'Passkey not found' }, 404);
+  }
+  await session?.set('passkeys', passkeys.filter((p) => p.id !== params.id));
+  return json({ ok: true });
+};
