+  <div id="tour-step" role="dialog" aria-label="Rewards tour">
+    <p>Earn points with every purchase and redeem them for free drinks!</p>
+    <button type="button" id="tour-close">Got it</button>
+  </div>
+
+  <script>
+    const tourStep = document.getElementById('tour-step');
+    const feature = document.getElementById('feature');
+
+    document.getElementById('tour-close').addEventListener('click', () => {
+      tourStep.hidden = true;
+    });
+
+    // Don't navigate away while the tour is showing
+    feature.addEventListener('click', (e) => {
+      if (!tourStep.hidden) e.preventDefault();
+    });
+
+    // Fallback for browsers without CSS anchor positioning
+    if (!CSS.supports('position-anchor', '--feature')) {
+      const place = () => {
+        const r = feature.getBoundingClientRect();
+        tourStep.style.top = r.bottom + 'px';
+        tourStep.style.left = Math.max(8, r.left + r.width / 2 - tourStep.offsetWidth / 2) + 'px';
+      };
+      place();
+      addEventListener('resize', place);
+      addEventListener('scroll', place, { passive: true });
+    }
+  </script>
+
