+    <p id="card-expiry" aria-live="polite"></p>
   </footer>
 
+  <script type="module">
+    // Credit card expiry is a year + month only, so model it as a PlainYearMonth.
+    // Calendar-month arithmetic avoids leap-year/day-count pitfalls entirely.
+    if (typeof Temporal === 'undefined') {
+      const { Temporal: polyfill } = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = polyfill;
+    }
+
+    const expiry = Temporal.PlainYearMonth.from({ year: 2027, month: 12, calendar: 'iso8601' });
+    const currentMonth = Temporal.Now.plainDateISO('iso8601').toPlainYearMonth();
+    const { sign, years, months } = currentMonth.until(expiry, { largestUnit: 'years' });
+
+    const plural = (n, unit) => `${n} ${unit}${n === 1 ? '' : 's'}`;
+    let message;
+    if (sign < 0) {
+      message = 'Your card on file has expired.';
+    } else if (sign === 0) {
+      message = 'Your card on file expires this month.';
+    } else {
+      const parts = [];
+      if (years) parts.push(plural(years, 'year'));
+      if (months) parts.push(plural(months, 'month'));
+      message = `Your card on file expires in ${parts.join(' and ')} (December 2027).`;
+    }
+    document.getElementById('card-expiry').textContent = message;
+  </script>
+
 </body>
 
