     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const CALENDARS = [
+      { id: 'islamic-umalqura', title: 'Islamic (Umm al-Qura)', dateId: 'islamic-date' },
+      { id: 'hebrew', title: 'Hebrew' },
+      { id: 'japanese', title: 'Japanese' },
+    ];
+    const LOCALE = 'en';
+
+    // Use native Temporal when available, otherwise progressively load a polyfill.
+    async function getTemporal() {
+      if (typeof globalThis.Temporal !== 'undefined') return globalThis.Temporal;
+      const module = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = module.Temporal;
+      return module.Temporal;
+    }
+
+    function isCalendarSupported(id) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(id);
+      } catch {
+        return false;
+      }
+    }
+
+    function el(tag, text, attrs = {}) {
+      const node = document.createElement(tag);
+      if (text !== undefined) node.textContent = text;
+      Object.assign(node, attrs);
+      return node;
+    }
+
+    function row(dl, label, value) {
+      dl.append(el('dt', label), el('dd', value));
+    }
+
+    function buildCard(Temporal, config, isoDate, todayISO) {
+      const card = el('article', undefined, { className: 'card calendar-card' });
+      card.append(el('h3', config.title));
+
+      if (!isCalendarSupported(config.id)) {
+        card.append(el('p', 'This calendar is not supported by your browser.'));
+        return card;
+      }
+
+      try {
+        const date = isoDate.withCalendar(config.id);
+        const today = todayISO.withCalendar(config.id);
+
+        const formatted = el('p', date.toLocaleString(`${LOCALE}-u-ca-${config.id}`, {
+          era: 'long', year: 'numeric', month: 'long', day: 'numeric',
+        }), { className: 'formatted-date' });
+        if (config.dateId) formatted.id = config.dateId;
+
+        const cmp = Temporal.PlainDate.compare(date, today);
+        const timeline = el('p', undefined);
+        timeline.append(el('span', cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today', { className: 'timeline' }));
+
+        const dl = el('dl');
+        row(dl, 'Year', String(date.year));
+        if (date.era) row(dl, 'Era', `${date.era} ${date.eraYear}`);
+        row(dl, 'Month', String(date.month));
+        row(dl, 'Month code', date.monthCode);
+        row(dl, 'Months in year', String(date.monthsInYear));
+
+        // Month breakdown: never assume 12 months or fixed lengths.
+        const firstOfMonth = date.with({ day: 1 });
+        const table = el('table');
+        const caption = el('caption', `Months in ${date.year}`, { className: 'sr-only' });
+        caption.style.cssText = 'position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)';
+        const head = el('tr');
+        head.append(el('th', 'Code'), el('th', 'Days'));
+        const thead = el('thead');
+        thead.append(head);
+        table.append(caption, thead);
+        const body = el('tbody');
+        for (let m = 1; m <= date.monthsInYear; m++) {
+          const month = firstOfMonth.with({ month: m });
+          const tr = el('tr');
+          tr.append(el('td', month.monthCode), el('td', String(month.daysInMonth)));
+          body.append(tr);
+        }
+        table.append(body);
+
+        card.append(formatted, timeline, dl, table);
+      } catch (error) {
+        card.append(el('p', 'This date is outside the range supported for this calendar.'));
+      }
+      return card;
+    }
+
+    const form = document.getElementById('calendar-form');
+    const input = document.getElementById('calendar-date');
+    const cards = document.getElementById('calendar-cards');
+    const status = document.getElementById('calendar-status');
+
+    try {
+      const Temporal = await getTemporal();
+      const todayISO = Temporal.Now.plainDateISO();
+
+      const render = () => {
+        cards.replaceChildren();
+        status.textContent = '';
+        let isoDate;
+        try {
+          isoDate = Temporal.PlainDate.from(input.value);
+        } catch {
+          status.textContent = 'Please choose a valid date.';
+          return;
+        }
+        cards.append(...CALENDARS.map((c) => buildCard(Temporal, c, isoDate, todayISO)));
+      };
+
+      input.value = todayISO.toString();
+      input.addEventListener('input', render);
+      form.addEventListener('submit', (e) => { e.preventDefault(); render(); });
+      render();
+    } catch (error) {
+      console.error('Temporal unavailable:', error);
+      input.disabled = true;
+      status.textContent = 'Calendar conversion is unavailable in this browser.';
+    }
+  </script>
+
 </body>
 
