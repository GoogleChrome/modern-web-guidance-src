+  <script>
+    // Fallback for browsers without CSS anchor positioning: place the panel
+    // below the trigger's left edge, flipping and clamping to the viewport.
+    (function () {
+      var panel = document.getElementById('action-panel');
+      var trigger = document.getElementById('trigger-btn');
+      if (CSS.supports('anchor-name: --a')) return;
+
+      function place() {
+        var t = trigger.getBoundingClientRect();
+        var p = panel.getBoundingClientRect();
+        var vw = document.documentElement.clientWidth;
+        var vh = document.documentElement.clientHeight;
+        var top = t.bottom + p.height > vh && t.top - p.height >= 0 ? t.top - p.height : t.bottom;
+        var left = t.left + p.width > vw && t.right - p.width >= 0 ? t.right - p.width : t.left;
+        panel.style.top = Math.max(0, top) + 'px';
+        panel.style.left = Math.max(0, left) + 'px';
+      }
+
+      panel.addEventListener('toggle', function (e) {
+        if (e.newState === 'open') place();
+      });
+      window.addEventListener('resize', function () {
+        if (panel.matches(':popover-open')) place();
+      });
+    })();
+  </script>
