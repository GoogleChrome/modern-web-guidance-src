+      } else {
+        initial = parseHash();
+        history.replaceState({ path: [] }, '', BASE_URL);        // synthesized homepage entry
+        if (initial.length) history.pushState({ path: initial }, '', urlFor(initial));
+      }
+      reconcile(initial, false);
+    })();
+  </script>
