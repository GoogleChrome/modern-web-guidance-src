+    /* Stack: full-screen, horizontally snapping card navigation */
+    html,
+    body {
+      height: 100%;
+      overflow: hidden;
+      overscroll-behavior: none;
+    }
+
+    .Stack {
+      position: fixed;
+      inset: 0;
+      display: flex;
+      overflow-x: auto;
+      overflow-y: hidden;
+      scroll-snap-type: x mandatory;
+      overscroll-behavior: contain;
+      scrollbar-width: none;
+      -ms-overflow-style: none;
+      background: #000;
+    }
+
+    @supports (height: 100dvh) {
+      .Stack {
+        height: 100dvh;
+      }
+    }
+
+    .Stack::-webkit-scrollbar,
+    .Stack-viewContent::-webkit-scrollbar {
+      display: none;
+    }
+
+    /* The view itself is never transformed, so snap geometry stays stable. */
+    .Stack-view {
+      position: relative;
+      flex: 0 0 100%;
+      height: 100%;
+      scroll-snap-align: start;
+      scroll-snap-stop: always;
+    }
+
+    /* Edge shadow cast by an incoming card onto the one beneath. */
+    .Stack-view::before {
+      content: "";
+      position: absolute;
+      top: 0;
+      bottom: 0;
+      right: 100%;
+      width: 28px;
+      background: linear-gradient(to left, rgba(0, 0, 0, 0.35), transparent);
+      opacity: var(--e, 0);
+      pointer-events: none;
+    }
+
+    /* Dimming of a card as the next one covers it. */
+    .Stack-view::after {
+      content: "";
+      position: absolute;
+      inset: 0;
+      background: #000;
+      opacity: calc(var(--p, 0) * 0.4);
+      pointer-events: none;
+    }
+
+    /* Parallax: only the inner content moves. */
