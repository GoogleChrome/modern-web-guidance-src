+          facts: [['Size', '16 oz / 24 oz'], ['Price', '$4.75'], ['Caffeine', '200 mg'], ['Available', 'Year-round']]
+        }
+      };
+
+      const ROOT_TITLE = document.title;
+      const BASE_URL = location.pathname + location.search;
+      const stack = document.querySelector('.Stack');
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      const hasScrollEnd = 'onscrollend' in window;
+
+      const views = [{ el: stack.querySelector('.Stack-view'), id: null, opener: null }];
+      let path = [];       // ids of drill-down views, mirrors history.state.path
+      let target = null;   // index of an in-flight programmatic scroll
+      let settleTimer = 0;
+      let raf = 0;
+
+      const behavior = () => (reduceMotion.matches ? 'instant' : 'smooth');
+      const clamp = (n) => Math.min(1, Math.max(0, n));
+      const urlFor = (p) => (p.length ? '#/view/' + p[p.length - 1] : BASE_URL);
+
+      function parseHash() {
+        const m = /^#\/view\/(\d+)$/.exec(location.hash);
+        return m && DRINKS[m[1]] ? [Number(m[1])] : [];
+      }
+
+      function createView(id) {
+        const d = DRINKS[id];
+        const next = (id % Object.keys(DRINKS).length) + 1;
+        const el = document.createElement('div');
+        el.className = 'Stack-view';
+        el.innerHTML = `
+          <div class="Stack-viewContent">
+            <header class="detail-bar">
+              <button class="back" type="button">&larr; Back</button>
+              <h2></h2>
+            </header>
+            <div class="detail-body">
+              <img class="detail-photo" alt="" src="https://images.unsplash.com/${d.img}?auto=format&fit=crop&w=1000&q=80">
+              <p></p>
+              <p></p>
+              <dl>${d.facts.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('')}</dl>
+              <a class="btn item" href="#/view/${next}">Up next: ${DRINKS[next].name}</a>
+            </div>
+          </div>`;
+        el.querySelector('h2').textContent = d.name;
+        const [lead, more] = el.querySelectorAll('.detail-body > p');
+        lead.textContent = d.blurb;
+        more.textContent = d.more;
+        stack.appendChild(el);
+        return { el, id, opener: null };
+      }
+
+      /* Scroll-linked parallax, dimming and edge shadow (custom props only). */
+      function updateEffects() {
+        raf = 0;
+        const w = stack.clientWidth;
+        if (!w) return;
+        const x = stack.scrollLeft;
+        views.forEach((v, i) => {
+          const d = (x - i * w) / w;               // >0: covered by next, <0: incoming
+          v.el.style.setProperty('--p', clamp(d).toFixed(4));
+          v.el.style.setProperty('--e', d > 0 ? 1 : clamp((1 + d) * 2).toFixed(4));
+        });
+      }
+
+      function updateTopState() {
+        views.forEach((v, i) => { v.el.inert = i !== views.length - 1; });
+        const top = views[views.length - 1];
+        document.title = top.id ? `${DRINKS[top.id].name} | ${ROOT_TITLE}` : ROOT_TITLE;
+      }
+
+      function restoreFocus(removed, revealed) {
+        let opener = removed.opener;
+        if (!opener || !opener.isConnected) {
+          opener = revealed.el.querySelector(`.item[href="#/view/${removed.id}"]`);
+        }
+        if (opener) opener.focus({ preventScroll: true });
+      }
+
+      /* Runs once scrolling has come to rest. */
+      function settle() {
+        const w = stack.clientWidth;
+        if (!w) return;
+        const idx = Math.round(stack.scrollLeft / w);
+        if (target !== null) {
+          if (idx !== target) return;
+          target = null;
+        }
+        if (idx < views.length - 1) {
+          const removed = views.splice(idx + 1);
+          removed.forEach((v) => v.el.remove());
+          if (path.length > idx) {
+            // User swiped back: bring history in line with the DOM.
+            const steps = path.length - idx;
+            path = path.slice(0, idx);
+            history.go(-steps);
+          }
+          updateTopState();
+          restoreFocus(removed[0], views[idx]);
+        } else {
+          updateTopState();
+        }
+        updateEffects();
+      }
+
+      function goTo(idx, smooth) {
+        const left = idx * stack.clientWidth;
+        if (Math.abs(stack.scrollLeft - left) < 1) {
+          target = null;
+          settle();
+          return;
+        }
+        target = idx;
+        stack.scrollTo({ left, behavior: smooth ? behavior() : 'instant' });
+      }
+
+      function reconcile(newPath, smooth) {
+        let i = 0;
+        while (i < newPath.length && views[i + 1] && views[i + 1].id === newPath[i]) i++;
+        if (i < newPath.length) {
+          views.splice(i + 1).forEach((v) => v.el.remove());
+          for (let j = i; j < newPath.length; j++) views.push(createView(newPath[j]));
+        }
+        path = newPath.slice();
+        updateEffects();
+        goTo(newPath.length, smooth);
+      }
+
+      function push(id, opener) {
+        const view = createView(id);
+        view.opener = opener;
+        views.push(view);
+        path = path.concat(id);
+        history.pushState({ path }, '', urlFor(path));
+        view.el.querySelector('.back').focus({ preventScroll: true });
+        updateTopState();
+        updateEffects();
+        goTo(views.length - 1, true);
+      }
+
+      stack.addEventListener('click', (e) => {
+        const link = e.target.closest('a.item');
+        if (link && stack.contains(link)) {
+          // Leave modified and non-primary clicks to the browser (new tab/window).
+          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+          const m = /^#\/view\/(\d+)$/.exec(link.getAttribute('href'));
+          if (!m || !DRINKS[m[1]]) return;
+          e.preventDefault();
+          push(Number(m[1]), link);
+          return;
+        }
+        if (e.target.closest('.back')) {
+          if (history.state && history.state.path && history.state.path.length) history.back();
+          else { history.replaceState({ path: [] }, '', BASE_URL); reconcile([], true); }
+        }
+      });
+
+      stack.addEventListener('scroll', () => {
+        if (!raf) raf = requestAnimationFrame(updateEffects);
+        if (!hasScrollEnd) {
+          clearTimeout(settleTimer);
+          settleTimer = setTimeout(settle, 100);
+        }
+      }, { passive: true });
+      if (hasScrollEnd) stack.addEventListener('scrollend', settle);
+
+      // A touch or wheel interrupts any programmatic scroll.
+      const interrupt = () => { target = null; };
+      stack.addEventListener('touchstart', interrupt, { passive: true });
+      stack.addEventListener('wheel', interrupt, { passive: true });
+
+      window.addEventListener('popstate', (e) => {
+        const p = e.state && Array.isArray(e.state.path) ? e.state.path : parseHash();
+        reconcile(p.filter((id) => DRINKS[id]), true);
+      });
+
+      window.addEventListener('resize', () => {
+        const left = (views.length - 1) * stack.clientWidth;
+        if (target === null) stack.scrollTo({ left, behavior: 'instant' });
+      });
+
+      // Initial route, with deep-link support.
+      let initial;
+      if (history.state && Array.isArray(history.state.path)) {
