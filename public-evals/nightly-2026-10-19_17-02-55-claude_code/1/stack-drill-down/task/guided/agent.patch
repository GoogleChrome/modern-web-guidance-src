+    /* App shell: the Stack fills the screen; each view scrolls itself */
+    html,
+    body {
+      height: 100%;
+      overflow: hidden;
+      overscroll-behavior: none;
+    }
+
+    .Stack {
+      /* dvh tracks the dynamic viewport so the mobile address bar
+         showing/hiding never clips or leaks */
+      height: 100dvh;
+      display: grid;
+      grid-auto-flow: column;
+      grid-auto-columns: 100%;
+      grid-template-rows: 100%;
+      overflow-x: auto;
+      overflow-y: hidden;
+      scroll-snap-type: x mandatory;
+      overscroll-behavior-x: none;
+      scrollbar-width: none;
+    }
+
+    .Stack::-webkit-scrollbar,
+    .Stack-viewContent::-webkit-scrollbar {
+      display: none;
+    }
+
+    /* Smooth programmatic scrolling only when motion is welcome; JS uses
+       behavior: 'auto' so this rule decides */
+    @media (prefers-reduced-motion: no-preference) {
+      .Stack {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .Stack-view {
+      scroll-snap-align: start;
+      scroll-snap-stop: always;
+      min-width: 0;
+    }
+
+    /* All visual transforms live on this inner element; transforming the
+       snap target would feed back into snap geometry */
+    .Stack-viewContent {
+      width: 100%;
+      height: 100%;
+      background-color: var(--light);
+      overflow-y: auto;
+      overscroll-behavior: contain;
+      scrollbar-width: none;
+    }
+
+    @supports (animation-timeline: view()) {
