+<script type="module">
+    // Temporal is not in Safari yet; load the reference polyfill when missing.
+    if (typeof Temporal === 'undefined') {
+      ({ Temporal: globalThis.Temporal } = await import('https://esm.sh/@js-temporal/polyfill'));
+    }
+
+    const formatDuration = (duration) => {
+      if (typeof Intl.DurationFormat !== 'undefined') {
+        return new Intl.DurationFormat(navigator.language, { style: 'long' }).format(duration);
+      }
+      const plural = (n, unit) => `${n} ${unit}${n === 1 ? '' : 's'}`;
+      return `${plural(duration.days, 'day')} and ${plural(duration.hours, 'hour')}`;
+    };
+
+    const options = { largestUnit: 'days', smallestUnit: 'hours', roundingMode: 'floor' };
+
+    // Runs once per page load (no live ticking).
+    for (const timer of document.querySelectorAll('.promo-timer')) {
+      const tz = Temporal.Now.timeZoneId();
+      const start = Temporal.PlainDateTime.from(timer.dataset.start).toZonedDateTime(tz);
+      const end = Temporal.PlainDateTime.from(timer.dataset.end).toZonedDateTime(tz);
+      const now = Temporal.Now.zonedDateTimeISO(tz);
+
+      const remaining = timer.querySelector('.remaining');
+      const elapsed = timer.querySelector('.elapsed');
+
+      if (Temporal.ZonedDateTime.compare(now, end) >= 0) {
+        remaining.textContent = 'This offer has ended.';
+      } else {
+        remaining.textContent = `Ends in ${formatDuration(now.until(end, options))}`;
+      }
+
+      if (Temporal.ZonedDateTime.compare(now, start) >= 0) {
+        const ended = Temporal.ZonedDateTime.compare(now, end) >= 0;
+        elapsed.textContent = ended
+          ? `Ran for ${formatDuration(start.until(end, options))}`
+          : `Started ${formatDuration(start.until(now, options))} ago`;
+      }
+      timer.hidden = false;
+    }
+  </script>
 </body>
 
