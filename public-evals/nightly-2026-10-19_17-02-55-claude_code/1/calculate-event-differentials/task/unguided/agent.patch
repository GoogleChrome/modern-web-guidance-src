+  <script>
+    // Promotion countdown: computed once on page load, in the visitor's local time zone.
+    (function () {
+      var el = document.getElementById('maple-countdown');
+      if (!el) return;
+
+      var start = new Date(el.getAttribute('data-start'));
+      var end = new Date(el.getAttribute('data-end'));
+      if (isNaN(start) || isNaN(end)) return;
+
+      var MS_HOUR = 60 * 60 * 1000;
+      var MS_DAY = 24 * MS_HOUR;
+
+      function plural(n, unit) {
+        return n + ' ' + unit + (n === 1 ? '' : 's');
+      }
+
+      function format(ms) {
+        var days = Math.floor(ms / MS_DAY);
+        var hours = Math.floor((ms % MS_DAY) / MS_HOUR);
+        return plural(days, 'day') + ', ' + plural(hours, 'hour');
+      }
+
+      var now = new Date();
+      var remaining = el.querySelector('.countdown-remaining');
+      var elapsed = el.querySelector('.countdown-elapsed');
+
+      if (now >= end) {
+        remaining.textContent = 'This offer has ended.';
+        elapsed.textContent = '';
+        return;
+      }
+
+      remaining.textContent = format(end - now) + ' left';
+      elapsed.textContent = now >= start
+        ? format(now - start) + ' since the offer started'
+        : 'Starts in ' + format(start - now);
+    })();
+  </script>
+
 </body>
 
