+  <link rel="expect" href="#main-content" blocking="render">
+  <script blocking="render">
+    // Only set up transition types if the user doesn't prefer reduced motion.
+    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      const pageNumber = (url) => Number(new URL(url).searchParams.get('page')) || 1;
+
+      window.addEventListener('pagereveal', (e) => {
+        const activation = window.navigation?.activation;
+        if (!e.viewTransition || !activation?.from) return;
+
+        const from = pageNumber(activation.from.url);
+        const to = pageNumber(activation.entry.url);
+        if (to > from) e.viewTransition.types.add('next');
+        else if (to < from) e.viewTransition.types.add('previous');
+      });
+    }
+  </script>
 </head>
 
