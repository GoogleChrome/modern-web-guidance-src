+
+    /* Pagination */
+    .pagination {
+      display: flex;
+      justify-content: space-between;
+      margin-top: 30px;
+    }
+
+    .pagination a[aria-disabled="true"] {
+      visibility: hidden;
+    }
+
+    /* Page transitions (cross-document view transitions) */
+    @media (prefers-reduced-motion: no-preference) {
+      @view-transition {
+        navigation: auto;
+      }
+
+      @keyframes slide-out-left {
+        to { opacity: 0; transform: translateX(-60px); }
+      }
+
+      @keyframes slide-out-right {
+        to { opacity: 0; transform: translateX(60px); }
+      }
+
+      @keyframes slide-in-from-right {
+        from { opacity: 0; transform: translateX(60px); }
+      }
+
+      @keyframes slide-in-from-left {
+        from { opacity: 0; transform: translateX(-60px); }
+      }
+
+      @keyframes fade-out {
+        to { opacity: 0; }
+      }
+
+      @keyframes fade-in {
+        from { opacity: 0; }
+      }
+
+      /* Default: simple cross-fade for ordinary navigation */
+      ::view-transition-old(root) {
+        animation: 250ms ease-in both fade-out;
+      }
+
+      ::view-transition-new(root) {
+        animation: 250ms ease-out both fade-in;
+      }
+
+      /* Next: old page exits left, new page enters from the right */
+      html:active-view-transition-type(next) {
+        &::view-transition-old(root) {
+          animation: 350ms ease-in both slide-out-left;
+        }
+
+        &::view-transition-new(root) {
+          animation: 350ms ease-out both slide-in-from-right;
+        }
+      }
+
+      /* Previous: old page exits right, new page enters from the left */
+      html:active-view-transition-type(previous) {
+        &::view-transition-old(root) {
+          animation: 350ms ease-in both slide-out-right;
+        }
+
+        &::view-transition-new(root) {
+          animation: 350ms ease-out both slide-in-from-left;
+        }
+      }
+    }
   </style>
