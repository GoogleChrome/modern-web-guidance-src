+  <script>
+    const ITEMS = [
+      ['Maple Oat Latte', 'Creamy oat milk with a hint of Vermont maple syrup.', '/menu/seasonal'],
+      ['Dark Roast Espresso', 'Bold, smokey, and perfect for a morning boost.', '/menu/espresso'],
+      ['Cold Brew', 'Steeped for 18 hours for maximum smoothness.', '/menu/cold-brew'],
+      ['Pumpkin Spice Latte', 'Roasted pumpkin, warm spices, and steamed milk.', '/menu/pumpkin-spice'],
+      ['Cinnamon Cortado', 'Equal parts espresso and milk with a dusting of cinnamon.', '/menu/cortado'],
+      ['Honey Lavender Latte', 'Floral lavender and local honey over smooth espresso.', '/menu/lavender'],
+      ['Caramel Macchiato', 'Vanilla, steamed milk, espresso, and caramel drizzle.', '/menu/macchiato'],
+      ['Nitro Cold Brew', 'Cold brew infused with nitrogen for a creamy finish.', '/menu/nitro'],
+      ['Chai Latte', 'Spiced black tea with steamed milk and honey.', '/menu/chai']
+    ];
+    const PER_PAGE = 3;
+    const LAST_PAGE = Math.ceil(ITEMS.length / PER_PAGE);
+
+    function getPage(url) {
+      const n = parseInt(new URL(url, location.href).searchParams.get('page'), 10);
+      return Math.min(Math.max(n || 1, 1), LAST_PAGE);
+    }
+
+    const page = getPage(location.href);
+
+    // Render the current page of cards (runs before first paint/reveal)
+    document.getElementById('grid').replaceChildren(
+      ...ITEMS.slice((page - 1) * PER_PAGE, page * PER_PAGE).map(([title, desc, href]) => {
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.innerHTML = '<h3></h3><p></p><a class="btn">View Details</a>';
+        card.querySelector('h3').textContent = title;
+        card.querySelector('p').textContent = desc;
+        card.querySelector('a').href = href;
+        return card;
+      })
+    );
+
+    const prev = document.getElementById('previous');
+    const next = document.getElementById('next');
+    prev.href = '?page=' + Math.max(page - 1, 1);
+    next.href = '?page=' + Math.min(page + 1, LAST_PAGE);
+    prev.setAttribute('aria-disabled', page === 1);
+    next.setAttribute('aria-disabled', page === LAST_PAGE);
+
+    // Only set up page transitions if the user doesn't prefer reduced motion
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      window.addEventListener('pagereveal', (event) => {
+        if (!event.viewTransition || !navigation.activation?.from) return;
+
+        const fromPage = getPage(navigation.activation.from.url);
+        const toPage = getPage(navigation.activation.entry.url);
+
+        if (toPage > fromPage) {
+          event.viewTransition.types.add('next');
+        } else if (toPage < fromPage) {
+          event.viewTransition.types.add('previous');
+        }
+      });
+    }
+  </script>
