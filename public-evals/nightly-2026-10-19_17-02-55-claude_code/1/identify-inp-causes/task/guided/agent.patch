+  <script type="module">
+    // Field INP diagnostics: the attribution build reports INP subparts and,
+    // where supported (Chromium), Long Animation Frame script details.
+    import { onINP } from 'https://unpkg.com/web-vitals@5/dist/web-vitals.attribution.js?module';
+
+    onINP((metric) => {
+      const a = metric.attribution;
+      const script = a.longestScript?.entry;
+      const body = JSON.stringify({
+        name: 'INP',
+        value: metric.value,
+        rating: metric.rating,
+        // Subparts: where the time went.
+        inputDelay: a.inputDelay,
+        processingDuration: a.processingDuration,
+        presentationDelay: a.presentationDelay,
+        interactionTarget: a.interactionTarget,
+        interactionType: a.interactionType,
+        // Longest script overlapping the interaction (LoAF; may be undefined).
+        invokerType: script?.invokerType,
+        sourceURL: script?.sourceURL,
+        sourceFunctionName: script?.sourceFunctionName,
+        sourceCharPosition: script?.sourceCharPosition,
+        subpart: a.longestScript?.subpart,
+        intersectingDuration: a.longestScript?.intersectingDuration,
+        url: location.href,
+      });
+      // Placeholder endpoint: point at a real analytics collector.
+      navigator.sendBeacon('/analytics', body);
+    }, { reportAllChanges: false });
+  </script>
+
 </body>
 
