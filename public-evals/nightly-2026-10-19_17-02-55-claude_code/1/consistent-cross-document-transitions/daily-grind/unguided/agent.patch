+  <!-- Hold the first render (and therefore any incoming view transition) until
+       the content up to #page-content has been parsed. Styles are inline above
+       and the script below is synchronous, so both are ready by then too. -->
+  <link rel="expect" href="#page-content" blocking="render">
+  <script>
+    // Critical script: runs synchronously before first render. Skip the
+    // transition entirely for users who prefer reduced motion.
+    (function () {
+      var reduce = matchMedia('(prefers-reduced-motion: reduce)');
+      function skip(e) { if (reduce.matches && e.viewTransition) e.viewTransition.skipTransition(); }
+      addEventListener('pagereveal', skip);
+      addEventListener('pageswap', skip);
+    })();
+  </script>
   <style>
     :root {
       --primary: #4e342e;
@@ -27,6 +42,47 @@
