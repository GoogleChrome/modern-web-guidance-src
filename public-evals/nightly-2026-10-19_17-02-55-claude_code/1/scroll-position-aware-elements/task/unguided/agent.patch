diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -151,13 +151,85 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Scroll container */
+    .scroller {
+      position: relative;
+      height: 100vh;
+      overflow-y: auto;
+      scroll-behavior: smooth;
+    }
+
+    /* Zero-size-cost marker; once it leaves the viewport the button shows */
+    .scroller-sentinel {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 1px;
+      height: 300px;
+      pointer-events: none;
+      visibility: hidden;
+    }
+
+    /* Back to top button */
+    .back-to-top {
+      position: fixed;
+      right: 24px;
+      bottom: 24px;
+      z-index: 1001;
+      width: 48px;
+      height: 48px;
+      border: 0;
+      border-radius: 50%;
+      background: var(--primary);
+      color: white;
+      font-size: 1.4rem;
+      line-height: 1;
+      cursor: pointer;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
+      opacity: 0;
+      transform: translateY(16px);
+      /* visibility keeps the hidden button out of the tab order and
+         accessibility tree; it flips after the fade-out finishes */
+      visibility: hidden;
+      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0.3s;
+    }
+
+    .back-to-top.is-visible {
+      opacity: 1;
+      transform: none;
+      visibility: visible;
+      transition-delay: 0s;
+    }
+
+    .back-to-top:hover {
+      background: #3e2723;
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .scroller {
+        scroll-behavior: auto;
+      }
+
+      .back-to-top {
+        transition: none;
+      }
+    }
   </style>
 </head>
 
 <body>
 
+  <div class="scroller" id="scroller">
+  <div class="scroller-sentinel" aria-hidden="true"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +278,30 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button type="button" class="back-to-top" aria-label="Back to top">&uarr;</button>
+  </div>
+
+  <script>
+    // IntersectionObserver instead of a scroll listener: the callback only
+    // fires when the sentinel enters/leaves the scroller's viewport.
+    (function () {
+      var scroller = document.querySelector('.scroller');
+      var button = scroller.querySelector('.back-to-top');
+      var sentinel = scroller.querySelector('.scroller-sentinel');
+
+      new IntersectionObserver(function (entries) {
+        button.classList.toggle('is-visible', !entries[entries.length - 1].isIntersecting);
+      }, { root: scroller }).observe(sentinel);
+
+      button.addEventListener('click', function () {
+        scroller.scrollTo({ top: 0 }); // smoothness comes from CSS scroll-behavior
+        // Move focus to the top so keyboard users don't lose their place
+        // once the button hides itself.
+        scroller.querySelector('nav a').focus({ preventScroll: true });
+      });
+    })();
+  </script>
 </body>
 
 </html>
