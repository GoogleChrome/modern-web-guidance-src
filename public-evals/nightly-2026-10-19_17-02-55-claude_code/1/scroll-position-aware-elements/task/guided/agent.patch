@@ -206,7 +283,26 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button type="button" class="back-to-top" aria-label="Back to top">&uarr;</button>
+  </div>
+
+  <script>
+    const scroller = document.querySelector('.scroller');
+
+    document.querySelector('.back-to-top').addEventListener('click', () => {
+      const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
+      scroller.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
+    });
+
+    // Fallback for browsers without scroll-state container queries (Firefox, Safari)
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      new IntersectionObserver(([entry]) => {
+        scroller.classList.toggle('scrolled', !entry.isIntersecting);
+      }, { root: scroller }).observe(document.querySelector('.scroll-sentinel'));
+    }
+  </script>
+
 </body>
 
