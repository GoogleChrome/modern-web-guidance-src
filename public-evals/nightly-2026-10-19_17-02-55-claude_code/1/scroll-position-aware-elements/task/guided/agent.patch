diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -26,8 +26,80 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    /* Scroll container: the page scrolls inside this element, not the body */
+    .scroller {
+      height: 100dvh;
+      overflow-y: auto;
+      container-type: scroll-state;
+    }
+
+    /* Zero-size marker used by the IntersectionObserver fallback */
+    .scroll-sentinel {
+      height: 1px;
+      margin-bottom: -1px;
+      visibility: hidden;
+    }
+
+    /* Floating back-to-top button, hidden (and removed from tab order) until scrolled */
+    .back-to-top {
+      position: sticky;
+      bottom: 20px;
+      display: block;
+      width: 3rem;
+      height: 3rem;
+      /* Net-zero layout height so it doesn't add space below the footer */
+      margin: -3rem 20px 0 auto;
+      border: 0;
+      border-radius: 50%;
+      background: var(--primary);
+      color: white;
+      font-size: 1.25rem;
+      cursor: pointer;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
+      z-index: 900;
+      visibility: hidden;
+      opacity: 0;
+      translate: 0 20px;
+      transition:
+        visibility 0.3s,
+        opacity 0.3s ease,
+        translate 0.3s ease,
+        background 0.3s;
+    }
+
+    .back-to-top:hover {
+      background: #3e2723;
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    @container scroll-state(scrollable: top) {
+      .back-to-top {
+        visibility: visible;
+        opacity: 1;
+        translate: 0 0;
+      }
+    }
+
+    /* Fallback class toggled by the IntersectionObserver */
+    .scrolled .back-to-top {
+      visibility: visible;
+      opacity: 1;
+      translate: 0 0;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .back-to-top {
+        transition: visibility 0s, opacity 0.01s;
+        translate: 0 0;
+      }
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
