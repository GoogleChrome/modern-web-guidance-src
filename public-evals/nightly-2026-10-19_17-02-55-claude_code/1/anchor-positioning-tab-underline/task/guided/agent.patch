diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -48,8 +48,9 @@
 
     nav ul {
       display: flex;
       list-style: none;
+      position: relative;
     }
 
     nav ul li {
       margin-left: 20px;
@@ -65,8 +66,40 @@
     nav a:hover {
       color: var(--accent);
     }
 
+    /* Active tab underline */
+    nav ul li.active {
+      anchor-name: --active;
+    }
+
+    nav ul::before {
+      content: '';
+      position: absolute;
+      position-anchor: --active;
+      /* Not position-area: it can't be transitioned */
+      inset-block-start: calc(anchor(bottom) + .1lh);
+      inset-inline-start: anchor(left);
+      inset-inline-end: anchor(right);
+      block-size: .15lh;
+      background: var(--accent);
+
+      @media (prefers-reduced-motion: no-preference) {
+        transition: inset .2s;
+      }
+    }
+
+    /* Fallback: static underline where anchor positioning is unsupported */
+    @supports not (position-anchor: auto) {
+      nav ul::before {
+        content: none;
+      }
+
+      nav ul li.active {
+        border-bottom: .15lh solid var(--accent);
+      }
+    }
+
     .logout-link {
       border: 1px solid var(--accent);
       padding: 5px 12px;
       border-radius: 4px;
@@ -159,9 +192,9 @@
 
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
-      <li><a href="/menu">Menu</a></li>
+      <li class="active"><a href="/menu" aria-current="page">Menu</a></li>
       <li><a href="/locations">Locations</a></li>
       <li><a href="/rewards">Rewards</a></li>
       <li><a href="/account">My Account</a></li>
       <li><a href="/logout" class="logout-link">Logout</a></li>
