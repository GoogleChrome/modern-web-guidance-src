diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -65,8 +65,50 @@
     nav a:hover {
       color: var(--accent);
     }
 
+    /* Active tab underline */
+    nav ul li.active a {
+      color: var(--accent);
+      border-bottom: 2px solid var(--accent);
+      padding-bottom: 2px;
+    }
+
+    @supports (anchor-name: --active-tab) and (position-anchor: --active-tab) {
+      nav ul {
+        position: relative;
+      }
+
+      nav ul li.active {
+        anchor-name: --active-tab;
+      }
+
+      /* The anchored line replaces the static border fallback */
+      nav ul li.active a {
+        border-bottom: 0;
+        padding-bottom: 0;
+      }
+
+      nav ul:has(li.active)::before {
+        content: "";
+        position: absolute;
+        position-anchor: --active-tab;
+        left: anchor(left);
+        right: anchor(right);
+        top: anchor(bottom);
+        height: 2px;
+        margin-top: 4px;
+        background: var(--accent);
+        transition: left 0.3s ease, right 0.3s ease, top 0.3s ease;
+      }
+
+      @media (prefers-reduced-motion: reduce) {
+        nav ul:has(li.active)::before {
+          transition: none;
+        }
+      }
+    }
+
     .logout-link {
       border: 1px solid var(--accent);
       padding: 5px 12px;
       border-radius: 4px;
@@ -159,9 +201,9 @@
 
