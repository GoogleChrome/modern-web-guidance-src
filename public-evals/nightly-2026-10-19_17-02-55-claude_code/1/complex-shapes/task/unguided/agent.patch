+    .hero > *:not(.shaped-element) {
+      position: relative;
+      z-index: 1;
+    }
+
+    /* Decorative coffee-splash block. Purely additive: it is absolutely
+       positioned, so the hero layout is identical whether or not it renders.
+       The background colour is the fallback if the photo fails to load. */
+    .shaped-element {
+      display: none;
+      position: absolute;
+      right: 4%;
+      bottom: -8%;
+      width: min(34vw, 420px);
+      aspect-ratio: 1;
+      background: var(--accent) url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=800&q=80') center / cover no-repeat;
+      pointer-events: none;
+      opacity: 0.9;
+    }
+
+    /* Only show it where the free-form mask is supported, so an unmasked
+       square never appears in its place. */
+    @supports ((mask-image: url('x')) or (-webkit-mask-image: url('x'))) {
+      .shaped-element {
+        display: block;
+        -webkit-mask: var(--splash-mask) center / contain no-repeat;
+        mask: var(--splash-mask) center / contain no-repeat;
