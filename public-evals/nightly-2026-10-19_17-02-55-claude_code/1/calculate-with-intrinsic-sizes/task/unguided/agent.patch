+      max-inline-size: 100%;
+    }
+
+    /* Accordion */
+    .accordion {
+      margin-block-start: 40px;
+    }
+
+    #accordion-toggle {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      inline-size: 100%;
+      padding: 1rem 1.25rem;
+      background: var(--primary);
+      color: white;
+      border: 0;
+      border-radius: 8px;
+      font: inherit;
+      font-size: 1.1rem;
+      font-weight: bold;
+      cursor: pointer;
+    }
+
+    #accordion-toggle:hover {
+      background: #3e2723;
+    }
+
+    #accordion-toggle::after {
+      content: '+';
+      transition: rotate 0.4s ease;
+    }
+
+    #accordion-toggle[aria-expanded="true"]::after {
+      content: '\2212';
+    }
+
+    /*
+     * Directly transitioning between different intrinsic keyword sizes
+     * (e.g. min-content to max-content, or auto to fit-content) is not
+     * supported; keywords like auto only interpolate with a length when
+     * interpolate-size / calc-size() opts in, and keyword-to-keyword
+     * transitions still jump.
+     */
+    :root {
+      interpolate-size: allow-keywords;
+    }
+
+    .accordion-content {
+      block-size: 0;
+      overflow: hidden;
+      visibility: hidden;
+      transition: block-size 0.4s ease, visibility 0.4s;
+    }
+
+    .accordion-content.is-open {
+      /* natural height plus 2rem of breathing room */
+      block-size: calc-size(auto, size + 2rem);
+      visibility: visible;
+    }
+
+    .accordion-content p {
+      padding-block: 1rem 0;
+      padding-inline: 1.25rem;
+    }
+
+    /* No calc-size() support: expand without animating */
+    @supports not (block-size: calc-size(auto, size)) {
+      .accordion-content.is-open {
+        block-size: auto;
+        padding-block-end: 2rem;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .accordion-content,
+      #accordion-toggle::after {
+        transition: none;
+      }
+    }
