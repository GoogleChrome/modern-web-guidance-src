+<script>
+    // Without native <input switch> support, expose switch semantics and apply the styled fallback.
+    if (!('switch' in HTMLInputElement.prototype)) {
+      document.querySelectorAll('input[type="checkbox"][switch]').forEach((input) => {
+        input.setAttribute('role', 'switch');
+        input.classList.add('switch-fallback');
+      });
+    }
+  </script>
