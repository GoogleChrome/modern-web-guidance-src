+    /* Switch */
+    .switch-row {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 16px;
+      max-width: 520px;
+      margin: 40px auto 0;
+      padding: 16px 20px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .switch-text {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .switch-label {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .switch-desc {
+      font-size: 0.9rem;
+    }
+
+    .switch {
+      flex-shrink: 0;
+      position: relative;
+      width: 52px;
+      height: 32px;
+      border: 2px solid var(--primary);
+      border-radius: 16px;
+      background: white;
+      cursor: pointer;
+      transition: background 0.2s;
+    }
+
+    .switch::after {
+      content: "";
+      position: absolute;
+      top: 3px;
+      left: 3px;
+      width: 22px;
+      height: 22px;
+      border-radius: 50%;
+      background: var(--primary);
+      transition: transform 0.2s, background 0.2s;
+    }
+
+    .switch[aria-checked="true"] {
+      background: var(--primary);
+    }
+
+    .switch[aria-checked="true"]::after {
+      background: white;
+      transform: translateX(20px);
+    }
+
+    .switch:focus-visible {
+      outline: 3px solid #1a73e8;
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .switch,
+      .switch::after {
+        transition: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .switch {
+        border-color: ButtonText;
+        background: Canvas;
+      }
+
+      .switch::after {
+        background: ButtonText;
+      }
+
+      .switch[aria-checked="true"] {
+        background: Highlight;
+        border-color: Highlight;
+      }
+
+      .switch[aria-checked="true"]::after {
+        background: HighlightText;
+      }
+    }
+
+    .sr-only {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip: rect(0 0 0 0);
+      white-space: nowrap;
+    }
+
     footer {
