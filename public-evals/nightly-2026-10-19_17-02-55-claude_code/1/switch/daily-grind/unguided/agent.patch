+  <script>
+    // Native <button> gives Space/Enter activation and focusability for free.
+    const offersSwitch = document.getElementById('offers-switch');
+    const offersStatus = document.getElementById('offers-status');
+    offersSwitch.addEventListener('click', () => {
+      const on = offersSwitch.getAttribute('aria-checked') !== 'true';
+      offersSwitch.setAttribute('aria-checked', String(on));
+      offersStatus.textContent = on ? 'Seasonal offers on' : 'Seasonal offers off';
+    });
+  </script>
