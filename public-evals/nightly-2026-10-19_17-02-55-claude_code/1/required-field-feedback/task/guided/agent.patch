+  <script>
+    // Mirror the visual :user-invalid state to assistive tech
+    const syncAriaInvalid = (e) => {
+      const input = e.target;
+      if (!input.matches?.('.newsletter input')) return;
+      if (input.matches(':user-invalid')) {
+        input.setAttribute('aria-invalid', 'true');
+      } else {
+        input.removeAttribute('aria-invalid');
+      }
+    };
+    // blur/focus don't bubble, so use capture
+    document.addEventListener('blur', syncAriaInvalid, true);
+    document.addEventListener('input', (e) => {
+      if (e.target.getAttribute?.('aria-invalid') === 'true') syncAriaInvalid(e);
+    });
+    document.addEventListener('invalid', (e) => {
+      if (e.target.matches?.('.newsletter input')) e.target.setAttribute('aria-invalid', 'true');
+    }, true);
+  </script>
 </body>
 
