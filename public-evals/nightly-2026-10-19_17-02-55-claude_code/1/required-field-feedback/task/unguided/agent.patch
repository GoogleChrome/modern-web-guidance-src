diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -151,8 +151,66 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Mailing list signup */
+    .mailing-list {
+      max-width: 420px;
+      margin: 0 auto 25px;
+    }
+
+    .mailing-list h3 {
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    .mailing-list .field-row {
+      display: flex;
+      gap: 8px;
+    }
+
+    .mailing-list input[type="email"] {
+      flex: 1;
+      min-width: 0;
+      padding: 10px 12px;
+      border: 1px solid var(--primary);
+      border-radius: 5px;
+      font: inherit;
+    }
+
+    .mailing-list button {
+      background: var(--primary);
+      color: white;
+      border: none;
+      padding: 10px 20px;
+      border-radius: 5px;
+      font: inherit;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    .mailing-list button:hover {
+      background: #3e2723;
+    }
+
+    .mailing-list .error-message {
+      display: none;
+      color: #b71c1c;
+      font-size: 0.85rem;
+      margin-top: 6px;
+      text-align: left;
+    }
+
+    /* :user-invalid only matches after the user has interacted with the field
+       (e.g. blurred it while blank, or tried to submit), never on page load. */
+    .mailing-list input:user-invalid {
+      border-color: #b71c1c;
+    }
+
+    .mailing-list input:user-invalid~.error-message {
+      display: block;
+    }
   </style>
 </head>
 
