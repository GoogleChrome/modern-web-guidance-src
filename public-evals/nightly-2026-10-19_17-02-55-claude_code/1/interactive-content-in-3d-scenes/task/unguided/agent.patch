+  <script type="importmap">
+    { "imports": { "three": "https://unpkg.com/three@0.160.0/build/three.module.js" } }
+  </script>
+  <script type="module">
+    import * as THREE from 'three';
+
+    const scene3d = document.getElementById('scene');
+    const canvas = document.getElementById('scene-canvas');
+    const form = document.getElementById('box-form');
+    const status = document.getElementById('box-status');
+
+    // Form behaviour (plain DOM, so it stays interactive)
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const d = new FormData(form);
+      status.textContent = `Added ${d.get('qty')} x ${d.get('roast')} roast for ${d.get('name')}!`;
+    });
+    form.addEventListener('reset', () => { status.textContent = ''; });
+
+    // Box dimensions in CSS px (world units == px at z = 0)
+    const FORM_W = 260, FORM_H = 320;
+    const BOX_W = 320, BOX_H = 400, BOX_D = 240;
+    const CAM_DIST = 1100;
+
+    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
+    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
+    const scene = new THREE.Scene();
+    const camera = new THREE.PerspectiveCamera(30, 1, 10, 5000);
+    camera.position.set(0, 0, CAM_DIST);
+
+    scene.add(new THREE.AmbientLight(0xffffff, 1.1));
+    const key = new THREE.DirectionalLight(0xffffff, 2);
+    key.position.set(300, 500, 800);
+    scene.add(key);
+
+    function faceTexture(draw) {
+      const c = document.createElement('canvas');
+      c.width = c.height = 512;
+      const g = c.getContext('2d');
+      g.fillStyle = '#c8a47a';
+      g.fillRect(0, 0, 512, 512);
+      draw(g);
+      const t = new THREE.CanvasTexture(c);
+      t.colorSpace = THREE.SRGBColorSpace;
+      return t;
+    }
+    const label = (text, size) => (g) => {
+      g.fillStyle = '#4e342e';
+      g.font = `bold ${size}px sans-serif`;
+      g.textAlign = 'center';
+      g.textBaseline = 'middle';
+      g.fillText(text, 256, 256);
+    };
+    const mat = (map) => new THREE.MeshStandardMaterial({ map, roughness: 0.9 });
+    const plain = mat(faceTexture(() => {}));
+    const materials = [
+      mat(faceTexture(label('DAILY GRIND', 64))), // +x
+      mat(faceTexture(label('FRESH ROAST', 64))), // -x
+      plain,                                       // +y
+      plain,                                       // -y
+      plain,                                       // +z (front: carries the HTML form)
+      mat(faceTexture((g) => {                     // -z
+        label('THE DAILY', 70)(g);
+        g.fillText('GRIND', 256, 340);
+      })),
+    ];
+    const box = new THREE.Mesh(new THREE.BoxGeometry(BOX_W, BOX_H, BOX_D), materials);
+    scene.add(box);
+
+    // Matrix helpers for mapping the DOM form onto the box's front face
+    const flipY = new THREE.Matrix4().makeScale(1, -1, 1);
+    const toCenter = new THREE.Matrix4().makeTranslation(-FORM_W / 2, -FORM_H / 2, 0);
+    // +0.5px so the form sits just in front of the face
+    const toFace = new THREE.Matrix4().makeTranslation(0, 0, BOX_D / 2 + 0.5);
+    const m = new THREE.Matrix4();
+
+    function resize() {
+      const w = scene3d.clientWidth, h = scene3d.clientHeight;
+      renderer.setSize(w, h, false);
+      camera.fov = THREE.MathUtils.radToDeg(2 * Math.atan(h / 2 / CAM_DIST));
+      camera.aspect = w / h;
+      camera.updateProjectionMatrix();
+      box.scale.setScalar(Math.min(1, w / 520));
+      scene3d.style.perspective = CAM_DIST + 'px';
+    }
+    new ResizeObserver(resize).observe(scene3d);
+    resize();
+
+    let last = performance.now();
+    function frame(now) {
+      const dt = (now - last) / 1000;
+      last = now;
+      // Pause the spin while the user is typing so the form is easy to use
+      if (!form.matches(':focus-within')) box.rotation.y += dt * 0.5;
+      box.updateMatrixWorld();
+
+      // CSS matrix: css-flip * world * face offset * css->world flip * center form
+      m.copy(flipY).multiply(box.matrixWorld).multiply(toFace)
+        .multiply(flipY).multiply(toCenter);
+      form.style.transform = `matrix3d(${m.elements.join(',')})`;
+
+      renderer.render(scene, camera);
+      scene3d.classList.add('ready');
+      requestAnimationFrame(frame);
+    }
+    requestAnimationFrame(frame);
+  </script>
+
 </body>
 
