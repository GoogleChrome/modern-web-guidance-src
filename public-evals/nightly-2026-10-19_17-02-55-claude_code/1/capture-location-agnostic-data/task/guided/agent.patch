+  <script type="module">
+    // Temporal is not available in Safari yet; load the polyfill when missing.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    // Both values are wall-clock/calendar values with no time zone. They are stored
+    // as plain ISO strings ("HH:MM", "YYYY-MM-DD") and only ever parsed into
+    // Temporal.PlainTime / Temporal.PlainDate, so travel never shifts them.
+    const STORAGE_KEY = 'daily-grind-prefs';
+    const form = document.getElementById('prefs-form');
+    const summary = document.getElementById('prefs-summary');
+    const timeInput = document.getElementById('pickup-time');
+    const dateInput = document.getElementById('anniversary');
+
+    function render({ pickupTime, anniversary }) {
+      const time = Temporal.PlainTime.from(pickupTime);
+      const date = Temporal.PlainDate.from(anniversary);
+      summary.textContent =
+        `Pickup reminder at ${time.toLocaleString(undefined, { timeStyle: 'short' })} every day, ` +
+        `coffee anniversary on ${date.toLocaleString(undefined, { dateStyle: 'long' })}.`;
+    }
+
+    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? 'null');
+    if (saved) {
+      timeInput.value = saved.pickupTime;
+      dateInput.value = saved.anniversary;
+      render(saved);
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const prefs = { pickupTime: timeInput.value, anniversary: dateInput.value };
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
+      render(prefs);
+    });
+  </script>
+
 </body>
 
 </html>
