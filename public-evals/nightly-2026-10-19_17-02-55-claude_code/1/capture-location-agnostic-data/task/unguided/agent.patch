+  <script>
+    // Both values are "floating": stored and displayed as the plain strings the
+    // user picked ("HH:MM" and "YYYY-MM-DD"). They are never converted through
+    // Date/UTC, so travel or time zone changes cannot shift them.
+    (function () {
+      var KEY = 'dailyGrindPrefs';
+      var form = document.getElementById('prefs-form');
+      var timeInput = document.getElementById('pickup-time');
+      var dateInput = document.getElementById('coffee-anniversary');
+      var summary = document.getElementById('prefs-summary');
+      var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
+        'August', 'September', 'October', 'November', 'December'];
+
+      function formatTime(value) {
+        var parts = value.split(':');
+        var h = parseInt(parts[0], 10);
+        return ((h + 11) % 12 + 1) + ':' + parts[1] + ' ' + (h < 12 ? 'AM' : 'PM');
+      }
+
+      function formatDate(value) {
+        var parts = value.split('-');
+        return MONTHS[parseInt(parts[1], 10) - 1] + ' ' + parseInt(parts[2], 10) + ', ' + parts[0];
+      }
+
+      function render(prefs) {
+        summary.textContent = prefs
+          ? 'Pickup reminder: ' + formatTime(prefs.time) + ' every day (local time, wherever you are). ' +
+            'Coffee anniversary: ' + formatDate(prefs.date) + '.'
+          : '';
+      }
+
+      var saved = null;
+      try { saved = JSON.parse(localStorage.getItem(KEY)); } catch (e) { }
+      if (saved && saved.time && saved.date) {
+        timeInput.value = saved.time;
+        dateInput.value = saved.date;
+        render(saved);
+      }
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var prefs = { time: timeInput.value, date: dateInput.value };
+        try { localStorage.setItem(KEY, JSON.stringify(prefs)); } catch (err) { }
+        render(prefs);
+      });
+    })();
+  </script>
 </body>
 
