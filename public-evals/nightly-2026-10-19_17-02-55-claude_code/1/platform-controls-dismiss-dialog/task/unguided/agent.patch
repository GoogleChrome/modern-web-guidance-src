+  <script>
+    document.querySelectorAll('[data-modal]').forEach((button) => {
+      button.addEventListener('click', () => {
+        document.getElementById(button.dataset.modal).showModal();
+      });
+    });
+
+    document.querySelectorAll('.details-modal').forEach((dialog) => {
+      // Escape is handled natively by showModal().
+      dialog.querySelector('[data-close]').addEventListener('click', () => dialog.close());
+
+      // Clicks on the backdrop target the dialog itself; clicks inside hit .modal-content or its children.
+      dialog.addEventListener('click', (event) => {
+        if (event.target === dialog) dialog.close();
+      });
+    });
+  </script>
