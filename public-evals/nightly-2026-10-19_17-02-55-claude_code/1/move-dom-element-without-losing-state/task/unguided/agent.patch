+  <script>
+    (function () {
+      var hero = document.querySelector('.hero');
+      var heroSlot = document.getElementById('hero-video-slot');
+      var home = document.getElementById('video-home');
+      var iframe = document.getElementById('roast-video');
+      var button = document.getElementById('theater-toggle');
+      var theater = false;
+
+      // Chrome 133+ moveBefore() relocates a node without reloading the iframe.
+      var canMoveAtomically = typeof Element.prototype.moveBefore === 'function';
+
+      // Fallback: appendChild() reloads the iframe, so track playback with the
+      // YouTube IFrame API and restore time/state after the reload.
+      var player = null;
+      var apiReady = null;
+
+      function loadApi() {
+        if (apiReady) return apiReady;
+        apiReady = new Promise(function (resolve) {
+          var prev = window.onYouTubeIframeAPIReady;
+          window.onYouTubeIframeAPIReady = function () {
+            if (prev) prev();
+            resolve();
+          };
+          var tag = document.createElement('script');
+          tag.src = 'https://www.youtube.com/iframe_api';
+          document.head.appendChild(tag);
+        });
+        return apiReady;
+      }
+
+      function createPlayer(onReady) {
+        player = new YT.Player(iframe, { events: { onReady: onReady } });
+      }
+
+      if (!canMoveAtomically) {
+        loadApi().then(function () { createPlayer(); });
+      }
+
+      function moveTo(target) {
+        if (canMoveAtomically) {
+          target.moveBefore(iframe, null);
+          return;
+        }
+
+        var snapshot = null;
+        if (player && typeof player.getCurrentTime === 'function') {
+          snapshot = {
+            time: player.getCurrentTime(),
+            playing: player.getPlayerState() === YT.PlayerState.PLAYING
+          };
+          player.destroy();
+          player = null;
+        }
+
+        target.appendChild(iframe); // iframe reloads here
+
+        loadApi().then(function () {
+          createPlayer(function () {
+            if (!snapshot) return;
+            if (snapshot.playing) {
+              player.seekTo(snapshot.time, true);
+              player.playVideo();
+            } else {
+              // Cue at the saved position without starting playback.
+              player.cueVideoById({ videoId: 'N6BJVM5tvnw', startSeconds: snapshot.time });
+            }
+          });
+        });
+      }
+
+      button.addEventListener('click', function () {
+        theater = !theater;
+        hero.classList.toggle('theater', theater);
+        moveTo(theater ? heroSlot : home);
+        button.textContent = theater ? 'Exit Theater Mode' : 'Theater Mode';
+        button.setAttribute('aria-pressed', String(theater));
+        if (theater) hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
+      });
+    })();
+  </script>
+
