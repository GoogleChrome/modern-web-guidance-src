+  <script>
+    const video = document.getElementById('roast-video');
+    const mainSlot = document.getElementById('main-video-slot');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const toggle = document.getElementById('theater-toggle');
+    let theater = false;
+
+    function moveTo(parent) {
+      // moveBefore() keeps the iframe loaded and playing. Browsers without it
+      // (e.g. Safari) fall back to insertBefore(), which reloads the iframe.
+      if ('moveBefore' in Element.prototype) {
+        try {
+          parent.moveBefore(video, null);
+          return;
+        } catch {
+          // fall through to the traditional move
+        }
+      }
+      parent.insertBefore(video, null);
+    }
+
+    toggle.addEventListener('click', () => {
+      theater = !theater;
+      // Unhide the destination before moving so the iframe is never in a display:none tree.
+      (theater ? heroSlot : mainSlot).hidden = false;
+      moveTo(theater ? heroSlot : mainSlot);
+      (theater ? mainSlot : heroSlot).hidden = true;
+      toggle.setAttribute('aria-pressed', String(theater));
+      toggle.textContent = theater ? 'Exit theater mode' : 'Theater mode';
+      if (theater) heroSlot.scrollIntoView({ behavior: 'smooth', block: 'center' });
+    });
+  </script>
