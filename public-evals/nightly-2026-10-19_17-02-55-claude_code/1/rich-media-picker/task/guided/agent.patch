+    /* Roast picker (customizable select) */
+    .roast-picker {
+      margin-top: 1.5rem;
+      width: min(100%, 360px);
+      text-align: left;
+    }
+
+    .roast-picker label {
+      display: block;
+      font-size: 0.85rem;
+      font-weight: 600;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      margin-bottom: 6px;
+    }
+
+    .roast-select,
+    .roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .roast-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      padding: 10px 14px;
+      background: white;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .roast-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .roast-select::picker(select) {
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 6px;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
+      width: anchor-size(width);
+    }
+
+    .roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px;
+      border-radius: 6px;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    .roast-select option::checkmark {
+      display: none;
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus-visible {
+      background: #f3ece9;
+    }
+
+    .roast-select option:checked {
+      background: var(--primary);
+      color: white;
+    }
+
+    .roast-select option:checked .option-title {
+      font-weight: 700;
+    }
+
+    .roast-select svg {
+      flex: none;
+      width: 28px;
+      height: 28px;
+    }
+
+    .roast-select .option-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .roast-select .option-title {
+      font-weight: 600;
+    }
+
+    .roast-select .option-desc {
+      font-size: 0.8rem;
+      opacity: 0.75;
+    }
+
+    .roast-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+    }
+
+    .roast-select selectedcontent .option-desc {
+      display: none;
+    }
