+  <script>
+    (function () {
+      var toggle = document.getElementById('roast-toggle');
+      var menu = document.getElementById('roast-menu');
+      var picker = document.getElementById('roast-picker');
+      var current = toggle.querySelector('.roast-current');
+      var options = Array.prototype.slice.call(menu.querySelectorAll('[role="option"]'));
+      var activeIndex = -1;
+
+      function setActive(i) {
+        activeIndex = (i + options.length) % options.length;
+        options.forEach(function (o, n) { o.classList.toggle('active', n === activeIndex); });
+        menu.setAttribute('aria-activedescendant', options[activeIndex].id);
+        options[activeIndex].scrollIntoView({ block: 'nearest' });
+      }
+
+      function open(focusIndex) {
+        menu.hidden = false;
+        toggle.setAttribute('aria-expanded', 'true');
+        menu.focus();
+        var sel = options.findIndex(function (o) { return o.getAttribute('aria-selected') === 'true'; });
+        setActive(focusIndex !== undefined ? focusIndex : Math.max(sel, 0));
+      }
+
+      function close(returnFocus) {
+        menu.hidden = true;
+        toggle.setAttribute('aria-expanded', 'false');
+        menu.removeAttribute('aria-activedescendant');
+        if (returnFocus) toggle.focus();
+      }
+
+      function select(i) {
+        options.forEach(function (o, n) { o.setAttribute('aria-selected', n === i ? 'true' : 'false'); });
+        var opt = options[i];
+        current.innerHTML = '';
+        var icon = opt.querySelector('svg').cloneNode(true);
+        icon.setAttribute('width', '28');
+        icon.setAttribute('height', '28');
+        icon.removeAttribute('class');
+        icon.style.flex = 'none';
+        icon.style.color = 'var(--primary)';
+        var title = document.createElement('span');
+        title.className = 'roast-title';
+        title.textContent = opt.querySelector('.roast-title').textContent;
+        current.appendChild(icon);
+        current.appendChild(title);
+        picker.dataset.value = opt.dataset.value;
+        close(true);
+      }
+
+      toggle.addEventListener('click', function () { menu.hidden ? open() : close(); });
+      toggle.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); open(); }
+      });
+
+      options.forEach(function (o, i) {
+        o.addEventListener('click', function () { select(i); });
+        o.addEventListener('mousemove', function () { setActive(i); });
+      });
+
+      menu.addEventListener('keydown', function (e) {
+        switch (e.key) {
+          case 'ArrowDown': e.preventDefault(); setActive(activeIndex + 1); break;
+          case 'ArrowUp': e.preventDefault(); setActive(activeIndex - 1); break;
+          case 'Home': e.preventDefault(); setActive(0); break;
+          case 'End': e.preventDefault(); setActive(options.length - 1); break;
+          case 'Enter':
+          case ' ': e.preventDefault(); select(activeIndex); break;
+          case 'Escape': e.preventDefault(); close(true); break;
+          case 'Tab': close(); break;
+        }
+      });
+
+      document.addEventListener('click', function (e) {
+        if (!picker.contains(e.target)) close();
+      });
+    })();
+  </script>
