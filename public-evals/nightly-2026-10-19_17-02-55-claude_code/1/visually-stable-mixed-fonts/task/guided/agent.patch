diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,55 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Mixed Fonts</title>
+  <style>
+    body {
+      font-family: system-ui, sans-serif;
+      max-width: 40rem;
+      margin: 2rem auto;
+      padding: 0 1rem;
+    }
+
+    #mixed-fonts-container {
+      font-family: Verdana, sans-serif;
+      /* Take the x-height ratio of the primary font and apply it to nested fonts */
+      font-size-adjust: from-font;
+    }
+
+    #mixed-fonts-container code {
+      font-family: "Courier New", monospace;
+    }
+
+    #independent-theme-container {
+      font-family: Times, "Times New Roman", serif;
+      /* Numeric override: x-height / font-size ratio of the primary theme font */
+      font-size-adjust: 0.51;
+      padding: 1rem;
+      border: 1px solid currentColor;
+    }
+
+    @supports not (font-size-adjust: from-font) {
+      #mixed-fonts-container code {
+        font-size: 0.9em;
+      }
+
+      #independent-theme-container {
+        font-size: 1.1rem;
+      }
+    }
+  </style>
+</head>
+<body>
+  <p id="mixed-fonts-container">
+    Regular text in Verdana mixed with inline code like
+    <code>const x = document.querySelector("p");</code>
+    keeps a consistent visual height.
+  </p>
+
+  <div id="independent-theme-container">
+    This independent theme uses a different font family, normalized with a fixed numeric <code>font-size-adjust</code> value.
+  </div>
+</body>
+</html>
