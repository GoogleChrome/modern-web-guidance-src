+    /* Smoothly animate to/from intrinsic sizes (Chromium; others jump instantly) */
+    :root {
+      interpolate-size: allow-keywords;
+    }
+
+    /* Promo alert */
+    #promo-alert {
+      background: var(--accent);
+      color: var(--text);
+      block-size: auto;
+      overflow: hidden;
+      transition: block-size 0.4s ease-in-out, opacity 0.4s ease-in-out, visibility 0.4s;
+    }
+
+    .promo-inner {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 1rem;
+      padding: 0.75rem 5%;
+      text-align: center;
+    }
+
+    #alert-dismiss {
+      background: none;
+      border: 0;
+      color: inherit;
+      font-size: 1.5rem;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    /* Hidden state holder: the dismiss button toggles it via popovertarget */
+    #alert-state {
+      display: none;
+    }
+
+    #promo-alert:has(#alert-state:popover-open) {
+      block-size: 0;
+      opacity: 0;
+      visibility: hidden;
+    }
+
+    /* FAQ accordion */
+    .faq {
+      max-width: 700px;
+      margin: 40px auto 0;
+    }
+
+    .faq details {
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    #faq-trigger {
+      padding: 15px 20px;
+      font-weight: bold;
+      color: var(--primary);
+      cursor: pointer;
+    }
+
+    #faq-content {
+      padding: 0 20px 15px;
+    }
+
+    .faq details::details-content {
+      block-size: 0;
+      overflow: hidden;
+      transition: block-size 0.4s ease, content-visibility 0.4s;
+      transition-behavior: allow-discrete;
+    }
+
+    .faq details[open]::details-content {
+      block-size: auto;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #promo-alert,
+      .faq details::details-content {
+        transition: none;
+      }
+    }
   </style>
 </head>
 
