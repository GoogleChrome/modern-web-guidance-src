+    /* Floating draggable promo */
+    .floating-promo {
+      position: fixed;
+      right: 24px;
+      bottom: 24px;
+      width: 220px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
+      z-index: 2000;
+      overflow: hidden;
+      touch-action: none;
+    }
+
+    .floating-promo.dragging {
+      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
+    }
+
+    .floating-promo-handle {
+      background: var(--primary);
+      color: white;
+      font-size: 0.8rem;
+      padding: 6px 12px;
+      cursor: grab;
+      user-select: none;
+    }
+
+    .floating-promo.dragging .floating-promo-handle {
+      cursor: grabbing;
+    }
+
+    .floating-promo-body {
