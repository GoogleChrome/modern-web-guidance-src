     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var message = document.getElementById('newsletter-message');
+
+      function showValidity() {
+        var invalid = !input.checkValidity();
+        input.classList.add('touched');
+        input.setAttribute('aria-invalid', invalid);
+        message.classList.toggle('error', invalid);
+        if (invalid) {
+          message.textContent = input.validity.valueMissing
+            ? 'Please enter your email address.'
+            : 'Please enter a valid email address.';
+        } else {
+          message.textContent = '';
+        }
+        return !invalid;
+      }
+
+      // Validate only after the user leaves the field.
+      input.addEventListener('blur', showValidity);
+
+      // Once an error is showing, clear it as soon as the input becomes valid,
+      // but never introduce an error while typing.
+      input.addEventListener('input', function () {
+        if (input.classList.contains('touched') && input.checkValidity()) {
+          showValidity();
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        if (!showValidity()) {
+          input.focus();
+          return;
+        }
+        // No backend yet: confirm to the user and reset.
+        form.reset();
+        input.classList.remove('touched');
+        input.removeAttribute('aria-invalid');
+        message.textContent = 'Thanks for subscribing!';
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
