diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -134,8 +134,98 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Info button + tooltip */
+    .card-actions {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 10px;
+      margin-top: 15px;
+    }
+
+    .card-actions .btn {
+      margin-top: 0;
+    }
+
+    .info-btn {
+      width: 2rem;
+      height: 2rem;
+      border: 2px solid var(--primary);
+      border-radius: 50%;
+      background: white;
+      color: var(--primary);
+      font: bold 1rem/1 serif;
+      cursor: pointer;
+    }
+
+    .info-btn:hover,
+    .info-btn:focus-visible {
+      background: var(--primary);
+      color: white;
+    }
+
+    @supports (anchor-name: --a) {
+      #tooltip {
+        inset: auto;
+        margin: unset;
+      }
+    }
+
+    #tooltip {
+      position: fixed;
+      position-area: block-start;
+      position-try-fallbacks: flip-block;
+      container-type: anchored;
+      background: transparent;
+      border: 0;
+      padding: 0;
+      overflow: visible;
+    }
+
+    .tooltip-content {
+      position: relative;
+      max-width: 16rem;
+      padding: 0.6rem 0.9rem;
+      border-radius: 0.5rem 0.5rem 0.5rem 0.5rem;
+      margin-block-end: 0.6rem; /* room for the arrow below */
+      background: var(--primary);
+      color: white;
+      font-size: 0.85rem;
+      text-align: start;
+    }
+
+    @supports (container-type: anchored) {
+      .tooltip-content::before {
+        /* Default: tooltip sits above, arrow points down */
+        content: "";
+        position: absolute;
+        inset-inline-start: 50%;
+        inset-block-end: -0.5rem;
+        translate: -50% 0;
+        inline-size: 1rem;
+        block-size: 0.5rem;
+        background: var(--primary);
+        clip-path: polygon(0 0, 100% 0, 50% 100%);
+      }
+
+      /* Flipped below the anchor: arrow points up, radius and margins swap */
+      @container anchored(fallback: flip-block) {
+        .tooltip-content {
+          border-radius: 0 0 0.5rem 0.5rem;
+          margin-block-end: 0;
+          margin-block-start: 0.6rem;
+        }
+
+        .tooltip-content::before {
+          inset-block-end: auto;
+          inset-block-start: -0.5rem;
+          clip-path: polygon(50% 0, 100% 100%, 0 100%);
+        }
+      }
+    }
+
     footer {
