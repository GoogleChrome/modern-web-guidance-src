+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackInput = document.getElementById('feedback-input');
+    const feedbackStatus = feedbackForm.querySelector('.feedback-status');
+
+    // Enter sends, Shift+Enter inserts a newline.
+    feedbackInput.addEventListener('keydown', (event) => {
+      if (event.key === 'Enter' && !event.shiftKey) {
+        event.preventDefault();
+        // Enter confirms IME composition; don't submit mid-conversion (keyCode 229 covers Safari).
+        if (event.isComposing || event.keyCode === 229) return;
+        feedbackForm.requestSubmit();
+      }
+    });
+
+    feedbackForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // TODO: send feedbackInput.value to a backend endpoint.
+      feedbackForm.reset();
+      feedbackStatus.textContent = 'Thanks for your feedback!';
+    });
+  </script>
