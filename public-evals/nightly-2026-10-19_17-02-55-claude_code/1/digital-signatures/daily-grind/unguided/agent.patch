diff --git a/signing-ui.js b/signing-ui.js
new file mode 100644
index 0000000..01312cd
--- /dev/null
+++ b/signing-ui.js
@@ -0,0 +1,198 @@
+import * as S from './signing.js';
+
+const $ = (id) => document.getElementById(id);
+const enc = new TextEncoder();
+
+// ---------- result rendering (textContent only; inputs may be attacker-controlled) ----------
+function show(el, { ok, title, details = {} }) {
+  el.replaceChildren();
+  const box = document.createElement('div');
+  box.className = 'result ' + (ok === true ? 'ok' : ok === false ? 'bad' : '');
+  const strong = document.createElement('strong');
+  strong.className = ok ? 'ok' : 'bad';
+  strong.textContent = title;
+  box.append(strong);
+  const dl = document.createElement('dl');
+  for (const [k, v] of Object.entries(details)) {
+    if (v === undefined) continue;
+    const dt = document.createElement('dt');
+    dt.textContent = k;
+    const dd = document.createElement('dd');
+    const code = document.createElement('code');
+    code.textContent = typeof v === 'string' ? v : JSON.stringify(v);
+    dd.append(code);
+    dl.append(dt, dd);
+  }
+  if (dl.children.length) box.append(dl);
+  el.append(box);
+}
+
+const fail = (el, e) => show(el, { ok: false, title: e.message || String(e) });
+
+async function guarded(el, fn) {
+  try { await fn(); } catch (e) { fail(el, e); }
+}
+
+// ---------- tabs ----------
+for (const tab of document.querySelectorAll('.tab')) {
+  tab.addEventListener('click', () => {
+    for (const t of document.querySelectorAll('.tab')) {
+      t.setAttribute('aria-selected', String(t === tab));
+      $('panel-' + t.dataset.panel).hidden = t !== tab;
+    }
+  });
+}
+
+// ---------- keys ----------
+const algSelect = $('alg');
+for (const [id, a] of Object.entries(S.ALGORITHMS)) {
+  const opt = document.createElement('option');
+  opt.value = id;
+  opt.textContent = a.label;
+  algSelect.append(opt);
+}
+algSelect.value = 'ES256';
+
+function updateAlgNote() {
+  const a = S.ALGORITHMS[algSelect.value];
+  $('alg-note').textContent = a.pq
+    ? 'Post-quantum: believed secure against quantum computers. Keys and signatures are much larger. Requires loading a library on first use.'
+    : 'Classical: secure today, but breakable by a large-scale quantum computer.';
+}
+algSelect.addEventListener('change', updateAlgNote);
+updateAlgNote();
+
+S.probeSupport().then((support) => {
+  for (const opt of algSelect.options) {
+    if (!support[opt.value]) {
+      opt.disabled = true;
+      opt.textContent += ' (not supported by this browser)';
+    }
+  }
+});
+
+$('gen').addEventListener('click', () => guarded($('keys-result'), async () => {
+  $('gen').disabled = true;
+  try {
+    const pair = await S.generateKeyPair(algSelect.value);
+    $('pub').value = pair.publicKey;
+    $('priv').value = pair.privateKey;
+    // Convenience: prefill the other tabs.
+    $('sign-priv').value = pair.privateKey;
+    $('verify-pub').value = pair.publicKey;
+    $('fp').textContent = await S.fingerprint(pair.publicKey);
+    show($('keys-result'), { ok: true, title: `Generated ${pair.alg} key pair`, details: {
+      'Public key size': `${pair.publicKey.length} chars`,
+      'Private key size': `${pair.privateKey.length} chars`,
+    } });
+  } finally { $('gen').disabled = false; }
+}));
+
+$('pub').addEventListener('input', async () => {
+  try { $('fp').textContent = await S.fingerprint($('pub').value); } catch { $('fp').textContent = '—'; }
+});
+
+// ---------- mode switching ----------
+function bindMode(selectId, groups) {
+  const sel = $(selectId);
+  const apply = () => { for (const [mode, ids] of Object.entries(groups)) for (const id of ids) $(id).hidden = mode !== sel.value; };
+  sel.addEventListener('change', apply);
+  apply();
+  return sel;
+}
+const signMode = bindMode('sign-mode', { message: ['sign-message'], token: ['sign-token'], file: ['sign-file'] });
+const verifyMode = bindMode('verify-mode', {
+  message: ['verify-message', 'verify-bundle'],
+  file: ['verify-file', 'verify-bundle'],
+  token: ['verify-token'],
+});
+
+const readFile = async (input) => {
+  const f = input.files[0];
+  if (!f) throw new Error('Choose a file first.');
+  return { bytes: new Uint8Array(await f.arrayBuffer()), name: f.name };
+};
+
+// ---------- sign ----------
+let lastSignedBytes; // enables the verify-tab "tamper" demo
+
+$('sign').addEventListener('click', () => guarded($('sign-result'), async () => {
+  const priv = $('sign-priv').value.trim();
+  if (!priv) throw new Error('Paste or generate a private key first.');
+  const pub = $('pub').value.trim() || undefined;
+  const alg = S.keyAlgorithm(priv);
+  $('sign').disabled = true;
+  try {
+    const t0 = performance.now();
+    let out, details = {};
+    if (signMode.value === 'token') {
+      let claims;
+      try { claims = JSON.parse($('claims').value); } catch { throw new Error('Claims must be valid JSON.'); }
+      if (claims === null || typeof claims !== 'object' || Array.isArray(claims)) throw new Error('Claims must be a JSON object.');
+      const ttl = Number($('ttl').value);
+      out = await S.signToken(priv, claims, { expiresInSec: ttl > 0 ? ttl : undefined });
+      $('vtoken').value = out;
+      details = { 'Token length': `${out.length} chars` };
+    } else {
+      let bytes, name = '';
+      if (signMode.value === 'file') ({ bytes, name } = await readFile($('file')));
+      else bytes = enc.encode($('msg').value);
+      out = await S.signArtifact(priv, pub, bytes, name);
+      $('bundle').value = out;
+      if (signMode.value === 'message') $('vmsg').value = $('msg').value;
+      details = { 'Signature size': `${S.b64uDecode(JSON.parse(out).signature).length} bytes`, SHA256: JSON.parse(out).sha256 };
+    }
+    $('out').value = out;
+    $('copy-out').hidden = false;
+    details.Time = `${(performance.now() - t0).toFixed(1)} ms`;
+    show($('sign-result'), { ok: true, title: `Signed with ${alg}`, details });
+  } finally { $('sign').disabled = false; }
+}));
+
+$('copy-out').addEventListener('click', async () => {
+  await navigator.clipboard.writeText($('out').value);
+  $('copy-out').textContent = 'Copied!';
+  setTimeout(() => { $('copy-out').textContent = 'Copy output'; }, 1500);
+});
+
+// ---------- verify ----------
+$('verify').addEventListener('click', () => guarded($('verify-result'), async () => {
+  const pub = $('verify-pub').value.trim();
+  if (!pub) throw new Error('Paste the signer\'s public key first.');
+  const out = $('verify-result');
+
+  if (verifyMode.value === 'token') {
+    const r = await S.verifyToken(pub, $('vtoken').value);
+    const ok = r.valid && !r.expired;
+    show(out, {
+      ok,
+      title: !r.valid ? 'INVALID: signature does not match' : r.expired ? 'Signature valid, but token has EXPIRED' : 'VALID: token is authentic',
+      details: { Algorithm: r.header.alg, Claims: r.claims, Expires: r.claims.exp ? new Date(r.claims.exp * 1000).toISOString() : undefined },
+    });
+    return;
+  }
+
+  const bytes = verifyMode.value === 'file' ? (await readFile($('vfile'))).bytes : enc.encode($('vmsg').value);
+  const r = await S.verifyArtifact(pub, bytes, $('bundle').value);
+  show(out, {
+    ok: r.valid,
+    title: r.valid ? 'VALID: data is intact and signed by this key' : 'INVALID: data or signature was altered, or the wrong key was used',
+    details: {
+      Algorithm: r.alg,
+      SHA256: r.digest,
+      'Digest matches bundle': r.digestMatchesBundle === undefined ? undefined : String(r.digestMatchesBundle),
+      'Key fingerprint': r.keyFingerprint,
+      'Fingerprint matches bundle': r.keyFingerprintMatchesBundle === undefined ? undefined : String(r.keyFingerprintMatchesBundle),
+      Signed: r.created,
+    },
+  });
+}));
+
+// Demo helper: flip the last character of the message/token so users can watch verification fail.
+$('tamper').hidden = false;
+$('tamper').addEventListener('click', () => {
+  const el = verifyMode.value === 'token' ? $('vtoken') : $('vmsg');
+  if (!el.value) return;
+  const last = el.value.slice(-1);
+  el.value = el.value.slice(0, -1) + (last === 'x' ? 'y' : 'x');
+});
