+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Signing Desk | The Daily Grind</title>
+  <style>
+    :root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+      --ok: #2e7d32;
+      --bad: #c62828;
+    }
+
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+    }
+
+    nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+    }
+
+    nav a { color: white; text-decoration: none; font-size: 0.9rem; }
+    nav a:hover { color: var(--accent); }
+    .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+
+    .container { max-width: 900px; margin: 40px auto; padding: 0 20px; }
+    h1 { color: var(--primary); }
+    .lead { margin: 8px 0 24px; }
+
+    .card {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      margin-bottom: 20px;
+    }
+
+    .card h2 { color: var(--primary); font-size: 1.2rem; margin-bottom: 10px; }
+
+    .tabs { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
+    .tab {
+      background: var(--secondary);
+      color: var(--text);
+      border: 0;
+      padding: 10px 18px;
+      border-radius: 5px;
+      cursor: pointer;
+      font: inherit;
+    }
+    .tab[aria-selected="true"] { background: var(--primary); color: white; }
+
+    label { display: block; font-weight: 600; font-size: 0.9rem; margin: 12px 0 4px; }
+
+    textarea, select, input[type="text"], input[type="number"] {
+      width: 100%;
+      padding: 8px 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 5px;
+      font: inherit;
+      background: white;
+      color: var(--text);
+    }
+
+    textarea { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.8rem; min-height: 110px; resize: vertical; }
+
+    .btn {
+      background: var(--primary);
+      color: white;
+      padding: 10px 20px;
+      border: 0;
+      border-radius: 5px;
+      margin-top: 15px;
+      cursor: pointer;
+      font: inherit;
+      transition: background 0.3s;
+    }
+    .btn:hover { background: #3e2723; }
+    .btn.secondary { background: var(--secondary); color: var(--text); margin-left: 6px; }
+    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
+
+    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
+    @media (max-width: 700px) { .row { grid-template-columns: 1fr; } }
+
+    .result { margin-top: 14px; padding: 12px 14px; border-radius: 6px; border-left: 5px solid var(--secondary); background: #f5f0ee; word-break: break-word; }
+    .result.ok { border-color: var(--ok); }
+    .result.bad { border-color: var(--bad); }
+    .result strong.ok { color: var(--ok); }
+    .result strong.bad { color: var(--bad); }
+    .result dl { display: grid; grid-template-columns: max-content 1fr; gap: 2px 12px; font-size: 0.85rem; margin-top: 6px; }
+    .result dt { font-weight: 600; }
+    .result code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.8rem; }
+
+    .note { font-size: 0.85rem; opacity: 0.85; margin-top: 8px; }
+    .pq { display: inline-block; background: var(--accent); color: var(--text); font-size: 0.7rem; font-weight: 700; padding: 1px 6px; border-radius: 4px; vertical-align: middle; }
+
+    [hidden] { display: none !important; }
+
+    footer { background: var(--secondary); text-align: center; padding: 30px 20px; margin-top: 40px; font-size: 0.85rem; }
+  </style>
+</head>
+
+<body>
+  <nav>
+    <div class="logo">THE DAILY GRIND</div>
+    <a href="/">&larr; Back to the shop</a>
+  </nav>
+
+  <main class="container">
+    <h1>Signing Desk</h1>
+    <p class="lead">Sign and verify messages, tokens and files entirely in your browser, with classical or
+      post-quantum <span class="pq">ML-DSA</span> keys. Keys and data never leave this page.</p>
+
+    <div class="tabs" role="tablist">
+      <button class="tab" role="tab" id="tab-keys" aria-selected="true" data-panel="keys">1. Keys</button>
+      <button class="tab" role="tab" id="tab-sign" aria-selected="false" data-panel="sign">2. Sign</button>
+      <button class="tab" role="tab" id="tab-verify" aria-selected="false" data-panel="verify">3. Verify</button>
+    </div>
+
+    <!-- KEYS -->
+    <section id="panel-keys" class="card" role="tabpanel" aria-labelledby="tab-keys">
+      <h2>Generate a key pair</h2>
+      <label for="alg">Algorithm</label>
+      <select id="alg"></select>
+      <p class="note" id="alg-note"></p>
+      <button class="btn" id="gen">Generate key pair</button>
+      <div class="row">
+        <div>
+          <label for="pub">Public key (share this)</label>
+          <textarea id="pub" spellcheck="false" placeholder="Generated public key appears here"></textarea>
+        </div>
+        <div>
+          <label for="priv">Private key (keep secret)</label>
+          <textarea id="priv" spellcheck="false" placeholder="Generated private key appears here"></textarea>
+        </div>
+      </div>
+      <p class="note">Fingerprint: <code id="fp">&mdash;</code></p>
+      <div id="keys-result" aria-live="polite"></div>
+    </section>
+
+    <!-- SIGN -->
+    <section id="panel-sign" class="card" role="tabpanel" aria-labelledby="tab-sign" hidden>
+      <h2>Sign</h2>
+      <label for="sign-mode">What do you want to sign?</label>
+      <select id="sign-mode">
+        <option value="message">Message (text)</option>
+        <option value="token">Token (JWT-style claims)</option>
+        <option value="file">File / artifact</option>
+      </select>
+
+      <div id="sign-message">
+        <label for="msg">Message</label>
+        <textarea id="msg" spellcheck="false">Order #1042: 2x Maple Oat Latte, 1x Cold Brew</textarea>
+      </div>
+      <div id="sign-token" hidden>
+        <label for="claims">Claims (JSON)</label>
+        <textarea id="claims" spellcheck="false">{ "sub": "customer-1042", "scope": "rewards:read" }</textarea>
+        <label for="ttl">Expires in (seconds, 0 = never)</label>
+        <input type="number" id="ttl" value="3600" min="0">
+      </div>
+      <div id="sign-file" hidden>
+        <label for="file">File</label>
+        <input type="file" id="file">
+      </div>
+
+      <label for="sign-priv">Private key</label>
+      <textarea id="sign-priv" spellcheck="false" placeholder="Paste a private key, or generate one on the Keys tab"></textarea>
+      <button class="btn" id="sign">Sign</button>
+      <button class="btn secondary" id="copy-out" hidden>Copy output</button>
+
+      <label for="out">Output (signature bundle or token)</label>
+      <textarea id="out" readonly spellcheck="false"></textarea>
+      <div id="sign-result" aria-live="polite"></div>
+    </section>
+
+    <!-- VERIFY -->
+    <section id="panel-verify" class="card" role="tabpanel" aria-labelledby="tab-verify" hidden>
+      <h2>Verify</h2>
+      <label for="verify-mode">What are you verifying?</label>
+      <select id="verify-mode">
+        <option value="message">Message + signature bundle</option>
+        <option value="token">Token</option>
+        <option value="file">File + signature bundle</option>
+      </select>
+
+      <div id="verify-message">
+        <label for="vmsg">Message</label>
+        <textarea id="vmsg" spellcheck="false"></textarea>
+      </div>
+      <div id="verify-file" hidden>
+        <label for="vfile">File</label>
+        <input type="file" id="vfile">
+      </div>
+      <div id="verify-bundle">
+        <label for="bundle">Signature bundle</label>
+        <textarea id="bundle" spellcheck="false"></textarea>
+      </div>
+      <div id="verify-token" hidden>
+        <label for="vtoken">Token</label>
+        <textarea id="vtoken" spellcheck="false"></textarea>
+      </div>
+
+      <label for="verify-pub">Public key</label>
+      <textarea id="verify-pub" spellcheck="false" placeholder="Paste the signer's public key"></textarea>
+      <button class="btn" id="verify">Verify</button>
+      <button class="btn secondary" id="tamper" hidden>Tamper with input (demo)</button>
+      <div id="verify-result" aria-live="polite"></div>
+    </section>
+  </main>
+
+  <footer>
+    <p>Classical signatures use the browser's WebCrypto API. Post-quantum signatures use ML-DSA (FIPS 204)
+      via <code>@noble/post-quantum</code>, loaded on demand.</p>
+  </footer>
+
+  <script type="module" src="signing-ui.js"></script>
+</body>
+
+</html>
