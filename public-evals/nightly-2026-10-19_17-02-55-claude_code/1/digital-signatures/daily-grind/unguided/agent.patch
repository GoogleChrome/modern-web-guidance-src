--- /dev/null
+++ b/signing.js
@@ -0,0 +1,225 @@
+// Browser-side digital signatures: classical (WebCrypto) and post-quantum (ML-DSA, FIPS 204).
+// Private keys never leave the page; nothing here performs network I/O except the lazy
+// import of the ML-DSA implementation.
+
+const NOBLE_PQ_URL = 'https://esm.sh/@noble/post-quantum@0.5.2/ml-dsa.js';
+
+export const ALGORITHMS = {
+  ES256: { label: 'ECDSA P-256 + SHA-256', kind: 'webcrypto', pq: false,
+    gen: { name: 'ECDSA', namedCurve: 'P-256' }, sign: { name: 'ECDSA', hash: 'SHA-256' } },
+  ES384: { label: 'ECDSA P-384 + SHA-384', kind: 'webcrypto', pq: false,
+    gen: { name: 'ECDSA', namedCurve: 'P-384' }, sign: { name: 'ECDSA', hash: 'SHA-384' } },
+  EdDSA: { label: 'Ed25519', kind: 'webcrypto', pq: false,
+    gen: { name: 'Ed25519' }, sign: { name: 'Ed25519' } },
+  PS256: { label: 'RSA-PSS 3072 + SHA-256', kind: 'webcrypto', pq: false,
+    gen: { name: 'RSA-PSS', modulusLength: 3072, publicExponent: new Uint8Array([1, 0, 1]), hash: 'SHA-256' },
+    sign: { name: 'RSA-PSS', saltLength: 32 } },
+  'ML-DSA-44': { label: 'ML-DSA-44 (post-quantum, NIST level 2)', kind: 'mldsa', pq: true, sigLen: 2420 },
+  'ML-DSA-65': { label: 'ML-DSA-65 (post-quantum, NIST level 3)', kind: 'mldsa', pq: true, sigLen: 3309 },
+  'ML-DSA-87': { label: 'ML-DSA-87 (post-quantum, NIST level 5)', kind: 'mldsa', pq: true, sigLen: 4627 },
+};
+
+const enc = new TextEncoder();
+const dec = new TextDecoder();
+
+// ---------- encoding helpers ----------
+export function b64uEncode(bytes) {
+  let s = '';
+  for (const b of bytes) s += String.fromCharCode(b);
+  return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function b64uDecode(str) {
+  const b64 = String(str).trim().replace(/-/g, '+').replace(/_/g, '/');
+  const bin = atob(b64 + '='.repeat((4 - (b64.length % 4)) % 4));
+  return Uint8Array.from(bin, (c) => c.charCodeAt(0));
+}
+
+export const toHex = (bytes) => [...bytes].map((b) => b.toString(16).padStart(2, '0')).join('');
+
+export async function sha256Hex(bytes) {
+  return toHex(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)));
+}
+
+function getAlg(alg) {
+  const a = ALGORITHMS[alg];
+  if (!a) throw new Error(`Unsupported algorithm: ${alg}`);
+  return a;
+}
+
+// ---------- ML-DSA loader (lazy) ----------
+let mldsaModule;
+async function loadMldsa(alg) {
+  mldsaModule ??= import(NOBLE_PQ_URL).catch((e) => {
+    mldsaModule = undefined;
+    throw new Error('Could not load the post-quantum library (are you offline?): ' + e.message);
+  });
+  const mod = await mldsaModule;
+  const impl = { 'ML-DSA-44': mod.ml_dsa44, 'ML-DSA-65': mod.ml_dsa65, 'ML-DSA-87': mod.ml_dsa87 }[alg];
+  if (!impl) throw new Error(`${alg} not provided by the loaded library`);
+  return impl;
+}
+
+// ---------- key (de)serialisation ----------
+// Keys are exchanged as small JSON envelopes so they can be pasted into a textarea:
+//   {"v":1,"alg":"ES256","type":"public","format":"jwk","key":{...}}
+//   {"v":1,"alg":"ML-DSA-65","type":"private","format":"raw","key":"<base64url>"}
+function envelope(alg, type, format, key) {
+  return JSON.stringify({ v: 1, alg, type, format, key }, null, 2);
+}
+
+function parseEnvelope(text, expectType) {
+  let env;
+  try { env = JSON.parse(text); } catch { throw new Error('Key is not valid JSON.'); }
+  if (!env || env.v !== 1 || !ALGORITHMS[env.alg]) throw new Error('Unrecognised key format or algorithm.');
+  if (env.type !== expectType) throw new Error(`Expected a ${expectType} key but got a ${env.type} key.`);
+  return env;
+}
+
+export function keyAlgorithm(text) {
+  try { return JSON.parse(text).alg; } catch { return undefined; }
+}
+
+// Resolve which algorithms this browser can actually run.
+export async function probeSupport() {
+  const out = {};
+  for (const [alg, a] of Object.entries(ALGORITHMS)) {
+    if (a.kind === 'mldsa') { out[alg] = true; continue; }
+    try {
+      await crypto.subtle.generateKey(a.gen.name === 'RSA-PSS' ? { ...a.gen, modulusLength: 2048 } : a.gen,
+        false, ['sign', 'verify']);
+      out[alg] = true;
+    } catch { out[alg] = false; }
+  }
+  return out;
+}
+
+export async function generateKeyPair(alg) {
+  const a = getAlg(alg);
+  if (a.kind === 'mldsa') {
+    const impl = await loadMldsa(alg);
+    const { publicKey, secretKey } = impl.keygen();
+    return {
+      alg,
+      publicKey: envelope(alg, 'public', 'raw', b64uEncode(publicKey)),
+      privateKey: envelope(alg, 'private', 'raw', b64uEncode(secretKey)),
+    };
+  }
+  const pair = await crypto.subtle.generateKey(a.gen, true, ['sign', 'verify']);
+  return {
+    alg,
+    publicKey: envelope(alg, 'public', 'jwk', await crypto.subtle.exportKey('jwk', pair.publicKey)),
+    privateKey: envelope(alg, 'private', 'jwk', await crypto.subtle.exportKey('jwk', pair.privateKey)),
+  };
+}
+
+export async function fingerprint(publicKeyText) {
+  const env = parseEnvelope(publicKeyText, 'public');
+  const canonical = env.format === 'jwk'
+    ? JSON.stringify(Object.fromEntries(Object.entries(env.key).filter(([k]) => ['kty', 'crv', 'x', 'y', 'n', 'e'].includes(k)).sort()))
+    : env.key;
+  return sha256Hex(enc.encode(`${env.alg}:${canonical}`));
+}
+
+// ---------- raw sign / verify ----------
+// noble-post-quantum changed argument order between releases; detect once per algorithm.
+const mldsaOrder = {};
+async function mldsaSign(alg, secretKey, msg) {
+  const impl = await loadMldsa(alg);
+  if (mldsaOrder[alg] === 'sk-first') return impl.sign(secretKey, msg);
+  if (mldsaOrder[alg] === 'msg-first') return impl.sign(msg, secretKey);
+  const expected = ALGORITHMS[alg].sigLen;
+  try {
+    const sig = impl.sign(msg, secretKey);
+    if (sig?.length === expected) { mldsaOrder[alg] = 'msg-first'; return sig; }
+  } catch { /* try the other order */ }
+  const sig = impl.sign(secretKey, msg);
+  mldsaOrder[alg] = 'sk-first';
+  return sig;
+}
+
+async function mldsaVerify(alg, publicKey, msg, sig) {
+  const impl = await loadMldsa(alg);
+  try {
+    return mldsaOrder[alg] === 'sk-first' ? impl.verify(publicKey, msg, sig) : impl.verify(sig, msg, publicKey);
+  } catch { return false; }
+}
+
+export async function signBytes(privateKeyText, bytes) {
+  const env = parseEnvelope(privateKeyText, 'private');
+  const a = getAlg(env.alg);
+  if (a.kind === 'mldsa') return mldsaSign(env.alg, b64uDecode(env.key), bytes);
+  const key = await crypto.subtle.importKey('jwk', env.key, a.gen, false, ['sign']);
+  return new Uint8Array(await crypto.subtle.sign(a.sign, key, bytes));
+}
+
+export async function verifyBytes(publicKeyText, bytes, signature, expectedAlg) {
+  const env = parseEnvelope(publicKeyText, 'public');
+  if (expectedAlg && expectedAlg !== env.alg) {
+    throw new Error(`Algorithm mismatch: signature uses ${expectedAlg}, key is ${env.alg}.`);
+  }
+  const a = getAlg(env.alg);
+  if (a.kind === 'mldsa') return mldsaVerify(env.alg, b64uDecode(env.key), bytes, signature);
+  const key = await crypto.subtle.importKey('jwk', env.key, a.gen, false, ['verify']);
+  return crypto.subtle.verify(a.sign, key, signature, bytes);
+}
+
+// ---------- signed message / artifact bundles ----------
+export async function signArtifact(privateKeyText, publicKeyText, bytes, name = '') {
+  const alg = parseEnvelope(privateKeyText, 'private').alg;
+  const sig = await signBytes(privateKeyText, bytes);
+  return JSON.stringify({
+    v: 1,
+    alg,
+    name,
+    created: new Date().toISOString(),
+    sha256: await sha256Hex(bytes),
+    keyFingerprint: publicKeyText ? await fingerprint(publicKeyText) : undefined,
+    signature: b64uEncode(sig),
+  }, null, 2);
+}
+
+export async function verifyArtifact(publicKeyText, bytes, bundleText) {
+  let bundle;
+  try { bundle = JSON.parse(bundleText); } catch { throw new Error('Signature bundle is not valid JSON.'); }
+  if (!bundle?.signature || !bundle.alg) throw new Error('Signature bundle is missing fields.');
+  const digest = await sha256Hex(bytes);
+  const valid = await verifyBytes(publicKeyText, bytes, b64uDecode(bundle.signature), bundle.alg);
+  return {
+    valid,
+    alg: bundle.alg,
+    digest,
+    digestMatchesBundle: bundle.sha256 ? bundle.sha256 === digest : undefined,
+    keyFingerprint: await fingerprint(publicKeyText),
+    keyFingerprintMatchesBundle: bundle.keyFingerprint
+      ? bundle.keyFingerprint === await fingerprint(publicKeyText) : undefined,
+    created: bundle.created,
+  };
+}
+
+// ---------- compact tokens (JWS-style: header.payload.signature) ----------
+export async function signToken(privateKeyText, payload, { expiresInSec } = {}) {
+  const alg = parseEnvelope(privateKeyText, 'private').alg;
+  const now = Math.floor(Date.now() / 1000);
+  const claims = { iat: now, ...payload };
+  if (expiresInSec) claims.exp = now + expiresInSec;
+  const header = b64uEncode(enc.encode(JSON.stringify({ alg, typ: 'JWT' })));
+  const body = b64uEncode(enc.encode(JSON.stringify(claims)));
+  const sig = await signBytes(privateKeyText, enc.encode(`${header}.${body}`));
+  return `${header}.${body}.${b64uEncode(sig)}`;
+}
+
+export async function verifyToken(publicKeyText, token) {
+  const parts = String(token).trim().split('.');
+  if (parts.length !== 3) throw new Error('Token must have three dot-separated parts.');
+  let header, claims;
+  try {
+    header = JSON.parse(dec.decode(b64uDecode(parts[0])));
+    claims = JSON.parse(dec.decode(b64uDecode(parts[1])));
+  } catch { throw new Error('Token header or payload is not valid base64url JSON.'); }
+  // The algorithm is pinned by the key, never trusted from the header ("alg confusion").
+  const valid = await verifyBytes(publicKeyText, enc.encode(`${parts[0]}.${parts[1]}`), b64uDecode(parts[2]), header.alg);
+  const now = Math.floor(Date.now() / 1000);
+  const expired = typeof claims.exp === 'number' && claims.exp < now;
+  return { valid, expired, header, claims };
+}
