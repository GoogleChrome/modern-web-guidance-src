new file mode 100644
index 0000000..ff0ccb5
--- /dev/null
+++ b/src/components/ConsentBanner.astro
@@ -0,0 +1,69 @@
+---
+---
+<div
+  id="consent-banner"
+  hidden
+  transition:persist
+  class="fixed bottom-0 inset-x-0 z-[60] bg-gray-900 text-white p-4 text-sm"
+  role="dialog"
+  aria-label="Privacy preferences"
+>
+  <div class="max-w-6xl mx-auto flex flex-wrap items-center gap-4">
+    <p class="flex-1 min-w-[16rem]">
+      We only use essential cookies by default. With your permission we also load a
+      third-party analytics script to understand how the site is used.
+      <a href="/legal/privacy" class="underline">Privacy Policy</a>
+    </p>
+    <button id="consent-decline" class="px-4 py-2 border border-white rounded">Decline</button>
+    <button id="consent-accept" class="px-4 py-2 bg-white text-gray-900 rounded">Accept analytics</button>
+  </div>
+</div>
+
+<script>
+  const KEY = 'analytics-consent';
+  const ANALYTICS_SRC =
+    'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+  const banner = document.getElementById('consent-banner') as HTMLElement;
+
+  // Honour browser-level opt-out signals; never track and never ask.
+  const optedOut =
+    navigator.doNotTrack === '1' || (navigator as any).globalPrivacyControl === true;
+
+  const read = () => {
+    try { return localStorage.getItem(KEY); } catch { return null; }
+  };
+  const write = (v: string) => {
+    try { localStorage.setItem(KEY, v); } catch {}
+  };
+
+  function loadAnalytics() {
+    if (optedOut || document.querySelector('script[data-analytics]')) return;
+    const s = document.createElement('script');
+    s.src = ANALYTICS_SRC;
+    s.defer = true;
+    s.referrerPolicy = 'no-referrer';
+    s.crossOrigin = 'anonymous';
+    s.dataset.analytics = 'true';
+    document.head.appendChild(s);
+  }
+
+  function decide(value: 'granted' | 'denied') {
+    write(value);
+    banner.hidden = true;
+    if (value === 'granted') loadAnalytics();
+  }
+
+  if (!optedOut) {
+    if (read() === 'granted') loadAnalytics();
+    else if (read() === null) banner.hidden = false;
+  }
+
+  document.getElementById('consent-accept')!.addEventListener('click', () => decide('granted'));
+  document.getElementById('consent-decline')!.addEventListener('click', () => decide('denied'));
+  document.addEventListener('click', (e) => {
+    if ((e.target as HTMLElement).closest('#manage-privacy')) {
+      e.preventDefault();
+      banner.hidden = false;
+    }
+  });
+</script>
