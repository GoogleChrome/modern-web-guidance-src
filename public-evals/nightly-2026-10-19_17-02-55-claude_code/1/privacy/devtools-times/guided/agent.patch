+          try { localStorage.setItem(KEY, v); } catch (e) {}
+        }
+        window.privacyConsent = {
+          accept: function () { if (!optedOut()) { set("granted"); load(); } },
+          decline: function () { set("denied"); },
+          reset: function () { try { localStorage.removeItem(KEY); } catch (e) {} },
+          status: function () { return optedOut() ? "denied" : get(); },
+        };
+        if (window.privacyConsent.status() === "granted") load();
+      })();
