--- /dev/null
+++ b/src/components/ConsentBanner.astro
@@ -0,0 +1,47 @@
+---
+---
+<div
+  id="consent-banner"
+  role="dialog"
+  aria-label="Privacy preferences"
+  hidden
+  class="fixed bottom-0 inset-x-0 z-[100] bg-gray-900 text-white p-4 text-sm shadow-lg"
+>
+  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row gap-3 sm:items-center justify-between">
+    <p>
+      We only use essential storage by default. With your permission we also load third-party
+      analytics to understand how the site is used. See our
+      <a href={`${import.meta.env.BASE_URL}legal/privacy`} class="underline">Privacy Policy</a>.
+    </p>
+    <div class="flex gap-2 shrink-0">
+      <button type="button" data-consent="decline" class="px-4 py-2 border border-white rounded-md">Decline</button>
+      <button type="button" data-consent="accept" class="px-4 py-2 bg-white text-gray-900 rounded-md">Accept analytics</button>
+    </div>
+  </div>
+</div>
+
+<script>
+  const setup = () => {
+    const banner = document.getElementById('consent-banner');
+    const consent = window.privacyConsent;
+    if (!banner || !consent) return;
+    const optedOut = navigator.doNotTrack === '1' || (navigator as any).globalPrivacyControl === true;
+    banner.hidden = optedOut || consent.status() !== null;
+
+    banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((btn) => {
+      btn.onclick = () => {
+        if (btn.dataset.consent === 'accept') consent.accept();
+        else consent.decline();
+        banner.hidden = true;
+      };
+    });
+    document.querySelectorAll('[data-privacy-preferences]').forEach((link) => {
+      (link as HTMLElement).onclick = (e) => {
+        e.preventDefault();
+        consent.reset();
+        banner.hidden = optedOut;
+      };
+    });
+  };
+  document.addEventListener('astro:page-load', setup);
+</script>
