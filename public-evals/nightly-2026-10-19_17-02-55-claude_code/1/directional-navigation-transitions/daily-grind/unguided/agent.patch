+    /* Seasonal carousel */
+    .carousel-viewport {
+      max-width: 500px;
+      margin: 20px auto 0;
+      overflow: hidden;
+      padding: 5px;
+    }
+
+    .carousel-viewport .card[hidden] {
+      display: none;
+    }
+
+    .card.from-right {
+      animation: slide-in-right 0.4s ease-out;
+    }
+
+    .card.from-left {
+      animation: slide-in-left 0.4s ease-out;
+    }
+
+    @keyframes slide-in-right {
+      from { transform: translateX(100%); opacity: 0; }
+      to { transform: translateX(0); opacity: 1; }
+    }
+
+    @keyframes slide-in-left {
+      from { transform: translateX(-100%); opacity: 0; }
+      to { transform: translateX(0); opacity: 1; }
+    }
+
+    .carousel-controls {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 15px;
+      margin-top: 10px;
+    }
+
+    .carousel-controls .btn {
+      margin-top: 0;
+      border: none;
+      cursor: pointer;
+      font: inherit;
+    }
+
+    .carousel-status {
+      min-width: 3.5em;
+      text-align: center;
+      font-size: 0.9rem;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card.from-right,
+      .card.from-left {
+        animation: none;
+      }
+    }
+
