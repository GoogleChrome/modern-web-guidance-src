+<script>
+    (function () {
+      var cards = document.querySelectorAll('#seasonal-carousel .card');
+      var status = document.getElementById('seasonal-status');
+      var current = 0;
+
+      function show(index, direction) {
+        current = (index + cards.length) % cards.length;
+        cards.forEach(function (card, i) {
+          card.hidden = i !== current;
+          card.classList.remove('from-left', 'from-right');
+        });
+        if (direction) {
+          cards[current].classList.add(direction === 'next' ? 'from-right' : 'from-left');
+        }
+        status.textContent = (current + 1) + ' / ' + cards.length;
+      }
+
+      document.getElementById('seasonal-next').addEventListener('click', function () {
+        show(current + 1, 'next');
+      });
+      document.getElementById('seasonal-prev').addEventListener('click', function () {
+        show(current - 1, 'prev');
+      });
+
+      show(0);
+    })();
+  </script>
+
 </body>
 
