+  <script>
+    (() => {
+      const stage = document.getElementById('seasonal-stage');
+      const controls = document.getElementById('seasonal-controls');
+      const status = document.getElementById('seasonal-status');
+      const cards = [...stage.children];
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      let index = 0;
+
+      function show(i) {
+        cards.forEach((card, n) => { card.hidden = n !== i; });
+        status.textContent = `${i + 1} / ${cards.length}`;
+      }
+
+      function step(direction) {
+        const next = (index + (direction === 'next' ? 1 : -1) + cards.length) % cards.length;
+        const update = () => { index = next; show(index); };
+        if (!document.startViewTransition || reducedMotion.matches) {
+          update();
+          return;
+        }
+        document.startViewTransition({ update, types: [direction] });
+      }
+
+      document.getElementById('seasonal-prev').addEventListener('click', () => step('previous'));
+      document.getElementById('seasonal-next').addEventListener('click', () => step('next'));
+
+      controls.hidden = false;
+      show(index);
+    })();
+  </script>
+
 </body>
 
