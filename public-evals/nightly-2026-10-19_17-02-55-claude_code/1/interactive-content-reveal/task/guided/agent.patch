+
+    /* Spotlight reveal for seasonal cards */
+    @property --inner-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      overflow: hidden;
+      /* Only the sizes transition; the position variables follow the pointer directly */
+      transition: --inner-size 0.3s ease-in-out, --outer-size 0.3s ease-in-out;
+    }
+
+    .product-card:hover {
+      --inner-size: 90px;
+      --outer-size: 130px;
+    }
+
+    .spotlight {
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+      background: rgba(255, 171, 64, 0.3);
+      color: var(--primary);
+      font-size: 0.7rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      line-height: 1;
+      padding-top: 6px;
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          black var(--inner-size, 0%), transparent var(--outer-size, 0%));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          black var(--inner-size, 0%), transparent var(--outer-size, 0%));
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+    }
+
+    .spotlight span {
+      position: absolute;
+      top: 6px;
+      left: 0;
+      right: 0;
+      text-align: center;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
   </style>
 </head>
 
