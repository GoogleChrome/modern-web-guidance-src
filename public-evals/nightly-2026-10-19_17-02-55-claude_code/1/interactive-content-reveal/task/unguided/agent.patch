diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -119,8 +119,60 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Spotlight reveal for product cards */
+    @property --inner-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      overflow: hidden;
+      padding-bottom: 80px;
+      /* Only the size animates; --mouse-x/--mouse-y follow the pointer instantly */
+      transition: --inner-size 0.4s ease, --outer-size 0.4s ease;
+    }
+
+    .product-card:hover {
+      --inner-size: 60px;
+      --outer-size: 140px;
+    }
+
+    .spotlight {
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+      display: flex;
+      align-items: flex-end;
+      justify-content: center;
+      padding: 0 20px 20px;
+      font-size: 0.85rem;
+      font-weight: 600;
+      color: var(--primary);
+      background: rgba(255, 171, 64, 0.35);
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), #000 var(--inner-size), transparent var(--outer-size));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), #000 var(--inner-size), transparent var(--outer-size));
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
