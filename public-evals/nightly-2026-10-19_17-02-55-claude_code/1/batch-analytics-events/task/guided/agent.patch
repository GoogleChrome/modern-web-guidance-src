+  <script type="module">
+    import { onCLS, onINP, onLCP } from 'https://cdn.jsdelivr.net/npm/web-vitals@5/dist/web-vitals.js';
+
+    // Polyfill for browsers without native fetchLater() (Chrome/Edge 135+ have it).
+    globalThis.fetchLater ??= function fetchLater(url, init = {}) {
+      let activated = false;
+
+      function sendNow() {
+        if (!(init.signal && init.signal.aborted)) {
+          if ('keepalive' in Request.prototype || init.method !== 'POST' || init.headers) {
+            fetch(url, Object.assign({}, init, { keepalive: true }));
+            activated = true;
+          } else {
+            activated = navigator.sendBeacon(url, init.body);
+          }
+        }
+        destroy();
+      }
+
+      function destroy() {
+        document.removeEventListener('visibilitychange', sendNow);
+      }
+
+      if (document.visibilityState === 'hidden') {
+        queueMicrotask(sendNow);
+      } else {
+        document.addEventListener('visibilitychange', sendNow);
+      }
+
+      if (init.signal) {
+        init.signal.addEventListener('abort', destroy);
+      }
+
+      return {
+        get activated() {
+          return activated;
+        },
+      };
+    };
+
+    const COLLECT_ENDPOINT = '/collect';
+
+    // Latest value per metric. Metrics like CLS, INP and LCP can be reported
+    // more than once, so a newer report replaces the older one.
+    const metrics = new Map();
+    let controller = null;
+
+    // Every report re-queues a single pending request containing all metrics
+    // collected so far; the browser sends it once, when the user leaves the page.
+    function queueReport(metric) {
+      const { name, value, rating, delta, id, navigationType } = metric;
+      metrics.set(name, { name, value, rating, delta, id, navigationType });
+
+      controller?.abort();
+      controller = new AbortController();
+
+      try {
+        fetchLater(COLLECT_ENDPOINT, {
+          method: 'POST',
+          headers: { 'content-type': 'application/json' },
+          body: JSON.stringify({
+            url: location.href,
+            metrics: [...metrics.values()],
+          }),
+          signal: controller.signal,
+        });
+      } catch {
+        // Quota exceeded or unsupported; monitoring is best-effort.
+      }
+    }
+
+    onCLS(queueReport);
+    onINP(queueReport);
+    onLCP(queueReport);
+  </script>
+
 </body>
 
