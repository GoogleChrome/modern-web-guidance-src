+  <script>
+    (function () {
+      const scroller = document.getElementById('reviews-scroll');
+      const top = document.querySelector('.indicator-top');
+      const bottom = document.querySelector('.indicator-bottom');
+
+      function updateIndicators() {
+        const maxScroll = scroller.scrollHeight - scroller.clientHeight;
+        top.classList.toggle('visible', scroller.scrollTop > 1);
+        bottom.classList.toggle('visible', scroller.scrollTop < maxScroll - 1);
+      }
+
+      scroller.addEventListener('scroll', updateIndicators, { passive: true });
+      window.addEventListener('resize', updateIndicators);
+      updateIndicators();
+    })();
+  </script>
