+  <script>
+    (function () {
+      var hoursInput = document.getElementById('hoursInput');
+      var minutesInput = document.getElementById('minutesInput');
+      var humanValue = document.getElementById('humanValue');
+      var locale = navigator.language || 'en';
+
+      function unitFormat(unit, value) {
+        return new Intl.NumberFormat(locale, {
+          style: 'unit',
+          unit: unit,
+          unitDisplay: 'long'
+        }).format(value);
+      }
+
+      function formatDuration(totalMinutes, largestUnit) {
+        var parts = [];
+        if (largestUnit === 'hours') {
+          var hours = Math.floor(totalMinutes / 60);
+          var minutes = totalMinutes % 60;
+          if (hours > 0) parts.push(unitFormat('hour', hours));
+          if (minutes > 0 || hours === 0) parts.push(unitFormat('minute', minutes));
+        } else {
+          parts.push(unitFormat('minute', totalMinutes));
+        }
+        return new Intl.ListFormat(locale, { style: 'long', type: 'unit' }).format(parts);
+      }
+
+      function update() {
+        var h = Math.max(0, Math.floor(Number(hoursInput.value) || 0));
+        var m = Math.max(0, Math.floor(Number(minutesInput.value) || 0));
+        var unit = document.querySelector('input[name="largestUnit"]:checked').value;
+        humanValue.textContent = formatDuration(h * 60 + m, unit);
+      }
+
+      hoursInput.addEventListener('input', update);
+      minutesInput.addEventListener('input', update);
+      document.querySelectorAll('input[name="largestUnit"]').forEach(function (r) {
+        r.addEventListener('change', update);
+      });
+      update();
+    })();
+  </script>
+
