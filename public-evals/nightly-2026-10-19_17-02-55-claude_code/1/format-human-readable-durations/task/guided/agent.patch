+  <script type="module">
+    // Temporal isn't available in all browsers (e.g. Safari), so load the polyfill when needed.
+    if (typeof Temporal === 'undefined') {
+      const { Temporal: T } = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = T;
+    }
+
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const humanValue = document.getElementById('humanValue');
+    const locale = navigator.language;
+
+    const toCount = (input) => Math.max(0, Math.floor(Number(input.value)) || 0);
+
+    function format(duration, largestUnit) {
+      if (typeof Intl.DurationFormat !== 'undefined') {
+        const text = new Intl.DurationFormat(locale, { style: 'long' }).format(duration);
+        if (text) return text;
+      } else {
+        // Manual fallback using localized unit and list formatting
+        const parts = ['hours', 'minutes']
+          .filter((unit) => duration[unit] > 0)
+          .map((unit) => new Intl.NumberFormat(locale, {
+            style: 'unit', unit: unit.slice(0, -1), unitDisplay: 'long',
+          }).format(duration[unit]));
+        if (parts.length) return new Intl.ListFormat(locale, { type: 'unit' }).format(parts);
+      }
+      // Zero duration
+      return new Intl.NumberFormat(locale, {
+        style: 'unit', unit: largestUnit.slice(0, -1), unitDisplay: 'long',
+      }).format(0);
+    }
+
+    function update() {
+      const largestUnit = document.querySelector('input[name="largestUnit"]:checked').value;
+      const duration = Temporal.Duration.from({ hours: toCount(hoursInput), minutes: toCount(minutesInput) })
+        .round({ largestUnit });
+      humanValue.textContent = format(duration, largestUnit);
+    }
+
+    document.querySelector('.steep').addEventListener('input', update);
+    update();
+  </script>
+
