+  <script>
+    // Fallback for browsers without sibling-index()/sibling-count(): set --i/--n inline.
+    if (!CSS.supports('width', 'calc(sibling-index() * 1px)')) {
+      const groups = '.grid, .fan-container, .circle-container';
+      const apply = () => document.querySelectorAll(groups).forEach(g =>
+        [...g.children].forEach((el, i, all) => {
+          el.style.setProperty('--i', i + 1);
+          el.style.setProperty('--n', all.length);
+        }));
+      apply();
+      new MutationObserver(apply).observe(document.body, { childList: true, subtree: true });
+    }
+  </script>
