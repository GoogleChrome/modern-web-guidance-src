+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const tocLinks = [...document.querySelectorAll('.toc-sidebar a')];
+    const sections = [...panel.querySelectorAll('.drink-section')];
+
+    function setActive(section) {
+      for (const link of tocLinks) {
+        if (link.hash === '#' + section.id) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      }
+    }
+
+    // Smoothly scroll only the panel (not the page) to the clicked section.
+    for (const link of tocLinks) {
+      link.addEventListener('click', (event) => {
+        event.preventDefault();
+        const section = document.getElementById(link.hash.slice(1));
+        const top = section.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop;
+        panel.scrollTo({ top });
+        setActive(section);
+      });
+    }
+
+    if ('onscrollsnapchange' in HTMLElement.prototype) {
+      panel.addEventListener('scrollsnapchange', (event) => {
+        const section = event.snapTargetBlock?.closest('.drink-section');
+        if (section) setActive(section);
+      });
+    } else {
+      // Fallback: highlight the section whose header is nearest the panel top.
+      const update = () => {
+        const panelTop = panel.getBoundingClientRect().top;
+        let best = sections[0];
+        for (const section of sections) {
+          if (section.getBoundingClientRect().top - panelTop <= panel.clientHeight / 2) best = section;
+        }
+        setActive(best);
+      };
+      const observer = new IntersectionObserver(update, { root: panel, threshold: [0.1, 0.5, 0.9] });
+      sections.forEach((section) => observer.observe(section));
+    }
+  </script>
+
