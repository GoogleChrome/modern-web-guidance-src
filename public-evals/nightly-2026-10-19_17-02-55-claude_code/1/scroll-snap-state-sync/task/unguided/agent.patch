+  <script>
+    (function () {
+      var panel = document.querySelector('.seasonal-panel');
+      var links = Array.prototype.slice.call(document.querySelectorAll('.toc-sidebar a'));
+      var sections = Array.prototype.slice.call(panel.querySelectorAll('.drink-section'));
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      function setActive(id) {
+        links.forEach(function (a) {
+          var on = a.getAttribute('href') === '#' + id;
+          if (on) a.setAttribute('aria-current', 'true');
+          else a.removeAttribute('aria-current');
+        });
+        sections.forEach(function (sec) {
+          if (sec.id === id) sec.setAttribute('data-active', '');
+          else sec.removeAttribute('data-active');
+        });
+      }
+
+      // A section is "in view" once it fills most of the panel after snapping.
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (e) {
+          if (e.isIntersecting) setActive(e.target.id);
+        });
+      }, { root: panel, threshold: 0.6 });
+      sections.forEach(function (sec) { observer.observe(sec); });
+
+      links.forEach(function (a) {
+        a.addEventListener('click', function (ev) {
+          var target = document.getElementById(a.getAttribute('href').slice(1));
+          if (!target) return;
+          ev.preventDefault();
+          // Scroll only the panel, not the page.
+          panel.scrollTo({
+            top: target.offsetTop,
+            behavior: reduceMotion.matches ? 'auto' : 'smooth'
+          });
+          setActive(target.id);
+        });
+      });
+
+      setActive(sections[0].id);
+    })();
+  </script>
+
