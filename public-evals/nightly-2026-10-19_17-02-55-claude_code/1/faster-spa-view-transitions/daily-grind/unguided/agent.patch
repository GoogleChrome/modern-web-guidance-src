+<script>
+    // Each visited route keeps its DOM in #views and is toggled with `hidden`,
+    // so returning to it skips rebuilding and preserves its scroll position.
+    (function () {
+      var views = document.getElementById('views');
+      var cache = new Map();   // path -> view element
+      var scroll = new Map();  // path -> last scroll offset
+      var current = null;
+      var baseTitle = document.title;
+
+      cache.set('/', views.querySelector('[data-route="/"]'));
+      current = '/';
+
+      function normalize(path) {
+        return path.length > 1 ? path.replace(/\/+$/, '') : path;
+      }
+
+      function titleCase(slug) {
+        return slug.replace(/[-_]+/g, ' ').replace(/\b\w/g, function (c) { return c.toUpperCase(); });
+      }
+
+      function buildView(path) {
+        var el = document.createElement('main');
+        el.className = 'container view view-page';
+        el.dataset.route = path;
+        var h = document.createElement('h2');
+        h.style.textAlign = 'center';
+        h.textContent = titleCase(path.split('/').filter(Boolean).pop() || 'Home');
+        var p = document.createElement('p');
+        p.style.textAlign = 'center';
+        p.textContent = 'Content for this page is coming soon.';
+        el.append(h, p);
+        return el;
+      }
+
+      function show(path) {
+        path = normalize(path);
+        if (path === current) return;
+        scroll.set(current, window.scrollY);
+        cache.get(current).hidden = true;
+
+        var view = cache.get(path);
+        if (!view) {
+          view = buildView(path);
+          cache.set(path, view);
+          views.appendChild(view);
+        }
+        view.hidden = false;
+        current = path;
+        document.title = path === '/' ? baseTitle : titleCase(path.split('/').pop()) + ' | The Daily Grind';
+        window.scrollTo(0, scroll.get(path) || 0);
+      }
+
+      document.addEventListener('click', function (e) {
+        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+        var a = e.target.closest('a[href]');
+        if (!a || a.target || a.origin !== location.origin) return;
+        if (a.pathname === '/logout') return; // real navigation
+        e.preventDefault();
+        if (normalize(a.pathname) !== current) history.pushState(null, '', a.pathname);
+        show(a.pathname);
+      });
+
+      window.addEventListener('popstate', function () { show(location.pathname); });
+
+      history.scrollRestoration = 'manual';
+      show(location.pathname);
+    })();
+  </script>
