diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..89eab1e
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,41 @@
+// Keeps the DOM of recently visited views so that navigating back to them
+// restores the existing structure instead of swapping in freshly fetched markup.
+const MAX_ENTRIES = 8;
+const MAX_AGE_MS = 5 * 60 * 1000;
+// Views whose markup depends on session state or form input.
+const UNCACHEABLE = /\/(signin|signup)\/?$/;
+
+const cache = new Map<string, { root: Node; savedAt: number }>();
+
+const key = (url: URL) => url.pathname + url.search;
+const getRoot = (doc: Document) => doc.getElementById("view-root");
+
+// Cached markup can embed server state (e.g. bookmarks), so drop it on change.
+window.addEventListener("reading-list-change", () => cache.clear());
+
+document.addEventListener("astro:before-preparation", (event) => {
+  if (event.formData) cache.clear();
+});
+
+document.addEventListener("astro:before-swap", (event) => {
+  const { from, to, newDocument } = event;
+
+  const current = getRoot(document);
+  if (current && !UNCACHEABLE.test(from.pathname)) {
+    const k = key(from);
+    cache.delete(k);
+    cache.set(k, { root: current.cloneNode(true), savedAt: Date.now() });
+    while (cache.size > MAX_ENTRIES) {
+      cache.delete(cache.keys().next().value!);
+    }
+  }
+
+  const entry = cache.get(key(to));
+  const target = getRoot(newDocument);
+  if (!entry || !target) return;
+  if (Date.now() - entry.savedAt > MAX_AGE_MS) {
+    cache.delete(key(to));
+    return;
+  }
+  target.replaceChildren(...Array.from((entry.root as Element).cloneNode(true).childNodes));
+});
