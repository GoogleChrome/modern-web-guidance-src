+}
+/* Inactive SPA views keep their DOM and rendering state cached in memory. */
+.spa-view.inactive {
+  content-visibility: hidden;
+  position: absolute;
+  inset-inline: 0;
+  top: 0;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
+
+.spa-view:focus {
+  outline: none;
+}
