+  <script>
+    (() => {
+      const canvas = document.getElementById('gc-canvas');
+      const card = document.getElementById('export_element');
+      const ctx = canvas.getContext('2d');
+      const status = document.getElementById('gc-status');
+      const CARD_W = 500, CARD_H = 300;
+
+      // HTML-in-Canvas: needs the `layoutsubtree` attribute, drawElementImage() and the `paint` event.
+      const supportsHtmlInCanvas =
+        'layoutSubtree' in canvas &&
+        typeof ctx.drawElementImage === 'function' &&
+        typeof canvas.requestPaint === 'function';
+
+      let paintWaiters = [];
+
+      function drawNative() {
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.setTransform(canvas.width / CARD_W, 0, 0, canvas.height / CARD_H, 0, 0);
+        // Keep the DOM element's hit-test position in sync with where it was drawn.
+        const transform = ctx.drawElementImage(card, 0, 0);
+        if (transform) card.style.transform = transform.toString();
+      }
+
+      // Resolves once the canvas bitmap reflects the current card state.
+      function render() {
+        if (supportsHtmlInCanvas) {
+          return new Promise((resolve) => {
+            paintWaiters.push(resolve);
+            canvas.requestPaint();
+          });
+        }
+        return renderFallback();
+      }
+
+      if (supportsHtmlInCanvas) {
+        // The browser fires `paint` after the children's rendering is up to date, so drawing here is never stale.
+        canvas.addEventListener('paint', () => {
+          drawNative();
+          const waiters = paintWaiters;
+          paintWaiters = [];
+          waiters.forEach((resolve) => resolve());
+        });
+      }
+
+      // Fallback: serialize the card + its CSS into an SVG <foreignObject> and draw that image.
+      function renderFallback() {
+        const clone = card.cloneNode(true);
+        clone.style.transform = '';
+        clone.setAttribute('xmlns', 'http://www.w3.org/1999/xhtml');
+        const css = document.getElementById('card-css').textContent;
+        const svg =
+          `<svg xmlns="http://www.w3.org/2000/svg" width="${canvas.width}" height="${canvas.height}" viewBox="0 0 ${CARD_W} ${CARD_H}">` +
+          `<foreignObject width="${CARD_W}" height="${CARD_H}"><style xmlns="http://www.w3.org/1999/xhtml">${css}</style>` +
+          new XMLSerializer().serializeToString(clone) +
+          '</foreignObject></svg>';
+        return new Promise((resolve, reject) => {
+          const img = new Image();
+          img.onload = () => {
+            ctx.setTransform(1, 0, 0, 1, 0, 0);
+            ctx.clearRect(0, 0, canvas.width, canvas.height);
+            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
+            resolve();
+          };
+          img.onerror = () => reject(new Error('Could not render card'));
+          img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
+        });
+      }
+
+      // Form -> card
+      const nameIn = document.getElementById('gc-name');
+      const msgIn = document.getElementById('gc-message');
+      const colorIn = document.getElementById('gc-color');
+
+      function textColorFor(hex) {
+        const n = parseInt(hex.slice(1), 16);
+        const lum = (0.299 * (n >> 16) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255)) / 255;
+        return lum > 0.6 ? '#3e2723' : '#ffffff';
+      }
+
+      function update() {
+        document.getElementById('gc-name-out').textContent = nameIn.value.trim() || 'a coffee lover';
+        document.getElementById('gc-message-out').textContent = msgIn.value;
+        card.style.backgroundColor = colorIn.value;
+        card.style.color = textColorFor(colorIn.value);
+        render().catch(() => { status.textContent = 'Preview failed to render.'; });
+      }
+
+      [nameIn, msgIn, colorIn].forEach((el) => el.addEventListener('input', update));
+
+      // Export
+      document.getElementById('gc-export').addEventListener('click', async () => {
+        status.textContent = '';
+        try {
+          await render(); // make sure the bitmap is current before reading it
+          const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
+          if (!blob) throw new Error('toBlob returned null');
+          const url = URL.createObjectURL(blob);
+          const a = document.createElement('a');
+          a.href = url;
+          a.download = 'daily-grind-gift-card.png';
+          document.body.appendChild(a);
+          a.click();
+          a.remove();
+          setTimeout(() => URL.revokeObjectURL(url), 1000);
+          status.textContent = 'Card downloaded!';
+        } catch (e) {
+          status.textContent = 'Sorry, the card could not be exported in this browser.';
+        }
+      });
+
+      update();
+    })();
+  </script>
 </body>
 
