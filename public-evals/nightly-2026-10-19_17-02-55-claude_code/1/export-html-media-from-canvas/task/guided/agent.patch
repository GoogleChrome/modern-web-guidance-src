+  <script>
+    (() => {
+      const canvas = document.getElementById('card_canvas');
+      const card = document.getElementById('export_element');
+      const stage = document.getElementById('card_stage');
+      const nameInput = document.getElementById('card_name');
+      const messageInput = document.getElementById('card_message');
+      const colorInput = document.getElementById('card_color');
+      const downloadBtn = document.getElementById('download_card');
+      const status = document.getElementById('designer_status');
+      const messageEl = document.getElementById('gc_message');
+      const nameEl = document.getElementById('gc_name');
+
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+      function updateCard() {
+        messageEl.textContent = messageInput.value;
+        nameEl.textContent = nameInput.value ? '— ' + nameInput.value : '';
+        const hex = colorInput.value;
+        card.style.backgroundColor = hex;
+        // Pick a readable text color for the chosen background.
+        const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
+        card.style.color = (r * 299 + g * 587 + b * 114) / 1000 > 150 ? '#3e2723' : '#fff';
+      }
+
+      [nameInput, messageInput, colorInput].forEach((el) => el.addEventListener('input', updateCard));
+      updateCard();
+
+      let getBlob;
+
+      if (supportsHtmlInCanvas) {
+        const ctx = canvas.getContext('2d');
+        let paintWaiters = [];
+
+        canvas.onpaint = () => {
+          ctx.reset();
+          ctx.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+          paintWaiters.forEach((resolve) => resolve());
+          paintWaiters = [];
+        };
+
+        // Keep the canvas backing store matched to device pixels.
+        const observer = new ResizeObserver(([entry]) => {
+          const dpc = entry.devicePixelContentBoxSize;
+          canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+          canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+          canvas.requestPaint();
+        });
+        const supportsDevicePixelContentBox =
+          typeof ResizeObserverEntry !== 'undefined' &&
+          'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+        observer.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+
+        // Resolve once the canvas has painted the latest state of the card.
+        const nextPaint = () => new Promise((resolve) => {
+          paintWaiters.push(resolve);
+          canvas.requestPaint();
+        });
+
+        getBlob = async () => {
+          await nextPaint();
+          return new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
+        };
+      } else {
+        // Unsupported: canvas children aren't rendered, so show the card
+        // directly and rasterize it with html2canvas on demand.
+        canvas.remove();
+        stage.appendChild(card);
+        card.removeAttribute('drawable');
+
+        let loader;
+        const loadHtml2Canvas = () => loader ||= new Promise((resolve, reject) => {
+          const script = document.createElement('script');
+          script.src = 'https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js';
+          script.onload = () => resolve(window.html2canvas);
+          script.onerror = () => { loader = null; reject(new Error('Failed to load html2canvas')); };
+          document.head.appendChild(script);
+        });
+
+        getBlob = async () => {
+          const html2canvas = await loadHtml2Canvas();
+          const rendered = await html2canvas(card, { scale: devicePixelRatio, backgroundColor: null });
+          return new Promise((resolve) => rendered.toBlob(resolve, 'image/png'));
+        };
+      }
+
+      downloadBtn.addEventListener('click', async () => {
+        downloadBtn.disabled = true;
+        status.textContent = 'Preparing your card…';
+        try {
+          const blob = await getBlob();
+          if (!blob) throw new Error('Empty image');
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.href = url;
+          link.download = 'daily-grind-gift-card.png';
+          link.click();
+          setTimeout(() => URL.revokeObjectURL(url), 1000);
+          status.textContent = 'Your card was downloaded.';
+        } catch (err) {
+          console.error(err);
+          status.textContent = 'Sorry, we could not export the card. Please try again.';
+        } finally {
+          downloadBtn.disabled = false;
+        }
+      });
+    })();
+  </script>
