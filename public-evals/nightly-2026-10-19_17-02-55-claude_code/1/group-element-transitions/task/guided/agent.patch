+
+    /* Disable the full-page transition so the page stays interactive.
+       Transitions are scoped to the list element instead. */
+    :root {
+      view-transition-name: none;
+    }
+
+    /* Move/resize of all items */
+    ::view-transition-group(*.bean-item) {
+      animation-duration: 0.5s;
+      animation-timing-function: ease-in-out;
+    }
+
+    /* Entering items slide in from the left */
+    ::view-transition-new(*.bean-item):only-child {
+      animation: bean-slide-in 1s both;
+    }
+
+    /* Exiting items slide out to the left */
+    ::view-transition-old(*.bean-item):only-child {
+      animation: bean-slide-out 1s both;
+    }
+
+    @keyframes bean-slide-in {
+      from { transform: translateX(-100%); opacity: 0; }
+      to { transform: translateX(0); opacity: 1; }
+    }
+
+    @keyframes bean-slide-out {
+      from { transform: translateX(0); opacity: 1; }
+      to { transform: translateX(-100%); opacity: 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
