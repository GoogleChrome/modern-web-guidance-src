+  <script>
+    const beanList = document.getElementById('bean-list');
+    const beanForm = document.getElementById('bean-form');
+    const beanName = document.getElementById('bean-name');
+
+    // Scope the transition to the list so the rest of the page stays interactive.
+    // Browsers without element-scoped view transitions just update immediately.
+    function updateList(update) {
+      if (!('startViewTransition' in Element.prototype)) {
+        update();
+        return;
+      }
+      beanList.startViewTransition(update).ready.catch(() => {});
+    }
+
+    function createItem(name) {
+      const li = document.createElement('li');
+      li.className = 'item';
+      const label = document.createElement('span');
+      label.textContent = name;
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.textContent = 'Remove';
+      li.append(label, remove);
+      return li;
+    }
+
+    beanForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const name = beanName.value.trim() || `Custom Bean ${beanList.children.length + 1}`;
+      beanName.value = '';
+      updateList(() => beanList.append(createItem(name)));
+    });
+
+    beanList.addEventListener('click', (e) => {
+      const item = e.target.closest('.item');
+      if (!item || !e.target.matches('button')) return;
+      updateList(() => item.remove());
+    });
+  </script>
 </body>
 
