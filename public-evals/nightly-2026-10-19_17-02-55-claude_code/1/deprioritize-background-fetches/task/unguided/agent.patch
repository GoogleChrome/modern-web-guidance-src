diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,29 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Button</title>
+</head>
+<body>
+<button id="btn">Click</button>
+<script>
+document.getElementById('btn').addEventListener('click', () => {
+  // Mission-critical: highest priority, started first.
+  fetch('/api/data', { priority: 'high' })
+    .then(r => r.json())
+    .then(console.log)
+    .catch(console.error);
+
+  // Analytics: low priority so it doesn't compete for bandwidth; keepalive survives navigation.
+  fetch('/api/analytics', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ click: 1 }),
+    priority: 'low',
+    keepalive: true
+  }).catch(() => {});
+});
+</script>
+</body>
+</html>
