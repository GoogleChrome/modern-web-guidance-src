+  <script>
+    // Theme selector: "system" removes the override so the OS preference applies.
+    (function () {
+      var root = document.documentElement;
+      var select = document.getElementById('theme-select');
+      var saved = null;
+      try { saved = localStorage.getItem('theme'); } catch (e) { }
+      select.value = (saved === 'light' || saved === 'dark') ? saved : 'system';
+
+      select.addEventListener('change', function () {
+        var value = select.value;
+        if (value === 'light' || value === 'dark') {
+          root.setAttribute('data-theme', value);
+        } else {
+          root.removeAttribute('data-theme');
+        }
+        try {
+          if (value === 'system') localStorage.removeItem('theme');
+          else localStorage.setItem('theme', value);
+        } catch (e) { }
+      });
+    })();
+
+    // Late night specials filter
+    (function () {
+      var filter = document.getElementById('special-filter');
+      var items = document.querySelectorAll('.special');
+      filter.addEventListener('change', function () {
+        items.forEach(function (item) {
+          item.hidden = filter.value !== 'all' && item.dataset.type !== filter.value;
+        });
+      });
+    })();
+  </script>
+
