+  <script type="module">
+    // Temporal is immutable and timezone-aware; fall back to the polyfill where it isn't built in yet.
+    if (!globalThis.Temporal) {
+      ({ Temporal: globalThis.Temporal } = await import('https://esm.sh/@js-temporal/polyfill'));
+    }
+
+    const TARGETS = [
+      { label: 'New York', tz: 'America/New_York' },
+      { label: 'London', tz: 'Europe/London' },
+      { label: 'Tokyo', tz: 'Asia/Tokyo' },
+      { label: 'UTC', tz: 'UTC' },
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const hostWarning = document.getElementById('hostWarning');
+
+    const timeFormat = { hour: 'numeric', minute: '2-digit' };
+    const dayFormat = { weekday: 'short', month: 'short', day: 'numeric' };
+
+    // Returns { zdt, warning } where zdt is the resolved ZonedDateTime in the host zone.
+    function resolveHost(wall, tz) {
+      try {
+        return { zdt: wall.toZonedDateTime(tz, { disambiguation: 'reject' }), warning: null };
+      } catch {
+        // Wall-clock time is ambiguous (overlap) or skipped (gap); resolve like most calendars do.
+        const zdt = wall.toZonedDateTime(tz, { disambiguation: 'compatible' });
+        const earlier = wall.toZonedDateTime(tz, { disambiguation: 'earlier' });
+        const later = wall.toZonedDateTime(tz, { disambiguation: 'later' });
+        const shown = (z) => `${z.toLocaleString('en-US', timeFormat)} (${z.offset})`;
+        const asked = wall.toLocaleString('en-US', { ...timeFormat, ...dayFormat });
+        if (Temporal.PlainDateTime.compare(zdt.toPlainDateTime(), wall) !== 0) {
+          return {
+            zdt,
+            warning: `${asked} does not exist in ${tz}: clocks skip forward on this date (daylight saving gap). ` +
+              `It was resolved to ${shown(zdt)}, the first valid time after the gap.`,
+          };
+        }
+        return {
+          zdt,
+          warning: `${asked} happens twice in ${tz}: clocks go back on this date (daylight saving overlap). ` +
+            `It was resolved to the first occurrence, ${shown(earlier)}; the second occurrence would be ${shown(later)}.`,
+        };
+      }
+    }
+
+    function render() {
+      grid.replaceChildren();
+      hostWarning.hidden = true;
+      hostWarning.textContent = '';
+      if (!dateInput.value || !timeInput.value) return;
+
+      const hostTz = hostTzSelect.value;
+      const wall = Temporal.PlainDateTime.from(`${dateInput.value}T${timeInput.value}`);
+      const { zdt, warning } = resolveHost(wall, hostTz);
+
+      if (warning) {
+        hostWarning.textContent = warning;
+        hostWarning.hidden = false;
+      }
+
+      for (const { label, tz } of TARGETS) {
+        const local = zdt.withTimeZone(tz); // new object; zdt is untouched
+        const card = document.createElement('div');
+        card.className = 'card' + (tz === hostTz ? ' host' : '');
+        card.dataset.tz = tz;
+
+        const h3 = document.createElement('h3');
+        h3.textContent = label;
+        const time = document.createElement('p');
+        time.className = 'time';
+        time.textContent = local.toLocaleString('en-US', timeFormat);
+        const meta = document.createElement('p');
+        meta.className = 'meta';
+        meta.textContent = `${local.toLocaleString('en-US', dayFormat)} · UTC${local.offset}`;
+
+        card.append(h3, time, meta);
+        grid.append(card);
+      }
+    }
+
+    dateInput.value = Temporal.Now.plainDateISO().toString();
+    for (const el of [dateInput, timeInput, hostTzSelect]) {
+      el.addEventListener('input', render);
+      el.addEventListener('change', render);
+    }
+    render();
+  </script>
+
