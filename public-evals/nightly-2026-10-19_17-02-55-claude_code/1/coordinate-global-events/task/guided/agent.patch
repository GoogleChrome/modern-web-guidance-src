+  <script type="module">
+    // Temporal is not available in every browser yet (e.g. Safari), so load a polyfill when needed.
+    if (typeof Temporal === 'undefined') {
+      const { Temporal: polyfill } = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = polyfill;
+    }
+
+    const TARGETS = [
+      { zone: 'America/New_York', label: 'New York' },
+      { zone: 'Europe/London', label: 'London' },
+      { zone: 'Asia/Tokyo', label: 'Tokyo' },
+      { zone: 'UTC', label: 'UTC' }
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const hostWarning = document.getElementById('hostWarning');
+
+    const timeFormat = { hour: 'numeric', minute: '2-digit' };
+    const dayFormat = { weekday: 'short', month: 'short', day: 'numeric' };
+
+    // Returns { zdt, warning }. The ZonedDateTime is never mutated; every conversion yields a new one.
+    function resolveHost(date, time, zone) {
+      const wall = Temporal.PlainDateTime.from(`${date}T${time}`);
+      const zdt = wall.toZonedDateTime(zone, { disambiguation: 'compatible' });
+      let warning = '';
+      try {
+        // 'reject' throws a RangeError when the wall-clock time is skipped or repeated.
+        wall.toZonedDateTime(zone, { disambiguation: 'reject' });
+      } catch (e) {
+        if (!(e instanceof RangeError)) throw e;
+        const earlier = wall.toZonedDateTime(zone, { disambiguation: 'earlier' });
+        const wallText = wall.toLocaleString('en-US', { ...dayFormat, ...timeFormat });
+        const resolvedText = zdt.toLocaleString('en-US', { ...dayFormat, ...timeFormat, timeZoneName: 'short' });
+        if (earlier.toPlainDateTime().equals(wall)) {
+          // Both candidates keep the wall-clock time, so the clocks were turned back: overlap.
+          warning = `${wallText} happens twice in ${zone} because clocks are turned back. ` +
+            `We used the first occurrence: ${resolvedText}.`;
+        } else {
+          // The earlier candidate shifted the wall-clock time, so the time was skipped: gap.
+          warning = `${wallText} does not exist in ${zone} because clocks jump forward. ` +
+            `We moved it forward to ${resolvedText}.`;
+        }
+      }
+      return { zdt, warning };
+    }
+
+    function card(label, zdt, isHost) {
+      const el = document.createElement('div');
+      el.className = 'card' + (isHost ? ' host' : '');
+      const h3 = document.createElement('h3');
+      h3.textContent = isHost ? `${label} (host)` : label;
+      const time = document.createElement('p');
+      time.className = 'tz-time';
+      time.textContent = zdt.toLocaleString('en-US', timeFormat);
+      const meta = document.createElement('p');
+      meta.className = 'tz-meta';
+      meta.textContent = zdt.toLocaleString('en-US', { ...dayFormat, timeZoneName: 'short' });
+      el.append(h3, time, meta);
+      return el;
+    }
+
+    function update() {
+      const zone = hostTzSelect.value;
+      hostWarning.hidden = true;
+      hostWarning.textContent = '';
+      if (!dateInput.value || !timeInput.value) {
+        grid.replaceChildren();
+        return;
+      }
+      const { zdt, warning } = resolveHost(dateInput.value, timeInput.value, zone);
+      if (warning) {
+        hostWarning.textContent = warning;
+        hostWarning.hidden = false;
+      }
+      grid.replaceChildren(...TARGETS.map(({ zone: tz, label }) =>
+        card(label, zdt.withTimeZone(tz), tz === zone)));
+    }
+
+    dateInput.value = Temporal.Now.plainDateISO().toString();
+    for (const input of [dateInput, timeInput, hostTzSelect]) {
+      input.addEventListener('input', update);
+      input.addEventListener('change', update);
+    }
+    update();
+  </script>
