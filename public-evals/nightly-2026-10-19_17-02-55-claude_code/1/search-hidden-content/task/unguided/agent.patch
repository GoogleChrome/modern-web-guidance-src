+      gap: 30px;
+      align-items: start;
+    }
+
+    .layout .container {
+      max-width: none;
+      margin: 0;
+      padding: 0;
+    }
+
+    .sidebar {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      position: sticky;
+      top: 90px;
+    }
+
+    .sidebar h3 {
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    @media (max-width: 800px) {
+      .layout {
+        grid-template-columns: 1fr;
+      }
+
+      .sidebar {
+        position: static;
+      }
+    }
+
+    /* Reveal coupon button */
+    .reveal-coupon-btn {
+      appearance: none;
+      width: 100%;
+      margin-top: 15px;
+      padding: 12px 20px;
+      font: inherit;
+      font-weight: bold;
+      color: var(--primary);
+      background: var(--accent);
+      border: 2px dashed var(--primary);
+      border-radius: 5px;
+      cursor: pointer;
+      transition: background 0.3s, color 0.3s;
+    }
+
+    .reveal-coupon-btn:hover,
+    .reveal-coupon-btn:focus-visible {
+      background: var(--primary);
+      color: white;
+    }
+
+    .reveal-coupon-btn[disabled] {
+      opacity: 0.6;
+      cursor: default;
+      background: var(--secondary);
+      color: var(--primary);
+    }
+
+    /* Coupon panel: hidden="until-found" keeps it findable via find-in-page.
+       Don't set `display` on it, and only style the box once revealed. */
+    #coupon-panel:not([hidden]) {
+      margin-top: 30px;
+      padding: 20px;
+      text-align: center;
+      background: white;
+      border: 2px dashed var(--accent);
+      border-radius: 8px;
+    }
+
+    .coupon-code {
+      display: inline-block;
+      margin-top: 8px;
+      padding: 6px 16px;
+      font-family: monospace;
+      font-size: 1.5rem;
+      letter-spacing: 3px;
+      color: var(--primary);
+      background: var(--secondary);
+      border-radius: 4px;
+    }
+
+    /* Wholesale / catering tabs.
+       Native <details name="..."> gives mutually exclusive panels, and the
+       browser's find-in-page searches and auto-opens closed ones. */
+    .wholesale-tabs {
+      margin-top: 40px;
+    }
+
+    .wholesale-tabs > h2 {
+      text-align: center;
+      margin-bottom: 15px;
+    }
+
+    .wholesale-tab {
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      margin-bottom: 8px;
+      overflow: hidden;
+    }
+
+    .wholesale-tab summary {
+      padding: 12px 20px;
+      font-weight: bold;
+      color: var(--primary);
+      cursor: pointer;
+    }
+
+    .wholesale-tab[open] summary {
+      background: var(--primary);
+      color: white;
+    }
+
+    .wholesale-tab .tab-body {
+      padding: 20px;
+    }
+
