+    /* Layout density: the card reacts to its ancestor's --density property */
+    #target-container {
+      --density: compact;
+      --style-queries-supported: 1;
+    }
+
+    #toggle-spacious {
+      display: none;
+      margin: 20px auto 0;
+      border: 0;
+      cursor: pointer;
+      font: inherit;
+    }
+
+    /* Feature check: only show the toggle where style queries work */
+    @container style(--style-queries-supported: 1) {
+      #toggle-spacious {
+        display: block;
+      }
+    }
+
+    #target-item {
+      transition: padding 0.3s;
+    }
+
+    @container style(--density: spacious) {
+      #target-item {
+        padding: 40px 32px;
+      }
+    }
+
