+    /* Layout density: a higher-order token set on the container, read by descendants via style queries */
+    #target-container {
+      --density: comfortable;
+    }
+
+    #target-item {
+      transition: padding 0.3s;
+    }
+
+    @container style(--density: spacious) {
+      #target-item {
+        padding: 40px;
+      }
+    }
+
+    /* Toggle is hidden unless container style queries are supported */
+    :root {
+      --style-queries-supported: check;
+    }
+
+    #toggle-spacious {
+      display: none;
+    }
+
+    @container style(--style-queries-supported) {
+      #toggle-spacious {
+        display: block;
+        margin: 10px auto 0;
+        background: transparent;
+        color: var(--primary);
+        border: 1px solid var(--primary);
+        padding: 6px 14px;
+        border-radius: 5px;
+        font: inherit;
+        font-size: 0.85rem;
+        cursor: pointer;
+      }
+
+      #toggle-spacious[aria-pressed="true"] {
+        background: var(--primary);
+        color: white;
+      }
+    }
+
