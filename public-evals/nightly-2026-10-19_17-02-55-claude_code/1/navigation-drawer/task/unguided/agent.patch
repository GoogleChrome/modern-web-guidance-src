+  <script>
+    // Escape and focus trapping are handled natively by <dialog>.showModal();
+    // opening/closing buttons use invoker commands (commandfor/command).
+    const drawer = document.getElementById('site-menu');
+    const panel = drawer.querySelector('.drawer-panel');
+    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    const isClosedPosition = () => drawer.scrollLeft >= panel.offsetWidth - 1;
+
+    // Native swipe: the user scrolls the panel off-screen and snaps to the end.
+    if ('onscrollend' in window) {
+      drawer.addEventListener('scrollend', () => {
+        if (drawer.open && isClosedPosition()) drawer.close();
+      });
+    } else {
+      let timer;
+      drawer.addEventListener('scroll', () => {
+        clearTimeout(timer);
+        timer = setTimeout(() => {
+          if (drawer.open && isClosedPosition()) drawer.close();
+        }, 150);
+      });
+    }
+
+    // Tapping the backdrop (the spacer area, or the dialog itself) closes it.
+    drawer.addEventListener('click', (e) => {
+      if (e.target === drawer || e.target.classList.contains('drawer-spacer')) {
+        if (reduceMotion.matches) drawer.close();
+        else drawer.scrollTo({ left: panel.offsetWidth, behavior: 'smooth' });
+      }
+    });
+
+    // Following a link closes the drawer (matters for in-page anchors).
+    panel.addEventListener('click', (e) => {
+      if (e.target.closest('a')) drawer.close();
+    });
+  </script>
+
