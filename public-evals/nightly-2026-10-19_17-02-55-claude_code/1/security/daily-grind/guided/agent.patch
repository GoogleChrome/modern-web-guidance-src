+  }
+
+  if (pathname === '/csp-report') {
+    return handleCspReport(req, res);
+  }
+
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    return send(res, 405, { Allow: 'GET, HEAD' }, 'Method Not Allowed');
+  }
 
