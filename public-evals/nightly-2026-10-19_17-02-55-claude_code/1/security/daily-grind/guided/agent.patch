 const http = require('node:http');
 const fs = require('node:fs');
 const path = require('node:path');
+const crypto = require('node:crypto');
 
 const PORT = parseInt(process.env.PORT || '11222', 10);
 const WORK_DIR = __dirname;
 
+// Roll out new CSP changes safely: run with CSP_REPORT_ONLY=1 to log violations
+// (via /csp-report) without blocking anything, then drop the flag to enforce.
+const CSP_REPORT_ONLY = process.env.CSP_REPORT_ONLY === '1';
+const CSP_HEADER = CSP_REPORT_ONLY
+  ? 'Content-Security-Policy-Report-Only'
+  : 'Content-Security-Policy';
+
+const TEMPLATE_PATH = path.join(WORK_DIR, 'index.html');
+
+function buildCsp(nonce) {
+  return [
+    "default-src 'none'",
+    `style-src 'nonce-${nonce}'`,
+    "img-src 'self' https://images.unsplash.com data:",
+    "script-src 'none'",
+    "connect-src 'none'",
+    "font-src 'none'",
+    "object-src 'none'",
+    "media-src 'none'",
+    "worker-src 'none'",
+    "manifest-src 'none'",
+    "base-uri 'none'",
+    "form-action 'self'",
+    "frame-ancestors 'none'",
+    'upgrade-insecure-requests',
+    'report-uri /csp-report',
+  ].join('; ');
+}
+
+const SECURITY_HEADERS = {
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY', // legacy fallback for frame-ancestors
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'Strict-Transport-Security': 'max-age=63072000; includeSubDomains',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Permissions-Policy':
+    'accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()',
+  'X-Permitted-Cross-Domain-Policies': 'none',
+};
+
+function send(res, status, headers, body) {
+  res.writeHead(status, { ...SECURITY_HEADERS, ...headers });
+  res.end(body);
+}
+
+function handleCspReport(req, res) {
+  if (req.method !== 'POST') {
+    return send(res, 405, { Allow: 'POST' }, 'Method Not Allowed');
+  }
+  const chunks = [];
+  let size = 0;
+  let aborted = false;
+  req.on('data', (chunk) => {
+    size += chunk.length;
+    if (size > 10 * 1024) {
+      aborted = true;
+      send(res, 413, { Connection: 'close' }, 'Payload Too Large');
+      req.destroy();
+      return;
+    }
+    chunks.push(chunk);
+  });
+  req.on('end', () => {
+    if (aborted) return;
+    // Log a bounded, JSON-escaped copy to avoid log injection.
+    const body = Buffer.concat(chunks).toString('utf8').slice(0, 4096);
+    console.warn('CSP violation report:', JSON.stringify(body));
+    send(res, 204, {}, undefined);
+  });
+  req.on('error', () => {});
+}
+
 const server = http.createServer((req, res) => {
-  const parsedUrl = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
-  const pathname = parsedUrl.pathname;
+  let pathname;
+  try {
+    pathname = new URL(req.url, 'http://localhost').pathname;
+  } catch {
