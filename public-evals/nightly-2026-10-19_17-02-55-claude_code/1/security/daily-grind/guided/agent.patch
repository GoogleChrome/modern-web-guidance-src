-    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
-    res.end('Logged out');
-    return;
+    return send(
+      res,
+      200,
+      {
+        'Content-Type': 'text/html; charset=utf-8',
+        'Cache-Control': 'no-store',
+        'Clear-Site-Data': '"cache", "cookies", "storage"',
+      },
+      req.method === 'HEAD' ? undefined : 'Logged out'
+    );
   }
 
-  const filePath = path.join(WORK_DIR, 'index.html');
-  fs.readFile(filePath, (err, data) => {
+  fs.readFile(TEMPLATE_PATH, 'utf8', (err, data) => {
     if (err) {
-      res.writeHead(500);
-      res.end('Server error');
-      return;
+      return send(res, 500, { 'Content-Type': 'text/plain; charset=utf-8' }, 'Server error');
     }
-    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
-    res.end(data);
+    const nonce = crypto.randomBytes(16).toString('base64');
+    const html = data.replaceAll('__CSP_NONCE__', nonce);
+    send(
+      res,
+      200,
+      {
+        'Content-Type': 'text/html; charset=utf-8',
+        'Cache-Control': 'no-cache',
+        [CSP_HEADER]: buildCsp(nonce),
+      },
+      req.method === 'HEAD' ? undefined : html
+    );
   });
 });
 
+// Mitigate slowloris-style resource exhaustion.
+server.headersTimeout = 10_000;
+server.requestTimeout = 15_000;
+server.maxHeadersCount = 50;
