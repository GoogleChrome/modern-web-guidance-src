+
+    .board-column .card {
+      cursor: grab;
+      touch-action: none;
+      user-select: none;
+      -webkit-user-select: none;
+      text-align: left;
+      padding: 14px 16px;
+      /* Offscreen cards in long lists skip layout and paint. */
+      content-visibility: auto;
+      contain-intrinsic-size: auto 90px;
+    }
+
+    .board-column .card:focus-visible {
+      outline: 2px solid var(--accent);
+    }
+
+    .card-placeholder {
+      flex: none;
+      border: 2px dashed var(--primary);
+      border-radius: 8px;
+      opacity: 0.4;
+    }
+
+    /* Dragged card is lifted out of flow and moved with transform only (compositor-driven). */
+    .card.dragging {
+      position: fixed;
+      top: 0;
+      left: 0;
+      z-index: 2000;
+      margin: 0;
+      pointer-events: none;
+      cursor: grabbing;
+      content-visibility: visible;
+      will-change: transform;
+      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3);
+    }
