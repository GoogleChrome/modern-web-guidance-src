+  <script>
+    (() => {
+      const board = document.querySelector('.board');
+      const columns = [...board.querySelectorAll('.board-column')];
+      const THRESHOLD = 4;
+      let drag = null; // { card, placeholder, offsetX, offsetY, x, y, raf, list, sx, sy }
+
+      const updateCount = (column) => {
+        column.querySelector('.board-count').textContent =
+          column.querySelector('.board-list').childElementCount - (drag && column.contains(drag.placeholder) ? 1 : 0);
+      };
+
+      board.addEventListener('pointerdown', (e) => {
+        const card = e.target.closest('.card');
+        if (!card || e.button !== 0 || drag) return;
+        drag = { card, placeholder: null, sx: e.clientX, sy: e.clientY, x: e.clientX, y: e.clientY, raf: 0, started: false, pointerId: e.pointerId };
+        window.addEventListener('pointermove', onMove);
+        window.addEventListener('pointerup', onEnd);
+        window.addEventListener('pointercancel', onEnd);
+      });
+
+      function startDrag() {
+        const { card } = drag;
+        const rect = card.getBoundingClientRect();
+        const placeholder = document.createElement('div');
+        placeholder.className = 'card-placeholder';
+        placeholder.style.height = rect.height + 'px';
+        drag.placeholder = placeholder;
+        drag.offsetX = drag.sx - rect.left;
+        drag.offsetY = drag.sy - rect.top;
+        drag.started = true;
+        drag.fromColumn = card.closest('.board-column');
+        card.before(placeholder);
+        card.style.width = rect.width + 'px';
+        card.classList.add('dragging');
+        document.body.appendChild(card);
+        document.body.style.cursor = 'grabbing';
+      }
+
+      function onMove(e) {
+        if (e.pointerId !== drag.pointerId) return;
+        drag.x = e.clientX;
+        drag.y = e.clientY;
+        if (!drag.started) {
+          if (Math.hypot(drag.x - drag.sx, drag.y - drag.sy) < THRESHOLD) return;
+          startDrag();
+        }
+        if (!drag.raf) drag.raf = requestAnimationFrame(frame);
+      }
+
+      // Runs at most once per frame: one transform write, plus a hit test that only mutates the DOM when the slot changes.
+      function frame() {
+        drag.raf = 0;
+        const { card, placeholder, x, y } = drag;
+        card.style.transform = `translate3d(${x - drag.offsetX}px, ${y - drag.offsetY}px, 0)`;
+
+        const hit = document.elementFromPoint(x, y);
+        const column = hit && hit.closest('.board-column');
+        columns.forEach((c) => c.classList.toggle('drop-target', c === column));
+        if (!column) return;
+
+        const list = column.querySelector('.board-list');
+        const over = hit.closest('.card');
+        let before = null; // null => append
+        if (over && over !== placeholder) {
+          const r = over.getBoundingClientRect();
+          before = y < r.top + r.height / 2 ? over : over.nextElementSibling;
+        } else if (over === placeholder) {
+          return;
+        }
+        if (placeholder.parentNode === list && placeholder.nextElementSibling === before) return;
+        list.insertBefore(placeholder, before);
+      }
+
+      function onEnd(e) {
+        if (e.pointerId !== drag.pointerId) return;
+        window.removeEventListener('pointermove', onMove);
+        window.removeEventListener('pointerup', onEnd);
+        window.removeEventListener('pointercancel', onEnd);
+        if (drag.raf) cancelAnimationFrame(drag.raf);
+        if (drag.started) {
+          const { card, placeholder, fromColumn } = drag;
+          const toColumn = placeholder.closest('.board-column') || fromColumn;
+          if (placeholder.isConnected) placeholder.replaceWith(card);
+          else fromColumn.querySelector('.board-list').appendChild(card);
+          card.classList.remove('dragging');
+          card.style.transform = card.style.width = '';
+          document.body.style.cursor = '';
+          columns.forEach((c) => c.classList.remove('drop-target'));
+          drag = null;
+          updateCount(fromColumn);
+          if (toColumn !== fromColumn) updateCount(toColumn);
+          card.focus({ preventScroll: true });
+        } else {
+          drag = null;
+        }
+      }
+
+      board.addEventListener('keydown', (e) => {
+        const card = e.target.closest('.card');
+        if (!card || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
+        const from = card.closest('.board-column');
+        const to = columns[columns.indexOf(from) + (e.key === 'ArrowRight' ? 1 : -1)];
+        if (!to) return;
+        e.preventDefault();
+        to.querySelector('.board-list').appendChild(card);
+        updateCount(from);
+        updateCount(to);
+        card.focus();
+      });
+    })();
+  </script>
+
