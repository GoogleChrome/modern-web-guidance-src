+  <script>
+    (() => {
+      const board = document.querySelector('.board');
+      const status = document.getElementById('board-status');
+      const columns = [...board.querySelectorAll('.board-column')];
+      let drag = null;
+
+      const updateCount = (column) => {
+        column.querySelector('.column-count').textContent =
+          column.querySelector('.column-cards').children.length;
+      };
+      columns.forEach(updateCount);
+
+      // Only the source and destination columns are touched, so work stays local.
+      function moveCard(card, column, beforeNode = null) {
+        const from = card.closest('.board-column');
+        column.querySelector('.column-cards').insertBefore(card, beforeNode);
+        updateCount(from);
+        if (from !== column) updateCount(column);
+        status.textContent = `${card.querySelector('h3').textContent} moved to ${column.dataset.status}`;
+      }
+
+      function frame() {
+        drag.raf = 0;
+        drag.ghost.style.transform = `translate3d(${drag.x - drag.dx}px, ${drag.y - drag.dy}px, 0)`;
+        const column = document.elementFromPoint(drag.x, drag.y)?.closest('.board-column') ?? null;
+        if (column !== drag.target) {
+          drag.target?.classList.remove('drop-target');
+          column?.classList.add('drop-target');
+          drag.target = column;
+        }
+      }
+
+      board.addEventListener('pointerdown', (e) => {
+        const handle = e.target.closest('.drag-handle');
+        if (e.button !== 0 || !handle || drag) return;
+        const card = handle.closest('.card');
+        const rect = card.getBoundingClientRect();
+        const ghost = card.cloneNode(true);
+        ghost.classList.add('drag-ghost');
+        ghost.removeAttribute('tabindex');
+        ghost.style.width = `${rect.width}px`;
+        ghost.style.transform = `translate3d(${rect.left}px, ${rect.top}px, 0)`;
+        document.body.append(ghost);
+        card.classList.add('is-dragging');
+        board.classList.add('is-dragging');
+        handle.setPointerCapture(e.pointerId);
+        drag = { card, ghost, id: e.pointerId, dx: e.clientX - rect.left, dy: e.clientY - rect.top,
+                 x: e.clientX, y: e.clientY, raf: 0, target: null };
+        frame();
+      });
+
+      board.addEventListener('pointermove', (e) => {
+        if (!drag || e.pointerId !== drag.id) return;
+        drag.x = e.clientX;
+        drag.y = e.clientY;
+        drag.raf ||= requestAnimationFrame(frame);
+      });
+
+      function endDrag(e, drop) {
+        if (!drag || e.pointerId !== drag.id) return;
+        cancelAnimationFrame(drag.raf);
+        const { card, ghost, target, x, y } = drag;
+        drag = null;
+        ghost.remove();
+        target?.classList.remove('drop-target');
+        board.classList.remove('is-dragging');
+        card.classList.remove('is-dragging');
+        if (!drop || !target) return;
+        const over = document.elementFromPoint(x, y)?.closest('.card');
+        let before = null;
+        if (over && over !== card && target.contains(over)) {
+          const r = over.getBoundingClientRect();
+          before = y < r.top + r.height / 2 ? over : over.nextElementSibling;
+        }
+        moveCard(card, target, before);
+      }
+      board.addEventListener('pointerup', (e) => endDrag(e, true));
+      board.addEventListener('pointercancel', (e) => endDrag(e, false));
+
+      // Keyboard alternative: left/right arrows move a focused card between columns.
+      board.addEventListener('keydown', (e) => {
+        const card = e.target.closest('.card');
+        if (!card || e.target !== card || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
+        const i = columns.indexOf(card.closest('.board-column')) + (e.key === 'ArrowRight' ? 1 : -1);
+        if (!columns[i]) return;
+        e.preventDefault();
+        moveCard(card, columns[i]);
+        card.focus({ preventScroll: true });
+      });
+    })();
+  </script>
