+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var tempEl = document.getElementById('roast-temp-value');
+      var ctx = canvas.getContext('2d');
+      var W = canvas.width, H = canvas.height;
+
+      var raf = window.requestAnimationFrame || function (cb) {
+        return setTimeout(function () { cb(Date.now()); }, 16);
+      };
+      var caf = window.cancelAnimationFrame || clearTimeout;
+
+      // Beans
+      var beans = [];
+      for (var i = 0; i < 14; i++) {
+        beans.push({
+          x: Math.random() * W,
+          y: Math.random() * H,
+          vx: (Math.random() - 0.5) * 1.6,
+          vy: (Math.random() - 0.5) * 1.6,
+          r: 14 + Math.random() * 6,
+          angle: Math.random() * Math.PI * 2,
+          spin: (Math.random() - 0.5) * 0.06
+        });
+      }
+
+      var temp = 180;
+      var roast = 0; // 0 (green) .. 1 (dark)
+
+      function beanColor(t) {
+        var r = Math.round(150 - 110 * t);
+        var g = Math.round(110 - 85 * t);
+        var b = Math.round(60 - 45 * t);
+        return 'rgb(' + r + ',' + g + ',' + b + ')';
+      }
+
+      function draw() {
+        ctx.clearRect(0, 0, W, H);
+        var color = beanColor(roast);
+        for (var i = 0; i < beans.length; i++) {
+          var b = beans[i];
+          b.x += b.vx; b.y += b.vy; b.angle += b.spin;
+          if (b.x < b.r || b.x > W - b.r) b.vx *= -1;
+          if (b.y < b.r || b.y > H - b.r) b.vy *= -1;
+          ctx.save();
+          ctx.translate(b.x, b.y);
+          ctx.rotate(b.angle);
+          ctx.fillStyle = color;
+          ctx.beginPath();
+          ctx.ellipse(0, 0, b.r, b.r * 0.7, 0, 0, Math.PI * 2);
+          ctx.fill();
+          ctx.strokeStyle = 'rgba(0,0,0,0.45)';
+          ctx.lineWidth = 2;
+          ctx.beginPath();
+          ctx.moveTo(-b.r * 0.8, 0);
+          ctx.quadraticCurveTo(0, b.r * 0.3, b.r * 0.8, 0);
+          ctx.stroke();
+          ctx.restore();
+        }
+      }
+
+      var rafId = null;
+      function loop() {
+        draw();
+        rafId = raf(loop);
+      }
+
+      var timerId = null;
+      function tick() {
+        // Temperature climbs toward ~230C, with jitter; then resets for a new batch
+        temp += (230 - temp) * 0.03 + (Math.random() - 0.5) * 1.5;
+        roast = Math.min(1, Math.max(0, (temp - 180) / 50));
+        if (temp > 228) { temp = 180; roast = 0; }
+        tempEl.textContent = temp.toFixed(1);
+      }
+
+      var running = false;
+      function start() {
+        if (running) return;
+        running = true;
+        rafId = raf(loop);
+        timerId = setInterval(tick, 500);
+      }
+      function stop() {
+        if (!running) return;
+        running = false;
+        caf(rafId);
+        clearInterval(timerId);
+        rafId = timerId = null;
+      }
+
+      var inView = false;
+      var pageVisible = !document.hidden;
+      function update() {
+        if (inView && pageVisible) start(); else stop();
+      }
+
+      if (document.addEventListener) {
+        document.addEventListener('visibilitychange', function () {
+          pageVisible = !document.hidden;
+          update();
+        });
+      }
+
+      if ('IntersectionObserver' in window) {
+        new IntersectionObserver(function (entries) {
+          inView = entries[entries.length - 1].isIntersecting;
+          update();
+        }).observe(widget);
+      } else {
+        // Fallback for older browsers: geometry check on scroll/resize
+        var check = function () {
+          var rect = widget.getBoundingClientRect();
+          var vh = window.innerHeight || document.documentElement.clientHeight;
+          inView = rect.bottom > 0 && rect.top < vh;
+          update();
+        };
+        window.addEventListener('scroll', check, false);
+        window.addEventListener('resize', check, false);
+        check();
+      }
+    })();
+  </script>
+
 </body>
 
