+    .nested-curve-parent {
+      --card-radius: 32px;
+      --card-padding: 24px;
+      background: white;
+      padding: var(--card-padding);
+      border-radius: var(--card-radius);
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: clip;
+      overflow-clip-margin: content-box;
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      height: 220px;
+      object-fit: cover;
+    }
+
+    .nested-curve-parent .card-body {
+      padding: 20px 0 0;
+    }
+
+    .nested-curve-parent .card-footer {
+      background: var(--primary);
+      color: white;
+      padding: 14px 20px;
+      margin-top: 20px;
+    }
+
+    /* Clip overflowing text, but let the glow bleed up to 15px outside. */
+    .safety-zone-parent {
+      margin-top: 40px;
+      padding: 40px 20px;
+      background: var(--secondary);
+      border-radius: 12px;
+      text-align: center;
+      overflow: clip;
+      overflow-clip-margin: 15px;
+    }
+
+    .safety-zone-parent p {
+      white-space: nowrap;
+      margin-bottom: 20px;
+    }
+
+    .glow-btn {
+      background: var(--accent);
+      color: var(--text);
+      border: none;
+      border-radius: 8px;
+      padding: 14px 32px;
+      font-size: 1rem;
+      font-weight: bold;
+      cursor: pointer;
+      box-shadow: 0 0 12px 4px rgba(255, 171, 64, 0.9),
+        0 0 15px 0 rgba(255, 171, 64, 0.6);
+    }
+
