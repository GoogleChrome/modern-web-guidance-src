+  <script>
+    // Keep aria-invalid in sync with :user-invalid, which (unlike :invalid) only
+    // matches after the user has interacted, so screen readers don't announce an
+    // error as soon as focus lands on an empty required field.
+    (function () {
+      var form = document.querySelector('.newsletter');
+      var input = form.querySelector('input');
+      var error = form.querySelector('.newsletter-error');
+      var supportsUserInvalid = CSS.supports('selector(:user-invalid)');
+
+      function sync() {
+        var invalid = supportsUserInvalid ? input.matches(':user-invalid') : !input.validity.valid;
+        if (invalid) {
+          input.setAttribute('aria-invalid', 'true');
+          error.textContent = input.validity.valueMissing
+            ? 'Please enter your email address.'
+            : 'Please enter a valid email address.';
+        } else {
+          input.removeAttribute('aria-invalid');
+          error.textContent = '';
+        }
+      }
+
+      input.addEventListener('blur', sync);
+      input.addEventListener('input', sync);
+
+      form.addEventListener('submit', function (e) {
+        if (!input.validity.valid) {
+          e.preventDefault();
+          // :user-invalid may not match yet if the user never touched the field
+          // (e.g. submit pressed directly); force the error state in that case.
+          if (!supportsUserInvalid || !input.matches(':user-invalid')) {
+            input.setAttribute('aria-invalid', 'true');
+            error.textContent = input.validity.valueMissing
+              ? 'Please enter your email address.'
+              : 'Please enter a valid email address.';
+          }
+          input.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
