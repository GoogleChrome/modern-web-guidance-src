+    <form class="newsletter" action="/newsletter" method="post" novalidate>
+      <label for="newsletter-email">Join our newsletter</label>
+      <div class="newsletter-row">
+        <input type="email" id="newsletter-email" name="email" placeholder="you@example.com" autocomplete="email"
