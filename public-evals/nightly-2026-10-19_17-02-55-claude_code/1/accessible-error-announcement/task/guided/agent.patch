+  <script>
+    // Mirror the visual :user-invalid state into aria-invalid, so screen readers
+    // don't announce an error just because an untouched required field got focus.
+    const syncAriaInvalid = (input) => {
+      if (input.matches(':user-invalid')) {
+        input.setAttribute('aria-invalid', 'true');
+      } else {
+        input.removeAttribute('aria-invalid');
+      }
+    };
+
+    document.querySelectorAll('.newsletter input').forEach((input) => {
+      // blur: the user has left the field; invalid: a submit attempt failed validation
+      input.addEventListener('blur', () => syncAriaInvalid(input));
+      input.addEventListener('invalid', () => syncAriaInvalid(input));
+      // Once flagged, clear (or update) the error as the user types
+      input.addEventListener('input', () => {
+        if (input.hasAttribute('aria-invalid')) syncAriaInvalid(input);
+      });
+    });
+  </script>
+
 </body>
 
