+    <section style="margin-top: 50px;">
+      <h2 style="text-align: center;">Dial In Your Brew</h2>
+      <div class="card slider-card">
+        <div class="slider-header">
+          <label for="strength">Brew strength</label>
+          <output id="strength-out" for="strength">Medium</output>
+        </div>
+        <input type="range" id="strength" class="range" min="1" max="5" step="1" value="3"
+          aria-describedby="strength-scale">
+        <div class="slider-scale" id="strength-scale" aria-hidden="true">
+          <span>Mild</span>
+          <span>Bold</span>
+        </div>
+      </div>
+    </section>
   </main>
 
+  <script>
+    // Progressive enhancement: the native input handles all interaction and
+    // accessibility; this only syncs the fill width and a readable value label.
+    (function () {
+      var input = document.getElementById('strength');
+      var out = document.getElementById('strength-out');
+      var names = ['Mild', 'Light', 'Medium', 'Strong', 'Bold'];
+
+      function sync() {
+        var min = +input.min, max = +input.max, val = +input.value;
+        var pct = (val - min) / (max - min);
+        var thumb = parseFloat(getComputedStyle(input).getPropertyValue('--thumb')) || 24;
+        // Align fill end with thumb center, which is inset by half the thumb width
+        input.style.setProperty('--fill', 'calc(' + (pct * 100) + '% + ' + (0.5 - pct) * thumb + 'px)');
+        var label = names[val - 1] || val;
+        out.textContent = label;
+        input.setAttribute('aria-valuetext', label);
+      }
+
+      input.addEventListener('input', sync);
+      sync();
+    })();
+  </script>
