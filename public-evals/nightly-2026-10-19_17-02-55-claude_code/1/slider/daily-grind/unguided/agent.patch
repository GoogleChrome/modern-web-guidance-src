+    /* Range slider: native <input type="range"> with custom styling */
+    .slider-card {
+      max-width: 520px;
+      margin: 20px auto 0;
+    }
+
+    .slider-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      margin-bottom: 14px;
+    }
+
+    .slider-header label {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .slider-header output {
+      font-variant-numeric: tabular-nums;
+      font-weight: 600;
+    }
+
+    .slider-scale {
+      display: flex;
+      justify-content: space-between;
+      margin-top: 6px;
+      font-size: 0.8rem;
+      opacity: 0.75;
+    }
+
+    input[type="range"].range {
+      --track-h: 8px;
+      --thumb: 24px;
+      --track-bg: var(--secondary);
+      --fill-bg: var(--primary);
+      --fill: 50%; /* kept in sync by script; defaults are fine without JS */
+      -webkit-appearance: none;
+      appearance: none;
+      width: 100%;
+      height: var(--thumb);
+      background: transparent;
+      cursor: pointer;
+      display: block;
+    }
+
+    /* Remove native outline; focus is shown on the thumb instead */
+    input[type="range"].range:focus {
+      outline: none;
+    }
+
+    /* Track + fill (WebKit/Blink) */
+    input[type="range"].range::-webkit-slider-runnable-track {
+      height: var(--track-h);
+      border-radius: var(--track-h);
+      background: linear-gradient(var(--fill-bg), var(--fill-bg)) 0 / var(--fill) 100% no-repeat,
+        var(--track-bg);
+    }
+
+    /* Track + fill (Firefox) */
+    input[type="range"].range::-moz-range-track {
+      height: var(--track-h);
+      border-radius: var(--track-h);
+      background: var(--track-bg);
+    }
+
+    input[type="range"].range::-moz-range-progress {
+      height: var(--track-h);
+      border-radius: var(--track-h);
+      background: var(--fill-bg);
+    }
+
+    /* Thumb */
+    input[type="range"].range::-webkit-slider-thumb {
+      -webkit-appearance: none;
+      appearance: none;
+      width: var(--thumb);
+      height: var(--thumb);
+      margin-top: calc((var(--track-h) - var(--thumb)) / 2);
+      border-radius: 50%;
+      background: var(--accent);
+      border: 3px solid var(--primary);
+      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
+      transition: transform 0.15s, box-shadow 0.15s;
+    }
+
+    input[type="range"].range::-moz-range-thumb {
+      width: calc(var(--thumb) - 6px);
+      height: calc(var(--thumb) - 6px);
+      border-radius: 50%;
+      background: var(--accent);
+      border: 3px solid var(--primary);
+      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
+      transition: transform 0.15s, box-shadow 0.15s;
+    }
+
+    /* Hover / active */
+    input[type="range"].range:hover::-webkit-slider-thumb {
+      transform: scale(1.1);
+    }
+
+    input[type="range"].range:hover::-moz-range-thumb {
+      transform: scale(1.1);
+    }
+
+    input[type="range"].range:active::-webkit-slider-thumb {
+      transform: scale(1.2);
+    }
+
+    input[type="range"].range:active::-moz-range-thumb {
+      transform: scale(1.2);
+    }
+
+    /* Keyboard focus: high-contrast double ring */
+    input[type="range"].range:focus-visible::-webkit-slider-thumb {
+      box-shadow: 0 0 0 3px var(--light), 0 0 0 6px var(--text);
+    }
+
+    input[type="range"].range:focus-visible::-moz-range-thumb {
+      box-shadow: 0 0 0 3px var(--light), 0 0 0 6px var(--text);
+    }
+
+    /* Disabled */
+    input[type="range"].range:disabled {
+      cursor: not-allowed;
+      opacity: 0.5;
+    }
+
+    /* Forced colors (Windows High Contrast) */
+    @media (forced-colors: active) {
+      input[type="range"].range::-webkit-slider-runnable-track {
+        background: ButtonText;
+      }
+
+      input[type="range"].range::-webkit-slider-thumb {
+        background: Highlight;
+        border-color: ButtonText;
+      }
+
+      input[type="range"].range::-moz-range-track {
+        background: ButtonText;
+      }
+
+      input[type="range"].range::-moz-range-thumb {
+        background: Highlight;
+        border-color: ButtonText;
+      }
+
+      input[type="range"].range:focus-visible::-webkit-slider-thumb {
+        outline: 2px solid Highlight;
+        outline-offset: 3px;
+      }
+
+      input[type="range"].range:focus-visible::-moz-range-thumb {
+        outline: 2px solid Highlight;
+        outline-offset: 3px;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      input[type="range"].range::-webkit-slider-thumb,
+      input[type="range"].range::-moz-range-thumb {
+        transition: none;
+      }
+    }
+
