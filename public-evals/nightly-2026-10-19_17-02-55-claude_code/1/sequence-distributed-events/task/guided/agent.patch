+  <script type="module">
+    // Temporal is not available in Safari; load a polyfill only when needed.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const events = [];
+    const logEl = document.getElementById('order-log');
+
+    function recordEvent(eventType, nodeId) {
+      return { nodeId, eventType, timestamp: Temporal.Now.instant() };
+    }
+
+    function sequenceEvents(list) {
+      return [...list].sort((a, b) => Temporal.Instant.compare(a.timestamp, b.timestamp));
+    }
+
+    function renderTelemetry() {
+      const sorted = sequenceEvents(events);
+      logEl.replaceChildren(...sorted.map((evt, i) => {
+        const li = document.createElement('li');
+        let text = `#${i + 1} ${evt.eventType}@${evt.nodeId} ${evt.timestamp.toString({ fractionalSecondDigits: 9 })}`;
+        if (i > 0) {
+          const ns = evt.timestamp.since(sorted[i - 1].timestamp).total('nanoseconds');
+          text += ` (+${ns}ns)`;
+        }
+        li.textContent = text;
+        return li;
+      }));
+      const last = sorted.length - 1;
+      if (last > 0) {
+        const ns = sorted[last].timestamp.since(sorted[last - 1].timestamp).total('nanoseconds');
+        console.log(`Delay between order #${last} and #${last + 1}: ${ns}ns`);
+      }
+    }
+
+    document.getElementById('order-btn').addEventListener('click', () => {
+      events.push(recordEvent('coffee-order', `barista-${(events.length % 3) + 1}`));
+      renderTelemetry();
+    });
+  </script>
 </body>
 
