+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      const items = gallery.querySelectorAll('.gallery-item');
+      const thumbs = document.querySelectorAll('.thumbnail');
+      let activeIndex = 0;
+      let lastLeft = gallery.scrollLeft;
+      let settleTimer;
+
+      function clamp(i) {
+        return Math.max(0, Math.min(items.length - 1, i));
+      }
+
+      function setPending(index) {
+        thumbs.forEach((t, i) => t.classList.toggle('pending', i === index && i !== activeIndex));
+      }
+
+      function settle() {
+        activeIndex = clamp(Math.round(gallery.scrollLeft / gallery.clientWidth));
+        thumbs.forEach((t, i) => {
+          t.classList.remove('pending');
+          t.classList.toggle('active', i === activeIndex);
+          if (i === activeIndex) t.setAttribute('aria-current', 'true');
+          else t.removeAttribute('aria-current');
+        });
+      }
+
+      gallery.addEventListener('scroll', () => {
+        const left = gallery.scrollLeft;
+        const pos = left / gallery.clientWidth;
+        const forward = left > lastLeft;
+        lastLeft = left;
+
+        // Target is the item in the direction of travel (ignoring sub-pixel drift).
+        if (left !== Math.round(pos) * gallery.clientWidth) {
+          setPending(clamp(forward ? Math.ceil(pos - 0.001) : Math.floor(pos + 0.001)));
+        }
+
+        // Fallback for browsers without `scrollend`.
+        if (!('onscrollend' in window)) {
+          clearTimeout(settleTimer);
+          settleTimer = setTimeout(settle, 120);
+        }
+      }, { passive: true });
+
+      gallery.addEventListener('scrollend', settle);
+
+      thumbs.forEach((thumb, i) => {
+        thumb.addEventListener('click', () => {
+          items[i].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
+        });
+      });
+
+      settle();
+    })();
+  </script>
+
