index 0000000..41da3ac
--- /dev/null
+++ b/secure-box.js
@@ -0,0 +1,106 @@
+// Hybrid post-quantum "sealed box" for the browser.
+//
+//   key agreement : X25519 (WebCrypto) + ML-KEM-768 (vendored noble, FIPS 203)
+//   KDF           : HKDF-SHA-256 over both secrets, bound to the whole transcript
+//   encryption    : AES-256-GCM, header + caller context authenticated as AAD
+//
+// The session key is safe as long as EITHER X25519 or ML-KEM-768 holds.
+import { ml_kem768 } from './vendor/mlkem768.js';
+
+const VERSION = 1;
+const LABEL = new TextEncoder().encode('daily-grind/seal/v1/x25519+mlkem768');
+const enc = new TextEncoder();
+const dec = new TextDecoder();
+
+const concat = (...parts) => {
+  const out = new Uint8Array(parts.reduce((n, p) => n + p.length, 0));
+  let o = 0;
+  for (const p of parts) { out.set(p, o); o += p.length; }
+  return out;
+};
+
+export const b64u = {
+  enc: (u8) => btoa(String.fromCharCode(...u8)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, ''),
+  dec: (s) => Uint8Array.from(atob(s.replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0)),
+};
+
+export async function isSupported() {
+  try {
+    await crypto.subtle.generateKey({ name: 'X25519' }, false, ['deriveBits']);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** Recipient key pair. Private halves never leave this object. */
+export async function generateRecipientKeys() {
+  const x = await crypto.subtle.generateKey({ name: 'X25519' }, false, ['deriveBits']);
+  const pq = ml_kem768.keygen();
+  return {
+    publicKey: {
+      x25519: new Uint8Array(await crypto.subtle.exportKey('raw', x.publicKey)),
+      mlkem768: pq.publicKey,
+    },
+    privateKey: { x25519: x.privateKey, mlkem768: pq.secretKey },
+  };
+}
+
+const importX25519Public = (raw) => crypto.subtle.importKey('raw', raw, { name: 'X25519' }, true, []);
+
+async function deriveKey(ssX, ssPQ, transcript, usage) {
+  // HKDF info is capped at 1024 bytes by some engines, so bind the transcript via its hash.
+  const transcriptHash = new Uint8Array(await crypto.subtle.digest('SHA-256', transcript));
+  const ikm = await crypto.subtle.importKey('raw', concat(ssX, ssPQ), 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey(
+    { name: 'HKDF', hash: 'SHA-256', salt: new Uint8Array(32), info: concat(LABEL, transcriptHash) },
+    ikm,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    [usage],
+  );
+}
+
+const header = (ephX, ctPQ) => concat(Uint8Array.of(VERSION), ephX, ctPQ);
+
+/** Encrypt `plaintext` (string) to a recipient public key. `context` is authenticated but not secret. */
+export async function seal(recipientPub, plaintext, context = '') {
+  const eph = await crypto.subtle.generateKey({ name: 'X25519' }, true, ['deriveBits']);
+  const ephX = new Uint8Array(await crypto.subtle.exportKey('raw', eph.publicKey));
+  const ssX = new Uint8Array(await crypto.subtle.deriveBits(
+    { name: 'X25519', public: await importX25519Public(recipientPub.x25519) }, eph.privateKey, 256));
+  const { cipherText: ctPQ, sharedSecret: ssPQ } = ml_kem768.encapsulate(recipientPub.mlkem768);
+
+  // Transcript binds both public keys and both ciphertexts into the key.
+  const transcript = concat(ephX, ctPQ, recipientPub.x25519, recipientPub.mlkem768);
+  const key = await deriveKey(ssX, ssPQ, transcript, 'encrypt');
+  ssX.fill(0); ssPQ.fill(0);
+
+  const iv = crypto.getRandomValues(new Uint8Array(12)); // key is single-use, so a random nonce is safe
+  const aad = concat(header(ephX, ctPQ), enc.encode(context));
+  const ct = new Uint8Array(await crypto.subtle.encrypt(
+    { name: 'AES-GCM', iv, additionalData: aad, tagLength: 128 }, key, enc.encode(plaintext)));
+
+  return { v: VERSION, kem: 'X25519+ML-KEM-768', ctx: context,
+    ekX: b64u.enc(ephX), ekPQ: b64u.enc(ctPQ), iv: b64u.enc(iv), ct: b64u.enc(ct) };
+}
+
+/** Decrypt an envelope produced by `seal`. Throws if anything was tampered with. */
+export async function open(privateKey, publicKey, envelope) {
+  if (envelope.v !== VERSION) throw new Error('Unsupported envelope version');
+  const ephX = b64u.dec(envelope.ekX);
+  const ctPQ = b64u.dec(envelope.ekPQ);
+  if (ephX.length !== 32 || ctPQ.length !== 1088) throw new Error('Malformed envelope');
+
+  const ssX = new Uint8Array(await crypto.subtle.deriveBits(
+    { name: 'X25519', public: await importX25519Public(ephX) }, privateKey.x25519, 256));
+  const ssPQ = ml_kem768.decapsulate(ctPQ, privateKey.mlkem768); // implicit rejection: bad ct yields a random key
+  const transcript = concat(ephX, ctPQ, publicKey.x25519, publicKey.mlkem768);
+  const key = await deriveKey(ssX, ssPQ, transcript, 'decrypt');
+  ssX.fill(0); ssPQ.fill(0);
+
+  const aad = concat(header(ephX, ctPQ), enc.encode(envelope.ctx ?? ''));
+  const pt = await crypto.subtle.decrypt(
+    { name: 'AES-GCM', iv: b64u.dec(envelope.iv), additionalData: aad, tagLength: 128 }, key, b64u.dec(envelope.ct));
+  return dec.decode(pt);
+}
