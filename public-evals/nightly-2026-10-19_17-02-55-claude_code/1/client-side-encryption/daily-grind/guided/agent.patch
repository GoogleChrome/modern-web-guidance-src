+  <script type="module">
+    // Envelope encryption: the KEM (hybrid post-quantum when available) establishes a
+    // fresh shared key per note, which then encrypts the note with an AEAD cipher.
+    const KEM_NAMES = { 1184: 'ML-KEM-768', 1216: 'MLKEM768-X25519', 1568: 'ML-KEM-1024' };
+    const PQ_SUITE = 'MLKEM768-X25519+ChaCha20-Poly1305';
+    const CLASSIC_SUITE = 'X25519+HKDF+AES-GCM';
+    const encoder = new TextEncoder();
+    const decoder = new TextDecoder();
+
+    const supportsPostQuantum = () =>
+      typeof globalThis.SubtleCrypto?.supports === 'function' &&
+      SubtleCrypto.supports('encapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305');
+
+    const toBase64 = (bytes) => btoa(String.fromCharCode(...new Uint8Array(bytes)));
+
+    async function deriveClassicKey(privateKey, peerPublicKey, info) {
+      const bits = await crypto.subtle.deriveBits({ name: 'X25519', public: peerPublicKey }, privateKey, 256);
+      const hkdfKey = await crypto.subtle.importKey('raw', bits, 'HKDF', false, ['deriveKey']);
+      return crypto.subtle.deriveKey(
+        { name: 'HKDF', hash: 'SHA-256', salt: new Uint8Array(32), info },
+        hkdfKey,
+        { name: 'AES-GCM', length: 256 },
+        false,
+        ['encrypt', 'decrypt'],
+      );
+    }
+
+    async function generateRecipientKeys() {
+      if (supportsPostQuantum()) {
+        const keyPair = await crypto.subtle.generateKey('MLKEM768-X25519', false, ['encapsulateKey', 'decapsulateKey']);
+        const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey('raw-public', keyPair.publicKey));
+        return { suite: PQ_SUITE, keyPair, publicKeyBytes };
+      }
+      const keyPair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+      const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey('raw', keyPair.publicKey));
+      return { suite: CLASSIC_SUITE, keyPair, publicKeyBytes };
+    }
+
+    async function encapsulate(publicKeyBytes, info) {
+      const kemName = KEM_NAMES[publicKeyBytes.byteLength];
+      if (kemName) {
+        const publicKey = await crypto.subtle.importKey('raw-public', publicKeyBytes, kemName, true, ['encapsulateKey']);
+        const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+          kemName, publicKey, 'ChaCha20-Poly1305', false, ['encrypt', 'decrypt'],
+        );
+        return { sharedKey, capsule: new Uint8Array(ciphertext) };
+      }
+      const publicKey = await crypto.subtle.importKey('raw', publicKeyBytes, 'X25519', true, []);
+      const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+      const capsule = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+      return { sharedKey: await deriveClassicKey(ephemeral.privateKey, publicKey, info), capsule };
+    }
+
+    async function decapsulate(privateKey, capsule, info) {
+      if (privateKey.algorithm.name !== 'X25519') {
+        return crypto.subtle.decapsulateKey(
+          privateKey.algorithm.name, privateKey, capsule, 'ChaCha20-Poly1305', false, ['encrypt', 'decrypt'],
+        );
+      }
+      const ephemeralPublic = await crypto.subtle.importKey('raw', capsule, 'X25519', true, []);
+      return deriveClassicKey(privateKey, ephemeralPublic, info);
+    }
+
+    // The suite is authenticated as AAD, so it can't be swapped without failing decryption.
+    async function encryptNote(publicKeyBytes, suite, plaintext) {
+      const aad = encoder.encode(suite);
+      const { sharedKey, capsule } = await encapsulate(publicKeyBytes, aad);
+      const iv = crypto.getRandomValues(new Uint8Array(12));
+      const ciphertext = await crypto.subtle.encrypt(
+        { name: sharedKey.algorithm.name, iv, additionalData: aad }, sharedKey, encoder.encode(plaintext),
+      );
+      return { suite, capsule, iv, ciphertext: new Uint8Array(ciphertext) };
+    }
+
+    async function decryptNote(privateKey, { suite, capsule, iv, ciphertext }) {
+      const aad = encoder.encode(suite);
+      const key = await decapsulate(privateKey, capsule, aad);
+      const plain = await crypto.subtle.decrypt({ name: key.algorithm.name, iv, additionalData: aad }, key, ciphertext);
+      return decoder.decode(plain);
+    }
+
+    const form = document.getElementById('note-form');
+    const submit = document.getElementById('note-submit');
+    const suiteEl = document.getElementById('suite');
+    const envelopeEl = document.getElementById('envelope');
+
+    if (!globalThis.crypto?.subtle) {
+      suiteEl.textContent = 'Encryption is unavailable in this browser or on an insecure (non-HTTPS) page.';
+    } else {
+      // Demo: the shop's key pair is generated here, with the private key non-extractable.
+      // In production, the shop's public key would be published and the private key kept server-side.
+      const recipient = await generateRecipientKeys();
+      suiteEl.textContent = recipient.suite === PQ_SUITE
+        ? 'Protection: hybrid post-quantum (ML-KEM-768 + X25519) with ChaCha20-Poly1305.'
+        : 'Protection: X25519 key agreement with AES-256-GCM (post-quantum not supported by this browser).';
+      submit.disabled = false;
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        submit.disabled = true;
+        try {
+          const text = form.elements.note.value;
+          const envelope = await encryptNote(recipient.publicKeyBytes, recipient.suite, text);
+          // Round-trip to confirm authenticity and integrity.
+          const verified = (await decryptNote(recipient.keyPair.privateKey, envelope)) === text;
+          envelopeEl.textContent =
+            `Encrypted envelope (${verified ? 'verified' : 'VERIFICATION FAILED'})\n` +
+            `suite: ${envelope.suite}\n` +
+            `capsule: ${toBase64(envelope.capsule)}\n` +
+            `iv: ${toBase64(envelope.iv)}\n` +
+            `ciphertext: ${toBase64(envelope.ciphertext)}`;
+          form.reset();
+        } catch (error) {
+          envelopeEl.textContent = `Encryption failed: ${error.message}`;
+        } finally {
+          submit.disabled = false;
+        }
+      });
+    }
+  </script>
