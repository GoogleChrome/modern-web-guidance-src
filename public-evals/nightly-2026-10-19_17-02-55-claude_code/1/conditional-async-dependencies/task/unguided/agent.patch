+  <script>
+    (function () {
+      var pop = document.getElementById('rewards-popover');
+      var btn = document.querySelector('[popovertarget="rewards-popover"]');
+
+      // Keep aria-expanded in sync with popover state.
+      pop.addEventListener('toggle', function (e) {
+        btn.setAttribute('aria-expanded', e.newState === 'open');
+      });
+
+      // Load the polyfill only in browsers lacking native Popover support,
+      // and without blocking page load.
+      if (!HTMLElement.prototype.hasOwnProperty('popover')) {
+        var s = document.createElement('script');
+        s.src = 'https://cdn.jsdelivr.net/npm/@oddbird/popover-polyfill@0.5.2/dist/popover.min.js';
+        s.async = true;
+        document.head.appendChild(s);
+      }
+    })();
