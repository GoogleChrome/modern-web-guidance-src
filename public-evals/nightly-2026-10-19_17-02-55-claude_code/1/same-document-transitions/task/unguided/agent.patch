+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const grid = document.getElementById('grid');
+    const hero = document.getElementById('hero');
+    const heroImg = document.getElementById('hero-img');
+    const title = document.getElementById('title');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    history.scrollRestoration = 'manual';
+
+    // Build the thumbnails; the title link doubles as the accessible, stretched click target.
+    grid.innerHTML = favorites.map(f => `
+      <div class="thumbnail" data-id="${f.id}">
+        <img src="${f.image}" alt="${f.alt}" loading="lazy">
+        <div class="overlay">
+          <h2 class="title"><a href="#/favorites/${f.id}">${f.title}</a></h2>
+          <p>${f.summary}</p>
+        </div>
+      </div>`).join('');
+
+    const thumbnailFor = id => grid.querySelector(`.thumbnail[data-id="${id}"]`);
+
+    function routeFromHash() {
+      const match = location.hash.match(/^#\/favorites\/([\w-]+)$/);
+      return match && favorites.some(f => f.id === match[1]) ? match[1] : null;
+    }
+
+    // Elements that take part in the morph for a given view (null = list view of `id`)
+    function sharedElements(view, id) {
+      if (view === 'detail') return [[hero, 'hero'], [title, 'title']];
+      const thumb = thumbnailFor(id);
+      return [[thumb, 'hero'], [thumb.querySelector('.title'), 'title']];
+    }
+
+    function tag(view, id) {
+      sharedElements(view, id).forEach(([el, name]) => { el.style.viewTransitionName = name; });
+    }
+
+    function untag(view, id) {
+      sharedElements(view, id).forEach(([el]) => {
+        el.style.removeProperty('view-transition-name');
+        if (!el.getAttribute('style')) el.removeAttribute('style');
+      });
+    }
+
+    // Swap the DOM to the requested view and move focus to its heading
+    function render(id, { focus = true, scrollY = 0 } = {}) {
+      if (id) {
+        const f = favorites.find(item => item.id === id);
+        title.textContent = f.title;
+        heroImg.src = f.image;
+        heroImg.alt = f.alt;
+        document.getElementById('detail-summary').textContent = f.summary;
+        document.getElementById('detail-description').textContent = f.description;
+        document.title = `${f.title} | The Daily Grind`;
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        window.scrollTo(0, 0);
+      } else {
+        document.title = 'The Daily Grind | Artisanal Coffee';
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        window.scrollTo(0, scrollY);
+      }
+      if (focus) (id ? title : listHeading).focus({ preventScroll: true });
+    }
+
+    let current = null;      // id of the detail being shown, or null for the list
+    let listScroll = 0;
+    let activeTransition = null;
+
+    function navigate(next) {
+      const prev = current;
+      if (prev === next) return;
+      if (activeTransition) activeTransition.skipTransition();
+      if (prev === null) listScroll = window.scrollY;
+      current = next;
+
+      const update = () => render(next, { scrollY: listScroll });
+
+      if (!document.startViewTransition || reducedMotion.matches) {
+        update();
+        return;
+      }
+
+      // Name the outgoing elements so they are captured as the "old" side of the morph
+      const outgoing = prev === null ? ['list', next] : ['detail', prev];
+      const incoming = next === null ? ['list', prev] : ['detail', next];
+      tag(...outgoing);
+
+      const transition = document.startViewTransition(() => {
+        untag(...outgoing);
+        update();
+        tag(...incoming);
+      });
+      activeTransition = transition;
+
+      // Clean up the temporary names once the animation has finished (or been skipped)
+      transition.finished.finally(() => {
+        // A newer navigation owns the names now and cleans up after itself
+        if (activeTransition !== transition) return;
+        untag(...outgoing);
+        untag(...incoming);
+        activeTransition = null;
+      });
+    }
+
+    window.addEventListener('hashchange', () => navigate(routeFromHash()));
+
+    // Initial render (deep links supported), no animation and no focus stealing
+    current = routeFromHash();
+    render(current, { focus: false });
+  </script>
