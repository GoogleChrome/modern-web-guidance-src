+  <script>
+    const img = (id) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=1200&q=80`;
+    const items = [
+      {
+        slug: 'maple-oat-latte',
+        title: 'Maple Oat Latte',
+        summary: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        description: 'Two shots of our house espresso, steamed oat milk, and a drizzle of Vermont maple syrup. Cozy, lightly sweet, and dairy-free.',
+        image: img('1509042239860-f550ce710b93'),
+        alt: 'A latte in a ceramic cup on a wooden table'
+      },
+      {
+        slug: 'dark-roast-espresso',
+        title: 'Dark Roast Espresso',
+        summary: 'Bold, smokey, and perfect for a morning boost.',
+        description: 'A dark, slow-roasted blend pulled short and strong, with notes of cocoa and toasted oak. Best enjoyed straight.',
+        image: img('1442512595331-e89e73853f31'),
+        alt: 'A freshly pulled espresso shot'
+      },
+      {
+        slug: 'cold-brew',
+        title: 'Cold Brew',
+        summary: 'Steeped for 18 hours for maximum smoothness.',
+        description: 'Coarsely ground beans steeped cold for 18 hours, then served over ice for a smooth, low-acid cup.',
+        image: img('1461023058943-07fcbe16d735'),
+        alt: 'Iced cold brew coffee in a glass'
+      }
+    ];
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const grid = document.getElementById('grid');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    let current = null; // slug currently shown, or null for the list
+    let listScroll = 0;
+    let navId = 0;
+
+    grid.innerHTML = items.map((item) => `
+      <a class="thumbnail" href="#/${item.slug}" data-slug="${item.slug}">
+        <img src="${item.image}" alt="${item.alt}" loading="lazy">
+        <div class="body">
+          <h2 class="title">${item.title}</h2>
+          <p>${item.summary}</p>
+          <span class="btn">View Details</span>
+        </div>
+      </a>`).join('');
+
+    const thumbnailFor = (slug) => grid.querySelector(`[data-slug="${slug}"]`);
+    const slugFromHash = () => {
+      const slug = location.hash.replace(/^#\/?/, '');
+      return items.some((item) => item.slug === slug) ? slug : null;
+    };
+
+    function showDetail(slug) {
+      const item = items.find((i) => i.slug === slug);
+      const hero = detailPage.querySelector('#hero img');
+      hero.src = item.image;
+      hero.alt = item.alt;
+      detailPage.querySelector('#title').textContent = item.title;
+      detailPage.querySelector('.description').textContent = item.description;
+      listPage.hidden = true;
+      detailPage.hidden = false;
+      scrollTo(0, 0);
+    }
+
+    function showList() {
+      detailPage.hidden = true;
+      listPage.hidden = false;
+      scrollTo(0, listScroll);
+    }
+
+    function render(slug, { animate, focus }) {
+      const goingToDetail = slug !== null;
+      if (goingToDetail && current === null) listScroll = scrollY;
+
+      // Name the thumbnail that morphs into / out of the hero.
+      grid.querySelectorAll('.selected').forEach((el) => el.classList.remove('selected'));
+      const thumb = thumbnailFor(slug ?? current);
+      thumb?.classList.add('selected');
+
+      const update = () => (goingToDetail ? showDetail(slug) : showList());
+      const focusTarget = () =>
+        document.getElementById(goingToDetail ? 'title' : 'list-heading')
+          .focus({ preventScroll: true });
+      current = slug;
+
+      const id = ++navId;
+      const cleanup = () => {
+        // Skip if a newer navigation has taken over the names.
+        if (id === navId) thumb?.classList.remove('selected');
+      };
+
+      if (!animate || !document.startViewTransition || reducedMotion.matches) {
+        update();
+        cleanup();
+        if (focus) focusTarget();
+        return;
+      }
+
+      const transition = document.startViewTransition(update);
+      transition.finished.finally(() => {
+        cleanup();
+        if (focus && id === navId) focusTarget();
+      });
+    }
+
+    addEventListener('hashchange', () => {
+      const slug = slugFromHash();
+      if (slug !== current) render(slug, { animate: true, focus: true });
+    });
+
+    // Initial render (supports deep links) without animation or stealing focus.
+    const initial = slugFromHash();
+    if (initial) render(initial, { animate: false, focus: false });
+  </script>
+
