+
+    .scroller {
+      --card-width: min(260px, 70vw);
+      display: flex;
+      gap: 24px;
+      list-style: none;
+      overflow-x: auto;
+      padding: 40px calc(50% - var(--card-width) / 2);
+      scroll-snap-type: x mandatory;
+      scroll-padding-inline: 0;
+      overscroll-behavior-x: contain;
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    .product-card {
+      flex: 0 0 var(--card-width);
+      scroll-snap-align: center;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
+      overflow: hidden;
+      text-align: center;
+    }
+
+    .product-card img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .product-card .body {
+      padding: 16px 16px 20px;
+    }
+
+    .product-card h3 {
+      color: var(--primary);
+    }
+
+    .product-card .price {
+      font-weight: bold;
+    }
+
+    .product-card .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Scale cards up toward the center of the scroller. Progressive
+       enhancement: without support, cards simply stay full size. */
+    @keyframes card-scale {
+      0%, 100% {
+        scale: 0.75;
+        opacity: 0.6;
+      }
+
+      50% {
+        scale: 1;
+        opacity: 1;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: view()) and (animation-range: entry)) {
+        .product-card {
+          animation: card-scale linear both;
+          animation-timeline: view(inline);
+        }
+      }
+    }
