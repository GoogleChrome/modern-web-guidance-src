     .btn:hover {
       background: #3e2723;
     }
 
+    /* Product Carousel */
+    .carousel-section {
+      margin-top: 60px;
+    }
+
+    .carousel-section h2,
+    .carousel-section > p {
+      text-align: center;
+    }
+
+    .scroller {
+      --card-width: min(280px, 70vw);
+      display: flex;
+      gap: 24px;
+      list-style: none;
+      overflow-x: auto;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      /* Let the first and last cards reach the center */
+      padding: 40px calc(50% - var(--card-width) / 2);
+      scroll-padding-inline: calc(50% - var(--card-width) / 2);
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .scroller > li {
+      flex: 0 0 var(--card-width);
+      scroll-snap-align: center;
+    }
+
+    .product-card {
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
+      overflow: hidden;
+      text-align: center;
+      height: 100%;
+    }
+
+    .product-card img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+      background: var(--secondary);
+    }
+
+    .product-card-body {
+      padding: 16px 20px 20px;
+    }
+
+    .product-card h3 {
+      color: var(--primary);
+    }
+
+    .product-card .price {
+      font-weight: bold;
+      margin-top: 4px;
+    }
+
+    .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Scale cards up near the viewport center, down as they move away.
+       Purely CSS: each card's position in the scroller drives the animation. */
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .scroller > li {
+          animation: carousel-scale linear both;
+          animation-timeline: view(inline);
+        }
+      }
+    }
+
+    @keyframes carousel-scale {
+      0%, 100% {
+        transform: scale(0.8);
+        opacity: 0.6;
+      }
+      50% {
+        transform: scale(1.1);
+        opacity: 1;
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
