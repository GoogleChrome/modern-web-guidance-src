+    /* Sticky section headers (viewport is the scroll root) */
+    .section {
+      margin-bottom: 40px;
+      /* Padding changes when stuck must not trigger scroll anchoring jitter */
+      overflow-anchor: none;
+    }
+
+    .sticky-container {
+      position: sticky;
+      top: var(--nav-height);
+      container-type: scroll-state;
+      container-name: section-header;
+      z-index: 10;
+    }
+
+    .sticky-header {
+      background: var(--secondary);
+      color: var(--primary);
+      padding: 1.5rem 20px;
+      text-align: center;
+      border-radius: 8px;
+      transition: background-color 0.3s, box-shadow 0.3s, padding 0.3s;
+    }
+
+    .sticky-header h2 {
+      font-size: 1.75rem;
+      line-height: 1.2;
+      transition: font-size 0.3s;
+    }
+
+    @container section-header scroll-state(stuck: top) {
+      .sticky-header {
+        background: #0056b3;
+        color: white;
+        padding: 0.4rem 20px;
+        border-radius: 0 0 8px 8px;
+        box-shadow: 0 4px 8px rgb(0 0 0 / 0.3);
+      }
+
+      .sticky-header h2 {
+        font-size: 1.1rem;
+      }
+    }
+
