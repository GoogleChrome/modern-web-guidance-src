diff --git a/src/lib/webmcp.ts b/src/lib/webmcp.ts
new file mode 100644
index 0000000..43dd38f
--- /dev/null
+++ b/src/lib/webmcp.ts
@@ -0,0 +1,29 @@
+// Helpers for exposing client-side functionality to AI agents via WebMCP
+// (https://webmachinelearning.github.io/webmcp/).
+
+export interface WebMcpToolResult {
+  content: { type: 'text'; text: string }[];
+  isError?: boolean;
+}
+
+export interface WebMcpTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  execute: (input: any) => Promise<WebMcpToolResult>;
+}
+
+export const textResult = (text: string, isError = false): WebMcpToolResult => ({
+  content: [{ type: 'text', text }],
+  ...(isError && { isError }),
+});
+
+/** Registers a tool if the browser supports WebMCP. Returns a cleanup function. */
+export function registerWebMcpTool(tool: WebMcpTool): () => void {
+  const modelContext = navigator.modelContext;
+  if (!modelContext?.registerTool) return () => {};
+
+  const controller = new AbortController();
+  modelContext.registerTool(tool, { signal: controller.signal });
+  return () => controller.abort();
+}
