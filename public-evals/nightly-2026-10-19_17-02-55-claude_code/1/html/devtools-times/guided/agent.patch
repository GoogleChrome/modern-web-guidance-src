diff --git a/src/components/ModalDialog.tsx b/src/components/ModalDialog.tsx
new file mode 100644
index 0000000..dec7d27
--- /dev/null
+++ b/src/components/ModalDialog.tsx
@@ -0,0 +1,49 @@
+import React, { useEffect, useId, useRef } from 'react';
+
+interface Props {
+  title: string;
+  onClose: () => void;
+  children: React.ReactNode;
+}
+
+// Native modal <dialog>: the browser handles the top layer, focus trapping,
+// Esc dismissal, inert background and restoring focus to the opener on close.
+export default function ModalDialog({ title, onClose, children }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const titleId = useId();
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (dialog && !dialog.open) {
+      dialog.showModal();
+    }
+  }, []);
+
+  return (
+    <dialog
+      ref={dialogRef}
+      aria-labelledby={titleId}
+      {...({ closedby: 'any' } as object)}
+      onClose={onClose}
+      // Fallback for browsers without `closedby`: a click on the backdrop targets the dialog itself.
+      onClick={e => {
+        if (e.target === e.currentTarget) e.currentTarget.close();
+      }}
+      className="modal-dialog relative overflow-visible bg-white shadow-xl p-0 w-[calc(100%-2rem)] max-w-2xl mx-auto mt-[15vh] mb-auto backdrop:bg-white/30 backdrop:backdrop-blur-sm"
+    >
+      <h2 id={titleId} className="sr-only">{title}</h2>
+      <form method="dialog">
+        <button
+          type="submit"
+          aria-label="Close"
+          className="absolute -top-2 -right-2 bg-white rounded-full p-1 shadow-md text-gray-500 hover:text-amber-400 hover:scale-110 transition-transform z-10"
+        >
+          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+            <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
+          </svg>
+        </button>
+      </form>
+      {children}
+    </dialog>
+  );
+}
