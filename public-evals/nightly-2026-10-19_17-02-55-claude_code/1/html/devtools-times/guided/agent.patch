+}
+/* Mega menu: a manual popover (top layer) tethered to the bottom of the section nav. */
+.main-nav {
+  anchor-name: --main-nav;
+}
+
+.flyout-menu {
+  position: fixed;
+  inset: auto;
+  margin: 0;
+  padding: 0;
+  width: 100%;
+  max-width: 72rem;
+  left: 0;
+  right: 0;
+  margin-inline: auto;
+  top: 11rem; /* fallback without anchor positioning */
+  top: anchor(--main-nav bottom);
+  position-anchor: --main-nav;
+  color: inherit;
+  border-width: 0 0 1px;
+}
+
+.flyout-menu:not(:popover-open) {
+  display: none;
+}
