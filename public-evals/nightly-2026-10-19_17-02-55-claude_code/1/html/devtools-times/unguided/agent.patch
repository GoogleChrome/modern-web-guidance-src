diff --git a/src/components/Dialog.tsx b/src/components/Dialog.tsx
new file mode 100644
index 0000000..ca754e1
--- /dev/null
+++ b/src/components/Dialog.tsx
@@ -0,0 +1,51 @@
+import React, { useEffect, useRef } from 'react';
+
+interface Props {
+  labelledBy: string;
+  onClose: () => void;
+  children: React.ReactNode;
+}
+
+// Modal built on the native <dialog>: the browser provides the top layer, focus
+// trapping, Escape handling and returning focus to the invoking button on close.
+export default function Dialog({ labelledBy, onClose, children }: Props) {
+  const ref = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const dialog = ref.current;
+    if (dialog && !dialog.open) {
+      dialog.showModal();
+    }
+    return () => dialog?.close();
+  }, []);
+
+  return (
+    <dialog
+      ref={ref}
+      aria-labelledby={labelledBy}
+      // Light dismiss (click outside / Escape) natively where supported
+      {...{ closedby: 'any' }}
+      onClose={onClose}
+      // Fallback for browsers without `closedby`: clicks on the backdrop target the dialog itself
+      onClick={e => {
+        if (e.target === ref.current) onClose();
+      }}
+      className="m-auto mt-[15vh] mb-auto w-[calc(100%-2rem)] max-w-2xl overflow-visible bg-transparent p-0 backdrop:bg-white/30 backdrop:backdrop-blur-sm"
+    >
+      <div className="relative bg-white shadow-xl">
+        <form method="dialog">
+          <button
+            type="submit"
+            aria-label="Close"
+            className="absolute -top-2 -right-2 z-10 rounded-full bg-white p-1 text-gray-500 shadow-md transition-transform hover:scale-110 hover:text-amber-400"
+          >
+            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+              <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
+            </svg>
+          </button>
+        </form>
+        {children}
+      </div>
+    </dialog>
+  );
+}
