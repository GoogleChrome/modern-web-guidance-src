+  color: var(--color-text-inverse);
+  padding: var(--space-2) var(--space-4);
+  border-radius: var(--radius-md);
+  margin-top: var(--space-3);
+  transition: background var(--duration-base);
+
+  &:hover {
+    background: var(--color-primary-strong);
+  }
+}
