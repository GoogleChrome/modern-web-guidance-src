+++ b/css/components/hero.css
@@ -0,0 +1,20 @@
+.hero {
+  height: var(--hero-height);
+  background:
+    linear-gradient(var(--color-overlay), var(--color-overlay)),
+    var(--image-hero);
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: var(--color-text-inverse);
+  text-align: center;
+  padding: 0 var(--space-4);
+
+  & h1 {
+    font-size: var(--font-size-xl);
+    margin-bottom: 1rem;
+  }
+}
diff --git a/css/components/nav.css b/css/components/nav.css
new file mode 100644
index 0000000..70d61d6
--- /dev/null
+++ b/css/components/nav.css
@@ -0,0 +1,43 @@
+.site-nav {
+  background: var(--color-primary);
+  color: var(--color-text-inverse);
+  padding: 1rem var(--space-nav-inline);
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: var(--z-nav);
+}
+
+/* Scoped so these bare element selectors can't leak outside the nav. */
+@scope (.site-nav) {
+  .logo {
+    font-size: var(--font-size-lg);
+    font-weight: bold;
+    letter-spacing: var(--letter-spacing-wide);
+  }
+
+  ul {
+    display: flex;
+  }
+
+  li {
+    margin-inline-start: var(--space-4);
+  }
+
+  a {
+    font-size: var(--font-size-base);
+    transition: color var(--duration-base);
+
+    &:hover {
+      color: var(--color-accent);
+    }
+  }
+
+  .logout-link {
+    border: 1px solid var(--color-accent);
+    padding: var(--space-1) 12px;
+    border-radius: var(--radius-sm);
+  }
+}
