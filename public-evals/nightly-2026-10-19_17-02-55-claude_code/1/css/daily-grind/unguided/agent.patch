@@ -0,0 +1,16 @@
+.container {
+  max-width: var(--container-max);
+  margin: var(--space-5) auto;
+  padding-inline: var(--space-4);
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(var(--grid-min), 1fr));
+  gap: var(--space-4);
+  margin-top: var(--space-4);
+}
+
+.section-title {
+  text-align: center;
+}
diff --git a/css/main.css b/css/main.css
new file mode 100644
index 0000000..b95e981
--- /dev/null
+++ b/css/main.css
@@ -0,0 +1,12 @@
+/* Layer order is declared once; later layers win regardless of specificity. */
+@layer reset, tokens, base, layout, components, utilities;
+
+@import url("tokens.css") layer(tokens);
+@import url("reset.css") layer(reset);
+@import url("base.css") layer(base);
+@import url("layout.css") layer(layout);
+@import url("components/nav.css") layer(components);
+@import url("components/hero.css") layer(components);
+@import url("components/card.css") layer(components);
+@import url("components/button.css") layer(components);
+@import url("components/footer.css") layer(components);
diff --git a/css/reset.css b/css/reset.css
new file mode 100644
index 0000000..6d08845
--- /dev/null
+++ b/css/reset.css
@@ -0,0 +1,22 @@
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+:where(*) {
+  margin: 0;
+  padding: 0;
+}
+
+:where(ul[class], ol[class]) {
+  list-style: none;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    transition-duration: 0.01ms !important;
+  }
+}
diff --git a/css/tokens.css b/css/tokens.css
new file mode 100644
index 0000000..2172baa
--- /dev/null
+++ b/css/tokens.css
@@ -0,0 +1,56 @@
+/* Design tokens: primitives first, then semantic aliases that components consume. */
+:root {
+  /* Primitives */
+  --color-espresso-900: #3e2723;
+  --color-espresso-700: #4e342e;
+  --color-latte-200: #d7ccc8;
+  --color-amber-400: #ffab40;
+  --color-white: #fff;
+  --color-paper: #fafafa;
+  --color-black: #000;
+
+  /* Semantic colors */
+  --color-primary: var(--color-espresso-700);
+  --color-primary-strong: var(--color-espresso-900);
+  --color-secondary: var(--color-latte-200);
+  --color-accent: var(--color-amber-400);
+  --color-text: var(--color-espresso-900);
+  --color-text-inverse: var(--color-white);
+  --color-bg: var(--color-paper);
+  --color-surface: var(--color-white);
+  --color-overlay: color-mix(in srgb, var(--color-black) 50%, transparent);
+  --color-shadow: color-mix(in srgb, var(--color-black) 10%, transparent);
+
+  /* Typography */
+  --font-sans: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
+  --font-size-sm: 0.85rem;
+  --font-size-base: 0.9rem;
+  --font-size-lg: 1.5rem;
+  --font-size-xl: 3rem;
+  --line-height-base: 1.6;
+  --letter-spacing-wide: 1px;
+
+  /* Spacing */
+  --space-1: 0.3125rem;
+  --space-2: 0.625rem;
+  --space-3: 0.9375rem;
+  --space-4: 1.25rem;
+  --space-5: 2.5rem;
+  --space-nav-inline: 5%;
+
+  /* Shape, elevation, motion */
+  --radius-sm: 4px;
+  --radius-md: 5px;
+  --radius-lg: 8px;
+  --shadow-card: 0 2px 5px var(--color-shadow);
+  --duration-base: 0.3s;
+
+  /* Layout */
+  --container-max: 1100px;
+  --grid-min: 250px;
+  --hero-height: 60vh;
+  --z-nav: 1000;
+
+  /* Assets */
+  --image-hero: url("https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80");
+}
