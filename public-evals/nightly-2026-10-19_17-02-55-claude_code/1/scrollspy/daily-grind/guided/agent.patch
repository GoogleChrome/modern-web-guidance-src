+  <script type="module">
+    const links = document.querySelectorAll('nav a[href^="#"]');
+
+    if (CSS.supports('scroll-target-group: auto')) {
+      const syncAriaCurrent = () => {
+        const current = document.querySelector('nav a:target-current');
+        links.forEach(link => {
+          link.setAttribute('aria-current', link === current ? 'true' : 'false');
+        });
+      };
+      syncAriaCurrent();
+      document.addEventListener('scrollend', syncAriaCurrent);
+    } else {
+      // Fallback for browsers without scroll-target-group
+      const observer = new IntersectionObserver(entries => {
+        entries.forEach(entry => {
+          if (!entry.isIntersecting) return;
+          links.forEach(link => {
+            const active = link.getAttribute('href') === `#${entry.target.id}`;
+            link.classList.toggle(':target-current', active);
+            link.setAttribute('aria-current', active);
+          });
+        });
+      }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
+
+      document.querySelectorAll('main section[id]').forEach(section => observer.observe(section));
+    }
+  </script>
