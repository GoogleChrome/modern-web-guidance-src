+  <script>
+    (function () {
+      var THRESHOLD = 0.4; // fraction of item width that triggers removal
+      var list = document.querySelector('.SwipeableList');
+      var emptyMsg = document.querySelector('.cart-empty');
+
+      function removeItem(item, track) {
+        // Fix the current height so it can transition to 0.
+        item.style.height = item.offsetHeight + 'px';
+        track.style.transform = 'translateX(-100%)';
+        void item.offsetHeight; // commit height before collapsing
+        item.classList.add('is-removing');
+        item.style.height = '0px';
+
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          item.remove();
+          if (!list.querySelector('.SwipeableList-item')) emptyMsg.hidden = false;
+        }
+        item.addEventListener('transitionend', function (e) {
+          if (e.target === item && e.propertyName === 'height') finish();
+        });
+        setTimeout(finish, 600); // fallback (e.g. reduced motion / no transition)
+      }
+
+      function setup(item) {
+        var track = item.querySelector('.SwipeableList-track');
+        var startX = 0, dx = 0, width = 0, active = false;
+
+        track.addEventListener('pointerdown', function (e) {
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          active = true;
+          startX = e.clientX;
+          dx = 0;
+          width = item.offsetWidth;
+          track.classList.remove('is-animating');
+          track.setPointerCapture(e.pointerId);
+        });
+
+        track.addEventListener('pointermove', function (e) {
+          if (!active) return;
+          dx = Math.min(0, e.clientX - startX); // left swipes only
+          track.style.transform = 'translateX(' + dx + 'px)';
+          item.classList.toggle('is-past-threshold', -dx > width * THRESHOLD);
+        });
+
+        function end() {
+          if (!active) return;
+          active = false;
+          if (-dx > width * THRESHOLD) {
+            removeItem(item, track);
+          } else {
+            track.classList.add('is-animating');
+            track.style.transform = '';
+            item.classList.remove('is-past-threshold');
+          }
+        }
+        track.addEventListener('pointerup', end);
+        track.addEventListener('pointercancel', end);
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(setup);
+    })();
+  </script>
