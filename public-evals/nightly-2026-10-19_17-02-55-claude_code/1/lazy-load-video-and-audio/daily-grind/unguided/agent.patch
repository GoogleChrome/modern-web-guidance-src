+  <script>
+    // Defer offscreen media (poster, sources, preloaded data) until the player is near the viewport.
+    (function () {
+      var items = document.querySelectorAll('[data-lazy-src]');
+
+      function load(el) {
+        if (el.dataset.lazyPoster) el.poster = el.dataset.lazyPoster;
+        if (el.tagName === 'IMG') {
+          el.src = el.dataset.lazySrc;
+          return;
+        }
+        var source = document.createElement('source');
+        source.src = el.dataset.lazySrc;
+        source.type = el.dataset.lazyType;
+        el.appendChild(source);
+        el.preload = 'metadata';
+        el.load();
+      }
+
+      if (!('IntersectionObserver' in window)) {
+        items.forEach(load);
+        return;
+      }
+
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (!entry.isIntersecting) return;
+          observer.unobserve(entry.target);
+          load(entry.target);
+        });
+      }, { rootMargin: '300px 0px' });
+
+      items.forEach(function (el) { observer.observe(el); });
+    })();
+  </script>
