+<script>
+    // Respect reduced motion for the autoplaying hero video
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const heroVideo = document.querySelector('.hero-video');
+    function syncHeroMotion() {
+      if (reducedMotion.matches) {
+        heroVideo.removeAttribute('autoplay');
+        heroVideo.pause();
+      } else {
+        heroVideo.play().catch(() => { });
+      }
+    }
+    syncHeroMotion();
+    reducedMotion.addEventListener('change', syncHeroMotion);
+
+    // Fallback for browsers without native loading="lazy" on media (Firefox, Safari):
+    // hold back poster/preload/src requests until the player nears the viewport.
+    if (!Object.hasOwn(HTMLMediaElement.prototype, 'loading')) {
+      const observer = new IntersectionObserver((entries, obs) => {
+        for (const { isIntersecting, target: media } of entries) {
+          if (!isIntersecting) continue;
+          if (media.dataset.poster) media.poster = media.dataset.poster;
+          media.preload = media.dataset.preload || 'metadata';
+          if (media.dataset.src) media.src = media.dataset.src;
+          for (const source of media.querySelectorAll('source[data-src]')) {
+            source.src = source.dataset.src;
+          }
+          media.load();
+          obs.unobserve(media);
+        }
+      }, { rootMargin: '200px 0px' });
+
+      for (const media of document.querySelectorAll('video[loading="lazy"], audio[loading="lazy"][controls]')) {
+        if (media.hasAttribute('poster')) {
+          media.dataset.poster = media.getAttribute('poster');
+          media.removeAttribute('poster');
+        }
+        media.dataset.preload = media.getAttribute('preload') || 'metadata';
+        media.preload = 'none';
+        if (media.hasAttribute('src')) {
+          media.dataset.src = media.getAttribute('src');
+          media.removeAttribute('src');
+        }
+        for (const source of media.querySelectorAll('source[src]')) {
+          source.dataset.src = source.getAttribute('src');
+          source.removeAttribute('src');
+        }
+        observer.observe(media);
+      }
+    }
+  </script>
