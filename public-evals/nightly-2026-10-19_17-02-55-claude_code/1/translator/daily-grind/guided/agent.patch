+  <script>
+    (() => {
+      const SOURCE = 'en';
+      const form = document.getElementById('translate-form');
+      const select = document.getElementById('translate-lang');
+      const button = document.getElementById('translate-btn');
+      const status = document.getElementById('translate-status');
+      const originals = new Map(); // text node -> original text
+      const RTL = new Set(['ar', 'he']);
+
+      if (!('Translator' in self)) {
+        select.disabled = button.disabled = true;
+        status.textContent = 'Client-side translation is currently unsupported in this browser.';
+        return;
+      }
+
+      function textNodes() {
+        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
+          acceptNode(node) {
+            if (!node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
+            const el = node.parentElement;
+            if (!el || el.closest('script, style, [data-no-translate], .translate-status')) {
+              return NodeFilter.FILTER_REJECT;
+            }
+            return NodeFilter.FILTER_ACCEPT;
+          },
+        });
+        const nodes = [];
+        while (walker.nextNode()) nodes.push(walker.currentNode);
+        return nodes;
+      }
+
+      function setLanguage(lang) {
+        document.documentElement.lang = lang;
+        document.documentElement.dir = RTL.has(lang) ? 'rtl' : 'ltr';
+      }
+
+      function restore() {
+        for (const [node, text] of originals) node.nodeValue = text;
+        originals.clear();
+        document.title = document.documentElement.dataset.title || document.title;
+        setLanguage(SOURCE);
+      }
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const target = select.value;
+        restore();
+        if (target === SOURCE) {
+          status.textContent = '';
+          return;
+        }
+
+        const options = { sourceLanguage: SOURCE, targetLanguage: target };
+        select.disabled = button.disabled = true;
+        try {
+          if ((await Translator.availability(options)) === 'unavailable') {
+            status.textContent = 'This language is not available for on-device translation.';
+            return;
+          }
+          status.textContent = 'Preparing translator…';
+          const translator = await Translator.create({
+            ...options,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                status.textContent = `Downloading language pack: ${Math.round(e.loaded * 100)}%`;
+              });
+            },
+          });
+
+          status.textContent = 'Translating…';
+          const nodes = textNodes();
+          const cache = new Map();
+          for (const node of nodes) {
+            const original = node.nodeValue;
+            const trimmed = original.trim();
+            if (!cache.has(trimmed)) cache.set(trimmed, await translator.translate(trimmed));
+            originals.set(node, original);
+            node.nodeValue = original.replace(trimmed, () => cache.get(trimmed));
+          }
+          if (!document.documentElement.dataset.title) {
+            document.documentElement.dataset.title = document.title;
+          }
+          document.title = await translator.translate(document.documentElement.dataset.title);
+          translator.destroy();
+          setLanguage(target);
+          status.textContent = '';
+        } catch (err) {
+          console.error(err);
+          restore();
+          status.textContent = 'Sorry, translation failed. Showing the original text.';
+        } finally {
+          select.disabled = button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
