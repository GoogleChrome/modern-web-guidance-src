index 0000000..514dd03
--- /dev/null
+++ b/src/components/ArticleTranslator.tsx
@@ -0,0 +1,166 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+
+interface Props {
+  /** CSS selector of the container whose text should be translated. */
+  targetSelector: string;
+  sourceLanguage?: string;
+}
+
+const LANGUAGES: Record<string, string> = {
+  es: 'Español',
+  fr: 'Français',
+  de: 'Deutsch',
+  it: 'Italiano',
+  pt: 'Português',
+  ja: '日本語',
+  ko: '한국어',
+  zh: '中文',
+  hi: 'हिन्दी',
+  ar: 'العربية',
+};
+
+const BLOCK_SELECTOR = 'h1,h2,h3,h4,h5,h6,p,li,blockquote,figcaption,td,th';
+
+type Status = 'idle' | 'translating' | 'translated' | 'error' | 'unsupported';
+
+// Chrome's built-in Translator API (not yet in TypeScript's DOM lib).
+const getTranslatorApi = () => (globalThis as any).Translator;
+
+function textNodesOf(root: Element): Text[] {
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+  const nodes: Text[] = [];
+  for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+    if (n.textContent?.trim()) nodes.push(n as Text);
+  }
+  return nodes;
+}
+
+export default function ArticleTranslator({ targetSelector, sourceLanguage = 'en' }: Props) {
+  const [target, setTarget] = useState('es');
+  const [status, setStatus] = useState<Status>('idle');
+  const [message, setMessage] = useState('');
+  // Original text per node so the translation can be undone.
+  const originals = useRef(new Map<Text, string>());
+
+  useEffect(() => {
+    if (!getTranslatorApi()) setStatus('unsupported');
+    return () => restore();
+  }, []);
+
+  function restore() {
+    originals.current.forEach((text, node) => (node.textContent = text));
+    originals.current.clear();
+    document.documentElement.lang = sourceLanguage;
+  }
+
+  const handleReset = () => {
+    restore();
+    setStatus('idle');
+    setMessage('');
+  };
+
+  const handleTranslate = async () => {
+    const Translator = getTranslatorApi();
+    if (!Translator) return;
+
+    const blocks = document.querySelectorAll(
+      targetSelector
+        .split(',')
+        .map((sel) => `${sel.trim()} :is(${BLOCK_SELECTOR})`)
+        .join(','),
+    );
+
+    restore();
+    setStatus('translating');
+    setMessage('');
+    try {
+      const availability = await Translator.availability({
+        sourceLanguage,
+        targetLanguage: target,
+      });
+      if (availability === 'unavailable') {
+        throw new Error(`Translating ${sourceLanguage} → ${target} is not supported by this browser.`);
+      }
+      const translator = await Translator.create({
+        sourceLanguage,
+        targetLanguage: target,
+        monitor(m: EventTarget) {
+          m.addEventListener('downloadprogress', (e: any) =>
+            setMessage(`Downloading language model… ${Math.round(e.loaded * 100)}%`),
+          );
+        },
+      });
+
+      for (const block of blocks) {
+        // Translate whole blocks when they are plain text, otherwise per text node
+        // so inline markup (links, emphasis) survives.
+        const nodes = textNodesOf(block);
+        if (!nodes.length) continue;
+        const plain = block.children.length === 0;
+        for (const node of plain ? [nodes[0]] : nodes) {
+          if (originals.current.has(node)) continue;
+          const original = node.textContent ?? '';
+          const translated = await translator.translate(original);
+          originals.current.set(node, original);
+          node.textContent = translated;
+        }
+      }
+      translator.destroy?.();
+      document.documentElement.lang = target;
+      setStatus('translated');
+      setMessage(`Translated to ${LANGUAGES[target]}.`);
+    } catch (err) {
+      restore();
+      setStatus('error');
+      setMessage(err instanceof Error ? err.message : 'Translation failed.');
+    }
+  };
+
+  if (status === 'unsupported') {
+    return (
+      <p className="text-xs text-gray-500">
+        Translation requires a browser with the built-in Translator API (e.g. recent Chrome).
+      </p>
+    );
+  }
+
+  const busy = status === 'translating';
+
+  return (
+    <div className="flex flex-wrap items-center gap-2 text-sm">
+      <LanguageIcon className="h-5 w-5 text-gray-500" aria-hidden="true" />
+      <label htmlFor="translate-language" className="font-semibold text-gray-800">
+        Translate:
+      </label>
+      <select
+        id="translate-language"
+        value={target}
+        disabled={busy}
+        onChange={(e) => setTarget(e.target.value)}
+        className="border border-gray-300 rounded px-2 py-1 bg-white"
+      >
+        {Object.entries(LANGUAGES).map(([code, name]) => (
+          <option key={code} value={code}>
+            {name}
+          </option>
+        ))}
+      </select>
+      <button
+        onClick={handleTranslate}
+        disabled={busy}
+        className="px-3 py-1 rounded bg-amber-400 text-gray-900 font-semibold hover:bg-amber-300 disabled:opacity-50"
+      >
+        {busy ? 'Translating…' : 'Translate'}
+      </button>
+      {status === 'translated' && (
+        <button onClick={handleReset} className="px-3 py-1 rounded border border-gray-300 hover:bg-gray-100">
+          Show original
+        </button>
+      )}
+      <span role="status" className={`text-xs ${status === 'error' ? 'text-red-600' : 'text-gray-500'}`}>
+        {message}
+      </span>
+    </div>
+  );
+}
