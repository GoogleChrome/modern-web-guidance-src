+---
+import Layout from '../layouts/Layout.astro';
+import TranslateTool from '../components/TranslateTool';
+---
+
+<Layout title="Translate | The DevTools Times">
+  <div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
+    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Translate</h1>
+    <p class="text-gray-600 mb-6">
+      Translate text between languages. Translation runs on your device; your text is never sent to a server.
+    </p>
+    <TranslateTool client:load />
+  </div>
+</Layout>
