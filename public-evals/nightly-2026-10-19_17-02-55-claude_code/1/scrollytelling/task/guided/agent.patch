     }
+
+    /* Scrollytelling */
+    .scrolly {
+      margin-top: 60px;
+    }
+
+    .scrolly > h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .scrolly-body {
+      display: grid;
+      grid-template-columns: 1fr 1fr;
+      gap: 40px;
+    }
+
+    #animated {
+      display: grid;
+      gap: 20px;
+      align-content: start;
+    }
+
+    #animated section {
+      border-radius: 8px;
+      overflow: hidden;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    #animated img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      aspect-ratio: 4 / 3;
+    }
+
+    #tracked {
+      order: -1;
+    }
+
+    #tracked section {
+      min-height: 70vh;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+    }
+
+    #tracked h3 {
+      color: var(--primary);
+      margin-bottom: 10px;
+      font-size: 1.6rem;
+    }
+
+    @media (max-width: 700px) {
+      .scrolly-body {
+        grid-template-columns: 1fr;
+      }
+    }
+
+    /* Progressive enhancement: images are stacked and revealed by scroll position of the text sections */
+    @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+      @media (prefers-reduced-motion: no-preference) {
+        .scrolly {
+          timeline-scope: --tl-1, --tl-2, --tl-3;
+        }
+
+        #tracked section:nth-child(1) { view-timeline: --tl-1 block; }
+        #tracked section:nth-child(2) { view-timeline: --tl-2 block; }
+        #tracked section:nth-child(3) { view-timeline: --tl-3 block; }
+
+        #animated {
+          position: sticky;
+          top: 90px;
+          height: calc(100vh - 120px);
+          align-self: start;
+          grid-template-areas: "stack";
+        }
+
+        #animated section {
+          grid-area: stack;
+          opacity: 0;
+          animation: reveal-in auto linear both, reveal-out auto linear forwards;
+          animation-range: entry 25% cover 50%, exit 50% exit 75%;
+        }
+
+        /* The last image stays once revealed */
+        #animated section:nth-child(3) {
+          animation-name: reveal-in;
+        }
+
+        #animated section:nth-child(1) { animation-timeline: --tl-1; }
+        #animated section:nth-child(2) { animation-timeline: --tl-2; }
+        #animated section:nth-child(3) { animation-timeline: --tl-3; }
+
+        @keyframes reveal-in {
+          from { opacity: 0; scale: 0.9; }
+          to { opacity: 1; scale: 1; }
+        }
+
+        @keyframes reveal-out {
+          to { opacity: 0; scale: 1.05; }
+        }
+
+        @media (max-width: 700px) {
+          #animated {
+            order: -1;
+            height: 40vh;
+            top: 70px;
+          }
+        }
+      }
+    }
   </style>
