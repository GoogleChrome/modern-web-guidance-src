+  <script>
+    // Size each hero heading line so its text spans the full heading width.
+    (function () {
+      var title = document.getElementById('hero-title');
+      var lines = title.querySelectorAll('.line');
+      var REF = 100; // measure at a reference size, then scale linearly
+
+      function fit() {
+        var width = title.clientWidth;
+        lines.forEach(function (line) {
+          line.style.fontSize = REF + 'px';
+          line.style.display = 'inline-block';
+          var natural = line.getBoundingClientRect().width;
+          line.style.display = '';
+          line.style.fontSize = (REF * width / natural) + 'px';
+        });
+      }
+
+      fit();
+      window.addEventListener('resize', fit);
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
+    })();
+  </script>
+
