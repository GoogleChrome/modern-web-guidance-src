+<script>
+    const searchInput = document.getElementById('search-input');
+    const grid = document.querySelector('.grid');
+
+    function clearHighlights() {
+      if (CSS.highlights) {
+        CSS.highlights.delete('search-results');
+        return;
+      }
+      // Fallback: unwrap <mark> elements and merge the split text nodes.
+      grid.querySelectorAll('mark').forEach(mark => mark.replaceWith(mark.textContent));
+      grid.normalize();
+    }
+
+    function highlight(term) {
+      const needle = term.toLowerCase();
+      const walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT);
+      const textNodes = [];
+      for (let n = walker.nextNode(); n; n = walker.nextNode()) textNodes.push(n);
+
+      const ranges = [];
+      for (const node of textNodes) {
+        const text = node.textContent.toLowerCase();
+        for (let pos = text.indexOf(needle); pos !== -1; pos = text.indexOf(needle, pos + needle.length)) {
+          const range = new Range();
+          range.setStart(node, pos);
+          range.setEnd(node, pos + needle.length);
+          ranges.push(range);
+        }
+      }
+
+      if (CSS.highlights) {
+        CSS.highlights.set('search-results', new Highlight(...ranges));
+      } else {
+        // Wrap in reverse so earlier offsets stay valid.
+        for (const range of ranges.reverse()) {
+          const mark = document.createElement('mark');
+          range.surroundContents(mark);
+        }
+      }
+    }
+
+    searchInput.addEventListener('input', () => {
+      clearHighlights();
+      const term = searchInput.value.trim();
+      if (term) highlight(term);
+    });
+  </script>
 </body>
 
