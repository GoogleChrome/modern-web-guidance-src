   <main class="container">
     <section>
       <h2 style="text-align: center;">Seasonal Favorites</h2>
+      <input type="search" id="search-input" placeholder="Search seasonal favorites..." aria-label="Search seasonal favorites" autocomplete="off">
       <div class="grid">
         <div class="card">
