+  <script>
+    // Local Network Access: Chrome prompts the user for permission when a page
+    // requests loopback/private-network resources. Declaring the target address
+    // space on the request lets the browser show that prompt and allow the fetch.
+    function localAddressSpace(url) {
+      const host = new URL(url, location.href).hostname.replace(/^\[|\]$/g, '');
+      if (host === 'localhost' || host.endsWith('.localhost') || host === '::1' || /^127\./.test(host)) {
+        return 'loopback';
+      }
+      if (/^(10\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.|169\.254\.)/.test(host) ||
+          /^(fc|fd|fe80)/i.test(host) || host.endsWith('.local')) {
+        return 'local';
+      }
+      return null;
+    }
+
+    // Use in place of fetch() for local-network or loopback URLs.
+    window.fetchLocal = function (url, options = {}) {
+      const space = localAddressSpace(url);
+      return fetch(url, space ? { ...options, targetAddressSpace: space } : options);
+    };
+  </script>
+
 </body>
 
