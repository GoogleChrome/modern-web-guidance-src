@@ -0,0 +1,50 @@
+// Local Network Access helpers. Requires a secure context (https://) to be granted.
+// Endpoints are illustrative; replace with the real device/companion app address.
+const LOCAL_URL = 'http://192.168.1.100:8080/api/status';
+const LOOPBACK_URL = 'http://127.0.0.1:45678/health';
+
+async function queryPermission(name) {
+  if (!navigator.permissions?.query) return 'prompt';
+  try {
+    const status = await navigator.permissions.query({ name });
+    status.addEventListener('change', () => updateUI(name, status.state));
+    return status.state;
+  } catch {
+    // Unrecognized permission name (no LNA support): proceed on user gesture.
+    return 'prompt';
+  }
+}
+
+function updateUI(name, state) {
+  const badge = document.querySelector(`[data-permission-status="${name}"]`);
+  const remediation = document.querySelector(`[data-remediation="${name}"]`);
+  if (badge) badge.textContent = state;
+  if (remediation) remediation.hidden = state !== 'denied';
+}
+
+async function fetchLocal(url, targetAddressSpace) {
+  const response = await fetch(new Request(url, { mode: 'cors', targetAddressSpace }));
+  if (!response.ok) throw new Error(`Device responded with HTTP ${response.status}`);
+  return response.json();
+}
+
+function setup(button) {
+  const name = button.dataset.permission;
+  const space = name === 'loopback-network' ? 'loopback' : 'local';
+  const url = space === 'loopback' ? LOOPBACK_URL : LOCAL_URL;
+  const output = document.querySelector(`[data-output="${name}"]`);
+
+  queryPermission(name).then((state) => updateUI(name, state));
+
+  // The first request must come from a user gesture so the browser can prompt.
+  button.addEventListener('click', async () => {
+    try {
+      output.textContent = JSON.stringify(await fetchLocal(url, space));
+    } catch {
+      output.textContent = 'Could not connect. Check the device is on, on the same network, and allowed in site settings.';
+    }
+    updateUI(name, await queryPermission(name));
+  });
+}
+
+document.querySelectorAll('[data-permission]').forEach(setup);
