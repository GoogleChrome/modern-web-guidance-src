+  <script>
+    // Prefetch same-origin links when the user hovers/focuses/touches them,
+    // so the next page is usually cached by the time they click.
+    (function () {
+      var conn = navigator.connection;
+      if (conn && (conn.saveData || /2g/.test(conn.effectiveType))) return;
+
+      // Never prefetch state-changing or session-ending URLs.
+      var BLOCKED_PATHS = [/^\/logout\/?$/i, /^\/log-out\/?$/i, /^\/signout\/?$/i];
+      var done = {};
+
+      function prefetchable(a) {
+        if (!a || !a.href || a.hasAttribute('download') || a.hasAttribute('data-no-prefetch')) return false;
+        if (a.closest('[data-no-prefetch]')) return false;
+        if (a.target && a.target !== '_self') return false;
+        var url = new URL(a.href, location.href);
+        if (url.origin !== location.origin) return false;
+        if (url.pathname === location.pathname && url.search === location.search) return false;
+        return !BLOCKED_PATHS.some(function (re) { return re.test(url.pathname); });
+      }
+
+      function prefetch(e) {
+        var a = e.target.closest && e.target.closest('a');
+        if (!prefetchable(a) || done[a.href]) return;
+        done[a.href] = true;
+        var link = document.createElement('link');
+        link.rel = 'prefetch';
+        link.href = a.href;
+        link.as = 'document';
+        document.head.appendChild(link);
+      }
+
+      document.addEventListener('mouseover', prefetch, { passive: true });
+      document.addEventListener('focusin', prefetch);
+      document.addEventListener('touchstart', prefetch, { passive: true });
+    })();
+  </script>
