+    /* WebGL ripple layer: the canvas draws the hero (background, text and
+       button visuals) with distortion, while the real DOM stays on top,
+       invisible but selectable and clickable. */
+    .hero {
+      position: relative;
+      overflow: hidden;
+    }
+
+    .hero-gl {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      z-index: 0;
+      pointer-events: none;
+    }
+
+    .hero > *:not(.hero-gl) {
+      position: relative;
+      z-index: 1;
+    }
+
+    .hero .btn {
+      --btn-bg: #4e342e;
+      --btn-bg-hover: #3e2723;
+    }
+
+    .hero.gl-active {
+      background: #000;
+    }
+
+    .hero.gl-active h1,
+    .hero.gl-active p,
+    .hero.gl-active .btn {
+      color: transparent;
+    }
+
+    .hero.gl-active .btn {
+      background: transparent;
+    }
+
+    .hero.gl-active ::selection {
+      color: white;
+      background: rgba(255, 171, 64, 0.55);
+    }
+
+    .hero.gl-active .btn:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 3px;
+    }
