index 0000000..c452d97
--- /dev/null
+++ b/grind-card.js
@@ -0,0 +1,60 @@
+// <grind-card> is server-rendered with Declarative Shadow DOM, so it is styled
+// from first paint. Upgrading adopts the existing shadow root and only wires
+// up behaviour; it never re-renders markup that is already there.
+const TEMPLATE = (count) => `
+  <style>
+    :host { display: block; }
+    .card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); text-align: center; height: 100%; font: inherit; color: inherit; }
+    ::slotted(h3) { margin-bottom: 10px; color: var(--primary); }
+    .actions { display: flex; gap: 10px; justify-content: center; align-items: center; margin-top: 15px; }
+    .btn { display: inline-block; background: var(--primary); color: white; padding: 10px 20px; text-decoration: none; border: 0; border-radius: 5px; font: inherit; cursor: pointer; }
+    .add { background: var(--accent); color: var(--text); }
+    .count { min-width: 1.5em; font-weight: bold; }
+  </style>
+  <div class="card" part="card">
+    <slot></slot>
+    <div class="actions">
+      <button type="button" class="btn add" aria-label="Add to order">Add <span class="count" aria-live="polite">${count}</span></button>
+    </div>
+  </div>`;
+
+class GrindCard extends HTMLElement {
+  #internals = this.attachInternals();
+  #countEl;
+
+  connectedCallback() {
+    // Existing root => server-rendered (hydrate). Otherwise the browser lacks
+    // DSD support or the element was created on the client (render).
+    let root = this.#internals.shadowRoot;
+    if (!root) {
+      root = this.attachShadow({ mode: 'open' });
+      const stale = this.querySelector(':scope > template[shadowrootmode]');
+      if (stale) {
+        root.append(stale.content); // DSD polyfill: adopt server markup as-is
+        stale.remove();
+      } else {
+        root.innerHTML = TEMPLATE(this.count);
+      }
+    }
+    this.#countEl = root.querySelector('.count');
+    root.querySelector('.add').addEventListener('click', () => {
+      this.count += 1;
+    });
+  }
+
+  get count() {
+    return Number(this.getAttribute('count')) || 0;
+  }
+
+  set count(value) {
+    this.setAttribute('count', value);
+  }
+
+  static observedAttributes = ['count'];
+
+  attributeChangedCallback() {
+    if (this.#countEl) this.#countEl.textContent = this.count;
+  }
+}
+
+customElements.define('grind-card', GrindCard);
