+  <script>
+    // Hydrates server-rendered <drink-card> elements in place. The shadow root
+    // comes from declarative shadow DOM; we only attach behavior to it.
+    class DrinkCard extends HTMLElement {
+      constructor() {
+        super();
+        if (!this.shadowRoot) {
+          // Browser without declarative shadow DOM support: attach from the same markup.
+          const tpl = this.querySelector(':scope > template[shadowrootmode]');
+          if (tpl) {
+            this.attachShadow({ mode: 'open' }).append(tpl.content);
+            tpl.remove();
+          }
+        }
+        const fav = this.shadowRoot?.getElementById('fav');
+        fav?.addEventListener('click', () => {
+          const on = this.toggleAttribute('favorited');
+          fav.setAttribute('aria-pressed', on);
+          fav.innerHTML = on ? '&#9829; Favorited' : '&#9825; Favorite';
+          this.dispatchEvent(new Event('change', { bubbles: true }));
+        });
+      }
+    }
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
