diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,54 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Product</title>
+<link rel="preload" as="image" href="hero-lcp.jpg" fetchpriority="high">
+<style>
+  *{box-sizing:border-box}
+  body{margin:0;font-family:system-ui,sans-serif;color:#111}
+  nav{padding:1rem;display:flex;gap:1rem;position:relative}
+  #mega{display:none;position:absolute;top:100%;left:1rem;background:#fff;border:1px solid #ddd;padding:1rem}
+  #mega.open{display:block}
+  .hero{width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;display:block}
+  section{padding:2rem 1rem}
+  .gallery img{max-width:100%;height:auto}
+  #alt[hidden]{display:none}
+  .spacer{height:200vh}
+  footer{padding:2rem 1rem}
+</style>
+</head>
+<body>
+<nav>
+  <button id="menu-btn" aria-expanded="false" aria-controls="mega">Menu</button>
+  <div id="mega">
+    <img src="mega-menu-promo.jpg" alt="Promo" width="300" height="200" loading="lazy">
+  </div>
+</nav>
+
+<header>
+  <img class="hero" src="hero-lcp.jpg" alt="Product hero" width="1600" height="900" fetchpriority="high" decoding="async">
+  <section><h1>The Product</h1><p>One line about it.</p></section>
+</header>
+
+<section class="gallery">
+  <img src="hero-lcp.jpg" alt="Product view 1" width="800" height="600" loading="lazy">
+  <img id="alt" src="gallery-alt.jpg" alt="Product view 2" width="800" height="600" loading="lazy" hidden>
+  <button id="toggle">Show alternate view</button>
+</section>
+
+<div class="spacer"></div>
+
+<footer>
+  <img src="footer-logo.png" alt="Logo" width="120" height="40" loading="lazy">
+</footer>
+
+<script>
+  var m=document.getElementById('mega'),b=document.getElementById('menu-btn');
+  b.onclick=function(){var o=m.classList.toggle('open');b.setAttribute('aria-expanded',o)};
+  var a=document.getElementById('alt');
+  document.getElementById('toggle').onclick=function(){a.hidden=!a.hidden};
+</script>
+</body>
+</html>
