+  <script>
+    // On-device AI via the Prompt API (global `LanguageModel`).
+    const LM_OPTIONS = {
+      expectedInputs: [{ type: 'text', languages: ['en'] }],
+      expectedOutputs: [{ type: 'text', languages: ['en'] }]
+    };
+    const BARISTA_PROMPT = 'You are a friendly barista at The Daily Grind. You only answer questions about ' +
+      'two drinks: the Maple Oat Latte (creamy oat milk with a hint of Vermont maple syrup) and the Cold Brew ' +
+      '(steeped for 18 hours for maximum smoothness). If asked about anything else, politely say you can only ' +
+      'help with those two drinks. Do not invent facts such as prices or exact ingredients you were not given.';
+    const MAX_BRANCHES = 3;
+
+    const $ = (id) => document.getElementById(id);
+    const statusEl = $('ai-status');
+    const progressEl = $('ai-progress');
+
+    // Context usage: newer builds expose contextUsage/contextWindow, older ones inputUsage/inputQuota.
+    const usageOf = (s) => s.contextUsage ?? s.inputUsage ?? 0;
+    const windowOf = (s) => s.contextWindow ?? s.inputQuota ?? 0;
+    const usageLabel = (s) => `${usageOf(s)}/${windowOf(s) || '?'} tokens`;
+
+    // Returns true if the model can be used (downloading it if needed), reporting why not otherwise.
+    async function ensureAvailable(outputEl) {
+      if (!('LanguageModel' in self)) {
+        outputEl.textContent = 'Built-in AI is not supported in this browser.';
+        return false;
+      }
+      const availability = await LanguageModel.availability(LM_OPTIONS);
+      if (availability === 'unavailable') {
+        outputEl.textContent = 'The built-in AI model is unavailable on this device.';
+        return false;
+      }
+      return true;
+    }
+
+    // Creates a session, showing download progress if the model must be fetched first.
+    function createSession(extra = {}) {
+      return LanguageModel.create({
+        ...LM_OPTIONS,
+        ...extra,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            progressEl.hidden = false;
+            progressEl.value = e.loaded;
+            statusEl.textContent = `Downloading model… ${Math.round(e.loaded * 100)}%`;
+          });
+        }
+      });
+    }
+
+    function watchOverflow(session, label) {
+      const handler = () => { statusEl.textContent = `${label}: oldest messages were dropped (context full).`; };
+      session.addEventListener('contextoverflow', handler);
+      session.addEventListener('quotaoverflow', handler);
+    }
+
+    /* ---------- Ask the Barista (streaming, one reusable session) ---------- */
+    let baristaSession = null;
+    let baristaAbort = null;
+
+    async function getBaristaSession() {
+      if (!baristaSession) {
+        baristaSession = await createSession({ initialPrompts: [{ role: 'system', content: BARISTA_PROMPT }] });
+        watchOverflow(baristaSession, 'Barista');
+      }
+      return baristaSession;
+    }
+
+    $('ask-the-barista').addEventListener('click', async (event) => {
+      const button = event.currentTarget;
+      const question = $('barista-question').value.trim();
+      const answerEl = $('barista-answer');
+      if (!question) { statusEl.textContent = 'Please type a question first.'; return; }
+
+      button.disabled = true;
+      answerEl.textContent = '';
+      statusEl.textContent = 'Checking model availability…';
+      baristaAbort?.abort();
+      baristaAbort = new AbortController();
+      const { signal } = baristaAbort;
+
+      try {
+        if (!(await ensureAvailable(statusEl))) return;
+        const session = await getBaristaSession();
+        progressEl.hidden = true;
+        statusEl.textContent = 'Thinking…';
+        for await (const chunk of session.promptStreaming(question, { signal })) {
+          answerEl.textContent += chunk;
+        }
+        statusEl.textContent = `Context used: ${usageLabel(session)}`;
+      } catch (err) {
+        statusEl.textContent = err.name === 'AbortError' ? 'Request cancelled.' : `Something went wrong: ${err.message}`;
+      } finally {
+        progressEl.hidden = true;
+        button.disabled = false;
+      }
+    });
+
+    /* ---------- Customer feedback analyzer (structured output, one-shot session) ---------- */
+    const SENTIMENT_SCHEMA = {
+      type: 'object',
+      properties: {
+        score: { type: 'number', minimum: -1, maximum: 1 },
+        category: { type: 'string', enum: ['positive', 'neutral', 'negative'] }
+      },
+      required: ['score', 'category'],
+      additionalProperties: false
+    };
+
+    $('sentiment-btn').addEventListener('click', async (event) => {
+      const button = event.currentTarget;
+      const resultEl = $('sentiment-result');
+      const feedback = $('feedback-text').value.trim();
+      if (!feedback) { resultEl.textContent = 'Please enter some feedback.'; return; }
+
+      button.disabled = true;
+      resultEl.textContent = 'Analyzing…';
+      let session;
+      try {
+        if (!(await ensureAvailable(resultEl))) return;
+        session = await createSession({
+          initialPrompts: [{
+            role: 'system',
+            content: 'Classify customer feedback. score ranges from -1 (very negative) to 1 (very positive).'
+          }]
+        });
+        progressEl.hidden = true;
+        const raw = await session.prompt(feedback, { responseConstraint: SENTIMENT_SCHEMA });
+        resultEl.textContent = JSON.stringify(JSON.parse(raw), null, 2);
+      } catch (err) {
+        resultEl.textContent = `Analysis failed: ${err.message}`;
+      } finally {
+        session?.destroy(); // one-shot: free the session immediately
+        progressEl.hidden = true;
+        button.disabled = false;
+      }
+    });
+
+    /* ---------- Conversation branching (clone + prune) ---------- */
+    const branches = []; // oldest → newest; the last entry is the active session
+    let branchCounter = 0;
+    $('max-branches').textContent = MAX_BRANCHES;
+
+    function renderBranches() {
+      const list = $('branch-list');
+      list.replaceChildren(...branches.map((b, i) => {
+        const li = document.createElement('li');
+        li.textContent = `${b.name} (${usageLabel(b.session)})${i === branches.length - 1 ? ' — active' : ''}`;
+        if (i === branches.length - 1) li.className = 'active';
+        return li;
+      }));
+    }
+
+    $('clone-btn').addEventListener('click', async (event) => {
+      const button = event.currentTarget;
+      button.disabled = true;
+      statusEl.textContent = '';
+      try {
+        if (!(await ensureAvailable($('branch-list')))) return;
+        // Clone the active branch; if there is none yet, start from the barista conversation.
+        let source = branches.at(-1)?.session;
+        if (!source) {
+          source = await getBaristaSession();
+          branches.push({ name: 'Main', session: source });
+          baristaSession = null; // ownership moves to the branch list so it is destroyed only once
+        }
+        const session = await source.clone();
+        branches.push({ name: `Branch ${++branchCounter}`, session });
+
+        // Prune the oldest branches so we never hold more than MAX_BRANCHES sessions.
+        while (branches.length > MAX_BRANCHES) branches.shift().session.destroy();
+        renderBranches();
+      } catch (err) {
+        $('branch-list').textContent = `Clone failed: ${err.message}`;
+      } finally {
+        progressEl.hidden = true;
+        button.disabled = false;
+      }
+    });
+
+    // Release every native session when the page goes away.
+    addEventListener('pagehide', () => {
+      baristaAbort?.abort();
+      baristaSession?.destroy();
+      branches.forEach((b) => b.session.destroy());
+      branches.length = 0;
+    });
+  </script>
 </body>
 
