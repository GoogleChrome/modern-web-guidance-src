+
+    /* Newest toast sits at the bottom; older ones are pushed up. */
+    @supports (width: calc(sibling-index() * 1px)) {
+      .toast {
+        --toast-offset: calc(sibling-count() - sibling-index());
+      }
+    }
+
+    @supports not (width: calc(sibling-index() * 1px)) {
+      .toast:nth-last-child(2) { --toast-offset: 1; }
+      .toast:nth-last-child(3) { --toast-offset: 2; }
+      .toast:nth-last-child(4) { --toast-offset: 3; }
