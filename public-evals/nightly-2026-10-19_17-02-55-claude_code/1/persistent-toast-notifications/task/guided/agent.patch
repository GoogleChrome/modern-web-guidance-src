+  <script>
+    const TOAST_DURATION = 3000;
+    let toastCount = 0;
+
+    function closeToast(toast) {
+      if (toast.hasAttribute('data-closing')) return;
+      toast.setAttribute('data-closing', '');
+
+      const remove = () => {
+        if (toast.matches(':popover-open')) toast.hidePopover();
+        toast.remove();
+      };
+      toast.addEventListener('transitionend', (e) => {
+        if (e.target === toast && e.propertyName === 'opacity') remove();
+      });
+      setTimeout(remove, 600); // fallback if no transition runs
+    }
+
+    function showToast(message) {
+      const toast = document.createElement('div');
+      toast.className = 'toast';
+      toast.popover = 'manual';
+      toast.setAttribute('role', 'status');
+      toast.id = `toast-${++toastCount}`;
+
+      const text = document.createElement('span');
+      text.className = 'toast-message';
+      text.textContent = message;
+
+      const close = document.createElement('button');
+      close.type = 'button';
+      close.className = 'toast-close';
+      close.setAttribute('aria-label', 'Close notification');
+      close.innerHTML = '&times;';
+      close.addEventListener('click', () => closeToast(toast));
+
+      toast.append(text, close);
+      document.body.append(toast); // must stay last in <body> for CSS stacking
+      toast.showPopover();
+      setTimeout(() => closeToast(toast), TOAST_DURATION);
+    }
+
+    document.querySelectorAll('.toast-trigger').forEach((btn) => {
+      btn.addEventListener('click', () => showToast('Added to cart!'));
+    });
+  </script>
