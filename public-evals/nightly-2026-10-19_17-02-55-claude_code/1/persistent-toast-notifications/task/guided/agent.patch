+    /* Toasts: popover="manual" puts each one in the top layer (no z-index needed).
+       They are appended last in <body>, so the number of siblings after a toast
+       equals how many newer toasts exist, which drives its vertical offset. */
+    .toast {
+      --toast-height: 3.25rem;
+      --toast-gap: 0.75rem;
+      --toast-offset: 0;
+
+      position: fixed;
+      inset: auto;
+      inset-inline-end: 1.25rem;
+      inset-block-end: calc(1.25rem + var(--toast-offset) * (var(--toast-height) + var(--toast-gap)));
+      margin: 0;
+      width: min(20rem, calc(100vw - 2.5rem));
+      height: var(--toast-height);
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 0.75rem;
+      padding: 0 0.5rem 0 1rem;
+      border: none;
