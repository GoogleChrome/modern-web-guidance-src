+    /* Toasts: manual popovers live in the top layer (no z-index needed, no
+       backdrop, page stays interactive). Each is an <aside> so that
+       :nth-last-of-type can offset it by the number of newer toasts. */
+    aside.toast {
+      --step: 3.75rem;
+      --n: 8;
+      position: fixed;
+      inset: auto 1.5rem calc(1.5rem + var(--n) * var(--step)) auto;
+      margin: 0;
+      width: min(20rem, calc(100vw - 3rem));
+      height: 3rem;
+      padding: 0 0.5rem 0 1rem;
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 0.75rem;
+      border: none;
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
+      opacity: 0;
+      transform: translateY(1rem);
+      transition: opacity 0.3s ease, transform 0.3s ease, bottom 0.3s ease;
+    }
+
+    aside.toast:popover-open {
+      opacity: 1;
+      transform: none;
+    }
+
+    aside.toast[data-leaving] {
+      opacity: 0;
+      transform: translateX(1.5rem);
+    }
+
+    @starting-style {
+      aside.toast:popover-open {
+        opacity: 0;
+        transform: translateY(1rem);
+      }
+    }
+
+    aside.toast:nth-last-of-type(1) { --n: 0; }
+    aside.toast:nth-last-of-type(2) { --n: 1; }
+    aside.toast:nth-last-of-type(3) { --n: 2; }
+    aside.toast:nth-last-of-type(4) { --n: 3; }
+    aside.toast:nth-last-of-type(5) { --n: 4; }
+    aside.toast:nth-last-of-type(6) { --n: 5; }
+    aside.toast:nth-last-of-type(7) { --n: 6; }
+
+    .toast-message {
+      overflow: hidden;
+      white-space: nowrap;
+      text-overflow: ellipsis;
+    }
+
+    .toast-close {
+      flex: none;
+      width: 2rem;
+      height: 2rem;
+      border: none;
+      border-radius: 50%;
+      background: transparent;
+      color: inherit;
+      font-size: 1.25rem;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    .toast-close:hover,
+    .toast-close:focus-visible {
+      background: rgba(255, 255, 255, 0.2);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      aside.toast {
+        transition-duration: 0.01s;
+      }
+    }
