+  <button type="button" class="feedback-fab" id="feedback-open">Feedback</button>
+
+  <dialog id="feedback-dialog" aria-labelledby="feedback-title">
+    <form method="dialog" id="feedback-form">
+      <h2 id="feedback-title">Send us feedback</h2>
+      <p>Tell us how we're brewing.</p>
+      <label for="feedback-rating">Rating</label>
+      <select id="feedback-rating" name="rating">
+        <option>5 - Excellent</option>
+        <option>4 - Good</option>
+        <option>3 - Okay</option>
+        <option>2 - Poor</option>
+        <option>1 - Terrible</option>
+      </select>
+      <label for="feedback-message">Comments</label>
+      <textarea id="feedback-message" name="message" rows="4"></textarea>
+
+      <div class="feedback-moves">
+        Move this dialog to:
+        <div>
+          <button type="button" data-move-to="nav">Nav</button>
+          <button type="button" data-move-to=".hero">Hero</button>
+          <button type="button" data-move-to="main">Main</button>
+          <button type="button" data-move-to="footer" aria-pressed="true">Footer</button>
+        </div>
+        <p id="feedback-status" role="status" aria-live="polite"></p>
+      </div>
+
+      <div class="feedback-actions">
+        <button type="button" id="feedback-cancel">Close</button>
+        <button type="submit">Send</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    (() => {
+      const dialog = document.getElementById('feedback-dialog');
+      const status = document.getElementById('feedback-status');
+      const moveButtons = dialog.querySelectorAll('[data-move-to]');
+      const DRAFT_KEY = 'feedback-draft';
+
+      // Draft text survives reloads as well as reparenting.
+      const message = document.getElementById('feedback-message');
+      message.value = localStorage.getItem(DRAFT_KEY) || '';
+      message.addEventListener('input', () => localStorage.setItem(DRAFT_KEY, message.value));
+
+      document.getElementById('feedback-open').addEventListener('click', () => dialog.showModal());
+      document.getElementById('feedback-cancel').addEventListener('click', () => dialog.close());
+      dialog.addEventListener('submit', () => {
+        localStorage.removeItem(DRAFT_KEY);
+        message.value = '';
+      });
+
+      function relocate(target) {
+        const wasOpen = dialog.open;
+        const active = document.activeElement;
+        const focused = dialog.contains(active) ? active : null;
+        const selection = focused && 'selectionStart' in focused
+          ? [focused.selectionStart, focused.selectionEnd] : null;
+
+        if (typeof target.moveBefore === 'function') {
+          // State-preserving move: dialog stays open, in the top layer, and focused.
+          target.moveBefore(dialog, null);
+          return 'moveBefore';
+        }
+
+        // Fallback: removal closes the dialog, so re-open it and restore focus.
+        target.append(dialog);
+        if (wasOpen) {
+          dialog.showModal();
+          if (focused) {
+            focused.focus({ preventScroll: true });
+            if (selection) focused.setSelectionRange(...selection);
+          }
+        }
+        return 'fallback';
+      }
+
+      moveButtons.forEach((btn) => btn.addEventListener('click', () => {
+        const target = document.querySelector(btn.dataset.moveTo);
+        if (!target || target === dialog.parentElement) return;
+        let mode;
+        try {
+          mode = relocate(target);
+        } catch (err) {
+          // moveBefore can throw (e.g. disconnected nodes); fall back to a plain move.
+          const wasOpen = dialog.open;
+          target.append(dialog);
+          if (wasOpen && !dialog.open) dialog.showModal();
+          btn.focus();
+          mode = 'fallback';
+        }
+        moveButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
+        status.textContent = `Moved to ${btn.textContent} (${mode}).`;
+      }));
+    })();
+  </script>
+
