+  <button type="button" class="btn feedback-open" id="feedback-open">Feedback</button>
+
+  <dialog class="feedback-dialog" id="feedback-dialog" aria-labelledby="feedback-title">
+    <form method="dialog">
+      <h2 id="feedback-title">Send us feedback</h2>
+      <p>This dialog stays open while you move it around the page.</p>
+      <label for="feedback-text">Your thoughts</label>
+      <textarea id="feedback-text" name="feedback"></textarea>
+
+      <fieldset>
+        <legend>Move dialog into…</legend>
+        <div class="move-buttons">
+          <button type="button" class="move-btn" data-target="#move-nav" aria-pressed="false">Navigation</button>
+          <button type="button" class="move-btn" data-target="#move-hero" aria-pressed="false">Hero</button>
+          <button type="button" class="move-btn" data-target="#move-main" aria-pressed="false">Main</button>
+          <button type="button" class="move-btn" data-target="#move-footer" aria-pressed="false">Footer</button>
+          <button type="button" class="move-btn" data-target="#move-body" aria-pressed="true">Body</button>
+        </div>
+      </fieldset>
+
+      <p class="feedback-status" id="feedback-status" role="status"></p>
+
+      <div class="feedback-actions">
+        <button type="submit" value="cancel">Close</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    (() => {
+      const dialog = document.getElementById('feedback-dialog');
+      const status = document.getElementById('feedback-status');
+      const supportsMoveBefore = 'moveBefore' in Element.prototype;
+
+      document.getElementById('feedback-open').addEventListener('click', () => {
+        if (!dialog.open) dialog.showModal();
+      });
+
+      function moveDialog(target, button) {
+        const wasOpen = dialog.open;
+        const text = dialog.querySelector('textarea');
+        const selection = [text.selectionStart, text.selectionEnd];
+        const refocusText = document.activeElement === text;
+
+        if (supportsMoveBefore) {
+          // Atomic move: the dialog stays open, in the top layer, and keeps focus.
+          target.moveBefore(dialog, null);
+        } else {
+          // Fallback: insertion closes the dialog, so re-open it and restore focus.
+          target.append(dialog);
+          if (wasOpen) {
+            dialog.showModal();
+            (refocusText ? text : button).focus();
+            if (refocusText) text.setSelectionRange(...selection);
+          }
+        }
+
+        for (const b of dialog.querySelectorAll('.move-btn')) {
+          b.setAttribute('aria-pressed', String(b === button));
+        }
+        status.textContent = `Moved into <${target.localName}> ` +
+          (supportsMoveBefore ? 'with moveBefore() (state preserved).' : 'using the re-open fallback.');
+      }
+
+      dialog.addEventListener('click', (event) => {
+        const button = event.target.closest('.move-btn');
+        if (!button) return;
+        const target = document.querySelector(button.dataset.target);
+        if (target && target !== dialog.parentElement) moveDialog(target, button);
+      });
+    })();
+  </script>
+
