diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,35 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Scroll-driven reveal: scale from half to full size on entry, back on exit.
+       Only applied when supported and the user hasn't asked for reduced motion;
+       otherwise cards simply render at full size. */
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .card {
+          animation: card-reveal linear both;
+          animation-timeline: view();
+        }
+      }
+    }
+
+    @keyframes card-reveal {
+      0% {
+        transform: scale(0.5);
+      }
+
+      35%,
+      65% {
+        transform: scale(1);
+      }
+
+      100% {
+        transform: scale(0.5);
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
