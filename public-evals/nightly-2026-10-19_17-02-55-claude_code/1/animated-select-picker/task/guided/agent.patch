+    /* Store picker */
+    .store-picker {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.4rem;
+      margin-top: 1.5rem;
+      font-size: 0.9rem;
+    }
+
+    .store-select,
+    .store-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .store-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 0.75rem;
+      width: 260px;
+      padding: 0.7rem 1rem;
+      font: inherit;
+      color: var(--text);
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      cursor: pointer;
+    }
+
+    .store-select:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .store-select::picker-icon {
+      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+    }
+
+    .store-select:open::picker-icon {
+      transform: rotate(180deg);
+    }
+
+    .store-select::picker(select) {
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 10px;
+      box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.25);
+      padding: 0.35rem;
+      margin-top: 0.25rem;
+      width: anchor-size(width);
+      color: var(--text);
+
+      /* Closed state doubles as the exit animation */
+      opacity: 0;
+      transform: translateY(-6px);
+      transition:
+        display 0.3s allow-discrete,
+        overlay 0.3s allow-discrete,
+        opacity 0.3s ease,
+        transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+    }
+
+    .store-select:open::picker(select) {
+      opacity: 1;
+      transform: translateY(0);
+    }
+
+    @starting-style {
+      .store-select:open::picker(select) {
+        opacity: 0;
+        transform: translateY(-6px);
+      }
+    }
+
+    .store-select option {
+      padding: 0.5rem 0.75rem;
+      border-radius: 6px;
+    }
+
+    .store-select option:hover,
+    .store-select option:focus-visible {
+      background: var(--secondary);
+    }
+
+    .store-select option:checked {
+      font-weight: 700;
+      background: #f1e9e6;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker(select),
+      .store-select::picker-icon {
+        transition: none;
+      }
+    }
+
