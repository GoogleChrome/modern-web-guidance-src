diff --git a/src/lib/phone-verification.ts b/src/lib/phone-verification.ts
new file mode 100644
index 0000000..4c5ee26
--- /dev/null
+++ b/src/lib/phone-verification.ts
@@ -0,0 +1,79 @@
+import { randomInt, randomUUID } from 'node:crypto';
+
+const CODE_TTL_MS = 5 * 60 * 1000;
+const RESEND_COOLDOWN_MS = 30 * 1000;
+const MAX_ATTEMPTS = 5;
+const VERIFIED_TTL_MS = 15 * 60 * 1000;
+
+interface Pending {
+  code: string;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+}
+
+// In-memory demo store. Replace with a persistent store in production.
+const pending = new Map<string, Pending>();
+const verifiedTokens = new Map<string, { phone: string; expiresAt: number }>();
+
+/** Normalizes to E.164-ish form. Returns null if the number looks invalid. */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const cleaned = input.replace(/[\s().-]/g, '');
+  return /^\+[1-9]\d{7,14}$/.test(cleaned) ? cleaned : null;
+}
+
+/**
+ * Formats an SMS body that supports both the OS autofill (the code is found
+ * via `autocomplete="one-time-code"`) and the WebOTP API (last line is
+ * `@origin #code`).
+ */
+export function formatSms(code: string, origin: string): string {
+  const host = new URL(origin).host;
+  return `${code} is your DevTools Times verification code.\n\n@${host} #${code}`;
+}
+
+export function issueCode(phone: string, origin: string):
+  | { ok: true; message: string }
+  | { ok: false; retryAfter: number } {
+  const now = Date.now();
+  const existing = pending.get(phone);
+  if (existing && now - existing.sentAt < RESEND_COOLDOWN_MS) {
+    return { ok: false, retryAfter: Math.ceil((RESEND_COOLDOWN_MS - (now - existing.sentAt)) / 1000) };
+  }
+  const code = String(randomInt(0, 1_000_000)).padStart(6, '0');
+  pending.set(phone, { code, sentAt: now, expiresAt: now + CODE_TTL_MS, attempts: 0 });
+  const message = formatSms(code, origin);
+  // No SMS provider is wired up: log the message instead of sending it.
+  console.log(`[sms -> ${phone}]\n${message}`);
+  return { ok: true, message };
+}
+
+export function checkCode(phone: string, code: string):
+  | { ok: true; token: string }
+  | { ok: false; error: string } {
+  const entry = pending.get(phone);
+  if (!entry || entry.expiresAt < Date.now()) {
+    pending.delete(phone);
+    return { ok: false, error: 'This code has expired. Request a new one.' };
+  }
+  if (entry.attempts >= MAX_ATTEMPTS) {
+    pending.delete(phone);
+    return { ok: false, error: 'Too many attempts. Request a new code.' };
+  }
+  entry.attempts++;
+  if (entry.code !== code) {
+    return { ok: false, error: 'That code is incorrect.' };
+  }
+  pending.delete(phone);
+  const token = randomUUID();
+  verifiedTokens.set(token, { phone, expiresAt: Date.now() + VERIFIED_TTL_MS });
+  return { ok: true, token };
+}
+
+export function consumeVerifiedToken(token: string, phone: string): boolean {
+  const entry = verifiedTokens.get(token);
+  if (!entry || entry.expiresAt < Date.now() || entry.phone !== phone) return false;
+  verifiedTokens.delete(token);
+  return true;
+}
diff --git a/src/pages/api/phone/send-code.ts b/src/pages/api/phone/send-code.ts
new file mode 100644
index 0000000..818838b
--- /dev/null
+++ b/src/pages/api/phone/send-code.ts
@@ -0,0 +1,18 @@
+import type { APIRoute } from 'astro';
+import { issueCode, normalizePhone } from '../../../lib/phone-verification';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+export const POST: APIRoute = async ({ request, url }) => {
+  const body = await request.json().catch(() => null);
+  const phone = normalizePhone(body?.phone);
+  if (!phone) {
+    return json({ error: 'Enter a valid phone number including country code, e.g. +14155550123.' }, 400);
+  }
+  const result = issueCode(phone, url.origin);
+  if (!result.ok) {
+    return json({ error: `Please wait ${result.retryAfter}s before requesting another code.`, retryAfter: result.retryAfter }, 429);
+  }
+  return json({ phone });
+};
diff --git a/src/pages/api/phone/verify-code.ts b/src/pages/api/phone/verify-code.ts
new file mode 100644
index 0000000..bf20d0b
--- /dev/null
+++ b/src/pages/api/phone/verify-code.ts
@@ -0,0 +1,17 @@
+import type { APIRoute } from 'astro';
+import { checkCode, normalizePhone } from '../../../lib/phone-verification';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+export const POST: APIRoute = async ({ request }) => {
+  const body = await request.json().catch(() => null);
+  const phone = normalizePhone(body?.phone);
+  const code = typeof body?.code === 'string' ? body.code.trim() : '';
+  if (!phone || !/^\d{6}$/.test(code)) {
+    return json({ error: 'Enter the 6-digit code.' }, 400);
+  }
+  const result = checkCode(phone, code);
+  if (!result.ok) return json({ error: result.error }, 400);
+  return json({ token: result.token });
+};
