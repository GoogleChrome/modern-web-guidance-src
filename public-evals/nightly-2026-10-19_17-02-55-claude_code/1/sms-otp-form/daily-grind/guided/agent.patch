+  <script>
+    const phoneForm = document.getElementById('phone-form');
+    const phoneInput = document.getElementById('phone-input');
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const resendBtn = document.getElementById('resend-btn');
+    const changePhoneBtn = document.getElementById('change-phone-btn');
+    const statusEl = document.getElementById('verify-status');
+    const RESEND_SECONDS = 30;
+
+    let otpAbortController = null;
+    let resendTimer = null;
+
+    function setStatus(message, type = '') {
+      statusEl.textContent = message;
+      statusEl.className = 'verify-status ' + type;
+    }
+
+    // Replace these two stubs with fetch() calls to your backend. The SMS you send must end with
+    // a line of the form "@<your-domain> #<code>" so WebOTP and Safari autofill can verify the origin.
+    async function requestCode(phone) {
+      await new Promise((resolve) => setTimeout(resolve, 400));
+    }
+
+    async function checkCode(code) {
+      await new Promise((resolve) => setTimeout(resolve, 400));
+      return /^\d{6}$/.test(code);
+    }
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      if (!('OTPCredential' in window)) return;
+
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+
+      try {
+        const otp = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: ac.signal });
+        if (!otp) return;
+        otpInput.value = otp.code;
+        otpForm.requestSubmit();
+      } catch (err) {
+        if (err && err.name === 'AbortError') return;
+        console.error('WebOTP verification error:', err);
+      }
+    }
+
+    function startResendCooldown() {
+      clearInterval(resendTimer);
+      let remaining = RESEND_SECONDS;
+      resendBtn.disabled = true;
+      resendBtn.textContent = `Resend code (${remaining}s)`;
+      resendTimer = setInterval(() => {
+        remaining -= 1;
+        if (remaining <= 0) {
+          clearInterval(resendTimer);
+          resendBtn.disabled = false;
+          resendBtn.textContent = 'Resend code';
+        } else {
+          resendBtn.textContent = `Resend code (${remaining}s)`;
+        }
+      }, 1000);
+    }
+
+    async function sendCode() {
+      const submitBtn = phoneForm.querySelector('button[type="submit"]');
+      submitBtn.disabled = true;
+      setStatus('Sending code…');
+      try {
+        await requestCode(phoneInput.value.trim());
+      } catch {
+        setStatus('We couldn\u2019t send the code. Please check the number and try again.', 'error');
+        return false;
+      } finally {
+        submitBtn.disabled = false;
+      }
+      setStatus('Code sent. Check your text messages.');
+      startResendCooldown();
+      startSmsOtpListener();
+      return true;
+    }
+
+    phoneForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!(await sendCode())) {
+        phoneInput.focus();
+        return;
+      }
+      document.getElementById('phone-display').textContent = phoneInput.value.trim();
+      phoneForm.hidden = true;
+      otpForm.hidden = false;
+      otpInput.value = '';
+      otpInput.focus();
+    });
+
+    otpForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      stopSmsOtpListener();
+      const submitBtn = otpForm.querySelector('button[type="submit"]');
+      submitBtn.disabled = true;
+      setStatus('Verifying…');
+      let ok = false;
+      try {
+        ok = await checkCode(otpInput.value);
+      } catch {
+        setStatus('Something went wrong. Please try again.', 'error');
+        submitBtn.disabled = false;
+        startSmsOtpListener();
+        return;
+      }
+      if (ok) {
+        clearInterval(resendTimer);
+        otpForm.hidden = true;
+        setStatus('Your phone number is verified. Thank you!', 'success');
+      } else {
+        submitBtn.disabled = false;
+        setStatus('That code is incorrect or expired. Please try again.', 'error');
+        otpInput.select();
+        startSmsOtpListener();
+      }
+    });
+
+    resendBtn.addEventListener('click', async () => {
+      otpInput.value = '';
+      await sendCode();
+      otpInput.focus();
+    });
+
+    changePhoneBtn.addEventListener('click', () => {
+      stopSmsOtpListener();
+      clearInterval(resendTimer);
+      otpForm.hidden = true;
+      phoneForm.hidden = false;
+      setStatus('');
+      phoneInput.focus();
+    });
+  </script>
