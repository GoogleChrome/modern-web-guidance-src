+  <script>
+    (function () {
+      // Backend endpoints. If they don't exist (404) the form falls back to a
+      // clearly-labelled demo mode where the code is 123456.
+      var API = { send: '/api/otp/send', verify: '/api/otp/verify' };
+      var DEMO_CODE = '123456';
+      var RESEND_SECONDS = 30;
+
+      var $ = function (id) { return document.getElementById(id); };
+      var phoneForm = $('phone-form'), codeForm = $('code-form');
+      var phone = $('phone'), code = $('code');
+      var phoneErr = $('phone-error'), codeErr = $('code-error'), status = $('status');
+      var sendBtn = $('send-btn'), verifyBtn = $('verify-btn'), resendBtn = $('resend-btn');
+      var demo = false, e164 = '', abort = null, timer = null;
+
+      function setStatus(msg, ok) {
+        status.textContent = msg;
+        status.className = 'status' + (ok ? ' success' : '');
+      }
+
+      function setError(input, el, msg) {
+        el.textContent = msg;
+        if (msg) input.setAttribute('aria-invalid', 'true');
+        else input.removeAttribute('aria-invalid');
+      }
+
+      function normalize(raw) {
+        var s = raw.replace(/[\s().-]/g, '');
+        if (/^00/.test(s)) s = '+' + s.slice(2);
+        if (/^\d{10}$/.test(s)) s = '+1' + s; // assume US/CA for bare 10-digit numbers
+        return /^\+[1-9]\d{7,14}$/.test(s) ? s : null;
+      }
+
+      function post(url, body) {
+        return fetch(url, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(body)
+        }).then(function (res) {
+          if (res.status === 404) { demo = true; return { ok: true }; }
+          return res.json().catch(function () { return {}; }).then(function (data) {
+            data.ok = res.ok && data.ok !== false;
+            return data;
+          });
+        }).catch(function () { demo = true; return { ok: true }; });
+      }
+
+      // Automatic extraction: WebOTP reads the code from an SMS ending in
+      // "@<this-origin-host> #<code>" after the user approves the prompt.
+      function listenForSms() {
+        if (abort) abort.abort();
+        if (!('OTPCredential' in window)) return;
+        abort = new AbortController();
+        navigator.credentials.get({ otp: { transport: ['sms'] }, signal: abort.signal })
+          .then(function (cred) {
+            if (!cred || !cred.code) return;
+            code.value = cred.code.replace(/\D/g, '').slice(0, 6);
+            setStatus('Code received from SMS. Verifying…');
+            submitCode();
+          })
+          .catch(function () { /* aborted, dismissed or unsupported: manual entry still works */ });
+      }
+
+      function startCooldown() {
+        var left = RESEND_SECONDS;
+        clearInterval(timer);
+        resendBtn.disabled = true;
+        (function tick() {
+          resendBtn.textContent = left > 0 ? 'Resend code (' + left + 's)' : 'Resend code';
+          if (left-- <= 0) { clearInterval(timer); resendBtn.disabled = false; }
+        })();
+        timer = setInterval(function () {
+          resendBtn.textContent = left > 0 ? 'Resend code (' + left + 's)' : 'Resend code';
+          if (left-- <= 0) { clearInterval(timer); resendBtn.disabled = false; resendBtn.textContent = 'Resend code'; }
+        }, 1000);
+      }
+
+      function sendCode(isResend) {
+        sendBtn.disabled = true;
+        setStatus('Sending code…');
+        return post(API.send, { phone: e164 }).then(function (res) {
+          sendBtn.disabled = false;
+          if (!res.ok) {
+            setError(phone, phoneErr, res.error || 'We couldn’t send a code. Please try again.');
+            phone.focus();
+            setStatus('');
+            return;
+          }
+          $('sent-to').textContent = e164;
+          phoneForm.hidden = true;
+          codeForm.hidden = false;
+          code.value = '';
+          setError(code, codeErr, '');
+          setStatus((isResend ? 'New code sent.' : 'Code sent.') +
+            (demo ? ' (Demo mode: no SMS service connected. Use ' + DEMO_CODE + '.)' : ''));
+          code.focus();
+          startCooldown();
+          listenForSms();
+        });
+      }
+
+      function submitCode() {
+        var value = code.value.replace(/\D/g, '');
+        if (value.length !== 6) {
+          setError(code, codeErr, 'Enter the 6-digit code from your text message.');
+          code.focus();
+          return;
+        }
+        setError(code, codeErr, '');
+        verifyBtn.disabled = true;
+        setStatus('Verifying…');
+        var done = demo
+          ? Promise.resolve({ ok: value === DEMO_CODE, error: 'That code is incorrect. Please try again.' })
+          : post(API.verify, { phone: e164, code: value });
+        done.then(function (res) {
+          verifyBtn.disabled = false;
+          if (res.ok) {
+            if (abort) abort.abort();
+            clearInterval(timer);
+            codeForm.hidden = true;
+            setStatus('Your phone number ' + e164 + ' is verified. Thank you!', true);
+          } else {
+            setError(code, codeErr, res.error || 'That code is incorrect or expired. Please try again.');
+            setStatus('');
+            code.select();
+          }
+        });
+      }
+
+      phoneForm.addEventListener('submit', function (e) {
+        e.preventDefault();
+        e164 = normalize(phone.value);
+        if (!e164) {
+          setError(phone, phoneErr, 'Enter a valid phone number including country code, like +1 555 123 4567.');
+          phone.focus();
+          return;
+        }
+        setError(phone, phoneErr, '');
+        sendCode(false);
+      });
+
+      codeForm.addEventListener('submit', function (e) { e.preventDefault(); submitCode(); });
+
+      // Keep digits only; auto-submit once the sixth digit is typed or pasted/autofilled.
+      code.addEventListener('input', function () {
+        var digits = code.value.replace(/\D/g, '').slice(0, 6);
+        if (digits !== code.value) code.value = digits;
+        if (digits.length) setError(code, codeErr, '');
+        if (digits.length === 6 && !verifyBtn.disabled) submitCode();
+      });
+
+      resendBtn.addEventListener('click', function () { sendCode(true); });
+
+      $('change-btn').addEventListener('click', function () {
+        if (abort) abort.abort();
+        clearInterval(timer);
+        codeForm.hidden = true;
+        phoneForm.hidden = false;
+        setStatus('');
+        phone.focus();
+      });
+    })();
+  </script>
 </body>
 
