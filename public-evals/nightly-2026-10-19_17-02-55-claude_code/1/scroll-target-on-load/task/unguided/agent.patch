+    /* Vertical scroll container */
+    .media-scroll {
+      position: relative; /* makes offsetTop of children relative to this box */
+      height: 480px;
+      margin-top: 20px;
+      overflow-y: auto;
+      scroll-behavior: auto; /* never animate the initial positioning */
+      display: flex;
+      flex-direction: column;
+      gap: 20px;
+      padding: 20px;
+      background: var(--secondary);
+      border-radius: 8px;
+    }
+
+    .media-card {
+      flex: none;
+      display: flex;
+      align-items: center;
+      gap: 20px;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .media-card img {
+      flex: none;
+      width: 240px;
+      height: 160px;
+      object-fit: cover;
+      border-radius: 6px;
+      background: var(--secondary);
+    }
+
+    .media-card h3 {
+      color: var(--primary);
+      margin-bottom: 6px;
+    }
+
+    @media (max-width: 600px) {
+      .media-card {
+        flex-direction: column;
+        align-items: flex-start;
+      }
+
+      .media-card img {
+        width: 100%;
+      }
+    }
+
