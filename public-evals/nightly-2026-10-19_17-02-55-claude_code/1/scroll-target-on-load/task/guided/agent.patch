+  <script>
+    // Fallback for browsers without scroll-initial-target. Runs at end of body,
+    // before first paint, so there is no visible jump.
+    if (!CSS.supports("scroll-initial-target", "nearest")) {
+      const feed = document.querySelector(".feed");
+      const target = feed.querySelector(".target");
+      // Scroll only the feed (not the page) so the window doesn't jump.
+      feed.scrollTop = target.offsetTop - (feed.clientHeight - target.offsetHeight) / 2;
+    }
+  </script>
