+  <script>
+    (function () {
+      var form = document.querySelector('.order-form');
+      var shop = document.getElementById('shop');
+
+      function validate() {
+        var valid = shop.value !== '' && !shop.options[shop.selectedIndex].disabled;
+        shop.classList.toggle('has-error', !valid);
+        shop.setAttribute('aria-invalid', String(!valid));
+        return valid;
+      }
+
+      // Validate after the user interacts (leaves the field or changes it), never on load
+      shop.addEventListener('blur', validate);
+      shop.addEventListener('change', validate);
+
+      form.addEventListener('submit', function (e) {
+        if (!validate()) {
+          e.preventDefault();
+          shop.focus();
+        }
+      });
+    })();
+  </script>
