+  <script>
+    // Keep aria-invalid in sync with the visual :user-invalid state
+    const syncAria = (el) => {
+      el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+    };
+    const shop = document.getElementById('shop');
+    shop.addEventListener('blur', () => syncAria(shop));
+    shop.addEventListener('input', () => {
+      if (shop.hasAttribute('aria-invalid')) syncAria(shop);
+    });
+    shop.addEventListener('invalid', () => syncAria(shop));
+  </script>
