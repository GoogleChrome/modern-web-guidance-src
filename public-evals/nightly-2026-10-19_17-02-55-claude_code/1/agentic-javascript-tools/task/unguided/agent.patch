diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,112 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Menu details exposed to AI assistants via the WebMCP tool below.
+    const MENU_ITEMS = [
+      {
+        name: "Maple Oat Latte",
+        category: "Seasonal Favorites",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        url: "/menu/seasonal"
+      },
+      {
+        name: "Dark Roast Espresso",
+        category: "Seasonal Favorites",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        url: "/menu/espresso"
+      },
+      {
+        name: "Cold Brew",
+        category: "Seasonal Favorites",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        url: "/menu/cold-brew"
+      }
+    ];
+
+    const normalize = (s) => String(s).toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
+
+    function findMenuItem(query) {
+      const q = normalize(query);
+      if (!q) return undefined;
+      return (
+        MENU_ITEMS.find((item) => normalize(item.name) === q) ||
+        MENU_ITEMS.find((item) => normalize(item.name).includes(q) || q.includes(normalize(item.name)))
+      );
+    }
+
+    const text = (obj, isError = false) => ({
+      content: [{ type: "text", text: JSON.stringify(obj) }],
+      ...(isError && { isError: true })
+    });
+
+    const MENU_TOOL_NAME = "get_menu_item_details";
+
+    function registerMenuTool() {
+      const modelContext = navigator.modelContext;
+      if (!modelContext || typeof modelContext.registerTool !== "function") return;
+
+      const controller = new AbortController();
+
+      try {
+        modelContext.registerTool(
+          {
+            name: MENU_TOOL_NAME,
+            description:
+              "Look up details (category, description, and page link) for a single item on The Daily Grind's menu by its name, e.g. 'Maple Oat Latte', 'Dark Roast Espresso' or 'Cold Brew'.",
+            inputSchema: {
+              type: "object",
+              properties: {
+                name: {
+                  type: "string",
+                  description:
+                    "The name of the menu item to look up, e.g. 'Cold Brew'. Matching is case-insensitive."
+                }
+              },
+              required: ["name"]
+            },
+            annotations: { readOnlyHint: true },
+            async execute({ name } = {}) {
+              const item = findMenuItem(name);
+              if (!item) {
+                return text(
+                  {
+                    error: `No menu item found matching "${name}".`,
+                    availableItems: MENU_ITEMS.map((i) => i.name)
+                  },
+                  true
+                );
+              }
+              return text(item);
+            }
+          },
+          { signal: controller.signal }
+        );
+      } catch (err) {
+        console.warn("Failed to register menu tool:", err);
+        return;
+      }
+
+      // Deactivate the tool when the page goes away.
+      window.addEventListener(
+        "pagehide",
+        () => {
+          controller.abort();
+          // Older WebMCP implementations ignore `signal` and use explicit unregistration.
+          try {
+            modelContext.unregisterTool?.(MENU_TOOL_NAME);
+          } catch (_) {
+            // Already unregistered via the abort signal.
+          }
+        },
+        { once: true }
+      );
+    }
+
+    registerMenuTool();
+  </script>
+
 </body>
 
 </html>
