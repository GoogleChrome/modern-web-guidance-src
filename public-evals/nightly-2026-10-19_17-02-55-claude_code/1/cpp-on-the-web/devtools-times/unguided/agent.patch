diff --git a/public/smallpt/index.html b/public/smallpt/index.html
new file mode 100644
index 0000000..3968f0a
--- /dev/null
+++ b/public/smallpt/index.html
@@ -0,0 +1,61 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>smallpt in WebAssembly</title>
+  <style>
+    body { font-family: system-ui, sans-serif; background: #111; color: #eee; text-align: center; margin: 2rem 1rem; }
+    canvas { max-width: 100%; height: auto; background: #000; border-radius: 6px; }
+    button { font-size: 1rem; padding: .6rem 1.2rem; margin: 1rem 0; border: 0; border-radius: 6px; background: #f5b301; cursor: pointer; }
+    button:disabled { opacity: .5; cursor: wait; }
+    p { color: #999; }
+    a { color: #f5b301; }
+  </style>
+</head>
+<body>
+  <h1>smallpt in WebAssembly</h1>
+  <canvas id="out" width="512" height="384"></canvas><br>
+  <button id="go" disabled>Render with random colors</button>
+  <p id="status">Loading…</p>
+  <p><a href="http://www.kevinbeason.com/smallpt/">smallpt</a> by Kevin Beason (MIT), compiled to WebAssembly and rendered client-side.</p>
+  <script>
+    const W = 512, H = 384, SPP = 64;
+    const canvas = document.getElementById('out');
+    const ctx = canvas.getContext('2d');
+    const btn = document.getElementById('go');
+    const status = document.getElementById('status');
+    const worker = new Worker('worker.js');
+
+    // Sphere indices: 0 left, 1 right, 2 back, 4 bottom, 5 top, 6 mirror, 7 glass.
+    const DEFAULT_COLORS = [[0, .75, .25, .25], [1, .25, .25, .75]];
+
+    function hsv(h, s, v) {
+      const f = n => { const k = (n + h * 6) % 6; return v - v * s * Math.max(0, Math.min(k, 4 - k, 1)); };
+      return [f(5), f(3), f(1)];
+    }
+    function randomColors() {
+      const rnd = () => hsv(Math.random(), .4 + Math.random() * .5, .35 + Math.random() * .5);
+      const walls = [0, 1, 2, 4, 5].map(i => [i, ...rnd()]);
+      // Tint the mirror and glass balls only lightly so they stay shiny/clear.
+      const balls = [6, 7].map(i => [i, ...hsv(Math.random(), .15, .999)]);
+      return [...walls, ...balls];
+    }
+
+    let t0;
+    function run(colors) {
+      btn.disabled = true;
+      status.textContent = `Rendering ${W}×${H} at ${SPP} spp…`;
+      t0 = performance.now();
+      worker.postMessage({ w: W, h: H, spp: SPP, colors });
+    }
+    worker.onmessage = ({ data: { w, h, pixels } }) => {
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(pixels.buffer), w, h), 0, 0);
+      status.textContent = `Rendered in ${((performance.now() - t0) / 1000).toFixed(1)} s`;
+      btn.disabled = false;
+    };
+    btn.onclick = () => run(randomColors());
+    run(DEFAULT_COLORS);
+  </script>
+</body>
+</html>
