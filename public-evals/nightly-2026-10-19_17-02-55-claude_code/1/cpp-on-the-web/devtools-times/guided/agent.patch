@@ -0,0 +1,6 @@
+#!/bin/sh
+# Compiles src/smallpt.cpp to smallpt.js + smallpt.wasm (requires Emscripten).
+cd "$(dirname "$0")" && em++ src/smallpt.cpp -O3 -o smallpt.js \
+  -sEXPORT_ES6 -sENVIRONMENT=worker -sALLOW_MEMORY_GROWTH \
+  -sEXPORTED_FUNCTIONS=_init,_render_rows,_set_color,_malloc,_free \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
diff --git a/public/smallpt/index.html b/public/smallpt/index.html
new file mode 100644
index 0000000..1522b9f
--- /dev/null
+++ b/public/smallpt/index.html
@@ -0,0 +1,59 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>smallpt in WebAssembly</title>
+  <style>
+    :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
+    body { max-width: 52rem; margin: 2rem auto; padding: 0 1rem; text-align: center; }
+    canvas { width: 100%; height: auto; aspect-ratio: 4 / 3; background: #000; }
+    button { font: inherit; padding: .6em 1.2em; margin: 1rem 0; }
+    progress { width: 100%; }
+  </style>
+</head>
+<body>
+  <h1>smallpt, in your browser</h1>
+  <p><a href="http://www.kevinbeason.com/smallpt/">smallpt</a> by Kevin Beason, a 99-line C++ path tracer, compiled to WebAssembly and rendered client-side in a Web Worker.</p>
+  <canvas id="out" width="640" height="480" aria-label="Path-traced Cornell box scene"></canvas>
+  <progress id="bar" max="1" value="0"></progress>
+  <p id="status" role="status"></p>
+  <button id="again" type="button" disabled>Render again with random colors</button>
+
+  <script type="module">
+    const canvas = document.getElementById('out');
+    const ctx = canvas.getContext('2d');
+    const bar = document.getElementById('bar');
+    const status = document.getElementById('status');
+    const button = document.getElementById('again');
+    const worker = new Worker('./worker.js', { type: 'module' });
+    let t0;
+
+    const rand = () => 0.15 + Math.random() * 0.75;
+    const randomColors = () => Object.fromEntries(
+      [0, 1, 2, 4, 5, 6, 7].map(i => [i, [rand(), rand(), rand()]]));
+
+    function render(colors) {
+      button.disabled = true;
+      bar.value = 0;
+      status.textContent = 'Rendering…';
+      t0 = performance.now();
+      worker.postMessage({ colors, seed: (Math.random() * 2 ** 32) >>> 0 });
+    }
+
+    worker.onmessage = ({ data }) => {
+      if (data.type === 'progress') {
+        bar.value = data.done;
+        return;
+      }
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), data.width, data.height), 0, 0);
+      status.textContent = `Rendered in ${((performance.now() - t0) / 1000).toFixed(1)} s`;
+      button.disabled = false;
+    };
+    worker.onerror = () => { status.textContent = 'Failed to load the WebAssembly renderer.'; };
+
+    button.addEventListener('click', () => render(randomColors()));
+    render({}); // first render uses the original smallpt colours
+  </script>
+</body>
+</html>
