diff --git a/smallpt/worker.js b/smallpt/worker.js
new file mode 100644
index 0000000..3da0158
--- /dev/null
+++ b/smallpt/worker.js
@@ -0,0 +1,19 @@
+var Module = {};
+// Runs the smallpt WebAssembly renderer off the main thread.
+importScripts('smallpt.js');
+
+let ready = new Promise(res => { Module.onRuntimeInitialized = res; });
+
+onmessage = async (e) => {
+  await ready;
+  const { w, h, spp, colors } = e.data;
+  const buf = Module._malloc(colors.length * 8);
+  Module.HEAPF64.set(colors, buf / 8);
+  Module._set_colors(buf);
+  Module._free(buf);
+  const t0 = performance.now();
+  const ptr = Module._render(w, h, spp);
+  const pixels = Module.HEAPU8.slice(ptr, ptr + w * h * 4);
+  Module._release(ptr);
+  postMessage({ w, h, pixels, ms: performance.now() - t0 }, [pixels.buffer]);
+};
