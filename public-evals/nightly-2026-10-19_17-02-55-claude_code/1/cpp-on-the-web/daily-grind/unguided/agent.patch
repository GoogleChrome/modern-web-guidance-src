+  <script>
+    const W = 512, H = 384, SPP = 64;
+    const canvas = document.getElementById('render-canvas');
+    const btn = document.getElementById('render-btn');
+    const status = document.getElementById('render-status');
+    const ctx = canvas.getContext('2d');
+    const worker = new Worker('smallpt/worker.js');
+
+    // Original smallpt colors for the 8 non-light spheres (left, right, back,
+    // front, bottom, top, mirror, glass).
+    const DEFAULTS = [.75, .25, .25, .25, .25, .75, .75, .75, .75, 0, 0, 0,
+      .75, .75, .75, .75, .75, .75, .999, .999, .999, .999, .999, .999];
+
+    function hsv(h, s, v) {
+      const f = n => { const k = (n + h * 6) % 6; return v - v * s * Math.max(0, Math.min(k, 4 - k, 1)); };
+      return [f(5), f(3), f(1)];
+    }
+
+    function randomColors() {
+      const colors = DEFAULTS.slice();
+      const set = (i, rgb) => colors.splice(i * 3, 3, ...rgb);
+      const rnd = (a, b) => a + Math.random() * (b - a);
+      // Every sphere except the (black) front wall gets a random color.
+      for (const i of [0, 1, 2, 4, 5]) set(i, hsv(Math.random(), rnd(.3, .85), rnd(.5, .85)));
+      for (const i of [6, 7]) set(i, hsv(Math.random(), rnd(.1, .5), .999));
+      return colors;
+    }
+
+    function render(colors) {
+      btn.disabled = true;
+      status.textContent = 'Rendering…';
+      worker.postMessage({ w: W, h: H, spp: SPP, colors });
+    }
+
+    worker.onmessage = (e) => {
+      const { w, h, pixels, ms } = e.data;
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(pixels.buffer), w, h), 0, 0);
+      status.textContent = `${w}×${h}, ${SPP} samples/pixel, rendered in ${(ms / 1000).toFixed(1)}s`;
+      btn.disabled = false;
+    };
+
+    btn.addEventListener('click', () => render(randomColors()));
+    render(new Float64Array(DEFAULTS));
+  </script>
 </body>
 
