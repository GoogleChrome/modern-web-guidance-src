     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const toggleCard = document.getElementById('toggleCard');
+    const LEAVE_MS = 400;
+    let promoCount = 0;
+
+    document.getElementById('addBtn').addEventListener('click', () => {
+      promoCount++;
+      const card = document.createElement('div');
+      card.className = 'card promo-card is-entering';
+      card.innerHTML = `<h3>Promo #${promoCount}</h3><p>Limited-time offer on your favorite brew.</p>`;
+      domContainer.appendChild(card);
+      card.getBoundingClientRect(); // commit the start state so the transition runs
+      card.classList.remove('is-entering');
+    });
+
+    document.getElementById('removeBtn').addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not(.is-leaving)');
+      const last = cards[cards.length - 1];
+      if (!last) return;
+      last.classList.add('is-leaving');
+      let done = false;
+      const finish = () => {
+        if (done) return;
+        done = true;
+        last.remove();
+      };
+      last.addEventListener('transitionend', finish, { once: true });
+      setTimeout(finish, LEAVE_MS + 100);
+    });
+
+    document.getElementById('toggleBtn').addEventListener('click', () => {
+      toggleCard.toggleAttribute('hidden');
+    });
+  </script>
 </body>
 
