+    <section id="subscribe" class="subscribe" aria-labelledby="subscribe-heading" style="margin-top: 40px;">
+      <h2 id="subscribe-heading">Your Personalized Coffee Subscription</h2>
+      <p class="intro">Tell us how you like your coffee and we'll deliver it fresh.</p>
+
+      <form id="subscription-form">
+        <fieldset>
+          <legend>Preferred delivery frequency</legend>
+          <div class="option">
+            <input type="radio" id="freq-weekly" name="frequency" value="weekly">
+            <label for="freq-weekly">Weekly</label>
+          </div>
+          <div class="option">
+            <input type="radio" id="freq-biweekly" name="frequency" value="biweekly">
+            <label for="freq-biweekly">Every 2 weeks</label>
+          </div>
+          <div class="option">
+            <input type="radio" id="freq-monthly" name="frequency" value="monthly">
+            <label for="freq-monthly">Monthly</label>
+          </div>
+        </fieldset>
+
+        <div class="field">
+          <label class="field-label" for="roast-level" style="display: block;">
+            Roast preference: <span class="roast-value" id="roast-value">Medium</span>
+          </label>
+          <input type="range" id="roast-level" name="roast" min="1" max="5" step="1" value="3"
+            aria-describedby="roast-scale" aria-valuetext="Medium">
+          <div class="range-scale" id="roast-scale" aria-hidden="true">
+            <span>Light</span>
+            <span>Dark</span>
+          </div>
+        </div>
+
+        <div class="field">
+          <div class="option">
+            <input type="checkbox" id="email-optin" name="emails" value="yes">
+            <label for="email-optin">Email me order updates, brewing tips, and offers</label>
+          </div>
+        </div>
+
+        <div class="field">
+          <label class="field-label" for="setup-progress" style="display: block;">Subscription setup progress</label>
+          <progress id="setup-progress" max="100" value="0">0%</progress>
+          <p class="progress-text" id="progress-text" aria-live="polite">0 of 3 steps complete</p>
+        </div>
+
+        <button type="submit" id="subscribe-submit">Start My Subscription</button>
+        <p class="confirmation" id="subscribe-confirmation" role="status"></p>
+      </form>
+    </section>
   </main>
 
+  <script>
+    (function () {
+      var form = document.getElementById('subscription-form');
+      var roast = document.getElementById('roast-level');
+      var roastValue = document.getElementById('roast-value');
+      var email = document.getElementById('email-optin');
+      var progress = document.getElementById('setup-progress');
+      var progressText = document.getElementById('progress-text');
+      var confirmation = document.getElementById('subscribe-confirmation');
+      var roastNames = ['Light', 'Medium-Light', 'Medium', 'Medium-Dark', 'Dark'];
+      var roastTouched = false;
+
+      function update() {
+        var done = 0;
+        if (form.elements.frequency.value) done++;
+        if (roastTouched) done++;
+        if (email.checked) done++;
+        var pct = Math.round(done / 3 * 100);
+        progress.value = pct;
+        progress.textContent = pct + '%';
+        progressText.textContent = done + ' of 3 steps complete';
+      }
+
+      roast.addEventListener('input', function () {
+        var name = roastNames[roast.value - 1];
+        roastTouched = true;
+        roastValue.textContent = name;
+        roast.setAttribute('aria-valuetext', name);
+        update();
+      });
+      form.addEventListener('change', update);
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        confirmation.textContent = form.elements.frequency.value
+          ? 'Thanks! Your subscription preferences are saved.'
+          : 'Please choose a delivery frequency.';
+      });
+    })();
+  </script>
