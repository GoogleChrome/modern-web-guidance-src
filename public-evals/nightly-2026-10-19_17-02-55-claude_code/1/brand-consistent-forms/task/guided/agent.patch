+  <script>
+    (() => {
+      const form = document.getElementById('subscribe-form');
+      const roast = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-output');
+      const optin = document.getElementById('email-optin');
+      const progress = document.getElementById('setup-progress');
+      const progressText = document.getElementById('progress-text');
+      const status = document.getElementById('form-status');
+      const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+      // Setup steps: delivery frequency chosen, roast adjusted, email preference decided.
+      const done = { frequency: false, roast: false, email: false };
+
+      function update() {
+        const name = roastNames[roast.value - 1];
+        roastOutput.value = name;
+        roast.setAttribute('aria-valuetext', name);
+
+        const complete = Object.values(done).filter(Boolean).length;
+        const percent = Math.round((complete / Object.keys(done).length) * 100);
+        progress.value = percent;
+        progress.textContent = `${percent}%`;
+        progressText.textContent = `${percent}% complete`;
+      }
+
+      form.addEventListener('change', (e) => {
+        if (e.target.name === 'frequency') done.frequency = true;
+        if (e.target === optin) done.email = true;
+        update();
+      });
+
+      roast.addEventListener('input', () => {
+        done.roast = true;
+        update();
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        status.textContent = `Thanks! Your ${form.elements.frequency.value} ${roastNames[roast.value - 1].toLowerCase()} roast subscription is set up.`;
+      });
+
+      update();
+    })();
+  </script>
+
 </body>
 
