     }
 
@@ -206,7 +230,29 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers without scroll-driven animations: same effect via a scroll listener
+    if (!CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)') &&
+      !matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      const nav = document.querySelector('nav');
+      const distance = 120;
+      let ticking = false;
+
+      const update = () => {
+        nav.style.setProperty('--p', Math.min(1, Math.max(0, window.scrollY / distance)));
+        ticking = false;
+      };
+
+      window.addEventListener('scroll', () => {
+        if (!ticking) {
+          ticking = true;
+          requestAnimationFrame(update);
+        }
+      }, { passive: true });
+      update();
+    }
+  </script>
 </body>
 
 </html>
