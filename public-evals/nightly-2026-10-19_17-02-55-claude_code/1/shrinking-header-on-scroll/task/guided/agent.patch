+    @property --p {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    @keyframes collapse-nav {
+      to {
+        --p: 1;
+      }
+    }
+
     nav {
       background: var(--primary);
       color: white;
-      padding: 1rem 5%;
+      padding: calc(1rem - 0.45rem * var(--p)) 5%;
