     }
@@ -206,7 +242,34 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers without CSS scroll-driven animations:
+    // map scroll position to the same 0..1 progress via --p.
+    if (!(window.CSS && CSS.supports && CSS.supports('animation-timeline: scroll()'))) {
+      (function () {
+        var nav = document.querySelector('nav');
+        var RANGE = 150, ticking = false;
+
+        function update() {
+          var y = window.pageYOffset || document.documentElement.scrollTop || 0;
+          var p = Math.min(Math.max(y / RANGE, 0), 1);
+          nav.style.setProperty('--p', p);
+          nav.style.boxShadow = '0 2px 8px rgba(0,0,0,' + (0.3 * p) + ')';
+          ticking = false;
+        }
+
+        function onScroll() {
+          if (ticking) return;
+          ticking = true;
+          (window.requestAnimationFrame || function (f) { setTimeout(f, 16); })(update);
+        }
+
+        window.addEventListener('scroll', onScroll, false);
+        update();
+      })();
+    }
+  </script>
 </body>
 
 </html>
