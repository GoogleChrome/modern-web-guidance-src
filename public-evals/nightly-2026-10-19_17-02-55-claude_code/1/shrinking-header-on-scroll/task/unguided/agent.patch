@@ -41,12 +43,46 @@
     }
 
     .logo {
       font-size: 1.5rem;
+      font-size: calc(1.5rem - 0.4rem * var(--p, 0));
       font-weight: bold;
       letter-spacing: 1px;
     }
 
+    /* Native path: shrink is driven directly by the scroll position */
+    @supports (animation-timeline: scroll()) {
+      nav,
+      .logo {
+        animation: linear both;
+        animation-timeline: scroll(root block);
+        animation-range: 0 150px;
+      }
