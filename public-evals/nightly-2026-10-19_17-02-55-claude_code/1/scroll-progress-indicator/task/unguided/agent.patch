+    /* Scroll progress indicator */
+    .scroll-progress {
+      position: fixed;
+      top: 0;
+      left: 0;
+      width: 100%;
+      height: 4px;
+      background: var(--accent);
+      transform: scaleX(0);
+      transform-origin: left center;
+      z-index: 1100;
+      pointer-events: none;
+    }
+
+    /* Native scroll-driven animation where supported; JS fallback sets --scroll-progress otherwise */
+    @supports (animation-timeline: scroll()) {
+      .scroll-progress {
+        animation: scroll-progress linear both;
+        animation-timeline: scroll(root block);
+      }
+
+      @keyframes scroll-progress {
+        from {
+          transform: scaleX(0);
+        }
+
+        to {
+          transform: scaleX(1);
+        }
+      }
+    }
