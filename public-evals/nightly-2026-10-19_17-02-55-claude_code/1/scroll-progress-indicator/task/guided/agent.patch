@@ -206,7 +233,21 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers without scroll-driven animations (e.g. Firefox)
+    if (!CSS.supports('animation-timeline', 'scroll()')) {
+      const progress = document.querySelector('#progress');
+      const update = () => {
+        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
+        progress.style.transform = `scaleX(${scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0})`;
+      };
+      window.addEventListener('scroll', update, { passive: true });
+      window.addEventListener('resize', update);
+      update();
+    }
+  </script>
+
 </body>
 
