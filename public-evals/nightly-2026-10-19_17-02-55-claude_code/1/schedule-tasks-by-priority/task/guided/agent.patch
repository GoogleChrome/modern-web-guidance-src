+  <script>
+    (() => {
+      const PRIORITIES = { urgent: 0, standard: 1, background: 2 };
+      const TASKS = {
+        checkout: { label: 'Checkout', priority: 'urgent', steps: 40 },
+        menu: { label: 'Menu update', priority: 'standard', steps: 120 },
+        telemetry: { label: 'Telemetry logging', priority: 'background', steps: 200 }
+      };
+      const SLICE_MS = 40; // stay under the 50ms long-task threshold
+      const WORK_PER_STEP_MS = 4; // simulated CPU cost of one step
+
+      const $ = (id) => document.getElementById(id);
+      const list = $('ops-list');
+      const log = $('ops-log');
+      const queue = [];
+      let running = false;
+      let seq = 0;
+      let done = 0;
+      let longestSlice = 0;
+
+      const yieldToMain = () =>
+        'scheduler' in window && 'yield' in scheduler
+          ? scheduler.yield()
+          : new Promise((resolve) => setTimeout(resolve, 0));
+
+      function write(message) {
+        const li = document.createElement('li');
+        li.textContent = `[${new Date().toLocaleTimeString()}] ${message}`;
+        log.append(li);
+        log.scrollTop = log.scrollHeight;
+      }
+
+      function updateStats() {
+        $('ops-queued').textContent = queue.length;
+        $('ops-done').textContent = done;
+        $('ops-slice').textContent = Math.round(longestSlice);
+      }
+
+      function busyWait(ms) {
+        const end = performance.now() + ms;
+        while (performance.now() < end);
+      }
+
+      function enqueue(type) {
+        const def = TASKS[type];
+        const task = { id: ++seq, ...def, step: 0 };
+
+        const li = document.createElement('li');
+        li.className = 'ops-item';
+        li.dataset.priority = task.priority;
+        const name = document.createElement('span');
+        name.textContent = `#${task.id} ${task.label}`;
+        const state = document.createElement('span');
+        state.textContent = `${task.priority} · queued`;
+        const bar = document.createElement('progress');
+        bar.max = task.steps;
+        bar.value = 0;
+        bar.setAttribute('aria-label', `${task.label} #${task.id} progress`);
+        li.append(name, state, bar);
+        list.prepend(li);
+        task.state = state;
+        task.bar = bar;
+
+        queue.push(task);
+        write(`Queued #${task.id} ${task.label} (${task.priority})`);
+        updateStats();
+        if (!running) run();
+      }
+
+      // Highest priority first; FIFO within a priority.
+      function next() {
+        let best = -1;
+        queue.forEach((t, i) => {
+          if (best < 0 || PRIORITIES[t.priority] < PRIORITIES[queue[best].priority]) best = i;
+        });
+        return best;
+      }
+
+      async function run() {
+        running = true;
+        let current = null;
+        while (queue.length) {
+          // Re-evaluate after every slice so newly queued urgent work preempts.
+          const task = queue[next()];
+          if (task !== current) {
+            if (current && current.step < current.steps) {
+              current.state.textContent = `${current.priority} · paused`;
+              write(`Paused #${current.id} ${current.label} for #${task.id} ${task.label}`);
+            }
+            current = task;
+            task.state.textContent = `${task.priority} · running`;
+            if (task.step === 0) write(`Started #${task.id} ${task.label}`);
+          }
+
+          const start = performance.now();
+          while (task.step < task.steps && performance.now() - start < SLICE_MS) {
+            busyWait(WORK_PER_STEP_MS);
+            task.step++;
+          }
+          longestSlice = Math.max(longestSlice, performance.now() - start);
+          task.bar.value = task.step;
+
+          if (task.step >= task.steps) {
+            queue.splice(queue.indexOf(task), 1);
+            task.state.textContent = `${task.priority} · done`;
+            write(`Finished #${task.id} ${task.label}`);
+            done++;
+            current = null;
+          }
+          updateStats();
+          await yieldToMain();
+        }
+        running = false;
+      }
+
+      document.querySelector('.ops-controls').addEventListener('click', (e) => {
+        const type = e.target.closest('button')?.dataset.task;
+        if (!type) return;
+        if (type === 'batch') {
+          // Deliberately submitted in mixed order; the queue sorts by priority.
+          write('Batch submitted: telemetry, menu, checkout, telemetry, checkout, menu');
+          ['telemetry', 'menu', 'checkout', 'telemetry', 'checkout', 'menu'].forEach(enqueue);
+        } else {
+          enqueue(type);
+        }
+      });
+    })();
+  </script>
+
 </body>
 
