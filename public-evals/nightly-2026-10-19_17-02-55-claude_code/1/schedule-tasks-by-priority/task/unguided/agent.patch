+  <script>
+    (() => {
+      const SLICE_MS = 8; // max time a task may hold the main thread before yielding
+
+      // Lower number = higher priority.
+      const TASKS = {
+        checkout: { label: 'Checkout', priority: 0, cls: 'urgent', cost: 300 },
+        menu: { label: 'Menu update', priority: 1, cls: 'standard', cost: 1200 },
+        telemetry: { label: 'Telemetry log', priority: 2, cls: 'background', cost: 2500 }
+      };
+      const BATCH = ['telemetry', 'menu', 'telemetry', 'checkout', 'menu', 'checkout', 'telemetry'];
+
+      const $ = (id) => document.getElementById(id);
+      const queueEl = $('ops-queue');
+      const logEl = $('ops-log');
+
+      let queue = [];
+      let nextId = 1;
+      let completed = 0;
+      let maxSlice = 0;
+      let running = false;
+      let current = null;
+
+      function enqueue(type) {
+        const t = TASKS[type];
+        queue.push({ id: nextId++, ...t, remaining: t.cost, seq: nextId });
+        render();
+        if (!running) {
+          running = true;
+          yieldToBrowser().then(pump);
+        }
+      }
+
+      // Highest priority first; FIFO within the same priority.
+      function pickNext() {
+        return queue.reduce((best, t) =>
+          !best || t.priority < best.priority || (t.priority === best.priority && t.seq < best.seq) ? t : best, null);
+      }
+
+      function yieldToBrowser() {
+        if (globalThis.scheduler && scheduler.yield) return scheduler.yield();
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      // Simulated CPU work: spin for up to SLICE_MS, or until the task's work is done.
+      function doSlice(task) {
+        const start = performance.now();
+        const budget = Math.min(SLICE_MS, task.remaining);
+        while (performance.now() - start < budget) { /* busy work */ }
+        const elapsed = performance.now() - start;
+        task.remaining -= Math.max(elapsed, 1);
+        maxSlice = Math.max(maxSlice, elapsed);
+      }
+
+      async function pump() {
+        // Re-pick after every slice so newly queued urgent tasks preempt long-running ones.
+        let task;
+        while ((task = pickNext())) {
+          if (current !== task) {
+            if (current && queue.includes(current) && current.remaining > 0) {
+              log(`${current.label} #${current.id} preempted by ${task.label} #${task.id}`, current.cls);
+            }
+            current = task;
+            if (task.started == null) {
+              task.started = true;
+              log(`Started ${task.label} #${task.id}`, task.cls);
+            }
+            render();
+          }
+          doSlice(task);
+          if (task.remaining <= 0) {
+            queue = queue.filter((t) => t !== task);
+            completed++;
+            current = null;
+            log(`Finished ${task.label} #${task.id}`, task.cls);
+          }
+          render();
+          await yieldToBrowser();
+        }
+        running = false;
+      }
+
+      function log(msg, cls) {
+        const empty = logEl.querySelector('.empty');
+        if (empty) empty.remove();
+        const li = document.createElement('li');
+        li.className = cls;
+        li.textContent = `${new Date().toLocaleTimeString()} – ${msg}`;
+        logEl.prepend(li);
+        while (logEl.children.length > 100) logEl.lastChild.remove();
+      }
+
+      function render() {
+        $('ops-pending').textContent = queue.length;
+        $('ops-done').textContent = completed;
+        $('ops-slice').textContent = maxSlice.toFixed(1);
+        queueEl.replaceChildren();
+        if (!queue.length) {
+          const li = document.createElement('li');
+          li.className = 'empty';
+          li.textContent = 'Queue is empty';
+          queueEl.append(li);
+          return;
+        }
+        const ordered = [...queue].sort((a, b) => a.priority - b.priority || a.seq - b.seq);
+        for (const t of ordered) {
+          const li = document.createElement('li');
+          const pct = Math.round((1 - Math.max(t.remaining, 0) / t.cost) * 100);
+          li.className = t.cls + (t === current ? ' running' : '');
+          li.textContent = `#${t.id} ${t.label} – ${t === current ? pct + '%' : t.started ? 'paused ' + pct + '%' : 'waiting'}`;
+          queueEl.append(li);
+        }
+      }
+
+      document.querySelector('.ops-controls').addEventListener('click', (e) => {
+        const btn = e.target.closest('[data-task]');
+        if (!btn) return;
+        if (btn.dataset.task === 'batch') {
+          log(`Batch submitted: ${BATCH.length} mixed tasks (run in priority order)`, 'standard');
+          BATCH.forEach(enqueue);
+        } else {
+          enqueue(btn.dataset.task);
+        }
+      });
+
+      $('ops-clear').addEventListener('click', () => {
+        logEl.replaceChildren();
+        completed = 0;
+        maxSlice = 0;
+        render();
+      });
+
+      logEl.innerHTML = '<li class="empty">No activity yet</li>';
+      render();
+    })();
+  </script>
 </body>
 
