+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var status = document.getElementById('status');
+      var beans = scroller.querySelectorAll('.bean');
+      var scrolling = false;
+      var fallbackTimer = null;
+      var hasScrollEnd = 'onscrollend' in window;
+
+      function mostVisibleOrigin() {
+        var box = scroller.getBoundingClientRect();
+        var best = null;
+        var bestWidth = -1;
+        for (var i = 0; i < beans.length; i++) {
+          var r = beans[i].getBoundingClientRect();
+          var visible = Math.min(r.right, box.right) - Math.max(r.left, box.left);
+          if (visible > bestWidth) {
+            bestWidth = visible;
+            best = beans[i];
+          }
+        }
+        return best ? best.dataset.origin : '';
+      }
+
+      function onScrollEnd() {
+        scrolling = false;
+        status.textContent = 'Scroll ended. Visible: ' + mostVisibleOrigin();
+      }
+
+      // Hot path: only touches the DOM on the first event of a scroll gesture.
+      function onScroll() {
+        if (!scrolling) {
+          scrolling = true;
+          status.textContent = 'Scrolling...';
+        }
+        if (!hasScrollEnd) {
+          clearTimeout(fallbackTimer);
+          fallbackTimer = setTimeout(onScrollEnd, 150);
+        }
+      }
+
+      scroller.addEventListener('scroll', onScroll, { passive: true });
+      if (hasScrollEnd) scroller.addEventListener('scrollend', onScrollEnd);
+    })();
+  </script>
