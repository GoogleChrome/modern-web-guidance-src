+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const beans = scroller.querySelectorAll('.bean');
+    let scrolling = false;
+
+    // Scroll handler is just a flag check; the DOM is written once per gesture.
+    scroller.addEventListener('scroll', () => {
+      if (scrolling) return;
+      scrolling = true;
+      status.textContent = 'Scrolling...';
+    }, { passive: true });
+
+    scroller.addEventListener('scrollend', () => {
+      scrolling = false;
+      const view = scroller.getBoundingClientRect();
+      let best = null, bestWidth = -1;
+      for (const bean of beans) {
+        const r = bean.getBoundingClientRect();
+        const w = Math.min(r.right, view.right) - Math.max(r.left, view.left);
+        if (w > bestWidth) { bestWidth = w; best = bean; }
+      }
+      status.textContent = `Scroll ended. Visible: ${best.dataset.origin}`;
+    });
+
+    // Fallback for browsers without scrollend: debounce scroll.
+    if (!('onscrollend' in window)) {
+      let timer;
+      scroller.addEventListener('scroll', () => {
+        clearTimeout(timer);
+        timer = setTimeout(() => scroller.dispatchEvent(new Event('scrollend')), 100);
+      }, { passive: true });
+    }
+  </script>
+
