diff --git a/src/pages/api/passkeys/[action].ts b/src/pages/api/passkeys/[action].ts
new file mode 100644
index 0000000..b0a673d
--- /dev/null
+++ b/src/pages/api/passkeys/[action].ts
@@ -0,0 +1,249 @@
+import type { APIRoute } from 'astro';
+import {
+  generateAuthenticationOptions,
+  generateRegistrationOptions,
+  verifyAuthenticationResponse,
+  verifyRegistrationResponse,
+} from '@simplewebauthn/server';
+import {
+  CHALLENGE_TTL_MS,
+  REAUTH_WINDOW_MS,
+  RP_NAME,
+  findUserById,
+  findUserByUsername,
+  getRp,
+  json,
+  newUserId,
+  normalizeUsername,
+  publicPasskey,
+  readUsers,
+  withStore,
+  type StoredPasskey,
+} from '../../../utils/passkeys';
+
+export const prerender = false;
+
+type Pending = {
+  purpose: 'signup' | 'add' | 'signin' | 'reauth';
+  challenge: string;
+  expires: number;
+  userId?: string;
+  username?: string;
+};
+
+const b64u = {
+  toBytes: (s: string) => new Uint8Array(Buffer.from(s, 'base64url')),
+  fromBytes: (b: Uint8Array) => Buffer.from(b).toString('base64url'),
+};
+
+export const POST: APIRoute = async ({ params, request, url, session }) => {
+  if (!session) return json({ error: 'Sessions unavailable' }, 500);
+  const { rpID, origin } = getRp(request, url);
+  const body = await request.json().catch(() => ({}));
+
+  const takePending = async (...purposes: Pending['purpose'][]) => {
+    const p = (await session.get('passkeyPending')) as Pending | undefined;
+    session.delete('passkeyPending'); // single use
+    if (!p || p.expires < Date.now() || !purposes.includes(p.purpose)) return null;
+    return p;
+  };
+  const setPending = (p: Omit<Pending, 'expires'>) =>
+    session.set('passkeyPending', { ...p, expires: Date.now() + CHALLENGE_TTL_MS });
+
+  const currentUser = async () => {
+    const id = await session.get('userId');
+    return id ? findUserById(id as string) : undefined;
+  };
+  const isFresh = async () => Date.now() - ((await session.get('authAt')) as number ?? 0) < REAUTH_WINDOW_MS;
+
+  const signIn = async (userId: string) => {
+    session.regenerate?.();
+    session.set('userId', userId);
+    session.set('authAt', Date.now());
+  };
+
+  switch (params.action) {
+    // ---- Registration: new account (signed out) or additional passkey (signed in, fresh) ----
+    case 'register-options': {
+      const user = await currentUser();
+      let userId: string, username: string, exclude: StoredPasskey[] = [];
+      if (user) {
+        if (!(await isFresh())) return json({ error: 'Reauthentication required', code: 'REAUTH_REQUIRED' }, 401);
+        ({ id: userId, username } = user);
+        exclude = user.passkeys;
+      } else {
+        const name = normalizeUsername(body.username);
+        if (!name) return json({ error: 'Username must be 3–32 characters: letters, numbers, . _ -' }, 400);
+        if (await findUserByUsername(name)) return json({ error: 'That username is taken' }, 409);
+        userId = newUserId();
+        username = name;
+      }
+      const options = await generateRegistrationOptions({
+        rpName: RP_NAME,
+        rpID,
+        userName: username,
+        userID: new TextEncoder().encode(userId),
+        attestationType: 'none',
+        excludeCredentials: exclude.map((c) => ({ id: c.id, transports: c.transports as any })),
+        authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+      });
+      await setPending({ purpose: user ? 'add' : 'signup', challenge: options.challenge, userId, username });
+      return json(options);
+    }
+
+    case 'register-verify': {
+      const p = await takePending('signup', 'add');
+      if (!p) return json({ error: 'Registration expired. Please try again.' }, 400);
+      if (p.purpose === 'add') {
+        const user = await currentUser();
+        if (!user || user.id !== p.userId || !(await isFresh()))
+          return json({ error: 'Reauthentication required', code: 'REAUTH_REQUIRED' }, 401);
+      }
+      let verification;
+      try {
+        verification = await verifyRegistrationResponse({
+          response: body.response,
+          expectedChallenge: p.challenge,
+          expectedOrigin: origin,
+          expectedRPID: rpID,
+        });
+      } catch (e) {
+        return json({ error: `Verification failed: ${(e as Error).message}` }, 400);
+      }
+      if (!verification.verified) return json({ error: 'Verification failed' }, 400);
+      const { credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+      const label = typeof body.name === 'string' ? body.name.trim().slice(0, 50) : '';
+
+      const result = await withStore((users) => {
+        if (users.some((u) => u.passkeys.some((k) => k.id === credential.id))) return 'duplicate' as const;
+        const passkey: StoredPasskey = {
+          id: credential.id,
+          publicKey: b64u.fromBytes(credential.publicKey),
+          counter: credential.counter,
+          transports: credential.transports,
+          deviceType: credentialDeviceType,
+          backedUp: credentialBackedUp,
+          name: label || `Passkey ${new Date().toLocaleDateString('en-US')}`,
+          createdAt: Date.now(),
+        };
+        if (p.purpose === 'signup') {
+          if (users.some((u) => u.username.toLowerCase() === p.username!.toLowerCase())) return 'taken' as const;
+          users.push({ id: p.userId!, username: p.username!, createdAt: Date.now(), passkeys: [passkey] });
+        } else {
+          users.find((u) => u.id === p.userId)!.passkeys.push(passkey);
+        }
+        return 'ok' as const;
+      });
+      if (result === 'duplicate') return json({ error: 'This passkey is already registered' }, 409);
+      if (result === 'taken') return json({ error: 'That username is taken' }, 409);
+      if (p.purpose === 'signup') await signIn(p.userId!);
+      return json({ verified: true, username: p.username });
+    }
+
+    // ---- Authentication & reauthentication ----
+    case 'auth-options': {
+      const reauth = body.mode === 'reauth';
+      const user = reauth ? await currentUser() : undefined;
+      if (reauth && !user) return json({ error: 'Not signed in' }, 401);
+      const options = await generateAuthenticationOptions({
+        rpID,
+        userVerification: 'preferred',
+        // Sign-in uses discoverable credentials; reauth is restricted to the signed-in user's passkeys.
+        allowCredentials: user?.passkeys.map((c) => ({ id: c.id, transports: c.transports as any })),
+      });
+      await setPending({ purpose: reauth ? 'reauth' : 'signin', challenge: options.challenge, userId: user?.id });
+      return json(options);
+    }
+
+    case 'auth-verify': {
+      const p = await takePending('signin', 'reauth');
+      if (!p) return json({ error: 'Authentication expired. Please try again.' }, 400);
+      const credId: string | undefined = body.response?.id;
+      const users = await readUsers();
+      const user = users.find((u) => u.passkeys.some((k) => k.id === credId));
+      const passkey = user?.passkeys.find((k) => k.id === credId);
+      if (!user || !passkey) return json({ error: 'Unknown passkey' }, 400);
+      if (p.purpose === 'reauth' && (user.id !== p.userId || user.id !== (await session.get('userId'))))
+        return json({ error: 'That passkey belongs to a different account' }, 403);
+
+      let verification;
+      try {
+        verification = await verifyAuthenticationResponse({
+          response: body.response,
+          expectedChallenge: p.challenge,
+          expectedOrigin: origin,
+          expectedRPID: rpID,
+          credential: {
+            id: passkey.id,
+            publicKey: b64u.toBytes(passkey.publicKey),
+            counter: passkey.counter,
+            transports: passkey.transports as any,
+          },
+        });
+      } catch (e) {
+        return json({ error: `Verification failed: ${(e as Error).message}` }, 400);
+      }
+      if (!verification.verified) return json({ error: 'Verification failed' }, 400);
+
+      await withStore((all) => {
+        const k = all.find((u) => u.id === user.id)!.passkeys.find((x) => x.id === credId)!;
+        k.counter = verification.authenticationInfo.newCounter;
+        k.backedUp = verification.authenticationInfo.credentialBackedUp;
+        k.lastUsedAt = Date.now();
+      });
+      if (p.purpose === 'signin') await signIn(user.id);
+      else session.set('authAt', Date.now());
+      return json({ verified: true, username: user.username });
+    }
+
+    case 'signout': {
+      session.destroy();
+      return json({ ok: true });
+    }
+  }
+  return json({ error: 'Not found' }, 404);
+};
+
+// ---- Management: list / rename / delete ----
+export const GET: APIRoute = async ({ params, session }) => {
+  if (params.action !== 'list') return json({ error: 'Not found' }, 404);
+  const id = await session?.get('userId');
+  const user = id ? await findUserById(id as string) : undefined;
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  const authAt = ((await session!.get('authAt')) as number) ?? 0;
+  return json({
+    username: user.username,
+    passkeys: user.passkeys.map(publicPasskey),
+    reauthRequired: Date.now() - authAt >= REAUTH_WINDOW_MS,
+  });
+};
+
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const id = await session?.get('userId');
+  const { name } = await request.json().catch(() => ({}));
+  const label = typeof name === 'string' ? name.trim().slice(0, 50) : '';
+  if (!id || !label) return json({ error: 'Invalid request' }, id ? 400 : 401);
+  const ok = await withStore((users) => {
+    const k = users.find((u) => u.id === id)?.passkeys.find((x) => x.id === params.action);
+    if (k) k.name = label;
+    return !!k;
+  });
+  return ok ? json({ ok: true }) : json({ error: 'Not found' }, 404);
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const id = await session?.get('userId');
+  if (!id) return json({ error: 'Not signed in' }, 401);
+  if (Date.now() - (((await session!.get('authAt')) as number) ?? 0) >= REAUTH_WINDOW_MS)
+    return json({ error: 'Reauthentication required', code: 'REAUTH_REQUIRED' }, 401);
+  const result = await withStore((users) => {
+    const user = users.find((u) => u.id === id);
+    if (!user?.passkeys.some((k) => k.id === params.action)) return 'missing' as const;
+    if (user.passkeys.length <= 1) return 'last' as const;
+    user.passkeys = user.passkeys.filter((k) => k.id !== params.action);
+    return 'ok' as const;
+  });
+  if (result === 'missing') return json({ error: 'Not found' }, 404);
+  if (result === 'last') return json({ error: "You can't remove your only passkey" }, 400);
+  return json({ ok: true });
+};
