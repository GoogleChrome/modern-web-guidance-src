+import { randomUUID } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+
+export const RP_NAME = 'The DevTools Times';
+/** How long a sign-in stays "fresh" for sensitive actions before reauthentication is required. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+export const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export interface StoredPasskey {
+  id: string; // base64url credential ID
+  publicKey: string; // base64url COSE public key
+  counter: number;
+  transports?: string[];
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  name: string;
+  createdAt: number;
+  lastUsedAt?: number;
+}
+
+export interface StoredUser {
+  id: string;
+  username: string;
+  createdAt: number;
+  passkeys: StoredPasskey[];
+}
+
+const FILE = path.join(process.cwd(), 'data', 'passkeys.json');
+
+let cache: StoredUser[] | null = null;
+let queue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<StoredUser[]> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await readFile(FILE, 'utf8')).users ?? [];
+  } catch {
+    cache = [];
+  }
+  return cache!;
+}
+
+/** Runs `fn` against the user list serially; persists afterwards if `fn` returns without throwing. */
+export function withStore<T>(fn: (users: StoredUser[]) => T | Promise<T>): Promise<T> {
+  const run = queue.then(async () => {
+    const users = await load();
+    const result = await fn(users);
+    await mkdir(path.dirname(FILE), { recursive: true });
+    const tmp = `${FILE}.${process.pid}.tmp`;
+    await writeFile(tmp, JSON.stringify({ users }, null, 2));
+    await rename(tmp, FILE);
+    return result;
+  });
+  queue = run.catch(() => {});
+  return run;
+}
+
+export async function readUsers(): Promise<StoredUser[]> {
+  await queue;
+  return load();
+}
+
+export const findUserById = async (id: string) => (await readUsers()).find((u) => u.id === id);
+export const findUserByUsername = async (username: string) =>
+  (await readUsers()).find((u) => u.username.toLowerCase() === username.toLowerCase());
+
+export function newUserId() {
+  return randomUUID();
+}
+
+export function normalizeUsername(raw: unknown): string | null {
+  if (typeof raw !== 'string') return null;
+  const name = raw.trim();
+  return /^[A-Za-z0-9._-]{3,32}$/.test(name) ? name : null;
+}
+
+export function publicPasskey(p: StoredPasskey) {
+  const { publicKey, counter, ...rest } = p;
+  return rest;
+}
+
+/** Relying party info derived from the request. Honors the proxy's forwarded host if present. */
+export function getRp(request: Request, url: URL) {
+  const host = request.headers.get('x-forwarded-host') ?? url.host;
+  const proto = request.headers.get('x-forwarded-proto') ?? url.protocol.replace(':', '');
+  return { rpID: host.split(':')[0], origin: `${proto}://${host}` };
+}
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
