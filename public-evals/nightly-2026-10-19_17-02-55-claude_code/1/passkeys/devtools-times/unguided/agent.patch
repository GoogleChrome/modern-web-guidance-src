+import {
+  browserSupportsWebAuthn,
+  startAuthentication,
+  startRegistration,
+} from '@simplewebauthn/browser';
+
+const api = `${import.meta.env.BASE_URL}api/passkeys`;
+
+export class ReauthRequired extends Error {}
+
+export const passkeysSupported = () => browserSupportsWebAuthn();
+
+async function call(path: string, method = 'POST', body?: unknown) {
+  const res = await fetch(`${api}/${path}`, {
+    method,
+    headers: { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) {
+    if (data.code === 'REAUTH_REQUIRED') throw new ReauthRequired(data.error);
+    throw new Error(data.error || 'Request failed');
+  }
+  return data;
+}
+
+/** Turns WebAuthn browser errors into something readable; returns null if the user just cancelled. */
+export function describeError(e: unknown): string | null {
+  const err = e as Error;
+  if (err.name === 'NotAllowedError' || err.name === 'AbortError') return null;
+  if (err.name === 'InvalidStateError') return 'This passkey is already registered on this device.';
+  return err.message || 'Something went wrong.';
+}
+
+/** Create a new account (signed out) or add a passkey (signed in). */
+export async function registerPasskey(opts: { username?: string; name?: string } = {}) {
+  const options = await call('register-options', 'POST', { username: opts.username });
+  const response = await startRegistration({ optionsJSON: options });
+  return call('register-verify', 'POST', { response, name: opts.name });
+}
+
+export async function signInWithPasskey() {
+  const options = await call('auth-options', 'POST', { mode: 'signin' });
+  const response = await startAuthentication({ optionsJSON: options });
+  return call('auth-verify', 'POST', { response });
+}
+
+export async function reauthenticate() {
+  const options = await call('auth-options', 'POST', { mode: 'reauth' });
+  const response = await startAuthentication({ optionsJSON: options });
+  return call('auth-verify', 'POST', { response });
+}
+
+export const listPasskeys = () => call('list', 'GET');
+export const renamePasskey = (id: string, name: string) => call(id, 'PATCH', { name });
+export const deletePasskey = (id: string) => call(id, 'DELETE');
+export const signOut = () => call('signout');
