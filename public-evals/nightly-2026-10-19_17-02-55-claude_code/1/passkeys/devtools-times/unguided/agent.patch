diff --git a/src/components/PasskeyAccount.tsx b/src/components/PasskeyAccount.tsx
new file mode 100644
index 0000000..7acbccd
--- /dev/null
+++ b/src/components/PasskeyAccount.tsx
@@ -0,0 +1,170 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import {
+  ReauthRequired,
+  deletePasskey,
+  describeError,
+  listPasskeys,
+  passkeysSupported,
+  reauthenticate,
+  registerPasskey,
+  renamePasskey,
+  signOut,
+} from '../utils/passkeyClient';
+
+interface Passkey {
+  id: string;
+  name: string;
+  createdAt: number;
+  lastUsedAt?: number;
+  deviceType: string;
+  backedUp: boolean;
+}
+
+const base = import.meta.env.BASE_URL;
+const fmt = (t: number) => new Date(t).toLocaleDateString('en-US', { dateStyle: 'medium' });
+const btn = 'py-2 px-3 rounded-md text-sm font-medium border border-gray-300 text-gray-800 hover:bg-gray-50';
+const primary = 'py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75';
+
+export default function PasskeyAccount() {
+  const [username, setUsername] = useState<string | null>(null);
+  const [passkeys, setPasskeys] = useState<Passkey[]>([]);
+  const [status, setStatus] = useState<'loading' | 'signedOut' | 'ready'>('loading');
+  const [error, setError] = useState<string | null>(null);
+  const [message, setMessage] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [editing, setEditing] = useState<string | null>(null);
+  const [draft, setDraft] = useState('');
+
+  const refresh = useCallback(async () => {
+    try {
+      const data = await listPasskeys();
+      setUsername(data.username);
+      setPasskeys(data.passkeys);
+      setStatus('ready');
+    } catch {
+      setStatus('signedOut');
+    }
+  }, []);
+
+  useEffect(() => {
+    refresh();
+  }, [refresh]);
+
+  /** Runs a sensitive action, prompting for a passkey reauthentication and retrying once if needed. */
+  const run = async (action: () => Promise<unknown>, done: string) => {
+    setError(null);
+    setMessage(null);
+    setBusy(true);
+    try {
+      try {
+        await action();
+      } catch (e) {
+        if (!(e instanceof ReauthRequired)) throw e;
+        setMessage('Please confirm it’s you with your passkey to continue.');
+        await reauthenticate();
+        await action();
+      }
+      setMessage(done);
+      await refresh();
+    } catch (e) {
+      setMessage(null);
+      setError(describeError(e));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  if (status === 'loading') return <p className="text-center mt-10 text-gray-600">Loading…</p>;
+  if (status === 'signedOut')
+    return (
+      <div className="max-w-md mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm text-center">
+        <p className="mb-4 text-gray-800">You’re not signed in.</p>
+        <a href={`${base}signin`} className={primary + ' inline-block'}>Sign in</a>
+      </div>
+    );
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <div className="flex justify-between items-center mb-6">
+        <div>
+          <h2 className="text-2xl font-bold text-gray-800">Your account</h2>
+          <p className="text-sm text-gray-600">Signed in as {username}</p>
+        </div>
+        <button
+          className={btn}
+          onClick={async () => {
+            await signOut();
+            window.location.href = `${base}signin`;
+          }}
+        >
+          Sign out
+        </button>
+      </div>
+
+      {error && <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">{error}</div>}
+      {message && <div className="mb-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">{message}</div>}
+
+      <h3 className="font-semibold text-gray-800 mb-2">Passkeys</h3>
+      <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md mb-4">
+        {passkeys.map((p) => (
+          <li key={p.id} className="p-3 flex items-center justify-between gap-3">
+            <div className="min-w-0">
+              {editing === p.id ? (
+                <form
+                  className="flex gap-2"
+                  onSubmit={async (e) => {
+                    e.preventDefault();
+                    await run(() => renamePasskey(p.id, draft), 'Passkey renamed.');
+                    setEditing(null);
+                  }}
+                >
+                  <input
+                    autoFocus
+                    aria-label="Passkey name"
+                    value={draft}
+                    maxLength={50}
+                    onChange={(e) => setDraft(e.target.value)}
+                    className="px-2 py-1 border border-gray-300 rounded-md text-sm"
+                  />
+                  <button className={btn} type="submit" disabled={busy || !draft.trim()}>Save</button>
+                  <button className={btn} type="button" onClick={() => setEditing(null)}>Cancel</button>
+                </form>
+              ) : (
+                <p className="font-medium text-gray-800 truncate">{p.name}</p>
+              )}
+              <p className="text-xs text-gray-500">
+                Added {fmt(p.createdAt)} · {p.lastUsedAt ? `Last used ${fmt(p.lastUsedAt)}` : 'Never used'}
+                {p.backedUp ? ' · Synced' : ''}
+              </p>
+            </div>
+            {editing !== p.id && (
+              <div className="flex gap-2 shrink-0">
+                <button className={btn} disabled={busy} onClick={() => { setEditing(p.id); setDraft(p.name); }}>
+                  Rename
+                </button>
+                <button
+                  className={btn}
+                  disabled={busy || passkeys.length <= 1}
+                  title={passkeys.length <= 1 ? 'You can’t remove your only passkey' : undefined}
+                  onClick={() => {
+                    if (confirm(`Remove passkey “${p.name}”?`)) run(() => deletePasskey(p.id), 'Passkey removed.');
+                  }}
+                >
+                  Remove
+                </button>
+              </div>
+            )}
+          </li>
+        ))}
+      </ul>
+
+      {passkeysSupported() ? (
+        <button className={primary} disabled={busy} onClick={() => run(() => registerPasskey(), 'Passkey added.')}>
+          Add a passkey
+        </button>
+      ) : (
+        <p className="text-sm text-gray-600">This browser doesn’t support passkeys.</p>
+      )}
+    </div>
+  );
+}
