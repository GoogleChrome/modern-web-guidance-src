--- /dev/null
+++ b/src/pages/api/passkeys/reauth/verify.ts
@@ -0,0 +1,49 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { getRelyingParty } from '../../../../lib/passkeys/config';
+import { findCredentialById, saveCredential } from '../../../../lib/passkeys/store';
+import { getSessionUser, json } from '../../../../lib/passkeys/session';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user || !session) return json({ error: 'Not signed in' }, 401);
+  const state = await session.get('passkeyChallenge');
+  session.delete('passkeyChallenge');
+  if (state?.type !== 'reauth') return json({ error: 'No reauthentication in progress' }, 400);
+
+  const response = await request.json().catch(() => null);
+  if (!response?.id) return json({ error: 'Invalid request' }, 400);
+
+  const stored = await findCredentialById(response.id);
+  // A valid passkey that belongs to someone else must be rejected.
+  if (!stored || stored.passkeyUserId !== user.id) return json({ error: 'Credential not found' }, 404);
+
+  const { rpID, origins } = getRelyingParty(url);
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: state.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      credential: {
+        id: stored.id,
+        publicKey: Buffer.from(stored.credentialPublicKey, 'base64url'),
+        counter: stored.counter,
+        transports: stored.transports as any,
+      },
+      requireUserVerification: state.userVerification === 'required',
+    });
+  } catch (e) {
+    return json({ error: (e as Error).message }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Verification failed' }, 400);
+
+  await saveCredential({
+    ...stored,
+    counter: verification.authenticationInfo.newCounter,
+    lastUsedAt: Date.now(),
+  });
+  await session.set('reauthAt', Date.now());
+  return json({ verified: true });
+};
diff --git a/src/pages/api/passkeys/register/options.ts b/src/pages/api/passkeys/register/options.ts
new file mode 100644
index 0000000..c7d30e4
--- /dev/null
+++ b/src/pages/api/passkeys/register/options.ts
@@ -0,0 +1,56 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { randomBytes } from 'node:crypto';
+import { RP_NAME, getRelyingParty } from '../../../../lib/passkeys/config';
+import { findCredentialsByUserId, findUserByUsername } from '../../../../lib/passkeys/store';
+import { getSessionUser, json } from '../../../../lib/passkeys/session';
+
+const USERNAME_RE = /^[A-Za-z0-9_.-]{3,32}$/;
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) return json({ error: 'Sessions unavailable' }, 500);
+  const body = await request.json().catch(() => ({}));
+  const promotion = body.promotion === true;
+  const conditional = body.conditional === true;
+
+  let user = await getSessionUser(session);
+  let pendingUser: { id: string; username: string } | undefined;
+  if (!user) {
+    // Passkey sign-up: the account is only created once the credential verifies.
+    const username = typeof body.username === 'string' ? body.username.trim() : '';
+    if (!USERNAME_RE.test(username)) {
+      return json({ error: 'Username must be 3-32 characters: letters, numbers, ., _ or -' }, 400);
+    }
+    if (await findUserByUsername(username)) return json({ error: 'Username already taken' }, 409);
+    pendingUser = { id: randomBytes(32).toString('base64url'), username };
+  }
+
+  const existing = user ? await findCredentialsByUserId(user.id) : [];
+  const { rpID } = getRelyingParty(url);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userName: user?.username ?? pendingUser!.username,
+    userDisplayName: user?.displayName ?? pendingUser!.username,
+    userID: Buffer.from(user?.id ?? pendingUser!.id, 'base64url'),
+    attestationType: 'none',
+    supportedAlgorithmIDs: [-7, -257],
+    excludeCredentials: existing.map((c) => ({ id: c.id, transports: c.transports as any })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      // Promotion flows target the platform authenticator; the management page also allows security keys.
+      ...((promotion || conditional || pendingUser) && { authenticatorAttachment: 'platform' }),
+    },
+  });
+
+  await session.set('passkeyChallenge', {
+    type: 'register',
+    challenge: options.challenge,
+    userVerification: 'preferred',
+    conditional,
+    pendingUser,
+  });
+  return json({ ...options, rp: { ...options.rp, id: rpID } });
+};
diff --git a/src/pages/api/passkeys/register/verify.ts b/src/pages/api/passkeys/register/verify.ts
new file mode 100644
index 0000000..7615ca7
--- /dev/null
+++ b/src/pages/api/passkeys/register/verify.ts
@@ -0,0 +1,72 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { getRelyingParty } from '../../../../lib/passkeys/config';
+import { NULL_AAGUID, providerName } from '../../../../lib/passkeys/aaguid';
+import {
+  createUser,
+  findCredentialById,
+  findUserById,
+  saveCredential,
+} from '../../../../lib/passkeys/store';
+import { getSessionUser, json, signIn } from '../../../../lib/passkeys/session';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) return json({ error: 'Sessions unavailable' }, 500);
+  const state = await session.get('passkeyChallenge');
+  session.delete('passkeyChallenge'); // one-time use
+  if (state?.type !== 'register') return json({ error: 'No registration in progress' }, 400);
+
+  const response = await request.json().catch(() => null);
+  if (!response?.id) return json({ error: 'Invalid request' }, 400);
+
+  const sessionUser = await getSessionUser(session);
+  const { rpID, origins } = getRelyingParty(url);
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: state.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      // Conditional create may complete without a user presence check.
+      requireUserPresence: !state.conditional,
+      // Options asked for "preferred", so authenticators without UV must be accepted.
+      requireUserVerification: state.userVerification === 'required',
+    });
+  } catch (e) {
+    return json({ error: (e as Error).message }, 400);
+  }
+  if (!verification.verified || !verification.registrationInfo) {
+    return json({ error: 'Verification failed' }, 400);
+  }
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  if (await findCredentialById(credential.id)) return json({ error: 'Credential already registered' }, 409);
+
+  let user = sessionUser;
+  if (!user) {
+    if (!state.pendingUser) return json({ error: 'Not signed in' }, 401);
+    user = (await createUser(state.pendingUser.username, false, state.pendingUser.id)) ?? undefined;
+    if (!user) return json({ error: 'Username already taken' }, 409);
+  } else if (state.pendingUser) {
+    return json({ error: 'Invalid state' }, 400);
+  }
+
+  await saveCredential({
+    id: credential.id,
+    passkeyUserId: user.id,
+    credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    credentialType: 'public-key',
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    name: aaguid === NULL_AAGUID ? 'Passkey' : providerName(aaguid),
+    transports: credential.transports ?? [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  });
+
+  if (!sessionUser) await signIn(session, user);
+  return json({ verified: true, id: credential.id });
+};
