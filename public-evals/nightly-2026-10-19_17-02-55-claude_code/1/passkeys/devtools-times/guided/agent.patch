+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRelyingParty } from '../../../../lib/passkeys/config';
+import { json } from '../../../../lib/passkeys/session';
+
+export const POST: APIRoute = async ({ session, url }) => {
+  if (!session) return json({ error: 'Sessions unavailable' }, 500);
+  const { rpID } = getRelyingParty(url);
+  const options = await generateAuthenticationOptions({
+    rpID,
+    allowCredentials: [], // discoverable credentials
+    userVerification: 'preferred',
+  });
+  await session.set('passkeyChallenge', {
+    type: 'authenticate',
+    challenge: options.challenge,
+    userVerification: 'preferred',
+  });
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/authenticate/verify.ts b/src/pages/api/passkeys/authenticate/verify.ts
new file mode 100644
index 0000000..21a2bb9
--- /dev/null
+++ b/src/pages/api/passkeys/authenticate/verify.ts
@@ -0,0 +1,50 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { getRelyingParty } from '../../../../lib/passkeys/config';
+import { findCredentialById, findUserById, saveCredential } from '../../../../lib/passkeys/store';
+import { json, signIn } from '../../../../lib/passkeys/session';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) return json({ error: 'Sessions unavailable' }, 500);
+  const state = await session.get('passkeyChallenge');
+  session.delete('passkeyChallenge');
+  if (state?.type !== 'authenticate') return json({ error: 'No authentication in progress' }, 400);
+
+  const response = await request.json().catch(() => null);
+  if (!response?.id) return json({ error: 'Invalid request' }, 400);
+
+  const stored = await findCredentialById(response.id);
+  if (!stored) return json({ error: 'Credential not found' }, 404);
+  const user = await findUserById(stored.passkeyUserId);
+  if (!user) return json({ error: 'Credential not found' }, 404);
+
+  const { rpID, origins } = getRelyingParty(url);
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: state.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      credential: {
+        id: stored.id,
+        publicKey: Buffer.from(stored.credentialPublicKey, 'base64url'),
+        counter: stored.counter,
+        transports: stored.transports as any,
+      },
+      requireUserVerification: state.userVerification === 'required',
+    });
+  } catch (e) {
+    return json({ error: (e as Error).message }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Verification failed' }, 400);
+
+  await saveCredential({
+    ...stored,
+    counter: verification.authenticationInfo.newCounter,
+    credentialBackedUp: verification.authenticationInfo.credentialBackedUp,
+    lastUsedAt: Date.now(),
+  });
+  await signIn(session, user);
+  return json({ verified: true, user: { username: user.username } });
+};
diff --git a/src/pages/api/passkeys/credentials/[id].ts b/src/pages/api/passkeys/credentials/[id].ts
new file mode 100644
index 0000000..baaa7f3
--- /dev/null
+++ b/src/pages/api/passkeys/credentials/[id].ts
@@ -0,0 +1,38 @@
+import type { APIRoute } from 'astro';
+import {
+  deleteCredential,
+  findCredentialById,
+  findCredentialsByUserId,
+  saveCredential,
+} from '../../../../lib/passkeys/store';
+import { getSessionUser, hasRecentReauth, json } from '../../../../lib/passkeys/session';
+import { toPublic } from './_public';
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  const cred = await findCredentialById(params.id!);
+  if (!cred || cred.passkeyUserId !== user.id) return json({ error: 'Credential not found' }, 404);
+
+  const { name } = await request.json().catch(() => ({}));
+  if (typeof name !== 'string' || !name.trim()) return json({ error: 'Name is required' }, 400);
+  cred.name = name.trim().slice(0, 64);
+  await saveCredential(cred);
+  return json(toPublic(cred));
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  const cred = await findCredentialById(params.id!);
+  if (!cred || cred.passkeyUserId !== user.id) return json({ error: 'Credential not found' }, 404);
+
+  // Sensitive action: require a recent sign-in or passkey reauthentication.
+  if (!(await hasRecentReauth(session))) return json({ error: 'Reauthentication required' }, 403);
+
+  if (!user.hasPassword && (await findCredentialsByUserId(user.id)).length <= 1) {
+    return json({ error: 'You cannot remove the only way to sign in to this account' }, 409);
+  }
+  await deleteCredential(cred.id);
+  return json({ success: true });
+};
