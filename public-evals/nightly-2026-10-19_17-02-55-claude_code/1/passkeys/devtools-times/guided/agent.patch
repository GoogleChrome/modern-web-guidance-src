+// Small subset of https://github.com/passkeydeveloper/passkey-authenticator-aaguids.
+// Used for UX hints only, never for security decisions.
+const PROVIDERS: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  'fdb141b2-5d84-443e-8a35-4698c205a502': 'KeePassXC',
+};
+
+export const NULL_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+export function providerName(aaguid: string): string {
+  if (aaguid === NULL_AAGUID) return 'Passkey';
+  return PROVIDERS[aaguid] ?? 'Unknown passkey provider';
+}
diff --git a/src/lib/passkeys/client.ts b/src/lib/passkeys/client.ts
new file mode 100644
index 0000000..a4909cd
--- /dev/null
+++ b/src/lib/passkeys/client.ts
@@ -0,0 +1,149 @@
+// Browser-side passkey helpers built on the native WebAuthn APIs.
+import 'webauthn-polyfills';
+
+const base = import.meta.env.BASE_URL;
+export const apiUrl = (path: string) => `${base}api/${path}`.replace(/\/{2,}/g, '/');
+
+export async function post(path: string, body?: unknown) {
+  return fetch(apiUrl(path), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body ?? {}),
+  });
+}
+
+export async function passkeysSupported() {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return false;
+  const caps = await PublicKeyCredential.getClientCapabilities();
+  return caps.passkeyPlatformAuthenticator === true || caps.conditionalGet === true;
+}
+
+export async function conditionalGetSupported() {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return false;
+  return (await PublicKeyCredential.getClientCapabilities()).conditionalGet === true;
+}
+
+export async function conditionalCreateSupported() {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return false;
+  return (await PublicKeyCredential.getClientCapabilities()).conditionalCreate === true;
+}
+
+async function signalUnknown(rpId: string, credentialId: string) {
+  if (!PublicKeyCredential.signalUnknownCredential) return;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+  } catch (e) {
+    console.error('signalUnknownCredential failed:', e);
+  }
+}
+
+export type PasskeyResult =
+  | { status: 'ok' }
+  | { status: 'cancelled' }
+  | { status: 'error'; message: string };
+
+const errorMessage = async (res: Response) => (await res.json().catch(() => ({}))).error || 'Request failed';
+
+function describeDomError(err: unknown): PasskeyResult {
+  const name = (err as Error)?.name;
+  if (name === 'NotAllowedError' || name === 'AbortError') return { status: 'cancelled' };
+  if (name === 'InvalidStateError') {
+    return { status: 'error', message: 'A passkey from this provider already exists for this account.' };
+  }
+  if (name === 'SecurityError') {
+    return { status: 'error', message: 'Passkeys are unavailable on this origin (HTTPS or RP ID mismatch).' };
+  }
+  return { status: 'error', message: 'Something went wrong with the passkey prompt.' };
+}
+
+export interface RegisterOptions {
+  username?: string; // set for passkey-only sign-up
+  promotion?: boolean; // platform authenticator only
+  conditional?: boolean; // silent post-password-login creation
+}
+
+export async function registerPasskey(opts: RegisterOptions = {}): Promise<PasskeyResult> {
+  const optionsRes = await post('passkeys/register/options', opts);
+  if (!optionsRes.ok) return { status: 'error', message: await errorMessage(optionsRes) };
+  const optionsJSON = await optionsRes.json();
+  const rpId: string = optionsJSON.rp.id;
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+  let credential: Credential | null;
+  try {
+    credential = await navigator.credentials.create({
+      publicKey,
+      ...(opts.conditional && { mediation: 'conditional' as CredentialMediationRequirement }),
+    });
+  } catch (err) {
+    return describeDomError(err);
+  }
+  if (!credential) return { status: 'cancelled' };
+
+  const encoded = (credential as PublicKeyCredential).toJSON();
+  try {
+    const res = await post('passkeys/register/verify', encoded);
+    if (!res.ok) {
+      await signalUnknown(rpId, encoded.id); // don't leave an orphaned credential in the provider
+      return { status: 'error', message: await errorMessage(res) };
+    }
+  } catch {
+    await signalUnknown(rpId, encoded.id);
+    return { status: 'error', message: 'Network error while saving your passkey.' };
+  }
+  return { status: 'ok' };
+}
+
+async function authenticate(
+  kind: 'authenticate' | 'reauth',
+  extra: { mediation?: CredentialMediationRequirement; signal?: AbortSignal } = {},
+): Promise<PasskeyResult> {
+  const optionsRes = await post(`passkeys/${kind}/options`);
+  if (!optionsRes.ok) return { status: 'error', message: await errorMessage(optionsRes) };
+  const optionsJSON = await optionsRes.json();
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+  let credential: Credential | null;
+  try {
+    credential = await navigator.credentials.get({ publicKey, ...extra });
+  } catch (err) {
+    return describeDomError(err);
+  }
+  if (!credential) return { status: 'cancelled' };
+
+  const encoded = (credential as PublicKeyCredential).toJSON();
+  try {
+    const res = await post(`passkeys/${kind}/verify`, encoded);
+    if (res.status === 404) {
+      await signalUnknown(optionsJSON.rpId, encoded.id);
+      return { status: 'error', message: 'That passkey is no longer recognised and was removed from your device.' };
+    }
+    if (!res.ok) return { status: 'error', message: await errorMessage(res) };
+  } catch {
+    return { status: 'error', message: 'Network error while verifying your passkey.' };
+  }
+  return { status: 'ok' };
+}
+
+let autofillAbort = new AbortController();
+
+/** Abort any pending conditional-get so an explicit prompt doesn't collide with it. */
+export function abortAutofill() {
+  autofillAbort.abort();
+  autofillAbort = new AbortController();
+}
+
+export const signInWithPasskey = () => {
+  abortAutofill();
+  return authenticate('authenticate');
+};
+
+/** Starts passkey autofill on inputs annotated with autocomplete="... webauthn". */
+export const startAutofill = () =>
+  authenticate('authenticate', { mediation: 'conditional', signal: autofillAbort.signal });
+
+/** Verify the signed-in user with one of their own passkeys before a sensitive action. */
+export const reauthenticateWithPasskey = () => {
+  abortAutofill();
+  return authenticate('reauth');
+};
