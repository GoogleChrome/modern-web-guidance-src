diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..500d559
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,290 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import {
+  apiUrl,
+  passkeysSupported,
+  post,
+  reauthenticateWithPasskey,
+  registerPasskey,
+} from '../lib/passkeys/client';
+
+interface Passkey {
+  id: string;
+  name: string;
+  aaguid: string;
+  providerIcon?: string;
+  credentialDeviceType: string;
+  credentialBackedUp: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+interface Account {
+  rpId: string;
+  user: { id: string; username: string; displayName: string; hasPassword: boolean };
+  credentials: Passkey[];
+}
+
+const fmt = (t?: number) =>
+  t ? new Date(t).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'Never';
+
+const button =
+  'py-1.5 px-3 rounded-md text-sm font-medium border border-gray-300 bg-white text-gray-900 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 disabled:opacity-60';
+
+// Keep password managers in sync with the server's view of this account.
+async function signalAccepted(account: Account) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: account.rpId,
+      userId: account.user.id,
+      allAcceptedCredentialIds: account.credentials.map((c) => c.id),
+    });
+  } catch (e) {
+    console.error('signalAllAcceptedCredentials failed:', e);
+  }
+}
+
+export default function PasskeyManager() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [supported, setSupported] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [editing, setEditing] = useState<{ id: string; name: string } | null>(null);
+  const [displayName, setDisplayName] = useState('');
+
+  const load = useCallback(async () => {
+    const res = await fetch(apiUrl('passkeys/credentials'));
+    if (res.status === 401) {
+      window.location.assign(`${import.meta.env.BASE_URL}signin`);
+      return null;
+    }
+    const data: Account = await res.json();
+    setAccount(data);
+    setDisplayName(data.user.displayName);
+    return data;
+  }, []);
+
+  useEffect(() => {
+    passkeysSupported().then(setSupported);
+    load().then((data) => data && signalAccepted(data));
+  }, [load]);
+
+  const run = async (fn: () => Promise<void>) => {
+    setError(null);
+    setNotice(null);
+    setBusy(true);
+    try {
+      await fn();
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const create = () =>
+    run(async () => {
+      // No authenticatorAttachment: security keys are allowed from this page.
+      const result = await registerPasskey({});
+      if (result.status === 'error') return setError(result.message);
+      if (result.status === 'ok') {
+        setNotice('Passkey created.');
+        const data = await load();
+        if (data) await signalAccepted(data);
+      }
+    });
+
+  const rename = (id: string, name: string) =>
+    run(async () => {
+      const res = await fetch(apiUrl(`passkeys/credentials/${encodeURIComponent(id)}`), {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name }),
+      });
+      if (!res.ok) return setError((await res.json()).error);
+      setEditing(null);
+      await load(); // a nickname is server-only; no Signal API call
+    });
+
+  const remove = (id: string) =>
+    run(async () => {
+      const del = () => fetch(apiUrl(`passkeys/credentials/${encodeURIComponent(id)}`), { method: 'DELETE' });
+      let res = await del();
+      if (res.status === 403) {
+        // Sensitive action: reauthenticate with a passkey, then retry.
+        const reauth = await reauthenticateWithPasskey();
+        if (reauth.status === 'cancelled') return;
+        if (reauth.status === 'error') return setError(reauth.message);
+        res = await del();
+      }
+      if (!res.ok) return setError((await res.json()).error);
+      setNotice('Passkey deleted.');
+      const data = await load();
+      if (data) await signalAccepted(data);
+    });
+
+  const saveProfile = (e: React.FormEvent) => {
+    e.preventDefault();
+    return run(async () => {
+      const res = await fetch(apiUrl('passkeys/credentials'), {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ displayName }),
+      });
+      if (!res.ok) return setError((await res.json()).error);
+      const user = await res.json();
+      if (window.PublicKeyCredential?.signalCurrentUserDetails && account) {
+        try {
+          await PublicKeyCredential.signalCurrentUserDetails({
+            rpId: account.rpId,
+            userId: user.id,
+            name: user.username,
+            displayName: user.displayName,
+          });
+        } catch (err) {
+          console.error('signalCurrentUserDetails failed:', err);
+        }
+      }
+      setNotice('Account details updated.');
+      await load();
+    });
+  };
+
+  const signOut = async () => {
+    await post('auth/logout');
+    window.location.assign(import.meta.env.BASE_URL);
+  };
+
+  if (!account) return <p className="text-center text-gray-500 mt-10">Loading…</p>;
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-8">
+      <div className="flex items-center justify-between">
+        <h1 className="text-2xl font-bold text-gray-800">Account &amp; passkeys</h1>
+        <button type="button" className={button} onClick={signOut}>
+          Sign out
+        </button>
+      </div>
+
+      <div aria-live="polite">
+        {error && (
+          <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+        {notice && <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg">{notice}</div>}
+      </div>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 className="text-lg font-semibold mb-4">Profile</h2>
+        <form onSubmit={saveProfile} className="flex flex-wrap items-end gap-3">
+          <div className="flex-1 min-w-48">
+            <label htmlFor="displayName" className="block text-sm font-medium text-gray-700 mb-1">
+              Display name <span className="text-gray-500">(signed in as {account.user.username})</span>
+            </label>
+            <input
+              id="displayName"
+              value={displayName}
+              onChange={(e) => setDisplayName(e.target.value)}
+              maxLength={64}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+          </div>
+          <button type="submit" disabled={busy} className={button}>
+            Save
+          </button>
+        </form>
+      </section>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex items-center justify-between mb-4">
+          <h2 className="text-lg font-semibold">Passkeys</h2>
+          {supported && (
+            <button type="button" onClick={create} disabled={busy} className={button}>
+              Create a passkey
+            </button>
+          )}
+        </div>
+        {!supported && (
+          <p className="text-sm text-gray-600 mb-4">
+            This browser or device doesn’t support passkeys. You can keep signing in with your password.
+          </p>
+        )}
+
+        {account.credentials.length === 0 ? (
+          <p className="text-sm text-gray-600">No passkeys found.</p>
+        ) : (
+          <ul className="divide-y divide-gray-200">
+            {account.credentials.map((c) => (
+              <li key={c.id} className="py-4 flex flex-wrap items-center gap-3">
+                {c.providerIcon ? (
+                  <img src={c.providerIcon} alt="" className="w-8 h-8" />
+                ) : (
+                  <span
+                    aria-hidden="true"
+                    className="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500"
+                  >
+                    🔑
+                  </span>
+                )}
+                <div className="flex-1 min-w-40">
+                  {editing?.id === c.id ? (
+                    <form
+                      onSubmit={(e) => {
+                        e.preventDefault();
+                        rename(c.id, editing.name);
+                      }}
+                      className="flex gap-2"
+                    >
+                      <input
+                        aria-label="Passkey name"
+                        value={editing.name}
+                        onChange={(e) => setEditing({ id: c.id, name: e.target.value })}
+                        maxLength={64}
+                        required
+                        autoFocus
+                        className="px-2 py-1 border border-gray-300 rounded-md text-sm"
+                      />
+                      <button type="submit" disabled={busy} className={button}>
+                        Save
+                      </button>
+                      <button type="button" className={button} onClick={() => setEditing(null)}>
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <p className="font-medium text-gray-900">{c.name}</p>
+                  )}
+                  <p className="text-xs text-gray-500">
+                    Created {fmt(c.registeredAt)} · Last used {fmt(c.lastUsedAt)}
+                    {c.credentialBackedUp ? ' · Synced' : ''}
+                  </p>
+                </div>
+                {editing?.id !== c.id && (
+                  <div className="flex gap-2">
+                    <button type="button" className={button} onClick={() => setEditing({ id: c.id, name: c.name })}>
+                      Rename
+                    </button>
+                    <button
+                      type="button"
+                      className={button}
+                      disabled={busy}
+                      onClick={() => {
+                        if (confirm(`Delete the passkey “${c.name}”? You can’t undo this.`)) remove(c.id);
+                      }}
+                    >
+                      Delete
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+        <p className="text-xs text-gray-500 mt-4">
+          Deleting a passkey asks you to confirm with one of your passkeys if you signed in a while ago.
+        </p>
+      </section>
+    </div>
+  );
+}
