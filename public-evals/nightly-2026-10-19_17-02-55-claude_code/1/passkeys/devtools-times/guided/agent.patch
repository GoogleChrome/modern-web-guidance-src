@@ -0,0 +1,32 @@
+import type { APIRoute } from 'astro';
+import { findCredentialsByUserId, updateUser } from '../../../../lib/passkeys/store';
+import { getSessionUser, json } from '../../../../lib/passkeys/session';
+import { getRelyingParty } from '../../../../lib/passkeys/config';
+import { toPublic } from './_public';
+
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  const creds = await findCredentialsByUserId(user.id);
+  return json({
+    rpId: getRelyingParty(url).rpID,
+    user: {
+      id: user.id,
+      username: user.username,
+      displayName: user.displayName,
+      hasPassword: user.hasPassword,
+    },
+    credentials: creds.map(toPublic),
+  });
+};
+
+export const PUT: APIRoute = async ({ request, session }) => {
+  // Update account name / displayName
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  const body = await request.json().catch(() => ({}));
+  const displayName = typeof body.displayName === 'string' ? body.displayName.trim().slice(0, 64) : '';
+  if (!displayName) return json({ error: 'Display name is required' }, 400);
+  const updated = await updateUser(user.id, { displayName });
+  return json({ id: updated!.id, username: updated!.username, displayName: updated!.displayName });
+};
