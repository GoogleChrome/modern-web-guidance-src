+import type { APIRoute } from 'astro';
+import { upsertPasswordUser } from '../../../lib/passkeys/store';
+import { json, signIn } from '../../../lib/passkeys/session';
+
+const REMOTE = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return json({ error: 'Sessions unavailable' }, 500);
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+
+  const remote = await fetch(`${REMOTE}/login`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await remote.json().catch(() => ({}));
+  if (!remote.ok) return json({ error: data.error || 'Unknown error' }, remote.status);
+
+  try {
+    const user = await upsertPasswordUser(username);
+    await signIn(session, user);
+    return json({ user: { username: user.username } });
+  } catch {
+    return json({ error: 'This username belongs to a passkey-only account' }, 409);
+  }
+};
