new file mode 100644
index 0000000..b3f6885
--- /dev/null
+++ b/src/lib/passkeys/store.ts
@@ -0,0 +1,128 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+export interface StoredUser {
+  id: string; // Base64URL-encoded random user handle
+  username: string;
+  displayName: string;
+  hasPassword: boolean; // true when the user can also sign in through the password service
+}
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL credential ID
+  passkeyUserId: string;
+  credentialPublicKey: string; // Base64URL
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: string;
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+interface Data {
+  users: StoredUser[];
+  credentials: StoredPasskeyCredential[];
+}
+
+const FILE = path.join(process.cwd(), '.data', 'passkeys.json');
+
+// Serialize all read-modify-write cycles so concurrent requests don't clobber each other.
+let queue: Promise<unknown> = Promise.resolve();
+
+async function read(): Promise<Data> {
+  try {
+    return JSON.parse(await fs.readFile(FILE, 'utf8'));
+  } catch {
+    return { users: [], credentials: [] };
+  }
+}
+
+function update<T>(fn: (data: Data) => T | Promise<T>): Promise<T> {
+  const run = queue.then(async () => {
+    const data = await read();
+    const result = await fn(data);
+    await fs.mkdir(path.dirname(FILE), { recursive: true });
+    await fs.writeFile(FILE, JSON.stringify(data, null, 2));
+    return result;
+  });
+  queue = run.catch(() => {});
+  return run;
+}
+
+export const findUserById = async (id: string) => (await read()).users.find((u) => u.id === id);
+export const findUserByUsername = async (username: string) =>
+  (await read()).users.find((u) => u.username.toLowerCase() === username.toLowerCase());
+export const findCredentialById = async (id: string) =>
+  (await read()).credentials.find((c) => c.id === id);
+export const findCredentialsByUserId = async (userId: string) =>
+  (await read()).credentials.filter((c) => c.passkeyUserId === userId);
+
+/** Returns null when the username is already taken. */
+export function createUser(username: string, hasPassword: boolean, id?: string): Promise<StoredUser | null> {
+  return update((data) => {
+    if (data.users.some((u) => u.username.toLowerCase() === username.toLowerCase())) return null;
+    const user: StoredUser = {
+      id: id ?? randomBytes(32).toString('base64url'),
+      username,
+      displayName: username,
+      hasPassword,
+    };
+    data.users.push(user);
+    return user;
+  });
+}
+
+/** Finds or creates the local record for a user authenticated by the password service. */
+export function upsertPasswordUser(username: string): Promise<StoredUser> {
+  return update((data) => {
+    let user = data.users.find((u) => u.username.toLowerCase() === username.toLowerCase());
+    if (!user) {
+      user = {
+        id: randomBytes(32).toString('base64url'),
+        username,
+        displayName: username,
+        hasPassword: true,
+      };
+      data.users.push(user);
+    } else if (!user.hasPassword) {
+      // Can't happen for a passkey-only name unless the remote service registered it later; don't merge accounts.
+      throw new Error('USERNAME_IS_PASSKEY_ONLY');
+    }
+    return user;
+  });
+}
+
+/** Returns null when the new username is taken. */
+export function updateUser(id: string, patch: { username?: string; displayName?: string }) {
+  return update((data) => {
+    const user = data.users.find((u) => u.id === id);
+    if (!user) return null;
+    if (
+      patch.username &&
+      data.users.some((u) => u.id !== id && u.username.toLowerCase() === patch.username!.toLowerCase())
+    ) {
+      return null;
+    }
+    if (patch.username) user.username = patch.username;
+    if (patch.displayName) user.displayName = patch.displayName;
+    return user;
+  });
+}
+
+export const saveCredential = (cred: StoredPasskeyCredential) =>
+  update((data) => {
+    const i = data.credentials.findIndex((c) => c.id === cred.id);
+    if (i >= 0) data.credentials[i] = cred;
+    else data.credentials.push(cred);
+  });
+
+export const deleteCredential = (id: string) =>
+  update((data) => {
+    data.credentials = data.credentials.filter((c) => c.id !== id);
+  });
