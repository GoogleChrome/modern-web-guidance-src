+import type { APIRoute } from 'astro';
+import { json } from '../../../lib/passkeys/session';
+import { findUserByUsername } from '../../../lib/passkeys/store';
+
+const REMOTE = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export const POST: APIRoute = async ({ request }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string') {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+  if (await findUserByUsername(username)) return json({ error: 'Username already taken' }, 409);
+
+  const remote = await fetch(`${REMOTE}/register`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await remote.json().catch(() => ({}));
+  if (!remote.ok) return json({ error: data.error || 'Unknown error' }, remote.status);
+  return json({ ok: true });
+};
