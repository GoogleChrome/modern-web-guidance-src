@@ -0,0 +1,14 @@
+// RP ID and origins. Set PASSKEY_RP_ID and PASSKEY_ORIGINS (comma-separated) in production.
+// Without them, the RP ID and origin are derived from the request URL (fine for localhost).
+export const RP_NAME = 'The DevTools Times';
+
+export function getRelyingParty(url: URL) {
+  const rpID = process.env.PASSKEY_RP_ID || url.hostname;
+  const origins = process.env.PASSKEY_ORIGINS
+    ? process.env.PASSKEY_ORIGINS.split(',').map((o) => o.trim())
+    : [url.origin];
+  return { rpID, origins };
+}
+
+// How long a successful passkey reauthentication stays valid for sensitive actions.
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
diff --git a/src/lib/passkeys/session.ts b/src/lib/passkeys/session.ts
new file mode 100644
index 0000000..10624f8
--- /dev/null
+++ b/src/lib/passkeys/session.ts
@@ -0,0 +1,23 @@
+import type { AstroSession } from 'astro';
+import { findUserById, type StoredUser } from './store';
+import { REAUTH_WINDOW_MS } from './config';
+
+export async function getSessionUser(session: AstroSession | undefined): Promise<StoredUser | undefined> {
+  const userId = await session?.get('userId');
+  return userId ? findUserById(userId) : undefined;
+}
+
+export async function signIn(session: AstroSession, user: StoredUser) {
+  // Rotate the session ID on privilege change to prevent fixation.
+  await session.regenerate();
+  await session.set('userId', user.id);
+  await session.set('reauthAt', Date.now());
+}
+
+export async function hasRecentReauth(session: AstroSession | undefined) {
+  const at = await session?.get('reauthAt');
+  return typeof at === 'number' && Date.now() - at < REAUTH_WINDOW_MS;
+}
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
