@@ -0,0 +1,14 @@
+import type { StoredPasskeyCredential } from '../../../../lib/passkeys/store';
+
+// Never expose the stored public key or signature counter to the client.
+export const toPublic = (c: StoredPasskeyCredential) => ({
+  id: c.id,
+  name: c.name,
+  aaguid: c.aaguid,
+  providerIcon: c.providerIcon,
+  credentialDeviceType: c.credentialDeviceType,
+  credentialBackedUp: c.credentialBackedUp,
+  transports: c.transports,
+  registeredAt: c.registeredAt,
+  lastUsedAt: c.lastUsedAt,
+});
