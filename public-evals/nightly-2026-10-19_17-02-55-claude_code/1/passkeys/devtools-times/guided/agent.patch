+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRelyingParty } from '../../../../lib/passkeys/config';
+import { findCredentialsByUserId } from '../../../../lib/passkeys/store';
+import { getSessionUser, json } from '../../../../lib/passkeys/session';
+
+export const POST: APIRoute = async ({ session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user || !session) return json({ error: 'Not signed in' }, 401);
+  const creds = await findCredentialsByUserId(user.id);
+  if (!creds.length) return json({ error: 'No passkeys registered' }, 404);
+
+  const { rpID } = getRelyingParty(url);
+  const options = await generateAuthenticationOptions({
+    rpID,
+    // Constrain to this user's credentials so another account's passkey can't be used.
+    allowCredentials: creds.map((c) => ({ id: c.id, transports: c.transports as any })),
+    userVerification: 'preferred',
+  });
+  await session.set('passkeyChallenge', {
+    type: 'reauth',
+    challenge: options.challenge,
+    userVerification: 'preferred',
+  });
+  return json(options);
+};
