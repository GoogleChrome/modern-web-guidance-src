+}
+.passkey-list img, .passkey-list .icon-fallback { width: 32px; height: 32px; }
+.icon-fallback { display: grid; place-items: center; background: var(--secondary); border-radius: 6px; }
+.passkey-meta { font-size: 0.8rem; color: #6d4c41; }
+.actions { display: flex; gap: 8px; }
+.actions button { padding: 6px 12px; font-size: 0.85rem; }
+
+dialog { margin: auto; padding: 24px; border: 0; border-radius: 8px; width: min(420px, 92vw); }
