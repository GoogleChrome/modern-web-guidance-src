+dialog menu { display: flex; gap: 8px; justify-content: flex-end; list-style: none; }
diff --git a/server.js b/server.js
new file mode 100644
index 0000000..9d84d43
--- /dev/null
+++ b/server.js
@@ -0,0 +1,434 @@
+import http from 'node:http';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from '@simplewebauthn/server';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT || 11222);
+// The RP ID and origin are fixed configuration, never derived from the request.
+const RP_ID = process.env.RP_ID || 'localhost';
+const RP_NAME = 'The Daily Grind';
+const ORIGIN = process.env.ORIGIN || `http://localhost:${PORT}`;
+const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const DB_FILE = process.env.DB_FILE || path.join(__dirname, 'data', 'db.json');
+const AAGUID_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+/* ---------- Storage (JSON file) ---------- */
+
+let db = { users: [], credentials: [] };
+try {
+  db = JSON.parse(fs.readFileSync(DB_FILE, 'utf8'));
+} catch {}
+
+function saveDb() {
+  fs.mkdirSync(path.dirname(DB_FILE), { recursive: true });
+  fs.writeFileSync(DB_FILE, JSON.stringify(db, null, 2));
+}
+
+const b64url = (buf) => Buffer.from(buf).toString('base64url');
+const findUserById = (id) => db.users.find((u) => u.id === id);
+const findUserByName = (name) =>
+  db.users.find((u) => u.name.toLowerCase() === String(name).toLowerCase());
+const findCredential = (id) => db.credentials.find((c) => c.id === id);
+const userCredentials = (userId) =>
+  db.credentials.filter((c) => c.passkeyUserId === userId);
+
+function hashPassword(password) {
+  const salt = crypto.randomBytes(16);
+  return `${salt.toString('base64')}:${crypto.scryptSync(password, salt, 64).toString('base64')}`;
+}
+
+function checkPassword(user, password) {
+  const [salt, hash] = user.passwordHash.split(':');
+  const actual = crypto.scryptSync(String(password), Buffer.from(salt, 'base64'), 64);
+  return crypto.timingSafeEqual(actual, Buffer.from(hash, 'base64'));
+}
+
+/* ---------- AAGUID provider lookup (UX hint only) ---------- */
+
+let aaguidRegistry = null;
+async function lookupProvider(aaguid) {
+  if (aaguid === ZERO_AAGUID) return { name: 'Unknown passkey provider' };
+  try {
+    aaguidRegistry ??= await (await fetch(AAGUID_URL, { signal: AbortSignal.timeout(4000) })).json();
+  } catch {
+    return { name: 'Unknown passkey provider' };
+  }
+  const p = aaguidRegistry[aaguid];
+  return { name: p?.name || 'Unknown passkey provider', providerIcon: p?.icon_light };
+}
+
+/* ---------- Sessions ---------- */
+
+const sessions = new Map();
+
+function getSession(req, res, create = false) {
+  const cookies = Object.fromEntries(
+    (req.headers.cookie || '').split(';').map((c) => c.trim().split('=')).filter((p) => p[0]),
+  );
+  let session = sessions.get(cookies.sid);
+  if (!session && create) {
+    const sid = crypto.randomBytes(32).toString('base64url');
+    session = { sid };
+    sessions.set(sid, session);
+    res.setHeader('Set-Cookie', `sid=${sid}; HttpOnly; SameSite=Strict; Path=/`);
+  }
+  return session;
+}
+
+// Rotate the session ID when privilege changes to prevent fixation.
+function signIn(req, res, user, method) {
+  const old = getSession(req, res);
+  if (old) sessions.delete(old.sid);
+  const session = getSession(req, res, true) ?? null;
+  session.userId = user.id;
+  session.reauthAt = Date.now();
+  session.signInMethod = method;
+}
+
+const hasRecentReauth = (s) => Date.now() - (s.reauthAt || 0) < REAUTH_WINDOW_MS;
+
+/* ---------- HTTP helpers ---------- */
+
+const json = (res, status, body) => {
+  res.writeHead(status, { 'Content-Type': 'application/json' });
+  res.end(JSON.stringify(body));
+};
+
+async function readBody(req) {
+  let data = '';
+  for await (const chunk of req) {
+    data += chunk;
+    if (data.length > 1e6) throw new Error('Body too large');
+  }
+  return data ? JSON.parse(data) : {};
+}
+
+const publicUser = (u) => ({
+  id: u.id,
+  name: u.name,
+  displayName: u.displayName,
+  hasPassword: !!u.passwordHash,
+});
+
+const publicCredential = (c) => ({
+  id: c.id,
+  name: c.name,
+  providerIcon: c.providerIcon,
+  aaguid: c.aaguid,
+  credentialDeviceType: c.credentialDeviceType,
+  credentialBackedUp: c.credentialBackedUp,
+  registeredAt: c.registeredAt,
+  lastUsedAt: c.lastUsedAt,
+});
+
+/* ---------- API ---------- */
+
+const routes = [];
+const route = (method, pattern, handler, { auth = false } = {}) =>
+  routes.push({ method, regex: new RegExp(`^${pattern.replace(/:\w+/g, '([^/]+)')}$`), handler, auth });
+
+route('POST', '/api/signup', async (req, res, body) => {
+  const name = String(body.username || '').trim();
+  const displayName = String(body.displayName || '').trim() || name;
+  const password = String(body.password || '');
+  if (!/^[\w.@-]{3,64}$/.test(name)) return json(res, 400, { error: 'Username must be 3-64 letters, numbers or . _ @ -' });
+  if (password.length < 8) return json(res, 400, { error: 'Password must be at least 8 characters.' });
+  if (findUserByName(name)) return json(res, 409, { error: 'That username is taken.' });
+  const user = {
+    id: b64url(crypto.randomBytes(32)),
+    name,
+    displayName,
+    passwordHash: hashPassword(password),
+  };
+  db.users.push(user);
+  saveDb();
+  signIn(req, res, user, 'password');
+  json(res, 200, { user: publicUser(user) });
+});
+
+route('POST', '/api/login', async (req, res, body) => {
+  const user = findUserByName(body.username || '');
+  if (!user || !user.passwordHash || !checkPassword(user, body.password)) {
+    return json(res, 401, { error: 'Incorrect username or password.' });
+  }
+  signIn(req, res, user, 'password');
+  json(res, 200, { user: publicUser(user) });
+});
+
+const logout = (req, res) => {
+  const s = getSession(req, res);
+  if (s) sessions.delete(s.sid);
+  res.setHeader('Set-Cookie', 'sid=; Max-Age=0; HttpOnly; SameSite=Strict; Path=/');
+};
+route('POST', '/api/logout', async (req, res) => {
+  logout(req, res);
+  json(res, 200, { success: true });
+});
+
+route('GET', '/api/me', async (req, res) => {
+  const user = findUserById(getSession(req, res)?.userId);
+  json(res, 200, { user: user ? publicUser(user) : null, rpId: RP_ID });
+});
+
+route('PUT', '/api/user', async (req, res, body, session) => {
+  const user = findUserById(session.userId);
+  const name = String(body.name || '').trim();
+  const displayName = String(body.displayName || '').trim();
+  if (!/^[\w.@-]{3,64}$/.test(name) || !displayName) return json(res, 400, { error: 'Invalid name.' });
+  const clash = findUserByName(name);
+  if (clash && clash.id !== user.id) return json(res, 409, { error: 'That username is taken.' });
+  user.name = name;
+  user.displayName = displayName;
+  saveDb();
+  json(res, 200, publicUser(user));
+}, { auth: true });
+
+route('POST', '/api/password', async (req, res, body, session) => {
+  if (!hasRecentReauth(session)) return json(res, 403, { error: 'Please verify your identity first.', reauthRequired: true });
+  const password = String(body.password || '');
+  if (password.length < 8) return json(res, 400, { error: 'Password must be at least 8 characters.' });
+  findUserById(session.userId).passwordHash = hashPassword(password);
+  saveDb();
+  session.reauthAt = 0; // sensitive actions consume the reauthentication
+  json(res, 200, { success: true });
+}, { auth: true });
+
+/* Passkey registration */
+
+route('POST', '/api/passkey/register/options', async (req, res, body, session) => {
+  const user = findUserById(session.userId);
+  const creds = userCredentials(user.id);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: RP_ID,
+    userName: user.name,
+    userDisplayName: user.displayName,
+    userID: Buffer.from(user.id, 'base64url'),
+    attestationType: 'none',
+    excludeCredentials: creds.map((c) => ({ id: c.id, transports: c.transports })),
+    supportedAlgorithmIDs: [-7, -257],
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      // Promotion flows target the platform authenticator; the management page allows security keys too.
+      ...(body.promotion && { authenticatorAttachment: 'platform' }),
+    },
+  });
+  session.challenge = options.challenge;
+  json(res, 200, options);
+}, { auth: true });
+
+route('POST', '/api/passkey/register/verify', async (req, res, body, session) => {
+  const user = findUserById(session.userId);
+  const expectedChallenge = session.challenge;
+  session.challenge = null;
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body,
+      expectedChallenge,
+      expectedOrigin: ORIGIN,
+      expectedRPID: RP_ID,
+      requireUserVerification: false, // options asked for "preferred"
+    });
+  } catch (err) {
+    return json(res, 400, { error: err.message });
+  }
+  if (!verification.verified) return json(res, 400, { error: 'Verification failed.' });
+  const { aaguid, credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  if (findCredential(credential.id)) return json(res, 409, { error: 'Passkey already registered.' });
+  const provider = await lookupProvider(aaguid);
+  const stored = {
+    id: credential.id,
+    passkeyUserId: user.id,
+    credentialPublicKey: b64url(credential.publicKey),
+    credentialType: 'public-key',
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    providerIcon: provider.providerIcon,
+    name: provider.name,
+    transports: credential.transports || body.response?.transports || [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  };
+  db.credentials.push(stored);
+  saveDb();
+  json(res, 200, publicCredential(stored));
+}, { auth: true });
+
+/* Passkey authentication, shared by sign-in and reauthentication */
+
+async function verifyAssertion(body, session, expectedUserId) {
+  const stored = findCredential(body.id);
+  if (!stored) return { status: 404, error: 'Passkey not found.' };
+  // Reauthentication must resolve to a credential owned by the signed-in user.
+  if (expectedUserId && stored.passkeyUserId !== expectedUserId) {
+    return { status: 403, error: 'That passkey belongs to a different account.' };
+  }
+  const expectedChallenge = session.challenge;
+  session.challenge = null;
+  try {
+    const verification = await verifyAuthenticationResponse({
+      response: body,
+      expectedChallenge,
+      expectedOrigin: ORIGIN,
+      expectedRPID: RP_ID,
+      requireUserVerification: session.expectedUserVerification === 'required',
+      credential: {
+        id: stored.id,
+        publicKey: Buffer.from(stored.credentialPublicKey, 'base64url'),
+        counter: stored.counter,
+        transports: stored.transports,
+      },
+    });
+    if (!verification.verified) return { status: 401, error: 'Verification failed.' };
+    stored.counter = verification.authenticationInfo.newCounter;
+    stored.credentialBackedUp = verification.authenticationInfo.credentialBackedUp;
+    stored.lastUsedAt = Date.now();
+    saveDb();
+    return { stored };
+  } catch (err) {
+    return { status: 400, error: err.message };
+  }
+}
+
+route('POST', '/api/passkey/login/options', async (req, res) => {
+  const session = getSession(req, res, true);
+  const options = await generateAuthenticationOptions({
+    rpID: RP_ID,
+    allowCredentials: [], // discoverable credentials
+    userVerification: 'preferred',
+  });
+  session.challenge = options.challenge;
+  session.expectedUserVerification = 'preferred';
+  json(res, 200, options);
+});
+
+route('POST', '/api/passkey/login/verify', async (req, res, body) => {
+  const session = getSession(req, res, true);
+  const result = await verifyAssertion(body, session, null);
+  if (result.error) return json(res, result.status, { error: result.error });
+  const user = findUserById(result.stored.passkeyUserId);
+  signIn(req, res, user, 'passkey');
+  json(res, 200, { user: publicUser(user) });
+});
+
+route('POST', '/api/reauth/options', async (req, res, body, session) => {
+  const creds = userCredentials(session.userId);
+  if (!creds.length) return json(res, 400, { error: 'No passkeys registered.' });
+  const options = await generateAuthenticationOptions({
+    rpID: RP_ID,
+    // Constrained to the signed-in user's own credentials.
+    allowCredentials: creds.map((c) => ({ id: c.id, transports: c.transports })),
+    userVerification: 'required',
+  });
+  session.challenge = options.challenge;
+  session.expectedUserVerification = 'required';
+  json(res, 200, options);
+}, { auth: true });
+
+route('POST', '/api/reauth/verify', async (req, res, body, session) => {
+  const result = await verifyAssertion(body, session, session.userId);
+  if (result.error) return json(res, result.status, { error: result.error });
+  session.reauthAt = Date.now();
+  json(res, 200, { success: true });
+}, { auth: true });
+
+route('POST', '/api/reauth/password', async (req, res, body, session) => {
+  const user = findUserById(session.userId);
+  if (!user.passwordHash || !checkPassword(user, body.password)) {
+    return json(res, 401, { error: 'Incorrect password.' });
+  }
+  session.reauthAt = Date.now();
+  json(res, 200, { success: true });
+}, { auth: true });
+
+/* Passkey management */
+
+route('GET', '/api/credentials', async (req, res, body, session) => {
+  json(res, 200, userCredentials(session.userId).map(publicCredential));
+}, { auth: true });
+
+route('PUT', '/api/credential/:id', async (req, res, body, session, [id]) => {
+  const cred = findCredential(id);
+  const name = String(body.name || '').trim().slice(0, 64);
+  if (!cred || cred.passkeyUserId !== session.userId) return json(res, 404, { error: 'Credential not found.' });
+  if (!name) return json(res, 400, { error: 'Name is required.' });
+  cred.name = name;
+  saveDb();
+  json(res, 200, publicCredential(cred));
+}, { auth: true });
+
+route('DELETE', '/api/credential/:id', async (req, res, body, session, [id]) => {
+  const cred = findCredential(id);
+  if (!cred || cred.passkeyUserId !== session.userId) return json(res, 404, { error: 'Credential not found.' });
+  if (!hasRecentReauth(session)) return json(res, 403, { error: 'Please verify your identity first.', reauthRequired: true });
+  db.credentials = db.credentials.filter((c) => c.id !== id);
+  saveDb();
+  json(res, 200, { success: true });
+}, { auth: true });
+
+/* ---------- Static files ---------- */
+
+const pages = {
+  '/': 'index.html',
+  '/login': 'public/login.html',
+  '/account': 'public/account.html',
+  '/passkeys.js': 'public/passkeys.js',
+  '/site.css': 'public/site.css',
+};
+const types = { '.html': 'text/html', '.js': 'text/javascript', '.css': 'text/css' };
+
+const server = http.createServer(async (req, res) => {
+  try {
+    const { pathname } = new URL(req.url, ORIGIN);
+    const isApi = pathname.startsWith('/api/');
+
+    if (!isApi) {
+      if (pathname === '/logout') {
+        logout(req, res);
+        res.writeHead(302, { Location: '/login' }).end();
+        return;
+      }
+      const file = pages[pathname];
+      if (req.method !== 'GET' || !file) return json(res, 404, { error: 'Not found' });
+      if (pathname === '/account' && !findUserById(getSession(req, res)?.userId)) {
+        res.writeHead(302, { Location: '/login' }).end();
+        return;
+      }
+      res.writeHead(200, { 'Content-Type': `${types[path.extname(file)]}; charset=utf-8` });
+      res.end(fs.readFileSync(path.join(__dirname, file)));
+      return;
+    }
+
+    // CSRF defence in depth on top of SameSite=Strict.
+    if (req.method !== 'GET' && req.headers.origin !== ORIGIN) return json(res, 403, { error: 'Bad origin' });
+
+    for (const r of routes) {
+      const m = r.regex.exec(pathname);
+      if (r.method !== req.method || !m) continue;
+      const session = getSession(req, res);
+      if (r.auth && !findUserById(session?.userId)) return json(res, 401, { error: 'Not signed in.' });
+      const body = req.method === 'GET' ? {} : await readBody(req);
+      return await r.handler(req, res, body, session, m.slice(1));
+    }
+    json(res, 404, { error: 'Not found' });
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) json(res, 400, { error: 'Bad request' });
+  }
+});
+
+server.listen(PORT, () => console.log(`The Daily Grind running at ${ORIGIN} (RP ID: ${RP_ID})`));
