@@ -0,0 +1,90 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Sign in | The Daily Grind</title>
+  <link rel="stylesheet" href="/site.css">
+</head>
+<body>
+  <nav>
+    <a class="logo" href="/">THE DAILY GRIND</a>
+  </nav>
+
+  <main>
+    <section class="card">
+      <h1>Sign in</h1>
+      <form id="signin-form">
+        <label>Username
+          <input type="text" name="username" autocomplete="username webauthn" autofocus required>
+        </label>
+        <label>Password
+          <input type="password" name="password" autocomplete="current-password" required>
+        </label>
+        <button type="submit">Sign in</button>
+      </form>
+      <div id="passkey-section" hidden>
+        <p class="divider">or</p>
+        <button type="button" id="passkey-btn" class="secondary" style="width: 100%">Sign in with a passkey</button>
+      </div>
+      <p id="signin-status" class="status" role="status"></p>
+    </section>
+
+    <section class="card">
+      <h2>New here?</h2>
+      <form id="signup-form">
+        <label>Username
+          <input type="text" name="username" autocomplete="username" minlength="3" required>
+        </label>
+        <label>Display name
+          <input type="text" name="displayName" autocomplete="name">
+        </label>
+        <label>Password
+          <input type="password" name="password" autocomplete="new-password" minlength="8" required>
+        </label>
+        <button type="submit">Create account</button>
+      </form>
+      <p id="signup-status" class="status" role="status"></p>
+    </section>
+  </main>
+
+  <script type="module">
+    import { api, loadMe, passkeysSupported, signInWithPasskey, startConditionalSignIn } from '/passkeys.js';
+
+    const signinStatus = document.getElementById('signin-status');
+    const signupStatus = document.getElementById('signup-status');
+
+    const done = () => { location.href = '/account'; };
+    const fail = (msg) => {
+      signinStatus.textContent = msg;
+      signinStatus.className = 'status error';
+    };
+
+    if (await loadMe()) done();
+
+    async function submit(form, url, statusEl) {
+      statusEl.className = 'status';
+      statusEl.textContent = '';
+      const res = await api('POST', url, Object.fromEntries(new FormData(form)));
+      if (res.ok) return done();
+      statusEl.textContent = (await res.json()).error;
+      statusEl.className = 'status error';
+    }
+
+    document.getElementById('signin-form').addEventListener('submit', (e) => {
+      e.preventDefault();
+      submit(e.target, '/api/login', signinStatus);
+    });
+    document.getElementById('signup-form').addEventListener('submit', (e) => {
+      e.preventDefault();
+      submit(e.target, '/api/signup', signupStatus);
+    });
+
+    if (await passkeysSupported()) {
+      document.getElementById('passkey-section').hidden = false;
+      document.getElementById('passkey-btn').addEventListener('click', () => signInWithPasskey(done, fail));
+      startConditionalSignIn(done, fail);
+    }
+  </script>
+</body>
+</html>
diff --git a/public/passkeys.js b/public/passkeys.js
new file mode 100644
index 0000000..ec729c7
--- /dev/null
+++ b/public/passkeys.js
@@ -0,0 +1,177 @@
+// Shared client-side WebAuthn helpers using the native browser APIs.
+
+// Polyfill JSON helpers (parse*OptionsFromJSON, toJSON, getClientCapabilities) where missing.
+if (
+  window.PublicKeyCredential &&
+  (!PublicKeyCredential.parseRequestOptionsFromJSON || !PublicKeyCredential.getClientCapabilities)
+) {
+  await import('https://unpkg.com/webauthn-polyfills');
+}
+
+export const api = (method, url, body) =>
+  fetch(url, {
+    method,
+    headers: { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+
+let rpId = location.hostname;
+export async function loadMe() {
+  const data = await (await api('GET', '/api/me')).json();
+  rpId = data.rpId;
+  return data.user;
+}
+
+export async function passkeysSupported() {
+  if (!window.PublicKeyCredential) return false;
+  const caps = await PublicKeyCredential.getClientCapabilities();
+  return !!(caps.passkeyPlatformAuthenticator || caps.userVerifyingPlatformAuthenticator || caps.conditionalGet);
+}
+
+async function signalUnknown(credentialId) {
+  if (!PublicKeyCredential.signalUnknownCredential) return;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+  } catch (e) {
+    console.error('signalUnknownCredential failed', e);
+  }
+}
+
+export async function signalAccepted(user, credentials) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId,
+      userId: user.id,
+      allAcceptedCredentialIds: credentials.map((c) => c.id),
+    });
+  } catch (e) {
+    console.error('signalAllAcceptedCredentials failed', e);
+  }
+}
+
+export async function signalUserDetails(user) {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId,
+      userId: user.id,
+      name: user.name,
+      displayName: user.displayName,
+    });
+  } catch (e) {
+    console.error('signalCurrentUserDetails failed', e);
+  }
+}
+
+/**
+ * Register a passkey. Returns the stored credential, or null if the user cancelled.
+ * Throws an Error with a user-facing message on failure.
+ */
+export async function registerPasskey({ promotion = false } = {}) {
+  const optionsRes = await api('POST', '/api/passkey/register/options', { promotion });
+  if (!optionsRes.ok) throw new Error((await optionsRes.json()).error);
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsRes.json());
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    if (err.name === 'InvalidStateError') throw new Error('A passkey from this provider already exists for your account.');
+    if (err.name === 'SecurityError') throw new Error('Passkeys are unavailable here (needs HTTPS and a matching RP ID).');
+    return null; // NotAllowedError / AbortError: user cancelled
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    const res = await api('POST', '/api/passkey/register/verify', encoded);
+    if (!res.ok) {
+      await signalUnknown(encoded.id); // orphaned credential on the provider
+      throw new Error((await res.json()).error || 'Could not save passkey.');
+    }
+    return await res.json();
+  } catch (err) {
+    if (err instanceof TypeError) await signalUnknown(encoded.id); // network failure
+    throw err;
+  }
+}
+
+let autofillController = new AbortController();
+
+/** Conditional UI: offer passkeys in the username field's autofill. Resolves with the user on success. */
+export async function startConditionalSignIn(onSignedIn, onError) {
+  if (!window.PublicKeyCredential) return;
+  const caps = await PublicKeyCredential.getClientCapabilities();
+  if (!caps.conditionalGet) return;
+
+  const optionsRes = await api('POST', '/api/passkey/login/options');
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await optionsRes.json());
+  let credential;
+  try {
+    credential = await navigator.credentials.get({
+      publicKey,
+      mediation: 'conditional',
+      signal: autofillController.signal,
+    });
+  } catch (err) {
+    if (!['NotAllowedError', 'AbortError'].includes(err.name)) console.error(err);
+    return;
+  }
+  await finishSignIn(credential, onSignedIn, onError);
+}
+
+async function finishSignIn(credential, onSignedIn, onError) {
+  const encoded = credential.toJSON();
+  try {
+    const res = await api('POST', '/api/passkey/login/verify', encoded);
+    if (res.ok) return onSignedIn((await res.json()).user);
+    if (res.status === 404) await signalUnknown(encoded.id);
+    onError((await res.json()).error || 'Sign-in failed.');
+  } catch {
+    onError('Network error. Please try again.');
+  }
+}
+
+/** Explicit "Sign in with a passkey" button flow. */
+export async function signInWithPasskey(onSignedIn, onError) {
+  autofillController.abort(); // avoid colliding with the pending conditional request
+  autofillController = new AbortController();
+
+  const optionsRes = await api('POST', '/api/passkey/login/options');
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await optionsRes.json());
+  let credential;
+  try {
+    credential = await navigator.credentials.get({ publicKey });
+  } catch {
+    startConditionalSignIn(onSignedIn, onError); // re-arm autofill after cancel
+    return;
+  }
+  await finishSignIn(credential, onSignedIn, onError);
+}
+
+/**
+ * Reauthenticate the signed-in user with one of their own passkeys.
+ * Returns true if verified, false if cancelled; throws on failure.
+ */
+export async function reauthWithPasskey() {
+  const optionsRes = await api('POST', '/api/reauth/options');
+  if (!optionsRes.ok) throw new Error((await optionsRes.json()).error);
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await optionsRes.json());
+  let credential;
+  try {
+    credential = await navigator.credentials.get({ publicKey });
+  } catch {
+    return false;
+  }
+  const encoded = credential.toJSON();
+  const res = await api('POST', '/api/reauth/verify', encoded);
+  if (res.status === 404) await signalUnknown(encoded.id);
+  if (!res.ok) throw new Error((await res.json()).error || 'Verification failed.');
+  return true;
+}
+
+export async function reauthWithPassword(password) {
+  const res = await api('POST', '/api/reauth/password', { password });
+  if (!res.ok) throw new Error((await res.json()).error);
+  return true;
+}
diff --git a/public/site.css b/public/site.css
new file mode 100644
index 0000000..0ef5381
--- /dev/null
+++ b/public/site.css
@@ -0,0 +1,93 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* { box-sizing: border-box; margin: 0; padding: 0; }
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background: var(--light);
+}
+
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+nav a { color: white; text-decoration: none; font-size: 0.9rem; }
+nav a:hover { color: var(--accent); }
+.logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+.logout-link { border: 1px solid var(--accent); padding: 5px 12px; border-radius: 4px; }
+
+main { max-width: 640px; margin: 40px auto; padding: 0 20px; }
+h1 { margin-bottom: 1rem; color: var(--primary); }
+h2 { margin-bottom: 0.75rem; color: var(--primary); }
+
+.card {
+  background: white;
+  padding: 24px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  margin-bottom: 24px;
+}
+
+form { display: grid; gap: 12px; }
+label { display: grid; gap: 4px; font-size: 0.9rem; }
+input {
+  font: inherit;
+  padding: 10px;
+  border: 1px solid var(--secondary);
+  border-radius: 5px;
+}
+
+button {
+  font: inherit;
+  background: var(--primary);
+  color: white;
+  border: 0;
+  padding: 10px 20px;
+  border-radius: 5px;
+  cursor: pointer;
+}
+button:hover:not(:disabled) { background: #3e2723; }
+button:disabled { opacity: 0.5; cursor: not-allowed; }
+button.secondary { background: transparent; color: var(--primary); border: 1px solid var(--primary); }
+button.danger { background: #b71c1c; }
+:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
+
+.divider { text-align: center; margin: 16px 0; color: #795548; font-size: 0.85rem; }
+.status { min-height: 1.5em; margin-top: 8px; font-size: 0.9rem; }
+.status.error { color: #b71c1c; }
+.status.ok { color: #2e7d32; }
+.hint { font-size: 0.85rem; color: #6d4c41; margin-bottom: 12px; }
+[hidden] { display: none !important; }
+
+.passkey-list { list-style: none; display: grid; gap: 12px; margin: 12px 0; }
+.passkey-list li {
+  display: grid;
+  grid-template-columns: 32px 1fr auto;
+  gap: 12px;
+  align-items: center;
+  padding: 12px;
+  border: 1px solid var(--secondary);
