diff --git a/public/account.html b/public/account.html
new file mode 100644
index 0000000..0c7b152
--- /dev/null
+++ b/public/account.html
@@ -0,0 +1,269 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <link rel="stylesheet" href="/site.css">
+</head>
+<body>
+  <nav>
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <a href="/logout" class="logout-link">Logout</a>
+  </nav>
+
+  <main>
+    <h1>My Account</h1>
+
+    <section class="card">
+      <h2>Profile</h2>
+      <form id="profile-form">
+        <label>Username
+          <input type="text" name="name" autocomplete="username" required>
+        </label>
+        <label>Display name
+          <input type="text" name="displayName" autocomplete="name" required>
+        </label>
+        <button type="submit">Save profile</button>
+      </form>
+      <p id="profile-status" class="status" role="status"></p>
+    </section>
+
+    <section class="card" aria-labelledby="passkeys-heading">
+      <h2 id="passkeys-heading">Passkeys</h2>
+      <p class="hint">Passkeys let you sign in with your fingerprint, face or screen lock instead of a password.</p>
+      <ul id="passkey-list" class="passkey-list"></ul>
+      <p id="passkey-empty" hidden>No passkeys found.</p>
+      <button type="button" id="create-passkey" disabled>Create a passkey</button>
+      <p id="passkey-unsupported" class="hint" hidden>This browser or device doesn't support passkeys.</p>
+      <p id="passkey-status" class="status" role="status"></p>
+    </section>
+
+    <section class="card">
+      <h2>Change password</h2>
+      <p class="hint">You'll be asked to verify your identity first.</p>
+      <form id="password-form">
+        <label>New password
+          <input type="password" name="password" autocomplete="new-password" minlength="8" required>
+        </label>
+        <button type="submit">Change password</button>
+      </form>
+      <p id="password-status" class="status" role="status"></p>
+    </section>
+  </main>
+
+  <dialog id="rename-dialog" aria-labelledby="rename-title">
+    <h2 id="rename-title">Rename passkey</h2>
+    <form method="dialog" id="rename-form">
+      <label>Name
+        <input type="text" name="name" maxlength="64" required>
+      </label>
+      <menu>
+        <button type="button" class="secondary" value="cancel">Cancel</button>
+        <button type="submit">Save</button>
+      </menu>
+    </form>
+  </dialog>
+
+  <dialog id="reauth-dialog" aria-labelledby="reauth-title">
+    <h2 id="reauth-title">Verify it's you</h2>
+    <p class="hint">For your security, confirm your identity to continue.</p>
+    <button type="button" id="reauth-passkey" style="width: 100%">Use a passkey</button>
+    <form id="reauth-password-form">
+      <label>Password
+        <input type="password" name="password" autocomplete="current-password" required>
+      </label>
+      <button type="submit" class="secondary">Verify with password</button>
+    </form>
+    <p id="reauth-status" class="status error" role="alert"></p>
+    <menu>
+      <button type="button" class="secondary" id="reauth-cancel">Cancel</button>
+    </menu>
+  </dialog>
+
+  <script type="module">
+    import {
+      api, loadMe, passkeysSupported, registerPasskey, reauthWithPasskey, reauthWithPassword,
+      signalAccepted, signalUserDetails,
+    } from '/passkeys.js';
+
+    const $ = (id) => document.getElementById(id);
+    const dateFmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+    const setStatus = (el, msg, kind = '') => { el.textContent = msg; el.className = `status ${kind}`; };
+
+    let user = await loadMe();
+    if (!user) location.href = '/login';
+    let credentials = [];
+    const supported = await passkeysSupported();
+
+    function fillProfile() {
+      const form = $('profile-form');
+      form.name.value = user.name;
+      form.displayName.value = user.displayName;
+    }
+
+    async function refreshCredentials({ sync = false } = {}) {
+      credentials = await (await api('GET', '/api/credentials')).json();
+      renderCredentials();
+      if (sync) await signalAccepted(user, credentials);
+    }
+
+    function renderCredentials() {
+      const list = $('passkey-list');
+      list.replaceChildren();
+      $('passkey-empty').hidden = credentials.length > 0;
+      for (const c of credentials) {
+        const li = document.createElement('li');
+        const icon = c.providerIcon ? document.createElement('img') : document.createElement('span');
+        if (c.providerIcon) { icon.src = c.providerIcon; icon.alt = ''; }
+        else { icon.className = 'icon-fallback'; icon.textContent = '🔑'; icon.setAttribute('aria-hidden', 'true'); }
+
+        const info = document.createElement('div');
+        const title = document.createElement('strong');
+        title.textContent = c.name;
+        const meta = document.createElement('div');
+        meta.className = 'passkey-meta';
+        meta.textContent = `Created ${dateFmt.format(c.registeredAt)} · ` +
+          (c.lastUsedAt ? `Last used ${dateFmt.format(c.lastUsedAt)}` : 'Never used');
+        info.append(title, meta);
+
+        const actions = document.createElement('div');
+        actions.className = 'actions';
+        const rename = document.createElement('button');
+        rename.className = 'secondary';
+        rename.textContent = 'Rename';
+        rename.setAttribute('aria-label', `Rename ${c.name}`);
+        rename.addEventListener('click', () => renamePasskey(c));
+        const del = document.createElement('button');
+        del.className = 'danger';
+        del.textContent = 'Delete';
+        del.setAttribute('aria-label', `Delete ${c.name}`);
+        del.addEventListener('click', () => deletePasskey(c));
+        actions.append(rename, del);
+
+        li.append(icon, info, actions);
+        list.append(li);
+      }
+    }
+
+    /* ----- Reauthentication ----- */
+
+    // Resolves true once the user has verified, false if they cancel.
+    function requestReauth() {
+      const dialog = $('reauth-dialog');
+      const status = $('reauth-status');
+      const passkeyBtn = $('reauth-passkey');
+      const pwForm = $('reauth-password-form');
+      passkeyBtn.hidden = !(supported && credentials.length);
+      pwForm.hidden = !user.hasPassword;
+      pwForm.reset();
+      status.textContent = '';
+
+      return new Promise((resolve) => {
+        const finish = (ok) => {
+          passkeyBtn.onclick = pwForm.onsubmit = $('reauth-cancel').onclick = dialog.onclose = null;
+          if (dialog.open) dialog.close();
+          resolve(ok);
+        };
+        const attempt = async (fn) => {
+          try {
+            const ok = await fn();
+            if (ok) finish(true);
+          } catch (err) {
+            status.textContent = err.message;
+          }
+        };
+        passkeyBtn.onclick = () => attempt(reauthWithPasskey);
+        pwForm.onsubmit = (e) => {
+          e.preventDefault();
+          attempt(() => reauthWithPassword(new FormData(pwForm).get('password')));
+        };
+        $('reauth-cancel').onclick = () => finish(false);
+        dialog.onclose = () => finish(false);
+        dialog.showModal();
+      });
+    }
+
+    // Runs a sensitive request, prompting for reauthentication once if the server asks for it.
+    async function withReauth(request) {
+      let res = await request();
+      if (res.status === 403 && (await res.clone().json()).reauthRequired) {
+        if (!(await requestReauth())) return null;
+        res = await request();
+      }
+      return res;
+    }
+
+    /* ----- Profile ----- */
+
+    $('profile-form').addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const res = await api('PUT', '/api/user', Object.fromEntries(new FormData(e.target)));
+      const data = await res.json();
+      if (!res.ok) return setStatus($('profile-status'), data.error, 'error');
+      user = { ...user, ...data };
+      await signalUserDetails(user);
+      setStatus($('profile-status'), 'Profile saved.', 'ok');
+    });
+
+    /* ----- Passkey management ----- */
+
+    $('create-passkey').addEventListener('click', async () => {
+      setStatus($('passkey-status'), '');
+      try {
+        const created = await registerPasskey();
+        if (created) {
+          await refreshCredentials({ sync: true });
+          setStatus($('passkey-status'), 'Passkey created.', 'ok');
+        }
+      } catch (err) {
+        setStatus($('passkey-status'), err.message, 'error');
+      }
+    });
+
+    function renamePasskey(c) {
+      const dialog = $('rename-dialog');
+      const form = $('rename-form');
+      form.name.value = c.name;
+      form.onsubmit = async (e) => {
+        e.preventDefault();
+        const res = await api('PUT', `/api/credential/${encodeURIComponent(c.id)}`, { name: form.name.value });
+        dialog.close();
+        if (res.ok) await refreshCredentials(); // nickname is a server-side label; no signal needed
+        else setStatus($('passkey-status'), (await res.json()).error, 'error');
+      };
+      form.querySelector('[value=cancel]').onclick = () => dialog.close();
+      dialog.showModal();
+    }
+
+    async function deletePasskey(c) {
+      if (!confirm(`Delete "${c.name}"? You won't be able to sign in with it anymore.`)) return;
+      const res = await withReauth(() => api('DELETE', `/api/credential/${encodeURIComponent(c.id)}`));
+      if (!res) return;
+      if (!res.ok) return setStatus($('passkey-status'), (await res.json()).error, 'error');
+      await refreshCredentials({ sync: true });
+      setStatus($('passkey-status'), 'Passkey deleted.', 'ok');
+    }
+
+    /* ----- Password ----- */
+
+    $('password-form').addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const password = new FormData(e.target).get('password');
+      const res = await withReauth(() => api('POST', '/api/password', { password }));
+      if (!res) return;
+      if (!res.ok) return setStatus($('password-status'), (await res.json()).error, 'error');
+      user.hasPassword = true;
+      e.target.reset();
+      setStatus($('password-status'), 'Password changed.', 'ok');
+    });
+
+    /* ----- Init ----- */
+
+    fillProfile();
+    if (supported) $('create-passkey').disabled = false;
+    else $('passkey-unsupported').hidden = false;
+    await refreshCredentials({ sync: true }); // sync accepted credentials on page load
+  </script>
+</body>
+</html>
diff --git a/public/login.html b/public/login.html
new file mode 100644
index 0000000..6ea254a
--- /dev/null
