+  <script type="module">
+    // Use native Temporal when available; otherwise load the polyfill on demand.
+    async function loadTemporal() {
+      if (typeof globalThis.Temporal !== 'undefined') return globalThis.Temporal;
+      const { Temporal } = await import('https://esm.sh/@js-temporal/polyfill@0.5.1');
+      return Temporal;
+    }
+
+    const startDateInput = document.getElementById('startDateInput');
+    const yearsInput = document.getElementById('yearsInput');
+    const monthsInput = document.getElementById('monthsInput');
+    const overflowSelect = document.getElementById('overflowSelect');
+    const resultDate = document.getElementById('resultDate');
+
+    function show(text, isError = false) {
+      resultDate.textContent = text;
+      resultDate.classList.toggle('error', isError);
+    }
+
+    // Empty counts as 0; anything else must be a non-negative whole number.
+    function parseAmount(input, label) {
+      const raw = input.value.trim();
+      if (raw === '') return 0;
+      if (!/^\d+$/.test(raw)) throw new Error(`${label} must be a whole number of 0 or more.`);
+      return Number(raw);
+    }
+
+    try {
+      const Temporal = await loadTemporal();
+      startDateInput.value ||= Temporal.Now.plainDateISO().toString();
+
+      const update = () => {
+        try {
+          if (!startDateInput.value) throw new Error('Please choose a start date.');
+          const years = parseAmount(yearsInput, 'Years');
+          const months = parseAmount(monthsInput, 'Months');
+          const overflow = overflowSelect.value === 'reject' ? 'reject' : 'constrain';
+
+          // Strict parse: an invalid calendar date throws instead of being adjusted.
+          const start = Temporal.PlainDate.from(startDateInput.value, { overflow: 'reject' });
+
+          let next;
+          try {
+            next = start.add({ years, months }, { overflow });
+          } catch (e) {
+            if (!(e instanceof RangeError)) throw e;
+            throw new Error(overflow === 'reject'
+              ? `${start.toLocaleString('en-US', { dateStyle: 'long' })} plus ${years}y ${months}m lands on a day that doesn't exist in the target month. Choose "constrain" to use the last day of that month instead.`
+              : 'That duration is too large to calculate.');
+          }
+          show(next.toLocaleString('en-US', { dateStyle: 'full' }));
+        } catch (e) {
+          show(e.message, true);
+        }
+      };
+
+      for (const el of [startDateInput, yearsInput, monthsInput, overflowSelect]) {
+        el.addEventListener('input', update);
+        el.addEventListener('change', update);
+      }
+      update();
+    } catch {
+      show('Unable to load the date calculator. Please check your connection and reload.', true);
+    }
+  </script>
 </body>
 
