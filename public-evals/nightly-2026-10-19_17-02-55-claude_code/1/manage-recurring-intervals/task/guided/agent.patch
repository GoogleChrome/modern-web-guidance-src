+  <script type="module">
+    // Temporal is not available everywhere yet (e.g. Safari): load the polyfill only when needed.
+    if (typeof globalThis.Temporal === 'undefined') {
+      try {
+        const { Temporal } = await import('https://esm.sh/@js-temporal/polyfill');
+        globalThis.Temporal = Temporal;
+      } catch {
+        // Handled below: the planner reports that calculation is unavailable.
+      }
+    }
+
+    const startInput = document.getElementById('startDateInput');
+    const yearsInput = document.getElementById('yearsInput');
+    const monthsInput = document.getElementById('monthsInput');
+    const overflowSelect = document.getElementById('overflowSelect');
+    const result = document.getElementById('resultDate');
+
+    function show(text, isError = false) {
+      result.textContent = text;
+      if (isError) result.dataset.error = '';
+      else delete result.dataset.error;
+    }
+
+    function parseCount(input, name) {
+      const raw = input.value.trim();
+      if (raw === '') return 0;
+      const n = Number(raw);
+      if (!Number.isInteger(n) || n < 0) {
+        throw new RangeError(`${name} must be a whole number of 0 or more.`);
+      }
+      return n;
+    }
+
+    function update() {
+      if (typeof globalThis.Temporal === 'undefined') {
+        show('Date calculation is unavailable in this browser.', true);
+        return;
+      }
+      try {
+        if (!startInput.value) throw new RangeError('Please choose a start date.');
+        const years = parseCount(yearsInput, 'Years');
+        const months = parseCount(monthsInput, 'Months');
+        const start = Temporal.PlainDate.from(startInput.value);
+        const next = start.add({ years, months }, { overflow: overflowSelect.value });
+        show(next.toLocaleString(undefined, { dateStyle: 'full' }));
+      } catch (e) {
+        const msg = overflowSelect.value === 'reject' && e instanceof RangeError && startInput.value
+          && !/must be|choose/.test(e.message)
+          ? 'That date does not exist in the target month (e.g. Jan 31 + 1 month). Choose "constrain" to use the last day of the month instead.'
+          : e.message;
+        show(msg, true);
+      }
+    }
+
+    // Default to today's local date.
+    startInput.value = globalThis.Temporal?.Now.plainDateISO().toString() ?? new Date().toLocaleDateString('en-CA');
+    for (const el of [startInput, yearsInput, monthsInput, overflowSelect]) {
+      el.addEventListener('input', update);
+      el.addEventListener('change', update);
+    }
+    update();
+  </script>
+
