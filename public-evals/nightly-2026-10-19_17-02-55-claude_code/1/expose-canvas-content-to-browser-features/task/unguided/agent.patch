+  <script>
+    (function () {
+      var W = 320, H = 420; // logical (CSS px) size of the canvas
+      var stage = document.getElementById('cup-stage');
+      var canvas = document.getElementById('canvas');
+      var form = document.getElementById('order-form');
+      var summary = document.getElementById('order-summary');
+      var ctx = canvas.getContext('2d');
+      var supported = 'drawElementImage' in ctx;
+      var dpr = window.devicePixelRatio || 1;
+
+      function updateSummary() {
+        var data = new FormData(form);
+        var name = (data.get('name') || '').trim();
+        var syrups = data.getAll('syrup');
+        summary.textContent = (name ? name + ': ' : 'Your cup: ') + data.get('milk') +
+          (syrups.length ? ' with ' + syrups.join(' & ') + ' syrup' : ', no syrup');
+      }
+
+      function drawCup() {
+        ctx.fillStyle = 'rgba(0,0,0,0.12)';
+        ctx.beginPath();
+        ctx.ellipse(160, 408, 100, 8, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Steam
+        ctx.strokeStyle = '#d7ccc8';
+        ctx.lineWidth = 5;
+        ctx.lineCap = 'round';
+        [100, 150, 200].forEach(function (x) {
+          ctx.beginPath();
+          ctx.moveTo(x, 70);
+          ctx.bezierCurveTo(x - 14, 55, x + 14, 40, x, 22);
+          ctx.stroke();
+        });
+
+        // Handle
+        ctx.strokeStyle = '#4e342e';
+        ctx.lineWidth = 14;
+        ctx.beginPath();
+        ctx.moveTo(268, 150);
+        ctx.bezierCurveTo(325, 150, 325, 300, 252, 305);
+        ctx.stroke();
+
+        // Body
+        ctx.beginPath();
+        ctx.moveTo(40, 90);
+        ctx.lineTo(280, 90);
+        ctx.lineTo(250, 385);
+        ctx.quadraticCurveTo(248, 400, 232, 400);
+        ctx.lineTo(88, 400);
+        ctx.quadraticCurveTo(72, 400, 70, 385);
+        ctx.closePath();
+        ctx.fillStyle = '#fff8f0';
+        ctx.fill();
+        ctx.lineWidth = 4;
+        ctx.strokeStyle = '#4e342e';
+        ctx.lineJoin = 'round';
+        ctx.stroke();
+
+        // Rim and coffee
+        ctx.fillStyle = '#4e342e';
+        ctx.fillRect(34, 84, 252, 12);
+        ctx.fillStyle = '#ffab40';
+        ctx.fillRect(48, 96, 224, 6);
+      }
+
+      function paint() {
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.scale(canvas.width / W, canvas.height / H);
+        drawCup();
+        if (supported) {
+          // Paint the live form and sync its transform so input hit-testing,
+          // focus rings and find-in-page highlights land exactly on the drawing.
+          var t = ctx.drawElementImage(form, 70, 120);
+          if (t) form.style.transform = t.toString();
+        }
+      }
+
+      // Back the canvas with one bitmap pixel per device pixel to avoid blur.
+      function resize() {
+        dpr = window.devicePixelRatio || 1;
+        canvas.width = Math.round(W * dpr);
+        canvas.height = Math.round(H * dpr);
+        paint();
+      }
+
+      if (supported) {
+        // Re-paint whenever the browser says the children's rendering changed.
+        canvas.onpaint = paint;
+      } else {
+        // No DOM-in-canvas support: overlay the same form at the same coordinates.
+        stage.classList.add('overlay');
+        stage.appendChild(form);
+      }
+
+      form.addEventListener('input', updateSummary);
+      form.addEventListener('submit', function (e) { e.preventDefault(); });
+      window.addEventListener('resize', resize); // fires on zoom / moving between displays
+      updateSummary();
+      resize();
+    })();
+  </script>
