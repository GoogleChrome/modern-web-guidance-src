+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const form = canvas.querySelector('.order-form');
+      const stage = canvas.parentElement;
+      const summary = document.getElementById('order-summary');
+      const ctx = canvas.getContext('2d');
+      // Layout size in CSS pixels; must match the .order-form position in CSS.
+      const FORM_X = 70;
+      const FORM_Y = 150;
+      const supported = 'content' in HTMLCanvasElement.prototype;
+
+      function drawCup() {
+        const brown = '#4e342e';
+        // Saucer
+        ctx.fillStyle = '#d7ccc8';
+        ctx.beginPath();
+        ctx.ellipse(180, 440, 160, 16, 0, 0, Math.PI * 2);
+        ctx.fill();
+        // Handle
+        ctx.strokeStyle = '#efebe9';
+        ctx.lineWidth = 18;
+        ctx.beginPath();
+        ctx.arc(325, 220, 55, -Math.PI / 2, Math.PI / 2);
+        ctx.stroke();
+        // Body
+        ctx.fillStyle = '#efebe9';
+        ctx.strokeStyle = brown;
+        ctx.lineWidth = 4;
+        ctx.beginPath();
+        ctx.moveTo(30, 110);
+        ctx.lineTo(330, 110);
+        ctx.lineTo(300, 420);
+        ctx.quadraticCurveTo(180, 450, 60, 420);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+        // Coffee surface
+        ctx.fillStyle = brown;
+        ctx.beginPath();
+        ctx.ellipse(180, 110, 150, 14, 0, 0, Math.PI * 2);
+        ctx.fill();
+        // Steam
+        ctx.strokeStyle = 'rgba(78, 52, 46, 0.35)';
+        ctx.lineWidth = 6;
+        ctx.lineCap = 'round';
+        for (const x of [130, 180, 230]) {
+          ctx.beginPath();
+          ctx.moveTo(x, 90);
+          ctx.bezierCurveTo(x - 20, 65, x + 20, 45, x, 15);
+          ctx.stroke();
+        }
+      }
+
+      function paint() {
+        ctx.reset();
+        // Draw in CSS pixels regardless of the device-pixel backing store.
+        const scale = canvas.width / 360;
+        ctx.scale(scale, scale);
+        drawCup();
+        if (supported) {
+          // The browser aligns hit testing, focus rings and the a11y tree with this position.
+          ctx.drawElementImage(form, FORM_X, FORM_Y);
+        }
+      }
+
+      function updateSummary() {
+        const data = new FormData(form);
+        const name = (data.get('name') || '').trim();
+        const syrups = data.getAll('syrup');
+        summary.textContent =
+          `${name ? name + '\u2019s' : 'Your'} latte: ${data.get('milk').toLowerCase()}` +
+          (syrups.length ? `, ${syrups.join(' & ')} syrup` : ', no syrup');
+      }
+      form.addEventListener('input', updateSummary);
+      form.addEventListener('submit', (e) => e.preventDefault());
+      updateSummary();
+
+      if (supported) {
+        canvas.onpaint = paint;
+      } else {
+        // Fallback: layer the real form over the canvas at the same coordinates.
+        stage.append(form);
+        form.removeAttribute('drawable');
+      }
+
+      // Keep the backing store at exactly one canvas pixel per device pixel.
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        if (supported) canvas.requestPaint();
+        else paint();
+      });
+      const hasDevicePixelBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, hasDevicePixelBox ? { box: 'device-pixel-content-box' } : {});
+    })();
+  </script>
+
