+  <script type="module">
+    // Temporal is not available in every browser yet; load the polyfill when missing.
+    if (typeof Temporal === 'undefined') {
+      const { Temporal: T } = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = T;
+    }
+
+    const valueEl = document.getElementById('temporal-value');
+    const refChangedEl = document.getElementById('temporal-ref-changed');
+    const renderCountEl = document.getElementById('temporal-render-count');
+
+    let state = { deadline: Temporal.PlainDate.from('2026-12-01') };
+    let renderCount = 0;
+    let refChanged = false;
+
+    function render() {
+      renderCount++;
+      valueEl.textContent = state.deadline.toString();
+      refChangedEl.textContent = refChanged ? 'Yes' : 'No';
+      renderCountEl.textContent = String(renderCount);
+    }
+
+    function setState(next) {
+      refChanged = next.deadline !== state.deadline;
+      state = next;
+      render();
+    }
+
+    document.getElementById('extend-temporal-btn').addEventListener('click', () => {
+      // PlainDate is immutable: add() returns a new instance, and the state object is replaced.
+      setState({ ...state, deadline: state.deadline.add({ weeks: 1 }) });
+    });
+
+    render();
+  </script>
+
 </body>
 
