+    /* Toast notifications
+       Each toast is its own popover="manual" element, so it is promoted to the
+       browser's top layer (above everything, no z-index needed) and never
+       light-dismisses or blocks interaction with the page. */
+    .toast {
+      position: fixed;
+      inset: auto 1rem 1rem auto;
+      margin: 0;
+      width: min(20rem, calc(100vw - 2rem));
+      padding: 0.85rem 0.85rem 0.85rem 1rem;
+      border: 0;
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+      display: none;
+      align-items: center;
+      gap: 0.75rem;
+
+      /* Exit state (also the state we transition back to on close) */
+      opacity: 0;
+      translate: 110% 0;
+      transition:
+        opacity 0.3s ease,
+        translate 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
+        display 0.35s allow-discrete,
+        overlay 0.35s allow-discrete;
+    }
+
+    .toast:is(:popover-open, .\:popover-open) {
+      display: flex;
+      opacity: 1;
+      translate: 0 0;
+    }
+
+    @starting-style {
+      .toast:is(:popover-open, .\:popover-open) {
+        opacity: 0;
+        translate: 110% 0;
+      }
+    }
+
+    /* Pure-CSS stacking: every toast is an anchor named --toast and also
+       anchors itself to --toast. An element can only anchor to elements
+       earlier in the top layer, and the last such match wins, so each toast
+       resolves to the toast shown just before it and sits on top of it.
+       The first toast has no valid anchor and uses the fallback offset. */
+    @supports (anchor-name: --toast) {
+      .toast {
+        anchor-name: --toast;
+        position-anchor: --toast;
+        position-visibility: always;
+        bottom: anchor(top, 0.25rem);
+        margin-bottom: 0.75rem;
+      }
+    }
+
