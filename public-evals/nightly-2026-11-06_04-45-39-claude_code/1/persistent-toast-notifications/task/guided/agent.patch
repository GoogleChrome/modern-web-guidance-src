+  <!-- Screen-reader announcements for toasts (visually hidden, not a layout container) -->
+  <div id="toast-announcer" class="visually-hidden" aria-live="polite"></div>
+
+  <template id="toast-template">
+    <div class="toast" popover="manual">
+      <div class="toast-body">
+        <span class="toast-title">Added to cart!</span>
+        <span class="toast-item"></span>
+      </div>
+      <button type="button" class="toast-close" popovertargetaction="hide" aria-label="Dismiss notification">&times;</button>
+    </div>
+  </template>
+
+  <script type="module">
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    const TOAST_DURATION = 3000;
+    const template = document.getElementById("toast-template");
+    const announcer = document.getElementById("toast-announcer");
+    let toastCount = 0;
+
+    function showToast(item) {
+      const toast = template.content.firstElementChild.cloneNode(true);
+      toast.id = `toast-${++toastCount}`;
+      toast.querySelector(".toast-item").textContent = item;
+      toast.querySelector(".toast-close").setAttribute("popovertarget", toast.id);
+
+      let timer;
+      const startTimer = () => {
+        clearTimeout(timer);
+        timer = setTimeout(() => toast.hidePopover(), TOAST_DURATION);
+      };
+      // Pause auto-dismiss while the user hovers or focuses the toast
+      toast.addEventListener("pointerenter", () => clearTimeout(timer));
+      toast.addEventListener("pointerleave", startTimer);
+      toast.addEventListener("focusin", () => clearTimeout(timer));
+      toast.addEventListener("focusout", startTimer);
+
+      toast.addEventListener("toggle", (event) => {
+        if (event.newState !== "closed") return;
+        clearTimeout(timer);
+        // Remove from the DOM once the exit transition has finished
+        Promise.allSettled(toast.getAnimations().map((a) => a.finished))
+          .then(() => toast.remove());
+      });
+
+      document.body.append(toast);
+      toast.showPopover();
+      startTimer();
+
+      announcer.textContent = "";
+      requestAnimationFrame(() => {
+        announcer.textContent = `Added to cart: ${item}`;
+      });
+    }
+
+    document.addEventListener("click", (event) => {
+      const trigger = event.target.closest(".toast-trigger");
+      if (trigger) showToast(trigger.dataset.item ?? "");
+    });
+  </script>
+
