+    /* Toast notifications
+       - popover="manual" promotes each toast to the browser's top layer,
+         so it renders above everything (including the sticky nav) with no z-index.
+       - Every toast is both an anchor (--toast) and anchored to --toast. An element
+         can only anchor to elements laid out before it, so each toast resolves to
+         the previous visible toast and stacks itself on top of it. The first toast
+         falls back to the viewport edge. Hidden toasts drop out of the chain, so
+         the stack reflows automatically in pure CSS. */
+    .toast {
+      anchor-name: --toast;
+      position-anchor: --toast;
+      position: fixed;
+      inset: auto;
+      right: 1.25rem;
+      bottom: calc(anchor(top, 0.25rem) + 0.75rem);
+      margin: 0;
+      width: min(320px, calc(100vw - 2.5rem));
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      padding: 0.85rem 0.85rem 0.85rem 1rem;
+      border: none;
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+      overflow: hidden;
+
+      /* exit state (also used while closing) */
+      opacity: 0;
+      translate: 110% 0;
+      transition:
+        opacity 0.3s ease,
+        translate 0.35s cubic-bezier(0.22, 1, 0.36, 1),
+        bottom 0.3s ease,
+        overlay 0.35s allow-discrete,
+        display 0.35s allow-discrete;
+    }
+
+    .toast:not(:popover-open) {
