+  <script type="module">
+    // Pickup time and anniversary are location-agnostic wall-clock values, so they are
+    // modeled with Temporal Plain types (no time zone, no instant) and stored as the
+    // ISO strings the inputs produce ("08:30", "2021-04-12"). Never via Date, which
+    // would reinterpret them in the viewer's current time zone.
+    if (typeof Temporal === 'undefined') {
+      const mod = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    const STORAGE_KEY = 'dailyGrind.reminders';
+    const form = document.getElementById('prefs-form');
+    const timeInput = document.getElementById('pickup-time');
+    const dateInput = document.getElementById('anniversary-date');
+    const summary = document.getElementById('prefs-summary');
+
+    function load() {
+      try {
+        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? 'null');
+        if (!saved) return null;
+        return {
+          pickupTime: Temporal.PlainTime.from(saved.pickupTime),
+          anniversary: Temporal.PlainDate.from(saved.anniversary),
+        };
+      } catch {
+        return null;
+      }
+    }
+
+    function nextAnniversary(anniversary, today) {
+      const monthDay = anniversary.toPlainMonthDay();
+      // toPlainDate clamps Feb 29 to Feb 28 in non-leap years.
+      let next = monthDay.toPlainDate({ year: today.year });
+      if (Temporal.PlainDate.compare(next, today) < 0) {
+        next = monthDay.toPlainDate({ year: today.year + 1 });
+      }
+      return next;
+    }
+
+    function render(prefs) {
+      if (!prefs) {
+        summary.textContent = '';
+        return;
+      }
+      const { pickupTime, anniversary } = prefs;
+      timeInput.value = pickupTime.toString({ smallestUnit: 'minute' });
+      dateInput.value = anniversary.toString();
+
+      const today = Temporal.Now.plainDateISO();
+      const next = nextAnniversary(anniversary, today);
+      const daysUntil = today.until(next, { largestUnit: 'day' }).days;
+      const years = next.year - anniversary.year;
+
+      const timeText = pickupTime.toLocaleString(undefined, { hour: 'numeric', minute: '2-digit' });
+      const dateText = anniversary.toLocaleString(undefined, { dateStyle: 'long' });
+      const countdown = years <= 0
+        ? ''
+        : daysUntil === 0
+          ? ` Happy ${years}-year coffee anniversary today! ☕`
+          : ` Your ${years}-year anniversary is in ${daysUntil} day${daysUntil === 1 ? '' : 's'}.`;
+
+      summary.textContent = `Pickup reminder set for ${timeText} every day. Coffee anniversary: ${dateText}.${countdown}`;
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!form.reportValidity()) return;
+      const prefs = {
+        pickupTime: Temporal.PlainTime.from(timeInput.value),
+        anniversary: Temporal.PlainDate.from(dateInput.value),
+      };
+      localStorage.setItem(STORAGE_KEY, JSON.stringify({
+        pickupTime: prefs.pickupTime.toString({ smallestUnit: 'minute' }),
+        anniversary: prefs.anniversary.toString(),
+      }));
+      render(prefs);
+    });
+
+    render(load());
+  </script>
+
