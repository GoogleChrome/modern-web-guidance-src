+  <script>
+    /*
+     * Location-agnostic preferences.
+     *
+     * Both values are stored and handled as plain wall-clock strings
+     * ("HH:MM" and "YYYY-MM-DD") — the exact strings the native inputs
+     * produce. They are deliberately NEVER passed through Date parsing,
+     * toISOString(), valueAsDate/valueAsNumber, or any UTC/offset math,
+     * since those would silently shift the value when the device's time
+     * zone changes (e.g. new Date("2024-05-10") is UTC midnight and renders
+     * as May 9 west of Greenwich). A 7:30 reminder stays 7:30 wherever
+     * you are, and an anniversary stays on the same calendar day.
+     */
+    (function () {
+      var STORAGE_KEY = 'dailyGrind.preferences.v1';
+      var TIME_RE = /^([01]\d|2[0-3]):([0-5]\d)$/;
+      var DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+      var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
+        'August', 'September', 'October', 'November', 'December'];
+
+      var timeInput = document.getElementById('pickup-time');
+      var dateInput = document.getElementById('coffee-anniversary');
+      var timeDisplay = document.getElementById('pickup-time-display');
+      var dateDisplay = document.getElementById('coffee-anniversary-display');
+      var status = document.getElementById('prefs-status');
+
+      function normalizeTime(value) {
+        if (typeof value !== 'string') return '';
+        // Some browsers emit "HH:MM:SS"; keep only hours and minutes.
+        var v = value.slice(0, 5);
+        return TIME_RE.test(v) ? v : '';
+      }
+
+      function isLeap(y) { return (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0; }
+
+      function daysInMonth(y, m) {
+        return [31, isLeap(y) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m - 1];
+      }
+
+      function parseDate(value) {
+        var m = typeof value === 'string' && DATE_RE.exec(value);
+        if (!m) return null;
+        var y = +m[1], mo = +m[2], d = +m[3];
+        if (mo < 1 || mo > 12 || d < 1 || d > daysInMonth(y, mo)) return null;
+        return { y: y, m: mo, d: d };
+      }
+
+      function normalizeDate(value) {
+        return parseDate(value) ? value : '';
+      }
+
+      function formatTime(value) {
+        var m = TIME_RE.exec(value);
+        if (!m) return '';
+        var h = +m[1];
+        var suffix = h < 12 ? 'AM' : 'PM';
+        var h12 = h % 12 === 0 ? 12 : h % 12;
+        return h12 + ':' + m[2] + ' ' + suffix;
+      }
+
+      function formatDate(value) {
+        var p = parseDate(value);
+        return p ? MONTHS[p.m - 1] + ' ' + p.d + ', ' + p.y : '';
+      }
+
+      // Today's calendar date as seen on the user's current wall clock.
+      function today() {
+        var now = new Date();
+        return { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
+      }
+
+      function cmp(a, b) {
+        return (a.y - b.y) || (a.m - b.m) || (a.d - b.d);
+      }
+
+      // Pure calendar arithmetic — no millisecond/time-zone math involved.
+      function anniversaryInfo(value) {
+        var p = parseDate(value);
+        if (!p) return '';
+        var t = today();
+        // Feb 29 anniversaries fall on Feb 28 in non-leap years.
+        function onYear(y) {
+          return { y: y, m: p.m, d: Math.min(p.d, daysInMonth(y, p.m)) };
+        }
+        if (cmp(p, t) > 0) return 'Starts on ' + formatDate(value) + '.';
+        var next = onYear(t.y);
+        if (cmp(next, t) < 0) next = onYear(t.y + 1);
+        var years = next.y - p.y;
+        if (cmp(next, t) === 0) {
+          return years === 0 ? 'Welcome — today is day one!'
+            : 'Happy ' + years + '-year coffee anniversary! ☕';
+        }
+        return 'Next: ' + MONTHS[next.m - 1] + ' ' + next.d + ', ' + next.y +
+          ' (' + years + (years === 1 ? ' year' : ' years') + ')';
+      }
+
+      function load() {
+        try {
+          var data = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
+          return {
+            pickupTime: normalizeTime(data.pickupTime),
+            coffeeAnniversary: normalizeDate(data.coffeeAnniversary)
+          };
+        } catch (e) {
+          return { pickupTime: '', coffeeAnniversary: '' };
+        }
+      }
+
+      function save(prefs) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
+          status.textContent = 'Preferences saved.';
+        } catch (e) {
+          status.textContent = 'Could not save preferences on this device.';
+        }
+      }
+
+      function render(prefs) {
+        timeDisplay.textContent = prefs.pickupTime
+          ? 'Reminder every day at ' + formatTime(prefs.pickupTime) + ' local time, wherever you are.'
+          : 'No reminder set.';
+        dateDisplay.textContent = prefs.coffeeAnniversary
+          ? anniversaryInfo(prefs.coffeeAnniversary)
+          : 'No anniversary set.';
+      }
+
+      var prefs = load();
+      timeInput.value = prefs.pickupTime;
+      dateInput.value = prefs.coffeeAnniversary;
+      render(prefs);
+
+      function onChange() {
+        prefs = {
+          pickupTime: normalizeTime(timeInput.value),
+          coffeeAnniversary: normalizeDate(dateInput.value)
+        };
+        save(prefs);
+        render(prefs);
+      }
+
+      timeInput.addEventListener('change', onChange);
+      dateInput.addEventListener('change', onChange);
+
+      // Daily pickup reminder: compares wall-clock HH:MM against the
+      // device's current local clock, so it fires at the chosen time in
+      // whatever zone you're in.
+      var lastFired = '';
+      function checkReminder() {
+        if (!prefs.pickupTime) return;
+        var now = new Date();
+        var hhmm = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
+        var t = today();
+        var key = t.y + '-' + t.m + '-' + t.d + ' ' + prefs.pickupTime;
+        if (hhmm === prefs.pickupTime && lastFired !== key) {
+          lastFired = key;
+          var msg = "It's " + formatTime(prefs.pickupTime) + ' — time to pick up your coffee!';
+          if ('Notification' in window && Notification.permission === 'granted') {
+            new Notification('The Daily Grind', { body: msg });
+          } else {
+            status.textContent = msg;
+          }
+        }
+      }
+      timeInput.addEventListener('change', function () {
+        if ('Notification' in window && Notification.permission === 'default') {
+          Notification.requestPermission();
+        }
+      });
+      setInterval(checkReminder, 15000);
+      checkReminder();
+
+      // Re-render on return to the tab (e.g. after travelling) so the
+      // "next anniversary" text reflects the current local calendar day.
+      document.addEventListener('visibilitychange', function () {
+        if (!document.hidden) render(prefs);
+      });
+    })();
+  </script>
+
