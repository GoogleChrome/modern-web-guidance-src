diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,37 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Scroll-driven reveal: cards grow from 50% to full size as they enter
+       the viewport and shrink back as they leave. Pure CSS, progressive
+       enhancement: unsupported browsers and reduced-motion users see the
+       cards at full size with no animation. */
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: view()) and (animation-range: entry)) {
+        @keyframes card-grow {
+          from {
+            scale: 0.5;
+          }
+        }
+
+        @keyframes card-shrink {
+          to {
+            scale: 0.5;
+          }
+        }
+
+        .card {
+          animation:
+            card-grow auto linear backwards,
+            card-shrink auto linear forwards;
+          /* Must come after the shorthand, which would otherwise reset them */
+          animation-timeline: view();
+          animation-range: entry, exit;
+        }
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
