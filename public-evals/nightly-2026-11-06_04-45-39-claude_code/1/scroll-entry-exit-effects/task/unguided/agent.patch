diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,43 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /*
+     * Scroll-driven reveal (CSS only).
+     * Cards grow from 50% to 100% as they enter the viewport and shrink back
+     * as they leave. Only applied when the browser supports scroll-driven
+     * animations AND the user hasn't asked for reduced motion; otherwise the
+     * cards simply render at full size.
+     */
+    @keyframes card-reveal {
+      entry 0% {
+        scale: 0.5;
+      }
+
+      entry 100% {
+        scale: 1;
+      }
+
+      exit 0% {
+        scale: 1;
+      }
+
+      exit 100% {
+        scale: 0.5;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports (animation-timeline: view()) {
+        .card {
+          animation: card-reveal linear both;
+          animation-timeline: view();
+          animation-range: entry 0% exit 100%;
+        }
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
