--- a/index.html
+++ b/index.html
@@ -26,8 +26,67 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    /* Pull-to-reveal search: the root scroller snaps between the search bar
+       and the nav; the page initially loads scrolled to the nav. */
+    html {
+      scroll-snap-type: y proximity;
+    }
+
+    .search-bar {
+      display: block;
+      scroll-snap-align: start;
+      background: var(--secondary);
+      padding: 0.75rem 5%;
+    }
+
+    .search-bar form {
+      display: flex;
+      gap: 0.5rem;
+      max-width: 700px;
+      margin: 0 auto;
+    }
+
+    .search-bar input {
+      flex: 1;
+      min-width: 0;
+      padding: 0.6rem 1rem;
+      font: inherit;
+      color: var(--text);
+      background: white;
+      border: 1px solid #bcaaa4;
+      border-radius: 999px;
+    }
+
+    .search-bar input:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 1px;
+    }
+
+    .search-bar button {
+      padding: 0.6rem 1.2rem;
+      font: inherit;
+      color: white;
+      background: var(--primary);
+      border: none;
+      border-radius: 999px;
+      cursor: pointer;
+    }
+
+    .search-bar button:hover {
+      background: #3e2723;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
