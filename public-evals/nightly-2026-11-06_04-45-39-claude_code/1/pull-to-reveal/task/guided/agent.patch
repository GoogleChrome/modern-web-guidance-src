+  <script>
+    // Fallback for browsers without scroll-initial-target (Firefox, Safari):
+    // start scrolled past the search bar so the nav sits at the top.
+    // Skip when a URL fragment or restored scroll position should win.
+    if (!CSS.supports("scroll-initial-target", "nearest") && !location.hash && window.scrollY === 0) {
+      const searchBar = document.querySelector(".search-bar");
+      window.scrollTo({ top: searchBar.offsetHeight, behavior: "instant" });
+    }
+  </script>
