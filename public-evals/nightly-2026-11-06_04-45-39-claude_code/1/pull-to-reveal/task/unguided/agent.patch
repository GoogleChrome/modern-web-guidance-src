+    /* Pull-down Search Bar */
+    :root {
+      --search-h: 64px;
+    }
+
+    body {
+      /* Guarantee enough scroll room to tuck the search bar away on short pages */
+      min-height: calc(100vh + var(--search-h));
+    }
+
+    .search-bar {
