   </footer>
 
+  <script>
+    (function () {
+      var bar = document.getElementById('search-bar');
+      var input = document.getElementById('site-search');
+      var barHeight = function () { return bar.offsetHeight; };
+
+      // Start with the search bar tucked above the viewport (scrolled to the nav),
+      // unless the URL targets a specific anchor.
+      if (!location.hash) {
+        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+        window.scrollTo(0, barHeight());
+      }
+
+      // Snap: once scrolling stops partway through the search bar, settle it
+      // fully open or fully closed depending on the last scroll direction.
+      var lastY = window.scrollY;
+      var direction = 0; // -1 = up, 1 = down
+      var touching = false;
+      var timer = null;
+
+      function snap() {
+        if (touching) return;
+        var h = barHeight();
+        var y = window.scrollY;
+        if (y <= 0 || y >= h) return;
+        var target;
+        if (direction < 0) target = 0;
+        else if (direction > 0) target = h;
+        else target = y < h / 2 ? 0 : h;
+        window.scrollTo({ top: target, behavior: 'smooth' });
+      }
+
+      window.addEventListener('scroll', function () {
+        var y = window.scrollY;
+        if (y !== lastY) direction = y < lastY ? -1 : 1;
+        lastY = y;
+        if (!('onscrollend' in window)) {
+          clearTimeout(timer);
+          timer = setTimeout(snap, 150);
+        }
+      }, { passive: true });
+
+      if ('onscrollend' in window) window.addEventListener('scrollend', snap);
+
+      window.addEventListener('touchstart', function () { touching = true; }, { passive: true });
+      window.addEventListener('touchend', function () {
+        touching = false;
+        clearTimeout(timer);
+        timer = setTimeout(snap, 150);
+      }, { passive: true });
+
+      // Reveal the search bar when its input gets focus (e.g. via Tab).
+      input.addEventListener('focus', function () {
+        window.scrollTo({ top: 0, behavior: 'smooth' });
+      });
+
+      // Press "/" anywhere to pull down the search bar and focus it.
+      document.addEventListener('keydown', function (e) {
+        var t = e.target;
+        if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
+        if (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
+        e.preventDefault();
+        input.focus({ preventScroll: true });
+        window.scrollTo({ top: 0, behavior: 'smooth' });
+      });
+    })();
+  </script>
+
 </body>
 
