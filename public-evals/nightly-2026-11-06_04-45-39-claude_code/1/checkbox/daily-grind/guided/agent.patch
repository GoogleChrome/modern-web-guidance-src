+      --checkbox-icon: var(--icon-dash);
+      background-color: var(--primary);
+    }
+
+    .checkbox-custom:is(:checked, :indeterminate)::before {
+      scale: 1;
+      rotate: 0deg;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .checkbox-custom {
+        transition: background-color 180ms ease, scale 120ms ease;
+      }
+
+      .checkbox-custom::before {
+        transition: scale 220ms cubic-bezier(0.34, 1.56, 0.64, 1), rotate 220ms ease;
+      }
+
+      .checkbox-custom:active {
+        scale: 0.88;
+      }
+    }
+
+    .checkbox-custom:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    .checkbox-custom:disabled {
+      cursor: not-allowed;
+      opacity: 0.5;
+    }
+
+    .option:has(.checkbox-custom:disabled) {
+      cursor: not-allowed;
+      opacity: 0.6;
+    }
+
+    @media (forced-colors: active) {
