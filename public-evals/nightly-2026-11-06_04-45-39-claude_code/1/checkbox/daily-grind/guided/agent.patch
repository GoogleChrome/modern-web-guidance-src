+      border-radius: 6px;
+      background-color: #fff;
+      color: var(--primary);
+      cursor: pointer;
+    }
+
+    .checkbox-custom::before {
+      content: "";
+      inline-size: var(--checkbox-icon-size);
+      aspect-ratio: 1;
+      background-color: var(--accent);
