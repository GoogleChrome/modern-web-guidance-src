+
+    /* ===== Drink customization checkboxes ===== */
+    .customize {
+      border: 0;
+      margin: 18px 0 4px;
+      padding: 14px 0 0;
+      border-top: 1px dashed var(--secondary);
+      text-align: left;
+      min-width: 0;
+    }
+
+    .customize legend {
+      float: left;
+      width: 100%;
+      margin-bottom: 8px;
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.12em;
+      text-transform: uppercase;
+      color: #8d6e63;
+    }
+
+    .customize legend + * {
+      clear: both;
+    }
+
+    .options {
+      list-style: none;
+      display: grid;
+      gap: 6px;
+    }
+
+    .option {
+      position: relative;
+      display: grid;
+      grid-template-columns: 22px 28px 1fr auto;
+      align-items: center;
+      gap: 10px;
+      padding: 8px 10px;
+      border: 1px solid transparent;
+      border-radius: 8px;
+      background: #f7f2ef;
+      cursor: pointer;
+      user-select: none;
+      transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.15s ease;
+    }
+
+    .option:hover {
+      background: #efe5e0;
+      border-color: var(--secondary);
+    }
+
+    .option:active {
+      transform: scale(0.985);
+    }
+
+    /* The real checkbox: visually hidden but still in the accessibility tree,
+       focusable, and clickable (sits on top of the custom box). */
+    .option input[type="checkbox"] {
+      position: absolute;
+      left: 10px;
+      top: 50%;
+      width: 22px;
+      height: 22px;
+      margin: -11px 0 0;
+      opacity: 0;
+      cursor: pointer;
+      z-index: 1;
+    }
+
+    .option .box {
+      grid-column: 1;
+      width: 22px;
+      height: 22px;
+      display: grid;
+      place-items: center;
+      border: 2px solid #a1887f;
+      border-radius: 6px;
+      background: white;
+      color: white;
+      transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.2s ease;
+    }
+
+    .option .box svg {
+      width: 14px;
+      height: 14px;
+      fill: none;
+      stroke: currentColor;
+      stroke-width: 3;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+    }
+
+    .option .box polyline {
+      stroke-dasharray: 20;
+      stroke-dashoffset: 20;
+      transition: stroke-dashoffset 0.2s ease;
+    }
+
+    .option .icon {
+      grid-column: 2;
+      width: 28px;
+      height: 28px;
+      display: grid;
+      place-items: center;
+      border-radius: 50%;
+      background: var(--secondary);
+      color: var(--primary);
+      transition: background-color 0.25s ease, color 0.25s ease, transform 0.3s ease;
+    }
+
+    .option .icon svg {
+      width: 16px;
+      height: 16px;
+      fill: none;
+      stroke: currentColor;
+      stroke-width: 1.8;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+    }
+
+    .option .name {
+      font-size: 0.9rem;
+      line-height: 1.3;
+      color: var(--text);
+    }
+
+    .option .price {
+      font-size: 0.8rem;
+      font-weight: 600;
+      color: #8d6e63;
+      transition: color 0.25s ease;
+    }
+
+    /* Checked state */
+    .option input:checked ~ .box {
+      background: var(--primary);
+      border-color: var(--primary);
+      animation: box-pop 0.3s ease;
+    }
+
+    .option input:checked ~ .box polyline {
+      stroke-dashoffset: 0;
+      transition-delay: 0.08s;
+    }
+
+    .option input:checked ~ .icon {
+      background: var(--accent);
+      color: var(--text);
+      transform: rotate(-12deg) scale(1.08);
+    }
+
+    .option input:checked ~ .price {
+      color: var(--primary);
+    }
+
+    .option:has(input:checked) {
+      background: #fff3e0;
+      border-color: var(--accent);
+    }
+
+    /* Uncheck animation (only after user interaction, see .touched) */
+    .option.touched input:not(:checked) ~ .box {
+      animation: box-release 0.3s ease;
+    }
+
+    /* Keyboard focus */
+    .option input:focus-visible ~ .box {
+      box-shadow: 0 0 0 3px var(--light), 0 0 0 5px var(--accent);
+    }
+
+    .option:has(input:focus-visible) {
+      border-color: var(--primary);
+    }
+
+    /* Disabled */
+    .option input:disabled,
+    .option:has(input:disabled) {
+      cursor: not-allowed;
+    }
+
+    .option input:disabled ~ * {
+      opacity: 0.5;
+    }
+
+    @keyframes box-pop {
+      0% { transform: scale(1); }
+      40% { transform: scale(0.8); }
+      70% { transform: scale(1.15); }
+      100% { transform: scale(1); }
+    }
+
+    @keyframes box-release {
+      0% { transform: scale(1); }
+      40% { transform: scale(0.85); }
+      100% { transform: scale(1); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .option,
+      .option *,
+      .option .box polyline {
+        animation: none !important;
+        transition: none !important;
+      }
+
+      .option input:checked ~ .icon {
+        transform: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .option {
+        border-color: CanvasText;
+      }
+
+      .option .box {
+        border-color: ButtonText;
+        background: Canvas;
+        color: Canvas;
+      }
+
+      .option input:checked ~ .box {
+        background: Highlight;
+        border-color: Highlight;
+        color: HighlightText;
+      }
+
+      .option input:focus-visible ~ .box {
+        outline: 2px solid Highlight;
+        outline-offset: 2px;
+      }
+
+      .option .icon {
+        border: 1px solid CanvasText;
+      }
+    }
   </style>
