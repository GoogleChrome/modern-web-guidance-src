+  <script>
+    // Enables the uncheck animation only after a user toggles an option,
+    // so pre-unchecked boxes don't animate on page load.
+    document.querySelectorAll('.option input[type="checkbox"]').forEach(function (input) {
+      input.addEventListener('change', function () {
+        input.closest('.option').classList.add('touched');
+      });
+    });
+  </script>
