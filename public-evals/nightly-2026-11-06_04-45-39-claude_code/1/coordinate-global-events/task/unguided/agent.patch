+  <script type="module">
+    // Global Tasting Coordinator — built on the TC39 Temporal API.
+    // Uses the browser's native Temporal; only falls back to the reference polyfill
+    // on browsers that haven't shipped it yet. The legacy Date object is never used.
+    const nativeTemporal = globalThis.Temporal;
+    const isModernTemporal = (T) => !!T && 'timeZoneId' in T.ZonedDateTime.prototype;
+    const Temporal = isModernTemporal(nativeTemporal)
+      ? nativeTemporal
+      : (await import('https://esm.sh/@js-temporal/polyfill@0.5.1')).Temporal;
+
+    const TARGET_ZONES = Object.freeze([
+      Object.freeze({ id: 'America/New_York', label: 'New York' }),
+      Object.freeze({ id: 'Europe/London', label: 'London' }),
+      Object.freeze({ id: 'Asia/Tokyo', label: 'Tokyo' }),
+      Object.freeze({ id: 'UTC', label: 'UTC' }),
+    ]);
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const hostWarning = document.getElementById('hostWarning');
+
+    // Intl may emit a narrow no-break space before AM/PM; normalise to a plain space.
+    const clean = (str) => str.replace(/[\u202F\u00A0]/g, " ");
+
+    // Format via Intl using the zone id + epoch milliseconds so output is consistent
+    // across every Temporal implementation (no legacy Date involved).
+    const fmt = (zdt, options) =>
+      clean(new Intl.DateTimeFormat('en-US', { ...options, timeZone: zdt.timeZoneId }).format(zdt.epochMilliseconds));
+
+    // Plain (zone-less) values are formatted by pinning them to UTC purely for display.
+    const asUtc = (plain) => (plain instanceof Temporal.PlainDate ? plain.toPlainDateTime() : plain).toZonedDateTime('UTC');
+
+    const TIME_OPTS = Object.freeze({ hour: 'numeric', minute: '2-digit' });
+    const DATE_OPTS = Object.freeze({ weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
+
+    const formatTime = (zdt) => fmt(zdt, TIME_OPTS);
+    const formatPlainTime = (pdt) => fmt(asUtc(pdt), TIME_OPTS);
+    const formatDate = (value) => fmt(value instanceof Temporal.ZonedDateTime ? value : asUtc(value), DATE_OPTS);
+
+    // Short zone name (e.g. "EST", "GMT+9") from the instant's epoch milliseconds.
+    const zoneAbbr = (zdt) => {
+      const parts = new Intl.DateTimeFormat('en-US', { timeZone: zdt.timeZoneId, timeZoneName: 'short' })
+        .formatToParts(zdt.epochMilliseconds);
+      return parts.find((p) => p.type === 'timeZoneName')?.value ?? zdt.timeZoneId;
+    };
+
+    const describeZone = (zdt) => `${zoneAbbr(zdt)}, UTC${zdt.offset === '+00:00' ? '' : zdt.offset}`;
+
+    const humanDuration = (duration) => {
+      const d = duration.round({ largestUnit: 'hour', smallestUnit: 'minute' });
+      const bits = [];
+      if (d.hours) bits.push(`${Math.abs(d.hours)} hour${Math.abs(d.hours) === 1 ? '' : 's'}`);
+      if (d.minutes) bits.push(`${Math.abs(d.minutes)} minute${Math.abs(d.minutes) === 1 ? '' : 's'}`);
+      return bits.join(' ') || '0 minutes';
+    };
+
+    const zoneLabel = (tz) => TARGET_ZONES.find((z) => z.id === tz)?.label ?? tz;
+
+    /**
+     * Resolve a wall-clock date/time in a zone and detect DST gaps/overlaps.
+     * Returns a frozen record; every Temporal object in it is itself immutable —
+     * all derived values come from methods that return new instances.
+     */
+    function resolveHostTime(plainDateTime, timeZone) {
+      const resolved = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'compatible' });
+      const earlier = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'earlier' });
+      const later = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'later' });
+
+      const isGap = !resolved.toPlainDateTime().equals(plainDateTime);
+      const isOverlap = !isGap && earlier.offsetNanoseconds !== later.offsetNanoseconds;
+
+      let kind = 'none';
+      if (isGap) kind = 'gap';
+      else if (isOverlap) kind = 'overlap';
+
+      return Object.freeze({ kind, requested: plainDateTime, timeZone, resolved, earlier, later });
+    }
+
+    function explainConflict(result) {
+      const { kind, requested, timeZone, resolved, earlier, later } = result;
+      const place = zoneLabel(timeZone);
+      const when = `${formatPlainTime(requested)} on ${formatDate(requested.toPlainDate())}`;
+
+      if (kind === 'gap') {
+        // Clocks sprang forward: the requested wall time was skipped entirely.
+        const shift = requested.until(resolved.toPlainDateTime());
+        const transition = resolved.getTimeZoneTransition?.('previous');
+        let jump = '';
+        if (transition) {
+          const after = transition.toPlainDateTime();
+          const before = after.subtract(shift);
+          jump = ` Clocks jump forward from ${formatPlainTime(before)} straight to ${formatPlainTime(after)}` +
+            ` (${describeZone(transition.subtract({ nanoseconds: 1 }))}` +
+            ` → ${describeZone(transition)}).`;
+        }
+        return `<strong>Daylight saving gap:</strong> ${when} does not exist in ${place}.${jump} ` +
+          `The time was resolved by moving forward by the length of the gap (${humanDuration(shift)}) to ` +
+          `<strong>${formatTime(resolved)} ${zoneAbbr(resolved)}</strong>, i.e. the exact moment ` +
+          `${formatPlainTime(requested)} would have been under the old offset. All times below use this resolved moment.`;
+      }
+
+      if (kind === 'overlap') {
+        // Clocks fell back: the requested wall time happens twice.
+        const between = earlier.until(later);
+        return `<strong>Daylight saving overlap:</strong> ${when} occurs twice in ${place} because clocks ` +
+          `fall back by ${humanDuration(between)}. The first occurrence ` +
+          `(<strong>${formatTime(earlier)} ${describeZone(earlier)}</strong>) was used; ` +
+          `the second occurrence would be ${formatTime(later)} ${describeZone(later)}, ` +
+          `${humanDuration(between)} later. All times below use the first occurrence.`;
+      }
+
+      return '';
+    }
+
+    function renderCard(zone, zdt, hostZdt, hostTz) {
+      const card = document.createElement('div');
+      card.className = 'tz-card';
+      card.dataset.tz = zone.id;
+      if (zone.id === hostTz) card.classList.add('is-host');
+
+      const title = document.createElement('h3');
+      title.textContent = zone.label;
+
+      const time = document.createElement('div');
+      time.className = 'tz-time';
+      time.textContent = formatTime(zdt);
+
+      const date = document.createElement('div');
+      date.className = 'tz-date';
+      date.textContent = formatDate(zdt);
+
+      const tzInfo = document.createElement('div');
+      tzInfo.className = 'tz-zone';
+      tzInfo.textContent = describeZone(zdt);
+
+      card.append(title, time, date, tzInfo);
+
+      const dayDiff = hostZdt.toPlainDate().until(zdt.toPlainDate(), { largestUnit: 'day' }).days;
+      if (dayDiff !== 0) {
+        const shift = document.createElement('span');
+        shift.className = 'tz-shift';
+        shift.textContent = `${dayDiff > 0 ? '+' : '−'}${Math.abs(dayDiff)} day${Math.abs(dayDiff) === 1 ? '' : 's'} vs. host`;
+        card.append(shift);
+      }
+
+      if (zone.id === hostTz) {
+        const badge = document.createElement('span');
+        badge.className = 'tz-host-badge';
+        badge.textContent = 'HOST';
+        card.append(document.createElement('br'), badge);
+      }
+
+      return card;
+    }
+
+    function showWarning(html) {
+      if (html) {
+        hostWarning.innerHTML = html;
+        hostWarning.hidden = false;
+      } else {
+        hostWarning.textContent = '';
+        hostWarning.hidden = true;
+      }
+    }
+
+    function update() {
+      const hostTz = hostTzSelect.value;
+      let plainDateTime;
+      try {
+        plainDateTime = Temporal.PlainDate.from(dateInput.value)
+          .toPlainDateTime(Temporal.PlainTime.from(timeInput.value));
+      } catch {
+        showWarning('');
+        grid.replaceChildren(Object.assign(document.createElement('p'), {
+          className: 'planner-status',
+          textContent: 'Please choose a valid date and time.',
+        }));
+        return;
+      }
+
+      const result = resolveHostTime(plainDateTime, hostTz);
+      showWarning(explainConflict(result));
+
+      // withTimeZone() returns a brand-new ZonedDateTime for the same instant;
+      // the host object is never modified.
+      const cards = TARGET_ZONES.map((zone) =>
+        renderCard(zone, result.resolved.withTimeZone(zone.id), result.resolved, hostTz));
+      grid.replaceChildren(...cards);
+    }
+
+    // Defaults: today's date in the visitor's zone, host zone matching the visitor if listed.
+    const visitorTz = Temporal.Now.timeZoneId();
+    if ([...hostTzSelect.options].some((o) => o.value === visitorTz)) hostTzSelect.value = visitorTz;
+    if (!dateInput.value) dateInput.value = Temporal.Now.plainDateISO(hostTzSelect.value).toString();
+    if (!timeInput.value) timeInput.value = '10:00';
+
+    for (const el of [dateInput, timeInput, hostTzSelect]) {
+      el.addEventListener('input', update);
+      el.addEventListener('change', update);
+    }
+
+    update();
+  </script>
+
 </body>
 
