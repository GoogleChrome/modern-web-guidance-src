+  <script type="module">
+    // Load a Temporal polyfill only for browsers without native support (e.g. Safari).
+    if (typeof Temporal === 'undefined') {
+      const mod = await import('https://esm.sh/temporal-polyfill@0.3.0');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    const ZONES = [
+      { id: 'America/New_York', label: 'New York' },
+      { id: 'Europe/London', label: 'London' },
+      { id: 'Asia/Tokyo', label: 'Tokyo' },
+      { id: 'UTC', label: 'UTC' },
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const hostWarning = document.getElementById('hostWarning');
+
+    // Default to today's date in the visitor's own time zone.
+    if (!dateInput.value) dateInput.value = Temporal.Now.plainDateISO().toString();
+
+    const timeFmt = { hour: 'numeric', minute: '2-digit' };
+    const dateFmt = { weekday: 'short', month: 'short', day: 'numeric' };
+    // Format in the ZonedDateTime's own zone via Intl with an explicit timeZone, so output is
+    // identical across native Temporal implementations and the polyfill.
+    const fmt = (zdt, timeZone, opts) =>
+      new Intl.DateTimeFormat('en-US', { ...opts, timeZone }).format(zdt.epochMilliseconds);
+    const fmtTime = (zdt, tz) => fmt(zdt, tz, timeFmt);
+    const fmtDate = (zdt, tz) => fmt(zdt, tz, dateFmt);
+
+    /**
+     * Inspect a wall-clock time in a zone for DST conflicts.
+     * Returns null when the time maps to exactly one instant, otherwise
+     * { kind: 'gap' | 'overlap', earlier, later } as immutable ZonedDateTimes.
+     */
+    function detectConflict(plainDateTime, timeZone) {
+      try {
+        plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'reject' });
+        return null;
+      } catch (err) {
+        if (!(err instanceof RangeError)) throw err;
+      }
+      const earlier = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'earlier' });
+      const later = plainDateTime.toZonedDateTime(timeZone, { disambiguation: 'later' });
+      // In an overlap, both candidates keep the requested wall-clock time (with different offsets).
+      // In a gap, neither does — the requested wall-clock time simply never occurs.
+      const isOverlap = earlier.toPlainDateTime().equals(plainDateTime) && later.toPlainDateTime().equals(plainDateTime);
+      return { kind: isOverlap ? 'overlap' : 'gap', earlier, later };
+    }
+
+    function showWarning(conflict, requested, resolved, tz, zoneLabel) {
+      if (!conflict) {
+        hostWarning.hidden = true;
+        hostWarning.textContent = '';
+        return;
+      }
+      const reqTime = fmt(requested.toZonedDateTime('UTC'), 'UTC', timeFmt);
+      if (conflict.kind === 'gap') {
+        const skipped = conflict.earlier.until(conflict.later).total('minutes');
+        hostWarning.textContent =
+          `Heads up: ${reqTime} doesn't exist in ${zoneLabel} on ${fmtDate(resolved, tz)} — clocks spring forward ` +
+          `for daylight saving time, skipping ${skipped} minutes. We moved the tasting forward by that amount ` +
+          `to ${fmtTime(resolved, tz)} (UTC${resolved.offset}), the first moment that wall-clock time is reached.`;
+      } else {
+        hostWarning.textContent =
+          `Heads up: ${reqTime} happens twice in ${zoneLabel} on ${fmtDate(resolved, tz)} because clocks fall back ` +
+          `at the end of daylight saving time. We scheduled the tasting for the first occurrence ` +
+          `(UTC${conflict.earlier.offset}, before the change) rather than the second (UTC${conflict.later.offset}).`;
+      }
+      hostWarning.hidden = false;
+    }
+
+    function renderCard(zone, zdt, hostZdt, hostTz) {
+      const card = document.createElement('article');
+      card.className = 'card tz-card';
+      if (zone.id === hostTz) card.classList.add('is-host');
+
+      const h3 = document.createElement('h3');
+      h3.textContent = zone.label;
+
+      const time = document.createElement('time');
+      time.className = 'tz-time';
+      time.dateTime = zdt.toInstant().toString();
+      time.textContent = fmtTime(zdt, zone.id);
+
+      const dayDiff = Temporal.PlainDate.compare(zdt.toPlainDate(), hostZdt.toPlainDate());
+      const meta = document.createElement('p');
+      meta.className = 'tz-meta';
+      meta.textContent = `${fmtDate(zdt, zone.id)} · UTC${zdt.offset}` +
+        (dayDiff > 0 ? ' · next day' : dayDiff < 0 ? ' · previous day' : '') +
+        (zone.id === hostTz ? ' · host' : '');
+
+      card.append(h3, time, meta);
+      return card;
+    }
+
+    function update() {
+      grid.replaceChildren();
+      if (!dateInput.value || !timeInput.value) {
+        showWarning(null);
+        return;
+      }
+
+      let requested;
+      try {
+        requested = Temporal.PlainDateTime.from(`${dateInput.value}T${timeInput.value}`);
+      } catch {
+        showWarning(null);
+        return;
+      }
+
+      const hostTz = hostTzSelect.value;
+      const hostLabel = ZONES.find((z) => z.id === hostTz)?.label ?? hostTz;
+
+      const conflict = detectConflict(requested, hostTz);
+      // 'compatible' resolves gaps forward and overlaps to the earlier instant (RFC 5545 behaviour).
+      // ZonedDateTime is immutable: every conversion below returns a new object.
+      const hostZdt = requested.toZonedDateTime(hostTz, { disambiguation: 'compatible' });
+
+      showWarning(conflict, requested, hostZdt, hostTz, hostLabel);
+
+      grid.append(...ZONES.map((zone) => renderCard(zone, hostZdt.withTimeZone(zone.id), hostZdt, hostTz)));
+    }
+
+    for (const el of [dateInput, timeInput, hostTzSelect]) {
+      el.addEventListener('input', update);
+      el.addEventListener('change', update);
+    }
+    update();
+  </script>
