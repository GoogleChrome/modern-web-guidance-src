+    /* Seasonal Favorites Carousel */
+    .carousel {
+      --item-width: min(300px, 75vw);
+      display: flex;
+      gap: 24px;
+      overflow-x: auto;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      scroll-behavior: smooth;
+      -webkit-overflow-scrolling: touch;
+      /* Vertical room so the scaled-up card and its shadow aren't clipped;
+         side padding lets the first and last cards snap to the center. */
+      padding: 40px calc(50% - var(--item-width) / 2);
+      margin-top: 20px;
+    }
+
+    .carousel:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    .carousel-item {
+      flex: 0 0 var(--item-width);
+      scroll-snap-align: center;
+      scroll-snap-stop: always;
+    }
+
+    .carousel .card {
+      height: 100%;
+      background: #e0e0e0;
+      box-shadow: none;
+      transform: scale(1);
+      transition: transform 0.3s ease, background-color 0.3s ease,
+        box-shadow 0.3s ease, color 0.3s ease;
+    }
+
+    .carousel-item.is-snapped .card {
+      transform: scale(1.15);
+      background: #007bff;
+      color: white;
+      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
+    }
+
+    .carousel-item.is-snapped .card h3 {
+      color: white;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .carousel {
+        scroll-behavior: auto;
+      }
+
+      .carousel .card,
+      .carousel .card h3 {
+        transition: none;
+      }
+
+      .carousel-item.is-snapped .card {
+        transform: none;
+      }
+    }
