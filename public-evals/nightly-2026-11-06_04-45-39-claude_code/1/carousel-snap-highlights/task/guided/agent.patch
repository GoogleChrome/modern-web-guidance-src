+    /* Seasonal Favorites carousel */
+    .carousel {
+      --item-width: min(280px, 75vw);
+      display: flex;
+      gap: 40px;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      overscroll-behavior-x: contain;
+      /* Room for the 1.15 scale + shadow, and inline padding so the first/last items can center */
+      padding: 40px calc(50% - var(--item-width) / 2);
+      margin-top: 20px;
+    }
+
+    .carousel:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 4px;
+    }
+
+    .carousel-item {
+      flex: 0 0 var(--item-width);
+      scroll-snap-align: center;
+      container-type: scroll-state;
+    }
+
+    .carousel .card {
+      height: 100%;
+      background: #e0e0e0;
+      transition:
+        scale 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
+        background-color 0.4s,
+        color 0.4s,
+        box-shadow 0.4s;
+    }
+
+    .carousel .card h3 {
+      transition: color 0.4s;
+    }
+
+    .carousel .btn:focus-visible {
+      outline: 3px solid #ffeb3b;
+      outline-offset: 3px;
+    }
+
+    /* Snapped highlight — only for users who haven't asked for reduced motion */
+    @media (prefers-reduced-motion: no-preference) {
+      @container scroll-state(snapped: x) {
+        .card {
+          background: #007bff;
+          color: white;
+          scale: 1.15;
+          box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
+        }
+
+        .card h3 {
+          color: white;
+        }
+      }
+
+      /* JS fallback (IntersectionObserver) for browsers without scroll-state queries */
+      .carousel-item.is-snapped .card {
+        background: #007bff;
+        color: white;
+        scale: 1.15;
+        box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
+      }
+
+      .carousel-item.is-snapped .card h3 {
+        color: white;
+      }
+    }
+
+    /* Reduced motion: keep the cards completely static */
+    @media (prefers-reduced-motion: reduce) {
+      .carousel .card,
+      .carousel .card h3 {
+        transition: none !important;
+        scale: 1 !important;
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
