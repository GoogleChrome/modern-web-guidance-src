diff --git a/drink-card.js b/drink-card.js
new file mode 100644
index 0000000..ad37187
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,82 @@
+// <drink-card> — hydrates a server-rendered (Declarative Shadow DOM) card in place.
+// The shadow tree, styles and favorite button all ship in the HTML, so this script
+// only attaches behavior; it never re-renders the markup.
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]'));
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorites(set) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
+  } catch {
+    /* storage unavailable (private mode, quota) — keep in-memory state only */
+  }
+}
+
+class DrinkCard extends HTMLElement {
+  #button;
+
+  constructor() {
+    super();
+
+    // Fallback for engines that don't parse `shadowrootmode`: the template is left
+    // inert as a child, so attach the shadow root from that same server markup.
+    if (!this.shadowRoot) {
+      const template = this.querySelector(':scope > template[shadowrootmode]');
+      if (template) {
+        this.attachShadow({ mode: 'open' }).append(template.content);
+        template.remove();
+      }
+    }
+
+    // Hydrate in place: wire up the existing server-rendered button once.
+    this.#button = this.shadowRoot?.querySelector('.fav') ?? null;
+    this.#button?.addEventListener('click', () => this.toggleFavorite());
+  }
+
+  connectedCallback() {
+    // Sync persisted state onto the existing markup (attribute update only).
+    const id = this.getAttribute('drink-id');
+    if (id) this.#setPressed(readFavorites().has(id));
+  }
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  toggleFavorite() {
+    const next = !this.favorite;
+    this.#setPressed(next);
+
+    const id = this.getAttribute('drink-id');
+    if (id) {
+      const favorites = readFavorites();
+      next ? favorites.add(id) : favorites.delete(id);
+      writeFavorites(favorites);
+    }
+
+    this.dispatchEvent(
+      new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { id, favorite: next },
+      }),
+    );
+  }
+
+  #setPressed(on) {
+    this.toggleAttribute('favorite', on);
+    this.#button?.setAttribute('aria-pressed', String(on));
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
