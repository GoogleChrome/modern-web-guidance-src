diff --git a/js/drink-card.js b/js/drink-card.js
new file mode 100644
index 0000000..ae826b2
--- /dev/null
+++ b/js/drink-card.js
@@ -0,0 +1,112 @@
+/**
+ * <drink-card> — hydrates server-rendered markup in place.
+ *
+ * Each card ships with a Declarative Shadow DOM template
+ * (<template shadowrootmode="open">) containing its styles, layout and the
+ * favorite toggle button, so the browser paints a fully styled card before
+ * this script ever runs. On upgrade we reuse the existing shadow root and
+ * only attach behavior — nothing is re-rendered.
+ */
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    const value = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
+    return new Set(Array.isArray(value) ? value : []);
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorites(favorites) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...favorites]));
+  } catch {
+    /* storage unavailable (private mode, quota) — keep in-memory state only */
+  }
+}
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['favorite'];
+
+  #button = null;
+
+  constructor() {
+    super();
+    // Declarative shadow root already attached by the HTML parser (or by the
+    // inline polyfill for older browsers). Never call attachShadow again.
+    this.#button = this.shadowRoot?.querySelector('.fav') ?? null;
+    this.onToggle = this.onToggle.bind(this);
+    this.onStorage = this.onStorage.bind(this);
+  }
+
+  get drinkId() {
+    return this.getAttribute('drink-id');
+  }
+
+  get name() {
+    return this.getAttribute('drink-name') || this.drinkId;
+  }
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  connectedCallback() {
+    if (!this.#button) return; // no server-rendered shadow root: leave light DOM content as-is
+    this.#button.addEventListener('click', this.onToggle);
+    window.addEventListener('storage', this.onStorage);
+
+    // Restore persisted state; only touches attributes, not markup.
+    if (this.drinkId && readFavorites().has(this.drinkId)) this.favorite = true;
+    this.toggleAttribute('hydrated', true);
+  }
+
+  disconnectedCallback() {
+    this.#button?.removeEventListener('click', this.onToggle);
+    window.removeEventListener('storage', this.onStorage);
+  }
+
+  attributeChangedCallback(name) {
+    if (name === 'favorite') this.#sync();
+  }
+
+  onToggle() {
+    this.favorite = !this.favorite;
+
+    if (this.drinkId) {
+      const favorites = readFavorites();
+      this.favorite ? favorites.add(this.drinkId) : favorites.delete(this.drinkId);
+      writeFavorites(favorites);
+    }
+
+    this.dispatchEvent(new CustomEvent('favorite-change', {
+      bubbles: true,
+      composed: true,
+      detail: { id: this.drinkId, favorite: this.favorite },
+    }));
+  }
+
+  onStorage(event) {
+    if (event.key !== STORAGE_KEY || !this.drinkId) return;
+    this.favorite = readFavorites().has(this.drinkId);
+  }
+
+  #sync() {
+    if (!this.#button) return;
+    const on = this.favorite;
+    this.#button.setAttribute('aria-pressed', String(on));
+    this.#button.setAttribute(
+      'aria-label',
+      `${on ? 'Remove' : 'Add'} ${this.name} ${on ? 'from' : 'to'} favorites`,
+    );
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
