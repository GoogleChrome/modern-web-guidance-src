+    /* Options dropdown */
+    .options-trigger {
+      /* Explicit anchor name: the anchor polyfill can't use popovertarget's implicit anchor */
+      anchor-name: --options-trigger;
+      display: inline-flex;
+      align-items: center;
+      gap: 6px;
+      background: transparent;
+      color: white;
+      border: 1px solid rgba(255, 255, 255, 0.4);
+      border-radius: 4px;
+      padding: 5px 12px;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: color 0.3s, border-color 0.3s;
+    }
+
+    .options-trigger:hover,
+    .options-trigger:focus-visible {
+      color: var(--accent);
+      border-color: var(--accent);
+    }
+
+    .options-trigger:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .options-trigger .chevron {
+      font-size: 0.7em;
+      transition: transform 0.2s;
+    }
+
+    .options-trigger[aria-expanded="true"] .chevron {
+      transform: rotate(180deg);
+    }
+
+    .action-panel {
+      /* Tether below the trigger, aligned to its left edge */
+      position-anchor: --options-trigger;
+      inset: auto;
+      top: anchor(bottom);
+      left: anchor(left);
+      margin: 6px 0 0;
+      /* Flip vertically / horizontally / both when colliding with the viewport */
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+
+      min-width: 200px;
+      padding: 6px;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+      color: var(--text);
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
+    }
+
+    .action-panel:is(:popover-open, .\:popover-open) {
+      display: flex;
+      flex-direction: column;
+      gap: 2px;
+    }
+
+    .action-item {
+      display: block;
+      width: 100%;
+      text-align: left;
+      background: transparent;
+      border: 0;
+      border-radius: 5px;
+      padding: 8px 12px;
+      font: inherit;
+      font-size: 0.9rem;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    .action-item:hover,
+    .action-item:focus-visible {
