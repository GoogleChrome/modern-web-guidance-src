+  <script>
+    (function () {
+      const trigger = document.getElementById('trigger-btn');
+      const panel = document.getElementById('action-panel');
+      if (!trigger || !panel) return;
+
+      // Action buttons navigate and close the panel
+      panel.addEventListener('click', (e) => {
+        const btn = e.target.closest('button[data-href]');
+        if (!btn) return;
+        panel.hidePopover();
+        window.location.href = btn.dataset.href;
+      });
+
+      // Keep aria-expanded in sync (browsers set it for popovertarget, but be explicit)
+      panel.addEventListener('toggle', (e) => {
+        trigger.setAttribute('aria-expanded', String(e.newState === 'open'));
+      });
+      trigger.setAttribute('aria-expanded', 'false');
+
+      // JS fallback for browsers without CSS anchor positioning
+      if (window.CSS && CSS.supports('anchor-name: --a') && CSS.supports('position-try-fallbacks: flip-block')) return;
+
+      const GAP = 6;
+      const MARGIN = 8;
+
+      function position() {
+        if (!panel.matches(':popover-open')) return;
+        panel.style.top = panel.style.left = '0px';
+        panel.style.marginTop = '0px';
+
+        const t = trigger.getBoundingClientRect();
+        const p = panel.getBoundingClientRect();
+        const vw = document.documentElement.clientWidth;
+        const vh = document.documentElement.clientHeight;
+
+        // Vertical: below, flip above if it collides with the bottom edge
+        let top = t.bottom + GAP;
+        if (top + p.height > vh - MARGIN && t.top - GAP - p.height >= MARGIN) {
+          top = t.top - GAP - p.height;
+        }
+
+        // Horizontal: align left edges, flip to right-edge alignment on collision
+        let left = t.left;
+        if (left + p.width > vw - MARGIN && t.right - p.width >= MARGIN) {
+          left = t.right - p.width;
+        }
+
+        // Final clamp so it is never cut off
+        top = Math.max(MARGIN, Math.min(top, vh - p.height - MARGIN));
+        left = Math.max(MARGIN, Math.min(left, vw - p.width - MARGIN));
+
+        panel.style.top = top + 'px';
+        panel.style.left = left + 'px';
+      }
+
+      panel.addEventListener('toggle', (e) => {
+        if (e.newState === 'open') {
+          position();
+          window.addEventListener('scroll', position, { passive: true, capture: true });
+          window.addEventListener('resize', position);
+        } else {
+          window.removeEventListener('scroll', position, { capture: true });
+          window.removeEventListener('resize', position);
+        }
+      });
+    })();
+  </script>
