+  <!--
+    Feature-detect native out-of-order streaming (template[for] + processing
+    instructions) and the HTML setter/streaming methods. Load polyfills only in
+    browsers that lack them. Unsupported parsers turn the marker/start/end
+    processing instructions into comments, which template-for-polyfill still recognises.
+  -->
+  <script type="module">
+    const probe = document.createElement('div');
+    probe.innerHTML = '<?marker name="probe">';
+    const hasProcessingInstructions =
+      probe.firstChild?.nodeType === Node.PROCESSING_INSTRUCTION_NODE;
+
+    const polyfills = [];
+    if (!hasProcessingInstructions) {
+      polyfills.push(import('https://esm.sh/template-for-polyfill'));
+    }
+    if (!('streamHTML' in Element.prototype) || !('setHTMLUnsafe' in Element.prototype)) {
+      polyfills.push(import('https://esm.sh/html-setters-polyfill'));
+    }
+    window.__streamingReady = Promise.all(polyfills);
+  </script>
 </head>
 
