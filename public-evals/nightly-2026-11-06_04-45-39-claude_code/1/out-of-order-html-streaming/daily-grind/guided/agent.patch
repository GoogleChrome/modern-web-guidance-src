+  <!--
+    Streamed later in the same response: the server flushes the real cards once
+    they're ready and the browser swaps out everything in the "seasonal-cards" range.
+  -->
+  <template for="seasonal-cards">
+    <div class="card">
+      <h3>Maple Oat Latte</h3>
+      <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <a href="/menu/seasonal" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Dark Roast Espresso</h3>
+      <p>Bold, smokey, and perfect for a morning boost.</p>
+      <a href="/menu/espresso" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Cold Brew</h3>
+      <p>Steeped for 18 hours for maximum smoothness.</p>
+      <a href="/menu/cold-brew" class="btn">View Details</a>
+    </div>
+  </template>
+
+  <script type="module">
+    await window.__streamingReady;
+
+    const grid = document.getElementById('seasonal-grid');
+    const status = document.getElementById('seasonal-status');
+    const reviews = document.getElementById('reviews');
+    const promo = document.getElementById('cms-promo');
+
+    // The declarative template above has been applied by the time this runs.
+    grid.removeAttribute('aria-busy');
+
+    const toTextStream = (response) => {
+      if (!response.ok) throw new Error(`${response.url} → ${response.status}`);
+      return response.body.pipeThrough(new TextDecoderStream());
+    };
+
+    // --- Seasonal Favorites: re-stream fresh card HTML whenever the menu changes ---
+    let refreshController;
+    async function refreshSeasonalCards() {
+      refreshController?.abort();
+      const { signal } = (refreshController = new AbortController());
+      grid.setAttribute('aria-busy', 'true');
+      try {
+        const response = await fetch('/partials/seasonal-favorites', { signal });
+        // Safe streaming setter: menu cards need no scripts, so keep the built-in sanitizer.
+        await toTextStream(response).pipeTo(grid.streamHTML(), { signal });
+        status.textContent = 'Seasonal favorites updated.';
+      } catch (err) {
+        if (err.name !== 'AbortError') console.error('Seasonal refresh failed', err);
+      } finally {
+        if (refreshController.signal === signal) grid.removeAttribute('aria-busy');
+      }
+    }
+
+    const menuEvents = new EventSource('/api/menu/events');
+    menuEvents.addEventListener('menu-updated', refreshSeasonalCards);
+
+    // --- Customer reviews: untrusted, so sanitize with a restrictive allowlist ---
+    const reviewSanitizer = {
+      elements: ['article', 'blockquote', 'p', 'cite', 'h3', 'b', 'i', 'strong', 'em', 'br'],
+      attributes: ['class'],
+    };
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype && 'Sanitizer' in window) {
+        el.setHTML(html, { sanitizer: reviewSanitizer });
+      } else {
+        const { default: DOMPurify } = await import('https://esm.sh/dompurify@3');
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...reviewSanitizer.elements, '#text'],
+          ALLOWED_ATTR: reviewSanitizer.attributes,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false,
+        });
+      }
+    }
+
+    async function loadReviews() {
+      try {
+        const response = await fetch('/partials/reviews');
+        if (!response.ok) throw new Error(`reviews → ${response.status}`);
+        await safeSetHTML(reviews, await response.text());
+      } catch (err) {
+        console.error('Reviews failed to load', err);
+        reviews.replaceChildren();
+      } finally {
+        reviews.removeAttribute('aria-busy');
+      }
+    }
+
+    // --- CMS promo: first-party & trusted, its embedded widget script must run ---
+    async function loadPromo() {
+      try {
+        const response = await fetch('/cms/promo-block');
+        await toTextStream(response).pipeTo(promo.streamHTMLUnsafe({ runScripts: true }));
+      } catch (err) {
+        console.error('Promo failed to load', err);
+        promo.hidden = true;
+      } finally {
+        promo.removeAttribute('aria-busy');
+      }
+    }
+
+    loadReviews();
+    loadPromo();
+  </script>
+
