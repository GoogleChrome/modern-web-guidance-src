+  <!--
+    ===== Late-streamed content =====
+    In production the server flushes the page shell first and emits this
+    template later in the same response once the menu data is ready.
+    Browsers with Declarative Partial Updates swap it into #seasonal-cards as
+    it is parsed; the script below polyfills that for other browsers.
+    NOTE: this markup is server-rendered from our own menu data only — never
+    interpolate customer-submitted text here without HTML-escaping it.
+  -->
+  <template for="seasonal-cards">
+    <div class="card">
+      <img src="https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=600&q=70" alt="Latte with latte art" loading="lazy">
+      <h3>Maple Oat Latte</h3>
+      <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <a href="/menu/seasonal" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <img src="https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=600&q=70" alt="Espresso shot in a cup" loading="lazy">
+      <h3>Dark Roast Espresso</h3>
+      <p>Bold, smokey, and perfect for a morning boost.</p>
+      <a href="/menu/espresso" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <img src="https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=70" alt="Iced cold brew coffee" loading="lazy">
+      <h3>Cold Brew</h3>
+      <p>Steeped for 18 hours for maximum smoothness.</p>
+      <a href="/menu/cold-brew" class="btn">View Details</a>
+    </div>
+  </template>
+
+  <script>
+    (() => {
+      'use strict';
+
+      // ---- Configuration (endpoints are assumptions; adjust to the backend) ----
+      const CARDS_URL = '/fragments/seasonal-cards';       // HTML fragment of .card elements (our server)
+      const MENU_EVENTS_URL = '/api/menu/events';          // Server-Sent Events: "menu-updated"
+      const REVIEWS_URL = '/fragments/seasonal-reviews';   // HTML fragment containing customer reviews (untrusted)
+      const CMS_ORIGIN = 'https://cms.dailygrind.example'; // Our first-party CMS
+      const PROMO_URL = CMS_ORIGIN + '/promos/seasonal';   // HTML promo block + widget <script>
+      const POLL_MS = 60_000;
+
+      const cardsEl = document.getElementById('seasonal-cards');
+      const reviewsEl = document.getElementById('seasonal-reviews');
+      const promoEl = document.getElementById('seasonal-promo');
+
+      // ---- Safe HTML insertion (for anything that may contain user content) ----
+      // Allowlist used both for the native Sanitizer API and the fallback.
+      const SAFE_ELEMENTS = ['div', 'section', 'article', 'p', 'h3', 'h4', 'span', 'strong', 'em', 'b', 'i',
+        'br', 'ul', 'ol', 'li', 'a', 'img', 'blockquote', 'cite', 'footer', 'time'];
+      const SAFE_ATTRS = ['class', 'href', 'src', 'alt', 'title', 'datetime', 'loading', 'width', 'height'];
+      const SAFE_URL = /^(?:https?:|\/(?!\/)|#)/i;
+
+      function fallbackSanitize(html) {
+        // DOMParser creates an inert document: no scripts run, no resources load.
+        const doc = new DOMParser().parseFromString(html, 'text/html');
+        const out = document.createDocumentFragment();
+        const copy = (node, parent) => {
+          for (const child of node.childNodes) {
+            if (child.nodeType === Node.TEXT_NODE) {
+              parent.append(child.data);
+            } else if (child.nodeType === Node.ELEMENT_NODE) {
+              const tag = child.localName;
+              if (!SAFE_ELEMENTS.includes(tag)) {
+                // Drop dangerous containers entirely; unwrap other unknown elements.
+                if (!['script', 'style', 'template', 'iframe', 'object', 'embed', 'noscript', 'svg', 'math'].includes(tag)) {
+                  copy(child, parent);
+                }
+                continue;
+              }
+              const el = document.createElement(tag);
+              for (const { name, value } of child.attributes) {
+                if (!SAFE_ATTRS.includes(name)) continue;
+                if ((name === 'href' || name === 'src') && !SAFE_URL.test(value.trim())) continue;
+                el.setAttribute(name, value);
+              }
+              if (tag === 'a') el.rel = 'nofollow noopener ugc';
+              copy(child, el);
+              parent.append(el);
+            }
+          }
+        };
+        copy(doc.body, out);
+        return out;
+      }
+
+      function setSafeHTML(target, html) {
+        if (typeof target.setHTML === 'function') {
+          // Native Sanitizer API: always XSS-safe (scripts/handlers/javascript: URLs removed),
+          // further narrowed to our allowlist.
+          try {
+            target.setHTML(html, { sanitizer: { elements: SAFE_ELEMENTS, attributes: SAFE_ATTRS } });
+          } catch {
+            target.setHTML(html); // default safe config
+          }
+          target.querySelectorAll('a').forEach(a => { a.rel = 'nofollow noopener ugc'; });
+        } else {
+          target.replaceChildren(fallbackSanitize(html));
+        }
+      }
+
+      // ---- Trusted first-party HTML with scripts (CMS promo only) ----
+      function activateScripts(root) {
+        // Scripts inserted via HTML parsing APIs are inert; recreate the ones we trust.
+        for (const old of root.querySelectorAll('script')) {
+          if (old.src && new URL(old.src, location.href).origin !== CMS_ORIGIN) {
+            old.remove(); // only our CMS may supply widget code
+            continue;
+          }
+          const s = document.createElement('script');
+          for (const { name, value } of old.attributes) s.setAttribute(name, value);
+          s.textContent = old.textContent;
+          old.replaceWith(s);
+        }
+      }
+
+      function setTrustedHTMLWithScripts(target, html) {
+        if (typeof target.setHTMLUnsafe === 'function') {
+          target.setHTMLUnsafe(html);
+        } else {
+          const tpl = document.createElement('template');
+          tpl.innerHTML = html;
+          target.replaceChildren(tpl.content);
+        }
+        activateScripts(target);
+      }
+
+      // ---- Seasonal cards ----
+      function applyCards(fragmentOrHtml) {
+        if (typeof fragmentOrHtml === 'string') {
+          // Card HTML comes from our server but may echo menu data entered by staff;
+          // sanitize defensively — cards never need scripts.
+          setSafeHTML(cardsEl, fragmentOrHtml);
+        } else {
+          cardsEl.replaceChildren(fragmentOrHtml);
+        }
+        cardsEl.setAttribute('aria-busy', 'false');
+      }
+
+      // Polyfill for <template for>: if the browser didn't consume the
+      // streamed template natively, apply it ourselves.
+      function applyStreamedTemplates() {
+        for (const tpl of document.querySelectorAll('template[for="seasonal-cards"]')) {
+          applyCards(tpl.content.cloneNode(true));
+          tpl.remove();
+        }
+        if (!cardsEl.querySelector('.skeleton')) cardsEl.setAttribute('aria-busy', 'false');
+      }
+
+      let cardsETag = null;
+      let refreshController = null;
+
+      async function refreshCards() {
+        refreshController?.abort();
+        const controller = refreshController = new AbortController();
+        cardsEl.setAttribute('aria-busy', 'true');
+        try {
+          const headers = { Accept: 'text/html' };
+          if (cardsETag) headers['If-None-Match'] = cardsETag;
+          const res = await fetch(CARDS_URL, { headers, signal: controller.signal, cache: 'no-cache' });
+          if (res.status === 304) return;
+          if (!res.ok) throw new Error('HTTP ' + res.status);
+          cardsETag = res.headers.get('ETag');
+          const html = await res.text();
+          const swap = () => applyCards(html);
+          // Smooth in-place swap where View Transitions are available.
+          document.startViewTransition ? document.startViewTransition(swap) : swap();
+        } catch (err) {
+          if (err.name !== 'AbortError') console.warn('Seasonal cards refresh failed; keeping current cards.', err);
+        } finally {
+          if (refreshController === controller) {
+            cardsEl.setAttribute('aria-busy', 'false');
+            refreshController = null;
+          }
+        }
+      }
+
+      // Refresh whenever the menu changes: SSE push, with polling as a fallback.
+      function watchMenu() {
+        let pollTimer = null;
+        const startPolling = () => {
+          if (pollTimer) return;
+          pollTimer = setInterval(() => { if (!document.hidden) refreshCards(); }, POLL_MS);
+        };
+        if ('EventSource' in window) {
+          const es = new EventSource(MENU_EVENTS_URL);
+          es.addEventListener('menu-updated', () => { refreshCards(); refreshReviews(); });
+          es.addEventListener('open', () => { clearInterval(pollTimer); pollTimer = null; });
+          es.addEventListener('error', startPolling); // EventSource auto-reconnects meanwhile
+        } else {
+          startPolling();
+        }
+        document.addEventListener('visibilitychange', () => { if (!document.hidden) refreshCards(); });
+      }
+
+      // ---- Reviews (untrusted) ----
+      async function refreshReviews() {
+        try {
+          const res = await fetch(REVIEWS_URL, { headers: { Accept: 'text/html' }, cache: 'no-cache' });
+          if (!res.ok) throw new Error('HTTP ' + res.status);
+          setSafeHTML(reviewsEl, await res.text());
+        } catch (err) {
+          console.warn('Reviews unavailable.', err);
+          if (reviewsEl.querySelector('.status-msg')) {
+            reviewsEl.querySelector('.status-msg').textContent = 'Reviews are unavailable right now.';
+          }
+        }
+      }
+
+      // ---- CMS promo (trusted, with widget script) ----
+      async function loadPromo() {
+        try {
+          const res = await fetch(PROMO_URL, { mode: 'cors', credentials: 'omit', headers: { Accept: 'text/html' } });
+          if (!res.ok) throw new Error('HTTP ' + res.status);
+          setTrustedHTMLWithScripts(promoEl, await res.text());
+        } catch (err) {
+          console.warn('Promo unavailable.', err);
+          promoEl.closest('.promo').hidden = true;
+        }
+      }
+
+      // The script runs after the streamed template has been parsed (it follows it in the document).
+      applyStreamedTemplates();
+      refreshReviews();
+      loadPromo();
+      watchMenu();
+    })();
+  </script>
+
