+  <script>
+    const actionTarget = document.getElementById('action-target');
+    const commandClasses = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded',
+    };
+
+    actionTarget.addEventListener('command', (event) => {
+      if (event.command === '--reset') {
+        actionTarget.classList.remove(...Object.values(commandClasses));
+        return;
+      }
+      const className = commandClasses[event.command];
+      if (className) actionTarget.classList.toggle(className);
+    });
+
+    // Minimal fallback for browsers without Invoker Commands support.
+    if (!('command' in HTMLButtonElement.prototype)) {
+      document.addEventListener('click', (event) => {
+        const button = event.target.closest('button[commandfor][command]');
+        if (!button) return;
+        const target = document.getElementById(button.getAttribute('commandfor'));
+        if (!target) return;
+        const commandEvent = new Event('command', { cancelable: true });
+        commandEvent.command = button.getAttribute('command');
+        commandEvent.source = button;
+        target.dispatchEvent(commandEvent);
+      });
+    }
+  </script>
+
