diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,10 +11,53 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+
+      /* Scrollbar: dark roast thumb on a latte track for clear separation */
+      --scrollbar-thumb: var(--primary);
+      --scrollbar-track: var(--secondary);
+
+      /* Keep scrollbar-width at auto (full size); "thin" makes it harder to see and grab */
+      scrollbar-width: auto;
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+      /* Makes macOS render the track instead of a transparent overlay */
+      scrollbar-gutter: stable;
     }
 
+    /* Stronger contrast for users who ask for it in their OS or browser */
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-thumb: #000000;
+        --scrollbar-track: #ffffff;
+      }
+    }
+
+    /* Forced colors (e.g. Windows High Contrast): let the system palette take over */
+    @media (forced-colors: active) {
+      :root {
+        scrollbar-color: auto;
+      }
+    }
+
+    /* Fallback for older WebKit/Blink browsers without scrollbar-color */
+    @supports not (scrollbar-color: auto) {
+      ::-webkit-scrollbar {
+        width: 14px;
+        height: 14px;
+      }
+
+      ::-webkit-scrollbar-track {
+        background: var(--scrollbar-track);
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background: var(--scrollbar-thumb);
+        border: 3px solid var(--scrollbar-track);
+        border-radius: 7px;
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
