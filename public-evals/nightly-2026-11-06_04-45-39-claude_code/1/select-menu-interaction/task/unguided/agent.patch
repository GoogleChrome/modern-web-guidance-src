+  <script>
+    (function () {
+      var form = document.getElementById('order-form');
+      var select = document.getElementById('shop');
+      var field = select.closest('.form-field');
+      var error = document.getElementById('shop-error');
+
+      function validate() {
+        var valid = select.checkValidity();
+        // Errors only surface after interaction or a submit attempt.
+        if (!field.classList.contains('touched')) return valid;
+        if (valid) {
+          select.removeAttribute('aria-invalid');
+          error.textContent = '';
+        } else {
+          select.setAttribute('aria-invalid', 'true');
+          error.textContent = 'Please select a local shop.';
+        }
+        return valid;
+      }
+
+      function markTouched() {
+        field.classList.add('touched');
+        validate();
+      }
+
+      select.addEventListener('change', markTouched);
+      select.addEventListener('blur', markTouched);
+
+      form.addEventListener('submit', function (event) {
+        field.classList.add('touched');
+        if (!validate()) {
+          event.preventDefault();
+          select.focus();
+        }
+      });
+    })();
+  </script>
+
