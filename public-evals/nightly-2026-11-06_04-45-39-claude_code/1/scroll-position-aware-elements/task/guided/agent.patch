+
+  <script>
+    // Fallback for browsers without container scroll-state queries:
+    // observe a sentinel at the top of the scroller instead of listening to scroll events.
+    if (!CSS.supports('container-type', 'scroll-state') && 'IntersectionObserver' in window) {
+      const scroller = document.querySelector('.scroller');
+      const sentinel = scroller.querySelector('.scroll-sentinel');
+      scroller.classList.add('js-scroll-aware');
+      new IntersectionObserver(([entry]) => {
