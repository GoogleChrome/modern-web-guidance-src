+  <script>
+    (() => {
+      const scroller = document.getElementById('scroller');
+      const button = scroller?.querySelector('.back-to-top');
+      const sentinel = scroller?.querySelector('.scroll-sentinel');
+      const topTarget = scroller?.querySelector('.scroll-top-target');
+      if (!scroller || !button || !sentinel) return;
+
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      const setVisible = (visible) => {
+        button.classList.toggle('is-visible', visible);
+        // inert guarantees no focus/click while hidden, even mid-transition.
+        button.inert = !visible;
+        button.setAttribute('aria-hidden', String(!visible));
+
+        // If the button is about to hide while focused, move focus somewhere
+        // sensible so keyboard users aren't stranded on an invisible element.
+        if (!visible && document.activeElement === button && topTarget) {
+          topTarget.focus({ preventScroll: true });
+        }
+      };
+
+      setVisible(false);
+
+      if ('IntersectionObserver' in window) {
+        // Fires only when the sentinel crosses the threshold — no per-frame scroll work.
+        const observer = new IntersectionObserver(
+          ([entry]) => setVisible(!entry.isIntersecting),
+          { root: scroller, threshold: 0 }
+        );
+        observer.observe(sentinel);
+      } else {
+        // Fallback: passive, rAF-throttled scroll listener.
+        let ticking = false;
+        scroller.addEventListener('scroll', () => {
+          if (ticking) return;
+          ticking = true;
+          requestAnimationFrame(() => {
+            setVisible(scroller.scrollTop > sentinel.offsetHeight);
+            ticking = false;
+          });
+        }, { passive: true });
+      }
+
+      button.addEventListener('click', () => {
+        scroller.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+        if (topTarget) topTarget.focus({ preventScroll: true });
+      });
+    })();
+  </script>
