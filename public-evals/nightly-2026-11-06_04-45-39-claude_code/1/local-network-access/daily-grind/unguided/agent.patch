+            if (this.baseUrl) { this.buttons.command.disabled = false; this.buttons.stop.disabled = false; }
+          }
+        }
+
+        disconnect(reason, isError = false) {
+          this.stopPolling();
+          this.baseUrl = null;
+          this.token = '';
+          this.updateTelemetry(null);
+          this.setState(isError ? 'error' : 'idle', isError ? 'Connection lost' : 'Disconnected');
+          if (reason) this.log(reason, isError ? 'err' : undefined);
+        }
+
+        stopPolling() {
+          if (this.pollTimer) clearInterval(this.pollTimer);
+          this.pollTimer = null;
+        }
+
+        updateTelemetry(data) {
+          const values = data && typeof data === 'object' ? this.profile.renderTelemetry(data) : {};
+          this.card.querySelectorAll('[data-field]').forEach((el) => {
+            el.textContent = values[el.dataset.field] ?? '—';
+          });
+        }
+
+        setState(state, label) {
+          const connected = state === 'connected';
+          this.statusEl.dataset.state = state;
+          this.statusEl.textContent = label;
+          this.buttons.connect.disabled = state === 'connecting';
+          this.buttons.connect.textContent = connected ? 'Reconnect' : 'Connect';
+          this.buttons.disconnect.disabled = !(connected || state === 'connecting');
+          this.buttons.command.disabled = !connected;
+          this.buttons.stop.disabled = !connected;
+        }
+
+        log(message, kind) {
+          const li = document.createElement('li');
+          const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
+          li.textContent = `[${time}] ${message}`;   // textContent only — never render device data as HTML
+          if (kind) li.className = kind;
+          this.logEl.appendChild(li);
+          while (this.logEl.children.length > MAX_LOG_LINES) this.logEl.firstElementChild.remove();
+          this.logEl.scrollTop = this.logEl.scrollHeight;
+        }
+      }
+
+      document.querySelectorAll('.device-card[data-device]').forEach((card) => {
+        const profile = PROFILES[card.dataset.device];
+        if (profile) new DeviceConnection(card, profile);
+      });
+    })();
+  </script>
+
 </body>
 
