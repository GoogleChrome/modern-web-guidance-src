@@ -0,0 +1,71 @@
+---
+import Layout from '../layouts/Layout.astro';
+import DiagnosticsConnect from '../components/DiagnosticsConnect';
+
+const origin = Astro.url.origin;
+---
+
+<Layout title="Developer Diagnostics | The DevTools Times">
+  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12">
+    <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-2">Developer Tools</p>
+    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Diagnostics Connection</h1>
+    <p class="text-gray-700 max-w-3xl mb-2">
+      Connect this browser to a hardware test device on your Wi‑Fi network and to the companion CLI on
+      your own computer. Requests go straight from your browser to those devices. Nothing is sent to
+      or relayed through The DevTools Times.
+    </p>
+    <p class="text-sm text-gray-500 max-w-3xl mb-8">
+      The first time you connect, your browser may ask whether this site can access devices on your
+      local network. Choose <strong>Allow</strong> to continue. You can withdraw this permission any
+      time in your site settings.
+    </p>
+
+    <DiagnosticsConnect client:load />
+
+    <section class="mt-12 border-t border-gray-200 pt-8">
+      <h2 class="text-xl font-bold text-gray-900 mb-3">For device &amp; CLI developers</h2>
+      <div class="prose prose-sm max-w-none">
+        <p>
+          The widget sends one <code>GET /diagnostics/v1/status</code> request per click over plain
+          HTTP. If you set a pairing token, it goes in an <code>Authorization: Bearer &lt;token&gt;</code>
+          header. Return JSON with any status fields you want. The widget shows the response as-is.
+        </p>
+        <p>The target must allow this origin with CORS, including the preflight:</p>
+        <pre><code>OPTIONS /diagnostics/v1/status
+  → 204
+  Access-Control-Allow-Origin: {origin}
+  Access-Control-Allow-Methods: GET
+  Access-Control-Allow-Headers: Authorization, Accept
+  Access-Control-Allow-Private-Network: true
+  Vary: Origin
+
+GET /diagnostics/v1/status
+  → 200 application/json
+  Access-Control-Allow-Origin: {origin}
+  Vary: Origin</code></pre>
+        <ul>
+          <li>
+            <strong>Check the <code>Origin</code> header</strong> against an allowlist. Never echo it
+            back unconditionally and never use <code>*</code>. Otherwise any website the user visits
+            could talk to your device.
+          </li>
+          <li>
+            <strong>Require a pairing token</strong> for anything beyond read-only status. Generate it
+            at random on startup and show it only on the device screen or in the CLI's terminal.
+          </li>
+          <li>
+            <strong>Companion CLI:</strong> listen on <code>127.0.0.1</code> only, not
+            <code>0.0.0.0</code>. Check the <code>Host</code> header (<code>127.0.0.1:&lt;port&gt;</code>
+            or <code>localhost:&lt;port&gt;</code>) to block DNS rebinding. The default port is
+            <code>47821</code>.
+          </li>
+          <li>
+            <strong>LAN device:</strong> Chrome's Local Network Access lets this HTTPS page reach a
+            plain-HTTP device only by private IP literal or <code>.local</code> name. The widget accepts
+            only those, and it sets <code>targetAddressSpace</code> on each request.
+          </li>
+        </ul>
+      </div>
+    </section>
+  </div>
+</Layout>
