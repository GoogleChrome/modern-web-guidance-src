+---
+import Layout from '../layouts/Layout.astro';
+import DiagnosticsConnect from '../components/DiagnosticsConnect';
+---
+
+<Layout title="Developer Diagnostics | The DevTools Times">
+  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12">
+    <header class="mb-8 border-b-2 pb-4">
+      <p class="text-xs font-bold uppercase tracking-wider text-gray-500">For developers</p>
+      <h1 class="text-3xl md:text-4xl font-bold text-gray-900">Diagnostics connection</h1>
+      <p class="mt-3 max-w-3xl text-gray-700">
+        Connect this page directly to a hardware test device on your home or office Wi-Fi and to the
+        companion CLI running on your computer. Traffic goes straight from your browser to your own
+        network; nothing is relayed through our servers, and your browser asks for your permission first.
+      </p>
+    </header>
+
+    <DiagnosticsConnect client:load />
+
+    <section class="prose mt-12 max-w-none" aria-labelledby="integrators">
+      <h2 id="integrators">Requirements for device and CLI developers</h2>
+      <ul>
+        <li>
+          Respond to cross-origin requests with
+          <code>Access-Control-Allow-Origin: {Astro.url.origin}</code> (and allow the
+          <code>dtt.diagnostics.v1</code> WebSocket subprotocol if you offer a live stream).
+        </li>
+        <li>
+          Plain <code>http://</code> / <code>ws://</code> works when addressed by a private IP, <code>localhost</code>,
+          or a <code>.local</code> name. Custom hostnames need <code>https://</code> / <code>wss://</code>.
+        </li>
+        <li>
+          Supported in browsers that implement Local Network Access (Chrome and Edge 145+). Other browsers may
+          block http:// requests from this https:// page as mixed content.
+        </li>
+      </ul>
+    </section>
+  </div>
+</Layout>
