+  <script type="module">
+    // ---------- Shared built-in AI helpers ----------
+    // Use identical options for availability() and create() so the check reflects what we'll actually load.
+    const MODEL_OPTIONS = {
+      expectedInputs: [{ type: 'text', languages: ['en'] }],
+      expectedOutputs: [{ type: 'text', languages: ['en'] }],
+    };
+
+    const MENU_FACTS = `Menu facts:
+- Maple Oat Latte: espresso with creamy oat milk and a hint of Vermont maple syrup. Dairy-free milk. Served hot or iced. Seasonal item.
+- Cold Brew: coffee steeped for 18 hours for maximum smoothness, low acidity, served over ice. Can add oat milk or maple syrup.`;
+
+    const BARISTA_SYSTEM = `You are a friendly barista at The Daily Grind coffee shop. Only answer questions about the Maple Oat Latte or the Cold Brew. If asked about anything else, politely say you can only help with those two drinks. Keep answers short (2-4 sentences) and never invent prices or allergens beyond the facts given.\n${MENU_FACTS}`;
+
+    const SENTIMENT_SYSTEM = `You analyze customer feedback for a coffee shop. Return a sentiment score from -1 (very negative) to 1 (very positive) and the single best-fitting category.`;
+
+    const hasPromptAPI = 'LanguageModel' in self;
+    const liveSessions = new Set();
+
+    function contextOf(session) {
+      // contextUsage/contextWindow are current names; inputUsage/inputQuota are the older aliases.
+      const used = session.contextUsage ?? session.inputUsage ?? 0;
+      const total = session.contextWindow ?? session.inputQuota ?? 0;
+      return { used, total };
+    }
+
+    function track(session) {
+      liveSessions.add(session);
+      return session;
+    }
+
+    function destroy(session) {
+      if (!session) return;
+      liveSessions.delete(session);
+      session.destroy();
+    }
+
+    async function checkAvailability(statusEl) {
+      if (!hasPromptAPI) {
+        statusEl.textContent = 'On-device AI is not supported in this browser. Try a recent desktop Chrome.';
+        return 'unavailable';
+      }
+      const availability = await LanguageModel.availability(MODEL_OPTIONS);
+      if (availability === 'unavailable') {
+        statusEl.textContent = 'The on-device model is unavailable on this device.';
+      }
+      return availability;
+    }
+
+    // Creates a session, showing download progress in statusEl when the model isn't cached yet.
+    async function createSession(statusEl, initialPrompts) {
+      const availability = await checkAvailability(statusEl);
+      if (availability === 'unavailable') return null;
+
+      let progress;
+      if (availability !== 'available') {
+        statusEl.textContent = 'Downloading the on-device model…';
+        progress = document.createElement('progress');
+        progress.max = 1;
+        progress.value = 0;
+        statusEl.append(progress);
+      }
+
+      const session = await LanguageModel.create({
+        ...MODEL_OPTIONS,
+        initialPrompts,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            if (!progress) return;
+            progress.value = e.loaded;
+            if (e.loaded === 1) statusEl.textContent = 'Preparing the model…';
+          });
+        },
+      });
+      statusEl.textContent = '';
+      return track(session);
+    }
+
+    // Lazily build one base session per feature (system prompt only) and clone it per task.
+    function baseSessionFactory(statusEl, systemPrompt) {
+      let pending = null;
+      return {
+        get(prewarmOnly = false) {
+          if (!pending) {
+            pending = (async () => {
+              // Prewarming without a user gesture is only possible when no download is required.
+              if (prewarmOnly && (await checkAvailability(statusEl)) !== 'available') return null;
+              return createSession(statusEl, [{ role: 'system', content: systemPrompt }]);
+            })().then((s) => { if (!s) pending = null; return s; },
+                      (err) => { pending = null; throw err; });
+          }
+          return pending;
+        },
+      };
+    }
+
+    function prewarmOnIntent(section, factory) {
+      const warm = () => factory.get(true).catch(() => {});
+      section.addEventListener('pointerenter', warm, { once: true });
+      section.addEventListener('focusin', warm, { once: true });
+    }
+
+    function disableIfUnsupported(...buttons) {
+      if (hasPromptAPI) return;
+      buttons.forEach((b) => (b.disabled = true));
+    }
+
+    // ---------- 1. Ask the Barista (streaming) ----------
+    const baristaSection = document.getElementById('barista');
+    const askBtn = document.getElementById('ask-the-barista');
+    const stopBtn = document.getElementById('barista-stop');
+    const questionEl = document.getElementById('barista-question');
+    const answerEl = document.getElementById('barista-answer');
+    const baristaStatus = document.getElementById('barista-status');
+    const baristaBase = baseSessionFactory(baristaStatus, BARISTA_SYSTEM);
+    let baristaAbort = null;
+
+    disableIfUnsupported(askBtn);
+    if (!hasPromptAPI) checkAvailability(baristaStatus);
+    prewarmOnIntent(baristaSection, baristaBase);
+
+    stopBtn.addEventListener('click', () => baristaAbort?.abort());
+
+    askBtn.addEventListener('click', async () => {
+      const question = questionEl.value.trim();
+      if (!question) {
+        baristaStatus.textContent = 'Please type a question first.';
+        questionEl.focus();
+        return;
+      }
+
+      askBtn.disabled = true;
+      answerEl.textContent = '';
+      let session;
+      try {
+        const base = await baristaBase.get();
+        if (!base) return;
+        // Clone the clean base so earlier questions don't bleed into this one.
+        session = track(await base.clone());
+        baristaAbort = new AbortController();
+        stopBtn.hidden = false;
+        baristaStatus.textContent = 'The barista is thinking…';
+        answerEl.setAttribute('aria-busy', 'true');
+
+        const stream = session.promptStreaming(question, { signal: baristaAbort.signal });
+        for await (const chunk of stream) {
+          // textContent-safe append: model output is untrusted.
+          answerEl.append(chunk);
+        }
+        baristaStatus.textContent = '';
+      } catch (err) {
+        baristaStatus.textContent = err.name === 'AbortError' ? 'Stopped.' : `Sorry, something went wrong: ${err.message}`;
+      } finally {
+        destroy(session);
+        baristaAbort = null;
+        stopBtn.hidden = true;
+        answerEl.removeAttribute('aria-busy');
+        askBtn.disabled = false;
+      }
+    });
+
+    // ---------- 2. Customer Feedback Analyzer (structured output) ----------
+    const feedbackSection = document.getElementById('feedback');
+    const sentimentBtn = document.getElementById('sentiment-btn');
+    const feedbackEl = document.getElementById('feedback-input');
+    const sentimentResult = document.getElementById('sentiment-result');
+    const sentimentStatus = document.getElementById('sentiment-status');
+    const sentimentBase = baseSessionFactory(sentimentStatus, SENTIMENT_SYSTEM);
+
+    // Passed as a plain object; no maxLength constraints so the model isn't forced to compress output.
+    const SENTIMENT_SCHEMA = {
+      type: 'object',
+      properties: {
+        score: { type: 'number', minimum: -1, maximum: 1 },
+        category: {
+          type: 'string',
+          enum: ['praise', 'complaint', 'suggestion', 'question', 'mixed'],
+        },
+      },
+      required: ['score', 'category'],
+      additionalProperties: false,
+    };
+
+    disableIfUnsupported(sentimentBtn);
+    if (!hasPromptAPI) checkAvailability(sentimentStatus);
+    prewarmOnIntent(feedbackSection, sentimentBase);
+
+    sentimentBtn.addEventListener('click', async () => {
+      const feedback = feedbackEl.value.trim();
+      if (!feedback) {
+        sentimentStatus.textContent = 'Please paste some feedback first.';
+        feedbackEl.focus();
+        return;
+      }
+
+      sentimentBtn.disabled = true;
+      sentimentResult.textContent = '';
+      let session;
+      try {
+        const base = await sentimentBase.get();
+        if (!base) return;
+        session = track(await base.clone());
+        sentimentStatus.textContent = 'Analyzing…';
+        const raw = await session.prompt(`Feedback:\n${feedback}`, { responseConstraint: SENTIMENT_SCHEMA });
+        const data = JSON.parse(raw);
+        sentimentResult.textContent = JSON.stringify(data, null, 2);
+        sentimentStatus.textContent = '';
+      } catch (err) {
+        sentimentStatus.textContent = `Analysis failed: ${err.message}`;
+      } finally {
+        destroy(session);
+        sentimentBtn.disabled = false;
+      }
+    });
+
+    // ---------- 3. Conversation Branching (clone + context tracking) ----------
+    const branchingSection = document.getElementById('branching');
+    const cloneBtn = document.getElementById('clone-btn');
+    const sendBtn = document.getElementById('branch-send');
+    const branchInput = document.getElementById('branch-input');
+    const branchList = document.getElementById('branch-list');
+    const branchOutput = document.getElementById('branch-output');
+    const branchStatus = document.getElementById('branch-status');
+    const branchBase = baseSessionFactory(branchStatus, BARISTA_SYSTEM);
+
+    const MAX_BRANCHES = 3; // Cap live sessions to bound device memory.
+    const branches = []; // { id, name, session, lastAnswer, lastUsed }
+    let activeId = null;
+    let nextId = 1;
+    let busy = false;
+
+    disableIfUnsupported(cloneBtn, sendBtn);
+    if (!hasPromptAPI) checkAvailability(branchStatus);
+    prewarmOnIntent(branchingSection, branchBase);
+
+    const activeBranch = () => branches.find((b) => b.id === activeId);
+
+    function addBranch(session, name, lastAnswer = '') {
+      const branch = { id: nextId++, name, session, lastAnswer, lastUsed: performance.now() };
+      // Event name changed from quotaoverflow to contextoverflow; listen for both.
+      const onOverflow = () => {
+        branchStatus.textContent = `"${branch.name}" exceeded its context window; the oldest messages were dropped.`;
+      };
+      session.addEventListener?.('contextoverflow', onOverflow);
+      session.addEventListener?.('quotaoverflow', onOverflow);
+      branches.push(branch);
+      activeId = branch.id;
+      pruneBranches();
+      renderBranches();
+      return branch;
+    }
+
+    function removeBranch(id) {
+      const i = branches.findIndex((b) => b.id === id);
+      if (i === -1) return;
+      const [branch] = branches.splice(i, 1);
+      destroy(branch.session);
+      if (activeId === id) {
+        activeId = branches.at(-1)?.id ?? null;
+        branchOutput.textContent = activeBranch()?.lastAnswer ?? '';
+      }
+      renderBranches();
+    }
+
+    // Destroy least-recently-used inactive branches when over the cap.
+    function pruneBranches() {
+      while (branches.length > MAX_BRANCHES) {
+        const victim = branches
+          .filter((b) => b.id !== activeId)
+          .sort((a, b) => a.lastUsed - b.lastUsed)[0];
+        if (!victim) break;
+        removeBranch(victim.id);
+        branchStatus.textContent = `Closed "${victim.name}" to free memory (max ${MAX_BRANCHES} branches).`;
+      }
+    }
+
+    function renderBranches() {
+      branchList.replaceChildren(
+        ...branches.map((b) => {
+          const li = document.createElement('li');
+          li.setAttribute('aria-current', String(b.id === activeId));
+
+          const label = document.createElement('span');
+          const { used, total } = contextOf(b.session);
+          const pct = total ? Math.round((used / total) * 100) : 0;
+          label.textContent = `${b.name} — ${used.toLocaleString()} / ${total.toLocaleString()} tokens (${pct}%)`;
+
+          const meter = document.createElement('meter');
+          meter.min = 0;
+          meter.max = total || 1;
+          meter.value = used;
+          meter.low = meter.max * 0.6;
+          meter.high = meter.max * 0.85;
+          meter.optimum = 0;
+          meter.setAttribute('aria-label', `${b.name} context usage`);
+
+          const actions = document.createElement('span');
+          const switchBtn = document.createElement('button');
+          switchBtn.type = 'button';
+          switchBtn.textContent = b.id === activeId ? 'Active' : 'Switch';
+          switchBtn.disabled = b.id === activeId;
+          switchBtn.addEventListener('click', () => {
+            activeId = b.id;
+            b.lastUsed = performance.now();
+            branchOutput.textContent = b.lastAnswer;
+            renderBranches();
+          });
+          const closeBtn = document.createElement('button');
+          closeBtn.type = 'button';
+          closeBtn.textContent = 'Close';
+          closeBtn.setAttribute('aria-label', `Close ${b.name}`);
+          closeBtn.addEventListener('click', () => removeBranch(b.id));
+          actions.append(switchBtn, ' ', closeBtn);
+
+          li.append(label, meter, actions);
+          return li;
+        }),
+      );
+    }
+
+    async function ensureActiveBranch() {
+      if (activeBranch()) return activeBranch();
+      const base = await branchBase.get();
+      if (!base) return null;
+      // Keep the clean base; conversations live in clones of it.
+      return addBranch(track(await base.clone()), `Branch ${nextId}`);
+    }
+
+    function setBusy(state) {
+      busy = state;
+      sendBtn.disabled = state;
+      cloneBtn.disabled = state;
+    }
+
+    sendBtn.addEventListener('click', async () => {
+      const message = branchInput.value.trim();
+      if (!message || busy) {
+        if (!message) branchStatus.textContent = 'Type a message first.';
+        return;
+      }
+      setBusy(true);
+      try {
+        const branch = await ensureActiveBranch();
+        if (!branch) return;
+        branchOutput.textContent = '';
+        branchStatus.textContent = `Responding in "${branch.name}"…`;
+        let answer = '';
+        for await (const chunk of branch.session.promptStreaming(message)) {
+          answer += chunk;
+          branchOutput.append(chunk);
+        }
+        branch.lastAnswer = answer;
+        branch.lastUsed = performance.now();
+        branchInput.value = '';
+        branchStatus.textContent = '';
+        renderBranches();
+      } catch (err) {
+        branchStatus.textContent = `Something went wrong: ${err.message}`;
+      } finally {
+        setBusy(false);
+      }
+    });
+
+    cloneBtn.addEventListener('click', async () => {
+      if (busy) return;
+      setBusy(true);
+      try {
+        const source = await ensureActiveBranch();
+        if (!source) return;
+        const clone = track(await source.session.clone());
+        branchStatus.textContent = '';
+        addBranch(clone, `${source.name} ↳ ${nextId}`, source.lastAnswer);
+        branchOutput.textContent = source.lastAnswer;
+        if (!branchStatus.textContent.startsWith('Closed')) {
+          branchStatus.textContent = `Cloned "${source.name}". You're now in the new branch.`;
+        }
+      } catch (err) {
+        branchStatus.textContent = `Could not clone: ${err.message}`;
+      } finally {
+        setBusy(false);
+      }
+    });
+
+    // ---------- Cleanup ----------
+    // Free model memory when the page is going away (pagehide also covers bfcache).
+    addEventListener('pagehide', (e) => {
+      if (e.persisted) return; // Keep sessions if the page may be restored from bfcache.
+      for (const s of liveSessions) s.destroy();
+      liveSessions.clear();
+    });
+  </script>
+
