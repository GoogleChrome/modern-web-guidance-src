+      });
+
+      cloneBtn.addEventListener('click', async () => {
+        controller = new AbortController();
+        const { signal } = controller;
+        setBusy(true);
+        setStatus(statusEl, 'Checking model availability…');
+        try {
+          const source = await ensureRoot(signal);
+          // Clone copies the full conversation context into a new, independent session.
+          const cloned = await source.session.clone({ signal });
+          const branch = addBranch(cloned, `Branch ${nextId} (from ${source.name})`, source.log.map((m) => ({ ...m })));
+          if (!statusEl.textContent.startsWith('Branch limit')) {
+            setStatus(statusEl, `Cloned "${source.name}" → "${branch.name}". New messages go to the clone.`);
+          }
+        } catch (err) {
+          if (isAbort(err)) setStatus(statusEl, 'Cancelled.');
+          else { console.error(err); setStatus(statusEl, err.message || 'Could not clone the session.', true); }
+        } finally {
+          setBusy(false);
+          render();
+          controller = null;
+        }
+      });
+
+      resetBtn.addEventListener('click', () => {
+        controller?.abort();
+        for (const b of branches) destroy(b.session);
+        branches = [];
+        activeId = null;
+        render();
+        setStatus(statusEl, 'All branches closed and their resources released.');
+      });
+    }
+
+    // ---------------------------------------------------------------------
+    // Resource cleanup: release all on-device sessions when leaving the page.
+    // ---------------------------------------------------------------------
+    window.addEventListener('pagehide', () => {
+      for (const s of [...liveSessions]) destroy(s);
+    });
+    // Sessions were destroyed on pagehide; if restored from the back/forward
+    // cache, reload so no code holds a reference to a destroyed session.
+    window.addEventListener('pageshow', (e) => {
+      if (e.persisted) location.reload();
+    });
+  </script>
+
 </body>
 
 </html>
