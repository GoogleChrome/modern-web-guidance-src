+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      if (!gallery) return;
+
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbs = Array.from(document.querySelectorAll('.thumbnail'));
+      if (!items.length || items.length !== thumbs.length) return;
+
+      const supportsScrollEnd = 'onscrollend' in window;
+      const supportsSnapChanging = 'onscrollsnapchanging' in window;
+
+      let pendingIndex = -1;
+      let programmaticTarget = null; // set while a thumbnail-initiated scroll is in flight
+      let snapHint = null;           // browser-reported upcoming snap target (scrollsnapchanging)
+      let rafId = 0;
+      let endTimer = 0;
+
+      // Index of the item whose center is closest to the gallery's center.
+      function nearestIndex() {
+        const box = gallery.getBoundingClientRect();
+        const center = box.left + box.width / 2;
+        let best = 0;
+        let bestDist = Infinity;
+        items.forEach(function (item, i) {
+          const r = item.getBoundingClientRect();
+          const dist = Math.abs(r.left + r.width / 2 - center);
+          if (dist < bestDist) {
+            bestDist = dist;
+            best = i;
+          }
+        });
+        return best;
+      }
+
+      function setPending(index) {
+        if (index === pendingIndex) return;
+        if (pendingIndex > -1) thumbs[pendingIndex].classList.remove('pending');
+        pendingIndex = index;
+        if (index > -1) thumbs[index].classList.add('pending');
+      }
+
+      function finalize() {
+        clearTimeout(endTimer);
+        cancelAnimationFrame(rafId);
+        const index = nearestIndex();
+
+        thumbs.forEach(function (thumb, i) {
+          thumb.classList.remove('pending');
+          const isActive = i === index;
+          thumb.classList.toggle('active', isActive);
+          thumb.setAttribute('aria-current', isActive ? 'true' : 'false');
+        });
+
+        pendingIndex = -1;
+        programmaticTarget = null;
+        snapHint = null;
+      }
+
+      // Live feedback while scrolling.
+      gallery.addEventListener('scroll', function () {
+        cancelAnimationFrame(rafId);
+        rafId = requestAnimationFrame(function () {
+          const target = programmaticTarget !== null ? programmaticTarget
+            : snapHint !== null ? snapHint
+            : nearestIndex();
+          setPending(target);
+        });
+
+        if (!supportsScrollEnd) {
+          clearTimeout(endTimer);
+          endTimer = setTimeout(finalize, 150);
+        }
+      }, { passive: true });
+
+      if (supportsScrollEnd) {
+        gallery.addEventListener('scrollend', finalize);
+      }
+
+      // Where supported, the browser tells us exactly where it intends to snap
+      // (accounts for fling momentum), which is more accurate than proximity.
+      if (supportsSnapChanging) {
+        gallery.addEventListener('scrollsnapchanging', function (e) {
+          const index = items.indexOf(e.snapTargetInline);
+          if (index > -1 && programmaticTarget === null) {
+            snapHint = index;
+            setPending(index);
+          }
+        });
+      }
+
+      // If the user grabs the gallery mid-animation, stop forcing the clicked target.
+      ['pointerdown', 'wheel', 'touchstart', 'keydown'].forEach(function (type) {
+        gallery.addEventListener(type, function () {
+          programmaticTarget = null;
+        }, { passive: true });
+      });
+
+      function scrollToIndex(index) {
+        const box = gallery.getBoundingClientRect();
+        const r = items[index].getBoundingClientRect();
+        const delta = (r.left + r.width / 2) - (box.left + box.width / 2);
+
+        if (Math.abs(delta) < 1) {
+          finalize();
+          return;
+        }
+
+        programmaticTarget = index;
+        snapHint = null;
+        setPending(index);
+        // Smoothness comes from CSS scroll-behavior (disabled for reduced motion).
+        gallery.scrollTo({ left: gallery.scrollLeft + delta });
+      }
+
+      thumbs.forEach(function (thumb, i) {
+        thumb.addEventListener('click', function () {
+          scrollToIndex(i);
+        });
+      });
+
+      // Sync state in case the browser restored a scroll position.
+      window.addEventListener('load', finalize);
+    })();
+  </script>
