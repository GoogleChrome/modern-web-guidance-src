+  <script>
+    (() => {
+      const container = document.getElementById('gallery');
+      if (!container) return;
+      const items = [...container.querySelectorAll('.gallery-item')];
+      const thumbnails = [...document.querySelectorAll('.thumbnail')];
+      const thumbGroup = document.querySelector('.thumbnails');
+      const hasNativeFocusgroup = 'focusGroup' in HTMLElement.prototype;
+
+      // Real-time feedback: mark the thumbnail the user is swiping towards.
+      const setPending = (index) => {
+        if (!thumbnails[index]) return;
+        thumbnails.forEach((thumb) => thumb.classList.remove('pending'));
+        thumbnails[index].classList.add('pending');
+      };
+
+      // Settled state: clear pending, mark active + aria-current.
+      const setActive = (index) => {
+        if (!thumbnails[index]) return;
+        thumbnails.forEach((thumb) => {
+          thumb.classList.remove('pending', 'active');
+          thumb.removeAttribute('aria-current');
+        });
+        thumbnails[index].classList.add('active');
+        thumbnails[index].setAttribute('aria-current', 'true');
+
+        // Keep the roving tab stop on the current thumbnail (fallback only),
+        // unless the user is currently navigating the thumbnails by keyboard.
+        if (!hasNativeFocusgroup && !thumbGroup.contains(document.activeElement)) {
+          thumbnails.forEach((thumb, i) => { thumb.tabIndex = i === index ? 0 : -1; });
+        }
+      };
+
+      // Assumes scroll-snap-align: center; #gallery is the offsetParent.
+      const findClosestItemIndex = () => {
+        const containerCenter = container.scrollLeft + container.clientWidth / 2;
+        let closestIndex = 0;
+        let minDistance = Infinity;
+        items.forEach((item, index) => {
+          const distance = Math.abs(containerCenter - (item.offsetLeft + item.offsetWidth / 2));
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestIndex = index;
+          }
+        });
+        return closestIndex;
+      };
+
+      if ('onscrollsnapchanging' in Element.prototype) {
+        container.addEventListener('scrollsnapchanging', (event) => {
+          setPending(items.indexOf(event.snapTargetInline));
+        });
+        container.addEventListener('scrollsnapchange', (event) => {
+          setActive(items.indexOf(event.snapTargetInline));
+        });
+      } else {
+        // Fallback: emulate snap prediction with scroll + rAF geometry.
+        let rafId = null;
+        let scrollTimeout;
+        const settle = () => {
+          clearTimeout(scrollTimeout);
+          setActive(findClosestItemIndex());
+        };
+
+        container.addEventListener('scroll', () => {
+          if (!rafId) {
+            rafId = requestAnimationFrame(() => {
+              rafId = null;
+              setPending(findClosestItemIndex());
+            });
+          }
+          // Debounce for browsers without scrollend.
+          clearTimeout(scrollTimeout);
+          scrollTimeout = setTimeout(settle, 150);
+        }, { passive: true });
+
+        container.addEventListener('scrollend', settle);
+      }
+
+      // Clicking a thumbnail scrolls its item into view; the snap
+      // events above then drive the pending/active state.
+      thumbnails.forEach((thumb, index) => {
+        thumb.addEventListener('click', () => {
+          const item = items[index];
+          if (!item) return;
+          container.scrollTo({
+            left: item.offsetLeft - (container.clientWidth - item.offsetWidth) / 2,
+          });
+        });
+      });
+
+      // Sync with any restored scroll position (no snap events fire for it).
+      const initActiveItem = () => setActive(findClosestItemIndex());
+      if (document.readyState === 'complete') {
+        initActiveItem();
+      } else {
+        window.addEventListener('load', initActiveItem, { once: true });
+      }
+
+      // focusgroup fallback: roving tabindex + arrow keys on the thumbnails.
+      if (!hasNativeFocusgroup && thumbGroup) {
+        thumbGroup.setAttribute('role', 'toolbar');
+        const syncTabIndex = () => {
+          let current = thumbnails.indexOf(document.activeElement);
+          if (current < 0) current = thumbnails.findIndex((t) => t.getAttribute('aria-current') === 'true');
+          if (current < 0) current = 0;
+          thumbnails.forEach((thumb, i) => { thumb.tabIndex = i === current ? 0 : -1; });
+        };
+        thumbGroup.addEventListener('focusin', syncTabIndex);
+        thumbGroup.addEventListener('keydown', (event) => {
+          if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
+          const current = thumbnails.indexOf(document.activeElement);
+          if (current < 0) return;
+          const next = (current + (event.key === 'ArrowLeft' ? -1 : 1) + thumbnails.length) % thumbnails.length;
+          event.preventDefault();
+          event.stopImmediatePropagation();
+          thumbnails.forEach((thumb, i) => { thumb.tabIndex = i === next ? 0 : -1; });
+          thumbnails[next].focus({ preventScroll: true });
+        }, true);
+        syncTabIndex();
+      }
+    })();
+  </script>
+
