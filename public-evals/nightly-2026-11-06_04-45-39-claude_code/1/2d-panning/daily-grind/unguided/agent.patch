+
+      function keyLoop(prev) {
+        keyFrame = requestAnimationFrame(function (now) {
+          var dt = Math.min(32, now - prev);
+          var vx = 0, vy = 0;
+          Object.keys(held).forEach(function (k) { vx += KEY_DIRS[k][0]; vy += KEY_DIRS[k][1]; });
+          if (vx === 0 && vy === 0) {
+            if (!Object.keys(held).length) { keyFrame = 0; return; }
+          } else {
+            var len = Math.hypot(vx, vy);
+            scrollByXY(vx / len * KEY_SPEED * dt, vy / len * KEY_SPEED * dt);
+          }
+          keyLoop(now);
+        });
+      }
+
+      viewport.addEventListener('keydown', function (e) {
+        if (e.target !== viewport) return;                  // don't steal keys from pins
+        var key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
+        if (!KEY_DIRS[key] || e.altKey || e.ctrlKey || e.metaKey) return;
+        e.preventDefault();
+        stopInertia();
+        dismissHint();
+        held[key] = true;
+        if (!keyFrame) keyLoop(performance.now());
+      });
+
+      function releaseKey(e) {
+        var key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
+        delete held[key];
+      }
+      viewport.addEventListener('keyup', releaseKey);
+      viewport.addEventListener('blur', function () { held = {}; });
+
+      /* ---------- Initial view: centre on downtown ---------- */
+      function centreInitial() {
+        viewport.scrollLeft = Math.max(0, 1200 - viewport.clientWidth / 2);
+        viewport.scrollTop = Math.max(0, 560 - viewport.clientHeight / 2);
+      }
+      centreInitial();
+    })();
+  </script>
+
 </body>
 
