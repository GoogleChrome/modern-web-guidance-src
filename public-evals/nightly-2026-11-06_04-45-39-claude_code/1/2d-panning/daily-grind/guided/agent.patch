+  <script>
+    (() => {
+      const viewport = document.getElementById('cafe-map');
+      if (!viewport) return;
+
+      // Start centered on the flagship roastery.
+      const centerMap = () => {
+        viewport.scrollLeft = 1200 - viewport.clientWidth / 2;
+        viewport.scrollTop = 700 - viewport.clientHeight / 2;
+      };
+      centerMap();
+
+      // Browsers with scroll-axis-lock support pan freely natively (touch, wheel,
+      // trackpad). Elsewhere, apply raw 2D deltas ourselves to avoid axis railing.
+      const nativeFreePan = CSS.supports('scroll-axis-lock', 'none');
+
+      if (!nativeFreePan) {
+        viewport.addEventListener('wheel', (e) => {
+          if (e.ctrlKey) return; // leave pinch-zoom gestures alone
+          e.preventDefault();
+          const scale = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? viewport.clientHeight : 1;
+          viewport.scrollLeft += e.deltaX * scale;
+          viewport.scrollTop += e.deltaY * scale;
+        }, { passive: false });
+      }
+
+      // Pointer drag-to-pan: always enabled for mouse (desktop has no native drag
+      // scrolling); for touch/pen only when native free panning is unavailable.
+      let last = null;
+
+      viewport.addEventListener('pointerdown', (e) => {
+        if (nativeFreePan && e.pointerType !== 'mouse') return;
+        const rect = viewport.getBoundingClientRect();
+        if (
+          !e.isPrimary ||
+          e.button !== 0 ||
+          e.clientX - rect.left - viewport.clientLeft >= viewport.clientWidth ||
+          e.clientY - rect.top - viewport.clientTop >= viewport.clientHeight
+        ) {
+          return; // ignore secondary buttons and native scrollbar clicks
+        }
+        last = { x: e.clientX, y: e.clientY };
+        viewport.setPointerCapture(e.pointerId);
+        viewport.classList.add('is-panning');
+      });
+
+      viewport.addEventListener('pointermove', (e) => {
+        if (!last) return;
+        viewport.scrollLeft -= e.clientX - last.x;
+        viewport.scrollTop -= e.clientY - last.y;
+        last = { x: e.clientX, y: e.clientY };
+      });
+
+      const endPan = () => {
+        last = null;
+        viewport.classList.remove('is-panning');
+      };
+      viewport.addEventListener('pointerup', endPan);
+      viewport.addEventListener('pointercancel', endPan);
+      viewport.addEventListener('lostpointercapture', endPan);
+    })();
+  </script>
+
