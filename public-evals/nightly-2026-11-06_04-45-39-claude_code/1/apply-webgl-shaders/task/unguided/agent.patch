diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -92,8 +92,68 @@
       font-size: 3rem;
       margin-bottom: 1rem;
     }
 
+    /* WebGL ripple layer (progressively enhanced by js/hero-ripple.js) */
+    @property --ripple-fill {
+      syntax: '<color>';
+      inherits: false;
+      initial-value: transparent;
+    }
+
+    .hero {
+      position: relative;
+      overflow: hidden;
+    }
+
+    .hero > * {
+      position: relative;
+    }
+
+    .hero-ripple-canvas {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      pointer-events: none; /* clicks & selection pass through to real DOM */
+      z-index: 2;
+    }
+
+    /* Colours the shader layer paints for each element */
+    .hero [data-ripple] {
+      --ripple-ink: #ffffff;
+    }
+
+    .hero .btn[data-ripple] {
+      --ripple-fill: var(--primary);
+      transition: background 0.3s, --ripple-fill 0.3s;
+    }
+
+    .hero .btn[data-ripple]:hover,
+    .hero .btn[data-ripple]:focus-visible {
+      --ripple-fill: #3e2723;
+    }
+
+    /* While the GL layer is live, the DOM keeps layout, selection, focus and
+       clicks, but its pixels are drawn (distorted) by the canvas instead. */
+    .hero.is-rippling [data-ripple] {
+      color: transparent;
+    }
+
+    .hero.is-rippling .btn[data-ripple] {
+      background: transparent;
+    }
+
+    .hero.is-rippling [data-ripple]::selection {
+      color: transparent;
+      background: rgba(255, 171, 64, 0.45);
+    }
+
+    .hero.is-rippling .btn[data-ripple]:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 3px;
+    }
+
     /* Content Sections */
     .container {
       max-width: 1100px;
       margin: 40px auto;
