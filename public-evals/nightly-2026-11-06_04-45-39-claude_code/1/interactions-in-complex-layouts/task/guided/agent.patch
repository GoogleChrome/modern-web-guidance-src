+  <script type="module">
+    const board = document.getElementById('board');
+    const statusEl = document.getElementById('board-status');
+    const columns = [...board.querySelectorAll('.board-column')];
+    const hasMoveBefore = 'moveBefore' in Element.prototype;
+    let nextId = 1004;
+
+    const listOf = (column) => column.querySelector('.card-list');
+    const labelOf = (column) => column.querySelector('h3').textContent;
+    const titleOf = (card) => card.querySelector('.card-title').textContent;
+
+    // Atomic move that preserves focus/state where supported; skips no-op moves
+    // so we never dirty layout without a reason.
+    function place(parent, node, ref = null) {
+      if (ref === node) return false;
+      if (node.parentNode === parent && node.nextElementSibling === ref) return false;
+      if (hasMoveBefore && node.isConnected) {
+        try { parent.moveBefore(node, ref); return true; } catch { /* fall through */ }
+      }
+      parent.insertBefore(node, ref);
+      return true;
+    }
+
+    function updateCount(column) {
+      const n = listOf(column).childElementCount;
+      const badge = column.querySelector('.count');
+      badge.textContent = n;
+      badge.setAttribute('aria-label', `${n} orders`);
+    }
+
+    function announce(msg) {
+      statusEl.textContent = msg;
+    }
+
+    function createCard(title, meta) {
+      const id = nextId++;
+      const li = document.createElement('li');
+      li.className = 'card order-card';
+      li.tabIndex = 0;
+      li.dataset.id = id;
+      li.innerHTML = '<span class="grip" aria-hidden="true">⠿</span><span class="card-body"><span class="card-title"></span><span class="card-meta"></span></span>';
+      li.querySelector('.card-title').textContent = title;
+      li.querySelector('.card-meta').textContent = `#${id} · ${meta}`;
+      return li;
+    }
+
+    /* ---------- Adding orders ---------- */
+    const form = document.getElementById('new-order');
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const name = form.elements.name.value.trim();
+      if (!name) return;
+      listOf(columns[0]).append(createCard(name, 'Just ordered'));
+      updateCount(columns[0]);
+      announce(`${name} added to Queued`);
+      form.reset();
+    });
+
+    const MENU = ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew', 'Vanilla Cortado', 'Flat White',
+      'Caramel Macchiato', 'Chai Latte', 'Matcha Latte', 'Mocha', 'Americano', 'Cappuccino', 'Nitro Cold Brew'];
+    const NOTES = ['Small', 'Medium', 'Large', 'Extra shot', 'Oat milk', 'Almond milk', 'Decaf', 'To go'];
+
+    document.getElementById('rush').addEventListener('click', () => {
+      // Build off-DOM, insert once: a single contained reflow for 250 cards.
+      const frag = document.createDocumentFragment();
+      for (let i = 0; i < 250; i++) {
+        frag.append(createCard(MENU[(Math.random() * MENU.length) | 0], NOTES[(Math.random() * NOTES.length) | 0]));
+      }
+      listOf(columns[0]).append(frag);
+      updateCount(columns[0]);
+      announce('250 orders added to Queued');
+    });
+
+    /* ---------- Pointer drag & drop ---------- */
+    const DRAG_THRESHOLD = 4;
+    const SCROLL_EDGE = 48;
+    const SCROLL_SPEED = 14;
+    let drag = null;
+
+    board.addEventListener('dragstart', (e) => e.preventDefault());
+
+    board.addEventListener('pointerdown', (e) => {
+      const card = e.target.closest('.order-card');
+      if (!card || drag || e.button !== 0 || !e.isPrimary) return;
+      // Touch drags only start from the grip so columns stay scrollable by finger.
+      if (e.pointerType === 'touch' && !e.target.closest('.grip')) return;
+
+      drag = {
+        card,
+        pointerId: e.pointerId,
+        startX: e.clientX,
+        startY: e.clientY,
+        x: e.clientX,
+        y: e.clientY,
+        active: false,
+        dirty: true,
+        ghost: null,
+        offsetX: 0,
+        offsetY: 0,
+        raf: 0,
+        fromColumn: card.closest('.board-column'),
+        originList: card.parentNode,
+        originNext: card.nextElementSibling,
+        overColumn: null,
+      };
+      // Document-level listeners: the card gets reparented mid-drag, which
+      // would drop pointer capture.
+      document.addEventListener('pointermove', onPointerMove);
+      document.addEventListener('pointerup', onPointerUp);
+      document.addEventListener('pointercancel', onPointerCancel);
+      document.addEventListener('keydown', onDragKey);
+    });
+
+    function onPointerMove(e) {
+      if (e.pointerId !== drag.pointerId) return;
+      drag.x = e.clientX;
+      drag.y = e.clientY;
+      drag.dirty = true;
+      if (!drag.active) {
+        if (Math.hypot(drag.x - drag.startX, drag.y - drag.startY) < DRAG_THRESHOLD) return;
+        beginDrag();
+      }
+      e.preventDefault();
+    }
+
+    function beginDrag() {
+      const { card } = drag;
+      // One measurement at drag start; everything after is transform-only.
+      const rect = card.getBoundingClientRect();
+      drag.offsetX = drag.startX - rect.left;
+      drag.offsetY = drag.startY - rect.top;
+
+      // Columns use paint/layout containment (which traps position:fixed), so
+      // the ghost lives on <body>, outside every contained subtree.
+      const ghost = card.cloneNode(true);
+      ghost.className = 'order-card drag-ghost';
+      ghost.removeAttribute('tabindex');
+      ghost.setAttribute('aria-hidden', 'true');
+      ghost.style.width = `${rect.width}px`;
+      ghost.style.transform = `translate3d(${rect.left}px, ${rect.top}px, 0)`;
+      document.body.append(ghost);
+
+      drag.ghost = ghost;
+      drag.active = true;
+      card.classList.add('is-placeholder');
+      document.documentElement.classList.add('is-dragging');
+      window.getSelection()?.removeAllRanges();
+      drag.raf = requestAnimationFrame(tick);
+    }
+
+    // All visual work is batched into one rAF per frame.
+    function tick() {
+      if (!drag) return;
+      const { x, y, ghost } = drag;
+      if (drag.dirty) {
+        drag.dirty = false;
+        ghost.style.transform = `translate3d(${x - drag.offsetX}px, ${y - drag.offsetY}px, 0) rotate(2deg)`;
+        hitTest(x, y);
+      }
+      autoScroll(y);
+      drag.raf = requestAnimationFrame(tick);
+    }
+
+    function setOverColumn(column) {
+      if (drag.overColumn === column) return;
+      drag.overColumn?.classList.remove('is-over');
+      column?.classList.add('is-over');
+      drag.overColumn = column;
+    }
+
+    function hitTest(x, y) {
+      // The ghost has pointer-events:none, so this sees what's underneath.
+      // Only transforms changed since last frame, so layout is clean and cheap.
+      const el = document.elementFromPoint(x, y);
+      const list = el?.closest('#board .card-list');
+      setOverColumn(list ? list.closest('.board-column') : null);
+      if (!list) return;
+
+      const { card } = drag;
+      const over = el.closest('.order-card');
+      if (over && over !== card) {
+        const r = over.getBoundingClientRect();
+        place(list, card, y < r.top + r.height / 2 ? over : over.nextElementSibling);
+      } else if (!over) {
+        const last = list.lastElementChild;
+        if (!last || (last !== card && y > last.getBoundingClientRect().bottom)) {
+          place(list, card, null);
+        }
+      }
+    }
+
+    function autoScroll(y) {
+      const list = drag.overColumn && listOf(drag.overColumn);
+      if (!list) return;
+      const r = list.getBoundingClientRect();
+      let delta = 0;
+      if (y < r.top + SCROLL_EDGE) delta = -SCROLL_SPEED;
+      else if (y > r.bottom - SCROLL_EDGE) delta = SCROLL_SPEED;
+      if (!delta) return;
+      const before = list.scrollTop;
+      list.scrollTop = before + delta;
+      if (list.scrollTop !== before) drag.dirty = true; // content moved under pointer
+    }
+
+    function endDrag(commit) {
+      const d = drag;
+      drag = null;
+      document.removeEventListener('pointermove', onPointerMove);
+      document.removeEventListener('pointerup', onPointerUp);
+      document.removeEventListener('pointercancel', onPointerCancel);
+      document.removeEventListener('keydown', onDragKey);
+      if (!d.active) return;
+
+      cancelAnimationFrame(d.raf);
+      d.ghost.remove();
+      d.overColumn?.classList.remove('is-over');
+      d.card.classList.remove('is-placeholder');
+      document.documentElement.classList.remove('is-dragging');
+
+      if (!commit) {
+        place(d.originList, d.card, d.originNext);
+        announce(`Move of ${titleOf(d.card)} cancelled`);
+      } else {
+        const toColumn = d.card.closest('.board-column');
+        if (toColumn !== d.fromColumn) {
+          updateCount(d.fromColumn);
+          updateCount(toColumn);
+          announce(`${titleOf(d.card)} moved to ${labelOf(toColumn)}`);
+        }
+      }
+      d.card.focus({ preventScroll: true });
+    }
+
+    function onPointerUp(e) {
+      if (e.pointerId === drag.pointerId) endDrag(true);
+    }
+
+    function onPointerCancel(e) {
+      if (e.pointerId === drag.pointerId) endDrag(false);
+    }
+
+    function onDragKey(e) {
+      if (e.key === 'Escape' && drag?.active) {
+        e.preventDefault();
+        endDrag(false);
+      }
+    }
+
+    /* ---------- Keyboard moves ---------- */
+    board.addEventListener('keydown', (e) => {
+      const card = e.target;
+      if (drag || !card.classList?.contains('order-card')) return;
+      const column = card.closest('.board-column');
+      const list = card.parentNode;
+      let msg;
+
+      switch (e.key) {
+        case 'ArrowLeft':
+        case 'ArrowRight': {
+          const target = columns[columns.indexOf(column) + (e.key === 'ArrowLeft' ? -1 : 1)];
+          if (!target) return;
+          place(listOf(target), card, null);
+          updateCount(column);
+          updateCount(target);
+          msg = `${titleOf(card)} moved to ${labelOf(target)}`;
+          break;
+        }
+        case 'ArrowUp': {
+          const prev = card.previousElementSibling;
+          if (!prev) return;
+          place(list, card, prev);
+          msg = `${titleOf(card)} moved up`;
+          break;
+        }
+        case 'ArrowDown': {
+          const next = card.nextElementSibling;
+          if (!next) return;
+          place(list, card, next.nextElementSibling);
+          msg = `${titleOf(card)} moved down`;
+          break;
+        }
+        default:
+          return;
+      }
+      e.preventDefault();
+      // insertBefore() fallback drops focus; moveBefore() keeps it.
+      if (document.activeElement !== card) card.focus({ preventScroll: true });
+      card.scrollIntoView({ block: 'nearest' });
+      announce(msg);
+    });
+  </script>
