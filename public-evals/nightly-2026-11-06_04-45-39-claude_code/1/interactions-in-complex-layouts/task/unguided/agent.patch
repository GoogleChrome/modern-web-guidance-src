+  <script>
+    (() => {
+      'use strict';
+
+      const STATUSES = ['queued', 'brewing', 'ready'];
+      const board = document.getElementById('order-board');
+      const live = document.getElementById('board-live');
+
+      // Cache column elements once – never query the DOM in hot paths.
+      const columns = {};
+      for (const el of board.querySelectorAll('.board-column')) {
+        columns[el.dataset.status] = {
+          el,
+          list: el.querySelector('.column-list'),
+          count: el.querySelector('.column-count'),
+          n: 0,
+        };
+      }
+
+      // Batch counter text updates into a single frame.
+      let countsDirty = false;
+      function flushCounts() {
+        countsDirty = false;
+        for (const s of STATUSES) columns[s].count.textContent = columns[s].n;
+      }
+      function markCounts() {
+        if (!countsDirty) { countsDirty = true; requestAnimationFrame(flushCounts); }
+      }
+
+      // ---------- Card creation (template clone is far cheaper than innerHTML per card) ----------
+      const tpl = document.createElement('template');
+      tpl.innerHTML =
+        '<div class="card order-card" role="listitem" tabindex="0">' +
+        '<span class="grip" aria-hidden="true">⠿</span>' +
+        '<div class="order-body"><div class="order-name"></div><div class="order-meta"></div></div>' +
+        '<button type="button" class="advance" aria-label="Move to next stage">›</button>' +
+        '</div>';
+      const proto = tpl.content.firstElementChild;
+      let nextId = 1;
+
+      function createCard(name) {
+        const card = proto.cloneNode(true);
+        const id = nextId++;
+        card.dataset.id = id;
+        card.firstChild.nextSibling.firstChild.textContent = name;
+        card.firstChild.nextSibling.lastChild.textContent =
+          '#' + id + ' · ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
+        return card;
+      }
+
+      function addOrders(names, status = 'queued') {
+        const frag = document.createDocumentFragment(); // single DOM insertion
+        for (const n of names) frag.appendChild(createCard(n));
+        columns[status].list.appendChild(frag);
+        columns[status].n += names.length;
+        markCounts();
+      }
+
+      function moveCard(card, toStatus, beforeNode = null) {
+        const from = card.parentNode.parentNode.dataset.status;
+        columns[toStatus].list.insertBefore(card, beforeNode);
+        if (from !== toStatus) {
+          columns[from].n--;
+          columns[toStatus].n++;
+          markCounts();
+          live.textContent = card.querySelector('.order-name').textContent + ' moved to ' + toStatus;
+        }
+      }
+
+      // Seed orders
+      addOrders(['Maple Oat Latte'], 'queued');
+      addOrders(['Dark Roast Espresso'], 'brewing');
+      addOrders(['Cold Brew'], 'ready');
+
+      // ---------- Controls ----------
+      const form = document.getElementById('order-form');
+      const input = document.getElementById('order-input');
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const v = input.value.trim();
+        if (!v) return;
+        addOrders([v]);
+        input.value = '';
+      });
+
+      const MENU = ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew', 'Flat White', 'Cortado',
+        'Vanilla Cappuccino', 'Chai Latte', 'Matcha Latte', 'Mocha', 'Americano', 'Honey Lavender Latte'];
+      document.getElementById('rush-btn').addEventListener('click', () => {
+        const names = new Array(500);
+        for (let i = 0; i < 500; i++) names[i] = MENU[(Math.random() * MENU.length) | 0];
+        addOrders(names);
+      });
+
+      document.getElementById('clear-ready-btn').addEventListener('click', () => {
+        const c = columns.ready;
+        c.list.textContent = ''; // one mutation, no per-node removal
+        c.n = 0;
+        markCounts();
+      });
+
+      // Advance button + keyboard moves (event delegation: one listener for any number of cards)
+      board.addEventListener('click', (e) => {
+        const btn = e.target.closest('.advance');
+        if (!btn) return;
+        const card = btn.closest('.order-card');
+        const status = card.parentNode.parentNode.dataset.status;
+        const idx = STATUSES.indexOf(status);
+        if (idx === STATUSES.length - 1) {
+          card.remove();
+          columns.ready.n--;
+          markCounts();
+          live.textContent = 'Order picked up';
+        } else {
+          moveCard(card, STATUSES[idx + 1]);
+        }
+      });
+
+      board.addEventListener('keydown', (e) => {
+        const card = e.target.closest && e.target.closest('.order-card');
+        if (!card || e.target !== card) return;
+        const status = card.parentNode.parentNode.dataset.status;
+        const idx = STATUSES.indexOf(status);
+        if (e.key === 'ArrowRight' && idx < STATUSES.length - 1) moveCard(card, STATUSES[idx + 1]);
+        else if (e.key === 'ArrowLeft' && idx > 0) moveCard(card, STATUSES[idx - 1]);
+        else if (e.key === 'ArrowUp' && card.previousElementSibling) card.parentNode.insertBefore(card, card.previousElementSibling);
+        else if (e.key === 'ArrowDown' && card.nextElementSibling) card.parentNode.insertBefore(card.nextElementSibling, card);
+        else return;
+        e.preventDefault();
+        card.focus();
+      });
+
+      // ---------- Drag & drop (pointer events + rAF, read/write phases separated) ----------
+      const layer = document.createElement('div');
+      layer.className = 'drag-layer';
+      document.body.appendChild(layer);
+
+      const placeholder = document.createElement('div');
+      placeholder.className = 'card-placeholder';
+
+      const DRAG_THRESHOLD = 4;
+      const EDGE = 40;          // px from list edge that triggers auto-scroll
+      const MAX_SCROLL = 18;    // px per frame
+
+      let pending = null;       // pointerdown recorded, threshold not yet passed
+      let drag = null;          // active drag state
+      let rafId = 0;
+
+      board.addEventListener('pointerdown', (e) => {
+        if (e.button !== 0 || drag) return;
+        const card = e.target.closest('.order-card');
+        if (!card || e.target.closest('.advance')) return;
+        // Touch: only the grip starts a drag so columns stay scrollable.
+        if (e.pointerType === 'touch' && !e.target.closest('.grip')) return;
+        pending = { card, id: e.pointerId, x: e.clientX, y: e.clientY };
+      });
+
+      window.addEventListener('pointermove', (e) => {
+        if (drag) {
+          if (e.pointerId !== drag.id) return;
+          drag.x = e.clientX;
+          drag.y = e.clientY;
+          schedule();
+          return;
+        }
+        if (!pending || e.pointerId !== pending.id) return;
+        if (Math.abs(e.clientX - pending.x) + Math.abs(e.clientY - pending.y) < DRAG_THRESHOLD) return;
+        startDrag(e);
+      }, { passive: true });
+
+      window.addEventListener('pointerup', endDrag);
+      window.addEventListener('pointercancel', (e) => endDrag(e, true));
+      window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drag) endDrag(e, true); });
+
+      function startDrag(e) {
+        const { card } = pending;
+        pending = null;
+
+        // ---- READ phase (one layout, all measurements batched) ----
+        const rect = card.getBoundingClientRect();
+        const colRects = STATUSES.map((s) => {
+          const r = columns[s].list.getBoundingClientRect();
+          return { status: s, left: r.left, right: r.right, top: r.top, bottom: r.bottom };
+        });
+        const originStatus = card.parentNode.parentNode.dataset.status;
+
+        // ---- WRITE phase ----
+        placeholder.style.height = rect.height + 'px';
+        card.parentNode.insertBefore(placeholder, card);
+        card.classList.add('dragging');
+        card.style.width = rect.width + 'px';
+        card.style.height = rect.height + 'px';
+        layer.appendChild(card);
+        document.body.classList.add('is-dragging');
+
+        drag = {
+          id: e.pointerId,
+          card,
+          originStatus,
+          originNext: placeholder.nextSibling,
+          offX: e.clientX - rect.left,
+          offY: e.clientY - rect.top,
+          x: e.clientX,
+          y: e.clientY,
+          colRects,
+          over: null,
+        };
+        schedule();
+      }
+
+      function schedule() {
+        if (!rafId) rafId = requestAnimationFrame(frame);
+      }
+
+      function hitColumn(x, y) {
+        for (const c of drag.colRects) {
+          if (x >= c.left && x <= c.right && y >= c.top - 60 && y <= c.bottom) return c;
+        }
+        return null;
+      }
+
+      // Binary search for the insertion point using offsetTop (relative to the
+      // contained list), so cost is O(log n) reads even with thousands of cards.
+      function findBefore(list, yInList) {
+        const kids = list.children;
+        let lo = 0, hi = kids.length;
+        while (lo < hi) {
+          const mid = (lo + hi) >> 1;
+          const k = kids[mid];
+          if (k.offsetTop + k.offsetHeight / 2 < yInList) lo = mid + 1;
+          else hi = mid;
+        }
+        return lo < kids.length ? kids[lo] : null;
+      }
+
+      function frame() {
+        rafId = 0;
+        if (!drag) return;
+        const { card, x, y } = drag;
+
+        // Compositor-only move of the dragged card.
+        card.style.transform = `translate3d(${x - drag.offX}px, ${y - drag.offY}px, 0) rotate(1.5deg)`;
+
+        const hit = hitColumn(x, y);
+        const prevOver = drag.over;
+        if (hit !== prevOver) {
+          if (prevOver) columns[prevOver.status].el.classList.remove('is-over');
+          if (hit) columns[hit.status].el.classList.add('is-over');
+          drag.over = hit;
+        }
+        if (!hit) return;
+
+        const list = columns[hit.status].list;
+
+        // ---- READ (layout is scoped to this column thanks to `contain: strict`) ----
+        const scrollTop = list.scrollTop;
+        let before = findBefore(list, y - hit.top + scrollTop);
+        let scrollBy = 0;
+        if (y < hit.top + EDGE) scrollBy = -Math.ceil(MAX_SCROLL * (1 - Math.max(0, y - hit.top) / EDGE));
+        else if (y > hit.bottom - EDGE) scrollBy = Math.ceil(MAX_SCROLL * (1 - Math.max(0, hit.bottom - y) / EDGE));
+
+        // ---- WRITE ----
+        if (before === placeholder) before = placeholder.nextSibling;
+        if (placeholder.parentNode !== list || placeholder.nextSibling !== before) {
+          list.insertBefore(placeholder, before);
+        }
+        if (scrollBy) {
+          list.scrollTop = scrollTop + scrollBy;
+          schedule(); // keep auto-scrolling while the pointer rests at the edge
+        }
+      }
+
+      function endDrag(e, cancel = false) {
+        if (pending && (e.pointerId === undefined || e.pointerId === pending.id)) pending = null;
+        if (!drag || (e.pointerId !== undefined && e.type !== 'keydown' && e.pointerId !== drag.id)) return;
+        if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
+
+        const { card, originStatus, originNext } = drag;
+        if (drag.over) columns[drag.over.status].el.classList.remove('is-over');
+
+        card.classList.remove('dragging');
+        card.style.transform = card.style.width = card.style.height = '';
+
+        // Put the card back where it came from, then move it to the drop target
+        // so counters stay consistent.
+        const originList = columns[originStatus].list;
+        originList.insertBefore(card, originNext && originNext.parentNode === originList ? originNext : null);
+
+        if (!cancel && placeholder.parentNode) {
+          const target = placeholder.parentNode.parentNode.dataset.status;
+          moveCard(card, target, placeholder);
+        }
+        placeholder.remove();
+        document.body.classList.remove('is-dragging');
+        drag = null;
+        card.focus({ preventScroll: true });
+      }
+
+      // Suppress the click that follows a drag on the advance button etc.
+      board.addEventListener('dragstart', (e) => e.preventDefault());
+    })();
+  </script>
+
