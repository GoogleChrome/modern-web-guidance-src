+  <script type="module">
+    // On-device translation of menu descriptions and story text using the
+    // built-in Translator API (Chrome/Edge desktop). Content never leaves the device.
+    const SOURCE_LANG = 'en';
+    const RTL_LANGS = new Set(['ar', 'he']);
+
+    const select = document.getElementById('lang-select');
+    const status = document.getElementById('translate-status');
+    const targets = [...document.querySelectorAll('[data-translate]')];
+
+    // Remember the original English text so we can always translate from the
+    // source (avoids compounding errors) and restore instantly.
+    const originals = new Map(targets.map((el) => [el, el.textContent.trim()]));
+    const translators = new Map();
+    let requestId = 0;
+
+    function setStatus(msg) {
+      status.textContent = msg;
+    }
+
+    function restoreOriginal() {
+      for (const el of targets) {
+        el.textContent = originals.get(el);
+        el.removeAttribute('lang');
+        el.removeAttribute('dir');
+        el.classList.remove('is-translating');
+      }
+    }
+
+    if (!('Translator' in self)) {
+      select.disabled = true;
+      select.title = 'On-device translation is not supported in this browser';
+      setStatus('On-device translation is not supported in this browser. Try a recent desktop version of Chrome or Edge.');
+    } else {
+      select.addEventListener('change', () => translatePage(select.value));
+    }
+
+    async function getTranslator(targetLanguage, id) {
+      if (translators.has(targetLanguage)) return translators.get(targetLanguage);
+
+      const options = { sourceLanguage: SOURCE_LANG, targetLanguage };
+      const availability = await Translator.availability(options);
+
+      if (availability === 'unavailable') return null;
+      if (availability !== 'available') setStatus('Downloading language pack…');
+
+      // The select's change event comes from a user gesture, which is required
+      // when create() needs to download (or attach to a download of) a model.
+      const translator = await Translator.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            if (id === requestId) {
+              setStatus(`Downloading language pack… ${Math.round(e.loaded * 100)}%`);
+            }
+          });
+        },
+      });
+      translators.set(targetLanguage, translator);
+      return translator;
+    }
+
+    async function translatePage(targetLanguage) {
+      const id = ++requestId;
+      const label = select.selectedOptions[0].textContent;
+
+      if (targetLanguage === SOURCE_LANG) {
+        restoreOriginal();
+        setStatus('');
+        return;
+      }
+
+      try {
+        setStatus(`Preparing ${label} translation…`);
+        const translator = await getTranslator(targetLanguage, id);
+        if (id !== requestId) return; // a newer selection superseded this one
+
+        if (!translator) {
+          setStatus(`${label} isn't available for on-device translation on this device.`);
+          return;
+        }
+
+        setStatus(`Translating to ${label}…`);
+        targets.forEach((el) => el.classList.add('is-translating'));
+
+        const results = await Promise.all(
+          targets.map((el) => translator.translate(originals.get(el)))
+        );
+        if (id !== requestId) return;
+
+        targets.forEach((el, i) => {
+          el.textContent = results[i];
+          el.lang = targetLanguage;
+          el.dir = RTL_LANGS.has(targetLanguage) ? 'rtl' : 'ltr';
+        });
+        setStatus(`Translated on your device to ${label}.`);
+      } catch (err) {
+        if (id !== requestId) return;
+        console.error(err);
+        restoreOriginal();
+        select.value = SOURCE_LANG;
+        setStatus(
+          err?.name === 'NotAllowedError'
+            ? 'Please choose the language again to start the download.'
+            : 'Sorry, translation failed. Showing the original English text.'
+        );
+      } finally {
+        if (id === requestId) targets.forEach((el) => el.classList.remove('is-translating'));
+      }
+    }
+  </script>
+
 </body>
 
