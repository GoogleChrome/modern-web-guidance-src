+      const select = document.getElementById('lang-select');
+      const status = document.getElementById('lang-status');
+      const nodes = Array.from(document.querySelectorAll('[data-i18n]'));
+
+      // Normalise whitespace from the HTML source and remember the original copy.
+      const originals = new Map(nodes.map((el) => [el, el.textContent.replace(/\s+/g, ' ').trim()]));
+
+      const hasTranslatorAPI = 'Translator' in self;
+      const translators = new Map(); // target lang -> Translator instance
+      const cache = new Map();       // `${lang}|${key}` -> translated text
+      let requestId = 0;
+
+      const setStatus = (msg) => { status.textContent = msg; };
+      const langName = (code) => select.querySelector(`option[value="${code}"]`)?.textContent || code;
+
+      async function getTranslator(target) {
+        if (!hasTranslatorAPI) return null;
+        if (translators.has(target)) return translators.get(target);
+
+        const opts = { sourceLanguage: SOURCE_LANG, targetLanguage: target };
+        let availability;
+        try {
+          availability = await Translator.availability(opts);
+        } catch {
+          return null;
+        }
+        if (availability === 'unavailable') return null;
+
+        if (availability !== 'available') setStatus(`Downloading ${langName(target)} language pack…`);
+        const translator = await Translator.create({
+          ...opts,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              setStatus(`Downloading ${langName(target)} language pack… ${Math.round(e.loaded * 100)}%`);
+            });
+          }
+        });
+        translators.set(target, translator);
+        return translator;
+      }
+
+      function restoreOriginal() {
+        nodes.forEach((el) => { el.textContent = originals.get(el); });
+        document.documentElement.lang = SOURCE_LANG;
+      }
+
+      async function applyLanguage(target) {
+        const id = ++requestId;
+        const stale = () => id !== requestId;
+
+        if (target === SOURCE_LANG) {
+          restoreOriginal();
+          setStatus('');
+          return;
+        }
+
+        nodes.forEach((el) => { el.dataset.translating = 'true'; });
+        setStatus(`Translating to ${langName(target)}…`);
+
+        let translator = null;
+        try {
+          translator = await getTranslator(target);
+        } catch (err) {
+          // e.g. model download needs a user gesture, or the device lacks resources.
+          console.warn('On-device Translator unavailable, using bundled translations.', err);
+        }
+        if (stale()) return;
+
+        const fallback = FALLBACK[target] || {};
+        let usedFallback = !translator;
+        let missing = 0;
+
+        await Promise.all(nodes.map(async (el) => {
+          const key = el.dataset.i18n;
+          const cacheKey = `${target}|${key}`;
+          let text = cache.get(cacheKey);
+
+          if (text === undefined && translator) {
+            try {
+              text = await translator.translate(originals.get(el));
+            } catch (err) {
+              console.warn(`Translation failed for "${key}"`, err);
+            }
+          }
+          if (text === undefined && fallback[key]) {
+            text = fallback[key];
+            usedFallback = true;
+          }
+          if (text === undefined) {
+            missing++;
+            text = originals.get(el);
+          } else {
+            cache.set(cacheKey, text);
+          }
+          if (!stale()) el.textContent = text;
+        }));
+
+        if (stale()) return;
+        nodes.forEach((el) => { delete el.dataset.translating; });
+        document.documentElement.lang = missing === nodes.length ? SOURCE_LANG : target;
+
+        if (missing === nodes.length) {
+          setStatus(`${langName(target)} isn’t available on this device.`);
+        } else if (translator && !usedFallback) {
+          setStatus('Translated on your device.');
+        } else {
+          setStatus('Showing built-in translation.');
+        }
+      }
+
+      select.addEventListener('change', () => {
