+      // Restore the visitor's previous choice, or suggest their browser language.
+      let initial = null;
+      try { initial = localStorage.getItem(STORAGE_KEY); } catch { /* storage disabled */ }
+      if (!initial) {
+        const browserLang = (navigator.language || '').slice(0, 2).toLowerCase();
+        if (browserLang !== SOURCE_LANG && select.querySelector(`option[value="${browserLang}"]`)) {
+          initial = browserLang;
+        }
+      }
+      if (initial && initial !== SOURCE_LANG && select.querySelector(`option[value="${initial}"]`)) {
+        select.value = initial;
+        applyLanguage(initial);
+      }
+    })();
+  </script>
