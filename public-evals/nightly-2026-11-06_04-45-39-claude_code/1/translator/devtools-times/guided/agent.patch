diff --git a/src/utils/translation.ts b/src/utils/translation.ts
new file mode 100644
index 0000000..81f562d
--- /dev/null
+++ b/src/utils/translation.ts
@@ -0,0 +1,417 @@
+/**
+ * On-device article translation using the built-in Translator and
+ * LanguageDetector APIs (Chrome 138+/Edge 148+ desktop).
+ *
+ * Any element marked with `data-translatable` is treated as an independent
+ * translation root. Its text nodes are translated in place (preserving inline
+ * markup such as links and <strong>), the originals are kept in memory so the
+ * page can be restored or re-translated into another language at any time.
+ */
+
+// ---- Minimal typings for the (not yet in lib.dom) Built-in AI APIs ----------
+
+type Availability = 'unavailable' | 'downloadable' | 'downloading' | 'available';
+
+interface DownloadMonitor extends EventTarget {}
+interface DownloadProgressEvent extends Event {
+  loaded: number;
+}
+
+interface TranslatorOptions {
+  sourceLanguage: string;
+  targetLanguage: string;
+}
+
+interface TranslatorInstance {
+  translate(input: string, options?: { signal?: AbortSignal }): Promise<string>;
+  destroy(): void;
+}
+
+interface TranslatorStatic {
+  availability(options: TranslatorOptions): Promise<Availability>;
+  create(
+    options: TranslatorOptions & {
+      monitor?: (m: DownloadMonitor) => void;
+      signal?: AbortSignal;
+    },
+  ): Promise<TranslatorInstance>;
+}
+
+interface LanguageDetectorInstance {
+  detect(input: string): Promise<{ detectedLanguage: string; confidence: number }[]>;
+}
+
+interface LanguageDetectorStatic {
+  availability(): Promise<Availability>;
+  create(options?: { monitor?: (m: DownloadMonitor) => void }): Promise<LanguageDetectorInstance>;
+}
+
+const getTranslatorApi = (): TranslatorStatic | undefined =>
+  typeof self !== 'undefined' && 'Translator' in self
+    ? ((self as any).Translator as TranslatorStatic)
+    : undefined;
+
+const getDetectorApi = (): LanguageDetectorStatic | undefined =>
+  typeof self !== 'undefined' && 'LanguageDetector' in self
+    ? ((self as any).LanguageDetector as LanguageDetectorStatic)
+    : undefined;
+
+export const isTranslationSupported = () => getTranslatorApi() !== undefined;
+export const isDetectionSupported = () => getDetectorApi() !== undefined;
+
+// ---- Languages ---------------------------------------------------------------
+
+export const LANGUAGES: { code: string; name: string }[] = [
+  { code: 'ar', name: 'العربية (Arabic)' },
+  { code: 'bg', name: 'Български (Bulgarian)' },
+  { code: 'bn', name: 'বাংলা (Bengali)' },
+  { code: 'cs', name: 'Čeština (Czech)' },
+  { code: 'da', name: 'Dansk (Danish)' },
+  { code: 'de', name: 'Deutsch (German)' },
+  { code: 'el', name: 'Ελληνικά (Greek)' },
+  { code: 'en', name: 'English' },
+  { code: 'es', name: 'Español (Spanish)' },
+  { code: 'fi', name: 'Suomi (Finnish)' },
+  { code: 'fr', name: 'Français (French)' },
+  { code: 'he', name: 'עברית (Hebrew)' },
+  { code: 'hi', name: 'हिन्दी (Hindi)' },
+  { code: 'hr', name: 'Hrvatski (Croatian)' },
+  { code: 'hu', name: 'Magyar (Hungarian)' },
+  { code: 'id', name: 'Bahasa Indonesia (Indonesian)' },
+  { code: 'it', name: 'Italiano (Italian)' },
+  { code: 'ja', name: '日本語 (Japanese)' },
+  { code: 'kn', name: 'ಕನ್ನಡ (Kannada)' },
+  { code: 'ko', name: '한국어 (Korean)' },
+  { code: 'lt', name: 'Lietuvių (Lithuanian)' },
+  { code: 'mr', name: 'मराठी (Marathi)' },
+  { code: 'nl', name: 'Nederlands (Dutch)' },
+  { code: 'no', name: 'Norsk (Norwegian)' },
+  { code: 'pl', name: 'Polski (Polish)' },
+  { code: 'pt', name: 'Português (Portuguese)' },
+  { code: 'ro', name: 'Română (Romanian)' },
+  { code: 'ru', name: 'Русский (Russian)' },
+  { code: 'sk', name: 'Slovenčina (Slovak)' },
+  { code: 'sl', name: 'Slovenščina (Slovenian)' },
+  { code: 'sv', name: 'Svenska (Swedish)' },
+  { code: 'ta', name: 'தமிழ் (Tamil)' },
+  { code: 'te', name: 'తెలుగు (Telugu)' },
+  { code: 'th', name: 'ไทย (Thai)' },
+  { code: 'tr', name: 'Türkçe (Turkish)' },
+  { code: 'uk', name: 'Українська (Ukrainian)' },
+  { code: 'vi', name: 'Tiếng Việt (Vietnamese)' },
+  { code: 'zh', name: '中文 (Chinese, Simplified)' },
+  { code: 'zh-Hant', name: '中文 (Chinese, Traditional)' },
+];
+
+const SUPPORTED = new Set(LANGUAGES.map((l) => l.code));
+const RTL = new Set(['ar', 'he']);
+
+/** Map an arbitrary BCP 47 tag to one of the supported codes, if possible. */
+export function normalizeLanguage(tag: string | null | undefined): string | undefined {
+  if (!tag) return undefined;
+  if (SUPPORTED.has(tag)) return tag;
+  const lower = tag.toLowerCase();
+  if (lower === 'zh-tw' || lower === 'zh-hk' || lower.startsWith('zh-hant')) return 'zh-Hant';
+  if (lower === 'nb' || lower === 'nn') return 'no';
+  if (lower === 'iw') return 'he';
+  const base = lower.split('-')[0];
+  return SUPPORTED.has(base) ? base : undefined;
+}
+
+export const languageName = (code: string) =>
+  LANGUAGES.find((l) => l.code === code)?.name ?? code;
+
+// ---- Translation state ---------------------------------------------------------
+
+const ROOT_SELECTOR = '[data-translatable]';
+const SKIP_SELECTOR = 'script, style, noscript, code, pre, svg, textarea, [translate="no"]';
+
+/** Original text of every text node we've touched. */
+const originals = new WeakMap<Text, string>();
+/** Original `lang`/`dir` attributes of each root we've touched. */
+const rootAttrs = new WeakMap<Element, { lang: string | null; dir: string | null }>();
+
+const translators = new Map<string, Promise<TranslatorInstance>>();
+let detectorPromise: Promise<LanguageDetectorInstance> | undefined;
+let generation = 0;
+
+export type ProgressHandler = (info:
+  | { phase: 'detecting' }
+  | { phase: 'downloading'; loaded: number; pair: string }
+  | { phase: 'translating'; done: number; total: number }
+) => void;
+
+function collectTextNodes(root: Element): Text[] {
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const parent = node.parentElement;
+      if (!parent || parent.closest(SKIP_SELECTOR)) return NodeFilter.FILTER_REJECT;
+      // Use the stored original so re-translation always starts from source text.
+      const text = originals.get(node as Text) ?? node.nodeValue ?? '';
+      return text.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+    },
+  });
+  const nodes: Text[] = [];
+  while (walker.nextNode()) nodes.push(walker.currentNode as Text);
+  return nodes;
+}
+
+const originalText = (node: Text) => originals.get(node) ?? node.nodeValue ?? '';
+
+function getRoots(): Element[] {
+  // Exclude nested roots: the outer root already covers their text.
+  return Array.from(document.querySelectorAll(ROOT_SELECTOR)).filter(
+    (el) => !el.parentElement?.closest(ROOT_SELECTOR),
+  );
+}
+
+/** Language declared in markup for the root (closest `lang`), before we changed it. */
+function declaredLanguage(root: Element): string | undefined {
+  const saved = rootAttrs.get(root);
+  if (saved?.lang) return normalizeLanguage(saved.lang);
+  const host = saved ? root.parentElement : root;
+  return normalizeLanguage(host?.closest('[lang]')?.getAttribute('lang'));
+}
+
+function getDetector(onProgress?: ProgressHandler) {
+  const api = getDetectorApi();
+  if (!api) return undefined;
+  detectorPromise ??= api
+    .create({
+      monitor(m) {
+        m.addEventListener('downloadprogress', (e) =>
+          onProgress?.({ phase: 'downloading', loaded: (e as DownloadProgressEvent).loaded, pair: 'language detection' }),
+        );
+      },
+    })
+    .catch((err) => {
+      detectorPromise = undefined;
+      throw err;
+    });
+  return detectorPromise;
+}
+
+async function detectLanguage(
+  root: Element,
+  detector: LanguageDetectorInstance | undefined,
+): Promise<string | undefined> {
+  const fallback = declaredLanguage(root);
+  if (!detector) return fallback;
+  const text = collectTextNodes(root).map(originalText).join(' ').trim();
+  // Detection is unreliable on very short strings — trust the markup instead.
+  if (text.length < 40) return fallback;
+  try {
+    const [best] = await detector.detect(text.slice(0, 2000));
+    if (best && best.confidence >= 0.6) return normalizeLanguage(best.detectedLanguage) ?? fallback;
+  } catch {
+    /* fall through */
+  }
+  return fallback;
+}
+
+/** Status of a language pair on this device ('unavailable' if API missing). */
+export async function pairAvailability(source: string, target: string): Promise<Availability> {
+  const api = getTranslatorApi();
+  if (!api) return 'unavailable';
+  try {
+    return await api.availability({ sourceLanguage: source, targetLanguage: target });
+  } catch {
+    return 'unavailable';
+  }
+}
+
+function getTranslator(source: string, target: string, onProgress?: ProgressHandler) {
+  const api = getTranslatorApi();
+  if (!api) throw new Error('Translator API not supported');
+  const key = `${source}→${target}`;
+  let promise = translators.get(key);
+  if (!promise) {
+    const options = { sourceLanguage: source, targetLanguage: target };
+    promise = api
+      .availability(options)
+      .then((availability) => {
+        if (availability === 'unavailable') {
+          throw new UnsupportedPairError(source, target);
+        }
+        // Must receive the identical options object passed to availability().
+        return api.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) =>
+              onProgress?.({ phase: 'downloading', loaded: (e as DownloadProgressEvent).loaded, pair: key }),
+            );
+          },
+        });
+      })
+      .catch((err) => {
+        translators.delete(key);
+        throw err;
+      });
+    translators.set(key, promise);
+  }
+  return promise;
+}
+
+export class UnsupportedPairError extends Error {
+  constructor(public source: string, public target: string) {
+    super(`Translation from ${languageName(source)} to ${languageName(target)} is not available on this device.`);
+    this.name = 'UnsupportedPairError';
+  }
+}
+
+function setRootLanguage(root: Element, lang: string) {
+  if (!rootAttrs.has(root)) {
+    rootAttrs.set(root, { lang: root.getAttribute('lang'), dir: root.getAttribute('dir') });
+  }
+  root.setAttribute('lang', lang);
+  root.setAttribute('dir', RTL.has(lang) ? 'rtl' : 'ltr');
+  root.setAttribute('data-translated', lang);
+}
+
+function restoreRoot(root: Element) {
+  for (const node of collectTextNodes(root)) {
+    const original = originals.get(node);
+    if (original !== undefined) node.nodeValue = original;
+  }
+  const attrs = rootAttrs.get(root);
+  if (attrs) {
+    attrs.lang === null ? root.removeAttribute('lang') : root.setAttribute('lang', attrs.lang);
+    attrs.dir === null ? root.removeAttribute('dir') : root.setAttribute('dir', attrs.dir);
+    rootAttrs.delete(root);
+  }
+  root.removeAttribute('data-translated');
+  root.removeAttribute('aria-busy');
+}
+
+/** Restore every translatable region on the page to its original text. */
+export function restorePage() {
+  generation++;
+  getRoots().forEach(restoreRoot);
+}
+
+export interface TranslateResult {
+  translated: number;
+  skipped: number;
+}
+
+/**
+ * Translate every `[data-translatable]` region into `target`.
+ * `source` may be a language code or 'auto' to detect per region.
+ *
+ * Call this from a user gesture (click) — creating a translator whose language
+ * pack still needs downloading requires transient user activation.
+ */
+export async function translatePage(
+  source: string,
+  target: string,
+  onProgress?: ProgressHandler,
+): Promise<TranslateResult> {
+  const myGeneration = ++generation;
+  const stale = () => myGeneration !== generation;
+  const roots = getRoots();
+
+  // Kick off model creation synchronously inside the user gesture where possible.
+  let detector: LanguageDetectorInstance | undefined;
+  if (source === 'auto') {
+    onProgress?.({ phase: 'detecting' });
+    const detectorReq = getDetector(onProgress);
+    detector = detectorReq ? await detectorReq.catch(() => undefined) : undefined;
+  } else if (source !== target) {
+    getTranslator(source, target, onProgress).catch(() => {});
+  }
+
+  // Determine each root's source language.
+  const plan: { root: Element; from: string }[] = [];
+  let skipped = 0;
+  for (const root of roots) {
+    const from = source === 'auto' ? await detectLanguage(root, detector) : source;
+    if (stale()) return { translated: 0, skipped: 0 };
+    if (!from || from === target) {
+      // Already in the target language: just show the original text.
+      restoreRoot(root);
+      skipped++;
+      continue;
+    }
+    plan.push({ root, from });
+  }
+
+  // Build a job per text node, deduplicating identical strings per pair.
+  const jobs = plan.flatMap(({ root, from }) =>
+    collectTextNodes(root).map((node) => ({ root, from, node, text: originalText(node) })),
+  );
+  const total = jobs.length;
+  let done = 0;
+  onProgress?.({ phase: 'translating', done, total });
+
+  const cache = new Map<string, Promise<string>>();
+  const errors: unknown[] = [];
+  plan.forEach(({ root }) => root.setAttribute('aria-busy', 'true'));
+
+  await Promise.all(
+    jobs.map(async ({ root, from, node, text }) => {
+      try {
+        const translator = await getTranslator(from, target, onProgress);
+        const match = text.match(/^(\s*)([\s\S]*?)(\s*)$/)!;
+        const [, lead, core, trail] = match;
+        const key = `${from}→${target}\u0000${core}`;
+        let pending = cache.get(key);
+        if (!pending) {
+          pending = translator.translate(core);
+          cache.set(key, pending);
+        }
+        const result = await pending;
+        if (stale()) return;
+        if (!originals.has(node)) originals.set(node, node.nodeValue ?? '');
+        node.nodeValue = lead + result + trail;
+        setRootLanguage(root, target);
+      } catch (err) {
+        errors.push(err);
+      } finally {
+        done++;
+        if (!stale()) onProgress?.({ phase: 'translating', done, total });
+      }
+    }),
+  );
+
+  plan.forEach(({ root }) => root.removeAttribute('aria-busy'));
+  if (stale()) return { translated: 0, skipped: 0 };
+  if (errors.length && errors.length === jobs.length) throw errors[0];
+  return { translated: plan.length, skipped };
+}
+
+// ---- Persisted preference -----------------------------------------------------
+
+const STORAGE_KEY = 'devtools-times:translation';
+
+export interface TranslationPreference {
+  source: string;
+  target: string;
+  active: boolean;
+}
+
+export function loadPreference(): TranslationPreference | undefined {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    return raw ? (JSON.parse(raw) as TranslationPreference) : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+export function savePreference(pref: TranslationPreference) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(pref));
+  } catch {
+    /* storage may be unavailable */
+  }
+}
+
+/** Best guess for a reader's preferred target language. */
+export function defaultTargetLanguage(): string {
+  const page = normalizeLanguage(document.documentElement.lang) ?? 'en';
+  for (const tag of navigator.languages ?? [navigator.language]) {
+    const code = normalizeLanguage(tag);
+    if (code && code !== page) return code;
+  }
+  return page === 'es' ? 'en' : 'es';
+}
