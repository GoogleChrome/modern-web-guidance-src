diff --git a/src/components/TranslateButton.tsx b/src/components/TranslateButton.tsx
new file mode 100644
index 0000000..6e89865
--- /dev/null
+++ b/src/components/TranslateButton.tsx
@@ -0,0 +1,227 @@
+import React, { useEffect, useId, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+import {
+  LANGUAGES,
+  UnsupportedPairError,
+  defaultTargetLanguage,
+  isDetectionSupported,
+  isTranslationSupported,
+  languageName,
+  loadPreference,
+  normalizeLanguage,
+  pairAvailability,
+  restorePage,
+  savePreference,
+  translatePage,
+  type ProgressHandler,
+} from '../utils/translation';
+
+type Status =
+  | { kind: 'idle' }
+  | { kind: 'busy'; message: string; progress?: number }
+  | { kind: 'done'; message: string }
+  | { kind: 'error'; message: string };
+
+export default function TranslateButton() {
+  const id = useId();
+  const popoverId = `translate-panel-${id.replace(/:/g, '')}`;
+  const anchorName = `--translate-trigger-${id.replace(/:/g, '')}`;
+
+  // Rendered on the server as "unsupported" until we can feature-detect.
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [canDetect, setCanDetect] = useState(false);
+  const [source, setSource] = useState('auto');
+  const [target, setTarget] = useState('es');
+  const [activeTarget, setActiveTarget] = useState<string | null>(null);
+  const [status, setStatus] = useState<Status>({ kind: 'idle' });
+
+  const onProgress: ProgressHandler = (info) => {
+    if (info.phase === 'detecting') {
+      setStatus({ kind: 'busy', message: 'Detecting article language…' });
+    } else if (info.phase === 'downloading') {
+      setStatus({
+        kind: 'busy',
+        message: `Downloading language model (${info.pair})… ${Math.round(info.loaded * 100)}%`,
+        progress: info.loaded,
+      });
+    } else {
+      setStatus({
+        kind: 'busy',
+        message: `Translating… ${info.done}/${info.total}`,
+        progress: info.total ? info.done / info.total : 0,
+      });
+    }
+  };
+
+  const run = async (from: string, to: string) => {
+    setStatus({ kind: 'busy', message: 'Preparing on-device translation…' });
+    try {
+      const { translated, skipped } = await translatePage(from, to, onProgress);
+      setActiveTarget(translated ? to : null);
+      savePreference({ source: from, target: to, active: true });
+      setStatus({
+        kind: 'done',
+        message: translated
+          ? `Translated ${translated} section${translated === 1 ? '' : 's'} to ${languageName(to)}.`
+          : skipped
+            ? `This page is already in ${languageName(to)}.`
+            : 'Nothing to translate on this page.',
+      });
+    } catch (err) {
+      setActiveTarget(null);
+      let message = 'Translation failed. Please try again.';
+      if (err instanceof UnsupportedPairError) message = err.message;
+      else if (err instanceof DOMException && err.name === 'NotAllowedError')
+        message = 'The language pack needs to download first — press Translate again to start it.';
+      else if (err instanceof DOMException && err.name === 'QuotaExceededError')
+        message = 'Not enough free disk space to download the language pack.';
+      setStatus({ kind: 'error', message });
+    }
+  };
+
+  // Feature-detect on the client and re-apply the reader's saved preference.
+  useEffect(() => {
+    const isSupported = isTranslationSupported();
+    setSupported(isSupported);
+    setCanDetect(isDetectionSupported());
+    const pref = loadPreference();
+    const initialTarget = normalizeLanguage(pref?.target) ?? defaultTargetLanguage();
+    const initialSource = pref?.source === 'auto' ? 'auto' : normalizeLanguage(pref?.source) ?? 'auto';
+    setTarget(initialTarget);
+    setSource(initialSource);
+    if (!isSupported || !pref?.active) return;
+
+    // Only auto-translate without a click when no download is required.
+    const pageLang = normalizeLanguage(document.documentElement.lang) ?? 'en';
+    const from = initialSource === 'auto' ? pageLang : initialSource;
+    pairAvailability(from, initialTarget).then((availability) => {
+      if (availability === 'available') run(initialSource, initialTarget);
+    });
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  const handleSubmit = (event: React.FormEvent) => {
+    event.preventDefault();
+    run(source, target);
+  };
+
+  const handleRestore = () => {
+    restorePage();
+    setActiveTarget(null);
+    savePreference({ source, target, active: false });
+    setStatus({ kind: 'done', message: 'Showing the original text.' });
+  };
+
+  const busy = status.kind === 'busy';
+  const sourceOptions = canDetect ? [{ code: 'auto', name: 'Detect automatically' }, ...LANGUAGES] : LANGUAGES;
+
+  return (
+    <>
+      <button
+        type="button"
+        popoverTarget={popoverId}
+        className="p-1 flex items-center gap-1 text-gray-600 hover:text-gray-900"
+        style={{ anchorName } as React.CSSProperties}
+        aria-label={activeTarget ? `Translate (currently ${languageName(activeTarget)})` : 'Translate articles'}
+        title="Translate articles"
+      >
+        <LanguageIcon className={`h-6 w-6 ${activeTarget ? 'text-amber-500' : ''}`} aria-hidden="true" />
+        {activeTarget && (
+          <span className="text-xs font-semibold uppercase" aria-hidden="true">
+            {activeTarget}
+          </span>
+        )}
+      </button>
+
+      <div
+        id={popoverId}
+        popover="auto"
+        className="translate-panel w-80 max-w-[calc(100vw-1rem)] rounded-md border border-gray-200 bg-white p-4 text-sm text-gray-800 shadow-lg"
+        style={{ positionAnchor: anchorName } as React.CSSProperties}
+        aria-labelledby={`${popoverId}-title`}
+      >
+        <h2 id={`${popoverId}-title`} className="font-brand text-xl text-gray-900">
+          Translate articles
+        </h2>
+        <p className="mt-1 text-xs text-gray-500">
+          Runs entirely in your browser — article text never leaves your device.
+        </p>
+
+        {supported === false ? (
+          <p className="mt-3 rounded bg-gray-100 p-3 text-gray-700" role="status">
+            On-device translation isn't supported in this browser. Try a recent desktop version of Chrome or Edge.
+          </p>
+        ) : (
+          <form className="mt-3 space-y-3" onSubmit={handleSubmit}>
+            <div className="grid grid-cols-[auto_1fr] items-center gap-x-3 gap-y-2">
+              <label htmlFor={`${popoverId}-from`} className="font-semibold">
+                From
+              </label>
+              <select
+                id={`${popoverId}-from`}
+                value={source}
+                onChange={(e) => setSource(e.target.value)}
+                disabled={busy}
+                className="w-full rounded border border-gray-300 bg-white px-2 py-1"
+              >
+                {sourceOptions.map((l) => (
+                  <option key={l.code} value={l.code}>
+                    {l.name}
+                  </option>
+                ))}
+              </select>
+
+              <label htmlFor={`${popoverId}-to`} className="font-semibold">
+                To
+              </label>
+              <select
+                id={`${popoverId}-to`}
+                value={target}
+                onChange={(e) => setTarget(e.target.value)}
+                disabled={busy}
+                className="w-full rounded border border-gray-300 bg-white px-2 py-1"
+              >
+                {LANGUAGES.map((l) => (
+                  <option key={l.code} value={l.code}>
+                    {l.name}
+                  </option>
+                ))}
+              </select>
+            </div>
+
+            <div className="flex gap-2">
+              <button
+                type="submit"
+                disabled={busy || supported === null || source === target}
+                className="flex-1 rounded bg-gray-800 px-3 py-2 text-xs font-semibold text-white hover:bg-gray-700 disabled:cursor-not-allowed disabled:opacity-50"
+              >
+                Translate
+              </button>
+              <button
+                type="button"
+                onClick={handleRestore}
+                disabled={busy || !activeTarget}
+                className="flex-1 rounded bg-gray-200 px-3 py-2 text-xs font-semibold text-gray-800 hover:bg-gray-300 disabled:cursor-not-allowed disabled:opacity-50"
+              >
+                Show original
+              </button>
+            </div>
+          </form>
+        )}
+
+        <div role="status" aria-live="polite" className="mt-3 min-h-5 text-xs">
+          {status.kind === 'busy' && (
+            <>
+              <span>{status.message}</span>
+              {status.progress !== undefined && (
+                <progress className="mt-1 block h-1.5 w-full accent-amber-500" value={status.progress} max={1} />
+              )}
+            </>
+          )}
+          {status.kind === 'done' && <span className="text-gray-600">{status.message}</span>}
+          {status.kind === 'error' && <span className="text-red-700">{status.message}</span>}
+        </div>
+      </div>
+    </>
+  );
+}
