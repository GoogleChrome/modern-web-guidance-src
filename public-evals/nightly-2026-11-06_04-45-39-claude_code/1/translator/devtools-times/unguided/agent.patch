diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..b5fbf51
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,282 @@
+import React, { useCallback, useEffect, useId, useRef, useState } from 'react';
+import { LanguageIcon, ArrowPathIcon, ArrowUturnLeftIcon } from '@heroicons/react/24/outline';
+import {
+  LANGUAGES,
+  PREFERRED_LANGUAGE_EVENT,
+  detectSourceLanguage,
+  getPreferredLanguage,
+  getScopeLanguage,
+  getScopeOriginalText,
+  getTranslationAvailability,
+  getTranslator,
+  isTranslationSupported,
+  languageLabel,
+  restoreScope,
+  setPreferredLanguage,
+  translateScope,
+} from '../utils/onDeviceTranslation';
+
+interface Props {
+  /**
+   * `full` renders a labelled toolbar (used on the article page),
+   * `compact` renders a small language picker (used in teasers).
+   */
+  variant?: 'full' | 'compact';
+  /** Short description of what gets translated, used for accessible labels. */
+  label?: string;
+}
+
+type Status =
+  | { kind: 'checking' }
+  | { kind: 'unsupported' }
+  | { kind: 'idle' }
+  | { kind: 'preparing' }
+  | { kind: 'downloading'; progress: number }
+  | { kind: 'translating'; done: number; total: number }
+  | { kind: 'translated'; source: string; target: string }
+  | { kind: 'error'; message: string };
+
+const ORIGINAL = '__original__';
+
+function describeError(error: unknown): string {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError') {
+      return 'The browser blocked the language download. Please try again by clicking the button.';
+    }
+    if (error.name === 'NotSupportedError') return 'This language pair is not supported on this device.';
+    if (error.name === 'QuotaExceededError') return 'This text is too long to translate on-device.';
+  }
+  if (error instanceof Error && error.message) return error.message;
+  return 'Translation failed. Please try again.';
+}
+
+export default function TranslateControl({ variant = 'compact', label = 'article' }: Props) {
+  const rootRef = useRef<HTMLDivElement>(null);
+  const abortRef = useRef<AbortController | null>(null);
+  const [status, setStatus] = useState<Status>({ kind: 'checking' });
+  const [target, setTarget] = useState<string>('es');
+  const selectId = useId();
+
+  const getScope = useCallback((): Element | null => {
+    return rootRef.current?.closest('[data-translate-scope]') ?? null;
+  }, []);
+
+  useEffect(() => {
+    setStatus(isTranslationSupported() ? { kind: 'idle' } : { kind: 'unsupported' });
+    setTarget(getPreferredLanguage());
+
+    const onPreferredChange = (event: Event) => {
+      const code = (event as CustomEvent<string>).detail;
+      if (code) setTarget(code);
+    };
+    window.addEventListener(PREFERRED_LANGUAGE_EVENT, onPreferredChange);
+    return () => {
+      window.removeEventListener(PREFERRED_LANGUAGE_EVENT, onPreferredChange);
+      abortRef.current?.abort();
+    };
+  }, []);
+
+  const showOriginal = useCallback(() => {
+    abortRef.current?.abort();
+    const scope = getScope();
+    if (scope) restoreScope(scope);
+    setStatus({ kind: 'idle' });
+  }, [getScope]);
+
+  const translate = useCallback(
+    async (targetLanguage: string) => {
+      const scope = getScope();
+      if (!scope) return;
+
+      abortRef.current?.abort();
+      const controller = new AbortController();
+      abortRef.current = controller;
+
+      setPreferredLanguage(targetLanguage);
+      setStatus({ kind: 'preparing' });
+
+      try {
+        const source = await detectSourceLanguage(getScopeOriginalText(scope), getScopeLanguage(scope));
+        if (controller.signal.aborted) return;
+
+        if (source.split('-')[0] === targetLanguage.split('-')[0] && targetLanguage !== 'zh-Hant') {
+          restoreScope(scope);
+          setStatus({
+            kind: 'error',
+            message: `This ${label} is already in ${languageLabel(source)}.`,
+          });
+          return;
+        }
+
+        const availability = await getTranslationAvailability(source, targetLanguage);
+        if (controller.signal.aborted) return;
+        if (availability === 'unavailable') {
+          setStatus({
+            kind: 'error',
+            message: `Translating from ${languageLabel(source)} to ${languageLabel(targetLanguage)} isn't available on this device.`,
+          });
+          return;
+        }
+        if (availability !== 'available') setStatus({ kind: 'downloading', progress: 0 });
+
+        const translator = await getTranslator(source, targetLanguage, (progress) => {
+          if (!controller.signal.aborted) setStatus({ kind: 'downloading', progress });
+        });
+        if (controller.signal.aborted) return;
+
+        await translateScope(scope, translator, targetLanguage, {
+          signal: controller.signal,
+          onProgress: (done, total) => {
+            if (!controller.signal.aborted) setStatus({ kind: 'translating', done, total });
+          },
+        });
+        if (controller.signal.aborted) return;
+        setStatus({ kind: 'translated', source, target: targetLanguage });
+      } catch (error) {
+        if (controller.signal.aborted) return;
+        restoreScope(scope);
+        setStatus({ kind: 'error', message: describeError(error) });
+      }
+    },
+    [getScope, label],
+  );
+
+  const busy = status.kind === 'preparing' || status.kind === 'downloading' || status.kind === 'translating';
+  const isTranslated = status.kind === 'translated';
+
+  let statusText = '';
+  switch (status.kind) {
+    case 'preparing':
+      statusText = 'Preparing translation…';
+      break;
+    case 'downloading':
+      statusText = `Downloading ${languageLabel(target)} language pack… ${Math.round(status.progress * 100)}%`;
+      break;
+    case 'translating':
+      statusText = `Translating… ${status.done}/${status.total}`;
+      break;
+    case 'translated':
+      statusText = `Translated from ${languageLabel(status.source)} to ${languageLabel(status.target)} on your device.`;
+      break;
+    case 'error':
+      statusText = status.message;
+      break;
+  }
+
+  /* -------------------------------------------------------------- */
+  /* Compact variant (teasers)                                       */
+  /* -------------------------------------------------------------- */
+  if (variant === 'compact') {
+    // Keep the footer tidy: don't render anything where the API is missing.
+    if (status.kind === 'checking' || status.kind === 'unsupported') {
+      return <div ref={rootRef} className="hidden" aria-hidden="true" />;
+    }
+
+    const selectValue = isTranslated ? status.target : '';
+    return (
+      <div ref={rootRef} className="relative flex items-center" title={statusText || `Translate this ${label} on your device`}>
+        <label htmlFor={selectId} className="sr-only">
+          Translate this {label}
+        </label>
+        {busy ? (
+          <ArrowPathIcon className="pointer-events-none absolute left-1 h-4 w-4 animate-spin text-amber-500" aria-hidden="true" />
+        ) : (
+          <LanguageIcon
+            className={`pointer-events-none absolute left-1 h-4 w-4 ${
+              isTranslated ? 'text-amber-500' : status.kind === 'error' ? 'text-red-500' : 'text-gray-400'
+            }`}
+            aria-hidden="true"
+          />
+        )}
+        <select
+          id={selectId}
+          value={selectValue}
+          disabled={busy}
+          onChange={(event) => {
+            const value = event.target.value;
+            if (value === ORIGINAL) showOriginal();
+            else if (value) translate(value);
+          }}
+          className="max-w-[7.5rem] cursor-pointer appearance-none rounded bg-transparent py-1 pl-6 pr-1 text-xs font-medium text-gray-500 hover:bg-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 disabled:cursor-wait"
+        >
+          {isTranslated ? (
+            <option value={ORIGINAL}>Show original</option>
+          ) : (
+            <option value="" disabled>
+              {busy ? 'Translating…' : 'Translate'}
+            </option>
+          )}
+          {isTranslated && <option value={status.target} hidden>{languageLabel(status.target)}</option>}
+          {LANGUAGES.filter((lang) => !isTranslated || lang.code !== status.target).map((lang) => (
+            <option key={lang.code} value={lang.code}>
+              {lang.native} ({lang.label})
+            </option>
+          ))}
+        </select>
+        <span className="sr-only" role="status" aria-live="polite">
+          {statusText}
+        </span>
+      </div>
+    );
+  }
+
+  /* -------------------------------------------------------------- */
+  /* Full variant (article page)                                     */
+  /* -------------------------------------------------------------- */
+  return (
+    <div ref={rootRef} className="flex flex-col items-start gap-1 sm:items-end">
+      <div className="flex flex-wrap items-center gap-2">
+        <LanguageIcon className="h-5 w-5 text-gray-700" aria-hidden="true" />
+        <label htmlFor={selectId} className="text-sm font-semibold text-gray-800">
+          Translate:
+        </label>
+        <select
+          id={selectId}
+          value={target}
+          disabled={busy || status.kind === 'unsupported' || status.kind === 'checking'}
+          onChange={(event) => setTarget(event.target.value)}
+          className="rounded border border-gray-300 bg-white py-1 pl-2 pr-7 text-sm text-gray-800 focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-200 disabled:opacity-60"
+        >
+          {LANGUAGES.map((lang) => (
+            <option key={lang.code} value={lang.code}>
+              {lang.native} ({lang.label})
+            </option>
+          ))}
+        </select>
+        <button
+          type="button"
+          onClick={() => translate(target)}
+          disabled={busy || status.kind === 'unsupported' || status.kind === 'checking' || (isTranslated && status.target === target)}
+          className="inline-flex items-center gap-1 rounded bg-gray-800 px-3 py-1.5 text-xs font-semibold text-white hover:bg-gray-700 disabled:cursor-not-allowed disabled:opacity-50"
+        >
+          {busy && <ArrowPathIcon className="h-4 w-4 animate-spin" aria-hidden="true" />}
+          {busy ? 'Translating' : 'Translate'}
+        </button>
+        {(isTranslated || busy) && (
+          <button
+            type="button"
+            onClick={showOriginal}
+            className="inline-flex items-center gap-1 rounded border border-gray-300 px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-100"
+          >
+            <ArrowUturnLeftIcon className="h-4 w-4" aria-hidden="true" />
+            {busy ? 'Cancel' : 'Show original'}
+          </button>
+        )}
+      </div>
+      <p
+        role="status"
+        aria-live="polite"
+        className={`min-h-4 text-xs ${status.kind === 'error' ? 'text-red-600' : 'text-gray-500'}`}
+      >
+        {status.kind === 'unsupported'
+          ? 'On-device translation isn’t available in this browser. Try a recent version of Chrome on desktop.'
+          : statusText}
+      </p>
+      {status.kind === 'downloading' && (
+        <div className="h-1 w-48 overflow-hidden rounded bg-gray-200" aria-hidden="true">
+          <div className="h-full bg-amber-400 transition-all" style={{ width: `${Math.round(status.progress * 100)}%` }} />
+        </div>
+      )}
+    </div>
+  );
+}
