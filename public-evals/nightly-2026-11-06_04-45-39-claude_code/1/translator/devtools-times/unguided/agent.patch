+/**
+ * On-device translation helpers built on the browser's built-in AI APIs
+ * (`Translator` and `LanguageDetector`). Everything runs locally in the
+ * browser – no article text is sent to a server.
+ *
+ * DOM conventions:
+ *   - `data-translate-scope` marks a container (an article or a teaser) that
+ *     can be translated as a unit.
+ *   - `data-translatable` marks elements inside a scope whose text should be
+ *     translated. Text is translated node-by-node so links and inline
+ *     formatting are preserved.
+ */
+
+export type TranslationAvailability = 'unavailable' | 'downloadable' | 'downloading' | 'available';
+
+interface TranslatorInstance {
+  translate(input: string, options?: { signal?: AbortSignal }): Promise<string>;
+  destroy?(): void;
+}
+
+interface TranslatorFactory {
+  availability(options: { sourceLanguage: string; targetLanguage: string }): Promise<TranslationAvailability>;
+  create(options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    monitor?: (monitor: EventTarget) => void;
+    signal?: AbortSignal;
+  }): Promise<TranslatorInstance>;
+}
+
+interface LanguageDetectorInstance {
+  detect(input: string): Promise<Array<{ detectedLanguage: string; confidence: number }>>;
+}
+
+interface LanguageDetectorFactory {
+  availability(): Promise<TranslationAvailability>;
+  create(): Promise<LanguageDetectorInstance>;
+}
+
+export interface Language {
+  code: string;
+  label: string; // English name
+  native: string; // Endonym
+}
+
+export const LANGUAGES: Language[] = [
+  { code: 'en', label: 'English', native: 'English' },
+  { code: 'es', label: 'Spanish', native: 'Español' },
+  { code: 'fr', label: 'French', native: 'Français' },
+  { code: 'de', label: 'German', native: 'Deutsch' },
+  { code: 'it', label: 'Italian', native: 'Italiano' },
+  { code: 'pt', label: 'Portuguese', native: 'Português' },
+  { code: 'nl', label: 'Dutch', native: 'Nederlands' },
+  { code: 'pl', label: 'Polish', native: 'Polski' },
+  { code: 'tr', label: 'Turkish', native: 'Türkçe' },
+  { code: 'ru', label: 'Russian', native: 'Русский' },
+  { code: 'uk', label: 'Ukrainian', native: 'Українська' },
+  { code: 'ar', label: 'Arabic', native: 'العربية' },
+  { code: 'hi', label: 'Hindi', native: 'हिन्दी' },
+  { code: 'ja', label: 'Japanese', native: '日本語' },
+  { code: 'ko', label: 'Korean', native: '한국어' },
+  { code: 'zh', label: 'Chinese (Simplified)', native: '简体中文' },
+  { code: 'zh-Hant', label: 'Chinese (Traditional)', native: '繁體中文' },
+  { code: 'vi', label: 'Vietnamese', native: 'Tiếng Việt' },
+];
+
+const RTL_LANGUAGES = new Set(['ar', 'he', 'fa', 'ur']);
+const PREFERRED_LANGUAGE_KEY = 'devtools-times:translate-language';
+export const PREFERRED_LANGUAGE_EVENT = 'devtools-times:translate-language-change';
+
+function getTranslatorFactory(): TranslatorFactory | undefined {
+  if (typeof globalThis === 'undefined') return undefined;
+  return (globalThis as unknown as { Translator?: TranslatorFactory }).Translator;
+}
+
+function getLanguageDetectorFactory(): LanguageDetectorFactory | undefined {
+  if (typeof globalThis === 'undefined') return undefined;
+  return (globalThis as unknown as { LanguageDetector?: LanguageDetectorFactory }).LanguageDetector;
+}
+
+export function isTranslationSupported(): boolean {
+  return typeof window !== 'undefined' && !!getTranslatorFactory();
+}
+
+export function languageLabel(code: string): string {
+  const lang = LANGUAGES.find((l) => l.code === code || l.code === baseLanguage(code));
+  return lang ? lang.label : code;
+}
+
+function baseLanguage(code: string): string {
+  return code === 'zh-Hant' ? code : code.split('-')[0];
+}
+
+/* ------------------------------------------------------------------ */
+/* Preferred language (shared between all controls on the page)        */
+/* ------------------------------------------------------------------ */
+
+export function getPreferredLanguage(): string {
+  try {
+    const stored = localStorage.getItem(PREFERRED_LANGUAGE_KEY);
+    if (stored && LANGUAGES.some((l) => l.code === stored)) return stored;
+  } catch {
+    /* storage may be unavailable */
+  }
+  const browserLanguages = typeof navigator !== 'undefined' ? navigator.languages ?? [navigator.language] : [];
+  for (const raw of browserLanguages) {
+    const code = /^zh-(TW|HK|Hant)/i.test(raw) ? 'zh-Hant' : baseLanguage(raw);
+    if (code !== 'en' && LANGUAGES.some((l) => l.code === code)) return code;
+  }
+  return 'es';
+}
+
+export function setPreferredLanguage(code: string): void {
+  try {
+    localStorage.setItem(PREFERRED_LANGUAGE_KEY, code);
+  } catch {
+    /* ignore */
+  }
+  window.dispatchEvent(new CustomEvent(PREFERRED_LANGUAGE_EVENT, { detail: code }));
+}
+
+/* ------------------------------------------------------------------ */
+/* Language detection                                                  */
+/* ------------------------------------------------------------------ */
+
+let detectorPromise: Promise<LanguageDetectorInstance | null> | null = null;
+
+async function getDetector(): Promise<LanguageDetectorInstance | null> {
+  const factory = getLanguageDetectorFactory();
+  if (!factory) return null;
+  if (!detectorPromise) {
+    detectorPromise = (async () => {
+      try {
+        // Only use the detector if its model is already on the device; we
+        // don't want to trigger an extra download just to guess the source.
+        if ((await factory.availability()) !== 'available') return null;
+        return await factory.create();
+      } catch {
+        return null;
+      }
+    })();
+  }
+  return detectorPromise;
+}
+
+/**
+ * Detects the language of the given text on-device, falling back to the
+ * `lang` attribute of the nearest element / document when unavailable.
+ */
+export async function detectSourceLanguage(text: string, fallback: string): Promise<string> {
+  const detector = await getDetector();
+  if (detector && text.trim()) {
+    try {
+      const [top] = await detector.detect(text.slice(0, 2000));
+      if (top && top.detectedLanguage !== 'und' && top.confidence >= 0.5) {
+        return top.detectedLanguage;
+      }
+    } catch {
+      /* fall through */
+    }
+  }
+  return fallback;
+}
+
+/* ------------------------------------------------------------------ */
+/* Translator creation (cached per language pair)                      */
+/* ------------------------------------------------------------------ */
+
+const translatorCache = new Map<string, Promise<TranslatorInstance>>();
+
+export async function getTranslationAvailability(
+  sourceLanguage: string,
+  targetLanguage: string,
+): Promise<TranslationAvailability> {
+  const factory = getTranslatorFactory();
+  if (!factory) return 'unavailable';
+  try {
+    return await factory.availability({ sourceLanguage, targetLanguage });
+  } catch {
+    return 'unavailable';
+  }
+}
+
+/**
+ * Creates (or reuses) a translator for the language pair. Must be called
+ * shortly after a user gesture if the language model still needs to be
+ * downloaded.
+ */
+export function getTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  onDownloadProgress?: (fraction: number) => void,
+): Promise<TranslatorInstance> {
+  const factory = getTranslatorFactory();
+  if (!factory) return Promise.reject(new Error('On-device translation is not supported in this browser.'));
+
+  const key = `${sourceLanguage}→${targetLanguage}`;
+  const cached = translatorCache.get(key);
+  if (cached) return cached;
+
+  const promise = factory.create({
+    sourceLanguage,
+    targetLanguage,
+    monitor(monitor) {
+      monitor.addEventListener('downloadprogress', (event) => {
+        const loaded = (event as ProgressEvent).loaded;
+        onDownloadProgress?.(typeof loaded === 'number' ? loaded : 0);
+      });
+    },
+  });
+  translatorCache.set(key, promise);
+  // Don't cache failures so the user can retry.
+  promise.catch(() => translatorCache.delete(key));
+  return promise;
+}
+
+/* ------------------------------------------------------------------ */
+/* DOM translation                                                     */
+/* ------------------------------------------------------------------ */
+
+interface ScopeState {
+  segments: Array<{ node: Text; original: string }>;
+  targets: Array<{ el: HTMLElement; lang: string | null; dir: string | null }>;
+  currentLanguage: string | null;
+}
+
+const scopeStates = new WeakMap<Element, ScopeState>();
+
+const SKIP_SELECTOR = 'script, style, code, pre, kbd, samp, [translate="no"], astro-island';
+
+function findTargets(scope: Element): HTMLElement[] {
+  return Array.from(scope.querySelectorAll<HTMLElement>('[data-translatable]')).filter(
+    // Ignore elements that belong to a nested scope.
+    (el) => el.closest('[data-translate-scope]') === scope,
+  );
+}
+
+function collectSegments(targets: HTMLElement[]): ScopeState['segments'] {
+  const segments: ScopeState['segments'] = [];
+
+  for (const target of targets) {
+    const walker = document.createTreeWalker(target, NodeFilter.SHOW_TEXT, {
+      acceptNode(node) {
+        if (!node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
+        const parent = node.parentElement;
+        if (parent && parent.closest(SKIP_SELECTOR)) return NodeFilter.FILTER_REJECT;
+        return NodeFilter.FILTER_ACCEPT;
+      },
+    });
+    let node: Node | null;
+    while ((node = walker.nextNode())) {
+      segments.push({ node: node as Text, original: node.nodeValue ?? '' });
+    }
+  }
+  return segments;
+}
+
+function getScopeState(scope: Element): ScopeState {
+  let state = scopeStates.get(scope);
+  if (!state) {
+    const targets = findTargets(scope);
+    state = {
+      segments: collectSegments(targets),
+      targets: targets.map((el) => ({ el, lang: el.getAttribute('lang'), dir: el.getAttribute('dir') })),
+      currentLanguage: null,
+    };
+    scopeStates.set(scope, state);
+  }
+  return state;
+}
+
+/** Returns the untranslated text of a scope (used for language detection). */
+export function getScopeOriginalText(scope: Element): string {
+  return getScopeState(scope)
+    .segments.map((s) => s.original.trim())
+    .join('\n');
+}
+
+export function getScopeLanguage(scope: Element): string {
+  const langHolder = scope.closest('[lang]');
+  return langHolder?.getAttribute('lang') || document.documentElement.lang || 'en';
+}
+
+export function getScopeCurrentLanguage(scope: Element): string | null {
+  return scopeStates.get(scope)?.currentLanguage ?? null;
+}
+
+/**
+ * Translates every `[data-translatable]` text node in the scope. Always
+ * translates from the original text, so switching between target languages
+ * never compounds translation errors.
+ */
+export async function translateScope(
+  scope: Element,
+  translator: TranslatorInstance,
+  targetLanguage: string,
+  options: { signal?: AbortSignal; onProgress?: (done: number, total: number) => void } = {},
+): Promise<void> {
+  const state = getScopeState(scope);
+  const { segments } = state;
+  const total = segments.length;
+  const translated: string[] = new Array(total);
+
+  // Deduplicate identical strings to avoid redundant work.
+  const memo = new Map<string, Promise<string>>();
+  let done = 0;
+  options.onProgress?.(0, total);
+
+  for (let i = 0; i < total; i++) {
+    if (options.signal?.aborted) throw new DOMException('Translation aborted', 'AbortError');
+    const original = segments[i].original;
+    const leading = original.match(/^\s*/)?.[0] ?? '';
+    const trailing = original.match(/\s*$/)?.[0] ?? '';
+    const core = original.trim();
+
+    let pending = memo.get(core);
+    if (!pending) {
+      pending = translator.translate(core, { signal: options.signal });
+      memo.set(core, pending);
+    }
+    const result = await pending;
+    translated[i] = leading + result + trailing;
+
+    // Apply progressively so readers see the article change as it goes.
+    segments[i].node.nodeValue = translated[i];
+    options.onProgress?.(++done, total);
+  }
+
+  const dir = RTL_LANGUAGES.has(baseLanguage(targetLanguage)) ? 'rtl' : 'ltr';
+  for (const { el } of state.targets) {
+    el.setAttribute('lang', targetLanguage);
+    el.setAttribute('dir', dir);
+  }
+  scope.setAttribute('data-translated', targetLanguage);
+  state.currentLanguage = targetLanguage;
+}
+
+/** Restores the original text and language attributes of a scope. */
+export function restoreScope(scope: Element): void {
+  const state = scopeStates.get(scope);
+  if (!state) return;
+  for (const { node, original } of state.segments) {
+    node.nodeValue = original;
+  }
+  for (const { el, lang, dir } of state.targets) {
+    if (lang === null) el.removeAttribute('lang');
+    else el.setAttribute('lang', lang);
+    if (dir === null) el.removeAttribute('dir');
+    else el.setAttribute('dir', dir);
+  }
+  scope.removeAttribute('data-translated');
+  state.currentLanguage = null;
+}
