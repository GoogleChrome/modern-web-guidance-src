+  <script>
+    (function () {
+      const form = document.getElementById('quick-order-form');
+      const totalEl = document.getElementById('qo-total');
+      const statusEl = document.getElementById('qo-status');
+
+      const SIZE_UPCHARGE = { small: 0, medium: 0.5, large: 1.0 };
+      const ALT_MILKS = ['oat', 'almond', 'soy'];
+      const fmt = (n) => '$' + n.toFixed(2);
+
+      function readOrder() {
+        const data = new FormData(form);
+        const drinkOpt = form.drink.selectedOptions[0];
+        const shots = Math.max(0, Math.min(4, parseInt(data.get('extra_shots'), 10) || 0));
+        const size = data.get('size') || 'medium';
+        const milk = data.get('milk') || 'whole';
+        const syrup = data.get('syrup') || 'none';
+
+        let total = parseFloat(drinkOpt?.dataset.price || 0);
+        total += SIZE_UPCHARGE[size] ?? 0;
+        total += shots * 0.75;
+        if (ALT_MILKS.includes(milk)) total += 0.6;
+        if (syrup !== 'none') total += 0.5;
+
+        return {
+          drink: data.get('drink'),
+          drinkLabel: drinkOpt?.textContent.trim(),
+          size, milk, syrup,
+          extra_shots: shots,
+          location: data.get('location'),
+          locationLabel: form.location.selectedOptions[0]?.textContent.trim(),
+          pickup_time: data.get('pickup_time'),
+          customer_name: (data.get('customer_name') || '').trim(),
+          notes: (data.get('notes') || '').trim(),
+          total: Math.round(total * 100) / 100,
+        };
+      }
+
+      function updateTotal() {
+        totalEl.textContent = fmt(readOrder().total);
+      }
+
+      function validate(order) {
+        const errors = [];
+        if (!order.customer_name) errors.push('Please enter a name for the order.');
+        if (!SIZE_UPCHARGE.hasOwnProperty(order.size)) errors.push('Please choose a valid size.');
+        const shotsRaw = form.extra_shots.value;
+        if (shotsRaw !== '' && (!/^\d+$/.test(shotsRaw) || +shotsRaw > 4)) {
+          errors.push('Extra shots must be a whole number from 0 to 4.');
+        }
+        return errors;
+      }
+
+      function readyTime(pickup) {
+        const mins = pickup === 'asap' ? 10 : parseInt(pickup, 10) || 10;
+        return new Date(Date.now() + mins * 60000);
+      }
+
+      function showStatus(message, isError) {
+        statusEl.textContent = message;
+        statusEl.classList.toggle('error', !!isError);
+        statusEl.hidden = false;
+      }
+
+      form.addEventListener('input', updateTotal);
+      form.addEventListener('change', updateTotal);
+      form.addEventListener('reset', () => {
+        setTimeout(updateTotal);
+        statusEl.hidden = true;
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const order = readOrder();
+        const errors = validate(order);
+
+        let result;
+        if (errors.length) {
+          showStatus(errors.join(' '), true);
+          if (!order.customer_name) form.customer_name.focus();
+          result = { success: false, errors };
+        } else {
+          const orderNumber = 'DG-' + Math.floor(1000 + Math.random() * 9000);
+          const ready = readyTime(order.pickup_time);
+          const readyStr = ready.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
+          showStatus(
+            `Thanks, ${order.customer_name}! Order ${orderNumber} (${order.size} ${order.drinkLabel}) ` +
+            `will be ready at ${order.locationLabel} around ${readyStr}. Total due at pickup: ${fmt(order.total)}.`
+          );
+          result = {
+            success: true,
+            order_number: orderNumber,
+            ready_at: ready.toISOString(),
+            ready_at_display: readyStr,
+            total: order.total,
+            currency: 'USD',
+            order: {
+              drink: order.drink, size: order.size, milk: order.milk, syrup: order.syrup,
+              extra_shots: order.extra_shots, location: order.location,
+              pickup_time: order.pickup_time, customer_name: order.customer_name, notes: order.notes,
+            },
+          };
+        }
+
+        // WebMCP: when an AI agent submitted the form via the declarative tool,
+        // return a structured result to the agent instead of navigating.
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(result));
+        }
+      });
+
+      updateTotal();
+    })();
+  </script>
+
 </body>
 
 </html>
