+  <script>
+    (() => {
+      const MENU = [
+        { name: 'Maple Oat Latte', roast: 'medium', temps: ['hot', 'iced'], milk: ['oat'], caffeine: 'regular', flavors: ['caramel', 'spice'], price: 5.75, description: 'Creamy oat milk with a hint of Vermont maple syrup.', url: '/menu/seasonal' },
+        { name: 'Dark Roast Espresso', roast: 'dark', temps: ['hot'], milk: ['black'], caffeine: 'regular', flavors: ['chocolate'], price: 3.25, description: 'Bold, smokey, and perfect for a morning boost.', url: '/menu/espresso' },
+        { name: 'Cold Brew', roast: 'medium', temps: ['iced'], milk: ['black', 'dairy', 'oat', 'almond'], caffeine: 'regular', flavors: ['chocolate', 'nutty'], price: 4.50, description: 'Steeped for 18 hours for maximum smoothness.', url: '/menu/cold-brew' },
+        { name: 'Ethiopian Pour-Over', roast: 'light', temps: ['hot'], milk: ['black'], caffeine: 'regular', flavors: ['fruity'], price: 4.75, description: 'Hand-poured single origin with bright blueberry and citrus notes.', url: '/menu/pour-over' },
+        { name: 'Hazelnut Cappuccino', roast: 'medium', temps: ['hot'], milk: ['dairy', 'oat', 'almond'], caffeine: 'regular', flavors: ['nutty', 'caramel'], price: 5.25, description: 'Velvety foam over espresso with toasted hazelnut.', url: '/menu/cappuccino' },
+        { name: 'Mocha', roast: 'dark', temps: ['hot', 'iced'], milk: ['dairy', 'oat', 'almond'], caffeine: 'regular', flavors: ['chocolate'], price: 5.50, description: 'Dark roast espresso with house-made chocolate sauce.', url: '/menu/mocha' },
+        { name: 'Iced Caramel Macchiato', roast: 'medium', temps: ['iced'], milk: ['dairy', 'oat', 'almond'], caffeine: 'regular', flavors: ['caramel'], price: 5.75, description: 'Layered milk and espresso finished with caramel drizzle.', url: '/menu/macchiato' },
+        { name: 'Chai-Spiced Americano', roast: 'light', temps: ['hot', 'iced'], milk: ['black', 'dairy', 'oat'], caffeine: 'regular', flavors: ['spice'], price: 4.25, description: 'Americano warmed with cinnamon, cardamom, and clove.', url: '/menu/americano' },
+        { name: 'Swiss Water Decaf', roast: 'medium', temps: ['hot'], milk: ['black', 'dairy', 'oat', 'almond'], caffeine: 'decaf', flavors: ['chocolate', 'nutty'], price: 3.75, description: 'Chemical-free decaf drip with cocoa and almond notes.', url: '/menu/decaf' },
+        { name: 'Decaf Almond Latte', roast: 'medium', temps: ['hot', 'iced'], milk: ['almond'], caffeine: 'decaf', flavors: ['nutty'], price: 5.25, description: 'Smooth decaf espresso with toasted almond milk.', url: '/menu/decaf-latte' },
+      ];
+
+      const form = document.getElementById('coffee-finder');
+      const status = document.getElementById('finder-status');
+      const results = document.getElementById('finder-results');
+      const budget = document.getElementById('finder-budget');
+      const fmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+      const findMatches = (data) => {
+        const roast = data.get('roast') || 'any';
+        const temperature = data.get('temperature') || 'any';
+        const milk = data.get('milk') || 'any';
+        const caffeine = data.get('caffeine') || 'any';
+        const flavors = data.getAll('flavor');
+        const maxPrice = data.get('max_price') ? Number(data.get('max_price')) : Infinity;
+
+        return MENU.filter((d) =>
+          (roast === 'any' || d.roast === roast) &&
+          (temperature === 'any' || d.temps.includes(temperature)) &&
+          (milk === 'any' || d.milk.includes(milk)) &&
+          (caffeine === 'any' || d.caffeine === caffeine) &&
+          (flavors.length === 0 || flavors.some((f) => d.flavors.includes(f))) &&
+          d.price <= maxPrice
+        );
+      };
+
+      const render = (matches) => {
+        results.replaceChildren(...matches.map((d) => {
+          const li = document.createElement('li');
+          li.className = 'card';
+          const h3 = document.createElement('h3');
+          h3.textContent = d.name;
+          const desc = document.createElement('p');
+          desc.textContent = d.description;
+          const meta = document.createElement('p');
+          meta.className = 'meta';
+          meta.textContent = `${d.roast[0].toUpperCase() + d.roast.slice(1)} roast · ${d.temps.join(' or ')} · ${d.caffeine}`;
+          const price = document.createElement('p');
+          price.className = 'price';
+          price.textContent = fmt.format(d.price);
+          const link = document.createElement('a');
+          link.className = 'btn';
+          link.href = d.url;
+          link.textContent = 'View Details';
+          link.setAttribute('aria-label', `View details for ${d.name}`);
+          li.append(h3, desc, meta, price, link);
+          return li;
+        }));
+        status.textContent = matches.length
+          ? `We found ${matches.length} drink${matches.length === 1 ? '' : 's'} for you.`
+          : 'No drinks match all of those preferences. Try loosening a filter.';
+      };
+
+      // Keep aria-invalid in sync with the visual :user-invalid state.
+      const syncAria = () => budget.setAttribute('aria-invalid', budget.matches(':user-invalid') ? 'true' : 'false');
+      budget.addEventListener('blur', syncAria);
+      budget.addEventListener('input', () => { if (budget.hasAttribute('aria-invalid')) syncAria(); });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+
+        // Agent submissions may bypass interactive constraint validation; check explicitly.
+        if (!form.checkValidity()) {
+          if (event.agentInvoked) {
+            event.respondWith(Promise.resolve(
+              `Validation failed: max_price (${budget.validationMessage || 'must be between 2 and 15 USD'})`
+            ));
+          }
+          form.reportValidity();
+          return;
+        }
+
+        const matches = findMatches(new FormData(form));
+        render(matches);
+
+        if (event.agentInvoked) {
+          event.respondWith(Promise.resolve(JSON.stringify({
+            count: matches.length,
+            drinks: matches.map(({ name, description, roast, temps, milk, caffeine, flavors, price, url }) => ({
+              name, description, roast, temperatures: temps, milkOptions: milk, caffeine, flavors,
+              priceUSD: price, detailsUrl: new URL(url, location.href).href,
+            })),
+          })));
+        }
+      });
+
+      form.addEventListener('reset', () => {
+        results.replaceChildren();
+        status.textContent = '';
+        budget.removeAttribute('aria-invalid');
+      });
+    })();
+  </script>
+
 </body>
 
