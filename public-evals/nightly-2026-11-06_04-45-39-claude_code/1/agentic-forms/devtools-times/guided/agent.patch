+import 'react';
+
 declare global {
   interface Window {
     adNetwork: any; // Replace 'any' with a more specific type if you know it
   }
+
+  /**
+   * WebMCP additions to SubmitEvent (Chromium early preview).
+   * `agentInvoked` is true when an AI agent submitted the form via its declarative tool,
+   * and `respondWith()` returns a result to the agent instead of navigating.
+   */
+  interface SubmitEvent {
+    readonly agentInvoked?: boolean;
+    respondWith?: (result: Promise<unknown>) => void;
+  }
+}
+
+// WebMCP declarative API attributes (https://webmachinelearning.github.io/webmcp/)
+declare module 'react' {
+  interface FormHTMLAttributes<T> {
+    toolname?: string;
+    tooldescription?: string;
+    // Pass an empty string to enable; React drops boolean values for unknown attributes.
+    toolautosubmit?: '';
+  }
+  interface InputHTMLAttributes<T> {
+    toolparamdescription?: string;
+  }
+  interface FieldsetHTMLAttributes<T> {
+    toolparamdescription?: string;
+  }
 }
 
-export {};
\ No newline at end of file
+export {};
