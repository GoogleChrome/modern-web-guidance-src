+/* WebMCP: highlight forms while an AI agent is filling them in. */
+form:tool-form-active {
+  outline: 2px dashed var(--color-amber-400);
+  outline-offset: 4px;
+}
+
+/* WebMCP: draw attention to the submit button while the browser waits for the user to confirm. */
+button:tool-submit-active {
+  outline: 2px solid var(--color-amber-400);
+  outline-offset: 2px;
+}
