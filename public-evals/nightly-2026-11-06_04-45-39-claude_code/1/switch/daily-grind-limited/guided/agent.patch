+  <script>
+    // Persist the nutrition-info preference across visits.
+    const nutritionToggle = document.getElementById('show-nutrition');
+    const PREF_KEY = 'pref-show-nutrition';
+    try {
+      nutritionToggle.checked = localStorage.getItem(PREF_KEY) === 'on';
+    } catch {}
+    nutritionToggle.addEventListener('change', () => {
+      try {
+        localStorage.setItem(PREF_KEY, nutritionToggle.checked ? 'on' : 'off');
+      } catch {}
+    });
+    window.addEventListener('storage', (e) => {
+      if (e.key === PREF_KEY) nutritionToggle.checked = e.newValue === 'on';
+    });
+  </script>
