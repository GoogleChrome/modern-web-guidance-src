+    /* Preference toggle (switch) */
+    nav ul {
+      align-items: center;
+    }
+
+    .pref-toggle {
+      display: inline-flex;
+      align-items: center;
+      gap: 8px;
+      background: none;
+      border: none;
+      color: white;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      padding: 0;
+    }
+
+    .pref-toggle .track {
+      position: relative;
+      width: 40px;
+      height: 22px;
+      border-radius: 11px;
+      background: rgba(255, 255, 255, 0.3);
+      transition: background 0.2s;
+    }
+
+    .pref-toggle .thumb {
+      position: absolute;
+      top: 3px;
+      left: 3px;
+      width: 16px;
+      height: 16px;
+      border-radius: 50%;
+      background: white;
+      transition: transform 0.2s;
+    }
+
+    .pref-toggle[aria-checked="true"] .track {
+      background: var(--accent);
+    }
+
+    .pref-toggle[aria-checked="true"] .thumb {
+      transform: translateX(18px);
+    }
+
+    .pref-toggle:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 4px;
+      border-radius: 4px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      body, .pref-toggle .track, .pref-toggle .thumb {
+        transition: none;
+      }
+    }
+
