+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('https://esm.sh/input-switch-polyfill@1');
+    }
+
+    const KEY = 'pref-show-caffeine';
+    const toggle = document.getElementById('pref-caffeine');
+
+    const read = () => {
+      try { return localStorage.getItem(KEY) === 'on'; } catch { return false; }
+    };
+
+    toggle.checked = read();
+
+    toggle.addEventListener('change', () => {
+      try { localStorage.setItem(KEY, toggle.checked ? 'on' : 'off'); } catch { /* storage unavailable */ }
+    });
+
+    // Keep in sync with other open tabs
+    addEventListener('storage', (e) => {
+      if (e.key === KEY) toggle.checked = read();
+    });
+  </script>
+
