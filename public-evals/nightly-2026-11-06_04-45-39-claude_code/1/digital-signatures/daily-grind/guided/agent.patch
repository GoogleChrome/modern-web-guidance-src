+  <script type="module">
+    // ---- Signing suites --------------------------------------------------
+    // Prefer post-quantum ML-DSA-65 (FIPS 204); fall back to Ed25519, then ECDSA P-256.
+    const SUITES = {
+      'ML-DSA-65': {
+        generate: () => crypto.subtle.generateKey('ML-DSA-65', false, ['sign', 'verify']),
+        exportFormat: 'raw-public',
+        sign: (key, data, ctx) => crypto.subtle.sign({ name: 'ML-DSA-65', context: ctx }, key, data),
+        verify: (key, sig, data, ctx) => crypto.subtle.verify({ name: 'ML-DSA-65', context: ctx }, key, sig, data),
+      },
+      'Ed25519': {
+        generate: () => crypto.subtle.generateKey('Ed25519', false, ['sign', 'verify']),
+        exportFormat: 'raw',
+        sign: (key, data, ctx) => crypto.subtle.sign('Ed25519', key, frame(data, ctx)),
+        verify: (key, sig, data, ctx) => crypto.subtle.verify('Ed25519', key, sig, frame(data, ctx)),
+      },
+      'ECDSA-P256-SHA256': {
+        generate: () => crypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, false, ['sign', 'verify']),
+        exportFormat: 'raw',
+        sign: (key, data, ctx) => crypto.subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, key, frame(data, ctx)),
+        verify: (key, sig, data, ctx) =>
+          crypto.subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, key, sig, frame(data, ctx)),
+      },
+    };
+
+    // Domain separation: a receipt signature can never be replayed as a voucher.
+    const CONTEXTS = {
+      receipt: new TextEncoder().encode('daily-grind/receipt/v1'),
+      voucher: new TextEncoder().encode('daily-grind/voucher/v1'),
+    };
+
+    // Classical algorithms ignore `context`, so prepend a length-prefixed context header instead.
+    function frame(payload, ctx) {
+      if (ctx.byteLength > 255) throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+      const out = new Uint8Array(1 + ctx.byteLength + payload.byteLength);
+      out[0] = ctx.byteLength;
+      out.set(ctx, 1);
+      out.set(payload, 1 + ctx.byteLength);
+      return out;
+    }
+
+    // ---- Encoding helpers ------------------------------------------------
+    const b64url = {
+      encode(bytes) {
+        if (typeof bytes.toBase64 === 'function') return bytes.toBase64({ alphabet: 'base64url', omitPadding: true });
+        let bin = '';
+        for (const b of bytes) bin += String.fromCharCode(b);
+        return btoa(bin).replaceAll('+', '-').replaceAll('/', '_').replace(/=+$/, '');
+      },
+      decode(str) {
+        if (typeof Uint8Array.fromBase64 === 'function') return Uint8Array.fromBase64(str, { alphabet: 'base64url' });
+        const b64 = str.replaceAll('-', '+').replaceAll('_', '/');
+        const bin = atob(b64 + '='.repeat((4 - (b64.length % 4)) % 4));
+        return Uint8Array.from(bin, (c) => c.charCodeAt(0));
+      },
+    };
+
+    async function fingerprint(publicKeyBytes) {
+      const hash = new Uint8Array(await crypto.subtle.digest('SHA-256', publicKeyBytes)).slice(0, 16);
+      return {
+        kid: b64url.encode(hash),
+        display: Array.from(hash, (b) => b.toString(16).padStart(2, '0')).join('').match(/.{4}/g).join(':'),
+      };
+    }
+
+    // ---- Key storage (IndexedDB keeps non-extractable CryptoKeys across visits) ----
+    const DB_NAME = 'daily-grind-signing';
+    const dbPromise = new Promise((resolve, reject) => {
+      const req = indexedDB.open(DB_NAME, 1);
+      req.onupgradeneeded = () => req.result.createObjectStore('keys', { keyPath: 'kid' });
+      req.onsuccess = () => resolve(req.result);
+      req.onerror = () => reject(req.error);
+    });
+
+    async function tx(mode, fn) {
+      const db = await dbPromise;
+      return new Promise((resolve, reject) => {
+        const t = db.transaction('keys', mode);
+        const result = fn(t.objectStore('keys'));
+        t.oncomplete = () => resolve(result.result ?? result);
+        t.onerror = () => reject(t.error);
+      });
+    }
+    const getAllKeys = () => tx('readonly', (s) => s.getAll());
+    const putKey = (record) => tx('readwrite', (s) => s.put(record));
+
+    async function createSigningKey() {
+      const candidates = [];
+      if (globalThis.SubtleCrypto?.supports?.('sign', { name: 'ML-DSA-65', context: CONTEXTS.receipt })) {
+        candidates.push('ML-DSA-65');
+      }
+      candidates.push('Ed25519', 'ECDSA-P256-SHA256');
+
+      for (const suite of candidates) {
+        try {
+          const keyPair = await SUITES[suite].generate();
+          const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey(SUITES[suite].exportFormat, keyPair.publicKey));
+          const fp = await fingerprint(publicKeyBytes);
+          return {
+            kid: fp.kid,
+            display: fp.display,
+            suite,
+            privateKey: keyPair.privateKey, // non-extractable
+            publicKey: keyPair.publicKey,
+            publicKeyBytes,
+            createdAt: new Date().toISOString(),
+            active: true,
+          };
+        } catch (err) {
+          if (err?.name !== 'NotSupportedError') throw err;
+        }
+      }
+      throw new Error('This browser does not support any of the required signature algorithms.');
+    }
+
+    let activeKey;
+    let trustedKeys = new Map();
+
+    async function loadKeys() {
+      const all = await getAllKeys();
+      trustedKeys = new Map(all.map((k) => [k.kid, k]));
+      activeKey = all.find((k) => k.active);
+      if (!activeKey) {
+        activeKey = await createSigningKey();
+        await putKey(activeKey);
+        trustedKeys.set(activeKey.kid, activeKey);
+      }
+      renderKey();
+    }
+
+    async function rotateKey() {
+      const next = await createSigningKey();
+      // Retire the old key: keep its public key trusted for verifying earlier documents,
+      // but drop its private key so it can no longer sign.
+      const retired = { ...activeKey, active: false, privateKey: null, retiredAt: new Date().toISOString() };
+      await putKey(retired);
+      await putKey(next);
+      trustedKeys.set(retired.kid, retired);
+      trustedKeys.set(next.kid, next);
+      activeKey = next;
+      renderKey();
+    }
+
+    // ---- Signing ---------------------------------------------------------
