diff --git a/tests/crypto-core.test.mjs b/tests/crypto-core.test.mjs
new file mode 100644
index 0000000..dafb9dd
--- /dev/null
+++ b/tests/crypto-core.test.mjs
@@ -0,0 +1,73 @@
+// Run: node --test tests/
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import * as core from '../js/signing/crypto-core.js';
+
+const items = [{ name: 'Cold Brew', qty: 2, unitPriceCents: 495 }];
+const receipt = () => core.buildReceipt({ items, taxRateBps: 888, store: 'Test' });
+const voucher = () => core.buildVoucher({ valueCents: 2500, recipient: 'Alex', message: 'hi', validDays: 30 });
+
+for (const alg of Object.keys(core.ALGORITHMS)) {
+  test(`${alg}: sign/verify receipt and voucher, detect tampering`, async () => {
+    const key = await core.generateSigningKey(alg);
+    for (const [kind, p] of [['receipt', receipt()], ['voucher', voucher()]]) {
+      const doc = await core.signDocument(kind, p, key);
+      const res = await core.verifyDocument(JSON.stringify(doc));
+      assert.equal(res.keyId, key.keyId);
+      assert.equal(res.kind, kind);
+
+      const t = structuredClone(doc);
+      if (kind === 'receipt') { t.payload.items[0].unitPriceCents -= 100; t.payload.subtotalCents -= 200; t.payload.totalCents -= 200; }
+      else t.payload.valueCents *= 10;
+      await assert.rejects(core.verifyDocument(t), /INVALID/);
+
+      const swapped = structuredClone(doc); swapped.kind = kind === 'receipt' ? 'voucher' : 'receipt';
+      await assert.rejects(core.verifyDocument(swapped), core.VerificationError);
+    }
+  });
+}
+
+test('signature from another key is rejected; swapping key breaks keyId', async () => {
+  const a = await core.generateSigningKey('ECDSA-P256-SHA256');
+  const b = await core.generateSigningKey('ECDSA-P256-SHA256');
+  const doc = await core.signDocument('receipt', receipt(), a);
+  const forged = { ...doc, publicKeys: b.publicKeys };
+  await assert.rejects(core.verifyDocument(forged), /fingerprint/);
+  await assert.rejects(core.verifyDocument({ ...forged, keyId: b.keyId }), /INVALID/);
+});
+
+test('hybrid cannot be downgraded by stripping a component', async () => {
+  const key = await core.generateSigningKey('Hybrid-ECDSA-P256+ML-DSA-65');
+  const doc = await core.signDocument('voucher', voucher(), key);
+  const stripped = structuredClone(doc);
+  stripped.alg = 'ECDSA-P256-SHA256';
+  delete stripped.publicKeys['ML-DSA-65'];
+  delete stripped.signatures['ML-DSA-65'];
+  stripped.keyId = await core.computeKeyId(stripped.alg, stripped.publicKeys);
+  await assert.rejects(core.verifyDocument(stripped), /INVALID/);
+  const half = structuredClone(doc);
+  delete half.signatures['ML-DSA-65'];
+  await assert.rejects(core.verifyDocument(half), core.VerificationError);
+});
+
+test('rejects malformed input and inconsistent payloads', async () => {
+  await assert.rejects(core.verifyDocument('not json'), /JSON/);
+  await assert.rejects(core.verifyDocument('{}'), core.VerificationError);
+  const key = await core.generateSigningKey('Ed25519');
+  const bad = receipt(); bad.totalCents += 1;
+  await assert.rejects(core.signDocument('receipt', bad, key), /Total/);
+  const doc = await core.signDocument('receipt', receipt(), key);
+  await assert.rejects(core.verifyDocument({ ...doc, extra: 1 }), /unexpected/);
+});
+
+test('public key export/import round trip', async () => {
+  const key = await core.generateSigningKey('ML-DSA-65');
+  const pub = core.exportPublicKey(key, 'Till 1');
+  const parsed = await core.parsePublicKey(JSON.stringify(pub));
+  assert.equal(parsed.keyId, key.keyId);
+  await assert.rejects(core.parsePublicKey(JSON.stringify({ ...pub, keyId: '00'.repeat(16) })), /fingerprint/);
+});
+
+test('voucher codes are well-formed', () => {
+  for (let i = 0; i < 50; i++) assert.match(core.newVoucherCode(), /^DG-[0-9A-Z]{4}-[0-9A-Z]{4}-[0-9A-Z]{4}$/);
+});
