diff --git a/components/shared-styles.js b/components/shared-styles.js
new file mode 100644
index 0000000..7409bf2
--- /dev/null
+++ b/components/shared-styles.js
@@ -0,0 +1,61 @@
+/**
+ * Shared constructable stylesheets adopted by every Daily Grind component.
+ * Theme tokens (--dg-*) are inherited CSS custom properties, so pages can
+ * re-theme components without piercing the shadow boundary.
+ */
+function sheet(css) {
+  const s = new CSSStyleSheet();
+  s.replaceSync(css);
+  return s;
+}
+
+export const baseStyles = sheet(`
+  :host {
+    box-sizing: border-box;
+    font-family: var(--dg-font, 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif);
+  }
+  *, *::before, *::after { box-sizing: inherit; }
+  [hidden] { display: none !important; }
+
+  .visually-hidden {
+    position: absolute !important;
+    width: 1px; height: 1px;
+    padding: 0; margin: -1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+    border: 0;
+  }
+
+  .btn {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 0.4em;
+    min-height: 44px;              /* WCAG 2.5.5 target size */
+    background: var(--dg-primary, #4e342e);
+    color: var(--dg-on-primary, #fff);
+    padding: 10px 20px;
+    border: 2px solid transparent;
+    border-radius: 5px;
+    font: inherit;
+    font-weight: 600;
+    text-decoration: none;
+    cursor: pointer;
+    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
+  }
+  .btn:hover { background: var(--dg-primary-dark, #3e2723); }
+  .btn:focus-visible,
+  button:focus-visible,
+  a:focus-visible {
+    outline: 3px solid var(--dg-focus, #ffab40);
+    outline-offset: 3px;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    *, *::before, *::after {
+      transition-duration: 0.01ms !important;
+      animation-duration: 0.01ms !important;
+    }
+  }
+`);
