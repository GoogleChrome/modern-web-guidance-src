+  #onOutsideClick = (event) => {
+    if (this.open && !event.composedPath().includes(this)) this.close();
+  };
+
+  #onBreakpoint = (event) => {
+    if (!event.matches) this.close();
+  };
+}
+
+function normalisePath(path) {
+  return path.length > 1 ? path.replace(/\/+$/, '') : path;
+}
