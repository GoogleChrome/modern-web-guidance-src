new file mode 100644
index 0000000..f617910
--- /dev/null
+++ b/components/site-footer.js
@@ -0,0 +1,108 @@
+import { baseStyles } from './shared-styles.js';
+
+const styles = new CSSStyleSheet();
+styles.replaceSync(`
+  :host {
+    display: block;
+    margin-top: 40px;
+    padding: 40px 20px;
+    background: var(--dg-secondary, #d7ccc8);
+    color: var(--dg-text, #3e2723);
+    text-align: center;
+  }
+
+  ul {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    margin: 0 0 20px;
+    padding: 0;
+    list-style: none;
+  }
+  li + li::before {
+    content: '|';
+    content: '|' / '';   /* decorative: empty alt text for screen readers */
+    margin: 0 4px;
+  }
+
+  ::slotted(a) {
+    display: inline-block;
+    padding: 8px 6px;
+    color: inherit;
+    font-size: 0.85rem;
+    text-decoration: none;
+  }
+  ::slotted(a:hover) { text-decoration: underline; }
+  ::slotted(a:focus-visible) {
+    outline: 3px solid var(--dg-primary, #4e342e);
+    outline-offset: 2px;
+  }
+
+  ::slotted([slot='legal']) {
+    margin: 0;
+    font-size: 0.9rem;
+  }
+`);
+
+/**
+ * <site-footer>
+ *
+ * Site footer. Direct child <a> elements become a list of links inside a
+ * labelled navigation landmark; slot="legal" holds copyright text.
+ *
+ * Attributes:
+ *   label – accessible name for the footer nav (default "Footer")
+ *
+ * Parts: nav, list
+ */
+export class SiteFooter extends HTMLElement {
+  static observedAttributes = ['label'];
+
+  #nav;
+  #list;
+  #observer = new MutationObserver(() => this.#renderLinks());
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, styles];
+    root.innerHTML = `
+      <footer>
+        <nav part="nav" aria-label="Footer"><ul part="list"></ul></nav>
+        <slot name="legal"></slot>
+      </footer>
+    `;
+    this.#nav = root.querySelector('nav');
+    this.#list = root.querySelector('ul');
+  }
+
+  connectedCallback() {
+    this.#renderLinks();
+    this.#observer.observe(this, { childList: true });
+  }
+
+  disconnectedCallback() {
+    this.#observer.disconnect();
+  }
+
+  attributeChangedCallback(_name, _old, value) {
+    this.#nav.setAttribute('aria-label', value || 'Footer');
+  }
+
+  #renderLinks() {
+    const links = [...this.children].filter((el) => el.localName === 'a');
+    this.#list.replaceChildren(
+      ...links.map((link, i) => {
+        const name = `link-${i}`;
+        if (link.slot !== name) link.slot = name;
+        const li = document.createElement('li');
+        const slot = document.createElement('slot');
+        slot.name = name;
+        li.append(slot);
+        return li;
+      }),
+    );
+  }
+}
+
+if (!customElements.get('site-footer')) customElements.define('site-footer', SiteFooter);
diff --git a/components/site-nav.js b/components/site-nav.js
new file mode 100644
index 0000000..1708567
--- /dev/null
+++ b/components/site-nav.js
@@ -0,0 +1,262 @@
+import { baseStyles } from './shared-styles.js';
+
+const BREAKPOINT = '(max-width: 720px)';
+
+const styles = new CSSStyleSheet();
+styles.replaceSync(`
+  :host {
+    display: block;
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+    background: var(--dg-primary, #4e342e);
+    color: var(--dg-on-primary, #fff);
+  }
+
+  nav {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    padding: 1rem 5%;
+  }
+
+  ::slotted([slot='brand']) {
+    color: inherit;
+    font-size: 1.5rem;
+    font-weight: bold;
+    letter-spacing: 1px;
+    text-decoration: none;
+  }
+
+  ul {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 4px 20px;
+    margin: 0;
+    padding: 0;
+    list-style: none;
+  }
+
+  ::slotted(a) {
+    display: inline-block;
+    padding: 6px 0;
+    color: inherit;
+    font-size: 0.9rem;
+    text-decoration: none;
+    transition: color 0.3s;
+  }
+  ::slotted(a:hover),
+  ::slotted(a[aria-current='page']) {
+    color: var(--dg-accent, #ffab40);
+  }
+  ::slotted(a[aria-current='page']) {
+    text-decoration: underline;
+    text-underline-offset: 4px;
+  }
+  ::slotted(a:focus-visible) {
+    outline: 3px solid var(--dg-focus, #ffab40);
+    outline-offset: 3px;
+  }
+  ::slotted(a[data-variant='outline']) {
+    border: 1px solid var(--dg-accent, #ffab40);
+    padding: 5px 12px;
+    border-radius: 4px;
+  }
+
+  .toggle {
+    display: none;
+    align-items: center;
+    gap: 8px;
+    min-height: 44px;
+    padding: 6px 12px;
+    background: transparent;
+    color: inherit;
+    border: 1px solid currentColor;
+    border-radius: 4px;
+    font: inherit;
+    cursor: pointer;
+  }
+  .bars, .bars::before, .bars::after {
+    display: block;
+    width: 18px;
+    height: 2px;
+    background: currentColor;
+    transition: transform 0.3s;
+  }
+  .bars { position: relative; }
+  .bars::before, .bars::after { content: ''; position: absolute; left: 0; }
+  .bars::before { top: -6px; }
+  .bars::after { top: 6px; }
+  .toggle[aria-expanded='true'] .bars { background: transparent; }
+  .toggle[aria-expanded='true'] .bars::before { transform: translateY(6px) rotate(45deg); }
+  .toggle[aria-expanded='true'] .bars::after { transform: translateY(-6px) rotate(-45deg); }
+
+  @media ${BREAKPOINT} {
+    .toggle { display: inline-flex; }
+    .menu {
+      flex-basis: 100%;
+    }
+    .menu:not(.open) { display: none; }
+    ul {
+      flex-direction: column;
+      align-items: stretch;
+      gap: 0;
+      padding-top: 12px;
+    }
+    li { border-top: 1px solid rgba(255, 255, 255, 0.15); }
+    ::slotted(a) {
+      display: block;
+      padding: 12px 0;
+    }
+    ::slotted(a[data-variant='outline']) {
+      margin: 12px 0;
+      text-align: center;
+    }
+  }
+`);
+
+/**
+ * <site-nav>
+ *
+ * Sticky, responsive primary navigation. Below 720px the links collapse
+ * behind an accessible disclosure button (aria-expanded / aria-controls,
+ * Escape to close, focus returned to the toggle).
+ *
+ * Attributes:
+ *   label – accessible name for the nav landmark (default "Main")
+ *
+ * Slots:
+ *   brand   – logo / site name (ideally a link to "/")
+ *   default – direct child <a> elements, one per menu item. Each is
+ *             rendered inside its own <li>. Add data-variant="outline"
+ *             for a bordered link. aria-current="page" is set
+ *             automatically when the href matches the current path.
+ *
+ * Parts: nav, toggle, menu, list
+ */
+export class SiteNav extends HTMLElement {
+  static observedAttributes = ['label'];
+
+  #nav;
+  #toggle;
+  #menu;
+  #list;
+  #mql = window.matchMedia(BREAKPOINT);
+  #observer = new MutationObserver(() => this.#renderLinks());
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, styles];
+    root.innerHTML = `
+      <nav part="nav" aria-label="Main">
+        <slot name="brand"></slot>
+        <button type="button" class="toggle" part="toggle"
+                aria-expanded="false" aria-controls="menu">
+          <span class="bars" aria-hidden="true"></span>
+          <span>Navigation</span>
+        </button>
+        <div class="menu" id="menu" part="menu">
+          <ul part="list"></ul>
+        </div>
+      </nav>
+    `;
+    this.#nav = root.querySelector('nav');
+    this.#toggle = root.querySelector('.toggle');
+    this.#menu = root.querySelector('.menu');
+    this.#list = root.querySelector('ul');
+
+    this.#toggle.addEventListener('click', () => this.toggle());
+    this.addEventListener('keydown', this.#onKeydown);
+    this.addEventListener('click', this.#onLinkClick);
+  }
+
+  connectedCallback() {
+    this.#renderLinks();
