new file mode 100644
index 0000000..7ea8c13
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,235 @@
+import { baseStyles } from './shared-styles.js';
+
+const styles = new CSSStyleSheet();
+styles.replaceSync(`
+  :host {
+    display: block;
+    height: 100%;
+  }
+
+  article {
+    position: relative;
+    display: flex;
+    flex-direction: column;
+    height: 100%;
+    background: var(--dg-surface, #fff);
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    overflow: hidden;
+    text-align: center;
+    transition: box-shadow 0.3s, transform 0.3s;
+  }
+  article:hover,
+  article:focus-within {
+    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
+    transform: translateY(-2px);
+  }
+
+  .media {
+    aspect-ratio: 3 / 2;
+    background: var(--dg-secondary, #d7ccc8);
+  }
+  .media img {
+    display: block;
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+  }
+
+  .body {
+    display: flex;
+    flex-direction: column;
+    flex: 1;
+    padding: 20px;
+  }
+
+  ::slotted([slot='title']) {
+    margin: 0 0 10px;
+    color: var(--dg-primary, #4e342e);
+    font-size: 1.17rem;
+  }
+  ::slotted(:not([slot])) {
+    margin: 0;
+    color: var(--dg-text, #3e2723);
+  }
+
+  .price {
+    margin: 10px 0 0;
+    font-weight: 700;
+    color: var(--dg-primary, #4e342e);
+  }
+
+  .actions {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    align-items: center;
+    gap: 10px;
+    margin-top: auto;
+    padding-top: 15px;
+  }
+
+  .favorite {
+    display: inline-grid;
+    place-items: center;
+    width: 44px;
+    height: 44px;
+    padding: 0;
+    border: 2px solid var(--dg-primary, #4e342e);
+    border-radius: 50%;
+    background: transparent;
+    color: var(--dg-primary, #4e342e);
+    cursor: pointer;
+    transition: background-color 0.3s, color 0.3s;
+  }
+  .favorite svg { width: 20px; height: 20px; }
+  .favorite path { fill: none; stroke: currentColor; stroke-width: 2; }
+  .favorite[aria-pressed='true'] {
+    background: var(--dg-primary, #4e342e);
+    color: var(--dg-accent, #ffab40);
+  }
+  .favorite[aria-pressed='true'] path { fill: currentColor; }
+
+  @media (forced-colors: active) {
+    article { border: 1px solid CanvasText; }
+    .favorite[aria-pressed='true'] { background: Highlight; color: HighlightText; }
+  }
+`);
+
+/**
+ * <coffee-card>
+ *
+ * A product card for a menu item.
+ *
+ * Attributes:
+ *   href        – destination of the "View Details" link (required for the CTA to render)
+ *   image       – image URL (optional)
+ *   image-alt   – alt text for the image; omit/empty for decorative images
+ *   price       – display price, e.g. "$5.25" (optional)
+ *   cta-label   – visible CTA text (default "View Details")
+ *   favorited   – boolean; reflects the favourite toggle state
+ *   no-favorite – boolean; hide the favourite toggle
+ *
+ * Slots:
+ *   title   – the card heading (use a real heading element, e.g. <h3>, to keep
+ *             the document outline correct)
+ *   default – description content
+ *
+ * Events:
+ *   favorite-change – { detail: { favorited, title } }, bubbles & composed
+ *
+ * Parts: card, media, image, body, price, cta, favorite
+ */
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['href', 'image', 'image-alt', 'price', 'cta-label', 'favorited', 'no-favorite'];
+
+  #els = {};
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, styles];
+    root.innerHTML = `
+      <article part="card">
+        <div class="media" part="media" hidden>
+          <img part="image" loading="lazy" decoding="async" alt="">
+        </div>
+        <div class="body" part="body">
+          <slot name="title"></slot>
+          <slot></slot>
+          <p class="price" part="price" hidden></p>
+          <div class="actions">
+            <a class="btn" part="cta" hidden>
+              <span class="cta-label">View Details</span><span class="visually-hidden cta-context"></span>
+            </a>
+            <button type="button" class="favorite" part="favorite" aria-pressed="false">
+              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+                <path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.6 1.2 4.4 2.4h1.8c.8-1.2 2.3-2.4 4.4-2.4 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z"/>
+              </svg>
+              <span class="visually-hidden favorite-label"></span>
+            </button>
+          </div>
+        </div>
+      </article>
+    `;
+    const $ = (sel) => root.querySelector(sel);
+    this.#els = {
+      media: $('.media'),
+      img: $('img'),
+      price: $('.price'),
+      cta: $('.btn'),
+      ctaLabel: $('.cta-label'),
+      ctaContext: $('.cta-context'),
+      favorite: $('.favorite'),
+      favoriteLabel: $('.favorite-label'),
+      titleSlot: $('slot[name="title"]'),
+    };
+
+    this.#els.titleSlot.addEventListener('slotchange', () => this.#syncTitle());
+    this.#els.favorite.addEventListener('click', () => {
+      this.favorited = !this.favorited;
+      this.dispatchEvent(new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { favorited: this.favorited, title: this.cardTitle },
+      }));
+    });
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback() {
+    this.#render();
+  }
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+  set favorited(value) {
+    this.toggleAttribute('favorited', Boolean(value));
+  }
+
+  /** Plain-text title taken from the slotted heading. */
+  get cardTitle() {
+    return this.#els.titleSlot
+      .assignedElements()
+      .map((el) => el.textContent.trim())
+      .join(' ');
+  }
+
+  #syncTitle() {
+    const title = this.cardTitle;
+    // Visible text stays "View Details"; the hidden suffix gives screen-reader
+    // users a unique, descriptive link name ("View Details about Cold Brew").
+    this.#els.ctaContext.textContent = title ? ` about ${title}` : '';
+    this.#els.favoriteLabel.textContent = title ? `Favorite ${title}` : 'Favorite';
+  }
+
+  #render() {
+    const { media, img, price, cta, ctaLabel, favorite } = this.#els;
+
+    const src = this.getAttribute('image');
+    media.hidden = !src;
+    if (src && img.getAttribute('src') !== src) img.src = src;
+    img.alt = this.getAttribute('image-alt') ?? '';
+
+    const priceText = this.getAttribute('price');
+    price.hidden = !priceText;
+    price.textContent = priceText ?? '';
+
+    const href = this.getAttribute('href');
+    cta.hidden = !href;
+    if (href) cta.href = href;
+    else cta.removeAttribute('href');
+    ctaLabel.textContent = this.getAttribute('cta-label') || 'View Details';
+
+    favorite.hidden = this.hasAttribute('no-favorite');
+    favorite.setAttribute('aria-pressed', String(this.favorited));
+
+    this.#syncTitle();
+  }
+}
+
+if (!customElements.get('coffee-card')) customElements.define('coffee-card', CoffeeCard);
diff --git a/components/hero-banner.js b/components/hero-banner.js
new file mode 100644
index 0000000..d0ca7ac
--- /dev/null
+++ b/components/hero-banner.js
@@ -0,0 +1,110 @@
+import { baseStyles } from './shared-styles.js';
+
+const styles = new CSSStyleSheet();
+styles.replaceSync(`
+  :host {
+    --_overlay: var(--dg-hero-overlay, rgba(0, 0, 0, 0.5));
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    min-height: var(--dg-hero-height, 60vh);
+    padding: 40px 20px;
+    background-color: var(--dg-primary, #4e342e);
+    background-image: linear-gradient(var(--_overlay), var(--_overlay)), var(--_image, none);
+    background-size: cover;
+    background-position: center;
+    color: #fff;
+    text-align: center;
+  }
+
+  ::slotted([slot='heading']) {
+    margin: 0 0 1rem;
+    font-size: clamp(2rem, 6vw, 3rem);
+    line-height: 1.2;
+  }
+  ::slotted(:not([slot])) {
+    margin: 0;
+    max-width: 60ch;
+    font-size: 1.1rem;
+  }
+
+  .actions {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: 12px;
+    margin-top: 15px;
+  }
+  .actions:not(.has-content) { display: none; }
+
+  ::slotted(a[slot='actions']) {
+    display: inline-flex;
+    align-items: center;
+    min-height: 44px;
+    padding: 10px 20px;
+    background: var(--dg-primary, #4e342e);
+    color: #fff;
+    border: 2px solid transparent;
+    border-radius: 5px;
+    font-weight: 600;
+    text-decoration: none;
+    transition: background-color 0.3s;
+  }
+  ::slotted(a[slot='actions']:hover) {
+    background: var(--dg-primary-dark, #3e2723);
+  }
+  ::slotted(a[slot='actions']:focus-visible) {
+    outline: 3px solid var(--dg-focus, #ffab40);
+    outline-offset: 3px;
+  }
+  ::slotted(a[slot='actions'][data-variant='outline']) {
+    background: transparent;
+    border-color: currentColor;
+  }
+`);
+
+/**
+ * <hero-banner>
+ *
+ * Full-width hero with a darkened background image.
+ * The image is purely decorative (CSS background); put meaningful content in slots.
+ *
+ * Attributes:
+ *   image – background image URL
+ *
+ * Slots:
+ *   heading – main heading (use <h1>)
+ *   default – supporting copy
+ *   actions – call-to-action links (data-variant="outline" for secondary style)
+ *
+ * Parts: actions
+ */
+export class HeroBanner extends HTMLElement {
+  static observedAttributes = ['image'];
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [baseStyles, styles];
+    root.innerHTML = `
+      <slot name="heading"></slot>
+      <slot></slot>
+      <div class="actions" part="actions"><slot name="actions"></slot></div>
+    `;
+    const actions = root.querySelector('.actions');
+    root.querySelector('slot[name="actions"]').addEventListener('slotchange', (e) => {
+      actions.classList.toggle('has-content', e.target.assignedElements().length > 0);
+    });
+  }
+
+  attributeChangedCallback(_name, _old, value) {
+    if (value) {
+      this.style.setProperty('--_image', `url(${JSON.stringify(value)})`);
+    } else {
+      this.style.removeProperty('--_image');
+    }
+  }
+}
+
+if (!customElements.get('hero-banner')) customElements.define('hero-banner', HeroBanner);
