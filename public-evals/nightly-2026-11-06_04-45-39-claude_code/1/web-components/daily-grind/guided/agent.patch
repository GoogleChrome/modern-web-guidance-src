@@ -0,0 +1,181 @@
+import { css, sharedSheet } from './styles.js';
+
+const sheet = css`
+  :host {
+    display: block;
+    position: sticky;
+    inset-block-start: 0;
+    z-index: 1000;
+    container-type: inline-size;
+    background: var(--_primary);
+    color: #fff;
+  }
+
+  .bar {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 0.5rem 1.25rem;
+    padding: 1rem 5%;
+  }
+
+  ::slotted([slot='brand']) {
+    color: inherit;
+    font-size: 1.5rem;
+    font-weight: bold;
+    letter-spacing: 1px;
+    text-decoration: none;
+    text-transform: uppercase;
+  }
+
+  nav {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 0.5rem 1.25rem;
+  }
+
+  ::slotted(a) {
+    color: #fff;
+    font-size: 0.9rem;
+    text-decoration: none;
+    padding-block: 5px;
+  }
+
+  ::slotted(a:hover) { color: var(--_accent); }
+
+  ::slotted(a:focus-visible) {
+    outline: 2px solid var(--_focus);
+    outline-offset: 3px;
+    border-radius: 2px;
+  }
+
+  ::slotted([aria-current='page']) { color: var(--_accent); }
+
+  ::slotted([data-variant='outline']) {
+    border: 1px solid var(--_accent);
+    padding: 5px 12px;
+    border-radius: 4px;
+  }
+
+  .toggle {
+    display: none;
+    place-items: center;
+    inline-size: 2.75rem;
+    block-size: 2.75rem;
+    padding: 0;
+    background: transparent;
+    color: inherit;
+    border: 1px solid rgb(255 255 255 / 0.5);
+    border-radius: 4px;
+    cursor: pointer;
+  }
+
+  .toggle:focus-visible {
+    outline: 2px solid var(--_focus);
+    outline-offset: 2px;
+  }
+
+  .toggle svg {
+    inline-size: 1.5rem;
+    block-size: 1.5rem;
+    stroke: currentColor;
+    stroke-width: 2;
+    stroke-linecap: round;
+  }
+
+  .toggle[aria-expanded='true'] .icon-open,
+  .toggle[aria-expanded='false'] .icon-close { display: none; }
+
+  @media (prefers-reduced-motion: no-preference) {
+    ::slotted(a) { transition: color 0.3s; }
+  }
+
+  /* Narrow: collapse links behind a disclosure button. */
+  @container (max-width: 44rem) {
+    .toggle { display: grid; }
+
+    nav {
+      flex-basis: 100%;
+      flex-direction: column;
+      align-items: stretch;
+      gap: 0.25rem;
+      padding-block-start: 0.5rem;
+    }
+
+    nav:not(.open) { display: none; }
+
+    ::slotted(a) { padding-block: 0.5rem; }
+    ::slotted([data-variant='outline']) { align-self: flex-start; }
+  }
+`;
+
+/**
+ * <site-nav label="Main">
+ *   <span slot="brand">The Daily Grind</span>
+ *   <a href="/menu">Menu</a>
+ *   <a href="/logout" data-variant="outline">Logout</a>
+ * </site-nav>
+ *
+ * Sticky site header with a <nav> landmark. Links stay in the Light DOM so
+ * they work before/without JS; when the component is narrow they collapse
+ * behind a disclosure button (aria-expanded, Escape to close).
+ * Parts: `bar`, `toggle`.
+ */
+export class SiteNav extends HTMLElement {
+  static observedAttributes = ['label'];
+
+  #nav;
+  #toggle;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sharedSheet, sheet];
+    root.innerHTML = `
+      <div class="bar" part="bar">
+        <slot name="brand"></slot>
+        <button class="toggle" part="toggle" type="button" aria-expanded="false" aria-controls="links">
+          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+            <path class="icon-open" d="M4 7h16M4 12h16M4 17h16"/>
+            <path class="icon-close" d="M6 6l12 12M18 6L6 18"/>
+          </svg>
+          <span class="visually-hidden">Navigation</span>
+        </button>
+        <nav id="links"><slot></slot></nav>
+      </div>`;
+
+    this.#nav = root.querySelector('nav');
+    this.#toggle = root.querySelector('.toggle');
+    this.#toggle.addEventListener('click', () => this.toggle());
+    this.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape' && this.open) {
+        this.toggle(false);
+        this.#toggle.focus();
+      }
+    });
+  }
+
+  connectedCallback() {
+    this.#nav.setAttribute('aria-label', this.getAttribute('label') || 'Main');
+  }
+
+  attributeChangedCallback() {
+    this.#nav.setAttribute('aria-label', this.getAttribute('label') || 'Main');
+  }
+
+  get open() {
+    return this.#toggle.getAttribute('aria-expanded') === 'true';
+  }
+
+  /** Open/close the collapsed menu (no effect on layout when wide). */
+  toggle(force = !this.open) {
+    this.#toggle.setAttribute('aria-expanded', String(force));
+    this.#nav.classList.toggle('open', force);
+  }
+}
+
+if (!customElements.get('site-nav')) {
+  customElements.define('site-nav', SiteNav);
+}
diff --git a/components/styles.js b/components/styles.js
