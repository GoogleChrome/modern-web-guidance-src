@@ -0,0 +1,101 @@
+import { css, sharedSheet, buttonRules } from './styles.js';
+
+const sheet = css`
+  :host {
+    display: grid;
+    min-block-size: var(--hero-height, 60vh);
+    color: #fff;
+    text-align: center;
+    background: var(--_primary-strong);
+  }
+
+  /* Stack the photo, scrim, and content in one grid cell. */
+  .stack > * { grid-area: 1 / 1; }
+
+  .stack {
+    display: grid;
+    overflow: hidden;
+  }
+
+  img {
+    inline-size: 100%;
+    block-size: 100%;
+    object-fit: cover;
+  }
+
+  img:not([src]) { display: none; }
+
+  .scrim { background: rgb(0 0 0 / var(--hero-scrim, 0.5)); }
+
+  .content {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    gap: 1rem;
+    padding: 2rem 20px;
+  }
+
+  ::slotted(h1) {
+    font-size: clamp(2rem, 6vw, 3rem);
+    line-height: 1.2;
+  }
+
+  .actions { margin-block-start: 0.25rem; }
+
+  ${buttonRules("::slotted([slot='action'])")}
+`;
+
+/**
+ * <hero-banner image="https://…" image-alt="">
+ *   <h1>Wake Up Your Senses</h1>
+ *   <p>Ethically sourced…</p>
+ *   <a slot="action" href="/order-online">Order Now</a>
+ * </hero-banner>
+ *
+ * Full-bleed hero with a background photo, a contrast scrim, and slotted
+ * heading/copy/call-to-action. The photo is a real <img> (high fetch priority)
+ * so it can be discovered and prioritised as the LCP element.
+ * Custom properties: --hero-height, --hero-scrim. Parts: `image`, `content`.
+ */
+export class HeroBanner extends HTMLElement {
+  static observedAttributes = ['image', 'image-alt'];
+
+  #img;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sharedSheet, sheet];
+    root.innerHTML = `
+      <div class="stack">
+        <img part="image" alt="" fetchpriority="high" decoding="async">
+        <div class="scrim"></div>
+        <div class="content" part="content">
+          <slot></slot>
+          <div class="actions"><slot name="action"></slot></div>
+        </div>
+      </div>`;
+    this.#img = root.querySelector('img');
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback() {
+    this.#render();
+  }
+
+  #render() {
+    const src = this.getAttribute('image');
+    if (src) this.#img.src = src;
+    else this.#img.removeAttribute('src');
+    // Decorative by default; pass image-alt when the photo conveys content.
+    this.#img.alt = this.getAttribute('image-alt') ?? '';
+  }
+}
+
+if (!customElements.get('hero-banner')) {
+  customElements.define('hero-banner', HeroBanner);
+}
