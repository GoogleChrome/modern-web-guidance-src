index 0000000..d493c6c
--- /dev/null
+++ b/components/styles.js
@@ -0,0 +1,71 @@
+/**
+ * Shared helpers for Daily Grind components.
+ *
+ * Theming contract: components read the public `--dg-*` custom properties
+ * (inherited across the shadow boundary) through private `--_*` aliases so
+ * every fallback is declared exactly once.
+ */
+
+/** Build a constructable stylesheet that can be adopted by many shadow roots. */
+export function css(strings, ...values) {
+  const sheet = new CSSStyleSheet();
+  sheet.replaceSync(String.raw({ raw: strings }, ...values));
+  return sheet;
+}
+
+/** Private token aliases, applied on :host of every component. */
+export const tokens = `
+  --_primary: var(--dg-color-primary, #4e342e);
+  --_primary-strong: var(--dg-color-primary-strong, #3e2723);
+  --_secondary: var(--dg-color-secondary, #d7ccc8);
+  --_accent: var(--dg-color-accent, #ffab40);
+  --_text: var(--dg-color-text, #3e2723);
+  --_surface: var(--dg-color-surface, #fff);
+  --_radius: var(--dg-radius, 8px);
+  --_focus: var(--dg-color-focus, #ffab40);
+`;
+
+/** Button look, reusable for internal elements or slotted links. */
+export function buttonRules(selector) {
+  return `
+    ${selector} {
+      display: inline-block;
+      background: var(--_primary);
+      color: #fff;
+      font: inherit;
+      padding: 10px 20px;
+      border: 0;
+      border-radius: 5px;
+      text-decoration: none;
+      cursor: pointer;
+    }
+    ${selector}:hover { background: var(--_primary-strong); }
+    ${selector}:focus-visible {
+      outline: 3px solid var(--_focus);
+      outline-offset: 2px;
+    }
+    @media (prefers-reduced-motion: no-preference) {
+      ${selector} { transition: background-color 0.3s; }
+    }
+  `;
+}
+
+/** Shared utilities adopted by every component. */
+export const sharedSheet = css`
+  :host { ${tokens} }
+  :host([hidden]) { display: none !important; }
+
+  .visually-hidden {
+    position: absolute !important;
+    width: 1px;
+    height: 1px;
+    margin: -1px;
+    padding: 0;
+    overflow: hidden;
+    clip-path: inset(50%);
+    white-space: nowrap;
+    border: 0;
+  }
+
+  ${buttonRules('.btn')}
+`;
