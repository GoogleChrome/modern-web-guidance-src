diff --git a/components/coffee-card.js b/components/coffee-card.js
new file mode 100644
index 0000000..1272e25
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,201 @@
+import { css, sharedSheet } from './styles.js';
+import './favorite-button.js';
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? []);
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorites(set) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
+  } catch {
+    // Storage unavailable (private mode, quota): favourite still works for the session.
+  }
+}
+
+const sheet = css`
+  :host {
+    display: block;
+    container-type: inline-size;
+    color: var(--_text);
+  }
+
+  article {
+    display: flex;
+    flex-direction: column;
+    block-size: 100%;
+    overflow: hidden;
+    background: var(--_surface);
+    border-radius: var(--_radius);
+    box-shadow: 0 2px 5px rgb(0 0 0 / 0.1);
+  }
+
+  /* Only the media slot box; hidden entirely when nothing is slotted. */
+  .media:not(.has-media) { display: none; }
+
+  ::slotted([slot='media']) {
+    display: block;
+    inline-size: 100%;
+    block-size: 100%;
+    aspect-ratio: 4 / 3;
+    object-fit: cover;
+  }
+
+  .body {
+    flex: 1;
+    display: flex;
+    flex-direction: column;
+    gap: 0.5rem;
+    padding: 20px;
+    text-align: center;
+  }
+
+  ::slotted([slot='title']) {
+    color: var(--_primary);
+    font-size: 1.17em;
+  }
+
+  footer {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    gap: 0.75rem;
+    margin-block-start: auto;
+    padding-block-start: 0.5rem;
+  }
+
+  /* Wide card with media: put the photo in a side column. */
+  @container (min-width: 32rem) {
+    article:has(.has-media) {
+      display: grid;
+      grid-template-columns: minmax(0, 2fr) 3fr;
+    }
+    article:has(.has-media) .body {
+      text-align: start;
+      justify-content: center;
+    }
+    article:has(.has-media) footer { justify-content: flex-start; }
+  }
+`;
+
+/**
+ * <coffee-card href="/menu/cold-brew" favorite-key="cold-brew">
+ *   <img slot="media" src="…" alt="">
+ *   <h3 slot="title">Cold Brew</h3>
+ *   <p>Steeped for 18 hours…</p>
+ * </coffee-card>
+ *
+ * Attributes:
+ *   href          destination of the "View details" link
+ *   action-label  visible link text (default "View details")
+ *   favorite-key  storage key for the favourite toggle (defaults to href)
+ *
+ * Events: `favorite-change` (bubbles, composed) with detail { key, name, favorited }.
+ * Parts: `card`, `action`, `favorite` (re-exported as `favorite-button`).
+ */
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['href', 'action-label', 'favorite-key'];
+
+  #root;
+  #link;
+  #linkText;
+  #linkContext;
+  #favorite;
+  #media;
+
+  constructor() {
+    super();
+    this.#root = this.attachShadow({ mode: 'open' });
+    this.#root.adoptedStyleSheets = [sharedSheet, sheet];
+    this.#root.innerHTML = `
+      <article part="card">
+        <div class="media"><slot name="media"></slot></div>
+        <div class="body">
+          <slot name="title"></slot>
+          <slot></slot>
+          <footer>
+            <a class="btn" part="action"><span class="text"></span><span class="visually-hidden context"></span></a>
+            <favorite-button part="favorite" exportparts="button: favorite-button"></favorite-button>
+          </footer>
+        </div>
+      </article>`;
+
+    this.#link = this.#root.querySelector('a');
+    this.#linkText = this.#root.querySelector('.text');
+    this.#linkContext = this.#root.querySelector('.context');
+    this.#favorite = this.#root.querySelector('favorite-button');
+    this.#media = this.#root.querySelector('.media');
+
+    this.#root.querySelector('slot[name="media"]').addEventListener('slotchange', (e) => {
+      this.#media.classList.toggle('has-media', e.target.assignedElements().length > 0);
+    });
+    this.#root.querySelector('slot[name="title"]').addEventListener('slotchange', () => this.#renderName());
+    this.#favorite.addEventListener('change', () => this.#onFavoriteChange());
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback() {
+    this.#render();
+  }
+
+  /** Drink name, taken from the slotted title. */
+  get name() {
+    const [title] = this.#root.querySelector('slot[name="title"]').assignedElements();
+    return title?.textContent.trim() ?? '';
+  }
+
+  get favoriteKey() {
+    return this.getAttribute('favorite-key') || this.getAttribute('href') || this.name;
+  }
+
+  get favorited() {
+    return this.#favorite.pressed;
+  }
+
+  #render() {
+    const href = this.getAttribute('href');
+    if (href) this.#link.href = href;
+    else this.#link.removeAttribute('href');
+    this.#link.hidden = !href;
+    this.#linkText.textContent = this.getAttribute('action-label') || 'View details';
+    this.#favorite.pressed = readFavorites().has(this.favoriteKey);
+    this.#renderName();
+  }
+
+  #renderName() {
+    const name = this.name;
+    // Disambiguate identical "View details" links in screen-reader link lists.
+    this.#linkContext.textContent = name ? ` about ${name}` : '';
+    this.#favorite.setAttribute('label', name ? `Favorite ${name}` : 'Favorite');
+  }
+
+  #onFavoriteChange() {
+    const favorites = readFavorites();
+    const key = this.favoriteKey;
+    const favorited = this.#favorite.pressed;
+    if (favorited) favorites.add(key);
+    else favorites.delete(key);
+    writeFavorites(favorites);
+
+    this.dispatchEvent(
+      new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { key, name: this.name, favorited },
+      }),
+    );
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
diff --git a/components/favorite-button.js b/components/favorite-button.js
new file mode 100644
index 0000000..fdacb1f
--- /dev/null
+++ b/components/favorite-button.js
@@ -0,0 +1,120 @@
+import { css, sharedSheet } from './styles.js';
+
+const sheet = css`
+  :host {
+    display: inline-block;
+    --_size: var(--favorite-size, 2.5rem);
+  }
+
+  button {
+    display: grid;
+    place-items: center;
+    inline-size: var(--_size);
+    block-size: var(--_size);
+    padding: 0;
+    border: 2px solid var(--_secondary);
+    border-radius: 50%;
+    background: var(--_surface);
+    color: var(--_primary);
+    font: inherit;
+    cursor: pointer;
+  }
+
+  button:hover { border-color: var(--_primary); }
+
+  button:focus-visible {
+    outline: 3px solid var(--_focus);
+    outline-offset: 2px;
+  }
+
+  svg {
+    inline-size: 55%;
+    block-size: 55%;
+    fill: transparent;
+    stroke: currentColor;
+    stroke-width: 2;
+  }
+
+  /* Pressed: fill the heart (shape change, not colour alone). */
+  :host([pressed]) button { border-color: #c62828; color: #c62828; }
+  :host([pressed]) svg { fill: currentColor; }
+
+  @media (prefers-reduced-motion: no-preference) {
+    button { transition: border-color 0.2s, transform 0.2s; }
+    button:active { transform: scale(0.92); }
+  }
+
+  @media (forced-colors: active) {
+    :host([pressed]) svg { fill: ButtonText; }
+  }
+`;
+
+/**
+ * <favorite-button label="Favorite Cold Brew" pressed>
+ *
+ * A toggle button wrapping a native <button aria-pressed>.
+ * - `pressed` attribute / property reflects state.
+ * - Exposes the `:state(pressed)` custom state for consumer styling.
+ * - Dispatches a bubbling `change` event when toggled by the user.
+ * - Part: `button`.
+ */
+export class FavoriteButton extends HTMLElement {
+  static observedAttributes = ['pressed', 'label'];
+
+  #internals = this.attachInternals();
+  #button;
+
+  constructor() {
+    super();
+    // The inner <button> owns the semantics, so delegate focus to it.
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.adoptedStyleSheets = [sharedSheet, sheet];
+    root.innerHTML = `
+      <button type="button" part="button" aria-pressed="false">
+        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+          <path d="M12 20.5s-7.5-4.6-9.3-9.2C1.5 8.1 3.6 4.5 7.2 4.5c2 0 3.6 1.1 4.8 2.8 1.2-1.7 2.8-2.8 4.8-2.8 3.6 0 5.7 3.6 4.5 6.8-1.8 4.6-9.3 9.2-9.3 9.2z"/>
+        </svg>
+      </button>`;
+    this.#button = root.querySelector('button');
+    this.#button.addEventListener('click', () => this.toggle());
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback() {
+    this.#render();
+  }
+
+  get pressed() {
+    return this.hasAttribute('pressed');
+  }
+
+  set pressed(value) {
+    this.toggleAttribute('pressed', Boolean(value));
+  }
+
+  /** Flip state as a user action and notify listeners. */
+  toggle() {
+    this.pressed = !this.pressed;
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  #render() {
+    const pressed = this.pressed;
+    this.#button.setAttribute('aria-pressed', String(pressed));
+    // Keep the label constant; aria-pressed conveys the state.
+    this.#button.setAttribute('aria-label', this.getAttribute('label') || 'Favorite');
+    try {
+      if (pressed) this.#internals.states.add('pressed');
+      else this.#internals.states.delete('pressed');
+    } catch {
+      // CustomStateSet unsupported: the reflected [pressed] attribute still works.
+    }
+  }
+}
+
+if (!customElements.get('favorite-button')) {
+  customElements.define('favorite-button', FavoriteButton);
+}
