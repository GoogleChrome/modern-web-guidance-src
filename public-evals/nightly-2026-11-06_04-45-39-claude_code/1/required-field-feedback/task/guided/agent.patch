+  <script>
+    // Mirror the browser's interaction-aware :user-invalid state into aria-invalid
+    // so screen readers only hear about errors when sighted users see them.
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const sync = (input) => {
+        if (input.matches(':user-invalid')) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+      };
+      const handle = (e) => {
+        if (e.target.matches?.('input')) sync(e.target);
+      };
+      form.addEventListener('blur', handle, true);
+      form.addEventListener('invalid', handle, true);
+      form.addEventListener('input', (e) => {
+        if (e.target.getAttribute?.('aria-invalid') === 'true') sync(e.target);
+      });
+    })();
+  </script>
+
 </body>
 
