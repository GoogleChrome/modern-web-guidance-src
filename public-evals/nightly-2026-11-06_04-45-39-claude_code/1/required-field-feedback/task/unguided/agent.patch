+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const input = document.getElementById('newsletter-email');
+      const error = document.getElementById('newsletter-email-error');
+      const success = form.querySelector('.success-message');
+
+      // Errors stay hidden until the user has interacted with the field
+      // (focused and left it) or tried to submit the form.
+      let touched = false;
+
+      function getError() {
+        if (input.validity.valueMissing) return 'Please enter your email address.';
+        if (input.validity.typeMismatch) return 'Please enter a valid email address.';
+        return '';
+      }
+
+      function updateError() {
+        const message = touched ? getError() : '';
+        error.textContent = message;
+        error.hidden = !message;
+        if (message) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+      }
+
+      input.addEventListener('blur', function () {
+        touched = true;
+        updateError();
+      });
+
+      // Once an error is showing, clear it live as the user fixes it.
+      input.addEventListener('input', function () {
+        success.hidden = true;
+        if (touched) updateError();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        touched = true;
+        updateError();
+        if (!input.checkValidity()) {
+          input.focus();
+          return;
+        }
+        // TODO: send input.value to the mailing list provider/backend.
+        success.textContent = 'Thanks for subscribing! Check your inbox for a welcome email.';
+        success.hidden = false;
+        form.reset();
+        touched = false;
+        updateError();
+      });
+    })();
+  </script>
+
 </body>
 
