+  <script>
+    (function () {
+      const container = document.getElementById('domContainer');
+      const stage = container.parentElement;
+      const addBtn = document.getElementById('addBtn');
+      const removeBtn = document.getElementById('removeBtn');
+      const toggleBtn = document.getElementById('toggleBtn');
+      const toggleCard = document.getElementById('toggleCard');
+
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
+
+      const ENTER = [
+        { opacity: 0, transform: 'scale(0.85)' },
+        { opacity: 1, transform: 'scale(1)' }
+      ];
+      const EXIT = [
+        { opacity: 1, transform: 'scale(1)' },
+        { opacity: 0, transform: 'scale(0.85)' }
+      ];
+
+      function animate(el, frames) {
+        if (typeof el.animate !== 'function') return Promise.resolve();
+        // Respect reduced-motion: fade only, very short, no scaling.
+        const opts = reduceMotion.matches
+          ? { duration: 120, easing: 'linear' }
+          : { duration: 320, easing: EASE };
+        const kf = reduceMotion.matches
+          ? frames.map(f => ({ opacity: f.opacity }))
+          : frames;
+        const anim = el.animate(kf, opts);
+        return anim.finished.catch(() => { });
+      }
+
+      const PROMOS = [
+        {
+          title: 'Free Pastry Friday',
+          text: 'Get a free croissant with any large drink every Friday.',
+          img: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=600&q=70',
+          alt: 'Cup of coffee on a wooden table'
+        },
+        {
+          title: 'Cold Brew Club',
+          text: 'Double reward stars on every cold brew this month.',
+          img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=70',
+          alt: 'Iced coffee in a glass'
+        },
+        {
+          title: 'Bean Bundle Deal',
+          text: 'Buy two bags of house roast, get the third 50% off.',
+          img: 'https://images.unsplash.com/photo-1511920170033-f8396924c348?auto=format&fit=crop&w=600&q=70',
+          alt: 'Coffee being brewed'
+        }
+      ];
+      let promoCount = 0;
+
+      function createPromoCard() {
+        const data = PROMOS[promoCount % PROMOS.length];
+        promoCount += 1;
+
+        const card = document.createElement('article');
+        card.className = 'card promo-card';
+
+        const img = document.createElement('img');
+        img.src = data.img;
+        img.alt = data.alt;
+        img.loading = 'lazy';
+
+        const badge = document.createElement('span');
+        badge.className = 'promo-badge';
+        badge.textContent = 'PROMO #' + promoCount;
+
+        const h3 = document.createElement('h3');
+        h3.textContent = data.title;
+
+        const p = document.createElement('p');
+        p.textContent = data.text;
+
+        card.append(img, badge, h3, p);
+        return card;
+      }
+
+      function getCards() {
+        return container.querySelectorAll(':scope > .card');
+      }
+
+      function updateButtons() {
+        removeBtn.disabled = getCards().length === 0;
+        const present = container.contains(toggleCard);
+        toggleBtn.disabled = !present;
+        toggleBtn.setAttribute('aria-expanded', String(present && !toggleCard.hidden));
+      }
+
+      // Add: append immediately, then fade + scale in.
+      addBtn.addEventListener('click', function () {
+        const card = createPromoCard();
+        container.appendChild(card);
+        animate(card, ENTER);
+        updateButtons();
+      });
+
+      // Remove: detach the real card right away (so the DOM reflects the new
+      // state synchronously) and play the fade + scale out on a visual-only
+      // ghost copy positioned exactly where the card was.
+      removeBtn.addEventListener('click', function () {
+        const cards = getCards();
+        const card = cards[cards.length - 1];
+        if (!card) return;
+
+        const wasVisible = !card.hidden || card.classList.contains('is-leaving');
+        let ghost = null;
+
+        if (wasVisible) {
+          const stageRect = stage.getBoundingClientRect();
+          const rect = card.getBoundingClientRect();
+          ghost = card.cloneNode(true);
+          ghost.removeAttribute('id');
+          ghost.removeAttribute('hidden');
+          ghost.className = 'promo-ghost';
+          ghost.setAttribute('aria-hidden', 'true');
+          // Carry over any in-flight transform/opacity for a seamless handoff.
+          const cs = getComputedStyle(card);
+          ghost.style.opacity = cs.opacity;
+          ghost.style.left = (rect.left - stageRect.left) + 'px';
+          ghost.style.top = (rect.top - stageRect.top) + 'px';
+          ghost.style.width = rect.width + 'px';
+          ghost.style.height = rect.height + 'px';
+        }
+
+        card.getAnimations && card.getAnimations().forEach(a => a.cancel());
+        card.classList.remove('is-leaving');
+        card.remove();
+        updateButtons();
+
+        if (ghost) {
+          stage.appendChild(ghost);
+          animate(ghost, EXIT).then(() => ghost.remove());
+        }
+      });
+
+      // Toggle: flip the hidden attribute immediately, animating either way.
+      toggleBtn.addEventListener('click', function () {
+        if (!container.contains(toggleCard)) return;
+
+        toggleCard.getAnimations && toggleCard.getAnimations().forEach(a => a.cancel());
+
+        if (toggleCard.hasAttribute('hidden')) {
+          toggleCard.classList.remove('is-leaving');
+          toggleCard.removeAttribute('hidden');
+          animate(toggleCard, ENTER);
+        } else {
+          toggleCard.setAttribute('hidden', '');
+          toggleCard.classList.add('is-leaving');
+          animate(toggleCard, EXIT).then(() => {
+            // Only finish if it wasn't re-shown mid-animation.
+            if (toggleCard.hidden) toggleCard.classList.remove('is-leaving');
+          });
+        }
+        updateButtons();
+      });
+
+      updateButtons();
+    })();
+  </script>
+
