+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const toggleCard = document.getElementById('toggleCard');
+    const toggleBtn = document.getElementById('toggleBtn');
+
+    const promos = [
+      ['Double Stamp Tuesday', 'Earn twice the rewards stamps on every purchase.'],
+      ['Cold Brew Combo', 'Pair any cold brew with a muffin for just $6.'],
+      ['Bean Bag Deal', '15% off all whole-bean bags this week only.'],
+      ['Early Bird Special', '$1 off any espresso drink before 8 AM.'],
+      ['Student Saver', 'Show your student ID for 10% off your order.'],
+    ];
+    let promoCount = 0;
+
+    // Firefox parses allow-discrete but doesn't transition display (bug 1882408),
+    // so probe for real support and fall back to a data-closing exit state.
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return (supportsDisplayTransition = false);
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    async function waitForAnimations(el) {
+      const animations = el.getAnimations();
+      if (animations.length > 0) {
+        await Promise.race([
+          Promise.allSettled(animations.map((a) => a.finished)),
+          new Promise((r) => setTimeout(r, 2000)),
+        ]);
+      }
+    }
+
+    async function hideElement(el) {
+      if (canTransitionDisplay()) {
+        el.hidden = true;
+      } else {
+        el.setAttribute('data-closing', '');
+      }
+      await waitForAnimations(el);
+      // Skipped if showElement() cancelled the close mid-animation.
+      if (el.hasAttribute('data-closing')) {
+        el.removeAttribute('data-closing');
+        el.hidden = true;
+      }
+    }
+
+    function showElement(el) {
+      el.removeAttribute('data-closing');
+      el.hidden = false;
+    }
+
+    async function removeElement(el) {
+      el.setAttribute('data-removing', '');
+      await hideElement(el);
+      el.remove();
+    }
+
+    function createPromoCard() {
+      const [title, text] = promos[promoCount % promos.length];
+      promoCount++;
+      const card = document.createElement('div');
+      card.className = 'card';
+      const badge = document.createElement('span');
+      badge.className = 'promo-badge';
+      badge.textContent = 'New';
+      const h3 = document.createElement('h3');
+      h3.textContent = title;
+      const p = document.createElement('p');
+      p.textContent = text;
+      card.append(badge, h3, p);
+      return card;
+    }
+
+    document.getElementById('addBtn').addEventListener('click', () => {
+      domContainer.appendChild(createPromoCard());
+    });
+
+    document.getElementById('removeBtn').addEventListener('click', () => {
+      // Skip cards already animating out so rapid clicks remove successive cards.
+      const cards = domContainer.querySelectorAll(':scope > .card:not([data-removing])');
+      const last = cards[cards.length - 1];
+      if (last) removeElement(last);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      const isHiding = !(toggleCard.hidden || toggleCard.hasAttribute('data-closing'));
+      toggleBtn.setAttribute('aria-expanded', String(!isHiding));
+      if (isHiding) {
+        hideElement(toggleCard);
+      } else {
+        showElement(toggleCard);
+      }
+    });
+  </script>
+
