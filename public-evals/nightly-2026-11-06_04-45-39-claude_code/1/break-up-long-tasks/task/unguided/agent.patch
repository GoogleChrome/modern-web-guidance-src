+        { name: 'Espresso',     extraction: 0.22, bodyMod: 2.0,  clarity: 0.8 },
+        { name: 'French Press', extraction: 0.19, bodyMod: 1.5,  clarity: 0.9 },
+        { name: 'Cold Brew',    extraction: 0.17, bodyMod: 0.5,  clarity: 1.0 },
+        { name: 'AeroPress',    extraction: 0.21, bodyMod: 0.3,  clarity: 1.1 }
