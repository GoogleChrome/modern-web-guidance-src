+          brew: BREWS[Math.floor(rand() * BREWS.length)],
+          grind: 0.3 + rand() * 0.7,       // 0.3 fine-ish .. 1.0 coarse
+          temp: 85 + rand() * 11,          // °C
+          brewMinutes: 1 + rand() * 6
+        };
+      }
+
+      // Simulate extraction over time steps and derive a flavor profile.
+      function evaluateBlend(blend) {
+        const p = { acidity: 0, body: 0, sweetness: 0, bitterness: 0, aroma: 0 };
+        for (const { origin, weight } of blend.components) {
+          for (const f of FLAVORS) p[f] += origin[f] * weight;
+        }
+
+        const r = blend.roast.level;
+        p.acidity    *= 1.15 - r * 0.6;
+        p.bitterness += r * 3.2;
+        p.body       += r * 1.4;
+        p.sweetness  += Math.sin(r * Math.PI) * 1.5; // caramelisation peaks mid-roast
+        p.aroma      *= 1.05 - Math.abs(r - 0.45) * 0.4;
+
+        // Iterative extraction model: soluble compounds dissolve at different
+        // rates; acids early, sugars mid, bitter compounds late.
+        const steps = 40;
+        const dt = blend.brewMinutes / steps;
+        const tempFactor = (blend.temp - 80) / 16;
+        const rate = blend.brew.extraction * tempFactor * (1.4 - blend.grind);
+        let acids = 0, sugars = 0, bitters = 0;
+        for (let i = 0; i < steps; i++) {
+          acids   += (1 - acids)   * rate * 2.2 * dt;
+          sugars  += (1 - sugars)  * rate * 1.3 * dt;
+          bitters += (1 - bitters) * rate * 0.6 * dt;
+        }
+        const extractionYield = (acids + sugars + bitters) / 3;
+
+        p.acidity    *= 0.6 + acids * 0.6;
+        p.sweetness  *= 0.6 + sugars * 0.7;
+        p.bitterness *= 0.5 + bitters * 1.2;
+        p.body       += blend.brew.bodyMod;
+        p.aroma      *= blend.brew.clarity;
+
+        // Over/under extraction penalties.
+        if (extractionYield > 0.75) { p.bitterness += (extractionYield - 0.75) * 8; p.sweetness -= 1; }
