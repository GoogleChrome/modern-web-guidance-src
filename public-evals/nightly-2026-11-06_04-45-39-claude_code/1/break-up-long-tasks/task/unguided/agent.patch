+      // ---- Simulation --------------------------------------------------------
+
+      function createBlend(rand) {
+        const componentCount = 1 + Math.floor(rand() * 3); // 1-3 origins
+        const components = [];
+        const used = new Set();
+        let total = 0;
+        while (components.length < componentCount) {
+          const idx = Math.floor(rand() * ORIGINS.length);
+          if (used.has(idx)) continue;
+          used.add(idx);
+          const weight = 0.2 + rand();
+          components.push({ origin: ORIGINS[idx], weight });
+          total += weight;
+        }
+        for (const c of components) c.weight /= total;
+        return {
