index 0000000..bc45a79
--- /dev/null
+++ b/reviews.js
@@ -0,0 +1,354 @@
+/*
+ * Seasonal Favorites – customer reviews
+ *
+ * Reviews may contain a small subset of rich HTML (bold, italics, lists,
+ * links, quotes...). Review markup is untrusted, so it is never assigned to
+ * innerHTML. Instead it is:
+ *
+ *   1. Parsed with DOMParser into an inert document. That document has no
+ *      browsing context, so scripts don't run, event handlers don't fire and
+ *      resources (images, iframes...) aren't fetched while parsing.
+ *   2. Walked node by node and rebuilt from scratch in the live document using
+ *      createElement / createTextNode. Only allowlisted elements and
+ *      allowlisted attributes (with validated values) are copied over; anything
+ *      else is dropped. Because the output is built from fresh DOM nodes rather
+ *      than re-serialised and re-parsed, mutation-XSS tricks don't apply.
+ *
+ * Raw review markup is stored as-is and sanitized every time it is rendered
+ * (sanitize on output), so tightening the allowlist later protects old data.
+ */
+(function () {
+  'use strict';
+
+  var STORAGE_KEY = 'dailyGrind.reviews.v1';
+  var MAX_REVIEW_LENGTH = 2000;
+  var MAX_NAME_LENGTH = 40;
+  var MAX_DEPTH = 16;
+
+  var DRINKS = {
+    'maple-oat-latte': 'Maple Oat Latte',
+    'dark-roast-espresso': 'Dark Roast Espresso',
+    'cold-brew': 'Cold Brew'
+  };
+
+  // Elements that are kept (tag name -> allowed attributes).
+  var ALLOWED_ELEMENTS = {
+    B: [], STRONG: [], I: [], EM: [], U: [], S: [], MARK: [], SMALL: [],
+    SUB: [], SUP: [], P: [], BR: [], UL: [], OL: [], LI: [],
+    BLOCKQUOTE: [], CODE: [], PRE: [], SPAN: [],
+    A: ['href', 'title']
+  };
+
+  // Elements removed together with everything inside them. Any other
+  // non-allowlisted element is "unwrapped": the tag is dropped but its
+  // (sanitized) children are kept, so e.g. <div>hi</div> becomes "hi".
+  var DROP_WITH_CONTENT = {
+    SCRIPT: 1, STYLE: 1, TEMPLATE: 1, IFRAME: 1, FRAME: 1, FRAMESET: 1,
+    OBJECT: 1, EMBED: 1, APPLET: 1, NOSCRIPT: 1, NOEMBED: 1, NOFRAMES: 1,
+    SVG: 1, MATH: 1, LINK: 1, META: 1, BASE: 1, TITLE: 1, HEAD: 1,
+    FORM: 1, INPUT: 1, BUTTON: 1, SELECT: 1, OPTION: 1, TEXTAREA: 1,
+    IMG: 1, VIDEO: 1, AUDIO: 1, SOURCE: 1, TRACK: 1, PICTURE: 1,
+    CANVAS: 1, PORTAL: 1, DIALOG: 1, XMP: 1, PLAINTEXT: 1, LISTING: 1
+  };
+
+  var SAFE_URL_PROTOCOLS = { 'http:': 1, 'https:': 1, 'mailto:': 1 };
+
+  function safeUrl(value) {
+    var trimmed = String(value).trim();
+    if (!trimmed) return null;
+    var url;
+    try {
+      url = new URL(trimmed, window.location.href);
+    } catch (e) {
+      return null;
+    }
+    return SAFE_URL_PROTOCOLS[url.protocol] ? url.href : null;
+  }
+
+  function copyChildren(source, target, depth) {
+    var child = source.firstChild;
+    while (child) {
+      var clean = sanitizeNode(child, depth);
+      if (clean) target.appendChild(clean);
+      child = child.nextSibling;
+    }
+  }
+
+  function sanitizeNode(node, depth) {
+    if (node.nodeType === Node.TEXT_NODE) {
+      return document.createTextNode(node.nodeValue);
+    }
+    if (node.nodeType !== Node.ELEMENT_NODE) {
+      return null; // comments, processing instructions, etc.
+    }
+    // Only HTML-namespace elements; drops foreign (SVG/MathML) content.
+    if (node.namespaceURI !== 'http://www.w3.org/1999/xhtml') return null;
+
+    var tag = node.tagName.toUpperCase();
+    if (DROP_WITH_CONTENT[tag]) return null;
+    if (depth > MAX_DEPTH) {
+      return document.createTextNode(node.textContent || '');
+    }
+
+    var allowedAttrs = ALLOWED_ELEMENTS[tag];
+    if (!allowedAttrs) {
+      // Unwrap unknown element: keep sanitized children only.
+      var frag = document.createDocumentFragment();
+      copyChildren(node, frag, depth + 1);
+      return frag;
+    }
+
+    var el = document.createElement(tag.toLowerCase());
+    for (var i = 0; i < allowedAttrs.length; i++) {
+      var name = allowedAttrs[i];
+      if (!node.hasAttribute(name)) continue;
+      var value = node.getAttribute(name);
+      if (name === 'href') {
+        value = safeUrl(value);
+        if (!value) continue;
+      }
+      el.setAttribute(name, value);
+    }
+    if (tag === 'A') {
+      if (!el.hasAttribute('href')) {
+        // Link with an unsafe/missing href: keep text, drop the link.
+        var textOnly = document.createDocumentFragment();
+        copyChildren(node, textOnly, depth + 1);
+        return textOnly;
+      }
+      el.setAttribute('target', '_blank');
+      el.setAttribute('rel', 'noopener noreferrer nofollow ugc');
+    }
+    copyChildren(node, el, depth + 1);
+    return el;
+  }
+
+  /**
+   * Parse untrusted HTML in an inert document and return a DocumentFragment
+   * (owned by the live document) containing only allowlisted content.
+   */
+  function sanitizeHTML(dirty) {
+    var fragment = document.createDocumentFragment();
+    if (typeof dirty !== 'string' || !dirty) return fragment;
+    var inert = new DOMParser().parseFromString(
+      '<!DOCTYPE html><html><body>' + dirty, 'text/html');
+    copyChildren(inert.body, fragment, 0);
+    return fragment;
+  }
+
+  // ---------------------------------------------------------------------
+  // Storage
+  // ---------------------------------------------------------------------
+
+  var SEED_REVIEWS = [
+    {
+      drink: 'maple-oat-latte', name: 'Priya', rating: 5, date: '2026-10-28',
+      html: '<p>The <strong>perfect</strong> autumn drink. Not too sweet, and the oat milk is <em>so</em> creamy.</p>'
+    },
+    {
+      drink: 'dark-roast-espresso', name: 'Marcus', rating: 4, date: '2026-10-30',
+      html: '<p>Bold and smoky, exactly as advertised.</p><ul><li>Great crema</li><li>A little bitter for me without sugar</li></ul>'
+    },
+    {
+      drink: 'cold-brew', name: 'Jo', rating: 5, date: '2026-11-02',
+      html: '<blockquote>Smoothest cold brew in town.</blockquote><p>I get one every morning on my commute.</p>'
+    }
+  ];
+
+  function isValidReview(r) {
+    return r && typeof r === 'object' &&
+      Object.prototype.hasOwnProperty.call(DRINKS, r.drink) &&
+      typeof r.name === 'string' && typeof r.html === 'string' &&
+      typeof r.date === 'string' &&
+      Number.isInteger(r.rating) && r.rating >= 1 && r.rating <= 5;
+  }
+
+  function loadReviews() {
+    try {
+      var raw = window.localStorage.getItem(STORAGE_KEY);
+      if (raw === null) return SEED_REVIEWS.slice();
+      var parsed = JSON.parse(raw);
+      return Array.isArray(parsed) ? parsed.filter(isValidReview) : [];
+    } catch (e) {
+      return SEED_REVIEWS.slice();
+    }
+  }
+
+  function saveReviews(reviews) {
+    try {
+      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
+    } catch (e) {
+      // Storage unavailable (private mode, quota) – keep in memory only.
+    }
+  }
+
+  // ---------------------------------------------------------------------
+  // Rendering
+  // ---------------------------------------------------------------------
+
+  var reviews = loadReviews();
+  var activeFilter = 'all';
+
+  function stars(rating) {
+    return '★★★★★'.slice(0, rating) +
+      '☆☆☆☆☆'.slice(0, 5 - rating);
+  }
+
+  function renderReview(review) {
+    var article = document.createElement('article');
+    article.className = 'review';
+
+    var header = document.createElement('header');
+    header.className = 'review-header';
+
+    var who = document.createElement('strong');
+    who.textContent = review.name || 'Anonymous';
+
+    var drink = document.createElement('span');
+    drink.className = 'review-drink';
+    drink.textContent = DRINKS[review.drink];
+
+    var rating = document.createElement('span');
+    rating.className = 'review-stars';
+    rating.textContent = stars(review.rating);
+    rating.setAttribute('aria-label', review.rating + ' out of 5 stars');
+
+    var time = document.createElement('time');
+    time.className = 'review-date';
+    time.dateTime = review.date;
+    time.textContent = review.date;
+
+    header.append(who, drink, rating, time);
+
+    var body = document.createElement('div');
+    body.className = 'review-body';
+    body.appendChild(sanitizeHTML(review.html));
+
+    article.append(header, body);
+    return article;
+  }
+
+  function renderSummaries() {
+    Object.keys(DRINKS).forEach(function (id) {
+      var el = document.querySelector('[data-review-summary="' + id + '"]');
+      if (!el) return;
+      var mine = reviews.filter(function (r) { return r.drink === id; });
+      if (!mine.length) {
+        el.textContent = 'No reviews yet';
+        return;
+      }
+      var avg = mine.reduce(function (s, r) { return s + r.rating; }, 0) / mine.length;
+      el.textContent = stars(Math.round(avg)) + ' ' + avg.toFixed(1) +
+        ' (' + mine.length + ' review' + (mine.length === 1 ? '' : 's') + ')';
+    });
+  }
+
+  function renderList() {
+    var list = document.getElementById('review-list');
+    var visible = reviews
+      .filter(function (r) { return activeFilter === 'all' || r.drink === activeFilter; })
+      .slice()
+      .reverse();
+
+    list.replaceChildren();
+    if (!visible.length) {
+      var empty = document.createElement('p');
+      empty.className = 'review-empty';
+      empty.textContent = 'No reviews yet. Be the first to share your thoughts!';
+      list.appendChild(empty);
+      return;
+    }
+    visible.forEach(function (r) { list.appendChild(renderReview(r)); });
+  }
+
+  function render() {
+    renderSummaries();
+    renderList();
+  }
+
+  // ---------------------------------------------------------------------
+  // Wiring
+  // ---------------------------------------------------------------------
+
+  function init() {
+    var form = document.getElementById('review-form');
+    var textarea = document.getElementById('review-html');
+    var preview = document.getElementById('review-preview');
+    var counter = document.getElementById('review-count');
+    var status = document.getElementById('review-status');
+    var drinkSelect = document.getElementById('review-drink');
+
+    textarea.maxLength = MAX_REVIEW_LENGTH;
+    document.getElementById('review-name').maxLength = MAX_NAME_LENGTH;
+
+    function updatePreview() {
+      preview.replaceChildren(sanitizeHTML(textarea.value));
+      counter.textContent = textarea.value.length + ' / ' + MAX_REVIEW_LENGTH;
+    }
+    textarea.addEventListener('input', updatePreview);
+    updatePreview();
+
+    document.querySelectorAll('.review-filter').forEach(function (btn) {
+      btn.addEventListener('click', function () {
+        activeFilter = btn.getAttribute('data-filter');
+        document.querySelectorAll('.review-filter').forEach(function (b) {
+          b.setAttribute('aria-pressed', String(b === btn));
+        });
+        renderList();
+      });
+    });
+
+    document.querySelectorAll('[data-review-drink]').forEach(function (btn) {
+      btn.addEventListener('click', function () {
+        drinkSelect.value = btn.getAttribute('data-review-drink');
+        document.getElementById('reviews').scrollIntoView({ behavior: 'smooth' });
+        textarea.focus({ preventScroll: true });
+      });
+    });
+
+    form.addEventListener('submit', function (event) {
+      event.preventDefault();
+      var drink = drinkSelect.value;
+      var name = document.getElementById('review-name').value.trim().slice(0, MAX_NAME_LENGTH);
+      var ratingInput = form.querySelector('input[name="rating"]:checked');
+      var rating = ratingInput ? parseInt(ratingInput.value, 10) : 0;
+      var html = textarea.value.slice(0, MAX_REVIEW_LENGTH);
+
+      // Require some visible text after sanitization.
+      var hasContent = (sanitizeHTML(html).textContent || '').trim().length > 0;
+
+      var review = {
+        drink: drink,
+        name: name || 'Anonymous',
+        rating: rating,
+        html: html,
+        date: new Date().toISOString().slice(0, 10)
+      };
+
+      if (!isValidReview(review) || !hasContent) {
+        status.textContent = 'Please choose a drink, a rating, and write a review.';
+        status.className = 'review-status error';
+        return;
+      }
+
+      reviews.push(review);
+      saveReviews(reviews);
