+  <script type="module">
+    // Allowlist for customer review markup. Elements not listed are removed
+    // together with their content; the browser's safe defaults additionally
+    // strip scripts, event handlers and javascript: URLs regardless of config.
+    const REVIEW_ELEMENTS = ['p', 'br', 'b', 'strong', 'i', 'em', 'u', 's', 'ul', 'ol', 'li', 'blockquote', 'a'];
+    const REVIEW_ATTRIBUTES = ['href'];
+
+    let domPurifyPromise;
+    function loadDOMPurify() {
+      // Only downloaded in browsers without the native Sanitizer API.
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.2.7/dist/purify.es.mjs')
+        .then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        el.setHTML(html, { sanitizer: { elements: REVIEW_ELEMENTS, attributes: REVIEW_ATTRIBUTES } });
+        return;
+      }
+      try {
+        const DOMPurify = await loadDOMPurify();
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...REVIEW_ELEMENTS, '#text'],
+          ALLOWED_ATTR: REVIEW_ATTRIBUTES,
+          // Match native Sanitizer behaviour.
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      } catch {
+        // Sanitizer unavailable: never fall back to raw HTML, show plain text.
+        el.textContent = html;
+      }
+    }
+
+    const STORAGE_KEY = 'daily-grind-reviews';
+    const DRINKS = {
+      'maple-oat-latte': 'Maple Oat Latte',
+      'dark-roast-espresso': 'Dark Roast Espresso',
+      'cold-brew': 'Cold Brew'
+    };
+    const SEED_REVIEWS = [
+      { drink: 'maple-oat-latte', name: 'Priya', date: '2026-10-28', body: '<p>Tastes like <strong>autumn in a cup</strong>. The maple is subtle, not syrupy.</p>' },
+      { drink: 'dark-roast-espresso', name: 'Marcus', date: '2026-10-30', body: '<p>Rich and smokey.</p><ul><li>Great crema</li><li><em>Zero</em> bitterness</li></ul>' },
+      { drink: 'cold-brew', name: 'Jo', date: '2026-11-02', body: '<blockquote>Smoothest cold brew in town.</blockquote><p>Worth the 18 hours!</p>' }
+    ];
+
+    function loadReviews() {
+      try {
+        const stored = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        return Array.isArray(stored) ? stored : SEED_REVIEWS;
+      } catch {
+        return SEED_REVIEWS;
+      }
+    }
+
+    function saveReviews(reviews) {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
+      } catch {
+        // Storage may be unavailable (private mode); reviews remain in memory.
+      }
+    }
+
+    let reviews = loadReviews();
+    const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+    async function renderReviewItem(review) {
+      const li = document.createElement('li');
+      li.className = 'review';
+
+      // User-supplied plain-text fields go through textContent, never HTML.
+      const meta = document.createElement('div');
+      meta.className = 'review-meta';
+      const time = document.createElement('time');
+      time.dateTime = review.date;
+      time.textContent = dateFormat.format(new Date(`${review.date}T00:00:00`));
+      meta.append(String(review.name), ' · ', time);
+
+      const body = document.createElement('div');
+      body.className = 'review-body';
+      await safeSetHTML(body, String(review.body));
+
+      li.append(meta, body);
+      return li;
+    }
+
+    async function renderReviews() {
+      for (const list of document.querySelectorAll('[data-reviews-for]')) {
+        const drinkReviews = reviews.filter((r) => r.drink === list.dataset.reviewsFor);
+        if (drinkReviews.length === 0) {
+          const empty = document.createElement('li');
+          empty.className = 'review-empty';
+          empty.textContent = 'No reviews yet. Be the first!';
+          list.replaceChildren(empty);
+          continue;
+        }
+        const items = await Promise.all(drinkReviews.slice().reverse().map(renderReviewItem));
+        list.replaceChildren(...items);
+      }
+    }
+
+    const form = document.getElementById('review-form');
+    const status = document.getElementById('review-status');
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const data = new FormData(form);
+      const drink = data.get('drink');
+      if (!Object.hasOwn(DRINKS, drink)) return;
+
+      reviews.push({
+        drink,
+        name: data.get('name').trim(),
+        body: data.get('body'),
+        date: new Date().toISOString().slice(0, 10)
+      });
+      saveReviews(reviews);
+      await renderReviews();
+
+      form.reset();
+      status.textContent = `Thanks! Your review of ${DRINKS[drink]} has been posted.`;
+    });
+
+    renderReviews();
+  </script>
+
 </body>
 
