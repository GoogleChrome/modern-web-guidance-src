+  <script type="module">
+    // ---- Scheduler support -------------------------------------------------
+    // scheduler.postTask is not supported everywhere (e.g. Safari), so load the
+    // polyfill on demand to keep true priority ordering.
+    const hasPostTask = () => 'scheduler' in globalThis && 'postTask' in globalThis.scheduler;
+
+    async function ensureScheduler() {
+      if (hasPostTask()) return 'native';
+      try {
+        await new Promise((resolve, reject) => {
+          const script = document.createElement('script');
+          script.src = 'https://unpkg.com/scheduler-polyfill';
+          script.onload = resolve;
+          script.onerror = reject;
+          document.head.append(script);
+        });
+        if (hasPostTask()) return 'polyfill';
+      } catch { /* fall through to the minimal fallback */ }
+      installMinimalScheduler();
+      return 'fallback';
+    }
+
+    // Last-resort priority queue if the polyfill cannot be fetched (offline).
+    function installMinimalScheduler() {
+      const rank = { 'user-blocking': 0, 'user-visible': 1, background: 2 };
+      const queue = [];
+      let scheduled = false;
+      const pump = () => {
+        scheduled = false;
+        queue.sort((a, b) => rank[a.priority] - rank[b.priority] || a.seq - b.seq);
+        const job = queue.shift();
+        if (job) job.run();
+        if (queue.length) schedule();
+      };
+      const schedule = () => { if (!scheduled) { scheduled = true; setTimeout(pump, 0); } };
+      let seq = 0;
+      globalThis.scheduler = {
+        postTask(cb, { priority = 'user-visible', signal } = {}) {
+          return new Promise((resolve, reject) => {
+            if (signal?.aborted) return reject(signal.reason);
+            const job = {
+              priority, seq: seq++,
+              run: () => {
+                if (signal?.aborted) return reject(signal.reason);
+                try { resolve(cb()); } catch (e) { reject(e); }
+              },
+            };
+            signal?.addEventListener('abort', () => {
+              const i = queue.indexOf(job);
+              if (i !== -1) { queue.splice(i, 1); reject(signal.reason); }
+            }, { once: true });
+            queue.push(job);
+            schedule();
+          });
+        },
+      };
+    }
+
+    // Yield to the main thread; scheduler.yield() continuations keep the
+    // priority of the postTask that started them.
+    function yieldToMain() {
+      if ('scheduler' in globalThis && 'yield' in globalThis.scheduler) {
+        return scheduler.yield();
+      }
+      return new Promise((resolve) => setTimeout(resolve, 0));
+    }
+
+    // ---- Task definitions --------------------------------------------------
+    const TASKS = {
+      checkout: { label: 'Urgent checkout', priority: 'user-blocking', units: 120 },
+      menu: { label: 'Menu update', priority: 'user-visible', units: 200 },
+      telemetry: { label: 'Telemetry log', priority: 'background', units: 260 },
+    };
+    const PRIORITY_LABEL = {
+      'user-blocking': 'urgent', 'user-visible': 'standard', background: 'background',
+    };
+
+    const $ = (id) => document.getElementById(id);
+    const activeList = $('ops-active');
+    const logList = $('ops-log');
+    const pendingOut = $('ops-pending');
+    const completedOut = $('ops-completed');
+
+    let controller = new AbortController();
+    let nextId = 1;
+    let pending = 0;
+    let completed = 0;
+    const schedulerReady = ensureScheduler().then((mode) => {
+      $('ops-mode').value = { native: 'native postTask', polyfill: 'polyfill', fallback: 'setTimeout fallback' }[mode];
+    });
+
+    // Simulated CPU work: ~1 ms of busy computation per unit.
+    function burn(ms) {
+      const end = performance.now() + ms;
+      let x = 0;
+      while (performance.now() < end) x += Math.sqrt(Math.random());
+      return x;
+    }
+
+    function setEmptyState(list, text) {
+      const hasItems = [...list.children].some((li) => !li.classList.contains('ops-empty'));
+      const placeholder = list.querySelector('.ops-empty');
+      if (!hasItems && !placeholder) {
+        const li = document.createElement('li');
+        li.className = 'ops-empty';
+        li.textContent = text;
+        list.append(li);
+      } else if (hasItems && placeholder) {
+        placeholder.remove();
+      }
+    }
+
+    function updateCounters() {
+      pendingOut.value = pending;
+      completedOut.value = completed;
+      setEmptyState(activeList, 'No tasks queued.');
+      setEmptyState(logList, 'Nothing has run yet.');
+    }
+
+    async function enqueue(kind) {
+      await schedulerReady;
+      const def = TASKS[kind];
+      const id = nextId++;
+      const { signal } = controller;
+
+      const item = document.createElement('li');
+      item.dataset.priority = def.priority;
+      const text = document.createElement('span');
+      text.textContent = `#${id} ${def.label} (${PRIORITY_LABEL[def.priority]}) — queued`;
+      const bar = document.createElement('progress');
+      bar.max = def.units;
+      bar.value = 0;
+      bar.setAttribute('aria-label', `Task ${id} progress`);
+      item.append(text, bar);
+      activeList.append(item);
+      pending++;
+      updateCounters();
+
+      const queuedAt = performance.now();
+      try {
+        await scheduler.postTask(async () => {
+          const startedAt = performance.now();
+          text.textContent = `#${id} ${def.label} (${PRIORITY_LABEL[def.priority]}) — running`;
+          let deadline = performance.now() + 50;
+          for (let i = 0; i < def.units; i++) {
+            if (signal.aborted) throw signal.reason;
+            burn(1);
+            if (performance.now() >= deadline) {
+              bar.value = i + 1;
+              await yieldToMain();
+              deadline = performance.now() + 50;
+            }
+          }
+          bar.value = def.units;
+          const finishedAt = performance.now();
+          completed++;
+          const entry = document.createElement('li');
+          entry.dataset.priority = def.priority;
+          entry.className = 'done';
+          entry.textContent = `#${id} ${def.label} — waited ${Math.round(startedAt - queuedAt)} ms, ran ${Math.round(finishedAt - startedAt)} ms`;
+          logList.append(entry);
+          entry.scrollIntoView({ block: 'nearest' });
+        }, { priority: def.priority, signal });
+        item.remove();
+      } catch (err) {
+        if (signal.aborted) {
+          item.classList.add('aborted');
+          text.textContent = `#${id} ${def.label} — cancelled`;
+          setTimeout(() => { item.remove(); updateCounters(); }, 1200);
+        } else {
+          throw err;
+        }
+      } finally {
+        pending--;
+        updateCounters();
+      }
+    }
+
+    // ---- Controls ------------------------------------------------------------
+    document.querySelectorAll('.ops-controls [data-kind]').forEach((btn) => {
+      btn.addEventListener('click', () => enqueue(btn.dataset.kind));
+    });
+
+    // Deliberately enqueue in "wrong" order: the scheduler runs them by priority.
+    $('ops-batch').addEventListener('click', () => {
+      ['telemetry', 'menu', 'telemetry', 'checkout', 'menu', 'telemetry', 'checkout', 'menu']
+        .forEach((kind) => enqueue(kind));
+    });
+
+    $('ops-cancel').addEventListener('click', () => {
+      controller.abort(new DOMException('Cancelled by user', 'AbortError'));
+      controller = new AbortController();
+    });
+
+    $('ops-clear').addEventListener('click', () => {
+      logList.replaceChildren();
+      completed = 0;
+      updateCounters();
+    });
+
+    // ---- Responsiveness meter -----------------------------------------------
+    // rAF runs on the main thread, so long frames reveal blocking work.
+    const frameOut = $('ops-frame');
+    const heartbeat = $('ops-heartbeat');
+    let last = performance.now();
+    let lastPaint = 0;
+    function tick(now) {
+      const delta = now - last;
+      last = now;
+      if (now - lastPaint > 150) {
+        frameOut.value = Math.round(delta);
+        heartbeat.classList.toggle('lagging', delta > 60);
+        lastPaint = now;
+      }
+      requestAnimationFrame(tick);
+    }
+    requestAnimationFrame(tick);
+  </script>
+
 </body>
 
