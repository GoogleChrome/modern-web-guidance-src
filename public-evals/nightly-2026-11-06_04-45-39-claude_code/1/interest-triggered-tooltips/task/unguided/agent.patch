+  <script>
+    // Keep each tooltip next to its button, flipping sides if it would overflow the viewport.
+    (function () {
+      var GAP = 12, MARGIN = 8;
+
+      function place(wrap) {
+        var tip = wrap.querySelector('.tooltip');
+        wrap.classList.remove('tooltip--left', 'tooltip--top', 'tooltip-dismissed');
+        var btn = wrap.getBoundingClientRect();
+        var width = tip.offsetWidth;
+        var vw = document.documentElement.clientWidth;
+
+        if (btn.right + GAP + width + MARGIN <= vw) return;           // fits on the right
+        if (btn.left - GAP - width - MARGIN >= 0) {                   // fits on the left
+          wrap.classList.add('tooltip--left');
+        } else {                                                      // fall back to above
+          wrap.classList.add('tooltip--top');
+        }
+      }
+
+      document.querySelectorAll('.tooltip-wrap').forEach(function (wrap) {
+        wrap.addEventListener('mouseenter', function () { place(wrap); });
+        wrap.addEventListener('focusin', function () { place(wrap); });
+      });
+
+      // Escape dismisses an open tooltip (WCAG 1.4.13).
+      document.addEventListener('keydown', function (e) {
+        if (e.key !== 'Escape') return;
+        document.querySelectorAll('.tooltip-wrap:hover, .tooltip-wrap:focus-within')
+          .forEach(function (wrap) { wrap.classList.add('tooltip-dismissed'); });
+      });
+    })();
+  </script>
+
