+  <script>
+    (() => {
+      'use strict';
+
+      const promo = document.getElementById('passkey-promo');
+      const button = document.getElementById('register-button');
+      const statusEl = document.getElementById('passkey-status');
+
+      // ---- base64url helpers (fallback for browsers without JSON helpers) ----
+      const b64urlToBuffer = (value) => {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+        const binary = atob(padded);
+        const bytes = new Uint8Array(binary.length);
+        for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+        return bytes.buffer;
+      };
+
+      const bufferToB64url = (buffer) => {
+        const bytes = new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      };
+
+      const parseCreationOptions = (json) => {
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+        }
+        return {
+          ...json,
+          challenge: b64urlToBuffer(json.challenge),
+          user: { ...json.user, id: b64urlToBuffer(json.user.id) },
+          excludeCredentials: (json.excludeCredentials || []).map((cred) => ({
+            ...cred,
+            id: b64urlToBuffer(cred.id),
+          })),
+        };
+      };
+
+      const credentialToJSON = (credential) => {
+        if (typeof credential.toJSON === 'function') {
+          try {
+            return credential.toJSON();
+          } catch (_) {
+            // Some password managers' credential objects throw here; fall through.
+          }
+        }
+        const response = credential.response;
+        const json = {
+          id: credential.id,
+          rawId: bufferToB64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment ?? undefined,
+          clientExtensionResults: credential.getClientExtensionResults(),
+          response: {
+            clientDataJSON: bufferToB64url(response.clientDataJSON),
+            attestationObject: bufferToB64url(response.attestationObject),
+            transports: typeof response.getTransports === 'function' ? response.getTransports() : [],
+          },
+        };
+        if (typeof response.getPublicKey === 'function') {
+          const pk = response.getPublicKey();
+          if (pk) json.response.publicKey = bufferToB64url(pk);
+        }
+        if (typeof response.getPublicKeyAlgorithm === 'function') {
+          json.response.publicKeyAlgorithm = response.getPublicKeyAlgorithm();
+        }
+        if (typeof response.getAuthenticatorData === 'function') {
+          json.response.authenticatorData = bufferToB64url(response.getAuthenticatorData());
+        }
+        return json;
+      };
+
+      const setStatus = (message, type = '') => {
+        statusEl.textContent = message; // textContent only: never inject HTML
+        statusEl.className = 'passkey-status' + (type ? ' ' + type : '');
+      };
+
+      const postJSON = async (url, body) => {
+        const res = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(body),
+        });
+        let data = null;
+        try {
+          data = await res.json();
+        } catch (_) {
+          // Non-JSON response
+        }
+        if (!res.ok) {
+          const err = new Error((data && (data.error || data.message)) || `Request failed (${res.status})`);
+          err.status = res.status;
+          throw err;
+        }
+        return data;
+      };
+
+      // ---- Feature detection: only show the promotion when passkeys are usable ----
+      const isWebAuthnSupported = () =>
+        window.isSecureContext &&
+        typeof window.PublicKeyCredential === 'function' &&
+        navigator.credentials &&
+        typeof navigator.credentials.create === 'function';
+
+      const init = () => {
+        // Hide the promotion entirely when WebAuthn is unavailable (e.g. insecure context).
+        // We intentionally don't gate on platform-authenticator availability: roaming keys
+        // and cross-device (hybrid) flows can still create a passkey.
+        if (!isWebAuthnSupported()) return;
+        promo.hidden = false;
+        button.addEventListener('click', register);
+      };
+
+      let inFlight = false;
+
+      const register = async () => {
+        if (inFlight) return; // prevent duplicate ceremonies
+        inFlight = true;
+        button.disabled = true;
+        setStatus('Preparing your passkey…');
+
+        try {
+          // 1. Get creation options from the server (server generates the challenge).
+          const optionsJSON = await postJSON('/api/register/options', { promotion: true });
+          if (!optionsJSON || typeof optionsJSON.challenge !== 'string' || !optionsJSON.user) {
+            throw new Error('Invalid registration options received from server.');
+          }
+          const publicKey = parseCreationOptions(optionsJSON);
+
+          // 2. Create the passkey via the authenticator.
+          setStatus('Follow your browser\'s prompt to create a passkey…');
+          const credential = await navigator.credentials.create({ publicKey });
+          if (!credential) throw new Error('No credential was created.');
+
+          // 3. Send the attestation to the server for verification.
+          setStatus('Verifying…');
+          const result = await postJSON('/api/register/verify', credentialToJSON(credential));
+          if (result && (result.verified === false || result.success === false)) {
+            throw new Error((result && (result.error || result.message)) || 'Passkey verification failed.');
+          }
+
+          setStatus('Your passkey has been created. Next time, sign in with just a tap.', 'success');
+          button.textContent = 'Passkey created';
+          button.disabled = true;
+          return;
+        } catch (err) {
+          const name = err && err.name;
+          if (name === 'InvalidStateError') {
+            setStatus('A passkey for this account already exists on this device.', 'error');
+          } else if (name === 'NotAllowedError' || name === 'AbortError') {
+            setStatus('Passkey creation was cancelled.', '');
+          } else if (name === 'SecurityError') {
+            setStatus('Passkeys can\'t be created on this site right now.', 'error');
+          } else {
+            setStatus((err && err.message) || 'Something went wrong. Please try again.', 'error');
+          }
+          console.error('Passkey registration failed:', err);
+          button.disabled = false;
+        } finally {
+          inFlight = false;
+        }
+      };
+
+      init();
+    })();
+  </script>
+
 </body>
 
