+
+  <script>
+    (function () {
+      const panel = document.getElementById('quickOrder');
+      const handle = document.getElementById('qoHandle');
+      const toggle = document.getElementById('qoToggle');
+      const body = document.getElementById('qoBody');
+      const POS_KEY = 'dailyGrind.quickOrder.pos';
+      const CART_KEY = 'dailyGrind.quickOrder.cart';
+      const COLLAPSE_KEY = 'dailyGrind.quickOrder.collapsed';
+      const MARGIN = 8;
+
+      const store = {
+        get(key, fallback) {
+          try { const v = localStorage.getItem(key); return v ? JSON.parse(v) : fallback; }
+          catch (e) { return fallback; }
+        },
+        set(key, value) {
+          try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) { /* ignore */ }
+        }
+      };
+
+      /* ---------- Dragging ---------- */
+      function clamp(x, y) {
+        const maxX = Math.max(MARGIN, window.innerWidth - panel.offsetWidth - MARGIN);
+        const maxY = Math.max(MARGIN, window.innerHeight - panel.offsetHeight - MARGIN);
+        return {
+          x: Math.min(Math.max(MARGIN, x), maxX),
+          y: Math.min(Math.max(MARGIN, y), maxY)
+        };
+      }
+
+      function place(x, y, persist) {
+        const p = clamp(x, y);
+        panel.style.left = p.x + 'px';
+        panel.style.top = p.y + 'px';
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        if (persist) store.set(POS_KEY, p);
+        return p;
+      }
+
+      function currentPos() {
+        const r = panel.getBoundingClientRect();
+        return { x: r.left, y: r.top };
+      }
+
+      let drag = null;
+
+      handle.addEventListener('pointerdown', function (e) {
+        if (e.button !== 0 || e.target.closest('button')) return;
+        const start = currentPos();
+        drag = { id: e.pointerId, dx: e.clientX - start.x, dy: e.clientY - start.y };
+        handle.setPointerCapture(e.pointerId);
+        panel.classList.add('dragging');
+        e.preventDefault();
+      });
+
+      handle.addEventListener('pointermove', function (e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        place(e.clientX - drag.dx, e.clientY - drag.dy, false);
+      });
+
+      function endDrag(e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        drag = null;
+        panel.classList.remove('dragging');
+        if (handle.hasPointerCapture(e.pointerId)) handle.releasePointerCapture(e.pointerId);
+        const p = currentPos();
+        place(p.x, p.y, true);
+      }
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+
+      handle.addEventListener('keydown', function (e) {
+        if (e.target !== handle) return;
+        const step = e.shiftKey ? 50 : 10;
+        const moves = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
+        if (moves[e.key]) {
+          e.preventDefault();
+          const p = currentPos();
+          place(p.x + moves[e.key][0], p.y + moves[e.key][1], true);
+        } else if (e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
+          setCollapsed(!panel.classList.contains('collapsed'));
+        }
+      });
+
+      // Double-click the header to collapse/expand
+      handle.addEventListener('dblclick', function (e) {
+        if (e.target.closest('button')) return;
+        setCollapsed(!panel.classList.contains('collapsed'));
+      });
+
+      let resizeRaf = 0;
+      window.addEventListener('resize', function () {
+        cancelAnimationFrame(resizeRaf);
+        resizeRaf = requestAnimationFrame(function () {
+          if (panel.style.left) {
+            const p = currentPos();
+            place(p.x, p.y, false);
+          }
+        });
+      });
+
+      /* ---------- Collapse ---------- */
+      function setCollapsed(collapsed) {
+        panel.classList.toggle('collapsed', collapsed);
+        toggle.setAttribute('aria-expanded', String(!collapsed));
+        toggle.innerHTML = collapsed ? '+' : '&minus;';
+        toggle.title = collapsed ? 'Expand' : 'Minimize';
+        store.set(COLLAPSE_KEY, collapsed);
+        // Keep the panel on-screen after its height changes
+        if (panel.style.left) {
+          const p = currentPos();
+          place(p.x, p.y, true);
+        }
+      }
+      toggle.addEventListener('click', function () {
+        setCollapsed(!panel.classList.contains('collapsed'));
+      });
+
+      /* ---------- Order builder ---------- */
+      const form = document.getElementById('qoForm');
+      const drinkSel = document.getElementById('qoDrink');
+      const milkSel = document.getElementById('qoMilk');
+      const shot = document.getElementById('qoShot');
+      const qtyOut = document.getElementById('qoQty');
+      const minus = document.getElementById('qoMinus');
+      const plus = document.getElementById('qoPlus');
+      const addBtn = document.getElementById('qoAdd');
+      const list = document.getElementById('qoList');
+      const empty = document.getElementById('qoEmpty');
+      const totalEl = document.getElementById('qoTotal');
+      const badge = document.getElementById('qoBadge');
+      const checkout = document.getElementById('qoCheckout');
+      const MAX_QTY = 10;
+      let qty = 1;
+      let cart = store.get(CART_KEY, []);
+      if (!Array.isArray(cart)) cart = [];
+
+      const money = function (n) { return '$' + n.toFixed(2); };
+
+      function selection() {
+        const drinkOpt = drinkSel.selectedOptions[0];
+        const sizeInput = form.querySelector('input[name="qoSize"]:checked');
+        const milkOpt = milkSel.selectedOptions[0];
+        const unit = parseFloat(drinkOpt.dataset.price) +
+          parseFloat(sizeInput.dataset.extra) +
+          parseFloat(milkOpt.dataset.extra) +
+          (shot.checked ? 0.75 : 0);
+        return {
+          name: drinkOpt.textContent.split(' — ')[0],
+          size: sizeInput.value,
+          milk: milkOpt.value,
+          shot: shot.checked,
+          qty: qty,
+          unit: Math.round(unit * 100) / 100
+        };
+      }
+
+      function refreshAddButton() {
+        const s = selection();
+        qtyOut.textContent = qty;
+        minus.disabled = qty <= 1;
+        plus.disabled = qty >= MAX_QTY;
+        addBtn.textContent = 'Add to Cart — ' + money(s.unit * s.qty);
+      }
+
+      function renderCart() {
+        list.innerHTML = '';
+        let total = 0, count = 0;
+        cart.forEach(function (item, i) {
+          total += item.unit * item.qty;
+          count += item.qty;
+          const li = document.createElement('li');
+          const info = document.createElement('div');
+          info.className = 'qo-item-info';
+          const title = document.createElement('strong');
+          title.textContent = item.qty + '× ' + item.name;
+          const details = document.createElement('small');
+          details.textContent = [item.size, item.milk === 'None' ? 'no milk' : item.milk + ' milk', item.shot ? 'extra shot' : '']
+            .filter(Boolean).join(', ');
+          info.append(title, document.createElement('br'), details);
+          const price = document.createElement('span');
+          price.textContent = money(item.unit * item.qty);
+          const rm = document.createElement('button');
+          rm.type = 'button';
+          rm.className = 'qo-remove';
+          rm.innerHTML = '&times;';
+          rm.setAttribute('aria-label', 'Remove ' + item.name);
+          rm.addEventListener('click', function () {
+            cart.splice(i, 1);
+            saveCart();
+          });
+          li.append(info, price, rm);
+          list.appendChild(li);
+        });
+        empty.hidden = cart.length > 0;
+        totalEl.textContent = money(total);
+        badge.textContent = count;
+        checkout.setAttribute('aria-disabled', String(cart.length === 0));
+        if (cart.length === 0) checkout.setAttribute('tabindex', '-1');
+        else checkout.removeAttribute('tabindex');
+      }
+
+      function saveCart() {
+        store.set(CART_KEY, cart);
+        renderCart();
+        if (panel.style.left) { const p = currentPos(); place(p.x, p.y, true); }
+      }
+
+      minus.addEventListener('click', function () { if (qty > 1) { qty--; refreshAddButton(); } });
+      plus.addEventListener('click', function () { if (qty < MAX_QTY) { qty++; refreshAddButton(); } });
+      form.addEventListener('change', refreshAddButton);
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        const s = selection();
+        const existing = cart.find(function (c) {
+          return c.name === s.name && c.size === s.size && c.milk === s.milk && c.shot === s.shot;
+        });
+        if (existing) existing.qty = Math.min(99, existing.qty + s.qty);
+        else cart.push(s);
+        qty = 1;
+        refreshAddButton();
+        saveCart();
+        addBtn.textContent = 'Added! ✓';
+        setTimeout(refreshAddButton, 900);
+      });
+
+      /* ---------- Init ---------- */
+      if (store.get(COLLAPSE_KEY, false)) setCollapsed(true);
+      refreshAddButton();
+      renderCart();
+      const saved = store.get(POS_KEY, null);
+      if (saved && typeof saved.x === 'number' && typeof saved.y === 'number') place(saved.x, saved.y, false);
+    })();
+  </script>
+
 </body>
 
