+  <script>
+    (() => {
+      const panel = document.getElementById('quick-order');
+      const handle = document.getElementById('qo-handle');
+      const toggle = document.getElementById('qo-toggle');
+      const body = document.getElementById('qo-body');
+      const STORAGE_KEY = 'dailyGrind.quickOrder';
+      const KEY_STEP = 15;
+
+      /* ---------- Dragging ---------- */
+      panel.classList.add('is-draggable');
+      handle.tabIndex = 0;
+      handle.setAttribute('aria-label', 'Quick order panel. Use arrow keys to move it.');
+      handle.title = 'Drag to move · arrow keys also work';
+
+      let offsetX = 0, offsetY = 0, startX = 0, startY = 0, dragging = false;
+
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+        const x = Math.max(0, Math.min(left, maxLeft));
+        const y = Math.max(0, Math.min(top, maxTop));
+        panel.style.left = `${x}px`;
+        panel.style.top = `${y}px`;
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        return { x, y };
+      }
+
+      function savePos() {
+        const rect = panel.getBoundingClientRect();
+        saveState({ pos: { x: rect.left, y: rect.top } });
+      }
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0 || event.target.closest('button, input, select, textarea, a')) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        dragging = false;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        if (!dragging) {
+          if (Math.hypot(event.clientX - startX, event.clientY - startY) < 4) return;
+          dragging = true;
+          handle.classList.add('dragging');
+          panel.classList.add('is-dragging');
+        }
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        if (dragging) savePos();
+        dragging = false;
+        handle.classList.remove('dragging');
+        panel.classList.remove('is-dragging');
+      });
+
+      handle.addEventListener('keydown', (event) => {
+        if (event.target !== handle) return;
+        const deltas = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
+        const d = deltas[event.key];
+        if (!d) return;
+        event.preventDefault();
+        const step = event.shiftKey ? KEY_STEP * 4 : KEY_STEP;
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left + d[0] * step, rect.top + d[1] * step);
+        savePos();
+      });
+
+      // Keep the panel reachable when the viewport or panel size changes.
+      function reclamp() {
+        if (!panel.style.left) return; // still in default CSS position
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+      window.addEventListener('resize', reclamp);
+      new ResizeObserver(reclamp).observe(panel);
+
+      /* ---------- Collapse ---------- */
+      function setCollapsed(collapsed) {
+        body.hidden = collapsed;
+        toggle.setAttribute('aria-expanded', String(!collapsed));
+        toggle.setAttribute('aria-label', collapsed ? 'Expand quick order' : 'Minimize quick order');
+        toggle.textContent = collapsed ? '+' : '–';
+      }
+      toggle.addEventListener('click', () => {
+        setCollapsed(!body.hidden);
+        saveState({ collapsed: body.hidden });
+      });
+
+      /* ---------- Order builder ---------- */
+      const form = document.getElementById('qo-form');
+      const drink = document.getElementById('qo-drink');
+      const milk = document.getElementById('qo-milk');
+      const shot = document.getElementById('qo-shot');
+      const qtyOut = document.getElementById('qo-qty');
+      const qtyInput = document.getElementById('qo-qty-input');
+      const minus = document.getElementById('qo-minus');
+      const plus = document.getElementById('qo-plus');
+      const linePrice = document.getElementById('qo-line-price');
+      const itemsEl = document.getElementById('qo-items');
+      const emptyEl = document.getElementById('qo-empty');
+      const totalEl = document.getElementById('qo-total');
+      const badge = document.getElementById('qo-badge');
+      const checkout = document.getElementById('qo-checkout');
+      const status = document.getElementById('qo-status');
+      const fmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+      const MAX_QTY = 10;
+
+      let qty = 1;
+      let cart = [];
+
+      function currentSelection() {
+        const drinkOpt = drink.selectedOptions[0];
+        const sizeInput = form.querySelector('input[name="size"]:checked');
+        const milkOpt = milk.selectedOptions[0];
+        const unit = parseFloat(drinkOpt.dataset.price) + parseFloat(sizeInput.dataset.extra) +
+          parseFloat(milkOpt.dataset.extra) + (shot.checked ? parseFloat(shot.dataset.extra) : 0);
+        const name = drinkOpt.textContent.split(' — ')[0];
+        const details = [sizeInput.nextElementSibling.textContent, milkOpt.textContent.replace(/ \(.*\)$/, '')];
+        if (shot.checked) details.push('extra shot');
+        return { name, details: details.join(', '), unit, qty };
+      }
+
+      function updateLinePrice() {
+        const sel = currentSelection();
+        linePrice.textContent = fmt.format(sel.unit * sel.qty);
+        qtyOut.textContent = qty;
+        qtyInput.value = qty;
+        minus.disabled = qty <= 1;
+        plus.disabled = qty >= MAX_QTY;
+      }
+
+      function renderCart() {
+        itemsEl.replaceChildren(...cart.map((item, index) => {
+          const li = document.createElement('li');
+          const line = document.createElement('div');
+          line.className = 'qo-line';
+          line.textContent = `${item.qty} × ${item.name}`;
+          const small = document.createElement('small');
+          small.textContent = item.details;
+          line.append(small);
+          const price = document.createElement('span');
+          price.textContent = fmt.format(item.unit * item.qty);
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.className = 'qo-remove';
+          remove.textContent = '×';
+          remove.setAttribute('aria-label', `Remove ${item.name} from cart`);
+          remove.addEventListener('click', () => {
+            cart.splice(index, 1);
+            status.textContent = `${item.name} removed from cart.`;
+            renderCart();
+            saveState({ cart });
+            (itemsEl.querySelector('.qo-remove') || drink).focus();
+          });
+          li.append(line, price, remove);
+          return li;
+        }));
+        const count = cart.reduce((n, i) => n + i.qty, 0);
+        const total = cart.reduce((n, i) => n + i.unit * i.qty, 0);
+        emptyEl.hidden = cart.length > 0;
+        totalEl.textContent = fmt.format(total);
+        badge.textContent = count || '';
+        badge.dataset.count = count;
+        checkout.setAttribute('aria-disabled', String(cart.length === 0));
+      }
+
+      form.addEventListener('change', updateLinePrice);
+      minus.addEventListener('click', () => { qty = Math.max(1, qty - 1); updateLinePrice(); });
+      plus.addEventListener('click', () => { qty = Math.min(MAX_QTY, qty + 1); updateLinePrice(); });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const sel = currentSelection();
+        const existing = cart.find((i) => i.name === sel.name && i.details === sel.details);
+        if (existing) existing.qty = Math.min(99, existing.qty + sel.qty);
+        else cart.push(sel);
+        status.textContent = `Added ${sel.qty} ${sel.name} to cart.`;
+        qty = 1;
+        updateLinePrice();
+        renderCart();
+        saveState({ cart });
+      });
+
+      /* ---------- Persistence ---------- */
+      function loadState() {
+        try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch { return {}; }
+      }
+      function saveState(patch) {
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ ...loadState(), ...patch })); } catch { /* ignore */ }
+      }
+
+      const saved = loadState();
+      if (Array.isArray(saved.cart)) cart = saved.cart.filter((i) => i && i.name && i.unit > 0 && i.qty > 0);
+      if (saved.collapsed) setCollapsed(true);
+      if (saved.pos && Number.isFinite(saved.pos.x) && Number.isFinite(saved.pos.y)) moveTo(saved.pos.x, saved.pos.y);
+
+      updateLinePrice();
+      renderCart();
+    })();
+  </script>
+
 </body>
 
