+    /* ------------------------------------------------------------------
+       Theme selection — the ONLY place light/dark is decided.
+       Sources (later wins): OS preference, then an explicit root override:
+         <html data-theme="dark|light">  or  <html class="dark|light">
+         (also .theme-dark / .theme-light)
+       Each source flips `color-scheme` (native UI: scrollbars, controls,
+       canvas) and two "space toggles". A toggle set to `initial` is
+       guaranteed-invalid, so `var(--_when-dark, X)` resolves to X only in
+       dark mode and to nothing otherwise. Every themed token below is
+       written once as  var(--_when-light, LIGHT) var(--_when-dark, DARK),
+       so no component rule is ever repeated per theme or per source, and it
+       works in browsers without light-dark() or style queries.
+       ------------------------------------------------------------------ */
+    :root {
+      color-scheme: light;
+      --_when-light: initial;
+      --_when-dark: ;
+    }
+
+    @media (prefers-color-scheme: dark) {
+      :root {
+        color-scheme: dark;
+        --_when-light: ;
+        --_when-dark: initial;
+      }
+    }
+
+    :root:is([data-theme="dark"], .dark, .theme-dark) {
+      color-scheme: dark;
+      --_when-light: ;
+      --_when-dark: initial;
+    }
+
+    :root:is([data-theme="light"], .light, .theme-light) {
+      color-scheme: light;
+      --_when-light: initial;
+      --_when-dark: ;
+    }
+
+    /* Themed tokens (each defined once, both values side by side) */
+    :root {
