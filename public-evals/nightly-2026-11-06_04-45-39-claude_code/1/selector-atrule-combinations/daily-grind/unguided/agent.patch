+       * Override: set data-theme="light|dark" or class "light|dark" /
+       * "theme-light|theme-dark" on <html>. The themed tokens below are written
+       * once with light-dark(), which resolves against the active color-scheme,
+       * so no rule has to be repeated per theme or per trigger.
+       */
+      color-scheme: light dark;
+
+      /* Page */
+      --page-bg: light-dark(var(--light), #1a1412);
