+  <script>
+    // Fit each lockup line to the same width by solving for font-size.
+    (function () {
+      var lockups = document.querySelectorAll('.hero-lockup');
+      if (!lockups.length) return;
+
+      var REF = 100; // reference font-size in px used for measurement
+
+      function fit(lockup) {
+        var target = lockup.clientWidth;
+        if (!target || lockup._fitWidth === target) return;
+        lockup._fitWidth = target;
+        lockup.querySelectorAll('.line').forEach(function (line) {
+          line.style.fontSize = REF + 'px';
+          var w = line.getBoundingClientRect().width;
+          if (w) line.style.fontSize = (REF * target / w) + 'px';
+        });
+      }
+
+      function fitAll() { lockups.forEach(fit); }
+
+      fitAll();
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () {
+        lockups.forEach(function (l) { l._fitWidth = null; });
+        fitAll();
+      });
+      if ('ResizeObserver' in window) {
+        var ro = new ResizeObserver(fitAll);
+        lockups.forEach(function (l) { ro.observe(l); });
+      } else {
+        window.addEventListener('resize', fitAll);
+      }
+    })();
+  </script>
+
