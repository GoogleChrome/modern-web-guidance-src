diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13,8 +13,22 @@
       --text: #3e2723;
       --light: #fafafa;
     }
 
+    /* Reusable gradient generator (CSS custom function) */
+    @function --brew-gradient(--start <color>, --end <color>, --angle <angle>: 135deg) returns <image> {
+      result: linear-gradient(in oklab var(--angle), var(--start), var(--end));
+    }
+
+    /* Reusable responsive column generator: stacks on narrow screens,
+       splits into --count equal columns on wider screens */
+    @function --columns(--count <integer>: 2) {
+      result: 1fr;
+      @media (min-width: 700px) {
+        result: repeat(var(--count), minmax(0, 1fr));
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
@@ -23,11 +37,23 @@
     body {
       font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
       line-height: 1.6;
       color: var(--text);
-      background-color: var(--light);
+      min-height: 100vh;
+      /* Fallback for browsers without @function support */
+      background: linear-gradient(160deg, var(--light), var(--secondary));
+      background: --brew-gradient(var(--light), var(--secondary), 160deg);
     }
 
+    h2 {
+      color: white;
+      padding: 0.5rem 1rem;
+      border-radius: 6px;
+      /* Fallback for browsers without @function support */
+      background: linear-gradient(90deg, var(--primary), var(--accent));
+      background: --brew-gradient(var(--primary), var(--accent), 90deg);
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
@@ -101,9 +127,11 @@
     }
 
     .grid {
       display: grid;
-      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+      /* Fallback: single column for browsers without @function support */
+      grid-template-columns: 1fr;
+      grid-template-columns: --columns(2);
       gap: 20px;
       margin-top: 20px;
     }
 
