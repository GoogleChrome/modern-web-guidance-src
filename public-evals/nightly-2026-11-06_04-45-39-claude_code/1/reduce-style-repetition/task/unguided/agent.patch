+    /* ---------- Reusable CSS custom functions ----------
+       Native CSS @function (CSS Mixins & Functions spec).
+       Each usage below is preceded by a plain fallback declaration so
+       browsers without @function support still get the same look. */
+
+    /* Linear gradient between two colours at a given angle */
+    @function --gradient(--from <color>, --to <color>, --angle <angle>: 135deg) {
+      result: linear-gradient(var(--angle), var(--from), var(--to));
+    }
+
+    /* N equal-width grid columns */
+    @function --columns(--count <integer>: 1) {
+      result: repeat(var(--count), minmax(0, 1fr));
+    }
