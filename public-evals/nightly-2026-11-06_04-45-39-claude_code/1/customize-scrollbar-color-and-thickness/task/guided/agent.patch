+    /* Customer Feedback Log */
+    .feedback-section {
+      margin-top: 50px;
+    }
+
+    .feedback-log {
+      --scrollbar-thumb: var(--accent);
+      --scrollbar-track: var(--primary);
+
+      max-height: 320px;
+      overflow-y: auto;
+      margin-top: 20px;
+      padding: 15px;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      list-style: none;
+      scrollbar-width: thin;
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+    }
+
+    .feedback-log:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Legacy fallback for WebKit/Blink browsers without scrollbar-color */
+    @supports not (scrollbar-color: auto) {
+      .feedback-log::-webkit-scrollbar {
+        width: 8px;
+      }
+
+      .feedback-log::-webkit-scrollbar-track {
+        background: var(--scrollbar-track);
+        border-radius: 4px;
+      }
+
+      .feedback-log::-webkit-scrollbar-thumb {
+        background: var(--scrollbar-thumb);
+        border-radius: 4px;
+      }
+    }
+
+    .feedback-entry {
+      padding: 15px;
+      border-left: 4px solid var(--accent);
+      background: var(--light);
+      border-radius: 4px;
+    }
+
+    .feedback-entry + .feedback-entry {
+      margin-top: 12px;
+    }
+
+    .feedback-entry blockquote {
+      font-style: italic;
+      margin-bottom: 8px;
+    }
+
+    .feedback-meta {
+      font-size: 0.85rem;
+      color: var(--primary);
+      font-weight: 600;
+    }
+
+    .feedback-meta time {
+      font-weight: normal;
+      color: #6d4c41;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
