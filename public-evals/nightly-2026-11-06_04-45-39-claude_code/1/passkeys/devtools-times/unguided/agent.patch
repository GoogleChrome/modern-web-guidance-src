+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { currentUser, error, json, readJson, relyingParty, setChallenge } from '../../../../lib/auth/server';
+import { listPasskeys } from '../../../../lib/auth/store';
+
+/**
+ * `purpose: 'login'` – discoverable-credential sign-in (also used for autofill/conditional UI).
+ * `purpose: 'reauth'` – confirm the signed-in user with one of their own passkeys.
+ */
+export const POST: APIRoute = async (context) => {
+  const { purpose = 'login' } = await readJson<{ purpose?: 'login' | 'reauth' }>(context.request);
+  const { rpID } = relyingParty(context);
+
+  if (purpose === 'reauth') {
+    const user = await currentUser(context);
+    if (!user) return error(401, 'not_signed_in', 'Please sign in first.');
+    const passkeys = await listPasskeys(user.id);
+    if (!passkeys.length) return error(400, 'no_passkeys', 'This account has no passkeys.');
+    const options = await generateAuthenticationOptions({
+      rpID,
+      allowCredentials: passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+      userVerification: 'required',
+    });
+    await setChallenge(context, options.challenge, 'reauth');
+    return json(options);
+  }
+
+  const options = await generateAuthenticationOptions({ rpID, userVerification: 'preferred' });
+  await setChallenge(context, options.challenge, 'login');
+  return json(options);
+};
