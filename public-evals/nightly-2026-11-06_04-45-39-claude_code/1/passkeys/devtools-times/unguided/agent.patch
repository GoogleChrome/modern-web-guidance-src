+import type { APIRoute } from 'astro';
+import { REAUTH_WINDOW_MS, currentUser, error, json, publicPasskey, publicUser, relyingParty } from '../../../../lib/auth/server';
+import { listPasskeys } from '../../../../lib/auth/store';
+
+export const GET: APIRoute = async (context) => {
+  const user = await currentUser(context);
+  if (!user) return error(401, 'not_signed_in', 'Please sign in first.');
+  const authAt = (await context.session?.get('authAt')) ?? 0;
+  const passkeys = await listPasskeys(user.id);
+  return json({
+    user: publicUser(user),
+    passkeys: passkeys.map(publicPasskey),
+    rpID: relyingParty(context).rpID,
+    reauthenticatedUntil: authAt ? authAt + REAUTH_WINDOW_MS : 0,
+  });
+};
