+/**
+ * A small subset of the community-maintained passkey provider AAGUID list
+ * (https://github.com/passkeydeveloper/passkey-authenticator-aaguids) used to give
+ * passkeys a friendly default name and show which provider stores them.
+ */
+const PROVIDERS: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  '771b48fd-d3d4-4f74-9232-fc157ab0507a': 'Edge on Mac',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  'b5397666-4885-aa6b-cebf-e52262a439a9': 'Samsung Pass',
+  'fdb141b2-5d84-443e-8a35-4698c205a502': 'KeePassXC',
+  'cc45f64e-52a2-451b-831a-4edd8022a202': 'ToothPic Passkey Provider',
+  'f3809540-7f14-49c1-a8b3-8f813b225541': 'Enpass',
+  'cb69481e-8ff7-4039-93ec-0a2729a154a8': 'YubiKey 5',
+  'ee882879-721c-4913-9775-3dfcce97072a': 'YubiKey 5',
+  'fa2b99dc-9e39-4257-8f92-4a30d23c4118': 'YubiKey 5 NFC',
+  '2fc0579f-8113-47ea-b116-bb5a8db9202a': 'YubiKey 5 NFC',
+  'a4e9fc6d-4cbe-4758-b8ba-37598bb5bbaa': 'Security Key NFC by Yubico',
+  'e77e3c64-05e3-428b-8824-0cbeb04b829d': 'Security Key NFC by Yubico',
+};
+
+export function providerName(aaguid: string | undefined | null): string | null {
+  if (!aaguid || /^0{8}-0{4}-0{4}-0{4}-0{12}$/.test(aaguid)) return null;
+  return PROVIDERS[aaguid.toLowerCase()] ?? null;
+}
diff --git a/src/lib/auth/client.ts b/src/lib/auth/client.ts
new file mode 100644
index 0000000..821609a
--- /dev/null
+++ b/src/lib/auth/client.ts
@@ -0,0 +1,169 @@
+/**
+ * Browser-side helpers for the passkey flows. Wraps @simplewebauthn/browser and the
+ * /api/auth endpoints, and normalises errors into user-friendly messages.
+ */
+import {
+  browserSupportsWebAuthn,
+  browserSupportsWebAuthnAutofill,
+  getBrowserCapabilities,
+  sendSignal,
+  startAuthentication,
+  startRegistration,
+  WebAuthnAbortService,
+  WebAuthnError,
+} from '@simplewebauthn/browser';
+
+export const BASE_URL = import.meta.env.BASE_URL.endsWith('/')
+  ? import.meta.env.BASE_URL
+  : `${import.meta.env.BASE_URL}/`;
+
+export class ApiError extends Error {
+  constructor(public status: number, public code: string, message: string, public data: any = {}) {
+    super(message);
+  }
+}
+
+/** Thrown when the user dismisses the browser's passkey dialog. Usually not worth showing. */
+export class CeremonyCancelledError extends Error {}
+
+export async function api<T = any>(path: string, init: { method?: string; body?: unknown } = {}): Promise<T> {
+  const res = await fetch(`${BASE_URL}api/auth/${path}`, {
+    method: init.method ?? (init.body !== undefined ? 'POST' : 'GET'),
+    headers: init.body !== undefined ? { 'Content-Type': 'application/json' } : undefined,
+    body: init.body !== undefined ? JSON.stringify(init.body) : undefined,
+    credentials: 'same-origin',
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) {
+    throw new ApiError(res.status, data?.error?.code ?? 'unknown', data?.error?.message ?? 'Something went wrong.', data);
+  }
+  return data as T;
+}
+
+export interface PublicUser {
+  id: string;
+  username: string;
+  webauthnUserID: string;
+  hasPassword: boolean;
+  createdAt: string;
+}
+
+export interface Passkey {
+  id: string;
+  name: string;
+  provider: string | null;
+  synced: boolean;
+  deviceType: 'singleDevice' | 'multiDevice';
+  transports: string[];
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+export const passkeysSupported = () => typeof window !== 'undefined' && browserSupportsWebAuthn();
+export const autofillSupported = () => browserSupportsWebAuthnAutofill();
+
+export async function conditionalCreateSupported() {
+  try {
+    const caps = await getBrowserCapabilities();
+    return caps.conditionalCreate === 'supported';
+  } catch {
+    return false;
+  }
+}
+
+function translateCeremonyError(err: unknown, kind: 'create' | 'get'): never {
+  if (err instanceof WebAuthnError) {
+    switch (err.code) {
+      case 'ERROR_CEREMONY_ABORTED':
+        throw new CeremonyCancelledError('Cancelled');
+      case 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED':
+        throw new Error('You already have a passkey for this account on this device or password manager.');
+      case 'ERROR_INVALID_DOMAIN':
+      case 'ERROR_INVALID_RP_ID':
+        throw new Error('Passkeys aren’t available on this domain. They require HTTPS (or localhost).');
+    }
+    const cause = (err as any).cause as Error | undefined;
+    if (cause?.name === 'NotAllowedError') throw new CeremonyCancelledError('Cancelled');
+  }
+  if (err instanceof Error && (err.name === 'NotAllowedError' || err.name === 'AbortError')) {
+    throw new CeremonyCancelledError('Cancelled');
+  }
+  throw new Error(
+    kind === 'create'
+      ? 'We couldn’t create a passkey. Please try again.'
+      : 'We couldn’t sign you in with a passkey. Please try again.',
+  );
+}
+
+/** Best-effort WebAuthn signals – silently ignored where unsupported. */
+async function signal(opts: Parameters<typeof sendSignal>[0]) {
+  try {
+    await sendSignal(opts);
+  } catch {
+    /* unsupported or rejected – nothing to do */
+  }
+}
+
+export const signalCurrentUser = (rpID: string, user: PublicUser) =>
+  signal({ signalName: 'currentUserDetails', rpID, userID: user.webauthnUserID, userName: user.username, userDisplayName: user.username });
+
+export const signalAcceptedCredentials = (rpID: string, userID: string, credentialIDs: string[]) =>
+  signal({ signalName: 'allAcceptedCredentials', rpID, userID, allAcceptedCredentialIDs: credentialIDs });
+
+/**
+ * Creates a passkey. Without a session this is passkey-first sign-up (needs `username`);
+ * with a session it adds a passkey to the current account. `conditional` performs a silent
+ * upgrade via conditional create and never shows UI if the browser can't do it.
+ */
+export async function registerPasskey(opts: { username?: string; conditional?: boolean } = {}) {
+  const optionsJSON = await api('passkey/registration-options', {
+    body: { username: opts.username, conditional: opts.conditional },
+  });
+  let response;
+  try {
+    response = await startRegistration({ optionsJSON, useAutoRegister: opts.conditional });
+  } catch (err) {
+    translateCeremonyError(err, 'create');
+  }
+  const result = await api<{ user: PublicUser; passkey: Passkey; rpID: string }>('passkey/registration-verify', {
+    body: { response },
+  });
+  void signalCurrentUser(result.rpID, result.user);
+  return result;
+}
+
+async function authenticate(purpose: 'login' | 'reauth', useBrowserAutofill = false) {
+  const optionsJSON = await api('passkey/authentication-options', { body: { purpose } });
+  let response;
+  try {
+    response = await startAuthentication({ optionsJSON, useBrowserAutofill });
+  } catch (err) {
+    translateCeremonyError(err, 'get');
+  }
+  try {
+    return await api<{ user: PublicUser; rpID: string }>('passkey/authentication-verify', {
+      body: { response, purpose },
+    });
+  } catch (err) {
+    if (err instanceof ApiError && err.code === 'unknown_credential') {
+      // Ask the passkey provider to hide/remove a passkey we no longer recognise.
+      void signal({ signalName: 'unknownCredential', rpID: err.data.rpID, credentialID: err.data.credentialID });
+    }
+    throw err;
+  }
+}
+
+/** Sign in with any discoverable passkey; `autofill` uses conditional mediation. */
+export const signInWithPasskey = (opts: { autofill?: boolean } = {}) => authenticate('login', opts.autofill);
+
+/** Confirms the signed-in user with one of their passkeys (user verification required). */
+export const reauthenticateWithPasskey = () => authenticate('reauth');
+
+export const reauthenticateWithPassword = (password: string) => api('reauth/password', { body: { password } });
+
+export const cancelPendingCeremony = () => WebAuthnAbortService.cancelCeremony();
+
+export async function signOut() {
+  cancelPendingCeremony();
+  await api('logout', { body: {} });
+}
diff --git a/src/lib/auth/server.ts b/src/lib/auth/server.ts
new file mode 100644
index 0000000..f475959
--- /dev/null
+++ b/src/lib/auth/server.ts
@@ -0,0 +1,152 @@
+import type { APIContext } from 'astro';
+import { findUserById, type PasskeyRecord, type UserRecord } from './store';
+import { providerName } from './aaguids';
+
+export const RP_NAME = 'The DevTools Times';
+export const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+/** Sensitive account changes require a sign-in or reauthentication within this window. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+export const UPSTREAM_AUTH_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+/**
+ * Relying party settings. Astro resolves `context.url` from trusted forwarded headers
+ * (see `security.allowedDomains` in astro.config.mjs), so the RP ID follows whichever
+ * deployment hostname served the request. Both can be pinned with env vars.
+ */
+export function relyingParty(context: APIContext) {
+  const rpID = process.env.WEBAUTHN_RP_ID || context.url.hostname;
+  const origins = process.env.WEBAUTHN_ORIGINS
+    ? process.env.WEBAUTHN_ORIGINS.split(',').map((o) => o.trim()).filter(Boolean)
+    : [context.url.origin];
+  return { rpID, rpName: RP_NAME, origins };
+}
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function error(status: number, code: string, message: string, extra: Record<string, unknown> = {}) {
+  return json({ error: { code, message }, ...extra }, status);
+}
+
+export async function readJson<T = any>(request: Request): Promise<T> {
+  try {
+    return (await request.json()) as T;
+  } catch {
+    return {} as T;
+  }
+}
+
+export async function currentUser(context: APIContext): Promise<UserRecord | null> {
+  const sessionUser = await context.session?.get('user');
+  if (!sessionUser) return null;
+  const user = await findUserById(sessionUser.id);
+  if (!user) {
+    // Account no longer exists (e.g. data reset) – drop the stale session.
+    context.session?.delete('user');
+    context.session?.delete('authAt');
+  }
+  return user;
+}
+
+export async function isRecentlyAuthenticated(context: APIContext) {
+  const authAt = await context.session?.get('authAt');
+  return typeof authAt === 'number' && Date.now() - authAt < REAUTH_WINDOW_MS;
+}
+
+export function reauthRequired() {
+  return error(401, 'reauth_required', 'Please confirm it’s you to continue.');
+}
+
+export async function signIn(context: APIContext, user: UserRecord) {
+  const session = context.session;
+  if (!session) throw new Error('Sessions are not configured');
+  // New session ID on privilege change to prevent session fixation (data is carried over).
+  await session.regenerate();
+  session.set('user', { id: user.id, username: user.username });
+  session.set('authAt', Date.now());
+  session.delete('webauthnChallenge');
+}
+
+export function markReauthenticated(context: APIContext) {
+  context.session?.set('authAt', Date.now());
+}
+
+export async function setChallenge(
+  context: APIContext,
+  value: string,
+  purpose: App.SessionData['webauthnChallenge']['purpose'],
+  extra: Pick<App.SessionData['webauthnChallenge'], 'pendingUser' | 'conditional'> = {},
+) {
+  context.session?.set('webauthnChallenge', {
+    value,
+    purpose,
+    expiresAt: Date.now() + CHALLENGE_TTL_MS,
+    ...extra,
+  });
+}
+
+/** Returns and clears the pending challenge so it can only be used once. */
+export async function consumeChallenge(
+  context: APIContext,
+  purpose: App.SessionData['webauthnChallenge']['purpose'],
+) {
+  const challenge = await context.session?.get('webauthnChallenge');
+  context.session?.delete('webauthnChallenge');
+  if (!challenge || challenge.purpose !== purpose || challenge.expiresAt < Date.now()) return null;
+  return challenge;
+}
+
+export function publicUser(user: UserRecord) {
+  return {
+    id: user.id,
+    username: user.username,
+    webauthnUserID: user.webauthnUserID,
+    hasPassword: user.hasPassword,
+    createdAt: user.createdAt,
+  };
+}
+
+export function publicPasskey(pk: PasskeyRecord) {
+  return {
+    id: pk.id,
+    name: pk.name,
+    provider: providerName(pk.aaguid),
+    synced: pk.backedUp,
+    deviceType: pk.deviceType,
+    transports: pk.transports ?? [],
+    createdAt: pk.createdAt,
+    lastUsedAt: pk.lastUsedAt,
+  };
+}
+
+/** Calls the upstream password service. */
+export async function upstreamPasswordCall(
+  action: 'login' | 'register',
+  username: string,
+  password: string,
+): Promise<{ ok: true } | { ok: false; status: number; message: string }> {
+  try {
+    const res = await fetch(`${UPSTREAM_AUTH_API}/${action}`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+    if (res.ok) return { ok: true };
+    const data = await res.json().catch(() => ({}));
+    return { ok: false, status: res.status, message: String(data?.error ?? 'Unknown error') };
+  } catch {
+    return { ok: false, status: 502, message: 'The sign-in service is unavailable. Please try again later.' };
+  }
+}
+
+const USERNAME_RE = /^[a-zA-Z0-9._-]{3,32}$/;
+export function validateUsername(username: unknown): string | null {
+  if (typeof username !== 'string' || !USERNAME_RE.test(username.trim())) {
+    return 'Usernames must be 3–32 characters: letters, numbers, dots, dashes or underscores.';
+  }
+  return null;
+}
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..1acb369
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,153 @@
+/**
+ * Minimal file-backed persistence for local accounts and their passkeys.
+ *
+ * Password credentials remain with the upstream Times auth service; this store only keeps
+ * what the relying party needs for WebAuthn: a stable, opaque WebAuthn user handle per
+ * account and the public-key credentials registered to it.
+ */
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+
+export interface UserRecord {
+  id: string;
+  username: string;
+  /** base64url-encoded random user handle used as WebAuthn `user.id` (never the username). */
+  webauthnUserID: string;
+  /** Whether this account also has a password with the upstream auth service. */
+  hasPassword: boolean;
+  createdAt: string;
+}
+
+export interface PasskeyRecord {
+  /** base64url credential ID */
+  id: string;
+  userId: string;
+  /** base64url COSE public key */
+  publicKey: string;
+  counter: number;
+  transports?: string[];
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  aaguid: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+interface Database {
+  users: UserRecord[];
+  passkeys: PasskeyRecord[];
+}
+
+const DATA_FILE = path.resolve(
+  process.env.AUTH_DATA_FILE ?? path.join(process.cwd(), '.data', 'auth.json'),
+);
+
+let cache: Database | null = null;
+let queue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<Database> {
+  if (cache) return cache;
+  try {
+    const raw = await fs.readFile(DATA_FILE, 'utf8');
+    const parsed = JSON.parse(raw) as Partial<Database>;
+    cache = { users: parsed.users ?? [], passkeys: parsed.passkeys ?? [] };
+  } catch (err: any) {
+    if (err?.code !== 'ENOENT') throw err;
+    cache = { users: [], passkeys: [] };
+  }
+  return cache;
+}
+
+async function persist(db: Database) {
+  await fs.mkdir(path.dirname(DATA_FILE), { recursive: true });
+  const tmp = `${DATA_FILE}.${process.pid}.${Date.now()}.tmp`;
+  await fs.writeFile(tmp, JSON.stringify(db, null, 2), 'utf8');
+  await fs.rename(tmp, DATA_FILE);
+}
+
+/** Serialises all access so read-modify-write cycles never interleave. */
+function withDb<T>(fn: (db: Database) => T | Promise<T>, write = false): Promise<T> {
+  const run = queue.then(async () => {
+    const db = await load();
+    const result = await fn(db);
+    if (write) await persist(db);
+    return result;
+  });
+  queue = run.catch(() => undefined);
+  return run;
+}
+
+const normalise = (username: string) => username.trim().toLowerCase();
+
+export const findUserById = (id: string) =>
+  withDb((db) => db.users.find((u) => u.id === id) ?? null);
+
+export const findUserByUsername = (username: string) =>
+  withDb((db) => db.users.find((u) => normalise(u.username) === normalise(username)) ?? null);
+
+export class UsernameTakenError extends Error {}
+
+export function createUser(username: string, opts: { hasPassword: boolean; webauthnUserID?: string }) {
+  return withDb((db) => {
+    if (db.users.some((u) => normalise(u.username) === normalise(username))) {
+      throw new UsernameTakenError('Username is already taken');
+    }
+    const user: UserRecord = {
+      id: crypto.randomUUID(),
+      username: username.trim(),
+      webauthnUserID: opts.webauthnUserID ?? crypto.randomBytes(32).toString('base64url'),
+      hasPassword: opts.hasPassword,
+      createdAt: new Date().toISOString(),
+    };
+    db.users.push(user);
+    return user;
+  }, true);
+}
+
+export const markUserHasPassword = (id: string) =>
+  withDb((db) => {
+    const user = db.users.find((u) => u.id === id);
+    if (user) user.hasPassword = true;
+    return user ?? null;
+  }, true);
+
+export const listPasskeys = (userId: string) =>
+  withDb((db) =>
+    db.passkeys
+      .filter((p) => p.userId === userId)
+      .sort((a, b) => a.createdAt.localeCompare(b.createdAt)),
+  );
+
+export const findPasskey = (id: string) =>
+  withDb((db) => db.passkeys.find((p) => p.id === id) ?? null);
+
+export const addPasskey = (record: PasskeyRecord) =>
+  withDb((db) => {
+    if (db.passkeys.some((p) => p.id === record.id)) {
+      throw new Error('Credential already registered');
+    }
+    db.passkeys.push(record);
+    return record;
+  }, true);
+
+export const updatePasskey = (
+  id: string,
+  userId: string,
+  patch: Partial<Pick<PasskeyRecord, 'name' | 'counter' | 'backedUp' | 'deviceType' | 'lastUsedAt'>>,
+) =>
+  withDb((db) => {
+    const pk = db.passkeys.find((p) => p.id === id && p.userId === userId);
+    if (!pk) return null;
+    Object.assign(pk, patch);
+    return pk;
+  }, true);
+
+export const deletePasskey = (id: string, userId: string) =>
+  withDb((db) => {
+    const idx = db.passkeys.findIndex((p) => p.id === id && p.userId === userId);
+    if (idx === -1) return false;
+    db.passkeys.splice(idx, 1);
+    return true;
+  }, true);
