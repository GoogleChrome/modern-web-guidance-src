+++ b/src/components/auth/ReauthDialog.tsx
@@ -0,0 +1,159 @@
+import { useEffect, useRef, useState } from 'react';
+import PasskeyIcon from './PasskeyIcon';
+import Alert from './Alert';
+import {
+  ApiError,
+  CeremonyCancelledError,
+  reauthenticateWithPasskey,
+  reauthenticateWithPassword,
+} from '../../lib/auth/client';
+
+interface Props {
+  open: boolean;
+  username: string;
+  /** Whether the user has at least one passkey to confirm with. */
+  canUsePasskey: boolean;
+  canUsePassword: boolean;
+  /** Short description of the action being confirmed, e.g. “delete this passkey”. */
+  action: string;
+  onSuccess: () => void;
+  onCancel: () => void;
+}
+
+/**
+ * "Confirm it's you" step-up dialog. Prefers a passkey (with user verification) and falls
+ * back to the account password where one exists.
+ */
+export default function ReauthDialog({ open, username, canUsePasskey, canUsePassword, action, onSuccess, onCancel }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const [mode, setMode] = useState<'passkey' | 'password'>(canUsePasskey ? 'passkey' : 'password');
+  const [password, setPassword] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (open && !dialog.open) {
+      setMode(canUsePasskey ? 'passkey' : 'password');
+      setPassword('');
+      setError(null);
+      dialog.showModal();
+    } else if (!open && dialog.open) {
+      dialog.close();
+    }
+  }, [open, canUsePasskey]);
+
+  const finish = () => {
+    setPassword('');
+    onSuccess();
+  };
+
+  const usePasskey = async () => {
+    setBusy(true);
+    setError(null);
+    try {
+      await reauthenticateWithPasskey();
+      finish();
+    } catch (err) {
+      if (!(err instanceof CeremonyCancelledError)) {
+        setError(err instanceof Error ? err.message : 'Verification failed.');
+      }
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const submitPassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setBusy(true);
+    setError(null);
+    try {
+      await reauthenticateWithPassword(password);
+      finish();
+    } catch (err) {
+      setError(err instanceof ApiError ? err.message : 'Verification failed.');
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <dialog
+      ref={dialogRef}
+      onCancel={(e) => {
+        e.preventDefault();
+        if (!busy) onCancel();
+      }}
+      aria-labelledby="reauth-title"
+      className="m-auto w-full max-w-sm rounded-lg p-0 shadow-xl backdrop:bg-black/50"
+    >
+      <div className="p-6">
+        <h2 id="reauth-title" className="text-lg font-bold text-gray-900">Confirm it’s you</h2>
+        <p className="mt-1 text-sm text-gray-600">
+          To {action}, please verify your identity as <strong>{username}</strong>.
+        </p>
+
+        <div className="mt-4">
+          {error && <Alert kind="error">{error}</Alert>}
+
+          {mode === 'passkey' ? (
+            <button
+              type="button"
+              onClick={usePasskey}
+              disabled={busy}
+              autoFocus
+              className="w-full inline-flex items-center justify-center gap-2 py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75"
+            >
+              <PasskeyIcon />
+              {busy ? 'Waiting for passkey…' : 'Use your passkey'}
+            </button>
+          ) : (
+            <form onSubmit={submitPassword} className="space-y-3">
+              {/* Hidden username helps password managers pick the right entry. */}
+              <input type="text" name="username" autoComplete="username" value={username} readOnly hidden />
+              <label htmlFor="reauth-password" className="block text-sm font-medium text-gray-700">Password</label>
+              <input
+                id="reauth-password"
+                type="password"
+                autoComplete="current-password"
+                value={password}
+                onChange={(e) => setPassword(e.target.value)}
+                required
+                autoFocus
+                className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+              />
+              <button
+                type="submit"
+                disabled={busy}
+                className="w-full py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75"
+              >
+                {busy ? 'Verifying…' : 'Continue'}
+              </button>
+            </form>
+          )}
+
+          {canUsePasskey && canUsePassword && (
+            <button
+              type="button"
+              onClick={() => { setError(null); setMode(mode === 'passkey' ? 'password' : 'passkey'); }}
+              disabled={busy}
+              className="mt-3 w-full text-center text-sm text-gray-600 underline hover:text-gray-900"
+            >
+              {mode === 'passkey' ? 'Use your password instead' : 'Use a passkey instead'}
+            </button>
+          )}
+
+          <button
+            type="button"
+            onClick={onCancel}
+            disabled={busy}
+            className="mt-2 w-full py-2 px-4 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100"
+          >
+            Cancel
+          </button>
+        </div>
+      </div>
+    </dialog>
+  );
+}
