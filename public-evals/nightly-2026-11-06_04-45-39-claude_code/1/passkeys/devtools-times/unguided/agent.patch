+import type { APIRoute } from 'astro';
+import { currentUser, error, json, markReauthenticated, readJson, upstreamPasswordCall } from '../../../../lib/auth/server';
+
+export const POST: APIRoute = async (context) => {
+  const user = await currentUser(context);
+  if (!user) return error(401, 'not_signed_in', 'Please sign in first.');
+  if (!user.hasPassword) return error(400, 'no_password', 'This account doesn’t use a password.');
+  const { password } = await readJson<{ password?: string }>(context.request);
+  if (!password) return error(400, 'invalid_request', 'Password is required.');
+
+  const result = await upstreamPasswordCall('login', user.username, password);
+  if (!result.ok) return error(401, 'reauth_failed', result.status === 502 ? result.message : 'Incorrect password.');
+
+  markReauthenticated(context);
+  return json({ ok: true });
+};
