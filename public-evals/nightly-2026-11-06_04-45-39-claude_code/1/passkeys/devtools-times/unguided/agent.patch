index 0000000..9e5d5b9
--- /dev/null
+++ b/src/pages/api/auth/passkey/registration-options.ts
@@ -0,0 +1,72 @@
+import type { APIRoute } from 'astro';
+import crypto from 'node:crypto';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import {
+  currentUser,
+  error,
+  isRecentlyAuthenticated,
+  json,
+  readJson,
+  reauthRequired,
+  relyingParty,
+  setChallenge,
+  validateUsername,
+} from '../../../../lib/auth/server';
+import { findUserByUsername, listPasskeys } from '../../../../lib/auth/store';
+
+/**
+ * Starts passkey registration.
+ * - Signed out + `username`: passkey-first sign-up (account is created once verified).
+ * - Signed in: adds a passkey to the current account (requires recent authentication).
+ *   `conditional: true` marks an automatic upgrade via conditional create.
+ */
+export const POST: APIRoute = async (context) => {
+  const body = await readJson<{ username?: string; conditional?: boolean }>(context.request);
+  const { rpID, rpName } = relyingParty(context);
+  const user = await currentUser(context);
+
+  let userName: string;
+  let webauthnUserID: string;
+  let excludeCredentials: { id: string; transports?: string[] }[] = [];
+  let pendingUser: { username: string; webauthnUserID: string } | undefined;
+
+  if (user) {
+    if (!(await isRecentlyAuthenticated(context))) return reauthRequired();
+    userName = user.username;
+    webauthnUserID = user.webauthnUserID;
+    excludeCredentials = (await listPasskeys(user.id)).map((p) => ({ id: p.id, transports: p.transports }));
+  } else {
+    const invalid = validateUsername(body.username);
+    if (invalid) return error(400, 'invalid_username', invalid);
+    const username = body.username!.trim();
+    if (await findUserByUsername(username)) {
+      return error(409, 'username_taken', 'That username is already taken. Try signing in instead.');
+    }
+    userName = username;
+    webauthnUserID = crypto.randomBytes(32).toString('base64url');
+    pendingUser = { username, webauthnUserID };
+  }
+
+  const options = await generateRegistrationOptions({
+    rpName,
+    rpID,
+    userName,
+    userDisplayName: userName,
+    userID: Buffer.from(webauthnUserID, 'base64url'),
+    attestationType: 'none',
+    excludeCredentials,
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+    },
+    // Ask for credProps so we can tell whether the credential is discoverable.
+    extensions: { credProps: true } as any,
+  });
+
+  await setChallenge(context, options.challenge, 'register', {
+    pendingUser,
+    conditional: Boolean(user && body.conditional),
+  });
+  return json(options);
+};
