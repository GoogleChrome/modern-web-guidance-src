+import { BASE_URL } from '../../lib/auth/client';
+
+/** Resolves a safe same-site post-auth destination from `?next=`. */
+export function postAuthDestination(fallback: string) {
+  const next = new URLSearchParams(window.location.search).get('next');
+  if (next && next.startsWith(BASE_URL) && !next.startsWith('//')) return next;
+  return fallback;
+}
+
+export function go(url: string) {
+  window.location.assign(url);
+}
