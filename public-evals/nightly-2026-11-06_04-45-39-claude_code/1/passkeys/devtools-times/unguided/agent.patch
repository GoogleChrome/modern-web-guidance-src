index 0000000..9059a10
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,405 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import PasskeyIcon from './auth/PasskeyIcon';
+import Alert from './auth/Alert';
+import ReauthDialog from './auth/ReauthDialog';
+import {
+  api,
+  ApiError,
+  BASE_URL,
+  CeremonyCancelledError,
+  passkeysSupported,
+  registerPasskey,
+  signalAcceptedCredentials,
+  signalCurrentUser,
+  signOut,
+  type Passkey,
+  type PublicUser,
+} from '../lib/auth/client';
+
+interface Props {
+  initialUser: PublicUser;
+  initialPasskeys: Passkey[];
+  rpID: string;
+}
+
+interface PendingReauth {
+  action: string;
+  run: () => Promise<void>;
+  /**
+   * WebAuthn ceremonies need a fresh user gesture in some browsers (e.g. Safari), so these
+   * resume via an explicit "Continue" click rather than automatically after reauth.
+   */
+  needsGesture?: boolean;
+}
+
+const dateFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+const timeFmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
+
+export default function AccountSettings({ initialUser, initialPasskeys, rpID }: Props) {
+  const [user, setUser] = useState(initialUser);
+  const [passkeys, setPasskeys] = useState(initialPasskeys);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [creating, setCreating] = useState(false);
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [draftName, setDraftName] = useState('');
+  const [confirmDelete, setConfirmDelete] = useState<Passkey | null>(null);
+  const [reauth, setReauth] = useState<PendingReauth | null>(null);
+  const [resume, setResume] = useState<PendingReauth | null>(null);
+  const [supported, setSupported] = useState(true);
+  const renameInput = useRef<HTMLInputElement>(null);
+
+  // Keep passkey providers in sync with the server's view of this account.
+  const syncSignals = useCallback((u: PublicUser, list: Passkey[]) => {
+    void signalAcceptedCredentials(rpID, u.webauthnUserID, list.map((p) => p.id));
+    void signalCurrentUser(rpID, u);
+  }, [rpID]);
+
+  useEffect(() => {
+    setSupported(passkeysSupported());
+    syncSignals(initialUser, initialPasskeys);
+  }, []);
+
+  useEffect(() => {
+    if (editingId) renameInput.current?.focus();
+  }, [editingId]);
+
+  const refresh = async () => {
+    const data = await api<{ user: PublicUser; passkeys: Passkey[] }>('passkeys');
+    setUser(data.user);
+    setPasskeys(data.passkeys);
+    return data;
+  };
+
+  /** Runs a sensitive action, asking the user to reauthenticate first if the server requires it. */
+  const withReauth = async (action: string, run: () => Promise<void>, needsGesture = false) => {
+    setResume(null);
+    try {
+      await run();
+    } catch (err) {
+      if (err instanceof ApiError && err.code === 'reauth_required') {
+        setReauth({ action, run, needsGesture });
+        return;
+      }
+      throw err;
+    }
+  };
+
+  const reportError = (err: unknown) => {
+    if (err instanceof CeremonyCancelledError) return;
+    setError(err instanceof Error ? err.message : 'Something went wrong.');
+  };
+
+  const createPasskey = async () => {
+    setError(null);
+    setNotice(null);
+    setCreating(true);
+    try {
+      await withReauth('create a new passkey', async () => {
+        const { passkey } = await registerPasskey();
+        const data = await refresh();
+        syncSignals(data.user, data.passkeys);
+        setNotice(`Passkey “${passkey.name}” created.`);
+      }, true);
+    } catch (err) {
+      reportError(err);
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  const startRename = (pk: Passkey) => {
+    setEditingId(pk.id);
+    setDraftName(pk.name);
+    setError(null);
+    setNotice(null);
+  };
+
+  const saveRename = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!editingId) return;
+    const id = editingId;
+    setBusyId(id);
+    try {
+      const { passkey } = await api<{ passkey: Passkey }>(`passkeys/${encodeURIComponent(id)}`, {
+        method: 'PATCH',
+        body: { name: draftName },
+      });
+      setPasskeys((list) => list.map((p) => (p.id === id ? passkey : p)));
+      setEditingId(null);
+      setNotice('Passkey renamed.');
+    } catch (err) {
+      reportError(err);
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  const deletePasskey = async (pk: Passkey) => {
+    setConfirmDelete(null);
+    setError(null);
+    setNotice(null);
+    setBusyId(pk.id);
+    try {
+      await withReauth(`delete the passkey “${pk.name}”`, async () => {
+        const res = await api<{ rpID: string; userID: string; remainingCredentialIDs: string[] }>(
+          `passkeys/${encodeURIComponent(pk.id)}`,
+          { method: 'DELETE' },
+        );
+        // Tell the provider this passkey is gone so it stops offering it.
+        void signalAcceptedCredentials(res.rpID, res.userID, res.remainingCredentialIDs);
+        setPasskeys((list) => list.filter((p) => p.id !== pk.id));
+        setNotice(`Passkey “${pk.name}” deleted. You may also want to remove it from your password manager.`);
+      });
+    } catch (err) {
+      reportError(err);
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  const handleSignOut = async () => {
+    try {
+      await signOut();
+    } finally {
+      window.location.assign(BASE_URL);
+    }
+  };
+
+  const isLastSignInMethod = !user.hasPassword && passkeys.length <= 1;
+
+  return (
+    <div className="max-w-3xl mx-auto mt-10 space-y-8">
+      <div className="flex flex-wrap items-end justify-between gap-4 border-b border-gray-200 pb-4">
+        <div>
+          <h1 className="text-3xl font-bold text-gray-900">Account settings</h1>
+          <p className="mt-1 text-sm text-gray-600">
+            Signed in as <strong>{user.username}</strong> · member since {dateFmt.format(new Date(user.createdAt))}
+          </p>
+        </div>
+        <button
+          type="button"
+          onClick={handleSignOut}
+          className="py-2 px-4 rounded-md border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50"
+        >
+          Sign out
+        </button>
+      </div>
+
+      {error && <Alert kind="error">{error}</Alert>}
+      {notice && <Alert kind="success">{notice}</Alert>}
+      {resume && (
+        <Alert kind="info">
+          <div className="flex flex-wrap items-center justify-between gap-3">
+            <span>Thanks — you’re verified. Continue to {resume.action}.</span>
+            <span className="flex gap-2">
+              <button
+                type="button"
+                onClick={() => { setResume(null); void createPasskey(); }}
+                className="py-1 px-3 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800"
+              >
+                Continue
+              </button>
+              <button type="button" onClick={() => setResume(null)} className="py-1 px-3 rounded-md text-sm text-gray-700 hover:bg-gray-200">
+                Dismiss
+              </button>
+            </span>
+          </div>
+        </Alert>
+      )}
+
+      <section aria-labelledby="passkeys-heading" className="rounded-lg border border-gray-200 bg-white shadow-sm">
+        <div className="flex flex-wrap items-start justify-between gap-4 p-6 border-b border-gray-200">
+          <div className="max-w-xl">
+            <h2 id="passkeys-heading" className="flex items-center gap-2 text-xl font-bold text-gray-900">
+              <PasskeyIcon /> Passkeys
+            </h2>
+            <p className="mt-1 text-sm text-gray-600">
+              Passkeys let you sign in with your fingerprint, face, or screen lock. They’re stored in your
+              password manager or security key and can’t be phished or leaked.
+            </p>
+          </div>
+          <button
+            type="button"
+            onClick={createPasskey}
+            disabled={creating || !supported}
+            className="inline-flex items-center gap-2 py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-60"
+          >
+            <PasskeyIcon />
+            {creating ? 'Creating…' : 'Create a passkey'}
+          </button>
+        </div>
+
+        {!supported && (
+          <p className="px-6 pt-4 text-sm text-amber-700">This browser doesn’t support passkeys.</p>
+        )}
+
+        {passkeys.length === 0 ? (
+          <div className="p-6 text-sm text-gray-600">
+            You don’t have any passkeys yet. Create one to sign in faster and more securely.
+          </div>
+        ) : (
+          <ul className="divide-y divide-gray-200">
+            {passkeys.map((pk) => (
+              <li key={pk.id} className="flex flex-wrap items-center gap-4 p-6">
+                <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-700">
+                  <PasskeyIcon />
+                </div>
+
+                <div className="min-w-0 flex-1">
+                  {editingId === pk.id ? (
+                    <form onSubmit={saveRename} className="flex flex-wrap items-center gap-2">
+                      <label htmlFor={`rename-${pk.id}`} className="sr-only">Passkey name</label>
+                      <input
+                        id={`rename-${pk.id}`}
+                        ref={renameInput}
+                        value={draftName}
+                        onChange={(e) => setDraftName(e.target.value)}
+                        onKeyDown={(e) => e.key === 'Escape' && setEditingId(null)}
+                        maxLength={64}
+                        required
+                        className="flex-1 min-w-40 px-2 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
+                      />
+                      <button type="submit" disabled={busyId === pk.id} className="py-1 px-3 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-60">
+                        Save
+                      </button>
+                      <button type="button" onClick={() => setEditingId(null)} className="py-1 px-3 rounded-md text-sm text-gray-700 hover:bg-gray-100">
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <p className="font-semibold text-gray-900 truncate">{pk.name}</p>
+                  )}
+                  <div className="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-600">
+                    {pk.provider && pk.provider !== pk.name && <span>{pk.provider}</span>}
+                    <span
+                      className={`rounded-full px-2 py-0.5 font-medium ${pk.synced ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-700'}`}
+                      title={pk.synced ? 'Backed up and available on your other devices' : 'Only available on the device or security key that created it'}
+                    >
+                      {pk.synced ? 'Synced' : 'This device only'}
+                    </span>
+                    <span>Created {dateFmt.format(new Date(pk.createdAt))}</span>
+                    <span>{pk.lastUsedAt ? `Last used ${timeFmt.format(new Date(pk.lastUsedAt))}` : 'Never used'}</span>
+                  </div>
+                </div>
+
+                {editingId !== pk.id && (
+                  <div className="flex items-center gap-2">
+                    <button
+                      type="button"
+                      onClick={() => startRename(pk)}
+                      disabled={busyId === pk.id}
+                      className="py-1.5 px-3 rounded-md border border-gray-300 text-sm text-gray-700 hover:bg-gray-50 disabled:opacity-60"
+                      aria-label={`Rename ${pk.name}`}
+                    >
+                      Rename
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => setConfirmDelete(pk)}
+                      disabled={busyId === pk.id || isLastSignInMethod}
+                      title={isLastSignInMethod ? 'Add another passkey before deleting your only one' : undefined}
+                      className="py-1.5 px-3 rounded-md border border-red-300 text-sm text-red-700 hover:bg-red-50 disabled:opacity-50 disabled:cursor-not-allowed"
+                      aria-label={`Delete ${pk.name}`}
+                    >
+                      {busyId === pk.id ? 'Deleting…' : 'Delete'}
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+
+        {isLastSignInMethod && passkeys.length === 1 && (
+          <p className="px-6 pb-6 text-xs text-gray-500">
+            This passkey is your only way to sign in. Create another passkey (for example on your phone or a security key) before deleting it.
+          </p>
+        )}
+      </section>
+
+      <section aria-labelledby="password-heading" className="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
+        <h2 id="password-heading" className="text-xl font-bold text-gray-900">Password</h2>
+        <p className="mt-1 text-sm text-gray-600">
+          {user.hasPassword
+            ? 'Your account also has a password. You can keep using it as a fallback on devices without your passkeys.'
+            : 'Your account is passwordless — you sign in with passkeys only.'}
+        </p>
+      </section>
+
+      {confirmDelete && (
+        <ConfirmDialog
+          title="Delete passkey?"
+          confirmLabel="Delete passkey"
+          onConfirm={() => deletePasskey(confirmDelete)}
+          onCancel={() => setConfirmDelete(null)}
+        >
+          You won’t be able to sign in with <strong>{confirmDelete.name}</strong> anymore.
+          {confirmDelete.synced && ' The passkey may remain in your password manager until you remove it there.'}
+        </ConfirmDialog>
+      )}
+
+      <ReauthDialog
+        open={reauth !== null}
+        username={user.username}
+        canUsePasskey={passkeys.length > 0}
+        canUsePassword={user.hasPassword}
+        action={reauth?.action ?? 'continue'}
+        onCancel={() => setReauth(null)}
+        onSuccess={async () => {
+          const pending = reauth;
+          setReauth(null);
+          if (!pending) return;
+          if (pending.needsGesture) {
+            setResume(pending);
+            return;
+          }
+          try {
+            await pending.run();
+          } catch (err) {
+            reportError(err);
+          }
+        }}
+      />
+    </div>
+  );
+}
+
+function ConfirmDialog({
+  title,
+  confirmLabel,
+  children,
+  onConfirm,
+  onCancel,
+}: {
+  title: string;
+  confirmLabel: string;
+  children: React.ReactNode;
+  onConfirm: () => void;
+  onCancel: () => void;
+}) {
+  const ref = useRef<HTMLDialogElement>(null);
+  useEffect(() => {
+    ref.current?.showModal();
+  }, []);
+  return (
+    <dialog
+      ref={ref}
+      onCancel={(e) => { e.preventDefault(); onCancel(); }}
+      aria-labelledby="confirm-title"
+      className="m-auto w-full max-w-sm rounded-lg p-6 shadow-xl backdrop:bg-black/50"
+    >
+      <h2 id="confirm-title" className="text-lg font-bold text-gray-900">{title}</h2>
+      <p className="mt-2 text-sm text-gray-600">{children}</p>
+      <div className="mt-6 flex justify-end gap-2">
+        <button type="button" onClick={onCancel} className="py-2 px-4 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100">
+          Cancel
+        </button>
+        <button type="button" onClick={onConfirm} autoFocus className="py-2 px-4 rounded-md text-sm font-medium text-white bg-red-600 hover:bg-red-700">
+          {confirmLabel}
+        </button>
+      </div>
+    </dialog>
+  );
+}
