new file mode 100644
index 0000000..5bd70b7
--- /dev/null
+++ b/src/components/auth/Alert.tsx
@@ -0,0 +1,15 @@
+import type { ReactNode } from 'react';
+
+const STYLES = {
+  error: 'text-red-700 bg-red-100',
+  success: 'text-green-700 bg-green-100',
+  info: 'text-gray-700 bg-gray-100',
+};
+
+export default function Alert({ kind, children }: { kind: keyof typeof STYLES; children: ReactNode }) {
+  return (
+    <div className={`mb-4 p-3 text-sm rounded-lg ${STYLES[kind]}`} role={kind === 'error' ? 'alert' : 'status'} aria-live="polite">
+      {children}
+    </div>
+  );
+}
