@@ -0,0 +1,90 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse, type RegistrationResponseJSON } from '@simplewebauthn/server';
+import {
+  consumeChallenge,
+  currentUser,
+  error,
+  isRecentlyAuthenticated,
+  json,
+  publicPasskey,
+  publicUser,
+  readJson,
+  reauthRequired,
+  relyingParty,
+  signIn,
+} from '../../../../lib/auth/server';
+import { addPasskey, createUser, listPasskeys, UsernameTakenError } from '../../../../lib/auth/store';
+import { providerName } from '../../../../lib/auth/aaguids';
+
+export const POST: APIRoute = async (context) => {
+  const body = await readJson<{ response?: RegistrationResponseJSON }>(context.request);
+  if (!body.response) return error(400, 'invalid_request', 'Missing registration response.');
+
+  const challenge = await consumeChallenge(context, 'register');
+  if (!challenge) return error(400, 'challenge_expired', 'This request expired. Please try again.');
+
+  const { rpID, origins } = relyingParty(context);
+  let user = await currentUser(context);
+
+  if (user && challenge.pendingUser) return error(400, 'invalid_state', 'Already signed in.');
+  if (!user && !challenge.pendingUser) return error(401, 'not_signed_in', 'Please sign in first.');
+  if (user && !(await isRecentlyAuthenticated(context))) return reauthRequired();
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body.response,
+      expectedChallenge: challenge.value,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      // Conditional create may complete without a gesture or user verification.
+      requireUserPresence: !challenge.conditional,
+      requireUserVerification: false,
+    });
+  } catch (err: any) {
+    return error(400, 'verification_failed', err?.message ?? 'Passkey verification failed.');
+  }
+  if (!verification.verified) return error(400, 'verification_failed', 'Passkey verification failed.');
+
+  const info = verification.registrationInfo;
+
+  if (!user) {
+    try {
+      user = await createUser(challenge.pendingUser!.username, {
+        hasPassword: false,
+        webauthnUserID: challenge.pendingUser!.webauthnUserID,
+      });
+    } catch (err) {
+      if (err instanceof UsernameTakenError) {
+        return error(409, 'username_taken', 'That username was just taken. Please choose another.');
+      }
+      throw err;
+    }
+    await signIn(context, user);
+  }
+
+  const existing = await listPasskeys(user.id);
+  const baseName = providerName(info.aaguid) ?? 'Passkey';
+  const sameName = existing.filter((p) => p.name === baseName || p.name.startsWith(`${baseName} (`)).length;
+
+  let record;
+  try {
+    record = await addPasskey({
+      id: info.credential.id,
+      userId: user.id,
+      publicKey: Buffer.from(info.credential.publicKey).toString('base64url'),
+      counter: info.credential.counter,
+      transports: info.credential.transports ?? body.response.response.transports,
+      deviceType: info.credentialDeviceType,
+      backedUp: info.credentialBackedUp,
+      aaguid: info.aaguid,
+      name: sameName ? `${baseName} (${sameName + 1})` : baseName,
+      createdAt: new Date().toISOString(),
+      lastUsedAt: null,
+    });
+  } catch {
+    return error(409, 'already_registered', 'This passkey is already registered.');
+  }
+
+  return json({ user: publicUser(user), passkey: publicPasskey(record), rpID });
+};
diff --git a/src/pages/api/auth/passkeys/[id].ts b/src/pages/api/auth/passkeys/[id].ts
