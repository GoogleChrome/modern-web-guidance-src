@@ -0,0 +1,83 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse, type AuthenticationResponseJSON } from '@simplewebauthn/server';
+import {
+  consumeChallenge,
+  currentUser,
+  error,
+  json,
+  markReauthenticated,
+  publicUser,
+  readJson,
+  relyingParty,
+  signIn,
+} from '../../../../lib/auth/server';
+import { findPasskey, findUserById, updatePasskey } from '../../../../lib/auth/store';
+
+export const POST: APIRoute = async (context) => {
+  const { response, purpose = 'login' } = await readJson<{
+    response?: AuthenticationResponseJSON;
+    purpose?: 'login' | 'reauth';
+  }>(context.request);
+  if (!response) return error(400, 'invalid_request', 'Missing authentication response.');
+
+  const challenge = await consumeChallenge(context, purpose);
+  if (!challenge) return error(400, 'challenge_expired', 'This request expired. Please try again.');
+
+  const { rpID, origins } = relyingParty(context);
+  const passkey = await findPasskey(response.id);
+  if (!passkey) {
+    // Lets the client signal the authenticator to hide this stale passkey.
+    return error(404, 'unknown_credential', 'This passkey isn’t registered with The DevTools Times anymore.', {
+      rpID,
+      credentialID: response.id,
+    });
+  }
+
+  const owner = await findUserById(passkey.userId);
+  if (!owner) return error(404, 'unknown_credential', 'This passkey’s account no longer exists.', { rpID, credentialID: response.id });
+
+  if (response.response.userHandle && response.response.userHandle !== owner.webauthnUserID) {
+    return error(400, 'verification_failed', 'Passkey does not match this account.');
+  }
+
+  if (purpose === 'reauth') {
+    const user = await currentUser(context);
+    if (!user) return error(401, 'not_signed_in', 'Please sign in first.');
+    if (user.id !== owner.id) return error(403, 'wrong_account', 'That passkey belongs to a different account.');
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: challenge.value,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      credential: {
+        id: passkey.id,
+        publicKey: Buffer.from(passkey.publicKey, 'base64url'),
+        counter: passkey.counter,
+        transports: passkey.transports,
+      },
+      requireUserVerification: purpose === 'reauth',
+    });
+  } catch (err: any) {
+    return error(400, 'verification_failed', err?.message ?? 'Passkey verification failed.');
+  }
+  if (!verification.verified) return error(400, 'verification_failed', 'Passkey verification failed.');
+
+  const info = verification.authenticationInfo;
+  await updatePasskey(passkey.id, owner.id, {
+    counter: info.newCounter,
+    backedUp: info.credentialBackedUp,
+    deviceType: info.credentialDeviceType,
+    lastUsedAt: new Date().toISOString(),
+  });
+
+  if (purpose === 'reauth') {
+    markReauthenticated(context);
+  } else {
+    await signIn(context, owner);
+  }
+  return json({ user: publicUser(owner), rpID });
+};
diff --git a/src/pages/api/auth/passkey/registration-options.ts b/src/pages/api/auth/passkey/registration-options.ts
