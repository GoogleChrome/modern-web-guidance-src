+import type { APIRoute } from 'astro';
+import { error, json, publicUser, readJson, signIn, upstreamPasswordCall } from '../../../../lib/auth/server';
+import { createUser, findUserByUsername, UsernameTakenError } from '../../../../lib/auth/store';
+
+export const POST: APIRoute = async (context) => {
+  const { username, password } = await readJson<{ username?: string; password?: string }>(context.request);
+  if (!username?.trim() || !password) {
+    return error(400, 'invalid_request', 'Username and password are required.');
+  }
+  if (await findUserByUsername(username)) {
+    return error(409, 'username_taken', 'Registration failed: that username is already taken.');
+  }
+
+  const result = await upstreamPasswordCall('register', username.trim(), password);
+  if (!result.ok) {
+    return error(result.status === 502 ? 502 : 400, 'registration_failed', `Registration failed: ${result.message}`);
+  }
+
+  try {
+    const user = await createUser(username, { hasPassword: true });
+    await signIn(context, user);
+    return json({ user: publicUser(user) });
+  } catch (err) {
+    if (err instanceof UsernameTakenError) {
+      return error(409, 'username_taken', 'Registration failed: that username is already taken.');
+    }
+    throw err;
+  }
+};
