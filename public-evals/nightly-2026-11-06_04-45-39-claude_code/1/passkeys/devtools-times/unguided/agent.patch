@@ -0,0 +1,63 @@
+import { useState } from 'react';
+import PasskeyIcon from './PasskeyIcon';
+import Alert from './Alert';
+import { CeremonyCancelledError, registerPasskey } from '../../lib/auth/client';
+
+interface Props {
+  title?: string;
+  onDone: (created: boolean) => void;
+}
+
+/** Offered right after a password sign-in / sign-up to upgrade the account to a passkey. */
+export default function PasskeyUpgradePrompt({ title = 'Sign in faster next time', onDone }: Props) {
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const create = async () => {
+    setBusy(true);
+    setError(null);
+    try {
+      await registerPasskey();
+      onDone(true);
+    } catch (err) {
+      if (!(err instanceof CeremonyCancelledError)) {
+        setError(err instanceof Error ? err.message : 'Could not create a passkey.');
+      }
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="text-center">
+      <div className="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-gray-100 text-gray-900">
+        <PasskeyIcon className="h-8 w-8" />
+      </div>
+      <h3 className="text-xl font-bold text-gray-900">{title}</h3>
+      <p className="mt-2 text-sm text-gray-600">
+        Create a passkey to sign in with your fingerprint, face, or screen lock instead of typing a password.
+        Passkeys are phishing-resistant and sync across your devices with your password manager.
+      </p>
+      <div className="mt-5 text-left">{error && <Alert kind="error">{error}</Alert>}</div>
+      <div className="space-y-2">
+        <button
+          type="button"
+          onClick={create}
+          disabled={busy}
+          className="w-full inline-flex items-center justify-center gap-2 py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75"
+        >
+          <PasskeyIcon />
+          {busy ? 'Creating passkey…' : 'Create a passkey'}
+        </button>
+        <button
+          type="button"
+          onClick={() => onDone(false)}
+          disabled={busy}
+          className="w-full py-2 px-4 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100"
+        >
+          Not now
+        </button>
+      </div>
+    </div>
+  );
+}
