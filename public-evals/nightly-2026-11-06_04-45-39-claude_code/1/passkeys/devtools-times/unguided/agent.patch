@@ -0,0 +1,26 @@
+import type { APIRoute } from 'astro';
+import { error, json, publicUser, readJson, signIn, upstreamPasswordCall } from '../../../../lib/auth/server';
+import { createUser, findUserByUsername, listPasskeys } from '../../../../lib/auth/store';
+
+export const POST: APIRoute = async (context) => {
+  const { username, password } = await readJson<{ username?: string; password?: string }>(context.request);
+  if (!username?.trim() || !password) {
+    return error(400, 'invalid_request', 'Username and password are required.');
+  }
+
+  const result = await upstreamPasswordCall('login', username.trim(), password);
+  if (!result.ok) {
+    return error(result.status === 502 ? 502 : 401, 'login_failed', `Login failed: ${result.message}`);
+  }
+
+  let user = await findUserByUsername(username);
+  if (user && !user.hasPassword) {
+    // A passkey-only account already owns this username locally.
+    return error(409, 'account_conflict', 'This username belongs to a passkey account. Sign in with your passkey instead.');
+  }
+  user ??= await createUser(username, { hasPassword: true });
+
+  await signIn(context, user);
+  const passkeys = await listPasskeys(user.id);
+  return json({ user: publicUser(user), passkeyCount: passkeys.length });
+};
