--- /dev/null
+++ b/src/pages/api/auth/passkeys/[id].ts
@@ -0,0 +1,44 @@
+import type { APIRoute } from 'astro';
+import {
+  currentUser,
+  error,
+  isRecentlyAuthenticated,
+  json,
+  publicPasskey,
+  readJson,
+  reauthRequired,
+  relyingParty,
+} from '../../../../lib/auth/server';
+import { deletePasskey, listPasskeys, updatePasskey } from '../../../../lib/auth/store';
+
+export const PATCH: APIRoute = async (context) => {
+  const user = await currentUser(context);
+  if (!user) return error(401, 'not_signed_in', 'Please sign in first.');
+  const { name } = await readJson<{ name?: string }>(context.request);
+  const trimmed = typeof name === 'string' ? name.trim() : '';
+  if (!trimmed || trimmed.length > 64) return error(400, 'invalid_name', 'Names must be 1–64 characters.');
+  const updated = await updatePasskey(context.params.id!, user.id, { name: trimmed });
+  if (!updated) return error(404, 'not_found', 'Passkey not found.');
+  return json({ passkey: publicPasskey(updated) });
+};
+
+export const DELETE: APIRoute = async (context) => {
+  const user = await currentUser(context);
+  if (!user) return error(401, 'not_signed_in', 'Please sign in first.');
+  if (!(await isRecentlyAuthenticated(context))) return reauthRequired();
+
+  const passkeys = await listPasskeys(user.id);
+  const target = passkeys.find((p) => p.id === context.params.id);
+  if (!target) return error(404, 'not_found', 'Passkey not found.');
+  if (!user.hasPassword && passkeys.length === 1) {
+    return error(400, 'last_credential', 'You can’t delete your only passkey — you’d have no way to sign in. Add another passkey first.');
+  }
+
+  await deletePasskey(target.id, user.id);
+  return json({
+    deleted: target.id,
+    rpID: relyingParty(context).rpID,
+    userID: user.webauthnUserID,
+    remainingCredentialIDs: passkeys.filter((p) => p.id !== target.id).map((p) => p.id),
+  });
+};
