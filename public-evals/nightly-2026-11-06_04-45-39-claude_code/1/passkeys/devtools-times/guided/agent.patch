--- /dev/null
+++ b/src/lib/auth/aaguid.ts
@@ -0,0 +1,46 @@
+/**
+ * Resolves passkey provider names/icons from the community AAGUID registry.
+ * AAGUIDs are used for UX hints only — never for security decisions.
+ */
+const REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+type Registry = Record<string, { name: string; icon_light?: string; icon_dark?: string }>;
+
+let registryPromise: Promise<Registry> | null = null;
+
+function loadRegistry(): Promise<Registry> {
+  if (!registryPromise) {
+    registryPromise = fetch(REGISTRY_URL, { signal: AbortSignal.timeout(5000) })
+      .then((res) => (res.ok ? (res.json() as Promise<Registry>) : {}))
+      .catch(() => {
+        registryPromise = null; // retry on next registration
+        return {};
+      });
+  }
+  return registryPromise;
+}
+
+function deviceNameFromUserAgent(ua: string | null): string | undefined {
+  if (!ua) return undefined;
+  if (/iPhone|iPad/.test(ua)) return 'Passkey on iOS';
+  if (/Android/.test(ua)) return 'Passkey on Android';
+  if (/Mac OS X/.test(ua)) return 'Passkey on macOS';
+  if (/Windows/.test(ua)) return 'Passkey on Windows';
+  if (/CrOS/.test(ua)) return 'Passkey on ChromeOS';
+  if (/Linux/.test(ua)) return 'Passkey on Linux';
+  return undefined;
+}
+
+export async function resolveProvider(aaguid: string, userAgent: string | null) {
+  if (aaguid === ZERO_AAGUID) {
+    return { name: deviceNameFromUserAgent(userAgent) ?? 'Unknown passkey provider', providerIcon: undefined };
+  }
+  const provider = (await loadRegistry())[aaguid];
+  return {
+    name: provider?.name ?? 'Unknown passkey provider',
+    providerIcon: provider ? { light: provider.icon_light, dark: provider.icon_dark } : undefined,
+  };
+}
diff --git a/src/lib/auth/config.ts b/src/lib/auth/config.ts
new file mode 100644
index 0000000..b160d3e
--- /dev/null
+++ b/src/lib/auth/config.ts
@@ -0,0 +1,40 @@
+/**
+ * Relying Party configuration for WebAuthn / passkeys.
+ *
+ * The RP ID is a predefined server-side constant. Set `RP_ID` (e.g.
+ * `astro-news-pytrpecapa-uc.a.run.app`) and `RP_ORIGINS` (comma-separated list
+ * of allowed origins, e.g. `https://astro-news-pytrpecapa-uc.a.run.app`) in
+ * production. When unset (local development) the values fall back to the
+ * request's own host so `http://localhost` works out of the box.
+ *
+ * The client never derives the RP ID itself; it always reads it from the
+ * options/responses returned by these endpoints.
+ */
+export const RP_NAME = 'The DevTools Times';
+
+/** Upstream account service that owns username/password accounts. */
+export const ACCOUNT_SERVICE_URL =
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+/** How long a successful reauthentication unlocks sensitive actions. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+/** How long after a password sign-in a conditional (silent) passkey create is accepted. */
+export const CONDITIONAL_CREATE_WINDOW_MS = 5 * 60 * 1000;
+
+function env(name: string): string | undefined {
+  const value = process.env[name] ?? (import.meta.env as Record<string, string | undefined>)[name];
+  return value && value.trim() ? value.trim() : undefined;
+}
+
+export function getRpId(url: URL): string {
+  return env('RP_ID') ?? url.hostname;
+}
+
+export function getExpectedOrigins(url: URL): string[] {
+  const configured = env('RP_ORIGINS');
+  if (configured) {
+    return configured.split(',').map((o) => o.trim()).filter(Boolean);
+  }
+  return [url.origin];
+}
diff --git a/src/lib/auth/http.ts b/src/lib/auth/http.ts
new file mode 100644
index 0000000..16e91d1
--- /dev/null
+++ b/src/lib/auth/http.ts
@@ -0,0 +1,40 @@
+import { ACCOUNT_SERVICE_URL } from './config';
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function error(message: string, status: number, code?: string): Response {
+  return json({ error: message, ...(code && { code }) }, status);
+}
+
+export async function readJson<T>(request: Request): Promise<T | null> {
+  try {
+    return (await request.json()) as T;
+  } catch {
+    return null;
+  }
+}
+
+/** Calls the upstream username/password account service. */
+export async function callAccountService(
+  action: 'login' | 'register',
+  username: string,
+  password: string,
+): Promise<{ ok: boolean; status: number; data: any }> {
+  try {
+    const response = await fetch(`${ACCOUNT_SERVICE_URL}/${action}`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+      signal: AbortSignal.timeout(10000),
+    });
+    const data = await response.json().catch(() => ({}));
+    return { ok: response.ok, status: response.status, data };
+  } catch {
+    return { ok: false, status: 502, data: { error: 'Account service unavailable' } };
+  }
+}
