+import type { AstroSession } from 'astro';
+import { CONDITIONAL_CREATE_WINDOW_MS, REAUTH_WINDOW_MS } from './config';
+import { findUserById, type StoredUser } from './store';
+
+export type RegistrationMode = 'promotion' | 'conditional' | 'management';
+
+export interface PendingRegistration {
+  challenge: string;
+  mode: RegistrationMode;
+  userVerification: 'preferred' | 'required';
+}
+
+export interface PendingAssertion {
+  challenge: string;
+  userVerification: 'preferred' | 'required';
+}
+
+declare global {
+  namespace App {
+    interface SessionData {
+      readingList: string[];
+      userId: string;
+      /** Epoch ms of the last successful password sign-in (gates conditional create). */
+      passwordLoginAt: number;
+      /** Epoch ms of the last successful reauthentication. */
+      reauthAt: number;
+      pendingRegistration: PendingRegistration;
+      pendingLogin: PendingAssertion;
+      pendingReauth: PendingAssertion;
+    }
+  }
+}
+
+type Session = AstroSession | undefined;
+
+export async function getCurrentUser(session: Session): Promise<StoredUser | undefined> {
+  const userId = await session?.get('userId');
+  return userId ? findUserById(userId) : undefined;
+}
+
+export async function signIn(session: Session, user: StoredUser, opts: { viaPassword: boolean }) {
+  if (!session) throw new Error('Sessions are not configured.');
+  // Rotate the session ID on privilege change to prevent session fixation.
+  await session.regenerate();
+  session.set('userId', user.id);
+  // Sign-in does not count as a reauthentication; sensitive actions must step up.
+  session.delete('reauthAt');
+  if (opts.viaPassword) session.set('passwordLoginAt', Date.now());
+  else session.delete('passwordLoginAt');
+}
+
+export function signOut(session: Session) {
+  session?.destroy();
+}
+
+export async function reauthValidUntil(session: Session): Promise<number | null> {
+  const at = await session?.get('reauthAt');
+  if (!at) return null;
+  const until = at + REAUTH_WINDOW_MS;
+  return until > Date.now() ? until : null;
+}
+
+export async function hasRecentPasswordLogin(session: Session): Promise<boolean> {
+  const at = await session?.get('passwordLoginAt');
+  return !!at && Date.now() - at < CONDITIONAL_CREATE_WINDOW_MS;
+}
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..48e2dae
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,154 @@
+import { randomBytes, randomUUID } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+
+/**
+ * Tiny JSON-file backed store for local user profiles and passkey credentials.
+ * Username/password accounts live in the upstream account service; this store
+ * only keeps what is needed for passkeys (WebAuthn user handle, credentials,
+ * display name).
+ */
+
+export interface StoredUser {
+  /** Internal application user ID. */
+  id: string;
+  /** Account username (shared with the upstream account service). */
+  username: string;
+  displayName: string;
+  /** Unpadded Base64URL WebAuthn user handle (`user.id` in creation options). */
+  passkeyUserId: string;
+  createdAt: number;
+}
+
+export interface StoredPasskeyCredential {
+  /** Base64URL-encoded credential ID (unique lookup key). */
+  id: string;
+  /** Associated application user ID. */
+  passkeyUserId: string;
+  /** Base64URL-encoded COSE public key. */
+  credentialPublicKey: string;
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  /** Provider icons derived from the AAGUID registry. */
+  providerIcon?: { light?: string; dark?: string };
+  /** Provider name from the AAGUID registry, or a user-chosen nickname. */
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+interface StoreData {
+  users: StoredUser[];
+  credentials: StoredPasskeyCredential[];
+}
+
+const STORE_PATH = path.resolve(process.env.AUTH_STORE_PATH ?? '.data/auth-store.json');
+
+let cache: StoreData | null = null;
+let writeQueue: Promise<void> = Promise.resolve();
+
+async function load(): Promise<StoreData> {
+  if (cache) return cache;
+  try {
+    const raw = await readFile(STORE_PATH, 'utf8');
+    const parsed = JSON.parse(raw) as Partial<StoreData>;
+    cache = { users: parsed.users ?? [], credentials: parsed.credentials ?? [] };
+  } catch {
+    cache = { users: [], credentials: [] };
+  }
+  return cache;
+}
+
+function persist(): Promise<void> {
+  const snapshot = JSON.stringify(cache, null, 2);
+  writeQueue = writeQueue.then(async () => {
+    await mkdir(path.dirname(STORE_PATH), { recursive: true });
+    const tmp = `${STORE_PATH}.${process.pid}.tmp`;
+    await writeFile(tmp, snapshot, 'utf8');
+    await rename(tmp, STORE_PATH);
+  }).catch((err) => {
+    console.warn('Failed to persist auth store:', err);
+  });
+  return writeQueue;
+}
+
+// ---- Users ----------------------------------------------------------------
+
+export async function findUserById(id: string): Promise<StoredUser | undefined> {
+  return (await load()).users.find((u) => u.id === id);
+}
+
+export async function findUserByPasskeyUserId(passkeyUserId: string): Promise<StoredUser | undefined> {
+  return (await load()).users.find((u) => u.passkeyUserId === passkeyUserId);
+}
+
+export async function findOrCreateUser(username: string): Promise<StoredUser> {
+  const data = await load();
+  const existing = data.users.find((u) => u.username.toLowerCase() === username.toLowerCase());
+  if (existing) return existing;
+  const user: StoredUser = {
+    id: randomUUID(),
+    username,
+    displayName: username,
+    passkeyUserId: randomBytes(32).toString('base64url'),
+    createdAt: Date.now(),
+  };
+  data.users.push(user);
+  await persist();
+  return user;
+}
+
+export async function updateUser(id: string, patch: Partial<Pick<StoredUser, 'displayName'>>): Promise<StoredUser | undefined> {
+  const user = await findUserById(id);
+  if (!user) return undefined;
+  if (patch.displayName !== undefined) user.displayName = patch.displayName;
+  await persist();
+  return user;
+}
+
+// ---- Credentials ----------------------------------------------------------
+
+export async function findCredentialsByUserId(userId: string): Promise<StoredPasskeyCredential[]> {
+  return (await load()).credentials
+    .filter((c) => c.passkeyUserId === userId)
+    .sort((a, b) => b.registeredAt - a.registeredAt);
+}
+
+export async function findCredentialById(id: string): Promise<StoredPasskeyCredential | undefined> {
+  return (await load()).credentials.find((c) => c.id === id);
+}
+
+export async function saveCredential(cred: StoredPasskeyCredential): Promise<void> {
+  const data = await load();
+  const index = data.credentials.findIndex((c) => c.id === cred.id);
+  if (index === -1) data.credentials.push(cred);
+  else data.credentials[index] = cred;
+  await persist();
+}
+
+export async function deleteCredential(id: string): Promise<void> {
+  const data = await load();
+  data.credentials = data.credentials.filter((c) => c.id !== id);
+  await persist();
+}
+
+/** Client-safe view of a credential (no public key / counter). */
+export function toPublicCredential(cred: StoredPasskeyCredential) {
+  return {
+    id: cred.id,
+    name: cred.name,
+    aaguid: cred.aaguid,
+    providerIcon: cred.providerIcon,
+    credentialDeviceType: cred.credentialDeviceType,
+    credentialBackedUp: cred.credentialBackedUp,
+    transports: cred.transports,
+    registeredAt: cred.registeredAt,
+    lastUsedAt: cred.lastUsedAt,
+  };
+}
+
+export type PublicCredential = ReturnType<typeof toPublicCredential>;
diff --git a/src/lib/passkeys-client.ts b/src/lib/passkeys-client.ts
new file mode 100644
index 0000000..5cfdfdf
--- /dev/null
+++ b/src/lib/passkeys-client.ts
@@ -0,0 +1,251 @@
+/**
+ * Browser-side passkey helpers. Calls the native WebAuthn APIs directly; the
+ * `webauthn-polyfills` package backfills JSON (de)serialization and
+ * `getClientCapabilities()` for browsers that have WebAuthn but not those
+ * newer helpers.
+ */
+
+const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
+
+export const appUrl = (path: string) => `${BASE}${path.replace(/^\//, '')}`;
+
+// ---- Typings for newer WebAuthn statics (not in every TS DOM lib) ---------
+
+export interface ClientCapabilities {
+  conditionalCreate?: boolean;
+  conditionalGet?: boolean;
+  hybridTransport?: boolean;
+  passkeyPlatformAuthenticator?: boolean;
+  userVerifyingPlatformAuthenticator?: boolean;
+  relatedOrigins?: boolean;
+  signalAllAcceptedCredentials?: boolean;
+  signalCurrentUserDetails?: boolean;
+  signalUnknownCredential?: boolean;
+}
+
+interface PublicKeyCredentialStatics {
+  getClientCapabilities?: () => Promise<ClientCapabilities>;
+  parseCreationOptionsFromJSON: (json: unknown) => PublicKeyCredentialCreationOptions;
+  parseRequestOptionsFromJSON: (json: unknown) => PublicKeyCredentialRequestOptions;
+  signalUnknownCredential?: (opts: { rpId: string; credentialId: string }) => Promise<void>;
+  signalAllAcceptedCredentials?: (opts: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (opts: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+}
+
+type JsonCredential = { id: string; [key: string]: unknown };
+
+function PKC(): PublicKeyCredentialStatics | null {
+  return typeof window !== 'undefined' && 'PublicKeyCredential' in window
+    ? (window.PublicKeyCredential as unknown as PublicKeyCredentialStatics)
+    : null;
+}
+
+let polyfillPromise: Promise<unknown> | null = null;
+function ensurePolyfills() {
+  if (!polyfillPromise) polyfillPromise = import('webauthn-polyfills').catch(() => undefined);
+  return polyfillPromise;
+}
+
+/** Returns the client's passkey capabilities, or `null` when WebAuthn is unavailable. */
+export async function getCapabilities(): Promise<ClientCapabilities | null> {
+  if (!PKC() || !window.isSecureContext) return null;
+  await ensurePolyfills();
+  try {
+    return (await PKC()!.getClientCapabilities?.()) ?? {};
+  } catch {
+    return {};
+  }
+}
+
+/** Whether we should offer explicit "Create a passkey" UI. */
+export function canCreatePasskey(caps: ClientCapabilities | null): boolean {
+  if (!caps) return false;
+  // The polyfill cannot detect `passkeyPlatformAuthenticator`; fall back to UVPAA.
+  const platform = caps.passkeyPlatformAuthenticator ?? caps.userVerifyingPlatformAuthenticator;
+  return !!platform && !!caps.conditionalGet;
+}
+
+// ---- HTTP -------------------------------------------------------------------
+
+export async function api<T = any>(path: string, init: { method?: string; body?: unknown } = {}) {
+  const response = await fetch(appUrl(`api/auth/${path}`), {
+    method: init.method ?? (init.body !== undefined ? 'POST' : 'GET'),
+    headers: init.body !== undefined ? { 'Content-Type': 'application/json' } : undefined,
+    body: init.body !== undefined ? JSON.stringify(init.body) : undefined,
+    credentials: 'same-origin',
+  });
+  const data = (await response.json().catch(() => ({}))) as T & { error?: string; code?: string };
+  return { ok: response.ok, status: response.status, data };
+}
+
+// ---- Signal API -------------------------------------------------------------
+
+/** Valid unpadded Base64URL: [A-Za-z0-9_-], no padding, length % 4 !== 1. */
+export function isValidBase64Url(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+async function signalUnknownCredential(rpId: string | undefined, credentialId: string) {
+  const pkc = PKC();
+  if (!pkc?.signalUnknownCredential || !rpId || !isValidBase64Url(credentialId)) return;
+  try {
+    await pkc.signalUnknownCredential({ rpId, credentialId });
+  } catch (e) {
+    console.warn('signalUnknownCredential sync warning:', e);
+  }
+}
+
+export async function signalAcceptedCredentials(rpId: string, userId: string, credentialIds: string[]) {
+  const pkc = PKC();
+  if (!pkc?.signalAllAcceptedCredentials) return;
+  if (!rpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: invalid rpId, userId or credential IDs.');
+    return;
+  }
+  try {
+    await pkc.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds: credentialIds });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+export async function signalUserDetails(rpId: string, userId: string, name: string, displayName: string) {
+  const pkc = PKC();
+  if (!pkc?.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: invalid rpId or userId.');
+    return;
+  }
+  try {
+    await pkc.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
+
+// ---- Registration -----------------------------------------------------------
+
+export type RegistrationMode = 'promotion' | 'conditional' | 'management';
+
+export type PasskeyResult<T = unknown> =
+  | { status: 'success'; data: T }
+  | { status: 'cancelled' }
+  | { status: 'error'; message: string; code?: string };
+
+const cancelled = { status: 'cancelled' } as const;
+
+function webAuthnError(err: unknown, context: 'create' | 'get'): PasskeyResult<never> {
+  const name = (err as DOMException)?.name;
+  switch (name) {
+    case 'NotAllowedError':
+    case 'AbortError':
+      return cancelled;
+    case 'InvalidStateError':
+      return context === 'create'
+        ? { status: 'error', message: 'A passkey for this account already exists in this passkey provider.' }
+        : { status: 'error', message: 'The passkey request could not be completed.' };
+    case 'SecurityError':
+      return { status: 'error', message: 'Passkeys are not available on this site configuration (secure origin / RP ID mismatch).' };
+    default:
+      console.error(`Unexpected WebAuthn ${context} error:`, err);
+      return { status: 'error', message: 'Something went wrong with your passkey. Please try again.' };
+  }
+}
+
+/**
+ * Creates a passkey for the signed-in user.
+ * `conditional` mode uses `mediation: 'conditional'` and fails silently.
+ */
+export async function registerPasskey(
+  mode: RegistrationMode,
+  { signal }: { signal?: AbortSignal } = {},
+): Promise<PasskeyResult> {
+  const pkc = PKC();
+  if (!pkc) return { status: 'error', message: 'Passkeys are not supported in this browser.' };
+  await ensurePolyfills();
+
+  const options = await api('passkey/register-options', { body: { mode } });
+  if (!options.ok) return { status: 'error', message: options.data.error ?? 'Could not start passkey creation.' };
+
+  const publicKey = pkc.parseCreationOptionsFromJSON(options.data);
+  const rpId = publicKey.rp.id; // always the server-provided RP ID
+
+  let credential: PublicKeyCredential;
+  try {
+    credential = (await navigator.credentials.create({
+      publicKey,
+      signal,
+      ...(mode === 'conditional' && { mediation: 'conditional' as CredentialMediationRequirement }),
+    })) as PublicKeyCredential;
+  } catch (err) {
+    if (mode === 'conditional') return cancelled; // silent by design
+    return webAuthnError(err, 'create');
+  }
+
+  const encoded = (credential as unknown as { toJSON(): JsonCredential }).toJSON();
+  try {
+    const verify = await api('passkey/register-verify', { body: encoded });
+    if (!verify.ok) {
+      await signalUnknownCredential(rpId, encoded.id);
+      return { status: 'error', message: verify.data.error ?? 'The server could not verify your passkey.' };
+    }
+    return { status: 'success', data: verify.data };
+  } catch (err) {
+    console.error('Passkey registration verification failed:', err);
+    await signalUnknownCredential(rpId, encoded.id);
+    return { status: 'error', message: 'Could not reach the server to save your passkey.' };
+  }
+}
+
+// ---- Authentication ---------------------------------------------------------
+
+async function getAssertion(
+  optionsPath: string,
+  verifyPath: string,
+  { signal, conditional = false }: { signal?: AbortSignal; conditional?: boolean },
+): Promise<PasskeyResult> {
+  const pkc = PKC();
+  if (!pkc) return { status: 'error', message: 'Passkeys are not supported in this browser.' };
+  await ensurePolyfills();
+
+  const options = await api(optionsPath, { body: {} });
+  if (!options.ok) {
+    return { status: 'error', message: options.data.error ?? 'Could not start passkey verification.', code: options.data.code };
+  }
+  const publicKey = pkc.parseRequestOptionsFromJSON(options.data);
+  const rpId = publicKey.rpId;
+
+  let credential: PublicKeyCredential;
+  try {
+    credential = (await navigator.credentials.get({
+      publicKey,
+      signal,
+      ...(conditional && { mediation: 'conditional' as CredentialMediationRequirement }),
+    })) as PublicKeyCredential;
+  } catch (err) {
+    return webAuthnError(err, 'get');
+  }
+
+  const encoded = (credential as unknown as { toJSON(): JsonCredential }).toJSON();
+  try {
+    const verify = await api(verifyPath, { body: encoded });
+    if (!verify.ok) {
+      if (verify.status === 404) await signalUnknownCredential(rpId, encoded.id);
+      return { status: 'error', message: verify.data.error ?? 'Passkey verification failed.', code: verify.data.code };
+    }
+    return { status: 'success', data: verify.data };
+  } catch (err) {
+    console.error('Passkey verification request failed:', err);
+    return { status: 'error', message: 'Could not reach the server. Please try again.' };
+  }
+}
+
+/** Primary sign-in with a discoverable passkey (button or autofill). */
+export function signInWithPasskey(opts: { signal?: AbortSignal; conditional?: boolean } = {}) {
+  return getAssertion('passkey/login-options', 'passkey/login-verify', opts);
+}
+
+/** Step-up verification with one of the signed-in user's own passkeys. */
+export function reauthenticateWithPasskey(opts: { signal?: AbortSignal } = {}) {
+  return getAssertion('reauth/options', 'reauth/verify', opts);
+}
