@@ -0,0 +1,59 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse, type RegistrationResponseJSON } from '@simplewebauthn/server';
+import { resolveProvider } from '../../../../lib/auth/aaguid';
+import { getExpectedOrigins, getRpId } from '../../../../lib/auth/config';
+import { error, json, readJson } from '../../../../lib/auth/http';
+import { getCurrentUser } from '../../../../lib/auth/session';
+import { findCredentialById, saveCredential, toPublicCredential } from '../../../../lib/auth/store';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return error('Not signed in.', 401, 'unauthenticated');
+
+  const pending = await session!.get('pendingRegistration');
+  session!.delete('pendingRegistration'); // challenges are single-use
+  if (!pending) return error('No registration in progress.', 400);
+
+  const response = await readJson<RegistrationResponseJSON>(request);
+  if (!response) return error('Invalid request body.', 400);
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: getExpectedOrigins(url),
+      expectedRPID: getRpId(url),
+      // Only conditional (silent) creation may omit user presence.
+      requireUserPresence: pending.mode !== 'conditional',
+      // 'preferred' UV must not fail authenticators without a screen lock.
+      requireUserVerification: pending.userVerification === 'required',
+    });
+  } catch (err) {
+    return error(`Passkey verification failed: ${(err as Error).message}`, 400);
+  }
+
+  if (!verification.verified) return error('Passkey verification failed.', 400);
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  if (await findCredentialById(credential.id)) return error('This passkey is already registered.', 409);
+
+  const provider = await resolveProvider(aaguid, request.headers.get('user-agent'));
+  const stored = {
+    id: credential.id,
+    passkeyUserId: user.passkeyUserId,
+    credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    credentialType: 'public-key' as const,
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    providerIcon: provider.providerIcon,
+    name: provider.name,
+    transports: credential.transports ?? response.response.transports ?? [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  };
+  await saveCredential(stored);
+
+  return json({ credential: toPublicCredential(stored) });
+};
diff --git a/src/pages/api/auth/passkeys/[id].ts b/src/pages/api/auth/passkeys/[id].ts
