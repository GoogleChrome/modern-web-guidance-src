+import type { APIRoute } from 'astro';
+import { getRpId } from '../../../../lib/auth/config';
+import { error, json } from '../../../../lib/auth/http';
+import { getCurrentUser, reauthValidUntil } from '../../../../lib/auth/session';
+import { findCredentialsByUserId, toPublicCredential } from '../../../../lib/auth/store';
+
+/** Lists the signed-in user's passkeys with the server RP ID and WebAuthn user handle. */
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return error('Not signed in.', 401, 'unauthenticated');
+
+  const credentials = await findCredentialsByUserId(user.passkeyUserId);
+  return json({
+    rpId: getRpId(url),
+    userId: user.passkeyUserId,
+    user: { username: user.username, displayName: user.displayName },
+    credentials: credentials.map(toPublicCredential),
+    reauthValidUntil: await reauthValidUntil(session),
+  });
+};
