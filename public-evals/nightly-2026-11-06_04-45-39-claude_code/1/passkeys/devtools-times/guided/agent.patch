@@ -0,0 +1,23 @@
+import type { APIRoute } from 'astro';
+import { callAccountService, error, json, readJson } from '../../../lib/auth/http';
+import { signIn } from '../../../lib/auth/session';
+import { findOrCreateUser } from '../../../lib/auth/store';
+
+/**
+ * Account creation, proxied to the upstream account service. On success the new
+ * user is signed in so the UI can immediately offer passkey creation.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await readJson<{ username?: string; password?: string }>(request);
+  const username = body?.username?.trim();
+  if (!username || !body?.password) return error('Username and password are required.', 400);
+
+  const result = await callAccountService('register', username, body.password);
+  if (!result.ok) {
+    return json({ error: result.data?.error ?? 'Unknown error' }, result.status >= 400 ? result.status : 400);
+  }
+
+  const user = await findOrCreateUser(username);
+  await signIn(session, user, { viaPassword: true });
+  return json({ user: { username: user.username, displayName: user.displayName } });
+};
