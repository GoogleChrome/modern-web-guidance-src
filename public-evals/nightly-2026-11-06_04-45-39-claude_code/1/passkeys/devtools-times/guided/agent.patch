@@ -0,0 +1,40 @@
+import type { APIRoute } from 'astro';
+import { error, json, readJson } from '../../../../lib/auth/http';
+import { getCurrentUser, reauthValidUntil } from '../../../../lib/auth/session';
+import { deleteCredential, findCredentialById, saveCredential, toPublicCredential } from '../../../../lib/auth/store';
+
+async function ownedCredential(session: Parameters<typeof getCurrentUser>[0], id: string | undefined) {
+  const user = await getCurrentUser(session);
+  if (!user) return { failure: error('Not signed in.', 401, 'unauthenticated') };
+  const cred = id ? await findCredentialById(id) : undefined;
+  if (!cred || cred.passkeyUserId !== user.passkeyUserId) {
+    return { failure: error('Passkey not found.', 404) };
+  }
+  return { cred };
+}
+
+/** Rename a passkey (server-side label only). */
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const { cred, failure } = await ownedCredential(session, params.id);
+  if (failure) return failure;
+
+  const body = await readJson<{ name?: string }>(request);
+  const name = body?.name?.trim();
+  if (!name || name.length > 64) return error('Name must be between 1 and 64 characters.', 400);
+
+  cred!.name = name;
+  await saveCredential(cred!);
+  return json({ credential: toPublicCredential(cred!) });
+};
+
+/** Delete a passkey (sensitive: requires recent reauthentication). */
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const { cred, failure } = await ownedCredential(session, params.id);
+  if (failure) return failure;
+  if (!(await reauthValidUntil(session))) {
+    return error('Please verify your identity to continue.', 403, 'reauth_required');
+  }
+
+  await deleteCredential(cred!.id);
+  return json({ success: true });
+};
