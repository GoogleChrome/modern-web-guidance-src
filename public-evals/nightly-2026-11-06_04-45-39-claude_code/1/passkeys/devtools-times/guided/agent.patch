diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..1539b9d
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,510 @@
+import React, { useEffect, useId, useRef, useState } from 'react';
+import {
+  api,
+  appUrl,
+  canCreatePasskey,
+  getCapabilities,
+  reauthenticateWithPasskey,
+  registerPasskey,
+  signalAcceptedCredentials,
+  signalUserDetails,
+} from '../lib/passkeys-client';
+import { PasskeyIcon } from './SignInForm';
+
+interface Credential {
+  id: string;
+  name: string;
+  aaguid: string;
+  providerIcon?: { light?: string; dark?: string };
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+interface PasskeyList {
+  rpId: string;
+  userId: string;
+  user: { username: string; displayName: string };
+  credentials: Credential[];
+  reauthValidUntil: number | null;
+}
+
+type Notice = { kind: 'success' | 'error'; text: string } | null;
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+const formatDate = (epoch: number) => dateFormat.format(new Date(epoch));
+
+const buttonPrimary =
+  'inline-flex items-center justify-center gap-2 py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed';
+const buttonSecondary =
+  'inline-flex items-center justify-center gap-2 py-1.5 px-3 rounded-md border border-gray-300 text-sm font-medium text-gray-800 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed';
+const buttonDanger =
+  'inline-flex items-center justify-center gap-2 py-1.5 px-3 rounded-md border border-red-300 text-sm font-medium text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-600 disabled:opacity-60 disabled:cursor-not-allowed';
+const inputClass =
+  'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500';
+
+export default function AccountSettings() {
+  const [data, setData] = useState<PasskeyList | null>(null);
+  const [loadError, setLoadError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<Notice>(null);
+  const [canCreate, setCanCreate] = useState(false);
+  const [webAuthnAvailable, setWebAuthnAvailable] = useState(false);
+  const [busy, setBusy] = useState<string | null>(null);
+  const [renamingId, setRenamingId] = useState<string | null>(null);
+  const [renameValue, setRenameValue] = useState('');
+  const [displayName, setDisplayName] = useState('');
+
+  const reauth = useReauthDialog(data?.credentials.length ?? 0, webAuthnAvailable);
+
+  const load = async (): Promise<PasskeyList | null> => {
+    const response = await api<PasskeyList>('passkeys');
+    if (response.status === 401) {
+      window.location.assign(appUrl('signin'));
+      return null;
+    }
+    if (!response.ok) {
+      setLoadError(response.data.error ?? 'Could not load your account.');
+      return null;
+    }
+    setData(response.data);
+    return response.data;
+  };
+
+  useEffect(() => {
+    getCapabilities().then((caps) => {
+      setWebAuthnAvailable(!!caps);
+      setCanCreate(canCreatePasskey(caps));
+    });
+    load().then((list) => {
+      if (!list) return;
+      setDisplayName(list.user.displayName);
+      // Keep password managers in sync with the server's accepted passkeys.
+      signalAcceptedCredentials(list.rpId, list.userId, list.credentials.map((c) => c.id));
+    });
+  }, []);
+
+  const handleCreate = async () => {
+    setNotice(null);
+    setBusy('create');
+    // Management flow: security keys allowed (no authenticatorAttachment).
+    const result = await registerPasskey('management');
+    setBusy(null);
+    if (result.status === 'success') {
+      setNotice({ kind: 'success', text: 'Passkey created.' });
+      await load();
+    } else if (result.status === 'error') {
+      setNotice({ kind: 'error', text: result.message });
+    }
+  };
+
+  const startRename = (cred: Credential) => {
+    setRenamingId(cred.id);
+    setRenameValue(cred.name);
+  };
+
+  const handleRename = async (e: React.FormEvent, cred: Credential) => {
+    e.preventDefault();
+    setBusy(`rename:${cred.id}`);
+    const response = await api(`passkeys/${encodeURIComponent(cred.id)}`, { method: 'PUT', body: { name: renameValue } });
+    setBusy(null);
+    if (response.ok) {
+      setRenamingId(null);
+      setNotice({ kind: 'success', text: 'Passkey renamed.' });
+      await load();
+    } else {
+      setNotice({ kind: 'error', text: response.data.error ?? 'Could not rename passkey.' });
+    }
+  };
+
+  const handleDelete = async (cred: Credential) => {
+    setNotice(null);
+    if (!window.confirm(`Delete the passkey “${cred.name}”? You won't be able to sign in with it anymore.`)) return;
+
+    // Deleting a passkey is sensitive: step up with a recent reauthentication.
+    const verified = await reauth.ensure(data?.reauthValidUntil ?? null, `delete “${cred.name}”`);
+    if (!verified) return;
+
+    setBusy(`delete:${cred.id}`);
+    let response = await api(`passkeys/${encodeURIComponent(cred.id)}`, { method: 'DELETE' });
+    if (response.status === 403 && response.data.code === 'reauth_required') {
+      // Server-side window expired; ask again.
+      setBusy(null);
+      if (!(await reauth.ensure(null, `delete “${cred.name}”`))) return;
+      setBusy(`delete:${cred.id}`);
+      response = await api(`passkeys/${encodeURIComponent(cred.id)}`, { method: 'DELETE' });
+    }
+    setBusy(null);
+
+    if (!response.ok) {
+      setNotice({ kind: 'error', text: response.data.error ?? 'Could not delete passkey.' });
+      return;
+    }
+    setNotice({
+      kind: 'success',
+      text: 'Passkey deleted. You may also want to remove it from your password manager.',
+    });
+    const list = await load();
+    if (list) await signalAcceptedCredentials(list.rpId, list.userId, list.credentials.map((c) => c.id));
+  };
+
+  const handleProfile = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!data) return;
+    setNotice(null);
+    setBusy('profile');
+    const response = await api<{ username: string; displayName: string; rpId: string; userId: string }>('account', {
+      method: 'PUT',
+      body: { displayName },
+    });
+    setBusy(null);
+    if (!response.ok) {
+      setNotice({ kind: 'error', text: response.data.error ?? 'Could not update your profile.' });
+      return;
+    }
+    const { rpId, userId, username, displayName: updated } = response.data;
+    setData({ ...data, user: { username, displayName: updated } });
+    setNotice({ kind: 'success', text: 'Display name updated.' });
+    // Update the account details shown by password managers.
+    await signalUserDetails(rpId, userId, username, updated);
+  };
+
+  const handleSignOut = async () => {
+    await api('logout', { body: {} });
+    window.location.assign(appUrl(''));
+  };
+
+  if (loadError) {
+    return (
+      <div className="max-w-2xl mx-auto mt-10 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+        {loadError}
+      </div>
+    );
+  }
+
+  if (!data) {
+    return <p className="max-w-2xl mx-auto mt-10 text-sm text-gray-500" role="status">Loading your account…</p>;
+  }
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-8">
+      <div className="flex flex-wrap items-end justify-between gap-4 border-b border-gray-300 pb-4">
+        <div>
+          <h1 className="text-3xl font-bold text-gray-900">Account settings</h1>
+          <p className="mt-1 text-sm text-gray-600">
+            Signed in as <strong>{data.user.username}</strong>
+          </p>
+        </div>
+        <button type="button" onClick={handleSignOut} className={buttonSecondary}>
+          Sign out
+        </button>
+      </div>
+
+      <div aria-live="polite">
+        {notice && (
+          <div
+            className={`p-3 text-sm rounded-lg ${notice.kind === 'success' ? 'text-green-700 bg-green-100' : 'text-red-700 bg-red-100'}`}
+            role={notice.kind === 'error' ? 'alert' : 'status'}
+          >
+            {notice.text}
+          </div>
+        )}
+      </div>
+
+      {/* Profile */}
+      <section aria-labelledby="profile-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 id="profile-heading" className="text-xl font-bold text-gray-900">Profile</h2>
+        <form onSubmit={handleProfile} className="mt-4 grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end">
+          <div>
+            <label htmlFor="display-name" className="block text-sm font-medium text-gray-700 mb-1">
+              Display name
+            </label>
+            <input
+              id="display-name"
+              name="displayName"
+              autoComplete="name"
+              maxLength={64}
+              required
+              value={displayName}
+              onChange={(e) => setDisplayName(e.target.value)}
+              className={inputClass}
+            />
+          </div>
+          <button type="submit" className={buttonPrimary} disabled={busy === 'profile' || displayName.trim() === data.user.displayName}>
+            {busy === 'profile' ? 'Saving…' : 'Save'}
+          </button>
+        </form>
+      </section>
+
+      {/* Passkeys */}
+      <section aria-labelledby="passkeys-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex flex-wrap items-start justify-between gap-4">
+          <div>
+            <h2 id="passkeys-heading" className="text-xl font-bold text-gray-900">Passkeys</h2>
+            <p className="mt-1 text-sm text-gray-600 max-w-prose">
+              Passkeys let you sign in with your fingerprint, face, screen lock, or a security key — no password needed.
+            </p>
+          </div>
+          {canCreate && (
+            <button type="button" onClick={handleCreate} disabled={busy === 'create'} className={buttonPrimary}>
+              <PasskeyIcon />
+              {busy === 'create' ? 'Creating…' : 'Create a passkey'}
+            </button>
+          )}
+        </div>
+
+        {!canCreate && (
+          <p className="mt-4 p-3 text-sm text-amber-800 bg-amber-50 rounded-lg">
+            Passkeys aren't available in this browser or on this device. Keep using a strong, unique password, or open
+            this page on a device that supports passkeys to create one.
+          </p>
+        )}
+
+        {data.credentials.length === 0 ? (
+          <p className="mt-6 text-sm text-gray-500">No passkeys found.</p>
+        ) : (
+          <ul className="mt-6 divide-y divide-gray-200 border-y border-gray-200">
+            {data.credentials.map((cred) => (
+              <li key={cred.id} className="py-4 flex flex-wrap items-center gap-4">
+                <ProviderIcon cred={cred} />
+                <div className="min-w-0 flex-1">
+                  {renamingId === cred.id ? (
+                    <form onSubmit={(e) => handleRename(e, cred)} className="flex flex-wrap gap-2">
+                      <label htmlFor={`rename-${cred.id}`} className="sr-only">
+                        Passkey name
+                      </label>
+                      <input
+                        id={`rename-${cred.id}`}
+                        value={renameValue}
+                        onChange={(e) => setRenameValue(e.target.value)}
+                        maxLength={64}
+                        required
+                        autoFocus
+                        autoComplete="off"
+                        className={`${inputClass} flex-1 min-w-40 py-1.5`}
+                      />
+                      <button type="submit" className={buttonPrimary} disabled={busy === `rename:${cred.id}`}>
+                        Save
+                      </button>
+                      <button type="button" className={buttonSecondary} onClick={() => setRenamingId(null)}>
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <>
+                      <p className="font-semibold text-gray-900 truncate">
+                        {cred.name}
+                        {cred.credentialBackedUp && (
+                          <span className="ml-2 align-middle text-xs font-medium text-green-800 bg-green-100 rounded px-1.5 py-0.5">
+                            Synced
+                          </span>
+                        )}
+                      </p>
+                      <p className="text-xs text-gray-500">
+                        Created {formatDate(cred.registeredAt)}
+                        {' · '}
+                        {cred.lastUsedAt ? `Last used ${formatDate(cred.lastUsedAt)}` : 'Never used'}
+                      </p>
+                    </>
+                  )}
+                </div>
+                {renamingId !== cred.id && (
+                  <div className="flex gap-2">
+                    <button
+                      type="button"
+                      className={buttonSecondary}
+                      onClick={() => startRename(cred)}
+                      aria-label={`Rename ${cred.name}`}
+                    >
+                      Rename
+                    </button>
+                    <button
+                      type="button"
+                      className={buttonDanger}
+                      onClick={() => handleDelete(cred)}
+                      disabled={busy === `delete:${cred.id}`}
+                      aria-label={`Delete ${cred.name}`}
+                    >
+                      {busy === `delete:${cred.id}` ? 'Deleting…' : 'Delete'}
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      {reauth.dialog}
+    </div>
+  );
+}
+
+function ProviderIcon({ cred }: { cred: Credential }) {
+  const icon = cred.providerIcon?.light ?? cred.providerIcon?.dark;
+  if (!icon) {
+    return (
+      <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-700">
+        <PasskeyIcon />
+      </span>
+    );
+  }
+  return (
+    <picture className="shrink-0">
+      {cred.providerIcon?.dark && <source srcSet={cred.providerIcon.dark} media="(prefers-color-scheme: dark)" />}
+      <img src={icon} alt="" width={40} height={40} className="h-10 w-10 rounded" />
+    </picture>
+  );
+}
+
+/**
+ * Reauthentication modal. `ensure()` resolves `true` immediately when the
+ * server reported a still-valid reauth window, otherwise opens a modal
+ * `<dialog>` that verifies the user with one of their passkeys (or their
+ * password as a fallback) and resolves once verified or dismissed.
+ */
+function useReauthDialog(passkeyCount: number, webAuthnAvailable: boolean) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const resolver = useRef<((ok: boolean) => void) | null>(null);
+  const validUntil = useRef<number | null>(null);
+  const [action, setAction] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [password, setPassword] = useState('');
+  const [pending, setPending] = useState(false);
+  const [showPassword, setShowPassword] = useState(false);
+  const titleId = useId();
+  const descId = useId();
+
+  const usePasskey = passkeyCount > 0 && webAuthnAvailable;
+
+  const settle = (ok: boolean, until?: number | null) => {
+    if (ok && until) validUntil.current = until;
+    const resolve = resolver.current;
+    resolver.current = null;
+    if (dialogRef.current?.open) dialogRef.current.close();
+    resolve?.(ok);
+  };
+
+  // Dismissed via Esc / Cancel without verifying.
+  const handleClose = () => {
+    if (dialogRef.current) dialogRef.current.returnValue = '';
+    if (resolver.current) settle(false);
+  };
+
+  const ensure = (serverValidUntil: number | null, actionLabel: string): Promise<boolean> => {
+    const until = Math.max(serverValidUntil ?? 0, validUntil.current ?? 0);
+    if (until > Date.now() + 5000) return Promise.resolve(true);
+    setAction(actionLabel);
+    setError(null);
+    setPassword('');
+    setShowPassword(!usePasskey);
+    dialogRef.current?.showModal();
+    return new Promise((resolve) => {
+      resolver.current = resolve;
+    });
+  };
+
+  const verifyWithPasskey = async () => {
+    setError(null);
+    setPending(true);
+    const result = await reauthenticateWithPasskey();
+    setPending(false);
+    if (result.status === 'success') {
+      settle(true, (result.data as { reauthValidUntil: number | null }).reauthValidUntil);
+    } else if (result.status === 'error') {
+      setError(result.message);
+    }
+  };
+
+  const verifyWithPassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setPending(true);
+    const response = await api<{ reauthValidUntil: number | null }>('reauth/password', { body: { password } });
+    setPending(false);
+    setPassword('');
+    if (response.ok) settle(true, response.data.reauthValidUntil);
+    else setError(response.data.error ?? 'Verification failed.');
+  };
+
+  const dialog = (
+    <dialog
+      ref={dialogRef}
+      onClose={handleClose}
+      aria-labelledby={titleId}
+      aria-describedby={descId}
+      className="reauth-dialog m-auto w-[min(28rem,calc(100%-2rem))] rounded-lg border border-gray-200 bg-white p-6 shadow-xl"
+    >
+      <h2 id={titleId} className="text-xl font-bold text-gray-900">Verify it's you</h2>
+      <p id={descId} className="mt-2 text-sm text-gray-600">
+        To {action || 'continue'}, confirm your identity
+        {usePasskey && !showPassword ? ' with one of your passkeys.' : ' with your password.'}
+      </p>
+
+      {error && (
+        <div className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+
+      {usePasskey && !showPassword ? (
+        <div className="mt-6 flex flex-col gap-3">
+          <button type="button" onClick={verifyWithPasskey} disabled={pending} className={buttonPrimary}>
+            <PasskeyIcon />
+            {pending ? 'Waiting for passkey…' : 'Verify with passkey'}
+          </button>
+          <button
+            type="button"
+            className="text-sm font-medium text-gray-600 underline hover:text-gray-900"
+            onClick={() => {
+              setError(null);
+              setShowPassword(true);
+            }}
+          >
+            Use your password instead
+          </button>
+        </div>
+      ) : (
+        <form onSubmit={verifyWithPassword} className="mt-6 space-y-4">
+          <div>
+            <label htmlFor={`${titleId}-password`} className="block text-sm font-medium text-gray-700 mb-1">
+              Password
+            </label>
+            <input
+              id={`${titleId}-password`}
+              type="password"
+              autoComplete="current-password"
+              required
+              value={password}
+              onChange={(e) => setPassword(e.target.value)}
+              className={inputClass}
+            />
+          </div>
+          <button type="submit" disabled={pending} className={`${buttonPrimary} w-full`}>
+            {pending ? 'Verifying…' : 'Verify'}
+          </button>
+          {usePasskey && (
+            <button
+              type="button"
+              className="block mx-auto text-sm font-medium text-gray-600 underline hover:text-gray-900"
+              onClick={() => {
+                setError(null);
+                setShowPassword(false);
+              }}
+            >
+              Use a passkey instead
+            </button>
+          )}
+        </form>
+      )}
+
+      <form method="dialog" className="mt-4 text-right">
+        <button value="cancel" className={buttonSecondary}>
+          Cancel
+        </button>
+      </form>
+    </dialog>
+  );
+
+  return { ensure, dialog };
+}
