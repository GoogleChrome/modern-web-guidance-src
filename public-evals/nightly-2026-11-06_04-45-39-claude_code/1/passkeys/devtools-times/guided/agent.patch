+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRpId } from '../../../../lib/auth/config';
+import { error, json } from '../../../../lib/auth/http';
+
+/** Discoverable-credential sign-in options (button and autofill flows). */
+export const POST: APIRoute = async ({ session, url }) => {
+  if (!session) return error('Sessions are not configured.', 500);
+  const userVerification = 'preferred' as const;
+
+  const options = await generateAuthenticationOptions({
+    rpID: getRpId(url),
+    allowCredentials: [], // discoverable: the passkey provider lists accounts
+    userVerification,
+  });
+
+  // UV expectation is kept server-side, never round-tripped via the client.
+  session.set('pendingLogin', { challenge: options.challenge, userVerification });
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkey/login-verify.ts b/src/pages/api/auth/passkey/login-verify.ts
new file mode 100644
index 0000000..b89b43e
--- /dev/null
+++ b/src/pages/api/auth/passkey/login-verify.ts
@@ -0,0 +1,51 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse, type AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { getExpectedOrigins, getRpId } from '../../../../lib/auth/config';
+import { error, json, readJson } from '../../../../lib/auth/http';
+import { signIn } from '../../../../lib/auth/session';
+import { findCredentialById, findUserByPasskeyUserId, saveCredential } from '../../../../lib/auth/store';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) return error('Sessions are not configured.', 500);
+  const pending = await session.get('pendingLogin');
+  session.delete('pendingLogin');
+  if (!pending) return error('No sign-in in progress. Please try again.', 400);
+
+  const response = await readJson<AuthenticationResponseJSON>(request);
+  if (!response?.id) return error('Invalid request body.', 400);
+
+  const cred = await findCredentialById(response.id);
+  // 404 lets the client signal the unknown credential to the passkey provider.
+  if (!cred) return error('This passkey is not registered with The DevTools Times.', 404, 'unknown_credential');
+
+  const user = await findUserByPasskeyUserId(cred.passkeyUserId);
+  if (!user) return error('This passkey is not registered with The DevTools Times.', 404, 'unknown_credential');
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: getExpectedOrigins(url),
+      expectedRPID: getRpId(url),
+      credential: {
+        id: cred.id,
+        publicKey: new Uint8Array(Buffer.from(cred.credentialPublicKey, 'base64url')),
+        counter: cred.counter,
+        transports: cred.transports as any,
+      },
+      requireUserVerification: pending.userVerification === 'required',
+    });
+  } catch (err) {
+    return error(`Passkey verification failed: ${(err as Error).message}`, 400);
+  }
+  if (!verification.verified) return error('Passkey verification failed.', 401);
+
+  cred.counter = verification.authenticationInfo.newCounter;
+  cred.credentialBackedUp = verification.authenticationInfo.credentialBackedUp;
+  cred.lastUsedAt = Date.now();
+  await saveCredential(cred);
+
+  await signIn(session, user, { viaPassword: false });
+  return json({ user: { username: user.username, displayName: user.displayName } });
+};
