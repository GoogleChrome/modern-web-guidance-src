+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse, type AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { getExpectedOrigins, getRpId } from '../../../../lib/auth/config';
+import { error, json, readJson } from '../../../../lib/auth/http';
+import { getCurrentUser, reauthValidUntil } from '../../../../lib/auth/session';
+import { findCredentialById, saveCredential } from '../../../../lib/auth/store';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return error('Not signed in.', 401, 'unauthenticated');
+
+  const pending = await session!.get('pendingReauth');
+  session!.delete('pendingReauth');
+  if (!pending) return error('No verification in progress. Please try again.', 400);
+
+  const response = await readJson<AuthenticationResponseJSON>(request);
+  if (!response?.id) return error('Invalid request body.', 400);
+
+  const cred = await findCredentialById(response.id);
+  if (!cred) return error('This passkey is not registered.', 404, 'unknown_credential');
+  // The passkey must belong to the signed-in account.
+  if (cred.passkeyUserId !== user.passkeyUserId) {
+    return error('This passkey belongs to a different account.', 403);
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: getExpectedOrigins(url),
+      expectedRPID: getRpId(url),
+      credential: {
+        id: cred.id,
+        publicKey: new Uint8Array(Buffer.from(cred.credentialPublicKey, 'base64url')),
+        counter: cred.counter,
+        transports: cred.transports as any,
+      },
+      requireUserVerification: pending.userVerification === 'required',
+    });
+  } catch (err) {
+    return error(`Verification failed: ${(err as Error).message}`, 400);
+  }
+  if (!verification.verified) return error('Verification failed.', 401);
+
+  cred.counter = verification.authenticationInfo.newCounter;
+  cred.lastUsedAt = Date.now();
+  await saveCredential(cred);
+
+  session!.set('reauthAt', Date.now());
+  return json({ reauthValidUntil: await reauthValidUntil(session) });
+};
diff --git a/src/pages/api/auth/register.ts b/src/pages/api/auth/register.ts
