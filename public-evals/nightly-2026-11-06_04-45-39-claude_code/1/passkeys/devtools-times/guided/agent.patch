+import type { APIRoute } from 'astro';
+import { callAccountService, error, json, readJson } from '../../../../lib/auth/http';
+import { getCurrentUser, reauthValidUntil } from '../../../../lib/auth/session';
+
+/** Password-based reauthentication fallback for accounts or browsers without passkeys. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return error('Not signed in.', 401, 'unauthenticated');
+
+  const body = await readJson<{ password?: string }>(request);
+  if (!body?.password) return error('Password is required.', 400);
+
+  const result = await callAccountService('login', user.username, body.password);
+  if (!result.ok) return error(`Verification failed: ${result.data?.error ?? 'Incorrect password'}`, 401);
+
+  session!.set('reauthAt', Date.now());
+  return json({ reauthValidUntil: await reauthValidUntil(session) });
+};
