--- /dev/null
+++ b/src/pages/api/auth/account.ts
@@ -0,0 +1,25 @@
+import type { APIRoute } from 'astro';
+import { getRpId } from '../../../lib/auth/config';
+import { error, json, readJson } from '../../../lib/auth/http';
+import { getCurrentUser } from '../../../lib/auth/session';
+import { updateUser } from '../../../lib/auth/store';
+
+/** Update the signed-in user's display name and return the data needed for Signal API sync. */
+export const PUT: APIRoute = async ({ request, session, url }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return error('Not signed in.', 401, 'unauthenticated');
+
+  const body = await readJson<{ displayName?: string }>(request);
+  const displayName = body?.displayName?.trim();
+  if (!displayName || displayName.length > 64) {
+    return error('Display name must be between 1 and 64 characters.', 400);
+  }
+
+  const updated = await updateUser(user.id, { displayName });
+  return json({
+    username: updated!.username,
+    displayName: updated!.displayName,
+    rpId: getRpId(url),
+    userId: updated!.passkeyUserId,
+  });
+};
diff --git a/src/pages/api/auth/login.ts b/src/pages/api/auth/login.ts
new file mode 100644
index 0000000..bfff8c2
--- /dev/null
+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,20 @@
+import type { APIRoute } from 'astro';
+import { callAccountService, error, json, readJson } from '../../../lib/auth/http';
+import { signIn } from '../../../lib/auth/session';
+import { findOrCreateUser } from '../../../lib/auth/store';
+
+/** Username/password sign-in, proxied to the upstream account service. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await readJson<{ username?: string; password?: string }>(request);
+  const username = body?.username?.trim();
+  if (!username || !body?.password) return error('Username and password are required.', 400);
+
+  const result = await callAccountService('login', username, body.password);
+  if (!result.ok) {
+    return json({ error: result.data?.error ?? 'Unknown error' }, result.status >= 400 ? result.status : 401);
+  }
+
+  const user = await findOrCreateUser(username);
+  await signIn(session, user, { viaPassword: true });
+  return json({ user: { username: user.username, displayName: user.displayName } });
+};
