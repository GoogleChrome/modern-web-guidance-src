--- /dev/null
+++ b/src/pages/api/auth/passkey/register-options.ts
@@ -0,0 +1,48 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { RP_NAME, getRpId } from '../../../../lib/auth/config';
+import { error, json, readJson } from '../../../../lib/auth/http';
+import { getCurrentUser, hasRecentPasswordLogin, type RegistrationMode } from '../../../../lib/auth/session';
+import { findCredentialsByUserId } from '../../../../lib/auth/store';
+
+const MODES: RegistrationMode[] = ['promotion', 'conditional', 'management'];
+
+/**
+ * Generates passkey creation options for the signed-in user.
+ * - `promotion`: explicit prompt after sign-up / sign-in; platform authenticators only.
+ * - `conditional`: silent creation right after a password sign-in; platform only.
+ * - `management`: from account settings; security keys allowed too.
+ */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return error('Not signed in.', 401, 'unauthenticated');
+
+  const body = await readJson<{ mode?: RegistrationMode }>(request);
+  const mode: RegistrationMode = body?.mode && MODES.includes(body.mode) ? body.mode : 'management';
+
+  if (mode === 'conditional' && !(await hasRecentPasswordLogin(session))) {
+    return error('Conditional passkey creation requires a recent password sign-in.', 403);
+  }
+
+  const existing = await findCredentialsByUserId(user.passkeyUserId);
+  const userVerification = 'preferred' as const;
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: getRpId(url),
+    userID: new Uint8Array(Buffer.from(user.passkeyUserId, 'base64url')),
+    userName: user.username,
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    excludeCredentials: existing.map((cred) => ({ id: cred.id, transports: cred.transports })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification,
+      ...(mode !== 'management' && { authenticatorAttachment: 'platform' as const }),
+    },
+  });
+
+  session!.set('pendingRegistration', { challenge: options.challenge, mode, userVerification });
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkey/register-verify.ts b/src/pages/api/auth/passkey/register-verify.ts
