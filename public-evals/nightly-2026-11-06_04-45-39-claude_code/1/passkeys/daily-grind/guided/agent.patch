+.passkey-name {
+  font-weight: 600;
+  overflow-wrap: anywhere;
+}
+
+.passkey-meta {
+  font-size: 0.8rem;
+  color: #6d4c41;
+}
+
+.passkey-actions {
+  display: flex;
+  gap: 6px;
+}
+
+#signout-btn {
+  margin-top: 4px;
+}
+
+[hidden] {
+  display: none !important;
+}
diff --git a/assets/account.js b/assets/account.js
new file mode 100644
index 0000000..d8b1b20
--- /dev/null
+++ b/assets/account.js
@@ -0,0 +1,601 @@
+// "My Account" dialog: passkey sign-up, sign-in, passkey management,
+// profile updates and step-up reauthentication — all via native WebAuthn APIs.
+
+// Polyfills JSON helpers (parse*OptionsFromJSON / toJSON) and getClientCapabilities()
+// on browsers that support WebAuthn but not those newer methods.
+try {
+  await import('https://esm.sh/webauthn-polyfills@0.1.7');
+} catch (err) {
+  console.warn('webauthn-polyfills could not be loaded:', err);
+}
+
+// ---------------------------------------------------------------------------
+// DOM references
+// ---------------------------------------------------------------------------
+
+const $ = (id) => document.getElementById(id);
+
+const accountLink = $('account-link');
+const logoutLink = $('logout-link');
+const dialog = $('account-dialog');
+const statusEl = $('account-status');
+const signedOutView = $('signed-out-view');
+const signedInView = $('signed-in-view');
+const unsupportedNotice = $('passkey-unsupported');
+const signinForm = $('signin-form');
+const registerForm = $('register-form');
+const profileForm = $('profile-form');
+const greeting = $('account-greeting');
+const passkeyList = $('passkey-list');
+const passkeyEmpty = $('passkey-empty');
+const passkeyTemplate = $('passkey-item-template');
+const addPasskeyBtn = $('add-passkey-btn');
+const addPasskeyHint = $('add-passkey-hint');
+const signoutBtn = $('signout-btn');
+
+const reauthDialog = $('reauth-dialog');
+const reauthMessage = $('reauth-message');
+const reauthError = $('reauth-error');
+const reauthConfirmBtn = $('reauth-confirm-btn');
+
+const renameDialog = $('rename-dialog');
+const renameForm = $('rename-form');
+const renameInput = $('rename-input');
+
+// ---------------------------------------------------------------------------
+// State & helpers
+// ---------------------------------------------------------------------------
+
+const state = {
+  user: null,
+  credentials: [],
+  capabilities: {},
+  webauthn: 'PublicKeyCredential' in window,
+};
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+function setStatus(message, tone = 'info') {
+  statusEl.textContent = message;
+  statusEl.dataset.tone = tone;
+  statusEl.hidden = !message;
+}
+
+function setBusy(form, busy) {
+  for (const el of form.querySelectorAll('button, input')) el.disabled = busy;
+  form.toggleAttribute('aria-busy', busy);
+}
+
+async function api(path, { method = 'GET', body } = {}) {
+  const init = { method, headers: { Accept: 'application/json' }, credentials: 'same-origin' };
+  if (method !== 'GET') {
+    init.headers['Content-Type'] = 'application/json';
+    init.body = JSON.stringify(body ?? {});
+  }
+  const response = await fetch(`/api${path}`, init);
+  const data = await response.json().catch(() => ({}));
+  return { ok: response.ok, status: response.status, data };
+}
+
+/** Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1. */
+function isValidBase64Url(value) {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+function describeWebAuthnError(err, action) {
+  switch (err?.name) {
+    case 'NotAllowedError':
+      return ''; // User cancelled or the prompt timed out — no need to nag.
+    case 'AbortError':
+      return '';
+    case 'InvalidStateError':
+      return 'This device already has a passkey for your account.';
+    case 'SecurityError':
+      return 'Passkeys aren’t available on this connection (a secure HTTPS origin is required).';
+    default:
+      console.error(`Unexpected ${action} error:`, err);
+      return `Something went wrong while trying to ${action}. Please try again.`;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Signal API — keeps password managers in sync with the server (best effort)
+// ---------------------------------------------------------------------------
+
+async function signalUnknownCredential(rpId, credentialId) {
+  if (!PublicKeyCredential.signalUnknownCredential || !rpId || !isValidBase64Url(credentialId)) return;
+  try {
+    // rpId always comes from the server-provided options, never window.location.hostname.
+    await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+  } catch (err) {
+    console.warn('signalUnknownCredential sync warning:', err);
+  }
+}
+
+async function signalAllAcceptedCredentials(rpId, userId, credentials) {
+  if (!state.webauthn || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  const allAcceptedCredentialIds = credentials.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !allAcceptedCredentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: invalid rpId, userId or credential IDs.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds });
+  } catch (err) {
+    console.warn('signalAllAcceptedCredentials sync warning:', err);
+  }
+}
+
+async function signalCurrentUserDetails({ rpId, userId, name, displayName }) {
+  if (!state.webauthn || !PublicKeyCredential.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: invalid rpId or userId.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (err) {
+    console.warn('signalCurrentUserDetails sync warning:', err);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Sign-in: conditional (autofill) mediation + explicit button
+// ---------------------------------------------------------------------------
+
+let autofillAbort = new AbortController();
+
+function stopAutofill() {
+  autofillAbort.abort();
+  autofillAbort = new AbortController();
+}
+
+async function verifySignIn(credential, publicKey) {
+  const encoded = credential.toJSON();
+  try {
+    const { ok, status, data } = await api('/signin/verify', { method: 'POST', body: encoded });
+    if (ok) return data.user;
+    // 404 = credential not on the server; tell the password manager (user is unauthenticated here).
+    if (status === 404) await signalUnknownCredential(publicKey.rpId, encoded.id);
+    setStatus(data.error || 'Sign-in failed. Please try again.', 'error');
+  } catch (err) {
+    console.error('Sign-in verification request failed:', err);
+    setStatus('We couldn’t reach the server. Check your connection and try again.', 'error');
+  }
+  return null;
+}
+
+async function startConditionalSignIn() {
+  if (state.user || !state.capabilities.conditionalGet) return;
+  stopAutofill();
+  const { signal } = autofillAbort;
+  try {
+    const { ok, data } = await api('/signin/options', { method: 'POST' });
+    if (!ok || signal.aborted) return;
+    const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(data);
+    const credential = await navigator.credentials.get({ publicKey, signal, mediation: 'conditional' });
+    if (!credential) return;
+    setStatus('Signing you in…');
+    const user = await verifySignIn(credential, publicKey);
+    if (user) await onSignedIn(user, 'Welcome back! You’re signed in.');
+    else startConditionalSignIn();
+  } catch (err) {
+    if (err.name === 'NotAllowedError' || err.name === 'AbortError') return;
+    console.warn('Passkey autofill unavailable:', err);
+  }
+}
+
+async function signInWithButton(event) {
+  event.preventDefault();
+  stopAutofill(); // Avoid colliding with the pending autofill request.
+  setBusy(signinForm, true);
+  setStatus('');
+  try {
+    const { ok, data } = await api('/signin/options', { method: 'POST' });
+    if (!ok) throw new Error(data.error || 'Could not start sign-in.');
+    const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(data);
+
+    let credential;
+    try {
+      credential = await navigator.credentials.get({ publicKey, signal: autofillAbort.signal });
+    } catch (err) {
+      const message = describeWebAuthnError(err, 'sign in');
+      if (message) setStatus(message, 'error');
+      return;
+    }
+
+    setStatus('Signing you in…');
+    const user = await verifySignIn(credential, publicKey);
+    if (user) await onSignedIn(user, 'Welcome back! You’re signed in.');
+  } catch (err) {
+    console.error(err);
+    setStatus(err.message || 'Sign-in failed. Please try again.', 'error');
+  } finally {
+    setBusy(signinForm, false);
+    applyCapabilityGates();
+    if (!state.user) startConditionalSignIn(); // Re-arm autofill after a cancelled/failed attempt.
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Registration: new customer account, or an extra passkey for a signed-in user
+// ---------------------------------------------------------------------------
+
+/** Runs the create() ceremony. Returns the verify response data, or null on failure. */
+async function createPasskey(profile) {
+  const { ok, data } = await api('/register/options', { method: 'POST', body: profile });
+  if (!ok) {
+    setStatus(data.error || 'Could not start passkey creation.', 'error');
+    return null;
+  }
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(data);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    const message = describeWebAuthnError(err, 'create a passkey');
+    if (message) setStatus(message, 'error');
+    return null; // Do not signal for ordinary WebAuthn cancellations.
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    const result = await api('/register/verify', { method: 'POST', body: encoded });
+    if (result.ok) return result.data;
+    // The authenticator saved a passkey the server rejected — let the provider drop it.
+    await signalUnknownCredential(publicKey.rp.id, encoded.id);
+    setStatus(result.data.error || 'Your passkey couldn’t be saved. Please try again.', 'error');
+  } catch (err) {
+    console.error('Registration verification request failed:', err);
+    await signalUnknownCredential(publicKey.rp.id, encoded.id);
+    setStatus('We couldn’t reach the server. Check your connection and try again.', 'error');
+  }
+  return null;
+}
+
+async function registerAccount(event) {
+  event.preventDefault();
+  if (!registerForm.reportValidity()) return;
+  const form = new FormData(registerForm);
+  stopAutofill();
+  setBusy(registerForm, true);
+  setStatus('');
+  try {
+    const result = await createPasskey({ name: form.get('username'), displayName: form.get('displayName') });
+    if (result) {
+      registerForm.reset();
+      await onSignedIn(result.user, 'Your account is ready, and your passkey is saved. Welcome to The Daily Grind!');
+    }
+  } finally {
+    setBusy(registerForm, false);
+    applyCapabilityGates();
+    if (!state.user) startConditionalSignIn();
+  }
+}
+
+async function addPasskey() {
+  addPasskeyBtn.disabled = true;
+  setStatus('');
+  try {
+    const result = await createPasskey({});
+    if (result) {
+      await loadCredentials();
+      setStatus('New passkey added.', 'success');
+    }
+  } finally {
+    applyCapabilityGates();
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Reauthentication (step-up) before sensitive changes
+// ---------------------------------------------------------------------------
+
+let reauthResolve = null;
+
+function hasRecentAuth() {
+  return (state.user?.reauthValidUntil ?? 0) - Date.now() > 10_000;
+}
+
+/** Resolves true once the user has recently verified with a passkey, false if they cancel. */
+function ensureRecentAuth(message) {
+  if (hasRecentAuth()) return Promise.resolve(true);
+  reauthMessage.textContent = message;
+  reauthError.hidden = true;
+  reauthConfirmBtn.disabled = !state.webauthn;
+  reauthDialog.showModal();
+  return new Promise((resolve) => {
+    reauthResolve = resolve;
+  });
+}
+
+async function runReauth() {
+  reauthConfirmBtn.disabled = true;
+  reauthError.hidden = true;
+  const fail = (message) => {
+    if (!message) return;
+    reauthError.textContent = message;
+    reauthError.hidden = false;
+  };
+  try {
+    const { ok, data } = await api('/reauth/options', { method: 'POST' });
+    if (!ok) return fail(data.error || 'Could not start verification.');
+    // allowCredentials is restricted server-side to this customer's own passkeys.
+    const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(data);
+
+    let credential;
+    try {
+      credential = await navigator.credentials.get({ publicKey });
+    } catch (err) {
+      return fail(describeWebAuthnError(err, 'verify your identity'));
+    }
+
+    const encoded = credential.toJSON();
+    const result = await api('/reauth/verify', { method: 'POST', body: encoded });
+    if (result.ok) {
+      state.user = result.data.user;
+      reauthResolve?.(true);
+      reauthResolve = null;
+      reauthDialog.close('verified');
+      return;
+    }
+    if (result.status === 404) await signalUnknownCredential(publicKey.rpId, encoded.id);
+    fail(result.data.error || 'Verification failed. Please try again.');
+  } catch (err) {
+    console.error('Reauthentication failed:', err);
+    fail('We couldn’t reach the server. Check your connection and try again.');
+  } finally {
+    reauthConfirmBtn.disabled = false;
+  }
+}
+
+reauthConfirmBtn.addEventListener('click', runReauth);
+$('reauth-cancel-btn').addEventListener('click', () => reauthDialog.close());
+reauthDialog.addEventListener('close', () => {
+  reauthResolve?.(false);
+  reauthResolve = null;
+});
+
+/** Performs a sensitive API call, prompting for reauthentication first when needed. */
+async function withReauth(message, request) {
+  if (!(await ensureRecentAuth(message))) return null;
+  let result = await request();
+  if (result.status === 401 && result.data.code === 'reauth_required') {
+    state.user.reauthValidUntil = 0;
+    if (!(await ensureRecentAuth(message))) return null;
+    result = await request();
+  }
+  return result;
+}
+
+// ---------------------------------------------------------------------------
+// Passkey management
+// ---------------------------------------------------------------------------
+
+function renderCredentials() {
+  passkeyList.replaceChildren(
+    ...state.credentials.map((cred) => {
+      const item = passkeyTemplate.content.firstElementChild.cloneNode(true);
+      // Provider icon comes from the AAGUID registry (a UX hint only); fall back to a generic key.
+      if (cred.providerIcon) {
+        const icon = item.querySelector('.passkey-icon');
+        icon.src = cred.providerIcon;
+        icon.hidden = false;
+        item.querySelector('.passkey-icon-fallback').remove();
+      }
+      item.querySelector('.passkey-name').textContent = cred.name;
+
+      const created = item.querySelector('.passkey-created');
+      created.dateTime = new Date(cred.registeredAt).toISOString();
+      created.textContent = dateFormat.format(cred.registeredAt);
+
+      const lastUsedWrap = item.querySelector('.passkey-last-used-wrap');
+      if (cred.lastUsedAt) {
+        const lastUsed = item.querySelector('.passkey-last-used');
+        lastUsed.dateTime = new Date(cred.lastUsedAt).toISOString();
+        lastUsed.textContent = dateFormat.format(cred.lastUsedAt);
+      } else {
+        lastUsedWrap.textContent = 'Not used to sign in yet';
+      }
+
+      item.querySelector('.passkey-synced').hidden = !cred.credentialBackedUp;
+
+      const renameBtn = item.querySelector('[data-action="rename"]');
+      const deleteBtn = item.querySelector('[data-action="delete"]');
+      renameBtn.setAttribute('aria-label', `Rename ${cred.name}`);
+      deleteBtn.setAttribute('aria-label', `Remove ${cred.name}`);
+      renameBtn.addEventListener('click', () => openRename(cred));
+      deleteBtn.addEventListener('click', () => deletePasskey(cred));
+      return item;
+    }),
+  );
+  passkeyEmpty.hidden = state.credentials.length > 0;
+}
+
+async function loadCredentials() {
+  const { ok, data } = await api('/credentials');
+  if (!ok) {
+    setStatus(data.error || 'Could not load your passkeys.', 'error');
+    return;
+  }
+  state.credentials = data.credentials;
+  renderCredentials();
+  await signalAllAcceptedCredentials(data.rpId, data.userId, data.credentials);
+}
+
+let renaming = null;
+
+function openRename(cred) {
+  renaming = cred;
+  renameInput.value = cred.name;
+  renameDialog.showModal();
+  renameInput.select();
+}
+
+renameForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (!renameForm.reportValidity() || !renaming) return;
+  setBusy(renameForm, true);
+  try {
+    // Renaming is a server-side label only; it doesn't change anything in the password manager.
+    const { ok, data } = await api(`/credentials/${encodeURIComponent(renaming.id)}`, {
+      method: 'PUT',
+      body: { name: renameInput.value },
+    });
+    if (!ok) {
+      setStatus(data.error || 'Could not rename that passkey.', 'error');
+    } else {
+      state.credentials = data.credentials;
+      renderCredentials();
+      setStatus('Passkey renamed.', 'success');
+    }
+    renameDialog.close();
+  } finally {
+    setBusy(renameForm, false);
+  }
+});
+$('rename-cancel-btn').addEventListener('click', () => renameDialog.close());
+renameDialog.addEventListener('close', () => {
+  renaming = null;
+});
+
+async function deletePasskey(cred) {
+  setStatus('');
+  if (state.credentials.length <= 1) {
+    setStatus('You can’t remove your only passkey — add another one first so you can still sign in.', 'error');
+    return;
+  }
+  const result = await withReauth(`Confirm it’s you to remove the passkey “${cred.name}”.`, () =>
+    api(`/credentials/${encodeURIComponent(cred.id)}`, { method: 'DELETE' }),
+  );
+  if (!result) return;
+  if (!result.ok) {
+    setStatus(result.data.error || 'Could not remove that passkey.', 'error');
+    return;
+  }
+  state.credentials = result.data.credentials;
+  renderCredentials();
+  setStatus(`Removed “${cred.name}”.`, 'success');
+  // Tell the password manager which passkeys are still valid so the removed one disappears.
+  await signalAllAcceptedCredentials(result.data.rpId, result.data.userId, result.data.credentials);
+}
+
+// ---------------------------------------------------------------------------
+// Profile
+// ---------------------------------------------------------------------------
+
+function fillProfile() {
+  profileForm.elements.username.value = state.user.name;
+  profileForm.elements.displayName.value = state.user.displayName;
+  greeting.textContent = `Hi, ${state.user.displayName}!`;
+}
+
+profileForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (!profileForm.reportValidity()) return;
+  const name = profileForm.elements.username.value.trim();
+  const displayName = profileForm.elements.displayName.value.trim();
+  if (name === state.user.name && displayName === state.user.displayName) {
+    setStatus('No changes to save.');
+    return;
+  }
+  setStatus('');
+  setBusy(profileForm, true);
+  try {
+    const result = await withReauth('Confirm it’s you to update your profile.', () =>
+      api('/user', { method: 'PUT', body: { name, displayName } }),
+    );
+    if (!result) return;
+    if (!result.ok) {
+      setStatus(result.data.error || 'Could not update your profile.', 'error');
+      return;
+    }
+    state.user = result.data.user;
+    fillProfile();
+    setStatus('Profile updated.', 'success');
+    // Update the username/display name shown in the user's passkey provider.
+    await signalCurrentUserDetails(result.data.user);
+  } finally {
+    setBusy(profileForm, false);
+  }
+});
+
+// ---------------------------------------------------------------------------
+// Session / view switching
+// ---------------------------------------------------------------------------
+
+function applyCapabilityGates() {
+  const canCreate = Boolean(state.capabilities.passkeyPlatformAuthenticator && state.capabilities.conditionalGet);
+  unsupportedNotice.hidden = canCreate;
+  for (const btn of registerForm.querySelectorAll('button')) btn.disabled = !canCreate;
+  addPasskeyBtn.disabled = !canCreate;
+  addPasskeyHint.hidden = canCreate;
+  signinForm.querySelector('button[type="submit"]').disabled = !state.webauthn;
+}
+
+function render() {
+  const signedIn = Boolean(state.user);
+  signedOutView.hidden = signedIn;
+  signedInView.hidden = !signedIn;
+  logoutLink.parentElement.hidden = !signedIn;
+  accountLink.textContent = signedIn ? 'My Account' : 'Sign In';
+  if (signedIn) fillProfile();
+}
+
+async function onSignedIn(user, message) {
+  stopAutofill();
+  state.user = user;
+  render();
+  setStatus(message, 'success');
+  await loadCredentials();
+  if (dialog.open) greeting.focus();
+}
+
+async function signOut(event) {
+  event?.preventDefault();
+  await api('/logout', { method: 'POST' }).catch(() => {});
+  state.user = null;
+  state.credentials = [];
+  passkeyList.replaceChildren();
+  render();
+  setStatus('You’ve been signed out.');
+  startConditionalSignIn();
+}
+
+function openAccount(event) {
+  event?.preventDefault();
+  if (!dialog.open) dialog.showModal();
+}
+
+accountLink.addEventListener('click', openAccount);
+logoutLink.addEventListener('click', signOut);
+signoutBtn.addEventListener('click', signOut);
+signinForm.addEventListener('submit', signInWithButton);
+registerForm.addEventListener('submit', registerAccount);
+addPasskeyBtn.addEventListener('click', addPasskey);
+dialog.querySelector('[data-close]').addEventListener('click', () => dialog.close());
+dialog.addEventListener('close', () => {
+  if (location.pathname === '/account') history.replaceState(null, '', '/');
+});
+
+async function init() {
+  if (state.webauthn) {
+    try {
+      state.capabilities = await PublicKeyCredential.getClientCapabilities();
+    } catch (err) {
+      console.warn('getClientCapabilities failed:', err);
+    }
+  }
+  applyCapabilityGates();
+
+  const { ok, data } = await api('/session').catch(() => ({ ok: false, data: {} }));
+  state.user = ok ? data.user : null;
+  render();
+  if (state.user) await loadCredentials(); // Also syncs accepted passkeys with the password manager.
+  else startConditionalSignIn();
+
+  if (location.pathname === '/account') openAccount();
+}
+
+init();
