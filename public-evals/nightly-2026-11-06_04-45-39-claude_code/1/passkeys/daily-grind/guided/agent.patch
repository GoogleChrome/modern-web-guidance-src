@@ -0,0 +1,544 @@
+// The Daily Grind — web server with passkey (WebAuthn) customer accounts.
+//
+// Serves the homepage plus a small JSON API used by the "My Account" dialog:
+//   registration (new customer + additional passkeys), discoverable sign-in,
+//   passkey management (list / rename / delete), profile updates and
+//   step-up reauthentication before sensitive changes.
+//
+// Configuration (environment variables):
+//   PORT            Port to listen on (default 11222)
+//   RP_ID           WebAuthn Relying Party ID, i.e. the site's domain (default "localhost")
+//   ORIGIN          Comma-separated list of allowed origins (default http://localhost:PORT)
+//   SESSION_SECRET  Secret used to sign session cookies (random per boot if unset)
+//   DATA_FILE       JSON file used to persist accounts (default ./data/db.json)
+
+import express from 'express';
+import session from 'express-session';
+import { randomBytes } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  generateAuthenticationOptions,
+  generateRegistrationOptions,
+  verifyAuthenticationResponse,
+  verifyRegistrationResponse,
+} from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT) || 11222;
+const RP_ID = process.env.RP_ID || 'localhost'; // Predefined RP ID — clients always read it from server responses.
+const RP_NAME = 'The Daily Grind';
+const EXPECTED_ORIGINS = (process.env.ORIGIN || `http://localhost:${PORT}`)
+  .split(',')
+  .map((o) => o.trim())
+  .filter(Boolean);
+const SECURE_COOKIES = EXPECTED_ORIGINS.every((o) => o.startsWith('https://'));
+const DATA_FILE = process.env.DATA_FILE || path.join(ROOT, 'data', 'db.json');
+
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const USER_VERIFICATION = 'preferred';
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+const AAGUID_REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+
+// ---------------------------------------------------------------------------
+// Persistence: a tiny JSON-file store (swap for a real database in production)
+// ---------------------------------------------------------------------------
+
+/**
+ * @typedef {{ id: string, name: string, displayName: string, createdAt: number }} User
+ *   `id` is the unpadded Base64URL WebAuthn user handle (passkeyUserId).
+ * @typedef {{
+ *   id: string, passkeyUserId: string, credentialPublicKey: string, credentialType: 'public-key',
+ *   credentialDeviceType: 'singleDevice' | 'multiDevice', credentialBackedUp: boolean,
+ *   aaguid: string, providerIcon?: string, name: string, transports: string[],
+ *   lastUsedAt?: number, registeredAt: number, counter: number
+ * }} StoredPasskeyCredential
+ */
+
+const db = { users: /** @type {User[]} */ ([]), credentials: /** @type {StoredPasskeyCredential[]} */ ([]) };
+
+async function loadDb() {
+  try {
+    const parsed = JSON.parse(await readFile(DATA_FILE, 'utf8'));
+    db.users = parsed.users ?? [];
+    db.credentials = parsed.credentials ?? [];
+  } catch (err) {
+    if (err.code !== 'ENOENT') throw err;
+  }
+}
+
+let writeQueue = Promise.resolve();
+function saveDb() {
+  // Serialize writes and replace atomically so a crash never leaves a half-written file.
+  writeQueue = writeQueue.then(async () => {
+    await mkdir(path.dirname(DATA_FILE), { recursive: true });
+    const tmp = `${DATA_FILE}.tmp`;
+    await writeFile(tmp, JSON.stringify(db, null, 2));
+    await rename(tmp, DATA_FILE);
+  });
+  return writeQueue;
+}
+
+const findUser = (id) => db.users.find((u) => u.id === id);
+const findUserByName = (name) => db.users.find((u) => u.name.toLowerCase() === name.toLowerCase());
+const findCredential = (id) => db.credentials.find((c) => c.id === id);
+const credentialsFor = (userId) => db.credentials.filter((c) => c.passkeyUserId === userId);
+
+// ---------------------------------------------------------------------------
+// AAGUID → provider name/icon (UX hint only; never used for security decisions)
+// ---------------------------------------------------------------------------
+
+let aaguidRegistry = null;
+let aaguidRegistryPromise = null;
+
+async function getAaguidRegistry() {
+  if (aaguidRegistry) return aaguidRegistry;
+  aaguidRegistryPromise ??= fetch(AAGUID_REGISTRY_URL, { signal: AbortSignal.timeout(4000) })
+    .then((res) => (res.ok ? res.json() : {}))
+    .then((json) => (aaguidRegistry = json))
+    .catch((err) => {
+      console.warn('Could not load AAGUID registry:', err.message);
+      return {};
+    })
+    .finally(() => {
+      aaguidRegistryPromise = null;
+    });
+  return aaguidRegistryPromise;
+}
+
+async function describeProvider(aaguid) {
+  if (!aaguid || aaguid === ZERO_AAGUID) return { name: 'Passkey', providerIcon: undefined };
+  const provider = (await getAaguidRegistry())[aaguid];
+  return { name: provider?.name || 'Passkey', providerIcon: provider?.icon_light };
+}
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+const USERNAME_RE = /^[a-z0-9._@+-]{3,64}$/i;
+
+function validateProfile({ name, displayName }) {
+  const cleanName = typeof name === 'string' ? name.trim() : '';
+  const cleanDisplay = typeof displayName === 'string' ? displayName.trim() : '';
+  if (!USERNAME_RE.test(cleanName)) {
+    return { error: 'Usernames need 3–64 characters: letters, numbers, and . _ @ + -' };
+  }
+  if (cleanDisplay.length < 1 || cleanDisplay.length > 64) {
+    return { error: 'Display name must be between 1 and 64 characters.' };
+  }
+  return { name: cleanName, displayName: cleanDisplay };
+}
+
+function publicUser(user, req) {
+  return {
+    id: user.id,
+    name: user.name,
+    displayName: user.displayName,
+    rpId: RP_ID,
+    userId: user.id,
+    reauthValidUntil: req.session.reauthAt ? req.session.reauthAt + REAUTH_WINDOW_MS : 0,
+  };
+}
+
+function publicCredential(cred) {
+  return {
+    id: cred.id,
+    name: cred.name,
+    providerIcon: cred.providerIcon,
+    aaguid: cred.aaguid,
+    credentialDeviceType: cred.credentialDeviceType,
+    credentialBackedUp: cred.credentialBackedUp,
+    registeredAt: cred.registeredAt,
+    lastUsedAt: cred.lastUsedAt,
+  };
+}
+
+function storeChallenge(req, purpose, challenge, extra = {}) {
+  req.session.challenge = { purpose, value: challenge, expiresAt: Date.now() + CHALLENGE_TTL_MS, ...extra };
+}
+
+/** Return and consume (single use) the session challenge for `purpose`, or null. */
+function takeChallenge(req, purpose) {
+  const stored = req.session.challenge;
+  delete req.session.challenge;
+  if (!stored || stored.purpose !== purpose || stored.expiresAt < Date.now()) return null;
+  return stored;
+}
+
+function toWebAuthnCredential(cred) {
+  return {
+    id: cred.id,
+    publicKey: isoBase64URL.toBuffer(cred.credentialPublicKey),
+    counter: cred.counter,
+    transports: cred.transports,
+  };
+}
+
+/** Regenerate the session (prevents fixation) and mark the user as signed in. */
+function establishSession(req, userId) {
+  return new Promise((resolve, reject) => {
+    req.session.regenerate((err) => {
+      if (err) return reject(err);
+      req.session.userId = userId;
+      req.session.reauthAt = Date.now(); // A fresh passkey sign-in counts as recent verification.
+      req.session.save((saveErr) => (saveErr ? reject(saveErr) : resolve()));
+    });
+  });
+}
+
+function requireUser(req, res, next) {
+  const user = req.session.userId && findUser(req.session.userId);
+  if (!user) return res.status(401).json({ error: 'Please sign in first.', code: 'signin_required' });
+  req.user = user;
+  next();
+}
+
+function requireRecentReauth(req, res, next) {
+  if (!req.session.reauthAt || Date.now() - req.session.reauthAt > REAUTH_WINDOW_MS) {
+    return res
+      .status(401)
+      .json({ error: 'Please confirm it’s you with your passkey.', code: 'reauth_required' });
+  }
+  next();
+}
+
+/** CSRF defence: state-changing API calls must be same-origin JSON requests. */
+function requireJsonSameOrigin(req, res, next) {
+  if (['GET', 'HEAD', 'OPTIONS'].includes(req.method)) return next();
+  const origin = req.get('origin');
+  if (origin && !EXPECTED_ORIGINS.includes(origin)) {
+    return res.status(403).json({ error: 'Cross-origin request blocked.' });
+  }
+  if (!req.is('application/json')) {
+    return res.status(415).json({ error: 'Expected a JSON request body.' });
+  }
+  next();
+}
+
+// ---------------------------------------------------------------------------
+// App
+// ---------------------------------------------------------------------------
+
+const app = express();
+app.disable('x-powered-by');
+if (SECURE_COOKIES) app.set('trust proxy', 1);
+
+app.use(
+  session({
+    name: 'dg.sid',
+    secret: process.env.SESSION_SECRET || randomBytes(32).toString('hex'),
+    resave: false,
+    saveUninitialized: false,
+    cookie: { httpOnly: true, sameSite: 'lax', secure: SECURE_COOKIES, maxAge: 1000 * 60 * 60 * 24 * 14 },
+  }),
+);
+
+const api = express.Router();
+api.use(express.json({ limit: '64kb' }));
+api.use(requireJsonSameOrigin);
+api.use((req, res, next) => {
+  res.set('Cache-Control', 'no-store');
+  next();
+});
+
+// Current session -----------------------------------------------------------
+
+api.get('/session', (req, res) => {
+  const user = req.session.userId && findUser(req.session.userId);
+  res.json({ user: user ? publicUser(user, req) : null });
+});
+
+api.post('/logout', (req, res) => {
+  req.session.destroy(() => {
+    res.clearCookie('dg.sid');
+    res.json({ ok: true });
+  });
+});
+
+// Registration (new customer account, or an extra passkey for a signed-in customer)
+
+api.post('/register/options', async (req, res) => {
+  const signedInUser = req.session.userId && findUser(req.session.userId);
+  let user;
+
+  if (signedInUser) {
+    user = signedInUser;
+  } else {
+    const profile = validateProfile(req.body ?? {});
+    if (profile.error) return res.status(400).json({ error: profile.error });
+    if (findUserByName(profile.name)) {
+      return res.status(409).json({ error: 'That username is taken. Try signing in instead.' });
+    }
+    user = {
+      id: isoBase64URL.fromBuffer(randomBytes(32)), // Random, opaque, unpadded Base64URL user handle.
+      name: profile.name,
+      displayName: profile.displayName,
+    };
+  }
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: RP_ID,
+    userID: isoBase64URL.toBuffer(user.id),
+    userName: user.name,
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    excludeCredentials: credentialsFor(user.id).map((c) => ({ id: c.id, transports: c.transports })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: USER_VERIFICATION,
+      // Account settings flow: authenticatorAttachment omitted so security keys work too.
+    },
+  });
+
+  storeChallenge(req, 'register', options.challenge, {
+    pendingUser: signedInUser ? undefined : user,
+  });
+  res.json(options);
+});
+
+api.post('/register/verify', async (req, res) => {
+  const stored = takeChallenge(req, 'register');
+  if (!stored) return res.status(400).json({ error: 'Registration expired. Please try again.' });
+
+  const signedInUser = req.session.userId && findUser(req.session.userId);
+  const pendingUser = stored.pendingUser;
+  if (!signedInUser && !pendingUser) return res.status(400).json({ error: 'No registration in progress.' });
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: req.body,
+      expectedChallenge: stored.value,
+      expectedOrigin: EXPECTED_ORIGINS,
+      expectedRPID: RP_ID,
+      requireUserPresence: true,
+      requireUserVerification: false, // Matches userVerification: 'preferred'.
+    });
+  } catch (err) {
+    return res.status(400).json({ error: `Passkey could not be verified: ${err.message}` });
+  }
+  if (!verification.verified) return res.status(400).json({ error: 'Passkey could not be verified.' });
+
+  const info = verification.registrationInfo;
+  if (findCredential(info.credential.id)) {
+    return res.status(409).json({ error: 'This passkey is already registered.' });
+  }
+
+  let user = signedInUser;
+  if (!user) {
+    // Re-check: someone may have claimed the username while the passkey dialog was open.
+    if (findUserByName(pendingUser.name)) {
+      return res.status(409).json({ error: 'That username was just taken. Please choose another.' });
+    }
+    user = { ...pendingUser, createdAt: Date.now() };
+    db.users.push(user);
+  }
+
+  const provider = await describeProvider(info.aaguid);
+  db.credentials.push({
+    id: info.credential.id,
+    passkeyUserId: user.id,
+    credentialPublicKey: isoBase64URL.fromBuffer(info.credential.publicKey),
+    credentialType: 'public-key',
+    credentialDeviceType: info.credentialDeviceType,
+    credentialBackedUp: info.credentialBackedUp,
+    aaguid: info.aaguid,
+    providerIcon: provider.providerIcon,
+    name: provider.name,
+    transports: info.credential.transports ?? req.body?.response?.transports ?? [],
+    registeredAt: Date.now(),
+    counter: info.credential.counter,
+  });
+  await saveDb();
+
+  if (!signedInUser) await establishSession(req, user.id);
+  res.json({ user: publicUser(user, req) });
+});
+
+// Sign-in (discoverable credentials: button + conditional/autofill UI) -------
+
+api.post('/signin/options', async (req, res) => {
+  const options = await generateAuthenticationOptions({
+    rpID: RP_ID,
+    allowCredentials: [],
+    userVerification: USER_VERIFICATION,
+  });
+  // Persist the requested UV level server-side rather than trusting the client later.
+  storeChallenge(req, 'signin', options.challenge, { userVerification: USER_VERIFICATION });
+  res.json(options);
+});
+
+api.post('/signin/verify', async (req, res) => {
+  const stored = takeChallenge(req, 'signin');
+  if (!stored) return res.status(400).json({ error: 'Sign-in expired. Please try again.' });
+
+  const cred = typeof req.body?.id === 'string' && findCredential(req.body.id);
+  if (!cred) return res.status(404).json({ error: 'This passkey isn’t registered with The Daily Grind.' });
+  const user = findUser(cred.passkeyUserId);
+  if (!user) return res.status(404).json({ error: 'No account found for this passkey.' });
+  const userHandle = req.body?.response?.userHandle;
+  if (userHandle && userHandle !== user.id) {
+    return res.status(400).json({ error: 'Passkey does not match its account.' });
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: req.body,
+      expectedChallenge: stored.value,
+      expectedOrigin: EXPECTED_ORIGINS,
+      expectedRPID: RP_ID,
+      credential: toWebAuthnCredential(cred),
+      requireUserVerification: stored.userVerification === 'required',
+    });
+  } catch (err) {
+    return res.status(400).json({ error: `Sign-in failed: ${err.message}` });
+  }
+  if (!verification.verified) return res.status(400).json({ error: 'Sign-in failed.' });
+
+  cred.counter = verification.authenticationInfo.newCounter;
+  cred.credentialBackedUp = verification.authenticationInfo.credentialBackedUp;
+  cred.lastUsedAt = Date.now();
+  await saveDb();
+
+  await establishSession(req, user.id);
+  res.json({ user: publicUser(user, req) });
+});
+
+// Reauthentication (step-up before sensitive changes) -------------------------
+
+api.post('/reauth/options', requireUser, async (req, res) => {
+  const creds = credentialsFor(req.user.id);
+  if (creds.length === 0) return res.status(409).json({ error: 'Your account has no passkeys.' });
+  const options = await generateAuthenticationOptions({
+    rpID: RP_ID,
+    // Restrict the prompt to this customer's passkeys so a different account can't be used.
+    allowCredentials: creds.map((c) => ({ id: c.id, transports: c.transports })),
+    userVerification: USER_VERIFICATION,
+  });
+  storeChallenge(req, 'reauth', options.challenge, { userVerification: USER_VERIFICATION, userId: req.user.id });
+  res.json(options);
+});
+
+api.post('/reauth/verify', requireUser, async (req, res) => {
+  const stored = takeChallenge(req, 'reauth');
+  if (!stored || stored.userId !== req.user.id) {
+    return res.status(400).json({ error: 'Verification expired. Please try again.' });
+  }
+
+  const cred = typeof req.body?.id === 'string' && findCredential(req.body.id);
+  if (!cred) return res.status(404).json({ error: 'This passkey isn’t registered with The Daily Grind.' });
+  if (cred.passkeyUserId !== req.user.id) {
+    return res.status(403).json({ error: 'That passkey belongs to a different account.' });
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: req.body,
+      expectedChallenge: stored.value,
+      expectedOrigin: EXPECTED_ORIGINS,
+      expectedRPID: RP_ID,
+      credential: toWebAuthnCredential(cred),
+      requireUserVerification: stored.userVerification === 'required',
+    });
+  } catch (err) {
+    return res.status(400).json({ error: `Verification failed: ${err.message}` });
+  }
+  if (!verification.verified) return res.status(400).json({ error: 'Verification failed.' });
+
+  cred.counter = verification.authenticationInfo.newCounter;
+  cred.lastUsedAt = Date.now();
+  await saveDb();
+
+  req.session.reauthAt = Date.now();
+  res.json({ user: publicUser(req.user, req) });
+});
+
+// Passkey management ----------------------------------------------------------
+
+function credentialList(req) {
+  return {
+    rpId: RP_ID,
+    userId: req.user.id,
+    credentials: credentialsFor(req.user.id)
+      .sort((a, b) => b.registeredAt - a.registeredAt)
+      .map(publicCredential),
+  };
+}
+
+api.get('/credentials', requireUser, (req, res) => res.json(credentialList(req)));
+
+api.put('/credentials/:id', requireUser, async (req, res) => {
+  const cred = findCredential(req.params.id);
+  if (!cred || cred.passkeyUserId !== req.user.id) return res.status(404).json({ error: 'Passkey not found.' });
+  const name = typeof req.body?.name === 'string' ? req.body.name.trim() : '';
+  if (name.length < 1 || name.length > 64) {
+    return res.status(400).json({ error: 'Passkey names must be between 1 and 64 characters.' });
+  }
+  cred.name = name;
+  await saveDb();
+  res.json(credentialList(req));
+});
+
+api.delete('/credentials/:id', requireUser, requireRecentReauth, async (req, res) => {
+  const cred = findCredential(req.params.id);
+  if (!cred || cred.passkeyUserId !== req.user.id) return res.status(404).json({ error: 'Passkey not found.' });
+  if (credentialsFor(req.user.id).length <= 1) {
+    return res
+      .status(409)
+      .json({ error: 'You can’t remove your only passkey — add another one first so you can still sign in.' });
+  }
+  db.credentials = db.credentials.filter((c) => c.id !== cred.id);
+  await saveDb();
+  res.json(credentialList(req));
+});
+
+// Profile ----------------------------------------------------------------------
+
+api.put('/user', requireUser, requireRecentReauth, async (req, res) => {
+  const profile = validateProfile(req.body ?? {});
+  if (profile.error) return res.status(400).json({ error: profile.error });
+  const existing = findUserByName(profile.name);
+  if (existing && existing.id !== req.user.id) {
+    return res.status(409).json({ error: 'That username is already in use.' });
+  }
+  req.user.name = profile.name;
+  req.user.displayName = profile.displayName;
+  await saveDb();
+  res.json({ user: publicUser(req.user, req) });
+});
+
+api.use((req, res) => res.status(404).json({ error: 'Not found.' }));
+api.use((err, req, res, _next) => {
+  console.error(err);
+  res.status(err.status || 500).json({ error: err.expose ? err.message : 'Something went wrong.' });
+});
+
+app.use('/api', api);
+
+// Pages & static assets ------------------------------------------------------------
+
+const sendHome = (req, res) => res.sendFile(path.join(ROOT, 'index.html'));
+app.get(['/', '/index.html', '/account'], sendHome);
+app.get('/logout', (req, res) => {
+  // No-JS fallback for the nav "Logout" link.
+  req.session.destroy(() => {
+    res.clearCookie('dg.sid');
+    res.redirect('/');
+  });
+});
+app.use('/assets', express.static(path.join(ROOT, 'assets'), { maxAge: '1h' }));
+
+await loadDb();
+getAaguidRegistry(); // Warm the provider-name cache in the background.
+app.listen(PORT, () => {
+  console.log(`The Daily Grind running on port ${PORT} (RP ID "${RP_ID}", origins ${EXPECTED_ORIGINS.join(', ')})`);
+});
