+/* My Account dialog — passkey sign-in, registration and management */
+
+button.btn {
+  border: none;
+  font: inherit;
+  cursor: pointer;
+}
+
+.btn:focus-visible,
+.icon-btn:focus-visible,
+nav a:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.btn:disabled {
+  opacity: 0.55;
+  cursor: not-allowed;
+}
+
+.btn-secondary {
+  background: var(--secondary);
+  color: var(--text);
+}
+
+.btn-secondary:hover:not(:disabled) {
+  background: #bcaaa4;
+}
+
+.btn-danger {
+  background: #b3261e;
+}
+
+.btn-danger:hover:not(:disabled) {
+  background: #8c1d18;
+}
+
+.btn-small {
+  padding: 4px 10px;
+  margin-top: 0;
+  font-size: 0.85rem;
+}
+
+.account-dialog,
+.small-dialog {
+  border: none;
+  border-radius: 12px;
+  padding: 24px;
+  color: var(--text);
+  box-shadow: 0 20px 50px rgb(0 0 0 / 0.3);
+  margin: auto;
+}
+
+.account-dialog {
+  width: min(36rem, 100vw - 2rem);
+  max-height: min(90dvh, 52rem);
+  overscroll-behavior: contain;
+}
+
+.small-dialog {
+  width: min(26rem, 100vw - 2rem);
+}
+
+.account-dialog::backdrop,
+.small-dialog::backdrop {
+  background: rgb(30 20 15 / 0.55);
+}
+
+.small-dialog h2 {
+  margin-bottom: 8px;
+  color: var(--primary);
+}
+
+.dialog-head {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 12px;
+}
+
+.dialog-head h2 {
+  color: var(--primary);
+}
+
+.icon-btn {
+  background: none;
+  border: none;
+  font-size: 1.75rem;
+  line-height: 1;
+  cursor: pointer;
+  color: var(--text);
+  padding: 4px 10px;
+  border-radius: 6px;
+}
+
+.icon-btn:hover {
+  background: var(--secondary);
+}
+
+.dialog-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 10px;
+}
+
+.account-section {
+  padding-block: 16px;
+  border-top: 1px solid var(--secondary);
+}
+
+.account-section h3 {
+  color: var(--primary);
+  margin-bottom: 6px;
+}
+
+.stack {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  align-items: stretch;
+}
+
+.stack label {
+  font-weight: 600;
+  font-size: 0.9rem;
+}
+
+.stack input {
+  font: inherit;
+  padding: 8px 10px;
+  border: 1px solid #a1887f;
+  border-radius: 6px;
+}
+
+.stack input:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 1px;
+}
+
+.stack input:user-invalid {
+  border-color: #b3261e;
+}
+
+.stack > .btn {
+  align-self: flex-start;
+}
+
+.hint {
+  font-size: 0.85rem;
+  color: #6d4c41;
+}
+
+.notice {
+  background: #fff3e0;
+  border-left: 4px solid var(--accent);
+  padding: 10px 12px;
+  margin-bottom: 12px;
+  font-size: 0.9rem;
+}
+
+.account-status {
+  padding: 10px 12px;
+  border-radius: 6px;
+  margin-bottom: 12px;
+  background: #efebe9;
+  font-size: 0.9rem;
+}
+
+.account-status[data-tone='success'] {
+  background: #e8f5e9;
+  color: #1b5e20;
+}
+
+.account-status[data-tone='error'] {
+  background: #fdecea;
+  color: #8c1d18;
+}
+
+.greeting {
+  font-size: 1.15rem;
+  font-weight: 600;
+  margin-bottom: 4px;
+}
+
+.greeting:focus {
+  outline: none;
+}
+
+.passkey-list {
+  list-style: none;
+  display: grid;
+  gap: 10px;
+  margin-block: 8px 4px;
+}
+
+.passkey-item {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 12px;
+  padding: 10px 12px;
+  border: 1px solid var(--secondary);
+  border-radius: 8px;
+}
+
+.passkey-icon {
+  flex: none;
