+// The Daily Grind – passkey relying party (RP).
+//
+// The site is currently served as static files, so this module plays the role
+// of the account server. Every exported method maps 1:1 onto a JSON endpoint
+// and only exchanges JSON-serialisable data, so moving it behind real HTTP
+// endpoints means swapping these calls for fetch():
+//
+//   registerStart / registerFinish      POST /api/passkeys/register/{options,verify}
+//   authenticateStart / Finish          POST /api/passkeys/login/{options,verify}
+//   reauthenticateStart / Finish        POST /api/passkeys/reauth/{options,verify}
+//   addPasskeyStart / addPasskeyFinish  POST /api/account/passkeys/{options,verify}
+//   getAccount                          GET    /api/account
+//   updateProfile                       PATCH  /api/account
+//   renamePasskey / deletePasskey       PATCH|DELETE /api/account/passkeys/:id
+//   deleteAccount / signOut             DELETE /api/account, POST /api/logout
+//
+// All WebAuthn checks are done for real: challenge (single use, expiring),
+// origin, RP ID hash, user presence + verification flags, signature
+// verification against the stored COSE public key and signature counters.
+// In production the data below must live in a server database and the session
+// in an HttpOnly cookie – a browser can't be trusted to verify itself.
+
+import {
+  AUTH_FLAGS,
+  b64urlDecode,
+  b64urlEncode,
+  bytesEqual,
+  cborDecode,
+  concatBytes,
+  coseToJwk,
+  importPublicKey,
+  parseAuthenticatorData,
+  randomBytes,
+  sha256,
+  verifySignature,
+} from './webauthn-utils.js';
+
+export const RP_NAME = 'The Daily Grind';
+export const RP_ID = location.hostname;
+const EXPECTED_ORIGIN = location.origin;
+
+const DB_KEY = 'dailygrind.rp.v1';
+const SESSION_KEY = 'dailygrind.session.v1';
+const CHALLENGE_KEY = 'dailygrind.challenges.v1';
+
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+const SESSION_TTL_MS = 30 * 24 * 60 * 60 * 1000;
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const CEREMONY_TIMEOUT_MS = 5 * 60 * 1000;
+
+// Preference order: ES256 is universally supported, EdDSA and RS256 as fallbacks.
+const PUB_KEY_CRED_PARAMS = [-7, -8, -257].map((alg) => ({ type: 'public-key', alg }));
+
+// Friendly names for common passkey providers (from the community AAGUID list).
+const KNOWN_AAGUIDS = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+};
+
+export class RpError extends Error {
+  constructor(code, message, details = {}) {
+    super(message);
+    this.name = 'RpError';
+    this.code = code;
+    Object.assign(this, details);
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Storage                                                             */
+/* ------------------------------------------------------------------ */
+
+function readJSON(storage, key, fallback) {
+  try {
+    const raw = storage.getItem(key);
+    return raw ? JSON.parse(raw) : fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+function writeJSON(storage, key, value) {
+  storage.setItem(key, JSON.stringify(value));
+}
+
+const loadDb = () => readJSON(localStorage, DB_KEY, { users: {}, credentials: {} });
+const saveDb = (db) => writeJSON(localStorage, DB_KEY, db);
+
+function loadSession() {
+  const session = readJSON(localStorage, SESSION_KEY, null);
+  if (!session) return null;
+  if (session.expiresAt < Date.now() || !loadDb().users[session.userId]) {
+    localStorage.removeItem(SESSION_KEY);
+    return null;
+  }
+  return session;
+}
+
+function startSession(userId, credentialId) {
+  const now = Date.now();
+  // A full sign-in with user verification also counts as a fresh reauthentication.
+  writeJSON(localStorage, SESSION_KEY, {
+    userId,
+    credentialId,
+    signedInAt: now,
+    reauthenticatedAt: now,
+    expiresAt: now + SESSION_TTL_MS,
+  });
+}
+
+function requireSession() {
+  const session = loadSession();
+  if (!session) throw new RpError('unauthenticated', 'Please sign in to continue.');
+  return session;
+}
+
+function requireRecentReauth(session) {
+  if (!session.reauthenticatedAt || Date.now() - session.reauthenticatedAt > REAUTH_WINDOW_MS) {
+    throw new RpError('reauth_required', 'Please confirm it’s you with your passkey first.');
+  }
+}
+
+/* Challenges are single use, bound to a purpose (and user where relevant). */
+
+function issueChallenge(purpose, data = {}) {
+  const now = Date.now();
+  const all = readJSON(sessionStorage, CHALLENGE_KEY, {});
+  for (const [key, entry] of Object.entries(all)) if (entry.expiresAt < now) delete all[key];
+  const challenge = b64urlEncode(randomBytes(32));
+  all[challenge] = { purpose, data, expiresAt: now + CHALLENGE_TTL_MS };
+  writeJSON(sessionStorage, CHALLENGE_KEY, all);
+  return challenge;
+}
+
+function consumeChallenge(challenge, purpose) {
+  const all = readJSON(sessionStorage, CHALLENGE_KEY, {});
+  const entry = all[challenge];
+  if (entry) {
+    delete all[challenge];
+    writeJSON(sessionStorage, CHALLENGE_KEY, all);
+  }
+  if (!entry || entry.purpose !== purpose || entry.expiresAt < Date.now()) {
+    throw new RpError('invalid_challenge', 'This passkey request has expired. Please try again.');
+  }
+  return entry.data;
+}
+
+/* ------------------------------------------------------------------ */
+/* Validation helpers                                                  */
+/* ------------------------------------------------------------------ */
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+function normaliseEmail(email) {
+  const value = String(email ?? '').trim().toLowerCase();
+  if (!EMAIL_RE.test(value) || value.length > 254) throw new RpError('invalid_email', 'Please enter a valid email address.');
+  return value;
+}
+
+function normaliseName(name) {
+  const value = String(name ?? '').trim().replace(/\s+/g, ' ');
+  if (!value) throw new RpError('invalid_name', 'Please enter your name.');
+  if (value.length > 64) throw new RpError('invalid_name', 'Name must be 64 characters or fewer.');
+  return value;
+}
+
+function findUserByEmail(db, email) {
+  return Object.values(db.users).find((u) => u.email === email) ?? null;
+}
+
+function userCredentials(db, userId) {
+  return Object.values(db.credentials)
+    .filter((c) => c.userId === userId)
+    .sort((a, b) => a.createdAt - b.createdAt);
+}
+
+function descriptor(cred) {
+  return { type: 'public-key', id: cred.id, ...(cred.transports?.length ? { transports: cred.transports } : {}) };
+}
+
+function guessPasskeyName(aaguid, backupEligible, attachment) {
+  if (KNOWN_AAGUIDS[aaguid]) return KNOWN_AAGUIDS[aaguid];
+  if (attachment === 'cross-platform') return 'Security key';
+  const ua = navigator.userAgent;
+  const platform = /iPhone|iPad/.test(ua) ? 'iPhone/iPad' : /Android/.test(ua) ? 'Android' : /Mac/.test(ua) ? 'Mac' : /Windows/.test(ua) ? 'Windows' : /CrOS/.test(ua) ? 'Chromebook' : /Linux/.test(ua) ? 'Linux' : 'this device';
+  return backupEligible ? `Synced passkey (${platform})` : `Passkey on ${platform}`;
+}
+
+/* ------------------------------------------------------------------ */
+/* Core WebAuthn verification                                          */
+/* ------------------------------------------------------------------ */
+
+function parseClientData(clientDataB64, expectedType) {
+  const raw = b64urlDecode(clientDataB64);
+  let clientData;
+  try {
+    clientData = JSON.parse(new TextDecoder().decode(raw));
+  } catch {
+    throw new RpError('invalid_response', 'The passkey response could not be read.');
+  }
+  if (clientData.type !== expectedType) throw new RpError('invalid_response', 'Unexpected passkey response type.');
+  if (clientData.origin !== EXPECTED_ORIGIN) throw new RpError('invalid_origin', 'This passkey response came from a different website.');
+  if (clientData.crossOrigin === true) throw new RpError('invalid_origin', 'Cross-origin passkey requests are not allowed.');
+  return { raw, clientData };
+}
+
+async function checkAuthData(authData) {
+  const expectedHash = await sha256(new TextEncoder().encode(RP_ID));
+  if (!bytesEqual(authData.rpIdHash, expectedHash)) throw new RpError('invalid_rp', 'This passkey belongs to a different website.');
+  if (!authData.userPresent) throw new RpError('invalid_response', 'User presence was not confirmed.');
+  if (!authData.userVerified) throw new RpError('uv_required', 'Your device must verify it’s you (PIN, fingerprint or face).');
+  if (!authData.backupEligible && authData.backedUp) throw new RpError('invalid_response', 'Invalid passkey backup flags.');
+}
+
+async function verifyRegistration(credential, purpose) {
+  if (credential?.type !== 'public-key' || !credential.response?.attestationObject) {
+    throw new RpError('invalid_response', 'Invalid passkey registration response.');
+  }
+  const { clientData } = parseClientData(credential.response.clientDataJSON, 'webauthn.create');
+  const pending = consumeChallenge(clientData.challenge, purpose);
+
+  let attestation;
+  try {
+    attestation = cborDecode(b64urlDecode(credential.response.attestationObject)).value;
+  } catch {
+    throw new RpError('invalid_response', 'The passkey attestation could not be read.');
+  }
+  const authData = parseAuthenticatorData(attestation.get('authData'));
+  await checkAuthData(authData);
+  if (!authData.credentialId || !authData.credentialPublicKey) throw new RpError('invalid_response', 'No credential was returned.');
+
+  const credentialId = b64urlEncode(authData.credentialId);
+  if (credentialId !== credential.id || credentialId !== credential.rawId) throw new RpError('invalid_response', 'Credential ID mismatch.');
+  if (credentialId.length > 1366) throw new RpError('invalid_response', 'Credential ID is too long.');
+
+  let key;
+  try {
+    key = coseToJwk(authData.credentialPublicKey);
+    await importPublicKey(key.alg, key.jwk); // make sure we can verify future sign-ins
+  } catch (err) {
+    throw new RpError('unsupported_key', `This passkey provider uses a key type this browser can’t verify (${err.message}).`);
+  }
+
+  // Attestation format "none" was requested; we don't rely on attestation statements.
+  const credProps = credential.clientExtensionResults?.credProps;
+  return {
+    pending,
+    record: {
+      id: credentialId,
+      alg: key.alg,
+      publicKey: key.jwk,
+      signCount: authData.signCount,
+      transports: Array.isArray(credential.response.transports) ? credential.response.transports : [],
+      aaguid: authData.aaguid,
+      backupEligible: authData.backupEligible,
+      backedUp: authData.backedUp,
+      discoverable: credProps?.rk ?? null,
+      name: guessPasskeyName(authData.aaguid, authData.backupEligible, credential.authenticatorAttachment),
+      createdAt: Date.now(),
+      lastUsedAt: null,
+    },
+  };
+}
+
+async function verifyAssertion(credential, purpose) {
+  if (credential?.type !== 'public-key' || !credential.response?.signature) {
+    throw new RpError('invalid_response', 'Invalid passkey sign-in response.');
+  }
+  const { raw: clientDataRaw, clientData } = parseClientData(credential.response.clientDataJSON, 'webauthn.get');
+  const pending = consumeChallenge(clientData.challenge, purpose);
+
+  const db = loadDb();
+  const stored = db.credentials[credential.id];
+  if (!stored) {
+    throw new RpError('unknown_credential', 'This passkey is no longer linked to a Daily Grind account. It may have been removed.', {
+      credentialId: credential.id,
+    });
+  }
+  const user = db.users[stored.userId];
+  if (!user) throw new RpError('unknown_credential', 'This account no longer exists.', { credentialId: credential.id });
+
+  // When the browser returns a user handle it must match the passkey's owner.
+  const { userHandle } = credential.response;
+  if (userHandle && userHandle !== user.id) throw new RpError('invalid_response', 'Passkey user mismatch.');
+  if (pending.userId && pending.userId !== user.id) throw new RpError('wrong_account', 'Please use a passkey for the account you are signed in to.');
+  if (pending.allowCredentialIds && !pending.allowCredentialIds.includes(credential.id)) {
+    throw new RpError('invalid_response', 'That passkey was not offered for this request.');
+  }
+
+  const authDataBytes = b64urlDecode(credential.response.authenticatorData);
+  const authData = parseAuthenticatorData(authDataBytes);
+  await checkAuthData(authData);
+
+  const signedData = concatBytes(authDataBytes, await sha256(clientDataRaw));
+  let valid = false;
+  try {
+    valid = await verifySignature(stored.alg, stored.publicKey, b64urlDecode(credential.response.signature), signedData);
+  } catch {
+    valid = false;
+  }
+  if (!valid) throw new RpError('invalid_signature', 'The passkey signature could not be verified.');
+
+  // Signature counters: synced passkeys report 0. A non-increasing non-zero
+  // counter suggests a cloned authenticator.
+  if ((authData.signCount > 0 || stored.signCount > 0) && authData.signCount <= stored.signCount) {
+    throw new RpError('counter_error', 'This passkey looks like it may have been cloned. Sign in with another passkey and remove this one.');
+  }
+
+  stored.signCount = authData.signCount;
+  stored.backedUp = authData.backedUp;
+  stored.lastUsedAt = Date.now();
+  saveDb(db);
+  return { user, credential: stored };
+}
+
+/* ------------------------------------------------------------------ */
+/* Public API ("endpoints")                                            */
+/* ------------------------------------------------------------------ */
+
+function publicAccount(db, session) {
+  const user = db.users[session.userId];
+  return {
+    user: {
+      id: user.id,
+      name: user.name,
+      email: user.email,
+      createdAt: user.createdAt,
+    },
+    session: {
+      credentialId: session.credentialId,
+      signedInAt: session.signedInAt,
+      reauthenticatedUntil: (session.reauthenticatedAt ?? 0) + REAUTH_WINDOW_MS,
+    },
+    passkeys: userCredentials(db, user.id).map((c) => ({
+      id: c.id,
+      name: c.name,
+      provider: KNOWN_AAGUIDS[c.aaguid] ?? null,
+      createdAt: c.createdAt,
+      lastUsedAt: c.lastUsedAt,
+      synced: c.backedUp,
+      backupEligible: c.backupEligible,
+      transports: c.transports,
+      current: c.id === session.credentialId,
+    })),
+  };
+}
+
+function creationOptions(user, excludeCredentials = []) {
+  return {
+    challenge: '', // filled by caller
+    rp: { id: RP_ID, name: RP_NAME },
+    user: { id: user.id, name: user.email, displayName: user.name },
+    pubKeyCredParams: PUB_KEY_CRED_PARAMS,
+    authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'required' },
+    attestation: 'none',
+    excludeCredentials,
+    timeout: CEREMONY_TIMEOUT_MS,
+    extensions: { credProps: true },
+  };
+}
+
+/** Step 1 of sign-up: validate details and get passkey creation options. No account exists until step 2 succeeds. */
+export async function registerStart({ name, email }) {
+  const db = loadDb();
+  const pendingUser = { id: b64urlEncode(randomBytes(16)), name: normaliseName(name), email: normaliseEmail(email) };
+  if (findUserByEmail(db, pendingUser.email)) {
+    throw new RpError('email_taken', 'An account with this email already exists. Sign in with your passkey instead.');
+  }
+  const options = creationOptions(pendingUser);
+  options.challenge = issueChallenge('register', { user: pendingUser });
+  return options;
+}
+
+export async function registerFinish(credential) {
+  const { pending, record } = await verifyRegistration(credential, 'register');
+  const db = loadDb();
+  const { user: pendingUser } = pending;
+  if (findUserByEmail(db, pendingUser.email)) throw new RpError('email_taken', 'An account with this email already exists.');
+  if (db.credentials[record.id]) throw new RpError('credential_exists', 'This passkey is already registered.');
+
+  db.users[pendingUser.id] = { ...pendingUser, createdAt: Date.now() };
+  record.userId = pendingUser.id;
+  record.lastUsedAt = Date.now();
+  db.credentials[record.id] = record;
+  saveDb(db);
+  startSession(pendingUser.id, record.id);
+  return getAccount();
+}
+
+/**
+ * Sign-in options. With no email, an empty allowCredentials list lets the
+ * browser offer any discoverable Daily Grind passkey (also used for autofill).
+ * Unknown emails get the same response shape to avoid revealing accounts.
+ */
+export async function authenticateStart({ email } = {}) {
+  let allowCredentials = [];
+  if (email) {
+    const db = loadDb();
+    const user = findUserByEmail(db, normaliseEmail(email));
+    if (user) allowCredentials = userCredentials(db, user.id).map(descriptor);
+  }
+  return {
+    challenge: issueChallenge('authenticate'),
+    rpId: RP_ID,
+    allowCredentials,
+    userVerification: 'required',
+    timeout: CEREMONY_TIMEOUT_MS,
+  };
+}
+
+export async function authenticateFinish(credential) {
+  const { user, credential: stored } = await verifyAssertion(credential, 'authenticate');
+  startSession(user.id, stored.id);
+  return getAccount();
+}
+
+/** Reauthentication: only the signed-in user's passkeys are acceptable. */
+export async function reauthenticateStart() {
+  const session = requireSession();
+  const db = loadDb();
+  const creds = userCredentials(db, session.userId);
+  return {
+    challenge: issueChallenge('reauthenticate', { userId: session.userId, allowCredentialIds: creds.map((c) => c.id) }),
+    rpId: RP_ID,
+    allowCredentials: creds.map(descriptor),
+    userVerification: 'required',
+    timeout: CEREMONY_TIMEOUT_MS,
+  };
+}
+
+export async function reauthenticateFinish(credential) {
+  const session = requireSession();
+  const { user, credential: stored } = await verifyAssertion(credential, 'reauthenticate');
+  if (user.id !== session.userId) throw new RpError('wrong_account', 'Please use a passkey for the account you are signed in to.');
+  writeJSON(localStorage, SESSION_KEY, { ...session, reauthenticatedAt: Date.now(), credentialId: stored.id });
+  return getAccount();
+}
+
+export async function addPasskeyStart() {
+  const session = requireSession();
+  const db = loadDb();
+  const user = db.users[session.userId];
+  const options = creationOptions(user, userCredentials(db, user.id).map(descriptor));
+  options.challenge = issueChallenge('add-passkey', { userId: user.id });
+  return options;
+}
+
+export async function addPasskeyFinish(credential) {
+  const session = requireSession();
+  const { pending, record } = await verifyRegistration(credential, 'add-passkey');
+  if (pending.userId !== session.userId) throw new RpError('wrong_account', 'Your session changed. Please try again.');
+  const db = loadDb();
+  if (db.credentials[record.id]) throw new RpError('credential_exists', 'This passkey is already registered.');
+  record.userId = session.userId;
+  db.credentials[record.id] = record;
+  saveDb(db);
+  return getAccount();
+}
+
+export async function getAccount() {
+  const session = loadSession();
+  if (!session) return null;
+  return publicAccount(loadDb(), session);
+}
+
+export async function updateProfile({ name, email }) {
+  const session = requireSession();
+  const db = loadDb();
+  const user = db.users[session.userId];
+  const newName = normaliseName(name);
+  const newEmail = normaliseEmail(email);
+
+  if (newEmail !== user.email) {
+    // Changing the sign-in identifier is sensitive: require a fresh passkey check.
+    requireRecentReauth(session);
+    const other = findUserByEmail(db, newEmail);
+    if (other && other.id !== user.id) throw new RpError('email_taken', 'That email is already used by another account.');
+  }
+  user.name = newName;
+  user.email = newEmail;
+  saveDb(db);
+  return getAccount();
+}
+
+export async function renamePasskey(credentialId, name) {
+  const session = requireSession();
+  const db = loadDb();
+  const cred = db.credentials[credentialId];
+  if (!cred || cred.userId !== session.userId) throw new RpError('not_found', 'Passkey not found.');
+  const value = String(name ?? '').trim().replace(/\s+/g, ' ');
+  if (!value) throw new RpError('invalid_name', 'Please give your passkey a name.');
+  if (value.length > 64) throw new RpError('invalid_name', 'Passkey names must be 64 characters or fewer.');
+  cred.name = value;
+  saveDb(db);
+  return getAccount();
+}
+
+export async function deletePasskey(credentialId) {
+  const session = requireSession();
+  requireRecentReauth(session);
+  const db = loadDb();
+  const cred = db.credentials[credentialId];
+  if (!cred || cred.userId !== session.userId) throw new RpError('not_found', 'Passkey not found.');
+  if (userCredentials(db, session.userId).length <= 1) {
+    throw new RpError('last_passkey', 'You can’t remove your only passkey – add another one first so you don’t get locked out.');
+  }
+  delete db.credentials[credentialId];
+  saveDb(db);
+  return getAccount();
+}
+
+export async function deleteAccount() {
+  const session = requireSession();
+  requireRecentReauth(session);
+  const db = loadDb();
+  for (const cred of userCredentials(db, session.userId)) delete db.credentials[cred.id];
+  delete db.users[session.userId];
+  saveDb(db);
+  localStorage.removeItem(SESSION_KEY);
+}
+
+export async function signOut() {
+  localStorage.removeItem(SESSION_KEY);
+}
