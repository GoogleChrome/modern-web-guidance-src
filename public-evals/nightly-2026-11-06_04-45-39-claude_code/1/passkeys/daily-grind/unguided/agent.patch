+// "My Account" UI: passkey sign-up, sign-in (button + autofill), passkey
+// management, profile updates and reauthentication for sensitive actions.
+
+import * as rp from './passkey-rp.js';
+import { credentialToJSON, creationOptionsFromJSON, requestOptionsFromJSON } from './webauthn-utils.js';
+
+const $ = (sel, root = document) => root.querySelector(sel);
+
+const els = {
+  dialog: $('#account-dialog'),
+  status: $('#account-status'),
+  unsupported: $('#passkey-unsupported'),
+  signedOut: $('#view-signed-out'),
+  signedIn: $('#view-signed-in'),
+  tabs: document.querySelectorAll('#account-dialog [role="tab"]'),
+  signInPanel: $('#panel-signin'),
+  registerPanel: $('#panel-register'),
+  signInButton: $('#signin-passkey'),
+  signInForm: $('#signin-form'),
+  signInEmail: $('#signin-email'),
+  registerForm: $('#register-form'),
+  greetingName: $('#greeting-name'),
+  memberSince: $('#member-since'),
+  profileForm: $('#profile-form'),
+  profileName: $('#profile-name'),
+  profileEmail: $('#profile-email'),
+  passkeyList: $('#passkey-list'),
+  passkeyTemplate: $('#passkey-item-template'),
+  addPasskey: $('#add-passkey'),
+  reauthState: $('#reauth-state'),
+  reauthButton: $('#reauth-button'),
+  signOut: $('#sign-out'),
+  deleteAccount: $('#delete-account'),
+  confirm: $('#confirm-dialog'),
+  confirmTitle: $('#confirm-title'),
+  confirmMessage: $('#confirm-message'),
+  confirmNote: $('#confirm-reauth-note'),
+  confirmOk: $('#confirm-ok'),
+  confirmCancel: $('#confirm-cancel'),
+  navAccount: $('#nav-account'),
+  navAccountLabel: $('#nav-account-label'),
+  navLogout: $('#nav-logout'),
+};
+
+let account = null;
+let conditionalController = null;
+let reauthTimer = null;
+
+const passkeysSupported =
+  window.isSecureContext &&
+  typeof window.PublicKeyCredential === 'function' &&
+  typeof navigator.credentials?.create === 'function' &&
+  typeof navigator.credentials?.get === 'function';
+
+/* ------------------------------------------------------------------ */
+/* Status messages                                                     */
+/* ------------------------------------------------------------------ */
+
+function showStatus(message, tone = 'info') {
+  if (!message) return clearStatus();
+  els.status.textContent = message;
+  els.status.dataset.tone = tone;
+  els.status.hidden = false;
+}
+
+function clearStatus() {
+  els.status.hidden = true;
+  els.status.textContent = '';
+}
+
+function describeError(err) {
+  if (!err) return 'Something went wrong. Please try again.';
+  if (err instanceof rp.RpError) return err.message;
+  switch (err.name) {
+    case 'AbortError':
+      return null; // we cancelled it ourselves
+    case 'NotAllowedError':
+      return 'The passkey request was cancelled or timed out.';
+    case 'InvalidStateError':
+      return 'A passkey for this account is already saved on this device or password manager.';
+    case 'SecurityError':
+      return 'Passkeys aren’t available on this address. Use HTTPS or localhost.';
+    case 'NotSupportedError':
+      return 'Your device doesn’t support the kind of passkey we need.';
+    default:
+      return err.message || 'Something went wrong. Please try again.';
+  }
+}
+
+async function busy(button, label, task) {
+  const original = button?.textContent;
+  if (button) {
+    button.disabled = true;
+    button.setAttribute('aria-busy', 'true');
+    if (label) button.textContent = label;
+  }
+  try {
+    return await task();
+  } finally {
+    if (button) {
+      button.disabled = false;
+      button.removeAttribute('aria-busy');
+      if (label) button.textContent = original;
+    }
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Signal API – keep passkey providers in sync with the account        */
+/* ------------------------------------------------------------------ */
+
+async function signal(method, payload) {
+  try {
+    if (typeof PublicKeyCredential?.[method] === 'function') await PublicKeyCredential[method](payload);
+  } catch (err) {
+    console.debug(`PublicKeyCredential.${method} failed`, err);
+  }
+}
+
+function syncProvider(acct) {
+  if (!acct) return;
+  signal('signalAllAcceptedCredentials', {
+    rpId: rp.RP_ID,
+    userId: acct.user.id,
+    allAcceptedCredentialIds: acct.passkeys.map((p) => p.id),
+  });
+  signal('signalCurrentUserDetails', {
+    rpId: rp.RP_ID,
+    userId: acct.user.id,
+    name: acct.user.email,
+    displayName: acct.user.name,
+  });
+}
+
+/* ------------------------------------------------------------------ */
+/* WebAuthn ceremonies                                                 */
+/* ------------------------------------------------------------------ */
+
+function abortConditional() {
+  if (conditionalController) {
+    conditionalController.abort(new DOMException('Replaced by another passkey request', 'AbortError'));
+    conditionalController = null;
+  }
+}
+
+async function createPasskey(optionsJSON) {
+  abortConditional();
+  const credential = await navigator.credentials.create({ publicKey: creationOptionsFromJSON(optionsJSON) });
+  return credentialToJSON(credential);
+}
+
+async function getPasskey(optionsJSON, extra = {}) {
+  if (extra.mediation !== 'conditional') abortConditional();
+  const credential = await navigator.credentials.get({ publicKey: requestOptionsFromJSON(optionsJSON), ...extra });
+  return credentialToJSON(credential);
+}
+
+async function handleSignInError(err) {
+  if (err instanceof rp.RpError && err.code === 'unknown_credential' && err.credentialId) {
+    // Ask the passkey provider to hide/remove the stale passkey.
+    await signal('signalUnknownCredential', { rpId: rp.RP_ID, credentialId: err.credentialId });
+  }
+  const message = describeError(err);
+  if (message) showStatus(message, 'error');
+}
+
+async function completeSignIn(acct) {
+  account = acct;
+  syncProvider(acct);
+  render();
+  showStatus(`Welcome back, ${acct.user.name}!`, 'success');
+}
+
+async function startConditionalSignIn() {
+  if (!passkeysSupported || account || conditionalController || !els.dialog.open) return;
+  try {
+    if (!(await PublicKeyCredential.isConditionalMediationAvailable?.())) return;
+  } catch {
+    return;
+  }
+  const controller = new AbortController();
+  conditionalController = controller;
+  try {
+    const options = await rp.authenticateStart();
+    if (controller.signal.aborted) return;
+    const credential = await getPasskey(options, { mediation: 'conditional', signal: controller.signal });
+    if (conditionalController === controller) conditionalController = null;
+    await completeSignIn(await rp.authenticateFinish(credential));
+  } catch (err) {
+    if (conditionalController === controller) conditionalController = null;
+    if (err?.name === 'AbortError' || controller.signal.aborted) return;
+    await handleSignInError(err);
+  }
+}
+
+async function signInWithPasskey(email) {
+  clearStatus();
+  try {
+    const options = await rp.authenticateStart(email ? { email } : {});
+    const credential = await getPasskey(options);
+    await completeSignIn(await rp.authenticateFinish(credential));
+  } catch (err) {
+    await handleSignInError(err);
+    startConditionalSignIn();
+  }
+}
+
+function reauthIsFresh() {
+  return !!account && account.session.reauthenticatedUntil > Date.now() + 5000;
+}
+
+/** Prompts for a passkey check. Must run inside a user gesture (click/submit). */
+async function reauthenticate() {
+  const options = await rp.reauthenticateStart();
+  const credential = await getPasskey(options);
+  account = await rp.reauthenticateFinish(credential);
+  render();
+}
+
+/** Runs a sensitive action, asking the user to confirm with a passkey first if needed. */
+async function withReauth(action) {
+  if (!reauthIsFresh()) await reauthenticate();
+  try {
+    return await action();
+  } catch (err) {
+    // The server's reauth window may have lapsed between checks: try once more.
+    if (err instanceof rp.RpError && err.code === 'reauth_required') {
+      await reauthenticate();
+      return action();
+    }
+    throw err;
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Confirmation dialog                                                 */
+/* ------------------------------------------------------------------ */
+
+function confirmAction({ title, message, confirmLabel, danger = false, sensitive = false, run }) {
+  els.confirmTitle.textContent = title;
+  els.confirmMessage.textContent = message;
+  els.confirmOk.textContent = confirmLabel;
+  els.confirmOk.classList.toggle('btn-danger', danger);
+  const needsReauth = sensitive && !reauthIsFresh();
+  els.confirmNote.hidden = !needsReauth;
+
+  const onOk = async () => {
+    els.confirmOk.disabled = true;
+    els.confirmCancel.disabled = true;
+    try {
+      // The click on "confirm" is the user gesture that lets us show the passkey prompt.
+      await (sensitive ? withReauth(run) : run());
+      els.confirm.close();
+    } catch (err) {
+      els.confirm.close();
+      const msg = describeError(err);
+      if (msg) showStatus(msg, 'error');
+    } finally {
+      els.confirmOk.disabled = false;
+      els.confirmCancel.disabled = false;
+    }
+  };
+  els.confirmOk.onclick = onOk;
+  els.confirmCancel.onclick = () => els.confirm.close();
+  els.confirm.showModal();
+}
+
+/* ------------------------------------------------------------------ */
+/* Rendering                                                           */
+/* ------------------------------------------------------------------ */
+
+const dateFmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+const dateTimeFmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+
+function relativeTime(ts) {
+  if (!ts) return 'Never used';
+  const diff = Date.now() - ts;
+  if (diff < 60_000) return 'Used just now';
+  if (diff < 3_600_000) return `Used ${Math.round(diff / 60_000)} min ago`;
+  if (diff < 86_400_000) return `Used ${Math.round(diff / 3_600_000)} h ago`;
+  return `Last used ${dateFmt.format(ts)}`;
+}
+
+function render() {
+  const signedIn = !!account;
+  els.signedOut.hidden = signedIn;
+  els.signedIn.hidden = !signedIn;
+  els.navLogout.hidden = !signedIn;
+  els.navAccountLabel.textContent = signedIn ? 'My Account' : 'Sign In';
+
+  if (!signedIn) {
+    clearInterval(reauthTimer);
+    reauthTimer = null;
+    return;
+  }
+
+  const { user, passkeys } = account;
+  els.greetingName.textContent = user.name.split(' ')[0];
+  els.memberSince.textContent = dateFmt.format(user.createdAt);
+  if (document.activeElement?.form !== els.profileForm) {
+    els.profileName.value = user.name;
+    els.profileEmail.value = user.email;
+  }
+  renderPasskeys(passkeys);
+  renderReauthState();
+  if (!reauthTimer) reauthTimer = setInterval(renderReauthState, 15_000);
+}
+
+function renderReauthState() {
+  if (!account) return;
+  if (reauthIsFresh()) {
+    const mins = Math.max(1, Math.ceil((account.session.reauthenticatedUntil - Date.now()) / 60_000));
+    els.reauthState.textContent = `Identity confirmed – you can make sensitive changes for the next ${mins} min.`;
+    els.reauthState.dataset.state = 'fresh';
+    els.reauthButton.hidden = true;
+  } else {
+    els.reauthState.textContent = 'Changing your email, removing passkeys or deleting your account will ask you to confirm it’s you with a passkey.';
+    els.reauthState.dataset.state = 'stale';
+    els.reauthButton.hidden = false;
+  }
+}
+
+function renderPasskeys(passkeys) {
+  els.passkeyList.replaceChildren();
+  for (const pk of passkeys) {
+    const item = els.passkeyTemplate.content.firstElementChild.cloneNode(true);
+    item.dataset.id = pk.id;
+    $('.passkey-name', item).textContent = pk.name;
+    $('.passkey-current', item).hidden = !pk.current;
+
+    const meta = [`Created ${dateFmt.format(pk.createdAt)}`, relativeTime(pk.lastUsedAt)];
+    if (pk.provider && pk.provider !== pk.name) meta.unshift(pk.provider);
+    $('.passkey-meta', item).textContent = meta.join(' · ');
+    $('.passkey-meta', item).title = pk.lastUsedAt ? `Last used ${dateTimeFmt.format(pk.lastUsedAt)}` : '';
+
+    const badge = $('.passkey-sync', item);
+    badge.textContent = pk.synced ? 'Synced' : pk.backupEligible ? 'Not backed up' : 'This device only';
+    badge.title = pk.synced
+      ? 'Backed up by your password manager and available on your other devices'
+      : 'Stored on a single device or security key';
+
+    $('.passkey-rename', item).addEventListener('click', () => startRename(item, pk));
+    const del = $('.passkey-delete', item);
+    del.addEventListener('click', () => removePasskey(pk));
+    if (passkeys.length <= 1) {
+      del.disabled = true;
+      del.title = 'Add another passkey before removing this one';
+    }
+    els.passkeyList.append(item);
+  }
+}
+
+function startRename(item, pk) {
+  const view = $('.passkey-view', item);
+  const form = $('.passkey-rename-form', item);
+  const input = $('input', form);
+  view.hidden = true;
+  form.hidden = false;
+  input.value = pk.name;
+  input.focus();
+  input.select();
+
+  const finish = () => {
+    form.hidden = true;
+    view.hidden = false;
+  };
+  form.onsubmit = async (e) => {
+    e.preventDefault();
+    try {
+      account = await rp.renamePasskey(pk.id, input.value);
+      render();
+      showStatus('Passkey renamed.', 'success');
+    } catch (err) {
+      showStatus(describeError(err), 'error');
+      finish();
+    }
+  };
+  $('.passkey-rename-cancel', form).onclick = finish;
+  input.onkeydown = (e) => {
+    if (e.key === 'Escape') {
+      e.preventDefault();
+      e.stopPropagation();
+      finish();
+    }
+  };
+}
+
+/* ------------------------------------------------------------------ */
+/* Actions                                                             */
+/* ------------------------------------------------------------------ */
+
+function removePasskey(pk) {
+  confirmAction({
+    title: 'Remove this passkey?',
+    message: `“${pk.name}” will no longer be able to sign in to your Daily Grind account.${pk.current ? ' You signed in with this passkey on this device.' : ''}`,
+    confirmLabel: 'Remove passkey',
+    danger: true,
+    sensitive: true,
+    run: async () => {
+      account = await rp.deletePasskey(pk.id);
+      syncProvider(account); // tells the provider to hide the removed passkey
+      render();
+      showStatus('Passkey removed. You may also want to delete it from your password manager.', 'success');
+    },
+  });
+}
+
+async function addPasskey() {
+  clearStatus();
+  await busy(els.addPasskey, 'Waiting for passkey…', async () => {
+    try {
+      const options = await rp.addPasskeyStart();
+      const credential = await createPasskey(options);
+      account = await rp.addPasskeyFinish(credential);
+      render();
+      showStatus('New passkey saved. You can now use it to sign in.', 'success');
+    } catch (err) {
+      const msg = describeError(err);
+      if (msg) showStatus(msg, 'error');
+    }
+  });
+}
+
+async function register(event) {
+  event.preventDefault();
+  clearStatus();
+  const data = new FormData(els.registerForm);
+  const button = $('button[type="submit"]', els.registerForm);
+  await busy(button, 'Creating your passkey…', async () => {
+    try {
+      const options = await rp.registerStart({ name: data.get('name'), email: data.get('email') });
+      const credential = await createPasskey(options);
+      account = await rp.registerFinish(credential);
+      els.registerForm.reset();
+      render();
+      showStatus(`Welcome to The Daily Grind, ${account.user.name}! Your passkey is ready – no password needed.`, 'success');
+    } catch (err) {
+      const msg = describeError(err);
+      if (msg) showStatus(msg, 'error');
+    }
+  });
+}
+
+async function saveProfile(event) {
+  event.preventDefault();
+  clearStatus();
+  const name = els.profileName.value;
+  const email = els.profileEmail.value;
+  const emailChanged = email.trim().toLowerCase() !== account.user.email;
+  const button = $('button[type="submit"]', els.profileForm);
+
+  await busy(button, emailChanged && !reauthIsFresh() ? 'Confirm with passkey…' : 'Saving…', async () => {
+    try {
+      const run = () => rp.updateProfile({ name, email });
+      if (emailChanged && !reauthIsFresh()) showStatus('Confirm it’s you with your passkey to change your email.');
+      account = emailChanged ? await withReauth(run) : await run();
+      // Update the name/email shown in passkey pickers.
+      syncProvider(account);
+      els.profileName.blur();
+      els.profileEmail.blur();
+      render();
+      els.profileName.value = account.user.name;
+      els.profileEmail.value = account.user.email;
+      showStatus('Profile updated.', 'success');
+    } catch (err) {
+      const msg = describeError(err);
+      if (msg) showStatus(msg, 'error');
+    }
+  });
+}
+
+async function confirmIdentity() {
+  clearStatus();
+  await busy(els.reauthButton, 'Waiting for passkey…', async () => {
+    try {
+      await reauthenticate();
+      showStatus('Thanks – identity confirmed.', 'success');
+    } catch (err) {
+      const msg = describeError(err);
+      if (msg) showStatus(msg, 'error');
+    }
+  });
+}
+
+async function signOut() {
+  await rp.signOut();
+  account = null;
+  render();
+  selectTab('signin');
+  showStatus('You’ve been signed out.', 'info');
+  if (els.dialog.open) startConditionalSignIn();
+}
+
+function deleteAccount() {
+  confirmAction({
+    title: 'Delete your account?',
+    message: 'Your profile, rewards and saved passkeys will be permanently deleted. This can’t be undone.',
+    confirmLabel: 'Delete account',
+    danger: true,
+    sensitive: true,
+    run: async () => {
+      const userId = account.user.id;
+      await rp.deleteAccount();
+      // An empty accepted list tells providers to hide all passkeys for this account.
+      signal('signalAllAcceptedCredentials', { rpId: rp.RP_ID, userId, allAcceptedCredentialIds: [] });
+      account = null;
+      render();
+      selectTab('signin');
+      showStatus('Your account has been deleted. Remember to remove the passkey from your password manager too.', 'info');
+    },
+  });
+}
+
+/* ------------------------------------------------------------------ */
+/* Dialog, tabs and wiring                                             */
+/* ------------------------------------------------------------------ */
+
+function selectTab(name) {
+  for (const tab of els.tabs) {
+    const selected = tab.dataset.tab === name;
+    tab.setAttribute('aria-selected', String(selected));
+    tab.tabIndex = selected ? 0 : -1;
+  }
+  els.signInPanel.hidden = name !== 'signin';
+  els.registerPanel.hidden = name !== 'register';
+  if (name === 'signin') startConditionalSignIn();
+}
+
+function openAccount() {
+  if (!els.dialog.open) els.dialog.showModal();
+  if (!account) startConditionalSignIn();
+}
+
+function init() {
+  if (!passkeysSupported) {
+    els.unsupported.hidden = false;
+    for (const el of [els.signInButton, ...els.signInForm.elements, ...els.registerForm.elements, els.addPasskey, els.reauthButton]) {
+      el.disabled = true;
+    }
+  }
+
+  els.navAccount.addEventListener('click', (e) => {
+    e.preventDefault();
+    history.replaceState(null, '', '#account');
+    openAccount();
+  });
+  els.navLogout.addEventListener('click', (e) => {
+    e.preventDefault();
+    signOut();
+  });
+  els.dialog.addEventListener('close', () => {
+    abortConditional();
+    clearStatus();
+    if (location.hash === '#account') history.replaceState(null, '', location.pathname + location.search);
+  });
+  els.dialog.addEventListener('click', (e) => {
+    if (e.target === els.dialog) els.dialog.close(); // backdrop click
+  });
+  $('[data-close]', els.dialog).addEventListener('click', () => els.dialog.close());
+
+  for (const tab of els.tabs) {
+    tab.addEventListener('click', () => {
+      clearStatus();
+      selectTab(tab.dataset.tab);
+    });
+    tab.addEventListener('keydown', (e) => {
+      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
+      const tabs = [...els.tabs];
+      const next = tabs[(tabs.indexOf(tab) + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
+      next.focus();
+      next.click();
+    });
+  }
+
+  els.signInButton.addEventListener('click', () => busy(els.signInButton, 'Waiting for passkey…', () => signInWithPasskey()));
+  els.signInForm.addEventListener('submit', (e) => {
+    e.preventDefault();
+    const button = $('button[type="submit"]', els.signInForm);
+    busy(button, 'Waiting for passkey…', () => signInWithPasskey(els.signInEmail.value));
+  });
+  els.registerForm.addEventListener('submit', register);
+  els.profileForm.addEventListener('submit', saveProfile);
+  els.addPasskey.addEventListener('click', addPasskey);
+  els.reauthButton.addEventListener('click', confirmIdentity);
+  els.signOut.addEventListener('click', signOut);
+  els.deleteAccount.addEventListener('click', deleteAccount);
+
+  // Keep multiple tabs in sync (sign-in/out elsewhere).
+  window.addEventListener('storage', async (e) => {
+    if (e.key && !e.key.startsWith('dailygrind.')) return;
+    account = await rp.getAccount();
+    render();
+  });
+
+  rp.getAccount().then((acct) => {
+    account = acct;
+    render();
+    selectTab('signin');
+    if (location.hash === '#account') openAccount();
+  });
+}
+
+init();
