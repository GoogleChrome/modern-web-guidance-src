+// Low-level WebAuthn helpers: base64url, CBOR, authenticator data parsing,
+// COSE key conversion and signature verification with WebCrypto.
+
+/* ------------------------------------------------------------------ */
+/* base64url                                                           */
+/* ------------------------------------------------------------------ */
+
+export function toBytes(input) {
+  if (input instanceof Uint8Array) return input;
+  if (input instanceof ArrayBuffer) return new Uint8Array(input);
+  if (ArrayBuffer.isView(input)) return new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
+  throw new TypeError('Expected binary data');
+}
+
+export function b64urlEncode(input) {
+  const bytes = toBytes(input);
+  let bin = '';
+  for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
+  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function b64urlDecode(str) {
+  if (typeof str !== 'string') throw new TypeError('Expected base64url string');
+  const b64 = str.replace(/-/g, '+').replace(/_/g, '/');
+  const bin = atob(b64 + '='.repeat((4 - (b64.length % 4)) % 4));
+  const out = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+  return out;
+}
+
+export function randomBytes(length) {
+  return crypto.getRandomValues(new Uint8Array(length));
+}
+
+export function bytesEqual(a, b) {
+  if (a.length !== b.length) return false;
+  let diff = 0;
+  for (let i = 0; i < a.length; i++) diff |= a[i] ^ b[i];
+  return diff === 0;
+}
+
+export function concatBytes(...parts) {
+  const total = parts.reduce((n, p) => n + p.length, 0);
+  const out = new Uint8Array(total);
+  let offset = 0;
+  for (const p of parts) {
+    out.set(p, offset);
+    offset += p.length;
+  }
+  return out;
+}
+
+export async function sha256(data) {
+  return new Uint8Array(await crypto.subtle.digest('SHA-256', toBytes(data)));
+}
+
+/* ------------------------------------------------------------------ */
+/* Minimal CBOR decoder (RFC 8949) – enough for attestation objects    */
+/* ------------------------------------------------------------------ */
+
+export function cborDecode(input, startOffset = 0) {
+  const bytes = toBytes(input);
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  let offset = startOffset;
+
+  function readLength(info) {
+    if (info < 24) return info;
+    if (info === 24) return bytes[offset++];
+    if (info === 25) { const v = view.getUint16(offset); offset += 2; return v; }
+    if (info === 26) { const v = view.getUint32(offset); offset += 4; return v; }
+    if (info === 27) {
+      const hi = view.getUint32(offset);
+      const lo = view.getUint32(offset + 4);
+      offset += 8;
+      const v = hi * 2 ** 32 + lo;
+      if (!Number.isSafeInteger(v)) throw new Error('CBOR integer too large');
+      return v;
+    }
+    throw new Error('Unsupported CBOR length encoding');
+  }
+
+  function readItem() {
+    if (offset >= bytes.length) throw new Error('Unexpected end of CBOR data');
+    const initial = bytes[offset++];
+    const major = initial >> 5;
+    const info = initial & 0x1f;
+
+    switch (major) {
+      case 0: return readLength(info);
+      case 1: return -1 - readLength(info);
+      case 2: {
+        const len = readLength(info);
+        if (offset + len > bytes.length) throw new Error('CBOR byte string overruns buffer');
+        const v = bytes.slice(offset, offset + len);
+        offset += len;
+        return v;
+      }
+      case 3: {
+        const len = readLength(info);
+        if (offset + len > bytes.length) throw new Error('CBOR text string overruns buffer');
+        const v = new TextDecoder().decode(bytes.subarray(offset, offset + len));
+        offset += len;
+        return v;
+      }
+      case 4: {
+        const len = readLength(info);
+        const arr = [];
+        for (let i = 0; i < len; i++) arr.push(readItem());
+        return arr;
+      }
+      case 5: {
+        const len = readLength(info);
+        const map = new Map();
+        for (let i = 0; i < len; i++) {
+          const key = readItem();
+          map.set(key, readItem());
+        }
+        return map;
+      }
+      case 6: readLength(info); return readItem(); // ignore tags
+      case 7: {
+        if (info === 20) return false;
+        if (info === 21) return true;
+        if (info === 22) return null;
+        if (info === 23) return undefined;
+        if (info === 25) { const v = view.getFloat16 ? view.getFloat16(offset) : NaN; offset += 2; return v; }
+        if (info === 26) { const v = view.getFloat32(offset); offset += 4; return v; }
+        if (info === 27) { const v = view.getFloat64(offset); offset += 8; return v; }
+        throw new Error('Unsupported CBOR simple value');
+      }
+      default:
+        throw new Error('Invalid CBOR major type');
+    }
+  }
+
+  const value = readItem();
+  return { value, offset };
+}
+
+/* ------------------------------------------------------------------ */
+/* Authenticator data                                                  */
+/* ------------------------------------------------------------------ */
+
+export const AUTH_FLAGS = {
+  UP: 0x01, // user present
+  UV: 0x04, // user verified
+  BE: 0x08, // backup eligible (multi-device / synced passkey)
+  BS: 0x10, // backup state (currently backed up)
+  AT: 0x40, // attested credential data included
+  ED: 0x80, // extension data included
+};
+
+function formatAaguid(bytes) {
+  const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
+
+export function parseAuthenticatorData(input) {
+  const bytes = toBytes(input);
+  if (bytes.length < 37) throw new Error('Authenticator data is too short');
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  const flags = bytes[32];
+  const result = {
+    rpIdHash: bytes.slice(0, 32),
+    flags,
+    userPresent: !!(flags & AUTH_FLAGS.UP),
+    userVerified: !!(flags & AUTH_FLAGS.UV),
+    backupEligible: !!(flags & AUTH_FLAGS.BE),
+    backedUp: !!(flags & AUTH_FLAGS.BS),
+    signCount: view.getUint32(33),
+  };
+
+  if (flags & AUTH_FLAGS.AT) {
+    if (bytes.length < 55) throw new Error('Attested credential data is truncated');
+    result.aaguid = formatAaguid(bytes.subarray(37, 53));
+    const idLength = view.getUint16(53);
+    const idEnd = 55 + idLength;
+    if (idEnd > bytes.length) throw new Error('Credential ID overruns authenticator data');
+    result.credentialId = bytes.slice(55, idEnd);
+    const { value } = cborDecode(bytes, idEnd);
+    if (!(value instanceof Map)) throw new Error('Credential public key is not a COSE map');
+    result.credentialPublicKey = value;
+  }
+  return result;
+}
+
+/* ------------------------------------------------------------------ */
+/* COSE keys → JWK, and signature verification                         */
+/* ------------------------------------------------------------------ */
+
+export const COSE_ALG = { ES256: -7, ES384: -35, ES512: -36, EdDSA: -8, RS256: -257, PS256: -37 };
+
+const ALGORITHMS = {
+  [COSE_ALG.ES256]: { importParams: { name: 'ECDSA', namedCurve: 'P-256' }, verifyParams: { name: 'ECDSA', hash: 'SHA-256' }, ecSize: 32 },
+  [COSE_ALG.ES384]: { importParams: { name: 'ECDSA', namedCurve: 'P-384' }, verifyParams: { name: 'ECDSA', hash: 'SHA-384' }, ecSize: 48 },
+  [COSE_ALG.ES512]: { importParams: { name: 'ECDSA', namedCurve: 'P-521' }, verifyParams: { name: 'ECDSA', hash: 'SHA-512' }, ecSize: 66 },
+  [COSE_ALG.EdDSA]: { importParams: { name: 'Ed25519' }, verifyParams: { name: 'Ed25519' } },
+  [COSE_ALG.RS256]: { importParams: { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' }, verifyParams: { name: 'RSASSA-PKCS1-v1_5' } },
+  [COSE_ALG.PS256]: { importParams: { name: 'RSA-PSS', hash: 'SHA-256' }, verifyParams: { name: 'RSA-PSS', saltLength: 32 } },
+};
+
+const EC_CURVES = { 1: 'P-256', 2: 'P-384', 3: 'P-521' };
+
+/** Converts a decoded COSE_Key map into { alg, jwk }. */
+export function coseToJwk(cose) {
+  const kty = cose.get(1);
+  const alg = cose.get(3);
+  if (!ALGORITHMS[alg]) throw new Error(`Unsupported public key algorithm (${alg})`);
+
+  if (kty === 2) {
+    const crv = EC_CURVES[cose.get(-1)];
+    const x = cose.get(-2);
+    const y = cose.get(-3);
+    if (!crv || !(x instanceof Uint8Array) || !(y instanceof Uint8Array)) throw new Error('Malformed EC2 key');
+    if (crv !== ALGORITHMS[alg].importParams.namedCurve) throw new Error('EC curve does not match algorithm');
+    return { alg, jwk: { kty: 'EC', crv, x: b64urlEncode(x), y: b64urlEncode(y) } };
+  }
+  if (kty === 3) {
+    const n = cose.get(-1);
+    const e = cose.get(-2);
+    if (!(n instanceof Uint8Array) || !(e instanceof Uint8Array)) throw new Error('Malformed RSA key');
+    return { alg, jwk: { kty: 'RSA', n: b64urlEncode(n), e: b64urlEncode(e) } };
+  }
+  if (kty === 1) {
+    const x = cose.get(-2);
+    if (cose.get(-1) !== 6 || !(x instanceof Uint8Array)) throw new Error('Unsupported OKP key');
+    return { alg, jwk: { kty: 'OKP', crv: 'Ed25519', x: b64urlEncode(x) } };
+  }
+  throw new Error(`Unsupported COSE key type (${kty})`);
+}
+
+export async function importPublicKey(alg, jwk) {
+  const spec = ALGORITHMS[alg];
+  if (!spec) throw new Error(`Unsupported public key algorithm (${alg})`);
+  return crypto.subtle.importKey('jwk', jwk, spec.importParams, false, ['verify']);
+}
+
+/** Converts an ASN.1 DER ECDSA signature into the raw r||s form WebCrypto expects. */
+function derToRawSignature(der, size) {
+  let i = 0;
+  const readLen = () => {
+    let len = der[i++];
+    if (len & 0x80) {
+      const n = len & 0x7f;
+      len = 0;
+      for (let k = 0; k < n; k++) len = (len << 8) | der[i++];
+    }
+    return len;
+  };
+  if (der[i++] !== 0x30) throw new Error('Invalid ECDSA signature');
+  readLen();
+  const readInt = () => {
+    if (der[i++] !== 0x02) throw new Error('Invalid ECDSA signature');
+    const len = readLen();
+    let v = der.subarray(i, i + len);
+    i += len;
+    while (v.length > size && v[0] === 0) v = v.subarray(1);
+    if (v.length > size) throw new Error('Invalid ECDSA signature');
+    const out = new Uint8Array(size);
+    out.set(v, size - v.length);
+    return out;
+  };
+  return concatBytes(readInt(), readInt());
+}
+
+export async function verifySignature(alg, jwk, signature, data) {
+  const spec = ALGORITHMS[alg];
+  const key = await importPublicKey(alg, jwk);
+  let sig = toBytes(signature);
+  if (spec.ecSize) sig = derToRawSignature(sig, spec.ecSize);
+  return crypto.subtle.verify(spec.verifyParams, key, sig, toBytes(data));
+}
+
+/* ------------------------------------------------------------------ */
+/* Browser-side JSON <-> WebAuthn object conversion                    */
+/* ------------------------------------------------------------------ */
+
+function descriptorsFromJSON(list) {
+  return (list || []).map((d) => ({ ...d, id: b64urlDecode(d.id) }));
+}
+
+export function creationOptionsFromJSON(json) {
+  return {
+    ...json,
+    challenge: b64urlDecode(json.challenge),
+    user: { ...json.user, id: b64urlDecode(json.user.id) },
+    excludeCredentials: descriptorsFromJSON(json.excludeCredentials),
+  };
+}
+
+export function requestOptionsFromJSON(json) {
+  return {
+    ...json,
+    challenge: b64urlDecode(json.challenge),
+    allowCredentials: descriptorsFromJSON(json.allowCredentials),
+  };
+}
+
+/** Serialises a PublicKeyCredential so it can be sent to the relying party. */
+export function credentialToJSON(credential) {
+  const r = credential.response;
+  const json = {
+    id: credential.id,
+    rawId: b64urlEncode(credential.rawId),
+    type: credential.type,
+    authenticatorAttachment: credential.authenticatorAttachment ?? null,
+    clientExtensionResults: credential.getClientExtensionResults?.() ?? {},
+    response: { clientDataJSON: b64urlEncode(r.clientDataJSON) },
+  };
+  if ('attestationObject' in r) {
+    json.response.attestationObject = b64urlEncode(r.attestationObject);
+    json.response.transports = r.getTransports?.() ?? [];
+  } else {
+    json.response.authenticatorData = b64urlEncode(r.authenticatorData);
+    json.response.signature = b64urlEncode(r.signature);
+    json.response.userHandle = r.userHandle ? b64urlEncode(r.userHandle) : null;
+  }
+  return json;
+}
