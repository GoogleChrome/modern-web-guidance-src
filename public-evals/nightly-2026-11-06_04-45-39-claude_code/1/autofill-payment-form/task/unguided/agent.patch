+  <script>
+    (function () {
+      const form = document.getElementById('payment-form');
+      const numberInput = document.getElementById('card-number');
+      const nameInput = document.getElementById('card-name');
+      const expiryInput = document.getElementById('card-expiry');
+      const cvcInput = document.getElementById('card-cvc');
+      const status = document.getElementById('form-status');
+
+      const digitsOnly = (value) => value.replace(/\D/g, '');
+
+      // Luhn checksum for card number validation
+      function passesLuhn(number) {
+        let sum = 0;
+        let double = false;
+        for (let i = number.length - 1; i >= 0; i--) {
+          let digit = parseInt(number[i], 10);
+          if (double) {
+            digit *= 2;
+            if (digit > 9) digit -= 9;
+          }
+          sum += digit;
+          double = !double;
+        }
+        return sum % 10 === 0;
+      }
+
+      const isAmex = (digits) => /^3[47]/.test(digits);
+
+      const validators = {
+        'card-number': (value) => {
+          const digits = digitsOnly(value);
+          if (!digits) return 'Card number is required.';
+          if (digits.length < 13 || digits.length > 19) return 'Card number must be 13–19 digits.';
+          if (!passesLuhn(digits)) return 'Please enter a valid card number.';
+          return '';
+        },
+        'card-name': (value) => {
+          const name = value.trim();
+          if (!name) return 'Name on card is required.';
+          if (!/^[\p{L}\s'.-]+$/u.test(name)) return 'Name may only contain letters, spaces, apostrophes, periods, and hyphens.';
+          return '';
+        },
+        'card-expiry': (value) => {
+          const match = value.match(/^(\d{2})\/(\d{2})$/);
+          if (!match) return 'Use MM/YY format.';
+          const month = parseInt(match[1], 10);
+          const year = 2000 + parseInt(match[2], 10);
+          if (month < 1 || month > 12) return 'Month must be between 01 and 12.';
+          const now = new Date();
+          const currentYear = now.getFullYear();
+          const currentMonth = now.getMonth() + 1;
+          if (year < currentYear || (year === currentYear && month < currentMonth)) {
+            return 'This card has expired.';
+          }
+          if (year > currentYear + 20) return 'Please enter a valid expiry year.';
+          return '';
+        },
+        'card-cvc': (value) => {
+          const cvc = digitsOnly(value);
+          const expected = isAmex(digitsOnly(numberInput.value)) ? 4 : 3;
+          if (!cvc) return 'Security code is required.';
+          if (cvc.length !== expected) return `Security code must be ${expected} digits.`;
+          return '';
+        }
+      };
+
+      function validateField(input) {
+        const message = validators[input.id](input.value);
+        const errorEl = document.getElementById(input.id + '-error');
+        errorEl.textContent = message;
+        input.setAttribute('aria-invalid', message ? 'true' : 'false');
+        return !message;
+      }
+
+      // Format card number into groups (4-6-5 for Amex, 4-4-4-4 otherwise)
+      numberInput.addEventListener('input', () => {
+        const digits = digitsOnly(numberInput.value).slice(0, 19);
+        let formatted;
+        if (isAmex(digits)) {
+          formatted = [digits.slice(0, 4), digits.slice(4, 10), digits.slice(10, 15)]
+            .filter(Boolean).join(' ');
+        } else {
+          formatted = digits.replace(/(.{4})/g, '$1 ').trim();
+        }
+        numberInput.value = formatted;
+        cvcInput.maxLength = isAmex(digits) ? 4 : 3;
+      });
+
+      // Auto-insert slash in MM/YY
+      expiryInput.addEventListener('input', (e) => {
+        let digits = digitsOnly(expiryInput.value).slice(0, 4);
+        if (digits.length === 1 && digits > '1') digits = '0' + digits;
+        const isDeleting = e.inputType && e.inputType.startsWith('delete');
+        if (digits.length >= 3 || (digits.length === 2 && !isDeleting)) {
+          expiryInput.value = digits.slice(0, 2) + '/' + digits.slice(2);
+        } else {
+          expiryInput.value = digits;
+        }
+      });
+
+      cvcInput.addEventListener('input', () => {
+        cvcInput.value = digitsOnly(cvcInput.value).slice(0, 4);
+      });
+
+      [numberInput, nameInput, expiryInput, cvcInput].forEach((input) => {
+        input.addEventListener('blur', () => {
+          if (input.value) validateField(input);
+        });
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        status.textContent = '';
+        status.className = 'form-status';
+
+        const inputs = [numberInput, nameInput, expiryInput, cvcInput];
+        const results = inputs.map(validateField);
+        const firstInvalid = inputs[results.indexOf(false)];
+        if (firstInvalid) {
+          firstInvalid.focus();
+          status.textContent = 'Please correct the highlighted fields.';
+          status.classList.add('error');
+          return;
+        }
+
+        // NOTE: Raw card data should never be sent to or stored on our own
+        // servers. Hook this up to a PCI-compliant payment processor
+        // (e.g. Stripe Elements, Braintree Hosted Fields) that tokenizes
+        // the card in the browser, then submit only the returned token.
+        const submitBtn = form.querySelector('button[type="submit"]');
+        submitBtn.disabled = true;
+        status.textContent = 'Payment details accepted. Thank you for your order!';
+        status.classList.add('success');
+        form.reset();
+        inputs.forEach((input) => input.removeAttribute('aria-invalid'));
+        setTimeout(() => { submitBtn.disabled = false; }, 1500);
+      });
+    })();
+  </script>
+
 </body>
 
