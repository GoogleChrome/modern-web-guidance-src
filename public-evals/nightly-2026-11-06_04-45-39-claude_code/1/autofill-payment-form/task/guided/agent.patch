+  <script>
+    (() => {
+      const form = document.getElementById('payment-form');
+      const number = document.getElementById('cc-number');
+      const exp = document.getElementById('cc-exp');
+      const status = document.getElementById('form-status');
+
+      // Luhn checksum for card numbers (spaces allowed)
+      const passesLuhn = (value) => {
+        const digits = value.replace(/\s/g, '');
+        if (!/^\d{12,19}$/.test(digits)) return false;
+        let sum = 0;
+        for (let i = 0; i < digits.length; i++) {
+          let d = Number(digits[digits.length - 1 - i]);
+          if (i % 2 === 1) {
+            d *= 2;
+            if (d > 9) d -= 9;
+          }
+          sum += d;
+        }
+        return sum % 10 === 0;
+      };
+
+      const isNotExpired = (value) => {
+        const match = /^(0[1-9]|1[0-2])\/(\d{2})$/.exec(value);
+        if (!match) return false;
+        const month = Number(match[1]);
+        const year = 2000 + Number(match[2]);
+        const now = new Date();
+        return year > now.getFullYear() ||
+          (year === now.getFullYear() && month >= now.getMonth() + 1);
+      };
+
+      const validateNumber = () => {
+        number.setCustomValidity(
+          number.value && !passesLuhn(number.value) ? 'Enter a valid card number.' : ''
+        );
+      };
+
+      const validateExp = () => {
+        exp.setCustomValidity(
+          exp.value && !isNotExpired(exp.value) ? 'Enter a valid, unexpired date as MM/YY.' : ''
+        );
+      };
+
+      number.addEventListener('input', validateNumber);
+      exp.addEventListener('input', (event) => {
+        // Insert the slash automatically when typing "MMYY" by hand
+        if (event.inputType === 'insertText' && /^\d{2}$/.test(exp.value)) {
+          exp.value += '/';
+        }
+        validateExp();
+      });
+
+      // Keep aria-invalid in sync with the visual :user-invalid state
+      const syncAria = (event) => {
+        const input = event.target;
+        if (!input.matches?.('#payment-form input')) return;
+        if (input.matches(':user-invalid')) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+      };
+      form.addEventListener('blur', syncAria, true);
+      form.addEventListener('invalid', syncAria, true);
+      form.addEventListener('input', (event) => {
+        if (event.target.getAttribute('aria-invalid') === 'true') syncAria(event);
+      });
+
+      form.addEventListener('submit', (event) => {
+        validateNumber();
+        validateExp();
+        event.preventDefault();
+        if (!form.checkValidity()) {
+          form.reportValidity();
+          return;
+        }
+        // TODO: hand card data to a PCI-compliant payment processor here.
+        status.textContent = 'Thank you! Your payment details have been received.';
+        form.reset();
+      });
+    })();
+  </script>
+
