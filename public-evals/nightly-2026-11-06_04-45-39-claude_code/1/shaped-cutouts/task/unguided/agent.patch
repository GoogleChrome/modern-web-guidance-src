+
+    .shaped-section > h2 {
+      text-align: center;
+      margin-bottom: 24px;
+    }
+
+    /* 1) Featured barista: organic paint-splat crop.
+       The clipPath uses objectBoundingBox units (0–1), so the splat
+       scales with whatever size the image is rendered at. */
+    .barista-feature {
+      display: flex;
+      align-items: center;
+      gap: 40px;
+      flex-wrap: wrap;
+      justify-content: center;
+    }
+
+    .shaped-avatar {
+      display: block;
+      width: min(320px, 80vw);
+      aspect-ratio: 1 / 1;
+      height: auto;
+      object-fit: cover;
+      -webkit-clip-path: url(#paint-splat);
+      clip-path: url(#paint-splat);
+    }
+
+    .barista-bio {
+      max-width: 420px;
+    }
+
+    .barista-bio h3 {
+      color: var(--primary);
+      font-size: 1.6rem;
+    }
+
+    .barista-bio .role {
+      color: var(--accent);
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+      font-size: 0.8rem;
+      margin-bottom: 10px;
+    }
+
+    /* 2) Loyalty banner: two siblings that read as one card.
+       The shadow lives on the parent as a drop-shadow filter so it
+       follows the masked outline of .card-accent (box-shadow would not). */
+    .unified-card {
+      display: flex;
+      align-items: stretch;
+      max-width: 760px;
+      margin: 0 auto;
+      filter: drop-shadow(0 10px 18px rgba(62, 39, 35, 0.25))
+        drop-shadow(0 2px 4px rgba(62, 39, 35, 0.15));
+    }
+
+    .unified-card .card-body {
+      flex: 1 1 auto;
+      background: var(--primary);
+      color: white;
+      padding: 28px 32px;
+      border-radius: 14px 0 0 14px;
+    }
+
+    .unified-card .card-body h3 {
+      color: var(--accent);
+      font-size: 1.5rem;
+      margin-bottom: 6px;
+    }
+
+    .unified-card .card-body .btn {
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 600;
+    }
+
+    .unified-card .card-body .btn:hover {
+      background: #ffc174;
+    }
+
+    .unified-card .card-accent {
+      flex: 0 0 140px;
+      /* Same base colour as .card-body so the seam is invisible */
+      background:
+        radial-gradient(circle at 35% 30%, rgba(255, 171, 64, 0.55) 0 14px, transparent 15px),
+        radial-gradient(circle at 55% 72%, rgba(255, 171, 64, 0.35) 0 9px, transparent 10px),
+        var(--primary);
+      border-radius: 0 14px 14px 0;
+      /* Concave cutout curve on the outer (right) side */
+      -webkit-mask: radial-gradient(circle 46px at 100% 50%, transparent 98%, #000 100%);
+      mask: radial-gradient(circle 46px at 100% 50%, transparent 98%, #000 100%);
+    }
+
+    /* 3) Promo card: circular notch on the top edge, made with a gradient mask. */
+    .promo-wrap {
+      max-width: 420px;
+      margin: 0 auto;
+      /* Shadow on wrapper so it follows the notch (masks clip box-shadow) */
+      filter: drop-shadow(0 8px 14px rgba(62, 39, 35, 0.2));
+    }
+
+    .gradient-masked-card {
+      --notch: 32px;
+      background: linear-gradient(135deg, var(--accent), #ff8a50);
+      color: var(--text);
+      text-align: center;
+      padding: calc(var(--notch) + 24px) 28px 28px;
+      border-radius: 16px;
+      -webkit-mask: radial-gradient(circle var(--notch) at 50% 0, transparent 98%, #000 100%);
+      mask: radial-gradient(circle var(--notch) at 50% 0, transparent 98%, #000 100%);
+    }
+
+    .gradient-masked-card h3 {
+      font-size: 1.4rem;
+      color: var(--primary);
+    }
+
+    .gradient-masked-card .promo-code {
+      display: inline-block;
+      margin-top: 12px;
+      padding: 6px 14px;
+      border: 2px dashed var(--primary);
+      border-radius: 6px;
+      font-weight: 700;
+      letter-spacing: 2px;
+    }
+
+    @media (max-width: 560px) {
+      .unified-card .card-accent {
+        flex-basis: 80px;
+      }
+    }
   </style>
 </head>
 
