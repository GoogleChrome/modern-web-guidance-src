       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* ---------- Shaped elements ---------- */
+    .shaped-section {
+      margin-top: 60px;
+    }
+
+    .shaped-section > h2 {
+      text-align: center;
+      margin-bottom: 24px;
+    }
+
+    .shaped-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 32px;
+      align-items: center;
+    }
+
+    /* 1) Featured barista: SVG paint-splat mask applied directly to the image */
+    .barista-feature {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      text-align: center;
+      gap: 12px;
+    }
+
+    .shaped-avatar {
+      display: block;
+      width: min(100%, 280px);
+      aspect-ratio: 1;
+      height: auto;
+      object-fit: cover;
+      object-position: 50% 30%;
+      /* objectBoundingBox mask scales with whatever size the image renders at */
+      -webkit-mask-image: url(#splat-mask);
+      mask-image: url(#splat-mask);
+    }
+
+    .barista-feature h3 {
+      color: var(--primary);
+    }
+
+    /* 2) Loyalty banner: unmasked text + masked decorative accent, one shadow on the wrapper */
+    .unified-card {
+      display: flex;
+      max-width: 520px;
+      width: 100%;
+      margin-inline: auto;
+      /* drop-shadow follows the masked silhouette (box-shadow would be clipped by the mask / ignore the curve) */
+      filter: drop-shadow(0 10px 14px rgba(62, 39, 35, 0.28)) drop-shadow(0 2px 4px rgba(62, 39, 35, 0.18));
+    }
+
+    .card-body {
+      flex: 1;
+      background-color: var(--primary);
+      color: var(--light);
+      padding: 24px 8px 24px 28px;
+      border-radius: 16px 0 0 16px;
+    }
+
+    .card-body h3 {
+      color: var(--accent);
+      margin-bottom: 6px;
+    }
+
+    .card-body .btn {
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 600;
+    }
+
+    .card-body .btn:hover {
+      background: #ffc174;
+    }
+
+    .card-accent {
+      flex: 0 0 72px;
+      background-color: var(--primary);
+      border-radius: 0 16px 16px 0;
+      -webkit-mask-image: url(#card-accent-mask);
+      mask-image: url(#card-accent-mask);
+    }
+
+    /* 3) Promo card: circular top notch from a single radial gradient */
+    .gradient-masked-card {
+      max-width: 360px;
+      width: 100%;
+      margin-inline: auto;
+      background: linear-gradient(135deg, var(--accent), #e65100);
+      color: var(--text);
+      padding: 52px 24px 28px; /* extra top padding keeps content clear of the notch */
+      border-radius: 16px;
+      text-align: center;
+      --notch: 26px;
+      -webkit-mask-image: radial-gradient(circle at 50% 0%, transparent var(--notch), #000 calc(var(--notch) + 1px));
+      mask-image: radial-gradient(circle at 50% 0%, transparent var(--notch), #000 calc(var(--notch) + 1px));
+    }
+
+    .gradient-masked-card h3 {
+      margin-bottom: 8px;
+    }
+
+    .promo-code {
+      display: inline-block;
+      margin-top: 12px;
+      padding: 4px 12px;
+      border: 2px dashed currentColor;
+      border-radius: 6px;
+      font-weight: 700;
+      letter-spacing: 2px;
+    }
   </style>
