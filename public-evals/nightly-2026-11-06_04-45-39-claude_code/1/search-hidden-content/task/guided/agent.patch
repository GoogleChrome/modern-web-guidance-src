+  <script>
+    (() => {
+      const panel = document.getElementById('coupon-panel');
+      const button = document.getElementById('reveal-coupon-btn');
+
+      // One-way: once revealed, the panel stays visible and the button is retired.
+      const markRevealed = () => {
+        button.setAttribute('aria-expanded', 'true');
+        button.disabled = true;
+        button.textContent = 'Coupon Revealed';
+      };
+
+      button.addEventListener('click', () => {
+        panel.removeAttribute('hidden');
+        markRevealed();
+        panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
+      });
+
+      // Find-in-page match: the browser removes hidden itself; just sync the button.
+      panel.addEventListener('beforematch', markRevealed);
+
+      // Fallback: browsers without hidden="until-found" treat it as plain hidden,
+      // so show the coupon up front to keep it searchable.
+      if (!('onbeforematch' in HTMLElement.prototype)) {
+        panel.removeAttribute('hidden');
+        markRevealed();
+      }
+    })();
+  </script>
