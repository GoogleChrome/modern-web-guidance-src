+  <script>
+    (function () {
+      var panel = document.getElementById('coupon-panel');
+      var button = document.getElementById('reveal-coupon-btn');
+      if (!panel || !button) return;
+
+      // One-way: once shown, the panel stays visible and the button is retired.
+      function markRevealed() {
+        button.disabled = true;
+        button.setAttribute('aria-expanded', 'true');
+        button.querySelector('.coupon-btn-label').textContent = 'Coupon Revealed';
+      }
+
+      button.addEventListener('click', function () {
+        panel.removeAttribute('hidden');
+        markRevealed();
+        panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
+      });
+
+      // Find-in-page matched the code: the browser removes `hidden` itself.
+      panel.addEventListener('beforematch', markRevealed);
+    })();
+  </script>
