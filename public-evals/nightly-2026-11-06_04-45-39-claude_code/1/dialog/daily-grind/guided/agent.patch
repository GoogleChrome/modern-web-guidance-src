+  <script type="module">
+    // Invoker Commands (command/commandfor) polyfill, loaded only where unsupported.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const status = document.getElementById('order-status');
+
+    for (const dialog of document.querySelectorAll('dialog.drink-dialog')) {
+      // Light-dismiss fallback for browsers without <dialog closedby> (e.g. Safari).
+      // Esc and back-gesture dismissal already work natively for modal dialogs.
+      if (!('closedBy' in HTMLDialogElement.prototype)) {
+        const outside = (e) => {
+          const r = dialog.getBoundingClientRect();
+          return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+        };
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+        dialog.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e)) dialog.close();
+          pressedOutside = false;
+        });
+      }
+
+      // Announce the outcome when an order is submitted; dismissals set no returnValue.
+      dialog.addEventListener('close', () => {
+        const form = dialog.querySelector('form');
+        if (dialog.returnValue === 'order' && form) {
+          const data = new FormData(form);
+          const drink = dialog.dataset.drink || data.get('drink');
+          const qty = Number(data.get('quantity')) || 1;
+          status.textContent = `Added ${qty} × ${data.get('size')} ${drink} to your order.`;
+          form.reset();
+        }
+        dialog.returnValue = '';
+      });
+    }
+  </script>
