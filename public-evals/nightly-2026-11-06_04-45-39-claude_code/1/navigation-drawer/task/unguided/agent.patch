+  <script>
+    (function () {
+      var body = document.body;
+      var toggle = document.getElementById('menu-toggle');
+      var drawer = document.getElementById('nav-drawer');
+      var backdrop = document.getElementById('drawer-backdrop');
+      var closeBtn = document.getElementById('drawer-close');
+      var lastFocus = null;
+
+      function isOpen() { return body.classList.contains('drawer-open'); }
+
+      function openDrawer() {
+        if (isOpen()) return;
+        lastFocus = document.activeElement;
+        drawer.removeAttribute('inert');
+        body.classList.add('drawer-open');
+        toggle.setAttribute('aria-expanded', 'true');
+        closeBtn.focus();
+      }
+
+      function closeDrawer() {
+        if (!isOpen()) return;
+        body.classList.remove('drawer-open');
+        drawer.setAttribute('inert', '');
+        toggle.setAttribute('aria-expanded', 'false');
+        drawer.style.transform = '';
+        backdrop.style.opacity = '';
+        if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
+        else toggle.focus();
+      }
+
+      toggle.addEventListener('click', openDrawer);
+      closeBtn.addEventListener('click', closeDrawer);
+      backdrop.addEventListener('click', closeDrawer);
+
+      document.addEventListener('keydown', function (e) {
+        if (!isOpen()) return;
+        if (e.key === 'Escape' || e.key === 'Esc') {
+          e.preventDefault();
+          closeDrawer();
+        } else if (e.key === 'Tab') {
+          // Keep focus inside the drawer while it is open
+          var items = drawer.querySelectorAll('a[href], button:not([disabled])');
+          if (!items.length) return;
+          var first = items[0], last = items[items.length - 1];
+          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
+          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
+        }
+      });
+
+      // Swipe right to dismiss (drawer slides in from the right edge)
+      var startX = 0, startY = 0, startT = 0, deltaX = 0;
+      var tracking = false, dragging = false, pointerId = null;
+
+      function onDown(e) {
+        if (!isOpen() || (e.pointerType === 'mouse' && e.button !== 0)) return;
+        tracking = true; dragging = false; deltaX = 0;
+        pointerId = e.pointerId;
+        startX = e.clientX; startY = e.clientY; startT = Date.now();
+      }
+
+      function onMove(e) {
+        if (!tracking || e.pointerId !== pointerId) return;
+        var dx = e.clientX - startX;
+        var dy = e.clientY - startY;
+        if (!dragging) {
+          if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
+          // Vertical gestures scroll the drawer; horizontal-right gestures drag it
+          if (Math.abs(dx) <= Math.abs(dy) || dx < 0) { tracking = false; return; }
+          dragging = true;
+          drawer.classList.add('dragging');
+          backdrop.classList.add('dragging');
+          try { drawer.setPointerCapture(pointerId); } catch (_) {}
+        }
+        deltaX = Math.max(0, dx);
+        var width = drawer.offsetWidth || 1;
+        drawer.style.transform = 'translateX(' + deltaX + 'px)';
+        backdrop.style.opacity = String(Math.max(0, 1 - deltaX / width));
+        e.preventDefault();
+      }
+
+      function onEnd(e) {
+        if (!tracking || e.pointerId !== pointerId) return;
+        tracking = false;
+        if (!dragging) return;
+        dragging = false;
+        drawer.classList.remove('dragging');
+        backdrop.classList.remove('dragging');
+        var width = drawer.offsetWidth || 1;
+        var velocity = deltaX / Math.max(1, Date.now() - startT); // px per ms
+        var cancelled = e.type === 'pointercancel';
+        drawer.style.transform = '';
+        backdrop.style.opacity = '';
+        if (!cancelled && (deltaX > width * 0.3 || (velocity > 0.5 && deltaX > 30))) {
+          closeDrawer();
+        }
+        deltaX = 0;
+      }
+
+      drawer.addEventListener('pointerdown', onDown);
+      drawer.addEventListener('pointermove', onMove);
+      drawer.addEventListener('pointerup', onEnd);
+      drawer.addEventListener('pointercancel', onEnd);
+
+      // Swallow the click that follows a drag so links aren't activated by a swipe
+      var suppressClickUntil = 0;
+      drawer.addEventListener('pointerup', function () {
+        if (dragging) suppressClickUntil = Date.now() + 400;
+      }, true);
+      drawer.addEventListener('click', function (e) {
+        if (Date.now() < suppressClickUntil) { e.preventDefault(); e.stopPropagation(); }
+      }, true);
+
+      // Close when a link is chosen
+      drawer.querySelectorAll('a[href]').forEach(function (a) {
+        a.addEventListener('click', closeDrawer);
+      });
+    })();
+  </script>
+
