diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -151,13 +151,45 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Scroll progress indicator
+       Baseline: hidden (scaleX(0)) so nothing looks broken without support.
+       Enhancement 1: a small JS fallback sets --scroll-progress (0..1).
+       Enhancement 2: browsers with scroll-driven animations do it in pure CSS,
+       off the main thread, and the JS fallback stays inactive. */
+    .scroll-progress {
+      position: fixed;
+      top: 0;
+      left: 0;
+      width: 100%;
+      height: 4px;
+      background: var(--accent);
+      transform-origin: 0 50%;
+      transform: scaleX(var(--scroll-progress, 0));
+      z-index: 1001;
+      pointer-events: none;
+      will-change: transform;
+    }
+
+    @supports (animation-timeline: scroll()) {
+      .scroll-progress {
+        animation: scroll-progress-grow linear both;
+        animation-timeline: scroll(root block);
+      }
+    }
+
+    @keyframes scroll-progress-grow {
+      from { transform: scaleX(0); }
+      to { transform: scaleX(1); }
+    }
   </style>
 </head>
 
 <body>
 
+  <div class="scroll-progress" aria-hidden="true"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +238,43 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers without CSS scroll-driven animations.
+    (function () {
+      var supportsScrollTimeline = window.CSS && CSS.supports &&
+        CSS.supports('animation-timeline: scroll()');
+      if (supportsScrollTimeline) return;
+
+      var bar = document.querySelector('.scroll-progress');
+      if (!bar) return;
+
+      var ticking = false;
+
+      function update() {
+        var doc = document.documentElement;
+        var scrollTop = window.pageYOffset || doc.scrollTop || document.body.scrollTop || 0;
+        var max = (doc.scrollHeight || document.body.scrollHeight) - window.innerHeight;
+        var progress = max > 0 ? Math.min(Math.max(scrollTop / max, 0), 1) : 0;
+        bar.style.setProperty('--scroll-progress', progress);
+        // Very old engines without custom property support
+        bar.style.transform = 'scaleX(' + progress + ')';
+        ticking = false;
+      }
+
+      function requestUpdate() {
+        if (ticking) return;
+        ticking = true;
+        (window.requestAnimationFrame || function (cb) { setTimeout(cb, 16); })(update);
+      }
+
+      window.addEventListener('scroll', requestUpdate, { passive: true });
+      window.addEventListener('resize', requestUpdate);
+      window.addEventListener('load', requestUpdate);
+      update();
+    })();
+  </script>
+
 </body>
 
 </html>
