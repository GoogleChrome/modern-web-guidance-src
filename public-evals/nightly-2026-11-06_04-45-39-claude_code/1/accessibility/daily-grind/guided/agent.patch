+  <script>
+    (() => {
+      const toggle = document.querySelector('.nav-toggle');
+      const menu = document.getElementById('primary-menu');
+      if (!toggle || !menu) return;
+
+      // Reveal the toggle only when JS is available; without JS the links stay visible.
+      toggle.hidden = false;
+
+      const setOpen = (open) => toggle.setAttribute('aria-expanded', String(open));
+      const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
+      const collapsible = () => getComputedStyle(toggle).display !== 'none';
+
+      toggle.addEventListener('click', () => setOpen(!isOpen()));
+
+      // Escape closes the open menu and returns focus to the toggle.
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && isOpen() && collapsible()) {
+          setOpen(false);
+          toggle.focus();
+        }
+      });
+
+      // Close when keyboard focus moves out of the navigation.
+      toggle.closest('nav').addEventListener('focusout', (e) => {
+        if (isOpen() && collapsible() && !e.currentTarget.contains(e.relatedTarget)) {
+          setOpen(false);
+        }
+      });
+    })();
+  </script>
