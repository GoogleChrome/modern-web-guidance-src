     }
 
+    /* Keep hero content above the decorative shape */
+    .hero > :not(.shaped-element) {
+      position: relative;
+      z-index: 1;
+    }
+
+    /* Decorative organic coffee-splash block */
+    .shaped-element {
+      position: absolute;
+      top: 50%;
+      right: -4%;
+      width: clamp(180px, 34vw, 460px);
+      aspect-ratio: 1 / 1;
+      transform: translateY(-50%) rotate(-12deg);
+      z-index: 0;
+      pointer-events: none;
+      opacity: 0.85;
+      /* Fallback layers: warm gradient shows even if the photo fails to load */
