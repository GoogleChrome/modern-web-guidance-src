+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=900&q=80') center / cover no-repeat,
+        radial-gradient(circle at 35% 30%, var(--accent), #8d6e63 55%, var(--primary));
+      /* Baseline organic shape for browsers without mask support */
+      border-radius: 62% 38% 55% 45% / 48% 60% 40% 52%;
+      filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.35));
+    }
+
+    /* Fluid vector mask: coffee splash with drips and droplets (inline SVG, no network request) */
+    @supports ((mask-image: url("")) or (-webkit-mask-image: url(""))) {
+      .shaped-element {
+        border-radius: 0;
