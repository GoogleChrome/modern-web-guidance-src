+  <script type="module">
+    // Polyfills PublicKeyCredential.parseRequestOptionsFromJSON / toJSON /
+    // getClientCapabilities in browsers that support WebAuthn but not these helpers.
+    import 'webauthn-polyfills';
+
+    const button = document.getElementById('reauth-btn');
+    const status = document.getElementById('reauth-status');
+    let reauthAbortController = new AbortController();
+
+    function setStatus(message, state = '') {
+      status.textContent = message;
+      status.dataset.state = state;
+    }
+
+    async function triggerButtonReauth() {
+      if (!window.PublicKeyCredential || !navigator.credentials?.get) {
+        setStatus('Your browser does not support passkeys, so identity verification is unavailable.', 'error');
+        return;
+      }
+
+      // Abort any in-flight ceremony to avoid passkey prompt collisions.
+      reauthAbortController.abort();
+      reauthAbortController = new AbortController();
+
+      button.disabled = true;
+      setStatus('Waiting for your passkey…');
+
+      try {
+        // Session cookie identifies the signed-in user; the server restricts
+        // allowCredentials to that user's registered passkeys.
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { Accept: 'application/json' },
+        });
+        if (!optionsResponse.ok) {
+          throw new Error(`Could not start verification (HTTP ${optionsResponse.status}).`);
+        }
+        const optionsJSON = await optionsResponse.json();
+
+        // Reauth must be scoped to the current user's credentials; never fall
+        // back to a discoverable-credential prompt that could pick another account.
+        if (!Array.isArray(optionsJSON.allowCredentials) || optionsJSON.allowCredentials.length === 0) {
+          throw new Error('No passkeys are registered for this account.');
+        }
+
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: reauthAbortController.signal,
+        });
+        if (!credential) {
+          throw new Error('No credential was returned.');
+        }
+
+        const encodedCredential = credential.toJSON();
+        const verifyResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(encodedCredential),
+        });
+
+        if (verifyResponse.ok) {
+          setStatus('Identity confirmed. You can now make changes to your account.', 'success');
+          document.dispatchEvent(new CustomEvent('reauth:success'));
+          return;
+        }
+
+        if (verifyResponse.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+          // Let the password manager drop a passkey the server no longer knows.
+          // Always use the server-provided rpId, never location.hostname.
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rpId,
+            credentialId: encodedCredential.id,
+          }).catch(() => {});
+        }
+        throw new Error('We could not verify your identity. Please try again.');
+      } catch (err) {
+        if (err.name === 'AbortError') return;
+        if (err.name === 'NotAllowedError') {
+          setStatus('Verification was cancelled or timed out.', 'error');
+        } else {
+          setStatus(err.message || 'Verification failed.', 'error');
+        }
+      } finally {
+        button.disabled = false;
+      }
+    }
+
+    button.addEventListener('click', triggerButtonReauth);
+  </script>
