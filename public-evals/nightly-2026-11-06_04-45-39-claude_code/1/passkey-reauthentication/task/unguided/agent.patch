+  <script>
+    (function () {
+      'use strict';
+
+      var button = document.getElementById('reauth-button');
+      var statusEl = document.getElementById('reauth-status');
+      if (!button) return;
+
+      function setStatus(msg, kind) {
+        statusEl.textContent = msg || '';
+        statusEl.className = 'reauth-status' + (kind ? ' ' + kind : '');
+      }
+
+      function b64urlToBuffer(value) {
+        if (value instanceof ArrayBuffer) return value;
+        if (ArrayBuffer.isView(value)) return value.buffer.slice(value.byteOffset, value.byteOffset + value.byteLength);
+        if (typeof value !== 'string') throw new TypeError('Expected base64url string');
+        var b64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        var pad = b64.length % 4;
+        if (pad) b64 += '===='.slice(pad);
+        var bin = atob(b64);
+        var bytes = new Uint8Array(bin.length);
+        for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function bufferToB64url(buf) {
+        if (!buf) return null;
+        var bytes = new Uint8Array(buf);
+        var bin = '';
+        for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
+        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      // Convert the server's JSON options into a PublicKeyCredentialRequestOptions.
+      function toRequestOptions(json) {
+        var opts = json && json.publicKey ? json.publicKey : json;
+        if (!opts || !opts.challenge) throw new Error('Server did not return a challenge.');
+
+        // Re-auth must be bound to the signed-in user's pre-registered credentials.
+        if (!Array.isArray(opts.allowCredentials) || opts.allowCredentials.length === 0) {
+          throw new Error('No registered passkeys were found for your account.');
+        }
+
+        var publicKey = {
+          challenge: b64urlToBuffer(opts.challenge),
+          allowCredentials: opts.allowCredentials.map(function (c) {
+            var d = { type: c.type || 'public-key', id: b64urlToBuffer(c.id) };
+            if (Array.isArray(c.transports)) d.transports = c.transports;
+            return d;
+          }),
+          // Always demand user verification (PIN/biometric) — presence alone is not enough.
+          userVerification: 'required'
+        };
+        if (opts.rpId) publicKey.rpId = opts.rpId;
+        if (typeof opts.timeout === 'number') publicKey.timeout = opts.timeout;
+        if (opts.extensions) publicKey.extensions = opts.extensions;
+        return publicKey;
+      }
+
+      function serializeAssertion(cred) {
+        var r = cred.response;
+        var out = {
+          id: cred.id,
+          rawId: bufferToB64url(cred.rawId),
+          type: cred.type,
+          response: {
+            clientDataJSON: bufferToB64url(r.clientDataJSON),
+            authenticatorData: bufferToB64url(r.authenticatorData),
+            signature: bufferToB64url(r.signature),
+            userHandle: bufferToB64url(r.userHandle)
+          },
+          clientExtensionResults: typeof cred.getClientExtensionResults === 'function'
+            ? cred.getClientExtensionResults() : {}
+        };
+        if (cred.authenticatorAttachment !== undefined) out.authenticatorAttachment = cred.authenticatorAttachment;
+        return out;
+      }
+
+      async function postJSON(url, body) {
+        var res = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(body || {})
+        });
+        var data = null;
+        try { data = await res.json(); } catch (e) { /* non-JSON body */ }
+        if (!res.ok) {
+          var msg = (data && (data.error || data.message)) || ('Request failed (' + res.status + ')');
+          throw new Error(msg);
+        }
+        return data;
+      }
+
+      async function reauthenticate() {
+        if (!window.PublicKeyCredential || !navigator.credentials || !navigator.credentials.get) {
+          setStatus('Your browser does not support passkeys / security keys.', 'error');
+          return;
+        }
+
+        button.disabled = true;
+        button.setAttribute('aria-busy', 'true');
+        setStatus('Requesting challenge…');
+
+        try {
+          var optionsJSON = await postJSON('/api/reauth/options', {});
+          var publicKey = toRequestOptions(optionsJSON);
+
+          setStatus('Follow your browser’s prompt to verify with your passkey…');
+          var credential = await navigator.credentials.get({ publicKey: publicKey });
+          if (!credential) throw new Error('No credential was returned.');
+
+          setStatus('Verifying…');
+          var result = await postJSON('/api/reauth/verify', serializeAssertion(credential));
+
+          if (result && (result.verified === false || result.success === false)) {
+            throw new Error(result.error || result.message || 'Verification failed.');
+          }
+          setStatus('Identity confirmed. You can now make changes to your account.', 'success');
+          document.dispatchEvent(new CustomEvent('reauth:success', { detail: result }));
+        } catch (err) {
+          var msg;
+          if (err && err.name === 'NotAllowedError') msg = 'Verification was cancelled or timed out. Please try again.';
+          else if (err && err.name === 'InvalidStateError') msg = 'This authenticator is not registered to your account.';
+          else if (err && err.name === 'SecurityError') msg = 'Verification is not permitted on this site.';
+          else msg = (err && err.message) || 'Verification failed.';
+          setStatus(msg, 'error');
+          document.dispatchEvent(new CustomEvent('reauth:failure', { detail: { error: msg } }));
+        } finally {
+          button.disabled = false;
+          button.removeAttribute('aria-busy');
+        }
+      }
+
+      button.addEventListener('click', function (e) {
+        e.preventDefault();
+        if (!button.disabled) reauthenticate();
+      });
+    })();
+  </script>
