+  <script>
+    (() => {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      const origins = scroller.querySelectorAll('.origin');
+      let scrolling = false;
+
+      // Hot path: runs on every scroll event, so it only flips a flag and
+      // writes the DOM once per scroll gesture — no layout reads.
+      scroller.addEventListener('scroll', () => {
+        if (scrolling) return;
+        scrolling = true;
+        status.textContent = 'Scrolling…';
+      }, { passive: true });
+
+      // Cold path: measure layout only once the scroll has come to rest.
+      function onScrollEnd() {
+        scrolling = false;
+        const view = scroller.getBoundingClientRect();
+        let best = null;
+        let bestVisible = -1;
+        for (const el of origins) {
+          const r = el.getBoundingClientRect();
+          const visible = Math.min(r.bottom, view.bottom) - Math.max(r.top, view.top);
+          if (visible > bestVisible) {
+            bestVisible = visible;
+            best = el;
+          }
+        }
+        status.textContent = `Scroll ended. Visible: ${best ? best.dataset.origin : 'None'}`;
+      }
+
+      if ('onscrollend' in window) {
+        scroller.addEventListener('scrollend', onScrollEnd);
+      } else {
+        // Fallback for browsers without scrollend: debounce scroll events.
+        let timer;
+        scroller.addEventListener('scroll', () => {
+          clearTimeout(timer);
+          timer = setTimeout(onScrollEnd, 150);
+        }, { passive: true });
+      }
+    })();
+  </script>
