+
+    .nutrition-table thead th {
+      background: var(--primary);
+      color: white;
+      font-weight: 600;
+    }
+
+    /* Sticky row headers */
+    .nutrition-table tbody th {
+      position: sticky;
+      inset-inline-start: 0;
+      background: white;
+      color: var(--primary);
+    }
+
+    @container (width >= 600px) {
+      .nutrition-table tbody tr:last-child > * {
+        border-block-end: none;
+      }
+    }
+
+    /* Stacked card layout when the table's container is narrow */
+    @container (width < 600px) {
+      .nutrition-table,
+      .nutrition-table thead,
+      .nutrition-table tbody,
+      .nutrition-table tr,
+      .nutrition-table th,
+      .nutrition-table td {
+        display: block;
+      }
+
+      .nutrition-table thead {
+        display: none;
+      }
+
+      .nutrition-table caption {
+        display: block;
+        padding: 16px 16px 8px;
+      }
+
+      .nutrition-table tbody {
+        padding: 0 16px 16px;
+      }
+
+      .nutrition-table tr {
+        margin-block-end: 1rem;
+        border: 1px solid var(--secondary);
+        border-radius: 6px;
+        overflow: clip;
+      }
+
+      .nutrition-table tbody tr:last-child {
+        margin-block-end: 0;
+      }
+
+      .nutrition-table tbody th {
+        position: sticky;
+        inset-block-start: 0;
+        z-index: 2;
+        background: var(--secondary);
+      }
+
+      .nutrition-table td {
+        display: flex;
+        justify-content: space-between;
+        gap: 1rem;
+        white-space: normal;
+      }
+
+      .nutrition-table td::before {
+        font-weight: 600;
+        color: var(--primary);
+      }
+
+      .nutrition-table td:nth-child(2)::before { content: var(--label-2); }
+      .nutrition-table td:nth-child(3)::before { content: var(--label-3); }
+      .nutrition-table td:nth-child(4)::before { content: var(--label-4); }
+      .nutrition-table td:nth-child(5)::before { content: var(--label-5); }
+      .nutrition-table td:nth-child(6)::before { content: var(--label-6); }
+      .nutrition-table td:nth-child(7)::before { content: var(--label-7); }
+
+      .nutrition-table td:last-child {
+        border-block-end: none;
+      }
+    }
