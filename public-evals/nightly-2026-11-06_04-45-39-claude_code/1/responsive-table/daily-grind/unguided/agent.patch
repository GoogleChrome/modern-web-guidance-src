+    /* Nutrition & Pricing Table */
+    .table-heading {
+      margin-top: 40px;
+      text-align: center;
+      color: var(--primary);
+    }
+
+    .table-intro {
+      text-align: center;
+      font-size: 0.95rem;
+      margin: 8px auto 16px;
+      max-width: 60ch;
+    }
+
+    .table-scroll {
+      overflow-x: auto;
+      -webkit-overflow-scrolling: touch;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .table-scroll:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition-table {
+      width: 100%;
+      min-width: 560px;
+      border-collapse: collapse;
+      font-size: 0.95rem;
+    }
+
+    .nutrition-table caption {
+      caption-side: top;
+      text-align: left;
+      font-weight: bold;
+      padding: 12px 16px;
+      color: var(--primary);
+    }
+
+    .nutrition-table th,
+    .nutrition-table td {
+      padding: 12px 16px;
+      border-bottom: 1px solid var(--secondary);
+      text-align: right;
+      white-space: nowrap;
+    }
+
+    .nutrition-table thead th {
+      background: var(--primary);
+      color: white;
+      font-weight: 600;
+      vertical-align: bottom;
+    }
+
+    .nutrition-table th[scope="row"],
+    .nutrition-table thead th:first-child {
+      text-align: left;
+    }
+
+    /* Keep the drink name visible while scrolling sideways on narrow screens */
+    .nutrition-table th[scope="row"] {
+      position: sticky;
+      left: 0;
+      background: #efebe9;
+      color: var(--primary);
+      z-index: 1;
+    }
+
+    .nutrition-table thead th:first-child {
+      position: sticky;
+      left: 0;
+      z-index: 2;
+    }
+
+    .nutrition-table tbody tr:nth-child(even) td {
+      background: #faf7f6;
+    }
+
+    .nutrition-table tbody tr:last-child th,
+    .nutrition-table tbody tr:last-child td {
+      border-bottom: none;
+    }
+
+    .unit {
+      display: block;
+      font-size: 0.75rem;
+      font-weight: normal;
+      opacity: 0.85;
+    }
+
+    .table-hint,
+    .table-note {
+      font-size: 0.8rem;
+      margin-top: 8px;
+      text-align: center;
+    }
+
+    @media (min-width: 640px) {
+      .table-hint {
+        display: none;
+      }
+    }
+
+    @media (max-width: 480px) {
+      .nutrition-table {
+        font-size: 0.875rem;
+      }
+
+      .nutrition-table th,
+      .nutrition-table td {
+        padding: 10px 12px;
+      }
+    }
+
