+    <section class="journal" id="roasters-journal" aria-labelledby="journal-title">
+      <div class="journal-header">
+        <h2 id="journal-title">Roaster's Journal</h2>
+        <button type="button" class="btn" id="summarize-btn" hidden>Summarize</button>
+      </div>
+      <p class="journal-meta">From the roastery floor &middot; How our beans find their way to your cup</p>
+
