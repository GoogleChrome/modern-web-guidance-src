+  <script type="module">
+    const button = document.getElementById('summarize-btn');
+    const status = document.getElementById('summary-status');
+    const summaryBox = document.getElementById('journal-summary');
+    const list = document.getElementById('summary-list');
+    const body = document.getElementById('journal-body');
+
+    // Identical options for availability() and create().
+    const options = {
+      sharedContext: "A specialty coffee roaster's journal entry describing how they source and roast their beans.",
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      expectedInputLanguages: ['en'],
+      outputLanguage: 'en',
+    };
+
+    let summarizer = null;
+
+    function renderBullets(text) {
+      const items = text
+        .split(/\n+/)
+        .map((line) => line.replace(/^\s*(?:[-*\u2022]|\d+[.)])\s*/, '').trim())
+        .filter(Boolean);
+      list.replaceChildren(...items.map((item) => {
+        const li = document.createElement('li');
+        li.textContent = item;
+        return li;
+      }));
+    }
+
+    async function getSummarizer() {
+      if (summarizer) return summarizer;
+      summarizer = await Summarizer.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const pct = Math.round((e.loaded / (e.total || 1)) * 100);
+            status.textContent = `Downloading on-device AI model… ${pct}%`;
+          });
+        },
+      });
+      return summarizer;
+    }
+
+    async function init() {
+      if (!('Summarizer' in self)) {
+        status.textContent = 'On-device summarization isn\u2019t supported in this browser.';
+        return;
+      }
+      let availability;
+      try {
+        availability = await Summarizer.availability(options);
+      } catch {
+        availability = 'unavailable';
+      }
+      if (availability === 'unavailable') {
+        status.textContent = 'On-device summarization isn\u2019t available on this device.';
+        return;
+      }
+      button.hidden = false;
+    }
+
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      status.textContent = 'Preparing summary…';
+      try {
+        // create() runs inside the click handler so a model download has a user gesture.
+        const s = await getSummarizer();
+        status.textContent = 'Summarizing…';
+        summaryBox.hidden = false;
+        list.replaceChildren();
+        let text = '';
+        for await (const chunk of s.summarizeStreaming(body.innerText)) {
+          text += chunk;
+          renderBullets(text);
+        }
+        status.textContent = '';
+        button.textContent = 'Summarize again';
+      } catch (err) {
+        console.error(err);
+        summaryBox.hidden = list.children.length === 0;
+        status.textContent = 'Sorry, we couldn\u2019t summarize this right now. Please try again.';
+      } finally {
+        button.disabled = false;
+      }
+    });
+
+    init();
+  </script>
+
 </body>
 
