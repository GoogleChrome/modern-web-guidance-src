+  <script>
+    (() => {
+      const button = document.getElementById('summarize-btn');
+      const panel = document.getElementById('journal-summary');
+      const statusEl = document.getElementById('summary-status');
+      const list = document.getElementById('summary-list');
+      const source = document.getElementById('journal-text');
+
+      const setStatus = (msg) => {
+        statusEl.textContent = msg;
+        statusEl.hidden = !msg;
+      };
+
+      // Supports the current global Summarizer API and the older self.ai.summarizer shape.
+      const getSummarizerApi = () => {
+        if ('Summarizer' in self) return { kind: 'modern', api: self.Summarizer };
+        if (self.ai && self.ai.summarizer) return { kind: 'legacy', api: self.ai.summarizer };
+        return null;
+      };
+
+      // Convert a markdown bullet list into <li> elements using textContent (no HTML injection).
+      const renderBullets = (markdown) => {
+        list.replaceChildren();
+        const lines = markdown
+          .split('\n')
+          .map((l) => l.trim())
+          .filter(Boolean)
+          .map((l) => l.replace(/^([-*•]|\d+[.)])\s+/, '').replace(/\*\*(.+?)\*\*/g, '$1'));
+        for (const line of lines) {
+          const li = document.createElement('li');
+          li.textContent = line;
+          list.appendChild(li);
+        }
+      };
+
+      let summarizer = null;
+      let cachedSummary = '';
+
+      const createSummarizer = async (found) => {
+        const options = {
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          sharedContext: "A coffee roaster's blog post about how they source green coffee beans.",
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const pct = Math.round((e.loaded <= 1 ? e.loaded : e.loaded / (e.total || 1)) * 100);
+              setStatus(`Downloading on-device AI model… ${pct}%`);
+            });
+          },
+        };
+
+        if (found.kind === 'modern') {
+          const availability = await found.api.availability();
+          if (availability === 'unavailable') throw new Error('unavailable');
+          if (availability !== 'available') setStatus('Preparing on-device AI model…');
+          return found.api.create(options);
+        }
+
+        const caps = await found.api.capabilities();
+        if (caps.available === 'no') throw new Error('unavailable');
+        return found.api.create(options);
+      };
+
+      button.addEventListener('click', async () => {
+        panel.hidden = false;
+
+        if (cachedSummary) {
+          renderBullets(cachedSummary);
+          setStatus('');
+          return;
+        }
+
+        const found = getSummarizerApi();
+        if (!found) {
+          list.replaceChildren();
+          setStatus("Your browser doesn't support built-in AI summarization yet. Try a recent version of Chrome with the Summarizer API enabled.");
+          return;
+        }
+
+        button.disabled = true;
+        const originalLabel = button.textContent;
+        button.textContent = 'Summarizing…';
+        list.replaceChildren();
+        setStatus('Summarizing with on-device AI…');
+
+        try {
+          summarizer ??= await createSummarizer(found);
+          const text = source.innerText.trim();
+          const context = 'Summarize for a coffee shop customer in a few concise bullet points.';
+
+          let result = '';
+          if (typeof summarizer.summarizeStreaming === 'function') {
+            const stream = summarizer.summarizeStreaming(text, { context });
+            for await (const chunk of stream) {
+              // Older Chrome builds emitted the full text so far; newer ones emit deltas.
+              result = chunk.startsWith(result) ? chunk : result + chunk;
+              renderBullets(result);
+              setStatus('');
+            }
+          } else {
+            result = await summarizer.summarize(text, { context });
+          }
+
+          cachedSummary = result;
+          renderBullets(result);
+          setStatus(result.trim() ? '' : 'The AI returned an empty summary. Please try again.');
+        } catch (err) {
+          console.error('Summarization failed:', err);
+          summarizer = null;
+          list.replaceChildren();
+          setStatus(err && err.message === 'unavailable'
+            ? "Built-in AI summarization isn't available on this device."
+            : 'Sorry, something went wrong while summarizing. Please try again.');
+        } finally {
+          button.disabled = false;
+          button.textContent = originalLabel;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
