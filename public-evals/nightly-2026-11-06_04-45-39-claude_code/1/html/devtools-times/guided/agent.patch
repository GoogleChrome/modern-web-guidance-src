+}
+/* Native <dialog> modals: keep scroll gestures from chaining to the page behind */
+dialog:modal {
+  overscroll-behavior: contain;
+}
+dialog::backdrop {
+  overflow: hidden;
+  overscroll-behavior: contain;
+}
+
+/* Mega-menu popover: tether to the main navigation bar via anchor positioning.
+   Browsers without anchor positioning get coordinates set from JS (see BottomNav). */
+.main-nav {
+  anchor-name: --main-nav;
+}
+.nav-flyout {
+  position: fixed;
+  inset: auto;
+  margin: 0;
+  padding: 0;
+  border: 0;
+}
+@supports (anchor-name: --a) {
+  .nav-flyout {
+    position-anchor: --main-nav;
+    top: anchor(bottom);
+    left: anchor(left);
+    width: anchor-size(width);
+  }
+}
