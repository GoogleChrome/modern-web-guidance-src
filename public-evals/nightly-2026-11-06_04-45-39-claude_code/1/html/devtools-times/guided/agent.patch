diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..85fa97a
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,74 @@
+import React, { useEffect, useRef } from 'react';
+
+interface Props {
+  open: boolean;
+  onClose: () => void;
+  labelledBy: string;
+  closeLabel: string;
+  className?: string;
+  children: React.ReactNode;
+}
+
+const supportsClosedBy =
+  typeof HTMLDialogElement !== 'undefined' && 'closedBy' in HTMLDialogElement.prototype;
+
+const isOutside = (e: React.PointerEvent, el: HTMLElement) => {
+  const r = el.getBoundingClientRect();
+  return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+};
+
+/**
+ * Native modal <dialog>. The browser provides focus containment, inert background,
+ * Esc / back-gesture dismissal and focus return to the invoking control.
+ */
+export default function Modal({ open, onClose, labelledBy, closeLabel, className = '', children }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const pressedOutside = useRef(false);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (open && !dialog.open) {
+      dialog.showModal();
+      // React's `autoFocus` doesn't emit the HTML attribute, so move initial focus explicitly.
+      dialog.querySelector<HTMLElement>('[data-autofocus]')?.focus();
+    }
+    if (!open && dialog.open) dialog.close();
+  }, [open]);
+
+  // Light-dismiss fallback for browsers without `closedby` support.
+  const fallbackHandlers = supportsClosedBy
+    ? {}
+    : {
+        onPointerDown: (e: React.PointerEvent<HTMLDialogElement>) => {
+          pressedOutside.current = isOutside(e, e.currentTarget);
+        },
+        onPointerUp: (e: React.PointerEvent<HTMLDialogElement>) => {
+          if (pressedOutside.current && isOutside(e, e.currentTarget)) e.currentTarget.close();
+          pressedOutside.current = false;
+        },
+      };
+
+  return (
+    <dialog
+      ref={dialogRef}
+      aria-labelledby={labelledBy}
+      onClose={onClose}
+      {...({ closedby: 'any' } as any)}
+      {...fallbackHandlers}
+      className={`m-auto mt-[15vh] w-[calc(100%-2rem)] max-w-2xl overflow-visible bg-white p-0 shadow-xl backdrop:bg-white/30 backdrop:backdrop-blur-sm ${className}`}
+    >
+      <button
+        type="button"
+        aria-label={closeLabel}
+        onClick={() => dialogRef.current?.close()}
+        className="absolute -top-2 -right-2 bg-white rounded-full p-1 shadow-md text-gray-500 hover:text-amber-400 hover:scale-110 transition-transform z-10"
+      >
+        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+          <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
+        </svg>
+      </button>
+      {open && children}
+    </dialog>
+  );
+}
