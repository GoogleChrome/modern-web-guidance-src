+
+    /* Layout density toggle (CSS container style queries) */
+    .section-header {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 10px;
+      /* Feature-check flag: inherited by the toggle, only readable via style queries */
+      --style-queries-check: yes;
+    }
+
+    #toggle-spacious {
+      /* Hidden unless the browser supports style queries (see below) */
+      display: none;
+      background: transparent;
+      color: var(--primary);
+      border: 1px solid var(--primary);
+      border-radius: 5px;
+      padding: 6px 14px;
+      font: inherit;
+      font-size: 0.85rem;
+      cursor: pointer;
+      transition: background 0.3s, color 0.3s;
+    }
+
+    #toggle-spacious:hover,
+    #toggle-spacious[aria-pressed="true"] {
+      background: var(--primary);
+      color: white;
+    }
+
+    /* Only browsers that understand style() queries will ever match this */
+    @container style(--style-queries-check: yes) {
+      #toggle-spacious {
+        display: inline-block;
+      }
+    }
+
+    #target-container {
+      container-name: density;
+      --layout-density: compact;
+    }
+
+    #target-item {
+      transition: padding 0.3s ease;
+    }
+
+    /* The card reacts to its ancestor's custom property; no JS touches it */
+    @container density style(--layout-density: spacious) {
+      #target-item {
+        padding: 48px 36px;
+      }
+    }
   </style>
 </head>
 
