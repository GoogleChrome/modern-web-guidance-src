+    /* Layout density: a higher-order design token set on #target-container
+       and read by descendants via container style queries. */
+    :root {
+      --style-queries-supported: check;
+    }
+
+    #target-container {
+      --density: comfortable;
+      container-name: density;
+    }
+
+    #target-item {
+      transition: padding 0.3s ease;
+    }
+
+    @container density style(--density: spacious) {
+      #target-item {
+        padding: 48px 36px;
+      }
+    }
+
+    .density-controls {
+      text-align: center;
+    }
+
+    /* Hidden unless the browser supports container style queries */
+    #toggle-spacious {
+      display: none;
+      font: inherit;
+      cursor: pointer;
+      background: white;
+      color: var(--primary);
+      border: 2px solid var(--primary);
+      border-radius: 5px;
+      padding: 8px 16px;
+    }
+
+    #toggle-spacious[aria-pressed="true"] {
+      background: var(--primary);
+      color: white;
+    }
+
+    @container style(--style-queries-supported: check) {
+      #toggle-spacious {
+        display: inline-block;
+      }
+    }
