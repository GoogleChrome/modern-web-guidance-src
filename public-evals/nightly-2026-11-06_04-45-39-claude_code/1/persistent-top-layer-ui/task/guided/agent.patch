+  <p id="feedback-status" class="visually-hidden" role="status"></p>
+
+  <script type="module">
+    // Invoker Commands polyfill, only where native support is missing
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://unpkg.com/invokers-polyfill@latest/invoker.min.js');
+    }
+
+    const dialog = document.getElementById('feedback-dialog');
+    const zones = [
+      document.getElementById('feedback-zone-main'),
+      document.getElementById('feedback-zone-footer'),
+    ];
+    const locationLabel = dialog.querySelector('[data-location]');
+    const status = document.getElementById('feedback-status');
+
+    // Light-dismiss fallback where closedby is unsupported
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e)) dialog.close(); });
+    }
+
+    function moveDialog() {
+      const current = dialog.parentElement;
+      const target = zones[(zones.indexOf(current) + 1) % zones.length];
+
+      if ('moveBefore' in Element.prototype) {
+        // Atomic move: dialog stays open, modal, and keeps focus
+        target.moveBefore(dialog, null);
+      } else {
+        // Fallback: a traditional move closes the dialog and drops focus, so restore both
+        const wasOpen = dialog.open;
+        const focused = dialog.contains(document.activeElement) ? document.activeElement : null;
+        target.insertBefore(dialog, null);
+        if (wasOpen && !dialog.matches(':modal')) {
+          // Some engines leave the open attribute but drop modality; reset before reopening
+          if (dialog.open) dialog.close();
+          dialog.showModal();
+        }
+        focused?.focus();
+      }
+
+      const name = target.dataset.zoneName;
+      locationLabel.textContent = name;
+      status.textContent = `Feedback dialog moved to ${name}.`;
+    }
+
+    dialog.querySelector('[data-move-dialog]').addEventListener('click', moveDialog);
+
+    dialog.addEventListener('close', () => {
+      if (dialog.returnValue === 'submit') {
+        status.textContent = 'Thanks! Your feedback was sent.';
+        dialog.querySelector('form').reset();
+      }
+      dialog.returnValue = '';
+    });
+  </script>
