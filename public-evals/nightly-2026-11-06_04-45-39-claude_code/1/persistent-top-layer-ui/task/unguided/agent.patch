+  <script>
+    (() => {
+      const dialog = document.getElementById('feedback-dialog');
+      const trigger = document.getElementById('feedback-trigger');
+      const form = dialog.querySelector('[data-form]');
+      const thanks = dialog.querySelector('[data-thanks]');
+      const locationLabel = dialog.querySelector('[data-location]');
+      const announcer = dialog.querySelector('[data-announcer]');
+      const hosts = Array.from(document.querySelectorAll('[data-feedback-host]'));
+
+      let opener = null;
+
+      function resetForm() {
+        form.reset();
+        form.hidden = false;
+        thanks.hidden = true;
+      }
+
+      function open() {
+        if (dialog.open) return;
+        opener = document.activeElement;
+        resetForm();
+        dialog.showModal();
+      }
+
+      function syncHostState() {
+        const current = dialog.parentElement;
+        hosts.forEach((h) => h.classList.toggle('has-modal', h === current));
+        locationLabel.textContent = current.dataset.hostLabel || current.id || 'Unknown';
+      }
+
+      /**
+       * Relocate the dialog node into `target` without closing it or dropping focus.
+       *
+       * Preferred path: Element.prototype.moveBefore() performs an atomic,
+       * state-preserving move — the dialog stays in the top layer (still modal),
+       * and the focused element inside it keeps focus.
+       *
+       * Fallback (browsers without moveBefore): a plain remove+insert would drop the
+       * dialog out of the top layer (no longer modal / no backdrop) and blur the
+       * focused element. So we snapshot state, move the node, then re-establish
+       * modality with showModal() and restore focus + scroll position.
+       */
+      function moveDialogTo(target) {
+        if (!target || target === dialog.parentElement) return;
+
+        const wasOpen = dialog.open;
+        const wasModal = wasOpen && dialog.matches(':modal');
+        const focused = dialog.contains(document.activeElement) ? document.activeElement : null;
+        const body = dialog.querySelector('.body');
+        const scrollTop = body ? body.scrollTop : 0;
+        const selection = focused && 'selectionStart' in focused && typeof focused.selectionStart === 'number'
+          ? [focused.selectionStart, focused.selectionEnd, focused.selectionDirection]
+          : null;
+
+        let movedAtomically = false;
+        if (typeof target.moveBefore === 'function') {
+          try {
+            target.moveBefore(dialog, null);
+            movedAtomically = true;
+          } catch (err) {
+            // e.g. HierarchyRequestError in edge cases — fall through to manual move.
+          }
+        }
+
+        if (!movedAtomically) {
+          // Close first so showModal() is allowed afterwards (it throws on an
+          // already-open non-modal dialog). The resulting async "close" event is
+          // ignored by the handler below because the dialog is open again by then.
+          if (wasOpen) dialog.close();
+          target.appendChild(dialog);
+          if (wasOpen) {
+            wasModal ? dialog.showModal() : dialog.show();
+          }
+        }
+
+        // Re-assert focus/scroll (no-op when moveBefore already preserved them).
+        if (wasOpen && focused && document.activeElement !== focused) {
+          focused.focus({ preventScroll: true });
+          if (selection) {
+            try { focused.setSelectionRange(...selection); } catch (e) { /* not a text field */ }
+          }
+        }
+        if (body) body.scrollTop = scrollTop;
+
+        syncHostState();
+        announcer.textContent = `Feedback dialog moved to ${locationLabel.textContent}.`;
+      }
+
+      function moveToNextHost() {
+        const idx = hosts.indexOf(dialog.parentElement);
+        moveDialogTo(hosts[(idx + 1) % hosts.length]);
+      }
+
+      trigger.addEventListener('click', open);
+
+      dialog.querySelectorAll('[data-close]').forEach((btn) =>
+        btn.addEventListener('click', () => dialog.close())
+      );
+
+      dialog.querySelector('[data-move]').addEventListener('click', moveToNextHost);
+
+      // Light-dismiss: click on the backdrop (outside the dialog box) closes it.
+      dialog.addEventListener('click', (e) => {
+        if (e.target !== dialog) return;
+        const r = dialog.getBoundingClientRect();
+        const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
+        if (!inside) dialog.close();
+      });
+
+      form.addEventListener('submit', (e) => {
+        // Keep the dialog open to show the confirmation instead of closing.
+        e.preventDefault();
+        form.hidden = true;
+        thanks.hidden = false;
+        thanks.querySelector('[data-close]').focus();
+      });
+
+      dialog.addEventListener('close', () => {
+        // The close event is dispatched asynchronously; if the dialog is open
+        // again, this close came from the fallback move path — ignore it.
+        if (dialog.open) return;
+        // Return focus to whatever opened the dialog (the fallback move path can
+        // reset the browser's own record of the previously focused element).
+        const target = opener && opener.isConnected ? opener : trigger;
+        target.focus();
+        opener = null;
+      });
+
+      syncHostState();
+    })();
+  </script>
+
