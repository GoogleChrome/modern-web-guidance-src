+  <script type="module">
+    // Interest invokers (`interestfor`) declaratively wire hover/focus/long-press
+    // on each "View Details" button to the preview box; one listener on the target.
+    if (!HTMLButtonElement.prototype.hasOwnProperty("interestForElement")) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+
+    const preview = document.getElementById("seasonal-preview");
+    const title = preview.querySelector(".preview-title");
+    const note = preview.querySelector(".preview-note");
+    const DEFAULT_TEXT = "Select a drink to preview";
+
+    preview.addEventListener("interest", (event) => {
+      const { drink, note: detail, accent } = event.source.dataset;
+      title.textContent = drink;
+      note.textContent = detail ?? "";
+      preview.style.setProperty("--preview-accent", accent);
+    });
+
+    preview.addEventListener("loseinterest", () => {
+      title.textContent = DEFAULT_TEXT;
+      note.textContent = "";
+      preview.style.removeProperty("--preview-accent");
+    });
+  </script>
+
 </body>
 
