+  <script>
+    // The "View Details" links declare their preview target with the
+    // `interestfor` attribute, so the browser itself detects hover, keyboard
+    // focus and long-press and dispatches `interest` / `loseinterest` on the
+    // single #seasonal-preview element. No per-button listeners are attached.
+    (() => {
+      const preview = document.getElementById('seasonal-preview');
+      const text = preview.querySelector('.preview-text');
+      const defaultText = preview.dataset.default;
+
+      const show = (invoker) => {
+        if (!invoker || !invoker.dataset.drink) return;
+        preview.style.setProperty('--preview-accent', invoker.dataset.accent);
+        text.textContent = `${invoker.dataset.drink} \u2014 ${invoker.dataset.accentName}`;
+        preview.classList.add('is-active');
+      };
+      const reset = () => {
+        preview.style.removeProperty('--preview-accent');
+        text.textContent = defaultText;
+        preview.classList.remove('is-active');
+      };
+
+      const supportsInterest = 'interestForElement' in HTMLAnchorElement.prototype;
+      if (supportsInterest) {
+        preview.addEventListener('interest', (e) => show(e.source));
+        preview.addEventListener('loseinterest', reset);
+        return;
+      }
+
+      // Fallback for browsers without interest invokers: one delegated set of
+      // listeners on the section, still keyed off the declarative attribute.
+      const section = preview.closest('section');
+      const invokerFrom = (el) => el && el.closest && el.closest('[interestfor="seasonal-preview"]');
+      const leave = (e) => {
+        const from = invokerFrom(e.target);
+        if (from && !from.contains(e.relatedTarget)) reset();
+      };
+      section.addEventListener('pointerover', (e) => show(invokerFrom(e.target)));
+      section.addEventListener('pointerout', leave);
+      section.addEventListener('focusin', (e) => show(invokerFrom(e.target)));
+      section.addEventListener('focusout', leave);
+    })();
+  </script>
+
