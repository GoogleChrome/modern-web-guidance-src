     .btn:hover {
       background: #3e2723;
     }
 
+
+    /* Spotlight reveal on seasonal product cards */
+    @property --mouse-x {
+      syntax: '<length-percentage>';
+      inherits: true;
+      initial-value: 50%;
+    }
+
+    @property --mouse-y {
+      syntax: '<length-percentage>';
+      inherits: true;
+      initial-value: 50%;
+    }
+
+    @property --inner-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      overflow: hidden;
+      padding-top: 52px;
+      /* Only the spotlight size animates; position updates are instant. */
+      transition-property: --inner-size, --outer-size;
+      transition-duration: 0.35s;
+      transition-timing-function: ease-out;
+    }
+
+    .product-card:hover,
+    .product-card:focus-within {
+      --inner-size: 70px;
+      --outer-size: 110px;
+    }
+
+    .spotlight-overlay {
+      position: absolute;
+      inset: 0;
+      z-index: 1;
+      pointer-events: none;
+      border-radius: inherit;
+      background: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          rgba(255, 171, 64, 0.22), rgba(255, 171, 64, 0.06) 70%);
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+      user-select: none;
+    }
+
+    .spotlight-details {
+      position: absolute;
+      top: 0;
+      left: 0;
+      right: 0;
+      display: flex;
+      justify-content: space-between;
+      gap: 8px;
+      padding: 14px 20px;
+      font-size: 0.8rem;
+      font-weight: 600;
+      color: var(--primary);
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
