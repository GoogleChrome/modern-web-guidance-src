+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      isolation: isolate;
+      padding-block: 44px;
+      /* Only the size transitions; the position variables update instantly */
+      transition: --inner-size 0.3s ease-out, --outer-size 0.3s ease-out;
+    }
+
+    .product-card:hover {
+      --inner-size: 90px;
+      --outer-size: 130px;
