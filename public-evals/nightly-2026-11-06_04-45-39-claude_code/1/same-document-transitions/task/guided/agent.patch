+  <script>
+    const ITEMS = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        tagline: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        body: 'Our house espresso pulled over velvety steamed oat milk and sweetened with pure, grade-A Vermont maple syrup. Finished with a dusting of cinnamon for a cozy autumn sip.',
+        image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1600&q=80',
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        tagline: 'Bold, smokey, and perfect for a morning boost.',
+        body: 'A double shot of our signature dark roast, roasted in small batches until the beans develop deep notes of cocoa, toasted walnut, and a lingering smokey finish.',
+        image: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=1600&q=80',
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        tagline: 'Steeped for 18 hours for maximum smoothness.',
+        body: 'Coarse-ground single-origin beans steeped cold for 18 hours, producing a naturally sweet, low-acid brew. Served over ice, black or with a splash of your favorite milk.',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1600&q=80',
+      },
+    };
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const hero = document.getElementById('hero');
+    const heroImg = hero.querySelector('img');
+    const title = document.getElementById('title');
+    const tagline = detailPage.querySelector('.detail-tagline');
+    const body = detailPage.querySelector('.detail-body');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    let currentSlug = null; // slug shown in the detail view, or null for the list
+    let activeTransition = null;
+
+    function slugFromHash() {
+      const slug = location.hash.replace(/^#\/?/, '');
+      return slug in ITEMS ? slug : null;
+    }
+
+    function thumbnailFor(slug) {
+      return slug ? document.querySelector(`.thumbnail[data-slug="${CSS.escape(slug)}"]`) : null;
+    }
+
+    function clearSelection() {
+      document.querySelectorAll('.thumbnail.selected').forEach((el) => el.classList.remove('selected'));
+    }
+
+    function renderDetail(slug) {
+      const item = ITEMS[slug];
+      heroImg.src = item.image;
+      heroImg.alt = item.title;
+      title.textContent = item.title;
+      tagline.textContent = item.tagline;
+      body.textContent = item.body;
+      document.title = `${item.title} | The Daily Grind`;
+      listPage.hidden = true;
+      detailPage.hidden = false;
+      scrollTo(0, 0);
+    }
+
+    function renderList() {
+      detailPage.hidden = true;
+      listPage.hidden = false;
+      document.title = 'The Daily Grind | Artisanal Coffee';
+    }
+
+    async function decodeImage(img) {
+      try { await img.decode(); } catch { /* ignore broken/slow images */ }
+    }
+
+    function route() {
+      const nextSlug = slugFromHash();
+      if (nextSlug === currentSlug) return;
+
+      const prevSlug = currentSlug;
+      currentSlug = nextSlug;
+      const toDetail = nextSlug !== null;
+
+      // Finish any in-flight transition before starting a new one.
+      activeTransition?.skipTransition();
+      clearSelection();
+
+      // Mark the thumbnail that pairs with #hero / #title in the *list* state.
+      // Going to detail: the clicked thumbnail is in the old state.
+      // Going back: the thumbnail for the item we're leaving is in the new state.
+      const thumb = thumbnailFor(toDetail ? nextSlug : prevSlug);
+      thumb?.classList.add('selected');
+
+      const update = async () => {
+        if (toDetail) {
+          renderDetail(nextSlug);
+          await decodeImage(heroImg);
+        } else {
+          renderList();
+        }
+      };
+
+      const focusTarget = toDetail ? title : listHeading;
+      const cleanup = () => {
+        clearSelection();
+        focusTarget.focus();
+      };
+
+      if (!document.startViewTransition || reducedMotion.matches) {
+        update().finally(cleanup);
+        return;
+      }
+
+      const transition = document.startViewTransition(update);
+      activeTransition = transition;
+      transition.finished.finally(() => {
+        if (activeTransition === transition) activeTransition = null;
+        // Only clean up if no newer navigation has taken over.
+        if (currentSlug === nextSlug) cleanup();
+      });
+    }
+
+    addEventListener('hashchange', route);
+
+    // Initial render (no animation) for deep links such as #/cold-brew.
+    currentSlug = slugFromHash();
+    if (currentSlug) renderDetail(currentSlug);
+  </script>
+
 </body>
 
