+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      animation-duration: 0.45s;
+    }
+
+    /* Text morph: scale each snapshot uniformly from its height (width: auto
+       keeps its intrinsic aspect ratio) and anchor it top-left, so the glyphs
+       grow/shrink without being squashed horizontally. */
+    ::view-transition-group(title) {
+      animation-duration: 0.45s;
+      animation-timing-function: cubic-bezier(0.2, 0, 0, 1);
+    }
+
+    ::view-transition-old(title),
+    ::view-transition-new(title) {
+      width: auto;
+      height: 100%;
+      left: 0;
+      right: auto;
+      object-fit: contain;
