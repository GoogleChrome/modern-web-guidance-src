+      grid.appendChild(a);
+    }
+
+    const thumbnailFor = (slug) => grid.querySelector(`.thumbnail[data-slug="${slug}"]`);
+
+    // ---------- Routing ----------
+    function parseRoute() {
+      const m = location.hash.match(/^#\/menu\/([\w-]+)$/);
+      const item = m && ITEMS.find((i) => i.slug === m[1]);
+      return item ? { view: 'detail', item } : { view: 'list' };
+    }
+
+    let current = { view: 'list' };
+    let listScrollY = 0;
+    let navigatedInApp = false;
+    let transitionId = 0;
+
+    function setNames(el, titleNode) {
+      if (el) el.style.viewTransitionName = 'hero';
+      if (titleNode) titleNode.style.viewTransitionName = 'title';
+    }
+
+    function clearTransitionState() {
+      document.querySelectorAll('.thumbnail, .thumbnail .title, #hero, #title').forEach((el) => {
+        el.style.removeProperty('view-transition-name');
+      });
+      document.documentElement.classList.remove('is-transitioning');
+      delete document.documentElement.dataset.transitionDirection;
+    }
+
+    function fillDetail(item) {
+      heroImg.src = item.image;
+      heroImg.alt = item.alt;
+      titleEl.textContent = item.name;
+      $('#detail-description').textContent = item.description;
+      $('#detail-story').textContent = item.story;
+      $('#detail-facts').innerHTML = Object.entries(item.facts)
+        .map(([k, v]) => `<li><strong>${k}</strong>${v}</li>`)
+        .join('');
+      document.title = `${item.name} | The Daily Grind`;
+    }
+
+    function showDetail(item) {
+      fillDetail(item);
+      listPage.hidden = true;
+      detailPage.hidden = false;
+      window.scrollTo(0, 0);
+      titleEl.focus({ preventScroll: true });
+    }
+
+    function showList() {
+      detailPage.hidden = true;
+      listPage.hidden = false;
+      document.title = 'The Daily Grind | Artisanal Coffee';
+      window.scrollTo(0, listScrollY);
+      listHeading.focus({ preventScroll: true });
+    }
+
+    function render(next, { animate = true } = {}) {
+      const prev = current;
+      if (prev.view === next.view && prev.item === next.item) return;
+
+      const goingToDetail = next.view === 'detail';
+      const morphItem = goingToDetail ? next.item : prev.item;
+      const thumb = morphItem && thumbnailFor(morphItem.slug);
+
+      if (prev.view === 'list') listScrollY = window.scrollY;
+
+      const update = () => {
+        if (goingToDetail) {
+          // Hand the names over from the thumbnail to the detail elements.
+          if (thumb) {
+            thumb.style.removeProperty('view-transition-name');
+            thumb.querySelector('.title').style.removeProperty('view-transition-name');
+          }
+          showDetail(next.item);
+          if (thumb && prev.view === 'list') setNames(hero, titleEl);
+        } else {
+          hero.style.removeProperty('view-transition-name');
+          titleEl.style.removeProperty('view-transition-name');
+          showList();
+          if (thumb) setNames(thumb, thumb.querySelector('.title'));
+        }
+        current = next;
+      };
+
+      const canAnimate = animate && document.startViewTransition && !reducedMotion.matches;
+      if (!canAnimate) {
+        update();
+        clearTransitionState();
+        return;
+      }
+
+      // Old-state names: only morph between list <-> detail (not detail -> detail).
+      clearTransitionState();
+      const id = ++transitionId;
+      const root = document.documentElement;
+      root.classList.add('is-transitioning');
+      root.dataset.transitionDirection = goingToDetail ? 'forward' : 'back';
+
+      if (goingToDetail && prev.view === 'list' && thumb) {
+        setNames(thumb, thumb.querySelector('.title'));
+      } else if (!goingToDetail && prev.view === 'detail') {
+        setNames(hero, titleEl);
+      }
+
+      const transition = document.startViewTransition(update);
+      transition.finished.finally(() => {
+        // Only the latest transition is allowed to clean up, so an interrupted
+        // transition can't strip names from the one that replaced it.
+        if (id === transitionId) clearTransitionState();
+      });
+    }
+
+    window.addEventListener('hashchange', () => {
+      const next = parseRoute();
+      if (next.view === 'detail' && current.view === 'list') navigatedInApp = true;
+      if (next.view === 'list') navigatedInApp = false;
+      render(next);
+    });
+
+    backBtn.addEventListener('click', () => {
+      // Pop the history entry we pushed if we came from the list; otherwise
+      // (deep link) navigate to the list explicitly.
+      if (navigatedInApp) history.back();
+      else location.hash = '#/';
+    });
+
+    // Initial route (supports deep links) without animation.
+    render(parseRoute(), { animate: false });
+  </script>
