+
+    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+    // ---------- Render list ----------
+    for (const item of ITEMS) {
+      const a = document.createElement('a');
+      a.className = 'thumbnail';
+      a.href = `#/menu/${item.slug}`;
