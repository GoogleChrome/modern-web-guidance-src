+  <!-- In-page sign-in: passkeys + saved passwords, no redirect to a login page -->
+  <dialog id="signin-dialog" class="signin-dialog" aria-labelledby="signin-title">
+    <form id="signin-form" method="post" action="/api/auth/password" novalidate>
+      <div class="signin-header">
+        <h2 id="signin-title">Welcome back</h2>
+        <button type="button" class="signin-close" data-close aria-label="Close sign-in">&times;</button>
+      </div>
+      <p class="signin-subtitle" id="signin-subtitle">Sign in to keep browsing. Your passkeys and saved passwords will show up below.</p>
+
+      <label for="signin-username">Email
+        <input id="signin-username" name="username" type="email" required
+          autocomplete="username webauthn" autocapitalize="off" spellcheck="false">
+      </label>
+      <label for="signin-password">Password
+        <input id="signin-password" name="password" type="password" required autocomplete="current-password">
+      </label>
+
+      <p class="signin-error" id="signin-error" role="alert" aria-live="polite"></p>
+
+      <button type="submit" class="btn">Sign In</button>
+      <div class="signin-divider" data-passkey-only>or</div>
+      <button type="button" class="btn btn-outline" id="passkey-btn" data-passkey-only>Sign in with a passkey</button>
+
+      <p class="signin-footer">New here? <a href="/signup">Create an account</a></p>
+    </form>
+  </dialog>
+
+  <script>
+    (() => {
+      // Backend endpoints (adjust to match the server).
+      const API = {
+        session: '/api/auth/session',          // GET  -> 200 { user } when signed in
+        passkeyOptions: '/api/auth/passkey/options', // POST -> PublicKeyCredentialRequestOptions (JSON)
+        passkeyVerify: '/api/auth/passkey/verify',   // POST credential JSON -> 200 { user }
+        password: '/api/auth/password',        // POST { username, password } -> 200 { user }
+        logout: '/api/auth/logout'             // POST
+      };
+
+      const dialog = document.getElementById('signin-dialog');
+      const form = document.getElementById('signin-form');
+      const usernameInput = document.getElementById('signin-username');
+      const passwordInput = document.getElementById('signin-password');
+      const errorEl = document.getElementById('signin-error');
+      const subtitle = document.getElementById('signin-subtitle');
+      const passkeyBtn = document.getElementById('passkey-btn');
+      const defaultSubtitle = subtitle.textContent;
+
+      const supportsWebAuthn = !!window.PublicKeyCredential && !!navigator.credentials;
+      const supportsPasswordCred = 'PasswordCredential' in window;
+
+      let pendingHref = null;       // link the user clicked before signing in
+      let conditionalAbort = null;  // AbortController for passkey autofill request
+      let busy = false;
+
+      if (!supportsWebAuthn) {
+        document.querySelectorAll('[data-passkey-only]').forEach(el => el.hidden = true);
+      }
+
+      // ---------- helpers ----------
+      const b64urlToBuf = (s) => {
+        const pad = '='.repeat((4 - (s.length % 4)) % 4);
+        const bin = atob((s + pad).replace(/-/g, '+').replace(/_/g, '/'));
+        return Uint8Array.from(bin, c => c.charCodeAt(0)).buffer;
+      };
+      const bufToB64url = (buf) => {
+        let bin = '';
+        new Uint8Array(buf).forEach(b => bin += String.fromCharCode(b));
+        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      };
+
+      const parseRequestOptions = (json) => {
+        if (PublicKeyCredential.parseRequestOptionsFromJSON) {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(json);
+        }
+        return {
+          ...json,
+          challenge: b64urlToBuf(json.challenge),
+          allowCredentials: (json.allowCredentials || []).map(c => ({ ...c, id: b64urlToBuf(c.id) }))
+        };
+      };
+
+      const credentialToJSON = (cred) => {
+        if (typeof cred.toJSON === 'function') return cred.toJSON();
+        const r = cred.response;
+        return {
+          id: cred.id,
+          rawId: bufToB64url(cred.rawId),
+          type: cred.type,
+          authenticatorAttachment: cred.authenticatorAttachment || null,
+          clientExtensionResults: cred.getClientExtensionResults(),
+          response: {
+            clientDataJSON: bufToB64url(r.clientDataJSON),
+            authenticatorData: bufToB64url(r.authenticatorData),
+            signature: bufToB64url(r.signature),
+            userHandle: r.userHandle ? bufToB64url(r.userHandle) : null
+          }
+        };
+      };
+
+      const postJSON = async (url, body) => {
+        const res = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(body || {})
+        });
+        if (!res.ok) {
+          const err = new Error('Request failed');
+          err.status = res.status;
+          throw err;
+        }
+        return res.json().catch(() => ({}));
+      };
+
+      const showError = (msg) => { errorEl.textContent = msg || ''; };
+
+      const toast = (msg) => {
+        const t = document.createElement('div');
+        t.className = 'welcome-toast';
+        t.setAttribute('role', 'status');
+        t.textContent = msg;
+        document.body.appendChild(t);
+        setTimeout(() => t.remove(), 3000);
+      };
+
+      // ---------- session state ----------
+      const setSignedIn = (signedIn) => {
+        document.body.classList.toggle('signed-in', signedIn);
+      };
+      const isSignedIn = () => document.body.classList.contains('signed-in');
+
+      const checkSession = async () => {
+        try {
+          const res = await fetch(API.session, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
+          setSignedIn(res.ok);
+        } catch {
+          setSignedIn(false);
+        }
+      };
+
+      const onSignedIn = (user) => {
+        setSignedIn(true);
+        stopConditionalPasskey();
+        if (dialog.open) dialog.close();
+        form.reset();
+        showError('');
+        const name = user && (user.firstName || user.name);
+        toast(name ? `Welcome back, ${name}!` : 'Welcome back!');
+        const href = pendingHref;
+        pendingHref = null;
+        // Continue to whatever the customer originally clicked.
+        if (href) window.location.assign(href);
+      };
+
+      // ---------- passkeys ----------
+      const getPasskeyOptions = async () => parseRequestOptions(await postJSON(API.passkeyOptions));
+
+      const finishPasskey = async (cred) => {
+        const result = await postJSON(API.passkeyVerify, credentialToJSON(cred));
+        onSignedIn(result.user);
+      };
+
+      const stopConditionalPasskey = () => {
+        if (conditionalAbort) {
+          conditionalAbort.abort();
+          conditionalAbort = null;
+        }
+      };
+
+      // Passkey autofill: passkeys appear in the email field's autofill
+      // suggestions alongside saved passwords.
+      const startConditionalPasskey = async () => {
+        if (!supportsWebAuthn || isSignedIn() || conditionalAbort) return;
+        try {
+          if (!PublicKeyCredential.isConditionalMediationAvailable ||
+              !(await PublicKeyCredential.isConditionalMediationAvailable())) return;
+          const publicKey = await getPasskeyOptions();
+          conditionalAbort = new AbortController();
+          const cred = await navigator.credentials.get({
+            publicKey,
+            mediation: 'conditional',
+            signal: conditionalAbort.signal
+          });
+          conditionalAbort = null;
+          if (cred) await finishPasskey(cred);
+        } catch (err) {
+          conditionalAbort = null;
+          if (err.name !== 'AbortError' && err.name !== 'NotAllowedError' && dialog.open) {
+            showError('We couldn\u2019t sign you in with that passkey. Please try again.');
+          }
+        }
+      };
+
+      // Explicit "Sign in with a passkey" button (modal browser prompt).
+      passkeyBtn.addEventListener('click', async () => {
+        if (busy) return;
+        busy = true;
+        showError('');
+        stopConditionalPasskey();
+        try {
+          const publicKey = await getPasskeyOptions();
+          const cred = await navigator.credentials.get({ publicKey, mediation: 'optional' });
+          if (cred) await finishPasskey(cred);
+        } catch (err) {
+          if (err.name !== 'AbortError' && err.name !== 'NotAllowedError') {
+            showError('Passkey sign-in failed. Try again or use your password.');
+          }
+        } finally {
+          busy = false;
+          if (dialog.open && !isSignedIn()) startConditionalPasskey();
+        }
+      });
+
+      // ---------- passwords ----------
+      const signInWithPassword = async (username, password) => {
+        const result = await postJSON(API.password, { username, password });
+        // Offer to save/update the password in the browser's password manager.
+        if (supportsPasswordCred) {
+          try {
+            await navigator.credentials.store(new PasswordCredential({ id: username, password }));
+          } catch { /* ignore */ }
+        }
+        onSignedIn(result.user);
+      };
+
+      form.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        if (busy) return;
+        const username = usernameInput.value.trim();
+        const password = passwordInput.value;
+        if (!username || !password) {
+          showError('Please enter your email and password.');
+          (username ? passwordInput : usernameInput).focus();
+          return;
+        }
+        busy = true;
+        showError('');
+        try {
+          await signInWithPassword(username, password);
+        } catch (err) {
+          showError(err.status === 401 || err.status === 403
+            ? 'That email and password don\u2019t match our records.'
+            : 'Something went wrong. Please try again.');
+          passwordInput.select();
+        } finally {
+          busy = false;
+        }
+      });
+
+      // ---------- dialog ----------
+      const openSignIn = (href, reason) => {
+        pendingHref = href || null;
+        subtitle.textContent = reason || defaultSubtitle;
+        showError('');
+        if (!dialog.open) dialog.showModal();
+        usernameInput.focus();
+        startConditionalPasskey();
+      };
+
+      dialog.addEventListener('close', () => {
+        stopConditionalPasskey();
+        pendingHref = null;
+      });
+      dialog.querySelector('[data-close]').addEventListener('click', () => dialog.close());
+      // Close when clicking the backdrop.
+      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
+
+      document.querySelectorAll('[data-signin]').forEach(btn =>
+        btn.addEventListener('click', () => openSignIn(null)));
+
+      const reasons = {
+        '/rewards': 'Sign in to see your rewards and points balance.',
+        '/account': 'Sign in to manage your account.',
+        '/order-online': 'Sign in to start your order.'
+      };
+
+      // Intercept links that require an account and sign in in place.
+      document.addEventListener('click', (e) => {
+        const link = e.target.closest('a[data-requires-auth]');
+        if (!link || isSignedIn()) return;
+        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+        e.preventDefault();
+        const path = new URL(link.href, location.href).pathname;
+        openSignIn(link.href, reasons[path]);
+      });
+
+      // ---------- logout ----------
+      document.querySelectorAll('[data-logout]').forEach(link =>
+        link.addEventListener('click', async (e) => {
+          e.preventDefault();
+          try { await postJSON(API.logout); } catch { /* ignore */ }
+          // Stop the browser from auto-signing the user back in.
+          if (navigator.credentials && navigator.credentials.preventSilentAccess) {
+            try { await navigator.credentials.preventSilentAccess(); } catch { /* ignore */ }
+          }
+          setSignedIn(false);
+          toast('You\u2019ve been signed out.');
+        }));
+
+      checkSession();
+    })();
+  </script>
+
 </body>
 
