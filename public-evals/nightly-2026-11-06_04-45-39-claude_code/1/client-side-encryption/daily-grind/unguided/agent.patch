+++ b/js/sealed-notes.js
@@ -0,0 +1,344 @@
+/**
+ * Sealed delivery notes — isomorphic (browser + Node >= 20) crypto core.
+ *
+ * Construction (HPKE-style, base mode, single-shot):
+ *
+ *   1. Shared secret via one of three suites against the shop's static public key:
+ *        - XWING-MLKEM768-X25519  hybrid post-quantum KEM (X-Wing: ML-KEM-768 + X25519,
+ *                                 SHA3-256 combiner). DEFAULT — secure if EITHER holds.
+ *        - MLKEM768               pure post-quantum KEM (FIPS 203).
+ *        - X25519                 classical ephemeral-static Diffie-Hellman key agreement.
+ *   2. Key schedule: HKDF-SHA-256
+ *        salt = SHA-256(LABEL || suite || recipientPublicKey || encapsulation)
+ *        info = LABEL || 0x00 || suite || 0x00 || kid
+ *      → 256-bit single-use AES key. Binding the encapsulation and the recipient key into the
+ *      salt gives KEM-transcript binding even for the raw X25519 suite.
+ *   3. AES-256-GCM with a random 96-bit nonce. The full envelope header (version, suite, kid,
+ *      encapsulation, nonce, order reference, timestamp) is authenticated as AAD, so any
+ *      tampering — including swapping metadata between envelopes — fails decryption.
+ *   4. Plaintext is padded (ISO/IEC 7816-4) to a 128-byte bucket to hide the exact note length.
+ *
+ * Only `seal` is needed in the browser; `open` is used by the shop-side tooling.
+ */
+import { ml_kem768, ml_kem768_x25519, x25519 } from '../vendor/noble-pq-0.7.1.min.js';
+
+export const ENVELOPE_VERSION = 1;
+export const LABEL = 'daily-grind/delivery-notes/v1';
+export const PAD_BUCKET = 128;
+export const MAX_NOTE_BYTES = 2048;
+
+const subtle = globalThis.crypto?.subtle;
+const enc = new TextEncoder();
+const dec = new TextDecoder('utf-8', { fatal: true });
+
+/** Raw X25519 used as a KEM: ephemeral-static DH with an all-zero output check (RFC 7748 §6.1). */
+const x25519Kem = {
+  lengths: { publicKey: 32, secretKey: 32, cipherText: 32 },
+  keygen() {
+    const secretKey = x25519.utils.randomSecretKey();
+    return { secretKey, publicKey: x25519.getPublicKey(secretKey) };
+  },
+  encapsulate(publicKey) {
+    const eph = x25519.utils.randomSecretKey();
+    const sharedSecret = x25519.getSharedSecret(eph, publicKey);
+    assertNonZero(sharedSecret);
+    return { cipherText: x25519.getPublicKey(eph), sharedSecret };
+  },
+  decapsulate(cipherText, secretKey) {
+    const sharedSecret = x25519.getSharedSecret(secretKey, cipherText);
+    assertNonZero(sharedSecret);
+    return sharedSecret;
+  },
+};
+
+export const SUITES = Object.freeze({
+  'XWING-MLKEM768-X25519': {
+    kem: ml_kem768_x25519,
+    kind: 'hybrid',
+    title: 'Hybrid post-quantum (X-Wing: ML-KEM-768 + X25519)',
+    publicKeyLength: 1216,
+    encLength: 1120,
+  },
+  MLKEM768: {
+    kem: ml_kem768,
+    kind: 'post-quantum',
+    title: 'Post-quantum KEM (ML-KEM-768, FIPS 203)',
+    publicKeyLength: 1184,
+    encLength: 1088,
+  },
+  X25519: {
+    kem: x25519Kem,
+    kind: 'classical',
+    title: 'Classical key agreement (X25519 ECDH)',
+    publicKeyLength: 32,
+    encLength: 32,
+  },
+});
+
+/** Strongest first. Clients pick the first suite the published key set offers. */
+export const SUITE_PREFERENCE = ['XWING-MLKEM768-X25519', 'MLKEM768', 'X25519'];
+
+// ---------------------------------------------------------------------------------------------
+// Encoding helpers
+// ---------------------------------------------------------------------------------------------
+
+export function b64uEncode(bytes) {
+  let bin = '';
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
+  }
+  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function b64uDecode(str) {
+  if (typeof str !== 'string' || !/^[A-Za-z0-9_-]*$/.test(str)) {
+    throw new SealedNoteError('Malformed base64url value');
+  }
+  const b64 = str.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((str.length + 3) % 4);
+  const bin = atob(b64);
+  const out = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+  return out;
+}
+
+function concat(...parts) {
+  const len = parts.reduce((n, p) => n + p.length, 0);
+  const out = new Uint8Array(len);
+  let off = 0;
+  for (const p of parts) {
+    out.set(p, off);
+    off += p.length;
+  }
+  return out;
+}
+
+function assertNonZero(bytes) {
+  let acc = 0;
+  for (const b of bytes) acc |= b;
+  if (acc === 0) throw new SealedNoteError('Invalid key agreement result (low-order point)');
+}
+
+export class SealedNoteError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'SealedNoteError';
+  }
+}
+
+function requireSubtle() {
+  if (!subtle) {
+    throw new SealedNoteError('Web Crypto is unavailable (a secure HTTPS context is required)');
+  }
+  return subtle;
+}
+
+function getSuite(id) {
+  if (!Object.prototype.hasOwnProperty.call(SUITES, id)) {
+    throw new SealedNoteError(`Unsupported suite: ${id}`);
+  }
+  return SUITES[id];
+}
+
+// ---------------------------------------------------------------------------------------------
+// Padding (ISO/IEC 7816-4: 0x80 then zeros, to a multiple of PAD_BUCKET)
+// ---------------------------------------------------------------------------------------------
+
+function pad(bytes) {
+  const total = Math.ceil((bytes.length + 1) / PAD_BUCKET) * PAD_BUCKET;
+  const out = new Uint8Array(total);
+  out.set(bytes);
+  out[bytes.length] = 0x80;
+  return out;
+}
+
+function unpad(bytes) {
+  let i = bytes.length - 1;
+  while (i >= 0 && bytes[i] === 0) i--;
+  if (i < 0 || bytes[i] !== 0x80) throw new SealedNoteError('Invalid padding');
+  return bytes.subarray(0, i);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Key schedule
+// ---------------------------------------------------------------------------------------------
+
+async function deriveAeadKey(sharedSecret, { suite, kid, recipientPublicKey, encapsulation }) {
+  const s = requireSubtle();
+  const label = enc.encode(LABEL);
+  const suiteBytes = enc.encode(suite);
+  const salt = new Uint8Array(
+    await s.digest(
+      'SHA-256',
+      concat(label, new Uint8Array([0]), suiteBytes, new Uint8Array([0]), recipientPublicKey, encapsulation),
+    ),
+  );
+  const info = concat(label, new Uint8Array([0]), suiteBytes, new Uint8Array([0]), enc.encode(kid));
+  const ikm = await s.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+  return s.deriveKey(
+    { name: 'HKDF', hash: 'SHA-256', salt, info },
+    ikm,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt'],
+  );
+}
+
+/** Canonical, order-fixed serialization of every header field. */
+function headerAad(h) {
+  return enc.encode(
+    JSON.stringify([h.v, h.suite, h.kid, h.enc, h.nonce, h.orderRef ?? null, h.createdAt]),
+  );
+}
+
+// ---------------------------------------------------------------------------------------------
+// Public key handling
+// ---------------------------------------------------------------------------------------------
+
+/**
+ * Validates a published key set and returns the strongest usable key.
+ * @param {{keys: Array<{kid: string, suite: string, publicKey: string}>}} keySet
+ * @param {string} [preferredSuite]
+ */
+export function selectRecipientKey(keySet, preferredSuite) {
+  if (!keySet || !Array.isArray(keySet.keys)) throw new SealedNoteError('Malformed key set');
+  const usable = [];
+  for (const k of keySet.keys) {
+    if (!k || typeof k.kid !== 'string' || !SUITES[k.suite] || typeof k.publicKey !== 'string') continue;
+    if (k.expires && Date.parse(k.expires) < Date.now()) continue;
+    let publicKey;
+    try {
+      publicKey = b64uDecode(k.publicKey);
+    } catch {
+      continue;
+    }
+    if (publicKey.length !== SUITES[k.suite].publicKeyLength) continue;
+    usable.push({ kid: k.kid, suite: k.suite, publicKey });
+  }
+  const order = preferredSuite
+    ? [preferredSuite, ...SUITE_PREFERENCE.filter((s) => s !== preferredSuite)]
+    : SUITE_PREFERENCE;
+  for (const suite of order) {
+    const hit = usable.find((k) => k.suite === suite);
+    if (hit) return hit;
+  }
+  throw new SealedNoteError('No usable delivery-notes public key was published');
+}
+
+/** Suites (strongest first) for which the key set has a valid, unexpired key. */
+export function availableSuites(keySet) {
+  return SUITE_PREFERENCE.filter((id) => {
+    try {
+      return selectRecipientKey(keySet, id).suite === id;
+    } catch {
+      return false;
+    }
+  });
+}
+
+/** Short SHA-256 fingerprint (hex, colon-grouped) for display / out-of-band verification. */
+export async function fingerprint(publicKey) {
+  const h = new Uint8Array(await requireSubtle().digest('SHA-256', publicKey));
+  return [...h.subarray(0, 16)]
+    .map((b) => b.toString(16).padStart(2, '0'))
+    .join('')
+    .match(/.{4}/g)
+    .join(':');
+}
+
+// ---------------------------------------------------------------------------------------------
+// Seal / open
+// ---------------------------------------------------------------------------------------------
+
+/**
+ * Encrypts a note to the recipient's public key.
+ * @param {string} note
+ * @param {{kid: string, suite: string, publicKey: Uint8Array}} recipient
+ * @param {{orderRef?: string}} [meta]
+ */
+export async function seal(note, recipient, meta = {}) {
+  const s = requireSubtle();
+  const suite = getSuite(recipient.suite);
+  if (recipient.publicKey.length !== suite.publicKeyLength) {
+    throw new SealedNoteError('Recipient public key has the wrong length');
+  }
+  const plaintext = enc.encode(String(note).normalize('NFC'));
+  if (plaintext.length === 0) throw new SealedNoteError('Note is empty');
+  if (plaintext.length > MAX_NOTE_BYTES) throw new SealedNoteError('Note is too long');
+
+  const { cipherText: encapsulation, sharedSecret } = suite.kem.encapsulate(recipient.publicKey);
+  try {
+    const key = await deriveAeadKey(sharedSecret, {
+      suite: recipient.suite,
+      kid: recipient.kid,
+      recipientPublicKey: recipient.publicKey,
+      encapsulation,
+    });
+    const nonce = crypto.getRandomValues(new Uint8Array(12));
+    const header = {
+      v: ENVELOPE_VERSION,
+      suite: recipient.suite,
+      kid: recipient.kid,
+      enc: b64uEncode(encapsulation),
+      nonce: b64uEncode(nonce),
+      orderRef: meta.orderRef ? String(meta.orderRef).slice(0, 64) : null,
+      createdAt: new Date().toISOString(),
+    };
+    const padded = pad(plaintext);
+    const ct = new Uint8Array(
+      await s.encrypt({ name: 'AES-GCM', iv: nonce, additionalData: headerAad(header), tagLength: 128 }, key, padded),
+    );
+    padded.fill(0);
+    plaintext.fill(0);
+    return { ...header, ct: b64uEncode(ct) };
+  } finally {
+    sharedSecret.fill(0);
+  }
+}
+
+/**
+ * Decrypts an envelope (shop-side).
+ * @param {object} envelope
+ * @param {(kid: string, suite: string) => {secretKey: Uint8Array, publicKey: Uint8Array}} lookupKey
+ */
+export async function open(envelope, lookupKey) {
+  const s = requireSubtle();
+  if (!envelope || envelope.v !== ENVELOPE_VERSION) throw new SealedNoteError('Unsupported envelope version');
+  const suite = getSuite(envelope.suite);
+  const encapsulation = b64uDecode(envelope.enc);
+  const nonce = b64uDecode(envelope.nonce);
+  const ct = b64uDecode(envelope.ct);
+  if (encapsulation.length !== suite.encLength) throw new SealedNoteError('Bad encapsulation length');
+  if (nonce.length !== 12) throw new SealedNoteError('Bad nonce length');
+
+  const keyPair = lookupKey(envelope.kid, envelope.suite);
+  if (!keyPair) throw new SealedNoteError(`Unknown key id: ${envelope.kid}`);
+  const sharedSecret = suite.kem.decapsulate(encapsulation, keyPair.secretKey);
+  try {
+    const key = await deriveAeadKey(sharedSecret, {
+      suite: envelope.suite,
+      kid: envelope.kid,
+      recipientPublicKey: keyPair.publicKey,
+      encapsulation,
+    });
+    let padded;
+    try {
+      padded = new Uint8Array(
+        await s.decrypt(
+          { name: 'AES-GCM', iv: nonce, additionalData: headerAad(envelope), tagLength: 128 },
+          key,
+          ct,
+        ),
+      );
+    } catch {
+      throw new SealedNoteError('Authentication failed: envelope was tampered with or the wrong key was used');
+    }
+    return dec.decode(unpad(padded));
+  } finally {
+    sharedSecret.fill(0);
+  }
+}
+
+/** Generates a recipient key pair for a suite (shop-side tooling). */
+export function generateKeyPair(suiteId) {
+  return getSuite(suiteId).kem.keygen();
+}
