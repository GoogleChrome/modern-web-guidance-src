new file mode 100644
index 0000000..d08dab1
--- /dev/null
+++ b/tests/sealed-notes.test.mjs
@@ -0,0 +1,95 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  SUITES,
+  SUITE_PREFERENCE,
+  PAD_BUCKET,
+  availableSuites,
+  b64uDecode,
+  b64uEncode,
+  generateKeyPair,
+  open,
+  seal,
+  selectRecipientKey,
+} from '../js/sealed-notes.js';
+
+function makeRecipient(suite) {
+  const kp = generateKeyPair(suite);
+  const kid = `test-${suite}`;
+  return {
+    recipient: { kid, suite, publicKey: kp.publicKey },
+    lookup: (k, s) => (k === kid && s === suite ? kp : undefined),
+  };
+}
+
+for (const suite of SUITE_PREFERENCE) {
+  test(`${suite}: round-trip with unicode`, async () => {
+    const { recipient, lookup } = makeRecipient(suite);
+    const note = 'Gate code 4821 — leave with concierge ☕ Ünïcödé';
+    const env = await seal(note, recipient, { orderRef: 'DG-1001' });
+    assert.equal(env.suite, suite);
+    assert.equal(b64uDecode(env.enc).length, SUITES[suite].encLength);
+    assert.equal(b64uDecode(env.ct).length % PAD_BUCKET, 16, 'padded to bucket + GCM tag');
+    assert.ok(!JSON.stringify(env).includes('4821'));
+    assert.equal(await open(env, lookup), note);
+  });
+
+  test(`${suite}: tampering any header or body field fails`, async () => {
+    const { recipient, lookup } = makeRecipient(suite);
+    const env = await seal('ring twice', recipient, { orderRef: 'DG-1' });
+    const flip = (s) => {
+      const b = b64uDecode(s);
+      b[b.length >> 1] ^= 1;
+      return b64uEncode(b);
+    };
+    for (const mutated of [
+      { ...env, ct: flip(env.ct) },
+      { ...env, enc: flip(env.enc) },
+      { ...env, nonce: flip(env.nonce) },
+      { ...env, orderRef: 'DG-2' },
+      { ...env, createdAt: new Date(0).toISOString() },
+    ]) {
+      await assert.rejects(open(mutated, lookup), /Authentication failed|Invalid key agreement/);
+    }
+  });
+
+  test(`${suite}: wrong recipient key fails`, async () => {
+    const a = makeRecipient(suite);
+    const b = generateKeyPair(suite);
+    const env = await seal('secret', a.recipient);
+    await assert.rejects(open(env, () => b), /Authentication failed|Invalid key agreement/);
+  });
+}
+
+test('each envelope uses a fresh encapsulation and nonce', async () => {
+  const { recipient } = makeRecipient('XWING-MLKEM768-X25519');
+  const [e1, e2] = await Promise.all([seal('same', recipient), seal('same', recipient)]);
+  assert.notEqual(e1.enc, e2.enc);
+  assert.notEqual(e1.ct, e2.ct);
+});
+
+test('suite downgrade via header rewrite is rejected', async () => {
+  const { recipient, lookup } = makeRecipient('XWING-MLKEM768-X25519');
+  const env = await seal('x', recipient);
+  await assert.rejects(open({ ...env, suite: 'MLKEM768' }, lookup));
+});
+
+test('key selection prefers hybrid and validates lengths', () => {
+  const keys = SUITE_PREFERENCE.map((suite) => ({
+    kid: suite,
+    suite,
+    publicKey: b64uEncode(generateKeyPair(suite).publicKey),
+  }));
+  assert.equal(selectRecipientKey({ keys }).suite, 'XWING-MLKEM768-X25519');
+  assert.equal(selectRecipientKey({ keys }, 'X25519').suite, 'X25519');
+  const broken = [{ ...keys[0], publicKey: b64uEncode(new Uint8Array(10)) }, keys[1]];
+  assert.equal(selectRecipientKey({ keys: broken }).suite, 'MLKEM768');
+  assert.deepEqual(availableSuites({ keys: broken }), ['MLKEM768']);
+  assert.throws(() => selectRecipientKey({ keys: [] }), /No usable/);
+});
+
+test('rejects empty and oversized notes', async () => {
+  const { recipient } = makeRecipient('X25519');
+  await assert.rejects(seal('', recipient), /empty/);
+  await assert.rejects(seal('x'.repeat(5000), recipient), /too long/);
+});
diff --git a/tools/delivery-keys.mjs b/tools/delivery-keys.mjs
new file mode 100644
index 0000000..2da1daa
--- /dev/null
+++ b/tools/delivery-keys.mjs
@@ -0,0 +1,104 @@
+#!/usr/bin/env node
+/**
+ * Shop-side tooling for encrypted delivery notes.
+ *
+ *   node tools/delivery-keys.mjs generate [--out-dir ~/.daily-grind/secrets]
+ *       Creates one key pair per suite. Public keys -> keys/delivery-notes.json (served to
+ *       browsers). Secret keys -> <out-dir>/delivery-notes.secret.json (mode 0600, outside the
+ *       web root; override with DG_SECRETS_DIR). Move it to a secrets manager / KMS and never deploy
+ *       it with the website. Refuses to overwrite existing secrets unless --force is given.
+ *
+ *   node tools/delivery-keys.mjs open <envelope.json | -> [--secrets <path>]
+ *       Decrypts an envelope (or a JSON array of envelopes) and prints the notes.
+ */
+import { readFile, writeFile, mkdir, chmod, access } from 'node:fs/promises';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { randomBytes } from 'node:crypto';
+import { homedir } from 'node:os';
+import {
+  SUITE_PREFERENCE,
+  b64uDecode,
+  b64uEncode,
+  fingerprint,
+  generateKeyPair,
+  open,
+} from '../js/sealed-notes.js';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+// Secrets live OUTSIDE the web root: `pnpm start` serves this whole directory statically.
+const DEFAULT_SECRET_DIR = process.env.DG_SECRETS_DIR || join(homedir(), '.daily-grind', 'secrets');
+const args = process.argv.slice(2);
+const flag = (name, def) => {
+  const i = args.indexOf(name);
+  return i >= 0 ? args[i + 1] : def;
+};
+
+async function generate() {
+  const outDir = resolve(flag('--out-dir', DEFAULT_SECRET_DIR));
+  const secretPath = join(outDir, 'delivery-notes.secret.json');
+  if (!args.includes('--force') && (await access(secretPath).then(() => true, () => false))) {
+    throw new Error(`${secretPath} already exists; back it up (old envelopes need it) and pass --force to rotate.`);
+  }
+  const created = new Date().toISOString();
+  const stamp = created.slice(0, 10).replace(/-/g, '');
+  const pub = { version: 1, keys: [] };
+  const sec = { version: 1, keys: [] };
+  for (const suite of SUITE_PREFERENCE) {
+    const { publicKey, secretKey } = generateKeyPair(suite);
+    const kid = `dg-${suite.toLowerCase()}-${stamp}-${randomBytes(3).toString('hex')}`;
+    pub.keys.push({ kid, suite, publicKey: b64uEncode(publicKey), created });
+    sec.keys.push({ kid, suite, publicKey: b64uEncode(publicKey), secretKey: b64uEncode(secretKey), created });
+    console.log(`${suite.padEnd(22)} ${kid}  fp ${await fingerprint(publicKey)}`);
+  }
+  await mkdir(join(root, 'keys'), { recursive: true });
+  await writeFile(join(root, 'keys', 'delivery-notes.json'), JSON.stringify(pub, null, 2) + '\n');
+  await mkdir(outDir, { recursive: true, mode: 0o700 });
+  await writeFile(secretPath, JSON.stringify(sec, null, 2) + '\n', { mode: 0o600 });
+  await chmod(secretPath, 0o600);
+  console.log(`\nPublic keys  -> keys/delivery-notes.json`);
+  console.log(`Secret keys  -> ${secretPath}  (keep offline; do NOT deploy)`);
+}
+
+async function openCmd() {
+  const src = args[1];
+  if (!src) throw new Error('usage: open <envelope.json | ->');
+  const secretPath = resolve(flag('--secrets', join(DEFAULT_SECRET_DIR, 'delivery-notes.secret.json')));
+  const secrets = JSON.parse(await readFile(secretPath, 'utf8'));
+  const raw = src === '-' ? await readStdin() : await readFile(src, 'utf8');
+  const parsed = JSON.parse(raw);
+  const envelopes = Array.isArray(parsed) ? parsed : [parsed];
+  const lookup = (kid, suite) => {
+    const k = secrets.keys.find((x) => x.kid === kid && x.suite === suite);
+    return k && { secretKey: b64uDecode(k.secretKey), publicKey: b64uDecode(k.publicKey) };
+  };
