@@ -0,0 +1,166 @@
+/**
+ * Homepage UI for encrypted delivery notes. The note is encrypted in the browser with
+ * js/sealed-notes.js; only the sealed envelope ever leaves the page.
+ */
+import {
+  MAX_NOTE_BYTES,
+  SUITES,
+  SealedNoteError,
+  availableSuites,
+  fingerprint,
+  seal,
+  selectRecipientKey,
+} from './sealed-notes.js';
+
+const KEYS_URL = '/keys/delivery-notes.json';
+const SUBMIT_URL = '/api/delivery-notes';
+const PENDING_KEY = 'dg.deliveryNotes.pending';
+
+const $ = (sel) => document.querySelector(sel);
+const form = $('#dn-form');
+const noteEl = $('#dn-note');
+const orderEl = $('#dn-order');
+const counterEl = $('#dn-counter');
+const statusEl = $('#dn-status');
+const keyInfoEl = $('#dn-keyinfo');
+const submitBtn = $('#dn-submit');
+const resultEl = $('#dn-result');
+const envelopeEl = $('#dn-envelope');
+const copyBtn = $('#dn-copy');
+const suiteInputs = [...document.querySelectorAll('input[name="dn-suite"]')];
+
+const utf8 = new TextEncoder();
+let keySet = null;
+
+function setStatus(msg, kind = 'info') {
+  statusEl.textContent = msg;
+  statusEl.dataset.kind = kind;
+}
+
+function selectedSuite() {
+  return suiteInputs.find((i) => i.checked)?.value;
+}
+
+function updateCounter() {
+  const n = utf8.encode(noteEl.value).length;
+  counterEl.textContent = `${n} / ${MAX_NOTE_BYTES} bytes`;
+  counterEl.dataset.over = String(n > MAX_NOTE_BYTES);
+  submitBtn.disabled = !keySet || n === 0 || n > MAX_NOTE_BYTES;
+}
+
+async function showKeyInfo() {
+  if (!keySet) return;
+  try {
+    const key = selectRecipientKey(keySet, selectedSuite());
+    keyInfoEl.textContent = `${SUITES[key.suite].title} · key ${key.kid} · fingerprint ${await fingerprint(key.publicKey)}`;
+  } catch (e) {
+    keyInfoEl.textContent = e.message;
+  }
+}
+
+async function loadKeys() {
+  if (!globalThis.isSecureContext || !crypto?.subtle) {
+    throw new SealedNoteError('Encryption needs a secure (HTTPS) connection. Notes are disabled.');
+  }
+  const res = await fetch(KEYS_URL, { cache: 'no-cache', credentials: 'same-origin' });
+  if (!res.ok) throw new SealedNoteError('Delivery-notes key is not published yet.');
+  const ks = await res.json();
+  const suites = availableSuites(ks);
+  if (!suites.length) throw new SealedNoteError('No valid delivery-notes key is published.');
+  for (const input of suiteInputs) {
+    const ok = suites.includes(input.value);
+    input.disabled = !ok;
+    input.closest('label').classList.toggle('unavailable', !ok);
+  }
+  if (!selectedSuite() || !suites.includes(selectedSuite())) {
+    suiteInputs.find((i) => i.value === suites[0]).checked = true;
+  }
+  keySet = ks;
+}
+
+function queueLocally(envelope) {
+  try {
+    const pending = JSON.parse(localStorage.getItem(PENDING_KEY) || '[]');
+    pending.push(envelope);
+    localStorage.setItem(PENDING_KEY, JSON.stringify(pending.slice(-10)));
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+async function submitEnvelope(envelope) {
+  try {
+    const res = await fetch(SUBMIT_URL, {
+      method: 'POST',
+      credentials: 'same-origin',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(envelope),
+    });
+    if (res.ok) return 'sent';
+  } catch {
+    /* network error — fall through */
+  }
+  return queueLocally(envelope) ? 'queued' : 'failed';
+}
+
+form.addEventListener('submit', async (ev) => {
+  ev.preventDefault();
+  if (!keySet) return;
+  submitBtn.disabled = true;
+  setStatus('Encrypting in your browser…');
+  try {
+    const recipient = selectRecipientKey(keySet, selectedSuite());
+    const envelope = await seal(noteEl.value, recipient, { orderRef: orderEl.value.trim() || undefined });
+    // Plaintext is no longer needed — clear it from the page.
+    noteEl.value = '';
+    updateCounter();
+
+    envelopeEl.textContent = JSON.stringify(envelope, null, 2);
+    resultEl.hidden = false;
+
+    const outcome = await submitEnvelope(envelope);
+    const label = SUITES[envelope.suite].title;
+    if (outcome === 'sent') {
+      setStatus(`Sealed with ${label} and sent. Only our delivery team can read it.`, 'ok');
+    } else if (outcome === 'queued') {
+      setStatus(`Sealed with ${label}. Saved (encrypted) on this device and will be attached to your next order.`, 'ok');
+    } else {
+      setStatus(`Sealed with ${label}, but it could not be sent or saved. Copy the envelope below and paste it into your order.`, 'warn');
+    }
+  } catch (e) {
+    setStatus(e instanceof SealedNoteError ? e.message : 'Encryption failed. Please try again.', 'error');
+    console.error(e);
+  } finally {
+    updateCounter();
+  }
+});
+
+copyBtn.addEventListener('click', async () => {
+  try {
+    await navigator.clipboard.writeText(envelopeEl.textContent);
+    copyBtn.textContent = 'Copied';
+    setTimeout(() => (copyBtn.textContent = 'Copy envelope'), 1500);
+  } catch {
+    setStatus('Copy failed — select the text manually.', 'warn');
+  }
+});
+
+noteEl.addEventListener('input', updateCounter);
+suiteInputs.forEach((i) => i.addEventListener('change', showKeyInfo));
+
+(async () => {
+  updateCounter();
+  try {
+    setStatus('Loading our delivery public key…');
+    await loadKeys();
+    await showKeyInfo();
+    setStatus('Ready. Your note is encrypted before it leaves this page.', 'ok');
+  } catch (e) {
+    form.classList.add('disabled');
+    setStatus(e instanceof SealedNoteError ? e.message : 'Encrypted notes are unavailable right now.', 'error');
+    console.error(e);
+  } finally {
+    updateCounter();
+  }
+})();
