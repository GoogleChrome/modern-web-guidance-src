+      position: relative;
+      text-align: center;
+      font-size: 0.95rem;
+    }
+
+    .promo-inner a {
+      color: inherit;
+      font-weight: bold;
+    }
+
+    .promo-inner form {
+      position: absolute;
+      inset-inline-end: 1rem;
+      inset-block-start: 50%;
+      translate: 0 -50%;
+    }
+
+    #alert-dismiss {
+      display: grid;
+      place-items: center;
+      inline-size: 2rem;
+      block-size: 2rem;
+      border: 0;
+      border-radius: 50%;
+      background: transparent;
+      color: inherit;
+      font-size: 1.4rem;
+      line-height: 1;
+      cursor: pointer;
+      transition: background 0.2s;
+    }
+
+    #alert-dismiss:hover {
+      background: rgba(0, 0, 0, 0.1);
+    }
+
+    #alert-dismiss:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    /* FAQ accordion: native <details>, animated via ::details-content */
+    .faq {
+      max-width: 800px;
+      margin: 60px auto 0;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    #faq-trigger {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding: 1.25rem 1.5rem;
+      font-size: 1.25rem;
+      font-weight: bold;
+      color: var(--primary);
+      cursor: pointer;
+      list-style: none;
+      border-radius: 8px;
+    }
+
+    #faq-trigger::-webkit-details-marker {
+      display: none;
+    }
+
+    #faq-trigger::after {
+      content: "";
+      inline-size: 0.6rem;
+      block-size: 0.6rem;
+      border-inline-end: 2px solid currentColor;
+      border-block-end: 2px solid currentColor;
+      rotate: 45deg;
+      transition: rotate 0.3s ease;
+    }
+
+    .faq[open] #faq-trigger::after {
+      rotate: -135deg;
+    }
+
+    #faq-trigger:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .faq::details-content {
+      block-size: 0;
+      overflow: hidden;
+      transition: block-size 0.4s ease, content-visibility 0.4s;
+      transition-behavior: allow-discrete;
+    }
+
+    .faq[open]::details-content {
+      block-size: auto;
+    }
+
+    #faq-content {
+      padding: 0 1.5rem 1.5rem;
+    }
