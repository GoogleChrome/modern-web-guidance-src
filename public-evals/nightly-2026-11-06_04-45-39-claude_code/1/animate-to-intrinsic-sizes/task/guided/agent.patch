+    /* Smooth size transitions to/from intrinsic keywords like `auto` */
+    :root {
+      interpolate-size: allow-keywords;
+    }
+
+    /* Promo alert: a non-modal <dialog open> stays in normal flow and can be
+       closed by a <form method="dialog"> button with zero JavaScript. */
+    #promo-alert {
+      position: static;
+      inline-size: auto;
+      max-inline-size: none;
+      margin: 0;
+      padding: 0;
+      border: 0;
