+// Seasonal Favorites card markup. These strings are treated as untrusted
+// (they may eventually come from a CMS or API) and are always sanitized
+// before insertion — see safe-html.js.
+export const seasonalCards = [
+  `<div class="card">
+     <img class="card-img" src="https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=600&q=80" alt="Latte with foam art" loading="lazy">
+     <h3>Maple Oat Latte</h3>
+     <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+     <a href="/menu/seasonal" class="btn">View Details</a>
+   </div>`,
+  `<div class="card">
+     <img class="card-img" src="https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=600&q=80" alt="Shot of dark espresso" loading="lazy">
+     <h3>Dark Roast Espresso</h3>
+     <p>Bold, smokey, and perfect for a morning boost.</p>
+     <a href="/menu/espresso" class="btn">View Details</a>
+   </div>`,
+  `<div class="card">
+     <img class="card-img" src="https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80" alt="Glass of iced cold brew" loading="lazy">
+     <h3>Cold Brew</h3>
