+    // Strict allowlist shared by the native Sanitizer and the DOMPurify fallback.
+    const ALLOWED_ELEMENTS = ['article', 'div', 'h3', 'p', 'a', 'img', 'strong', 'em', 'span'];
+    const ALLOWED_ATTRIBUTES = ['class', 'href', 'src', 'alt', 'width', 'height', 'loading'];
+
+    // Trusted Types tinyfill: older browsers still run the sanitizing policy, just without enforcement.
+    if (!('trustedTypes' in window)) {
+      window.trustedTypes = { createPolicy: (_name, rules) => rules };
+    }
