+  <script>
+    (function () {
+      // Progressive enhancement: without native <dialog> support the
+      // "View Details" links simply navigate to their menu pages.
+      if (typeof HTMLDialogElement !== 'function') return;
+
+      var HISTORY_KEY = 'dgDialog';
+      var openDialog = null;
+      var opener = null;
+      var pushedHistory = false;
+
+      function open(dialog, trigger) {
+        if (openDialog) return;
+        openDialog = dialog;
+        opener = trigger;
+        dialog.showModal(); // Native modal: focus trap, inert page, Escape to close.
+        document.body.classList.add('dialog-open');
+
+        // Add a history entry so the mobile back gesture / browser back button
+        // dismisses the dialog instead of leaving the page.
+        try {
+          var state = Object.assign({}, history.state);
+          state[HISTORY_KEY] = dialog.id;
+          history.pushState(state, '');
+          pushedHistory = true;
+        } catch (e) {
+          pushedHistory = false;
+        }
+      }
+
+      function onClose(event) {
+        var dialog = event.target;
+        if (dialog !== openDialog) return;
+        openDialog = null;
+        document.body.classList.remove('dialog-open');
+
+        // Closed via Escape, close button, or backdrop: remove our history entry.
+        if (pushedHistory) {
+          pushedHistory = false;
+          if (history.state && history.state[HISTORY_KEY] === dialog.id) {
+            history.back();
+          }
+        }
+
+        if (opener && document.contains(opener)) opener.focus();
+        opener = null;
+      }
+
+      // Back gesture / back button: close the open dialog.
+      window.addEventListener('popstate', function () {
+        if (!openDialog) return;
+        pushedHistory = false; // The entry is already gone.
+        openDialog.close();
+      });
+
+      document.querySelectorAll('[data-dialog]').forEach(function (trigger) {
+        var dialog = document.getElementById(trigger.getAttribute('data-dialog'));
+        if (!dialog) return;
+
+        // Present the trigger as a button now that it opens a dialog.
+        trigger.setAttribute('role', 'button');
+        trigger.addEventListener('keydown', function (e) {
+          if (e.key === ' ') { e.preventDefault(); trigger.click(); }
+        });
+
+        trigger.addEventListener('click', function (e) {
+          // Let modified clicks (new tab/window) follow the link normally.
+          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+          e.preventDefault();
+          open(dialog, trigger);
+        });
+      });
+
+      document.querySelectorAll('dialog.dialog').forEach(function (dialog) {
+        dialog.addEventListener('close', onClose);
+
+        dialog.querySelectorAll('[data-close]').forEach(function (btn) {
+          btn.addEventListener('click', function () { dialog.close(); });
+        });
+
+        // Click on the backdrop (outside the dialog box) closes it.
+        dialog.addEventListener('click', function (e) {
+          if (e.target !== dialog) return;
+          var r = dialog.getBoundingClientRect();
+          var inside = e.clientX >= r.left && e.clientX <= r.right &&
+                       e.clientY >= r.top && e.clientY <= r.bottom;
+          if (!inside) dialog.close();
+        });
+      });
+
+      // If the page was reloaded while a dialog's history entry was current,
+      // clear the stale marker so it isn't mistaken for an open dialog.
+      if (history.state && history.state[HISTORY_KEY]) {
+        var cleaned = Object.assign({}, history.state);
+        delete cleaned[HISTORY_KEY];
+        history.replaceState(cleaned, '');
+      }
+    })();
+  </script>
