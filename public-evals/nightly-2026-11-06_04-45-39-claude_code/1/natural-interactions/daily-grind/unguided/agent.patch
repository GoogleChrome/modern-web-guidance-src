+  <script>
+    (() => {
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      /* ---------- Carousel ---------- */
+      const track = document.getElementById('seasonal-track');
+      const cards = Array.from(track.querySelectorAll('.card'));
+      const navBtns = document.querySelectorAll('.carousel-btn');
+      const status = document.getElementById('carousel-status');
+
+      cards.forEach((card, i) => {
+        card.setAttribute('aria-roledescription', 'slide');
+        card.setAttribute('aria-label', `${i + 1} of ${cards.length}: ${card.dataset.name}`);
+      });
+
+      const step = () => {
+        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
+        return cards[0].getBoundingClientRect().width + gap;
+      };
+
+      const scrollByCards = (n) => {
+        track.scrollBy({ left: n * step(), behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+      };
+
+      let lastAnnounced = -1;
+      const updateControls = () => {
+        const max = track.scrollWidth - track.clientWidth - 2;
+        navBtns[0].setAttribute('aria-disabled', String(track.scrollLeft <= 2));
+        navBtns[1].setAttribute('aria-disabled', String(track.scrollLeft >= max));
+        const first = Math.round(track.scrollLeft / step());
+        const visible = Math.max(1, Math.floor((track.clientWidth + 2) / step()));
+        if (first !== lastAnnounced) {
+          lastAnnounced = first;
+          const last = Math.min(cards.length, first + visible);
+          status.textContent = `Showing drinks ${first + 1}${last > first + 1 ? `–${last}` : ''} of ${cards.length}`;
+        }
+      };
+
+      navBtns.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          if (btn.getAttribute('aria-disabled') === 'true') return;
+          scrollByCards(Number(btn.dataset.dir));
+        });
+      });
+
+      let scrollTimer;
+      track.addEventListener('scroll', () => {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(updateControls, 60);
+      }, { passive: true });
+      window.addEventListener('resize', updateControls);
+
+      // Keyboard: arrow keys move one card at a time, Home/End jump to ends.
+      track.addEventListener('keydown', (e) => {
+        if (e.target !== track) return; // let buttons inside cards behave normally
+        const keys = { ArrowRight: 1, ArrowLeft: -1 };
+        if (e.key in keys) {
+          e.preventDefault();
+          scrollByCards(keys[e.key]);
+        } else if (e.key === 'Home' || e.key === 'End') {
+          e.preventDefault();
+          track.scrollTo({
+            left: e.key === 'Home' ? 0 : track.scrollWidth,
+            behavior: reduceMotion.matches ? 'auto' : 'smooth'
+          });
+        }
+      });
+
+      // Keep a focused card fully in view when tabbing through card buttons.
+      track.addEventListener('focusin', (e) => {
+        const card = e.target.closest('.card');
+        if (card) card.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+      });
+
+      // Mouse drag-to-swipe (touch/pen already scroll natively).
+      let drag = null;
+      track.addEventListener('pointerdown', (e) => {
+        if (e.pointerType !== 'mouse' || e.button !== 0) return;
+        drag = { x: e.clientX, left: track.scrollLeft, moved: false, id: e.pointerId };
+      });
+      track.addEventListener('pointermove', (e) => {
+        if (!drag) return;
+        const dx = e.clientX - drag.x;
+        if (!drag.moved && Math.abs(dx) > 5) {
+          drag.moved = true;
+          track.classList.add('is-dragging');
+          track.setPointerCapture(drag.id);
+        }
+        if (drag.moved) track.scrollLeft = drag.left - dx;
+      });
+      const endDrag = () => {
+        if (!drag) return;
+        const wasMoved = drag.moved;
+        drag = null;
+        if (!wasMoved) return;
+        // Snap to nearest card after the drag finishes.
+        const target = Math.round(track.scrollLeft / step()) * step();
+        track.classList.remove('is-dragging');
+        track.scrollTo({ left: target, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+        // Swallow the click that follows a drag so buttons aren't triggered accidentally.
+        const swallow = (ev) => { ev.stopPropagation(); ev.preventDefault(); };
+        track.addEventListener('click', swallow, { capture: true, once: true });
+        setTimeout(() => track.removeEventListener('click', swallow, { capture: true }), 0);
+      };
+      track.addEventListener('pointerup', endDrag);
+      track.addEventListener('pointercancel', endDrag);
+      track.addEventListener('dragstart', (e) => e.preventDefault());
+
+      updateControls();
+
+      /* ---------- Detail view expanding from its trigger ---------- */
+      const dialog = document.getElementById('details-dialog');
+      const closeBtn = dialog.querySelector('.dialog-close');
+      const fields = {
+        img: document.getElementById('details-img'),
+        title: document.getElementById('details-title'),
+        desc: document.getElementById('details-desc'),
+        size: document.getElementById('details-size'),
+        calories: document.getElementById('details-calories'),
+        price: document.getElementById('details-price'),
+        link: document.getElementById('details-link'),
+        order: document.getElementById('details-order')
+      };
+      let trigger = null;
+      let animation = null;
+      const DURATION = 420;
+
+      // Transform that maps the dialog's box onto the trigger button's box.
+      const collapsedTransform = (btn) => {
+        const b = btn.getBoundingClientRect();
+        const d = dialog.getBoundingClientRect();
+        const sx = b.width / d.width;
+        const sy = b.height / d.height;
+        return `translate(${b.left - d.left}px, ${b.top - d.top}px) scale(${sx}, ${sy})`;
+      };
+
+      const animateDialog = (btn, opening) => {
+        if (animation) animation.cancel();
+        if (reduceMotion.matches || !dialog.animate || !btn.isConnected) return Promise.resolve();
+        const from = { transform: collapsedTransform(btn), borderRadius: '40px', opacity: 0.6 };
+        const to = { transform: 'none', borderRadius: '14px', opacity: 1 };
+        const contentFrom = { opacity: 0 };
+        const contentTo = { opacity: 1 };
+        const opts = { duration: DURATION, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)', fill: 'both' };
+        const frames = opening ? [from, to] : [to, from];
+        animation = dialog.animate(frames, opening ? opts : { ...opts, duration: DURATION * 0.75, easing: 'cubic-bezier(0.4, 0, 1, 1)' });
+        // Fade the inner content so it doesn't look stretched mid-expansion.
+        Array.from(dialog.children).forEach((child) => {
+          child.animate(opening ? [contentFrom, { opacity: 0, offset: 0.35 }, contentTo] : [contentTo, { opacity: 0, offset: 0.5 }, contentFrom],
+            { duration: opening ? DURATION : DURATION * 0.75, fill: opening ? 'none' : 'both' });
+        });
+        return animation.finished.catch(() => { });
+      };
+
+      const openDetails = (btn) => {
+        const card = btn.closest('.card');
+        const data = card.dataset;
+        trigger = btn;
+        fields.img.src = `${data.img}?auto=format&fit=crop&w=900&q=75`;
+        fields.title.textContent = data.name;
+        fields.desc.textContent = data.long;
+        fields.size.textContent = data.size;
+        fields.calories.textContent = data.calories;
+        fields.price.textContent = data.price;
+        fields.link.href = data.href;
+        fields.link.innerHTML = `Full Menu Page<span class="visually-hidden"> for ${data.name}</span>`;
+        fields.order.href = `/order-online?item=${encodeURIComponent(data.href.split('/').pop())}`;
+
+        btn.setAttribute('aria-expanded', 'true');
+        dialog.showModal();
+        dialog.scrollTop = 0;
+        Array.from(dialog.children).forEach((c) => c.getAnimations().forEach((a) => a.cancel()));
+        animateDialog(btn, true);
+        closeBtn.focus();
+      };
+
+      let closing = false;
+      const closeDetails = async () => {
+        if (!dialog.open || closing) return;
+        closing = true;
+        const btn = trigger;
+        if (btn) await animateDialog(btn, false);
+        dialog.close();
+        if (animation) { animation.cancel(); animation = null; }
+        Array.from(dialog.children).forEach((c) => c.getAnimations().forEach((a) => a.cancel()));
+        closing = false;
+      };
+
+      dialog.addEventListener('close', () => {
+        if (trigger) {
+          trigger.setAttribute('aria-expanded', 'false');
+          trigger.focus({ preventScroll: false });
+        }
+      });
+
+      // Escape: animate back into the button instead of closing instantly.
+      dialog.addEventListener('cancel', (e) => {
+        e.preventDefault();
+        closeDetails();
+      });
+
+      closeBtn.addEventListener('click', closeDetails);
+
+      // Clicking the backdrop (outside the dialog box) closes it.
+      dialog.addEventListener('click', (e) => {
+        if (e.target !== dialog) return;
+        const r = dialog.getBoundingClientRect();
+        const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
+        if (!inside) closeDetails();
+      });
+
+      track.querySelectorAll('[data-details]').forEach((btn) => {
+        btn.setAttribute('aria-expanded', 'false');
+        btn.setAttribute('aria-controls', 'details-dialog');
+        btn.addEventListener('click', () => openDetails(btn));
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
