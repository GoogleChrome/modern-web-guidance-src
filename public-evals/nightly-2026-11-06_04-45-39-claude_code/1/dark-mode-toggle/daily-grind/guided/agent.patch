+  <script>
+    (() => {
+      const KEY = "color-scheme";
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const systemDark = matchMedia("(prefers-color-scheme: dark)");
+
+      const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
+      const apply = (value) => { meta.content = value ?? "light dark"; };
+
+      document.getElementById("theme-toggle").addEventListener("click", () => {
+        const system = systemDark.matches ? "dark" : "light";
+        const rendered = meta.content === "light" || meta.content === "dark" ? meta.content : system;
+        const target = rendered === "dark" ? "light" : "dark";
+        // Matching the system preference means undoing the override: clear it rather than pinning it.
+        const stored = target === system ? null : target;
+        try {
+          stored ? localStorage.setItem(KEY, stored) : localStorage.removeItem(KEY);
+        } catch {}
+        apply(stored);
+      });
+
+      // Keep other open tabs in sync.
+      addEventListener("storage", (e) => { if (e.key === KEY || e.key === null) apply(read()); });
+    })();
+  </script>
+
