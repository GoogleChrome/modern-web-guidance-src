       margin: 2rem auto;
       text-align: center;
       color: #64748b;
     }
+    /* Cards below the initial fold: skip layout/paint until scrolled near. */
+    .off-screen-card {
+      content-visibility: auto;
+      /* ~370px estimated card height; `auto` remembers the real size once rendered */
+      contain-intrinsic-size: auto none auto 370px;
+    }
+
+    /* Debug panel: the outer wrapper carries no box styling so it collapses
+       to 0px while hidden; visuals live on .debug-panel-inner. */
+    .debug-panel {
+      max-width: 800px;
+      margin: 0 auto 2rem;
+      padding: 0 1rem;
+      box-sizing: border-box;
+      display: none;
+    }
+
+    .debug-panel.is-open {
+      display: block;
+    }
+
+    /* content-visibility: hidden keeps the panel's rendering state cached,
+       so toggling is instant instead of rebuilding layout like display: none. */
+    @supports (content-visibility: hidden) {
+      .debug-panel {
+        display: block;
+        content-visibility: hidden;
+      }
+
+      .debug-panel.is-open {
+        content-visibility: visible;
+      }
+    }
+
+    .debug-panel-inner {
+      background: #0f172a;
+      color: #e2e8f0;
+      border-radius: 1rem;
+      padding: 1.5rem;
