+  <script>
+    (() => {
+      const img = (id) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=400&q=70`;
+      const BEANS = [
+        { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', roast: 'Light', origin: 'Ethiopia', notes: 'Jasmine, bergamot and bright lemon.', img: img('1559056199-641a0ac8b55e') },
+        { id: 'colombia', name: 'Colombia Huila', roast: 'Medium', origin: 'Colombia', notes: 'Caramel sweetness with red apple.', img: img('1447933601403-0c6688de566e') },
+        { id: 'sumatra', name: 'Sumatra Mandheling', roast: 'Dark', origin: 'Indonesia', notes: 'Earthy, cedar, dark chocolate.', img: img('1511920170033-f8396924c348') },
+        { id: 'guatemala', name: 'Guatemala Antigua', roast: 'Medium', origin: 'Guatemala', notes: 'Cocoa, toffee and soft spice.', img: img('1514432324607-a09d9b4aefdd') },
+        { id: 'kenya', name: 'Kenya AA', roast: 'Light', origin: 'Kenya', notes: 'Blackcurrant, grapefruit, winey finish.', img: img('1509042239860-f550ce710b93') },
+        { id: 'brazil', name: 'Brazil Santos', roast: 'Medium-Dark', origin: 'Brazil', notes: 'Nutty, low acidity, milk chocolate.', img: img('1497935586351-b67a49e012bf') },
+        { id: 'costa-rica', name: 'Costa Rica Tarrazú', roast: 'Medium', origin: 'Costa Rica', notes: 'Honey, citrus and clean body.', img: img('1501339847302-ac426a4a7cbb') },
+        { id: 'house-espresso', name: 'House Espresso Blend', roast: 'Dark', origin: 'Blend', notes: 'Syrupy, smoky, bittersweet.', img: img('1442512595331-e89e73853f31') },
+      ];
+
+      const selectedList = document.getElementById('bean-selected');
+      const availableList = document.getElementById('bean-available');
+      const countEl = document.getElementById('bean-count');
+      const addAllBtn = document.getElementById('bean-add-all');
+      const clearBtn = document.getElementById('bean-clear');
+
+      const selected = new Set(['colombia', 'house-espresso']);
+      const cards = new Map();
+
+      function createCard(bean) {
+        const li = document.createElement('li');
+        li.className = 'bean-card';
+        li.dataset.id = bean.id;
+        // Unique name per card so it is tracked individually; the shared
+        // `view-transition-class: bean-card` (in CSS) gives all of them the same animation.
+        li.style.viewTransitionName = `bean-${bean.id}`;
+        li.innerHTML = `
+          <img src="${bean.img}" alt="${bean.name} coffee" loading="lazy" width="400" height="120">
+          <div class="bean-body">
+            <h4>${bean.name}</h4>
+            <span class="bean-meta">${bean.origin} · ${bean.roast} roast</span>
+            <p class="bean-notes">${bean.notes}</p>
+            <button type="button" class="bean-toggle"></button>
+          </div>`;
+        return li;
+      }
+
+      function render() {
+        // Reuse the same DOM nodes and move them between lists in catalog order.
+        for (const bean of BEANS) {
+          const card = cards.get(bean.id);
+          const isSelected = selected.has(bean.id);
+          const btn = card.querySelector('.bean-toggle');
+          btn.textContent = isSelected ? 'Remove' : 'Add to box';
+          btn.setAttribute('aria-label', `${isSelected ? 'Remove' : 'Add'} ${bean.name}`);
+          (isSelected ? selectedList : availableList).appendChild(card);
+        }
+        countEl.textContent = selected.size;
+        addAllBtn.disabled = selected.size === BEANS.length;
+        clearBtn.disabled = selected.size === 0;
+      }
+
+      // One shared entry point: every change runs inside a single view transition,
+      // so all affected cards animate to their new positions simultaneously.
+      function update(mutate) {
+        const apply = () => { mutate(); render(); };
+        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+        if (!document.startViewTransition || reduceMotion) {
+          apply();
+          return;
+        }
+        document.startViewTransition(apply);
+      }
+
+      for (const bean of BEANS) cards.set(bean.id, createCard(bean));
+
+      document.querySelector('.bean-selector').addEventListener('click', (e) => {
+        const toggle = e.target.closest('.bean-toggle');
+        if (toggle) {
+          const id = toggle.closest('.bean-card').dataset.id;
+          update(() => (selected.has(id) ? selected.delete(id) : selected.add(id)));
+          return;
+        }
+        if (e.target === addAllBtn) update(() => BEANS.forEach((b) => selected.add(b.id)));
+        if (e.target === clearBtn) update(() => selected.clear());
+      });
+
+      render();
+    })();
+  </script>
+
 </body>
 
