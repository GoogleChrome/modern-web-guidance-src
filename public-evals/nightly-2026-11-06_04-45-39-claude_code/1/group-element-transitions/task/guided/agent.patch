+
+  <script>
+    (() => {
+      const IMG = 'https://images.unsplash.com/';
+      const beans = [
+        { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', notes: 'Light roast · jasmine, lemon, bergamot', roast: '#a1887f', img: 'photo-1447933601403-0c6688de566e' },
+        { id: 'colombia', name: 'Colombia Huila', notes: 'Medium roast · caramel, red apple', roast: '#795548', img: 'photo-1559056199-641a0ac8b55e' },
+        { id: 'sumatra', name: 'Sumatra Mandheling', notes: 'Dark roast · cedar, cocoa, earthy', roast: '#3e2723', img: 'photo-1497935586351-b67a49e012bf' },
+        { id: 'guatemala', name: 'Guatemala Antigua', notes: 'Medium roast · milk chocolate, spice', roast: '#6d4c41', img: 'photo-1509042239860-f550ce710b93' },
+        { id: 'kenya', name: 'Kenya AA', notes: 'Light roast · blackcurrant, grapefruit', roast: '#8d6e63', img: 'photo-1514432324607-a09d9b4aefdd' },
+        { id: 'brazil', name: 'Brazil Cerrado', notes: 'Medium-dark · hazelnut, brown sugar', roast: '#5d4037', img: 'photo-1442512595331-e89e73853f31' },
+      ];
+
+      const lists = {
+        available: document.getElementById('bean-available'),
+        selected: document.getElementById('bean-selected'),
+      };
+      const counts = {
+        available: document.getElementById('bean-available-count'),
+        selected: document.getElementById('bean-selected-count'),
+      };
+      const status = document.getElementById('bean-status');
+      const selected = new Set(['colombia']);
+      const nodes = new Map();
+
+      function createBean(bean) {
+        const li = document.createElement('li');
+        li.className = 'bean';
+        li.dataset.id = bean.id;
+        // Unique name per card so each is tracked individually across lists.
+        li.style.viewTransitionName = `bean-${bean.id}`;
+        li.style.setProperty('--roast', bean.roast);
+        li.innerHTML = `
+          <img src="${IMG}${bean.img}?auto=format&fit=crop&w=160&h=160&q=70" alt="" width="56" height="56" loading="lazy">
+          <div><h4></h4><p></p></div>
+          <button type="button"></button>`;
+        li.querySelector('h4').textContent = bean.name;
+        li.querySelector('p').textContent = bean.notes;
+        return li;
+      }
+
+      function render() {
+        // Keep menu order in both lists; reuse existing nodes.
+        for (const bean of beans) {
+          const li = nodes.get(bean.id) ?? nodes.set(bean.id, createBean(bean)).get(bean.id);
+          const isSelected = selected.has(bean.id);
+          const btn = li.querySelector('button');
+          btn.textContent = isSelected ? 'Remove' : 'Add';
+          btn.setAttribute('aria-label', `${isSelected ? 'Remove' : 'Add'} ${bean.name}`);
+          const target = isSelected ? lists.selected : lists.available;
+          if (target.moveBefore && li.isConnected) target.moveBefore(li, null); // preserves focus
+          else target.append(li);
+        }
+        counts.available.textContent = `(${beans.length - selected.size})`;
+        counts.selected.textContent = `(${selected.size})`;
+      }
+
+      function toggle(id) {
+        const bean = beans.find((b) => b.id === id);
+        const adding = !selected.has(id);
+        const update = () => {
+          adding ? selected.add(id) : selected.delete(id);
+          render();
+          nodes.get(id).querySelector('button').focus({ preventScroll: true });
+        };
+        if (document.startViewTransition) document.startViewTransition(update);
+        else update();
+        status.textContent = `${bean.name} ${adding ? 'added to' : 'removed from'} your selection.`;
+      }
+
+      document.querySelector('.bean-picker').addEventListener('click', (e) => {
+        const btn = e.target.closest('.bean button');
+        if (btn) toggle(btn.closest('.bean').dataset.id);
+      });
+
+      render();
+    })();
+  </script>
 </body>
 
