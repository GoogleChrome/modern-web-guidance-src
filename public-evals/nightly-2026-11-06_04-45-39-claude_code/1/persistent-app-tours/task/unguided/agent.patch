+  <script>
+    (function () {
+      var link = document.getElementById('feature');
+      var tip = document.getElementById('tour-step');
+      var closeBtn = tip.querySelector('.tour-close');
+      var supportsPopover = typeof tip.showPopover === 'function';
+      var supportsAnchor = window.CSS && CSS.supports('anchor-name: --a') && CSS.supports('top: anchor(bottom)');
+      var tourOpen = false;
+      var rafId = null;
+
+      // JS fallback positioning for browsers without CSS anchor positioning.
+      function position() {
+        var r = link.getBoundingClientRect();
+        var w = tip.offsetWidth;
+        var left = r.left + r.width / 2 - w / 2;
+        left = Math.max(8, Math.min(left, window.innerWidth - w - 8));
+        tip.style.top = (r.bottom + 12) + 'px';
+        tip.style.left = left + 'px';
+        tip.style.translate = 'none';
+      }
+
+      function track() {
+        position();
+        rafId = requestAnimationFrame(track);
+      }
+
+      function onOpened() {
+        tourOpen = true;
+        link.classList.add('tour-active');
+        if (!supportsAnchor) track();
+      }
+
+      function onClosed() {
+        tourOpen = false;
+        link.classList.remove('tour-active');
+        link.removeAttribute('aria-describedby');
+        if (rafId) cancelAnimationFrame(rafId);
+        rafId = null;
+      }
+
+      function open() {
+        if (supportsPopover) {
+          tip.showPopover();
+        } else {
+          // No Popover API: emulate a fixed, top-most element.
+          tip.style.display = 'block';
+          tip.style.position = 'fixed';
+        }
+        onOpened();
+      }
+
+      function close() {
+        if (supportsPopover) {
+          if (tip.matches(':popover-open')) tip.hidePopover();
+        } else {
+          tip.style.display = 'none';
+        }
+        onClosed();
+      }
+
+      if (supportsPopover) {
+        tip.addEventListener('toggle', function (e) {
+          if (e.newState === 'closed') onClosed();
+        });
+      }
+
+      closeBtn.addEventListener('click', function (e) {
+        if (!supportsPopover) {
+          e.preventDefault();
+          close();
+        }
+        // With Popover API, popovertargetaction="hide" closes it; toggle handles cleanup.
+      });
+
+      // Keep the user on the page while the tour is active.
+      link.addEventListener('click', function (e) {
+        if (tourOpen) {
+          e.preventDefault();
+          if (supportsPopover && !tip.matches(':popover-open')) open();
+        }
+      });
+
+      open();
+    })();
+  </script>
+
