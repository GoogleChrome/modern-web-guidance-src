+  <script type="module">
+    // Load polyfills only when native support is missing
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+    if (!CSS.supports("anchor-name: --a")) {
+      await import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+
+    const tourStep = document.getElementById("tour-step");
+    const rewardsLink = document.getElementById("feature");
+    const isOpen = () => tourStep.matches(":is(:popover-open, .\\:popover-open)");
+
+    // Keep the user on the page while the tour is active
+    rewardsLink.addEventListener("click", (event) => {
+      if (isOpen()) event.preventDefault();
+    });
+
+    tourStep.showPopover();
+    tourStep.querySelector("button").focus();
