+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const input = document.getElementById('newsletter-email');
+      const message = document.getElementById('newsletter-message');
+
+      function getError() {
+        const value = input.value.trim();
+        if (!value) return 'Please enter your email address.';
+        if (input.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+          return 'Please enter a valid email address.';
+        }
+        return '';
+      }
+
+      function setMessage(text, type) {
+        message.textContent = text;
+        message.className = 'newsletter-message' + (type ? ' ' + type : '');
+      }
+
+      function showError(text) {
+        input.setAttribute('aria-invalid', 'true');
+        setMessage(text, 'error');
+      }
+
+      function clearError() {
+        input.removeAttribute('aria-invalid');
+        setMessage('');
+      }
+
+      // Validate only once the user leaves the field (skip if they never typed anything).
+      input.addEventListener('blur', function () {
+        if (!input.value.trim()) {
+          clearError();
+          return;
+        }
+        const error = getError();
+        error ? showError(error) : clearError();
+      });
+
+      // While typing, never add an error — only clear an existing one once the value is fixed.
+      input.addEventListener('input', function () {
+        if (message.classList.contains('success')) setMessage('');
+        if (input.getAttribute('aria-invalid') === 'true' && !getError()) clearError();
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        const error = getError();
+        if (error) {
+          showError(error);
+          input.focus();
+          return;
+        }
+        // TODO: send to the newsletter provider/backend endpoint.
+        form.reset();
+        clearError();
+        setMessage("Thanks for subscribing! Check your inbox for a welcome brew.", 'success');
+      });
+    })();
+  </script>
+
 </body>
 
