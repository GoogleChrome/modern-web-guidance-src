+  <script>
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const email = document.getElementById('newsletter-email');
+
+      // Keep aria-invalid in sync with the visual :user-invalid state
+      const syncAria = () => {
+        if (email.matches(':user-invalid')) {
+          email.setAttribute('aria-invalid', 'true');
+        } else {
+          email.removeAttribute('aria-invalid');
+        }
+      };
+      email.addEventListener('blur', syncAria);
+      email.addEventListener('invalid', syncAria);
+      email.addEventListener('input', () => {
+        // Only clear an existing error while typing; never add one mid-typing
+        if (email.hasAttribute('aria-invalid')) syncAria();
+      });
+
+      form.addEventListener('submit', (event) => {
+        // Only fires when the email is valid; the browser blocks invalid submits
+        event.preventDefault();
+        // TODO: send to the newsletter provider/endpoint
+        const msg = document.createElement('p');
+        msg.className = 'newsletter-success';
+        msg.setAttribute('role', 'status');
+        msg.textContent = `Thanks! We'll send the good stuff to ${email.value}.`;
+        form.replaceChildren(msg);
+      });
+    })();
+  </script>
+
 </body>
 
