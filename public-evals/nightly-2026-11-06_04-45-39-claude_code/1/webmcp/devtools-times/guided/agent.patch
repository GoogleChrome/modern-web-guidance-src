diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..2187847
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,95 @@
+/**
+ * Shared client-side helpers for exposing The DevTools Times to in-browser AI
+ * agents through WebMCP (https://webmachinelearning.github.io/webmcp/).
+ *
+ * Declarative tools (annotated <form>s) live in the React flyouts; imperative
+ * tools are registered from `src/scripts/webmcp-tools.ts`.
+ */
+
+const BASE_URL = import.meta.env.BASE_URL;
+
+/** Names of the declarative (form-based) tools, shared by forms and listeners. */
+export const FORM_TOOL_NAMES = {
+  searchArticles: 'search-articles',
+  updateReadingList: 'update-reading-list',
+} as const;
+
+/** Fired on `window` whenever the reading list changes, with the new list as `detail`. */
+export const READING_LIST_CHANGE_EVENT = 'readinglist:change';
+
+export interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+/**
+ * SubmitEvent fields WebMCP adds when an agent submits a declarative tool form.
+ * `webmcp-types` does not cover the declarative API yet.
+ */
+export type AgentSubmitEvent = SubmitEvent & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<unknown>) => void;
+};
+
+export function articleUrl(slug: string): string {
+  return new URL(`${BASE_URL}articles/${slug}`, window.location.origin).href;
+}
+
+export async function fetchArticles(signal?: AbortSignal): Promise<ArticleSummary[]> {
+  const response = await fetch(`${BASE_URL}api/articles.json`, { signal });
+  if (!response.ok) throw new Error(`Loading articles failed with status ${response.status}`);
+  return response.json();
+}
+
+export async function fetchReadingList(signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(`${BASE_URL}api/reading-list.json`, { signal });
+  if (!response.ok) throw new Error(`Loading the reading list failed with status ${response.status}`);
+  const data = await response.json();
+  return data.readingList ?? [];
+}
+
+/** The reading-list endpoint toggles, so this posts only when the state must change. */
+export async function setArticleSaved(
+  slug: string,
+  saved: boolean,
+  signal?: AbortSignal,
+): Promise<string[]> {
+  const current = await fetchReadingList(signal);
+  if (current.includes(slug) === saved) return current;
+  return toggleReadingList(slug, signal);
+}
+
+export async function toggleReadingList(slug: string, signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(`${BASE_URL}api/reading-list.json`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+    signal,
+  });
+  if (!response.ok) throw new Error(`Updating the reading list failed with status ${response.status}`);
+  const data = await response.json();
+  const readingList: string[] = data.readingList ?? [];
+  notifyReadingListChanged(readingList);
+  return readingList;
+}
+
+export function notifyReadingListChanged(readingList: string[]) {
+  window.dispatchEvent(new CustomEvent(READING_LIST_CHANGE_EVENT, { detail: readingList }));
+}
+
+/**
+ * Listen for WebMCP tool lifecycle events. Chrome 156+ dispatches them on
+ * `document.modelContext`; older builds dispatch them on `window`.
+ */
+export function onToolLifecycle(
+  type: 'toolactivated' | 'toolcancel',
+  listener: (event: Event & { toolName?: string }) => void,
+  signal: AbortSignal,
+) {
+  const modelContext = document.modelContext;
+  const target: EventTarget =
+    modelContext && `on${type}` in modelContext ? modelContext : window;
+  target.addEventListener(type, listener as EventListener, { signal });
+}
