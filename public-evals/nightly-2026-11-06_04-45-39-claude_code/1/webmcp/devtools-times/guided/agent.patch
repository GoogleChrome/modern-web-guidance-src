index 0000000..9c4294d
--- /dev/null
+++ b/src/scripts/webmcp-tools.ts
@@ -0,0 +1,277 @@
+/**
+ * Imperative WebMCP tools for The DevTools Times.
+ *
+ * Site-wide tools are registered on every page; article utilities are only
+ * registered while an article is on screen. Every registration is tied to an
+ * AbortSignal that is aborted before Astro's client router swaps the page, so
+ * tools never outlive the content they act on.
+ *
+ * The search and reading-list *forms* are exposed declaratively (see
+ * SearchFlyout.tsx and ReadingListFlyout.tsx); these tools complement them.
+ */
+import { navigate } from 'astro:transitions/client';
+import { articleUrl, fetchArticles, fetchReadingList } from '../utils/webmcp';
+
+const FIND_HIGHLIGHT = 'article-find';
+const MAX_FIND_RESULTS = 20;
+const WORDS_PER_MINUTE = 230;
+
+type ToolResult = Record<string, unknown>;
+
+/** Registers a tool for the lifetime of the current page. */
+type RegisterTool = <const TInputSchema extends object>(
+  tool: WebMCP.ModelContextToolFromSchema<TInputSchema>,
+) => void;
+
+const errorMessage = (error: unknown) => (error instanceof Error ? error.message : String(error));
+
+/** Re-throw cancellations; turn every other failure into a message the agent can read. */
+function toToolError(error: unknown, signal: AbortSignal): ToolResult {
+  if (signal.aborted) throw error;
+  return { error: errorMessage(error) };
+}
+
+function registerSiteTools(register: RegisterTool) {
+  register({
+    name: 'get_reading_list',
+    description: "Lists the articles the reader has saved to their reading list on The DevTools Times.",
+    inputSchema: { type: 'object', properties: {} },
+    async execute(_input, { signal: executionSignal }) {
+      try {
+        const [articles, readingList] = await Promise.all([
+          fetchArticles(executionSignal),
+          fetchReadingList(executionSignal),
+        ]);
+        const saved = articles.filter((article) => readingList.includes(article.slug));
+        return {
+          count: saved.length,
+          articles: saved.map((article) => ({
+            slug: article.slug,
+            title: article.title,
+            summary: article.summary,
+            url: articleUrl(article.slug),
+          })),
+        };
+      } catch (error) {
+        return toToolError(error, executionSignal);
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  register({
+    name: 'open_article',
+    description: 'Opens an article from The DevTools Times in the current tab so the reader can read it.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'Slug of the article, as returned by the search or reading-list tools (e.g. "urban-cycling").',
+        },
+      },
+      required: ['slug'],
+    },
+    async execute({ slug }, { signal: executionSignal }) {
+      if (typeof slug !== 'string' || !slug.trim()) {
+        return { error: 'Pass the slug of the article to open.' };
+      }
+      try {
+        const articles = await fetchArticles(executionSignal);
+        const article = articles.find((item) => item.slug === slug.trim());
+        if (!article) {
+          return {
+            error: `No article with the slug "${slug}" exists.`,
+            availableArticles: articles.map((item) => ({ slug: item.slug, title: item.title })),
+          };
+        }
+        executionSignal.throwIfAborted();
+        await navigate(articleUrl(article.slug));
+        return { opened: { slug: article.slug, title: article.title, url: articleUrl(article.slug) } };
+      } catch (error) {
+        return toToolError(error, executionSignal);
+      }
+    },
+  });
+}
+
+interface ArticleContext {
+  root: HTMLElement;
+  body: HTMLElement;
+  slug: string;
+}
+
+function getArticleContext(): ArticleContext | null {
+  const root = document.querySelector<HTMLElement>('article[data-article-slug]');
+  const body = root?.querySelector<HTMLElement>('[data-article-body]');
+  if (!root || !body || !root.dataset.articleSlug) return null;
+  return { root, body, slug: root.dataset.articleSlug };
+}
+
+function articleParagraphs(body: HTMLElement): string[] {
+  return Array.from(body.querySelectorAll('p, h2, h3, h4, li, blockquote'))
+    .map((element) => element.textContent?.replace(/\s+/g, ' ').trim() ?? '')
+    .filter(Boolean);
+}
+
+function clearFindHighlight() {
+  if ('highlights' in CSS) CSS.highlights.delete(FIND_HIGHLIGHT);
+}
+
+function registerArticleTools(register: RegisterTool, { root, body, slug }: ArticleContext) {
+  const title = () => root.querySelector('h1')?.textContent?.trim() ?? document.title;
+  const url = articleUrl(slug);
+
+  register({
+    name: 'get_current_article',
+    description: 'Returns the article the reader is currently viewing: its metadata, full text and whether it is on their reading list. Use it to summarize, quote or answer questions about the article.',
+    inputSchema: { type: 'object', properties: {} },
+    async execute(_input, { signal: executionSignal }) {
+      const paragraphs = articleParagraphs(body);
+      const wordCount = paragraphs.join(' ').split(/\s+/).filter(Boolean).length;
+      const statedReadingTime = Number(root.dataset.articleReadingTime);
+      let savedToReadingList: boolean | null = null;
+      try {
+        savedToReadingList = (await fetchReadingList(executionSignal)).includes(slug);
+      } catch (error) {
+        if (executionSignal.aborted) throw error;
+      }
+      return {
+        slug,
+        url,
+        title: title(),
+        summary: root.querySelector('h1 + p')?.textContent?.trim() ?? '',
+        author: root.dataset.articleAuthor ?? '',
+        publishedOn: root.dataset.articleDate ?? '',
+        category: root.dataset.articleCategory ?? '',
+        tags: root.dataset.articleTags ? root.dataset.articleTags.split(',') : [],
+        wordCount,
+        readingTimeMinutes:
+          statedReadingTime > 0 ? statedReadingTime : Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE)),
+        savedToReadingList,
+        text: paragraphs.join('\n\n'),
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  register({
+    name: 'find_in_article',
+    description: 'Finds a word or phrase in the article the reader is viewing, highlights every occurrence on the page and scrolls to the first one. Returns the surrounding passages.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        query: { type: 'string', description: 'Word or phrase to look for; matching ignores letter case.' },
+      },
+      required: ['query'],
+    },
+    execute({ query }) {
+      clearFindHighlight();
+      const term = typeof query === 'string' ? query.trim().toLowerCase() : '';
+      if (!term) return { error: 'Pass a word or phrase to find.' };
+
+      const ranges: Range[] = [];
+      const walker = document.createTreeWalker(body, NodeFilter.SHOW_TEXT);
+      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+        const text = node.textContent?.toLowerCase() ?? '';
+        for (let index = text.indexOf(term); index !== -1; index = text.indexOf(term, index + term.length)) {
+          const range = new Range();
+          range.setStart(node, index);
+          range.setEnd(node, index + term.length);
+          ranges.push(range);
+        }
+      }
+
+      if (ranges.length === 0) {
+        return { query, matchCount: 0, passages: [] };
+      }
+
+      if ('highlights' in CSS) {
+        CSS.highlights.set(FIND_HIGHLIGHT, new Highlight(...ranges));
+      }
+      ranges[0].startContainer.parentElement?.scrollIntoView({ behavior: 'smooth', block: 'center' });
+
+      const passages = articleParagraphs(body).filter((paragraph) => paragraph.toLowerCase().includes(term));
+      return {
+        query,
+        matchCount: ranges.length,
+        passages: passages.slice(0, MAX_FIND_RESULTS),
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  register({
+    name: 'get_related_articles',
+    description: 'Lists the related stories recommended below the article the reader is viewing.',
+    inputSchema: { type: 'object', properties: {} },
+    execute() {
+      const section = document.querySelector('[data-related-articles]');
+      const related = Array.from(section?.querySelectorAll('article') ?? []).flatMap((teaser) => {
+        const link = teaser.querySelector<HTMLAnchorElement>('a[href*="/articles/"]');
+        const relatedSlug = link ? new URL(link.href).pathname.split('/').filter(Boolean).pop() : undefined;
+        if (!link || !relatedSlug) return [];
+        return [{
+          slug: relatedSlug,
+          title: teaser.querySelector('h3')?.textContent?.trim() ?? '',
+          summary: teaser.querySelector('p')?.textContent?.trim() ?? '',
+          url: link.href,
+        }];
+      });
+      return { count: related.length, articles: related };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  register({
+    name: 'get_article_share_links',
+    description: 'Returns ready-made links for sharing the article the reader is viewing on social networks or by email.',
+    inputSchema: { type: 'object', properties: {} },
+    execute() {
+      const encodedUrl = encodeURIComponent(url);
+      const encodedTitle = encodeURIComponent(title());
+      return {
+        url,
+        facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
+        x: `https://x.com/intent/post?url=${encodedUrl}&text=${encodedTitle}`,
+        whatsapp: `https://wa.me/?text=${encodeURIComponent(`${title()} ${url}`)}`,
+        email: `mailto:?subject=${encodedTitle}&body=${encodedUrl}`,
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+}
+
+let pageController: AbortController | null = null;
+
+function registerPageTools() {
+  pageController?.abort();
+  const modelContext = document.modelContext;
+  if (!modelContext) return;
+
+  pageController = new AbortController();
+  const { signal } = pageController;
+  const report = (error: unknown) => {
+    if (!signal.aborted) console.warn('[WebMCP] Tool registration failed:', error);
+  };
+
+  const register: RegisterTool = (tool) => {
+    modelContext.registerTool(tool, { signal }).catch(report);
+  };
+
+  registerSiteTools(register);
+  const article = getArticleContext();
+  if (article) registerArticleTools(register, article);
+}
+
+function unregisterPageTools() {
+  pageController?.abort();
+  pageController = null;
+  clearFindHighlight();
+}
+
+if ('modelContext' in document) {
+  // `astro:page-load` fires on the first load and after every client-side navigation.
+  document.addEventListener('astro:page-load', registerPageTools);
+  document.addEventListener('astro:before-swap', unregisterPageTools);
+}
