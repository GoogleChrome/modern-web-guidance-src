new file mode 100644
index 0000000..f65ddd9
--- /dev/null
+++ b/src/lib/webmcp.ts
@@ -0,0 +1,176 @@
+/**
+ * Thin, defensive wrapper around the WebMCP `navigator.modelContext` API.
+ *
+ * WebMCP lets in-browser AI agents discover and call tools that a page
+ * exposes, either declaratively (annotated <form> elements) or imperatively
+ * (`navigator.modelContext.registerTool`). The API is still evolving, so this
+ * module feature-detects everything and quietly does nothing in browsers that
+ * don't support it.
+ */
+
+export type JSONSchema = {
+  type: string;
+  description?: string;
+  properties?: Record<string, JSONSchema>;
+  required?: string[];
+  items?: JSONSchema;
+  enum?: readonly (string | number)[];
+  minimum?: number;
+  maximum?: number;
+  default?: unknown;
+  additionalProperties?: boolean;
+};
+
+export type ToolResult = {
+  content: { type: 'text'; text: string }[];
+  isError?: boolean;
+};
+
+export interface ToolDefinition<I = any> {
+  name: string;
+  description: string;
+  inputSchema: JSONSchema;
+  annotations?: { readOnlyHint?: boolean };
+  execute: (input: I, client?: unknown) => Promise<ToolResult> | ToolResult;
+}
+
+interface ModelContext {
+  registerTool: (tool: ToolDefinition, options?: { signal?: AbortSignal }) => unknown;
+  unregisterTool?: (name: string) => void;
+}
+
+/** Submit events fired by agent-invoked declarative (form) tools. */
+export type AgentSubmitEvent = SubmitEvent & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<unknown> | unknown) => void;
+};
+
+export const getModelContext = (): ModelContext | undefined => {
+  if (typeof navigator === 'undefined') return undefined;
+  const mc = (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+  return mc && typeof mc.registerTool === 'function' ? mc : undefined;
+};
+
+export const isWebMCPSupported = () => getModelContext() !== undefined;
+
+/**
+ * Registers a set of tools and returns a function that unregisters them all.
+ * Supports the AbortSignal-based, the handle-based and the
+ * `unregisterTool(name)`-based flavours of the API.
+ */
+export function registerTools(tools: ToolDefinition[]): () => void {
+  const mc = getModelContext();
+  if (!mc) return () => {};
+
+  const controller = new AbortController();
+  const cleanups: (() => void)[] = [];
+
+  for (const tool of tools) {
+    try {
+      const handle = mc.registerTool(tool, { signal: controller.signal }) as
+        | { unregister?: () => void }
+        | undefined;
+      cleanups.push(() => {
+        if (handle && typeof handle.unregister === 'function') {
+          handle.unregister();
+        } else if (typeof mc.unregisterTool === 'function') {
+          mc.unregisterTool(tool.name);
+        }
+      });
+    } catch (error) {
+      console.warn(`[WebMCP] Failed to register tool "${tool.name}":`, error);
+    }
+  }
+
+  return () => {
+    controller.abort();
+    for (const cleanup of cleanups) {
+      try {
+        cleanup();
+      } catch {
+        // Already unregistered (e.g. via the abort signal).
+      }
+    }
+  };
+}
+
+export const textResult = (value: unknown): ToolResult => ({
+  content: [{ type: 'text', text: typeof value === 'string' ? value : JSON.stringify(value, null, 2) }],
+});
+
+export const errorResult = (message: string): ToolResult => ({
+  content: [{ type: 'text', text: message }],
+  isError: true,
+});
+
+/* -------------------------------------------------------------------------- */
+/* Shared client-side data helpers                                            */
+/* -------------------------------------------------------------------------- */
+
+const BASE_URL = import.meta.env.BASE_URL;
+
+export interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+let articlesPromise: Promise<ArticleSummary[]> | undefined;
+
+export function fetchArticles(): Promise<ArticleSummary[]> {
+  articlesPromise ??= fetch(`${BASE_URL}api/articles.json`)
+    .then((res) => {
+      if (!res.ok) throw new Error(`Failed to load articles (${res.status})`);
+      return res.json() as Promise<ArticleSummary[]>;
+    })
+    .catch((error) => {
+      articlesPromise = undefined;
+      throw error;
+    });
+  return articlesPromise;
+}
+
+export function filterArticles<T extends { title: string; summary: string }>(articles: T[], query: string): T[] {
+  const q = query.trim().toLowerCase();
+  if (!q) return [];
+  return articles.filter(
+    (article) => article.title.toLowerCase().includes(q) || article.summary.toLowerCase().includes(q),
+  );
+}
+
+export const articleUrl = (slug: string) => `${BASE_URL}articles/${slug}`;
+
+export async function getReadingList(): Promise<string[]> {
+  const res = await fetch(`${BASE_URL}api/reading-list.json`);
+  if (!res.ok) throw new Error(`Failed to load reading list (${res.status})`);
+  const data = await res.json();
+  return data.readingList ?? [];
+}
+
+/**
+ * Ensures an article is (or isn't) on the reading list. The API endpoint only
+ * toggles, so we check the current state first to make this idempotent.
+ */
+export async function setReadingListMembership(slug: string, shouldBeSaved: boolean): Promise<string[]> {
+  const current = await getReadingList();
+  if (current.includes(slug) === shouldBeSaved) return current;
+  const res = await fetch(`${BASE_URL}api/reading-list.json`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+  });
+  if (!res.ok) throw new Error(`Failed to update reading list (${res.status})`);
+  const data = await res.json();
+  const readingList: string[] = data.readingList ?? [];
+  window.dispatchEvent(new CustomEvent(READING_LIST_CHANGED_EVENT, { detail: { readingList } }));
+  return readingList;
+}
+
+/* -------------------------------------------------------------------------- */
+/* UI events (let tools drive React islands)                                  */
+/* -------------------------------------------------------------------------- */
+
+export const OPEN_SEARCH_EVENT = 'devtools-times:open-search';
+export const OPEN_READING_LIST_EVENT = 'devtools-times:open-reading-list';
+export const READING_LIST_CHANGED_EVENT = 'devtools-times:reading-list-changed';
