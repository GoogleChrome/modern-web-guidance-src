diff --git a/src/scripts/webmcp-tools.ts b/src/scripts/webmcp-tools.ts
new file mode 100644
index 0000000..8ebe021
--- /dev/null
+++ b/src/scripts/webmcp-tools.ts
@@ -0,0 +1,349 @@
+/**
+ * Imperative WebMCP tools for The DevTools Times.
+ *
+ * - Site-wide tools are registered once and stay available on every page.
+ * - Article tools are registered only while an article page is shown and are
+ *   re-registered on every Astro client-side navigation.
+ *
+ * The search and reading-list *forms* are exposed declaratively (see
+ * SearchFlyout.tsx / ReadingListFlyout.tsx); the `open_*` tools below let an
+ * agent reveal them.
+ */
+import {
+  type ToolDefinition,
+  OPEN_READING_LIST_EVENT,
+  OPEN_SEARCH_EVENT,
+  articleUrl,
+  errorResult,
+  fetchArticles,
+  getReadingList,
+  isWebMCPSupported,
+  registerTools,
+  textResult,
+} from '../lib/webmcp';
+
+const DEFAULT_WPM = 230;
+
+const nextFrame = () => new Promise<void>((resolve) => requestAnimationFrame(() => setTimeout(resolve, 0)));
+
+/* -------------------------------------------------------------------------- */
+/* Site-wide tools                                                            */
+/* -------------------------------------------------------------------------- */
+
+const siteTools: ToolDefinition[] = [
+  {
+    name: 'list_articles',
+    description:
+      'List every article published on The DevTools Times with its slug, title, summary and URL. Use the slug with other tools.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    async execute() {
+      const articles = await fetchArticles();
+      return textResult(
+        articles.map(({ slug, title, summary }) => ({ slug, title, summary, url: articleUrl(slug) })),
+      );
+    },
+  },
+  {
+    name: 'open_article',
+    description: 'Navigate the browser to an article on The DevTools Times by its slug.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: { type: 'string', description: 'The article slug, e.g. "housing-crisis". Use list_articles to find slugs.' },
+      },
+      required: ['slug'],
+    },
+    async execute({ slug }: { slug: string }) {
+      const articles = await fetchArticles();
+      const article = articles.find((a) => a.slug === slug);
+      if (!article) return errorResult(`No article found with slug "${slug}".`);
+      const url = articleUrl(slug);
+      // Navigate after responding so the agent receives the result.
+      setTimeout(async () => {
+        try {
+          const { navigate } = await import('astro:transitions/client');
+          await navigate(url);
+        } catch {
+          window.location.assign(url);
+        }
+      }, 0);
+      return textResult(`Opening "${article.title}" (${url}).`);
+    },
+  },
+  {
+    name: 'get_reading_list',
+    description: "Return the articles currently saved on the reader's reading list.",
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    async execute() {
+      const [slugs, articles] = await Promise.all([getReadingList(), fetchArticles()]);
+      const saved = slugs.map((slug) => {
+        const article = articles.find((a) => a.slug === slug);
+        return { slug, title: article?.title ?? slug, url: articleUrl(slug) };
+      });
+      return textResult(saved.length ? saved : 'The reading list is empty.');
+    },
+  },
+  {
+    name: 'open_search_form',
+    description:
+      'Open the site search panel. While it is open, the "search_articles" form tool is available to run a search.',
+    inputSchema: { type: 'object', properties: {} },
+    async execute() {
+      window.dispatchEvent(new CustomEvent(OPEN_SEARCH_EVENT));
+      await nextFrame();
+      return textResult('Search panel opened. Use the "search_articles" form tool to search.');
+    },
+  },
+  {
+    name: 'open_reading_list_form',
+    description:
+      'Open the reading list panel. While it is open, the "update_reading_list" form tool is available to add or remove articles.',
+    inputSchema: { type: 'object', properties: {} },
+    async execute() {
+      window.dispatchEvent(new CustomEvent(OPEN_READING_LIST_EVENT));
+      await nextFrame();
+      return textResult('Reading list panel opened. Use the "update_reading_list" form tool to change it.');
+    },
+  },
+];
+
+/* -------------------------------------------------------------------------- */
+/* Article-page tools                                                         */
+/* -------------------------------------------------------------------------- */
+
+interface ArticleContext {
+  root: HTMLElement;
+  body: HTMLElement;
+}
+
+const getArticleContext = (): ArticleContext | undefined => {
+  const root = document.querySelector<HTMLElement>('[data-article]');
+  const body = root?.querySelector<HTMLElement>('[data-article-body]');
+  return root && body ? { root, body } : undefined;
+};
+
+const normalize = (text: string) => text.replace(/\s+/g, ' ').trim();
+const countWords = (text: string) => (normalize(text) ? normalize(text).split(' ').length : 0);
+
+const slugify = (text: string) =>
+  text
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/(^-|-$)/g, '');
+
+const getHeadings = (body: HTMLElement) =>
+  Array.from(body.querySelectorAll<HTMLHeadingElement>('h2, h3, h4')).map((el, index) => {
+    if (!el.id) el.id = slugify(el.textContent ?? '') || `section-${index + 1}`;
+    return { el, id: el.id, level: Number(el.tagName[1]), text: normalize(el.textContent ?? '') };
+  });
+
+const flash = (el: HTMLElement) => {
+  el.animate(
+    [{ backgroundColor: 'rgba(251, 191, 36, 0.45)' }, { backgroundColor: 'transparent' }],
+    { duration: 1800, easing: 'ease-out' },
+  );
+};
+
+const articleTools = ({ root, body }: ArticleContext): ToolDefinition[] => {
+  const meta = () => ({
+    slug: root.dataset.slug,
+    title: root.dataset.title,
+    summary: root.dataset.summary,
+    author: root.dataset.author,
+    category: root.dataset.category,
+    publishedAt: root.dataset.date,
+    url: new URL(articleUrl(root.dataset.slug ?? ''), window.location.origin).href,
+  });
+
+  return [
+    {
+      name: 'get_current_article',
+      description:
+        'Get the article currently open in the page: metadata (title, author, date, category, summary, URL), word count and optionally its full text.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          includeText: { type: 'boolean', description: 'Include the full plain-text body. Defaults to true.', default: true },
+        },
+      },
+      annotations: { readOnlyHint: true },
+      execute({ includeText = true }: { includeText?: boolean } = {}) {
+        const text = normalize(body.innerText || body.textContent || '');
+        return textResult({ ...meta(), wordCount: countWords(text), ...(includeText ? { text } : {}) });
+      },
+    },
+    {
+      name: 'get_article_outline',
+      description: 'Return the section headings of the current article in reading order, with ids usable by scroll_to_article_section.',
+      inputSchema: { type: 'object', properties: {} },
+      annotations: { readOnlyHint: true },
+      execute() {
+        const headings = getHeadings(body).map(({ id, level, text }) => ({ id, level, text }));
+        return textResult(headings.length ? headings : 'This article has no section headings.');
+      },
+    },
+    {
+      name: 'scroll_to_article_section',
+      description:
+        'Scroll the current article to a section, matched by heading id or (partial, case-insensitive) heading text, and highlight it.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          section: { type: 'string', description: 'Heading id or text, e.g. "the road ahead". Use get_article_outline to list sections.' },
+        },
+        required: ['section'],
+      },
+      execute({ section }: { section: string }) {
+        const query = section.trim().toLowerCase();
+        const headings = getHeadings(body);
+        const match =
+          headings.find((h) => h.id === query) ??
+          headings.find((h) => h.text.toLowerCase() === query) ??
+          headings.find((h) => h.text.toLowerCase().includes(query));
+        if (!match) {
+          return errorResult(
+            `No section matching "${section}". Available sections: ${headings.map((h) => h.text).join(', ') || 'none'}.`,
+          );
+        }
+        match.el.scrollIntoView({ behavior: 'smooth', block: 'start' });
+        flash(match.el);
+        return textResult(`Scrolled to section "${match.text}".`);
+      },
+    },
+    {
+      name: 'find_in_article',
+      description:
+        'Find occurrences of a word or phrase in the current article body. Returns surrounding context for each match and optionally scrolls to the first one.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          query: { type: 'string', description: 'Word or phrase to look for (case-insensitive).' },
+          maxResults: { type: 'number', description: 'Maximum number of matches to return. Defaults to 10.', minimum: 1, maximum: 50 },
+          scrollToFirst: { type: 'boolean', description: 'Scroll to and highlight the paragraph with the first match. Defaults to false.' },
+        },
+        required: ['query'],
+      },
+      annotations: { readOnlyHint: true },
+      execute({ query, maxResults = 10, scrollToFirst = false }: { query: string; maxResults?: number; scrollToFirst?: boolean }) {
+        const needle = query.trim().toLowerCase();
+        if (!needle) return errorResult('Query must not be empty.');
+        const blocks = Array.from(body.querySelectorAll<HTMLElement>('p, li, blockquote, h2, h3, h4'));
+        const matches: { context: string }[] = [];
+        let firstBlock: HTMLElement | undefined;
+        let total = 0;
+        for (const block of blocks) {
+          const text = normalize(block.textContent ?? '');
+          const lower = text.toLowerCase();
+          let index = lower.indexOf(needle);
+          while (index !== -1) {
+            total++;
+            firstBlock ??= block;
+            if (matches.length < maxResults) {
+              const start = Math.max(0, index - 80);
+              const end = Math.min(text.length, index + needle.length + 80);
+              matches.push({ context: `${start > 0 ? '…' : ''}${text.slice(start, end)}${end < text.length ? '…' : ''}` });
+            }
+            index = lower.indexOf(needle, index + needle.length);
+          }
+        }
+        if (scrollToFirst && firstBlock) {
+          firstBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });
+          flash(firstBlock);
+        }
+        return textResult({ query, totalMatches: total, matches });
+      },
+    },
+    {
+      name: 'estimate_reading_time',
+      description: 'Estimate how long the current article takes to read, in total and from the current scroll position.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          wordsPerMinute: {
+            type: 'number',
+            description: `Reading speed in words per minute. Defaults to ${DEFAULT_WPM}.`,
+            minimum: 50,
+            maximum: 1000,
+          },
+        },
+      },
+      annotations: { readOnlyHint: true },
+      execute({ wordsPerMinute = DEFAULT_WPM }: { wordsPerMinute?: number } = {}) {
+        const wordCount = countWords(body.innerText || body.textContent || '');
+        const rect = body.getBoundingClientRect();
+        const readFraction = rect.height > 0 ? Math.min(1, Math.max(0, -rect.top / rect.height)) : 0;
+        const minutes = wordCount / wordsPerMinute;
+        return textResult({
+          wordCount,
+          wordsPerMinute,
+          totalMinutes: Math.max(1, Math.round(minutes)),
+          progressPercent: Math.round(readFraction * 100),
+          remainingMinutes: Math.max(0, Math.round(minutes * (1 - readFraction))),
+        });
+      },
+    },
+    {
+      name: 'copy_article_link',
+      description: "Copy the current article's title and URL to the clipboard so the reader can share it.",
+      inputSchema: {
+        type: 'object',
+        properties: {
+          format: {
+            type: 'string',
+            enum: ['url', 'markdown', 'text'],
+            description: 'Clipboard format: bare URL, Markdown link, or "Title – URL". Defaults to "url".',
+          },
+        },
+      },
+      async execute({ format = 'url' }: { format?: 'url' | 'markdown' | 'text' } = {}) {
+        const { title, url } = meta();
+        const value = format === 'markdown' ? `[${title}](${url})` : format === 'text' ? `${title} – ${url}` : url;
+        try {
+          await navigator.clipboard.writeText(value);
+          return textResult(`Copied to clipboard: ${value}`);
+        } catch {
+          return errorResult(`Could not access the clipboard. The link is: ${value}`);
+        }
+      },
+    },
+  ];
+};
+
+/* -------------------------------------------------------------------------- */
+/* Lifecycle                                                                  */
+/* -------------------------------------------------------------------------- */
+
+declare global {
+  interface Window {
+    __devtoolsTimesWebMCP?: { siteRegistered: boolean; unregisterPageTools?: () => void };
+  }
+}
+
+function setup() {
+  if (!isWebMCPSupported()) return;
+  const state = (window.__devtoolsTimesWebMCP ??= { siteRegistered: false });
+
+  if (!state.siteRegistered) {
+    registerTools(siteTools);
+    state.siteRegistered = true;
+  }
+
+  const syncPageTools = () => {
+    state.unregisterPageTools?.();
+    state.unregisterPageTools = undefined;
+    const ctx = getArticleContext();
+    if (ctx) state.unregisterPageTools = registerTools(articleTools(ctx));
+  };
+
+  syncPageTools();
+  // `astro:page-load` fires on the initial load and after every client-side navigation.
+  document.addEventListener('astro:page-load', syncPageTools);
+  document.addEventListener('astro:before-swap', () => {
+    state.unregisterPageTools?.();
+    state.unregisterPageTools = undefined;
+  });
+}
+
+setup();
