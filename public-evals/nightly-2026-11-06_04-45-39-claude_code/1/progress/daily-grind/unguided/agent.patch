+    /* Progress Section */
+    .progress-section {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 20px;
+      margin-bottom: 40px;
+    }
+
+    .progress-card {
+      background: white;
+      padding: 20px 24px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      border-left: 4px solid var(--accent);
+    }
+
+    .progress-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 12px;
+      margin-bottom: 10px;
+    }
+
+    .progress-header h2 {
+      font-size: 1.1rem;
+      color: var(--primary);
+    }
+
+    .progress-value {
+      font-weight: bold;
+      font-size: 0.9rem;
+      color: var(--primary);
+      white-space: nowrap;
+    }
+
+    .progress-track {
+      position: relative;
+      height: 14px;
+      background: var(--secondary);
+      border-radius: 999px;
+      overflow: hidden;
+      box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.15);
+    }
+
+    .progress-fill {
+      height: 100%;
+      width: var(--progress, 0%);
+      background: linear-gradient(90deg, var(--primary), #8d6e63 60%, var(--accent));
+      border-radius: inherit;
+      transition: width 0.6s ease;
+    }
+
+    /* Indeterminate state: a sliding segment, since completion is unknown */
+    .progress-track.is-indeterminate .progress-fill {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 35%;
+      background: linear-gradient(90deg, transparent, var(--primary) 30%, var(--accent) 70%, transparent);
+      animation: progress-slide 1.4s ease-in-out infinite;
+    }
+
+    @keyframes progress-slide {
+      0% { transform: translateX(-100%); }
+      100% { transform: translateX(300%); }
+    }
+
+    .progress-note {
+      margin-top: 10px;
+      font-size: 0.85rem;
+      color: #6d4c41;
+    }
+
+    .progress-steps {
+      display: flex;
+      justify-content: space-between;
+      list-style: none;
+      margin-top: 8px;
+      font-size: 0.75rem;
+      color: #8d6e63;
+    }
+
+    .progress-steps li.is-done {
+      color: var(--primary);
+      font-weight: bold;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .progress-fill {
+        transition: none;
+      }
+
+      .progress-track.is-indeterminate .progress-fill {
+        animation: none;
+        width: 100%;
+        opacity: 0.5;
+        background: repeating-linear-gradient(45deg, var(--primary) 0 10px, #8d6e63 10px 20px);
+      }
+    }
+
