+  <script>
+    // Demo: order progress begins indeterminate, then reports determinate steps.
+    (() => {
+      const bar = document.getElementById('order-progress');
+      const status = document.getElementById('order-status');
+      const percent = document.getElementById('order-percent');
+      const steps = [
+        { value: 25, text: 'Order received' },
+        { value: 60, text: 'Your barista is brewing' },
+        { value: 100, text: 'Ready for pickup!' },
+      ];
+      let i = 0;
+      const advance = () => {
+        const step = steps[i++];
+        bar.value = step.value;
+        percent.textContent = `${step.value}%`;
+        status.textContent = step.text;
+        if (i < steps.length) setTimeout(advance, 3000);
+      };
+      setTimeout(advance, 3000);
+    })();
+  </script>
