+    /* Progress bars */
+    .progress-panel {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+      gap: 20px;
+      margin-bottom: 40px;
+    }
+
+    .progress-card {
+      background: white;
+      padding: 20px 24px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .progress-card h2 {
+      font-size: 1.1rem;
+      color: var(--primary);
+      margin-bottom: 4px;
+    }
+
+    .progress-label {
+      display: flex;
+      justify-content: space-between;
+      gap: 12px;
+      font-size: 0.9rem;
+      margin-bottom: 8px;
+    }
+
+    .progress-meta {
+      font-size: 0.85rem;
+      color: #6d4c41;
+      margin-top: 8px;
+      min-height: 1.6em;
+    }
+
+    progress {
+      /* Reset default browser styles */
+      appearance: none;
+      border: 0 solid;
+      overflow: clip;
+      display: block;
+      inline-size: 100%;
+      block-size: 12px;
+
+      --progress-bar-radius: 1e5px;
+      --progress-bar-track: #efebe9;
+      --progress-bar-fill: var(--primary);
+      border-radius: var(--progress-bar-radius);
+      background: var(--progress-bar-track);
+      box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.15);
+
+      /* Lets the fill position itself in track units (cqi) */
+      container-type: inline-size;
+      --progress-bar-indeterminate-size: 30%;
+      --progress-bar-indeterminate-animation-duration: 1.5s;
+
+      @media (prefers-reduced-motion: reduce) {
+        --progress-bar-indeterminate-animation-duration: 10s;
+      }
+    }
+
+    progress.progress-reward {
+      --progress-bar-fill: linear-gradient(90deg, var(--primary), #8d6e63);
+    }
+
+    progress:indeterminate {
+      --progress-bar-animation: var(--progress-bar-indeterminate-animation,
+          progress-bar-indeterminate var(--progress-bar-indeterminate-animation-duration) infinite linear);
+    }
+
+    progress:dir(rtl) {
+      --progress-bar-indeterminate-animation: progress-bar-indeterminate var(--progress-bar-indeterminate-animation-duration) infinite linear reverse;
+    }
+
+    /* Let <progress> styling show through */
+    progress::-webkit-progress-bar {
+      background: transparent;
+    }
+
+    /* WebKit, Chrome */
+    progress::-webkit-progress-value {
+      background: var(--progress-bar-fill);
+      border-radius: var(--progress-bar-radius);
+      transition: inline-size 0.3s;
+      animation: var(--progress-bar-animation, revert-rule);
+    }
+
+    /* Firefox */
+    progress::-moz-progress-bar {
+      background: var(--progress-bar-fill);
+      border-radius: var(--progress-bar-radius);
+      transition: inline-size 0.3s;
+      animation: var(--progress-bar-animation, revert-rule);
+    }
+
+    @keyframes progress-bar-indeterminate {
+      from, to {
+        inline-size: var(--progress-bar-indeterminate-size);
+        margin-right: auto;
+      }
+      from { translate: -100%; }
+      to { translate: 100cqi; }
+    }
