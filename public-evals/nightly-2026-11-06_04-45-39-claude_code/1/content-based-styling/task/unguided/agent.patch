+    /* Cards containing an image switch to a side-by-side layout */
+    .card:has(> img) {
+      display: flex;
+      align-items: stretch;
+      gap: 20px;
+      text-align: left;
+    }
+
+    .card:has(> img) > img {
+      flex: 0 0 40%;
+      width: 40%;
+      min-height: 160px;
+      object-fit: cover;
+      border-radius: 6px;
+    }
+
+    .card:has(> img) .card-body {
+      flex: 1;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: flex-start;
+    }
+
+    @media (min-width: 700px) {
+      .card:has(> img) {
+        grid-column: span 2;
+      }
+    }
+
+    @media (max-width: 480px) {
+      .card:has(> img) {
+        flex-direction: column;
+      }
+
+      .card:has(> img) > img {
+        width: 100%;
+        flex-basis: auto;
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
