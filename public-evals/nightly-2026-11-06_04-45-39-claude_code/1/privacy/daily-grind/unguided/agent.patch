@@ -0,0 +1,160 @@
+/*
+ * The Daily Grind — client-side privacy controls.
+ *
+ * Principles:
+ *  - Data minimization: no cookies, no analytics, no fingerprinting, no
+ *    network requests. The only thing stored is a single localStorage flag
+ *    recording that the privacy notice was dismissed (no ID, no timestamp).
+ *  - Respect browser signals: Global Privacy Control and Do Not Track are
+ *    treated as an opt-out of any future optional processing.
+ *  - Strip tracking identifiers from the URL so they aren't bookmarked,
+ *    shared onward, or leaked via Referer to the next site.
+ *  - Harden outbound links so third parties don't get window.opener or
+ *    a full Referer.
+ */
+(function () {
+  'use strict';
+
+  var STORAGE_PREFIX = 'dg:';
+  var NOTICE_KEY = STORAGE_PREFIX + 'privacy-notice-dismissed';
+  // Only keys on this list may live in localStorage/sessionStorage. Anything
+  // else under our prefix is purged on load so stale data doesn't linger.
+  var ALLOWED_STORAGE_KEYS = [NOTICE_KEY];
+
+  // Query parameters that exist only to track people across sites.
+  var TRACKING_PARAMS = [
+    'fbclid', 'gclid', 'gclsrc', 'dclid', 'gbraid', 'wbraid', 'msclkid',
+    'mc_cid', 'mc_eid', 'yclid', 'igshid', 'twclid', 'ttclid', 'li_fat_id',
+    '_ga', '_gl', '_hsenc', '_hsmi', 'mkt_tok', 'oly_anon_id', 'oly_enc_id',
+    'vero_id', 'wickedid', 'rb_clickid', 's_cid', 'srsltid'
+  ];
+  var TRACKING_PREFIXES = ['utm_', 'pk_', 'mtm_', 'hsa_'];
+
+  function safeStorage(kind) {
+    // Storage access throws in some privacy modes; treat as unavailable.
+    try {
+      var s = window[kind];
+      var probe = STORAGE_PREFIX + 'probe';
+      s.setItem(probe, '1');
+      s.removeItem(probe);
+      return s;
+    } catch (e) {
+      return null;
+    }
+  }
+
+  var local = safeStorage('localStorage');
+  var session = safeStorage('sessionStorage');
+
+  /** True when the visitor has asked not to be tracked or have data sold/shared. */
+  function hasOptedOut() {
+    var nav = window.navigator || {};
+    if (nav.globalPrivacyControl === true) return true;
+    var dnt = nav.doNotTrack || window.doNotTrack || nav.msDoNotTrack;
+    return dnt === '1' || dnt === 'yes';
+  }
+
+  function purgeUnapprovedStorage(store) {
+    if (!store) return;
+    var stale = [];
+    for (var i = 0; i < store.length; i++) {
+      var key = store.key(i);
+      if (key && key.indexOf(STORAGE_PREFIX) === 0 && ALLOWED_STORAGE_KEYS.indexOf(key) === -1) {
+        stale.push(key);
+      }
+    }
+    stale.forEach(function (k) { store.removeItem(k); });
+  }
+
+  function isTrackingParam(name) {
+    var n = name.toLowerCase();
+    if (TRACKING_PARAMS.indexOf(n) !== -1) return true;
+    for (var i = 0; i < TRACKING_PREFIXES.length; i++) {
+      if (n.indexOf(TRACKING_PREFIXES[i]) === 0) return true;
+    }
+    return false;
+  }
+
+  function stripTrackingParams() {
+    if (!window.URL || !window.history || !history.replaceState) return;
+    var url = new URL(window.location.href);
+    var names = [];
+    url.searchParams.forEach(function (_, name) {
+      if (isTrackingParam(name)) names.push(name);
+    });
+    if (!names.length) return;
+    names.forEach(function (n) { url.searchParams.delete(n); });
+    history.replaceState(history.state, '', url.pathname + url.search + url.hash);
+  }
+
+  function hardenOutboundLinks(root) {
+    var links = (root || document).querySelectorAll('a[href]');
+    for (var i = 0; i < links.length; i++) {
+      var a = links[i];
+      var url;
+      try {
+        url = new URL(a.getAttribute('href'), window.location.href);
+      } catch (e) {
+        continue;
+      }
+      if (url.protocol !== 'http:' && url.protocol !== 'https:') continue;
+      if (url.origin === window.location.origin) continue;
+      var rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
+      ['noopener', 'noreferrer'].forEach(function (r) {
+        if (rel.indexOf(r) === -1) rel.push(r);
+      });
+      a.setAttribute('rel', rel.join(' '));
+      a.setAttribute('referrerpolicy', 'no-referrer');
+    }
+  }
+
+  function setupNotice() {
+    var notice = document.getElementById('privacy-notice');
+    var button = document.getElementById('privacy-notice-dismiss');
+    if (!notice || !button) return;
+    if (local && local.getItem(NOTICE_KEY) === '1') return;
+    notice.hidden = false;
+    button.addEventListener('click', function () {
+      notice.hidden = true;
+      if (local) local.setItem(NOTICE_KEY, '1');
+    });
+  }
+
+  function showSignalStatus() {
+    var el = document.getElementById('gpc-status');
+    if (!el || !hasOptedOut()) return;
+    el.textContent = 'Your browser’s privacy signal (Global Privacy Control / Do Not Track) is honored on this site.';
+    el.hidden = false;
+  }
+
+  /**
+   * Gate for any future optional third-party feature (maps, chat, analytics).
+   * Nothing calls this today; it exists so new integrations have to go
+   * through an explicit opt-out check instead of loading unconditionally.
+   * Returns false whenever the visitor has signalled an opt-out.
+   */
+  function mayLoadOptional() {
+    return !hasOptedOut();
+  }
+
+  stripTrackingParams();
+  purgeUnapprovedStorage(local);
+  purgeUnapprovedStorage(session);
+
+  function onReady() {
+    hardenOutboundLinks(document);
+    setupNotice();
+    showSignalStatus();
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', onReady);
+  } else {
+    onReady();
+  }
+
+  window.DailyGrindPrivacy = Object.freeze({
+    hasOptedOut: hasOptedOut,
+    mayLoadOptional: mayLoadOptional
+  });
+})();
