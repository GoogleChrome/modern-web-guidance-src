@@ -0,0 +1,24 @@
+// Generates `_headers` (Netlify / Cloudflare Pages) from security-headers.mjs.
+import { writeFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { SECURITY_HEADERS, HTML_CACHE_CONTROL, ASSET_CACHE_CONTROL } from '../security-headers.mjs';
+
+export function renderHeadersFile() {
+  const block = (path, headers) =>
+    [path, ...Object.entries(headers).map(([k, v]) => `  ${k}: ${v}`)].join('\n');
+  // Paths must not overlap on Cache-Control: hosts merge duplicate headers.
+  return [
+    '# GENERATED by scripts/build-headers.mjs from security-headers.mjs — do not edit by hand.',
+    block('/*', SECURITY_HEADERS),
+    block('/', { 'Cache-Control': HTML_CACHE_CONTROL }),
+    block('/index.html', { 'Cache-Control': HTML_CACHE_CONTROL }),
+    block('/assets/*', { 'Cache-Control': ASSET_CACHE_CONTROL }),
+    '',
+  ].join('\n\n');
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  const out = new URL('../_headers', import.meta.url);
+  writeFileSync(out, renderHeadersFile());
+  console.log('Wrote _headers');
+}
diff --git a/scripts/privacy-audit.mjs b/scripts/privacy-audit.mjs
new file mode 100644
index 0000000..5e721ea
--- /dev/null
+++ b/scripts/privacy-audit.mjs
@@ -0,0 +1,123 @@
+#!/usr/bin/env node
+// Privacy & third-party audit for The Daily Grind. No dependencies.
+//
+// Fails (exit 1) if any public file:
+//   - references a third-party origin not on THIRD_PARTY_ALLOWLIST
+//   - contains inline <script>, inline event handlers, or style="" attributes
+//     (these would force 'unsafe-inline' into the CSP)
+//   - uses known tracking/analytics/fingerprinting APIs or vendors
+//   - writes cookies from client-side JS
+// and also checks that the <meta> CSP fallback matches security-headers.mjs
+// and that `_headers` is up to date.
+//
+// Run: npm run audit:privacy
+
+import { readFileSync, readdirSync, statSync, existsSync } from 'node:fs';
+import { join, relative, extname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { serializeCsp } from '../security-headers.mjs';
+import { renderHeadersFile } from './build-headers.mjs';
+
+const ROOT = fileURLToPath(new URL('..', import.meta.url));
+
+// Every third party the site talks to must be listed here with a reason,
+// a data-processing review date, and what data it receives. Currently none.
+// Example entry:
+//   'https://example-maps.com': { purpose: 'store locator map', receives: 'IP, UA', reviewed: '2026-11-06' },
+const THIRD_PARTY_ALLOWLIST = {};
+
+// Origins that may appear in comments/docs as text but are never fetched.
+const IGNORED_URL_PREFIXES = ['http://www.w3.org/', 'https://www.w3.org/', 'http://localhost', 'https://localhost'];
+
+const PUBLIC_PATHS = ['index.html', 'assets', 'robots.txt', '.well-known'];
+const SCANNED_EXT = new Set(['.html', '.css', '.js', '.json', '.txt', '.svg']);
+
+const TRACKER_PATTERNS = [
+  [/google-analytics\.com|googletagmanager\.com|gtag\(|\bga\(\s*['"]/i, 'Google Analytics / Tag Manager'],
+  [/connect\.facebook\.net|\bfbq\(/i, 'Meta Pixel'],
+  [/hotjar|fullstory|mouseflow|clarity\.ms|logrocket|smartlook/i, 'Session replay'],
+  [/doubleclick|adservice|googlesyndication|criteo|taboola|outbrain/i, 'Ad network'],
+  [/segment\.(com|io)|mixpanel|amplitude|heap(analytics)?\.|matomo|plausible/i, 'Analytics SDK'],
+  [/fonts\.googleapis\.com|fonts\.gstatic\.com|use\.typekit\.net/i, 'Third-party web fonts (leak IP)'],
+  [/\.toDataURL\(|getImageData\(|\bAudioContext\b|getChannelData/i, 'Possible canvas/audio fingerprinting'],
+  [/navigator\.(plugins|hardwareConcurrency|deviceMemory|getBattery)/i, 'Fingerprinting surface'],
+  [/navigator\.sendBeacon|new\s+Image\(\)\.src\s*=/i, 'Beacon-style tracking'],
+];
+
+function walk(p) {
+  const full = join(ROOT, p);
+  if (!existsSync(full)) return [];
+  const st = statSync(full);
+  if (st.isFile()) return [full];
+  return readdirSync(full).flatMap((name) => walk(join(p, name)));
+}
+
+const problems = [];
+const report = (file, msg) => problems.push(`${relative(ROOT, file)}: ${msg}`);
+const thirdParties = new Map();
+
+const files = PUBLIC_PATHS.flatMap(walk).filter((f) => SCANNED_EXT.has(extname(f).toLowerCase()));
+
+for (const file of files) {
+  const text = readFileSync(file, 'utf8');
+  const ext = extname(file).toLowerCase();
+
+  for (const m of text.matchAll(/(?:https?:)?\/\/[a-z0-9.-]+\.[a-z]{2,}(?::\d+)?/gi)) {
+    const raw = m[0].startsWith('//') ? `https:${m[0]}` : m[0];
+    if (IGNORED_URL_PREFIXES.some((p) => raw.startsWith(p))) continue;
+    const origin = new URL(raw).origin;
+    if (!thirdParties.has(origin)) thirdParties.set(origin, new Set());
+    thirdParties.get(origin).add(relative(ROOT, file));
+    if (!THIRD_PARTY_ALLOWLIST[origin]) report(file, `unapproved third-party origin ${origin}`);
+  }
+
+  for (const [re, label] of TRACKER_PATTERNS) {
+    if (re.test(text)) report(file, `matches tracker pattern: ${label}`);
+  }
+
+  if (ext === '.html') {
+    for (const m of text.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script>/gi)) {
+      if (!/\bsrc\s*=/.test(m[1]) || m[2].trim()) report(file, 'inline <script> (requires unsafe-inline)');
+    }
+    if (/<style\b/i.test(text)) report(file, 'inline <style> block (requires unsafe-inline)');
+    if (/\sstyle\s*=/i.test(text)) report(file, 'style="" attribute (requires unsafe-inline)');
+    if (/\son[a-z]+\s*=/i.test(text)) report(file, 'inline event handler attribute');
+    if (/href\s*=\s*["']\s*javascript:/i.test(text)) report(file, 'javascript: URL');
+    if (/<a\b[^>]*href=["'][^"']*\/logout/i.test(text)) report(file, 'logout via GET link — use a POST form');
+    for (const m of text.matchAll(/<input\b[^>]*>/gi)) {
+      const tag = m[0];
+      if (/type=["']?(email|tel|password|text)/i.test(tag) && !/autocomplete=/i.test(tag)) {
+        report(file, `input without explicit autocomplete attribute: ${tag}`);
+      }
+    }
+
+    const meta = text.match(/<meta\s+http-equiv=["']Content-Security-Policy["']\s+content="([^"]+)"/i);
+    const expected = serializeCsp(undefined, { forMeta: true });
+    if (!meta) report(file, 'missing <meta> CSP fallback');
+    else if (meta[1].replace(/\s+/g, ' ').trim() !== expected) {
+      report(file, `<meta> CSP out of sync with security-headers.mjs\n    expected: ${expected}\n    found:    ${meta[1]}`);
+    }
+    if (!/<meta\s+name=["']referrer["']/i.test(text)) report(file, 'missing <meta name="referrer">');
+  }
+
+  if (ext === '.js' && /document\.cookie\s*=/.test(text)) report(file, 'client-side cookie write');
+}
+
+const headersPath = join(ROOT, '_headers');
+if (!existsSync(headersPath) || readFileSync(headersPath, 'utf8') !== renderHeadersFile()) {
+  problems.push('_headers: out of date — run `npm run build`');
+}
+
+console.log(`Scanned ${files.length} public files.`);
+console.log('Third-party origins referenced:', thirdParties.size ? '' : 'none');
+for (const [origin, where] of thirdParties) {
+  const entry = THIRD_PARTY_ALLOWLIST[origin];
+  console.log(`  ${origin} ${entry ? `(approved: ${entry.purpose})` : '(NOT APPROVED)'} — ${[...where].join(', ')}`);
+}
+
+if (problems.length) {
+  console.error(`\nPrivacy audit FAILED with ${problems.length} problem(s):`);
+  for (const p of problems) console.error(`  - ${p}`);
+  process.exit(1);
+}
+console.log('\nPrivacy audit passed.');
diff --git a/security-headers.mjs b/security-headers.mjs
new file mode 100644
index 0000000..372fee5
--- /dev/null
+++ b/security-headers.mjs
@@ -0,0 +1,60 @@
+// Single source of truth for HTTP security & privacy headers.
+// Used by server.mjs at runtime and by scripts/build-headers.mjs to generate
+// `_headers` (Netlify / Cloudflare Pages format) for static hosting.
+// Keep the CSP in sync with the <meta http-equiv> fallback in index.html —
+// `npm run audit:privacy` checks this.
+
+export const CSP_DIRECTIVES = {
+  'default-src': ["'none'"],
+  'script-src': ["'self'"],
+  'style-src': ["'self'"],
+  'img-src': ["'self'"],
+  'font-src': ["'self'"],
+  'connect-src': ["'self'"],
+  'manifest-src': ["'self'"],
+  'form-action': ["'self'"],
+  'frame-ancestors': ["'none'"], // header-only; ignored in <meta>
+  'base-uri': ["'none'"],
+};
+
+export function serializeCsp(directives = CSP_DIRECTIVES, { forMeta = false } = {}) {
+  return Object.entries(directives)
+    // frame-ancestors, report-uri and sandbox are not allowed in <meta> CSP.
+    .filter(([name]) => !forMeta || !['frame-ancestors', 'report-uri', 'sandbox'].includes(name))
+    .map(([name, values]) => [name, ...values].join(' '))
+    .join('; ');
+}
+
+// Deny every powerful feature this site does not use, plus ad-tech APIs
+// (Topics, FLEDGE/Protected Audience, Attribution Reporting) that would
+// otherwise let the browser build an interest profile from visits here.
+const DENIED_FEATURES = [
+  'accelerometer', 'ambient-light-sensor', 'attribution-reporting', 'autoplay',
+  'bluetooth', 'browsing-topics', 'camera', 'display-capture',
+  'encrypted-media', 'gamepad', 'geolocation', 'gyroscope', 'hid',
+  'identity-credentials-get', 'idle-detection', 'interest-cohort',
+  'join-ad-interest-group', 'local-fonts', 'magnetometer', 'microphone',
+  'midi', 'otp-credentials', 'payment', 'private-aggregation',
+  'publickey-credentials-get', 'run-ad-auction', 'screen-wake-lock',
+  'serial', 'shared-storage', 'shared-storage-select-url', 'usb',
+  'window-management', 'xr-spatial-tracking',
+];
+
+export const SECURITY_HEADERS = {
+  'Content-Security-Policy': serializeCsp(),
+  'Strict-Transport-Security': 'max-age=63072000; includeSubDomains',
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'Permissions-Policy': DENIED_FEATURES.map((f) => `${f}=()`).join(', '),
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Cross-Origin-Embedder-Policy': 'require-corp',
+  'Origin-Agent-Cluster': '?1',
+  'X-DNS-Prefetch-Control': 'off',
+  'X-Permitted-Cross-Domain-Policies': 'none',
+};
+
+// HTML may be personalised (e.g. logged-in nav) — never let shared caches keep it.
+export const HTML_CACHE_CONTROL = 'no-cache, private';
+export const ASSET_CACHE_CONTROL = 'public, max-age=86400';
diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..e60fb83
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,81 @@
+// Minimal static server for The Daily Grind that sends the security and
+// privacy headers defined in security-headers.mjs. No dependencies.
+//
+// Data minimization: no access logs are written, so visitor IP addresses,
+// user agents and URLs are never persisted. Only an allowlist of public
+// paths is served — source files, package metadata and dotfiles are not.
+
+import { createServer } from 'node:http';
+import { readFile, stat } from 'node:fs/promises';
+import { extname, join, normalize, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { SECURITY_HEADERS, HTML_CACHE_CONTROL, ASSET_CACHE_CONTROL } from './security-headers.mjs';
+
+const ROOT = fileURLToPath(new URL('.', import.meta.url));
+const PORT = Number(process.env.PORT) || 11222;
+
+const PUBLIC_FILES = new Set(['/index.html', '/robots.txt', '/.well-known/gpc.json']);
+const PUBLIC_DIRS = ['/assets/'];
+
+const MIME = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.txt': 'text/plain; charset=utf-8',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.png': 'image/png',
+  '.webp': 'image/webp',
+  '.svg': 'image/svg+xml',
+  '.ico': 'image/x-icon',
+};
+
+function resolvePublic(urlPath) {
+  let p;
+  try {
+    p = decodeURIComponent(urlPath);
+  } catch {
+    return null;
+  }
+  if (p.includes('\0')) return null;
+  if (p === '/') p = '/index.html';
+  p = normalize(p).split(sep).join('/');
+  if (!PUBLIC_FILES.has(p) && !PUBLIC_DIRS.some((d) => p.startsWith(d))) return null;
+  // Reject hidden path segments inside public dirs (e.g. /assets/.env).
+  if (PUBLIC_DIRS.some((d) => p.startsWith(d)) && p.split('/').some((seg) => seg.startsWith('.'))) return null;
+  const full = join(ROOT, p);
+  if (!full.startsWith(ROOT)) return null;
+  return full;
+}
+
+function send(res, status, body, headers = {}) {
+  res.writeHead(status, { ...SECURITY_HEADERS, ...headers });
+  res.end(body);
+}
+
+const server = createServer(async (req, res) => {
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    return send(res, 405, 'Method Not Allowed', { Allow: 'GET, HEAD', 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+  const { pathname } = new URL(req.url, 'http://localhost');
+  const file = resolvePublic(pathname);
+  if (!file) return send(res, 404, 'Not Found', { 'Content-Type': 'text/plain; charset=utf-8' });
+  try {
+    const info = await stat(file);
+    if (!info.isFile()) throw new Error('not a file');
+    const body = await readFile(file);
+    const ext = extname(file).toLowerCase();
+    send(res, 200, req.method === 'HEAD' ? undefined : body, {
+      'Content-Type': MIME[ext] || 'application/octet-stream',
+      'Content-Length': body.length,
+      'Cache-Control': ext === '.html' ? HTML_CACHE_CONTROL : ASSET_CACHE_CONTROL,
+    });
+  } catch {
+    send(res, 404, 'Not Found', { 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind listening on port ${PORT}`);
+});
