+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-form {
+  display: inline;
+}
+
+/* A POST form (not a GET link) so logout cannot be triggered cross-site
+   and so the server can answer with Clear-Site-Data. */
+.logout-link {
+  font: inherit;
+  font-size: 0.9rem;
+  color: white;
+  background: none;
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+  cursor: pointer;
+  transition: color 0.3s;
+}
+
+.logout-link:hover,
+.logout-link:focus-visible {
+  color: var(--accent);
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  /* Self-hosted stock photo (Unsplash, photo-1495474472287) so visitors' IPs,
+     user agents and referrers are never sent to a third-party image CDN. */
+  background-color: var(--primary);
+  background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url("/assets/img/hero-coffee.jpg");
+  background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    image-set(url("/assets/img/hero-coffee.webp") type("image/webp"),
+      url("/assets/img/hero-coffee.jpg") type("image/jpeg"));
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+/* Newsletter: collects only an email address, with the purpose stated inline */
+.newsletter {
+  max-width: 560px;
+  margin: 60px auto 0;
+  background: white;
+  padding: 24px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+}
+
+.newsletter h2 {
+  color: var(--primary);
+  margin-bottom: 8px;
+}
+
+.newsletter label {
+  display: block;
+  font-weight: 600;
+  margin-top: 12px;
+}
+
+.newsletter input[type="email"] {
+  width: 100%;
+  font: inherit;
+  padding: 8px 10px;
+  margin-top: 4px;
+  border: 1px solid #a1887f;
+  border-radius: 4px;
+}
+
+.newsletter input[type="email"]:user-invalid {
+  border-color: #b71c1c;
+}
+
+.newsletter button {
+  font: inherit;
+  border: 0;
+  cursor: pointer;
+}
+
+.field-help {
+  font-size: 0.85rem;
+  color: #5d4037;
+  margin-top: 6px;
+}
+
+.form-status {
+  margin-top: 10px;
+  font-size: 0.9rem;
+  min-height: 1.4em;
+}
+
+.privacy-summary {
+  max-width: 700px;
+  margin: 0 auto 16px;
+  font-size: 0.85rem;
+}
+
+.gpc-notice {
+  font-size: 0.85rem;
+  margin-bottom: 12px;
+}
