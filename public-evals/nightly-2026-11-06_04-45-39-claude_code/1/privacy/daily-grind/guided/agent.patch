+# Security & privacy response headers (Netlify / Cloudflare Pages `_headers` format).
+# If you host elsewhere, port these to your server or CDN config. Policies that
+# can also be set in HTML are mirrored in <meta> tags in index.html; keep both in sync.
+# Rationale and the third-party audit are documented in PRIVACY.md.
+# HSTS starts at max-age=300: ramp it up (86400 -> 31536000) once HTTPS is verified everywhere.
+
+/*
+  Content-Security-Policy: default-src 'none'; script-src 'self' 'report-sample'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; manifest-src 'self'; worker-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests; report-to csp
+  Reporting-Endpoints: csp="/api/security-reports", conn="/api/security-reports", default="/api/security-reports"
+  Connection-Allowlist: (response-origin); redirects=allow; report-to=conn
+  Vary: Sec-Fetch-Dest
+  Referrer-Policy: strict-origin-when-cross-origin
+  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), attribution-reporting=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), compute-pressure=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), join-ad-interest-group=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(self), picture-in-picture=(), private-state-token-issuance=(), private-state-token-redemption=(), publickey-credentials-get=(self), run-ad-auction=(), screen-wake-lock=(), serial=(), storage-access=(), usb=(), web-share=(), xr-spatial-tracking=(), focus-without-user-activation=()
+  X-Frame-Options: DENY
+  X-Content-Type-Options: nosniff
+  Cross-Origin-Opener-Policy: same-origin-allow-popups
+  Cross-Origin-Resource-Policy: same-origin
+  Strict-Transport-Security: max-age=300; includeSubDomains
+  X-DNS-Prefetch-Control: off
+
+# Logging out wipes cookies and storage for this origin. ("cache" is left out
+# because clearing it on a navigation response can stall slow devices.)
+/logout
+  Clear-Site-Data: "cookies", "storage"
+  Cache-Control: no-store
+
+# Personal pages and form endpoints must never be stored by shared caches.
+/account
+  Cache-Control: no-store
+/account/*
+  Cache-Control: no-store
+/newsletter
+  Cache-Control: no-store
+/rewards
+  Cache-Control: no-store
+/order-online
+  Cache-Control: no-store
+
+/.well-known/gpc.json
+  Content-Type: application/json
+  Access-Control-Allow-Origin: *
+  Cross-Origin-Resource-Policy: cross-origin
