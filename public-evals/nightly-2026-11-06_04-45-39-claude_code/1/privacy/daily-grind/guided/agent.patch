@@ -0,0 +1,88 @@
+// The Daily Grind — first-party client script.
+//
+// Privacy-by-design rules for this file:
+//   * No third-party SDKs, analytics, fingerprinting, or UA sniffing.
+//   * Never persist personal data (emails, tokens) in localStorage/sessionStorage.
+//   * Only write to the DOM through textContent (the CSP enforces Trusted Types
+//     with no policies, so innerHTML-style sinks would throw anyway).
+//   * Network requests go to our own origin only, without referrer leakage.
+
+// 1. Strip marketing / click-tracking identifiers from the address bar so they
+//    are not bookmarked, shared onward, or exposed to later scripts.
+const TRACKING_PARAMS = /^(utm_\w+|gclid|gbraid|wbraid|dclid|fbclid|msclkid|twclid|ttclid|li_fat_id|mc_cid|mc_eid|_ga|_gl|igshid|yclid|_hsenc|_hsmi|mkt_tok)$/i;
+
+function stripTrackingParams() {
+  const url = new URL(window.location.href);
+  const keys = [...url.searchParams.keys()];
+  const tracked = keys.filter((key) => TRACKING_PARAMS.test(key));
+  if (tracked.length === 0) return;
+  for (const key of tracked) url.searchParams.delete(key);
+  history.replaceState(history.state, '', url);
+}
+
+// 2. Acknowledge Global Privacy Control. We don't sell or share data either
+//    way, but surfacing the signal tells users it's respected.
+function acknowledgeGpc() {
+  const notice = document.getElementById('gpc-notice');
+  if (!notice || navigator.globalPrivacyControl !== true) return;
+  notice.textContent =
+    'Your browser sent a Global Privacy Control signal. We honor it: your data is never sold or shared.';
+  notice.hidden = false;
+}
+
+// 3. Newsletter signup: email only, sent to our own origin, never cached
+//    client-side, and cleared from the form once submitted.
+function initNewsletter() {
+  const form = document.getElementById('newsletter-form');
+  if (!form) return;
+  const status = form.querySelector('.form-status');
+  const button = form.querySelector('button[type="submit"]');
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    const email = form.elements.email.value.trim();
+    form.elements.email.value = email;
+    if (!form.reportValidity()) return;
+
+    button.disabled = true;
+    status.textContent = 'Subscribing…';
+    try {
+      const response = await fetch(form.action, {
+        method: 'POST',
+        // Send only the single field we need, not the whole form.
+        body: new URLSearchParams({ email }),
+        credentials: 'same-origin',
+        referrerPolicy: 'no-referrer',
+        cache: 'no-store',
+      });
+      if (!response.ok) throw new Error(`HTTP ${response.status}`);
+      form.reset();
+      status.textContent = 'Thanks! Check your inbox to confirm your subscription.';
+    } catch {
+      // Don't log the email address or echo it back.
+      status.textContent = 'Sorry, we could not subscribe you right now. Please try again later.';
+    } finally {
+      button.disabled = false;
+    }
+  });
+}
+
+// 4. On logout, clear anything stored client-side. The server also responds with
+//    `Clear-Site-Data`; this is a backstop for browsers that ignore that header.
+function initLogout() {
+  const form = document.getElementById('logout-form');
+  if (!form) return;
+  form.addEventListener('submit', () => {
+    try {
+      localStorage.clear();
+      sessionStorage.clear();
+    } catch {
+      // Storage may be unavailable (e.g. blocked by the user); nothing to clear.
+    }
+  });
+}
+
+stripTrackingParams();
+acknowledgeGpc();
+initNewsletter();
+initLogout();
