+/**
+ * Privacy-related response headers applied to every response.
+ *
+ * - Referrer-Policy: never leak full URLs (which may contain article slugs,
+ *   search terms, etc.) to third-party origins.
+ * - Permissions-Policy: deny powerful features we never use and opt out of
+ *   browser-based interest/ad profiling (Topics API, FLoC, Protected Audience).
+ * - X-Content-Type-Options / X-Frame-Options: basic hardening.
+ */
+const PRIVACY_HEADERS: Record<string, string> = {
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'Permissions-Policy': [
+    'accelerometer=()',
+    'ambient-light-sensor=()',
+    'autoplay=()',
+    'bluetooth=()',
+    'browsing-topics=()',
+    'camera=()',
+    'display-capture=()',
+    'geolocation=()',
+    'gyroscope=()',
+    'hid=()',
+    'interest-cohort=()',
+    'join-ad-interest-group=()',
+    'magnetometer=()',
+    'microphone=()',
+    'payment=()',
+    'run-ad-auction=()',
+    'serial=()',
+    'usb=()',
+    'attribution-reporting=()',
+  ].join(', '),
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'SAMEORIGIN',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+};
+
+/** Pages that handle credentials must never be cached or indexed. */
+const SENSITIVE_PATHS = /\/(signin|signup)\/?$/;
+
 export const onRequest = defineMiddleware(async (context, next) => {
-  if (context.session) {
-    // Initialize the reading list if it doesn't exist
-    const readingList = await context.session.get('readingList');
-    if (readingList === undefined) {
-      await context.session.set('readingList', []);
-    }
+  // Data minimization: we intentionally do NOT create a session for every
+  // visitor. A session (and its cookie) is only created when the visitor
+  // actively adds something to their reading list (see /api/reading-list.json).
+  // All readers fall back to an empty list when no session exists.
+  const response = await next();
+
+  try {
+    applyHeaders(context.url.pathname, context.cookies.has('astro-session'), response.headers);
+  } catch {
+    // Some responses (e.g. Response.redirect) have immutable headers.
   }
-  return next();
+
+  return response;
 });
+
+function applyHeaders(pathname: string, hasSession: boolean, headers: Headers) {
+  for (const [name, value] of Object.entries(PRIVACY_HEADERS)) {
+    if (!headers.has(name)) {
+      headers.set(name, value);
+    }
+  }
+
+  if (SENSITIVE_PATHS.test(pathname)) {
+    headers.set('Cache-Control', 'no-store');
+    headers.set('X-Robots-Tag', 'noindex, nofollow');
+  }
+
+  // Per-user responses (anything that touched the session cookie) must not be
+  // stored by shared caches.
+  if (hasSession && !headers.has('Cache-Control')) {
+    headers.set('Cache-Control', 'private');
+  }
+}
