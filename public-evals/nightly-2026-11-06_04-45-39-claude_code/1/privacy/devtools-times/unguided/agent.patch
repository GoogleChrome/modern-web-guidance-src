diff --git a/src/components/ConsentManager.astro b/src/components/ConsentManager.astro
new file mode 100644
index 0000000..74ca878
--- /dev/null
+++ b/src/components/ConsentManager.astro
@@ -0,0 +1,189 @@
+---
+/**
+ * Privacy-by-design consent manager.
+ *
+ * - No third-party script is loaded before the visitor has made an explicit,
+ *   affirmative choice. The default for every optional category is "off".
+ * - Browser privacy signals (Global Privacy Control, Do Not Track) are honoured
+ *   as a refusal; we don't nag those visitors with a banner.
+ * - "Reject" is as easy as "Accept" (same prominence, one click).
+ * - The choice is stored locally only (localStorage), never sent to a server,
+ *   and can be changed or withdrawn at any time via "Manage Privacy Preferences"
+ *   in the footer.
+ */
+const baseUrl = import.meta.env.BASE_URL;
+const privacyUrl = `${baseUrl.replace(/\/?$/, '/')}legal/privacy`;
+---
+
+<div
+  id="consent-banner"
+  transition:persist
+  role="dialog"
+  aria-modal="false"
+  aria-labelledby="consent-title"
+  aria-describedby="consent-desc"
+  hidden
+  class="fixed inset-x-0 bottom-0 z-[100] border-t border-gray-300 bg-white p-4 shadow-2xl md:p-6"
+>
+  <div class="mx-auto max-w-4xl">
+    <h2 id="consent-title" class="mb-2 text-lg font-bold text-gray-900">Your privacy choices</h2>
+    <p id="consent-desc" class="mb-4 text-sm text-gray-700">
+      We use only what is strictly necessary to run this site by default. With your permission we
+      would also load an analytics service to understand which articles are read, so we can
+      improve our journalism. This service is operated by a third party and receives your IP
+      address and browser details. Nothing optional is loaded unless you say yes, and you can
+      change your mind at any time via “Manage Privacy Preferences” in the footer.
+      <a href={privacyUrl} class="underline">Read our Privacy Policy</a>.
+    </p>
+
+    <fieldset class="mb-4 space-y-2 text-sm">
+      <legend class="sr-only">Categories</legend>
+      <label class="flex items-start gap-2">
+        <input type="checkbox" checked disabled class="mt-1" />
+        <span>
+          <strong>Strictly necessary</strong> – a session cookie that only exists once you use the
+          reading list. Always on.
+        </span>
+      </label>
+      <label class="flex items-start gap-2">
+        <input type="checkbox" id="consent-analytics" class="mt-1" />
+        <span>
+          <strong>Analytics</strong> – anonymous usage statistics (third-party script). Off unless
+          you enable it.
+        </span>
+      </label>
+    </fieldset>
+
+    <div class="flex flex-wrap gap-2">
+      <button
+        type="button"
+        data-consent-action="reject"
+        class="rounded-md border border-gray-900 bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800"
+      >
+        Reject optional
+      </button>
+      <button
+        type="button"
+        data-consent-action="accept"
+        class="rounded-md border border-gray-900 bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800"
+      >
+        Accept all
+      </button>
+      <button
+        type="button"
+        data-consent-action="save"
+        class="rounded-md border border-gray-900 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100"
+      >
+        Save my choices
+      </button>
+    </div>
+  </div>
+</div>
+
+<script>
+  const STORAGE_KEY = 'dt-privacy-consent';
+  const CONSENT_VERSION = 1;
+  const ANALYTICS_SRC =
+    'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+
+  type Consent = { version: number; analytics: boolean; updatedAt: string };
+
+  const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
+  const privacySignal = nav.globalPrivacyControl === true || nav.doNotTrack === '1';
+
+  function readConsent(): Consent | null {
+    try {
+      const raw = localStorage.getItem(STORAGE_KEY);
+      if (!raw) return null;
+      const parsed = JSON.parse(raw) as Consent;
+      return parsed.version === CONSENT_VERSION ? parsed : null;
+    } catch {
+      return null;
+    }
+  }
+
+  function writeConsent(analytics: boolean) {
+    const consent: Consent = {
+      version: CONSENT_VERSION,
+      analytics,
+      updatedAt: new Date().toISOString().slice(0, 10), // date only – minimal
+    };
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(consent));
+    } catch {
+      /* storage unavailable – choice applies to this page view only */
+    }
+    return consent;
+  }
+
+  let analyticsLoaded = false;
+  function loadAnalytics() {
+    if (analyticsLoaded) return;
+    analyticsLoaded = true;
+    const s = document.createElement('script');
+    s.src = ANALYTICS_SRC;
+    s.defer = true;
+    s.referrerPolicy = 'strict-origin';
+    s.crossOrigin = 'anonymous';
+    s.dataset.astroTransitionPersist = 'analytics';
+    document.head.appendChild(s);
+  }
+
+  function apply(consent: Consent | null) {
+    if (consent?.analytics && !privacySignal) {
+      loadAnalytics();
+    } else if (analyticsLoaded) {
+      // Consent withdrawn after the script ran: a full reload guarantees the
+      // third-party code is no longer executing.
+      window.location.reload();
+    }
+  }
+
+  const banner = () => document.getElementById('consent-banner') as HTMLElement | null;
+  const analyticsBox = () => document.getElementById('consent-analytics') as HTMLInputElement | null;
+
+  function openBanner() {
+    const b = banner();
+    if (!b) return;
+    const box = analyticsBox();
+    if (box) {
+      box.checked = !!readConsent()?.analytics && !privacySignal;
+      box.disabled = privacySignal;
+    }
+    b.hidden = false;
+    (b.querySelector('button') as HTMLButtonElement | null)?.focus();
+  }
+
+  function closeBanner() {
+    const b = banner();
+    if (b) b.hidden = true;
+  }
+
+  document.addEventListener('click', (event) => {
+    const target = event.target as HTMLElement | null;
+    if (!target) return;
+
+    if (target.closest('[data-open-privacy-preferences]')) {
+      event.preventDefault();
+      openBanner();
+      return;
+    }
+
+    const actionEl = target.closest<HTMLElement>('[data-consent-action]');
+    if (!actionEl) return;
+    const action = actionEl.dataset.consentAction;
+    const analytics =
+      action === 'accept' ? true : action === 'save' ? !!analyticsBox()?.checked : false;
+    const consent = writeConsent(analytics && !privacySignal);
+    closeBanner();
+    apply(consent);
+  });
+
+  document.addEventListener('keydown', (event) => {
+    if (event.key === 'Escape' && banner() && !banner()!.hidden && readConsent()) closeBanner();
+  });
+
+  const initial = readConsent();
+  apply(initial);
+  if (!initial && !privacySignal) openBanner();
+</script>
