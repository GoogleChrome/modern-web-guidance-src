+/**
+ * Shared helpers for the credential forms.
+ *
+ * Privacy notes:
+ * - Only the minimum data needed for an account is collected: a username and a
+ *   password. No e-mail, real name, or device data is requested or sent.
+ * - Requests are sent without cookies or a Referer header and must not be cached.
+ * - Nothing (tokens, usernames, passwords) is persisted in localStorage or
+ *   sessionStorage by these forms.
+ */
+export const AUTH_API_BASE = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export const AUTH_PROVIDER_DESCRIPTION =
+  'our authentication service, hosted on Google Cloud in the United States';
+
+export async function postCredentials(
+  path: 'login' | 'register',
+  body: { username: string; password: string },
+): Promise<{ ok: boolean; code?: string }> {
+  const response = await fetch(`${AUTH_API_BASE}/${path}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body),
+    credentials: 'omit',
+    referrerPolicy: 'no-referrer',
+    cache: 'no-store',
+    mode: 'cors',
+  });
+
+  let code: string | undefined;
+  try {
+    const data = await response.json();
+    code = typeof data?.error === 'string' ? data.error : undefined;
+  } catch {
+    // Non-JSON response – ignore body.
+  }
+  return { ok: response.ok, code };
+}
+
+/** Shared props that stop browsers/extensions from leaking field contents. */
+export const privateInputProps = {
+  spellCheck: false,
+  autoCapitalize: 'none',
+  autoCorrect: 'off',
+} as const;
