 import { defineMiddleware } from 'astro:middleware';
 
+/** Origin hosting the auth API and the (opt-in) analytics client. */
+const TIMES_CDN_ORIGIN = 'https://us-central1-web-devrel-apps.cloudfunctions.net';
+
+/** Pages that handle credentials and must never be cached or shared with third parties. */
+const SENSITIVE_PATHS = /\/(signin|signup)\/?$/;
+
+/**
+ * Privacy-protective defaults applied to every response:
+ * - Referrer-Policy: never leak full URLs (paths, query strings) cross-origin.
+ * - Permissions-Policy: powerful features and Topics are off for every origin.
+ * - CSP: restrict where scripts may load from and where data may be sent.
+ */
+const PRIVACY_HEADERS: Record<string, string> = {
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'Permissions-Policy': [
+    'accelerometer=()',
+    'browsing-topics=()',
+    'camera=()',
+    'display-capture=()',
+    'geolocation=()',
+    'gyroscope=()',
+    'magnetometer=()',
+    'microphone=()',
+    'payment=()',
+    'usb=()',
+  ].join(', '),
+  'X-Content-Type-Options': 'nosniff',
+  'Content-Security-Policy': [
+    "default-src 'self'",
+    // 'unsafe-inline' is required for Astro's island hydration and view-transition scripts.
+    `script-src 'self' 'unsafe-inline' ${TIMES_CDN_ORIGIN}`,
+    `connect-src 'self' ${TIMES_CDN_ORIGIN}`,
+    "img-src 'self' data: https:",
+    "style-src 'self' 'unsafe-inline'",
+    "font-src 'self'",
+    "object-src 'none'",
+    "base-uri 'self'",
+    "form-action 'self'",
+    "frame-ancestors 'self'",
+  ].join('; '),
+};
+
+function applyPrivacyHeaders(response: Response, pathname: string) {
+  for (const [name, value] of Object.entries(PRIVACY_HEADERS)) {
+    if (!response.headers.has(name)) {
+      response.headers.set(name, value);
+    }
+  }
+
+  if (SENSITIVE_PATHS.test(pathname)) {
+    response.headers.set('Cache-Control', 'no-store');
+  }
+}
+
