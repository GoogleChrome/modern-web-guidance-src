diff --git a/src/scripts/privacy.ts b/src/scripts/privacy.ts
new file mode 100644
index 0000000..9432ecc
--- /dev/null
+++ b/src/scripts/privacy.ts
@@ -0,0 +1,123 @@
+/**
+ * Privacy-by-default loader for third-party scripts.
+ *
+ * - Analytics is OFF unless the reader explicitly opts in via
+ *   "Manage Privacy Preferences" (footer).
+ * - A Global Privacy Control signal always wins over a stored opt-in.
+ * - Pages marked with `data-sensitive` on <html> (sign in / sign up) never
+ *   load third-party scripts.
+ * - Only a non-identifying boolean preference is stored on the device.
+ */
+
+const ANALYTICS_SRC =
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+const STORAGE_KEY = 'dt-privacy-preferences';
+
+interface PrivacyPreferences {
+  analytics: boolean;
+}
+
+declare global {
+  interface Navigator {
+    globalPrivacyControl?: boolean;
+  }
+}
+
+function hasGlobalPrivacyControl(): boolean {
+  return navigator.globalPrivacyControl === true;
+}
+
+function readPreferences(): PrivacyPreferences {
+  try {
+    const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? 'null');
+    return { analytics: parsed?.analytics === true };
+  } catch {
+    return { analytics: false };
+  }
+}
+
+function writePreferences(prefs: PrivacyPreferences) {
+  try {
+    if (prefs.analytics) {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
+    } else {
+      // Nothing to remember when the reader declines: keep storage empty.
+      localStorage.removeItem(STORAGE_KEY);
+    }
+  } catch {
+    // Storage unavailable (e.g. blocked); fall back to the private default.
+  }
+}
+
+function isSensitivePage(): boolean {
+  return document.documentElement.hasAttribute('data-sensitive');
+}
+
+function analyticsAllowed(): boolean {
+  return !hasGlobalPrivacyControl() && !isSensitivePage() && readPreferences().analytics;
+}
+
+let analyticsLoaded = false;
+
+function loadAnalytics() {
+  if (analyticsLoaded || !analyticsAllowed()) return;
+  analyticsLoaded = true;
+  const script = document.createElement('script');
+  script.src = ANALYTICS_SRC;
+  script.async = true;
+  // Don't tell the analytics host which article the reader is on.
+  script.referrerPolicy = 'no-referrer';
+  document.head.append(script);
+}
+
+function syncPreferencesDialog() {
+  const dialog = document.querySelector<HTMLDialogElement>('#privacy-preferences');
+  if (!dialog) return;
+  const checkbox = dialog.querySelector<HTMLInputElement>('input[name="analytics"]');
+  const gpcNotice = dialog.querySelector<HTMLElement>('[data-gpc-notice]');
+  const gpc = hasGlobalPrivacyControl();
+  if (checkbox) {
+    checkbox.checked = !gpc && readPreferences().analytics;
+    checkbox.disabled = gpc;
+  }
+  if (gpcNotice) gpcNotice.hidden = !gpc;
+}
+
+function onPageLoad() {
+  // The analytics client attaches a document-wide click listener that cannot
+  // be removed. If it is running and we navigated (client-side) to a page
+  // that handles credentials, reload to drop it.
+  if (analyticsLoaded && isSensitivePage()) {
+    location.reload();
+    return;
+  }
+  loadAnalytics();
+}
+
+document.addEventListener('click', (event) => {
+  const target = event.target as Element | null;
+  if (target?.closest('[data-privacy-open]')) {
+    event.preventDefault();
+    syncPreferencesDialog();
+    document.querySelector<HTMLDialogElement>('#privacy-preferences')?.showModal();
+  }
+});
+
+document.addEventListener('submit', (event) => {
+  const form = event.target as HTMLFormElement | null;
+  if (form?.id !== 'privacy-preferences-form') return;
+  const wantsAnalytics =
+    form.querySelector<HTMLInputElement>('input[name="analytics"]')?.checked === true;
+  const hadAnalytics = analyticsLoaded;
+  writePreferences({ analytics: wantsAnalytics && !hasGlobalPrivacyControl() });
+  // <form method="dialog"> closes the dialog for us.
+  if (hadAnalytics && !wantsAnalytics) {
+    // Withdrawing consent must take effect immediately.
+    location.reload();
+  } else {
+    loadAnalytics();
+  }
+});
+
+// Fires on the initial load and after every client-side navigation.
+document.addEventListener('astro:page-load', onPageLoad);
