+          <li role="none"><div role="menuitemcheckbox" aria-checked="false" data-extra="Cold foam" data-price="0.80"><span class="menu-label">Sweet cream cold foam</span><span class="menu-hint">+$0.80</span></div></li>
+          <li role="none"><div role="menuitemcheckbox" aria-checked="false" data-extra="Whipped cream" data-price="0.50"><span class="menu-label">Whipped cream</span><span class="menu-hint">+$0.50</span></div></li>
+          <li role="none"><div role="menuitemcheckbox" aria-checked="false" data-extra="Cinnamon"><span class="menu-label">Cinnamon dusting</span></div></li>
+        </ul>
+      </li>
+      <li role="separator"></li>
+      <li role="none"><div role="menuitem" class="menu-primary" data-action="add"><span class="menu-label">Add to Order</span><span class="menu-hint" data-add-price></span></div></li>
+      <li role="none"><div role="menuitem" data-action="favorite"><span class="menu-label">Save as Favorite</span></div></li>
+      <li role="none"><div role="menuitem" data-action="reset"><span class="menu-label">Reset to Default</span></div></li>
+      <li role="none"><a role="menuitem" data-details href="#"><span class="menu-label">View Details</span></a></li>
+    </ul>
+  </template>
+
+  <script>
+    (() => {
+      'use strict';
+
+      const ITEM_SEL = '[role="menuitem"],[role="menuitemcheckbox"],[role="menuitemradio"]';
+      const HOVER_DELAY = 150;
+      const instances = new Set();
+
+      /**
+       * Accessible menu button with arbitrarily nested submenus
+       * (WAI-ARIA Authoring Practices "Menu Button" pattern).
+       *
+       * Markup: <button aria-haspopup="menu" aria-controls="id"> + <ul role="menu" id="id" hidden>.
+       * Each <li role="none"> holds one item (menuitem / menuitemcheckbox / menuitemradio);
+       * an item followed by a sibling <ul role="menu"> opens that submenu.
+       *
+       * Emits bubbling events on the root menu:
+       *   menu:change  – a checkbox or radio item changed state
+       *   menu:select  – a plain menuitem was activated
+       */
+      class MenuButton {
+        constructor(trigger) {
+          this.trigger = trigger;
+          this.root = document.getElementById(trigger.getAttribute('aria-controls'));
+          this.hoverTimer = null;
+          this.typeBuffer = '';
+          this.typeTimer = null;
+          this.viaKeyboard = false;
+          this.pointerType = 'mouse';
+
+          this.root.querySelectorAll(ITEM_SEL).forEach((item) => { item.tabIndex = -1; });
+          if (!this.root.hasAttribute('aria-label') && !this.root.hasAttribute('aria-labelledby')) {
+            this.root.setAttribute('aria-labelledby', trigger.id);
+          }
+
+          trigger.addEventListener('click', () => (this.isOpen() ? this.close(true) : this.open('first')));
+          trigger.addEventListener('keydown', (e) => this.onTriggerKey(e));
+          this.root.addEventListener('keydown', (e) => this.onMenuKey(e));
+          this.root.addEventListener('click', (e) => this.onMenuClick(e));
+          this.root.addEventListener('pointerover', (e) => this.onPointerOver(e));
+          this.root.addEventListener('pointerdown', (e) => { this.pointerType = e.pointerType; });
+          instances.add(this);
+        }
+
+        /* ---- structure helpers ---- */
+        isOpen() { return !this.root.hidden; }
+        itemsOf(menu) {
+          return [...menu.children]
+            .filter((li) => !li.hidden)
+            .flatMap((li) => [...li.children].filter((el) => el.matches(ITEM_SEL)));
+        }
+        submenuOf(item) {
+          const next = item.nextElementSibling;
+          return next && next.getAttribute('role') === 'menu' ? next : null;
+        }
+        parentItemOf(menu) { return menu === this.root ? null : menu.previousElementSibling; }
+        menuOf(item) { return item.closest('[role="menu"]'); }
+        contains(node) { return this.root.contains(node) || this.trigger.contains(node); }
+
+        /* ---- open / close ---- */
+        open(focus) {
+          instances.forEach((m) => { if (m !== this && m.isOpen()) m.close(false); });
+          this.root.hidden = false;
+          this.trigger.setAttribute('aria-expanded', 'true');
+          this.place(this.root);
+          this.focusIn(this.root, focus);
+        }
+
+        openSub(item, focus) {
+          const sub = this.submenuOf(item);
+          if (!sub) return;
+          this.closeSiblings(item);
+          if (sub.hidden) {
+            sub.hidden = false;
+            item.setAttribute('aria-expanded', 'true');
+            this.place(sub);
+          }
+          if (focus) this.focusIn(sub, focus);
+        }
+
+        hide(menu) {
+          menu.hidden = true;
+          menu.classList.remove('flip-x');
+          (this.parentItemOf(menu) || this.trigger).setAttribute('aria-expanded', 'false');
+        }
+
+        closeMenu(menu) {
+          menu.querySelectorAll('[role="menu"]').forEach((m) => this.hide(m));
+          this.hide(menu);
+        }
+
+        closeSiblings(item) {
+          this.itemsOf(this.menuOf(item)).forEach((other) => {
+            const sub = other !== item && this.submenuOf(other);
+            if (sub && !sub.hidden) this.closeMenu(sub);
+          });
+        }
+
+        close(returnFocus) {
+          clearTimeout(this.hoverTimer);
+          this.closeMenu(this.root);
+          if (returnFocus) this.trigger.focus();
+        }
+
+        /** Flip a menu to the other side when it would overflow the viewport. */
+        place(menu) {
+          menu.classList.remove('flip-x');
+          if (getComputedStyle(menu).position !== 'absolute') return;
+          const { right } = menu.getBoundingClientRect();
+          if (right > document.documentElement.clientWidth - 8) menu.classList.add('flip-x');
+        }
+
+        reposition() {
+          if (!this.isOpen()) return;
+          [this.root, ...this.root.querySelectorAll('[role="menu"]:not([hidden])')].forEach((m) => this.place(m));
+        }
+
+        focusIn(menu, which) {
+          const items = this.itemsOf(menu);
+          if (!items.length) return;
+          const target = which === 'last' ? items[items.length - 1] : items[0];
+          target.focus();
+        }
+
+        /* ---- keyboard ---- */
+        onTriggerKey(e) {
+          // Enter / Space fall through to the native button click.
+          if (e.key === 'ArrowDown') { e.preventDefault(); this.open('first'); }
+          else if (e.key === 'ArrowUp') { e.preventDefault(); this.open('last'); }
+          else if (e.key === 'Escape' && this.isOpen()) { e.preventDefault(); this.close(true); }
+        }
+
+        onMenuKey(e) {
+          const item = e.target.closest(ITEM_SEL);
+          if (!item || !this.root.contains(item)) return;
+          const menu = this.menuOf(item);
+          const items = this.itemsOf(menu);
+          const idx = items.indexOf(item);
+
+          switch (e.key) {
+            case 'ArrowDown': items[(idx + 1) % items.length].focus(); break;
+            case 'ArrowUp': items[(idx - 1 + items.length) % items.length].focus(); break;
+            case 'Home': case 'PageUp': items[0].focus(); break;
+            case 'End': case 'PageDown': items[items.length - 1].focus(); break;
+            case 'ArrowRight':
+              if (!this.submenuOf(item)) return;
+              this.openSub(item, 'first');
+              break;
+            case 'ArrowLeft':
+              if (menu === this.root) return;
+              this.closeMenu(menu);
+              this.parentItemOf(menu).focus();
+              break;
+            case 'Escape':
+              if (menu === this.root) {
+                this.close(true);
+              } else {
+                this.closeMenu(menu);
+                this.parentItemOf(menu).focus();
+              }
+              break;
+            case 'Enter':
+            case ' ':
+              this.viaKeyboard = true;
+              item.click();
+              this.viaKeyboard = false;
+              break;
+            case 'Tab':
+              // Move focus back to the trigger so the browser's default Tab continues from there.
+              this.trigger.focus();
+              this.close(false);
+              return;
+            default:
+              if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
+                this.typeahead(e.key, items, idx);
+                break;
+              }
+              return;
+          }
+          e.preventDefault();
+          e.stopPropagation();
+        }
+
+        typeahead(ch, items, idx) {
+          clearTimeout(this.typeTimer);
+          this.typeBuffer += ch.toLowerCase();
+          this.typeTimer = setTimeout(() => { this.typeBuffer = ''; }, 500);
+          const buf = this.typeBuffer;
+          const label = (el) => (el.querySelector('.menu-label') || el).textContent.trim().toLowerCase();
+          // A single key cycles past the current item; a longer string may still match it.
+          const start = buf.length > 1 ? idx : idx + 1;
+          const ordered = [...items.slice(start), ...items.slice(0, start)];
+          const repeated = [...buf].every((c) => c === buf[0]);
+          const match = ordered.find((el) => label(el).startsWith(buf)) ||
+            (repeated && [...items.slice(idx + 1), ...items.slice(0, idx + 1)].find((el) => label(el).startsWith(buf[0])));
+          if (match) match.focus();
+        }
+
+        /* ---- pointer ---- */
+        onPointerOver(e) {
+          if (e.pointerType !== 'mouse') return;
+          const item = e.target.closest(ITEM_SEL);
+          if (!item || !this.root.contains(item) || item.contains(e.relatedTarget)) return;
+          if (document.activeElement !== item) item.focus({ preventScroll: true });
+          clearTimeout(this.hoverTimer);
+          this.hoverTimer = setTimeout(() => {
+            if (!this.isOpen() || this.menuOf(item).hidden) return;
+            if (this.submenuOf(item)) this.openSub(item, null);
+            else this.closeSiblings(item);
+          }, HOVER_DELAY);
+        }
+
+        onMenuClick(e) {
+          const item = e.target.closest(ITEM_SEL);
+          if (!item || !this.root.contains(item)) return;
+          if (item.getAttribute('aria-disabled') === 'true') { e.preventDefault(); return; }
+
+          const sub = this.submenuOf(item);
+          if (sub) {
+            e.preventDefault();
+            clearTimeout(this.hoverTimer);
+            if (this.viaKeyboard) {
+              this.openSub(item, 'first');
+            } else {
+              // Mouse users have usually opened it by hovering, so clicking keeps it open; touch toggles.
+              if (sub.hidden || this.pointerType === 'mouse') this.openSub(item, null);
+              else this.closeMenu(sub);
+              item.focus({ preventScroll: true });
+            }
+            return;
+          }
+
+          const role = item.getAttribute('role');
+          if (role === 'menuitemcheckbox') {
+            item.setAttribute('aria-checked', String(item.getAttribute('aria-checked') !== 'true'));
+            this.emit('menu:change', item);
+            return;
+          }
+          if (role === 'menuitemradio') {
+            this.setRadio(item);
+            this.emit('menu:change', item);
+            return;
+          }
+
+          this.emit('menu:select', item);
+          this.close(true); // links continue with their native navigation
+        }
+
+        /** Radio groups are scoped to the whole menu tree, so a group may span nested submenus. */
+        setRadio(item) {
+          const group = item.dataset.group;
+          this.root.querySelectorAll('[role="menuitemradio"]').forEach((r) => {
+            if (r.dataset.group === group) r.setAttribute('aria-checked', String(r === item));
+          });
+        }
+
+        emit(type, item) {
+          this.root.dispatchEvent(new CustomEvent(type, {
+            bubbles: true,
+            detail: { item, action: item.dataset.action, group: item.dataset.group, value: item.dataset.value },
+          }));
+        }
+      }
+
+      const closeOutside = (target) => instances.forEach((m) => {
+        if (m.isOpen() && !m.contains(target)) m.close(false);
+      });
+      document.addEventListener('pointerdown', (e) => closeOutside(e.target));
+      document.addEventListener('focusin', (e) => closeOutside(e.target));
+      window.addEventListener('resize', () => instances.forEach((m) => m.reposition()));
+
+      /* ---------- Order / toast helpers ---------- */
+      const toastEl = document.getElementById('toast');
+      let toastTimer;
+      const toast = (msg) => {
+        toastEl.textContent = msg;
+        toastEl.classList.add('show');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => toastEl.classList.remove('show'), 3200);
+      };
+
+      const cartEl = document.getElementById('cart-count');
+      let cartCount = 0;
+      const addToCart = () => {
+        cartCount += 1;
+        cartEl.textContent = cartCount;
+        cartEl.setAttribute('aria-label', `${cartCount} item${cartCount === 1 ? '' : 's'} in order`);
+        cartEl.classList.remove('bump');
+        void cartEl.offsetWidth; // restart animation
+        cartEl.classList.add('bump');
+      };
+
+      const money = (n) => `$${n.toFixed(2)}`;
+
+      /* ---------- Seasonal card customization menus ---------- */
+      const template = document.getElementById('customize-template');
+
+      document.querySelectorAll('.card[data-drink]').forEach((card, n) => {
+        const drink = card.dataset.drink;
+        const basePrice = parseFloat(card.dataset.price);
+        const defaults = JSON.parse(card.dataset.defaults || '{}');
+        const slot = card.querySelector('[data-menu-slot]');
+        const frag = template.content.cloneNode(true);
+        const trigger = frag.querySelector('.menu-trigger');
+        const prefix = `customize-${n}`;
+
+        trigger.id = `${prefix}-trigger`;
+        trigger.setAttribute('aria-label', `Customize & Order ${drink}`);
+        frag.querySelectorAll('[role="menu"]').forEach((menu, i) => {
+          menu.id = `${prefix}-menu-${i}`;
+          const owner = menu.previousElementSibling;
+          (owner && owner.matches(ITEM_SEL) ? owner : trigger).setAttribute('aria-controls', menu.id);
+        });
+        frag.querySelector('[data-details]').href = card.dataset.href;
+        slot.appendChild(frag);
+
+        const root = slot.querySelector('ul[role="menu"]');
+        const menuButton = new MenuButton(trigger);
+        const summaryEl = card.querySelector('[data-summary]');
+        const priceEl = card.querySelector('[data-price-display]');
+        const addPriceEl = root.querySelector('[data-add-price]');
+
+        const selected = (group) => root.querySelector(`[role="menuitemradio"][data-group="${group}"][aria-checked="true"]`);
+        const extras = () => [...root.querySelectorAll('[role="menuitemcheckbox"][aria-checked="true"]')];
+        const delta = (els) => els.reduce((sum, el) => sum + (parseFloat(el && el.dataset.price) || 0), 0);
+        const groups = () => [...new Set([...root.querySelectorAll('[data-group]')].map((el) => el.dataset.group))];
+
+        const applyDefaults = () => {
+          groups().forEach((g) => {
+            const pick = root.querySelector(`[data-group="${g}"][data-value="${defaults[g]}"]`) ||
+              root.querySelector(`[data-group="${g}"]`);
+            menuButton.setRadio(pick);
+          });
+          root.querySelectorAll('[role="menuitemcheckbox"]').forEach((c) => c.setAttribute('aria-checked', 'false'));
+        };
+        applyDefaults();
+        // The listed price already includes the drink's default options.
+        const defaultDelta = delta(groups().map(selected));
+
+        const describe = () => {
+          const parts = [selected('size'), selected('temp')].map((el) => el.dataset.short);
+          const milk = selected('milk');
+          if (milk.dataset.value !== 'none') parts.push(`${milk.dataset.short} milk`);
+          const sweet = selected('sweet');
+          if (sweet.dataset.value !== 'none') parts.push(`${sweet.dataset.short.toLowerCase()} sweetness`);
+          const syrup = selected('syrup');
+          if (syrup.dataset.value !== 'none') parts.push(`${syrup.dataset.short} syrup`);
+          extras().forEach((x) => parts.push(x.dataset.extra));
+          return parts.join(' · ');
+        };
+
+        const price = () => basePrice - defaultDelta + delta(groups().map(selected)) + delta(extras());
+
+        const update = () => {
+          const total = money(price());
+          priceEl.textContent = total;
+          addPriceEl.textContent = total;
+          summaryEl.textContent = describe();
+          root.querySelectorAll('[data-value-for]').forEach((el) => {
+            const g = el.dataset.valueFor;
+            if (g === 'extras') {
+              const count = extras().length;
+              el.textContent = count ? `${count} added` : '';
+            } else {
+              el.textContent = selected(g).dataset.short;
+            }
+          });
+        };
+        update();
+
+        root.addEventListener('menu:change', update);
+        root.addEventListener('menu:select', (e) => {
+          switch (e.detail.action) {
+            case 'add':
+              addToCart();
+              toast(`Added ${drink} (${describe()}) — ${money(price())}`);
+              break;
+            case 'favorite':
+              toast(`Saved your ${drink} to Favorites`);
+              break;
+            case 'reset':
+              applyDefaults();
+              update();
+              toast(`${drink} reset to the house recipe`);
+              break;
+          }
+        });
+      });
+
+      /* ---------- Navigation menus ---------- */
+      document.querySelectorAll('nav .menu-trigger').forEach((trigger) => new MenuButton(trigger));
+    })();
+  </script>
+
