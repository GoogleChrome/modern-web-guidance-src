+          <li role="none"><div role="menuitemradio" aria-checked="false" data-group="sweet" data-value="light" data-short="Light"><span class="menu-label">Lightly sweet</span></div></li>
+          <li role="none"><div role="menuitemradio" aria-checked="false" data-group="sweet" data-value="regular" data-short="Regular"><span class="menu-label">Regular</span></div></li>
