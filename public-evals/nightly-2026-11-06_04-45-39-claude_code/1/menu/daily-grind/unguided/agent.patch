+              <li role="none"><div role="menuitemradio" aria-checked="false" data-group="milk" data-value="almond" data-short="Almond" data-price="0.70"><span class="menu-label">Almond</span></div></li>
+              <li role="none"><div role="menuitemradio" aria-checked="false" data-group="milk" data-value="soy" data-short="Soy" data-price="0.70"><span class="menu-label">Soy</span></div></li>
+              <li role="none"><div role="menuitemradio" aria-checked="false" data-group="milk" data-value="coconut" data-short="Coconut" data-price="0.70"><span class="menu-label">Coconut</span></div></li>
