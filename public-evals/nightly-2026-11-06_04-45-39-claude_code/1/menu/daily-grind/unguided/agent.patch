+              <li role="none"><div role="menuitemradio" aria-checked="false" data-group="syrup" data-value="vanilla" data-short="Vanilla" data-price="0.50"><span class="menu-label">Vanilla</span><span class="menu-hint">+$0.50</span></div></li>
