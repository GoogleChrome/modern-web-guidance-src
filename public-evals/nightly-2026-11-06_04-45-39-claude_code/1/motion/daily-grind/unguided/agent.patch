+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          icon: '\u{1F341}',
+          description: 'Double-shot espresso folded into velvety steamed oat milk, sweetened with pure Vermont maple syrup and finished with a dusting of cinnamon.',
+          meta: ['Seasonal', 'Dairy-free', '12 oz · $5.25', '150 mg caffeine']
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          icon: '☕',
+          description: 'Our house dark roast pulled as a rich double shot — notes of cocoa, toasted walnut, and a lingering smoky finish.',
+          meta: ['Year-round', 'Double shot · $3.50', '130 mg caffeine']
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          icon: '\u{1F9CA}',
+          description: 'Coarse-ground beans steeped in cold filtered water for 18 hours, yielding a naturally sweet, low-acid brew served over ice.',
+          meta: ['Year-round', 'Low acidity', '16 oz · $4.75', '200 mg caffeine']
+        }
+      };
+
+      var overlay = document.getElementById('drink-overlay');
+      var supportsDialog = overlay && typeof overlay.showModal === 'function';
+      var lastTrigger = null;
+      var closeFallbackTimer = null;
+
+      function fillOverlay(drink, href) {
+        document.getElementById('overlay-title').textContent = drink.name;
+        document.getElementById('overlay-description').textContent = drink.description;
+        document.getElementById('overlay-icon').textContent = drink.icon;
+        document.getElementById('overlay-link').setAttribute('href', href);
+
+        var meta = document.getElementById('overlay-meta');
+        meta.textContent = '';
+        drink.meta.forEach(function (item) {
+          var li = document.createElement('li');
+          li.textContent = item;
+          meta.appendChild(li);
+        });
+      }
+
+      function openOverlay(drink, trigger) {
+        clearTimeout(closeFallbackTimer);
+        overlay.classList.remove('is-closing');
+        lastTrigger = trigger;
+        fillOverlay(drink, trigger.getAttribute('href'));
+        if (!overlay.open) overlay.showModal();
+        body.classList.add('is-overlay-open');
+      }
+
+      function finishClose() {
+        clearTimeout(closeFallbackTimer);
+        if (!overlay.classList.contains('is-closing')) return;
+        overlay.classList.remove('is-closing');
+        if (overlay.open) overlay.close();
+      }
+
+      function closeOverlay() {
+        if (!overlay.open || overlay.classList.contains('is-closing')) return;
+        overlay.classList.add('is-closing');
+
+        var animName = getComputedStyle(overlay).animationName;
+        if (!animName || animName === 'none') {
+          finishClose();
+          return;
+        }
+        // Safety net in case animationend never arrives (e.g. element hidden).
+        closeFallbackTimer = setTimeout(finishClose, 600);
+      }
+
+      if (supportsDialog) {
+        document.querySelectorAll('[data-drink]').forEach(function (trigger) {
+          trigger.addEventListener('click', function (event) {
+            var drink = DRINKS[trigger.getAttribute('data-drink')];
+            // Let modified clicks (new tab, etc.) behave like normal links.
+            if (!drink || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
+            event.preventDefault();
+            openOverlay(drink, trigger);
+          });
+        });
+
+        overlay.addEventListener('animationend', function (event) {
+          // Only the dialog's own exit animation finalizes the close.
+          if (event.target === overlay && !event.pseudoElement && event.animationName === 'overlay-out') {
+            finishClose();
+          }
+        });
+
+        overlay.addEventListener('animationcancel', function (event) {
+          if (event.target === overlay && event.animationName === 'overlay-out') finishClose();
+        });
+
+        // Escape key: run the animated close instead of the instant native one.
+        overlay.addEventListener('cancel', function (event) {
+          event.preventDefault();
+          closeOverlay();
+        });
+
+        overlay.addEventListener('close', function () {
+          overlay.classList.remove('is-closing');
+          body.classList.remove('is-overlay-open');
+          if (lastTrigger && document.contains(lastTrigger)) lastTrigger.focus();
+          lastTrigger = null;
+        });
+
+        overlay.addEventListener('click', function (event) {
+          // Click on the backdrop (outside the dialog box) closes it.
+          if (event.target === overlay) {
+            var r = overlay.getBoundingClientRect();
+            var inside = event.clientX >= r.left && event.clientX <= r.right &&
+              event.clientY >= r.top && event.clientY <= r.bottom;
+            if (!inside) closeOverlay();
+            return;
+          }
+          if (event.target.closest('[data-close-overlay]')) closeOverlay();
+        });
+      }
+    })();
+  </script>
+
