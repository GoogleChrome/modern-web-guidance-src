+  <script>
+    (function () {
+      'use strict';
+
+      // ---- base64url helpers (fallback when JSON (de)serialization helpers are unavailable) ----
+      function b64urlToBuffer(value) {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+        const binary = atob(padded);
+        const bytes = new Uint8Array(binary.length);
+        for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function bufferToB64url(buffer) {
+        const bytes = new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function parseCreationOptions(json) {
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+        }
+        const options = Object.assign({}, json);
+        options.challenge = b64urlToBuffer(json.challenge);
+        options.user = Object.assign({}, json.user, { id: b64urlToBuffer(json.user.id) });
+        if (Array.isArray(json.excludeCredentials)) {
+          options.excludeCredentials = json.excludeCredentials.map(function (c) {
+            return Object.assign({}, c, { id: b64urlToBuffer(c.id) });
+          });
+        }
+        return options;
+      }
+
+      function credentialToJSON(credential) {
+        if (typeof credential.toJSON === 'function') {
+          try { return credential.toJSON(); } catch (_) { /* fall through */ }
+        }
+        const response = credential.response;
+        const json = {
+          id: credential.id,
+          rawId: bufferToB64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment || undefined,
+          clientExtensionResults: credential.getClientExtensionResults ? credential.getClientExtensionResults() : {},
+          response: {
+            clientDataJSON: bufferToB64url(response.clientDataJSON),
+            attestationObject: bufferToB64url(response.attestationObject)
+          }
+        };
+        if (typeof response.getTransports === 'function') json.response.transports = response.getTransports();
+        if (typeof response.getAuthenticatorData === 'function') {
+          json.response.authenticatorData = bufferToB64url(response.getAuthenticatorData());
+        }
+        if (typeof response.getPublicKey === 'function') {
+          const pk = response.getPublicKey();
+          if (pk) json.response.publicKey = bufferToB64url(pk);
+        }
+        if (typeof response.getPublicKeyAlgorithm === 'function') {
+          json.response.publicKeyAlgorithm = response.getPublicKeyAlgorithm();
+        }
+        return json;
+      }
+
+      // ---- Feature detection for conditional (automatic) passkey creation ----
+      async function supportsConditionalCreate() {
+        if (!window.PublicKeyCredential || !navigator.credentials || !navigator.credentials.create) return false;
+        if (typeof PublicKeyCredential.getClientCapabilities !== 'function') return false;
+        try {
+          const caps = await PublicKeyCredential.getClientCapabilities();
+          return !!(caps && caps.conditionalCreate);
+        } catch (_) {
+          return false;
+        }
+      }
+
+      // ---- Silent post-login passkey promotion: never surfaces any UI ----
+      async function promotePasskeySilently() {
+        try {
+          if (!(await supportsConditionalCreate())) return;
+
+          const optionsRes = await fetch('/api/register/options', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+            body: JSON.stringify({})
+          });
+          if (!optionsRes.ok) return;
+          const optionsJSON = await optionsRes.json();
+          const publicKeyJSON = optionsJSON.publicKey || optionsJSON;
+
+          const credential = await navigator.credentials.create({
+            mediation: 'conditional',
+            publicKey: parseCreationOptions(publicKeyJSON)
+          });
+          if (!credential) return;
+
+          await fetch('/api/register/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+            body: JSON.stringify(credentialToJSON(credential))
+          });
+        } catch (err) {
+          // Intentionally silent: e.g. InvalidStateError (passkey already exists),
+          // NotAllowedError (browser declined conditional creation), network errors.
+          if (window.console && console.debug) console.debug('Passkey promotion skipped:', err && err.name);
+        }
+      }
+
+      // ---- Password sign-in ----
+      const form = document.getElementById('signin-form');
+      const status = document.getElementById('signin-status');
+      const button = form.querySelector('[data-testid="signin-button"]');
+
+      function setStatus(message, isError) {
+        status.textContent = message;
+        status.classList.toggle('error', !!isError);
+      }
+
+      form.addEventListener('submit', async function (event) {
+        event.preventDefault();
+        const username = form.username.value.trim();
+        const password = form.password.value;
+        if (!username || !password) {
+          setStatus('Please enter your username and password.', true);
+          return;
+        }
+
+        button.disabled = true;
+        setStatus('Signing in…', false);
+        try {
+          const res = await fetch('/api/login', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+            body: JSON.stringify({ username: username, password: password })
+          });
+          if (!res.ok) {
+            setStatus('Sign-in failed. Please check your credentials.', true);
+            return;
+          }
+          form.password.value = '';
+          setStatus('Welcome back, ' + username + '!', false);
+
+          // Fire-and-forget: automatic passkey creation runs in the background.
+          promotePasskeySilently();
+        } catch (_) {
+          setStatus('Unable to reach the server. Please try again.', true);
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
 </body>
 
