+
+  <script type="module">
+    const form = document.getElementById('signin-form');
+    const status = document.getElementById('signin-status');
+    const button = form.querySelector('[data-testid="signin-button"]');
+
+    // Load WebAuthn JSON/capabilities polyfills for older engines; never block sign-in on it.
+    const polyfillsReady = import('https://esm.sh/webauthn-polyfills').catch(() => {});
+
+    async function signalUnknown(rpId, credentialId) {
+      if (rpId && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+        try {
+          await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+        } catch { /* ignore */ }
+      }
+    }
+
+    // Silently create a passkey after a successful password sign-in.
+    // No dialogs, prompts or error UI are shown, whatever happens.
+    async function promotePasskeySilently() {
+      try {
+        if (!window.isSecureContext || typeof window.PublicKeyCredential === 'undefined') return;
+        await polyfillsReady;
+        if (typeof PublicKeyCredential.getClientCapabilities !== 'function') return;
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalCreate !== true) return;
+
+        // Server options must include rp.id and excludeCredentials for existing passkeys.
+        const optionsRes = await fetch('/api/register/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ conditional: true }),
+        });
+        if (!optionsRes.ok) return;
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsRes.json());
+
+        let credential;
+        try {
+          credential = await navigator.credentials.create({ publicKey, mediation: 'conditional' });
+        } catch (e) {
+          if (!['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e.name)) {
+            console.debug('Conditional passkey creation failed:', e);
+          }
+          return;
+        }
+        if (!credential) return;
+
+        const encoded = credential.toJSON();
+        const rpId = publicKey.rp?.id; // Always the server-provided RP ID.
+        try {
+          const verifyRes = await fetch('/api/register/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            // Tells the server this came from conditional create (relax UP check only here).
+            body: JSON.stringify({ ...encoded, conditional: true }),
+          });
+          if (!verifyRes.ok) await signalUnknown(rpId, encoded.id);
+        } catch (err) {
+          console.debug('Passkey verification network failure:', err);
+          await signalUnknown(rpId, encoded.id);
+        }
+      } catch (err) {
+        console.debug('Passkey promotion skipped:', err);
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      status.textContent = '';
+      status.classList.remove('error');
+      button.disabled = true;
+
+      try {
+        const res = await fetch(form.action, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(Object.fromEntries(new FormData(form))),
+        });
+        if (!res.ok) throw new Error('Invalid credentials');
+
+        status.textContent = 'Signed in. Welcome back!';
+        form.reset();
+        // Fire-and-forget: register a passkey in the background.
+        promotePasskeySilently();
+      } catch {
+        status.textContent = 'Sign-in failed. Check your details and try again.';
+        status.classList.add('error');
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
 </body>
 
