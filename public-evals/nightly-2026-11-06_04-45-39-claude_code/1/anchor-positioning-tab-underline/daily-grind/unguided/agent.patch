+  <script>
+    (function () {
+      var list = document.querySelector('nav ul');
+      var indicator = list.querySelector('.nav-indicator');
+      var items = Array.prototype.slice.call(list.querySelectorAll('[data-nav-item]'));
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      var active = null;
+
+      function moveIndicator(link, animate) {
+        if (!link) {
+          indicator.style.opacity = '0';
+          return;
+        }
+        if (!animate) indicator.classList.add('no-transition');
+        indicator.style.width = link.offsetWidth + 'px';
+        indicator.style.transform = 'translateX(' + link.offsetLeft + 'px)';
+        indicator.style.opacity = '1';
+        if (!animate) {
+          void indicator.offsetWidth; // flush styles before re-enabling transitions
+          indicator.classList.remove('no-transition');
+        }
+      }
+
+      function setActive(link, animate) {
+        items.forEach(function (item) {
+          var isActive = item === link;
+          item.classList.toggle('active', isActive);
+          if (isActive) item.setAttribute('aria-current', 'page');
+          else item.removeAttribute('aria-current');
+        });
+        active = link;
+        moveIndicator(link, animate);
+      }
+
+      // Initial state: match the current URL (e.g. /menu or /menu/seasonal)
+      var path = window.location.pathname.replace(/\/+$/, '');
+      var initial = items.filter(function (item) {
+        var href = item.getAttribute('href');
+        return path === href || path.indexOf(href + '/') === 0;
+      })[0] || null;
+      setActive(initial, false);
+
+      items.forEach(function (item) {
+        item.addEventListener('click', function (e) {
+          // Let modified clicks (new tab/window) behave normally
+          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+          if (item === active) return;
+
+          e.preventDefault();
+          var href = item.href;
+          setActive(item, true);
+
+          // Navigate once the slide has finished so the transition is visible
+          var done = false;
+          function go() {
+            if (done) return;
+            done = true;
+            indicator.removeEventListener('transitionend', onEnd);
+            window.location.href = href;
+          }
+          function onEnd(ev) { if (ev.propertyName === 'transform') go(); }
+
+          if (reduceMotion) { go(); return; }
+          indicator.addEventListener('transitionend', onEnd);
+          setTimeout(go, 400); // fallback (e.g. first activation with no movement)
+        });
+      });
+
+      // Keep the indicator aligned when layout changes
+      window.addEventListener('resize', function () { moveIndicator(active, false); });
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(function () { moveIndicator(active, false); });
+      }
+    })();
+  </script>
