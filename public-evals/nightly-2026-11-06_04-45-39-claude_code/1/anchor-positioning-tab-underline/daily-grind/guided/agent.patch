+    /* Active nav indicator: an underline tethered to the active item via
+       anchor positioning, transitioning between items on change. */
+    nav ul::before {
+      content: '';
+      position: absolute;
+      position-anchor: --active-nav;
+      /* Use inset + anchor() (not position-area) so it can be transitioned. */
+      inset-block-start: calc(anchor(bottom) + 0.15lh);
+      inset-inline-start: anchor(left);
+      inset-inline-end: anchor(right);
+      block-size: 3px;
+      border-radius: 2px;
+      background: var(--accent);
+      pointer-events: none;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      nav ul::before {
+        transition: inset 0.3s ease;
+      }
+    }
+
+    nav ul li.active {
+      anchor-name: --active-nav;
+    }
+
+    nav ul li.active a {
+      color: var(--accent);
+    }
+
+    /* Fallback: static underline where anchor positioning is unsupported. */
+    @supports not (position-anchor: auto) {
+      nav ul::before {
+        display: none;
+      }
+
+      nav ul li.active a {
+        border-bottom: 3px solid var(--accent);
+        padding-bottom: 2px;
+      }
+    }
+
     .logout-link {
       border: 1px solid var(--accent);
       padding: 5px 12px;
