@@ -207,6 +249,47 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Move the active state (and its animated underline) to the clicked nav item.
+    (() => {
+      const items = [...document.querySelectorAll('nav ul li')]
+        .filter((li) => !li.querySelector('.logout-link'));
+
+      const setActive = (target) => {
+        for (const li of items) {
+          const isActive = li === target;
+          li.classList.toggle('active', isActive);
+          const link = li.querySelector('a');
+          if (isActive) link.setAttribute('aria-current', 'page');
+          else link.removeAttribute('aria-current');
+        }
+      };
+
+      // Reflect the current URL on load, if it matches a nav item.
+      const current = items.find(
+        (li) => li.querySelector('a').getAttribute('href') === location.pathname
+      );
+      if (current) setActive(current);
+
+      for (const li of items) {
+        li.querySelector('a').addEventListener('click', (event) => {
+          // Allow modified clicks (new tab/window) to behave normally.
+          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
+          event.preventDefault();
+          setActive(li);
+          history.pushState(null, '', li.querySelector('a').getAttribute('href'));
+        });
+      }
+
+      window.addEventListener('popstate', () => {
+        const match = items.find(
+          (li) => li.querySelector('a').getAttribute('href') === location.pathname
+        );
+        if (match) setActive(match);
+      });
+    })();
+  </script>
+
 </body>
 
