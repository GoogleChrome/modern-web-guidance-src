+    /* ---------- Page transitions (cross-document View Transitions) ---------- */
+    @media (prefers-reduced-motion: no-preference) {
+      @view-transition {
+        navigation: auto;
+      }
+
+      /* Keep the sticky nav steady while the page content changes */
+      nav {
+        view-transition-name: site-nav;
+      }
+
+      /* Default: gentle cross-fade for any same-origin navigation */
+      ::view-transition-old(root) {
+        animation: 250ms ease-in both vt-fade-out;
+      }
+
+      ::view-transition-new(root) {
+        animation: 350ms ease-out both vt-fade-in;
+      }
+
+      /* "next": old page slides out to the left, new page slides in from the right */
+      html:active-view-transition-type(next)::view-transition-old(root) {
+        animation: 400ms cubic-bezier(0.4, 0, 0.2, 1) both vt-slide-out-to-left;
+      }
+
+      html:active-view-transition-type(next)::view-transition-new(root) {
+        animation: 400ms cubic-bezier(0.4, 0, 0.2, 1) both vt-slide-in-from-right;
+      }
+
+      /* "previous": old page slides out to the right, new page slides in from the left */
+      html:active-view-transition-type(previous)::view-transition-old(root) {
