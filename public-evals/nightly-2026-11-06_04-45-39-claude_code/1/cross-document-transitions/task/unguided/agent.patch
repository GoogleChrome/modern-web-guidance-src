   </style>
+  <script>
+    // Apply "next" / "previous" view transition types based on the direction
+    // of travel between seasonal-favorites pages (?page=N). Only set up when
+    // the user hasn't asked for reduced motion.
+    (function () {
+      if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
+
+      function pageOf(url) {
+        if (!url) return null;
+        try {
+          var u = new URL(url, location.href);
+          if (u.origin !== location.origin) return null;
+          var path = u.pathname.replace(/\/index\.html$/, '/');
+          if (path !== '/') return null;
+          var n = parseInt(u.searchParams.get('page'), 10);
+          return n > 0 ? n : 1;
+        } catch (e) {
+          return null;
+        }
+      }
+
+      function directionFor(activation) {
+        if (!activation || !activation.from || !activation.entry) return null;
+        var from = pageOf(activation.from.url);
+        var to = pageOf(activation.entry.url);
+        if (from == null || to == null || from === to) return null;
+        return to > from ? 'next' : 'previous';
+      }
+
+      // New page: runs just before the first render of the incoming document.
+      window.addEventListener('pagereveal', function (e) {
+        if (!e.viewTransition || !window.navigation) return;
+        var type = directionFor(navigation.activation);
+        if (type) e.viewTransition.types.add(type);
+      });
+
+      // Old page: tag the outgoing snapshot with the same type.
+      window.addEventListener('pageswap', function (e) {
+        if (!e.viewTransition) return;
+        var type = directionFor(e.activation);
+        if (type) e.viewTransition.types.add(type);
+      });
+    })();
+  </script>
