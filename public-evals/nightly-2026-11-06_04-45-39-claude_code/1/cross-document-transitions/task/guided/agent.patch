+  <script>
+    // Apply directional view-transition types on cross-document navigations.
+    // Must run in <head> (render-blocking) so the listener exists before pagereveal fires.
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      const DIRECTION_KEY = 'vt-direction';
+
+      const pageOf = (url) => {
+        try {
+          const n = parseInt(new URL(url, location.href).searchParams.get('page'), 10);
+          return Number.isFinite(n) && n > 0 ? n : 1;
+        } catch {
+          return 1;
+        }
+      };
+
+      // Fallback for browsers without the Navigation API: remember which
+      // pagination link was clicked so the next page knows the direction.
+      document.addEventListener('click', (e) => {
+        const link = e.target.closest('a#next, a#previous');
+        if (link) sessionStorage.setItem(DIRECTION_KEY, link.id);
+      });
+
+      window.addEventListener('pagereveal', (e) => {
+        if (!e.viewTransition) return;
+
+        let type = null;
+        const activation = window.navigation?.activation;
+        if (activation?.from && activation?.entry) {
+          const from = pageOf(activation.from.url);
+          const to = pageOf(activation.entry.url);
+          if (to > from) type = 'next';
+          else if (to < from) type = 'previous';
+        } else {
+          type = sessionStorage.getItem(DIRECTION_KEY);
+        }
+        sessionStorage.removeItem(DIRECTION_KEY);
+
+        if (type === 'next' || type === 'previous') {
+          e.viewTransition.types.add(type);
+        }
+      });
+    }
+  </script>
