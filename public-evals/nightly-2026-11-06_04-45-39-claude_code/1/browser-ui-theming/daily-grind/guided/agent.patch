+        shots.style.setProperty('--attr-max', shots.max);
+        shots.style.setProperty('--control-value', shots.value);
+        const label = `${shots.value} shot${shots.value === '1' ? '' : 's'}`;
+        shotsValue.textContent = label;
+        shots.setAttribute('aria-valuetext', label);
+      }
+
+      function updateTotal() {
+        let sum = priceOf(drink.selectedOptions[0]) + priceOf(milk.selectedOptions[0]);
+        sum += priceOf(form.querySelector('input[name="size"]:checked'));
+        sum += Math.max(0, shots.valueAsNumber - 2) * 0.75;
+        form.querySelectorAll('input[name="extras"]:checked').forEach((el) => { sum += priceOf(el); });
+        total.value = money.format(sum);
+      }
+
+      form.addEventListener('input', () => {
+        syncSlider();
+        updateTotal();
+        status.textContent = '';
+      });
+      form.addEventListener('change', updateTotal);
+
+      // "Customize" buttons on Seasonal Favorites preselect the drink.
+      document.querySelectorAll('[data-drink]').forEach((link) => {
+        link.addEventListener('click', () => {
+          drink.value = link.dataset.drink;
+          updateTotal();
+        });
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const submit = form.querySelector('button[type="submit"]');
+        submit.disabled = true;
+        // Demo only: in production POST new FormData(form) to the action URL.
+        status.textContent = `Thanks, ${form.elements.name.value}! Your ${drink.selectedOptions[0].value.replace(/-/g, ' ')} will be ready at ${form.elements.pickup_time.value}.`;
+        setTimeout(() => { submit.disabled = false; }, 1500);
+      });
+
+      syncSlider();
+      updateTotal();
+    })();
+  </script>
+
