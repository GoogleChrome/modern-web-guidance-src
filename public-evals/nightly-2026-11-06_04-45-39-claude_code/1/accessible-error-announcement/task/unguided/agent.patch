+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var errorEl = document.getElementById('newsletter-email-error');
+      var successEl = document.getElementById('newsletter-success');
+      // Errors only become visible after the user has interacted (blur or submit).
+      var touched = false;
+
+      function getError() {
+        var value = input.value.trim();
+        if (!value) return 'Please enter your email address.';
+        if (input.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+          return 'Please enter a valid email address, like name@example.com.';
+        }
+        return '';
+      }
+
+      // Single source of truth: the visual error, aria-invalid and the live
+      // region text are always updated together.
+      function render(message) {
+        if (message) {
+          input.setAttribute('aria-invalid', 'true');
+          // Only touch the live region when the text actually changes, to avoid
+          // re-announcing the same error on every keystroke.
+          if (errorEl.textContent !== message) errorEl.textContent = message;
+        } else {
+          input.removeAttribute('aria-invalid');
+          if (errorEl.textContent !== '') errorEl.textContent = '';
+        }
+      }
+
+      input.addEventListener('blur', function () {
+        // Don't flag an untouched empty field just because focus passed through it.
+        if (!touched && input.value.trim() === '') return;
+        touched = true;
+        render(getError());
+      });
+
+      input.addEventListener('input', function () {
+        successEl.textContent = '';
+        if (!touched) return;
+        var message = getError();
+        if (!message) {
+          // Clear immediately once valid, both visually and for assistive tech.
+          render('');
+        } else if (errorEl.textContent) {
+          // Already showing an error: keep it in sync with the current problem.
+          render(message);
+        }
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        touched = true;
+        var message = getError();
+        render(message);
+        if (message) {
+          input.focus();
+          return;
+        }
+        successEl.textContent = 'Thanks for subscribing! Check your inbox to confirm.';
+        form.reset();
+        touched = false;
+        render('');
+      });
+    })();
+  </script>
