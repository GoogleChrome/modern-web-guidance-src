+  <script>
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const email = document.getElementById('newsletter-email');
+      const error = document.getElementById('newsletter-email-error');
+      const success = document.getElementById('newsletter-success');
+
+      const messageFor = (input) => {
+        if (input.validity.valueMissing) return 'Please enter your email address.';
+        return 'Please enter a valid email address, like you@example.com.';
+      };
+
+      // Mirror the browser's interaction-aware :user-invalid state (which drives
+      // the visual error) into aria-invalid and the live region, so assistive
+      // tech announces the error exactly when it becomes visible and the
+      // announcement is cleared as soon as the email is valid.
+      const sync = () => {
+        if (email.matches(':user-invalid')) {
+          email.setAttribute('aria-invalid', 'true');
+          const msg = messageFor(email);
+          // Only touch the live region when the text actually changes,
+          // so each keystroke doesn't re-announce the same error.
+          if (error.textContent !== msg) error.textContent = msg;
+        } else {
+          email.removeAttribute('aria-invalid');
+          if (error.textContent) error.textContent = '';
+        }
+      };
+
+      email.addEventListener('blur', sync);
+      email.addEventListener('input', () => {
+        if (success.textContent) success.textContent = '';
+        sync();
+      });
+      // Fires on a submit attempt with an invalid value; :user-invalid matches by then.
+      email.addEventListener('invalid', () => requestAnimationFrame(sync));
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        sync();
+        if (!email.checkValidity()) return;
+        // Placeholder for a real subscribe request.
+        form.reset();
+        sync();
+        success.textContent = "Thanks! You're on the list.";
+      });
+    })();
+  </script>
