+++ b/js/prefs.js
@@ -0,0 +1,60 @@
+// User configuration, persisted per-origin in localStorage.
+// Storage does NOT follow an app across origins, so js/migration.js carries
+// this object from the legacy origin to the new one.
+export const PREFS_KEY = 'dg-prefs';
+export const PREFS_VERSION = 1;
+
+export const OPTIONS = Object.freeze({
+  milk: ['whole', 'skim', 'oat', 'almond', 'soy', 'none'],
+  size: ['small', 'medium', 'large'],
+  theme: ['system', 'light', 'dark'],
+  homeStore: ['', 'downtown', 'riverside', 'uptown', 'airport'],
+});
+
+export const DEFAULTS = Object.freeze({
+  v: PREFS_VERSION,
+  updatedAt: 0,
+  displayName: '',
+  homeStore: '',
+  milk: 'whole',
+  size: 'medium',
+  theme: 'system',
+  orderReadyNotifications: false,
+});
+
+// Whitelist + type-check every field. Used for both local reads and anything
+// arriving from another origin, so malformed or hostile input can't inject
+// unexpected keys/values.
+export function sanitize(raw) {
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return null;
+  const out = { ...DEFAULTS };
+  if (typeof raw.displayName === 'string') out.displayName = raw.displayName.slice(0, 40).trim();
+  for (const key of Object.keys(OPTIONS)) {
+    if (OPTIONS[key].includes(raw[key])) out[key] = raw[key];
+  }
+  if (typeof raw.orderReadyNotifications === 'boolean') out.orderReadyNotifications = raw.orderReadyNotifications;
+  const t = Number(raw.updatedAt);
+  // Clamp to "now" so a forged future timestamp can't win every merge.
+  out.updatedAt = Number.isFinite(t) && t > 0 ? Math.min(t, Date.now()) : 0;
+  return out;
+}
+
+export function hasStoredPrefs() {
+  try { return localStorage.getItem(PREFS_KEY) !== null; } catch { return false; }
+}
+
+export function loadPrefs() {
+  try {
+    const raw = localStorage.getItem(PREFS_KEY);
+    return (raw && sanitize(JSON.parse(raw))) || { ...DEFAULTS };
+  } catch {
+    return { ...DEFAULTS };
+  }
+}
+
+export function savePrefs(prefs, { touch = true } = {}) {
+  const clean = sanitize(prefs) || { ...DEFAULTS };
+  if (touch) clean.updatedAt = Date.now();
+  try { localStorage.setItem(PREFS_KEY, JSON.stringify(clean)); } catch { /* storage unavailable */ }
+  return clean;
+}
