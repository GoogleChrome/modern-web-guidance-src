index 0000000..282fa64
--- /dev/null
+++ b/scripts/build-migration.mjs
@@ -0,0 +1,94 @@
+#!/usr/bin/env node
+// Generates every origin-dependent artifact from migration.config.json so the
+// legacy and new origins can never drift apart:
+//   manifest.webmanifest                       -> served by the NEW origin
+//   manifest-legacy.webmanifest                -> served by the LEGACY origin
+//   .well-known/web-app-origin-association     -> served by the LEGACY origin
+//   js/origins.js                              -> runtime config for both
+import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const cfg = JSON.parse(readFileSync(resolve(root, 'migration.config.json'), 'utf8'));
+
+for (const key of ['legacyOrigin', 'newOrigin']) {
+  const u = new URL(cfg[key]);
+  if (u.origin !== cfg[key]) throw new Error(`${key} must be a bare origin, got ${cfg[key]}`);
+}
+if (cfg.legacyOrigin === cfg.newOrigin) throw new Error('legacyOrigin and newOrigin must differ');
+
+const legacyId = new URL(cfg.appId, cfg.legacyOrigin).href;
+const newId = new URL(cfg.appId, cfg.newOrigin).href;
+
+const icons = [
+  { src: '/icons/icon-192.png', sizes: '192x192', type: 'image/png', purpose: 'any' },
+  { src: '/icons/icon-512.png', sizes: '512x512', type: 'image/png', purpose: 'any' },
+  { src: '/icons/icon-maskable-512.png', sizes: '512x512', type: 'image/png', purpose: 'maskable' },
+];
+
+// Shortcut URLs are kept identical (relative paths) on both origins so the
+// OS-level shortcuts recreated by the browser during migration land on the
+// same screens they always did.
+const shortcuts = cfg.shortcuts.map((s) => ({
+  name: s.name,
+  short_name: s.short_name,
+  description: s.description,
+  url: s.url,
+  icons: [{ src: '/' + s.icon, sizes: '96x96', type: 'image/png' }],
+}));
+
+const base = {
+  id: cfg.appId,
+  name: cfg.name,
+  short_name: cfg.short_name,
+  description: cfg.description,
+  start_url: '/',
+  scope: '/',
+  display: 'standalone',
+  theme_color: cfg.theme_color,
+  background_color: cfg.background_color,
+  icons,
+  shortcuts,
+};
+
+const newManifest = {
+  ...base,
+  // Claims the previously installed app so the browser can migrate it
+  // (keeping OS shortcuts, dock/taskbar pins, permissions where supported).
+  migrate_from: [{ id: legacyId, behavior: cfg.migrationBehavior }],
+};
+
+const legacyManifest = {
+  ...base,
+  // Points the installed legacy app at its replacement.
+  migrate_to: { id: newId, install_url: new URL('/', cfg.newOrigin).href },
+};
+
+// Hosted on the legacy origin: the legacy origin vouches that the new app is
+// allowed to take over its installation.
+const association = { [newId]: { allow_migration: true } };
+
+// Classic (non-module) script loaded synchronously in <head> so the correct
+// manifest is linked before the browser looks for it.
+const originsJs = `// GENERATED by scripts/build-migration.mjs from migration.config.json. Do not edit.
+(function () {
+  var cfg = { legacyOrigin: ${JSON.stringify(cfg.legacyOrigin)}, newOrigin: ${JSON.stringify(cfg.newOrigin)} };
+  cfg.isLegacy = location.origin === cfg.legacyOrigin;
+  window.DG_ORIGINS = Object.freeze(cfg);
+  var link = document.querySelector('link[rel="manifest"]');
+  if (link && cfg.isLegacy) link.setAttribute('href', '/manifest-legacy.webmanifest');
+})();
+`;
+
+const write = (rel, content) => {
+  const p = resolve(root, rel);
+  mkdirSync(dirname(p), { recursive: true });
+  writeFileSync(p, typeof content === 'string' ? content : JSON.stringify(content, null, 2) + '\n');
+  console.log('wrote', rel);
+};
+
+write('manifest.webmanifest', newManifest);
+write('manifest-legacy.webmanifest', legacyManifest);
+write('.well-known/web-app-origin-association', association);
+write('js/origins.js', originsJs);
