@@ -0,0 +1,78 @@
+import { runMigration } from './migration.js';
+import { loadPrefs, savePrefs, OPTIONS } from './prefs.js';
+
+const migration = runMigration();
+
+function applyPrefs(p) {
+  const root = document.documentElement;
+  if (p.theme === 'system') root.removeAttribute('data-theme');
+  else root.setAttribute('data-theme', p.theme);
+
+  const greeting = document.getElementById('greeting');
+  const store = OPTIONS.homeStore.includes(p.homeStore) && p.homeStore
+    ? document.querySelector(`#pref-store option[value="${p.homeStore}"]`)?.textContent
+    : '';
+  greeting.textContent = p.displayName
+    ? `Welcome back, ${p.displayName}!${store ? ` Your usual ${p.size} ${p.milk === 'none' ? 'black' : p.milk + ' milk'} coffee at ${store}?` : ''}`
+    : '';
+  greeting.hidden = !p.displayName;
+}
+
+function toast(msg) {
+  const el = document.getElementById('toast');
+  el.textContent = msg;
+  el.hidden = false;
+  clearTimeout(toast.t);
+  toast.t = setTimeout(() => { el.hidden = true; }, 4000);
+}
+
+function initPrefsDialog() {
+  const dialog = document.getElementById('prefs-dialog');
+  const form = document.getElementById('prefs-form');
+  const fields = {
+    displayName: form.elements.displayName,
+    homeStore: form.elements.homeStore,
+    milk: form.elements.milk,
+    size: form.elements.size,
+    theme: form.elements.theme,
+    orderReadyNotifications: form.elements.orderReadyNotifications,
+  };
+
+  document.getElementById('open-prefs').addEventListener('click', () => {
+    const p = loadPrefs();
+    for (const [k, el] of Object.entries(fields)) {
+      if (el.type === 'checkbox') el.checked = p[k];
+      else el.value = p[k];
+    }
+    dialog.showModal();
+  });
+
+  document.getElementById('cancel-prefs').addEventListener('click', () => dialog.close());
+
+  form.addEventListener('submit', (e) => {
+    e.preventDefault();
+    const next = {};
+    for (const [k, el] of Object.entries(fields)) next[k] = el.type === 'checkbox' ? el.checked : el.value;
+    applyPrefs(savePrefs(next));
+    dialog.close();
+    toast('Preferences saved');
+  });
+}
+
+function initMovedBanner() {
+  if (!migration.showMovedBanner) return;
+  const banner = document.getElementById('moved-banner');
+  banner.hidden = false;
+  document.getElementById('move-now').addEventListener('click', migration.moveNow);
+}
+
+if (!migration.redirecting) {
+  initPrefsDialog();
+  initMovedBanner();
+  applyPrefs(loadPrefs());
+  if (migration.imported) toast('Your preferences were carried over to the new app.');
+
+  if ('serviceWorker' in navigator) {
+    navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
+  }
+}
diff --git a/js/migration.js b/js/migration.js
new file mode 100644
index 0000000..80141a1
--- /dev/null
+++ b/js/migration.js
@@ -0,0 +1,162 @@
+// Origin migration for the installed web app.
+//
+// Two separate things have to move when the app changes origin:
+//
+// 1. The installation itself (window, OS shortcuts / jump-list entries, dock
+//    and taskbar pins). That is done by the browser, driven by `migrate_to`
+//    in manifest-legacy.webmanifest, `migrate_from` in manifest.webmanifest,
+//    and /.well-known/web-app-origin-association on the legacy origin.
+//    Shortcut names/URLs are identical in both manifests so the recreated OS
+//    shortcuts keep pointing at the same screens.
+//
+// 2. User configuration. localStorage is origin-scoped and never migrates, so
+//    we hand it over with top-level navigations carrying the data in the URL
+//    *fragment* (never sent to any server). Iframe/postMessage bridges are
+//    avoided on purpose: third-party storage partitioning would hand the
+//    iframe an empty, partitioned localStorage.
+//
+//    a) Push:  legacy page -> NEW_ORIGIN/<same path>#dg-import=<payload>
+//    b) Pull:  a freshly migrated app on the new origin with no prefs makes
+//              one round trip: NEW -> LEGACY/?dg-export=<nonce>&dg-return=<path>
+//              -> NEW/<path>#dg-import=<payload>&dg-nonce=<nonce>
+import { loadPrefs, hasStoredPrefs, savePrefs, sanitize } from './prefs.js';
+
+const { legacyOrigin: LEGACY_ORIGIN, newOrigin: NEW_ORIGIN, isLegacy } = window.DG_ORIGINS;
+
+const CHECKED_KEY = 'dg-migration-checked';
+const NONCE_KEY = 'dg-export-nonce';
+// Flip to false once the legacy origin is retired so the pull round trip is
+// never attempted against a dead host.
+const LEGACY_BRIDGE_ACTIVE = true;
+
+export const isStandalone = () =>
+  matchMedia('(display-mode: standalone)').matches ||
+  matchMedia('(display-mode: window-controls-overlay)').matches ||
+  navigator.standalone === true;
+
+// ---- encoding -------------------------------------------------------------
+function encode(obj) {
+  const bytes = new TextEncoder().encode(JSON.stringify(obj));
+  let bin = '';
+  for (const b of bytes) bin += String.fromCharCode(b);
+  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+function decode(str) {
+  if (typeof str !== 'string' || str.length > 4096) return null;
+  try {
+    const b64 = str.replace(/-/g, '+').replace(/_/g, '/');
+    const bin = atob(b64 + '==='.slice((b64.length + 3) % 4));
+    return JSON.parse(new TextDecoder().decode(Uint8Array.from(bin, (c) => c.charCodeAt(0))));
+  } catch {
+    return null;
+  }
+}
+
+// Only same-site relative paths are accepted as return targets; this keeps
+// the legacy exporter from becoming an open redirect.
+function safePath(p) {
+  if (typeof p !== 'string' || !p.startsWith('/') || p.startsWith('//') || p.includes('\\')) return '/';
+  try {
+    const u = new URL(p, NEW_ORIGIN);
+    return u.origin === NEW_ORIGIN ? u.pathname + u.search : '/';
+  } catch {
+    return '/';
+  }
+}
+
+function currentPath() {
+  const params = new URLSearchParams(location.search);
+  params.delete('dg-export');
+  params.delete('dg-return');
+  const qs = params.toString();
+  return location.pathname + (qs ? '?' + qs : '');
+}
+
+function handoffUrl(path, extra = {}) {
+  const frag = new URLSearchParams({ 'dg-import': encode(loadPrefs()), ...extra });
+  return NEW_ORIGIN + safePath(path) + '#' + frag.toString();
+}
+
+// ---- legacy origin --------------------------------------------------------
+function runLegacy() {
+  const params = new URLSearchParams(location.search);
+  const exportNonce = params.get('dg-export');
+
+  // (b) Pull request from the new origin: answer immediately.
+  if (exportNonce !== null) {
+    const nonce = /^[A-Za-z0-9_-]{8,64}$/.test(exportNonce) ? exportNonce : '';
+    location.replace(handoffUrl(params.get('dg-return') || '/', nonce ? { 'dg-nonce': nonce } : {}));
+    return { redirecting: true };
+  }
+
+  // Installed legacy app: stay put long enough for the browser to read the
+  // legacy manifest (migrate_to) and offer its native migration, which is
+  // what preserves the OS-level shortcuts. Offer a manual path too.
+  if (isStandalone()) return { redirecting: false, showMovedBanner: true, moveNow: () => location.replace(handoffUrl(currentPath())) };
+
+  // (a) Regular browser tab: just move the user, carrying their settings.
+  location.replace(handoffUrl(currentPath()));
+  return { redirecting: true };
+}
+
+// ---- new origin -----------------------------------------------------------
+function importFromFragment() {
+  if (!location.hash.includes('dg-import=')) return null;
+  const frag = new URLSearchParams(location.hash.slice(1));
+  const payload = frag.get('dg-import');
+  const nonce = frag.get('dg-nonce');
+  frag.delete('dg-import');
+  frag.delete('dg-nonce');
+  // Strip the payload from the address bar / history right away.
+  const rest = frag.toString();
+  history.replaceState(history.state, '', location.pathname + location.search + (rest ? '#' + rest : ''));
+
+  let expected = null;
+  try { expected = sessionStorage.getItem(NONCE_KEY); sessionStorage.removeItem(NONCE_KEY); } catch {}
+  const requested = Boolean(nonce && expected && nonce === expected);
+
+  const incoming = sanitize(decode(payload));
+  try { localStorage.setItem(CHECKED_KEY, '1'); } catch {}
+  if (!incoming) return { imported: false };
+
+  // Unsolicited payloads (anyone can craft a link) may only seed an empty
+  // profile; they never overwrite settings the user already has here. A
+  // payload we asked for ourselves may replace older local settings.
+  const local = loadPrefs();
+  const shouldImport = !hasStoredPrefs() || (requested && incoming.updatedAt > local.updatedAt);
+  if (shouldImport) savePrefs(incoming, { touch: false });
+  return { imported: shouldImport };
+}
+
+function maybePullFromLegacy() {
+  if (!LEGACY_BRIDGE_ACTIVE || !isStandalone() || hasStoredPrefs()) return false;
+  try {
+    if (localStorage.getItem(CHECKED_KEY)) return false;
+    // Mark before leaving so an unreachable legacy origin can't cause a loop.
+    localStorage.setItem(CHECKED_KEY, '1');
+    const nonce = crypto.randomUUID().replace(/-/g, '');
+    sessionStorage.setItem(NONCE_KEY, nonce);
+    const url = new URL('/', LEGACY_ORIGIN);
+    url.searchParams.set('dg-export', nonce);
+    url.searchParams.set('dg-return', currentPath());
+    location.replace(url.href);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+function runNew() {
+  const result = importFromFragment();
+  if (result) return { redirecting: false, imported: result.imported };
+  return { redirecting: maybePullFromLegacy(), imported: false };
+}
+
+export function runMigration() {
+  // Any origin that is neither (e.g. localhost during development) behaves
+  // like the new origin but never contacts the legacy one.
+  if (isLegacy) return runLegacy();
+  if (location.origin !== NEW_ORIGIN) return { redirecting: false, imported: Boolean(importFromFragment()?.imported) };
+  return runNew();
+}
