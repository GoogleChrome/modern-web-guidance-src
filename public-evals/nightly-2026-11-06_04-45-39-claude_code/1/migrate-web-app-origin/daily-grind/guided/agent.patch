diff --git a/migrate-settings.js b/migrate-settings.js
new file mode 100644
index 0000000..e9dd64c
--- /dev/null
+++ b/migrate-settings.js
@@ -0,0 +1,53 @@
+// Imports user configuration from the previous origin of this installed app.
+//
+// Web App Origin Migration only moves the *installation* (shortcuts, icons,
+// OS integration). Origin-bound storage is NOT transferred, so on first launch
+// at the new origin we pull the user's saved settings from a small bridge page
+// hosted on the old origin. Both origins are same-site, so the embedded bridge
+// reads the old origin's unpartitioned localStorage.
+const OLD_ORIGIN = 'https://www.dailygrind.coffee';
+const BRIDGE_URL = `${OLD_ORIGIN}/migration-bridge.html`;
+const DONE_KEY = 'dailygrind.settingsMigrated';
+const TIMEOUT_MS = 5000;
+
+function importSettings() {
+  if (location.origin === OLD_ORIGIN || localStorage.getItem(DONE_KEY)) return;
+
+  const iframe = document.createElement('iframe');
+  iframe.src = BRIDGE_URL;
+  iframe.hidden = true;
+  iframe.title = 'Settings migration';
+
+  const cleanup = () => {
+    window.removeEventListener('message', onMessage);
+    clearTimeout(timer);
+    iframe.remove();
+  };
+
+  function onMessage(event) {
+    // Only trust messages from the old origin's bridge frame.
+    if (event.origin !== OLD_ORIGIN || event.source !== iframe.contentWindow) return;
+    const { type, settings } = event.data ?? {};
+    if (type !== 'dailygrind:settings' || typeof settings !== 'object' || settings === null) return;
+
+    for (const [key, value] of Object.entries(settings)) {
+      // Don't clobber anything the user already changed on the new origin.
+      if (typeof key === 'string' && typeof value === 'string' && localStorage.getItem(key) === null) {
+        localStorage.setItem(key, value);
+      }
+    }
+    localStorage.setItem(DONE_KEY, new Date().toISOString());
+    cleanup();
+    window.dispatchEvent(new CustomEvent('dailygrind:settings-imported'));
+  }
+
+  // If the old origin is unreachable, give up quietly and retry next launch.
+  const timer = setTimeout(cleanup, TIMEOUT_MS);
+  window.addEventListener('message', onMessage);
+  iframe.addEventListener('load', () => {
+    iframe.contentWindow.postMessage({ type: 'dailygrind:request-settings' }, OLD_ORIGIN);
+  });
+  document.body.append(iframe);
+}
+
+importSettings();
