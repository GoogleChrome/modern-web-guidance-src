diff --git a/legacy-origin/migration-banner.js b/legacy-origin/migration-banner.js
new file mode 100644
index 0000000..96988fc
--- /dev/null
+++ b/legacy-origin/migration-banner.js
@@ -0,0 +1,33 @@
+// Fallback for browsers without Web App Origin Migration (Firefox, Safari,
+// older Chromium): tell users on the old origin that the app has moved.
+// Include on every old-origin page: <script src="/migration-banner.js" defer></script>
+const NEW_URL = 'https://order.dailygrind.coffee/';
+const DISMISS_KEY = 'dailygrind.moveBannerDismissed';
+
+if (!sessionStorage.getItem(DISMISS_KEY)) {
+  const banner = document.createElement('aside');
+  banner.setAttribute('role', 'region');
+  banner.setAttribute('aria-label', 'The Daily Grind has moved');
+  banner.style.cssText =
+    'position:sticky;top:0;z-index:2000;display:flex;gap:1rem;align-items:center;justify-content:center;' +
+    'flex-wrap:wrap;padding:.75rem 1rem;background:#ffab40;color:#3e2723;font:inherit;text-align:center';
+
+  const text = document.createElement('p');
+  text.textContent = 'The Daily Grind app has a new home. Open it there and install it again to keep your shortcuts.';
+
+  const link = document.createElement('a');
+  link.href = NEW_URL + location.pathname.slice(1) + location.search;
+  link.textContent = 'Go to the new app';
+  link.style.cssText = 'color:#3e2723;font-weight:bold';
+
+  const close = document.createElement('button');
+  close.type = 'button';
+  close.textContent = 'Dismiss';
+  close.addEventListener('click', () => {
+    sessionStorage.setItem(DISMISS_KEY, '1');
+    banner.remove();
+  });
+
+  banner.append(text, link, close);
+  document.body.prepend(banner);
+}
diff --git a/legacy-origin/migration-bridge.html b/legacy-origin/migration-bridge.html
new file mode 100644
index 0000000..127ce00
--- /dev/null
+++ b/legacy-origin/migration-bridge.html
@@ -0,0 +1,27 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <title>The Daily Grind settings bridge</title>
+  <!-- Serve with: Content-Security-Policy: frame-ancestors https://order.dailygrind.coffee -->
+</head>
+<body>
+<script>
+  // Hands the user's saved configuration to the app's new origin.
+  // Only answers the new origin; never echoes data to anyone else.
+  const NEW_ORIGIN = 'https://order.dailygrind.coffee';
+  // Keys that hold user configuration (not auth tokens or caches).
+  const SETTINGS_PREFIX = 'dailygrind.';
+
+  window.addEventListener('message', (event) => {
+    if (event.origin !== NEW_ORIGIN || event.data?.type !== 'dailygrind:request-settings') return;
+    const settings = {};
+    for (let i = 0; i < localStorage.length; i++) {
+      const key = localStorage.key(i);
+      if (key.startsWith(SETTINGS_PREFIX)) settings[key] = localStorage.getItem(key);
+    }
+    event.source.postMessage({ type: 'dailygrind:settings', settings }, NEW_ORIGIN);
+  });
+</script>
+</body>
+</html>
