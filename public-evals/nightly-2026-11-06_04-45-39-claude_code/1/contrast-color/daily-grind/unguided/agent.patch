       --light: #fafafa;
     }
 
+    /*
+     * Auto-contrast text colors.
+     * Each themed surface declares the background it paints in --surface-bg,
+     * and --on-surface resolves to pure black or white, whichever contrasts
+     * more with that background. Because the variables are declared on the
+     * surface elements themselves (not on :root), they re-resolve whenever
+     * --primary / --secondary change at any level of the cascade.
+     *
+     * Fallback chain:
+     *   1. static colors (matching the default theme) for old browsers
+     *   2. relative color syntax: LCH lightness ~49.44 is the point where
+     *      black and white have equal WCAG contrast; multiplying the distance
+     *      by a huge number clamps the result to L=0 (black) or L=100 (white)
+     *   3. native contrast-color() where supported
+     */
+    nav,
+    .btn,
+    footer {
+      --on-surface: var(--surface-fallback-text);
+    }
+
+    @supports (color: lch(from white l c h)) {
+      nav,
+      .btn,
+      footer {
+        --on-surface: lch(from var(--surface-bg) calc((49.44 - l) * 1000) 0 0);
+      }
+    }
+
+    @supports (color: contrast-color(white)) {
+      nav,
+      .btn,
+      footer {
+        --on-surface: contrast-color(var(--surface-bg));
+      }
+    }
+
