diff --git a/index.html b/index.html
index 1bacf96..c463518 100644
--- a/index.html
+++ b/index.html
@@ -14,6 +14,38 @@
       --light: #fafafa;
     }
 
+    /*
+     * Auto-contrast text for themed surfaces.
+     * Each surface sets --surface to its background color; text color is
+     * derived from it so it stays readable (black or white) whenever
+     * --primary / --secondary are changed at runtime.
+     * Fallback chain: static color -> relative color syntax -> contrast-color().
+     */
+    nav,
+    .btn,
+    footer {
+      background-color: var(--surface);
+      color: var(--on-surface-fallback, white);
+    }
+
+    @supports (color: oklch(from red max(0, sign(0.5 - l)) 0 h)) {
+      nav,
+      .btn,
+      footer {
+        /* Highest OKLCH lightness threshold that still passes WCAG contrast */
+        --contrast-threshold: 0.623;
+        color: oklch(from var(--surface) max(0, sign(var(--contrast-threshold) - l)) 0 h);
+      }
+    }
+
+    @supports (color: contrast-color(red)) {
+      nav,
+      .btn,
+      footer {
+        color: contrast-color(var(--surface));
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
@@ -29,8 +61,7 @@
 
     /* Navigation */
     nav {
-      background: var(--primary);
-      color: white;
+      --surface: var(--primary);
       padding: 1rem 5%;
       display: flex;
       justify-content: space-between;
@@ -56,14 +87,18 @@
     }
 
     nav a {
-      color: white;
+      color: inherit;
       text-decoration: none;
+      text-underline-offset: 4px;
       font-size: 0.9rem;
-      transition: color 0.3s;
     }
 
-    nav a:hover {
-      color: var(--accent);
+    /* Underline instead of an accent color so hover text keeps contrast on any --primary */
+    nav a:hover,
+    nav a:focus-visible {
+      text-decoration: underline;
+      text-decoration-color: var(--accent);
+      text-decoration-thickness: 2px;
     }
 
     .logout-link {
@@ -122,20 +157,23 @@
 
     .btn {
       display: inline-block;
-      background: var(--primary);
+      --surface: var(--primary);
       padding: 10px 20px;
       text-decoration: none;
       border-radius: 5px;
       margin-top: 15px;
-      transition: background 0.3s;
+      transition: background-color 0.3s, color 0.3s;
     }
 
-    .btn:hover {
-      background: #3e2723;
+    /* Hover shade derived from --primary; text re-contrasts against it automatically */
