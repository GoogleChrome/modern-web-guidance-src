+      position: sticky;
+      z-index: 1;
+      display: block;
+      height: var(--indicator-size);
+      opacity: 0;
+      transition: opacity 0.2s;
+      /* Overlays are purely visual: clicks pass through to the reviews beneath */
+      pointer-events: none;
+    }
+
+    .indicator-top {
+      top: 0;
+      /* Negative margin so the overlay takes up no layout space */
+      margin-bottom: calc(-1 * var(--indicator-size));
+      margin-inline: -20px;
+      background: linear-gradient(to bottom, var(--scroller-bg) 10%, rgb(255 255 255 / 0));
+    }
+
+    .indicator-bottom {
+      bottom: 0;
+      margin-top: calc(-1 * var(--indicator-size));
+      margin-inline: -20px;
+      background: linear-gradient(to top, var(--scroller-bg) 10%, rgb(255 255 255 / 0));
+    }
+
+    /* Show top indicator only once the user has scrolled down */
+    @container scroll-state(scrollable: top) {
+      .indicator-top {
+        opacity: 1;
+      }
+    }
+
+    /* Show bottom indicator only while there's more content below */
+    @container scroll-state(scrollable: bottom) {
+      .indicator-bottom {
+        opacity: 1;
+      }
+    }
+
+    /* Fallback (IntersectionObserver) for browsers without scroll-state queries */
+    .reviews-scroller.scrolled-down .indicator-top,
+    .reviews-scroller.can-scroll-down .indicator-bottom {
+      opacity: 1;
+    }
