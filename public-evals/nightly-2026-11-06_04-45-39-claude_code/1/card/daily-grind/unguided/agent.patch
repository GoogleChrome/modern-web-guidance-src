+  <div class="order-toast" role="status" aria-live="polite" data-order-toast></div>
+
+  <script>
+    (function () {
+      var STORAGE_KEY = 'dailyGrindOrder';
+      var countEl = document.querySelector('[data-order-count]');
+      var toast = document.querySelector('[data-order-toast]');
+      var toastTimer;
+
+      function loadOrder() {
+        try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; }
+        catch (e) { return []; }
+      }
+
+      function saveOrder(order) {
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(order)); } catch (e) { /* storage unavailable */ }
+      }
+
+      function updateCount(order) {
+        var total = order.reduce(function (n, line) { return n + line.qty; }, 0);
+        if (countEl) countEl.textContent = total;
+      }
+
+      function showToast(msg) {
+        if (!toast) return;
+        toast.textContent = msg;
+        toast.classList.add('is-visible');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(function () { toast.classList.remove('is-visible'); }, 2500);
+      }
+
+      function selected(form) {
+        return form.querySelector('input[name="size"]:checked');
+      }
+
+      function refreshCard(form) {
+        var input = selected(form);
+        if (!input) return;
+        var price = Number(input.dataset.price).toFixed(2);
+        var sizeName = input.value.charAt(0).toUpperCase() + input.value.slice(1);
+        form.closest('.drink').querySelector('[data-price-display]').textContent = '$' + price;
+        var btn = form.querySelector('.drink__add');
+        btn.textContent = 'Add ' + sizeName + ' \u00b7 $' + price;
+      }
+
+      updateCount(loadOrder());
+
+      // Drop broken images so the card's :has() fallback layout kicks in.
+      document.querySelectorAll('.drink__media img').forEach(function (img) {
+        function drop() { img.remove(); }
+        if (img.complete && img.naturalWidth === 0) drop();
+        else img.addEventListener('error', drop);
+      });
+
+      document.querySelectorAll('.drink__form').forEach(function (form) {
+        refreshCard(form);
+        form.addEventListener('change', function () { refreshCard(form); });
+
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          var input = selected(form);
+          if (!input) return;
+          var item = form.elements.item.value;
+          var name = form.closest('.drink').querySelector('.drink__title').textContent;
+          var order = loadOrder();
+          var line = order.find(function (l) { return l.item === item && l.size === input.value; });
+          if (line) line.qty += 1;
+          else order.push({ item: item, name: name, size: input.value, price: Number(input.dataset.price), qty: 1 });
+          saveOrder(order);
+          updateCount(order);
+
+          var btn = form.querySelector('.drink__add');
+          btn.classList.add('is-added');
+          btn.textContent = 'Added \u2713';
+          setTimeout(function () { btn.classList.remove('is-added'); refreshCard(form); }, 1200);
+          showToast(input.value.charAt(0).toUpperCase() + input.value.slice(1) + ' ' + name + ' added to your order');
+        });
+      });
+    })();
+  </script>
