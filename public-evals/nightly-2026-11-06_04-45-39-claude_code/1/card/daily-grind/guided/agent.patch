+  <script>
+    const orderCount = document.getElementById('order-count');
+    const orderStatus = document.getElementById('order-status');
+    const order = [];
+
+    for (const form of document.querySelectorAll('.order-form')) {
+      const price = form.querySelector('.price');
+
+      form.addEventListener('change', (event) => {
+        if (event.target.name === 'size') {
+          price.textContent = `$${event.target.dataset.price}`;
+        }
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const size = form.elements.size.value;
+        const choice = form.querySelector(`input[name="size"][value="${size}"]`);
+        order.push({
+          item: form.elements.item.value,
+          size,
+          price: Number(choice.dataset.price),
+        });
+        orderCount.textContent = order.length;
+        orderStatus.textContent = `Added a ${size} ${form.dataset.drink} to your order. ${order.length} item${order.length === 1 ? '' : 's'} in your order.`;
+      });
+    }
+  </script>
+
