+    /* Card badge: hidden by default, revealed by semantic context */
+    .card-badge {
+      display: none;
+    }
+
+    /* ---------------------------------------------------------------
+       Semantic context: sections declare *what* they are via a custom
+       property; components decide *how* to adapt using style queries.
+       --------------------------------------------------------------- */
+    .seasonal {
+      --surface: seasonal;
+      --seasonal-accent: #c75b12;
+      --seasonal-accent-dark: #8d3d0b;
+      --seasonal-tint: #fff4e8;
+    }
+
+    /* Fallback for browsers without container style queries */
+    :where(.seasonal) .card {
+      position: relative;
+      background: linear-gradient(180deg, var(--seasonal-tint), white 70%);
+      border-top: 4px solid var(--seasonal-accent);
+      box-shadow: 0 6px 16px rgba(199, 91, 18, 0.15);
+    }
+
+    :where(.seasonal) .card h3 {
+      color: var(--seasonal-accent-dark);
+    }
+
+    :where(.seasonal) .card-badge {
+      display: inline-block;
+      margin-bottom: 10px;
+      padding: 2px 10px;
+      border-radius: 999px;
+      background: var(--seasonal-accent);
+      color: white;
+      font-size: 0.75rem;
+      font-weight: 600;
+      letter-spacing: 0.05em;
+      text-transform: uppercase;
+    }
+
+    :where(.seasonal) .card .btn {
+      background: var(--seasonal-accent);
+    }
+
+    :where(.seasonal) .card .btn:hover {
+      background: var(--seasonal-accent-dark);
+    }
+
+    /* Progressive enhancement: cards react to the inherited flag */
+    @container style(--surface: seasonal) {
+      .card {
+        position: relative;
+        background: linear-gradient(180deg, var(--seasonal-tint), white 70%);
+        border-top: 4px solid var(--seasonal-accent);
+        box-shadow: 0 6px 16px rgba(199, 91, 18, 0.15);
+      }
+
+      .card h3 {
+        color: var(--seasonal-accent-dark);
+      }
+
+      .card-badge {
+        display: inline-block;
+        margin-bottom: 10px;
+        padding: 2px 10px;
+        border-radius: 999px;
+        background: var(--seasonal-accent);
+        color: white;
+        font-size: 0.75rem;
+        font-weight: 600;
+        letter-spacing: 0.05em;
+        text-transform: uppercase;
+      }
+
+      .card .btn {
+        background: var(--seasonal-accent);
+      }
+
+      .card .btn:hover {
+        background: var(--seasonal-accent-dark);
+      }
+    }
+
+    .section-title {
+      text-align: center;
+    }
+
