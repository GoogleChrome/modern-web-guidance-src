@@ -0,0 +1,20 @@
+/**
+ * Semantic surface contexts.
+ *
+ * A layout container marks *what kind of place* it is by setting the
+ * inherited `--surface` custom property (via one of the `.surface-*` classes
+ * in `global.css`). Components never ask *who* their parent is — they react
+ * to `@container style(--surface: …)` and decide for themselves what to
+ * render, how to arrange themselves and which variant to present.
+ *
+ * - `featured`  – a hero / lead-story slot: promotional badge, large
+ *                 split layout, labelled actions.
+ * - `compact`   – a dense list such as a ticker bar: text only, date shown.
+ * - `breaking`  – a live / developing news section: urgent accent colour,
+ *                 "Breaking" badges and a live indicator on headings.
+ */
+export type Surface = 'featured' | 'compact' | 'breaking';
+
+export function surfaceClass(surface?: Surface): string | undefined {
+    return surface ? `surface-${surface}` : undefined;
+}
