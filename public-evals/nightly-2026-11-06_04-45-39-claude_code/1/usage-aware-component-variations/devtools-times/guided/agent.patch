+}
+
+/* ==========================================================================
+   Semantic surfaces
+   --------------------------------------------------------------------------
+   Producers only declare *what kind of place* they are. They never name the
+   components that react, and components never name their producers — both
+   sides meet on the inherited `--surface` custom property and
+   `@container style(--surface: …)`. The nearest producer wins, so a
+   `.surface-featured` slot nested inside a `.surface-breaking` section is
+   treated as featured.
+
+   No `container-type` is needed for style queries: every element is a style
+   container for the custom properties it (inherits and) holds.
+
+   Browser support: container style queries are Baseline "newly available"
+   (2026-05). Each variant therefore ships a `:where(.surface-*)` selector
+   fallback first; the style query (same specificity, later in source)
+   overrides it where supported. Drop the fallbacks once style queries are
+   widely available.
+   ========================================================================== */
+@layer components {
+  .surface-featured { --surface: featured; }
+  .surface-compact  { --surface: compact; }
+  .surface-breaking { --surface: breaking; }
+}
+
+/* ==========================================================================
+   Base component styles (context-free defaults)
+   ========================================================================== */
+@layer components {
+  /* ---- Article teaser --------------------------------------------------- */
+  .teaser {
+    container: teaser / inline-size; /* size container for the featured split layout */
+    height: 100%;
+  }
+
+  .teaser__layout {
+    display: flex;
+    flex-direction: column;
+    gap: 0.75rem;
+    height: 100%;
+  }
+
+  .teaser__media img {
+    display: block;
+    width: 100%;
+    height: auto;
+    aspect-ratio: 16 / 9;
+    object-fit: cover;
+    border-radius: var(--radius-md);
+  }
+
+  .teaser__body {
+    display: flex;
+    flex-direction: column;
+    flex-grow: 1;
+  }
+
+  .teaser__kicker {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 0.5rem;
+  }
+
+  .teaser__category {
+    font-family: "Grenze", serif;
+    font-size: var(--text-sm);
+    letter-spacing: var(--tracking-widest);
+    color: var(--color-amber-800);
+
+    &:hover { text-decoration: underline; }
+  }
+
+  .teaser__badge {
+    display: none; /* only revealed by a matching surface */
+    padding: 0.125rem 0.5rem;
+    border-radius: 9999px;
+    font-size: 0.6875rem;
+    font-weight: 700;
+    letter-spacing: 0.08em;
+    line-height: 1.4;
+    text-transform: uppercase;
+  }
+
+  .teaser__badge--featured {
+    background: var(--color-amber-100);
+    color: var(--color-amber-900);
+  }
+
+  .teaser__badge--breaking {
+    background: var(--color-red-700);
+    color: var(--color-white);
+  }
+
+  .teaser__title {
+    font-family: "Grenze", serif;
+    font-weight: 500;
+    font-size: var(--text-xl);
+    line-height: 1.2;
+    text-wrap: balance;
+    color: var(--color-gray-800);
+    transition: color 150ms;
+  }
+
+  .teaser:hover .teaser__title,
+  .teaser__title a:focus-visible {
+    color: var(--color-amber-700);
+  }
+
+  .teaser__summary {
+    margin-top: 0.25rem;
+    margin-bottom: 0.5rem;
+    color: var(--color-gray-600);
+    text-wrap: pretty;
+  }
+
+  .teaser__date {
+    display: none; /* only shown in compact surfaces */
+    font-size: var(--text-xs);
+    color: var(--color-gray-500);
+  }
+
+  .teaser__meta {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    margin-top: auto;
+    padding-top: 0.5rem;
+    border-top: 1px solid var(--color-gray-100);
+    font-size: var(--text-sm);
+    color: var(--color-gray-500);
+  }
+
+  .teaser__reading-time {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.25rem;
+    font-weight: 500;
+  }
+
+  /* ---- Bookmark button -------------------------------------------------- */
+  .bookmark-button {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.375rem;
+    padding: 0.25rem;
+    border-radius: var(--radius-md);
+    cursor: pointer;
+  }
+
+  .bookmark-button__label {
+    /* visually hidden, still announced */
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip-path: inset(50%);
+    white-space: nowrap;
+  }
+
+  /* ---- Section heading -------------------------------------------------- */
+  .section-heading {
+    display: flex;
+    align-items: center;
+    gap: 0.75rem;
+    margin-bottom: 1.5rem;
+    padding-bottom: 0.5rem;
+    border-bottom: 2px solid var(--color-gray-900);
+    font-size: var(--text-3xl);
+    font-weight: 700;
+
+    @media (min-width: 64rem) { margin-bottom: 2rem; }
+  }
+
+  .section-heading__live {
+    display: none; /* only shown in breaking surfaces */
+    align-items: center;
+    gap: 0.375rem;
+    padding: 0.125rem 0.625rem;
+    border-radius: 9999px;
+    background: var(--color-red-700);
+    color: var(--color-white);
+    font-size: var(--text-xs);
+    font-weight: 700;
+    letter-spacing: 0.08em;
+    text-transform: uppercase;
+
+    &::before {
+      content: "";
+      width: 0.5rem;
+      height: 0.5rem;
+      border-radius: 9999px;
+      background: currentColor;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      &::before { animation: live-pulse 1.6s ease-in-out infinite; }
+    }
+  }
+
+  @keyframes live-pulse {
+    50% { opacity: 0.25; }
+  }
+}
+
+/* ==========================================================================
+   Surface: featured — hero slot
+   ========================================================================== */
+@layer components {
+  /* Fallback (selector-based) */
+  :where(.surface-featured) {
+    .teaser { padding: 1.5rem; background: var(--color-white); box-shadow: var(--shadow-sm); }
+    .teaser__layout { gap: 1.5rem; }
+    .teaser__media img { aspect-ratio: 3 / 2; border-radius: 0; }
+    .teaser__badge--featured { display: inline-block; }
+    .teaser__title { margin-top: 0.5rem; font-size: clamp(var(--text-3xl), 1.5rem + 2cqi, var(--text-4xl)); line-height: 1.1; color: var(--color-gray-900); }
+    .teaser__summary { margin-top: 1rem; font-size: var(--text-lg); color: var(--color-gray-700); }
+    .bookmark-button__label { position: static; width: auto; height: auto; overflow: visible; clip-path: none; font-weight: 500; }
+  }
+  @container teaser (min-width: 48rem) {
+    :where(.surface-featured) .teaser__layout { display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; }
