diff --git a/src/components/semantic/Kicker.astro b/src/components/semantic/Kicker.astro
new file mode 100644
index 0000000..d9e58a5
--- /dev/null
+++ b/src/components/semantic/Kicker.astro
@@ -0,0 +1,38 @@
+---
+/**
+ * Category label plus semantic badges (Breaking / Investigation / Long read…).
+ * Colours come entirely from the surrounding semantic context tokens.
+ */
+import type { SemanticContext } from '../../utils/semantics';
+
+export interface Props {
+    context: SemanticContext;
+    /** Category link target; omit to render plain text. */
+    href?: string;
+    /** Max number of badges to show (compact placements show fewer). */
+    maxBadges?: number;
+    size?: 'sm' | 'md';
+    class?: string;
+}
+
+const { context, href, maxBadges = 2, size = 'sm', class: className = '' } = Astro.props;
+const badges = context.badges.slice(0, maxBadges);
+const labelClass = size === 'md' ? 'text-base' : 'text-sm';
+const Label = href ? 'a' : 'span';
+---
+<div class:list={['flex flex-wrap items-center gap-x-2 gap-y-1', className]}>
+    <span class="sr-only">{context.description}</span>
+    <Label
+        href={href}
+        class:list={['sem-accent font-brand tracking-widest', labelClass, href && 'hover:underline']}
+        aria-hidden="true"
+    >
+        {context.label}
+    </Label>
+    {badges.map((badge) => (
+        <span class="sem-badge" data-kind={badge.kind} aria-hidden="true">
+            {badge.kind === 'urgency' && context.urgency === 'breaking' && <span class="sem-pulse"></span>}
+            {badge.text}
+        </span>
+    ))}
+</div>
diff --git a/src/components/semantic/ReadingMeter.astro b/src/components/semantic/ReadingMeter.astro
new file mode 100644
index 0000000..7c5924e
--- /dev/null
+++ b/src/components/semantic/ReadingMeter.astro
@@ -0,0 +1,33 @@
+---
+/**
+ * Reading-time indicator that adapts to the reading commitment:
+ * quick reads get a bolt, long reads get a proportional progress meter,
+ * everything else gets the standard book icon.
+ */
+import { BookOpenIcon, BoltIcon } from '@heroicons/react/24/outline';
+import type { SemanticContext } from '../../utils/semantics';
+
+export interface Props {
+    context: SemanticContext;
+    minutes?: number;
+    /** Compact placements suppress the meter bar. */
+    compact?: boolean;
+}
+
+const { context, minutes, compact = false } = Astro.props;
+const MAX = 12;
+const pct = minutes ? Math.min(100, Math.round((minutes / MAX) * 100)) : 0;
+---
+{minutes != null && (
+    <span class="sem-muted text-xs font-medium inline-flex items-center gap-1.5">
+        {context.format === 'quick'
+            ? <BoltIcon className="w-4 h-4 -mt-px" aria-hidden="true" />
+            : <BookOpenIcon className="w-4 h-4 -mt-px" aria-hidden="true" />}
+        <span>{minutes} Min.</span>
+        {context.format === 'longread' && !compact && (
+            <span class="sem-meter-track inline-block w-14 h-1.5" role="img" aria-label={`Long read: ${minutes} minutes`}>
+                <span class="sem-meter-fill block" style={`width:${pct}%`}></span>
+            </span>
+        )}
+    </span>
+)}
diff --git a/src/components/semantic/SemanticSection.astro b/src/components/semantic/SemanticSection.astro
new file mode 100644
index 0000000..fff90db
--- /dev/null
+++ b/src/components/semantic/SemanticSection.astro
@@ -0,0 +1,36 @@
+---
+/**
+ * Establishes a semantic context for everything inside it.
+ *
+ * - `desk`: explicit editorial desk; if omitted it is inferred from `articles`
+ *   (majority vote) so a section full of sports stories turns sports-green.
+ * - `surface`: background register. Children recompute their accents for
+ *   legibility on dark/tinted surfaces automatically through CSS tokens.
+ */
+import type { CollectionEntry } from 'astro:content';
+import { dominantDesk, type Desk, type Surface } from '../../utils/semantics';
+
+export interface Props {
+    title?: string;
+    desk?: Desk;
+    surface?: Surface;
+    articles?: CollectionEntry<'articles'>[];
+    class?: string;
+}
+
+const { title, desk, surface = 'light', articles = [], class: className = '' } = Astro.props;
+const resolvedDesk = desk ?? dominantDesk(articles);
+---
+<section
+    class:list={['sem-surface p-4 md:p-6', className]}
+    data-desk={resolvedDesk}
+    data-surface={surface}
+    aria-label={title}
+>
+    {title && (
+        <h2 class="sem-section-title text-3xl font-bold pb-2 mb-6 lg:mb-8">
+            {title}
+        </h2>
+    )}
+    <slot />
+</section>
