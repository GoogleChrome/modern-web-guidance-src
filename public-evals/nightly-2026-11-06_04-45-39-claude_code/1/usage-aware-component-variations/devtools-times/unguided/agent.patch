+}
+/* ==========================================================================
+   Semantic context tokens
+   --------------------------------------------------------------------------
+   Components emit data-desk / data-tone / data-genre / data-urgency /
+   data-format / data-placement / data-surface (see src/utils/semantics.ts).
+   These rules translate meaning into visual tokens. Everything cascades, so a
+   section can set a context that descendants inherit unless they declare a
+   more specific one.
+   ========================================================================== */
+
+:root {
+  /* Surface tokens (light by default) */
+  --sem-bg: #ffffff;
+  --sem-fg: oklch(0.21 0.02 260);
+  --sem-muted: oklch(0.45 0.02 260);
+  --sem-rule: oklch(0.92 0.005 260);
+  --sem-lift: 0%;          /* how much to lighten accents for legibility */
+
+  /* Desk palette (brand amber when no desk is known) */
+  --desk-accent: oklch(0.48 0.12 60);
+
+  /* Tone tokens */
+  --tone-mute: 0%;         /* pull accent toward foreground for sober topics */
+  --tone-radius: 0.375rem;
+  --tone-media-filter: none;
+  --tone-media-filter-hover: none;
+  --tone-hover-lift: 0;
+
+  --sem-accent: var(--desk-accent);
+}
+
+/* --- Desks --------------------------------------------------------------- */
+[data-desk="news"]      { --desk-accent: oklch(0.50 0.19 27); }
+[data-desk="politics"]  { --desk-accent: oklch(0.42 0.14 265); }
+[data-desk="sports"]    { --desk-accent: oklch(0.52 0.15 150); }
+[data-desk="culture"]   { --desk-accent: oklch(0.48 0.17 320); }
+[data-desk="science"]   { --desk-accent: oklch(0.50 0.10 200); }
+[data-desk="business"]  { --desk-accent: oklch(0.42 0.09 240); }
+[data-desk="media"]     { --desk-accent: oklch(0.48 0.12 60); }
+[data-desk="lifestyle"] { --desk-accent: oklch(0.58 0.15 45); }
+[data-desk="urban"]     { --desk-accent: oklch(0.47 0.07 110); }
+[data-desk="tech"]      { --desk-accent: oklch(0.50 0.12 230); }
+[data-desk="general"]   { --desk-accent: oklch(0.48 0.12 60); }
+
+/* --- Surfaces ------------------------------------------------------------ */
+[data-surface="light"] {
+  --sem-bg: #ffffff;
+  --sem-fg: oklch(0.21 0.02 260);
+  --sem-muted: oklch(0.45 0.02 260);
+  --sem-rule: oklch(0.92 0.005 260);
+  --sem-lift: 0%;
+}
+[data-surface="tinted"] {
+  --sem-bg: color-mix(in oklch, var(--desk-accent) 7%, white);
+  --sem-fg: oklch(0.21 0.02 260);
+  --sem-muted: oklch(0.42 0.02 260);
+  --sem-rule: color-mix(in oklch, var(--desk-accent) 18%, white);
+  --sem-lift: 0%;
+}
+[data-surface="dark"] {
+  --sem-bg: oklch(0.2 0.015 260);
+  --sem-fg: oklch(0.97 0.005 260);
+  --sem-muted: oklch(0.78 0.01 260);
+  --sem-rule: oklch(0.32 0.015 260);
+  --sem-lift: 45%;
+}
+
+/* --- Tones --------------------------------------------------------------- */
+[data-tone] {
+  --tone-mute: 0%;
+  --tone-radius: 0.375rem;
+  --tone-media-filter: none;
+  --tone-media-filter-hover: none;
+  --tone-hover-lift: 0;
+}
+[data-tone="grave"] {
+  --tone-mute: 35%;
+  --tone-radius: 0;
+  --tone-media-filter: grayscale(0.75) contrast(1.05);
+  --tone-media-filter-hover: grayscale(0.2);
+}
+[data-tone="light"] {
+  --tone-radius: 0.875rem;
+  --tone-media-filter: saturate(1.1);
+  --tone-media-filter-hover: saturate(1.25);
+  --tone-hover-lift: -3px;
+}
+
+/* Accent is recomputed wherever the context can change, so nested contexts
+   combine the nearest desk, surface and tone correctly. */
+[data-desk], [data-surface], [data-tone] {
+  --sem-accent: color-mix(
+    in oklch,
+    color-mix(in oklch, var(--desk-accent), white var(--sem-lift)),
+    var(--sem-fg) var(--tone-mute)
+  );
+  --sem-accent-soft: color-mix(in oklch, var(--sem-accent) 14%, transparent);
+}
+
+/* Breaking news always reads as urgent, regardless of desk. */
+[data-urgency="breaking"] {
+  --sem-urgent: color-mix(in oklch, oklch(0.55 0.21 27), white var(--sem-lift));
+}
+[data-urgency="fresh"] {
+  --sem-urgent: var(--sem-accent);
+}
+
+/* --- Utility classes driven by tokens ----------------------------------- */
+.sem-surface {
+  background-color: var(--sem-bg);
+  color: var(--sem-fg);
+}
+.sem-fg     { color: var(--sem-fg); }
+.sem-muted  { color: var(--sem-muted); }
+.sem-accent { color: var(--sem-accent); }
+.sem-rule   { border-color: var(--sem-rule); }
+
+.sem-card {
+  border-radius: var(--tone-radius);
+  transition: transform 200ms ease, box-shadow 200ms ease;
+}
+.sem-card:hover { transform: translateY(var(--tone-hover-lift)); }
+[data-tone="light"].sem-card:hover {
+  box-shadow: 0 10px 24px -12px color-mix(in oklch, var(--sem-accent) 45%, transparent);
+}
+
+.sem-media {
+  border-radius: var(--tone-radius);
+  filter: var(--tone-media-filter);
+  transition: filter 300ms ease;
+}
+.group:hover .sem-media,
+.sem-media:hover { filter: var(--tone-media-filter-hover); }
+
+.sem-headline { transition: color 150ms ease; }
+.group:hover .sem-headline,
+.sem-headline:hover { color: var(--sem-accent); }
+/* Grave stories don't flash colour on hover; they underline instead. */
+[data-tone="grave"] .sem-headline:hover,
+[data-tone="grave"].group:hover .sem-headline {
+  color: inherit;
+  text-decoration: underline;
+  text-decoration-thickness: 1px;
+  text-underline-offset: 0.2em;
+}
+
+/* Analysis pieces use a sober sans headline; everything else uses the brand face. */
+[data-genre="analysis"] .sem-headline {
+  font-family: ui-sans-serif, system-ui, sans-serif;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+}
+/* Reviews get an italic standfirst to signal opinion. */
+[data-genre="review"] .sem-standfirst { font-style: italic; }
+
+/* Kicker badges */
+.sem-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.35em;
+  font-size: 0.68rem;
+  line-height: 1;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  padding: 0.3em 0.55em;
+  border-radius: 999px;
+  white-space: nowrap;
+}
+.sem-badge[data-kind="urgency"] {
+  color: white;
+  background: var(--sem-urgent, var(--sem-accent));
+}
+[data-surface="dark"] .sem-badge[data-kind="urgency"] { color: var(--sem-bg); }
+.sem-badge[data-kind="genre"] {
+  color: var(--sem-accent);
+  box-shadow: inset 0 0 0 1px currentColor;
+}
+[data-genre="investigation"] .sem-badge[data-kind="genre"] {
+  color: var(--sem-bg);
+  background: var(--sem-accent);
+  box-shadow: none;
+  border-radius: 0;
+}
+.sem-badge[data-kind="format"] {
+  color: var(--sem-muted);
+  background: var(--sem-accent-soft);
+}
+.sem-pulse {
+  width: 0.45em;
+  height: 0.45em;
+  border-radius: 999px;
+  background: currentColor;
+  animation: sem-pulse 1.4s ease-in-out infinite;
+}
+@keyframes sem-pulse {
+  0%, 100% { opacity: 1; }
+  50% { opacity: 0.25; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .sem-pulse { animation: none; }
+  .sem-card, .sem-media, .sem-headline { transition: none; }
+  .sem-card:hover { transform: none; }
+}
+
+/* Section heading rule picks up the section's desk accent. */
+.sem-section-title {
+  border-bottom: 2px solid var(--sem-fg);
+  position: relative;
+}
+.sem-section-title::after {
+  content: "";
+  position: absolute;
+  left: 0;
+  bottom: -2px;
+  width: 4rem;
+  height: 2px;
+  background: var(--sem-accent);
+}
+
+/* Reading meter */
+.sem-meter-track {
+  background: var(--sem-rule);
+  border-radius: 999px;
+  overflow: hidden;
+}
+.sem-meter-fill {
+  background: var(--sem-accent);
+  height: 100%;
+  border-radius: inherit;
+}
+
+/* Long-form prose links follow the article's desk colour. */
+.sem-prose a { color: var(--sem-accent); }
+[data-tone="grave"] .sem-prose p:first-of-type::first-letter {
+  float: left;
+  font-family: "Grenze", serif;
+  font-size: 3.4em;
+  line-height: 0.85;
+  padding-right: 0.08em;
+  color: var(--sem-fg);
+}
