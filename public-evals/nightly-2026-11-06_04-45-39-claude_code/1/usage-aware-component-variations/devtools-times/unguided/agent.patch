@@ -0,0 +1,268 @@
+/**
+ * Semantic context resolution.
+ *
+ * Components never hard-code colours, labels or image treatments for a given
+ * piece of content. Instead they ask this module "what *is* this content?"
+ * and receive a semantic description (desk, tone, genre, urgency, format).
+ * That description is emitted as `data-*` attributes; `global.css` maps each
+ * attribute to visual tokens (CSS custom properties). Because custom
+ * properties cascade, a section can establish a context (e.g. a dark "Culture"
+ * band) and every descendant adapts automatically unless it carries a more
+ * specific context of its own.
+ */
+import type { CollectionEntry } from 'astro:content';
+
+/** Editorial desk — drives the accent palette. */
+export type Desk =
+  | 'news'
+  | 'politics'
+  | 'sports'
+  | 'culture'
+  | 'science'
+  | 'business'
+  | 'media'
+  | 'lifestyle'
+  | 'urban'
+  | 'tech'
+  | 'general';
+
+/** Emotional register — drives image treatment, shape and motion. */
+export type Tone = 'grave' | 'neutral' | 'light';
+
+/** Journalistic form — drives the kicker label and typography. */
+export type Genre = 'news' | 'investigation' | 'analysis' | 'review' | 'feature';
+
+/** Time sensitivity relative to the newest item on the page. */
+export type Urgency = 'breaking' | 'fresh' | 'standard';
+
+/** Reading commitment. */
+export type Format = 'quick' | 'standard' | 'longread';
+
+/** Where in the layout the component sits (supplied by the parent). */
+export type Placement = 'hero' | 'lead' | 'standard' | 'compact';
+
+/** Background the component is rendered on (supplied by the parent). */
+export type Surface = 'light' | 'tinted' | 'dark';
+
+export interface SemanticContext {
+  desk: Desk;
+  tone: Tone;
+  genre: Genre;
+  urgency: Urgency;
+  format: Format;
+  /** Human-readable desk name (the original category, title-cased). */
+  label: string;
+  /** Optional semantic badges, in display priority order. */
+  badges: SemanticBadge[];
+  /** Accessible sentence describing the context for screen readers. */
+  description: string;
+}
+
+export interface SemanticBadge {
+  kind: 'urgency' | 'genre' | 'format';
+  text: string;
+}
+
+type ArticleLike = Pick<CollectionEntry<'articles'>, 'data'>;
+
+const DESK_BY_CATEGORY: Record<string, Desk> = {
+  news: 'news',
+  national: 'news',
+  world: 'news',
+  politics: 'politics',
+  sports: 'sports',
+  culture: 'culture',
+  arts: 'culture',
+  science: 'science',
+  business: 'business',
+  economy: 'business',
+  labor: 'business',
+  media: 'media',
+  lifestyle: 'lifestyle',
+  pets: 'lifestyle',
+  'urban development': 'urban',
+  'web development': 'tech',
+  technology: 'tech',
+};
+
+// Terms match whole words/phrases; a trailing `*` makes a term a word prefix
+// (e.g. `investigat*` matches "investigation" and "investigators").
+const GRAVE_TERMS = [
+  'killer*', 'crime*', 'criminal*', 'death*', 'forensic*', 'murder*', 'pollution',
+  'crisis', 'decay', 'collapse*', 'victim*', 'illicit', 'crumbling', 'time bomb',
+  'existential',
+];
+const LIGHT_TERMS = [
+  'humor', 'comedy', 'improv', 'pet', 'pets', 'dog', 'dogs', 'festival*',
+  'coffee', 'juggl*', 'fun', 'griffon*',
+];
+const INVESTIGATION_TERMS = ['investigat*', 'inside', 'unravel*', 'forensic*', 'profil*', 'criminal*'];
+const ANALYSIS_TERMS = ['future of', 'decline', 'crisis', 'boom', 'overhaul', 'why', 'what next', 'how'];
+const REVIEW_TERMS = ['ballet', 'swan lake', 'festival*', 'concert*', 'theater', 'theatre', 'improv'];
+const BREAKING_TERMS = ['breaking', 'strike', 'strikes', 'just in'];
+/** Desks where a same-day story is genuinely "breaking"; others are just "new". */
+const HARD_NEWS_DESKS: Desk[] = ['news', 'politics', 'business', 'sports'];
+
+const DAY = 24 * 60 * 60 * 1000;
+
+function haystack(article: ArticleLike): string {
+  const { title, summary, tags = [] } = article.data;
+  return `${title} ${summary} ${tags.join(' ')}`.toLowerCase();
+}
+
+const patternCache = new Map<string, RegExp>();
+function termPattern(term: string): RegExp {
+  let re = patternCache.get(term);
+  if (!re) {
+    const prefix = term.endsWith('*');
+    const body = (prefix ? term.slice(0, -1) : term).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+    re = new RegExp(`\\b${body}${prefix ? '' : '\\b'}`);
+    patternCache.set(term, re);
+  }
+  return re;
+}
+
+function countMatches(text: string, terms: string[]): number {
+  return terms.reduce((n, term) => n + (termPattern(term).test(text) ? 1 : 0), 0);
+}
+
+export function titleCase(value: string): string {
+  return value.replace(/\b\w/g, (c) => c.toUpperCase());
+}
+
+export function resolveDesk(category: string): Desk {
+  return DESK_BY_CATEGORY[category.trim().toLowerCase()] ?? 'general';
+}
+
+export function resolveTone(article: ArticleLike): Tone {
+  const text = haystack(article);
+  const grave = countMatches(text, GRAVE_TERMS);
+  const light = countMatches(text, LIGHT_TERMS);
+  if (grave > light && grave > 0) return 'grave';
+  if (light > grave && light > 0) return 'light';
+  return 'neutral';
+}
+
+export function resolveGenre(article: ArticleLike, desk: Desk): Genre {
+  const text = haystack(article);
+  if (countMatches(text, INVESTIGATION_TERMS) >= 2) return 'investigation';
+  if (desk === 'culture' && countMatches(text, REVIEW_TERMS) > 0) return 'review';
+  if (countMatches(text, ANALYSIS_TERMS) > 0) return 'analysis';
+  if (desk === 'news' || desk === 'politics' || desk === 'sports') return 'news';
+  return 'feature';
+}
+
+export function resolveFormat(readingTime?: number): Format {
+  if (readingTime == null) return 'standard';
+  if (readingTime >= 8) return 'longread';
+  if (readingTime <= 3) return 'quick';
+  return 'standard';
+}
+
+export function resolveUrgency(
+  article: ArticleLike,
+  desk: Desk,
+  referenceDate?: Date,
+): Urgency {
+  const text = haystack(article);
+  const ref = referenceDate ?? new Date();
+  const age = ref.valueOf() - article.data.date.valueOf();
+  const hardNews = HARD_NEWS_DESKS.includes(desk);
+  if (hardNews && age >= 0 && age < 7 * DAY && countMatches(text, BREAKING_TERMS) > 0) return 'breaking';
+  if (hardNews && age >= 0 && age < 1 * DAY) return 'breaking';
+  if (age >= 0 && age < 4 * DAY) return 'fresh';
+  return 'standard';
+}
+
+const GENRE_LABEL: Record<Genre, string | null> = {
+  news: null,
+  feature: null,
+  investigation: 'Investigation',
+  analysis: 'Analysis',
+  review: 'Review',
+};
+
+const URGENCY_LABEL: Record<Urgency, string | null> = {
+  breaking: 'Breaking',
+  fresh: 'New',
+  standard: null,
+};
+
+const FORMAT_LABEL: Record<Format, string | null> = {
+  quick: 'Quick read',
+  longread: 'Long read',
+  standard: null,
+};
+
+export interface ResolveOptions {
+  /**
+   * Date that counts as "now" for urgency. Pass the newest article's date to
+   * evaluate freshness relative to the current edition instead of wall time.
+   */
+  referenceDate?: Date;
+}
+
+export function resolveSemanticContext(
+  article: ArticleLike,
+  options: ResolveOptions = {},
+): SemanticContext {
+  const desk = resolveDesk(article.data.category);
+  const tone = resolveTone(article);
+  const genre = resolveGenre(article, desk);
+  const urgency = resolveUrgency(article, desk, options.referenceDate);
+  const format = resolveFormat(article.data.readingTime);
+  const label = titleCase(article.data.category);
+
+  const badges: SemanticBadge[] = [];
+  const u = URGENCY_LABEL[urgency];
+  const g = GENRE_LABEL[genre];
+  const f = FORMAT_LABEL[format];
+  if (u) badges.push({ kind: 'urgency', text: u });
+  if (g) badges.push({ kind: 'genre', text: g });
+  if (f) badges.push({ kind: 'format', text: f });
+
+  const description = [label, ...badges.map((b) => b.text)].join(', ');
+
+  return { desk, tone, genre, urgency, format, label, badges, description };
+}
+
+/** Newest date in a list — a stable "edition date" for urgency checks. */
+export function getEditionDate(articles: ArticleLike[]): Date | undefined {
+  if (articles.length === 0) return undefined;
+  return new Date(Math.max(...articles.map((a) => a.data.date.valueOf())));
+}
+
+/** Serialise a context into data attributes for the CSS token layer. */
+export function semanticAttributes(
+  ctx: SemanticContext,
+  extra: { placement?: Placement; surface?: Surface } = {},
+): Record<string, string> {
+  const attrs: Record<string, string> = {
+    'data-desk': ctx.desk,
+    'data-tone': ctx.tone,
+    'data-genre': ctx.genre,
+    'data-urgency': ctx.urgency,
+    'data-format': ctx.format,
+  };
+  if (extra.placement) attrs['data-placement'] = extra.placement;
+  if (extra.surface) attrs['data-surface'] = extra.surface;
+  return attrs;
+}
+
+/**
+ * Infer the dominant desk for a set of articles (used by sections that do not
+ * declare an explicit desk). Returns 'general' when there is no clear majority.
+ */
+export function dominantDesk(articles: ArticleLike[]): Desk {
+  const counts = new Map<Desk, number>();
+  for (const a of articles) {
+    const d = resolveDesk(a.data.category);
+    counts.set(d, (counts.get(d) ?? 0) + 1);
+  }
+  let best: Desk = 'general';
+  let bestCount = 0;
+  for (const [desk, n] of counts) {
+    if (n > bestCount) [best, bestCount] = [desk, n];
+  }
+  return bestCount > articles.length / 2 ? best : 'general';
+}
