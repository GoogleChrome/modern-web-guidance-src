+    /* Scrollytelling: text in #tracked drives reveals in #animated (pure CSS) */
+    .story {
+      margin-top: 80px;
+    }
+
+    .story > h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .scrolly {
+      display: grid;
+      grid-template-columns: 1fr 1fr;
+      gap: 40px;
+      align-items: start;
+    }
+
+    #tracked section {
+      min-height: 80vh;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      padding: 20px 0;
+    }
+
+    #tracked section .step {
+      font-size: 0.8rem;
+      font-weight: bold;
+      letter-spacing: 2px;
+      text-transform: uppercase;
+      color: var(--accent);
+    }
+
+    #tracked section h3 {
+      font-size: 1.8rem;
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    #animated {
+      display: grid;
+      gap: 20px;
+    }
+
+    #animated section {
+      border-radius: 12px;
+      overflow: hidden;
+      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
+      background: var(--primary);
+      color: white;
+    }
+
+    #animated img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    #animated figcaption {
+      padding: 12px 16px;
+      font-size: 0.9rem;
+    }
+
+    @media (max-width: 760px) {
+      .scrolly {
+        grid-template-columns: 1fr;
+      }
+    }
+
+    /*
+      Progressive enhancement: browsers without scroll-driven animations keep
+      the static, fully visible layout above. Supporting browsers get a sticky
+      stage whose layers are driven by the text sections' view timelines.
+    */
+    @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+      /* Hoist the timeline names so #animated (a different DOM branch) can see them */
+      html {
+        timeline-scope: --tl-1, --tl-2, --tl-3, --tl-4;
+      }
+
+      #tracked section:nth-child(1) { view-timeline: --tl-1 block; }
+      #tracked section:nth-child(2) { view-timeline: --tl-2 block; }
+      #tracked section:nth-child(3) { view-timeline: --tl-3 block; }
+      #tracked section:nth-child(4) { view-timeline: --tl-4 block; }
+
+      #animated {
+        position: sticky;
+        top: calc(50vh - min(40vh, 260px));
+        /* Contain the slide-out translate without breaking stickiness */
+        overflow: clip;
+        padding: 20px;
+        margin: -20px;
+      }
+
+      /* Stack all layers in a single grid cell */
+      #animated section {
+        grid-area: 1 / 1;
+        backface-visibility: hidden;
+        animation: reveal-in auto linear both, reveal-out auto linear forwards;
+        animation-range: entry 25% cover 50%, exit 25% exit 60%;
+      }
+
+      #animated section:nth-child(1) { animation-timeline: --tl-1; }
+      #animated section:nth-child(2) { animation-timeline: --tl-2; }
+      #animated section:nth-child(3) { animation-timeline: --tl-3; }
+      #animated section:nth-child(4) { animation-timeline: --tl-4; }
+
+      /* Mobile: pin the stage at the top, text scrolls underneath */
+      @media (max-width: 760px) {
+        #animated {
+          top: 70px;
+          z-index: 1;
+          order: -1;
+        }
+
+        #animated img {
+          aspect-ratio: 16 / 9;
+        }
+
+        #tracked section {
+          min-height: 70vh;
+        }
+      }
+    }
+
+    /* Reduced motion: opacity-only crossfade (no spatial movement) */
+    @keyframes reveal-in {
+      from { opacity: 0; }
+    }
+
+    @keyframes reveal-out {
+      to { opacity: 0; }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @keyframes reveal-in {
+        from { opacity: 0; scale: 0.85; translate: 0 15%; }
+      }
+
+      @keyframes reveal-out {
+        to { opacity: 0; scale: 0.95; translate: 0 -15%; }
+      }
+    }
+
