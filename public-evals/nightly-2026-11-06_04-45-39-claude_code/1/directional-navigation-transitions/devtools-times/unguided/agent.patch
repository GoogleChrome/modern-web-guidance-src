+import { useState } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+export interface TopStory {
+  id: string;
+  title: string;
+  href: string;
+  date: string;
+}
+
+interface Props {
+  stories: TopStory[];
+}
+
+type Direction = 'next' | 'prev' | null;
+
+export default function TopStoriesSlider({ stories }: Props) {
+  const [index, setIndex] = useState(0);
+  const [direction, setDirection] = useState<Direction>(null);
+
+  if (stories.length === 0) return null;
+
+  const go = (dir: 'next' | 'prev') => {
+    const delta = dir === 'next' ? 1 : -1;
+    setDirection(dir);
+    setIndex((i) => (i + delta + stories.length) % stories.length);
+  };
+
+  const story = stories[index];
+  const animationClass =
+    direction === 'next' ? 'top-story-slide-from-right' : direction === 'prev' ? 'top-story-slide-from-left' : '';
+
+  return (
+    <section aria-roledescription="carousel" aria-label="Top stories" className="flex items-center gap-4">
+      <button
+        type="button"
+        onClick={() => go('prev')}
+        aria-label="Previous story"
+        className="shrink-0 p-2 rounded-full border border-gray-300 text-gray-700 hover:text-amber-400 hover:border-amber-400 transition-colors"
+      >
+        <ChevronLeftIcon className="h-5 w-5" />
+      </button>
+
+      <div className="flex-1 overflow-hidden" aria-live="polite">
+        {/* Keyed so the element remounts and the slide-in animation replays on every change */}
+        <div
+          key={`${story.id}-${index}`}
+          className={animationClass}
+          role="group"
+          aria-roledescription="slide"
+          aria-label={`${index + 1} of ${stories.length}`}
+        >
+          <a href={story.href}>
+            <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{story.title}</h3>
+          </a>
+          <span className="text-xs text-gray-500">
+            {story.date} · {index + 1} / {stories.length}
+          </span>
+        </div>
+      </div>
+
+      <button
+        type="button"
+        onClick={() => go('next')}
+        aria-label="Next story"
+        className="shrink-0 p-2 rounded-full border border-gray-300 text-gray-700 hover:text-amber-400 hover:border-amber-400 transition-colors"
+      >
+        <ChevronRightIcon className="h-5 w-5" />
+      </button>
+    </section>
+  );
+}
