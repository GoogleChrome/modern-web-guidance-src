+}
+/* Top stories slider */
+@keyframes top-story-slide-from-right {
+  from { transform: translateX(100%); opacity: 0; }
+  to { transform: translateX(0); opacity: 1; }
+}
+
+@keyframes top-story-slide-from-left {
+  from { transform: translateX(-100%); opacity: 0; }
+  to { transform: translateX(0); opacity: 1; }
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .top-story-slide-from-right {
+    animation: top-story-slide-from-right 300ms ease-out;
+  }
+
+  .top-story-slide-from-left {
+    animation: top-story-slide-from-left 300ms ease-out;
+  }
+}
