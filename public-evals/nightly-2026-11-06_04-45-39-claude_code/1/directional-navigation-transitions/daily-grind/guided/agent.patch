+  <script>
+    (() => {
+      const carousel = document.querySelector('.carousel');
+      const viewport = carousel.querySelector('.carousel-viewport');
+      const slides = [...viewport.querySelectorAll('.slide')];
+      const controls = carousel.querySelector('.carousel-controls');
+      const status = carousel.querySelector('.carousel-status');
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      const supportsScoped = 'startViewTransition' in Element.prototype;
+      let current = 0;
+
+      function show(index) {
+        current = (index + slides.length) % slides.length;
+        slides.forEach((slide, i) => { slide.hidden = i !== current; });
+        status.textContent = `${current + 1} / ${slides.length}`;
+      }
+
+      function go(direction) {
+        const update = () => show(current + (direction === 'next' ? 1 : -1));
+
+        if (reducedMotion.matches) {
+          update();
+          return;
+        }
+
+        let transition;
+        if (supportsScoped) {
+          // Scope the transition to the carousel so the rest of the page stays interactive
+          transition = viewport.startViewTransition({ update, types: [direction] });
+        } else if (document.startViewTransition) {
+          transition = document.startViewTransition({ update, types: [direction] });
+        } else {
+          update();
+          return;
+        }
+        // Rapid clicks skip the in-flight transition; ignore that rejection
+        transition.ready.catch(() => {});
+      }
+
+      controls.addEventListener('click', (event) => {
+        const button = event.target.closest('button[data-direction]');
+        if (button) go(button.dataset.direction);
+      });
+
+      show(0);
+      controls.hidden = false;
+    })();
+  </script>
+
