+    }
+
+    .carousel-status {
+      font-size: 0.9rem;
+    }
+
+    @keyframes slide-to-left {
+      to { transform: translateX(-100%); }
+    }
+
+    @keyframes slide-from-right {
+      from { transform: translateX(100%); }
+    }
+
+    @keyframes slide-to-right {
+      to { transform: translateX(100%); }
+    }
+
+    @keyframes slide-from-left {
+      from { transform: translateX(-100%); }
+    }
+
+    /* Keep the sliding snapshots inside the slide's box */
+    ::view-transition-group(seasonal-slide) {
+      overflow: clip;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      ::view-transition-group(seasonal-slide),
+      ::view-transition-old(seasonal-slide),
+      ::view-transition-new(seasonal-slide) {
+        animation-duration: 0.4s;
+        animation-timing-function: ease-in-out;
+        animation-fill-mode: both;
+      }
+
+      /* Next: old slides out to the left, new comes in from the right */
+      html:active-view-transition-type(next)::view-transition-old(seasonal-slide),
+      .carousel-viewport:active-view-transition-type(next)::view-transition-old(seasonal-slide) {
+        animation-name: slide-to-left;
+      }
+
+      html:active-view-transition-type(next)::view-transition-new(seasonal-slide),
+      .carousel-viewport:active-view-transition-type(next)::view-transition-new(seasonal-slide) {
+        animation-name: slide-from-right;
+      }
+
+      /* Previous: old slides out to the right, new comes in from the left */
+      html:active-view-transition-type(previous)::view-transition-old(seasonal-slide),
+      .carousel-viewport:active-view-transition-type(previous)::view-transition-old(seasonal-slide) {
+        animation-name: slide-to-right;
+      }
+
+      html:active-view-transition-type(previous)::view-transition-new(seasonal-slide),
+      .carousel-viewport:active-view-transition-type(previous)::view-transition-new(seasonal-slide) {
+        animation-name: slide-from-left;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(seasonal-slide),
+      ::view-transition-old(seasonal-slide),
+      ::view-transition-new(seasonal-slide) {
+        animation: none !important;
+      }
+    }
