+  <script>
+    // Native <select> only navigates with Up/Down; map Left/Right to the
+    // neighboring option so keyboard movement follows the single-row grid.
+    document.querySelectorAll('select.roast-picker').forEach((select) => {
+      select.addEventListener('keydown', (event) => {
+        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
+        let open = false;
+        try { open = select.matches(':open'); } catch { return; }
+        const current = document.activeElement;
+        if (!open || !(current instanceof HTMLOptionElement)) return;
+        const options = [...select.options];
+        const next = options[options.indexOf(current) + (event.key === 'ArrowRight' ? 1 : -1)];
+        if (next) {
+          event.preventDefault();
+          next.focus();
+        }
+      });
+    });
+  </script>
