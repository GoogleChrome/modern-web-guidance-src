+  <script>
+    (function () {
+      var picker = document.getElementById('roast-picker');
+      var select = document.getElementById('roast-select');
+      var orderBtn = document.getElementById('order-now');
+      if (!picker || !select) return;
+
+      function syncOrderLink() {
+        orderBtn.href = '/order-online?roast=' + encodeURIComponent(select.value);
+      }
+      select.addEventListener('change', syncOrderLink);
+      syncOrderLink();
+
+      // Enhance the native select into a 3-column rich-media grid picker
+      var opts = Array.prototype.slice.call(select.options);
+      var trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.className = 'roast-trigger';
+      trigger.id = 'roast-trigger';
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-controls', 'roast-options');
+      trigger.innerHTML = '<span class="thumb"></span><span class="value"></span><span class="chevron" aria-hidden="true">&#9662;</span>';
+
+      var list = document.createElement('ul');
+      list.className = 'roast-options';
+      list.id = 'roast-options';
+      list.setAttribute('role', 'listbox');
+      list.setAttribute('aria-label', 'Roast');
+      list.tabIndex = -1;
+      list.hidden = true;
+
+      var items = opts.map(function (opt, i) {
+        var li = document.createElement('li');
+        li.className = 'roast-option';
+        li.id = 'roast-opt-' + opt.value;
+        li.setAttribute('role', 'option');
+        li.dataset.index = i;
+        li.innerHTML = '<span class="thumb ' + opt.value + '" aria-hidden="true"></span>' +
+          '<span class="info"><strong></strong><small></small></span>';
+        li.querySelector('strong').textContent = opt.text;
+        li.querySelector('small').textContent = opt.dataset.desc || '';
+        li.addEventListener('click', function () { choose(i); close(true); });
+        li.addEventListener('mousemove', function () { setActive(i); });
+        list.appendChild(li);
+        return li;
+      });
+
+      picker.querySelector('label').setAttribute('for', 'roast-trigger');
+      select.tabIndex = -1;
+      select.setAttribute('aria-hidden', 'true');
+      picker.appendChild(trigger);
+      picker.appendChild(list);
+      picker.classList.add('enhanced');
+
+      var active = select.selectedIndex;
+
+      function render() {
+        var opt = select.options[select.selectedIndex];
+        trigger.querySelector('.thumb').className = 'thumb ' + opt.value;
+        trigger.querySelector('.value').textContent = opt.text;
+        items.forEach(function (li, i) {
+          li.setAttribute('aria-selected', i === select.selectedIndex ? 'true' : 'false');
+        });
+      }
+
+      function setActive(i) {
+        active = (i + items.length) % items.length;
+        items.forEach(function (li, j) { li.classList.toggle('active', j === active); });
+        list.setAttribute('aria-activedescendant', items[active].id);
+      }
+
+      function choose(i) {
+        if (select.selectedIndex !== i) {
+          select.selectedIndex = i;
+          select.dispatchEvent(new Event('change', { bubbles: true }));
+        }
+        render();
+      }
+
+      function open() {
+        list.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        setActive(select.selectedIndex);
+        list.focus();
+      }
+
+      function close(focusTrigger) {
+        list.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        if (focusTrigger) trigger.focus();
+      }
+
+      trigger.addEventListener('click', function () {
+        list.hidden ? open() : close(true);
+      });
+
+      trigger.addEventListener('keydown', function (e) {
+        if (['ArrowDown', 'ArrowUp', 'Enter', ' '].indexOf(e.key) !== -1) {
+          e.preventDefault();
+          open();
+        }
+      });
+
+      list.addEventListener('keydown', function (e) {
+        switch (e.key) {
+          case 'ArrowRight': case 'ArrowDown': e.preventDefault(); setActive(active + 1); break;
+          case 'ArrowLeft': case 'ArrowUp': e.preventDefault(); setActive(active - 1); break;
+          case 'Home': e.preventDefault(); setActive(0); break;
+          case 'End': e.preventDefault(); setActive(items.length - 1); break;
+          case 'Enter': case ' ': e.preventDefault(); choose(active); close(true); break;
+          case 'Escape': e.preventDefault(); close(true); break;
+          case 'Tab': close(false); break;
+        }
+      });
+
+      document.addEventListener('click', function (e) {
+        if (!list.hidden && !picker.contains(e.target)) close(false);
+      });
+
+      render();
+    })();
+  </script>
+
 </body>
 
