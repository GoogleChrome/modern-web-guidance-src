+  <script>
+    (function () {
+      var panel = document.querySelector('.seasonal-panel');
+      var toc = document.querySelector('.toc-sidebar');
+      if (!panel || !toc) return;
+
+      var sections = Array.prototype.slice.call(panel.querySelectorAll('.drink-section'));
+      var links = Array.prototype.slice.call(toc.querySelectorAll('a[href^="#"]'));
+      var linkById = {};
+      links.forEach(function (link) {
+        linkById[decodeURIComponent(link.getAttribute('href').slice(1))] = link;
+      });
+
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var activeId = null;
+      var lockedTarget = null; // set during click-initiated smooth scroll
+      var lockTimer = null;
+
+      function setActive(id) {
+        if (!id || id === activeId || !linkById[id]) return;
+        activeId = id;
+        links.forEach(function (link) {
+          var on = link === linkById[id];
+          link.classList.toggle('is-active', on);
+          if (on) link.setAttribute('aria-current', 'true');
+          else link.removeAttribute('aria-current');
+        });
+      }
+
+      // Section whose top is closest to the panel's top edge (the snap point).
+      function currentSection() {
+        var panelTop = panel.getBoundingClientRect().top;
+        var best = sections[0], bestDist = Infinity;
+        sections.forEach(function (sec) {
+          var d = Math.abs(sec.getBoundingClientRect().top - panelTop);
+          if (d < bestDist) { bestDist = d; best = sec; }
+        });
+        // At the very bottom, the last section is current even if it can't reach the top.
+        if (panel.scrollTop + panel.clientHeight >= panel.scrollHeight - 2) best = sections[sections.length - 1];
+        return best;
+      }
+
+      function releaseLock() {
+        lockedTarget = null;
+        clearTimeout(lockTimer);
+        setActive(currentSection().id);
+      }
+
+      if ('IntersectionObserver' in window) {
+        var observer = new IntersectionObserver(function () {
+          if (lockedTarget) return;
+          setActive(currentSection().id);
+        }, { root: panel, threshold: [0, 0.25, 0.5, 0.75, 1] });
+        sections.forEach(function (sec) { observer.observe(sec); });
+      }
+
+      // Fallback / settle: re-evaluate when scrolling stops.
+      var scrollTimer = null;
+      panel.addEventListener('scroll', function () {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(function () {
+          if (lockedTarget) releaseLock();
+          else setActive(currentSection().id);
+        }, 120);
+      }, { passive: true });
+      panel.addEventListener('scrollend', function () {
+        if (lockedTarget) releaseLock();
+      });
+
+      function scrollToSection(sec, smooth) {
+        var top = sec.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop;
+        panel.scrollTo({ top: top, behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto' });
+      }
+
+      links.forEach(function (link) {
+        link.addEventListener('click', function (e) {
+          var id = decodeURIComponent(link.getAttribute('href').slice(1));
+          var sec = document.getElementById(id);
+          if (!sec || !panel.contains(sec)) return;
+          e.preventDefault();
+
+          setActive(id);
+          lockedTarget = id;
+          clearTimeout(lockTimer);
+          lockTimer = setTimeout(releaseLock, 1200); // safety net if no scroll occurs
+
+          scrollToSection(sec, true);
+          // Move focus for keyboard/screen-reader users without a jump.
+          sec.focus({ preventScroll: true });
+          if (history.replaceState) history.replaceState(null, '', '#' + id);
+        });
+      });
+
+      // Honor a deep link on load (e.g. /#cold-brew).
+      var initial = decodeURIComponent(location.hash.slice(1));
+      var initialSec = initial && document.getElementById(initial);
+      if (initialSec && panel.contains(initialSec)) {
+        scrollToSection(initialSec, false);
+        setActive(initial);
+      } else {
+        setActive(sections[0].id);
+      }
+    })();
+  </script>
