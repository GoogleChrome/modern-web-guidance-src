+  <script type="module">
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a[href^="#"]')];
+    const headers = [...panel.querySelectorAll('.drink-section > header')];
+    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    // Single source of truth: aria-current drives both a11y state and the visual highlight.
+    function setActive(id) {
+      for (const link of links) {
+        if (link.hash === `#${id}`) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      }
+    }
+
+    const sectionIdOf = (header) => header.closest('.drink-section').id;
+
+    // Click: smoothly scroll only the panel (not the page) to the section header.
+    for (const link of links) {
+      link.addEventListener('click', (event) => {
+        const section = document.getElementById(link.hash.slice(1));
+        const header = section?.querySelector(':scope > header');
+        if (!header) return;
+        event.preventDefault();
+        const top = header.getBoundingClientRect().top - panel.getBoundingClientRect().top
+          + panel.scrollTop - parseFloat(getComputedStyle(header).scrollMarginTop || 0);
+        panel.scrollTo({ top, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+        // Move focus into the section for keyboard/AT users without a second jump.
+        header.focus({ preventScroll: true });
+        setActive(section.id);
+      });
+    }
+
+    if ('onscrollsnapchange' in HTMLElement.prototype) {
+      // Fires once the panel settles on a new snap target.
+      panel.addEventListener('scrollsnapchange', (event) => {
+        const header = event.snapTargetBlock;
+        if (header && headers.includes(header)) setActive(sectionIdOf(header));
+      });
+    } else {
+      // Fallback: track whichever header sits closest to the top of the panel.
+      const pickTop = () => {
+        const panelTop = panel.getBoundingClientRect().top;
+        let best, bestDist = Infinity;
+        for (const header of headers) {
+          const { top, bottom } = header.getBoundingClientRect();
+          if (bottom < panelTop) continue; // scrolled past
+          const dist = Math.abs(top - panelTop);
+          if (dist < bestDist) { best = header; bestDist = dist; }
+        }
+        if (best) setActive(sectionIdOf(best));
+      };
+      const observer = new IntersectionObserver(pickTop, {
+        root: panel,
+        threshold: [0, 0.5, 1],
+      });
+      headers.forEach((header) => observer.observe(header));
+      panel.addEventListener('scrollend', pickTop);
+    }
+  </script>
+
