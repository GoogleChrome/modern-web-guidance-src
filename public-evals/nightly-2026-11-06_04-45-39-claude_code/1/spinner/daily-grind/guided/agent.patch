+  <!-- Polite live region announces the busy state to screen reader users -->
+  <div id="loading-status" class="visually-hidden" role="status"></div>
+
+  <script>
+    (() => {
+      const status = document.getElementById('loading-status');
+
+      function setBusy(link) {
+        const region = link.closest('.card, .hero');
+        const drink = link.closest('.card')?.querySelector('h3')?.textContent;
+        const label = link.dataset.loadingLabel + (drink ? ` for ${drink}` : '');
+
+        const spinner = document.createElement('progress');
+        spinner.className = 'loading-spinner';
+        spinner.setAttribute('aria-label', label);
+        link.append(spinner);
+
+        link.setAttribute('aria-disabled', 'true');
+        region?.setAttribute('aria-busy', 'true');
+        status.textContent = `${label}…`;
+      }
+
+      function clearBusy() {
+        document.querySelectorAll('.loading-spinner').forEach((el) => el.remove());
+        document.querySelectorAll('[data-loading-label][aria-disabled]').forEach((el) => el.removeAttribute('aria-disabled'));
+        document.querySelectorAll('[aria-busy]').forEach((el) => el.removeAttribute('aria-busy'));
+        status.textContent = '';
+      }
+
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest('a[data-loading-label]');
+        if (!link) return;
+        // Ignore clicks that open a new tab/window — this page isn't navigating.
+        if (event.defaultPrevented || event.button !== 0 ||
+            event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        // Prevent duplicate requests while already loading.
+        if (link.getAttribute('aria-disabled') === 'true') {
+          event.preventDefault();
+          return;
+        }
+        setBusy(link);
+      });
+
+      // Reset if the page is restored from the back/forward cache.
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) clearBusy();
+      });
+    })();
+  </script>
+
