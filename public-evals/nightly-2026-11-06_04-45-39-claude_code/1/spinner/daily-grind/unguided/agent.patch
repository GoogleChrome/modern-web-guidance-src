+  <div id="loading-status" class="visually-hidden" role="status" aria-live="polite"></div>
+
+  <script>
+    (function () {
+      var status = document.getElementById('loading-status');
+      var buttons = document.querySelectorAll('a.btn[data-loading-text]');
+
+      function setLoading(btn, loading) {
+        var label = btn.querySelector('.btn-label');
+        var region = btn.closest('.grid');
+        if (loading) {
+          if (!btn.dataset.originalLabel) btn.dataset.originalLabel = label.textContent;
+          if (!btn.dataset.originalAria && btn.hasAttribute('aria-label')) {
+            btn.dataset.originalAria = btn.getAttribute('aria-label');
+          }
+          btn.classList.add('is-loading');
+          btn.setAttribute('aria-disabled', 'true');
+          btn.setAttribute('aria-busy', 'true');
+          btn.setAttribute('aria-label', btn.dataset.loadingText);
+          label.textContent = 'Loading…';
+          if (region) region.setAttribute('aria-busy', 'true');
+          status.textContent = btn.dataset.loadingText;
+        } else {
+          btn.classList.remove('is-loading');
+          btn.removeAttribute('aria-disabled');
+          btn.removeAttribute('aria-busy');
+          if (btn.dataset.originalAria) btn.setAttribute('aria-label', btn.dataset.originalAria);
+          else btn.removeAttribute('aria-label');
+          if (btn.dataset.originalLabel) label.textContent = btn.dataset.originalLabel;
+          if (region) region.removeAttribute('aria-busy');
+          status.textContent = '';
+        }
+      }
+
+      buttons.forEach(function (btn) {
+        btn.addEventListener('click', function (e) {
+          // Let new-tab / new-window clicks behave normally without a spinner.
+          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+          if (btn.classList.contains('is-loading')) {
+            e.preventDefault(); // ignore repeat clicks while navigating
+            return;
+          }
+          setLoading(btn, true);
+        });
+      });
+
+      // Reset if the page is restored from the back/forward cache.
+      window.addEventListener('pageshow', function (e) {
+        if (e.persisted) buttons.forEach(function (btn) { setLoading(btn, false); });
+      });
+    })();
+  </script>
