+    /* Loading state */
+    .btn {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      gap: 0.5em;
+    }
+
+    .btn.is-loading {
+      cursor: progress;
+      opacity: 0.85;
+    }
+
+    .btn.is-loading:hover {
+      background: var(--primary);
+    }
+
+    .spinner {
+      display: none;
+      flex: none;
+      width: 1em;
+      height: 1em;
+      border: 2px solid currentColor;
+      border-right-color: transparent;
+      border-radius: 50%;
+    }
+
+    .btn.is-loading .spinner {
+      display: inline-block;
+      /* Only transform is animated so it stays on the compositor;
+         the animation only exists while the button is loading. */
+      animation: spin 0.75s linear infinite;
+    }
+
+    @keyframes spin {
+      to {
+        transform: rotate(360deg);
+      }
+    }
+
+    @keyframes pulse {
+      50% {
+        opacity: 0.35;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .btn.is-loading .spinner {
+        /* No rotation: a slow, gentle fade still signals activity. */
+        animation: pulse 2s ease-in-out infinite;
+      }
+
+      .btn,
+      nav a {
+        transition: none;
+      }
+    }
+
+    .visually-hidden {
+      position: absolute !important;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0, 0, 0, 0);
+      white-space: nowrap;
+      border: 0;
+    }
