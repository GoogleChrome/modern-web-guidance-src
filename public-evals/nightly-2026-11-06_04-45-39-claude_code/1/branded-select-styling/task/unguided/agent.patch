+    /* Roast Selector */
+    .roast-selector {
+      position: relative;
+      margin: 1.25rem 0 0.25rem;
+      width: 240px;
+      text-align: left;
+    }
+
+    .roast-label {
+      display: block;
+      font-size: 0.85rem;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      color: var(--accent);
+      margin-bottom: 6px;
+      text-align: center;
+    }
+
+    .roast-trigger {
+      width: 100%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      background: var(--primary);
+      color: white;
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      padding: 10px 14px;
+      font: inherit;
+      font-size: 1rem;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    .roast-trigger:hover {
+      background: #3e2723;
+    }
+
+    .roast-trigger:focus-visible,
+    .roast-option:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .roast-arrow {
+      width: 14px;
+      height: 14px;
+      flex-shrink: 0;
+      color: var(--accent);
+      transition: transform 0.2s;
+    }
+
+    .roast-trigger[aria-expanded="true"] .roast-arrow {
+      transform: rotate(180deg);
+    }
+
+    .roast-list {
+      position: absolute;
+      top: calc(100% + 4px);
+      left: 0;
+      right: 0;
+      list-style: none;
+      background: var(--primary);
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
+      overflow: hidden;
+      z-index: 10;
+    }
+
+    .roast-list[hidden] {
+      display: none;
+    }
+
+    .roast-option {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding: 10px 14px;
+      color: white;
+      cursor: pointer;
+    }
+
+    .roast-option.active {
+      background: #3e2723;
+      color: var(--accent);
+    }
+
+    .roast-option[aria-selected="true"] {
+      color: var(--accent);
+      font-weight: bold;
+    }
+
+    .roast-check {
+      width: 16px;
+      height: 16px;
+      color: var(--accent);
+      visibility: hidden;
+    }
+
+    .roast-option[aria-selected="true"] .roast-check {
+      visibility: visible;
+    }
+
