+    /* Seasonal Favorites: drink cards adapt to their own width (container queries) */
+    .drink-grid {
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
+    }
+
+    .drink-card-wrap {
+      container-type: inline-size;
+      container-name: drink-card;
+      display: flex;
+    }
+
+    .drink-card {
+      display: flex;
+      flex-direction: column;
+      width: 100%;
+      padding: 0;
+      overflow: hidden;
+      text-align: center;
+    }
+
+    .drink-card__media {
+      aspect-ratio: 16 / 10;
+      background: var(--secondary);
+    }
+
+    .drink-card__media img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    .drink-card__body {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      flex: 1;
+      padding: 20px;
+    }
+
+    .drink-card__body p {
+      flex: 1;
+    }
+
+    .drink-card__tag {
+      display: inline-block;
+      font-size: 0.7rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      color: var(--primary);
+      background: #fff3e0;
+      border-radius: 999px;
+      padding: 2px 10px;
+      margin-bottom: 8px;
+    }
+
+    /* Wide card: image beside content */
+    @container drink-card (min-width: 480px) {
+      .drink-card {
+        flex-direction: row;
+        text-align: left;
+      }
+
+      .drink-card__media {
+        flex: 0 0 40%;
+        aspect-ratio: auto;
+        min-height: 200px;
+      }
+
+      .drink-card__body {
+        align-items: flex-start;
+        justify-content: center;
+        padding: 24px 28px;
+      }
+
+      .drink-card__body h3 {
+        font-size: 1.4rem;
+      }
+    }
+
+    /* Extra-wide card: more breathing room */
+    @container drink-card (min-width: 720px) {
+      .drink-card__media {
+        flex-basis: 45%;
+        min-height: 260px;
+      }
+
+      .drink-card__body {
+        padding: 32px 40px;
+      }
+
+      .drink-card__body h3 {
+        font-size: 1.75rem;
+      }
+
+      .drink-card__body p {
+        font-size: 1.05rem;
+        flex: 0 0 auto;
+      }
+    }
+
