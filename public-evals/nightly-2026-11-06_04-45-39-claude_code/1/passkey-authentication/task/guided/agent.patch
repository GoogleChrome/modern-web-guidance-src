+  <script type="module">
+    // Ensures getClientCapabilities / parseRequestOptionsFromJSON / toJSON exist
+    // in every browser that supports PublicKeyCredential.
+    import 'https://esm.sh/webauthn-polyfills';
+
+    const OPTIONS_ENDPOINT = '/api/login/options';
+    const VERIFY_ENDPOINT = '/api/login/verify';
+
+    const form = document.getElementById('signin-form');
+    const button = document.getElementById('passkey-button');
+    const statusEl = document.getElementById('auth-status');
+
+    let autofillAbortController = new AbortController();
+    let signedIn = false;
+
+    function setStatus(message, state = '') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    async function fetchRequestOptions() {
+      const res = await fetch(OPTIONS_ENDPOINT, {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      });
+      if (!res.ok) throw new Error(`Could not load sign-in options (${res.status})`);
+      const json = await res.json();
+      // Accept either the bare options object or { publicKey: {...} }.
+      return PublicKeyCredential.parseRequestOptionsFromJSON(json.publicKey ?? json);
+    }
+
+    // Sends the assertion to the server and updates the UI. Returns true on success.
+    async function verifyCredential(credential, publicKey) {
+      const encoded = credential.toJSON();
+      let res;
+      try {
+        res = await fetch(VERIFY_ENDPOINT, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(encoded),
+        });
+      } catch (err) {
+        console.error('Verification request error:', err);
+        setStatus('Network error. Please try again.', 'error');
+        return false;
+      }
+
+      if (!res.ok) {
+        if (res.status === 404) {
+          // Credential no longer exists on the server: tell the passkey provider
+          // so it stops offering it. Runs pre-authentication.
+          if (PublicKeyCredential.signalUnknownCredential) {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: publicKey.rpId, // Server-provided RP ID, never location.hostname
+                credentialId: encoded.id, // Base64URL string
+              });
+            } catch (err) {
+              console.warn('signalUnknownCredential failed:', err);
+            }
+          }
+          setStatus('This passkey is no longer registered. Please use another sign-in method.', 'error');
+        } else {
+          setStatus('Sign-in failed. Please try again.', 'error');
+        }
+        return false;
+      }
+
+      let data = {};
+      try { data = await res.json(); } catch { /* empty body is fine */ }
+      const name = data.username ?? data.user?.username ?? data.displayName ?? data.user?.displayName;
+      signedIn = true;
+      setStatus(name ? `Signed in as ${name}` : 'Signed in successfully', 'success');
+      button.disabled = true;
+      return true;
+    }
+
+    // Conditional UI: offer passkeys in the username field's autofill dropdown.
+    async function initializeConditionalAutofill() {
+      if (signedIn || !window.PublicKeyCredential) return;
+
+      let capabilities;
+      try {
+        capabilities = await PublicKeyCredential.getClientCapabilities();
+      } catch {
+        return;
+      }
+      if (capabilities.conditionalGet !== true) return;
+
+      const { signal } = autofillAbortController;
+      let publicKey;
+      let credential;
+      try {
+        publicKey = await fetchRequestOptions();
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal,
+          mediation: 'conditional',
+        });
+      } catch (err) {
+        if (['NotAllowedError', 'AbortError'].includes(err.name)) return;
+        console.error('Unexpected conditional get error:', err);
+        return;
+      }
+
+      setStatus('Verifying…');
+      const ok = await verifyCredential(credential, publicKey);
+      if (!ok) initializeConditionalAutofill();
+    }
+
+    // Explicit button: show the passkey / biometric prompt immediately.
+    async function triggerButtonAuthentication() {
+      if (!window.PublicKeyCredential) {
+        setStatus('Passkeys are not supported in this browser.', 'error');
+        return;
+      }
+
+      // Cancel the pending conditional request so the two don't collide.
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      button.disabled = true;
+      setStatus('');
+      let publicKey;
+      let credential;
+      try {
+        publicKey = await fetchRequestOptions();
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        button.disabled = false;
+        if (err.name === 'NotAllowedError') {
+          setStatus('Passkey sign-in was cancelled.');
+        } else if (err.name !== 'AbortError') {
+          console.error(err);
+          setStatus('Could not sign in with a passkey. Please try again.', 'error');
+        }
+        // Re-arm autofill suggestions after a cancelled/failed prompt.
+        initializeConditionalAutofill();
+        return;
+      }
+
+      setStatus('Verifying…');
+      const ok = await verifyCredential(credential, publicKey);
+      if (!ok) {
+        button.disabled = false;
+        initializeConditionalAutofill();
+      }
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      triggerButtonAuthentication();
+    });
+
+    initializeConditionalAutofill();
+  </script>
+
 </body>
 
