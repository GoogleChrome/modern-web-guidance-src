+  <script>
+    (() => {
+      const OPTIONS_URL = '/api/login/options';
+      const VERIFY_URL = '/api/login/verify';
+
+      const form = document.getElementById('signin-form');
+      const usernameField = document.getElementById('username');
+      const authButton = document.getElementById('auth-button');
+      const statusEl = document.getElementById('auth-status');
+
+      let conditionalAbort = null;
+
+      function setStatus(message, type = '') {
+        statusEl.textContent = message;
+        statusEl.className = 'auth-status' + (type ? ' ' + type : '');
+      }
+
+      // --- base64url helpers (fallback when JSON helpers are unavailable) ---
+      function b64urlToBuffer(value) {
+        const b64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = b64 + '='.repeat((4 - (b64.length % 4)) % 4);
+        const bin = atob(padded);
+        const bytes = new Uint8Array(bin.length);
+        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function bufferToB64url(buffer) {
+        const bytes = new Uint8Array(buffer);
+        let bin = '';
+        for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
+        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function parseRequestOptions(json) {
+        if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(json);
+        }
+        return {
+          ...json,
+          challenge: b64urlToBuffer(json.challenge),
+          allowCredentials: (json.allowCredentials || []).map((c) => ({
+            ...c,
+            id: b64urlToBuffer(c.id),
+          })),
+        };
+      }
+
+      function credentialToJSON(cred) {
+        if (typeof cred.toJSON === 'function') {
+          try { return cred.toJSON(); } catch (_) { /* fall through */ }
+        }
+        const r = cred.response;
+        return {
+          id: cred.id,
+          rawId: bufferToB64url(cred.rawId),
+          type: cred.type,
+          authenticatorAttachment: cred.authenticatorAttachment || null,
+          clientExtensionResults: cred.getClientExtensionResults ? cred.getClientExtensionResults() : {},
+          response: {
+            clientDataJSON: bufferToB64url(r.clientDataJSON),
+            authenticatorData: bufferToB64url(r.authenticatorData),
+            signature: bufferToB64url(r.signature),
+            userHandle: r.userHandle ? bufferToB64url(r.userHandle) : null,
+          },
+        };
+      }
+
+      async function fetchRequestOptions() {
+        const res = await fetch(OPTIONS_URL, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({}),
+        });
+        if (!res.ok) throw new Error('Could not start sign-in (' + res.status + ')');
+        const json = await res.json();
+        // Accept either { publicKey: {...} } or the options object directly.
+        return json.publicKey || json;
+      }
+
+      async function verifyCredential(credential) {
+        const res = await fetch(VERIFY_URL, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(credentialToJSON(credential)),
+        });
+        let data = {};
+        try { data = await res.json(); } catch (_) { /* empty body */ }
+        if (!res.ok || data.verified === false) {
+          throw new Error(data.error || data.message || 'Verification failed');
+        }
+        return data;
+      }
+
+      function onSuccess(data) {
+        const name = (data && (data.username || (data.user && (data.user.name || data.user.username)))) ||
+          usernameField.value.trim();
+        setStatus(name ? 'Signed in as ' + name + '.' : 'Signed in successfully.', 'success');
+        if (name) usernameField.value = name;
+      }
+
+      async function authenticate(mediation) {
+        const json = await fetchRequestOptions();
+        const publicKey = parseRequestOptions(json);
+        const options = { publicKey };
+
+        if (mediation === 'conditional') {
+          // Discoverable credentials only; let the browser list them in autofill.
+          publicKey.allowCredentials = [];
+          conditionalAbort = new AbortController();
+          options.mediation = 'conditional';
+          options.signal = conditionalAbort.signal;
+        } else {
+          // Explicit button: always demand biometrics / device PIN.
+          publicKey.userVerification = 'required';
+        }
+
+        const credential = await navigator.credentials.get(options);
+        if (!credential) throw new Error('No credential returned');
+        if (mediation !== 'conditional') setStatus('Verifying…');
+        const data = await verifyCredential(credential);
+        onSuccess(data);
+      }
+
+      // --- Conditional UI: passkeys offered as autofill suggestions on the username field ---
+      async function startConditionalUI() {
+        if (!window.PublicKeyCredential ||
+          typeof PublicKeyCredential.isConditionalMediationAvailable !== 'function') {
+          return;
+        }
+        try {
+          if (!(await PublicKeyCredential.isConditionalMediationAvailable())) return;
+          await authenticate('conditional');
+        } catch (err) {
+          // AbortError is expected when the explicit button takes over.
+          if (err && err.name === 'AbortError') return;
+          if (err && err.name === 'NotAllowedError') return; // user dismissed autofill
+          console.error('Passkey autofill error:', err);
+          setStatus(err.message || 'Passkey sign-in failed.', 'error');
+        } finally {
+          conditionalAbort = null;
+        }
+      }
+
+      // --- Explicit button: prompt for biometrics / device unlock directly ---
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+
+        if (!window.PublicKeyCredential || !navigator.credentials) {
+          setStatus('Passkeys are not supported in this browser.', 'error');
+          return;
+        }
+
+        // Only one WebAuthn request may be pending; cancel the autofill request.
+        if (conditionalAbort) {
+          const err = new Error('Switching to modal passkey sign-in');
+          err.name = 'AbortError';
+          conditionalAbort.abort(err);
+          conditionalAbort = null;
+        }
+
+        authButton.disabled = true;
+        setStatus('Waiting for your passkey…');
+        try {
+          await authenticate('required');
+        } catch (err) {
+          if (err && err.name === 'NotAllowedError') {
+            setStatus('Sign-in was cancelled or timed out.', 'error');
+          } else {
+            console.error('Passkey sign-in error:', err);
+            setStatus((err && err.message) || 'Passkey sign-in failed.', 'error');
+          }
+          // Re-arm autofill so the field keeps offering passkeys.
+          startConditionalUI();
+        } finally {
+          authButton.disabled = false;
+        }
+      });
+
+      startConditionalUI();
+    })();
+  </script>
+
 </body>
 
