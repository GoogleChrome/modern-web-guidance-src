+  <script>
+    /*
+     * Integrity-checked loader for fonts and images.
+     *
+     * <img> and CSS url()/@font-face have no `integrity` attribute, so these
+     * assets are fetched with the Fetch API instead: `integrity` makes the
+     * browser verify the SHA-384 digest before handing over any bytes (a
+     * mismatch rejects the promise), `credentials: "omit"` sends no cookies,
+     * and `referrerPolicy: "no-referrer"` sends no Referer header. Only
+     * verified bytes are ever rendered; on failure the CSS placeholder stays.
+     *
+     * Unsplash's image CDN can serve more than one byte-for-byte encoding of
+     * the same URL depending on the edge node, so some entries list every
+     * known-good digest (SRI passes if any one matches).
+     */
+    (function () {
+      'use strict';
+
+      var CDN = 'https://cdn.jsdelivr.net/npm/';
+      var IMG = 'https://images.unsplash.com/';
+
+      var FONTS = [
+        {
+          family: 'Inter', weight: '400',
+          url: CDN + '@fontsource/inter@5.1.0/files/inter-latin-400-normal.woff2',
+          integrity: 'sha384-gijdfLnskrcqcIndQ6U0wywZhUSIKgq2K0bDl2N/4Plpfkgl7oO1RicuX/dbCo8B'
+        },
+        {
+          family: 'Playfair Display', weight: '700',
+          url: CDN + '@fontsource/playfair-display@5.1.0/files/playfair-display-latin-700-normal.woff2',
+          integrity: 'sha384-2OUMztuc2Uvfq3n8w2APnig7JM4X9miM/re2XmGSZqKU6gdoOGFHDSiACwWV1wfK'
+        }
+      ];
+
+      var IMAGES = {
+        hero: {
+          url: IMG + 'photo-1495474472287-4d71bcdd2085?fm=jpg&fit=crop&w=1600&q=80',
+          integrity: 'sha384-tgwFdfk1lX9NxtsFq0WNIBV2Mlc8yAC+w1oe6GkyAMcCPDG+Eo67Qc4W6tR3siW2 ' +
+                     'sha384-tuL/1QLAa5KjoiExRLPluWMXSbJJ4U2j9YQYXBZg0T6B1NKvfyN8dmfAs12O6ORw'
+        },
+        latte: {
+          url: IMG + 'photo-1541167760496-1628856ab772?fm=jpg&fit=crop&w=600&q=80',
+          integrity: 'sha384-2WFWQLT/1Eqcaxll4bOFYFCC7h/cBXjjJnnmjOV+LCv2DD2clo3PTPGoTN08yR3F ' +
+                     'sha384-wcPMJAjjpaGTTtnFcnR2nbQjOkw+xSQfiyf4RP+6Q19UjmEteuc1Wa3OS1u053vt'
+        },
+        espresso: {
+          url: IMG + 'photo-1510707577719-ae7c14805e3a?fm=jpg&fit=crop&w=600&q=80',
+          integrity: 'sha384-wqGHChbcB+Va9BNMq8h0BtppueEH5J6RxXVw812ezagRlAVbtRiItVxNYYHsYbP5'
+        },
+        coldBrew: {
+          url: IMG + 'photo-1461023058943-07fcbe16d735?fm=jpg&fit=crop&w=600&q=80',
+          integrity: 'sha384-BjAkDYkLcHDcZPc+o/aK6nUxFh3ow4hC1WCSUkefnlstC6Mz+Btb1r6tAWhepxbg'
+        }
+      };
+
+      function verifiedFetch(asset) {
+        return fetch(asset.url, {
+          integrity: asset.integrity,
+          mode: 'cors',
+          credentials: 'omit',
+          referrerPolicy: 'no-referrer'
+        }).then(function (res) {
+          if (!res.ok) throw new Error('HTTP ' + res.status);
+          return res;
+        });
+      }
+
+      function warn(asset, err) {
+        console.warn('[integrity] Not using ' + asset.url + ':', err);
+      }
+
+      // Fonts: register verified bytes directly via the CSS Font Loading API.
+      if ('FontFace' in window && document.fonts) {
+        FONTS.forEach(function (font) {
+          verifiedFetch(font)
+            .then(function (res) { return res.arrayBuffer(); })
+            .then(function (buf) {
+              var face = new FontFace(font.family, buf, { weight: font.weight, style: 'normal' });
+              return face.load();
+            })
+            .then(function (face) { document.fonts.add(face); })
+            .catch(function (err) { warn(font, err); });
+        });
+      }
+
+      function loadImage(asset) {
+        return verifiedFetch(asset)
+          .then(function (res) { return res.blob(); })
+          .then(function (blob) { return URL.createObjectURL(blob); });
+      }
+
+      // Hero background.
+      var hero = document.querySelector('.hero');
+      if (hero) {
+        loadImage(IMAGES.hero)
+          .then(function (src) { hero.style.setProperty('--hero-image', 'url("' + src + '")'); })
+          .catch(function (err) { warn(IMAGES.hero, err); });
+      }
+
+      // Seasonal card images.
+      document.querySelectorAll('img[data-asset]').forEach(function (img) {
+        var asset = IMAGES[img.getAttribute('data-asset')];
+        if (!asset) return;
+        loadImage(asset)
+          .then(function (src) {
+            img.addEventListener('load', function () { img.classList.add('is-loaded'); }, { once: true });
+            img.src = src;
+          })
+          .catch(function (err) { warn(asset, err); });
+      });
+
+      // Icons: only rendered if the SRI-checked Feather script executed.
+      window.addEventListener('DOMContentLoaded', function () {
+        if (window.feather) window.feather.replace({ 'aria-hidden': 'true' });
+      });
+    })();
+  </script>
+
