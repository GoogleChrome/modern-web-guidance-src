+    /* Vertical media scroller */
+    .media-section {
+      margin-top: 60px;
+    }
+
+    .media-scroller {
+      position: relative; /* makes the scroller the offsetParent of its cards */
+      max-width: 640px;
+      height: 520px;
+      margin: 20px auto 0;
+      padding: 16px;
+      overflow-y: auto;
+      overscroll-behavior: contain;
+      scroll-behavior: auto; /* never animate the initial positioning */
+      display: flex;
+      flex-direction: column;
+      gap: 20px;
+      background: var(--secondary);
+      border-radius: 8px;
+    }
+
+    .media-card {
+      flex: 0 0 auto;
+      background: white;
+      border-radius: 8px;
+      overflow: hidden;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .media-card img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 600 / 400;
+      object-fit: cover;
+      background: #bcaaa4; /* placeholder tone while the image loads */
+    }
+
+    .media-card .media-body {
+      padding: 14px 18px;
+    }
+
+    .media-card h3 {
+      color: var(--primary);
+      margin-bottom: 4px;
+    }
+
+    .media-card.target {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
     footer {
       background: var(--secondary);
