+      <script>
+        // Fallback for browsers without scroll-initial-target (Firefox, Safari).
+        // Runs synchronously during parsing, before first paint, so there is no
+        // visible jump. Sets scrollTop on the feed only, so the page itself
+        // isn't scrolled (unlike scrollIntoView).
+        (() => {
+          if (CSS.supports("scroll-initial-target", "nearest")) return;
+          const feed = document.getElementById("media-feed");
+          const target = feed.querySelector(".target");
+          const offset = target.getBoundingClientRect().top - feed.getBoundingClientRect().top;
+          feed.scrollTop += offset - (feed.clientHeight - target.offsetHeight) / 2;
+        })();
+      </script>
