     .btn:hover {
       background: #3e2723;
     }
 
+    /* Media feed: vertical scroll container */
+    .media-feed {
+      max-width: 480px;
+      height: 420px;
+      margin: 20px auto 0;
+      padding: 12px;
+      display: flex;
+      flex-direction: column;
+      gap: 16px;
+      overflow-y: auto;
+      overscroll-behavior: contain;
+      scroll-behavior: auto; /* never animate the initial positioning */
+      scroll-snap-type: y proximity;
+      background: var(--secondary);
+      border-radius: 8px;
+    }
+
+    .media-card {
+      flex: none;
+      background: white;
+      border-radius: 8px;
+      overflow: hidden;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      scroll-snap-align: center;
+    }
+
+    .media-card img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 3 / 2;
+      object-fit: cover;
+    }
+
+    .media-card figcaption {
+      padding: 10px 14px;
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    /* Start the feed with the featured card in view (no JS, no animation) */
+    .media-card.target {
+      scroll-initial-target: nearest;
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
