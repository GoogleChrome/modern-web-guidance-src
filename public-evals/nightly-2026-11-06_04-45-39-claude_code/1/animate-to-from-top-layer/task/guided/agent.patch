+  <div id="ordering-info" class="info-overlay" popover role="status">
+    <p><span aria-hidden="true">&#9432;</span> online ordering is currently offline</p>
+    <button type="button" class="dialog-close" id="close-overlay-btn" aria-label="Dismiss">&times;</button>
+  </div>
+
+  <script>
+    // Browsers without discrete display/overlay transitions (Firefox, Safari) need the
+    // exit transition run manually via [data-closing] before leaving the top layer.
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) return false;
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    function supportsTopLayerExit() {
+      return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+    }
+
+    async function closeTopLayer(el) {
+      if (!supportsTopLayerExit()) {
+        el.setAttribute('data-closing', '');
+        const animations = el.getAnimations({ subtree: true });
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+        if (!el.hasAttribute('data-closing')) return;
+        el.removeAttribute('data-closing');
+      }
+      if (el instanceof HTMLDialogElement) el.close();
+      else el.hidePopover();
+    }
+
+    // Logout confirmation modal
+    const logoutDialog = document.getElementById('logout-dialog');
+    document.getElementById('open-dialog-btn').addEventListener('click', (event) => {
+      event.preventDefault(); // without JS the link still goes straight to /logout
+      logoutDialog.removeAttribute('data-closing');
+      logoutDialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', () => closeTopLayer(logoutDialog));
+    logoutDialog.querySelector('[data-dialog-cancel]').addEventListener('click', () => closeTopLayer(logoutDialog));
+    logoutDialog.addEventListener('cancel', (event) => {
+      event.preventDefault(); // route Esc through the animated close
+      closeTopLayer(logoutDialog);
+    });
+
+    // Floating ordering-status overlay (opened via popovertarget on #foobar)
+    const orderingInfo = document.getElementById('ordering-info');
+    document.getElementById('close-overlay-btn').addEventListener('click', () => closeTopLayer(orderingInfo));
+  </script>
+
+  <script type="module">
+    if (!('popover' in HTMLElement.prototype)) {
+      import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+  </script>
