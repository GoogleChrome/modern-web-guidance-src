+    <p id="logout-desc">Are you sure you want to log out of your Daily Grind account?</p>
+    <div class="dialog-actions">
+      <button type="button" class="btn btn-secondary" data-dialog-cancel autofocus>Stay signed in</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
