+  <dialog class="modal" id="logout-dialog" aria-labelledby="logout-dialog-title" aria-describedby="logout-dialog-desc">
+    <div class="modal-body">
+      <button type="button" class="icon-close" id="close-dialog-btn" aria-label="Close">&times;</button>
+      <h2 id="logout-dialog-title">Log out?</h2>
+      <p id="logout-dialog-desc">Are you sure you want to log out of your Daily Grind account?</p>
+      <div class="modal-actions">
+        <button type="button" class="btn btn-secondary" data-dismiss-dialog>Cancel</button>
+        <a href="/logout" class="btn">Log Out</a>
+      </div>
+    </div>
+  </dialog>
+
+  <div class="info-overlay" id="info-overlay" role="status" aria-live="polite" aria-hidden="true">
+    <span class="info-icon" aria-hidden="true">i</span>
+    <p>online ordering is currently offline</p>
+    <button type="button" class="icon-close" id="info-overlay-close" aria-label="Dismiss">&times;</button>
+  </div>
+
+  <script>
+    (function () {
+      // ----- Logout confirmation modal -----
+      var dialog = document.getElementById('logout-dialog');
+      var openBtn = document.getElementById('open-dialog-btn');
+      var closeBtn = document.getElementById('close-dialog-btn');
+      var cancelBtn = dialog.querySelector('[data-dismiss-dialog]');
+
+      function closeDialog() {
+        if (!dialog.open || dialog.classList.contains('is-closing')) return;
+        dialog.classList.add('is-closing');
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          dialog.classList.remove('is-closing');
+          dialog.close();
+        }
+        dialog.addEventListener('animationend', function handler(e) {
+          if (e.target !== dialog) return;
+          dialog.removeEventListener('animationend', handler);
+          finish();
+        });
+        setTimeout(finish, 400); // fallback if animations are disabled
+      }
+
+      openBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        if (typeof dialog.showModal !== 'function') {
+          if (window.confirm('Are you sure you want to log out?')) window.location.href = openBtn.href;
+          return;
+        }
+        dialog.classList.remove('is-closing');
+        if (!dialog.open) dialog.showModal();
+      });
+
+      closeBtn.addEventListener('click', closeDialog);
+      cancelBtn.addEventListener('click', closeDialog);
+
+      // Animate Escape-key dismissal instead of closing instantly
+      dialog.addEventListener('cancel', function (e) {
+        e.preventDefault();
+        closeDialog();
+      });
+
+      // Close when clicking the backdrop
+      dialog.addEventListener('click', function (e) {
+        if (e.target === dialog) closeDialog();
+      });
+
+      // ----- Floating info overlay -----
+      var overlay = document.getElementById('info-overlay');
+      var overlayTrigger = document.getElementById('foobar');
+      var overlayClose = document.getElementById('info-overlay-close');
+
+      function showOverlay() {
+        overlay.classList.add('is-visible');
+        overlay.setAttribute('aria-hidden', 'false');
+        overlayTrigger.setAttribute('aria-expanded', 'true');
+      }
+
+      function hideOverlay() {
+        overlay.classList.remove('is-visible');
+        overlay.setAttribute('aria-hidden', 'true');
+        overlayTrigger.setAttribute('aria-expanded', 'false');
+      }
+
+      overlayTrigger.setAttribute('aria-expanded', 'false');
+      overlayTrigger.addEventListener('click', showOverlay);
+      overlayClose.addEventListener('click', hideOverlay);
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && overlay.classList.contains('is-visible') && !dialog.open) hideOverlay();
+      });
+    })();
+  </script>
+
