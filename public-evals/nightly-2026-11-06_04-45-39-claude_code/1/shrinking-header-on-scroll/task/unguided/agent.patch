+  <script>
+    /* Fallback for browsers lacking CSS scroll-driven animations. */
+    (function () {
+      var supports = window.CSS && CSS.supports;
+      if (supports && CSS.supports('animation-timeline: scroll()')) return; // native CSS handles it
+
+      var root = document.documentElement;
+      var nav = document.querySelector('nav');
+      if (!nav) return;
+
+      var useVars = !!(supports && CSS.supports('--nav-progress', '0'));
+      var distance = 200; // keep in sync with --nav-shrink-distance
+      var ticking = false;
+      var lastValue = -1;
+
+      root.className += useVars ? ' nav-fallback-vars' : ' nav-fallback-class';
+
+      function scrollTop() {
+        return window.pageYOffset || root.scrollTop || document.body.scrollTop || 0;
+      }
+
+      function update() {
+        ticking = false;
+        var y = scrollTop();
+        if (useVars) {
+          var p = Math.min(Math.max(y / distance, 0), 1);
+          p = Math.round(p * 1000) / 1000;
+          if (p !== lastValue) {
+            lastValue = p;
+            nav.style.setProperty('--nav-progress', p);
+          }
+        } else {
+          var compact = y > distance / 2 ? 1 : 0;
+          if (compact !== lastValue) {
+            lastValue = compact;
+            nav.className = compact ? 'is-compact' : '';
+          }
+        }
+      }
+
+      function onScroll() {
+        if (ticking) return;
+        ticking = true;
+        (window.requestAnimationFrame || function (cb) { return setTimeout(cb, 16); })(update);
+      }
+
+      window.addEventListener('scroll', onScroll, supportsPassive() ? { passive: true } : false);
+      window.addEventListener('resize', onScroll, false);
+      update();
+
+      function supportsPassive() {
+        var result = false;
+        try {
+          window.addEventListener('test', null, Object.defineProperty({}, 'passive', {
+            get: function () { result = true; return true; }
+          }));
+        } catch (e) { }
+        return result;
+      }
+    })();
+  </script>
