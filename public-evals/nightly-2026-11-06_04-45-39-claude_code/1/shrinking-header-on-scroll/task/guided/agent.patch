+  <script>
+    // Fallback for browsers without scroll-driven animations (e.g. older
+    // Chrome/Safari, Firefox): map scroll position to --shrink (0 → 1).
+    if (!(window.CSS && CSS.supports &&
+          CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)'))) {
+      var nav = document.querySelector('nav');
+      var reduceMotion = window.matchMedia &&
+        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+      if (nav && !reduceMotion) {
+        var distance = parseFloat(getComputedStyle(document.documentElement)
+          .getPropertyValue('--nav-shrink-distance')) || 32;
+        var ticking = false;
+
+        var update = function () {
+          var y = window.pageYOffset || document.documentElement.scrollTop;
+          var progress = Math.min(1, Math.max(0, y / distance));
+          nav.style.setProperty('--shrink', progress.toFixed(3));
+          ticking = false;
+        };
+
+        window.addEventListener('scroll', function () {
+          if (!ticking) {
+            ticking = true;
+            window.requestAnimationFrame(update);
+          }
+        }, { passive: true });
+
+        update(); // handle restored scroll position on reload
+      }
+    }
+  </script>
