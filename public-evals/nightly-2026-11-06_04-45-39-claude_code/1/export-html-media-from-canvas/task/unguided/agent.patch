+  <script>
+    (function () {
+      var card = document.getElementById('export_element');
+      var canvas = document.getElementById('gift_canvas');
+      var ctx = canvas.getContext('2d');
+      var form = document.getElementById('gc-form');
+      var nameInput = document.getElementById('gc-name-input');
+      var messageInput = document.getElementById('gc-message-input');
+      var messageCount = document.getElementById('gc-message-count');
+      var amountInput = document.getElementById('gc-amount-input');
+      var customColor = document.getElementById('gc-custom-color');
+      var exportBtn = document.getElementById('gc-export-btn');
+      var status = document.getElementById('gc-export-status');
+      var EXPORT_WIDTH = 1200; // px width of the exported image
+      var bgColor = '#4e342e';
+
+      function hexToRgb(hex) {
+        var n = parseInt(hex.replace('#', ''), 16);
+        return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
+      }
+
+      function isLight(hex) {
+        var c = hexToRgb(hex);
+        var lin = [c.r, c.g, c.b].map(function (v) {
+          v /= 255;
+          return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
+        });
+        return 0.2126 * lin[0] + 0.7152 * lin[1] + 0.0722 * lin[2] > 0.4;
+      }
+
+      // ---- Sync form values into the styled HTML card ----
+      function updateCard() {
+        var name = nameInput.value.trim();
+        var msg = messageInput.value.trim();
+        document.getElementById('gc-message').textContent = msg || 'Enjoy a cup on me!';
+        document.getElementById('gc-to').textContent = 'For: ' + (name || 'Someone Special');
+        document.getElementById('gc-amount').textContent = amountInput.value;
+        messageCount.textContent = messageInput.value.length + ' / ' + messageInput.maxLength;
+
+        var light = isLight(bgColor);
+        card.style.setProperty('--card-bg', bgColor);
+        card.style.setProperty('--card-ink', light ? '#3e2723' : '#ffffff');
+        card.style.setProperty('--card-ink-soft', light ? 'rgba(62, 39, 35, 0.75)' : 'rgba(255, 255, 255, 0.78)');
+        // Amber accent is unreadable on light cards; deepen it there.
+        card.style.setProperty('--accent', light ? '#a0522d' : '#ffab40');
+
+        scheduleRender();
+      }
+
+      // ---- Render the HTML card's elements into the canvas ----
+      function roundRectPath(c, x, y, w, h, r) {
+        r = Math.min(r, w / 2, h / 2);
+        c.beginPath();
+        c.moveTo(x + r, y);
+        c.arcTo(x + w, y, x + w, y + h, r);
+        c.arcTo(x + w, y + h, x, y + h, r);
+        c.arcTo(x, y + h, x, y, r);
+        c.arcTo(x, y, x + w, y, r);
+        c.closePath();
+      }
+
+      function wrapLines(c, text, maxWidth) {
+        var words = text.split(/\s+/);
+        var lines = [];
+        var line = '';
+        words.forEach(function (word) {
+          var test = line ? line + ' ' + word : word;
+          if (c.measureText(test).width <= maxWidth || !line) {
+            line = test;
+          } else {
+            lines.push(line);
+            line = word;
+          }
+          // Break single words that are wider than the box.
+          while (c.measureText(line).width > maxWidth && line.length > 1) {
+            var cut = line.length - 1;
+            while (cut > 1 && c.measureText(line.slice(0, cut)).width > maxWidth) cut--;
+            lines.push(line.slice(0, cut));
+            line = line.slice(cut);
+          }
+        });
+        if (line) lines.push(line);
+        return lines;
+      }
+
+      function drawText(c, el, box, scale) {
+        var cs = getComputedStyle(el);
+        var text = el.textContent.trim();
+        if (cs.textTransform === 'uppercase') text = text.toUpperCase();
+        var fontSize = parseFloat(cs.fontSize);
+        var lineHeight = cs.lineHeight === 'normal' ? fontSize * 1.2 : parseFloat(cs.lineHeight);
+        var padL = parseFloat(cs.paddingLeft), padR = parseFloat(cs.paddingRight), padT = parseFloat(cs.paddingTop);
+
+        c.save();
+        c.font = cs.fontStyle + ' ' + cs.fontWeight + ' ' + fontSize + 'px ' + cs.fontFamily;
+        if ('letterSpacing' in c) c.letterSpacing = (cs.letterSpacing === 'normal' ? '0px' : cs.letterSpacing);
+        c.fillStyle = cs.color;
+        c.textBaseline = 'middle';
+        var align = cs.textAlign === 'center' ? 'center' : (cs.textAlign === 'right' || cs.textAlign === 'end') ? 'right' : 'left';
+        c.textAlign = align;
+
+        var innerW = box.width - padL - padR + 1; // +1 tolerates sub-pixel rounding
+        var x = align === 'center' ? box.x + padL + innerW / 2 : align === 'right' ? box.x + box.width - padR : box.x + padL;
+        var lines = wrapLines(c, text, innerW);
+        lines.forEach(function (ln, i) {
+          c.fillText(ln, x, box.y + padT + lineHeight * i + lineHeight / 2);
+        });
+        c.restore();
+      }
+
+      function render() {
+        var cardRect = card.getBoundingClientRect();
+        if (!cardRect.width) return;
+        var cardCs = getComputedStyle(card);
+        var scale = EXPORT_WIDTH / cardRect.width;
+        var W = Math.round(cardRect.width * scale);
+        var H = Math.round(cardRect.height * scale);
+        if (canvas.width !== W || canvas.height !== H) {
+          canvas.width = W;
+          canvas.height = H;
+        }
+
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, W, H);
+        ctx.setTransform(scale, 0, 0, scale, 0, 0);
+
+        var w = cardRect.width, h = cardRect.height;
+        var radius = parseFloat(cardCs.borderTopLeftRadius) || 0;
+
+        // Card background + the same diagonal sheen used in CSS
+        roundRectPath(ctx, 0, 0, w, h, radius);
+        ctx.save();
+        ctx.clip();
+        ctx.fillStyle = bgColor; // selected color (computed style may be mid-transition)
+        ctx.fillRect(0, 0, w, h);
+        // CSS 135deg gradient runs top-left -> bottom-right along this line length
+        var len = (w + h) * Math.SQRT1_2;
+        var cx = w / 2, cy = h / 2, d = len / 2 * Math.SQRT1_2;
+        var grad = ctx.createLinearGradient(cx - d, cy - d, cx + d, cy + d);
+        grad.addColorStop(0, 'rgba(255,255,255,0.18)');
+        grad.addColorStop(0.55, 'rgba(255,255,255,0)');
+        grad.addColorStop(1, 'rgba(0,0,0,0.22)');
+        ctx.fillStyle = grad;
+        ctx.fillRect(0, 0, w, h);
+
+        // Each marked child element, positioned exactly as laid out in the HTML card
+        card.querySelectorAll('[data-canvas]').forEach(function (el) {
+          var r = el.getBoundingClientRect();
+          var box = { x: r.left - cardRect.left, y: r.top - cardRect.top, width: r.width, height: r.height };
+          var cs = getComputedStyle(el);
+          var type = el.getAttribute('data-canvas');
+
+          if (type === 'ring') {
+            var bw = parseFloat(cs.borderTopWidth) || 0;
+            ctx.save();
+            ctx.globalAlpha = parseFloat(cs.opacity);
+            ctx.strokeStyle = cs.borderTopColor;
+            ctx.lineWidth = bw;
+            ctx.beginPath();
+            ctx.ellipse(box.x + box.width / 2, box.y + box.height / 2,
+              Math.max(0, box.width / 2 - bw / 2), Math.max(0, box.height / 2 - bw / 2), 0, 0, Math.PI * 2);
+            ctx.stroke();
+            ctx.restore();
+          } else if (type === 'rect') {
+            ctx.save();
+            ctx.fillStyle = cs.backgroundColor;
+            roundRectPath(ctx, box.x, box.y, box.width, box.height, parseFloat(cs.borderTopLeftRadius) || 0);
+            ctx.fill();
+            ctx.restore();
+          } else if (type === 'text') {
+            drawText(ctx, el, box, scale);
+          }
+        });
+        ctx.restore();
+      }
+
+      var rafId = 0;
+      function scheduleRender() {
+        cancelAnimationFrame(rafId);
+        rafId = requestAnimationFrame(render);
+      }
+
+      // ---- Export ----
+      function fileName() {
+        var slug = nameInput.value.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
+        return 'daily-grind-gift-card' + (slug ? '-' + slug : '') + '.png';
+      }
+
+      function download(url) {
+        var a = document.createElement('a');
+        a.href = url;
+        a.download = fileName();
+        document.body.appendChild(a);
+        a.click();
+        a.remove();
+      }
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        exportBtn.disabled = true;
+        status.textContent = 'Preparing your image…';
+        render(); // make sure the canvas reflects the latest state
+        var done = function (ok) {
+          exportBtn.disabled = false;
+          status.textContent = ok ? 'Downloaded ' + fileName() : 'Sorry, the image could not be exported.';
+        };
+        try {
+          if (canvas.toBlob) {
+            canvas.toBlob(function (blob) {
+              if (!blob) return done(false);
+              var url = URL.createObjectURL(blob);
+              download(url);
+              setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
+              done(true);
+            }, 'image/png');
+          } else {
+            download(canvas.toDataURL('image/png'));
+            done(true);
+          }
+        } catch (err) {
+          console.error(err);
+          done(false);
+        }
+      });
+
+      // ---- Wire up controls ----
+      [nameInput, messageInput, amountInput].forEach(function (el) {
+        el.addEventListener('input', updateCard);
+      });
+
+      document.querySelectorAll('input[name="gc-color"]').forEach(function (radio) {
+        radio.addEventListener('change', function () {
+          if (radio.checked) { bgColor = radio.value; updateCard(); }
+        });
+      });
+
+      customColor.addEventListener('input', function () {
+        document.querySelectorAll('input[name="gc-color"]').forEach(function (r) { r.checked = false; });
+        bgColor = customColor.value;
+        updateCard();
+      });
+
+      // Card text uses clamp()/vw sizing, so re-render whenever its size changes.
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(scheduleRender).observe(card);
+      } else {
+        window.addEventListener('resize', scheduleRender);
+      }
+
+      updateCard();
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(scheduleRender);
+    })();
+  </script>
