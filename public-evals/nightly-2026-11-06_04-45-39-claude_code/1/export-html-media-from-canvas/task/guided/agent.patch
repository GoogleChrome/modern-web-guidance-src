+  <script>
+    (() => {
+      const CARD_W = 480;
+      const CARD_H = 300;
+      const canvas = document.getElementById('gift_canvas');
+      const ctx = canvas.getContext('2d');
+      const card = document.getElementById('export_element');
+      const nameInput = document.getElementById('gift_name');
+      const messageInput = document.getElementById('gift_message');
+      const customColor = document.getElementById('gift_custom_color');
+      const exportBtn = document.getElementById('gift_export');
+      const status = document.getElementById('gift_status');
+      const nameOut = document.getElementById('gc_name');
+      const messageOut = document.getElementById('gc_message');
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function';
+
+      let bg = '#4e342e';
+
+      // Pick readable text color for a given background.
+      function textColorFor(hex) {
+        const n = parseInt(hex.slice(1), 16);
+        const lin = (c) => {
+          c /= 255;
+          return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
+        };
+        const L = 0.2126 * lin(n >> 16) + 0.7152 * lin((n >> 8) & 255) + 0.0722 * lin(n & 255);
+        return L > 0.4 ? '#3e2723' : '#ffffff';
+      }
+
+      function updateCard() {
+        const name = nameInput.value.trim();
+        nameOut.textContent = name ? `For ${name}` : 'A Gift For You';
+        messageOut.textContent = messageInput.value.trim();
+        card.style.setProperty('--card-bg', bg);
+        card.style.setProperty('--card-fg', textColorFor(bg));
+        render();
+      }
+
+      // ---------- Fallback: paint the card's content with the 2D API ----------
+      function roundRect(x, y, w, h, r) {
+        ctx.beginPath();
+        if (ctx.roundRect) ctx.roundRect(x, y, w, h, r);
+        else ctx.rect(x, y, w, h);
+      }
+
+      function wrapLines(text, maxWidth, maxLines) {
+        const words = text.split(/\s+/).filter(Boolean);
+        const lines = [];
+        let line = '';
+        for (const word of words) {
+          const test = line ? `${line} ${word}` : word;
+          if (ctx.measureText(test).width > maxWidth && line) {
+            lines.push(line);
+            line = word;
+          } else {
+            line = test;
+          }
+        }
+        if (line) lines.push(line);
+        if (lines.length > maxLines) {
+          lines.length = maxLines;
+          let last = lines[maxLines - 1];
+          while (last && ctx.measureText(last + '…').width > maxWidth) last = last.slice(0, -1);
+          lines[maxLines - 1] = last + '…';
+        }
+        // Hard-break single words that are still too long.
+        return lines.map((l) => {
+          while (ctx.measureText(l).width > maxWidth && l.length > 1) l = l.slice(0, -2) + '…';
+          return l;
+        });
+      }
+
+      function drawFallback() {
+        const scale = canvas.width / CARD_W;
+        const fg = textColorFor(bg);
+        const font = getComputedStyle(card).fontFamily;
+        const pad = 32;
+
+        ctx.reset ? ctx.reset() : ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.scale(scale, scale);
+
+        roundRect(0, 0, CARD_W, CARD_H, 14);
+        ctx.save();
+        ctx.clip();
+        ctx.fillStyle = bg;
+        ctx.fillRect(0, 0, CARD_W, CARD_H);
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.18)';
+        ctx.beginPath(); ctx.arc(CARD_W * 0.85, CARD_H * 0.15, 70, 0, Math.PI * 2); ctx.fill();
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.12)';
+        ctx.beginPath(); ctx.arc(CARD_W * 0.1, CARD_H * 1.1, 90, 0, Math.PI * 2); ctx.fill();
+        ctx.restore();
+
+        ctx.fillStyle = fg;
+        ctx.textBaseline = 'middle';
+        ctx.font = `bold 14px ${font}`;
+        ctx.letterSpacing = '2px';
+        ctx.fillText('☕ THE DAILY GRIND', pad, 40);
+
+        ctx.letterSpacing = '1px';
+        ctx.font = `bold 12px ${font}`;
+        const badge = 'GIFT CARD';
+        const bw = ctx.measureText(badge).width + 20;
+        ctx.fillStyle = '#ffab40';
+        roundRect(CARD_W - pad - bw, 29, bw, 22, 11);
+        ctx.fill();
+        ctx.fillStyle = '#3e2723';
+        ctx.fillText(badge, CARD_W - pad - bw + 10, 40);
+
+        ctx.letterSpacing = '0px';
+        ctx.fillStyle = fg;
+        ctx.textBaseline = 'alphabetic';
+        const maxW = CARD_W - pad * 2;
+        ctx.font = `italic 16px ${font}`;
+        const msgLines = messageOut.textContent ? wrapLines(messageOut.textContent, maxW, 3) : [];
+        ctx.font = `bold 29px ${font}`;
+        const nameLines = wrapLines(nameOut.textContent, maxW, 2);
+
+        const blockH = nameLines.length * 35 + msgLines.length * 24;
+        let y = CARD_H / 2 - blockH / 2 + 28;
+        for (const l of nameLines) { ctx.fillText(l, pad, y); y += 35; }
+        ctx.font = `italic 16px ${font}`;
+        ctx.globalAlpha = 0.9;
+        for (const l of msgLines) { ctx.fillText(l, pad, y - 6); y += 24; }
+
+        ctx.globalAlpha = 0.8;
+        ctx.letterSpacing = '1px';
+        ctx.font = `12px ${font}`;
+        ctx.fillText('REDEEMABLE AT ANY DAILY GRIND LOCATION', pad, CARD_H - 28);
+        ctx.globalAlpha = 1;
+        ctx.letterSpacing = '0px';
+      }
+
+      // ---------- Rendering ----------
+      function render() {
+        if (supportsHtmlInCanvas) canvas.requestPaint();
+        else drawFallback();
+      }
+
+      if (supportsHtmlInCanvas) {
+        canvas.onpaint = () => {
+          ctx.reset();
+          const scale = canvas.width / CARD_W;
+          ctx.scale(scale, scale);
+          ctx.drawElementImage(card, 0, 0);
+        };
+      }
+
+      // Keep the canvas backing store matched to device pixels.
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        render();
+      });
+      const supportsDPCB = typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, supportsDPCB ? { box: 'device-pixel-content-box' } : {});
+
+      // ---------- Controls ----------
+      nameInput.addEventListener('input', updateCard);
+      messageInput.addEventListener('input', updateCard);
+      document.querySelectorAll('input[name="gift_bg"]').forEach((radio) => {
+        radio.addEventListener('change', () => { bg = radio.value; updateCard(); });
+      });
+      customColor.addEventListener('input', () => {
+        document.querySelectorAll('input[name="gift_bg"]').forEach((r) => { r.checked = false; });
+        bg = customColor.value;
+        updateCard();
+      });
+
+      exportBtn.addEventListener('click', () => {
+        // Export at a fixed high resolution, independent of on-screen size.
+        const prevW = canvas.width;
+        const prevH = canvas.height;
+        const exportScale = Math.max(2, prevW / CARD_W);
+        const finish = () => {
+          canvas.toBlob((blob) => {
+            if (!blob) { status.textContent = 'Sorry, the image could not be created.'; return; }
+            const url = URL.createObjectURL(blob);
+            const a = document.createElement('a');
+            const slug = nameInput.value.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
+            a.href = url;
+            a.download = `daily-grind-gift-card${slug ? '-' + slug : ''}.png`;
+            document.body.append(a);
+            a.click();
+            a.remove();
+            setTimeout(() => URL.revokeObjectURL(url), 1000);
+            status.textContent = 'Your gift card has been downloaded.';
+          }, 'image/png');
+        };
+
+        if (supportsHtmlInCanvas) {
+          // Canvas size is driven by ResizeObserver; export the current paint.
+          finish();
+        } else {
+          canvas.width = Math.round(CARD_W * exportScale);
+          canvas.height = Math.round(CARD_H * exportScale);
+          drawFallback();
+          finish();
+          canvas.width = prevW;
+          canvas.height = prevH;
+          drawFallback();
+        }
+      });
+
+      updateCard();
+    })();
+  </script>
 </body>
 
