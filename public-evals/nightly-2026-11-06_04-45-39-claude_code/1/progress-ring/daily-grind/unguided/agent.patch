+  <script>
+    (function () {
+      var ring = document.getElementById('loyalty-ring');
+      if (!ring) return;
+      var goal = Math.max(1, parseInt(ring.dataset.goal, 10) || 10);
+      var current = Math.min(goal, Math.max(0, parseInt(ring.dataset.current, 10) || 0));
+      var remaining = goal - current;
+      var card = ring.closest('.rewards-card');
+      var fill = ring.querySelector('.ring-fill');
+      var circumference = 2 * Math.PI * fill.r.baseVal.value;
+
+      fill.style.strokeDasharray = circumference;
+      fill.style.strokeDashoffset = circumference * (1 - current / goal);
+
+      ring.setAttribute('aria-valuemax', goal);
+      ring.setAttribute('aria-valuenow', current);
+      ring.setAttribute('aria-label', 'Loyalty progress: ' + current + ' of ' + goal + ' drinks toward your next free drink');
+      ring.querySelector('.ring-current').textContent = current;
+      ring.querySelector('.ring-goal').textContent = goal;
+
+      card.querySelector('.ring-remaining').textContent = remaining;
+      card.querySelector('.ring-remaining-noun').textContent = remaining === 1 ? 'drink' : 'drinks';
+      if (remaining === 0) {
+        card.querySelector('h3').textContent = 'Your free drink is ready!';
+        card.querySelector('.ring-remaining').parentNode.parentNode.textContent = 'Redeem it on your next visit.';
+      }
+
+      var stamps = card.querySelector('.stamps');
+      for (var i = 0; i < goal; i++) {
+        var li = document.createElement('li');
+        if (i < current) li.className = 'earned';
+        stamps.appendChild(li);
+      }
+    })();
+  </script>
+
