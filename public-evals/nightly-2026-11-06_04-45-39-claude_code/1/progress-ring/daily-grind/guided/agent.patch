+  <script>
+    // Keeps the loyalty ring, center text, and status message in sync.
+    // Call updateLoyalty(stamps) whenever the customer's stamp count changes.
+    (() => {
+      const progress = document.getElementById('loyalty-progress');
+      const count = document.getElementById('loyalty-count');
+      const status = document.getElementById('loyalty-status');
+      const needsSync = !CSS.supports('width: attr(value type(<number>))');
+
+      const sync = () => {
+        const value = Number(progress.value);
+        const max = Number(progress.max);
+        if (needsSync) {
+          progress.style.setProperty('--value', value);
+          progress.style.setProperty('--max', max);
+        }
+        progress.classList.toggle('is-complete', value >= max);
+        count.textContent = value;
+        const remaining = max - value;
+        status.textContent = remaining <= 0
+          ? 'Your free drink is ready! Redeem it on your next order.'
+          : `${remaining} more drink${remaining === 1 ? '' : 's'} until your next free one!`;
+      };
+
+      if (needsSync) {
+        new MutationObserver(sync).observe(progress, { attributes: true, attributeFilter: ['value', 'max'] });
+      }
+
+      window.updateLoyalty = (stamps) => {
+        progress.value = stamps;
+        if (!needsSync) sync();
+      };
+
+      sync();
+    })();
+  </script>
+
