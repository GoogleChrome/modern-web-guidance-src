+  <script>
+    (function () {
+      'use strict';
+
+      var grid = document.getElementById('seasonal-grid');
+      var status = document.getElementById('grid-status');
+      var toggleButtons = document.querySelectorAll('.layout-toggle button');
+      var STORAGE_KEY = 'daily-grind:card-layout';
+      var LAYOUTS = { grid: 'Grid', list: 'List', row: 'Row' };
+
+      function getCards() {
+        // Skip cards that aren't rendered (e.g. display:none) so they never trap focus.
+        return Array.prototype.filter.call(grid.querySelectorAll('.card'), function (card) {
+          return card.getClientRects().length > 0;
+        });
+      }
+
+      /* ---------- Roving tabindex: exactly one card is in the tab order ---------- */
+
+      function setActive(card, moveFocus) {
+        getCards().forEach(function (c) {
+          c.tabIndex = c === card ? 0 : -1;
+        });
+        if (moveFocus) {
+          card.focus({ preventScroll: true });
+          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          card.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
+        }
+      }
+
+      function ensureOneTabStop() {
+        var cards = getCards();
+        if (!cards.length) return;
+        var current = cards.filter(function (c) { return c.tabIndex === 0; })[0];
+        setActive(current || cards[0], false);
+      }
+
+      /* ---------- Geometry-based spatial navigation ---------- */
+
+      // Works off the rendered boxes rather than DOM order or a column count,
+      // so it stays correct for responsive auto-fit grids, list and row modes,
+      // RTL text direction and any CSS reordering.
+      function findNeighbor(from, direction, cards) {
+        var a = from.getBoundingClientRect();
+        var aCx = a.left + a.width / 2;
+        var aCy = a.top + a.height / 2;
+        var horizontal = direction === 'left' || direction === 'right';
+        var EPS = 1; // tolerate sub-pixel rounding
+
+        var best = null;
+        var bestScore = Infinity;
+
+        cards.forEach(function (card) {
+          if (card === from) return;
+          var b = card.getBoundingClientRect();
+          var bCx = b.left + b.width / 2;
+          var bCy = b.top + b.height / 2;
+
+          // 1. Candidate must lie in the requested direction.
+          var primary; // gap along the movement axis (edge to edge)
+          switch (direction) {
+            case 'right': if (bCx <= aCx + EPS) return; primary = b.left - a.right; break;
+            case 'left': if (bCx >= aCx - EPS) return; primary = a.left - b.right; break;
+            case 'down': if (bCy <= aCy + EPS) return; primary = b.top - a.bottom; break;
+            case 'up': if (bCy >= aCy - EPS) return; primary = a.top - b.bottom; break;
+          }
+          primary = Math.max(0, primary);
+
+          // 2. How well it lines up on the cross axis (same row / same column).
+          var overlap = horizontal
+            ? Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top)
+            : Math.min(a.right, b.right) - Math.max(a.left, b.left);
+          var crossOffset = horizontal ? Math.abs(bCy - aCy) : Math.abs(bCx - aCx);
+
+          // 3. Score: aligned candidates always beat unaligned ones; then nearest
+          //    along the axis; then closest to our centre line.
+          var score = (overlap > 0 ? 0 : 1e7) + primary * 1000 + crossOffset * (overlap > 0 ? 1 : 2);
+
+          if (score < bestScore) {
+            bestScore = score;
+            best = card;
+          }
+        });
+
+        return best;
+      }
+
+      var KEY_TO_DIRECTION = {
+        ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right',
+        Up: 'up', Down: 'down', Left: 'left', Right: 'right' // legacy Edge/IE key names
+      };
+
+      function isRtl() {
