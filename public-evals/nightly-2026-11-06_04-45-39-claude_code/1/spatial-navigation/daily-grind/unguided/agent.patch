+      });
+
+      /* ---------- Layout modes ---------- */
+
+      function applyLayout(layout, announce) {
+        if (!LAYOUTS[layout]) layout = 'grid';
+        var focused = grid.contains(document.activeElement) ? document.activeElement : null;
+
+        grid.setAttribute('data-layout', layout);
