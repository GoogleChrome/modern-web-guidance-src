+        ensureOneTabStop();
+        if (focused) {
+          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          focused.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
+        }
+        if (announce) status.textContent = LAYOUTS[layout] + ' layout';
+      }
+
+      Array.prototype.forEach.call(toggleButtons, function (btn) {
+        btn.addEventListener('click', function () {
+          applyLayout(btn.getAttribute('data-layout'), true);
+        });
+      });
+
+      var saved = null;
+      try { saved = localStorage.getItem(STORAGE_KEY); } catch (e) { /* storage unavailable */ }
+      applyLayout(saved || 'grid', false);
+    })();
+  </script>
