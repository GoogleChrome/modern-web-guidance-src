+  <script>
+    // Spatial (2D) arrow-key navigation for a composite widget. Candidates are
+    // picked from live geometry on each keypress, so it works in any layout mode
+    // (auto-fit grid, single-column list, dense grid with spanning items, RTL...).
+    function initSpatialNavigation(container, itemSelector) {
+      const TOLERANCE = 1; // px, absorbs sub-pixel rounding
+      const WEIGHT = 2;    // perpendicular offset weight for unaligned fallback
+
+      const items = () => [...container.querySelectorAll(itemSelector)]
+        .filter((el) => el.checkVisibility());
+
+      function setActive(el) {
+        for (const item of container.querySelectorAll(itemSelector)) {
+          item.tabIndex = item === el ? 0 : -1;
+        }
+      }
+
+      function findCandidate(current, direction) {
+        const from = current.getBoundingClientRect();
+        const horizontal = direction === 'left' || direction === 'right';
+        let bestAligned = null, bestAlignedScore = [Infinity, Infinity];
+        let bestFallback = null, bestFallbackScore = Infinity;
+
+        for (const el of items()) {
+          if (el === current) continue;
+          const to = el.getBoundingClientRect();
+
+          // Edge-based direction filter and gap along the navigation axis.
+          let gap;
+          switch (direction) {
+            case 'right': gap = to.left - from.right; break;
+            case 'left': gap = from.left - to.right; break;
+            case 'down': gap = to.top - from.bottom; break;
+            case 'up': gap = from.top - to.bottom; break;
+          }
+          if (gap < -TOLERANCE) continue;
+          gap = Math.max(0, gap);
+
+          const overlaps = horizontal
+            ? to.top < from.bottom - TOLERANCE && to.bottom > from.top + TOLERANCE
+            : to.left < from.right - TOLERANCE && to.right > from.left + TOLERANCE;
+          const offset = horizontal
+            ? Math.abs((to.top + to.bottom) / 2 - (from.top + from.bottom) / 2)
+            : Math.abs((to.left + to.right) / 2 - (from.left + from.right) / 2);
+
+          if (overlaps) {
+            if (gap < bestAlignedScore[0] ||
+              (gap === bestAlignedScore[0] && offset < bestAlignedScore[1])) {
+              bestAligned = el;
+              bestAlignedScore = [gap, offset];
+            }
+          } else if (!bestAligned) {
+            const score = gap + WEIGHT * offset;
+            if (score < bestFallbackScore) {
+              bestFallback = el;
+              bestFallbackScore = score;
+            }
+          }
+        }
+        return bestAligned || bestFallback;
+      }
+
+      // Visual first/last item (top-most row, then inline-start-most).
+      function edgeItem(last) {
+        const rtl = getComputedStyle(container).direction === 'rtl';
+        const sorted = items().map((el) => [el, el.getBoundingClientRect()]).sort(([, a], [, b]) =>
+          Math.abs(a.top - b.top) > TOLERANCE ? a.top - b.top : (rtl ? b.left - a.left : a.left - b.left));
+        const entry = last ? sorted.at(-1) : sorted[0];
+        return entry?.[0] ?? null;
+      }
+
+      const KEYS = { ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right' };
+
+      container.addEventListener('keydown', (e) => {
+        if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+        const target = e.composedPath()[0];
+        if (!(target instanceof Element) || !target.matches(itemSelector)) return;
+        if (target.matches(':read-write, select, input[type="range"], [role="slider"]')) return;
+
+        let next = null;
+        if (e.key in KEYS) next = findCandidate(target, KEYS[e.key]);
+        else if (e.key === 'Home') next = edgeItem(false);
+        else if (e.key === 'End') next = edgeItem(true);
+        else return;
+
+        // No candidate: let the browser scroll the viewport natively.
+        if (!next || next === target) return;
+        e.preventDefault();
+        setActive(next);
+        next.focus();
+        next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+      });
+
+      // Keep the single tab stop on whatever item last received focus (e.g. by click).
+      container.addEventListener('focusin', (e) => {
+        if (e.target.matches(itemSelector)) setActive(e.target);
+      });
+
+      // Ensure exactly one item is tabbable even if the active one gets hidden.
+      const ensureTabStop = () => {
+        const visible = items();
+        if (!visible.some((el) => el.tabIndex === 0)) setActive(visible[0] ?? null);
+      };
+      ensureTabStop();
+      new ResizeObserver(ensureTabStop).observe(container);
+    }
+
+    const grid = document.getElementById('seasonal-grid');
+    initSpatialNavigation(grid, '.card .btn');
+
+    document.querySelector('.layout-switcher').addEventListener('change', (e) => {
+      if (e.target.name === 'layout') grid.dataset.layout = e.target.value;
+    });
+  </script>
+
