new file mode 100644
index 0000000..99ca06e
--- /dev/null
+++ b/server.js
@@ -0,0 +1,257 @@
+// Daily Grind homepage server. Zero dependencies (Node 18+).
+//
+// Its main job is controlling response headers so the page can only talk to
+// our own origin and the Unsplash image host:
+//   - Connection-Allowlist: network-layer allowlist covering every outbound
+//     channel (fetch, beacons, navigations, prefetch hints, WebSocket, WebRTC…).
+//     Supported in Chrome/Edge 152+.
+//   - Content-Security-Policy: cross-browser fallback. No inline scripts or
+//     styles are allowed, so injected markup can't run code.
+
+import { createServer } from 'node:http';
+import { readFile, appendFile, mkdir } from 'node:fs/promises';
+import { extname, join, normalize, sep, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = dirname(fileURLToPath(import.meta.url));
+const PUBLIC_DIR = join(ROOT, 'public');
+const DATA_FILE = process.env.NEWSLETTER_FILE || join(ROOT, 'data', 'newsletter-signups.jsonl');
+const PORT = Number(process.env.PORT) || 11222;
+
+const IMAGE_HOST = 'https://images.unsplash.com';
+const REPORT_ENDPOINT = 'csp-reports';
+const REPORT_PATH = '/api/security-reports';
+
+// Connection-Allowlist only applies to document and worker responses.
+const ALLOWLIST_DESTS = new Set(['document', 'iframe', 'worker', 'sharedworker', 'serviceworker']);
+
+const CONNECTION_ALLOWLIST = `(response-origin "${IMAGE_HOST}"); report-to=${REPORT_ENDPOINT}`;
+
+const CSP = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "style-src 'self'",
+  `img-src 'self' ${IMAGE_HOST}`,
+  "connect-src 'self'",
+  "form-action 'self'",
+  "worker-src 'none'",
+  "manifest-src 'self'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "frame-src 'none'",
+  "frame-ancestors 'none'",
+  `report-uri ${REPORT_PATH}`,
+  `report-to ${REPORT_ENDPOINT}`,
+].join('; ');
+
+const MIME = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.webp': 'image/webp',
+  '.ico': 'image/x-icon',
+  '.txt': 'text/plain; charset=utf-8',
+};
+
+function securityHeaders(req, res) {
+  const origin = `${req.headers['x-forwarded-proto'] === 'https' ? 'https' : 'http'}://${req.headers.host}`;
+
+  res.setHeader('Content-Security-Policy', CSP);
+  res.setHeader('Reporting-Endpoints', `${REPORT_ENDPOINT}="${origin}${REPORT_PATH}"`);
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
+  res.setHeader('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), payment=(), usb=()');
+  res.setHeader('Vary', 'Sec-Fetch-Dest');
+
+  // Browsers that don't send Sec-Fetch-Dest get the header too (harmless).
+  const dest = String(req.headers['sec-fetch-dest'] || 'document').toLowerCase();
+  if (ALLOWLIST_DESTS.has(dest)) {
+    // Default redirects=block / webrtc=block are what we want: the page never
+    // relies on redirects (the newsletter endpoint answers directly).
+    res.setHeader('Connection-Allowlist', CONNECTION_ALLOWLIST);
+  }
+}
+
+function send(res, status, body, type = 'text/plain; charset=utf-8', extra = {}) {
+  res.writeHead(status, { 'Content-Type': type, 'Content-Length': Buffer.byteLength(body), ...extra });
+  res.end(body);
+}
+
+function escapeHtml(s) {
+  return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+}
+
+function resultPage(title, message, status) {
+  return `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>${escapeHtml(title)} | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css">
+</head>
+<body>
+  <main class="container result">
+    <h1>${escapeHtml(title)}</h1>
+    <p class="form-status" data-state="${status}">${escapeHtml(message)}</p>
+    <a class="btn" href="/">Back to the homepage</a>
+  </main>
+</body>
+</html>`;
+}
+
+async function readBody(req, limit = 8 * 1024) {
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > limit) throw Object.assign(new Error('Payload too large'), { status: 413 });
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+// Simple per-IP rate limit for the signup endpoint.
+const hits = new Map();
+function rateLimited(ip, max = 5, windowMs = 60_000) {
+  const now = Date.now();
+  const recent = (hits.get(ip) || []).filter((t) => now - t < windowMs);
+  recent.push(now);
+  hits.set(ip, recent);
+  if (hits.size > 10_000) hits.clear();
+  return recent.length > max;
+}
+
+function sameHost(origin, host) {
+  try {
+    return new URL(origin).host === host;
+  } catch {
+    return false; // e.g. "Origin: null"
+  }
+}
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+async function handleNewsletter(req, res) {
+  const wantsJson = String(req.headers.accept || '').includes('application/json');
+  const reply = (status, ok, message) =>
+    wantsJson
+      ? send(res, status, JSON.stringify({ ok, message }), 'application/json; charset=utf-8')
+      : send(
+          res,
+          status,
+          resultPage(ok ? "You're subscribed" : "We couldn't sign you up", message, ok ? 'success' : 'error'),
+          'text/html; charset=utf-8',
+        );
+
+  // CSRF / cross-site posting guard: only accept same-origin submissions.
+  const site = req.headers['sec-fetch-site'];
+  if (site && site !== 'same-origin') {
+    return reply(403, false, 'This request was not allowed.');
+  }
+  const origin = req.headers.origin;
+  if (origin && !sameHost(origin, req.headers.host)) {
+    return reply(403, false, 'This request was not allowed.');
+  }
+
+  if (!String(req.headers['content-type'] || '').startsWith('application/x-www-form-urlencoded')) {
+    return reply(415, false, 'Unsupported request format.');
+  }
+
+  if (rateLimited(req.socket.remoteAddress || 'unknown')) {
+    return reply(429, false, 'Too many attempts. Please wait a minute and try again.');
+  }
+
+  let params;
+  try {
+    params = new URLSearchParams(await readBody(req));
+  } catch (err) {
+    return reply(err.status || 400, false, 'Your request could not be read. Please try again.');
+  }
+
+  // Honeypot filled in → pretend success, store nothing.
+  if (params.get('website')) {
+    return reply(200, true, "Thanks! You're on the list.");
+  }
+
+  const email = String(params.get('email') || '').trim().toLowerCase();
+  if (email.length > 254 || !EMAIL_RE.test(email)) {
+    return reply(400, false, 'Please enter a valid email address.');
+  }
+
+  try {
+    await mkdir(dirname(DATA_FILE), { recursive: true });
+    await appendFile(DATA_FILE, JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n');
+  } catch (err) {
+    console.error('Failed to store signup:', err);
+    return reply(500, false, "Sorry, something went wrong on our end. Please try again later.");
+  }
+
+  return reply(200, true, "Thanks! You're on the list. Watch your inbox for our next roast.");
+}
+
+async function handleReport(req, res) {
+  try {
+    const body = await readBody(req, 64 * 1024);
+    console.warn('[security-report]', body.slice(0, 2000));
+  } catch {
+    /* ignore oversized/broken reports */
+  }
+  res.writeHead(204).end();
+}
+
+async function serveStatic(req, res, pathname) {
+  let rel = pathname === '/' ? '/index.html' : pathname;
+  try {
+    rel = decodeURIComponent(rel);
+  } catch {
+    return send(res, 400, 'Bad request');
+  }
+  const filePath = normalize(join(PUBLIC_DIR, rel));
+  if (!filePath.startsWith(PUBLIC_DIR + sep)) return send(res, 403, 'Forbidden');
+
+  try {
+    const data = await readFile(filePath);
+    const type = MIME[extname(filePath).toLowerCase()] || 'application/octet-stream';
+    res.writeHead(200, {
+      'Content-Type': type,
+      'Content-Length': data.length,
+      'Cache-Control': type.startsWith('text/html') ? 'no-cache' : 'public, max-age=3600',
+    });
+    res.end(req.method === 'HEAD' ? undefined : data);
+  } catch {
+    send(res, 404, resultPage('Page not found', "We couldn't find that page.", 'error'), 'text/html; charset=utf-8');
+  }
+}
+
+const server = createServer(async (req, res) => {
+  try {
+    securityHeaders(req, res);
+    const { pathname } = new URL(req.url, 'http://localhost');
+
+    if (pathname === '/api/newsletter') {
+      if (req.method !== 'POST') return send(res, 405, 'Method not allowed', undefined, { Allow: 'POST' });
+      return await handleNewsletter(req, res);
+    }
+    if (pathname === REPORT_PATH) {
+      if (req.method !== 'POST') return send(res, 405, 'Method not allowed', undefined, { Allow: 'POST' });
+      return await handleReport(req, res);
+    }
+    if (req.method !== 'GET' && req.method !== 'HEAD') {
+      return send(res, 405, 'Method not allowed', undefined, { Allow: 'GET, HEAD' });
+    }
+    return await serveStatic(req, res, pathname);
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) send(res, 500, 'Internal server error');
+    else res.end();
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`Daily Grind listening on http://localhost:${PORT}`);
+});
