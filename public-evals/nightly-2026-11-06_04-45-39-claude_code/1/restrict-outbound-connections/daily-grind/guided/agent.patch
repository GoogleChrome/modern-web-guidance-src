+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>The Daily Grind | Artisanal Coffee</title>
+  <link rel="stylesheet" href="/styles.css">
+  <script src="/app.js" defer></script>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo">THE DAILY GRIND</div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero">
+    <h1>Wake Up Your Senses</h1>
+    <p>Ethically sourced, locally roasted, delivered to your cup.</p>
+    <a href="/order-online" class="btn">Order Now</a>
+  </header>
+
+  <main class="container">
+    <section>
+      <h2 class="section-title">Seasonal Favorites</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+
+    <section class="newsletter" aria-labelledby="newsletter-title">
+      <h2 id="newsletter-title">Get the Daily Grind Newsletter</h2>
+      <p>New seasonal drinks, roasting notes, and member-only offers. No spam, unsubscribe anytime.</p>
+      <form id="newsletter-form" class="newsletter-form" action="/api/newsletter" method="POST">
+        <div class="field">
+          <label for="newsletter-email">Email address <span aria-hidden="true">*</span></label>
+          <input type="email" id="newsletter-email" name="email" required maxlength="254"
+            autocomplete="email" autocorrect="off" autocapitalize="off" spellcheck="false"
+            enterkeyhint="send" aria-describedby="newsletter-status">
+        </div>
+        <!-- Honeypot: hidden from people, bots tend to fill it in -->
+        <div class="visually-hidden" aria-hidden="true">
+          <label for="newsletter-website">Leave this field empty</label>
+          <input type="text" id="newsletter-website" name="website" tabindex="-1" autocomplete="off">
+        </div>
+        <button type="submit" class="btn">Subscribe</button>
+      </form>
+      <p id="newsletter-status" class="form-status" role="status" aria-live="polite"></p>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
diff --git a/public/styles.css b/public/styles.css
new file mode 100644
index 0000000..aaa0401
--- /dev/null
+++ b/public/styles.css
@@ -0,0 +1,260 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+/* Newsletter */
+.newsletter {
+  margin-top: 60px;
+  padding: 32px 24px;
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.newsletter h2 {
+  color: var(--primary);
+  margin-bottom: 0.5rem;
+}
+
+.newsletter-form {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  align-items: flex-end;
+  gap: 12px;
+  margin-top: 1.25rem;
+}
+
+.newsletter-form .field {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  text-align: start;
+  flex: 1 1 260px;
+  max-width: 380px;
+}
+
+.newsletter-form label {
+  font-weight: 600;
+  font-size: 0.9rem;
+}
+
+.newsletter-form input {
+  font: inherit;
+  font-size: 1rem;
+  min-height: 48px;
+  padding: 0.75rem;
+  border: 1px solid #8d6e63;
+  border-radius: 5px;
+}
+
+.newsletter-form input:focus-visible,
+.newsletter-form button:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.newsletter-form input:user-invalid {
+  border-color: #b71c1c;
+}
+
+.newsletter-form button {
+  min-height: 48px;
+  margin-top: 0;
+  border: 0;
+  font: inherit;
+  cursor: pointer;
+}
+
+.newsletter-form button:disabled {
+  opacity: 0.7;
+  cursor: progress;
+}
+
+.form-status {
+  min-height: 1.6em;
+  margin-top: 1rem;
+  font-weight: 600;
+}
+
+.form-status[data-state="success"] {
+  color: #2e7d32;
+}
+
+.form-status[data-state="success"]::before {
+  content: "✓ ";
+}
+
+.form-status[data-state="error"] {
+  color: #b71c1c;
+}
+
+.form-status[data-state="error"]::before {
+  content: "⚠ ";
+}
+
+.visually-hidden {
+  position: absolute;
+  clip-path: inset(50%);
+  overflow: hidden;
+  width: 1px;
+  height: 1px;
+  margin: -1px;
+  padding: 0;
+  border: 0;
+  white-space: nowrap;
+}
+
+/* Server-rendered result page (no-JS fallback) */
+.result {
+  max-width: 600px;
+  text-align: center;
+}
