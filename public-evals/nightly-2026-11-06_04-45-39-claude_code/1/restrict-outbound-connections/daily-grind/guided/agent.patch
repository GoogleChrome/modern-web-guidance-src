diff --git a/public/app.js b/public/app.js
new file mode 100644
index 0000000..5a2858c
--- /dev/null
+++ b/public/app.js
@@ -0,0 +1,63 @@
+// Newsletter signup. Progressive enhancement: without JS the form posts
+// natively to /api/newsletter and the server renders a result page.
+const form = document.getElementById('newsletter-form');
+const statusEl = document.getElementById('newsletter-status');
+
+const BLOCKED_MESSAGE =
+  "Sorry, we couldn't send your request. Please check your connection and try again in a moment.";
+
+function setStatus(state, message) {
+  statusEl.dataset.state = state;
+  statusEl.textContent = message; // textContent only — never parse server text as HTML
+}
+
+if (form && statusEl) {
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (!form.reportValidity()) return;
+
+    const button = form.querySelector('button[type="submit"]');
+    button.disabled = true;
+    setStatus('pending', 'Signing you up…');
+
+    try {
+      const response = await fetch(form.action, {
+        method: 'POST',
+        headers: { Accept: 'application/json' },
+        body: new URLSearchParams(new FormData(form)),
+        credentials: 'same-origin',
+        redirect: 'error',
+      });
+
+      let data = {};
+      try {
+        data = await response.json();
+      } catch {
+        /* non-JSON body: fall through to generic messages */
+      }
+
+      if (response.ok) {
+        setStatus('success', data.message || "Thanks! You're on the list.");
+        form.reset();
+      } else {
+        setStatus('error', data.message || BLOCKED_MESSAGE);
+      }
+    } catch {
+      // fetch() rejects with a TypeError when the network is down or when the
+      // browser's Connection-Allowlist / CSP blocks the request.
+      setStatus('error', BLOCKED_MESSAGE);
+    } finally {
+      button.disabled = false;
+    }
+  });
+}
+
+// If the CSP blocks a submission the customer started, make sure they see why.
+// Only reacts while a signup is in flight so blocked background requests (for
+// example from an injected script) don't produce confusing messages.
+document.addEventListener('securitypolicyviolation', (event) => {
+  if (event.disposition !== 'enforce' || statusEl?.dataset.state !== 'pending') return;
+  if (['connect-src', 'form-action'].includes(event.effectiveDirective)) {
+    setStatus('error', BLOCKED_MESSAGE);
+  }
+});
