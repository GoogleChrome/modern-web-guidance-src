@@ -0,0 +1,195 @@
+'use strict';
+
+const http = require('node:http');
+const fs = require('node:fs');
+const fsp = require('node:fs/promises');
+const path = require('node:path');
+
+const PORT = Number(process.env.PORT) || 11222;
+const PUBLIC_DIR = path.join(__dirname, 'public');
+const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, 'data');
+const SUBSCRIBERS_FILE = path.join(DATA_DIR, 'subscribers.jsonl');
+const MAX_BODY_BYTES = 4 * 1024;
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+// The page may only talk to this server ('self') and load photos from Unsplash.
+// No inline scripts/styles are allowed, so an injected <script> or handler
+// can't run, and anything that does run can't fetch/beacon/websocket elsewhere.
+const CSP = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "style-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "font-src 'self'",
+  "connect-src 'self'",
+  "manifest-src 'self'",
+  "media-src 'none'",
+  "object-src 'none'",
+  "frame-src 'none'",
+  "worker-src 'none'",
+  "child-src 'none'",
+  "form-action 'self'",
+  "base-uri 'none'",
+  "frame-ancestors 'none'",
+  'upgrade-insecure-requests',
+].join('; ');
+
+const SECURITY_HEADERS = {
+  'Content-Security-Policy': CSP,
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'no-referrer',
+  'X-Frame-Options': 'DENY',
+  'X-DNS-Prefetch-Control': 'off',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=()',
+};
+
+// Explicit allowlist of static files — no filesystem path is derived from the URL.
+const STATIC_FILES = {
+  '/': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/index.html': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/styles.css': { file: 'styles.css', type: 'text/css; charset=utf-8' },
+  '/newsletter.js': { file: 'newsletter.js', type: 'text/javascript; charset=utf-8' },
+};
+
+function send(res, status, body, headers = {}) {
+  res.writeHead(status, { ...SECURITY_HEADERS, ...headers });
+  res.end(body);
+}
+
+function sendJson(res, status, obj) {
+  send(res, status, JSON.stringify(obj), {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Cache-Control': 'no-store',
+  });
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+function isSameOrigin(req) {
+  // Browsers send Origin on cross-site POSTs; reject those (basic CSRF guard).
+  const origin = req.headers.origin;
+  if (!origin) return true;
+  try {
+    return new URL(origin).host === req.headers.host;
+  } catch {
+    return false;
+  }
+}
+
+async function handleNewsletter(req, res) {
+  const contentType = (req.headers['content-type'] || '').split(';')[0].trim().toLowerCase();
+  const isForm = contentType === 'application/x-www-form-urlencoded';
+  const fail = (status, error) =>
+    isForm
+      ? send(res, 303, '', { Location: '/?newsletter=error#newsletter-title' })
+      : sendJson(res, status, { error });
+
+  if (!isSameOrigin(req)) return fail(403, 'Request not allowed.');
+
+  let raw;
+  try {
+    raw = await readBody(req);
+  } catch (err) {
+    return fail(err.status || 400, 'Invalid request.');
+  }
+
+  let email;
+  try {
+    if (contentType === 'application/json') {
+      email = JSON.parse(raw).email;
+    } else if (isForm) {
+      email = new URLSearchParams(raw).get('email');
+    } else {
+      return fail(415, 'Unsupported content type.');
+    }
+  } catch {
+    return fail(400, 'Invalid request.');
+  }
+
+  email = typeof email === 'string' ? email.trim().toLowerCase() : '';
+  if (!email || email.length > 254 || !EMAIL_RE.test(email)) {
+    return fail(400, 'Please enter a valid email address.');
+  }
+
+  try {
+    await fsp.mkdir(DATA_DIR, { recursive: true });
+    await fsp.appendFile(
+      SUBSCRIBERS_FILE,
+      JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n',
+      { mode: 0o600 },
+    );
+  } catch (err) {
+    console.error('Failed to save subscriber:', err);
+    return fail(500, "We couldn't save your signup right now. Please try again shortly.");
+  }
+
+  if (isForm) return send(res, 303, '', { Location: '/?newsletter=ok#newsletter-title' });
+  return sendJson(res, 201, { message: "Thanks! You're on the list." });
+}
+
+function serveStatic(req, res, pathname) {
+  const entry = STATIC_FILES[pathname];
+  if (!entry) return send(res, 404, 'Not found', { 'Content-Type': 'text/plain; charset=utf-8' });
+
+  const filePath = path.join(PUBLIC_DIR, entry.file);
+  fs.stat(filePath, (err, stat) => {
+    if (err) return send(res, 404, 'Not found', { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.writeHead(200, {
+      ...SECURITY_HEADERS,
+      'Content-Type': entry.type,
+      'Content-Length': stat.size,
+      'Cache-Control': entry.file === 'index.html' ? 'no-cache' : 'public, max-age=3600',
+    });
+    if (req.method === 'HEAD') return res.end();
+    fs.createReadStream(filePath).pipe(res);
+  });
+}
+
+const server = http.createServer((req, res) => {
+  let pathname;
+  try {
+    pathname = new URL(req.url, 'http://localhost').pathname;
+  } catch {
+    return send(res, 400, 'Bad request', { 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+
+  if (pathname === '/api/newsletter') {
+    if (req.method !== 'POST') {
+      return send(res, 405, 'Method not allowed', { Allow: 'POST', 'Content-Type': 'text/plain; charset=utf-8' });
+    }
+    handleNewsletter(req, res).catch((err) => {
+      console.error(err);
+      if (!res.headersSent) sendJson(res, 500, { error: 'Something went wrong. Please try again.' });
+    });
+    return;
+  }
+
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    return send(res, 405, 'Method not allowed', { Allow: 'GET, HEAD', 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+  serveStatic(req, res, pathname);
+});
+
+if (require.main === module) {
+  server.listen(PORT, () => console.log(`Daily Grind listening on http://localhost:${PORT}`));
+}
+
+module.exports = { server, CSP, SECURITY_HEADERS };
