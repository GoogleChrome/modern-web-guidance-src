new file mode 100644
index 0000000..f0355d7
--- /dev/null
+++ b/public/newsletter.js
@@ -0,0 +1,87 @@
+(function () {
+  'use strict';
+
+  var form = document.getElementById('newsletter-form');
+  var statusEl = document.getElementById('newsletter-status');
+  if (!form || !statusEl) return;
+
+  var input = form.querySelector('input[name="email"]');
+  var button = form.querySelector('button[type="submit"]');
+  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+  var NETWORK_ERROR =
+    "We couldn't reach our server right now. Please check your connection and try again.";
+  var BLOCKED_ERROR =
+    'Sorry, that request was blocked for your security. Please refresh the page and try again.';
+
+  function showStatus(message, kind) {
+    statusEl.textContent = message;
+    statusEl.className = 'newsletter-status ' + kind;
+    statusEl.hidden = false;
+  }
+
+  // The Content-Security-Policy only lets this page talk to our own server.
+  // If anything (including an injected script) tries to reach another host,
+  // the browser blocks it and fires this event — let the customer know.
+  document.addEventListener('securitypolicyviolation', function (e) {
+    var directive = e.effectiveDirective || e.violatedDirective || '';
+    if (directive.indexOf('connect-src') === 0 || directive.indexOf('form-action') === 0) {
+      showStatus(BLOCKED_ERROR, 'error');
+    }
+  });
+
+  // Fallback (no-JS) submissions redirect back with a query flag.
+  var params = new URLSearchParams(window.location.search);
+  if (params.get('newsletter') === 'ok') {
+    showStatus("Thanks! You're on the list.", 'success');
+  } else if (params.get('newsletter') === 'error') {
+    showStatus("We couldn't sign you up. Please try again.", 'error');
+  }
+
+  form.addEventListener('submit', function (event) {
+    event.preventDefault();
+
+    var email = input.value.trim();
+    if (!EMAIL_RE.test(email) || email.length > 254) {
+      showStatus('Please enter a valid email address.', 'error');
+      input.focus();
+      return;
+    }
+
+    button.disabled = true;
+    showStatus('Signing you up…', 'success');
+
+    var controller = typeof AbortController === 'function' ? new AbortController() : null;
+    var timer = controller && setTimeout(function () { controller.abort(); }, 10000);
+
+    // Same-origin relative URL: the only destination allowed by connect-src.
+    fetch('/api/newsletter', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ email: email }),
+      credentials: 'same-origin',
+      signal: controller ? controller.signal : undefined
+    })
+      .then(function (res) {
+        return res.json().catch(function () { return {}; }).then(function (data) {
+          if (res.ok) {
+            showStatus(data.message || "Thanks! You're on the list.", 'success');
+            form.reset();
+          } else {
+            showStatus(data.error || 'Something went wrong on our end. Please try again shortly.', 'error');
+          }
+        });
+      })
+      .catch(function (err) {
+        if (err && err.name === 'AbortError') {
+          showStatus('The request timed out. Please try again.', 'error');
+        } else {
+          // Offline, server down, or blocked by the Content-Security-Policy.
+          showStatus(NETWORK_ERROR, 'error');
+        }
+      })
+      .then(function () {
+        if (timer) clearTimeout(timer);
+        button.disabled = false;
+      });
+  });
+})();
diff --git a/public/styles.css b/public/styles.css
new file mode 100644
index 0000000..7af5f9a
--- /dev/null
+++ b/public/styles.css
@@ -0,0 +1,225 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+/* Newsletter */
+.newsletter {
+  margin-top: 60px;
+  padding: 40px 20px;
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.newsletter h2 {
+  color: var(--primary);
+  margin-bottom: 8px;
+}
+
+.newsletter-form {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 10px;
+  margin-top: 20px;
+}
+
+.newsletter-form input {
+  flex: 1 1 260px;
+  max-width: 360px;
+  padding: 10px 14px;
+  border: 1px solid var(--secondary);
+  border-radius: 5px;
+  font-size: 1rem;
+}
+
+.newsletter-form input:focus {
+  outline: 2px solid var(--accent);
+  border-color: var(--accent);
+}
+
+.newsletter-form .btn {
+  margin-top: 0;
+  border: none;
+  font-size: 1rem;
+  cursor: pointer;
+}
+
+.newsletter-form .btn:disabled {
+  opacity: 0.6;
+  cursor: wait;
+}
+
+.newsletter-status {
+  margin-top: 16px;
+  padding: 10px 14px;
+  border-radius: 5px;
+  display: inline-block;
+}
+
+.newsletter-status.success {
+  background: #e8f5e9;
+  color: #1b5e20;
+}
+
+.newsletter-status.error {
+  background: #fdecea;
+  color: #8a1c1c;
+}
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
