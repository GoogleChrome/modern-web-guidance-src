@@ -0,0 +1,11 @@
+export function toBase64Url(bytes: Uint8Array | ArrayBuffer): string {
+  return Buffer.from(bytes instanceof ArrayBuffer ? new Uint8Array(bytes) : bytes).toString('base64url');
+}
+
+export function fromBase64Url(value: string): Uint8Array {
+  return new Uint8Array(Buffer.from(value, 'base64url'));
+}
+
+export function isBase64Url(value: unknown): value is string {
+  return typeof value === 'string' && /^[A-Za-z0-9_-]+$/.test(value);
+}
diff --git a/src/lib/passkey-store.ts b/src/lib/passkey-store.ts
new file mode 100644
index 0000000..44b9280
--- /dev/null
+++ b/src/lib/passkey-store.ts
@@ -0,0 +1,127 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { randomBytes } from 'node:crypto';
+import { toBase64Url } from './base64url';
+
+/**
+ * Minimal file-backed persistence for readers' passkeys.
+ *
+ * Passkeys belong to an account rather than a browser session, so they are
+ * kept outside of Astro's session storage. Writes are serialized through a
+ * promise chain so concurrent requests can't clobber each other.
+ */
+
+export interface StoredPasskey {
+  /** Credential ID (base64url). */
+  id: string;
+  /** Reader-facing nickname, e.g. "Work laptop". */
+  name: string;
+  /** SubjectPublicKeyInfo DER (base64url), kept for future passkey sign-in. */
+  publicKey: string | null;
+  publicKeyAlgorithm: number | null;
+  signCount: number;
+  transports: string[];
+  aaguid: string;
+  backupEligible: boolean;
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+interface UserRecord {
+  /** WebAuthn user handle (base64url, 32 random bytes). */
+  userId: string;
+  passkeys: StoredPasskey[];
+}
+
+interface StoreData {
+  users: Record<string, UserRecord>;
+}
+
+const STORE_FILE = path.resolve(process.env.PASSKEY_STORE_PATH ?? path.join(process.cwd(), '.data', 'passkeys.json'));
+
+let cache: StoreData | null = null;
+let queue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<StoreData> {
+  if (cache) return cache;
+  try {
+    const raw = await fs.readFile(STORE_FILE, 'utf8');
+    const parsed = JSON.parse(raw);
+    cache = parsed && typeof parsed.users === 'object' ? parsed : { users: {} };
+  } catch (err: any) {
+    if (err?.code !== 'ENOENT') console.error('[passkeys] Failed to read store, starting empty:', err);
+    cache = { users: {} };
+  }
+  return cache!;
+}
+
+async function persist(data: StoreData): Promise<void> {
+  await fs.mkdir(path.dirname(STORE_FILE), { recursive: true });
+  const tmp = `${STORE_FILE}.${process.pid}.tmp`;
+  await fs.writeFile(tmp, JSON.stringify(data, null, 2), 'utf8');
+  await fs.rename(tmp, STORE_FILE);
+}
+
+function withLock<T>(fn: (data: StoreData) => Promise<T> | T): Promise<T> {
+  const run = queue.then(async () => fn(await load()));
+  queue = run.catch(() => undefined);
+  return run;
+}
+
+function ensureUser(data: StoreData, username: string): { record: UserRecord; created: boolean } {
+  const existing = data.users[username];
+  if (existing) return { record: existing, created: false };
+  const record: UserRecord = { userId: toBase64Url(randomBytes(32)), passkeys: [] };
+  data.users[username] = record;
+  return { record, created: true };
+}
+
+/** Returns the reader's WebAuthn user handle, creating one on first use. */
+export function getOrCreateUserHandle(username: string): Promise<string> {
+  return withLock(async (data) => {
+    const { record, created } = ensureUser(data, username);
+    if (created) await persist(data);
+    return record.userId;
+  });
+}
+
+export function listPasskeys(username: string): Promise<{ userId: string | null; passkeys: StoredPasskey[] }> {
+  return withLock((data) => {
+    const record = data.users[username];
+    return { userId: record?.userId ?? null, passkeys: record ? [...record.passkeys] : [] };
+  });
+}
+
+/** Adds a passkey. Returns false if the credential ID is already registered (to anyone). */
+export function addPasskey(username: string, passkey: StoredPasskey): Promise<boolean> {
+  return withLock(async (data) => {
+    const taken = Object.values(data.users).some((u) => u.passkeys.some((p) => p.id === passkey.id));
+    if (taken) return false;
+    ensureUser(data, username).record.passkeys.push(passkey);
+    await persist(data);
+    return true;
+  });
+}
+
+export function renamePasskey(username: string, id: string, name: string): Promise<StoredPasskey | null> {
+  return withLock(async (data) => {
+    const passkey = data.users[username]?.passkeys.find((p) => p.id === id);
+    if (!passkey) return null;
+    passkey.name = name;
+    await persist(data);
+    return { ...passkey };
+  });
+}
+
+export function deletePasskey(username: string, id: string): Promise<boolean> {
+  return withLock(async (data) => {
+    const record = data.users[username];
+    if (!record) return false;
+    const before = record.passkeys.length;
+    record.passkeys = record.passkeys.filter((p) => p.id !== id);
+    if (record.passkeys.length === before) return false;
+    await persist(data);
+    return true;
+  });
+}
diff --git a/src/lib/webauthn.ts b/src/lib/webauthn.ts
new file mode 100644
index 0000000..88edb68
--- /dev/null
+++ b/src/lib/webauthn.ts
@@ -0,0 +1,147 @@
+import { createHash, timingSafeEqual } from 'node:crypto';
+import { fromBase64Url, isBase64Url, toBase64Url } from './base64url';
+
+export const RP_NAME = 'The DevTools Times';
+export const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+export const MAX_PASSKEYS_PER_USER = 20;
+export const MAX_PASSKEY_NAME_LENGTH = 64;
+
+/** Well-known AAGUIDs, used to suggest a friendly default nickname. */
+const KNOWN_AUTHENTICATORS: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+};
+
+export function authenticatorNameForAaguid(aaguid: string): string | null {
+  return KNOWN_AUTHENTICATORS[aaguid] ?? null;
+}
+
+/** The relying party ID is the effective domain the reader is visiting. */
+export function getRpId(url: URL): string {
+  return url.hostname;
+}
+
+export interface RegistrationPayload {
+  id: string;
+  rawId: string;
+  type: string;
+  clientDataJSON: string;
+  authenticatorData: string;
+  publicKey: string | null;
+  publicKeyAlgorithm: number | null;
+  transports: string[];
+}
+
+export function parseRegistrationPayload(body: any): RegistrationPayload | null {
+  const c = body?.credential;
+  if (!c || typeof c !== 'object') return null;
+  if (!isBase64Url(c.id) || c.id !== c.rawId || c.type !== 'public-key') return null;
+  if (!isBase64Url(c.clientDataJSON) || !isBase64Url(c.authenticatorData)) return null;
+  const transports = Array.isArray(c.transports)
+    ? c.transports.filter((t: unknown): t is string => typeof t === 'string' && /^[a-z-]{1,32}$/.test(t)).slice(0, 8)
+    : [];
+  return {
+    id: c.id,
+    rawId: c.rawId,
+    type: c.type,
+    clientDataJSON: c.clientDataJSON,
+    authenticatorData: c.authenticatorData,
+    publicKey: isBase64Url(c.publicKey) ? c.publicKey : null,
+    publicKeyAlgorithm: Number.isInteger(c.publicKeyAlgorithm) ? c.publicKeyAlgorithm : null,
+    transports,
+  };
+}
+
+export interface VerifiedRegistration {
+  credentialId: string;
+  aaguid: string;
+  signCount: number;
+  backupEligible: boolean;
+  backedUp: boolean;
+}
+
+function sameBytes(a: Uint8Array, b: Uint8Array): boolean {
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+function formatAaguid(bytes: Uint8Array): string {
+  const hex = Buffer.from(bytes).toString('hex');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
+
+function isAllowedOrigin(origin: string, rpId: string): boolean {
+  let parsed: URL;
+  try {
+    parsed = new URL(origin);
+  } catch {
+    return false;
+  }
+  const hostOk = parsed.hostname === rpId || parsed.hostname.endsWith(`.${rpId}`);
+  const isLocal = parsed.hostname === 'localhost' || parsed.hostname === '127.0.0.1';
+  const schemeOk = parsed.protocol === 'https:' || (isLocal && parsed.protocol === 'http:');
+  return hostOk && schemeOk;
+}
+
+/**
+ * Verifies a passkey registration response (attestation "none").
+ * Throws an Error with a reader-safe message if anything doesn't check out.
+ */
+export function verifyRegistration(
+  payload: RegistrationPayload,
+  expected: { challenge: string; rpId: string },
+): VerifiedRegistration {
+  let clientData: any;
+  try {
+    clientData = JSON.parse(Buffer.from(fromBase64Url(payload.clientDataJSON)).toString('utf8'));
+  } catch {
+    throw new Error('Malformed client data.');
+  }
+  if (clientData?.type !== 'webauthn.create') throw new Error('Unexpected ceremony type.');
+  if (typeof clientData.challenge !== 'string' || !sameBytes(fromBase64Url(clientData.challenge), fromBase64Url(expected.challenge))) {
+    throw new Error('Challenge mismatch. Please try again.');
+  }
+  if (typeof clientData.origin !== 'string' || !isAllowedOrigin(clientData.origin, expected.rpId)) {
+    throw new Error('Origin mismatch.');
+  }
+  if (clientData.crossOrigin === true) throw new Error('Cross-origin registration is not allowed.');
+
+  const authData = fromBase64Url(payload.authenticatorData);
+  if (authData.length < 37 + 18) throw new Error('Malformed authenticator data.');
+  const rpIdHash = authData.subarray(0, 32);
+  const expectedHash = createHash('sha256').update(expected.rpId).digest();
+  if (!sameBytes(rpIdHash, expectedHash)) throw new Error('Relying party mismatch.');
+
+  const flags = authData[32];
+  const userPresent = (flags & 0x01) !== 0;
+  const backupEligible = (flags & 0x08) !== 0;
+  const backedUp = (flags & 0x10) !== 0;
+  const attestedData = (flags & 0x40) !== 0;
+  if (!userPresent) throw new Error('User presence was not confirmed.');
+  if (!attestedData) throw new Error('Missing credential data.');
+
+  const signCount = Buffer.from(authData.subarray(33, 37)).readUInt32BE(0);
+  const aaguid = formatAaguid(authData.subarray(37, 53));
+  const idLength = Buffer.from(authData.subarray(53, 55)).readUInt16BE(0);
+  if (idLength === 0 || idLength > 1023 || authData.length < 55 + idLength) throw new Error('Malformed credential ID.');
+  const credentialId = toBase64Url(authData.subarray(55, 55 + idLength));
+  if (credentialId !== payload.id) throw new Error('Credential ID mismatch.');
+
+  return { credentialId, aaguid, signCount, backupEligible, backedUp };
+}
+
+export function sanitizePasskeyName(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  // Collapse whitespace and strip control characters.
+  const name = value.replace(/[\u0000-\u001f\u007f]/g, '').replace(/\s+/g, ' ').trim();
+  if (name.length === 0 || name.length > MAX_PASSKEY_NAME_LENGTH) return null;
+  return name;
+}
