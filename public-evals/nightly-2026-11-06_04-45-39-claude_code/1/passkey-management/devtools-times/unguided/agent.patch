diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..41bce28
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,474 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, TrashIcon, CloudIcon, PlusIcon } from '@heroicons/react/24/outline';
+
+interface Passkey {
+  id: string;
+  name: string;
+  authenticatorName: string | null;
+  createdAt: string;
+  lastUsedAt: string | null;
+  backupEligible: boolean;
+  backedUp: boolean;
+  transports: string[];
+}
+
+interface PasskeyListResponse {
+  rpId: string;
+  user: { id: string | null; name: string; displayName: string };
+  passkeys: Passkey[];
+}
+
+type Notice = { kind: 'success' | 'error' | 'info'; text: string } | null;
+
+const MAX_NAME_LENGTH = 64;
+const apiBase = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}api/passkeys`;
+
+// --- base64url helpers -----------------------------------------------------
+
+function bufferToBase64Url(buffer: ArrayBuffer): string {
+  const bytes = new Uint8Array(buffer);
+  let binary = '';
+  for (const b of bytes) binary += String.fromCharCode(b);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+function base64UrlToBuffer(value: string): ArrayBuffer {
+  const base64 = value.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(value.length / 4) * 4, '=');
+  const binary = atob(base64);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+  return bytes.buffer;
+}
+
+// --- WebAuthn Signal API ---------------------------------------------------
+// These let the relying party tell the browser / password manager which
+// passkeys are still valid so stale ones disappear from autofill and the
+// reader's account name stays current. Unsupported browsers simply skip it.
+
+type SignalCapablePKC = typeof PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (o: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (o: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+
+function getPKC(): SignalCapablePKC | null {
+  return typeof window !== 'undefined' && 'PublicKeyCredential' in window
+    ? (window.PublicKeyCredential as SignalCapablePKC)
+    : null;
+}
+
+function supportsSignalApi(): boolean {
+  return typeof getPKC()?.signalAllAcceptedCredentials === 'function';
+}
+
+async function syncAuthenticator(rpId: string, user: PasskeyListResponse['user'], passkeys: Passkey[]): Promise<boolean> {
+  const PKC = getPKC();
+  if (!PKC || !user.id) return false;
+  let synced = false;
+  try {
+    if (PKC.signalAllAcceptedCredentials) {
+      await PKC.signalAllAcceptedCredentials({
+        rpId,
+        userId: user.id,
+        allAcceptedCredentialIds: passkeys.map((p) => p.id),
+      });
+      synced = true;
+    }
+    if (PKC.signalCurrentUserDetails) {
+      await PKC.signalCurrentUserDetails({ rpId, userId: user.id, name: user.name, displayName: user.displayName });
+      synced = true;
+    }
+  } catch (err) {
+    // Signals are best-effort; never block account management on them.
+    console.warn('[passkeys] Could not sync with the authenticator:', err);
+    return false;
+  }
+  return synced;
+}
+
+// --- formatting ------------------------------------------------------------
+
+function formatDate(iso: string | null): string {
+  if (!iso) return 'Never';
+  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+}
+
+async function readError(res: Response, fallback: string): Promise<string> {
+  const data = await res.json().catch(() => null);
+  return data?.error || fallback;
+}
+
+// --- component -------------------------------------------------------------
+
+export default function PasskeyManager() {
+  const [data, setData] = useState<PasskeyListResponse | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [notice, setNotice] = useState<Notice>(null);
+  const [webauthnSupported, setWebauthnSupported] = useState(true);
+  const [signalSupported, setSignalSupported] = useState(false);
+  const [creating, setCreating] = useState(false);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [draftName, setDraftName] = useState('');
+  const [savingId, setSavingId] = useState<string | null>(null);
+  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null);
+  const [deletingId, setDeletingId] = useState<string | null>(null);
+  const editInputRef = useRef<HTMLInputElement>(null);
+
+  const applyList = useCallback(async (list: PasskeyListResponse) => {
+    setData(list);
+    await syncAuthenticator(list.rpId, list.user, list.passkeys);
+  }, []);
+
+  const load = useCallback(async () => {
+    setLoading(true);
+    try {
+      const res = await fetch(apiBase, { headers: { Accept: 'application/json' } });
+      if (res.status === 401) {
+        window.location.href = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}signin`;
+        return;
+      }
+      if (!res.ok) throw new Error(await readError(res, 'Could not load your passkeys.'));
+      await applyList(await res.json());
+    } catch (err) {
+      setNotice({ kind: 'error', text: (err as Error).message });
+    } finally {
+      setLoading(false);
+    }
+  }, [applyList]);
+
+  useEffect(() => {
+    setWebauthnSupported(!!getPKC() && !!navigator.credentials?.create);
+    setSignalSupported(supportsSignalApi());
+    load();
+  }, [load]);
+
+  useEffect(() => {
+    if (editingId) editInputRef.current?.focus();
+  }, [editingId]);
+
+  // --- create ---------------------------------------------------------------
+
+  const handleCreate = async () => {
+    setNotice(null);
+    setCreating(true);
+    try {
+      const optRes = await fetch(`${apiBase}/options`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: '{}',
+      });
+      if (!optRes.ok) throw new Error(await readError(optRes, 'Could not start passkey registration.'));
+      const opts = await optRes.json();
+
+      const publicKey: PublicKeyCredentialCreationOptions = {
+        ...opts,
+        challenge: base64UrlToBuffer(opts.challenge),
+        user: { ...opts.user, id: base64UrlToBuffer(opts.user.id) },
+        excludeCredentials: opts.excludeCredentials.map((c: { id: string; type: 'public-key'; transports?: AuthenticatorTransport[] }) => ({
+          ...c,
+          id: base64UrlToBuffer(c.id),
+        })),
+      };
+
+      const credential = (await navigator.credentials.create({ publicKey })) as PublicKeyCredential | null;
+      if (!credential) throw new Error('No passkey was created.');
+      const response = credential.response as AuthenticatorAttestationResponse;
+
+      const publicKeyBytes = typeof response.getPublicKey === 'function' ? response.getPublicKey() : null;
+      const payload = {
+        credential: {
+          id: credential.id,
+          rawId: bufferToBase64Url(credential.rawId),
+          type: credential.type,
+          clientDataJSON: bufferToBase64Url(response.clientDataJSON),
+          authenticatorData: bufferToBase64Url(response.getAuthenticatorData()),
+          publicKey: publicKeyBytes ? bufferToBase64Url(publicKeyBytes) : null,
+          publicKeyAlgorithm: typeof response.getPublicKeyAlgorithm === 'function' ? response.getPublicKeyAlgorithm() : null,
+          transports: typeof response.getTransports === 'function' ? response.getTransports() : [],
+        },
+      };
+
+      const saveRes = await fetch(apiBase, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(payload),
+      });
+      if (!saveRes.ok) throw new Error(await readError(saveRes, 'Could not save your passkey.'));
+      const { passkey } = (await saveRes.json()) as { passkey: Passkey };
+
+      await load();
+      setNotice({ kind: 'success', text: `Passkey “${passkey.name}” added. You can rename it below.` });
+    } catch (err) {
+      const e = err as DOMException;
+      if (e?.name === 'NotAllowedError' || e?.name === 'AbortError') {
+        setNotice({ kind: 'info', text: 'Passkey creation was cancelled.' });
+      } else if (e?.name === 'InvalidStateError') {
+        setNotice({ kind: 'info', text: 'This device already has a passkey for your account.' });
+      } else {
+        setNotice({ kind: 'error', text: e?.message || 'Could not create a passkey.' });
+      }
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  // --- rename ---------------------------------------------------------------
+
+  const startEditing = (passkey: Passkey) => {
+    setNotice(null);
+    setConfirmDeleteId(null);
+    setEditingId(passkey.id);
+    setDraftName(passkey.name);
+  };
+
+  const cancelEditing = () => {
+    setEditingId(null);
+    setDraftName('');
+  };
+
+  const handleRename = async (e: React.FormEvent, passkey: Passkey) => {
+    e.preventDefault();
+    const name = draftName.trim();
+    if (!name) {
+      setNotice({ kind: 'error', text: 'Please enter a name for this passkey.' });
+      return;
+    }
+    if (name === passkey.name) {
+      cancelEditing();
+      return;
+    }
+    setSavingId(passkey.id);
+    try {
+      const res = await fetch(`${apiBase}/${encodeURIComponent(passkey.id)}`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name }),
+      });
+      if (!res.ok) throw new Error(await readError(res, 'Could not rename the passkey.'));
+      const { passkey: updated } = (await res.json()) as { passkey: Passkey };
+      setData((prev) =>
+        prev ? { ...prev, passkeys: prev.passkeys.map((p) => (p.id === updated.id ? updated : p)) } : prev,
+      );
+      cancelEditing();
+      setNotice({ kind: 'success', text: `Passkey renamed to “${updated.name}”.` });
+    } catch (err) {
+      setNotice({ kind: 'error', text: (err as Error).message });
+    } finally {
+      setSavingId(null);
+    }
+  };
+
+  // --- delete ---------------------------------------------------------------
+
+  const handleDelete = async (passkey: Passkey) => {
+    if (!data) return;
+    setDeletingId(passkey.id);
+    setNotice(null);
+    try {
+      const res = await fetch(`${apiBase}/${encodeURIComponent(passkey.id)}`, { method: 'DELETE' });
+      if (!res.ok && res.status !== 404) throw new Error(await readError(res, 'Could not remove the passkey.'));
+      const remaining = data.passkeys.filter((p) => p.id !== passkey.id);
+      setData({ ...data, passkeys: remaining });
+      setConfirmDeleteId(null);
+
+      // Tell the browser's authenticator the credential is gone so it stops
+      // offering it during sign-in.
+      const synced = await syncAuthenticator(data.rpId, data.user, remaining);
+      setNotice({
+        kind: 'success',
+        text: synced
+          ? `Passkey “${passkey.name}” removed and your browser’s passkey list was updated.`
+          : `Passkey “${passkey.name}” removed. You may also want to delete it from your device’s password manager.`,
+      });
+    } catch (err) {
+      setNotice({ kind: 'error', text: (err as Error).message });
+    } finally {
+      setDeletingId(null);
+    }
+  };
+
+  // --- render ---------------------------------------------------------------
+
+  const passkeys = data?.passkeys ?? [];
+
+  return (
+    <section aria-labelledby="passkeys-heading" className="border border-gray-200 rounded-lg bg-white">
+      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 p-6 border-b border-gray-200">
+        <div>
+          <h2 id="passkeys-heading" className="text-xl font-bold text-gray-900 flex items-center gap-2">
+            <KeyIcon className="w-5 h-5" aria-hidden="true" />
+            Passkeys
+          </h2>
+          <p className="text-sm text-gray-600 mt-1 max-w-xl">
+            Passkeys let you sign in with your fingerprint, face, or device PIN instead of a password.
+            Rename them so they’re easy to recognize, and remove any you no longer use.
+          </p>
+        </div>
+        <button
+          type="button"
+          onClick={handleCreate}
+          disabled={creating || !webauthnSupported || loading}
+          data-skip-tracking="true"
+          className="inline-flex items-center justify-center gap-1.5 py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed whitespace-nowrap"
+        >
+          <PlusIcon className="w-4 h-4" aria-hidden="true" />
+          {creating ? 'Waiting for device…' : 'Add a passkey'}
+        </button>
+      </div>
+
+      <div className="p-6 space-y-4">
+        {!webauthnSupported && (
+          <p className="p-3 text-sm text-yellow-800 bg-yellow-50 rounded-lg">
+            This browser doesn’t support passkeys. You can still view and manage existing passkeys here.
+          </p>
+        )}
+
+        {notice && (
+          <div
+            role={notice.kind === 'error' ? 'alert' : 'status'}
+            className={`p-3 text-sm rounded-lg ${
+              notice.kind === 'error'
+                ? 'text-red-700 bg-red-100'
+                : notice.kind === 'success'
+                  ? 'text-green-700 bg-green-100'
+                  : 'text-gray-700 bg-gray-100'
+            }`}
+          >
+            {notice.text}
+          </div>
+        )}
+
+        {loading && !data ? (
+          <p className="text-sm text-gray-500" aria-live="polite">Loading your passkeys…</p>
+        ) : passkeys.length === 0 ? (
+          <div className="text-center py-8 border border-dashed border-gray-300 rounded-lg">
+            <KeyIcon className="w-8 h-8 mx-auto text-gray-400" aria-hidden="true" />
+            <p className="mt-2 text-sm font-medium text-gray-900">No passkeys yet</p>
+            <p className="text-sm text-gray-500">Add one to sign in faster and more securely.</p>
+          </div>
+        ) : (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-lg">
+            {passkeys.map((passkey) => {
+              const isEditing = editingId === passkey.id;
+              const isConfirming = confirmDeleteId === passkey.id;
+              const inputId = `passkey-name-${passkey.id}`;
+              return (
+                <li key={passkey.id} className="p-4">
+                  <div className="flex flex-col sm:flex-row sm:items-start gap-3">
+                    <KeyIcon className="hidden sm:block w-6 h-6 mt-0.5 text-gray-500 shrink-0" aria-hidden="true" />
+                    <div className="flex-1 min-w-0">
+                      {isEditing ? (
+                        <form onSubmit={(e) => handleRename(e, passkey)} className="flex flex-col sm:flex-row gap-2">
+                          <label htmlFor={inputId} className="sr-only">Passkey name</label>
+                          <input
+                            ref={editInputRef}
+                            id={inputId}
+                            type="text"
+                            value={draftName}
+                            maxLength={MAX_NAME_LENGTH}
+                            onChange={(e) => setDraftName(e.target.value)}
+                            onKeyDown={(e) => e.key === 'Escape' && cancelEditing()}
+                            className="flex-1 px-3 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                          />
+                          <div className="flex gap-2">
+                            <button
+                              type="submit"
+                              disabled={savingId === passkey.id}
+                              className="py-1.5 px-3 text-sm font-medium text-white bg-gray-900 rounded-md hover:bg-gray-800 disabled:opacity-60"
+                            >
+                              {savingId === passkey.id ? 'Saving…' : 'Save'}
+                            </button>
+                            <button
+                              type="button"
+                              onClick={cancelEditing}
+                              className="py-1.5 px-3 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
+                            >
+                              Cancel
+                            </button>
+                          </div>
+                        </form>
+                      ) : (
+                        <p className="font-semibold text-gray-900 truncate" title={passkey.name}>{passkey.name}</p>
+                      )}
+                      <dl className="mt-1 text-xs text-gray-500 flex flex-wrap gap-x-4 gap-y-1">
+                        {passkey.authenticatorName && passkey.authenticatorName !== passkey.name && (
+                          <div><dt className="sr-only">Provider</dt><dd>{passkey.authenticatorName}</dd></div>
+                        )}
+                        <div className="flex gap-1"><dt>Created</dt><dd>{formatDate(passkey.createdAt)}</dd></div>
+                        <div className="flex gap-1"><dt>Last used</dt><dd>{formatDate(passkey.lastUsedAt)}</dd></div>
+                        {passkey.backupEligible && (
+                          <div className="flex items-center gap-1">
+                            <CloudIcon className="w-3.5 h-3.5" aria-hidden="true" />
+                            <dt className="sr-only">Sync</dt>
+                            <dd>{passkey.backedUp ? 'Synced across devices' : 'Syncable'}</dd>
+                          </div>
+                        )}
+                      </dl>
+                    </div>
+
+                    {!isEditing && !isConfirming && (
+                      <div className="flex gap-2 shrink-0">
+                        <button
+                          type="button"
+                          onClick={() => startEditing(passkey)}
+                          className="inline-flex items-center gap-1 py-1.5 px-3 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
+                          aria-label={`Rename passkey ${passkey.name}`}
+                        >
+                          <PencilSquareIcon className="w-4 h-4" aria-hidden="true" />
+                          Rename
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => {
+                            setEditingId(null);
+                            setConfirmDeleteId(passkey.id);
+                          }}
+                          className="inline-flex items-center gap-1 py-1.5 px-3 text-sm font-medium text-red-700 bg-white border border-red-200 rounded-md hover:bg-red-50"
+                          aria-label={`Remove passkey ${passkey.name}`}
+                        >
+                          <TrashIcon className="w-4 h-4" aria-hidden="true" />
+                          Remove
+                        </button>
+                      </div>
+                    )}
+                  </div>
+
+                  {isConfirming && (
+                    <div role="alertdialog" aria-labelledby={`confirm-${passkey.id}`} className="mt-3 p-3 bg-red-50 border border-red-200 rounded-lg">
+                      <p id={`confirm-${passkey.id}`} className="text-sm text-red-800">
+                        Remove “{passkey.name}”? You won’t be able to sign in with it anymore
+                        {signalSupported ? ', and your browser will be told to forget it.' : '.'}
+                      </p>
+                      <div className="mt-2 flex gap-2">
+                        <button
+                          type="button"
+                          onClick={() => handleDelete(passkey)}
+                          disabled={deletingId === passkey.id}
+                          className="py-1.5 px-3 text-sm font-medium text-white bg-red-600 rounded-md hover:bg-red-700 disabled:opacity-60"
+                        >
+                          {deletingId === passkey.id ? 'Removing…' : 'Remove passkey'}
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => setConfirmDeleteId(null)}
+                          className="py-1.5 px-3 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
+                        >
+                          Keep it
+                        </button>
+                      </div>
+                    </div>
+                  )}
+                </li>
+              );
+            })}
+          </ul>
+        )}
+
+        <p className="text-xs text-gray-500">
+          {signalSupported
+            ? 'Changes here are automatically shared with your browser’s passkey manager so removed passkeys stop appearing at sign-in.'
+            : 'Your browser can’t be updated automatically. After removing a passkey, also delete it from your device’s password manager.'}
+        </p>
+      </div>
+    </section>
+  );
+}
