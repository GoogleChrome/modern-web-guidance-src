@@ -0,0 +1,32 @@
+export interface SessionUser {
+  username: string;
+}
+
+type SessionLike = {
+  get: (key: string) => Promise<any>;
+} | undefined;
+
+/** Returns the signed-in reader stored in the session, if any. */
+export async function getSessionUser(session: SessionLike): Promise<SessionUser | null> {
+  const user = await session?.get('user');
+  if (user && typeof user.username === 'string' && user.username.length > 0) {
+    return { username: user.username };
+  }
+  return null;
+}
+
+export function json(data: unknown, status = 200, headers: Record<string, string> = {}): Response {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...headers },
+  });
+}
+
+/**
+ * State-changing POST endpoints only accept JSON bodies. Cross-site JSON
+ * requests require a CORS preflight, which protects against CSRF even though
+ * Astro's built-in origin check is disabled for this app.
+ */
+export function isJsonRequest(request: Request): boolean {
+  return (request.headers.get('content-type') ?? '').toLowerCase().startsWith('application/json');
+}
