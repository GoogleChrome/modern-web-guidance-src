diff --git a/src/pages/api/passkeys/[id].ts b/src/pages/api/passkeys/[id].ts
new file mode 100644
index 0000000..9238e0b
--- /dev/null
+++ b/src/pages/api/passkeys/[id].ts
@@ -0,0 +1,33 @@
+import type { APIRoute } from 'astro';
+import { getSessionUser, isJsonRequest, json } from '../../../lib/auth';
+import { isBase64Url } from '../../../lib/base64url';
+import { deletePasskey, renamePasskey } from '../../../lib/passkey-store';
+import { MAX_PASSKEY_NAME_LENGTH, sanitizePasskeyName } from '../../../lib/webauthn';
+import { toPublicPasskey } from './_shared';
+
+/** Renames one of the signed-in reader's passkeys. */
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  if (!isJsonRequest(request)) return json({ error: 'Expected JSON body' }, 415);
+  if (!isBase64Url(params.id)) return json({ error: 'Passkey not found' }, 404);
+
+  const body = await request.json().catch(() => null);
+  const name = sanitizePasskeyName(body?.name);
+  if (!name) return json({ error: `Name must be 1–${MAX_PASSKEY_NAME_LENGTH} characters.` }, 400);
+
+  const updated = await renamePasskey(user.username, params.id, name);
+  if (!updated) return json({ error: 'Passkey not found' }, 404);
+  return json({ passkey: toPublicPasskey(updated) });
+};
+
+/** Removes one of the signed-in reader's passkeys. */
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  if (!isBase64Url(params.id)) return json({ error: 'Passkey not found' }, 404);
+
+  const removed = await deletePasskey(user.username, params.id);
+  if (!removed) return json({ error: 'Passkey not found' }, 404);
+  return json({ ok: true });
+};
