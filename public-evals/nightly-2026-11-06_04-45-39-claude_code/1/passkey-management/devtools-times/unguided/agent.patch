+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,43 @@
+import type { APIRoute } from 'astro';
+import { isJsonRequest, json } from '../../../lib/auth';
+
+const LOGIN_ENDPOINT = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+/**
+ * Signs a reader in by forwarding their credentials to the accounts service
+ * and, on success, recording them in the server-side session. Doing this on
+ * the server means the session can't be forged by the browser.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!isJsonRequest(request)) return json({ error: 'Expected JSON body' }, 415);
+
+  const body = await request.json().catch(() => null);
+  const username = typeof body?.username === 'string' ? body.username.trim() : '';
+  const password = typeof body?.password === 'string' ? body.password : '';
+  if (!username || !password) return json({ error: 'Username and password are required' }, 400);
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(LOGIN_ENDPOINT, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return json({ error: 'Accounts service unavailable' }, 502);
+  }
+
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) {
+    return json({ error: data?.error || 'Unknown error' }, upstream.status);
+  }
+
+  if (session) {
+    // Rotate the session ID on privilege change to prevent session fixation.
+    await session.regenerate();
+    session.set('user', { username });
+    session.delete('passkeyChallenge');
+  }
+
+  return json({ ok: true, user: { username } });
+};
