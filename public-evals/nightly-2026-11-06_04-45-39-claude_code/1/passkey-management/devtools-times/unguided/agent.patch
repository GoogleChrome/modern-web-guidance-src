@@ -0,0 +1,26 @@
+import type { StoredPasskey } from '../../../lib/passkey-store';
+import { authenticatorNameForAaguid } from '../../../lib/webauthn';
+
+export interface PublicPasskey {
+  id: string;
+  name: string;
+  authenticatorName: string | null;
+  createdAt: string;
+  lastUsedAt: string | null;
+  backupEligible: boolean;
+  backedUp: boolean;
+  transports: string[];
+}
+
+export function toPublicPasskey(p: StoredPasskey): PublicPasskey {
+  return {
+    id: p.id,
+    name: p.name,
+    authenticatorName: authenticatorNameForAaguid(p.aaguid),
+    createdAt: p.createdAt,
+    lastUsedAt: p.lastUsedAt,
+    backupEligible: p.backupEligible,
+    backedUp: p.backedUp,
+    transports: p.transports,
+  };
+}
diff --git a/src/pages/api/passkeys/index.ts b/src/pages/api/passkeys/index.ts
new file mode 100644
index 0000000..5057a23
--- /dev/null
+++ b/src/pages/api/passkeys/index.ts
@@ -0,0 +1,88 @@
+import type { APIRoute } from 'astro';
+import { getSessionUser, isJsonRequest, json } from '../../../lib/auth';
+import { addPasskey, listPasskeys } from '../../../lib/passkey-store';
+import {
+  CHALLENGE_TTL_MS,
+  MAX_PASSKEYS_PER_USER,
+  authenticatorNameForAaguid,
+  getRpId,
+  parseRegistrationPayload,
+  sanitizePasskeyName,
+  verifyRegistration,
+} from '../../../lib/webauthn';
+import { toPublicPasskey } from './_shared';
+
+/** Lists the signed-in reader's passkeys plus the details needed for the Signal API. */
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  const { userId, passkeys } = await listPasskeys(user.username);
+  return json({
+    rpId: getRpId(url),
+    user: { id: userId, name: user.username, displayName: user.username },
+    passkeys: passkeys.map(toPublicPasskey),
+  });
+};
+
+/** Verifies a registration response and stores the new passkey. */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  if (!isJsonRequest(request)) return json({ error: 'Expected JSON body' }, 415);
+
+  const pending = await session!.get('passkeyChallenge');
+  // Challenges are single use.
+  session!.delete('passkeyChallenge');
+  if (
+    !pending ||
+    pending.username !== user.username ||
+    typeof pending.challenge !== 'string' ||
+    Date.now() - pending.createdAt > CHALLENGE_TTL_MS
+  ) {
+    return json({ error: 'Registration expired. Please try again.' }, 400);
+  }
+
+  const body = await request.json().catch(() => null);
+  const payload = parseRegistrationPayload(body);
+  if (!payload) return json({ error: 'Malformed registration response' }, 400);
+
+  const rpId = getRpId(url);
+  if (pending.rpId !== rpId) return json({ error: 'Relying party mismatch' }, 400);
+
+  let verified;
+  try {
+    verified = verifyRegistration(payload, { challenge: pending.challenge, rpId });
+  } catch (err) {
+    return json({ error: (err as Error).message }, 400);
+  }
+
+  const { passkeys } = await listPasskeys(user.username);
+  if (passkeys.length >= MAX_PASSKEYS_PER_USER) {
+    return json({ error: `You can register up to ${MAX_PASSKEYS_PER_USER} passkeys.` }, 409);
+  }
+
+  const name =
+    sanitizePasskeyName(body?.name) ??
+    authenticatorNameForAaguid(verified.aaguid) ??
+    `Passkey ${passkeys.length + 1}`;
+
+  const stored = {
+    id: verified.credentialId,
+    name,
+    publicKey: payload.publicKey,
+    publicKeyAlgorithm: payload.publicKeyAlgorithm,
+    signCount: verified.signCount,
+    transports: payload.transports,
+    aaguid: verified.aaguid,
+    backupEligible: verified.backupEligible,
+    backedUp: verified.backedUp,
+    createdAt: new Date().toISOString(),
+    lastUsedAt: null,
+  };
+
+  const added = await addPasskey(user.username, stored);
+  if (!added) return json({ error: 'This passkey is already registered.' }, 409);
+
+  return json({ passkey: toPublicPasskey(stored) }, 201);
+};
