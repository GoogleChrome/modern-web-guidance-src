@@ -0,0 +1,40 @@
+import type { APIRoute } from 'astro';
+import { randomBytes } from 'node:crypto';
+import { getSessionUser, isJsonRequest, json } from '../../../lib/auth';
+import { toBase64Url } from '../../../lib/base64url';
+import { getOrCreateUserHandle, listPasskeys } from '../../../lib/passkey-store';
+import { MAX_PASSKEYS_PER_USER, RP_NAME, getRpId } from '../../../lib/webauthn';
+
+/** Issues PublicKeyCredentialCreationOptions (JSON form) for registering a new passkey. */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  if (!isJsonRequest(request)) return json({ error: 'Expected JSON body' }, 415);
+
+  const userId = await getOrCreateUserHandle(user.username);
+  const { passkeys } = await listPasskeys(user.username);
+  if (passkeys.length >= MAX_PASSKEYS_PER_USER) {
+    return json({ error: `You can register up to ${MAX_PASSKEYS_PER_USER} passkeys.` }, 409);
+  }
+
+  const rpId = getRpId(url);
+  const challenge = toBase64Url(randomBytes(32));
+  session!.set('passkeyChallenge', { challenge, rpId, username: user.username, createdAt: Date.now() });
+
+  return json({
+    challenge,
+    rp: { id: rpId, name: RP_NAME },
+    user: { id: userId, name: user.username, displayName: user.username },
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -7 }, // ES256
+      { type: 'public-key', alg: -8 }, // EdDSA
+      { type: 'public-key', alg: -257 }, // RS256
+    ],
+    timeout: 300000,
+    attestation: 'none',
+    authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'preferred' },
+    excludeCredentials: passkeys.map((p) => ({ type: 'public-key', id: p.id, transports: p.transports })),
+    hints: [],
+    extensions: { credProps: true },
+  });
+};
