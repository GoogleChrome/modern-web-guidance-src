@@ -0,0 +1,174 @@
+import type { APIContext } from 'astro';
+
+/**
+ * Session-backed account + passkey store.
+ *
+ * The DevTools Times authenticates readers against an external API and has no
+ * database of its own, so the signed-in reader's profile and registered
+ * passkeys are kept in the Astro session. Swap these helpers for real
+ * persistence when a backend is available — the API routes only depend on the
+ * functions exported here.
+ */
+
+export interface AccountUser {
+  /** Username used to sign in (WebAuthn `user.name`). */
+  username: string;
+  /** Human-friendly name (WebAuthn `user.displayName`). */
+  displayName: string;
+  /** WebAuthn user handle as an unpadded Base64URL string. */
+  passkeyUserId: string;
+}
+
+export interface StoredPasskeyCredential {
+  /** Credential ID as an unpadded Base64URL string. */
+  id: string;
+  /** User-editable nickname (defaults to the provider name). */
+  name: string;
+  /** Authenticator model AAGUID — used for UX hints only, never for security. */
+  aaguid: string;
+  /** Epoch milliseconds. */
+  registeredAt: number;
+  /** Epoch milliseconds. */
+  lastUsedAt?: number;
+}
+
+export interface AccountRecord {
+  user: AccountUser;
+  credentials: StoredPasskeyCredential[];
+}
+
+type SessionLike = APIContext['session'];
+
+const SESSION_KEY = 'account';
+
+export const MAX_PASSKEY_NAME_LENGTH = 64;
+export const MAX_DISPLAY_NAME_LENGTH = 64;
+
+/**
+ * The RP ID passkeys are registered under. Must match `rp.id` used at
+ * registration time. Configure with PASSKEY_RP_ID in production; falls back to
+ * the request host so local development works out of the box. The client
+ * always receives this value from the server and never derives it itself.
+ */
+export function getRpId(url: URL): string {
+  return import.meta.env.PASSKEY_RP_ID || process.env.PASSKEY_RP_ID || url.hostname;
+}
+
+export function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+function randomBase64Url(byteLength: number): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(byteLength));
+  return Buffer.from(bytes).toString('base64url');
+}
+
+const DAY = 24 * 60 * 60 * 1000;
+
+/**
+ * Demo passkeys for a freshly signed-in reader. The site does not yet have a
+ * passkey registration ceremony, so these stand in for credentials that would
+ * otherwise be created via navigator.credentials.create(). IDs are genuine
+ * unpadded Base64URL strings so the Signal API accepts them.
+ */
+function seedCredentials(now: number): StoredPasskeyCredential[] {
+  return [
+    {
+      id: randomBase64Url(16),
+      name: 'Google Password Manager',
+      aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+      registeredAt: now - 120 * DAY,
+      lastUsedAt: now - 2 * DAY,
+    },
+    {
+      id: randomBase64Url(16),
+      name: 'iCloud Keychain',
+      aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+      registeredAt: now - 45 * DAY,
+      lastUsedAt: now - 30 * DAY,
+    },
+    {
+      id: randomBase64Url(16),
+      name: 'Security key',
+      aaguid: '00000000-0000-0000-0000-000000000000',
+      registeredAt: now - 10 * DAY,
+    },
+  ];
+}
+
+export async function getAccount(session: SessionLike): Promise<AccountRecord | null> {
+  const record = (await session?.get(SESSION_KEY)) as AccountRecord | undefined;
+  return record ?? null;
+}
+
+export async function saveAccount(session: SessionLike, record: AccountRecord): Promise<void> {
+  await session?.set(SESSION_KEY, record);
+}
+
+export async function signIn(session: SessionLike, username: string): Promise<AccountRecord> {
+  const existing = await getAccount(session);
+  if (existing && existing.user.username === username) return existing;
+
+  const record: AccountRecord = {
+    user: {
+      username,
+      displayName: username,
+      passkeyUserId: randomBase64Url(32),
+    },
+    credentials: seedCredentials(Date.now()),
+  };
+  await saveAccount(session, record);
+  return record;
+}
+
+export async function signOut(session: SessionLike): Promise<void> {
+  session?.delete(SESSION_KEY);
+}
+
+/** Shape returned to the client for the passkey list. */
+export function passkeyListPayload(record: AccountRecord, url: URL) {
+  return {
+    rpId: getRpId(url),
+    userId: record.user.passkeyUserId,
+    credentials: record.credentials,
+  };
+}
+
+/** Shape returned to the client after a profile update. */
+export function profilePayload(record: AccountRecord, url: URL) {
+  return {
+    name: record.user.username,
+    displayName: record.user.displayName,
+    rpId: getRpId(url),
+    userId: record.user.passkeyUserId,
+  };
+}
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export async function readJson(request: Request): Promise<Record<string, unknown> | null> {
+  try {
+    const body = await request.json();
+    return body && typeof body === 'object' ? (body as Record<string, unknown>) : null;
+  } catch {
+    return null;
+  }
+}
+
+/** Trim, collapse whitespace and strip control characters from a user-supplied label. */
+export function sanitizeLabel(value: unknown, maxLength: number): string | null {
+  if (typeof value !== 'string') return null;
+  const cleaned = value.replace(/[\u0000-\u001f\u007f]/g, '').replace(/\s+/g, ' ').trim();
+  if (!cleaned || cleaned.length > maxLength) return null;
+  return cleaned;
+}
diff --git a/src/lib/webauthn-signals.ts b/src/lib/webauthn-signals.ts
new file mode 100644
index 0000000..5f2d797
--- /dev/null
+++ b/src/lib/webauthn-signals.ts
@@ -0,0 +1,78 @@
+/**
+ * Thin, feature-detected wrappers around the WebAuthn Signal API.
+ *
+ * These calls are a progressive enhancement that keep the reader's password
+ * manager in sync with the server. They are passive: failures are logged with
+ * console.warn and never surface in the UI. Unsupported browsers (e.g. Firefox)
+ * simply skip them while server-side management keeps working.
+ *
+ * Always pass the server-provided rpId — never window.location.hostname.
+ */
+
+type SignalApi = {
+  signalAllAcceptedCredentials?: (options: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+  signalCurrentUserDetails?: (options: {
+    rpId: string;
+    userId: string;
+    name: string;
+    displayName: string;
+  }) => Promise<void>;
+};
+
+function signalApi(): SignalApi | null {
+  if (typeof window === 'undefined' || !('PublicKeyCredential' in window)) return null;
+  return window.PublicKeyCredential as unknown as SignalApi;
+}
+
+/** Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1. */
+export function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+export async function syncAcceptedCredentials(
+  rpId: string,
+  userId: string,
+  credentialIds: string[],
+): Promise<void> {
+  const api = signalApi();
+  if (!api?.signalAllAcceptedCredentials) return;
+  if (!rpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+    console.warn(
+      'signalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.',
+    );
+    return;
+  }
+  try {
+    await api.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds: credentialIds });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+export async function syncCurrentUserDetails(
+  rpId: string,
+  userId: string,
+  name: string,
+  displayName: string,
+): Promise<void> {
+  const api = signalApi();
+  if (!api?.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.');
+    return;
+  }
+  try {
+    await api.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
