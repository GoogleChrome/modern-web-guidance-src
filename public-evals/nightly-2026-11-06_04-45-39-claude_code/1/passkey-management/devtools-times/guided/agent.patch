@@ -0,0 +1,94 @@
+import React, { useId, useState } from 'react';
+import { syncCurrentUserDetails } from '../lib/webauthn-signals';
+
+interface Props {
+  username: string;
+  initialDisplayName: string;
+  maxLength: number;
+}
+
+export default function AccountProfileForm({ username, initialDisplayName, maxLength }: Props) {
+  const [displayName, setDisplayName] = useState(initialDisplayName);
+  const [saved, setSaved] = useState(initialDisplayName);
+  const [saving, setSaving] = useState(false);
+  const [status, setStatus] = useState<{ kind: 'success' | 'error'; text: string } | null>(null);
+  const headingId = useId();
+  const inputId = useId();
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setSaving(true);
+    setStatus(null);
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/account/profile`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ displayName: displayName.trim() }),
+      });
+      const data = await response.json().catch(() => ({}));
+      if (!response.ok) throw new Error(data?.error || 'Could not update your display name.');
+
+      setDisplayName(data.displayName);
+      setSaved(data.displayName);
+      setStatus({ kind: 'success', text: 'Display name updated.' });
+      // Update the name shown for this account in the password manager's passkey picker.
+      void syncCurrentUserDetails(data.rpId, data.userId, data.name, data.displayName);
+    } catch (err) {
+      setStatus({ kind: 'error', text: err instanceof Error ? err.message : 'Could not update your display name.' });
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const unchanged = displayName.trim() === saved;
+
+  return (
+    <section aria-labelledby={headingId} className="border border-gray-200 rounded-lg p-6">
+      <h2 id={headingId} className="text-xl font-bold text-gray-900">
+        Profile
+      </h2>
+      <p className="mt-1 text-sm text-gray-600">
+        Signed in as <strong>{username}</strong>. Your display name is also shown next to your passkeys in
+        supported password managers.
+      </p>
+
+      <form onSubmit={handleSubmit} className="mt-4 flex flex-wrap items-end gap-2">
+        <div className="flex-1 min-w-56">
+          <label htmlFor={inputId} className="block text-sm font-medium text-gray-700 mb-1">
+            Display name
+          </label>
+          <input
+            id={inputId}
+            type="text"
+            name="displayName"
+            autoComplete="name"
+            value={displayName}
+            onChange={(e) => setDisplayName(e.target.value)}
+            required
+            maxLength={maxLength}
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+          />
+        </div>
+        <button
+          type="submit"
+          disabled={saving || unchanged || !displayName.trim()}
+          className="py-2 px-4 text-sm font-medium rounded-md text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-60"
+        >
+          {saving ? 'Saving…' : 'Save'}
+        </button>
+      </form>
+
+      <div role="status" aria-live="polite" className="mt-3 empty:hidden">
+        {status && (
+          <p
+            className={`p-3 text-sm rounded-lg ${
+              status.kind === 'success' ? 'text-green-800 bg-green-100' : 'text-red-700 bg-red-100'
+            }`}
+          >
+            {status.text}
+          </p>
+        )}
+      </div>
+    </section>
+  );
+}
