diff --git a/src/pages/api/account/passkeys/[id].ts b/src/pages/api/account/passkeys/[id].ts
new file mode 100644
index 0000000..8d1f684
--- /dev/null
+++ b/src/pages/api/account/passkeys/[id].ts
@@ -0,0 +1,42 @@
+import type { APIRoute } from 'astro';
+import {
+  MAX_PASSKEY_NAME_LENGTH,
+  getAccount,
+  json,
+  passkeyListPayload,
+  readJson,
+  sanitizeLabel,
+  saveAccount,
+} from '../../../../lib/account';
+
+/** Rename a passkey (server-side label only). */
+export const PUT: APIRoute = async ({ params, request, session, url }) => {
+  const account = await getAccount(session);
+  if (!account) return json({ error: 'Not signed in.' }, 401);
+
+  const credential = account.credentials.find((c) => c.id === params.id);
+  if (!credential) return json({ error: 'Passkey not found.' }, 404);
+
+  const body = await readJson(request);
+  const name = sanitizeLabel(body?.name, MAX_PASSKEY_NAME_LENGTH);
+  if (!name) {
+    return json({ error: `Name must be between 1 and ${MAX_PASSKEY_NAME_LENGTH} characters.` }, 400);
+  }
+
+  credential.name = name;
+  await saveAccount(session, account);
+  return json(passkeyListPayload(account, url));
+};
+
+/** Remove a passkey. Returns the remaining list so the client can signal it. */
+export const DELETE: APIRoute = async ({ params, session, url }) => {
+  const account = await getAccount(session);
+  if (!account) return json({ error: 'Not signed in.' }, 401);
+
+  const index = account.credentials.findIndex((c) => c.id === params.id);
+  if (index === -1) return json({ error: 'Passkey not found.' }, 404);
+
+  account.credentials.splice(index, 1);
+  await saveAccount(session, account);
+  return json(passkeyListPayload(account, url));
+};
