diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..dee254f
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,318 @@
+import React, { useCallback, useEffect, useId, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, TrashIcon } from '@heroicons/react/24/outline';
+import { providerName } from '../lib/aaguids';
+import { syncAcceptedCredentials } from '../lib/webauthn-signals';
+
+interface Passkey {
+  id: string;
+  name: string;
+  aaguid: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+interface PasskeyListResponse {
+  rpId: string;
+  userId: string;
+  credentials: Passkey[];
+}
+
+interface Props {
+  maxNameLength: number;
+}
+
+const API = `${import.meta.env.BASE_URL}api/account/passkeys`;
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+async function errorMessage(response: Response, fallback: string): Promise<string> {
+  try {
+    const data = await response.json();
+    return typeof data?.error === 'string' ? data.error : fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+export default function PasskeyManager({ maxNameLength }: Props) {
+  const [passkeys, setPasskeys] = useState<Passkey[] | null>(null);
+  const [loadError, setLoadError] = useState<string | null>(null);
+  const [status, setStatus] = useState<{ kind: 'success' | 'error'; text: string } | null>(null);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [draftName, setDraftName] = useState('');
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [pendingDelete, setPendingDelete] = useState<Passkey | null>(null);
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const headingId = useId();
+  const dialogTitleId = useId();
+
+  /** Render the server's list and mirror it to the password manager. */
+  const applyList = useCallback((data: PasskeyListResponse, signal: boolean) => {
+    setPasskeys(data.credentials);
+    if (signal) {
+      void syncAcceptedCredentials(
+        data.rpId,
+        data.userId,
+        data.credentials.map((c) => c.id),
+      );
+    }
+  }, []);
+
+  useEffect(() => {
+    let cancelled = false;
+    (async () => {
+      try {
+        const response = await fetch(API, { headers: { Accept: 'application/json' } });
+        if (!response.ok) {
+          throw new Error(
+            response.status === 401
+              ? 'Please sign in to manage your passkeys.'
+              : await errorMessage(response, 'Could not load your passkeys.'),
+          );
+        }
+        const data: PasskeyListResponse = await response.json();
+        // Sync on page load so credentials deleted elsewhere disappear from the authenticator.
+        if (!cancelled) applyList(data, true);
+      } catch (e) {
+        if (!cancelled) setLoadError(e instanceof Error ? e.message : 'Could not load your passkeys.');
+      }
+    })();
+    return () => {
+      cancelled = true;
+    };
+  }, [applyList]);
+
+  const startRename = (passkey: Passkey) => {
+    setStatus(null);
+    setEditingId(passkey.id);
+    setDraftName(passkey.name);
+  };
+
+  const cancelRename = () => {
+    setEditingId(null);
+    setDraftName('');
+  };
+
+  const submitRename = async (e: React.FormEvent<HTMLFormElement>, passkey: Passkey) => {
+    e.preventDefault();
+    const name = draftName.trim();
+    if (name === passkey.name) {
+      cancelRename();
+      return;
+    }
+    setBusyId(passkey.id);
+    setStatus(null);
+    try {
+      const response = await fetch(`${API}/${encodeURIComponent(passkey.id)}`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name }),
+      });
+      if (!response.ok) throw new Error(await errorMessage(response, 'Could not rename the passkey.'));
+      // A nickname is a server-side label only — no Signal API call is needed.
+      applyList(await response.json(), false);
+      cancelRename();
+      setStatus({ kind: 'success', text: `Passkey renamed to “${name}”.` });
+    } catch (err) {
+      setStatus({ kind: 'error', text: err instanceof Error ? err.message : 'Could not rename the passkey.' });
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  const requestDelete = (passkey: Passkey) => {
+    setStatus(null);
+    setPendingDelete(passkey);
+    dialogRef.current?.showModal();
+  };
+
+  const confirmDelete = async () => {
+    const passkey = pendingDelete;
+    dialogRef.current?.close();
+    if (!passkey) return;
+    setBusyId(passkey.id);
+    try {
+      const response = await fetch(`${API}/${encodeURIComponent(passkey.id)}`, { method: 'DELETE' });
+      if (!response.ok) throw new Error(await errorMessage(response, 'Could not remove the passkey.'));
+      // Tell the password manager which credentials remain valid so the removed one is hidden.
+      applyList(await response.json(), true);
+      setStatus({ kind: 'success', text: `“${passkey.name}” was removed from your account.` });
+    } catch (err) {
+      setStatus({ kind: 'error', text: err instanceof Error ? err.message : 'Could not remove the passkey.' });
+    } finally {
+      setBusyId(null);
+    }
+  };
+
+  return (
+    <section aria-labelledby={headingId} className="border border-gray-200 rounded-lg p-6">
+      <h2 id={headingId} className="text-xl font-bold text-gray-900">
+        Passkeys
+      </h2>
+      <p className="mt-1 text-sm text-gray-600">
+        Passkeys let you sign in with your fingerprint, face, screen lock or a security key. Removing a passkey
+        here also hides it from supported password managers on this device.
+      </p>
+
+      <div role="status" aria-live="polite" className="mt-4 empty:hidden">
+        {status && (
+          <p
+            className={`p-3 text-sm rounded-lg ${
+              status.kind === 'success' ? 'text-green-800 bg-green-100' : 'text-red-700 bg-red-100'
+            }`}
+          >
+            {status.text}
+          </p>
+        )}
+      </div>
+
+      {loadError ? (
+        <p className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {loadError}
+        </p>
+      ) : passkeys === null ? (
+        <p className="mt-4 text-sm text-gray-500">Loading passkeys…</p>
+      ) : passkeys.length === 0 ? (
+        <p className="mt-4 text-sm text-gray-600 border border-dashed border-gray-300 rounded-md p-4 text-center">
+          No passkeys found. You can keep signing in with your password.
+        </p>
+      ) : (
+        <ul className="mt-4 divide-y divide-gray-200 border border-gray-200 rounded-md">
+          {passkeys.map((passkey) => {
+            const provider = providerName(passkey.aaguid);
+            const isEditing = editingId === passkey.id;
+            const isBusy = busyId === passkey.id;
+            const inputId = `passkey-name-${passkey.id}`;
+            return (
+              <li key={passkey.id} className="flex flex-col sm:flex-row sm:items-center gap-4 p-4">
+                <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100">
+                  <KeyIcon className="h-5 w-5 text-gray-700" aria-hidden="true" />
+                </span>
+
+                <div className="min-w-0 flex-1">
+                  {isEditing ? (
+                    <form onSubmit={(e) => submitRename(e, passkey)} className="flex flex-wrap items-end gap-2">
+                      <div className="flex-1 min-w-48">
+                        <label htmlFor={inputId} className="block text-xs font-medium text-gray-700 mb-1">
+                          Passkey name
+                        </label>
+                        <input
+                          id={inputId}
+                          type="text"
+                          value={draftName}
+                          onChange={(e) => setDraftName(e.target.value)}
+                          onKeyDown={(e) => e.key === 'Escape' && cancelRename()}
+                          required
+                          maxLength={maxNameLength}
+                          autoComplete="off"
+                          autoFocus
+                          className="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                        />
+                      </div>
+                      <button
+                        type="submit"
+                        disabled={isBusy || !draftName.trim()}
+                        className="py-1.5 px-3 text-sm font-medium rounded-md text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-60"
+                      >
+                        {isBusy ? 'Saving…' : 'Save'}
+                      </button>
+                      <button
+                        type="button"
+                        onClick={cancelRename}
+                        className="py-1.5 px-3 text-sm font-medium rounded-md border border-gray-300 text-gray-700 hover:bg-gray-50"
+                      >
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <>
+                      <p className="font-semibold text-gray-900 truncate">{passkey.name}</p>
+                      {provider !== passkey.name && <p className="text-xs text-gray-500">{provider}</p>}
+                    </>
+                  )}
+                  <dl className="mt-1 flex flex-wrap gap-x-4 text-xs text-gray-500">
+                    <div className="flex gap-1">
+                      <dt>Created</dt>
+                      <dd>
+                        <time dateTime={new Date(passkey.registeredAt).toISOString()}>
+                          {dateFormat.format(passkey.registeredAt)}
+                        </time>
+                      </dd>
+                    </div>
+                    <div className="flex gap-1">
+                      <dt>Last used</dt>
+                      <dd>
+                        {passkey.lastUsedAt ? (
+                          <time dateTime={new Date(passkey.lastUsedAt).toISOString()}>
+                            {dateFormat.format(passkey.lastUsedAt)}
+                          </time>
+                        ) : (
+                          'Never'
+                        )}
+                      </dd>
+                    </div>
+                  </dl>
+                </div>
+
+                {!isEditing && (
+                  <div className="flex gap-2 shrink-0">
+                    <button
+                      type="button"
+                      onClick={() => startRename(passkey)}
+                      disabled={isBusy}
+                      aria-label={`Rename ${passkey.name}`}
+                      className="inline-flex items-center gap-1 py-1.5 px-3 text-sm font-medium rounded-md border border-gray-300 text-gray-700 hover:bg-gray-50 disabled:opacity-60"
+                    >
+                      <PencilSquareIcon className="h-4 w-4" aria-hidden="true" />
+                      Rename
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => requestDelete(passkey)}
+                      disabled={isBusy}
+                      aria-label={`Remove ${passkey.name}`}
+                      className="inline-flex items-center gap-1 py-1.5 px-3 text-sm font-medium rounded-md border border-red-200 text-red-700 hover:bg-red-50 disabled:opacity-60"
+                    >
+                      <TrashIcon className="h-4 w-4" aria-hidden="true" />
+                      {isBusy ? 'Removing…' : 'Remove'}
+                    </button>
+                  </div>
+                )}
+              </li>
+            );
+          })}
+        </ul>
+      )}
+
+      <dialog
+        ref={dialogRef}
+        aria-labelledby={dialogTitleId}
+        onClose={() => setPendingDelete(null)}
+        className="m-auto max-w-sm w-[calc(100%-2rem)] rounded-lg p-6 shadow-xl backdrop:bg-black/40"
+      >
+        <h3 id={dialogTitleId} className="text-lg font-bold text-gray-900">
+          Remove passkey?
+        </h3>
+        <p className="mt-2 text-sm text-gray-600">
+          You will no longer be able to sign in with <strong>{pendingDelete?.name}</strong>. Supported password
+          managers will hide it automatically; otherwise you can delete it from your password manager yourself.
+        </p>
+        <form method="dialog" className="mt-6 flex justify-end gap-2">
+          <button
+            type="submit"
+            autoFocus
+            className="py-2 px-4 text-sm font-medium rounded-md border border-gray-300 text-gray-700 hover:bg-gray-50"
+          >
+            Cancel
+          </button>
+          <button
+            type="button"
+            onClick={confirmDelete}
+            className="py-2 px-4 text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700"
+          >
+            Remove
+          </button>
+        </form>
+      </dialog>
+    </section>
+  );
+}
