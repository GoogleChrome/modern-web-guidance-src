+import type { APIRoute } from 'astro';
+import {
+  MAX_DISPLAY_NAME_LENGTH,
+  getAccount,
+  json,
+  profilePayload,
+  readJson,
+  sanitizeLabel,
+  saveAccount,
+} from '../../../lib/account';
+
+/** Update the reader's display name. Returns rpId + userId for signalCurrentUserDetails(). */
+export const PUT: APIRoute = async ({ request, session, url }) => {
+  const account = await getAccount(session);
+  if (!account) return json({ error: 'Not signed in.' }, 401);
+
+  const body = await readJson(request);
+  const displayName = sanitizeLabel(body?.displayName, MAX_DISPLAY_NAME_LENGTH);
+  if (!displayName) {
+    return json({ error: `Display name must be between 1 and ${MAX_DISPLAY_NAME_LENGTH} characters.` }, 400);
+  }
+
+  account.user.displayName = displayName;
+  await saveAccount(session, account);
+  return json(profilePayload(account, url));
+};
diff --git a/src/pages/api/account/session.ts b/src/pages/api/account/session.ts
new file mode 100644
index 0000000..2625ef2
--- /dev/null
+++ b/src/pages/api/account/session.ts
@@ -0,0 +1,18 @@
+import type { APIRoute } from 'astro';
+import { json, readJson, sanitizeLabel, signIn, signOut } from '../../../lib/account';
+
+/** Establish the local signed-in session after a successful sign-in. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await readJson(request);
+  const username = sanitizeLabel(body?.username, 64);
+  if (!username) return json({ error: 'A valid username is required.' }, 400);
+
+  const record = await signIn(session, username);
+  return json({ name: record.user.username, displayName: record.user.displayName });
+};
+
+/** Sign out of the local session. */
+export const DELETE: APIRoute = async ({ session }) => {
+  await signOut(session);
+  return json({ success: true });
+};
