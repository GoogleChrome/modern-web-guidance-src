diff --git a/account/api.js b/account/api.js
new file mode 100644
index 0000000..17d8053
--- /dev/null
+++ b/account/api.js
@@ -0,0 +1,148 @@
+// HTTP client for the account / passkey endpoints.
+//
+// Expected server contract (all routes require an authenticated session cookie):
+//   GET    /api/credentials                 -> { rpId, userId, credentials: StoredPasskeyCredential[] }
+//   PUT    /api/credential/:id  { name }    -> StoredPasskeyCredential
+//   DELETE /api/credential/:id              -> { success: true }
+//   GET    /api/user                        -> { name, displayName, rpId, userId }
+//   PUT    /api/user  { name, displayName } -> { name, displayName, rpId, userId }
+//   POST   /api/passkey/registration-options -> PublicKeyCredentialCreationOptionsJSON
+//   POST   /api/passkey/register  (credential.toJSON()) -> StoredPasskeyCredential
+//
+// `rpId` must be the server's configured RP ID and `userId` / credential `id`s must be
+// unpadded Base64URL strings.
+//
+// Add `?demo` to the page URL to use an in-browser mock backend instead (sample data in
+// localStorage). Demo mode never calls the WebAuthn Signal API.
+
+export const DEMO = new URLSearchParams(location.search).has('demo');
+
+async function request(method, path, body) {
+  const res = await fetch(path, {
+    method,
+    credentials: 'same-origin',
+    headers: body ? { 'Content-Type': 'application/json', Accept: 'application/json' } : { Accept: 'application/json' },
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  if (res.status === 401) {
+    location.href = `/login?next=${encodeURIComponent(location.pathname)}`;
+    throw new Error('Not signed in');
+  }
+  if (!res.ok) {
+    let message = `Request failed (${res.status})`;
+    try {
+      message = (await res.json()).error || message;
+    } catch { /* non-JSON error body */ }
+    const err = new Error(message);
+    err.status = res.status;
+    throw err;
+  }
+  return res.json();
+}
+
+const http = {
+  listCredentials: () => request('GET', '/api/credentials'),
+  renameCredential: (id, name) => request('PUT', `/api/credential/${encodeURIComponent(id)}`, { name }),
+  deleteCredential: (id) => request('DELETE', `/api/credential/${encodeURIComponent(id)}`),
+  getUser: () => request('GET', '/api/user'),
+  updateUser: (details) => request('PUT', '/api/user', details),
+  registrationOptions: () => request('POST', '/api/passkey/registration-options', { promotion: false }),
+  // Returns the raw Response so the caller can signal unknown credentials on failure.
+  registerCredential: (credentialJSON) => fetch('/api/passkey/register', {
+    method: 'POST',
+    credentials: 'same-origin',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(credentialJSON),
+  }),
+};
+
+// ---------------------------------------------------------------------------
+// Demo backend
+// ---------------------------------------------------------------------------
+const STORE_KEY = 'daily-grind-demo-account';
+const DAY = 86_400_000;
+
+function seed() {
+  const now = Date.now();
+  return {
+    rpId: location.hostname,
+    user: { userId: 'ZGcteXVzZXItMDAx', name: 'sam@example.com', displayName: 'Sam Rivera' },
+    credentials: [
+      {
+        id: 'ZGctY3JlZC1nb29nbGUtMDE',
+        name: 'Google Password Manager',
+        aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+        registeredAt: now - 120 * DAY,
+        lastUsedAt: now - 2 * DAY,
+      },
+      {
+        id: 'ZGctY3JlZC1pY2xvdWQtMDI',
+        name: 'iCloud Keychain',
+        aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+        registeredAt: now - 45 * DAY,
+        lastUsedAt: now - 9 * DAY,
+      },
+      {
+        id: 'ZGctY3JlZC15dWJpa2V5LTAz',
+        name: 'Work security key',
+        aaguid: '00000000-0000-0000-0000-000000000000',
+        registeredAt: now - 300 * DAY,
+      },
+    ],
+  };
+}
+
+function load() {
+  try {
+    const data = JSON.parse(localStorage.getItem(STORE_KEY));
+    if (data?.credentials) return data;
+  } catch { /* fall through to seed */ }
+  const data = seed();
+  save(data);
+  return data;
+}
+
+function save(data) {
+  localStorage.setItem(STORE_KEY, JSON.stringify(data));
+}
+
+const delay = (value) => new Promise((resolve) => setTimeout(() => resolve(structuredClone(value)), 250));
+
+const demo = {
+  listCredentials() {
+    const { rpId, user, credentials } = load();
+    return delay({ rpId, userId: user.userId, credentials });
+  },
+  renameCredential(id, name) {
+    const data = load();
+    const cred = data.credentials.find((c) => c.id === id);
+    if (!cred) return Promise.reject(new Error('Credential not found.'));
+    cred.name = name;
+    save(data);
+    return delay(cred);
+  },
+  deleteCredential(id) {
+    const data = load();
+    data.credentials = data.credentials.filter((c) => c.id !== id);
+    save(data);
+    return delay({ success: true });
+  },
+  getUser() {
+    const { rpId, user } = load();
+    return delay({ ...user, rpId });
+  },
+  updateUser({ name, displayName }) {
+    const data = load();
+    Object.assign(data.user, { name, displayName });
+    save(data);
+    return delay({ ...data.user, rpId: data.rpId });
+  },
+  registrationOptions() {
+    return Promise.reject(new Error('Creating passkeys needs the real server; it is not available in demo mode.'));
+  },
+  registerCredential() {
+    return Promise.reject(new Error('Not available in demo mode.'));
+  },
+};
+
+export const api = DEMO ? demo : http;
