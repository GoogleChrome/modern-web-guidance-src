diff --git a/account/passkeys.js b/account/passkeys.js
new file mode 100644
index 0000000..d41e5b2
--- /dev/null
+++ b/account/passkeys.js
@@ -0,0 +1,326 @@
+import { api, DEMO } from './api.js';
+
+// Load WebAuthn JSON/capability polyfills only for browsers that have WebAuthn but lack the
+// newer static helpers (getClientCapabilities, parseCreationOptionsFromJSON, toJSON).
+if (
+  window.PublicKeyCredential &&
+  (!PublicKeyCredential.getClientCapabilities ||
+    !PublicKeyCredential.parseCreationOptionsFromJSON ||
+    !PublicKeyCredential.prototype.toJSON)
+) {
+  try {
+    await import('https://esm.sh/webauthn-polyfills');
+  } catch (e) {
+    console.warn('WebAuthn polyfills failed to load:', e);
+  }
+}
+
+const $ = (sel) => document.querySelector(sel);
+
+const els = {
+  list: $('#passkey-list'),
+  empty: $('#passkey-empty'),
+  template: $('#passkey-row'),
+  create: $('#create-passkey'),
+  unsupported: $('#passkey-unsupported'),
+  status: $('#status'),
+  profileForm: $('#profile-form'),
+  renameDialog: $('#rename-dialog'),
+  renameForm: $('#rename-form'),
+  deleteDialog: $('#delete-dialog'),
+  demoBanner: $('#demo-banner'),
+};
+
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+const DEFAULT_ICON = `data:image/svg+xml,${encodeURIComponent(
+  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#4e342e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="4.5"/><path d="m21 2-9.6 9.6M15.5 7.5l3 3L22 7l-3-3"/></svg>',
+)}`;
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+/** Latest server state, used for rendering and Signal API sync. */
+let state = { rpId: '', userId: '', credentials: [] };
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1.
+function isValidBase64Url(value) {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+function announce(message, { error = false } = {}) {
+  els.status.textContent = message;
+  els.status.classList.toggle('error', error);
+}
+
+function displayName(cred) {
+  if (cred.name) return cred.name;
+  return cred.aaguid && cred.aaguid !== ZERO_AAGUID ? 'Passkey' : 'Unknown passkey provider';
+}
+
+// ---------------------------------------------------------------------------
+// Signal API sync (progressive enhancement; failures are non-fatal)
+// ---------------------------------------------------------------------------
+
+async function syncAcceptedCredentials({ rpId, userId, credentials }) {
+  // Never signal sample data: it would tell the real password manager to hide real passkeys.
+  if (DEMO) return;
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  const allAcceptedCredentialIds = credentials.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !allAcceptedCredentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: server rpId and valid Base64URL userId / credential IDs are required.');
+    return;
+  }
+  try {
+    // rpId comes from the server, never from location.hostname.
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+async function syncUserDetails({ rpId, userId, name, displayName }) {
+  if (DEMO) return;
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: server rpId and valid Base64URL userId are required.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Rendering
+// ---------------------------------------------------------------------------
+
+function render() {
+  const rows = state.credentials
+    .toSorted((a, b) => (b.lastUsedAt ?? b.registeredAt) - (a.lastUsedAt ?? a.registeredAt))
+    .map((cred) => {
+      const row = els.template.content.firstElementChild.cloneNode(true);
+      const name = displayName(cred);
+      row.dataset.id = cred.id;
+
+      const icon = row.querySelector('.passkey-icon');
+      icon.src = cred.providerIcon || DEFAULT_ICON;
+
+      row.querySelector('.passkey-name').textContent = name;
+
+      const meta = [`Created ${dateFormat.format(cred.registeredAt)}`];
+      meta.push(cred.lastUsedAt ? `Last used ${dateFormat.format(cred.lastUsedAt)}` : 'Never used');
+      if (cred.credentialBackedUp) meta.push('Synced');
+      row.querySelector('.passkey-meta').textContent = meta.join(' · ');
+
+      row.querySelector('[data-action="rename"]').setAttribute('aria-label', `Rename ${name}`);
+      row.querySelector('[data-action="delete"]').setAttribute('aria-label', `Delete ${name}`);
+      return row;
+    });
+
+  els.list.replaceChildren(...rows);
+  els.list.setAttribute('aria-busy', 'false');
+  els.empty.hidden = rows.length > 0;
+}
+
+async function refreshCredentials() {
+  state = await api.listCredentials();
+  render();
+  await syncAcceptedCredentials(state);
+}
+
+// ---------------------------------------------------------------------------
+// Rename / delete
+// ---------------------------------------------------------------------------
+
+let pendingId = null;
+
+function findCredential(id) {
+  return state.credentials.find((c) => c.id === id);
+}
+
+els.list.addEventListener('click', (event) => {
+  const button = event.target.closest('button[data-action]');
+  if (!button) return;
+  const id = button.closest('.passkey').dataset.id;
+  const cred = findCredential(id);
+  if (!cred) return;
+  pendingId = id;
+
+  if (button.dataset.action === 'rename') {
+    const input = els.renameForm.elements.name;
+    input.value = displayName(cred);
+    els.renameDialog.showModal();
+    input.select();
+  } else {
+    els.deleteDialog.querySelector('[data-name]').textContent = displayName(cred);
+    els.deleteDialog.showModal();
+  }
+});
+
+els.renameDialog.querySelector('[data-close]').addEventListener('click', () => els.renameDialog.close());
+
+els.renameDialog.addEventListener('close', async () => {
+  const choice = els.renameDialog.returnValue;
+  els.renameDialog.returnValue = '';
+  const id = pendingId;
+  pendingId = null;
+  if (choice !== 'save' || !id) return;
+
+  const newName = els.renameForm.elements.name.value.trim();
+  const cred = findCredential(id);
+  if (!newName || !cred || newName === cred.name) return;
+
+  try {
+    // Renaming a passkey only changes the server-side label; no Signal API call needed.
+    await api.renameCredential(id, newName);
+    state = await api.listCredentials();
+    render();
+    announce(`Passkey renamed to “${newName}”.`);
+  } catch (e) {
+    announce(`Couldn't rename passkey: ${e.message}`, { error: true });
+  }
+});
+
+els.deleteDialog.addEventListener('close', async () => {
+  const choice = els.deleteDialog.returnValue;
+  els.deleteDialog.returnValue = '';
+  const id = pendingId;
+  pendingId = null;
+  if (choice !== 'delete' || !id) return;
+
+  const name = displayName(findCredential(id) ?? {});
+  try {
+    await api.deleteCredential(id);
+    // Re-fetch and tell the password manager which passkeys are still valid,
+    // so the deleted one stops being offered at sign-in.
+    await refreshCredentials();
+    announce(`“${name}” was deleted.`);
+    els.create.hidden || els.create.focus();
+  } catch (e) {
+    announce(`Couldn't delete passkey: ${e.message}`, { error: true });
+  }
+});
+
+// ---------------------------------------------------------------------------
+// Account details
+// ---------------------------------------------------------------------------
+
+async function loadProfile() {
+  const user = await api.getUser();
+  els.profileForm.elements.name.value = user.name ?? '';
+  els.profileForm.elements.displayName.value = user.displayName ?? '';
+}
+
+els.profileForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const form = els.profileForm;
+  const name = form.elements.name.value.trim();
+  const displayName = form.elements.displayName.value.trim();
+  const submit = form.querySelector('[type="submit"]');
+  submit.disabled = true;
+  try {
+    const updated = await api.updateUser({ name, displayName });
+    await syncUserDetails({
+      rpId: updated.rpId,
+      userId: updated.userId,
+      name: updated.name ?? name,
+      displayName: updated.displayName ?? displayName,
+    });
+    announce('Account details saved.');
+  } catch (e) {
+    announce(`Couldn't save details: ${e.message}`, { error: true });
+  } finally {
+    submit.disabled = false;
+  }
+});
+
+// ---------------------------------------------------------------------------
+// Create passkey
+// ---------------------------------------------------------------------------
+
+async function setupCreateButton() {
+  let supported = false;
+  if (window.PublicKeyCredential && PublicKeyCredential.getClientCapabilities) {
+    try {
+      const caps = await PublicKeyCredential.getClientCapabilities();
+      supported = Boolean(caps.passkeyPlatformAuthenticator && caps.conditionalGet);
+    } catch (e) {
+      console.warn('getClientCapabilities failed:', e);
+    }
+  }
+  els.create.hidden = !supported;
+  els.unsupported.hidden = supported;
+}
+
+async function createPasskey() {
+  els.create.disabled = true;
+  try {
+    let publicKey;
+    try {
+      // Management flow: the server omits authenticatorAttachment so security keys work too.
+      publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await api.registrationOptions());
+    } catch (e) {
+      announce(`Couldn't start passkey creation: ${e.message}`, { error: true });
+      return;
+    }
+
+    let credential;
+    try {
+      credential = await navigator.credentials.create({ publicKey });
+    } catch (err) {
+      if (err.name === 'InvalidStateError') {
+        announce('You already have a passkey for this account in that password manager.', { error: true });
+      } else if (err.name === 'SecurityError') {
+        announce('Passkeys are not available on this site configuration.', { error: true });
+      } else if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') {
+        announce(`Couldn't create passkey: ${err.message}`, { error: true });
+      }
+      return; // User cancelled or the operation failed before the server saw anything.
+    }
+
+    const encoded = credential.toJSON();
+    let ok = false;
+    try {
+      ok = (await api.registerCredential(encoded)).ok;
+    } catch (e) {
+      console.warn('Passkey registration request failed:', e);
+    }
+
+    if (!ok) {
+      // The authenticator saved a credential the server rejected; ask it to drop the orphan.
+      if (PublicKeyCredential.signalUnknownCredential) {
+        try {
+          await PublicKeyCredential.signalUnknownCredential({ rpId: publicKey.rp.id, credentialId: encoded.id });
+        } catch (e) {
+          console.warn('signalUnknownCredential sync warning:', e);
+        }
+      }
+      announce("Couldn't save your new passkey. Please try again.", { error: true });
+      return;
+    }
+
+    await refreshCredentials();
+    announce('Passkey created. You can now use it to sign in.');
+  } finally {
+    els.create.disabled = false;
+  }
+}
+
+els.create.addEventListener('click', createPasskey);
+
+// ---------------------------------------------------------------------------
+// Init
+// ---------------------------------------------------------------------------
+
+els.demoBanner.hidden = !DEMO;
+setupCreateButton();
+loadProfile().catch((e) => announce(`Couldn't load account details: ${e.message}`, { error: true }));
+refreshCredentials().catch((e) => {
+  els.list.setAttribute('aria-busy', 'false');
+  announce(`Couldn't load your passkeys: ${e.message}`, { error: true });
+});
diff --git a/assets/site.css b/assets/site.css
new file mode 100644
index 0000000..504f745
--- /dev/null
+++ b/assets/site.css
@@ -0,0 +1,146 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
