+++ b/account/passkeys.js
@@ -0,0 +1,559 @@
+/**
+ * Passkey management for the "My Account" page.
+ *
+ * Server contract (session-cookie authenticated, same origin):
+ *
+ *   GET    /api/account/passkeys
+ *     200 → {
+ *       rpId: "dailygrind.example",
+ *       user: { id: "<base64url user handle>", name: "jane@example.com", displayName: "Jane Doe" },
+ *       passkeys: [{
+ *         id: "<base64url credential ID>",
+ *         name: "MacBook Touch ID",
+ *         createdAt: "2026-01-02T03:04:05Z",
+ *         lastUsedAt: "2026-10-30T08:00:00Z" | null,
+ *         aaguid: "fbfc3007-154e-4ecc-8c0b-6e020557d7bd" | null,   // optional
+ *         provider: "iCloud Keychain" | null,                      // optional, preferred over aaguid lookup
+ *         backedUp: true | false,                                  // optional (synced passkey)
+ *         current: true | false                                    // optional, used for this session
+ *       }]
+ *     }
+ *     401 → not signed in
+ *
+ *   PATCH  /api/account/passkeys/:id   body { name }  → 200 updated passkey object
+ *   DELETE /api/account/passkeys/:id                  → 204
+ *
+ * Mutating requests send the CSRF token from <meta name="csrf-token"> as X-CSRF-Token.
+ *
+ * Authenticator sync uses the WebAuthn Signal API
+ * (https://w3c.github.io/webauthn/#sctn-signal-methods) so the user's password manager /
+ * platform authenticator hides or removes passkeys that the server no longer accepts and
+ * shows up-to-date account details. All signal calls are best-effort and feature-detected.
+ *
+ * Append ?demo to the URL to preview the UI with in-memory sample data. Demo mode never
+ * calls the Signal API, so it cannot affect real passkeys stored in the browser.
+ */
+
+const API_BASE = '/api/account/passkeys';
+const MAX_NAME_LENGTH = 64;
+
+// Well-known authenticator AAGUIDs → friendly provider names (fallback when the server
+// doesn't supply `provider`). Source: passkey-authenticator-aaguids community list.
+const KNOWN_AAGUIDS = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+};
+
+const isDemo = new URLSearchParams(location.search).has('demo');
+
+const els = {
+  container: document.getElementById('passkey-container'),
+  status: document.getElementById('status'),
+  syncNote: document.getElementById('sync-note'),
+  greeting: document.getElementById('greeting'),
+  heading: document.getElementById('passkeys-heading'),
+  dialog: document.getElementById('delete-dialog'),
+  deleteName: document.getElementById('delete-name'),
+  deleteLastWarning: document.getElementById('delete-last-warning'),
+};
+
+/** @type {{ rpId: string, user: {id: string, name: string, displayName: string}, passkeys: any[] } | null} */
+let state = null;
+let editingId = null;
+
+/* ------------------------------------------------------------------ API */
+
+class ApiError extends Error {
+  constructor(message, status) {
+    super(message);
+    this.status = status;
+  }
+}
+
+function csrfToken() {
+  return document.querySelector('meta[name="csrf-token"]')?.content || '';
+}
+
+async function request(method, path = '', body) {
+  const headers = { Accept: 'application/json' };
+  if (method !== 'GET') headers['X-CSRF-Token'] = csrfToken();
+  if (body !== undefined) headers['Content-Type'] = 'application/json';
+
+  let res;
+  try {
+    res = await fetch(API_BASE + path, {
+      method,
+      headers,
+      credentials: 'same-origin',
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+  } catch {
+    throw new ApiError('Network error. Check your connection and try again.', 0);
+  }
+
+  if (res.status === 401) {
+    location.assign(`/login?next=${encodeURIComponent(location.pathname + location.hash)}`);
+    throw new ApiError('Your session has expired. Redirecting to sign in…', 401);
+  }
+  if (!res.ok) {
+    let message = `Something went wrong (HTTP ${res.status}).`;
+    try {
+      const data = await res.json();
+      if (data && typeof data.error === 'string') message = data.error;
+      else if (data && typeof data.message === 'string') message = data.message;
+    } catch { /* non-JSON error body */ }
+    throw new ApiError(message, res.status);
+  }
+  if (res.status === 204) return null;
+  return res.json();
+}
+
+const realApi = {
+  list: () => request('GET'),
+  rename: (id, name) => request('PATCH', `/${encodeURIComponent(id)}`, { name }),
+  remove: (id) => request('DELETE', `/${encodeURIComponent(id)}`),
+};
+
+function createDemoApi() {
+  const day = 86400000;
+  const now = Date.now();
+  const data = {
+    rpId: location.hostname,
+    user: { id: 'ZGVtby11c2Vy', name: 'jamie@example.com', displayName: 'Jamie Rivera' },
+    passkeys: [
+      { id: 'cred-a', name: 'MacBook Air', createdAt: new Date(now - 200 * day).toISOString(), lastUsedAt: new Date(now - 1 * day).toISOString(), aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd', backedUp: true, current: true },
+      { id: 'cred-b', name: 'Pixel 9', createdAt: new Date(now - 90 * day).toISOString(), lastUsedAt: new Date(now - 12 * day).toISOString(), aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4', backedUp: true },
+      { id: 'cred-c', name: 'Work laptop', createdAt: new Date(now - 400 * day).toISOString(), lastUsedAt: null, aaguid: '08987058-cadc-4b81-b6e1-30de50dcbe96', backedUp: false },
+    ],
+  };
+  const delay = () => new Promise((r) => setTimeout(r, 300));
+  const clone = (v) => JSON.parse(JSON.stringify(v));
+  return {
+    async list() { await delay(); return clone(data); },
+    async rename(id, name) {
+      await delay();
+      const pk = data.passkeys.find((p) => p.id === id);
+      if (!pk) throw new ApiError('Passkey not found.', 404);
+      pk.name = name;
+      return clone(pk);
+    },
+    async remove(id) {
+      await delay();
+      data.passkeys = data.passkeys.filter((p) => p.id !== id);
+      return null;
+    },
+  };
+}
+
+const api = isDemo ? createDemoApi() : realApi;
+
+/* ------------------------------------------------- Authenticator sync */
+
+const PKC = window.PublicKeyCredential;
+const signalSupport = {
+  accepted: !!PKC && typeof PKC.signalAllAcceptedCredentials === 'function',
+  unknown: !!PKC && typeof PKC.signalUnknownCredential === 'function',
+  user: !!PKC && typeof PKC.signalCurrentUserDetails === 'function',
+};
+const canSync = !isDemo && (signalSupport.accepted || signalSupport.unknown);
+
+async function safeSignal(label, fn) {
+  try {
+    await fn();
+    return true;
+  } catch (err) {
+    // Signals are advisory; failures (e.g. rpId mismatch, unsupported authenticator)
+    // must never break account management.
+    console.warn(`[passkeys] ${label} signal failed:`, err);
+    return false;
+  }
+}
+
+/**
+ * Tell the browser/password manager which credentials the server still accepts for this
+ * user, so any others get hidden or removed from the passkey picker. Also refresh the
+ * user's name/displayName shown by the authenticator.
+ */
+async function syncAllWithAuthenticator() {
+  if (isDemo || !state?.rpId || !state?.user?.id) return;
+  const { rpId, user } = state;
+
+  if (signalSupport.accepted) {
+    await safeSignal('signalAllAcceptedCredentials', () =>
+      PKC.signalAllAcceptedCredentials({
+        rpId,
+        userId: user.id,
+        allAcceptedCredentialIds: state.passkeys.map((p) => p.id),
+      }));
+  }
+  if (signalSupport.user && user.name) {
+    await safeSignal('signalCurrentUserDetails', () =>
+      PKC.signalCurrentUserDetails({
+        rpId,
+        userId: user.id,
+        name: user.name,
+        displayName: user.displayName || user.name,
+      }));
+  }
+}
+
+/** After a successful server-side delete, make the authenticator forget the credential. */
+async function syncDeletionWithAuthenticator(credentialId) {
+  if (isDemo || !state?.rpId) return false;
+  if (signalSupport.accepted && state.user?.id) {
+    return safeSignal('signalAllAcceptedCredentials', () =>
+      PKC.signalAllAcceptedCredentials({
+        rpId: state.rpId,
+        userId: state.user.id,
+        allAcceptedCredentialIds: state.passkeys.map((p) => p.id),
+      }));
+  }
+  if (signalSupport.unknown) {
+    return safeSignal('signalUnknownCredential', () =>
+      PKC.signalUnknownCredential({ rpId: state.rpId, credentialId }));
+  }
+  return false;
+}
+
+function renderSyncNote() {
+  els.syncNote.hidden = false;
+  if (isDemo) {
+    els.syncNote.textContent =
+      'Demo mode: showing sample passkeys. Changes are not saved and your browser’s passkeys are not touched.';
+  } else if (canSync) {
+    els.syncNote.textContent =
+      'Your browser or password manager is kept in sync automatically: deleted passkeys are removed from its sign-in list. Passkey names are only stored with your Daily Grind account.';
+  } else {
+    els.syncNote.textContent =
+      'Your browser can’t be updated automatically. After deleting a passkey here, also remove it from your device’s password manager (e.g. iCloud Keychain, Google Password Manager, or Windows Hello settings).';
+  }
+}
+
+/* ------------------------------------------------------------ Rendering */
+
+const dateFmt = new Intl.DateTimeFormat(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+const relFmt = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
+
+function formatDate(iso) {
+  const d = iso ? new Date(iso) : null;
+  return d && !Number.isNaN(d.getTime()) ? dateFmt.format(d) : 'Unknown';
+}
+
+function formatRelative(iso) {
+  if (!iso) return 'Never used';
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return 'Unknown';
+  const days = Math.round((d.getTime() - Date.now()) / 86400000);
+  if (days > -1) return 'Used today';
+  if (days > -30) return `Used ${relFmt.format(days, 'day')}`;
+  return `Last used ${dateFmt.format(d)}`;
+}
+
+function providerName(pk) {
+  if (pk.provider) return pk.provider;
+  if (pk.aaguid) return KNOWN_AAGUIDS[pk.aaguid.toLowerCase()] || null;
+  return null;
+}
+
+function h(tag, attrs = {}, ...children) {
+  const el = document.createElement(tag);
+  for (const [k, v] of Object.entries(attrs)) {
+    if (v === null || v === undefined || v === false) continue;
+    if (k === 'class') el.className = v;
+    else if (k === 'dataset') Object.assign(el.dataset, v);
+    else if (k === 'text') el.textContent = v;
+    else el.setAttribute(k, v === true ? '' : v);
+  }
+  for (const c of children) if (c != null) el.append(c);
+  return el;
+}
+
+function keyIcon() {
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  svg.setAttribute('viewBox', '0 0 24 24');
+  svg.setAttribute('width', '22');
+  svg.setAttribute('height', '22');
+  svg.setAttribute('aria-hidden', 'true');
+  svg.innerHTML =
+    '<path fill="currentColor" d="M7 14a2 2 0 1 1 0-4 2 2 0 0 1 0 4Zm5.65-4A6 6 0 1 0 12.65 14H17v4h4v-4h2v-4H12.65Z"/>';
+  return svg;
+}
+
+function render() {
+  els.container.setAttribute('aria-busy', 'false');
+  els.container.replaceChildren();
+
+  if (!state.passkeys.length) {
+    els.container.append(h('p', { class: 'empty', text: 'You don’t have any passkeys registered yet.' }));
+    return;
+  }
+
+  const list = h('ul', { class: 'passkey-list', 'aria-label': 'Registered passkeys' });
+  for (const pk of state.passkeys) list.append(renderPasskey(pk));
+  els.container.append(list);
+}
+
+function renderPasskey(pk) {
+  const li = h('li', { class: 'passkey', dataset: { id: pk.id } });
+  const provider = providerName(pk);
+
+  const meta = h('div', { class: 'passkey-meta' },
+    provider ? h('span', { text: provider }) : null,
+    h('span', { text: `Added ${formatDate(pk.createdAt)}` }),
+    h('span', { text: formatRelative(pk.lastUsedAt) }),
+    pk.backedUp === true ? h('span', { text: 'Synced' }) : null,
+  );
+
+  let body;
+  if (editingId === pk.id) {
+    body = renderRenameForm(pk);
+  } else {
+    const nameEl = h('div', { class: 'passkey-name' }, pk.name || 'Unnamed passkey');
+    if (pk.current) nameEl.append(h('span', { class: 'badge', text: 'This session' }));
+    body = h('div', {}, nameEl, meta);
+  }
+
+  const actions = h('div', { class: 'passkey-actions' });
+  if (editingId !== pk.id) {
+    actions.append(
+      h('button', {
+        type: 'button', class: 'btn btn-ghost', dataset: { action: 'rename' },
+        'aria-label': `Rename ${pk.name || 'passkey'}`, text: 'Rename',
+      }),
+      h('button', {
+        type: 'button', class: 'btn btn-ghost btn-danger', dataset: { action: 'delete' },
+        'aria-label': `Delete ${pk.name || 'passkey'}`, text: 'Delete',
+      }),
+    );
+  }
+
+  li.append(h('div', { class: 'passkey-icon' }, keyIcon()), body, actions);
+  return li;
+}
+
+function renderRenameForm(pk) {
+  const inputId = `rename-${cssSafe(pk.id)}`;
+  const input = h('input', {
+    id: inputId, type: 'text', name: 'name', value: pk.name || '', required: true,
+    maxlength: String(MAX_NAME_LENGTH), autocomplete: 'off', spellcheck: 'false',
+  });
+  return h('form', { class: 'rename-form', dataset: { action: 'rename-form' }, novalidate: true },
+    h('label', { for: inputId, class: 'visually-hidden', text: 'Passkey name' }),
+    input,
+    h('button', { type: 'submit', class: 'btn', text: 'Save' }),
+    h('button', { type: 'button', class: 'btn btn-ghost', dataset: { action: 'cancel-rename' }, text: 'Cancel' }),
+  );
+}
+
+function cssSafe(id) {
+  return String(id).replace(/[^a-zA-Z0-9_-]/g, '_');
+}
+
+function rowFor(id) {
+  return [...els.container.querySelectorAll('.passkey')].find((li) => li.dataset.id === id) || null;
+}
+
+function setStatus(message, kind = '') {
+  els.status.textContent = message;
+  els.status.className = `status ${kind}`.trim();
+}
+
+function setRowBusy(id, busy) {
+  const row = rowFor(id);
+  if (!row) return;
+  row.querySelectorAll('button, input').forEach((el) => { el.disabled = busy; });
+  row.setAttribute('aria-busy', String(busy));
+}
+
+/* -------------------------------------------------------------- Actions */
+
+function startRename(id) {
+  editingId = id;
+  render();
+  const input = rowFor(id)?.querySelector('input');
+  if (input) {
+    input.focus();
+    input.select();
+  }
+}
+
+function cancelRename() {
+  const id = editingId;
+  editingId = null;
+  render();
+  rowFor(id)?.querySelector('[data-action="rename"]')?.focus();
+}
+
+async function submitRename(id, rawName) {
+  const name = rawName.trim().replace(/\s+/g, ' ');
+  const pk = state.passkeys.find((p) => p.id === id);
+  if (!pk) return;
+
+  if (!name) {
+    setStatus('Please enter a name for this passkey.', 'error');
+    rowFor(id)?.querySelector('input')?.focus();
+    return;
+  }
+  if (name.length > MAX_NAME_LENGTH) {
+    setStatus(`Passkey names can be at most ${MAX_NAME_LENGTH} characters.`, 'error');
+    return;
+  }
+  if (name === pk.name) {
+    cancelRename();
+    return;
+  }
+
+  setRowBusy(id, true);
+  setStatus('Saving…');
+  try {
+    const updated = await api.rename(id, name);
+    Object.assign(pk, updated && typeof updated === 'object' ? updated : { name });
+    editingId = null;
+    render();
+    setStatus(`Passkey renamed to “${pk.name}”.`, 'success');
+    rowFor(id)?.querySelector('[data-action="rename"]')?.focus();
+  } catch (err) {
+    setRowBusy(id, false);
+    setStatus(`Couldn’t rename passkey: ${err.message}`, 'error');
+  }
+}
+
+function confirmDelete(pk) {
+  els.deleteName.textContent = pk.name || 'this passkey';
+  els.deleteLastWarning.hidden = state.passkeys.length > 1;
+  els.dialog.returnValue = '';
+
+  if (typeof els.dialog.showModal !== 'function') {
+    return Promise.resolve(window.confirm(`Delete passkey "${pk.name || 'this passkey'}"?`));
+  }
+  return new Promise((resolve) => {
+    els.dialog.addEventListener('close', () => resolve(els.dialog.returnValue === 'confirm'), { once: true });
+    els.dialog.showModal();
+  });
+}
+
+async function deletePasskey(id) {
+  const index = state.passkeys.findIndex((p) => p.id === id);
+  if (index === -1) return;
+  const pk = state.passkeys[index];
+
+  if (!(await confirmDelete(pk))) {
+    rowFor(id)?.querySelector('[data-action="delete"]')?.focus();
+    return;
+  }
+
+  setRowBusy(id, true);
+  setStatus('Deleting…');
+  try {
+    await api.remove(id);
+  } catch (err) {
+    if (err.status === 404) {
+      // Already gone on the server (e.g. deleted from another tab) — treat as success.
+    } else {
+      setRowBusy(id, false);
+      setStatus(`Couldn’t delete passkey: ${err.message}`, 'error');
+      return;
+    }
+  }
+
+  state.passkeys = state.passkeys.filter((p) => p.id !== id);
+  if (editingId === id) editingId = null;
+  render();
+
+  const synced = await syncDeletionWithAuthenticator(id);
+  let message = `Deleted “${pk.name || 'passkey'}”.`;
+  if (synced) message += ' It has also been removed from your browser’s passkey list.';
+  else if (!isDemo) message += ' You may also want to remove it from your device’s password manager.';
+  setStatus(message, 'success');
+
+  // Move focus to a sensible place now that the row is gone.
+  const next = state.passkeys[Math.min(index, state.passkeys.length - 1)];
+  const target = next ? rowFor(next.id)?.querySelector('[data-action="rename"]') : null;
+  if (target) target.focus();
+  else {
+    els.heading.setAttribute('tabindex', '-1');
+    els.heading.focus();
+  }
+}
+
+/* --------------------------------------------------------------- Events */
+
+els.container.addEventListener('click', (e) => {
+  const btn = e.target.closest('button[data-action]');
+  if (!btn || btn.disabled) return;
+  const id = btn.closest('.passkey')?.dataset.id;
+  if (!id) return;
+
+  switch (btn.dataset.action) {
+    case 'rename': startRename(id); break;
+    case 'cancel-rename': cancelRename(); break;
+    case 'delete': deletePasskey(id); break;
+  }
+});
+
+els.container.addEventListener('submit', (e) => {
+  const form = e.target.closest('form[data-action="rename-form"]');
+  if (!form) return;
+  e.preventDefault();
+  const id = form.closest('.passkey')?.dataset.id;
+  if (id) submitRename(id, form.elements.name.value);
+});
+
+els.container.addEventListener('keydown', (e) => {
+  if (e.key === 'Escape' && e.target.matches('.rename-form input')) {
+    e.preventDefault();
+    cancelRename();
+  }
+});
+
+/* ----------------------------------------------------------------- Init */
+
+async function init() {
+  renderSyncNote();
+  try {
+    const data = await api.list();
+    if (!data || !Array.isArray(data.passkeys)) throw new ApiError('Unexpected response from server.', 0);
+    state = {
+      rpId: data.rpId || location.hostname,
+      user: data.user || null,
+      passkeys: data.passkeys,
+    };
+  } catch (err) {
+    if (err.status === 401) return; // redirecting to login
+    els.container.setAttribute('aria-busy', 'false');
+    els.container.replaceChildren(
+      h('div', { class: 'error-state' },
+        h('p', { text: `We couldn’t load your passkeys. ${err.message}` }),
+        h('button', { type: 'button', class: 'btn', id: 'retry', text: 'Try again' })),
+    );
+    document.getElementById('retry').addEventListener('click', () => {
+      els.container.setAttribute('aria-busy', 'true');
+      els.container.replaceChildren(h('p', { class: 'loading', text: 'Loading your passkeys…' }));
+      init();
+    }, { once: true });
+    return;
+  }
+
+  if (state.user?.displayName) {
+    els.greeting.textContent = `Welcome back, ${state.user.displayName}. Manage your profile, orders, and sign-in security.`;
+  }
+
+  render();
+
+  // Reconcile the authenticator with the server's list on every visit, so passkeys removed
+  // elsewhere (another device, support desk, etc.) also disappear from this browser.
+  syncAllWithAuthenticator();
+}
+
+init();
