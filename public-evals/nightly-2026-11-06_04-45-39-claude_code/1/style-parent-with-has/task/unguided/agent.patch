diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -151,8 +151,76 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Contact Form */
+    .contact {
+      max-width: 600px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    .contact h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .contact form {
+      background: white;
+      padding: 24px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .form-field {
+      border: 2px solid transparent;
+      border-radius: 6px;
+      padding: 8px;
+      margin-bottom: 12px;
+      transition: border-color 0.2s;
+    }
+
+    .form-field label {
+      display: block;
+      font-weight: 600;
+      margin-bottom: 4px;
+      color: var(--primary);
+    }
+
+    .form-field input,
+    .form-field textarea {
+      width: 100%;
+      padding: 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 4px;
+      font: inherit;
+      color: var(--text);
+    }
+
+    .form-field textarea {
+      resize: vertical;
+      min-height: 120px;
+    }
+
+    .form-field input:focus,
+    .form-field textarea:focus {
+      outline: none;
+      border-color: var(--accent);
+    }
+
+    /* Red border on the wrapping div when its input is invalid.
+       :user-invalid only matches after the user has interacted with the
+       field (or tried to submit), so the form doesn't start out red. */
+    .form-field:has(:user-invalid) {
+      border-color: #d32f2f;
+    }
+
+    .contact .btn {
+      border: none;
+      cursor: pointer;
+      font: inherit;
+      margin-top: 4px;
+    }
   </style>
 </head>
 
