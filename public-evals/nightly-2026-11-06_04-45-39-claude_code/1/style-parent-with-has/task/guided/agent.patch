diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -134,8 +134,93 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Contact Form */
+    .contact {
+      max-width: 600px;
+      margin: 40px auto 0;
+      padding: 0 20px;
+    }
+
+    .contact h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .contact-form {
+      display: grid;
+      gap: 16px;
+      background: white;
+      padding: 24px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .form-field {
+      display: grid;
+      gap: 6px;
+      padding: 12px;
+      border: 2px solid transparent;
+      border-radius: 6px;
+      transition: border-color 0.2s, background-color 0.2s;
+    }
+
+    .form-field label {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .form-field .required {
+      color: #c62828;
+    }
+
+    .form-field input,
+    .form-field textarea {
+      font: inherit;
+      color: inherit;
+      padding: 10px 12px;
+      border: 1px solid var(--secondary);
+      border-radius: 4px;
+      background: var(--light);
+    }
+
+    .form-field textarea {
+      resize: vertical;
+      min-height: 120px;
+    }
+
+    .form-field input:focus-visible,
+    .form-field textarea:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 1px;
+    }
+
+    .error-msg {
+      display: none;
+      color: #c62828;
+      font-size: 0.875rem;
+    }
+
+    /* Red border on the whole wrapper once the user has interacted with an invalid field
+       (blurred after editing, or attempted to submit). */
+    .form-field:has(:user-invalid) {
+      border-color: #c62828;
+      background-color: #fff5f5;
+    }
+
+    .form-field:has(:user-invalid) .error-msg {
+      display: block;
+    }
+
+    .contact-form .btn {
+      justify-self: start;
+      border: none;
+      font: inherit;
+      cursor: pointer;
+      margin-top: 0;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
@@ -196,8 +281,42 @@
       </div>
     </section>
   </main>
 
