+    /* ===== Icon system =====
+     * Usage: <span class="icon icon--menu" aria-hidden="true"></span>
+     * - Assign an icon:  .icon--name { --icon: var(--icon-name); }
+     *   or override on any element: .my-thing .icon { --icon: var(--icon-rewards); }
+     * - Size:   --icon-size (defaults to 1.25em, scales with surrounding text)
+     * - Color:  inherits currentColor; override with --icon-color
+     * Icons are decorative (aria-hidden) because every control carries a
+     * visible text label; meaningful standalone icons should instead get
+     * role="img" plus an aria-label.
+     */
+    .icon {
+      --icon-size: 1.25em;
+      display: inline-block;
+      flex-shrink: 0;
+      width: var(--icon-size);
+      height: var(--icon-size);
+      vertical-align: -0.2em;
+      background-color: var(--icon-color, currentColor);
+      -webkit-mask: var(--icon) center / contain no-repeat;
+      mask: var(--icon) center / contain no-repeat;
+    }
+
+    .icon--logo { --icon: var(--icon-logo); }
+    .icon--menu { --icon: var(--icon-menu); }
+    .icon--location { --icon: var(--icon-location); }
+    .icon--rewards { --icon: var(--icon-rewards); }
+    .icon--account { --icon: var(--icon-account); }
+    .icon--logout { --icon: var(--icon-logout); }
+    .icon--bag { --icon: var(--icon-bag); }
+    .icon--arrow-right { --icon: var(--icon-arrow-right); }
+    .icon--latte { --icon: var(--icon-latte); }
+    .icon--espresso { --icon: var(--icon-espresso); }
+    .icon--cold-brew { --icon: var(--icon-cold-brew); }
+
+    /* Keep icons visible in Windows High Contrast / forced-colors mode,
+       where background colors would otherwise be overridden. */
+    @media (forced-colors: active) {
+      .icon {
+        forced-color-adjust: none;
+        background-color: currentColor;
+      }
+    }
+
+    .visually-hidden {
+      position: absolute !important;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0, 0, 0, 0);
+      white-space: nowrap;
+      border: 0;
+    }
+
