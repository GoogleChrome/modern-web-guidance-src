+    /* Rewards trigger + popover */
+    .nav-button {
+      font: inherit;
+      font-size: 0.9rem;
+      color: white;
+      background: none;
+      border: 0;
+      padding: 0;
+      cursor: pointer;
+      transition: color 0.3s;
+    }
+
+    .nav-button:hover,
+    .nav-button[aria-expanded="true"] {
+      color: var(--accent);
+    }
+
+    .nav-button:focus-visible,
+    .rewards-card :focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .rewards-card {
+      width: min(320px, calc(100vw - 2rem));
+      padding: 0;
+      border: 0;
+      border-radius: 12px;
+      background: white;
+      color: var(--text);
+      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
+      overflow: hidden;
+    }
+
+    .rewards-card::backdrop {
+      background: transparent;
+    }
+
+    /* Polyfill can't define :popover-open, so pair it with its class fallback. */
+    .rewards-card:is(:popover-open, .\:popover-open) {
+      display: block;
+    }
+
+    .rewards-card img {
+      display: block;
+      width: 100%;
+      height: 120px;
+      object-fit: cover;
+    }
+
+    .rewards-body {
+      padding: 16px 20px 20px;
+    }
+
+    .rewards-body h2 {
+      font-size: 1.1rem;
+      color: var(--primary);
+    }
+
+    .rewards-points {
+      font-size: 2rem;
+      font-weight: bold;
+      color: var(--primary);
+      line-height: 1.2;
+      margin-top: 4px;
+    }
+
+    .rewards-points span {
+      font-size: 0.9rem;
+      font-weight: normal;
+    }
+
+    .rewards-card progress {
+      width: 100%;
+      height: 10px;
+      margin: 10px 0 6px;
+      accent-color: var(--accent);
+    }
+
+    .rewards-card ul {
+      margin: 12px 0 0 1.1rem;
+      font-size: 0.85rem;
+    }
+
+    .rewards-small {
+      font-size: 0.85rem;
+    }
+
+    .rewards-actions {
+      display: flex;
+      gap: 10px;
+      align-items: center;
+      justify-content: space-between;
+      margin-top: 14px;
+    }
+
+    .rewards-actions .btn {
+      margin-top: 0;
+    }
+
+    .link-button {
+      font: inherit;
+      font-size: 0.85rem;
+      background: none;
+      border: 0;
+      color: var(--primary);
+      text-decoration: underline;
+      cursor: pointer;
+    }
+
+    /* Tether to the trigger where anchor positioning exists; otherwise keep
+       the default centered popover placement. */
+    @supports (position-area: block-end) {
+      .rewards-card {
+        inset: auto;
+        margin: 8px 0 0;
+        position-area: block-end span-inline-start;
+        position-try-fallbacks: flip-inline, flip-block, flip-block flip-inline;
+      }
+    }
