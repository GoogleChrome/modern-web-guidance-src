+  <script>
+    (() => {
+      const form = document.getElementById('signup-form');
+      const password = document.getElementById('new-password');
+      const toggle = document.getElementById('toggle-password');
+
+      // Show / hide password
+      toggle.addEventListener('click', () => {
+        const show = password.type === 'password';
+        password.type = show ? 'text' : 'password';
+        toggle.textContent = show ? 'Hide' : 'Show';
+        toggle.setAttribute('aria-pressed', String(show));
+      });
+
+      // Keep aria-invalid in sync with the :user-invalid visual state
+      const syncAria = (el) => {
+        if (!(el instanceof HTMLInputElement) || !el.form) return;
+        el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+      };
+      form.addEventListener('blur', (e) => syncAria(e.target), true);
+      form.addEventListener('input', (e) => {
+        if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+      });
+      form.addEventListener('invalid', (e) => {
+        // Fires on submit attempts; defer so :user-invalid has been applied
+        requestAnimationFrame(() => syncAria(e.target));
+      }, true);
+
+      // Prevent double submissions once the form is valid
+      const submitBtn = form.querySelector('button[type="submit"]');
+      form.addEventListener('submit', () => {
+        submitBtn.disabled = true;
+      });
+      // Re-enable if the page is restored from the back/forward cache
+      window.addEventListener('pageshow', () => {
+        submitBtn.disabled = false;
+      });
+    })();
+  </script>
+
