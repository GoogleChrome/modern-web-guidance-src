+  <script>
+    (function () {
+      const form = document.getElementById('signup-form');
+      const password = form.querySelector('#password');
+      const confirm = form.querySelector('#confirm-password');
+
+      function errorEl(input) {
+        return input.closest('.form-group').querySelector('.form-error');
+      }
+
+      function validate(input) {
+        let message = '';
+        if (input.type === 'checkbox') {
+          if (input.required && !input.checked) message = 'You must accept the terms to continue.';
+        } else if (input.validity.valueMissing) {
+          message = 'This field is required.';
+        } else if (input.validity.typeMismatch) {
+          message = 'Please enter a valid email address.';
+        } else if (input.validity.tooShort) {
+          message = 'Password must be at least 8 characters.';
+        } else if (input === confirm && confirm.value !== password.value) {
+          message = 'Passwords do not match.';
+        }
+        input.classList.toggle('invalid', !!message);
+        input.setAttribute('aria-invalid', message ? 'true' : 'false');
+        errorEl(input).textContent = message;
+        return !message;
+      }
+
+      const fields = form.querySelectorAll('input[required]');
+
+      fields.forEach(function (input) {
+        input.addEventListener(input.type === 'checkbox' ? 'change' : 'blur', function () {
+          validate(input);
+        });
+      });
+
+      password.addEventListener('input', function () {
+        if (confirm.value) validate(confirm);
+      });
+
+      form.addEventListener('submit', function (e) {
+        let firstInvalid = null;
+        fields.forEach(function (input) {
+          if (!validate(input) && !firstInvalid) firstInvalid = input;
+        });
+        if (firstInvalid) {
+          e.preventDefault();
+          firstInvalid.focus();
+        }
+      });
+    })();
+  </script>
+
