+  <script>
+    (() => {
+      const bar = document.getElementById('favorites-actions');
+      const grid = document.getElementById('favorites-grid');
+      const status = document.getElementById('favorites-status');
+      const filters = document.getElementById('favorites-filters');
+      const cards = [...grid.querySelectorAll('.card')];
+      const viewButtons = [...bar.querySelectorAll('[data-view]')];
+      const detailsBtn = document.getElementById('toggle-details');
+      const filtersBtn = document.getElementById('toggle-filters');
+      const copyBtn = document.getElementById('copy-favorites');
+
+      let lastMessage = '';
+      let statusTimer;
+      const announce = (text) => {
+        // VoiceOver skips repeated identical messages; a no-break space makes it differ
+        let message = text === lastMessage ? text + '\u00A0' : text;
+        lastMessage = message;
+        clearTimeout(statusTimer);
+        status.textContent = '';
+        requestAnimationFrame(() => (status.textContent = message));
+        statusTimer = setTimeout(() => (status.textContent = ''), 3000);
+      };
+
+      // Layout: mutually exclusive grid / list
+      viewButtons.forEach((btn) => btn.addEventListener('click', () => {
+        viewButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
+        grid.classList.toggle('list-view', btn.dataset.view === 'list');
+      }));
+
+      // Toggle helpers: label stays the same; state lives in aria-pressed
+      const toggle = (btn) => {
+        const on = btn.getAttribute('aria-pressed') !== 'true';
+        btn.setAttribute('aria-pressed', String(on));
+        return on;
+      };
+
+      detailsBtn.addEventListener('click', () => {
+        grid.classList.toggle('hide-details', !toggle(detailsBtn));
+      });
+
+      filtersBtn.addEventListener('click', () => {
+        filters.hidden = !toggle(filtersBtn);
+      });
+
+      const applyFilters = () => {
+        const allowed = new Set(
+          [...filters.querySelectorAll('input:checked')].map((i) => i.value)
+        );
+        cards.forEach((card) => (card.hidden = !allowed.has(card.dataset.temp)));
+        const shown = cards.filter((c) => !c.hidden).length;
+        announce(`Showing ${shown} of ${cards.length} drinks`);
+      };
+      filters.addEventListener('change', applyFilters);
+
+      // Copy: an action, so no aria-pressed; report outcome via the live region
+      let copyTimer;
+      copyBtn.addEventListener('click', async () => {
+        const text = cards
+          .filter((c) => !c.hidden)
+          .map((c) => {
+            const name = c.querySelector('h3').textContent.trim();
+            const desc = c.querySelector('p')?.textContent.trim();
+            return `• ${name}${desc ? ` — ${desc}` : ''}`;
+          })
+          .join('\n');
+        if (!text) {
+          announce('No drinks to copy');
+          return;
+        }
+        clearTimeout(copyTimer);
+        copyBtn.removeAttribute('data-copied');
+        copyBtn.removeAttribute('data-failed');
+        let ok = true;
+        try {
+          await navigator.clipboard.writeText(`The Daily Grind — Seasonal Favorites\n${text}`);
+        } catch {
+          ok = false;
+        }
+        copyBtn.setAttribute(ok ? 'data-copied' : 'data-failed', '');
+        announce(ok ? 'Featured drinks list copied' : 'Copy failed');
+        copyTimer = setTimeout(() => {
+          copyBtn.removeAttribute('data-copied');
+          copyBtn.removeAttribute('data-failed');
+        }, 2000);
+      });
+
+      // Roving tabindex fallback, only where native focusgroup is unavailable
+      if (!('focusGroup' in HTMLElement.prototype)) {
+        const items = [...bar.querySelectorAll('button')];
+        items.forEach((b, i) => (b.tabIndex = i ? -1 : 0));
+        bar.addEventListener('focusin', ({ target }) => {
+          if (items.includes(target)) items.forEach((b) => (b.tabIndex = b === target ? 0 : -1));
+        });
+        bar.addEventListener('keydown', (event) => {
+          const rtl = getComputedStyle(bar).direction === 'rtl';
+          const steps = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 };
+          const current = items.indexOf(document.activeElement);
+          if (current === -1) return;
+          let next;
+          if (event.key in steps) next = (current + steps[event.key] + items.length) % items.length;
+          else if (event.key === 'Home') next = 0;
+          else if (event.key === 'End') next = items.length - 1;
+          else return;
+          event.preventDefault();
+          items[next].focus();
+        });
+      }
+    })();
+  </script>
+
