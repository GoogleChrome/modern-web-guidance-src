+  <script>
+    (function () {
+      var toolbar = document.getElementById('favorites-actions');
+      var list = document.getElementById('favorites-list');
+      var status = document.getElementById('favorites-status');
+      if (!toolbar || !list) return;
+
+      var buttons = Array.prototype.slice.call(toolbar.querySelectorAll('.icon-btn'));
+      var statusTimer;
+
+      function announce(msg) {
+        status.textContent = msg;
+        clearTimeout(statusTimer);
+        statusTimer = setTimeout(function () { status.textContent = ''; }, 2500);
+      }
+
+      function setLayout(layout) {
+        var isList = layout === 'list';
+        list.classList.toggle('list-view', isList);
+        toolbar.querySelector('[data-action="grid"]').setAttribute('aria-pressed', String(!isList));
+        toolbar.querySelector('[data-action="list"]').setAttribute('aria-pressed', String(isList));
+        announce(isList ? 'Showing list view' : 'Showing grid view');
+      }
+
+      function toggleDetails(btn) {
+        var show = btn.getAttribute('aria-pressed') !== 'true';
+        btn.setAttribute('aria-pressed', String(show));
+        list.classList.toggle('details-hidden', !show);
+        announce(show ? 'Drink details shown' : 'Drink details hidden');
+      }
+
+      function getDrinksText() {
+        return Array.prototype.map.call(list.querySelectorAll('.card'), function (card) {
+          var name = card.querySelector('h3').textContent.trim();
+          var desc = card.querySelector('p');
+          return '• ' + name + (desc ? ' — ' + desc.textContent.trim() : '');
+        }).join('\n');
+      }
+
+      function fallbackCopy(text) {
+        var ta = document.createElement('textarea');
+        ta.value = text;
+        ta.setAttribute('readonly', '');
+        ta.style.position = 'fixed';
+        ta.style.opacity = '0';
+        document.body.appendChild(ta);
+        ta.select();
+        var ok = false;
+        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
+        document.body.removeChild(ta);
+        return ok ? Promise.resolve() : Promise.reject(new Error('copy failed'));
+      }
+
+      function copyDrinks(btn) {
+        var text = 'Seasonal Favorites at The Daily Grind\n' + getDrinksText();
+        var p = (navigator.clipboard && window.isSecureContext)
+          ? navigator.clipboard.writeText(text).catch(function () { return fallbackCopy(text); })
+          : fallbackCopy(text);
+        p.then(function () {
+          btn.classList.add('is-copied');
+          btn.setAttribute('data-tooltip', 'Copied!');
+          announce('Featured drinks copied to clipboard');
+          setTimeout(function () {
+            btn.classList.remove('is-copied');
+            btn.setAttribute('data-tooltip', 'Copy featured drinks');
+          }, 2000);
+        }, function () {
+          announce('Unable to copy. Please try again.');
+        });
+      }
+
+      toolbar.addEventListener('click', function (e) {
+        var btn = e.target.closest('.icon-btn');
+        if (!btn) return;
+        setActive(btn);
+        switch (btn.dataset.action) {
+          case 'grid': setLayout('grid'); break;
+          case 'list': setLayout('list'); break;
+          case 'details': toggleDetails(btn); break;
+          case 'copy': copyDrinks(btn); break;
+        }
+      });
+
+      // Roving tabindex + arrow-key navigation (WAI-ARIA toolbar pattern)
+      function setActive(btn) {
+        buttons.forEach(function (b) { b.tabIndex = b === btn ? 0 : -1; });
+      }
+
+      toolbar.addEventListener('keydown', function (e) {
+        var i = buttons.indexOf(document.activeElement);
+        if (i === -1) return;
+        var next = null;
+        switch (e.key) {
+          case 'ArrowRight': case 'ArrowDown': next = buttons[(i + 1) % buttons.length]; break;
+          case 'ArrowLeft': case 'ArrowUp': next = buttons[(i - 1 + buttons.length) % buttons.length]; break;
+          case 'Home': next = buttons[0]; break;
+          case 'End': next = buttons[buttons.length - 1]; break;
+          default: return;
+        }
+        e.preventDefault();
+        setActive(next);
+        next.focus();
+      });
+    })();
+  </script>
+
