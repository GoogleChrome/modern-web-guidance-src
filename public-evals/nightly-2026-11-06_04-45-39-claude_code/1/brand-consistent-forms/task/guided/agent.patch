+  <script>
+    (() => {
+      const form = document.getElementById('subscription-form');
+      const progress = document.getElementById('setup-progress');
+      const status = document.getElementById('setup-progress-status');
+      const confirmation = document.getElementById('subscribe-confirmation');
+      const nameInput = document.getElementById('sub-name');
+      const emailInput = document.getElementById('sub-email');
+      const roast = document.getElementById('roast-level');
+      const roastDisplay = document.getElementById('roast-level-display');
+      const roastLabels = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      let roastChosen = false;
+
+      function syncRoast() {
+        const label = roastLabels[roast.value - roast.min];
+        roast.setAttribute('aria-valuetext', label);
+        roastDisplay.textContent = label;
+        // Drives the filled portion of the track in WebKit/Blink.
+        roast.style.setProperty('--attr-min', roast.min || 0);
+        roast.style.setProperty('--attr-max', roast.max || 100);
+        roast.style.setProperty('--control-value', roast.value);
+      }
+
+      function updateProgress() {
+        const steps = [
+          nameInput.value.trim() !== '',
+          emailInput.value !== '' && emailInput.checkValidity(),
+          form.querySelector('input[name="frequency"]:checked') !== null,
+          roastChosen,
+        ];
+        const done = steps.filter(Boolean).length;
+        const text = `${done} of ${steps.length} steps complete`;
+        progress.max = steps.length;
+        progress.value = done;
+        progress.textContent = text;
+        if (status.textContent !== text) status.textContent = text;
+      }
+
+      roast.addEventListener('input', () => {
+        roastChosen = true;
+        syncRoast();
+      });
+
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        roastChosen = true;
+        updateProgress();
+        const frequency = form.elements.frequency.value;
+        const roastLabel = roastLabels[roast.value - roast.min].toLowerCase();
+        confirmation.textContent =
+          `Thanks, ${nameInput.value.trim()}! Your ${roastLabel} roast will ship ${frequency}.`;
+      });
+
+      syncRoast();
+      updateProgress();
+    })();
+  </script>
+
 </body>
 
