+  <script>
+    (function () {
+      const form = document.getElementById('subscription-form');
+      const progress = document.getElementById('sub-progress');
+      const progressText = document.getElementById('sub-progress-text');
+      const roast = document.getElementById('sub-roast');
+      const roastOutput = document.getElementById('sub-roast-output');
+      const status = document.getElementById('sub-status');
+      const roastLabels = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      let roastTouched = false;
+
+      const steps = [
+        () => form.elements.name.value.trim() !== '',
+        () => form.elements.email.validity.valid && form.elements.email.value !== '',
+        () => form.elements.frequency.value !== '',
+        () => roastTouched,
+        () => form.elements.grind.value !== '',
+      ];
+
+      function updateRoast() {
+        const label = roastLabels[roast.value - 1];
+        roastOutput.value = label;
+        roast.setAttribute('aria-valuetext', label);
+        const pct = ((roast.value - roast.min) / (roast.max - roast.min)) * 100;
+        roast.style.setProperty('--fill', pct + '%');
+      }
+
+      function updateProgress() {
+        const done = steps.filter((check) => check()).length;
+        const pct = Math.round((done / steps.length) * 100);
+        progress.value = pct;
+        progress.textContent = pct + '%';
+        progress.setAttribute('aria-valuetext', `${pct}% complete, ${done} of ${steps.length} steps`);
+        progressText.textContent = pct + '%';
+      }
+
+      roast.addEventListener('input', () => {
+        roastTouched = true;
+        updateRoast();
+      });
+
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        roastTouched = true;
+        updateProgress();
+        if (!form.checkValidity()) {
+          const firstInvalid = form.querySelector(':invalid');
+          status.textContent = 'Please complete all required fields before subscribing.';
+          if (firstInvalid) firstInvalid.focus();
+          return;
+        }
+        status.textContent = `Thanks, ${form.elements.name.value.trim()}! Your ${roastLabels[roast.value - 1].toLowerCase()} roast subscription is set up.`;
+      });
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
+
