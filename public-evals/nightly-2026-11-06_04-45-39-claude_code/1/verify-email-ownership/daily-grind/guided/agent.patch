diff --git a/server.js b/server.js
new file mode 100644
index 0000000..e9a8658
--- /dev/null
+++ b/server.js
@@ -0,0 +1,344 @@
+// The Daily Grind web server.
+//
+//   GET  /                     Homepage with the Rewards sign-up form. Each render
+//                              gets a fresh EVP nonce stored in server-side session state.
+//   POST /api/rewards/signup   Creates the rewards account. If the browser attached
+//                              a valid Email Verification Token, the email counts as
+//                              verified right away. If not, it falls back to a
+//                              verification email.
+//
+// Configuration (environment variables):
+//   PORT                 Port to listen on (default 11222)
+//   PUBLIC_ORIGIN        Public origin of the site, used as the KB-JWT audience
+//                        (default http://localhost:$PORT). Must match the browser's origin exactly.
+//   ORIGIN_TRIAL_TOKEN   Chrome Origin Trial token for the Email Verification API (optional)
+
+import http from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { randomBytes, scrypt as scryptCb, timingSafeEqual } from 'node:crypto';
+import { promisify } from 'node:util';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+import { verifyEmailVerificationToken } from './lib/email-verification.js';
+
+const scrypt = promisify(scryptCb);
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT) || 11222;
+const PUBLIC_ORIGIN = (process.env.PUBLIC_ORIGIN || `http://localhost:${PORT}`).replace(/\/+$/, '');
+const ORIGIN_TRIAL_TOKEN = process.env.ORIGIN_TRIAL_TOKEN || '';
+
+const SESSION_COOKIE = 'dg_sid';
+const SESSION_TTL_MS = 2 * 60 * 60 * 1000;
+const NONCE_TTL_MS = 15 * 60 * 1000;
+const MAX_FORMS_PER_SESSION = 10;
+const MAX_BODY_BYTES = 32 * 1024;
+
+// ---------------------------------------------------------------------------
+// Server-side session state (in memory for this demo; use Redis or a DB in production).
+// sid -> { expires, forms: Map<formId, { nonce, expires }> }
+// formId is posted back with the form, so we can find the nonce rendered into
+// that exact page (this works with several tabs open). It is also the CSRF token.
+// The nonce itself only goes into the hidden token input's `nonce` attribute.
+// ---------------------------------------------------------------------------
+const sessions = new Map();
+
+function getOrCreateSession(req, res) {
+  const sid = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+  const existing = sid && sessions.get(sid);
+  if (existing && existing.expires > Date.now()) {
+    existing.expires = Date.now() + SESSION_TTL_MS;
+    return existing;
+  }
+  const newSid = randomBytes(32).toString('base64url');
+  const session = { expires: Date.now() + SESSION_TTL_MS, forms: new Map() };
+  sessions.set(newSid, session);
+  res.setHeader(
+    'Set-Cookie',
+    `${SESSION_COOKIE}=${newSid}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=${SESSION_TTL_MS / 1000}`,
+  );
+  return session;
+}
+
+function issueFormNonce(session) {
+  const formId = randomBytes(16).toString('base64url');
+  const nonce = randomBytes(32).toString('base64url'); // 256 bits of entropy
+  session.forms.set(formId, { nonce, expires: Date.now() + NONCE_TTL_MS });
+  // Limit how many outstanding nonces one session can hold.
+  while (session.forms.size > MAX_FORMS_PER_SESSION) {
+    session.forms.delete(session.forms.keys().next().value);
+  }
+  return { formId, nonce };
+}
+
+// Read and delete the nonce in one step (Node runs this synchronously,
+// so no other request can run in between). A nonce can only be used once.
+function consumeFormNonce(req, formId) {
+  const sid = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+  const session = sid && sessions.get(sid);
+  if (!session || session.expires <= Date.now() || typeof formId !== 'string') return null;
+  const entry = session.forms.get(formId);
+  if (!entry) return null;
+  session.forms.delete(formId);
+  return entry.expires > Date.now() ? entry.nonce : null;
+}
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [sid, s] of sessions) {
+    if (s.expires <= now) sessions.delete(sid);
+    else for (const [id, f] of s.forms) if (f.expires <= now) s.forms.delete(id);
+  }
+}, 60_000).unref();
+
+// ---------------------------------------------------------------------------
+// Rewards accounts (in memory for this demo).
+// ---------------------------------------------------------------------------
+const accounts = new Map(); // lowercased email -> account
+
+async function hashPassword(password) {
+  const salt = randomBytes(16);
+  const key = await scrypt(password.normalize('NFKC'), salt, 64);
+  return `scrypt$${salt.toString('base64url')}$${key.toString('base64url')}`;
+}
+
+function createAccount({ name, email, passwordHash, emailVerified, verificationMethod }) {
+  const account = {
+    id: randomBytes(12).toString('base64url'),
+    name,
+    email,
+    passwordHash,
+    emailVerified,
+    verificationMethod,
+    points: 0,
+    createdAt: new Date().toISOString(),
+  };
+  accounts.set(email.toLowerCase(), account);
+  return account;
+}
+
+// Fallback path when EVP isn't available. Plug in your transactional email provider here.
+async function sendTraditionalVerificationEmail(email, { existingAccount }) {
+  const token = randomBytes(32).toString('base64url');
+  // TODO: store the token hash and send a real email. Until then, log it so the flow can be traced.
+  console.info(
+    `[email] To: ${email} — ${existingAccount ? 'account-exists notice' : `verify link ${PUBLIC_ORIGIN}/rewards/verify?token=${token}`}`,
+  );
+}
+
+// ---------------------------------------------------------------------------
+// Handlers
+// ---------------------------------------------------------------------------
+let indexTemplate;
+
+async function handleHomepage(req, res) {
+  indexTemplate ??= await readFile(path.join(ROOT, 'index.html'), 'utf8');
+  const session = getOrCreateSession(req, res);
+  const { formId, nonce } = issueFormNonce(session);
+
+  const html = indexTemplate
+    .replaceAll('{{EVT_NONCE}}', nonce)
+    .replaceAll('{{FORM_ID}}', formId);
+
+  const headers = {
+    'Content-Type': 'text/html; charset=utf-8',
+    // Stops back/forward navigation from reusing a nonce that was already consumed.
+    'Cache-Control': 'no-store',
+    ...securityHeaders(),
+  };
+  if (ORIGIN_TRIAL_TOKEN) headers['Origin-Trial'] = ORIGIN_TRIAL_TOKEN;
+  res.writeHead(200, headers);
+  res.end(req.method === 'HEAD' ? undefined : html);
+}
+
+async function handleSignup(req, res) {
+  // Only accept same-origin submissions (the SameSite=Lax cookie and the formId already cover CSRF; this is an extra check).
+  const origin = req.headers.origin;
+  if (origin && origin !== PUBLIC_ORIGIN) {
+    return sendResult(res, 403, 'Request blocked', 'This form must be submitted from The Daily Grind website.');
+  }
+
+  let form;
+  try {
+    form = await readUrlEncodedBody(req);
+  } catch (err) {
+    return sendResult(res, err.status || 400, 'Something went wrong', 'We could not read your sign-up details. Please try again.');
+  }
+
+  const name = String(form.get('name') || '').trim();
+  const email = String(form.get('email') || '').trim();
+  const password = String(form.get('password') || '');
+  const rawToken = String(form.get('email_verification_token') || '').trim();
+  const formId = String(form.get('form_id') || '');
+
+  // Read the nonce from the session and delete it before doing anything else, so this form can't be replayed.
+  const expectedNonce = consumeFormNonce(req, formId);
+  if (!expectedNonce) {
+    return sendResult(res, 400, 'Your session expired', 'Please reload the page and try signing up again.', true);
+  }
+
+  // Server-side validation (the browser's built-in validation only helps the user; it isn't a security check).
+  const errors = [];
+  if (!name || name.length > 100) errors.push('Enter your name (up to 100 characters).');
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || email.length > 254) errors.push('Enter a valid email address.');
+  if (password.length < 8 || password.length > 128) errors.push('Choose a password between 8 and 128 characters.');
+  if (errors.length) return sendResult(res, 422, 'Please check your details', errors.join(' '), true);
+
+  let evpVerified = false;
+  if (rawToken) {
+    try {
+      await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail: email,
+        expectedNonce,
+        expectedAudience: PUBLIC_ORIGIN,
+      });
+      evpVerified = true;
+    } catch (err) {
+      console.warn('Email verification token check failed; falling back to email link:', err.message);
+    }
+  }
+
+  const existing = accounts.get(email.toLowerCase());
+
+  if (evpVerified) {
+    // The user proved they own this email, so it's safe to say an account already exists.
+    if (existing) {
+      return sendResult(res, 409, 'You already have a Rewards account', `${email} is already registered. Sign in to see your points.`);
+    }
+    createAccount({
+      name,
+      email,
+      passwordHash: await hashPassword(password),
+      emailVerified: true,
+      verificationMethod: 'email-verification-protocol',
+    });
+    return sendResult(
+      res,
+      201,
+      `Welcome to Daily Grind Rewards, ${name}!`,
+      `Your email ${email} has been verified and your account is ready. Enjoy a free drink on your first visit.`,
+    );
+  }
+
+  // Fallback: unsupported browser, email provider not taking part, user not signed in to their provider, or a bad token.
+  // Show the same message whether or not the account exists, so the form can't be used to discover registered emails.
+  if (!existing) {
+    createAccount({
+      name,
+      email,
+      passwordHash: await hashPassword(password),
+      emailVerified: false,
+      verificationMethod: 'pending-email-link',
+    });
+  }
+  await sendTraditionalVerificationEmail(email, { existingAccount: Boolean(existing) });
+  return sendResult(
+    res,
+    202,
+    'Check your inbox',
+    `We sent a message to ${email}. Follow the link inside to finish setting up your Rewards account.`,
+  );
+}
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+function parseCookies(header = '') {
+  const out = {};
+  for (const part of header.split(';')) {
+    const i = part.indexOf('=');
+    if (i > 0) out[part.slice(0, i).trim()] = part.slice(i + 1).trim();
+  }
+  return out;
+}
+
+function readUrlEncodedBody(req) {
+  return new Promise((resolve, reject) => {
+    const type = (req.headers['content-type'] || '').split(';')[0].trim();
+    if (type !== 'application/x-www-form-urlencoded') {
+      return reject(Object.assign(new Error('Unsupported content type'), { status: 415 }));
+    }
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Body too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(new URLSearchParams(Buffer.concat(chunks).toString('utf8'))));
+    req.on('error', reject);
+  });
+}
+
+function escapeHtml(s) {
+  return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+}
+
+function securityHeaders() {
+  return {
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'X-Frame-Options': 'DENY',
+  };
+}
+
+function sendResult(res, status, title, message, offerRetry = false) {
+  const html = `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>${escapeHtml(title)} | The Daily Grind</title>
+  <style>
+    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #fafafa; color: #3e2723;
+           display: grid; place-items: center; min-height: 100vh; margin: 0; padding: 1rem; line-height: 1.6; }
+    main { background: white; max-width: 32rem; padding: 2rem; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,.1); }
+    h1 { color: #4e342e; margin-top: 0; }
+    a { display: inline-block; background: #4e342e; color: white; padding: .75rem 1.25rem; border-radius: 5px; text-decoration: none; }
+  </style>
+</head>
+<body>
+  <main>
+    <h1>${escapeHtml(title)}</h1>
+    <p>${escapeHtml(message)}</p>
+    <p><a href="/${offerRetry ? '#rewards-signup' : ''}">${offerRetry ? 'Back to sign-up' : 'Back to The Daily Grind'}</a></p>
+  </main>
+</body>
+</html>`;
+  res.writeHead(status, {
+    'Content-Type': 'text/html; charset=utf-8',
+    'Cache-Control': 'no-store',
+    ...securityHeaders(),
+  });
+  res.end(html);
+}
+
+const server = http.createServer(async (req, res) => {
+  try {
+    const { pathname } = new URL(req.url, 'http://localhost');
+    if ((req.method === 'GET' || req.method === 'HEAD') && (pathname === '/' || pathname === '/index.html')) {
+      return await handleHomepage(req, res);
+    }
+    if (pathname === '/api/rewards/signup') {
+      if (req.method !== 'POST') {
+        res.writeHead(405, { Allow: 'POST' });
+        return res.end();
+      }
+      return await handleSignup(req, res);
+    }
+    res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Not found');
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) sendResult(res, 500, 'Something went wrong', 'Please try again in a moment.');
+    else res.end();
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind listening on port ${PORT} (public origin ${PUBLIC_ORIGIN})`);
+});
