diff --git a/lib/email-verification.js b/lib/email-verification.js
new file mode 100644
index 0000000..770d8d6
--- /dev/null
+++ b/lib/email-verification.js
@@ -0,0 +1,189 @@
+// Server-side verification of Email Verification Protocol (EVP) presentations.
+//
+// The browser fills the hidden `autocomplete="email-verification-token"` input
+// with an SD-JWT presentation (`EVT~KB-JWT`). The EVT comes from the user's
+// email provider (the issuer). The KB-JWT is signed by an ephemeral browser key
+// and binds the EVT to our origin (aud) and the per-render nonce.
+//
+// This module never trusts anything the client claims about verification. It
+// re-derives trust from DNS delegation, issuer metadata, and signatures.
+
+import { createHash } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { SDJwtInstance, decodeSdJwtSync, getClaimsSync } from '@sd-jwt/core';
+import { createRemoteJWKSet, importJWK, jwtVerify } from 'jose';
+
+// IETF draft-hardt-email-verification (§3.3, §5.1.1) specifies RFC 9864 'Ed25519' and 'ES256'.
+// TODO: Remove 'EdDSA' once live issuers and Chrome Origin Trial builds finish
+// moving from 'EdDSA' (crv: 'Ed25519') to 'Ed25519'.
+const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+
+const MAX_TOKEN_LENGTH = 16 * 1024;
+const FETCH_TIMEOUT_MS = 5000;
+
+const hasher = (data, alg) =>
+  createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+// Cache JWKS sets per jwks_uri so jose can reuse its own cooldown/caching logic.
+const jwksCache = new Map();
+function getRemoteJwks(jwksUri) {
+  let jwks = jwksCache.get(jwksUri);
+  if (!jwks) {
+    jwks = createRemoteJWKSet(new URL(jwksUri), { timeoutDuration: FETCH_TIMEOUT_MS });
+    jwksCache.set(jwksUri, jwks);
+  }
+  return jwks;
+}
+
+async function assertDnsDelegation(domain, iss) {
+  let records;
+  try {
+    records = (await dns.resolveTxt(`_email-verification.${domain}`)).map((r) => r.join(''));
+  } catch (err) {
+    throw new Error(`No _email-verification TXT record for "${domain}" (${err.code ?? err.message}).`);
+  }
+  const delegated = records.some(
+    (txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss,
+  );
+  if (!delegated) {
+    throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+  }
+}
+
+async function loadIssuerJwks(iss) {
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') throw new Error('Issuer must use HTTPS.');
+
+  const res = await fetch(discoveryUrl, {
+    signal: AbortSignal.timeout(FETCH_TIMEOUT_MS),
+    redirect: 'error',
+    headers: { accept: 'application/json' },
+  });
+  if (!res.ok) throw new Error(`Issuer metadata request failed with HTTP ${res.status}.`);
+  const metadata = await res.json();
+
+  if (metadata?.issuer !== iss || typeof metadata.jwks_uri !== 'string' || !metadata.jwks_uri.startsWith('https://')) {
+    throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+  }
+  return getRemoteJwks(metadata.jwks_uri);
+}
+
+/**
+ * Verify an `EVT~KB-JWT` presentation.
+ * Throws on any failure. Resolves with the verified claims on success.
+ *
+ * @param {object} params
+ * @param {string} params.rawToken          Value of the hidden token input (untrusted).
+ * @param {string} params.submittedEmail    Email the user submitted in the form.
+ * @param {string} params.expectedNonce     Single-use nonce consumed from server session state.
+ * @param {string} params.expectedAudience  Our public origin, e.g. https://dailygrind.example
+ */
+export async function verifyEmailVerificationToken({
+  rawToken,
+  submittedEmail,
+  expectedNonce,
+  expectedAudience,
+}) {
+  if (!expectedNonce) throw new Error('No nonce in session (expired or already used).');
+  if (!rawToken || rawToken.length > MAX_TOKEN_LENGTH) throw new Error('Missing or oversized token.');
+
+  // Step 1: parse the SD-JWT and check the claims before any network I/O.
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evtPayload = decoded.jwt?.payload ?? {};
+  const iss = evtPayload.iss;
+  if (!decoded.kbJwt || typeof iss !== 'string') {
+    throw new Error('Missing KB-JWT or issuer claim.');
+  }
+
+  // `email` and `email_verified` may be plain claims or selectively disclosed.
+  const claims = getClaimsSync(evtPayload, decoded.disclosures ?? [], hasher);
+  if (claims.email_verified !== true) throw new Error('email_verified !== true.');
+  if (typeof claims.email !== 'string' || claims.email.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+
+  // Step 2: DNS delegation for the email's domain must name this exact issuer.
+  const domain = submittedEmail.slice(submittedEmail.lastIndexOf('@') + 1).toLowerCase();
+  if (!domain) throw new Error('Submitted email has no domain.');
+  await assertDnsDelegation(domain, iss);
+  const issuerJwks = await loadIssuerJwks(iss);
+
+  // Step 3: check the EVT signature against the issuer, then the KB-JWT against cnf.jwk.
+  const evtOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // Some issuers (e.g. Gmail) omit `kid`. With several keys in the JWKS,
+        // jose throws an error you can iterate to get each candidate key.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {
+            // try next key
+          }
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = evtPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header?.alg;
+      if (
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  // Passing keyBindingNonce is what makes @sd-jwt/core run kbVerifier and
+  // check nonce, aud, iat, and sd_hash. Do not remove it.
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+
+  // Check again against the claims returned after signature verification.
+  if (
+    verified.payload.email_verified !== true ||
+    String(verified.payload.email).toLowerCase() !== submittedEmail.toLowerCase()
+  ) {
+    throw new Error('Verified claims do not match submitted email.');
+  }
+
+  return { email: submittedEmail, issuer: iss };
+}
