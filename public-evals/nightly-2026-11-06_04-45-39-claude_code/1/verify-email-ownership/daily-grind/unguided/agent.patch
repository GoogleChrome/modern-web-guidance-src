diff --git a/server.js b/server.js
new file mode 100644
index 0000000..e3f4a08
--- /dev/null
+++ b/server.js
@@ -0,0 +1,269 @@
+// The Daily Grind web server: serves the homepage and the rewards sign-up API.
+// Zero dependencies — run with `node server.js`.
+//
+// Env:
+//   PORT        (default 11222)
+//   APP_ORIGIN  public origin of the site, e.g. https://dailygrind.coffee.
+//               Used as the required `aud` of email-verification tokens and for
+//               CSRF Origin checks. Defaults to http://localhost:$PORT.
+//   DATA_DIR    where accounts.json is stored (default ./data)
+
+import { createServer } from 'node:http';
+import { readFile, writeFile, rename, mkdir } from 'node:fs/promises';
+import { randomBytes, scrypt as scryptCb, timingSafeEqual } from 'node:crypto';
+import { promisify } from 'node:util';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createEmailVerifier, normalizeEmail, EmailVerificationError } from './lib/email-verification.js';
+
+const scrypt = promisify(scryptCb);
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT) || 11222;
+const APP_ORIGIN = (process.env.APP_ORIGIN || `http://localhost:${PORT}`).replace(/\/+$/, '');
+const SECURE_COOKIES = APP_ORIGIN.startsWith('https://');
+const DATA_DIR = process.env.DATA_DIR || path.join(ROOT, 'data');
+const ACCOUNTS_FILE = path.join(DATA_DIR, 'accounts.json');
+
+const NONCE_TTL_MS = 5 * 60 * 1000;
+const VERIFIED_TTL_MS = 30 * 60 * 1000;
+const SESSION_TTL_MS = 60 * 60 * 1000;
+
+const verifier = createEmailVerifier({ expectedOrigin: APP_ORIGIN });
+
+// ---------------------------------------------------------------- sessions
+const sessions = new Map(); // sid -> { nonce, nonceExp, verifiedEmail, verifiedExp, exp }
+
+function getSession(req, res, create = false) {
+  const sid = /(?:^|;\s*)dg_sid=([A-Za-z0-9_-]{43})(?:;|$)/.exec(req.headers.cookie || '')?.[1];
+  let s = sid && sessions.get(sid);
+  if (s && s.exp < Date.now()) { sessions.delete(sid); s = null; }
+  if (!s && create) {
+    const id = randomBytes(32).toString('base64url');
+    s = { id, exp: 0 };
+    sessions.set(id, s);
+    res.setHeader('Set-Cookie',
+      `dg_sid=${id}; Path=/api/rewards; HttpOnly; SameSite=Strict; Max-Age=${SESSION_TTL_MS / 1000}${SECURE_COOKIES ? '; Secure' : ''}`);
+  }
+  if (s) s.exp = Date.now() + SESSION_TTL_MS;
+  return s || null;
+}
+
+setInterval(() => {
+  const t = Date.now();
+  for (const [k, s] of sessions) if (s.exp < t) sessions.delete(k);
+  for (const [k, r] of rateBuckets) if (r.reset < t) rateBuckets.delete(k);
+}, 60_000).unref();
+
+// ---------------------------------------------------------------- rate limit
+const rateBuckets = new Map();
+function rateLimited(req, key, limit, windowMs) {
+  const id = `${key}:${req.socket.remoteAddress}`;
+  const t = Date.now();
+  let b = rateBuckets.get(id);
+  if (!b || b.reset < t) { b = { n: 0, reset: t + windowMs }; rateBuckets.set(id, b); }
+  return ++b.n > limit;
+}
+
+// ---------------------------------------------------------------- accounts
+let accountsCache = null;
+let writeChain = Promise.resolve();
+
+async function loadAccounts() {
+  if (accountsCache) return accountsCache;
+  try {
+    accountsCache = JSON.parse(await readFile(ACCOUNTS_FILE, 'utf8'));
+  } catch (e) {
+    if (e.code !== 'ENOENT') throw e;
+    accountsCache = {};
+  }
+  return accountsCache;
+}
+
+function saveAccounts() {
+  writeChain = writeChain.then(async () => {
+    await mkdir(DATA_DIR, { recursive: true });
+    const tmp = `${ACCOUNTS_FILE}.${process.pid}.tmp`;
+    await writeFile(tmp, JSON.stringify(accountsCache, null, 2), { mode: 0o600 });
+    await rename(tmp, ACCOUNTS_FILE);
+  });
+  return writeChain;
+}
+
+async function hashPassword(pw) {
+  const salt = randomBytes(16);
+  const key = await scrypt(pw, salt, 64, { N: 16384, r: 8, p: 1 });
+  return `scrypt$16384$8$1$${salt.toString('base64')}$${key.toString('base64')}`;
+}
+
+// ---------------------------------------------------------------- http utils
+const SECURITY_HEADERS = {
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'X-Frame-Options': 'DENY',
+};
+const HTML_CSP = [
+  "default-src 'self'",
+  "script-src 'self'",
+  "style-src 'self' 'unsafe-inline'",
+  "img-src 'self' https://images.unsplash.com data:",
+  "connect-src 'self'",
+  "form-action 'self'",
+  "frame-ancestors 'none'",
+  "base-uri 'none'",
+  "object-src 'none'",
+].join('; ');
+
+function send(res, status, body, headers = {}) {
+  res.writeHead(status, { ...SECURITY_HEADERS, ...headers });
+  res.end(body);
+}
+function json(res, status, obj) {
+  send(res, status, JSON.stringify(obj), { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
+}
+
+async function readJsonBody(req, limit = 32 * 1024) {
+  if (!/^application\/json\b/i.test(req.headers['content-type'] || '')) {
+    throw Object.assign(new Error('Expected application/json'), { status: 415 });
+  }
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > limit) throw Object.assign(new Error('Request body too large'), { status: 413 });
+    chunks.push(chunk);
+  }
+  try {
+    const v = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+    if (!v || typeof v !== 'object' || Array.isArray(v)) throw new Error();
+    return v;
+  } catch {
+    throw Object.assign(new Error('Invalid JSON body'), { status: 400 });
+  }
+}
+
+function sameOrigin(req) {
+  return req.headers.origin === APP_ORIGIN && req.headers['sec-fetch-site'] !== 'cross-site';
+}
+
+const STATIC = {
+  '/': ['index.html', 'text/html; charset=utf-8'],
+  '/index.html': ['index.html', 'text/html; charset=utf-8'],
+  '/js/rewards-signup.js': ['js/rewards-signup.js', 'text/javascript; charset=utf-8'],
+};
+
+// ---------------------------------------------------------------- handlers
+
+// Issue a fresh single-use nonce for the email input. The browser embeds it in
+// the key-binding JWT, so a token can only be redeemed by this session.
+function handleNonce(req, res) {
+  const s = getSession(req, res, true);
+  s.nonce = randomBytes(24).toString('base64url');
+  s.nonceExp = Date.now() + NONCE_TTL_MS;
+  json(res, 200, { nonce: s.nonce, expiresIn: NONCE_TTL_MS / 1000 });
+}
+
+// Verify the SD-JWT+KB from the browser's `emailverified` event.
+async function handleVerifyEmail(req, res) {
+  if (!sameOrigin(req)) return json(res, 403, { error: 'forbidden' });
+  if (rateLimited(req, 'verify', 20, 10 * 60 * 1000)) return json(res, 429, { error: 'rate_limited', message: 'Too many attempts. Try again in a few minutes.' });
+  const body = await readJsonBody(req);
+  const s = getSession(req, res, false);
+  if (!s || !s.nonce || s.nonceExp < Date.now()) {
+    return json(res, 400, { error: 'bad_nonce', message: 'Your verification session expired. Please pick your email again.' });
+  }
+  const nonce = s.nonce;
+  s.nonce = null; // single use, whether or not verification succeeds
+  try {
+    const { email, issuer } = await verifier.verify({ token: body.presentationToken, email: body.email, nonce });
+    s.verifiedEmail = email;
+    s.verifiedExp = Date.now() + VERIFIED_TTL_MS;
+    json(res, 200, { verified: true, email, issuer });
+  } catch (e) {
+    if (!(e instanceof EmailVerificationError)) throw e;
+    console.warn(`[verify-email] rejected: ${e.code}: ${e.message}`);
+    s.verifiedEmail = null;
+    const status = e.code === 'issuer_error' ? 502 : 400;
+    json(res, status, { verified: false, error: e.code, message: publicMessage(e.code) });
+  }
+}
+
+function publicMessage(code) {
+  switch (code) {
+    case 'no_issuer': return "Your email provider doesn't support instant verification yet.";
+    case 'issuer_error': return "We couldn't reach your email provider to confirm the address. Please try again.";
+    case 'email_mismatch': return 'The verified address does not match the email in the form.';
+    case 'expired': case 'bad_nonce': return 'Verification timed out. Please pick your email again.';
+    default: return "We couldn't verify that email address.";
+  }
+}
+
+async function handleSignup(req, res) {
+  if (!sameOrigin(req)) return json(res, 403, { error: 'forbidden' });
+  if (rateLimited(req, 'signup', 10, 10 * 60 * 1000)) return json(res, 429, { error: 'rate_limited', message: 'Too many attempts. Try again later.' });
+  const body = await readJsonBody(req);
+  const s = getSession(req, res, false);
+
+  const firstName = typeof body.firstName === 'string' ? body.firstName.trim() : '';
+  const email = normalizeEmail(body.email);
+  const password = typeof body.password === 'string' ? body.password : '';
+  const errors = {};
+  if (!firstName || firstName.length > 50) errors.firstName = 'Please enter your first name (up to 50 characters).';
+  if (!email) errors.email = 'Please enter a valid email address.';
+  if (password.length < 10 || password.length > 200) errors.password = 'Password must be 10–200 characters.';
+  if (body.acceptTerms !== true) errors.acceptTerms = 'Please accept the Rewards terms.';
+  if (Object.keys(errors).length) return json(res, 400, { error: 'validation', errors });
+
+  const verified = s && s.verifiedEmail && s.verifiedExp > Date.now() &&
+    s.verifiedEmail.length === email.length &&
+    timingSafeEqual(Buffer.from(s.verifiedEmail), Buffer.from(email));
+  if (!verified) {
+    return json(res, 403, { error: 'email_unverified', errors: { email: 'Please verify your email address first.' } });
+  }
+
+  const accounts = await loadAccounts();
+  if (accounts[email]) {
+    return json(res, 409, { error: 'exists', errors: { email: 'A Rewards account already exists for this email. Try signing in.' } });
+  }
+  accounts[email] = {
+    id: randomBytes(12).toString('hex'),
+    firstName,
+    email,
+    emailVerified: true,
+    emailVerifiedVia: 'email-verification-protocol',
+    passwordHash: await hashPassword(password),
+    marketingOptIn: body.marketingOptIn === true,
+    points: 50, // welcome bonus
+    createdAt: new Date().toISOString(),
+  };
+  await saveAccounts();
+  s.verifiedEmail = null;
+  s.verifiedExp = 0;
+  json(res, 201, { ok: true, firstName, points: 50 });
+}
+
+// ---------------------------------------------------------------- router
+const server = createServer(async (req, res) => {
+  try {
+    const url = new URL(req.url, 'http://x');
+    const route = `${req.method} ${url.pathname}`;
+    if (route === 'GET /api/rewards/nonce') return handleNonce(req, res);
+    if (route === 'POST /api/rewards/verify-email') return await handleVerifyEmail(req, res);
+    if (route === 'POST /api/rewards/signup') return await handleSignup(req, res);
+    if (url.pathname.startsWith('/api/')) return json(res, 404, { error: 'not_found' });
+
+    const entry = (req.method === 'GET' || req.method === 'HEAD') && STATIC[url.pathname];
+    if (!entry) return send(res, 404, 'Not found', { 'Content-Type': 'text/plain; charset=utf-8' });
+    const [file, type] = entry;
+    const headers = { 'Content-Type': type, 'Cache-Control': 'no-cache' };
+    if (type.startsWith('text/html')) headers['Content-Security-Policy'] = HTML_CSP;
+    const body = await readFile(path.join(ROOT, file));
+    send(res, 200, req.method === 'HEAD' ? undefined : body, headers);
+  } catch (e) {
+    if (e.status) return json(res, e.status, { error: 'bad_request', message: e.message });
+    console.error(e);
+    if (!res.headersSent) json(res, 500, { error: 'server_error' });
+    else res.destroy();
+  }
+});
+
+server.listen(PORT, () => console.log(`The Daily Grind listening on :${PORT} (origin ${APP_ORIGIN})`));
diff --git a/test/email-verification.test.js b/test/email-verification.test.js
new file mode 100644
index 0000000..650669f
--- /dev/null
+++ b/test/email-verification.test.js
@@ -0,0 +1,101 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { generateKeyPairSync, sign, createHash } from 'node:crypto';
+import { createEmailVerifier } from '../lib/email-verification.js';
+
+const ORIGIN = 'https://dailygrind.example';
+const NONCE = 'n0nce-abcdefghijklmnopqrstuv';
+const now = () => Math.floor(Date.now() / 1000);
+const b64 = (o) => Buffer.from(JSON.stringify(o)).toString('base64url');
+
+const issuerKey = generateKeyPairSync('ec', { namedCurve: 'P-256' });
+const holderKey = generateKeyPairSync('ec', { namedCurve: 'P-256' });
+const issuerJwk = { ...issuerKey.publicKey.export({ format: 'jwk' }), kid: 'k1', alg: 'ES256', use: 'sig' };
+const holderJwk = holderKey.publicKey.export({ format: 'jwk' });
+
+function jwt(header, payload, key) {
+  const input = `${b64(header)}.${b64(payload)}`;
+  const sig = sign('sha256', Buffer.from(input), { key, dsaEncoding: 'ieee-p1363' }).toString('base64url');
+  return `${input}.${sig}`;
+}
+
+function makeToken({ claims = {}, kb = {}, issuerHeader = {}, kbKey = holderKey.privateKey, isKey = issuerKey.privateKey } = {}) {
+  const sd = jwt({ alg: 'ES256', typ: 'evp+sd-jwt', kid: 'k1', ...issuerHeader },
+    { iss: 'issuer.mail.example', iat: now(), cnf: { jwk: holderJwk }, email: 'Jo@Mail.example', email_verified: true, ...claims },
+    isKey) + '~';
+  const sdHash = createHash('sha256').update(sd).digest('base64url');
+  return sd + jwt({ alg: 'ES256', typ: 'kb+jwt' }, { aud: ORIGIN, nonce: NONCE, iat: now(), sd_hash: sdHash, ...kb }, kbKey);
+}
+
+function verifier(overrides = {}) {
+  return createEmailVerifier({
+    expectedOrigin: ORIGIN,
+    resolveTxt: async (name) => (name === '_email-verification.mail.example' ? [['iss=issuer.mail.example']] : []),
+    fetchJson: async (url) => {
+      if (url === 'https://issuer.mail.example/.well-known/email-verification') {
+        return { issuance_endpoint: 'https://issuer.mail.example/issue', jwks_uri: 'https://issuer.mail.example/jwks' };
+      }
+      if (url === 'https://issuer.mail.example/jwks') return { keys: [issuerJwk] };
+      throw new Error(`unexpected fetch ${url}`);
+    },
+    ...overrides,
+  });
+}
+
+const run = (token, extra = {}) => verifier(extra.v).verify({ token, email: 'jo@mail.example', nonce: NONCE, ...extra.args });
+const rejects = (p, code) => assert.rejects(p, (e) => e.code === code || assert.fail(`expected ${code}, got ${e.code}: ${e.message}`));
+
+test('accepts a valid SD-JWT+KB presentation', async () => {
+  assert.deepEqual(await run(makeToken()), { email: 'jo@mail.example', issuer: 'issuer.mail.example' });
+});
+
+test('accepts legacy web-identity+sd-jwt typ', async () => {
+  await run(makeToken({ issuerHeader: { typ: 'web-identity+sd-jwt' } }));
+});
+
+test('rejects wrong audience (token minted for another site)', () =>
+  rejects(run(makeToken({ kb: { aud: 'https://evil.example' } })), 'wrong_audience'));
+
+test('rejects wrong nonce', () => rejects(run(makeToken({ kb: { nonce: 'other-nonce-xxxxxxxxxxxx' } })), 'bad_nonce'));
+
+test('rejects email mismatch', () =>
+  rejects(run(makeToken(), { args: { email: 'someone@mail.example' } }), 'email_mismatch'));
+
+test('rejects email_verified != true', () => rejects(run(makeToken({ claims: { email_verified: 'true' } })), 'invalid_token'));
+
+test('rejects issuer not authoritative for domain', () =>
+  rejects(run(makeToken({ claims: { iss: 'evil-issuer.example' } })), 'wrong_issuer'));
+
+test('rejects domain with no DNS record', () =>
+  rejects(run(makeToken({ claims: { email: 'jo@other.example' } }), { args: { email: 'jo@other.example' } }), 'no_issuer'));
+
+test('rejects issuer signature from an unknown key', () => {
+  const rogue = generateKeyPairSync('ec', { namedCurve: 'P-256' });
+  return rejects(run(makeToken({ isKey: rogue.privateKey })), 'invalid_token');
+});
+
+test('rejects KB-JWT not signed by cnf key', () => {
+  const rogue = generateKeyPairSync('ec', { namedCurve: 'P-256' });
+  return rejects(run(makeToken({ kbKey: rogue.privateKey })), 'invalid_token');
+});
+
+test('rejects tampered sd_hash', () => rejects(run(makeToken({ kb: { sd_hash: 'AAAA' } })), 'invalid_token'));
+
+test('rejects stale key-binding JWT', () => rejects(run(makeToken({ kb: { iat: now() - 3600 } })), 'expired'));
+
+test('rejects stale issuance', () => rejects(run(makeToken({ claims: { iat: now() - 3600 } })), 'expired'));
+
+test('rejects alg none', async () => {
+  const t = makeToken();
+  const [sd, kb] = [t.slice(0, t.lastIndexOf('~')), t.slice(t.lastIndexOf('~') + 1)];
+  const parts = sd.split('.');
+  const forged = `${b64({ alg: 'none', typ: 'evp+sd-jwt' })}.${parts[1]}.~${kb}`;
+  await rejects(run(forged), 'invalid_token');
+});
+
+test('rejects jwks_uri on a different host', () =>
