index 0000000..60e5412
--- /dev/null
+++ b/lib/email-verification.js
@@ -0,0 +1,307 @@
+// Server-side verifier for the browser Email Verification Protocol (EVP).
+//
+// Flow: the page puts a server-issued nonce on an <input autocomplete="email">.
+// When the customer picks an address from autofill, a supporting browser asks
+// the email domain's issuer for an SD-JWT that attests to the address, binds it
+// to our origin + nonce with a Key Binding JWT (SD-JWT+KB), and hands it to the
+// page via an `emailverified` event. Nothing is emailed to the customer.
+//
+// This module verifies that token:
+//   1. The issuer is authoritative for the email's domain
+//      (DNS TXT `_email-verification.<domain>` => `iss=<issuer host>`).
+//   2. The SD-JWT is signed by a key from the issuer's published JWKS
+//      (https://<issuer>/.well-known/email-verification -> jwks_uri).
+//   3. The claims say email_verified=true for exactly the submitted email.
+//   4. The KB-JWT is signed by the key in `cnf.jwk`, targets our origin (aud),
+//      carries our single-use nonce, is fresh, and its sd_hash covers the SD-JWT.
+
+import { createHash, createPublicKey, verify as cryptoVerify } from 'node:crypto';
+import { resolveTxt, lookup } from 'node:dns/promises';
+import { BlockList, isIP } from 'node:net';
+
+export class EmailVerificationError extends Error {
+  constructor(message, code = 'invalid_token') {
+    super(message);
+    this.code = code;
+  }
+}
+
+const fail = (msg, code) => { throw new EmailVerificationError(msg, code); };
+
+const ISSUER_TYPS = new Set(['evp+sd-jwt', 'web-identity+sd-jwt']);
+const KB_TYP = 'kb+jwt';
+const ALGS = {
+  ES256: { hash: 'sha256', dsaEncoding: 'ieee-p1363', kty: 'EC', crv: 'P-256' },
+  ES384: { hash: 'sha384', dsaEncoding: 'ieee-p1363', kty: 'EC', crv: 'P-384' },
+  RS256: { hash: 'sha256', kty: 'RSA' },
+  EdDSA: { hash: null, kty: 'OKP', crv: 'Ed25519' },
+};
+
+const MAX_TOKEN_LENGTH = 16 * 1024;
+const CLOCK_SKEW_S = 60;
+const ISSUANCE_MAX_AGE_S = 10 * 60;
+const KB_MAX_AGE_S = 5 * 60;
+const HOSTNAME_RE = /^(?=.{1,253}$)(?!-)[a-z0-9-]{1,63}(?<!-)(\.(?!-)[a-z0-9-]{1,63}(?<!-))+$/;
+
+const b64urlDecode = (s) => {
+  if (typeof s !== 'string' || !/^[A-Za-z0-9_-]*$/.test(s)) fail('Malformed base64url segment');
+  return Buffer.from(s, 'base64url');
+};
+const b64urlSha256 = (s) => createHash('sha256').update(s, 'ascii').digest('base64url');
+
+function parseJson(buf, what) {
+  try {
+    const v = JSON.parse(buf.toString('utf8'));
+    if (!v || typeof v !== 'object' || Array.isArray(v)) throw new Error();
+    return v;
+  } catch {
+    return fail(`Malformed ${what}`);
+  }
+}
+
+function decodeJwt(jwt, what) {
+  const parts = jwt.split('.');
+  if (parts.length !== 3) fail(`Malformed ${what}`);
+  const [h, p, s] = parts;
+  return {
+    header: parseJson(b64urlDecode(h), `${what} header`),
+    payload: parseJson(b64urlDecode(p), `${what} payload`),
+    signingInput: `${h}.${p}`,
+    signature: b64urlDecode(s),
+  };
+}
+
+function verifyJwtSignature({ header, signingInput, signature }, jwk, what) {
+  const spec = ALGS[header.alg];
+  if (!spec) fail(`${what} uses unsupported alg`);
+  if (!jwk || typeof jwk !== 'object' || jwk.d !== undefined) fail(`${what} key is not a public JWK`);
+  if (jwk.kty !== spec.kty || (spec.crv && jwk.crv !== spec.crv)) fail(`${what} key does not match alg`);
+  if (jwk.alg && jwk.alg !== header.alg) fail(`${what} key alg mismatch`);
+  let key;
+  try {
+    const { kty, crv, x, y, n, e } = jwk;
+    key = createPublicKey({ key: { kty, crv, x, y, n, e }, format: 'jwk' });
+  } catch {
+    fail(`${what} key is invalid`);
+  }
+  const opts = { key };
+  if (spec.dsaEncoding) opts.dsaEncoding = spec.dsaEncoding;
+  let ok = false;
+  try {
+    ok = cryptoVerify(spec.hash, Buffer.from(signingInput, 'ascii'), opts, signature);
+  } catch {
+    ok = false;
+  }
+  if (!ok) fail(`${what} signature is invalid`);
+}
+
+export function normalizeEmail(email) {
+  if (typeof email !== 'string') return null;
+  const e = email.trim().toLowerCase();
+  if (e.length > 254) return null;
+  const at = e.lastIndexOf('@');
+  if (at < 1 || at !== e.indexOf('@')) return null;
+  const domain = e.slice(at + 1);
+  if (!HOSTNAME_RE.test(domain)) return null;
+  if (!/^[a-z0-9.!#$%&'*+/=?^_`{|}~-]{1,64}$/.test(e.slice(0, at))) return null;
+  return e;
+}
+
+function normalizeIssuer(iss) {
+  if (typeof iss !== 'string') return null;
+  let host = iss.trim().toLowerCase();
+  if (host.startsWith('https://')) {
+    try {
+      const u = new URL(host);
+      if (u.pathname !== '/' || u.search || u.hash || u.port || u.username) return null;
+      host = u.hostname;
+    } catch {
+      return null;
+    }
+  }
+  return HOSTNAME_RE.test(host) ? host : null;
+}
+
+// ---------------------------------------------------------------------------
+// Network helpers (DNS + HTTPS) with SSRF guards and caching.
+
+const privateRanges = new BlockList();
+for (const [net, prefix] of [
+  ['0.0.0.0', 8], ['10.0.0.0', 8], ['100.64.0.0', 10], ['127.0.0.0', 8], ['169.254.0.0', 16],
+  ['172.16.0.0', 12], ['192.0.0.0', 24], ['192.168.0.0', 16], ['198.18.0.0', 15], ['224.0.0.0', 3],
+]) privateRanges.addSubnet(net, prefix, 'ipv4');
+for (const [net, prefix] of [['::', 127], ['fc00::', 7], ['fe80::', 10], ['ff00::', 8], ['::ffff:0:0', 96]]) {
+  privateRanges.addSubnet(net, prefix, 'ipv6');
+}
+
+async function assertPublicHost(hostname) {
+  if (isIP(hostname)) fail('Issuer host must be a DNS name', 'issuer_error');
+  const addrs = await lookup(hostname, { all: true }).catch(() => fail('Issuer host does not resolve', 'issuer_error'));
+  for (const { address, family } of addrs) {
+    if (privateRanges.check(address, family === 6 ? 'ipv6' : 'ipv4')) {
+      fail('Issuer host resolves to a non-public address', 'issuer_error');
+    }
+  }
+}
+
+export async function defaultFetchJson(url) {
+  const u = new URL(url);
+  if (u.protocol !== 'https:') fail('Issuer URLs must use https', 'issuer_error');
+  await assertPublicHost(u.hostname);
+  let res;
+  try {
+    res = await fetch(u, {
+      redirect: 'error',
+      headers: { accept: 'application/json' },
+      signal: AbortSignal.timeout(5000),
+    });
+  } catch {
+    fail('Could not reach issuer', 'issuer_error');
+  }
+  if (!res.ok) fail(`Issuer responded ${res.status}`, 'issuer_error');
+  const text = await res.text();
+  if (text.length > 64 * 1024) fail('Issuer response too large', 'issuer_error');
+  try {
+    return JSON.parse(text);
+  } catch {
+    return fail('Issuer returned invalid JSON', 'issuer_error');
+  }
+}
+
+export async function defaultResolveTxt(name) {
+  try {
+    return await resolveTxt(name);
+  } catch {
+    return [];
+  }
+}
+
+function makeCache(ttlMs) {
+  const m = new Map();
+  return async (key, load) => {
+    const hit = m.get(key);
+    if (hit && hit.exp > Date.now()) return hit.value;
+    const value = await load();
+    m.set(key, { value, exp: Date.now() + ttlMs });
+    if (m.size > 1000) m.delete(m.keys().next().value);
+    return value;
+  };
+}
+
+// ---------------------------------------------------------------------------
+
+export function createEmailVerifier({
+  expectedOrigin,
+  resolveTxt: txt = defaultResolveTxt,
+  fetchJson = defaultFetchJson,
+  now = () => Math.floor(Date.now() / 1000),
+  cacheTtlMs = 10 * 60 * 1000,
+} = {}) {
+  if (!expectedOrigin) throw new Error('expectedOrigin is required');
+  const issuerCache = makeCache(cacheTtlMs);
+  const jwksCache = makeCache(cacheTtlMs);
+
+  async function issuerForDomain(domain) {
+    const records = await txt(`_email-verification.${domain}`);
+    const issuers = records
+      .map((chunks) => (Array.isArray(chunks) ? chunks.join('') : String(chunks)).trim())
+      .filter((r) => r.startsWith('iss='))
+      .map((r) => normalizeIssuer(r.slice(4)))
+      .filter(Boolean);
+    if (issuers.length !== 1) fail('Email domain has no unique email-verification issuer', 'no_issuer');
+    return issuers[0];
+  }
+
+  async function issuerKeys(issuerHost) {
+    return jwksCache(issuerHost, async () => {
+      const meta = await fetchJson(`https://${issuerHost}/.well-known/email-verification`);
+      if (!meta || typeof meta.jwks_uri !== 'string') fail('Issuer metadata lacks jwks_uri', 'issuer_error');
+      let jwksUrl;
+      try {
+        jwksUrl = new URL(meta.jwks_uri);
+      } catch {
+        fail('Issuer jwks_uri is invalid', 'issuer_error');
+      }
+      const h = jwksUrl.hostname.toLowerCase();
+      if (jwksUrl.protocol !== 'https:' || (h !== issuerHost && !h.endsWith(`.${issuerHost}`))) {
+        fail('Issuer jwks_uri must be https on the issuer domain', 'issuer_error');
+      }
+      const jwks = await fetchJson(jwksUrl.href);
+      if (!jwks || !Array.isArray(jwks.keys)) fail('Issuer JWKS is invalid', 'issuer_error');
+      return jwks.keys.filter((k) => k && typeof k === 'object' && !k.d && (!k.use || k.use === 'sig'));
+    });
+  }
+
+  /**
+   * @param {object} p
+   * @param {string} p.token       SD-JWT+KB presentation from the `emailverified` event
+   * @param {string} p.email       email the customer typed/selected
+   * @param {string} p.nonce       nonce the server issued for this session (single-use)
+   * @returns {Promise<{email:string, issuer:string}>}
+   */
+  async function verify({ token, email, nonce }) {
+    if (typeof token !== 'string' || !token || token.length > MAX_TOKEN_LENGTH) fail('Missing or oversized token');
+    if (typeof nonce !== 'string' || nonce.length < 16) fail('No active nonce for this session', 'bad_nonce');
+    const submitted = normalizeEmail(email);
+    if (!submitted) fail('Invalid email address', 'bad_email');
+
+    // --- Split SD-JWT+KB: <issuer-jwt>~[<disclosure>~]*<kb-jwt>
+    const lastTilde = token.lastIndexOf('~');
+    if (lastTilde < 1) fail('Token is not an SD-JWT+KB presentation');
+    const sdJwt = token.slice(0, lastTilde + 1);
+    const kbJwtRaw = token.slice(lastTilde + 1);
+    const issuerJwtRaw = sdJwt.slice(0, sdJwt.indexOf('~'));
+    if (!kbJwtRaw) fail('Token is missing its key-binding JWT');
+
+    const issuerJwt = decodeJwt(issuerJwtRaw, 'issuer JWT');
+    const kbJwt = decodeJwt(kbJwtRaw, 'key-binding JWT');
+    const t = now();
+
+    // --- Issuer JWT header + claims (cheap checks before any network I/O)
+    if (!ISSUER_TYPS.has(issuerJwt.header.typ)) fail('Issuer JWT has unexpected typ');
+    if (!ALGS[issuerJwt.header.alg]) fail('Issuer JWT uses unsupported alg');
+    const c = issuerJwt.payload;
+    const tokenEmail = normalizeEmail(c.email);
+    if (!tokenEmail || tokenEmail !== submitted) fail('Token email does not match the submitted email', 'email_mismatch');
+    if (c.email_verified !== true) fail('Issuer did not assert email_verified');
+    if (typeof c.iat !== 'number' || c.iat > t + CLOCK_SKEW_S || c.iat < t - ISSUANCE_MAX_AGE_S) fail('Issuer JWT is stale or from the future', 'expired');
+    if (c.exp !== undefined && (typeof c.exp !== 'number' || c.exp < t - CLOCK_SKEW_S)) fail('Issuer JWT has expired', 'expired');
+    if (c.nbf !== undefined && (typeof c.nbf !== 'number' || c.nbf > t + CLOCK_SKEW_S)) fail('Issuer JWT not yet valid', 'expired');
+    const holderJwk = c.cnf && c.cnf.jwk;
+    if (!holderJwk || typeof holderJwk !== 'object') fail('Issuer JWT lacks cnf.jwk');
+    const claimedIssuer = normalizeIssuer(c.iss);
+    if (!claimedIssuer) fail('Issuer JWT has invalid iss');
+
+    // --- Key-binding JWT: proves the presenting browser holds cnf key, for us, now.
+    if (kbJwt.header.typ !== KB_TYP) fail('Key-binding JWT has unexpected typ');
+    verifyJwtSignature(kbJwt, holderJwk, 'Key-binding JWT');
+    const kb = kbJwt.payload;
+    const aud = Array.isArray(kb.aud) ? kb.aud : [kb.aud];
+    if (aud.length !== 1 || aud[0] !== expectedOrigin) fail('Token was not issued for this site', 'wrong_audience');
+    if (typeof kb.nonce !== 'string' || kb.nonce !== nonce) fail('Token nonce does not match', 'bad_nonce');
+    if (typeof kb.iat !== 'number' || kb.iat > t + CLOCK_SKEW_S || kb.iat < t - KB_MAX_AGE_S) fail('Key-binding JWT is stale', 'expired');
+    if (kb.sd_hash !== b64urlSha256(sdJwt)) fail('Key-binding JWT sd_hash mismatch');
+
+    // --- Issuer authority + signature (network)
+    const domain = tokenEmail.slice(tokenEmail.indexOf('@') + 1);
+    const authoritative = await issuerCache(domain, () => issuerForDomain(domain));
+    if (claimedIssuer !== authoritative) fail('Token issuer is not authoritative for this email domain', 'wrong_issuer');
+    const keys = await issuerKeys(authoritative);
+    const kid = issuerJwt.header.kid;
+    const candidates = keys.filter((k) => (kid === undefined ? true : k.kid === kid));
+    if (candidates.length === 0) fail('No matching issuer signing key', 'issuer_error');
+    let verified = false;
+    for (const k of candidates) {
+      try {
+        verifyJwtSignature(issuerJwt, k, 'Issuer JWT');
+        verified = true;
+        break;
+      } catch { /* try next */ }
+    }
+    if (!verified) fail('Issuer JWT signature is invalid');
+
+    return { email: tokenEmail, issuer: authoritative };
+  }
+
+  return { verify };
+}
