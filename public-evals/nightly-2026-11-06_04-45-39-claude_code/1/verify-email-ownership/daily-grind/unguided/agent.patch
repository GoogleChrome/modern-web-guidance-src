+// Daily Grind Rewards sign-up: browser-native email verification.
+//
+// We put a server nonce on the email <input>. In browsers that implement the
+// Email Verification Protocol, choosing an address from autofill makes the
+// browser obtain a signed attestation from the email provider and fire an
+// `emailverified` event carrying an SD-JWT+KB presentation token. We send that
+// to the server for verification — no passcode or magic-link email involved.
+(() => {
+  const form = document.getElementById('rewards-form');
+  if (!form) return;
+  const emailInput = form.elements.email;
+  const submitBtn = form.querySelector('button[type="submit"]');
+  const emailStatus = document.getElementById('email-status');
+  const formStatus = document.getElementById('form-status');
+
+  let verifiedEmail = null;
+  let nonceTimer = null;
+  let verifying = false;
+
+  const normalize = (v) => v.trim().toLowerCase();
+
+  function setEmailStatus(state, text) {
+    emailStatus.dataset.state = state;
+    emailStatus.textContent = text;
+  }
+
+  function setFieldError(name, msg) {
+    const el = document.getElementById(`${name}-error`);
+    const input = form.elements[name];
+    if (el) el.textContent = msg || '';
+    if (input) input.setAttribute('aria-invalid', msg ? 'true' : 'false');
+  }
+
+  function updateSubmit() {
+    submitBtn.disabled = verifying || !verifiedEmail || normalize(emailInput.value) !== verifiedEmail;
+  }
+
+  async function refreshNonce() {
+    clearTimeout(nonceTimer);
+    try {
+      const res = await fetch('/api/rewards/nonce', { credentials: 'same-origin', cache: 'no-store' });
+      if (!res.ok) throw new Error(String(res.status));
+      const { nonce, expiresIn } = await res.json();
+      emailInput.setAttribute('nonce', nonce);
+      emailInput.nonce = nonce;
+      // Renew shortly before expiry so a slow customer still gets a valid one.
+      nonceTimer = setTimeout(refreshNonce, Math.max(30, expiresIn - 30) * 1000);
+    } catch {
+      setEmailStatus('error', 'Email verification is temporarily unavailable. Please refresh the page.');
+    }
+  }
+
+  emailInput.addEventListener('emailverified', async (event) => {
+    const token = event.presentationToken ?? event.token;
+    if (typeof token !== 'string' || !token) return;
+    verifying = true;
+    updateSubmit();
+    setFieldError('email', '');
+    setEmailStatus('pending', 'Confirming your email with your provider…');
+    try {
+      const res = await fetch('/api/rewards/verify-email', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ email: emailInput.value, presentationToken: token }),
+      });
+      const data = await res.json().catch(() => ({}));
+      if (res.ok && data.verified) {
+        verifiedEmail = normalize(data.email);
+        setEmailStatus('verified', `✓ ${data.email} is verified`);
+      } else {
+        verifiedEmail = null;
+        setEmailStatus('error', data.message || "We couldn't verify that email address.");
+        refreshNonce(); // nonces are single-use
+      }
+    } catch {
+      verifiedEmail = null;
+      setEmailStatus('error', 'Network error while verifying. Please pick your email again.');
+      refreshNonce();
+    } finally {
+      verifying = false;
+      updateSubmit();
+    }
+  });
+
+  emailInput.addEventListener('input', () => {
+    if (verifiedEmail && normalize(emailInput.value) !== verifiedEmail) {
+      verifiedEmail = null;
+      setEmailStatus('idle', 'Email changed — pick an address from your browser’s autofill to verify it.');
+      refreshNonce();
+    }
+    updateSubmit();
+  });
+
+  form.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    ['firstName', 'email', 'password', 'acceptTerms'].forEach((n) => setFieldError(n, ''));
+    formStatus.textContent = '';
+    formStatus.dataset.state = '';
+    if (!verifiedEmail) {
+      setFieldError('email', 'Please verify your email address first.');
+      return;
+    }
+    submitBtn.disabled = true;
+    submitBtn.textContent = 'Creating account…';
+    try {
+      const res = await fetch('/api/rewards/signup', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          firstName: form.elements.firstName.value,
+          email: emailInput.value,
+          password: form.elements.password.value,
+          acceptTerms: form.elements.acceptTerms.checked,
+          marketingOptIn: form.elements.marketingOptIn.checked,
+        }),
+      });
+      const data = await res.json().catch(() => ({}));
+      if (res.ok) {
+        form.reset();
+        form.hidden = true;
+        const done = document.getElementById('rewards-success');
+        done.querySelector('[data-name]').textContent = data.firstName;
+        done.querySelector('[data-points]').textContent = data.points;
+        done.hidden = false;
+        done.focus();
+        return;
+      }
+      for (const [field, msg] of Object.entries(data.errors || {})) setFieldError(field, msg);
+      if (data.error === 'email_unverified') {
+        verifiedEmail = null;
+        setEmailStatus('idle', 'Your verification expired — pick your email from autofill again.');
+        refreshNonce();
+      }
+      if (!data.errors) {
+        formStatus.dataset.state = 'error';
+        formStatus.textContent = data.message || 'Something went wrong. Please try again.';
+      }
+    } catch {
+      formStatus.dataset.state = 'error';
+      formStatus.textContent = 'Network error. Please try again.';
+    } finally {
+      submitBtn.textContent = 'Join Rewards';
+      updateSubmit();
+    }
+  });
+
+  setEmailStatus('idle', 'Choose your email from your browser’s autofill suggestions and we’ll verify it instantly — no code or link needed.');
+  updateSubmit();
+  refreshNonce();
+})();
