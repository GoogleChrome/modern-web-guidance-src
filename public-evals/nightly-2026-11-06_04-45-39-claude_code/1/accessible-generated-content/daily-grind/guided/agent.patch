+      content: "\2726";
+      content: "\2726" / "";
+      color: var(--accent);
+      font-size: 0.7em;
+    }
+
+    /* Buttons */
+    .btn {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.5em;
+    }
+
+    .btn::before,
+    .btn::after {
+      display: none;
+    }
+
+    .btn--order::before {
+      --icon: var(--icon-bag);
+      display: inline-block;
+    }
+
+    .btn--order::after,
+    .btn--details::after {
+      --icon: var(--icon-arrow);
+      display: inline-block;
+      transition: translate 0.2s ease;
+    }
+
+    .btn--order {
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 600;
+    }
+
+    .btn--order:hover {
+      background: #ffc370;
+    }
+
+    .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .btn--order:hover::after,
+    .btn--order:focus-visible::after,
+    .btn--details:hover::after,
+    .btn--details:focus-visible::after {
+      translate: 0.25em 0;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .btn::after {
+        transition: none;
+      }
+    }
   </style>
