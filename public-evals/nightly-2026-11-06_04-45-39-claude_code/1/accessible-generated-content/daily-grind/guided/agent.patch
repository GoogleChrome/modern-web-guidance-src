+    }
+
+    /* Shared masked-icon styling: follows currentColor, stays visible in
+       forced-colors mode, never traps clicks or shrinks in flex layouts. */
+    .card h3::before,
+    .btn::before,
+    .btn::after {
+      content: "";
+      display: inline-block;
+      inline-size: 1em;
+      block-size: 1em;
+      background-color: currentColor;
+      mask: var(--icon) no-repeat center / contain;
+      vertical-align: -0.125em;
+      flex: none;
+      pointer-events: none;
+      forced-color-adjust: none;
+    }
+
+    /* Section heading flourish: ❦ ornaments on either side (decorative text) */
+    .section-title {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 0.6em;
+      color: var(--primary);
+    }
+
+    .section-title::before,
+    .section-title::after {
+      content: "\2766";
+      content: "\2766" / "";
+      color: var(--accent);
+      font-size: 0.9em;
+    }
+
+    .section-title::before {
