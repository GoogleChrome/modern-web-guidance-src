+      padding-block-start: 20px;
+    }
+
+    /* Drink headings: per-drink accent icon */
+    .card h3 {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 0.5em;
+    }
+
+    .card h3::before {
+      --icon: var(--icon-cup);
+      inline-size: 1.3em;
+      block-size: 1.3em;
+      color: var(--accent);
+    }
+
+    .card--espresso h3::before { --icon: var(--icon-bean); }
