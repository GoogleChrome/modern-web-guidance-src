+      .section-heading .flourish::after {
+        content: "\2766" / "";
+        color: var(--accent);
+        font-size: 0.8em;
+        margin: 0 0.4em;
+      }
+
+      .section-heading .flourish::before {
+        display: inline-block;
+        transform: scaleX(-1);
+      }
+    }
+
+    /* --- Drink headings --- */
+    .drink-heading {
+      display: inline-flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.35rem;
+    }
+
+    .drink-heading::before {
+      width: 2.4rem;
+      height: 2.4rem;
+      color: var(--accent);
+      transition: transform 0.4s ease;
+    }
+
+    /* Flourish underline: empty content, gradient only */
+    .drink-heading::after {
+      content: "";
+      display: block;
+      width: 60%;
+      height: 3px;
+      border-radius: 3px;
+      background:
+        radial-gradient(circle, var(--accent) 0 3px, transparent 3.5px) center / 8px 8px no-repeat,
+        linear-gradient(90deg, transparent, var(--secondary) 20%, var(--secondary) 80%, transparent);
+      transform: scaleX(0.6);
+      transition: transform 0.4s ease;
+    }
+
+    .card:hover .drink-heading::before,
+    .card:focus-within .drink-heading::before {
+      transform: rotate(-12deg) scale(1.1);
+    }
+
+    .card:hover .drink-heading::after,
+    .card:focus-within .drink-heading::after {
+      transform: scaleX(1);
+    }
+
+    .drink-heading--maple { --icon: var(--icon-leaf); }
+    .drink-heading--espresso { --icon: var(--icon-bean); }
+    .drink-heading--espresso::before { color: var(--primary); }
+    .drink-heading--cold-brew { --icon: var(--icon-snow); }
+    .drink-heading--cold-brew::before { color: #4f8fb8; }
+
+    /* --- Buttons --- */
+    .btn {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.5em;
+      position: relative;
+      overflow: hidden;
+    }
+
+    .btn::before,
+    .btn::after {
+      width: 1em;
+      height: 1em;
+    }
+
+    /* Icons are opt-in per button type */
+    .btn:not(.btn--order)::before,
+    .btn:not(.btn--order):not(.btn--details)::after {
+      display: none;
+    }
+
+    .btn--order {
+      --icon: var(--icon-cup);
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 600;
+      padding: 12px 24px;
+      box-shadow: 0 4px 14px rgba(255, 171, 64, 0.35);
+    }
+
+    .btn--order:hover {
+      background: #ffb860;
+      color: var(--text);
+    }
+
+    .btn--order::after,
+    .btn--details::after {
+      --icon: var(--icon-arrow);
+      transition: transform 0.3s ease;
+    }
+
+    .btn--order:hover::after,
+    .btn--order:focus-visible::after,
+    .btn--details:hover::after,
+    .btn--details:focus-visible::after {
+      transform: translateX(4px);
+    }
+
+    /* Shine sweep flourish on the primary CTA (decorative span, aria-hidden) */
+    .btn--order .btn-shine {
+      position: absolute;
+      inset: 0;
+      background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.55) 50%, transparent 70%);
+      transform: translateX(-100%);
+      transition: transform 0.6s ease;
+      pointer-events: none;
+    }
+
+    .btn--order:hover .btn-shine,
+    .btn--order:focus-visible .btn-shine {
+      transform: translateX(100%);
+    }
+
+    .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .btn--order:focus-visible {
+      outline-color: white;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .drink-heading::before,
+      .drink-heading::after,
+      .btn::after,
+      .btn-shine {
+        transition: none !important;
+      }
+
+      .card:hover .drink-heading::before,
+      .card:focus-within .drink-heading::before {
+        transform: none;
+      }
+
+      .btn-shine {
+        display: none;
+      }
+    }
+
+    /* High Contrast mode: keep mask icons visible using system colors */
+    @media (forced-colors: active) {
+      .drink-heading::before,
+      .drink-heading::after,
+      .section-heading::before,
+      .section-heading::after {
+        forced-color-adjust: none;
+        background: CanvasText;
+      }
+
+      .btn::before,
+      .btn::after {
+        forced-color-adjust: none;
+        background: LinkText;
+      }
+
+      .btn-shine {
+        display: none;
+      }
+    }
   </style>
