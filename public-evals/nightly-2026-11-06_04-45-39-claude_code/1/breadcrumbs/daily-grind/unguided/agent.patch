+  <script>
+    // Builds the breadcrumb trail from the current URL path, e.g.
+    // /menu/seasonal -> Home › Menu › Maple Oat Latte
+    (function () {
+      var LABELS = {
+        '/menu': 'Menu',
+        '/menu/seasonal': 'Maple Oat Latte',
+        '/menu/espresso': 'Dark Roast Espresso',
+        '/menu/cold-brew': 'Cold Brew',
+        '/locations': 'Locations',
+        '/rewards': 'Rewards',
+        '/account': 'My Account',
+        '/order-online': 'Order Online',
+        '/about': 'Our Story',
+        '/careers': 'Join the Team',
+        '/contact': 'Contact Us',
+        '/privacy-policy': 'Privacy'
+      };
+
+      function prettify(slug) {
+        return decodeURIComponent(slug)
+          .replace(/[-_]+/g, ' ')
+          .replace(/\b\w/g, function (c) { return c.toUpperCase(); });
+      }
+
+      var list = document.getElementById('breadcrumb-list');
+      if (!list) return;
+
+      var path = window.location.pathname;
+      // Treat direct file / index.html access as the home page.
+      if (window.location.protocol === 'file:' || /\/index\.html?$/i.test(path)) {
+        path = '/';
+      }
+
+      var segments = path.split('/').filter(Boolean);
+      var crumbs = [{ href: '/', label: 'Home' }];
+      var href = '';
+      segments.forEach(function (seg) {
+        href += '/' + seg;
+        crumbs.push({ href: href, label: LABELS[href] || prettify(seg) });
+      });
+
+      list.innerHTML = '';
+      crumbs.forEach(function (crumb, i) {
+        var li = document.createElement('li');
+        var el;
+        if (i === crumbs.length - 1) {
+          el = document.createElement('span');
+          el.setAttribute('aria-current', 'page');
+        } else {
+          el = document.createElement('a');
+          el.href = crumb.href;
+        }
+        el.textContent = crumb.label;
+        li.appendChild(el);
+        list.appendChild(li);
+      });
+    })();
+  </script>
+
 </body>
 
