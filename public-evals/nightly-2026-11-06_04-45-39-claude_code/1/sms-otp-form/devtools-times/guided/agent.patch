@@ -0,0 +1,35 @@
+import type { APIRoute } from 'astro';
+import { OTP_LENGTH, verifyOtp } from '../../../lib/otpStore';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+
+const messages = {
+  not_found: 'This code is no longer valid. Request a new code.',
+  expired: 'This code has expired. Request a new code.',
+  too_many_attempts: 'Too many incorrect attempts. Request a new code.',
+  invalid_code: 'That code is incorrect. Check the SMS and try again.',
+} as const;
+
+export const POST: APIRoute = async ({ request }) => {
+  let payload: { verificationId?: unknown; code?: unknown };
+  try {
+    payload = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const { verificationId, code } = payload;
+  if (typeof verificationId !== 'string' || typeof code !== 'string' || !new RegExp(`^\\d{${OTP_LENGTH}}$`).test(code)) {
+    return json({ error: `Enter the ${OTP_LENGTH}-digit code.` }, 400);
+  }
+
+  const result = verifyOtp(verificationId, code);
+  if (!result.ok) {
+    return json({ error: messages[result.reason], reason: result.reason }, result.reason === 'invalid_code' ? 400 : 410);
+  }
+  return json({ verified: true, phone: result.phone });
+};
