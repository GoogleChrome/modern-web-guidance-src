@@ -0,0 +1,104 @@
+import { createHash, randomInt, randomUUID, timingSafeEqual } from 'node:crypto';
+
+/**
+ * In-memory store for SMS one-time passcodes.
+ *
+ * NOTE: This is process-local. In production (multiple instances), back this
+ * with a shared store such as Redis or a database table.
+ */
+
+export const OTP_LENGTH = 6;
+const OTP_TTL_MS = 5 * 60 * 1000; // 5 minutes
+const MAX_ATTEMPTS = 5;
+export const RESEND_COOLDOWN_MS = 30 * 1000;
+
+interface OtpRecord {
+  phone: string;
+  codeHash: Buffer;
+  expiresAt: number;
+  attempts: number;
+  sentAt: number;
+  verified: boolean;
+}
+
+const records = new Map<string, OtpRecord>();
+
+const hash = (value: string) => createHash('sha256').update(value).digest();
+
+function sweep() {
+  const now = Date.now();
+  for (const [id, record] of records) {
+    if (record.expiresAt < now) records.delete(id);
+  }
+}
+
+/** Normalizes to E.164-ish form: leading "+" followed by 8–15 digits. */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const trimmed = input.trim();
+  const digits = trimmed.replace(/\D/g, '');
+  if (digits.length < 8 || digits.length > 15) return null;
+  return trimmed.startsWith('+') || trimmed.startsWith('00')
+    ? `+${digits.replace(/^00/, '')}`
+    : `+${digits}`;
+}
+
+export function generateCode(): string {
+  return randomInt(0, 10 ** OTP_LENGTH).toString().padStart(OTP_LENGTH, '0');
+}
+
+export function createOtp(phone: string, code: string, previousId?: string): string {
+  sweep();
+  if (previousId) records.delete(previousId);
+  const id = randomUUID();
+  const now = Date.now();
+  records.set(id, {
+    phone,
+    codeHash: hash(code),
+    expiresAt: now + OTP_TTL_MS,
+    attempts: 0,
+    sentAt: now,
+    verified: false,
+  });
+  return id;
+}
+
+export function getResendWaitMs(id: string | undefined): number {
+  if (!id) return 0;
+  const record = records.get(id);
+  if (!record) return 0;
+  return Math.max(0, record.sentAt + RESEND_COOLDOWN_MS - Date.now());
+}
+
+export type VerifyResult =
+  | { ok: true; phone: string }
+  | { ok: false; reason: 'not_found' | 'expired' | 'too_many_attempts' | 'invalid_code' };
+
+export function verifyOtp(id: string, code: string): VerifyResult {
+  const record = records.get(id);
+  if (!record) return { ok: false, reason: 'not_found' };
+  if (record.expiresAt < Date.now()) {
+    records.delete(id);
+    return { ok: false, reason: 'expired' };
+  }
+  if (record.attempts >= MAX_ATTEMPTS) {
+    records.delete(id);
+    return { ok: false, reason: 'too_many_attempts' };
+  }
+  record.attempts += 1;
+  if (!timingSafeEqual(record.codeHash, hash(code))) {
+    return { ok: false, reason: 'invalid_code' };
+  }
+  // Single use: consume the code on success.
+  records.delete(id);
+  return { ok: true, phone: record.phone };
+}
+
+/**
+ * Builds the origin-bound SMS body. The last line must be exactly
+ * "@<host> #<code>" so WebOTP and iOS/macOS one-time-code autofill can
+ * verify the domain before offering the code.
+ */
+export function buildSmsBody(code: string, host: string): string {
+  return `Your DevTools Times verification code is ${code}.\n\n@${host} #${code}`;
+}
diff --git a/src/pages/api/phone/send-code.ts b/src/pages/api/phone/send-code.ts
new file mode 100644
index 0000000..594369f
--- /dev/null
+++ b/src/pages/api/phone/send-code.ts
@@ -0,0 +1,57 @@
+import type { APIRoute } from 'astro';
+import {
+  buildSmsBody,
+  createOtp,
+  generateCode,
+  getResendWaitMs,
+  normalizePhone,
+} from '../../../lib/otpStore';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+
+/**
+ * Delivers the SMS. Replace with a real provider (Twilio, SNS, etc.).
+ * Without a provider configured, the message is logged on the server.
+ */
+async function deliverSms(to: string, body: string) {
+  console.info(`[sms] to=${to}\n${body}`);
+}
+
+export const POST: APIRoute = async ({ request, url }) => {
+  let payload: { phone?: unknown; verificationId?: unknown };
+  try {
+    payload = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const phone = normalizePhone(payload.phone);
+  if (!phone) {
+    return json({ error: 'Enter a valid phone number, including the country code.' }, 400);
+  }
+
+  const previousId = typeof payload.verificationId === 'string' ? payload.verificationId : undefined;
+  const waitMs = getResendWaitMs(previousId);
+  if (waitMs > 0) {
+    return json(
+      { error: 'Please wait before requesting another code.', retryAfter: Math.ceil(waitMs / 1000) },
+      429,
+    );
+  }
+
+  const code = generateCode();
+  const verificationId = createOtp(phone, code, previousId);
+  // Host only — no scheme, port, or path — as required by the origin-bound SMS format.
+  await deliverSms(phone, buildSmsBody(code, url.hostname));
+
+  return json({
+    verificationId,
+    phone,
+    // Expose the code only in local development so the flow can be exercised without an SMS provider.
+    ...(import.meta.env.DEV ? { devCode: code } : {}),
+  });
+};
