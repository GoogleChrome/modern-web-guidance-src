+ */
+function useAriaInvalidSync(formRef: React.RefObject<HTMLFormElement | null>) {
+  useEffect(() => {
+    const form = formRef.current;
+    if (!form) return;
+    let supportsUserInvalid = false;
+    try {
+      supportsUserInvalid = CSS.supports('selector(:user-invalid)');
+    } catch {
+      /* ignore */
+    }
+
+    const update = (event: Event) => {
+      const el = event.target as HTMLInputElement;
+      if (!el.matches?.('input, textarea, select') || el.dataset.ariaManaged) return;
+      const invalid = supportsUserInvalid
+        ? el.matches(':user-invalid')
+        : event.type !== 'focus' && !el.checkValidity();
+      if (invalid) el.setAttribute('aria-invalid', 'true');
+      else el.removeAttribute('aria-invalid');
+    };
+    const onInput = (event: Event) => {
+      if ((event.target as HTMLElement).getAttribute?.('aria-invalid') === 'true') update(event);
+    };
+
+    form.addEventListener('blur', update, true);
+    form.addEventListener('focus', update, true);
+    form.addEventListener('invalid', update, true);
+    form.addEventListener('input', onInput, true);
+    return () => {
+      form.removeEventListener('blur', update, true);
+      form.removeEventListener('focus', update, true);
+      form.removeEventListener('invalid', update, true);
