@@ -0,0 +1,163 @@
+import { createHmac, randomBytes, randomInt, timingSafeEqual } from 'node:crypto';
+
+/**
+ * Server-side helpers for SMS one-time passcode (OTP) phone verification.
+ *
+ * Codes are never stored in plain text: only an HMAC of the code (keyed with a
+ * per-challenge salt) is kept in the user's session.
+ */
+
+export const OTP_LENGTH = 6;
+export const OTP_TTL_MS = 5 * 60 * 1000; // code valid for 5 minutes
+export const OTP_MAX_ATTEMPTS = 5; // wrong guesses allowed per code
+export const OTP_RESEND_COOLDOWN_MS = 30 * 1000; // min delay between sends
+export const OTP_MAX_SENDS_PER_WINDOW = 5; // sends allowed per phone per window
+export const OTP_SEND_WINDOW_MS = 60 * 60 * 1000;
+export const VERIFIED_TTL_MS = 15 * 60 * 1000; // time to finish registration after verifying
+
+export const SESSION_CHALLENGE_KEY = 'phoneOtpChallenge';
+export const SESSION_VERIFIED_KEY = 'verifiedPhone';
+
+export interface OtpChallenge {
+  phone: string;
+  salt: string;
+  hash: string;
+  expiresAt: number;
+  attempts: number;
+  sentAt: number;
+}
+
+export interface VerifiedPhone {
+  phone: string;
+  verifiedAt: number;
+}
+
+/**
+ * Normalizes user input to E.164 (e.g. "+1 (555) 123-4567" -> "+15551234567").
+ * Returns null if the value can't be a valid international number.
+ */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  let value = input.trim().replace(/[\s().\-]/g, '');
+  if (value.startsWith('00')) value = `+${value.slice(2)}`;
+  return /^\+[1-9]\d{7,14}$/.test(value) ? value : null;
+}
+
+/** Masks a phone number for display, keeping only the last 2 digits. */
+export function maskPhone(phone: string): string {
+  return `${phone.slice(0, 2)}${'•'.repeat(Math.max(phone.length - 4, 0))}${phone.slice(-2)}`;
+}
+
+export function generateCode(): string {
+  return randomInt(0, 10 ** OTP_LENGTH).toString().padStart(OTP_LENGTH, '0');
+}
+
+function hashCode(code: string, salt: string): string {
+  return createHmac('sha256', salt).update(code).digest('hex');
+}
+
+export function createChallenge(phone: string, code: string, now = Date.now()): OtpChallenge {
+  const salt = randomBytes(16).toString('hex');
+  return {
+    phone,
+    salt,
+    hash: hashCode(code, salt),
+    expiresAt: now + OTP_TTL_MS,
+    attempts: 0,
+    sentAt: now,
+  };
+}
+
+export function codeMatches(challenge: OtpChallenge, code: string): boolean {
+  const expected = Buffer.from(challenge.hash, 'hex');
+  const actual = Buffer.from(hashCode(code, challenge.salt), 'hex');
+  return expected.length === actual.length && timingSafeEqual(expected, actual);
+}
+
+// ---------------------------------------------------------------------------
+// Per-phone rate limiting (in-memory; protects against SMS pumping across
+// sessions). For multi-instance deployments, back this with a shared store.
+// ---------------------------------------------------------------------------
+const sendLog = new Map<string, number[]>();
+
+export function checkSendRateLimit(phone: string, now = Date.now()): { allowed: boolean; retryAfterMs: number } {
+  const recent = (sendLog.get(phone) ?? []).filter((t) => now - t < OTP_SEND_WINDOW_MS);
+  sendLog.set(phone, recent);
+  if (recent.length >= OTP_MAX_SENDS_PER_WINDOW) {
+    return { allowed: false, retryAfterMs: OTP_SEND_WINDOW_MS - (now - recent[0]) };
+  }
+  const last = recent[recent.length - 1];
+  if (last !== undefined && now - last < OTP_RESEND_COOLDOWN_MS) {
+    return { allowed: false, retryAfterMs: OTP_RESEND_COOLDOWN_MS - (now - last) };
+  }
+  return { allowed: true, retryAfterMs: 0 };
+}
+
+export function recordSend(phone: string, now = Date.now()): void {
+  const recent = sendLog.get(phone) ?? [];
+  recent.push(now);
+  sendLog.set(phone, recent);
+}
+
+// ---------------------------------------------------------------------------
+// SMS delivery
+// ---------------------------------------------------------------------------
+
+/**
+ * Builds the SMS body. The final line follows the WebOTP "origin-bound
+ * one-time code" format (`@domain #code`) so supporting browsers can read the
+ * code automatically and iOS/Android keyboards can offer it as a suggestion.
+ */
+export function buildSmsBody(code: string, domain: string): string {
+  return `${code} is your DevTools Times verification code. It expires in ${OTP_TTL_MS / 60000} minutes.\n\n@${domain} #${code}`;
+}
+
+/** Domain the SMS is bound to. Must match the host the user signs up on. */
+export function resolveOtpDomain(requestUrl: URL): string {
+  return import.meta.env.OTP_SMS_DOMAIN || process.env.OTP_SMS_DOMAIN || requestUrl.hostname;
+}
+
+function env(name: string): string | undefined {
+  return (import.meta.env as Record<string, string | undefined>)[name] || process.env[name];
+}
+
+/** True when a real SMS provider is configured. */
+export function smsProviderConfigured(): boolean {
+  return Boolean(env('TWILIO_ACCOUNT_SID') && env('TWILIO_AUTH_TOKEN') && env('TWILIO_FROM_NUMBER'));
+}
+
+/**
+ * Sends an SMS. Uses Twilio when TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN /
+ * TWILIO_FROM_NUMBER are set; otherwise logs the message to the server console
+ * (development fallback).
+ */
+export async function sendSms(to: string, body: string): Promise<void> {
+  if (!smsProviderConfigured()) {
+    console.info(`[phone-verification] SMS to ${maskPhone(to)} (no provider configured):\n${body}`);
+    return;
+  }
+
+  const sid = env('TWILIO_ACCOUNT_SID')!;
+  const token = env('TWILIO_AUTH_TOKEN')!;
+  const from = env('TWILIO_FROM_NUMBER')!;
+
+  const response = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${encodeURIComponent(sid)}/Messages.json`, {
+    method: 'POST',
+    headers: {
+      Authorization: `Basic ${Buffer.from(`${sid}:${token}`).toString('base64')}`,
+      'Content-Type': 'application/x-www-form-urlencoded',
+    },
+    body: new URLSearchParams({ To: to, From: from, Body: body }),
+  });
+
+  if (!response.ok) {
+    throw new Error(`SMS provider responded with ${response.status}`);
+  }
+}
+
+export function json(data: unknown, status = 200, headers: Record<string, string> = {}): Response {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...headers },
+  });
+}
diff --git a/src/pages/api/phone-verification/send.ts b/src/pages/api/phone-verification/send.ts
new file mode 100644
index 0000000..980753e
--- /dev/null
+++ b/src/pages/api/phone-verification/send.ts
@@ -0,0 +1,70 @@
+import type { APIRoute } from 'astro';
+import {
+  OTP_TTL_MS,
+  SESSION_CHALLENGE_KEY,
+  SESSION_VERIFIED_KEY,
+  buildSmsBody,
+  checkSendRateLimit,
+  createChallenge,
+  generateCode,
+  json,
+  maskPhone,
+  normalizePhone,
+  recordSend,
+  resolveOtpDomain,
+  sendSms,
+  smsProviderConfigured,
+} from '../../../lib/phoneVerification';
+
+/** POST { phone } -> sends a one-time passcode via SMS. */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) {
+    return json({ error: 'Sessions are unavailable.', code: 'SESSION_UNAVAILABLE' }, 500);
+  }
+
+  let body: { phone?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.', code: 'BAD_REQUEST' }, 400);
+  }
+
+  const phone = normalizePhone(body.phone);
+  if (!phone) {
+    return json(
+      { error: 'Enter a valid phone number including the country code, for example +1 555 123 4567.', code: 'INVALID_PHONE' },
+      400,
+    );
+  }
+
+  const limit = checkSendRateLimit(phone);
+  if (!limit.allowed) {
+    const retryAfter = Math.ceil(limit.retryAfterMs / 1000);
+    return json(
+      { error: `Please wait ${retryAfter} seconds before requesting another code.`, code: 'RATE_LIMITED', retryAfter },
+      429,
+      { 'Retry-After': String(retryAfter) },
+    );
+  }
+
+  const code = generateCode();
+  try {
+    await sendSms(phone, buildSmsBody(code, resolveOtpDomain(url)));
+  } catch (err) {
+    console.error('[phone-verification] Failed to send SMS', err);
+    return json({ error: 'We could not send a text message to that number. Please try again.', code: 'SMS_FAILED' }, 502);
+  }
+
+  recordSend(phone);
+  await session.set(SESSION_CHALLENGE_KEY, createChallenge(phone, code));
+  session.delete(SESSION_VERIFIED_KEY);
+
+  return json({
+    phone,
+    maskedPhone: maskPhone(phone),
+    expiresIn: OTP_TTL_MS / 1000,
+    resendIn: 30,
+    // Local development convenience only: expose the code when no SMS provider is configured.
+    ...(import.meta.env.DEV && !smsProviderConfigured() ? { devCode: code } : {}),
+  });
+};
diff --git a/src/pages/api/phone-verification/verify.ts b/src/pages/api/phone-verification/verify.ts
new file mode 100644
index 0000000..daad5b5
--- /dev/null
+++ b/src/pages/api/phone-verification/verify.ts
@@ -0,0 +1,71 @@
+import type { APIRoute } from 'astro';
+import {
+  OTP_LENGTH,
+  OTP_MAX_ATTEMPTS,
+  SESSION_CHALLENGE_KEY,
+  SESSION_VERIFIED_KEY,
+  codeMatches,
+  json,
+  type OtpChallenge,
+  type VerifiedPhone,
+} from '../../../lib/phoneVerification';
+
+/** POST { code } -> verifies the passcode for the phone in the current session. */
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) {
+    return json({ error: 'Sessions are unavailable.', code: 'SESSION_UNAVAILABLE' }, 500);
+  }
+
+  let body: { code?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.', code: 'BAD_REQUEST' }, 400);
+  }
+
+  const code = typeof body.code === 'string' ? body.code.replace(/\D/g, '') : '';
+  if (code.length !== OTP_LENGTH) {
+    return json({ error: `Enter the ${OTP_LENGTH}-digit code we sent you.`, code: 'INVALID_CODE_FORMAT' }, 400);
+  }
+
+  const challenge = (await session.get(SESSION_CHALLENGE_KEY)) as OtpChallenge | undefined;
+  if (!challenge) {
+    return json({ error: 'No verification is in progress. Request a new code.', code: 'NO_CHALLENGE' }, 400);
+  }
+
+  if (Date.now() > challenge.expiresAt) {
+    session.delete(SESSION_CHALLENGE_KEY);
+    return json({ error: 'This code has expired. Request a new code.', code: 'CODE_EXPIRED' }, 410);
+  }
+
+  if (challenge.attempts >= OTP_MAX_ATTEMPTS) {
+    session.delete(SESSION_CHALLENGE_KEY);
+    return json({ error: 'Too many incorrect attempts. Request a new code.', code: 'TOO_MANY_ATTEMPTS' }, 429);
+  }
+
+  if (!codeMatches(challenge, code)) {
+    const attempts = challenge.attempts + 1;
+    const attemptsRemaining = OTP_MAX_ATTEMPTS - attempts;
+    if (attemptsRemaining <= 0) {
+      session.delete(SESSION_CHALLENGE_KEY);
+      return json({ error: 'Too many incorrect attempts. Request a new code.', code: 'TOO_MANY_ATTEMPTS' }, 429);
+    }
+    await session.set(SESSION_CHALLENGE_KEY, { ...challenge, attempts });
+    return json(
+      {
+        error: `That code is incorrect. ${attemptsRemaining} ${attemptsRemaining === 1 ? 'attempt' : 'attempts'} remaining.`,
+        code: 'CODE_MISMATCH',
+        attemptsRemaining,
+      },
+      400,
+    );
+  }
+
+  session.delete(SESSION_CHALLENGE_KEY);
+  const verified: VerifiedPhone = { phone: challenge.phone, verifiedAt: Date.now() };
+  await session.set(SESSION_VERIFIED_KEY, verified);
+  // Prevent session fixation now that the session carries a verified identity.
+  await session.regenerate();
+
+  return json({ verified: true, phone: challenge.phone });
+};
diff --git a/src/pages/api/register.ts b/src/pages/api/register.ts
new file mode 100644
index 0000000..bc4130c
--- /dev/null
+++ b/src/pages/api/register.ts
@@ -0,0 +1,45 @@
+import type { APIRoute } from 'astro';
+import { SESSION_VERIFIED_KEY, VERIFIED_TTL_MS, json, type VerifiedPhone } from '../../lib/phoneVerification';
+
+const UPSTREAM_REGISTER_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register';
+
+/**
+ * POST { username, password } -> creates the account, but only once the
+ * session holds a recently verified phone number.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  const verified = (await session?.get(SESSION_VERIFIED_KEY)) as VerifiedPhone | undefined;
+  if (!verified || Date.now() - verified.verifiedAt > VERIFIED_TTL_MS) {
+    return json({ error: 'Please verify your phone number before creating an account.', code: 'PHONE_NOT_VERIFIED' }, 403);
+  }
+
+  let body: { username?: unknown; password?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.', code: 'BAD_REQUEST' }, 400);
+  }
+
+  const { username, password } = body;
+  if (typeof username !== 'string' || typeof password !== 'string') {
+    return json({ error: 'Username and password are required.', code: 'BAD_REQUEST' }, 400);
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(UPSTREAM_REGISTER_URL, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password, phone: verified.phone }),
+    });
+  } catch (err) {
+    console.error('[register] Upstream request failed', err);
+    return json({ error: 'Registration service is unavailable.', code: 'UPSTREAM_UNAVAILABLE' }, 502);
+  }
+
+  const data = await upstream.json().catch(() => ({}));
+  if (upstream.ok) {
+    session?.delete(SESSION_VERIFIED_KEY);
+  }
+  return json(data, upstream.status);
+};
