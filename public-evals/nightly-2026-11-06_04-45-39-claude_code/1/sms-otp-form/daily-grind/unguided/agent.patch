+
+  <script>
+    (function () {
+      'use strict';
+
+      // Backend endpoints. Expected contract:
+      //   POST SEND_URL   { phone, purpose }        -> 2xx on success
+      //   POST VERIFY_URL { phone, purpose, code }  -> 2xx { redirect? } on success
+      // For automatic code extraction (WebOTP), the SMS must end with a line like:
+      //   @<this-site-host> #123456
+      var SEND_URL = '/api/auth/otp/send';
+      var VERIFY_URL = '/api/auth/otp/verify';
+      var CODE_LENGTH = 6;
+      var RESEND_SECONDS = 30;
+      var DESTINATIONS = { rewards: '/rewards', order: '/order-online' };
+
+      var phoneForm = document.getElementById('phone-form');
+      var otpForm = document.getElementById('otp-form');
+      var phoneInput = document.getElementById('phone');
+      var phoneError = document.getElementById('phone-error');
+      var otpInput = document.getElementById('otp');
+      var otpError = document.getElementById('otp-error');
+      var otpPhoneDisplay = document.getElementById('otp-phone-display');
+      var sendBtn = document.getElementById('send-code-btn');
+      var verifyBtn = document.getElementById('verify-btn');
+      var resendBtn = document.getElementById('resend-btn');
+      var changePhoneBtn = document.getElementById('change-phone-btn');
+      var statusEl = document.getElementById('verify-status');
+
+      var state = { phone: '', purpose: 'rewards', verifying: false };
+      var webOtpController = null;
+      var resendTimer = null;
+
+      function setStatus(msg, type) {
+        statusEl.textContent = msg;
+        statusEl.className = 'verify-status' + (type ? ' ' + type : '');
+      }
+
+      function setFieldError(input, errorEl, msg) {
+        errorEl.textContent = msg;
+        if (msg) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+      }
+
+      // Normalise to E.164 for US numbers; returns null if invalid.
+      function normalisePhone(raw) {
+        var digits = raw.replace(/\D/g, '');
+        if (digits.length === 11 && digits.charAt(0) === '1') digits = digits.slice(1);
+        if (digits.length !== 10 || /^[01]/.test(digits)) return null;
+        return '+1' + digits;
+      }
+
+      function formatPhone(e164) {
+        var d = e164.slice(2);
+        return '(' + d.slice(0, 3) + ') ' + d.slice(3, 6) + '-' + d.slice(6);
+      }
+
+      function postJSON(url, body) {
+        return fetch(url, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(body)
+        }).then(function (res) {
+          return res.json().catch(function () { return {}; }).then(function (data) {
+            if (!res.ok) {
+              var err = new Error(data.message || 'Request failed');
+              err.status = res.status;
+              throw err;
+            }
+            return data;
+          });
+        });
+      }
+
+      function abortWebOtp() {
+        if (webOtpController) {
+          webOtpController.abort();
+          webOtpController = null;
+        }
+      }
+
+      // Listen for the SMS via the WebOTP API where supported (Chrome on Android).
+      // Other platforms (e.g. iOS Safari) rely on autocomplete="one-time-code".
+      function listenForSms() {
+        if (!('OTPCredential' in window) || !window.AbortController) return;
+        abortWebOtp();
+        webOtpController = new AbortController();
+        var controller = webOtpController;
+        navigator.credentials.get({ otp: { transport: ['sms'] }, signal: controller.signal })
+          .then(function (otp) {
+            if (!otp || !otp.code || controller.signal.aborted) return;
+            otpInput.value = otp.code.replace(/\D/g, '').slice(0, CODE_LENGTH);
+            setStatus('Code received from your text message.', '');
+            if (otpInput.value.length === CODE_LENGTH) submitCode();
+          })
+          .catch(function () { /* aborted, timed out or denied: manual entry still works */ });
+      }
+
+      function startResendCountdown() {
+        clearInterval(resendTimer);
+        var remaining = RESEND_SECONDS;
+        resendBtn.disabled = true;
+        resendBtn.textContent = 'Resend code in ' + remaining + 's';
+        resendTimer = setInterval(function () {
+          remaining -= 1;
+          if (remaining <= 0) {
+            clearInterval(resendTimer);
+            resendBtn.disabled = false;
+            resendBtn.textContent = 'Resend code';
+          } else {
+            resendBtn.textContent = 'Resend code in ' + remaining + 's';
+          }
+        }, 1000);
+      }
+
+      function sendCode(isResend) {
+        var btn = isResend ? resendBtn : sendBtn;
+        btn.disabled = true;
+        setStatus(isResend ? 'Sending a new code…' : 'Sending your code…', '');
+        return postJSON(SEND_URL, { phone: state.phone, purpose: state.purpose })
+          .then(function () {
+            showOtpStep();
+            setStatus('We sent a code to ' + formatPhone(state.phone) + '.', 'success');
+            startResendCountdown();
+            listenForSms();
+          })
+          .catch(function (err) {
+            var msg = err.status === 429
+              ? 'Too many attempts. Please wait a few minutes and try again.'
+              : 'We couldn’t send a code right now. Please try again.';
+            setStatus(msg, 'error');
+            if (isResend) {
+              resendBtn.disabled = false;
+            }
+          })
+          .then(function () {
+            if (!isResend) sendBtn.disabled = false;
+          });
+      }
+
+      function showOtpStep() {
+        otpPhoneDisplay.textContent = formatPhone(state.phone);
+        phoneForm.hidden = true;
+        otpForm.hidden = false;
+        otpInput.value = '';
+        setFieldError(otpInput, otpError, '');
+        otpInput.focus();
+      }
+
+      function showPhoneStep() {
+        abortWebOtp();
+        clearInterval(resendTimer);
+        otpForm.hidden = true;
+        phoneForm.hidden = false;
+        setStatus('', '');
+        phoneInput.focus();
+      }
+
+      function submitCode() {
+        if (state.verifying) return;
+        var code = otpInput.value.replace(/\D/g, '');
+        if (code.length !== CODE_LENGTH) {
+          setFieldError(otpInput, otpError, 'Enter all ' + CODE_LENGTH + ' digits of the code.');
+          otpInput.focus();
+          return;
+        }
+        setFieldError(otpInput, otpError, '');
+        state.verifying = true;
+        verifyBtn.disabled = true;
+        otpInput.setAttribute('aria-busy', 'true');
+        setStatus('Verifying…', '');
+
+        postJSON(VERIFY_URL, { phone: state.phone, purpose: state.purpose, code: code })
+          .then(function (data) {
+            abortWebOtp();
+            clearInterval(resendTimer);
+            setStatus('You’re verified! Redirecting…', 'success');
+            var dest = (data && typeof data.redirect === 'string' && data.redirect.charAt(0) === '/' && data.redirect.charAt(1) !== '/')
+              ? data.redirect
+              : DESTINATIONS[state.purpose];
+            window.location.assign(dest);
+          })
+          .catch(function (err) {
+            var msg;
+            if (err.status === 400 || err.status === 401 || err.status === 422) {
+              msg = 'That code is incorrect or has expired. Check your text and try again.';
+            } else if (err.status === 429) {
+              msg = 'Too many attempts. Please request a new code later.';
+            } else {
+              msg = 'We couldn’t verify your code right now. Please try again.';
+            }
+            setFieldError(otpInput, otpError, msg);
+            setStatus('', '');
+            otpInput.select();
+            otpInput.focus();
+          })
+          .then(function () {
+            state.verifying = false;
+            verifyBtn.disabled = false;
+            otpInput.removeAttribute('aria-busy');
+          });
+      }
+
+      phoneForm.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var normalised = normalisePhone(phoneInput.value);
+        if (!normalised) {
+          setFieldError(phoneInput, phoneError, 'Enter a valid 10-digit US mobile number.');
+          phoneInput.focus();
+          return;
+        }
+        setFieldError(phoneInput, phoneError, '');
+        state.phone = normalised;
+        state.purpose = phoneForm.querySelector('input[name="purpose"]:checked').value;
+        sendCode(false);
+      });
+
+      // Keep only digits (handles pasted "123 456" / "123-456" or full message text).
+      otpInput.addEventListener('input', function () {
+        var digits = otpInput.value.replace(/\D/g, '').slice(0, CODE_LENGTH);
+        if (otpInput.value !== digits) otpInput.value = digits;
+        if (otpError.textContent) setFieldError(otpInput, otpError, '');
+        // Autofill (iOS / Android keyboard suggestion) fills all digits at once: auto-submit.
+        if (digits.length === CODE_LENGTH) submitCode();
+      });
+
+      otpInput.addEventListener('paste', function (e) {
+        var text = (e.clipboardData || window.clipboardData).getData('text') || '';
+        var match = text.match(/\b\d{6}\b/) || [text.replace(/\D/g, '')];
+        e.preventDefault();
+        otpInput.value = match[0].slice(0, CODE_LENGTH);
+        otpInput.dispatchEvent(new Event('input', { bubbles: true }));
+      });
+
+      otpForm.addEventListener('submit', function (e) {
+        e.preventDefault();
+        submitCode();
+      });
+
+      resendBtn.addEventListener('click', function () { sendCode(true); });
+      changePhoneBtn.addEventListener('click', showPhoneStep);
+
+      // Preselect purpose from links like /?signin=order or #verify-order
+      var params = new URLSearchParams(window.location.search);
+      var preset = params.get('signin') || (window.location.hash === '#verify-order' ? 'order' : null);
+      if (preset && DESTINATIONS[preset]) {
+        phoneForm.querySelector('input[name="purpose"][value="' + preset + '"]').checked = true;
+      }
+    })();
+  </script>
+
 </body>
 
