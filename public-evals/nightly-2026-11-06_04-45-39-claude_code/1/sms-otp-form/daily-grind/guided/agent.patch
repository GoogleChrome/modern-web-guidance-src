+  <script type="module">
+    /*
+     * SMS one-time passcode sign-in.
+     *
+     * Backend contract (assumed):
+     *   POST /auth/sms/send   { purpose, phone }        -> 2xx when a code has been texted
+     *   POST /auth/sms/verify { purpose, phone, otp }   -> 2xx JSON { redirect?: string }
+     *
+     * The outgoing SMS MUST end with an origin-bound line so WebOTP and
+     * iOS/macOS one-time-code autofill can match it to this site:
+     *
+     *   Your Daily Grind code is 123456.
+     *
+     *   @dailygrind.example #123456
+     */
+    const section = document.getElementById('sign-in');
+    const phoneForm = document.getElementById('phone-form');
+    const phoneInput = document.getElementById('phone-input');
+    const phoneError = document.getElementById('phone-error');
+    const sendBtn = document.getElementById('send-code-btn');
+
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const otpError = document.getElementById('otp-error');
+    const otpPurpose = document.getElementById('otp-purpose');
+    const otpPhone = document.getElementById('otp-phone');
+    const otpPhoneDisplay = document.getElementById('otp-phone-display');
+    const verifyBtn = document.getElementById('verify-btn');
+    const resendBtn = document.getElementById('resend-btn');
+    const changeNumberBtn = document.getElementById('change-number-btn');
+    const status = document.getElementById('verify-status');
+
+    const DESTINATIONS = { rewards: '/rewards', order: '/order-online' };
+
+    // Progressive enhancement: without JS both forms post normally.
+    otpForm.hidden = true;
+
+    function setStatus(message, tone = 'info') {
+      status.dataset.tone = tone;
+      status.textContent = message;
+    }
+
+    // ---- Field validation (show errors after interaction, clear while typing) ----
+    function validate(input, errorEl, message) {
+      const valid = input.checkValidity();
+      input.setAttribute('aria-invalid', String(!valid));
+      errorEl.textContent = valid ? '' : message(input);
+      return valid;
+    }
+
+    const phoneMessage = (el) => el.validity.valueMissing
+      ? 'Enter your mobile phone number.'
+      : 'Enter a valid phone number, including area code.';
+    const otpMessage = (el) => el.validity.valueMissing
+      ? 'Enter the 6-digit code from your text message.'
+      : 'The code must be exactly 6 digits.';
+
+    function wireValidation(input, errorEl, message) {
+      input.addEventListener('blur', () => {
+        if (input.value) validate(input, errorEl, message);
+      });
+      input.addEventListener('input', () => {
+        if (input.getAttribute('aria-invalid') === 'true') {
+          input.removeAttribute('aria-invalid');
+          errorEl.textContent = '';
+        }
+      });
+    }
+    wireValidation(phoneInput, phoneError, phoneMessage);
+    wireValidation(otpInput, otpError, otpMessage);
+
+    // Keep only digits in the OTP field (handles pasted "123 456" or "Code: 123456").
+    otpInput.addEventListener('input', () => {
+      const digits = otpInput.value.replace(/\D/g, '').slice(0, 6);
+      if (digits !== otpInput.value) otpInput.value = digits;
+    });
+
+    // ---- WebOTP: automatic code extraction from the incoming SMS ----
+    let otpAbortController = null;
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      if (!('OTPCredential' in window)) return; // falls back to autocomplete="one-time-code" / manual entry
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+      try {
+        const otp = await navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: ac.signal,
+        });
+        if (!otp || ac.signal.aborted) return;
+        otpInput.value = otp.code;
+        otpForm.requestSubmit();
+      } catch (err) {
+        if (err?.name === 'AbortError') return;
+        console.error('WebOTP verification error:', err);
+      }
+    }
+
+    // Stop listening if the user leaves the page.
+    window.addEventListener('pagehide', stopSmsOtpListener);
+
+    async function post(form) {
+      const response = await fetch(form.action, {
+        method: 'POST',
+        body: new FormData(form),
+        headers: { Accept: 'application/json' },
+        credentials: 'same-origin',
+      });
+      if (!response.ok) {
+        let message = '';
+        try { message = (await response.json()).message ?? ''; } catch { /* non-JSON */ }
+        const error = new Error(message);
+        error.status = response.status;
+        throw error;
+      }
+      return response;
+    }
+
+    // ---- Step 1: send the code ----
+    phoneForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!validate(phoneInput, phoneError, phoneMessage)) {
+        otpForm.hidden = true;
+        phoneForm.hidden = false;
+        phoneInput.focus();
+        return;
+      }
+
+      const isResend = event.submitter === resendBtn;
+      sendBtn.disabled = true;
+      resendBtn.disabled = true;
+      setStatus(isResend ? 'Sending a new code…' : 'Sending your code…');
+
+      try {
+        await post(phoneForm);
+        const purpose = new FormData(phoneForm).get('purpose');
+        otpPurpose.value = purpose;
+        otpPhone.value = phoneInput.value.trim();
+        otpPhoneDisplay.textContent = phoneInput.value.trim();
+
+        otpInput.value = '';
+        otpInput.removeAttribute('aria-invalid');
+        otpError.textContent = '';
+        phoneForm.hidden = true;
+        otpForm.hidden = false;
+        otpInput.focus();
+        setStatus(isResend ? 'A new code is on its way.' : 'Code sent! Check your text messages.', 'success');
+
+        startSmsOtpListener();
+      } catch (err) {
+        setStatus(err.message || 'We couldn’t send a code right now. Please try again.', 'error');
+      } finally {
+        sendBtn.disabled = false;
+        resendBtn.disabled = false;
+      }
+    });
+
+    changeNumberBtn.addEventListener('click', () => {
+      stopSmsOtpListener();
+      otpForm.hidden = true;
+      phoneForm.hidden = false;
+      setStatus('');
+      phoneInput.focus();
+      phoneInput.select();
+    });
+
+    // ---- Step 2: verify the code ----
+    otpForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      stopSmsOtpListener();
+
+      if (!validate(otpInput, otpError, otpMessage)) {
+        otpInput.focus();
+        return;
+      }
+
+      verifyBtn.disabled = true;
+      setStatus('Verifying…');
+
+      try {
+        const response = await post(otpForm);
+        let data = {};
+        try { data = await response.json(); } catch { /* empty body */ }
+        setStatus('You’re verified! Redirecting…', 'success');
+        window.location.assign(data.redirect || DESTINATIONS[otpPurpose.value] || '/');
+      } catch (err) {
+        verifyBtn.disabled = false;
+        otpInput.setAttribute('aria-invalid', 'true');
+        otpError.textContent = err.message || (err.status === 400 || err.status === 401
+          ? 'That code is incorrect or has expired. Check the code or request a new one.'
+          : 'We couldn’t verify your code right now. Please try again.');
+        setStatus('');
+        otpInput.focus();
+        otpInput.select();
+        // Keep listening in case the user requests/receives another SMS.
+        startSmsOtpListener();
+      }
+    });
+
+    // Deep link: /?signin=order or /?signin=rewards preselects the purpose and scrolls to the form.
+    const requested = new URLSearchParams(location.search).get('signin');
+    if (requested && DESTINATIONS[requested]) {
+      phoneForm.querySelector(`input[name="purpose"][value="${requested}"]`).checked = true;
+      section.scrollIntoView();
+    }
+  </script>
 </body>
 
