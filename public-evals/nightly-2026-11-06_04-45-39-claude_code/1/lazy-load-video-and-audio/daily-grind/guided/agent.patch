+  <script>
+    // Fallback for browsers without native loading="lazy" on <video>/<audio>:
+    // hold back poster and preload fetches until the player nears the viewport.
+    if (!Object.hasOwn(HTMLMediaElement.prototype, 'loading')) {
+      const mediaObserver = new IntersectionObserver((entries, observer) => {
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          const media = entry.target;
+          if (media.dataset.poster) {
+            media.poster = media.dataset.poster;
+            delete media.dataset.poster;
+          }
+          if (media.dataset.preload) {
+            media.preload = media.dataset.preload;
+            delete media.dataset.preload;
+          }
+          observer.unobserve(media);
+        }
+      }, { rootMargin: '200px 0px' });
+
+      for (const media of document.querySelectorAll('video[loading="lazy"], audio[loading="lazy"][controls]')) {
+        if (media.hasAttribute('poster')) {
+          media.dataset.poster = media.getAttribute('poster');
+          media.removeAttribute('poster');
+        }
+        const preload = media.getAttribute('preload');
+        if (preload && preload !== 'none') media.dataset.preload = preload;
+        media.preload = 'none';
+        mediaObserver.observe(media);
+      }
+    }
+
+    // Hero background video: respect reduced motion and offer a pause control.
+    const heroVideo = document.querySelector('.hero-video');
+    const heroToggle = document.querySelector('.hero-toggle');
+    const setHeroPlaying = (playing) => {
+      if (playing) heroVideo.play().catch(() => {}); else heroVideo.pause();
+      heroToggle.setAttribute('aria-pressed', String(!playing));
+      heroToggle.textContent = playing ? 'Pause background video' : 'Play background video';
+    };
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    if (reducedMotion.matches) {
+      heroVideo.removeAttribute('autoplay');
+      setHeroPlaying(false);
+    }
+    reducedMotion.addEventListener('change', (e) => setHeroPlaying(!e.matches));
+    heroToggle.addEventListener('click', () => setHeroPlaying(heroVideo.paused));
+  </script>
+
