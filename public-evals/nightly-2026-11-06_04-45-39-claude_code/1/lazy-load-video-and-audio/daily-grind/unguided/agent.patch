+  <script>
+    // Lazy-load offscreen <video>/<audio> players. Sources, posters, and the
+    // preload hint stay in data-* attributes until the player is near the
+    // viewport, so the browser doesn't fetch any media bytes up front.
+    (function () {
+      var players = document.querySelectorAll('[data-lazy-media]');
+
+      function hydrate(el) {
+        if (el.dataset.lazyLoaded) return;
+        el.dataset.lazyLoaded = 'true';
+
+        if (el.dataset.poster) el.setAttribute('poster', el.dataset.poster);
+
+        el.querySelectorAll('source[data-src]').forEach(function (source) {
+          source.src = source.dataset.src;
+          source.removeAttribute('data-src');
+        });
+
+        if (el.dataset.preload) el.preload = el.dataset.preload;
+        el.load();
+      }
+
+      // Hero video: don't autoplay motion for users who asked for less.
+      var hero = document.querySelector('.hero-video');
+      if (hero && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        hero.removeAttribute('autoplay');
+        hero.pause();
+      }
+
+      if (!('IntersectionObserver' in window)) {
+        players.forEach(hydrate);
+        return;
+      }
+
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (!entry.isIntersecting) return;
+          observer.unobserve(entry.target);
+          hydrate(entry.target);
+        });
+      }, { rootMargin: '300px 0px' });
+
+      players.forEach(function (el) {
+        observer.observe(el);
+      });
+    })();
+  </script>
