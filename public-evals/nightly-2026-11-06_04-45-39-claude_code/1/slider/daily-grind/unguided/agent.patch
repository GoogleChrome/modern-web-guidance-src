+  <script>
+    (function () {
+      var slider = document.getElementById('brew-strength');
+      var output = document.getElementById('brew-strength-output');
+      var description = document.getElementById('brew-strength-description');
+      if (!slider) return;
+
+      function describe(v) {
+        if (v <= 3) return ['Mild', 'light, bright, and easy-drinking.'];
+        if (v <= 7) return ['Balanced', 'smooth body with gentle sweetness.'];
+        return ['Bold', 'rich, intense, and full of dark-roast character.'];
+      }
+
+      function update() {
+        var v = Number(slider.value);
+        var d = describe(v);
+        slider.style.setProperty('--min', slider.min);
+        slider.style.setProperty('--max', slider.max);
+        slider.style.setProperty('--value', v);
+        slider.setAttribute('aria-valuetext', v + ' of ' + slider.max + ', ' + d[0]);
+        output.textContent = v + ' / ' + slider.max;
+        description.textContent = d[0] + ': ' + d[1];
+      }
+
+      slider.addEventListener('input', update);
+      update();
+    })();
+  </script>
