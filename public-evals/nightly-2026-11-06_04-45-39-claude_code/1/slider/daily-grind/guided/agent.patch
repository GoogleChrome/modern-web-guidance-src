+  <script>
+    (() => {
+      const slider = document.getElementById('brew-strength-slider');
+      const output = document.getElementById('brew-strength-value');
+      const labels = ['Mild', 'Smooth', 'Balanced', 'Bold', 'Intense'];
+
+      function syncSlider() {
+        const value = Number(slider.value);
+        const label = labels[value - 1] ?? '';
+        // Fill progress (WebKit/Blink have no ::-moz-range-progress equivalent).
+        slider.style.setProperty('--attr-min', slider.min || 0);
+        slider.style.setProperty('--attr-max', slider.max || 100);
+        slider.style.setProperty('--control-value', value);
+        output.textContent = `${value} – ${label}`;
+        slider.setAttribute('aria-valuetext', `${value} of ${slider.max}, ${label}`);
+      }
+
+      syncSlider();
+      slider.addEventListener('input', syncSlider);
+    })();
+  </script>
