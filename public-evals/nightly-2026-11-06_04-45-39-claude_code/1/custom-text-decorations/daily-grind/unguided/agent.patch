+    /* ==========================================================
+       Decorative text lines
+       Native CSS text decorations (ink-skipping, offset, inset)
+       with animated reveals. Custom properties are registered so
+       the browser can interpolate them smoothly.
+       ========================================================== */
+    @property --deco-offset {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0.2em;
+    }
+
+    @property --deco-thickness {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 1px;
+    }
+
+    @property --deco-inset {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --deco-color {
+      syntax: '<color>';
+      inherits: true;
+      initial-value: transparent;
+    }
+
+    .deco {
+      /* Shared defaults: every decorated element skips ink around
+         descenders (g, p, y, j…) so the line never cuts glyphs. */
+      text-decoration-line: underline;
+      text-decoration-color: var(--deco-color);
+      text-decoration-thickness: var(--deco-thickness);
+      text-underline-offset: var(--deco-offset);
+      text-decoration-skip-ink: auto;
+      text-decoration-skip: ink edges;
+      /* Horizontal end insets (CSS Text Decoration 4). Browsers
+         without support simply ignore this declaration. */
+      text-decoration-inset: var(--deco-inset);
+      transition:
+        --deco-color 0.35s ease,
+        --deco-offset 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
+        --deco-thickness 0.35s ease,
+        --deco-inset 0.45s cubic-bezier(0.22, 1, 0.36, 1),
+        color 0.3s;
+    }
+
+    /* --- Navigation: underline that drops into place and grows
+           outward from the centre (large inset -> small inset). --- */
+    nav a.deco {
