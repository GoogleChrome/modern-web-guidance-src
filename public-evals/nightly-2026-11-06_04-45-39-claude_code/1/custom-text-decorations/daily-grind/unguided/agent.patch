+      --deco-color: var(--accent);
+      --deco-offset: 0.18em;
+      --deco-thickness: 3px;
+      --deco-inset: 0.6em;
+      animation: deco-heading-reveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
+    }
+
+    @keyframes deco-heading-reveal {
+      from {
+        --deco-color: rgba(255, 171, 64, 0);
+        --deco-offset: 0.9em;
+        --deco-thickness: 0px;
+        --deco-inset: 3.5em;
+      }
+
+      to {
