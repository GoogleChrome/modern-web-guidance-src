+      --deco-inset: 1.5em;
+    }
+
+    nav a.logout-link.deco:hover,
+    nav a.logout-link.deco:focus-visible {
+      --deco-inset: 0.25em;
+      --deco-thickness: 1.5px;
+    }
+
+    /* --- Section heading: double underline + overline that reveal
