+      --deco-offset: 0.65em;
+      --deco-thickness: 1px;
+      --deco-inset: 2em;
+    }
+
+    nav a.deco:hover,
+    nav a.deco:focus-visible,
+    nav a.deco[aria-current="page"] {
+      --deco-color: var(--accent);
+      --deco-offset: 0.3em;
+      --deco-thickness: 2px;
