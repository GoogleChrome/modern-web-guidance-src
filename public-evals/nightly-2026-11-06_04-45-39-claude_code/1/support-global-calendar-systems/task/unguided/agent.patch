+  <script>
+    (function () {
+      'use strict';
+
+      // Each card lists calendar IDs in order of preference. Plain "islamic" is
+      // rejected by some Temporal implementations, so fall back to well-defined
+      // Islamic variants.
+      var CALENDARS = {
+        islamic: { ids: ['islamic', 'islamic-umalqura', 'islamic-civil'], nativeLocale: 'ar-SA' },
+        hebrew: { ids: ['hebrew'], nativeLocale: 'he-IL' },
+        japanese: { ids: ['japanese'], nativeLocale: 'ja-JP' }
+      };
+
+      var input = document.getElementById('calendar-date-input');
+      var todayBtn = document.getElementById('calendar-today-btn');
+      var errorEl = document.getElementById('calendar-error');
+
+      function escapeHtml(value) {
+        return String(value).replace(/[&<>"']/g, function (c) {
+          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
+        });
+      }
+
+      function showError(message) {
+        errorEl.textContent = message;
+        errorEl.hidden = !message;
+      }
+
+      function resolveCalendarId(ids) {
+        var probe = Temporal.PlainDate.from('2000-01-01');
+        for (var i = 0; i < ids.length; i++) {
+          try {
+            probe.withCalendar(ids[i]);
+            return ids[i];
+          } catch (e) { /* try next */ }
+        }
+        return null;
+      }
+
+      // Format a Temporal.PlainDate (any calendar) with Intl in the given calendar.
+      function formatDate(plainDate, locale, calendarId, options) {
+        var iso = plainDate.withCalendar('iso8601');
+        var jsDate = new Date(Date.UTC(2000, 0, 1));
+        jsDate.setUTCFullYear(iso.year, iso.month - 1, iso.day);
+        var opts = Object.assign({ calendar: calendarId, timeZone: 'UTC' }, options);
+        return new Intl.DateTimeFormat(locale, opts).format(jsDate);
+      }
+
+      function getRelation(isoDate) {
+        var today = Temporal.Now.plainDateISO();
+        var cmp = Temporal.PlainDate.compare(isoDate, today);
+        return cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+      }
+
+      function buildMonths(date, calendarId) {
+        var months = [];
+        for (var m = 1; m <= date.monthsInYear; m++) {
+          var first = Temporal.PlainDate.from({ calendar: calendarId, year: date.year, month: m, day: 1 });
+          var name;
+          try {
+            name = formatDate(first, 'en-US', calendarId, { month: 'long' });
+          } catch (e) {
+            name = first.monthCode;
+          }
+          months.push({ month: m, monthCode: first.monthCode, name: name, days: first.daysInMonth });
+        }
+        return months;
+      }
+
+      function renderCard(key, isoDate, relation) {
+        var config = CALENDARS[key];
+        var card = document.querySelector('[data-calendar="' + key + '"]');
+        var body = card.querySelector('.calendar-body');
+        var calendarId = config.resolvedId;
+
+        if (!calendarId) {
+          body.innerHTML = '<p class="calendar-error">This calendar is not supported by your browser.</p>';
+          return;
+        }
+
+        var date = isoDate.withCalendar(calendarId);
+        var localizedEn = formatDate(date, 'en-US', calendarId, {
+          era: key === 'japanese' ? 'long' : 'short', year: 'numeric', month: 'long', day: 'numeric'
+        });
+        var localizedNative = formatDate(date, config.nativeLocale, calendarId, {
+          era: 'long', year: 'numeric', month: 'long', day: 'numeric'
+        });
+        var months = buildMonths(date, calendarId);
+        var eraText = date.era ? date.era.charAt(0).toUpperCase() + date.era.slice(1) + ' ' + date.eraYear : '';
+
+        card.setAttribute('data-calendar-id', calendarId);
+        card.setAttribute('data-relation', relation.toLowerCase());
+
+        var html = '';
+        html += '<p class="localized" data-field="localized">' + escapeHtml(localizedEn) + '</p>';
+        html += '<p class="localized-native" data-field="localized-native" lang="' + escapeHtml(config.nativeLocale) + '">' +
+          escapeHtml(localizedNative) + '</p>';
+        html += '<dl>';
+        html += '<dt>Calendar</dt><dd data-field="calendar">' + escapeHtml(calendarId) + '</dd>';
+        if (eraText) {
+          html += '<dt>Era</dt><dd data-field="era">' + escapeHtml(eraText) + '</dd>';
+        }
+        html += '<dt>Year</dt><dd data-field="year">' + date.year + '</dd>';
+        html += '<dt>Month</dt><dd data-field="month">' + date.month + '</dd>';
+        html += '<dt>Month code</dt><dd data-field="month-code">' + escapeHtml(date.monthCode) + '</dd>';
+        html += '<dt>Day</dt><dd data-field="day">' + date.day + '</dd>';
+        html += '<dt>Months in year</dt><dd data-field="months-in-year">' + date.monthsInYear + '</dd>';
+        html += '<dt>Status</dt><dd><span class="relation relation-' + relation.toLowerCase() +
+          '" data-field="relation">' + relation + '</span></dd>';
+        html += '</dl>';
+        html += '<table class="month-table" data-field="months"><caption class="visually-hidden">Months of ' +
+          escapeHtml(calendarId) + ' year ' + date.year + '</caption>';
+        html += '<thead><tr><th>#</th><th>Month</th><th>Code</th><th>Days</th></tr></thead><tbody>';
+        months.forEach(function (mo) {
+          html += '<tr' + (mo.month === date.month ? ' class="current-month"' : '') +
+            ' data-month-code="' + escapeHtml(mo.monthCode) + '">' +
+            '<td>' + mo.month + '</td><td>' + escapeHtml(mo.name) + '</td>' +
+            '<td>' + escapeHtml(mo.monthCode) + '</td><td>' + mo.days + '</td></tr>';
+        });
+        html += '</tbody></table>';
+        body.innerHTML = html;
+      }
+
+      function render() {
+        if (!input.value) {
+          showError('Please choose a date.');
+          return;
+        }
+        var isoDate;
+        try {
+          isoDate = Temporal.PlainDate.from(input.value);
+        } catch (e) {
+          showError('That date could not be read. Please choose another date.');
+          return;
+        }
+        try {
+          var relation = getRelation(isoDate);
+          Object.keys(CALENDARS).forEach(function (key) {
+            renderCard(key, isoDate, relation);
+          });
+          showError('');
+        } catch (e) {
+          showError('That date is outside the supported range. Please choose another date.');
+        }
+      }
+
+      function init() {
+        if (typeof Temporal === 'undefined') {
+          showError('Calendar conversion is unavailable in this browser.');
+          return;
+        }
+        Object.keys(CALENDARS).forEach(function (key) {
+          CALENDARS[key].resolvedId = resolveCalendarId(CALENDARS[key].ids);
+        });
+        if (!input.value) {
+          input.value = Temporal.Now.plainDateISO().toString();
+        }
+        input.addEventListener('input', render);
+        input.addEventListener('change', render);
+        todayBtn.addEventListener('click', function () {
+          input.value = Temporal.Now.plainDateISO().toString();
+          render();
+        });
+        render();
+      }
+
+      // Use native Temporal when present; otherwise load the vendored polyfill.
+      if (typeof Temporal !== 'undefined') {
+        init();
+      } else {
+        var script = document.createElement('script');
+        script.src = '/vendor/temporal-polyfill.js';
+        script.onload = init;
+        script.onerror = function () {
+          showError('Calendar conversion is unavailable right now. Please try again later.');
+        };
+        document.head.appendChild(script);
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
