+  <script type="module">
+    // Load the Temporal polyfill only when the browser lacks native support.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const supportedCalendars = (() => {
+      try {
+        return new Set(Intl.supportedValuesOf('calendar'));
+      } catch {
+        return new Set();
+      }
+    })();
+
+    // Resolve a usable calendar id, trying preferred variants in order.
+    function resolveCalendar(candidates) {
+      for (const id of candidates) {
+        if (supportedCalendars.size && !supportedCalendars.has(id)) continue;
+        try {
+          Temporal.PlainDate.from('2000-01-01').withCalendar(id);
+          return id;
+        } catch {
+          // Not supported by this Temporal implementation; try the next one.
+        }
+      }
+      return null;
+    }
+
+    const CALENDARS = {
+      islamic: resolveCalendar(['islamic-umalqura', 'islamic-civil', 'islamic-tbla', 'islamic']),
+      hebrew: resolveCalendar(['hebrew']),
+      japanese: resolveCalendar(['japanese']),
+    };
+
+    const input = document.getElementById('calendar-date-input');
+    const status = document.getElementById('calendar-status');
+
+    function el(tag, props = {}, children = []) {
+      const node = Object.assign(document.createElement(tag), props);
+      node.append(...children);
+      return node;
+    }
+
+    function renderCard(card, isoDate, todayISO) {
+      const key = card.dataset.calendar;
+      const calendarId = CALENDARS[key];
+      const output = card.querySelector('.calendar-output');
+
+      if (!calendarId) {
+        output.replaceChildren(`The ${key} calendar isn't supported in this browser.`);
+        return;
+      }
+
+      const date = isoDate.withCalendar(calendarId);
+      const today = todayISO.withCalendar(calendarId);
+      const locale = `en-u-ca-${calendarId}`;
+
+      const localized = date.toLocaleString(locale, {
+        year: 'numeric',
+        month: 'long',
+        day: 'numeric',
+        ...(key === 'japanese' ? { era: 'long' } : {}),
+      });
+
+      const comparison = Temporal.PlainDate.compare(date, today);
+      const timeline = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+
+      const yearText = date.era && date.eraYear !== undefined && key === 'japanese'
+        ? `${date.year} (${date.era} ${date.eraYear})`
+        : String(date.year);
+
+      const facts = [
+        ['Year', yearText],
+        ['Month', String(date.month)],
+        ['Month code', date.monthCode],
+        ['Months in year', String(date.monthsInYear)],
+        ['Timeline', el('span', { className: 'timeline-badge', textContent: timeline }, [])],
+      ];
+
+      const dl = el('dl');
+      for (const [term, value] of facts) {
+        dl.append(el('dt', { textContent: term }), el('dd', {}, [value]));
+      }
+      dl.querySelector('.timeline-badge').dataset.timeline = timeline;
+
+      // Month breakdown: never assume 12 months or fixed month lengths.
+      const tbody = el('tbody');
+      for (let m = 1; m <= date.monthsInYear; m++) {
+        const monthDate = date.with({ month: m, day: 1 });
+        const row = el('tr', {}, [
+          el('td', { textContent: String(m) }),
+          el('td', { textContent: monthDate.toLocaleString(locale, { month: 'long' }) }),
+          el('td', { textContent: monthDate.monthCode }),
+          el('td', { textContent: String(monthDate.daysInMonth) }),
+        ]);
+        if (m === date.month) {
+          row.className = 'current';
+          row.setAttribute('aria-current', 'date');
+        }
+        tbody.append(row);
+      }
+
+      const table = el('table', { className: 'month-table' }, [
+        el('thead', {}, [el('tr', {}, ['#', 'Month', 'Code', 'Days'].map((h) => el('th', { scope: 'col', textContent: h })))]),
+        tbody,
+      ]);
+      table.setAttribute('aria-label', `Months of ${key} year ${yearText}`);
+
+      const details = el('details', { open: true }, [
+        el('summary', { textContent: `Months in this year (${date.monthsInYear})` }),
+        table,
+      ]);
+
+      output.replaceChildren(
+        el('p', { className: 'localized', textContent: localized }),
+        dl,
+        details,
+      );
+    }
+
+    function update() {
+      let isoDate;
+      try {
+        isoDate = Temporal.PlainDate.from(input.value);
+      } catch {
+        status.textContent = 'Please choose a valid date.';
+        return;
+      }
+      status.textContent = '';
+      const todayISO = Temporal.Now.plainDateISO();
+      for (const card of document.querySelectorAll('.calendar-card')) {
+        try {
+          renderCard(card, isoDate, todayISO);
+        } catch (err) {
+          card.querySelector('.calendar-output').replaceChildren('Unable to convert this date.');
+          console.error(err);
+        }
+      }
+    }
+
+    input.value = Temporal.Now.plainDateISO().toString();
+    input.addEventListener('input', update);
+    document.getElementById('calendar-form').addEventListener('submit', (e) => e.preventDefault());
+    update();
+  </script>
+
 </body>
 
