+  <script>
+    (function () {
+      var iframe = document.getElementById('roast-video');
+      var mainSlot = document.getElementById('main-video-slot');
+      var heroSlot = document.getElementById('hero-video-slot');
+      var hero = document.querySelector('.hero');
+      var toggle = document.getElementById('theater-toggle');
+      var theater = false;
+
+      // Element.prototype.moveBefore() performs an atomic, state-preserving move:
+      // the iframe keeps its browsing context, so the video doesn't reload or stop.
+      var supportsAtomicMove = typeof Element.prototype.moveBefore === 'function';
+
+      // ---- Fallback for browsers without moveBefore() ----------------------
+      // A classic DOM move (appendChild/insertBefore) detaches the iframe, which
+      // destroys and reloads it. To compensate we track playback through the
+      // YouTube IFrame API and, on move, reload the embed at the same timestamp
+      // (auto-resuming if it was playing).
+      var player = null;
+      var lastTime = 0;
+      var wasPlaying = false;
+
+      function attachPlayer() {
+        if (!window.YT || !window.YT.Player) return;
+        player = new YT.Player(iframe, {
+          events: {
+            onStateChange: function (e) {
+              wasPlaying = e.data === YT.PlayerState.PLAYING ||
+                e.data === YT.PlayerState.BUFFERING;
+            }
+          }
+        });
+      }
+
+      function snapshotPlayback() {
+        if (player && typeof player.getCurrentTime === 'function') {
+          try {
+            lastTime = player.getCurrentTime() || 0;
+            var state = player.getPlayerState();
+            wasPlaying = state === YT.PlayerState.PLAYING ||
+              state === YT.PlayerState.BUFFERING;
+          } catch (err) { /* player not ready yet; keep last known values */ }
+        }
+      }
+
+      function srcAt(seconds, autoplay) {
+        var url = new URL(iframe.src, location.href);
+        url.searchParams.set('enablejsapi', '1');
+        url.searchParams.set('origin', location.origin);
+        url.searchParams.delete('autoplay');
+        url.searchParams.delete('start');
+        if (seconds >= 1) url.searchParams.set('start', String(Math.floor(seconds)));
+        if (autoplay) url.searchParams.set('autoplay', '1');
+        return url.toString();
+      }
+
+      function fallbackMove(target) {
+        snapshotPlayback();
+        // Detach first so updating src and reinserting triggers a single load.
+        iframe.parentNode.removeChild(iframe);
+        if (lastTime > 0 || wasPlaying) iframe.src = srcAt(lastTime, wasPlaying);
+        target.appendChild(iframe);
+        // The old player's message channel died with the old document. (Don't
+        // call destroy(): it would remove our iframe.) Re-attach once loaded.
+        player = null;
+        iframe.addEventListener('load', function onLoad() {
+          iframe.removeEventListener('load', onLoad);
+          attachPlayer();
+        });
+      }
+
+      var apiRequested = false;
+      function loadYouTubeApi() {
+        if (apiRequested) return;
+        apiRequested = true;
+        var prev = window.onYouTubeIframeAPIReady;
+        window.onYouTubeIframeAPIReady = function () {
+          if (typeof prev === 'function') prev();
+          attachPlayer();
+        };
+        var tag = document.createElement('script');
+        tag.src = 'https://www.youtube.com/iframe_api';
+        tag.async = true;
+        document.head.appendChild(tag);
+      }
+
+      if (!supportsAtomicMove) {
+        // Ensure the embed talks to the API with our origin before tracking it.
+        iframe.src = srcAt(0, false);
+        loadYouTubeApi();
+      }
+
+      // ---- Reparenting -----------------------------------------------------
+      function moveIframe(target) {
+        if (iframe.parentNode === target) return;
+        if (supportsAtomicMove) {
+          try {
+            target.moveBefore(iframe, null);
+            return;
+          } catch (err) {
+            // moveBefore can throw (e.g. a disconnected parent); fall through.
+            console.warn('moveBefore failed, using fallback move:', err);
+            loadYouTubeApi();
+          }
+        }
+        fallbackMove(target);
+      }
+
+      function setTheater(on) {
+        theater = on;
+        hero.classList.toggle('theater', on);
+        moveIframe(on ? heroSlot : mainSlot);
+        mainSlot.classList.toggle('is-empty', on);
+        toggle.setAttribute('aria-pressed', String(on));
+        toggle.textContent = on ? 'Exit Theater Mode' : 'Theater Mode';
+        if (on) hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
+      }
+
+      toggle.addEventListener('click', function () {
+        setTheater(!theater);
+      });
+
+      // Escape exits theater mode.
+      document.addEventListener('keydown', function (e) {
+        if (theater && e.key === 'Escape') setTheater(false);
+      });
+    })();
+  </script>
