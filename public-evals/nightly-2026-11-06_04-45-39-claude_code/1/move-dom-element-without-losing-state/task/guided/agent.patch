+  <script>
+    (() => {
+      const hero = document.querySelector('.hero');
+      const home = document.getElementById('video-home');
+      const player = document.getElementById('video-player');
+      const iframe = document.getElementById('roast-video');
+      const toggle = document.getElementById('theater-toggle');
+      const note = document.getElementById('theater-note');
+      const status = document.getElementById('theater-status');
+
+      // moveBefore() performs an atomic, state-preserving move: the iframe keeps
+      // its browsing context, so playback continues without a reload.
+      const supportsMoveBefore = 'moveBefore' in Element.prototype;
+
+      // --- Fallback for browsers without moveBefore() -----------------------
+      // A classic insertBefore() detaches the iframe, which reloads it. To keep
+      // the viewer's place, we track the player's position via the YouTube
+      // IFrame postMessage API and resume from there after the move.
+      const playback = { time: 0, playing: false };
+      let playerOrigin = null;
+
+      if (!supportsMoveBefore) {
+        const url = new URL(iframe.src);
+        playerOrigin = url.origin;
+        url.searchParams.set('enablejsapi', '1');
+        url.searchParams.set('origin', location.origin);
+        iframe.src = url.href;
+
+        const listen = () => {
+          iframe.contentWindow?.postMessage(
+            JSON.stringify({ event: 'listening', id: iframe.id, channel: 'widget' }),
+            playerOrigin
+          );
+        };
+        iframe.addEventListener('load', listen);
+
+        window.addEventListener('message', (event) => {
+          if (event.origin !== playerOrigin || event.source !== iframe.contentWindow) return;
+          let data;
+          try {
+            data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
+          } catch {
+            return;
+          }
+          const info = data?.info;
+          if (data?.event === 'onStateChange' && typeof info === 'number') {
+            playback.playing = info === 1 || info === 3; // playing / buffering
+          } else if (info && typeof info === 'object') {
+            if (typeof info.currentTime === 'number') playback.time = info.currentTime;
+            if (typeof info.playerState === 'number') {
+              playback.playing = info.playerState === 1 || info.playerState === 3;
+            }
+          }
+        });
+      }
+
+      const resumeSrc = () => {
+        const url = new URL(iframe.src);
+        const start = Math.floor(playback.time);
+        if (start > 0) url.searchParams.set('start', String(start));
+        else url.searchParams.delete('start');
+        if (playback.playing) url.searchParams.set('autoplay', '1');
+        else url.searchParams.delete('autoplay');
+        return url.href;
+      };
+
+      const movePlayer = (parent, before = null) => {
+        if (supportsMoveBefore) {
+          parent.moveBefore(player, before);
+          return;
+        }
+        // Detach first and update src while disconnected, so the iframe only
+        // loads once (at the resume point) when it is re-inserted.
+        const hadFocus = player.contains(document.activeElement);
+        const nextSrc = resumeSrc();
+        player.remove();
+        iframe.src = nextSrc;
+        parent.insertBefore(player, before);
+        // A classic move drops focus to <body>; restore it on the toggle.
+        if (hadFocus) toggle.focus();
+      };
+
+      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      toggle.addEventListener('click', () => {
+        const enteringTheater = toggle.getAttribute('aria-pressed') !== 'true';
+
+        if (enteringTheater) {
+          movePlayer(hero, null);
+        } else {
+          movePlayer(home, null);
+        }
+
+        hero.classList.toggle('is-theater', enteringTheater);
+        note.hidden = !enteringTheater;
+        toggle.setAttribute('aria-pressed', String(enteringTheater));
+        status.textContent = enteringTheater
+          ? 'Video moved to theater mode at the top of the page.'
+          : 'Video returned to its original position.';
+
+        player.scrollIntoView({
+          behavior: prefersReducedMotion.matches ? 'auto' : 'smooth',
+          block: 'center',
+        });
+      });
+    })();
+  </script>
