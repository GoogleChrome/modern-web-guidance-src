+  <script>
+    (function () {
+      var toggle = document.getElementById('accordion-toggle');
+      var accordion = toggle.closest('.accordion');
+      var content = accordion.querySelector('.accordion-content');
+      var supportsCalcSize = window.CSS && CSS.supports('block-size', 'calc-size(auto, size)');
+
+      toggle.addEventListener('click', function () {
+        var open = !accordion.classList.contains('is-open');
+        accordion.classList.toggle('is-open', open);
+        toggle.setAttribute('aria-expanded', String(open));
+
+        // Fallback for browsers without calc-size(): animate to measured height + 2rem.
+        if (!supportsCalcSize) {
+          content.style.blockSize = open ? 'calc(' + content.scrollHeight + 'px + 2rem)' : '';
+        }
+      });
+    })();
+  </script>
