+
+    #accordion-toggle[aria-expanded="true"] .accordion-icon {
+      rotate: 45deg;
+    }
+
+    /*
+      NOTE: Directly transitioning between different intrinsic keyword sizes
+      (e.g. from min-content to max-content, or auto to fit-content) isn't
+      supported. Even with interpolate-size: allow-keywords or calc-size(),
+      only one side of the transition may be an intrinsic size keyword; the
+      other must be a definite <length-percentage> such as 0. That's why the
+      collapsed state uses block-size: 0 rather than another keyword.
+    */
+    .accordion-content {
+      block-size: 0;
+      overflow: hidden;
+      visibility: hidden;
+      transition:
+        block-size 0.4s ease,
+        visibility 0.4s allow-discrete;
+    }
+
+    .accordion.is-open .accordion-content {
+      /* Natural height plus 2rem of breathing room */
+      block-size: calc-size(auto, size + 2rem);
+      visibility: visible;
+    }
+
+    .accordion-inner {
+      padding: 20px;
+    }
+
+    .accordion-inner h3 {
+      color: var(--primary);
+      margin-block: 10px 5px;
+    }
+
+    .accordion-inner h3:first-child {
+      margin-block-start: 0;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .accordion-content,
+      .accordion-icon {
+        transition: none;
+      }
+    }
