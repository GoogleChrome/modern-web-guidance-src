+  <div class="toast" role="status" aria-live="polite"></div>
+
+  <script>
+    (function () {
+      const DRAG_START = 8;   // px moved before a gesture counts as a swipe
+      const OPEN_RATIO = 0.4; // fraction of the action width needed to snap open
+      const cards = Array.from(document.querySelectorAll('.swipe-card'));
+      const toast = document.querySelector('.toast');
+      let toastTimer;
+
+      function showToast(msg) {
+        toast.textContent = msg;
+        toast.classList.add('show');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => toast.classList.remove('show'), 2200);
+      }
+
+      function setupCard(card) {
+        const content = card.querySelector('.swipe-content');
+        const leftPanel = card.querySelector('.swipe-actions-left');
+        const rightPanel = card.querySelector('.swipe-actions-right');
+        const toggle = card.querySelector('.swipe-toggle');
+        const name = card.dataset.name;
+        const favKey = 'fav:' + card.dataset.drink;
+
+        let offset = 0;       // current resting offset (0, +leftWidth, -rightWidth)
+        let startX = 0, startY = 0, baseOffset = 0;
+        let tracking = false, dragging = false, suppressClick = false, pointerId = null;
+
+        const leftWidth = () => leftPanel.offsetWidth;
+        const rightWidth = () => rightPanel.offsetWidth;
+
+        function setActionsFocusable(panel, enabled) {
+          panel.querySelectorAll('.swipe-action').forEach((el) => {
+            el.tabIndex = enabled ? 0 : -1;
+          });
+          panel.setAttribute('aria-hidden', String(!enabled));
+        }
+
+        function apply(x) {
+          content.style.transform = 'translateX(' + x + 'px)';
+        }
+
+        // Snap to a resting state. Never triggers an action.
+        function settle(x) {
+          offset = x;
+          apply(x);
+          const open = x !== 0;
+          card.classList.toggle('is-open', open);
+          toggle.setAttribute('aria-expanded', String(open));
+          setActionsFocusable(leftPanel, x > 0);
+          setActionsFocusable(rightPanel, x < 0);
+          if (open) closeOthers(card);
+        }
+
+        card.close = () => settle(0);
+        card.isOpen = () => offset !== 0;
+
+        content.addEventListener('pointerdown', (e) => {
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          tracking = true;
+          dragging = false;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          baseOffset = offset;
+        });
+
+        content.addEventListener('pointermove', (e) => {
+          if (!tracking || e.pointerId !== pointerId) return;
+          const dx = e.clientX - startX;
+          const dy = e.clientY - startY;
+          if (!dragging) {
+            if (Math.abs(dy) > DRAG_START && Math.abs(dy) > Math.abs(dx)) {
+              tracking = false; // vertical scroll; let the page handle it
+              return;
+            }
+            if (Math.abs(dx) < DRAG_START) return;
+            dragging = true;
+            card.classList.add('dragging');
+            content.setPointerCapture(pointerId);
+          }
+          // Clamp so the drag can never go past the revealed buttons
+          // (no "full swipe to execute" behavior).
+          const x = Math.max(-rightWidth(), Math.min(leftWidth(), baseOffset + dx));
+          apply(x);
+          offset = x;
+        });
+
+        function endDrag(e) {
+          if (!tracking || (e && e.pointerId !== pointerId)) return;
+          tracking = false;
+          if (!dragging) return;
+          dragging = false;
+          suppressClick = true; // a drag should not count as a tap on the card's links
+          card.classList.remove('dragging');
+          const x = offset;
+          // Snap open once dragged past the threshold; snap closed otherwise.
+          // When starting from an already-open state, a shorter drag back closes it.
+          if (x > 0) {
+            const w = leftWidth();
+            const threshold = baseOffset > 0 ? w * (1 - OPEN_RATIO) : w * OPEN_RATIO;
+            settle(x >= threshold ? w : 0);
+          } else if (x < 0) {
+            const w = rightWidth();
+            const threshold = baseOffset < 0 ? w * (1 - OPEN_RATIO) : w * OPEN_RATIO;
+            settle(-x >= threshold ? -w : 0);
+          } else {
+            settle(0);
+          }
+        }
+
+        content.addEventListener('pointerup', endDrag);
+        content.addEventListener('pointercancel', endDrag);
+        content.addEventListener('lostpointercapture', endDrag);
+
+        // Swallow the click that follows a drag; a tap on an open card just closes it.
+        content.addEventListener('click', (e) => {
+          if (suppressClick) {
+            suppressClick = false;
+            e.preventDefault();
+            e.stopPropagation();
+            return;
+          }
+          if (offset !== 0 && !e.target.closest('.swipe-toggle')) {
+            e.preventDefault();
+            settle(0);
+          }
+        }, true);
+
+        content.addEventListener('dragstart', (e) => e.preventDefault());
+
+        // Keyboard / mouse alternative to swiping: reveal the primary (right-side) actions.
+        toggle.addEventListener('click', (e) => {
+          e.stopPropagation();
+          if (offset !== 0) {
+            settle(0);
+          } else {
+            settle(-rightWidth());
+            rightPanel.querySelector('.swipe-action').focus();
+          }
+        });
+
+        card.addEventListener('keydown', (e) => {
+          if (e.key === 'Escape' && offset !== 0) {
+            settle(0);
+            toggle.focus();
+          }
+        });
+
+        // Actions only run when explicitly tapped.
+        const favBtn = card.querySelector('[data-action="favorite"]');
+        function renderFavorite(on) {
+          favBtn.setAttribute('aria-pressed', String(on));
+          favBtn.querySelector('.label').textContent = on ? 'Unfavorite' : 'Favorite';
+          card.classList.toggle('is-favorite', on);
+        }
+        let isFav = false;
+        try { isFav = localStorage.getItem(favKey) === '1'; } catch (_) {}
+        renderFavorite(isFav);
+
+        favBtn.addEventListener('click', () => {
+          isFav = !isFav;
+          try { localStorage.setItem(favKey, isFav ? '1' : '0'); } catch (_) {}
+          renderFavorite(isFav);
+          showToast(isFav ? name + ' added to favorites' : name + ' removed from favorites');
+          settle(0);
+          toggle.focus();
+        });
+
+        settle(0);
+      }
+
+      function closeOthers(except) {
+        cards.forEach((c) => { if (c !== except && c.isOpen && c.isOpen()) c.close(); });
+      }
+
+      cards.forEach(setupCard);
+
+      // Tapping anywhere outside an open card closes it.
+      document.addEventListener('pointerdown', (e) => {
+        if (!e.target.closest('.swipe-card')) closeOthers(null);
+      });
+
+      window.addEventListener('resize', () => closeOthers(null));
+    })();
+  </script>
+
 </body>
 
