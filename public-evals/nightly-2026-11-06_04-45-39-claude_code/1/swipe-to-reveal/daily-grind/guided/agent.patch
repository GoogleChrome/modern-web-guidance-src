+    /* Swipe-to-reveal drink cards */
+    .SwipeReveal {
+      display: grid;
+      grid-template-columns: 100% max-content;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      overscroll-behavior: chain;
+      padding: 0;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+      background: white;
+      padding: 20px;
+    }
+
+    .SwipeReveal-panel {
+      scroll-snap-align: end;
+      display: flex;
+    }
+
+    .SwipeReveal-panel > * {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      gap: 4px;
+      min-width: 84px;
+      padding: 0 12px;
+      border: 0;
+      font: inherit;
+      font-size: 0.85rem;
+      font-weight: 600;
+      color: white;
+      text-decoration: none;
+      cursor: pointer;
+    }
+
+    .SwipeReveal-panel > :focus-visible {
+      outline: 3px solid var(--text);
+      outline-offset: -3px;
+    }
+
+    .action-icon {
+      font-size: 1.4rem;
+      line-height: 1;
+    }
+
+    .action-order { background: var(--primary); }
+    .action-favorite { background: var(--accent); color: var(--text); }
+    .action-favorite[aria-pressed="true"] { background: #e65100; color: white; }
+    .action-share { background: #6d4c41; }
+
+    .swipe-hint {
+      display: block;
+      margin-top: 12px;
+      font-size: 0.75rem;
+      color: #8d6e63;
+    }
+
