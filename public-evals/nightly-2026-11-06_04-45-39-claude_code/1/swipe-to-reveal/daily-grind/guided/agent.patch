+  <script>
+    // Snap the card back to its content when keyboard focus returns to it.
+    for (const content of document.querySelectorAll('.SwipeReveal-content')) {
+      content.addEventListener('focusin', (event) => {
+        if (event.target.matches(':focus-visible')) {
+          content.scrollIntoView({ block: 'nearest', inline: 'start' });
+        }
+      });
+    }
+
+    // Favorite toggle (persisted locally).
+    const favKey = 'dailyGrindFavorites';
+    const favorites = new Set(JSON.parse(localStorage.getItem(favKey) || '[]'));
+    for (const btn of document.querySelectorAll('.action-favorite')) {
+      const render = () => {
+        const on = favorites.has(btn.dataset.drink);
+        btn.setAttribute('aria-pressed', String(on));
+        btn.querySelector('.action-icon').textContent = on ? '\u2605' : '\u2606';
+      };
+      render();
+      btn.addEventListener('click', () => {
+        const id = btn.dataset.drink;
+        favorites.has(id) ? favorites.delete(id) : favorites.add(id);
+        localStorage.setItem(favKey, JSON.stringify([...favorites]));
+        render();
+      });
+    }
+
+    // Share via Web Share API, falling back to copying the link.
+    for (const btn of document.querySelectorAll('.action-share')) {
+      btn.addEventListener('click', async () => {
+        const url = new URL(btn.dataset.href, location.href).href;
+        const label = btn.lastChild;
+        try {
+          if (navigator.share) {
+            await navigator.share({ title: btn.dataset.name, url });
+          } else {
+            await navigator.clipboard.writeText(url);
+            label.textContent = 'Copied!';
+            setTimeout(() => { label.textContent = 'Share'; }, 1500);
+          }
+        } catch { /* user cancelled */ }
+      });
+    }
+  </script>
