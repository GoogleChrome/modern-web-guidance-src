+  <script>
+    (() => {
+      const input = document.getElementById('search-input');
+      const grid = document.getElementById('menu-grid');
+      const supportsHighlights = 'highlights' in CSS && typeof Highlight === 'function';
+      const HIGHLIGHT_NAME = 'menu-search';
+
+      // Collect text nodes inside the menu cards (skip whitespace-only nodes).
+      const getTextNodes = () => {
+        const nodes = [];
+        const walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT, {
+          acceptNode: (n) => (n.nodeValue.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT),
+        });
+        for (let n = walker.nextNode(); n; n = walker.nextNode()) nodes.push(n);
+        return nodes;
+      };
+
+      // Yields [start, end] offsets of every case-insensitive match of term in text.
+      function* findMatches(text, term) {
+        const haystack = text.toLowerCase();
+        let pos = haystack.indexOf(term);
+        while (pos !== -1) {
+          yield [pos, pos + term.length];
+          pos = haystack.indexOf(term, pos + term.length);
+        }
+      }
+
+      // Text nodes are cached; the DOM is never modified in the Highlight API path.
+      const cachedNodes = supportsHighlights ? getTextNodes() : null;
+
+      const highlightWithApi = (term) => {
+        CSS.highlights.delete(HIGHLIGHT_NAME);
+        if (!term) return;
+        const ranges = [];
+        for (const node of cachedNodes) {
+          for (const [start, end] of findMatches(node.nodeValue, term)) {
+            const range = new Range();
+            range.setStart(node, start);
+            range.setEnd(node, end);
+            ranges.push(range);
+          }
+        }
+        if (ranges.length) CSS.highlights.set(HIGHLIGHT_NAME, new Highlight(...ranges));
+      };
+
+      const clearMarks = () => {
+        const parents = new Set();
+        for (const mark of grid.querySelectorAll('mark.menu-search-match')) {
+          parents.add(mark.parentNode);
+          mark.replaceWith(mark.textContent);
+        }
+        // Merge adjacent text nodes back together so later searches match across old split points.
+        parents.forEach((p) => p.normalize());
+      };
+
+      const highlightWithMarks = (term) => {
+        clearMarks();
+        if (!term) return;
+        for (const node of getTextNodes()) {
+          const text = node.nodeValue;
+          const matches = [...findMatches(text, term)];
+          if (!matches.length) continue;
+          const frag = document.createDocumentFragment();
+          let last = 0;
+          for (const [start, end] of matches) {
+            frag.append(text.slice(last, start));
+            const mark = document.createElement('mark');
+            mark.className = 'menu-search-match';
+            mark.textContent = text.slice(start, end);
+            frag.append(mark);
+            last = end;
+          }
+          frag.append(text.slice(last));
+          node.replaceWith(frag);
+        }
+      };
+
+      const highlight = supportsHighlights ? highlightWithApi : highlightWithMarks;
+
+      input.addEventListener('input', () => {
+        highlight(input.value.trim().toLowerCase());
+      });
+    })();
+  </script>
+
