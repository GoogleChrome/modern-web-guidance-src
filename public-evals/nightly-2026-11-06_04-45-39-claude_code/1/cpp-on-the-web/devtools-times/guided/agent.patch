new file mode 100644
index 0000000..5c91da2
--- /dev/null
+++ b/src/scripts/smallpt-worker.ts
@@ -0,0 +1,56 @@
+/// <reference lib="webworker" />
+// Runs one smallpt WebAssembly instance off the main thread. Several of these
+// workers split a frame by interleaving rows (row = offset + k * stride).
+import createSmallpt from '../wasm/smallpt.js';
+import wasmUrl from '../wasm/smallpt.wasm?url';
+
+export type RGB = [number, number, number];
+
+export interface StartMessage {
+  width: number;
+  height: number;
+  seed: number;
+  offset: number;
+  stride: number;
+  passes: number;
+  /** Sphere albedos by scene index, or null for the original smallpt scene. */
+  colors: (RGB | null)[] | null;
+}
+
+export type WorkerReply =
+  | { type: 'pass'; offset: number; stride: number; spp: number; rows: Uint8ClampedArray }
+  | { type: 'error'; message: string };
+
+const scope = self as unknown as DedicatedWorkerGlobalScope;
+const modulePromise = createSmallpt({ locateFile: () => wasmUrl });
+
+scope.onmessage = async ({ data }: MessageEvent<StartMessage>) => {
+  try {
+    const wasm = await modulePromise;
+    const { width, height, seed, offset, stride, passes, colors } = data;
+
+    wasm._smallpt_reset_colors();
+    colors?.forEach((c, i) => c && wasm._smallpt_set_sphere_color(i, c[0], c[1], c[2]));
+    if (!wasm._smallpt_init(width, height, seed)) throw new Error('Out of memory');
+
+    const rowBytes = width * 4;
+    const ownRows = Math.ceil((height - offset) / stride);
+    for (let p = 0; p < passes; p++) {
+      wasm._smallpt_render_rows(offset, stride);
+      const spp = wasm._smallpt_end_pass(offset, stride);
+
+      // Read HEAPU8 fresh after the call: memory growth detaches old views.
+      const base = wasm._smallpt_pixels();
+      const heap = wasm.HEAPU8;
+      const rows = new Uint8ClampedArray(ownRows * rowBytes);
+      for (let k = 0, y = offset; y < height; k++, y += stride) {
+        rows.set(heap.subarray(base + y * rowBytes, base + (y + 1) * rowBytes), k * rowBytes);
+      }
+      const reply: WorkerReply = { type: 'pass', offset, stride, spp, rows };
+      scope.postMessage(reply, [rows.buffer]);
+    }
+  } catch (err) {
+    const reply: WorkerReply = { type: 'error', message: err instanceof Error ? err.message : String(err) };
+    scope.postMessage(reply);
+  }
+};
