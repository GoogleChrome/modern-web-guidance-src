+// smallpt, a Path Tracer by Kevin Beason, 2008
+// http://www.kevinbeason.com/smallpt/  (MIT License, see LICENSE below)
+//
+// Adapted for WebAssembly / the browser:
+//  - main() + PPM output replaced by a small C API (exported via Emscripten)
+//    that renders progressively: each call to smallpt_render_pass() adds one
+//    sample per 2x2 sub-pixel (4 spp) and refreshes an RGBA8 buffer that JS
+//    can copy straight into a <canvas> ImageData.
+//  - Sphere colors can be changed from JS (smallpt_set_sphere_color).
+//  - OpenMP removed (single-threaded, runs inside a Web Worker).
+// The geometry, materials, camera and radiance() integrator are unchanged.
+//
+// LICENSE (smallpt): Copyright (c) 2006-2008 Kevin Beason
+// Permission is hereby granted, free of charge, to any person obtaining a copy
+// of this software and associated documentation files (the "Software"), to
+// deal in the Software without restriction, including without limitation the
+// rights to use, copy, modify, merge, publish, distribute, sublicense, and/or
+// sell copies of the Software, and to permit persons to whom the Software is
+// furnished to do so, subject to the following conditions: The above
+// copyright notice and this permission notice shall be included in all copies
+// or substantial portions of the Software. THE SOFTWARE IS PROVIDED "AS IS",
+// WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED.
+#include <math.h>
+#include <stdlib.h>
+#include <emscripten/emscripten.h>
+
+struct Vec {
+  double x, y, z;                  // position, also color (r,g,b)
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; }
+  Vec operator%(const Vec &b) const {return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };  // material types, used in radiance()
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if nohit
+    Vec op = p-r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+static const Sphere default_spheres[] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+static const int NUM_SPHERES = sizeof(default_spheres)/sizeof(Sphere);
+static Sphere spheres[] = {
+  default_spheres[0], default_spheres[1], default_spheres[2],
+  default_spheres[3], default_spheres[4], default_spheres[5],
+  default_spheres[6], default_spheres[7], default_spheres[8]
+};
+static_assert(sizeof(spheres) == sizeof(default_spheres), "scene size mismatch");
+
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+inline bool intersect(const Ray &r, double &t, int &id){
+  double d, inf=t=1e20;
+  for(int i=NUM_SPHERES;i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t;                               // distance to intersection
+  int id=0;                               // id of intersected object
+  if (!intersect(r, t, id)) return Vec(); // if miss, return black
+  const Sphere &obj = spheres[id];        // the hit object
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z; // max refl
+  if (++depth>5) { if (erand48(Xi)<p) f=f*(1/p); else return obj.e; } //R.R.
+  if (obj.refl == DIFF){                  // Ideal DIFFUSE reflection
+    double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)            // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl)>0;                // Ray from outside going in?
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?   // Russian roulette
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+// ---------------------------------------------------------------------------
+// Browser API
+// ---------------------------------------------------------------------------
+static int W = 0, H = 0, passes = 0;
+static Vec *accum = nullptr;            // per sub-pixel radiance sums (w*h*4)
+static unsigned char *rgba = nullptr;   // RGBA8 output, top row first
+static unsigned short *seeds = nullptr; // erand48 state per row (h*3)
+
+extern "C" {
+
+// Allocate buffers for a w*h image and reset the accumulation.
+// `seed` decorrelates noise between runs. Returns 1 on success.
+EMSCRIPTEN_KEEPALIVE int smallpt_init(int w, int h, int seed) {
+  free(accum); free(rgba); free(seeds);
+  W = w; H = h; passes = 0;
+  accum = (Vec*)calloc((size_t)w*h*4, sizeof(Vec));
+  rgba = (unsigned char*)calloc((size_t)w*h*4, 1);
+  seeds = (unsigned short*)malloc((size_t)h*3*sizeof(unsigned short));
+  if (!accum || !rgba || !seeds) return 0;
+  for (int y=0; y<h; y++) {             // same per-row seeding as smallpt
+    seeds[y*3+0] = (unsigned short)seed;
+    seeds[y*3+1] = (unsigned short)(seed >> 16);
+    seeds[y*3+2] = (unsigned short)(y*y*y);
+  }
+  return 1;
+}
+
+EMSCRIPTEN_KEEPALIVE int smallpt_num_spheres() { return NUM_SPHERES; }
+
+// Set the diffuse/specular/refractive color (albedo) of sphere i.
+// Values are clamped to [0, 0.999] to keep the scene energy-conserving.
+EMSCRIPTEN_KEEPALIVE void smallpt_set_sphere_color(int i, double r, double g, double b) {
+  if (i < 0 || i >= NUM_SPHERES) return;
+  auto c = [](double v){ return v<0 ? 0 : v>.999 ? .999 : v; };
+  spheres[i].c = Vec(c(r), c(g), c(b));
+}
+
+EMSCRIPTEN_KEEPALIVE void smallpt_reset_colors() {
+  for (int i=0; i<NUM_SPHERES; i++) spheres[i].c = default_spheres[i].c;
+}
+
+// Trace one sample per 2x2 sub-pixel (4 spp) over output rows
+// y0, y0+stride, y0+2*stride, ... (row 0 = top of the image). The stride lets
+// several workers split one image by interleaving rows. Follow each call with
+// smallpt_end_pass() using the same arguments.
+EMSCRIPTEN_KEEPALIVE void smallpt_render_rows(int y0, int stride) {
+  const int w=W, h=H;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135;
+  if (stride < 1) stride = 1;
+  for (int row=y0; row<h; row+=stride) {
+    const int y = h-row-1;              // smallpt's y runs bottom-up
+    unsigned short *Xi = &seeds[y*3];
+    for (int x=0; x<w; x++)
+      for (int sy=0, i=(h-y-1)*w+x; sy<2; sy++)
+        for (int sx=0; sx<2; sx++) {
+          double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+          double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+          Vec d = cx*( ( (sx+.5 + dx)/2 + x)/w - .5) +
+                  cy*( ( (sy+.5 + dy)/2 + y)/h - .5) + cam.d;
+          Vec &a = accum[i*4 + sy*2 + sx];
+          a = a + radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+        }
+  }
+}
+
+// Finish a pass: resolve accumulated samples of the given rows into the RGBA
+// buffer (clamp per sub-pixel, average 2x2, gamma 2.2 — as smallpt does).
+EMSCRIPTEN_KEEPALIVE int smallpt_end_pass(int y0, int stride) {
+  passes++;
+  if (stride < 1) stride = 1;
+  const double inv = 1.0 / passes;
+  for (int row=y0; row<H; row+=stride)
+  for (int i=row*W; i<(row+1)*W; i++) {
+    Vec c;
+    for (int s=0; s<4; s++) {
+      const Vec r = accum[i*4+s] * inv;
+      c = c + Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+    }
+    rgba[i*4+0] = (unsigned char)toInt(c.x);
+    rgba[i*4+1] = (unsigned char)toInt(c.y);
+    rgba[i*4+2] = (unsigned char)toInt(c.z);
+    rgba[i*4+3] = 255;
+  }
+  return passes * 4; // samples per pixel so far
+}
+
+EMSCRIPTEN_KEEPALIVE unsigned char *smallpt_pixels() { return rgba; }
+
+} // extern "C"
