+// Types for the Emscripten-generated ES module (built by scripts/build-wasm.sh).
+export interface SmallptModule {
+  HEAPU8: Uint8Array;
+  _smallpt_init(width: number, height: number, seed: number): number;
+  _smallpt_num_spheres(): number;
+  _smallpt_set_sphere_color(index: number, r: number, g: number, b: number): void;
+  _smallpt_reset_colors(): void;
+  _smallpt_render_rows(firstRow: number, stride: number): void;
+  _smallpt_end_pass(firstRow: number, stride: number): number;
+  _smallpt_pixels(): number;
+}
+
+export default function createSmallpt(options?: {
+  locateFile?: (path: string, scriptDirectory: string) => string;
+}): Promise<SmallptModule>;
