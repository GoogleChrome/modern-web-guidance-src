+#!/usr/bin/env sh
+# Compiles the smallpt path tracer (wasm/smallpt.cpp) to WebAssembly.
+# Requires Emscripten (emcc/em++) on PATH. Output: src/wasm/smallpt.{js,wasm}
+# The generated files are committed, so `pnpm build` works without Emscripten.
+set -eu
+cd "$(dirname "$0")/.."
+mkdir -p build src/wasm
+# Note: -flto is omitted because some distro Emscripten packages fail to link
+# LTO libc++ (undefined __cxa_increment_exception_refcount).
+em++ -c wasm/smallpt.cpp -o build/smallpt.o -O3 -Wall -Werror
+em++ build/smallpt.o -o src/wasm/smallpt.js \
+  -O3 \
+  -sSTRICT \
+  -sEXPORT_ES6 \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH \
+  -sSTACK_SIZE=1MB \
+  -sEXPORTED_FUNCTIONS=_smallpt_init,_smallpt_num_spheres,_smallpt_set_sphere_color,_smallpt_reset_colors,_smallpt_render_rows,_smallpt_end_pass,_smallpt_pixels \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
+echo "Built src/wasm/smallpt.js + smallpt.wasm"
diff --git a/src/components/SmallptRenderer.astro b/src/components/SmallptRenderer.astro
new file mode 100644
index 0000000..4333904
--- /dev/null
+++ b/src/components/SmallptRenderer.astro
@@ -0,0 +1,209 @@
+---
+// Live, client-side render of Kevin Beason's smallpt path tracer, compiled to
+// WebAssembly (see wasm/smallpt.cpp and scripts/build-wasm.sh).
+const WIDTH = 320;
+const HEIGHT = 240;
+const TARGET_SPP = 256;
+---
+<section class="p-4 md:p-6">
+  <h2 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6">Lab: Path tracing in your browser</h2>
+
+  <smallpt-renderer
+    class="grid gap-6 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] items-start"
+    data-width={WIDTH}
+    data-height={HEIGHT}
+    data-spp={TARGET_SPP}
+  >
+    <figure class="m-0">
+      <canvas
+        width={WIDTH}
+        height={HEIGHT}
+        class="block w-full h-auto aspect-[4/3] bg-gray-900 rounded"
+        role="img"
+        aria-label="Path-traced Cornell box with a mirror sphere and a glass sphere"
+      ></canvas>
+      <figcaption class="mt-2 flex items-center gap-3 text-sm text-gray-600">
+        <progress class="w-32 accent-amber-400" max={TARGET_SPP} value="0"></progress>
+        <span data-progress class="tabular-nums">Waiting to render…</span>
+      </figcaption>
+    </figure>
+
+    <div class="space-y-4 text-gray-700">
+      <p>
+        This image is being rendered right now, on your device, by
+        <a class="underline hover:text-amber-500" href="http://www.kevinbeason.com/smallpt/">smallpt</a>,
+        Kevin Beason’s 99-line C++ global-illumination path tracer, compiled to WebAssembly with Emscripten.
+        The work is split across Web Workers and the picture refines as samples accumulate.
+      </p>
+      <button
+        type="button"
+        class="inline-flex items-center gap-2 rounded bg-gray-900 px-4 py-2 font-semibold text-white hover:bg-amber-400 hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400 cursor-pointer"
+      >
+        Render again with random colors
+      </button>
+      <p role="status" class="text-sm text-gray-600" data-status></p>
+      <ul data-swatches class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm" aria-label="Sphere colors"></ul>
+    </div>
+  </smallpt-renderer>
+</section>
+
+<script>
+  import type { RGB, StartMessage, WorkerReply } from '../scripts/smallpt-worker';
+
+  // Scene indices in smallpt's sphere array (front wall and light are left alone).
+  const SPHERES = [
+    { index: 0, name: 'Left wall' },
+    { index: 1, name: 'Right wall' },
+    { index: 2, name: 'Back wall' },
+    { index: 4, name: 'Floor' },
+    { index: 5, name: 'Ceiling' },
+    { index: 6, name: 'Mirror ball' },
+    { index: 7, name: 'Glass ball' },
+  ] as const;
+
+  const ORIGINAL: Record<number, RGB> = {
+    0: [0.75, 0.25, 0.25], 1: [0.25, 0.25, 0.75], 2: [0.75, 0.75, 0.75],
+    4: [0.75, 0.75, 0.75], 5: [0.75, 0.75, 0.75], 6: [0.999, 0.999, 0.999], 7: [0.999, 0.999, 0.999],
+  };
+
+  const rand = (min: number, max: number) => min + Math.random() * (max - min);
+
+  function hsl(h: number, s: number, l: number): RGB {
+    const f = (n: number) => {
+      const k = (n + h / 30) % 12;
+      return l - s * Math.min(l, 1 - l) * Math.max(-1, Math.min(k - 3, 9 - k, 1));
+    };
+    return [f(0), f(8), f(4)];
+  }
+
+  function randomColors(): Record<number, RGB> {
+    const wallHue = rand(0, 360);
+    return {
+      0: hsl(wallHue, rand(0.5, 0.8), rand(0.4, 0.55)),
+      1: hsl(wallHue + rand(90, 270), rand(0.5, 0.8), rand(0.4, 0.55)),
+      2: hsl(rand(0, 360), rand(0.1, 0.35), rand(0.65, 0.75)),
+      4: hsl(rand(0, 360), rand(0.1, 0.35), rand(0.65, 0.75)),
+      5: hsl(rand(0, 360), rand(0.1, 0.35), rand(0.65, 0.75)),
+      6: hsl(rand(0, 360), rand(0.4, 0.8), rand(0.6, 0.8)),
+      7: hsl(rand(0, 360), rand(0.4, 0.8), rand(0.6, 0.8)),
+    };
+  }
+
+  /** Albedo (linear) → sRGB-ish CSS color using smallpt's own gamma of 2.2. */
+  const toCss = (c: RGB) => `rgb(${c.map((v) => Math.round(Math.pow(v, 1 / 2.2) * 255)).join(' ')})`;
+
+  class SmallptRenderer extends HTMLElement {
+    #workers: Worker[] = [];
+    #observer?: IntersectionObserver;
+    #frame = 0;
+
+    connectedCallback() {
+      this.querySelector('button')!.addEventListener('click', () => this.render(randomColors()));
+      // Don't burn CPU until the reader actually scrolls the render into view.
+      this.#observer = new IntersectionObserver((entries) => {
+        if (entries.some((e) => e.isIntersecting)) {
+          this.#observer?.disconnect();
+          if (!this.#workers.length) this.render(ORIGINAL);
+        }
+      });
+      this.#observer.observe(this);
+    }
+
+    disconnectedCallback() {
+      this.#observer?.disconnect();
+      this.#stop();
+    }
+
+    #stop() {
+      this.#workers.forEach((w) => w.terminate());
+      this.#workers = [];
+      cancelAnimationFrame(this.#frame);
+    }
+
+    render(colors: Record<number, RGB>) {
+      this.#stop();
+
+      const width = Number(this.dataset.width);
+      const height = Number(this.dataset.height);
+      const targetSpp = Number(this.dataset.spp);
+      const canvas = this.querySelector('canvas')!;
+      const ctx = canvas.getContext('2d')!;
+      const progress = this.querySelector('progress')!;
+      const progressText = this.querySelector<HTMLElement>('[data-progress]')!;
+      const status = this.querySelector<HTMLElement>('[data-status]')!;
+
+      this.#renderSwatches(colors);
+
+      const image = ctx.createImageData(width, height);
+      const count = Math.max(1, Math.min(8, (navigator.hardwareConcurrency || 4) - 1));
+      const sppByWorker = new Array<number>(count).fill(0);
+      const seed = (Math.random() * 0xffffffff) >>> 0;
+      const started = performance.now();
+      const colorList = Array.from({ length: 9 }, (_, i) => colors[i] ?? null);
+
+      status.textContent = `Rendering ${width}×${height} at ${targetSpp} samples per pixel on ${count} worker${count > 1 ? 's' : ''}…`;
+      progress.value = 0;
+      progressText.textContent = '0 spp';
+
+      let dirty = false;
+      const draw = () => {
+        this.#frame = 0;
+        if (!dirty) return;
+        dirty = false;
+        ctx.putImageData(image, 0, 0);
+        const spp = Math.min(...sppByWorker);
+        const seconds = ((performance.now() - started) / 1000).toFixed(1);
+        progress.value = spp;
+        progressText.textContent = `${spp} / ${targetSpp} spp · ${seconds} s`;
+        if (spp >= targetSpp) {
+          status.textContent = `Done: ${targetSpp} samples per pixel in ${seconds} s.`;
+          this.#stop();
+        }
+      };
+
+      for (let i = 0; i < count; i++) {
+        const worker = new Worker(new URL('../scripts/smallpt-worker.ts', import.meta.url), { type: 'module' });
+        worker.onmessage = ({ data }: MessageEvent<WorkerReply>) => {
+          if (data.type === 'error') {
+            status.textContent = `Render failed: ${data.message}`;
+            this.#stop();
+            return;
+          }
+          const rowBytes = width * 4;
+          for (let k = 0, y = data.offset; y < height; k++, y += data.stride) {
+            image.data.set(data.rows.subarray(k * rowBytes, (k + 1) * rowBytes), y * rowBytes);
+          }
+          sppByWorker[i] = data.spp;
+          dirty = true;
+          if (!this.#frame) this.#frame = requestAnimationFrame(draw);
+        };
+        worker.onerror = () => {
+          status.textContent = 'Render failed: WebAssembly worker could not start.';
+          this.#stop();
+        };
+        const message: StartMessage = {
+          width, height, seed, offset: i, stride: count, passes: targetSpp / 4, colors: colorList,
+        };
+        worker.postMessage(message);
+        this.#workers.push(worker);
+      }
+    }
+
+    #renderSwatches(colors: Record<number, RGB>) {
+      const list = this.querySelector('[data-swatches]')!;
+      list.replaceChildren(
+        ...SPHERES.map(({ index, name }) => {
+          const li = document.createElement('li');
+          li.className = 'flex items-center gap-2';
+          const dot = document.createElement('span');
+          dot.className = 'inline-block size-3 rounded-full border border-gray-300';
+          dot.style.background = toCss(colors[index]);
+          li.append(dot, name);
+          return li;
+        }),
+      );
+    }
+  }
+
+  if (!customElements.get('smallpt-renderer')) customElements.define('smallpt-renderer', SmallptRenderer);
+</script>
