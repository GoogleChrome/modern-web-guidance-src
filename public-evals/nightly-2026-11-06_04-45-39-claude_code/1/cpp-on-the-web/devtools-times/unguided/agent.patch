new file mode 100755
index 0000000..341efc8
--- /dev/null
+++ b/wasm/build.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env sh
+# Compiles smallpt to WebAssembly. Output goes to public/smallpt/ and is
+# committed, so `pnpm build` does not require Emscripten.
+set -eu
+cd "$(dirname "$0")/.."
+mkdir -p public/smallpt
+emcc wasm/smallpt.cpp -O3 -std=c++11 \
+  -o public/smallpt/smallpt.js \
+  -sMODULARIZE=1 -sEXPORT_NAME=createSmallpt \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576 \
+  -sEXPORTED_FUNCTIONS=_smallpt_init,_smallpt_num_spheres,_smallpt_set_color,_smallpt_reset_colors,_smallpt_render_row,_malloc,_free \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
+echo "Built public/smallpt/smallpt.{js,wasm}"
