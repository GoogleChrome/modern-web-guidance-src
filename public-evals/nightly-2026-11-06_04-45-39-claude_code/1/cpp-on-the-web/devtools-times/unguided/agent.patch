new file mode 100644
index 0000000..ca54104
--- /dev/null
+++ b/src/components/SmallptRenderer.tsx
@@ -0,0 +1,128 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+const WIDTH = 320;
+const HEIGHT = 240;
+const SAMPLES = 8; // per 2x2 subpixel => 32 samples per pixel
+
+// Indices into smallpt's scene: 0 Left, 1 Right, 2 Back, 3 Front, 4 Bottom,
+// 5 Top, 6 Mirror ball, 7 Glass ball, 8 Light.
+const WALLS = [0, 1, 2, 4, 5];
+const BALLS = [6, 7];
+
+type RGB = [number, number, number];
+
+function hslToRgb(h: number, s: number, l: number): RGB {
+  const k = (n: number) => (n + h / 30) % 12;
+  const a = s * Math.min(l, 1 - l);
+  const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
+  return [f(0), f(8), f(4)];
+}
+
+function randomColors(): (RGB | null)[] {
+  const colors: (RGB | null)[] = new Array(9).fill(null);
+  for (const i of WALLS) colors[i] = hslToRgb(Math.random() * 360, 0.4 + Math.random() * 0.5, 0.35 + Math.random() * 0.3);
+  // Tint the mirror/glass balls; keep them bright so they stay reflective.
+  for (const i of BALLS) colors[i] = hslToRgb(Math.random() * 360, 0.3 + Math.random() * 0.6, 0.65 + Math.random() * 0.2);
+  return colors;
+}
+
+const toCss = (c: RGB) => `rgb(${c.map((v) => Math.round(v * 255)).join(',')})`;
+
+export default function SmallptRenderer({ base }: { base: string }) {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const jobRef = useRef(0);
+  const [progress, setProgress] = useState(0);
+  const [status, setStatus] = useState('Loading WebAssembly…');
+  const [palette, setPalette] = useState<RGB[] | null>(null);
+
+  const render = useCallback((colors: (RGB | null)[] | null) => {
+    const worker = workerRef.current;
+    if (!worker) return;
+    const id = ++jobRef.current;
+    setProgress(0);
+    setStatus('Rendering…');
+    setPalette(colors ? (colors.filter(Boolean) as RGB[]) : null);
+    worker.postMessage({
+      id,
+      width: WIDTH,
+      height: HEIGHT,
+      samples: SAMPLES,
+      seed: Math.floor(Math.random() * 65536),
+      colors,
+    });
+  }, []);
+
+  useEffect(() => {
+    const worker = new Worker(`${base}smallpt/worker.js`);
+    workerRef.current = worker;
+    const ctx = canvasRef.current!.getContext('2d')!;
+    ctx.fillStyle = '#111';
+    ctx.fillRect(0, 0, WIDTH, HEIGHT);
+
+    worker.onmessage = (e) => {
+      const msg = e.data;
+      if (msg.id !== jobRef.current) return;
+      if (msg.type === 'rows') {
+        const img = new ImageData(new Uint8ClampedArray(msg.bytes.buffer), WIDTH, msg.rowCount);
+        ctx.putImageData(img, 0, msg.rowStart);
+        setProgress(msg.progress);
+      } else if (msg.type === 'done') {
+        setProgress(1);
+        setStatus(`Rendered ${WIDTH}×${HEIGHT} at ${SAMPLES * 4} spp in ${(msg.ms / 1000).toFixed(1)}s`);
+      }
+    };
+    worker.onerror = (err) => setStatus(`Error: ${err.message || 'failed to load renderer'}`);
+
+    render(null); // first run: the classic Cornell box colors
+    return () => worker.terminate();
+  }, [base, render]);
+
+  const busy = progress < 1;
+
+  return (
+    <div className="flex flex-col md:flex-row gap-6 items-start">
+      <div className="w-full md:w-auto">
+        <canvas
+          ref={canvasRef}
+          width={WIDTH}
+          height={HEIGHT}
+          className="w-full md:w-[480px] h-auto bg-black shadow-md"
+          style={{ imageRendering: 'pixelated', aspectRatio: `${WIDTH} / ${HEIGHT}` }}
+          aria-label="smallpt path-traced Cornell box"
+        />
+        <div className="h-1 bg-gray-200 mt-1">
+          <div className="h-1 bg-amber-400 transition-[width]" style={{ width: `${progress * 100}%` }} />
+        </div>
+      </div>
+      <div className="flex-1 text-left">
+        <p className="text-gray-700 mb-3">
+          This image is computed live in your browser by{' '}
+          <a className="underline hover:text-amber-500" href="http://www.kevinbeason.com/smallpt/" target="_blank" rel="noreferrer">
+            smallpt
+          </a>
+          , Kevin Beason's 99-line C++ global-illumination path tracer, compiled to WebAssembly with Emscripten and run
+          in a Web Worker.
+        </p>
+        <button
+          type="button"
+          onClick={() => render(randomColors())}
+          className="bg-gray-900 text-white px-4 py-2 font-semibold hover:bg-amber-400 hover:text-gray-900 transition-colors"
+        >
+          {busy ? 'Restart with random colors' : 'Render again with random colors'}
+        </button>
+        <p className="text-xs text-gray-500 mt-3" aria-live="polite">
+          {status}
+          {busy && ` ${Math.round(progress * 100)}%`}
+        </p>
+        {palette && (
+          <div className="flex gap-1 mt-2" title="Sphere colors used for this render">
+            {palette.map((c, i) => (
+              <span key={i} className="w-5 h-5 border border-gray-300" style={{ background: toCss(c) }} />
+            ))}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
