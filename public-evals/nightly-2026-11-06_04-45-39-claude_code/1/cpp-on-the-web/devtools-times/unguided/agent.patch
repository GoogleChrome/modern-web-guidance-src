new file mode 100644
index 0000000..11a097a
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,32 @@
+// Runs the smallpt WebAssembly module off the main thread and streams rows back.
+importScripts('smallpt.js');
+
+const modulePromise = createSmallpt();
+let currentJob = 0;
+
+self.onmessage = async (e) => {
+  const { id, width, height, samples, seed, colors } = e.data;
+  currentJob = id;
+  const M = await modulePromise;
+  const ptr = M._smallpt_init(width, height);
+  M._smallpt_reset_colors();
+  if (colors) colors.forEach((c, i) => c && M._smallpt_set_color(i, c[0], c[1], c[2]));
+
+  const start = performance.now();
+  const chunk = 8;
+  // smallpt renders rows bottom (y = 0) to top; stream them in chunks.
+  for (let y = 0; y < height; y += chunk) {
+    const end = Math.min(y + chunk, height);
+    for (let r = y; r < end; r++) M._smallpt_render_row(r, samples, seed);
+    // Yield so a newer job can pre-empt this one.
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    if (currentJob !== id) return;
+    const rowStart = height - end;
+    const bytes = M.HEAPU8.slice(ptr + rowStart * width * 4, ptr + (height - y) * width * 4);
+    self.postMessage(
+      { id, type: 'rows', rowStart, rowCount: end - y, bytes, progress: end / height },
+      [bytes.buffer]
+    );
+  }
+  self.postMessage({ id, type: 'done', ms: performance.now() - start });
+};
