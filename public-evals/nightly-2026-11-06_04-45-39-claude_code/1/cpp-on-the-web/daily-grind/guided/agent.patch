+// Runs the smallpt WebAssembly module off the main thread. Each worker renders
+// one horizontal band of the image and posts it back after every 4-spp pass.
+import initSmallpt from './smallpt.js';
+
+const wasmReady = initSmallpt();
+let currentJob = 0;
+
+self.onmessage = async ({ data }) => {
+  const { job, width, height, row0, row1, colors, maxPasses } = data;
+  currentJob = job;
+  const wasm = await wasmReady;
+
+  colors.forEach(([r, g, b], i) => wasm._set_sphere_color(i, r, g, b));
+  wasm._setup(width, height, row0, row1);
+  const byteLength = width * (row1 - row0) * 4;
+
+  for (let pass = 1; pass <= maxPasses; pass++) {
+    const ptr = wasm._render_pass();
+    if (job !== currentJob) return; // a newer render was requested
+    // Read HEAPU8 fresh: memory growth would detach an older view.
+    const pixels = wasm.HEAPU8.slice(ptr, ptr + byteLength);
+    self.postMessage({ job, row0, row1, pass, pixels }, [pixels.buffer]);
+    // Yield so a new "render" message can preempt this job between passes.
+    await new Promise((resolve) => setTimeout(resolve));
+    if (job !== currentJob) return;
+  }
+};
