+#!/bin/sh
+# Compile smallpt to an ES6 WebAssembly module for use in a Web Worker.
+set -e
+cd "$(dirname "$0")"
+mkdir -p wasm
+em++ -c src/smallpt.cpp -o src/smallpt.o -O3 -Werror -Wall
+em++ src/smallpt.o -o wasm/smallpt.js \
+  -O3 \
+  -sSTRICT \
+  -sEXPORT_ES6 \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH \
+  -sSTACK_SIZE=1MB \
+  -sEXPORTED_FUNCTIONS=_setup,_render_pass,_set_sphere_color,_sphere_count \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
+rm -f src/smallpt.o
