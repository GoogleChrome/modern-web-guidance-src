+        { i: 1, name: 'Right wall', def: [.25, .25, .75] },
+        { i: 2, name: 'Back wall', def: [.75, .75, .75] },
+        { i: 4, name: 'Floor', def: [.75, .75, .75] },
+        { i: 5, name: 'Ceiling', def: [.75, .75, .75] },
+        { i: 6, name: 'Mirror ball', def: [.999, .999, .999] },
+        { i: 7, name: 'Glass ball', def: [.999, .999, .999] },
+      ];
+
+      const canvas = document.getElementById('smallpt-canvas');
+      const ctx = canvas.getContext('2d');
+      const statusEl = document.getElementById('smallpt-status');
+      const progressEl = document.getElementById('smallpt-progress');
+      const randomBtn = document.getElementById('smallpt-random');
+      const originalBtn = document.getElementById('smallpt-original');
+      const sppSel = document.getElementById('smallpt-spp');
+      const swatchesEl = document.getElementById('smallpt-swatches');
+
+      if (typeof WebAssembly !== 'object' || typeof Worker !== 'function') {
+        statusEl.textContent = 'Sorry, your browser does not support WebAssembly workers.';
+        return;
+      }
+
+      // HSL (0..1) -> RGB (0..1)
+      function hsl(h, s, l) {
+        const f = (n) => {
+          const k = (n + h * 12) % 12;
+          return l - s * Math.min(l, 1 - l) * Math.max(-1, Math.min(k - 3, 9 - k, 1));
+        };
+        return [f(0), f(8), f(4)];
+      }
+      const rand = (a, b) => a + Math.random() * (b - a);
+
+      function randomColors() {
+        const colors = [];
+        for (const sp of SPHERES) {
+          let c;
+          if (sp.i <= 1) c = hsl(Math.random(), rand(.5, .9), rand(.3, .55));       // bold side walls
+          else if (sp.i <= 5) c = hsl(Math.random(), rand(.1, .5), rand(.55, .75)); // softer room surfaces
+          else c = hsl(Math.random(), rand(.3, 1), rand(.6, .8));                    // tinted balls
+          colors[sp.i] = c.map((v) => Math.min(.999, Math.max(0, v)));
+        }
+        return colors;
+      }
+
+      const toCss = (c) => `rgb(${c.map((v) => Math.round(Math.pow(v, 1 / 2.2) * 255)).join(',')})`;
+      function showSwatches(colors) {
+        swatchesEl.innerHTML = '';
+        for (const sp of SPHERES) {
+          const c = (colors && colors[sp.i]) || sp.def;
+          const el = document.createElement('div');
+          el.className = 'swatch';
+          el.innerHTML = `<span style="background:${toCss(c)}"></span>${sp.name}`;
+          swatchesEl.appendChild(el);
+        }
+      }
+
+      // Pool of workers, each running its own copy of the wasm module.
+      const nWorkers = Math.max(1, Math.min(navigator.hardwareConcurrency || 4, 8));
+      const workers = [];
+      let job = null;       // current render job
+      let jobCounter = 0;
+      let readyCount = 0;
+      let pending = null;   // render requested before workers were ready
+
+      function dispatch(w) {
+        if (!job || job.next >= H) { w.busy = false; return; }
+        const y = job.next++;
+        w.busy = true;
+        w.postMessage({ type: 'row', job: job.id, y });
+      }
+
+      function onMessage(w, data) {
+        if (data.type === 'ready') {
+          if (++readyCount === nWorkers && pending) { const p = pending; pending = null; render(p); }
+          return;
+        }
+        if (data.type !== 'row') return;
+        if (job && data.job === job.id) {
+          ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), W, 1), 0, data.row);
+          job.done++;
+          progressEl.style.width = (100 * job.done / H).toFixed(1) + '%';
+          if (job.done === H) {
+            const secs = ((performance.now() - job.start) / 1000).toFixed(1);
+            statusEl.textContent = `Rendered ${W}×${H} at ${job.spp} samples/pixel in ${secs}s using ${nWorkers} worker${nWorkers > 1 ? 's' : ''}.`;
+          } else if (job.done % 10 === 0) {
+            statusEl.textContent = `Rendering… ${Math.floor(100 * job.done / H)}%`;
+          }
+        }
+        dispatch(w);
+      }
+
+      for (let k = 0; k < nWorkers; k++) {
+        const w = new Worker('smallpt/worker.js');
+        w.busy = false;
+        w.onmessage = (e) => onMessage(w, e.data);
+        w.onerror = (e) => { statusEl.textContent = 'Renderer failed to load: ' + (e.message || 'unknown error'); };
+        workers.push(w);
+      }
+
+      let lastColors = null;
+      function render(colors) {
+        lastColors = colors;
+        showSwatches(colors);
+        if (readyCount < nWorkers) { pending = colors; return; }
+        const spp = parseInt(sppSel.value, 10);
+        job = { id: ++jobCounter, next: 0, done: 0, spp, start: performance.now() };
+        progressEl.style.width = '0%';
+        statusEl.textContent = 'Rendering… 0%';
+        for (const w of workers) {
+          w.postMessage({ type: 'setup', job: job.id, w: W, h: H, spp, colors });
+          if (!w.busy) dispatch(w);
+        }
+      }
+
+      randomBtn.addEventListener('click', () => render(randomColors()));
+      originalBtn.addEventListener('click', () => render(null));
+      sppSel.addEventListener('change', () => render(lastColors));
+
+      render(null);
+    })();
+  </script>
+
