+#!/bin/sh
+# Builds smallpt.cpp -> smallpt/smallpt.js + smallpt/smallpt.wasm (requires Emscripten).
+set -e
+cd "$(dirname "$0")/.."
+emcc -O3 -Wno-dangling-else wasm/smallpt.cpp -o smallpt/smallpt.js \
+  -sMODULARIZE=1 -sEXPORT_NAME=createSmallpt -sENVIRONMENT=web,worker \
+  -sALLOW_MEMORY_GROWTH=1 -sFILESYSTEM=0 -sSTACK_SIZE=8MB \
+  -sEXPORTED_FUNCTIONS=_setup,_render_row,_set_sphere_color,_reset_sphere_colors,_sphere_count \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
