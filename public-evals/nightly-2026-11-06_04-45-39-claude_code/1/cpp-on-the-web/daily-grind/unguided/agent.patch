+// Web Worker that hosts one instance of the smallpt WebAssembly module and
+// renders individual image rows on request.
+importScripts('smallpt.js');
+
+let M = null, ptr = 0, width = 0, setupKey = '';
+const ready = createSmallpt().then((m) => { M = m; postMessage({ type: 'ready' }); });
+
+onmessage = async ({ data }) => {
+  await ready;
+  if (data.type === 'setup') {
+    // colors: array of [r,g,b] per sphere, or null for the original scene
+    M._reset_sphere_colors();
+    if (data.colors) data.colors.forEach((c, i) => c && M._set_sphere_color(i, c[0], c[1], c[2]));
+    ptr = M._setup(data.w, data.h, data.spp);
+    width = data.w;
+    setupKey = data.job;
+  } else if (data.type === 'row' && data.job === setupKey) {
+    const row = M._render_row(data.y);
+    const start = ptr + row * width * 4;
+    const pixels = M.HEAPU8.slice(start, start + width * 4); // copy out of wasm memory
+    postMessage({ type: 'row', job: data.job, row, pixels }, [pixels.buffer]);
+  }
+};
