     }
   </style>
+
+  <!--
+    Speculative prefetching: when a user hovers (or starts tapping) a same-origin
+    link, the browser fetches the next page in advance so navigation feels instant.
+    State-changing URLs (logout) and anything marked .no-prefetch are never fetched.
+    Unsupported browsers simply ignore this block.
+  -->
+  <script type="speculationrules">
+    {
+      "prefetch": [{
+        "tag": "site-link-prefetch",
+        "where": {
+          "and": [
+            { "href_matches": "/*" },
+            { "not": { "href_matches": ["/logout", "/logout/*", "/logout\\?*", "/logout/*\\?*"] } },
+            { "not": { "selector_matches": ".no-prefetch" } },
+            { "not": { "selector_matches": "[rel~=nofollow]" } }
+          ]
+        },
+        "eagerness": "moderate"
+      }]
+    }
+  </script>
 </head>
 
