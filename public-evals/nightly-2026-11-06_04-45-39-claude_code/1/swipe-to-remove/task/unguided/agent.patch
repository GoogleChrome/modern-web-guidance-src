+  <script>
+    (function () {
+      var list = document.getElementById('cart-list');
+      if (!list) return;
+
+      var THRESHOLD_RATIO = 0.4; // fraction of item width needed to trigger removal
+      var DRAG_START_PX = 8;     // movement before we decide horizontal vs vertical
+      var totalEl = document.getElementById('cart-total');
+      var emptyEl = document.getElementById('cart-empty');
+      var summaryEl = document.getElementById('cart-summary');
+      var statusEl = document.getElementById('cart-status');
+
+      function updateTotals() {
+        var items = list.querySelectorAll('.SwipeableList-item:not(.is-removing)');
+        var total = 0;
+        items.forEach(function (li) { total += parseFloat(li.dataset.price) || 0; });
+        totalEl.textContent = '$' + total.toFixed(2);
+        var empty = items.length === 0;
+        emptyEl.hidden = !empty;
+        summaryEl.hidden = empty;
+      }
+
+      function collapseAndRemove(item) {
+        if (item.classList.contains('is-removing')) return;
+        var name = item.querySelector('h3').textContent;
+
+        // Lock the current height so it can transition down to 0.
+        item.style.height = item.offsetHeight + 'px';
+        item.offsetHeight; // force reflow
+        item.classList.add('is-removing');
+        item.style.height = '0px';
+        item.style.paddingBottom = '0px';
+
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          // Move focus to a neighbour so keyboard users aren't stranded.
+          var next = item.nextElementSibling || item.previousElementSibling;
+          var hadFocus = item.contains(document.activeElement);
+          item.remove();
+          if (hadFocus && next) next.querySelector('.SwipeableList-content').focus();
+        }
+        item.addEventListener('transitionend', function (e) {
+          if (e.target === item && e.propertyName === 'height') finish();
+        });
+        setTimeout(finish, 450); // fallback if transitionend doesn't fire
+
+        updateTotals();
+        statusEl.textContent = name + ' removed from cart.';
+      }
+
+      function setup(item) {
+        var track = item.querySelector('.SwipeableList-track');
+        var content = item.querySelector('.SwipeableList-content');
+        var startX = 0, startY = 0, dx = 0;
+        var pointerId = null;
+        var dragging = false;
+        var locked = false; // true once we've decided this is a vertical scroll
+
+        function setOffset(x) {
+          content.style.transform = 'translateX(' + x + 'px)';
+          track.classList.toggle('is-swiping-right', x > 0);
+          track.classList.toggle('is-swiping-left', x < 0);
+          track.classList.toggle('is-past-threshold', Math.abs(x) >= item.offsetWidth * THRESHOLD_RATIO);
+        }
+
+        function reset() {
+          content.classList.add('is-animating');
+          setOffset(0);
+        }
+
+        function dismiss(direction) {
+          track.classList.add('is-past-threshold');
+          content.classList.add('is-animating');
+          content.style.transform = 'translateX(' + (direction * item.offsetWidth) + 'px)';
+          var fired = false;
+          function next() {
+            if (fired) return;
+            fired = true;
+            collapseAndRemove(item);
+          }
+          content.addEventListener('transitionend', function handler(e) {
+            if (e.propertyName !== 'transform') return;
+            content.removeEventListener('transitionend', handler);
+            next();
+          });
+          setTimeout(next, 300);
+        }
+
+        content.addEventListener('transitionend', function (e) {
+          if (e.propertyName === 'transform' && !dragging) content.classList.remove('is-animating');
+        });
+
+        content.addEventListener('pointerdown', function (e) {
+          if (pointerId !== null || item.classList.contains('is-removing')) return;
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          dx = 0;
+          dragging = false;
+          locked = false;
+        });
+
+        content.addEventListener('pointermove', function (e) {
+          if (e.pointerId !== pointerId || locked) return;
+          var moveX = e.clientX - startX;
+          var moveY = e.clientY - startY;
+
+          if (!dragging) {
+            if (Math.abs(moveX) < DRAG_START_PX && Math.abs(moveY) < DRAG_START_PX) return;
+            if (Math.abs(moveY) > Math.abs(moveX)) { locked = true; return; }
+            dragging = true;
+            content.classList.remove('is-animating');
+            content.classList.add('is-dragging');
+            content.setPointerCapture(e.pointerId);
+          }
+          dx = moveX;
+          setOffset(dx);
+        });
+
+        function end(e) {
+          if (e.pointerId !== pointerId) return;
+          pointerId = null;
+          if (!dragging) return;
+          dragging = false;
+          content.classList.remove('is-dragging');
+          if (content.hasPointerCapture(e.pointerId)) content.releasePointerCapture(e.pointerId);
+
+          if (e.type !== 'pointercancel' && Math.abs(dx) >= item.offsetWidth * THRESHOLD_RATIO) {
+            dismiss(dx > 0 ? 1 : -1);
+          } else {
+            reset();
+          }
+        }
+        content.addEventListener('pointerup', end);
+        content.addEventListener('pointercancel', end);
+
+        content.addEventListener('keydown', function (e) {
+          if (e.key === 'Delete' || e.key === 'Backspace') {
+            e.preventDefault();
+            dismiss(-1);
+          }
+        });
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(setup);
+      updateTotals();
+    })();
+  </script>
+
