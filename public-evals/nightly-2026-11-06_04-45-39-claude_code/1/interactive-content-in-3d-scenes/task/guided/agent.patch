+          gl.drawElements(gl.TRIANGLES, 6, gl.UNSIGNED_SHORT, 0);
+        }
+
+        if (htmlInCanvas) syncFormHitTesting(view.multiply(model).multiply(faces[0].m), frontMvp);
+      }
+
+      // Keep the real <form> aligned with the front face so clicks, text
+      // selection and focus rings land on it; drop it from hit testing while
+      // it faces away from the viewer.
+      function syncFormHitTesting(modelView, mvp) {
+        const c = modelView.transformPoint(new DOMPoint(0, 0, 0));
+        const n = modelView.transformPoint(new DOMPoint(0, 0, 1));
+        const nx = n.x - c.x, ny = n.y - c.y, nz = n.z - c.z;
+        const facing = (nx * -c.x + ny * -c.y + nz * -c.z) /
+          (Math.hypot(nx, ny, nz) * Math.hypot(c.x, c.y, c.z)) > 0.15;
+
+        if (facing && formTexReady) {
+          canvas.updateElementGeometry(form, { canvasTransform: computeCanvasTransform(form, mvp) });
+          formHitTestable = true;
+        } else if (formHitTestable) {
+          canvas.clearElementGeometry(form);
+          formHitTestable = false;
+        }
+      }
+
+      /* ---------- Render loop ---------- */
+      let visible = true;
+      let rafId = 0;
+      const loop = () => {
+        if (htmlInCanvas) canvas.requestPaint();
+        else draw(performance.now());
+        rafId = visible ? requestAnimationFrame(loop) : 0;
+      };
+
+      if (htmlInCanvas) {
+        canvas.onpaint = (event) => {
+          if (needsUpload || !formTexReady || event.changedElements?.length > 0) {
+            try {
+              if (uploadForm()) { formTexReady = true; needsUpload = false; }
+            } catch (err) {
+              console.error('texElementSubImage2D copy failed:', err);
+            }
+          }
+          draw(performance.now());
+        };
+      }
+
+      // Pause rendering while the box is scrolled out of view.
+      new IntersectionObserver(([entry]) => {
+        visible = entry.isIntersecting;
+        lastTime = performance.now();
+        if (visible && !rafId) rafId = requestAnimationFrame(loop);
+      }).observe(canvas);
+    }
+  </script>
+
 </body>
 
 </html>
