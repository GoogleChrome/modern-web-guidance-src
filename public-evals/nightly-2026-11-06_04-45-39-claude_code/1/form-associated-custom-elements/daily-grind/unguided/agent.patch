+    form.addEventListener('change', (event) => event.target.classList?.add('touched'));
+    form.addEventListener('reset', () => {
+      form.querySelectorAll('.touched').forEach((el) => el.classList.remove('touched'));
+      status.textContent = '';
+      status.className = 'form-status';
+    });
+
+    // The submit event only fires once native constraint validation passes,
+    // including the required <star-rating>.
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const data = new FormData(form);
+
+      fieldset.disabled = true; // disables every control, star ratings included
