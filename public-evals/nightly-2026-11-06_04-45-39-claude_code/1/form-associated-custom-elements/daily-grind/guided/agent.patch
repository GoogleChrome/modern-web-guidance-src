index 0000000..bb06076
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,292 @@
+/**
+ * <star-rating> — a form-associated custom element.
+ *
+ * Attributes:
+ *   name      Form field name (handled natively by the form).
+ *   value     Default value (restored on form reset), e.g. "4".
+ *   max       Number of stars (default 5).
+ *   required  Participates in constraint validation (valueMissing).
+ *   disabled  Disables the control (also disabled by an ancestor <fieldset disabled>).
+ *   labels    Optional "|"-separated descriptions per star, e.g. "Poor|Fair|Good|Great|Excellent".
+ *
+ * Events: fires `input` and `change` when the user picks a rating, like a native radio group.
+ * Custom state: `:state(user-invalid)` after a failed submission attempt, until a value is chosen.
+ */
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.75rem;
+      --star-size: 2rem;
+      --star-empty: #d7ccc8;
+      --star-filled: #ffab40;
+      --star-focus: #4e342e;
+    }
+    :host(:disabled) { opacity: 0.55; }
+
+    .stars { display: inline-flex; gap: 0.125rem; }
+
+    button {
+      all: unset;
+      box-sizing: border-box;
+      display: grid;
+      place-items: center;
+      inline-size: calc(var(--star-size) + 0.5rem);
+      block-size: calc(var(--star-size) + 0.5rem);
+      border-radius: 50%;
+      cursor: pointer;
+      color: var(--star-empty);
+      transition: color 0.15s, transform 0.15s;
+    }
+    button:disabled { cursor: not-allowed; }
+    button:focus-visible { outline: 3px solid var(--star-focus); outline-offset: 1px; }
+
+    svg { inline-size: var(--star-size); block-size: var(--star-size); }
+    path { fill: currentColor; stroke: #8d6e63; stroke-width: 1; }
+
+    /* Selected value */
+    button.filled { color: var(--star-filled); }
+
+    /* Hover preview: fill up to the hovered star, overriding the selection */
+    .stars:has(button:enabled:hover) button { color: var(--star-filled); }
+    .stars button:enabled:hover ~ button { color: var(--star-empty); }
+    button:enabled:hover { transform: scale(1.12); }
+
+    .caption { min-inline-size: 6ch; font-weight: 600; }
+
+    @media (prefers-reduced-motion: reduce) {
+      button { transition: none; }
+      button:enabled:hover { transform: none; }
+    }
+    @media (forced-colors: active) {
+      path { stroke: CanvasText; }
+      button { color: Canvas; }
+      button.filled, .stars:has(button:enabled:hover) button { color: Highlight; }
+      .stars button:enabled:hover ~ button { color: Canvas; }
+    }
+  </style>
+  <div class="stars" part="stars"></div>
+  <span class="caption" part="caption" aria-hidden="true"></span>
+`;
+
+const STAR_PATH =
+  'M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z';
+
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['required', 'max', 'labels', 'value'];
+
+  #internals;
+  #value = '';
+  #dirty = false; // true once the value was changed by the user/script (like native inputs)
+  #disabled = false;
+  #stars = [];
+  #starsEl;
+  #captionEl;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'radiogroup';
+
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(template.content.cloneNode(true));
+    this.#starsEl = root.querySelector('.stars');
+    this.#captionEl = root.querySelector('.caption');
+
+    this.#starsEl.addEventListener('click', (e) => {
+      const star = e.target.closest('button');
+      if (star) this.#select(Number(star.dataset.value));
+    });
+    this.#starsEl.addEventListener('keydown', (e) => this.#onKeydown(e));
+
+    // A failed submit/checkValidity()/reportValidity() fires `invalid` on the host.
+    this.addEventListener('invalid', () => this.#setUserInvalid(true));
+
+    this.#render();
+  }
+
+  connectedCallback() {
+    if (!this.#dirty) this.#setValue(this.getAttribute('value') ?? '');
+  }
+
+  attributeChangedCallback(name) {
+    if (name === 'value') {
+      // Like <input value>, the attribute is the default; it only applies until the value is dirty.
+      if (!this.#dirty) this.#setValue(this.getAttribute('value') ?? '');
+      return;
+    }
+    if (name === 'max' || name === 'labels') this.#render();
+    this.#update();
+  }
+
+  /* ---------- Public API (mirrors native controls) ---------- */
+
+  get value() { return this.#value; }
+  set value(v) {
+    this.#dirty = true;
+    this.#setValue(v);
+  }
+
+  get name() { return this.getAttribute('name'); }
+  get type() { return this.localName; }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  get required() { return this.hasAttribute('required'); }
+  set required(v) { this.toggleAttribute('required', Boolean(v)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(v) { this.toggleAttribute('disabled', Boolean(v)); }
+
+  get max() {
+    const n = parseInt(this.getAttribute('max'), 10);
+    return Number.isInteger(n) && n > 0 && n <= 10 ? n : 5;
+  }
+
+  /* ---------- Form lifecycle callbacks ---------- */
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#setUserInvalid(false);
+    this.#setValue(this.getAttribute('value') ?? '');
+  }
+
+  formDisabledCallback(disabled) {
+    // Covers both our own `disabled` attribute and an ancestor <fieldset disabled>.
+    // Never toggle `disabled` on the host here, or re-enabling the fieldset would leave it stuck.
+    this.#disabled = disabled;
+    this.#internals.ariaDisabled = disabled ? 'true' : null;
+    for (const star of this.#stars) star.disabled = disabled;
+  }
+
+  formStateRestoreCallback(state) {
+    // Back/forward navigation or autofill restore.
+    this.#dirty = true;
+    this.#setValue(typeof state === 'string' ? state : '');
+  }
+
+  /* ---------- Internals ---------- */
+
+  #starLabels() {
+    const custom = (this.getAttribute('labels') ?? '').split('|').map((s) => s.trim());
+    return Array.from({ length: this.max }, (_, i) => {
+      const n = i + 1;
+      const base = `${n} star${n === 1 ? '' : 's'}`;
+      return { base, description: custom[i] || '' };
+    });
+  }
+
+  #render() {
+    const labels = this.#starLabels();
+    this.#stars = labels.map(({ base, description }, i) => {
+      const star = document.createElement('button');
+      star.type = 'button';
+      star.setAttribute('role', 'radio');
+      star.dataset.value = String(i + 1);
+      star.dataset.description = description;
+      star.setAttribute('aria-label', description ? `${base}, ${description}` : base);
+      star.disabled = this.#disabled;
+      star.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${STAR_PATH}"/></svg>`;
+      return star;
+    });
+    this.#starsEl.replaceChildren(...this.#stars);
+    this.#update();
+  }
+
+  #setValue(raw) {
+    const n = parseInt(raw, 10);
+    this.#value = Number.isInteger(n) && n >= 1 && n <= this.max ? String(n) : '';
+    // Submission value and restoration state.
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    if (this.#value) this.#setUserInvalid(false);
+    this.#update();
+  }
+
+  #select(n) {
+    if (this.#disabled || String(n) === this.#value) {
+      this.#stars[n - 1]?.focus();
+      return;
+    }
+    this.value = String(n);
+    this.#stars[n - 1].focus();
+    this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  #onKeydown(e) {
+    if (this.#disabled) return;
+    const current = Number(this.#value) || 0;
+    const focused = this.#stars.indexOf(this.shadowRoot.activeElement) + 1 || current || 1;
+    let next;
+    switch (e.key) {
+      case 'ArrowRight':
+      case 'ArrowUp':
+        next = focused >= this.max ? 1 : focused + 1; break;
+      case 'ArrowLeft':
+      case 'ArrowDown':
+        next = focused <= 1 ? this.max : focused - 1; break;
+      case 'Home': next = 1; break;
+      case 'End': next = this.max; break;
+      case ' ':
+      case 'Enter':
+        // Native button activation fires `click`, which selects the focused star.
+        return;
+      default: {
+        const digit = Number(e.key);
+        if (Number.isInteger(digit) && digit >= 1 && digit <= this.max) next = digit;
+        else return;
+      }
+    }
+    e.preventDefault();
+    this.#select(next);
+  }
+
+  #update() {
+    const current = Number(this.#value) || 0;
+    this.#stars.forEach((star, i) => {
+      const n = i + 1;
+      star.classList.toggle('filled', n <= current);
+      star.setAttribute('aria-checked', String(n === current));
+      // Roving tabindex: checked star, or the first star when nothing is selected.
+      star.tabIndex = n === (current || 1) ? 0 : -1;
+    });
+    const selected = this.#stars[current - 1];
+    this.#captionEl.textContent = selected
+      ? selected.dataset.description || `${current}/${this.max}`
+      : '';
+
+    this.#internals.ariaRequired = this.required ? 'true' : null;
+
+    if (this.required && !this.#value) {
+      this.#internals.setValidity(
+        { valueMissing: true },
+        'Please choose a star rating.',
+        this.#stars[0],
+      );
+    } else {
+      this.#internals.setValidity({});
+    }
+  }
+
+  #setUserInvalid(on) {
+    // :user-invalid isn't reliably wired up for FACEs, so expose an equivalent custom state.
+    try {
+      if (on) this.#internals.states.add('user-invalid');
+      else this.#internals.states.delete('user-invalid');
+    } catch { /* CustomStateSet unsupported: visual state only */ }
+    this.#internals.ariaInvalid = on ? 'true' : null;
+  }
+}
+
+if (!customElements.get('star-rating')) customElements.define('star-rating', StarRating);
+
+export { StarRating };
