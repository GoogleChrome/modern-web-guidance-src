+  <script type="module">
+    import './star-rating.js';
+
+    const form = document.getElementById('feedback-form');
+    const fields = document.getElementById('feedback-fields');
+    const status = document.getElementById('form-status');
+    const coffee = document.getElementById('coffee');
+
+    // Mirror the visual :user-invalid state of the native <select> to ARIA.
+    const syncAriaInvalid = (el) => {
+      if (el.matches(':user-invalid')) el.setAttribute('aria-invalid', 'true');
+      else if (el.matches(':user-valid')) el.removeAttribute('aria-invalid');
+    };
+    coffee.addEventListener('blur', () => syncAriaInvalid(coffee));
+    coffee.addEventListener('change', () => syncAriaInvalid(coffee));
+    // Fires for every invalid control (including <star-rating>) when submission is blocked.
+    form.addEventListener('invalid', () => {
+      syncAriaInvalid(coffee);
+      status.textContent = '';
+      status.classList.remove('success');
+    }, true);
+
+    form.addEventListener('reset', () => {
+      coffee.removeAttribute('aria-invalid');
+    });
+
+    // Only reached once native constraint validation passes (incl. the required rating).
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      // <star-rating> contributes its value natively via ElementInternals.setFormValue().
+      const data = new FormData(form, event.submitter);
+
+      // Disabling the fieldset disables every control inside it — including <star-rating>,
+      // via its formDisabledCallback.
+      fields.disabled = true;
+      status.classList.remove('success');
+      status.textContent = 'Sending your feedback…';
+
+      try {
+        // No feedback API exists yet on this static site; simulate the round-trip.
+        await new Promise((resolve) => setTimeout(resolve, 1200));
+        const stars = Number(data.get('rating'));
+        const drink = coffee.selectedOptions[0].textContent;
+        form.reset();
+        status.classList.add('success');
+        status.textContent = `Thanks! Your ${stars}-star review of the ${drink} was received.`;
+      } catch {
+        status.textContent = 'Sorry, something went wrong. Please try again.';
+      } finally {
+        fields.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
