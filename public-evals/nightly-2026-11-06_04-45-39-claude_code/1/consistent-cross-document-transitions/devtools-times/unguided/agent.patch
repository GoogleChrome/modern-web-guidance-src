+      incoming view transition.
+    -->
+    <script is:inline blocking="render">
+      (() => {
+        const base = new URL(document.baseURI).origin;
+        const typeFor = (url) => {
+          if (!url) return "page";
+          const path = new URL(url, base).pathname;
+          if (/\/articles\//.test(path)) return "article";
+          if (/\/category\//.test(path)) return "category";
+          return "page";
+        };
+
+        const applyTypes = (transition, from, to, navType) => {
+          if (!transition || !transition.types) return;
+          const fromType = typeFor(from);
+          const toType = typeFor(to);
+          let direction = "forward";
+          if (navType === "traverse") direction = "back";
+          else if (fromType === "article" && toType !== "article") direction = "back";
+          transition.types.add(direction);
+          transition.types.add(`to-${toType}`);
+        };
+
+        // Outgoing page.
+        addEventListener("pageswap", (e) => {
+          if (!e.viewTransition || !e.activation) return;
+          applyTypes(
+            e.viewTransition,
+            location.href,
+            e.activation.entry && e.activation.entry.url,
+            e.activation.navigationType,
+          );
+        });
+
+        // Incoming page.
+        addEventListener("pagereveal", (e) => {
+          if (!e.viewTransition) return;
+          const activation = window.navigation && navigation.activation;
+          applyTypes(
+            e.viewTransition,
+            activation && activation.from && activation.from.url,
+            location.href,
+            activation && activation.navigationType,
+          );
+        });
+      })();
+    </script>
