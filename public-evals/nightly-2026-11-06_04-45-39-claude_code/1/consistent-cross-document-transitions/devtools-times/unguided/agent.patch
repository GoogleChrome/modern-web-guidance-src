+/* -------------------------------------------------------------------------
+ * Cross-document view transitions
+ * ---------------------------------------------------------------------- */
+
+@view-transition {
+  navigation: auto;
+}
+
+/*
+ * Keep the masthead visually stable across navigations. The name is only
+ * applied while a transition is running so the header doesn't become a
+ * permanent stacking context (which would affect its flyout menus).
+ */
+html:active-view-transition .masthead {
+  view-transition-name: masthead;
+}
+
+::view-transition-group(masthead) {
+  animation-duration: 0s;
+}
+
+@keyframes vt-fade-out {
+  to { opacity: 0; }
+}
+@keyframes vt-fade-in {
+  from { opacity: 0; }
+}
+@keyframes vt-slide-out-left {
+  to { transform: translateX(-40px); }
+}
+@keyframes vt-slide-in-right {
+  from { transform: translateX(40px); }
+}
+@keyframes vt-slide-out-right {
+  to { transform: translateX(40px); }
+}
+@keyframes vt-slide-in-left {
+  from { transform: translateX(-40px); }
+}
+
+/* Default: a quick cross-fade with a subtle horizontal slide. */
+::view-transition-old(root) {
+  animation:
+    180ms cubic-bezier(0.4, 0, 1, 1) both vt-fade-out,
+    260ms cubic-bezier(0.4, 0, 0.2, 1) both vt-slide-out-left;
+}
+::view-transition-new(root) {
+  animation:
+    240ms cubic-bezier(0, 0, 0.2, 1) 60ms both vt-fade-in,
+    260ms cubic-bezier(0.4, 0, 0.2, 1) both vt-slide-in-right;
+}
+
+/* Going "back" (history traversal, or leaving an article): reverse direction. */
+html:active-view-transition-type(back)::view-transition-old(root) {
+  animation:
+    180ms cubic-bezier(0.4, 0, 1, 1) both vt-fade-out,
+    260ms cubic-bezier(0.4, 0, 0.2, 1) both vt-slide-out-right;
+}
+html:active-view-transition-type(back)::view-transition-new(root) {
+  animation:
+    240ms cubic-bezier(0, 0, 0.2, 1) 60ms both vt-fade-in,
+    260ms cubic-bezier(0.4, 0, 0.2, 1) both vt-slide-in-left;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation: none !important;
+  }
+}
