+}
+/* ---------- Cross-document page transitions ---------- */
+
+@view-transition {
+  navigation: auto;
+}
+
+/* Users who prefer reduced motion get standard instant navigations. */
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+}
+
+/* The masthead is identical on every page: keep it pinned instead of fading it. */
+#masthead {
+  view-transition-name: masthead;
+}
+
+::view-transition-group(masthead) {
+  animation-duration: 0s;
+}
+
+/* Page content: quick fade + slight lift, compositor-only (opacity/translate). */
+::view-transition-old(root) {
+  animation: 180ms ease-in both vt-page-out;
+}
+
+::view-transition-new(root) {
+  animation: 280ms ease-out 60ms both vt-page-in;
+}
+
+@keyframes vt-page-out {
+  to {
+    opacity: 0;
+    translate: 0 -8px;
+  }
+}
+
+@keyframes vt-page-in {
+  from {
+    opacity: 0;
+    translate: 0 12px;
+  }
+}
