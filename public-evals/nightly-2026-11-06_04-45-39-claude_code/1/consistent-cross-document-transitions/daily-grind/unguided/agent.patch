@@ -0,0 +1,112 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Menu | The Daily Grind</title>
+  <!-- Initial theme/layout script: runs synchronously before first paint so
+       pages never flash the wrong theme during a view transition. -->
+  <script>
+    (function () {
+      var root = document.documentElement;
+      var theme;
+      try { theme = localStorage.getItem('dg-theme'); } catch (e) {}
+      if (theme !== 'light' && theme !== 'dark') {
+        theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+      }
+      root.dataset.theme = theme;
+      root.style.colorScheme = theme;
+    })();
+  </script>
+  <!-- Header styling + transition rules (render-blocking stylesheet) -->
+  <link rel="stylesheet" href="/styles.css">
+  <!-- Hold first render (and thus the incoming view transition) until the
+       above-the-fold content has been parsed; the footer is not awaited. -->
+  <link rel="expect" href="#menu-highlights" blocking="render">
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo"><a href="/">THE DAILY GRIND</a></div>
+    <ul>
+      <li><a href="/menu" aria-current="page">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--menu hero--compact">
+    <h1>Our Menu</h1>
+    <p>Small-batch roasts and house-made syrups, crafted to order.</p>
+  </header>
+
+  <main class="container">
+    <section id="menu-highlights">
+      <h2 style="text-align: center;">Seasonal Favorites</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <p class="price">$5.75</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <p class="price">$3.25</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <p class="price">$4.50</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+
+    <section style="margin-top: 40px;">
+      <h2 style="text-align: center;">Everyday Classics</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Cappuccino</h3>
+          <p>Equal parts espresso, steamed milk, and velvety foam.</p>
+          <p class="price">$4.25</p>
+        </div>
+        <div class="card">
+          <h3>Pour Over</h3>
+          <p>Single-origin beans, hand-brewed one cup at a time.</p>
+          <p class="price">$4.75</p>
+        </div>
+        <div class="card">
+          <h3>Chai Latte</h3>
+          <p>Spiced black tea simmered with steamed milk.</p>
+          <p class="price">$4.95</p>
+        </div>
+        <div class="card">
+          <h3>Butter Croissant</h3>
+          <p>Flaky, golden, and baked fresh every morning.</p>
+          <p class="price">$3.50</p>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+
+</body>
+
+</html>
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..b15c2f5
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,271 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+/* Dark theme (applied before first paint by the inline theme script) */
+:root[data-theme="dark"] {
+  --primary: #3e2723;
+  --secondary: #2b211e;
+  --accent: #ffb74d;
+  --text: #efebe9;
+  --light: #1b1412;
+}
+
+:root[data-theme="dark"] .card {
+  background: #2b211e;
+}
+
+:root[data-theme="dark"] .card h3 {
+  color: var(--accent);
+}
+
+nav a[aria-current="page"] {
+  color: var(--accent);
+}
+
+.page-intro {
+  text-align: center;
+  max-width: 640px;
+  margin: 0 auto;
+}
+
+.price {
+  font-weight: bold;
+  color: var(--primary);
+  margin-top: 8px;
+}
+
+:root[data-theme="dark"] .price {
+  color: var(--accent);
+}
+
+/* ---------- Cross-document page transitions ---------- */
+@view-transition {
+  navigation: auto;
+}
+
+/* The header persists across pages instead of cross-fading */
+nav {
+  view-transition-name: site-nav;
+}
+
+.hero {
+  view-transition-name: hero;
+}
+
+.hero h1 {
+  view-transition-name: hero-title;
+}
+
+::view-transition-group(*) {
+  animation-duration: 0.35s;
+  animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+::view-transition-old(root) {
+  animation: 0.25s cubic-bezier(0.4, 0, 1, 1) both vt-fade-out,
+    0.35s cubic-bezier(0.4, 0, 0.2, 1) both vt-slide-out;
+}
+
+::view-transition-new(root) {
+  animation: 0.3s cubic-bezier(0, 0, 0.2, 1) 0.05s both vt-fade-in,
+    0.35s cubic-bezier(0.4, 0, 0.2, 1) both vt-slide-in;
+}
+
+/* Keep the sticky nav visually static during the transition */
+::view-transition-old(site-nav),
+::view-transition-new(site-nav) {
+  animation: none;
+  mix-blend-mode: normal;
+}
+
+@keyframes vt-fade-out {
+  to { opacity: 0; }
+}
+
+@keyframes vt-fade-in {
+  from { opacity: 0; }
+}
+
+@keyframes vt-slide-out {
+  to { transform: translateY(-12px); }
+}
+
+@keyframes vt-slide-in {
+  from { transform: translateY(12px); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation: none !important;
+  }
+}
+
+/* Page-specific hero imagery (Unsplash stock photos) */
+.hero--menu {
+  background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1350&q=80');
+}
+
+.hero--locations {
+  background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=1350&q=80');
+}
+
+.hero--compact {
+  height: 40vh;
+}
+
+.logo a {
+  color: inherit;
+  font-size: inherit;
+}
+
+.logo a:hover {
+  color: inherit;
+}
