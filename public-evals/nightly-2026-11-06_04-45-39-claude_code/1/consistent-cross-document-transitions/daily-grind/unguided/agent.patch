+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+  <!-- Initial theme/layout script: runs synchronously before first paint so
+       pages never flash the wrong theme during a view transition. -->
+  <script>
+    (function () {
+      var root = document.documentElement;
+      var theme;
+      try { theme = localStorage.getItem('dg-theme'); } catch (e) {}
+      if (theme !== 'light' && theme !== 'dark') {
+        theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+      }
+      root.dataset.theme = theme;
+      root.style.colorScheme = theme;
+    })();
+  </script>
+  <!-- Header styling + transition rules (render-blocking stylesheet) -->
+  <link rel="stylesheet" href="/styles.css">
+  <!-- Hold first render (and thus the incoming view transition) until the
+       above-the-fold content has been parsed; the footer is not awaited. -->
+  <link rel="expect" href="#location-list" blocking="render">
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo"><a href="/">THE DAILY GRIND</a></div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--locations hero--compact">
+    <h1>Find Your Grind</h1>
+    <p>Neighborhood cafés with fresh roasts and familiar faces.</p>
+  </header>
+
+  <main class="container">
+    <section id="location-list">
+      <h2 style="text-align: center;">Our Cafés</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Downtown</h3>
+          <p>120 Main Street</p>
+          <p class="price">Mon–Sun · 6am–8pm</p>
+          <a href="/order-online" class="btn">Order Ahead</a>
+        </div>
+        <div class="card">
+          <h3>Riverside</h3>
+          <p>48 Harbor Avenue</p>
+          <p class="price">Mon–Sat · 7am–6pm</p>
+          <a href="/order-online" class="btn">Order Ahead</a>
+        </div>
+        <div class="card">
+          <h3>Uptown</h3>
+          <p>902 Elm Boulevard</p>
+          <p class="price">Mon–Sun · 6:30am–7pm</p>
+          <a href="/order-online" class="btn">Order Ahead</a>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+
+</body>
+
+</html>
