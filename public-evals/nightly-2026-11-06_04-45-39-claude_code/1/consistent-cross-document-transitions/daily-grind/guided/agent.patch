+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+
+  <link rel="stylesheet" href="/css/styles.css">
+  <script src="/js/theme.js" blocking="render"></script>
+
+  <link rel="preload" as="image" fetchpriority="high"
+    href="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=1350&q=80">
+
+  <!-- Above the fold: hero + café list. -->
+  <link rel="expect" href="#hero" blocking="render">
+  <link rel="expect" href="#our-cafes" blocking="render">
+</head>
+
+<body>
+
+  <nav>
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu/">Menu</a></li>
+      <li><a href="/locations/" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+      <li><button type="button" class="theme-toggle" aria-pressed="false">Dark mode</button></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--short hero--locations" id="hero">
+    <h1>Find Your Daily Grind</h1>
+    <p>Neighborhood cafés with the same great coffee.</p>
+  </header>
+
+  <main class="container">
+    <section id="our-cafes">
+      <h2 class="section-title">Our Cafés</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Downtown Roastery</h3>
+          <p>128 Main Street<br>Mon–Fri 6am–7pm · Sat–Sun 7am–6pm</p>
+          <a href="/locations/downtown" class="btn">Get Directions</a>
+        </div>
+        <div class="card">
+          <h3>Riverside</h3>
+          <p>45 Harbor Walk<br>Daily 6:30am–8pm</p>
+          <a href="/locations/riverside" class="btn">Get Directions</a>
+        </div>
+        <div class="card">
+          <h3>University Commons</h3>
+          <p>900 College Ave<br>Mon–Fri 7am–10pm · Sat–Sun 8am–8pm</p>
+          <a href="/locations/university" class="btn">Get Directions</a>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
