+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Menu | The Daily Grind</title>
+
+  <link rel="stylesheet" href="/css/styles.css">
+  <script src="/js/theme.js" blocking="render"></script>
+
+  <link rel="preload" as="image" fetchpriority="high"
+    href="https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1350&q=80">
+
+  <!-- Above the fold: hero + first menu section. -->
+  <link rel="expect" href="#hero" blocking="render">
+  <link rel="expect" href="#espresso-bar" blocking="render">
+</head>
+
+<body>
+
+  <nav>
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu/" aria-current="page">Menu</a></li>
+      <li><a href="/locations/">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+      <li><button type="button" class="theme-toggle" aria-pressed="false">Dark mode</button></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--short hero--menu" id="hero">
+    <h1>Our Menu</h1>
+    <p>Small-batch roasts, house-made syrups, and fresh-baked pastries.</p>
+  </header>
+
+  <main class="container">
+    <section id="espresso-bar">
+      <h2 class="section-title">Espresso Bar</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <span class="price">$3.25</span>
+        </div>
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <span class="price">$5.50</span>
+        </div>
+        <div class="card">
+          <h3>Classic Cappuccino</h3>
+          <p>Equal parts espresso, steamed milk, and velvety foam.</p>
+          <span class="price">$4.50</span>
+        </div>
+      </div>
+    </section>
+
+    <section id="cold-drinks">
+      <h2 class="section-title">Cold Drinks</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <span class="price">$4.75</span>
+        </div>
+        <div class="card">
+          <h3>Iced Honey Lavender Latte</h3>
+          <p>Local wildflower honey with a floral lavender finish.</p>
+          <span class="price">$5.75</span>
+        </div>
+        <div class="card">
+          <h3>Nitro Cold Brew</h3>
+          <p>Nitrogen-infused for a rich, creamy cascade.</p>
+          <span class="price">$5.25</span>
+        </div>
+      </div>
+    </section>
+
+    <section id="bakery">
+      <h2 class="section-title">Bakery</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Butter Croissant</h3>
+          <p>Flaky, golden, and baked fresh every morning.</p>
+          <span class="price">$3.50</span>
+        </div>
+        <div class="card">
+          <h3>Blueberry Muffin</h3>
+          <p>Bursting with wild blueberries and a crumb topping.</p>
+          <span class="price">$3.25</span>
+        </div>
+        <div class="card">
+          <h3>Cinnamon Roll</h3>
+          <p>Soft swirls of cinnamon with cream cheese icing.</p>
+          <span class="price">$4.00</span>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
