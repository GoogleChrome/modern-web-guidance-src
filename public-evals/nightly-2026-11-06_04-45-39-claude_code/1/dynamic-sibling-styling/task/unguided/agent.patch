+  <script>
+    /* Fallback for browsers without CSS sibling-index()/sibling-count():
+       exposes --i / --n on each item and keeps them in sync on DOM changes. */
+    (() => {
+      if (CSS.supports('order', 'sibling-index()')) return;
+      const SEL = '.spectrum-card, .fan-card, .circle-orb';
+      const sync = () => {
+        const parents = new Set([...document.querySelectorAll(SEL)].map(el => el.parentElement));
+        parents.forEach(parent => {
+          const kids = [...parent.children];
+          kids.forEach((el, i) => {
+            el.style.setProperty('--i', i);
+            el.style.setProperty('--n', kids.length);
+          });
+        });
+      };
+      sync();
+      new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
+    })();
+  </script>
