+    /* Showcase Section */
+    .showcase {
+      max-width: 1100px;
+      margin: 40px auto 0;
+      padding: 0 20px;
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 32px;
+      align-items: start;
+    }
+
+    /*
+     * Card wrapper: children are clipped at the content box edge.
+     * overflow-clip-margin: content-box makes the clip follow the inner
+     * (concentric) curve automatically: border-radius minus padding.
+     */
+    .nested-curve-parent {
+      --curve-radius: 32px;
+      --curve-padding: 14px;
+      background: var(--primary);
+      padding: var(--curve-padding);
+      border-radius: var(--curve-radius);
+      box-shadow: 0 10px 30px rgba(62, 39, 35, 0.25);
+      overflow: hidden; /* fallback for browsers without overflow: clip */
+      overflow: clip;
+      overflow-clip-margin: content-box;
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      height: 220px;
+      object-fit: cover;
+    }
+
+    .nested-curve-parent .curve-body {
+      background: white;
+      padding: 20px;
+    }
+
+    .nested-curve-parent .curve-body h3 {
+      color: var(--primary);
+      margin-bottom: 6px;
+    }
+
+    .nested-curve-parent .curve-footer {
+      background: var(--accent);
+      color: var(--text);
+      padding: 12px 20px;
+      font-weight: 600;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+    }
+
+    /*
+     * Promos block: overflowing content is clipped, but the clip edge is
+     * pushed 15px outside the padding box so the button's glow can bleed out.
+     */
+    .safety-zone-parent {
+      background: var(--secondary);
+      border-radius: 16px;
+      padding: 24px;
+      max-height: 320px;
+      overflow: hidden; /* fallback for browsers without overflow: clip */
+      overflow: clip;
+      overflow-clip-margin: 15px;
+    }
+
+    .safety-zone-parent h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .safety-zone-parent .promo-ticker {
+      white-space: nowrap;
+      font-weight: 600;
+      color: var(--primary);
+      margin-bottom: 12px;
+    }
+
+    .safety-zone-parent .promo-text {
+      margin-bottom: 16px;
+    }
+
+    .glow-btn {
+      display: inline-block;
+      background: var(--accent);
