+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackInput = document.getElementById('feedback-message');
+    const feedbackStatus = document.getElementById('feedback-status');
+
+    feedbackInput.addEventListener('keydown', (event) => {
+      if (event.key === 'Enter' && !event.shiftKey) {
+        event.preventDefault();
+        // Don't submit while an IME is composing (keyCode 229 covers Safari).
+        if (event.isComposing || event.keyCode === 229) return;
+        feedbackForm.requestSubmit();
+      }
+    });
+
+    feedbackForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!feedbackInput.value.trim()) {
+        feedbackStatus.textContent = 'Please enter some feedback first.';
+        return;
+      }
+      // TODO: send to a backend endpoint once one exists.
+      feedbackForm.reset();
+      feedbackStatus.textContent = 'Thanks for your feedback!';
+    });
+  </script>
+
