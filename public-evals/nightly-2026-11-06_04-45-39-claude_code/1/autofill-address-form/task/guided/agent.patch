+  <script>
+    // Keep aria-invalid in sync with the CSS :user-invalid state of the shipping form.
+    (() => {
+      const form = document.getElementById('shipping-form');
+      const supportsUserInvalid = CSS.supports('selector(:user-invalid)');
+      const sync = (el) => {
+        if (!el.willValidate) return;
+        const invalid = supportsUserInvalid ? el.matches(':user-invalid') : !el.checkValidity();
+        el.setAttribute('aria-invalid', String(invalid));
+      };
+      form.addEventListener('focusout', (e) => sync(e.target));
+      form.addEventListener('input', (e) => {
+        if (e.target.hasAttribute('aria-invalid')) sync(e.target);
+      });
+      form.addEventListener('change', (e) => sync(e.target));
+      form.addEventListener('submit', (e) => {
+        if (form.dataset.submitting) {
+          e.preventDefault();
+          return;
+        }
+        form.dataset.submitting = 'true';
+        form.querySelector('button[type="submit"]').disabled = true;
+      });
+      form.addEventListener('invalid', (e) => e.target.setAttribute('aria-invalid', 'true'), true);
+    })();
+  </script>
+
