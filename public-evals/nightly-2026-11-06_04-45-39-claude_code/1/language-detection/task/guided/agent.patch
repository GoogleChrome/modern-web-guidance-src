+  <script type="module">
+    const form = document.getElementById('feedback-form');
+    const textarea = document.getElementById('feedback-message');
+    const button = document.getElementById('detect-btn');
+    const progress = document.getElementById('detect-progress');
+    const status = document.getElementById('detect-status');
+
+    const displayNames = new Intl.DisplayNames([navigator.language || 'en'], { type: 'language' });
+    const percent = new Intl.NumberFormat(undefined, { style: 'percent', maximumFractionDigits: 1 });
+
+    let detectorPromise = null;
+
+    function setStatus(message, isError = false) {
+      status.textContent = message;
+      status.classList.toggle('error', isError);
+    }
+
+    function disable(message) {
+      button.disabled = true;
+      textarea.disabled = true;
+      setStatus(message, true);
+    }
+
+    function languageName(code) {
+      try {
+        return displayNames.of(code) ?? code;
+      } catch {
+        return code;
+      }
+    }
+
+    // Must be called from a user gesture: create() may trigger a model download.
+    function getDetector() {
+      detectorPromise ??= LanguageDetector.create({
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const pct = Math.round(e.loaded * 100);
+            progress.hidden = false;
+            progress.value = pct;
+            setStatus(`Downloading language model… ${pct}%`);
+          });
+        },
+      }).catch((err) => {
+        detectorPromise = null; // allow retry
+        throw err;
+      });
+      return detectorPromise;
+    }
+
+    async function init() {
+      if (!('LanguageDetector' in self)) {
+        disable('Language detection isn\'t supported in this browser.');
+        return;
+      }
+      try {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          disable('Language detection is unavailable on this device.');
+        } else if (availability !== 'available') {
+          setStatus('The language model will be downloaded the first time you click Detect.');
+        }
+      } catch (err) {
+        disable('Language detection could not be initialized.');
+        console.error(err);
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const text = textarea.value.trim();
+      if (!text) {
+        setStatus('Please enter a message first.', true);
+        textarea.focus();
+        return;
+      }
+
+      button.disabled = true;
+      setStatus('Detecting…');
+      try {
+        const detector = await getDetector();
+        progress.hidden = true;
+        const [top] = await detector.detect(text);
+        if (!top || top.detectedLanguage === 'und') {
+          setStatus('Couldn\'t determine the language. Try writing a longer message.');
+        } else {
+          setStatus(`Language: ${languageName(top.detectedLanguage)} (${percent.format(top.confidence)} confidence)`);
+        }
+      } catch (err) {
+        progress.hidden = true;
+        setStatus(`Language detection failed: ${err.message}`, true);
+        console.error(err);
+      } finally {
+        button.disabled = false;
+      }
+    });
+
+    init();
+  </script>
+
 </body>
 
