     .btn:hover {
       background: #3e2723;
     }
 
+    /* Sticky section headers */
+    .content-section {
+      margin-top: 40px;
+      /* Prevent scroll-anchoring flicker when the stuck header changes padding */
+      overflow-anchor: none;
+    }
+
+    .intro {
+      max-width: 750px;
+      margin: 0 auto;
+      text-align: center;
+    }
+
+    .intro p + p {
+      margin-top: 1rem;
+    }
+
+    .sticky-container {
+      position: sticky;
+      /* Stick just below the existing sticky site nav */
+      top: var(--nav-height);
+      z-index: 10;
+      /* Named container so it never collides with other (nested) containers */
+      container-type: scroll-state;
+      container-name: section-header;
+    }
+
+    .sticky-header {
+      background: var(--secondary);
+      color: var(--primary);
+      padding: 1.25rem 1.5rem;
+      border-radius: 8px;
+      text-align: center;
+      font-size: 1.6rem;
+      transition: background-color 0.3s, color 0.3s, box-shadow 0.3s, padding 0.3s, font-size 0.3s;
+    }
+
+    @container section-header scroll-state(stuck: top) {
+      .sticky-header {
+        background: var(--sticky-blue);
+        color: white;
+        padding: 0.4rem 1.5rem;
+        font-size: 1.2rem;
+        border-radius: 0 0 8px 8px;
+        box-shadow: 0 4px 10px rgb(0 0 0 / 0.25);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .sticky-header {
+        transition: none;
+      }
+    }
+
+    .card img {
+      width: 100%;
+      height: 180px;
+      object-fit: cover;
+      border-radius: 6px;
+      margin-bottom: 15px;
+    }
+
+    .list {
+      list-style: none;
+      margin-top: 20px;
+      display: grid;
+      gap: 15px;
+    }
+
+    .list li {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .list h3 {
+      color: var(--primary);
+      margin-bottom: 5px;
+    }
+
     footer {
