+  <script>
+    // Fallback for browsers without CSS scroll-state container queries:
+    // toggle .is-stuck when a sticky header is pinned below the nav.
+    if (!(window.CSS && CSS.supports('container-type', 'scroll-state'))) {
+      const containers = document.querySelectorAll('.sticky-container');
+      const update = () => {
+        containers.forEach((el) => {
+          const top = parseFloat(getComputedStyle(el).top) || 0;
+          const rect = el.getBoundingClientRect();
+          const parentRect = el.parentElement.getBoundingClientRect();
+          const pinned = Math.abs(rect.top - top) < 1 && parentRect.top < top - 1;
+          el.classList.toggle('is-stuck', pinned);
+        });
+      };
+      window.addEventListener('scroll', update, { passive: true });
+      window.addEventListener('resize', update);
+      update();
+    }
+  </script>
