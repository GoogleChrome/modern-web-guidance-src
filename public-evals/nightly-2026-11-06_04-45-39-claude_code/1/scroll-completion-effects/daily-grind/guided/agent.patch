+  <script>
+    (() => {
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      const navLinks = [...document.querySelectorAll('nav a[href^="#"]')];
+      const targets = document.querySelectorAll('.nav-target');
+      const announcer = document.getElementById('nav-announcer');
+      let currentScrollId = 0;
+
+      // Resolve once the scroll has finished. Uses the Promise returned by
+      // scrollIntoView() where supported, otherwise falls back to scrollend
+      // plus an idle timeout (covers already-in-view targets and browsers
+      // without scrollend).
+      function scrollIntoViewAsync(element, options, scroller = window) {
+        const result = element.scrollIntoView(options);
+        if (result instanceof Promise) return result;
+
+        return new Promise((resolve) => {
+          let timeoutId;
+          const finish = () => {
+            clearTimeout(timeoutId);
+            scroller.removeEventListener('scrollend', finish);
+            scroller.removeEventListener('scroll', onScroll);
+            resolve();
+          };
+          const onScroll = () => {
+            clearTimeout(timeoutId);
+            timeoutId = setTimeout(finish, 100);
+          };
+          scroller.addEventListener('scrollend', finish, { once: true });
+          scroller.addEventListener('scroll', onScroll, { passive: true });
+          timeoutId = setTimeout(finish, 100);
+        });
+      }
+
+      async function navigateTo(target, link) {
+        const scrollId = ++currentScrollId;
+        targets.forEach((t) => t.classList.remove('arrived'));
+        navLinks.forEach((a) => a.removeAttribute('aria-current'));
+        link?.setAttribute('aria-current', 'true');
+
+        await scrollIntoViewAsync(target, {
+          behavior: reducedMotion.matches ? 'auto' : 'smooth',
+          block: 'start',
+        });
+
+        // A newer navigation superseded this one while scrolling.
+        if (scrollId !== currentScrollId) return;
+
+        const heading = target.querySelector('h2');
+        heading?.focus({ preventScroll: true });
+
+        // Force a reflow so the animation restarts on repeat visits.
+        void target.offsetWidth;
+        target.classList.add('arrived');
+
+        if (announcer && heading) {
+          announcer.textContent = `Moved to ${heading.textContent}`;
+        }
+      }
+
+      targets.forEach((t) =>
+        t.addEventListener('animationend', (e) => {
+          if (e.target === t) t.classList.remove('arrived');
+        })
+      );
+
+      navLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const target = document.querySelector(link.getAttribute('href'));
+          if (!target) return;
+          event.preventDefault();
+          if (location.hash !== link.hash) history.pushState(null, '', link.hash);
+          navigateTo(target, link);
+        });
+      });
+
+      // Support back/forward between in-page sections.
+      window.addEventListener('popstate', () => {
+        const target = location.hash && document.querySelector(location.hash);
+        if (!target) return;
+        navigateTo(target, navLinks.find((a) => a.hash === location.hash));
+      });
+    })();
+  </script>
+
