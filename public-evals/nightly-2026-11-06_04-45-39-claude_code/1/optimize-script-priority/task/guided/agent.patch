+  </style>
+</head>
+<body>
+  <h1>Dashboard</h1>
+  <main>
+    <section><h2>Users</h2><p>—</p></section>
+    <section><h2>Revenue</h2><p>—</p></section>
+    <section><h2>Widgets</h2><div id="legacy-widgets"></div></section>
+  </main>
