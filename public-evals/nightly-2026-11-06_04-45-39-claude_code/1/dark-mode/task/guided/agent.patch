+  <script>
+    // ---- Theme picker: system / light / dark ----
+    (() => {
+      const KEY = "color-scheme";
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const select = document.getElementById("theme-select");
+      const systemOption = select.querySelector('option[value="light dark"]');
+      const darkQuery = matchMedia("(prefers-color-scheme: dark)");
+
+      const readStored = () => {
+        try { return localStorage.getItem(KEY); } catch { return null; }
+      };
+
+      // Updating the <meta> forces the scheme on :root via the CSS :has() mapping.
+      const apply = (value) => {
+        const scheme = value === "light" || value === "dark" ? value : "light dark";
+        meta.content = scheme;
+        select.value = scheme;
+      };
+
+      const updateSystemLabel = () => {
+        systemOption.textContent = `System (currently ${darkQuery.matches ? "dark" : "light"})`;
+      };
+
+      select.addEventListener("change", () => {
+        const value = select.value;
+        apply(value);
+        try {
+          if (value === "light dark") localStorage.removeItem(KEY);
+          else localStorage.setItem(KEY, value);
+        } catch { /* theme still applied, just not persisted */ }
+      });
+
+      // Keep the "System (currently …)" label accurate as the OS preference changes.
+      darkQuery.addEventListener("change", updateSystemLabel);
+
+      // Sync overrides made in other tabs.
+      addEventListener("storage", (e) => {
+        if (e.key === KEY || e.key === null) apply(readStored());
+      });
+
+      updateSystemLabel();
+      apply(readStored());
+    })();
+
+    // ---- Late night specials filter ----
+    (() => {
+      const filter = document.getElementById("late-night-filter");
+      const items = document.querySelectorAll(".late-night-list .special");
+      filter.addEventListener("change", () => {
+        for (const item of items) {
+          item.hidden = filter.value !== "all" && item.dataset.category !== filter.value;
+        }
+      });
+    })();
+  </script>
+
