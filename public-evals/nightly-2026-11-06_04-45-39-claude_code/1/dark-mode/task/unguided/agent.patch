+  <script>
+    (function () {
+      var root = document.documentElement;
+      var meta = document.querySelector('meta[name="color-scheme"]');
+      var select = document.getElementById('theme-select');
+
+      function applyTheme(theme) {
+        if (theme === 'light' || theme === 'dark') {
+          root.setAttribute('data-theme', theme);
+          meta.setAttribute('content', theme);
+        } else {
+          theme = 'system';
+          root.removeAttribute('data-theme');
+          meta.setAttribute('content', 'light dark');
+        }
+        try {
+          if (theme === 'system') localStorage.removeItem('theme');
+          else localStorage.setItem('theme', theme);
+        } catch (e) { /* ignore */ }
+        select.value = theme;
+      }
+
+      select.value = root.getAttribute('data-theme') || 'system';
+      select.addEventListener('change', function () { applyTheme(select.value); });
+
+      // Late night specials filter
+      var filter = document.getElementById('late-night-filter');
+      var specials = document.querySelectorAll('.late-night .special');
+      filter.addEventListener('change', function () {
+        specials.forEach(function (el) {
+          el.hidden = filter.value !== 'all' && el.dataset.category !== filter.value;
+        });
+      });
+    })();
+  </script>
+
