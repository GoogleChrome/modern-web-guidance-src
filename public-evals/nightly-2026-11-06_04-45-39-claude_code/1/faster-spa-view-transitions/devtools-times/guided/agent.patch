+}
+/*
+ * SPA view cache (src/scripts/view-cache.ts).
+ * Inactive views stay in the DOM. `content-visibility: hidden` skips their
+ * layout and paint but keeps their rendering state, so going back to them is
+ * almost instant. They are also taken out of flow so they don't add height.
+ */
+.spa-view:focus {
+  outline: none;
+}
+
+.spa-view[data-view-inactive] {
+  content-visibility: hidden;
+  position: absolute;
+  inset: 0 0 auto 0;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view[data-view-inactive] {
+    display: none;
+  }
+}
