+          starsEl.textContent = stars;
+          progress.value = Math.min(stars, GOAL);
+          next.textContent = stars >= GOAL
+            ? 'You have enough stars for a free drink!'
+            : `${GOAL - stars} stars until your next free drink.`;
+          for (const b of buttons) b.disabled = Number(b.dataset.cost) > stars;
+        }
+
+        view.addEventListener('click', (e) => {
+          const b = e.target.closest('[data-cost]');
