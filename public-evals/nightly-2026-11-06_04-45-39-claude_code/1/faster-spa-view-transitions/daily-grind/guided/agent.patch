+            view.inert = true;
+            view.setAttribute('aria-hidden', 'true');
+          }
+          next.classList.remove('inactive');
+          next.inert = false;
+          next.removeAttribute('aria-hidden');
+          currentId = route.id;
+          window.scrollTo(0, restoreScroll ? scrollPositions.get(route.id) ?? 0 : 0);
+          if (focus) next.focus({ preventScroll: true });
+        }
