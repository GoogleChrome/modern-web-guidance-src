+  <script>
+    (() => {
+      const ROUTES = {
+        '/': { id: 'home', title: 'The Daily Grind | Artisanal Coffee' },
+        '/menu': { id: 'menu', title: 'Menu | The Daily Grind', init: initMenu },
+        '/locations': { id: 'locations', title: 'Locations | The Daily Grind', init: initLocations },
+        '/rewards': { id: 'rewards', title: 'Rewards | The Daily Grind', init: initRewards },
+        '/account': { id: 'account', title: 'My Account | The Daily Grind', init: initAccount },
+      };
+
+      const app = document.getElementById('app');
+      const navLinks = document.querySelectorAll('nav a[href]');
+      const views = new Map([['home', document.getElementById('view-home')]]);
+      const scrollPositions = new Map();
+      let currentId = null;
+
+      function normalize(pathname) {
+        const clean = pathname.replace(/\/index\.html$/, '/').replace(/\/+$/, '') || '/';
+        if (ROUTES[clean]) return { path: clean, sub: null };
+        // Sub-routes like /menu/espresso map onto their parent view.
+        const [, base, sub] = clean.match(/^(\/[^/]+)\/(.+)$/) || [];
+        if (base && ROUTES[base]) return { path: base, sub };
+        return null;
+      }
+
+      // Lazily create a view the first time it is visited; afterwards it is reused.
+      function getView(route) {
+        let view = views.get(route.id);
+        if (view) return view;
+        view = document.createElement('div');
+        view.className = 'spa-view inactive';
+        view.id = `view-${route.id}`;
+        view.tabIndex = -1;
+        view.setAttribute('aria-label', route.title.split(' | ')[0]);
+        view.inert = true;
+        view.append(document.getElementById(`tpl-${route.id}`).content.cloneNode(true));
+        app.append(view);
+        route.init?.(view);
+        views.set(route.id, view);
+        return view;
+      }
+
+      function render({ path, sub }, { focus = true, restoreScroll = false } = {}) {
+        const route = ROUTES[path];
+        const next = getView(route);
+
+        if (route.id !== currentId) {
+          if (currentId) scrollPositions.set(currentId, window.scrollY);
+          // Deactivate (but keep) every other view: content-visibility: hidden
+          // retains its rendering state so returning is near-instant.
+          for (const [id, view] of views) {
+            if (view === next) continue;
