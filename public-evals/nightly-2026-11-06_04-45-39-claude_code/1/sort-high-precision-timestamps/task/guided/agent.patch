+  <script type="module">
+    // Temporal.Instant keeps full nanosecond precision; Date would truncate to ms.
+    async function ensureTemporal() {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+      }
+      return globalThis.Temporal;
+    }
+
+    const button = document.getElementById('load-events');
+    const statusEl = document.getElementById('timeline-status');
+    const output = document.getElementById('timeline-output');
+    const tbody = document.getElementById('timeline-body');
+
+    function formatDuration(duration) {
+      if (duration.blank) return '0 ns (same instant)';
+      try {
+        return duration.toLocaleString(undefined, { style: 'narrow' });
+      } catch {
+        return duration.toString();
+      }
+    }
+
+    function cell(text, className) {
+      const td = document.createElement('td');
+      td.textContent = text;
+      if (className) td.className = className;
+      return td;
+    }
+
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      statusEl.classList.remove('error');
+      statusEl.textContent = 'Loading order events…';
+      try {
+        const [Temporal, response] = await Promise.all([ensureTemporal(), fetch('order-events.json')]);
+        if (!response.ok) throw new Error(`HTTP ${response.status}`);
+        const raw = await response.json();
+
+        const events = raw.map(evt => ({ ...evt, instant: Temporal.Instant.from(evt.ts) }));
+        // Stable sort: ties keep their arrival order.
+        const sorted = events.toSorted((a, b) => Temporal.Instant.compare(a.instant, b.instant));
+
+        const rows = sorted.map((evt, i) => {
+          const prev = sorted[i - 1];
+          // Balance up to hours so long gaps read naturally; sub-second units stay exact.
+          const gap = prev ? evt.instant.since(prev.instant, { largestUnit: 'hours' }) : null;
+          const tr = document.createElement('tr');
+          if (prev && evt.instant.equals(prev.instant)) tr.className = 'tie';
+          tr.append(
+            cell(String(i + 1)),
+            cell(evt.instant.toString({ fractionalSecondDigits: 9 }), 'mono'),
+            cell(evt.service),
+            cell(evt.type),
+            cell(evt.orderId),
+            cell(gap ? formatDuration(gap) : '—', 'mono'),
+          );
+          return tr;
+        });
+        tbody.replaceChildren(...rows);
+        output.hidden = false;
+
+        const total = sorted.length > 1
+          ? sorted.at(-1).instant.since(sorted[0].instant, { largestUnit: 'hours' })
+          : null;
+        const ties = sorted.filter((e, i) => i > 0 && e.instant.equals(sorted[i - 1].instant)).length;
+        statusEl.textContent = `Sorted ${sorted.length} events` +
+          (total ? `, spanning ${formatDuration(total)}` : '') +
+          (ties ? `. ${ties} event(s) share an exact timestamp with the previous one (highlighted).` : '.');
+      } catch (err) {
+        statusEl.classList.add('error');
+        statusEl.textContent = `Couldn't load order events: ${err.message}`;
+        output.hidden = true;
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
+
