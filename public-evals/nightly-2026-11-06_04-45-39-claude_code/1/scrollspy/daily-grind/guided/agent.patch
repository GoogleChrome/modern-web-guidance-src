+  <script type="module">
+    const navLinks = [...document.querySelectorAll('.nav-sections a')];
+
+    const setCurrent = (activeLink) => {
+      navLinks.forEach((link) => {
+        if (link === activeLink) {
+          link.setAttribute('aria-current', 'true');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    };
+
+    if (CSS.supports('scroll-target-group: auto')) {
+      // Native scrollspy handles the visuals; mirror the state for assistive tech.
+      const syncAriaCurrent = () => setCurrent(document.querySelector('.nav-sections a:target-current'));
+      syncAriaCurrent();
+      document.addEventListener('scrollend', syncAriaCurrent);
+    } else {
+      // Fallback: watch a thin band just below the sticky nav.
+      const sections = navLinks
+        .map((link) => document.querySelector(link.getAttribute('href')))
+        .filter(Boolean);
+      const visible = new Set();
+
+      const update = () => {
+        // Pick the first section (in document order) inside the band.
+        const current = sections.find((section) => visible.has(section));
+        const activeLink = current ? navLinks.find((link) => link.hash === `#${current.id}`) : null;
+        navLinks.forEach((link) => link.classList.toggle('target-current', link === activeLink));
+        setCurrent(activeLink);
+      };
+
+      const observer = new IntersectionObserver((entries) => {
+        entries.forEach((entry) => {
+          if (entry.isIntersecting) visible.add(entry.target);
+          else visible.delete(entry.target);
+        });
+        update();
+      }, { rootMargin: '-35% 0px -60% 0px', threshold: 0 });
+
+      sections.forEach((section) => observer.observe(section));
+    }
+  </script>
+
