+  <script>
+    // Element-scoped view transitions: each card / the order panel animates in
+    // isolation, so the rest of the page stays interactive and several
+    // components can transition at the same time.
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+    function runScopedTransition(scopeEl, updateDOM) {
+      if (!supportsScopedTransition) {
+        // Graceful degradation: apply the change instantly.
+        updateDOM();
+        return;
+      }
+      const transition = scopeEl.startViewTransition(updateDOM);
+      // Rapid re-triggers on the same scope skip the active transition.
+      transition.ready.catch(() => {});
+    }
+
+    const money = (n) => `$${n.toFixed(2)}`;
+
+    function cardSelection(card) {
+      const checked = card.querySelector('input[type="radio"]:checked');
+      const price = Number(card.dataset.price) + Number(checked.dataset.extra);
+      return { name: card.dataset.name, size: checked.value, price };
+    }
+
+    function updateCardPrice(card) {
+      card.querySelector('.price').textContent = money(cardSelection(card).price);
+    }
+
+    // ----- Cards -----
+    document.querySelectorAll('.card').forEach((card) => {
+      updateCardPrice(card);
+
+      const details = card.querySelector('.card-details');
+      const toggle = card.querySelector('[data-action="customize"]');
+
+      toggle.addEventListener('click', () => {
+        const expand = details.hidden;
+        runScopedTransition(card, () => {
+          details.hidden = !expand;
+          toggle.setAttribute('aria-expanded', String(expand));
+          toggle.textContent = expand ? 'Done' : 'Customize';
+        });
+      });
+
+      card.addEventListener('change', (e) => {
+        if (e.target.matches('input[type="radio"]')) updateCardPrice(card);
+      });
+
+      card.querySelector('[data-action="add"]').addEventListener('click', () => {
+        addToOrder(cardSelection(card));
+      });
+    });
+
+    // ----- Order panel -----
+    const panel = document.querySelector('.order-panel');
+    const list = panel.querySelector('.order-list');
+    const empty = panel.querySelector('.order-empty');
+    const totalOut = panel.querySelector('.order-total output');
+    const sortBtn = panel.querySelector('[data-action="sort"]');
+    const clearBtn = panel.querySelector('[data-action="clear"]');
+    let sortAscending = true;
+
+    function refreshSummary() {
+      const items = [...list.children];
+      const total = items.reduce((sum, li) => sum + Number(li.dataset.price), 0);
+      totalOut.textContent = money(total);
+      empty.hidden = items.length > 0;
+      sortBtn.disabled = clearBtn.disabled = items.length < 1;
+    }
+
+    function createItem({ name, size, price }) {
+      const li = document.createElement('li');
+      li.dataset.price = price;
+      const label = document.createElement('span');
+      label.className = 'name';
+      label.textContent = name;
+      const meta = document.createElement('small');
+      meta.textContent = `${size} · ${money(price)}`;
+      label.append(meta);
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.className = 'remove-btn';
+      remove.setAttribute('aria-label', `Remove ${size} ${name}`);
+      remove.textContent = '×';
+      li.append(label, remove);
+      return li;
+    }
+
+    function addToOrder(item) {
+      runScopedTransition(panel, () => {
+        list.append(createItem(item));
+        refreshSummary();
+      });
+    }
+
+    function removeItem(li) {
+      const hadFocus = li.contains(document.activeElement);
+      const nextFocus =
+        li.nextElementSibling?.querySelector('button') ??
+        li.previousElementSibling?.querySelector('button') ??
+        sortBtn;
+
+      runScopedTransition(panel, () => {
+        li.remove();
+        refreshSummary();
+        if (hadFocus) (nextFocus.disabled ? panel.querySelector('h3') : nextFocus).focus();
+      });
+    }
+
+    list.addEventListener('click', (e) => {
+      const btn = e.target.closest('.remove-btn');
+      if (btn) removeItem(btn.closest('li'));
+    });
+
+    sortBtn.addEventListener('click', () => {
+      // Move existing nodes (not innerHTML) so `match-element` can track them.
+      const sorted = [...list.children].sort((a, b) =>
+        sortAscending ? a.dataset.price - b.dataset.price : b.dataset.price - a.dataset.price
+      );
+      runScopedTransition(list, () => {
+        list.append(...sorted);
+      });
+      sortAscending = !sortAscending;
+      sortBtn.textContent = sortAscending ? 'Sort by price' : 'Sort by price ↓';
+    });
+
+    clearBtn.addEventListener('click', () => {
+      const hadFocus = clearBtn === document.activeElement;
+      runScopedTransition(panel, () => {
+        list.replaceChildren();
+        refreshSummary();
+        if (hadFocus) panel.querySelector('h3').focus();
+      });
+    });
+
+    panel.querySelector('h3').tabIndex = -1;
+    refreshSummary();
+  </script>
+
