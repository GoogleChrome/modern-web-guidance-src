+    /* ---------- Scoped view transition styling ---------- */
+    ::view-transition-group(*) {
+      animation-duration: 300ms;
+      animation-timing-function: ease-in-out;
+    }
+
+    /* Items entering the order list slide in; leaving items slide out. */
+    ::view-transition-new(.order-item):only-child {
+      animation: 300ms ease-out both slide-in;
+    }
+
+    ::view-transition-old(.order-item):only-child {
+      animation: 250ms ease-in both slide-out;
+    }
+
+    @keyframes slide-in {
+      from {
+        opacity: 0;
+        transform: translateX(30px);
+      }
+    }
+
+    @keyframes slide-out {
+      to {
+        opacity: 0;
+        transform: translateX(-30px);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
