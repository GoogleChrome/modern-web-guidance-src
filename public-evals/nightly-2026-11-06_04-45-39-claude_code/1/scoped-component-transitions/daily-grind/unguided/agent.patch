+  <script>
+    /* =====================================================================
+       Scoped transitions
+       ---------------------------------------------------------------------
+       scopedTransition(scope, update) animates a DOM change *inside* `scope`
+       only. The rest of the page stays interactive and transitions running
+       in other scopes keep going.
+
+       - Uses element-scoped View Transitions (Element.startViewTransition)
+         when the browser supports them.
+       - Otherwise falls back to a FLIP animation with the Web Animations API,
+         which is equally local and non-blocking.
+       - Deliberately never uses document.startViewTransition(), which would
+         freeze the entire page and cancel other running transitions.
+       ===================================================================== */
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const nativeScoped = typeof Element.prototype.startViewTransition === 'function';
+    const running = new WeakMap(); // scope -> { cancel() }
+
+    function scopedTransition(scope, update) {
+      // A new transition in the same scope supersedes the old one. Other
+      // scopes are untouched.
+      if (reducedMotion.matches) {
+        running.get(scope)?.cancel();
+        update();
+        return Promise.resolve();
+      }
+
+      if (nativeScoped) {
+        running.get(scope)?.cancel();
+        const vt = scope.startViewTransition(update);
+        const entry = { cancel: () => vt.skipTransition() };
+        running.set(scope, entry);
+        vt.finished.finally(() => {
+          if (running.get(scope) === entry) running.delete(scope);
+        });
+        return vt.finished.catch(() => {});
+      }
+
+      return flipTransition(scope, update);
+    }
+
+    /* FLIP fallback: elements that carry a view-transition-name are tracked
+       by that name, so the same markup drives both code paths. */
+    function flipTransition(scope, update) {
+      const tracked = () => [...scope.querySelectorAll('[data-vt]')];
+      const opts = { duration: 320, easing: 'cubic-bezier(0.2, 0, 0, 1)' };
+
+      const firstScope = scope.getBoundingClientRect();
+      const first = new Map();
+      for (const el of tracked()) {
+        first.set(el.dataset.vt, el.getBoundingClientRect());
+      }
+
+      // Measure *before* cancelling an in-flight animation so an interrupted
+      // transition continues from where it visually is instead of jumping.
+      running.get(scope)?.cancel();
+
+      update();
+
+      const lastScope = scope.getBoundingClientRect();
+      const anims = [];
+
+      // Morph the scope's own height so neighbours reflow smoothly.
+      if (Math.abs(firstScope.height - lastScope.height) > 0.5) {
+        anims.push(scope.animate(
+          [{ height: firstScope.height + 'px', overflow: 'hidden' },
+           { height: lastScope.height + 'px', overflow: 'hidden' }],
+          opts
+        ));
+      }
+
+      for (const el of tracked()) {
+        const key = el.dataset.vt;
+        const last = el.getBoundingClientRect();
+        const prev = first.get(key);
+
+        if (el.classList.contains('card-bg')) {
+          // The surface fills the scope, which is already animating.
+          continue;
+        }
+
+        if (!prev) {
+          anims.push(el.animate(
+            [{ opacity: 0, transform: 'translateY(-6px) scale(0.96)' },
+             { opacity: 1, transform: 'none' }],
+            { ...opts, delay: 60, fill: 'backwards' }
+          ));
+          continue;
+        }
+
+        const dx = prev.left - last.left;
+        const dy = prev.top - last.top;
+        if (Math.abs(dx) > 0.5 || Math.abs(dy) > 0.5) {
+          anims.push(el.animate(
+            [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }],
+            opts
+          ));
+        }
+      }
+
+      const entry = { cancel: () => anims.forEach(a => a.cancel()) };
+      running.set(scope, entry);
+      return Promise.allSettled(anims.map(a => a.finished)).then(() => {
+        if (running.get(scope) === entry) running.delete(scope);
+      });
+    }
+
+    /* Give an element a transition identity for both code paths. */
+    function nameEl(el, name, cls) {
+      el.dataset.vt = name;
+      el.style.viewTransitionName = name;
+      if (cls) el.style.viewTransitionClass = cls;
+      return el;
+    }
+
+    /* =====================================================================
+       Data
+       ===================================================================== */
+    const products = [
+      {
+        id: 'maple', name: 'Maple Oat Latte', price: 5.25, href: '/menu/seasonal',
+        blurb: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        details: { Origin: 'Colombia & Ethiopia blend', Sizes: '12 / 16 / 20 oz', Notes: 'Toasted maple, brown sugar, oat', Caffeine: 'Medium' }
+      },
+      {
+        id: 'espresso', name: 'Dark Roast Espresso', price: 3.50, href: '/menu/espresso',
+        blurb: 'Bold, smokey, and perfect for a morning boost.',
+        details: { Origin: 'Sumatra', Sizes: 'Single / Double', Notes: 'Dark chocolate, cedar, smoke', Caffeine: 'High' }
+      },
+      {
+        id: 'cold-brew', name: 'Cold Brew', price: 4.75, href: '/menu/cold-brew',
+        blurb: 'Steeped for 18 hours for maximum smoothness.',
+        details: { Origin: 'Brazil', Sizes: '16 / 24 oz', Notes: 'Cocoa, hazelnut, low acidity', Caffeine: 'High' }
+      }
+    ];
+    const byId = Object.fromEntries(products.map(p => [p.id, p]));
+    const money = n => '$' + n.toFixed(2);
+
+    /* =====================================================================
+       Cards — each card is its own transition scope
+       ===================================================================== */
+    const grid = document.getElementById('favorites');
+
+    for (const p of products) {
+      const card = document.createElement('article');
+      card.className = 'card vt-scope';
+      card.dataset.id = p.id;
+
+      const bg = nameEl(document.createElement('div'), `card-${p.id}-bg`);
+      bg.className = 'card-bg';
+
+      const title = nameEl(document.createElement('h3'), `card-${p.id}-title`, 'card-content');
+      title.textContent = p.name;
+
+      const blurb = nameEl(document.createElement('p'), `card-${p.id}-blurb`, 'card-content');
+      blurb.textContent = p.blurb;
+
+      const details = document.createElement('div');
+      details.className = 'card-details';
+      details.id = `card-${p.id}-details`;
+      details.hidden = true;
+      details.innerHTML =
+        `<dl>${Object.entries(p.details).map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('')}` +
+        `<dt>Price</dt><dd>${money(p.price)}</dd></dl>` +
+        `<a href="${p.href}">Full menu page &rarr;</a>`;
+      nameEl(details, `card-${p.id}-details`, 'card-details');
+
+      const actions = nameEl(document.createElement('div'), `card-${p.id}-actions`, 'card-content');
+      actions.className = 'card-actions';
+      actions.innerHTML =
+        `<button type="button" class="btn" data-action="toggle" aria-expanded="false" aria-controls="${details.id}">View Details</button>` +
+        `<button type="button" class="btn btn-ghost" data-action="add">Add to order</button>`;
+
+      card.append(bg, title, blurb, details, actions);
+      grid.append(card);
+    }
+
+    grid.addEventListener('click', e => {
+      const btn = e.target.closest('button[data-action]');
+      if (!btn) return;
+      const card = btn.closest('.card');
+      const id = card.dataset.id;
+
+      if (btn.dataset.action === 'toggle') {
+        const open = btn.getAttribute('aria-expanded') !== 'true';
+        scopedTransition(card, () => {
+          card.querySelector('.card-details').hidden = !open;
+          card.classList.toggle('is-open', open);
+          btn.setAttribute('aria-expanded', String(open));
+          btn.textContent = open ? 'Hide Details' : 'View Details';
+        });
+      } else if (btn.dataset.action === 'add') {
+        addToOrder(id);
+      }
+    });
+
+    /* =====================================================================
+       Order panel — a separate scope, so list changes animate while cards
+       are mid-transition (and vice versa).
+       ===================================================================== */
+    const panel = document.getElementById('order-panel');
+    const list = document.getElementById('order-list');
+    const empty = document.getElementById('order-empty');
+    const totalEl = document.getElementById('order-total-value');
+
+    // Panel chrome that moves when the list grows/shrinks.
+    nameEl(empty, 'order-empty');
+    nameEl(document.getElementById('order-total'), 'order-total');
+    nameEl(panel.querySelector('.order-panel > .btn'), 'order-checkout');
+
+    const order = []; // { id, qty, addedAt }
+    let sortMode = 'added';
+    let seq = 0;
+
+    function renderOrder() {
+      const rows = [...order].sort((a, b) =>
+        sortMode === 'price'
+          ? byId[b.id].price * b.qty - byId[a.id].price * a.qty
+          : a.addedAt - b.addedAt
+      );
+
+      // Reuse existing <li>s so focus is preserved and identities are stable.
+      const existing = new Map([...list.children].map(li => [li.dataset.id, li]));
+      const frag = document.createDocumentFragment();
+
+      for (const row of rows) {
+        const p = byId[row.id];
+        let li = existing.get(row.id);
+        if (!li) {
+          li = document.createElement('li');
+          li.className = 'order-item';
+          li.dataset.id = row.id;
+          li.innerHTML =
+            `<div><div class="name">${p.name}</div><div class="price"></div></div>` +
+            `<div class="qty">` +
+            `<button type="button" class="icon-btn" data-op="dec" aria-label="Remove one ${p.name}">&minus;</button>` +
+            `<span class="count" aria-label="Quantity"></span>` +
+            `<button type="button" class="icon-btn" data-op="inc" aria-label="Add one ${p.name}">+</button>` +
+            `</div>`;
+          nameEl(li, `order-${row.id}`, 'order-item');
+        }
+        li.querySelector('.price').textContent = `${money(p.price)} × ${row.qty} = ${money(p.price * row.qty)}`;
+        li.querySelector('.count').textContent = row.qty;
+        existing.delete(row.id);
+        frag.append(li);
+      }
+
+      list.append(frag);                       // moves/reorders in place
+      existing.forEach(li => li.remove());     // drop removed rows
+
+      empty.hidden = order.length > 0;
+      totalEl.textContent = money(order.reduce((s, r) => s + byId[r.id].price * r.qty, 0));
+    }
+
+    function changeOrder(mutate) {
+      scopedTransition(panel, () => {
+        mutate();
+        renderOrder();
+      });
+    }
+
+    function addToOrder(id) {
+      changeOrder(() => {
+        const row = order.find(r => r.id === id);
+        if (row) row.qty++;
+        else order.push({ id, qty: 1, addedAt: seq++ });
+      });
+    }
+
+    list.addEventListener('click', e => {
+      const btn = e.target.closest('button[data-op]');
+      if (!btn) return;
+      const id = btn.closest('.order-item').dataset.id;
+      changeOrder(() => {
+        const i = order.findIndex(r => r.id === id);
+        if (i < 0) return;
+        if (btn.dataset.op === 'inc') order[i].qty++;
+        else if (--order[i].qty <= 0) order.splice(i, 1);
+      });
+    });
+
+    panel.querySelector('.seg').addEventListener('click', e => {
+      const btn = e.target.closest('button[data-sort]');
+      if (!btn || btn.dataset.sort === sortMode) return;
+      changeOrder(() => {
+        sortMode = btn.dataset.sort;
+        panel.querySelectorAll('.seg button').forEach(b =>
+          b.setAttribute('aria-pressed', String(b === btn)));
+      });
+    });
+
+    renderOrder();
+  </script>
