+
+    .feedback-container {
+      max-height: 320px;
+      overflow-y: auto;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 20px;
+      display: flex;
+      flex-direction: column;
