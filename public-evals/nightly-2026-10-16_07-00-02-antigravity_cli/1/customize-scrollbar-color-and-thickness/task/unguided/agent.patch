+      border-radius: 4px;
+    }
+
+    .feedback-container::-webkit-scrollbar-thumb {
+      background: #ffab40;
+      border-radius: 4px;
+    }
+
+    .feedback-container::-webkit-scrollbar-thumb:hover {
+      background: #ffa726;
+    }
+
+    .feedback-card {
+      background: var(--light);
+      padding: 16px;
+      border-radius: 6px;
+      border-left: 4px solid var(--accent);
+    }
+
+    .feedback-meta {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      margin-bottom: 6px;
+    }
+
+    .feedback-author {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .feedback-rating {
+      color: var(--accent);
+      letter-spacing: 2px;
+    }
+
+    .feedback-quote {
+      color: var(--text);
+      font-size: 0.95rem;
+      line-height: 1.5;
+    }
+
+    .feedback-date {
+      margin-top: 6px;
+      font-size: 0.8rem;
+      color: #8d6e63;
+    }
+
     footer {
