+      /* Standard scrollbar styling */
+      scrollbar-width: thin;
+      scrollbar-color: #ffab40 #4e342e;
+    }
+
+    /* WebKit scrollbar styling */
+    .feedback-container::-webkit-scrollbar {
+      width: 8px;
