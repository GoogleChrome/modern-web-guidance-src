+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      if (!scroller || !status) return;
+
+      let isScrolling = false;
+
+      function getMostVisibleOrigin() {
+        const cards = scroller.querySelectorAll('.origin-card');
+        const scrollerRect = scroller.getBoundingClientRect();
+        let maxVisibleArea = -1;
+        let mostVisibleCard = null;
+
+        cards.forEach((card) => {
+          const cardRect = card.getBoundingClientRect();
+          const overlapWidth = Math.max(0, Math.min(cardRect.right, scrollerRect.right) - Math.max(cardRect.left, scrollerRect.left));
+          const overlapHeight = Math.max(0, Math.min(cardRect.bottom, scrollerRect.bottom) - Math.max(cardRect.top, scrollerRect.top));
+          const visibleArea = overlapWidth * overlapHeight;
+
+          if (visibleArea > maxVisibleArea) {
+            maxVisibleArea = visibleArea;
+            mostVisibleCard = card;
+          }
+        });
+
+        if (!mostVisibleCard && cards.length > 0) {
+          mostVisibleCard = cards[0];
+        }
+
+        if (mostVisibleCard) {
+          return mostVisibleCard.dataset.origin || mostVisibleCard.querySelector('h3')?.textContent.trim();
+        }
+        return null;
+      }
+
+      function handleScrollEnd() {
+        isScrolling = false;
+        status.classList.remove('scrolling');
+        const originName = getMostVisibleOrigin();
+        if (originName) {
+          status.textContent = `Scroll ended. Visible: ${originName}`;
+        }
+      }
+
+      // Lightweight scroll indicator: update status only on state transition
+      scroller.addEventListener('scroll', () => {
+        if (!isScrolling) {
+          isScrolling = true;
+          status.classList.add('scrolling');
+          status.textContent = 'Scrolling...';
+        }
+      }, { passive: true });
+
+      // Defer expensive visibility calculations to scrollend
+      scroller.addEventListener('scrollend', handleScrollEnd);
+
+      // Fallback for browsers that do not natively support scrollend
+      if (!('onscrollend' in window)) {
+        let scrollTimeout;
+        scroller.addEventListener('scroll', () => {
+          clearTimeout(scrollTimeout);
+          scrollTimeout = setTimeout(() => {
+            scroller.dispatchEvent(new CustomEvent('scrollend'));
+          }, 150);
+        }, { passive: true });
+      }
+
+      // Initialize status on initial render
+      const initialOrigin = getMostVisibleOrigin();
+      if (initialOrigin) {
+        status.textContent = `Scroll ended. Visible: ${initialOrigin}`;
+      }
+    })();
+  </script>
