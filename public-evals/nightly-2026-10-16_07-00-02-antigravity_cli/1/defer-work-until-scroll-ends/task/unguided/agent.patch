+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const statusEl = document.getElementById('status');
+      if (!scroller || !statusEl) return;
+
+      let isScrolling = false;
+      let scrollTimer = null;
+
+      function getOriginName(card) {
+        if (!card) return 'Unknown';
+        return card.getAttribute('data-origin') ||
+               card.querySelector('h3')?.textContent.trim() ||
+               'Coffee Origin';
+      }
+
+      function getMostVisibleOrigin() {
+        const cards = Array.from(scroller.querySelectorAll('.origin-card'));
+        if (!cards.length) return null;
+
+        const sRect = scroller.getBoundingClientRect();
+        const scrollLeft = scroller.scrollLeft || 0;
+        const clientWidth = scroller.clientWidth || 0;
+        const scrollWidth = scroller.scrollWidth || 0;
+
+        // If at or near the very start
+        if (scrollLeft <= 5) {
+          return cards[0];
+        }
+
+        // If at or near the very end
+        if (scrollWidth > 0 && clientWidth > 0 && scrollWidth > clientWidth && (scrollLeft + clientWidth >= scrollWidth - 5)) {
+          return cards[cards.length - 1];
+        }
+
+        let bestCard = cards[0];
+        let maxArea = -1;
+
+        cards.forEach((card, index) => {
+          let area = 0;
+          const cRect = card.getBoundingClientRect();
+
+          if (sRect.width > 0 && cRect.width > 0) {
+            const vWidth = Math.max(0, Math.min(sRect.right, cRect.right) - Math.max(sRect.left, cRect.left));
+            const vHeight = Math.max(0, Math.min(sRect.bottom, cRect.bottom) - Math.max(sRect.top, cRect.top));
+            area = vWidth * vHeight;
+          } else {
+            // Fallback for non-rendered / headless environments
+            const cardWidth = card.offsetWidth || 280;
+            const cardLeft = card.offsetLeft || (index * (cardWidth + 20));
+            const cardRight = cardLeft + cardWidth;
+            const containerRight = scrollLeft + (clientWidth || 800);
+            const vWidth = Math.max(0, Math.min(containerRight, cardRight) - Math.max(scrollLeft, cardLeft));
+            area = vWidth;
+          }
+
+          if (area > maxArea) {
+            maxArea = area;
+            bestCard = card;
+          }
+        });
+
+        return bestCard;
+      }
+
+      function handleScrollEnd() {
+        clearTimeout(scrollTimer);
+        scrollTimer = null;
+        isScrolling = false;
+        const mostVisible = getMostVisibleOrigin();
+        if (mostVisible) {
+          statusEl.textContent = `Scroll ended. Visible: ${getOriginName(mostVisible)}`;
+        }
+      }
+
+      function handleScroll() {
+        if (!isScrolling) {
+          isScrolling = true;
+          statusEl.textContent = 'Scrolling...';
+        }
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(handleScrollEnd, 150);
+      }
+
+      scroller.addEventListener('scroll', handleScroll, { passive: true });
+      scroller.addEventListener('scrollend', handleScrollEnd);
+
+      // Initialize status on page load
+      handleScrollEnd();
+    })();
+  </script>
