+    <!-- Roaster's Journal Section -->
+    <section id="roasters-journal" class="journal-section">
+      <div class="journal-header">
+        <span class="journal-tag">From the Cupping Table</span>
+        <h2>Roaster's Journal</h2>
+        <div class="journal-meta">By Marcus Vance, Head Roaster • Sourcing Log #42</div>
+      </div>
+
+      <img 
+        src="https://images.unsplash.com/photo-1524350876685-274059332603?auto=format&fit=crop&w=1200&q=80" 
+        alt="Sacks of freshly harvested single-origin green coffee beans ready for inspection" 
