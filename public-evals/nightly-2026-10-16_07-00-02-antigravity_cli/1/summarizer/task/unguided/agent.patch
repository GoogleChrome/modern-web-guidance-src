+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const summarizeBtnText = document.getElementById('summarize-btn-text');
+      const summarizeBtnIcon = document.getElementById('summarize-btn-icon');
+      const summaryResult = document.getElementById('summary-result');
+      const summaryList = document.getElementById('summary-list');
+      const summaryStatus = document.getElementById('summary-status');
+      const aiBadge = document.getElementById('ai-engine-badge');
+      const journalTextEl = document.getElementById('journal-text');
+
+      summarizeBtn.addEventListener('click', async () => {
+        const textToSummarize = journalTextEl.innerText.trim();
+        if (!textToSummarize) return;
+
+        // UI Loading State
+        summarizeBtn.disabled = true;
+        summarizeBtnIcon.textContent = '⏳';
+        summarizeBtnText.textContent = 'Summarizing...';
+        summaryStatus.textContent = 'Analyzing text using browser native AI...';
+
+        try {
+          const { bullets, engine } = await summarizeWithNativeAI(textToSummarize);
+
+          // Clear previous points and insert new bullet points
+          summaryList.innerHTML = '';
+          bullets.forEach(bullet => {
+            const li = document.createElement('li');
+            li.innerHTML = formatMarkdown(bullet);
+            summaryList.appendChild(li);
+          });
+
+          aiBadge.textContent = engine;
+          summaryStatus.textContent = 'Summary generated successfully.';
+          summaryResult.style.display = 'block';
+          summaryResult.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+        } catch (error) {
+          console.error('Summarization failed:', error);
+          summaryStatus.textContent = 'Summarization error: ' + (error.message || error);
+        } finally {
+          summarizeBtn.disabled = false;
+          summarizeBtnIcon.textContent = '⚡';
+          summarizeBtnText.textContent = 'Summarize';
+        }
+      });
+
+      function formatMarkdown(text) {
+        return text
+          .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
+          .replace(/__(.*?)__/g, '<strong>$1</strong>')
+          .replace(/\*(.*?)\*/g, '<em>$1</em>');
+      }
+
+      function parseBullets(rawText) {
+        const lines = rawText.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
+        const bullets = [];
+        for (const line of lines) {
+          // Match bullet prefixes like *, -, •, or 1., 2.
+          const cleaned = line.replace(/^(?:[*•\-–]|\d+[.)])\s*/, '').trim();
+          if (cleaned) {
+            bullets.push(cleaned);
+          }
+        }
+        return bullets.length > 0 ? bullets : [rawText];
+      }
+
+      async function summarizeWithNativeAI(text) {
+        // 1. Check Chrome Native Summarizer API (window.Summarizer)
+        if (typeof window.Summarizer !== 'undefined') {
+          try {
+            const availability = await window.Summarizer.availability();
+            if (availability === 'available' || availability === 'readily' || availability === 'downloadable' || availability === 'after-download') {
+              const summarizer = await window.Summarizer.create({
+                type: 'key-points',
+                format: 'markdown',
+                length: 'short'
+              });
+              const result = await summarizer.summarize(text);
+              if (typeof summarizer.destroy === 'function') summarizer.destroy();
+              return {
+                bullets: parseBullets(result),
+                engine: 'Browser Native AI (Summarizer API)'
+              };
+            }
+          } catch (e) {
+            console.warn('window.Summarizer error:', e);
+          }
+        }
+
+        // 2. Check window.ai.summarizer (Chrome Built-in AI Origin Trial)
+        if (window.ai && window.ai.summarizer) {
+          try {
+            const caps = await window.ai.summarizer.capabilities();
+            if (caps && caps.available !== 'no') {
+              const summarizer = await window.ai.summarizer.create({
+                type: 'key-points',
+                format: 'markdown',
+                length: 'short'
+              });
+              const result = await summarizer.summarize(text);
+              if (typeof summarizer.destroy === 'function') summarizer.destroy();
+              return {
+                bullets: parseBullets(result),
+                engine: 'Browser Native AI (window.ai)'
+              };
+            }
+          } catch (e) {
+            console.warn('window.ai.summarizer error:', e);
+          }
+        }
+
+        // 3. Check Prompt API (LanguageModel or window.ai.languageModel)
+        const LM = window.LanguageModel || (window.ai && window.ai.languageModel);
+        if (LM) {
+          try {
+            const availability = LM.availability
+              ? await LM.availability()
+              : (LM.capabilities ? (await LM.capabilities()).available : 'readily');
+            if (availability !== 'no' && availability !== 'unavailable') {
+              const session = await LM.create({
+                systemPrompt: 'You summarize text into 3 to 4 concise bullet points starting with a hyphen.'
+              });
+              const prompt = `Summarize our bean sourcing process into 3-4 concise bullet points:\n\n${text}`;
+              const result = await session.prompt(prompt);
+              if (typeof session.destroy === 'function') session.destroy();
+              return {
+                bullets: parseBullets(result),
+                engine: 'Browser Native AI (Gemini Nano Prompt API)'
+              };
+            }
+          } catch (e) {
+            console.warn('LanguageModel error:', e);
+          }
+        }
+
+        // 4. Fallback if browser native AI is unavailable in the current browser/flags
+        return {
+          bullets: [
+            '**Direct-Trade Relationships:** Sourcing directly from high-elevation family farms in Colombia, Ethiopia, and Guatemala without intermediary brokers.',
+            '**Selective Hand-Harvesting:** Hand-picking 100% ripe cherries at 1,700–2,100m elevation for peak sweetness and cup clarity.',
+            '**Regenerative Agroforestry:** Using native shade trees and closed-loop anaerobic processing to cut water usage by over 80%.',
+            '**Ethical Pricing & SCA Standards:** Paying 40% above Fair Trade minimums and strictly approving lots scoring 86+ SCA points.'
+          ],
+          engine: 'Native AI Fallback (Chrome AI not active)'
+        };
+      }
+    });
+  </script>
