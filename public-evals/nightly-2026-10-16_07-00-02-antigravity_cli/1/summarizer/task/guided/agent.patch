+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const statusEl = document.getElementById('summary-status');
+      const containerEl = document.getElementById('summary-container');
+      const pointsListEl = document.getElementById('summary-points');
+      const journalTextEl = document.getElementById('journal-text');
+
+      if (!summarizeBtn || !journalTextEl) return;
+
+      const summarizerOptions = {
+        type: 'key-points',
+        format: 'markdown',
+        length: 'medium'
+      };
+
+      let summarizerSession = null;
+
+      function renderBullets(text) {
+        pointsListEl.innerHTML = '';
+        const lines = text
+          .split(/\r?\n/)
+          .map(line => line.trim())
+          .filter(line => line.length > 0);
+
+        const bullets = [];
+        for (const line of lines) {
+          const clean = line.replace(/^([*\-•]|\d+\.)\s*/, '').trim();
+          if (clean) bullets.push(clean);
+        }
+
+        if (bullets.length === 0) {
+          const sentences = text.split(/(?<=[.?!])\s+/).filter(s => s.trim().length > 0);
+          bullets.push(...sentences);
+        }
+
+        bullets.forEach(point => {
+          const li = document.createElement('li');
+          li.innerHTML = point.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
+          pointsListEl.appendChild(li);
+        });
+
+        containerEl.style.display = 'block';
+      }
+
+      const fallbackBullets = [
+        "Direct-Trade Partnerships: Long-term relationships with smallholder farms in Guatemala, Colombia, and Ethiopia paying 40% above Fair Trade minimums.",
+        "High-Altitude Cultivation: Shade-grown between 1,600m and 2,200m elevation under native tree canopies with zero chemical pesticides.",
+        "Selective Harvesting: 100% hand-picked ripe cherries at peak Brix sweetness, dried on raised beds and aged in anaerobic fermentation tanks.",
+        "Precision Quality Control: SCA 85+ score evaluation and tailored small-batch (15kg) drum roasting to highlight unique origin terroir."
+      ];
+
+      summarizeBtn.addEventListener('click', async () => {
+        summarizeBtn.disabled = true;
+        statusEl.textContent = 'Generating summary with browser AI...';
+
+        try {
+          const textToSummarize = journalTextEl.innerText;
+
+          // Check standard Chrome/Edge 138+ Summarizer API
+          if ('Summarizer' in self) {
+            const availability = await self.Summarizer.availability(summarizerOptions);
+
+            if (availability === 'unavailable') {
+              throw new Error('Local summarization is currently unsupported on this device.');
+            }
+
+            if (!summarizerSession) {
+              statusEl.textContent = 'Initializing native AI model...';
+              summarizerSession = await self.Summarizer.create({
+                ...summarizerOptions,
+                monitor(m) {
+                  m.addEventListener('downloadprogress', (e) => {
+                    const percent = Math.round((e.loaded / e.total) * 100);
+                    statusEl.textContent = `Downloading AI model: ${percent}%...`;
+                  });
+                }
+              });
+            }
+
+            statusEl.textContent = 'Distilling key points...';
+            const result = await summarizerSession.summarize(textToSummarize);
+            renderBullets(result);
+            statusEl.textContent = 'Summary generated successfully!';
+          } else if (typeof window !== 'undefined' && window.ai && window.ai.summarizer) {
+            // Deprecated window.ai.summarizer fallback
+            if (!summarizerSession) {
+              const capabilities = await window.ai.summarizer.capabilities();
+              if (capabilities.available === 'no') {
+                throw new Error('Local summarization is currently unsupported on this device.');
+              }
+              summarizerSession = await window.ai.summarizer.create(summarizerOptions);
+            }
+            statusEl.textContent = 'Distilling key points...';
+            const result = await summarizerSession.summarize(textToSummarize);
+            renderBullets(result);
+            statusEl.textContent = 'Summary generated successfully!';
+          } else {
+            // Graceful degradation when native AI is not supported
+            statusEl.textContent = 'Local summarization is currently unsupported in this browser. Showing highlights:';
+            renderBullets(fallbackBullets.join('\n* '));
+          }
+        } catch (err) {
+          console.error('Summarization error:', err);
+          statusEl.textContent = `${err.message || 'Error generating summary.'} Showing highlights:`;
+          renderBullets(fallbackBullets.join('\n* '));
+        } finally {
+          summarizeBtn.disabled = false;
+        }
+      });
+    });
+  </script>
 </body>
 
