+  <script>
+    // Progressive enhancement for customizable select in environments without native selectedcontent cloning
+    const roastSelect = document.getElementById('roast-select');
+    if (roastSelect) {
+      const selectedContent = roastSelect.querySelector('selectedcontent');
+      const syncSelectedContent = () => {
+        const selectedOption = roastSelect.options[roastSelect.selectedIndex];
+        if (selectedContent && selectedOption && (!selectedContent.innerHTML || !selectedContent.innerHTML.trim())) {
+          selectedContent.innerHTML = selectedOption.innerHTML;
+        }
+      };
+      roastSelect.addEventListener('change', () => {
+        const selectedOption = roastSelect.options[roastSelect.selectedIndex];
+        if (selectedContent && selectedOption) {
+          if (!selectedContent.querySelector('.option-title') && !selectedContent.querySelector('.title')) {
+            selectedContent.innerHTML = selectedOption.innerHTML;
+          }
+        }
+      });
+      syncSelectedContent();
+    }
+  </script>
