+  <script>
+    /* MANDATORY: Check for native support before applying fallback */
+    if (typeof CSS === 'undefined' || !CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const updateSiblings = () => {
+        const groups = ['.spectrum-card', '.fan-card', '.circle-orb'];
+        groups.forEach(selector => {
+          const items = document.querySelectorAll(selector);
+          const parents = new Set();
+          items.forEach(el => {
+            if (el.parentElement) parents.add(el.parentElement);
+          });
+          parents.forEach(parent => {
+            const siblings = Array.from(parent.children).filter(el => el.matches(selector));
+            siblings.forEach((item, index) => {
+              /* MANDATORY: Injected index must be 1-based to match native function */
+              item.style.setProperty('--sibling-index', index + 1);
+              item.style.setProperty('--sibling-count', siblings.length);
+            });
+          });
+        });
+      };
+
+      updateSiblings();
+
+      const observer = new MutationObserver(() => updateSiblings());
+      observer.observe(document.body, { childList: true, subtree: true });
+    }
+  </script>
+
