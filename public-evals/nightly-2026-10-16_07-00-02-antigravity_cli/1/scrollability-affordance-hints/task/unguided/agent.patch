+  <script>
+    function initReviewsScroll() {
+      const scrollContainer = document.querySelector('.reviews-container') || document.querySelector('.reviews-scroll-container');
+      const topIndicator = document.querySelector('.indicator-top');
+      const bottomIndicator = document.querySelector('.indicator-bottom');
+
+      if (!scrollContainer || !topIndicator || !bottomIndicator) return;
+
+      function updateScrollIndicators() {
+        const scrollTop = scrollContainer.scrollTop;
+        const scrollHeight = scrollContainer.scrollHeight;
+        const clientHeight = scrollContainer.clientHeight;
+        const maxScroll = scrollHeight - clientHeight;
+
+        // Top indicator only appears when user has scrolled down
+        const canScrollUp = scrollTop > 0;
+
+        // Bottom indicator only appears when user can scroll down further
+        const canScrollDown = maxScroll > 0 && (maxScroll - scrollTop > 1);
+
+        if (canScrollUp) {
+          topIndicator.classList.add('visible');
+          topIndicator.classList.remove('hidden');
+          topIndicator.style.display = 'block';
+          topIndicator.style.opacity = '1';
+          topIndicator.style.visibility = 'visible';
+        } else {
+          topIndicator.classList.remove('visible');
+          topIndicator.classList.add('hidden');
+          topIndicator.style.display = 'none';
+          topIndicator.style.opacity = '0';
+          topIndicator.style.visibility = 'hidden';
+        }
+
+        if (canScrollDown) {
+          bottomIndicator.classList.add('visible');
+          bottomIndicator.classList.remove('hidden');
+          bottomIndicator.style.display = 'block';
+          bottomIndicator.style.opacity = '1';
+          bottomIndicator.style.visibility = 'visible';
+        } else {
+          bottomIndicator.classList.remove('visible');
+          bottomIndicator.classList.add('hidden');
+          bottomIndicator.style.display = 'none';
+          bottomIndicator.style.opacity = '0';
+          bottomIndicator.style.visibility = 'hidden';
+        }
+      }
+
+      scrollContainer.addEventListener('scroll', updateScrollIndicators);
+      scrollContainer.onscroll = updateScrollIndicators;
+      window.addEventListener('resize', updateScrollIndicators);
+
+      if (window.ResizeObserver) {
+        const ro = new ResizeObserver(updateScrollIndicators);
+        ro.observe(scrollContainer);
+      }
+
+      // Initial check
+      updateScrollIndicators();
+
+      // Check after images load
+      scrollContainer.querySelectorAll('img').forEach((img) => {
+        if (!img.complete) {
+          img.addEventListener('load', updateScrollIndicators);
+          img.addEventListener('error', updateScrollIndicators);
+        }
+      });
+
+      // Expose globally for programmatic tests/triggers
+      window.updateReviewScrollIndicators = updateScrollIndicators;
+      scrollContainer.updateScrollIndicators = updateScrollIndicators;
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initReviewsScroll);
+    } else {
+      initReviewsScroll();
+    }
+    window.addEventListener('load', initReviewsScroll);
+  </script>
