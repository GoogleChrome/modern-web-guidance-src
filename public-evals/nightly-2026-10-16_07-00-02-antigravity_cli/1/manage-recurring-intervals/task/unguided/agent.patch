+  <script>
+    // Progressive Polyfill Feature Detection for TC39 Temporal API
+    function getTemporal() {
+      // 1. Native browser Temporal implementation
+      if (typeof globalThis.Temporal !== 'undefined' && globalThis.Temporal.PlainDate) {
+        return globalThis.Temporal;
+      }
+      // 2. Check if UMD polyfill set globalThis.temporal.Temporal
+      if (typeof globalThis.temporal !== 'undefined' && globalThis.temporal.Temporal) {
+        globalThis.Temporal = globalThis.temporal.Temporal;
+        return globalThis.Temporal;
+      }
+      // 3. Fallback spec-compliant PlainDate implementation
+      return initTemporalFallback();
+    }
+
+    function initTemporalFallback() {
+      if (globalThis.Temporal && globalThis.Temporal.PlainDate) {
+        return globalThis.Temporal;
+      }
+
+      function isLeapYear(year) {
+        return (year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0);
+      }
+
+      function daysInMonth(year, month) {
+        const days = [31, isLeapYear(year) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+        return days[month - 1];
+      }
+
+      function pad(num, len = 2) {
+        return String(num).padStart(len, '0');
+      }
+
+      class FallbackPlainDate {
+        constructor(year, month, day) {
+          this.year = Number(year);
+          this.month = Number(month);
+          this.day = Number(day);
+        }
+
+        static from(item) {
+          if (item instanceof FallbackPlainDate) {
+            return new FallbackPlainDate(item.year, item.month, item.day);
+          }
+          if (typeof item === 'string') {
+            const match = item.match(/^(\d{4,6})-(\d{2})-(\d{2})/);
+            if (!match) throw new RangeError('Invalid ISO date format: ' + item);
+            const year = parseInt(match[1], 10);
+            const month = parseInt(match[2], 10);
+            const day = parseInt(match[3], 10);
+            if (month < 1 || month > 12) throw new RangeError('Month out of range: ' + month);
+            const max = daysInMonth(year, month);
+            if (day < 1 || day > max) throw new RangeError('Day out of range: ' + day);
+            return new FallbackPlainDate(year, month, day);
+          }
+          if (typeof item === 'object' && item !== null) {
+            return new FallbackPlainDate(item.year, item.month, item.day);
+          }
+          throw new TypeError('Invalid PlainDate argument');
+        }
+
+        add(duration, options = {}) {
+          const overflow = options.overflow || 'constrain';
+          if (overflow !== 'constrain' && overflow !== 'reject') {
+            throw new RangeError('Invalid overflow option: ' + overflow);
+          }
+
+          const yearsToAdd = Number(duration.years || 0);
+          const monthsToAdd = Number(duration.months || 0);
+
+          let targetYear = this.year + yearsToAdd;
+          let totalMonths = (this.month - 1) + monthsToAdd;
+          targetYear += Math.floor(totalMonths / 12);
+          let targetMonth = ((totalMonths % 12) + 12) % 12 + 1;
+
+          const maxDays = daysInMonth(targetYear, targetMonth);
+          let targetDay = this.day;
+
+          if (overflow === 'reject') {
+            if (targetDay > maxDays) {
+              throw new RangeError('value out of range: 1 <= ' + targetDay + ' <= ' + maxDays);
+            }
+          } else {
+            if (targetDay > maxDays) {
+              targetDay = maxDays;
+            }
+          }
+
+          return new FallbackPlainDate(targetYear, targetMonth, targetDay);
+        }
+
+        toString() {
+          return `${pad(this.year, 4)}-${pad(this.month, 2)}-${pad(this.day, 2)}`;
+        }
+      }
+
+      globalThis.Temporal = globalThis.Temporal || {};
+      globalThis.Temporal.PlainDate = FallbackPlainDate;
+      return globalThis.Temporal;
+    }
+
+    function calculateDeliveryDate() {
+      const startDateInput = document.getElementById('startDateInput');
+      const yearsInput = document.getElementById('yearsInput');
+      const monthsInput = document.getElementById('monthsInput');
+      const overflowSelect = document.getElementById('overflowSelect');
+      const resultDate = document.getElementById('resultDate');
+      const resultContainer = document.getElementById('resultContainer');
+      const resultLabel = document.getElementById('resultLabel');
+
+      if (!startDateInput || !yearsInput || !monthsInput || !overflowSelect || !resultDate) {
+        return;
+      }
+
+      const startDateVal = startDateInput.value ? startDateInput.value.trim() : '';
+      if (!startDateVal) {
+        resultDate.textContent = 'Please select a start date.';
+        resultDate.classList.add('error');
+        if (resultContainer) resultContainer.classList.add('error');
+        if (resultLabel) resultLabel.textContent = 'Status';
+        return;
+      }
+
+      const years = yearsInput.value === '' ? 0 : Number(yearsInput.value);
+      const months = monthsInput.value === '' ? 0 : Number(monthsInput.value);
+      const overflow = overflowSelect.value;
+
+      if (isNaN(years) || isNaN(months)) {
+        resultDate.textContent = 'Error: Please enter valid numbers for years and months.';
+        resultDate.classList.add('error');
+        if (resultContainer) resultContainer.classList.add('error');
+        if (resultLabel) resultLabel.textContent = 'Error';
+        return;
+      }
+
+      try {
+        const TemporalAPI = getTemporal();
+        const startDate = TemporalAPI.PlainDate.from(startDateVal);
+        const nextDelivery = startDate.add({ years, months }, { overflow });
+        const resultString = nextDelivery.toString();
+
+        resultDate.textContent = resultString;
+        resultDate.classList.remove('error');
+        if (resultContainer) resultContainer.classList.remove('error');
+        if (resultLabel) resultLabel.textContent = 'Next Delivery Date';
+      } catch (err) {
+        const errorDetails = err && err.message ? err.message : 'Invalid date calculation';
+        if (overflow === 'reject') {
+          resultDate.textContent = `Error: Month-end overflow rejected (${errorDetails})`;
+        } else {
+          resultDate.textContent = `Error: ${errorDetails}`;
+        }
+        resultDate.classList.add('error');
+        if (resultContainer) resultContainer.classList.add('error');
+        if (resultLabel) resultLabel.textContent = 'Calculation Error';
+      }
+    }
+
+    // Attach listeners for automatic updates on any input change
+    function initPlanner() {
+      const inputs = ['startDateInput', 'yearsInput', 'monthsInput', 'overflowSelect'];
+      inputs.forEach(id => {
+        const el = document.getElementById(id);
+        if (el) {
+          el.addEventListener('input', calculateDeliveryDate);
+          el.addEventListener('change', calculateDeliveryDate);
+        }
+      });
+      // Initial calculation
+      calculateDeliveryDate();
+    }
+
