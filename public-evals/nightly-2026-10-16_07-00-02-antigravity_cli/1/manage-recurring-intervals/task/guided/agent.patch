+  <script type="module">
+    // Lightweight Temporal fallback implementation for zero-latency DOM availability
+    function createTemporalFallback() {
+      function daysInMonth(year, month) {
+        return new Date(Date.UTC(year, month, 0)).getUTCDate();
+      }
+      return {
+        __isFallback: true,
+        PlainDate: {
+          from(item) {
+            let year, month, day;
+            if (typeof item === 'string') {
+              const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(item.trim());
+              if (!match) throw new RangeError('Invalid ISO date string: ' + item);
+              year = parseInt(match[1], 10);
+              month = parseInt(match[2], 10);
+              day = parseInt(match[3], 10);
+            } else if (typeof item === 'object' && item !== null) {
+              year = Number(item.year);
+              month = Number(item.month);
+              day = Number(item.day);
+            } else {
+              throw new TypeError('Invalid PlainDate source');
+            }
+            const maxDays = daysInMonth(year, month);
+            if (month < 1 || month > 12 || day < 1 || day > maxDays) {
+              throw new RangeError(`value out of range: 1 <= ${day} <= ${maxDays}`);
+            }
+            return {
+              year, month, day,
+              add(duration, options = { overflow: 'constrain' }) {
+                const overflow = (options && options.overflow) || 'constrain';
+                const addYears = Number((duration && duration.years) || 0);
+                const addMonths = Number((duration && duration.months) || 0);
+
+                let targetYear = year + addYears;
+                let totalMonths = (month - 1) + addMonths;
+                targetYear += Math.floor(totalMonths / 12);
+                let targetMonth = (totalMonths % 12);
+                if (targetMonth < 0) targetMonth += 12;
+                targetMonth += 1;
+
+                const maxDaysInTarget = daysInMonth(targetYear, targetMonth);
+                let targetDay = day;
+                if (targetDay > maxDaysInTarget) {
+                  if (overflow === 'reject') {
+                    throw new RangeError(`value out of range: 1 <= ${targetDay} <= ${maxDaysInTarget}`);
+                  } else {
+                    targetDay = maxDaysInTarget;
+                  }
+                }
+                const pad = (n, l = 2) => String(n).padStart(l, '0');
+                const iso = `${pad(targetYear, 4)}-${pad(targetMonth)}-${pad(targetDay)}`;
+                return {
+                  year: targetYear, month: targetMonth, day: targetDay,
+                  toString: () => iso
+                };
+              },
+              toString: () => {
+                const pad = (n, l = 2) => String(n).padStart(l, '0');
+                return `${pad(year, 4)}-${pad(month)}-${pad(day)}`;
+              }
+            };
+          }
+        }
+      };
+    }
+
+    // Ensure immediate availability
+    if (typeof globalThis.Temporal === 'undefined') {
+      globalThis.Temporal = createTemporalFallback();
+    }
+
+    // Progressive polyfill enhancement using @js-temporal/polyfill
+    (async () => {
+      if (typeof globalThis.Temporal === 'undefined' || globalThis.Temporal.__isFallback) {
+        try {
+          const module = await import("https://esm.sh/@js-temporal/polyfill");
+          globalThis.Temporal = module.Temporal;
+          if (module.toTemporalInstant) {
+            Date.prototype.toTemporalInstant = module.toTemporalInstant;
+          }
+          calculateNextDelivery();
+        } catch (e1) {
+          try {
+            const localModule = await import("/node_modules/@js-temporal/polyfill/dist/index.esm.js");
+            globalThis.Temporal = localModule.Temporal;
+            if (localModule.toTemporalInstant) {
+              Date.prototype.toTemporalInstant = localModule.toTemporalInstant;
+            }
+            calculateNextDelivery();
+          } catch (e2) {
+            // Keep fallback
+          }
+        }
+      }
+    })();
+
+    function calculateNextDelivery() {
+      const resultEl = document.getElementById('resultDate');
+      const startDateInput = document.getElementById('startDateInput');
+      const yearsInput = document.getElementById('yearsInput');
+      const monthsInput = document.getElementById('monthsInput');
+      const overflowSelect = document.getElementById('overflowSelect');
+
+      if (!resultEl || !startDateInput || !yearsInput || !monthsInput || !overflowSelect) return;
+
+      const startDateVal = startDateInput.value;
+      const yearsVal = yearsInput.value;
+      const monthsVal = monthsInput.value;
+      const overflowVal = overflowSelect.value;
+
+      if (!startDateVal) {
+        resultEl.textContent = 'Please select a start date.';
+        resultEl.classList.remove('error');
+        return;
+      }
+
+      const years = parseInt(yearsVal, 10);
+      const months = parseInt(monthsVal, 10);
+
+      if (isNaN(years) || isNaN(months)) {
+        resultEl.textContent = 'Error: Please enter valid numbers for years and months.';
+        resultEl.classList.add('error');
+        return;
+      }
+
+      try {
+        const startDate = Temporal.PlainDate.from(startDateVal);
+        const nextDate = startDate.add(
+          { years, months },
+          { overflow: overflowVal }
+        );
+        resultEl.textContent = nextDate.toString();
+        resultEl.classList.remove('error');
+      } catch (err) {
+        resultEl.textContent = `Error: ${err.message || err.toString()}`;
+        resultEl.classList.add('error');
+      }
+    }
+
+    function initializePlanner() {
+      const controlIds = ['startDateInput', 'yearsInput', 'monthsInput', 'overflowSelect'];
+      controlIds.forEach(id => {
+        const el = document.getElementById(id);
+        if (el) {
+          el.addEventListener('input', calculateNextDelivery);
+          el.addEventListener('change', calculateNextDelivery);
+        }
+      });
+      calculateNextDelivery();
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initializePlanner);
+    } else {
+      initializePlanner();
+    }
+  </script>
