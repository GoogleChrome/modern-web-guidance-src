+  <script>
+    (function () {
+      const textarea = document.getElementById('feedback-message');
+      const detectBtn = document.getElementById('detect-btn');
+      const statusContainer = document.getElementById('detection-status-container');
+      const downloadProgressContainer = document.getElementById('download-progress-container');
+      const downloadPercentage = document.getElementById('download-percentage');
+      const downloadProgressFill = document.getElementById('download-progress-fill');
+      const detectionResult = document.getElementById('detection-result');
+
+      let detectorInstance = null;
+
+      function showResult(htmlContent, type) {
+        statusContainer.style.display = 'block';
+        detectionResult.className = 'detection-result ' + type;
+        detectionResult.innerHTML = htmlContent;
+        detectionResult.style.display = 'block';
+      }
+
+      function updateProgress(percent) {
+        statusContainer.style.display = 'block';
+        downloadProgressContainer.style.display = 'block';
+        const formattedPercent = Math.min(100, Math.max(0, percent)) + '%';
+        downloadPercentage.textContent = formattedPercent;
+        downloadProgressFill.style.width = formattedPercent;
+      }
+
+      function hideProgress() {
+        downloadProgressContainer.style.display = 'none';
+      }
+
+      function getLanguageName(langCode) {
+        if (!langCode || langCode === 'und') {
+          return 'Undetermined';
+        }
+        try {
+          const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+          return displayNames.of(langCode) || langCode;
+        } catch (e) {
+          return langCode;
+        }
+      }
+
+      async function checkAvailability() {
+        try {
+          if (typeof LanguageDetector !== 'undefined') {
+            if (typeof LanguageDetector.availability === 'function') {
+              return await LanguageDetector.availability();
+            }
+            if (typeof LanguageDetector.capabilities === 'function') {
+              const caps = await LanguageDetector.capabilities();
+              return caps?.available || caps;
+            }
+          }
+          if (typeof window.ai !== 'undefined' && window.ai.languageDetector) {
+            if (typeof window.ai.languageDetector.availability === 'function') {
+              return await window.ai.languageDetector.availability();
+            }
+            if (typeof window.ai.languageDetector.capabilities === 'function') {
+              const caps = await window.ai.languageDetector.capabilities();
+              return caps?.available || caps;
+            }
+          }
+          if (typeof window.translation !== 'undefined') {
+            if (typeof window.translation.canDetect === 'function') {
+              return await window.translation.canDetect();
+            }
+            if (typeof window.translation.availability === 'function') {
+              return await window.translation.availability();
+            }
+          }
+        } catch (err) {
+          console.error('Error checking availability:', err);
+        }
+        return 'unsupported';
+      }
+
+      async function createDetector(onProgress) {
+        const options = {};
+        if (typeof onProgress === 'function') {
+          options.monitor = function (m) {
+            m.addEventListener('downloadprogress', function (e) {
+              let percent = 0;
+              if (typeof e.total === 'number' && e.total > 0) {
+                percent = Math.round((e.loaded / e.total) * 100);
+              } else if (typeof e.loaded === 'number') {
+                percent = e.loaded <= 1 ? Math.round(e.loaded * 100) : Math.round(e.loaded);
+              }
+              onProgress(percent);
+            });
+          };
+        }
+
+        let detector = null;
+        if (typeof LanguageDetector !== 'undefined' && typeof LanguageDetector.create === 'function') {
+          detector = await LanguageDetector.create(options);
+        } else if (typeof window.ai !== 'undefined' && window.ai.languageDetector && typeof window.ai.languageDetector.create === 'function') {
+          detector = await window.ai.languageDetector.create(options);
+        } else if (typeof window.translation !== 'undefined' && typeof window.translation.createDetector === 'function') {
+          detector = await window.translation.createDetector(options);
+        } else {
+          throw new Error('Language Detection API is not supported in this browser.');
+        }
+
+        if (detector && detector.ready && typeof detector.ready.then === 'function') {
+          await detector.ready;
+        }
+
+        return detector;
+      }
+
+      detectBtn.addEventListener('click', async function () {
+        const text = textarea.value.trim();
+        if (!text) {
+          showResult('Please enter a message before detecting the language.', 'warning');
+          return;
+        }
+
+        detectBtn.disabled = true;
+        hideProgress();
+        showResult('Checking language detection availability...', 'info');
+
+        try {
+          const availability = await checkAvailability();
+
+          if (availability === 'no' || availability === 'unavailable' || availability === 'unsupported') {
+            showResult('Language detection is not available in this browser. Please use a browser supporting the built-in Language Detection API.', 'error');
+            return;
+          }
+
+          if (availability === 'after-download' || availability === 'downloadable' || availability === 'downloading') {
+            updateProgress(0);
+            showResult('Downloading language model...', 'info');
+          }
+
+          if (!detectorInstance) {
+            detectorInstance = await createDetector(function (percent) {
+              updateProgress(percent);
+            });
+          }
+
+          hideProgress();
+          showResult('Detecting language...', 'info');
+
+          const results = await detectorInstance.detect(text);
+
+          if (!results || results.length === 0) {
+            showResult('Unable to determine the language for this message.', 'warning');
+            return;
+          }
+
+          const top = results[0];
+          const langName = getLanguageName(top.detectedLanguage);
+          const confidencePercent = Math.round(top.confidence * 100);
+          const confidenceExact = (top.confidence * 100).toFixed(1);
+
+          showResult(
+            '<strong>Language:</strong> ' + langName + (top.detectedLanguage ? ' (' + top.detectedLanguage + ')' : '') + '<br>' +
+            '<strong>Confidence:</strong> ' + confidencePercent + '% (' + confidenceExact + '%)',
+            'success'
+          );
+        } catch (err) {
+          console.error('Detection error:', err);
+          detectorInstance = null;
+          showResult('An error occurred during language detection: ' + (err.message || 'Unknown error'), 'error');
+        } finally {
+          detectBtn.disabled = false;
+        }
+      });
+    })();
+  </script>
 </body>
 
