+  <script>
+    document.addEventListener('DOMContentLoaded', async () => {
+      const messageInput = document.getElementById('feedback-message');
+      const detectBtn = document.getElementById('detect-btn');
+      const statusBadge = document.getElementById('availability-status');
+      const progressContainer = document.getElementById('download-progress-container');
+      const progressBar = document.getElementById('download-progress-bar');
+      const progressPercentage = document.getElementById('download-percentage');
+      const resultBox = document.getElementById('detection-result');
+
+      let detector = null;
+
+      // Check if LanguageDetector API is supported in this browser
+      const hasLanguageDetector = ('LanguageDetector' in window) || ('ai' in window && 'languageDetector' in window.ai);
+
+      async function checkAvailability() {
+        if (!hasLanguageDetector) {
+          statusBadge.className = 'status-badge error';
+          statusBadge.textContent = 'Language detection is not supported in this browser.';
+          detectBtn.disabled = true;
+          return 'unsupported';
+        }
+
+        try {
+          let availability;
+          if ('LanguageDetector' in window && typeof window.LanguageDetector.availability === 'function') {
+            availability = await window.LanguageDetector.availability();
+          } else if (window.ai?.languageDetector?.capabilities) {
+            const caps = await window.ai.languageDetector.capabilities();
+            availability = caps.available;
+          }
+
+          if (availability === 'unavailable' || availability === 'no') {
+            statusBadge.className = 'status-badge error';
+            statusBadge.textContent = 'Language detection is unavailable on this device.';
+            detectBtn.disabled = true;
+            return 'unavailable';
+          } else if (availability === 'downloadable' || availability === 'after-download') {
+            statusBadge.className = 'status-badge warning';
+            statusBadge.textContent = 'Model download required on first use.';
+            return 'downloadable';
+          } else {
+            statusBadge.className = 'status-badge info';
+            statusBadge.textContent = 'Language detector ready.';
+            return 'available';
+          }
+        } catch (err) {
+          console.warn('Could not determine language detector availability:', err);
+          statusBadge.className = 'status-badge warning';
+          statusBadge.textContent = 'Status check pending.';
+          return 'unknown';
+        }
+      }
+
+      const initialStatus = await checkAvailability();
+
+      detectBtn.addEventListener('click', async () => {
+        const text = messageInput.value.trim();
+        if (!text) {
+          resultBox.style.display = 'block';
+          resultBox.innerHTML = '<p style="color: #c62828; margin: 0;">Please enter a message to detect its language.</p>';
+          return;
+        }
+
+        resultBox.style.display = 'none';
+        detectBtn.disabled = true;
+
+        try {
+          if (!detector) {
+            const monitor = (m) => {
+              m.addEventListener('downloadprogress', (e) => {
+                progressContainer.style.display = 'block';
+                let percent = 0;
+                if (e.total && e.total > 0) {
+                  percent = Math.round((e.loaded / e.total) * 100);
+                } else if (typeof e.loaded === 'number') {
+                  percent = Math.round(e.loaded <= 1 ? e.loaded * 100 : e.loaded);
+                }
+                percent = Math.min(Math.max(percent, 0), 100);
+                progressBar.value = percent;
+                progressBar.textContent = `${percent}%`;
+                progressPercentage.textContent = `${percent}%`;
+              });
+            };
+
+            if ('LanguageDetector' in window) {
+              detector = await window.LanguageDetector.create({ monitor });
+            } else if (window.ai?.languageDetector) {
+              detector = await window.ai.languageDetector.create({ monitor });
+            } else {
+              throw new Error('LanguageDetector API is not supported in this browser.');
+            }
+          }
+
+          const results = await detector.detect(text);
+          progressContainer.style.display = 'none';
+
+          if (!results || results.length === 0) {
+            resultBox.style.display = 'block';
+            resultBox.innerHTML = '<p style="margin: 0;">No language could be identified with confidence.</p>';
+            return;
+          }
+
+          const topResult = results[0];
+          let languageName = topResult.detectedLanguage;
+          try {
+            const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+            const resolvedName = displayNames.of(topResult.detectedLanguage);
+            if (resolvedName) {
+              languageName = `${resolvedName} (${topResult.detectedLanguage})`;
+            }
+          } catch (e) {
+            languageName = topResult.detectedLanguage;
+          }
+
+          const confidencePercent = Math.round(topResult.confidence * 100);
+
+          resultBox.style.display = 'block';
+          resultBox.innerHTML = `
+            <h4>Detection Result</h4>
+            <div class="result-row"><strong>Language:</strong> ${languageName}</div>
+            <div class="result-row"><strong>Confidence:</strong> ${confidencePercent}% (${(topResult.confidence * 100).toFixed(1)}%)</div>
+          `;
+        } catch (error) {
+          console.error('Language detection failed:', error);
+          progressContainer.style.display = 'none';
+          resultBox.style.display = 'block';
+          resultBox.innerHTML = `<p style="color: #c62828; margin: 0;">Detection failed: ${error.message || 'Unknown error'}</p>`;
+        } finally {
+          if (hasLanguageDetector && initialStatus !== 'unavailable' && initialStatus !== 'unsupported') {
+            detectBtn.disabled = false;
+          }
+        }
+      });
+    });
+  </script>
 </body>
 
