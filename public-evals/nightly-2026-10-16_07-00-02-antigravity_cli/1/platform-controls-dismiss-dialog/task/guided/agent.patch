+  <script>
+    const coffeeData = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=600&q=80',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        details: 'Crafted with freshly pulled artisanal espresso, velvety steamed oat milk, and authentic Vermont maple syrup, finished with a delicate dusting of cinnamon.',
+        price: '$5.75',
+        roast: 'Medium Roast'
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=600&q=80',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        details: 'A bold, full-bodied espresso pulled from deeply roasted Arabica beans featuring intense cacao notes, smoky undertones, and a velvety crema.',
+        price: '$4.25',
+        roast: 'Dark Roast'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=600&q=80',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        details: 'Slowly cold-steeped for 18 hours in filtered water to extract rich flavor while minimizing acidity. Exceptionally smooth with subtle chocolate and caramel undertones.',
+        price: '$4.95',
+        roast: 'Medium-Dark Roast'
+      }
+    };
+
+    const modal = document.getElementById('coffee-modal');
+    const modalTitle = document.getElementById('coffee-modal-title');
+    const modalImage = document.getElementById('coffee-modal-image');
+    const modalDesc = document.getElementById('coffee-modal-desc');
+    const modalRoast = document.getElementById('coffee-modal-roast');
+    const modalPrice = document.getElementById('coffee-modal-price');
+    const modalDetails = document.getElementById('coffee-modal-details');
+
+    function updateModalContent(trigger) {
+      if (!trigger) return;
+      const coffeeKey = trigger.getAttribute('data-coffee');
+      let data = coffeeKey ? coffeeData[coffeeKey] : null;
+      if (!data) {
+        const card = trigger.closest('.card');
+        if (card) {
+          const heading = card.querySelector('h3')?.textContent?.trim();
+          for (const key in coffeeData) {
+            if (coffeeData[key].title.toLowerCase() === heading?.toLowerCase()) {
+              data = coffeeData[key];
+              break;
+            }
+          }
+        }
+      }
+      if (data) {
+        modalTitle.textContent = data.title;
+        modalDesc.textContent = data.description;
+        modalDetails.textContent = data.details;
+        modalRoast.textContent = data.roast;
+        modalPrice.textContent = data.price;
+        modalImage.src = data.image;
+        modalImage.alt = data.title;
+      }
+    }
+
+    const showDetailsButtons = document.querySelectorAll('.card button');
+    showDetailsButtons.forEach(button => {
+      button.addEventListener('click', () => {
+        updateModalContent(button);
+        // Fallback for browsers without native Invoker Commands support
+        if (!('commandForElement' in HTMLButtonElement.prototype)) {
+          if (!modal.open) {
+            modal.showModal();
+          }
+        }
+      });
+    });
+
+    // In case native invoker fires 'command' event
+    modal.addEventListener('command', (event) => {
+      if (event.command === 'show-modal' && event.source) {
+        updateModalContent(event.source);
+      }
+    });
+
+    // Close button handler
+    const closeBtn = modal.querySelector('.close-btn');
+    if (closeBtn) {
+      closeBtn.addEventListener('click', () => {
+        modal.close();
+      });
+    }
+
+    // Fallback for browsers without closedby support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      modal.addEventListener('click', (event) => {
+        // 1. When clicking the backdrop, the event target is the dialog element itself.
+        // Ignore clicks where the target is a child element inside the dialog.
+        if (event.target !== modal) return;
+
+        // 2. Check if the click coordinates fall within the dialog's content box.
+        // This distinguishes between a click on the backdrop vs a click on the dialog's background/padding.
+        const rect = modal.getBoundingClientRect();
+        const isDialogContent = (
+          rect.top <= event.clientY &&
+          event.clientY <= rect.top + rect.height &&
+          rect.left <= event.clientX &&
+          event.clientX <= rect.left + rect.width
+        );
+
+        if (isDialogContent) return;
+
+        // 3. Since the click was outside the content area (on the backdrop), manually close the dialog.
+        modal.close();
+      });
+    }
+  </script>
