+  <script>
+    (function () {
+      const coffeeData = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          details: 'Crafted with our signature espresso blend, steamed organic oat milk, and pure Grade A Vermont maple syrup. Lightly dusted with cinnamon.',
+          price: '$5.50',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=600&q=80'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          details: 'A rich and intense double shot extracted from dark-roasted Colombian and Sumatran beans. Notes of dark chocolate, toasted walnut, and caramel.',
+          price: '$3.75',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=600&q=80'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          details: 'Slow-steeped in cold filtered water for 18 hours to extract low-acid, full-bodied coffee notes. Served over craft ice with exceptional clarity.',
+          price: '$4.75',
+          image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=600&q=80'
+        }
+      };
+
+      const modal = document.getElementById('coffee-modal');
+      const modalBox = document.getElementById('modal-box');
+      const modalTitle = document.getElementById('modal-title');
+      const modalDesc = document.getElementById('modal-description');
+      const modalDetails = document.getElementById('modal-details');
+      const modalPrice = document.getElementById('modal-price');
+      const modalImage = document.getElementById('modal-image');
+      const closeBtn = document.getElementById('modal-close-btn');
+
+      let lastActiveElement = null;
+
+      function getCoffeeInfo(card) {
+        const cardTitle = card.querySelector('h3') ? card.querySelector('h3').textContent.trim() : '';
+        const cardDesc = card.querySelector('p') ? card.querySelector('p').textContent.trim() : '';
+        const coffeeId = card.getAttribute('data-coffee-id') ||
+          cardTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
+
+        const base = coffeeData[coffeeId] || {};
+        return {
+          title: cardTitle || base.title || 'Coffee Details',
+          description: cardDesc || base.description || '',
+          details: base.details || '',
+          price: base.price || '',
+          image: base.image || ''
+        };
+      }
+
+      function openModal(coffee) {
+        lastActiveElement = document.activeElement;
+
+        modalTitle.textContent = coffee.title;
+        modalDesc.textContent = coffee.description;
+        modalDetails.textContent = coffee.details || '';
+        modalPrice.textContent = coffee.price || '';
+
+        if (coffee.image) {
+          modalImage.src = coffee.image;
+          modalImage.alt = coffee.title;
+          modalImage.style.display = 'block';
+        } else {
+          modalImage.style.display = 'none';
+        }
+
+        if (typeof modal.showModal === 'function') {
+          modal.showModal();
+        } else {
+          modal.setAttribute('open', '');
+        }
+      }
+
+      function closeModal() {
+        if (modal.open) {
+          if (typeof modal.close === 'function') {
+            modal.close();
+          } else {
+            modal.removeAttribute('open');
+          }
+        }
+        if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
+          lastActiveElement.focus();
+          lastActiveElement = null;
+        }
+      }
+
+      // Open modal on show details click
+      document.querySelectorAll('.show-details-btn').forEach((btn) => {
+        btn.addEventListener('click', (event) => {
+          event.stopPropagation();
+          const card = btn.closest('.card');
+          if (card) {
+            const coffee = getCoffeeInfo(card);
+            openModal(coffee);
+          }
+        });
+      });
+
+      // Close button
+      closeBtn.addEventListener('click', (event) => {
+        event.stopPropagation();
+        closeModal();
+      });
+
+      // Native dialog cancel and close events
+      modal.addEventListener('cancel', () => {
+        closeModal();
+      });
+
+      modal.addEventListener('close', () => {
+        if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
+          lastActiveElement.focus();
+          lastActiveElement = null;
+        }
+      });
+
+      // Escape key handler
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' || event.key === 'Esc') {
+          if (modal.open) {
+            closeModal();
+          }
+        }
+      });
+
+      // Light dismiss on click outside the modal box
+      modal.addEventListener('click', (event) => {
+        if (!modalBox.contains(event.target)) {
+          closeModal();
+        }
+      });
+
+      window.addEventListener('click', (event) => {
+        if (!modal.open) return;
+        if (event.target.closest('.show-details-btn')) return;
+        if (!modalBox.contains(event.target)) {
+          closeModal();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
