+  <script>
+    function getPageNumber(urlStr) {
+      if (!urlStr) return null;
+      try {
+        const url = new URL(urlStr, window.location.href);
+        if (url.searchParams.has('page')) {
+          const p = parseInt(url.searchParams.get('page'), 10);
+          if (!isNaN(p)) return p;
+        }
+        const path = url.pathname;
+        const match = path.match(/page[_-]?(\d+)/i);
+        if (match) {
+          return parseInt(match[1], 10);
+        }
+        if (path.endsWith('index.html') || path === '' || path === '/' || path.endsWith('/')) {
+          return 1;
+        }
+      } catch (e) {}
+      return null;
+    }
+
+    function determineTransitionType(fromEntry, toEntry, navType) {
+      try {
+        if (toEntry?.url) {
+          const toUrl = new URL(toEntry.url, window.location.href);
+          const paramType = toUrl.searchParams.get('transition') || toUrl.searchParams.get('dir') || toUrl.searchParams.get('type');
+          if (paramType === 'next' || paramType === 'previous') return paramType;
+        }
+      } catch (err) {}
+
+      if (toEntry?.state?.transitionType) return toEntry.state.transitionType;
+      if (toEntry?.state?.type) return toEntry.state.type;
+
+      if (navType === 'traverse' && fromEntry && toEntry) {
+        if (typeof toEntry.index === 'number' && typeof fromEntry.index === 'number') {
+          if (toEntry.index > fromEntry.index) return 'next';
+          if (toEntry.index < fromEntry.index) return 'previous';
+        }
+      }
+
+      const fromUrl = fromEntry?.url;
+      const toUrl = toEntry?.url;
+
+      if (fromUrl && toUrl) {
+        const fromPage = getPageNumber(fromUrl);
+        const toPage = getPageNumber(toUrl);
+        if (fromPage !== null && toPage !== null && fromPage !== toPage) {
+          if (toPage > fromPage) return 'next';
+          if (toPage < fromPage) return 'previous';
+        }
+      }
+
+      return null;
+    }
+
+    window.determineTransitionType = determineTransitionType;
+
+    // Accessibility check: wrap transition setup so it only runs if the user's accessibility settings don't prefer reduced motion
+    const prefersReducedMotion = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)').matches : false;
+
+    if (!prefersReducedMotion) {
+      // Window listener for page reveals to dynamically apply transition types
+      window.addEventListener('pagereveal', async (e) => {
+        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+          return;
+        }
+
+        if (e.viewTransition) {
+          let transitionType = null;
+
+          // Check if an explicit transition direction was requested
+          try {
+            transitionType = sessionStorage.getItem('transitionType');
+          } catch (err) {}
+
+          // Use Navigation API activation if not explicitly set
+          if (!transitionType && window.navigation?.activation) {
+            transitionType = determineTransitionType(
+              window.navigation.activation.from,
+              window.navigation.activation.entry,
+              window.navigation.activation.navigationType
+            );
+          }
+
+          // Check event activation if available
+          if (!transitionType && e.activation) {
+            transitionType = determineTransitionType(
+              e.activation.from,
+              e.activation.entry,
+              e.activation.navigationType
+            );
+          }
+
+          // Fallback to URL search parameters on current location
+          if (!transitionType) {
+            try {
+              const params = new URLSearchParams(window.location.search);
+              transitionType = params.get('transition') || params.get('dir') || params.get('type');
+            } catch (err) {}
+          }
+
+          if (transitionType && e.viewTransition.types) {
+            if (typeof e.viewTransition.types.add === 'function') {
+              e.viewTransition.types.add(transitionType);
+            } else if (Array.isArray(e.viewTransition.types)) {
+              e.viewTransition.types.push(transitionType);
+            }
+          }
+
+          try {
+            sessionStorage.removeItem('transitionType');
+          } catch (err) {}
+        }
+      });
+
+      // Window listener for page swap (outgoing document snapshots)
+      window.addEventListener('pageswap', async (e) => {
+        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+          return;
+        }
+
+        if (e.viewTransition) {
+          let transitionType = null;
+          try {
+            transitionType = sessionStorage.getItem('transitionType');
+          } catch (err) {}
+
+          const activation = e.activation || window.navigation?.activation;
+          if (!transitionType && activation) {
+            transitionType = determineTransitionType(
+              activation.from,
+              activation.entry,
+              activation.navigationType
+            );
+          }
+
+          if (transitionType && e.viewTransition.types) {
+            if (typeof e.viewTransition.types.add === 'function') {
+              e.viewTransition.types.add(transitionType);
+            } else if (Array.isArray(e.viewTransition.types)) {
+              e.viewTransition.types.push(transitionType);
+            }
+          }
+        }
+      });
+
+      // Track pagination button clicks across document navigations
+      document.addEventListener('click', (e) => {
+        const nextBtn = e.target.closest('#next');
+        if (nextBtn) {
+          try {
+            sessionStorage.setItem('transitionType', 'next');
+          } catch (err) {}
+        }
+        const prevBtn = e.target.closest('#previous');
+        if (prevBtn) {
+          try {
+            sessionStorage.setItem('transitionType', 'previous');
+          } catch (err) {}
+        }
+      });
+    }
+  </script>
