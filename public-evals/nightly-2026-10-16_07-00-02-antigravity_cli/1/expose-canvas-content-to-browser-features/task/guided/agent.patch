+
+        const milk = milkSelect ? milkSelect.value : 'oat';
+        const syrup = syrupSelect ? syrupSelect.value : 'caramel';
+        const customerName = nameInput ? nameInput.value.trim() : '';
+
+        // 1. Warm cafe background gradient
+        const bgGrad = ctx.createLinearGradient(0, 0, cssWidth, cssHeight);
+        bgGrad.addColorStop(0, '#f9f6f0');
+        bgGrad.addColorStop(1, '#ede5dc');
+        ctx.fillStyle = bgGrad;
+        ctx.fillRect(0, 0, cssWidth, cssHeight);
+
+        // 2. Table surface counter
+        const tableY = isDesktop ? cssHeight * 0.72 : 230;
