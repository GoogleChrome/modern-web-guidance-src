+        }
+
+        ctx.restore();
+      }
+
+      // Main canvas rendering function
+      function renderCanvas() {
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.setTransform(1, 0, 0, 1, 0, 0);
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        }
+
+        const cssWidth = canvas.clientWidth || 800;
+        const cssHeight = canvas.clientHeight || 520;
+        const scaleX = canvas.width / cssWidth;
+        const scaleY = canvas.height / cssHeight;
+
+        // Draw coffee cup scene scaled to match high-resolution display
+        ctx.save();
+        ctx.scale(scaleX, scaleY);
+        drawCoffeeCup(ctx, cssWidth, cssHeight);
+        ctx.restore();
+
+        // Draw interactive HTML element onto canvas
+        if (typeof ctx.drawElementImage === 'function') {
+          ctx.drawElementImage(uiElement, 0, 0);
+        }
+      }
+
+      // Check browser support for HTML-in-Canvas API
+      const isNativeSupported = 'content' in HTMLCanvasElement.prototype;
+      const isPolyfillSupported = 'drawElementImage' in CanvasRenderingContext2D.prototype;
+
+      if (isNativeSupported || isPolyfillSupported) {
+        // Native or Polyfilled HTML-in-Canvas: render in onpaint handler
+        canvas.onpaint = () => {
+          renderCanvas();
+        };
+      } else {
+        // Fallback strategy: place HTML content on top of canvas using CSS
+        const wrapper = document.getElementById('canvas-wrapper');
+        if (wrapper) wrapper.classList.add('canvas-fallback');
+        renderCanvas();
+      }
+
+      function requestUpdate() {
+        updateStatus(false);
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          renderCanvas();
+        }
+      }
+
+      // Bind input events for real-time interactivity
+      if (nameInput) nameInput.addEventListener('input', requestUpdate);
+      if (milkSelect) milkSelect.addEventListener('change', requestUpdate);
+      if (syrupSelect) syrupSelect.addEventListener('change', requestUpdate);
+      if (sizeSelect) sizeSelect.addEventListener('change', requestUpdate);
+      if (extraShotCheck) extraShotCheck.addEventListener('change', requestUpdate);
+
+      if (orderBtn) {
+        orderBtn.addEventListener('click', () => {
+          updateStatus(true);
+          if (typeof canvas.requestPaint === 'function') {
+            canvas.requestPaint();
+          } else {
+            renderCanvas();
+          }
+        });
+      }
+
+      // Scale canvas grid to match device scale factor to prevent blurriness
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * window.devicePixelRatio);
+
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          renderCanvas();
+        }
+      });
+
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      const options = supportsDevicePixelContentBox
+        ? { box: 'device-pixel-content-box' }
+        : {};
+      observer.observe(canvas, options);
+
+      // Initial status update
+      updateStatus(false);
+    })();
+  </script>
