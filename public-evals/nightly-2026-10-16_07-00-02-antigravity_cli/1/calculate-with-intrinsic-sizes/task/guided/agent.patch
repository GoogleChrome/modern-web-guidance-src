+    .accordion-toggle:hover {
+      background: #3e2723;
+    }
+
+    .accordion-icon {
+      transition: transform 0.3s ease;
+    }
+
+    .accordion-toggle[aria-expanded="true"] .accordion-icon {
+      transform: rotate(180deg);
+    }
+
+    /* Directly transitioning between different intrinsic keyword sizes isn't supported; one end of the transition must be a fixed length or percentage. */
+    .accordion-content {
+      display: block;
+      overflow: hidden;
+      block-size: 0;
+      transition: block-size 0.4s ease-out;
+    }
+
+    .accordion-content p {
+      padding-block: 1rem;
+      padding-inline: 1.25rem;
+      line-height: 1.7;
+    }
+
+    .accordion-content.open,
+    .accordion-content.is-expanded,
+    .accordion-toggle[aria-expanded="true"] + .accordion-content,
+    #accordion-toggle[aria-expanded="true"] + .accordion-content,
+    #accordion-toggle[aria-expanded="true"] ~ .accordion-content {
+      block-size: auto;
+      block-size: calc-size(auto, size + 2rem);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .accordion-content {
+        transition: none !important;
+      }
+      .accordion-icon {
+        transition: none !important;
+      }
+    }
