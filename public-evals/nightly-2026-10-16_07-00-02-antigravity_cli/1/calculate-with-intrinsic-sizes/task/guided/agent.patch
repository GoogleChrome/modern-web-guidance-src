+
+    .accordion-toggle {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      inline-size: 100%;
+      padding-block: 1rem;
+      padding-inline: 1.25rem;
+      background: var(--primary);
+      color: white;
+      border: none;
+      font-size: 1.05rem;
+      font-weight: 600;
