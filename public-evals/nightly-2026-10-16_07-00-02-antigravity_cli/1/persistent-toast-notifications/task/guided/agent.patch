+    /* Toast Notification System */
+    .toast {
+      position: fixed;
+      inset: auto 20px 20px auto;
+      margin: 0;
+      padding: 12px 18px;
+      display: flex;
+      align-items: center;
+      gap: 14px;
+      background: var(--primary);
+      color: var(--light);
+      border: 1px solid var(--accent);
+      border-radius: 8px;
+      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
+      font-family: inherit;
+      font-size: 0.95rem;
+      pointer-events: auto;
+      anchor-name: --toast;
+
+      /* Smooth entry/exit animations via discrete top-layer transitions */
+      opacity: 0;
+      transform: translateY(16px) scale(0.96);
+      transition-property: opacity, transform, display, overlay;
+      transition-duration: 0.3s;
+      transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
+      transition-behavior: allow-discrete;
+    }
+
+    :is(.toast:popover-open, .toast.\:popover-open):where(:not([data-closing])) {
+      opacity: 1;
+      transform: translateY(0) scale(1);
+
+      @starting-style {
+        opacity: 0;
+        transform: translateY(16px) scale(0.96);
+      }
+    }
+
+    /* Dynamic CSS vertical stacking offset for independent top-layer popovers */
+    .toast ~ .toast {
+      position-anchor: --toast;
+      bottom: calc(anchor(top) + 12px);
+    }
+
+    @supports not (anchor-name: --toast) {
+      @supports (bottom: calc(sibling-index() * 1px)) {
+        .toast {
+          bottom: calc(20px + (sibling-index() - 1) * 60px);
+        }
+      }
+      @supports not (bottom: calc(sibling-index() * 1px)) {
+        .toast:nth-of-type(2) { bottom: 80px; }
+        .toast:nth-of-type(3) { bottom: 140px; }
+        .toast:nth-of-type(4) { bottom: 200px; }
+        .toast:nth-of-type(5) { bottom: 260px; }
+        .toast:nth-of-type(6) { bottom: 320px; }
+      }
+    }
+
+    .toast-message {
+      display: inline-flex;
+      align-items: center;
+      gap: 8px;
+    }
+
+    .toast-message::first-letter {
+      text-transform: uppercase;
+    }
+
+    .toast-close {
+      background: transparent;
+      border: none;
+      color: var(--secondary);
+      font-size: 1.3rem;
+      line-height: 1;
+      cursor: pointer;
+      padding: 2px 4px;
+      margin-left: auto;
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      border-radius: 4px;
+      transition: color 0.2s, background-color 0.2s;
+    }
+
+    .toast-close:hover {
+      color: var(--accent);
+      background-color: rgba(255, 255, 255, 0.1);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transform: none;
+        transition-duration: 0.1s;
+      }
+      :is(.toast:popover-open, .toast.\:popover-open):where(:not([data-closing])) {
+        transform: none;
+        @starting-style {
+          transform: none;
+        }
+      }
+    }
