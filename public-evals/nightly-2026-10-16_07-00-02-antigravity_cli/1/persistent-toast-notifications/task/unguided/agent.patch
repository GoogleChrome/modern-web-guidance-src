+  <script>
+    function showToast(message = 'added to cart!') {
+      const toast = document.createElement('div');
+      toast.className = 'toast';
+      toast.setAttribute('popover', 'manual');
+      toast.setAttribute('role', 'status');
+      toast.setAttribute('aria-live', 'polite');
+
+      const messageSpan = document.createElement('span');
+      messageSpan.className = 'toast-message';
+      messageSpan.textContent = message;
+
+      const closeButton = document.createElement('button');
+      closeButton.type = 'button';
+      closeButton.className = 'toast-close';
+      closeButton.setAttribute('aria-label', 'Close');
+      closeButton.innerHTML = '&times;';
+
+      toast.appendChild(messageSpan);
+      toast.appendChild(closeButton);
+
+      document.body.appendChild(toast);
+
+      if (typeof toast.showPopover === 'function') {
+        toast.showPopover();
+      }
+
+      requestAnimationFrame(() => {
+        toast.classList.add('toast-open');
+      });
+
+      let dismissed = false;
+      function dismiss() {
+        if (dismissed) return;
+        dismissed = true;
+        clearTimeout(autoDismissTimer);
+
+        toast.classList.remove('toast-open');
+        toast.classList.add('toast-closing');
+
+        const finishDismiss = () => {
+          try {
+            if (typeof toast.hidePopover === 'function' && toast.matches(':popover-open')) {
+              toast.hidePopover();
+            }
+          } catch (err) {}
+          if (toast.parentNode) {
+            toast.remove();
+          }
+        };
+
+        toast.addEventListener('transitionend', finishDismiss, { once: true });
+        setTimeout(finishDismiss, 350);
+      }
+
+      closeButton.addEventListener('click', (e) => {
+        e.stopPropagation();
+        dismiss();
+      });
+
+      const autoDismissTimer = setTimeout(dismiss, 3000);
+    }
+
+    window.showToast = showToast;
+
+    document.addEventListener('click', (event) => {
+      const trigger = event.target.closest('.toast-trigger, button, a');
+      if (!trigger) return;
+
+      const isToastTrigger = trigger.classList.contains('toast-trigger');
+      const text = trigger.textContent.trim().toLowerCase();
+
+      if (isToastTrigger || text === 'order now' || text === 'view details') {
+        event.preventDefault();
+        showToast('added to cart!');
+      }
+    });
+  </script>
