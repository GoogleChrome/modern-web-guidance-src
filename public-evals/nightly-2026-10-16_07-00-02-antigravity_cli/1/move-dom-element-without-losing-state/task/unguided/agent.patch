+  <script>
+    (function () {
+      const heroSection = document.getElementById('hero-section') || document.querySelector('.hero');
+      const videoContainer = document.getElementById('video-container');
+      const iframe = document.getElementById('roasting-video');
+      const theaterBtn = document.getElementById('theater-mode-btn');
+
+      if (!heroSection || !videoContainer || !iframe || !theaterBtn) {
+        return;
+      }
+
+      let isTheaterMode = false;
+      let lastKnownTime = 0;
+      let isPlaying = false;
+
+      // Listen for YouTube player state updates via postMessage for older browser fallback
+      window.addEventListener('message', (event) => {
+        try {
+          const data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
+          if (data && data.info) {
+            if (typeof data.info.currentTime === 'number') {
+              lastKnownTime = data.info.currentTime;
+            }
+            if (data.info.playerState === 1) {
+              isPlaying = true;
+            } else if (data.info.playerState === 2) {
+              isPlaying = false;
+            }
+          }
+        } catch (e) {
+          // Ignore unrelated messages
+        }
+      });
+
+      // Periodically request status to keep lastKnownTime current (for browsers lacking moveBefore)
+      setInterval(() => {
+        if (iframe && iframe.contentWindow) {
+          try {
+            iframe.contentWindow.postMessage(JSON.stringify({ event: 'listening' }), '*');
+            iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'getCurrentTime' }), '*');
+          } catch (e) {}
+        }
+      }, 1000);
+
+      /**
+       * Reparents a node to a new parent without reload or playback interruption
+       * using the modern DOM moveBefore API, with insertBefore fallback for older browsers.
+       */
+      function reparentNode(node, newParent, referenceNode = null) {
+        if (typeof newParent.moveBefore === 'function') {
+          // Modern browsers (Chrome 133+, Firefox): atomic move preserving iframe state & playback
+          newParent.moveBefore(node, referenceNode);
+        } else {
+          // Fallback for older browsers:
+          const resumeTime = lastKnownTime;
+          const resumePlay = isPlaying;
+
+          newParent.insertBefore(node, referenceNode);
+
+          if (resumeTime > 0) {
+            const onReload = () => {
+              node.removeEventListener('load', onReload);
+              try {
+                node.contentWindow?.postMessage(JSON.stringify({
+                  event: 'command',
+                  func: 'seekTo',
+                  args: [resumeTime, true]
+                }), '*');
+                if (resumePlay) {
+                  node.contentWindow?.postMessage(JSON.stringify({
+                    event: 'command',
+                    func: 'playVideo',
+                    args: []
+                  }), '*');
+                }
+              } catch (err) {}
+            };
+            node.addEventListener('load', onReload);
+          }
+        }
+      }
+
+      function toggleTheaterMode() {
+        isTheaterMode = !isTheaterMode;
+
+        if (isTheaterMode) {
+          // Reparent iframe to the hero section
+          reparentNode(iframe, heroSection, null);
+          heroSection.classList.add('theater-mode');
+          document.body.classList.add('in-theater-mode');
+          theaterBtn.classList.add('active');
+          theaterBtn.setAttribute('aria-pressed', 'true');
+          const textSpan = theaterBtn.querySelector('.btn-text');
+          if (textSpan) {
+            textSpan.textContent = 'Exit Theater Mode';
+          } else {
+            theaterBtn.textContent = 'Exit Theater Mode';
+          }
+        } else {
+          // Reparent iframe back to the main container
+          reparentNode(iframe, videoContainer, null);
+          heroSection.classList.remove('theater-mode');
+          document.body.classList.remove('in-theater-mode');
+          theaterBtn.classList.remove('active');
+          theaterBtn.setAttribute('aria-pressed', 'false');
+          const textSpan = theaterBtn.querySelector('.btn-text');
+          if (textSpan) {
+            textSpan.textContent = 'Theater Mode';
+          } else {
+            theaterBtn.textContent = 'Theater Mode';
+          }
+        }
+      }
+
+      theaterBtn.addEventListener('click', toggleTheaterMode);
+
+      // Expose globally for automated tests or integration
+      window.theaterMode = {
+        toggle: toggleTheaterMode,
+        reparentNode: reparentNode,
+        get isTheaterMode() { return isTheaterMode; }
+      };
+    })();
+  </script>
+
