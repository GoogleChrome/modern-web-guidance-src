+  <script>
+    (function () {
+      const hero = document.querySelector('.hero');
+      const iframe = document.getElementById('roasting-video');
+      const theaterBtn = document.getElementById('theater-mode-btn');
+      const originalParent = iframe ? iframe.parentElement : null;
+      const originalNextSibling = iframe ? iframe.nextSibling : null;
+
+      function moveElement(targetParent, element, referenceNode = null) {
+        if ('moveBefore' in Element.prototype || typeof targetParent.moveBefore === 'function') {
+          targetParent.moveBefore(element, referenceNode);
+        } else {
+          targetParent.insertBefore(element, referenceNode);
+        }
+      }
+
+      function toggleTheaterMode() {
+        if (!iframe || !hero || !originalParent) return;
+
+        const isInHero = iframe.parentElement === hero;
+
+        if (!isInHero) {
+          moveElement(hero, iframe, null);
+          hero.classList.add('theater-mode');
+          document.body.classList.add('theater-mode-active');
+          theaterBtn.classList.add('active');
+          theaterBtn.setAttribute('aria-pressed', 'true');
+        } else {
+          moveElement(originalParent, iframe, originalNextSibling);
+          hero.classList.remove('theater-mode');
+          document.body.classList.remove('theater-mode-active');
+          theaterBtn.classList.remove('active');
+          theaterBtn.setAttribute('aria-pressed', 'false');
+        }
+      }
+
+      if (theaterBtn) {
+        theaterBtn.addEventListener('click', toggleTheaterMode);
+      }
+
+      // Expose helper on window for external triggers or testing
+      window.toggleTheaterMode = toggleTheaterMode;
+    })();
+  </script>
