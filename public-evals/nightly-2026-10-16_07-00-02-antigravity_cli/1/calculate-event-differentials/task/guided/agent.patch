+  <script type="module">
+    // Load Temporal polyfill if native Temporal is not available
+    if (typeof Temporal === 'undefined') {
+      try {
+        const module = await import('@js-temporal/polyfill');
+        globalThis.Temporal = module.Temporal;
+        if (module.toTemporalInstant) {
+          Date.prototype.toTemporalInstant = module.toTemporalInstant;
+        }
+      } catch {
+        try {
+          const module = await import('https://esm.sh/@js-temporal/polyfill');
+          globalThis.Temporal = module.Temporal;
+          if (module.toTemporalInstant) {
+            Date.prototype.toTemporalInstant = module.toTemporalInstant;
+          }
+        } catch (e) {
+          try {
+            const module = await import('./node_modules/@js-temporal/polyfill/dist/index.esm.js');
+            globalThis.Temporal = module.Temporal;
+            if (module.toTemporalInstant) {
+              Date.prototype.toTemporalInstant = module.toTemporalInstant;
+            }
+          } catch (err) {
+            console.warn('Could not load Temporal polyfill, using fallback calculation', err);
+          }
+        }
+      }
+    }
+
+    function formatDuration(duration) {
+      if (typeof Intl.DurationFormat !== 'undefined') {
+        const formatter = new Intl.DurationFormat('en', {
+          style: 'long',
+          daysDisplay: 'always',
+          hoursDisplay: 'always'
+        });
+        return formatter.format(duration);
+      }
+      const d = duration.days || 0;
+      const h = duration.hours || 0;
+      const daysStr = `${d} day${d === 1 ? '' : 's'}`;
+      const hoursStr = `${h} hour${h === 1 ? '' : 's'}`;
+      return `${daysStr}, ${hoursStr}`;
+    }
+
+    function calculatePromotionTimes() {
+      const container = document.getElementById('maple-latte-countdown');
+      const startDateStr = container?.dataset?.startDate || '2026-01-01';
+      const startTimeStr = container?.dataset?.startTime || '00:00:00';
+      const endDateStr = container?.dataset?.endDate || '2026-03-01';
+      const endTimeStr = container?.dataset?.endTime || '00:00:00';
+
+      if (typeof Temporal !== 'undefined') {
+        const now = Temporal.Now.zonedDateTimeISO();
+        const tz = now.timeZoneId;
+
+        const startDate = Temporal.PlainDate.from(startDateStr);
+        const startTime = Temporal.PlainTime.from(startTimeStr);
+        const start = startDate.toPlainDateTime(startTime).toZonedDateTime(tz);
+
+        const endDate = Temporal.PlainDate.from(endDateStr);
+        const endTime = Temporal.PlainTime.from(endTimeStr);
+        const end = endDate.toPlainDateTime(endTime).toZonedDateTime(tz);
+
+        const isExpired = Temporal.ZonedDateTime.compare(now, end) >= 0;
+        const isStarted = Temporal.ZonedDateTime.compare(now, start) >= 0;
+
+        const rawRemaining = now.until(end, { largestUnit: 'day' });
+        const remaining = rawRemaining.round({
+          largestUnit: 'day',
+          smallestUnit: 'hour',
+          roundingMode: 'trunc'
+        });
+
+        const rawElapsed = isStarted
+          ? now.since(start, { largestUnit: 'day' })
+          : Temporal.Duration.from({ days: 0, hours: 0 });
+        const elapsed = rawElapsed.round({
+          largestUnit: 'day',
+          smallestUnit: 'hour',
+          roundingMode: 'trunc'
+        });
+
+        return { now, tz, start, end, isExpired, isStarted, remaining, elapsed };
+      } else {
+        // Fallback using legacy Date in user local time zone
+        const now = new Date();
+        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
+        const [sYear, sMonth, sDay] = startDateStr.split('-').map(Number);
+        const [sHour, sMin, sSec] = startTimeStr.split(':').map(Number);
+        const start = new Date(sYear, sMonth - 1, sDay, sHour, sMin, sSec);
+
+        const [eYear, eMonth, eDay] = endDateStr.split('-').map(Number);
+        const [eHour, eMin, eSec] = endTimeStr.split(':').map(Number);
+        const end = new Date(eYear, eMonth - 1, eDay, eHour, eMin, eSec);
+
+        const isExpired = now >= end;
+        const isStarted = now >= start;
+
+        const diffRemainingMs = Math.max(0, end - now);
+        const remDays = Math.floor(diffRemainingMs / (1000 * 60 * 60 * 24));
+        const remHours = Math.floor((diffRemainingMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
+
+        const diffElapsedMs = isStarted ? Math.max(0, now - start) : 0;
+        const elDays = Math.floor(diffElapsedMs / (1000 * 60 * 60 * 24));
+        const elHours = Math.floor((diffElapsedMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
+
+        return {
+          now,
+          tz,
+          start,
+          end,
+          isExpired,
+          isStarted,
+          remaining: { days: remDays, hours: remHours },
+          elapsed: { days: elDays, hours: elHours }
+        };
+      }
+    }
+
+    function updatePromotionCountdown() {
+      const remainingElem = document.getElementById('maple-latte-remaining');
+      const elapsedElem = document.getElementById('maple-latte-elapsed');
+      const statusBadge = document.getElementById('offer-status-badge');
+      const container = document.getElementById('maple-latte-countdown');
+      if (!remainingElem || !elapsedElem) return;
+
+      const promo = calculatePromotionTimes();
+      const remainingDuration = promo.isExpired
+        ? { days: 0, hours: 0 }
+        : promo.remaining;
+
+      const remainingFormatted = formatDuration(remainingDuration);
+      const elapsedFormatted = formatDuration(promo.elapsed);
+
+      remainingElem.textContent = remainingFormatted;
+      elapsedElem.textContent = elapsedFormatted;
+
+      if (container) {
+        container.dataset.timeZone = promo.tz;
+        container.dataset.isExpired = promo.isExpired;
+        container.dataset.remainingDays = remainingDuration.days;
+        container.dataset.remainingHours = remainingDuration.hours;
+        container.dataset.elapsedDays = promo.elapsed.days;
+        container.dataset.elapsedHours = promo.elapsed.hours;
+      }
+
+      if (statusBadge) {
+        if (promo.isExpired) {
+          statusBadge.textContent = 'Offer Ended';
+          statusBadge.className = 'timer-badge expired';
+        } else {
+          statusBadge.textContent = 'Limited Time Offer';
+          statusBadge.className = 'timer-badge';
+        }
+      }
+    }
+
+    // Expose helpers globally for testing or manual invocations
+    window.mapleLatteTimer = {
+      update: updatePromotionCountdown,
+      calculate: calculatePromotionTimes,
+      formatDuration: formatDuration
+    };
+    window.updatePromotionCountdown = updatePromotionCountdown;
+
+    // Update on page load
+    if (document.readyState === 'loading') {
+      window.addEventListener('DOMContentLoaded', updatePromotionCountdown);
+    } else {
+      updatePromotionCountdown();
+    }
+    window.addEventListener('load', updatePromotionCountdown);
+  </script>
 </body>
 
