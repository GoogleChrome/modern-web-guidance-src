+  <script>
+    (function () {
+      function formatDuration(hours, minutes, largestUnit) {
+        const totalMinutes = Math.max(0, (hours || 0) * 60 + (minutes || 0));
+
+        // 1. Try Temporal API if available
+        if (typeof Temporal !== 'undefined' && Temporal.Duration) {
+          try {
+            const d = Temporal.Duration.from({
+              hours: Math.max(0, hours || 0),
+              minutes: Math.max(0, minutes || 0)
+            }).round({ largestUnit: largestUnit });
+
+            if (typeof Intl !== 'undefined' && Intl.DurationFormat) {
+              const df = new Intl.DurationFormat(undefined, { style: 'long' });
+              const res = df.format(d);
+              if (res) return res;
+              if (largestUnit === 'hours') {
+                return new Intl.DurationFormat(undefined, { style: 'long', hoursDisplay: 'always' }).format({ hours: 0 });
+              } else {
+                return new Intl.DurationFormat(undefined, { style: 'long', minutesDisplay: 'always' }).format({ minutes: 0 });
+              }
+            }
+          } catch (e) {
+            // Fall through
+          }
+        }
+
+        // 2. Try Intl.DurationFormat with calculated duration record
+        if (typeof Intl !== 'undefined' && Intl.DurationFormat) {
+          try {
+            const df = new Intl.DurationFormat(undefined, { style: 'long' });
+            if (totalMinutes === 0) {
+              if (largestUnit === 'hours') {
+                return new Intl.DurationFormat(undefined, { style: 'long', hoursDisplay: 'always' }).format({ hours: 0 });
+              } else {
+                return new Intl.DurationFormat(undefined, { style: 'long', minutesDisplay: 'always' }).format({ minutes: 0 });
+              }
+            }
+            if (largestUnit === 'minutes') {
+              return df.format({ minutes: totalMinutes });
+            }
+            const h = Math.floor(totalMinutes / 60);
+            const m = totalMinutes % 60;
+            return df.format({ hours: h, minutes: m });
+          } catch (e) {
+            // Fall through
+          }
+        }
+
+        // 3. Resilient fallback for older environments
+        if (largestUnit === 'minutes') {
+          return `${totalMinutes} ${totalMinutes === 1 ? 'minute' : 'minutes'}`;
+        }
+        if (totalMinutes === 0) {
+          return '0 hours';
+        }
+        const h = Math.floor(totalMinutes / 60);
+        const m = totalMinutes % 60;
+        const parts = [];
+        if (h > 0) parts.push(`${h} ${h === 1 ? 'hour' : 'hours'}`);
+        if (m > 0) parts.push(`${m} ${m === 1 ? 'minute' : 'minutes'}`);
+        return parts.join(', ');
+      }
+
+      function updateCalculator() {
+        const hoursInput = document.getElementById('hoursInput');
+        const minutesInput = document.getElementById('minutesInput');
+        const humanValue = document.getElementById('humanValue');
+        const selectedRadio = document.querySelector('input[name="largestUnit"]:checked');
+
+        if (!hoursInput || !minutesInput || !humanValue) return;
+
+        const hours = parseInt(hoursInput.value, 10) || 0;
+        const minutes = parseInt(minutesInput.value, 10) || 0;
+        const largestUnit = selectedRadio ? selectedRadio.value : 'hours';
+
+        humanValue.textContent = formatDuration(hours, minutes, largestUnit);
+      }
+
+      function init() {
+        const hoursInput = document.getElementById('hoursInput');
+        const minutesInput = document.getElementById('minutesInput');
+        const radios = document.querySelectorAll('input[name="largestUnit"]');
+
+        if (hoursInput) {
+          hoursInput.addEventListener('input', updateCalculator);
+          hoursInput.addEventListener('change', updateCalculator);
+          hoursInput.addEventListener('keyup', updateCalculator);
+        }
+        if (minutesInput) {
+          minutesInput.addEventListener('input', updateCalculator);
+          minutesInput.addEventListener('change', updateCalculator);
+          minutesInput.addEventListener('keyup', updateCalculator);
+        }
+        radios.forEach(function (radio) {
+          radio.addEventListener('change', updateCalculator);
+          radio.addEventListener('click', updateCalculator);
+          radio.addEventListener('input', updateCalculator);
+        });
+
+        updateCalculator();
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
