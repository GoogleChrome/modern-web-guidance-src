+  <script type="module">
+    // Load Temporal polyfill if Temporal is not available natively
+    (async function loadPolyfill() {
+      if (typeof Temporal === 'undefined') {
+        try {
+          const module = await import("https://esm.sh/@js-temporal/polyfill");
+          globalThis.Temporal = module.Temporal;
+          updateDuration();
+        } catch {
+          try {
+            const module = await import("./node_modules/@js-temporal/polyfill/dist/index.esm.js");
+            globalThis.Temporal = module.Temporal;
+            updateDuration();
+          } catch (e) {
+            // Polyfill not available; standard arithmetic fallback will handle calculations
+          }
+        }
+      }
+    })();
+
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const humanValue = document.getElementById('humanValue');
+
+    function updateDuration() {
+      const hours = Math.max(0, parseInt(hoursInput.value, 10) || 0);
+      const minutes = Math.max(0, parseInt(minutesInput.value, 10) || 0);
+      const selectedRadio = document.querySelector('input[name="largestUnit"]:checked');
+      const largestUnit = selectedRadio ? selectedRadio.value : 'hours';
+
+      let balanced = null;
+      if (typeof Temporal !== 'undefined' && Temporal.Duration) {
+        try {
+          const dur = Temporal.Duration.from({ hours, minutes });
+          balanced = dur.round({ largestUnit });
+        } catch (e) {
+          // If Temporal round encounters an issue, fallback to arithmetic
+        }
+      }
+
+      if (!balanced) {
+        const totalMinutes = hours * 60 + minutes;
+        if (largestUnit === 'minutes') {
+          balanced = { hours: 0, minutes: totalMinutes };
+        } else {
+          balanced = { hours: Math.floor(totalMinutes / 60), minutes: totalMinutes % 60 };
+        }
+      }
+
+      const h = balanced.hours ?? 0;
+      const m = balanced.minutes ?? 0;
+
+      if (typeof Intl !== 'undefined' && Intl.DurationFormat) {
+        const isZero = h === 0 && m === 0;
+        const formatter = new Intl.DurationFormat(navigator.language || 'en', {
+          style: 'long',
+          ...(isZero ? { [largestUnit + 'Display']: 'always' } : {})
+        });
+        humanValue.textContent = formatter.format(balanced);
+      } else {
+        if (h === 0 && m === 0) {
+          humanValue.textContent = largestUnit === 'hours' ? '0 hours' : '0 minutes';
+        } else {
+          const parts = [];
+          if (h > 0) parts.push(`${h} hour${h === 1 ? '' : 's'}`);
+          if (m > 0) parts.push(`${m} minute${m === 1 ? '' : 's'}`);
+          humanValue.textContent = parts.join(', ');
+        }
+      }
+    }
+
+    hoursInput.addEventListener('input', updateDuration);
+    minutesInput.addEventListener('input', updateDuration);
+    document.querySelectorAll('input[name="largestUnit"]').forEach(radio => {
+      radio.addEventListener('change', updateDuration);
+    });
+
+    updateDuration();
+  </script>
