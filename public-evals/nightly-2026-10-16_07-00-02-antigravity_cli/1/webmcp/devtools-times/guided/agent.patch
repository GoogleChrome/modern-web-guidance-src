index 0000000..da9848d
--- /dev/null
+++ b/src/webmcp/polyfill.ts
@@ -0,0 +1,428 @@
+/**
+ * WebMCP Polyfill Implementation
+ * Conforms to the W3C Web Model Context Protocol specification & DevTools agent guidelines.
+ */
+
+import type {
+  ModelContext,
+  ModelContextTool,
+  RegisteredTool,
+  ModelContextRegisterToolOptions,
+  ModelContextGetToolsOptions,
+  ModelContextExecuteToolOptions,
+  ToolActivatedEventDetail,
+  ToolCancelEventDetail,
+  AgentSubmitEvent,
+} from './types';
+
+interface StoredTool {
+  tool: ModelContextTool;
+  cleanup?: () => void;
+}
+
+export class ModelContextImpl extends EventTarget implements ModelContext {
+  private registeredTools: Map<string, StoredTool> = new Map();
+
+  registerTool(
+    tool: ModelContextTool,
+    options?: ModelContextRegisterToolOptions
+  ): void {
+    if (!tool || typeof tool.name !== 'string' || tool.name.trim() === '') {
+      throw new TypeError('Invalid tool definition: "name" must be a non-empty string.');
+    }
+
+    const name = tool.name.trim();
+
+    // Clean up previous registration for same name if present
+    const existing = this.registeredTools.get(name);
+    if (existing?.cleanup) {
+      existing.cleanup();
+    }
+
+    if (options?.signal?.aborted) {
+      return;
+    }
+
+    let cleanup: (() => void) | undefined;
+
+    if (options?.signal) {
+      const abortHandler = () => {
+        this.registeredTools.delete(name);
+        this.dispatchEvent(new Event('toolchange'));
+      };
+      options.signal.addEventListener('abort', abortHandler, { once: true });
+      cleanup = () => {
+        options.signal?.removeEventListener('abort', abortHandler);
+      };
+    }
+
+    this.registeredTools.set(name, { tool, cleanup });
+    this.dispatchEvent(new Event('toolchange'));
+  }
+
+  async getTools(options?: ModelContextGetToolsOptions): Promise<RegisteredTool[]> {
+    if (options?.signal?.aborted) {
+      throw new DOMException('The operation was aborted.', 'AbortError');
+    }
+
+    const toolMap = new Map<string, RegisteredTool>();
+
+    // 1. Imperative tools
+    for (const [name, stored] of this.registeredTools.entries()) {
+      toolMap.set(name, {
+        name: stored.tool.name,
+        title: stored.tool.title,
+        description: stored.tool.description,
+        inputSchema: stored.tool.inputSchema
+          ? JSON.parse(JSON.stringify(stored.tool.inputSchema))
+          : { type: 'object', properties: {} },
+        annotations: stored.tool.annotations ? { ...stored.tool.annotations } : undefined,
+      });
+    }
+
+    // 2. Declarative forms (if DOM is available)
+    if (typeof document !== 'undefined') {
+      const declarativeTools = this.discoverDeclarativeForms();
+      for (const decTool of declarativeTools) {
+        // Imperative registration takes precedence over declarative form with identical name
+        if (!toolMap.has(decTool.name)) {
+          toolMap.set(decTool.name, {
+            name: decTool.name,
+            title: decTool.title,
+            description: decTool.description,
+            inputSchema: decTool.inputSchema,
+            annotations: decTool.annotations,
+          });
+        }
+      }
+    }
+
+    // Return alphabetically sorted list
+    const tools = Array.from(toolMap.values()).sort((a, b) =>
+      a.name.localeCompare(b.name)
+    );
+
+    return Object.freeze(tools);
+  }
+
+  async executeTool(
+    toolOrName: string | RegisteredTool,
+    input: Record<string, unknown> = {},
+    options?: ModelContextExecuteToolOptions
+  ): Promise<unknown> {
+    const toolName = typeof toolOrName === 'string' ? toolOrName : toolOrName.name;
+
+    if (options?.signal?.aborted) {
+      this.dispatchCancelEvent(toolName);
+      throw new DOMException('The operation was aborted.', 'AbortError');
+    }
+
+    this.dispatchActivatedEvent(toolName);
+
+    // Watch for abort during execution
+    let abortListener: (() => void) | undefined;
+    if (options?.signal) {
+      abortListener = () => {
+        this.dispatchCancelEvent(toolName);
+      };
+      options.signal.addEventListener('abort', abortListener, { once: true });
+    }
+
+    try {
+      // 1. Check imperative tools
+      const stored = this.registeredTools.get(toolName);
+      if (stored?.tool) {
+        if (typeof stored.tool.execute === 'function') {
+          const result = await stored.tool.execute(input, { signal: options?.signal });
+          return result;
+        }
+        return { status: 'success', message: `Tool ${toolName} executed.` };
+      }
+
+      // 2. Check declarative forms
+      if (typeof document !== 'undefined') {
+        const form = document.querySelector<HTMLFormElement>(
+          `form[toolname="${CSS.escape(toolName)}"]`
+        );
+        if (form) {
+          return await this.executeDeclarativeForm(form, input, options?.signal);
+        }
+      }
+
+      throw new DOMException(`Tool "${toolName}" not found.`, 'NotFoundError');
+    } finally {
+      if (abortListener && options?.signal) {
+        options.signal.removeEventListener('abort', abortListener);
+      }
+    }
+  }
+
+  private dispatchActivatedEvent(toolName: string): void {
+    const event = new CustomEvent<ToolActivatedEventDetail>('toolactivated', {
+      detail: { toolName },
+      bubbles: true,
+      cancelable: false,
+    });
+    this.dispatchEvent(event);
+    if (typeof window !== 'undefined') {
+      window.dispatchEvent(
+        new CustomEvent<ToolActivatedEventDetail>('toolactivated', {
+          detail: { toolName },
+        })
+      );
+    }
+  }
+
+  private dispatchCancelEvent(toolName: string): void {
+    const event = new CustomEvent<ToolCancelEventDetail>('toolcancel', {
+      detail: { toolName },
+      bubbles: true,
+      cancelable: false,
+    });
+    this.dispatchEvent(event);
+    if (typeof window !== 'undefined') {
+      window.dispatchEvent(
+        new CustomEvent<ToolCancelEventDetail>('toolcancel', {
+          detail: { toolName },
+        })
+      );
+    }
+  }
+
+  /**
+   * Scans document for forms annotated with WebMCP attributes
+   */
+  private discoverDeclarativeForms(): RegisteredTool[] {
+    if (typeof document === 'undefined') return [];
+
+    const forms = Array.from(document.querySelectorAll<HTMLFormElement>('form[toolname]'));
+    const tools: RegisteredTool[] = [];
+
+    for (const form of forms) {
+      const toolname = form.getAttribute('toolname');
+      if (!toolname) continue;
+
+      const description = form.getAttribute('tooldescription') || undefined;
+      const title = form.getAttribute('tooltitle') || toolname;
+      const inputSchema = this.synthesizeFormSchema(form);
+
+      tools.push({
+        name: toolname,
+        title,
+        description,
+        inputSchema,
+        annotations: {
+          declarative: true,
+          autoSubmit: form.hasAttribute('toolautosubmit'),
+        },
+      });
+    }
+
+    return tools;
+  }
+
+  /**
+   * Synthesizes JSON Schema from HTML form elements
+   */
+  synthesizeFormSchema(form: HTMLFormElement): Record<string, unknown> {
+    const properties: Record<string, unknown> = {};
+    const required: string[] = [];
+
+    const elements = Array.from(form.elements) as (
+      | HTMLInputElement
+      | HTMLSelectElement
+      | HTMLTextAreaElement
+      | HTMLButtonElement
+    )[];
+
+    for (const element of elements) {
+      const name = element.name;
+      if (!name) continue;
+
+      // Skip buttons and submit inputs
+      const tagName = element.tagName.toLowerCase();
+      const type = (element as HTMLInputElement).type?.toLowerCase();
+      if (
+        tagName === 'button' ||
+        type === 'submit' ||
+        type === 'reset' ||
+        type === 'button' ||
+        type === 'image'
+      ) {
+        continue;
+      }
+
+      // Determine property description:
+      // 1. toolparamdescription
+      // 2. associated <label> textContent
+      // 3. aria-description / aria-label / placeholder
+      let paramDesc: string | undefined = element.getAttribute('toolparamdescription') || undefined;
+
+      if (!paramDesc && element.id) {
+        const label = form.querySelector<HTMLLabelElement>(`label[for="${CSS.escape(element.id)}"]`);
+        if (label) {
+          paramDesc = label.textContent?.trim();
+        }
+      }
+
+      if (!paramDesc && element.labels && element.labels.length > 0) {
+        paramDesc = element.labels[0].textContent?.trim();
+      }
+
+      if (!paramDesc) {
+        paramDesc =
+          element.getAttribute('aria-description') ||
+          element.getAttribute('aria-label') ||
+          (element as HTMLInputElement).placeholder ||
+          undefined;
+      }
+
+      // Determine property type & constraints
+      let propType = 'string';
+      const propDef: Record<string, unknown> = {};
+
+      if (type === 'number' || type === 'range') {
+        propType = 'number';
+        const min = (element as HTMLInputElement).min;
+        const max = (element as HTMLInputElement).max;
+        if (min !== '') propDef.minimum = Number(min);
+        if (max !== '') propDef.maximum = Number(max);
+      } else if (type === 'checkbox') {
+        propType = 'boolean';
+      } else if (tagName === 'select') {
+        const select = element as HTMLSelectElement;
+        const options = Array.from(select.options).map((opt) => opt.value);
+        if (options.length > 0) {
+          propDef.enum = options;
+        }
+      }
+
+      propDef.type = propType;
+      if (paramDesc) {
+        propDef.description = paramDesc;
+      }
+
+      properties[name] = propDef;
+
+      if (element.required || element.hasAttribute('required')) {
+        if (!required.includes(name)) {
+          required.push(name);
+        }
+      }
+    }
+
+    return {
+      type: 'object',
+      properties,
+      ...(required.length > 0 ? { required } : {}),
+    };
+  }
+
+  /**
+   * Executes interaction with a declarative HTML form
+   */
+  private async executeDeclarativeForm(
+    form: HTMLFormElement,
+    input: Record<string, unknown>,
+    signal?: AbortSignal
+  ): Promise<unknown> {
+    if (signal?.aborted) {
+      throw new DOMException('The operation was aborted.', 'AbortError');
+    }
+
+    // Apply visual feedback classes
+    form.classList.add('tool-form-active');
+    const submitBtn = form.querySelector<HTMLButtonElement>(
+      'button[type="submit"], input[type="submit"]'
+    );
+    if (submitBtn) {
+      submitBtn.classList.add('tool-submit-active');
+    }
+
+    try {
+      // Populate fields
+      for (const [key, value] of Object.entries(input)) {
+        const field = form.elements.namedItem(key) as
+          | HTMLInputElement
+          | HTMLSelectElement
+          | HTMLTextAreaElement
+          | RadioNodeList
+          | null;
+
+        if (!field) continue;
+
+        if ('value' in field && typeof (field as HTMLInputElement).value !== 'undefined') {
+          const inputEl = field as HTMLInputElement;
+          if (inputEl.type === 'checkbox') {
+            inputEl.checked = Boolean(value);
+          } else {
+            inputEl.value = String(value ?? '');
+          }
+          inputEl.dispatchEvent(new Event('input', { bubbles: true }));
+          inputEl.dispatchEvent(new Event('change', { bubbles: true }));
+        }
+      }
+
+      let responsePromise: Promise<unknown> | null = null;
+
+      // Construct SubmitEvent with agentInvoked and respondWith
+      const submitEvent = new CustomEvent('submit', {
+        bubbles: true,
+        cancelable: true,
+      }) as AgentSubmitEvent;
+
+      submitEvent.agentInvoked = true;
+      submitEvent.respondWith = (promise: Promise<unknown>) => {
+        responsePromise = promise;
+      };
+
+      const defaultNotPrevented = form.dispatchEvent(submitEvent);
+
+      if (responsePromise) {
+        return await responsePromise;
+      }
+
+      if (defaultNotPrevented && typeof form.requestSubmit === 'function') {
+        // Fallback standard submit if event wasn't prevented
+        form.requestSubmit();
+      }
+
+      return {
+        status: 'submitted',
+        tool: form.getAttribute('toolname'),
+        input,
+      };
+    } finally {
+      form.classList.remove('tool-form-active');
+      if (submitBtn) {
+        submitBtn.classList.remove('tool-submit-active');
+      }
+    }
+  }
+}
+
+/**
+ * Initializes and binds the ModelContext polyfill to document and navigator
+ */
+export function installWebMCPPolyfill(): ModelContext {
+  if (typeof document === 'undefined') {
+    return new ModelContextImpl();
+  }
+
+  let context = document.modelContext;
+
+  if (!context) {
+    context = new ModelContextImpl();
+    document.modelContext = context;
+
+    if (typeof navigator !== 'undefined' && !navigator.modelContext) {
+      (navigator as any).modelContext = context;
+    }
+
+    if (typeof window !== 'undefined') {
+      (window as any).ModelContext = ModelContextImpl;
+    }
+  }
+
+  return context;
+}
