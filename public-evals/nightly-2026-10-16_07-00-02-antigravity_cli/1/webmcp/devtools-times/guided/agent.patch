+/**
+ * WebMCP Initialization Script
+ * Installs polyfill, registers tools, and manages lifecycle transitions.
+ */
+
+import { installWebMCPPolyfill } from './polyfill';
+import { registerAppTools } from './tools';
+
+let currentNavigationController: AbortController | null = null;
+
+export function initWebMCP(): void {
+  if (typeof window === 'undefined') return;
+
+  const context = installWebMCPPolyfill();
+
+  const registerCurrentTools = () => {
+    // Abort previous page lifecycle tools to prevent leaks/collisions
+    if (currentNavigationController) {
+      currentNavigationController.abort();
+    }
+
+    currentNavigationController = new AbortController();
+    registerAppTools(context, currentNavigationController.signal);
+  };
+
+  // Initial registration
+  registerCurrentTools();
+
+  // Astro page lifecycle hooks
+  document.addEventListener('astro:before-swap', () => {
+    if (currentNavigationController) {
+      currentNavigationController.abort();
+      currentNavigationController = null;
+    }
+  });
+
+  document.addEventListener('astro:page-load', () => {
+    registerCurrentTools();
+  });
+}
+
+// Auto-initialize when loaded in browser
+if (typeof window !== 'undefined') {
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', () => initWebMCP(), { once: true });
+  } else {
+    initWebMCP();
+  }
+}
diff --git a/src/webmcp/polyfill.ts b/src/webmcp/polyfill.ts
