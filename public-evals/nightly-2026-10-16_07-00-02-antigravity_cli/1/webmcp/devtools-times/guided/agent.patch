@@ -0,0 +1,439 @@
+/**
+ * Application Tools for The DevTools Times
+ * Registered to document.modelContext to expose client-side functionality to AI agents.
+ */
+
+import type { ModelContext, ModelContextTool } from './types';
+
+interface ArticleItem {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+  category?: string;
+}
+
+let cachedArticles: ArticleItem[] | null = null;
+
+function getBaseUrl(): string {
+  if (typeof window !== 'undefined' && (window as any).__DEVTOOLS_BASE_URL__) {
+    return (window as any).__DEVTOOLS_BASE_URL__;
+  }
+  return import.meta.env.BASE_URL || '/';
+}
+
+async function fetchArticles(): Promise<ArticleItem[]> {
+  if (cachedArticles && cachedArticles.length > 0) {
+    return cachedArticles;
+  }
+
+  const base = getBaseUrl();
+  const url = `${base.replace(/\/$/, '')}/api/articles.json`;
+
+  try {
+    const res = await fetch(url);
+    if (!res.ok) {
+      throw new Error(`Failed to fetch articles: ${res.statusText}`);
+    }
+    const data = await res.json();
+    cachedArticles = data;
+    return data;
+  } catch (err) {
+    console.error('Error fetching articles in WebMCP tool:', err);
+    return [];
+  }
+}
+
+/**
+ * Creates the list of application tools
+ */
+export function createAppTools(): ModelContextTool[] {
+  const searchArticlesTool: ModelContextTool = {
+    name: 'search_articles',
+    title: 'Search Articles',
+    description: 'Search published articles by keyword or phrase. Returns title, slug, summary, and image for matching articles.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        query: {
+          type: 'string',
+          description: 'Search query or keywords to filter articles by title and summary',
+        },
+      },
+      required: ['query'],
+    },
+    execute: async ({ query }: { query: string }) => {
+      const q = String(query || '').trim().toLowerCase();
+      if (!q) {
+        return { count: 0, results: [] };
+      }
+
+      const articles = await fetchArticles();
+      const results = articles.filter(
+        (a) =>
+          a.title.toLowerCase().includes(q) ||
+          a.summary.toLowerCase().includes(q)
+      );
+
+      return {
+        query,
+        count: results.length,
+        results: results.map((r) => ({
+          slug: r.slug,
+          title: r.title,
+          summary: r.summary,
+          image: r.image,
+          url: `${getBaseUrl().replace(/\/$/, '')}/articles/${r.slug}`,
+        })),
+      };
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+  };
+
+  const getArticleTool: ModelContextTool = {
+    name: 'get_article',
+    title: 'Get Article Details',
+    description: 'Get details and content summary for a specific article by its slug identifier.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'The unique slug of the article (e.g. "future-of-web-dev")',
+        },
+      },
+      required: ['slug'],
+    },
+    execute: async ({ slug }: { slug: string }) => {
+      const trimmedSlug = String(slug || '').trim();
+      const articles = await fetchArticles();
+      const article = articles.find((a) => a.slug === trimmedSlug);
+
+      if (!article) {
+        throw new Error(`Article with slug "${slug}" not found.`);
+      }
+
+      return {
+        ...article,
+        url: `${getBaseUrl().replace(/\/$/, '')}/articles/${article.slug}`,
+      };
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+  };
+
+  const listCategoriesTool: ModelContextTool = {
+    name: 'list_categories',
+    title: 'List Article Categories',
+    description: 'List all available article categories on The DevTools Times.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+    },
+    execute: async () => {
+      const defaultCategories = [
+        'Culture',
+        'Economy',
+        'Labor',
+        'Media',
+        'National',
+        'Pets',
+        'Politics',
+        'Urban Development',
+        'lifestyle',
+        'news',
+        'science',
+        'sports',
+      ];
+      return {
+        categories: defaultCategories,
+      };
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+  };
+
+  const getArticlesByCategoryTool: ModelContextTool = {
+    name: 'get_articles_by_category',
+    title: 'Get Articles by Category',
+    description: 'Fetch all articles belonging to a specific category.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        category: {
+          type: 'string',
+          description: 'The category name or slug to filter articles by',
+        },
+      },
+      required: ['category'],
+    },
+    execute: async ({ category }: { category: string }) => {
+      const targetCat = String(category || '').trim().toLowerCase();
+      const articles = await fetchArticles();
+      const matched = articles.filter(
+        (a) => (a.category || '').toLowerCase() === targetCat
+      );
+
+      return {
+        category,
+        count: matched.length,
+        articles: matched,
+      };
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+  };
+
+  const getReadingListTool: ModelContextTool = {
+    name: 'get_reading_list',
+    title: 'Get Reading List',
+    description: 'Retrieve the current user\'s saved reading list (bookmarked article slugs).',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+    },
+    execute: async () => {
+      const base = getBaseUrl();
+      const res = await fetch(`${base.replace(/\/$/, '')}/api/reading-list.json`);
+      if (!res.ok) {
+        throw new Error(`Failed to retrieve reading list: ${res.statusText}`);
+      }
+      const data = await res.json();
+      return {
+        readingList: data.readingList || [],
+      };
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+  };
+
+  const addToReadingListTool: ModelContextTool = {
+    name: 'add_to_reading_list',
+    title: 'Add to Reading List',
+    description: 'Add an article to the user\'s reading list by slug. Updates the UI bookmark state immediately.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'The slug of the article to bookmark',
+        },
+      },
+      required: ['slug'],
+    },
+    execute: async ({ slug }: { slug: string }) => {
+      const trimmedSlug = String(slug || '').trim();
+      const base = getBaseUrl();
+
+      // Check current reading list
+      const getRes = await fetch(`${base.replace(/\/$/, '')}/api/reading-list.json`);
+      const getData = await getRes.json();
+      let currentList: string[] = getData.readingList || [];
+
+      // Only toggle if not already present
+      if (!currentList.includes(trimmedSlug)) {
+        const postRes = await fetch(`${base.replace(/\/$/, '')}/api/reading-list.json`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ slug: trimmedSlug }),
+        });
+        const postData = await postRes.json();
+        currentList = postData.readingList || [];
+      }
+
+      // Dispatch UI update event so bookmark button and flyouts update immediately
+      if (typeof window !== 'undefined') {
+        window.dispatchEvent(
+          new CustomEvent('readinglistchange', {
+            detail: { slug: trimmedSlug, action: 'add', readingList: currentList },
+          })
+        );
+      }
+
+      return {
+        success: true,
+        slug: trimmedSlug,
+        readingList: currentList,
+      };
+    },
+  };
+
+  const removeFromReadingListTool: ModelContextTool = {
+    name: 'remove_from_reading_list',
+    title: 'Remove from Reading List',
+    description: 'Remove an article from the user\'s reading list by slug. Updates the UI bookmark state immediately.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'The slug of the article to remove',
+        },
+      },
+      required: ['slug'],
+    },
+    execute: async ({ slug }: { slug: string }) => {
+      const trimmedSlug = String(slug || '').trim();
+      const base = getBaseUrl();
+
+      // Check current reading list
+      const getRes = await fetch(`${base.replace(/\/$/, '')}/api/reading-list.json`);
+      const getData = await getRes.json();
+      let currentList: string[] = getData.readingList || [];
+
+      // If present, post to toggle it off
+      if (currentList.includes(trimmedSlug)) {
+        const postRes = await fetch(`${base.replace(/\/$/, '')}/api/reading-list.json`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ slug: trimmedSlug }),
+        });
+        const postData = await postRes.json();
+        currentList = postData.readingList || [];
+      }
+
+      // Dispatch UI update event
+      if (typeof window !== 'undefined') {
+        window.dispatchEvent(
+          new CustomEvent('readinglistchange', {
+            detail: { slug: trimmedSlug, action: 'remove', readingList: currentList },
+          })
+        );
+      }
+
+      return {
+        success: true,
+        slug: trimmedSlug,
+        readingList: currentList,
+      };
+    },
+  };
+
+  const getArticlePopularityTool: ModelContextTool = {
+    name: 'get_article_popularity',
+    title: 'Get Article Popularity',
+    description: 'Fetch view count and trending statistics for an article by its ID or slug.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        id: {
+          type: 'string',
+          description: 'The article identifier or slug',
+        },
+      },
+      required: ['id'],
+    },
+    execute: async ({ id }: { id: string }) => {
+      const base = getBaseUrl();
+      const res = await fetch(
+        `${base.replace(/\/$/, '')}/api/article-popularity?id=${encodeURIComponent(id)}`
+      );
+      if (!res.ok) {
+        throw new Error(`Failed to fetch article popularity: ${res.statusText}`);
+      }
+      return await res.json();
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+  };
+
+  const openUiDialogTool: ModelContextTool = {
+    name: 'open_ui_dialog',
+    title: 'Open or Close UI Dialog',
+    description: 'Open or close an interactive UI flyout dialog (search or reading_list).',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        dialog: {
+          type: 'string',
+          enum: ['search', 'reading_list'],
+          description: 'Which dialog to toggle: "search" or "reading_list"',
+        },
+        open: {
+          type: 'boolean',
+          description: 'true to open the dialog, false to close it',
+        },
+      },
+      required: ['dialog', 'open'],
+    },
+    execute: async ({ dialog, open }: { dialog: 'search' | 'reading_list'; open: boolean }) => {
+      if (typeof window !== 'undefined') {
+        window.dispatchEvent(
+          new CustomEvent('devtools:dialog', {
+            detail: { dialog, open: Boolean(open) },
+          })
+        );
+      }
+      return {
+        status: 'success',
+        dialog,
+        open: Boolean(open),
+      };
+    },
+  };
+
+  const navigateToTool: ModelContextTool = {
+    name: 'navigate_to',
+    title: 'Navigate to Page',
+    description: 'Navigate the page to a specific path within The DevTools Times.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        path: {
+          type: 'string',
+          description: 'Target route path (e.g. "/", "/category/science", "/signin", "/signup")',
+        },
+      },
+      required: ['path'],
+    },
+    execute: async ({ path }: { path: string }) => {
+      const cleanPath = String(path || '/');
+      const base = getBaseUrl().replace(/\/$/, '');
+      const fullUrl = cleanPath.startsWith('http')
+        ? cleanPath
+        : `${base}${cleanPath.startsWith('/') ? cleanPath : `/${cleanPath}`}`;
+
+      if (typeof window !== 'undefined') {
+        window.location.assign(fullUrl);
+      }
+
+      return {
+        status: 'navigating',
+        url: fullUrl,
+      };
+    },
+  };
+
+  return [
+    searchArticlesTool,
+    getArticleTool,
+    listCategoriesTool,
+    getArticlesByCategoryTool,
+    getReadingListTool,
+    addToReadingListTool,
+    removeFromReadingListTool,
+    getArticlePopularityTool,
+    openUiDialogTool,
+    navigateToTool,
+  ];
+}
+
+/**
+ * Registers all application tools to a ModelContext instance with an AbortSignal.
+ */
+export function registerAppTools(
+  context: ModelContext,
+  signal?: AbortSignal
+): void {
+  const tools = createAppTools();
+  for (const tool of tools) {
+    context.registerTool(tool, { signal });
+  }
+}
