diff --git a/src/pages/api/multimedia.json.ts b/src/pages/api/multimedia.json.ts
new file mode 100644
index 0000000..10045e1
--- /dev/null
+++ b/src/pages/api/multimedia.json.ts
@@ -0,0 +1,38 @@
+import { getCollection, getEntry } from 'astro:content';
+import type { APIRoute } from 'astro';
+
+export const GET: APIRoute = async ({ url }) => {
+    const slug = url.searchParams.get('slug');
+    if (slug) {
+        const item = await getEntry('multimedia', slug);
+        if (!item) {
+            return new Response(JSON.stringify({ error: 'Multimedia item not found' }), {
+                status: 404,
+                headers: { 'Content-Type': 'application/json' },
+            });
+        }
+        return new Response(JSON.stringify({
+            slug: item.id,
+            title: item.data.title,
+            description: item.data.description,
+            publishDate: item.data.publishDate,
+            category: item.data.category,
+            body: item.body,
+        }), {
+            headers: { 'Content-Type': 'application/json' },
+        });
+    }
+
+    const items = await getCollection('multimedia');
+    const formatted = items.map(m => ({
+        slug: m.id,
+        title: m.data.title,
+        description: m.data.description,
+        publishDate: m.data.publishDate,
+        category: m.data.category,
+    }));
+
+    return new Response(JSON.stringify(formatted), {
+        headers: { 'Content-Type': 'application/json' },
+    });
+};
