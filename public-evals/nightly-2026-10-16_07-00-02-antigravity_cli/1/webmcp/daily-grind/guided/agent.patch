+import { store } from "./store.js";
+import { registerWebMCPTools } from "./webmcp-tools.js";
+
+// Global AbortController for managing WebMCP tool lifecycle
+const appLifecycleController = new AbortController();
+
+// Target helper for backward-compatible lifecycle event handling
+const targetFor = (type, listener, options) =>
+  (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+    .addEventListener(type, listener, options);
+
+// Initialize application on DOM ready
+document.addEventListener("DOMContentLoaded", async () => {
+  initUI();
+  initDeclarativeForms();
+  initWebMCPLifecycleEvents();
+
+  // Register Imperative WebMCP tools with lifecycle unregistration signal
+  try {
+    const registered = await registerWebMCPTools(appLifecycleController.signal);
+    updateAgentBanner(`Ready (${registered.length} tools active)`);
+  } catch (err) {
+    console.error("[WebMCP] Registration failed:", err);
+    updateAgentBanner("Error initializing WebMCP");
+  }
+});
+
+/**
+ * Sets up listeners for WebMCP lifecycle events (`toolactivated`, `toolcancel`, `toolchange`).
+ */
+function initWebMCPLifecycleEvents() {
+  targetFor("toolactivated", (evt) => {
+    const toolName = evt.toolName || evt.detail?.toolName || "unknown-tool";
+    console.info(`[WebMCP Event] Tool '${toolName}' activated.`);
+    logAgentActivity(`⚡ Tool '${toolName}' activated`);
+  });
+
+  targetFor("toolcancel", (evt) => {
+    const toolName = evt.toolName || evt.detail?.toolName || "unknown-tool";
+    console.warn(`[WebMCP Event] Tool '${toolName}' canceled.`);
+    logAgentActivity(`⛔ Tool '${toolName}' canceled`);
+  });
+
+  if (document.modelContext && typeof document.modelContext.addEventListener === "function") {
+    document.modelContext.addEventListener("toolchange", async () => {
+      if (document.modelContext.getTools) {
+        const tools = await document.modelContext.getTools();
+        console.info(`[WebMCP Event] Active tools changed: ${tools.map(t => t.name).join(", ")}`);
+        updateAgentBanner(`Active (${tools.length} tools)`);
+      }
+    });
+  }
+}
+
+/**
+ * Initializes Declarative WebMCP `<form>` submissions with `event.agentInvoked` and `event.respondWith()`.
+ */
+function initDeclarativeForms() {
+  // 1. Menu Search & Filter Form
+  const searchMenuForm = document.getElementById("search-menu-form");
+  if (searchMenuForm) {
+    searchMenuForm.addEventListener("submit", (event) => {
+      event.preventDefault();
+      const formData = new FormData(searchMenuForm);
+      const query = (formData.get("query") || "").toString();
+      const category = (formData.get("category") || "all").toString();
+      const maxPriceVal = formData.get("maxPrice");
+      const maxPrice = maxPriceVal ? parseFloat(maxPriceVal.toString()) : null;
+
+      const results = store.getMenuItems({ category, maxPrice, query });
+      renderMenu(results);
+
+      logAgentActivity(`Form 'search-menu' submitted -> ${results.length} item(s) found`);
+
+      if (event.agentInvoked && typeof event.respondWith === "function") {
+        event.respondWith(Promise.resolve(JSON.stringify({
+          count: results.length,
+          items: results.map(i => ({ id: i.id, name: i.name, price: i.price, category: i.category }))
+        })));
+      }
+    });
+  }
+
+  // 2. Locations Search Form
+  const searchLocationsForm = document.getElementById("search-locations-form");
+  if (searchLocationsForm) {
+    searchLocationsForm.addEventListener("submit", (event) => {
+      event.preventDefault();
+      const formData = new FormData(searchLocationsForm);
+      const query = (formData.get("query") || "").toString();
+
+      const results = store.getLocations(query);
+      renderLocations(results);
+
+      logAgentActivity(`Form 'search-locations' submitted -> ${results.length} location(s) found`);
+
+      if (event.agentInvoked && typeof event.respondWith === "function") {
+        event.respondWith(Promise.resolve(JSON.stringify({
+          count: results.length,
+          locations: results
+        })));
+      }
+    });
+  }
+
+  // 3. Redeem Reward / Promo Code Form
+  const promoForm = document.getElementById("redeem-reward-form");
+  if (promoForm) {
+    promoForm.addEventListener("submit", (event) => {
+      event.preventDefault();
+      const formData = new FormData(promoForm);
+      const promoCode = (formData.get("promoCode") || "").toString().trim();
+
+      const result = store.applyPromoCode(promoCode);
+      const feedbackEl = document.getElementById("promo-feedback");
+
+      if (result.error) {
+        if (feedbackEl) {
+          feedbackEl.textContent = result.error;
+          feedbackEl.style.color = "#c62828";
+        }
+        if (event.agentInvoked && typeof event.respondWith === "function") {
+          event.respondWith(Promise.resolve(JSON.stringify(result)));
+        }
+        return;
+      }
+
+      if (feedbackEl) {
+        feedbackEl.textContent = result.message;
+        feedbackEl.style.color = "#2e7d32";
+      }
+      promoForm.reset();
+      logAgentActivity(`Applied promo: ${promoCode}`);
+
+      if (event.agentInvoked && typeof event.respondWith === "function") {
+        event.respondWith(Promise.resolve(JSON.stringify(result)));
+      }
+    });
+  }
+
+  // 4. Checkout Order Form (Transactional - Omits toolautosubmit)
+  const checkoutForm = document.getElementById("checkout-order-form");
+  if (checkoutForm) {
+    checkoutForm.addEventListener("submit", (event) => {
+      event.preventDefault();
+      const formData = new FormData(checkoutForm);
+      const customerName = (formData.get("customerName") || "").toString();
+      const locationId = (formData.get("locationId") || "").toString();
+      const pickupTime = (formData.get("pickupTime") || "asap").toString();
+      const specialInstructions = (formData.get("specialInstructions") || "").toString();
+
+      const validationErrors = [];
+      if (!customerName.trim()) validationErrors.push("Customer name is required");
+      if (!locationId.trim()) validationErrors.push("Pickup location is required");
+      if (store.cart.length === 0) validationErrors.push("Shopping cart is empty");
+
+      if (validationErrors.length > 0) {
+        const errorMsg = "Validation failed: " + validationErrors.join(", ");
+        alert(errorMsg);
+        if (event.agentInvoked && typeof event.respondWith === "function") {
+          event.respondWith(Promise.resolve(JSON.stringify({ error: errorMsg })));
+        }
+        return;
+      }
+
+      const result = store.placeOrder({
+        customerName,
+        locationId,
+        pickupTime,
+        notes: specialInstructions
+      });
+
+      if (result.success) {
+        showOrderConfirmation(result);
+        checkoutForm.reset();
+        logAgentActivity(`Order placed: ${result.order.orderNumber}`);
+      }
+
+      if (event.agentInvoked && typeof event.respondWith === "function") {
+        event.respondWith(Promise.resolve(JSON.stringify(result)));
+      }
+    });
+  }
+
+  // 5. Customer Feedback Form
+  const feedbackForm = document.getElementById("send-feedback-form");
+  if (feedbackForm) {
+    feedbackForm.addEventListener("submit", (event) => {
+      event.preventDefault();
+      const formData = new FormData(feedbackForm);
+      const senderName = (formData.get("senderName") || "").toString();
+      const senderEmail = (formData.get("senderEmail") || "").toString();
+      const feedbackMessage = (formData.get("feedbackMessage") || "").toString();
+
+      const res = {
+        success: true,
+        message: `Thank you ${senderName}! Your feedback has been received.`
+      };
+
+      const feedbackStatus = document.getElementById("feedback-status");
+      if (feedbackStatus) {
+        feedbackStatus.textContent = res.message;
+        feedbackStatus.style.display = "block";
+        feedbackForm.reset();
+      }
+
+      logAgentActivity(`Feedback submitted by ${senderName}`);
+
+      if (event.agentInvoked && typeof event.respondWith === "function") {
+        event.respondWith(Promise.resolve(JSON.stringify(res)));
+      }
+    });
+  }
+}
+
+/**
+ * Initializes DOM elements, navigation events, and reactive store subscriptions.
+ */
+function initUI() {
+  // Render Initial Data
+  renderMenu(store.menu);
+  renderLocations(store.locations);
+  renderRewards(store.rewards);
+  updateCartUI(store.getCartSummary());
+
+  // Store subscription for live reactive UI updates
+  store.subscribe((state) => {
+    updateCartUI(state.getCartSummary());
+    renderRewards(state.rewards);
+  });
+
+  // Cart Drawer open/close
+  const cartBtn = document.getElementById("nav-cart-btn");
+  const drawerOverlay = document.getElementById("cart-drawer-overlay");
+  const closeDrawerBtn = document.getElementById("close-drawer-btn");
+
+  if (cartBtn && drawerOverlay) {
+    cartBtn.addEventListener("click", () => drawerOverlay.classList.add("active"));
+  }
+  if (closeDrawerBtn && drawerOverlay) {
+    closeDrawerBtn.addEventListener("click", () => drawerOverlay.classList.remove("active"));
+  }
+  if (drawerOverlay) {
+    drawerOverlay.addEventListener("click", (e) => {
+      if (e.target === drawerOverlay) drawerOverlay.classList.remove("active");
+    });
+  }
+
+  // Clear Cart Button
+  const clearCartBtn = document.getElementById("clear-cart-btn");
+  if (clearCartBtn) {
+    clearCartBtn.addEventListener("click", () => store.clearCart());
+  }
+}
+
+/**
+ * Renders menu item cards.
+ */
+function renderMenu(items) {
+  const grid = document.getElementById("menu-grid");
+  if (!grid) return;
+
+  if (items.length === 0) {
+    grid.innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 40px; color: var(--text-muted);">
+      No menu items matched your search criteria. Try adjusting your filters.
+    </div>`;
+    return;
+  }
+
+  grid.innerHTML = items.map(item => `
+    <article class="menu-card" data-item-id="${item.id}">
+      <div class="card-image-wrapper">
+        <img class="card-image" src="${item.image}" alt="${item.name}" loading="lazy" />
+        <span class="card-badge">${item.category}</span>
+      </div>
+      <div class="card-body">
+        <div class="card-title-row">
+          <h3 class="card-title">${item.name}</h3>
+          <span class="card-price">$${item.price.toFixed(2)}</span>
+        </div>
+        <p class="card-description">${item.description}</p>
+        <div class="card-meta">
+          <span>${item.calories} kcal</span>
+          ${item.allergens.length ? ` • Allergens: ${item.allergens.join(", ")}` : ""}
+        </div>
+        <div class="customization-row">
+          <select class="size-select" aria-label="Select size for ${item.name}">
+            <option value="regular">Regular</option>
+            <option value="large">Large (+$0.75)</option>
+          </select>
+          <select class="milk-select" aria-label="Select milk for ${item.name}">
+            <option value="whole">Whole Milk</option>
+            <option value="oat">Oat Milk</option>
+            <option value="almond">Almond Milk</option>
+            <option value="skim">Skim Milk</option>
+            <option value="none">No Milk</option>
+          </select>
+        </div>
+        <button class="btn-primary add-btn" data-id="${item.id}">Add to Order</button>
+      </div>
+    </article>
+  `).join("");
+
+  // Attach click listeners to Add buttons
+  grid.querySelectorAll(".add-btn").forEach(btn => {
+    btn.addEventListener("click", () => {
+      const itemId = btn.getAttribute("data-id");
+      const card = btn.closest(".menu-card");
+      const size = card.querySelector(".size-select").value;
+      const milk = card.querySelector(".milk-select").value;
+      store.addToCart({ itemId, size, milk, quantity: 1 });
+      logAgentActivity(`Added '${itemId}' (${size}, ${milk}) to cart`);
+    });
+  });
+}
+
+/**
+ * Updates cart drawer UI and navigation badge.
+ */
+function updateCartUI(summary) {
+  const badge = document.getElementById("cart-badge-count");
+  if (badge) {
+    badge.textContent = summary.itemCount;
+  }
+
+  const listEl = document.getElementById("cart-items-list");
+  if (!listEl) return;
+
+  if (summary.items.length === 0) {
+    listEl.innerHTML = `<div class="cart-empty">Your shopping cart is currently empty.<br/>Browse our menu to add some handcrafted coffee!</div>`;
+  } else {
+    listEl.innerHTML = summary.items.map(item => `
+      <div class="cart-item">
+        <div class="cart-item-info">
+          <h4>${item.name}</h4>
+          <div class="cart-item-opts">Size: ${item.size} | Milk: ${item.milk} ${item.notes ? `| Note: ${item.notes}` : ""}</div>
+        </div>
+        <div class="cart-item-actions">
+          <button class="qty-btn" onclick="window.dailyGrindUpdateQty(${item.index}, ${item.quantity - 1})">-</button>
+          <span style="font-weight: 600; min-width: 20px; text-align: center;">${item.quantity}</span>
+          <button class="qty-btn" onclick="window.dailyGrindUpdateQty(${item.index}, ${item.quantity + 1})">+</button>
+          <span class="cart-item-price">$${item.lineTotal.toFixed(2)}</span>
+          <button class="qty-btn" style="color: #c62828;" onclick="window.dailyGrindRemoveItem(${item.index})" title="Remove item">&times;</button>
+        </div>
+      </div>
+    `).join("");
+  }
+
+  document.getElementById("cart-raw-subtotal").textContent = `$${summary.rawSubtotal.toFixed(2)}`;
+  document.getElementById("cart-discount").textContent = summary.discount > 0 ? `-$${summary.discount.toFixed(2)}` : "$0.00";
+  document.getElementById("cart-tax").textContent = `$${summary.tax.toFixed(2)}`;
+  document.getElementById("cart-total").textContent = `$${summary.total.toFixed(2)}`;
+}
+
+// Global helpers for inline cart click actions
+window.dailyGrindUpdateQty = (idx, qty) => store.updateQuantity(idx, qty);
+window.dailyGrindRemoveItem = (idx) => store.removeFromCart(idx);
+
+/**
+ * Renders locations list cards.
+ */
+function renderLocations(locations) {
+  const container = document.getElementById("locations-container");
+  if (!container) return;
+
+  if (locations.length === 0) {
+    container.innerHTML = `<p style="color: var(--text-muted);">No locations found matching your search.</p>`;
+    return;
+  }
+
+  container.innerHTML = locations.map(loc => `
+    <div class="info-card">
+      <h3>${loc.name}</h3>
+      <p><strong>Address:</strong> ${loc.address}</p>
+      <p><strong>Phone:</strong> ${loc.phone}</p>
+      <p><strong>Hours:</strong> ${loc.hours}</p>
+      <div class="amenity-pills">
+        ${loc.amenities.map(a => `<span class="amenity-pill">${a}</span>`).join("")}
+      </div>
+    </div>
+  `).join("");
+}
+
+/**
+ * Renders rewards account profile.
+ */
+function renderRewards(rewards) {
+  const pointsEl = document.getElementById("rewards-points-count");
+  const tierEl = document.getElementById("rewards-tier-badge");
+  const memberEl = document.getElementById("rewards-member-name");
+
+  if (pointsEl) pointsEl.textContent = rewards.points;
+  if (tierEl) tierEl.textContent = rewards.tier;
+  if (memberEl) memberEl.textContent = rewards.memberName;
+}
+
+/**
+ * Shows order confirmation banner.
+ */
+function showOrderConfirmation(result) {
+  const alertEl = document.getElementById("order-confirmation-alert");
+  if (!alertEl) return;
+
+  alertEl.innerHTML = `
+    <h3 style="color: #2e7d32; margin-bottom: 6px;">🎉 Order Confirmed: ${result.order.orderNumber}</h3>
+    <p>Thank you, <strong>${result.order.customerName}</strong>! Your order will be ready for pickup in approximately <strong>${result.order.estimatedReadyMinutes} minutes</strong> at <strong>${result.order.location.name}</strong>.</p>
+    <p style="margin-top: 6px; font-size: 0.9rem;">You earned <strong>+${result.earnedPoints} points</strong>! New balance: ${result.newPointsBalance} pts.</p>
+  `;
+  alertEl.classList.add("show");
+  alertEl.scrollIntoView({ behavior: "smooth" });
+
+  const drawerOverlay = document.getElementById("cart-drawer-overlay");
+  if (drawerOverlay) drawerOverlay.classList.remove("active");
+}
+
+function updateAgentBanner(status) {
+  const el = document.getElementById("agent-status-label");
+  if (el) el.textContent = status;
+}
+
+function logAgentActivity(msg) {
+  const feed = document.getElementById("agent-activity-feed");
+  if (feed) {
+    const timestamp = new Date().toLocaleTimeString();
+    feed.textContent = `[${timestamp}] ${msg}`;
+  }
+}
