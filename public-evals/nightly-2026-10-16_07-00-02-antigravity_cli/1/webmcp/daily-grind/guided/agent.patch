@@ -0,0 +1,155 @@
+/**
+ * Lightweight WebMCP polyfill implementing the W3C Web Model Context Protocol specification
+ * for environments without native document.modelContext support (such as browsers without the flag,
+ * Node.js test harnesses, or non-Chromium engines).
+ */
+class ModelContextPolyfill extends EventTarget {
+  constructor() {
+    super();
+    this._tools = new Map();
+  }
+
+  /**
+   * Registers a client-side tool with WebMCP.
+   * @param {Object} toolDefinition - { name, description, inputSchema, execute, annotations }
+   * @param {Object} [options] - { signal, exposedTo }
+   */
+  async registerTool(toolDefinition, options = {}) {
+    if (!toolDefinition || typeof toolDefinition !== "object") {
+      throw new TypeError("toolDefinition must be an object");
+    }
+    if (!toolDefinition.name || typeof toolDefinition.name !== "string") {
+      throw new TypeError("toolDefinition.name is required");
+    }
+    if (typeof toolDefinition.execute !== "function") {
+      throw new TypeError("toolDefinition.execute must be a function");
+    }
+
+    const toolName = toolDefinition.name;
+    const registeredTool = {
+      name: toolName,
+      description: toolDefinition.description || "",
+      inputSchema: toolDefinition.inputSchema ? JSON.parse(JSON.stringify(toolDefinition.inputSchema)) : { type: "object", properties: {} },
+      annotations: toolDefinition.annotations ? { ...toolDefinition.annotations } : {},
+      execute: toolDefinition.execute
+    };
+
+    this._tools.set(toolName, registeredTool);
+
+    // Support unregistering via AbortSignal as specified in WebMCP
+    if (options.signal) {
+      if (options.signal.aborted) {
+        this._tools.delete(toolName);
+        this._dispatchToolChange();
+        return;
+      }
+      options.signal.addEventListener("abort", () => {
+        if (this._tools.get(toolName) === registeredTool) {
+          this._tools.delete(toolName);
+          this._dispatchToolChange();
+        }
+      }, { once: true });
+    }
+
+    this._dispatchToolChange();
+  }
+
+  /**
+   * Discovers currently registered tools.
+   */
+  async getTools(options = {}) {
+    return Array.from(this._tools.values()).map(tool => ({
+      name: tool.name,
+      description: tool.description,
+      inputSchema: JSON.parse(JSON.stringify(tool.inputSchema)),
+      annotations: { ...tool.annotations },
+      execute: tool.execute
+    }));
+  }
+
+  /**
+   * Executes a registered tool on behalf of an agent or test runner.
+   */
+  async executeTool(tool, inputObject = {}, options = {}) {
+    const toolName = typeof tool === "string" ? tool : tool?.name;
+    const targetTool = this._tools.get(toolName);
+    if (!targetTool) {
+      throw new Error(`Tool "${toolName}" is not registered.`);
+    }
+
+    let parsedInput = inputObject;
+    if (typeof inputObject === "string") {
+      try {
+        parsedInput = JSON.parse(inputObject);
+      } catch (err) {
+        throw new Error(`Failed to parse input JSON: ${err.message}`);
+      }
+    }
+
+    // Fire toolactivated lifecycle event
+    const activatedEvent = new CustomEvent("toolactivated", { detail: { toolName } });
+    activatedEvent.toolName = toolName;
+    this.dispatchEvent(activatedEvent);
+
+    const execSignal = options.signal;
+
+    if (execSignal && execSignal.aborted) {
+      const cancelEvent = new CustomEvent("toolcancel", { detail: { toolName } });
+      cancelEvent.toolName = toolName;
+      this.dispatchEvent(cancelEvent);
+      throw new DOMException("Execution was aborted", "AbortError");
+    }
+
+    let abortHandler = null;
+    const abortPromise = new Promise((_, reject) => {
+      if (execSignal) {
+        abortHandler = () => {
+          const cancelEvent = new CustomEvent("toolcancel", { detail: { toolName } });
+          cancelEvent.toolName = toolName;
+          this.dispatchEvent(cancelEvent);
+          reject(new DOMException("Execution was aborted", "AbortError"));
+        };
+        execSignal.addEventListener("abort", abortHandler, { once: true });
+      }
+    });
+
+    try {
+      const execResult = await Promise.race([
+        Promise.resolve(targetTool.execute(parsedInput, { signal: execSignal })),
+        abortPromise
+      ]);
+
+      if (typeof execResult === "object" && execResult !== null) {
+        return JSON.stringify(execResult);
+      }
+      return String(execResult ?? "");
+    } finally {
+      if (execSignal && abortHandler) {
+        execSignal.removeEventListener("abort", abortHandler);
+      }
+    }
+  }
+
+  _dispatchToolChange() {
+    const changeEvent = new CustomEvent("toolchange");
+    this.dispatchEvent(changeEvent);
+  }
+}
+
+// Polyfill window.document.modelContext if not provided by browser
+if (typeof window !== "undefined" && typeof document !== "undefined") {
+  if (!("modelContext" in document) || !document.modelContext) {
+    try {
+      Object.defineProperty(document, "modelContext", {
+        value: new ModelContextPolyfill(),
+        writable: true,
+        configurable: true
+      });
+      console.info("[WebMCP] Initialized document.modelContext polyfill.");
+    } catch (e) {
+      document.modelContext = new ModelContextPolyfill();
+    }
+  }
+}
+
+export { ModelContextPolyfill };
