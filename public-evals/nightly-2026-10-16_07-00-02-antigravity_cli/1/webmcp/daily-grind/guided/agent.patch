+++ b/test/webmcp.test.js
@@ -0,0 +1,217 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { ModelContextPolyfill } from "../js/webmcp-polyfill.js";
+import { registerWebMCPTools } from "../js/webmcp-tools.js";
+import { store } from "../js/store.js";
+
+// Setup mock DOM environment for Node.js
+function setupEnvironment() {
+  const polyfill = new ModelContextPolyfill();
+  globalThis.document = {
+    modelContext: polyfill
+  };
+  globalThis.window = {
+    document: globalThis.document
+  };
+  return polyfill;
+}
+
+test("WebMCP Imperative Tool Registration", async (t) => {
+  setupEnvironment();
+  const lifecycleController = new AbortController();
+
+  const registeredNames = await registerWebMCPTools(lifecycleController.signal);
+
+  assert.equal(registeredNames.length, 11);
+  assert.ok(registeredNames.includes("get_menu"));
+  assert.ok(registeredNames.includes("get_item_details"));
+  assert.ok(registeredNames.includes("add_to_cart"));
+  assert.ok(registeredNames.includes("get_cart"));
+  assert.ok(registeredNames.includes("remove_from_cart"));
+  assert.ok(registeredNames.includes("clear_cart"));
+  assert.ok(registeredNames.includes("apply_promo_code"));
+  assert.ok(registeredNames.includes("place_order"));
+  assert.ok(registeredNames.includes("get_locations"));
+  assert.ok(registeredNames.includes("get_reward_points"));
+  assert.ok(registeredNames.includes("dump_app_state"));
+
+  const tools = await document.modelContext.getTools();
+  assert.equal(tools.length, 11);
+});
+
+test("Tool Annotations Compliance", async (t) => {
+  setupEnvironment();
+  await registerWebMCPTools();
+  const tools = await document.modelContext.getTools();
+
+  const getMenuTool = tools.find(t => t.name === "get_menu");
+  assert.equal(getMenuTool.annotations.readOnlyHint, true, "get_menu should be marked readOnlyHint: true");
+
+  const placeOrderTool = tools.find(t => t.name === "place_order");
+  assert.equal(placeOrderTool.annotations.readOnlyHint, false, "place_order mutates state");
+  assert.equal(placeOrderTool.annotations.consequentialHint, true, "place_order should be marked consequentialHint: true");
+
+  const dumpStateTool = tools.find(t => t.name === "dump_app_state");
+  assert.equal(dumpStateTool.annotations.debugging, true, "dump_app_state should be marked debugging: true");
+  assert.equal(dumpStateTool.annotations.readOnlyHint, true, "dump_app_state is read-only");
+});
+
+test("Tool Execution: get_menu filtering", async (t) => {
+  setupEnvironment();
+  await registerWebMCPTools();
+
+  // Test full menu
+  const fullResultRaw = await document.modelContext.executeTool("get_menu", {});
+  const fullResult = JSON.parse(fullResultRaw);
+  assert.ok(fullResult.count >= 8);
+
+  // Test category filtering
+  const latteResultRaw = await document.modelContext.executeTool("get_menu", { category: "latte" });
+  const latteResult = JSON.parse(latteResultRaw);
+  assert.ok(latteResult.items.length >= 1);
+  assert.ok(latteResult.items.every(i => i.category === "latte"));
+
+  // Test price filtering
+  const cheapResultRaw = await document.modelContext.executeTool("get_menu", { maxPrice: 4.00 });
+  const cheapResult = JSON.parse(cheapResultRaw);
+  assert.ok(cheapResult.items.every(i => i.price <= 4.00));
+
+  // Test invalid category error handling (structured error, not throwing)
+  const invalidResultRaw = await document.modelContext.executeTool("get_menu", { category: "non-existent" });
+  const invalidResult = JSON.parse(invalidResultRaw);
+  assert.ok(invalidResult.error);
+  assert.ok(Array.isArray(invalidResult.validCategories));
+});
+
+test("Tool Execution: get_item_details structured errors", async (t) => {
+  setupEnvironment();
+  await registerWebMCPTools();
+
+  // Valid item
+  const validRaw = await document.modelContext.executeTool("get_item_details", { itemId: "maple-oat-latte" });
+  const valid = JSON.parse(validRaw);
+  assert.equal(valid.name, "Maple Oat Latte");
+  assert.equal(valid.price, 5.75);
+
