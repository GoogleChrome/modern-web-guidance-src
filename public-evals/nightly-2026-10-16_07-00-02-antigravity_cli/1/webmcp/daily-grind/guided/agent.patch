+import { store } from "./store.js";
+
+/**
+ * Registers all Imperative WebMCP tools on document.modelContext.
+ * Adheres strictly to the WebMCP Imperative API best practice guidelines.
+ *
+ * @param {AbortSignal} [signal] - Optional signal to unregister tools on unmount or page transition.
+ * @returns {Promise<Array<string>>} - Array of registered tool names.
+ */
+export async function registerWebMCPTools(signal) {
+  // Guard with feature detection as recommended by the WebMCP spec
+  if (!("modelContext" in document) || !document.modelContext) {
+    console.warn("[WebMCP] document.modelContext is not supported in this browser environment.");
+    return [];
+  }
+
+  const modelContext = document.modelContext;
+  const registeredNames = [];
+
+  const CATEGORY_ENUM = ["all", "espresso", "latte", "cold-brew", "tea", "bakery"];
+  const SIZE_ENUM = ["regular", "large"];
+  const MILK_ENUM = ["whole", "oat", "almond", "skim", "none"];
+  const LOCATION_ENUM = ["downtown", "arts-district", "uptown"];
+  const PICKUP_TIME_ENUM = ["asap", "in-15-mins", "in-30-mins", "in-1-hour"];
+
+  // Tool 1: get_menu
+  await modelContext.registerTool({
+    name: "get_menu",
+    description: "Searches and filters the coffee shop menu catalog by category, maximum price, or query keyword. Use when the user asks what coffee, drinks, or food items are available.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        category: {
+          type: "string",
+          enum: CATEGORY_ENUM,
+          default: "all",
+          description: "Category of menu items to filter by."
+        },
+        maxPrice: {
+          type: "number",
+          minimum: 0,
+          description: "Maximum allowable price in dollars."
+        },
+        query: {
+          type: "string",
+          description: "Keyword matching drink name or ingredient descriptions."
+        }
+      }
+    },
+    execute({ category = "all", maxPrice, query = "" } = {}, { signal: execSignal } = {}) {
+      if (execSignal?.aborted) {
+        throw new DOMException("Execution was aborted", "AbortError");
+      }
+      if (category && !CATEGORY_ENUM.includes(category)) {
+        return {
+          error: `Invalid category '${category}'.`,
+          validCategories: CATEGORY_ENUM
+        };
+      }
+      const items = store.getMenuItems({ category, maxPrice, query });
+      return {
+        count: items.length,
+        items: items.map(item => ({
+          id: item.id,
+          name: item.name,
+          category: item.category,
+          price: item.price,
+          description: item.description,
+          calories: item.calories,
+          allergens: item.allergens
+        }))
+      };
+    },
+    annotations: {
+      readOnlyHint: true,
+      untrustedContentHint: false
+    }
+  }, { signal });
+  registeredNames.push("get_menu");
+
+  // Tool 2: get_item_details
+  await modelContext.registerTool({
+    name: "get_item_details",
+    description: "Retrieves complete specifications, ingredients, allergens, calories, and customization options for a specific menu item. Use when the user asks questions about a specific beverage or food item.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        itemId: {
+          type: "string",
+          description: "Unique menu item identifier (e.g. maple-oat-latte, dark-roast-espresso)."
+        }
+      },
+      required: ["itemId"]
+    },
+    execute({ itemId } = {}, { signal: execSignal } = {}) {
+      if (execSignal?.aborted) {
+        throw new DOMException("Execution was aborted", "AbortError");
+      }
+      if (!itemId || typeof itemId !== "string") {
+        return {
+          error: "Missing required parameter 'itemId'.",
+          availableItemIds: store.menu.map(i => i.id)
+        };
+      }
+      const item = store.getItemById(itemId);
+      if (!item) {
+        return {
+          error: `Menu item '${itemId}' was not found.`,
+          availableItemIds: store.menu.map(i => i.id)
+        };
+      }
+      return item;
+    },
+    annotations: {
+      readOnlyHint: true,
+      untrustedContentHint: false
+    }
+  }, { signal });
+  registeredNames.push("get_item_details");
+
+  // Tool 3: add_to_cart
+  await modelContext.registerTool({
+    name: "add_to_cart",
+    description: "Adds a beverage or bakery item to the customer's current shopping cart with custom preparation options. Use when the customer wants to add an item to their order.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        itemId: {
+          type: "string",
+          description: "Unique menu item identifier (e.g. maple-oat-latte, cold-brew)."
+        },
+        quantity: {
+          type: "integer",
+          minimum: 1,
+          default: 1,
+          description: "Number of units to add to the cart."
+        },
+        size: {
+          type: "string",
+          enum: SIZE_ENUM,
+          default: "regular",
+          description: "Cup size selection."
+        },
+        milk: {
+          type: "string",
+          enum: MILK_ENUM,
+          default: "whole",
+          description: "Milk or milk-alternative choice."
+        },
+        notes: {
+          type: "string",
+          description: "Special barista instructions or dietary preferences."
+        }
+      },
+      required: ["itemId"]
+    },
+    execute({ itemId, quantity = 1, size = "regular", milk = "whole", notes = "" } = {}, { signal: execSignal } = {}) {
+      if (execSignal?.aborted) {
+        throw new DOMException("Execution was aborted", "AbortError");
+      }
+      if (!itemId || typeof itemId !== "string") {
+        return {
+          error: "Missing required parameter 'itemId'.",
+          availableItemIds: store.menu.map(i => i.id)
+        };
+      }
+      if (!SIZE_ENUM.includes(size)) {
+        return { error: `Invalid size '${size}'.`, validSizes: SIZE_ENUM };
+      }
+      if (!MILK_ENUM.includes(milk)) {
+        return { error: `Invalid milk option '${milk}'.`, validMilkOptions: MILK_ENUM };
+      }
+      const qty = parseInt(quantity, 10);
+      if (isNaN(qty) || qty < 1) {
+        return { error: `Quantity must be an integer >= 1. Received: ${quantity}` };
+      }
+
+      return store.addToCart({ itemId, quantity: qty, size, milk, notes });
+    },
+    annotations: {
+      readOnlyHint: false,
+      consequentialHint: false,
+      untrustedContentHint: false
+    }
+  }, { signal });
+  registeredNames.push("add_to_cart");
+
+  // Tool 4: get_cart
+  await modelContext.registerTool({
+    name: "get_cart",
+    description: "Retrieves the current shopping cart contents, line item customizations, subtotal, discount, tax, and total. Use when the user asks what is in their cart or wants to review before ordering.",
+    inputSchema: {
+      type: "object",
+      properties: {}
+    },
+    execute(_, { signal: execSignal } = {}) {
+      if (execSignal?.aborted) {
+        throw new DOMException("Execution was aborted", "AbortError");
+      }
+      return store.getCartSummary();
+    },
+    annotations: {
+      readOnlyHint: true,
+      untrustedContentHint: false
+    }
+  }, { signal });
+  registeredNames.push("get_cart");
+
+  // Tool 5: remove_from_cart
+  await modelContext.registerTool({
+    name: "remove_from_cart",
+    description: "Removes an item line from the current shopping cart by index. Use when the user wants to remove an item from their cart.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        index: {
+          type: "integer",
+          minimum: 0,
+          description: "Zero-based index of the item line in the cart to remove."
+        }
+      },
+      required: ["index"]
+    },
+    execute({ index } = {}, { signal: execSignal } = {}) {
+      if (execSignal?.aborted) {
+        throw new DOMException("Execution was aborted", "AbortError");
+      }
+      const idx = parseInt(index, 10);
+      if (isNaN(idx) || idx < 0) {
+        return { error: `Invalid index '${index}'. Must be a non-negative integer.` };
+      }
+      return store.removeFromCart(idx);
+    },
+    annotations: {
+      readOnlyHint: false,
+      consequentialHint: false
+    }
+  }, { signal });
+  registeredNames.push("remove_from_cart");
+
+  // Tool 6: clear_cart
+  await modelContext.registerTool({
+    name: "clear_cart",
+    description: "Empties all items and resets discounts from the current shopping cart. Use when the user asks to empty or clear their cart.",
+    inputSchema: {
+      type: "object",
+      properties: {}
+    },
+    execute(_, { signal: execSignal } = {}) {
+      if (execSignal?.aborted) {
+        throw new DOMException("Execution was aborted", "AbortError");
+      }
+      return store.clearCart();
+    },
+    annotations: {
+      readOnlyHint: false,
+      consequentialHint: false
+    }
+  }, { signal });
+  registeredNames.push("clear_cart");
+
+  // Tool 7: apply_promo_code
+  await modelContext.registerTool({
+    name: "apply_promo_code",
+    description: "Applies a promotional discount code or loyalty voucher to the shopping cart. Use when the user provides a coupon code or wants to use a promotion.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        promoCode: {
+          type: "string",
+          description: "Promotional or voucher code to apply."
+        }
+      },
+      required: ["promoCode"]
+    },
+    execute({ promoCode } = {}, { signal: execSignal } = {}) {
+      if (execSignal?.aborted) {
+        throw new DOMException("Execution was aborted", "AbortError");
+      }
+      return store.applyPromoCode(promoCode);
+    },
+    annotations: {
+      readOnlyHint: false,
+      consequentialHint: false
+    }
+  }, { signal });
+  registeredNames.push("apply_promo_code");
+
+  // Tool 8: place_order (consequential tool!)
+  await modelContext.registerTool({
+    name: "place_order",
+    description: "Finalizes the shopping cart, submits the order for store pickup, and returns an order confirmation receipt with estimated ready time. Use only after the user has reviewed their cart and explicitly confirmed they want to place the order.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        customerName: {
+          type: "string",
+          description: "Full name for order pickup."
+        },
+        locationId: {
+          type: "string",
+          enum: LOCATION_ENUM,
+          description: "Identifier of the store location for pickup."
+        },
+        pickupTime: {
+          type: "string",
+          enum: PICKUP_TIME_ENUM,
+          default: "asap",
+          description: "Timing for pickup preparation."
+        },
+        notes: {
+          type: "string",
+          description: "Special instructions for the barista or kitchen."
+        }
+      },
+      required: ["customerName", "locationId"]
+    },
+    execute({ customerName, locationId, pickupTime = "asap", notes = "" } = {}, { signal: execSignal } = {}) {
+      if (execSignal?.aborted) {
+        throw new DOMException("Execution was aborted", "AbortError");
+      }
+      if (!customerName || typeof customerName !== "string" || customerName.trim() === "") {
+        return { error: "Missing required parameter 'customerName'." };
+      }
+      if (!locationId || !LOCATION_ENUM.includes(locationId)) {
+        return {
+          error: `Invalid or missing 'locationId'.`,
+          validLocationIds: LOCATION_ENUM
+        };
+      }
+      if (pickupTime && !PICKUP_TIME_ENUM.includes(pickupTime)) {
+        return {
+          error: `Invalid 'pickupTime' '${pickupTime}'.`,
+          validPickupTimes: PICKUP_TIME_ENUM
+        };
+      }
+
+      return store.placeOrder({ customerName, locationId, pickupTime, notes });
+    },
+    annotations: {
+      readOnlyHint: false,
+      consequentialHint: true, // Marked consequential for transactional order placement
+      untrustedContentHint: false
+    }
+  }, { signal });
+  registeredNames.push("place_order");
+
+  // Tool 9: get_locations
+  await modelContext.registerTool({
+    name: "get_locations",
+    description: "Retrieves coffee shop store locations, physical addresses, opening hours, phone numbers, and amenities. Use when the user asks for store locations, hours, or features like Wi-Fi or drive-thru.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        query: {
+          type: "string",
+          description: "Search keyword matching neighborhood, street name, or amenities."
+        }
+      }
+    },
+    execute({ query = "" } = {}, { signal: execSignal } = {}) {
+      if (execSignal?.aborted) {
+        throw new DOMException("Execution was aborted", "AbortError");
+      }
+      const locations = store.getLocations(query);
+      return {
+        count: locations.length,
+        locations
+      };
+    },
+    annotations: {
+      readOnlyHint: true,
+      untrustedContentHint: false
+    }
+  }, { signal });
+  registeredNames.push("get_locations");
+
+  // Tool 10: get_reward_points
+  await modelContext.registerTool({
+    name: "get_reward_points",
+    description: "Retrieves the user's loyalty account profile, current reward points balance, member tier, and available redemption perks. Use when the user asks about their reward points or perks.",
+    inputSchema: {
+      type: "object",
+      properties: {}
+    },
+    execute(_, { signal: execSignal } = {}) {
+      if (execSignal?.aborted) {
+        throw new DOMException("Execution was aborted", "AbortError");
+      }
+      return store.rewards;
+    },
+    annotations: {
+      readOnlyHint: true,
+      untrustedContentHint: false
+    }
+  }, { signal });
+  registeredNames.push("get_reward_points");
+
+  // Tool 11: dump_app_state (Developer/debugging tool)
+  await modelContext.registerTool({
+    name: "dump_app_state",
+    description: "Returns a snapshot of the internal application store for debugging. Use for developer tooling to inspect cart, store state, and user session.",
+    inputSchema: {
+      type: "object",
+      properties: {}
+    },
+    execute(_, { signal: execSignal } = {}) {
+      if (execSignal?.aborted) {
+        throw new DOMException("Execution was aborted", "AbortError");
+      }
+      return store.getStateSnapshot();
+    },
+    annotations: {
+      readOnlyHint: true,
+      debugging: true // Developer tooling as introduced in Chrome 156+
+    }
+  }, { signal });
+  registeredNames.push("dump_app_state");
+
+  console.info(`[WebMCP] Successfully registered ${registeredNames.length} imperative tools: ${registeredNames.join(", ")}`);
+  return registeredNames;
+}
