@@ -0,0 +1,291 @@
+import { MENU_ITEMS, STORE_LOCATIONS, PROMO_CODES } from "./data.js";
+
+class AppStore {
+  constructor() {
+    this.menu = [...MENU_ITEMS];
+    this.locations = [...STORE_LOCATIONS];
+    this.cart = [];
+    this.appliedPromo = null;
+    this.orders = [];
+    this.rewards = {
+      memberId: "DG-9842",
+      memberName: "Alex Morgan",
+      points: 240,
+      tier: "Gold Bean",
+      availablePerks: [
+        { code: "FREEDRINK", costPoints: 200, name: "Free Handcrafted Beverage ($5 value)" },
+        { code: "WELCOME10", costPoints: 50, name: "10% Off Entire Order" }
+      ]
+    };
+    this.listeners = new Set();
+  }
+
+  subscribe(listener) {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  }
+
+  notify() {
+    for (const listener of this.listeners) {
+      try {
+        listener(this);
+      } catch (err) {
+        console.error("Error in store listener:", err);
+      }
+    }
+  }
+
+  getMenuItems({ category = "all", maxPrice = null, query = "" } = {}) {
+    return this.menu.filter(item => {
+      if (category && category !== "all" && item.category !== category) {
+        return false;
+      }
+      if (typeof maxPrice === "number" && !isNaN(maxPrice) && item.price > maxPrice) {
+        return false;
+      }
+      if (query && query.trim() !== "") {
+        const q = query.trim().toLowerCase();
+        const matchesName = item.name.toLowerCase().includes(q);
+        const matchesDesc = item.description.toLowerCase().includes(q);
+        const matchesCategory = item.category.toLowerCase().includes(q);
+        if (!matchesName && !matchesDesc && !matchesCategory) {
+          return false;
+        }
+      }
+      return true;
+    });
+  }
+
+  getItemById(itemId) {
+    if (!itemId) return null;
+    const cleanId = String(itemId).trim().toLowerCase();
+    return this.menu.find(item => item.id.toLowerCase() === cleanId) || null;
+  }
+
+  getLocations(query = "") {
+    if (!query || query.trim() === "") {
+      return this.locations;
+    }
+    const q = query.trim().toLowerCase();
+    return this.locations.filter(loc =>
+      loc.name.toLowerCase().includes(q) ||
+      loc.address.toLowerCase().includes(q) ||
+      loc.amenities.some(a => a.toLowerCase().includes(q))
+    );
+  }
+
+  addToCart({ itemId, quantity = 1, size = "regular", milk = "whole", notes = "" }) {
+    const item = this.getItemById(itemId);
+    if (!item) {
+      return { error: `Menu item '${itemId}' does not exist.` };
+    }
+
+    const qty = parseInt(quantity, 10);
+    if (isNaN(qty) || qty < 1) {
+      return { error: `Invalid quantity '${quantity}'. Must be an integer >= 1.` };
+    }
+
+    let unitPrice = item.price;
+    if (size === "large") {
+      unitPrice += 0.75;
+    }
+
+    // Check if an identical line item exists
+    const existingIndex = this.cart.findIndex(entry =>
+      entry.itemId === item.id && entry.size === size && entry.milk === milk && entry.notes === notes
+    );
+
+    if (existingIndex >= 0) {
+      this.cart[existingIndex].quantity += qty;
+    } else {
+      this.cart.push({
+        id: `cart-${Date.now()}-${Math.random().toString(36).substr(2, 5)}`,
+        itemId: item.id,
+        name: item.name,
+        unitPrice,
+        size,
+        milk,
+        notes: notes || "",
+        quantity: qty
+      });
+    }
+
+    this.notify();
+    return {
+      success: true,
+      message: `Added ${qty}x ${item.name} (${size}) to cart.`,
+      cart: this.getCartSummary()
+    };
+  }
+
+  removeFromCart(index) {
+    const idx = parseInt(index, 10);
+    if (isNaN(idx) || idx < 0 || idx >= this.cart.length) {
+      return {
+        error: `Invalid cart index '${index}'. Current cart has ${this.cart.length} item(s).`,
+        cartLength: this.cart.length
+      };
+    }
+    const removed = this.cart.splice(idx, 1)[0];
+    this.notify();
+    return {
+      success: true,
+      message: `Removed ${removed.name} from cart.`,
+      cart: this.getCartSummary()
+    };
+  }
+
+  updateQuantity(index, newQty) {
+    const idx = parseInt(index, 10);
+    if (isNaN(idx) || idx < 0 || idx >= this.cart.length) {
+      return { error: `Invalid cart index '${index}'.` };
+    }
+    const qty = parseInt(newQty, 10);
+    if (isNaN(qty) || qty < 1) {
+      return this.removeFromCart(index);
+    }
+    this.cart[idx].quantity = qty;
+    this.notify();
+    return { success: true, cart: this.getCartSummary() };
+  }
+
+  clearCart() {
+    this.cart = [];
+    this.appliedPromo = null;
+    this.notify();
+    return { success: true, message: "Cart has been cleared." };
+  }
+
+  applyPromoCode(code) {
+    if (!code || typeof code !== "string") {
+      return { error: "Please provide a promo code." };
+    }
+    const cleanCode = code.trim().toUpperCase();
+    const promo = PROMO_CODES[cleanCode];
+    if (!promo) {
+      return {
+        error: `Promo code '${code}' is invalid or expired.`,
+        validExamples: Object.keys(PROMO_CODES)
+      };
+    }
+    this.appliedPromo = { code: cleanCode, ...promo };
+    this.notify();
+    return {
+      success: true,
+      message: `Promo code ${cleanCode} applied: ${promo.description}.`,
+      cart: this.getCartSummary()
+    };
+  }
+
+  getCartSummary() {
+    const items = this.cart.map((entry, index) => ({
+      index,
+      id: entry.id,
+      itemId: entry.itemId,
+      name: entry.name,
+      size: entry.size,
+      milk: entry.milk,
+      notes: entry.notes,
+      quantity: entry.quantity,
+      unitPrice: entry.unitPrice,
+      lineTotal: parseFloat((entry.unitPrice * entry.quantity).toFixed(2))
+    }));
+
+    const rawSubtotal = items.reduce((sum, item) => sum + item.lineTotal, 0);
+
+    let discount = 0;
+    if (this.appliedPromo) {
+      if (this.appliedPromo.discountPercent) {
+        discount = rawSubtotal * (this.appliedPromo.discountPercent / 100);
+      } else if (this.appliedPromo.discountFixed) {
+        discount = Math.min(rawSubtotal, this.appliedPromo.discountFixed);
+      }
+    }
+
+    const subtotal = Math.max(0, rawSubtotal - discount);
+    const tax = parseFloat((subtotal * 0.085).toFixed(2));
+    const total = parseFloat((subtotal + tax).toFixed(2));
+
+    return {
+      itemCount: items.reduce((sum, item) => sum + item.quantity, 0),
+      items,
+      rawSubtotal: parseFloat(rawSubtotal.toFixed(2)),
+      discount: parseFloat(discount.toFixed(2)),
+      appliedPromo: this.appliedPromo ? this.appliedPromo.code : null,
+      subtotal: parseFloat(subtotal.toFixed(2)),
+      tax,
+      total
+    };
+  }
+
+  placeOrder({ customerName, locationId, pickupTime = "asap", notes = "" }) {
+    if (!customerName || String(customerName).trim() === "") {
+      return { error: "Missing required parameter 'customerName'." };
+    }
+    if (!locationId || String(locationId).trim() === "") {
+      return {
+        error: "Missing required parameter 'locationId'.",
+        availableLocations: this.locations.map(l => ({ id: l.id, name: l.name }))
+      };
+    }
+
+    const location = this.locations.find(l => l.id === String(locationId).trim().toLowerCase());
+    if (!location) {
+      return {
+        error: `Location '${locationId}' not recognized.`,
+        availableLocations: this.locations.map(l => ({ id: l.id, name: l.name }))
+      };
+    }
+
+    if (this.cart.length === 0) {
+      return { error: "Cannot place order: Shopping cart is empty." };
+    }
+
+    const cartSummary = this.getCartSummary();
+    const orderNumber = `ORD-${Date.now().toString().slice(-6)}`;
+    const newOrder = {
+      orderNumber,
+      customerName: String(customerName).trim(),
+      location: { id: location.id, name: location.name, address: location.address },
+      pickupTime,
+      notes: notes || "",
+      items: [...cartSummary.items],
+      total: cartSummary.total,
+      placedAt: new Date().toISOString(),
+      estimatedReadyMinutes: pickupTime === "asap" ? 12 : pickupTime === "in-15-mins" ? 15 : 30
+    };
+
+    this.orders.unshift(newOrder);
+
+    // Add reward points: 2 points per dollar spent
+    const earnedPoints = Math.round(cartSummary.total * 2);
+    this.rewards.points += earnedPoints;
+
+    // Clear cart after successful order
+    this.cart = [];
+    this.appliedPromo = null;
+
+    this.notify();
+
+    return {
+      success: true,
+      order: newOrder,
+      earnedPoints,
+      newPointsBalance: this.rewards.points,
+      message: `Order ${orderNumber} successfully placed! Estimated pickup in ${newOrder.estimatedReadyMinutes} minutes at ${location.name}.`
+    };
+  }
+
+  getStateSnapshot() {
+    return {
+      cart: this.getCartSummary(),
+      ordersCount: this.orders.length,
+      recentOrders: this.orders.slice(0, 3),
+      rewards: { ...this.rewards },
+      menuItemCount: this.menu.length,
+      locationsCount: this.locations.length
+    };
+  }
+}
+
+export const store = new AppStore();
diff --git a/js/webmcp-polyfill.js b/js/webmcp-polyfill.js
