+test("Declarative Forms: Agent invocation and respondWith handling", async (t) => {
+  setupEnvironment();
+
+  // Test declarative search form submission simulation
+  let respondedData = null;
+  const mockSubmitEvent = {
+    agentInvoked: true,
+    preventDefault() {},
+    respondWith(promise) {
+      respondedData = promise;
+    }
+  };
+
+  // Simulate search menu handler
+  const items = store.getMenuItems({ category: "espresso" });
+  if (mockSubmitEvent.agentInvoked) {
+    mockSubmitEvent.respondWith(Promise.resolve(JSON.stringify({
+      count: items.length,
+      items: items.map(i => ({ id: i.id, name: i.name }))
+    })));
+  }
+
+  assert.ok(respondedData instanceof Promise, "Agent invocation must use respondWith with a Promise");
+  const resultStr = await respondedData;
+  const parsed = JSON.parse(resultStr);
+  assert.ok(parsed.count >= 1);
+  assert.ok(parsed.items.some(i => i.id === "dark-roast-espresso"));
+});
