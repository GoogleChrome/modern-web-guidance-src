+  assert(!orderRes.isError, 'place_order should succeed');
+  assert(orderRes.structuredData.orderId.startsWith('DG-'));
+  console.log(`✓ executeTool('place_order') created order ${orderRes.structuredData.orderId}`);
+
+  // Cart should now be empty after order
+  const emptyCartRes = await mc.executeTool('get_cart');
+  assert(emptyCartRes.structuredData.items.length === 0, 'Cart should be empty after checkout');
