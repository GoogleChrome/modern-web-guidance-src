+  assert(detailRes.structuredData.item.name === 'Maple Oat Latte');
+  console.log(`✓ executeTool('get_item_details') succeeded for ${detailRes.structuredData.item.name}`);
+
+  // Test executeTool: add_to_cart
+  const addRes1 = await mc.executeTool('add_to_cart', {
+    itemId: 'maple-oat-latte',
