+  // Cart operations
+  function addItemToCart(itemId, options = {}) {
+    const item = MENU_ITEMS.find((m) => m.id === itemId || m.name.toLowerCase() === itemId.toLowerCase());
+    if (!item) {
+      throw new Error(`Item "${itemId}" not found in menu.`);
+    }
+
+    const quantity = parseInt(options.quantity || 1, 10);
+    const size = options.size || 'Medium';
+    const milk = options.milk || 'Whole Milk';
+    const syrup = options.syrup || '';
+    const specialInstructions = options.specialInstructions || '';
+
+    // Calculate size adjustment
+    let sizeMultiplier = 1.0;
+    if (size.toLowerCase() === 'small') sizeMultiplier = 0.9;
+    if (size.toLowerCase() === 'large') sizeMultiplier = 1.25;
+
+    let syrupCost = syrup && syrup.toLowerCase() !== 'none' ? 0.5 : 0;
+    let unitPrice = parseFloat((item.price * sizeMultiplier + syrupCost).toFixed(2));
+    let totalPrice = parseFloat((unitPrice * quantity).toFixed(2));
+
+    // Check if duplicate item with same options exists
+    const existingIndex = cart.findIndex(
+      (c) =>
+        c.id === item.id &&
+        c.size === size &&
+        c.milk === milk &&
+        c.syrup === syrup &&
+        c.specialInstructions === specialInstructions
+    );
+
+    if (existingIndex > -1) {
+      cart[existingIndex].quantity += quantity;
+      cart[existingIndex].totalPrice = parseFloat((cart[existingIndex].unitPrice * cart[existingIndex].quantity).toFixed(2));
+    } else {
+      cart.push({
+        id: item.id,
+        name: item.name,
+        category: item.category,
+        quantity,
+        size,
+        milk,
+        syrup,
+        specialInstructions,
+        unitPrice,
+        totalPrice
+      });
+    }
+
+    updateCartUI();
+    showToast(`Added ${quantity}x ${item.name} to cart`);
+    return {
+      message: `Added ${quantity}x ${item.name} (${size}) to cart`,
+      cartSummary: calculateCartTotals(),
+      item: cart.find((c) => c.id === item.id)
+    };
+  }
+
+  function updateCartItem(itemId, quantity) {
+    const index = cart.findIndex((c) => c.id === itemId || c.name.toLowerCase() === itemId.toLowerCase());
+    if (index === -1) {
+      throw new Error(`Item "${itemId}" is not in the cart.`);
+    }
+
+    if (quantity <= 0) {
+      const removed = cart.splice(index, 1)[0];
+      updateCartUI();
+      return { message: `Removed ${removed.name} from cart`, cart: calculateCartTotals() };
+    }
+
+    cart[index].quantity = quantity;
+    cart[index].totalPrice = parseFloat((cart[index].unitPrice * quantity).toFixed(2));
+    updateCartUI();
+    return { message: `Updated ${cart[index].name} quantity to ${quantity}`, cart: calculateCartTotals() };
+  }
+
+  function removeFromCart(itemId) {
+    const initialLength = cart.length;
+    cart = cart.filter((c) => c.id !== itemId && c.name.toLowerCase() !== itemId.toLowerCase());
+    if (cart.length === initialLength) {
+      throw new Error(`Item "${itemId}" not found in cart.`);
+    }
+    updateCartUI();
+    return { message: `Removed item from cart`, cart: calculateCartTotals() };
+  }
+
+  function clearCart() {
+    cart = [];
+    updateCartUI();
+    return { message: 'Cart cleared' };
+  }
+
+  function checkoutOrder(params = {}) {
+    if (cart.length === 0) {
+      throw new Error('Cannot checkout with an empty cart.');
+    }
+
+    const totals = calculateCartTotals();
+    const orderId = 'DG-' + Math.floor(100000 + Math.random() * 900000);
+    const location = LOCATIONS.find((l) => l.id === (params.locationId || selectedLocation)) || LOCATIONS[0];
+    const customerName = params.customerName || USER_ACCOUNT.name;
+    const paymentMethod = params.paymentMethod || 'Daily Grind Rewards Card (•••• 4029)';
+    const pickupEstimateMinutes = 10 + cart.reduce((sum, item) => sum + item.quantity * 2, 0);
+
+    const orderConfirmation = {
+      orderId,
+      status: 'Confirmed',
+      customerName,
+      location: {
+        name: location.name,
+        address: location.address,
+        phone: location.phone
+      },
+      items: [...cart],
+      totals,
+      paymentMethod,
+      estimatedReadyTime: `${pickupEstimateMinutes} minutes`,
+      orderPlacedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
+    };
+
+    // Update UI with Order Confirmation Modal
+    if (orderSuccessDetails) {
+      orderSuccessDetails.innerHTML = `
+        <div class="order-receipt">
+          <div class="receipt-header">
+            <h3>🎉 Order Confirmed!</h3>
+            <p class="order-num">Order #: <strong>${orderConfirmation.orderId}</strong></p>
+            <p>Ready for pickup in ~<strong>${orderConfirmation.estimatedReadyTime}</strong></p>
+          </div>
+          <div class="receipt-body">
+            <p><strong>Pickup Location:</strong> ${orderConfirmation.location.name}</p>
+            <p><strong>Address:</strong> ${orderConfirmation.location.address}</p>
+            <hr/>
+            <div class="receipt-items">
+              ${orderConfirmation.items
+                .map(
+                  (i) => `
+                <div class="receipt-item-line">
+                  <span>${i.quantity}x ${i.name} (${i.size})</span>
+                  <span>${formatMoney(i.totalPrice)}</span>
+                </div>
+              `
+                )
+                .join('')}
+            </div>
+            <hr/>
+            <div class="receipt-totals">
+              <div>Subtotal: <span>${formatMoney(orderConfirmation.totals.subtotal)}</span></div>
+              <div>Tax: <span>${formatMoney(orderConfirmation.totals.tax)}</span></div>
+              <div class="total-line">Total: <span>${formatMoney(orderConfirmation.totals.total)}</span></div>
+            </div>
+          </div>
+        </div>
+      `;
+    }
+
+    if (orderSuccessModal) {
+      orderSuccessModal.classList.add('open');
+    }
+
+    // Award rewards points: 10 points per dollar
+    const earnedPoints = Math.floor(totals.total * 10);
+    USER_ACCOUNT.rewardsPoints += earnedPoints;
+
+    // Reset Cart
+    cart = [];
+    updateCartUI();
+    showToast(`Order ${orderId} placed! Earned ${earnedPoints} reward points.`);
+
+    return orderConfirmation;
+  }
+
+  // 2. Register WebMCP Tools
+  function registerWebMCPTools() {
+    const mc = document.modelContext || window.modelContext;
+    if (!mc || typeof mc.registerTool !== 'function') {
+      console.warn('WebMCP context not detected.');
+      return;
+    }
+
+    // Tool: get_menu
+    mc.registerTool({
+      name: 'get_menu',
+      description: 'Get the full coffee shop menu, optionally filtered by category (Espresso, Cold Brew, Seasonal, Bakery) or search keyword.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          category: {
+            type: 'string',
+            enum: ['All', 'Espresso', 'Cold Brew', 'Seasonal', 'Bakery'],
+            description: 'Filter by drink or food category.'
+          },
+          query: {
+            type: 'string',
+            description: 'Search keyword to filter item titles and descriptions.'
+          }
+        }
+      },
+      execute: async (params) => {
+        let items = MENU_ITEMS;
+        if (params.category && params.category !== 'All') {
+          items = items.filter((i) => i.category.toLowerCase() === params.category.toLowerCase());
+        }
+        if (params.query) {
+          const q = params.query.toLowerCase().trim();
+          items = items.filter(
+            (i) => i.name.toLowerCase().includes(q) || i.description.toLowerCase().includes(q)
+          );
+        }
+
+        // Synchronize UI filter if present
+        if (params.category && categoryFilterEl) {
+          categoryFilterEl.value = params.category;
+          currentFilter = params.category;
+        }
+        if (params.query !== undefined && searchInputEl) {
+          searchInputEl.value = params.query;
+          searchQuery = params.query;
+        }
+        renderMenu();
+
+        return {
+          totalCount: items.length,
+          items: items.map((i) => ({
+            id: i.id,
+            name: i.name,
+            category: i.category,
+            price: i.price,
+            description: i.description,
+            allergens: i.allergens
+          }))
+        };
+      }
+    });
+
+    // Tool: get_item_details
+    mc.registerTool({
+      name: 'get_item_details',
+      description: 'Retrieve detailed nutritional information, ingredients, allergens, and customization choices for a specific menu item.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          itemId: {
+            type: 'string',
+            description: 'The unique ID or name of the menu item (e.g., "maple-oat-latte" or "Maple Oat Latte").'
+          }
+        },
+        required: ['itemId']
+      },
+      execute: async (params) => {
+        const item = MENU_ITEMS.find(
+          (m) => m.id === params.itemId || m.name.toLowerCase() === params.itemId.toLowerCase()
+        );
+        if (!item) {
+          throw new Error(`Menu item "${params.itemId}" not found.`);
+        }
+
+        // Show details modal on screen for the user
+        if (itemDetailModal) {
+          const content = document.getElementById('item-detail-content');
+          if (content) {
+            content.innerHTML = `
+              <img src="${item.image}" alt="${item.name}" class="detail-img" />
+              <h3>${item.name}</h3>
+              <p class="detail-desc">${item.description}</p>
+              <div class="detail-meta">
+                <p><strong>Category:</strong> ${item.category}</p>
+                <p><strong>Base Price:</strong> ${formatMoney(item.price)}</p>
+                <p><strong>Calories:</strong> ${item.calories} kcal</p>
+                <p><strong>Allergens:</strong> ${item.allergens.length ? item.allergens.join(', ') : 'None'}</p>
+              </div>
+            `;
+          }
+          itemDetailModal.classList.add('open');
+        }
+
+        return {
+          item,
+          customizationOptions: {
+            sizes: ['Small', 'Medium', 'Large'],
+            milkOptions: ['Whole Milk', 'Oat Milk', 'Almond Milk', 'Skim Milk'],
+            syrupOptions: ['None', 'Vanilla', 'Caramel', 'Hazelnut', 'Sugar-Free Vanilla']
+          }
+        };
+      }
+    });
+
+    // Tool: add_to_cart
+    mc.registerTool({
+      name: 'add_to_cart',
+      description: 'Add an item from the menu to the shopping cart with customized options such as size, milk choice, syrup flavor, and instructions.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          itemId: {
+            type: 'string',
+            description: 'The ID or name of the item to add (e.g., "maple-oat-latte", "cold-brew", "almond-croissant").'
+          },
+          quantity: {
+            type: 'integer',
+            description: 'Number of items to add (default: 1).'
+          },
+          size: {
+            type: 'string',
+            enum: ['Small', 'Medium', 'Large'],
+            description: 'Drink size (default: Medium).'
+          },
+          milk: {
+            type: 'string',
+            enum: ['Whole Milk', 'Oat Milk', 'Almond Milk', 'Skim Milk'],
+            description: 'Preferred milk choice.'
+          },
+          syrup: {
+            type: 'string',
+            enum: ['None', 'Vanilla', 'Caramel', 'Hazelnut', 'Sugar-Free Vanilla'],
+            description: 'Optional flavored syrup.'
+          },
+          specialInstructions: {
+            type: 'string',
+            description: 'Any barista notes (e.g. "extra hot", "light ice", "no whip").'
+          }
+        },
+        required: ['itemId']
+      },
+      execute: async (params) => {
+        return addItemToCart(params.itemId, params);
+      }
+    });
+
+    // Tool: get_cart
+    mc.registerTool({
+      name: 'get_cart',
+      description: 'View the items currently in the cart, itemized subtotals, tax, and order total.',
+      inputSchema: {
+        type: 'object',
+        properties: {}
+      },
+      execute: async () => {
+        return {
+          items: cart,
+          totals: calculateCartTotals()
+        };
+      }
+    });
+
+    // Tool: update_cart_item
+    mc.registerTool({
