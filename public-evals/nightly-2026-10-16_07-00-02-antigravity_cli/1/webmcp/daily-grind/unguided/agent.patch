index 0000000..8d324c0
--- /dev/null
+++ b/webmcp-polyfill.js
@@ -0,0 +1,365 @@
+/**
+ * WebMCP Polyfill & Standard Implementation
+ * Conforming to W3C WebMCP (Web Model Context Protocol) draft specification
+ * & Google Chrome Labs WebMCP reference implementation.
+ *
+ * Exposes:
+ *  - document.modelContext
+ *  - navigator.modelContext
+ *  - window.modelContext
+ *
+ * Implements:
+ *  - registerTool(tool, options)
+ *  - unregisterTool(name)
+ *  - getTools(options)
+ *  - executeTool(nameOrTool, inputObject, options)
+ *  - EventTarget events: 'toolchange', 'toolactivated', 'toolcancel'
+ *  - Window postMessage protocol ('WEBMCP_GET_TOOLS_REQUEST', 'WEBMCP_EXECUTE_TOOL_REQUEST')
+ *  - Declarative HTML Form tools (<form toolname="..." tooldescription="...">)
+ */
+
+(function (global) {
+  'use strict';
+
+  class ModelContext extends EventTarget {
+    constructor() {
+      super();
+      this._tools = new Map();
+      this._setupPostMessageListener();
+      this._setupDeclarativeForms();
+    }
+
+    /**
+     * Register an imperative tool with document.modelContext
+     * @param {Object} tool - Tool definition:
+     *   {
+     *     name: string,
+     *     description: string,
+     *     inputSchema?: object,  // or parameters / parametersSchema
+     *     parameters?: object,
+     *     execute: Function,     // (params) => Promise<any> | any
+     *     metadata?: object
+     *   }
+     * @param {Object} options
+     */
+    registerTool(tool, options = {}) {
+      if (!tool || typeof tool !== 'object') {
+        throw new TypeError('Tool definition must be an object');
+      }
+      if (!tool.name || typeof tool.name !== 'string') {
+        throw new TypeError('Tool must have a valid name');
+      }
+      if (typeof tool.execute !== 'function' && typeof tool.handler !== 'function') {
+        throw new TypeError(`Tool "${tool.name}" must have an execute function`);
+      }
+
+      const toolEntry = {
+        name: tool.name,
+        description: tool.description || '',
+        inputSchema: tool.inputSchema || tool.parameters || tool.parametersSchema || {
+          type: 'object',
+          properties: {}
+        },
+        execute: tool.execute || tool.handler,
+        metadata: tool.metadata || {},
+        source: options.source || 'imperative'
+      };
+
+      this._tools.set(tool.name, toolEntry);
+
+      this.dispatchEvent(
+        new CustomEvent('toolchange', {
+          detail: {
+            action: 'registered',
+            tool: this._sanitizeToolForExport(toolEntry)
+          }
+        })
+      );
+
+      return toolEntry;
+    }
+
+    /**
+     * Unregister a tool
+     * @param {string} name
+     */
+    unregisterTool(name) {
+      if (this._tools.has(name)) {
+        const removed = this._tools.get(name);
+        this._tools.delete(name);
+        this.dispatchEvent(
+          new CustomEvent('toolchange', {
+            detail: {
+              action: 'unregistered',
+              toolName: name
+            }
+          })
+        );
+        return true;
+      }
+      return false;
+    }
+
+    /**
+     * Get list of registered tools
+     * @param {Object} options
+     * @returns {Promise<Array<Object>>}
+     */
+    async getTools(options = {}) {
+      // Refresh declarative form tools if DOM is available
+      this._scanDeclarativeForms();
+
+      const list = [];
+      for (const entry of this._tools.values()) {
+        list.push(this._sanitizeToolForExport(entry));
+      }
+      return list;
+    }
+
+    /**
+     * Execute a tool by name or tool object
+     * @param {string|Object} toolOrName
+     * @param {Object} inputObject
+     * @param {Object} options
+     * @returns {Promise<any>}
+     */
+    async executeTool(toolOrName, inputObject = {}, options = {}) {
+      const name = typeof toolOrName === 'string' ? toolOrName : toolOrName?.name;
+      if (!name) {
+        throw new Error('Missing tool name for execution');
+      }
+
+      let tool = this._tools.get(name);
+      if (!tool) {
+        // Try declarative scan in case form was dynamically rendered
+        this._scanDeclarativeForms();
+        tool = this._tools.get(name);
+      }
+
+      if (!tool) {
+        throw new Error(`Tool not found: "${name}"`);
+      }
+
+      this.dispatchEvent(
+        new CustomEvent('toolactivated', {
+          detail: { toolName: name, input: inputObject }
+        })
+      );
+
+      try {
+        const result = await tool.execute(inputObject || {});
+        return {
+          content: [
+            {
+              type: 'text',
+              text: typeof result === 'string' ? result : JSON.stringify(result, null, 2)
+            }
+          ],
+          structuredData: result,
+          isError: false
+        };
+      } catch (err) {
+        this.dispatchEvent(
+          new CustomEvent('toolcancel', {
+            detail: { toolName: name, error: err.message }
+          })
+        );
+        return {
+          content: [
+            {
+              type: 'text',
+              text: `Error executing tool "${name}": ${err.message}`
+            }
+          ],
