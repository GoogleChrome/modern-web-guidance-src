+import assert from 'node:assert';
+import fs from 'node:fs';
+import path from 'node:path';
+import vm from 'node:vm';
+
+console.log('--- Testing WebMCP Implementation ---');
+
+// Mock a lightweight browser DOM environment for Node.js
+class EventTargetPolyfill {
+  constructor() {
+    this._listeners = {};
+  }
+  addEventListener(type, cb) {
+    this._listeners[type] = this._listeners[type] || [];
+    this._listeners[type].push(cb);
+  }
+  removeEventListener(type, cb) {
+    if (!this._listeners[type]) return;
+    this._listeners[type] = this._listeners[type].filter(f => f !== cb);
+  }
+  dispatchEvent(evt) {
+    const list = this._listeners[evt.type] || [];
+    for (const cb of list) {
+      cb(evt);
+    }
+    return true;
+  }
+}
+
+class CustomEventMock {
+  constructor(type, init = {}) {
+    this.type = type;
+    this.detail = init.detail;
+  }
+}
+
+const mockDocument = {
+  readyState: 'complete',
+  addEventListener: () => {},
+  querySelectorAll: () => [],
+  getElementById: (id) => ({
+    id,
+    classList: { add: () => {}, remove: () => {} },
+    innerHTML: '',
+    textContent: '',
+    style: {},
+    addEventListener: () => {}
+  }),
+  body: {
+    appendChild: () => {}
+  }
+};
+
+const mockWindow = {
+  document: mockDocument,
+  navigator: {},
+  addEventListener: () => {},
+  postMessage: () => {}
+};
+
+// Create VM context
+const sandbox = {
+  EventTarget: EventTargetPolyfill,
+  CustomEvent: CustomEventMock,
+  document: mockDocument,
+  window: mockWindow,
+  navigator: mockWindow.navigator,
+  console: console,
+  setTimeout: setTimeout,
+  clearTimeout: clearTimeout,
+  module: { exports: {} }
+};
+sandbox.globalThis = sandbox;
+
+vm.createContext(sandbox);
+
+// 1. Load WebMCP Polyfill
+const polyfillCode = fs.readFileSync(path.resolve('./webmcp-polyfill.js'), 'utf-8');
+vm.runInContext(polyfillCode, sandbox);
+
+assert(sandbox.document.modelContext, 'document.modelContext must be initialized');
+assert(sandbox.navigator.modelContext, 'navigator.modelContext must be aliased');
+assert(typeof sandbox.document.modelContext.registerTool === 'function', 'registerTool must be a function');
+assert(typeof sandbox.document.modelContext.getTools === 'function', 'getTools must be a function');
+assert(typeof sandbox.document.modelContext.executeTool === 'function', 'executeTool must be a function');
+
+console.log('✓ WebMCP Polyfill successfully loaded and initialized');
+
+// 2. Load App Code
+const appCode = fs.readFileSync(path.resolve('./app.js'), 'utf-8');
+vm.runInContext(appCode, sandbox);
+
+const mc = sandbox.document.modelContext;
+
+async function runTests() {
+  // Test getTools
+  const tools = await mc.getTools();
+  console.log(`✓ Registered tools count: ${tools.length}`);
+  const toolNames = tools.map(t => t.name);
+  console.log('  Tools:', toolNames);
+
+  assert(toolNames.includes('get_menu'), 'get_menu tool must be registered');
+  assert(toolNames.includes('get_item_details'), 'get_item_details tool must be registered');
+  assert(toolNames.includes('add_to_cart'), 'add_to_cart tool must be registered');
+  assert(toolNames.includes('get_cart'), 'get_cart tool must be registered');
+  assert(toolNames.includes('update_cart_item'), 'update_cart_item tool must be registered');
+  assert(toolNames.includes('remove_from_cart'), 'remove_from_cart tool must be registered');
+  assert(toolNames.includes('place_order'), 'place_order tool must be registered');
+  assert(toolNames.includes('get_locations'), 'get_locations tool must be registered');
+  assert(toolNames.includes('get_rewards_balance'), 'get_rewards_balance tool must be registered');
+
+  // Test executeTool: get_menu
+  const menuRes = await mc.executeTool('get_menu', { category: 'Seasonal' });
+  assert(!menuRes.isError, 'get_menu should not error');
+  assert(menuRes.structuredData.totalCount > 0, 'Seasonal items should be found');
+  console.log(`✓ executeTool('get_menu') returned ${menuRes.structuredData.totalCount} items`);
+
+  // Test executeTool: get_item_details
+  const detailRes = await mc.executeTool('get_item_details', { itemId: 'maple-oat-latte' });
