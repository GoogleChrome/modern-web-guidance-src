+
+  const addRes2 = await mc.executeTool('add_to_cart', {
+    itemId: 'almond-croissant',
+    quantity: 1
+  });
+  assert(!addRes2.isError, 'add_to_cart should succeed for croissant');
+
+  // Test executeTool: get_cart
+  const cartRes = await mc.executeTool('get_cart');
+  assert(!cartRes.isError, 'get_cart should succeed');
+  assert(cartRes.structuredData.items.length === 2, 'Cart should have 2 distinct items');
+  console.log(`✓ executeTool('get_cart') returned total: $${cartRes.structuredData.totals.total}`);
+
+  // Test executeTool: update_cart_item
+  const updateRes = await mc.executeTool('update_cart_item', {
+    itemId: 'almond-croissant',
+    quantity: 3
+  });
+  assert(!updateRes.isError, 'update_cart_item should succeed');
+  console.log(`✓ executeTool('update_cart_item') updated croissant quantity`);
+
+  // Test executeTool: get_locations
+  const locRes = await mc.executeTool('get_locations');
+  assert(!locRes.isError, 'get_locations should succeed');
+  assert(locRes.structuredData.locations.length >= 3, 'Should return locations');
+  console.log(`✓ executeTool('get_locations') returned ${locRes.structuredData.locations.length} stores`);
+
+  // Test executeTool: get_rewards_balance
+  const rewardsRes = await mc.executeTool('get_rewards_balance');
+  assert(!rewardsRes.isError, 'get_rewards_balance should succeed');
+  assert(rewardsRes.structuredData.rewardsPoints >= 300);
+  console.log(`✓ executeTool('get_rewards_balance') returned ${rewardsRes.structuredData.rewardsPoints} points`);
+
+  // Test executeTool: place_order
+  const orderRes = await mc.executeTool('place_order', {
+    customerName: 'Alex Rivera',
+    locationId: 'downtown'
