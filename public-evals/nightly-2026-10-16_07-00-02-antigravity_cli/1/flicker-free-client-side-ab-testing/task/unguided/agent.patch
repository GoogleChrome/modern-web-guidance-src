+  <!--
+    Anti-Flicker / Anti-Flash Snippet
+    Prevents Flash of Original Content (FOOC) by pre-hiding the page before the
+    A/B testing script downloads and mutates the DOM.
+  -->
+  <style id="anti-flicker-css">
+    .async-hide,
+    .optimizely-loading,
+    .experiment-loading {
+      opacity: 0 !important;
+    }
+  </style>
+  <script>
+    (function(win, doc, hideClasses, timeoutMs) {
+      var docEl = doc.documentElement;
+      for (var i = 0; i < hideClasses.length; i++) {
+        docEl.classList.add(hideClasses[i]);
+      }
+
+      var revealed = false;
+      function reveal() {
+        if (revealed) return;
+        revealed = true;
+        for (var i = 0; i < hideClasses.length; i++) {
+          docEl.classList.remove(hideClasses[i]);
+        }
+        var styleEl = doc.getElementById('anti-flicker-css');
+        if (styleEl && styleEl.parentNode) {
+          styleEl.parentNode.removeChild(styleEl);
+        }
+      }
+
+      // Public API hooks for experiment SDKs and testing suites
+      win.__revealPage = reveal;
+      win.removeAntiFlicker = reveal;
+      win.revealExperiment = reveal;
+
+      // Google Optimize / standard dataLayer.hide compatibility
+      win.dataLayer = win.dataLayer || [];
+      win.dataLayer.hide = {
+        start: 1 * new Date(),
+        end: reveal,
+        timeout: timeoutMs
+      };
+
+      // Failsafe timeout to prevent permanent blank page if CDN script fails or is blocked
+      win.__antiFlickerTimer = setTimeout(reveal, timeoutMs);
+    })(window, document, ['async-hide', 'optimizely-loading', 'experiment-loading'], 2000);
+  </script>
+
+  <!--
+    A/B Testing Script from CDN
+    Executes and applies variants before revealing the DOM.
+    Uses onload / onerror hooks alongside standard SDK hooks to guarantee flicker-free reveal.
+  -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    onload="window.__revealPage && window.__revealPage()"
+    onerror="window.__revealPage && window.__revealPage()">
+  </script>
