+/**
+ * Utilities for SMS OTP generation, validation, and origin-bound SMS formatting.
+ */
+
+export interface OtpRecord {
+  code: string;
+  expiresAt: number;
+}
+
+// In-memory store for OTPs (keyed by normalized phone number)
+const otpStore = new Map<string, OtpRecord>();
+
+/**
+ * Normalizes a phone number by stripping whitespace and non-numeric characters except leading '+'.
+ */
+export function normalizePhoneNumber(phone: string): string {
+  if (!phone) return '';
+  const trimmed = phone.trim();
+  const hasPlus = trimmed.startsWith('+');
+  const digits = trimmed.replace(/\D/g, '');
+  return hasPlus ? `+${digits}` : digits;
+}
+
+/**
+ * Validates whether the given string resembles a plausible phone number (7 to 15 digits).
+ */
+export function isValidPhoneNumber(phone: string): boolean {
+  const normalized = normalizePhoneNumber(phone);
+  const digitsOnly = normalized.replace(/\D/g, '');
+  return digitsOnly.length >= 7 && digitsOnly.length <= 15;
+}
+
+/**
+ * Generates a random N-digit numeric OTP code.
+ */
+export function generateOtp(length = 6): string {
+  // Use crypto if available, fallback to Math.random
+  if (typeof crypto !== 'undefined' && crypto.getRandomValues) {
+    const array = new Uint32Array(1);
+    crypto.getRandomValues(array);
+    const num = array[0] % Math.pow(10, length);
+    return num.toString().padStart(length, '0');
+  }
+  const min = Math.pow(10, length - 1);
+  const max = Math.pow(10, length) - 1;
+  return Math.floor(min + Math.random() * (max - min + 1)).toString();
+}
+
+/**
+ * Extracts the host domain name according to the origin-bound SMS specification.
+ * - Strips protocol (https:// or http://)
+ * - Strips port (:8080)
+ * - Strips path and query string
+ * - Returns lowercase domain or hostname (e.g. "example.com" or "localhost")
+ */
+export function extractHostDomain(hostOrUrl: string): string {
+  if (!hostOrUrl) return 'localhost';
+  let cleaned = hostOrUrl.trim();
+  // Remove protocol
+  cleaned = cleaned.replace(/^https?:\/\//i, '');
+  // Remove path and query
+  cleaned = cleaned.split('/')[0].split('?')[0];
+  // Remove port
+  cleaned = cleaned.split(':')[0];
+  return cleaned.toLowerCase() || 'localhost';
+}
+
+/**
+ * Formats an origin-bound SMS message adhering strictly to the WebOTP specification:
+ * 1. Human-readable text first containing the OTP.
+ * 2. Blank line.
+ * 3. The very last line begins with '@<domain> #<otp>'.
+ * 4. Only the host domain (no protocol, port, or path).
+ * 5. Exactly one space separating '@<domain>' and '#<otp>'.
+ * 6. No trailing lines or signature text after it.
+ */
+export function formatOtpSms(code: string, hostOrUrl: string): string {
+  const domain = extractHostDomain(hostOrUrl);
+  return `Your verification code is ${code}.\n\n@${domain} #${code}`;
+}
+
+/**
+ * Stores an OTP in memory with a time-to-live (default: 10 minutes).
+ */
+export function storeOtp(phone: string, code: string, ttlMs = 10 * 60 * 1000): void {
+  const normalized = normalizePhoneNumber(phone);
+  otpStore.set(normalized, {
+    code,
+    expiresAt: Date.now() + ttlMs,
+  });
+}
+
+/**
+ * Verifies an OTP for a given phone number.
+ * If valid, the OTP is consumed (removed from the store) and returns true.
+ * If expired or mismatched, returns false.
+ */
+export function verifyOtp(phone: string, code: string): boolean {
+  const normalized = normalizePhoneNumber(phone);
+  const record = otpStore.get(normalized);
+  if (!record) return false;
+
+  if (Date.now() > record.expiresAt) {
+    otpStore.delete(normalized);
+    return false;
+  }
+
+  if (record.code === code.trim()) {
+    otpStore.delete(normalized);
+    return true;
+  }
+
+  return false;
+}
+
+/**
+ * Retrieves the currently active OTP for a phone number (without consuming it).
+ * Useful for debugging, test simulations, or resend checks.
+ */
+export function getActiveOtp(phone: string): string | null {
+  const normalized = normalizePhoneNumber(phone);
+  const record = otpStore.get(normalized);
+  if (!record) return null;
+  if (Date.now() > record.expiresAt) {
+    otpStore.delete(normalized);
+    return null;
+  }
+  return record.code;
+}
