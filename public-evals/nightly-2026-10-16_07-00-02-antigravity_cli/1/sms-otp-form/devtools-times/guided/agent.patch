--- /dev/null
+++ b/src/pages/api/send-otp.ts
@@ -0,0 +1,90 @@
+import type { APIRoute } from 'astro';
+import {
+  generateOtp,
+  normalizePhoneNumber,
+  isValidPhoneNumber,
+  formatOtpSms,
+  storeOtp,
+} from '../../utils/otp';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  try {
+    let phone = '';
+    const contentType = request.headers.get('content-type') || '';
+
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      phone = body.phone || '';
+    } else if (
+      contentType.includes('application/x-www-form-urlencoded') ||
+      contentType.includes('multipart/form-data')
+    ) {
+      const formData = await request.formData();
+      phone = (formData.get('phone') as string) || '';
+    } else {
+      // Fallback: try parsing JSON
+      try {
+        const body = await request.json();
+        phone = body.phone || '';
+      } catch {
+        // Ignored
+      }
+    }
+
+    const normalizedPhone = normalizePhoneNumber(phone);
+    if (!normalizedPhone || !isValidPhoneNumber(normalizedPhone)) {
+      return new Response(
+        JSON.stringify({
+          error: 'Please enter a valid phone number with 7 to 15 digits.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const code = generateOtp(6);
+    storeOtp(normalizedPhone, code);
+
+    if (session) {
+      await session.set('pendingOtpPhone', normalizedPhone);
+      await session.set('pendingOtpCode', code);
+    }
+
+    // Determine origin host for origin-bound SMS formatting
+    const hostHeader =
+      request.headers.get('x-forwarded-host') ||
+      request.headers.get('host') ||
+      url.host ||
+      'localhost';
+
+    const simulatedSms = formatOtpSms(code, hostHeader);
+
+    // In a production app, this would dispatch through an SMS gateway (e.g., Twilio, AWS SNS).
+    // In this application, we return the formatted origin-bound SMS so the UI can simulate receipt.
+    return new Response(
+      JSON.stringify({
+        success: true,
+        message: 'Verification code sent successfully.',
+        phone: normalizedPhone,
+        simulatedSms,
+        code,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({
+        error: 'Failed to process request: ' + (err?.message || 'Unknown error'),
+      }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
