@@ -0,0 +1,98 @@
+import type { APIRoute } from 'astro';
+import {
+  normalizePhoneNumber,
+  verifyOtp,
+} from '../../utils/otp';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    let phone = '';
+    let otp = '';
+    const contentType = request.headers.get('content-type') || '';
+
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      phone = body.phone || '';
+      otp = body.otp || '';
+    } else if (
+      contentType.includes('application/x-www-form-urlencoded') ||
+      contentType.includes('multipart/form-data')
+    ) {
+      const formData = await request.formData();
+      phone = (formData.get('phone') as string) || '';
+      otp = (formData.get('otp') as string) || '';
+    } else {
+      try {
+        const body = await request.json();
+        phone = body.phone || '';
+        otp = body.otp || '';
+      } catch {
+        // Ignored
+      }
+    }
+
+    const normalizedPhone = normalizePhoneNumber(phone);
+    if (!normalizedPhone || !otp) {
+      return new Response(
+        JSON.stringify({
+          error: 'Phone number and verification code are required.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    // Check in-memory store first
+    let isValid = verifyOtp(normalizedPhone, otp);
+
+    // If not valid yet, check session
+    if (!isValid && session) {
+      const sessionPhone = await session.get('pendingOtpPhone');
+      const sessionCode = await session.get('pendingOtpCode');
+      if (sessionPhone === normalizedPhone && sessionCode === otp.trim()) {
+        isValid = true;
+        await session.set('pendingOtpCode', null);
+      }
+    }
+
+    if (!isValid) {
+      return new Response(
+        JSON.stringify({
+          error: 'Invalid or expired verification code. Please request a new code.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    if (session) {
+      await session.set('verifiedPhone', normalizedPhone);
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        message: 'Phone number verified successfully.',
+        phone: normalizedPhone,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({
+        error: 'Verification failed: ' + (err?.message || 'Unknown error'),
+      }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
