+import type { APIRoute } from 'astro';
+import { otpStore } from '../../utils/otpStore';
+
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const phone = typeof body?.phone === 'string' ? body.phone.trim() : '';
+
+    if (!phone) {
+      return new Response(
+        JSON.stringify({
+          success: false,
+          error: 'Phone number is required.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    // Basic phone validation: at least 7 digits
+    const digitsOnly = phone.replace(/\D/g, '');
+    if (digitsOnly.length < 7 || digitsOnly.length > 15) {
+      return new Response(
+        JSON.stringify({
+          success: false,
+          error: 'Please enter a valid phone number with 7 to 15 digits.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    // Generate a 6-digit numeric OTP code
+    const code = Math.floor(100000 + Math.random() * 900000).toString();
+
+    // Store with 5-minute expiration (300,000 ms)
+    const normalizedPhone = phone.replace(/\s+/g, '');
+    otpStore.set(normalizedPhone, {
+      code,
+      expiresAt: Date.now() + 5 * 60 * 1000,
+      attempts: 0,
+    });
+
+    // Format domain-bound SMS message for WebOTP API
+    const hostHeader = request.headers.get('host') || 'localhost';
+    const domain = hostHeader.split(':')[0];
+    const smsMessage = `Your DevTools Times verification code is ${code}.\n\n@${domain} #${code}`;
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        message: 'Verification code sent successfully via SMS.',
+        phone: normalizedPhone,
+        code, // Returned for dev/demo display and testing
+        smsMessage,
+        expiresInSeconds: 300,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({
+        success: false,
+        error: 'Failed to process request: ' + (err?.message || 'Unknown error'),
+      }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
