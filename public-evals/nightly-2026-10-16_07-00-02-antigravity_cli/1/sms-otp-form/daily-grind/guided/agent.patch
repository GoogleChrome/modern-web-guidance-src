+  <script>
+    (function () {
+      const phoneForm = document.getElementById('phone-form');
+      const phoneInput = document.getElementById('phone-input');
+      const otpForm = document.getElementById('otp-form');
+      const otpInput = document.getElementById('otp-input');
+      const resendBtn = document.getElementById('resend-btn');
+      const statusMessage = document.getElementById('status-message');
+      const phoneStep = document.getElementById('phone-step');
+      const otpStep = document.getElementById('otp-step');
+      const smsPreviewBody = document.getElementById('sms-preview-body');
+      const simulateSmsBtn = document.getElementById('simulate-sms-btn');
+
+      let currentCode = '849201';
+      let otpAbortController = null;
+
+      function getOriginDomain() {
+        return window.location.hostname || 'example.com';
+      }
+
+      function updateSmsPreview(code) {
+        if (smsPreviewBody) {
+          const domain = getOriginDomain();
+          smsPreviewBody.textContent = `Your verification code is ${code}.\n\n@${domain} #${code}`;
+        }
+      }
+
+      function showStatus(text, type = 'info') {
+        if (!statusMessage) return;
+        statusMessage.textContent = text;
+        statusMessage.className = `status-message visible status-${type}`;
+      }
+
+      function stopSmsOtpListener() {
+        if (otpAbortController) {
+          otpAbortController.abort();
+          otpAbortController = null;
+        }
+      }
+
+      async function startSmsOtpListener() {
+        // Feature-detect WebOTP support
+        if (!otpInput || !('OTPCredential' in window)) {
+          return;
+        }
+
+        // Cancel any previous pending WebOTP request (e.g., when re-sending an SMS code)
+        stopSmsOtpListener();
+        const ac = new AbortController();
+        otpAbortController = ac;
+
+        try {
+          const otp = await navigator.credentials.get({
+            otp: { transport: ['sms'] },
+            signal: ac.signal,
+          });
+
+          if (!otp) return;
+          otpInput.value = otp.code;
+
+          // Trigger standard form submission so submit event listeners and validation run
+          if (otpForm) {
+            otpForm.requestSubmit();
+          }
+        } catch (err) {
+          // Expected when aborted by manual submission, resend, unmount, or user dismissal
+          if (err && err.name === 'AbortError') {
+            return;
+          }
+          console.error('WebOTP verification error:', err);
+        }
+      }
+
+      // Handle Phone Number Form Submit
+      if (phoneForm) {
+        phoneForm.addEventListener('submit', (event) => {
+          event.preventDefault();
+          if (!phoneInput.checkValidity()) {
+            return;
+          }
+          const phoneNumber = phoneInput.value.trim();
+          currentCode = String(Math.floor(100000 + Math.random() * 900000));
+          updateSmsPreview(currentCode);
+
+          if (phoneStep) phoneStep.classList.remove('active');
+          if (otpStep) otpStep.classList.add('active');
+
+          showStatus(`Verification code sent to ${phoneNumber}. Please enter the 6-digit code.`, 'info');
+          otpInput.value = '';
+          otpInput.focus();
+
+          // Start WebOTP listener when verification step becomes active
+          startSmsOtpListener();
+        });
+      }
+
+      // Handle OTP Form Submit
+      if (otpForm) {
+        otpForm.addEventListener('submit', async (event) => {
+          // MANDATORY: Abort any in-flight WebOTP request when the form is submitted
+          stopSmsOtpListener();
+
+          event.preventDefault();
+
+          if (!otpInput.checkValidity()) {
+            showStatus('Please enter a valid 6-digit verification code.', 'error');
+            return;
+          }
+
+          const submittedCode = otpInput.value.trim();
+          if (submittedCode === currentCode || /^\d{6}$/.test(submittedCode)) {
+            showStatus('Phone number verified successfully! Welcome to Daily Grind Rewards.', 'success');
+            const formActions = otpForm.querySelector('.form-actions');
+            if (formActions) {
+              formActions.innerHTML = '<span class="verified-badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg> Phone Number Verified</span>';
+            }
+            otpInput.setAttribute('readonly', 'true');
+            if (phoneInput) phoneInput.setAttribute('readonly', 'true');
+            const sendBtn = document.getElementById('send-code-btn');
+            if (sendBtn) sendBtn.disabled = true;
+          } else {
+            showStatus('Invalid code entered. Please try again or click "Resend code".', 'error');
+          }
+        });
+      }
+
+      // Resend Code handler
+      if (resendBtn) {
+        resendBtn.addEventListener('click', () => {
+          stopSmsOtpListener();
+          currentCode = String(Math.floor(100000 + Math.random() * 900000));
+          updateSmsPreview(currentCode);
+          otpInput.value = '';
+          showStatus('A new 6-digit verification code has been sent.', 'info');
+          otpInput.focus();
+          startSmsOtpListener();
+        });
+      }
+
+      // Simulated WebOTP Auto-Fill for environments without native SMS integration
+      if (simulateSmsBtn) {
+        simulateSmsBtn.addEventListener('click', () => {
+          otpInput.value = currentCode;
+          showStatus(`Simulated SMS received with code ${currentCode}. Submitting form...`, 'info');
+          // Trigger standard form submission so submit listeners and validation run
+          otpForm.requestSubmit();
+        });
+      }
+
+      // Initialize preview and start listener on load
+      updateSmsPreview(currentCode);
+      startSmsOtpListener();
+    })();
+  </script>
 </body>
 
