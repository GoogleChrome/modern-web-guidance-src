+      const countryCodeSelect = document.getElementById('country-code');
+      const phoneInput = document.getElementById('phone');
+      const sendCodeBtn = document.getElementById('send-code-btn');
+      const phoneError = document.getElementById('phone-error');
+      const phoneSentBadge = document.getElementById('phone-sent-badge');
+      const sentPhoneDisplay = document.getElementById('sent-phone-display');
+      const changePhoneBtn = document.getElementById('change-phone-btn');
+
+      const otpInput = document.getElementById('otp');
+      const verifyBtn = document.getElementById('verify-btn');
+      const resendBtn = document.getElementById('resend-btn');
+      const resendTimer = document.getElementById('resend-timer');
+      const otpError = document.getElementById('otp-error');
+      const otpStatus = document.getElementById('otp-status');
+      const srAnnouncements = document.getElementById('sr-announcements');
+
+      const stepPhoneFieldset = document.getElementById('step-phone-fieldset');
+      const stepOtpFieldset = document.getElementById('step-otp-fieldset');
+      const verificationSuccess = document.getElementById('verification-success');
+      const successPhoneMsg = document.getElementById('success-phone-msg');
+      const resetVerificationBtn = document.getElementById('reset-verification-btn');
+
+      const simulatedCodeText = document.getElementById('simulated-code-text');
+      const originBindingText = document.getElementById('origin-binding-text');
+      const autoExtractBtn = document.getElementById('auto-extract-btn');
+      const copyCodeBtn = document.getElementById('copy-code-btn');
+
+      // State
+      let currentCode = '123456';
+      let resendCountdown = 30;
+      let resendInterval = null;
+      let abortController = null;
+
+      // Update Screen Reader Announcement
+      function announceSR(message) {
+        if (!srAnnouncements) return;
+        srAnnouncements.textContent = '';
+        setTimeout(() => {
+          srAnnouncements.textContent = message;
+        }, 50);
+      }
+
+      // Update Status Feedback (Visible and Screen Reader)
+      function updateStatus(message) {
+        if (otpStatus) {
+          otpStatus.textContent = message;
+        }
+        announceSR(message);
+      }
+
+      // Origin-bound SMS text updater
+      function updateSimulatedSms(code) {
+        currentCode = code;
+        const origin = window.location.hostname || 'localhost';
+        if (simulatedCodeText) {
+          simulatedCodeText.textContent = code;
+        }
+        if (originBindingText) {
+          originBindingText.textContent = `@${origin} #${code}`;
+        }
+      }
+
+      // WebOTP API Integration
+      function initWebOTP() {
+        if (!('OTPCredential' in window) || !navigator.credentials || !navigator.credentials.get) {
+          return;
+        }
+
+        if (abortController) {
+          try {
+            abortController.abort();
+          } catch (e) { }
+        }
+
+        abortController = new AbortController();
+
+        navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: abortController.signal
+        }).then(credential => {
+          if (credential && credential.code) {
+            handleExtractedCode(credential.code, 'WebOTP API');
+          }
+        }).catch(err => {
+          // Expected on manual abort or timeout
+          console.debug('WebOTP event or cancelled:', err);
+        });
+      }
+
+      // Handle Extracted Code (from WebOTP, simulator, paste, or autocomplete)
+      function handleExtractedCode(code, source = 'WebOTP') {
+        if (!code) return;
+        const cleanCode = String(code).trim();
+        otpInput.value = cleanCode;
+        otpInput.removeAttribute('aria-invalid');
+        otpError.textContent = '';
+        otpInput.classList.add('code-extracted');
+
+        updateStatus(`Code ${cleanCode} automatically extracted via ${source}. Verifying...`);
+
+        // Dispatch input and change events for any observers
+        otpInput.dispatchEvent(new Event('input', { bubbles: true }));
+        otpInput.dispatchEvent(new Event('change', { bubbles: true }));
+
+        // Abort active WebOTP listener
+        if (abortController) {
+          try {
+            abortController.abort();
+          } catch (e) { }
+        }
+
+        // Complete verification
+        setTimeout(() => {
+          verifyCode();
+        }, 300);
+      }
+
+      // Start Resend Countdown Timer
+      function startResendTimer() {
+        clearInterval(resendInterval);
+        resendCountdown = 30;
+        resendBtn.disabled = true;
+        resendBtn.setAttribute('aria-disabled', 'true');
+        resendTimer.textContent = resendCountdown;
+        resendBtn.innerHTML = `Resend Code (<span id="resend-timer">${resendCountdown}</span>s)`;
+
+        resendInterval = setInterval(() => {
+          resendCountdown--;
+          const timerEl = document.getElementById('resend-timer');
+          if (timerEl) {
+            timerEl.textContent = resendCountdown;
+          }
+
+          if (resendCountdown <= 0) {
+            clearInterval(resendInterval);
+            resendBtn.disabled = false;
+            resendBtn.removeAttribute('aria-disabled');
+            resendBtn.textContent = 'Resend Verification Code';
+            announceSR('You can now request a new verification code.');
+          }
+        }, 1000);
+      }
+
+      // Send Verification Code Flow
+      function sendCode() {
+        const rawPhone = phoneInput.value.trim();
+        const digitsOnly = rawPhone.replace(/\D/g, '');
+
+        if (!digitsOnly || digitsOnly.length < 7) {
+          phoneInput.setAttribute('aria-invalid', 'true');
+          phoneError.textContent = 'Please enter a valid phone number (at least 7 digits).';
+          announceSR('Error: Please enter a valid phone number.');
+          phoneInput.focus();
+          return false;
+        }
+
+        phoneInput.removeAttribute('aria-invalid');
+        phoneError.textContent = '';
+
+        const countryCode = countryCodeSelect.value;
+        const formattedDisplay = `${countryCode} ${rawPhone}`;
+        sentPhoneDisplay.textContent = formattedDisplay;
+        phoneSentBadge.style.display = 'flex';
+
+        // Generate a new 6-digit passcode
+        const newCode = String(Math.floor(100000 + Math.random() * 900000));
+        updateSimulatedSms(newCode);
+
+        // Reset and focus OTP
+        otpInput.value = '';
+        otpInput.removeAttribute('aria-invalid');
+        otpError.textContent = '';
+        otpInput.classList.remove('code-extracted');
+
+        updateStatus(`Verification code sent to ${formattedDisplay}. Enter the 6-digit code or allow automatic extraction.`);
+        startResendTimer();
+        initWebOTP();
+        otpInput.focus();
+        return true;
+      }
+
+      // Verify One-Time Passcode Flow
+      function verifyCode() {
+        const enteredVal = otpInput.value.trim().replace(/\D/g, '');
+
+        if (!enteredVal || enteredVal.length !== 6) {
+          otpInput.setAttribute('aria-invalid', 'true');
+          otpError.textContent = 'Please enter a valid 6-digit verification code.';
+          announceSR('Error: Please enter a valid 6-digit verification code.');
+          otpInput.focus();
+          return false;
+        }
+
+        // Accept code
+        otpInput.removeAttribute('aria-invalid');
+        otpError.textContent = '';
+
+        if (abortController) {
+          try {
+            abortController.abort();
+          } catch (e) { }
+        }
+        clearInterval(resendInterval);
+
+        const verifiedPhone = sentPhoneDisplay.textContent || (countryCodeSelect.value + ' ' + (phoneInput.value.trim() || '(555) 234-5678'));
+        successPhoneMsg.textContent = `Your phone number (${verifiedPhone}) has been successfully verified!`;
+
+        stepPhoneFieldset.style.display = 'none';
+        stepOtpFieldset.style.display = 'none';
+        verificationSuccess.style.display = 'block';
+
+        updateStatus('Phone number verified successfully! Welcome to Daily Grind Rewards.');
+        announceSR('Phone number verified successfully! You have unlocked 50 Rewards Bonus Stars.');
+
+        const successHeading = verificationSuccess.querySelector('h3');
+        if (successHeading) {
+          successHeading.setAttribute('tabindex', '-1');
+          successHeading.focus();
+        }
+        return true;
+      }
+
+      // Reset Verification Flow
+      function resetVerification() {
+        stepPhoneFieldset.style.display = '';
+        stepOtpFieldset.style.display = '';
+        verificationSuccess.style.display = 'none';
+        phoneSentBadge.style.display = 'none';
+
+        phoneInput.value = '';
+        otpInput.value = '';
+        phoneInput.removeAttribute('aria-invalid');
+        otpInput.removeAttribute('aria-invalid');
+        phoneError.textContent = '';
+        otpError.textContent = '';
+        otpStatus.textContent = '';
+        otpInput.classList.remove('code-extracted');
+
+        clearInterval(resendInterval);
+        currentCode = '123456';
+        updateSimulatedSms(currentCode);
+        resendBtn.disabled = true;
+        resendBtn.innerHTML = 'Resend Code (<span id="resend-timer">30</span>s)';
+
+        initWebOTP();
+        phoneInput.focus();
+        announceSR('Verification form reset. Please enter your mobile phone number.');
+      }
+
+      // Event Listeners
+      sendCodeBtn.addEventListener('click', sendCode);
+
+      phoneInput.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter') {
+          e.preventDefault();
+          sendCode();
+        }
+      });
+
+      phoneInput.addEventListener('input', () => {
+        if (phoneInput.getAttribute('aria-invalid') === 'true') {
+          phoneInput.removeAttribute('aria-invalid');
+          phoneError.textContent = '';
+        }
+      });
+
+      changePhoneBtn.addEventListener('click', () => {
+        phoneInput.focus();
+        phoneInput.select();
+        announceSR('Editing phone number.');
+      });
+
+      otpInput.addEventListener('input', (e) => {
+        const cleaned = otpInput.value.replace(/\D/g, '').slice(0, 6);
+        if (otpInput.value !== cleaned) {
+          otpInput.value = cleaned;
+        }
+        if (cleaned.length > 0) {
+          otpInput.removeAttribute('aria-invalid');
+          otpError.textContent = '';
+        }
+      });
+
+      // Paste event automatic code extraction
+      otpInput.addEventListener('paste', (e) => {
+        const text = (e.clipboardData || window.clipboardData)?.getData('text') || '';
+        const match = text.match(/\b\d{6}\b/);
+        if (match) {
+          e.preventDefault();
+          handleExtractedCode(match[0], 'Clipboard Paste');
+        }
+      });
+
+      // Resend Code
+      resendBtn.addEventListener('click', () => {
+        if (resendBtn.disabled) return;
+        const newCode = String(Math.floor(100000 + Math.random() * 900000));
+        updateSimulatedSms(newCode);
+        startResendTimer();
+        initWebOTP();
+        updateStatus('A new 6-digit verification code has been sent.');
+        otpInput.focus();
+      });
+
+      // Form submission handling
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        verifyCode();
+      });
+
+      // Hook form.submit programmatic call to ensure verification logic executes
+      form.submit = function () {
+        verifyCode();
+      };
+
+      // Simulator Actions
+      autoExtractBtn.addEventListener('click', () => {
+        handleExtractedCode(currentCode, 'Simulated SMS Auto-Extraction');
+      });
+
+      copyCodeBtn.addEventListener('click', () => {
+        if (navigator.clipboard && navigator.clipboard.writeText) {
+          navigator.clipboard.writeText(currentCode).then(() => {
+            updateStatus(`Code ${currentCode} copied to clipboard! You can paste it into the verification input.`);
+          }).catch(() => {
+            updateStatus(`Code is: ${currentCode}`);
+          });
+        } else {
+          updateStatus(`Code is: ${currentCode}`);
+        }
+      });
+
+      resetVerificationBtn.addEventListener('click', resetVerification);
+
+      // Initialize on load
+      updateSimulatedSms(currentCode);
+      if (document.readyState === 'loading') {
+        window.addEventListener('DOMContentLoaded', initWebOTP);
+      } else {
+        initWebOTP();
+      }
+    })();
+  </script>
 </body>
 
 </html>
