+  <script type="module">
+    import { initTemporal, CoffeeSequencingTelemetry } from './telemetry.js';
+
+    // Initialize Temporal API with fallback
+    await initTemporal();
+
+    const telemetry = new CoffeeSequencingTelemetry();
+
+    const simulateBtn = document.getElementById('simulate-order-btn');
+    const burstBtn = document.getElementById('simulate-burst-btn');
+    const clearBtn = document.getElementById('clear-telemetry-btn');
+    const latencyDisplay = document.getElementById('latest-latency');
+    const timestampDisplay = document.getElementById('latest-timestamp');
+    const totalEventsDisplay = document.getElementById('total-events');
+    const logContainer = document.getElementById('telemetry-log');
+
+    const coffeeItems = ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew', 'Vanilla Flat White', 'Nitro Cold Brew'];
+
+    function updateUI(result) {
+      totalEventsDisplay.textContent = telemetry.events.length;
+      timestampDisplay.textContent = result.clickTimestamp.toString();
+      latencyDisplay.textContent = result.diffFormatted;
+
+      const sorted = telemetry.sequenceEvents();
+      renderLog(sorted);
+    }
+
+    function renderLog(sorted) {
+      if (sorted.length === 0) {
+        logContainer.innerHTML = '<p style="color: #6c7086;">Ready. Click "Simulate Coffee Order" to begin high-frequency telemetry tracing.</p>';
+        return;
+      }
+
+      let html = '<div style="display: flex; flex-direction: column; gap: 6px;">';
+      for (let i = 0; i < sorted.length; i++) {
+        const curr = sorted[i];
+        let deltaText = 'Initial Event';
+        if (i > 0) {
+          const prev = sorted[i - 1];
+          const diff = curr.timestamp.since(prev.timestamp);
+          const ns = diff.total('nanoseconds');
+          deltaText = `+${ns.toLocaleString()} ns (${(ns / 1_000_000).toFixed(4)} ms)`;
+        }
+
+        html += `
+          <div style="border-bottom: 1px solid #282a36; padding: 4px 0; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
+            <div>
+              <span style="color: #f9e2af; font-weight: bold;">[#${i + 1}]</span>
+              <span style="color: #a6e3a1; font-weight: 600;">${curr.id}</span>
+              <span style="color: #cdd6f4;">${curr.type}</span>
+              <span style="color: #fab387; font-size: 0.8rem;">(${curr.nodeId})</span>
+            </div>
+            <div>
+              <span style="color: #89dceb; font-size: 0.8rem;">${curr.timestamp.toString()}</span>
+              <span style="color: #f38ba8; margin-left: 8px; font-weight: 600;">${deltaText}</span>
+            </div>
+          </div>
+        `;
+      }
+      html += '</div>';
+      logContainer.innerHTML = html;
+    }
+
+    simulateBtn.addEventListener('click', () => {
+      const randomItem = coffeeItems[Math.floor(Math.random() * coffeeItems.length)];
+      const result = telemetry.handleClick(randomItem);
+      updateUI(result);
+    });
+
+    burstBtn.addEventListener('click', () => {
+      for (let i = 0; i < 5; i++) {
+        const item = coffeeItems[Math.floor(Math.random() * coffeeItems.length)];
+        const result = telemetry.handleClick(item);
+        updateUI(result);
+      }
+    });
+
+    clearBtn.addEventListener('click', () => {
+      telemetry.clear();
+      latencyDisplay.textContent = '--';
+      timestampDisplay.textContent = '--';
+      totalEventsDisplay.textContent = '0';
+      renderLog([]);
+    });
+  </script>
