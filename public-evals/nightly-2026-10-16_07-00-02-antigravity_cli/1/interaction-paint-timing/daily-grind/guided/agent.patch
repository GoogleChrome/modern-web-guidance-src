+import { observeInteractionPaints, trackSoftNavigationLCP } from './perf.js';
+
+// Expose on global window object for inspection and automated tests
+if (typeof window !== 'undefined') {
+  window.observeInteractionPaints = observeInteractionPaints;
+  window.trackSoftNavigationLCP = trackSoftNavigationLCP;
+}
+
+// Global metrics recording
+export const performanceMetrics = {
+  interactionPaints: [],
+  softNavigations: [],
+};
+
+if (typeof window !== 'undefined') {
+  window.__performanceMetrics = performanceMetrics;
+}
+
+// Initialize performance observers
+export const interactionObserver = observeInteractionPaints((entry) => {
+  const record = {
+    interactionId: entry.interactionId,
+    duration: entry.duration,
+    presentationTime: entry.presentationTime,
+    startTime: entry.startTime,
+    element: entry.largestContentfulPaint?.element || null,
+    size: entry.largestContentfulPaint?.size || null,
+    url: entry.largestContentfulPaint?.url || null,
+  };
+  performanceMetrics.interactionPaints.push(record);
+  console.log('[Interaction Contentful Paint]', record);
+  updatePerformanceHUD();
+});
+
+export const softNavTracker = trackSoftNavigationLCP((report) => {
+  performanceMetrics.softNavigations.push(report);
+  console.log('[Soft Navigation LCP Report]', report);
+  updatePerformanceHUD();
+});
