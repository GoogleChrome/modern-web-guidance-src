+            <textarea rows="4" required style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px;" placeholder="Tell us what's on your mind..."></textarea>
+          </div>
+          <button type="submit" class="btn" style="width: 100%;">Send Message</button>
+        </form>
+      </div>
+    </section>
+  `,
+
+  '/privacy-policy': () => `
+    <section>
+      <h2>Privacy Policy</h2>
+      <div style="background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); margin-top: 20px; line-height: 1.8;">
+        <p><strong>Effective Date:</strong> January 1, 2026</p>
+        <p style="margin-top: 15px;">At The Daily Grind, we respect your privacy. This policy outlines how we collect, protect, and use personal information gathered through our online ordering and rewards program.</p>
+        <h3 style="margin-top: 20px; color: var(--primary);">Information We Collect</h3>
+        <p>We collect information provided directly by you when signing up for rewards or ordering online, including contact details and order preferences.</p>
+        <h3 style="margin-top: 20px; color: var(--primary);">Performance & Analytics</h3>
+        <p>We measure client-side navigation timing and interaction responsiveness using modern browser performance observer APIs to ensure a fast and delightful experience.</p>
+      </div>
+    </section>
+  `,
+
+  '/logout': () => `
+    <section style="text-align: center; padding: 40px 20px;">
+      <h2>You Have Been Logged Out</h2>
+      <p style="color: #666; margin: 15px 0 25px;">Thank you for visiting The Daily Grind. We hope to see you again soon!</p>
+      <a href="/" class="btn">Return to Home</a>
+    </section>
+  `,
+};
+
+/**
+ * Renders the route matching the current path.
+ * @param {string} pathname
+ */
+export function renderRoute(pathname) {
+  const container = document.querySelector('main.container');
+  const hero = document.querySelector('header.hero');
+  if (!container) return;
+
+  // Normalize path
+  const normalizedPath = pathname.replace(/\/$/, '') || '/';
+  const renderFn = routes[normalizedPath] || routes['/'];
+
+  // Toggle hero visibility on non-home pages
+  if (hero) {
+    if (normalizedPath === '/') {
+      hero.style.display = 'flex';
+    } else {
+      hero.style.display = 'none';
+    }
+  }
+
+  // Update DOM with new route content
+  container.innerHTML = renderFn();
+
+  // Scroll to top
+  window.scrollTo({ top: 0, behavior: 'instant' });
+
+  // Update active state in nav
+  document.querySelectorAll('nav a').forEach((link) => {
+    const linkPath = link.getAttribute('href');
+    if (linkPath === normalizedPath) {
+      link.classList.add('active-nav-link');
+    } else {
+      link.classList.remove('active-nav-link');
+    }
+  });
+}
+
+/**
+ * Client-side navigation handler
+ * @param {string} url
+ */
+export function navigateTo(url) {
+  if (window.location.pathname === url) return;
+  history.pushState(null, '', url);
+  renderRoute(url);
+}
+
+// Client-side link click interceptor
+function setupNavigationInterception() {
+  document.addEventListener('click', (event) => {
+    // Check if clicked element or ancestor is an internal link
+    const link = event.target.closest('a');
+    if (!link) return;
+
+    const href = link.getAttribute('href');
+    if (!href) return;
+
+    // Only intercept internal links starting with /
+    if (href.startsWith('/') && !href.startsWith('//') && !link.target && !link.hasAttribute('download')) {
+      event.preventDefault();
+      navigateTo(href);
+    }
+  });
+
+  // Handle browser back and forward
+  window.addEventListener('popstate', () => {
+    renderRoute(window.location.pathname);
+  });
+}
+
+// Interactive UI elements (Cart, Category tabs, Toasts)
+function setupInteractivity() {
+  document.addEventListener('click', (event) => {
+    // 1. Add to Cart / Order button
+    const addBtn = event.target.closest('.add-to-cart-btn');
+    if (addBtn) {
+      const name = addBtn.dataset.name || 'Item';
+      const price = addBtn.dataset.price || '';
+      cartItemsCount += 1;
+      updateCartDisplay();
+      showToast(`Added ${name} (${price}) to your order!`);
+      return;
+    }
+
+    // 2. Category filter tabs on Menu page
+    const tabBtn = event.target.closest('.tab-btn');
+    if (tabBtn) {
+      const category = tabBtn.dataset.category;
+      document.querySelectorAll('.tab-btn').forEach((b) => b.classList.remove('active'));
+      tabBtn.classList.add('active');
+
+      const cards = document.querySelectorAll('#menu-items-grid .card');
+      cards.forEach((card) => {
+        if (category === 'all' || card.dataset.cat === category) {
+          card.style.display = 'block';
+        } else {
+          card.style.display = 'none';
+        }
+      });
+      return;
+    }
+
+    // 3. Redeem reward button
+    const redeemBtn = event.target.closest('.redeem-btn');
+    if (redeemBtn) {
+      const beans = redeemBtn.dataset.beans;
+      showToast(`Reward redeemed for ${beans} beans! Applied to your account.`);
+      return;
+    }
+
+    // 4. Apply job button
+    const applyBtn = event.target.closest('.apply-btn');
+    if (applyBtn) {
+      const role = applyBtn.dataset.role;
+      showToast(`Thank you for your interest in the ${role} position! Application portal opened.`);
+      return;
+    }
+  });
+
+  // Contact form submission
+  document.addEventListener('submit', (event) => {
+    if (event.target.id === 'contact-form') {
+      event.preventDefault();
+      event.target.reset();
+      showToast('Thank you! Your message has been sent to our coffee team.');
+    }
+  });
+}
+
+// Notification Toast
+function showToast(message) {
+  let toast = document.getElementById('app-toast');
+  if (!toast) {
+    toast = document.createElement('div');
+    toast.id = 'app-toast';
+    document.body.appendChild(toast);
+  }
+  toast.textContent = message;
+  toast.classList.add('visible');
+  clearTimeout(toast._timeout);
+  toast._timeout = setTimeout(() => {
+    toast.classList.remove('visible');
+  }, 3500);
+}
+
+function updateCartDisplay() {
+  let badge = document.getElementById('cart-badge');
+  if (!badge) {
+    const navUl = document.querySelector('nav ul');
+    if (navUl) {
+      const li = document.createElement('li');
+      li.innerHTML = `<a href="/order-online" id="cart-nav-link" style="color: var(--accent); font-weight: bold;">Cart <span id="cart-badge">(0)</span></a>`;
+      navUl.appendChild(li);
+      badge = document.getElementById('cart-badge');
+    }
+  }
+  if (badge) {
+    badge.textContent = `(${cartItemsCount})`;
+  }
+}
+
+// On-screen Performance HUD (Collapsible)
+function setupPerformanceHUD() {
+  const hud = document.createElement('div');
+  hud.id = 'perf-hud';
+  hud.innerHTML = `
+    <div id="perf-hud-header">
+      <span>&#9889; Performance Timing Monitor</span>
+      <button id="perf-hud-toggle" aria-label="Toggle HUD">&#9660;</button>
+    </div>
+    <div id="perf-hud-body">
+      <div class="perf-metric">
+        <strong>Interaction Contentful Paints:</strong>
+        <span id="perf-icp-count">0</span>
+      </div>
+      <div class="perf-metric">
+        <strong>Last Interaction Paint Latency:</strong>
+        <span id="perf-icp-last">-</span>
+      </div>
+      <div class="perf-metric">
+        <strong>Soft Navigations:</strong>
+        <span id="perf-softnav-count">0</span>
+      </div>
+      <div class="perf-metric">
+        <strong>Last Route LCP:</strong>
+        <span id="perf-softnav-last">-</span>
+      </div>
+      <div id="perf-log-entries"></div>
+    </div>
+  `;
+  document.body.appendChild(hud);
+
+  const toggle = document.getElementById('perf-hud-toggle');
+  const body = document.getElementById('perf-hud-body');
+  toggle.addEventListener('click', () => {
+    const isCollapsed = body.style.display === 'none';
+    body.style.display = isCollapsed ? 'block' : 'none';
+    toggle.innerHTML = isCollapsed ? '&#9660;' : '&#9650;';
+  });
+}
+
+function updatePerformanceHUD() {
+  const icpCountEl = document.getElementById('perf-icp-count');
+  const icpLastEl = document.getElementById('perf-icp-last');
+  const softnavCountEl = document.getElementById('perf-softnav-count');
+  const softnavLastEl = document.getElementById('perf-softnav-last');
+  const logEntriesEl = document.getElementById('perf-log-entries');
+
+  if (!icpCountEl) return;
+
+  const paints = performanceMetrics.interactionPaints;
+  const softNavs = performanceMetrics.softNavigations;
+
+  icpCountEl.textContent = paints.length;
+  if (paints.length > 0) {
+    const last = paints[paints.length - 1];
+    icpLastEl.textContent = `${last.duration?.toFixed(1) ?? 'N/A'} ms`;
+  }
+
+  softnavCountEl.textContent = softNavs.length;
+  if (softNavs.length > 0) {
+    const last = softNavs[softNavs.length - 1];
+    softnavLastEl.textContent = `${last.url}: LCP ${last.lcpDuration ? last.lcpDuration.toFixed(1) + ' ms' : 'N/A'} (FCP ${last.fcpDuration ? last.fcpDuration.toFixed(1) + ' ms' : 'N/A'})`;
+  }
+
+  if (logEntriesEl) {
+    const lastItems = [
+      ...paints.map((p) => ({ type: 'ICP', text: `Interaction Paint: ${p.duration?.toFixed(1)}ms` })),
+      ...softNavs.map((s) => ({ type: 'SoftNav', text: `SoftNav [${s.url}]: LCP ${s.lcpDuration?.toFixed(1) ?? '-'}ms` })),
+    ].slice(-5);
+
+    logEntriesEl.innerHTML = lastItems
+      .map((item) => `<div class="perf-log-row"><span class="perf-tag ${item.type}">${item.type}</span> ${item.text}</div>`)
+      .join('');
+  }
+}
+
+// Initialize when DOM is loaded
+if (typeof document !== 'undefined') {
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', init);
+  } else {
+    init();
+  }
+}
+
+function init() {
+  setupNavigationInterception();
+  setupInteractivity();
+  setupPerformanceHUD();
+  updateCartDisplay();
+  renderRoute(window.location.pathname);
+}
