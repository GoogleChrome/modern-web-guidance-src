+  <script>
+    (function () {
+      const actionTarget = document.getElementById('action-target');
+      if (!actionTarget) return;
+
+      // Handle custom declarative button commands on action-target
+      actionTarget.addEventListener('command', function (event) {
+        const command = event.command || (event.detail && event.detail.command);
+        switch (command) {
+          case '--spin':
+            actionTarget.classList.toggle('is-spun');
+            break;
+          case '--grow':
+            actionTarget.classList.toggle('is-grown');
+            break;
+          case '--round':
+            actionTarget.classList.toggle('is-rounded');
+            break;
+          case '--reset':
+            actionTarget.classList.remove('is-spun', 'is-grown', 'is-rounded');
+            break;
+        }
+      });
+
+      // CommandEvent polyfill if CommandEvent is not natively defined
+      if (typeof CommandEvent === 'undefined') {
+        const CommandEventPolyfill = class CommandEvent extends Event {
+          constructor(type, eventInitDict = {}) {
+            super(type, eventInitDict);
+            this.command = eventInitDict.command || '';
+            this.source = eventInitDict.source || null;
+          }
+        };
+        if (typeof window !== 'undefined') {
+          window.CommandEvent = CommandEventPolyfill;
+        } else if (typeof global !== 'undefined') {
+          global.CommandEvent = CommandEventPolyfill;
+        }
+      }
+
+      // Polyfill HTMLButtonElement.prototype.command and commandForElement if not supported
+      if (!('commandForElement' in HTMLButtonElement.prototype)) {
+        Object.defineProperty(HTMLButtonElement.prototype, 'commandForElement', {
+          get() {
+            const targetId = this.getAttribute('commandfor');
+            if (!targetId) return null;
+            return (this.getRootNode() || document).getElementById(targetId);
+          },
+          set(element) {
+            if (element && element.id) {
+              this.setAttribute('commandfor', element.id);
+            } else {
+              this.removeAttribute('commandfor');
+            }
+          },
+          configurable: true,
+          enumerable: true
+        });
+
+        Object.defineProperty(HTMLButtonElement.prototype, 'command', {
+          get() {
+            return this.getAttribute('command') || '';
+          },
+          set(val) {
+            this.setAttribute('command', val);
+          },
+          configurable: true,
+          enumerable: true
+        });
+
+        // Click listener to dispatch CommandEvent to target element
+        document.addEventListener('click', function (event) {
+          const button = event.target.closest('button[commandfor], button[command]');
+          if (!button || button.disabled) return;
+
+          const command = button.getAttribute('command') || button.command;
+          const commandFor = button.getAttribute('commandfor');
+          const target = button.commandForElement || (commandFor ? document.getElementById(commandFor) : null);
+
+          if (!target || !command) return;
+
+          let cmdEvent;
+          try {
+            cmdEvent = new CommandEvent('command', {
+              bubbles: false,
+              cancelable: true,
+              composed: true,
+              command: command,
+              source: button
+            });
+          } catch (e) {
+            cmdEvent = new CustomEvent('command', {
+              bubbles: false,
+              cancelable: true,
+              composed: true
+            });
+            Object.defineProperty(cmdEvent, 'command', { value: command, enumerable: true });
+            Object.defineProperty(cmdEvent, 'source', { value: button, enumerable: true });
+          }
+
+          target.dispatchEvent(cmdEvent);
+        });
+      }
+    })();
+  </script>
