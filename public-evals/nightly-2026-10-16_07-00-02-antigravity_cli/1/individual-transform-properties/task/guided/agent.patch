+      user-select: none;
+
+      /* Maintain stable stacking context without will-change */
+      isolation: isolate;
+
+      /* Identity transformations for individual transform properties to prevent stacking shifts */
+      translate: 0 0;
+      rotate: 0deg;
+      scale: 1;
+
+      /* Two continuous independent animations running at the same time */
+      animation: spin 6s linear infinite, slide 3s ease-in-out infinite;
