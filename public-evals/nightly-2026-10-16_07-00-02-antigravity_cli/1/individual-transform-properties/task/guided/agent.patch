+    }
+
+    .target:hover {
+      scale: 1.15;
+    }
+
+    @keyframes spin {
+      from {
+        rotate: 0deg;
+      }
+      to {
+        rotate: 360deg;
+      }
+    }
+
+    @keyframes slide {
+      0%, 100% {
+        translate: 0 0;
+      }
+      50% {
+        translate: 25px 0;
+      }
+    }
