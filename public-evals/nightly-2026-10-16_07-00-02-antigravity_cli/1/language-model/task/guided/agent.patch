+    const baseSessionStatus = document.getElementById('base-session-status');
+    const activeBranchesCount = document.getElementById('active-branches-count');
+    const contextUsageStat = document.getElementById('context-usage-stat');
+    const contextMeterFill = document.getElementById('context-meter-fill');
+    const branchList = document.getElementById('branch-list');
+
+    // State
+    let baseSession = null;
+    let activeBranches = [];
+    let branchCounter = 0;
+
+    /**
+     * Initial Model Availability Check
+     */
+    async function updateAvailabilityStatus() {
+      const availability = await ClientAI.checkAvailability();
+      baristaStatusDot.className = 'status-dot';
+
+      if (availability === 'readily') {
+        baristaStatusDot.classList.add('ready');
+        baristaStatusText.textContent = 'Built-in Gemini Nano model ready on this device';
+      } else if (availability === 'after-download') {
+        baristaStatusDot.classList.add('downloading');
+        baristaStatusText.textContent = 'Model available (requires initial on-device download)';
+      } else {
+        baristaStatusDot.classList.add('fallback');
+        baristaStatusText.textContent = 'Native Prompt API unavailable on client; local AI engine active';
+      }
+    }
+    updateAvailabilityStatus();
+
+    /**
+     * 1. Ask the Barista - Streaming and Availability Monitoring
+     */
+    askBaristaBtn.addEventListener('click', async () => {
+      const question = baristaQuestion.value.trim();
+      if (!question) {
+        baristaQuestion.focus();
+        return;
+      }
+
+      askBaristaBtn.disabled = true;
+      baristaAnswer.classList.remove('placeholder-text');
+      baristaAnswer.textContent = '';
+
+      // Check model availability before starting
+      const availability = await ClientAI.checkAvailability();
+      if (availability === 'after-download') {
+        baristaProgressWrap.style.display = 'flex';
+        baristaStatusText.textContent = 'Downloading on-device model weights...';
+      } else if (availability === 'readily') {
+        baristaStatusText.textContent = 'Generating barista response...';
+      } else {
+        baristaStatusText.textContent = 'Processing with local AI coffee knowledge base...';
+      }
+
+      let session = null;
+      try {
+        session = await ClientAI.createSession({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              baristaProgressWrap.style.display = 'flex';
+              const percent = Math.round(e.loaded * 100);
+              baristaProgress.value = percent;
+              baristaProgressNum.textContent = percent + '%';
+              baristaStatusText.textContent = `Downloading on-device model: ${percent}%`;
+            });
+          },
+          initialPrompts: [
+            {
+              role: 'system',
+              content: "You are an artisanal barista at The Daily Grind. Accurately answer customer questions about our 'Maple Oat Latte' (made with Vermont maple syrup and steamed oat milk) and 'Cold Brew' (18-hour cold steeped for maximum smoothness)."
+            }
+          ]
+        });
+
+        // Hide download progress once ready
+        baristaProgressWrap.style.display = 'none';
+        baristaStatusText.textContent = 'Streaming barista response...';
+
+        // Safe progressive streaming (using textContent, strictly avoiding innerHTML injection)
+        const stream = session.promptStreaming(question);
+        let accumulatedText = '';
+
+        for await (const chunk of stream) {
+          // Handle both delta chunk streams and cumulative chunk updates
+          if (chunk.startsWith(accumulatedText) && chunk.length >= accumulatedText.length) {
+            accumulatedText = chunk;
+          } else {
+            accumulatedText += chunk;
+          }
+          baristaAnswer.textContent = accumulatedText;
+        }
+
+        baristaStatusText.textContent = 'Response complete.';
+      } catch (err) {
+        console.error('Barista streaming error:', err);
+        baristaAnswer.textContent = 'Unable to generate response. Please try again.';
+        baristaStatusText.textContent = 'Error during inference.';
+      } finally {
+        // Resource cleanup: explicitly destroy temporary session
+        if (session) {
+          try {
+            session.destroy();
+          } catch (e) {
+            console.warn('Session cleanup error:', e);
+          }
+        }
+        askBaristaBtn.disabled = false;
+        setTimeout(updateAvailabilityStatus, 2500);
+      }
+    });
+
+    /**
+     * 2. Customer Feedback Analyzer - Structured JSON with Score and Category
+     */
+    sentimentBtn.addEventListener('click', async () => {
+      const feedback = feedbackInput.value.trim();
+      if (!feedback) {
+        feedbackInput.focus();
+        return;
+      }
+
+      sentimentBtn.disabled = true;
+      sentimentOutput.textContent = 'Analyzing customer feedback with local AI schema constraints...';
+
+      // Verify availability
+      await ClientAI.checkAvailability();
+
+      // JSON Schema for structured output
+      const sentimentSchema = {
+        type: 'object',
+        properties: {
+          score: {
+            type: 'number',
+            minimum: 1,
+            maximum: 5,
+            description: 'Customer satisfaction rating from 1 (very negative) to 5 (very positive)'
+          },
+          category: {
+            type: 'string',
+            enum: ['positive', 'neutral', 'negative'],
+            description: 'Sentiment category of the customer review'
+          }
+        },
+        required: ['score', 'category']
+      };
+
+      let session = null;
+      try {
+        session = await ClientAI.createSession({
+          initialPrompts: [
+            {
+              role: 'system',
+              content: 'You are an AI customer sentiment analyzer for a coffee roastery. Always return strict structured output.'
+            }
+          ]
+        });
+
+        const promptText = `Analyze the following customer review and provide a score (1-5) and category (positive, neutral, negative):\n"${feedback}"`;
+        
+        // Pass responseConstraint to enforce JSON schema output
+        const result = await session.prompt(promptText, {
+          responseConstraint: sentimentSchema
+        });
+
+        let structuredData;
+        try {
+          structuredData = typeof result === 'string' ? JSON.parse(result) : result;
+        } catch (parseError) {
+          // Fallback parser if LLM wrapped JSON in text
+          const jsonMatch = result.match(/\{[\s\S]*\}/);
+          if (jsonMatch) {
+            structuredData = JSON.parse(jsonMatch[0]);
+          } else {
+            throw new Error('Failed to parse structured JSON response');
+          }
+        }
+
+        // Render structured JSON safely
+        sentimentOutput.textContent = JSON.stringify(structuredData, null, 2);
+      } catch (err) {
+        console.error('Sentiment analysis error:', err);
+        sentimentOutput.textContent = `Error: ${err.message || 'Analysis failed'}`;
+      } finally {
+        // Resource cleanup: proactively destroy completed session
+        if (session) {
+          try {
+            session.destroy();
+          } catch (e) {
+            console.warn('Session cleanup error:', e);
+          }
+        }
+        sentimentBtn.disabled = false;
+      }
+    });
+
+    /**
+     * 3. Conversation Branching, Session Cloning & Context Tracking
+     */
+    async function ensureBaseSession() {
+      if (!baseSession || baseSession.isDestroyed) {
+        baseSession = await ClientAI.createSession({
+          initialPrompts: [
+            {
+              role: 'system',
+              content: "You are The Daily Grind's master barista assistant. Answer customer queries with deep coffee knowledge about the Maple Oat Latte, Cold Brew, and roasting techniques."
+            }
+          ]
+        });
+        baseSessionStatus.textContent = 'Active (Base)';
+      }
+      return baseSession;
+    }
+
+    function updateContextDashboard() {
+      const activeCount = activeBranches.filter(b => !b.isDestroyed).length;
+      activeBranchesCount.textContent = activeCount;
+
+      let totalTokens = baseSession && !baseSession.isDestroyed ? (baseSession.contextUsage || 30) : 0;
+      activeBranches.forEach(b => {
+        if (!b.isDestroyed && b.session) {
+          totalTokens += (b.session.contextUsage || 0);
+        }
+      });
+
+      const maxTokens = 4096;
+      const usagePercent = Math.min(100, Math.round((totalTokens / maxTokens) * 100));
+      contextUsageStat.textContent = `${totalTokens} / ${maxTokens} tokens (${usagePercent}%)`;
+      contextMeterFill.style.width = usagePercent + '%';
+      if (usagePercent > 80) {
+        contextMeterFill.style.background = '#d32f2f';
+      } else if (usagePercent > 50) {
+        contextMeterFill.style.background = 'var(--warning)';
+      } else {
+        contextMeterFill.style.background = 'var(--accent)';
+      }
+    }
+
+    // Clone Button: clones the active base session into a new branch
+    cloneBtn.addEventListener('click', async () => {
+      cloneBtn.disabled = true;
+      try {
+        const base = await ensureBaseSession();
+        // Clone session inheriting base system instructions without re-parsing
+        const clonedSession = await base.clone();
+        
+        branchCounter++;
+        const branchId = branchCounter;
+        const branchObj = {
+          id: branchId,
+          session: clonedSession,
+          isDestroyed: false,
+          messages: [
+            { role: 'system', content: 'Branch session cloned from master barista baseline.' }
+          ]
+        };
+
+        activeBranches.push(branchObj);
+        renderBranchCard(branchObj);
+        updateContextDashboard();
+      } catch (err) {
+        console.error('Session cloning error:', err);
+        alert('Could not clone session: ' + err.message);
+      } finally {
+        cloneBtn.disabled = false;
+      }
+    });
+
+    // Cleanup Button: explicitly destroys inactive or unneeded branch sessions
+    cleanupBtn.addEventListener('click', () => {
+      let destroyedCount = 0;
+      activeBranches.forEach(branch => {
+        if (!branch.isDestroyed) {
+          try {
+            branch.session.destroy();
+          } catch (e) {
+            console.warn('Destroy error:', e);
+          }
+          branch.isDestroyed = true;
+          destroyedCount++;
+        }
+      });
+
+      // Clear DOM
+      branchList.innerHTML = '';
+      activeBranches = [];
+      updateContextDashboard();
+
+      alert(`Successfully destroyed ${destroyedCount} session(s) to free device memory.`);
+    });
+
+    function renderBranchCard(branch) {
+      const card = document.createElement('div');
+      card.className = 'branch-card';
+      card.id = `branch-card-${branch.id}`;
+
+      const header = document.createElement('div');
+      header.className = 'branch-card-header';
+
+      const titleWrap = document.createElement('div');
+      titleWrap.className = 'branch-title-wrap';
+
+      const title = document.createElement('span');
+      title.className = 'branch-title';
+      title.textContent = `Branch #${branch.id} (Cloned Session)`;
+
+      const contextBadge = document.createElement('span');
+      contextBadge.className = 'branch-context-badge';
+      contextBadge.id = `branch-tokens-${branch.id}`;
+      contextBadge.textContent = `${branch.session.contextUsage || 35} tokens`;
+
+      titleWrap.appendChild(title);
+      titleWrap.appendChild(contextBadge);
+
+      const destroyBtn = document.createElement('button');
+      destroyBtn.className = 'btn-sm btn-danger';
+      destroyBtn.textContent = 'Destroy Branch';
+      destroyBtn.title = 'Call session.destroy() to free memory';
+
+      header.appendChild(titleWrap);
+      header.appendChild(destroyBtn);
+
+      const dialogue = document.createElement('div');
+      dialogue.className = 'branch-dialogue';
+      dialogue.id = `branch-dialogue-${branch.id}`;
+
+      const initialBubble = document.createElement('div');
+      initialBubble.className = 'dialogue-bubble';
+      initialBubble.innerHTML = `<em>System instructions inherited from base session.</em>`;
+      dialogue.appendChild(initialBubble);
+
+      const form = document.createElement('form');
+      form.className = 'branch-form';
+
+      const input = document.createElement('input');
+      input.type = 'text';
+      input.className = 'branch-input';
+      input.placeholder = `Ask Branch #${branch.id} about coffee...`;
+      input.value = branch.id % 2 === 1 ? 'Tell me about the Maple Oat Latte aroma' : 'What is the caffeine content of Cold Brew?';
+
+      const sendBtn = document.createElement('button');
+      sendBtn.type = 'submit';
+      sendBtn.className = 'btn-sm btn-secondary';
+      sendBtn.textContent = 'Send';
+
+      form.appendChild(input);
+      form.appendChild(sendBtn);
+
+      card.appendChild(header);
+      card.appendChild(dialogue);
+      card.appendChild(form);
+      branchList.appendChild(card);
+
+      // Branch destruction handler
+      destroyBtn.addEventListener('click', () => {
+        try {
+          branch.session.destroy();
+        } catch (e) {
+          console.warn('Destroy error:', e);
+        }
+        branch.isDestroyed = true;
+        card.remove();
+        activeBranches = activeBranches.filter(b => b.id !== branch.id);
+        updateContextDashboard();
+      });
+
+      // Branch conversation form submit
+      form.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const userText = input.value.trim();
+        if (!userText || branch.isDestroyed) return;
+
+        input.value = '';
+        sendBtn.disabled = true;
+
+        const userBubble = document.createElement('div');
+        userBubble.className = 'dialogue-bubble';
+        userBubble.innerHTML = `<strong>You:</strong> `;
+        userBubble.appendChild(document.createTextNode(userText));
+        dialogue.appendChild(userBubble);
+        dialogue.scrollTop = dialogue.scrollHeight;
+
+        const aiBubble = document.createElement('div');
+        aiBubble.className = 'dialogue-bubble';
+        aiBubble.innerHTML = `<strong>Branch #${branch.id}:</strong> `;
+        const aiTextNode = document.createTextNode('...');
+        aiBubble.appendChild(aiTextNode);
+        dialogue.appendChild(aiBubble);
+
+        try {
+          const reply = await branch.session.prompt(userText);
+          aiTextNode.textContent = reply;
+          contextBadge.textContent = `${branch.session.contextUsage || 40} tokens`;
+          updateContextDashboard();
+        } catch (err) {
+          aiTextNode.textContent = `Error: ${err.message}`;
+        } finally {
+          sendBtn.disabled = false;
+          dialogue.scrollTop = dialogue.scrollHeight;
+        }
+      });
+    }
+
+    // Initialize base session on load
+    ensureBaseSession().then(() => updateContextDashboard());
+  </script>
 </body>
 
 </html>
