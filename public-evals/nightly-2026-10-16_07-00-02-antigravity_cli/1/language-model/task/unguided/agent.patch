+          if (!session) return { usage: 0, max: 4096, left: 4096 };
+          const usage = session.contextUsage ?? session.tokensSoFar ?? 0;
+          const max = session.contextWindow ?? session.maxTokens ?? 4096;
+          const left = session.tokensLeft ?? Math.max(0, max - usage);
+          return { usage, max, left };
+        }
+
+        async getOrCreateRootSession() {
+          if (this.branches.length > 0) {
+            return this.branches.find(b => b.id === this.activeBranchId) || this.branches[0];
+          }
+
+          const lm = getLanguageModel();
+          if (!lm) return null;
+
+          const session = await lm.create({
+            systemPrompt: "You are an artisanal barista at The Daily Grind. You provide expert guidance on espresso, brewing methods, pour-overs, and specialty drinks like the Maple Oat Latte and Cold Brew."
+          });
+
+          // Prime root session with base coffee conversation context
+          try {
+            await session.prompt("What drinks do you specialize in?");
+          } catch (_) {}
+
+          const id = this.nextId++;
+          const stats = this.getStats(session);
+          const rootBranch = {
+            id,
+            name: `Main Thread (Session #${id})`,
+            session,
+            parentId: null,
+            ...stats
+          };
+
+          this.branches.push(rootBranch);
+          this.activeBranchId = id;
+          return rootBranch;
+        }
+
+        async cloneActiveSession() {
+          const availability = await checkModelAvailability();
+          if (availability === 'no' || availability === 'unavailable') {
+            throw new Error('Local AI model is not available to clone.');
+          }
+
+          let current = this.branches.find(b => b.id === this.activeBranchId);
+          if (!current) {
+            current = await this.getOrCreateRootSession();
+          }
+
+          if (!current || !current.session) {
+            throw new Error('No active session available to clone.');
+          }
+
+          // Clone the active session
+          const clonedSession = await current.session.clone();
+          const newId = this.nextId++;
+          const stats = this.getStats(clonedSession);
+
+          const newBranch = {
+            id: newId,
+            name: `Branch #${newId} (Fork of #${current.id})`,
+            session: clonedSession,
+            parentId: current.id,
+            ...stats
+          };
+
+          this.branches.push(newBranch);
+          this.activeBranchId = newId;
+
+          // Update stats of both branches
+          Object.assign(current, this.getStats(current.session));
+          return newBranch;
+        }
+
+        destroyBranch(id) {
+          const idx = this.branches.findIndex(b => b.id === id);
+          if (idx === -1) return false;
+
+          const [branch] = this.branches.splice(idx, 1);
+          // Resource cleanup: release memory and VRAM
+          if (branch.session && typeof branch.session.destroy === 'function') {
+            branch.session.destroy();
+          }
+
+          if (this.activeBranchId === id) {
+            this.activeBranchId = this.branches.length > 0 ? this.branches[this.branches.length - 1].id : null;
+          }
+          return true;
+        }
+
+        cleanupInactiveSessions() {
+          const inactive = this.branches.filter(b => b.id !== this.activeBranchId);
+          inactive.forEach(b => {
+            if (b.session && typeof b.session.destroy === 'function') {
+              b.session.destroy();
+            }
+          });
+          this.branches = this.branches.filter(b => b.id === this.activeBranchId);
+          return inactive.length;
+        }
+
+        destroyAll() {
+          this.branches.forEach(b => {
+            if (b.session && typeof b.session.destroy === 'function') {
+              b.session.destroy();
+            }
+          });
+          this.branches = [];
+          this.activeBranchId = null;
+        }
+      }
+
+      const branchManager = new BranchManager();
+
+      function updateContextUI() {
+        const active = branchManager.branches.find(b => b.id === branchManager.activeBranchId);
+        const stats = active ? branchManager.getStats(active.session) : { usage: 0, max: 4096, left: 4096 };
+        const pct = stats.max > 0 ? Math.min(100, Math.round((stats.usage / stats.max) * 100)) : 0;
+
+        const tokensSoFarEl = document.getElementById('tokens-so-far');
+        const tokensLeftEl = document.getElementById('tokens-left');
+        const tokensMaxEl = document.getElementById('tokens-max');
+        const summaryEl = document.getElementById('context-summary');
+        const fillEl = document.getElementById('context-progress-fill');
+
+        if (tokensSoFarEl) tokensSoFarEl.textContent = stats.usage;
+        if (tokensLeftEl) tokensLeftEl.textContent = stats.left;
+        if (tokensMaxEl) tokensMaxEl.textContent = stats.max;
+        if (summaryEl) summaryEl.textContent = `${stats.usage} / ${stats.max} tokens (${pct}%)`;
+        if (fillEl) fillEl.style.width = pct + '%';
+
+        const activeTitleEl = document.getElementById('active-branch-title');
+        if (activeTitleEl) {
+          activeTitleEl.textContent = active ? `Branch Discussion: ${active.name}` : 'Branch Discussion: (No active session)';
+        }
+      }
+
+      function renderBranchesList() {
+        const container = document.getElementById('branches-list');
+        if (!container) return;
+        container.innerHTML = '';
+
+        if (branchManager.branches.length === 0) {
+          container.innerHTML = '<div style="font-size: 0.9rem; color: #795548; font-style: italic;">No active sessions yet. Click "Clone Active Session" to begin.</div>';
+          return;
+        }
+
+        branchManager.branches.forEach(branch => {
+          const stats = branchManager.getStats(branch.session);
+          const isActive = branch.id === branchManager.activeBranchId;
+
+          const card = document.createElement('div');
+          card.className = `branch-card ${isActive ? 'active' : ''}`;
+          card.innerHTML = `
+            <div>
+              <div style="font-weight: bold; color: var(--primary);">
+                ${branch.name} ${isActive ? '<span class="badge badge-success">ACTIVE</span>' : ''}
+              </div>
+              <div style="font-size: 0.8rem; color: #6d4c41; margin-top: 2px;">
+                Tokens: <strong>${stats.usage}</strong> used | <strong>${stats.left}</strong> remaining | Window: ${stats.max}
+              </div>
+            </div>
+            <div style="display: flex; gap: 8px; align-items: center;">
+              ${!isActive ? `<button class="btn btn-secondary btn-sm switch-btn" data-id="${branch.id}" style="cursor: pointer;">Switch</button>` : ''}
+              <button class="btn btn-danger btn-sm destroy-btn" data-id="${branch.id}" style="cursor: pointer;">Destroy</button>
+            </div>
+          `;
+
+          const switchBtn = card.querySelector('.switch-btn');
+          if (switchBtn) {
+            switchBtn.addEventListener('click', () => {
+              branchManager.activeBranchId = branch.id;
+              updateContextUI();
+              renderBranchesList();
+            });
+          }
+
+          const destroyBtn = card.querySelector('.destroy-btn');
+          if (destroyBtn) {
+            destroyBtn.addEventListener('click', () => {
+              branchManager.destroyBranch(branch.id);
+              updateContextUI();
+              renderBranchesList();
+              const statusEl = document.getElementById('branch-status-msg');
+              if (statusEl) statusEl.textContent = `Destroyed session #${branch.id} and released resources.`;
+            });
+          }
+
+          container.appendChild(card);
+        });
+      }
+
+      // Clone button handler
+      const cloneBtn = document.getElementById('clone-btn');
+      if (cloneBtn) {
+        cloneBtn.addEventListener('click', async () => {
+          const statusEl = document.getElementById('branch-status-msg');
+          try {
+            if (statusEl) statusEl.textContent = 'Cloning active session...';
+            const newBranch = await branchManager.cloneActiveSession();
+            updateContextUI();
+            renderBranchesList();
+            if (statusEl) {
+              statusEl.textContent = `Successfully cloned session! Created ${newBranch.name}.`;
+            }
+          } catch (err) {
+            console.error('Clone session error:', err);
+            if (statusEl) {
+              statusEl.textContent = `Clone error: ${err.message || 'Failed to clone session.'}`;
+            }
+          }
+        });
+      }
+
+      // Cleanup inactive sessions handler
+      const cleanupBtn = document.getElementById('cleanup-btn');
+      if (cleanupBtn) {
+        cleanupBtn.addEventListener('click', () => {
+          const count = branchManager.cleanupInactiveSessions();
+          updateContextUI();
+          renderBranchesList();
+          const statusEl = document.getElementById('branch-status-msg');
+          if (statusEl) {
+            statusEl.textContent = `Cleaned up ${count} inactive session(s). System resources released.`;
+          }
+        });
+      }
+
+      // Branch Chat prompt handler
+      const branchSendBtn = document.getElementById('branch-send-btn');
+      const branchQueryInput = document.getElementById('branch-query-input');
+      const branchAnswerEl = document.getElementById('branch-answer');
+
+      if (branchSendBtn) {
+        branchSendBtn.addEventListener('click', async () => {
+          const query = (branchQueryInput && branchQueryInput.value.trim()) || 'What brewing notes can you share?';
+          const active = branchManager.branches.find(b => b.id === branchManager.activeBranchId);
+          if (!active || !active.session) {
+            if (branchAnswerEl) branchAnswerEl.textContent = 'No active branch selected. Please clone or create a session first.';
+            return;
+          }
+
+          if (branchAnswerEl) branchAnswerEl.textContent = 'Thinking in branch context...';
+          try {
+            if (typeof active.session.promptStreaming === 'function') {
+              const stream = active.session.promptStreaming(query);
+              if (branchAnswerEl) branchAnswerEl.textContent = '';
+              await consumeStream(stream, (chunk) => {
+                if (branchAnswerEl) branchAnswerEl.textContent = chunk;
+              });
+            } else if (typeof active.session.prompt === 'function') {
+              const res = await active.session.prompt(query);
+              if (branchAnswerEl) branchAnswerEl.textContent = res;
+            }
+            updateContextUI();
+            renderBranchesList();
+          } catch (err) {
+            console.error('Branch query error:', err);
+            if (branchAnswerEl) branchAnswerEl.textContent = `Error: ${err.message || 'Branch query failed'}`;
+          }
+        });
+      }
+
+      // Resource Cleanup on page unload
+      window.addEventListener('beforeunload', () => {
+        branchManager.destroyAll();
+        if (baristaSession && typeof baristaSession.destroy === 'function') {
+          baristaSession.destroy();
+        }
+      });
+
+      // Initial checks
+      updateAvailabilityBadge();
+      updateContextUI();
+      renderBranchesList();
+    })();
+  </script>
 </body>
 
 </html>
