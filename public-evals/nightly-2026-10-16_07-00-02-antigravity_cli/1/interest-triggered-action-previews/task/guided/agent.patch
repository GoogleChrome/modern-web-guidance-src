+  <script type="module">
+    if (!HTMLButtonElement.prototype.hasOwnProperty("interestForElement")) {
+      try {
+        await import("./node_modules/interestfor/src/interestfor.min.js");
+      } catch {
+        await import("https://unpkg.com/interestfor@latest");
+      }
+    }
+
+    const preview = document.getElementById("seasonal-preview");
+    if (preview) {
+      preview.addEventListener("interest", (event) => {
+        const source = event.source || event.detail?.source;
+        const drink = source?.dataset?.drink || source?.closest(".card")?.querySelector("h3")?.textContent?.trim();
+        if (drink) {
+          preview.textContent = drink;
+          preview.dataset.preview = drink;
+        }
+      });
+
+      preview.addEventListener("loseinterest", () => {
+        preview.textContent = "Select a drink to preview";
+        delete preview.dataset.preview;
+      });
+    }
+  </script>
