+  <script>
+    (function () {
+      const defaultText = 'Select a drink to preview';
+      const preview = document.getElementById('seasonal-preview');
+
+      if (!preview) return;
+
+      function updatePreview(source) {
+        if (!source) return;
+        const drinkName = source.getAttribute('data-drink') ||
+          source.closest('.card')?.querySelector('h3')?.textContent?.trim() ||
+          source.textContent?.trim();
+        if (drinkName) {
+          preview.textContent = drinkName;
+          preview.style.color = 'var(--accent)';
+          preview.classList.add('active');
+        }
+      }
+
+      function resetPreview() {
+        preview.textContent = defaultText;
+        preview.style.color = '';
+        preview.classList.remove('active');
+      }
+
+      // Listen for declarative interest events on the target element
+      preview.addEventListener('interest', function (event) {
+        const source = event.source || (event.detail && event.detail.source);
+        updatePreview(source);
+      });
+
+      preview.addEventListener('loseinterest', function () {
+        resetPreview();
+      });
+
+      // Polyfill / fallback for environments without native Interest Invoker support.
+      // Uses document-level delegation instead of attaching handlers to individual buttons.
+      if (!('oninterest' in HTMLElement.prototype) && !('InterestEvent' in window)) {
+        if (typeof window.InterestEvent === 'undefined') {
+          window.InterestEvent = class InterestEvent extends Event {
+            constructor(type, initDict = {}) {
+              super(type, initDict);
+              this.source = initDict.source || null;
+            }
+          };
+        }
+
+        let currentInvoker = null;
+        let currentTarget = null;
+
+        function handleInterest(invoker) {
+          const targetId = invoker.getAttribute('interestfor') || invoker.getAttribute('interesttarget');
+          if (!targetId) return;
+          const target = document.getElementById(targetId);
+          if (!target) return;
+
+          if (currentInvoker !== invoker) {
+            if (currentTarget) {
+              handleLoseInterest();
+            }
+            currentInvoker = invoker;
+            currentTarget = target;
+            let event;
+            try {
+              event = new InterestEvent('interest', { source: invoker, bubbles: false, cancelable: true });
+            } catch (e) {
+              event = new CustomEvent('interest', { bubbles: false, cancelable: true });
+              event.source = invoker;
+            }
+            target.dispatchEvent(event);
+          }
+        }
+
+        function handleLoseInterest() {
+          if (currentTarget && currentInvoker) {
+            let event;
+            try {
+              event = new InterestEvent('loseinterest', { source: currentInvoker, bubbles: false, cancelable: true });
+            } catch (e) {
+              event = new CustomEvent('loseinterest', { bubbles: false, cancelable: true });
+              event.source = currentInvoker;
+            }
+            currentTarget.dispatchEvent(event);
+            currentTarget = null;
+            currentInvoker = null;
+          }
+        }
+
+        document.addEventListener('mouseover', function (e) {
+          const invoker = e.target.closest('[interestfor], [interesttarget]');
+          if (invoker) {
+            handleInterest(invoker);
+          } else if (currentInvoker && !currentInvoker.contains(e.target)) {
+            handleLoseInterest();
+          }
+        });
+
+        document.addEventListener('mouseout', function (e) {
+          if (currentInvoker && !currentInvoker.contains(e.relatedTarget)) {
+            handleLoseInterest();
+          }
+        });
+
+        document.addEventListener('focusin', function (e) {
+          const invoker = e.target.closest('[interestfor], [interesttarget]');
+          if (invoker) {
+            handleInterest(invoker);
+          }
+        });
+
+        document.addEventListener('focusout', function (e) {
+          if (currentInvoker && !currentInvoker.contains(e.relatedTarget)) {
+            handleLoseInterest();
+          }
+        });
+      }
+    })();
+  </script>
 </body>
 
