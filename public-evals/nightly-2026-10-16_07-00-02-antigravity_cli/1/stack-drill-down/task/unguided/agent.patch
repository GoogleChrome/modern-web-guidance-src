+            </div>
+          </div>
+        `;
+
+        return view;
+      }
+
+      function updateParallax() {
+        const width = stack.clientWidth;
+        if (!width) return;
+        const scrollLeft = stack.scrollLeft;
+        const views = stack.querySelectorAll('.Stack-view');
+        const isReduced = prefersReducedMotion();
+
+        views.forEach((view, index) => {
+          const content = view.querySelector('.Stack-viewContent');
+          if (!content) return;
+
+          if (isReduced) {
+            content.style.transform = '';
+            content.style.setProperty('--dim', '0');
+            return;
+          }
+
+          // Relative progress:
+          // progress = 0 when view is active and flush
+          // progress > 0 when this view is being covered by view index + 1
+          const progress = (scrollLeft - index * width) / width;
+
+          if (progress > 0 && progress <= 1) {
+            const p = progress;
+            const parallaxPx = p * width * 0.28;
+            const scale = 1 - p * 0.04;
+            content.style.transform = `translateX(${parallaxPx}px) scale(${scale})`;
+            content.style.setProperty('--dim', (p * 0.45).toFixed(3));
+          } else if (progress > 1) {
+            const parallaxPx = width * 0.28;
+            content.style.transform = `translateX(${parallaxPx}px) scale(0.96)`;
+            content.style.setProperty('--dim', '0.45');
+          } else {
+            content.style.transform = '';
+            content.style.setProperty('--dim', '0');
+          }
+        });
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          requestAnimationFrame(() => {
+            updateParallax();
+            ticking = false;
+          });
+          ticking = true;
+        }
+      }
+
+      function scrollToView(index, smooth = true) {
+        const width = stack.clientWidth;
+        const behavior = (!smooth || prefersReducedMotion()) ? 'auto' : 'smooth';
+        stack.scrollTo({
+          left: index * width,
+          behavior
+        });
+      }
+
+      function navigateTo(viewId, triggerElement = null) {
+        if (!VIEWS_DATA[viewId]) return;
+
+        if (triggerElement) {
+          lastFocusedLink = triggerElement;
+        }
+
+        let targetView = stack.querySelector(`.Stack-view[data-view-id="${viewId}"]`);
+        let views = Array.from(stack.querySelectorAll('.Stack-view'));
+
+        if (!targetView) {
+          targetView = createViewElement(viewId);
+          stack.appendChild(targetView);
+          views = Array.from(stack.querySelectorAll('.Stack-view'));
+        }
+
+        const targetIndex = views.indexOf(targetView);
+        historyDepth++;
+        history.pushState({ depth: historyDepth, viewId }, '', `#/view/${viewId}`);
+
+        scrollToView(targetIndex, true);
+
+        // Focus back button on target view without triggering unwanted scrolls
+        const backBtn = targetView.querySelector('.back');
+        if (backBtn) {
+          backBtn.focus({ preventScroll: true });
+        }
+      }
+
+      function goBack() {
+        const views = Array.from(stack.querySelectorAll('.Stack-view'));
+        if (views.length <= 1) return;
+
+        const prevIndex = views.length - 2;
+        const prevView = views[prevIndex];
+        const prevViewId = prevView.dataset.viewId;
+
+        if (historyDepth > 0) {
+          historyDepth--;
+          isHistoryNavigating = true;
+          history.back();
+          scrollToView(prevIndex, true);
+        } else {
+          const newHash = prevViewId === 'root' ? '' : `#/view/${prevViewId}`;
+          history.replaceState({ depth: 0, viewId: prevViewId }, '', newHash || window.location.pathname + window.location.search);
+          scrollToView(prevIndex, true);
+        }
+      }
+
+      function handleScrollEnd() {
+        const width = stack.clientWidth;
+        if (!width) return;
+        const activeIndex = Math.round(stack.scrollLeft / width);
+        const views = Array.from(stack.querySelectorAll('.Stack-view'));
+
+        if (activeIndex >= 0 && activeIndex < views.length) {
+          const currentView = views[activeIndex];
+          const currentViewId = currentView.dataset.viewId;
+
+          // Any views beyond the activeIndex that we swiped past get removed from the DOM to save memory
+          const viewsToRemove = views.slice(activeIndex + 1);
+          if (viewsToRemove.length > 0) {
+            const dismissedId = viewsToRemove[0].dataset.viewId;
+            viewsToRemove.forEach(v => v.remove());
+
+            // Return focus to the trigger link or fallback without weird scrolls
+            if (lastFocusedLink && document.body.contains(lastFocusedLink)) {
+              lastFocusedLink.focus({ preventScroll: true });
+            } else {
+              const fallback = document.querySelector(`.item[data-id="${dismissedId}"]`) || document.querySelector('.item');
+              if (fallback) {
+                fallback.focus({ preventScroll: true });
+              }
+            }
+
+            // Sync history URL if swipe occurred
+            const expectedHash = currentViewId === 'root' ? '' : `#/view/${currentViewId}`;
+            const currentHash = window.location.hash;
+            if (currentHash !== expectedHash && !(expectedHash === '' && (currentHash === '' || currentHash === '#'))) {
+              if (historyDepth > 0) {
+                historyDepth--;
+                isHistoryNavigating = true;
+                history.back();
+              } else {
+                history.replaceState({ depth: 0, viewId: currentViewId }, '', expectedHash || window.location.pathname + window.location.search);
+              }
+            }
+          } else {
+            // If we navigated forward or stayed on view, make sure the back button has focus
+            if (activeIndex > 0) {
+              const backBtn = currentView.querySelector('.back');
+              if (backBtn && document.activeElement !== backBtn) {
+                backBtn.focus({ preventScroll: true });
+              }
+            }
+          }
+        }
+
+        updateParallax();
+      }
+
+      function handlePopState() {
+        if (isHistoryNavigating) {
+          isHistoryNavigating = false;
+          return;
+        }
+
+        const match = window.location.hash.match(/^#\/view\/([^\/?#]+)/);
+        const targetViewId = match ? match[1] : 'root';
+        let targetView = stack.querySelector(`.Stack-view[data-view-id="${targetViewId}"]`);
+
+        if (targetViewId === 'root') {
+          scrollToView(0, true);
+        } else {
+          if (!targetView) {
+            targetView = createViewElement(targetViewId);
+            stack.appendChild(targetView);
+          }
+          const targetIndex = Array.from(stack.querySelectorAll('.Stack-view')).indexOf(targetView);
+          scrollToView(targetIndex, true);
+          const backBtn = targetView.querySelector('.back');
+          if (backBtn) {
+            backBtn.focus({ preventScroll: true });
+          }
+        }
+      }
+
+      // Event Listeners
+      stack.addEventListener('scroll', () => {
+        onScroll();
+        clearTimeout(scrollEndTimer);
+        scrollEndTimer = setTimeout(handleScrollEnd, 120);
+      }, { passive: true });
+
+      stack.addEventListener('scrollend', () => {
+        clearTimeout(scrollEndTimer);
+        handleScrollEnd();
+      });
+
+      window.addEventListener('popstate', handlePopState);
+
+      window.addEventListener('resize', () => {
+        const width = stack.clientWidth;
+        const views = Array.from(stack.querySelectorAll('.Stack-view'));
+        const activeIndex = Math.min(Math.round(stack.scrollLeft / (width || 1)), views.length - 1);
+        stack.scrollLeft = activeIndex * width;
+        updateParallax();
+      });
+
+      document.addEventListener('click', (e) => {
+        const itemLink = e.target.closest('.item');
+        if (itemLink) {
+          // Preserve modifier and middle clicks so users can still open in new tabs
+          if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) {
+            return;
+          }
+          e.preventDefault();
+          const id = itemLink.dataset.id;
+          if (id) {
+            navigateTo(id, itemLink);
+          }
+          return;
+        }
+
+        const backBtn = e.target.closest('.back');
+        if (backBtn) {
+          e.preventDefault();
+          goBack();
+          return;
+        }
+      });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape') {
+          const views = stack.querySelectorAll('.Stack-view');
+          if (views.length > 1) {
+            goBack();
+          }
+        }
+      });
+
+      // Deep linking and initialization
+      function init() {
+        const match = window.location.hash.match(/^#\/view\/([^\/?#]+)/);
+        if (match && VIEWS_DATA[match[1]]) {
+          const viewId = match[1];
+          const drillView = createViewElement(viewId);
+          stack.appendChild(drillView);
+
+          requestAnimationFrame(() => {
+            const width = stack.clientWidth;
+            stack.scrollLeft = width;
+            updateParallax();
+
+            const backBtn = drillView.querySelector('.back');
+            if (backBtn) {
+              backBtn.focus({ preventScroll: true });
+            }
+          });
+        } else {
+          stack.scrollLeft = 0;
+          updateParallax();
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
 </body>
 
 </html>
