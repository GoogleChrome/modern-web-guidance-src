+          window.pickupPlainTime = plainTime;
+
+          const formatted = plainTime.toLocaleString('en-US', {
+            hour: 'numeric',
+            minute: '2-digit',
+            hour12: true
+          });
+
+          if (pickupDisplay) pickupDisplay.textContent = formatted;
