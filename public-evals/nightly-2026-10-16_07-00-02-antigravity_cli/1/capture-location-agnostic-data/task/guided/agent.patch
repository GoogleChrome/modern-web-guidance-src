+  <script type="module">
+    // Location-agnostic chronological data using Temporal API (PlainDate and PlainTime)
+    async function initTemporal() {
+      if (typeof globalThis.Temporal === 'undefined') {
+        try {
+          const module = await import("https://esm.sh/@js-temporal/polyfill");
+          globalThis.Temporal = module.Temporal;
+          Date.prototype.toTemporalInstant = module.toTemporalInstant;
+        } catch (e) {
+          console.warn("Could not load @js-temporal/polyfill from CDN, using embedded fallback:", e);
+        }
+      }
+
+      if (typeof globalThis.Temporal === 'undefined' || !globalThis.Temporal.PlainDate || !globalThis.Temporal.PlainTime) {
+        class FallbackPlainDate {
+          constructor(year, month, day) {
+            this.year = Number(year);
+            this.month = Number(month);
+            this.day = Number(day);
+          }
+          static from(val) {
+            if (val instanceof FallbackPlainDate) return val;
+            if (typeof val === 'string') {
+              const parts = val.split('T')[0].split('-');
+              if (parts.length >= 3) {
+                return new FallbackPlainDate(parts[0], parts[1], parts[2]);
+              }
+            } else if (val && typeof val === 'object') {
+              return new FallbackPlainDate(val.year, val.month, val.day);
+            }
+            throw new TypeError('Invalid PlainDate: ' + val);
+          }
+          toString() {
+            const y = String(this.year).padStart(4, '0');
+            const m = String(this.month).padStart(2, '0');
+            const d = String(this.day).padStart(2, '0');
+            return `${y}-${m}-${d}`;
+          }
+          toLocaleString(locale, options) {
+            const dt = new Date(Date.UTC(this.year, this.month - 1, this.day, 12, 0, 0));
+            return dt.toLocaleDateString(locale || undefined, { ...options, timeZone: 'UTC' });
+          }
+          equals(other) {
+            return this.year === other.year && this.month === other.month && this.day === other.day;
+          }
+        }
+
+        class FallbackPlainTime {
+          constructor(hour = 0, minute = 0, second = 0) {
+            this.hour = Number(hour);
+            this.minute = Number(minute);
+            this.second = Number(second);
+          }
+          static from(val) {
+            if (val instanceof FallbackPlainTime) return val;
+            if (typeof val === 'string') {
+              const match = val.match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?/);
+              if (match) {
+                return new FallbackPlainTime(match[1], match[2], match[3] || 0);
+              }
+            } else if (val && typeof val === 'object') {
+              return new FallbackPlainTime(val.hour || 0, val.minute || 0, val.second || 0);
+            }
+            throw new TypeError('Invalid PlainTime: ' + val);
+          }
+          toString() {
+            const h = String(this.hour).padStart(2, '0');
+            const m = String(this.minute).padStart(2, '0');
+            const s = String(this.second).padStart(2, '0');
+            return `${h}:${m}:${s}`;
+          }
+          toLocaleString(locale, options) {
+            const dt = new Date(Date.UTC(2000, 0, 1, this.hour, this.minute, this.second));
+            return dt.toLocaleTimeString(locale || undefined, { ...options, timeZone: 'UTC' });
+          }
+          equals(other) {
+            return this.hour === other.hour && this.minute === other.minute && this.second === other.second;
+          }
+        }
+
+        globalThis.Temporal = globalThis.Temporal || {};
+        globalThis.Temporal.PlainDate = FallbackPlainDate;
+        globalThis.Temporal.PlainTime = FallbackPlainTime;
+      }
+
+      if (typeof window !== 'undefined') {
+        window.Temporal = globalThis.Temporal;
+      }
+      return globalThis.Temporal;
+    }
+
+    async function initializeApp() {
+      const Temporal = await initTemporal();
+
+      const pickupInput = document.getElementById('pickup-time');
+      const pickupDisplay = document.getElementById('pickup-time-display');
+      const pickupNote = document.getElementById('pickup-time-note');
+
+      const anniversaryInput = document.getElementById('anniversary-date');
+      const anniversaryDisplay = document.getElementById('anniversary-date-display');
+      const anniversaryNote = document.getElementById('anniversary-date-note');
+
+      const saveBtn = document.getElementById('save-reminders-btn');
+      const saveStatus = document.getElementById('save-status');
+
+      function updatePickupTime(value, persist = false) {
+        if (!value) return;
+        try {
+          // Use Temporal.PlainTime for location-agnostic wall-clock time
