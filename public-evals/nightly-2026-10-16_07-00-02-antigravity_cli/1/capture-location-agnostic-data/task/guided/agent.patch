+
+          if (persist) {
+            localStorage.setItem('dailyPickupReminderTime', plainTime.toString());
+          }
+          return plainTime;
+        } catch (err) {
+          console.error("Invalid pickup time:", err);
+        }
+      }
+
+      function updateAnniversaryDate(value, persist = false) {
+        if (!value) return;
