+          window.anniversaryPlainDate = plainDate;
+
+          const formatted = plainDate.toLocaleString('en-US', {
+            month: 'long',
+            day: 'numeric',
+            year: 'numeric'
+          });
+
+          if (anniversaryDisplay) anniversaryDisplay.textContent = formatted;
+          if (anniversaryNote) anniversaryNote.textContent = `Calendar date: ${formatted} (never drifts across time zones)`;
+
+          if (persist) {
+            localStorage.setItem('coffeeAnniversaryDate', plainDate.toString());
+          }
+          return plainDate;
+        } catch (err) {
+          console.error("Invalid anniversary date:", err);
+        }
+      }
+
+      function savePreferences() {
+        if (pickupInput) updatePickupTime(pickupInput.value, true);
+        if (anniversaryInput) updateAnniversaryDate(anniversaryInput.value, true);
+        if (saveStatus) {
+          saveStatus.style.display = 'block';
+          setTimeout(() => {
+            saveStatus.style.display = 'none';
+          }, 3000);
+        }
+      }
+
+      // Restore from localStorage or use defaults
+      const storedTime = localStorage.getItem('dailyPickupReminderTime');
+      const initialTime = storedTime ? storedTime.slice(0, 5) : (pickupInput ? pickupInput.value : '08:30');
+      if (pickupInput) pickupInput.value = initialTime;
+      updatePickupTime(initialTime, false);
+
+      const storedDate = localStorage.getItem('coffeeAnniversaryDate');
+      const initialDate = storedDate || (anniversaryInput ? anniversaryInput.value : '2024-10-16');
+      if (anniversaryInput) anniversaryInput.value = initialDate;
+      updateAnniversaryDate(initialDate, false);
+
+      // Event listeners for automatic update and persistence
+      if (pickupInput) {
+        pickupInput.addEventListener('input', () => updatePickupTime(pickupInput.value, true));
+        pickupInput.addEventListener('change', () => updatePickupTime(pickupInput.value, true));
+      }
+      if (anniversaryInput) {
+        anniversaryInput.addEventListener('input', () => updateAnniversaryDate(anniversaryInput.value, true));
+        anniversaryInput.addEventListener('change', () => updateAnniversaryDate(anniversaryInput.value, true));
+      }
+      if (saveBtn) {
+        saveBtn.addEventListener('click', savePreferences);
+      }
+
+      // Expose globally for convenience and testing
+      window.getPickupPlainTime = () => window.pickupPlainTime;
+      window.getAnniversaryPlainDate = () => window.anniversaryPlainDate;
+      window.updatePickupTime = updatePickupTime;
+      window.updateAnniversaryDate = updateAnniversaryDate;
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initializeApp);
+    } else {
+      initializeApp();
+    }
+  </script>
