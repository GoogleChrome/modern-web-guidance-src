+  <script>
+    (function () {
+      // Storage keys for preferences
+      const STORAGE_KEYS_TIME = [
+        'dailyPickupReminderTime',
+        'pickupReminderTime',
+        'pickup-reminder-time',
+        'pickup_reminder_time',
+        'dailyPickupReminder'
+      ];
+
+      const STORAGE_KEYS_DATE = [
+        'coffeeAnniversaryDate',
+        'anniversaryDate',
+        'coffee-anniversary-date',
+        'coffee_anniversary_date',
+        'coffeeAnniversary'
+      ];
+
+      const DEFAULT_TIME = '08:00';
+      const DEFAULT_DATE = '2024-05-15';
+
+      // DOM Elements
+      const reminderInput = document.getElementById('pickup-reminder-time');
+      const anniversaryInput = document.getElementById('coffee-anniversary-date');
+      const reminderDisplay = document.getElementById('pickup-reminder-display');
+      const reminderRaw = document.getElementById('pickup-reminder-raw');
+      const anniversaryDisplay = document.getElementById('coffee-anniversary-display');
+      const anniversaryRaw = document.getElementById('coffee-anniversary-raw');
+      const form = document.getElementById('preferences-form');
+      const statusMsg = document.getElementById('save-status-msg');
+
+      /**
+       * Format time string (HH:mm) into 12-hour format (e.g. "8:00 AM").
+       * Strictly avoids Date object to prevent timezone or DST distortion.
+       */
+      function formatLocationAgnosticTime(timeStr) {
+        if (!timeStr || typeof timeStr !== 'string' || !timeStr.includes(':')) {
+          return timeStr || '';
+        }
+        const [hourStr, minStr] = timeStr.split(':');
+        let hour = parseInt(hourStr, 10);
+        const min = parseInt(minStr, 10);
+        if (isNaN(hour) || isNaN(min)) return timeStr;
+        const ampm = hour >= 12 ? 'PM' : 'AM';
+        const displayHour = hour % 12 || 12;
+        const displayMin = min < 10 ? '0' + min : min;
+        return `${displayHour}:${displayMin} ${ampm}`;
+      }
+
+      /**
+       * Format date string (YYYY-MM-DD) into readable format (e.g. "May 15, 2024").
+       * Avoids `new Date("YYYY-MM-DD")` which parses as UTC and shifts backwards in negative timezones.
+       */
+      function formatLocationAgnosticDate(dateStr) {
+        if (!dateStr || typeof dateStr !== 'string' || !dateStr.includes('-')) {
+          return dateStr || '';
+        }
+        const parts = dateStr.split('-');
+        if (parts.length !== 3) return dateStr;
+        const year = parseInt(parts[0], 10);
+        const month = parseInt(parts[1], 10);
+        const day = parseInt(parts[2], 10);
+        if (isNaN(year) || isNaN(month) || isNaN(day)) return dateStr;
+
+        const monthNames = [
+          'January', 'February', 'March', 'April', 'May', 'June',
+          'July', 'August', 'September', 'October', 'November', 'December'
+        ];
+        const monthName = monthNames[month - 1] || month;
+        return `${monthName} ${day}, ${year}`;
+      }
+
+      function loadStoredPreference(keys, fallback) {
+        try {
+          for (const key of keys) {
+            const val = localStorage.getItem(key);
+            if (val) return val;
+          }
+        } catch (e) {
+          // LocalStorage might be inaccessible in some sandboxed environments
+        }
+        return fallback;
+      }
+
+      function persistPreferences(timeVal, dateVal) {
+        try {
+          if (timeVal) {
+            STORAGE_KEYS_TIME.forEach(k => localStorage.setItem(k, timeVal));
+          }
+          if (dateVal) {
+            STORAGE_KEYS_DATE.forEach(k => localStorage.setItem(k, dateVal));
+          }
+        } catch (e) {
+          // Ignore storage errors
+        }
+      }
+
+      function updateUI() {
+        const timeVal = reminderInput.value || DEFAULT_TIME;
+        const dateVal = anniversaryInput.value || DEFAULT_DATE;
+
+        if (reminderDisplay) {
+          reminderDisplay.textContent = formatLocationAgnosticTime(timeVal);
+        }
+        if (reminderRaw) {
+          reminderRaw.textContent = timeVal;
+        }
+        if (anniversaryDisplay) {
+          anniversaryDisplay.textContent = formatLocationAgnosticDate(dateVal);
+        }
+        if (anniversaryRaw) {
+          anniversaryRaw.textContent = dateVal;
+        }
+
+        // Keep global properties updated
+        window.dailyPickupReminderTime = timeVal;
+        window.coffeeAnniversaryDate = dateVal;
+      }
+
+      function showSavedStatus() {
+        if (!statusMsg) return;
+        statusMsg.classList.add('visible');
+        clearTimeout(statusMsg._timeout);
+        statusMsg._timeout = setTimeout(() => {
+          statusMsg.classList.remove('visible');
+        }, 2500);
+      }
+
+      // Initialize values from storage or default
+      const initialTime = loadStoredPreference(STORAGE_KEYS_TIME, DEFAULT_TIME);
+      const initialDate = loadStoredPreference(STORAGE_KEYS_DATE, DEFAULT_DATE);
+
+      if (reminderInput) reminderInput.value = initialTime;
+      if (anniversaryInput) anniversaryInput.value = initialDate;
+      persistPreferences(initialTime, initialDate);
+      updateUI();
+
+      // Listen for user input
+      if (reminderInput) {
+        reminderInput.addEventListener('input', () => {
+          persistPreferences(reminderInput.value, anniversaryInput.value);
+          updateUI();
+        });
+        reminderInput.addEventListener('change', () => {
+          persistPreferences(reminderInput.value, anniversaryInput.value);
+          updateUI();
+        });
+      }
+
+      if (anniversaryInput) {
+        anniversaryInput.addEventListener('input', () => {
+          persistPreferences(reminderInput.value, anniversaryInput.value);
+          updateUI();
+        });
+        anniversaryInput.addEventListener('change', () => {
+          persistPreferences(reminderInput.value, anniversaryInput.value);
+          updateUI();
+        });
+      }
+
+      if (form) {
+        form.addEventListener('submit', (e) => {
+          e.preventDefault();
+          persistPreferences(reminderInput.value, anniversaryInput.value);
+          updateUI();
+          showSavedStatus();
+        });
+      }
+
+      // Expose helper methods on window for programmatic access or testing
+      window.DailyGrindPreferences = {
+        getTime: () => reminderInput.value,
+        setTime: (val) => {
+          reminderInput.value = val;
+          persistPreferences(val, anniversaryInput.value);
+          updateUI();
+        },
+        getDate: () => anniversaryInput.value,
+        setDate: (val) => {
+          anniversaryInput.value = val;
+          persistPreferences(reminderInput.value, val);
+          updateUI();
+        },
+        formatTime: formatLocationAgnosticTime,
+        formatDate: formatLocationAgnosticDate
+      };
+    })();
+  </script>
 </body>
 
