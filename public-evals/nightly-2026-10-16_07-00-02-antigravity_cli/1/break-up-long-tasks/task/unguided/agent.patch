+  <script>
+    function initSimulator() {
+      const startBtn = document.getElementById('start-btn');
+      const output = document.getElementById('output');
+      if (!startBtn || !output) return;
+
+      let isRunning = false;
+
+      function yieldToBrowser() {
+        return new Promise(resolve => setTimeout(resolve, 0));
+      }
+
+      function processBlend(index) {
+        const start = performance.now();
+        // Simulate ~2ms of processing work per recipe blend
+        while (performance.now() - start < 2) {
+          // busy wait
+        }
+      }
+
+      startBtn.addEventListener('click', async () => {
+        if (isRunning) return;
+        isRunning = true;
+
+        output.textContent = 'Processing...';
+        await yieldToBrowser();
+
+        const TOTAL_ITEMS = 1000;
+        const YIELD_INTERVAL_MS = 50;
+        let lastYieldTime = performance.now();
+
+        try {
+          for (let i = 0; i < TOTAL_ITEMS; i++) {
+            processBlend(i);
+
+            if (performance.now() - lastYieldTime >= YIELD_INTERVAL_MS) {
+              output.textContent = `Processed ${i + 1} of ${TOTAL_ITEMS}...`;
+              await yieldToBrowser();
+              lastYieldTime = performance.now();
+            }
+          }
+          output.textContent = 'Done! All items processed.';
+        } finally {
+          isRunning = false;
+        }
+      });
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initSimulator);
+    } else {
+      initSimulator();
+    }
+  </script>
