+    async function runSimulation() {
+      if (isRunning) return;
+      isRunning = true;
+
+      try {
+        output.textContent = 'Processing...';
+        await yieldToMain();
+
+        const TOTAL_ITEMS = 1000;
+        let deadline = performance.now() + 50;
+
+        for (let i = 1; i <= TOTAL_ITEMS; i++) {
+          processBlend(i);
+
+          if (performance.now() >= deadline) {
