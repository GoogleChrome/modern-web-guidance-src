+
+    .showcase-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
+      gap: 30px;
+    }
+
+    /* Nested Curve Parent */
+    .nested-curve-parent {
+      background: white;
+      border-radius: 28px;
+      padding: 24px;
+      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
+      /* Level 1 Fallback: clips roughly at padding box */
+      overflow: hidden;
+      overflow: clip;
+      overflow-clip-margin: content-box;
+      display: flex;
+      flex-direction: column;
+    }
+
+    @supports (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        /* MANDATORY: overflow: clip is required on non-replaced elements */
+        overflow: clip;
+        /* Automatically curves clipping edge to match inner content-box radius */
+        overflow-clip-margin: content-box;
+      }
+    }
+
+    .nested-curve-parent img {
+      width: 100%;
+      height: 200px;
+      object-fit: cover;
+      display: block;
+    }
+
+    .nested-curve-body {
+      padding: 16px 0;
+    }
+
+    .nested-curve-body h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .nested-curve-footer {
+      margin-top: auto;
+      background: var(--primary);
+      color: white;
+      padding: 14px;
+      text-align: center;
+      font-weight: 600;
+    }
+
+    /* Safety Zone Parent */
+    .safety-zone-parent {
+      background: white;
+      border-radius: 24px;
+      padding: 24px;
+      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
+      position: relative;
+      /* Level 1 Fallback */
+      overflow: hidden;
+      overflow: clip;
+      overflow-clip-margin: 15px;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+    }
+
+    @supports (overflow-clip-margin: 15px) {
+      .safety-zone-parent {
+        overflow: clip;
+        /* Establishes a visible safety zone allowing child element shadows to render safely outside */
+        overflow-clip-margin: 15px;
+      }
+    }
+
+    .safety-zone-parent .promo-tag {
+      display: inline-block;
+      align-self: flex-start;
+      background: var(--accent);
+      color: var(--primary);
+      font-weight: bold;
+      font-size: 0.75rem;
+      text-transform: uppercase;
+      padding: 4px 10px;
+      border-radius: 12px;
+      margin-bottom: 12px;
+    }
+
+    .safety-zone-parent h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .safety-zone-parent .overflow-text {
+      white-space: nowrap;
+      color: #6d4c41;
+      font-size: 0.95rem;
+      margin-bottom: 14px;
+    }
+
+    .glowing-btn {
+      display: inline-block;
+      text-align: center;
+      background: linear-gradient(135deg, #ffab40, #ff6d00);
+      color: #2e1c0c;
