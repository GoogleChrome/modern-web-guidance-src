+  <script>
+    let conditionalAbortController = null;
+    let isConditionalRunning = false;
+
+    function bufferToBase64Url(buffer) {
+      if (!buffer) return null;
+      if (typeof buffer === 'string') return buffer;
+      const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary)
+        .replace(/\+/g, '-')
+        .replace(/\//g, '_')
+        .replace(/=+$/, '');
+    }
+
+    function serializeCredential(cred) {
+      if (!cred) return null;
+      if (typeof cred.toJSON === 'function') {
+        try {
+          const json = cred.toJSON();
+          if (json && typeof json === 'object') {
+            return json;
+          }
+        } catch (_) {}
+      }
+
+      const response = cred.response || {};
+      return {
+        id: cred.id || (cred.rawId ? bufferToBase64Url(cred.rawId) : ''),
+        rawId: cred.rawId ? bufferToBase64Url(cred.rawId) : cred.id,
+        type: cred.type || 'public-key',
+        response: {
+          clientDataJSON: response.clientDataJSON ? bufferToBase64Url(response.clientDataJSON) : '',
+          authenticatorData: response.authenticatorData ? bufferToBase64Url(response.authenticatorData) : '',
+          signature: response.signature ? bufferToBase64Url(response.signature) : '',
+          userHandle: response.userHandle ? bufferToBase64Url(response.userHandle) : null,
+        },
+        clientExtensionResults: cred.getClientExtensionResults ? cred.getClientExtensionResults() : {},
+        authenticatorAttachment: cred.authenticatorAttachment || undefined,
+      };
+    }
+
+    function getPublicKeyOptions() {
+      const challenge = new Uint8Array(32);
+      window.crypto.getRandomValues(challenge);
+
+      const options = {
+        challenge: challenge,
+        timeout: 60000,
+        userVerification: 'preferred',
+      };
+
+      const hostname = window.location.hostname;
+      if (hostname && !/^[0-9.]+$/.test(hostname) && !hostname.includes(':')) {
+        options.rpId = hostname;
+      }
+
+      return options;
+    }
+
+    async function handleAuthSuccess(credential) {
+      const credentialJSON = serializeCredential(credential);
+      try {
+        const res = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify(credentialJSON),
+        });
+
+        const statusEl = document.querySelector('[data-testid="auth-status"]');
+
+        if (res.ok) {
+          let message = 'Success';
+          try {
+            const contentType = res.headers.get('content-type') || '';
+            if (contentType.includes('application/json')) {
+              const data = await res.json();
+              if (data && typeof data === 'object') {
+                if (data.message) {
+                  message = data.message;
+                } else if (data.status) {
+                  message = data.status.toLowerCase().includes('success') ? data.status : 'Success';
+                }
+              } else if (typeof data === 'string' && data) {
+                message = data;
+              }
+            } else {
+              const text = await res.text();
+              if (text && text.trim()) {
+                message = text.trim();
+              }
+            }
+          } catch (_) {}
+
+          if (statusEl) {
+            statusEl.textContent = message;
+            statusEl.className = 'auth-status success';
+          }
+        } else {
+          let errorMsg = 'Authentication failed';
+          try {
+            const errData = await res.json();
+            if (errData && errData.message) errorMsg = errData.message;
+          } catch (_) {}
+          if (statusEl) {
+            statusEl.textContent = errorMsg;
+            statusEl.className = 'auth-status error';
+          }
+        }
+      } catch (err) {
+        console.error('Failed to verify credential:', err);
+        const statusEl = document.querySelector('[data-testid="auth-status"]');
+        if (statusEl) {
+          statusEl.textContent = 'Verification error';
+          statusEl.className = 'auth-status error';
+        }
+      }
+    }
+
+    async function startConditionalAuth() {
+      if (isConditionalRunning) return;
+      if (!navigator.credentials || typeof navigator.credentials.get !== 'function') return;
+
+      if (window.PublicKeyCredential && typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+        try {
+          const available = await PublicKeyCredential.isConditionalMediationAvailable();
+          if (!available) return;
+        } catch (_) {}
+      }
+
+      if (conditionalAbortController) {
+        conditionalAbortController.abort();
+        conditionalAbortController = null;
+      }
+
+      conditionalAbortController = new AbortController();
+      isConditionalRunning = true;
+
+      try {
+        const credential = await navigator.credentials.get({
+          mediation: 'conditional',
+          publicKey: getPublicKeyOptions(),
+          signal: conditionalAbortController.signal,
+        });
+        isConditionalRunning = false;
+        conditionalAbortController = null;
+        if (credential) {
+          await handleAuthSuccess(credential);
+        }
+      } catch (err) {
+        isConditionalRunning = false;
+        conditionalAbortController = null;
+        if (err.name === 'AbortError') {
+          return;
+        }
+        console.warn('Conditional authentication error or cancelled:', err);
+      }
+    }
+
+    async function handleExplicitAuth() {
+      if (conditionalAbortController) {
+        conditionalAbortController.abort();
+        conditionalAbortController = null;
+      }
+      isConditionalRunning = false;
+
+      if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+        console.warn('WebAuthn is not supported');
+        return;
+      }
+
+      try {
+        const credential = await navigator.credentials.get({
+          publicKey: getPublicKeyOptions(),
+        });
+        if (credential) {
+          await handleAuthSuccess(credential);
+        }
+      } catch (err) {
+        if (err.name !== 'AbortError') {
+          console.warn('Explicit passkey authentication failed or cancelled:', err);
+        }
+        // Re-enable conditional UI if user cancelled or modal failed
+        startConditionalAuth();
+      }
+    }
+
+    function init() {
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authForm = document.getElementById('auth-form');
+
+      if (authButton) {
+        authButton.addEventListener('click', handleExplicitAuth);
+      }
+
+      if (usernameField) {
+        usernameField.addEventListener('focus', () => {
+          if (!isConditionalRunning) {
+            startConditionalAuth();
+          }
+        });
+      }
+
+      if (authForm) {
+        authForm.addEventListener('submit', (e) => {
+          e.preventDefault();
+          handleExplicitAuth();
+        });
+      }
+
+      startConditionalAuth();
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', init);
+    } else {
+      init();
+    }
+  </script>
