+  <script>
+    (function () {
+      // Feature detection for native CSS Scroll-Driven Animations
+      var supportsScrollTimeline = false;
+      try {
+        supportsScrollTimeline =
+          'animationTimeline' in document.documentElement.style ||
+          (window.CSS &&
+            window.CSS.supports &&
+            (window.CSS.supports('animation-timeline', 'scroll()') ||
+              window.CSS.supports('animation-timeline: scroll()')));
+      } catch (e) {
+        supportsScrollTimeline = false;
+      }
+
+      // Modern browsers with native scroll-driven animations handle this via CSS
+      if (supportsScrollTimeline) {
+        return;
+      }
+
+      // Fallback solution for older browsers (Firefox, Safari, older Chrome versions, etc.)
+      var nav = document.querySelector('nav');
+      if (!nav) return;
+      var logo = nav.querySelector('.logo');
+
+      var maxScroll = 120; // Scroll distance in pixels for full transition
+      var ticking = false;
+
+      function updateNavOnScroll() {
+        var scrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);
+
+        // Interpolate vertical padding and logo font size smoothly linked to scroll position
+        var startPad = 1.25;
+        var endPad = 0.45;
+        var currentPad = (startPad - (startPad - endPad) * progress).toFixed(3);
+
+        var startLogo = 1.5;
+        var endLogo = 1.15;
+        var currentLogo = (startLogo - (startLogo - endLogo) * progress).toFixed(3);
+
+        nav.style.paddingTop = currentPad + 'rem';
+        nav.style.paddingBottom = currentPad + 'rem';
+        if (logo) {
+          logo.style.fontSize = currentLogo + 'rem';
+        }
+
+        var shadowAlpha = (0.2 * progress).toFixed(3);
+        nav.style.boxShadow = progress > 0 ? '0 4px 12px rgba(0, 0, 0, ' + shadowAlpha + ')' : 'none';
+
+        if (scrollY > 60) {
+          nav.classList.add('scrolled');
+        } else {
+          nav.classList.remove('scrolled');
+        }
+
+        ticking = false;
+      }
+
+      var raf = window.requestAnimationFrame || function (callback) { return setTimeout(callback, 1000 / 60); };
+
+      window.addEventListener('scroll', function () {
+        if (!ticking) {
+          raf(updateNavOnScroll);
+          ticking = true;
+        }
+      }, { passive: true });
+
+      window.addEventListener('resize', function () {
+        if (!ticking) {
+          raf(updateNavOnScroll);
+          ticking = true;
+        }
+      }, { passive: true });
+
+      // Run on initial load in case user is reloaded mid-page
+      updateNavOnScroll();
+    })();
+  </script>
+
