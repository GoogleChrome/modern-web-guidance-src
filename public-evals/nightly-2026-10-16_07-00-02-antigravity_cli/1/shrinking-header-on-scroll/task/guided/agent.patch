+  <script>
+    // Fallback for browsers that don't support scroll-driven animations
+    if (!('CSS' in window && CSS.supports && CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)'))) {
+      const nav = document.querySelector('nav');
+      if (nav) {
+        const initialHeight = 80;
+        const finalHeight = 50;
+        const scrollDistance = 150;
+
+        const updateNavHeight = () => {
+          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+            nav.style.height = `${initialHeight}px`;
+            return;
+          }
+          const scrollY = window.scrollY;
+          const scrollPercent = Math.min(1, Math.max(0, scrollY / scrollDistance));
+          const newHeight = initialHeight - (initialHeight - finalHeight) * scrollPercent;
+          nav.style.height = `${newHeight}px`;
+          nav.style.boxShadow = `0 ${2 + 2 * scrollPercent}px ${5 + 7 * scrollPercent}px rgba(0, 0, 0, ${0.1 + 0.2 * scrollPercent})`;
+        };
+
+        window.addEventListener('scroll', updateNavHeight, { passive: true });
+        updateNavHeight();
+      }
+    }
+  </script>
