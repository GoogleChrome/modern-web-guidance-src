diff --git a/src/layouts/Layout.astro b/src/layouts/Layout.astro
index dcf9696..13c2b2a 100644
--- a/src/layouts/Layout.astro
+++ b/src/layouts/Layout.astro
@@ -12,6 +12,10 @@ export interface Props {
 
 const { title } = Astro.props;
 const baseUrl = import.meta.env.BASE_URL;
+
+const rawPathname = Astro.url.pathname;
+const normalizedPath = rawPathname.replace(/\/+$/, '') || '/';
+const viewId = 'view-' + (normalizedPath.replace(/[^a-zA-Z0-9_-]/g, '_') || 'root');
 ---
 
 <!doctype html>
@@ -45,11 +49,102 @@ const baseUrl = import.meta.env.BASE_URL;
         <div>
           <Header />
         </div>
-        <main class="bg-white relative">
-          <slot />
+        <main class="bg-white relative" id="spa-view-container">
+          <div
+            id={viewId}
+            class="spa-view"
+            data-view-id={viewId}
+            data-view-path={normalizedPath}
+            tabindex="-1"
+          >
+            <slot />
+          </div>
         </main>
       </div>
     </div>
     <Footer />
+    <script>
+      import { swapFunctions } from 'astro:transitions/client';
+
+      const MAX_CACHED_VIEWS = 8;
+      const lruOrder: string[] = [];
+
+      function updateLru(viewId: string) {
+        const index = lruOrder.indexOf(viewId);
+        if (index !== -1) {
+          lruOrder.splice(index, 1);
+        }
+        lruOrder.push(viewId);
+      }
+
+      function addToLru(viewId: string) {
+        updateLru(viewId);
+        while (lruOrder.length > MAX_CACHED_VIEWS) {
+          const evictId = lruOrder.shift();
+          if (evictId && evictId !== viewId) {
+            const el = document.getElementById(evictId);
+            if (el && el.classList.contains('inactive')) {
+              el.remove();
+            }
+          }
+        }
+      }
+
+      function switchToView(viewId: string) {
+        // Hide all views
+        document.querySelectorAll('.spa-view').forEach(view => {
+          view.classList.add('inactive');
+          view.setAttribute('aria-hidden', 'true');
+        });
+
+        // Show the target view
+        const activeView = document.getElementById(viewId);
+        if (activeView) {
+          activeView.classList.remove('inactive');
+          activeView.setAttribute('aria-hidden', 'false');
+
+          // MANDATORY: Move focus to the new view to ensure a logical tab-order
+          activeView.focus();
+        }
+      }
+
+      // Initialize LRU cache with the initial active view
+      const initialView = document.querySelector('#spa-view-container > .spa-view:not(.inactive)');
+      if (initialView && initialView.id) {
+        updateLru(initialView.id);
+      }
+
+      document.addEventListener('astro:before-swap', (event: any) => {
+        event.swap = () => {
+          // Deselect scripts and swap head and root attributes
+          swapFunctions.deselectScripts(event.newDocument);
+          swapFunctions.swapRootAttributes(event.newDocument);
+          swapFunctions.swapHeadElements(event.newDocument);
+
+          const container = document.getElementById('spa-view-container');
+          const incomingView = event.newDocument.querySelector('#spa-view-container > .spa-view');
+
+          if (container && incomingView) {
+            const targetViewId = incomingView.id;
+            const existingView = document.getElementById(targetViewId);
+
+            if (existingView && container.contains(existingView)) {
+              // The view's structural DOM state was preserved in memory.
+              // Instantly restore and focus without destroying or rebuilding.
+              switchToView(targetViewId);
+              updateLru(targetViewId);
+            } else {
+              // First visit to this view: append to container and activate
+              container.appendChild(incomingView);
+              switchToView(targetViewId);
+              addToLru(targetViewId);
+            }
+          } else {
+            // Fallback for document structures without the view container
+            swapFunctions.swapBodyElement(event.newDocument.body, document.body);
+          }
+        };
+      });
+    </script>
   </body>
 </html>
diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..24350ce 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,26 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
+}
+
+.spa-view {
+  width: 100%;
+}
+
+.spa-view:focus {
+  outline: none;
+}
+
+.spa-view.inactive {
+  /* MANDATORY: Use hidden to cache the rendering state of inactive views */
+  content-visibility: hidden;
+
+  /* Optional: Prevent hidden views from taking up physical space in layout flow */
+  position: absolute;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
