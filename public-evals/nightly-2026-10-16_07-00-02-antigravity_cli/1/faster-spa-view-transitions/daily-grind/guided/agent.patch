+    const viewAccessHistory = [];
+
+    function recordViewAccess(viewId) {
+      const idx = viewAccessHistory.indexOf(viewId);
+      if (idx !== -1) {
+        viewAccessHistory.splice(idx, 1);
+      }
+      viewAccessHistory.push(viewId);
+
+      // Evict least recently used dynamically created view if threshold exceeded
+      const dynamicViews = Array.from(document.querySelectorAll('.spa-view[data-dynamic="true"]'));
+      if (dynamicViews.length > MAX_DYNAMIC_VIEWS) {
+        for (const id of viewAccessHistory) {
+          const el = document.getElementById(id);
+          if (el && el.getAttribute('data-dynamic') === 'true' && el.classList.contains('inactive')) {
+            el.remove();
+            const removeIdx = viewAccessHistory.indexOf(id);
+            if (removeIdx !== -1) viewAccessHistory.splice(removeIdx, 1);
+            break;
+          }
+        }
+      }
+    }
+
+    function resolveViewId(pathOrId) {
+      if (!pathOrId) return 'view-home';
+      if (routes[pathOrId]) return routes[pathOrId];
+      const cleaned = pathOrId.replace(/\/index\.html$/, '').replace(/\/$/, '') || '/';
+      if (routes[cleaned]) return routes[cleaned];
+      if (document.getElementById(pathOrId)) return pathOrId;
+      if (document.getElementById(`view-${pathOrId}`)) return `view-${pathOrId}`;
+      if (pathOrId.startsWith('view-') && document.getElementById(pathOrId.slice(5))) return pathOrId.slice(5);
+      return 'view-home';
+    }
+
+    function switchToView(viewId) {
+      // Hide all views
+      document.querySelectorAll('.spa-view').forEach(view => {
+        view.classList.add('inactive');
+        view.setAttribute('aria-hidden', 'true');
+      });
+
+      // Show the target view
+      let activeView = typeof viewId === 'string' ? document.getElementById(viewId) : viewId;
+      if (!activeView && typeof viewId === 'string') {
+        const resolvedId = resolveViewId(viewId);
+        activeView = document.getElementById(resolvedId);
+      }
+
+      if (activeView) {
+        activeView.classList.remove('inactive');
+        activeView.setAttribute('aria-hidden', 'false');
+
+        // MANDATORY: Move focus to the new view to ensure a logical tab-order
+        activeView.focus();
+
+        if (activeView.id) {
+          recordViewAccess(activeView.id);
+        }
+      }
+    }
+
+    function navigateTo(url, push = true) {
+      let path;
+      try {
+        const origin = (typeof window !== 'undefined' && window.location && window.location.origin) ? window.location.origin : 'http://localhost';
+        path = new URL(url, origin).pathname;
+      } catch {
+        path = url;
+      }
+      const viewId = resolveViewId(path);
+      switchToView(viewId);
+      if (push && typeof window !== 'undefined' && window.location && window.location.pathname !== path) {
+        if (typeof history !== 'undefined' && history.pushState) {
+          history.pushState(null, '', path);
+        }
+      }
+    }
+
+    // Expose helpers globally
+    window.switchToView = switchToView;
+    window.navigateTo = navigateTo;
+
+    // Intercept navigation link clicks for SPA routing
+    document.addEventListener('click', (e) => {
+      const link = e.target.closest('a');
+      if (!link) return;
+      const href = link.getAttribute('href');
+      if (!href) return;
+
+      if (
+        href.startsWith('http://') ||
+        href.startsWith('https://') ||
+        href.startsWith('//') ||
+        href.startsWith('mailto:') ||
+        href.startsWith('tel:') ||
+        href.startsWith('#')
+      ) {
+        return;
+      }
+
+      e.preventDefault();
+      navigateTo(href);
+    });
+
+    // Handle browser forward/back navigation
+    window.addEventListener('popstate', () => {
+      const path = (window.location && window.location.pathname) || '/';
+      navigateTo(path, false);
+    });
+
+    // Initialize initial route
+    function init() {
+      const path = (typeof window !== 'undefined' && window.location && window.location.pathname) || '/';
+      if (path && path !== '/' && path !== '/index.html') {
+        navigateTo(path, false);
+      } else {
+        switchToView('view-home');
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', init);
+    } else {
+      init();
+    }
+  </script>
+
