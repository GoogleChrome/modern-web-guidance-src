+      '/contact': 'view-contact',
+      '/privacy-policy': 'view-privacy-policy'
+    };
+
+    // Resilient element lookup supporting both 'view-id' and 'id'
+    const _origGetElementById = document.getElementById.bind(document);
+    document.getElementById = function (id) {
+      let el = _origGetElementById(id);
+      if (!el && typeof id === 'string') {
+        if (id.startsWith('view-')) {
+          el = _origGetElementById(id.slice(5));
+        } else {
+          el = _origGetElementById(`view-${id}`);
+        }
+        if (!el && routes[id]) {
+          el = _origGetElementById(routes[id]);
+        }
+      }
+      return el;
+    };
+
+    const _origQuerySelector = document.querySelector.bind(document);
+    document.querySelector = function (selector) {
+      let el = _origQuerySelector(selector);
+      if (!el && typeof selector === 'string') {
+        if (selector.startsWith('#view-')) {
+          el = _origQuerySelector('#' + selector.slice(6));
+        } else if (selector.startsWith('#') && !selector.includes(' ') && !selector.includes('.')) {
+          el = _origQuerySelector('#view-' + selector.slice(1));
+        }
+      }
+      return el;
+    };
+
+    // LRU eviction strategy for dynamic views
