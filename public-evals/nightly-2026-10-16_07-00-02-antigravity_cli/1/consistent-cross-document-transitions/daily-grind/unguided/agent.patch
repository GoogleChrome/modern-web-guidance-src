diff --git a/js/critical-init.js b/js/critical-init.js
new file mode 100644
index 0000000..977e69e
--- /dev/null
+++ b/js/critical-init.js
@@ -0,0 +1,17 @@
+/**
+ * Critical page state initialization.
+ * Loaded with blocking="render" in <head> to ensure state is stable
+ * before the browser captures the initial transition snapshot or performs first paint.
+ */
+(function () {
+  'use strict';
+  
+  // Apply saved theme or system preference
+  const savedTheme = localStorage.getItem('theme');
+  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
+  const theme = savedTheme || (prefersDark ? 'dark' : 'light');
+  document.documentElement.dataset.theme = theme;
+
+  // Mark critical page state as ready and stable
+  document.documentElement.dataset.pageState = 'stable';
+})();
diff --git a/js/transition-setup.js b/js/transition-setup.js
new file mode 100644
index 0000000..a684e2f
--- /dev/null
+++ b/js/transition-setup.js
@@ -0,0 +1,60 @@
+/**
+ * Transition Setup & Lifecycle Management.
+ * Registered in <head> with blocking="render" to ensure listeners are active
+ * before the incoming document's first rendering opportunity.
+ */
+
+// Incoming page reveal event
+window.addEventListener('pagereveal', async (event) => {
+  if (!event.viewTransition) return;
+
+  const transition = event.viewTransition;
+  const from = window.navigation?.activation?.from;
+  const entry = window.navigation?.activation?.entry;
+
+  // Accessibility focus management: update focus to the main heading after transition
+  const focusTarget = document.querySelector('main h1, .page-header h1, .hero h1, #main-content');
+  if (focusTarget && !focusTarget.hasAttribute('tabindex')) {
+    focusTarget.setAttribute('tabindex', '-1');
+  }
+
+  try {
+    await transition.ready;
+    // Shift focus programmatically to prevent abandoned keyboard focus
+    if (focusTarget) {
+      focusTarget.focus({ preventScroll: true });
+    }
+  } catch (error) {
+    // Skipped view transitions reject `ready` with InvalidStateError
+    if (error.name !== 'InvalidStateError') {
+      console.warn('View transition ready error:', error);
+    }
+  } finally {
+    // MANDATORY bfcache compatibility: wait for transition to finish
+    // and clean up any dynamically assigned transition names
+    try {
+      await transition.finished;
+    } catch (e) {
+      // Ignore transition finish errors
+    }
+
+    // Clean up temporary inline view-transition-names
+    const elementsWithTemporaryNames = document.querySelectorAll('[data-temporary-vt-name]');
+    for (const el of elementsWithTemporaryNames) {
+      el.style.viewTransitionName = '';
+      el.removeAttribute('data-temporary-vt-name');
+    }
+  }
+});
+
+// Outgoing page swap event
+window.addEventListener('pageswap', async (event) => {
+  if (!event.viewTransition) return;
+
+  // Additional outgoing transition configuration if needed
+  try {
+    await event.viewTransition.finished;
+  } catch (e) {
+    // Ignore finish error
+  }
+});
