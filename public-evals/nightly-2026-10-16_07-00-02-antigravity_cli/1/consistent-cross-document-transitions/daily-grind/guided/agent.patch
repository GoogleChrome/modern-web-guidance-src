diff --git a/css/styles.css b/css/styles.css
new file mode 100644
index 0000000..885576b
--- /dev/null
+++ b/css/styles.css
@@ -0,0 +1,396 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+}
+
+main {
+  flex: 1;
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+  view-transition-name: main-nav;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+  color: white;
+  text-decoration: none;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+  align-items: center;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover,
+nav a.active {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  min-height: 50vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 60px 20px;
+}
+
+.hero-compact {
+  min-height: 35vh;
+  padding: 40px 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+.hero p {
+  font-size: 1.2rem;
+  max-width: 600px;
+  margin-bottom: 1.5rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+  width: 100%;
+}
+
+.section-title {
+  text-align: center;
+  margin-bottom: 10px;
+  color: var(--primary);
+  font-size: 2rem;
+}
+
+.section-subtitle {
+  text-align: center;
+  margin-bottom: 30px;
+  color: #6d4c41;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: 30px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+  text-align: center;
+  transition: transform 0.2s, box-shadow 0.2s;
+}
+
+.card:hover {
+  transform: translateY(-4px);
+  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
+}
+
+.card-img-wrap {
+  width: 100%;
+  height: 220px;
+  background-color: #e0d7d3;
+  overflow: hidden;
+}
+
+.card-img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  display: block;
+  aspect-ratio: 300 / 220;
+}
+
+.card-content {
+  padding: 20px;
+  display: flex;
+  flex-direction: column;
+  flex: 1;
+  justify-content: space-between;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+  font-size: 1.3rem;
+}
+
+.card p {
+  color: #5d4037;
+  margin-bottom: 15px;
+}
+
+.card .price-tag {
+  font-weight: bold;
+  color: var(--accent);
+  font-size: 1.1rem;
+  margin-bottom: 10px;
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 24px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 10px;
+  font-weight: 500;
+  transition: background 0.3s;
+  align-self: center;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+.btn-secondary {
+  background: transparent;
+  border: 2px solid var(--primary);
+  color: var(--primary);
+}
+
+.btn-secondary:hover {
+  background: var(--primary);
+  color: white;
+}
+
+/* Product Detail View */
+.product-detail-container {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 50px;
+  align-items: center;
+  background: white;
+  padding: 40px;
+  border-radius: 12px;
+  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
+  margin-top: 20px;
+}
+
+@media (max-width: 768px) {
+  .product-detail-container {
+    grid-template-columns: 1fr;
+    padding: 20px;
+    gap: 30px;
+  }
+}
+
+.product-hero-img-wrap {
+  width: 100%;
+  border-radius: 8px;
+  overflow: hidden;
+  background-color: #e0d7d3;
+}
+
+.product-hero-img {
+  width: 100%;
+  height: auto;
+  max-height: 450px;
+  object-fit: cover;
+  display: block;
+  aspect-ratio: 600 / 450;
+}
+
+.product-info h1 {
+  font-size: 2.4rem;
+  color: var(--primary);
+  margin-bottom: 10px;
+}
+
+.product-info .price {
+  font-size: 1.6rem;
+  color: #b76e00;
+  font-weight: bold;
+  margin-bottom: 20px;
+}
+
+.product-info .description {
+  font-size: 1.1rem;
+  line-height: 1.8;
+  margin-bottom: 25px;
+  color: #4e342e;
+}
+
+.product-actions {
+  display: flex;
+  gap: 15px;
+  align-items: center;
+}
+
+/* Content blocks */
+.content-box {
+  background: white;
+  padding: 30px;
+  border-radius: 8px;
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
+  margin-bottom: 30px;
+}
+
+.content-box h2 {
+  color: var(--primary);
+  margin-bottom: 15px;
+}
+
+.content-box p {
+  margin-bottom: 15px;
+  line-height: 1.7;
+}
+
+/* Footer */
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: auto;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.footer-links a:hover {
+  text-decoration: underline;
+}
+
+/* Cross-Document View Transitions Opt-in */
+@view-transition {
+  navigation: auto;
+}
+
+/* Reduced motion preference */
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+}
+
+/* Root transitions */
+::view-transition-old(root),
+::view-transition-new(root) {
+  animation-duration: 0.3s;
+  animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+/* Persistent Shared Elements */
+nav {
+  view-transition-name: main-nav;
+}
+
+::view-transition-group(main-nav) {
+  animation-duration: 0.2s;
+}
+
+/* Product morph transitions between cards and detail view */
+.card-maple .card-img,
+.detail-maple .product-hero-img {
+  view-transition-name: product-img-maple;
+}
+
+.card-maple .card-title,
+.detail-maple .product-hero-title {
+  view-transition-name: product-title-maple;
+}
+
+.card-espresso .card-img,
+.detail-espresso .product-hero-img {
+  view-transition-name: product-img-espresso;
+}
+
+.card-espresso .card-title,
+.detail-espresso .product-hero-title {
+  view-transition-name: product-title-espresso;
+}
+
+.card-cold-brew .card-img,
+.detail-cold-brew .product-hero-img {
+  view-transition-name: product-img-cold-brew;
+}
+
+.card-cold-brew .card-title,
+.detail-cold-brew .product-hero-title {
+  view-transition-name: product-title-cold-brew;
+}
+
+::view-transition-group(product-img-maple),
+::view-transition-group(product-img-espresso),
+::view-transition-group(product-img-cold-brew),
+::view-transition-group(product-title-maple),
+::view-transition-group(product-title-espresso),
+::view-transition-group(product-title-cold-brew) {
+  animation-duration: 0.35s;
+  animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
+}
