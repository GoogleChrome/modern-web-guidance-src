--- /dev/null
+++ b/js/transition-setup.js
@@ -0,0 +1,27 @@
+// Critical script executed before transition initiation and render
+// Ensures pagereveal listener is registered before initial render
+window.addEventListener('pagereveal', async (event) => {
+  if (!event.viewTransition) return;
+
+  const from = window.navigation?.activation?.from;
+  if (from) {
+    try {
+      const fromUrl = new URL(from.url);
+      // Navigation context available if custom dynamic transition types or names are needed
+    } catch {
+      // Ignore URL parsing errors
+    }
+  }
+
+  try {
+    await event.viewTransition.ready;
+  } catch (error) {
+    // Skipped view transitions reject `ready` with InvalidStateError
+    if (error.name !== 'InvalidStateError') {
+      console.warn('View transition error:', error);
+    }
+  } finally {
+    // MANDATORY: Wait for finished to ensure clean state and preserve bfcache compatibility
+    await event.viewTransition.finished;
+  }
+});
