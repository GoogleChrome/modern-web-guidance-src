+  <script src="./node_modules/@js-temporal/polyfill/dist/index.umd.js"></script>
+  <script type="module">
+    // Ensure Temporal API is available (natively or polyfilled)
+    if (typeof Temporal === 'undefined') {
+      if (typeof temporal !== 'undefined' && temporal.Temporal) {
+        globalThis.Temporal = temporal.Temporal;
+      } else {
+        try {
+          const mod = await import('https://esm.sh/@js-temporal/polyfill');
+          globalThis.Temporal = mod.Temporal;
+          if (mod.toTemporalInstant) Date.prototype.toTemporalInstant = mod.toTemporalInstant;
+        } catch (e) {
+          try {
+            const mod = await import('./node_modules/@js-temporal/polyfill/dist/index.esm.js');
+            globalThis.Temporal = mod.Temporal;
+            if (mod.toTemporalInstant) Date.prototype.toTemporalInstant = mod.toTemporalInstant;
+          } catch (err) {
+            console.error('Could not load Temporal API polyfill:', err);
+          }
+        }
+      }
+    }
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const hostWarning = document.getElementById('hostWarning');
+    const grid = document.getElementById('grid');
+
+    const targetTimezones = [
+      { name: 'New York', tz: 'America/New_York' },
+      { name: 'London', tz: 'Europe/London' },
+      { name: 'Tokyo', tz: 'Asia/Tokyo' },
+      { name: 'UTC', tz: 'UTC' }
+    ];
+
+    function formatTime(zdt) {
+      const hour = zdt.hour;
+      const minute = zdt.minute;
+      const period = hour >= 12 ? 'PM' : 'AM';
+      const displayHour = hour % 12 || 12;
+      const displayMin = String(minute).padStart(2, '0');
+      return `${displayHour}:${displayMin} ${period}`;
+    }
+
+    function formatDate(zdt) {
+      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
+      return `${months[zdt.month - 1]} ${zdt.day}, ${zdt.year}`;
+    }
+
+    function updateScheduler() {
+      const dateVal = dateInput.value;
+      const timeVal = timeInput.value;
+      const hostTz = hostTzSelect.value;
+
+      if (!dateVal || !timeVal || !hostTz) {
+        grid.innerHTML = '';
+        hostWarning.style.display = 'none';
+        hostWarning.textContent = '';
+        return;
+      }
+
+      // Construct timezone-aware ISO string (RFC 9557 format)
+      const inputStr = `${dateVal}T${timeVal}[${hostTz}]`;
+
+      // Detect DST conflict (gap or overlap) using disambiguation: 'reject'
+      let hasConflict = false;
+      try {
+        Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'reject' });
+      } catch (e) {
+        if (e instanceof RangeError) {
+          hasConflict = true;
+        }
+      }
+
+      // Safely resolve the host time using compatible disambiguation (default standard)
+      // Temporal.ZonedDateTime objects are immutable
+      const hostZdt = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'compatible' });
+
+      if (hasConflict) {
+        const earlierZdt = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'earlier' });
+        const laterZdt = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'later' });
+        const isGap = !earlierZdt.toPlainTime().equals(laterZdt.toPlainTime());
+        const resolvedTimeStr = formatTime(hostZdt);
+
+        if (isGap) {
+          hostWarning.textContent = `Daylight Saving Time Gap Detected: The selected time (${timeVal}) does not exist in ${hostTz} due to a clock change transition gap (spring forward). The session time was resolved forward to ${resolvedTimeStr} (${hostZdt.offset}) using compatible disambiguation.`;
+        } else {
+          hostWarning.textContent = `Daylight Saving Time Overlap Detected: The selected time (${timeVal}) is ambiguous because it occurs twice in ${hostTz} during a clock change transition overlap (fall back). The session time was resolved to the earlier occurrence at ${resolvedTimeStr} (${hostZdt.offset}) using compatible disambiguation.`;
+        }
+        hostWarning.style.display = 'block';
+      } else {
+        hostWarning.textContent = '';
+        hostWarning.style.display = 'none';
+      }
+
+      // Convert target times safely and immutably using .withTimeZone()
+      grid.innerHTML = '';
+      for (const target of targetTimezones) {
+        // Built-in timezone conversion method; treats hostZdt as immutable
+        const targetZdt = hostZdt.withTimeZone(target.tz);
+        const formattedTime = formatTime(targetZdt);
+        const formattedDate = formatDate(targetZdt);
+
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.innerHTML = `
+          <h3>${target.name}</h3>
+          <span class="tz-zone-tag">${target.tz}</span>
+          <div class="tz-time">${formattedTime}</div>
+          <div class="tz-details">
+            <span class="tz-date">${formattedDate}</span>
+            <span class="tz-offset">${targetZdt.offset}</span>
+          </div>
+        `;
+        grid.appendChild(card);
+      }
+    }
+
+    dateInput.addEventListener('input', updateScheduler);
+    timeInput.addEventListener('input', updateScheduler);
+    hostTzSelect.addEventListener('change', updateScheduler);
+
+    // Initial render
+    updateScheduler();
+  </script>
