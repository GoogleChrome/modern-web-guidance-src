+  <script src="temporal-polyfill.js"></script>
+  <script>
+    (function () {
+      // Ensure Temporal API is available (natively or polyfilled)
+      const TemporalObj = (typeof Temporal !== 'undefined')
+        ? Temporal
+        : (typeof window !== 'undefined' && window.temporal?.Temporal)
+          ? window.temporal.Temporal
+          : null;
+
+      if (!TemporalObj) {
+        console.error('Temporal API is not available.');
+        return;
+      }
+
+      // 4 target timezones required: New York, London, Tokyo, UTC
+      const TARGET_TIMEZONES = [
+        { id: 'America/New_York', city: 'New York', label: 'New York (ET)' },
+        { id: 'Europe/London', city: 'London', label: 'London (GMT/BST)' },
+        { id: 'Asia/Tokyo', city: 'Tokyo', label: 'Tokyo (JST)' },
+        { id: 'UTC', city: 'UTC', label: 'UTC' }
+      ];
+
+      const dayNames = ['', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
+      const monthNames = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
+
+      // Format time safely as 12-hour AM/PM format (e.g. "3:00 AM")
+      function formatTime(zdtOrPlain) {
+        const hour = zdtOrPlain.hour;
+        const minute = zdtOrPlain.minute;
+        const h = hour % 12 || 12;
+        const m = String(minute).padStart(2, '0');
+        const ampm = hour >= 12 ? 'PM' : 'AM';
+        return `${h}:${m} ${ampm}`;
+      }
+
+      // Format date for each card display
+      function formatDate(zdt) {
+        return `${dayNames[zdt.dayOfWeek]}, ${monthNames[zdt.month]} ${zdt.day}, ${zdt.year}`;
+      }
+
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      function updateSchedule() {
+        const dateStr = dateInput.value;
+        const timeStr = timeInput.value;
+        const hostTz = hostTzSelect.value;
+
+        if (!dateStr || !timeStr || !hostTz) {
+          return;
+        }
+
+        // Parse date and time into a modern, native PlainDateTime object
+        const plainDateTime = TemporalObj.PlainDateTime.from(`${dateStr}T${timeStr}`);
+
+        let hostZonedDateTime;
+        let conflictMessage = null;
+
+        // Detect ambiguity or gap using disambiguation: 'reject'
+        try {
+          hostZonedDateTime = plainDateTime.toZonedDateTime(hostTz, { disambiguation: 'reject' });
+        } catch (err) {
+          // Conflict detected! Resolve safely with 'compatible' (standard RFC/Temporal disambiguation)
+          // The underlying time-zone-aware object is treated as immutable
+          hostZonedDateTime = plainDateTime.toZonedDateTime(hostTz, { disambiguation: 'compatible' });
+
+          const isGap = !hostZonedDateTime.toPlainDateTime().equals(plainDateTime);
+          if (isGap) {
+            // Gap (skipped time during spring forward transition)
+            const resolvedTime = formatTime(hostZonedDateTime);
+            conflictMessage = `⚠️ Daylight Saving Time Gap: ${formatTime(plainDateTime)} does not exist in ${hostTz} due to clocks springing forward. The time was automatically resolved forward to ${resolvedTime} (${hostZonedDateTime.offset}).`;
+          } else {
+            // Overlap (ambiguous time during fall back transition)
+            const earlierZdt = plainDateTime.toZonedDateTime(hostTz, { disambiguation: 'earlier' });
+            const laterZdt = plainDateTime.toZonedDateTime(hostTz, { disambiguation: 'later' });
+            conflictMessage = `⚠️ Daylight Saving Time Overlap: ${formatTime(plainDateTime)} is ambiguous in ${hostTz} because clocks fall back, repeating this local time. It was resolved using the earlier daylight saving offset (${earlierZdt.offset}) rather than standard time (${laterZdt.offset}).`;
+          }
+        }
+
+        // Show or clear the conflict explanation warning
+        if (conflictMessage) {
+          hostWarning.textContent = conflictMessage;
+          hostWarning.style.display = 'block';
+        } else {
+          hostWarning.textContent = '';
+          hostWarning.style.display = 'none';
+        }
+
+        // Clear existing cards
+        grid.innerHTML = '';
+
+        // Calculate equivalent times for New York, London, Tokyo, and UTC
+        // using built-in .withTimeZone() - each returns a new immutable ZonedDateTime instance
+        TARGET_TIMEZONES.forEach(target => {
+          const targetZdt = hostZonedDateTime.withTimeZone(target.id);
+          const isHost = (target.id === hostTz);
+
+          const card = document.createElement('div');
+          card.className = `card tasting-card${isHost ? ' is-host' : ''}`;
+          card.setAttribute('data-timezone', target.id);
+
+          const badge = document.createElement('div');
+          badge.className = 'card-badge';
+          badge.textContent = isHost ? `★ Host (${target.label})` : target.label;
+
+          const title = document.createElement('h3');
+          title.textContent = target.city;
+
+          const timeDisplay = document.createElement('div');
+          timeDisplay.className = 'time-display';
+          timeDisplay.textContent = formatTime(targetZdt);
+
+          const dateDisplay = document.createElement('div');
+          dateDisplay.className = 'date-display';
+          dateDisplay.textContent = formatDate(targetZdt);
+
+          const offsetDisplay = document.createElement('div');
+          offsetDisplay.className = 'offset-display';
+          offsetDisplay.textContent = `${target.id} (${targetZdt.offset})`;
+
+          card.appendChild(badge);
+          card.appendChild(title);
+          card.appendChild(timeDisplay);
+          card.appendChild(dateDisplay);
+          card.appendChild(offsetDisplay);
+
+          grid.appendChild(card);
+        });
+      }
+
+      // Event listeners for dynamic recalculation
+      dateInput.addEventListener('input', updateSchedule);
+      dateInput.addEventListener('change', updateSchedule);
+      timeInput.addEventListener('input', updateSchedule);
+      timeInput.addEventListener('change', updateSchedule);
+      hostTzSelect.addEventListener('change', updateSchedule);
+
+      // Initial calculation
+      updateSchedule();
+    })();
+  </script>
 </body>
 
