+  <script>
+    (function () {
+      const itemsData = {
+        'maple-oat-latte': {
+          id: 'maple-oat-latte',
+          title: 'Maple Oat Latte',
+          shortDesc: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          description: 'A comforting blend of freshly pulled espresso, steamed creamy oat milk, and pure Grade A Vermont maple syrup, finished with a subtle dust of organic cinnamon. Sweet, smooth, and naturally dairy-free.',
+          price: '$5.75',
+          calories: '210 cal',
+          roast: 'Medium Roast',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1200&q=80'
+        },
+        'dark-roast-espresso': {
+          id: 'dark-roast-espresso',
+          title: 'Dark Roast Espresso',
+          shortDesc: 'Bold, smokey, and perfect for a morning boost.',
+          description: 'Handcrafted double shot of our signature Italian roast blend. Delivers a thick golden crema layered over deep tasting notes of roasted walnut, dark cocoa, and caramelized molasses.',
+          price: '$4.25',
+          calories: '10 cal',
+          roast: 'Dark Roast',
+          image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=1200&q=80'
+        },
+        'cold-brew': {
+          id: 'cold-brew',
+          title: 'Cold Brew',
+          shortDesc: 'Steeped for 18 hours for maximum smoothness.',
+          description: 'Coarse-ground single-origin beans steeped in triple-filtered cold water for 18 hours. This low-and-slow extraction reveals natural chocolate and stone fruit sweetness with ultra-low acidity.',
+          price: '$4.95',
+          calories: '5 cal',
+          roast: 'Medium-Dark',
+          image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=1200&q=80'
+        }
+      };
+
+      const listPage = document.getElementById('list-page');
+      const detailPage = document.getElementById('detail-page');
+      const listHeading = document.getElementById('list-heading');
+      const detailTitle = document.getElementById('title');
+      const detailHeroImg = document.getElementById('detail-hero-img');
+      const detailDesc = document.getElementById('detail-desc');
+      const detailPrice = document.getElementById('detail-price');
+      const detailCalories = document.getElementById('detail-calories');
+      const detailRoast = document.getElementById('detail-roast');
+      const backButton = document.getElementById('back-button');
+      const thumbnails = document.querySelectorAll('.thumbnail');
+
+      function updateDetailContent(item) {
+        detailTitle.textContent = item.title;
+        detailHeroImg.src = item.image;
+        detailHeroImg.alt = item.title;
+        detailDesc.textContent = item.description;
+        detailPrice.textContent = item.price;
+        detailCalories.textContent = item.calories;
+        detailRoast.textContent = item.roast;
+      }
+
+      function cleanUpTransitions() {
+        document.querySelectorAll('.thumbnail').forEach((el) => {
+          el.classList.remove('selected');
+          el.style.removeProperty('view-transition-name');
+          const title = el.querySelector('.title');
+          if (title) title.style.removeProperty('view-transition-name');
+        });
+      }
+
+      function navigateToDetail(itemId, updateHistory = true) {
+        const item = itemsData[itemId];
+        if (!item) return;
+
+        const thumbnail = document.querySelector(`.thumbnail[data-id="${itemId}"]`);
+        if (thumbnail) {
+          thumbnail.classList.add('selected');
+        }
+
+        updateDetailContent(item);
+
+        if (updateHistory) {
+          history.pushState({ view: 'detail', id: itemId }, '', '#' + itemId);
+        }
+
+        const showDetailDOM = () => {
+          listPage.hidden = true;
+          detailPage.hidden = false;
+        };
+
+        // Fallback if View Transitions API is not supported
+        if (!document.startViewTransition) {
+          showDetailDOM();
+          detailTitle.focus();
+          return;
+        }
+
+        const transition = document.startViewTransition(() => {
+          showDetailDOM();
+        });
+
+        // Programmatically shift keyboard focus once transition resolves
+        transition.finished.finally(() => {
+          detailTitle.focus();
+        });
+      }
+
+      function navigateToList(updateHistory = true) {
+        if (updateHistory && location.hash) {
+          history.pushState({ view: 'list' }, '', window.location.pathname);
+        }
+
+        const showListDOM = () => {
+          detailPage.hidden = true;
+          listPage.hidden = false;
+        };
+
+        // Fallback if View Transitions API is not supported
+        if (!document.startViewTransition) {
+          showListDOM();
+          cleanUpTransitions();
+          listHeading.focus();
+          return;
+        }
+
+        const transition = document.startViewTransition(() => {
+          showListDOM();
+        });
+
+        transition.finished.finally(() => {
+          cleanUpTransitions();
+          listHeading.focus();
+        });
+      }
+
+      // Thumbnail click & keyboard events
+      thumbnails.forEach((thumb) => {
+        const itemId = thumb.getAttribute('data-id');
+
+        thumb.addEventListener('click', (e) => {
+          e.preventDefault();
+          navigateToDetail(itemId);
+        });
+
+        thumb.addEventListener('keydown', (e) => {
+          if (e.key === 'Enter' || e.key === ' ') {
+            e.preventDefault();
+            navigateToDetail(itemId);
+          }
+        });
+      });
+
+      // Back button click
+      backButton.addEventListener('click', (e) => {
+        e.preventDefault();
+        navigateToList();
+      });
+
+      // Logo and Menu links return to list view
+      document.getElementById('nav-logo').addEventListener('click', (e) => {
+        e.preventDefault();
+        if (!detailPage.hidden) {
+          navigateToList();
+        } else {
+          window.scrollTo({ top: 0, behavior: 'smooth' });
+        }
+      });
+
+      document.getElementById('nav-menu').addEventListener('click', (e) => {
+        e.preventDefault();
+        if (!detailPage.hidden) {
+          navigateToList();
+        } else {
+          listHeading.scrollIntoView({ behavior: 'smooth' });
+          listHeading.focus();
+        }
+      });
+
+      // Handle Escape key to return to list view
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && !detailPage.hidden) {
+          navigateToList();
+        }
+      });
+
+      // Browser forward/backward navigation
+      window.addEventListener('popstate', (e) => {
+        const hash = window.location.hash.slice(1);
+        if (hash && itemsData[hash]) {
+          navigateToDetail(hash, false);
+        } else {
+          navigateToList(false);
+        }
+      });
+
+      // Initial route check on page load
+      const initialHash = window.location.hash.slice(1);
+      if (initialHash && itemsData[initialHash]) {
+        const thumb = document.querySelector(`.thumbnail[data-id="${initialHash}"]`);
+        if (thumb) thumb.classList.add('selected');
+        updateDetailContent(itemsData[initialHash]);
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        detailTitle.focus();
+      }
+    })();
+  </script>
