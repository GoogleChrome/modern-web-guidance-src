+
+    /* Style the transition to support different aspect ratios without stretching the image */
+    ::view-transition-old(hero),
+    ::view-transition-new(hero) {
+      animation: none;
+      mix-blend-mode: normal;
+      height: 100%;
+      width: 100%;
+      overflow: clip;
+    }
+
+    ::view-transition-image-pair(hero) {
+      isolation: none;
+    }
+
+    /* Forward transition (thumbnail -> hero): old view shrinks to fit, new view uncrops/covers */
+    html.to-detail::view-transition-old(hero),
