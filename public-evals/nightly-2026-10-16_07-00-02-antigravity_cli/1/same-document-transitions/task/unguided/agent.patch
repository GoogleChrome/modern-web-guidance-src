+          if (thumbnailTitle) thumbnailTitle.style.viewTransitionName = '';
+
+          // Programmatically shift focus to #title heading so it's not lost
+          titleElement.focus();
+        },
+        onComplete: () => {
+          // Confirm focus on #title heading after transition
+          titleElement.focus();
+        }
+      });
+    }
+
+    // Transition from detail back to list view
+    function showList() {
+      if (isTransitioning) return;
+      isTransitioning = true;
+
+      const targetThumbnail = lastActiveThumbnail || (activeItemId ? document.querySelector(`.thumbnail[data-id="${activeItemId}"]`) : null);
+      const targetThumbnailTitle = targetThumbnail ? targetThumbnail.querySelector('.title') : null;
+
+      // Set temporary transition names on active detail #hero and #title
+      if (heroElement) heroElement.style.viewTransitionName = 'hero';
+      if (titleElement) titleElement.style.viewTransitionName = 'title';
+
+      runViewTransition({
+        direction: 'to-list',
+        updateDOM: () => {
+          // Switch views
+          detailPage.hidden = true;
+          detailPage.style.display = 'none';
+          listPage.hidden = false;
+          listPage.style.display = 'block';
+
+          // Target thumbnail receives transition names in new state
+          if (targetThumbnail) targetThumbnail.style.viewTransitionName = 'hero';
+          if (targetThumbnailTitle) targetThumbnailTitle.style.viewTransitionName = 'title';
+
+          // Remove from detail elements
+          if (heroElement) heroElement.style.viewTransitionName = '';
+          if (titleElement) titleElement.style.viewTransitionName = '';
+
+          // Programmatically shift focus to #list-heading so it's not lost
+          listHeading.focus();
+        },
+        onComplete: () => {
+          // Confirm focus on #list-heading after transition
+          listHeading.focus();
+        }
+      });
+    }
+
+    // Event listeners on thumbnail cards
+    document.querySelectorAll('.thumbnail').forEach((card) => {
+      const id = card.dataset.id;
+
+      card.addEventListener('click', (e) => {
+        e.preventDefault();
+        showDetail(id, card);
+        try {
+          history.pushState({ page: 'detail', id }, '', '#' + id);
+        } catch (_) {}
+      });
+
+      card.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
+          showDetail(id, card);
+          try {
+            history.pushState({ page: 'detail', id }, '', '#' + id);
+          } catch (_) {}
+        }
+      });
+    });
+
+    // Back button event listener
+    if (backButton) {
+      backButton.addEventListener('click', (e) => {
+        e.preventDefault();
+        showList();
+        try {
+          if (location.hash) {
+            history.pushState({ page: 'list' }, '', window.location.pathname);
+          }
+        } catch (_) {}
+      });
+    }
+
+    // Brand logo navigation back to list
+    if (brandLogo) {
+      brandLogo.addEventListener('click', (e) => {
+        if (!detailPage.hidden) {
+          e.preventDefault();
+          showList();
+          try {
+            history.pushState({ page: 'list' }, '', window.location.pathname);
+          } catch (_) {}
+        }
+      });
+    }
+
+    // Keyboard support: Escape key returns to list
+    window.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape' && !detailPage.hidden) {
+        showList();
+        try {
+          history.pushState({ page: 'list' }, '', window.location.pathname);
+        } catch (_) {}
+      }
+    });
+
+    // Browser back/forward navigation support
+    window.addEventListener('popstate', (e) => {
+      const state = e.state;
+      if (state && state.page === 'detail' && state.id) {
+        showDetail(state.id);
+      } else if (location.hash && ITEMS[location.hash.slice(1)]) {
+        showDetail(location.hash.slice(1));
+      } else {
+        if (!detailPage.hidden) {
+          showList();
+        }
+      }
+    });
+
+    // Check initial hash on load
+    if (location.hash && ITEMS[location.hash.slice(1)]) {
+      showDetail(location.hash.slice(1));
+    }
+  </script>
 </body>
 
 </html>
