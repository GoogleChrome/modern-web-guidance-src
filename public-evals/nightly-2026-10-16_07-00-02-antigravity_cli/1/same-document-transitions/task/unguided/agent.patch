+    #title {
+      width: fit-content;
+      max-width: 100%;
+    }
+
+    ::view-transition-old(title),
+    ::view-transition-new(title) {
+      height: 100%;
+      width: auto;
+    }
+
+    ::view-transition-group(title) {
+      overflow: clip;
+    }
+
+    /* Disable all transition animations when reduced motion is preferred */
+    @media (prefers-reduced-motion: reduce) {
