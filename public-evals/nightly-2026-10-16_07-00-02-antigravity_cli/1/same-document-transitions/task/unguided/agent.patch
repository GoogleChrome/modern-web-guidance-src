+    :active-view-transition-type(to-detail)::view-transition-old(hero) {
+      object-fit: contain;
+    }
+
+    html.to-detail::view-transition-new(hero),
+    html.list-to-detail::view-transition-new(hero),
+    :active-view-transition-type(to-detail)::view-transition-new(hero) {
+      object-fit: cover;
+    }
+
+    /* Backward transition (hero -> thumbnail): old view covers, new view shrinks to fit */
+    html.to-list::view-transition-old(hero),
