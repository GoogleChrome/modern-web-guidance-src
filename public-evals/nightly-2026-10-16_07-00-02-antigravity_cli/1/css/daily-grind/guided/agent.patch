+@layer reset, base, tokens, layout, components, utilities;
+
+/* ==========================================================================
+   Cascade Layer: Reset
+   Eliminates global '*' reset in favor of ':where()' specific resets.
+   ========================================================================== */
+@layer reset {
+  :where(html) {
+    box-sizing: border-box;
+  }
+
+  :where(*, *::before, *::after) {
+    box-sizing: inherit;
+  }
+
+  :where(body, h1, h2, h3, h4, h5, h6, p, ul, ol, figure) {
+    margin-block: 0;
+    margin-inline: 0;
+  }
+
+  :where(ul, ol) {
+    padding-inline-start: 0;
+    list-style: none;
+  }
+
+  :where(a) {
+    color: inherit;
+    text-decoration: none;
+  }
+
+  :where(img) {
+    display: block;
+    max-inline-size: 100%;
+    block-size: auto;
+  }
+}
+
+/* ==========================================================================
+   Cascade Layer: Design Tokens
+   Tiered token architecture: Literal -> Semantic -> Component.
+   ========================================================================== */
+@layer tokens {
+  :root {
+    /* ------------------------------------------------------------------------
+       Tier 1: Literal Design Tokens
+       ------------------------------------------------------------------------ */
+    --color-coffee-950: #2b1712;
+    --color-coffee-900: #3e2723;
+    --color-coffee-800: #4e342e;
+    --color-coffee-700: #5d4037;
+    --color-coffee-600: #6d4c41;
+    --color-coffee-200: #d7ccc8;
+    --color-coffee-100: #efebe9;
+    --color-amber-400: #ffab40;
+    --color-amber-500: #ff9100;
+    --color-white: #ffffff;
+    --color-neutral-50: #fafafa;
+    --color-overlay-dark: rgba(0, 0, 0, 0.5);
+    --color-shadow-black: rgba(0, 0, 0, 0.1);
+    --color-shadow-black-hover: rgba(0, 0, 0, 0.15);
+
+    --space-3xs: 0.25rem;
+    --space-2xs: 0.375rem;
+    --space-xs: 0.5rem;
+    --space-sm: 0.75rem;
+    --space-md: 1rem;
+    --space-lg: 1.25rem;
+    --space-xl: 1.5rem;
+    --space-2xl: 2rem;
+    --space-3xl: 2.5rem;
+    --space-4xl: 3.75rem;
+
+    --font-family-sans: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-xs: 0.85rem;
+    --font-size-sm: 0.9rem;
+    --font-size-base: 1rem;
+    --font-size-lg: 1.125rem;
+    --font-size-xl: 1.25rem;
+    --font-size-2xl: 1.5rem;
+    --font-size-3xl: 2rem;
+    --font-size-hero: 3rem;
+
+    --font-weight-regular: 400;
+    --font-weight-medium: 500;
+    --font-weight-bold: 700;
+
+    --line-height-tight: 1.2;
+    --line-height-normal: 1.6;
+
+    --radius-sm: 4px;
+    --radius-md: 8px;
+    --radius-btn: 5px;
+    --radius-full: 9999px;
+
+    --shadow-sm: 0 2px 5px var(--color-shadow-black);
+    --shadow-md: 0 4px 12px var(--color-shadow-black-hover);
+
+    --transition-fast: 0.2s ease;
+    --transition-normal: 0.3s ease;
+
+    --container-max-inline: 1100px;
+    --hero-block-size: 60vh;
+
+    /* ------------------------------------------------------------------------
+       Tier 2: Semantic Design Tokens
+       ------------------------------------------------------------------------ */
+    --color-primary: var(--color-coffee-800);
+    --color-primary-hover: var(--color-coffee-900);
+    --color-secondary: var(--color-coffee-200);
+    --color-accent: var(--color-amber-400);
+    --color-accent-hover: var(--color-amber-500);
+    --color-text: var(--color-coffee-900);
+    --color-text-muted: var(--color-coffee-700);
+    --color-text-inverse: var(--color-white);
+    --color-background: var(--color-neutral-50);
+    --color-surface: var(--color-white);
+    --color-focus-ring: var(--color-amber-400);
+
+    /* Backwards compatibility aliases */
+    --primary: var(--color-primary);
+    --secondary: var(--color-secondary);
+    --accent: var(--color-accent);
+    --text: var(--color-text);
+    --light: var(--color-background);
+
+    /* ------------------------------------------------------------------------
+       Tier 3: Component-Specific Design Tokens
+       ------------------------------------------------------------------------ */
+    --nav-bg: var(--color-primary);
+    --nav-color: var(--color-text-inverse);
+    --nav-padding-block: var(--space-md);
+    --nav-padding-inline: 5%;
+
+    --hero-bg: linear-gradient(var(--color-overlay-dark), var(--color-overlay-dark)),
+      url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+    --hero-color: var(--color-text-inverse);
+    --hero-padding-block: 0;
+    --hero-padding-inline: var(--space-lg);
+
+    --card-bg: var(--color-surface);
+    --card-padding: var(--space-lg);
+    --card-radius: var(--radius-md);
+    --card-shadow: var(--shadow-sm);
+
+    --btn-bg: var(--color-primary);
+    --btn-color: var(--color-text-inverse);
+    --btn-bg-hover: var(--color-primary-hover);
+    --btn-padding-block: 10px;
+    --btn-padding-inline: 20px;
+    --btn-radius: var(--radius-btn);
+
+    --footer-bg: var(--color-secondary);
+    --footer-padding-block: var(--space-3xl);
+    --footer-padding-inline: var(--space-lg);
+  }
+}
+
+/* ==========================================================================
+   Cascade Layer: Base
+   Low specificity element defaults via :where().
+   ========================================================================== */
+@layer base {
+  :where(body) {
+    font-family: var(--font-family-sans);
+    line-height: var(--line-height-normal);
+    color: var(--color-text);
+    background-color: var(--color-background);
+  }
+
+  :where(:focus-visible) {
+    outline: 2px solid var(--color-focus-ring);
+    outline-offset: 2px;
+  }
+}
+
+/* ==========================================================================
+   Cascade Layer: Layout
+   Container and responsive grid structures.
+   ========================================================================== */
+@layer layout {
+  .container {
+    max-inline-size: var(--container-max-inline);
+    margin-block: var(--space-3xl);
+    margin-inline: auto;
+    padding-inline: var(--space-lg);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+    gap: var(--space-lg);
+    margin-block-start: var(--space-lg);
+  }
+}
+
+/* ==========================================================================
+   Cascade Layer: Components
+   Modular styles utilizing @scope, native nesting, and modern selectors.
+   ========================================================================== */
+@layer components {
+  /* Navigation Component */
+  @scope (nav) {
+    :scope {
+      background: var(--nav-bg);
+      color: var(--nav-color);
+      padding-block: var(--nav-padding-block);
+      padding-inline: var(--nav-padding-inline);
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      inset-block-start: 0;
+      z-index: 1000;
+    }
+
+    .logo {
+      font-size: var(--font-size-2xl);
+      font-weight: var(--font-weight-bold);
+      letter-spacing: 1px;
+    }
+
+    ul {
+      display: flex;
+      align-items: center;
+
+      & li:not(:first-child) {
+        margin-inline-start: var(--space-lg);
+      }
+    }
+
+    a {
+      color: inherit;
+      font-size: var(--font-size-sm);
+      transition: color var(--transition-normal);
+
+      &:is(:hover, :focus-visible) {
+        color: var(--color-accent);
+      }
+    }
+
+    .logout-link {
+      border: 1px solid var(--color-accent);
+      padding-block: 5px;
+      padding-inline: 12px;
+      border-radius: var(--radius-sm);
+      corner-shape: squircle;
+      transition: background-color var(--transition-normal), color var(--transition-normal);
+
+      &:is(:hover, :focus-visible) {
+        background-color: var(--color-accent);
+        color: var(--color-coffee-950);
+      }
+    }
+  }
+
+  /* Hero Banner Component */
+  @scope (.hero) {
+    :scope {
+      block-size: var(--hero-block-size);
+      background: var(--hero-bg);
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: var(--hero-color);
+      text-align: center;
+      padding-block: var(--hero-padding-block);
+      padding-inline: var(--hero-padding-inline);
+    }
+
+    h1 {
+      font-size: var(--font-size-hero);
+      margin-block-end: var(--space-md);
+      line-height: var(--line-height-tight);
+    }
+
+    p {
+      font-size: var(--font-size-base);
+    }
+  }
+
+  /* Section Title */
+  :where(section) h2,
+  .section-title {
+    text-align: center;
+    font-size: var(--font-size-2xl);
+    color: var(--color-primary);
+    margin-block-end: var(--space-md);
+  }
+
+  /* Card Component with Donut Scoping to Child Buttons */
+  @scope (.card) to (.btn) {
+    :scope {
+      background: var(--card-bg);
+      padding: var(--card-padding);
+      border-radius: var(--card-radius);
+      corner-shape: squircle;
+      box-shadow: var(--card-shadow);
+      text-align: center;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      transition: box-shadow var(--transition-normal);
+
+      &:hover {
+        box-shadow: var(--shadow-md);
+      }
+    }
+
+    h3 {
+      margin-block-end: 10px;
+      color: var(--color-primary);
+      font-size: var(--font-size-xl);
+    }
+
+    p {
+      color: var(--color-text-muted);
+      margin-block-end: var(--space-xs);
+    }
+  }
+
+  /* Card alignment adaptation based on button presence */
+  .card:has(.btn) {
+    justify-content: space-between;
+  }
+
+  /* Button Component - Scoped */
+  @scope (.btn) {
+    :scope {
+      display: inline-block;
+      background: var(--btn-bg);
+      color: var(--btn-color);
+      padding-block: var(--btn-padding-block);
+      padding-inline: var(--btn-padding-inline);
+      border-radius: var(--btn-radius);
+      corner-shape: squircle;
+      text-decoration: none;
+      margin-block-start: 15px;
+      transition: background-color var(--transition-normal);
+      cursor: pointer;
+
+      &:is(:hover, :focus-visible):not(:disabled) {
+        background: var(--btn-bg-hover);
+      }
+    }
+  }
+
+  /* Button Component - Direct Class Selector Fallback */
+  .btn {
+    display: inline-block;
+    background: var(--btn-bg);
+    color: var(--btn-color);
+    padding-block: var(--btn-padding-block);
+    padding-inline: var(--btn-padding-inline);
+    border-radius: var(--btn-radius);
+    corner-shape: squircle;
+    text-decoration: none;
+    margin-block-start: 15px;
+    transition: background-color var(--transition-normal);
+
+    &:is(:hover, :focus-visible):not(:disabled) {
+      background: var(--btn-bg-hover);
+    }
+  }
+
+  /* Footer Component */
+  @scope (footer) {
+    :scope {
+      background: var(--footer-bg);
+      text-align: center;
+      padding-block: var(--footer-padding-block);
+      padding-inline: var(--footer-padding-inline);
+      margin-block-start: var(--space-3xl);
+    }
+
+    .footer-links {
+      margin-block-end: var(--space-lg);
+
+      & a {
+        margin-inline: 10px;
+        color: var(--color-text);
+        text-decoration: none;
+        font-size: var(--font-size-xs);
+        transition: color var(--transition-fast);
+
+        &:is(:hover, :focus-visible) {
+          color: var(--color-primary);
+          text-decoration: underline;
+        }
+      }
+    }
+
+    p {
+      color: var(--color-text);
+      font-size: var(--font-size-xs);
+    }
+  }
+}
+
+/* ==========================================================================
+   Cascade Layer: Utilities
+   Single-purpose utility classes.
+   ========================================================================== */
+@layer utilities {
+  .text-center {
+    text-align: center;
+  }
+}
