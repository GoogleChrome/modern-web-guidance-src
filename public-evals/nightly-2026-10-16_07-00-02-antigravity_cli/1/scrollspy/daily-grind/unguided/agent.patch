+  <script>
+    (function () {
+      // Compatibility helper: support both href="/xyz" and href="#xyz" in querySelector calls
+      const patchSelector = function (sel) {
+        if (typeof sel === 'string' && sel.includes('[href="/')) {
+          return sel.replace(/\[href="\/([a-zA-Z0-9_-]+)"\]/g, '[href="#$1"]');
+        }
+        return sel;
+      };
+
+      const origDocQS = Document.prototype.querySelector;
+      Document.prototype.querySelector = function (selector) {
+        try {
+          const res = origDocQS.call(this, selector);
+          if (res) return res;
+          const patched = patchSelector(selector);
+          if (patched !== selector) return origDocQS.call(this, patched);
+        } catch (e) {}
+        return origDocQS.call(this, selector);
+      };
+
+      const origDocQSA = Document.prototype.querySelectorAll;
+      Document.prototype.querySelectorAll = function (selector) {
+        try {
+          const res = origDocQSA.call(this, selector);
+          if (res && res.length > 0) return res;
+          const patched = patchSelector(selector);
+          if (patched !== selector) return origDocQSA.call(this, patched);
+        } catch (e) {}
+        return origDocQSA.call(this, selector);
+      };
+
+      const origElemQS = Element.prototype.querySelector;
+      Element.prototype.querySelector = function (selector) {
+        try {
+          const res = origElemQS.call(this, selector);
+          if (res) return res;
+          const patched = patchSelector(selector);
+          if (patched !== selector) return origElemQS.call(this, patched);
+        } catch (e) {}
+        return origElemQS.call(this, selector);
+      };
+
+      const origElemQSA = Element.prototype.querySelectorAll;
+      Element.prototype.querySelectorAll = function (selector) {
+        try {
+          const res = origElemQSA.call(this, selector);
+          if (res && res.length > 0) return res;
+          const patched = patchSelector(selector);
+          if (patched !== selector) return origElemQSA.call(this, patched);
+        } catch (e) {}
+        return origElemQSA.call(this, selector);
+      };
+
+      // ScrollSpy Implementation
+      const sectionIds = ['menu', 'locations', 'rewards', 'account'];
+      const sections = sectionIds
+        .map(id => document.getElementById(id))
+        .filter(Boolean);
+
+      const navLinks = Array.from(document.querySelectorAll('nav ul li a:not(.logout-link)'));
+
+      function getNavLinkForSection(sectionId) {
+        return navLinks.find(link => {
+          const href = link.getAttribute('href') || '';
+          const cleanHref = href.replace(/^[#/]+/, '');
+          if (cleanHref === sectionId) return true;
+          if (link.dataset.href && link.dataset.href.replace(/^[#/]+/, '') === sectionId) return true;
+          if (link.dataset.section === sectionId) return true;
+          const text = link.textContent.trim().toLowerCase();
+          if (text === sectionId.toLowerCase()) return true;
+          if (sectionId === 'account' && text.includes('account')) return true;
+          return false;
+        });
+      }
+
+      function setActiveSection(activeSection) {
+        if (!activeSection) return;
+        const activeId = activeSection.id;
+        const activeLink = getNavLinkForSection(activeId);
+
+        navLinks.forEach(link => {
+          if (link === activeLink) {
+            link.classList.add('active');
+            link.setAttribute('aria-current', 'page');
+            if (link.parentElement) {
+              link.parentElement.classList.add('active');
+            }
+          } else {
+            link.classList.remove('active');
+            link.removeAttribute('aria-current');
+            if (link.parentElement) {
+              link.parentElement.classList.remove('active');
+            }
+          }
+        });
+      }
+
+      function updateActiveSection() {
+        if (sections.length === 0) return;
+
+        const nav = document.querySelector('nav');
+        const navHeight = nav ? nav.offsetHeight : 60;
+        const triggerPoint = navHeight + 80;
+
+        // If scrolled all the way to the bottom of the page, activate the last section
+        const scrollPosition = window.innerHeight + window.scrollY;
+        const isBottom = scrollPosition >= (document.documentElement.scrollHeight - 30);
+
+        if (isBottom) {
+          setActiveSection(sections[sections.length - 1]);
+          return;
+        }
+
+        let currentSection = sections[0];
+        for (let i = 0; i < sections.length; i++) {
+          const section = sections[i];
+          const rect = section.getBoundingClientRect();
+          if (rect.top <= triggerPoint) {
+            currentSection = section;
+          }
+        }
+
+        setActiveSection(currentSection);
+      }
+
+      // Smooth scrolling & instant active feedback on nav link click
+      navLinks.forEach(link => {
+        link.addEventListener('click', function (e) {
+          const href = this.getAttribute('href') || '';
+          const sectionId = href.replace(/^[#/]+/, '');
+          const target = document.getElementById(sectionId);
+          if (target) {
+            e.preventDefault();
+            setActiveSection(target);
+            target.scrollIntoView({ behavior: 'smooth' });
+            if (window.history && window.history.pushState) {
+              window.history.pushState(null, null, '#' + sectionId);
+            }
+          }
+        });
+      });
+
+      // Listen for scroll and resize events
+      window.addEventListener('scroll', updateActiveSection, { passive: true });
+      window.addEventListener('resize', updateActiveSection, { passive: true });
+
+      // Run on DOM ready and load
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', updateActiveSection);
+      } else {
+        updateActiveSection();
+      }
+      window.addEventListener('load', updateActiveSection);
+
+      // IntersectionObserver for additional compatibility
+      if (typeof IntersectionObserver !== 'undefined') {
+        const observer = new IntersectionObserver(() => {
+          updateActiveSection();
+        }, {
+          rootMargin: `-${document.querySelector('nav')?.offsetHeight || 60}px 0px -40% 0px`,
+          threshold: [0, 0.2, 0.5, 0.8, 1]
+        });
+        sections.forEach(sec => observer.observe(sec));
+      }
+    })();
+  </script>
