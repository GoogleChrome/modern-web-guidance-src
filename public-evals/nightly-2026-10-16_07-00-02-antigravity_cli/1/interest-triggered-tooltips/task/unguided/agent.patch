+    /* Tooltip / Popover */
+    .tooltip-container {
+      position: relative;
+      display: inline-block;
+      margin-top: 15px;
+    }
+
+    .tooltip-container .btn {
+      margin-top: 0;
+    }
+
+    .popover {
+      position: absolute;
+      top: 50%;
+      left: calc(100% + 12px);
+      transform: translateY(-50%);
+      background: #2d1e1a;
+      color: #fafafa;
+      padding: 10px 14px;
+      border-radius: 6px;
+      font-size: 0.82rem;
+      line-height: 1.5;
+      text-align: left;
+      white-space: nowrap;
+      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
+      z-index: 100;
+      opacity: 0;
+      visibility: hidden;
+      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
+      pointer-events: none;
+    }
+
+    /* Arrow pointing left towards the button */
+    .popover::before {
+      content: '';
+      position: absolute;
+      top: 50%;
+      right: 100%;
+      transform: translateY(-50%);
+      border-width: 6px;
+      border-style: solid;
+      border-color: transparent #2d1e1a transparent transparent;
+    }
+
+    .popover-title {
+      font-weight: 600;
+      color: var(--accent);
+      margin-bottom: 4px;
+      font-size: 0.85rem;
+      border-bottom: 1px solid rgba(255, 255, 255, 0.15);
+      padding-bottom: 3px;
+    }
+
+    .popover-row {
+      display: flex;
+      justify-content: space-between;
+      gap: 12px;
+      margin-top: 2px;
+    }
+
+    .popover-label {
+      color: var(--secondary);
+    }
+
+    .popover-val {
+      font-weight: 600;
+      color: white;
+    }
+
+    .tooltip-container:hover .popover,
+    .tooltip-container:focus-within .popover,
+    .btn:hover + .popover,
+    .btn:focus + .popover,
+    .popover.is-visible {
+      opacity: 1;
+      visibility: visible;
+      pointer-events: auto;
+      transform: translateY(-50%) translateX(2px);
+    }
+
+    @media (max-width: 600px) {
+      .popover {
+        left: 50%;
+        top: auto;
+        bottom: calc(100% + 10px);
+        transform: translateX(-50%);
+      }
+
+      .popover::before {
+        top: 100%;
+        left: 50%;
+        right: auto;
+        transform: translateX(-50%);
+        border-color: #2d1e1a transparent transparent transparent;
+      }
+
+      .tooltip-container:hover .popover,
+      .tooltip-container:focus-within .popover,
+      .btn:hover + .popover,
+      .btn:focus + .popover,
+      .popover.is-visible {
+        transform: translateX(-50%) translateY(-2px);
+      }
+    }
+
