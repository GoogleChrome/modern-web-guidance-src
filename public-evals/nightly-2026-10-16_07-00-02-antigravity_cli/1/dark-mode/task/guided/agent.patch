+  <!-- Interactive JavaScript for Theme Preference and Late Night Filters -->
+  <script>
+    (function () {
+      // 1. Root Theme Forcing Logic
+      const themeSelect = document.getElementById('theme-select');
+      const metaColorScheme = document.querySelector('meta[name="color-scheme"]');
+
+      function forceTheme(theme) {
+        if (theme === 'light') {
+          document.documentElement.setAttribute('data-theme', 'light');
+          document.documentElement.style.colorScheme = 'light';
+          if (metaColorScheme) metaColorScheme.content = 'light';
+          try {
+            localStorage.setItem('theme-preference', 'light');
+          } catch (e) {}
+        } else if (theme === 'dark') {
+          document.documentElement.setAttribute('data-theme', 'dark');
+          document.documentElement.style.colorScheme = 'dark';
+          if (metaColorScheme) metaColorScheme.content = 'dark';
+          try {
+            localStorage.setItem('theme-preference', 'dark');
+          } catch (e) {}
+        } else {
+          // System default: let browser adapt automatically
+          document.documentElement.removeAttribute('data-theme');
+          document.documentElement.style.colorScheme = 'light dark';
+          if (metaColorScheme) metaColorScheme.content = 'light dark';
+          try {
+            localStorage.removeItem('theme-preference');
+          } catch (e) {}
+        }
+      }
+
+      if (themeSelect) {
+        let initialTheme = 'system';
+        try {
+          const stored = localStorage.getItem('theme-preference');
+          if (stored === 'light' || stored === 'dark') {
+            initialTheme = stored;
+          }
+        } catch (e) {}
+
+        themeSelect.value = initialTheme;
+        forceTheme(initialTheme);
+
+        themeSelect.addEventListener('change', function (e) {
+          forceTheme(e.target.value);
+        });
+      }
+
+      // Sync across browser tabs
+      window.addEventListener('storage', function (e) {
+        if (e.key === 'theme-preference') {
+          const newTheme = (e.newValue === 'light' || e.newValue === 'dark') ? e.newValue : 'system';
+          if (themeSelect) themeSelect.value = newTheme;
+          forceTheme(newTheme);
+        }
+      });
+
+      // 2. Late Night Specials Category Filtering
+      const lateNightCategorySelect = document.getElementById('late-night-category');
+      const specialCards = document.querySelectorAll('.special-card');
+
+      if (lateNightCategorySelect) {
+        lateNightCategorySelect.addEventListener('change', function (e) {
+          const category = e.target.value;
+          specialCards.forEach(function (card) {
+            const cardCategory = card.getAttribute('data-category');
+            if (category === 'all' || cardCategory === category) {
+              card.style.display = 'flex';
+            } else {
+              card.style.display = 'none';
+            }
+          });
+        });
+      }
+    })();
+  </script>
