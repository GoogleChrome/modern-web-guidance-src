+  <!-- Theme Switcher & Late Night Filter Script -->
+  <script>
+    (function () {
+      const themeSelect = document.getElementById('theme-select');
+      const root = document.documentElement;
+      const STORAGE_KEY = 'daily-grind-theme';
+
+      /**
+       * Applies chosen theme to root element.
+       * Handles 'system', 'light', and 'dark' states.
+       */
+      function applyTheme(theme) {
+        if (theme === 'light') {
+          root.setAttribute('data-theme', 'light');
+          root.style.colorScheme = 'light';
+        } else if (theme === 'dark') {
+          root.setAttribute('data-theme', 'dark');
+          root.style.colorScheme = 'dark';
+        } else {
+          // System default: clear manual overrides to let OS preferences drive styling
+          root.removeAttribute('data-theme');
+          root.style.colorScheme = '';
+        }
+
+        try {
+          localStorage.setItem(STORAGE_KEY, theme);
+        } catch (err) {
+          // Ignore localStorage errors (e.g. private browsing restrictions)
+        }
+      }
+
+      // Initialize saved preference if present, otherwise default to 'system'
+      let initialTheme = 'system';
+      try {
+        const stored = localStorage.getItem(STORAGE_KEY);
+        if (stored === 'light' || stored === 'dark' || stored === 'system') {
+          initialTheme = stored;
+        }
+      } catch (err) {}
+
+      themeSelect.value = initialTheme;
+      applyTheme(initialTheme);
+
+      // Event listener for user theme choice
+      themeSelect.addEventListener('change', function (event) {
+        applyTheme(event.target.value);
+      });
+
+      // Filter functionality for the Late Night Specials select menu
+      const lateNightSelect = document.getElementById('late-night-category');
+      const lateNightCards = document.querySelectorAll('.late-night-card');
+
+      if (lateNightSelect && lateNightCards.length > 0) {
+        lateNightSelect.addEventListener('change', function (event) {
+          const selected = event.target.value;
+          lateNightCards.forEach(function (card) {
+            const category = card.getAttribute('data-category');
+            if (selected === 'all' || category === selected) {
+              card.style.display = 'flex';
+            } else {
+              card.style.display = 'none';
+            }
+          });
+        });
+      }
+    })();
+  </script>
