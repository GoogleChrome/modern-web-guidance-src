       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Scroll Progress Indicator */
+    #progress {
+      position: fixed;
+      top: 0;
+      left: 0;
+      width: 100%;
+      height: 4px;
+      background: var(--accent);
+      transform-origin: 0 50%;
+      transform: scaleX(0);
+      z-index: 1001;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports (animation-timeline: scroll()) {
+        @keyframes grow-progress {
+          from {
+            transform: scaleX(0);
+          }
+          to {
+            transform: scaleX(1);
+          }
+        }
+
+        #progress {
+          animation: grow-progress auto linear;
+          animation-timeline: scroll();
+        }
+      }
+    }
   </style>
 </head>
 
 <body>
 
+  <!-- Scroll Progress Indicator -->
+  <div id="progress" aria-hidden="true"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +240,27 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Progressive enhancement fallback for browsers without scroll-driven animation support
+    if (!window.matchMedia || !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      if (!window.CSS || !CSS.supports || !CSS.supports('animation-timeline', 'scroll()')) {
+        const progress = document.querySelector('#progress');
+        if (progress) {
+          const updateProgress = () => {
+            const scrollable = document.documentElement.scrollHeight - window.innerHeight;
+            const scrolled = window.scrollY || document.documentElement.scrollTop;
+            const progressPercentage = scrollable > 0 ? Math.min(Math.max(scrolled / scrollable, 0), 1) : 0;
+            progress.style.transform = `scaleX(${progressPercentage})`;
+          };
+
+          window.addEventListener('scroll', updateProgress, { passive: true });
+          window.addEventListener('resize', updateProgress, { passive: true });
+          updateProgress();
+        }
+      }
+    }
+  </script>
 </body>
 
 </html>
