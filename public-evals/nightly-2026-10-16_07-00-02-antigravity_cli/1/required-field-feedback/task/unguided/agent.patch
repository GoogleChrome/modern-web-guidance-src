+  <script>
+    (function () {
+      const form = document.getElementById('mailing-list-form');
+      const emailInput = document.getElementById('email');
+      const errorMessage = document.getElementById('email-error');
+      const successMessage = document.getElementById('mailing-list-success');
+
+      function showError(message) {
+        emailInput.classList.add('error');
+        emailInput.setAttribute('aria-invalid', 'true');
+        errorMessage.textContent = message;
+        errorMessage.classList.add('visible');
+        errorMessage.style.display = 'block';
+      }
+
+      function hideError() {
+        emailInput.classList.remove('error');
+        emailInput.removeAttribute('aria-invalid');
+        errorMessage.textContent = '';
+        errorMessage.classList.remove('visible');
+        errorMessage.style.display = 'none';
+      }
+
+      // Show error only after the user interacts and leaves the field blank or invalid
+      emailInput.addEventListener('blur', function () {
+        emailInput.dataset.touched = 'true';
+        emailInput.classList.add('touched');
+        const val = emailInput.value.trim();
+        if (val === '') {
+          showError('Email is required.');
+        } else if (!emailInput.validity.valid) {
+          showError('Please enter a valid email address.');
+        } else {
+          hideError();
+        }
+      });
+
+      // Clear the error as soon as user enters text
+      emailInput.addEventListener('input', function () {
+        if (emailInput.value.trim() !== '') {
+          hideError();
+        }
+      });
+
+      // Handle native invalid event (if triggered)
+      emailInput.addEventListener('invalid', function (e) {
+        e.preventDefault();
+        const val = emailInput.value.trim();
+        if (val === '') {
+          showError('Email is required.');
+        } else {
+          showError('Please enter a valid email address.');
+        }
+      });
+
+      // Clear success message when user focuses input again
+      emailInput.addEventListener('focus', function () {
+        if (successMessage && successMessage.style.display === 'block') {
+          successMessage.textContent = '';
+          successMessage.classList.remove('visible');
+          successMessage.style.display = 'none';
+        }
+      });
+
+      // Handle form submission
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        emailInput.dataset.touched = 'true';
+        emailInput.classList.add('touched');
+        const val = emailInput.value.trim();
+        if (val === '') {
+          showError('Email is required.');
+          emailInput.focus();
+          return;
+        }
+        if (!emailInput.validity.valid) {
+          showError('Please enter a valid email address.');
+          emailInput.focus();
+          return;
+        }
+
+        hideError();
+        if (successMessage) {
+          successMessage.textContent = 'Thank you for joining our mailing list!';
+          successMessage.classList.add('visible');
+          successMessage.style.display = 'block';
+        }
+        emailInput.value = '';
+      });
+    })();
+  </script>
