+export interface Language {
+  code: string;
+  name: string;
+  nativeName?: string;
+}
+
+export const SUPPORTED_LANGUAGES: Language[] = [
+  { code: 'en', name: 'English', nativeName: 'English' },
+  { code: 'es', name: 'Spanish', nativeName: 'Español' },
+  { code: 'fr', name: 'French', nativeName: 'Français' },
+  { code: 'de', name: 'German', nativeName: 'Deutsch' },
+  { code: 'it', name: 'Italian', nativeName: 'Italiano' },
+  { code: 'pt', name: 'Portuguese', nativeName: 'Português' },
+  { code: 'zh', name: 'Chinese', nativeName: '中文' },
+  { code: 'ja', name: 'Japanese', nativeName: '日本語' },
+  { code: 'ko', name: 'Korean', nativeName: '한국어' },
+  { code: 'ru', name: 'Russian', nativeName: 'Русский' },
+  { code: 'ar', name: 'Arabic', nativeName: 'العربية' },
+  { code: 'hi', name: 'Hindi', nativeName: 'हिन्दी' },
+  { code: 'nl', name: 'Dutch', nativeName: 'Nederlands' },
+  { code: 'pl', name: 'Polish', nativeName: 'Polski' },
+  { code: 'sv', name: 'Swedish', nativeName: 'Svenska' },
+  { code: 'tr', name: 'Turkish', nativeName: 'Türkçe' },
+  { code: 'uk', name: 'Ukrainian', nativeName: 'Українська' },
+  { code: 'el', name: 'Greek', nativeName: 'Ελληνικά' },
+  { code: 'vi', name: 'Vietnamese', nativeName: 'Tiếng Việt' },
+  { code: 'id', name: 'Indonesian', nativeName: 'Bahasa Indonesia' },
+  { code: 'cs', name: 'Czech', nativeName: 'Čeština' },
+  { code: 'da', name: 'Danish', nativeName: 'Dansk' },
+  { code: 'fi', name: 'Finnish', nativeName: 'Suomi' },
+  { code: 'no', name: 'Norwegian', nativeName: 'Norsk' },
+];
+
+function decodeHtmlEntities(str: string): string {
+  return str
+    .replace(/&amp;/g, '&')
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;/g, "'")
+    .replace(/&#x27;/g, "'")
+    .replace(/&#x2F;/g, '/')
+    .replace(/&apos;/g, "'");
+}
+
+function chunkText(text: string, maxLength = 400): string[] {
+  if (text.length <= maxLength) return [text];
+  const paragraphs = text.split('\n');
+  const chunks: string[] = [];
+  let current = '';
+
+  for (const para of paragraphs) {
+    if ((current + (current ? '\n' : '') + para).length <= maxLength) {
+      current = current ? current + '\n' + para : para;
+    } else {
+      if (current) {
+        chunks.push(current);
+        current = '';
+      }
+      if (para.length <= maxLength) {
+        current = para;
+      } else {
+        const sentences = para.match(/[^.!?]+[.!?]+(\s|$)|[^.!?]+$/g) || [para];
+        for (const s of sentences) {
+          if ((current + (current ? ' ' : '') + s).length <= maxLength) {
+            current = current ? current + ' ' + s : s;
+          } else {
+            if (current) chunks.push(current);
+            current = s;
+          }
+        }
+      }
+    }
+  }
+  if (current) chunks.push(current);
+  return chunks;
+}
+
+// Basic offline dictionary for common phrases in case external network fails
+const BASIC_DICTIONARY: Record<string, Record<string, string>> = {
+  'hello': { es: 'hola', fr: 'bonjour', de: 'hallo', it: 'ciao', pt: 'olá', ja: 'こんにちは', zh: '你好' },
+  'world': { es: 'mundo', fr: 'monde', de: 'Welt', it: 'mondo', pt: 'mundo', ja: '世界', zh: '世界' },
+  'hello world': { es: 'hola mundo', fr: 'bonjour le monde', de: 'hallo Welt', it: 'ciao mondo', pt: 'olá mundo', ja: 'こんにちは世界', zh: '你好世界' },
+  'news': { es: 'noticias', fr: 'actualités', de: 'Nachrichten', it: 'notizie', pt: 'notícias', ja: 'ニュース', zh: '新闻' },
+  'breaking news': { es: 'últimas noticias', fr: 'dernière minute', de: 'Eilmeldung', it: 'ultime notizie', pt: 'últimas notícias', ja: '速報', zh: '突发新闻' },
+  'read more': { es: 'leer más', fr: 'en savoir plus', de: 'weiterlesen', it: 'leggi di più', pt: 'leia mais', ja: '続きを読む', zh: '阅读更多' },
+};
+
+export async function translateSingleChunk(
+  chunk: string,
+  sourceLang: string,
+  targetLang: string
+): Promise<{ text: string; detectedLang?: string }> {
+  const trimmed = chunk.trim();
+  if (!trimmed) return { text: chunk };
+
+  const sl = sourceLang === 'auto' ? 'autodetect' : sourceLang.toLowerCase();
+  const tl = targetLang.toLowerCase();
+
+  if (sl === tl) {
+    return { text: chunk, detectedLang: sourceLang };
+  }
+
+  // Primary service: MyMemory API
+  try {
+    const langpair = `${sl}|${tl}`;
+    const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(trimmed)}&langpair=${encodeURIComponent(langpair)}`;
+    
+    const response = await fetch(url, {
+      headers: {
+        'Accept': 'application/json',
+      },
+      signal: AbortSignal.timeout(6000),
+    });
+
+    if (response.ok) {
+      const data = await response.json();
+      if (data && data.responseData && typeof data.responseData.translatedText === 'string') {
+        const translated = decodeHtmlEntities(data.responseData.translatedText);
+        // Only accept if not an explicit error message in translatedText
+        if (!translated.toUpperCase().startsWith('MYMEMORY WARNING:')) {
+          const detected = data.responseData.detectedLanguage || undefined;
+          return { text: translated, detectedLang: detected };
+        }
+      }
+    }
+  } catch (err) {
+    // network failure or timeout, proceed to fallbacks
+  }
+
+  // Secondary service: Lingva public API fallback
+  try {
+    const lingvaSl = sl === 'autodetect' ? 'auto' : sl;
+    const url = `https://lingva.ml/api/v1/${lingvaSl}/${tl}/${encodeURIComponent(trimmed)}`;
+    const response = await fetch(url, { signal: AbortSignal.timeout(5000) });
+    if (response.ok) {
+      const data = await response.json();
+      if (data && data.translation) {
+        return { text: data.translation, detectedLang: data.info?.detectedSource };
+      }
+    }
+  } catch {
+    // proceed to offline dictionary
+  }
+
+  // Offline dictionary fallback
+  const lower = trimmed.toLowerCase();
+  if (BASIC_DICTIONARY[lower] && BASIC_DICTIONARY[lower][tl]) {
+    return { text: BASIC_DICTIONARY[lower][tl], detectedLang: 'en' };
+  }
+
+  // Default fallback if all services unreachable: return original text
+  return { text: chunk, detectedLang: sourceLang === 'auto' ? 'en' : sourceLang };
+}
+
+export async function translateText({
+  text,
+  sourceLang = 'auto',
+  targetLang = 'es',
+}: {
+  text: string;
+  sourceLang?: string;
+  targetLang: string;
+}): Promise<{
+  translatedText: string;
+  detectedSourceLang: string;
+  sourceLang: string;
+  targetLang: string;
+  success: boolean;
+}> {
+  if (!text || !text.trim()) {
+    return {
+      translatedText: '',
+      detectedSourceLang: sourceLang === 'auto' ? 'en' : sourceLang,
+      sourceLang,
+      targetLang,
+      success: true,
+    };
+  }
+
+  const chunks = chunkText(text, 450);
+  const results: string[] = [];
+  let detectedLang = sourceLang === 'auto' ? 'en' : sourceLang;
+
+  for (const chunk of chunks) {
+    const res = await translateSingleChunk(chunk, sourceLang, targetLang);
+    results.push(res.text);
+    if (res.detectedLang) {
+      detectedLang = res.detectedLang;
+    }
+  }
+
+  return {
+    translatedText: results.join('\n'),
+    detectedSourceLang: detectedLang,
+    sourceLang,
+    targetLang,
+    success: true,
+  };
+}
