@@ -0,0 +1,145 @@
+import React, { useState } from 'react';
+import { LanguageIcon, ArrowPathIcon, CheckIcon } from '@heroicons/react/24/outline';
+import { SUPPORTED_LANGUAGES } from '../utils/translator';
+
+interface Props {
+  initialTitle: string;
+  initialSummary: string;
+}
+
+export default function ArticleTranslator({ initialTitle, initialSummary }: Props) {
+  const [selectedLang, setSelectedLang] = useState('en');
+  const [isTranslating, setIsTranslating] = useState(false);
+  const [translatedToLangName, setTranslatedToLangName] = useState<string | null>(null);
+  const [originalCache, setOriginalCache] = useState<{
+    title: string;
+    summary: string;
+    paragraphs: string[];
+  } | null>(null);
+
+  const handleLanguageChange = async (targetLang: string) => {
+    setSelectedLang(targetLang);
+
+    // If switching back to English (original)
+    if (targetLang === 'en') {
+      if (originalCache) {
+        const titleEl = document.getElementById('article-title');
+        const summaryEl = document.getElementById('article-summary');
+        const bodyEl = document.getElementById('article-body');
+
+        if (titleEl) titleEl.innerText = originalCache.title;
+        if (summaryEl) summaryEl.innerText = originalCache.summary;
+        if (bodyEl) {
+          const pEls = bodyEl.querySelectorAll('p');
+          pEls.forEach((p, idx) => {
+            if (originalCache.paragraphs[idx] !== undefined) {
+              p.innerText = originalCache.paragraphs[idx];
+            }
+          });
+        }
+      }
+      setTranslatedToLangName(null);
+      return;
+    }
+
+    setIsTranslating(true);
+
+    try {
+      const titleEl = document.getElementById('article-title');
+      const summaryEl = document.getElementById('article-summary');
+      const bodyEl = document.getElementById('article-body');
+
+      // Cache original content if not already cached
+      let cache = originalCache;
+      if (!cache) {
+        const pEls = bodyEl ? Array.from(bodyEl.querySelectorAll('p')) : [];
+        cache = {
+          title: titleEl ? titleEl.innerText : initialTitle,
+          summary: summaryEl ? summaryEl.innerText : initialSummary,
+          paragraphs: pEls.map(p => p.innerText),
+        };
+        setOriginalCache(cache);
+      }
+
+      // Collect texts to translate: title, summary, and paragraphs
+      const textsToTranslate = [cache.title, cache.summary, ...cache.paragraphs];
+      const joinedText = textsToTranslate.join('\n\n---DELIMITER---\n\n');
+
+      const response = await fetch(`${import.meta.env.BASE_URL}api/translate`, {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify({
+          text: joinedText,
+          sourceLang: 'en',
+          targetLang: targetLang,
+        }),
+      });
+
+      if (!response.ok) {
+        throw new Error('Translation failed');
+      }
+
+      const data = await response.json();
+      const translatedParts = (data.translatedText || '').split(/\n\n---DELIMITER---\n\n|\n*---DELIMITER---\n*/);
+
+      if (translatedParts.length > 0 && titleEl) {
+        titleEl.innerText = translatedParts[0].trim();
+      }
+      if (translatedParts.length > 1 && summaryEl) {
+        summaryEl.innerText = translatedParts[1].trim();
+      }
+      if (bodyEl && translatedParts.length > 2) {
+        const pEls = bodyEl.querySelectorAll('p');
+        pEls.forEach((p, idx) => {
+          const part = translatedParts[idx + 2];
+          if (part) {
+            p.innerText = part.trim();
+          }
+        });
+      }
+
+      const langObj = SUPPORTED_LANGUAGES.find(l => l.code === targetLang);
+      setTranslatedToLangName(langObj ? langObj.name : targetLang);
+    } catch (err) {
+      console.error('Failed to translate article:', err);
+    } finally {
+      setIsTranslating(false);
+    }
+  };
+
+  return (
+    <div className="flex items-center space-x-2 text-xs">
+      <div className="flex items-center space-x-1.5 bg-gray-100 hover:bg-gray-200 border border-gray-300 rounded px-2 py-1 text-gray-700 transition">
+        <LanguageIcon className="w-4 h-4 text-amber-500 flex-shrink-0" />
+        <span className="font-semibold hidden sm:inline">Translate:</span>
+        <select
+          value={selectedLang}
+          onChange={e => handleLanguageChange(e.target.value)}
+          disabled={isTranslating}
+          className="bg-transparent border-none text-xs font-medium text-gray-800 cursor-pointer focus:outline-none pr-1"
+        >
+          <option value="en">Original (English)</option>
+          {SUPPORTED_LANGUAGES.filter(l => l.code !== 'en').map(lang => (
+            <option key={lang.code} value={lang.code}>
+              {lang.name}
+            </option>
+          ))}
+        </select>
+        {isTranslating && (
+          <ArrowPathIcon className="w-3.5 h-3.5 text-amber-500 animate-spin flex-shrink-0" />
+        )}
+      </div>
+
+      {translatedToLangName && (
+        <button
+          onClick={() => handleLanguageChange('en')}
+          className="text-xs text-amber-700 hover:text-amber-800 underline font-medium"
+        >
+          Reset to English
+        </button>
+      )}
+    </div>
+  );
+}
