diff --git a/src/components/TextTranslator.tsx b/src/components/TextTranslator.tsx
new file mode 100644
index 0000000..051e04e
--- /dev/null
+++ b/src/components/TextTranslator.tsx
@@ -0,0 +1,392 @@
+import React, { useState, useEffect, useRef } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  isTranslatorSupported,
+  isLanguageDetectorSupported,
+  checkTranslatorAvailability,
+  detectLanguage,
+  translateText,
+} from '../utils/translator';
+
+interface TextTranslatorProps {
+  initialText?: string;
+  onClose?: () => void;
+}
+
+export default function TextTranslator({ initialText = '', onClose }: TextTranslatorProps) {
+  const [sourceLang, setSourceLang] = useState<string>('en');
+  const [targetLang, setTargetLang] = useState<string>('es');
+  const [sourceText, setSourceText] = useState<string>(initialText);
+  const [translatedText, setTranslatedText] = useState<string>('');
+  const [isLoading, setIsLoading] = useState<boolean>(false);
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [availabilityStatus, setAvailabilityStatus] = useState<string>('');
+  const [translationSource, setTranslationSource] = useState<'on-device' | 'cloud-fallback' | null>(null);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [copied, setCopied] = useState<boolean>(false);
+  const [detectedLangName, setDetectedLangName] = useState<string | null>(null);
+
+  const hasOnDeviceAI = isTranslatorSupported();
+  const textareaRef = useRef<HTMLTextAreaElement>(null);
+
+  // Check availability when language pair changes
+  useEffect(() => {
+    let active = true;
+    const checkAvailability = async () => {
+      if (sourceLang === 'auto') {
+        setAvailabilityStatus('auto');
+        return;
+      }
+      const status = await checkTranslatorAvailability(sourceLang, targetLang);
+      if (active) {
+        setAvailabilityStatus(status);
+      }
+    };
+    checkAvailability();
+    return () => {
+      active = false;
+    };
+  }, [sourceLang, targetLang]);
+
+  // Handle auto language detection
+  const handleDetect = async (text: string) => {
+    if (!text || text.trim().length < 3) return;
+    try {
+      const detected = await detectLanguage(text);
+      if (detected) {
+        const langObj = SUPPORTED_LANGUAGES.find(l => l.code === detected);
+        setDetectedLangName(langObj ? langObj.name : detected);
+        if (sourceLang === 'auto') {
+          return detected;
+        }
+      }
+    } catch (e) {
+      console.warn('Language detection error:', e);
+    }
+    return null;
+  };
+
+  const handleTranslate = async () => {
+    if (!sourceText.trim()) return;
+
+    setIsLoading(true);
+    setErrorMessage(null);
+    setDownloadProgress(null);
+    setCopied(false);
+
+    try {
+      let effectiveSource = sourceLang;
+      if (sourceLang === 'auto') {
+        const detected = await handleDetect(sourceText);
+        effectiveSource = detected || 'en';
+      }
+
+      const result = await translateText({
+        text: sourceText,
+        sourceLanguage: effectiveSource,
+        targetLanguage: targetLang,
+        onProgress: (percent) => {
+          setDownloadProgress(percent);
+        },
+        onChunk: (chunk) => {
+          setTranslatedText(chunk);
+        },
+      });
+
+      setTranslatedText(result.text);
+      setTranslationSource(result.source);
+      setDownloadProgress(null);
+    } catch (err: any) {
+      console.error('Translation failed:', err);
+      setErrorMessage(err.message || 'Translation failed. Please try again.');
+    } finally {
+      setIsLoading(false);
+    }
+  };
+
+  const handleSwapLanguages = () => {
+    if (sourceLang === 'auto') return;
+    const tempLang = sourceLang;
+    setSourceLang(targetLang);
+    setTargetLang(tempLang);
+    const tempText = sourceText;
+    setSourceText(translatedText);
+    setTranslatedText(tempText);
+    setTranslationSource(null);
+  };
+
+  const handleCopy = async () => {
+    if (!translatedText) return;
+    try {
+      await navigator.clipboard.writeText(translatedText);
+      setCopied(true);
+      setTimeout(() => setCopied(false), 2000);
+    } catch (e) {
+      console.error('Failed to copy to clipboard', e);
+    }
+  };
+
+  const samplePhrases = [
+    'Welcome to The DevTools Times!',
+    'Chrome DevTools provides powerful web debugging tools.',
+    'Fast and reliable on-device AI translation.',
+  ];
+
+  return (
+    <div className="w-full">
+      {/* Header & Status Indicator */}
+      <div className="flex flex-wrap items-center justify-between pb-3 border-b border-gray-200 gap-2">
+        <div className="flex items-center space-x-2">
+          <svg className="w-6 h-6 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
+            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
+          </svg>
+          <h2 className="text-xl font-bold text-gray-800">Language Translator</h2>
+        </div>
+
+        <div className="flex items-center space-x-2 text-xs">
+          {hasOnDeviceAI ? (
+            <span className="inline-flex items-center px-2.5 py-0.5 rounded-full font-medium bg-emerald-100 text-emerald-800">
+              <span className="w-2 h-2 mr-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
+              On-Device AI (Translator API)
+            </span>
+          ) : (
+            <span className="inline-flex items-center px-2.5 py-0.5 rounded-full font-medium bg-blue-100 text-blue-800">
+              <span className="w-2 h-2 mr-1.5 bg-blue-500 rounded-full"></span>
+              Cloud Remote Fallback
+            </span>
+          )}
+
+          {availabilityStatus === 'downloadable' && (
+            <span className="px-2 py-0.5 rounded bg-amber-100 text-amber-800 font-medium">
+              Download required
+            </span>
+          )}
+        </div>
+      </div>
+
+      {/* Language Selector Bar */}
+      <div className="grid grid-cols-1 sm:grid-cols-[1fr,auto,1fr] gap-2 items-center my-4">
+        {/* Source Language */}
+        <div className="flex flex-col">
+          <label className="text-xs font-semibold text-gray-500 mb-1">Source Language</label>
+          <select
+            value={sourceLang}
+            onChange={(e) => setSourceLang(e.target.value)}
+            className="w-full p-2 border border-gray-300 rounded-md bg-white text-sm font-medium focus:ring-2 focus:ring-amber-400 focus:outline-none"
+          >
+            <option value="auto">Auto-detect {detectedLangName ? `(${detectedLangName})` : ''}</option>
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={`src-${lang.code}`} value={lang.code}>
+                {lang.name} ({lang.code})
+              </option>
+            ))}
+          </select>
+        </div>
+
+        {/* Swap Button */}
+        <div className="flex justify-center sm:pt-5">
+          <button
+            type="button"
+            onClick={handleSwapLanguages}
+            disabled={sourceLang === 'auto'}
+            title={sourceLang === 'auto' ? 'Cannot swap with auto-detect' : 'Swap languages'}
+            className={`p-2 rounded-full border border-gray-300 hover:bg-gray-100 transition ${
+              sourceLang === 'auto' ? 'opacity-40 cursor-not-allowed' : 'text-gray-700 hover:text-amber-500'
+            }`}
+          >
+            <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
+              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
+            </svg>
+          </button>
+        </div>
+
+        {/* Target Language */}
+        <div className="flex flex-col">
+          <label className="text-xs font-semibold text-gray-500 mb-1">Target Language</label>
+          <select
+            value={targetLang}
+            onChange={(e) => setTargetLang(e.target.value)}
+            className="w-full p-2 border border-gray-300 rounded-md bg-white text-sm font-medium focus:ring-2 focus:ring-amber-400 focus:outline-none"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={`tgt-${lang.code}`} value={lang.code}>
+                {lang.name} ({lang.code})
+              </option>
+            ))}
+          </select>
+        </div>
+      </div>
+
+      {/* Model Download Progress Bar */}
+      {downloadProgress !== null && (
+        <div className="mb-4 bg-amber-50 border border-amber-200 rounded-md p-3">
+          <div className="flex justify-between text-xs text-amber-900 font-medium mb-1">
+            <span>Downloading on-device translation model...</span>
+            <span>{downloadProgress}%</span>
+          </div>
+          <div className="w-full bg-amber-200 rounded-full h-2">
+            <div
+              className="bg-amber-500 h-2 rounded-full transition-all duration-300"
+              style={{ width: `${downloadProgress}%` }}
+            ></div>
+          </div>
+          <p className="text-[11px] text-amber-700 mt-1">
+            Gemini on-device model will be stored locally for offline, private translation.
+          </p>
+        </div>
+      )}
+
+      {/* Translation Text Areas */}
+      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
+        {/* Source Text Input */}
+        <div className="flex flex-col">
+          <div className="relative">
+            <textarea
+              ref={textareaRef}
+              rows={6}
+              value={sourceText}
+              onChange={(e) => setSourceText(e.target.value)}
+              placeholder="Enter text to translate..."
+              className="w-full p-3 border border-gray-300 rounded-md text-sm text-gray-900 focus:ring-2 focus:ring-amber-400 focus:outline-none resize-none"
+            />
+            {sourceText && (
+              <button
+                type="button"
+                onClick={() => {
+                  setSourceText('');
+                  setTranslatedText('');
+                  setTranslationSource(null);
+                }}
+                className="absolute top-2 right-2 text-gray-400 hover:text-gray-600 p-1"
+                title="Clear text"
+              >
+                <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
+                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M6 18L18 6M6 6l12 12" />
+                </svg>
+              </button>
+            )}
+          </div>
+
+          {/* Quick sample chips */}
+          <div className="mt-2">
+            <span className="text-[11px] text-gray-500 mr-1">Quick try:</span>
+            <div className="flex flex-wrap gap-1 mt-1">
+              {samplePhrases.map((phrase, i) => (
+                <button
+                  key={i}
+                  type="button"
+                  onClick={() => setSourceText(phrase)}
+                  className="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-2 py-0.5 rounded transition"
+                >
+                  {phrase}
+                </button>
+              ))}
+            </div>
+          </div>
+        </div>
+
