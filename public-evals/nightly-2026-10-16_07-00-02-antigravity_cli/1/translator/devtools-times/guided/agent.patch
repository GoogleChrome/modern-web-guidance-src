index 0000000..729f3e6
--- /dev/null
+++ b/src/components/TranslateFlyout.tsx
@@ -0,0 +1,52 @@
+import React, { useEffect } from 'react';
+import TextTranslator from './TextTranslator';
+
+interface Props {
+  onClose: () => void;
+  initialText?: string;
+}
+
+export default function TranslateFlyout({ onClose, initialText }: Props) {
+  useEffect(() => {
+    const handleKeyDown = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') {
+        onClose();
+      }
+    };
+    window.addEventListener('keydown', handleKeyDown);
+    return () => {
+      window.removeEventListener('keydown', handleKeyDown);
+    };
+  }, [onClose]);
+
+  return (
+    <div
+      className="fixed inset-0 bg-white/30 backdrop-blur-sm z-[99999] flex justify-center items-start p-4 pt-[10vh] overflow-y-auto"
+      onClick={onClose}
+    >
+      <div
+        className="bg-white shadow-2xl w-full max-w-2xl rounded-xl p-6 relative my-8 border border-gray-200"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <button
+          onClick={onClose}
+          className="absolute -top-2 -right-2 bg-white rounded-full p-1 shadow-md text-gray-500 hover:text-amber-500 hover:scale-110 transition-transform z-10"
+          title="Close translator"
+        >
+          <svg
+            xmlns="http://www.w3.org/2000/svg"
+            className="h-6 w-6"
+            fill="none"
+            viewBox="0 0 24 24"
+            stroke="currentColor"
+            strokeWidth={2}
+          >
+            <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
+          </svg>
+        </button>
+
+        <TextTranslator initialText={initialText} onClose={onClose} />
+      </div>
+    </div>
+  );
+}
