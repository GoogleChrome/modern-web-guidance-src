diff --git a/src/components/ArticleTranslator.tsx b/src/components/ArticleTranslator.tsx
new file mode 100644
index 0000000..b0f0f15
--- /dev/null
+++ b/src/components/ArticleTranslator.tsx
@@ -0,0 +1,235 @@
+import React, { useState, useEffect, useRef } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  isTranslatorSupported,
+  checkTranslatorAvailability,
+  translateText,
+} from '../utils/translator';
+
+interface ArticleTranslatorProps {
+  originalTitle: string;
+  originalSummary: string;
+}
+
+export default function ArticleTranslator({
+  originalTitle,
+  originalSummary,
+}: ArticleTranslatorProps) {
+  const [targetLang, setTargetLang] = useState('es');
+  const [isTranslating, setIsTranslating] = useState(false);
+  const [isTranslated, setIsTranslated] = useState(false);
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [translationSource, setTranslationSource] = useState<'on-device' | 'cloud-fallback' | null>(null);
+
+  const originalParagraphsRef = useRef<string[]>([]);
+  const hasOnDeviceAI = isTranslatorSupported();
+
+  const handleTranslateArticle = async () => {
+    setIsTranslating(true);
+    setErrorMessage(null);
+    setDownloadProgress(null);
+
+    try {
+      // 1. Translate Title & Summary
+      const titlePromise = translateText({
+        text: originalTitle,
+        sourceLanguage: 'en',
+        targetLanguage: targetLang,
+        onProgress: (p) => setDownloadProgress(p),
+      });
+
+      const summaryPromise = translateText({
+        text: originalSummary,
+        sourceLanguage: 'en',
+        targetLanguage: targetLang,
+      });
+
+      // 2. Find and translate article body paragraphs
+      const proseElement = document.querySelector('.prose');
+      const paragraphs = proseElement ? Array.from(proseElement.querySelectorAll('p')) : [];
+
+      if (originalParagraphsRef.current.length === 0 && paragraphs.length > 0) {
+        originalParagraphsRef.current = paragraphs.map((p) => p.innerHTML);
+      }
+
+      const paragraphPromises = paragraphs.map(async (p, idx) => {
+        const textToTranslate = p.innerText.trim();
+        if (!textToTranslate) return;
+        const res = await translateText({
+          text: textToTranslate,
+          sourceLanguage: 'en',
+          targetLanguage: targetLang,
+        });
+        p.innerText = res.text;
+      });
+
+      const [titleRes, summaryRes] = await Promise.all([
+        titlePromise,
+        summaryPromise,
+        ...paragraphPromises,
+      ]);
+
+      // Update H1 headline
+      const headlineEl = document.querySelector('h1');
+      if (headlineEl) {
+        headlineEl.innerText = titleRes.text;
+      }
+
+      // Update lead paragraph / summary
+      const summaryEl = document.querySelector('p.text-lg, p.text-xl');
+      if (summaryEl) {
+        summaryEl.innerText = summaryRes.text;
+      }
+
+      setTranslationSource(titleRes.source);
+      setIsTranslated(true);
+      setDownloadProgress(null);
+    } catch (err: any) {
+      console.error('Failed to translate article:', err);
+      setErrorMessage(err.message || 'Translation failed.');
+    } finally {
+      setIsTranslating(false);
+    }
+  };
+
+  const handleRestoreOriginal = () => {
+    // Restore Title
+    const headlineEl = document.querySelector('h1');
+    if (headlineEl) {
+      headlineEl.innerText = originalTitle;
+    }
+
+    // Restore Summary
+    const summaryEl = document.querySelector('p.text-lg, p.text-xl');
+    if (summaryEl) {
+      summaryEl.innerText = originalSummary;
+    }
+
+    // Restore Paragraphs
+    const proseElement = document.querySelector('.prose');
+    const paragraphs = proseElement ? Array.from(proseElement.querySelectorAll('p')) : [];
+    paragraphs.forEach((p, idx) => {
+      if (originalParagraphsRef.current[idx]) {
+        p.innerHTML = originalParagraphsRef.current[idx];
+      }
+    });
+
+    setIsTranslated(false);
+    setTranslationSource(null);
+    setErrorMessage(null);
+  };
+
+  return (
+    <div className="bg-gray-50 border border-gray-200 rounded-lg p-3 my-4">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        {/* Left: Controls */}
+        <div className="flex flex-wrap items-center gap-2">
+          <div className="flex items-center space-x-1.5 text-gray-700">
+            <svg
+              className="w-4 h-4 text-amber-500"
+              fill="none"
+              viewBox="0 0 24 24"
+              stroke="currentColor"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                strokeWidth="2"
+                d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
+              />
+            </svg>
+            <span className="text-xs font-semibold uppercase tracking-wider text-gray-600">
+              Translate Article
+            </span>
+          </div>
+
+          {!isTranslated ? (
+            <div className="flex items-center space-x-2">
+              <select
+                value={targetLang}
+                onChange={(e) => setTargetLang(e.target.value)}
+                disabled={isTranslating}
+                className="text-xs bg-white border border-gray-300 rounded px-2 py-1 font-medium text-gray-700 focus:outline-none focus:ring-1 focus:ring-amber-400"
+              >
+                {SUPPORTED_LANGUAGES.filter((l) => l.code !== 'en').map((lang) => (
+                  <option key={lang.code} value={lang.code}>
+                    {lang.name}
+                  </option>
+                ))}
+              </select>
+
+              <button
+                type="button"
+                onClick={handleTranslateArticle}
+                disabled={isTranslating}
+                className="text-xs bg-amber-500 hover:bg-amber-600 disabled:opacity-50 text-white font-semibold px-3 py-1 rounded transition flex items-center space-x-1.5 shadow-sm"
+              >
+                {isTranslating ? (
+                  <>
+                    <div className="w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
+                    <span>Translating...</span>
+                  </>
+                ) : (
+                  <span>Translate</span>
+                )}
+              </button>
+            </div>
+          ) : (
+            <div className="flex items-center space-x-2">
+              <span className="text-xs font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
+                ✓ Translated to{' '}
+                {SUPPORTED_LANGUAGES.find((l) => l.code === targetLang)?.name || targetLang}
+              </span>
+              <button
+                type="button"
+                onClick={handleRestoreOriginal}
+                className="text-xs bg-white hover:bg-gray-100 border border-gray-300 text-gray-700 font-medium px-2.5 py-1 rounded transition"
+              >
+                Show Original
+              </button>
+            </div>
+          )}
+        </div>
+
+        {/* Right: Status badge */}
+        <div className="text-[11px] text-gray-500 flex items-center space-x-2">
+          {translationSource ? (
+            <span>
+              {translationSource === 'on-device'
+                ? '⚡ On-device AI'
+                : '☁️ Cloud fallback'}
+            </span>
+          ) : hasOnDeviceAI ? (
+            <span className="text-emerald-700">● On-device Built-in AI ready</span>
+          ) : (
+            <span className="text-gray-500">Cloud fallback available</span>
+          )}
+        </div>
+      </div>
+
+      {/* Download progress bar */}
+      {downloadProgress !== null && (
+        <div className="mt-2 pt-2 border-t border-gray-200">
+          <div className="flex justify-between text-xs text-amber-800 mb-1">
+            <span>Downloading translation language model...</span>
+            <span>{downloadProgress}%</span>
+          </div>
+          <div className="w-full bg-amber-100 rounded-full h-1.5">
+            <div
+              className="bg-amber-500 h-1.5 rounded-full transition-all"
+              style={{ width: `${downloadProgress}%` }}
+            ></div>
+          </div>
+        </div>
+      )}
+
+      {/* Error notification */}
+      {errorMessage && (
+        <div className="mt-2 text-xs text-red-600 bg-red-50 p-2 rounded border border-red-200">
+          {errorMessage}
+        </div>
+      )}
+    </div>
+  );
+}
