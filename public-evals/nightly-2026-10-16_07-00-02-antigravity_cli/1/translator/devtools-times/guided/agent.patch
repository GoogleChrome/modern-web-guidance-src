@@ -0,0 +1,202 @@
+export interface LanguageOption {
+  code: string;
+  name: string;
+}
+
+export const SUPPORTED_LANGUAGES: LanguageOption[] = [
+  { code: 'ar', name: 'Arabic' },
+  { code: 'bg', name: 'Bulgarian' },
+  { code: 'bn', name: 'Bengali' },
+  { code: 'cs', name: 'Czech' },
+  { code: 'da', name: 'Danish' },
+  { code: 'de', name: 'German' },
+  { code: 'el', name: 'Greek' },
+  { code: 'en', name: 'English' },
+  { code: 'es', name: 'Spanish' },
+  { code: 'fi', name: 'Finnish' },
+  { code: 'fr', name: 'French' },
+  { code: 'hi', name: 'Hindi' },
+  { code: 'hr', name: 'Croatian' },
+  { code: 'hu', name: 'Hungarian' },
+  { code: 'id', name: 'Indonesian' },
+  { code: 'it', name: 'Italian' },
+  { code: 'he', name: 'Hebrew' },
+  { code: 'ja', name: 'Japanese' },
+  { code: 'kn', name: 'Kannada' },
+  { code: 'ko', name: 'Korean' },
+  { code: 'lt', name: 'Lithuanian' },
+  { code: 'mr', name: 'Marathi' },
+  { code: 'nl', name: 'Dutch' },
+  { code: 'no', name: 'Norwegian' },
+  { code: 'pl', name: 'Polish' },
+  { code: 'pt', name: 'Portuguese' },
+  { code: 'ro', name: 'Romanian' },
+  { code: 'ru', name: 'Russian' },
+  { code: 'sk', name: 'Slovak' },
+  { code: 'sl', name: 'Slovenian' },
+  { code: 'sv', name: 'Swedish' },
+  { code: 'ta', name: 'Tamil' },
+  { code: 'te', name: 'Telugu' },
+  { code: 'th', name: 'Thai' },
+  { code: 'tr', name: 'Turkish' },
+  { code: 'uk', name: 'Ukrainian' },
+  { code: 'vi', name: 'Vietnamese' },
+  { code: 'zh', name: 'Chinese' },
+  { code: 'zh-Hant', name: 'Chinese (Traditional)' },
+];
+
+export function isTranslatorSupported(): boolean {
+  return typeof self !== 'undefined' && 'Translator' in self;
+}
+
+export function isLanguageDetectorSupported(): boolean {
+  return typeof self !== 'undefined' && 'LanguageDetector' in self;
+}
+
+export async function checkTranslatorAvailability(
+  sourceLanguage: string,
+  targetLanguage: string
+): Promise<'available' | 'downloadable' | 'downloading' | 'unavailable' | 'unsupported'> {
+  if (!isTranslatorSupported()) {
+    return 'unsupported';
+  }
+  try {
+    const options = { sourceLanguage, targetLanguage };
+    return await (self as any).Translator.availability(options);
+  } catch (e) {
+    console.warn('Translator.availability check failed:', e);
+    return 'unavailable';
+  }
+}
+
+export async function detectLanguage(text: string): Promise<string | null> {
+  if (!text || text.trim().length < 3) return null;
+
+  if (isLanguageDetectorSupported()) {
+    try {
+      const availability = await (self as any).LanguageDetector.availability();
+      if (availability !== 'unavailable') {
+        const detector = await (self as any).LanguageDetector.create({
+          monitor(m: any) {
+            m.addEventListener('downloadprogress', (e: any) => {
+              console.log(`LanguageDetector downloaded ${Math.round((e.loaded || 0) * 100)}%`);
+            });
+          },
+        });
+        const results = await detector.detect(text);
+        if (results && results.length > 0 && results[0].detectedLanguage) {
+          return results[0].detectedLanguage;
+        }
+      }
+    } catch (err) {
+      console.warn('On-device LanguageDetector error:', err);
+    }
+  }
+
+  return null;
+}
+
+export interface TranslateExecutionOptions {
+  text: string;
+  sourceLanguage: string;
+  targetLanguage: string;
+  onProgress?: (percent: number) => void;
+  onChunk?: (chunk: string) => void;
+}
+
+export interface TranslateResult {
+  text: string;
+  source: 'on-device' | 'cloud-fallback';
+}
+
+export async function translateText({
+  text,
+  sourceLanguage,
+  targetLanguage,
+  onProgress,
+  onChunk,
+}: TranslateExecutionOptions): Promise<TranslateResult> {
+  if (!text || !text.trim()) {
+    return { text: '', source: 'on-device' };
+  }
+
+  // 1. Try On-Device Translator API if available
+  if (isTranslatorSupported()) {
+    const options = {
+      sourceLanguage,
+      targetLanguage,
+    };
+
+    try {
+      const availability = await (self as any).Translator.availability(options);
+      if (availability !== 'unavailable') {
+        const createOptions: any = {
+          ...options,
+        };
+
+        if (onProgress) {
+          createOptions.monitor = (m: any) => {
+            m.addEventListener('downloadprogress', (e: any) => {
+              const loaded = e.loaded ?? 0;
+              const total = e.total;
+              const percent = total && total > 0 ? Math.round((loaded / total) * 100) : Math.round(loaded * 100);
+              onProgress(Math.min(100, Math.max(0, percent)));
+            });
+          };
+        }
+
+        const translator = await (self as any).Translator.create(createOptions);
+
+        if (onChunk && typeof translator.translateStreaming === 'function') {
+          const stream = translator.translateStreaming(text);
+          let accumulated = '';
+          for await (const chunk of stream) {
+            accumulated += chunk;
+            onChunk(accumulated);
+          }
+          return { text: accumulated || text, source: 'on-device' };
+        } else {
+          const result = await translator.translate(text);
+          if (onChunk) onChunk(result);
+          return { text: result, source: 'on-device' };
+        }
+      }
+    } catch (err) {
+      console.warn('Translator API error, falling back to remote translation:', err);
+    }
+  }
+
+  // 2. Fallback strategy: Remote API Fallback
+  try {
+    const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
+    const response = await fetch(`${baseUrl}api/translate`, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+      },
+      body: JSON.stringify({
+        text,
+        sourceLanguage,
+        targetLanguage,
+      }),
+    });
+
+    if (response.ok) {
+      const data = await response.json();
+      if (data.translation) {
+        if (onChunk) onChunk(data.translation);
+        return { text: data.translation, source: 'cloud-fallback' };
+      }
+    }
+
+    const errData = await response.json().catch(() => ({}));
+    throw new Error(errData.message || 'Remote translation failed');
+  } catch (remoteErr: any) {
+    // 3. Graceful degradation
+    console.error('All translation options failed:', remoteErr);
+    throw new Error(
+      remoteErr?.message ||
+        'Translation is currently unsupported in this browser or offline. Please check your connection or use Chrome 138+ with Built-in AI.'
+    );
+  }
+}
