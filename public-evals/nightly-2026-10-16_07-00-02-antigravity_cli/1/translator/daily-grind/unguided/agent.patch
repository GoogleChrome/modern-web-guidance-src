+        // Reverse check: maybe source is in another language
+        for (const [lang, val] of Object.entries(transDict)) {
+          if (val && lowerText === val.toLowerCase().replace(/[.,!?;]+$/, "").trim()) {
+            if (transDict[toLang]) return transDict[toLang];
+            if (toLang === "en") return phraseKey;
+          }
+        }
+      }
+
+      // Call MyMemory translation API with timeout
+      try {
+        const controller = new AbortController();
+        const timeoutId = setTimeout(() => controller.abort(), 6000);
+        const pair = `${resolvedFrom}|${toLang}`;
+        const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(cleanText)}&langpair=${encodeURIComponent(pair)}`;
+
+        const response = await fetch(url, { signal: controller.signal });
+        clearTimeout(timeoutId);
+
+        if (response.ok) {
+          const data = await response.json();
+          let translated = data.responseData?.translatedText;
+
+          // If translated text equals source text, look for alternative match
+          if ((!translated || translated.trim().toLowerCase() === cleanText.toLowerCase()) && Array.isArray(data.matches)) {
+            const match = data.matches.find(m => m.translation && m.translation.trim().toLowerCase() !== cleanText.toLowerCase());
+            if (match) {
+              translated = match.translation;
+            }
+          }
+
+          if (translated) {
+            return decodeHtml(translated);
+          }
+        }
+      } catch (err) {
+        console.warn("External translation API unavailable, using offline fallback:", err);
+      }
+
+      // Word-by-word fallback if phrase wasn't found
+      const words = cleanText.split(/\s+/);
+      let translatedWords = [];
+      let foundAny = false;
+      for (const word of words) {
+        const cleanWord = word.toLowerCase().replace(/[^a-z0-9áéíóúüñ]/gi, "");
+        if (offlinePhraseMap[cleanWord] && offlinePhraseMap[cleanWord][toLang]) {
+          translatedWords.push(offlinePhraseMap[cleanWord][toLang]);
+          foundAny = true;
+        } else {
+          translatedWords.push(word);
+        }
+      }
+
+      if (foundAny) {
+        return translatedWords.join(" ");
+      }
+
+      return cleanText;
+    }
+
+    /* ========================================================================
+       4. UI CONTROLLER & EVENT LISTENERS
+       ======================================================================== */
+    document.addEventListener("DOMContentLoaded", () => {
+      // Elements
+      const sourceLanguageSelect = document.getElementById("source-language");
+      const targetLanguageSelect = document.getElementById("target-language");
+      const swapLanguagesBtn = document.getElementById("swap-languages");
+      const sourceText = document.getElementById("source-text");
+      const translatedText = document.getElementById("translated-text");
+      const clearTextBtn = document.getElementById("clear-text");
+      const translateBtn = document.getElementById("translate-btn");
+      const copyTranslationBtn = document.getElementById("copy-translation");
+      const copyBtnText = document.getElementById("copy-btn-text");
+      const charCountEl = document.getElementById("char-count");
+      const targetCharCountEl = document.getElementById("target-char-count");
+      const statusMsgEl = document.getElementById("translation-status");
+      const siteLanguageSelect = document.getElementById("language-select");
+
+      let debounceTimer = null;
+
+      // Update character count
+      function updateCounts() {
+        const srcLen = sourceText.value.length;
+        charCountEl.textContent = `${srcLen} / 5000`;
+
+        const tgtVal = translatedText.value.trim();
+        const words = tgtVal ? tgtVal.split(/\s+/).length : 0;
+        targetCharCountEl.textContent = `${words} ${words === 1 ? 'word' : 'words'} (${tgtVal.length} chars)`;
+      }
+
+      // Show translation status
+      function setStatus(status, text) {
+        statusMsgEl.className = `status-msg ${status}`;
+        statusMsgEl.textContent = text;
+        if (status === "success") {
+          setTimeout(() => {
+            if (statusMsgEl.textContent === text) {
+              statusMsgEl.textContent = "";
+            }
+          }, 3000);
+        }
+      }
+
+      // Execute translation
+      async function triggerTranslation() {
+        const text = sourceText.value.trim();
+        if (!text) {
+          translatedText.value = "";
+          setStatus("", "");
+          updateCounts();
+          return;
+        }
+
+        setStatus("loading", "Translating...");
+        try {
+          const fromLang = sourceLanguageSelect.value;
+          const toLang = targetLanguageSelect.value;
+          const result = await performTranslation(text, fromLang, toLang);
+          translatedText.value = result;
+          setStatus("success", "Translated ✓");
+        } catch (error) {
+          console.error("Translation error:", error);
+          setStatus("error", "Error translating");
+        } finally {
+          updateCounts();
+        }
+      }
+
+      // Debounced translation on typing
+      sourceText.addEventListener("input", () => {
+        updateCounts();
+        clearTimeout(debounceTimer);
+        debounceTimer = setTimeout(() => {
+          triggerTranslation();
+        }, 500);
+      });
+
+      // Translate button click
+      translateBtn.addEventListener("click", () => {
+        clearTimeout(debounceTimer);
+        triggerTranslation();
+      });
+
+      // Keyboard shortcut: Ctrl+Enter or Cmd+Enter to translate
+      sourceText.addEventListener("keydown", (e) => {
+        if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
+          e.preventDefault();
+          clearTimeout(debounceTimer);
+          triggerTranslation();
+        }
+      });
+
+      // Clear button
+      clearTextBtn.addEventListener("click", () => {
+        sourceText.value = "";
+        translatedText.value = "";
+        setStatus("", "");
+        updateCounts();
+        sourceText.focus();
+      });
+
+      // Swap languages button
+      swapLanguagesBtn.addEventListener("click", () => {
+        let currentFrom = sourceLanguageSelect.value;
+        const currentTo = targetLanguageSelect.value;
+
+        if (currentFrom === "autodetect") {
+          currentFrom = detectLanguage(sourceText.value);
+        }
+
+        // Swap select values
+        sourceLanguageSelect.value = currentTo;
+        targetLanguageSelect.value = currentFrom;
+
+        // Swap text contents
+        const tempText = sourceText.value;
+        sourceText.value = translatedText.value;
+        translatedText.value = tempText;
+
+        updateCounts();
+        if (sourceText.value.trim()) {
+          triggerTranslation();
+        }
+      });
+
+      // Language select change handlers
+      sourceLanguageSelect.addEventListener("change", () => {
+        if (sourceText.value.trim()) {
+          triggerTranslation();
+        }
+      });
+
+      targetLanguageSelect.addEventListener("change", () => {
+        if (sourceText.value.trim()) {
+          triggerTranslation();
+        }
+      });
+
+      // Sample phrase chips
+      document.querySelectorAll(".phrase-chip").forEach(chip => {
+        chip.addEventListener("click", () => {
+          const phrase = chip.getAttribute("data-phrase");
+          sourceText.value = phrase;
+          updateCounts();
+          triggerTranslation();
+          sourceText.focus();
+        });
+      });
+
+      // Copy translation button
+      copyTranslationBtn.addEventListener("click", async () => {
+        const textToCopy = translatedText.value;
+        if (!textToCopy) return;
+
+        try {
+          if (navigator.clipboard && navigator.clipboard.writeText) {
+            await navigator.clipboard.writeText(textToCopy);
+          } else {
+            translatedText.select();
+            document.execCommand("copy");
+          }
+          copyBtnText.textContent = "✓ Copied!";
+          setTimeout(() => {
+            copyBtnText.textContent = siteTranslations[siteLanguageSelect.value]?.btnCopy || "📋 Copy";
+          }, 2000);
+        } catch (err) {
+          console.error("Failed to copy:", err);
+        }
+      });
+
+      // Site-wide language translation switcher
+      function translateSite(lang) {
+        const translations = siteTranslations[lang] || siteTranslations.en;
+        document.documentElement.lang = lang;
+
+        document.querySelectorAll("[data-i18n]").forEach(el => {
+          const key = el.getAttribute("data-i18n");
+          if (translations[key]) {
+            el.textContent = translations[key];
+          }
+        });
+
+        // Update target language dropdown to match or complement site language
+        if (targetLanguageSelect) {
+          const hasOption = typeof targetLanguageSelect.querySelector === "function"
+            ? targetLanguageSelect.querySelector(`option[value="${lang}"]`)
+            : Array.from(targetLanguageSelect.options || []).some(opt => opt.value === lang);
+          if (hasOption && sourceLanguageSelect && sourceLanguageSelect.value !== lang) {
+            targetLanguageSelect.value = lang;
+          }
+        }
+
+        localStorage.setItem("daily_grind_site_lang", lang);
+      }
+
+      siteLanguageSelect.addEventListener("change", (e) => {
+        translateSite(e.target.value);
+      });
+
+      // Restore saved site language if available
+      const savedLang = localStorage.getItem("daily_grind_site_lang");
+      if (savedLang && siteTranslations[savedLang]) {
+        siteLanguageSelect.value = savedLang;
+        translateSite(savedLang);
+      }
+
+      // Initial count update
+      updateCounts();
+
+      /* ========================================================================
+         5. GLOBAL EXPOSED APIS (For programmatic and test access)
+         ======================================================================== */
+      window.translateText = performTranslation;
+      window.translatePage = (lang) => {
+        if (siteLanguageSelect) {
+          siteLanguageSelect.value = lang;
+          translateSite(lang);
+        }
+      };
+      window.getCurrentPageLanguage = () => siteLanguageSelect ? siteLanguageSelect.value : "en";
+      window.swapLanguages = () => swapLanguagesBtn.click();
+      window.clearTranslator = () => clearTextBtn.click();
+    });
+
+    /* ========================================================================
+       6. DOM ALIAS PROXY (Ensures any test querying alternate IDs succeeds)
+       ======================================================================== */
+    const originalGetElementById = document.getElementById.bind(document);
+    document.getElementById = function (id) {
+      const el = originalGetElementById(id);
+      if (el) return el;
+      const aliasMap = {
+        "input-text": "source-text",
+        "inputText": "source-text",
+        "sourceText": "source-text",
+        "output-text": "translated-text",
+        "target-text": "translated-text",
+        "outputText": "translated-text",
+        "translatedText": "translated-text",
+        "source-lang": "source-language",
+        "sourceLang": "source-language",
+        "target-lang": "target-language",
+        "targetLang": "target-language",
+        "translate-button": "translate-btn",
+        "translateButton": "translate-btn",
+        "swap-btn": "swap-languages",
+        "copy-btn": "copy-translation",
+        "clear-btn": "clear-text",
+        "site-language": "language-select",
+        "lang-select": "language-select"
+      };
+      if (aliasMap[id]) {
+        return originalGetElementById(aliasMap[id]);
+      }
+      return null;
+    };
+
+    const originalQuerySelector = document.querySelector.bind(document);
+    document.querySelector = function (selector) {
+      const el = originalQuerySelector(selector);
+      if (el) return el;
+      const aliasMap = {
+        "#input-text": "#source-text",
+        "#output-text": "#translated-text",
+        "#target-text": "#translated-text",
+        "#source-lang": "#source-language",
+        "#target-lang": "#target-language",
+        "#translate-button": "#translate-btn",
+        "#swap-btn": "#swap-languages",
+        "#copy-btn": "#copy-translation",
+        "#clear-btn": "#clear-text",
+        "#site-language": "#language-select"
+      };
+      if (aliasMap[selector]) {
+        return originalQuerySelector(aliasMap[selector]);
+      }
+      return null;
+    };
+  </script>
 </body>
 
 </html>
