+/**
+ * The Daily Grind - Multilingual Translation Engine
+ * 
+ * Supports:
+ * 1. On-device Built-in AI Translator API ('Translator' in self) with downloadprogress monitoring
+ * 2. On-device Built-in AI LanguageDetector API ('LanguageDetector' in self)
+ * 3. Graceful Fallback to Remote Translation API and Offline Phrasebook
+ * 4. Website content dynamic translation and localization
+ */
+
+(function () {
+  'use strict';
+
+  // Global or module export support
+  const getTranslations = () => (typeof SITE_TRANSLATIONS !== 'undefined') ? SITE_TRANSLATIONS : (window.SITE_TRANSLATIONS || {});
+  const getDictionary = () => (typeof OFFLINE_DICTIONARY !== 'undefined') ? OFFLINE_DICTIONARY : (window.OFFLINE_DICTIONARY || {});
+
+  // State
+  let activeTranslator = null;
+  let currentPair = { src: '', tgt: '' };
+  let currentSiteLang = 'en';
+
+  /**
+   * Check if Native Translator API is available in global scope
+   */
+  function hasNativeTranslator() {
+    return typeof self !== 'undefined' && 'Translator' in self;
+  }
+
+  /**
+   * Check if Native LanguageDetector API is available in global scope
+   */
+  function hasNativeLanguageDetector() {
+    return typeof self !== 'undefined' && 'LanguageDetector' in self;
+  }
+
+  /**
+   * Detect language using on-device LanguageDetector API or heuristic fallback
+   */
+  async function detectLanguage(text, onProgress) {
+    if (!text || text.trim().length === 0) return null;
+
+    if (hasNativeLanguageDetector()) {
+      try {
+        const availability = await LanguageDetector.availability();
+        if (availability !== 'unavailable') {
+          const detector = await LanguageDetector.create({
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                if (onProgress && e.total) {
+                  onProgress(Math.round((e.loaded / e.total) * 100));
+                }
+              });
+            }
+          });
+          const results = await detector.detect(text);
+          if (results && results.length > 0 && results[0].detectedLanguage) {
+            return {
+              language: results[0].detectedLanguage,
+              confidence: results[0].confidence,
+              engine: 'builtin-ai'
+            };
+          }
+        }
+      } catch (err) {
+        console.warn('LanguageDetector failed, falling back:', err);
+      }
+    }
+
+    // Heuristic detection fallback
+    return detectLanguageHeuristic(text);
+  }
+
+  /**
+   * Heuristic language detection for fallback
+   */
+  function detectLanguageHeuristic(text) {
+    const trimmed = text.trim();
+    // Japanese
+    if (/[\u3040-\u30ff]/.test(trimmed)) {
+      return { language: 'ja', confidence: 0.95, engine: 'heuristic' };
+    }
+    // Chinese
+    if (/[\u4e00-\u9fff]/.test(trimmed)) {
+      return { language: 'zh', confidence: 0.90, engine: 'heuristic' };
+    }
+    // Korean
+    if (/[\uac00-\ud7af]/.test(trimmed)) {
+      return { language: 'ko', confidence: 0.95, engine: 'heuristic' };
+    }
+    // Arabic
+    if (/[\u0600-\u06FF]/.test(trimmed)) {
+      return { language: 'ar', confidence: 0.95, engine: 'heuristic' };
+    }
+    // Russian
+    if (/[\u0400-\u04FF]/.test(trimmed)) {
+      return { language: 'ru', confidence: 0.90, engine: 'heuristic' };
+    }
+
+    const clean = " " + trimmed.toLowerCase().replace(/[.,/#!$%^&*;:{}=\-_`~()?]/g, " ") + " ";
+
+    // French
+    if (/[œçàâêîôû]/.test(trimmed) || /\b(bonjour|merci|salut|oui|non|avec|sans|pour|dans|est|mon|ma|mes|le|la|les|un|une|des|café)\b/i.test(clean)) {
+      return { language: 'fr', confidence: 0.85, engine: 'heuristic' };
+    }
+    // Spanish
+    if (/[¿¡áéíóúñ]/i.test(trimmed) || /\b(hola|gracias|buenos|días|noches|amigo|leche|para|con|sin|este|esta|el|la|los|las|de|que)\b/i.test(clean)) {
+      return { language: 'es', confidence: 0.85, engine: 'heuristic' };
+    }
+    // German
+    if (/[äöüß]/.test(trimmed) || /\b(hallo|guten|morgen|tag|danke|bitte|kaffee|milch|mit|ohne|ist|der|die|das|und|ein|eine)\b/i.test(clean)) {
+      return { language: 'de', confidence: 0.85, engine: 'heuristic' };
+    }
+    // Italian
+    if (/\b(ciao|buongiorno|grazie|caffè|latte|con|senza|il|la|gli|le|di|che|sono)\b/i.test(clean)) {
+      return { language: 'it', confidence: 0.85, engine: 'heuristic' };
+    }
+    // Portuguese
+    if (/[ãõ]/i.test(trimmed) || /\b(olá|obrigado|obrigada|café|leite|com|sem|para|do|da|dos|das)\b/i.test(clean)) {
+      return { language: 'pt', confidence: 0.85, engine: 'heuristic' };
+    }
+
+    // Default English
+    return { language: 'en', confidence: 0.70, engine: 'heuristic' };
+  }
+
+  /**
+   * Translate text using Built-in AI Translator API
+   */
+  async function translateWithBuiltInAI(text, sourceLanguage, targetLanguage, onProgress) {
+    if (!hasNativeTranslator()) {
+      throw new Error('Native Translator API is not supported in this environment.');
+    }
+
+    const options = { sourceLanguage, targetLanguage };
+    const availability = await Translator.availability(options);
+
+    if (availability === 'unavailable') {
+      throw new Error(`Native Translator unavailable for ${sourceLanguage} -> ${targetLanguage}`);
+    }
+
+    // Reuse active translator if language pair matches
+    if (!activeTranslator || currentPair.src !== sourceLanguage || currentPair.tgt !== targetLanguage) {
+      activeTranslator = await Translator.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            if (onProgress) {
+              const pct = typeof e.loaded === 'number' && e.loaded <= 1
+                ? Math.round(e.loaded * 100)
+                : Math.round(((e.loaded || 0) / (e.total || 1)) * 100);
+              onProgress(pct);
+            }
+          });
+        }
+      });
+      currentPair = { src: sourceLanguage, tgt: targetLanguage };
+    }
+
+    return await activeTranslator.translate(text);
+  }
+
+  /**
+   * Translate text using Remote Free API Fallback (with timeout)
+   */
+  async function translateWithRemoteFallback(text, sourceLanguage, targetLanguage) {
+    const pair = `${sourceLanguage}|${targetLanguage}`;
+    const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=${encodeURIComponent(pair)}`;
+
+    const controller = new AbortController();
+    const timeoutId = setTimeout(() => controller.abort(), 6000);
+
+    try {
+      const response = await fetch(url, { signal: controller.signal });
+      clearTimeout(timeoutId);
+
+      if (!response.ok) {
+        throw new Error(`HTTP error ${response.status}`);
+      }
+
+      const data = await response.json();
+      if (data && data.responseData && data.responseData.translatedText) {
+        let res = data.responseData.translatedText;
+        if (!res.startsWith('MYMEMORY WARNING')) {
+          return res;
+        }
+      }
+      throw new Error('Invalid response payload');
+    } catch (err) {
+      clearTimeout(timeoutId);
+      throw err;
+    }
+  }
+
+  /**
+   * Translate text using Offline Dictionary Fallback
+   */
+  function translateWithOfflineDictionary(text, sourceLanguage, targetLanguage) {
+    const dictionary = getDictionary();
+    const lower = text.trim().toLowerCase();
+    
+    // Exact match in phrasebook
+    if (dictionary[lower] && dictionary[lower][targetLanguage]) {
+      return dictionary[lower][targetLanguage];
+    }
+
+    // Search for phrase across all dictionary values
+    for (const phraseKey of Object.keys(dictionary)) {
+      const item = dictionary[phraseKey];
+      for (const lang of Object.keys(item)) {
+        if (item[lang].toLowerCase() === lower && item[targetLanguage]) {
+          return item[targetLanguage];
+        }
+      }
+    }
+
+    // Word by word fallback
+    const words = text.split(/(\s+|[.,!?;:])/);
+    let matchedAny = false;
+    const translatedWords = words.map(chunk => {
+      const cLower = chunk.toLowerCase();
+      if (dictionary[cLower] && dictionary[cLower][targetLanguage]) {
+        matchedAny = true;
+        return dictionary[cLower][targetLanguage];
+      }
+      return chunk;
+    });
+
+    if (matchedAny) {
+      return translatedWords.join('');
+    }
+
+    return text;
+  }
+
+  /**
+   * Unified translation orchestrator
+   */
+  async function translateText(text, sourceLanguage, targetLanguage, onProgress) {
+    if (!text || text.trim() === '') {
+      return { text: '', engine: 'none', detectedLanguage: null };
+    }
+
+    let detectedLang = null;
+    let actualSource = sourceLanguage;
+
+    // Handle Auto-Detect
+    if (sourceLanguage === 'auto') {
+      const detection = await detectLanguage(text, onProgress);
+      if (detection && detection.language) {
+        actualSource = detection.language;
+        detectedLang = detection;
+      } else {
+        actualSource = 'en';
+      }
+    }
+
+    // If source and target are the same language, no translation needed
+    if (actualSource === targetLanguage) {
+      return { text, engine: 'identity', detectedLanguage: detectedLang };
+    }
+
+    // 1. Try On-Device Built-in AI Translator
+    if (hasNativeTranslator()) {
+      try {
+        const translated = await translateWithBuiltInAI(text, actualSource, targetLanguage, onProgress);
+        return { text: translated, engine: 'builtin-ai', detectedLanguage: detectedLang };
+      } catch (nativeErr) {
+        console.info('On-device translation unavailable, proceeding to fallback:', nativeErr.message);
+      }
+    }
+
+    // 2. Try Offline phrasebook first for instant response
+    const dictionary = getDictionary();
+    const lower = text.trim().toLowerCase();
+    if (dictionary[lower] && dictionary[lower][targetLanguage]) {
+      return {
+        text: dictionary[lower][targetLanguage],
+        engine: 'offline-phrasebook',
+        detectedLanguage: detectedLang
+      };
+    }
+
+    // 3. Try Remote Translation Service
+    try {
+      const remoteText = await translateWithRemoteFallback(text, actualSource, targetLanguage);
+      return { text: remoteText, engine: 'cloud-api', detectedLanguage: detectedLang };
+    } catch (remoteErr) {
+      console.warn('Remote translation failed, using offline fallback:', remoteErr);
+    }
+
+    // 4. Offline Dictionary / Rule engine
+    const offlineText = translateWithOfflineDictionary(text, actualSource, targetLanguage);
+    return { text: offlineText, engine: 'offline-dictionary', detectedLanguage: detectedLang };
+  }
+
+  /**
+   * Update website content to the specified language
+   */
+  function applySiteLanguage(langCode) {
+    const translations = getTranslations();
+    if (!translations[langCode]) {
+      console.warn(`Language ${langCode} not found in translations.`);
+      return;
+    }
+
+    currentSiteLang = langCode;
+    const bundle = translations[langCode];
+
+    // Update all DOM elements with data-i18n
+    const elements = document.querySelectorAll('[data-i18n]');
+    elements.forEach(el => {
+      const key = el.getAttribute('data-i18n');
+      if (bundle[key]) {
+        if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
+          el.placeholder = bundle[key];
+        } else {
+          el.textContent = bundle[key];
+        }
+      }
+    });
+
+    // Update placeholder attributes specifically tagged
+    const placeholderEls = document.querySelectorAll('[data-i18n-placeholder]');
+    placeholderEls.forEach(el => {
+      const key = el.getAttribute('data-i18n-placeholder');
+      if (bundle[key]) {
+        el.placeholder = bundle[key];
+      }
+    });
+
+    // Update html lang attribute
+    if (typeof document !== 'undefined' && document.documentElement) {
+      document.documentElement.lang = langCode;
+    }
+  }
+
+  /**
+   * DOM Initializer
+   */
+  function initTranslatorUI() {
+    const srcLangSelect = document.getElementById('src-lang');
+    const tgtLangSelect = document.getElementById('tgt-lang');
+    const swapBtn = document.getElementById('swap-lang-btn');
+    const sourceText = document.getElementById('source-text');
+    const targetText = document.getElementById('target-text');
+    const translateBtn = document.getElementById('translate-btn');
+    const translateBtnText = document.getElementById('translate-btn-text');
+    const translateSpinner = document.getElementById('translate-spinner');
+    const clearBtn = document.getElementById('clear-source-btn');
+    const copyBtn = document.getElementById('copy-btn');
+    const listenBtn = document.getElementById('listen-btn');
+    const charCount = document.getElementById('char-count');
+    const detectedBadge = document.getElementById('detected-lang-badge');
+    const engineBadge = document.getElementById('engine-status-badge');
+    const engineStatusText = document.getElementById('engine-status-text');
+    const progressContainer = document.getElementById('model-progress-container');
+    const progressFill = document.getElementById('model-progress-fill');
+    const progressPercent = document.getElementById('model-progress-percent');
+    const siteLangSelect = document.getElementById('site-language');
+    const targetStatusMsg = document.getElementById('target-status-msg');
+
+    // Update Engine status badge initially
+    if (engineStatusText && engineBadge) {
+      if (hasNativeTranslator()) {
+        engineStatusText.textContent = 'Built-in AI Ready';
+        engineBadge.classList.add('engine-ai');
+      } else {
+        engineStatusText.textContent = 'Multilingual Engine';
+        engineBadge.classList.add('engine-cloud');
+      }
+    }
+
+    // Site language selector
+    if (siteLangSelect) {
+      siteLangSelect.addEventListener('change', (e) => {
+        applySiteLanguage(e.target.value);
+      });
+    }
+
+    // Character counter
+    if (sourceText && charCount) {
+      sourceText.addEventListener('input', () => {
+        charCount.textContent = `${sourceText.value.length} / 5000`;
+        if (sourceText.value.length === 0) {
+          if (detectedBadge) detectedBadge.hidden = true;
+          if (targetText) targetText.value = '';
+          if (targetStatusMsg) targetStatusMsg.textContent = '';
+        }
+      });
+    }
+
+    // Clear button
+    if (clearBtn) {
+      clearBtn.addEventListener('click', () => {
+        if (sourceText) sourceText.value = '';
+        if (targetText) targetText.value = '';
+        if (charCount) charCount.textContent = '0 / 5000';
+        if (detectedBadge) detectedBadge.hidden = true;
+        if (targetStatusMsg) targetStatusMsg.textContent = '';
+        if (sourceText) sourceText.focus();
+      });
+    }
+
+    // Swap languages button
+    if (swapBtn && srcLangSelect && tgtLangSelect) {
+      swapBtn.addEventListener('click', () => {
+        const currentSrc = srcLangSelect.value;
+        const currentTgt = tgtLangSelect.value;
+
+        if (currentSrc === 'auto') {
+          srcLangSelect.value = currentTgt;
+          tgtLangSelect.value = 'en';
+        } else {
+          srcLangSelect.value = currentTgt;
+          tgtLangSelect.value = currentSrc;
+        }
+
+        // Swap texts if target text is available
+        if (targetText && targetText.value.trim().length > 0 && sourceText) {
+          const oldTarget = targetText.value;
+          sourceText.value = oldTarget;
+          targetText.value = '';
+          if (charCount) charCount.textContent = `${oldTarget.length} / 5000`;
+          performTranslation();
+        }
+      });
+    }
+
+    // Copy to clipboard
+    if (copyBtn && targetText) {
+      copyBtn.addEventListener('click', async () => {
+        if (!targetText.value) return;
+        try {
+          await navigator.clipboard.writeText(targetText.value);
+          const orig = copyBtn.innerHTML;
+          copyBtn.innerHTML = '✓ Copied!';
+          setTimeout(() => { copyBtn.innerHTML = orig; }, 2000);
+        } catch (err) {
+          console.warn('Clipboard write failed:', err);
+        }
+      });
+    }
+
+    // Listen / Speech Synthesis
+    if (listenBtn && targetText && tgtLangSelect) {
+      listenBtn.addEventListener('click', () => {
+        const textToSpeak = targetText.value.trim();
+        if (!textToSpeak || !('speechSynthesis' in window)) return;
+        
+        window.speechSynthesis.cancel();
+        const utterance = new SpeechSynthesisUtterance(textToSpeak);
+        utterance.lang = tgtLangSelect.value;
+        window.speechSynthesis.speak(utterance);
+      });
+    }
+
+    // Quick phrase chips
+    const phraseChips = document.querySelectorAll('.chip-btn');
+    phraseChips.forEach(chip => {
+      chip.addEventListener('click', () => {
+        const phrase = chip.getAttribute('data-phrase');
+        if (sourceText && phrase) {
