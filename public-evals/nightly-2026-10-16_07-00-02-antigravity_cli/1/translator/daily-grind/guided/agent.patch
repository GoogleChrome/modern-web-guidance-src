+      }
+
+      const src = srcLangSelect.value;
+      const tgt = tgtLangSelect.value;
+
+      // Loading state
+      if (translateBtn) translateBtn.disabled = true;
+      if (translateSpinner) translateSpinner.hidden = false;
+      if (translateBtnText) translateBtnText.textContent = 'Translating...';
+      if (targetStatusMsg) targetStatusMsg.textContent = 'Translating text...';
+
+      try {
+        const result = await translateText(text, src, tgt, (progressPct) => {
+          if (progressContainer) {
+            progressContainer.hidden = false;
