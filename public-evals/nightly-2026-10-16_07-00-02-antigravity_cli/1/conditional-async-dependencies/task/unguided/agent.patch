+  <script type="module">
+    // Conditional async dependency management:
+    // Protect page load performance and avoid loading unnecessary scripts by only fetching the polyfill if not natively supported.
+    if (!('popover' in HTMLElement.prototype)) {
+      const polyfillCdn = 'https://cdn.jsdelivr.net/npm/@oddbird/popover-polyfill@latest/dist/popover.min.js';
+      const polyfillLocal = './vendor/popover.min.js';
+
+      import(polyfillCdn).catch(() => import(polyfillLocal)).catch(() => {
+        const script = document.createElement('script');
+        script.src = polyfillCdn;
+        script.async = true;
+        script.onerror = () => {
+          const fallback = document.createElement('script');
+          fallback.src = polyfillLocal;
+          fallback.async = true;
+          document.head.appendChild(fallback);
+        };
+        document.head.appendChild(script);
+      });
+    }
+
+    // Progressive enhancement fallback for environments without native popover or polyfill execution
+    const rewardsBtn = document.getElementById('rewards-btn');
+    const rewardsPopover = document.getElementById('rewards-popover');
+    if (rewardsBtn && rewardsPopover) {
+      rewardsBtn.addEventListener('click', () => {
+        if (typeof rewardsPopover.togglePopover !== 'function') {
+          const isClosed = rewardsPopover.hasAttribute('hidden') || rewardsPopover.style.display === 'none' || !rewardsPopover.classList.contains('popover-open');
+          if (isClosed) {
+            rewardsPopover.removeAttribute('hidden');
+            rewardsPopover.style.display = 'block';
+            rewardsPopover.classList.add('popover-open');
+          } else {
+            rewardsPopover.setAttribute('hidden', '');
+            rewardsPopover.style.display = 'none';
+            rewardsPopover.classList.remove('popover-open');
+          }
+        }
+      });
+    }
+
+    const closeBtns = document.querySelectorAll('[popovertarget="rewards-popover"][popovertargetaction="hide"], .rewards-popover-close');
+    closeBtns.forEach(btn => {
+      btn.addEventListener('click', () => {
+        if (typeof rewardsPopover.togglePopover !== 'function') {
+          rewardsPopover.setAttribute('hidden', '');
+          rewardsPopover.style.display = 'none';
+          rewardsPopover.classList.remove('popover-open');
+        }
+      });
+    });
+  </script>
+
