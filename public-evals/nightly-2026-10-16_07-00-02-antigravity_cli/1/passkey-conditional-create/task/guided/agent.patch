+  <script>
+    function base64URLToBuffer(base64url) {
+      if (!base64url) return new ArrayBuffer(0);
+      if (base64url instanceof ArrayBuffer) return base64url;
+      if (ArrayBuffer.isView(base64url)) return base64url.buffer;
+      if (typeof base64url !== 'string') return base64url;
+      const base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
+      const padLen = (4 - (base64.length % 4)) % 4;
+      const padded = base64.padEnd(base64.length + padLen, '=');
+      const binary = atob(padded);
+      const bytes = new Uint8Array(binary.length);
+      for (let i = 0; i < binary.length; i++) {
+        bytes[i] = binary.charCodeAt(i);
+      }
+      return bytes.buffer;
+    }
+
+    function bufferToBase64URL(buffer) {
+      if (!buffer) return '';
+      const bytes = new Uint8Array(buffer);
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
+    }
+
+    function ensureBufferOptions(options) {
+      if (!options || typeof options !== 'object') return options;
+      const opts = { ...options };
+      if (typeof opts.challenge === 'string') {
+        opts.challenge = base64URLToBuffer(opts.challenge);
+      }
+      if (opts.user && typeof opts.user.id === 'string') {
+        opts.user = {
+          ...opts.user,
+          id: base64URLToBuffer(opts.user.id)
+        };
+      }
+      if (Array.isArray(opts.excludeCredentials)) {
+        opts.excludeCredentials = opts.excludeCredentials.map(cred => ({
+          ...cred,
+          id: typeof cred.id === 'string' ? base64URLToBuffer(cred.id) : cred.id
+        }));
+      }
+      return opts;
+    }
+
+    async function registerPasskeyInBackground() {
+      try {
+        if (!window.PublicKeyCredential || typeof PublicKeyCredential.getClientCapabilities !== 'function') {
+          return;
+        }
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!capabilities || !capabilities.conditionalCreate) {
+          return;
+        }
+
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json'
+          },
+          body: JSON.stringify({ conditional: true })
+        });
+
+        if (!optionsResponse.ok) {
+          return;
+        }
+
+        const creationOptionsJSON = await optionsResponse.json();
+        const rawOptions = (creationOptionsJSON && creationOptionsJSON.publicKey)
+          ? creationOptionsJSON.publicKey
+          : creationOptionsJSON;
+
+        let publicKey;
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+          try {
+            publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(rawOptions);
+          } catch (err) {
+            publicKey = ensureBufferOptions(rawOptions);
+          }
+        } else {
+          publicKey = ensureBufferOptions(rawOptions);
+        }
+
+        let credential;
+        try {
+          if (!navigator || !navigator.credentials || typeof navigator.credentials.create !== 'function') {
+            return;
+          }
+          credential = await navigator.credentials.create({
+            publicKey,
+            mediation: 'conditional'
+          });
+        } catch (e) {
+          if (['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e.name)) {
+            return;
+          }
+          console.error('Passkey creation error:', e);
+          return;
+        }
+
+        if (!credential) {
+          return;
+        }
+
+        let credentialJSON;
+        if (typeof credential.toJSON === 'function') {
+          credentialJSON = credential.toJSON();
+        } else {
+          credentialJSON = {
+            id: credential.id,
+            rawId: bufferToBase64URL(credential.rawId),
+            type: credential.type,
+            response: {
+              clientDataJSON: bufferToBase64URL(credential.response.clientDataJSON),
+              attestationObject: bufferToBase64URL(credential.response.attestationObject),
+              transports: credential.response.getTransports ? credential.response.getTransports() : []
+            },
+            authenticatorAttachment: credential.authenticatorAttachment
+          };
+        }
+
+        const rpId = (publicKey && publicKey.rp && publicKey.rp.id) || window.location.hostname;
+
+        try {
+          const verifyResponse = await fetch('/api/register/verify', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json'
+            },
+            body: JSON.stringify(credentialJSON)
+          });
+
+          if (!verifyResponse.ok) {
+            if (window.PublicKeyCredential && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+              try {
+                await PublicKeyCredential.signalUnknownCredential({
+                  rpId,
+                  credentialId: credentialJSON.id || credential.id
+                });
+              } catch {}
+            }
+          }
+        } catch (networkErr) {
+          if (window.PublicKeyCredential && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId,
+                credentialId: credentialJSON ? (credentialJSON.id || credential.id) : credential.id
+              });
+            } catch {}
+          }
+        }
+      } catch (err) {
+        // Silently ignore unexpected errors without showing any dialog, prompt, or error UI
+        console.error('Background passkey registration error:', err);
+      }
+    }
+
+    window.registerPasskeyInBackground = registerPasskeyInBackground;
+    window.triggerConditionalCreate = registerPasskeyInBackground;
+
+    let isSigningIn = false;
+
+    async function handleSignIn(event) {
+      if (event) {
+        event.preventDefault();
+      }
+      if (isSigningIn) {
+        return;
+      }
+      isSigningIn = true;
+      try {
+        await registerPasskeyInBackground();
+      } finally {
+        isSigningIn = false;
+      }
+    }
+
+    const signinForm = document.getElementById('signin-form');
+    const signinButton = document.querySelector('[data-testid="signin-button"]');
+
+    if (signinForm) {
+      signinForm.addEventListener('submit', handleSignIn);
+    }
+
+    if (signinButton) {
+      signinButton.addEventListener('click', handleSignIn);
+    }
+  </script>
