+  <script>
+    (function () {
+      // Confirmation Modal Elements
+      const openDialogBtn = document.getElementById('open-dialog-btn');
+      const closeDialogBtn = document.getElementById('close-dialog-btn');
+      const logoutDialog = document.getElementById('logout-dialog');
+      const cancelModalBtn = logoutDialog ? logoutDialog.querySelector('.modal-cancel-btn') : null;
+
+      let isDialogClosing = false;
+
+      function openModal() {
+        if (!logoutDialog) return;
+        if (isDialogClosing) {
+          logoutDialog.classList.remove('is-closing');
+          isDialogClosing = false;
+        }
+        if (typeof logoutDialog.showModal === 'function') {
+          if (!logoutDialog.open) {
+            logoutDialog.showModal();
+          }
+        } else {
+          logoutDialog.setAttribute('open', '');
+        }
+      }
+
+      function closeModal() {
+        if (!logoutDialog || !logoutDialog.open || isDialogClosing) return;
+        isDialogClosing = true;
+        logoutDialog.classList.add('is-closing');
+
+        const onAnimationEnd = (e) => {
+          if (e && e.target !== logoutDialog) return;
+          logoutDialog.removeEventListener('animationend', onAnimationEnd);
+          logoutDialog.classList.remove('is-closing');
+          if (typeof logoutDialog.close === 'function') {
+            logoutDialog.close();
+          } else {
+            logoutDialog.removeAttribute('open');
+          }
+          isDialogClosing = false;
+        };
+
+        logoutDialog.addEventListener('animationend', onAnimationEnd);
+
+        setTimeout(() => {
+          if (isDialogClosing) {
+            onAnimationEnd();
+          }
+        }, 300);
+      }
+
+      if (openDialogBtn) {
+        openDialogBtn.addEventListener('click', function (e) {
+          e.preventDefault();
+          openModal();
+        });
+      }
+
+      if (closeDialogBtn) {
+        closeDialogBtn.addEventListener('click', function (e) {
+          e.preventDefault();
+          closeModal();
+        });
+      }
+
+      if (cancelModalBtn) {
+        cancelModalBtn.addEventListener('click', function (e) {
+          e.preventDefault();
+          closeModal();
+        });
+      }
+
+      if (logoutDialog) {
+        logoutDialog.addEventListener('click', function (e) {
+          const rect = logoutDialog.getBoundingClientRect();
+          const isInDialog = (
+            rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
+            rect.left <= e.clientX && e.clientX <= rect.left + rect.width
+          );
+          if (!isInDialog) {
+            closeModal();
+          }
+        });
+
+        logoutDialog.addEventListener('cancel', function (e) {
+          e.preventDefault();
+          closeModal();
+        });
+      }
+
+      // Floating Overlay Elements
+      const foobarBtn = document.getElementById('foobar');
+      const overlay = document.getElementById('floating-overlay');
+      const dismissOverlayBtn = document.getElementById('close-overlay-btn');
+
+      let isOverlayClosing = false;
+
+      function showOverlay() {
+        if (!overlay) return;
+        if (isOverlayClosing) {
+          overlay.classList.remove('is-closing');
+          isOverlayClosing = false;
+        }
+        overlay.classList.remove('is-open');
+        void overlay.offsetWidth; // Force reflow to re-trigger smooth animation
+        overlay.classList.add('is-open');
+      }
+
+      function dismissOverlay() {
+        if (!overlay || !overlay.classList.contains('is-open') || isOverlayClosing) return;
+        isOverlayClosing = true;
+        overlay.classList.remove('is-open');
+        overlay.classList.add('is-closing');
+
+        const onAnimationEnd = (e) => {
+          if (e && e.target !== overlay) return;
+          overlay.removeEventListener('animationend', onEnd);
+          overlay.classList.remove('is-closing');
+          isOverlayClosing = false;
+        };
+
+        const onEnd = onAnimationEnd;
+        overlay.addEventListener('animationend', onEnd);
+
+        setTimeout(() => {
+          if (isOverlayClosing) {
+            onEnd();
+          }
+        }, 300);
+      }
+
+      if (foobarBtn) {
+        foobarBtn.addEventListener('click', function (e) {
+          e.preventDefault();
+          showOverlay();
+        });
+      }
+
+      if (dismissOverlayBtn) {
+        dismissOverlayBtn.addEventListener('click', function (e) {
+          e.preventDefault();
+          dismissOverlay();
+        });
+      }
+    })();
+  </script>
 </body>
 
