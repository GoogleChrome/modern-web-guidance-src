+  <!-- Confirmation Modal -->
+  <dialog id="logout-dialog" class="confirm-dialog" aria-labelledby="dialog-title" aria-describedby="dialog-desc">
+    <div class="dialog-content">
+      <div class="dialog-header">
+        <h2 id="dialog-title">Confirm Logout</h2>
+      </div>
+      <div class="dialog-body">
+        <p id="dialog-desc">Are you sure you want to log out of your account?</p>
+      </div>
+      <div class="dialog-actions">
+        <button type="button" id="close-dialog-btn" class="btn btn-secondary" commandfor="logout-dialog" command="close">Cancel</button>
+        <a href="/logout" class="btn btn-danger">Log Out</a>
+      </div>
+    </div>
+  </dialog>
+
+  <!-- Dismissible Informational Floating Overlay -->
+  <div id="order-status-overlay" popover="auto" class="floating-overlay" role="status">
+    <div class="overlay-content">
+      <p class="overlay-message">online ordering is currently offline</p>
+      <button type="button" class="close-overlay-btn" id="close-overlay-btn" popovertarget="order-status-overlay" popovertargetaction="hide" aria-label="Dismiss">&times;</button>
+    </div>
+  </div>
+
+  <script type="module">
+    // Conditionally load polyfill if Popover API is unsupported
+    if (!("popover" in HTMLElement.prototype)) {
+      import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js").catch(() => {});
+    }
+
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return false;
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    function supportsTopLayerExit() {
+      return Boolean(window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay());
+    }
+
+    async function closeTopLayer(element) {
+      if (!element) return;
+      if (!supportsTopLayerExit()) {
+        element.setAttribute('data-closing', '');
+        const animations = element.getAnimations?.({ subtree: true }) || [];
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        } else {
+          await new Promise((r) => setTimeout(r, 300));
+        }
+        if (!element.hasAttribute('data-closing')) return;
+        element.removeAttribute('data-closing');
+      }
+
+      if (element instanceof HTMLDialogElement && element.open) {
+        element.close();
+      } else if (typeof element.hidePopover === 'function') {
+        try {
+          element.hidePopover();
+        } catch {
+          // Ignore if already hidden
+        }
+      } else {
+        element.removeAttribute('open');
+        element.classList.remove('is-open');
+        element.classList.remove(':popover-open');
+      }
+    }
+
+    const openDialogBtn = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const closeDialogBtn = document.getElementById('close-dialog-btn');
+    const foobarBtn = document.getElementById('foobar');
+    const orderOverlay = document.getElementById('order-status-overlay');
+    const closeOverlayBtn = document.getElementById('close-overlay-btn');
+
+    if (openDialogBtn && logoutDialog) {
+      openDialogBtn.addEventListener('click', (e) => {
+        e.preventDefault();
+        if (typeof logoutDialog.showModal === 'function') {
+          logoutDialog.showModal();
+        } else {
+          logoutDialog.setAttribute('open', '');
+        }
+      });
+    }
+
+    if (closeDialogBtn && logoutDialog) {
+      closeDialogBtn.addEventListener('click', (e) => {
+        e.preventDefault();
+        closeTopLayer(logoutDialog);
+      });
+    }
+
+    if (logoutDialog) {
+      logoutDialog.addEventListener('cancel', (e) => {
+        e.preventDefault();
+        closeTopLayer(logoutDialog);
+      });
+
+      logoutDialog.addEventListener('click', (e) => {
+        const rect = logoutDialog.getBoundingClientRect();
+        const isInDialog = (
+          rect.top <= e.clientY &&
+          e.clientY <= rect.bottom &&
+          rect.left <= e.clientX &&
+          e.clientX <= rect.right
+        );
+        if (!isInDialog) {
+          closeTopLayer(logoutDialog);
+        }
+      });
+    }
+
+    if (foobarBtn && orderOverlay) {
+      foobarBtn.addEventListener('click', (e) => {
+        const isOpen = (
+          (typeof orderOverlay.matches === 'function' && orderOverlay.matches(':popover-open')) ||
+          orderOverlay.classList.contains('is-open') ||
+          orderOverlay.classList.contains(':popover-open') ||
+          orderOverlay.hasAttribute('data-closing')
+        );
+
+        if (isOpen) {
+          e.preventDefault();
+          closeTopLayer(orderOverlay);
+        } else {
+          if (!('popoverTargetElement' in HTMLButtonElement.prototype)) {
+            e.preventDefault();
+            if (typeof orderOverlay.showPopover === 'function') {
+              orderOverlay.showPopover();
+            } else {
+              orderOverlay.classList.add('is-open');
+            }
+          }
+        }
+      });
+    }
+
+    if (closeOverlayBtn && orderOverlay) {
+      closeOverlayBtn.addEventListener('click', (e) => {
+        e.preventDefault();
+        closeTopLayer(orderOverlay);
+      });
+    }
+  </script>
 </body>
 
