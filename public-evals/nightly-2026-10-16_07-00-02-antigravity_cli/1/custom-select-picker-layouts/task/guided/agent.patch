+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const roastSelect = document.getElementById('roast-select');
+      const orderBtn = document.querySelector('.hero .btn');
+
+      if (roastSelect) {
+        // Sync Order Now URL with chosen roast selection
+        const updateOrderLink = () => {
+          if (orderBtn) {
+            orderBtn.href = `/order-online?roast=${encodeURIComponent(roastSelect.value)}`;
+          }
+        };
+        roastSelect.addEventListener('change', updateOrderLink);
+        updateOrderLink();
+
+        // Spatial keyboard navigation for grid layout (ArrowLeft / ArrowRight)
+        roastSelect.addEventListener('keydown', (e) => {
+          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
+            const options = Array.from(roastSelect.options);
+            const currentIndex = roastSelect.selectedIndex;
+            if (e.key === 'ArrowRight' && currentIndex < options.length - 1) {
+              roastSelect.selectedIndex = currentIndex + 1;
+              roastSelect.dispatchEvent(new Event('change'));
+              e.preventDefault();
+            } else if (e.key === 'ArrowLeft' && currentIndex > 0) {
+              roastSelect.selectedIndex = currentIndex - 1;
+              roastSelect.dispatchEvent(new Event('change'));
+              e.preventDefault();
+            }
+          }
+        });
+      }
+    });
+  </script>
