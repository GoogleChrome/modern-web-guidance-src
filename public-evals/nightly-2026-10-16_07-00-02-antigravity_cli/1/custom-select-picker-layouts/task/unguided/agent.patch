+  <script>
+    (function () {
+      const roastData = {
+        light: {
+          name: 'Light Roast',
+          tag: 'Mellow & Crisp'
+        },
+        medium: {
+          name: 'Medium Roast',
+          tag: 'Smooth & Balanced'
+        },
+        dark: {
+          name: 'Dark Roast',
+          tag: 'Bold & Smoky'
+        }
+      };
+
+      const dropdown = document.getElementById('roastDropdown');
+      const trigger = document.getElementById('roastTrigger');
+      const menu = document.getElementById('roastOptionsMenu');
+      const nativeSelect = document.getElementById('roast-select');
+      const labelText = document.getElementById('selectedRoastLabel');
+      const tagText = document.getElementById('selectedRoastTag');
+      const optionCards = Array.from(document.querySelectorAll('.roast-option-card'));
+      const orderBtn = document.getElementById('orderNowBtn');
+
+      function updateSelection(value, emitNative) {
+        if (!roastData[value]) return;
+
+        // Update cards
+        optionCards.forEach(card => {
+          const isSelected = card.getAttribute('data-value') === value;
+          card.classList.toggle('selected', isSelected);
+          card.classList.toggle('is-selected', isSelected);
+          card.setAttribute('aria-selected', isSelected ? 'true' : 'false');
+        });
+
+        // Update trigger display
+        if (labelText) labelText.textContent = roastData[value].name;
+        if (tagText) tagText.textContent = roastData[value].tag;
+
+        // Update native select
+        if (nativeSelect && nativeSelect.value !== value) {
+          nativeSelect.value = value;
+          if (emitNative) {
+            nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
+          }
+        }
+
+        // Update Order Now button link
+        if (orderBtn) {
+          orderBtn.href = '/order-online?roast=' + encodeURIComponent(value);
+        }
+      }
+
+      function openDropdown() {
+        dropdown.classList.add('open');
+        menu.classList.add('is-open');
+        trigger.setAttribute('aria-expanded', 'true');
+      }
+
+      function closeDropdown() {
+        dropdown.classList.remove('open');
+        menu.classList.remove('is-open');
+        trigger.setAttribute('aria-expanded', 'false');
+      }
+
+      function toggleDropdown() {
+        if (dropdown.classList.contains('open')) {
+          closeDropdown();
+        } else {
+          openDropdown();
+        }
+      }
+
+      // Trigger button click
+      trigger.addEventListener('click', function (e) {
+        e.stopPropagation();
+        toggleDropdown();
+      });
+
+      // Option cards click & keyboard navigation
+      optionCards.forEach((card, index) => {
+        card.addEventListener('click', function (e) {
+          e.stopPropagation();
+          const val = card.getAttribute('data-value');
+          updateSelection(val, true);
+          closeDropdown();
+          trigger.focus();
+        });
+
+        card.addEventListener('keydown', function (e) {
+          if (e.key === 'Enter' || e.key === ' ') {
+            e.preventDefault();
+            const val = card.getAttribute('data-value');
+            updateSelection(val, true);
+            closeDropdown();
+            trigger.focus();
+          } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
+            e.preventDefault();
+            const next = optionCards[(index + 1) % optionCards.length];
+            next.focus();
+          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
+            e.preventDefault();
+            const prev = optionCards[(index - 1 + optionCards.length) % optionCards.length];
+            prev.focus();
+          } else if (e.key === 'Escape') {
+            e.preventDefault();
+            closeDropdown();
+            trigger.focus();
+          }
+        });
+      });
+
+      // Trigger keydown
+      trigger.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
+          if (!dropdown.classList.contains('open')) {
+            e.preventDefault();
+            openDropdown();
+            const selected = optionCards.find(c => c.classList.contains('selected')) || optionCards[0];
+            if (selected) selected.focus();
+          }
+        } else if (e.key === 'Escape') {
+          closeDropdown();
+        }
+      });
+
+      // Close when clicking outside
+      document.addEventListener('click', function (e) {
+        if (!dropdown.contains(e.target)) {
+          closeDropdown();
+        }
+      });
+
+      // Escape key to close
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && dropdown.classList.contains('open')) {
+          closeDropdown();
+          trigger.focus();
+        }
+      });
+
+      // Sync if native select changes externally
+      if (nativeSelect) {
+        nativeSelect.addEventListener('change', function () {
+          updateSelection(nativeSelect.value, false);
+        });
+      }
+
+      // Initial synchronization
+      const initialVal = nativeSelect ? nativeSelect.value : 'medium';
+      updateSelection(initialVal, false);
+    })();
+  </script>
 </body>
 
