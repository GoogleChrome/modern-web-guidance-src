+  <script>
+    (function () {
+      const themeSwitch = document.getElementById('theme-switch');
+      const switchStatus = document.getElementById('switch-status');
+
+      if (!themeSwitch) return;
+
+      function setTheme(isDark) {
+        themeSwitch.checked = isDark;
+        themeSwitch.setAttribute('aria-checked', isDark ? 'true' : 'false');
+        if (switchStatus) {
+          switchStatus.textContent = isDark ? 'On' : 'Off';
+        }
+        if (isDark) {
+          document.documentElement.setAttribute('data-theme', 'dark');
+          document.body.classList.add('dark-mode');
+        } else {
+          document.documentElement.removeAttribute('data-theme');
+          document.body.classList.remove('dark-mode');
+        }
+      }
+
+      // Handle change event (clicks, keyboard Space)
+      themeSwitch.addEventListener('change', function () {
+        const isDark = themeSwitch.checked;
+        setTheme(isDark);
+        try {
+          localStorage.setItem('theme', isDark ? 'dark' : 'light');
+        } catch (e) {
+          // Ignore localStorage errors
+        }
+      });
+
+      // Handle Enter key for WAI-ARIA switch keyboard interaction
+      themeSwitch.addEventListener('keydown', function (e) {
+        if (e.key === 'Enter') {
+          e.preventDefault();
+          themeSwitch.checked = !themeSwitch.checked;
+          themeSwitch.dispatchEvent(new Event('change', { bubbles: true }));
+        }
+      });
+
+      // Also allow clicking status label to toggle
+      if (switchStatus) {
+        switchStatus.addEventListener('click', function () {
+          themeSwitch.click();
+        });
+      }
+
+      // Restore saved user preference if present
+      try {
+        const savedTheme = localStorage.getItem('theme');
+        if (savedTheme === 'dark') {
+          setTheme(true);
+        } else {
+          setTheme(false);
+        }
+      } catch (e) {
+        setTheme(false);
+      }
+    })();
+  </script>
+
