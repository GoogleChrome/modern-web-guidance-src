+  <script>
+    (function () {
+      let isTourActive = true;
+
+      const feature = document.getElementById('feature');
+      const tourStep = document.getElementById('tour-step');
+      const closeBtn = document.getElementById('tour-close-btn');
+
+      function isTourOpen() {
+        if (!isTourActive || !tourStep) return false;
+        if (tourStep.style.display === 'none' || tourStep.hidden) return false;
+        const style = window.getComputedStyle(tourStep);
+        return style.display !== 'none' && style.visibility !== 'hidden';
+      }
+
+      function closeTour() {
+        isTourActive = false;
+        if (tourStep) {
+          tourStep.style.display = 'none';
+        }
+      }
+
+      function updateTourPosition() {
+        if (!isTourOpen() || !feature || !tourStep) return;
+
+        const fRect = feature.getBoundingClientRect();
+        const stepWidth = tourStep.offsetWidth || 280;
+
+        // Position 12px directly below the feature
+        const offset = 12;
+        const top = fRect.bottom + offset;
+        let left = fRect.left + (fRect.width / 2) - (stepWidth / 2);
+
+        // Keep within viewport boundaries horizontally
+        const padding = 12;
+        const maxLeft = window.innerWidth - stepWidth - padding;
+        if (left < padding) {
+          left = padding;
+        } else if (left > maxLeft) {
+          left = maxLeft;
+        }
+
+        tourStep.style.top = top + 'px';
+        tourStep.style.left = left + 'px';
+
+        // Position the arrow so it points directly at feature center
+        const arrow = tourStep.querySelector('.tour-arrow');
+        if (arrow) {
+          const featureCenterX = fRect.left + (fRect.width / 2);
+          const arrowLeft = featureCenterX - left;
+          const clampedArrowLeft = Math.max(16, Math.min(stepWidth - 16, arrowLeft));
+          arrow.style.left = clampedArrowLeft + 'px';
+        }
+      }
+
+      // Close button handler
+      if (closeBtn) {
+        closeBtn.addEventListener('click', function (e) {
+          e.stopPropagation();
+          closeTour();
+        });
+      }
+
+      // Delegation in case buttons are interacted with or re-rendered
+      if (tourStep) {
+        tourStep.addEventListener('click', function (e) {
+          if (e.target.closest('#tour-close-btn') || e.target.closest('button')) {
+            closeTour();
+          }
+        });
+      }
+
+      // Ensure that clicking the rewards link during the tour does not cause the page to navigate away
+      if (feature) {
+        feature.addEventListener('click', function (e) {
+          if (isTourOpen()) {
+            e.preventDefault();
+          }
+        });
+      }
+
+      // Visual tracking: updates on scroll, resize, layout changes, and animation frame
+      window.addEventListener('scroll', updateTourPosition, { passive: true, capture: true });
+      window.addEventListener('resize', updateTourPosition, { passive: true });
+
+      if (typeof ResizeObserver !== 'undefined') {
+        const ro = new ResizeObserver(function () {
+          updateTourPosition();
+        });
+        ro.observe(document.body);
+        if (feature) ro.observe(feature);
+        if (tourStep) ro.observe(tourStep);
+      }
+
+      if (typeof MutationObserver !== 'undefined') {
+        const mo = new MutationObserver(function () {
+          updateTourPosition();
+        });
+        mo.observe(document.body, { attributes: true, childList: true, subtree: true });
+      }
+
+      // Continuous tracking loop via requestAnimationFrame while tour is active
+      function trackingLoop() {
+        if (isTourActive) {
+          updateTourPosition();
+          requestAnimationFrame(trackingLoop);
+        }
+      }
+
+      // Initial positioning
+      updateTourPosition();
+      requestAnimationFrame(trackingLoop);
+      window.addEventListener('DOMContentLoaded', updateTourPosition);
+      window.addEventListener('load', updateTourPosition);
+    })();
+  </script>
