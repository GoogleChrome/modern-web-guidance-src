+  <script>
+    const tourStep = document.getElementById('tour-step');
+    const rewardsLink = document.getElementById('feature');
+
+    let isTourActive = true;
+
+    if (tourStep && typeof tourStep.showPopover === 'function') {
+      tourStep.showPopover();
+      const closeButton = tourStep.querySelector('button');
+      if (closeButton) {
+        closeButton.focus();
+      }
+    }
+
+    if (tourStep) {
+      tourStep.addEventListener('toggle', (event) => {
+        if (event.newState === 'closed') {
+          isTourActive = false;
+        }
+      });
+
+      const closeButton = tourStep.querySelector('button');
+      if (closeButton) {
+        closeButton.addEventListener('click', () => {
+          isTourActive = false;
+          if (typeof tourStep.hidePopover === 'function' && tourStep.matches(':popover-open')) {
+            tourStep.hidePopover();
+          }
+        });
+      }
+    }
+
+    if (rewardsLink) {
+      rewardsLink.addEventListener('click', (event) => {
+        const isPopoverOpen = tourStep && tourStep.matches ? tourStep.matches(':popover-open') : isTourActive;
+        if (isTourActive || isPopoverOpen) {
+          event.preventDefault();
+        }
+      });
+    }
+  </script>
