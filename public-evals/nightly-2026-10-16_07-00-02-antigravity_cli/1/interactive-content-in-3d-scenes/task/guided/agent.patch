+    ctx.fillText('Water: 200°F / 93°C', w / 2, 130);
+    ctx.fillText('Brew Time: 3:30 mins', w / 2, 160);
+    ctx.fillText('Always Grind Fresh', w / 2, 190);
+  }, 256, 672);
+
+  const topTexObj = createTextureFromCanvas(gl, (ctx, w, h) => {
+    ctx.fillStyle = '#2b1712';
+    ctx.fillRect(0, 0, w, h);
+    ctx.strokeStyle = '#ffab40';
+    ctx.lineWidth = 4;
+    ctx.strokeRect(8, 8, w - 16, h - 16);
+
+    ctx.fillStyle = '#ffab40';
+    ctx.font = 'bold 20px "Segoe UI", sans-serif';
+    ctx.textAlign = 'center';
+    ctx.fillText('★ SEALED FOR ROAST FRESHNESS ★', w / 2, h / 2 + 6);
+  }, 512, 256);
+
+  const bottomTexObj = createTextureFromCanvas(gl, (ctx, w, h) => {
+    ctx.fillStyle = '#150a06';
+    ctx.fillRect(0, 0, w, h);
+    ctx.fillStyle = '#d7ccc8';
+    ctx.font = '14px "Segoe UI", sans-serif';
+    ctx.textAlign = 'center';
+    ctx.fillText('100% COMPOSTABLE PACKAGE • BATCH #2026', w / 2, h / 2 + 5);
+  }, 512, 256);
+
+  // Front fallback texture (when HTML-in-Canvas is not supported or before initial upload)
+  const frontFallbackTexObj = createTextureFromCanvas(gl, (ctx, w, h) => {
+    const grad = ctx.createLinearGradient(0, 0, 0, h);
+    grad.addColorStop(0, '#2b1712');
+    grad.addColorStop(1, '#180d09');
+    ctx.fillStyle = grad;
+    ctx.fillRect(0, 0, w, h);
+
+    ctx.strokeStyle = '#ffab40';
+    ctx.lineWidth = 6;
+    ctx.strokeRect(12, 12, w - 24, h - 24);
+
+    ctx.fillStyle = '#ffab40';
+    ctx.font = 'bold 18px "Segoe UI", sans-serif';
+    ctx.textAlign = 'center';
+    ctx.fillText('THE DAILY GRIND', w / 2, 50);
+
+    ctx.fillStyle = '#ffffff';
+    ctx.font = 'bold 24px "Segoe UI", sans-serif';
+    ctx.fillText('Artisanal Roast Club', w / 2, 90);
+  }, 320, 420);
+
+  // Optional stock photo enhancement for back packaging texture
+  const stockPhoto = new Image();
+  stockPhoto.crossOrigin = 'anonymous';
+  stockPhoto.onload = () => {
+    try {
+      const ctx = backTexObj.canvas.getContext('2d');
+      ctx.save();
+      ctx.globalAlpha = 0.28;
+      ctx.drawImage(stockPhoto, 0, 0, backTexObj.canvas.width, backTexObj.canvas.height);
+      ctx.restore();
+      backTexObj.update();
+    } catch (e) {
+      console.warn('Stock photo texture composite bypassed:', e);
+    }
+  };
+  stockPhoto.src = 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80';
+
+  // Front HTML-in-Canvas texture state
+  const frontElementTexture = gl.createTexture();
+  const frontTextureState = { width: 0, height: 0, uploaded: false };
+
+  // 10. 3D Box Dimensions & Transforms
+  // Box dimensions: Width 2.4, Height 3.15 (matching 320x420 aspect ratio), Depth 1.2
+  const boxW = 2.4;
+  const boxH = 3.15;
+  const boxD = 1.2;
+  const hw = boxW / 2;
+  const hh = boxH / 2;
+  const hd = boxD / 2;
+
+  let rotY = 0.35;
+  const tiltX = 0.22; // subtle downward angle for 3D depth
+  let isSpinning = true;
+  let isFacingCamera = true;
+  let htmlElementMVP = mat4Identity();
+  let boxModelMatrix = mat4Identity();
+  let viewMatrix = mat4Identity();
+  let projMatrix = mat4Identity();
+
+  function updateMatrices() {
+    const cw = canvas.clientWidth || 800;
+    const ch = canvas.clientHeight || 560;
+    const aspect = cw / ch;
+
+    projMatrix = mat4Perspective(Math.PI / 4, aspect, 0.1, 100.0);
+    viewMatrix = mat4LookAt([0, 0, 5.2], [0, 0, 0], [0, 1, 0]);
+
+    // Box model rotation
+    boxModelMatrix = mat4Multiply(mat4RotateX(tiltX), mat4RotateY(rotY));
+
+    // Front face quad model transform
+    const frontFaceModel = mat4Multiply(
+      boxModelMatrix,
+      mat4Multiply(mat4Translate(0, 0, hd), mat4Scale(boxW, boxH, 1.0))
+    );
+
+    // Front face MVP
+    htmlElementMVP = mat4Multiply(projMatrix, mat4Multiply(viewMatrix, frontFaceModel));
+
+    // Check if front face is facing camera:
+    // Transformed normal Z component in view space
+    const cosY = Math.cos(rotY);
+    const cosTilt = Math.cos(tiltX);
+    isFacingCamera = (cosY * cosTilt) > 0.05;
+  }
+
+  function drawQuad(faceModel, texture, ambient = 0.45) {
+    const mvp = mat4Multiply(projMatrix, mat4Multiply(viewMatrix, faceModel));
+
+    gl.uniformMatrix4fv(uniformLocations.mvp, false, mvp);
+    gl.uniformMatrix4fv(uniformLocations.model, false, faceModel);
+    gl.uniform3f(uniformLocations.lightDir, 0.5, 0.8, 1.0);
+    gl.uniform4f(uniformLocations.baseColor, 0.2, 0.12, 0.08, 1.0);
+    gl.uniform1f(uniformLocations.useTexture, 1.0);
+    gl.uniform1f(uniformLocations.ambient, ambient);
+
+    gl.activeTexture(gl.TEXTURE0);
+    gl.bindTexture(gl.TEXTURE_2D, texture);
+    gl.uniform1i(uniformLocations.texture, 0);
+
+    gl.drawArrays(gl.TRIANGLES, 0, 6);
+  }
+
+  function drawScene() {
+    gl.viewport(0, 0, canvas.width, canvas.height);
+    gl.clearColor(0.0, 0.0, 0.0, 0.0);
+    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+
+    gl.enable(gl.DEPTH_TEST);
+    gl.depthFunc(gl.LEQUAL);
+    gl.enable(gl.CULL_FACE);
+    gl.cullFace(gl.BACK);
+
+    gl.useProgram(program);
+
+    gl.bindBuffer(gl.ARRAY_BUFFER, quadVBO);
+    gl.enableVertexAttribArray(attribLocations.position);
+    gl.vertexAttribPointer(attribLocations.position, 3, gl.FLOAT, false, 8 * 4, 0);
+
+    gl.enableVertexAttribArray(attribLocations.texCoord);
+    gl.vertexAttribPointer(attribLocations.texCoord, 2, gl.FLOAT, false, 8 * 4, 3 * 4);
+
+    gl.enableVertexAttribArray(attribLocations.normal);
+    gl.vertexAttribPointer(attribLocations.normal, 3, gl.FLOAT, false, 8 * 4, 5 * 4);
+
+    // 1. Back Face (-Z)
+    const backModel = mat4Multiply(
+      boxModelMatrix,
+      mat4Multiply(mat4Translate(0, 0, -hd), mat4Multiply(mat4RotateY(Math.PI), mat4Scale(boxW, boxH, 1.0)))
+    );
+    drawQuad(backModel, backTexObj.texture);
+
+    // 2. Right Face (+X)
+    const rightModel = mat4Multiply(
+      boxModelMatrix,
+      mat4Multiply(mat4Translate(hw, 0, 0), mat4Multiply(mat4RotateY(Math.PI / 2), mat4Scale(boxD, boxH, 1.0)))
+    );
+    drawQuad(rightModel, rightTexObj.texture);
+
+    // 3. Left Face (-X)
+    const leftModel = mat4Multiply(
+      boxModelMatrix,
+      mat4Multiply(mat4Translate(-hw, 0, 0), mat4Multiply(mat4RotateY(-Math.PI / 2), mat4Scale(boxD, boxH, 1.0)))
+    );
+    drawQuad(leftModel, leftTexObj.texture);
+
+    // 4. Top Face (+Y)
+    const topModel = mat4Multiply(
+      boxModelMatrix,
+      mat4Multiply(mat4Translate(0, hh, 0), mat4Multiply(mat4RotateX(-Math.PI / 2), mat4Scale(boxW, boxD, 1.0)))
+    );
+    drawQuad(topModel, topTexObj.texture);
+
+    // 5. Bottom Face (-Y)
+    const bottomModel = mat4Multiply(
+      boxModelMatrix,
+      mat4Multiply(mat4Translate(0, -hh, 0), mat4Multiply(mat4RotateX(Math.PI / 2), mat4Scale(boxW, boxD, 1.0)))
+    );
+    drawQuad(bottomModel, bottomTexObj.texture);
+
+    // 6. Front Face (+Z) with HTML content texture
+    const frontModel = mat4Multiply(
+      boxModelMatrix,
+      mat4Multiply(mat4Translate(0, 0, hd), mat4Scale(boxW, boxH, 1.0))
+    );
+    const activeFrontTexture = (supportsHtmlInCanvas && frontTextureState.uploaded)
+      ? frontElementTexture
+      : frontFallbackTexObj.texture;
+
+    drawQuad(frontModel, activeFrontTexture, 0.85);
+  }
+
+  // Fallback DOM Transform Synchronizer
+  function updateFallbackDOMGeometry() {
+    if (supportsHtmlInCanvas) return;
+
+    const transform = computeCanvasTransform(canvas, formElement, htmlElementMVP);
+    formElement.style.transform = transform.toString();
+
+    if (isFacingCamera) {
+      formElement.style.visibility = 'visible';
+      formElement.style.pointerEvents = 'auto';
+    } else {
+      formElement.style.visibility = 'hidden';
+      formElement.style.pointerEvents = 'none';
+    }
+  }
+
+  // 11. HTML-in-Canvas onpaint Handler
+  if (supportsHtmlInCanvas) {
+    canvas.onpaint = (event) => {
+      // 1. Update texture with HTML content
+      try {
+        if (uploadElementWebGL(gl, canvas, frontElementTexture, formElement, frontTextureState)) {
+          frontTextureState.uploaded = true;
+        }
+      } catch (err) {
+        console.error('texElementSubImage2D copy failed:', err);
+      }
+
+      // Render 3D scene
+      drawScene();
+
+      // 2. Sync DOM position, hit testing, and accessibility bounds with 3D scene
+      if (typeof canvas.updateElementGeometry === 'function') {
+        if (isFacingCamera) {
+          canvas.updateElementGeometry(formElement, {
+            canvasTransform: computeCanvasTransform(canvas, formElement, htmlElementMVP),
+            preserveHitTestOrder: true,
+          });
+        } else if (typeof canvas.clearElementGeometry === 'function') {
+          canvas.clearElementGeometry(formElement);
+        }
+      }
+    };
+  }
+
+  // 12. Main Animation Loop
+  let lastTime = performance.now();
+  const spinSpeed = 0.55; // Radians per second
+
+  function animate(now) {
+    requestAnimationFrame(animate);
+
+    const dt = Math.min((now - lastTime) / 1000, 0.1);
+    lastTime = now;
+
+    if (isSpinning) {
+      rotY = (rotY + spinSpeed * dt) % (Math.PI * 2);
+    }
+
+    updateMatrices();
+
+    if (supportsHtmlInCanvas && typeof canvas.requestPaint === 'function') {
+      canvas.requestPaint();
+    } else {
+      drawScene();
+      updateFallbackDOMGeometry();
+    }
+  }
+
+  requestAnimationFrame(animate);
+
+  // 13. Interactive Form Event Listeners (Retaining Full Clickability while spinning)
+  function requestRepaint() {
+    if (supportsHtmlInCanvas && typeof canvas.requestPaint === 'function') {
+      canvas.requestPaint();
+    }
+  }
+
+  formElement.addEventListener('input', requestRepaint);
+  formElement.addEventListener('change', requestRepaint);
+
+  // Pause / Resume Rotation Toggle
+  if (toggleSpinBtn) {
+    toggleSpinBtn.addEventListener('click', (e) => {
+      e.preventDefault();
+      e.stopPropagation();
+      isSpinning = !isSpinning;
+      toggleSpinBtn.textContent = isSpinning ? 'Pause Spin' : 'Resume Spin';
+      toggleSpinBtn.setAttribute('aria-label', isSpinning ? 'Pause box rotation' : 'Resume box rotation');
+      requestRepaint();
+    });
+  }
+
+  // Order Submission Handling
+  formElement.addEventListener('submit', (e) => {
+    e.preventDefault();
+    const emailInput = document.getElementById('subscriber-email');
+    const blendSelect = document.getElementById('blend-select');
+    const grindSelect = document.getElementById('grind-select');
+
+    const email = emailInput ? emailInput.value.trim() : '';
+    const blend = blendSelect ? blendSelect.value : 'Artisanal Blend';
+    const grind = grindSelect ? grindSelect.value : 'Whole Bean';
+
+    if (!email || !email.includes('@')) {
+      if (orderStatusMsg) {
+        orderStatusMsg.className = 'form-status-alert error';
+        orderStatusMsg.textContent = 'Please enter a valid delivery email.';
+      }
+      requestRepaint();
+      return;
+    }
+
+    if (orderStatusMsg) {
+      orderStatusMsg.className = 'form-status-alert success';
+      orderStatusMsg.textContent = `✓ Box reserved! 1x ${blend} (${grind}) for ${email}.`;
+    }
+
+    requestRepaint();
+  });
+
+  // Pointer drag interaction on scene wrapper to inspect manually
+  let isDragging = false;
+  let previousX = 0;
+
+  sceneWrapper.addEventListener('pointerdown', (e) => {
+    // If clicking directly on a form element or button, let native form interaction proceed
+    if (e.target.closest('#coffee-box-form')) return;
+    isDragging = true;
+    previousX = e.clientX;
+  });
+
+  window.addEventListener('pointermove', (e) => {
+    if (!isDragging) return;
+    const deltaX = e.clientX - previousX;
+    previousX = e.clientX;
+    rotY += deltaX * 0.01;
+    requestRepaint();
+  });
+
+  window.addEventListener('pointerup', () => {
+    isDragging = false;
+  });
+})();
