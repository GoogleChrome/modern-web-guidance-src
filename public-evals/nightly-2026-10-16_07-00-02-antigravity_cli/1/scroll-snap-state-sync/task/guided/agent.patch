+  <script>
+    (function () {
+      function initSeasonalScroll() {
+        const panel = document.querySelector('.seasonal-panel');
+        const tocLinks = document.querySelectorAll('.toc-sidebar a');
+        const drinkSections = document.querySelectorAll('.drink-section');
+
+        if (!panel || !tocLinks.length || !drinkSections.length) return;
+
+        function setActiveLink(id) {
+          tocLinks.forEach(link => {
+            const href = link.getAttribute('href');
+            const isTarget = href === `#${id}`;
+            if (isTarget) {
+              link.setAttribute('aria-current', 'true');
+              link.classList.add('active', ':target-current');
+            } else {
+              link.removeAttribute('aria-current');
+              link.classList.remove('active', ':target-current');
+            }
+          });
+        }
+
+        // Smooth scrolling on click
+        tocLinks.forEach(link => {
+          link.addEventListener('click', (e) => {
+            e.preventDefault();
+            const targetId = link.getAttribute('href').slice(1);
+            const targetSection = document.getElementById(targetId);
+            if (targetSection) {
+              if (typeof targetSection.scrollIntoView === 'function') {
+                targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
+              }
+              setActiveLink(targetId);
+              if (window.history && history.pushState) {
+                history.pushState(null, '', `#${targetId}`);
+              }
+            }
+          });
+        });
+
+        // 1. Native scrollsnapchange event listener
+        if ('onscrollsnapchange' in HTMLElement.prototype || 'onscrollsnapchange' in window) {
+          panel.addEventListener('scrollsnapchange', (e) => {
+            const snapped = e.snapTargetBlock;
+            if (snapped) {
+              const section = snapped.closest('.drink-section') || (snapped.classList.contains('drink-section') ? snapped : null);
+              if (section && section.id) {
+                setActiveLink(section.id);
+              }
+            }
+          });
+        }
+
+        // 2. IntersectionObserver fallback
+        if (typeof IntersectionObserver !== 'undefined') {
+          const observer = new IntersectionObserver((entries) => {
+            entries.forEach(entry => {
+              if (entry.isIntersecting) {
+                const section = entry.target.closest('.drink-section') || entry.target;
+                if (section && section.id) {
+                  setActiveLink(section.id);
+                }
+              }
+            });
+          }, {
+            root: panel,
+            threshold: 0.6
+          });
+
+          drinkSections.forEach(sec => observer.observe(sec));
+        }
+
+        // 3. Scroll event fallback
+        function updateActiveOnScroll() {
+          const panelRect = panel.getBoundingClientRect();
+          let closestSection = null;
+          let minDistance = Infinity;
+
+          drinkSections.forEach(section => {
+            const rect = section.getBoundingClientRect();
+            const distance = Math.abs(rect.top - panelRect.top);
+            if (distance < minDistance) {
+              minDistance = distance;
+              closestSection = section;
+            }
+          });
+
+          if (closestSection && closestSection.id) {
+            setActiveLink(closestSection.id);
+          }
+        }
+
+        let isScrolling = false;
+        panel.addEventListener('scroll', () => {
+          if (!isScrolling) {
+            window.requestAnimationFrame(() => {
+              updateActiveOnScroll();
+              isScrolling = false;
+            });
+            isScrolling = true;
+          }
+        }, { passive: true });
+
+        panel.addEventListener('scrollend', () => {
+          updateActiveOnScroll();
+        });
+
+        // Initialize active link based on URL hash or default to first section
+        const initialHash = window.location.hash.slice(1);
+        if (initialHash && document.getElementById(initialHash)) {
+          setActiveLink(initialHash);
+        } else if (drinkSections[0] && drinkSections[0].id) {
+          setActiveLink(drinkSections[0].id);
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initSeasonalScroll);
+      } else {
+        initSeasonalScroll();
+      }
+    })();
+  </script>
+
