+  <script>
+    function initSeasonalNav() {
+      const seasonalPanel = document.querySelector('.seasonal-panel');
+      const tocSidebar = document.querySelector('.toc-sidebar');
+      if (!seasonalPanel || !tocSidebar) return;
+
+      const tocLinks = Array.from(tocSidebar.querySelectorAll('a'));
+      const drinkSections = Array.from(seasonalPanel.querySelectorAll('.drink-section'));
+      let isClickScrolling = false;
+      let scrollTimeout = null;
+
+      function setActiveSection(targetId) {
+        if (!targetId) return;
+        const cleanId = targetId.replace(/^#/, '');
+
+        tocLinks.forEach(link => {
+          const href = link.getAttribute('href') || '';
+          const linkId = href.replace(/^#/, '');
+          const isCurrent = (linkId === cleanId);
+
+          if (isCurrent) {
+            link.classList.add('active');
+            link.setAttribute('aria-current', 'true');
+            if (link.parentElement && link.parentElement.tagName === 'LI') {
+              link.parentElement.classList.add('active');
+            }
+          } else {
+            link.classList.remove('active');
+            link.removeAttribute('aria-current');
+            if (link.parentElement && link.parentElement.tagName === 'LI') {
+              link.parentElement.classList.remove('active');
+            }
+          }
+        });
+      }
+
+      function getSnappedSection() {
+        const panelRect = seasonalPanel.getBoundingClientRect();
+        const panelScrollTop = seasonalPanel.scrollTop;
+        let closestSection = null;
+        let minDistance = Infinity;
+
+        drinkSections.forEach(section => {
+          const sectionRect = section.getBoundingClientRect();
+          if (panelRect.height > 0 && sectionRect.height > 0) {
+            const distance = Math.abs(sectionRect.top - panelRect.top);
+            if (distance < minDistance) {
+              minDistance = distance;
+              closestSection = section;
+            }
+          } else {
+            const sectionOffset = section.offsetTop - seasonalPanel.offsetTop;
+            const distance = Math.abs(sectionOffset - panelScrollTop);
+            if (distance < minDistance) {
+              minDistance = distance;
+              closestSection = section;
+            }
+          }
+        });
+
+        return closestSection || drinkSections[0];
+      }
+
+      function onScroll() {
+        if (isClickScrolling) return;
+        const snapped = getSnappedSection();
+        if (snapped && snapped.id) {
+          setActiveSection(snapped.id);
+        }
+      }
+
+      // Intersection Observer for scroll snapping detection
+      const visibilityMap = new Map();
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          if (isClickScrolling) return;
+
+          entries.forEach(entry => {
+            const section = entry.target.closest('.drink-section') || entry.target;
+            if (section) {
+              if (entry.isIntersecting) {
+                visibilityMap.set(section, entry.intersectionRatio);
+              } else {
+                visibilityMap.delete(section);
+              }
+            }
+          });
+
+          let bestSection = null;
+          let maxRatio = 0;
+          visibilityMap.forEach((ratio, section) => {
+            if (ratio > maxRatio) {
+              maxRatio = ratio;
+              bestSection = section;
+            }
+          });
+
+          if (bestSection && bestSection.id) {
+            setActiveSection(bestSection.id);
+          }
+        }, {
+          root: seasonalPanel,
+          threshold: [0.1, 0.25, 0.5, 0.75, 1.0]
+        });
+
+        drinkSections.forEach(section => {
+          observer.observe(section);
+          const header = section.querySelector('header');
+          if (header) observer.observe(header);
+        });
+      }
+
+      seasonalPanel.addEventListener('scroll', onScroll, { passive: true });
+      seasonalPanel.addEventListener('scrollend', () => {
+        isClickScrolling = false;
+        onScroll();
+      }, { passive: true });
+
+      // Handle clicking TOC links
+      tocLinks.forEach(link => {
+        link.addEventListener('click', (e) => {
+          e.preventDefault();
+          const href = link.getAttribute('href');
+          if (!href) return;
+          const targetId = href.replace(/^#/, '');
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          // Highlight link and set aria-current immediately
+          setActiveSection(targetId);
+
+          isClickScrolling = true;
+          clearTimeout(scrollTimeout);
+          scrollTimeout = setTimeout(() => {
+            isClickScrolling = false;
+            onScroll();
+          }, 800);
+
+          // Calculate target scroll offset
+          const panelRect = seasonalPanel.getBoundingClientRect();
+          const targetRect = targetSection.getBoundingClientRect();
+          let targetScrollTop;
+
+          if (panelRect.height > 0 && targetRect.height > 0) {
+            targetScrollTop = seasonalPanel.scrollTop + (targetRect.top - panelRect.top);
+          } else {
+            targetScrollTop = targetSection.offsetTop - seasonalPanel.offsetTop;
+            if (isNaN(targetScrollTop) || targetScrollTop < 0) {
+              targetScrollTop = targetSection.offsetTop;
+            }
+          }
+
+          // Smoothly scroll the panel to the target section
+          if (typeof seasonalPanel.scrollTo === 'function') {
+            seasonalPanel.scrollTo({
+              top: targetScrollTop,
+              behavior: 'smooth'
+            });
+          } else {
+            seasonalPanel.scrollTop = targetScrollTop;
+          }
+
+          const targetHeader = targetSection.querySelector('header') || targetSection;
+          if (typeof targetHeader.scrollIntoView === 'function') {
+            try {
+              targetHeader.scrollIntoView({ behavior: 'smooth', block: 'start' });
+            } catch (err) {
+              targetHeader.scrollIntoView(true);
+            }
+          }
+
+          if (window.history && window.history.pushState) {
+            history.pushState(null, '', '#' + targetId);
+          }
+        });
+      });
+
+      // Initialize initial state
+      if (drinkSections.length > 0) {
+        if (window.location.hash) {
+          const initialId = window.location.hash.replace(/^#/, '');
+          const initialSection = document.getElementById(initialId);
+          if (initialSection) {
+            setActiveSection(initialId);
+            setTimeout(() => {
+              seasonalPanel.scrollTo({
+                top: initialSection.offsetTop - seasonalPanel.offsetTop,
+                behavior: 'smooth'
+              });
+            }, 100);
+            return;
+          }
+        }
+        setActiveSection(drinkSections[0].id);
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initSeasonalNav);
+    } else {
+      initSeasonalNav();
+    }
+  </script>
+
