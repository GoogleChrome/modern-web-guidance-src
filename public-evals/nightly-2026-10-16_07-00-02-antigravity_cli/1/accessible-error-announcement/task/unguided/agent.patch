+  <script>
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterForm = document.getElementById('newsletter-form');
+
+    let isInteracted = false;
+
+    function isEmailUserInvalid() {
+      try {
+        if (newsletterEmail.matches(':user-invalid')) {
+          return true;
+        }
+      } catch (err) {
+        // Fallback if browser doesn't support :user-invalid in matches()
+      }
+      return isInteracted && !newsletterEmail.checkValidity();
+    }
+
+    function syncAriaInvalid() {
+      if (isEmailUserInvalid()) {
+        newsletterEmail.setAttribute('aria-invalid', 'true');
+      } else {
+        newsletterEmail.setAttribute('aria-invalid', 'false');
+      }
+    }
+
+    newsletterEmail.addEventListener('blur', () => {
+      if (newsletterEmail.value !== '' || newsletterEmail.matches(':user-invalid')) {
+        isInteracted = true;
+      }
+      syncAriaInvalid();
+    });
+
+    newsletterEmail.addEventListener('input', () => {
+      syncAriaInvalid();
+    });
+
+    newsletterEmail.addEventListener('invalid', () => {
+      isInteracted = true;
+      setTimeout(syncAriaInvalid, 0);
+    });
+
+    if (newsletterForm) {
+      newsletterForm.addEventListener('submit', (e) => {
+        isInteracted = true;
+        syncAriaInvalid();
+        if (!newsletterEmail.checkValidity()) {
+          e.preventDefault();
+        } else {
+          e.preventDefault();
+          newsletterForm.reset();
+          isInteracted = false;
+          syncAriaInvalid();
+        }
+      });
+    }
+  </script>
+
 </body>
 
