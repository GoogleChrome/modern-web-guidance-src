+          const digitsOnlyPhone = phone ? phone.value.replace(/\D/g, '') : '';
+          if (!phone || !phone.value.trim()) {
+            setFieldError('phone', 'phone-error', 'Please enter your phone number.', errors);
+          } else if (digitsOnlyPhone.length < 10) {
+            setFieldError('phone', 'phone-error', 'Please enter a complete 10-digit phone number.', errors);
+          }
+
+          const score = evaluatePasswordRules(pw ? pw.value : '');
+          if (!pw || !pw.value) {
+            setFieldError('password', 'password-error', 'Please create a password.', errors);
+          } else if (score < 4) {
+            setFieldError('password', 'password-error', 'Password must satisfy at least 4 of the complexity requirements above.', errors);
+          }
+
+          if (!cpw || !cpw.value) {
+            setFieldError('confirm-password', 'confirm-password-error', 'Please re-enter your password.', errors);
+          } else if (pw && pw.value !== cpw.value) {
+            setFieldError('confirm-password', 'confirm-password-error', 'Passwords do not match. Please ensure both passwords match.', errors);
+          }
+
+        } else if (stepIndex === 1) {
+          // Step 2: Birthday Month, Birthday Day, Home Store, Roasts (at least one)
+          const bm = document.getElementById('bday-month');
+          const bd = document.getElementById('bday-day');
+          const hs = document.getElementById('home-store');
+          const roasts = document.querySelectorAll('input[name="roasts"]:checked');
+
+          if (!bm || !bm.value) {
+            setFieldError('bday-month', 'bday-month-error', 'Please select your birth month for your birthday drink perk.', errors);
+          }
+
+          if (!bd || !bd.value) {
+            setFieldError('bday-day', 'bday-day-error', 'Please select your birth day.', errors);
+          }
+
+          if (!hs || !hs.value) {
+            setFieldError('home-store', 'home-store-error', 'Please select your primary store location.', errors);
+          }
+
+          if (!roasts || roasts.length === 0) {
+            const roastsErr = document.getElementById('roasts-error');
+            if (roastsErr) roastsErr.textContent = 'Please select at least one favorite coffee roast or style.';
+            errors.push({ id: 'roast-medium', message: 'Please select at least one favorite coffee roast or style.' });
+          }
+
+        } else if (stepIndex === 2) {
+          // Step 3: Terms Agreement & Honeypot Check
+          const terms = document.getElementById('terms-agree');
+          const honeypot = document.getElementById('company_fax_trap');
+
+          // Bot detection: If honeypot filled, block silently or alert
+          if (honeypot && honeypot.value.trim().length > 0) {
+            errors.push({ id: 'terms-agree', message: 'Spam submission detected. Registration aborted.' });
+            return false;
+          }
+
+          if (!terms || !terms.checked) {
+            setFieldError('terms-agree', 'terms-agree-error', 'You must agree to the Terms of Service and Privacy Policy to register.', errors);
+          }
+        }
+
+        if (errors.length > 0) {
+          showErrorSummary(errors);
+          return false;
+        }
+
+        return true;
+      }
+
+      function showErrorSummary(errors) {
+        if (!errorSummary || !errorSummaryList) return;
+        errorSummaryList.innerHTML = '';
+        errors.forEach(err => {
+          const li = document.createElement('li');
+          const link = document.createElement('a');
+          link.href = '#' + err.id;
+          link.textContent = err.message;
+          link.addEventListener('click', function (e) {
+            e.preventDefault();
+            const targetEl = document.getElementById(err.id);
+            if (targetEl) {
+              targetEl.focus();
+              targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
+            }
+          });
+          li.appendChild(link);
+          errorSummaryList.appendChild(li);
+        });
+        errorSummary.hidden = false;
+        errorSummary.focus();
+        announceToSR('There are ' + errors.length + ' error(s) in this step. Please review the error summary above.');
+      }
+
+      // --- Review Step Population ---
+      function populateReviewCard() {
+        const fn = (document.getElementById('first-name')?.value || '').trim();
+        const ln = (document.getElementById('last-name')?.value || '').trim();
+        const email = (document.getElementById('email')?.value || '').trim();
+        const phone = (document.getElementById('phone')?.value || '').trim();
+        setSafeText('rev-name', fn + ' ' + ln);
+        setSafeText('rev-email', email);
+        setSafeText('rev-phone', phone);
+
+        const store = document.getElementById('home-store')?.value || '';
+        const bMonth = document.getElementById('bday-month')?.value || '';
+        const bDay = document.getElementById('bday-day')?.value || '';
+        const milk = document.getElementById('milk-pref')?.value || '';
+        setSafeText('rev-store', store);
+        setSafeText('rev-birthday', bMonth && bDay ? bMonth + ' ' + bDay : '-');
+        setSafeText('rev-milk', milk);
+
+        const checkedRoasts = Array.from(document.querySelectorAll('input[name="roasts"]:checked')).map(cb => cb.value);
+        setSafeText('rev-roasts', checkedRoasts.length ? checkedRoasts.join(', ') : 'None selected');
+
+        const twoFa = document.getElementById('two-factor-method')?.value || '';
+        setSafeText('rev-2fa', twoFa);
+
+        const alerts = [];
+        if (document.getElementById('notify-promos')?.checked) alerts.push('Bonus Stars');
+        if (document.getElementById('notify-sms')?.checked) alerts.push('Order SMS');
+        if (document.getElementById('notify-receipts')?.checked) alerts.push('Receipts');
+        setSafeText('rev-alerts', alerts.length ? alerts.join(', ') : 'None');
+      }
+
+      // --- Step Navigation State Management ---
+      function goToStep(targetIndex) {
+        if (targetIndex < 0 || targetIndex >= stepFieldsets.length) return;
+
+        stepFieldsets.forEach((fs, idx) => {
+          if (idx === targetIndex) {
+            fs.hidden = false;
+          } else {
+            fs.hidden = true;
+          }
+        });
+
+        stepNavItems.forEach((item, idx) => {
+          const statusSpan = item.querySelector('.status-text');
+          if (idx === targetIndex) {
+            item.className = 'step-item active';
+            item.setAttribute('aria-current', 'step');
+            if (statusSpan) statusSpan.textContent = '(Current Step)';
+          } else if (idx < targetIndex) {
+            item.className = 'step-item completed';
+            item.removeAttribute('aria-current');
+            if (statusSpan) statusSpan.textContent = '(Completed Step)';
+          } else {
+            item.className = 'step-item';
+            item.removeAttribute('aria-current');
+            if (statusSpan) statusSpan.textContent = '(Upcoming Step)';
+          }
+        });
+
+        // Update Progress Bar
+        const stepPct = ((targetIndex + 1) / stepFieldsets.length) * 100;
+        if (progressBarFill) {
+          progressBarFill.style.width = stepPct + '%';
+        }
+        if (progressBarTrack) {
+          progressBarTrack.setAttribute('aria-valuenow', targetIndex + 1);
+          const stepNames = ['Account Details', 'Coffee Preferences', 'Security & Review'];
+          progressBarTrack.setAttribute('aria-valuetext', 'Step ' + (targetIndex + 1) + ' of 3: ' + stepNames[targetIndex]);
+        }
+
+        currentStepIndex = targetIndex;
+
+        if (targetIndex === 2) {
+          populateReviewCard();
+        }
+
+        // Focus Management: Set focus to the legend of the new active step
+        const newLegend = stepFieldsets[targetIndex].querySelector('legend');
+        if (newLegend) {
+          newLegend.setAttribute('tabindex', '-1');
+          newLegend.focus();
+        }
+
+        const stepNames = ['Account Details', 'Coffee Preferences', 'Security & Review'];
+        announceToSR('Navigated to Step ' + (targetIndex + 1) + ' of 3: ' + stepNames[targetIndex]);
+      }
+
+      // --- Navigation Button Listeners ---
+      document.getElementById('btn-step-1-next')?.addEventListener('click', function () {
+        if (validateStep(0)) {
+          goToStep(1);
+        }
+      });
+
+      document.getElementById('btn-step-2-back')?.addEventListener('click', function () {
+        clearFieldErrors(1);
+        goToStep(0);
+      });
+
+      document.getElementById('btn-step-2-next')?.addEventListener('click', function () {
+        if (validateStep(1)) {
+          goToStep(2);
+        }
+      });
+
+      document.getElementById('btn-step-3-back')?.addEventListener('click', function () {
+        clearFieldErrors(2);
+        goToStep(1);
+      });
+
+      // Jump links from Review Card
+      document.querySelectorAll('.btn-edit-step').forEach(btn => {
+        btn.addEventListener('click', function () {
+          const jumpStep = parseInt(this.getAttribute('data-jump'), 10) - 1;
+          if (!isNaN(jumpStep)) {
+            goToStep(jumpStep);
+          }
+        });
+      });
+
+      // --- Form Submission Handler ---
+      form?.addEventListener('submit', function (e) {
+        e.preventDefault();
+
+        // Validate final step
+        if (!validateStep(2)) {
+          return;
+        }
+
+        const submitBtn = document.getElementById('btn-submit-registration');
+        if (submitBtn) {
+          submitBtn.disabled = true;
+          submitBtn.textContent = 'Activating Your Rewards Pass...';
+        }
+
+        // Simulate secure server processing
+        setTimeout(() => {
+          const fn = (document.getElementById('first-name')?.value || '').trim();
+          const ln = (document.getElementById('last-name')?.value || '').trim();
+          const store = document.getElementById('home-store')?.value || 'Downtown Flagship';
+          const bMonth = document.getElementById('bday-month')?.value || '';
+
+          // Generate randomized Member ID
+          const randomId = 'DG-' + Math.floor(1000 + Math.random() * 9000) + '-' + Math.floor(1000 + Math.random() * 9000);
+
+          setSafeText('badge-member-name', fn + ' ' + ln);
+          setSafeText('badge-member-id', randomId);
+          setSafeText('badge-member-store', store);
+          setSafeText('badge-bday-status', bMonth ? bMonth + ' Voucher Ready' : 'Active');
+
+          // Hide form, reveal success state
+          form.hidden = true;
+          if (successRegion) {
+            successRegion.hidden = false;
+            successRegion.focus();
+          }
+
+          announceToSR('Registration successful! Welcome to The Daily Grind Rewards. Your digital membership pass is now active.');
+        }, 600);
+      });
+
+      // --- Reset / Register Another Member Handler ---
+      document.getElementById('btn-restart-registration')?.addEventListener('click', function () {
+        form.reset();
+        evaluatePasswordRules('');
+        clearFieldErrors(0);
+        clearFieldErrors(1);
+        clearFieldErrors(2);
+
+        // Regenerate CSRF Token
+        const newToken = generateCsrfToken();
+        if (rewardsCsrfInput) rewardsCsrfInput.value = newToken;
+
+        const submitBtn = document.getElementById('btn-submit-registration');
+        if (submitBtn) {
+          submitBtn.disabled = false;
+          submitBtn.textContent = 'Complete Registration & Claim 50 Stars \u2605';
+        }
+
+        if (successRegion) successRegion.hidden = true;
+        form.hidden = false;
+        goToStep(0);
+      });
+
+    })();
+  </script>
+
 </body>
 
 </html>
