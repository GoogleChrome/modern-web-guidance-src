+  <!-- Floating Draggable Element -->
+  <aside class="floating-element draggable" id="floating-element" role="region" aria-label="Daily Special">
+    <div class="drag-handle" id="drag-handle" tabindex="0" role="button" aria-label="Drag element or use arrow keys to move">
