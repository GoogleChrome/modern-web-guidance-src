+  <script>
+    (function () {
+      'use strict';
+
+      let currentDrag = null;
+
+      function getCoords(e) {
+        if (e.touches && e.touches.length > 0) {
+          return { x: e.touches[0].clientX, y: e.touches[0].clientY };
+        }
+        if (e.changedTouches && e.changedTouches.length > 0) {
+          return { x: e.changedTouches[0].clientX, y: e.changedTouches[0].clientY };
+        }
+        return { x: e.clientX, y: e.clientY };
+      }
+
+      function shouldIgnoreTarget(target) {
+        if (!target) return false;
+        return !!target.closest('button, a, input, select, textarea, summary, [role="button"], [data-no-drag]');
+      }
+
+      function startDrag(element, e) {
+        if (!element || currentDrag) return;
+
+        if (e.type === 'mousedown' && e.button !== 0) return;
+        if (e.type === 'pointerdown' && e.button !== 0 && e.button !== -1) return;
+        if (shouldIgnoreTarget(e.target)) return;
+
+        const coords = getCoords(e);
+        const rect = element.getBoundingClientRect();
+        const computed = window.getComputedStyle(element);
+        const isFixed = (computed.position === 'fixed');
+
+        const startLeft = isFixed ? rect.left : (rect.left + (window.scrollX || 0));
+        const startTop = isFixed ? rect.top : (rect.top + (window.scrollY || 0));
+
+        element.style.left = startLeft + 'px';
+        element.style.top = startTop + 'px';
+        element.style.right = 'auto';
+        element.style.bottom = 'auto';
+
+        currentDrag = {
+          element: element,
+          eventType: e.type,
+          pointerId: e.pointerId ?? null,
+          startX: coords.x,
+          startY: coords.y,
+          startLeft: startLeft,
+          startTop: startTop,
+          isFixed: isFixed
+        };
+
+        element.classList.add('is-dragging');
+        document.body.classList.add('floating-dragging-active');
+
+        if (e.cancelable && e.type !== 'touchstart') {
+          e.preventDefault();
+        }
+
+        if (e.pointerId != null && element.setPointerCapture) {
+          try {
+            element.setPointerCapture(e.pointerId);
+          } catch (_) {}
+        }
+      }
+
+      function moveDrag(e) {
+        if (!currentDrag) return;
+
+        if (currentDrag.eventType === 'pointerdown' && e.type.startsWith('mouse')) return;
+        if (currentDrag.eventType === 'mousedown' && e.type.startsWith('pointer')) return;
+        if (currentDrag.pointerId != null && e.pointerId != null && e.pointerId !== currentDrag.pointerId) return;
+
+        const coords = getCoords(e);
+        const dx = coords.x - currentDrag.startX;
+        const dy = coords.y - currentDrag.startY;
+
+        const newLeft = currentDrag.startLeft + dx;
+        const newTop = currentDrag.startTop + dy;
+
+        currentDrag.element.style.left = newLeft + 'px';
+        currentDrag.element.style.top = newTop + 'px';
+
+        if (e.cancelable) {
+          e.preventDefault();
+        }
+      }
+
+      function endDrag(e) {
+        if (!currentDrag) return;
+
+        if (currentDrag.eventType === 'pointerdown' && e.type.startsWith('mouse')) return;
+        if (currentDrag.eventType === 'mousedown' && e.type.startsWith('pointer')) return;
+        if (currentDrag.pointerId != null && e.pointerId != null && e.pointerId !== currentDrag.pointerId) return;
+
+        if (currentDrag.pointerId != null && currentDrag.element.releasePointerCapture) {
+          try {
+            currentDrag.element.releasePointerCapture(currentDrag.pointerId);
+          } catch (_) {}
+        }
+
+        currentDrag.element.classList.remove('is-dragging');
+        document.body.classList.remove('floating-dragging-active');
+        currentDrag = null;
+      }
+
+      function makeDraggable(element, handle) {
+        if (!element) return;
+
+        const startHandler = function (e) {
+          startDrag(element, e);
+        };
+
+        element.addEventListener('pointerdown', startHandler, { passive: false });
+        element.addEventListener('mousedown', startHandler);
+        element.addEventListener('touchstart', startHandler, { passive: false });
+
+        if (handle && handle !== element) {
+          handle.addEventListener('pointerdown', startHandler, { passive: false });
+          handle.addEventListener('mousedown', startHandler);
+          handle.addEventListener('touchstart', startHandler, { passive: false });
+        }
+
+        element.addEventListener('dragstart', function (e) {
+          if (currentDrag) {
+            e.preventDefault();
+            return;
+          }
+          const rect = element.getBoundingClientRect();
+          element._dndStartX = e.clientX;
+          element._dndStartY = e.clientY;
+          element._dndStartLeft = rect.left;
+          element._dndStartTop = rect.top;
+          if (e.dataTransfer) {
+            e.dataTransfer.setData('text/plain', '');
+            e.dataTransfer.effectAllowed = 'move';
+          }
+        });
+
+        element.addEventListener('dragend', function (e) {
+          if (e.clientX !== 0 || e.clientY !== 0) {
+            const dx = e.clientX - element._dndStartX;
+            const dy = e.clientY - element._dndStartY;
