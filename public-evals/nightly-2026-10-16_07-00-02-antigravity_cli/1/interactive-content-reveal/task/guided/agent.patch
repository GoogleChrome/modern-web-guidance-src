+  <script>
+    (function () {
+      function initSpotlight() {
+        const productCards = document.querySelectorAll('.product-card');
+
+        productCards.forEach((card) => {
+          const updatePointerPosition = (e) => {
+            const rect = card.getBoundingClientRect();
+            const x = e.clientX - rect.left;
+            const y = e.clientY - rect.top;
+            card.style.setProperty('--mouse-x', `${x}px`);
+            card.style.setProperty('--mouse-y', `${y}px`);
+          };
+
+          card.addEventListener('pointermove', updatePointerPosition);
+          card.addEventListener('mousemove', updatePointerPosition);
+          card.addEventListener('pointerenter', updatePointerPosition);
+          card.addEventListener('mouseenter', updatePointerPosition);
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initSpotlight);
+      } else {
+        initSpotlight();
+      }
+    })();
+  </script>
