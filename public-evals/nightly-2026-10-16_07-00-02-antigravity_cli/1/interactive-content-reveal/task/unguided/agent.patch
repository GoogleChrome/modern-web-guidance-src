+    /* Product Card & Spotlight Effect */
+    @property --mouse-x {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --mouse-y {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --inner-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      position: relative;
+      overflow: hidden;
+      --mouse-x: 0px;
+      --mouse-y: 0px;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      transition: --inner-size 0.35s ease, --outer-size 0.35s ease;
+    }
+
+    .product-card:hover {
+      --inner-size: 80px;
+      --outer-size: 160px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
+    .spotlight-overlay {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 100%;
+      height: 100%;
+      pointer-events: none;
+      z-index: 1;
+      display: flex;
+      flex-direction: column;
+      justify-content: flex-end;
+      padding: 15px;
+      border-radius: 8px;
+      overflow: hidden;
+      -webkit-mask-image: radial-gradient(
+        circle at var(--mouse-x, 0px) var(--mouse-y, 0px),
+        black var(--inner-size, 0px),
+        transparent var(--outer-size, 0px)
+      );
+      mask-image: radial-gradient(
+        circle at var(--mouse-x, 0px) var(--mouse-y, 0px),
+        black var(--inner-size, 0px),
+        transparent var(--outer-size, 0px)
+      );
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+      -webkit-mask-size: 100% 100%;
+      mask-size: 100% 100%;
+    }
+
+    .spotlight-img {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      opacity: 0.25;
+      z-index: 1;
+    }
+
+    .spotlight-details {
+      position: relative;
+      z-index: 2;
+      display: flex;
+      flex-direction: column;
+      gap: 4px;
+      font-size: 0.8rem;
+      color: var(--text);
+    }
+
+    .spotlight-tag {
+      display: inline-block;
+      align-self: center;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      font-size: 0.75rem;
+      padding: 2px 8px;
+      border-radius: 10px;
+    }
+
+    .spotlight-price {
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .spotlight-notes {
+      font-size: 0.75rem;
+      color: #555;
+    }
+
+    .product-card h3,
+    .product-card p,
+    .product-card .btn {
+      position: relative;
+      z-index: 2;
+    }
+
     .card h3 {
