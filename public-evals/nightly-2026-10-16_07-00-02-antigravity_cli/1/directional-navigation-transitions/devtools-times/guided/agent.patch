@@ -0,0 +1,207 @@
+import React, { useState, useEffect } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/20/solid';
+
+export interface Story {
+  id: string;
+  title: string;
+  date: string;
+  url: string;
+  category?: string;
+}
+
+export interface TopStoriesSliderProps {
+  stories: Story[];
+}
+
+export default function TopStoriesSlider({ stories }: TopStoriesSliderProps) {
+  if (!stories || stories.length === 0) return null;
+
+  const [currentIndex, setCurrentIndex] = useState(0);
+  const [animatingState, setAnimatingState] = useState<{
+    outgoingIndex: number;
+    incomingIndex: number;
+    direction: 'next' | 'prev';
+  } | null>(null);
+
+  // Safety timer to clear animating state if onAnimationEnd does not trigger
+  useEffect(() => {
+    if (!animatingState) return;
+
+    const timer = setTimeout(() => {
+      setCurrentIndex(animatingState.incomingIndex);
+      setAnimatingState(null);
+    }, 350);
+
+    return () => clearTimeout(timer);
+  }, [animatingState]);
+
+  const switchStory = (direction: 'next' | 'prev') => {
+    if (stories.length <= 1) return;
+
+    // Respect reduced-motion preferences
+    const prefersReducedMotion =
+      typeof window !== 'undefined' &&
+      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+    const fromIndex = animatingState ? animatingState.incomingIndex : currentIndex;
+    const toIndex =
+      direction === 'next'
+        ? (fromIndex + 1) % stories.length
+        : (fromIndex - 1 + stories.length) % stories.length;
+
+    if (prefersReducedMotion) {
+      setCurrentIndex(toIndex);
+      setAnimatingState(null);
+      return;
+    }
+
+    setAnimatingState({
+      outgoingIndex: fromIndex,
+      incomingIndex: toIndex,
+      direction,
+    });
+  };
+
+  const handlePrev = () => switchStory('prev');
+  const handleNext = () => switchStory('next');
+
+  const activeStory = animatingState
+    ? stories[animatingState.incomingIndex]
+    : stories[currentIndex];
+
+  const outgoingStory = animatingState
+    ? stories[animatingState.outgoingIndex]
+    : null;
+
+  return (
+    <div
+      className="bg-white border-b border-gray-300"
+      role="region"
+      aria-roledescription="carousel"
+      aria-label="Top stories slider"
+    >
+      <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
+        <div className="flex items-center justify-between gap-3 sm:gap-6">
+          {/* Left / Center: Top Stories label and animated slide */}
+          <div className="flex items-center gap-3 sm:gap-4 flex-1 min-w-0">
+            <span className="shrink-0 text-xs font-bold tracking-wider uppercase text-gray-900 bg-gray-100 border border-gray-300 px-2.5 py-1 rounded">
+              Top Story
+            </span>
+
+            {/* Slider track viewport */}
+            <div
+              className="relative overflow-hidden flex-1 min-w-0 h-10 flex items-center top-story-slide"
+              aria-live="polite"
+            >
+              {animatingState && outgoingStory ? (
+                <>
+                  {/* Outgoing Story */}
+                  <div
+                    key={`outgoing-${animatingState.outgoingIndex}`}
+                    className={`absolute inset-0 w-full flex items-center pointer-events-none ${
+                      animatingState.direction === 'next'
+                        ? 'animate-slide-out-to-left'
+                        : 'animate-slide-out-to-right'
+                    }`}
+                    aria-hidden="true"
+                  >
+                    <div className="flex items-baseline gap-2 sm:gap-3 min-w-0 w-full truncate">
+                      <a
+                        href={outgoingStory.url}
+                        tabIndex={-1}
+                        className="truncate"
+                      >
+                        <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer text-sm sm:text-base truncate transition-colors">
+                          {outgoingStory.title}
+                        </h3>
+                      </a>
+                      <span className="text-xs text-gray-500 shrink-0 whitespace-nowrap">
+                        {outgoingStory.date}
+                      </span>
+                    </div>
+                  </div>
+
+                  {/* Incoming Story */}
+                  <div
+                    key={`incoming-${animatingState.incomingIndex}`}
+                    className={`w-full flex items-center ${
+                      animatingState.direction === 'next'
+                        ? 'animate-slide-in-from-right'
+                        : 'animate-slide-in-from-left'
+                    }`}
+                    onAnimationEnd={() => {
+                      setCurrentIndex(animatingState.incomingIndex);
+                      setAnimatingState(null);
+                    }}
+                  >
+                    <div className="flex items-baseline gap-2 sm:gap-3 min-w-0 w-full truncate">
+                      <a
+                        href={activeStory.url}
+                        className="truncate"
+                      >
+                        <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer text-sm sm:text-base truncate transition-colors">
+                          {activeStory.title}
+                        </h3>
+                      </a>
+                      <span className="text-xs text-gray-500 shrink-0 whitespace-nowrap">
+                        {activeStory.date}
+                      </span>
+                    </div>
+                  </div>
+                </>
+              ) : (
+                /* Static Story */
+                <div
+                  key={`static-${currentIndex}`}
+                  className="w-full flex items-center"
+                >
+                  <div className="flex items-baseline gap-2 sm:gap-3 min-w-0 w-full truncate">
+                    <a
+                      href={activeStory.url}
+                      className="truncate"
+                    >
+                      <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer text-sm sm:text-base truncate transition-colors">
+                        {activeStory.title}
+                      </h3>
+                    </a>
+                    <span className="text-xs text-gray-500 shrink-0 whitespace-nowrap">
+                      {activeStory.date}
+                    </span>
+                  </div>
+                </div>
+              )}
+            </div>
+          </div>
+
+          {/* Right: Controls (Previous & Next buttons) */}
+          <div className="flex items-center gap-1.5 sm:gap-2 shrink-0">
+            <span
+              className="text-xs text-gray-500 font-medium mr-1 hidden md:inline"
+              aria-label={`Story ${(animatingState ? animatingState.incomingIndex : currentIndex) + 1} of ${stories.length}`}
+            >
+              {(animatingState ? animatingState.incomingIndex : currentIndex) + 1} / {stories.length}
+            </span>
+            <button
+              type="button"
+              onClick={handlePrev}
+              aria-label="Previous"
+              className="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold text-gray-700 bg-white hover:bg-gray-100 active:bg-gray-200 rounded border border-gray-300 transition-colors cursor-pointer shadow-xs"
+            >
+              <ChevronLeftIcon className="w-4 h-4" aria-hidden="true" />
+              <span>Previous</span>
+            </button>
+            <button
+              type="button"
+              onClick={handleNext}
+              aria-label="Next"
+              className="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold text-gray-700 bg-white hover:bg-gray-100 active:bg-gray-200 rounded border border-gray-300 transition-colors cursor-pointer shadow-xs"
+            >
+              <span>Next</span>
+              <ChevronRightIcon className="w-4 h-4" aria-hidden="true" />
+            </button>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
