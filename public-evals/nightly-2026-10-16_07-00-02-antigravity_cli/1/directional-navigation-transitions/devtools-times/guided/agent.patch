@@ -4,4 +4,101 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
+}
+
+/* Directional Slide Keyframes */
+@keyframes slide-to-left {
+  from {
+    transform: translateX(0);
+  }
+  to {
+    transform: translateX(-100%);
+  }
+}
+
+@keyframes slide-from-right {
+  from {
+    transform: translateX(100%);
+  }
+  to {
+    transform: translateX(0);
+  }
+}
+
+@keyframes slide-to-right {
+  from {
+    transform: translateX(0);
+  }
+  to {
+    transform: translateX(100%);
+  }
+}
+
+@keyframes slide-from-left {
+  from {
+    transform: translateX(-100%);
+  }
+  to {
+    transform: translateX(0);
+  }
+}
+
+/* Slider animation classes */
+.animate-slide-in-from-right {
+  animation: slide-from-right 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
+}
+
+.animate-slide-out-to-left {
+  animation: slide-to-left 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
+}
+
+.animate-slide-in-from-left {
+  animation: slide-from-left 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
+}
+
+.animate-slide-out-to-right {
+  animation: slide-to-right 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
+}
+
+/* View transitions support for directional navigation */
+.top-story-slide {
+  view-transition-name: top-story-slide;
+}
+
+::view-transition-group(top-story-slide) {
+  animation-duration: 0.3s;
+  animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
+  overflow: clip;
+}
+
+html:active-view-transition-type(forward)::view-transition-old(top-story-slide) {
+  animation-name: slide-to-left;
+}
+html:active-view-transition-type(forward)::view-transition-new(top-story-slide) {
+  animation-name: slide-from-right;
+}
+
+html:active-view-transition-type(backward)::view-transition-old(top-story-slide) {
+  animation-name: slide-to-right;
+}
+html:active-view-transition-type(backward)::view-transition-new(top-story-slide) {
+  animation-name: slide-from-left;
+}
+
+html:active-view-transition-type(forward)::view-transition-group(root),
+html:active-view-transition-type(backward)::view-transition-group(root) {
+  animation: none !important;
+}
+
+/* Disable animation for users who prefer reduced motion */
+@media (prefers-reduced-motion: reduce) {
+  .animate-slide-in-from-right,
+  .animate-slide-out-to-left,
+  .animate-slide-in-from-left,
+  .animate-slide-out-to-right,
+  ::view-transition-group(top-story-slide) {
+    animation: none !important;
+    transform: none !important;
+    transition: none !important;
+  }
 }
