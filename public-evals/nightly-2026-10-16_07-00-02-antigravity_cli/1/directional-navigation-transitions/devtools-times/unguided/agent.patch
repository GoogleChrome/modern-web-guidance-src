@@ -0,0 +1,258 @@
+import React, { useState, useEffect } from 'react';
+
+export interface Story {
+  id: string;
+  title: string;
+  date: string;
+  url: string;
+}
+
+interface TopStoriesSliderProps {
+  stories: Story[];
+}
+
+export default function TopStoriesSlider({ stories }: TopStoriesSliderProps) {
+  if (!stories || stories.length === 0) {
+    return null;
+  }
+
+  const [state, setState] = useState<{
+    current: number;
+    incoming: number | null;
+    direction: 'next' | 'prev' | null;
+    animId: number;
+  }>({
+    current: 0,
+    incoming: null,
+    direction: null,
+    animId: 0,
+  });
+
+  const [prefersReducedMotion, setPrefersReducedMotion] = useState(false);
+
+  useEffect(() => {
+    if (typeof window === 'undefined' || !window.matchMedia) return;
+    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+    setPrefersReducedMotion(mediaQuery.matches);
+
+    const onChange = (e: MediaQueryListEvent) => {
+      setPrefersReducedMotion(e.matches);
+      if (e.matches) {
+        setState((prev) => ({
+          current: prev.incoming !== null ? prev.incoming : prev.current,
+          incoming: null,
+          direction: null,
+          animId: prev.animId,
+        }));
+      }
+    };
+
+    if (mediaQuery.addEventListener) {
+      mediaQuery.addEventListener('change', onChange);
+    } else if (mediaQuery.addListener) {
+      mediaQuery.addListener(onChange);
+    }
+
+    return () => {
+      if (mediaQuery.removeEventListener) {
+        mediaQuery.removeEventListener('change', onChange);
+      } else if (mediaQuery.removeListener) {
+        mediaQuery.removeListener(onChange);
+      }
+    };
+  }, []);
+
+  const isReducedMotionActive = () => {
+    if (prefersReducedMotion) return true;
+    if (typeof window !== 'undefined' && window.matchMedia) {
+      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    }
+    return false;
+  };
+
+  const goToNext = () => {
+    if (stories.length <= 1) return;
+
+    if (isReducedMotionActive()) {
+      setState((prev) => ({
+        current: (prev.incoming !== null ? prev.incoming + 1 : prev.current + 1) % stories.length,
+        incoming: null,
+        direction: null,
+        animId: prev.animId + 1,
+      }));
+      return;
+    }
+
+    setState((prev) => {
+      const fromIndex = prev.incoming !== null ? prev.incoming : prev.current;
+      const toIndex = (fromIndex + 1) % stories.length;
+      return {
+        current: fromIndex,
+        incoming: toIndex,
+        direction: 'next',
+        animId: prev.animId + 1,
+      };
+    });
+  };
+
+  const goToPrev = () => {
+    if (stories.length <= 1) return;
+
+    if (isReducedMotionActive()) {
+      setState((prev) => ({
+        current:
+          (prev.incoming !== null
+            ? prev.incoming - 1 + stories.length
+            : prev.current - 1 + stories.length) % stories.length,
+        incoming: null,
+        direction: null,
+        animId: prev.animId + 1,
+      }));
+      return;
+    }
+
+    setState((prev) => {
+      const fromIndex = prev.incoming !== null ? prev.incoming : prev.current;
+      const toIndex = (fromIndex - 1 + stories.length) % stories.length;
+      return {
+        current: fromIndex,
+        incoming: toIndex,
+        direction: 'prev',
+        animId: prev.animId + 1,
+      };
+    });
+  };
+
+  const handleAnimationEnd = () => {
+    setState((prev) => {
+      if (prev.incoming === null) return prev;
+      return {
+        current: prev.incoming,
+        incoming: null,
+        direction: null,
+        animId: prev.animId,
+      };
+    });
+  };
+
+  useEffect(() => {
+    if (state.incoming !== null) {
+      const timer = setTimeout(() => {
+        handleAnimationEnd();
+      }, 350);
+      return () => clearTimeout(timer);
+    }
+  }, [state.incoming, state.animId]);
+
+  const handleKeyDown = (e: React.KeyboardEvent) => {
+    if (e.key === 'ArrowRight') {
+      goToNext();
+    } else if (e.key === 'ArrowLeft') {
+      goToPrev();
+    }
+  };
+
+  const activeStoryIndex = state.incoming !== null ? state.incoming : state.current;
+
+  const renderStory = (story: Story) => {
+    if (!story) return null;
+    return (
+      <div className="flex flex-col sm:flex-row sm:items-center sm:gap-3 min-w-0">
+        <a href={story.url} className="min-w-0 hover:underline">
+          <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer text-sm sm:text-base truncate">
+            {story.title}
+          </h3>
+        </a>
+        <span className="text-xs text-gray-500 shrink-0">{story.date}</span>
+      </div>
+    );
+  };
+
+  return (
+    <div
+      className="top-stories-slider flex items-center justify-between gap-4"
+      role="region"
+      aria-label="Top Stories"
+      aria-roledescription="carousel"
+      onKeyDown={handleKeyDown}
+    >
+      <div className="flex items-center gap-3 min-w-0 flex-1">
+        <span className="text-xs font-bold uppercase tracking-wider text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded shrink-0">
+          Top Stories
+        </span>
+
+        <div
+          className="relative overflow-hidden min-w-0 flex-1 min-h-[2.5rem] flex items-center"
+          aria-live="polite"
+        >
+          {state.incoming !== null && (
+            <div
+              key={`outgoing-${state.current}-${state.animId}`}
+              aria-hidden="true"
+              className={`absolute inset-0 w-full flex items-center pointer-events-none ${
+                state.direction === 'next' ? 'slide-out-to-left' : 'slide-out-to-right'
+              }`}
+            >
+              {renderStory(stories[state.current])}
+            </div>
+          )}
+
+          <div
+            key={`incoming-${activeStoryIndex}-${state.animId}`}
+            onAnimationEnd={handleAnimationEnd}
+            className={`w-full flex items-center ${
+              state.incoming !== null
+                ? state.direction === 'next'
+                  ? 'slide-in-from-right'
+                  : 'slide-in-from-left'
+                : ''
+            }`}
+          >
+            {renderStory(stories[activeStoryIndex])}
+          </div>
+        </div>
+      </div>
+
+      <div className="flex items-center gap-2 shrink-0">
+        <button
+          type="button"
+          onClick={goToPrev}
+          aria-label="Previous"
+          className="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded transition-colors cursor-pointer select-none"
+        >
+          <svg
+            xmlns="http://www.w3.org/2000/svg"
+            className="h-4 w-4"
+            fill="none"
+            viewBox="0 0 24 24"
+            stroke="currentColor"
+            strokeWidth={2}
+            aria-hidden="true"
+          >
+            <path strokeLinecap="round" strokeLinejoin="round" d="M15 19l-7-7 7-7" />
+          </svg>
+          <span>Previous</span>
+        </button>
+        <button
+          type="button"
+          onClick={goToNext}
+          aria-label="Next"
+          className="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded transition-colors cursor-pointer select-none"
+        >
+          <span>Next</span>
+          <svg
+            xmlns="http://www.w3.org/2000/svg"
+            className="h-4 w-4"
+            fill="none"
+            viewBox="0 0 24 24"
+            stroke="currentColor"
+            strokeWidth={2}
+            aria-hidden="true"
+          >
+            <path strokeLinecap="round" strokeLinejoin="round" d="M9 5l7 7-7 7" />
+          </svg>
+        </button>
+      </div>
+    </div>
+  );
+}
