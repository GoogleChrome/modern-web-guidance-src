+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const items = document.querySelectorAll('.carousel-item');
+      const prevBtn = document.getElementById('prevBtn');
+      const nextBtn = document.getElementById('nextBtn');
+      let currentIndex = 0;
+      let isAnimating = false;
+
+      function showSlide(newIndex, direction) {
+        if (isAnimating || newIndex === currentIndex) return;
+
+        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+        const currentItem = items[currentIndex];
+        const nextItem = items[newIndex];
+
+        if (prefersReducedMotion) {
+          currentItem.classList.remove('active');
+          currentItem.setAttribute('aria-hidden', 'true');
+          nextItem.classList.add('active');
+          nextItem.setAttribute('aria-hidden', 'false');
+          currentIndex = newIndex;
+          return;
+        }
+
+        isAnimating = true;
+
+        const outClass = direction === 'next' ? 'slide-out-left' : 'slide-out-right';
+        const inClass = direction === 'next' ? 'slide-in-right' : 'slide-in-left';
+
+        // Add directional animation classes
+        nextItem.classList.add(inClass);
+        currentItem.classList.add(outClass);
+
+        let finished = false;
+        const onFinish = () => {
+          if (finished) return;
+          finished = true;
+          currentItem.classList.remove('active', outClass);
+          currentItem.setAttribute('aria-hidden', 'true');
+          nextItem.classList.remove(inClass);
+          nextItem.classList.add('active');
+          nextItem.setAttribute('aria-hidden', 'false');
+          currentIndex = newIndex;
+          isAnimating = false;
+        };
+
+        nextItem.addEventListener('animationend', onFinish, { once: true });
+        // Fallback timeout in case animationend does not fire
+        setTimeout(onFinish, 400);
+      }
+
+      prevBtn.addEventListener('click', () => {
+        const newIndex = (currentIndex - 1 + items.length) % items.length;
+        showSlide(newIndex, 'prev');
+      });
+
+      nextBtn.addEventListener('click', () => {
+        const newIndex = (currentIndex + 1) % items.length;
+        showSlide(newIndex, 'next');
+      });
+    });
+  </script>
+
