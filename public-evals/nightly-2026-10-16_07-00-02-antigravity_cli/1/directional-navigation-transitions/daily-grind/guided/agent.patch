+  <script>
+    (function () {
+      const prevBtn = document.getElementById('prev-btn');
+      const nextBtn = document.getElementById('next-btn');
+      const cards = Array.from(document.querySelectorAll('.seasonal-card'));
+      let currentIndex = 0;
+
+      function navigate(direction) {
+        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+        const newIndex = direction === 'next'
+          ? (currentIndex + 1) % cards.length
+          : (currentIndex - 1 + cards.length) % cards.length;
+
+        const updateDOM = () => {
+          cards.forEach((card, index) => {
+            if (index === newIndex) {
+              card.classList.add('active');
+              if (!prefersReducedMotion) {
+                card.classList.remove('slide-from-right', 'slide-from-left');
+                void card.offsetWidth;
+                card.classList.add(direction === 'next' ? 'slide-from-right' : 'slide-from-left');
+              } else {
+                card.classList.remove('slide-from-right', 'slide-from-left');
+              }
+            } else {
+              card.classList.remove('active', 'slide-from-right', 'slide-from-left');
+            }
+          });
+          currentIndex = newIndex;
+        };
+
+        if (prefersReducedMotion || !document.startViewTransition) {
+          updateDOM();
+          return;
+        }
+
+        const transitionType = direction === 'next' ? 'forward' : 'backward';
+        try {
+          document.startViewTransition({
+            update: updateDOM,
+            types: [transitionType, direction]
+          });
+        } catch (err) {
+          try {
+            document.startViewTransition(updateDOM);
+          } catch (e) {
+            updateDOM();
+          }
+        }
+      }
+
+      if (prevBtn && nextBtn) {
+        prevBtn.addEventListener('click', () => navigate('prev'));
+        nextBtn.addEventListener('click', () => navigate('next'));
+      }
+
+      document.addEventListener('keydown', (e) => {
+        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
+        if (e.key === 'ArrowLeft') {
+          navigate('prev');
+        } else if (e.key === 'ArrowRight') {
+          navigate('next');
+        }
+      });
+    })();
+  </script>
