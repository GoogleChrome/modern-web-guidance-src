+      animation: slide-from-right 0.4s ease-in-out both;
+    }
+
+    .seasonal-card.slide-from-left {
+      animation: slide-from-left 0.4s ease-in-out both;
+    }
+
+    /* Suppress element animations when View Transitions is active */
+    html:active-view-transition-type(forward) .seasonal-card,
+    html:active-view-transition-type(backward) .seasonal-card,
+    html:active-view-transition-type(next) .seasonal-card,
+    html:active-view-transition-type(prev) .seasonal-card {
+      animation: none !important;
+    }
+
+    /* Reduced Motion */
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(root),
+      ::view-transition-group(seasonal-item),
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*),
+      .seasonal-card,
+      .seasonal-card.slide-from-right,
+      .seasonal-card.slide-from-left {
+        animation: none !important;
+        transition: none !important;
+      }
+    }
