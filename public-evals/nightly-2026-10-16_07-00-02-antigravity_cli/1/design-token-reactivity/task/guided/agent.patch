+  <script>
+    const toggleSpacious = document.getElementById('toggle-spacious');
+    const targetContainer = document.getElementById('target-container');
+
+    if (toggleSpacious && targetContainer) {
+      toggleSpacious.addEventListener('click', () => {
+        const currentDensity = targetContainer.style.getPropertyValue('--density') ||
+          getComputedStyle(targetContainer).getPropertyValue('--density').trim();
+        const nextDensity = currentDensity === 'spacious' ? 'compact' : 'spacious';
+        targetContainer.style.setProperty('--density', nextDensity);
+        targetContainer.style.setProperty('--layout-density', nextDensity);
+      });
+    }
