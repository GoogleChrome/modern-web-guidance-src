+  <script>
+    (async function initTemporalTracker() {
+      // Conditionally load the Temporal polyfill only if not natively supported
+      if (typeof Temporal === "undefined") {
+        try {
+          const module = await import("https://esm.sh/@js-temporal/polyfill");
+          globalThis.Temporal = module.Temporal;
+        } catch (e) {
+          console.error("Failed to load Temporal polyfill:", e);
+        }
+      }
+
+      // Reactive state management using Temporal PlainDate
+      window.temporalState = {
+        deadline: Temporal.Now.plainDateISO()
+      };
+      let prevState = window.temporalState;
+      let reRenderCount = 0;
+
+      function render() {
+        const valElem = document.getElementById("temporal-value");
+        if (valElem && window.temporalState && window.temporalState.deadline) {
+          valElem.textContent = window.temporalState.deadline.toString();
+        }
+      }
+
+      function updateState(newState) {
+        const refChanged = !!(newState && prevState && newState.deadline !== prevState.deadline);
+        const refElem = document.getElementById("temporal-ref-changed");
+        if (refElem) {
+          refElem.textContent = refChanged ? "Yes" : "No";
+        }
+
+        if (refChanged) {
+          reRenderCount++;
+          const countElem = document.getElementById("temporal-render-count");
+          if (countElem) {
+            countElem.textContent = reRenderCount.toString();
+          }
+          prevState = newState;
+          window.temporalState = newState;
+          render();
+        }
+      }
+
+      function extendDeadline() {
+        // Immutable update using Temporal.add() returns a new instance
+        const newDeadline = window.temporalState.deadline.add({ days: 1 });
+        updateState({ deadline: newDeadline });
+      }
+
+      // Initial render
+      render();
+
+      const extendBtn = document.getElementById("extend-temporal-btn");
+      if (extendBtn) {
+        extendBtn.addEventListener("click", extendDeadline);
+      }
+
+      window.extendDeadline = extendDeadline;
+      window.updateState = updateState;
+    })();
+  </script>
 </body>
 
