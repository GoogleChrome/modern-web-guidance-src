+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      if (!gallery) return;
+
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+
+      let lastSnapChangingTime = 0;
+      let scrollTimeout = null;
+
+      function getItemFromTarget(target) {
+        if (!target) return null;
+        if (items.includes(target)) return target;
+        if (target.closest) {
+          const closest = target.closest('.gallery-item');
+          if (closest && items.includes(closest)) return closest;
+        }
+        return null;
+      }
+
+      function getSnapTarget(event) {
+        if (!event) return null;
+        const target = event.snapTargetInline ||
+                       (event.detail && event.detail.snapTargetInline) ||
+                       event.snapTargetBlock ||
+                       (event.detail && event.detail.snapTargetBlock) ||
+                       (event.target && event.target !== gallery ? event.target : null);
+        return getItemFromTarget(target);
+      }
+
+      function getClosestIndexFromScroll() {
+        const scrollLeft = gallery.scrollLeft;
+        let closestIndex = 0;
+        let minDiff = Infinity;
+        items.forEach((item, index) => {
+          const itemOffset = item.offsetLeft - gallery.offsetLeft;
+          const diff = Math.abs(itemOffset - scrollLeft);
+          if (diff < minDiff) {
+            minDiff = diff;
+            closestIndex = index;
+          }
+        });
+        return closestIndex;
+      }
+
+      function setPending(index) {
+        if (index < 0 || index >= thumbnails.length) return;
+        thumbnails.forEach((thumb, i) => {
+          if (i === index) {
+            thumb.classList.add('pending');
+          } else {
+            thumb.classList.remove('pending');
+          }
+        });
+      }
+
+      function setActive(index) {
+        if (index < 0 || index >= thumbnails.length) return;
+        thumbnails.forEach((thumb, i) => {
+          thumb.classList.remove('pending');
+          if (i === index) {
+            thumb.classList.add('active');
+            thumb.setAttribute('aria-current', 'true');
+          } else {
+            thumb.classList.remove('active');
+            thumb.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      // 1. scrollsnapchanging event (CSS Scroll Snap Events)
+      gallery.addEventListener('scrollsnapchanging', (event) => {
+        lastSnapChangingTime = performance.now();
+        const targetItem = getSnapTarget(event);
+        const index = targetItem ? items.indexOf(targetItem) : getClosestIndexFromScroll();
+        setPending(index);
+      });
+
+      // 2. scrollsnapchange event (CSS Scroll Snap Events)
+      gallery.addEventListener('scrollsnapchange', (event) => {
+        clearTimeout(scrollTimeout);
+        const targetItem = getSnapTarget(event);
+        const index = targetItem ? items.indexOf(targetItem) : getClosestIndexFromScroll();
+        setActive(index);
+      });
+
+      // 3. scrollend event
+      gallery.addEventListener('scrollend', (event) => {
+        clearTimeout(scrollTimeout);
+        const targetItem = getSnapTarget(event);
+        const index = targetItem ? items.indexOf(targetItem) : getClosestIndexFromScroll();
+        setActive(index);
+      });
+
+      // 4. Fallback for manual scroll events
+      gallery.addEventListener('scroll', () => {
+        if (performance.now() - lastSnapChangingTime < 500) {
+          return;
+        }
+        const pendingIndex = getClosestIndexFromScroll();
+        setPending(pendingIndex);
+
+        clearTimeout(scrollTimeout);
+        scrollTimeout = setTimeout(() => {
+          const finalIndex = getClosestIndexFromScroll();
+          setActive(finalIndex);
+        }, 150);
+      }, { passive: true });
+
+      // Thumbnail click navigation
+      thumbnails.forEach((thumb, index) => {
+        thumb.addEventListener('click', () => {
+          if (items[index]) {
+            items[index].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
+          }
+        });
+      });
+    })();
+  </script>
