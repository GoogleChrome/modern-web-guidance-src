+  <script>
+    const customBeans = [
+      {
+        name: "Guatemala Antigua",
+        roast: "Medium Roast",
+        notes: "Sweet apple, cocoa, and subtle warm spices.",
+        origin: "Antigua Valley, Guatemala",
+        price: "$19.50",
+        image: "https://images.unsplash.com/photo-1610632380989-680fe40816c6?auto=format&fit=crop&w=600&q=80"
+      },
+      {
+        name: "Kenya AA Nyeri",
+        roast: "Medium-Light Roast",
+        notes: "Blackcurrant, ruby grapefruit, and honey finish.",
+        origin: "Nyeri Hill, Kenya",
+        price: "$21.00",
+        image: "https://images.unsplash.com/photo-1518832553480-cd0e625ed3e6?auto=format&fit=crop&w=600&q=80"
+      },
+      {
+        name: "Costa Rica Tarrazú",
+        roast: "Light-Medium Roast",
+        notes: "Brown sugar, vanilla blossom, and crisp citrus acidity.",
+        origin: "Tarrazú Highlands, Costa Rica",
+        price: "$18.50",
+        image: "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80"
+      },
+      {
+        name: "Rwandan Bourbon",
+        roast: "Medium Roast",
+        notes: "Red currant, white floral, and rich cane sugar sweetness.",
+        origin: "Lake Kivu, Rwanda",
+        price: "$20.00",
+        image: "https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80"
+      },
+      {
+        name: "Panama Geisha Reserve",
+        roast: "Light Roast",
+        notes: "Bergamot, jasmine blossoms, papaya, and silky body.",
+        origin: "Boquete, Panama",
+        price: "$26.00",
+        image: "https://images.unsplash.com/photo-1587734195503-904fca47e0e9?auto=format&fit=crop&w=600&q=80"
+      }
+    ];
+
+    let itemCount = 3;
+    let customBeanIndex = 0;
+
+    function executeTransition(updateCallback) {
+      const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      if (!document.startViewTransition || prefersReducedMotion) {
+        updateCallback();
+        return;
+      }
+      return document.startViewTransition(updateCallback);
+    }
+
+    function addItem() {
+      itemCount++;
+      const bean = customBeans[customBeanIndex % customBeans.length];
+      customBeanIndex++;
+
+      const id = `item-${itemCount}`;
+      const li = document.createElement('li');
+      li.className = 'item';
+      li.id = id;
+      li.style.viewTransitionName = id;
+      li.innerHTML = `
+        <div class="item-content">
+          <img src="${bean.image}" alt="${bean.name}" class="item-image" />
+          <div class="item-info">
+            <h3>${bean.name} <span class="item-badge">${bean.roast}</span></h3>
+            <p class="item-notes">${bean.notes}</p>
+            <p class="item-origin">${bean.origin} &bull; <strong>${bean.price}</strong></p>
+          </div>
+        </div>
+        <button class="btn remove-btn" aria-label="Remove ${bean.name}">Remove</button>
+      `;
+
+      executeTransition(() => {
+        const list = document.getElementById('bean-list');
+        if (list) {
+          list.appendChild(li);
+        }
+      });
+    }
+
+    function removeItem(itemElement) {
+      executeTransition(() => {
+        itemElement.remove();
+      });
+    }
+
+    document.addEventListener('DOMContentLoaded', () => {
+      const addBtn = document.getElementById('add-item-btn');
+      if (addBtn) {
+        addBtn.addEventListener('click', addItem);
+      }
+
+      const beanList = document.getElementById('bean-list');
+      if (beanList) {
+        beanList.addEventListener('click', (e) => {
+          const removeBtn = e.target.closest('.remove-btn');
+          if (removeBtn) {
+            const item = removeBtn.closest('.item');
+            if (item) {
+              removeItem(item);
+            }
+          }
+        });
+      }
+    });
+
+    window.addItem = addItem;
+    window.removeItem = removeItem;
+    window.executeTransition = executeTransition;
+  </script>
 </body>
 
