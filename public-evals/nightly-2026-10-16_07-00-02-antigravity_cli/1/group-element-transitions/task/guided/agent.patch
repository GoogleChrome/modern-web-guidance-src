+  <script>
+    (function () {
+      let itemIdCounter = 3;
+
+      const customBeanCatalog = [
+        { name: 'Guatemalan Antigua', desc: 'Medium roast with hints of cocoa, subtle spice, and a rich finish.' },
+        { name: 'Kenyan AA', desc: 'Bright, bold roast with blackcurrant sweetness and crisp wine-like acidity.' },
+        { name: 'Costa Rican Tarrazú', desc: 'Vibrant honey sweetness accompanied by crisp apple and citrus notes.' },
+        { name: 'Panama Geisha', desc: 'Exquisite light roast with jasmine floral fragrance and bergamot finish.' },
+        { name: 'Rwandan Bourbon', desc: 'Silky caramel body layered with sweet mandarin orange and red fruit.' },
+        { name: 'Tanzanian Peaberry', desc: 'Medium-bodied roast offering lemon brightness and sweet cedar aromatics.' }
+      ];
+
+      let catalogIndex = 0;
+
+      function updateWithTransition(callback) {
+        if (document.startViewTransition) {
+          const transition = document.startViewTransition(callback);
+          if (transition && transition.ready) {
+            transition.ready.catch(() => {});
+          }
+        } else {
+          callback();
+        }
+      }
+
+      function createItemElement(id, name, desc) {
+        const li = document.createElement('li');
+        li.className = 'item';
+        li.style.viewTransitionName = `item-${id}`;
+
+        const details = document.createElement('div');
+        details.className = 'item-details';
+
+        const title = document.createElement('h4');
+        title.textContent = name;
+
+        const description = document.createElement('p');
+        description.textContent = desc;
+
+        details.appendChild(title);
+        details.appendChild(description);
+
+        const removeButton = document.createElement('button');
+        removeButton.className = 'btn-remove';
+        removeButton.type = 'button';
+        removeButton.textContent = 'Remove';
+        removeButton.setAttribute('aria-label', `Remove ${name}`);
+
+        removeButton.addEventListener('click', () => {
+          removeItem(li);
+        });
+
+        li.appendChild(details);
+        li.appendChild(removeButton);
+
+        return li;
+      }
+
+      function addItem() {
+        const bean = customBeanCatalog[catalogIndex % customBeanCatalog.length];
+        catalogIndex++;
+        itemIdCounter++;
+        const newItem = createItemElement(itemIdCounter, bean.name, bean.desc);
+
+        updateWithTransition(() => {
+          const list = document.getElementById('bean-list');
+          list.appendChild(newItem);
+        });
+      }
+
+      function removeItem(itemElement) {
+        updateWithTransition(() => {
+          itemElement.remove();
+        });
+      }
+
+      // Attach listener to Add Item button
+      const addBtn = document.getElementById('add-item-btn');
+      if (addBtn) {
+        addBtn.addEventListener('click', addItem);
+      }
+
+      // Attach listeners to initial items' remove buttons
+      document.querySelectorAll('#bean-list .item').forEach((item) => {
+        const removeBtn = item.querySelector('.btn-remove');
+        if (removeBtn) {
+          removeBtn.addEventListener('click', () => {
+            removeItem(item);
+          });
+        }
+      });
+    })();
+  </script>
 </body>
 
