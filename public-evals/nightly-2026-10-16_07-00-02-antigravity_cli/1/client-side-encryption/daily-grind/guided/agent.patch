+test('Authenticated Encryption: AAD tampering rejects decryption with OperationError', async () => {
+  const recipient = await generateRecipientKeys('X25519', true);
+  const envelope = await sealEnvelope({
+    recipientPublicKey: recipient.publicKeyBytes,
+    plaintext: 'Top secret barista blend ingredients',
+    additionalData: 'order_id:12345',
+  });
+
+  // Tamper with the additionalData (AAD)
+  const tamperedEnvelope = {
+    ...envelope,
+    additionalData: 'order_id:99999', // Altered metadata!
+  };
+
+  await assert.rejects(
+    async () => {
+      await openEnvelope({
+        recipientPrivateKey: recipient.keyPair.privateKey,
+        envelope: tamperedEnvelope,
+      });
+    },
+    (err) => {
+      // Must reject due to AEAD tag verification failure
+      return err.name === 'OperationError' || err.message.includes('Operation');
+    },
+  );
+});
+
+test('Authenticated Encryption: Ciphertext tampering rejects decryption with OperationError', async () => {
+  const recipient = await generateRecipientKeys('X25519', true);
+  const envelope = await sealEnvelope({
+    recipientPublicKey: recipient.publicKeyBytes,
+    plaintext: 'Secure payment card token: tok_coffee_card_9921',
+    additionalData: 'vault_account:883',
+  });
+
+  // Tamper with 1 byte of the ciphertext
+  const rawCiphertext = base64ToBytes(envelope.ciphertext);
+  rawCiphertext[0] ^= 0x01; // flip 1 bit
+  const tamperedEnvelope = {
+    ...envelope,
+    ciphertext: bytesToBase64(rawCiphertext),
+  };
+
+  await assert.rejects(
+    async () => {
+      await openEnvelope({
+        recipientPrivateKey: recipient.keyPair.privateKey,
+        envelope: tamperedEnvelope,
+      });
+    },
+    (err) => {
+      return err.name === 'OperationError' || err.message.includes('Operation');
+    },
+  );
+});
