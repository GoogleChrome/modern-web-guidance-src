+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  supportsPostQuantumEnvelope,
+  probeSubtleSupports,
+  getCryptoCapabilities,
+  getRecommendedSuite,
+  generateRecipientKeys,
+  encapsulateEnvelopeKey,
+  decapsulateEnvelopeKey,
+  encryptMessage,
+  decryptMessage,
+  sealEnvelope,
+  openEnvelope,
+  bytesToBase64,
+  base64ToBytes,
+  bytesToHex,
+  hexToBytes,
+  KEM_PUBLIC_KEY_ALGORITHMS,
+} from '../crypto-envelope.js';
+
+test('SubtleCrypto static probe and capabilities detection', () => {
+  const caps = getCryptoCapabilities();
+  assert.equal(typeof caps.hasStaticSupports, 'boolean');
+  assert.equal(typeof caps.hybridMlKem, 'boolean');
+  assert.equal(typeof caps.mlKem768, 'boolean');
+  assert.equal(typeof caps.x25519, 'boolean');
+  assert.equal(typeof caps.chacha20Poly1305, 'boolean');
+  assert.equal(typeof caps.aesGcm, 'boolean');
+
+  // Verify calling SubtleCrypto.supports on constructor, not on crypto.subtle
+  assert.equal(typeof crypto.subtle.supports, 'undefined');
+  if (typeof globalThis.SubtleCrypto?.supports === 'function') {
+    const isAesGcmSupported = SubtleCrypto.supports('encrypt', {
+      name: 'AES-GCM',
+      iv: new Uint8Array(12),
+    });
+    assert.equal(isAesGcmSupported, true);
+  }
+});
