@@ -0,0 +1,434 @@
+/**
+ * Crypto Envelope Module
+ * 
+ * Establishes shared secrets using public-key encapsulation (MLKEM768-X25519, ML-KEM-768, ML-KEM-1024)
+ * or classical key agreement (X25519 + HKDF), and encrypts sensitive data with authenticated
+ * encryption (ChaCha20-Poly1305 or AES-GCM).
+ */
+
+export const KEM_PUBLIC_KEY_ALGORITHMS = {
+  1184: 'ML-KEM-768',
+  1216: 'MLKEM768-X25519',
+  1568: 'ML-KEM-1024',
+};
+
+/**
+ * Checks if the runtime supports the hybrid post-quantum envelope suite (MLKEM768-X25519 + ChaCha20-Poly1305).
+ * Uses static SubtleCrypto.supports() on the SubtleCrypto constructor, never on crypto.subtle.
+ * @returns {boolean}
+ */
+export function supportsPostQuantumEnvelope() {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('encapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305')
+  );
+}
+
+/**
+ * Probes static SubtleCrypto.supports for algorithm support.
+ * @param {string} op Operation name ('encapsulateKey', 'generateKey', 'encrypt', etc.)
+ * @param {...any} args Operation arguments
+ * @returns {boolean}
+ */
+export function probeSubtleSupports(op, ...args) {
+  if (typeof globalThis.SubtleCrypto?.supports !== 'function') {
+    return false;
+  }
+  try {
+    return SubtleCrypto.supports(op, ...args);
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Inspects all supported cryptographic capabilities in the current environment.
+ * @returns {object}
+ */
+export function getCryptoCapabilities() {
+  const hasStaticSupports = typeof globalThis.SubtleCrypto?.supports === 'function';
+
+  return {
+    hasStaticSupports,
+    hybridMlKem: probeSubtleSupports('encapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305'),
+    mlKem768: probeSubtleSupports('encapsulateKey', 'ML-KEM-768', 'ChaCha20-Poly1305') ||
+              probeSubtleSupports('generateKey', 'ML-KEM-768'),
+    mlKem1024: probeSubtleSupports('encapsulateKey', 'ML-KEM-1024', 'ChaCha20-Poly1305') ||
+               probeSubtleSupports('generateKey', 'ML-KEM-1024'),
+    x25519: probeSubtleSupports('generateKey', 'X25519') ||
+            probeSubtleSupports('deriveBits', 'X25519'),
+    chacha20Poly1305: probeSubtleSupports('encrypt', { name: 'ChaCha20-Poly1305', iv: new Uint8Array(12) }),
+    aesGcm: probeSubtleSupports('encrypt', { name: 'AES-GCM', iv: new Uint8Array(12) }),
+  };
+}
+
+/**
+ * Returns the recommended KEM or key agreement suite for this environment.
+ * @returns {'MLKEM768-X25519' | 'ML-KEM-768' | 'ML-KEM-1024' | 'X25519'}
+ */
+export function getRecommendedSuite() {
+  if (supportsPostQuantumEnvelope()) {
+    return 'MLKEM768-X25519';
+  }
+  if (probeSubtleSupports('encapsulateKey', 'ML-KEM-768', 'ChaCha20-Poly1305') ||
+      probeSubtleSupports('generateKey', 'ML-KEM-768')) {
+    return 'ML-KEM-768';
+  }
+  return 'X25519';
+}
+
+/**
+ * Generates recipient keys for public-key encapsulation or key agreement.
+ * Uses extractable: false by default for secure storage in IndexedDB.
+ * 
+ * @param {string} [suite] 'MLKEM768-X25519' | 'ML-KEM-768' | 'ML-KEM-1024' | 'X25519'
+ * @param {boolean} [extractable=false] Whether private key is extractable
+ * @returns {Promise<{suite: string, kemAlgorithm: string, keyPair: CryptoKeyPair, publicKeyBytes: Uint8Array}>}
+ */
+export async function generateRecipientKeys(suite = null, extractable = false) {
+  const chosenSuite = suite || getRecommendedSuite();
+
+  if (chosenSuite === 'MLKEM768-X25519' || chosenSuite === 'ML-KEM-768' || chosenSuite === 'ML-KEM-1024') {
+    try {
+      const keyPair = await crypto.subtle.generateKey(
+        chosenSuite,
+        extractable,
+        ['encapsulateKey', 'decapsulateKey'],
+      );
+      // Modern WebCrypto rejects legacy 'raw' on KEMs; must use 'raw-public'
+      const publicKeyBytes = new Uint8Array(
+        await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+      );
+      const suiteName = chosenSuite === 'MLKEM768-X25519'
+        ? 'MLKEM768-X25519+ChaCha20-Poly1305'
+        : `${chosenSuite}+ChaCha20-Poly1305`;
+      return { suite: suiteName, kemAlgorithm: chosenSuite, keyPair, publicKeyBytes };
+    } catch (err) {
+      // If requested suite is not supported by runtime, gracefully fall back
+      if (chosenSuite === 'MLKEM768-X25519') {
+        try {
+          return await generateRecipientKeys('ML-KEM-768', extractable);
+        } catch {
+          return await generateRecipientKeys('X25519', extractable);
+        }
+      }
+      return await generateRecipientKeys('X25519', extractable);
+    }
+  }
+
+  // Classical fallback: X25519 key agreement + HKDF + AES-GCM
+  const keyPair = await crypto.subtle.generateKey('X25519', extractable, ['deriveBits']);
+  // Use 'raw' format in classical fallback paths
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw', keyPair.publicKey),
+  );
+  return { suite: 'X25519+HKDF+AES-GCM', kemAlgorithm: 'X25519', keyPair, publicKeyBytes };
+}
+
+/**
+ * Derives an AES-GCM key from X25519 shared secret using HKDF.
+ * Used for classical fallback ephemeral-static Diffie-Hellman key agreement.
+ */
+async function deriveFallbackAesKey(privateKey, peerPublicKey, infoBytes = new Uint8Array(0)) {
+  const sharedSecret = await crypto.subtle.deriveBits(
+    { name: 'X25519', public: peerPublicKey },
+    privateKey,
+    256,
+  );
+  const hkdfKey = await crypto.subtle.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey(
+    {
+      name: 'HKDF',
+      hash: 'SHA-256',
+      salt: new Uint8Array(32),
+      info: infoBytes,
+    },
+    hkdfKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt'],
+  );
+}
+
+/**
+ * Encapsulates a shared secret key using the recipient's public key.
+ * Supports quantum-resistant KEMs (MLKEM768-X25519, ML-KEM-768, ML-KEM-1024)
+ * and falls back to ephemeral-static X25519 key agreement.
+ * 
+ * @param {CryptoKey | Uint8Array} recipientPublicKeyOrBytes
+ * @param {Uint8Array} [infoBytes]
+ * @param {'ChaCha20-Poly1305' | 'AES-GCM'} [preferredCipher='ChaCha20-Poly1305']
+ * @returns {Promise<{sharedKey: CryptoKey, capsuleBytes: Uint8Array, algorithm: string, cipherName: string}>}
+ */
+export async function encapsulateEnvelopeKey(
+  recipientPublicKeyOrBytes,
+  infoBytes = new Uint8Array(0),
+  preferredCipher = 'ChaCha20-Poly1305',
+) {
+  const pubKey =
+    recipientPublicKeyOrBytes instanceof CryptoKey
+      ? recipientPublicKeyOrBytes
+      : await (() => {
+          const bytes =
+            recipientPublicKeyOrBytes instanceof Uint8Array
+              ? recipientPublicKeyOrBytes
+              : new Uint8Array(recipientPublicKeyOrBytes);
+          const kemName = KEM_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+          return kemName
+            ? crypto.subtle.importKey('raw-public', bytes, kemName, true, ['encapsulateKey'])
+            : crypto.subtle.importKey('raw', bytes, 'X25519', true, []);
+        })();
+
+  if (pubKey.algorithm.name !== 'X25519') {
+    let cipherName = preferredCipher;
+    if (
+      cipherName === 'ChaCha20-Poly1305' &&
+      typeof globalThis.SubtleCrypto?.supports === 'function' &&
+      !SubtleCrypto.supports('encrypt', { name: 'ChaCha20-Poly1305', iv: new Uint8Array(12) })
+    ) {
+      cipherName = 'AES-GCM';
+    }
+
+    const sharedKeyAlgorithm = cipherName === 'AES-GCM'
+      ? { name: 'AES-GCM', length: 256 }
+      : 'ChaCha20-Poly1305';
+
+    const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+      pubKey.algorithm.name,
+      pubKey,
+      sharedKeyAlgorithm,
+      false,
+      ['encrypt', 'decrypt'],
+    );
+    return { sharedKey, capsuleBytes: new Uint8Array(ciphertext), algorithm: pubKey.algorithm.name, cipherName };
+  }
+
+  // Classical fallback: generate ephemeral X25519 key pair and send ephemeral public key as capsule
+  const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  const capsuleBytes = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+  const sharedKey = await deriveFallbackAesKey(ephemeral.privateKey, pubKey, infoBytes);
+  return { sharedKey, capsuleBytes, algorithm: 'X25519', cipherName: 'AES-GCM' };
+}
+
+/**
+ * Decapsulates a shared secret key from a capsule using the recipient's private key.
+ * 
+ * @param {CryptoKey} recipientPrivateKey
+ * @param {Uint8Array} capsuleBytes
+ * @param {Uint8Array} [infoBytes]
+ * @param {'ChaCha20-Poly1305' | 'AES-GCM'} [preferredCipher='ChaCha20-Poly1305']
+ * @returns {Promise<CryptoKey>}
+ */
+export async function decapsulateEnvelopeKey(
+  recipientPrivateKey,
+  capsuleBytes,
+  infoBytes = new Uint8Array(0),
+  preferredCipher = 'ChaCha20-Poly1305',
+) {
+  if (recipientPrivateKey.algorithm.name !== 'X25519') {
+    let cipherName = preferredCipher;
+    if (
+      cipherName === 'ChaCha20-Poly1305' &&
+      typeof globalThis.SubtleCrypto?.supports === 'function' &&
+      !SubtleCrypto.supports('decrypt', { name: 'ChaCha20-Poly1305', iv: new Uint8Array(12) })
+    ) {
+      cipherName = 'AES-GCM';
+    }
+
+    const sharedKeyAlgorithm = cipherName === 'AES-GCM'
+      ? { name: 'AES-GCM', length: 256 }
+      : 'ChaCha20-Poly1305';
+
+    return crypto.subtle.decapsulateKey(
+      recipientPrivateKey.algorithm.name,
+      recipientPrivateKey,
+      capsuleBytes,
+      sharedKeyAlgorithm,
+      false,
+      ['encrypt', 'decrypt'],
+    );
+  }
+
+  const ephemeralPubKey = await crypto.subtle.importKey('raw', capsuleBytes, 'X25519', true, []);
+  return deriveFallbackAesKey(recipientPrivateKey, ephemeralPubKey, infoBytes);
+}
+
+/**
+ * Encrypts UTF-8 text with an AEAD CryptoKey ('ChaCha20-Poly1305' or 'AES-GCM').
+ * Binds unencrypted metadata via additionalData (AAD).
+ * 
+ * @param {CryptoKey} key
+ * @param {string | Uint8Array} plaintext
+ * @param {Uint8Array} [additionalData]
+ * @returns {Promise<{iv: Uint8Array, ciphertext: Uint8Array}>}
+ */
+export async function encryptMessage(key, plaintext, additionalData = new Uint8Array(0)) {
+  // Always generate a fresh 12-byte (96-bit) IV per message
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const encoded = typeof plaintext === 'string'
+    ? new TextEncoder().encode(plaintext)
+    : plaintext;
+
+  const ciphertextBuffer = await crypto.subtle.encrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    encoded,
+  );
+
+  return { iv, ciphertext: new Uint8Array(ciphertextBuffer) };
+}
+
+/**
+ * Decrypts and authenticates an AEAD payload. Throws OperationError if tampered.
+ * 
+ * @param {CryptoKey} key
+ * @param {Uint8Array} iv
+ * @param {Uint8Array} ciphertext
+ * @param {Uint8Array} [additionalData]
+ * @returns {Promise<string>}
+ */
+export async function decryptMessage(key, iv, ciphertext, additionalData = new Uint8Array(0)) {
+  const plaintextBuffer = await crypto.subtle.decrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    ciphertext,
+  );
+
+  return new TextDecoder().decode(plaintextBuffer);
+}
+
+/**
+ * Seals a sensitive plaintext payload into an encrypted envelope:
+ * 1. Encapsulates a one-time shared secret key against recipient's public key
+ * 2. Generates a fresh 12-byte IV
+ * 3. Encrypts and authenticates data + AAD
+ * 
+ * @param {object} params
+ * @param {CryptoKey | Uint8Array} params.recipientPublicKey
+ * @param {string} params.plaintext
+ * @param {string | Uint8Array} [params.additionalData]
+ * @param {string} [params.info='envelope-v1']
+ * @param {'ChaCha20-Poly1305' | 'AES-GCM'} [params.preferredCipher='ChaCha20-Poly1305']
+ * @returns {Promise<object>} JSON-serializable envelope
+ */
+export async function sealEnvelope({
+  recipientPublicKey,
+  plaintext,
+  additionalData = '',
+  info = 'envelope-v1',
+  preferredCipher = 'ChaCha20-Poly1305',
+}) {
+  const infoBytes = new TextEncoder().encode(info);
+  const aadBytes = typeof additionalData === 'string'
+    ? new TextEncoder().encode(additionalData)
+    : additionalData;
+
+  const { sharedKey, capsuleBytes, algorithm, cipherName } = await encapsulateEnvelopeKey(
+    recipientPublicKey,
+    infoBytes,
+    preferredCipher,
+  );
+
+  const { iv, ciphertext } = await encryptMessage(sharedKey, plaintext, aadBytes);
+
+  return {
+    version: '1.0',
+    algorithm,
+    cipher: cipherName,
+    info,
+    capsule: bytesToBase64(capsuleBytes),
+    iv: bytesToBase64(iv),
+    ciphertext: bytesToBase64(ciphertext),
+    additionalData: typeof additionalData === 'string' ? additionalData : bytesToBase64(additionalData),
+  };
+}
+
+/**
+ * Opens an encrypted envelope using the recipient's private key:
+ * 1. Decapsulates the shared secret key from the capsule
+ * 2. Authenticates and decrypts ciphertext with IV and AAD
+ * 
+ * @param {object} params
+ * @param {CryptoKey} params.recipientPrivateKey
+ * @param {object} params.envelope
+ * @param {string} [params.info]
+ * @returns {Promise<string>} Decrypted plaintext
+ */
+export async function openEnvelope({
+  recipientPrivateKey,
+  envelope,
+  info = null,
+}) {
+  const envelopeInfo = info || envelope.info || 'envelope-v1';
+  const infoBytes = new TextEncoder().encode(envelopeInfo);
+  const capsuleBytes = base64ToBytes(envelope.capsule);
+  const iv = base64ToBytes(envelope.iv);
+  const ciphertext = base64ToBytes(envelope.ciphertext);
+  const aadBytes = typeof envelope.additionalData === 'string'
+    ? new TextEncoder().encode(envelope.additionalData)
+    : base64ToBytes(envelope.additionalData);
+
+  const cipher = envelope.cipher || 'ChaCha20-Poly1305';
+  const sharedKey = await decapsulateEnvelopeKey(
+    recipientPrivateKey,
+    capsuleBytes,
+    infoBytes,
+    cipher,
+  );
+
+  return decryptMessage(sharedKey, iv, ciphertext, aadBytes);
+}
+
+// ---------------- Serialization Helpers ----------------
+
+export function bytesToBase64(bytes) {
+  if (typeof bytes.toBase64 === 'function') {
+    return bytes.toBase64();
+  }
+  if (typeof Buffer !== 'undefined') {
+    return Buffer.from(bytes).toString('base64');
+  }
+  let binary = '';
+  const len = bytes.byteLength;
+  for (let i = 0; i < len; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary);
+}
+
+export function base64ToBytes(base64) {
+  if (typeof Uint8Array.fromBase64 === 'function') {
+    return Uint8Array.fromBase64(base64);
+  }
+  if (typeof Buffer !== 'undefined') {
+    return new Uint8Array(Buffer.from(base64, 'base64'));
+  }
+  const binary = atob(base64);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+export function bytesToHex(bytes) {
+  return Array.from(bytes)
+    .map(b => b.toString(16).padStart(2, '0'))
+    .join('');
+}
+
+export function hexToBytes(hex) {
+  const bytes = new Uint8Array(hex.length / 2);
+  for (let i = 0; i < hex.length; i += 2) {
+    bytes[i / 2] = parseInt(hex.substring(i, i + 2), 16);
+  }
+  return bytes;
+}
diff --git a/crypto-storage.js b/crypto-storage.js
new file mode 100644
index 0000000..3d2f268
--- /dev/null
+++ b/crypto-storage.js
@@ -0,0 +1,115 @@
+/**
+ * Crypto Storage Module
+ * 
+ * Persists non-extractable CryptoKey and CryptoKeyPair objects across sessions
+ * in browser IndexedDB via structured cloning, avoiding exposure of private key bytes.
+ */
+
+const DB_NAME = 'DailyGrindVaultDB';
+const DB_VERSION = 1;
+const STORE_NAME = 'keypairs';
+
+/**
+ * Opens the IndexedDB instance.
+ * @returns {Promise<IDBDatabase | null>}
+ */
+export async function openVaultDB() {
+  if (typeof indexedDB === 'undefined') {
+    return null;
+  }
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open(DB_NAME, DB_VERSION);
+    request.onupgradeneeded = (event) => {
+      const db = event.target.result;
+      if (!db.objectStoreNames.contains(STORE_NAME)) {
+        db.createObjectStore(STORE_NAME, { keyPath: 'id' });
+      }
+    };
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+/**
+ * Stores a CryptoKeyPair and associated metadata in IndexedDB.
+ * Supports structured cloning of non-extractable CryptoKey / CryptoKeyPair.
+ * 
+ * @param {string} id Unique identifier (e.g. 'recipient-kem-key')
+ * @param {CryptoKeyPair} keyPair
+ * @param {object} metadata Additional metadata (suite, algorithm, createdAt, publicKeyBase64)
+ */
+export async function storeKeyPair(id, keyPair, metadata = {}) {
+  const db = await openVaultDB();
+  if (!db) {
+    // In environments without IndexedDB (e.g. unit tests or Node), return null
+    return null;
+  }
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(STORE_NAME, 'readwrite');
+    const store = tx.objectStore(STORE_NAME);
+    const record = {
+      id,
+      keyPair,
+      metadata: {
+        ...metadata,
+        updatedAt: new Date().toISOString(),
+      },
+    };
+    const req = store.put(record);
+    req.onsuccess = () => resolve(true);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+/**
+ * Retrieves a stored CryptoKeyPair and its metadata from IndexedDB.
+ * 
+ * @param {string} id
+ * @returns {Promise<{id: string, keyPair: CryptoKeyPair, metadata: object} | null>}
+ */
+export async function getKeyPair(id) {
+  const db = await openVaultDB();
+  if (!db) return null;
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(STORE_NAME, 'readonly');
+    const store = tx.objectStore(STORE_NAME);
+    const req = store.get(id);
+    req.onsuccess = () => resolve(req.result || null);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+/**
+ * Deletes a stored keypair by ID.
+ * @param {string} id
+ */
+export async function removeKeyPair(id) {
+  const db = await openVaultDB();
+  if (!db) return false;
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(STORE_NAME, 'readwrite');
+    const store = tx.objectStore(STORE_NAME);
+    const req = store.delete(id);
+    req.onsuccess = () => resolve(true);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+/**
+ * Lists all stored key records (metadata only).
+ * @returns {Promise<Array<{id: string, metadata: object}>>}
+ */
+export async function listStoredKeys() {
+  const db = await openVaultDB();
+  if (!db) return [];
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(STORE_NAME, 'readonly');
+    const store = tx.objectStore(STORE_NAME);
+    const req = store.getAll();
+    req.onsuccess = () => {
+      const records = req.result || [];
+      resolve(records.map(r => ({ id: r.id, metadata: r.metadata })));
+    };
+    req.onerror = () => reject(req.error);
+  });
+}
