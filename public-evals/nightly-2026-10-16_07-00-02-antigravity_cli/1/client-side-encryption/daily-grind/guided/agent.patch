+test('Post-Quantum KEM (ML-KEM-768) encapsulation and AEAD encryption with ChaCha20-Poly1305', async () => {
+  // If current environment supports ML-KEM-768
+  const caps = getCryptoCapabilities();
+  if (!caps.mlKem768) {
+    return;
+  }
+
+  // 1. Recipient generates keypair
+  const recipient = await generateRecipientKeys('ML-KEM-768', true);
+  assert.equal(recipient.kemAlgorithm, 'ML-KEM-768');
+  assert.equal(recipient.publicKeyBytes.byteLength, 1184);
+
+  // 2. Sender encapsulates a shared AEAD key
+  const senderEnc = await encapsulateEnvelopeKey(recipient.publicKeyBytes, new Uint8Array(0), 'ChaCha20-Poly1305');
+  assert.equal(senderEnc.algorithm, 'ML-KEM-768');
+  assert.equal(senderEnc.capsuleBytes.byteLength, 1088);
+  assert.equal(senderEnc.cipherName, 'ChaCha20-Poly1305');
+
+  // 3. Sender encrypts sensitive coffee recipe data with AAD metadata
+  const sensitivePlaintext = 'Confidential Roast Recipe: Single-Origin Ethiopian Natural, 415F, 12:30m drum';
+  const metadataAAD = new TextEncoder().encode('Order:ROAST-8819');
+  const { iv, ciphertext } = await encryptMessage(senderEnc.sharedKey, sensitivePlaintext, metadataAAD);
+  assert.equal(iv.byteLength, 12);
+  assert.ok(ciphertext.byteLength > sensitivePlaintext.length);
+
+  // 4. Recipient decapsulates the shared AEAD key
+  const recipientKey = await decapsulateEnvelopeKey(
+    recipient.keyPair.privateKey,
+    senderEnc.capsuleBytes,
+    new Uint8Array(0),
+    'ChaCha20-Poly1305',
+  );
+
+  // 5. Recipient decrypts and verifies payload
+  const decrypted = await decryptMessage(recipientKey, iv, ciphertext, metadataAAD);
+  assert.equal(decrypted, sensitivePlaintext);
+});
