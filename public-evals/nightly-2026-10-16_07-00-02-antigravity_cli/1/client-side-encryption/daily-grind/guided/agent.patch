@@ -0,0 +1,408 @@
+import {
+  supportsPostQuantumEnvelope,
+  probeSubtleSupports,
+  getCryptoCapabilities,
+  getRecommendedSuite,
+  generateRecipientKeys,
+  encapsulateEnvelopeKey,
+  decapsulateEnvelopeKey,
+  encryptMessage,
+  decryptMessage,
+  sealEnvelope,
+  openEnvelope,
+  bytesToBase64,
+  base64ToBytes,
+  bytesToHex,
+  KEM_PUBLIC_KEY_ALGORITHMS,
+} from './crypto-envelope.js';
+
+import {
+  storeKeyPair,
+  getKeyPair,
+  removeKeyPair,
+  listStoredKeys,
+} from './crypto-storage.js';
+
+// Application state
+let currentRecipientKeys = null;
+let currentEnvelope = null;
+
+// Initialize on DOM load
+document.addEventListener('DOMContentLoaded', async () => {
+  renderCapabilities();
+  setupEventListeners();
+  await loadSavedKeyIfAvailable();
+});
+
+function renderCapabilities() {
+  const caps = getCryptoCapabilities();
+  const capsContainer = document.getElementById('crypto-caps-container');
+  if (!capsContainer) return;
+
+  const recommended = getRecommendedSuite();
+
+  capsContainer.innerHTML = `
+    <div class="cap-card ${caps.hybridMlKem ? 'supported' : 'unsupported'}">
+      <span class="cap-title">Hybrid Post-Quantum</span>
+      <span class="cap-badge">${caps.hybridMlKem ? 'Supported' : 'Unavailable'}</span>
+      <small>MLKEM768-X25519</small>
+    </div>
+    <div class="cap-card ${caps.mlKem768 ? 'supported' : 'unsupported'}">
+      <span class="cap-title">Post-Quantum KEM</span>
+      <span class="cap-badge">${caps.mlKem768 ? 'Supported' : 'Unavailable'}</span>
+      <small>ML-KEM-768 (FIPS 203)</small>
+    </div>
+    <div class="cap-card ${caps.x25519 ? 'supported' : 'unsupported'}">
+      <span class="cap-title">Classical Key Agreement</span>
+      <span class="cap-badge">${caps.x25519 ? 'Supported' : 'Unavailable'}</span>
+      <small>X25519 + HKDF</small>
+    </div>
+    <div class="cap-card ${caps.chacha20Poly1305 ? 'supported' : 'unsupported'}">
+      <span class="cap-title">AEAD Cipher</span>
+      <span class="cap-badge">${caps.chacha20Poly1305 ? 'Supported' : 'Unavailable'}</span>
+      <small>ChaCha20-Poly1305</small>
+    </div>
+    <div class="cap-card ${caps.aesGcm ? 'supported' : 'unsupported'}">
+      <span class="cap-title">AEAD Cipher</span>
+      <span class="cap-badge">${caps.aesGcm ? 'Supported' : 'Unavailable'}</span>
+      <small>AES-GCM (256-bit)</small>
+    </div>
+  `;
+
+  const activeBadge = document.getElementById('active-suite-badge');
+  if (activeBadge) {
+    activeBadge.textContent = `Recommended Suite: ${recommended}`;
+  }
+
+  // Pre-select recommended suite in select dropdown
+  const suiteSelect = document.getElementById('suite-select');
+  if (suiteSelect) {
+    if (caps.hybridMlKem) {
+      suiteSelect.value = 'MLKEM768-X25519';
+    } else if (caps.mlKem768) {
+      suiteSelect.value = 'ML-KEM-768';
+    } else {
+      suiteSelect.value = 'X25519';
+    }
+  }
+}
+
+async function loadSavedKeyIfAvailable() {
+  const saved = await getKeyPair('recipient-primary-vault-key');
+  if (saved && saved.keyPair) {
+    currentRecipientKeys = {
+      suite: saved.metadata.suite,
+      kemAlgorithm: saved.metadata.kemAlgorithm,
+      keyPair: saved.keyPair,
+      publicKeyBytes: base64ToBytes(saved.metadata.publicKeyBase64),
+    };
+    displayRecipientKey(currentRecipientKeys, true);
+    logStatus('Loaded persisted non-extractable key pair from IndexedDB.');
+  }
+}
+
+function setupEventListeners() {
+  // Generate Recipient Keys
+  document.getElementById('btn-generate-keys')?.addEventListener('click', async () => {
+    try {
+      logStatus('Generating recipient key pair...');
+      const suite = document.getElementById('suite-select').value;
+      const persist = document.getElementById('chk-persist-idb').checked;
+
+      // Non-extractable key pair for maximum security
+      const result = await generateRecipientKeys(suite, false);
+      currentRecipientKeys = result;
+
+      if (persist) {
+        await storeKeyPair('recipient-primary-vault-key', result.keyPair, {
+          suite: result.suite,
+          kemAlgorithm: result.kemAlgorithm,
+          publicKeyBase64: bytesToBase64(result.publicKeyBytes),
+        });
+        logStatus('Key pair generated and securely stored in IndexedDB (non-extractable).');
+      } else {
+        logStatus('Key pair generated in-memory.');
+      }
+
+      displayRecipientKey(result, persist);
+    } catch (err) {
+      logStatus(`Error generating keys: ${err.message}`, true);
+    }
+  });
+
+  // Clear Stored Keys
+  document.getElementById('btn-clear-idb')?.addEventListener('click', async () => {
+    await removeKeyPair('recipient-primary-vault-key');
+    currentRecipientKeys = null;
+    clearRecipientKeyDisplay();
+    logStatus('Stored keys cleared from IndexedDB.');
+  });
+
+  // Copy Public Key
+  document.getElementById('btn-copy-pubkey')?.addEventListener('click', () => {
+    const pubKeyText = document.getElementById('pubkey-b64-display').textContent;
+    if (pubKeyText && pubKeyText !== 'None generated') {
+      navigator.clipboard?.writeText(pubKeyText);
+      alert('Public key copied to clipboard!');
+    }
+  });
+
+  // Fill sample orders
+  document.querySelectorAll('.btn-template-order').forEach(btn => {
+    btn.addEventListener('click', (e) => {
+      const type = e.target.dataset.template;
+      const plaintextEl = document.getElementById('plaintext-input');
+      const aadEl = document.getElementById('aad-input');
+      if (type === 'recipe') {
+        plaintextEl.value = 'Confidential Blend Recipe #42: 60% Ethiopian Yirgacheffe, 40% Colombian Geisha; Light Roast, Drum Temp 418°F, 11m 45s.';
+        aadEl.value = 'roaster-internal:batch-42:confidential';
+      } else if (type === 'order') {
+        plaintextEl.value = 'VIP Order #DG-9921: 2x Maple Oat Latte, 1x Cold Brew. Secure Door Code: #7821. Gate delivery behind coffee hedge.';
+        aadEl.value = 'order-id:DG-9921:cust_micah';
+      } else if (type === 'payment') {
+        plaintextEl.value = 'Coffee Club Card Vault Token: card_token_coffee_exp2028_cvv_verified_0991';
+        aadEl.value = 'account:daily-grind-club:member-4029';
+      }
+    });
+  });
+
+  // Sender: Seal Envelope
+  document.getElementById('btn-seal-envelope')?.addEventListener('click', async () => {
+    try {
+      if (!currentRecipientKeys) {
+        alert('Please generate or load a recipient key pair first!');
+        return;
+      }
+      logStatus('Encapsulating shared secret & encrypting with AEAD...');
+
+      const plaintext = document.getElementById('plaintext-input').value.trim();
+      if (!plaintext) {
+        alert('Please enter sensitive data to encrypt!');
+        return;
+      }
+
+      const aad = document.getElementById('aad-input').value.trim();
+      const preferredCipher = document.getElementById('cipher-select').value;
+
+      const envelope = await sealEnvelope({
+        recipientPublicKey: currentRecipientKeys.publicKeyBytes,
+        plaintext,
+        additionalData: aad,
+        info: 'daily-grind-vault-v1',
+        preferredCipher,
+      });
+
+      currentEnvelope = envelope;
+      displayEnvelope(envelope);
+      logStatus('Shared secret established and sensitive data encrypted successfully!');
+    } catch (err) {
+      logStatus(`Encryption error: ${err.message}`, true);
+    }
+  });
+
+  // Recipient: Open Envelope
+  document.getElementById('btn-open-envelope')?.addEventListener('click', async () => {
+    try {
+      if (!currentRecipientKeys) {
+        alert('No recipient private key available!');
+        return;
+      }
+      if (!currentEnvelope) {
+        alert('No encrypted envelope to decrypt!');
+        return;
+      }
+      logStatus('Decapsulating shared secret & authenticating AEAD payload...');
+
+      const decrypted = await openEnvelope({
+        recipientPrivateKey: currentRecipientKeys.keyPair.privateKey,
+        envelope: currentEnvelope,
+      });
+
+      const decResultEl = document.getElementById('decrypted-result');
+      decResultEl.textContent = decrypted;
+      document.getElementById('decryption-success-banner').style.display = 'block';
+      document.getElementById('decryption-error-banner').style.display = 'none';
+      logStatus('Decryption & authenticity verification SUCCEEDED.');
+    } catch (err) {
+      document.getElementById('decryption-success-banner').style.display = 'none';
+      const errBanner = document.getElementById('decryption-error-banner');
+      errBanner.style.display = 'block';
+      errBanner.textContent = `Decryption Rejected: ${err.name} - ${err.message}. Cryptographic authentication verification failed!`;
+      logStatus(`Decryption rejected: ${err.name} - ${err.message}`, true);
+    }
+  });
+
+  // Tamper Ciphertext Test
+  document.getElementById('btn-tamper-ciphertext')?.addEventListener('click', async () => {
+    if (!currentEnvelope) {
+      alert('Seal an envelope first!');
+      return;
+    }
+    logStatus('Simulating malicious ciphertext alteration (flipping 1 byte)...');
+    const rawCiphertext = base64ToBytes(currentEnvelope.ciphertext);
+    rawCiphertext[0] ^= 0x01; // flip 1 bit
+    const tampered = {
+      ...currentEnvelope,
+      ciphertext: bytesToBase64(rawCiphertext),
+    };
+
+    try {
+      await openEnvelope({
+        recipientPrivateKey: currentRecipientKeys.keyPair.privateKey,
+        envelope: tampered,
+      });
+      alert('ERROR: Tampered ciphertext was accepted! (This should not happen)');
+    } catch (err) {
+      document.getElementById('decryption-success-banner').style.display = 'none';
+      const errBanner = document.getElementById('decryption-error-banner');
+      errBanner.style.display = 'block';
+      errBanner.textContent = `Tamper Intercepted! AEAD authentication tag failed: ${err.name} (${err.message}). Data was rejected.`;
+      logStatus(`Tamper successfully intercepted: ${err.name} (${err.message}).`);
+    }
+  });
+
+  // Tamper AAD Test
+  document.getElementById('btn-tamper-aad')?.addEventListener('click', async () => {
+    if (!currentEnvelope) {
+      alert('Seal an envelope first!');
+      return;
+    }
+    logStatus('Simulating altered Associated Data (metadata injection)...');
+    const tampered = {
+      ...currentEnvelope,
+      additionalData: currentEnvelope.additionalData + '_TAMPERED_INJECTION',
+    };
+
+    try {
+      await openEnvelope({
+        recipientPrivateKey: currentRecipientKeys.keyPair.privateKey,
+        envelope: tampered,
+      });
+      alert('ERROR: Tampered metadata was accepted! (This should not happen)');
+    } catch (err) {
+      document.getElementById('decryption-success-banner').style.display = 'none';
+      const errBanner = document.getElementById('decryption-error-banner');
+      errBanner.style.display = 'block';
+      errBanner.textContent = `Metadata Tamper Intercepted! AEAD Associated Data verification failed: ${err.name} (${err.message}).`;
+      logStatus(`Metadata tamper successfully intercepted: ${err.name} (${err.message}).`);
+    }
+  });
+
+  // In-Browser Test Suite Runner
+  document.getElementById('btn-run-tests')?.addEventListener('click', runInBrowserTests);
+}
+
+function displayRecipientKey(keys, persisted) {
+  document.getElementById('pubkey-status').innerHTML = `
+    <strong>Suite:</strong> ${keys.suite} | 
+    <strong>Storage:</strong> ${persisted ? 'IndexedDB (Non-extractable)' : 'In-Memory'} | 
+    <strong>Key Size:</strong> ${keys.publicKeyBytes.byteLength} bytes
+  `;
+  document.getElementById('pubkey-b64-display').textContent = bytesToBase64(keys.publicKeyBytes);
+  document.getElementById('pubkey-hex-display').textContent = bytesToHex(keys.publicKeyBytes);
+}
+
+function clearRecipientKeyDisplay() {
+  document.getElementById('pubkey-status').textContent = 'No key pair loaded.';
+  document.getElementById('pubkey-b64-display').textContent = 'None generated';
+  document.getElementById('pubkey-hex-display').textContent = 'None generated';
+}
+
+function displayEnvelope(env) {
+  document.getElementById('envelope-container').style.display = 'block';
+  document.getElementById('env-meta').textContent = `Suite: ${env.algorithm} + ${env.cipher} | Info Context: "${env.info}"`;
+  document.getElementById('env-capsule').textContent = env.capsule;
+  document.getElementById('env-iv').textContent = env.iv;
+  document.getElementById('env-ciphertext').textContent = env.ciphertext;
+  document.getElementById('env-aad').textContent = env.additionalData;
+  document.getElementById('env-json').textContent = JSON.stringify(env, null, 2);
+}
+
+function logStatus(msg, isError = false) {
+  const consoleEl = document.getElementById('status-console');
+  if (!consoleEl) return;
+  const time = new Date().toLocaleTimeString();
+  const entry = document.createElement('div');
+  entry.className = `log-line ${isError ? 'log-err' : 'log-ok'}`;
+  entry.textContent = `[${time}] ${msg}`;
+  consoleEl.prepend(entry);
+}
+
+async function runInBrowserTests() {
+  const testOutput = document.getElementById('test-output');
+  testOutput.innerHTML = '<div class="test-line">Starting Cryptographic Self-Test Suite...</div>';
+  
+  const addLine = (title, pass, detail = '') => {
+    const el = document.createElement('div');
+    el.className = `test-line ${pass ? 'test-pass' : 'test-fail'}`;
+    el.textContent = `${pass ? '✔ PASS' : '✘ FAIL'}: ${title} ${detail ? `(${detail})` : ''}`;
+    testOutput.appendChild(el);
+  };
+
+  try {
+    // Test 1: SubtleCrypto Static supports
+    const hasStatic = typeof globalThis.SubtleCrypto?.supports === 'function';
+    addLine('SubtleCrypto.supports static method detection', true, hasStatic ? 'Available' : 'Fallback mode');
+
+    // Test 2: Generate Keypair
+    const recip = await generateRecipientKeys(null, true);
+    addLine(`Recipient key generation (${recip.kemAlgorithm})`, !!recip.publicKeyBytes, `${recip.publicKeyBytes.byteLength} bytes`);
+
+    // Test 3: Encapsulation
+    const enc = await encapsulateEnvelopeKey(recip.publicKeyBytes);
+    addLine('Shared secret encapsulation', !!enc.sharedKey && !!enc.capsuleBytes, `Capsule: ${enc.capsuleBytes.byteLength} bytes`);
+
+    // Test 4: AEAD Encryption
+    const plaintext = 'In-Browser Test Payload - Secret Artisanal Recipe';
+    const aad = new TextEncoder().encode('test-order-aad');
+    const { iv, ciphertext } = await encryptMessage(enc.sharedKey, plaintext, aad);
+    addLine('AEAD Message Encryption', iv.byteLength === 12 && ciphertext.byteLength > 0, `IV: 12 bytes, Ciphertext: ${ciphertext.byteLength} bytes`);
+
+    // Test 5: Decapsulation & Decryption
+    const decKey = await decapsulateEnvelopeKey(recip.keyPair.privateKey, enc.capsuleBytes);
+    const decrypted = await decryptMessage(decKey, iv, ciphertext, aad);
+    addLine('Decapsulation & AEAD Decryption', decrypted === plaintext, 'Plaintext verified perfectly');
+
+    // Test 6: Tamper resistance (AAD)
+    let aadTamperCaught = false;
+    try {
+      const tamperedAad = new TextEncoder().encode('test-order-aad-TAMPERED');
+      await decryptMessage(decKey, iv, ciphertext, tamperedAad);
+    } catch {
+      aadTamperCaught = true;
+    }
+    addLine('Associated Data (AAD) tamper rejection', aadTamperCaught, 'OperationError triggered as expected');
+
+    // Test 7: Tamper resistance (Ciphertext)
+    let ctTamperCaught = false;
+    try {
+      const tamperedCt = new Uint8Array(ciphertext);
+      tamperedCt[0] ^= 0x01;
+      await decryptMessage(decKey, iv, tamperedCt, aad);
+    } catch {
+      ctTamperCaught = true;
+    }
+    addLine('Ciphertext tamper rejection', ctTamperCaught, 'OperationError triggered as expected');
+
+    // Test 8: IndexedDB Key Persistence
+    let idbPassed = false;
+    try {
+      await storeKeyPair('test-self-test-key', recip.keyPair, { test: true });
+      const loaded = await getKeyPair('test-self-test-key');
+      if (loaded && loaded.keyPair) {
+        idbPassed = true;
+      }
+      await removeKeyPair('test-self-test-key');
+    } catch {
+      idbPassed = false;
+    }
+    addLine('IndexedDB non-extractable key persistence', idbPassed, 'Structured cloning verified');
+
+    const summary = document.createElement('div');
+    summary.className = 'test-summary';
+    summary.textContent = 'All in-browser self-tests completed successfully!';
+    testOutput.appendChild(summary);
+  } catch (err) {
+    addLine('Test Suite Exception', false, err.message);
+  }
+}
