+test('Classical fallback (X25519 + HKDF + AES-GCM) key agreement and AEAD', async () => {
+  // 1. Recipient generates classical X25519 keypair
+  const recipient = await generateRecipientKeys('X25519', true);
+  assert.equal(recipient.kemAlgorithm, 'X25519');
+  assert.equal(recipient.publicKeyBytes.byteLength, 32);
+
+  // 2. Sender establishes shared key via ephemeral-static agreement
+  const contextInfo = new TextEncoder().encode('daily-grind-envelope-v1');
+  const senderEnc = await encapsulateEnvelopeKey(recipient.publicKeyBytes, contextInfo);
+  assert.equal(senderEnc.algorithm, 'X25519');
+  assert.equal(senderEnc.capsuleBytes.byteLength, 32); // Ephemeral public key
+  assert.equal(senderEnc.cipherName, 'AES-GCM');
+
+  // 3. Encrypt sensitive order data
+  const secretData = 'Customer VIP Gate Code: #9128, delivery behind counter';
+  const aad = new TextEncoder().encode('customer:alice:order-44');
+  const { iv, ciphertext } = await encryptMessage(senderEnc.sharedKey, secretData, aad);
+  assert.equal(iv.byteLength, 12);
+
+  // 4. Recipient decapsulates shared key
+  const recipientKey = await decapsulateEnvelopeKey(
+    recipient.keyPair.privateKey,
+    senderEnc.capsuleBytes,
+    contextInfo,
+  );
+
+  // 5. Decrypt
+  const decrypted = await decryptMessage(recipientKey, iv, ciphertext, aad);
+  assert.equal(decrypted, secretData);
+});
