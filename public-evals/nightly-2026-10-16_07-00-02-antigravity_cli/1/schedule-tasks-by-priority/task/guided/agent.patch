+
+    <script>
+      (function () {
+        // Configuration & Priority definitions
+        const PRIORITIES = {
+          URGENT: {
+            key: 'user-blocking',
+            label: 'user-blocking',
+            weight: 1,
+            tagClass: 'tag-urgent',
+            badgeClass: 'badge-urgent',
+            logClass: 'log-urgent'
+          },
+          STANDARD: {
+            key: 'user-visible',
+            label: 'user-visible',
+            weight: 2,
+            tagClass: 'tag-standard',
+            badgeClass: 'badge-standard',
+            logClass: 'log-standard'
+          },
+          BACKGROUND: {
+            key: 'background',
+            label: 'background',
+            weight: 3,
+            tagClass: 'tag-background',
+            badgeClass: 'badge-background',
+            logClass: 'log-background'
+          }
+        };
+
+        // State
+        let orderIdSeq = 101;
+        let isQueueRunning = false;
+        let activeTask = null;
+        const pendingQueue = [];
+        const completedTasks = [];
+        let clickCount = 0;
+
+        // DOM references
+        const uiThreadStatus = document.getElementById('ui-thread-status');
+        const clickCounter = document.getElementById('click-counter');
+        const btnTest = document.getElementById('btn-test-responsiveness');
+        const queueStats = document.getElementById('queue-stats');
+        const idleMessage = document.getElementById('idle-message');
+        const activeTaskContent = document.getElementById('active-task-content');
+        const activeTaskBadge = document.getElementById('active-task-badge');
+        const activeTaskTitle = document.getElementById('active-task-title');
+        const activeTaskPct = document.getElementById('active-task-pct');
+        const activeTaskProgressFill = document.getElementById('active-task-progress-fill');
+        const activeTaskStep = document.getElementById('active-task-step');
+        const activeTaskYields = document.getElementById('active-task-yields');
+        const pendingQueueList = document.getElementById('pending-queue-list');
+        const emptyQueueNote = document.getElementById('empty-queue-note');
+        const logStream = document.getElementById('log-stream');
+        const apiStatus = document.getElementById('api-status');
+
+        // Detect Scheduler API
+        const hasPostTask = typeof window.scheduler !== 'undefined' && typeof window.scheduler.postTask === 'function';
+        const hasYield = typeof window.scheduler !== 'undefined' && typeof window.scheduler.yield === 'function';
+        if (hasPostTask && hasYield) {
+          apiStatus.textContent = 'Native Scheduler API (postTask + yield)';
+        } else if (hasPostTask) {
+          apiStatus.textContent = 'Scheduler.postTask + Fallback Yield';
+        } else {
+          apiStatus.textContent = 'Prioritized Scheduler (Fallback Mode)';
+        }
+
+        // Format current timestamp
+        function getTimestamp() {
+          const now = new Date();
+          const hh = String(now.getHours()).padStart(2, '0');
+          const mm = String(now.getMinutes()).padStart(2, '0');
+          const ss = String(now.getSeconds()).padStart(2, '0');
+          const ms = String(now.getMilliseconds()).padStart(3, '0');
+          return `${hh}:${mm}:${ss}.${ms}`;
+        }
+
+        // Append log entry
+        function logMessage(text, type = 'system') {
+          const line = document.createElement('div');
+          line.className = `log-line log-${type}`;
+          line.innerHTML = `<span class="timestamp">[${getTimestamp()}]</span> ${text}`;
+          logStream.appendChild(line);
+          logStream.scrollTop = logStream.scrollHeight;
+        }
+
+        // Responsive test button
+        btnTest.addEventListener('click', () => {
+          clickCount++;
+          clickCounter.textContent = `${clickCount} click${clickCount === 1 ? '' : 's'}`;
+          btnTest.classList.add('flash-success');
+          setTimeout(() => btnTest.classList.remove('flash-success'), 120);
+        });
+
+        // Synchronous CPU work simulation
+        function burnCpu(ms) {
+          const end = performance.now() + ms;
+          let x = 0;
+          while (performance.now() < end) {
+            x += Math.sqrt(x + 1.234) * 0.99;
+          }
+          return x;
+        }
+
+        // Yield back to main thread periodically
+        async function yieldControl() {
+          if ('scheduler' in window && typeof window.scheduler.yield === 'function') {
+            await window.scheduler.yield();
+          } else {
+            await new Promise(resolve => setTimeout(resolve, 0));
+          }
+        }
+
+        // Post task with priority
+        async function postPrioritizedTask(taskFn, priorityKey) {
+          if ('scheduler' in window && typeof window.scheduler.postTask === 'function') {
+            return window.scheduler.postTask(taskFn, { priority: priorityKey });
+          } else {
+            return new Promise((resolve, reject) => {
+              setTimeout(async () => {
+                try {
+                  const res = await taskFn();
+                  resolve(res);
+                } catch (e) {
+                  reject(e);
+                }
+              }, 0);
+            });
+          }
+        }
+
+        // Task execution with 50ms budget deadline
+        async function runTaskWork(task) {
+          let deadline = performance.now() + 50; // 50ms long task threshold
+          const totalSteps = task.steps.length;
+
+          for (let i = 0; i < totalSteps; i++) {
+            // Perform synchronous chunk of computation
+            burnCpu(16);
+
+            task.currentStepIndex = i;
+            task.progress = Math.round(((i + 1) / totalSteps) * 100);
+            renderActiveTaskUI(task);
+
+            // Cooperative yield when 50ms deadline exceeded
+            if (performance.now() >= deadline) {
+              task.yields++;
+              renderActiveTaskUI(task);
+              logMessage(`Task "${task.name}" yielded main thread at ${task.progress}% (yield #${task.yields})`, 'yield');
+              await yieldControl();
+              deadline = performance.now() + 50;
+            }
+          }
+        }
+
+        // Render Active Task
+        function renderActiveTaskUI(task) {
+          if (!task) {
+            idleMessage.style.display = 'block';
+            activeTaskContent.style.display = 'none';
+            return;
+          }
+
+          idleMessage.style.display = 'none';
+          activeTaskContent.style.display = 'block';
+
+          activeTaskBadge.className = `badge ${task.priority.badgeClass}`;
+          activeTaskBadge.textContent = task.priority.label;
+          activeTaskTitle.textContent = task.name;
+          activeTaskPct.textContent = `${task.progress}%`;
+          activeTaskProgressFill.style.width = `${task.progress}%`;
+          activeTaskStep.textContent = task.steps[task.currentStepIndex] || 'Finishing...';
+          activeTaskYields.textContent = `Yields: ${task.yields}`;
+        }
+
+        // Render Pending Queue & Stats
+        function updateQueueUI() {
+          queueStats.textContent = `${pendingQueue.length} pending | ${completedTasks.length} completed`;
+
+          if (pendingQueue.length === 0) {
+            emptyQueueNote.style.display = 'block';
+            pendingQueueList.innerHTML = '';
+            pendingQueueList.appendChild(emptyQueueNote);
+            return;
+          }
+
+          emptyQueueNote.style.display = 'none';
+          pendingQueueList.innerHTML = '';
+
+          pendingQueue.forEach((task, idx) => {
+            const item = document.createElement('div');
+            item.className = 'queue-item';
+            item.innerHTML = `
+              <div class="queue-item-info">
+                <span class="queue-item-pos">#${idx + 1}</span>
+                <span class="badge ${task.priority.badgeClass}">${task.priority.label}</span>
+                <span class="queue-item-name" title="${task.name}">${task.name}</span>
+              </div>
+              <span style="font-size: 0.75rem; color: #8d6e63;">Priority Rank ${task.priority.weight}</span>
+            `;
+            pendingQueueList.appendChild(item);
+          });
+        }
+
+        // Enqueue task and maintain priority order
+        function enqueueTask(task, silent = false) {
+          pendingQueue.push(task);
+
+          // Sort pending tasks:
+          // Primary: priority weight (1 = user-blocking, 2 = user-visible, 3 = background)
+          // Secondary: arrival time (FIFO within same priority)
+          pendingQueue.sort((a, b) => {
+            if (a.priority.weight !== b.priority.weight) {
+              return a.priority.weight - b.priority.weight;
+            }
+            return a.createdAt - b.createdAt;
+          });
+
+          if (!silent) {
+            logMessage(`Enqueued [${task.priority.label.toUpperCase()}] "${task.name}"`, task.priority.logClass);
+          }
+
+          updateQueueUI();
+          processQueue();
+        }
+
+        // Process Queue Loop
+        async function processQueue() {
+          if (isQueueRunning || pendingQueue.length === 0) return;
+          isQueueRunning = true;
+
+          while (pendingQueue.length > 0) {
+            // Highest priority pending task is always at index 0
+            activeTask = pendingQueue.shift();
+            updateQueueUI();
+            renderActiveTaskUI(activeTask);
+
+            logMessage(`Started [${activeTask.priority.label.toUpperCase()}] "${activeTask.name}"`, activeTask.priority.logClass);
+            const startTime = performance.now();
+
+            // Dispatch with Scheduler API postTask
+            await postPrioritizedTask(async () => {
+              await runTaskWork(activeTask);
+            }, activeTask.priority.key);
+
+            const durationMs = Math.round(performance.now() - startTime);
+            logMessage(`Completed "${activeTask.name}" in ${durationMs}ms with ${activeTask.yields} cooperative yields`, 'completed');
+
+            completedTasks.push(activeTask);
+            activeTask = null;
+            renderActiveTaskUI(null);
+            updateQueueUI();
+          }
+
+          isQueueRunning = false;
+          renderActiveTaskUI(null);
+          updateQueueUI();
+        }
+
+        // Task factory helpers
+        function createUrgentCheckoutTask(customId) {
+          const id = customId || orderIdSeq++;
+          return {
+            id: `checkout-${id}`,
+            name: `Urgent Checkout #ORD-${id}`,
+            priority: PRIORITIES.URGENT,
+            createdAt: performance.now(),
+            progress: 0,
+            currentStepIndex: 0,
+            yields: 0,
+            steps: [
+              'Verifying customer payment token',
+              'Applying discount vouchers & taxes',
+              'Authorizing credit card gateway',
+              'Reserving fresh espresso beans in stock',
+              'Allocating espresso machine queue slot',
+              'Generating encrypted order hash',
+              'Broadcasting pickup beacon to barista POS',
+              'Finalizing invoice & dispatching push receipt'
+            ]
+          };
+        }
+
+        function createMenuUpdateTask(name) {
+          const titles = [
+            'Seasonal Maple Spice Price Indexing',
+            'Single-Origin Roast Catalog Refresh',
+            'Allergen & Nutrition Tag Re-render',
+            'Barista Specials Stock Sync'
+          ];
+          const title = name || titles[Math.floor(Math.random() * titles.length)];
+          return {
+            id: `menu-${Date.now()}-${Math.random()}`,
+            name: `Menu Catalog: ${title}`,
+            priority: PRIORITIES.STANDARD,
+            createdAt: performance.now(),
+            progress: 0,
+            currentStepIndex: 0,
+            yields: 0,
+            steps: [
+              'Fetching remote menu manifest',
+              'Parsing milk alternative matrix',
+              'Calculating dynamic rush-hour surcharges',
+              'Generating thumbnail image lookup map',
+              'Invalidating client cache buckets',
+              'Synchronizing digital counter displays',
+              'Verifying nutritional disclosure tags',
+              'Committing menu revision to database'
+            ]
+          };
+        }
+
+        function createTelemetryLogTask(name) {
+          const titles = [
+            'Espresso Grouphead Temp Sensors',
+            'Grinder RPM & Vibration Telemetry',
+            'Store Wi-Fi Foot-Traffic Aggregation',
+            'Cold Brew Tank Pressure Telemetry'
+          ];
+          const title = name || titles[Math.floor(Math.random() * titles.length)];
+          return {
+            id: `telemetry-${Date.now()}-${Math.random()}`,
+            name: `Telemetry Flush: ${title}`,
+            priority: PRIORITIES.BACKGROUND,
+            createdAt: performance.now(),
+            progress: 0,
+            currentStepIndex: 0,
+            yields: 0,
+            steps: [
+              'Collecting sensor time-series packets',
+              'Running statistical outlier detection',
+              'Compressing diagnostic payload buffer',
+              'Encrypting telemetry transport channel',
+              'Buffering telemetry records locally',
+              'Sending telemetry payload to analytics pipeline',
+              'Logging heartbeat latency benchmarks',
+              'Cleaning temporary diagnostic dump files'
+            ]
+          };
+        }
+
+        // Event Listeners for Buttons
+        document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+          enqueueTask(createUrgentCheckoutTask());
+        });
+
+        document.getElementById('btn-menu-update').addEventListener('click', () => {
+          enqueueTask(createMenuUpdateTask());
+        });
+
+        document.getElementById('btn-telemetry-log').addEventListener('click', () => {
+          enqueueTask(createTelemetryLogTask());
+        });
+
+        document.getElementById('btn-mixed-batch').addEventListener('click', () => {
+          logMessage('Enqueuing mixed batch of 6 tasks in scrambled order...', 'system');
+          
+          // Mixed tasks created in non-priority order
+          const batchTasks = [
+            createTelemetryLogTask('POS Network Diagnostics'),
+            createMenuUpdateTask('Cold Brew Restock'),
+            createUrgentCheckoutTask(orderIdSeq++),
+            createTelemetryLogTask('Grinder Burr Wear Sensor'),
+            createUrgentCheckoutTask(orderIdSeq++),
+            createMenuUpdateTask('Pastry Shelf Inventory')
+          ];
+
+          // Enqueue each task into the priority queue
+          batchTasks.forEach(task => enqueueTask(task, true));
+
+          logMessage(
+            '🔀 Batch queued! Task prioritization sorted execution order: 2 Urgent Checkouts (user-blocking) -> 2 Menu Updates (user-visible) -> 2 Telemetry Logs (background).',
+            'system'
+          );
+        });
+
+        document.getElementById('btn-clear-history').addEventListener('click', () => {
+          completedTasks.length = 0;
+          updateQueueUI();
+          logStream.innerHTML = '';
+          logMessage('Completed tasks and logs cleared.', 'system');
+        });
+
+        // Frame rate / responsiveness monitor loop
+        let lastFrameTime = performance.now();
+        function checkFrameHealth() {
+          const now = performance.now();
+          const delta = now - lastFrameTime;
+          lastFrameTime = now;
+
+          if (delta > 100) {
+            uiThreadStatus.textContent = 'Yielding to Events...';
+            uiThreadStatus.style.color = '#e65100';
+          } else {
+            uiThreadStatus.textContent = 'Fluid & Responsive';
+            uiThreadStatus.style.color = '#2e7d32';
+          }
+          requestAnimationFrame(checkFrameHealth);
+        }
+        requestAnimationFrame(checkFrameHealth);
+
+      })();
+    </script>
