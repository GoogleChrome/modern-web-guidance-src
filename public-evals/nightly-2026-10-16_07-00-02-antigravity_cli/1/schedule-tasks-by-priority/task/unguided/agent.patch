+  <!-- Operations Queue Simulator JavaScript Engine -->
+  <script>
+    (function () {
+      // Priority Levels: 1 (Urgent/Highest) -> 2 (Standard/Medium) -> 3 (Background/Lowest)
+      const PRIORITY = {
+        URGENT: 1,
+        STANDARD: 2,
+        BACKGROUND: 3
+      };
+
+      let taskCounter = 0;
+      const pendingQueue = [];
+      const historyList = [];
+      let isWorkerBusy = false;
+      let userClickCount = 0;
+
+      // Sample data generators
+      const taskCatalog = {
+        urgent: [
+          { name: "Checkout #1042: Apple Pay Authorization", steps: 10, chunkDuration: 50 },
+          { name: "Checkout #1043: Mobile Espresso Order", steps: 12, chunkDuration: 45 },
+          { name: "Checkout #1044: Instant Gift Card Redemption", steps: 8, chunkDuration: 55 },
+          { name: "Checkout #1045: Table 6 Point-of-Sale Finalize", steps: 11, chunkDuration: 50 }
+        ],
+        standard: [
+          { name: "Menu Update: Sync Maple Syrup Pricing", steps: 16, chunkDuration: 55 },
+          { name: "Menu Update: Refresh Seasonal Cold Brew Stock", steps: 14, chunkDuration: 60 },
+          { name: "Menu Update: Recompute Oat Milk Inventory", steps: 18, chunkDuration: 50 },
+          { name: "Menu Update: Publish Weekend Pastry Special", steps: 15, chunkDuration: 55 }
+        ],
+        telemetry: [
+          { name: "Telemetry: Compress App Performance Traces", steps: 22, chunkDuration: 65 },
+          { name: "Telemetry: Flush Client Latency Diagnostics", steps: 25, chunkDuration: 60 },
+          { name: "Telemetry: Sync Anonymous Store Foot-Traffic Logs", steps: 28, chunkDuration: 55 },
+          { name: "Telemetry: Upload Error Boundary Crash Reports", steps: 20, chunkDuration: 70 }
+        ]
+      };
+
+      // DOM Elements
+      const queueListEl = document.getElementById('queue-list');
+      const historyListEl = document.getElementById('history-list');
+      const queueTotalCountEl = document.getElementById('queue-total-count');
+      const historyTotalCountEl = document.getElementById('history-total-count');
+      const countUrgentPillEl = document.getElementById('count-urgent-pill');
+      const countStandardPillEl = document.getElementById('count-standard-pill');
+      const countTelemetryPillEl = document.getElementById('count-telemetry-pill');
+
+      const activeTaskStateEl = document.getElementById('active-task-state');
+      const activeSpinnerEl = document.getElementById('active-spinner');
+      const activeTaskTitleEl = document.getElementById('active-task-title');
+      const activeTaskBadgeEl = document.getElementById('active-task-badge');
+      const activeTaskPercentageEl = document.getElementById('active-task-percentage');
+      const progressBarInnerEl = document.getElementById('progress-bar-inner');
+      const activeStepInfoEl = document.getElementById('active-step-info');
+      const activeTimeInfoEl = document.getElementById('active-time-info');
+
+      const liveTickDisplayEl = document.getElementById('live-tick-display');
+      const clickCounterDisplayEl = document.getElementById('click-counter-display');
+      const btnTestResponsiveness = document.getElementById('btn-test-responsiveness');
+
+      // Live 60 FPS Event Loop Heartbeat Monitor
+      let lastTimestamp = performance.now();
+      let frameCount = 0;
+      let lastFpsUpdate = performance.now();
+
+      function updateHeartbeat() {
+        const now = performance.now();
+        frameCount++;
+        if (now - lastFpsUpdate >= 500) {
+          const fps = Math.round((frameCount * 1000) / (now - lastFpsUpdate));
+          liveTickDisplayEl.textContent = `Loop Active (${fps} FPS | ${Math.round(now % 10000)}ms)`;
+          frameCount = 0;
+          lastFpsUpdate = now;
+        }
+        requestAnimationFrame(updateHeartbeat);
+      }
+      requestAnimationFrame(updateHeartbeat);
+
+      // Interactive Click Responsiveness Test
+      btnTestResponsiveness.addEventListener('click', () => {
+        userClickCount++;
+        clickCounterDisplayEl.textContent = `Instant Clicks: ${userClickCount}`;
+        btnTestResponsiveness.style.transform = 'scale(0.96)';
+        setTimeout(() => { btnTestResponsiveness.style.transform = 'scale(1)'; }, 80);
+      });
+
+      // Priority Queue Insertion:
+      // Insert tasks such that Priority 1 (Urgent) comes first, then Priority 2 (Standard), then Priority 3 (Background).
+      // Tasks with identical priority maintain FIFO arrival order.
+      function enqueueTask(task) {
+        let insertIndex = pendingQueue.length;
+        for (let i = 0; i < pendingQueue.length; i++) {
+          if (task.priority < pendingQueue[i].priority) {
+            insertIndex = i;
+            break;
+          }
+        }
+        pendingQueue.splice(insertIndex, 0, task);
+        renderQueue();
+        checkAndStartWorker();
+      }
+
+      function createTask(type) {
+        taskCounter++;
+        const catalog = taskCatalog[type];
+        const template = catalog[(taskCounter - 1) % catalog.length];
+
+        let priority;
+        let priorityLabel;
+        let badgeClass;
+
+        if (type === 'urgent') {
+          priority = PRIORITY.URGENT;
+          priorityLabel = '⚡ Urgent [P1]';
+          badgeClass = 'badge-urgent';
+        } else if (type === 'standard') {
+          priority = PRIORITY.STANDARD;
+          priorityLabel = '📋 Standard [P2]';
+          badgeClass = 'badge-standard';
+        } else {
+          priority = PRIORITY.BACKGROUND;
+          priorityLabel = '📡 Background [P3]';
+          badgeClass = 'badge-telemetry';
+        }
+
+        return {
+          id: `TASK-${taskCounter.toString().padStart(4, '0')}`,
+          name: template.name,
+          type: type,
+          priority: priority,
+          priorityLabel: priorityLabel,
+          badgeClass: badgeClass,
+          totalSteps: template.steps,
+          chunkDuration: template.chunkDuration,
+          enqueuedAt: new Date()
+        };
+      }
+
+      // UI Rendering for Queue
+      function renderQueue() {
+        queueTotalCountEl.textContent = pendingQueue.length;
+
+        const urgentCount = pendingQueue.filter(t => t.priority === PRIORITY.URGENT).length;
+        const standardCount = pendingQueue.filter(t => t.priority === PRIORITY.STANDARD).length;
+        const telemetryCount = pendingQueue.filter(t => t.priority === PRIORITY.BACKGROUND).length;
+
+        countUrgentPillEl.textContent = `Urgent: ${urgentCount}`;
+        countStandardPillEl.textContent = `Menu: ${standardCount}`;
+        countTelemetryPillEl.textContent = `Telemetry: ${telemetryCount}`;
+
+        if (pendingQueue.length === 0) {
+          queueListEl.innerHTML = '<li class="empty-state">No pending operations in queue. Enqueue tasks above!</li>';
+          return;
+        }
+
+        queueListEl.innerHTML = '';
+        pendingQueue.forEach((task, index) => {
+          const li = document.createElement('li');
+          li.className = `task-item priority-${task.type}`;
+          li.innerHTML = `
+            <div class="task-info">
+              <span class="task-name">#${index + 1}. [${task.id}] ${task.name}</span>
+              <span class="task-meta">${task.totalSteps} chunks &bull; Est. ${task.totalSteps * task.chunkDuration}ms &bull; Added ${task.enqueuedAt.toLocaleTimeString()}</span>
+            </div>
+            <div>
+              <span class="badge ${task.badgeClass}">${task.priorityLabel}</span>
+            </div>
+          `;
+          queueListEl.appendChild(li);
+        });
+      }
+
+      // Render History Log
+      function renderHistory() {
+        historyTotalCountEl.textContent = historyList.length;
+        if (historyList.length === 0) {
+          historyListEl.innerHTML = '<div class="empty-state">Completed tasks will be recorded here.</div>';
+          return;
+        }
+
+        historyListEl.innerHTML = '';
+        historyList.slice(0, 20).forEach(item => {
+          const div = document.createElement('div');
+          div.className = 'history-item';
+          div.innerHTML = `
+            <div>
+              <div class="history-name">[${item.id}] ${item.name}</div>
+              <div class="history-duration">Duration: ${item.durationMs}ms &bull; Finished at ${item.completedAt.toLocaleTimeString()}</div>
+            </div>
+            <div>
