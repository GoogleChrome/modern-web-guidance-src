+      }
+
+      // Responsive Asynchronous Worker:
+      // Uses cooperative time-slicing via setTimeout and requestAnimationFrame to yield control
+      // back to the browser's event loop between task chunks, keeping the main thread responsive.
+      async function checkAndStartWorker() {
+        if (isWorkerBusy) return;
+        if (pendingQueue.length === 0) {
+          resetActiveTaskView();
+          return;
+        }
+
+        isWorkerBusy = true;
+        const currentTask = pendingQueue.shift();
+        renderQueue();
+
+        await executeTaskCooperatively(currentTask);
+
+        isWorkerBusy = false;
+        // Check for next queued task
+        setTimeout(checkAndStartWorker, 10);
+      }
+
+      async function executeTaskCooperatively(task) {
+        const startTime = performance.now();
+        activeSpinnerEl.textContent = '⚙️';
+        activeTaskStateEl.textContent = `Worker Status: Processing ${task.id}`;
+        activeTaskTitleEl.textContent = task.name;
+        activeTaskBadgeEl.innerHTML = `<span class="badge ${task.badgeClass}">${task.priorityLabel}</span>`;
+        progressBarInnerEl.style.width = '0%';
+        activeTaskPercentageEl.textContent = '0%';
+
+        for (let step = 1; step <= task.totalSteps; step++) {
+          // Synthetic workload computation to simulate real work per chunk
+          const loopCount = 20000;
+          let hashAcc = 0;
+          for (let k = 0; k < loopCount; k++) {
+            hashAcc += Math.sin(k) * Math.cos(k);
+          }
+
+          // Cooperative yield: Return control to browser event loop
+          // This allows rendering frames, servicing clicks, and maintaining 60 FPS
+          await new Promise(resolve => setTimeout(resolve, task.chunkDuration));
+
+          const percent = Math.round((step / task.totalSteps) * 100);
+          progressBarInnerEl.style.width = `${percent}%`;
+          activeTaskPercentageEl.textContent = `${percent}%`;
+          activeStepInfoEl.textContent = `Processing slice ${step} of ${task.totalSteps} (${task.chunkDuration}ms cooperative slice)`;
+          const elapsed = Math.round(performance.now() - startTime);
+          activeTimeInfoEl.textContent = `Elapsed: ${elapsed}ms`;
+        }
+
+        const totalDuration = Math.round(performance.now() - startTime);
+
+        // Record into history
+        historyList.unshift({
+          id: task.id,
+          name: task.name,
+          priorityLabel: task.priorityLabel,
+          badgeClass: task.badgeClass,
+          durationMs: totalDuration,
+          completedAt: new Date()
+        });
+
+        renderHistory();
+      }
+
+      function resetActiveTaskView() {
+        activeSpinnerEl.textContent = '🟢';
+        activeTaskStateEl.textContent = 'Worker Status: Idle (Ready)';
+        activeTaskTitleEl.textContent = 'No task currently processing';
+        activeTaskBadgeEl.innerHTML = '';
+        progressBarInnerEl.style.width = '0%';
+        activeTaskPercentageEl.textContent = '0%';
+        activeStepInfoEl.textContent = 'Queue waiting for new operations';
+        activeTimeInfoEl.textContent = 'Elapsed: 0ms';
+      }
+
+      // Button Handlers
+      document.getElementById('btn-urgent').addEventListener('click', () => {
+        enqueueTask(createTask('urgent'));
+      });
+
+      document.getElementById('btn-standard').addEventListener('click', () => {
+        enqueueTask(createTask('standard'));
+      });
+
+      document.getElementById('btn-telemetry').addEventListener('click', () => {
+        enqueueTask(createTask('telemetry'));
+      });
+
+      // Batch Button: Enqueues mixed tasks in non-priority order,
+      // and the priority queue guarantees they execute in priority order (Urgent -> Standard -> Telemetry)
+      document.getElementById('btn-batch').addEventListener('click', () => {
+        const mixedBatch = [
+          createTask('telemetry'),
+          createTask('standard'),
+          createTask('urgent'),
+          createTask('telemetry'),
+          createTask('standard'),
+          createTask('urgent')
+        ];
+
+        mixedBatch.forEach(task => enqueueTask(task));
