diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..a89065f 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,34 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
+}
+
+/* Modern Native Dialog & Backdrop Styles */
+dialog {
+  margin: auto;
+  border: none;
+  background: transparent;
+  padding: 0;
+  color: inherit;
+  max-width: 100vw;
+  max-height: 100vh;
+}
+
+dialog::backdrop {
+  background-color: rgba(0, 0, 0, 0.4);
+  backdrop-filter: blur(4px);
+}
+
+/* Modern Popover styling & polyfill compatibility */
+[popover] {
+  margin: 0;
+  padding: 0;
+  border: none;
+  background: transparent;
+  color: inherit;
+  inset: auto;
+}
+
+[popover]:is(:popover-open, .\:popover-open) {
+  display: block;
 }
