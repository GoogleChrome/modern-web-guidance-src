+/**
+ * Modern HTML Application Script
+ * Focus management, native overlay interactions, and accessible states.
+ */
+
+// Coffee Catalog Data (Stock photos with semantic metadata)
+const COFFEE_DATA = {
+  'maple-oat': {
+    title: 'Maple Oat Latte',
+    price: '$5.75',
+    image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=600&q=80',
+    alt: 'Maple Oat Latte in a ceramic mug with latte art',
+    description: 'Creamy oat milk infused with authentic pure Vermont maple syrup and a double shot of single-origin espresso.',
+    origin: 'Ethiopia & Vermont',
+    roast: 'Medium',
+    tastingNotes: ['Pure Maple', 'Caramel', 'Velvety Oat'],
+    caffeine: '150 mg',
+    selectValue: 'maple-oat'
+  },
+  'dark-roast': {
+    title: 'Dark Roast Espresso',
+    price: '$3.95',
+    image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=600&q=80',
+    alt: 'Double shot dark roast espresso with rich crema',
+    description: 'Bold, smoky, and full-bodied with a dense layer of golden hazelnut crema. Sourced from high-altitude volcanic soils.',
+    origin: 'Guatemala & Sumatra',
+    roast: 'Dark',
+    tastingNotes: ['Dark Chocolate', 'Roasted Walnut', 'Subtle Smoke'],
+    caffeine: '130 mg',
+    selectValue: 'dark-roast'
+  },
+  'cold-brew': {
+    title: 'Cold Brew',
+    price: '$4.85',
+    image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=600&q=80',
+    alt: 'Cold brew coffee with ice in a clear glass',
+    description: 'Coarse-ground artisanal beans steeped slowly in filtered mountain water for 18 hours for silkiness and low acidity.',
+    origin: 'Colombia Supremo',
+    roast: 'Medium-Dark',
+    tastingNotes: ['Cocoa Nib', 'Blackberry', 'Molasses'],
+    caffeine: '205 mg',
+    selectValue: 'cold-brew'
+  }
+};
+
+/**
+ * Focus Management & Overlay Controller
+ */
+class OverlayManager {
+  constructor() {
+    this.activeTriggers = new Map(); // Maps dialog element to its trigger element
+    this.toastTimeout = null;
+
+    this.initDialogs();
+    this.initDetailsButtons();
+    this.initOrderFlow();
+    this.initLogoutFlow();
+  }
+
+  /**
+   * Opens a native modal dialog with comprehensive focus tracking
+   * @param {HTMLDialogElement} dialog 
+   * @param {HTMLElement} trigger 
+   */
+  openDialog(dialog, trigger = null) {
+    if (!dialog || typeof dialog.showModal !== 'function') return;
+
+    // Track triggering element to restore focus on close
+    const triggerEl = trigger || document.activeElement;
+    this.activeTriggers.set(dialog, triggerEl);
+
+    dialog.showModal();
+
+    // Ensure focus moves inside: prioritize [autofocus], then fallback to first interactive control
+    const autofocusTarget = dialog.querySelector('[autofocus]');
+    if (autofocusTarget) {
+      autofocusTarget.focus();
+    } else {
+      const firstFocusable = dialog.querySelector(
+        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
+      );
+      if (firstFocusable) {
+        firstFocusable.focus();
+      }
+    }
+  }
+
+  /**
+   * Closes a native modal dialog and restores focus to trigger element
+   * @param {HTMLDialogElement} dialog 
+   */
+  closeDialog(dialog) {
+    if (!dialog || !dialog.open) return;
+    dialog.close();
+  }
+
+  /**
+   * Configures native dialog lifecycle, backdrop clicks, and focus restoration
+   */
+  initDialogs() {
+    const dialogs = document.querySelectorAll('dialog.modal-dialog');
+
+    dialogs.forEach((dialog) => {
+      // Restore focus whenever dialog closes (via Esc key, close(), or form submit)
+      dialog.addEventListener('close', () => {
+        const trigger = this.activeTriggers.get(dialog);
+        if (trigger && typeof trigger.focus === 'function' && document.body.contains(trigger)) {
+          trigger.focus();
+        }
+        this.activeTriggers.delete(dialog);
+      });
+
+      // Close when clicking directly on the backdrop (outside dialog bounding rect)
+      dialog.addEventListener('click', (event) => {
+        const rect = dialog.getBoundingClientRect();
+        const isInDialog = (
+          event.clientX >= rect.left &&
+          event.clientX <= rect.right &&
+          event.clientY >= rect.top &&
+          event.clientY <= rect.bottom
+        );
+        if (!isInDialog) {
+          this.closeDialog(dialog);
+        }
+      });
+
+      // Close buttons marked with data-close attribute
+      const closeButtons = dialog.querySelectorAll('[data-close]');
+      closeButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          this.closeDialog(dialog);
+        });
+      });
+    });
+  }
+
+  /**
+   * Initializes coffee item details overlay
+   */
+  initDetailsButtons() {
+    const detailsDialog = document.getElementById('details-dialog');
+    const detailsButtons = document.querySelectorAll('[data-coffee-details]');
+    const detailsOrderBtn = document.getElementById('details-order-btn');
+
+    let currentCoffeeId = null;
+
+    detailsButtons.forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const coffeeKey = btn.getAttribute('data-coffee-details');
+        const coffee = COFFEE_DATA[coffeeKey];
+        if (!coffee) return;
+
+        currentCoffeeId = coffeeKey;
+
+        // Populate details content
+        document.getElementById('details-dialog-title').textContent = coffee.title;
+        const img = document.getElementById('details-img');
+        img.src = coffee.image;
+        img.alt = coffee.alt;
+
+        document.getElementById('details-desc').textContent = coffee.description;
+        document.getElementById('details-origin').textContent = coffee.origin;
+        document.getElementById('details-roast').textContent = coffee.roast;
+        document.getElementById('details-caffeine').textContent = coffee.caffeine;
+        document.getElementById('details-price').textContent = coffee.price;
+
+        const notesContainer = document.getElementById('details-notes');
+        notesContainer.innerHTML = '';
+        coffee.tastingNotes.forEach((note) => {
+          const tag = document.createElement('span');
+          tag.className = 'note-tag';
+          tag.textContent = note;
+          notesContainer.appendChild(tag);
+        });
+
+        this.openDialog(detailsDialog, btn);
+      });
+    });
+
+    // Seamless handoff from Details Modal to Order Modal
+    if (detailsOrderBtn) {
+      detailsOrderBtn.addEventListener('click', () => {
+        const originalTrigger = this.activeTriggers.get(detailsDialog);
+        this.closeDialog(detailsDialog);
+
+        // Pre-select the coffee in Order modal
+        const coffeeSelect = document.getElementById('coffee-select');
+        if (coffeeSelect && currentCoffeeId) {
+          coffeeSelect.value = currentCoffeeId;
+        }
+
+        const orderDialog = document.getElementById('order-dialog');
+        // Restore focus to original card button when final order dialog closes
+        this.openDialog(orderDialog, originalTrigger);
+      });
+    }
+  }
+
+  /**
+   * Initializes Order modal flow
+   */
+  initOrderFlow() {
+    const orderDialog = document.getElementById('order-dialog');
+    const orderNowBtn = document.getElementById('order-now-btn');
+    const orderForm = document.getElementById('order-form');
+
+    if (orderNowBtn && orderDialog) {
+      orderNowBtn.addEventListener('click', () => {
+        this.openDialog(orderDialog, orderNowBtn);
+      });
+    }
+
+    if (orderForm && orderDialog) {
+      orderForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const selectEl = document.getElementById('coffee-select');
+        const selectedText = selectEl.options[selectEl.selectedIndex]?.text || 'Your coffee';
+
+        this.closeDialog(orderDialog);
+        this.showToast(`Order received for ${selectedText}! We're brewing it fresh.`);
+        orderForm.reset();
+      });
+    }
+  }
+
+  /**
+   * Initializes Logout confirmation overlay
+   */
+  initLogoutFlow() {
+    const logoutDialog = document.getElementById('logout-dialog');
+    const logoutBtn = document.getElementById('logout-trigger');
+    const confirmLogoutBtn = document.getElementById('confirm-logout-btn');
+
+    if (logoutBtn && logoutDialog) {
+      logoutBtn.addEventListener('click', () => {
+        this.openDialog(logoutDialog, logoutBtn);
+      });
+    }
+
+    if (confirmLogoutBtn && logoutDialog) {
+      confirmLogoutBtn.addEventListener('click', () => {
+        this.closeDialog(logoutDialog);
+        this.showToast('You have been logged out safely.');
+      });
+    }
+  }
+
+  /**
+   * Displays an accessible live status toast message
+   * @param {string} message 
+   */
+  showToast(message) {
+    const toast = document.getElementById('live-toast');
+    if (!toast) return;
+
+    if (this.toastTimeout) {
+      clearTimeout(this.toastTimeout);
+    }
+
+    toast.textContent = message;
+    toast.classList.add('show');
+
+    this.toastTimeout = setTimeout(() => {
+      toast.classList.remove('show');
+    }, 4000);
+  }
+}
+
+// Initialize on DOM ready
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', () => new OverlayManager());
+} else {
+  new OverlayManager();
+}
