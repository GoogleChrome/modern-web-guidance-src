+  <!-- Progressive Enhancement & Polyfills / Fallbacks -->
+  <script type="module">
+    // 1. Declarative Invoker Commands fallback (button[commandfor])
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      document.addEventListener('click', (event) => {
+        const button = event.composedPath().find((el) => el?.matches?.('button[commandfor]'));
+        if (!button) return;
+        const targetId = button.getAttribute('commandfor');
+        const command = button.getAttribute('command');
+        const target = document.getElementById(targetId);
+        if (!target || !command) return;
+
+        if (command === 'show-modal' && typeof target.showModal === 'function') {
+          target.showModal();
+        } else if (command === 'close' && typeof target.close === 'function') {
+          target.close();
+        } else if (command === 'toggle-popover' && typeof target.togglePopover === 'function') {
+          target.togglePopover();
+        }
+      });
+    }
+
+    // 2. Light-Dismiss fallback for browsers lacking closedby support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      document.querySelectorAll('dialog[closedby]').forEach((dialog) => {
+        dialog.addEventListener('click', (event) => {
+          if (event.target !== dialog) return;
+          const rect = dialog.getBoundingClientRect();
+          const isDialogContent = (
+            rect.top <= event.clientY &&
+            event.clientY <= rect.top + rect.height &&
+            rect.left <= event.clientX &&
+            event.clientX <= rect.left + rect.width
+          );
+          if (!isDialogContent) {
+            dialog.close();
+          }
+        });
+      });
+    }
+
+    // 3. Popover ARIA State Management (aria-expanded)
+    const accountPopover = document.getElementById('account-popover');
+    const accountBtn = document.getElementById('account-btn');
+    if (accountPopover && accountBtn) {
+      accountPopover.addEventListener('toggle', (event) => {
+        accountBtn.setAttribute('aria-expanded', event.newState === 'open' ? 'true' : 'false');
+      });
+    }
+  </script>
