+  <script>
+    (function () {
+      const columns = document.querySelectorAll('.board-column');
+
+      // Atomic reparenting without tearing down DOM state per modern-web-guidance
+      function moveCard(card, targetColumn, referenceNode = null) {
+        if (!card || !targetColumn) return;
+        const header = targetColumn.querySelector('.column-header');
+        if (referenceNode === header) {
+          referenceNode = header ? header.nextElementSibling : null;
+        }
+        if (card === referenceNode) return;
+
+        if ('moveBefore' in Element.prototype) {
+          targetColumn.moveBefore(card, referenceNode);
+        } else {
+          targetColumn.insertBefore(card, referenceNode);
+        }
+        updateCardActionsForColumn(card, targetColumn);
+      }
+
+      // Synchronize column counters reactively with zero polling
+      function updateColumnCounts() {
+        columns.forEach(col => {
+          const badge = col.querySelector('.column-badge');
+          const count = col.querySelectorAll('.card').length;
+          if (badge) badge.textContent = count;
+        });
+      }
+
+      columns.forEach(col => {
+        const observer = new MutationObserver(() => updateColumnCounts());
+        observer.observe(col, { childList: true });
+      });
+      updateColumnCounts();
+
+      let draggedCard = null;
+
+      // Event delegation for dragging
+      document.addEventListener('dragstart', (e) => {
+        const card = e.target.closest('.card');
+        if (!card || !card.closest('.board-column')) return;
+
+        draggedCard = card;
+        card.classList.add('is-dragging');
+        if (e.dataTransfer) {
+          e.dataTransfer.effectAllowed = 'move';
+          e.dataTransfer.setData('text/plain', card.id || '');
+        }
+      });
+
+      document.addEventListener('dragend', (e) => {
+        const card = e.target.closest('.card') || draggedCard;
+        if (card) {
+          card.classList.remove('is-dragging');
+        }
+        draggedCard = null;
+        columns.forEach(col => col.classList.remove('drag-over'));
+      });
+
+      // Drag and drop event listeners on columns
+      columns.forEach(col => {
+        col.addEventListener('dragover', (e) => {
+          e.preventDefault();
+          if (e.dataTransfer) {
+            e.dataTransfer.dropEffect = 'move';
+          }
+          col.classList.add('drag-over');
+        });
+
+        col.addEventListener('dragleave', (e) => {
+          if (!col.contains(e.relatedTarget)) {
+            col.classList.remove('drag-over');
+          }
+        });
+
+        col.addEventListener('drop', (e) => {
+          e.preventDefault();
+          col.classList.remove('drag-over');
+
+          const cardId = e.dataTransfer ? e.dataTransfer.getData('text/plain') : null;
+          const card = draggedCard || (cardId ? document.getElementById(cardId) : null);
+          if (!card) return;
+
+          // Efficient drop positioning calculated without global layout thrashing
+          const targetCard = e.target.closest('.card');
+          let referenceNode = null;
+
+          if (targetCard && targetCard !== card && col.contains(targetCard)) {
+            const rect = targetCard.getBoundingClientRect();
+            if (e.clientY > rect.top + rect.height / 2) {
+              referenceNode = targetCard.nextElementSibling;
+            } else {
+              referenceNode = targetCard;
+            }
+          }
+
+          moveCard(card, col, referenceNode);
+        });
+      });
+
+      function updateCardActionsForColumn(card, column) {
+        const status = column.dataset.status;
+        const actionsContainer = card.querySelector('.card-actions');
+        if (!actionsContainer || !status) return;
+
+        if (status === 'queued') {
+          actionsContainer.innerHTML = '<button class="action-btn" title="Move to Brewing" data-move-to="brewing" type="button">&rarr; Brew</button>';
+        } else if (status === 'brewing') {
+          actionsContainer.innerHTML = '<button class="action-btn" title="Move to Ready" data-move-to="ready" type="button">&rarr; Ready</button>';
+        } else if (status === 'ready') {
+          actionsContainer.innerHTML = '<button class="action-btn" title="Mark Picked Up" data-move-to="completed" type="button">&check; Picked Up</button>';
+        }
+      }
+
