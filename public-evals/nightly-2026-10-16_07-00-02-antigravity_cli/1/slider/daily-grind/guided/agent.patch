+  <script>
+    function setupRangeSlider(slider, output, formatFn) {
+      if (!slider) return;
+
+      function syncSliderValue() {
+        const min = Number(slider.min) || 0;
+        const max = Number(slider.max) || 100;
+        const val = Number(slider.value);
+
+        // Update CSS custom properties for fill and fallback calculations
+        slider.style.setProperty('--attr-min', min);
+        slider.style.setProperty('--attr-max', max);
+        slider.style.setProperty('--control-value', val);
+
+        // Update accessibility attributes and dynamic output label
+        slider.setAttribute('aria-valuenow', val);
+        if (output && formatFn) {
+          const { text, ariaText } = formatFn(val, min, max);
+          output.textContent = text;
+          if (ariaText) {
+            slider.setAttribute('aria-valuetext', ariaText);
+          }
+        }
+      }
+
+      slider.addEventListener('input', syncSliderValue);
+      syncSliderValue();
+    }
+
+    document.addEventListener('DOMContentLoaded', () => {
+      // 1. Roast Level Slider
+      const roastSlider = document.querySelector('#roast-slider');
+      const roastOutput = document.querySelector('#roast-output');
+      setupRangeSlider(roastSlider, roastOutput, (val) => {
+        let label = 'Light';
+        if (val >= 80) label = 'Dark';
+        else if (val >= 60) label = 'Medium Dark';
+        else if (val >= 40) label = 'Medium';
+        else if (val >= 20) label = 'Medium Light';
+
+        return {
+          text: `${label} (${val}%)`,
+          ariaText: `${label} Roast, ${val}%`
+        };
+      });
+
+      // 2. Extraction Strength Slider
+      const strengthSlider = document.querySelector('#strength-slider');
+      const strengthOutput = document.querySelector('#strength-output');
+      const strengthNames = {
+        1: 'Mild',
+        2: 'Light',
+        3: 'Balanced',
+        4: 'Bold',
+        5: 'Intense'
+      };
+      setupRangeSlider(strengthSlider, strengthOutput, (val) => {
+        const label = strengthNames[val] || `${val}`;
+        return {
+          text: `${label} (${val}/5)`,
+          ariaText: `${label} extraction, ${val} out of 5`
+        };
+      });
+    });
+  </script>
