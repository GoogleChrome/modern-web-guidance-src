+  <script>
+    (function() {
+      const grindNames = {
+        1: 'Extra Fine (Espresso)',
+        2: 'Fine (AeroPress)',
+        3: 'Medium (Pour Over)',
+        4: 'Medium-Coarse (Drip)',
+        5: 'Coarse (French Press)'
+      };
+
+      function updateSlider(slider) {
+        const min = parseFloat(slider.min) || 0;
+        const max = parseFloat(slider.max) || 100;
+        const val = parseFloat(slider.value) || 0;
+        const pct = Math.max(0, Math.min(100, ((val - min) / (max - min)) * 100));
+
+        // Update CSS custom property for WebKit/Blink gradient fill
+        slider.style.setProperty('--range-progress', `${pct}%`);
+
+        if (slider.id === 'grind-slider') {
+          const text = grindNames[val] || `Step ${val}`;
+          const output = document.getElementById('grind-output');
+          const summary = document.getElementById('summary-grind');
+          if (output) output.textContent = text;
+          if (summary) summary.textContent = text;
+          slider.setAttribute('aria-valuetext', text);
+
+          // Update tick labels
+          const ticks = document.querySelectorAll('.range-slider-ticks span');
+          ticks.forEach(tick => {
+            if (tick.dataset.step == val) {
+              tick.classList.add('is-active');
+            } else {
+              tick.classList.remove('is-active');
+            }
+          });
+        } else if (slider.id === 'strength-slider') {
+          let label = 'Mild';
+          if (val >= 80) label = 'Extra Bold';
+          else if (val >= 60) label = 'Bold';
+          else if (val >= 40) label = 'Balanced';
+          else if (val >= 20) label = 'Light';
+
+          const display = `${val}% • ${label}`;
+          const output = document.getElementById('strength-output');
+          const summary = document.getElementById('summary-strength');
+          if (output) output.textContent = display;
+          if (summary) summary.textContent = display;
+          slider.setAttribute('aria-valuetext', `${val}% ${label} extraction`);
+        } else if (slider.id === 'ratio-slider') {
+          const display = `1:${val}`;
+          const output = document.getElementById('ratio-output');
+          const summary = document.getElementById('summary-ratio');
+          if (output) output.textContent = display;
+          if (summary) summary.textContent = display;
+          slider.setAttribute('aria-valuetext', `1 to ${val} brew ratio`);
+        }
+      }
+
+      // Initialize all sliders and register events
+      document.querySelectorAll('.range-slider').forEach(slider => {
+        updateSlider(slider);
+        slider.addEventListener('input', () => updateSlider(slider));
+        slider.addEventListener('change', () => updateSlider(slider));
+      });
+    })();
+  </script>
 </body>
 
