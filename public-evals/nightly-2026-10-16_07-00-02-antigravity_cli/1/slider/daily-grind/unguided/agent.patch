index 0000000..fe08dac
--- /dev/null
+++ b/range-slider.css
@@ -0,0 +1,366 @@
+/**
+ * Custom Native Range Slider Styles
+ *
+ * Provides cross-browser styling for native <input type="range"> while preserving
+ * full native accessibility, keyboard navigation, and touch/mouse interaction.
+ *
+ * Supported features:
+ * - Custom track with rounded ends
+ * - Custom interactive thumb with hover and active/pressed feedback
+ * - Custom fill / progress bar (dynamic WebKit/Blink via CSS var + native Firefox ::-moz-range-progress)
+ * - Accessible keyboard focus states (:focus-visible) with thumb halo and outline
+ * - Disabled states for track, thumb, and fill
+ * - Windows High Contrast Mode / Forced Colors support
+ * - Reduced motion support
+ */
+
+:root {
+  --slider-track-height: 8px;
+  --slider-thumb-size: 24px;
+  --slider-track-bg: #e0d7d3;
+  --slider-fill-bg: #ffab40;
+  --slider-thumb-bg: #4e342e;
+  --slider-thumb-border: #ffffff;
+  --slider-thumb-hover-bg: #3e2723;
+  --slider-focus-color: #ffab40;
+  --slider-focus-ring: rgba(255, 171, 64, 0.45);
+  --slider-disabled-track: #e0e0e0;
+  --slider-disabled-fill: #bdbdbd;
+  --slider-disabled-thumb: #9e9e9e;
+  --slider-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
+  --slider-shadow-hover: 0 3px 8px rgba(0, 0, 0, 0.35);
+}
+
+/* ==========================================================================
+   Range Slider Container & Label Typography
+   ========================================================================== */
+
+.range-slider-group {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin-bottom: 24px;
+  text-align: left;
+}
+
+.range-slider-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.range-slider-label {
+  font-size: 1rem;
+  font-weight: 600;
+  color: var(--text, #3e2723);
+  cursor: pointer;
+  user-select: none;
+}
+
+.range-slider-output {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 48px;
+  padding: 2px 10px;
+  font-size: 0.875rem;
+  font-weight: 700;
+  color: var(--primary, #4e342e);
+  background-color: #f5ece7;
+  border: 1px solid var(--secondary, #d7ccc8);
+  border-radius: 999px;
+  text-align: center;
+  font-variant-numeric: tabular-nums;
+}
+
+.range-slider-helper {
+  font-size: 0.825rem;
+  color: #6d4c41;
+}
+
+/* ==========================================================================
+   Native Range Input Base
+   ========================================================================== */
+
+.range-slider {
+  -webkit-appearance: none;
+  appearance: none;
+  width: 100%;
+  height: max(var(--slider-thumb-size), 32px); /* comfortable touch target */
+  background: transparent;
+  cursor: pointer;
+  margin: 0;
+  padding: 0;
+  vertical-align: middle;
+  touch-action: pan-y;
+  --range-progress: 50%; /* dynamically updated via JS or inline CSS */
+}
+
+/* Remove default Firefox dotted inner focus border */
+.range-slider::-moz-focus-outer {
+  border: 0;
+}
+
+/* ==========================================================================
+   Webkit / Blink Track & Fill
+   ========================================================================== */
+
+.range-slider::-webkit-slider-runnable-track {
+  width: 100%;
+  height: var(--slider-track-height);
+  border-radius: calc(var(--slider-track-height) / 2);
+  /* Two-tone fill: progress color before thumb, neutral track after */
+  background: linear-gradient(
+    to right,
+    var(--slider-fill-bg) 0%,
+    var(--slider-fill-bg) var(--range-progress),
+    var(--slider-track-bg) var(--range-progress),
+    var(--slider-track-bg) 100%
+  );
+  border: none;
+  cursor: pointer;
+  transition: background 0.1s ease;
+}
+
+/* ==========================================================================
+   Webkit / Blink Thumb
+   ========================================================================== */
+
+.range-slider::-webkit-slider-thumb {
+  -webkit-appearance: none;
+  appearance: none;
+  width: var(--slider-thumb-size);
+  height: var(--slider-thumb-size);
+  border-radius: 50%;
+  background: var(--slider-thumb-bg);
+  border: 3px solid var(--slider-thumb-border);
+  box-shadow: var(--slider-shadow);
+  cursor: grab;
+  /* Vertically center thumb relative to track: (track-height - thumb-height) / 2 */
+  margin-top: calc((var(--slider-track-height) - var(--slider-thumb-size)) / 2);
+  transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1),
+              background-color 0.15s ease,
+              box-shadow 0.15s ease;
+}
+
+.range-slider:hover::-webkit-slider-thumb {
+  background: var(--slider-thumb-hover-bg);
+  box-shadow: var(--slider-shadow-hover);
+  transform: scale(1.08);
+}
+
+.range-slider:active::-webkit-slider-thumb {
+  cursor: grabbing;
+  transform: scale(1.16);
+  box-shadow: 0 0 0 6px var(--slider-focus-ring), var(--slider-shadow-hover);
+}
+
+/* ==========================================================================
+   Firefox (Gecko) Track, Fill & Thumb
+   ========================================================================== */
+
+.range-slider::-moz-range-track {
+  width: 100%;
+  height: var(--slider-track-height);
+  border-radius: calc(var(--slider-track-height) / 2);
+  background: var(--slider-track-bg);
+  border: none;
+  cursor: pointer;
+}
+
+/* Firefox native progress fill */
+.range-slider::-moz-range-progress {
+  height: var(--slider-track-height);
+  border-radius: calc(var(--slider-track-height) / 2) 0 0 calc(var(--slider-track-height) / 2);
+  background: var(--slider-fill-bg);
+  border: none;
+}
+
+.range-slider::-moz-range-thumb {
+  width: var(--slider-thumb-size);
+  height: var(--slider-thumb-size);
+  border-radius: 50%;
+  background: var(--slider-thumb-bg);
+  border: 3px solid var(--slider-thumb-border);
+  box-shadow: var(--slider-shadow);
+  cursor: grab;
+  box-sizing: border-box;
+  transition: transform 0.15s cubic-bezier(0.4, 0, 0.2, 1),
+              background-color 0.15s ease,
+              box-shadow 0.15s ease;
+}
+
+.range-slider:hover::-moz-range-thumb {
+  background: var(--slider-thumb-hover-bg);
+  box-shadow: var(--slider-shadow-hover);
+  transform: scale(1.08);
+}
+
+.range-slider:active::-moz-range-thumb {
+  cursor: grabbing;
+  transform: scale(1.16);
+  box-shadow: 0 0 0 6px var(--slider-focus-ring), var(--slider-shadow-hover);
+}
+
+/* ==========================================================================
+   Focus & Accessibility States
+   ========================================================================== */
+
+/* Remove default focus ring on mouse click */
+.range-slider:focus {
+  outline: none;
+}
+
+/* Prominent, accessible keyboard focus indicator */
+.range-slider:focus-visible {
+  outline: 2px solid var(--slider-focus-color);
+  outline-offset: 4px;
+  border-radius: 8px;
+}
+
+.range-slider:focus-visible::-webkit-slider-thumb {
+  box-shadow: 0 0 0 4px var(--slider-focus-ring), var(--slider-shadow-hover);
+}
+
+.range-slider:focus-visible::-moz-range-thumb {
+  box-shadow: 0 0 0 4px var(--slider-focus-ring), var(--slider-shadow-hover);
+}
+
+/* ==========================================================================
+   Disabled States
+   ========================================================================== */
+
+.range-slider:disabled {
+  cursor: not-allowed;
+  opacity: 0.6;
+}
+
+.range-slider:disabled::-webkit-slider-runnable-track {
+  cursor: not-allowed;
+  background: linear-gradient(
+    to right,
+    var(--slider-disabled-fill) 0%,
+    var(--slider-disabled-fill) var(--range-progress),
+    var(--slider-disabled-track) var(--range-progress),
+    var(--slider-disabled-track) 100%
+  );
+}
+
+.range-slider:disabled::-moz-range-track {
+  cursor: not-allowed;
+  background: var(--slider-disabled-track);
+}
+
+.range-slider:disabled::-moz-range-progress {
+  background: var(--slider-disabled-fill);
+}
+
+.range-slider:disabled::-webkit-slider-thumb {
+  cursor: not-allowed;
+  background: var(--slider-disabled-thumb);
+  border-color: #f5f5f5;
+  box-shadow: none;
+  transform: none;
+}
+
+.range-slider:disabled::-moz-range-thumb {
+  cursor: not-allowed;
+  background: var(--slider-disabled-thumb);
+  border-color: #f5f5f5;
+  box-shadow: none;
+  transform: none;
+}
+
+/* ==========================================================================
+   Slider Ticks / Scale Marks (Optional Enhancement)
+   ========================================================================== */
+
+.range-slider-ticks {
+  display: flex;
+  justify-content: space-between;
+  padding: 0 6px;
+  margin-top: -2px;
+  user-select: none;
+}
+
+.range-slider-ticks span {
+  font-size: 0.75rem;
+  color: #795548;
+  position: relative;
+  text-align: center;
+}
+
+.range-slider-ticks span::before {
+  content: "";
+  display: block;
+  width: 2px;
+  height: 6px;
+  background-color: #bcaaa4;
+  margin: 0 auto 4px auto;
+  border-radius: 1px;
+}
+
+/* Active tick indicator */
+.range-slider-ticks span.is-active {
+  color: var(--primary, #4e342e);
+  font-weight: 600;
+}
+
+.range-slider-ticks span.is-active::before {
+  background-color: var(--primary, #4e342e);
+}
+
+/* ==========================================================================
+   Windows High Contrast Mode (Forced Colors) Support
+   ========================================================================== */
+
+@media (forced-colors: active) {
+  .range-slider::-webkit-slider-runnable-track {
+    border: 1px solid CanvasText;
+    background: Canvas;
+  }
+
+  .range-slider::-moz-range-track {
+    border: 1px solid CanvasText;
+    background: Canvas;
+  }
+
+  .range-slider::-moz-range-progress {
+    background: Highlight;
+  }
+
+  .range-slider::-webkit-slider-thumb {
+    background: Highlight;
+    border: 2px solid CanvasText;
+  }
+
+  .range-slider::-moz-range-thumb {
+    background: Highlight;
+    border: 2px solid CanvasText;
+  }
+
+  .range-slider:focus-visible {
+    outline: 3px solid Highlight;
+    outline-offset: 4px;
+  }
+
+  .range-slider:disabled::-webkit-slider-thumb,
+  .range-slider:disabled::-moz-range-thumb {
+    background: GrayText;
+    border-color: GrayText;
+  }
+}
+
+/* ==========================================================================
+   Reduced Motion Preferences
+   ========================================================================== */
+
+@media (prefers-reduced-motion: reduce) {
+  .range-slider::-webkit-slider-thumb,
+  .range-slider::-moz-range-thumb,
+  .range-slider::-webkit-slider-runnable-track {
+    transition: none;
+  }
+}
