+++ b/app.js
@@ -0,0 +1,475 @@
+import { MENU_ITEMS, LOCATIONS, REWARDS_MEMBERS } from './data.js';
+
+// DOM elements
+const menuContainer = document.getElementById('menu-items-grid');
+const locationsContainer = document.getElementById('locations-grid');
+const rewardsDisplay = document.getElementById('rewards-result');
+const orderModal = document.getElementById('orderConfirmationModal');
+const orderSummaryText = document.getElementById('orderSummaryText');
+const closeOrderModalBtn = document.getElementById('closeOrderModalBtn');
+const agentNotificationBanner = document.getElementById('agent-notification-banner');
+
+// Initial render
+renderMenuItems(MENU_ITEMS);
+renderLocations(LOCATIONS);
+
+// Setup WebMCP lifecycle listeners on document.modelContext or fallback
+const mcpContext = (typeof document !== 'undefined' && document.modelContext) ? document.modelContext : null;
+if (mcpContext) {
+  mcpContext.addEventListener('toolactivated', (e) => {
+    if (agentNotificationBanner) {
+      agentNotificationBanner.textContent = `🤖 Agent interacting with tool: ${e.toolName}`;
+      agentNotificationBanner.classList.add('visible');
+    }
+  });
+
+  mcpContext.addEventListener('toolcancel', (e) => {
+    if (agentNotificationBanner) {
+      agentNotificationBanner.textContent = `🤖 Agent canceled tool: ${e.toolName}`;
+      setTimeout(() => {
+        agentNotificationBanner.classList.remove('visible');
+      }, 2500);
+    }
+  });
+}
+
+// -------------------------------------------------------------
+// 1. TOOL: search_menu
+// -------------------------------------------------------------
+const searchMenuForm = document.getElementById('searchMenuForm');
+if (searchMenuForm) {
+  searchMenuForm.addEventListener('submit', (e) => {
+    e.preventDefault();
+    const formData = new FormData(searchMenuForm);
+    const query = (formData.get('query') || '').trim().toLowerCase();
+    const category = formData.get('category') || 'all';
+    const dietary = formData.get('dietary') || 'all';
+    const maxPriceVal = formData.get('max_price');
+    const maxPrice = maxPriceVal ? parseFloat(maxPriceVal) : null;
+
+    const validationErrors = [];
+    if (maxPrice !== null && (isNaN(maxPrice) || maxPrice <= 0)) {
+      validationErrors.push({
+        field: 'max_price',
+        value: maxPriceVal,
+        message: 'Max price must be a positive number.'
+      });
+    }
+
+    if (validationErrors.length > 0) {
+      if (e.agentInvoked && typeof e.respondWith === 'function') {
+        e.respondWith(Promise.resolve(validationErrors));
+      }
+      return;
+    }
+
+    const filtered = MENU_ITEMS.filter((item) => {
+      const matchQuery = !query || item.name.toLowerCase().includes(query) || item.description.toLowerCase().includes(query);
+      const matchCategory = category === 'all' || item.category === category;
+      const matchDietary = dietary === 'all' || item.dietary === dietary;
+      const matchPrice = maxPrice === null || item.price <= maxPrice;
+      return matchQuery && matchCategory && matchDietary && matchPrice;
+    });
+
+    renderMenuItems(filtered);
+
+    const resultPayload = {
+      count: filtered.length,
+      items: filtered.map((item) => ({
+        id: item.id,
+        name: item.name,
+        category: item.category,
+        dietary: item.dietary,
+        price: item.price,
+        description: item.description
+      }))
+    };
+
+    if (e.agentInvoked && typeof e.respondWith === 'function') {
+      e.respondWith(Promise.resolve(resultPayload));
+    }
+  });
+}
+
+// -------------------------------------------------------------
+// 2. TOOL: order_coffee
+// -------------------------------------------------------------
+const orderForm = document.getElementById('orderCoffeeForm');
+if (orderForm) {
+  orderForm.addEventListener('submit', (e) => {
+    e.preventDefault();
+    const formData = new FormData(orderForm);
+    const item = (formData.get('item') || '').trim();
+    const size = formData.get('size');
+    const milk = formData.get('milk');
+    const sweetness = formData.get('sweetness');
+    const quantity = parseInt(formData.get('quantity'), 10);
+    const customerName = (formData.get('customer_name') || '').trim();
+    const pickupLocation = formData.get('pickup_location');
+    const pickupTime = (formData.get('pickup_time') || '').trim();
+    const specialInstructions = (formData.get('special_instructions') || '').trim();
+
+    const validationErrors = [];
+    if (!item) {
+      validationErrors.push({
+        field: 'item',
+        value: item,
+        message: 'Menu item name is required.'
+      });
+    }
+    if (!size) {
+      validationErrors.push({
+        field: 'size',
+        value: size,
+        message: 'Size selection is required.'
+      });
+    }
+    if (!milk) {
+      validationErrors.push({
+        field: 'milk',
+        value: milk,
+        message: 'Milk selection is required.'
+      });
+    }
+    if (isNaN(quantity) || quantity < 1 || quantity > 20) {
+      validationErrors.push({
+        field: 'quantity',
+        value: formData.get('quantity'),
+        message: 'Quantity must be between 1 and 20.'
+      });
+    }
+    if (!customerName) {
+      validationErrors.push({
+        field: 'customer_name',
+        value: customerName,
+        message: 'Customer name is required for order pickup.'
+      });
+    }
+    if (!pickupLocation) {
+      validationErrors.push({
+        field: 'pickup_location',
+        value: pickupLocation,
+        message: 'Pickup location is required.'
+      });
+    }
+    if (!pickupTime) {
+      validationErrors.push({
+        field: 'pickup_time',
+        value: pickupTime,
+        message: 'Pickup time is required (e.g., "15 mins" or "10:30 AM").'
+      });
+    }
+
+    if (validationErrors.length > 0) {
+      if (e.agentInvoked && typeof e.respondWith === 'function') {
+        e.respondWith(Promise.resolve(validationErrors));
+      }
+      return;
+    }
+
+    // Lookup base item price or default
+    const matchedItem = MENU_ITEMS.find((m) => m.name.toLowerCase() === item.toLowerCase() || m.id === item.toLowerCase());
+    const basePrice = matchedItem ? matchedItem.price : 5.00;
+    const sizeMultiplier = size === 'large' ? 1.5 : (size === 'medium' ? 1.25 : 1.0);
+    const totalPrice = (basePrice * sizeMultiplier * quantity).toFixed(2);
+    const orderId = 'ORD-' + Math.floor(100000 + Math.random() * 900000);
+
+    const orderConfirmation = {
+      order_id: orderId,
+      status: 'confirmed',
+      customer_name: customerName,
+      item: matchedItem ? matchedItem.name : item,
+      size,
+      milk,
+      sweetness: sweetness || 'regular',
+      quantity,
+      pickup_location: pickupLocation,
+      pickup_time: pickupTime,
+      total_price: `$${totalPrice}`,
+      special_instructions: specialInstructions || 'None',
+      message: `Order ${orderId} received! Ready for pickup at ${pickupLocation} in ~${pickupTime}.`
+    };
+
+    // Show modal in browser UI
+    if (orderSummaryText && orderModal) {
+      orderSummaryText.innerHTML = `
+        <p><strong>Order #:</strong> ${orderId}</p>
+        <p><strong>Customer:</strong> ${customerName}</p>
+        <p><strong>Item:</strong> ${quantity}x ${orderConfirmation.item} (${size}, ${milk} milk, ${sweetness || 'regular'} sweetness)</p>
+        <p><strong>Pickup at:</strong> ${pickupLocation} (approx. ${pickupTime})</p>
+        <p><strong>Total:</strong> $${totalPrice}</p>
+        ${specialInstructions ? `<p><strong>Notes:</strong> ${specialInstructions}</p>` : ''}
+      `;
+      if (typeof orderModal.showModal === 'function') {
+        orderModal.showModal();
+      }
+    }
+
+    if (e.agentInvoked && typeof e.respondWith === 'function') {
+      e.respondWith(Promise.resolve(orderConfirmation));
+    }
+  });
+}
+
+// -------------------------------------------------------------
+// 3. TOOL: find_locations
+// -------------------------------------------------------------
+const locationsForm = document.getElementById('findLocationsForm');
+if (locationsForm) {
+  locationsForm.addEventListener('submit', (e) => {
+    e.preventDefault();
+    const formData = new FormData(locationsForm);
+    const query = (formData.get('query') || '').trim().toLowerCase();
+    const amenity = formData.get('amenity') || 'all';
+
+    const filtered = LOCATIONS.filter((loc) => {
+      const matchQuery = !query || loc.name.toLowerCase().includes(query) || loc.address.toLowerCase().includes(query);
+      const matchAmenity = amenity === 'all' || loc.amenities.includes(amenity);
+      return matchQuery && matchAmenity;
+    });
+
+    renderLocations(filtered);
+
+    const payload = {
+      count: filtered.length,
+      locations: filtered.map((l) => ({
+        id: l.id,
+        name: l.name,
+        address: l.address,
+        phone: l.phone,
+        hours: l.hours,
+        amenities: l.amenities
+      }))
+    };
+
+    if (e.agentInvoked && typeof e.respondWith === 'function') {
+      e.respondWith(Promise.resolve(payload));
+    }
+  });
+}
+
+// -------------------------------------------------------------
+// 4. TOOL: check_rewards
+// -------------------------------------------------------------
+const rewardsForm = document.getElementById('checkRewardsForm');
+if (rewardsForm) {
+  rewardsForm.addEventListener('submit', (e) => {
+    e.preventDefault();
+    const formData = new FormData(rewardsForm);
+    const rawIdentifier = (formData.get('identifier') || '').trim();
+    const cleanIdentifier = rawIdentifier.replace(/[^a-zA-Z0-9@.]/g, '').toLowerCase();
+
+    const validationErrors = [];
+    if (!rawIdentifier) {
+      validationErrors.push({
+        field: 'identifier',
+        value: rawIdentifier,
+        message: 'Phone number or email is required to look up rewards.'
+      });
+    }
+
+    if (validationErrors.length > 0) {
+      if (e.agentInvoked && typeof e.respondWith === 'function') {
+        e.respondWith(Promise.resolve(validationErrors));
+      }
+      return;
+    }
+
+    const member = REWARDS_MEMBERS[cleanIdentifier] || REWARDS_MEMBERS[rawIdentifier.toLowerCase()];
+
+    if (!member) {
+      const notFoundPayload = {
+        found: false,
+        identifier: rawIdentifier,
+        message: 'No rewards account found with this phone number or email. You can sign up with your barista on your next visit!'
+      };
+
+      if (rewardsDisplay) {
+        rewardsDisplay.innerHTML = `
+          <div class="alert alert-warning">
+            ${notFoundPayload.message}
+          </div>
+        `;
+      }
+
+      if (e.agentInvoked && typeof e.respondWith === 'function') {
+        e.respondWith(Promise.resolve(notFoundPayload));
+      }
+      return;
+    }
+
+    const payload = {
+      found: true,
+      name: member.name,
+      tier: member.tier,
+      points: member.points,
+      perks: member.perks,
+      available_rewards: member.availableRewards
+    };
+
+    if (rewardsDisplay) {
+      rewardsDisplay.innerHTML = `
+        <div class="rewards-card">
+          <div class="rewards-tier-badge">${member.tier}</div>
+          <h3>${member.name}</h3>
+          <p class="points-val"><strong>${member.points}</strong> Grind Points</p>
+          <div class="perks-list">
+            <strong>Active Perks:</strong>
+            <ul>${member.perks.map((p) => `<li>${p}</li>`).join('')}</ul>
+          </div>
+          <div class="rewards-redeem-list">
+            <strong>Ready to Redeem:</strong>
+            <ul>${member.availableRewards.map((r) => `<li>${r}</li>`).join('')}</ul>
+          </div>
+        </div>
+      `;
+    }
+
+    if (e.agentInvoked && typeof e.respondWith === 'function') {
+      e.respondWith(Promise.resolve(payload));
+    }
+  });
+}
+
+// -------------------------------------------------------------
+// 5. TOOL: submit_feedback
+// -------------------------------------------------------------
+const feedbackForm = document.getElementById('submitFeedbackForm');
+if (feedbackForm) {
+  feedbackForm.addEventListener('submit', (e) => {
+    e.preventDefault();
+    const formData = new FormData(feedbackForm);
+    const name = (formData.get('name') || '').trim();
+    const email = (formData.get('email') || '').trim();
+    const topic = formData.get('topic');
+    const message = (formData.get('message') || '').trim();
+
+    const validationErrors = [];
+    if (!name) {
+      validationErrors.push({
+        field: 'name',
+        value: name,
+        message: 'Name is required.'
+      });
+    }
+    if (!email || !email.includes('@')) {
+      validationErrors.push({
+        field: 'email',
+        value: email,
+        message: 'A valid email address is required.'
+      });
+    }
+    if (!topic) {
+      validationErrors.push({
+        field: 'topic',
+        value: topic,
+        message: 'Feedback topic is required.'
+      });
+    }
+    if (!message || message.length < 5) {
+      validationErrors.push({
+        field: 'message',
+        value: message,
+        message: 'Message must be at least 5 characters long.'
+      });
+    }
+
+    if (validationErrors.length > 0) {
+      if (e.agentInvoked && typeof e.respondWith === 'function') {
+        e.respondWith(Promise.resolve(validationErrors));
+      }
+      return;
+    }
+
+    const ticketId = 'FB-' + Math.floor(10000 + Math.random() * 90000);
+    const feedbackResult = {
+      ticket_id: ticketId,
+      status: 'submitted',
+      topic,
+      customer_name: name,
+      message: `Thank you ${name}! Your feedback regarding '${topic}' has been received (Ticket ${ticketId}). Our team will follow up at ${email}.`
+    };
+
+    const feedbackNotice = document.getElementById('feedback-notice');
+    if (feedbackNotice) {
+      feedbackNotice.innerHTML = `
+        <div class="alert alert-success">
+          <strong>Thank you, ${name}!</strong> Your feedback (Ticket #${ticketId}) has been received.
+        </div>
+      `;
+    }
+
+    feedbackForm.reset();
+
+    if (e.agentInvoked && typeof e.respondWith === 'function') {
+      e.respondWith(Promise.resolve(feedbackResult));
+    }
+  });
+}
+
+// Modal closing
+if (closeOrderModalBtn && orderModal) {
+  closeOrderModalBtn.addEventListener('click', () => {
+    orderModal.close();
+  });
+}
+
+// Helper render functions
+function renderMenuItems(items) {
+  if (!menuContainer) return;
+  if (items.length === 0) {
+    menuContainer.innerHTML = '<p class="no-results">No menu items match your search.</p>';
+    return;
+  }
+  menuContainer.innerHTML = items.map((item) => `
+    <div class="card menu-card" data-id="${item.id}">
+      <img src="${item.image}" alt="${item.name}" class="card-img" loading="lazy" />
+      <div class="card-body">
+        <div class="card-header-flex">
+          <h3>${item.name}</h3>
+          <span class="price-tag">$${item.price.toFixed(2)}</span>
+        </div>
+        <p class="desc">${item.description}</p>
+        <div class="tags">
+          <span class="tag tag-cat">${item.category}</span>
+          <span class="tag tag-diet">${item.dietary}</span>
+        </div>
+        <button class="btn btn-secondary select-for-order-btn" data-item="${item.name}">Select for Order</button>
+      </div>
+    </div>
+  `).join('');
+
+  // Quick fill order form
+  menuContainer.querySelectorAll('.select-for-order-btn').forEach((btn) => {
+    btn.addEventListener('click', () => {
+      const itemName = btn.getAttribute('data-item');
+      const itemInput = document.getElementById('orderItemInput');
+      if (itemInput) {
+        itemInput.value = itemName;
+        document.getElementById('order')?.scrollIntoView({ behavior: 'smooth' });
+      }
+    });
+  });
+}
+
+function renderLocations(locations) {
+  if (!locationsContainer) return;
+  if (locations.length === 0) {
+    locationsContainer.innerHTML = '<p class="no-results">No coffee shops match your criteria.</p>';
+    return;
+  }
+  locationsContainer.innerHTML = locations.map((loc) => `
+    <div class="card location-card" data-id="${loc.id}">
+      <img src="${loc.image}" alt="${loc.name}" class="card-img" loading="lazy" />
+      <div class="card-body">
+        <h3>${loc.name}</h3>
+        <p class="address">📍 ${loc.address}</p>
+        <p class="phone">📞 ${loc.phone}</p>
+        <p class="hours">⏰ ${loc.hours}</p>
+        <div class="tags">
+          ${loc.amenities.map((a) => `<span class="tag">${a.replace('_', ' ')}</span>`).join('')}
+        </div>
+      </div>
+    </div>
+  `).join('');
+}
