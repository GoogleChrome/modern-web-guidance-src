+const CSP_POLICY = "default-src 'self'; img-src 'self' https://images.unsplash.com https: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' https: data:; connect-src 'self'; report-to csp-endpoint; report-uri /csp-report;";
