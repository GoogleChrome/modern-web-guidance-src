+const SECURITY_HEADERS = {
+  'Content-Security-Policy': CSP_POLICY,
+  'Content-Security-Policy-Report-Only': CSP_POLICY,
+  'Reporting-Endpoints': 'csp-endpoint="/csp-report", default="/csp-report"',
+  'Report-To': JSON.stringify({
+    group: 'csp-endpoint',
+    max_age: 10886400,
+    endpoints: [{ url: '/csp-report' }]
+  }),
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'Strict-Transport-Security': 'max-age=31536000; includeSubDomains',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=()'
+};
+
 const server = http.createServer((req, res) => {
   const parsedUrl = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
   const pathname = parsedUrl.pathname;
 
+  // Handle CSP violation reporting endpoints
+  if (pathname === '/csp-report' || pathname === '/csp-report/' || pathname === '/api/csp-report' || pathname === '/reports') {
+    if (req.method === 'OPTIONS') {
+      res.writeHead(204, {
+        'Access-Control-Allow-Origin': '*',
+        'Access-Control-Allow-Methods': 'POST, OPTIONS',
+        'Access-Control-Allow-Headers': 'Content-Type, Content-Security-Policy'
+      });
+      res.end();
+      return;
+    }
+
+    if (req.method === 'POST') {
+      let body = '';
+      req.on('data', chunk => {
+        body += chunk;
+      });
+      req.on('end', () => {
+        try {
+          const report = JSON.parse(body);
+          console.log('[CSP Violation Report Received]:', JSON.stringify(report, null, 2));
+        } catch {
+          console.log('[CSP Violation Report Received (raw)]:', body);
+        }
+        res.writeHead(204, {
+          'Access-Control-Allow-Origin': '*',
+          'Content-Type': 'application/json'
+        });
+        res.end();
+      });
+      return;
+    }
+
+    res.writeHead(405, { 'Content-Type': 'text/plain', Allow: 'POST, OPTIONS' });
+    res.end('Method Not Allowed');
+    return;
+  }
+
+  // Handle logout
   if (pathname === '/logout' || pathname === '/logout/') {
-    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
