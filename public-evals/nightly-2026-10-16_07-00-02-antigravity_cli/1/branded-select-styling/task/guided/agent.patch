+    /* Coffee Roast Selector */
+    .roast-selector-wrapper {
+      margin: 1.25rem 0 0.5rem;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.4rem;
+    }
+
+    .roast-selector-wrapper label {
+      font-size: 0.95rem;
+      font-weight: 500;
+      color: #fafafa;
+      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
+    }
+
+    .roast-select {
+      appearance: base-select;
+      background-color: #4e342e;
+      color: #fafafa;
+      border: 2px solid #ffab40;
+      border-radius: 6px;
+      padding: 0.5rem 1rem;
+      font-size: 1rem;
+      font-family: inherit;
+      cursor: pointer;
+      min-width: 160px;
+      outline: none;
+      transition: border-color 0.2s, box-shadow 0.2s;
+    }
+
+    .roast-select:focus-visible {
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.4);
+    }
+
+    .roast-select button {
+      background: transparent;
+      border: none;
+      color: inherit;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    /* Style the dropdown options list */
+    .roast-select::picker(select) {
+      appearance: base-select;
+      background-color: #4e342e;
+      border: 2px solid #ffab40;
+      border-radius: 6px;
+      padding: 0.5rem;
+      color: #fafafa;
+      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.35);
+    }
+
+    /* Arrow icon matching the palette */
+    .roast-select::picker-icon {
+      color: #ffab40;
+    }
+
+    /* Checkmark matching the palette */
+    .roast-select option::checkmark {
+      color: #ffab40;
+    }
+
+    /* Option items */
+    .roast-select option {
+      padding: 0.5rem 0.75rem;
+      border-radius: 4px;
+      color: #fafafa;
+      background-color: #4e342e;
+      cursor: pointer;
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus {
+      background-color: #ffab40;
+      color: #4e342e;
+    }
+
+    .roast-select option:hover::checkmark,
+    .roast-select option:focus::checkmark {
+      color: #4e342e;
+    }
+
+    .roast-select option:checked {
+      color: #ffab40;
+      font-weight: 600;
+    }
+
+    .roast-select option:checked:hover,
+    .roast-select option:checked:focus {
+      color: #4e342e;
+    }
+
