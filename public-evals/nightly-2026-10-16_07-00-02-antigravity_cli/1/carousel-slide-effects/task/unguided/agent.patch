+    /* Horizontal Carousel Section */
+    .carousel-section {
+      margin-bottom: 60px;
+    }
+
+    .carousel-header {
+      text-align: center;
+      margin-bottom: 24px;
+    }
+
+    .carousel-header h2 {
+      font-size: 2.2rem;
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .carousel-header p {
+      color: #6d4c41;
+      font-size: 1.05rem;
+    }
+
+    :root {
+      --carousel-card-width: clamp(260px, 75vw, 320px);
+    }
+
+    .scroller {
+      display: flex;
+      gap: 24px;
+      overflow-x: auto;
+      overflow-y: hidden;
+      scroll-snap-type: x mandatory;
+      scroll-behavior: smooth;
+      -webkit-overflow-scrolling: touch;
+      padding-block: 40px;
+      padding-inline: calc(50% - (var(--carousel-card-width) / 2));
+      scrollbar-width: thin;
+      scrollbar-color: var(--accent) var(--secondary);
+    }
+
+    .scroller::-webkit-scrollbar {
+      height: 8px;
+    }
+
+    .scroller::-webkit-scrollbar-track {
+      background: var(--secondary);
+      border-radius: 4px;
+    }
+
+    .scroller::-webkit-scrollbar-thumb {
+      background: var(--accent);
+      border-radius: 4px;
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+      border-radius: 8px;
+    }
+
+    .scroller .product-card {
+      flex: 0 0 var(--carousel-card-width);
+      width: var(--carousel-card-width);
+      scroll-snap-align: center;
+      scroll-snap-stop: normal;
+      background: white;
+      padding: 24px;
+      border-radius: 12px;
+      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
+      text-align: center;
+      display: flex;
+      flex-direction: column;
+      box-sizing: border-box;
+      will-change: transform, opacity;
+      transform-origin: center center;
+    }
+
+    .scroller .product-card:focus-within {
+      outline: 2px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .scroller .product-card img {
+      width: 100%;
+      height: 180px;
+      object-fit: cover;
+      border-radius: 8px;
+      margin-bottom: 14px;
+    }
+
+    .product-tag {
+      display: inline-block;
+      font-size: 0.75rem;
+      font-weight: 700;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+      color: var(--accent);
+      margin-bottom: 6px;
+    }
+
+    .scroller .product-card h3 {
+      font-size: 1.3rem;
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .product-desc {
+      font-size: 0.9rem;
+      color: #5d4037;
+      margin-bottom: 14px;
+      flex-grow: 1;
+    }
+
+    .product-price {
+      font-size: 1.25rem;
+      font-weight: bold;
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    /* Pure CSS Scroll-Driven Center Scaling */
+    @supports ((animation-timeline: view(inline)) or (animation-timeline: view())) {
+      .scroller .product-card {
+        animation: scale-center linear both;
+        animation-timeline: view(inline);
+        animation-range: cover 0% cover 100%;
+      }
+    }
+
+    @keyframes scale-center {
+      0% {
+        transform: scale(0.85);
+        opacity: 0.7;
+      }
+      50% {
+        transform: scale(1.1);
+        opacity: 1;
+      }
+      100% {
+        transform: scale(0.85);
+        opacity: 0.7;
+      }
+    }
+
+    /* Accessibility: Respect reduced motion preferences */
+    @media (prefers-reduced-motion: reduce) {
+      .scroller {
+        scroll-behavior: auto;
+      }
+
+      .scroller .product-card {
+        animation: none !important;
+        transform: none !important;
+        opacity: 1 !important;
+      }
+    }
+
