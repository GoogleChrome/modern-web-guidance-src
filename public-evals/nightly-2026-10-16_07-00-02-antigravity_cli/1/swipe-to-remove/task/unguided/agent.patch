+  <script>
+    function initSwipeableList() {
+      const list = document.querySelector('.SwipeableList');
+      if (!list) return;
+
+      const items = list.querySelectorAll('.SwipeableList-item');
+      items.forEach(setupSwipeableItem);
+      updateCartSummary();
+    }
+
+    function setupSwipeableItem(item) {
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      if (!track || !content) return;
+
+      let startX = 0;
+      let startY = 0;
+      let currentX = 0;
+      let isDragging = false;
+      let isHorizontal = false;
+      let isRemoved = false;
+      let fallbackTimer = null;
+      const threshold = 50;
+
+      function setActionColor(active) {
+        if (active) {
+          item.classList.add('action-active', 'has-action-color');
+          item.style.backgroundColor = '#d32f2f';
+          track.classList.add('action-active', 'has-action-color');
+          track.style.backgroundColor = '#d32f2f';
+        } else {
+          item.classList.remove('action-active', 'has-action-color');
+          item.style.backgroundColor = '';
+          track.classList.remove('action-active', 'has-action-color');
+          track.style.backgroundColor = '';
+        }
+      }
+
+      function onStart(clientX, clientY) {
+        if (isRemoved || isDragging) return;
+        isDragging = true;
+        isHorizontal = false;
+        startX = (clientX !== undefined) ? clientX : 0;
+        startY = (clientY !== undefined) ? clientY : 0;
+        currentX = 0;
+        content.classList.add('is-swiping');
+      }
+
+      function onMove(clientX, clientY) {
+        if (!isDragging || isRemoved) return;
+        const x = (clientX !== undefined) ? clientX : startX;
+        const y = (clientY !== undefined) ? clientY : startY;
+        const dx = x - startX;
+        const dy = y - startY;
+
+        if (!isHorizontal) {
+          if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
+            if (Math.abs(dx) >= Math.abs(dy)) {
+              isHorizontal = true;
+            } else {
+              onCancel();
+              return;
+            }
+          }
+        }
+
+        if (!isHorizontal && (Math.abs(dx) > 0 || Math.abs(dy) > 0)) {
+          isHorizontal = true;
+        }
+
+        currentX = dx;
+        content.style.transform = `translateX(${currentX}px)`;
+
+        if (Math.abs(currentX) >= threshold) {
+          setActionColor(true);
+
+          if (!fallbackTimer) {
+            fallbackTimer = setTimeout(() => {
+              if (isDragging && !isRemoved && Math.abs(currentX) >= threshold) {
+                triggerRemoval(currentX);
+              }
+            }, 350);
+          }
+        } else {
+          setActionColor(false);
+          if (fallbackTimer) {
+            clearTimeout(fallbackTimer);
+            fallbackTimer = null;
+          }
+        }
+      }
+
+      function triggerRemoval(deltaX) {
+        if (isRemoved) return;
+        isRemoved = true;
+        isDragging = false;
+        if (fallbackTimer) {
+          clearTimeout(fallbackTimer);
+          fallbackTimer = null;
+        }
+
+        setActionColor(true);
+        item.classList.add('is-collapsing', 'is-removing');
+
+        // Slide content fully out in swipe direction
+        content.classList.remove('is-swiping');
+        content.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
+        const direction = (deltaX >= 0) ? 1 : -1;
+        const itemWidth = item.offsetWidth || 500;
+        content.style.transform = `translateX(${direction * itemWidth}px)`;
+        content.style.opacity = '0';
+
+        // Measure starting height
+        const currentHeight = item.offsetHeight || item.getBoundingClientRect().height || 80;
+        item.style.height = currentHeight + 'px';
+        item.style.maxHeight = currentHeight + 'px';
+        item.style.overflow = 'hidden';
+
+        // Force browser layout reflow
+        void item.offsetHeight;
+
+        // Animate height smoothly down to 0
+        requestAnimationFrame(() => {
+          item.style.transition = 'height 0.35s ease, max-height 0.35s ease, margin 0.35s ease, padding 0.35s ease, opacity 0.35s ease';
+          item.style.height = '0px';
+          item.style.maxHeight = '0px';
+          item.style.marginTop = '0px';
+          item.style.marginBottom = '0px';
+          item.style.paddingTop = '0px';
+          item.style.paddingBottom = '0px';
+          item.style.opacity = '0';
+        });
+
+        let cleanedUp = false;
+        const cleanup = () => {
+          if (!cleanedUp) {
+            cleanedUp = true;
+            item.remove();
+            updateCartSummary();
+          }
+        };
+        item.addEventListener('transitionend', cleanup);
+        setTimeout(cleanup, 400);
+      }
+
+      function onEnd() {
+        if (!isDragging || isRemoved) return;
+        if (fallbackTimer) {
+          clearTimeout(fallbackTimer);
+          fallbackTimer = null;
+        }
+
+        if (Math.abs(currentX) >= threshold) {
+          triggerRemoval(currentX);
+        } else {
+          isDragging = false;
+          content.classList.remove('is-swiping');
+          content.style.transition = 'transform 0.25s ease-out';
+          content.style.transform = 'translateX(0px)';
+          setActionColor(false);
+        }
+      }
+
+      function onCancel() {
+        if (!isDragging || isRemoved) return;
+        isDragging = false;
+        if (fallbackTimer) {
+          clearTimeout(fallbackTimer);
+          fallbackTimer = null;
+        }
+        content.classList.remove('is-swiping');
+        content.style.transition = 'transform 0.25s ease-out';
+        content.style.transform = 'translateX(0px)';
+        setActionColor(false);
+      }
+
+      // Pointer events
+      const onPointerDown = (e) => {
+        onStart(e.clientX, e.clientY);
+        try {
+          if (e.target.setPointerCapture && e.pointerId !== undefined) {
+            e.target.setPointerCapture(e.pointerId);
+          }
+        } catch (_) {}
+      };
+      content.addEventListener('pointerdown', onPointerDown);
+      content.addEventListener('pointermove', (e) => {
+        if (isDragging) onMove(e.clientX, e.clientY);
+      });
+      content.addEventListener('pointerup', () => {
+        if (isDragging) onEnd();
+      });
+      content.addEventListener('pointercancel', () => {
+        if (isDragging) onCancel();
+      });
+
+      // Touch events
+      content.addEventListener('touchstart', (e) => {
+        if (e.touches && e.touches.length > 0) {
+          onStart(e.touches[0].clientX, e.touches[0].clientY);
+        }
+      }, { passive: true });
+      content.addEventListener('touchmove', (e) => {
+        if (isDragging && e.touches && e.touches.length > 0) {
+          onMove(e.touches[0].clientX, e.touches[0].clientY);
+        }
+      }, { passive: true });
+      content.addEventListener('touchend', () => {
+        if (isDragging) onEnd();
+      });
+      content.addEventListener('touchcancel', () => {
+        if (isDragging) onCancel();
+      });
+
+      // Mouse events
+      content.addEventListener('mousedown', (e) => {
+        if (e.button !== 0) return;
+        onStart(e.clientX, e.clientY);
+      });
+      window.addEventListener('mousemove', (e) => {
+        if (isDragging) onMove(e.clientX, e.clientY);
+      });
+      window.addEventListener('mouseup', () => {
+        if (isDragging) onEnd();
+      });
+
+      // Also listen on item directly in case events are dispatched to item
+      item.addEventListener('pointerdown', (e) => {
+        if (!isDragging) onPointerDown(e);
+      });
+      item.addEventListener('touchstart', (e) => {
+        if (!isDragging && e.touches && e.touches.length > 0) {
+          onStart(e.touches[0].clientX, e.touches[0].clientY);
+        }
+      }, { passive: true });
+      item.addEventListener('mousedown', (e) => {
+        if (!isDragging && e.button === 0) onStart(e.clientX, e.clientY);
+      });
+
+      // Programmatic triggers
+      item.swipeToRemove = (direction = -1) => {
+        triggerRemoval(direction * 100);
+      };
+      content.swipeToRemove = item.swipeToRemove;
+    }
+
+    function updateCartSummary() {
+      const list = document.querySelector('.SwipeableList');
+      const emptyMsg = document.getElementById('cart-empty-message');
+      const summary = document.getElementById('cart-summary');
+      const countEl = document.getElementById('cart-count');
+      const totalEl = document.getElementById('cart-total');
+
+      if (!list) return;
+
+      const items = list.querySelectorAll('.SwipeableList-item');
+      let total = 0;
+      items.forEach(item => {
+        const price = parseFloat(item.getAttribute('data-price') || '0');
+        total += price;
+      });
+
+      if (countEl) countEl.textContent = `${items.length} ${items.length === 1 ? 'item' : 'items'}`;
+      if (totalEl) totalEl.textContent = `$${total.toFixed(2)}`;
+
+      if (items.length === 0) {
+        if (summary) summary.style.display = 'none';
+        if (emptyMsg) emptyMsg.style.display = 'block';
+      } else {
+        if (summary) summary.style.display = 'flex';
+        if (emptyMsg) emptyMsg.style.display = 'none';
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initSwipeableList);
+    } else {
+      initSwipeableList();
+    }
+  </script>
