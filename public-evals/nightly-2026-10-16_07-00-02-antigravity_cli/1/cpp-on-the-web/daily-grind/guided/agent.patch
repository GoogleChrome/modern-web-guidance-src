+      // Parse configuration
+      const [wStr, hStr] = selectResolution.value.split('x');
+      const width = parseInt(wStr, 10);
+      const height = parseInt(hStr, 10);
+      const samps = parseInt(selectSamples.value, 10);
+      const mode = parseInt(selectAlgorithm.value, 10);
 
+      ModuleInstance._set_sampling_mode(mode);
+      ModuleInstance._init_renderer(width, height);
+
+      canvas.width = width;
+      canvas.height = height;
+      const imgData = ctx.createImageData(width, height);
+      const rgbaPtr = ModuleInstance._get_rgba_buffer();
+
+      // UI State: rendering
+      statusDot.className = 'status-dot busy';
+      statusBadgeText.textContent = 'Rendering';
+      btnRandomize.disabled = true;
+      btnRerun.disabled = true;
+      btnReset.disabled = true;
+
+      const startTime = performance.now();
+      const batchSize = Math.max(2, Math.floor(height / 20));
+
+      for (let y = 0; y < height; y += batchSize) {
+        if (shouldAbort) break;
+
+        const count = Math.min(batchSize, height - y);
+        ModuleInstance._render_rows(y, count, samps);
+
+        // Update canvas display
+        const wasmBytes = ModuleInstance.HEAPU8.subarray(rgbaPtr, rgbaPtr + width * height * 4);
+        imgData.data.set(wasmBytes);
+        ctx.putImageData(imgData, 0, 0);
+
+        const doneRows = y + count;
+        const pct = Math.round((doneRows / height) * 100);
+        progressBar.style.width = `${pct}%`;
+        statusLabel.textContent = `Rendering: ${pct}% (Row ${doneRows}/${height} • ${samps * 4} spp)`;
+
+        // Yield to browser UI thread
+        await new Promise(r => requestAnimationFrame(r));
+      }
+
+      const elapsed = Math.round(performance.now() - startTime);
+      const totalRays = width * height * samps * 4;
+
+      if (!shouldAbort) {
+        progressBar.style.width = '100%';
+        statusLabel.textContent = `Completed in ${elapsed}ms (${width}×${height}, ${samps * 4} spp, ${totalRays.toLocaleString()} rays)`;
+        statusDot.className = 'status-dot';
+        statusBadgeText.textContent = 'Ready';
+      }
+
+      btnRandomize.disabled = false;
+      btnRerun.disabled = false;
+      btnReset.disabled = false;
+      isRendering = false;
+    }
+
+    // Button event handlers
+    btnRandomize.addEventListener('click', () => {
+      runPathTracer({ randomize: true });
+    });
+
+    btnRerun.addEventListener('click', () => {
+      runPathTracer();
+    });
+
+    btnReset.addEventListener('click', () => {
+      runPathTracer({ reset: true });
+    });
+
+    selectSamples.addEventListener('change', () => runPathTracer());
+    selectResolution.addEventListener('change', () => runPathTracer());
+    selectAlgorithm.addEventListener('change', () => runPathTracer());
+
+    // Initialize WebAssembly module
+    createSmallptModule().then(Module => {
+      ModuleInstance = Module;
+      statusLabel.textContent = 'WebAssembly loaded. Starting initial render...';
+      statusBadgeText.textContent = 'Ready';
+      statusDot.className = 'status-dot';
+      btnRandomize.disabled = false;
+      btnRerun.disabled = false;
+      btnReset.disabled = false;
+
+      updateColorSwatches();
+      runPathTracer();
+    }).catch(err => {
+      console.error('Failed to load smallpt WebAssembly module:', err);
+      statusLabel.textContent = 'Error loading WebAssembly module: ' + err.message;
+      statusDot.className = 'status-dot busy';
+      statusBadgeText.textContent = 'Error';
+    });
+  </script>
+
+</body>
 </html>
