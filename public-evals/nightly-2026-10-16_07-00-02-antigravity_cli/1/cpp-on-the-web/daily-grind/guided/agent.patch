+#include <math.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+#include <emscripten.h>
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+#ifndef M_1_PI
+#define M_1_PI 0.31830988618379067154
+#endif
+
+struct Vec {
+  double x, y, z;
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1.0/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; }
+  Vec operator%(const Vec &b) const { return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x); }
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+  double rad;
+  Vec p, e, c;
+  Refl_t refl;
+  Sphere(double rad_=0, Vec p_=Vec(), Vec e_=Vec(), Vec c_=Vec(), Refl_t refl_=DIFF):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const {
+    Vec op = p-r.o;
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+
+static const Sphere default_spheres[] = {
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF), // 0: Left wall (red)
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF), // 1: Right wall (blue)
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF), // 2: Back wall (white)
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF), // 3: Front wall (black)
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF), // 4: Bottom
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF), // 5: Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC), // 6: Mirror sphere
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR), // 7: Glass sphere
+  Sphere(1.5, Vec(50,81.6-16.5,81.6),Vec(4,4,4)*100, Vec(), DIFF) // 8: Light (explicit default)
+};
+
+static const int NUM_SPHERES = sizeof(default_spheres) / sizeof(Sphere);
+static Sphere spheres[NUM_SPHERES];
+
+static int sampling_mode = 1; // 1 = explicit light sampling, 0 = pure path tracing
+
+static inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+static inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+
+static inline bool intersect(const Ray &r, double &t, int &id){
+  double d, inf=t=1e20;
+  for(int i=NUM_SPHERES;i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+
+static Vec radiance(const Ray &r, int depth, unsigned short *Xi, int E = 1){
+  double t;
+  int id = 0;
+  if (!intersect(r, t, id)) return Vec();
+  const Sphere &obj = spheres[id];
+  Vec x = r.o + r.d * t, n = (x - obj.p).norm(), nl = n.dot(r.d) < 0 ? n : n * -1, f = obj.c;
+  double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z;
+  if (++depth > 5 || !p) {
+    if (erand48(Xi) < p) f = f * (1.0 / p);
+    else return obj.e * E;
+  }
+  if (obj.refl == DIFF) {
+    double r1 = 2 * M_PI * erand48(Xi), r2 = erand48(Xi), r2s = sqrt(r2);
+    Vec w = nl, u = ((fabs(w.x) > .1 ? Vec(0, 1) : Vec(1)) % w).norm(), v = w % u;
+    Vec d = (u * cos(r1) * r2s + v * sin(r1) * r2s + w * sqrt(1 - r2)).norm();
+
+    if (sampling_mode == 1) {
+      // Explicit light sampling
+      Vec e;
+      for (int i = 0; i < NUM_SPHERES; i++) {
+        const Sphere &s = spheres[i];
+        if (s.e.x <= 0 && s.e.y <= 0 && s.e.z <= 0) continue;
+        Vec sw = s.p - x;
+        double dist2 = (x - s.p).dot(x - s.p);
+        if (s.rad * s.rad >= dist2) continue;
+        Vec su = ((fabs(sw.x) > .1 ? Vec(0, 1) : Vec(1)) % sw).norm(), sv = sw % su;
+        double cos_a_max = sqrt(1.0 - s.rad * s.rad / dist2);
+        double eps1 = erand48(Xi), eps2 = erand48(Xi);
+        double cos_a = 1.0 - eps1 + eps1 * cos_a_max;
+        double sin_a = sqrt(fmax(0.0, 1.0 - cos_a * cos_a));
+        double phi = 2 * M_PI * eps2;
+        Vec l = su * cos(phi) * sin_a + sv * sin(phi) * sin_a + sw * cos_a;
+        l.norm();
+        double st;
+        int sid;
+        if (intersect(Ray(x, l), st, sid) && sid == i) {
+          double omega = 2 * M_PI * (1.0 - cos_a_max);
+          double dot_nl = l.dot(nl);
+          if (dot_nl > 0) {
+            e = e + f.mult(s.e * dot_nl * omega) * M_1_PI;
+          }
+        }
+      }
+      return obj.e * E + e + f.mult(radiance(Ray(x, d), depth, Xi, 0));
+    } else {
+      // Pure Monte Carlo path tracing
+      return obj.e + f.mult(radiance(Ray(x, d), depth, Xi));
+    }
+  } else if (obj.refl == SPEC) {
+    return obj.e + f.mult(radiance(Ray(x, r.d - n * 2 * n.dot(r.d)), depth, Xi));
+  }
+  Ray reflRay(x, r.d - n * 2 * n.dot(r.d));
+  bool into = n.dot(nl) > 0;
+  double nc = 1, nt = 1.5, nnt = into ? nc / nt : nt / nc, ddn = r.d.dot(nl), cos2t;
+  if ((cos2t = 1 - nnt * nnt * (1 - ddn * ddn)) < 0)
+    return obj.e + f.mult(radiance(reflRay, depth, Xi));
+  Vec tdir = (r.d * nnt - n * ((into ? 1 : -1) * (ddn * nnt + sqrt(cos2t)))).norm();
+  double a = nt - nc, b = nt + nc, R0 = a * a / (b * b), c = 1 - (into ? -ddn : tdir.dot(n));
+  double Re = R0 + (1 - R0) * c * c * c * c * c, Tr = 1 - Re, P = .25 + .5 * Re, RP = Re / P, TP = Tr / (1 - P);
+  return obj.e + f.mult(depth > 2 ? (erand48(Xi) < P ?
+    radiance(reflRay, depth, Xi) * RP : radiance(Ray(x, tdir), depth, Xi) * TP) :
+    radiance(reflRay, depth, Xi) * Re + radiance(Ray(x, tdir), depth, Xi) * Tr);
+}
+
+// Global renderer state
+static int img_w = 0;
+static int img_h = 0;
+static uint8_t *rgba_buffer = nullptr;
+static Vec *accum_buffer = nullptr;
+
+static Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+static Vec cx, cy;
+
+static double rnd_unit() {
+  return (double)rand() / (double)RAND_MAX;
+}
+
+static void update_light_for_mode() {
+  if (sampling_mode == 1) {
+    // Explicit light sampling: smaller sphere just below ceiling
+    spheres[8] = Sphere(1.5, Vec(50, 81.6 - 16.5, 81.6), Vec(4, 4, 4) * 100, Vec(), DIFF);
+  } else {
+    // Original smallpt: 600 radius sphere poking through ceiling
+    spheres[8] = Sphere(600, Vec(50, 681.6 - .27, 81.6), Vec(12, 12, 12), Vec(), DIFF);
+  }
+}
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+void reset_sphere_colors() {
+  for (int i = 0; i < NUM_SPHERES; i++) {
+    spheres[i] = default_spheres[i];
+  }
+  update_light_for_mode();
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sampling_mode(int mode) {
+  sampling_mode = mode ? 1 : 0;
+  update_light_for_mode();
+}
+
+EMSCRIPTEN_KEEPALIVE
+int get_sampling_mode() {
+  return sampling_mode;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int init_renderer(int w, int h) {
+  if (w <= 0 || h <= 0) return 0;
+  img_w = w;
+  img_h = h;
+
+  delete[] rgba_buffer;
+  delete[] accum_buffer;
+
+  rgba_buffer = new uint8_t[w * h * 4];
+  accum_buffer = new Vec[w * h];
+
+  memset(rgba_buffer, 0, w * h * 4);
+  for (int i = 0; i < w * h; i++) {
+    accum_buffer[i] = Vec(0, 0, 0);
+  }
+
+  cx = Vec(w * .5135 / h);
+  cy = (cx % cam.d).norm() * .5135;
+
+  reset_sphere_colors();
+  return 1;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* get_rgba_buffer() {
+  return rgba_buffer;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int get_width() {
+  return img_w;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int get_height() {
+  return img_h;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void render_row(int y, int samps) {
+  if (!rgba_buffer || !accum_buffer || y < 0 || y >= img_h) return;
+  if (samps < 1) samps = 1;
+
+  Vec r;
+  for (unsigned short x = 0, Xi[3] = {0, 0, (unsigned short)(y * y * y)}; x < img_w; x++) {
+    int i = (img_h - y - 1) * img_w + x;
+    accum_buffer[i] = Vec(0, 0, 0);
+    for (int sy = 0; sy < 2; sy++) {
+      for (int sx = 0; sx < 2; sx++, r = Vec()) {
+        for (int s = 0; s < samps; s++) {
+          double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+          double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+          Vec d = cx * (((sx + .5 + dx) / 2 + x) / img_w - .5) +
+                  cy * (((sy + .5 + dy) / 2 + y) / img_h - .5) + cam.d;
+          r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1. / samps);
+        }
+        accum_buffer[i] = accum_buffer[i] + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+      }
+    }
+    rgba_buffer[i * 4 + 0] = toInt(accum_buffer[i].x);
+    rgba_buffer[i * 4 + 1] = toInt(accum_buffer[i].y);
+    rgba_buffer[i * 4 + 2] = toInt(accum_buffer[i].z);
+    rgba_buffer[i * 4 + 3] = 255;
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+void render_rows(int start_y, int count, int samps) {
+  for (int i = 0; i < count; i++) {
+    int y = start_y + i;
+    if (y >= 0 && y < img_h) {
+      render_row(y, samps);
+    }
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+void render_all(int samps) {
+  for (int y = 0; y < img_h; y++) {
+    render_row(y, samps);
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors() {
+  // Randomize mirror sphere (6) and glass sphere (7)
+  // Vibrant tints for mirror and glass
+  spheres[6].c = Vec(0.25 + 0.70 * rnd_unit(), 0.25 + 0.70 * rnd_unit(), 0.25 + 0.70 * rnd_unit()) * 0.95;
+  spheres[7].c = Vec(0.25 + 0.70 * rnd_unit(), 0.25 + 0.70 * rnd_unit(), 0.25 + 0.70 * rnd_unit()) * 0.95;
+
+  // Randomize walls (0: Left, 1: Right, 2: Back)
+  spheres[0].c = Vec(0.25 + 0.70 * rnd_unit(), 0.05 + 0.35 * rnd_unit(), 0.05 + 0.35 * rnd_unit());
+  spheres[1].c = Vec(0.05 + 0.35 * rnd_unit(), 0.15 + 0.65 * rnd_unit(), 0.30 + 0.65 * rnd_unit());
+  spheres[2].c = Vec(0.35 + 0.55 * rnd_unit(), 0.35 + 0.55 * rnd_unit(), 0.35 + 0.55 * rnd_unit());
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int id, double r, double g, double b) {
+  if (id >= 0 && id < NUM_SPHERES) {
+    spheres[id].c = Vec(r, g, b);
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+void get_sphere_color(int id, double *out_rgb) {
+  if (id >= 0 && id < NUM_SPHERES && out_rgb) {
+    out_rgb[0] = spheres[id].c.x;
+    out_rgb[1] = spheres[id].c.y;
+    out_rgb[2] = spheres[id].c.z;
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+int get_sphere_count() {
+  return NUM_SPHERES;
+}
+
+}
