+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+
+// Original Cornell Box scene spheres
+static const Sphere default_spheres[] = {
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF), // 0: Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF), // 1: Right
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF), // 2: Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF), // 3: Front
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF), // 4: Bottom
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF), // 5: Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC), // 6: Mirror sphere
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR), // 7: Glass sphere
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF)  // 8: Light
+};
+
+static Sphere spheres[9] = {
+  default_spheres[0], default_spheres[1], default_spheres[2],
+  default_spheres[3], default_spheres[4], default_spheres[5],
+  default_spheres[6], default_spheres[7], default_spheres[8]
+};
+
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+
+inline bool intersect(const Ray &r, double &t, int &id){
