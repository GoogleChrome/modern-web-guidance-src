+  // Mirror sphere (index 6): specular color
+  spheres[6].c = Vec(0.2 + 0.75 * rnd01(), 0.2 + 0.75 * rnd01(), 0.2 + 0.75 * rnd01());
+
+  // Glass sphere (index 7): refractive color tint
+  spheres[7].c = Vec(0.2 + 0.75 * rnd01(), 0.2 + 0.75 * rnd01(), 0.2 + 0.75 * rnd01());
+
+  // Left wall (index 0): vibrant diffuse color
+  spheres[0].c = Vec(0.15 + 0.75 * rnd01(), 0.15 + 0.75 * rnd01(), 0.15 + 0.75 * rnd01());
+
+  // Right wall (index 1): vibrant diffuse color
+  spheres[1].c = Vec(0.15 + 0.75 * rnd01(), 0.15 + 0.75 * rnd01(), 0.15 + 0.75 * rnd01());
+
+  // Back wall (index 2): diffuse color
+  spheres[2].c = Vec(0.15 + 0.75 * rnd01(), 0.15 + 0.75 * rnd01(), 0.15 + 0.75 * rnd01());
+
+  // Floor (index 4)
+  spheres[4].c = Vec(0.15 + 0.75 * rnd01(), 0.15 + 0.75 * rnd01(), 0.15 + 0.75 * rnd01());
+
+  // Ceiling (index 5)
+  spheres[5].c = Vec(0.15 + 0.75 * rnd01(), 0.15 + 0.75 * rnd01(), 0.15 + 0.75 * rnd01());
+}
+
+EMSCRIPTEN_KEEPALIVE
