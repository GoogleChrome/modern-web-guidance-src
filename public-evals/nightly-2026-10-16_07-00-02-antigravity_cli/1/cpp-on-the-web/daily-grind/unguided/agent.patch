+  <!-- Emscripten Module Setup -->
+  <script>
+    const canvas = document.getElementById('renderCanvas');
+    const ctx = canvas.getContext('2d');
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const renderBtn = document.getElementById('render-btn');
+    const resetBtn = document.getElementById('reset-btn');
+    const resolutionSelect = document.getElementById('resolution-select');
+    const samplesSelect = document.getElementById('samples-select');
+    const progressContainer = document.getElementById('progress-container');
+    const progressBar = document.getElementById('progress-bar');
+    const statusDot = document.getElementById('status-dot');
+    const statusText = document.getElementById('status-text');
+    const swatchesGrid = document.getElementById('swatches-grid');
+
+    let wasmReady = false;
+    let isRendering = false;
+    let renderCancelRequested = false;
+
+    const sphereNames = {
+      0: 'Left Wall',
+      1: 'Right Wall',
+      2: 'Back Wall',
+      4: 'Floor',
+      5: 'Ceiling',
+      6: 'Mirror Ball',
+      7: 'Glass Ball'
+    };
+
+    function rgbToHex(r, g, b) {
+      const toHex = (c) => Math.min(255, Math.max(0, Math.round(c * 255))).toString(16).padStart(2, '0');
+      return `#${toHex(r)}${toHex(g)}${toHex(b)}`;
+    }
+
+    function updateColorSwatches() {
+      if (!wasmReady) return;
+      swatchesGrid.innerHTML = '';
+      for (const [idStr, name] of Object.entries(sphereNames)) {
+        const id = parseInt(idStr, 10);
+        const r = Module._get_sphere_r(id);
+        const g = Module._get_sphere_g(id);
+        const b = Module._get_sphere_b(id);
+        const hex = rgbToHex(r, g, b);
+
+        const card = document.createElement('div');
+        card.className = 'swatch-card';
+        card.innerHTML = `
+          <div class="swatch-color" style="background-color: ${hex}"></div>
+          <div class="swatch-info">
+            <div class="swatch-name">${name}</div>
+            <div class="swatch-hex">${hex}</div>
+          </div>
+        `;
+        swatchesGrid.appendChild(card);
+      }
+    }
+
+    function setStatus(state, message) {
+      statusDot.className = 'status-dot ' + state;
+      statusText.textContent = message;
+    }
+
+    function getSelectedResolution() {
+      const [w, h] = resolutionSelect.value.split('x').map(Number);
+      return { width: w, height: h };
+    }
+
+    function getSelectedSamples() {
+      return parseInt(samplesSelect.value, 10);
+    }
+
+    function renderScene(randomize = false) {
+      if (!wasmReady || isRendering) return;
+      isRendering = true;
+      randomizeBtn.disabled = true;
+      renderBtn.disabled = true;
+      resetBtn.disabled = true;
+
+      if (randomize) {
+        Module._randomize_sphere_colors();
+      }
+      updateColorSwatches();
+
+      const { width, height } = getSelectedResolution();
+      const samps = getSelectedSamples();
 
+      if (canvas.width !== width || canvas.height !== height) {
+        canvas.width = width;
+        canvas.height = height;
+      }
+
+      progressContainer.style.display = 'block';
+      progressBar.style.width = '0%';
+      setStatus('rendering', `Rendering (${width}x${height}, ${samps * 4} spp)...`);
+
+      const startTime = performance.now();
+      Module._init_renderer(width, height);
+      const ptr = Module._get_image_buffer();
+      const imgData = ctx.createImageData(width, height);
+
+      // Render progressively in row chunks so the browser UI stays responsive
+      let y = 0;
+      const rowsPerBatch = Math.max(2, Math.floor(height / 24));
+
+      function processBatch() {
+        const endY = Math.min(y + rowsPerBatch, height);
+        for (; y < endY; y++) {
+          Module._render_row(y, width, height, samps);
+        }
+
+        // Copy RGBA buffer from WASM memory to Canvas ImageData
+        imgData.data.set(Module.HEAPU8.subarray(ptr, ptr + width * height * 4));
+        ctx.putImageData(imgData, 0, 0);
+
+        const pct = Math.round((y / height) * 100);
+        progressBar.style.width = `${pct}%`;
+        setStatus('rendering', `Rendering: ${pct}% (${y}/${height} lines)`);
+
+        if (y < height) {
+          requestAnimationFrame(processBatch);
+        } else {
+          const elapsed = (performance.now() - startTime).toFixed(1);
+          progressContainer.style.display = 'none';
+          setStatus('ready', `Render complete in ${elapsed} ms (${width}x${height}, ${samps * 4} spp)`);
+          isRendering = false;
+          randomizeBtn.disabled = false;
+          renderBtn.disabled = false;
+          resetBtn.disabled = false;
+        }
+      }
+
+      requestAnimationFrame(processBatch);
+    }
+
+    // Button event listeners
+    randomizeBtn.addEventListener('click', () => {
+      renderScene(true);
+    });
+
+    renderBtn.addEventListener('click', () => {
+      renderScene(false);
+    });
+
+    resetBtn.addEventListener('click', () => {
+      if (!wasmReady || isRendering) return;
+      Module._reset_sphere_colors();
+      updateColorSwatches();
+      renderScene(false);
+    });
+
+    resolutionSelect.addEventListener('change', () => {
+      const { width, height } = getSelectedResolution();
+      canvas.width = width;
+      canvas.height = height;
+      renderScene(false);
+    });
+
+    samplesSelect.addEventListener('change', () => {
+      renderScene(false);
+    });
+
+    // Emscripten Module configuration
+    var Module = {
+      onRuntimeInitialized: function() {
+        wasmReady = true;
+        setStatus('ready', 'WebAssembly loaded. Starting render...');
+        updateColorSwatches();
+        // Immediately render the initial scene
+        renderScene(false);
+      },
+      print: function(text) {
+        console.log('[WASM]', text);
+      },
+      printErr: function(text) {
+        console.error('[WASM Error]', text);
+      }
+    };
+
+    // Expose helpers for testing
+    window.Module = Module;
+    window.renderScene = renderScene;
+    window.randomizeColorsAndRender = () => renderScene(true);
+  </script>
+  <script src="smallpt.js"></script>
+</body>
