+#include <cmath>
+#include <cstdlib>
+#include <cstdio>
+#include <cstdint>
+#include <vector>
+#include <emscripten/emscripten.h>
+
+// smallpt: Global Illumination in 99 lines of C++
+// Original by Kevin Beason (http://www.kevinbeason.com/smallpt/)
+// Compiled to WebAssembly for browser execution with customizable sphere colors.
+
+struct Vec {
+  double x, y, z;
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x, y+b.y, z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x, y-b.y, z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b, y*b, z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x, y*b.y, z*b.z); }
+  Vec& norm(){ return *this = *this * (1.0/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x + y*b.y + z*b.z; }
+  Vec operator%(const Vec &b) const { return Vec(y*b.z-z*b.y, z*b.x-x*b.z, x*b.y-y*b.x); }
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+  double rad;
+  Vec p, e, c;
+  Refl_t refl;
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const {
+    Vec op = p - r.o;
+    double t, eps = 1e-4, b = op.dot(r.d), det = b*b - op.dot(op) + rad*rad;
+    if (det < 0) return 0; else det = sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+// Scene objects:
+// 0: Left wall
+// 1: Right wall
+// 2: Back wall
+// 3: Front wall
+// 4: Bottom floor
+// 5: Top ceiling
+// 6: Mirror sphere
+// 7: Glass sphere
+// 8: Light source
+Sphere spheres[] = {
+  Sphere(1e5,  Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),// 0: Left
+  Sphere(1e5,  Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),// 1: Right
+  Sphere(1e5,  Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),// 2: Back
+  Sphere(1e5,  Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),// 3: Front
+  Sphere(1e5,  Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),// 4: Bottom
+  Sphere(1e5,  Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),// 5: Top
+  Sphere(16.5, Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),// 6: Mirror
+  Sphere(16.5, Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),// 7: Glass
+  Sphere(600,  Vec(50,681.6-.27,81.6),Vec(12,12,12), Vec(), DIFF) // 8: Light
+};
+
+const int NUM_SPHERES = sizeof(spheres) / sizeof(Sphere);
+
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x), 1.0/2.2)*255.0 + 0.5); }
+
+inline bool intersect(const Ray &r, double &t, int &id){
+  double d, inf = t = 1e20;
+  for(int i = NUM_SPHERES; i--;) {
+    if((d = spheres[i].intersect(r)) && d < t) {
+      t = d;
+      id = i;
+    }
+  }
+  return t < inf;
+}
+
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t;
+  int id = 0;
+  if (!intersect(r, t, id)) return Vec();
+  const Sphere &obj = spheres[id];
+  Vec x = r.o + r.d * t, n = (x - obj.p).norm(), nl = n.dot(r.d) < 0 ? n : n * -1, f = obj.c;
+  double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z;
+  if (++depth > 5) {
+    if (erand48(Xi) < p) f = f * (1.0 / p);
+    else return obj.e;
+  }
+  if (obj.refl == DIFF){
+    double r1 = 2 * M_PI * erand48(Xi), r2 = erand48(Xi), r2s = sqrt(r2);
+    Vec w = nl, u = ((fabs(w.x) > 0.1 ? Vec(0,1) : Vec(1)) % w).norm(), v = w % u;
+    Vec d = (u * cos(r1) * r2s + v * sin(r1) * r2s + w * sqrt(1 - r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x, d), depth, Xi));
+  } else if (obj.refl == SPEC) {
+    return obj.e + f.mult(radiance(Ray(x, r.d - n * 2 * n.dot(r.d)), depth, Xi));
+  }
+  Ray reflRay(x, r.d - n * 2 * n.dot(r.d));
+  bool into = n.dot(nl) > 0;
+  double nc = 1, nt = 1.5, nnt = into ? nc/nt : nt/nc, ddn = r.d.dot(nl), cos2t;
+  if ((cos2t = 1 - nnt*nnt*(1 - ddn*ddn)) < 0)
+    return obj.e + f.mult(radiance(reflRay, depth, Xi));
+  Vec tdir = (r.d * nnt - n * ((into ? 1 : -1) * (ddn * nnt + sqrt(cos2t)))).norm();
+  double a = nt - nc, b = nt + nc, R0 = a*a/(b*b), c = 1 - (into ? -ddn : tdir.dot(n));
+  double Re = R0 + (1 - R0)*c*c*c*c*c, Tr = 1 - Re, P = 0.25 + 0.5*Re, RP = Re/P, TP = Tr/(1 - P);
+  return obj.e + f.mult(depth > 2 ? (erand48(Xi) < P ?
+    radiance(reflRay, depth, Xi) * RP : radiance(Ray(x, tdir), depth, Xi) * TP) :
+    radiance(reflRay, depth, Xi) * Re + radiance(Ray(x, tdir), depth, Xi) * Tr);
+}
+
+static std::vector<uint8_t> pixel_buffer;
+static std::vector<Vec> accum_buffer;
+static int cur_w = 0;
+static int cur_h = 0;
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+int get_sphere_count() {
+  return NUM_SPHERES;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void reset_sphere_colors() {
+  spheres[0].c = Vec(.75, .25, .25); // Left
+  spheres[1].c = Vec(.25, .25, .75); // Right
+  spheres[2].c = Vec(.75, .75, .75); // Back
+  spheres[3].c = Vec(0, 0, 0);       // Front
+  spheres[4].c = Vec(.75, .75, .75); // Bottom
+  spheres[5].c = Vec(.75, .75, .75); // Top
+  spheres[6].c = Vec(1, 1, 1) * .999;// Mirror
+  spheres[7].c = Vec(1, 1, 1) * .999;// Glass
+  spheres[8].c = Vec();              // Light
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int id, double r, double g, double b) {
+  if (id >= 0 && id < NUM_SPHERES) {
+    spheres[id].c = Vec(clamp(r), clamp(g), clamp(b));
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_r(int id) {
+  return (id >= 0 && id < NUM_SPHERES) ? spheres[id].c.x : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_g(int id) {
+  return (id >= 0 && id < NUM_SPHERES) ? spheres[id].c.y : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_b(int id) {
+  return (id >= 0 && id < NUM_SPHERES) ? spheres[id].c.z : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors() {
+  // Randomize colors for the two Cornell Box spheres (Mirror & Glass)
+  // as well as left and right walls for vivid variety.
+  auto rnd = []() { return 0.15 + (rand() / (double)RAND_MAX) * 0.80; };
+
+  spheres[6].c = Vec(rnd(), rnd(), rnd()); // Mirror sphere
+  spheres[7].c = Vec(rnd(), rnd(), rnd()); // Glass sphere
+  spheres[0].c = Vec(rnd(), rnd(), rnd()); // Left wall
+  spheres[1].c = Vec(rnd(), rnd(), rnd()); // Right wall
+}
+
+EMSCRIPTEN_KEEPALIVE
+void init_render(int w, int h) {
+  cur_w = w;
+  cur_h = h;
+  pixel_buffer.resize(w * h * 4);
+  accum_buffer.assign(w * h, Vec());
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* get_pixel_buffer() {
+  return pixel_buffer.data();
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render_rows(int start_y, int count, int samps) {
+  if (cur_w <= 0 || cur_h <= 0) return nullptr;
+  if (samps <= 0) samps = 1;
+
+  int w = cur_w;
+  int h = cur_h;
+  int end_y = start_y + count;
+  if (end_y > h) end_y = h;
+
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx = Vec(w*.5135/h), cy = (cx % cam.d).norm() * .5135, r;
+
+  for (int y = start_y; y < end_y; y++) {
+    for (unsigned short x = 0, Xi[3] = {0, 0, (unsigned short)(y*y*y + 1)}; x < w; x++) {
+      for (int sy = 0, i = (h - y - 1) * w + x; sy < 2; sy++) {
+        for (int sx = 0; sx < 2; sx++, r = Vec()) {
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + 0.5 + dx) / 2 + x) / w - 0.5) +
+                    cy * (((sy + 0.5 + dy) / 2 + y) / h - 0.5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1.0 / samps);
+          }
+          accum_buffer[i] = accum_buffer[i] + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * 0.25;
+        }
+      }
+    }
+  }
+
+  for (int y = start_y; y < end_y; y++) {
+    for (int x = 0; x < w; x++) {
+      int i = (h - y - 1) * w + x;
+      pixel_buffer[i * 4 + 0] = toInt(accum_buffer[i].x);
+      pixel_buffer[i * 4 + 1] = toInt(accum_buffer[i].y);
+      pixel_buffer[i * 4 + 2] = toInt(accum_buffer[i].z);
+      pixel_buffer[i * 4 + 3] = 255;
+    }
+  }
+
+  return pixel_buffer.data();
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render(int w, int h, int samps) {
+  init_render(w, h);
+  render_rows(0, h, samps);
+  return pixel_buffer.data();
+}
+
+}
