+// Web Worker for Smallpt C++ WebAssembly Path Tracer
+import createSmallpt from './smallpt.js';
+
+let wasmMod = null;
+
+async function getModule() {
+  if (!wasmMod) {
+    wasmMod = await createSmallpt();
+  }
+  return wasmMod;
+}
+
+function getSpheresInfo(mod) {
+  const count = mod._get_sphere_count();
+  const spheres = [];
+  for (let i = 0; i < count; i++) {
+    const namePtr = mod._get_sphere_name(i);
+    const name = mod.UTF8ToString(namePtr);
+    const r = mod._get_sphere_color_r(i);
+    const g = mod._get_sphere_color_g(i);
+    const b = mod._get_sphere_color_b(i);
+    spheres.push({ id: i, name, r, g, b });
+  }
+  return spheres;
+}
+
+self.onmessage = async (e) => {
+  const { type, payload } = e.data;
+  try {
+    const mod = await getModule();
+
+    if (type === 'init') {
+      const spheres = getSpheresInfo(mod);
+      self.postMessage({ type: 'ready', spheres });
+    } else if (type === 'randomize') {
+      mod._set_random_seed(Date.now() & 0xFFFFFF);
+      mod._randomize_sphere_colors();
+      const spheres = getSpheresInfo(mod);
+      self.postMessage({ type: 'spheres_updated', spheres });
+    } else if (type === 'reset') {
+      mod._reset_sphere_colors();
+      const spheres = getSpheresInfo(mod);
+      self.postMessage({ type: 'spheres_updated', spheres });
+    } else if (type === 'render') {
+      const { width, height, samps } = payload;
+      const startTime = performance.now();
+      const ptr = mod._init_buffer(width, height);
+
+      // Render rows and report progress periodically
+      const batchSize = Math.max(1, Math.floor(height / 20));
+      for (let y = 0; y < height; y++) {
+        mod._render_row(y, width, height, samps);
+
+        if ((y + 1) % batchSize === 0 || y === height - 1) {
+          self.postMessage({
+            type: 'progress',
+            completedRows: y + 1,
+            totalRows: height,
+            percent: Math.round(((y + 1) / height) * 100)
+          });
+        }
+      }
+
+      const durationMs = Math.round(performance.now() - startTime);
+      // Copy rendered RGBA pixel data to transferable ArrayBuffer
+      const heapData = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, width * height * 4);
+      const outputBuffer = new Uint8ClampedArray(heapData);
+
+      self.postMessage(
+        {
+          type: 'complete',
+          buffer: outputBuffer.buffer,
+          width,
+          height,
+          samps,
+          durationMs,
+          spheres: getSpheresInfo(mod)
+        },
+        [outputBuffer.buffer]
+      );
+    }
+  } catch (err) {
+    self.postMessage({ type: 'error', message: err.message || String(err) });
+  }
+};
