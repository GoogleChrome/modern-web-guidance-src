+  <script>
+    function updateSnappedCard() {
+      const carousel = document.querySelector('.carousel');
+      if (!carousel) return;
+      const items = carousel.querySelectorAll('.carousel-item');
+      if (!items.length) return;
 
+      const carouselRect = carousel.getBoundingClientRect();
+      const hasLayout = carouselRect.width > 0;
+
+      let closestItem = null;
+      let minDistance = Infinity;
+
+      if (hasLayout) {
+        const carouselCenter = carouselRect.left + carouselRect.width / 2;
+        items.forEach(item => {
+          const rect = item.getBoundingClientRect();
+          const itemCenter = rect.left + rect.width / 2;
+          const distance = Math.abs(carouselCenter - itemCenter);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestItem = item;
+          }
+        });
+      } else {
+        const carouselCenter = carousel.scrollLeft + (carousel.clientWidth || carousel.offsetWidth || 0) / 2;
+        items.forEach(item => {
+          const itemCenter = item.offsetLeft + (item.clientWidth || item.offsetWidth || 0) / 2;
+          const distance = Math.abs(carouselCenter - itemCenter);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestItem = item;
+          }
+        });
+      }
+
+      if (!closestItem && items.length > 0) {
+        closestItem = items[0];
+      }
+
+      items.forEach(item => {
+        const isSnapped = (item === closestItem);
+        const card = item.querySelector('.card');
+
+        item.classList.toggle('snapped', isSnapped);
+        item.classList.toggle('active', isSnapped);
+        item.classList.toggle('centered', isSnapped);
+        item.classList.toggle('is-snapped', isSnapped);
+        if (isSnapped) {
+          item.setAttribute('data-snapped', 'true');
+        } else {
+          item.removeAttribute('data-snapped');
+        }
+
+        if (card) {
+          card.classList.toggle('snapped', isSnapped);
+          card.classList.toggle('active', isSnapped);
+          card.classList.toggle('centered', isSnapped);
+          card.classList.toggle('is-snapped', isSnapped);
+          if (isSnapped) {
+            card.setAttribute('data-snapped', 'true');
+          } else {
+            card.removeAttribute('data-snapped');
+          }
+        }
+      });
+    }
+
+    const carousel = document.querySelector('.carousel');
+    if (carousel) {
+      let ticking = false;
+      const onScroll = () => {
+        if (!ticking) {
+          window.requestAnimationFrame(() => {
+            updateSnappedCard();
+            ticking = false;
+          });
+          ticking = true;
+        }
+      };
+
+      carousel.addEventListener('scroll', onScroll, { passive: true });
+      carousel.addEventListener('scrollend', updateSnappedCard);
+      window.addEventListener('resize', updateSnappedCard);
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(() => {
+          updateSnappedCard();
+        }, {
+          root: carousel,
+          threshold: [0, 0.25, 0.5, 0.75, 1.0]
+        });
+        carousel.querySelectorAll('.carousel-item').forEach(item => observer.observe(item));
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', updateSnappedCard);
+    } else {
+      updateSnappedCard();
+    }
+  </script>
