+  <script>
+    (function () {
+      const searchInput = document.getElementById('search-input');
+      const cards = document.querySelectorAll('.grid .card');
+
+      if (!searchInput || !cards.length) return;
+
+      cards.forEach(card => {
+        card.dataset.originalHtml = card.innerHTML;
+      });
+
+      function escapeRegExp(string) {
+        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+      }
+
+      function highlightNode(node, regexSource) {
+        if (node.nodeType === Node.TEXT_NODE) {
+          const text = node.nodeValue;
+          if (!text) return;
+
+          const localRegex = new RegExp(regexSource, 'gi');
+          let match = localRegex.exec(text);
+          if (!match) return;
+
+          const fragment = document.createDocumentFragment();
+          let lastIndex = 0;
+
+          do {
+            if (match.index > lastIndex) {
+              fragment.appendChild(document.createTextNode(text.substring(lastIndex, match.index)));
+            }
+            const mark = document.createElement('mark');
+            mark.className = 'highlight';
+            mark.style.backgroundColor = 'gold';
+            mark.textContent = match[0];
+            fragment.appendChild(mark);
+            lastIndex = localRegex.lastIndex;
+            if (match[0].length === 0) break;
+          } while ((match = localRegex.exec(text)) !== null);
+
+          if (lastIndex < text.length) {
+            fragment.appendChild(document.createTextNode(text.substring(lastIndex)));
+          }
+
+          node.parentNode.replaceChild(fragment, node);
+        } else if (node.nodeType === Node.ELEMENT_NODE) {
+          Array.from(node.childNodes).forEach(child => highlightNode(child, regexSource));
+        }
+      }
+
+      function handleSearch() {
+        cards.forEach(card => {
+          card.innerHTML = card.dataset.originalHtml;
+        });
+
+        const query = searchInput.value.trim();
+        if (!query) return;
+
+        const regexSource = escapeRegExp(query).replace(/\s+/g, '\\s+');
+        cards.forEach(card => {
+          highlightNode(card, regexSource);
+        });
+      }
+
+      searchInput.addEventListener('input', handleSearch);
+      searchInput.addEventListener('keyup', handleSearch);
+    })();
+  </script>
