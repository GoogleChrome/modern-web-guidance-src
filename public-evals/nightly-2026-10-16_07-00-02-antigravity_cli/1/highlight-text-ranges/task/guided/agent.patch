+  <script>
+    const searchInput = document.getElementById('search-input');
+    const cards = document.querySelectorAll('.grid .card');
+
+    function clearHighlights() {
+      if (typeof CSS !== 'undefined' && CSS.highlights) {
+        CSS.highlights.clear();
+      } else {
+        cards.forEach(card => {
+          const marks = card.querySelectorAll('mark.search-highlight');
+          marks.forEach(mark => mark.replaceWith(...mark.childNodes));
+          card.normalize();
+        });
+      }
+    }
+
+    function handleSearch() {
+      clearHighlights();
+
+      const query = searchInput.value.trim();
+      if (!query) {
+        return;
+      }
+
+      const lowerQuery = query.toLowerCase();
+
+      if (typeof CSS !== 'undefined' && CSS.highlights) {
+        const ranges = [];
+        cards.forEach(card => {
+          const treeWalker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+          let currentNode = treeWalker.nextNode();
+          while (currentNode) {
+            const text = currentNode.textContent;
+            const lowerText = text.toLowerCase();
+            let startIndex = 0;
+            while ((startIndex = lowerText.indexOf(lowerQuery, startIndex)) !== -1) {
+              const range = new Range();
+              range.setStart(currentNode, startIndex);
+              range.setEnd(currentNode, startIndex + lowerQuery.length);
+              ranges.push(range);
+              startIndex += lowerQuery.length;
+            }
+            currentNode = treeWalker.nextNode();
+          }
+        });
+
+        if (ranges.length > 0) {
+          const searchHighlight = new Highlight(...ranges);
+          CSS.highlights.set('search-results', searchHighlight);
+        }
+      } else {
+        cards.forEach(card => {
+          const treeWalker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+          const textNodes = [];
+          let node = treeWalker.nextNode();
+          while (node) {
+            textNodes.push(node);
+            node = treeWalker.nextNode();
+          }
+
+          for (const textNode of textNodes) {
+            const text = textNode.textContent;
+            let pos = text.toLowerCase().indexOf(lowerQuery);
+            if (pos === -1) continue;
+
+            const frag = document.createDocumentFragment();
+            let last = 0;
+            while (pos !== -1) {
+              frag.append(text.slice(last, pos));
+              const mark = document.createElement('mark');
+              mark.className = 'search-highlight';
+              mark.textContent = text.slice(pos, pos + lowerQuery.length);
+              frag.append(mark);
+              last = pos + lowerQuery.length;
+              pos = text.toLowerCase().indexOf(lowerQuery, last);
+            }
+            frag.append(text.slice(last));
+            textNode.replaceWith(frag);
+          }
+        });
+      }
+    }
+
+    searchInput.addEventListener('input', handleSearch);
+  </script>
