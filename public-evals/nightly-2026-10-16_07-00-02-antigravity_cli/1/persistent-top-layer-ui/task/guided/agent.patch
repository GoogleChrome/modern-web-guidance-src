+  <script>
+    (function () {
+      const dialog = document.getElementById('feedback-dialog');
+      const openBtn = document.getElementById('open-feedback-btn');
+      const floatingBtn = document.getElementById('floating-feedback-btn');
+      const closeBtn = document.getElementById('close-dialog-btn');
+      const cancelBtn = document.getElementById('cancel-dialog-btn');
+      const form = document.getElementById('feedback-form');
+      const slotA = document.getElementById('dialog-slot-a');
+      const slotB = document.getElementById('dialog-slot-b');
+      const slotBadge = document.getElementById('current-slot-badge');
+
+      function updateSlotDisplay() {
+        if (!slotBadge || !dialog) return;
+        const parent = dialog.parentElement;
+        slotBadge.textContent = parent && parent.id ? `#${parent.id}` : (parent ? parent.tagName.toLowerCase() : 'detached');
+      }
+
+      function openModal() {
+        if (dialog && typeof dialog.showModal === 'function') {
+          dialog.showModal();
+          updateSlotDisplay();
+        }
+      }
+
+      function closeModal() {
+        if (dialog && typeof dialog.close === 'function') {
+          dialog.close();
+        }
+      }
+
+      function relocateDialog() {
+        if (!dialog) return;
+
+        const currentParent = dialog.parentElement;
+        // Toggle target parent between slotA and slotB
+        const targetParent = currentParent === slotA ? slotB : slotA;
+        if (!targetParent) return;
+
+        // Capture active element and text selection to ensure modal remains focus-active
+        const activeElement = document.activeElement;
+        const hasFocusInside = dialog.contains(activeElement);
+        const selectionStart = (activeElement && 'selectionStart' in activeElement) ? activeElement.selectionStart : null;
+        const selectionEnd = (activeElement && 'selectionEnd' in activeElement) ? activeElement.selectionEnd : null;
+
+        // Native state-preserving moveBefore API
+        if ('moveBefore' in Element.prototype) {
+          // MANDATORY: Use moveBefore to ensure the <dialog> or popover stays open.
+          // Passing null appends it to the end of newParent.
+          targetParent.moveBefore(dialog, null);
+        } else {
+          // Fallback: traditional move for unsupported browsers.
+          // Note: This WILL close <dialog>, popover, and fullscreen elements.
+          const wasOpen = dialog.hasAttribute('open') || dialog.open || (typeof dialog.matches === 'function' && dialog.matches(':popover-open'));
+          targetParent.insertBefore(dialog, null);
+
+          // Manually restore modal state if it was open
+          if (wasOpen && typeof dialog.showModal === 'function') {
+            dialog.showModal();
+          } else if (wasOpen && typeof dialog.showPopover === 'function') {
+            dialog.showPopover();
+          }
+
+          // Restore focus and cursor selection to keep focus active
+          if (hasFocusInside && activeElement && typeof activeElement.focus === 'function') {
+            activeElement.focus();
+            if (selectionStart !== null && selectionEnd !== null && typeof activeElement.setSelectionRange === 'function') {
+              activeElement.setSelectionRange(selectionStart, selectionEnd);
+            }
+          }
+        }
+
+        updateSlotDisplay();
+      }
+
+      // Expose globally for testing/automation
+      window.relocateDialog = relocateDialog;
+      window.openFeedbackModal = openModal;
+      window.closeFeedbackModal = closeModal;
+
+      // Event listeners
+      if (openBtn) openBtn.addEventListener('click', openModal);
+      if (floatingBtn) floatingBtn.addEventListener('click', openModal);
+      if (closeBtn) closeBtn.addEventListener('click', closeModal);
+      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
+
+      // Light dismiss when clicking the backdrop
+      if (dialog) {
+        dialog.addEventListener('click', (event) => {
+          if (event.target === dialog) {
+            const rect = dialog.getBoundingClientRect();
+            const isInDialog = (
+              event.clientX >= rect.left &&
+              event.clientX <= rect.right &&
+              event.clientY >= rect.top &&
+              event.clientY <= rect.bottom
+            );
+            if (!isInDialog) {
+              closeModal();
+            }
+          }
+        });
+      }
+
+      // Handle any move button click via event delegation
+      document.addEventListener('click', (event) => {
+        const moveTrigger = event.target.closest('#move-btn, .move-btn, [data-action="move"]');
+        if (moveTrigger) {
+          relocateDialog();
+        }
+      });
+
+      // Handle form submission
+      if (form) {
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          closeModal();
+          form.reset();
+        });
+      }
+
+      // Synchronize slot badge initially
+      updateSlotDisplay();
+    })();
+  </script>
