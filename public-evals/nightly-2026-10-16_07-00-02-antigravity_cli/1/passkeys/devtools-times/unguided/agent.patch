@@ -0,0 +1,66 @@
+import type { User } from './db';
+
+export const REAUTH_TIMEOUT_MS = 5 * 60 * 1000; // 5 minutes
+
+export interface SessionUser {
+  id: string;
+  username: string;
+  displayName: string;
+}
+
+export async function getSessionUser(session?: any): Promise<SessionUser | null> {
+  if (!session) return null;
+  const user = await session.get('user');
+  return user || null;
+}
+
+export async function setSessionUser(session: any, user: User | SessionUser): Promise<void> {
+  if (!session) return;
+  await session.set('user', {
+    id: user.id,
+    username: user.username,
+    displayName: user.displayName,
+  });
+  // Logging in also establishes initial reauthentication
+  await setSessionReauth(session);
+}
+
+export async function clearSessionUser(session?: any): Promise<void> {
+  if (!session) return;
+  await session.set('user', null);
+  await session.set('lastReauthAt', null);
+  await session.set('currentChallenge', null);
+}
+
+export async function setSessionReauth(session?: any): Promise<void> {
+  if (!session) return;
+  await session.set('lastReauthAt', Date.now());
+}
+
+export async function isReauthenticated(session?: any): Promise<boolean> {
+  if (!session) return false;
+  const lastReauthAt = await session.get('lastReauthAt');
+  if (!lastReauthAt || typeof lastReauthAt !== 'number') return false;
+  return Date.now() - lastReauthAt < REAUTH_TIMEOUT_MS;
+}
+
+export async function getReauthStatus(session?: any): Promise<{
+  isReauthenticated: boolean;
+  lastReauthAt: number | null;
+  timeRemainingMs: number;
+}> {
+  if (!session) {
+    return { isReauthenticated: false, lastReauthAt: null, timeRemainingMs: 0 };
+  }
+  const lastReauthAt = (await session.get('lastReauthAt')) as number | null;
+  if (!lastReauthAt || typeof lastReauthAt !== 'number') {
+    return { isReauthenticated: false, lastReauthAt: null, timeRemainingMs: 0 };
+  }
+  const elapsed = Date.now() - lastReauthAt;
+  const timeRemainingMs = Math.max(0, REAUTH_TIMEOUT_MS - elapsed);
+  return {
+    isReauthenticated: timeRemainingMs > 0,
+    lastReauthAt,
+    timeRemainingMs,
+  };
+}
diff --git a/src/lib/db.ts b/src/lib/db.ts
new file mode 100644
index 0000000..0fe42ce
--- /dev/null
+++ b/src/lib/db.ts
@@ -0,0 +1,329 @@
+import { DatabaseSync } from 'node:sqlite';
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+
+export interface User {
+  id: string;
+  username: string;
+  displayName: string;
+  passwordHash?: string | null;
+  createdAt: string;
+}
+
+export interface Passkey {
+  id: string; // base64url credential ID
+  userId: string;
+  name: string;
+  publicKey: string; // base64url encoded public key
+  counter: number;
+  transports?: string[] | null;
+  deviceType?: 'singleDevice' | 'multiDevice' | null;
+  backedUp: boolean;
+  aaguid?: string | null;
+  createdAt: string;
+  lastUsedAt?: string | null;
+}
+
+export interface ChallengeRecord {
+  challenge: string;
+  type: 'registration' | 'authentication' | 'reauth';
+  userId?: string | null;
+  expiresAt: number;
+}
+
+let dbInstance: DatabaseSync | null = null;
+
+export function getDb(): DatabaseSync {
+  if (dbInstance) {
+    return dbInstance;
+  }
+
+  const dataDir = path.resolve(process.cwd(), 'data');
+  if (!fs.existsSync(dataDir)) {
+    fs.mkdirSync(dataDir, { recursive: true });
+  }
+
+  const dbPath = path.join(dataDir, 'app.db');
+  const db = new DatabaseSync(dbPath);
+
+  // Enable WAL mode for better concurrency
+  db.exec('PRAGMA journal_mode = WAL;');
+  db.exec('PRAGMA foreign_keys = ON;');
+
+  // Initialize tables
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS users (
+      id TEXT PRIMARY KEY,
+      username TEXT UNIQUE NOT NULL COLLATE NOCASE,
+      displayName TEXT NOT NULL,
+      passwordHash TEXT,
+      createdAt TEXT NOT NULL
+    );
+
+    CREATE TABLE IF NOT EXISTS passkeys (
+      id TEXT PRIMARY KEY,
+      userId TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+      name TEXT NOT NULL,
+      publicKey TEXT NOT NULL,
+      counter INTEGER NOT NULL DEFAULT 0,
+      transports TEXT,
+      deviceType TEXT,
+      backedUp INTEGER NOT NULL DEFAULT 0,
+      aaguid TEXT,
+      createdAt TEXT NOT NULL,
+      lastUsedAt TEXT
+    );
+
+    CREATE TABLE IF NOT EXISTS challenges (
+      challenge TEXT PRIMARY KEY,
+      type TEXT NOT NULL,
+      userId TEXT,
+      expiresAt INTEGER NOT NULL
+    );
+  `);
+
+  dbInstance = db;
+  return dbInstance;
+}
+
+// Password hashing utilities using Node built-in crypto (scrypt)
+export function hashPassword(password: string): string {
+  const salt = crypto.randomBytes(16).toString('hex');
+  const hash = crypto.scryptSync(password, salt, 64).toString('hex');
+  return `${salt}:${hash}`;
+}
+
+export function verifyPassword(password: string, storedHash: string): boolean {
+  try {
+    const [salt, key] = storedHash.split(':');
+    if (!salt || !key) return false;
+    const keyBuffer = Buffer.from(key, 'hex');
+    const derivedKey = crypto.scryptSync(password, salt, 64);
+    return crypto.timingSafeEqual(keyBuffer, derivedKey);
+  } catch {
+    return false;
+  }
+}
+
+// User operations
+export function createUser(username: string, displayName?: string, password?: string): User {
+  const db = getDb();
+  const id = crypto.randomUUID();
+  const now = new Date().toISOString();
+  const effectiveDisplayName = displayName?.trim() || username.trim();
+  const passwordHash = password ? hashPassword(password) : null;
+
+  const stmt = db.prepare(`
+    INSERT INTO users (id, username, displayName, passwordHash, createdAt)
+    VALUES (?, ?, ?, ?, ?)
+  `);
+  stmt.run(id, username.trim().toLowerCase(), effectiveDisplayName, passwordHash, now);
+
+  return {
+    id,
+    username: username.trim().toLowerCase(),
+    displayName: effectiveDisplayName,
+    passwordHash,
+    createdAt: now,
+  };
+}
+
+export function getUserById(id: string): User | null {
+  const db = getDb();
+  const stmt = db.prepare('SELECT * FROM users WHERE id = ?');
+  const row = stmt.get(id) as any;
+  if (!row) return null;
+  return {
+    id: row.id,
+    username: row.username,
+    displayName: row.displayName,
+    passwordHash: row.passwordHash,
+    createdAt: row.createdAt,
+  };
+}
+
+export function getUserByUsername(username: string): User | null {
+  const db = getDb();
+  const stmt = db.prepare('SELECT * FROM users WHERE username = ? COLLATE NOCASE');
+  const row = stmt.get(username.trim()) as any;
+  if (!row) return null;
+  return {
+    id: row.id,
+    username: row.username,
+    displayName: row.displayName,
+    passwordHash: row.passwordHash,
+    createdAt: row.createdAt,
+  };
+}
+
+// Passkey operations
+export function addPasskey(passkey: {
+  id: string;
+  userId: string;
+  name: string;
+  publicKey: string;
+  counter: number;
+  transports?: string[];
+  deviceType?: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  aaguid?: string;
+}): Passkey {
+  const db = getDb();
+  const now = new Date().toISOString();
+  const transportsJson = passkey.transports ? JSON.stringify(passkey.transports) : null;
+
+  const stmt = db.prepare(`
+    INSERT INTO passkeys (id, userId, name, publicKey, counter, transports, deviceType, backedUp, aaguid, createdAt, lastUsedAt)
+    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+  `);
+  stmt.run(
+    passkey.id,
+    passkey.userId,
+    passkey.name,
+    passkey.publicKey,
+    passkey.counter,
+    transportsJson,
+    passkey.deviceType || null,
+    passkey.backedUp ? 1 : 0,
+    passkey.aaguid || null,
+    now,
+    null
+  );
+
+  return {
+    id: passkey.id,
+    userId: passkey.userId,
+    name: passkey.name,
+    publicKey: passkey.publicKey,
+    counter: passkey.counter,
+    transports: passkey.transports || null,
+    deviceType: passkey.deviceType || null,
+    backedUp: passkey.backedUp,
+    aaguid: passkey.aaguid || null,
+    createdAt: now,
+    lastUsedAt: null,
+  };
+}
+
+export function getPasskeysByUserId(userId: string): Passkey[] {
+  const db = getDb();
+  const stmt = db.prepare('SELECT * FROM passkeys WHERE userId = ? ORDER BY createdAt DESC');
+  const rows = stmt.all(userId) as any[];
+
+  return rows.map((row) => ({
+    id: row.id,
+    userId: row.userId,
+    name: row.name,
+    publicKey: row.publicKey,
+    counter: Number(row.counter),
+    transports: row.transports ? JSON.parse(row.transports) : null,
+    deviceType: row.deviceType,
+    backedUp: Boolean(row.backedUp),
+    aaguid: row.aaguid,
+    createdAt: row.createdAt,
+    lastUsedAt: row.lastUsedAt,
+  }));
+}
+
+export function getPasskeyById(id: string): (Passkey & { user?: User }) | null {
+  const db = getDb();
+  const stmt = db.prepare(`
+    SELECT p.*, u.username, u.displayName, u.createdAt as userCreatedAt
+    FROM passkeys p
+    JOIN users u ON p.userId = u.id
+    WHERE p.id = ?
+  `);
+  const row = stmt.get(id) as any;
+  if (!row) return null;
+
+  return {
+    id: row.id,
+    userId: row.userId,
+    name: row.name,
+    publicKey: row.publicKey,
+    counter: Number(row.counter),
+    transports: row.transports ? JSON.parse(row.transports) : null,
+    deviceType: row.deviceType,
+    backedUp: Boolean(row.backedUp),
+    aaguid: row.aaguid,
+    createdAt: row.createdAt,
+    lastUsedAt: row.lastUsedAt,
+    user: {
+      id: row.userId,
+      username: row.username,
+      displayName: row.displayName,
+      createdAt: row.userCreatedAt,
+    },
+  };
+}
+
+export function updatePasskeyCounter(id: string, counter: number, lastUsedAt?: string): void {
+  const db = getDb();
+  const effectiveLastUsed = lastUsedAt || new Date().toISOString();
+  const stmt = db.prepare(`
+    UPDATE passkeys
+    SET counter = ?, lastUsedAt = ?
+    WHERE id = ?
+  `);
+  stmt.run(counter, effectiveLastUsed, id);
+}
+
+export function renamePasskey(id: string, userId: string, newName: string): boolean {
+  const db = getDb();
+  const stmt = db.prepare(`
+    UPDATE passkeys
+    SET name = ?
+    WHERE id = ? AND userId = ?
+  `);
+  const info = stmt.run(newName.trim(), id, userId);
+  return info.changes > 0;
+}
+
+export function deletePasskey(id: string, userId: string): boolean {
+  const db = getDb();
+  const stmt = db.prepare(`
+    DELETE FROM passkeys
+    WHERE id = ? AND userId = ?
+  `);
+  const info = stmt.run(id, userId);
+  return info.changes > 0;
+}
+
+// Challenge storage with TTL (5 minutes)
+export function saveChallenge(challenge: string, type: 'registration' | 'authentication' | 'reauth', userId?: string): void {
+  const db = getDb();
+  const now = Date.now();
+  const expiresAt = now + 5 * 60 * 1000;
+
+  // Clean expired
+  db.prepare('DELETE FROM challenges WHERE expiresAt < ?').run(now);
+
+  const stmt = db.prepare(`
+    INSERT OR REPLACE INTO challenges (challenge, type, userId, expiresAt)
+    VALUES (?, ?, ?, ?)
+  `);
+  stmt.run(challenge, type, userId || null, expiresAt);
+}
+
+export function consumeChallenge(challenge: string, type: 'registration' | 'authentication' | 'reauth'): ChallengeRecord | null {
+  const db = getDb();
+  const now = Date.now();
+
+  const stmt = db.prepare(`
+    SELECT * FROM challenges
+    WHERE challenge = ? AND type = ? AND expiresAt > ?
+  `);
+  const row = stmt.get(challenge, type, now) as any;
+  if (!row) return null;
+
+  // Delete consumed challenge (single use)
+  db.prepare('DELETE FROM challenges WHERE challenge = ?').run(challenge);
+
+  return {
+    challenge: row.challenge,
+    type: row.type,
+    userId: row.userId,
+    expiresAt: Number(row.expiresAt),
+  };
+}
diff --git a/src/lib/webauthn.ts b/src/lib/webauthn.ts
new file mode 100644
index 0000000..fe84e76
--- /dev/null
+++ b/src/lib/webauthn.ts
@@ -0,0 +1,163 @@
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+  type VerifiedRegistrationResponse,
+  type VerifiedAuthenticationResponse,
+} from '@simplewebauthn/server';
+import type {
+  RegistrationResponseJSON,
+  AuthenticationResponseJSON,
+  AuthenticatorTransportFuture,
+} from '@simplewebauthn/server';
+import type { Passkey } from './db';
+
+export interface RPConfig {
+  rpName: string;
+  rpID: string;
+  origin: string;
+  expectedOrigins: string[];
+}
+
+export function getRPConfig(request: Request): RPConfig {
+  const url = new URL(request.url);
+
+  // Determine host and protocol from headers or URL
+  const forwardedHost = request.headers.get('x-forwarded-host');
+  const hostHeader = request.headers.get('host');
+  const rawHost = forwardedHost || hostHeader || url.host;
+  
+  // rpID is the domain without port
+  const rpID = rawHost.split(':')[0] || 'localhost';
+
+  const forwardedProto = request.headers.get('x-forwarded-proto');
+  const protocol = forwardedProto || url.protocol.replace(':', '') || (rpID === 'localhost' || rpID === '127.0.0.1' ? 'http' : 'https');
+
+  const originHeader = request.headers.get('origin');
+  const computedOrigin = `${protocol}://${rawHost}`;
+
+  // Allow computed origin, header origin, and local fallback origins
+  const origins = new Set<string>();
+  origins.add(computedOrigin);
+  origins.add(url.origin);
+  if (originHeader) {
+    origins.add(originHeader);
+  }
+  if (rpID === 'localhost' || rpID === '127.0.0.1') {
+    origins.add(`http://localhost:${url.port || '11224'}`);
+    origins.add(`http://127.0.0.1:${url.port || '11224'}`);
+    origins.add('http://localhost:11224');
+    origins.add('http://localhost:4321');
+  }
+
+  return {
+    rpName: 'The DevTools Times',
+    rpID,
+    origin: originHeader || computedOrigin,
+    expectedOrigins: Array.from(origins),
+  };
+}
+
+export async function createRegistrationOptions(params: {
+  username: string;
+  displayName?: string;
+  userId: string;
+  existingPasskeys?: Passkey[];
+  rpConfig: RPConfig;
+}) {
+  const { username, displayName, userId, existingPasskeys = [], rpConfig } = params;
+
+  // WebAuthn requires userID as Uint8Array
+  const userIDBuffer = Buffer.from(userId, 'utf-8');
+
+  // Prevent re-registering existing passkeys
+  const excludeCredentials = existingPasskeys.map((passkey) => ({
+    id: passkey.id,
+    type: 'public-key' as const,
+    transports: (passkey.transports as AuthenticatorTransportFuture[]) || undefined,
+  }));
+
+  const options = await generateRegistrationOptions({
+    rpName: rpConfig.rpName,
+    rpID: rpConfig.rpID,
+    userName: username,
+    userDisplayName: displayName || username,
+    userID: new Uint8Array(userIDBuffer),
+    attestationType: 'none',
+    excludeCredentials,
+    authenticatorSelection: {
+      residentKey: 'preferred',
+      userVerification: 'preferred',
+    },
+    supportedAlgorithmIDs: [-7, -257], // ES256, RS256
+  });
+
+  return options;
+}
+
+export async function verifyRegistration(params: {
+  response: RegistrationResponseJSON;
+  expectedChallenge: string;
+  rpConfig: RPConfig;
+}): Promise<VerifiedRegistrationResponse> {
+  const { response, expectedChallenge, rpConfig } = params;
+
+  const verification = await verifyRegistrationResponse({
+    response,
+    expectedChallenge,
+    expectedOrigin: rpConfig.expectedOrigins,
+    expectedRPID: rpConfig.rpID,
+    requireUserVerification: false, // preferred in options
+  });
+
+  return verification;
+}
+
+export async function createAuthenticationOptions(params: {
+  allowPasskeys?: Passkey[];
+  rpConfig: RPConfig;
+}) {
+  const { allowPasskeys, rpConfig } = params;
+
+  const allowCredentials = allowPasskeys?.length
+    ? allowPasskeys.map((passkey) => ({
+        id: passkey.id,
+        type: 'public-key' as const,
+        transports: (passkey.transports as AuthenticatorTransportFuture[]) || undefined,
+      }))
+    : undefined;
+
+  const options = await generateAuthenticationOptions({
+    rpID: rpConfig.rpID,
+    allowCredentials,
+    userVerification: 'preferred',
+  });
+
+  return options;
+}
+
+export async function verifyAuthentication(params: {
+  response: AuthenticationResponseJSON;
+  expectedChallenge: string;
+  passkey: Passkey;
+  rpConfig: RPConfig;
+}): Promise<VerifiedAuthenticationResponse> {
+  const { response, expectedChallenge, passkey, rpConfig } = params;
+
+  const verification = await verifyAuthenticationResponse({
+    response,
+    expectedChallenge,
+    expectedOrigin: rpConfig.expectedOrigins,
+    expectedRPID: rpConfig.rpID,
+    credential: {
+      id: passkey.id,
+      publicKey: new Uint8Array(Buffer.from(passkey.publicKey, 'base64url')),
+      counter: passkey.counter,
+      transports: (passkey.transports as AuthenticatorTransportFuture[]) || undefined,
+    },
+    requireUserVerification: false, // allows devices with UP
+  });
+
+  return verification;
+}
diff --git a/src/pages/api/auth/login-options.ts b/src/pages/api/auth/login-options.ts
new file mode 100644
index 0000000..d2731f0
--- /dev/null
+++ b/src/pages/api/auth/login-options.ts
@@ -0,0 +1,47 @@
+import type { APIRoute } from 'astro';
+import { getRPConfig, createAuthenticationOptions } from '../../../lib/webauthn';
+import { getUserByUsername, getPasskeysByUserId, saveChallenge } from '../../../lib/db';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const rpConfig = getRPConfig(request);
+
+    let allowPasskeys = undefined;
+    let userId: string | undefined = undefined;
+
+    if (body.username && String(body.username).trim()) {
+      const user = getUserByUsername(String(body.username).trim());
+      if (user) {
+        userId = user.id;
+        const passkeys = getPasskeysByUserId(user.id);
+        if (passkeys.length > 0) {
+          allowPasskeys = passkeys;
+        }
+      }
+    }
+
+    const options = await createAuthenticationOptions({
+      allowPasskeys,
+      rpConfig,
+    });
+
+    // Store challenge in session & DB
+    await session?.set('currentChallenge', options.challenge);
+    if (userId) {
+      await session?.set('authUserId', userId);
+    }
+    saveChallenge(options.challenge, 'authentication', userId);
+
+    return new Response(JSON.stringify({ options }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    console.error('Error generating authentication options:', error);
+    return new Response(
+      JSON.stringify({ error: error.message || 'Failed to generate authentication options' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/auth/login-verify.ts b/src/pages/api/auth/login-verify.ts
new file mode 100644
index 0000000..ddea2aa
--- /dev/null
+++ b/src/pages/api/auth/login-verify.ts
@@ -0,0 +1,106 @@
+import type { APIRoute } from 'astro';
+import { getRPConfig, verifyAuthentication } from '../../../lib/webauthn';
+import { getPasskeyById, getUserById, updatePasskeyCounter, consumeChallenge } from '../../../lib/db';
+import { setSessionUser } from '../../../lib/auth';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { response } = body;
+
+    if (!response || !response.id) {
+      return new Response(JSON.stringify({ error: 'Missing WebAuthn authentication response' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const rpConfig = getRPConfig(request);
+
+    // Retrieve expected challenge
+    let expectedChallenge = await session?.get('currentChallenge');
+
+    if (!expectedChallenge) {
+      try {
+        const clientData = JSON.parse(
+          Buffer.from(response.response.clientDataJSON, 'base64url').toString('utf8')
+        );
+        const record = consumeChallenge(clientData.challenge, 'authentication');
+        if (record) {
+          expectedChallenge = record.challenge;
+        }
+      } catch (e) {
+        // Ignored
+      }
+    }
+
+    if (!expectedChallenge) {
+      return new Response(
+        JSON.stringify({ error: 'Authentication session expired or invalid. Please try again.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    // Lookup passkey by credential ID
+    const passkeyData = getPasskeyById(response.id);
+    if (!passkeyData) {
+      return new Response(
+        JSON.stringify({ error: 'Passkey not recognized. Please register first.' }),
+        { status: 401, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const verification = await verifyAuthentication({
+      response,
+      expectedChallenge,
+      passkey: passkeyData,
+      rpConfig,
+    });
+
+    if (!verification.verified || !verification.authenticationInfo) {
+      return new Response(JSON.stringify({ error: 'Passkey authentication failed' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    // Update credential counter and last used timestamp
+    updatePasskeyCounter(
+      passkeyData.id,
+      verification.authenticationInfo.newCounter,
+      new Date().toISOString()
+    );
+
+    // Clear challenge
+    await session?.set('currentChallenge', null);
+
+    // Lookup user and establish session
+    const user = passkeyData.user || getUserById(passkeyData.userId);
+    if (!user) {
+      return new Response(JSON.stringify({ error: 'User account not found' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    await setSessionUser(session, user);
+
+    return new Response(
+      JSON.stringify({
