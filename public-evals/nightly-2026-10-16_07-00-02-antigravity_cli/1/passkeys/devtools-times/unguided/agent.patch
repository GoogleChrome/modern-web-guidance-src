@@ -0,0 +1,125 @@
+import type { APIRoute } from 'astro';
+import { getPasskeyById, renamePasskey, deletePasskey } from '../../../../lib/db';
+import { getSessionUser, isReauthenticated } from '../../../../lib/auth';
+
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  try {
+    const currentUser = await getSessionUser(session);
+    if (!currentUser) {
+      return new Response(JSON.stringify({ error: 'Authentication required' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const passkeyId = params.id;
+    if (!passkeyId) {
+      return new Response(JSON.stringify({ error: 'Passkey ID is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const body = await request.json();
+    const newName = body.name ? String(body.name).trim() : '';
+    if (!newName) {
+      return new Response(JSON.stringify({ error: 'Passkey name cannot be empty' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const passkey = getPasskeyById(passkeyId);
+    if (!passkey || passkey.userId !== currentUser.id) {
+      return new Response(JSON.stringify({ error: 'Passkey not found or access denied' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const updated = renamePasskey(passkeyId, currentUser.id, newName);
+    if (!updated) {
+      return new Response(JSON.stringify({ error: 'Failed to update passkey name' }), {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        id: passkeyId,
+        name: newName,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (error: any) {
+    console.error('Error renaming passkey:', error);
+    return new Response(
+      JSON.stringify({ error: error.message || 'Failed to rename passkey' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  try {
+    const currentUser = await getSessionUser(session);
+    if (!currentUser) {
+      return new Response(JSON.stringify({ error: 'Authentication required' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const passkeyId = params.id;
+    if (!passkeyId) {
+      return new Response(JSON.stringify({ error: 'Passkey ID is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    // Security check: Passkey deletion requires recent reauthentication!
+    const reauthed = await isReauthenticated(session);
+    if (!reauthed) {
+      return new Response(
+        JSON.stringify({
+          error: 'REAUTH_REQUIRED',
+          message: 'Passkey reauthentication is required to delete credentials.',
+        }),
+        { status: 403, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const passkey = getPasskeyById(passkeyId);
+    if (!passkey || passkey.userId !== currentUser.id) {
+      return new Response(JSON.stringify({ error: 'Passkey not found or access denied' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const deleted = deletePasskey(passkeyId, currentUser.id);
+    if (!deleted) {
+      return new Response(JSON.stringify({ error: 'Failed to delete passkey' }), {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        deletedId: passkeyId,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (error: any) {
+    console.error('Error deleting passkey:', error);
+    return new Response(
+      JSON.stringify({ error: error.message || 'Failed to delete passkey' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
