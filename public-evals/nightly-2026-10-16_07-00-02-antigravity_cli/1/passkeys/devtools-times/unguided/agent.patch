+import type { APIRoute } from 'astro';
+import { getRPConfig, createAuthenticationOptions } from '../../../lib/webauthn';
+import { getPasskeysByUserId, saveChallenge } from '../../../lib/db';
+import { getSessionUser } from '../../../lib/auth';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const currentUser = await getSessionUser(session);
+    if (!currentUser) {
+      return new Response(JSON.stringify({ error: 'Authentication required' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const passkeys = getPasskeysByUserId(currentUser.id);
+    if (passkeys.length === 0) {
+      return new Response(
+        JSON.stringify({
+          error: 'No passkeys registered on your account. Please register a passkey first.',
+        }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const rpConfig = getRPConfig(request);
+    const options = await createAuthenticationOptions({
+      allowPasskeys: passkeys,
+      rpConfig,
+    });
+
+    await session?.set('reauthChallenge', options.challenge);
+    saveChallenge(options.challenge, 'reauth', currentUser.id);
+
+    return new Response(JSON.stringify({ options }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    console.error('Error generating reauth options:', error);
+    return new Response(
+      JSON.stringify({ error: error.message || 'Failed to generate reauthentication options' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/auth/reauth-verify.ts b/src/pages/api/auth/reauth-verify.ts
new file mode 100644
index 0000000..4ec6039
--- /dev/null
+++ b/src/pages/api/auth/reauth-verify.ts
@@ -0,0 +1,102 @@
+import type { APIRoute } from 'astro';
+import { getRPConfig, verifyAuthentication } from '../../../lib/webauthn';
+import { getPasskeyById, updatePasskeyCounter, consumeChallenge } from '../../../lib/db';
+import { getSessionUser, setSessionReauth } from '../../../lib/auth';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const currentUser = await getSessionUser(session);
+    if (!currentUser) {
+      return new Response(JSON.stringify({ error: 'Authentication required' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const body = await request.json();
+    const { response } = body;
+
+    if (!response || !response.id) {
+      return new Response(JSON.stringify({ error: 'Missing WebAuthn reauthentication response' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const rpConfig = getRPConfig(request);
+
+    // Retrieve expected challenge
+    let expectedChallenge = await session?.get('reauthChallenge');
+
+    if (!expectedChallenge) {
+      try {
+        const clientData = JSON.parse(
+          Buffer.from(response.response.clientDataJSON, 'base64url').toString('utf8')
+        );
+        const record = consumeChallenge(clientData.challenge, 'reauth');
+        if (record && record.userId === currentUser.id) {
+          expectedChallenge = record.challenge;
+        }
+      } catch (e) {
+        // Ignored
+      }
+    }
+
+    if (!expectedChallenge) {
+      return new Response(
+        JSON.stringify({ error: 'Reauthentication session expired. Please try again.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const passkeyData = getPasskeyById(response.id);
+    if (!passkeyData || passkeyData.userId !== currentUser.id) {
+      return new Response(
+        JSON.stringify({ error: 'Passkey not recognized or does not belong to your account.' }),
+        { status: 403, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const verification = await verifyAuthentication({
+      response,
+      expectedChallenge,
+      passkey: passkeyData,
+      rpConfig,
+    });
+
+    if (!verification.verified || !verification.authenticationInfo) {
+      return new Response(JSON.stringify({ error: 'Passkey verification failed' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    // Update credential counter and last used timestamp
+    updatePasskeyCounter(
+      passkeyData.id,
+      verification.authenticationInfo.newCounter,
+      new Date().toISOString()
+    );
+
+    // Clear challenge
+    await session?.set('reauthChallenge', null);
+
+    // Update reauthentication timestamp
+    await setSessionReauth(session);
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        reauthenticated: true,
+        reauthTime: Date.now(),
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (error: any) {
+    console.error('Error verifying reauthentication:', error);
+    return new Response(
+      JSON.stringify({ error: error.message || 'Reauthentication verification failed' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/auth/register-options.ts b/src/pages/api/auth/register-options.ts
new file mode 100644
index 0000000..8abbfc5
--- /dev/null
+++ b/src/pages/api/auth/register-options.ts
@@ -0,0 +1,77 @@
+import type { APIRoute } from 'astro';
+import { getRPConfig, createRegistrationOptions } from '../../../lib/webauthn';
+import { getUserByUsername, getPasskeysByUserId, saveChallenge } from '../../../lib/db';
+import { getSessionUser } from '../../../lib/auth';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const rpConfig = getRPConfig(request);
+    const currentUser = await getSessionUser(session);
+
+    let username = body.username ? String(body.username).trim() : '';
+    let displayName = body.displayName ? String(body.displayName).trim() : '';
+    let userId: string;
+    let existingPasskeys: any[] = [];
+
+    if (currentUser) {
+      // Adding a passkey to logged-in user's account
+      userId = currentUser.id;
+      username = currentUser.username;
+      displayName = currentUser.displayName;
+      existingPasskeys = getPasskeysByUserId(currentUser.id);
+    } else {
+      // New user registering via passkey
+      if (!username) {
+        return new Response(
+          JSON.stringify({ error: 'Username is required to create a passkey' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      const existingUser = getUserByUsername(username);
+      if (existingUser) {
+        const passkeys = getPasskeysByUserId(existingUser.id);
+        if (passkeys.length > 0) {
+          return new Response(
+            JSON.stringify({ error: 'User already exists with passkeys. Please sign in instead.' }),
+            { status: 400, headers: { 'Content-Type': 'application/json' } }
+          );
+        }
+        // User exists with password but no passkey yet - allow adding passkey
+        userId = existingUser.id;
+        displayName = existingUser.displayName;
+      } else {
+        // Will create user during verify step
+        userId = crypto.randomUUID();
+      }
+    }
+
+    const options = await createRegistrationOptions({
+      username,
+      displayName: displayName || username,
+      userId,
+      existingPasskeys,
+      rpConfig,
+    });
+
+    // Save challenge in session and DB cache
+    await session?.set('currentChallenge', options.challenge);
+    await session?.set('regUserId', userId);
+    await session?.set('regUsername', username);
+    await session?.set('regDisplayName', displayName || username);
+
+    saveChallenge(options.challenge, 'registration', userId);
+
+    return new Response(JSON.stringify({ options }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    console.error('Error generating registration options:', error);
+    return new Response(
+      JSON.stringify({ error: error.message || 'Failed to generate registration options' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/auth/register-verify.ts b/src/pages/api/auth/register-verify.ts
new file mode 100644
index 0000000..b90fa8a
--- /dev/null
+++ b/src/pages/api/auth/register-verify.ts
@@ -0,0 +1,139 @@
+import type { APIRoute } from 'astro';
+import { getRPConfig, verifyRegistration } from '../../../lib/webauthn';
+import {
+  getUserByUsername,
+  getUserById,
+  createUser,
+  addPasskey,
+  consumeChallenge,
+} from '../../../lib/db';
+import { getSessionUser, setSessionUser } from '../../../lib/auth';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { response, passkeyName } = body;
+
+    if (!response) {
+      return new Response(JSON.stringify({ error: 'Missing WebAuthn response' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const rpConfig = getRPConfig(request);
+
+    // Retrieve expected challenge
+    let expectedChallenge = await session?.get('currentChallenge');
+    let userId = await session?.get('regUserId');
+    let username = body.username || (await session?.get('regUsername'));
+    let displayName = body.displayName || (await session?.get('regDisplayName'));
+
+    if (!expectedChallenge) {
+      // Fallback: extract challenge from clientDataJSON and check DB
+      try {
+        const clientData = JSON.parse(
+          Buffer.from(response.response.clientDataJSON, 'base64url').toString('utf8')
+        );
+        const record = consumeChallenge(clientData.challenge, 'registration');
+        if (record) {
+          expectedChallenge = record.challenge;
+          if (record.userId) userId = record.userId;
+        }
+      } catch (e) {
+        // Ignored
+      }
+    }
+
+    if (!expectedChallenge) {
+      return new Response(
+        JSON.stringify({ error: 'Registration session expired or invalid. Please try again.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    // Verify the WebAuthn registration
+    const verification = await verifyRegistration({
+      response,
+      expectedChallenge,
+      rpConfig,
+    });
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return new Response(
+        JSON.stringify({ error: 'Verification failed. Authenticator could not be registered.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    // Clear current challenge
+    await session?.set('currentChallenge', null);
+
+    // Identify or create the user
+    const currentUser = await getSessionUser(session);
+    let user;
+
+    if (currentUser) {
+      user = getUserById(currentUser.id);
+    } else if (userId) {
+      user = getUserById(userId);
+    }
+
+    if (!user && username) {
+      user = getUserByUsername(username);
+    }
+
+    if (!user) {
+      if (!username) {
+        return new Response(
+          JSON.stringify({ error: 'User information missing during registration verification.' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+      user = createUser(username, displayName);
+    }
+
+    const { credential, credentialDeviceType, credentialBackedUp, aaguid } =
+      verification.registrationInfo;
+
+    const savedPasskey = addPasskey({
+      id: credential.id,
+      userId: user.id,
+      name:
+        passkeyName?.trim() ||
+        `Passkey (${new Date().toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })})`,
+      publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+      counter: credential.counter,
+      transports: response.response.transports || undefined,
+      deviceType: credentialDeviceType,
+      backedUp: credentialBackedUp,
+      aaguid,
+    });
+
+    // Update user session and mark reauthenticated
+    await setSessionUser(session, user);
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        user: {
+          id: user.id,
+          username: user.username,
+          displayName: user.displayName,
+        },
+        passkey: {
+          id: savedPasskey.id,
+          name: savedPasskey.name,
+          createdAt: savedPasskey.createdAt,
+        },
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (error: any) {
+    console.error('Error verifying registration:', error);
+    return new Response(
+      JSON.stringify({ error: error.message || 'Registration verification failed' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
