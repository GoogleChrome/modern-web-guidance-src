+:root {
+  --primary: #4e342e;
+  --primary-hover: #3e2723;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --accent-hover: #ff9100;
+  --text: #3e2723;
+  --text-muted: #6d4c41;
+  --light: #fcfbfa;
+  --card-bg: #ffffff;
+  --border: #e0d7d2;
+  --success: #2e7d32;
+  --success-bg: #e8f5e9;
+  --warning: #ef6c00;
+  --warning-bg: #fff3e0;
+  --danger: #c62828;
+  --danger-bg: #ffebee;
+  --info: #0277bd;
+  --info-bg: #e1f5fe;
+  --shadow-sm: 0 2px 4px rgba(78, 52, 46, 0.08);
+  --shadow-md: 0 4px 12px rgba(78, 52, 46, 0.12);
+  --shadow-lg: 0 8px 24px rgba(78, 52, 46, 0.16);
+  --radius: 8px;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
+}
+
+.logo {
+  font-size: 1.4rem;
+  font-weight: 800;
+  letter-spacing: 1.5px;
+  color: white;
+  text-decoration: none;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.logo-badge {
+  background: var(--accent);
+  color: var(--primary);
+  font-size: 0.7rem;
+  padding: 2px 6px;
+  border-radius: 4px;
+  font-weight: bold;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+  align-items: center;
+  gap: 1.25rem;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.95rem;
+  font-weight: 500;
+  transition: color 0.2s, background-color 0.2s;
+  padding: 6px 10px;
+  border-radius: 4px;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.nav-btn {
+  background: transparent;
+  border: 1px solid var(--accent);
+  color: var(--accent) !important;
+  padding: 6px 14px;
+  border-radius: 6px;
+}
+
+.nav-btn:hover {
+  background: var(--accent);
+  color: var(--primary) !important;
+}
+
+.nav-btn-solid {
+  background: var(--accent);
+  color: var(--primary) !important;
+  font-weight: 600;
+}
+
+.nav-btn-solid:hover {
+  background: var(--accent-hover);
+}
+
+.user-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  background: rgba(255, 255, 255, 0.12);
+  padding: 4px 10px;
+  border-radius: 20px;
+  font-size: 0.85rem;
+}
+
+/* Hero Section */
+.hero {
+  height: 52vh;
+  min-height: 380px;
+  background: linear-gradient(rgba(30, 20, 15, 0.6), rgba(30, 20, 15, 0.6)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 2.8rem;
+  margin-bottom: 0.8rem;
+  font-weight: 800;
+  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);
+}
+
+.hero p {
+  font-size: 1.2rem;
+  max-width: 650px;
+  margin-bottom: 1.5rem;
+  opacity: 0.95;
+}
+
+.hero-actions {
