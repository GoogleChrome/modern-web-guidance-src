+
+app.post('/api/passkeys/register-options', requireAuth, async (req, res) => {
+  try {
+    const user = req.user;
+    const options = await generateRegistrationOptions({
+      rpName: 'The Daily Grind',
+      rpID: getRpId(req),
+      userID: Buffer.from(user.id, 'utf-8'),
+      userName: user.username,
+      userDisplayName: user.displayName,
+      attestationType: 'none',
+      excludeCredentials: (user.credentials || []).map(c => ({
+        id: c.id,
+        transports: c.transports,
+      })),
+      authenticatorSelection: {
+        residentKey: 'preferred',
+        userVerification: 'preferred',
+      },
+    });
+
+    req.session.currentChallenge = options.challenge;
+    req.session.addingPasskeyForUserId = user.id;
+
+    res.json(options);
+  } catch (err) {
+    console.error('Error generating add passkey options:', err);
+    res.status(500).json({ error: 'Failed to generate passkey options: ' + err.message });
+  }
+});
+
+app.post('/api/passkeys/register-verify', requireAuth, async (req, res) => {
+  try {
+    const { response, passkeyName } = req.body;
+    const challenge = req.session.currentChallenge;
+    const targetUserId = req.session.addingPasskeyForUserId;
+
+    if (!challenge || targetUserId !== req.user.id) {
+      return res.status(400).json({ error: 'Session challenge expired. Please retry.' });
+    }
+
+    const verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: challenge,
+      expectedOrigin: getAllowedOrigins(req),
+      expectedRPID: getAllowedRpIds(req),
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return res.status(400).json({ error: 'Passkey verification failed.' });
+    }
+
+    const { credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+
+    const newCred = db.addCredential(req.user.id, {
+      id: credential.id,
+      publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+      counter: credential.counter,
+      transports: credential.transports || response.response.transports || [],
+      deviceType: credentialDeviceType,
+      backedUp: credentialBackedUp,
+      name: passkeyName || `Passkey ${(req.user.credentials || []).length + 1}`,
+    });
+
+    req.session.currentChallenge = null;
+    req.session.addingPasskeyForUserId = null;
+    // Adding a passkey counts as active reauthentication
+    req.session.reauthenticatedAt = Date.now();
+
+    res.json({
+      verified: true,
+      passkey: {
+        id: newCred.id,
+        name: newCred.name,
+        deviceType: newCred.deviceType,
+        backedUp: newCred.backedUp,
+        transports: newCred.transports,
+        createdAt: newCred.createdAt,
+        lastUsedAt: newCred.lastUsedAt,
+      },
+    });
+  } catch (err) {
+    console.error('Error registering new passkey:', err);
+    res.status(400).json({ error: 'Failed to add passkey: ' + err.message });
+  }
+});
+
+app.patch('/api/passkeys/:id', requireAuth, (req, res) => {
+  const { id } = req.params;
+  const { name } = req.body;
+
+  if (!name || !name.trim()) {
+    return res.status(400).json({ error: 'Passkey name is required.' });
+  }
+
+  const updated = db.updateCredential(req.user.id, id, { name: name.trim() });
+  if (!updated) {
+    return res.status(404).json({ error: 'Passkey not found.' });
+  }
+
+  res.json({
+    ok: true,
+    passkey: {
+      id: updated.id,
+      name: updated.name,
+      deviceType: updated.deviceType,
+      backedUp: updated.backedUp,
+      transports: updated.transports,
+      createdAt: updated.createdAt,
+      lastUsedAt: updated.lastUsedAt,
+    },
+  });
+});
+
+app.delete('/api/passkeys/:id', requireAuth, (req, res) => {
+  const { id } = req.params;
+  const deleted = db.deleteCredential(req.user.id, id);
+  if (!deleted) {
+    return res.status(404).json({ error: 'Passkey not found.' });
+  }
+  res.json({ ok: true, message: 'Passkey deleted successfully.' });
+});
