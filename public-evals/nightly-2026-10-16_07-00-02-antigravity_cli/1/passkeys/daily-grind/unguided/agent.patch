+        <div>
+          <div style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); margin-bottom: 4px;">
+            Daily Grind Club Member
+          </div>
+          <h2 id="user-display-name" style="font-size: 1.8rem; margin-bottom: 4px;">Loading...</h2>
+          <p id="user-email" style="opacity: 0.85; font-size: 0.95rem;">loading@dailygrind.coffee</p>
