+  async checkSession() {
+    try {
+      const res = await fetch('/api/auth/me');
+      if (!res.ok) return { authenticated: false };
+      return await res.json();
+    } catch (err) {
+      return { authenticated: false };
+    }
+  },
+
+  async updateNav() {
+    const session = await this.checkSession();
+    const navLinks = document.getElementById('nav-links');
+    if (!navLinks) return session;
+
+    if (session.authenticated && session.user) {
+      navLinks.innerHTML = `
+        <li><a href="/menu">Menu</a></li>
+        <li><a href="/locations">Locations</a></li>
+        <li><a href="/rewards">Rewards</a></li>
+        <li><a href="/account" class="nav-btn-solid">My Account</a></li>
+        <li><span class="user-badge">☕ ${escapeHtml(session.user.displayName)} (${session.user.beans} beans)</span></li>
+        <li><a href="/logout" class="nav-btn">Logout</a></li>
+      `;
+    } else {
+      navLinks.innerHTML = `
+        <li><a href="/menu">Menu</a></li>
+        <li><a href="/locations">Locations</a></li>
+        <li><a href="/rewards">Rewards</a></li>
+        <li><a href="/login" class="nav-btn">Sign In</a></li>
+        <li><a href="/register" class="nav-btn-solid">Get Started</a></li>
+      `;
+    }
+    return session;
+  },
+
+  showAlert(containerId, message, type = 'danger') {
+    const container = document.getElementById(containerId);
+    if (!container) return;
+    const icons = {
+      danger: '⚠️',
+      success: '✅',
+      warning: '🔔',
+      info: 'ℹ️'
+    };
+    container.innerHTML = `
+      <div class="alert alert-${type}">
+        <span>${icons[type] || 'ℹ️'}</span>
+        <div>${escapeHtml(message)}</div>
+      </div>
+    `;
+  },
+
+  clearAlert(containerId) {
+    const container = document.getElementById(containerId);
+    if (container) container.innerHTML = '';
+  },
+
+  // Registration flow with passkey
+  async registerWithPasskey({ username, displayName, passkeyName, alertId = 'alert-container', submitBtnId = 'submit-btn' }) {
+    this.clearAlert(alertId);
+    const submitBtn = document.getElementById(submitBtnId);
+    if (submitBtn) {
+      submitBtn.disabled = true;
+      submitBtn.innerHTML = '<span class="spinner"></span> Creating Passkey...';
+    }
+
+    try {
+      // 1. Check browser support
+      if (!SimpleWebAuthnBrowser.browserSupportsWebAuthn()) {
+        throw new Error('Your browser or device does not support WebAuthn / Passkeys.');
+      }
+
+      // 2. Fetch registration options from server
+      const optRes = await fetch('/api/auth/register-options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username, displayName })
+      });
+
+      const options = await optRes.json();
+      if (!optRes.ok || options.error) {
+        throw new Error(options.error || 'Failed to initialize registration.');
+      }
+
+      // 3. Trigger WebAuthn create prompt on device
+      let attResp;
+      try {
+        attResp = await SimpleWebAuthnBrowser.startRegistration({ optionsJSON: options });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          throw new Error('Passkey creation was canceled by user.');
+        }
+        throw new Error(err.message || 'Passkey creation failed.');
+      }
+
+      // 4. Send response to server for verification
+      const verifyRes = await fetch('/api/auth/register-verify', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          response: attResp,
+          passkeyName: passkeyName || undefined
+        })
+      });
+
+      const result = await verifyRes.json();
+      if (!verifyRes.ok || !result.verified) {
+        throw new Error(result.error || 'Failed to verify passkey with server.');
+      }
+
+      this.showAlert(alertId, 'Account created and passkey registered successfully! Redirecting...', 'success');
+      setTimeout(() => {
+        window.location.href = '/account';
+      }, 1000);
+      return result;
+    } catch (err) {
+      this.showAlert(alertId, err.message, 'danger');
+      if (submitBtn) {
+        submitBtn.disabled = false;
+        submitBtn.innerHTML = '🔑 Create Account with Passkey';
+      }
+      throw err;
+    }
+  },
+
+  // Authentication flow with passkey
+  async loginWithPasskey({ username, alertId = 'alert-container', submitBtnId = 'login-btn', isAutofill = false }) {
+    this.clearAlert(alertId);
+    const submitBtn = document.getElementById(submitBtnId);
+    if (submitBtn) {
+      submitBtn.disabled = true;
+      submitBtn.innerHTML = '<span class="spinner"></span> Verifying Passkey...';
+    }
+
+    try {
+      if (!SimpleWebAuthnBrowser.browserSupportsWebAuthn()) {
+        throw new Error('Your browser or device does not support WebAuthn / Passkeys.');
+      }
+
+      // 1. Fetch authentication options from server
+      const optRes = await fetch('/api/auth/login-options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username: username ? username.trim() : undefined })
+      });
+
+      const options = await optRes.json();
+      if (!optRes.ok || options.error) {
+        throw new Error(options.error || 'Failed to initialize authentication.');
+      }
+
+      // 2. Trigger WebAuthn assertion prompt on device
+      let asseResp;
+      try {
+        asseResp = await SimpleWebAuthnBrowser.startAuthentication({
+          optionsJSON: options,
+          useBrowserAutofill: isAutofill
+        });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          throw new Error('Passkey sign-in was canceled.');
+        }
+        throw new Error(err.message || 'Passkey verification failed.');
+      }
+
+      // 3. Send response to server for verification
+      const verifyRes = await fetch('/api/auth/login-verify', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ response: asseResp })
+      });
+
+      const result = await verifyRes.json();
+      if (!verifyRes.ok || !result.verified) {
+        throw new Error(result.error || 'Authentication failed.');
+      }
+
+      this.showAlert(alertId, 'Welcome back, ' + result.user.displayName + '! Redirecting...', 'success');
+      setTimeout(() => {
+        window.location.href = '/account';
+      }, 800);
+      return result;
+    } catch (err) {
+      if (!isAutofill) {
+        this.showAlert(alertId, err.message, 'danger');
+      }
+      if (submitBtn) {
+        submitBtn.disabled = false;
+        submitBtn.innerHTML = '🔑 Sign In with Passkey';
+      }
+      throw err;
+    }
+  }
+};
+
+function escapeHtml(str) {
+  if (!str) return '';
+  return String(str)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;');
+}
+
+document.addEventListener('DOMContentLoaded', () => {
+  Auth.updateNav();
+});
