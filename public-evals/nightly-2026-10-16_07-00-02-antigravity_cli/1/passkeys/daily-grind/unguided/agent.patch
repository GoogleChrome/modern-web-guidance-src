new file mode 100644
index 0000000..b46d356
--- /dev/null
+++ b/db.js
@@ -0,0 +1,169 @@
+const fs = require('fs');
+const path = require('path');
+const crypto = require('crypto');
+
+const DB_PATH = path.join(__dirname, 'data', 'db.json');
+
+class Database {
+  constructor(filePath = DB_PATH) {
+    this.filePath = filePath;
+    this.data = { users: [] };
+    this.load();
+  }
+
+  load() {
+    try {
+      if (fs.existsSync(this.filePath)) {
+        const raw = fs.readFileSync(this.filePath, 'utf-8');
+        this.data = JSON.parse(raw);
+      } else {
+        this.save();
+      }
+    } catch (err) {
+      console.error('Failed to load DB, initializing fresh:', err.message);
+      this.data = { users: [] };
+    }
+  }
+
+  save() {
+    try {
+      const dir = path.dirname(this.filePath);
+      if (!fs.existsSync(dir)) {
+        fs.mkdirSync(dir, { recursive: true });
+      }
+      fs.writeFileSync(this.filePath, JSON.stringify(this.data, null, 2), 'utf-8');
+    } catch (err) {
+      console.error('Failed to save DB:', err.message);
+    }
+  }
+
+  getUserById(id) {
+    return this.data.users.find(u => u.id === id) || null;
+  }
+
+  getUserByUsername(username) {
+    if (!username) return null;
+    const lower = username.trim().toLowerCase();
+    return this.data.users.find(u => u.username.toLowerCase() === lower) || null;
+  }
+
+  getUserByCredentialId(credId) {
+    if (!credId) return null;
+    for (const user of this.data.users) {
+      const cred = (user.credentials || []).find(c => c.id === credId);
+      if (cred) {
+        return { user, credential: cred };
+      }
+    }
+    return null;
+  }
+
+  createUser({ username, displayName, initialBeans = 250 }) {
+    const existing = this.getUserByUsername(username);
+    if (existing) {
+      throw new Error('User already exists');
+    }
+
+    const newUser = {
+      id: 'usr_' + crypto.randomBytes(8).toString('hex'),
+      username: username.trim(),
+      displayName: (displayName || username.split('@')[0] || 'Coffee Enthusiast').trim(),
+      beans: initialBeans,
+      role: 'member',
+      createdAt: new Date().toISOString(),
+      credentials: []
+    };
+
+    this.data.users.push(newUser);
+    this.save();
+    return newUser;
+  }
+
+  addCredential(userId, credData) {
+    const user = this.getUserById(userId);
+    if (!user) throw new Error('User not found');
+
+    const cred = {
+      id: credData.id,
+      publicKey: credData.publicKey,
+      counter: credData.counter || 0,
+      transports: credData.transports || [],
+      deviceType: credData.deviceType || 'unknown',
+      backedUp: Boolean(credData.backedUp),
+      name: credData.name || `Passkey ${user.credentials.length + 1}`,
+      createdAt: credData.createdAt || new Date().toISOString(),
+      lastUsedAt: credData.lastUsedAt || new Date().toISOString()
+    };
+
+    user.credentials.push(cred);
+    this.save();
+    return cred;
+  }
+
+  updateCredential(userId, credId, updates) {
+    const user = this.getUserById(userId);
+    if (!user) return null;
+
+    const cred = (user.credentials || []).find(c => c.id === credId);
+    if (!cred) return null;
+
+    if (updates.name !== undefined) cred.name = updates.name.trim();
+    if (updates.counter !== undefined) cred.counter = updates.counter;
+    if (updates.lastUsedAt !== undefined) cred.lastUsedAt = updates.lastUsedAt;
+    if (updates.transports !== undefined) cred.transports = updates.transports;
+
+    this.save();
+    return cred;
+  }
+
+  deleteCredential(userId, credId) {
+    const user = this.getUserById(userId);
+    if (!user) return false;
+
+    const initialLength = user.credentials.length;
+    user.credentials = user.credentials.filter(c => c.id !== credId);
+    if (user.credentials.length !== initialLength) {
+      this.save();
+      return true;
+    }
+    return false;
+  }
+
+  listCredentials(userId) {
+    const user = this.getUserById(userId);
+    if (!user) return [];
+    return (user.credentials || []).map(c => ({
+      id: c.id,
+      name: c.name,
+      deviceType: c.deviceType,
+      backedUp: c.backedUp,
+      transports: c.transports,
+      createdAt: c.createdAt,
+      lastUsedAt: c.lastUsedAt
+    }));
+  }
+
+  updateUser(userId, updates) {
+    const user = this.getUserById(userId);
+    if (!user) return null;
+
+    if (updates.displayName !== undefined) user.displayName = updates.displayName.trim();
+    if (updates.beans !== undefined) user.beans = updates.beans;
+    if (updates.securityEmail !== undefined) user.securityEmail = updates.securityEmail;
+
+    this.save();
+    return user;
+  }
+
+  clear() {
+    this.data = { users: [] };
+    this.save();
+  }
+}
+
+const db = new Database();
+
+module.exports = {
+  Database,
+  db
+};
