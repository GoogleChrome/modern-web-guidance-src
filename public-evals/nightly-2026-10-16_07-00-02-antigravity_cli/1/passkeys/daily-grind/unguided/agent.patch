+// ==========================================
+// REAUTHENTICATION (Step-Up Authentication)
+// ==========================================
+
+app.get('/api/auth/reauth-status', requireAuth, (req, res) => {
+  const reauthRemainingMs = req.session.reauthenticatedAt
+    ? Math.max(0, REAUTH_WINDOW_MS - (Date.now() - req.session.reauthenticatedAt))
+    : 0;
+
+  res.json({
+    isReauthenticated: reauthRemainingMs > 0,
+    remainingMs: reauthRemainingMs,
+    reauthenticatedAt: req.session.reauthenticatedAt || null,
+    windowMs: REAUTH_WINDOW_MS,
+  });
+});
+
+app.post('/api/auth/reauth-options', requireAuth, async (req, res) => {
+  try {
+    const user = req.user;
+    if (!user.credentials || user.credentials.length === 0) {
+      return res.status(400).json({ error: 'No passkeys found for reauthentication.' });
+    }
+
+    const options = await generateAuthenticationOptions({
+      rpID: getRpId(req),
+      userVerification: 'preferred',
+      allowCredentials: user.credentials.map(c => ({
+        id: c.id,
+        transports: c.transports,
+      })),
+    });
+
+    req.session.currentChallenge = options.challenge;
+    req.session.isReauth = true;
+
+    res.json(options);
+  } catch (err) {
+    console.error('Error generating reauth options:', err);
+    res.status(500).json({ error: 'Failed to generate reauth options: ' + err.message });
+  }
+});
+
+app.post('/api/auth/reauth-verify', requireAuth, async (req, res) => {
+  try {
+    const { response } = req.body;
+    const challenge = req.session.currentChallenge;
+
+    if (!challenge || !req.session.isReauth) {
+      return res.status(400).json({ error: 'Reauthentication session expired. Please retry.' });
+    }
+
+    if (!response || !response.id) {
+      return res.status(400).json({ error: 'Invalid response payload.' });
+    }
+
+    const cred = (req.user.credentials || []).find(c => c.id === response.id);
+    if (!cred) {
+      return res.status(403).json({ error: 'Credential does not belong to the current authenticated user.' });
+    }
+
+    const verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: challenge,
+      expectedOrigin: getAllowedOrigins(req),
+      expectedRPID: getAllowedRpIds(req),
+      credential: {
+        id: cred.id,
+        publicKey: Buffer.from(cred.publicKey, 'base64url'),
+        counter: cred.counter,
+        transports: cred.transports,
+      },
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified) {
+      return res.status(400).json({ error: 'Reauthentication verification failed.' });
+    }
+
+    db.updateCredential(req.user.id, cred.id, {
+      counter: verification.authenticationInfo.newCounter,
+      lastUsedAt: new Date().toISOString(),
+    });
+
+    req.session.currentChallenge = null;
+    req.session.isReauth = false;
+    req.session.reauthenticatedAt = Date.now();
+
+    res.json({
+      verified: true,
+      reauthenticatedAt: req.session.reauthenticatedAt,
+      remainingMs: REAUTH_WINDOW_MS,
+    });
+  } catch (err) {
+    console.error('Error verifying reauthentication:', err);
+    res.status(400).json({ error: 'Reauthentication error: ' + err.message });
+  }
+});
