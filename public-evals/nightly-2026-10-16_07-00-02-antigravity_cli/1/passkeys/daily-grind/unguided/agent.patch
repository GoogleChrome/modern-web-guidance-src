+const express = require('express');
+const session = require('express-session');
+const cookieParser = require('cookie-parser');
+const path = require('path');
+const {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} = require('@simplewebauthn/server');
+const { db } = require('./db');
+
+const app = express();
+const PORT = parseInt(process.env.PORT, 10) || 11222;
+const REAUTH_WINDOW_MS = 5 * 60 * 1000; // 5 minutes reauthentication window
+
+app.use(express.json());
+app.use(express.urlencoded({ extended: true }));
+app.use(cookieParser());
+app.use(
+  session({
+    secret: process.env.SESSION_SECRET || 'daily-grind-secret-key-188201',
+    resave: false,
+    saveUninitialized: false,
+    cookie: {
+      httpOnly: true,
+      secure: process.env.NODE_ENV === 'production',
+      sameSite: 'lax',
+      maxAge: 24 * 60 * 60 * 1000,
+    },
+  })
+);
+
+// Serve static assets from public/ directory
+app.use(express.static(path.join(__dirname, 'public')));
+
+// Helpers for RP ID and Origin
+function getRpId(req) {
+  if (process.env.RP_ID) return process.env.RP_ID;
+  const host = req.headers.host || 'localhost';
+  return host.split(':')[0];
+}
+
+function getAllowedOrigins(req) {
+  const origins = new Set();
+  if (process.env.EXPECTED_ORIGIN) {
+    origins.add(process.env.EXPECTED_ORIGIN);
+  }
+  const host = req.headers.host || `localhost:${PORT}`;
+  const proto = req.headers['x-forwarded-proto'] || req.protocol || 'http';
+  origins.add(`${proto}://${host}`);
+  origins.add(`http://localhost:${PORT}`);
+  origins.add(`http://127.0.0.1:${PORT}`);
+  origins.add(`https://localhost:${PORT}`);
+  origins.add(`https://127.0.0.1:${PORT}`);
+  return Array.from(origins);
+}
+
+function getAllowedRpIds(req) {
+  const rpIds = new Set();
+  const current = getRpId(req);
+  rpIds.add(current);
+  rpIds.add('localhost');
+  rpIds.add('127.0.0.1');
+  return Array.from(rpIds);
+}
+
+// Authentication Middlewares
+function requireAuth(req, res, next) {
+  if (!req.session || !req.session.userId) {
+    return res.status(401).json({ error: 'unauthorized', message: 'You must be logged in.' });
+  }
+  const user = db.getUserById(req.session.userId);
+  if (!user) {
+    req.session.destroy();
+    return res.status(401).json({ error: 'unauthorized', message: 'User not found.' });
+  }
+  req.user = user;
+  next();
+}
+
+function isReauthenticated(req) {
+  if (!req.session || !req.session.reauthenticatedAt) return false;
+  return Date.now() - req.session.reauthenticatedAt < REAUTH_WINDOW_MS;
+}
+
+function requireRecentReauth(req, res, next) {
+  if (!isReauthenticated(req)) {
+    return res.status(403).json({
+      error: 'reauthentication_required',
+      message: 'Step-up passkey reauthentication required to perform this sensitive action.',
+      reauthWindowMs: REAUTH_WINDOW_MS,
+    });
+  }
+  next();
+}
+
+// ==========================================
+// REGISTRATION (Sign up with Passkey)
+// ==========================================
+
+app.post('/api/auth/register-options', async (req, res) => {
+  try {
+    const { username, displayName } = req.body;
+    if (!username || !username.trim()) {
+      return res.status(400).json({ error: 'Username or email is required.' });
+    }
+
+    const trimmedUsername = username.trim();
+    const existing = db.getUserByUsername(trimmedUsername);
+    if (existing) {
+      return res.status(400).json({ error: 'An account with this email/username already exists.' });
+    }
+
+    // Temporary ID for registration challenge
+    const tempUserId = 'usr_' + Buffer.from(trimmedUsername).toString('hex').slice(0, 16);
+
+    const options = await generateRegistrationOptions({
+      rpName: 'The Daily Grind',
+      rpID: getRpId(req),
+      userID: Buffer.from(tempUserId, 'utf-8'),
+      userName: trimmedUsername,
+      userDisplayName: displayName?.trim() || trimmedUsername.split('@')[0],
+      attestationType: 'none',
+      authenticatorSelection: {
+        residentKey: 'preferred',
+        userVerification: 'preferred',
+      },
+    });
+
+    req.session.currentChallenge = options.challenge;
+    req.session.registrationData = {
+      username: trimmedUsername,
+      displayName: displayName?.trim() || trimmedUsername.split('@')[0],
+    };
+
+    res.json(options);
+  } catch (err) {
+    console.error('Error generating registration options:', err);
+    res.status(500).json({ error: 'Failed to generate registration options: ' + err.message });
+  }
+});
+
+app.post('/api/auth/register-verify', async (req, res) => {
+  try {
+    const { response, passkeyName } = req.body;
+    const challenge = req.session.currentChallenge;
+    const regData = req.session.registrationData;
+
+    if (!challenge || !regData) {
+      return res.status(400).json({ error: 'Registration session expired. Please try again.' });
+    }
+
+    const verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: challenge,
+      expectedOrigin: getAllowedOrigins(req),
+      expectedRPID: getAllowedRpIds(req),
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return res.status(400).json({ error: 'Passkey verification failed.' });
+    }
+
+    const { credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+
+    // Check if user was created while registration was in progress
+    let user = db.getUserByUsername(regData.username);
+    if (!user) {
+      user = db.createUser({
+        username: regData.username,
+        displayName: regData.displayName,
+      });
+    }
+
+    db.addCredential(user.id, {
+      id: credential.id,
+      publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+      counter: credential.counter,
+      transports: credential.transports || response.response.transports || [],
+      deviceType: credentialDeviceType,
+      backedUp: credentialBackedUp,
+      name: passkeyName || `${regData.displayName}'s Passkey`,
+    });
+
+    // Clear challenge and log user in
+    req.session.currentChallenge = null;
+    req.session.registrationData = null;
+    req.session.userId = user.id;
+    req.session.reauthenticatedAt = Date.now();
+
+    res.json({
+      verified: true,
+      user: {
+        id: user.id,
+        username: user.username,
+        displayName: user.displayName,
+        beans: user.beans,
+      },
+    });
+  } catch (err) {
+    console.error('Error verifying registration:', err);
+    res.status(400).json({ error: 'Registration verification error: ' + err.message });
+  }
+});
