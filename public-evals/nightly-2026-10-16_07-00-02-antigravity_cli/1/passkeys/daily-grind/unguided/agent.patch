+// 1. Loyalty bean gift transfer (sensitive rewards action)
+app.post('/api/account/sensitive/gift-beans', requireAuth, requireRecentReauth, (req, res) => {
+  const { recipientEmail, amount } = req.body;
+  const transferAmount = parseInt(amount, 10);
+
+  if (!recipientEmail || !recipientEmail.trim()) {
+    return res.status(400).json({ error: 'Recipient email is required.' });
+  }
+  if (isNaN(transferAmount) || transferAmount <= 0) {
+    return res.status(400).json({ error: 'Transfer amount must be greater than 0.' });
+  }
+  if (req.user.beans < transferAmount) {
+    return res.status(400).json({ error: `Insufficient beans balance. You have ${req.user.beans} beans.` });
+  }
+
+  const newBalance = req.user.beans - transferAmount;
+  db.updateUser(req.user.id, { beans: newBalance });
+
+  res.json({
+    ok: true,
+    message: `Successfully transferred ${transferAmount} coffee beans to ${recipientEmail.trim()}!`,
+    remainingBeans: newBalance,
+  });
+});
