+// Account Dashboard: Passkey Management and Reauthentication
+
+const Account = {
+  user: null,
+  passkeys: [],
+  reauthTimer: null,
+  reauthRemainingMs: 0,
+
+  async init() {
+    const session = await Auth.checkSession();
+    if (!session.authenticated) {
+      window.location.href = '/login';
+      return;
+    }
+    this.user = session.user;
+    this.renderUserProfile();
+    await this.loadPasskeys();
+    await this.updateReauthStatus();
+    this.startReauthCountdown();
+    this.setupEventListeners();
+  },
+
+  renderUserProfile() {
+    document.getElementById('user-display-name').textContent = this.user.displayName;
+    document.getElementById('user-email').textContent = this.user.username;
+    document.getElementById('user-beans').textContent = this.user.beans;
+    if (document.getElementById('security-email-input')) {
+      document.getElementById('security-email-input').value = this.user.securityEmail || this.user.username;
+    }
+  },
+
+  // -------------------------------------------------------------
+  // Passkey Management: List, Add, Rename, Delete
+  // -------------------------------------------------------------
+
+  async loadPasskeys() {
+    try {
+      const res = await fetch('/api/passkeys');
+      if (!res.ok) throw new Error('Failed to load passkeys');
+      const data = await res.json();
+      this.passkeys = data.passkeys || [];
+      this.renderPasskeysList();
+    } catch (err) {
+      console.error(err);
+      Auth.showAlert('passkey-alert', 'Error loading passkeys: ' + err.message, 'danger');
+    }
+  },
+
+  renderPasskeysList() {
+    const container = document.getElementById('passkeys-container');
+    if (!container) return;
+
+    if (this.passkeys.length === 0) {
+      container.innerHTML = `
+        <div style="text-align: center; padding: 30px; color: var(--text-muted);">
+          <p style="font-size: 1.1rem; margin-bottom: 8px;">No passkeys registered yet.</p>
+          <p style="font-size: 0.9rem;">Add a passkey to secure your account with biometric or hardware authentication.</p>
+        </div>
+      `;
+      return;
+    }
+
+    container.innerHTML = this.passkeys.map(p => {
+      const createdDate = new Date(p.createdAt).toLocaleDateString(undefined, {
+        year: 'numeric',
+        month: 'short',
+        day: 'numeric'
+      });
+      const lastUsed = p.lastUsedAt ? new Date(p.lastUsedAt).toLocaleString(undefined, {
+        month: 'short',
+        day: 'numeric',
+        hour: '2-digit',
+        minute: '2-digit'
+      }) : 'Never';
+
+      const isPlatform = p.deviceType === 'platform' || (p.transports && p.transports.includes('internal'));
+      const icon = isPlatform ? '💻' : '🔑';
+      const deviceLabel = isPlatform ? 'Platform Authenticator' : 'Security Key / Roaming';
+      const backupBadge = p.backedUp ? '<span class="badge badge-success">Synced / Backed Up</span>' : '<span class="badge badge-primary">Single-Device</span>';
+
+      return `
+        <div class="passkey-item" data-id="${escapeHtml(p.id)}">
+          <div class="passkey-info">
+            <div class="passkey-icon">${icon}</div>
+            <div class="passkey-details">
+              <h4>
+                <span>${escapeHtml(p.name)}</span>
+                ${backupBadge}
+              </h4>
+              <div class="passkey-meta">
+                <span><strong>Type:</strong> ${deviceLabel}</span>
+                <span>•</span>
+                <span><strong>Added:</strong> ${createdDate}</span>
+                <span>•</span>
+                <span><strong>Last Used:</strong> ${lastUsed}</span>
+              </div>
+            </div>
+          </div>
+          <div class="passkey-actions">
+            <button class="btn btn-outline btn-sm" onclick="Account.openRenameModal('${escapeHtml(p.id)}', '${escapeHtml(p.name)}')">
+              ✏️ Rename
+            </button>
+            <button class="btn btn-danger btn-sm" onclick="Account.confirmDeletePasskey('${escapeHtml(p.id)}', '${escapeHtml(p.name)}')">
+              🗑️ Remove
+            </button>
+          </div>
+        </div>
+      `;
+    }).join('');
+  },
+
+  async addPasskey(passkeyName) {
+    Auth.clearAlert('passkey-alert');
+    const addBtn = document.getElementById('add-passkey-btn');
+    if (addBtn) {
+      addBtn.disabled = true;
+      addBtn.innerHTML = '<span class="spinner"></span> Registering Passkey...';
+    }
+
+    try {
+      if (!SimpleWebAuthnBrowser.browserSupportsWebAuthn()) {
+        throw new Error('Your browser does not support WebAuthn.');
+      }
+
+      // 1. Get options for adding passkey
+      const optRes = await fetch('/api/passkeys/register-options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' }
+      });
+      const options = await optRes.json();
+      if (!optRes.ok || options.error) {
+        throw new Error(options.error || 'Failed to initialize passkey registration.');
+      }
+
+      // 2. Browser prompt
+      const attResp = await SimpleWebAuthnBrowser.startRegistration({ optionsJSON: options });
+
+      // 3. Verify on server
+      const verifyRes = await fetch('/api/passkeys/register-verify', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          response: attResp,
+          passkeyName: passkeyName || undefined
+        })
+      });
+      const result = await verifyRes.json();
+      if (!verifyRes.ok || !result.verified) {
+        throw new Error(result.error || 'Failed to verify passkey.');
+      }
+
+      Auth.showAlert('passkey-alert', `Passkey "${result.passkey.name}" registered successfully!`, 'success');
+      await this.loadPasskeys();
+      await this.updateReauthStatus();
+      this.closeModal('add-passkey-modal');
+    } catch (err) {
+      if (err.name !== 'NotAllowedError') {
+        Auth.showAlert('passkey-alert', err.message, 'danger');
+      }
+    } finally {
+      if (addBtn) {
+        addBtn.disabled = false;
+        addBtn.innerHTML = '➕ Add New Passkey';
+      }
+    }
+  },
+
+  openRenameModal(id, currentName) {
+    document.getElementById('rename-passkey-id').value = id;
+    document.getElementById('rename-passkey-input').value = currentName;
+    this.openModal('rename-passkey-modal');
+  },
+
+  async submitRename() {
+    const id = document.getElementById('rename-passkey-id').value;
+    const newName = document.getElementById('rename-passkey-input').value;
+    if (!newName.trim()) return;
+
+    try {
+      const res = await fetch(`/api/passkeys/${encodeURIComponent(id)}`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name: newName.trim() })
+      });
+      const data = await res.json();
+      if (!res.ok || !data.ok) {
+        throw new Error(data.error || 'Failed to rename passkey.');
+      }
+      this.closeModal('rename-passkey-modal');
+      Auth.showAlert('passkey-alert', 'Passkey renamed successfully.', 'success');
+      await this.loadPasskeys();
+    } catch (err) {
+      Auth.showAlert('passkey-alert', err.message, 'danger');
+    }
+  },
+
+  async confirmDeletePasskey(id, name) {
+    if (this.passkeys.length <= 1) {
+      if (!confirm(`Warning: "${name}" is your only registered passkey. Deleting it may lock you out if you don't add another passkey. Are you sure?`)) {
+        return;
+      }
+    } else {
+      if (!confirm(`Are you sure you want to remove the passkey "${name}"?`)) {
+        return;
+      }
+    }
+
+    try {
+      const res = await fetch(`/api/passkeys/${encodeURIComponent(id)}`, {
+        method: 'DELETE'
+      });
+      const data = await res.json();
+      if (!res.ok || !data.ok) {
+        throw new Error(data.error || 'Failed to delete passkey.');
+      }
+      Auth.showAlert('passkey-alert', `Passkey "${name}" removed.`, 'success');
+      await this.loadPasskeys();
+    } catch (err) {
+      Auth.showAlert('passkey-alert', err.message, 'danger');
+    }
+  },
+
+  // -------------------------------------------------------------
+  // Reauthentication (Step-Up Authentication)
+  // -------------------------------------------------------------
+
+  async updateReauthStatus() {
+    try {
+      const res = await fetch('/api/auth/reauth-status');
+      if (!res.ok) return;
+      const data = await res.json();
+      this.reauthRemainingMs = data.remainingMs || 0;
+      this.renderReauthUI(data.isReauthenticated);
+    } catch (err) {
+      console.error('Failed to update reauth status:', err);
+    }
+  },
+
+  renderReauthUI(isReauth) {
+    const statusDot = document.getElementById('reauth-dot');
+    const statusText = document.getElementById('reauth-status-text');
+    const timerText = document.getElementById('reauth-timer-text');
+    const reauthBtn = document.getElementById('trigger-reauth-btn');
+
+    if (isReauth && this.reauthRemainingMs > 0) {
+      statusDot.className = 'status-dot active';
+      const secondsLeft = Math.floor(this.reauthRemainingMs / 1000);
+      const minutes = Math.floor(secondsLeft / 60);
+      const seconds = secondsLeft % 60;
+      statusText.innerHTML = `<strong>Status:</strong> <span style="color: var(--success); font-weight: bold;">Verified</span>`;
+      timerText.textContent = `Valid for ${minutes}m ${seconds.toString().padStart(2, '0')}s`;
+      if (reauthBtn) reauthBtn.textContent = '🔄 Re-verify Now';
+    } else {
+      statusDot.className = 'status-dot inactive';
+      statusText.innerHTML = `<strong>Status:</strong> <span style="color: var(--warning); font-weight: bold;">Verification Required</span>`;
+      timerText.textContent = 'Passkey reauthentication needed for sensitive actions';
+      if (reauthBtn) reauthBtn.textContent = '🔑 Reauthenticate with Passkey';
+    }
+  },
+
+  startReauthCountdown() {
+    if (this.reauthTimer) clearInterval(this.reauthTimer);
+    this.reauthTimer = setInterval(() => {
+      if (this.reauthRemainingMs > 1000) {
+        this.reauthRemainingMs -= 1000;
+        this.renderReauthUI(true);
+      } else if (this.reauthRemainingMs > 0) {
+        this.reauthRemainingMs = 0;
+        this.renderReauthUI(false);
+      }
+    }, 1000);
+  },
+
+  async reauthenticate(onSuccessCallback = null) {
+    Auth.clearAlert('sensitive-alert');
+    const reauthBtn = document.getElementById('trigger-reauth-btn');
+    if (reauthBtn) {
+      reauthBtn.disabled = true;
+      reauthBtn.innerHTML = '<span class="spinner"></span> Reauthenticating...';
+    }
+
+    try {
+      if (!SimpleWebAuthnBrowser.browserSupportsWebAuthn()) {
+        throw new Error('Your browser does not support WebAuthn.');
+      }
+
+      // 1. Fetch reauth options
+      const optRes = await fetch('/api/auth/reauth-options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' }
+      });
+      const options = await optRes.json();
+      if (!optRes.ok || options.error) {
+        throw new Error(options.error || 'Failed to initialize reauthentication.');
+      }
+
+      // 2. Prompt device
+      const asseResp = await SimpleWebAuthnBrowser.startAuthentication({ optionsJSON: options });
+
+      // 3. Verify on server
+      const verifyRes = await fetch('/api/auth/reauth-verify', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ response: asseResp })
+      });
+      const result = await verifyRes.json();
+      if (!verifyRes.ok || !result.verified) {
+        throw new Error(result.error || 'Reauthentication failed.');
+      }
+
+      this.reauthRemainingMs = result.remainingMs || 300000;
+      this.renderReauthUI(true);
+      Auth.showAlert('sensitive-alert', 'Passkey successfully verified! Sensitive actions unlocked.', 'success');
+
+      if (typeof onSuccessCallback === 'function') {
+        await onSuccessCallback();
+      }
+    } catch (err) {
+      if (err.name !== 'NotAllowedError') {
+        Auth.showAlert('sensitive-alert', 'Reauthentication failed: ' + err.message, 'danger');
+      }
+    } finally {
+      if (reauthBtn) {
+        reauthBtn.disabled = false;
+        this.renderReauthUI(this.reauthRemainingMs > 0);
+      }
+    }
+  },
+
+  // Wrap sensitive action with automatic reauth check
+  async executeWithReauth(actionFn) {
+    try {
+      await actionFn();
+    } catch (err) {
+      if (err.status === 403 || err.code === 'reauthentication_required') {
+        // Prompt reauth modal or automatic trigger
+        if (confirm('This action requires passkey reauthentication for security. Reauthenticate now?')) {
+          await this.reauthenticate(actionFn);
+        }
+      } else {
+        Auth.showAlert('sensitive-alert', err.message, 'danger');
+      }
+    }
+  },
+
+  // -------------------------------------------------------------
+  // Sensitive Actions
+  // -------------------------------------------------------------
+
+  async giftBeans() {
+    const recipient = document.getElementById('gift-recipient-input').value;
+    const amount = parseInt(document.getElementById('gift-amount-input').value, 10);
+
+    if (!recipient || !recipient.trim()) {
+      Auth.showAlert('sensitive-alert', 'Please provide a recipient email.', 'danger');
+      return;
+    }
+    if (isNaN(amount) || amount <= 0) {
+      Auth.showAlert('sensitive-alert', 'Please provide a valid beans amount.', 'danger');
+      return;
+    }
+
+    const action = async () => {
+      const res = await fetch('/api/account/sensitive/gift-beans', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ recipientEmail: recipient, amount })
+      });
+      const data = await res.json();
+      if (res.status === 403 && data.error === 'reauthentication_required') {
+        const err = new Error(data.message);
+        err.status = 403;
+        err.code = 'reauthentication_required';
+        throw err;
+      }
+      if (!res.ok || !data.ok) {
+        throw new Error(data.error || 'Failed to transfer beans.');
+      }
+
+      this.user.beans = data.remainingBeans;
+      this.renderUserProfile();
+      Auth.updateNav();
+      Auth.showAlert('sensitive-alert', `🎁 ${data.message}`, 'success');
+      document.getElementById('gift-recipient-input').value = '';
+    };
+
+    await this.executeWithReauth(action);
+  },
+
+  async revealVault() {
+    const action = async () => {
+      const res = await fetch('/api/account/sensitive/vault');
+      const data = await res.json();
+      if (res.status === 403 && data.error === 'reauthentication_required') {
+        const err = new Error(data.message);
+        err.status = 403;
+        err.code = 'reauthentication_required';
+        throw err;
+      }
+      if (!res.ok || !data.ok) {
+        throw new Error(data.error || 'Failed to unlock vault.');
+      }
+
+      const vaultContainer = document.getElementById('vault-display');
+      vaultContainer.style.display = 'block';
+      vaultContainer.innerHTML = `
+        <div style="background: #f1f8e9; border: 1.5px solid #aed581; padding: 18px; border-radius: 8px; margin-top: 14px;">
+          <h4 style="color: #33691e; margin-bottom: 8px;">🔐 High-Security Vault Unlocked</h4>
+          <p><strong>VIP Club Pass:</strong> <code>${escapeHtml(data.vault.vipPassCode)}</code></p>
+          <p><strong>Espresso Membership:</strong> <span class="badge badge-success">${escapeHtml(data.vault.unlimitedEspressoPass)}</span></p>
+          <p><strong>Primary Card:</strong> ${escapeHtml(data.vault.primaryPaymentMethod.cardType)} •••• ${escapeHtml(data.vault.primaryPaymentMethod.last4)} (Exp: ${escapeHtml(data.vault.primaryPaymentMethod.expiry)})</p>
+          <p><strong>Secret Coffee Token:</strong> <code>${escapeHtml(data.vault.secretCoffeeKey)}</code></p>
+        </div>
+      `;
+      Auth.showAlert('sensitive-alert', 'Vault secrets unlocked successfully!', 'success');
+    };
+
+    await this.executeWithReauth(action);
+  },
+
+  async updateSecurityEmail() {
+    const email = document.getElementById('security-email-input').value;
+    if (!email || !email.trim()) {
+      Auth.showAlert('sensitive-alert', 'Please enter a valid email address.', 'danger');
+      return;
+    }
+
+    const action = async () => {
+      const res = await fetch('/api/account/sensitive/update-security-email', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ securityEmail: email })
+      });
+      const data = await res.json();
+      if (res.status === 403 && data.error === 'reauthentication_required') {
+        const err = new Error(data.message);
+        err.status = 403;
+        err.code = 'reauthentication_required';
+        throw err;
+      }
+      if (!res.ok || !data.ok) {
+        throw new Error(data.error || 'Failed to update security email.');
+      }
+
+      Auth.showAlert('sensitive-alert', 'Security contact email updated to ' + data.securityEmail, 'success');
+    };
+
+    await this.executeWithReauth(action);
+  },
+
+  async deleteAccount() {
+    if (!confirm('DANGER: This will permanently delete your account, beans balance, and all passkeys. Proceed?')) {
+      return;
+    }
+
+    const action = async () => {
+      const res = await fetch('/api/account/sensitive/delete-account', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' }
+      });
+      const data = await res.json();
+      if (res.status === 403 && data.error === 'reauthentication_required') {
+        const err = new Error(data.message);
+        err.status = 403;
+        err.code = 'reauthentication_required';
+        throw err;
+      }
+      if (!res.ok || !data.ok) {
+        throw new Error(data.error || 'Failed to delete account.');
+      }
+
+      alert('Your account has been deleted. Returning to homepage.');
+      window.location.href = '/';
+    };
+
+    await this.executeWithReauth(action);
+  },
+
+  // Modal helpers
+  openModal(id) {
+    const el = document.getElementById(id);
+    if (el) el.classList.add('active');
+  },
+
+  closeModal(id) {
+    const el = document.getElementById(id);
+    if (el) el.classList.remove('active');
+  },
+
+  setupEventListeners() {
+    // Add passkey button
+    const openAddBtn = document.getElementById('open-add-passkey-btn');
+    if (openAddBtn) {
+      openAddBtn.addEventListener('click', () => {
+        document.getElementById('new-passkey-nickname').value = '';
+        this.openModal('add-passkey-modal');
+      });
+    }
+
+    const submitAddBtn = document.getElementById('add-passkey-btn');
+    if (submitAddBtn) {
+      submitAddBtn.addEventListener('click', () => {
+        const name = document.getElementById('new-passkey-nickname').value;
+        this.addPasskey(name);
+      });
+    }
+
+    // Rename passkey modal
+    const submitRenameBtn = document.getElementById('rename-passkey-btn');
+    if (submitRenameBtn) {
+      submitRenameBtn.addEventListener('click', () => this.submitRename());
+    }
+
+    // Reauth trigger button
+    const reauthBtn = document.getElementById('trigger-reauth-btn');
+    if (reauthBtn) {
+      reauthBtn.addEventListener('click', () => this.reauthenticate());
+    }
+
+    // Sensitive actions
+    const giftBtn = document.getElementById('gift-beans-btn');
+    if (giftBtn) {
+      giftBtn.addEventListener('click', () => this.giftBeans());
+    }
+
+    const vaultBtn = document.getElementById('reveal-vault-btn');
+    if (vaultBtn) {
+      vaultBtn.addEventListener('click', () => this.revealVault());
+    }
+
+    const emailBtn = document.getElementById('update-security-email-btn');
+    if (emailBtn) {
+      emailBtn.addEventListener('click', () => this.updateSecurityEmail());
+    }
+
+    const deleteBtn = document.getElementById('delete-account-btn');
+    if (deleteBtn) {
+      deleteBtn.addEventListener('click', () => this.deleteAccount());
+    }
+  }
+};
+
+document.addEventListener('DOMContentLoaded', () => {
+  Account.init();
+});
