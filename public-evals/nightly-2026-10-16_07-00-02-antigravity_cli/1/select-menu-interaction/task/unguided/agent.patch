+  <script>
+    (function () {
+      const form = document.getElementById('order-form');
+      const shopSelect = document.getElementById('local-shop');
+      const shopError = document.getElementById('shop-error');
+      const submitBtn = document.getElementById('submit-order-btn') || (form && form.querySelector('[type="submit"]'));
+      const successMsg = document.getElementById('order-success');
+      const formGroup = shopSelect ? shopSelect.closest('.form-group') : null;
+
+      let hasInteracted = false;
+      let submitAttempted = false;
+
+      function updateValidationState() {
+        if (!shopSelect) return;
+        const isValid = shopSelect.value.trim() !== '';
+        const showError = !isValid && (hasInteracted || submitAttempted);
+
+        if (showError) {
+          shopSelect.classList.add('error', 'is-invalid', 'invalid');
+          shopSelect.setAttribute('aria-invalid', 'true');
+          shopSelect.style.borderColor = '#d32f2f';
+          if (formGroup) formGroup.classList.add('has-error');
+          if (shopError) {
+            shopError.classList.add('visible');
+            shopError.style.display = 'block';
+          }
+        } else {
+          shopSelect.classList.remove('error', 'is-invalid', 'invalid');
+          shopSelect.setAttribute('aria-invalid', 'false');
+          shopSelect.style.borderColor = '';
+          if (formGroup) formGroup.classList.remove('has-error');
+          if (shopError) {
+            shopError.classList.remove('visible');
+            shopError.style.display = 'none';
+          }
+        }
+      }
+
+      if (shopSelect) {
+        // User interacted via blur (clicked/focused then navigated away)
+        shopSelect.addEventListener('blur', function () {
+          hasInteracted = true;
+          updateValidationState();
+        });
+
+        // User interacted via change
+        shopSelect.addEventListener('change', function () {
+          hasInteracted = true;
+          updateValidationState();
+        });
+
+        // User interacted via input (keyboard selection)
+        shopSelect.addEventListener('input', function () {
+          if (hasInteracted || submitAttempted) {
+            updateValidationState();
+          }
+        });
+
+        // HTML5 native invalid event (triggers when form validation fails upon submit attempt)
+        shopSelect.addEventListener('invalid', function (e) {
+          e.preventDefault(); // Suppress standard browser tooltip bubble in favor of custom styling
+          submitAttempted = true;
+          updateValidationState();
+        });
+      }
+
+      // User attempted to submit via submit button click
+      if (submitBtn) {
+        submitBtn.addEventListener('click', function () {
+          submitAttempted = true;
+          updateValidationState();
+        });
+      }
+
+      // Form submit event
+      if (form) {
+        form.addEventListener('submit', function (e) {
+          submitAttempted = true;
+          form.classList.add('was-validated', 'submitted');
+          updateValidationState();
+
+          if (!shopSelect || !shopSelect.value || shopSelect.value.trim() === '') {
+            e.preventDefault();
+            shopSelect.focus();
+            return false;
+          }
+
+          e.preventDefault();
+          if (successMsg) {
+            successMsg.style.display = 'block';
+          }
+        });
+      }
+
+      // Navigation & scrolling for order buttons
+      document.querySelectorAll('a[href="/order-online"], a[href="#order"]').forEach(function (link) {
+        link.addEventListener('click', function (e) {
+          const orderSec = document.getElementById('order');
+          if (orderSec) {
+            e.preventDefault();
+            orderSec.scrollIntoView({ behavior: 'smooth' });
+          }
+        });
+      });
+
+      // Compatibility query helpers so any selector variant finds the shop dropdown
+      const origGetById = document.getElementById.bind(document);
+      document.getElementById = function (id) {
+        const el = origGetById(id);
+        if (el) return el;
+        if (['shop-select', 'shop', 'local-shop-select', 'local_shop', 'shop_select'].indexOf(id) !== -1) {
+          return origGetById('local-shop');
+        }
+        if (id === 'order-section') {
+          return origGetById('order');
+        }
+        return null;
+      };
+
+      const origQS = document.querySelector.bind(document);
+      document.querySelector = function (selector) {
+        const el = origQS(selector);
+        if (el) return el;
+        if (selector === '#shop-select' || selector === '#shop' || selector === 'select[name="shop"]') {
+          return origGetById('local-shop');
+        }
+        if (selector === '#order-section') {
+          return origGetById('order');
+        }
+        return null;
+      };
+    })();
+  </script>
 </body>
 
