+  <script>
+    (function () {
+      const isFieldSizingSupported = window.CSS && CSS.supports && CSS.supports('field-sizing', 'content');
+      if (isFieldSizingSupported) return;
+
+      const measureWidth = (text, element) => {
+        const span = document.createElement('span');
+        const style = window.getComputedStyle(element);
+        span.style.font = style.font;
+        span.style.letterSpacing = style.letterSpacing;
+        span.style.visibility = 'hidden';
+        span.style.position = 'absolute';
+        span.style.whiteSpace = 'pre';
+        span.textContent = text || '';
+        document.body.appendChild(span);
+        const width = span.getBoundingClientRect().width;
+        document.body.removeChild(span);
+        return width;
+      };
+
+      const initFallbacks = () => {
+        document.querySelectorAll('input[type="text"]').forEach(input => {
+          const resize = () => {
+            const text = input.value || input.placeholder || '';
+            const width = measureWidth(text, input);
+            input.style.width = Math.max(width + 28, 50) + 'px';
+          };
+          input.addEventListener('input', resize);
+          resize();
+        });
+
+        document.querySelectorAll('select').forEach(select => {
+          const resize = () => {
+            const opt = select.options[select.selectedIndex];
+            const text = opt ? opt.text : '';
+            const width = measureWidth(text, select);
+            select.style.width = (width + 36) + 'px';
+          };
+          select.addEventListener('change', resize);
+          resize();
+        });
+
+        document.querySelectorAll('textarea').forEach(textarea => {
+          const resize = () => {
+            textarea.style.height = 'auto';
+            textarea.style.height = textarea.scrollHeight + 'px';
+          };
+          textarea.addEventListener('input', resize);
+          resize();
+        });
+      };
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initFallbacks);
+      } else {
+        initFallbacks();
+      }
+    })();
+  </script>
