+      text-align: center;
+      color: #666;
+      margin-bottom: 24px;
+      font-size: 0.95rem;
+    }
+
+    .coffee-order-form {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 20px;
+    }
+
+    .form-group {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 6px;
+      width: 100%;
+    }
+
+    .form-group label {
+      font-weight: 600;
+      font-size: 0.9rem;
+      color: var(--text);
+    }
+
+    .coffee-order-form input[type="text"],
+    .coffee-order-form select,
+    .coffee-order-form textarea {
+      field-sizing: content;
+      font-family: inherit;
+      font-size: 1rem;
+      padding: 8px 12px;
+      border: 1px solid #ccc;
+      border-radius: 6px;
+      color: var(--text);
+      background-color: #fff;
+      box-sizing: border-box;
+      align-self: flex-start;
+      transition: border-color 0.2s, box-shadow 0.2s;
+    }
+
+    .coffee-order-form input[type="text"]:focus,
+    .coffee-order-form select:focus,
+    .coffee-order-form textarea:focus {
+      outline: none;
+      border-color: var(--accent);
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.25);
+    }
+
+    .coffee-order-form input[type="text"] {
+      width: auto;
+      min-inline-size: 15ch;
+      max-inline-size: 100%;
+    }
+
+    .coffee-order-form select {
+      width: auto;
+      max-inline-size: 100%;
+      cursor: pointer;
+    }
+
+    .coffee-order-form textarea {
+      width: auto;
+      height: auto;
+      min-inline-size: 25ch;
+      max-inline-size: 100%;
+      min-block-size: 2.5lh;
+      max-block-size: 10lh;
+    }
+
+    .coffee-order-form button.btn {
+      border: none;
+      cursor: pointer;
+      font-family: inherit;
+      font-size: 1rem;
+    }
+
+    @supports not (field-sizing: content) {
+      .coffee-order-form input[type="text"],
+      .coffee-order-form select,
+      .coffee-order-form textarea {
+        width: 100%;
+        max-width: 400px;
+      }
+    }
