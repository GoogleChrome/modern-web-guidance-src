+  <script>
+    (function () {
+      const drawer = document.getElementById('nav-drawer');
+      const menuBtn = document.getElementById('menu-btn');
+      const closeBtn = document.getElementById('close-btn');
+      const backdrop = document.getElementById('drawer-backdrop');
+      const drawerLinks = drawer ? drawer.querySelectorAll('a') : [];
+
+      function openDrawer() {
+        if (!drawer || drawer.open) return;
+        drawer.style.transform = '';
+        drawer.style.transition = '';
+        if (typeof drawer.showModal === 'function') {
+          drawer.showModal();
+        } else {
+          drawer.setAttribute('open', '');
+        }
+        menuBtn.setAttribute('aria-expanded', 'true');
+        document.body.classList.add('drawer-open');
+        document.body.style.overflow = 'hidden';
+      }
+
+      function closeDrawer() {
+        if (!drawer || !drawer.open) return;
+        drawer.style.transform = '';
+        drawer.style.transition = '';
+        if (typeof drawer.close === 'function') {
+          drawer.close();
+        } else {
+          drawer.removeAttribute('open');
+        }
+        menuBtn.setAttribute('aria-expanded', 'false');
+        document.body.classList.remove('drawer-open');
+        document.body.style.overflow = '';
+      }
+
+      // Open / Toggle via Menu Button
+      if (menuBtn) {
+        menuBtn.addEventListener('click', () => {
+          if (drawer && drawer.open) {
+            closeDrawer();
+          } else {
+            openDrawer();
+          }
+        });
+      }
+
+      // Close button inside drawer
+      if (closeBtn) {
+        closeBtn.addEventListener('click', closeDrawer);
+      }
+
+      // Close when clicking any navigation link inside the drawer
+      drawerLinks.forEach((link) => {
+        link.addEventListener('click', closeDrawer);
+      });
+
+      // Synchronize state when dialog is closed natively (e.g. native Escape)
+      if (drawer) {
+        drawer.addEventListener('close', () => {
+          menuBtn.setAttribute('aria-expanded', 'false');
+          document.body.classList.remove('drawer-open');
+          document.body.style.overflow = '';
+          drawer.style.transform = '';
+          drawer.style.transition = '';
+        });
+
+        drawer.addEventListener('cancel', () => {
+          menuBtn.setAttribute('aria-expanded', 'false');
+          document.body.classList.remove('drawer-open');
+          document.body.style.overflow = '';
+        });
+      }
+
+      // Escape key listener for fast keyboard dismissal
+      window.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && drawer && drawer.open) {
+          closeDrawer();
+        }
+      });
+
+      // Tapping the Backdrop to Close
+      // 1. Native <dialog> backdrop click (event fired on dialog outside bounding box)
+      if (drawer) {
+        drawer.addEventListener('click', (e) => {
+          const rect = drawer.getBoundingClientRect();
+          const isInDialog = (
+            rect.top <= e.clientY &&
+            e.clientY <= rect.top + rect.height &&
+            rect.left <= e.clientX &&
+            e.clientX <= rect.left + rect.width
+          );
+          if (!isInDialog || e.target === drawer) {
+            closeDrawer();
+          }
+        });
+      }
+
+      // 2. Explicit backdrop element click
+      if (backdrop) {
+        backdrop.addEventListener('click', closeDrawer);
+      }
+
+      // Swipe Gesture Handling to dismiss the drawer natively
+      let startX = 0;
+      let startY = 0;
+      let currentX = 0;
+      let currentY = 0;
+      let startTime = 0;
+      let isDragging = false;
+      let isSwiping = false;
+      let isTouchActive = false;
+      let activePointerId = null;
+
+      function onGestureStart(x, y) {
+        startX = x;
+        startY = y;
+        currentX = x;
+        currentY = y;
+        startTime = Date.now();
+        isDragging = true;
+        isSwiping = false;
+        if (drawer) {
+          drawer.style.transition = 'none';
+        }
+      }
+
+      function onGestureMove(x, y, e) {
+        if (!isDragging || !drawer) return;
+        currentX = x;
+        currentY = y;
+        const dx = currentX - startX;
+        const dy = currentY - startY;
+
+        if (!isSwiping) {
+          if (Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) {
+            isSwiping = true;
+          }
+        }
+
+        if (isSwiping) {
+          if (e && e.cancelable) {
+            e.preventDefault();
+          }
+          // The drawer is docked to the right: dragging rightwards (dx > 0) translates toward off-screen
+          if (dx > 0) {
+            drawer.style.transform = `translateX(${dx}px)`;
+          } else {
+            drawer.style.transform = 'translateX(0)';
+          }
+        }
+      }
+
+      function onGestureEnd() {
+        if (!isDragging || !drawer) return;
+        isDragging = false;
+        const dx = currentX - startX;
+        const elapsed = Math.max(1, Date.now() - startTime);
+        const velocity = dx / elapsed;
+
+        drawer.style.transition = '';
+
+        if (isSwiping) {
+          // Dismiss condition:
+          // - Swiped rightwards (dx > 50px or flick velocity > 0.25 px/ms)
+          // - Or swiped horizontally substantially (> 70px in either direction)
+          const shouldDismiss = dx > 50 || (dx > 20 && velocity > 0.25) || Math.abs(dx) > 70;
+          if (shouldDismiss) {
+            closeDrawer();
+          } else {
+            drawer.style.transform = '';
+          }
+        } else {
+          drawer.style.transform = '';
+        }
+
+        isSwiping = false;
+        activePointerId = null;
+      }
+
+      if (drawer) {
+        // Touch Event Listeners
+        drawer.addEventListener('touchstart', (e) => {
+          if (e.touches.length === 1) {
+            isTouchActive = true;
+            onGestureStart(e.touches[0].clientX, e.touches[0].clientY);
+          }
+        }, { passive: true });
+
+        drawer.addEventListener('touchmove', (e) => {
+          if (e.touches.length === 1) {
+            onGestureMove(e.touches[0].clientX, e.touches[0].clientY, e);
+          }
+        }, { passive: false });
+
+        drawer.addEventListener('touchend', () => {
+          onGestureEnd();
+          setTimeout(() => { isTouchActive = false; }, 50);
+        });
+
+        drawer.addEventListener('touchcancel', () => {
+          onGestureEnd();
+          setTimeout(() => { isTouchActive = false; }, 50);
+        });
+
+        window.addEventListener('touchmove', (e) => {
+          if (isDragging && e.touches.length === 1) {
+            onGestureMove(e.touches[0].clientX, e.touches[0].clientY, e);
+          }
+        }, { passive: false });
+
+        window.addEventListener('touchend', () => {
+          if (isDragging) {
+            onGestureEnd();
+            setTimeout(() => { isTouchActive = false; }, 50);
+          }
+        });
+
+        // Pointer Event Listeners (Mouse / Pointer interactions)
+        drawer.addEventListener('pointerdown', (e) => {
+          if (isTouchActive) return;
+          activePointerId = e.pointerId;
+          onGestureStart(e.clientX, e.clientY);
+          try {
+            drawer.setPointerCapture(e.pointerId);
+          } catch (_) {}
+        });
+
+        drawer.addEventListener('pointermove', (e) => {
+          if (isTouchActive) return;
+          onGestureMove(e.clientX, e.clientY, e);
+        });
+
+        drawer.addEventListener('pointerup', (e) => {
+          if (isTouchActive) return;
+          onGestureEnd();
+          try {
+            drawer.releasePointerCapture(e.pointerId);
+          } catch (_) {}
+        });
+
+        drawer.addEventListener('pointercancel', (e) => {
+          if (isTouchActive) return;
+          onGestureEnd();
+        });
+
+        window.addEventListener('pointermove', (e) => {
+          if (!isTouchActive && isDragging && activePointerId !== null) {
+            onGestureMove(e.clientX, e.clientY, e);
+          }
+        });
+
+        window.addEventListener('pointerup', (e) => {
+          if (!isTouchActive && isDragging && activePointerId !== null) {
+            onGestureEnd();
+          }
+        });
+      }
+    })();
+  </script>
+
 </body>
 
