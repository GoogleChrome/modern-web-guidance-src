       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Interactive Motion Cards */
+    .card.spring,
+    .spring {
+      transform: scale(1);
+      transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
+      will-change: transform;
+    }
+
+    .card.spring:hover,
+    .spring:hover {
+      transform: scale(1.05);
+      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
+    }
+
+    .card.bounce,
+    .bounce {
+      transform: translateY(0) scale(1);
+      transition: transform 0.7s cubic-bezier(0.68, -0.6, 0.32, 1.6), box-shadow 0.7s cubic-bezier(0.68, -0.6, 0.32, 1.6);
+      will-change: transform;
+    }
+
+    .card.bounce:hover,
+    .bounce:hover {
+      transform: translateY(-8px) scale(1.03);
+      box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15);
+    }
+
+    /* Accessibility: Respect Reduced Motion Preferences */
+    @media (prefers-reduced-motion: reduce) {
+      .card.spring,
+      .card.bounce,
+      .spring,
+      .bounce,
+      .card.spring:hover,
+      .card.bounce:hover,
+      .spring:hover,
+      .bounce:hover {
+        transition: none !important;
+        animation: none !important;
+        transform: none !important;
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
