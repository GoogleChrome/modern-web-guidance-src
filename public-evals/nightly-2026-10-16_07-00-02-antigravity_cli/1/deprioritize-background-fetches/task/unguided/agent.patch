diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,30 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <title>Fetch Requests</title>
+</head>
+<body>
+  <button id="action-btn">Fetch Data</button>
+
+  <script>
+    document.getElementById('action-btn').addEventListener('click', () => {
+      // High-priority request for mission-critical data
+      fetch('/api/data', {
+        priority: 'high'
+      });
+
+      // Background analytics request
+      fetch('/api/analytics', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json'
+        },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low',
+        keepalive: true
+      });
+    });
+  </script>
+</body>
+</html>
