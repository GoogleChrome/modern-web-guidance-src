+  <script>
+    (function () {
+      // Coupon reveal logic
+      const couponBtn = document.getElementById('reveal-coupon-btn');
+      const couponPanel = document.getElementById('coupon-panel');
+
+      function revealCoupon() {
+        if (couponPanel) {
+          couponPanel.removeAttribute('hidden');
+        }
+        if (couponBtn) {
+          couponBtn.disabled = true;
+          couponBtn.textContent = 'Coupon Revealed';
+        }
+      }
+
+      if (couponBtn) {
+        couponBtn.addEventListener('click', revealCoupon);
+      }
+
+      if (couponPanel) {
+        couponPanel.addEventListener('beforematch', revealCoupon);
+      }
+
+      // Wholesale & Catering tabs logic
+      const wholesaleTabs = document.querySelectorAll('details.wholesale-tab');
+
+      wholesaleTabs.forEach(tab => {
+        // Forward direct clicks on details element to summary
+        tab.addEventListener('click', (e) => {
+          if (e.target === tab) {
+            const summary = tab.querySelector('summary');
+            if (summary) summary.click();
+          }
+        });
+
+        // Ensure mutual exclusivity even in environments without native details[name] support
+        tab.addEventListener('toggle', () => {
+          if (tab.open) {
+            const groupName = tab.getAttribute('name');
+            const selector = groupName
+              ? `details.wholesale-tab[name="${groupName}"]`
+              : 'details.wholesale-tab';
+            document.querySelectorAll(selector).forEach(other => {
+              if (other !== tab && other.open) {
+                other.removeAttribute('open');
+              }
+            });
+          }
+        });
+
+        // Handle beforematch when browser find-in-page locates text inside this tab
+        tab.addEventListener('beforematch', () => {
+          tab.setAttribute('open', '');
+          const groupName = tab.getAttribute('name');
+          const selector = groupName
+            ? `details.wholesale-tab[name="${groupName}"]`
+            : 'details.wholesale-tab';
+          document.querySelectorAll(selector).forEach(other => {
+            if (other !== tab && other.open) {
+              other.removeAttribute('open');
+            }
+          });
+        });
+      });
+    })();
+  </script>
+
