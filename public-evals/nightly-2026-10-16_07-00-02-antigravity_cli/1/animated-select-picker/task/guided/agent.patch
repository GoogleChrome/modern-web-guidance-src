+    .store-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      min-width: 270px;
+      padding: 0.75rem 1rem;
+      font-size: 1rem;
+      font-family: inherit;
+      color: var(--text);
+      background-color: #ffffff;
+      border: 2px solid transparent;
+      border-radius: 6px;
+      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.15);
+      cursor: pointer;
+      transition: border-color 0.2s ease, box-shadow 0.2s ease;
+    }
+
+    .store-select:hover,
+    .store-select:focus-visible {
+      border-color: var(--accent);
+      outline: none;
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.35);
+    }
+
+    .store-select button {
+      all: unset;
+      display: flex;
+      align-items: center;
+      flex: 1;
+      text-align: left;
+      cursor: pointer;
+    }
+
+    .store-select::picker-icon {
+      color: var(--primary);
+      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+    }
+
+    .store-select:open::picker-icon {
+      transform: rotate(180deg);
+    }
+
+    /* Picker menu with smooth fade in/out transitions */
+    .store-select::picker(select) {
+      background: #ffffff;
+      border-radius: 8px;
+      box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.25);
+      padding: 0.5rem;
+      margin-top: 0.35rem;
+      width: anchor-size(width);
+      min-width: 270px;
+      overflow: hidden;
+      border: 1px solid var(--secondary);
+
+      /* Transition setting for popover animations */
+      transition:
+        display 0.4s allow-discrete,
+        overlay 0.4s allow-discrete,
+        opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
+        height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
+      opacity: 0;
+      height: 0;
+    }
+
+    .store-select:open::picker(select) {
+      opacity: 1;
+      height: auto;
+    }
+
+    @starting-style {
+      .store-select:open::picker(select) {
+        opacity: 0;
+        height: 0;
+      }
+    }
+
+    .store-select option {
+      padding: 0.6rem 0.8rem;
+      border-radius: 4px;
+      color: var(--text);
+      cursor: pointer;
+      font-size: 0.95rem;
+      transition: background-color 0.15s ease;
+    }
+
+    .store-select option:hover {
+      background-color: var(--secondary);
+    }
+
+    .store-select option:checked {
+      font-weight: 700;
+      background-color: #efebe9;
+      color: var(--primary);
+    }
+
+    .store-select option::checkmark {
+      color: var(--primary);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker(select),
+      .store-select::picker-icon {
+        transition: none !important;
+      }
+    }
