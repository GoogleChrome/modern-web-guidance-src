+        savePasskeys();
+        render();
+        return true;
+      }
+      return false;
+    },
+    resetDefaults: resetToDefaults
+  };
+
+  // Start
+  document.addEventListener('DOMContentLoaded', () => {
+    loadPasskeys();
+    render();
+    initEvents();
+  });
+})();
