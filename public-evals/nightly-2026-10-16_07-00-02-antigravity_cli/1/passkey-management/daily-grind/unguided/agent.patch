+          publicKey: {
+            challenge: challenge,
+            timeout: 10000,
+            userVerification: 'preferred'
+          }
+        });
+      } catch (err) {
+        // Fallthrough - simulate verification
+      }
+    }
+
+    pk.lastUsed = new Date().toISOString();
+    savePasskeys();
+    render();
+    showToast(`✓ Passkey "${pk.name}" verified! Last used time updated.`, 'success');
+  }
+
+  // Reset to default sample passkeys
+  function resetToDefaults() {
+    passkeys = [...DEFAULT_PASSKEYS];
+    savePasskeys();
+    render();
+    showToast('Restored default passkeys.', 'info');
+  }
+
+  // Init Event Listeners
+  function initEvents() {
+    // Open Add Modal
+    const addBtn = document.getElementById('open-add-passkey-btn');
+    if (addBtn) addBtn.addEventListener('click', openAddModal);
+
+    const emptyAddBtn = document.getElementById('empty-add-passkey-btn');
