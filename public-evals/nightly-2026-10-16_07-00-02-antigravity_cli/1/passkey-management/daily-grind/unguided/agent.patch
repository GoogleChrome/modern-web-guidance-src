+  }
+
+  function handleRenameSubmit(e) {
+    e.preventDefault();
+    if (!pendingRenameId) return;
+    const newName = renameNameInput.value.trim();
+    if (!newName) return;
+
+    const pk = passkeys.find((k) => k.id === pendingRenameId);
+    if (pk) {
+      const oldName = pk.name;
+      pk.name = newName;
+      savePasskeys();
+      render();
+      showToast(`Passkey renamed to "${newName}".`, 'success');
+    }
+    closeModal(renameModal);
+    pendingRenameId = null;
+  }
+
+  // Delete Flow
+  function openDeleteModal(id) {
+    const pk = passkeys.find((k) => k.id === id);
+    if (!pk) return;
