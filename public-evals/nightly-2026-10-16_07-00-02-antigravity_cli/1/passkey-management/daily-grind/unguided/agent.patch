+        const id = e.currentTarget.getAttribute('data-id');
+        testPasskey(id);
+      });
+    });
+
+    // Delete buttons
+    document.querySelectorAll('.delete-btn').forEach((btn) => {
+      btn.addEventListener('click', (e) => {
+        const id = e.currentTarget.getAttribute('data-id');
+        openDeleteModal(id);
+      });
+    });
+  }
+
+  // Open / Close Modal helpers
+  function openModal(modalEl) {
+    if (modalEl) modalEl.classList.add('active');
+  }
+
+  function closeModal(modalEl) {
+    if (modalEl) modalEl.classList.remove('active');
+  }
+
+  // Add Passkey Flow
+  function openAddModal() {
+    const defaultInfo = detectDefaultDevice();
+    passkeyNameInput.value = defaultInfo.name;
+
+    // Set radio option
+    const radio = document.querySelector(`input[name="authenticator-type"][value="${defaultInfo.type}"]`);
+    if (radio) {
+      radio.checked = true;
+      updateDeviceOptionStyles();
+    }
+
+    openModal(addModal);
+    setTimeout(() => passkeyNameInput.focus(), 100);
+  }
+
+  function updateDeviceOptionStyles() {
+    document.querySelectorAll('.device-option-label').forEach((label) => {
+      const radio = label.querySelector('input[type="radio"]');
+      if (radio && radio.checked) {
+        label.classList.add('selected');
+      } else {
+        label.classList.remove('selected');
+      }
+    });
+  }
+
+  async function handleAddPasskeySubmit(e) {
+    e.preventDefault();
+    const name = passkeyNameInput.value.trim() || 'My Passkey';
+    const selectedRadio = document.querySelector('input[name="authenticator-type"]:checked');
+    const type = selectedRadio ? selectedRadio.value : 'apple';
+
+    let syncStatus = 'Synced Passkey';
+    if (type === 'apple') syncStatus = 'iCloud Keychain';
+    else if (type === 'windows') syncStatus = 'Windows Hello';
+    else if (type === 'android') syncStatus = 'Google Password Manager';
+    else if (type === 'yubikey') syncStatus = 'Hardware Security Key';
+
+    closeModal(addModal);
+
+    // Attempt real WebAuthn if supported, with graceful fallback
+    let credentialId = 'cred_' + Math.random().toString(36).substring(2, 10) + Date.now().toString(36);
+
+    if (window.PublicKeyCredential && typeof navigator.credentials?.create === 'function') {
+      try {
+        const challenge = new Uint8Array(32);
+        window.crypto.getRandomValues(challenge);
+        const userId = new Uint8Array(16);
+        window.crypto.getRandomValues(userId);
+
+        const credential = await navigator.credentials.create({
+          publicKey: {
+            challenge: challenge,
+            rp: {
+              name: 'The Daily Grind Coffee Co.',
+              id: window.location.hostname || 'localhost'
+            },
+            user: {
+              id: userId,
+              name: 'alex.morgan@dailygrind.coffee',
+              displayName: 'Alex Morgan'
+            },
+            pubKeyCredParams: [
+              { alg: -7, type: 'public-key' },
+              { alg: -257, type: 'public-key' }
+            ],
+            authenticatorSelection: {
+              authenticatorAttachment: type === 'yubikey' ? 'cross-platform' : 'platform',
+              userVerification: 'preferred',
+              residentKey: 'preferred'
+            },
+            timeout: 30000
+          }
+        });
+
+        if (credential && credential.id) {
+          credentialId = credential.id;
+        }
+      } catch (err) {
+        console.info('WebAuthn prompt was completed or skipped; registering passkey for account', err);
+      }
+    }
+
+    const newPasskey = {
+      id: credentialId,
+      name: name,
+      type: type,
+      created: new Date().toISOString(),
+      lastUsed: new Date().toISOString(),
+      syncStatus: syncStatus,
+      isSynced: type !== 'yubikey',
+      aaguid: type === 'yubikey' ? 'FIDO2 Security Key' : 'Platform Authenticator'
+    };
+
+    passkeys.unshift(newPasskey);
+    savePasskeys();
+    render();
+    showToast(`Passkey "${name}" registered successfully!`, 'success');
+  }
+
+  // Rename Flow
+  function openRenameModal(id) {
+    const pk = passkeys.find((k) => k.id === id);
