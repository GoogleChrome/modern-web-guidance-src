new file mode 100644
index 0000000..4daafb3
--- /dev/null
+++ b/src/pages/api/auth/session.ts
@@ -0,0 +1,30 @@
+import type { APIRoute } from 'astro';
+
+export const GET: APIRoute = async ({ session }) => {
+  const user = (await session?.get('user')) || null;
+  return new Response(JSON.stringify({ user }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const user = await request.json();
+    await session?.set('user', user);
+    return new Response(JSON.stringify({ success: true, user }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err) {
+    return new Response(JSON.stringify({ error: 'Failed to update session' }), { status: 400 });
+  }
+};
+
+export const DELETE: APIRoute = async ({ session }) => {
+  await session?.set('user', null);
+  return new Response(JSON.stringify({ success: true }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
diff --git a/src/pages/api/passkeys/[id].ts b/src/pages/api/passkeys/[id].ts
new file mode 100644
index 0000000..645e669
--- /dev/null
+++ b/src/pages/api/passkeys/[id].ts
@@ -0,0 +1,52 @@
+import type { APIRoute } from 'astro';
+import { updateServerPasskey, deleteServerPasskey } from '../../../utils/server-store';
+
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const { id } = params;
+  if (!id) {
+    return new Response(JSON.stringify({ error: 'Missing passkey ID' }), { status: 400 });
+  }
+
+  try {
+    const { username, label, lastUsedAt } = await request.json();
+    if (!username) {
+      return new Response(JSON.stringify({ error: 'Missing username' }), { status: 400 });
+    }
+
+    const updates: any = {};
+    if (label !== undefined) updates.label = label;
+    if (lastUsedAt !== undefined) updates.lastUsedAt = lastUsedAt;
+
+    const item = updateServerPasskey(username, id, updates);
+
+    return new Response(JSON.stringify({ success: true, passkey: item }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err) {
+    return new Response(JSON.stringify({ error: 'Failed to update passkey' }), { status: 500 });
+  }
+};
+
+export const DELETE: APIRoute = async ({ params, request, session }) => {
+  const { id } = params;
+  if (!id) {
+    return new Response(JSON.stringify({ error: 'Missing passkey ID' }), { status: 400 });
+  }
+
+  try {
+    const { username } = await request.json();
+    if (!username) {
+      return new Response(JSON.stringify({ error: 'Missing username' }), { status: 400 });
+    }
+
+    const success = deleteServerPasskey(username, id);
+
+    return new Response(JSON.stringify({ success }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err) {
+    return new Response(JSON.stringify({ error: 'Failed to delete passkey' }), { status: 500 });
+  }
+};
diff --git a/src/pages/api/passkeys/index.ts b/src/pages/api/passkeys/index.ts
