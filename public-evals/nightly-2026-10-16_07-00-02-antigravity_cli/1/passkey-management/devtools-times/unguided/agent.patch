--- /dev/null
+++ b/src/pages/api/passkeys/index.ts
@@ -0,0 +1,48 @@
+import type { APIRoute } from 'astro';
+import type { RegisteredPasskey } from '../../../utils/passkeys';
+import { getServerPasskeys, saveServerPasskey } from '../../../utils/server-store';
+
+export const GET: APIRoute = async ({ request, session }) => {
+  const url = new URL(request.url);
+  const username = url.searchParams.get('username') || (await session?.get('user'))?.username;
+
+  if (!username) {
+    return new Response(JSON.stringify({ error: 'Username is required' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const passkeys = getServerPasskeys(username);
+
+  return new Response(JSON.stringify({ passkeys }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const passkey: RegisteredPasskey = await request.json();
+
+    if (!passkey || !passkey.id || !passkey.username) {
+      return new Response(JSON.stringify({ error: 'Invalid passkey payload' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    saveServerPasskey(passkey);
+    await session?.set(`passkeys_${passkey.username.toLowerCase()}`, getServerPasskeys(passkey.username));
+
+    return new Response(JSON.stringify({ success: true, passkey }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err) {
+    return new Response(JSON.stringify({ error: 'Failed to save passkey' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
