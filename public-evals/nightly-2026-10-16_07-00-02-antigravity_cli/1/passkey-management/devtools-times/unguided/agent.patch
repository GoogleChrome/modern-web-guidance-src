diff --git a/src/utils/passkeys.ts b/src/utils/passkeys.ts
new file mode 100644
index 0000000..d8344c6
--- /dev/null
+++ b/src/utils/passkeys.ts
@@ -0,0 +1,422 @@
+export interface RegisteredPasskey {
+  id: string; // Base64URL credential ID
+  rawId?: string;
+  username: string;
+  label: string;
+  createdAt: string; // ISO date string
+  lastUsedAt: string | null; // ISO date string or null
+  transports?: string[]; // e.g. ['internal', 'hybrid', 'usb', 'nfc', 'ble']
+  algorithm?: string; // e.g. 'ES256' or 'RS256'
+  deviceType?: 'platform' | 'cross-platform' | 'security-key' | 'unknown';
+  backupState?: boolean;
+  aaguid?: string;
+}
+
+export interface CurrentUser {
+  username: string;
+  token?: string;
+}
+
+const STORAGE_USER_KEY = 'devtools_times_current_user';
+const STORAGE_PASSKEYS_PREFIX = 'devtools_times_passkeys_';
+
+/**
+ * Checks if the WebAuthn API is supported in the current browser/environment.
+ */
+export function isWebAuthnSupported(): boolean {
+  return (
+    typeof window !== 'undefined' &&
+    typeof window.PublicKeyCredential !== 'undefined' &&
+    typeof navigator !== 'undefined' &&
+    typeof navigator.credentials !== 'undefined' &&
+    typeof navigator.credentials.create === 'function' &&
+    typeof navigator.credentials.get === 'function'
+  );
+}
+
+/**
+ * Converts an ArrayBuffer to a URL-safe Base64 string.
+ */
+export function bufferToBase64URL(buffer: ArrayBuffer): string {
+  const bytes = new Uint8Array(buffer);
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary)
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '');
+}
+
+/**
+ * Converts a URL-safe Base64 string back to an ArrayBuffer.
+ */
+export function base64URLToBuffer(base64url: string): ArrayBuffer {
+  let base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
+  while (base64.length % 4) {
+    base64 += '=';
+  }
+  const binary = atob(base64);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes.buffer;
+}
+
+/**
+ * Gets the current logged in user from localStorage.
+ */
+export function getCurrentUser(): CurrentUser | null {
+  if (typeof window === 'undefined') return null;
+  try {
+    const raw = localStorage.getItem(STORAGE_USER_KEY);
+    return raw ? JSON.parse(raw) : null;
+  } catch (err) {
+    console.error('Failed to get current user from storage', err);
+    return null;
+  }
+}
+
+/**
+ * Sets or clears the current logged in user in localStorage and fires a custom event.
+ */
+export function setCurrentUser(user: CurrentUser | null): void {
+  if (typeof window === 'undefined') return null;
+  try {
+    if (user) {
+      localStorage.setItem(STORAGE_USER_KEY, JSON.stringify(user));
+    } else {
+      localStorage.removeItem(STORAGE_USER_KEY);
+    }
+    // Sync with Astro session endpoint (fire-and-forget)
+    fetch('/devtools-times/api/auth/session', {
+      method: user ? 'POST' : 'DELETE',
+      headers: { 'Content-Type': 'application/json' },
+      body: user ? JSON.stringify(user) : undefined,
+    }).catch(() => {});
+
+    // Dispatch an event so components update reactively
+    window.dispatchEvent(new CustomEvent('auth-state-changed', { detail: user }));
+  } catch (err) {
+    console.error('Failed to set current user in storage', err);
+  }
+}
+
+/**
+ * Retrieves the list of passkeys registered to a specific username.
+ */
+export function getUserPasskeys(username: string): RegisteredPasskey[] {
+  if (typeof window === 'undefined' || !username) return [];
+  try {
+    const raw = localStorage.getItem(`${STORAGE_PASSKEYS_PREFIX}${username.toLowerCase()}`);
+    if (!raw) return [];
+    return JSON.parse(raw);
+  } catch (err) {
+    console.error('Failed to retrieve passkeys for user', username, err);
+    return [];
+  }
+}
+
+/**
+ * Saves a new passkey for a user.
+ */
+export function saveUserPasskey(passkey: RegisteredPasskey): void {
+  if (typeof window === 'undefined' || !passkey.username) return;
+  try {
+    const key = `${STORAGE_PASSKEYS_PREFIX}${passkey.username.toLowerCase()}`;
+    const existing = getUserPasskeys(passkey.username);
+    // Replace if same id exists or append
+    const updated = existing.filter(p => p.id !== passkey.id);
+    updated.unshift(passkey);
+    localStorage.setItem(key, JSON.stringify(updated));
+
+    // Also sync to server API
+    fetch('/devtools-times/api/passkeys', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(passkey),
+    }).catch(() => {});
+
+    window.dispatchEvent(new CustomEvent('passkeys-changed', { detail: { username: passkey.username } }));
+  } catch (err) {
+    console.error('Failed to save passkey', err);
+  }
+}
+
+/**
+ * Renames an existing passkey.
+ */
+export function renameUserPasskey(username: string, id: string, newLabel: string): void {
+  if (typeof window === 'undefined' || !username) return;
+  try {
+    const key = `${STORAGE_PASSKEYS_PREFIX}${username.toLowerCase()}`;
+    const list = getUserPasskeys(username);
+    const item = list.find(p => p.id === id);
+    if (!item) return;
+
+    item.label = newLabel.trim() || item.label;
+    localStorage.setItem(key, JSON.stringify(list));
+
+    // Sync to server API
+    fetch(`/devtools-times/api/passkeys/${encodeURIComponent(id)}`, {
+      method: 'PATCH',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, label: item.label }),
+    }).catch(() => {});
+
+    window.dispatchEvent(new CustomEvent('passkeys-changed', { detail: { username } }));
+  } catch (err) {
+    console.error('Failed to rename passkey', err);
+  }
+}
+
+/**
+ * Deletes a passkey registered to a user.
+ */
+export function deleteUserPasskey(username: string, id: string): void {
+  if (typeof window === 'undefined' || !username) return;
+  try {
+    const key = `${STORAGE_PASSKEYS_PREFIX}${username.toLowerCase()}`;
+    const list = getUserPasskeys(username);
+    const updated = list.filter(p => p.id !== id);
+    localStorage.setItem(key, JSON.stringify(updated));
+
+    // Sync to server API
+    fetch(`/devtools-times/api/passkeys/${encodeURIComponent(id)}`, {
+      method: 'DELETE',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username }),
+    }).catch(() => {});
+
+    window.dispatchEvent(new CustomEvent('passkeys-changed', { detail: { username } }));
+  } catch (err) {
+    console.error('Failed to delete passkey', err);
+  }
+}
+
+/**
+ * Updates the lastUsedAt timestamp for a passkey.
+ */
+export function updatePasskeyLastUsed(username: string, id: string): void {
+  if (typeof window === 'undefined' || !username) return;
+  try {
+    const key = `${STORAGE_PASSKEYS_PREFIX}${username.toLowerCase()}`;
+    const list = getUserPasskeys(username);
+    const item = list.find(p => p.id === id);
+    if (!item) return;
+
+    item.lastUsedAt = new Date().toISOString();
+    localStorage.setItem(key, JSON.stringify(list));
+
+    // Sync to server API
+    fetch(`/devtools-times/api/passkeys/${encodeURIComponent(id)}`, {
+      method: 'PATCH',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, lastUsedAt: item.lastUsedAt }),
+    }).catch(() => {});
+
+    window.dispatchEvent(new CustomEvent('passkeys-changed', { detail: { username } }));
+  } catch (err) {
+    console.error('Failed to update passkey lastUsed', err);
+  }
+}
+
+/**
+ * Helper to get a sensible default name for a passkey based on the device / user agent.
+ */
+export function getDefaultPasskeyLabel(counter: number = 1): string {
+  if (typeof window === 'undefined') return `Passkey #${counter}`;
+  const ua = navigator.userAgent;
+  let device = 'Passkey';
+  if (/Macintosh/i.test(ua)) device = 'Mac';
+  else if (/iPhone/i.test(ua)) device = 'iPhone';
+  else if (/iPad/i.test(ua)) device = 'iPad';
+  else if (/Android/i.test(ua)) device = 'Android Device';
+  else if (/Windows/i.test(ua)) device = 'Windows PC';
+  else if (/Linux/i.test(ua)) device = 'Linux Machine';
+
+  let browser = '';
+  if (/Chrome/i.test(ua) && !/Edg/i.test(ua)) browser = 'Chrome';
+  else if (/Safari/i.test(ua) && !/Chrome/i.test(ua)) browser = 'Safari';
+  else if (/Firefox/i.test(ua)) browser = 'Firefox';
+  else if (/Edg/i.test(ua)) browser = 'Edge';
+
+  const nameParts = [device, browser].filter(Boolean);
+  return nameParts.length > 0 ? `${nameParts.join(' ')} (${counter})` : `Passkey #${counter}`;
+}
+
+/**
+ * Triggers the WebAuthn API to register a new passkey for the specified username.
+ */
+export async function createWebAuthnPasskey(
+  username: string,
+  customLabel?: string,
+  attachment?: AuthenticatorAttachment
+): Promise<RegisteredPasskey> {
+  if (!isWebAuthnSupported()) {
+    throw new Error('WebAuthn is not supported in this browser. Please use Chrome with WebAuthn enabled or test in Chrome DevTools.');
+  }
+
+  // Generate random 32-byte challenge
+  const challenge = new Uint8Array(32);
+  crypto.getRandomValues(challenge);
+
+  // User ID as bytes
+  const userIdBytes = new TextEncoder().encode(username);
+
+  const existingKeys = getUserPasskeys(username);
+  const excludeCredentials = existingKeys.map(k => ({
+    id: base64URLToBuffer(k.id),
+    type: 'public-key' as const,
+    transports: k.transports as AuthenticatorTransport[] | undefined,
+  }));
+
+  const creationOptions: CredentialCreationOptions = {
+    publicKey: {
+      challenge,
+      rp: {
+        name: 'The DevTools Times',
+        id: window.location.hostname === 'localhost' ? 'localhost' : window.location.hostname,
+      },
+      user: {
+        id: userIdBytes,
+        name: username,
+        displayName: username,
+      },
+      pubKeyCredParams: [
+        { alg: -7, type: 'public-key' },   // ES256
+        { alg: -257, type: 'public-key' }, // RS256
+        { alg: -8, type: 'public-key' },   // Ed25519
+      ],
+      timeout: 60000,
+      attestation: 'none',
+      excludeCredentials,
+      authenticatorSelection: {
+        residentKey: 'preferred',
+        requireResidentKey: false,
+        userVerification: 'preferred',
+        ...(attachment ? { authenticatorAttachment: attachment } : {}),
+      },
+    },
+  };
+
+  const credential = (await navigator.credentials.create(creationOptions)) as PublicKeyCredential | null;
+
+  if (!credential) {
+    throw new Error('No credential was returned by the authenticator.');
+  }
+
+  const response = credential.response as AuthenticatorAttestationResponse;
+  let transports: string[] = [];
+  if (typeof response.getTransports === 'function') {
+    transports = response.getTransports() || [];
+  }
+
+  let deviceType: 'platform' | 'cross-platform' | 'security-key' | 'unknown' = 'unknown';
+  if (attachment === 'platform' || transports.includes('internal')) {
+    deviceType = 'platform';
+  } else if (transports.includes('usb') || transports.includes('nfc') || transports.includes('ble')) {
+    deviceType = 'security-key';
+  } else if (transports.includes('hybrid')) {
+    deviceType = 'cross-platform';
+  } else {
+    deviceType = 'platform';
+  }
+
+  const label = customLabel?.trim() || getDefaultPasskeyLabel(existingKeys.length + 1);
+
+  const newPasskey: RegisteredPasskey = {
+    id: credential.id || bufferToBase64URL(credential.rawId),
+    rawId: bufferToBase64URL(credential.rawId),
+    username,
+    label,
+    createdAt: new Date().toISOString(),
+    lastUsedAt: null,
+    transports: transports.length > 0 ? transports : ['internal'],
+    algorithm: 'ES256',
+    deviceType,
+    backupState: true,
+  };
+
+  saveUserPasskey(newPasskey);
+  return newPasskey;
+}
+
+/**
+ * Triggers WebAuthn to authenticate with a passkey.
+ */
+export async function authenticateWithWebAuthn(
+  allowedCredentials?: RegisteredPasskey[]
+): Promise<{ credentialId: string; passkey?: RegisteredPasskey }> {
+  if (!isWebAuthnSupported()) {
+    throw new Error('WebAuthn is not supported in this browser.');
+  }
+
+  const challenge = new Uint8Array(32);
+  crypto.getRandomValues(challenge);
+
+  const getOptions: CredentialRequestOptions = {
+    publicKey: {
+      challenge,
+      rpId: window.location.hostname === 'localhost' ? 'localhost' : window.location.hostname,
+      timeout: 60000,
+      userVerification: 'preferred',
+      ...(allowedCredentials && allowedCredentials.length > 0
+        ? {
+            allowCredentials: allowedCredentials.map(k => ({
+              id: base64URLToBuffer(k.id),
+              type: 'public-key' as const,
+              transports: k.transports as AuthenticatorTransport[] | undefined,
+            })),
+          }
+        : {}),
+    },
+  };
+
+  const assertion = (await navigator.credentials.get(getOptions)) as PublicKeyCredential | null;
+  if (!assertion) {
+    throw new Error('Passkey verification was canceled or failed.');
+  }
+
+  const credentialId = assertion.id || bufferToBase64URL(assertion.rawId);
+  const matched = allowedCredentials?.find(k => k.id === credentialId);
+
+  return {
+    credentialId,
+    passkey: matched,
+  };
+}
+
+/**
+ * Creates a simulated passkey for quick testing in environments where hardware WebAuthn authenticators
+ * are not currently emulated or configured.
+ */
+export function createSimulatedPasskey(username: string, customLabel?: string): RegisteredPasskey {
+  const existingKeys = getUserPasskeys(username);
+  const randomBytes = new Uint8Array(16);
+  if (typeof crypto !== 'undefined' && crypto.getRandomValues) {
+    crypto.getRandomValues(randomBytes);
+  } else {
+    for (let i = 0; i < 16; i++) randomBytes[i] = Math.floor(Math.random() * 256);
+  }
+  const id = bufferToBase64URL(randomBytes.buffer);
+  const label = customLabel?.trim() || `Test Passkey (${existingKeys.length + 1})`;
+
+  const passkey: RegisteredPasskey = {
+    id,
+    rawId: id,
+    username,
+    label,
+    createdAt: new Date().toISOString(),
+    lastUsedAt: null,
+    transports: ['internal'],
+    algorithm: 'ES256',
+    deviceType: 'platform',
+    backupState: true,
+  };
+
+  saveUserPasskey(passkey);
+  return passkey;
+}
