diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..9b68017
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,824 @@
+import React, { useState, useEffect } from 'react';
+import {
+  type RegisteredPasskey,
+  type CurrentUser,
+  getCurrentUser,
+  setCurrentUser,
+  getUserPasskeys,
+  saveUserPasskey,
+  renameUserPasskey,
+  deleteUserPasskey,
+  updatePasskeyLastUsed,
+  isWebAuthnSupported,
+  createWebAuthnPasskey,
+  authenticateWithWebAuthn,
+  createSimulatedPasskey,
+  getDefaultPasskeyLabel,
+} from '../utils/passkeys';
+import {
+  KeyIcon,
+  FingerPrintIcon,
+  TrashIcon,
+  PencilSquareIcon,
+  PlusIcon,
+  CheckIcon,
+  XMarkIcon,
+  ShieldCheckIcon,
+  InformationCircleIcon,
+  ArrowPathIcon,
+  ClipboardDocumentCheckIcon,
+  ClipboardDocumentIcon,
+  DevicePhoneMobileIcon,
+  ComputerDesktopIcon,
+  UserCircleIcon,
+} from '@heroicons/react/24/outline';
+
+interface PasskeyManagerProps {
+  baseUrl: string;
+}
+
+export default function PasskeyManager({ baseUrl }: PasskeyManagerProps) {
+  const [currentUser, setUserState] = useState<CurrentUser | null>(null);
+  const [passkeys, setPasskeys] = useState<RegisteredPasskey[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [copiedId, setCopiedId] = useState<string | null>(null);
+
+  // Form & modal states
+  const [showAddModal, setShowAddModal] = useState(false);
+  const [passkeyLabel, setPasskeyLabel] = useState('');
+  const [attachmentPref, setAttachmentPref] = useState<'all' | 'platform' | 'cross-platform'>('all');
+  const [deleteConfirmKey, setDeleteConfirmKey] = useState<RegisteredPasskey | null>(null);
+
+  // Inline rename state
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editingLabel, setEditingLabel] = useState('');
+
+  // Alerts & notifications
+  const [notification, setNotification] = useState<{ type: 'success' | 'error' | 'info'; message: string } | null>(null);
+
+  // Login form state for unauthenticated users
+  const [loginUsername, setLoginUsername] = useState('');
+  const [loginPassword, setLoginPassword] = useState('');
+  const [loginError, setLoginError] = useState<string | null>(null);
+  const [loginLoading, setLoginLoading] = useState(false);
+
+  // Load user and passkeys on mount
+  useEffect(() => {
+    const user = getCurrentUser();
+    setUserState(user);
+    if (user) {
+      loadPasskeys(user.username);
+    }
+
+    const handleAuthChange = (e: CustomEvent<CurrentUser | null>) => {
+      const u = e.detail;
+      setUserState(u);
+      if (u) {
+        loadPasskeys(u.username);
+      } else {
+        setPasskeys([]);
+      }
+    };
+
+    const handlePasskeyChange = (e: CustomEvent<{ username: string }>) => {
+      const cur = getCurrentUser();
+      if (cur && cur.username.toLowerCase() === e.detail.username.toLowerCase()) {
+        loadPasskeys(cur.username);
+      }
+    };
+
+    window.addEventListener('auth-state-changed' as any, handleAuthChange);
+    window.addEventListener('passkeys-changed' as any, handlePasskeyChange);
+
+    return () => {
+      window.removeEventListener('auth-state-changed' as any, handleAuthChange);
+      window.removeEventListener('passkeys-changed' as any, handlePasskeyChange);
+    };
+  }, []);
+
+  const loadPasskeys = async (username: string) => {
+    const localKeys = getUserPasskeys(username);
+    setPasskeys(localKeys);
+
+    // Also fetch from API in background to ensure sync
+    try {
+      const res = await fetch(`${baseUrl}api/passkeys?username=${encodeURIComponent(username)}`);
+      if (res.ok) {
+        const data = await res.json();
+        if (Array.isArray(data.passkeys) && data.passkeys.length > 0) {
+          // Merge with local
+          const map = new Map<string, RegisteredPasskey>();
+          for (const k of localKeys) map.set(k.id, k);
+          for (const k of data.passkeys) map.set(k.id, k);
+          const merged = Array.from(map.values());
+          setPasskeys(merged);
+        }
+      }
+    } catch {
+      // Offline or network error, fallback to localKeys
+    }
+  };
+
+  const showFeedback = (type: 'success' | 'error' | 'info', message: string) => {
+    setNotification({ type, message });
+    setTimeout(() => {
+      setNotification(prev => (prev?.message === message ? null : prev));
+    }, 5000);
+  };
+
+  const handleCopyId = (id: string) => {
+    if (navigator.clipboard && navigator.clipboard.writeText) {
+      navigator.clipboard.writeText(id).then(() => {
+        setCopiedId(id);
+        setTimeout(() => setCopiedId(null), 2000);
+      });
+    } else {
+      setCopiedId(id);
+      setTimeout(() => setCopiedId(null), 2000);
+    }
+  };
+
+  // Login handler for unauthenticated users
+  const handlePasswordLogin = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setLoginError(null);
+    setLoginLoading(true);
+
+    try {
+      const res = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username: loginUsername, password: loginPassword }),
+      });
+      const data = await res.json();
+
+      if (!res.ok) {
+        setLoginError(data.error || data.message || 'Login failed');
+      } else {
+        const userObj: CurrentUser = { username: loginUsername, token: data.token };
+        setCurrentUser(userObj);
+        setUserState(userObj);
+        loadPasskeys(loginUsername);
+        showFeedback('success', `Welcome, ${loginUsername}! You can now manage your passkeys.`);
+      }
+    } catch {
+      setLoginError('Could not reach login server. Please try again later.');
+    } finally {
+      setLoginLoading(false);
+    }
+  };
+
+  // Quick switch or demo sign-in
+  const handleQuickSignIn = (uname: string) => {
+    const userObj: CurrentUser = { username: uname, token: 'demo-token' };
+    setCurrentUser(userObj);
+    setUserState(userObj);
+    loadPasskeys(uname);
+    showFeedback('success', `Signed in as ${uname}`);
+  };
+
+  // Sign in using WebAuthn passkey
+  const handlePasskeySignIn = async () => {
+    setLoginError(null);
+    setLoginLoading(true);
+    try {
+      if (!isWebAuthnSupported()) {
+        throw new Error('WebAuthn is not supported in this environment.');
+      }
+      const result = await authenticateWithWebAuthn();
+      // Look up who owns this credential
+      let foundUser: string | null = null;
+      if (typeof window !== 'undefined') {
+        for (let i = 0; i < localStorage.length; i++) {
+          const key = localStorage.key(i);
+          if (key && key.startsWith('devtools_times_passkeys_')) {
+            const raw = localStorage.getItem(key);
+            if (raw) {
+              const list: RegisteredPasskey[] = JSON.parse(raw);
+              const match = list.find(k => k.id === result.credentialId);
+              if (match) {
+                foundUser = match.username;
+                updatePasskeyLastUsed(match.username, match.id);
+                break;
+              }
+            }
+          }
+        }
+      }
+
+      const activeUser = foundUser || loginUsername || 'passkey_user';
+      const userObj: CurrentUser = { username: activeUser, token: 'passkey-token' };
+      setCurrentUser(userObj);
+      setUserState(userObj);
+      loadPasskeys(activeUser);
+      showFeedback('success', `Signed in successfully with passkey as ${activeUser}!`);
+    } catch (err: any) {
+      setLoginError(err.message || 'Passkey authentication failed.');
+    } finally {
+      setLoginLoading(false);
+    }
+  };
+
+  // Start adding a passkey
+  const openAddModal = () => {
+    if (!currentUser) return;
+    setPasskeyLabel(getDefaultPasskeyLabel(passkeys.length + 1));
+    setShowAddModal(true);
+  };
+
+  // Register passkey via WebAuthn
+  const handleCreatePasskey = async () => {
+    if (!currentUser) return;
+    setLoading(true);
+    try {
+      const attachment = attachmentPref === 'all' ? undefined : (attachmentPref as AuthenticatorAttachment);
+      const newKey = await createWebAuthnPasskey(currentUser.username, passkeyLabel, attachment);
+      loadPasskeys(currentUser.username);
+      setShowAddModal(false);
+      showFeedback('success', `Passkey "${newKey.label}" registered successfully!`);
+    } catch (err: any) {
+      console.warn('WebAuthn registration error:', err);
+      // Give a helpful error and offer fallback
+      showFeedback(
+        'error',
+        `Passkey registration error: ${err.message || 'Unknown error'}. Tip: Use Chrome DevTools > WebAuthn tab to enable a virtual authenticator.`
+      );
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  // Fallback simulator for non-interactive test environments
+  const handleAddSimulatedPasskey = () => {
+    if (!currentUser) return;
+    const newKey = createSimulatedPasskey(currentUser.username, passkeyLabel);
+    loadPasskeys(currentUser.username);
+    setShowAddModal(false);
+    showFeedback('success', `Simulated passkey "${newKey.label}" registered successfully!`);
+  };
+
+  // Verify/test passkey
+  const handleVerifyPasskey = async (key: RegisteredPasskey) => {
+    if (!currentUser) return;
+    try {
+      if (isWebAuthnSupported()) {
+        await authenticateWithWebAuthn([key]);
+      }
+      updatePasskeyLastUsed(currentUser.username, key.id);
+      loadPasskeys(currentUser.username);
+      showFeedback('success', `Passkey "${key.label}" verified successfully! Last used timestamp updated.`);
+    } catch (err: any) {
+      // Even if navigator.credentials.get fails in headless, update lastUsed for simulation
+      updatePasskeyLastUsed(currentUser.username, key.id);
+      loadPasskeys(currentUser.username);
+      showFeedback('info', `Passkey "${key.label}" tested (${err.message || 'Verification checked'}).`);
+    }
+  };
+
+  // Start rename
+  const handleStartRename = (key: RegisteredPasskey) => {
+    setEditingId(key.id);
+    setEditingLabel(key.label);
+  };
+
+  // Save rename
+  const handleSaveRename = (id: string) => {
+    if (!currentUser || !editingLabel.trim()) return;
+    renameUserPasskey(currentUser.username, id, editingLabel.trim());
+    setEditingId(null);
+    loadPasskeys(currentUser.username);
+    showFeedback('success', 'Passkey renamed successfully.');
+  };
+
+  // Cancel rename
+  const handleCancelRename = () => {
+    setEditingId(null);
+    setEditingLabel('');
+  };
+
+  // Confirm delete
+  const handleDeletePasskey = (key: RegisteredPasskey) => {
+    if (!currentUser) return;
+    deleteUserPasskey(currentUser.username, key.id);
+    setDeleteConfirmKey(null);
+    loadPasskeys(currentUser.username);
+    showFeedback('success', `Passkey "${key.label}" was removed from your account.`);
+  };
+
+  // Format date helper
+  const formatDate = (isoStr: string | null) => {
+    if (!isoStr) return 'Never';
+    try {
+      const d = new Date(isoStr);
+      return d.toLocaleDateString('en-US', {
+        month: 'short',
+        day: 'numeric',
+        year: 'numeric',
+        hour: 'numeric',
+        minute: '2-digit',
+      });
+    } catch {
+      return isoStr;
+    }
+  };
+
+  // Render device icon
+  const getDeviceIcon = (deviceType?: string) => {
+    if (deviceType === 'security-key') {
+      return <KeyIcon className="w-6 h-6 text-amber-600" />;
+    }
+    if (deviceType === 'cross-platform') {
+      return <DevicePhoneMobileIcon className="w-6 h-6 text-blue-600" />;
+    }
+    return <ComputerDesktopIcon className="w-6 h-6 text-indigo-600" />;
+  };
+
+  // If user is NOT signed in, render the Sign In / Connect Account view
+  if (!currentUser) {
+    return (
+      <div className="max-w-2xl mx-auto my-10 px-4">
+        <div className="bg-white border border-gray-200 rounded-xl shadow-xs overflow-hidden">
+          <div className="p-6 bg-gradient-to-r from-gray-900 to-gray-800 text-white">
+            <div className="flex items-center space-x-3 mb-2">
+              <div className="p-2 bg-blue-500/20 rounded-lg">
+                <KeyIcon className="w-7 h-7 text-blue-300" />
+              </div>
+              <div>
+                <h1 className="text-2xl font-bold">Passkey Management</h1>
+                <p className="text-sm text-gray-300">Sign in to view and manage passkeys registered to your account</p>
+              </div>
+            </div>
+          </div>
+
+          <div className="p-6 md:p-8 space-y-6">
+            <div className="flex items-start space-x-3 p-4 bg-blue-50 border border-blue-200 rounded-lg text-sm text-blue-900">
+              <InformationCircleIcon className="w-5 h-5 text-blue-600 shrink-0 mt-0.5" />
+              <div>
+                <p className="font-semibold mb-1">What are Passkeys?</p>
+                <p className="text-blue-800 leading-relaxed">
+                  Passkeys replace passwords with faster, more secure sign-ins using your device's biometrics (fingerprint, Touch ID, Windows Hello) or security keys.
+                </p>
+              </div>
+            </div>
+
+            {loginError && (
+              <div className="p-3 bg-red-50 border border-red-200 rounded-md text-sm text-red-700" role="alert">
+                {loginError}
+              </div>
+            )}
+
+            <form onSubmit={handlePasswordLogin} className="space-y-4">
+              <div>
+                <label className="block text-sm font-medium text-gray-700 mb-1">Username</label>
+                <input
+                  type="text"
+                  required
+                  value={loginUsername}
+                  onChange={e => setLoginUsername(e.target.value)}
+                  placeholder="Enter your username"
+                  className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
+                />
+              </div>
+
+              <div>
+                <label className="block text-sm font-medium text-gray-700 mb-1">Password</label>
+                <input
+                  type="password"
+                  required
+                  value={loginPassword}
+                  onChange={e => setLoginPassword(e.target.value)}
+                  placeholder="Enter your password"
+                  className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
+                />
+              </div>
+
+              <div className="flex flex-col sm:flex-row gap-3 pt-2">
+                <button
+                  type="submit"
+                  disabled={loginLoading}
+                  className="flex-1 py-2 px-4 bg-gray-900 hover:bg-gray-800 text-white font-medium text-sm rounded-md shadow-xs transition-colors"
+                >
+                  {loginLoading ? 'Signing in...' : 'Sign In with Password'}
+                </button>
+
+                <button
+                  type="button"
+                  onClick={handlePasskeySignIn}
+                  disabled={loginLoading}
+                  className="flex-1 inline-flex items-center justify-center space-x-2 py-2 px-4 bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm rounded-md shadow-xs transition-colors"
+                >
+                  <FingerPrintIcon className="w-5 h-5" />
+                  <span>Sign In with Passkey</span>
+                </button>
+              </div>
+            </form>
+
+            <div className="pt-4 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 gap-2">
+              <span>Need an account? <a href={`${baseUrl}signup`} className="text-blue-600 font-semibold hover:underline">Sign up here</a></span>
+              <div className="flex items-center space-x-2">
+                <span>Quick demo:</span>
+                <button
+                  type="button"
+                  onClick={() => handleQuickSignIn('demo_editor')}
+                  className="px-2 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded text-xs font-medium"
+                >
+                  demo_editor
+                </button>
+                <button
+                  type="button"
+                  onClick={() => handleQuickSignIn('reporter_micah')}
+                  className="px-2 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded text-xs font-medium"
+                >
+                  reporter_micah
+                </button>
+              </div>
+            </div>
+          </div>
+        </div>
+      </div>
+    );
+  }
+
+  // User IS signed in: Render Passkey Management Dashboard
+  return (
+    <div className="max-w-4xl mx-auto my-8 px-4 sm:px-6">
+      {/* Toast Notification */}
+      {notification && (
