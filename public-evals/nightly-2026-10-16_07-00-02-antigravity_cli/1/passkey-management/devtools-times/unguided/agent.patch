+++ b/src/components/AuthHeaderNav.tsx
@@ -0,0 +1,104 @@
+import React, { useEffect, useState } from 'react';
+import { getCurrentUser, setCurrentUser, type CurrentUser } from '../utils/passkeys';
+import { KeyIcon, UserCircleIcon, ArrowRightStartOnRectangleIcon } from '@heroicons/react/24/outline';
+
+interface AuthHeaderNavProps {
+  baseUrl: string;
+}
+
+export default function AuthHeaderNav({ baseUrl }: AuthHeaderNavProps) {
+  const [user, setUser] = useState<CurrentUser | null>(null);
+  const [mounted, setMounted] = useState(false);
+
+  useEffect(() => {
+    setMounted(true);
+    setUser(getCurrentUser());
+
+    const handleAuthChange = (e: CustomEvent<CurrentUser | null>) => {
+      setUser(e.detail);
+    };
+
+    window.addEventListener('auth-state-changed' as any, handleAuthChange);
+    return () => {
+      window.removeEventListener('auth-state-changed' as any, handleAuthChange);
+    };
+  }, []);
+
+  const handleSignOut = () => {
+    setCurrentUser(null);
+    setUser(null);
+  };
+
+  // Before mounting, render a placeholder matching server render to prevent layout shift
+  if (!mounted) {
+    return (
+      <div className="flex items-center space-x-3">
+        <a
+          href={`${baseUrl}signup`}
+          data-skip-tracking="true"
+          className="bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded whitespace-nowrap hover:bg-gray-700"
+        >
+          Sign up
+        </a>
+        <a
+          href={`${baseUrl}signin`}
+          data-skip-tracking="true"
+          className="bg-gray-500 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-400"
+        >
+          Sign in
+        </a>
+      </div>
+    );
+  }
+
+  if (user) {
+    return (
+      <div className="flex items-center space-x-2 sm:space-x-3">
+        <div className="flex items-center space-x-1.5 px-2.5 py-1.5 bg-gray-100 rounded-md text-xs font-medium text-gray-800">
+          <UserCircleIcon className="w-4 h-4 text-gray-500" />
+          <span className="font-semibold truncate max-w-[120px]">{user.username}</span>
+        </div>
+
+        <a
+          href={`${baseUrl}account`}
+          data-skip-tracking="true"
+          className="inline-flex items-center space-x-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold py-2 px-3 rounded shadow-xs transition-colors"
+          title="Manage Passkeys"
+        >
+          <KeyIcon className="w-4 h-4" />
+          <span>Passkeys</span>
+        </a>
+
+        <button
+          onClick={handleSignOut}
+          type="button"
+          data-skip-tracking="true"
+          className="inline-flex items-center space-x-1 text-gray-600 hover:text-gray-900 text-xs font-medium py-1.5 px-2 rounded hover:bg-gray-100 transition-colors"
+          title="Sign Out"
+        >
+          <ArrowRightStartOnRectangleIcon className="w-4 h-4" />
+          <span className="hidden sm:inline">Sign out</span>
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex items-center space-x-2 sm:space-x-3">
+      <a
+        href={`${baseUrl}signup`}
+        data-skip-tracking="true"
+        className="bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded whitespace-nowrap hover:bg-gray-700 transition-colors"
+      >
+        Sign up
+      </a>
+      <a
+        href={`${baseUrl}signin`}
+        data-skip-tracking="true"
+        className="bg-gray-500 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-400 transition-colors"
+      >
+        Sign in
+      </a>
+    </div>
+  );
+}
