+import type { RegisteredPasskey } from './passkeys';
+
+// In-memory server store for passkeys keyed by lowercase username
+export const serverPasskeysStore: Record<string, RegisteredPasskey[]> = {};
+
+export function getServerPasskeys(username: string): RegisteredPasskey[] {
+  return serverPasskeysStore[username.toLowerCase()] || [];
+}
+
+export function saveServerPasskey(passkey: RegisteredPasskey): void {
+  const key = passkey.username.toLowerCase();
+  const list = serverPasskeysStore[key] || [];
+  const updated = list.filter(k => k.id !== passkey.id);
+  updated.unshift(passkey);
+  serverPasskeysStore[key] = updated;
+}
+
+export function updateServerPasskey(username: string, id: string, updates: Partial<RegisteredPasskey>): RegisteredPasskey | null {
+  const key = username.toLowerCase();
+  const list = serverPasskeysStore[key] || [];
+  const item = list.find(k => k.id === id);
+  if (!item) return null;
+
+  Object.assign(item, updates);
+  return item;
+}
+
+export function deleteServerPasskey(username: string, id: string): boolean {
+  const key = username.toLowerCase();
+  const list = serverPasskeysStore[key] || [];
+  const filtered = list.filter(k => k.id !== id);
+  serverPasskeysStore[key] = filtered;
+  return filtered.length !== list.length;
+}
