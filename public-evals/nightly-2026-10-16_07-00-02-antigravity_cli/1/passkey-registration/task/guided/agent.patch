+  <script>
+    function base64UrlToBuffer(base64url) {
+      if (typeof base64url !== 'string') return base64url;
+      const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+      const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+      const rawData = atob(base64);
+      const outputArray = new Uint8Array(rawData.length);
+      for (let i = 0; i < rawData.length; ++i) {
+        outputArray[i] = rawData.charCodeAt(i);
+      }
+      return outputArray.buffer;
+    }
+
+    function parseCreationOptionsFallback(options) {
+      const opts = { ...options };
+      if (opts.challenge && typeof opts.challenge === 'string') {
+        opts.challenge = base64UrlToBuffer(opts.challenge);
+      }
+      if (opts.user && typeof opts.user.id === 'string') {
+        opts.user = { ...opts.user, id: base64UrlToBuffer(opts.user.id) };
+      }
+      if (Array.isArray(opts.excludeCredentials)) {
+        opts.excludeCredentials = opts.excludeCredentials.map(cred => ({
+          ...cred,
+          id: typeof cred.id === 'string' ? base64UrlToBuffer(cred.id) : cred.id,
+        }));
+      }
+      return opts;
+    }
+
+    function bufferToBase64Url(buffer) {
+      if (!buffer) return '';
+      const bytes = new Uint8Array(buffer);
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function serializeCredentialFallback(cred) {
+      const json = {
+        id: cred.id,
+        rawId: cred.rawId ? bufferToBase64Url(cred.rawId) : cred.id,
+        type: cred.type,
+        response: {},
+      };
+      if (cred.response) {
+        if (cred.response.clientDataJSON) {
+          json.response.clientDataJSON = bufferToBase64Url(cred.response.clientDataJSON);
+        }
+        if (cred.response.attestationObject) {
+          json.response.attestationObject = bufferToBase64Url(cred.response.attestationObject);
+        }
+        if (typeof cred.response.getTransports === 'function') {
+          json.response.transports = cred.response.getTransports();
+        }
+      }
+      return json;
+    }
+
+    async function gatePasskeyUI() {
+      const registerButton = document.querySelector('[data-testid="register-button"]');
+      if (!registerButton) return;
+
+      if (typeof window.PublicKeyCredential === 'undefined') {
+        registerButton.disabled = true;
+        return;
+      }
+
+      if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+        try {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          if (!capabilities?.passkeyPlatformAuthenticator || !capabilities?.conditionalGet) {
+            registerButton.disabled = true;
+          }
+        } catch (err) {
+          console.error('Failed to query client capabilities:', err);
+          registerButton.disabled = true;
+        }
+      }
+    }
+
+    async function registerPasskey(isPromotion = true) {
+      const registerButton = document.querySelector('[data-testid="register-button"]');
+      const statusEl = document.getElementById('register-status');
+
+      if (window.PublicKeyCredential && typeof PublicKeyCredential.getClientCapabilities === 'function') {
+        try {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          if (!capabilities?.passkeyPlatformAuthenticator || !capabilities?.conditionalGet) {
+            if (registerButton) registerButton.disabled = true;
+            if (statusEl) statusEl.textContent = 'Passkeys are not supported on this device/browser.';
+            return;
+          }
+        } catch (err) {
+          console.error('Error checking capabilities:', err);
+          if (registerButton) registerButton.disabled = true;
+          return;
+        }
+      }
+
+      let creationOptionsJSON;
+      try {
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify({ promotion: isPromotion }),
+        });
+
+        if (!optionsResponse.ok) {
+          throw new Error(`Options fetch failed: ${optionsResponse.status}`);
+        }
+
+        creationOptionsJSON = await optionsResponse.json();
+      } catch (err) {
+        console.error('Failed to fetch passkey creation options:', err);
+        if (statusEl) statusEl.textContent = 'Failed to fetch registration options.';
+        return;
+      }
+
+      const options = creationOptionsJSON.publicKey || creationOptionsJSON;
+      let publicKey;
+      if (typeof PublicKeyCredential !== 'undefined' && typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+        publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+      } else {
+        publicKey = parseCreationOptionsFallback(options);
+      }
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({ publicKey });
+      } catch (err) {
+        if (err.name === 'InvalidStateError') {
+          console.log('A passkey already exists for this account.');
+          alert('A passkey already exists for this account.');
+        } else if (err.name === 'SecurityError') {
+          console.error('Configuration RP ID or Secure Context error.');
+          alert('Configuration RP ID or Secure Context error.');
+        } else if (err.name === 'NotAllowedError') {
+          console.log('User cancelled the passkey dialog.');
+        } else if (err.name === 'AbortError') {
+          console.log('The creation operation has been aborted.');
+        } else {
+          console.error('Passkey creation error:', err);
+        }
+        return;
+      }
+
+      if (!credential) {
+        return;
+      }
+
+      const encodedResponse = typeof credential.toJSON === 'function'
+        ? credential.toJSON()
+        : serializeCredentialFallback(credential);
+
+      const rpId = options?.rp?.id || window.location.hostname;
+
+      try {
+        const verifyResponse = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify(encodedResponse),
+        });
+
+        if (!verifyResponse.ok) {
+          if (typeof PublicKeyCredential !== 'undefined' && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId,
+              credentialId: encodedResponse.id,
+            });
+          }
+          if (statusEl) statusEl.textContent = 'Passkey registration verification failed.';
+          return;
+        }
+
+        if (statusEl) statusEl.textContent = 'Passkey registered successfully!';
+        alert('Passkey registered successfully!');
+      } catch (serverErr) {
+        console.error('Server verification network failure:', serverErr);
+        if (typeof PublicKeyCredential !== 'undefined' && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId,
+              credentialId: encodedResponse.id,
+            });
+          } catch (signalErr) {
+            console.error('Failed to signal unknown credential:', signalErr);
+          }
+        }
+        if (statusEl) statusEl.textContent = 'Network error during passkey verification.';
+      }
+    }
+
+    window.registerPasskey = registerPasskey;
+
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    if (registerButton) {
+      registerButton.addEventListener('click', () => registerPasskey(true));
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', gatePasskeyUI);
+    } else {
+      gatePasskeyUI();
+    }
+  </script>
 </body>
 
