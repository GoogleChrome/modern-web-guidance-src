+    .replace(/\b(?:\d{4}[ -]?){3}\d{4}\b/g, '****-****-****-****')
+    // Mask auth tokens/passwords
+    .replace(/(password|token|secret|apiKey)["']?\s*[:=]\s*["']?([^"',\s]+)/gi, '$1="[REDACTED]"');
+}
+
+function secureLog(level, message, data = null) {
+  const timestamp = new Date().toISOString();
+  const scrubbedMsg = scrubPII(message);
+  const scrubbedData = data ? scrubPII(data) : '';
+  console.log(`[${timestamp}] [${level}] ${scrubbedMsg} ${scrubbedData}`.trim());
+}
+
+// Third-party audit ledger data
+const thirdPartyAudits = [
+  {
+    name: 'Unsplash Images',
+    category: 'Media / Assets',
+    domain: 'images.unsplash.com',
+    dataCollected: 'IP address on asset fetch',
+    justification: 'High-res artisanal coffee photography',
+    mitigations: 'Strict-origin-when-cross-origin referrer policy, no cookies transmitted, Façade thumbnails for videos',
+    auditStatus: 'Approved - Minimal Risk',
+    lastAudited: '2026-10-15'
+  },
+  {
+    name: 'YouTube Embeds',
+    category: 'Video Hosting',
+    domain: 'youtube-nocookie.com',
+    dataCollected: 'Play event, viewport telemetry (only after click)',
+    justification: 'Roastery documentary & coffee brewing story',
+    mitigations: 'Façade Pattern (zero requests loaded until user explicitly clicks play button), youtube-nocookie.com domain, no tracking cookies',
+    auditStatus: 'Approved - Mitigated with Façade',
+    lastAudited: '2026-10-15'
+  },
+  {
+    name: 'Social Sharing (X, Facebook, Email)',
+    category: 'Social Media',
+    domain: 'Static outbound URLs only',
+    dataCollected: 'None (no client-side tracking SDKs loaded)',
+    justification: 'Allow users to share coffee menu and recipes',
+    mitigations: 'Replaced heavy third-party JavaScript SDKs with privacy-preserving static HTML links (rel="noopener" target="_blank")',
+    auditStatus: 'Approved - Zero Third-Party JS',
+    lastAudited: '2026-10-15'
+  },
+  {
+    name: 'Geolocation / Store Finder',
+    category: 'Location Services',
+    domain: 'First-party client APIs',
+    dataCollected: 'Coarse city / zip prefix (or declarative PEPC with prompt)',
+    justification: 'Find nearest neighborhood coffee shop',
+    mitigations: 'Page Embedded Permission Control (PEPC) with manual postal code fuzzing fallback; no exact GPS logged or stored on server',
+    auditStatus: 'Approved - Minimized Granularity',
+    lastAudited: '2026-10-15'
+  }
+];
+
+// Security & Privacy Headers to apply to all responses
+function applySecurityHeaders(res) {
+  res.setHeader('Content-Security-Policy', [
+    "default-src 'self'",
+    "script-src 'self' 'unsafe-inline' https://www.youtube-nocookie.com",
+    "style-src 'self' 'unsafe-inline'",
+    "img-src 'self' data: https://images.unsplash.com https://img.youtube.com",
+    "frame-src https://www.youtube-nocookie.com",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'self'"
+  ].join('; '));
+
+  res.setHeader('Permissions-Policy', 'geolocation=(), camera=(), microphone=(), accelerometer=(), focus-without-user-activation=()');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('X-Frame-Options', 'SAMEORIGIN');
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
+  res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+  res.setHeader('Strict-Transport-Security', 'max-age=31536000; includeSubDomains; preload');
+}
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'application/javascript; charset=utf-8',
+  '.mjs': 'application/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.svg': 'image/svg+xml',
+  '.ico': 'image/x-icon'
+};
+
+const server = http.createServer((req, res) => {
+  const ip = req.socket.remoteAddress || '127.0.0.1';
+  const urlObj = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
+  const pathname = urlObj.pathname;
+
+  // Apply security & privacy headers
+  applySecurityHeaders(res);
+
+  // Set partitioned secure cookie example (CHIPS)
+  res.setHeader('Set-Cookie', [
+    'theme_pref=light; SameSite=Lax; Secure; Path=/; Partitioned; HttpOnly'
+  ]);
+
+  secureLog('INFO', `Request: ${req.method} ${pathname}`);
+
+  // Route: /logout -> Clear-Site-Data
+  if (pathname === '/logout' || pathname === '/api/logout') {
+    res.setHeader('Clear-Site-Data', '"*"');
+    // Invalidate cookies
+    res.setHeader('Set-Cookie', [
+      '__Host-session_id=; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=0',
+      'session_id=; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=0',
+      'theme_pref=; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=0'
+    ]);
+
+    secureLog('INFO', `User logged out. Clear-Site-Data header sent for IP: ${ip}`);
+
+    if (req.headers.accept && req.headers.accept.includes('application/json')) {
+      res.writeHead(200, { 'Content-Type': 'application/json' });
+      res.end(JSON.stringify({ success: true, message: 'Logged out. Site data cleared via Clear-Site-Data: "*"' }));
+      return;
+    }
+
+    // Redirect to home with logged_out param
+    res.writeHead(302, { Location: '/?logged_out=1' });
+    res.end();
+    return;
+  }
+
+  // Rate limiting check for API endpoints
+  if (pathname.startsWith('/api/')) {
+    if (isRateLimited(ip)) {
+      secureLog('WARN', `Rate limit exceeded for IP: ${ip} on endpoint ${pathname}`);
+      res.writeHead(429, { 'Content-Type': 'application/json' });
+      res.end(JSON.stringify({ error: 'Too Many Requests', message: 'Rate limit exceeded. Please wait a moment.' }));
+      return;
+    }
+  }
+
+  // Route: /api/audit -> Returns Third-Party Audits
+  if (pathname === '/api/audit' && req.method === 'GET') {
+    res.writeHead(200, { 'Content-Type': 'application/json' });
+    res.end(JSON.stringify({ audits: thirdPartyAudits, lastAuditDate: '2026-10-15' }, null, 2));
+    return;
+  }
+
+  // Route: /api/order -> Guest or Member checkout with data minimization
+  if (pathname === '/api/order' && req.method === 'POST') {
+    let body = '';
+    req.on('data', chunk => { body += chunk; });
+    req.on('end', () => {
+      try {
+        const orderData = JSON.parse(body);
+        // Automated log scrubbing demonstration
+        secureLog('INFO', `New order received: customer=${orderData.pickupName}, item=${orderData.item}, contact=${orderData.phone || orderData.email || 'None'}`);
+
+        res.writeHead(201, { 'Content-Type': 'application/json' });
+        res.end(JSON.stringify({
+          success: true,
+          orderId: 'ORD-' + Math.floor(100000 + Math.random() * 900000),
+          pickupName: orderData.pickupName,
+          item: orderData.item,
+          message: 'Order received! Data minimization notice: This order record will be permanently purged after pickup fulfillment.',
+          retention: 'Ephemeral (Purged after 2 hours)'
+        }));
+      } catch (err) {
+        res.writeHead(400, { 'Content-Type': 'application/json' });
+        res.end(JSON.stringify({ error: 'Invalid JSON payload' }));
+      }
+    });
+    return;
+  }
+
+  // Route: /api/data-export -> Data Access Right (GDPR / CCPA)
+  if (pathname === '/api/data-export') {
+    secureLog('INFO', `User requested data export from IP: ${ip}`);
+    const sampleData = {
+      userRights: 'Article 15 GDPR / CCPA Right to Access',
+      exportedAt: new Date().toISOString(),
+      dataMinimizationNotice: 'We store only the minimal data required for your service.',
+      profile: {
+        preferredName: 'Coffee Enthusiast',
+        ageBracket: '18-34',
+        marketingConsent: false,
+        ephemeralOrdersStored: 0
+      },
+      auditTrail: {
+        thirdPartySharing: 'None. We never sell or share your personal data with third-party advertisers.'
+      }
+    };
+    res.writeHead(200, {
+      'Content-Type': 'application/json',
+      'Content-Disposition': 'attachment; filename="daily_grind_my_data.json"'
+    });
+    res.end(JSON.stringify(sampleData, null, 2));
+    return;
+  }
+
+  // Route: /api/data-delete -> Data Erasure Right (GDPR / CCPA)
+  if (pathname === '/api/data-delete' && req.method === 'POST') {
+    secureLog('INFO', `User requested full data deletion from IP: ${ip}`);
+    res.setHeader('Clear-Site-Data', '"*"');
+    res.writeHead(200, { 'Content-Type': 'application/json' });
+    res.end(JSON.stringify({
+      success: true,
+      message: 'All associated data and account records have been permanently erased. Clear-Site-Data header sent.'
+    }));
+    return;
+  }
+
+  // Static file handling
+  let relativePath = pathname === '/' ? '/index.html' : pathname;
+  // Normalize and prevent directory traversal
+  const safePath = path.normalize(relativePath).replace(/^(\.\.[/\\])+/, '');
+  let filePath = path.join(__dirname, safePath);
+
+  // If path doesn't have an extension, try .html
+  if (!path.extname(filePath)) {
+    if (fs.existsSync(filePath + '.html')) {
+      filePath += '.html';
+    } else if (fs.existsSync(path.join(filePath, 'index.html'))) {
+      filePath = path.join(filePath, 'index.html');
+    }
+  }
+
+  fs.stat(filePath, (err, stats) => {
+    if (err || !stats.isFile()) {
+      // Fallback to index.html for client-side navigation
+      const indexPath = path.join(__dirname, 'index.html');
+      fs.readFile(indexPath, (readErr, content) => {
+        if (readErr) {
+          res.writeHead(404, { 'Content-Type': 'text/plain' });
+          res.end('404 Not Found');
+          return;
+        }
+        res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
+        res.end(content);
+      });
+      return;
+    }
+
+    const ext = path.extname(filePath).toLowerCase();
+    const contentType = MIME_TYPES[ext] || 'application/octet-stream';
+
+    fs.readFile(filePath, (readErr, content) => {
+      if (readErr) {
+        res.writeHead(500, { 'Content-Type': 'text/plain' });
+        res.end('500 Internal Server Error');
+        return;
+      }
+      res.writeHead(200, { 'Content-Type': contentType });
+      res.end(content);
+    });
+  });
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind server listening on http://localhost:${PORT}`);
+  console.log(`Privacy by Design & Security Headers active:`);
