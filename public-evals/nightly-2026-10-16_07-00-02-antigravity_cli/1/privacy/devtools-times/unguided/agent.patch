+import type { APIRoute } from 'astro';
+import { getThirdPartyAudits, getAuditSummary } from '../../utils/thirdPartyAudits';
+
+export const GET: APIRoute = async () => {
+  const audits = getThirdPartyAudits();
+  const summary = getAuditSummary();
+
+  const auditReport = {
+    reportTitle: 'The DevTools Times - Third-Party Service Privacy & Security Audit',
+    reportDate: new Date().toISOString(),
+    auditFramework: 'Privacy by Design, GDPR Art. 28/32, CCPA/CPRA, OWASP Top 10',
+    summary,
+    auditedServices: audits,
+    enforcedSecurityHeaders: [
+      'Content-Security-Policy',
+      'Strict-Transport-Security (HSTS)',
+      'X-Content-Type-Options: nosniff',
+      'X-Frame-Options: DENY',
+      'Referrer-Policy: strict-origin-when-cross-origin',
+      'Permissions-Policy (camera, microphone, geolocation disabled)',
+      'Cross-Origin-Opener-Policy: same-origin',
+      'Cross-Origin-Resource-Policy: same-origin',
+    ],
+  };
+
+  return new Response(JSON.stringify(auditReport, null, 2), {
+    status: 200,
+    headers: {
+      'Content-Type': 'application/json',
+      'Cache-Control': 'public, max-age=3600',
+    },
+  });
+};
