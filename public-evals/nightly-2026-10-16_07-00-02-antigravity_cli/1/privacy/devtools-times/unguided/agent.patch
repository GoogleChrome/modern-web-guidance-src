diff --git a/src/components/PrivacyBanner.tsx b/src/components/PrivacyBanner.tsx
new file mode 100644
index 0000000..0928fa7
--- /dev/null
+++ b/src/components/PrivacyBanner.tsx
@@ -0,0 +1,130 @@
+import React, { useState, useEffect } from 'react';
+import {
+  getSavedPreferences,
+  savePreferences,
+  getDefaultPreferences,
+  isGpcOrDntActive,
+  type PrivacyPreferences,
+} from '../utils/privacyConsent';
+import PrivacyModal from './PrivacyModal';
+
+interface PrivacyBannerProps {
+  baseUrl?: string;
+}
+
+export default function PrivacyBanner({ baseUrl = '/' }: PrivacyBannerProps) {
+  const [showBanner, setShowBanner] = useState(false);
+  const [showModal, setShowModal] = useState(false);
+  const [gpcActive, setGpcActive] = useState(false);
+
+  useEffect(() => {
+    setGpcActive(isGpcOrDntActive());
+
+    // Check if preferences were already answered
+    const saved = getSavedPreferences();
+    if (!saved) {
+      setShowBanner(true);
+    }
+
+    const handleOpenModal = () => {
+      setShowModal(true);
+    };
+
+    window.addEventListener('openPrivacyModal', handleOpenModal);
+    return () => window.removeEventListener('openPrivacyModal', handleOpenModal);
+  }, []);
+
+  const handleAcceptAll = () => {
+    const defaults = getDefaultPreferences();
+    const updated: PrivacyPreferences = {
+      ...defaults,
+      analytics: !gpcActive,
+      advertising: !gpcActive,
+    };
+    savePreferences(updated);
+    setShowBanner(false);
+  };
+
+  const handleRejectNonEssential = () => {
+    const defaults = getDefaultPreferences();
+    const updated: PrivacyPreferences = {
+      ...defaults,
+      analytics: false,
+      advertising: false,
+    };
+    savePreferences(updated);
+    setShowBanner(false);
+  };
+
+  const handleCustomize = () => {
+    setShowModal(true);
+  };
+
+  const handleModalClose = () => {
+    setShowModal(false);
+    // Once modal closes after saving, hide banner
+    if (getSavedPreferences()) {
+      setShowBanner(false);
+    }
+  };
+
+  return (
+    <>
+      {showBanner && (
+        <aside
+          role="region"
+          aria-label="Privacy and Cookie Consent"
+          className="fixed bottom-0 inset-x-0 z-[99998] p-4 bg-white/95 backdrop-blur-md border-t border-gray-300 shadow-2xl transition-all"
+        >
+          <div className="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
+            <div className="text-xs text-gray-700 space-y-1">
+              <div className="flex items-center space-x-2">
+                <span className="font-bold text-sm text-gray-900">Privacy by Design & Data Minimization</span>
+                {gpcActive && (
+                  <span className="bg-blue-100 text-blue-800 text-[10px] font-bold px-2 py-0.5 rounded">
+                    GPC Signal Honored
+                  </span>
+                )}
+              </div>
+              <p>
+                We only collect strictly necessary data to deliver content securely. Non-essential analytics and
+                third-party ad syndication are disabled by default. All third-party services are audited and governed
+                by strict security policies.
+              </p>
+            </div>
+
+            <div className="flex items-center space-x-2 shrink-0">
+              <button
+                type="button"
+                onClick={handleRejectNonEssential}
+                className="px-3 py-1.5 text-xs font-semibold text-gray-800 bg-gray-100 hover:bg-gray-200 rounded border border-gray-300"
+              >
+                Reject Non-Essential
+              </button>
+              <button
+                type="button"
+                onClick={handleCustomize}
+                className="px-3 py-1.5 text-xs font-semibold text-gray-800 bg-white hover:bg-gray-50 rounded border border-gray-300"
+              >
+                Customize
+              </button>
+              <button
+                type="button"
+                onClick={handleAcceptAll}
+                className="px-4 py-1.5 text-xs font-semibold text-white bg-gray-900 hover:bg-gray-800 rounded shadow-sm"
+              >
+                Accept All
+              </button>
+            </div>
+          </div>
+        </aside>
+      )}
+
+      <PrivacyModal
+        isOpen={showModal}
+        onClose={handleModalClose}
+        baseUrl={baseUrl}
+      />
+    </>
+  );
+}
