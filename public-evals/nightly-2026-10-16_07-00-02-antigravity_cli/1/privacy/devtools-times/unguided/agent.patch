+++ b/src/components/PrivacyModal.tsx
@@ -0,0 +1,294 @@
+import React, { useState, useEffect } from 'react';
+import {
+  getSavedPreferences,
+  getDefaultPreferences,
+  savePreferences,
+  clearAllPersonalData,
+  isGpcOrDntActive,
+  type PrivacyPreferences,
+} from '../utils/privacyConsent';
+import { getAuditSummary } from '../utils/thirdPartyAudits';
+
+interface PrivacyModalProps {
+  isOpen: boolean;
+  onClose: () => void;
+  baseUrl?: string;
+}
+
+export default function PrivacyModal({ isOpen, onClose, baseUrl = '/' }: PrivacyModalProps) {
+  const [preferences, setPreferences] = useState<PrivacyPreferences>(getDefaultPreferences());
+  const [purgeStatus, setPurgeStatus] = useState<string | null>(null);
+  const [isPurging, setIsPurging] = useState(false);
+  const [gpcActive, setGpcActive] = useState(false);
+  const auditSummary = getAuditSummary();
+
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  useEffect(() => {
+    const saved = getSavedPreferences();
+    if (saved) {
+      setPreferences(saved);
+    } else {
+      setPreferences(getDefaultPreferences());
+    }
+    setGpcActive(isGpcOrDntActive());
+
+    const handleOpen = () => {
+      const current = getSavedPreferences() || getDefaultPreferences();
+      setPreferences(current);
+      setPurgeStatus(null);
+    };
+
+    window.addEventListener('openPrivacyModal', handleOpen);
+    return () => window.removeEventListener('openPrivacyModal', handleOpen);
+  }, [isOpen]);
+
+  if (!isOpen) return null;
+
+  const handleSave = () => {
+    savePreferences(preferences);
+    onClose();
+  };
+
+  const handleAcceptAll = () => {
+    const updated: PrivacyPreferences = {
+      ...preferences,
+      analytics: !gpcActive,
+      advertising: !gpcActive,
+    };
+    setPreferences(updated);
+    savePreferences(updated);
+    onClose();
+  };
+
+  const handleRejectAll = () => {
+    const updated: PrivacyPreferences = {
+      ...preferences,
+      analytics: false,
+      advertising: false,
+    };
+    setPreferences(updated);
+    savePreferences(updated);
+    onClose();
+  };
+
+  const handlePurgeData = async () => {
+    if (!window.confirm('Are you sure you want to purge all stored personal data, bookmarks, and cookies?')) {
+      return;
+    }
+    setIsPurging(true);
+    setPurgeStatus('Purging all personal data...');
+    const result = await clearAllPersonalData(baseUrl);
+    setIsPurging(false);
+    setPurgeStatus(result.message);
+    setPreferences(getDefaultPreferences());
+  };
+
+  return (
+    <div
+      className="fixed inset-0 bg-black/60 backdrop-blur-sm z-[999999] flex items-center justify-center p-4"
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="privacy-modal-title"
+    >
+      <div className="bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto border border-gray-200">
+        {/* Header */}
+        <div className="p-6 border-b border-gray-200 flex justify-between items-center bg-gray-50 rounded-t-xl">
+          <div>
+            <h2 id="privacy-modal-title" className="text-xl font-bold text-gray-900">
+              Privacy & Data Protection Preferences
+            </h2>
+            <p className="text-xs text-gray-500 mt-1">
+              Privacy by Design • Data Minimization • Third-Party Audit Governance
+            </p>
+          </div>
+          <button
+            onClick={onClose}
+            className="text-gray-400 hover:text-gray-700 p-2 rounded-lg"
+            aria-label="Close modal"
+          >
+            ✕
+          </button>
+        </div>
+
+        {/* Content */}
+        <div className="p-6 space-y-6">
+          {gpcActive && (
+            <div className="bg-blue-50 border border-blue-200 rounded-lg p-3 text-xs text-blue-900 flex items-start space-x-2">
+              <span className="font-bold text-blue-700">🛡️ GPC / DNT Signal Detected:</span>
+              <span>
+                Your browser transmitted a Global Privacy Control (GPC) or Do Not Track signal.
+                Non-essential tracking and third-party advertising have been automatically restricted.
+              </span>
+            </div>
+          )}
+
+          {/* Section: Categories */}
+          <div className="space-y-4">
+            <h3 className="text-sm font-semibold text-gray-900 uppercase tracking-wider">
+              Data Processing Categories
+            </h3>
+
+            {/* Strictly Necessary */}
+            <div className="p-4 border border-gray-200 rounded-lg bg-gray-50 flex items-start justify-between">
+              <div className="pr-4">
+                <div className="flex items-center space-x-2">
+                  <span className="font-semibold text-sm text-gray-900">Strictly Necessary</span>
+                  <span className="text-[10px] font-bold uppercase bg-gray-200 text-gray-700 px-2 py-0.5 rounded">
+                    Always Active
+                  </span>
+                </div>
+                <p className="text-xs text-gray-600 mt-1">
+                  Required for site navigation, CSRF protection, and temporary reading list state.
+                  No personal data is sold or shared with external ad networks.
+                </p>
+              </div>
+              <input
+                type="checkbox"
+                checked={true}
+                disabled
+                className="mt-1 h-4 w-4 text-gray-400 rounded cursor-not-allowed"
+              />
+            </div>
+
+            {/* Behavioral Analytics */}
+            <div className="p-4 border border-gray-200 rounded-lg hover:border-gray-300 transition-colors flex items-start justify-between">
+              <div className="pr-4">
+                <div className="flex items-center space-x-2">
+                  <span className="font-semibold text-sm text-gray-900">Performance & Analytics</span>
+                  <span className="text-[10px] font-bold uppercase bg-amber-100 text-amber-800 px-2 py-0.5 rounded">
+                    Opt-in
+                  </span>
+                </div>
+                <p className="text-xs text-gray-600 mt-1">
+                  Allows anonymous interaction metrics via Times CDN (click events, tag names).
+                  Credentials, password fields, and private reading lists are strictly excluded.
+                </p>
+              </div>
+              <label className="relative inline-flex items-center cursor-pointer mt-1">
+                <input
+                  type="checkbox"
+                  checked={preferences.analytics}
+                  disabled={gpcActive}
+                  onChange={(e) =>
+                    setPreferences({ ...preferences, analytics: e.target.checked })
+                  }
+                  className="sr-only peer"
+                />
+                <div className="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gray-900 peer-disabled:opacity-50"></div>
+              </label>
+            </div>
+
+            {/* Advertising */}
+            <div className="p-4 border border-gray-200 rounded-lg hover:border-gray-300 transition-colors flex items-start justify-between">
+              <div className="pr-4">
+                <div className="flex items-center space-x-2">
+                  <span className="font-semibold text-sm text-gray-900">Third-Party Advertising</span>
+                  <span className="text-[10px] font-bold uppercase bg-amber-100 text-amber-800 px-2 py-0.5 rounded">
+                    Opt-in
+                  </span>
+                </div>
+                <p className="text-xs text-gray-600 mt-1">
+                  Allows syndication of banner and fireplace ad slots via Times CDN ad network.
+                  When disabled, no external ad iframes or network calls are triggered.
+                </p>
+              </div>
+              <label className="relative inline-flex items-center cursor-pointer mt-1">
+                <input
+                  type="checkbox"
+                  checked={preferences.advertising}
+                  disabled={gpcActive}
+                  onChange={(e) =>
+                    setPreferences({ ...preferences, advertising: e.target.checked })
+                  }
+                  className="sr-only peer"
+                />
+                <div className="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-gray-900 peer-disabled:opacity-50"></div>
+              </label>
+            </div>
+          </div>
+
+          {/* Third-Party Audit Snapshot */}
+          <div className="p-4 bg-gray-50 border border-gray-200 rounded-lg">
+            <div className="flex justify-between items-center mb-2">
+              <h4 className="text-xs font-bold text-gray-700 uppercase tracking-wider">
+                Third-Party Security Audit Overview
+              </h4>
+              <a
+                href={`${normalizedBase}legal/third-party-audits`}
+                className="text-xs font-medium text-amber-700 hover:underline"
+              >
+                View Full Audit Report →
+              </a>
+            </div>
+            <div className="grid grid-cols-3 gap-2 text-center text-xs">
+              <div className="bg-white p-2 rounded border border-gray-200">
+                <div className="font-bold text-gray-900">{auditSummary.totalAudited}</div>
+                <div className="text-gray-500 text-[11px]">Services Audited</div>
+              </div>
+              <div className="bg-white p-2 rounded border border-gray-200">
+                <div className="font-bold text-green-700">{auditSummary.auditCompliancePercentage}%</div>
+                <div className="text-gray-500 text-[11px]">Compliance Rate</div>
+              </div>
+              <div className="bg-white p-2 rounded border border-gray-200">
+                <div className="font-bold text-gray-900">TLS 1.3 + CSP</div>
+                <div className="text-gray-500 text-[11px]">Transit Safeguards</div>
+              </div>
+            </div>
+          </div>
+
+          {/* Right to Erasure / Data Purge */}
+          <div className="p-4 border border-red-200 bg-red-50/50 rounded-lg">
+            <h4 className="text-xs font-bold text-red-900 uppercase tracking-wider">
