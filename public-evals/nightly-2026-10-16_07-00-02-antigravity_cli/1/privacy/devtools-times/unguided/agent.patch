+export interface PrivacyPreferences {
+  necessary: boolean;
+  analytics: boolean;
+  advertising: boolean;
+  gpcSignalDetected: boolean;
+  timestamp: string;
+  version: string;
+}
+
+const STORAGE_KEY = 'devtools_times_privacy_consent';
+const CURRENT_VERSION = '1.0';
+
+export function isGpcOrDntActive(): boolean {
+  if (typeof window === 'undefined') return false;
+
+  const gpc = (navigator as any).globalPrivacyControl === true;
+  const dnt = navigator.doNotTrack === '1' || (window as any).doNotTrack === '1';
+
+  return Boolean(gpc || dnt);
+}
+
+export function getDefaultPreferences(): PrivacyPreferences {
+  const gpcActive = isGpcOrDntActive();
+
+  return {
+    necessary: true, // Strictly necessary is always true
+    analytics: false, // Default opt-out (Privacy by Default)
+    advertising: false, // Default opt-out (Privacy by Default)
+    gpcSignalDetected: gpcActive,
+    timestamp: new Date().toISOString(),
+    version: CURRENT_VERSION
+  };
+}
+
+export function getSavedPreferences(): PrivacyPreferences | null {
+  if (typeof window === 'undefined') return null;
+
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    if (!raw) return null;
+    const parsed = JSON.parse(raw) as PrivacyPreferences;
+    // Check if GPC signal has been turned on since consent was saved
+    if (isGpcOrDntActive() && (!parsed.gpcSignalDetected || parsed.analytics || parsed.advertising)) {
+      // Re-apply GPC override
+      parsed.analytics = false;
+      parsed.advertising = false;
+      parsed.gpcSignalDetected = true;
+      savePreferences(parsed);
+    }
+    return parsed;
+  } catch (err) {
+    console.warn('Failed to parse saved privacy preferences', err);
+    return null;
+  }
+}
+
+export function savePreferences(prefs: PrivacyPreferences): void {
+  if (typeof window === 'undefined') return;
+
+  try {
+    const updated: PrivacyPreferences = {
+      ...prefs,
+      necessary: true,
+      gpcSignalDetected: isGpcOrDntActive() || prefs.gpcSignalDetected,
+      timestamp: new Date().toISOString(),
+      version: CURRENT_VERSION
+    };
+
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
+
+    // Dispatch global event so components (ads, analytics loader) can react immediately
+    window.dispatchEvent(new CustomEvent('privacyConsentChanged', { detail: updated }));
+  } catch (err) {
+    console.error('Failed to save privacy preferences', err);
+  }
+}
+
+export async function clearAllPersonalData(baseUrl: string = '/'): Promise<{ success: boolean; message: string }> {
+  if (typeof window === 'undefined') return { success: false, message: 'Server context' };
+
+  try {
+    // 1. Clear server-side session reading list (Right to Erasure)
+    try {
+      const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+      await fetch(`${normalizedBase}api/reading-list.json`, {
+        method: 'DELETE',
+        headers: { 'Content-Type': 'application/json' }
+      });
+    } catch (e) {
+      console.warn('Failed to clear reading list on server:', e);
+    }
+
+    // 2. Clear client storage
+    sessionStorage.clear();
+
+    // 3. Clear cookies on this domain
+    const cookies = document.cookie.split(';');
+    for (const cookie of cookies) {
+      const eqPos = cookie.indexOf('=');
+      const name = eqPos > -1 ? cookie.substring(0, eqPos).trim() : cookie.trim();
+      if (name && name !== 'dtt_session') {
+        document.cookie = `${name}=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/`;
+      }
+    }
+
+    // 4. Reset privacy preferences to strict default
+    const strictDefaults = getDefaultPreferences();
+    localStorage.clear();
+    savePreferences(strictDefaults);
+
+    return {
+      success: true,
+      message: 'All personal data, reading lists, and tracking cookies have been purged.'
+    };
+  } catch (err) {
+    return {
+      success: false,
+      message: `Failed to purge data: ${err}`
+    };
+  }
+}
