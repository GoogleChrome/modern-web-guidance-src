diff --git a/src/components/PrivacyConsentManager.tsx b/src/components/PrivacyConsentManager.tsx
new file mode 100644
index 0000000..8b18879
--- /dev/null
+++ b/src/components/PrivacyConsentManager.tsx
@@ -0,0 +1,411 @@
+import React, { useState, useEffect } from 'react';
+
+export interface PrivacyPreferences {
+  necessary: boolean;
+  analytics: boolean;
+  advertising: boolean;
+  auditDiagnostics: boolean;
+  timestamp: string;
+  gpcDetected: boolean;
+}
+
+const STORAGE_KEY = 'devtools_times_privacy_preferences_v1';
+
+export function getStoredPrivacyPreferences(): PrivacyPreferences | null {
+  if (typeof window === 'undefined') return null;
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    if (!raw) return null;
+    return JSON.parse(raw);
+  } catch {
+    return null;
+  }
+}
+
+export function savePrivacyPreferences(prefs: PrivacyPreferences): void {
+  if (typeof window === 'undefined') return;
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
+    window.dispatchEvent(new CustomEvent('privacyConsentChanged', { detail: prefs }));
+  } catch {
+    // Graceful fallback
+  }
+}
+
+export default function PrivacyConsentManager() {
+  const [preferences, setPreferences] = useState<PrivacyPreferences>({
+    necessary: true,
+    analytics: false,
+    advertising: false,
+    auditDiagnostics: true,
+    timestamp: '',
+    gpcDetected: false,
+  });
+
+  const [hasInteracted, setHasInteracted] = useState(false);
+  const [isModalOpen, setIsModalOpen] = useState(false);
+  const [isGpcActive, setIsGpcActive] = useState(false);
+  const [erasureMessage, setErasureMessage] = useState<string | null>(null);
+
+  useEffect(() => {
+    // Detect Global Privacy Control (GPC) or Do Not Track (DNT)
+    const nav = navigator as unknown as { globalPrivacyControl?: boolean; doNotTrack?: string };
+    const gpcSignal = nav.globalPrivacyControl === true || nav.doNotTrack === '1' || (window as unknown as { doNotTrack?: string }).doNotTrack === '1';
+    setIsGpcActive(gpcSignal);
+
+    const stored = getStoredPrivacyPreferences();
+    if (stored) {
+      setPreferences(stored);
+      setHasInteracted(true);
+      applyConsent(stored);
+    } else {
+      // Privacy by Default: Non-essential tracking disabled
+      const defaultPrefs: PrivacyPreferences = {
+        necessary: true,
+        analytics: false,
+        advertising: false,
+        auditDiagnostics: true,
+        timestamp: new Date().toISOString(),
+        gpcDetected: gpcSignal,
+      };
+      setPreferences(defaultPrefs);
+      // Wait for user interaction
+    }
+
+    // Expose global opener function
+    (window as unknown as { openPrivacyPreferences?: () => void }).openPrivacyPreferences = () => {
+      setIsModalOpen(true);
+    };
+
+    // Listen for footer button or external trigger
+    const handleTrigger = () => setIsModalOpen(true);
+    window.addEventListener('openPrivacyPreferences', handleTrigger);
+
+    const footerBtn = document.getElementById('open-privacy-preferences');
+    if (footerBtn) {
+      footerBtn.addEventListener('click', handleTrigger);
+    }
+
+    return () => {
+      window.removeEventListener('openPrivacyPreferences', handleTrigger);
+      if (footerBtn) {
+        footerBtn.removeEventListener('click', handleTrigger);
+      }
+    };
+  }, []);
+
+  const applyConsent = (prefs: PrivacyPreferences) => {
+    // Load or enable third-party analytics only if explicitly consented
+    if (prefs.analytics) {
+      if (!document.getElementById('times-analytics-script')) {
+        const script = document.createElement('script');
+        script.id = 'times-analytics-script';
+        script.src = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+        script.integrity = 'sha256-rxM3pgURCBDIgWxD/2KBR0guPgrq03pSGPTlk+ypq2w=';
+        script.crossOrigin = 'anonymous';
+        script.defer = true;
+        document.head.appendChild(script);
+      }
+    }
+
+    // Load or enable third-party advertising only if explicitly consented
+    if (prefs.advertising) {
+      if (!document.getElementById('times-ad-script')) {
+        const script = document.createElement('script');
+        script.id = 'times-ad-script';
+        script.src = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/ad-client.js';
+        script.integrity = 'sha256-P9fo2B+PrvUrz1xo30j7CNBAg5GxUh65jmgZwfy9CrE=';
+        script.crossOrigin = 'anonymous';
+        script.defer = true;
+        document.head.appendChild(script);
+      }
+    }
+  };
+
+  const handleAcceptAll = () => {
+    const updated: PrivacyPreferences = {
+      necessary: true,
+      analytics: true,
+      advertising: true,
+      auditDiagnostics: true,
+      timestamp: new Date().toISOString(),
+      gpcDetected: isGpcActive,
+    };
+    setPreferences(updated);
+    savePrivacyPreferences(updated);
+    applyConsent(updated);
+    setHasInteracted(true);
+    setIsModalOpen(false);
+  };
+
+  const handleRejectNonEssential = () => {
+    const updated: PrivacyPreferences = {
+      necessary: true,
+      analytics: false,
+      advertising: false,
+      auditDiagnostics: true,
+      timestamp: new Date().toISOString(),
+      gpcDetected: isGpcActive,
+    };
+    setPreferences(updated);
+    savePrivacyPreferences(updated);
+    setHasInteracted(true);
+    setIsModalOpen(false);
+  };
+
+  const handleSavePreferences = () => {
+    const updated: PrivacyPreferences = {
+      ...preferences,
+      timestamp: new Date().toISOString(),
+      gpcDetected: isGpcActive,
+    };
+    setPreferences(updated);
+    savePrivacyPreferences(updated);
+    applyConsent(updated);
+    setHasInteracted(true);
+    setIsModalOpen(false);
+  };
+
+  // Right to Erasure: Wipe all locally stored data and reading list
+  const handleEraseAllData = async () => {
+    if (!confirm('This will erase all your stored preferences, reading list, and local session data. Continue?')) {
+      return;
+    }
+    try {
+      localStorage.removeItem(STORAGE_KEY);
+      sessionStorage.clear();
+      await fetch('/devtools-times/api/reading-list.json', { method: 'DELETE' }).catch(() => {});
+      setErasureMessage('All local data and session reading lists have been permanently erased.');
+      setTimeout(() => setErasureMessage(null), 4000);
+      handleRejectNonEssential();
+    } catch {
+      setErasureMessage('Could not erase all data.');
+    }
+  };
+
+  return (
+    <>
+      {/* 1. Initial Privacy Consent Banner (Shown if user has not interacted yet) */}
+      {!hasInteracted && !isModalOpen && (
+        <div
+          role="region"
+          aria-label="Privacy and Cookie Choices"
+          className="fixed bottom-0 inset-x-0 bg-gray-900 text-white z-[99998] shadow-2xl border-t border-gray-700 p-4 md:p-6"
+        >
+          <div className="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
+            <div className="space-y-1 max-w-3xl">
+              <div className="flex items-center gap-2">
+                <span className="font-bold text-sm tracking-wide uppercase text-amber-400">Privacy by Design</span>
+                {isGpcActive && (
+                  <span className="bg-blue-900 text-blue-200 text-xs px-2 py-0.5 rounded-full font-medium flex items-center gap-1">
+                    🛡️ Global Privacy Control Signal Active
+                  </span>
+                )}
+              </div>
+              <p className="text-xs md:text-sm text-gray-300">
+                The DevTools Times implements strict data minimization and privacy by default. We do not track your activity or load third-party ad networks without your explicit consent.
+              </p>
+            </div>
+            <div className="flex flex-wrap items-center gap-2 w-full md:w-auto">
+              <button
+                onClick={handleRejectNonEssential}
+                data-skip-tracking="true"
+                className="flex-1 md:flex-none px-4 py-2 text-xs font-semibold bg-gray-800 hover:bg-gray-700 border border-gray-600 rounded text-white transition-colors"
+              >
+                Essential Only
+              </button>
+              <button
+                onClick={() => setIsModalOpen(true)}
+                data-skip-tracking="true"
+                className="flex-1 md:flex-none px-4 py-2 text-xs font-semibold bg-gray-800 hover:bg-gray-700 border border-gray-600 rounded text-white transition-colors"
+              >
+                Customize
+              </button>
+              <button
+                onClick={handleAcceptAll}
+                data-skip-tracking="true"
+                className="flex-1 md:flex-none px-4 py-2 text-xs font-semibold bg-amber-500 hover:bg-amber-400 text-black rounded transition-colors"
+              >
+                Accept All
+              </button>
+            </div>
+          </div>
+        </div>
+      )}
+
+      {/* 2. Detailed Privacy Preferences Modal */}
+      {isModalOpen && (
+        <div
+          className="fixed inset-0 bg-black/60 backdrop-blur-sm z-[99999] flex justify-center items-center p-4 overflow-y-auto"
+          role="dialog"
+          aria-modal="true"
+          aria-labelledby="privacy-modal-title"
+          onClick={() => setIsModalOpen(false)}
+        >
+          <div
+            className="bg-white text-gray-900 rounded-lg shadow-2xl max-w-2xl w-full p-6 relative max-h-[90vh] overflow-y-auto"
+            onClick={(e) => e.stopPropagation()}
+          >
+            <button
+              onClick={() => setIsModalOpen(false)}
+              data-skip-tracking="true"
+              aria-label="Close privacy preferences modal"
+              className="absolute top-4 right-4 text-gray-400 hover:text-gray-800 p-1"
+            >
+              <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
+              </svg>
+            </button>
+
+            <div className="border-b border-gray-200 pb-4 mb-5">
+              <h2 id="privacy-modal-title" className="text-xl font-bold text-gray-900">
+                Privacy Preferences &amp; Data Controls
+              </h2>
+              <p className="text-xs text-gray-500 mt-1">
+                Configure your privacy by design options. We uphold data minimization across all services.
+              </p>
+              {isGpcActive && (
+                <div className="mt-2 p-2 bg-blue-50 border border-blue-200 rounded text-xs text-blue-800 flex items-center gap-2">
+                  <span>🛡️</span>
+                  <span>
+                    <strong>Global Privacy Control (GPC) Detected:</strong> Your browser has signaled an opt-out preference. Non-essential tracking remains disabled by default.
+                  </span>
+                </div>
+              )}
+            </div>
+
+            {erasureMessage && (
+              <div className="mb-4 p-3 bg-green-100 text-green-800 text-xs rounded border border-green-200">
+                {erasureMessage}
+              </div>
+            )}
+
+            {/* Preference Categories */}
+            <div className="space-y-4">
+              {/* Category 1: Strictly Necessary */}
+              <div className="p-4 border border-gray-200 rounded-lg bg-gray-50">
+                <div className="flex items-center justify-between">
+                  <div>
+                    <h3 className="font-semibold text-sm text-gray-800">Strictly Necessary (Always Active)</h3>
+                    <p className="text-xs text-gray-600 mt-0.5">
+                      Core functions including reading list session state, CSRF security, and cryptographic integrity checks.
+                    </p>
+                  </div>
+                  <span className="text-xs font-semibold text-gray-500 bg-gray-200 px-2 py-1 rounded">Required</span>
+                </div>
+              </div>
+
+              {/* Category 2: Analytics & Interaction Telemetry */}
+              <div className="p-4 border border-gray-200 rounded-lg hover:border-gray-300 transition-colors">
+                <div className="flex items-center justify-between">
+                  <div className="pr-4">
+                    <h3 className="font-semibold text-sm text-gray-800">Analytics &amp; Performance Telemetry</h3>
+                    <p className="text-xs text-gray-600 mt-0.5">
+                      Times CDN interaction metrics with data minimization (sensitive forms and credentials are automatically excluded).
+                    </p>
+                  </div>
+                  <label className="relative inline-flex items-center cursor-pointer">
+                    <input
+                      type="checkbox"
+                      checked={preferences.analytics}
+                      onChange={(e) => setPreferences({ ...preferences, analytics: e.target.checked })}
+                      className="sr-only peer"
+                    />
+                    <div className="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-600"></div>
+                  </label>
+                </div>
+              </div>
+
+              {/* Category 3: Advertising & Sponsor Slots */}
+              <div className="p-4 border border-gray-200 rounded-lg hover:border-gray-300 transition-colors">
+                <div className="flex items-center justify-between">
+                  <div className="pr-4">
+                    <h3 className="font-semibold text-sm text-gray-800">Third-Party Advertising &amp; Sponsorships</h3>
+                    <p className="text-xs text-gray-600 mt-0.5">
+                      Enables Times CDN banner and fireplace ad slots. Zero cross-site tracking profiles are constructed.
+                    </p>
+                  </div>
+                  <label className="relative inline-flex items-center cursor-pointer">
+                    <input
+                      type="checkbox"
+                      checked={preferences.advertising}
+                      onChange={(e) => setPreferences({ ...preferences, advertising: e.target.checked })}
+                      className="sr-only peer"
+                    />
+                    <div className="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-600"></div>
+                  </label>
+                </div>
+              </div>
+
+              {/* Category 4: Third-Party Audit Verification */}
+              <div className="p-4 border border-gray-200 rounded-lg hover:border-gray-300 transition-colors">
+                <div className="flex items-center justify-between">
+                  <div className="pr-4">
+                    <h3 className="font-semibold text-sm text-gray-800">Third-Party Auditing &amp; Integrity Verification</h3>
+                    <p className="text-xs text-gray-600 mt-0.5">
