+    principles: {
+      privacyByDesign: {
+        compliant: true,
+        summary: 'Privacy is embedded as the default setting. No non-essential tracking occurs without explicit affirmative user consent.',
+        features: [
+          'Global Privacy Control (Sec-GPC) detection and automatic adherence',
+          'Do Not Track (DNT) signal support',
+          'Granular privacy preference management',
+          'Opt-in architecture for analytics and advertising'
+        ]
+      },
+      dataMinimization: {
+        compliant: true,
+        summary: 'Only strictly necessary data is processed and stored.',
+        features: [
+          'Credential collection minimized to username/password',
+          'No passwords or sensitive tokens stored in client storage',
+          'Telemetry payloads stripped of PII and user inputs',
+          'Session reading list bounded to prevent storage bloat'
