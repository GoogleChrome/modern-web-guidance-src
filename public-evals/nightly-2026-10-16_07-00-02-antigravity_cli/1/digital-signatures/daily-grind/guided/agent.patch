+/**
+ * app.js
+ * 
+ * Interactive controller for The Daily Grind's Cryptographic Authenticity Studio.
+ * Interfaces with crypto-signatures.js for:
+ * - Messages signing and verification
+ * - Tokens creation, inspection, and verification
+ * - Artifacts hashing, signing, and verification
+ * - Post-Quantum (ML-DSA) and Classical (Ed25519) key management
+ * - In-browser live self-test & latency benchmarks
+ */
+
+import {
+  supportsPostQuantumSignatures,
+  hasSubtleCryptoSupports,
+  detectSupportedSuites,
+  generateSigningKeyPair,
+  exportPublicKey,
+  importPublicKey,
+  signMessage,
+  verifyMessage,
+  createSignedToken,
+  verifySignedToken,
+  hashArtifact,
+  signArtifact,
+  verifyArtifact,
+  bytesToHex,
+  hexToBytes,
+  bytesToBase64,
+  base64ToBytes,
+  bytesToBase64Url,
+  stringToBytes,
+  bytesToString,
+} from './crypto-signatures.js';
+
+// Application state
+const state = {
+  currentSuite: 'ML-DSA-65',
+  keyPairData: null,
+  activeTab: 'tab-messages',
+
+  // Messages state
+  signedMessagePackage: null,
+
+  // Tokens state
+  issuedTokenData: null,
+
+  // Artifacts state
+  currentArtifact: {
+    name: 'artisanal-roast-certificate.jpg',
+    mimeType: 'image/jpeg',
+    bytes: null,
+    previewUrl: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=800&q=80',
+    envelope: null,
+  },
+};
+
+// DOM references helper
+const $ = (id) => document.getElementById(id);
+
+/**
+ * Initialize studio on page load
+ */
+export async function initApp() {
+  renderDetectionBanner();
+  setupEventListeners();
+  await handleGenerateKeyPair();
+  await loadDefaultArtifact();
+}
+
+/**
+ * Render cryptographic capabilities and quantum readiness
+ */
+function renderDetectionBanner() {
+  const pqSupported = supportsPostQuantumSignatures();
+  const detectionInfo = detectSupportedSuites();
+
+  const statusBadge = $('pqc-status-badge');
+  const detailsEl = $('pqc-details');
+
+  if (pqSupported) {
+    statusBadge.className = 'status-badge status-pq-ready';
+    statusBadge.innerHTML = '🛡️ Post-Quantum Protected (ML-DSA-65 NIST FIPS 204)';
+    detailsEl.textContent = `Native WebCrypto quantum-resistant support detected (${detectionInfo.supportedSuites.join(', ')}).`;
+  } else {
+    statusBadge.className = 'status-badge status-classical';
+    statusBadge.innerHTML = '⚡ Classical Mode Active (Ed25519)';
+    detailsEl.textContent = `ML-DSA not detected natively in this browser; active suites: ${detectionInfo.supportedSuites.join(', ')}.`;
+  }
+
+  // Populate algorithm selector
+  const suiteSelect = $('suite-select');
+  suiteSelect.innerHTML = '';
+
+  const availableOptions = [
+    { value: 'ML-DSA-65', label: 'ML-DSA-65 (NIST FIPS 204 - Recommended Default)', pq: true },
+    { value: 'ML-DSA-44', label: 'ML-DSA-44 (NIST FIPS 204 - Compact 1312B PubKey)', pq: true },
+    { value: 'ML-DSA-87', label: 'ML-DSA-87 (NIST FIPS 204 - High Security Cat 5)', pq: true },
+    { value: 'Ed25519', label: 'Ed25519 (Classical Edwards Curve - RFC 8032)', pq: false },
+    { value: 'ECDSA-P256', label: 'ECDSA P-256 (Classical NIST Curve)', pq: false },
+  ];
+
+  for (const opt of availableOptions) {
+    const isSupported = detectionInfo.supportedSuites.includes(opt.value);
+    const optionEl = document.createElement('option');
+    optionEl.value = opt.value;
+    optionEl.textContent = `${opt.label} ${isSupported ? '✓ Supported' : '(Fallback only)'}`;
+    if (opt.value === detectionInfo.defaultSuite) {
+      optionEl.selected = true;
+      state.currentSuite = opt.value;
+    }
+    suiteSelect.appendChild(optionEl);
+  }
+}
+
+/**
+ * Setup UI Event Listeners
+ */
+function setupEventListeners() {
+  // Navigation tabs
+  document.querySelectorAll('.crypto-tab-btn').forEach((btn) => {
+    btn.addEventListener('click', () => {
+      document.querySelectorAll('.crypto-tab-btn').forEach((b) => b.classList.remove('active'));
+      document.querySelectorAll('.crypto-tab-pane').forEach((p) => p.classList.remove('active'));
+      btn.classList.add('active');
+      const targetPane = $(btn.dataset.target);
+      if (targetPane) targetPane.classList.add('active');
+      state.activeTab = btn.dataset.target;
+    });
+  });
+
+  // Key Pair Management
+  $('suite-select').addEventListener('change', (e) => {
+    state.currentSuite = e.target.value;
+  });
+
+  $('btn-generate-keys').addEventListener('click', handleGenerateKeyPair);
+  $('btn-copy-public-key').addEventListener('click', handleCopyPublicKey);
+  $('btn-download-public-key').addEventListener('click', handleDownloadPublicKey);
+  $('btn-import-public-key').addEventListener('click', handleImportPublicKey);
+
+  // Messages
+  $('btn-sign-message').addEventListener('click', handleSignMessage);
+  $('btn-verify-message').addEventListener('click', handleVerifyMessage);
+  $('btn-tamper-message').addEventListener('click', handleTamperMessage);
+  $('btn-tamper-msg-ctx').addEventListener('click', handleTamperMessageContext);
+
+  // Message Presets
+  $('msg-preset-select').addEventListener('change', (e) => {
+    const val = e.target.value;
+    if (val === 'roaster-cert') {
+      $('msg-input').value = 'Official Certificate of Roast: Batch #8402 Organic Ethiopian Yirgacheffe roasted on Oct 16, 2026. Certified single-origin, cupping score 91.5.';
+      $('msg-context-input').value = 'dailygrind:roaster:batch-cert';
+    } else if (val === 'hours') {
+      $('msg-input').value = 'Notice of Special Holiday Tasting Hours: The Daily Grind Flagship Roastery will open at 6:00 AM on Saturday for live cupping demonstrations.';
+      $('msg-context-input').value = 'dailygrind:notices:public';
+    } else if (val === 'pricing') {
+      $('msg-input').value = 'Master Price Schedule: Batch 2026-X Reserve Beans priced at $24.00 / 12oz bag. Valid through November 30, 2026.';
+      $('msg-context-input').value = 'dailygrind:commerce:pricing';
+    }
+  });
+
+  // Tokens
+  $('btn-issue-token').addEventListener('click', handleIssueToken);
+  $('btn-verify-token').addEventListener('click', handleVerifyToken);
+  $('btn-tamper-token-credits').addEventListener('click', handleTamperTokenCredits);
+  $('btn-tamper-token-sig').addEventListener('click', handleTamperTokenSignature);
+
+  // Artifacts
+  $('artifact-file-input').addEventListener('change', handleCustomArtifactUpload);
+  $('artifact-preset-select').addEventListener('change', handleArtifactPresetChange);
+  $('btn-sign-artifact').addEventListener('click', handleSignArtifact);
+  $('btn-verify-artifact').addEventListener('click', handleVerifyArtifact);
+  $('btn-corrupt-artifact').addEventListener('click', handleCorruptArtifact);
+
+  // In-Browser Benchmark & Self-Test
+  $('btn-run-selftest').addEventListener('click', handleRunSelfTest);
+}
+
+/* ============================================================================
+   Key Management Handlers
+   ============================================================================ */
+
+async function handleGenerateKeyPair() {
+  const statusEl = $('key-gen-status');
+  statusEl.textContent = 'Generating key pair...';
+  const startTime = performance.now();
+
+  try {
+    const keyData = await generateSigningKeyPair(state.currentSuite);
+    state.keyPairData = keyData;
+
+    const elapsed = (performance.now() - startTime).toFixed(2);
+    statusEl.innerHTML = `✓ Generated <strong>${keyData.suite}</strong> key pair in <strong>${elapsed}ms</strong>.`;
+
+    $('pubkey-preview-b64').value = keyData.publicKeyBase64;
+    $('pubkey-preview-hex').value = keyData.publicKeyHex;
+    $('pubkey-suite-badge').textContent = keyData.suite;
+    $('pubkey-size-badge').textContent = `${keyData.publicKeyBytes.byteLength} Bytes`;
+
+    // Clear verification outputs
+    resetStatusBadges();
+  } catch (err) {
+    statusEl.textContent = `Error: ${err.message}`;
+    console.error('Key generation error:', err);
+  }
+}
+
+function handleCopyPublicKey() {
+  const b64 = $('pubkey-preview-b64').value;
+  if (!b64) return;
+  navigator.clipboard.writeText(b64).then(() => {
+    alert('Public key copied to clipboard (Base64)!');
+  }).catch(() => {
+    $('pubkey-preview-b64').select();
+    document.execCommand('copy');
+    alert('Public key copied to clipboard!');
+  });
+}
+
+function handleDownloadPublicKey() {
+  if (!state.keyPairData) return;
+  const content = `-----BEGIN PUBLIC KEY (${state.keyPairData.suite})-----\n${state.keyPairData.publicKeyBase64}\n-----END PUBLIC KEY-----`;
+  const blob = new Blob([content], { type: 'text/plain' });
+  const url = URL.createObjectURL(blob);
+  const a = document.createElement('a');
+  a.href = url;
+  a.download = `daily-grind-${state.keyPairData.suite}.pub`;
+  a.click();
+  URL.revokeObjectURL(url);
+}
+
+async function handleImportPublicKey() {
+  const input = prompt('Paste Public Key (Base64 or Hex):');
+  if (!input) return;
+  try {
+    const importedKey = await importPublicKey(input.trim());
+    alert(`Successfully imported public key! Algorithm: ${importedKey.algorithm.name}`);
+  } catch (err) {
+    alert(`Failed to import public key: ${err.message}`);
+  }
+}
+
+function resetStatusBadges() {
+  const msgResult = $('msg-verify-result');
+  if (msgResult) msgResult.innerHTML = '';
+  const tokenResult = $('token-verify-result');
+  if (tokenResult) tokenResult.innerHTML = '';
+  const artResult = $('artifact-verify-result');
+  if (artResult) artResult.innerHTML = '';
+}
+
+/* ============================================================================
+   1. Messages Handlers
+   ============================================================================ */
+
+async function handleSignMessage() {
+  if (!state.keyPairData) {
+    alert('Please generate a key pair first.');
+    return;
+  }
+
+  const messageText = $('msg-input').value.trim();
+  const context = $('msg-context-input').value.trim();
+
+  if (!messageText) {
+    alert('Please enter a message to sign.');
+    return;
+  }
+
+  const t0 = performance.now();
+  const signedPkg = await signMessage(state.keyPairData.keyPair.privateKey, messageText, {
+    context,
+    signerInfo: {
+      shop: 'The Daily Grind Coffee Co.',
+      author: 'Head Roaster',
+    },
+  });
+  const elapsed = (performance.now() - t0).toFixed(2);
+
+  state.signedMessagePackage = signedPkg;
+
+  // Render outputs
+  $('msg-sig-output').value = signedPkg.signature;
+  $('msg-envelope-output').value = JSON.stringify(signedPkg, null, 2);
+  $('msg-sign-bench').innerHTML = `✓ Signed via <strong>${signedPkg.algorithm}</strong> in <strong>${elapsed}ms</strong>.`;
+
+  // Prepopulate verification pane
+  $('msg-verify-text').value = signedPkg.message;
+  $('msg-verify-context').value = signedPkg.context;
+  $('msg-verify-sig').value = signedPkg.signature;
+  $('msg-verify-result').innerHTML = `<div class="alert-info">Ready to verify. Click "Verify Message Authenticity" below.</div>`;
+}
+
+async function handleVerifyMessage() {
+  if (!state.keyPairData) {
+    alert('No active public key. Please generate or import a key pair.');
+    return;
+  }
+
+  const message = $('msg-verify-text').value;
+  const context = $('msg-verify-context').value;
+  const signature = $('msg-verify-sig').value.trim();
+  const resultEl = $('msg-verify-result');
+
+  if (!message || !signature) {
+    resultEl.innerHTML = `<div class="alert-error">Missing message or signature to verify.</div>`;
+    return;
+  }
+
+  const t0 = performance.now();
+  const pkg = {
+    message,
+    context,
+    signature,
+    algorithm: state.keyPairData.suite,
+  };
+
+  const verification = await verifyMessage(state.keyPairData.publicKeyBytes, pkg);
+  const elapsed = (performance.now() - t0).toFixed(2);
+
+  if (verification.valid) {
+    resultEl.innerHTML = `
+      <div class="alert-success">
+        <h4>✅ VERIFIED AUTHENTIC</h4>
+        <p>Data integrity guaranteed. The message was signed by the holder of public key <code>${state.keyPairData.suite}</code> and has not been altered.</p>
+        <small>Verification latency: ${elapsed}ms | Domain Context: "${context || '(none)'}"</small>
+      </div>
+    `;
+  } else {
+    resultEl.innerHTML = `
+      <div class="alert-error">
+        <h4>❌ VERIFICATION FAILED / TAMPER DETECTED</h4>
+        <p>The signature is invalid for this message content, domain context, or public key.</p>
+        <small>Error: ${verification.error || 'Signature mismatch'} | Latency: ${elapsed}ms</small>
+      </div>
+    `;
+  }
+}
+
+function handleTamperMessage() {
+  const current = $('msg-verify-text').value;
+  if (!current) {
+    alert('Please sign a message first.');
+    return;
+  }
+  // Flip or alter content
+  $('msg-verify-text').value = current + ' [TAMPERED BY ATTACKER]';
+  handleVerifyMessage();
+}
+
+function handleTamperMessageContext() {
+  const currentCtx = $('msg-verify-context').value;
+  $('msg-verify-context').value = currentCtx ? (currentCtx + '-tampered') : 'forged-context';
+  handleVerifyMessage();
+}
+
+/* ============================================================================
+   2. Tokens Handlers
+   ============================================================================ */
+
+async function handleIssueToken() {
+  if (!state.keyPairData) {
+    alert('Please generate a key pair first.');
+    return;
+  }
+
+  const subject = $('token-sub').value.trim() || 'user_dailygrind_101';
+  const voucherCode = $('token-voucher').value.trim() || 'FREE_MAPLE_OAT';
+  const creditAmount = parseFloat($('token-credits').value) || 25.0;
+  const expiresInSec = parseInt($('token-exp').value, 10) || 3600;
+  const context = $('token-context').value.trim() || 'urn:dailygrind:rewards:v1';
+
+  const claims = {
+    sub: subject,
+    voucher: voucherCode,
+    credits: creditAmount,
+    tier: 'EspressoGold',
+    perks: ['Free Milk Substitutes', 'Double Beans on Tuesdays'],
+  };
+
+  const t0 = performance.now();
+  const tokenData = await createSignedToken(state.keyPairData.keyPair.privateKey, claims, {
+    expiresInSeconds: expiresInSec,
+    context,
+    issuer: 'The Daily Grind Coffee Co.',
+  });
+  const elapsed = (performance.now() - t0).toFixed(2);
+
+  state.issuedTokenData = tokenData;
+
+  $('token-output').value = tokenData.token;
+  $('token-header-preview').textContent = JSON.stringify(tokenData.header, null, 2);
+  $('token-payload-preview').textContent = JSON.stringify(tokenData.payload, null, 2);
+  $('token-bench').innerHTML = `✓ Issued <strong>${tokenData.algorithm}</strong> token in <strong>${elapsed}ms</strong>.`;
+
+  // Prepopulate verify pane
+  $('token-verify-input').value = tokenData.token;
+  $('token-verify-result').innerHTML = `<div class="alert-info">Token ready for cryptographic validation.</div>`;
+}
+
+async function handleVerifyToken() {
+  if (!state.keyPairData) {
+    alert('Please generate or import a key pair.');
+    return;
+  }
+
+  const tokenString = $('token-verify-input').value.trim();
+  const resultEl = $('token-verify-result');
+
+  if (!tokenString) {
+    resultEl.innerHTML = `<div class="alert-error">Please paste a token to verify.</div>`;
+    return;
+  }
+
+  const t0 = performance.now();
+  const res = await verifySignedToken(state.keyPairData.publicKeyBytes, tokenString, {
+    expectedIssuer: 'The Daily Grind Coffee Co.',
+  });
+  const elapsed = (performance.now() - t0).toFixed(2);
+
+  if (res.valid) {
+    resultEl.innerHTML = `
+      <div class="alert-success">
+        <h4>✅ VALID SIGNED TOKEN</h4>
+        <p>Issuer: <strong>${res.payload.iss}</strong> | Subject: <strong>${res.payload.sub}</strong></p>
+        <p>Voucher: <code>${res.payload.voucher}</code> | Balance Credits: <strong>$${res.payload.credits}</strong></p>
+        <small>Algorithm: ${res.header.alg} | Verified in ${elapsed}ms | Expires: ${new Date(res.payload.exp * 1000).toLocaleTimeString()}</small>
+      </div>
+    `;
+  } else {
+    resultEl.innerHTML = `
+      <div class="alert-error">
+        <h4>❌ INVALID / TAMPERED TOKEN</h4>
+        <p>${res.error || 'Token signature validation failed.'}</p>
+        <small>Latency: ${elapsed}ms</small>
+      </div>
+    `;
+  }
+}
+
+function handleTamperTokenCredits() {
+  const token = $('token-verify-input').value.trim();
+  if (!token) return;
+  const parts = token.split('.');
+  if (parts.length !== 3) return;
+
+  try {
+    const payload = JSON.parse(bytesToString(base64UrlToBytes(parts[1])));
+    payload.credits = 99999.00; // Maliciously inflate credits
+    payload.tier = 'UnlimitedFreeCoffeeForLife';
+    const tamperedPayloadB64 = bytesToBase64Url(stringToBytes(JSON.stringify(payload)));
+    $('token-verify-input').value = `${parts[0]}.${tamperedPayloadB64}.${parts[2]}`;
+    handleVerifyToken();
+  } catch (e) {
+    alert('Failed to parse token payload for tampering demo.');
+  }
+}
+
+function handleTamperTokenSignature() {
+  const token = $('token-verify-input').value.trim();
+  if (!token) return;
+  const parts = token.split('.');
+  if (parts.length !== 3) return;
+
+  // Corrupt signature segment
+  const corruptedSig = parts[2].slice(0, -6) + 'XXXXXX';
+  $('token-verify-input').value = `${parts[0]}.${parts[1]}.${corruptedSig}`;
+  handleVerifyToken();
+}
+
+/* ============================================================================
+   3. Artifacts Handlers
+   ============================================================================ */
+
+async function loadDefaultArtifact() {
+  try {
+    // Fetch default stock photo artifact to have bytes loaded
+    const res = await fetch(state.currentArtifact.previewUrl);
+    const buffer = await res.arrayBuffer();
+    state.currentArtifact.bytes = new Uint8Array(buffer);
+    renderArtifactDetails();
+  } catch (err) {
+    // If offline or blocked, create a sample synthetic binary artifact
+    const sampleText = 'The Daily Grind Single-Origin Artisan Bean Certificate #8402 (Fallback Artifact)';
+    state.currentArtifact.bytes = stringToBytes(sampleText);
+    renderArtifactDetails();
+  }
+}
+
+async function renderArtifactDetails() {
+  const art = state.currentArtifact;
+  $('artifact-name').textContent = art.name;
+  $('artifact-size').textContent = `${(art.bytes.byteLength / 1024).toFixed(2)} KB (${art.bytes.byteLength} bytes)`;
+
+  // Compute SHA-256 hash
+  const hash = await hashArtifact(art.bytes);
+  $('artifact-sha256').textContent = hash.hex;
+
+  // Preview
+  const imgPreview = $('artifact-preview-img');
+  if (art.previewUrl) {
+    imgPreview.src = art.previewUrl;
+    imgPreview.style.display = 'block';
+  } else {
+    imgPreview.style.display = 'none';
+  }
+}
+
+async function handleArtifactPresetChange(e) {
+  const val = e.target.value;
+  if (val === 'roasted-beans') {
+    state.currentArtifact = {
+      name: 'ethiopian-yirgacheffe-roast.jpg',
+      mimeType: 'image/jpeg',
+      previewUrl: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=800&q=80',
+      bytes: null,
+      envelope: null,
+    };
+    await loadDefaultArtifact();
+  } else if (val === 'latte-art') {
+    state.currentArtifact = {
+      name: 'barista-championship-entry.jpg',
+      mimeType: 'image/jpeg',
+      previewUrl: 'https://images.unsplash.com/photo-1509785307050-d4066910ec1e?auto=format&fit=crop&w=800&q=80',
+      bytes: null,
+      envelope: null,
+    };
+    await loadDefaultArtifact();
+  } else if (val === 'batch-report') {
+    const jsonReport = JSON.stringify({
+      reportId: 'REP-2026-X99',
+      batch: 'Ethiopia Natural Process',
+      moistureContent: '10.8%',
+      density: '710 g/L',
+      roastDegrees: 418.5,
+      firstCrackTime: '8m 42s',
+      dropTemp: '412 F',
+    }, null, 2);
+    state.currentArtifact = {
+      name: 'roast-cupping-report.json',
+      mimeType: 'application/json',
+      previewUrl: null,
+      bytes: stringToBytes(jsonReport),
+      envelope: null,
+    };
+    await renderArtifactDetails();
+  }
+}
+
+function handleCustomArtifactUpload(e) {
+  const file = e.target.files[0];
+  if (!file) return;
+
+  const reader = new FileReader();
+  reader.onload = async () => {
+    state.currentArtifact = {
+      name: file.name,
+      mimeType: file.type || 'application/octet-stream',
+      previewUrl: file.type.startsWith('image/') ? URL.createObjectURL(file) : null,
+      bytes: new Uint8Array(reader.result),
+      envelope: null,
+    };
+    await renderArtifactDetails();
+  };
+  reader.readAsArrayBuffer(file);
+}
+
+async function handleSignArtifact() {
+  if (!state.keyPairData) {
+    alert('Please generate a key pair first.');
+    return;
+  }
+  if (!state.currentArtifact.bytes) {
+    alert('No artifact bytes loaded.');
+    return;
+  }
+
+  const t0 = performance.now();
+  const envelope = await signArtifact(state.keyPairData.keyPair.privateKey, state.currentArtifact.bytes, {
+    artifactName: state.currentArtifact.name,
+    mimeType: state.currentArtifact.mimeType,
+    customMetadata: {
+      origin: 'The Daily Grind Roasting Lab',
+      signedBy: 'Lead Quality Inspector',
+    },
+  });
+  const elapsed = (performance.now() - t0).toFixed(2);
+
+  state.currentArtifact.envelope = envelope;
+
+  $('artifact-sig-output').value = envelope.signature;
+  $('artifact-manifest-output').value = JSON.stringify(envelope.manifest, null, 2);
+  $('artifact-sign-bench').innerHTML = `✓ Artifact signed using <strong>${envelope.algorithm}</strong> in <strong>${elapsed}ms</strong>.`;
+
+  $('artifact-verify-result').innerHTML = `<div class="alert-info">Artifact envelope signed. Click "Verify Artifact Authenticity" to test integrity and signature.</div>`;
+}
+
+async function handleVerifyArtifact() {
+  if (!state.keyPairData) {
+    alert('Please generate or import a key pair.');
+    return;
+  }
+  if (!state.currentArtifact.bytes || !state.currentArtifact.envelope) {
+    alert('Please sign the artifact first or load an artifact signature envelope.');
+    return;
+  }
+
+  const resultEl = $('artifact-verify-result');
+  const t0 = performance.now();
+
+  const verification = await verifyArtifact(
+    state.keyPairData.publicKeyBytes,
+    state.currentArtifact.bytes,
+    state.currentArtifact.envelope
+  );
+  const elapsed = (performance.now() - t0).toFixed(2);
+
+  if (verification.valid) {
+    resultEl.innerHTML = `
+      <div class="alert-success">
+        <h4>✅ ARTIFACT AUTHENTIC & INTACT</h4>
+        <p>File: <strong>${verification.manifest.artifactName}</strong> (${verification.manifest.sizeBytes} bytes)</p>
+        <p>SHA-256 Digest: <code>${verification.actualHash}</code></p>
+        <small>Algorithm: ${verification.algorithm} | Verified in ${elapsed}ms | Origin: ${verification.manifest.metadata?.origin || 'Verified'}</small>
+      </div>
+    `;
+  } else {
+    resultEl.innerHTML = `
+      <div class="alert-error">
+        <h4>❌ ARTIFACT VERIFICATION FAILED</h4>
+        <p>${verification.error}</p>
+        <p>Integrity (SHA-256 match): <strong>${verification.integrityValid ? 'PASS' : 'FAIL (Bit rot or tampering detected)'}</strong></p>
+        <p>Digital Signature: <strong>${verification.signatureValid ? 'PASS' : 'FAIL (Wrong key or signature)'}</strong></p>
+        <small>Latency: ${elapsed}ms</small>
+      </div>
+    `;
+  }
+}
+
+function handleCorruptArtifact() {
+  if (!state.currentArtifact.bytes) return;
+  // Corrupt the first byte
+  const corrupted = new Uint8Array(state.currentArtifact.bytes);
+  corrupted[0] ^= 0xff;
+  state.currentArtifact.bytes = corrupted;
+  renderArtifactDetails();
+  handleVerifyArtifact();
+}
+
+/* ============================================================================
+   4. Live In-Browser Self-Test & Benchmark Runner
+   ============================================================================ */
+
+async function handleRunSelfTest() {
+  const container = $('selftest-output');
+  container.innerHTML = '<div class="alert-info">Running live cryptographic self-test suite...</div>';
+
+  const log = [];
+  const addLog = (suiteName, testName, passed, timeMs, details = '') => {
+    log.push({ suiteName, testName, passed, timeMs, details });
+    renderSelfTestResults(container, log);
+  };
+
+  try {
+    // 1. ML-DSA or Ed25519 Key Generation
+    const pqSupported = supportsPostQuantumSignatures();
+    const suite = pqSupported ? 'ML-DSA-65' : 'Ed25519';
+
+    let t0 = performance.now();
+    const kp = await generateSigningKeyPair(suite);
+    let dt = (performance.now() - t0).toFixed(2);
+    addLog(suite, 'Key Pair Generation', true, dt, `Public Key size: ${kp.publicKeyBytes.byteLength} bytes`);
+
+    // 2. Export & Re-import
+    t0 = performance.now();
+    const exportedPub = await exportPublicKey(kp.keyPair.publicKey);
+    const importedPub = await importPublicKey(exportedPub.bytes);
+    dt = (performance.now() - t0).toFixed(2);
+    addLog(suite, 'Key Export / Import', importedPub.algorithm.name.includes(suite.replace('-P256', '')), dt);
+
+    // 3. Message Signing & Verification
+    t0 = performance.now();
+    const msgPkg = await signMessage(kp.keyPair.privateKey, 'Daily Grind Self-Test Message', {
+      context: 'selftest:message:v1',
+    });
+    const msgVerified = await verifyMessage(kp.publicKeyBytes, msgPkg);
+    dt = (performance.now() - t0).toFixed(2);
+    addLog(suite, 'Message Sign & Verify (with ContextParams)', msgVerified.valid, dt, `Signature: ${msgPkg.signature.slice(0, 32)}...`);
+
+    // 4. Message Tamper Detection
+    t0 = performance.now();
+    const tamperedMsgPkg = { ...msgPkg, message: 'Daily Grind Tampered Message' };
+    const tamperDetected = !(await verifyMessage(kp.publicKeyBytes, tamperedMsgPkg)).valid;
+    dt = (performance.now() - t0).toFixed(2);
+    addLog(suite, 'Message Tampering Rejection', tamperDetected, dt, 'Tampered payload rejected immediately');
+
+    // 5. Context Domain Separation
+    t0 = performance.now();
+    const wrongContextDetected = !(await verifyMessage(kp.publicKeyBytes, msgPkg, { expectedContext: 'wrong-context' })).valid;
+    dt = (performance.now() - t0).toFixed(2);
+    addLog(suite, 'Domain Separation Enforcement', wrongContextDetected, dt, 'Context mismatch rejected');
+
+    // 6. Token Issuance & Verification
+    t0 = performance.now();
+    const tok = await createSignedToken(kp.keyPair.privateKey, { sub: 'selftest_user', credits: 100 });
+    const tokVerified = await verifySignedToken(kp.publicKeyBytes, tok.token);
+    dt = (performance.now() - t0).toFixed(2);
+    addLog(suite, 'Token Issuance & Verification', tokVerified.valid, dt, `Token length: ${tok.token.length} chars`);
+
+    // 7. Artifact Integrity & Signature
+    t0 = performance.now();
+    const artifactData = stringToBytes('Authentic Batch #100 Sample Raw Beans Data');
+    const envelope = await signArtifact(kp.keyPair.privateKey, artifactData, { artifactName: 'sample.dat' });
+    const artVerified = await verifyArtifact(kp.publicKeyBytes, artifactData, envelope);
+    dt = (performance.now() - t0).toFixed(2);
+    addLog(suite, 'Artifact SHA-256 Digest & Signature', artVerified.valid && artVerified.integrityValid, dt, `SHA-256: ${envelope.manifest.sha256}`);
+
+    // 8. Classical Fallback Verification (Ed25519)
+    if (suite !== 'Ed25519') {
+      t0 = performance.now();
+      const edKp = await generateSigningKeyPair('Ed25519');
+      const edMsg = await signMessage(edKp.keyPair.privateKey, 'Classical fallback message', { context: 'ctx:ed25519' });
+      const edOk = await verifyMessage(edKp.publicKeyBytes, edMsg);
+      dt = (performance.now() - t0).toFixed(2);
+      addLog('Ed25519', 'Classical Ed25519 Fallback Pipeline', edOk.valid, dt, 'Edwards-curve signature verified');
+    }
+  } catch (err) {
+    addLog('SelfTest', 'Suite Execution Error', false, 0, err.message);
+  }
+}
+
+function renderSelfTestResults(container, log) {
+  let html = '<div class="selftest-table-wrapper"><table class="selftest-table"><thead><tr><th>Suite</th><th>Test Action</th><th>Result</th><th>Latency</th><th>Details</th></tr></thead><tbody>';
+  for (const item of log) {
+    html += `
+      <tr>
+        <td><strong>${item.suiteName}</strong></td>
+        <td>${item.testName}</td>
+        <td>${item.passed ? '<span class="badge-pass">PASS ✓</span>' : '<span class="badge-fail">FAIL ✗</span>'}</td>
+        <td>${item.timeMs}ms</td>
+        <td><code>${item.details}</code></td>
+      </tr>
+    `;
+  }
+  html += '</tbody></table></div>';
+  container.innerHTML = html;
+}
+
+// Auto-boot if in browser
+if (typeof window !== 'undefined') {
+  window.addEventListener('DOMContentLoaded', initApp);
+}
