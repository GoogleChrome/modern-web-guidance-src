+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+
+import {
+  generateSigningKeyPair,
+  signPayload,
+  verifyPayload,
+  signMessage,
+  verifyMessage,
+  createSignedToken,
+  verifySignedToken,
+  signArtifact,
+  verifyArtifact,
+  importPublicKey,
+  exportPublicKey,
+} from '../crypto-signatures.js';
+
+describe('Security Edge Cases & Cross-Key Isolation', () => {
+  test('Cross-key verification failure (Signature from Keypair A cannot be verified by Keypair B)', async () => {
+    const keyA = await generateSigningKeyPair('ML-DSA-65');
+    const keyB = await generateSigningKeyPair('ML-DSA-65');
+
+    const message = 'Confidential Blend Recipe #42';
+    const signedPkg = await signMessage(keyA.keyPair.privateKey, message);
+
+    // Verifying with Key A succeeds
+    const validWithA = await verifyMessage(keyA.publicKeyBytes, signedPkg);
+    assert.equal(validWithA.valid, true);
+
+    // Verifying with Key B fails
+    const invalidWithB = await verifyMessage(keyB.publicKeyBytes, signedPkg);
+    assert.equal(invalidWithB.valid, false);
+  });
+
+  test('Unicode, multi-byte, and large payload handling', async () => {
+    const { keyPair, publicKeyBytes } = await generateSigningKeyPair();
+    const complexMessage = '☕ 🫖 Special Reserve Single-Origin Geisha: 100% 埃塞俄比亚 • 2026. Includes emojis & quotes: "Freshly Ground" / <xml>&json</xml>';
+
+    const signedPkg = await signMessage(keyPair.privateKey, complexMessage, {
+      context: 'unicode:test:v1',
+    });
+
+    const verifyResult = await verifyMessage(publicKeyBytes, signedPkg);
+    assert.equal(verifyResult.valid, true);
+    assert.equal(verifyResult.message, complexMessage);
+  });
+
+  test('Token audience and subject validation', async () => {
+    const { keyPair, publicKeyBytes } = await generateSigningKeyPair();
+
+    const { token } = await createSignedToken(keyPair.privateKey, {
+      sub: 'barista_alex',
+      aud: 'register_terminal_03',
+      role: 'HeadBarista',
+    }, {
+      issuer: 'The Daily Grind HQ',
+    });
+
+    // Valid
+    const valid = await verifySignedToken(publicKeyBytes, token, {
+      expectedIssuer: 'The Daily Grind HQ',
+    });
+    assert.equal(valid.valid, true);
+    assert.equal(valid.payload.sub, 'barista_alex');
+
+    // Wrong issuer
+    const wrongIssuer = await verifySignedToken(publicKeyBytes, token, {
+      expectedIssuer: 'Fake Coffee Chain',
+    });
+    assert.equal(wrongIssuer.valid, false);
+    assert.ok(wrongIssuer.error.includes('Issuer mismatch'));
+  });
+
+  test('Binary artifact signing with 64KB random buffer', async () => {
+    const { keyPair, publicKeyBytes } = await generateSigningKeyPair();
+    const largeBuffer = new Uint8Array(65536);
+    for (let i = 0; i < largeBuffer.length; i++) {
+      largeBuffer[i] = (i * 31 + 7) & 0xff;
+    }
+
+    const envelope = await signArtifact(keyPair.privateKey, largeBuffer, {
+      artifactName: 'roast_firmware_v2.bin',
+      mimeType: 'application/octet-stream',
+    });
+
+    assert.equal(envelope.manifest.sizeBytes, 65536);
+
+    const verified = await verifyArtifact(publicKeyBytes, largeBuffer, envelope);
+    assert.equal(verified.valid, true);
+    assert.equal(verified.integrityValid, true);
+
+    // Corrupt one byte in the 64KB binary
+    largeBuffer[32768] ^= 0x01;
+    const corrupted = await verifyArtifact(publicKeyBytes, largeBuffer, envelope);
+    assert.equal(corrupted.valid, false);
+    assert.equal(corrupted.integrityValid, false);
+  });
+});
