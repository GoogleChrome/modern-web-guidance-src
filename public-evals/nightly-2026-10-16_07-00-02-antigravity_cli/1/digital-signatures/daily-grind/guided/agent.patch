+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+
+import {
+  supportsPostQuantumSignatures,
+  hasSubtleCryptoSupports,
+  detectSupportedSuites,
+  generateSigningKeyPair,
+  exportPublicKey,
+  importPublicKey,
+  exportPrivateKey,
+  importPrivateKey,
+  getPublicKeyFromPrivateKey,
+  signPayload,
+  verifyPayload,
+  signMessage,
+  verifyMessage,
+  createSignedToken,
+  verifySignedToken,
+  hashArtifact,
+  signArtifact,
+  verifyArtifact,
+  frameFallbackInput,
+  bytesToHex,
+  hexToBytes,
+  bytesToBase64,
+  base64ToBytes,
+  bytesToBase64Url,
+  base64UrlToBytes,
+  stringToBytes,
+  bytesToString,
+} from '../crypto-signatures.js';
+
+describe('WebCrypto Capabilities and Helpers', () => {
+  test('detects SubtleCrypto.supports static method', () => {
+    assert.equal(typeof hasSubtleCryptoSupports(), 'boolean');
+    assert.equal(hasSubtleCryptoSupports(), true);
+  });
+
+  test('probes post-quantum and classical signature suites', () => {
+    const pqSupported = supportsPostQuantumSignatures();
+    assert.equal(typeof pqSupported, 'boolean');
+    const { supportedSuites, defaultSuite } = detectSupportedSuites();
+    assert.ok(supportedSuites.length > 0);
+    assert.ok(supportedSuites.includes('Ed25519') || supportedSuites.includes('ML-DSA-65'));
+    assert.ok(defaultSuite);
+  });
+
+  test('encoding helpers: hex, base64, base64url, utf8', () => {
+    const raw = new Uint8Array([0, 15, 255, 128, 64]);
+    const hex = bytesToHex(raw);
+    assert.equal(hex, '000fff8040');
+    assert.deepEqual(hexToBytes(hex), raw);
+
+    const b64 = bytesToBase64(raw);
+    assert.deepEqual(base64ToBytes(b64), raw);
+
+    const b64url = bytesToBase64Url(raw);
+    assert.deepEqual(base64UrlToBytes(b64url), raw);
+
+    const str = 'The Daily Grind Artisanal Roast ☕ 2026';
+    const utf8 = stringToBytes(str);
+    assert.equal(bytesToString(utf8), str);
+  });
+
+  test('frameFallbackInput enforces <= 255 bytes limit', () => {
+    const payload = new Uint8Array([1, 2, 3]);
+    const validCtx = new Uint8Array(255);
+    const framed = frameFallbackInput(payload, validCtx);
+    assert.equal(framed[0], 255);
+    assert.equal(framed.length, 1 + 255 + 3);
+
+    const invalidCtx = new Uint8Array(256);
+    assert.throws(() => {
+      frameFallbackInput(payload, invalidCtx);
+    }, (err) => err.name === 'OperationError');
+  });
+});
+
+describe('Post-Quantum Cryptography (ML-DSA)', () => {
+  const pqSupported = supportsPostQuantumSignatures();
+
+  test('ML-DSA-65 Key Pair Generation, Export, and Import', { skip: !pqSupported }, async () => {
+    const { suite, keyPair, publicKeyBytes, publicKeyHex, publicKeyBase64 } =
+      await generateSigningKeyPair('ML-DSA-65');
+
+    assert.equal(suite, 'ML-DSA-65');
+    assert.equal(publicKeyBytes.byteLength, 1952);
+    assert.equal(publicKeyHex.length, 1952 * 2);
+    assert.ok(publicKeyBase64.length > 0);
+
+    // Export raw-public
+    const exportedPub = await exportPublicKey(keyPair.publicKey);
+    assert.equal(exportedPub.format, 'raw-public');
+    assert.deepEqual(exportedPub.bytes, publicKeyBytes);
+
+    // Import from bytes
+    const importedFromBytes = await importPublicKey(publicKeyBytes);
+    assert.equal(importedFromBytes.algorithm.name, 'ML-DSA-65');
+
+    // Import from hex
+    const importedFromHex = await importPublicKey(publicKeyHex);
+    assert.equal(importedFromHex.algorithm.name, 'ML-DSA-65');
+
+    // Import from base64
+    const importedFromB64 = await importPublicKey(publicKeyBase64);
+    assert.equal(importedFromB64.algorithm.name, 'ML-DSA-65');
+
+    // Export & import private key using raw-seed (32 bytes)
+    const exportedPriv = await exportPrivateKey(keyPair.privateKey, 'raw-seed');
+    assert.equal(exportedPriv.format, 'raw-seed');
+    assert.equal(exportedPriv.bytes.byteLength, 32);
+
+    const importedPriv = await importPrivateKey(exportedPriv.bytes, 'ML-DSA-65', 'raw-seed');
+    assert.equal(importedPriv.algorithm.name, 'ML-DSA-65');
+
+    // Derive public key from private key
+    if (typeof crypto.subtle.getPublicKey === 'function') {
+      const derivedPub = await getPublicKeyFromPrivateKey(keyPair.privateKey);
+      assert.equal(derivedPub.algorithm.name, 'ML-DSA-65');
+    }
+  });
+
+  test('ML-DSA-65 Payload Signing and Verification with Domain Separation', { skip: !pqSupported }, async () => {
+    const { keyPair, publicKeyBytes } = await generateSigningKeyPair('ML-DSA-65');
+    const payload = stringToBytes('Order #8921: 2x Maple Oat Latte');
+    const context = stringToBytes('dailygrind:orders:v1');
+
+    // Sign payload
+    const { signatureBytes, signatureHex, signatureBase64, algorithm } =
+      await signPayload(keyPair.privateKey, payload, context);
+
+    assert.equal(algorithm, 'ML-DSA-65');
+    assert.equal(signatureBytes.byteLength, 3309);
+    assert.ok(signatureHex.length > 0);
+    assert.ok(signatureBase64.length > 0);
+
+    // Verification succeeds with matching context
+    const valid = await verifyPayload(publicKeyBytes, signatureBytes, payload, context);
+    assert.equal(valid, true);
+
+    // Verification fails if context differs
+    const wrongContext = stringToBytes('dailygrind:rewards:v1');
+    const invalidContext = await verifyPayload(publicKeyBytes, signatureBytes, payload, wrongContext);
+    assert.equal(invalidContext, false);
+
+    // Verification fails if payload is tampered
+    const tamperedPayload = stringToBytes('Order #8921: 200x Maple Oat Latte');
+    const invalidPayload = await verifyPayload(publicKeyBytes, signatureBytes, tamperedPayload, context);
+    assert.equal(invalidPayload, false);
+
+    // Verification fails if signature is corrupted
+    const corruptedSignature = new Uint8Array(signatureBytes);
+    corruptedSignature[10] ^= 0xff;
+    const invalidSig = await verifyPayload(publicKeyBytes, corruptedSignature, payload, context);
+    assert.equal(invalidSig, false);
+  });
+
+  test('ML-DSA-44 and ML-DSA-87 Variants', { skip: !pqSupported }, async () => {
+    for (const [algo, expectedPubLen, expectedSigLen] of [
+      ['ML-DSA-44', 1312, 2420],
+      ['ML-DSA-87', 2592, 4627],
+    ]) {
+      const { keyPair, publicKeyBytes } = await generateSigningKeyPair(algo);
+      assert.equal(publicKeyBytes.byteLength, expectedPubLen);
+
+      const payload = stringToBytes(`Testing ${algo}`);
+      const { signatureBytes } = await signPayload(keyPair.privateKey, payload);
+      assert.equal(signatureBytes.byteLength, expectedSigLen);
+
+      const ok = await verifyPayload(publicKeyBytes, signatureBytes, payload);
+      assert.equal(ok, true);
+    }
+  });
+});
+
+describe('Classical Cryptography (Ed25519 & ECDSA Fallbacks)', () => {
+  test('Ed25519 Key Generation, Export, Import, Signing, and Verification', async () => {
+    const { suite, keyPair, publicKeyBytes, publicKeyHex } =
+      await generateSigningKeyPair('Ed25519');
+
+    assert.equal(suite, 'Ed25519');
+    assert.equal(publicKeyBytes.byteLength, 32);
+
+    const exported = await exportPublicKey(keyPair.publicKey);
+    assert.equal(exported.format, 'raw');
+    assert.deepEqual(exported.bytes, publicKeyBytes);
+
+    const imported = await importPublicKey(publicKeyHex);
+    assert.equal(imported.algorithm.name, 'Ed25519');
+
+    const payload = stringToBytes('Artisanal Dark Roast Batch #411');
+    const context = stringToBytes('ctx:batch-roast:v1');
+
+    const { signatureBytes, algorithm } = await signPayload(keyPair.privateKey, payload, context);
+    assert.equal(algorithm, 'Ed25519');
+    assert.equal(signatureBytes.byteLength, 64);
+
+    // Valid
+    const isValid = await verifyPayload(imported, signatureBytes, payload, context);
+    assert.equal(isValid, true);
+
+    // Invalid when context mismatch
+    const badContext = await verifyPayload(imported, signatureBytes, payload, stringToBytes('wrong'));
+    assert.equal(badContext, false);
+
+    // Invalid when payload tampered
+    const badPayload = await verifyPayload(imported, signatureBytes, stringToBytes('Tampered Batch'), context);
+    assert.equal(badPayload, false);
+  });
+});
+
+describe('1. Message Signing and Verification', () => {
+  test('Signs and verifies messages with authenticity and tamper detection', async () => {
+    const { keyPair, publicKeyBytes, suite } = await generateSigningKeyPair();
+    const message = 'Roaster Announcement: New seasonal Geisha lot arrived from Panama.';
+    const context = 'announcement:seasonal:2026';
+
+    const signedPkg = await signMessage(keyPair.privateKey, message, {
+      context,
+      signerInfo: { author: 'Head Roaster Maya' },
+    });
+
+    assert.equal(signedPkg.type, 'signed-message');
+    assert.equal(signedPkg.message, message);
+    assert.equal(signedPkg.context, context);
+    assert.ok(signedPkg.signature);
+
+    // Verify valid message
+    const verifyResult = await verifyMessage(publicKeyBytes, signedPkg);
+    assert.equal(verifyResult.valid, true);
+    assert.equal(verifyResult.message, message);
+
+    // Verify with explicit expectedContext
+    const verifyWithContext = await verifyMessage(publicKeyBytes, signedPkg, {
+      expectedContext: context,
+    });
+    assert.equal(verifyWithContext.valid, true);
+
+    // Verify fails if expectedContext does not match
+    const verifyWrongContext = await verifyMessage(publicKeyBytes, signedPkg, {
+      expectedContext: 'wrong-domain-context',
+    });
+    assert.equal(verifyWrongContext.valid, false);
+
+    // Verify fails if message is tampered
+    const tamperedPkg = { ...signedPkg, message: 'Malicious announcement: Free coffee indefinitely!' };
+    const tamperedResult = await verifyMessage(publicKeyBytes, tamperedPkg);
+    assert.equal(tamperedResult.valid, false);
+    assert.ok(tamperedResult.error);
+
+    // Verify fails if signature is tampered
+    const tamperedSigPkg = { ...signedPkg, signature: signedPkg.signature.slice(0, -4) + 'AAAA' };
+    const tamperedSigResult = await verifyMessage(publicKeyBytes, tamperedSigPkg);
+    assert.equal(tamperedSigResult.valid, false);
+  });
+});
+
+describe('2. Token Signing and Verification', () => {
+  test('Creates and verifies compact post-quantum / classical signed tokens', async () => {
+    const { keyPair, publicKeyBytes } = await generateSigningKeyPair();
+
+    const claims = {
+      sub: 'cust_8921',
+      voucherCode: 'MAPLE_OAT_FREE',
+      creditAmount: 25.0,
+      tier: 'GoldMember',
+    };
+
+    const { token, header, payload } = await createSignedToken(keyPair.privateKey, claims, {
+      expiresInSeconds: 3600,
+      issuer: 'The Daily Grind Coffee Co.',
+    });
+
+    assert.ok(typeof token === 'string');
+    assert.equal(token.split('.').length, 3);
+    assert.equal(payload.sub, 'cust_8921');
+    assert.equal(payload.voucherCode, 'MAPLE_OAT_FREE');
+
+    // Verify valid token
+    const verifyResult = await verifySignedToken(publicKeyBytes, token, {
+      expectedIssuer: 'The Daily Grind Coffee Co.',
+    });
+    assert.equal(verifyResult.valid, true);
+    assert.equal(verifyResult.payload.creditAmount, 25.0);
+    assert.equal(verifyResult.payload.tier, 'GoldMember');
+
+    // Tampering test: attacker tries to elevate creditAmount to 9999.00
+    const parts = token.split('.');
+    const decodedPayload = JSON.parse(bytesToString(base64UrlToBytes(parts[1])));
+    decodedPayload.creditAmount = 9999.0;
+    const forgedPayloadB64 = bytesToBase64Url(stringToBytes(JSON.stringify(decodedPayload)));
+    const forgedToken = `${parts[0]}.${forgedPayloadB64}.${parts[2]}`;
+
+    const forgedResult = await verifySignedToken(publicKeyBytes, forgedToken);
+    assert.equal(forgedResult.valid, false);
+    assert.ok(forgedResult.error.includes('tampered') || forgedResult.error.includes('invalid'));
+
+    // Expiration test: expired token
+    const expiredTokenData = await createSignedToken(keyPair.privateKey, claims, {
+      expiresInSeconds: -10, // already expired
+    });
+    const expiredResult = await verifySignedToken(publicKeyBytes, expiredTokenData.token, {
+      clockToleranceSeconds: 0,
+    });
+    assert.equal(expiredResult.valid, false);
+    assert.equal(expiredResult.expired, true);
+  });
+});
+
+describe('3. Artifact Signing and Verification', () => {
+  test('Signs and verifies file artifacts with SHA-256 integrity and authenticity', async () => {
+    const { keyPair, publicKeyBytes } = await generateSigningKeyPair();
+
+    // Mock an artisanal batch certificate artifact (e.g. PDF or binary data)
+    const certificateText = `
+      =======================================================
+      THE DAILY GRIND - ARTISANAL BATCH CERTIFICATION #2026-X
+      Origin: Yirgacheffe, Gedeo Zone, Ethiopia
+      Elevation: 2,100m | Variety: Heirloom
+      Roast Profile: City+ (Medium Light)
+      Cupping Score: 91.5
+      Master Roaster: Eleanor Vance
+      =======================================================
+    `;
+    const artifactBytes = stringToBytes(certificateText);
+
+    // Compute hash independently to check helper
+    const hash = await hashArtifact(artifactBytes);
+    assert.equal(hash.hex.length, 64);
+
+    // Sign artifact
+    const envelope = await signArtifact(keyPair.privateKey, artifactBytes, {
+      artifactName: 'batch-certificate-2026-X.txt',
+      mimeType: 'text/plain',
+      customMetadata: { batchId: '2026-X', cuppingScore: 91.5 },
+    });
+
+    assert.equal(envelope.type, 'artifact-signature-envelope');
+    assert.equal(envelope.manifest.artifactName, 'batch-certificate-2026-X.txt');
+    assert.equal(envelope.manifest.sha256, hash.hex);
+    assert.ok(envelope.signature);
+
+    // Verify authentic artifact
+    const result = await verifyArtifact(publicKeyBytes, artifactBytes, envelope);
+    assert.equal(result.valid, true);
+    assert.equal(result.integrityValid, true);
+    assert.equal(result.signatureValid, true);
+
+    // Tamper test 1: Modify a single character in the artifact file bytes
+    const tamperedArtifactBytes = stringToBytes(certificateText.replace('91.5', '99.9'));
+    const tamperedResult = await verifyArtifact(publicKeyBytes, tamperedArtifactBytes, envelope);
+    assert.equal(tamperedResult.valid, false);
+    assert.equal(tamperedResult.integrityValid, false);
+    assert.ok(tamperedResult.error.includes('Integrity check failed'));
+
+    // Tamper test 2: Modify manifest metadata but keep artifact bytes same
+    const forgedEnvelope = JSON.parse(JSON.stringify(envelope));
+    forgedEnvelope.manifest.metadata.cuppingScore = 100.0;
+    const forgedManifestResult = await verifyArtifact(publicKeyBytes, artifactBytes, forgedEnvelope);
+    assert.equal(forgedManifestResult.valid, false);
+    assert.equal(forgedManifestResult.signatureValid, false);
+  });
+});
