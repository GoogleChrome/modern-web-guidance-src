+  let keyPair;
+  let publicKeyBytes;
+
+  if (targetSuite.startsWith('ML-DSA')) {
+    keyPair = await globalThis.crypto.subtle.generateKey(
+      targetSuite,
+      extractable,
+      ['sign', 'verify']
+    );
+    // Export with 'raw-public' (legacy 'raw' throws NotSupportedError on ML-DSA)
+    publicKeyBytes = new Uint8Array(
+      await globalThis.crypto.subtle.exportKey('raw-public', keyPair.publicKey)
+    );
+  } else if (targetSuite === 'Ed25519') {
+    keyPair = await globalThis.crypto.subtle.generateKey(
+      'Ed25519',
+      extractable,
+      ['sign', 'verify']
+    );
+    publicKeyBytes = new Uint8Array(
+      await globalThis.crypto.subtle.exportKey('raw', keyPair.publicKey)
+    );
+  } else if (targetSuite === 'ECDSA-P256' || targetSuite === 'ECDSA') {
+    keyPair = await globalThis.crypto.subtle.generateKey(
+      { name: 'ECDSA', namedCurve: 'P-256' },
+      extractable,
+      ['sign', 'verify']
+    );
+    publicKeyBytes = new Uint8Array(
+      await globalThis.crypto.subtle.exportKey('raw', keyPair.publicKey)
+    );
+    targetSuite = 'ECDSA-P256';
+  } else {
+    throw new Error(`Unsupported signature suite: ${targetSuite}`);
+  }
+
+  return {
+    suite: targetSuite,
+    keyPair,
+    publicKeyBytes,
+    publicKeyHex: bytesToHex(publicKeyBytes),
+    publicKeyBase64: bytesToBase64(publicKeyBytes),
+  };
+}
+
+/**
+ * Export public key to bytes/hex/base64.
+ */
+export async function exportPublicKey(publicKey, format = null) {
+  if (!(publicKey instanceof CryptoKey)) {
+    throw new TypeError('Expected CryptoKey for publicKey');
+  }
+
+  const algoName = publicKey.algorithm.name;
+  const isMlDsa = algoName.startsWith('ML-DSA');
+  const targetFormat = format || (isMlDsa ? 'raw-public' : 'raw');
+
+  const keyBuffer = await globalThis.crypto.subtle.exportKey(targetFormat, publicKey);
+  const bytes = new Uint8Array(keyBuffer);
+
+  return {
+    format: targetFormat,
+    algorithm: algoName,
+    bytes,
+    hex: bytesToHex(bytes),
+    base64: bytesToBase64(bytes),
+  };
+}
+
