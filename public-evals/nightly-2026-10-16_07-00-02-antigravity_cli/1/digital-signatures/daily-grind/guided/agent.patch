+
+/**
+ * Check if the current environment supports SubtleCrypto.supports static method.
+ * Call SubtleCrypto.supports() on the SubtleCrypto constructor, not on crypto.subtle.
+ */
+export function hasSubtleCryptoSupports() {
+  return typeof globalThis.SubtleCrypto?.supports === 'function';
+}
+
+/**
+ * Probe whether a specific operation and algorithm are supported.
+ */
+export function supportsAlgorithm(operation, algorithm) {
+  if (hasSubtleCryptoSupports()) {
+    try {
+      return Boolean(globalThis.SubtleCrypto.supports(operation, algorithm));
+    } catch {
+      return false;
+    }
+  }
+  return false;
+}
+
+/**
+ * Detect whether post-quantum ML-DSA signatures are supported natively.
+ */
+export function supportsPostQuantumSignatures() {
+  return supportsAlgorithm('sign', 'ML-DSA-65');
+}
+
+/**
+ * Detect all supported suites in the runtime environment.
+ */
+export function detectSupportedSuites() {
+  const supported = [];
+  const suites = ['ML-DSA-65', 'ML-DSA-44', 'ML-DSA-87', 'Ed25519'];
+
+  for (const s of suites) {
+    if (supportsAlgorithm('sign', s)) {
+      supported.push(s);
+    }
+  }
+
+  if (supportsAlgorithm('sign', { name: 'ECDSA', hash: 'SHA-256' })) {
+    supported.push('ECDSA-P256');
+  }
+
+  const pqAvailable = supported.includes('ML-DSA-65');
+  const defaultSuite = pqAvailable
+    ? 'ML-DSA-65'
+    : (supported.includes('Ed25519') ? 'Ed25519' : (supported[0] || 'ECDSA-P256'));
+
+  return {
+    supportedSuites: supported,
+    isPostQuantumReady: pqAvailable,
+    defaultSuite,
+  };
+}
+
+/* ============================================================================
+   Encoding and Conversion Helpers
+   ============================================================================ */
+
+export function bytesToHex(bytes) {
+  const arr = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  let hex = '';
+  for (let i = 0; i < arr.length; i++) {
+    hex += arr[i].toString(16).padStart(2, '0');
+  }
+  return hex;
+}
+
+export function hexToBytes(hex) {
+  const cleanHex = hex.trim().replace(/^0x/i, '').replace(/[\s\r\n]/g, '');
+  if (cleanHex.length % 2 !== 0) {
+    throw new Error('Invalid hex string: odd length');
+  }
+  const bytes = new Uint8Array(cleanHex.length / 2);
+  for (let i = 0; i < cleanHex.length; i += 2) {
+    bytes[i / 2] = parseInt(cleanHex.substring(i, i + 2), 16);
+  }
+  return bytes;
+}
+
+export function bytesToBase64(bytes) {
+  const arr = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  if (typeof Buffer !== 'undefined') {
+    return Buffer.from(arr).toString('base64');
+  }
+  let binary = '';
+  for (let i = 0; i < arr.byteLength; i++) {
+    binary += String.fromCharCode(arr[i]);
+  }
+  return btoa(binary);
+}
+
+export function base64ToBytes(base64) {
+  const clean = base64.trim().replace(/[\s\r\n]/g, '');
+  if (typeof Buffer !== 'undefined') {
+    return new Uint8Array(Buffer.from(clean, 'base64'));
+  }
+  const binary = atob(clean);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+export function bytesToBase64Url(bytes) {
+  return bytesToBase64(bytes)
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '');
+}
+
+export function base64UrlToBytes(base64Url) {
+  let b64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
+  while (b64.length % 4 !== 0) {
+    b64 += '=';
+  }
+  return base64ToBytes(b64);
+}
+
+export function stringToBytes(str) {
+  return new TextEncoder().encode(str);
+}
+
+export function bytesToString(bytes) {
+  const arr = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  return new TextDecoder().decode(arr);
+}
+
+export function toUint8Array(input) {
+  if (input instanceof Uint8Array) return input;
+  if (input instanceof ArrayBuffer) return new Uint8Array(input);
+  if (ArrayBuffer.isView(input)) return new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
+  if (typeof input === 'string') return stringToBytes(input);
+  throw new TypeError('Input must be a Uint8Array, ArrayBuffer, or string');
+}
+
+/**
+ * Prepend a length-prefixed context header to the payload in classical fallback path
+ * so domain separation behaves consistently across both suites.
+ */
+export function frameFallbackInput(payloadBytes, contextBytes) {
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+  const framed = new Uint8Array(1 + contextBytes.byteLength + payloadBytes.byteLength);
+  framed[0] = contextBytes.byteLength;
+  framed.set(contextBytes, 1);
+  framed.set(payloadBytes, 1 + contextBytes.byteLength);
+  return framed;
+}
+
+/* ============================================================================
+   Key Pair Generation, Export & Import
+   ============================================================================ */
+
+/**
+ * Generate a new signing key pair using either post-quantum ML-DSA or classical fallback.
+ * 
+ * @param {string} [suite] 'ML-DSA-65', 'ML-DSA-44', 'ML-DSA-87', 'Ed25519', or 'ECDSA-P256'
+ * @param {object} [options]
+ * @param {boolean} [options.extractable=true]
+ * @param {boolean} [options.autoFallback=true] Automatically fallback if requested suite is unsupported
+ * @returns {Promise<{ suite: string, keyPair: CryptoKeyPair, publicKeyBytes: Uint8Array, publicKeyHex: string, publicKeyBase64: string }>}
+ */
+export async function generateSigningKeyPair(suite, options = {}) {
+  const { extractable = true, autoFallback = true } = options;
+
+  let targetSuite = suite;
+  if (!targetSuite) {
+    targetSuite = supportsPostQuantumSignatures() ? 'ML-DSA-65' : 'Ed25519';
+  }
+
+  // Handle fallback if not supported
+  if (targetSuite.startsWith('ML-DSA') && !supportsAlgorithm('sign', targetSuite)) {
+    if (autoFallback) {
+      targetSuite = supportsAlgorithm('sign', 'Ed25519') ? 'Ed25519' : 'ECDSA-P256';
+    } else {
+      throw new Error(`Algorithm ${targetSuite} is not supported in this environment`);
+    }
+  }
