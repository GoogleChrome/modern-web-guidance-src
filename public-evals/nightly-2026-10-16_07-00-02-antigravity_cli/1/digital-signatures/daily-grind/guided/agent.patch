+export const SUITE_INFO = {
+  'ML-DSA-65': {
+    name: 'ML-DSA-65',
+    category: 'post-quantum',
+    standard: 'NIST FIPS 204 (ML-DSA)',
+    securityLevel: 'NIST Category 3 (~192-bit security)',
+    recommended: true,
+    publicKeyBytes: 1952,
+    signatureBytes: 3309,
+    publicKeyFormat: 'raw-public',
+    privateKeyFormat: 'raw-seed',
+  },
+  'ML-DSA-44': {
+    name: 'ML-DSA-44',
+    category: 'post-quantum',
+    standard: 'NIST FIPS 204 (ML-DSA)',
+    securityLevel: 'NIST Category 2 (~128-bit security)',
+    recommended: false,
+    publicKeyBytes: 1312,
+    signatureBytes: 2420,
+    publicKeyFormat: 'raw-public',
+    privateKeyFormat: 'raw-seed',
+  },
+  'ML-DSA-87': {
+    name: 'ML-DSA-87',
+    category: 'post-quantum',
+    standard: 'NIST FIPS 204 (ML-DSA)',
