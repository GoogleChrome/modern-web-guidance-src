+ * Import a public verification key.
+ * Automatically identifies ML-DSA variant from raw byte length:
+ * 1312 -> ML-DSA-44, 1952 -> ML-DSA-65, 2592 -> ML-DSA-87, 32 -> Ed25519, 65 -> ECDSA P-256
+ * 
+ * @param {Uint8Array|ArrayBuffer|string} keyInput Raw bytes, hex string, or base64 string
+ * @param {string} [suiteHint] Optional suite hint
+ * @returns {Promise<CryptoKey>}
+ */
+export async function importPublicKey(keyInput, suiteHint = null) {
+  let bytes;
+  if (keyInput instanceof Uint8Array || keyInput instanceof ArrayBuffer) {
+    bytes = toUint8Array(keyInput);
+  } else if (typeof keyInput === 'string') {
+    const trimmed = keyInput.trim();
+    if (/^[0-9a-fA-F]+$/.test(trimmed) && trimmed.length % 2 === 0) {
+      bytes = hexToBytes(trimmed);
+    } else {
+      bytes = base64ToBytes(trimmed);
+    }
+  } else {
+    throw new TypeError('keyInput must be Uint8Array, ArrayBuffer, hex string, or base64 string');
+  }
+
+  let suite = suiteHint;
+  if (!suite) {
+    const mlDsaAlgo = ML_DSA_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+    if (mlDsaAlgo) {
+      suite = mlDsaAlgo;
+    } else if (bytes.byteLength === 32) {
+      suite = 'Ed25519';
+    } else if (bytes.byteLength === 65) {
+      suite = 'ECDSA-P256';
+    } else {
+      throw new Error(`Unable to infer signature algorithm for public key of length ${bytes.byteLength} bytes`);
+    }
+  }
+
+  if (suite.startsWith('ML-DSA')) {
+    // Usage MUST be ['verify'] only per WebCrypto spec
+    return globalThis.crypto.subtle.importKey(
+      'raw-public',
+      bytes,
+      suite,
+      true,
+      ['verify']
+    );
+  } else if (suite === 'Ed25519') {
+    return globalThis.crypto.subtle.importKey(
+      'raw',
+      bytes,
+      'Ed25519',
+      true,
+      ['verify']
+    );
+  } else if (suite === 'ECDSA-P256' || suite === 'ECDSA') {
+    return globalThis.crypto.subtle.importKey(
+      'raw',
+      bytes,
+      { name: 'ECDSA', namedCurve: 'P-256' },
+      true,
+      ['verify']
+    );
+  } else {
+    throw new Error(`Unsupported suite for importPublicKey: ${suite}`);
+  }
+}
+
+/**
+ * Export a private signing key.
+ * For ML-DSA: uses 'raw-seed' (32 bytes), 'pkcs8', or 'jwk'.
+ */
+export async function exportPrivateKey(privateKey, format = 'pkcs8') {
+  if (!(privateKey instanceof CryptoKey)) {
+    throw new TypeError('Expected CryptoKey for privateKey');
+  }
+  const isMlDsa = privateKey.algorithm.name.startsWith('ML-DSA');
+  const actualFormat = (format === 'raw' && isMlDsa) ? 'raw-seed' : format;
+
+  const exported = await globalThis.crypto.subtle.exportKey(actualFormat, privateKey);
+  if (actualFormat === 'jwk') {
+    return exported;
+  }
+  const bytes = new Uint8Array(exported);
+  return {
+    format: actualFormat,
+    algorithm: privateKey.algorithm.name,
+    bytes,
+    hex: bytesToHex(bytes),
+    base64: bytesToBase64(bytes),
+  };
+}
+
+/**
+ * Import a private signing key.
+ * Usage MUST be ['sign'] only per WebCrypto spec.
+ */
+export async function importPrivateKey(keyInput, suite, format = 'pkcs8') {
+  const actualFormat = (format === 'raw' && suite.startsWith('ML-DSA')) ? 'raw-seed' : format;
+  let data = keyInput;
+  if (typeof keyInput === 'string' && actualFormat !== 'jwk') {
+    data = /^[0-9a-fA-F]+$/.test(keyInput) ? hexToBytes(keyInput) : base64ToBytes(keyInput);
+  }
+
+  const algoParam = suite === 'ECDSA-P256' ? { name: 'ECDSA', namedCurve: 'P-256' } : suite;
+  return globalThis.crypto.subtle.importKey(
+    actualFormat,
+    data,
+    algoParam,
+    true,
+    ['sign']
+  );
+}
+
+/**
+ * Retrieve public CryptoKey from a private signing key using crypto.subtle.getPublicKey
+ * if supported, or fall back to extracting and re-importing.
+ */
+export async function getPublicKeyFromPrivateKey(privateKey) {
+  if (typeof globalThis.crypto.subtle.getPublicKey === 'function') {
+    try {
+      return await globalThis.crypto.subtle.getPublicKey(privateKey, ['verify']);
+    } catch {
+      // Fall through to standard extraction
+    }
+  }
+  throw new Error('Direct public key derivation without keyPair requires crypto.subtle.getPublicKey()');
+}
+
+/* ============================================================================
+   Core Payload Signing & Verification (with Domain Separation Context)
+   ============================================================================ */
+
+/**
+ * Sign payload bytes with optional domain separation context.
+ * 
+ * @param {CryptoKey} privateKey
+ * @param {Uint8Array|ArrayBuffer|string} payload
+ * @param {Uint8Array|ArrayBuffer|string} [context=new Uint8Array(0)] 0 to 255 bytes
+ * @returns {Promise<{ signatureBytes: Uint8Array, signatureHex: string, signatureBase64: string, algorithm: string }>}
+ */
+export async function signPayload(privateKey, payload, context = new Uint8Array(0)) {
+  const payloadBytes = toUint8Array(payload);
+  const contextBytes = toUint8Array(context);
+
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+
+  const algoName = privateKey.algorithm.name;
+  let signatureBuffer;
+
+  if (algoName.startsWith('ML-DSA')) {
+    // Native ContextParams dictionary { name, context }
+    signatureBuffer = await globalThis.crypto.subtle.sign(
+      { name: algoName, context: contextBytes },
+      privateKey,
+      payloadBytes
+    );
+  } else if (algoName === 'Ed25519') {
+    // Classical fallback: length-prefixed context framing
+    const framed = frameFallbackInput(payloadBytes, contextBytes);
+    signatureBuffer = await globalThis.crypto.subtle.sign('Ed25519', privateKey, framed);
+  } else if (algoName === 'ECDSA') {
+    // Classical fallback ECDSA: length-prefixed context framing
+    const framed = frameFallbackInput(payloadBytes, contextBytes);
+    signatureBuffer = await globalThis.crypto.subtle.sign(
+      { name: 'ECDSA', hash: 'SHA-256' },
+      privateKey,
+      framed
+    );
+  } else {
+    throw new Error(`Unsupported private key algorithm: ${algoName}`);
+  }
+
+  const signatureBytes = new Uint8Array(signatureBuffer);
+  return {
+    algorithm: algoName,
+    signatureBytes,
+    signatureHex: bytesToHex(signatureBytes),
+    signatureBase64: bytesToBase64(signatureBytes),
+  };
+}
+
+/**
+ * Verify payload bytes with optional domain separation context.
+ * 
+ * @param {CryptoKey|Uint8Array|string} publicKeyOrBytes
+ * @param {Uint8Array|ArrayBuffer|string} signature
+ * @param {Uint8Array|ArrayBuffer|string} payload
+ * @param {Uint8Array|ArrayBuffer|string} [context=new Uint8Array(0)]
+ * @param {string} [suiteHint]
+ * @returns {Promise<boolean>}
+ */
+export async function verifyPayload(
+  publicKeyOrBytes,
+  signature,
+  payload,
+  context = new Uint8Array(0),
+  suiteHint = null
+) {
+  const payloadBytes = toUint8Array(payload);
+  const contextBytes = toUint8Array(context);
+
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+
+  let signatureBytes;
+  if (signature instanceof Uint8Array || signature instanceof ArrayBuffer) {
+    signatureBytes = toUint8Array(signature);
+  } else if (typeof signature === 'string') {
+    const trimmed = signature.trim();
+    if (/^[0-9a-fA-F]+$/.test(trimmed) && trimmed.length % 2 === 0) {
+      signatureBytes = hexToBytes(trimmed);
+    } else {
+      signatureBytes = base64ToBytes(trimmed);
+    }
+  } else {
+    throw new TypeError('Invalid signature format');
+  }
+
+  const publicKey = (publicKeyOrBytes instanceof CryptoKey)
+    ? publicKeyOrBytes
+    : await importPublicKey(publicKeyOrBytes, suiteHint);
+
+  const algoName = publicKey.algorithm.name;
+
+  if (algoName.startsWith('ML-DSA')) {
+    return globalThis.crypto.subtle.verify(
+      { name: algoName, context: contextBytes },
+      publicKey,
+      signatureBytes,
+      payloadBytes
+    );
+  } else if (algoName === 'Ed25519') {
+    const framed = frameFallbackInput(payloadBytes, contextBytes);
+    return globalThis.crypto.subtle.verify('Ed25519', publicKey, signatureBytes, framed);
+  } else if (algoName === 'ECDSA') {
+    const framed = frameFallbackInput(payloadBytes, contextBytes);
+    return globalThis.crypto.subtle.verify(
+      { name: 'ECDSA', hash: 'SHA-256' },
+      publicKey,
+      signatureBytes,
+      framed
+    );
+  } else {
+    throw new Error(`Unsupported public key algorithm: ${algoName}`);
+  }
+}
+
+/* ============================================================================
+   1. MESSAGES: High-Level Signing & Verification
+   ============================================================================ */
+
+/**
+ * Sign an arbitrary text message with optional domain context and metadata.
+ */
+export async function signMessage(privateKey, message, options = {}) {
+  const { context = '', signerInfo = {} } = options;
+  const messageBytes = stringToBytes(message);
+  const contextBytes = stringToBytes(context);
+
+  const { signatureBase64, algorithm } = await signPayload(
+    privateKey,
+    messageBytes,
+    contextBytes
+  );
+
+  return {
+    version: '1.0',
+    type: 'signed-message',
+    algorithm,
+    message,
+    context,
+    signature: signatureBase64,
+    timestamp: Date.now(),
+    signerInfo,
+  };
+}
+
+/**
+ * Verify a signed message package.
+ */
+export async function verifyMessage(publicKeyOrBytes, messagePackage, options = {}) {
+  try {
+    const {
+      message,
+      context = '',
+      signature,
+      algorithm,
+    } = messagePackage;
+
+    if (!message || !signature) {
+      return { valid: false, error: 'Malformed message package: missing message or signature' };
+    }
+
+    const expectedContext = options.expectedContext !== undefined ? options.expectedContext : context;
+    if (options.expectedContext !== undefined && context !== options.expectedContext) {
+      return { valid: false, error: 'Domain separation context mismatch' };
+    }
+
+    const isValid = await verifyPayload(
+      publicKeyOrBytes,
+      signature,
+      stringToBytes(message),
+      stringToBytes(expectedContext),
+      algorithm
+    );
+
+    return {
+      valid: isValid,
+      message,
+      context: expectedContext,
+      algorithm,
+      error: isValid ? null : 'Digital signature verification failed (tampered content, context, or wrong key)',
+    };
+  } catch (err) {
+    return { valid: false, error: err.message };
+  }
+}
+
+/* ============================================================================
+   2. TOKENS: Post-Quantum & Classical Tamper-Proof Compact Tokens
+   Format: headerBase64Url.payloadBase64Url.signatureBase64Url
+   ============================================================================ */
+
+const DEFAULT_TOKEN_CONTEXT = 'urn:dailygrind:auth-token:v1';
+
+/**
+ * Create a signed structured token (e.g., Coffee Pass, Barista Token, Voucher).
+ */
+export async function createSignedToken(privateKey, claims, options = {}) {
+  const {
+    expiresInSeconds = 3600,
+    context = DEFAULT_TOKEN_CONTEXT,
+    issuer = 'The Daily Grind Coffee Co.',
+    subject = 'customer-rewards-pass',
+  } = options;
+
+  const nowSec = Math.floor(Date.now() / 1000);
+  const algoName = privateKey.algorithm.name;
+
+  const header = {
+    alg: algoName,
+    typ: 'PQC-JWT',
+    ctx: context,
+  };
+
+  const payload = {
+    iss: issuer,
+    sub: subject,
+    iat: nowSec,
+    exp: expiresInSeconds ? (nowSec + expiresInSeconds) : undefined,
+    jti: 'tok_' + Math.random().toString(36).substring(2, 10),
+    ...claims,
+  };
+
+  const headerB64 = bytesToBase64Url(stringToBytes(JSON.stringify(header)));
+  const payloadB64 = bytesToBase64Url(stringToBytes(JSON.stringify(payload)));
+  const signingInput = `${headerB64}.${payloadB64}`;
+
+  const { signatureBytes } = await signPayload(
+    privateKey,
+    stringToBytes(signingInput),
+    stringToBytes(context)
+  );
+
+  const sigB64 = bytesToBase64Url(signatureBytes);
+  const tokenString = `${headerB64}.${payloadB64}.${sigB64}`;
+
+  return {
+    token: tokenString,
+    header,
+    payload,
+    algorithm: algoName,
+  };
+}
+
+/**
+ * Verify a signed token and validate expiration and claims.
+ */
+export async function verifySignedToken(publicKeyOrBytes, tokenString, options = {}) {
+  try {
+    const parts = tokenString.trim().split('.');
+    if (parts.length !== 3) {
+      return { valid: false, error: 'Invalid token structure: expected 3 dot-separated segments' };
+    }
+
+    const [headerB64, payloadB64, sigB64] = parts;
+    const headerJson = bytesToString(base64UrlToBytes(headerB64));
+    const payloadJson = bytesToString(base64UrlToBytes(payloadB64));
+    const signatureBytes = base64UrlToBytes(sigB64);
+
+    const header = JSON.parse(headerJson);
+    const payload = JSON.parse(payloadJson);
+
+    const tokenContext = header.ctx || DEFAULT_TOKEN_CONTEXT;
+    const requiredContext = options.expectedContext || tokenContext;
+
+    if (options.expectedContext && tokenContext !== options.expectedContext) {
+      return { valid: false, error: 'Token domain context mismatch', header, payload };
+    }
+
+    const signingInput = `${headerB64}.${payloadB64}`;
+    const isSigValid = await verifyPayload(
+      publicKeyOrBytes,
+      signatureBytes,
+      stringToBytes(signingInput),
+      stringToBytes(requiredContext),
+      header.alg
+    );
+
+    if (!isSigValid) {
+      return { valid: false, error: 'Cryptographic signature is invalid or payload has been tampered with', header, payload };
+    }
+
+    // Check expiration
+    const nowSec = Math.floor(Date.now() / 1000);
+    const clockTolerance = options.clockToleranceSeconds !== undefined ? options.clockToleranceSeconds : 10;
+
+    if (payload.exp !== undefined && (nowSec - clockTolerance > payload.exp)) {
+      return { valid: false, expired: true, error: 'Token has expired', header, payload };
+    }
+
+    if (payload.nbf !== undefined && (nowSec + clockTolerance < payload.nbf)) {
+      return { valid: false, error: 'Token not yet valid', header, payload };
+    }
+
+    if (options.expectedIssuer && payload.iss !== options.expectedIssuer) {
+      return { valid: false, error: `Issuer mismatch: expected ${options.expectedIssuer}`, header, payload };
+    }
+
+    return {
+      valid: true,
+      header,
+      payload,
+      algorithm: header.alg,
+    };
+  } catch (err) {
+    return { valid: false, error: `Token verification error: ${err.message}` };
+  }
+}
+
+/* ============================================================================
+   3. ARTIFACTS: Signing & Verification of Files, Images, Releases, and Binaries
+   ============================================================================ */
+
+const DEFAULT_ARTIFACT_CONTEXT = 'urn:dailygrind:artifact:manifest:v1';
+
+/**
+ * Calculate SHA-256 digest of arbitrary bytes or ArrayBuffer.
+ */
+export async function hashArtifact(artifactBytes) {
+  const bytes = toUint8Array(artifactBytes);
+  const digestBuffer = await globalThis.crypto.subtle.digest('SHA-256', bytes);
+  const digestBytes = new Uint8Array(digestBuffer);
+  return {
+    bytes: digestBytes,
+    hex: bytesToHex(digestBytes),
+    base64: bytesToBase64(digestBytes),
+  };
+}
+
+/**
+ * Sign an artifact (file, PDF, image, roast report, etc.).
+ * Produces a verifiable manifest containing SHA-256 digest and digital signature.
+ */
+export async function signArtifact(privateKey, artifactData, options = {}) {
+  const {
+    artifactName = 'unnamed-artifact',
+    mimeType = 'application/octet-stream',
+    context = DEFAULT_ARTIFACT_CONTEXT,
+    customMetadata = {},
+  } = options;
+
+  const artifactBytes = toUint8Array(artifactData);
+  const hash = await hashArtifact(artifactBytes);
+
+  const manifest = {
+    artifactName,
+    mimeType,
+    sizeBytes: artifactBytes.byteLength,
+    sha256: hash.hex,
+    timestamp: Date.now(),
+    createdAt: new Date().toISOString(),
+    metadata: customMetadata,
+  };
+
+  // Sign the canonical JSON representation of the manifest
+  const canonicalManifest = JSON.stringify(manifest);
+  const { signatureBase64, signatureHex, algorithm } = await signPayload(
+    privateKey,
+    stringToBytes(canonicalManifest),
+    stringToBytes(context)
+  );
+
+  return {
+    version: '1.0',
+    type: 'artifact-signature-envelope',
+    algorithm,
+    context,
+    manifest,
+    signature: signatureBase64,
+    signatureHex,
+  };
+}
+
+/**
+ * Verify artifact authenticity and data integrity.
+ * Checks:
+ * 1. SHA-256 of the artifact bytes matches the signed manifest hash (data integrity).
+ * 2. Asymmetric digital signature over manifest is valid (authenticity & non-repudiation).
+ */
+export async function verifyArtifact(publicKeyOrBytes, artifactData, envelope, options = {}) {
+  try {
+    const { manifest, signature, algorithm, context = DEFAULT_ARTIFACT_CONTEXT } = envelope;
+
+    if (!manifest || !signature) {
+      return { valid: false, error: 'Malformed artifact signature envelope' };
+    }
+
+    const artifactBytes = toUint8Array(artifactData);
+    const actualHash = await hashArtifact(artifactBytes);
+
+    // 1. Check artifact data integrity against manifest
+    const integrityValid = (actualHash.hex.toLowerCase() === manifest.sha256.toLowerCase());
+    if (!integrityValid) {
+      return {
+        valid: false,
+        integrityValid: false,
+        signatureValid: false,
+        error: `Integrity check failed: artifact hash ${actualHash.hex.slice(0, 16)}... does not match manifest hash ${manifest.sha256.slice(0, 16)}...`,
+        manifest,
+        actualHash: actualHash.hex,
+      };
+    }
+
+    // 2. Check digital signature over manifest
+    const canonicalManifest = JSON.stringify(manifest);
+    const signatureValid = await verifyPayload(
+      publicKeyOrBytes,
+      signature,
+      stringToBytes(canonicalManifest),
+      stringToBytes(context),
+      algorithm
+    );
+
+    return {
+      valid: signatureValid,
+      integrityValid: true,
+      signatureValid,
+      manifest,
+      actualHash: actualHash.hex,
+      algorithm,
+      error: signatureValid ? null : 'Asymmetric digital signature invalid (signature does not match key or manifest)',
+    };
+  } catch (err) {
+    return { valid: false, integrityValid: false, signatureValid: false, error: err.message };
+  }
+}
