+/**
+ * crypto-signatures.js
+ * 
+ * Asymmetric digital signature and verification library for WebCrypto supporting:
+ * - Quantum-Resistant / Post-Quantum (PQC): ML-DSA (ML-DSA-65, ML-DSA-44, ML-DSA-87 - NIST FIPS 204)
+ * - Classical: Ed25519 and ECDSA (P-256 with SHA-256)
