+ * Complies with modern Web Cryptography specifications, including:
+ * - SubtleCrypto.supports() static capability detection
+ * - Domain separation via ContextParams ({ name, context })
+ * - Fallback context framing for classical algorithms
+ * - Standard key formats ('raw-public', 'raw-seed', 'pkcs8', 'spki', 'jwk')
+ * - High-level signing & verification abstractions for:
+ *   1. Messages (plain text and structured notifications)
+ *   2. Tokens (compact post-quantum signed credentials & passes)
+ *   3. Artifacts (files, binaries, manifests, and integrity digests)
+ */
+
+export const ML_DSA_PUBLIC_KEY_ALGORITHMS = {
+  1312: 'ML-DSA-44',
+  1952: 'ML-DSA-65',
+  2592: 'ML-DSA-87',
+};
