+// Message Signing, Verification, and Tamper Analysis
+import { getAlgorithm } from '../crypto/algorithms.js';
+import { bytesToBase64, base64ToBytes, computeFingerprint } from '../crypto/utils.js';
+
+/**
+ * Signs arbitrary text or JSON message with private key
+ */
+export async function signMessage(messageText, keyObj) {
+  if (!keyObj || !keyObj.hasSecretKey || !keyObj.secretKeyBytes) {
+    throw new Error('Valid signing key with secret key material is required');
+  }
+
+  const alg = getAlgorithm(keyObj.algorithm);
+  const msgBytes = new TextEncoder().encode(messageText);
+
+  const t0 = performance.now();
+  const sigBytes = await alg.sign(msgBytes, keyObj.secretKeyBytes);
+  const durationMs = performance.now() - t0;
+
+  return {
+    version: '1.0',
+    type: 'signed-message-envelope',
+    message: messageText,
+    signature: bytesToBase64(sigBytes),
+    algorithm: keyObj.algorithm,
+    keyId: keyObj.id,
+    keyName: keyObj.name,
+    keyFingerprint: keyObj.fingerprint,
+    category: keyObj.category,
+    timestamp: new Date().toISOString(),
+    signatureBytesCount: sigBytes.length,
+    metrics: {
+      signTimeMs: Number(durationMs.toFixed(2)),
+    },
+  };
+}
+
+/**
+ * Verifies message against signature and public key
+ */
+export async function verifyMessage(messageText, signatureBase64, publicKeyBytes, algorithmId) {
+  if (!signatureBase64 || !publicKeyBytes || !algorithmId) {
+    throw new Error('Message, signature, public key and algorithm are all required for verification');
+  }
+
+  const alg = getAlgorithm(algorithmId);
+  const msgBytes = new TextEncoder().encode(messageText);
+
+  let sigBytes;
+  try {
+    sigBytes = base64ToBytes(signatureBase64);
+  } catch (err) {
+    return {
+      valid: false,
+      algorithm: algorithmId,
+      status: 'INVALID_SIGNATURE_FORMAT',
+      reason: 'Signature is not valid Base64 encoding.',
+      durationMs: 0,
+    };
+  }
+
+  const t0 = performance.now();
+  let isValid = false;
+  try {
+    isValid = await alg.verify(sigBytes, msgBytes, publicKeyBytes);
+  } catch (err) {
+    isValid = false;
+  }
+  const durationMs = performance.now() - t0;
+  const keyFingerprint = await computeFingerprint(publicKeyBytes);
+
+  return {
+    valid: isValid,
+    algorithm: algorithmId,
+    category: alg.type,
+    keyFingerprint,
+    signatureBytesCount: sigBytes.length,
+    durationMs: Number(durationMs.toFixed(2)),
+    status: isValid ? 'VALID' : 'INVALID',
+    reason: isValid
+      ? 'Cryptographic integrity and authenticity successfully confirmed. The message has not been altered since signing.'
+      : 'Signature verification failed! The message has been tampered with, or the signature does not match the public key.',
+  };
+}
+
+/**
+ * Tamper helper: mutates message content to test tamper resistance
+ */
+export function tamperMessageContent(text) {
+  if (!text || text.length === 0) return 'Tampered Message Content!';
+  try {
+    // If it's valid JSON, alter an attribute or add tamper note
+    const obj = JSON.parse(text);
+    obj._tampered = true;
+    if (obj.amount) obj.amount = (Number(obj.amount) || 0) * 10;
+    if (obj.price) obj.price = (Number(obj.price) || 0) + 100;
+    if (obj.role) obj.role = 'tampered_admin';
+    return JSON.stringify(obj, null, 2);
+  } catch (e) {
+    // Plain text: flip case of first character or append '[TAMPERED]'
+    if (text.endsWith(' [TAMPERED]')) {
+      return text.replace(' [TAMPERED]', ' [TAMPERED_V2]');
+    }
+    return text + ' [TAMPERED]';
+  }
+}
+
+/**
+ * Corrupt helper: flips bytes in base64 signature
+ */
+export function corruptSignature(sigBase64) {
+  if (!sigBase64 || sigBase64.length < 5) return 'CorruptedSignature==';
+  const chars = sigBase64.split('');
+  // Flip character at index 4
+  chars[4] = chars[4] === 'A' ? 'B' : 'A';
+  return chars.join('');
+}
