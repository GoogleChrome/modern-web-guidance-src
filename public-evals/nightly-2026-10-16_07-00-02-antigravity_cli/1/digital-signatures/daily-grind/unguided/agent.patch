+// Key Management, Serialization, Deserialization, and Fingerprinting
+import { getAlgorithm } from './algorithms.js';
+import {
+  bytesToBase64,
+  base64ToBytes,
+  bytesToHex,
+  hexToBytes,
+  bytesToPem,
+  pemToBytes,
+  computeFingerprint,
+  generateId,
+} from './utils.js';
+
+/**
+ * Creates a new managed keypair object for a given algorithm ID
+ */
+export async function createManagedKeyPair(algorithmId, name) {
+  const alg = getAlgorithm(algorithmId);
+  const rawPair = await alg.keygen();
+  const fingerprint = await computeFingerprint(rawPair.publicKey);
+  const id = generateId(`key_${algorithmId.toLowerCase().replace(/[^a-z0-9]/g, '')}`);
+
+  return {
+    id,
+    name: name || `${alg.name} Key`,
+    algorithm: algorithmId,
+    category: alg.type,
+    createdAt: new Date().toISOString(),
+    fingerprint,
+    publicKeyBytes: rawPair.publicKey,
+    secretKeyBytes: rawPair.secretKey,
+    hasSecretKey: true,
+  };
+}
+
+/**
+ * Exports a key's public key in various formats
+ */
+export function exportPublicKey(keyObj, format = 'base64') {
+  const bytes = keyObj.publicKeyBytes;
+  switch (format) {
+    case 'base64':
+      return bytesToBase64(bytes);
+    case 'hex':
+      return bytesToHex(bytes);
+    case 'pem':
+      return bytesToPem(bytes, `${keyObj.algorithm} PUBLIC KEY`);
+    case 'bundle':
+      return JSON.stringify(
+        {
+          version: '1.0',
+          type: 'public-key-bundle',
+          id: keyObj.id,
+          name: keyObj.name,
+          algorithm: keyObj.algorithm,
+          category: keyObj.category,
+          fingerprint: keyObj.fingerprint,
+          publicKey: bytesToBase64(bytes),
+          createdAt: keyObj.createdAt,
+        },
+        null,
+        2
+      );
+    default:
+      throw new Error(`Unsupported export format: ${format}`);
+  }
+}
+
+/**
+ * Exports a key's private/secret key in various formats
+ */
+export function exportSecretKey(keyObj, format = 'base64') {
+  if (!keyObj.hasSecretKey || !keyObj.secretKeyBytes) {
+    throw new Error('Key does not contain private/secret key material');
+  }
+  const bytes = keyObj.secretKeyBytes;
+  switch (format) {
+    case 'base64':
+      return bytesToBase64(bytes);
+    case 'hex':
+      return bytesToHex(bytes);
+    case 'pem':
+      return bytesToPem(bytes, `${keyObj.algorithm} PRIVATE KEY`);
+    default:
+      throw new Error(`Unsupported export format: ${format}`);
+  }
+}
+
+/**
+ * Imports a public key from various text formats (auto-detected or explicit)
+ */
+export async function importPublicKey(rawText, algorithmId, name) {
+  const text = rawText.trim();
+  let bytes = null;
+  let detectedAlg = algorithmId;
+  let detectedName = name;
+
+  // Check if it's a JSON verification bundle
+  if (text.startsWith('{') && text.endsWith('}')) {
+    try {
+      const parsed = JSON.parse(text);
+      if (parsed.publicKey) {
+        bytes = base64ToBytes(parsed.publicKey);
+        detectedAlg = parsed.algorithm || detectedAlg;
+        detectedName = detectedName || parsed.name || `${detectedAlg} Imported Key`;
+      }
+    } catch (e) {
+      // not a json bundle, continue
+    }
+  }
+
+  // Check if PEM
+  if (!bytes && text.includes('-----BEGIN')) {
+    bytes = pemToBytes(text);
+  }
+
+  // Check if Hex
+  if (!bytes && /^[0-9a-fA-F]+$/.test(text) && text.length % 2 === 0) {
+    bytes = hexToBytes(text);
+  }
+
+  // Fallback to Base64
+  if (!bytes) {
+    try {
+      bytes = base64ToBytes(text);
+    } catch (err) {
+      throw new Error('Could not parse public key data. Provide valid Base64, Hex, PEM, or JSON bundle.');
+    }
+  }
+
+  if (!detectedAlg) {
+    throw new Error('Algorithm must be specified when importing raw public key data.');
+  }
+
+  const alg = getAlgorithm(detectedAlg);
+  const fingerprint = await computeFingerprint(bytes);
+  const id = generateId(`imp_${detectedAlg.toLowerCase().replace(/[^a-z0-9]/g, '')}`);
+
+  return {
+    id,
+    name: detectedName || `${alg.name} (Public Only)`,
+    algorithm: detectedAlg,
+    category: alg.type,
+    createdAt: new Date().toISOString(),
+    fingerprint,
+    publicKeyBytes: bytes,
+    secretKeyBytes: null,
+    hasSecretKey: false,
+  };
+}
+
+/**
+ * Serialize managed key to persistent storage format (JSON-safe)
+ */
+export function serializeManagedKey(keyObj) {
+  return {
+    id: keyObj.id,
+    name: keyObj.name,
+    algorithm: keyObj.algorithm,
+    category: keyObj.category,
+    createdAt: keyObj.createdAt,
+    fingerprint: keyObj.fingerprint,
+    publicKeyBase64: bytesToBase64(keyObj.publicKeyBytes),
+    secretKeyBase64: keyObj.secretKeyBytes ? bytesToBase64(keyObj.secretKeyBytes) : null,
+    hasSecretKey: keyObj.hasSecretKey,
+  };
+}
+
+/**
+ * Deserialize managed key from persistent storage format
+ */
+export function deserializeManagedKey(stored) {
+  return {
+    id: stored.id,
+    name: stored.name,
+    algorithm: stored.algorithm,
+    category: stored.category,
+    createdAt: stored.createdAt,
+    fingerprint: stored.fingerprint,
+    publicKeyBytes: base64ToBytes(stored.publicKeyBase64),
+    secretKeyBytes: stored.secretKeyBase64 ? base64ToBytes(stored.secretKeyBase64) : null,
+    hasSecretKey: stored.hasSecretKey,
+  };
+}
