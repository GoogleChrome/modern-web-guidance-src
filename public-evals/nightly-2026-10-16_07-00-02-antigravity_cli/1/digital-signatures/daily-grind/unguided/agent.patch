@@ -0,0 +1,168 @@
+// Browser Key Vault for persistent local key storage
+import { createManagedKeyPair, serializeManagedKey, deserializeManagedKey } from './keys.js';
+
+const STORAGE_KEY = 'daily_grind_crypto_vault_v1';
+const ACTIVE_KEY_ID_STORAGE = 'daily_grind_crypto_active_key_v1';
+
+class KeyVault {
+  constructor() {
+    this.keys = new Map();
+    this.activeKeyId = null;
+    this.initialized = false;
+  }
+
+  async init() {
+    if (this.initialized) return;
+
+    // Load from localStorage if available
+    let loaded = false;
+    if (typeof localStorage !== 'undefined') {
+      try {
+        const storedJson = localStorage.getItem(STORAGE_KEY);
+        if (storedJson) {
+          const list = JSON.parse(storedJson);
+          for (const item of list) {
+            const keyObj = deserializeManagedKey(item);
+            this.keys.set(keyObj.id, keyObj);
+          }
+          loaded = this.keys.size > 0;
+          this.activeKeyId = localStorage.getItem(ACTIVE_KEY_ID_STORAGE) || null;
+        }
+      } catch (err) {
+        console.warn('Failed to load keys from localStorage:', err);
+      }
+    }
+
+    // If vault is empty, seed with initial sample keys
+    if (!loaded || this.keys.size === 0) {
+      await this.seedDefaultKeys();
+    }
+
+    // Ensure an active key is selected
+    if (!this.activeKeyId || !this.keys.has(this.activeKeyId)) {
+      const firstKey = this.keys.values().next().value;
+      if (firstKey) {
+        this.activeKeyId = firstKey.id;
+        this.saveActiveKeyId();
+      }
+    }
+
+    this.initialized = true;
+  }
+
+  async seedDefaultKeys() {
+    try {
+      // 1. Post-Quantum Primary Key (ML-DSA-65)
+      const pqKey = await createManagedKeyPair(
+        'ML-DSA-65',
+        'Daily Grind Master Authority (ML-DSA-65)'
+      );
+      this.keys.set(pqKey.id, pqKey);
+
+      // 2. Classical ECDSA P-256 Key
+      const ecdsaKey = await createManagedKeyPair(
+        'ECDSA-P256',
+        'Store POS Terminal #104 (ECDSA P-256)'
+      );
+      this.keys.set(ecdsaKey.id, ecdsaKey);
+
+      // 3. Compact High-Speed Classical (Ed25519)
+      const edKey = await createManagedKeyPair(
+        'Ed25519',
+        'Supply Chain Dispatcher (Ed25519)'
+      );
+      this.keys.set(edKey.id, edKey);
+
+      // 4. Hybrid Composite Key
+      const hybridKey = await createManagedKeyPair(
+        'Hybrid-P256-MLDSA65',
+        'Corporate Quantum-Safe Transition Gateway (Hybrid)'
+      );
+      this.keys.set(hybridKey.id, hybridKey);
+
+      this.activeKeyId = pqKey.id;
+      this.persist();
+      this.saveActiveKeyId();
+    } catch (err) {
+      console.warn('Error seeding default keys:', err);
+    }
+  }
+
+  persist() {
+    if (typeof localStorage === 'undefined') return;
+    try {
+      const list = Array.from(this.keys.values()).map(serializeManagedKey);
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
+    } catch (err) {
+      console.error('Failed to save keys to localStorage:', err);
+    }
+  }
+
+  saveActiveKeyId() {
+    if (typeof localStorage === 'undefined') return;
+    try {
+      if (this.activeKeyId) {
+        localStorage.setItem(ACTIVE_KEY_ID_STORAGE, this.activeKeyId);
+      } else {
+        localStorage.removeItem(ACTIVE_KEY_ID_STORAGE);
+      }
+    } catch (err) {
+      console.error('Failed to save active key ID to localStorage:', err);
+    }
+  }
+
+  getAllKeys() {
+    return Array.from(this.keys.values());
+  }
+
+  getKey(id) {
+    return this.keys.get(id) || null;
+  }
+
+  getActiveKey() {
+    if (!this.activeKeyId) return null;
+    return this.keys.get(this.activeKeyId) || null;
+  }
+
+  setActiveKey(id) {
+    if (this.keys.has(id)) {
+      this.activeKeyId = id;
+      this.saveActiveKeyId();
+      return true;
+    }
+    return false;
+  }
+
+  addKey(keyObj) {
+    this.keys.set(keyObj.id, keyObj);
+    if (!this.activeKeyId) {
+      this.activeKeyId = keyObj.id;
+      this.saveActiveKeyId();
+    }
+    this.persist();
+  }
+
+  removeKey(id) {
+    const deleted = this.keys.delete(id);
+    if (deleted) {
+      if (this.activeKeyId === id) {
+        const next = this.keys.values().next().value;
+        this.activeKeyId = next ? next.id : null;
+        this.saveActiveKeyId();
+      }
+      this.persist();
+    }
+    return deleted;
+  }
+
+  clear() {
+    this.keys.clear();
+    this.activeKeyId = null;
+    if (typeof localStorage !== 'undefined') {
+      localStorage.removeItem(STORAGE_KEY);
+      localStorage.removeItem(ACTIVE_KEY_ID_STORAGE);
+    }
+  }
+}
+
+export const vault = new KeyVault();
