@@ -0,0 +1,150 @@
+// Utility functions for encoding, decoding, hashing and formatting
+import { sha256 as nobleSha256, sha512 as nobleSha512 } from '@noble/hashes/sha2.js';
+
+/**
+ * Convert Uint8Array to standard Base64 string
+ */
+export function bytesToBase64(bytes) {
+  let binary = '';
+  const len = bytes.byteLength;
+  for (let i = 0; i < len; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary);
+}
+
+/**
+ * Convert standard Base64 string to Uint8Array
+ */
+export function base64ToBytes(base64) {
+  // Strip whitespace and padding if any
+  const cleaned = base64.trim().replace(/\s+/g, '');
+  const binary = atob(cleaned);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+/**
+ * Convert Uint8Array to URL-safe Base64 (base64url without padding)
+ */
+export function bytesToBase64Url(bytes) {
+  return bytesToBase64(bytes)
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '');
+}
+
+/**
+ * Convert URL-safe Base64 string to Uint8Array
+ */
+export function base64UrlToBytes(base64url) {
+  let base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
+  while (base64.length % 4) {
+    base64 += '=';
+  }
+  return base64ToBytes(base64);
+}
+
+/**
+ * Convert UTF-8 string to Base64URL
+ */
+export function stringToBase64Url(str) {
+  const bytes = new TextEncoder().encode(str);
+  return bytesToBase64Url(bytes);
+}
+
+/**
+ * Convert Base64URL string to UTF-8 string
+ */
+export function base64UrlToString(base64url) {
+  const bytes = base64UrlToBytes(base64url);
+  return new TextDecoder().decode(bytes);
+}
+
+/**
+ * Convert Uint8Array to Hex string
+ */
+export function bytesToHex(bytes) {
+  return Array.from(bytes)
+    .map(b => b.toString(16).padStart(2, '0'))
+    .join('');
+}
+
+/**
+ * Convert Hex string to Uint8Array
+ */
+export function hexToBytes(hex) {
+  const cleanHex = hex.trim().replace(/\s+/g, '');
+  if (cleanHex.length % 2 !== 0) {
+    throw new Error('Invalid hex string length');
+  }
+  const bytes = new Uint8Array(cleanHex.length / 2);
+  for (let i = 0; i < cleanHex.length; i += 2) {
+    bytes[i / 2] = parseInt(cleanHex.substr(i, 2), 16);
+  }
+  return bytes;
+}
+
+/**
+ * Format raw bytes as PEM string
+ */
+export function bytesToPem(bytes, label = 'PUBLIC KEY') {
+  const b64 = bytesToBase64(bytes);
+  const lines = b64.match(/.{1,64}/g) || [];
+  return `-----BEGIN ${label}-----\n${lines.join('\n')}\n-----END ${label}-----`;
+}
+
+/**
+ * Parse PEM string to Uint8Array
+ */
+export function pemToBytes(pem) {
+  const clean = pem
+    .replace(/-----BEGIN [^-]+-----/g, '')
+    .replace(/-----END [^-]+-----/g, '')
+    .replace(/\s+/g, '');
+  return base64ToBytes(clean);
+}
+
+/**
+ * Calculate SHA-256 hash of Uint8Array or ArrayBuffer
+ */
+export async function computeSha256(data) {
+  const bytes = data instanceof Uint8Array ? data : new Uint8Array(data);
+  if (typeof crypto !== 'undefined' && crypto.subtle) {
+    const digest = await crypto.subtle.digest('SHA-256', bytes);
+    return new Uint8Array(digest);
+  }
+  return nobleSha256(bytes);
+}
+
+/**
+ * Calculate SHA-512 hash of Uint8Array or ArrayBuffer
+ */
+export async function computeSha512(data) {
+  const bytes = data instanceof Uint8Array ? data : new Uint8Array(data);
+  if (typeof crypto !== 'undefined' && crypto.subtle) {
+    const digest = await crypto.subtle.digest('SHA-512', bytes);
+    return new Uint8Array(digest);
+  }
+  return nobleSha512(bytes);
+}
+
+/**
+ * Calculate SHA-256 hex fingerprint of bytes
+ */
+export async function computeFingerprint(bytes) {
+  const hash = await computeSha256(bytes);
+  return bytesToHex(hash);
+}
+
+/**
+ * Generate a unique ID with prefix
+ */
+export function generateId(prefix = 'id') {
+  const rand = Math.random().toString(36).substring(2, 8);
+  const time = Date.now().toString(36).slice(-4);
+  return `${prefix}_${rand}${time}`;
+}
