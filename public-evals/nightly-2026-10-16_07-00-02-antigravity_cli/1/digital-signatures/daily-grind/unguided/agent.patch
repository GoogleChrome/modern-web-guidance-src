+// Digital Artifact & File Integrity Signing and Verification
+import { getAlgorithm } from '../crypto/algorithms.js';
+import {
+  computeSha256,
+  computeSha512,
+  bytesToHex,
+  bytesToBase64,
+  base64ToBytes,
+  computeFingerprint,
+} from '../crypto/utils.js';
+
+/**
+ * Computes hashes for an ArrayBuffer or Uint8Array
+ */
+export async function hashArtifactData(data) {
+  const bytes = data instanceof Uint8Array ? data : new Uint8Array(data);
+  const sha256Bytes = await computeSha256(bytes);
+  const sha512Bytes = await computeSha512(bytes);
+
+  return {
+    bytesCount: bytes.byteLength,
+    sha256Hex: bytesToHex(sha256Bytes),
+    sha512Hex: bytesToHex(sha512Bytes),
+    sha256Bytes,
+    sha512Bytes,
+  };
+}
+
+/**
+ * Deterministic canonical string representation of an artifact for signing
+ */
+function createArtifactCanonicalPayload(artifactName, artifactSize, sha256Hex, metadata = {}) {
+  return JSON.stringify({
+    schema: 'daily-grind-artifact-v1',
+    name: artifactName,
+    size: artifactSize,
+    sha256: sha256Hex,
+    metadata: metadata || {},
+  });
+}
+
+/**
+ * Signs an artifact and generates an Attestation Manifest Bundle
+ */
+export async function signArtifact(fileData, artifactName, keyObj, attestationMeta = {}) {
+  if (!keyObj || !keyObj.hasSecretKey || !keyObj.secretKeyBytes) {
+    throw new Error('Valid signing key with secret key material is required');
+  }
+
+  const { bytesCount, sha256Hex, sha512Hex } = await hashArtifactData(fileData);
+
+  const metadata = {
+    issuer: attestationMeta.issuer || 'Daily Grind Certified Roastery',
+    description: attestationMeta.description || 'Authentic batch artifact',
+    timestamp: attestationMeta.timestamp || new Date().toISOString(),
+    tags: attestationMeta.tags || ['artisanal', 'pqc-secured'],
+  };
+
+  const canonicalString = createArtifactCanonicalPayload(artifactName, bytesCount, sha256Hex, metadata);
+  const canonicalBytes = new TextEncoder().encode(canonicalString);
+
+  const alg = getAlgorithm(keyObj.algorithm);
+  const t0 = performance.now();
+  const sigBytes = await alg.sign(canonicalBytes, keyObj.secretKeyBytes);
+  const durationMs = performance.now() - t0;
+
+  const manifest = {
+    version: '1.0',
+    type: 'artifact-attestation-manifest',
+    artifactName,
+    artifactSize: bytesCount,
+    hashes: {
+      sha256: sha256Hex,
+      sha512: sha512Hex,
+    },
+    metadata,
+    canonicalPayload: canonicalString,
+    signatureInfo: {
+      algorithm: keyObj.algorithm,
+      keyId: keyObj.id,
+      keyName: keyObj.name,
+      signerFingerprint: keyObj.fingerprint,
+      category: keyObj.category,
+      signature: bytesToBase64(sigBytes),
+      signatureBytesCount: sigBytes.length,
+      timestamp: metadata.timestamp,
+    },
+    metrics: {
+      signTimeMs: Number(durationMs.toFixed(2)),
+    },
+  };
+
+  return manifest;
+}
+
+/**
+ * Verifies an artifact file data against a manifest and public key
+ */
+export async function verifyArtifact(fileData, manifest, publicKeyBytes) {
+  if (!manifest || !manifest.signatureInfo) {
+    throw new Error('Invalid or missing artifact manifest');
+  }
+
+  const sigInfo = manifest.signatureInfo;
+  const alg = getAlgorithm(sigInfo.algorithm);
+
+  // 1. Check file content hash
+  const { bytesCount, sha256Hex, sha512Hex } = await hashArtifactData(fileData);
+  const hashMatches = sha256Hex === manifest.hashes.sha256;
+  const sizeMatches = bytesCount === manifest.artifactSize;
+
+  // 2. Check cryptographic signature over canonical payload
+  let sigBytes;
+  try {
+    sigBytes = base64ToBytes(sigInfo.signature);
+  } catch (e) {
+    return {
+      valid: false,
+      hashMatches,
+      sigMatches: false,
+      status: 'INVALID_SIGNATURE_FORMAT',
+      reason: 'Signature is not valid Base64',
+    };
+  }
+
+  const canonicalBytes = new TextEncoder().encode(manifest.canonicalPayload);
+  const t0 = performance.now();
+  let sigMatches = false;
+  try {
+    sigMatches = await alg.verify(sigBytes, canonicalBytes, publicKeyBytes);
+  } catch (err) {
+    sigMatches = false;
+  }
+  const durationMs = performance.now() - t0;
+
+  const keyFingerprint = await computeFingerprint(publicKeyBytes);
+  const isOverallValid = hashMatches && sizeMatches && sigMatches;
+
+  let status = 'VALID';
+  let reason = '';
+
+  if (!hashMatches) {
+    status = 'HASH_MISMATCH';
+    reason = `Data integrity violation! Calculated SHA-256 (${sha256Hex.substring(0, 16)}...) does NOT match manifest hash (${manifest.hashes.sha256.substring(0, 16)}...). File has been modified!`;
+  } else if (!sigMatches) {
+    status = 'SIGNATURE_INVALID';
+    reason = `Cryptographic signature validation failed! The manifest was altered or signed by an untrusted key.`;
+  } else {
+    reason = `Artifact is authentic and intact! Verified via ${sigInfo.algorithm} (${alg.type}). SHA-256 hash and asymmetric signature confirmed.`;
+  }
+
+  return {
+    valid: isOverallValid,
+    status,
+    reason,
+    hashMatches,
+    sizeMatches,
+    sigMatches,
+    calculatedHash: sha256Hex,
+    manifestHash: manifest.hashes.sha256,
+    artifactName: manifest.artifactName,
+    algorithm: sigInfo.algorithm,
+    category: alg.type,
+    keyFingerprint,
+    metadata: manifest.metadata,
+    durationMs: Number(durationMs.toFixed(2)),
+  };
+}
+
+/**
+ * Built-in Sample Artifacts for 1-click verification testing
+ */
+export const SAMPLE_ARTIFACTS = [
+  {
+    name: 'ethiopia-yirgacheffe-batch-2026.json',
+    mimeType: 'application/json',
+    description: 'Single-Origin Ethiopian Yirgacheffe harvest specification, Fair Trade cupping score 92.5.',
+    content: JSON.stringify(
