+// Automated Cryptographic Verification Test Suite
+// Executes verification test vectors across Classical, Post-Quantum, and Hybrid algorithms
+import { ALGORITHM_REGISTRY } from './algorithms.js';
+import { createManagedKeyPair } from './keys.js';
+import { signMessage, verifyMessage, tamperMessageContent, corruptSignature } from '../features/messages.js';
+import { createSignedToken, verifyToken, tamperTokenPayload } from '../features/tokens.js';
+import { signArtifact, verifyArtifact } from '../features/artifacts.js';
+
+export async function runCryptoTestSuite(onProgress = () => {}) {
+  const results = [];
+
+  function record(name, category, passed, details = '', durationMs = 0) {
+    const entry = { name, category, passed, details, durationMs: Number(durationMs.toFixed(2)) };
+    results.push(entry);
+    onProgress(entry, results);
+    return entry;
+  }
+
+  // 1. Classical Algorithm Verification (ECDSA P-256)
+  try {
+    const t0 = performance.now();
+    const key = await createManagedKeyPair('ECDSA-P256', 'Test ECDSA');
+    const msg = 'Authentic Coffee Order #1001';
+    const signed = await signMessage(msg, key);
+    const verifyRes = await verifyMessage(msg, signed.signature, key.publicKeyBytes, 'ECDSA-P256');
+    const d = performance.now() - t0;
+    record('Classical ECDSA (P-256) Sign & Verify', 'Classical', verifyRes.valid, `Sig size: ${signed.signatureBytesCount}B, time: ${d.toFixed(1)}ms`, d);
+  } catch (err) {
+    record('Classical ECDSA (P-256) Sign & Verify', 'Classical', false, err.message);
+  }
+
+  // 2. Classical Ed25519 Verification
+  try {
+    const t0 = performance.now();
+    const key = await createManagedKeyPair('Ed25519', 'Test Ed25519');
+    const msg = 'Supply Chain Shipment Dispatched';
+    const signed = await signMessage(msg, key);
+    const verifyRes = await verifyMessage(msg, signed.signature, key.publicKeyBytes, 'Ed25519');
+    const d = performance.now() - t0;
+    record('Classical Ed25519 (EdDSA) Sign & Verify', 'Classical', verifyRes.valid, `Sig size: ${signed.signatureBytesCount}B, time: ${d.toFixed(1)}ms`, d);
+  } catch (err) {
+    record('Classical Ed25519 (EdDSA) Sign & Verify', 'Classical', false, err.message);
+  }
+
+  // 3. Post-Quantum ML-DSA-65 (NIST FIPS 204)
+  try {
+    const t0 = performance.now();
+    const key = await createManagedKeyPair('ML-DSA-65', 'Test ML-DSA-65');
+    const msg = 'Post-Quantum Master Authorization Token';
+    const signed = await signMessage(msg, key);
+    const verifyRes = await verifyMessage(msg, signed.signature, key.publicKeyBytes, 'ML-DSA-65');
+    const d = performance.now() - t0;
+    record('Post-Quantum ML-DSA-65 (FIPS 204) Sign & Verify', 'Post-Quantum', verifyRes.valid, `Sig size: ${signed.signatureBytesCount}B, pubkey: ${key.publicKeyBytes.length}B`, d);
+  } catch (err) {
+    record('Post-Quantum ML-DSA-65 (FIPS 204) Sign & Verify', 'Post-Quantum', false, err.message);
+  }
+
+  // 4. Post-Quantum ML-DSA-44 (NIST FIPS 204 Level 2)
+  try {
+    const t0 = performance.now();
+    const key = await createManagedKeyPair('ML-DSA-44', 'Test ML-DSA-44');
+    const msg = 'Compact PQC Signature Test';
+    const signed = await signMessage(msg, key);
+    const verifyRes = await verifyMessage(msg, signed.signature, key.publicKeyBytes, 'ML-DSA-44');
+    const d = performance.now() - t0;
+    record('Post-Quantum ML-DSA-44 (FIPS 204) Sign & Verify', 'Post-Quantum', verifyRes.valid, `Sig size: ${signed.signatureBytesCount}B, pubkey: ${key.publicKeyBytes.length}B`, d);
+  } catch (err) {
+    record('Post-Quantum ML-DSA-44 (FIPS 204) Sign & Verify', 'Post-Quantum', false, err.message);
+  }
+
+  // 5. Post-Quantum Falcon-512
+  try {
+    const t0 = performance.now();
+    const key = await createManagedKeyPair('Falcon-512', 'Test Falcon-512');
+    const msg = 'Falcon Lattice Signature Test';
+    const signed = await signMessage(msg, key);
+    const verifyRes = await verifyMessage(msg, signed.signature, key.publicKeyBytes, 'Falcon-512');
+    const d = performance.now() - t0;
+    record('Post-Quantum Falcon-512 Sign & Verify', 'Post-Quantum', verifyRes.valid, `Sig size: ${signed.signatureBytesCount}B, pubkey: ${key.publicKeyBytes.length}B`, d);
+  } catch (err) {
+    record('Post-Quantum Falcon-512 Sign & Verify', 'Post-Quantum', false, err.message);
+  }
+
+  // 6. Hybrid Composite Signatures (ECDSA P-256 + ML-DSA-65)
+  try {
+    const t0 = performance.now();
+    const key = await createManagedKeyPair('Hybrid-P256-MLDSA65', 'Test Hybrid Composite');
+    const msg = 'Hybrid Composite Defense-In-Depth Attestation';
+    const signed = await signMessage(msg, key);
+    const verifyRes = await verifyMessage(msg, signed.signature, key.publicKeyBytes, 'Hybrid-P256-MLDSA65');
+    const d = performance.now() - t0;
+    record('Hybrid Composite (ECDSA P-256 + ML-DSA-65)', 'Hybrid', verifyRes.valid, `Dual signatures verified successfully`, d);
+  } catch (err) {
+    record('Hybrid Composite (ECDSA P-256 + ML-DSA-65)', 'Hybrid', false, err.message);
+  }
+
+  // 7. Message Tamper Detection (Altered text rejected)
+  try {
+    const key = await createManagedKeyPair('ML-DSA-65', 'Tamper Test Key');
+    const msg = 'Original Unmodified Barista Directive';
+    const signed = await signMessage(msg, key);
+    const tampered = tamperMessageContent(msg);
+    const verifyTampered = await verifyMessage(tampered, signed.signature, key.publicKeyBytes, 'ML-DSA-65');
+    record('Message Tamper Rejection (Altered Payload)', 'Integrity', !verifyTampered.valid, `Tampered message was successfully detected and rejected`);
+  } catch (err) {
+    record('Message Tamper Rejection (Altered Payload)', 'Integrity', false, err.message);
+  }
+
+  // 8. Signature Corruption Rejection (Bit-flip rejected)
+  try {
+    const key = await createManagedKeyPair('ML-DSA-65', 'Bit-flip Key');
+    const msg = 'Integrity Test with Corrupted Signature';
+    const signed = await signMessage(msg, key);
+    const badSig = corruptSignature(signed.signature);
+    const verifyBad = await verifyMessage(msg, badSig, key.publicKeyBytes, 'ML-DSA-65');
+    record('Signature Corruption Rejection (Bit Flip)', 'Authenticity', !verifyBad.valid, `Corrupted signature was rejected`);
+  } catch (err) {
+    record('Signature Corruption Rejection (Bit Flip)', 'Authenticity', false, err.message);
+  }
+
+  // 9. Post-Quantum Signed Token (PQ-JWT) Valid Case
+  try {
+    const t0 = performance.now();
+    const key = await createManagedKeyPair('ML-DSA-65', 'Token Key');
+    const tokenBundle = await createSignedToken({ role: 'barista', storeId: 'store_01' }, key);
+    const verifyRes = await verifyToken(tokenBundle.token, key.publicKeyBytes);
+    const d = performance.now() - t0;
+    record('PQ-JWT Generation & Validation (ML-DSA-65)', 'Tokens', verifyRes.valid && verifyRes.cryptoValid, `Claims verified, role=${verifyRes.payload.role}`, d);
+  } catch (err) {
+    record('PQ-JWT Generation & Validation (ML-DSA-65)', 'Tokens', false, err.message);
+  }
+
+  // 10. PQ-JWT Privilege Escalation Tamper Detection
+  try {
+    const key = await createManagedKeyPair('ML-DSA-65', 'Token Key');
+    const tokenBundle = await createSignedToken({ role: 'barista' }, key);
+    const tamperedToken = tamperTokenPayload(tokenBundle.token, { role: 'super_admin' });
+    const verifyTampered = await verifyToken(tamperedToken, key.publicKeyBytes);
+    record('PQ-JWT Privilege Escalation Tamper Rejection', 'Tokens', !verifyTampered.valid && !verifyTampered.cryptoValid, `Unauthorized payload modification was blocked`);
+  } catch (err) {
+    record('PQ-JWT Privilege Escalation Tamper Rejection', 'Tokens', false, err.message);
+  }
+
+  // 11. Artifact Integrity & Asymmetric Attestation
+  try {
+    const t0 = performance.now();
+    const key = await createManagedKeyPair('ML-DSA-65', 'Artifact Signer');
+    const artifactData = new TextEncoder().encode('Single Origin Ethiopian Yirgacheffe Batch Spec');
+    const manifest = await signArtifact(artifactData, 'ethiopia-batch.spec', key, { issuer: 'Daily Grind QC' });
+    const verifyRes = await verifyArtifact(artifactData, manifest, key.publicKeyBytes);
+    const d = performance.now() - t0;
+    record('Artifact Attestation & SHA-256 Digest Verification', 'Artifacts', verifyRes.valid, `SHA-256 matched, ML-DSA-65 signature verified`, d);
+  } catch (err) {
+    record('Artifact Attestation & SHA-256 Digest Verification', 'Artifacts', false, err.message);
+  }
+
+  // 12. Artifact Tamper Detection (1-byte file corruption)
+  try {
+    const key = await createManagedKeyPair('ML-DSA-65', 'Artifact Signer');
+    const artifactData = new TextEncoder().encode('Single Origin Ethiopian Yirgacheffe Batch Spec');
+    const manifest = await signArtifact(artifactData, 'ethiopia-batch.spec', key);
+    // Tamper artifact by 1 byte
+    const tamperedData = new TextEncoder().encode('Single Origin Ethiopian Yirgacheffe Batch Spec!');
+    const verifyTampered = await verifyArtifact(tamperedData, manifest, key.publicKeyBytes);
+    record('Artifact Tamper Rejection (1-Byte Modification)', 'Artifacts', !verifyTampered.valid && !verifyTampered.hashMatches, `Hash mismatch caught before signature check: ${verifyTampered.reason.substring(0, 50)}...`);
+  } catch (err) {
+    record('Artifact Tamper Rejection (1-Byte Modification)', 'Artifacts', false, err.message);
+  }
+
+  const passedCount = results.filter(r => r.passed).length;
+  const totalCount = results.length;
+
+  return {
+    results,
+    summary: {
+      total: totalCount,
+      passed: passedCount,
+      failed: totalCount - passedCount,
+      allPassed: passedCount === totalCount,
+    },
+  };
+}
