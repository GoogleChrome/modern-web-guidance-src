+
+  'Hybrid-P256-MLDSA65': {
+    id: 'Hybrid-P256-MLDSA65',
+    name: 'Hybrid Composite (ECDSA P-256 + ML-DSA-65)',
+    type: 'hybrid',
+    standard: 'Composite Signatures (IETF Draft / NIST Transition Strategy)',
+    securityLevel: 'Combined Classical 128-bit + NIST Level 3 Post-Quantum',
+    description: 'Defense-in-depth transition strategy combining both classical ECDSA P-256 and post-quantum ML-DSA-65. Verification succeeds only if BOTH signatures are cryptographically valid.',
+    pubKeySize: 91 + 1952,
+    sigSize: 64 + 3309,
+    keygen: async () => {
+      const ecdsaKeys = await ALGORITHM_REGISTRY['ECDSA-P256'].keygen();
+      const pqKeys = await ALGORITHM_REGISTRY['ML-DSA-65'].keygen();
+
+      // Encode compound key into structured JSON format
+      const pubComposite = new TextEncoder().encode(JSON.stringify({
+        c: bytesToBase64(ecdsaKeys.publicKey),
+        pq: bytesToBase64(pqKeys.publicKey),
+      }));
+
+      const privComposite = new TextEncoder().encode(JSON.stringify({
+        c: bytesToBase64(ecdsaKeys.secretKey),
+        pq: bytesToBase64(pqKeys.secretKey),
+      }));
+
+      return {
+        publicKey: pubComposite,
+        secretKey: privComposite,
+      };
+    },
+    sign: async (msg, secretKeyBytes) => {
+      const privJson = JSON.parse(new TextDecoder().decode(secretKeyBytes));
+      const ecdsaPriv = base64ToBytes(privJson.c);
+      const pqPriv = base64ToBytes(privJson.pq);
+
+      const ecdsaSig = await ALGORITHM_REGISTRY['ECDSA-P256'].sign(msg, ecdsaPriv);
+      const pqSig = await ALGORITHM_REGISTRY['ML-DSA-65'].sign(msg, pqPriv);
+
+      const compositeSig = new TextEncoder().encode(JSON.stringify({
+        sigClassical: bytesToBase64(ecdsaSig),
+        sigPq: bytesToBase64(pqSig),
+      }));
+
+      return compositeSig;
+    },
+    verify: async (sigBytes, msg, publicKeyBytes) => {
+      try {
+        const pubJson = JSON.parse(new TextDecoder().decode(publicKeyBytes));
+        const sigJson = JSON.parse(new TextDecoder().decode(sigBytes));
+
+        const ecdsaPub = base64ToBytes(pubJson.c);
+        const pqPub = base64ToBytes(pubJson.pq);
+        const ecdsaSig = base64ToBytes(sigJson.sigClassical);
+        const pqSig = base64ToBytes(sigJson.sigPq);
+
+        const okClassical = await ALGORITHM_REGISTRY['ECDSA-P256'].verify(ecdsaSig, msg, ecdsaPub);
+        const okPq = await ALGORITHM_REGISTRY['ML-DSA-65'].verify(pqSig, msg, pqPub);
+
+        return okClassical && okPq;
+      } catch (err) {
+        return false;
+      }
+    },
+  },
+};
+
+/**
+ * Get algorithm by ID with fallback to default ML-DSA-65
+ */
+export function getAlgorithm(algorithmId) {
+  const alg = ALGORITHM_REGISTRY[algorithmId];
+  if (!alg) {
+    throw new Error(`Unsupported algorithm: ${algorithmId}`);
+  }
+  return alg;
+}
+
+/**
+ * List all available algorithms with categorized metadata
+ */
+export function listAlgorithms() {
+  return Object.values(ALGORITHM_REGISTRY);
+}
