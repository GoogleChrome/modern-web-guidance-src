+      await this.executeArtifactVerification();
+    });
+
+    tamperBtn?.addEventListener('click', async () => {
+      if (!this.currentArtifactData) {
+        alert('No artifact data loaded to tamper.');
+        return;
+      }
+      // Mutate 1 byte of the artifact data
+      const mutated = new Uint8Array(this.currentArtifactData.length);
+      mutated.set(this.currentArtifactData);
+      mutated[0] ^= 0x01; // flip 1 bit
+      this.currentArtifactData = mutated;
+      this.showToast('Tampered 1 byte of artifact file! Re-verifying...');
+      await this.executeArtifactVerification();
+    });
+  }
+
+  loadSampleArtifact(index) {
+    const sample = SAMPLE_ARTIFACTS[index];
+    if (!sample) return;
+
+    this.currentArtifactName = sample.name;
+    this.currentArtifactData = new TextEncoder().encode(sample.content);
+
+    const preview = document.getElementById('cq-art-file-preview');
+    if (preview) {
+      preview.innerHTML = `
+        <div>
+          <strong>${escapeHtml(sample.name)}</strong>
+          <div style="font-size: 0.78rem; color: var(--cq-text-muted);">${escapeHtml(sample.description)}</div>
+        </div>
+        <span class="key-pill pill-pqc">${this.currentArtifactData.length} Bytes</span>
+      `;
+      preview.style.display = 'flex';
+    }
+
+    hashArtifactData(this.currentArtifactData).then(hashes => {
+      const hashesDisplay = document.getElementById('cq-art-hashes-display');
+      if (hashesDisplay) {
+        hashesDisplay.innerHTML = `
+          SHA-256: <code>${hashes.sha256Hex}</code><br>
+          SHA-512: <code>${hashes.sha512Hex.substring(0, 32)}...</code>
+        `;
+      }
+    });
+  }
+
+  handleUserFile(file) {
+    this.currentArtifactName = file.name;
+    const reader = new FileReader();
+    reader.onload = async (e) => {
+      this.currentArtifactData = new Uint8Array(e.target.result);
+      const preview = document.getElementById('cq-art-file-preview');
+      if (preview) {
+        preview.innerHTML = `
+          <div>
+            <strong>${escapeHtml(file.name)}</strong>
+            <div style="font-size: 0.78rem; color: var(--cq-text-muted);">${file.type || 'binary/raw'}</div>
+          </div>
+          <span class="key-pill pill-classical">${this.currentArtifactData.length} Bytes</span>
+        `;
+        preview.style.display = 'flex';
+      }
+
+      const hashes = await hashArtifactData(this.currentArtifactData);
+      const hashesDisplay = document.getElementById('cq-art-hashes-display');
+      if (hashesDisplay) {
+        hashesDisplay.innerHTML = `
+          SHA-256: <code>${hashes.sha256Hex}</code><br>
+          SHA-512: <code>${hashes.sha512Hex.substring(0, 32)}...</code>
+        `;
+      }
+      this.showToast(`Loaded ${file.name} (${this.currentArtifactData.length} bytes)`);
+    };
+    reader.readAsArrayBuffer(file);
+  }
+
+  async executeArtifactVerification() {
+    if (!this.currentArtifactData) {
+      alert('Please select or load the artifact file being verified.');
+      return;
+    }
+
+    let manifest;
+    try {
+      manifest = JSON.parse(document.getElementById('cq-art-verify-manifest-input').value);
+    } catch (e) {
+      alert('Invalid or missing manifest JSON in verification input.');
+      return;
+    }
+
+    const keyId = document.getElementById('cq-art-verify-key').value;
+    const key = vault.getKey(keyId);
+    if (!key) {
+      alert('Please select the verification key.');
+      return;
+    }
+
+    const resultBox = document.getElementById('cq-art-verify-result');
+    resultBox.style.display = 'block';
+
+    try {
+      const verifyRes = await verifyArtifact(this.currentArtifactData, manifest, key.publicKeyBytes);
+      const isPass = verifyRes.valid;
+
+      resultBox.className = `verification-result ${isPass ? 'result-valid' : 'result-invalid'}`;
+      resultBox.innerHTML = `
+        <div class="result-header">
+          <span class="result-icon">${isPass ? '🛡️' : '⚠️'}</span>
+          <div>
+            <div class="result-status-title">${isPass ? 'ARTIFACT AUTHENTIC & UNTAMPERED' : 'INTEGRITY VIOLATION DETECTED'}</div>
+            <div style="font-size: 0.82rem; opacity: 0.85;">${verifyRes.hashMatches ? 'SHA-256 Hash Matched' : 'SHA-256 Hash MISMATCH'} • ${verifyRes.sigMatches ? 'Asymmetric Signature Verified' : 'Signature REJECTED'}</div>
+          </div>
+        </div>
+        <div class="result-reason">${escapeHtml(verifyRes.reason)}</div>
+        <div class="diagnostic-grid">
+          <div>
+            <div class="diag-item-label">Calculated SHA-256</div>
+            <div class="diag-item-value">${verifyRes.calculatedHash.substring(0, 16)}...</div>
+          </div>
+          <div>
+            <div class="diag-item-label">Manifest SHA-256</div>
+            <div class="diag-item-value">${verifyRes.manifestHash.substring(0, 16)}...</div>
+          </div>
+          <div>
+            <div class="diag-item-label">Algorithm</div>
+            <div class="diag-item-value">${verifyRes.algorithm} (${verifyRes.category})</div>
+          </div>
+          <div>
+            <div class="diag-item-label">Verification Time</div>
+            <div class="diag-item-value">${verifyRes.durationMs} ms</div>
+          </div>
+        </div>
+      `;
+    } catch (err) {
+      resultBox.className = 'verification-result result-invalid';
+      resultBox.innerHTML = `<div class="result-reason">Verification error: ${escapeHtml(err.message)}</div>`;
+    }
+  }
+
+  // ==========================================
+  // KEY VAULT & MODALS
+  // ==========================================
+  setupKeyVaultHandlers() {
+    document.getElementById('cq-generate-key-btn')?.addEventListener('click', () => {
+      this.openGenerateModal();
+    });
+
+    document.getElementById('cq-import-key-btn')?.addEventListener('click', () => {
+      this.openImportModal();
+    });
+  }
+
+  renderKeyVaultList() {
+    const listContainer = document.getElementById('cq-key-vault-table-body');
+    if (!listContainer) return;
+
+    const keys = vault.getAllKeys();
+    const activeKey = vault.getActiveKey();
+
+    listContainer.innerHTML = keys.map(k => {
+      const isActive = activeKey && activeKey.id === k.id;
+      const pillClass = k.category === 'post-quantum' ? 'pill-pqc' : (k.category === 'hybrid' ? 'pill-hybrid' : 'pill-classical');
+      const categoryLabel = k.category === 'post-quantum' ? 'Post-Quantum' : (k.category === 'hybrid' ? 'Hybrid' : 'Classical');
+
+      return `
+        <tr class="${isActive ? 'active-row' : ''}">
+          <td>
+            <strong>${escapeHtml(k.name)}</strong>
+            ${isActive ? '<span style="color: var(--cq-success); font-weight: bold; margin-left: 6px;">(ACTIVE)</span>' : ''}
+            <div style="font-family: var(--cq-font-mono); font-size: 0.75rem; color: var(--cq-text-muted);">
+              ${k.fingerprint.substring(0, 24)}...
+            </div>
+          </td>
+          <td>
+            <span class="key-pill ${pillClass}">${categoryLabel}</span>
+            <div style="font-size: 0.8rem; margin-top: 2px;">${escapeHtml(k.algorithm)}</div>
+          </td>
+          <td>${k.hasSecretKey ? 'Keypair (Sign + Verify)' : 'Public Only (Verify)'}</td>
+          <td>
+            <div style="display: flex; gap: 6px;">
+              ${!isActive ? `<button class="cq-btn cq-btn-sm cq-btn-accent" onclick="window.cryptoApp.setActiveKey('${k.id}')">Select</button>` : ''}
+              <button class="cq-btn cq-btn-sm cq-btn-secondary" onclick="window.cryptoApp.openExportModal('${k.id}')">Export</button>
+              <button class="cq-btn cq-btn-sm cq-btn-outline" onclick="window.cryptoApp.deleteKey('${k.id}')" title="Delete Key">🗑️</button>
+            </div>
+          </td>
+        </tr>
+      `;
+    }).join('');
+
+    // Re-populate select boxes across app
+    this.populateKeySelect('cq-msg-verify-key');
+    this.populateKeySelect('cq-tok-verify-key');
+    this.populateKeySelect('cq-art-verify-key');
+  }
+
+  populateKeySelect(selectId, selectKeyId = null) {
+    const select = document.getElementById(selectId);
+    if (!select) return;
+
+    const keys = vault.getAllKeys();
+    const activeKey = vault.getActiveKey();
+    const targetId = selectKeyId || (activeKey ? activeKey.id : null);
+
+    select.innerHTML = keys.map(k => {
+      const selected = k.id === targetId ? 'selected' : '';
+      return `<option value="${k.id}" ${selected}>${escapeHtml(k.name)} [${k.algorithm}]</option>`;
+    }).join('');
+  }
+
+  setActiveKey(id) {
+    vault.setActiveKey(id);
+    this.renderActiveKeyBanner();
+    this.renderKeyVaultList();
+    this.showToast('Active key updated!');
+  }
+
+  deleteKey(id) {
+    if (confirm('Are you sure you want to remove this key from vault?')) {
+      vault.removeKey(id);
+      this.renderActiveKeyBanner();
+      this.renderKeyVaultList();
+      this.showToast('Key removed from vault');
+    }
+  }
+
+  openGenerateModal() {
+    const modal = document.getElementById('cq-generate-modal');
+    if (!modal) return;
+    modal.style.display = 'flex';
+  }
+
+  openImportModal() {
+    const modal = document.getElementById('cq-import-modal');
+    if (!modal) return;
+    modal.style.display = 'flex';
+  }
+
+  openExportModal(keyId) {
+    const key = vault.getKey(keyId);
+    if (!key) return;
+
+    this.exportingKey = key;
+    const modal = document.getElementById('cq-export-modal');
+    if (!modal) return;
+
+    document.getElementById('cq-export-key-name').textContent = key.name;
+    document.getElementById('cq-export-key-alg').textContent = `${key.algorithm} (${key.category})`;
+    document.getElementById('cq-export-key-fp').textContent = key.fingerprint;
+
+    this.updateExportView('base64');
+    modal.style.display = 'flex';
+  }
+
+  updateExportView(format) {
+    if (!this.exportingKey) return;
+    const pubOut = document.getElementById('cq-export-pub-output');
+    const privOut = document.getElementById('cq-export-priv-output');
+    const privGroup = document.getElementById('cq-export-priv-group');
+
+    pubOut.textContent = exportPublicKey(this.exportingKey, format);
+
+    if (this.exportingKey.hasSecretKey && format !== 'bundle') {
+      privGroup.style.display = 'block';
+      privOut.textContent = exportSecretKey(this.exportingKey, format);
+    } else {
+      privGroup.style.display = 'none';
+    }
+  }
+
+  setupModals() {
+    // Close modal handlers
+    document.querySelectorAll('.modal-close-btn, .modal-cancel-btn').forEach(btn => {
+      btn.addEventListener('click', () => {
+        document.querySelectorAll('.crypto-modal-backdrop').forEach(m => m.style.display = 'none');
+      });
+    });
+
+    // Generate Key Form
+    const genConfirmBtn = document.getElementById('cq-gen-confirm-btn');
+    genConfirmBtn?.addEventListener('click', async () => {
+      const algId = document.getElementById('cq-gen-alg-select').value;
+      const nameInput = document.getElementById('cq-gen-name-input').value.trim();
+      try {
+        genConfirmBtn.disabled = true;
+        genConfirmBtn.textContent = 'Generating Keypair...';
+        const key = await createManagedKeyPair(algId, nameInput || undefined);
+        vault.addKey(key);
+        vault.setActiveKey(key.id);
+        this.renderActiveKeyBanner();
+        this.renderKeyVaultList();
+        document.getElementById('cq-generate-modal').style.display = 'none';
+        this.showToast(`Keypair generated: ${key.name}!`);
+      } catch (err) {
+        alert('Key generation failed: ' + err.message);
+      } finally {
+        genConfirmBtn.disabled = false;
+        genConfirmBtn.textContent = 'Generate Keypair';
+      }
+    });
+
+    // Import Key Form
+    const importConfirmBtn = document.getElementById('cq-import-confirm-btn');
+    importConfirmBtn?.addEventListener('click', async () => {
+      const rawText = document.getElementById('cq-import-text-input').value.trim();
+      const algId = document.getElementById('cq-import-alg-select').value;
+      const name = document.getElementById('cq-import-name-input').value.trim();
+
+      if (!rawText) {
+        alert('Please paste the public key data to import.');
+        return;
+      }
+
+      try {
+        const key = await importPublicKey(rawText, algId, name || undefined);
+        vault.addKey(key);
+        this.renderKeyVaultList();
+        document.getElementById('cq-import-modal').style.display = 'none';
+        this.showToast(`Imported key: ${key.name}!`);
+      } catch (err) {
+        alert('Key import failed: ' + err.message);
+      }
+    });
+
+    // Export format selector
+    document.getElementById('cq-export-format-select')?.addEventListener('change', (e) => {
+      this.updateExportView(e.target.value);
+    });
+
+    // Copy exported public key
+    document.getElementById('cq-copy-exported-pub-btn')?.addEventListener('click', () => {
+      const text = document.getElementById('cq-export-pub-output').textContent;
+      navigator.clipboard.writeText(text);
+      this.showToast('Public key copied to clipboard!');
+    });
+  }
+
+  // ==========================================
+  // AUTOMATED TEST SUITE
+  // ==========================================
+  setupTestSuiteHandlers() {
+    const runBtn = document.getElementById('cq-run-tests-btn');
+    runBtn?.addEventListener('click', async () => {
+      await this.runTestSuiteUI();
+    });
+  }
+
+  async runTestSuiteUI() {
+    const runBtn = document.getElementById('cq-run-tests-btn');
+    const listContainer = document.getElementById('cq-test-results-list');
+    const summaryContainer = document.getElementById('cq-test-summary');
+
+    if (!listContainer || !runBtn) return;
+
+    listContainer.innerHTML = '';
+    summaryContainer.textContent = 'Running test suite in browser...';
+    runBtn.disabled = true;
+    runBtn.textContent = 'Running Tests...';
+
+    try {
+      const outcome = await runCryptoTestSuite((test) => {
+        const item = document.createElement('div');
+        item.className = `test-item ${test.passed ? 'test-pass' : 'test-fail'}`;
+        item.innerHTML = `
+          <div class="test-item-left">
+            <span class="${test.passed ? 'test-badge-pass' : 'test-badge-fail'}">${test.passed ? 'PASS' : 'FAIL'}</span>
+            <div>
+              <strong>${escapeHtml(test.name)}</strong>
+              <div style="font-size: 0.8rem; color: var(--cq-text-muted);">${escapeHtml(test.details || '')}</div>
+            </div>
+          </div>
+          <div style="font-size: 0.8rem; font-family: var(--cq-font-mono); color: var(--cq-text-muted);">
+            ${test.durationMs ? `${test.durationMs}ms` : ''}
+          </div>
+        `;
+        listContainer.appendChild(item);
+      });
+
+      summaryContainer.innerHTML = `
+        <strong>${outcome.summary.passed} / ${outcome.summary.total}</strong> tests passed.
+        ${outcome.summary.allPassed ? '<span style="color: var(--cq-success); margin-left: 8px;">✓ All cryptosystems operational and verified.</span>' : '<span style="color: var(--cq-error);">Some tests failed.</span>'}
+      `;
+    } catch (err) {
+      summaryContainer.textContent = 'Error running tests: ' + err.message;
+    } finally {
+      runBtn.disabled = false;
+      runBtn.textContent = '🚀 Run Verification Test Suite';
+    }
+  }
+
+  // ==========================================
+  // ALGORITHM MATRIX
+  // ==========================================
+  setupAlgorithmMatrix() {
+    const tableBody = document.getElementById('cq-matrix-table-body');
+    if (!tableBody) return;
+
+    const algs = listAlgorithms();
+    tableBody.innerHTML = algs.map(a => {
+      const pillClass = a.type === 'post-quantum' ? 'pill-pqc' : (a.type === 'hybrid' ? 'pill-hybrid' : 'pill-classical');
+      const catName = a.type === 'post-quantum' ? 'Post-Quantum' : (a.type === 'hybrid' ? 'Hybrid' : 'Classical');
+      return `
+        <tr>
+          <td>
+            <strong>${escapeHtml(a.name)}</strong>
+            <div style="font-size: 0.75rem; color: var(--cq-text-muted);">${escapeHtml(a.standard)}</div>
+          </td>
+          <td><span class="key-pill ${pillClass}">${catName}</span></td>
+          <td>${escapeHtml(a.securityLevel)}</td>
+          <td>${a.pubKeySize ? `${a.pubKeySize} B` : 'Compound'}</td>
+          <td>${a.sigSize ? `${a.sigSize} B` : 'Compound'}</td>
+          <td style="font-size: 0.82rem; line-height: 1.4;">${escapeHtml(a.description)}</td>
+        </tr>
+      `;
+    }).join('');
+  }
+}
+
+function escapeHtml(str) {
+  if (!str) return '';
+  return String(str)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#039;');
+}
+
+export const cryptoApp = new CryptoApp();
