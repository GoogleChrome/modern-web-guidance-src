+// Post-Quantum & Classical Signed Token (PQ-JWT / JWS) Engine
+import { getAlgorithm } from '../crypto/algorithms.js';
+import {
+  stringToBase64Url,
+  base64UrlToString,
+  bytesToBase64Url,
+  base64UrlToBytes,
+  generateId,
+  computeFingerprint,
+} from '../crypto/utils.js';
+
+/**
+ * Creates a signed token (header.payload.signature)
+ */
+export async function createSignedToken(payloadClaims, keyObj, customHeader = {}) {
+  if (!keyObj || !keyObj.hasSecretKey || !keyObj.secretKeyBytes) {
+    throw new Error('Valid signing key with secret key material is required');
+  }
+
+  const nowSec = Math.floor(Date.now() / 1000);
+  const defaultPayload = {
+    iss: 'daily-grind-authority',
+    sub: 'barista_alex_902',
+    aud: 'daily-grind-pos-network',
+    iat: nowSec,
+    exp: nowSec + 3600, // 1 hour default
+    jti: generateId('tok'),
+    role: 'shift_lead',
+    permissions: ['orders:create', 'discounts:authorize', 'inventory:audit'],
+    storeId: 'store_seattle_flagship',
+  };
+
+  const finalPayload = { ...defaultPayload, ...payloadClaims };
+
+  const header = {
+    alg: keyObj.algorithm,
+    typ: keyObj.category === 'post-quantum' ? 'PQ-JWT' : 'JWT',
+    kid: keyObj.id,
+    pqc: keyObj.category === 'post-quantum',
+    ...customHeader,
+  };
+
+  const headerB64Url = stringToBase64Url(JSON.stringify(header));
+  const payloadB64Url = stringToBase64Url(JSON.stringify(finalPayload));
+  const signingInput = `${headerB64Url}.${payloadB64Url}`;
+  const signingInputBytes = new TextEncoder().encode(signingInput);
+
+  const alg = getAlgorithm(keyObj.algorithm);
+  const t0 = performance.now();
+  const sigBytes = await alg.sign(signingInputBytes, keyObj.secretKeyBytes);
+  const durationMs = performance.now() - t0;
+
+  const sigB64Url = bytesToBase64Url(sigBytes);
+  const tokenString = `${headerB64Url}.${payloadB64Url}.${sigB64Url}`;
+
+  return {
+    token: tokenString,
+    header,
+    payload: finalPayload,
+    signatureBytesCount: sigBytes.length,
+    algorithm: keyObj.algorithm,
+    keyId: keyObj.id,
+    metrics: {
+      signTimeMs: Number(durationMs.toFixed(2)),
+    },
+  };
+}
+
+/**
+ * Decodes a token without verifying (for inspector UI)
+ */
+export function decodeToken(tokenString) {
+  if (!tokenString || typeof tokenString !== 'string') {
+    throw new Error('Invalid token string');
+  }
+
+  const parts = tokenString.trim().split('.');
+  if (parts.length !== 3) {
+    throw new Error('Malformed token: Expected 3 parts separated by dots (header.payload.signature)');
+  }
+
+  const [headerB64, payloadB64, sigB64] = parts;
+
+  let header, payload;
+  try {
+    header = JSON.parse(base64UrlToString(headerB64));
+  } catch (err) {
+    throw new Error('Malformed token header: Invalid JSON');
+  }
+
+  try {
+    payload = JSON.parse(base64UrlToString(payloadB64));
+  } catch (err) {
+    throw new Error('Malformed token payload: Invalid JSON');
+  }
+
+  return {
+    header,
+    payload,
+    headerRaw: headerB64,
+    payloadRaw: payloadB64,
+    signatureRaw: sigB64,
+    signingInput: `${headerB64}.${payloadB64}`,
+  };
+}
+
+/**
+ * Verifies a token's cryptographic signature and time validity
+ */
+export async function verifyToken(tokenString, publicKeyBytes, algorithmIdOverride = null) {
+  let decoded;
+  try {
+    decoded = decodeToken(tokenString);
+  } catch (err) {
+    return {
+      valid: false,
+      status: 'MALFORMED',
+      reason: err.message,
+      claimsValid: false,
+      cryptoValid: false,
+    };
+  }
+
+  const algorithmId = algorithmIdOverride || decoded.header.alg;
+  if (!algorithmId) {
+    return {
+      valid: false,
+      status: 'MISSING_ALGORITHM',
+      reason: 'No algorithm specified in token header or parameter',
+      claimsValid: false,
+      cryptoValid: false,
+    };
+  }
+
+  const alg = getAlgorithm(algorithmId);
+  const signingInputBytes = new TextEncoder().encode(decoded.signingInput);
+
+  let sigBytes;
+  try {
+    sigBytes = base64UrlToBytes(decoded.signatureRaw);
+  } catch (err) {
+    return {
+      valid: false,
+      status: 'INVALID_SIGNATURE_ENCODING',
+      reason: 'Token signature is not valid Base64URL encoding',
+      claimsValid: false,
+      cryptoValid: false,
+    };
+  }
+
+  const t0 = performance.now();
+  let cryptoValid = false;
+  try {
+    cryptoValid = await alg.verify(sigBytes, signingInputBytes, publicKeyBytes);
+  } catch (err) {
+    cryptoValid = false;
+  }
+  const durationMs = performance.now() - t0;
+
+  // Validate standard claims (exp, nbf)
+  const nowSec = Math.floor(Date.now() / 1000);
+  let claimsValid = true;
+  const claimErrors = [];
+
+  if (decoded.payload.exp !== undefined) {
+    if (nowSec >= decoded.payload.exp) {
+      claimsValid = false;
+      const expiredAgo = nowSec - decoded.payload.exp;
+      claimErrors.push(`Token expired ${expiredAgo} seconds ago (exp: ${new Date(decoded.payload.exp * 1000).toISOString()})`);
+    }
+  }
+
+  if (decoded.payload.nbf !== undefined) {
+    if (nowSec < decoded.payload.nbf) {
+      claimsValid = false;
+      claimErrors.push(`Token is not valid yet (nbf: ${new Date(decoded.payload.nbf * 1000).toISOString()})`);
+    }
+  }
+
+  const isOverallValid = cryptoValid && claimsValid;
+  const keyFingerprint = await computeFingerprint(publicKeyBytes);
+
+  let reason = '';
+  let status = 'VALID';
+  if (!cryptoValid) {
+    status = 'CRYPTO_FAILED';
+    reason = 'Cryptographic signature verification failed! The token claims or header were modified, or signed with a different key.';
+  } else if (!claimsValid) {
+    status = 'CLAIMS_EXPIRED';
+    reason = `Cryptographic signature is valid, but token claims check failed: ${claimErrors.join(', ')}`;
+  } else {
+    reason = `Token is authentic and valid! Signed via ${algorithmId} (${alg.type}). Not expired.`;
+  }
+
+  return {
+    valid: isOverallValid,
+    cryptoValid,
+    claimsValid,
+    status,
+    reason,
+    algorithm: algorithmId,
+    category: alg.type,
+    keyFingerprint,
+    header: decoded.header,
+    payload: decoded.payload,
+    signatureBytesCount: sigBytes.length,
+    claimErrors,
+    durationMs: Number(durationMs.toFixed(2)),
+  };
+}
+
+/**
+ * Tamper helper for token payload
+ */
+export function tamperTokenPayload(tokenString, modifiedPayloadProperties = {}) {
+  const decoded = decodeToken(tokenString);
+  const mutatedPayload = {
+    ...decoded.payload,
+    role: 'super_admin_unauthorized',
+    permissions: ['*'],
+    discount_limit: 9999,
+    ...modifiedPayloadProperties,
+  };
+
+  const newPayloadB64 = stringToBase64Url(JSON.stringify(mutatedPayload));
+  // Keep original signature to demonstrate cryptographic failure
+  return `${decoded.headerRaw}.${newPayloadB64}.${decoded.signatureRaw}`;
+}
