+          publicKey,
+          { name: 'ECDSA', namedCurve: 'P-256' },
+          false,
+          ['verify']
+        );
+        return await subtle.verify(
+          { name: 'ECDSA', hash: { name: 'SHA-256' } },
+          cryptoKey,
+          sig,
+          msg
+        );
+      } catch (err) {
+        return false;
+      }
+    },
+  },
+
+  'ECDSA-P384': {
+    id: 'ECDSA-P384',
+    name: 'ECDSA (NIST P-384 / SHA-384)',
+    type: 'classical',
+    standard: 'FIPS 186-4 (ES384)',
+    securityLevel: 'Classical 192-bit (Vulnerable to quantum computers)',
+    description: 'Higher security NIST elliptic curve digital signature running via browser Web Crypto API.',
+    pubKeySize: 120,
+    sigSize: 96,
+    keygen: async () => {
+      if (!subtle) throw new Error('WebCrypto Subtle is not available');
+      const pair = await subtle.generateKey(
+        { name: 'ECDSA', namedCurve: 'P-384' },
+        true,
