+  <script>
+    const target = document.getElementById('action-target');
+    const toggles = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded'
+    };
+
+    target.addEventListener('command', (event) => {
+      if (event.command in toggles) {
+        target.classList.toggle(toggles[event.command]);
+      } else if (event.command === '--reset') {
+        target.classList.remove(...Object.values(toggles));
+      }
+    });
+  </script>
