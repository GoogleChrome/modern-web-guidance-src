+  <script>
+    (function () {
+      var form = document.getElementById('subscribe-form');
+      var progress = document.getElementById('setup-progress');
+      var progressText = document.getElementById('progress-text');
+      var roast = document.getElementById('roast-level');
+      var roastValue = document.getElementById('roast-value');
+      var submit = document.getElementById('subscribe-submit');
+      var status = document.getElementById('subscribe-status');
+      var roastNames = ['Light', 'Light-Medium', 'Medium', 'Medium-Dark', 'Dark'];
+      // Steps: frequency chosen, roast adjusted, email preference reviewed
+      var done = { roast: false, emails: false };
+
+      function updateRoast() {
+        var name = roastNames[roast.value - 1];
+        roastValue.textContent = name;
+        roast.setAttribute('aria-valuetext', name);
+        roast.style.setProperty('--fill', ((roast.value - 1) / 4 * 100) + '%');
+      }
+
+      function updateProgress() {
+        var steps = [!!form.elements.frequency.value, done.roast, done.emails];
+        var pct = Math.round(steps.filter(Boolean).length / steps.length * 100);
+        progress.value = pct;
+        progressText.textContent = pct + '% complete';
+        submit.disabled = pct < 100;
+      }
+
+      roast.addEventListener('input', function () { done.roast = true; updateRoast(); updateProgress(); });
+      form.elements.emails.addEventListener('change', function () { done.emails = true; updateProgress(); });
+      form.elements.frequency.forEach
+        ? form.elements.frequency.forEach(function (r) { r.addEventListener('change', updateProgress); })
+        : null;
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        status.textContent = 'Thanks! Your subscription is set up.';
+      });
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
