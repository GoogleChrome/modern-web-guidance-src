+  <script>
+    (() => {
+      const form = document.getElementById('subscribe-form');
+      const roast = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-output');
+      const progress = document.getElementById('setup-progress');
+      const status = document.getElementById('progress-status');
+      const confirmation = document.getElementById('subscribe-confirmation');
+      const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      const total = Number(progress.max);
+      let roastTouched = false;
+
+      function updateFill() {
+        const pct = ((roast.value - roast.min) / (roast.max - roast.min)) * 100;
+        roast.style.setProperty('--fill', `${pct}%`);
+      }
+
+      function updateProgress() {
+        const done = [
+          form.elements.frequency.value !== '',
+          roastTouched,
+          form.elements.emails.checked,
+        ].filter(Boolean).length;
+        const text = `${done} of ${total} steps complete`;
+        progress.value = done;
+        progress.textContent = text;
+        status.textContent = text;
+      }
+
+      roast.addEventListener('input', () => {
+        roastTouched = true;
+        const name = roastNames[roast.value - 1];
+        roastOutput.textContent = name;
+        roast.setAttribute('aria-valuetext', name);
+        updateFill();
+        updateProgress();
+      });
+
+      form.addEventListener('change', updateProgress);
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        confirmation.textContent = form.elements.frequency.value
+          ? 'Thanks! Your subscription preferences are saved.'
+          : 'Please choose a delivery frequency to continue.';
+        confirmation.hidden = false;
+      });
+
+      updateFill();
+    })();
+  </script>
