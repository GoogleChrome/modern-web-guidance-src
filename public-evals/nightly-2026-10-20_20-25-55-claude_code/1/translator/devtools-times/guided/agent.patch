@@ -0,0 +1,14 @@
+---
+import Layout from '../layouts/Layout.astro';
+import TranslateForm from '../components/TranslateForm';
+---
+
+<Layout title="Translate | The DevTools Times">
+  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
+    <h1 class="text-3xl font-bold mb-2">Translate</h1>
+    <p class="text-gray-600 mb-6 text-sm">
+      Translate text between languages. Translation runs on your device, so your text is never sent to a server.
+    </p>
+    <TranslateForm client:load />
+  </main>
+</Layout>
