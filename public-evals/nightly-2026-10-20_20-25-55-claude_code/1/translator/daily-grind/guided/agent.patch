+  <script>
+    (() => {
+      const SOURCE = 'en';
+      const select = document.getElementById('lang-select');
+      const status = document.getElementById('translate-status');
+      const originals = new Map(); // text node -> original English text
+      const translators = new Map(); // target language -> Translator
+      let requestId = 0;
+
+      if (!('Translator' in self)) {
+        select.disabled = true;
+        select.title = 'Client-side translation is currently unsupported in this browser';
+        status.textContent = 'Client-side translation is currently unsupported in this browser.';
+        return;
+      }
+
+      function textNodes() {
+        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
+          acceptNode(node) {
+            if (!node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
+            const parent = node.parentElement;
+            if (!parent || parent.closest('script, style, [translate="no"], #translate-status')) {
+              return NodeFilter.FILTER_REJECT;
+            }
+            return NodeFilter.FILTER_ACCEPT;
+          },
+        });
+        const nodes = [];
+        while (walker.nextNode()) nodes.push(walker.currentNode);
+        return nodes;
+      }
+
+      function restore() {
+        for (const [node, text] of originals) node.nodeValue = text;
+        originals.clear();
+        document.documentElement.lang = SOURCE;
+        document.documentElement.dir = 'ltr';
+        document.title = document.documentElement.dataset.title;
+      }
+
+      async function getTranslator(target) {
+        if (translators.has(target)) return translators.get(target);
+        const options = { sourceLanguage: SOURCE, targetLanguage: target };
+        const availability = await Translator.availability(options);
+        if (availability === 'unavailable') return null;
+        // Called from a change event, so the user gesture requirement for downloads is met.
+        const translator = await Translator.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              status.textContent = `Downloading language pack… ${Math.round(e.loaded * 100)}%`;
+            });
+          },
+        });
+        translators.set(target, translator);
+        return translator;
+      }
+
+      document.documentElement.dataset.title = document.title;
+
+      select.addEventListener('change', async () => {
+        const target = select.value;
+        const id = ++requestId;
+        if (target === SOURCE) {
+          restore();
+          status.textContent = '';
+          return;
+        }
+        select.disabled = true;
+        status.textContent = 'Translating…';
+        try {
+          const translator = await getTranslator(target);
+          if (!translator) {
+            status.textContent = 'This language is not available on this device.';
+            select.value = document.documentElement.lang;
+            return;
+          }
+          // Always translate from the original English text.
+          for (const node of textNodes()) if (!originals.has(node)) originals.set(node, node.nodeValue);
+          const entries = [...originals];
+          const results = await Promise.all(entries.map(([, text]) => translator.translate(text.trim())));
+          if (id !== requestId) return;
+          entries.forEach(([node, text], i) => {
+            const lead = text.match(/^\s*/)[0];
+            const trail = text.match(/\s*$/)[0];
+            node.nodeValue = lead + results[i] + trail;
+          });
+          document.title = await translator.translate(document.documentElement.dataset.title);
+          document.documentElement.lang = target;
+          document.documentElement.dir = target === 'ar' ? 'rtl' : 'ltr';
+          status.textContent = '';
+        } catch (err) {
+          console.error(err);
+          status.textContent = 'Sorry, translation failed. Please try again.';
+          select.value = document.documentElement.lang;
+        } finally {
+          select.disabled = false;
+        }
+      });
+    })();
+  </script>
 </body>
 
