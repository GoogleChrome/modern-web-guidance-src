diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,55 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Product</title>
+<style>
+  body { margin: 0; font-family: system-ui, sans-serif; }
+  img { max-width: 100%; height: auto; display: block; }
+  nav, section, footer { padding: 1rem; }
+  [hidden] { display: none; }
+  .spacer { height: 150vh; }
+</style>
+</head>
+<body>
+<nav>
+  <button type="button" aria-expanded="false" aria-controls="mega-menu" id="menu-toggle">Menu</button>
+  <div id="mega-menu" hidden>
+    <img src="mega-menu-promo.jpg" alt="Special offer" width="300" height="150" fetchpriority="low">
+  </div>
+</nav>
+
+<header>
+  <img src="hero-lcp.jpg" alt="Product hero" width="1600" height="800" fetchpriority="high">
+</header>
+
+<section>
+  <h1>Product</h1>
+  <div id="gallery">
+    <img src="hero-lcp.jpg" alt="Product view 1" width="400" height="300">
+    <img id="gallery-alt" src="gallery-alt.jpg" alt="Product view 2" width="400" height="300" fetchpriority="low" loading="lazy" hidden>
+  </div>
+  <button type="button" id="gallery-toggle">Show alternate view</button>
+</section>
+
+<div class="spacer"></div>
+
+<footer>
+  <img src="footer-logo.png" alt="Logo" width="120" height="60" loading="lazy">
+</footer>
+
+<script>
+  const menuToggle = document.getElementById('menu-toggle');
+  const menu = document.getElementById('mega-menu');
+  menuToggle.addEventListener('click', () => {
+    menu.hidden = !menu.hidden;
+    menuToggle.setAttribute('aria-expanded', String(!menu.hidden));
+  });
+  document.getElementById('gallery-toggle').addEventListener('click', () => {
+    const alt = document.getElementById('gallery-alt');
+    alt.hidden = !alt.hidden;
+  });
+</script>
+</body>
+</html>
