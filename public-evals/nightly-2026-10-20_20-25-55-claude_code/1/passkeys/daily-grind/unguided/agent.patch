+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <link rel="stylesheet" href="/auth.css">
+</head>
+<body>
+  <nav>
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/">Home</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <main>
+    <h1>My Account</h1>
+    <p class="lead">Signed in as <strong id="username"></strong>.</p>
+
+    <section class="panel">
+      <div class="verify-bar">
+        <div>
+          <h2>Security check</h2>
+          <p id="verify-text"></p>
+        </div>
+        <button id="verify" class="secondary" type="button">Verify with passkey</button>
+      </div>
+    </section>
+
+    <section class="panel">
+      <h2>Your passkeys</h2>
+      <div id="list"></div>
+      <p class="divider">Add a passkey for another device or password manager so you never get locked out.</p>
+      <button id="add" type="button">Add a passkey</button>
+      <p id="status" class="status" role="status"></p>
+    </section>
+  </main>
+
+  <script src="/auth.js"></script>
+  <script>
+    const $ = (id) => document.getElementById(id);
+    const say = (msg, kind = '') => { $('status').textContent = msg || ''; $('status').className = `status ${kind}`; };
+    const fmt = (t) => (t ? new Date(t).toLocaleString() : 'never');
+    let verifiedUntil = 0;
+    let passkeys = [];
+
+    function fail(e) {
+      const msg = friendlyError(e);
+      if (msg === null) say('Cancelled.');
+      else if (e.code === 'login_required') location.href = '/login';
+      else say(msg, 'error');
+    }
+
+    function renderVerify() {
+      const ok = verifiedUntil > Date.now();
+      $('verify-text').textContent = ok
+        ? `Verified until ${new Date(verifiedUntil).toLocaleTimeString()}. Sensitive changes are unlocked.`
+        : 'Adding or removing passkeys needs a recent passkey check.';
+    }
+    setInterval(renderVerify, 15000);
+
+    function render() {
+      const list = $('list');
+      list.replaceChildren();
+      for (const p of passkeys) {
+        const row = document.createElement('div');
+        row.className = 'passkey';
+
+        const info = document.createElement('div');
+        const title = document.createElement('strong');
+        title.textContent = p.name;
+        info.append(title);
+        if (p.backedUp) {
+          const b = document.createElement('span');
+          b.className = 'badge';
+          b.textContent = 'Synced';
+          info.append(b);
+        }
+        const meta = document.createElement('div');
+        meta.className = 'meta';
+        meta.textContent = `Added ${fmt(p.createdAt)} · Last used ${fmt(p.lastUsedAt)}`;
+        info.append(meta);
+
+        const actions = document.createElement('div');
+        actions.className = 'actions';
+        const rename = document.createElement('button');
+        rename.className = 'secondary small';
+        rename.textContent = 'Rename';
+        rename.onclick = () => startRename(p, row);
+        const del = document.createElement('button');
+        del.className = 'danger small';
+        del.textContent = 'Remove';
+        del.disabled = passkeys.length === 1;
+        del.title = del.disabled ? 'Add another passkey before removing this one' : '';
+        del.onclick = () => remove(p);
+        actions.append(rename, del);
+
+        row.append(info, actions);
+        list.append(row);
+      }
+    }
+
+    function startRename(p, row) {
+      const input = document.createElement('input');
+      input.type = 'text';
+      input.value = p.name;
+      input.maxLength = 50;
+      input.setAttribute('aria-label', 'Passkey name');
+      const save = document.createElement('button');
+      save.className = 'small';
+      save.textContent = 'Save';
+      const cancel = document.createElement('button');
+      cancel.className = 'secondary small';
+      cancel.textContent = 'Cancel';
+      cancel.onclick = render;
+      const commit = async () => {
+        try {
+          const { passkey } = await api('PATCH', `/api/passkeys/${p.id}`, { name: input.value });
+          Object.assign(p, passkey);
+          say('Passkey renamed.', 'ok');
+          render();
+        } catch (e) { fail(e); }
+      };
+      save.onclick = commit;
+      input.onkeydown = (e) => { if (e.key === 'Enter') commit(); if (e.key === 'Escape') render(); };
+      row.replaceChildren(input, save, cancel);
+      input.focus();
+      input.select();
+    }
+
+    async function refresh() {
+      ({ passkeys } = await api('GET', '/api/passkeys'));
+      render();
+    }
+
+    async function remove(p) {
+      if (!confirm(`Remove "${p.name}"? You won't be able to sign in with it anymore.`)) return;
+      try {
+        await Passkeys.withReauth(() => api('DELETE', `/api/passkeys/${p.id}`));
+        say('Passkey removed.', 'ok');
+        await syncMe();
+        await refresh();
+      } catch (e) { fail(e); }
+    }
+
+    $('add').onclick = async () => {
+      $('add').disabled = true;
+      say('Follow your device prompt…');
+      try {
+        const name = `Passkey ${new Date().toLocaleDateString()}`;
+        await Passkeys.withReauth(() => Passkeys.addPasskey(name));
+        say('Passkey added. You can rename it below.', 'ok');
+        await syncMe();
+        await refresh();
+      } catch (e) { fail(e); }
+      $('add').disabled = false;
+    };
+
+    $('verify').onclick = async () => {
+      say('Waiting for your passkey…');
+      try {
+        const r = await Passkeys.reauthenticate();
+        verifiedUntil = r.verifiedUntil;
+        renderVerify();
+        say('Verified.', 'ok');
+      } catch (e) { fail(e); }
+    };
+
+    async function syncMe() {
+      const me = await api('GET', '/api/me');
+      if (!me.user) { location.href = '/login'; return; }
+      $('username').textContent = me.user.username;
+      verifiedUntil = me.verifiedUntil || 0;
+      renderVerify();
+    }
+
+    (async () => {
+      try { await syncMe(); await refresh(); } catch (e) { fail(e); }
+    })();
+  </script>
+</body>
+</html>
