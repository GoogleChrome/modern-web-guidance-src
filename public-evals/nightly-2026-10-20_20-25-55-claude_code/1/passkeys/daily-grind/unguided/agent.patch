+// Client-side passkey helpers shared by all pages.
+const b64u = {
+  enc(buf) {
+    let s = '';
+    for (const b of new Uint8Array(buf)) s += String.fromCharCode(b);
+    return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  },
+  dec(str) {
+    const pad = '='.repeat((4 - (str.length % 4)) % 4);
+    const bin = atob(str.replace(/-/g, '+').replace(/_/g, '/') + pad);
+    return Uint8Array.from(bin, (c) => c.charCodeAt(0)).buffer;
+  },
+};
+
+async function api(method, url, body) {
+  const res = await fetch(url, {
+    method,
+    headers: body ? { 'Content-Type': 'application/json' } : {},
+    body: body ? JSON.stringify(body) : undefined,
+    credentials: 'same-origin',
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) {
+    const err = new Error(data.error || `Request failed (${res.status})`);
+    err.code = data.code;
+    throw err;
+  }
+  return data;
+}
+
+const passkeysSupported = () => !!(window.PublicKeyCredential && navigator.credentials);
+
+// Turn browser WebAuthn errors into friendly messages (null = user cancelled).
+function friendlyError(e) {
+  if (e && (e.name === 'NotAllowedError' || e.name === 'AbortError')) return null;
+  if (e && e.name === 'InvalidStateError') return 'This passkey is already registered on this device.';
+  return e.message || 'Something went wrong.';
+}
+
+async function createPasskey(optionsUrl, optionsBody, verifyBody) {
+  const o = await api('POST', optionsUrl, optionsBody);
+  const cred = await navigator.credentials.create({
+    publicKey: {
+      ...o,
+      challenge: b64u.dec(o.challenge),
+      user: { ...o.user, id: b64u.dec(o.user.id) },
+      excludeCredentials: o.excludeCredentials.map((c) => ({ ...c, id: b64u.dec(c.id) })),
+    },
+  });
+  return api('POST', '/api/register/verify', {
+    ...verifyBody,
+    credential: {
+      id: cred.id,
+      rawId: b64u.enc(cred.rawId),
+      type: cred.type,
+      response: {
+        clientDataJSON: b64u.enc(cred.response.clientDataJSON),
+        attestationObject: b64u.enc(cred.response.attestationObject),
+      },
+    },
+  });
+}
+
+async function getAssertion(optionsUrl, verifyUrl) {
+  const o = await api('POST', optionsUrl, {});
+  const cred = await navigator.credentials.get({
+    publicKey: {
+      ...o,
+      challenge: b64u.dec(o.challenge),
+      allowCredentials: o.allowCredentials.map((c) => ({ ...c, id: b64u.dec(c.id) })),
+    },
+  });
+  const r = cred.response;
+  return api('POST', verifyUrl, {
+    credential: {
+      id: cred.id,
+      rawId: b64u.enc(cred.rawId),
+      type: cred.type,
+      response: {
+        clientDataJSON: b64u.enc(r.clientDataJSON),
+        authenticatorData: b64u.enc(r.authenticatorData),
+        signature: b64u.enc(r.signature),
+        userHandle: r.userHandle ? b64u.enc(r.userHandle) : null,
+      },
+    },
+  });
+}
+
+const Passkeys = {
+  signUp: (username, name) => createPasskey('/api/register/options', { username }, { name }),
+  addPasskey: (name) => createPasskey('/api/register/options', {}, { name }),
+  signIn: () => getAssertion('/api/login/options', '/api/login/verify'),
+  reauthenticate: () => getAssertion('/api/reauth/options', '/api/reauth/verify'),
+  // Run an action that needs a recent passkey check; prompts once and retries if required.
+  async withReauth(action) {
+    try {
+      return await action();
+    } catch (e) {
+      if (e.code !== 'reauth_required') throw e;
+      await Passkeys.reauthenticate();
+      return action();
+    }
+  },
+};
+
+// Swap the nav's Logout link for Sign in when nobody is signed in.
+(async function updateNav() {
+  const link = document.querySelector('.logout-link');
+  if (!link) return;
+  try {
+    const { user } = await api('GET', '/api/me');
+    if (!user) {
+      link.textContent = 'Sign in';
+      link.href = '/login';
+    }
+  } catch { /* leave as is */ }
+})();
