index 0000000..d70da0e
--- /dev/null
+++ b/webauthn.js
@@ -0,0 +1,166 @@
+// Minimal WebAuthn relying-party helpers built on node:crypto (no dependencies).
+// Supports "none"-style registration (attestation statements are not verified)
+// and ES256 / RS256 / EdDSA assertions.
+const crypto = require('node:crypto');
+
+const b64u = {
+  enc: (buf) => Buffer.from(buf).toString('base64url'),
+  dec: (str) => Buffer.from(String(str), 'base64url'),
+};
+
+const sha256 = (data) => crypto.createHash('sha256').update(data).digest();
+
+// ---- CBOR (subset needed for attestation objects and COSE keys) ----
+function cborDecode(buf, offset = 0, depth = 0) {
+  if (depth > 16) throw new Error('CBOR nesting too deep');
+  if (offset >= buf.length) throw new Error('CBOR truncated');
+  const initial = buf[offset++];
+  const major = initial >> 5;
+  const info = initial & 0x1f;
+  let len;
+  if (info < 24) len = info;
+  else if (info === 24) { len = buf.readUInt8(offset); offset += 1; }
+  else if (info === 25) { len = buf.readUInt16BE(offset); offset += 2; }
+  else if (info === 26) { len = buf.readUInt32BE(offset); offset += 4; }
+  else throw new Error('Unsupported CBOR length');
+
+  switch (major) {
+    case 0: return [len, offset];
+    case 1: return [-1 - len, offset];
+    case 2:
+    case 3: {
+      if (offset + len > buf.length) throw new Error('CBOR truncated');
+      const slice = buf.subarray(offset, offset + len);
+      return [major === 2 ? Buffer.from(slice) : slice.toString('utf8'), offset + len];
+    }
+    case 4: {
+      const arr = [];
+      for (let i = 0; i < len; i++) {
+        let v;
+        [v, offset] = cborDecode(buf, offset, depth + 1);
+        arr.push(v);
+      }
+      return [arr, offset];
+    }
+    case 5: {
+      const map = new Map();
+      for (let i = 0; i < len; i++) {
+        let k, v;
+        [k, offset] = cborDecode(buf, offset, depth + 1);
+        [v, offset] = cborDecode(buf, offset, depth + 1);
+        map.set(k, v);
+      }
+      return [map, offset];
+    }
+    default:
+      throw new Error('Unsupported CBOR type');
+  }
+}
+
+// ---- COSE public key -> SPKI DER ----
+function coseToPublicKey(cose) {
+  const kty = cose.get(1);
+  const alg = cose.get(3);
+  let jwk;
+  if (kty === 2 && alg === -7 && cose.get(-1) === 1) {
+    jwk = { kty: 'EC', crv: 'P-256', x: b64u.enc(cose.get(-2)), y: b64u.enc(cose.get(-3)) };
+  } else if (kty === 3 && alg === -257) {
+    jwk = { kty: 'RSA', n: b64u.enc(cose.get(-1)), e: b64u.enc(cose.get(-2)) };
+  } else if (kty === 1 && alg === -8 && cose.get(-1) === 6) {
+    jwk = { kty: 'OKP', crv: 'Ed25519', x: b64u.enc(cose.get(-2)) };
+  } else {
+    throw new Error('Unsupported credential public key algorithm');
+  }
+  const key = crypto.createPublicKey({ key: jwk, format: 'jwk' });
+  return { alg, spki: key.export({ type: 'spki', format: 'der' }) };
+}
+
+function verifySignature(spki, alg, data, signature) {
+  const key = crypto.createPublicKey({ key: spki, format: 'der', type: 'spki' });
+  if (alg === -8) return crypto.verify(null, data, key, signature);
+  return crypto.verify('sha256', data, key, signature); // ES256 (DER) and RS256 (PKCS#1 v1.5)
+}
+
+// ---- shared checks ----
+function parseClientData(clientDataB64, expected) {
+  const raw = b64u.dec(clientDataB64);
+  const data = JSON.parse(raw.toString('utf8'));
+  if (data.type !== expected.type) throw new Error('Unexpected clientData type');
+  if (typeof data.challenge !== 'string' || !timingSafeEqualStr(data.challenge, expected.challenge)) {
+    throw new Error('Challenge mismatch');
+  }
+  if (!expected.origins.includes(data.origin)) throw new Error('Origin mismatch');
+  if (data.crossOrigin === true) throw new Error('Cross-origin requests are not allowed');
+  return raw;
+}
+
+function timingSafeEqualStr(a, b) {
+  const x = Buffer.from(a);
+  const y = Buffer.from(b);
+  return x.length === y.length && crypto.timingSafeEqual(x, y);
+}
+
+function parseAuthData(authData, rpId) {
+  if (authData.length < 37) throw new Error('authData too short');
+  if (!authData.subarray(0, 32).equals(sha256(rpId))) throw new Error('RP ID hash mismatch');
+  const flags = authData[32];
+  return {
+    flags,
+    userPresent: !!(flags & 0x01),
+    userVerified: !!(flags & 0x04),
+    backupEligible: !!(flags & 0x08),
+    backedUp: !!(flags & 0x10),
+    hasAttested: !!(flags & 0x40),
+    counter: authData.readUInt32BE(33),
+  };
+}
+
+// ---- registration ----
+function verifyRegistration({ credential, challenge, origins, rpId }) {
+  parseClientData(credential.response.clientDataJSON, { type: 'webauthn.create', challenge, origins });
+  const [att] = cborDecode(b64u.dec(credential.response.attestationObject));
+  const authData = att.get('authData');
+  if (!Buffer.isBuffer(authData)) throw new Error('Missing authData');
+  const info = parseAuthData(authData, rpId);
+  if (!info.userPresent || !info.userVerified) throw new Error('User verification required');
+  if (!info.hasAttested) throw new Error('No attested credential data');
+
+  let o = 37;
+  const aaguid = authData.subarray(o, o + 16); o += 16;
+  const idLen = authData.readUInt16BE(o); o += 2;
+  const credentialId = authData.subarray(o, o + idLen); o += idLen;
+  if (idLen < 16 || idLen > 1023 || credentialId.length !== idLen) throw new Error('Bad credential id');
+  const [cose] = cborDecode(authData, o);
+  const { alg, spki } = coseToPublicKey(cose);
+
+  if (!b64u.dec(credential.rawId).equals(credentialId)) throw new Error('Credential id mismatch');
+  return {
+    id: b64u.enc(credentialId),
+    publicKey: b64u.enc(spki),
+    alg,
+    counter: info.counter,
+    aaguid: aaguid.toString('hex'),
+    backupEligible: info.backupEligible,
+    backedUp: info.backedUp,
+  };
+}
+
+// ---- assertion ----
+function verifyAssertion({ credential, stored, challenge, origins, rpId }) {
+  const clientData = parseClientData(credential.response.clientDataJSON, { type: 'webauthn.get', challenge, origins });
+  const authData = b64u.dec(credential.response.authenticatorData);
+  const info = parseAuthData(authData, rpId);
+  if (!info.userPresent || !info.userVerified) throw new Error('User verification required');
+
+  const signed = Buffer.concat([authData, sha256(clientData)]);
+  const ok = verifySignature(b64u.dec(stored.publicKey), stored.alg, signed, b64u.dec(credential.response.signature));
+  if (!ok) throw new Error('Invalid signature');
+
+  // Cloned-authenticator detection (counters of 0 mean "not supported").
+  if ((info.counter !== 0 || stored.counter !== 0) && info.counter <= stored.counter) {
+    throw new Error('Signature counter did not increase');
+  }
+  return { counter: info.counter, backedUp: info.backedUp };
+}
+
+module.exports = { b64u, verifyRegistration, verifyAssertion };
