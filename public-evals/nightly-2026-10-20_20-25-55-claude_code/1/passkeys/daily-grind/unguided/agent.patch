+// The Daily Grind: static site + passkey (WebAuthn) API. No dependencies.
+//
+// Config (env): PORT (11222), RP_ID (localhost), ORIGIN (http://localhost:PORT),
+// RP_NAME, DATA_FILE (data/db.json).
+const http = require('node:http');
+const fs = require('node:fs');
+const path = require('node:path');
+const crypto = require('node:crypto');
+const { b64u, verifyRegistration, verifyAssertion } = require('./webauthn');
+
+const PORT = Number(process.env.PORT) || 11222;
+const RP_ID = process.env.RP_ID || 'localhost';
+const RP_NAME = process.env.RP_NAME || 'The Daily Grind';
+const ORIGIN = process.env.ORIGIN || `http://localhost:${PORT}`;
+const DATA_FILE = process.env.DATA_FILE || path.join(__dirname, 'data', 'db.json');
+
+const CHALLENGE_TTL = 5 * 60 * 1000;
+const SESSION_TTL = 7 * 24 * 60 * 60 * 1000;
+const REAUTH_WINDOW = 5 * 60 * 1000; // how long a passkey check counts as "recent"
+const MAX_PASSKEYS = 20;
+
+// ---- storage ----
+let db = { users: {} }; // users[id] = { id, username, handle, createdAt, credentials: [...] }
+try { db = JSON.parse(fs.readFileSync(DATA_FILE, 'utf8')); } catch { /* first run */ }
+
+function saveDb() {
+  fs.mkdirSync(path.dirname(DATA_FILE), { recursive: true });
+  const tmp = `${DATA_FILE}.${process.pid}.tmp`;
+  fs.writeFileSync(tmp, JSON.stringify(db, null, 2), { mode: 0o600 });
+  fs.renameSync(tmp, DATA_FILE);
+}
+
+const findByUsername = (name) =>
+  Object.values(db.users).find((u) => u.username.toLowerCase() === name.toLowerCase());
+
+function findCredential(id) {
+  for (const user of Object.values(db.users)) {
+    const credential = user.credentials.find((c) => c.id === id);
+    if (credential) return { user, credential };
+  }
+  return null;
+}
+
+// ---- sessions ----
+const sessions = new Map(); // sid -> { userId, reauthAt, challenge, expires }
+
+function getSession(req) {
+  const m = /(?:^|;\s*)sid=([\w-]+)/.exec(req.headers.cookie || '');
+  const s = m && sessions.get(m[1]);
+  if (!s) return null;
+  if (s.expires < Date.now()) { sessions.delete(m[1]); return null; }
+  s.sid = m[1];
+  return s;
+}
+
+function startSession(res, userId = null) {
+  const sid = crypto.randomBytes(32).toString('base64url');
+  const s = { sid, userId, reauthAt: 0, challenge: null, expires: Date.now() + SESSION_TTL };
+  sessions.set(sid, s);
+  const secure = ORIGIN.startsWith('https:') ? '; Secure' : '';
+  res.setHeader('Set-Cookie',
+    `sid=${sid}; HttpOnly; SameSite=Strict; Path=/; Max-Age=${SESSION_TTL / 1000}${secure}`);
+  return s;
+}
+
+function endSession(req, res) {
+  const s = getSession(req);
+  if (s) sessions.delete(s.sid);
+  res.setHeader('Set-Cookie', 'sid=; HttpOnly; SameSite=Strict; Path=/; Max-Age=0');
+}
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [sid, s] of sessions) if (s.expires < now) sessions.delete(sid);
+}, 60 * 1000).unref();
+
+// ---- helpers ----
+class HttpError extends Error {
+  constructor(status, message, code) { super(message); this.status = status; this.code = code; }
+}
+
+function send(res, status, body, headers = {}) {
+  const json = typeof body !== 'string';
+  res.writeHead(status, {
+    'Content-Type': json ? 'application/json' : 'text/plain; charset=utf-8',
+    'Cache-Control': 'no-store',
+    ...headers,
+  });
+  res.end(json ? JSON.stringify(body) : body);
+}
+
+function readJson(req) {
+  return new Promise((resolve, reject) => {
+    if (!/^application\/json/i.test(req.headers['content-type'] || '')) {
+      return reject(new HttpError(415, 'Expected application/json'));
+    }
+    let size = 0;
+    const chunks = [];
+    req.on('data', (c) => {
+      size += c.length;
+      if (size > 64 * 1024) { reject(new HttpError(413, 'Body too large')); req.destroy(); }
+      else chunks.push(c);
+    });
+    req.on('end', () => {
+      try { resolve(JSON.parse(Buffer.concat(chunks).toString('utf8') || '{}')); }
+      catch { reject(new HttpError(400, 'Invalid JSON')); }
+    });
+    req.on('error', reject);
+  });
+}
+
+function requireUser(req) {
+  const s = getSession(req);
+  const user = s && s.userId && db.users[s.userId];
+  if (!user) throw new HttpError(401, 'Sign in required', 'login_required');
+  return { s, user };
+}
+
+function requireRecentAuth(s) {
+  if (Date.now() - s.reauthAt > REAUTH_WINDOW) {
+    throw new HttpError(401, 'Please verify with your passkey to continue', 'reauth_required');
+  }
+}
+
+function newChallenge(s, purpose, extra = {}) {
+  const value = crypto.randomBytes(32).toString('base64url');
+  s.challenge = { value, purpose, expires: Date.now() + CHALLENGE_TTL, ...extra };
+  return value;
+}
+
+// Challenges are single use: consumed whether or not verification succeeds.
+function takeChallenge(s, purpose) {
+  const c = s && s.challenge;
+  if (s) s.challenge = null;
+  if (!c || c.purpose !== purpose || c.expires < Date.now()) {
+    throw new HttpError(400, 'Challenge expired, please try again');
+  }
+  return c;
+}
+
+function anonOrCurrentSession(req, res) {
+  return getSession(req) || startSession(res);
+}
+
+function validCredentialShape(c) {
+  return c && typeof c.id === 'string' && typeof c.rawId === 'string' && c.response &&
+    typeof c.response.clientDataJSON === 'string';
+}
+
+const publicCredential = (c) => ({
+  id: c.id, name: c.name, createdAt: c.createdAt, lastUsedAt: c.lastUsedAt,
+  backedUp: c.backedUp, backupEligible: c.backupEligible,
+});
+
+const publicUser = (u) => ({ id: u.id, username: u.username });
+
+// ---- API ----
+const routes = {};
+const route = (method, pattern, handler) => (routes[method] ||= []).push({ pattern, handler });
+
+route('GET', /^\/api\/me$/, (req, res) => {
+  const s = getSession(req);
+  const user = s && s.userId && db.users[s.userId];
+  if (!user) return send(res, 200, { user: null });
+  const recentlyVerified = Date.now() - s.reauthAt <= REAUTH_WINDOW;
+  send(res, 200, {
+    user: publicUser(user),
+    recentlyVerified,
+    verifiedUntil: recentlyVerified ? s.reauthAt + REAUTH_WINDOW : null,
+  });
+});
+
+route('POST', /^\/api\/logout$/, (req, res) => {
+  endSession(req, res);
+  send(res, 200, { ok: true });
+});
+
+// Registration: creates a new account (signed out) or adds a passkey (signed in).
+route('POST', /^\/api\/register\/options$/, async (req, res) => {
+  const body = await readJson(req);
+  const s = anonOrCurrentSession(req, res);
+  let user;
+  let pending = null;
+
+  if (s.userId && db.users[s.userId]) {
+    user = db.users[s.userId];
+    requireRecentAuth(s);
+    if (user.credentials.length >= MAX_PASSKEYS) throw new HttpError(400, 'Passkey limit reached');
+  } else {
+    const username = String(body.username || '').trim();
+    if (!/^[A-Za-z0-9_.-]{3,32}$/.test(username)) {
+      throw new HttpError(400, 'Username must be 3-32 characters: letters, numbers, ".", "_" or "-"');
+    }
+    if (findByUsername(username)) throw new HttpError(409, 'That username is taken');
+    pending = { username, handle: crypto.randomBytes(32).toString('base64url') };
+    user = { username, handle: pending.handle, credentials: [] };
+  }
+
+  const challenge = newChallenge(s, 'register', { pending });
+  send(res, 200, {
+    rp: { id: RP_ID, name: RP_NAME },
+    user: { id: user.handle, name: user.username, displayName: user.username },
+    challenge,
+    pubKeyCredParams: [{ type: 'public-key', alg: -7 }, { type: 'public-key', alg: -8 }, { type: 'public-key', alg: -257 }],
+    timeout: 120000,
+    attestation: 'none',
+    excludeCredentials: user.credentials.map((c) => ({ type: 'public-key', id: c.id })),
+    authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'required' },
+  });
+});
+
+route('POST', /^\/api\/register\/verify$/, async (req, res) => {
+  const body = await readJson(req);
+  const s = getSession(req);
+  const ch = takeChallenge(s, 'register');
+  if (!validCredentialShape(body.credential)) throw new HttpError(400, 'Malformed credential');
+
+  let result;
+  try {
+    result = verifyRegistration({
+      credential: body.credential, challenge: ch.value, origins: [ORIGIN], rpId: RP_ID,
+    });
+  } catch (e) {
+    throw new HttpError(400, `Passkey registration failed: ${e.message}`);
+  }
+  if (findCredential(result.id)) throw new HttpError(409, 'That passkey is already registered');
+
+  const name = String(body.name || '').trim().slice(0, 50) || 'Passkey';
+  const now = Date.now();
+  const credential = {
+    id: result.id, publicKey: result.publicKey, alg: result.alg, counter: result.counter,
+    aaguid: result.aaguid, backupEligible: result.backupEligible, backedUp: result.backedUp,
+    name, createdAt: now, lastUsedAt: null,
+  };
+
+  let user;
+  if (ch.pending) {
+    if (findByUsername(ch.pending.username)) throw new HttpError(409, 'That username is taken');
+    user = {
+      id: crypto.randomUUID(), username: ch.pending.username, handle: ch.pending.handle,
+      createdAt: now, credentials: [credential],
+    };
+    db.users[user.id] = user;
+    saveDb();
+    // New session on privilege change; registering just proved passkey possession.
+    sessions.delete(s.sid);
+    const fresh = startSession(res, user.id);
+    fresh.reauthAt = now;
+  } else {
+    const { user: current } = requireUser(req);
+    requireRecentAuth(s);
+    user = current;
+    if (user.credentials.length >= MAX_PASSKEYS) throw new HttpError(400, 'Passkey limit reached');
+    user.credentials.push(credential);
+    saveDb();
+  }
+  send(res, 200, { user: publicUser(user), passkey: publicCredential(credential) });
+});
+
+// Authentication: usernameless, using discoverable credentials.
+route('POST', /^\/api\/login\/options$/, async (req, res) => {
+  const s = anonOrCurrentSession(req, res);
+  const challenge = newChallenge(s, 'login');
+  send(res, 200, { challenge, rpId: RP_ID, timeout: 120000, userVerification: 'required', allowCredentials: [] });
+});
+
+route('POST', /^\/api\/login\/verify$/, async (req, res) => {
+  const body = await readJson(req);
+  const s = getSession(req);
+  const ch = takeChallenge(s, 'login');
+  const found = validCredentialShape(body.credential) && findCredential(body.credential.id);
+  if (!found) throw new HttpError(401, 'Passkey not recognized');
+  const { user, credential } = found;
+  assertUserHandle(body.credential, user);
+
+  try {
+    const r = verifyAssertion({
+      credential: { ...body.credential, response: body.credential.response },
+      stored: credential, challenge: ch.value, origins: [ORIGIN], rpId: RP_ID,
+    });
+    credential.counter = r.counter;
+    credential.backedUp = r.backedUp;
+  } catch (e) {
+    throw new HttpError(401, `Sign-in failed: ${e.message}`);
+  }
+  credential.lastUsedAt = Date.now();
+  saveDb();
+
+  sessions.delete(s.sid);
+  const fresh = startSession(res, user.id);
+  fresh.reauthAt = Date.now();
+  send(res, 200, { user: publicUser(user) });
+});
+
+function assertUserHandle(credential, user) {
+  const handle = credential.response.userHandle;
+  if (handle && handle !== user.handle) throw new HttpError(401, 'Passkey does not match account');
+}
+
+// Reauthentication: signed-in user proves possession of one of their own passkeys.
+route('POST', /^\/api\/reauth\/options$/, async (req, res) => {
+  const { s, user } = requireUser(req);
+  const challenge = newChallenge(s, 'reauth');
+  send(res, 200, {
+    challenge, rpId: RP_ID, timeout: 120000, userVerification: 'required',
+    allowCredentials: user.credentials.map((c) => ({ type: 'public-key', id: c.id })),
+  });
+});
+
+route('POST', /^\/api\/reauth\/verify$/, async (req, res) => {
+  const body = await readJson(req);
+  const { s, user } = requireUser(req);
+  const ch = takeChallenge(s, 'reauth');
+  if (!validCredentialShape(body.credential)) throw new HttpError(400, 'Malformed credential');
+  const credential = user.credentials.find((c) => c.id === body.credential.id);
+  if (!credential) throw new HttpError(401, 'Passkey does not belong to this account');
+  assertUserHandle(body.credential, user);
+
+  try {
+    const r = verifyAssertion({
+      credential: body.credential, stored: credential, challenge: ch.value, origins: [ORIGIN], rpId: RP_ID,
+    });
+    credential.counter = r.counter;
+    credential.backedUp = r.backedUp;
+  } catch (e) {
+    throw new HttpError(401, `Verification failed: ${e.message}`);
+  }
+  credential.lastUsedAt = Date.now();
+  saveDb();
+  s.reauthAt = Date.now();
+  send(res, 200, { verifiedUntil: s.reauthAt + REAUTH_WINDOW });
+});
+
+// Management
+route('GET', /^\/api\/passkeys$/, (req, res) => {
+  const { user } = requireUser(req);
+  send(res, 200, { passkeys: user.credentials.map(publicCredential) });
+});
+
+route('PATCH', /^\/api\/passkeys\/([\w-]+)$/, async (req, res, [id]) => {
+  const body = await readJson(req);
+  const { user } = requireUser(req);
+  const credential = user.credentials.find((c) => c.id === id);
+  if (!credential) throw new HttpError(404, 'Passkey not found');
+  const name = String(body.name || '').trim().slice(0, 50);
+  if (!name) throw new HttpError(400, 'Name is required');
+  credential.name = name;
+  saveDb();
+  send(res, 200, { passkey: publicCredential(credential) });
+});
+
+route('DELETE', /^\/api\/passkeys\/([\w-]+)$/, (req, res, [id]) => {
+  const { s, user } = requireUser(req);
+  requireRecentAuth(s);
+  const index = user.credentials.findIndex((c) => c.id === id);
+  if (index < 0) throw new HttpError(404, 'Passkey not found');
+  if (user.credentials.length === 1) {
+    throw new HttpError(400, 'You cannot remove your only passkey, or you would be locked out');
+  }
+  user.credentials.splice(index, 1);
+  saveDb();
+  send(res, 200, { ok: true });
+});
+
+// ---- static files ----
+const PAGES = {
+  '/': 'index.html',
+  '/login': 'login.html',
+  '/account': 'account.html',
+  '/auth.js': 'auth.js',
+  '/auth.css': 'auth.css',
+};
+const TYPES = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript; charset=utf-8', '.css': 'text/css; charset=utf-8' };
+
+function serveStatic(req, res, pathname) {
+  const file = PAGES[pathname];
+  if (!file) return send(res, 404, 'Not found');
+  fs.readFile(path.join(__dirname, file), (err, data) => {
+    if (err) return send(res, 404, 'Not found');
+    res.writeHead(200, { 'Content-Type': TYPES[path.extname(file)], 'Cache-Control': 'no-cache' });
+    res.end(req.method === 'HEAD' ? undefined : data);
+  });
+}
+
+// ---- server ----
+const server = http.createServer(async (req, res) => {
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('X-Frame-Options', 'DENY');
+  res.setHeader('Referrer-Policy', 'same-origin');
+  try {
+    const { pathname } = new URL(req.url, ORIGIN);
+
+    if (pathname === '/logout') {
+      endSession(req, res);
+      res.writeHead(302, { Location: '/', 'Set-Cookie': res.getHeader('Set-Cookie') });
+      return res.end();
+    }
+
+    if (pathname.startsWith('/api/')) {
+      if (req.method !== 'GET' && req.headers.origin !== ORIGIN) {
+        throw new HttpError(403, 'Bad origin');
+      }
+      for (const { pattern, handler } of routes[req.method] || []) {
+        const m = pattern.exec(pathname);
+        if (m) return await handler(req, res, m.slice(1));
+      }
+      throw new HttpError(404, 'Not found');
+    }
+
+    if (req.method !== 'GET' && req.method !== 'HEAD') throw new HttpError(405, 'Method not allowed');
+    serveStatic(req, res, pathname);
+  } catch (e) {
+    if (!(e instanceof HttpError)) console.error(e);
+    if (res.headersSent) return res.end();
+    const status = e instanceof HttpError ? e.status : 500;
+    send(res, status, { error: e instanceof HttpError ? e.message : 'Server error', code: e.code });
+  }
+});
+
+server.listen(PORT, () => console.log(`The Daily Grind on ${ORIGIN} (rpId=${RP_ID})`));
