+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Sign in | The Daily Grind</title>
+  <link rel="stylesheet" href="/auth.css">
+</head>
+<body>
+  <nav>
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <ul><li><a href="/">Home</a></li></ul>
+  </nav>
+
+  <main>
+    <h1>Welcome back</h1>
+    <p class="lead">Sign in with a passkey: your fingerprint, face, or device PIN. No password needed.</p>
+
+    <p id="unsupported" class="status error" hidden>This browser doesn't support passkeys.</p>
+
+    <section class="panel">
+      <h2>Sign in</h2>
+      <button id="signin" type="button">Sign in with a passkey</button>
+      <p id="signin-status" class="status" role="status"></p>
+    </section>
+
+    <section class="panel">
+      <h2>New here? Create an account</h2>
+      <form id="signup" autocomplete="off">
+        <label for="username">Choose a username</label>
+        <input id="username" type="text" required minlength="3" maxlength="32"
+               pattern="[A-Za-z0-9_.\-]{3,32}" autocapitalize="none" spellcheck="false">
+        <button type="submit">Create account with a passkey</button>
+      </form>
+      <p id="signup-status" class="status" role="status"></p>
+    </section>
+  </main>
+
+  <script src="/auth.js"></script>
+  <script>
+    const $ = (id) => document.getElementById(id);
+    const say = (id, msg, kind = '') => { $(id).textContent = msg || ''; $(id).className = `status ${kind}`; };
+
+    if (!passkeysSupported()) {
+      $('unsupported').hidden = false;
+      document.querySelectorAll('button').forEach((b) => (b.disabled = true));
+    }
+
+    api('GET', '/api/me').then(({ user }) => { if (user) location.replace('/account'); }).catch(() => {});
+
+    $('signin').addEventListener('click', async () => {
+      $('signin').disabled = true;
+      say('signin-status', 'Waiting for your passkey…');
+      try {
+        await Passkeys.signIn();
+        location.href = '/account';
+      } catch (e) {
+        say('signin-status', friendlyError(e) || 'Sign-in cancelled.', friendlyError(e) ? 'error' : '');
+        $('signin').disabled = false;
+      }
+    });
+
+    $('signup').addEventListener('submit', async (ev) => {
+      ev.preventDefault();
+      const btn = ev.submitter;
+      btn.disabled = true;
+      say('signup-status', 'Follow your device prompt to create a passkey…');
+      try {
+        await Passkeys.signUp($('username').value.trim(), 'My first passkey');
+        location.href = '/account';
+      } catch (e) {
+        say('signup-status', friendlyError(e) || 'Passkey creation cancelled.', friendlyError(e) ? 'error' : '');
+        btn.disabled = false;
+      }
+    });
+  </script>
+</body>
+</html>
