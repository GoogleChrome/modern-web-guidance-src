+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Sign in | The Daily Grind</title>
+  <link rel="stylesheet" href="/css/site.css">
+</head>
+<body>
+  <nav>
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/account">My Account</a></li>
+    </ul>
+  </nav>
+
+  <main class="container">
+    <section class="panel">
+      <h1 id="title">Sign in</h1>
+      <p class="muted" id="subtitle">Welcome back. Use a passkey or your password.</p>
+
+      <form id="auth-form">
+        <label id="display-name-label" hidden>
+          Display name
+          <input type="text" name="displayName" autocomplete="name">
+        </label>
+        <label>
+          Username
+          <input type="text" name="username" autocomplete="username webauthn" autocapitalize="none" spellcheck="false" required autofocus>
+        </label>
+        <label>
+          Password
+          <input type="password" name="password" autocomplete="current-password" minlength="8" required>
+        </label>
+        <button class="btn" type="submit" id="submit-btn">Sign in</button>
+      </form>
+
+      <div id="passkey-section" hidden>
+        <p class="divider">or</p>
+        <button class="btn secondary" type="button" id="passkey-btn">Sign in with a passkey</button>
+      </div>
+
+      <p class="message error" id="error" role="alert"></p>
+      <p class="muted" style="margin-top:16px">
+        <span id="toggle-text">New here?</span>
+        <button class="btn secondary small" type="button" id="toggle-btn">Create an account</button>
+      </p>
+    </section>
+  </main>
+
+  <footer>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</footer>
+  <script type="module" src="/js/login.js"></script>
+</body>
+</html>
diff --git a/server.js b/server.js
