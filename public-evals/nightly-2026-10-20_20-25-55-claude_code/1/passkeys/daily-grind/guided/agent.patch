+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+  --danger: #b71c1c;
+}
+
+* { box-sizing: border-box; margin: 0; padding: 0; }
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+.logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; color: white; text-decoration: none; }
+nav ul { display: flex; list-style: none; }
+nav ul li { margin-left: 20px; }
+nav a { color: white; text-decoration: none; font-size: 0.9rem; transition: color 0.3s; }
+nav a:hover { color: var(--accent); }
+.logout-link { border: 1px solid var(--accent); padding: 5px 12px; border-radius: 4px; }
+
+.container { max-width: 720px; margin: 40px auto; padding: 0 20px; }
+h1 { color: var(--primary); margin-bottom: 0.5rem; }
+h2 { color: var(--primary); font-size: 1.25rem; margin-bottom: 0.25rem; }
+.muted { color: #6d4c41; font-size: 0.9rem; }
+
+.panel {
+  background: white;
+  padding: 24px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  margin-top: 24px;
+}
+
+form { display: grid; gap: 14px; margin-top: 16px; }
+label { display: grid; gap: 4px; font-size: 0.9rem; font-weight: 600; }
+input[type='text'], input[type='password'] {
+  font: inherit;
+  padding: 10px 12px;
+  border: 1px solid var(--secondary);
+  border-radius: 5px;
+  background: white;
+  color: var(--text);
+}
+input:focus-visible, button:focus-visible, a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
+
+.btn {
+  font: inherit;
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  border: 0;
+  border-radius: 5px;
+  cursor: pointer;
+  text-decoration: none;
+  transition: background 0.3s;
+}
+.btn:hover:not(:disabled) { background: #3e2723; }
+.btn:disabled { opacity: 0.5; cursor: not-allowed; }
+.btn.secondary { background: transparent; color: var(--primary); border: 1px solid var(--primary); }
+.btn.secondary:hover:not(:disabled) { background: var(--secondary); }
+.btn.danger { background: transparent; color: var(--danger); border: 1px solid var(--danger); }
+.btn.small { padding: 4px 12px; font-size: 0.85rem; }
+
+.row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
+.divider { text-align: center; color: #6d4c41; font-size: 0.85rem; margin: 18px 0 2px; }
+
+.message { margin-top: 12px; padding: 10px 12px; border-radius: 5px; background: #fff3e0; }
+.message.error { background: #ffebee; color: var(--danger); }
+.message:empty { display: none; }
+
+.passkey-list { list-style: none; margin-top: 16px; display: grid; gap: 12px; }
+.passkey {
+  display: grid;
+  grid-template-columns: 40px 1fr auto;
+  gap: 12px;
+  align-items: center;
+  padding: 12px;
+  border: 1px solid var(--secondary);
+  border-radius: 8px;
+}
+.passkey img, .passkey .icon-fallback { width: 32px; height: 32px; }
+.passkey .icon-fallback { display: grid; place-items: center; background: var(--secondary); border-radius: 50%; }
+.passkey strong { display: block; }
+
+dialog { margin: auto; border: 0; border-radius: 8px; padding: 24px; width: min(420px, 92vw); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3); }
+dialog::backdrop { background: rgba(0, 0, 0, 0.5); }
+dialog form { margin-top: 12px; }
+
+footer { background: var(--secondary); text-align: center; padding: 30px 20px; margin-top: 40px; font-size: 0.85rem; }
