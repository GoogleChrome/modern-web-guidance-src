index 0000000..469b95b
--- /dev/null
+++ b/server.js
@@ -0,0 +1,604 @@
+import http from 'node:http';
+import crypto from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from '@simplewebauthn/server';
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const PUBLIC = path.join(ROOT, 'public');
+const POLYFILLS = path.join(ROOT, 'node_modules/webauthn-polyfills/esm');
+const DB_FILE = path.join(ROOT, 'data/db.json');
+const AAGUID_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+
+const PORT = Number(process.env.PORT) || 11222;
+// The RP ID is a fixed constant per deployment, never derived from the request.
+const RP_ID = process.env.RP_ID || 'localhost';
+const ORIGIN = process.env.ORIGIN || `http://localhost:${PORT}`;
+const RP_NAME = 'The Daily Grind';
+const SESSION_TTL = 7 * 24 * 3600 * 1000;
+const REAUTH_TTL = Number(process.env.REAUTH_TTL_MS) || 5 * 60 * 1000;
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+/* ---------- storage (JSON file) ---------- */
+
+let db = { users: [], credentials: [] };
+try {
+  db = JSON.parse(await fs.readFile(DB_FILE, 'utf8'));
+} catch {}
+
+let saving = Promise.resolve();
+function save() {
+  saving = saving.then(async () => {
+    await fs.mkdir(path.dirname(DB_FILE), { recursive: true });
+    await fs.writeFile(DB_FILE, JSON.stringify(db, null, 2));
+  });
+  return saving;
+}
+
+const userById = (id) => db.users.find((u) => u.id === id);
+const userByName = (name) =>
+  db.users.find((u) => u.name.toLowerCase() === name.toLowerCase());
+const credsOf = (userId) => db.credentials.filter((c) => c.passkeyUserId === userId);
+const credById = (id) => db.credentials.find((c) => c.id === id);
+
+/* ---------- passwords ---------- */
+
+function hashPassword(password) {
+  const salt = crypto.randomBytes(16);
+  const hash = crypto.scryptSync(password, salt, 64);
+  return `${salt.toString('base64')}:${hash.toString('base64')}`;
+}
+
+function checkPassword(password, stored) {
+  const [salt, hash] = stored.split(':').map((s) => Buffer.from(s, 'base64'));
+  const candidate = crypto.scryptSync(password, salt, hash.length);
+  return crypto.timingSafeEqual(candidate, hash);
+}
+
+// Used to keep response timing similar when the username doesn't exist.
+const DUMMY_HASH = hashPassword('dummy-password');
+
+/* ---------- sessions ---------- */
+
+const sessions = new Map();
+const COOKIE = 'sid';
+
+function parseCookies(req) {
+  return Object.fromEntries(
+    (req.headers.cookie || '')
+      .split(';')
+      .map((c) => c.trim().split('='))
+      .filter((p) => p[0]),
+  );
+}
+
+function getSession(req) {
+  const s = sessions.get(parseCookies(req)[COOKIE]);
+  if (s && s.expires < Date.now()) {
+    sessions.delete(s.id);
+    return null;
+  }
+  return s || null;
+}
+
+function startSession(res, userId) {
+  const id = crypto.randomBytes(32).toString('base64url');
+  const s = { id, userId, expires: Date.now() + SESSION_TTL };
+  sessions.set(id, s);
+  setCookie(res, id, SESSION_TTL);
+  return s;
+}
+
+function setCookie(res, value, maxAgeMs) {
+  const secure = ORIGIN.startsWith('https:') ? '; Secure' : '';
+  res.setHeader(
+    'Set-Cookie',
+    `${COOKIE}=${value}; HttpOnly; SameSite=Lax; Path=/; Max-Age=${Math.floor(maxAgeMs / 1000)}${secure}`,
+  );
+}
+
+// Anonymous visitors get a session too, just to hold WebAuthn challenges.
+function ensureSession(req, res) {
+  return getSession(req) || startSession(res, null);
+}
+
+function endSession(req, res) {
+  const s = getSession(req);
+  if (s) sessions.delete(s.id);
+  setCookie(res, '', 0);
+}
+
+/* ---------- helpers ---------- */
+
+class HttpError extends Error {
+  constructor(status, message, code) {
+    super(message);
+    this.status = status;
+    this.code = code;
+  }
+}
+
+const publicUser = (u) => ({
+  id: u.id,
+  name: u.name,
+  displayName: u.displayName,
+});
+
+const publicCred = (c) => ({
+  id: c.id,
+  name: c.name,
+  providerIcon: c.providerIcon,
+  aaguid: c.aaguid,
+  credentialDeviceType: c.credentialDeviceType,
+  credentialBackedUp: c.credentialBackedUp,
+  registeredAt: c.registeredAt,
+  lastUsedAt: c.lastUsedAt,
+});
+
+function requireUser(req) {
+  const s = getSession(req);
+  const user = s?.userId && userById(s.userId);
+  if (!user) throw new HttpError(401, 'Not signed in.');
+  return { s, user };
+}
+
+// Sensitive actions need a recent reauthentication in this session.
+function requireRecentReauth(s) {
+  if (!s.reauthAt || Date.now() - s.reauthAt > REAUTH_TTL) {
+    throw new HttpError(403, 'Please confirm your identity first.', 'reauth_required');
+  }
+}
+
+function takeChallenge(s, key) {
+  const pending = s[key];
+  delete s[key];
+  if (!pending || pending.expires < Date.now()) {
+    throw new HttpError(400, 'Challenge expired. Please try again.');
+  }
+  return pending;
+}
+
+let aaguidRegistry;
+async function lookupProvider(aaguid) {
+  if (!aaguid || aaguid === ZERO_AAGUID) return null;
+  try {
+    aaguidRegistry ??= await fetch(AAGUID_URL, {
+      signal: AbortSignal.timeout(4000),
+    }).then((r) => r.json());
+    return aaguidRegistry[aaguid] || null;
+  } catch {
+    return null; // AAGUID is a UX hint only; never block registration on it
+  }
+}
+
+function deviceName(req) {
+  const ua = req.headers['user-agent'] || '';
+  if (/iPhone|iPad/.test(ua)) return 'iOS device';
+  if (/Android/.test(ua)) return 'Android device';
+  if (/Mac OS X/.test(ua)) return 'Mac';
+  if (/Windows/.test(ua)) return 'Windows PC';
+  if (/Linux/.test(ua)) return 'Linux device';
+  return 'Unknown passkey provider';
+}
+
+const failedLogins = new Map();
+function throttleLogin(req) {
+  const key = req.socket.remoteAddress;
+  const entry = failedLogins.get(key);
+  if (entry && entry.count >= 10 && Date.now() - entry.last < 15 * 60 * 1000) {
+    throw new HttpError(429, 'Too many attempts. Try again later.');
+  }
+}
+function noteLogin(req, ok) {
+  const key = req.socket.remoteAddress;
+  if (ok) return failedLogins.delete(key);
+  const entry = failedLogins.get(key) || { count: 0 };
+  failedLogins.set(key, { count: entry.count + 1, last: Date.now() });
+}
+
+function validPassword(p) {
+  if (typeof p !== 'string' || p.length < 8 || p.length > 200) {
+    throw new HttpError(400, 'Password must be at least 8 characters.');
+  }
+}
+
+function cleanText(v, label, max = 64) {
+  const t = typeof v === 'string' ? v.trim() : '';
+  if (!t || t.length > max) throw new HttpError(400, `${label} is required (max ${max} characters).`);
+  return t;
+}
+
+/* ---------- API routes ---------- */
+
+const routes = [];
+const route = (method, pattern, handler) =>
+  routes.push({ method, regex: new RegExp(`^${pattern}$`), handler });
+
+route('GET', '/api/me', async ({ req }) => {
+  const s = getSession(req);
+  const user = s?.userId && userById(s.userId);
+  return {
+    rpId: RP_ID,
+    user: user ? publicUser(user) : null,
+    passkeyCount: user ? credsOf(user.id).length : 0,
+    reauthValid: !!(s?.reauthAt && Date.now() - s.reauthAt <= REAUTH_TTL),
+  };
+});
+
+route('POST', '/api/signup', async ({ req, res, body }) => {
+  const name = cleanText(body.username, 'Username', 40);
+  const displayName = cleanText(body.displayName || name, 'Display name');
+  validPassword(body.password);
+  if (userByName(name)) throw new HttpError(409, 'That username is taken.');
+  const user = {
+    id: crypto.randomBytes(32).toString('base64url'),
+    name,
+    displayName,
+    passwordHash: hashPassword(body.password),
+  };
+  db.users.push(user);
+  await save();
+  const s = startSession(res, user.id);
+  s.reauthAt = s.passwordSignInAt = Date.now();
+  return { user: publicUser(user), passwordSignIn: true };
+});
+
+route('POST', '/api/login', async ({ req, res, body }) => {
+  throttleLogin(req);
+  const user = typeof body.username === 'string' && userByName(body.username.trim());
+  const ok = checkPassword(String(body.password ?? ''), user ? user.passwordHash : DUMMY_HASH);
+  noteLogin(req, !!user && ok);
+  if (!user || !ok) throw new HttpError(401, 'Incorrect username or password.');
+  const old = getSession(req);
+  if (old) sessions.delete(old.id); // fresh session id on privilege change
+  const s = startSession(res, user.id);
+  s.reauthAt = s.passwordSignInAt = Date.now();
+  return { user: publicUser(user), passwordSignIn: true };
+});
+
+route('POST', '/api/logout', async ({ req, res }) => {
+  endSession(req, res);
+  return { success: true };
+});
+
+/* -- registration -- */
+
+route('POST', '/api/passkeys/register/options', async ({ req, res, body }) => {
+  const { s, user } = requireUser(req);
+  const promotion = body.promotion === true;
+  const conditional = body.conditional === true;
+  if (conditional && !(s.passwordSignInAt > Date.now() - 2 * 60 * 1000)) {
+    throw new HttpError(400, 'Conditional create is only allowed right after a password sign-in.');
+  }
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: RP_ID,
+    userName: user.name,
+    userDisplayName: user.displayName,
+    userID: Buffer.from(user.id, 'base64url'),
+    excludeCredentials: credsOf(user.id).map((c) => ({ id: c.id, transports: c.transports })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      // Management flow omits the attachment so security keys are allowed.
+      ...(promotion || conditional ? { authenticatorAttachment: 'platform' } : {}),
+    },
+    supportedAlgorithmIDs: [-7, -257],
+  });
+  s.registration = {
+    challenge: options.challenge,
+    conditional,
+    expires: Date.now() + 5 * 60 * 1000,
+  };
+  return options;
+});
+
+route('POST', '/api/passkeys/register/verify', async ({ req, body }) => {
+  const { s, user } = requireUser(req);
+  const pending = takeChallenge(s, 'registration');
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: ORIGIN,
+      expectedRPID: RP_ID,
+      requireUserVerification: false, // options asked for "preferred"
+      // UP may only be relaxed for conditional create, decided server-side.
+      requireUserPresence: !pending.conditional,
+    });
+  } catch (e) {
+    throw new HttpError(400, `Registration failed: ${e.message}`);
+  }
+  if (!verification.verified) throw new HttpError(400, 'Registration could not be verified.');
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } =
+    verification.registrationInfo;
+  if (credById(credential.id)) throw new HttpError(409, 'This passkey is already registered.');
+
+  const provider = await lookupProvider(aaguid);
+  const record = {
+    id: credential.id,
+    passkeyUserId: user.id,
+    credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    credentialType: 'public-key',
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    providerIcon: provider?.icon_light,
+    name: provider?.name || deviceName(req),
+    transports: credential.transports || body.response?.transports || [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  };
+  db.credentials.push(record);
+  await save();
+  return publicCred(record);
+});
+
+/* -- authentication -- */
+
+route('POST', '/api/passkeys/login/options', async ({ req, res }) => {
+  const s = ensureSession(req, res);
+  const options = await generateAuthenticationOptions({
+    rpID: RP_ID,
+    allowCredentials: [], // discoverable credentials
+    userVerification: 'preferred',
+  });
+  s.authentication = {
+    challenge: options.challenge,
+    userVerification: 'preferred', // persisted server-side, never taken from the client
+    expires: Date.now() + 5 * 60 * 1000,
+  };
+  return options;
+});
+
+route('POST', '/api/passkeys/login/verify', async ({ req, res, body }) => {
+  const s = getSession(req);
+  if (!s) throw new HttpError(400, 'No sign-in in progress.');
+  const pending = takeChallenge(s, 'authentication');
+  const cred = credById(body.id);
+  if (!cred) throw new HttpError(404, 'Passkey not found.');
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: body,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: ORIGIN,
+      expectedRPID: RP_ID,
+      credential: {
+        id: cred.id,
+        publicKey: Buffer.from(cred.credentialPublicKey, 'base64url'),
+        counter: cred.counter,
+        transports: cred.transports,
+      },
+      requireUserVerification: pending.userVerification === 'required',
+    });
+  } catch (e) {
+    throw new HttpError(400, `Sign-in failed: ${e.message}`);
+  }
+  if (!verification.verified) throw new HttpError(401, 'Sign-in could not be verified.');
+  cred.counter = verification.authenticationInfo.newCounter;
+  cred.lastUsedAt = Date.now();
+  cred.credentialBackedUp = verification.authenticationInfo.credentialBackedUp;
+  await save();
+
+  sessions.delete(s.id);
+  const fresh = startSession(res, cred.passkeyUserId);
+  fresh.reauthAt = Date.now();
+  return { user: publicUser(userById(cred.passkeyUserId)) };
+});
+
+/* -- reauthentication -- */
+
+route('POST', '/api/reauth/options', async ({ req }) => {
+  const { s, user } = requireUser(req);
+  const creds = credsOf(user.id);
+  if (!creds.length) throw new HttpError(400, 'No passkeys registered.');
+  const options = await generateAuthenticationOptions({
+    rpID: RP_ID,
+    // Restricted to the signed-in user's own passkeys.
+    allowCredentials: creds.map((c) => ({ id: c.id, transports: c.transports })),
+    userVerification: 'preferred',
+  });
+  s.reauth = {
+    challenge: options.challenge,
+    userVerification: 'preferred',
+    expires: Date.now() + 5 * 60 * 1000,
+  };
+  return options;
+});
+
+route('POST', '/api/reauth/verify', async ({ req, body }) => {
+  const { s, user } = requireUser(req);
+  const pending = takeChallenge(s, 'reauth');
+  const cred = credById(body.id);
+  if (!cred) throw new HttpError(404, 'Passkey not found.');
+  if (cred.passkeyUserId !== user.id) throw new HttpError(403, 'That passkey belongs to a different account.');
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: body,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: ORIGIN,
+      expectedRPID: RP_ID,
+      credential: {
+        id: cred.id,
+        publicKey: Buffer.from(cred.credentialPublicKey, 'base64url'),
+        counter: cred.counter,
+        transports: cred.transports,
+      },
+      requireUserVerification: pending.userVerification === 'required',
+    });
+  } catch (e) {
+    throw new HttpError(400, `Verification failed: ${e.message}`);
+  }
+  if (!verification.verified) throw new HttpError(401, 'Verification failed.');
+  cred.counter = verification.authenticationInfo.newCounter;
+  cred.lastUsedAt = Date.now();
+  await save();
+  s.reauthAt = Date.now();
+  return { success: true };
+});
+
+// Fallback for accounts that have no passkey yet.
+route('POST', '/api/reauth/password', async ({ req, body }) => {
+  const { s, user } = requireUser(req);
+  throttleLogin(req);
+  const ok = checkPassword(String(body.password ?? ''), user.passwordHash);
+  noteLogin(req, ok);
+  if (!ok) throw new HttpError(401, 'Incorrect password.');
+  s.reauthAt = Date.now();
+  return { success: true };
+});
+
+/* -- management -- */
+
+route('GET', '/api/credentials', async ({ req }) => {
+  const { user } = requireUser(req);
+  return credsOf(user.id).map(publicCred);
+});
+
+route('PUT', '/api/credential/([\\w-]+)', async ({ req, body, params }) => {
+  const { user } = requireUser(req);
+  const cred = credById(params[0]);
+  if (!cred || cred.passkeyUserId !== user.id) throw new HttpError(404, 'Credential not found.');
+  cred.name = cleanText(body.name, 'Name');
+  await save();
+  return publicCred(cred);
+});
+
+route('DELETE', '/api/credential/([\\w-]+)', async ({ req, params }) => {
+  const { s, user } = requireUser(req);
+  requireRecentReauth(s);
+  const cred = credById(params[0]);
+  if (!cred || cred.passkeyUserId !== user.id) throw new HttpError(404, 'Credential not found.');
+  db.credentials = db.credentials.filter((c) => c !== cred);
+  await save();
+  return { success: true };
+});
+
+route('PUT', '/api/user', async ({ req, body }) => {
+  const { user } = requireUser(req);
+  const name = cleanText(body.name, 'Username', 40);
+  const displayName = cleanText(body.displayName, 'Display name');
+  const clash = userByName(name);
+  if (clash && clash.id !== user.id) throw new HttpError(409, 'That username is taken.');
+  user.name = name;
+  user.displayName = displayName;
+  await save();
+  return publicUser(user);
+});
+
+route('PUT', '/api/password', async ({ req, body }) => {
+  const { s, user } = requireUser(req);
+  requireRecentReauth(s);
+  validPassword(body.password);
+  user.passwordHash = hashPassword(body.password);
+  await save();
+  return { success: true };
+});
+
+/* ---------- server ---------- */
+
+const TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.json': 'application/json',
+};
+
+const PAGES = { '/': 'index.html', '/login': 'login.html', '/account': 'account.html' };
+
+async function serveFile(res, base, rel) {
+  const file = path.resolve(base, '.' + path.posix.normalize('/' + rel));
+  if (!file.startsWith(base + path.sep)) return false;
+  try {
+    const data = await fs.readFile(file);
+    res.writeHead(200, {
+      'Content-Type': TYPES[path.extname(file)] || 'application/octet-stream',
+      'X-Content-Type-Options': 'nosniff',
+    });
+    res.end(data);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+async function readJson(req) {
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > 64 * 1024) throw new HttpError(413, 'Payload too large.');
+    chunks.push(chunk);
+  }
+  if (!chunks.length) return {};
+  try {
+    return JSON.parse(Buffer.concat(chunks));
+  } catch {
+    throw new HttpError(400, 'Invalid JSON.');
+  }
+}
+
+function sendJson(res, status, data) {
+  res.writeHead(status, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' });
+  res.end(JSON.stringify(data));
+}
+
+const server = http.createServer(async (req, res) => {
+  const url = new URL(req.url, ORIGIN);
+  const pathname = url.pathname;
+  try {
+    if (pathname.startsWith('/api/')) {
+      if (req.method !== 'GET') {
+        // CSRF defence on top of SameSite=Lax: same-origin only, JSON only.
+        if (req.headers.origin !== ORIGIN) throw new HttpError(403, 'Bad origin.');
+        if (!req.headers['content-type']?.startsWith('application/json')) {
+          throw new HttpError(415, 'JSON required.');
+        }
+      }
+      for (const r of routes) {
+        const m = r.method === req.method && pathname.match(r.regex);
+        if (!m) continue;
+        const body = req.method === 'GET' ? {} : await readJson(req);
+        return sendJson(res, 200, await r.handler({ req, res, body, params: m.slice(1) }));
+      }
+      throw new HttpError(404, 'Not found.');
+    }
+
+    if (pathname === '/logout') {
+      endSession(req, res);
+      res.writeHead(302, { Location: '/', 'Set-Cookie': res.getHeader('Set-Cookie') });
+      return res.end();
+    }
+
+    if (req.method !== 'GET' && req.method !== 'HEAD') throw new HttpError(405, 'Method not allowed.');
+    if (pathname.startsWith('/vendor/webauthn-polyfills/')) {
+      if (await serveFile(res, POLYFILLS, pathname.slice('/vendor/webauthn-polyfills/'.length))) return;
+    } else if (await serveFile(res, PUBLIC, PAGES[pathname] || pathname)) {
+      return;
+    }
+    res.writeHead(404, { 'Content-Type': 'text/plain' });
+    res.end('Not found');
+  } catch (e) {
+    if (!(e instanceof HttpError)) console.error(e);
+    const status = e instanceof HttpError ? e.status : 500;
+    sendJson(res, status, {
+      error: e instanceof HttpError ? e.message : 'Internal error.',
+      code: e.code,
+    });
+  }
+});
+
+server.listen(PORT, () => console.log(`The Daily Grind on ${ORIGIN} (RP ID: ${RP_ID})`));
