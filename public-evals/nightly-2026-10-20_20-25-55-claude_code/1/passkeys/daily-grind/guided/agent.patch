diff --git a/public/js/account.js b/public/js/account.js
new file mode 100644
index 0000000..175ebff
--- /dev/null
+++ b/public/js/account.js
@@ -0,0 +1,242 @@
+import { api, getMe, jsonOrThrow } from './api.js';
+import {
+  passkeysSupported,
+  reauthWithPasskey,
+  registerPasskey,
+  signalAccepted,
+  signalUserDetails,
+} from './passkeys.js';
+
+const $ = (id) => document.getElementById(id);
+const dateFmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+const me = await getMe();
+if (!me.user) {
+  location.replace('/login?next=/account');
+  await new Promise(() => {}); // stop here while redirecting
+}
+const { rpId } = me;
+let { user } = me;
+let credentials = [];
+
+function say(msg, isError = false) {
+  const el = $('status');
+  el.textContent = msg;
+  el.classList.toggle('error', isError);
+}
+
+function renderUser() {
+  $('greeting').textContent = `Signed in as ${user.displayName} (@${user.name})`;
+  const f = $('profile-form');
+  f.name.value = user.name;
+  f.displayName.value = user.displayName;
+}
+
+function renderCredentials() {
+  const list = $('passkey-list');
+  list.replaceChildren(
+    ...credentials.map((c) => {
+      const li = document.createElement('li');
+      li.className = 'passkey';
+
+      const icon = c.providerIcon ? document.createElement('img') : document.createElement('span');
+      if (c.providerIcon) {
+        icon.src = c.providerIcon;
+        icon.alt = '';
+      } else {
+        icon.className = 'icon-fallback';
+        icon.textContent = '🔑';
+        icon.setAttribute('aria-hidden', 'true');
+      }
+
+      const info = document.createElement('div');
+      const name = document.createElement('strong');
+      name.textContent = c.name;
+      const meta = document.createElement('span');
+      meta.className = 'muted';
+      meta.textContent =
+        `Created ${dateFmt.format(c.registeredAt)} · ` +
+        (c.lastUsedAt ? `Last used ${dateFmt.format(c.lastUsedAt)}` : 'Never used') +
+        (c.credentialBackedUp ? ' · Synced' : '');
+      info.append(name, meta);
+
+      const actions = document.createElement('div');
+      actions.className = 'row';
+      const rename = button('Rename', 'secondary small', () => renamePasskey(c));
+      rename.setAttribute('aria-label', `Rename ${c.name}`);
+      const del = button('Delete', 'danger small', () => deletePasskey(c));
+      del.setAttribute('aria-label', `Delete ${c.name}`);
+      actions.append(rename, del);
+
+      li.append(icon, info, actions);
+      return li;
+    }),
+  );
+  $('empty').hidden = credentials.length > 0;
+}
+
+function button(text, cls, onClick) {
+  const b = document.createElement('button');
+  b.type = 'button';
+  b.className = `btn ${cls}`;
+  b.textContent = text;
+  b.addEventListener('click', onClick);
+  return b;
+}
+
+async function loadCredentials() {
+  credentials = await jsonOrThrow(await api('GET', '/api/credentials'));
+  renderCredentials();
+  return credentials;
+}
+
+// Resolves with the dialog's returnValue ('ok' or 'cancel').
+function ask(dialog) {
+  return new Promise((resolve) => {
+    dialog.addEventListener('close', () => resolve(dialog.returnValue), { once: true });
+    dialog.showModal();
+  });
+}
+
+/* ---------- reauthentication ---------- */
+
+// Run a sensitive request; if the server wants fresh verification, do it and retry once.
+async function withReauth(request) {
+  let response = await request();
+  if (response.status === 403 && (await response.clone().json()).code === 'reauth_required') {
+    if (!(await reauthenticate())) return null;
+    response = await request();
+  }
+  return response;
+}
+
+async function reauthenticate() {
+  const dialog = $('reauth-dialog');
+  const form = $('reauth-form');
+  const usePasskey = credentials.length > 0;
+  $('reauth-text').textContent = usePasskey
+    ? 'Verify with one of your passkeys to continue.'
+    : 'Enter your password to continue.';
+  $('reauth-pw-label').hidden = usePasskey;
+  form.password.required = !usePasskey;
+  form.password.value = '';
+  $('reauth-error').textContent = '';
+
+  return new Promise((resolve) => {
+    const ok = $('reauth-ok');
+    const finish = (value) => {
+      form.removeEventListener('submit', onSubmit);
+      dialog.removeEventListener('close', onClose);
+      if (dialog.open) dialog.close();
+      resolve(value);
+    };
+    const onClose = () => finish(false);
+    const onSubmit = async (e) => {
+      if (e.submitter?.value === 'cancel') return; // closes via 'close'
+      e.preventDefault();
+      ok.disabled = true;
+      try {
+        if (usePasskey) {
+          if (await reauthWithPasskey(rpId)) finish(true);
+        } else {
+          await jsonOrThrow(await api('POST', '/api/reauth/password', { password: form.password.value }));
+          finish(true);
+        }
+      } catch (err) {
+        $('reauth-error').textContent = err.message;
+      } finally {
+        ok.disabled = false;
+      }
+    };
+    form.addEventListener('submit', onSubmit);
+    dialog.addEventListener('close', onClose);
+    dialog.showModal();
+  });
+}
+
+/* ---------- actions ---------- */
+
+async function renamePasskey(c) {
+  const form = $('rename-form');
+  form.name.value = c.name;
+  if ((await ask($('rename-dialog'))) !== 'ok') return;
+  try {
+    // A passkey nickname is just a server label: no Signal API call.
+    await jsonOrThrow(await api('PUT', `/api/credential/${c.id}`, { name: form.name.value }));
+    await loadCredentials();
+    say('Passkey renamed.');
+  } catch (err) {
+    say(err.message, true);
+  }
+}
+
+async function deletePasskey(c) {
+  if (!confirm(`Delete "${c.name}"? You won't be able to sign in with it anymore.`)) return;
+  try {
+    const response = await withReauth(() => api('DELETE', `/api/credential/${c.id}`));
+    if (!response) return;
+    await jsonOrThrow(response);
+    await signalAccepted(rpId, user.id, await loadCredentials());
+    say('Passkey deleted. You may also want to remove it from your password manager.');
+  } catch (err) {
+    say(err.message, true);
+  }
+}
+
+$('create-btn').addEventListener('click', async () => {
+  say('');
+  try {
+    // Management flow: no authenticator attachment, so security keys work too.
+    const result = await registerPasskey({ rpId, promotion: false });
+    if (result.ok) {
+      await loadCredentials();
+      say('Passkey created.');
+    } else if (!result.cancelled) {
+      say(result.message, true);
+    }
+  } catch (err) {
+    say(err.message, true);
+  }
+});
+
+$('profile-form').addEventListener('submit', async (e) => {
+  e.preventDefault();
+  const f = e.currentTarget;
+  try {
+    user = await jsonOrThrow(
+      await api('PUT', '/api/user', { name: f.name.value, displayName: f.displayName.value }),
+    );
+    renderUser();
+    await signalUserDetails(rpId, user);
+    say('Profile updated.');
+  } catch (err) {
+    say(err.message, true);
+  }
+});
+
+$('password-btn').addEventListener('click', async () => {
+  const form = $('password-form');
+  form.reset();
+  if ((await ask($('password-dialog'))) !== 'ok') return;
+  try {
+    const response = await withReauth(() => api('PUT', '/api/password', { password: form.password.value }));
+    if (!response) return;
+    await jsonOrThrow(response);
+    say('Password updated.');
+  } catch (err) {
+    say(err.message, true);
+  }
+});
+
+/* ---------- init ---------- */
+
+renderUser();
+await loadCredentials();
+// Keep the password manager in sync with the server on every load.
+signalAccepted(rpId, user.id, credentials);
+
+if (await passkeysSupported()) {
+  $('create-btn').hidden = false;
+} else {
+  $('unsupported').hidden = false;
+}
diff --git a/public/js/api.js b/public/js/api.js
new file mode 100644
index 0000000..5370a43
--- /dev/null
+++ b/public/js/api.js
@@ -0,0 +1,21 @@
+// Thin JSON fetch helper. Returns the Response so callers can inspect status.
+export function api(method, url, body) {
+  return fetch(url, {
+    method,
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+}
+
+export const getMe = () => api('GET', '/api/me').then((r) => r.json());
+
+export async function jsonOrThrow(response) {
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    const err = new Error(data.error || 'Something went wrong.');
+    err.status = response.status;
+    err.code = data.code;
+    throw err;
+  }
+  return data;
+}
diff --git a/public/js/login.js b/public/js/login.js
new file mode 100644
index 0000000..5bff056
--- /dev/null
+++ b/public/js/login.js
@@ -0,0 +1,56 @@
+import { api, getMe, jsonOrThrow } from './api.js';
+import {
+  abortAutofill,
+  conditionalCreate,
+  signInWithPasskey,
+  startConditionalSignIn,
+} from './passkeys.js';
+
+const $ = (id) => document.getElementById(id);
+const form = $('auth-form');
+const errorEl = $('error');
+const next = new URLSearchParams(location.search).get('next');
+const dest = next?.startsWith('/') && !next.startsWith('//') ? next : '/account';
+
+const { rpId, user } = await getMe();
+if (user) location.replace(dest);
+
+let signup = false;
+const showError = (msg) => (errorEl.textContent = msg || '');
+const done = () => location.assign(dest);
+
+$('toggle-btn').addEventListener('click', () => {
+  signup = !signup;
+  $('title').textContent = signup ? 'Create account' : 'Sign in';
+  $('subtitle').textContent = signup
+    ? 'Create an account, then add a passkey for faster sign-in.'
+    : 'Welcome back. Use a passkey or your password.';
+  $('submit-btn').textContent = signup ? 'Create account' : 'Sign in';
+  $('toggle-text').textContent = signup ? 'Already have an account?' : 'New here?';
+  $('toggle-btn').textContent = signup ? 'Sign in' : 'Create an account';
+  $('display-name-label').hidden = !signup;
+  form.password.autocomplete = signup ? 'new-password' : 'current-password';
+  showError('');
+});
+
+form.addEventListener('submit', async (e) => {
+  e.preventDefault();
+  showError('');
+  const data = Object.fromEntries(new FormData(form));
+  try {
+    await jsonOrThrow(await api('POST', signup ? '/api/signup' : '/api/login', data));
+  } catch (err) {
+    return showError(err.message);
+  }
+  // Password sign-in succeeded: silently offer a passkey, then continue.
+  await conditionalCreate({ rpId, loginAbort: { abort: abortAutofill } });
+  done();
+});
+
+const callbacks = { rpId, onSignedIn: done, onError: showError };
+
+if (window.PublicKeyCredential) {
+  $('passkey-section').hidden = false;
+  $('passkey-btn').addEventListener('click', () => signInWithPasskey(callbacks));
+  startConditionalSignIn(callbacks);
+}
