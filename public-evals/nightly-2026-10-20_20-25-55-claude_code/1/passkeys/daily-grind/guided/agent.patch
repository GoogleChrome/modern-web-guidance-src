diff --git a/public/js/passkeys.js b/public/js/passkeys.js
new file mode 100644
index 0000000..fbf115f
--- /dev/null
+++ b/public/js/passkeys.js
@@ -0,0 +1,206 @@
+import { api, jsonOrThrow } from './api.js';
+
+// Polyfills add parseCreationOptionsFromJSON, parseRequestOptionsFromJSON,
+// toJSON() and getClientCapabilities() where the browser lacks them.
+if (window.PublicKeyCredential) {
+  await import('/vendor/webauthn-polyfills/index.js');
+}
+
+export async function capabilities() {
+  if (!window.PublicKeyCredential?.getClientCapabilities) return {};
+  return (await PublicKeyCredential.getClientCapabilities()) || {};
+}
+
+// Passkey creation is only offered where platform passkeys + autofill work.
+export async function passkeysSupported() {
+  const caps = await capabilities();
+  return !!(caps.passkeyPlatformAuthenticator && caps.conditionalGet);
+}
+
+// Signal API calls are progressive enhancement: skip silently when missing.
+export async function signalUnknown(rpId, credentialId) {
+  if (!PublicKeyCredential.signalUnknownCredential) return;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+  } catch (e) {
+    console.error('signalUnknownCredential failed:', e);
+  }
+}
+
+export async function signalAccepted(rpId, userId, credentials) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId,
+      userId,
+      allAcceptedCredentialIds: credentials.map((c) => c.id),
+    });
+  } catch (e) {
+    console.error('signalAllAcceptedCredentials failed:', e);
+  }
+}
+
+export async function signalUserDetails(rpId, user) {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId,
+      userId: user.id,
+      name: user.name,
+      displayName: user.displayName,
+    });
+  } catch (e) {
+    console.error('signalCurrentUserDetails failed:', e);
+  }
+}
+
+/* ---------- registration ---------- */
+
+// Returns { ok, message?, credential? }. Cancellations are not errors.
+export async function registerPasskey({ rpId, promotion = false }) {
+  const options = await jsonOrThrow(
+    await api('POST', '/api/passkeys/register/options', { promotion }),
+  );
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    if (err.name === 'InvalidStateError') {
+      return { ok: false, message: 'A passkey from this provider already exists for your account.' };
+    }
+    if (err.name === 'SecurityError') {
+      return { ok: false, message: 'Passkeys are not available on this origin (HTTPS / RP ID mismatch).' };
+    }
+    return { ok: false, cancelled: true }; // NotAllowedError, AbortError
+  }
+
+  // Verification is segregated so a server failure can signal the orphan.
+  const encoded = credential.toJSON();
+  try {
+    const response = await api('POST', '/api/passkeys/register/verify', encoded);
+    if (!response.ok) {
+      // 409 means the server already knows this credential: it isn't orphaned.
+      if (response.status !== 409) await signalUnknown(rpId, encoded.id);
+      const data = await response.json().catch(() => ({}));
+      return { ok: false, message: data.error || 'Could not save the passkey.' };
+    }
+    return { ok: true, credential: await response.json() };
+  } catch (e) {
+    await signalUnknown(rpId, encoded.id);
+    return { ok: false, message: 'Network error while saving the passkey.' };
+  }
+}
+
+// Silent creation right after a password sign-in. Never shows errors.
+export async function conditionalCreate({ rpId, loginAbort, timeoutMs = 4000 }) {
+  const caps = await capabilities();
+  if (caps.conditionalCreate !== true) return;
+  loginAbort?.abort(); // clear any pending autofill get()
+
+  try {
+    const options = await jsonOrThrow(
+      await api('POST', '/api/passkeys/register/options', { conditional: true }),
+    );
+    const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+    const credential = await navigator.credentials.create({
+      publicKey,
+      mediation: 'conditional',
+      signal: AbortSignal.timeout(timeoutMs),
+    });
+    if (!credential) return;
+    const encoded = credential.toJSON();
+    try {
+      const response = await api('POST', '/api/passkeys/register/verify', encoded);
+      if (!response.ok) await signalUnknown(rpId, encoded.id);
+    } catch {
+      await signalUnknown(rpId, encoded.id);
+    }
+  } catch (e) {
+    // InvalidStateError / NotAllowedError / AbortError (incl. timeout): stay quiet.
+    if (!['InvalidStateError', 'NotAllowedError', 'AbortError', 'TimeoutError'].includes(e.name)) {
+      console.error('Unexpected conditional create error:', e);
+    }
+  }
+}
+
+/* ---------- authentication ---------- */
+
+let autofillAbort = new AbortController();
+
+async function signInWithAssertion(getOptions) {
+  const options = await jsonOrThrow(await getOptions());
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+  return { publicKey };
+}
+
+async function verifyLogin(rpId, credential) {
+  const encoded = credential.toJSON();
+  const response = await api('POST', '/api/passkeys/login/verify', encoded);
+  if (response.status === 404) {
+    // Unauthenticated + server doesn't know the passkey: tell the provider.
+    await signalUnknown(rpId, encoded.id);
+    throw new Error('This passkey is no longer registered. Sign in with your password instead.');
+  }
+  return (await jsonOrThrow(response)).user;
+}
+
+// Autofill (conditional mediation). Resolves to the user once signed in.
+export async function startConditionalSignIn({ rpId, onSignedIn, onError }) {
+  const caps = await capabilities();
+  if (caps.conditionalGet !== true) return;
+  autofillAbort = new AbortController();
+  try {
+    const { publicKey } = await signInWithAssertion(() =>
+      api('POST', '/api/passkeys/login/options'),
+    );
+    const credential = await navigator.credentials.get({
+      publicKey,
+      mediation: 'conditional',
+      signal: autofillAbort.signal,
+    });
+    onSignedIn(await verifyLogin(rpId, credential));
+  } catch (err) {
+    if (['NotAllowedError', 'AbortError'].includes(err.name)) return;
+    onError?.(err.message);
+  }
+}
+
+// Explicit "Sign in with a passkey" button.
+export async function signInWithPasskey({ rpId, onSignedIn, onError }) {
+  autofillAbort.abort(); // avoid colliding with the autofill request
+  try {
+    const { publicKey } = await signInWithAssertion(() =>
+      api('POST', '/api/passkeys/login/options'),
+    );
+    const credential = await navigator.credentials.get({ publicKey });
+    onSignedIn(await verifyLogin(rpId, credential));
+  } catch (err) {
+    if (!['NotAllowedError', 'AbortError'].includes(err.name)) onError?.(err.message);
+    startConditionalSignIn({ rpId, onSignedIn, onError }); // re-arm autofill
+  }
+}
+
+export function abortAutofill() {
+  autofillAbort.abort();
+}
+
+/* ---------- reauthentication ---------- */
+
+// Resolves true when the session is freshly verified with a passkey.
+export async function reauthWithPasskey(rpId) {
+  try {
+    const options = await jsonOrThrow(await api('POST', '/api/reauth/options', {}));
+    const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+    const credential = await navigator.credentials.get({ publicKey });
+    const encoded = credential.toJSON();
+    const response = await api('POST', '/api/reauth/verify', encoded);
+    if (response.status === 404) await signalUnknown(rpId, encoded.id);
+    await jsonOrThrow(response);
+    return true;
+  } catch (err) {
+    if (['NotAllowedError', 'AbortError'].includes(err.name)) return false;
+    throw err;
+  }
+}
