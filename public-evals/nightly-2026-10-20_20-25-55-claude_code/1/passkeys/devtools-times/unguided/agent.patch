diff --git a/src/utils/passkeyClient.ts b/src/utils/passkeyClient.ts
new file mode 100644
index 0000000..0bcdf7e
--- /dev/null
+++ b/src/utils/passkeyClient.ts
@@ -0,0 +1,73 @@
+import {
+  browserSupportsWebAuthn,
+  startAuthentication,
+  startRegistration,
+} from '@simplewebauthn/browser';
+
+const api = (path: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}api/passkeys/${path}`;
+
+export const passkeysSupported = () => browserSupportsWebAuthn();
+
+async function call(path: string, method = 'POST', body?: unknown) {
+  const res = await fetch(api(path), {
+    method,
+    headers: { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) throw new PasskeyError(data.error || 'Request failed', data.error === 'reauth_required');
+  return data;
+}
+
+export class PasskeyError extends Error {
+  constructor(message: string, public reauthRequired = false) {
+    super(message);
+  }
+}
+
+/** Turns WebAuthn/browser errors into something readable. */
+export function describeError(e: unknown) {
+  if (e instanceof PasskeyError) return e.message;
+  const name = (e as any)?.name;
+  if (name === 'NotAllowedError' || name === 'AbortError') return 'The passkey prompt was cancelled or timed out.';
+  if (name === 'InvalidStateError') return 'This passkey is already registered on this device.';
+  return (e as Error)?.message || 'Something went wrong.';
+}
+
+/** Signed out: creates an account. Signed in: adds a passkey. */
+export async function registerPasskey(opts: { username?: string; name?: string } = {}) {
+  const options = await call('register/options', 'POST', { username: opts.username });
+  const response = await startRegistration({ optionsJSON: options });
+  await call('register/verify', 'POST', { response, name: opts.name });
+}
+
+export async function signInWithPasskey() {
+  const options = await call('authenticate/options');
+  const response = await startAuthentication({ optionsJSON: options });
+  await call('authenticate/verify', 'POST', { response });
+}
+
+export async function reauthenticate() {
+  const options = await call('reauth/options');
+  const response = await startAuthentication({ optionsJSON: options });
+  await call('reauth/verify', 'POST', { response });
+}
+
+/** Runs `fn`, prompting for a passkey and retrying once if recent authentication is needed. */
+export async function withReauth<T>(fn: () => Promise<T>): Promise<T> {
+  try {
+    return await fn();
+  } catch (e) {
+    if (e instanceof PasskeyError && e.reauthRequired) {
+      await reauthenticate();
+      return fn();
+    }
+    throw e;
+  }
+}
+
+export const listPasskeys = () => call('manage', 'GET');
+export const renamePasskey = (id: string, name: string) => call('manage', 'PATCH', { id, name });
+export const deletePasskey = (id: string) => withReauth(() => call('manage', 'DELETE', { id }));
+export const addPasskey = (name?: string) => withReauth(() => registerPasskey({ name }));
+export const signOut = () => call('signout');
diff --git a/src/utils/passkeys.ts b/src/utils/passkeys.ts
new file mode 100644
index 0000000..e0d8575
--- /dev/null
+++ b/src/utils/passkeys.ts
@@ -0,0 +1,124 @@
+import { randomUUID } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import type { AuthenticatorTransportFuture } from '@simplewebauthn/server';
+
+export interface PasskeyUser {
+  id: string;
+  username: string;
+  createdAt: number;
+}
+
+export interface Passkey {
+  id: string; // base64url credential ID
+  userId: string;
+  publicKey: string; // base64url
+  counter: number;
+  transports?: AuthenticatorTransportFuture[];
+  name: string;
+  deviceType: string;
+  backedUp: boolean;
+  createdAt: number;
+  lastUsedAt: number | null;
+}
+
+interface Db {
+  users: PasskeyUser[];
+  passkeys: Passkey[];
+}
+
+/** How long a passkey verification counts as "recent" for sensitive actions. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+const FILE = path.resolve(process.env.PASSKEY_DB_PATH ?? '.data/passkeys.json');
+
+// Serialise read-modify-write cycles so concurrent requests can't clobber each other.
+let queue: Promise<unknown> = Promise.resolve();
+
+async function read(): Promise<Db> {
+  try {
+    return JSON.parse(await fs.readFile(FILE, 'utf8'));
+  } catch (e: any) {
+    if (e.code === 'ENOENT') return { users: [], passkeys: [] };
+    throw e;
+  }
+}
+
+function transaction<T>(fn: (db: Db) => T | Promise<T>): Promise<T> {
+  const run = queue.then(async () => {
+    const db = await read();
+    const result = await fn(db);
+    await fs.mkdir(path.dirname(FILE), { recursive: true });
+    const tmp = `${FILE}.${randomUUID()}.tmp`;
+    await fs.writeFile(tmp, JSON.stringify(db, null, 2));
+    await fs.rename(tmp, FILE);
+    return result;
+  });
+  queue = run.catch(() => {});
+  return run;
+}
+
+export const normalizeUsername = (u: string) => u.trim().toLowerCase();
+
+export async function getUser(id: string) {
+  return (await read()).users.find((u) => u.id === id);
+}
+
+export async function getUserByUsername(username: string) {
+  const n = normalizeUsername(username);
+  return (await read()).users.find((u) => normalizeUsername(u.username) === n);
+}
+
+export async function listPasskeys(userId: string) {
+  return (await read()).passkeys
+    .filter((p) => p.userId === userId)
+    .sort((a, b) => a.createdAt - b.createdAt);
+}
+
+export async function getPasskey(id: string) {
+  return (await read()).passkeys.find((p) => p.id === id);
+}
+
+export function createUser(id: string, username: string, passkey: Omit<Passkey, 'userId'>) {
+  return transaction((db) => {
+    const n = normalizeUsername(username);
+    if (db.users.some((u) => normalizeUsername(u.username) === n)) return null;
+    db.users.push({ id, username: username.trim(), createdAt: Date.now() });
+    db.passkeys.push({ ...passkey, userId: id });
+    return id;
+  });
+}
+
+export function addPasskey(userId: string, passkey: Omit<Passkey, 'userId'>) {
+  return transaction((db) => {
+    if (db.passkeys.some((p) => p.id === passkey.id)) return false;
+    db.passkeys.push({ ...passkey, userId });
+    return true;
+  });
+}
+
+export function updateCounter(id: string, counter: number) {
+  return transaction((db) => {
+    const p = db.passkeys.find((x) => x.id === id);
+    if (p) {
+      p.counter = counter;
+      p.lastUsedAt = Date.now();
+    }
+  });
+}
+
+export function renamePasskey(userId: string, id: string, name: string) {
+  return transaction((db) => {
+    const p = db.passkeys.find((x) => x.id === id && x.userId === userId);
+    if (p) p.name = name;
+    return !!p;
+  });
+}
+
+export function deletePasskey(userId: string, id: string) {
+  return transaction((db) => {
+    const before = db.passkeys.length;
+    db.passkeys = db.passkeys.filter((p) => !(p.id === id && p.userId === userId));
+    return db.passkeys.length < before;
+  });
+}
diff --git a/src/utils/webauthn.ts b/src/utils/webauthn.ts
new file mode 100644
index 0000000..9cd4b85
--- /dev/null
+++ b/src/utils/webauthn.ts
@@ -0,0 +1,35 @@
+import type { APIContext } from 'astro';
+
+export const RP_NAME = 'The DevTools Times';
+
+/** Relying party ID and expected origin, derived from the request unless overridden by env. */
+export function getRp(context: Pick<APIContext, 'url'>) {
+  return {
+    rpID: process.env.PASSKEY_RP_ID ?? context.url.hostname,
+    origin: process.env.PASSKEY_ORIGIN ?? context.url.origin,
+  };
+}
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+
+/** Returns the signed-in passkey user ID from the session, if any. */
+export async function currentUserId(context: Pick<APIContext, 'session'>) {
+  return (await context.session?.get('passkeyUserId')) as string | undefined;
+}
+
+/** Fetches and clears a one-time challenge so it can't be replayed. */
+export async function takeChallenge(context: Pick<APIContext, 'session'>, key: string) {
+  const value = await context.session?.get(key);
+  context.session?.delete(key);
+  return value as any;
+}
+
+export const bodyOf = (request: Request) => request.json().catch(() => null);
+
+export function defaultPasskeyName(deviceType: string, backedUp: boolean) {
+  return backedUp ? 'Synced passkey' : deviceType === 'multiDevice' ? 'Passkey' : 'Device-bound passkey';
+}
