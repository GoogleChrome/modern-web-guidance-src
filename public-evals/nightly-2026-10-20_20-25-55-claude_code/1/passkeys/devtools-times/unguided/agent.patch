--- /dev/null
+++ b/src/pages/api/passkeys/reauth/options.ts
@@ -0,0 +1,20 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { listPasskeys } from '../../../../utils/passkeys';
+import { currentUserId, getRp, json } from '../../../../utils/webauthn';
+
+export const prerender = false;
+
+/** Challenge limited to the signed-in user's own passkeys. */
+export const POST: APIRoute = async (context) => {
+  const userId = await currentUserId(context);
+  if (!userId) return json({ error: 'Not signed in' }, 401);
+  const passkeys = await listPasskeys(userId);
+  const options = await generateAuthenticationOptions({
+    rpID: getRp(context).rpID,
+    userVerification: 'required',
+    allowCredentials: passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+  });
+  await context.session!.set('reauthentication', { challenge: options.challenge, userId });
+  return json(options);
+};
