+import React, { useEffect, useState } from 'react';
+import { describeError, passkeysSupported, signInWithPasskey } from '../utils/passkeyClient';
+
+export default function PasskeySignInButton() {
+  const [supported, setSupported] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+
+  useEffect(() => setSupported(passkeysSupported()), []);
+  if (!supported) return null;
+
+  const handleClick = async () => {
+    setError(null);
+    setLoading(true);
+    try {
+      await signInWithPasskey();
+      window.location.href = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}account`;
+    } catch (e) {
+      setError(describeError(e));
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div className="mt-4">
+      <div className="flex items-center my-4 text-xs text-gray-500">
+        <div className="flex-1 border-t border-gray-200" />
+        <span className="px-2">or</span>
+        <div className="flex-1 border-t border-gray-200" />
+      </div>
+      {error && (
+        <div className="mb-3 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+      <button
+        type="button"
+        onClick={handleClick}
+        disabled={loading}
+        className={`w-full py-2 px-4 border border-gray-900 rounded-md text-sm font-medium text-gray-900 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+          loading ? 'opacity-75 cursor-not-allowed' : ''
+        }`}
+      >
+        {loading ? 'Waiting for passkey...' : 'Sign in with a passkey'}
+      </button>
+    </div>
+  );
+}
