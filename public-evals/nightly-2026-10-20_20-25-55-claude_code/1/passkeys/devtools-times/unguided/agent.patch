diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..16244de
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,185 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import {
+  addPasskey,
+  deletePasskey,
+  describeError,
+  listPasskeys,
+  passkeysSupported,
+  reauthenticate,
+  renamePasskey,
+  signOut,
+} from '../utils/passkeyClient';
+
+interface Item {
+  id: string;
+  name: string;
+  backedUp: boolean;
+  createdAt: number;
+  lastUsedAt: number | null;
+}
+
+const fmt = (t: number) => new Date(t).toLocaleDateString('en-US', { dateStyle: 'medium' });
+
+export default function PasskeyManager({ username }: { username: string }) {
+  const [items, setItems] = useState<Item[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [newName, setNewName] = useState('');
+  const [editing, setEditing] = useState<{ id: string; name: string } | null>(null);
+  const [supported, setSupported] = useState(true);
+
+  const refresh = useCallback(async () => {
+    try {
+      setItems((await listPasskeys()).passkeys);
+    } catch (e) {
+      setError(describeError(e));
+    }
+  }, []);
+
+  useEffect(() => {
+    setSupported(passkeysSupported());
+    refresh();
+  }, [refresh]);
+
+  const run = async (fn: () => Promise<unknown>, success?: string) => {
+    setError(null);
+    setNotice(null);
+    setBusy(true);
+    try {
+      await fn();
+      if (success) setNotice(success);
+      await refresh();
+    } catch (e) {
+      setError(describeError(e));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const handleSignOut = async () => {
+    await signOut();
+    window.location.href = import.meta.env.BASE_URL;
+  };
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <div className="flex items-center justify-between mb-6">
+        <div>
+          <h2 className="text-2xl font-bold text-gray-800">Your passkeys</h2>
+          <p className="text-sm text-gray-500">Signed in as {username}</p>
+        </div>
+        <button onClick={handleSignOut} className="text-sm text-gray-700 underline">
+          Sign out
+        </button>
+      </div>
+
+      {error && (
+        <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+      {notice && (
+        <div className="mb-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+          {notice}
+        </div>
+      )}
+
+      {items === null ? (
+        <p className="text-sm text-gray-500">Loading…</p>
+      ) : (
+        <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md">
+          {items.map((p) => (
+            <li key={p.id} className="p-3 flex items-center justify-between gap-3">
+              {editing?.id === p.id ? (
+                <form
+                  className="flex gap-2 flex-1"
+                  onSubmit={(e) => {
+                    e.preventDefault();
+                    run(() => renamePasskey(p.id, editing.name), 'Passkey renamed.').then(() => setEditing(null));
+                  }}
+                >
+                  <input
+                    autoFocus
+                    aria-label="Passkey name"
+                    value={editing.name}
+                    maxLength={60}
+                    onChange={(e) => setEditing({ id: p.id, name: e.target.value })}
+                    className="flex-1 px-2 py-1 border border-gray-300 rounded-md text-sm"
+                  />
+                  <button disabled={busy} className="text-sm font-medium">Save</button>
+                  <button type="button" onClick={() => setEditing(null)} className="text-sm text-gray-500">
+                    Cancel
+                  </button>
+                </form>
+              ) : (
+                <>
+                  <div>
+                    <p className="font-medium text-gray-800">{p.name}</p>
+                    <p className="text-xs text-gray-500">
+                      Added {fmt(p.createdAt)} · {p.lastUsedAt ? `Last used ${fmt(p.lastUsedAt)}` : 'Never used'}
+                      {p.backedUp ? ' · Synced' : ''}
+                    </p>
+                  </div>
+                  <div className="flex gap-3 text-sm">
+                    <button disabled={busy} onClick={() => setEditing({ id: p.id, name: p.name })}>
+                      Rename
+                    </button>
+                    <button
+                      disabled={busy || items.length < 2}
+                      title={items.length < 2 ? 'Add another passkey before removing this one' : undefined}
+                      onClick={() => {
+                        if (confirm(`Remove “${p.name}”?`)) run(() => deletePasskey(p.id), 'Passkey removed.');
+                      }}
+                      className="text-red-700 disabled:opacity-40"
+                    >
+                      Remove
+                    </button>
+                  </div>
+                </>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+
+      {supported ? (
+        <form
+          className="mt-6 flex gap-2"
+          onSubmit={(e) => {
+            e.preventDefault();
+            run(() => addPasskey(newName.trim() || undefined), 'Passkey added.').then(() => setNewName(''));
+          }}
+        >
+          <input
+            aria-label="Name for new passkey"
+            placeholder="Name (optional), e.g. Work laptop"
+            value={newName}
+            maxLength={60}
+            onChange={(e) => setNewName(e.target.value)}
+            className="flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm"
+          />
+          <button
+            disabled={busy}
+            className="py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75"
+          >
+            Add a passkey
+          </button>
+        </form>
+      ) : (
+        <p className="mt-6 text-sm text-gray-500">This browser doesn’t support passkeys.</p>
+      )}
+
+      <div className="mt-6 pt-4 border-t border-gray-200 text-sm text-gray-600">
+        Adding or removing passkeys requires a recent passkey check.{' '}
+        <button
+          disabled={busy}
+          onClick={() => run(reauthenticate, 'Verified. You can make changes for the next 5 minutes.')}
+          className="underline"
+        >
+          Verify now
+        </button>
+      </div>
+    </div>
+  );
+}
