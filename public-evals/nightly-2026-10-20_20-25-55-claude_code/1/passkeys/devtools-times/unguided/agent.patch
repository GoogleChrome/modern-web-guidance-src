--- /dev/null
+++ b/src/pages/api/passkeys/register/options.ts
@@ -0,0 +1,59 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { randomUUID } from 'node:crypto';
+import { getUser, getUserByUsername, listPasskeys, REAUTH_WINDOW_MS } from '../../../../utils/passkeys';
+import { RP_NAME, bodyOf, currentUserId, getRp, json } from '../../../../utils/webauthn';
+
+export const prerender = false;
+
+/**
+ * Starts registration. Signed out: creates a pending account for `username`.
+ * Signed in: adds another passkey to the current account (needs recent reauth).
+ */
+export const POST: APIRoute = async (context) => {
+  const { rpID } = getRp(context);
+  const session = context.session!;
+  const userId = await currentUserId(context);
+
+  let id: string;
+  let username: string;
+  let exclude: { id: string; transports?: any }[] = [];
+  let mode: 'signup' | 'add';
+
+  if (userId) {
+    const user = await getUser(userId);
+    if (!user) return json({ error: 'Unknown user' }, 401);
+    const reauthAt = (await session.get('reauthAt')) as number | undefined;
+    if (!reauthAt || Date.now() - reauthAt > REAUTH_WINDOW_MS) {
+      return json({ error: 'reauth_required' }, 403);
+    }
+    id = user.id;
+    username = user.username;
+    exclude = (await listPasskeys(userId)).map((p) => ({ id: p.id, transports: p.transports }));
+    mode = 'add';
+  } else {
+    const body = await bodyOf(context.request);
+    username = String(body?.username ?? '').trim();
+    if (!/^[\w.@+-]{3,64}$/.test(username)) {
+      return json({ error: 'Username must be 3–64 characters (letters, numbers, . _ @ + -).' }, 400);
+    }
+    if (await getUserByUsername(username)) {
+      return json({ error: 'That username is already taken.' }, 409);
+    }
+    id = randomUUID();
+    mode = 'signup';
+  }
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userName: username,
+    userID: new TextEncoder().encode(id),
+    attestationType: 'none',
+    excludeCredentials: exclude,
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+  });
+
+  await session.set('registration', { challenge: options.challenge, id, username, mode });
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/register/verify.ts b/src/pages/api/passkeys/register/verify.ts
new file mode 100644
index 0000000..691b217
--- /dev/null
+++ b/src/pages/api/passkeys/register/verify.ts
@@ -0,0 +1,62 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { addPasskey, createUser, REAUTH_WINDOW_MS } from '../../../../utils/passkeys';
+import { bodyOf, currentUserId, defaultPasskeyName, getRp, json, takeChallenge } from '../../../../utils/webauthn';
+
+export const prerender = false;
+
+export const POST: APIRoute = async (context) => {
+  const { rpID, origin } = getRp(context);
+  const session = context.session!;
+  const pending = await takeChallenge(context, 'registration');
+  const body = await bodyOf(context.request);
+  if (!pending || !body?.response) return json({ error: 'Registration expired. Please try again.' }, 400);
+
+  if (pending.mode === 'add') {
+    const reauthAt = (await session.get('reauthAt')) as number | undefined;
+    if ((await currentUserId(context)) !== pending.id || !reauthAt || Date.now() - reauthAt > REAUTH_WINDOW_MS) {
+      return json({ error: 'reauth_required' }, 403);
+    }
+  }
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body.response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: false,
+    });
+  } catch (e: any) {
+    return json({ error: `Could not verify passkey: ${e.message}` }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Could not verify passkey.' }, 400);
+
+  const { credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  const name =
+    String(body.name ?? '').trim().slice(0, 60) || defaultPasskeyName(credentialDeviceType, credentialBackedUp);
+  const record = {
+    id: credential.id,
+    publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    counter: credential.counter,
+    transports: credential.transports,
+    name,
+    deviceType: credentialDeviceType,
+    backedUp: credentialBackedUp,
+    createdAt: Date.now(),
+    lastUsedAt: null,
+  };
+
+  if (pending.mode === 'signup') {
+    if (!(await createUser(pending.id, pending.username, record))) {
+      return json({ error: 'That username is already taken.' }, 409);
+    }
+    await session.regenerate?.();
+    await session.set('passkeyUserId', pending.id);
+    await session.set('reauthAt', Date.now());
+  } else if (!(await addPasskey(pending.id, record))) {
+    return json({ error: 'This passkey is already registered.' }, 409);
+  }
+  return json({ verified: true });
+};
