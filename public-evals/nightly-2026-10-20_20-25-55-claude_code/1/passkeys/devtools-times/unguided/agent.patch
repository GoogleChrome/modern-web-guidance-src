+import React, { useEffect, useState } from 'react';
+import { describeError, passkeysSupported, registerPasskey } from '../utils/passkeyClient';
+
+export default function PasskeySignUpForm() {
+  const [supported, setSupported] = useState(false);
+  const [username, setUsername] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+
+  useEffect(() => setSupported(passkeysSupported()), []);
+  if (!supported) return null;
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setLoading(true);
+    try {
+      await registerPasskey({ username });
+      window.location.href = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}account`;
+    } catch (err) {
+      setError(describeError(err));
+      setLoading(false);
+    }
+  };
+
+  return (
+    <form onSubmit={handleSubmit} className="mt-4 space-y-3">
+      <div className="flex items-center my-4 text-xs text-gray-500">
+        <div className="flex-1 border-t border-gray-200" />
+        <span className="px-2">or sign up without a password</span>
+        <div className="flex-1 border-t border-gray-200" />
+      </div>
+      {error && (
+        <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+      <label htmlFor="passkey-username" className="block text-sm font-medium text-gray-700">
+        Username
+      </label>
+      <input
+        type="text"
+        id="passkey-username"
+        autoComplete="username webauthn"
+        value={username}
+        onChange={(e) => setUsername(e.target.value)}
+        required
+        className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+      />
+      <button
+        type="submit"
+        disabled={loading}
+        data-skip-tracking="true"
+        className={`w-full py-2 px-4 border border-gray-900 rounded-md text-sm font-medium text-gray-900 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+          loading ? 'opacity-75 cursor-not-allowed' : ''
+        }`}
+      >
+        {loading ? 'Waiting for passkey...' : 'Sign up with a passkey'}
+      </button>
+    </form>
+  );
+}
