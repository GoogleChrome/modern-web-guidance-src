+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRp, json } from '../../../../utils/webauthn';
+
+export const prerender = false;
+
+/** Usernameless sign-in: the authenticator picks a discoverable credential. */
+export const POST: APIRoute = async (context) => {
+  const options = await generateAuthenticationOptions({
+    rpID: getRp(context).rpID,
+    userVerification: 'preferred',
+  });
+  await context.session!.set('authentication', { challenge: options.challenge });
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/authenticate/verify.ts b/src/pages/api/passkeys/authenticate/verify.ts
new file mode 100644
index 0000000..abeea79
--- /dev/null
+++ b/src/pages/api/passkeys/authenticate/verify.ts
@@ -0,0 +1,42 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { getPasskey, updateCounter } from '../../../../utils/passkeys';
+import { bodyOf, getRp, json, takeChallenge } from '../../../../utils/webauthn';
+
+export const prerender = false;
+
+export const POST: APIRoute = async (context) => {
+  const { rpID, origin } = getRp(context);
+  const session = context.session!;
+  const pending = await takeChallenge(context, 'authentication');
+  const body = await bodyOf(context.request);
+  if (!pending || !body?.response) return json({ error: 'Sign-in expired. Please try again.' }, 400);
+
+  const passkey = await getPasskey(body.response.id);
+  if (!passkey) return json({ error: 'Passkey not recognised.' }, 401);
+
+  try {
+    const { verified, authenticationInfo } = await verifyAuthenticationResponse({
+      response: body.response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      credential: {
+        id: passkey.id,
+        publicKey: Buffer.from(passkey.publicKey, 'base64url'),
+        counter: passkey.counter,
+        transports: passkey.transports,
+      },
+      requireUserVerification: false,
+    });
+    if (!verified) return json({ error: 'Could not verify passkey.' }, 401);
+    await updateCounter(passkey.id, authenticationInfo.newCounter);
+  } catch (e: any) {
+    return json({ error: `Could not verify passkey: ${e.message}` }, 401);
+  }
+
+  await session.regenerate?.();
+  await session.set('passkeyUserId', passkey.userId);
+  await session.set('reauthAt', Date.now());
+  return json({ verified: true });
+};
diff --git a/src/pages/api/passkeys/manage.ts b/src/pages/api/passkeys/manage.ts
new file mode 100644
index 0000000..0746b39
--- /dev/null
+++ b/src/pages/api/passkeys/manage.ts
@@ -0,0 +1,44 @@
+import type { APIRoute } from 'astro';
+import { deletePasskey, listPasskeys, renamePasskey, REAUTH_WINDOW_MS } from '../../../utils/passkeys';
+import { bodyOf, currentUserId, json } from '../../../utils/webauthn';
+
+export const prerender = false;
+
+const publicView = (p: Awaited<ReturnType<typeof listPasskeys>>[number]) => ({
+  id: p.id,
+  name: p.name,
+  backedUp: p.backedUp,
+  createdAt: p.createdAt,
+  lastUsedAt: p.lastUsedAt,
+});
+
+export const GET: APIRoute = async (context) => {
+  const userId = await currentUserId(context);
+  if (!userId) return json({ error: 'Not signed in' }, 401);
+  return json({ passkeys: (await listPasskeys(userId)).map(publicView) });
+};
+
+export const PATCH: APIRoute = async (context) => {
+  const userId = await currentUserId(context);
+  if (!userId) return json({ error: 'Not signed in' }, 401);
+  const body = await bodyOf(context.request);
+  const name = String(body?.name ?? '').trim().slice(0, 60);
+  if (!body?.id || !name) return json({ error: 'A passkey and a name are required.' }, 400);
+  if (!(await renamePasskey(userId, body.id, name))) return json({ error: 'Passkey not found.' }, 404);
+  return json({ ok: true });
+};
+
+export const DELETE: APIRoute = async (context) => {
+  const userId = await currentUserId(context);
+  if (!userId) return json({ error: 'Not signed in' }, 401);
+  const reauthAt = (await context.session!.get('reauthAt')) as number | undefined;
+  if (!reauthAt || Date.now() - reauthAt > REAUTH_WINDOW_MS) return json({ error: 'reauth_required' }, 403);
+
+  const body = await bodyOf(context.request);
+  const passkeys = await listPasskeys(userId);
+  if (passkeys.length <= 1) {
+    return json({ error: 'You can’t remove your only passkey — add another one first.' }, 400);
+  }
+  if (!body?.id || !(await deletePasskey(userId, body.id))) return json({ error: 'Passkey not found.' }, 404);
+  return json({ ok: true });
+};
diff --git a/src/pages/api/passkeys/reauth/options.ts b/src/pages/api/passkeys/reauth/options.ts
new file mode 100644
