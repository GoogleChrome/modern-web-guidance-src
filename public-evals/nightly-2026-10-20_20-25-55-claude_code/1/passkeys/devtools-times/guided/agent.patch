+import type { APIRoute } from 'astro';
+import { getOrCreateUser } from '../../../lib/store';
+import { json } from '../../../lib/webauthn';
+
+export const prerender = false;
+
+const LOGIN_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+// Password sign-in is verified by the upstream service; we mirror the result into a local session.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+  const upstream = await fetch(LOGIN_URL, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) return json({ error: data.error || 'Unknown error' }, upstream.status);
+
+  const user = await getOrCreateUser(username);
+  await session?.regenerate();
+  await session?.set('userId', user.id);
+  await session?.set('reauthAt', Date.now()); // a fresh password sign-in counts as verification
+  return json({ user: { username: user.username, displayName: user.displayName } });
+};
