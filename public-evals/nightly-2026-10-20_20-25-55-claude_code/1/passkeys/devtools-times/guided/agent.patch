diff --git a/src/lib/passkeyClient.ts b/src/lib/passkeyClient.ts
new file mode 100644
index 0000000..67bddbb
--- /dev/null
+++ b/src/lib/passkeyClient.ts
@@ -0,0 +1,118 @@
+import 'webauthn-polyfills';
+
+const base = import.meta.env.BASE_URL;
+
+export const rpId = () => location.hostname;
+
+export async function post(path: string, body?: unknown) {
+  return fetch(`${base}api/${path}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body ?? {}),
+  });
+}
+
+export async function passkeysSupported() {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return false;
+  const caps = await PublicKeyCredential.getClientCapabilities();
+  return !!(caps.passkeyPlatformAuthenticator || caps.conditionalGet);
+}
+
+export async function conditionalGetSupported() {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return false;
+  return (await PublicKeyCredential.getClientCapabilities()).conditionalGet === true;
+}
+
+/** Tell the passkey provider a credential is unknown to the server (where supported). */
+export async function signalUnknown(credentialId: string, rpIdValue = rpId()) {
+  if (!(PublicKeyCredential as any).signalUnknownCredential) return;
+  try {
+    await (PublicKeyCredential as any).signalUnknownCredential({ rpId: rpIdValue, credentialId });
+  } catch (e) {
+    console.error('signalUnknownCredential failed', e);
+  }
+}
+
+export async function signalAccepted(userId: string, credentialIds: string[]) {
+  if (!(PublicKeyCredential as any).signalAllAcceptedCredentials) return;
+  try {
+    await (PublicKeyCredential as any).signalAllAcceptedCredentials({
+      rpId: rpId(),
+      userId,
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (e) {
+    console.error('signalAllAcceptedCredentials failed', e);
+  }
+}
+
+export async function signalUserDetails(userId: string, name: string, displayName: string) {
+  if (!(PublicKeyCredential as any).signalCurrentUserDetails) return;
+  try {
+    await (PublicKeyCredential as any).signalCurrentUserDetails({ rpId: rpId(), userId, name, displayName });
+  } catch (e) {
+    console.error('signalCurrentUserDetails failed', e);
+  }
+}
+
+export type RegisterResult = 'created' | 'exists' | 'cancelled' | 'unsupported' | 'error';
+
+/** Register a passkey for the signed-in user. */
+export async function registerPasskey(opts: { promotion?: boolean; conditional?: boolean } = {}): Promise<RegisterResult> {
+  if (!(await passkeysSupported())) return 'unsupported';
+  const optionsRes = await post('passkeys/register/options', opts);
+  if (!optionsRes.ok) return 'error';
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsRes.json());
+
+  let credential: Credential | null;
+  try {
+    credential = await navigator.credentials.create({
+      publicKey,
+      ...(opts.conditional ? { mediation: 'conditional' as any } : {}),
+    });
+  } catch (err) {
+    const name = (err as DOMException).name;
+    if (name === 'InvalidStateError') return 'exists';
+    if (name === 'NotAllowedError' || name === 'AbortError') return 'cancelled';
+    console.error(err);
+    return 'error';
+  }
+  if (!credential) return 'cancelled';
+
+  const encoded = (credential as PublicKeyCredential).toJSON();
+  try {
+    const res = await post('passkeys/register/verify', encoded);
+    if (!res.ok) {
+      await signalUnknown(encoded.id);
+      return 'error';
+    }
+  } catch {
+    await signalUnknown(encoded.id);
+    return 'error';
+  }
+  return 'created';
+}
+
+/** Verify the signed-in user with one of their own passkeys. Resolves true on success. */
+export async function reauthenticateWithPasskey(): Promise<boolean> {
+  const optionsRes = await post('passkeys/reauth/options');
+  if (!optionsRes.ok) return false;
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await optionsRes.json());
+  let credential: Credential | null;
+  try {
+    credential = await navigator.credentials.get({ publicKey });
+  } catch (err) {
+    if (!['NotAllowedError', 'AbortError'].includes((err as DOMException).name)) console.error(err);
+    return false;
+  }
+  if (!credential) return false;
+  const encoded = (credential as PublicKeyCredential).toJSON();
+  const res = await post('passkeys/reauth/verify', encoded);
+  if (res.status === 404) await signalUnknown(encoded.id);
+  return res.ok;
+}
+
+export async function conditionalCreateSupported() {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return false;
+  return (await PublicKeyCredential.getClientCapabilities()).conditionalCreate === true;
+}
