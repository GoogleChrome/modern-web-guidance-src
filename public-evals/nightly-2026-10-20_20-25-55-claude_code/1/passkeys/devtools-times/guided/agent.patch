+import type { APIRoute } from 'astro';
+import { updateUser } from '../../lib/store';
+import { getSessionUser, json } from '../../lib/webauthn';
+
+export const PUT: APIRoute = async (context) => {
+  const user = await getSessionUser(context);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  const { displayName } = await context.request.json().catch(() => ({}));
+  if (typeof displayName !== 'string' || !displayName.trim() || displayName.length > 100) {
+    return json({ error: 'Invalid display name' }, 400);
+  }
+  const updated = await updateUser(user.id, { displayName: displayName.trim() });
+  return json({ id: updated!.id, username: updated!.username, displayName: updated!.displayName });
+};
