+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { findCredentialById, saveCredential } from '../../../../lib/store';
+import { getRp, getSessionUser, json } from '../../../../lib/webauthn';
+
+export const POST: APIRoute = async (context) => {
+  const user = await getSessionUser(context);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  const pending = await context.session?.get('reauthentication');
+  await context.session?.delete('reauthentication');
+  if (!pending) return json({ error: 'No reauthentication in progress' }, 400);
+
+  const body = await context.request.json().catch(() => null);
+  if (!body?.id) return json({ error: 'Invalid request' }, 400);
+
+  const stored = await findCredentialById(body.id);
+  // Must belong to the active user; a valid passkey of someone else is rejected.
+  if (!stored || stored.passkeyUserId !== user.id) return json({ error: 'Credential not found' }, 404);
+
+  const { rpID, origin } = getRp(context);
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: body,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: pending.userVerification === 'required',
+      credential: {
+        id: stored.id,
+        publicKey: Buffer.from(stored.credentialPublicKey, 'base64url'),
+        counter: stored.counter,
+        transports: stored.transports as AuthenticatorTransport[],
+      },
+    });
+  } catch (e) {
+    return json({ error: (e as Error).message }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Verification failed' }, 400);
+
+  await saveCredential({ ...stored, counter: verification.authenticationInfo.newCounter, lastUsedAt: Date.now() });
+  await context.session?.set('reauthAt', Date.now());
+  return json({ success: true });
+};
