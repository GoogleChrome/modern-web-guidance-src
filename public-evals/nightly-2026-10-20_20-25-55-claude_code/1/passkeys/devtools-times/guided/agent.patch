+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { findCredentialsByUserId } from '../../../../lib/store';
+import { getRp, getSessionUser, json } from '../../../../lib/webauthn';
+
+export const POST: APIRoute = async (context) => {
+  const user = await getSessionUser(context);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  const credentials = await findCredentialsByUserId(user.id);
+  if (!credentials.length) return json({ error: 'No passkeys registered' }, 404);
+
+  const options = await generateAuthenticationOptions({
+    rpID: getRp(context).rpID,
+    // Constrain to the signed-in user's own passkeys.
+    allowCredentials: credentials.map((c) => ({ id: c.id, transports: c.transports as AuthenticatorTransport[] })),
+    userVerification: 'preferred',
+  });
+  await context.session?.set('reauthentication', { challenge: options.challenge, userVerification: 'preferred' });
+  return json(options);
+};
