+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { findCredentialsByUserId } from '../../../../lib/store';
+import { getRp, getSessionUser, json, RP_NAME } from '../../../../lib/webauthn';
+
+export const POST: APIRoute = async (context) => {
+  const user = await getSessionUser(context);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  const { promotion = false, conditional = false } = await context.request.json().catch(() => ({}));
+
+  const existing = await findCredentialsByUserId(user.id);
+  const { rpID } = getRp(context);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userName: user.username,
+    userDisplayName: user.displayName,
+    userID: Buffer.from(user.id, 'base64url'),
+    attestationType: 'none',
+    excludeCredentials: existing.map((c) => ({ id: c.id, transports: c.transports as AuthenticatorTransport[] })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      // Management flow also allows security keys, so attachment is only constrained for promotions.
+      ...(promotion || conditional ? { authenticatorAttachment: 'platform' as const } : {}),
+    },
+  });
+
+  await context.session?.set('registration', { challenge: options.challenge, conditional: !!conditional });
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/register/verify.ts b/src/pages/api/passkeys/register/verify.ts
new file mode 100644
index 0000000..0ada1ce
--- /dev/null
+++ b/src/pages/api/passkeys/register/verify.ts
@@ -0,0 +1,52 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { findCredentialById, saveCredential } from '../../../../lib/store';
+import { describeAuthenticator, getRp, getSessionUser, json } from '../../../../lib/webauthn';
+
+export const POST: APIRoute = async (context) => {
+  const user = await getSessionUser(context);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  const pending = await context.session?.get('registration');
+  await context.session?.delete('registration'); // challenges are single-use
+  if (!pending) return json({ error: 'No registration in progress' }, 400);
+
+  const body = await context.request.json().catch(() => null);
+  if (!body?.id) return json({ error: 'Invalid request' }, 400);
+
+  const { rpID, origin } = getRp(context);
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: false, // options asked for "preferred"
+      requireUserPresence: !pending.conditional, // conditional create may be silent
+    });
+  } catch (e) {
+    return json({ error: (e as Error).message }, 400);
+  }
+  if (!verification.verified || !verification.registrationInfo) return json({ error: 'Verification failed' }, 400);
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  if (await findCredentialById(credential.id)) return json({ error: 'Credential already registered' }, 409);
+
+  const { name, providerIcon } = await describeAuthenticator(aaguid, context.request.headers.get('user-agent') || '');
+  const saved = await saveCredential({
+    id: credential.id,
+    passkeyUserId: user.id,
+    credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    credentialType: 'public-key',
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    providerIcon,
+    name,
+    transports: credential.transports ?? [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  });
+  return json({ id: saved.id, name: saved.name });
+};
