+    list.map(({ id, name, providerIcon, aaguid, credentialDeviceType, credentialBackedUp, registeredAt, lastUsedAt }) => ({
+      id, name, providerIcon, aaguid, credentialDeviceType, credentialBackedUp, registeredAt, lastUsedAt,
+    })),
+  );
+};
