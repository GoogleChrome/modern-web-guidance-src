+import type { APIRoute } from 'astro';
+import { deleteCredential, findCredentialById, saveCredential } from '../../../lib/store';
+import { getSessionUser, hasRecentReauth, json } from '../../../lib/webauthn';
+
+async function authorize(context: Parameters<APIRoute>[0]) {
+  const user = await getSessionUser(context);
+  if (!user) return { error: json({ error: 'Not signed in' }, 401) };
+  const cred = await findCredentialById(context.params.id!);
+  if (!cred || cred.passkeyUserId !== user.id) return { error: json({ error: 'Credential not found.' }, 404) };
+  return { cred };
+}
+
+export const PUT: APIRoute = async (context) => {
+  const auth = await authorize(context);
+  if (auth.error) return auth.error;
+  const { name } = await context.request.json().catch(() => ({}));
+  if (typeof name !== 'string' || !name.trim() || name.length > 100) return json({ error: 'Invalid name' }, 400);
+  await saveCredential({ ...auth.cred!, name: name.trim() });
+  return json({ id: auth.cred!.id, name: name.trim() });
+};
+
+export const DELETE: APIRoute = async (context) => {
+  const auth = await authorize(context);
+  if (auth.error) return auth.error;
+  // Removing a credential is sensitive: require a recent passkey/password verification.
+  if (!(await hasRecentReauth(context))) return json({ error: 'reauth_required' }, 403);
+  await deleteCredential(auth.cred!.id);
+  return json({ success: true });
+};
