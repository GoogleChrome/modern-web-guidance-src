+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRp, json } from '../../../../lib/webauthn';
+
+export const POST: APIRoute = async (context) => {
+  const options = await generateAuthenticationOptions({
+    rpID: getRp(context).rpID,
+    allowCredentials: [], // discoverable credentials
+    userVerification: 'preferred',
+  });
+  // UV level is kept server-side so the client can't weaken it at verification time.
+  await context.session?.set('authentication', { challenge: options.challenge, userVerification: 'preferred' });
+  return json(options);
+};
