diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..04f35cd
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,241 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import {
+  passkeysSupported,
+  post,
+  reauthenticateWithPasskey,
+  registerPasskey,
+  signalAccepted,
+  signalUserDetails,
+} from '../lib/passkeyClient';
+
+interface Passkey {
+  id: string;
+  name: string;
+  providerIcon?: string;
+  credentialDeviceType: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+interface Props {
+  userId: string;
+  username: string;
+  displayName: string;
+}
+
+const base = import.meta.env.BASE_URL;
+const fmt = (t?: number) =>
+  t ? new Date(t).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'Never';
+
+const btn =
+  'py-1.5 px-3 border border-gray-300 rounded-md text-sm font-medium text-gray-900 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 disabled:opacity-60';
+
+export default function PasskeyManager({ userId, username, displayName: initialDisplayName }: Props) {
+  const [passkeys, setPasskeys] = useState<Passkey[] | null>(null);
+  const [supported, setSupported] = useState(false);
+  const [displayName, setDisplayName] = useState(initialDisplayName);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editName, setEditName] = useState('');
+  const [message, setMessage] = useState<{ type: 'error' | 'success'; text: string } | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const load = useCallback(async () => {
+    const res = await fetch(`${base}api/passkeys`);
+    if (!res.ok) return [];
+    const list: Passkey[] = await res.json();
+    setPasskeys(list);
+    return list;
+  }, []);
+
+  useEffect(() => {
+    passkeysSupported().then(setSupported);
+    // Keep the passkey provider's saved credentials in sync with the server on load.
+    load().then((list) => signalAccepted(userId, list.map((p) => p.id)));
+  }, [load, userId]);
+
+  const create = async () => {
+    setBusy(true);
+    setMessage(null);
+    const result = await registerPasskey();
+    const texts: Record<string, string> = {
+      created: 'Passkey created.',
+      exists: 'A passkey from this provider already exists for your account.',
+      unsupported: 'Passkeys are not supported on this device.',
+      error: 'Could not create the passkey. Please try again.',
+    };
+    if (result !== 'cancelled') setMessage({ type: result === 'created' ? 'success' : 'error', text: texts[result] });
+    await load();
+    setBusy(false);
+  };
+
+  const rename = async (id: string) => {
+    const res = await fetch(`${base}api/passkeys/${encodeURIComponent(id)}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ name: editName }),
+    });
+    if (res.ok) {
+      setEditingId(null);
+      await load(); // nickname is a server-side label only; no signal needed
+    } else {
+      setMessage({ type: 'error', text: 'Could not rename the passkey.' });
+    }
+  };
+
+  const remove = async (id: string) => {
+    if (!confirm('Delete this passkey? You will no longer be able to sign in with it.')) return;
+    setMessage(null);
+    const del = () => fetch(`${base}api/passkeys/${encodeURIComponent(id)}`, { method: 'DELETE' });
+    let res = await del();
+    if (res.status === 403 && (await res.clone().json().catch(() => ({}))).error === 'reauth_required') {
+      // Sensitive action: verify the user with one of their existing passkeys first.
+      if (!(await reauthenticateWithPasskey())) {
+        setMessage({ type: 'error', text: 'Verification is required to delete a passkey.' });
+        return;
+      }
+      res = await del();
+    }
+    if (!res.ok) {
+      setMessage({ type: 'error', text: 'Could not delete the passkey.' });
+      return;
+    }
+    const list = await load();
+    await signalAccepted(userId, list.map((p) => p.id));
+    setMessage({ type: 'success', text: 'Passkey deleted.' });
+  };
+
+  const saveDisplayName = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const res = await fetch(`${base}api/user`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ displayName }),
+    });
+    if (!res.ok) return setMessage({ type: 'error', text: 'Could not update your display name.' });
+    const user = await res.json();
+    setDisplayName(user.displayName);
+    await signalUserDetails(userId, user.username, user.displayName);
+    setMessage({ type: 'success', text: 'Display name updated.' });
+  };
+
+  const signOut = async () => {
+    await post('auth/logout');
+    window.location.href = base;
+  };
+
+  return (
+    <div className="max-w-2xl mx-auto space-y-8">
+      <div className="flex items-center justify-between">
+        <h1 className="text-2xl font-bold text-gray-800">Account</h1>
+        <button type="button" className={btn} onClick={signOut}>Sign out</button>
+      </div>
+
+      <div aria-live="polite">
+        {message && (
+          <div
+            role={message.type === 'error' ? 'alert' : 'status'}
+            className={`p-3 text-sm rounded-lg ${message.type === 'error' ? 'text-red-700 bg-red-100' : 'text-green-700 bg-green-100'}`}
+          >
+            {message.text}
+          </div>
+        )}
+      </div>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 className="text-lg font-semibold text-gray-800 mb-4">Profile</h2>
+        <form onSubmit={saveDisplayName} className="flex flex-wrap items-end gap-3">
+          <div>
+            <span className="block text-sm font-medium text-gray-700 mb-1">Username</span>
+            <span className="block py-2 text-gray-900">{username}</span>
+          </div>
+          <div className="flex-1 min-w-48">
+            <label htmlFor="displayName" className="block text-sm font-medium text-gray-700 mb-1">Display name</label>
+            <input
+              id="displayName"
+              value={displayName}
+              onChange={(e) => setDisplayName(e.target.value)}
+              required
+              maxLength={100}
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+          </div>
+          <button type="submit" className={btn}>Save</button>
+        </form>
+      </section>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex items-center justify-between mb-4">
+          <h2 className="text-lg font-semibold text-gray-800">Passkeys</h2>
+          {supported && (
+            <button type="button" className={btn} onClick={create} disabled={busy}>Create a passkey</button>
+          )}
+        </div>
+        {!supported && (
+          <p className="text-sm text-gray-600 mb-4">Passkeys aren&apos;t available on this device or browser.</p>
+        )}
+        {passkeys === null ? (
+          <p className="text-sm text-gray-600">Loading…</p>
+        ) : passkeys.length === 0 ? (
+          <p className="text-sm text-gray-600">No passkeys found.</p>
+        ) : (
+          <ul className="divide-y divide-gray-200">
+            {passkeys.map((p) => (
+              <li key={p.id} className="py-3 flex items-center gap-3">
+                {p.providerIcon ? (
+                  <img src={p.providerIcon} alt="" width={32} height={32} className="shrink-0" />
+                ) : (
+                  <div className="w-8 h-8 shrink-0 rounded bg-gray-200" aria-hidden="true" />
+                )}
+                <div className="flex-1 min-w-0">
+                  {editingId === p.id ? (
+                    <form
+                      onSubmit={(e) => {
+                        e.preventDefault();
+                        rename(p.id);
+                      }}
+                      className="flex gap-2"
+                    >
+                      <input
+                        aria-label="Passkey name"
+                        value={editName}
+                        onChange={(e) => setEditName(e.target.value)}
+                        required
+                        maxLength={100}
+                        autoFocus
+                        className="flex-1 px-2 py-1 border border-gray-300 rounded-md"
+                      />
+                      <button type="submit" className={btn}>Save</button>
+                      <button type="button" className={btn} onClick={() => setEditingId(null)}>Cancel</button>
+                    </form>
+                  ) : (
+                    <>
+                      <p className="font-medium text-gray-900 truncate">{p.name}</p>
+                      <p className="text-xs text-gray-500">
+                        {p.credentialDeviceType === 'multiDevice' ? 'Synced · ' : ''}Created {fmt(p.registeredAt)} · Last used {fmt(p.lastUsedAt)}
+                      </p>
+                    </>
+                  )}
+                </div>
+                {editingId !== p.id && (
+                  <div className="flex gap-2">
+                    <button
+                      type="button"
+                      className={btn}
+                      onClick={() => {
+                        setEditingId(p.id);
+                        setEditName(p.name);
+                      }}
+                    >
+                      Rename
+                    </button>
+                    <button type="button" className={btn} onClick={() => remove(p.id)}>Delete</button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+    </div>
+  );
+}
