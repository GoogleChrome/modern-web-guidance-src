+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { findCredentialById, findUserById, saveCredential } from '../../../../lib/store';
+import { getRp, json } from '../../../../lib/webauthn';
+
+export const POST: APIRoute = async (context) => {
+  const pending = await context.session?.get('authentication');
+  await context.session?.delete('authentication');
+  if (!pending) return json({ error: 'No authentication in progress' }, 400);
+
+  const body = await context.request.json().catch(() => null);
+  if (!body?.id) return json({ error: 'Invalid request' }, 400);
+
+  const stored = await findCredentialById(body.id);
+  if (!stored) return json({ error: 'Credential not found' }, 404);
+  const user = await findUserById(stored.passkeyUserId);
+  if (!user) return json({ error: 'Credential not found' }, 404);
+
+  const { rpID, origin } = getRp(context);
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: body,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: pending.userVerification === 'required',
+      credential: {
+        id: stored.id,
+        publicKey: Buffer.from(stored.credentialPublicKey, 'base64url'),
+        counter: stored.counter,
+        transports: stored.transports as AuthenticatorTransport[],
+      },
+    });
+  } catch (e) {
+    return json({ error: (e as Error).message }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Verification failed' }, 400);
+
+  await saveCredential({
+    ...stored,
+    counter: verification.authenticationInfo.newCounter,
+    credentialBackedUp: verification.authenticationInfo.credentialBackedUp,
+    lastUsedAt: Date.now(),
+  });
+  await context.session?.regenerate();
+  await context.session?.set('userId', user.id);
+  await context.session?.set('reauthAt', Date.now());
+  return json({ user: { username: user.username, displayName: user.displayName } });
+};
