--- /dev/null
+++ b/src/lib/webauthn.ts
@@ -0,0 +1,52 @@
+import type { APIContext } from 'astro';
+import { findUserById, type User } from './store';
+
+export const RP_NAME = 'The DevTools Times';
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+/** RP ID and origin; override with env vars when behind a proxy that rewrites the host. */
+export function getRp(context: Pick<APIContext, 'url' | 'request'>) {
+  const url = context.url;
+  return {
+    rpID: process.env.PASSKEY_RP_ID || url.hostname,
+    origin: process.env.PASSKEY_ORIGIN || url.origin,
+  };
+}
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+export async function getSessionUser(context: Pick<APIContext, 'session'>): Promise<User | undefined> {
+  const userId = await context.session?.get('userId');
+  return userId ? findUserById(userId) : undefined;
+}
+
+export async function hasRecentReauth(context: Pick<APIContext, 'session'>) {
+  const at = await context.session?.get('reauthAt');
+  return typeof at === 'number' && Date.now() - at < REAUTH_WINDOW_MS;
+}
+
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+const AAGUID_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+
+let registry: Promise<Record<string, { name: string; icon_light?: string }>> | undefined;
+
+/** AAGUID is used for UX hints only, never for security decisions. */
+export async function describeAuthenticator(aaguid: string, userAgent: string) {
+  if (aaguid !== ZERO_AAGUID) {
+    registry ??= fetch(AAGUID_URL, { signal: AbortSignal.timeout(5000) })
+      .then((r) => (r.ok ? r.json() : {}))
+      .catch(() => {
+        registry = undefined; // retry next time
+        return {};
+      });
+    const entry = (await registry)[aaguid];
+    if (entry) return { name: entry.name, providerIcon: entry.icon_light };
+    return { name: 'Unknown passkey provider', providerIcon: undefined };
+  }
+  const os = /Windows/.test(userAgent) ? 'Windows' : /Android/.test(userAgent) ? 'Android'
+    : /iPhone|iPad/.test(userAgent) ? 'iOS' : /Mac OS/.test(userAgent) ? 'macOS'
+    : /Linux/.test(userAgent) ? 'Linux' : '';
+  return { name: os ? `${os} passkey` : 'Unknown passkey provider', providerIcon: undefined };
+}
