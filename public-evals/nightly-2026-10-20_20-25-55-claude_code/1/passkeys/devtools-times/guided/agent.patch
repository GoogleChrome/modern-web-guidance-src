new file mode 100644
index 0000000..d9b36a3
--- /dev/null
+++ b/src/lib/store.ts
@@ -0,0 +1,103 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+export interface User {
+  id: string; // Base64URL-encoded random user handle
+  username: string;
+  displayName: string;
+}
+
+export interface StoredPasskeyCredential {
+  id: string;
+  passkeyUserId: string;
+  credentialPublicKey: string;
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: string;
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+interface Data {
+  users: User[];
+  credentials: StoredPasskeyCredential[];
+}
+
+const FILE = process.env.PASSKEY_DB_FILE || path.join(process.cwd(), 'data', 'passkeys.json');
+
+// Serialize all read-modify-write cycles so concurrent requests don't clobber each other.
+let queue: Promise<unknown> = Promise.resolve();
+
+async function read(): Promise<Data> {
+  try {
+    return JSON.parse(await fs.readFile(FILE, 'utf8'));
+  } catch {
+    return { users: [], credentials: [] };
+  }
+}
+
+function run<T>(fn: (data: Data) => T | Promise<T>, write: boolean): Promise<T> {
+  const next = queue.then(async () => {
+    const data = await read();
+    const result = await fn(data);
+    if (write) {
+      await fs.mkdir(path.dirname(FILE), { recursive: true });
+      const tmp = `${FILE}.${process.pid}.tmp`;
+      await fs.writeFile(tmp, JSON.stringify(data, null, 2));
+      await fs.rename(tmp, FILE);
+    }
+    return result;
+  });
+  queue = next.catch(() => {});
+  return next;
+}
+
+export const findUserById = (id: string) => run((d) => d.users.find((u) => u.id === id), false);
+
+export const findUserByUsername = (username: string) =>
+  run((d) => d.users.find((u) => u.username.toLowerCase() === username.toLowerCase()), false);
+
+export const getOrCreateUser = (username: string) =>
+  run((d) => {
+    let user = d.users.find((u) => u.username.toLowerCase() === username.toLowerCase());
+    if (!user) {
+      user = { id: randomBytes(32).toString('base64url'), username, displayName: username };
+      d.users.push(user);
+    }
+    return user;
+  }, true);
+
+export const updateUser = (id: string, patch: Partial<Pick<User, 'username' | 'displayName'>>) =>
+  run((d) => {
+    const user = d.users.find((u) => u.id === id);
+    if (!user) return undefined;
+    if (patch.username && d.users.some((u) => u.id !== id && u.username.toLowerCase() === patch.username!.toLowerCase())) {
+      throw new Error('USERNAME_TAKEN');
+    }
+    Object.assign(user, patch);
+    return user;
+  }, true);
+
+export const findCredentialsByUserId = (userId: string) =>
+  run((d) => d.credentials.filter((c) => c.passkeyUserId === userId), false);
+
+export const findCredentialById = (id: string) => run((d) => d.credentials.find((c) => c.id === id), false);
+
+export const saveCredential = (cred: StoredPasskeyCredential) =>
+  run((d) => {
+    const i = d.credentials.findIndex((c) => c.id === cred.id);
+    if (i >= 0) d.credentials[i] = cred;
+    else d.credentials.push(cred);
+    return cred;
+  }, true);
+
+export const deleteCredential = (id: string) =>
+  run((d) => {
+    d.credentials = d.credentials.filter((c) => c.id !== id);
+  }, true);
diff --git a/src/lib/webauthn.ts b/src/lib/webauthn.ts
