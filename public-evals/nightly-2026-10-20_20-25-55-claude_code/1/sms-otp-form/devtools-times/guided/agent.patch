@@ -0,0 +1,24 @@
+import type { APIRoute } from 'astro';
+import { checkVerification, normalizePhone, startVerification } from '../../lib/phone-verification';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+// POST { phone } -> sends an SMS code
+export const POST: APIRoute = async ({ request, url }) => {
+  const { phone } = await request.json().catch(() => ({}));
+  const normalized = typeof phone === 'string' ? normalizePhone(phone) : null;
+  if (!normalized) return json({ error: 'Enter a valid phone number including country code, e.g. +14155550123.' }, 400);
+  await startVerification(normalized, url.hostname);
+  return json({ ok: true });
+};
+
+// PUT { phone, code } -> verifies the code
+export const PUT: APIRoute = async ({ request }) => {
+  const { phone, code } = await request.json().catch(() => ({}));
+  const normalized = typeof phone === 'string' ? normalizePhone(phone) : null;
+  if (!normalized || typeof code !== 'string' || !/^\d{6}$/.test(code) || !checkVerification(normalized, code)) {
+    return json({ error: 'That code is incorrect or has expired.' }, 400);
+  }
+  return json({ ok: true });
+};
