diff --git a/src/lib/phone-verification.ts b/src/lib/phone-verification.ts
new file mode 100644
index 0000000..12b110c
--- /dev/null
+++ b/src/lib/phone-verification.ts
@@ -0,0 +1,51 @@
+import { randomInt, timingSafeEqual } from 'node:crypto';
+
+const CODE_TTL_MS = 5 * 60 * 1000;
+const MAX_ATTEMPTS = 5;
+
+interface Challenge {
+  code: string;
+  expiresAt: number;
+  attempts: number;
+}
+
+// In-memory store: replace with a shared store (e.g. Redis) when running multiple instances.
+const challenges = new Map<string, Challenge>();
+
+export function normalizePhone(input: string): string | null {
+  const phone = input.replace(/[\s().-]/g, '');
+  return /^\+[1-9]\d{7,14}$/.test(phone) ? phone : null;
+}
+
+/**
+ * The last line must be `@<host> #<code>` so browsers can verify the origin
+ * before offering the code (WebOTP and Safari's one-time-code autofill).
+ */
+export function formatSmsMessage(code: string, host: string): string {
+  return `Your DevTools Times verification code is ${code}.\n\n@${host} #${code}`;
+}
+
+async function sendSms(phone: string, message: string) {
+  // TODO: Connect an SMS provider (e.g. Twilio). Logged for local development only.
+  console.info(`[sms] to ${phone}:\n${message}`);
+}
+
+export async function startVerification(phone: string, host: string) {
+  const code = randomInt(0, 1_000_000).toString().padStart(6, '0');
+  challenges.set(phone, { code, expiresAt: Date.now() + CODE_TTL_MS, attempts: 0 });
+  await sendSms(phone, formatSmsMessage(code, host));
+}
+
+export function checkVerification(phone: string, code: string): boolean {
+  const challenge = challenges.get(phone);
+  if (!challenge || challenge.expiresAt < Date.now() || challenge.attempts >= MAX_ATTEMPTS) {
+    challenges.delete(phone);
+    return false;
+  }
+  challenge.attempts++;
+  const a = Buffer.from(challenge.code);
+  const b = Buffer.from(code);
+  if (a.length !== b.length || !timingSafeEqual(a, b)) return false;
+  challenges.delete(phone);
+  return true;
+}
