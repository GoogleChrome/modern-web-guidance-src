+  <script>
+    (() => {
+      // Endpoints expected on the backend. If they're missing (static preview),
+      // the form falls back to a demo where the code is 123456.
+      const API = { send: '/api/otp/send', verify: '/api/otp/verify' };
+      const DEMO_CODE = '123456';
+      const RESEND_SECONDS = 30;
+
+      const $ = (id) => document.getElementById(id);
+      const phoneForm = $('phone-form'), otpForm = $('otp-form');
+      const phone = $('phone'), otp = $('otp');
+      const status = $('verify-status');
+      const sendBtn = $('send-btn'), verifyBtn = $('verify-btn'), resendBtn = $('resend-btn');
+      let e164 = '', timer = null, abortOtp = null;
+
+      const toE164 = (raw) => {
+        const d = raw.replace(/\D/g, '');
+        if (d.length === 10) return '+1' + d;
+        if (d.length === 11 && d[0] === '1') return '+' + d;
+        return null;
+      };
+      const pretty = (e) => `(${e.slice(2, 5)}) ${e.slice(5, 8)}-${e.slice(8)}`;
+
+      const setError = (input, el, msg) => {
+        el.textContent = msg;
+        if (msg) input.setAttribute('aria-invalid', 'true');
+        else input.removeAttribute('aria-invalid');
+      };
+
+      async function post(url, body) {
+        try {
+          const res = await fetch(url, {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(body),
+          });
+          if (res.status === 404) return { demo: true };
+          const data = await res.json().catch(() => ({}));
+          return { ok: res.ok, data };
+        } catch {
+          return { demo: true };
+        }
+      }
+
+      function startCooldown() {
+        let left = RESEND_SECONDS;
+        resendBtn.disabled = true;
+        clearInterval(timer);
+        const tick = () => {
+          resendBtn.textContent = left > 0 ? `Resend code in ${left}s` : 'Resend code';
+          if (left-- <= 0) { clearInterval(timer); resendBtn.disabled = false; }
+        };
+        tick();
+        timer = setInterval(tick, 1000);
+      }
+
+      // Extract code from the SMS automatically via the WebOTP API (Chromium on Android).
+      // The SMS must end with: "@<this-domain> #<code>".
+      async function listenForSms() {
+        if (!('OTPCredential' in window)) return;
+        abortOtp?.abort();
+        abortOtp = new AbortController();
+        try {
+          const cred = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: abortOtp.signal });
+          const code = (cred?.code || '').match(/\d{6}/)?.[0];
+          if (code) {
+            otp.value = code;
+            status.textContent = 'Code received from SMS.';
+            otpForm.requestSubmit();
+          }
+        } catch { /* aborted or dismissed */ }
+      }
+
+      phoneForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        await sendCode();
+      });
+
+      async function sendCode() {
+        e164 = toE164(phone.value) || '';
+        if (!e164) {
+          setError(phone, $('phone-error'), 'Enter a valid 10-digit US phone number.');
+          phone.focus();
+          return;
+        }
+        setError(phone, $('phone-error'), '');
+        sendBtn.disabled = true;
+        status.textContent = 'Sending code…';
+        const r = await post(API.send, { phone: e164 });
+        sendBtn.disabled = false;
+        if (!r.demo && !r.ok) {
+          status.textContent = '';
+          setError(phone, $('phone-error'), r.data?.error || 'Could not send the code. Please try again.');
+          phone.focus();
+          return;
+        }
+        $('sent-to').textContent = pretty(e164);
+        phoneForm.hidden = true;
+        otpForm.hidden = false;
+        otp.value = '';
+        setError(otp, $('otp-error'), '');
+        status.textContent = r.demo ? 'Demo mode: no SMS service connected. Use code 123456.' : 'Code sent.';
+        otp.focus();
+        startCooldown();
+        listenForSms();
+      }
+
+      // Keep only digits (handles pasted "123 456" or "Your code is 123456").
+      otp.addEventListener('input', () => {
+        const v = otp.value;
+        const m = v.match(/\d{6}/);
+        otp.value = (m ? m[0] : v.replace(/\D/g, '')).slice(0, 6);
+        setError(otp, $('otp-error'), '');
+        if (otp.value.length === 6) otpForm.requestSubmit();
+      });
+
+      otpForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        if (verifyBtn.disabled) return;
+        if (!/^\d{6}$/.test(otp.value)) {
+          setError(otp, $('otp-error'), 'Enter the 6-digit code.');
+          otp.focus();
+          return;
+        }
+        verifyBtn.disabled = true;
+        status.textContent = 'Verifying…';
+        const r = await post(API.verify, { phone: e164, code: otp.value });
+        verifyBtn.disabled = false;
+        const valid = r.demo ? otp.value === DEMO_CODE : r.ok;
+        if (!valid) {
+          status.textContent = '';
+          setError(otp, $('otp-error'), r.data?.error || 'That code is incorrect or expired.');
+          otp.select();
+          return;
+        }
+        abortOtp?.abort();
+        clearInterval(timer);
+        otpForm.hidden = true;
+        status.className = 'status success';
+        status.textContent = `Thanks! ${pretty(e164)} is verified.`;
+      });
+
+      resendBtn.addEventListener('click', resendCode);
+      async function resendCode() {
+        resendBtn.disabled = true;
+        const r = await post(API.send, { phone: e164 });
+        if (!r.demo && !r.ok) {
+          status.textContent = r.data?.error || 'Could not resend the code.';
+          resendBtn.disabled = false;
+          return;
+        }
+        status.textContent = 'New code sent.';
+        otp.value = '';
+        otp.focus();
+        startCooldown();
+        listenForSms();
+      }
+
+      $('change-btn').addEventListener('click', () => {
+        abortOtp?.abort();
+        clearInterval(timer);
+        otpForm.hidden = true;
+        phoneForm.hidden = false;
+        status.textContent = '';
+        phone.focus();
+      });
+    })();
+  </script>
 </body>
 
