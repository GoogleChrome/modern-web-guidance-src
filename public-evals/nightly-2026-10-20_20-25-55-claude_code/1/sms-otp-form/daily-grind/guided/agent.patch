+  <script>
+    const phoneForm = document.getElementById('phone-form');
+    const phoneInput = document.getElementById('phone-input');
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const statusEl = document.getElementById('verify-status');
+    const sentTo = document.getElementById('sent-to');
+
+    let otpAbortController = null;
+
+    function setStatus(message, state = 'info') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      if (!('OTPCredential' in window)) return;
+
+      // Cancel any previous pending request (e.g. when re-sending a code)
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+
+      try {
+        const otp = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: ac.signal });
+        if (!otp) return;
+        otpInput.value = otp.code;
+        otpForm.requestSubmit();
+      } catch (err) {
+        if (err && err.name === 'AbortError') return;
+        console.error('WebOTP verification error:', err);
+      }
+    }
+
+    async function post(form, data) {
+      const res = await fetch(form.action, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(data),
+      });
+      if (!res.ok) throw new Error(String(res.status));
+    }
+
+    async function sendCode() {
+      setStatus('Sending code…');
+      try {
+        await post(phoneForm, { phone: phoneInput.value.trim() });
+      } catch {
+        setStatus('We couldn\u2019t send a code. Check the number and try again.', 'error');
+        return false;
+      }
+      sentTo.textContent = phoneInput.value.trim();
+      phoneForm.hidden = true;
+      otpForm.hidden = false;
+      otpInput.value = '';
+      otpInput.focus();
+      setStatus('Code sent. Check your text messages.');
+      startSmsOtpListener();
+      return true;
+    }
+
+    phoneForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const btn = phoneForm.querySelector('[type="submit"]');
+      btn.disabled = true;
+      const ok = await sendCode();
+      btn.disabled = false;
+      if (!ok) phoneInput.focus();
+    });
+
+    otpForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      stopSmsOtpListener();
+      const btn = otpForm.querySelector('[type="submit"]');
+      btn.disabled = true;
+      setStatus('Verifying…');
+      try {
+        await post(otpForm, { phone: phoneInput.value.trim(), otp: otpInput.value });
+        otpForm.hidden = true;
+        setStatus('Your phone number is verified. Thank you!', 'success');
+      } catch {
+        btn.disabled = false;
+        setStatus('That code didn\u2019t work. Check it and try again, or request a new one.', 'error');
+        otpInput.select();
+        startSmsOtpListener();
+      }
+    });
+
+    document.getElementById('resend-btn').addEventListener('click', async () => {
+      await sendCode();
+      if (!otpForm.hidden) setStatus('A new code was sent.');
+    });
+
+    document.getElementById('change-phone-btn').addEventListener('click', () => {
+      stopSmsOtpListener();
+      otpForm.hidden = true;
+      phoneForm.hidden = false;
+      setStatus('');
+      phoneInput.focus();
+    });
+
+    window.addEventListener('pagehide', stopSmsOtpListener);
+  </script>
 </body>
 
