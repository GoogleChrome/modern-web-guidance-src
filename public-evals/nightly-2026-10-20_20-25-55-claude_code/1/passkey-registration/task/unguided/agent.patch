+  <script>
+    (function () {
+      const button = document.querySelector('[data-testid="register-button"]');
+      const status = document.getElementById('register-status');
+
+      function setStatus(message) {
+        status.textContent = message; // textContent only: never inject server data as HTML
+      }
+
+      function b64urlToBuffer(value) {
+        const b64 = value.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(value.length / 4) * 4, '=');
+        const bin = atob(b64);
+        const bytes = new Uint8Array(bin.length);
+        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function bufferToB64url(buffer) {
+        const bytes = new Uint8Array(buffer);
+        let bin = '';
+        for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
+        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      // Convert server JSON options into WebAuthn options (prefers the native parser).
+      function parseCreationOptions(json) {
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+        }
+        const options = Object.assign({}, json);
+        options.challenge = b64urlToBuffer(json.challenge);
+        options.user = Object.assign({}, json.user, { id: b64urlToBuffer(json.user.id) });
+        if (json.excludeCredentials) {
+          options.excludeCredentials = json.excludeCredentials.map(function (c) {
+            return Object.assign({}, c, { id: b64urlToBuffer(c.id) });
+          });
+        }
+        return options;
+      }
+
+      // Serialize the created credential for the server (prefers the native serializer).
+      function serializeCredential(credential) {
+        if (typeof credential.toJSON === 'function') {
+          return credential.toJSON();
+        }
+        const response = credential.response;
+        const out = {
+          id: credential.id,
+          rawId: bufferToB64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment || undefined,
+          clientExtensionResults: credential.getClientExtensionResults(),
+          response: {
+            clientDataJSON: bufferToB64url(response.clientDataJSON),
+            attestationObject: bufferToB64url(response.attestationObject)
+          }
+        };
+        if (typeof response.getTransports === 'function') {
+          out.response.transports = response.getTransports();
+        }
+        return out;
+      }
+
+      async function postJSON(url, body) {
+        const res = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(body)
+        });
+        if (!res.ok) {
+          throw new Error('Request to ' + url + ' failed (' + res.status + ')');
+        }
+        return res.json();
+      }
+
+      async function registerPasskey() {
+        if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials) {
+          setStatus('Passkeys are not supported in this browser.');
+          return;
+        }
+
+        button.disabled = true;
+        setStatus('Waiting for your device…');
+        try {
+          // Challenge, RP ID, and user info are all generated server-side.
+          const optionsJSON = await postJSON('/api/register/options', { promotion: true });
+          const credential = await navigator.credentials.create({
+            publicKey: parseCreationOptions(optionsJSON.publicKey || optionsJSON)
+          });
+          if (!credential) {
+            throw new Error('No credential was created');
+          }
+
+          // The server must verify the challenge, origin, and RP ID before storing anything.
+          const result = await postJSON('/api/register/verify', serializeCredential(credential));
+          if (result && result.verified === false) {
+            throw new Error('Verification rejected');
+          }
+          setStatus('Passkey created! You can now use it to sign in.');
+        } catch (err) {
+          if (err && (err.name === 'NotAllowedError' || err.name === 'AbortError')) {
+            setStatus('Passkey creation was cancelled.');
+          } else if (err && err.name === 'InvalidStateError') {
+            setStatus('A passkey already exists for this account on this device.');
+          } else {
+            setStatus('Sorry, we could not create your passkey. Please try again.');
+          }
+        } finally {
+          button.disabled = false;
+        }
+      }
+
+      button.addEventListener('click', registerPasskey);
+    })();
+  </script>
 </body>
 
