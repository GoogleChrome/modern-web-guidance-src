+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const beans = [...scroller.querySelectorAll('.bean')];
+    let scrolling = false;
+
+    // Scroll handler: constant-time, writes the DOM once per scroll gesture.
+    scroller.addEventListener('scroll', () => {
+      if (scrolling) return;
+      scrolling = true;
+      status.textContent = 'Scrolling...';
+    }, { passive: true });
+
+    // Layout reads happen only once scrolling has settled.
+    function onScrollEnd() {
+      scrolling = false;
+      const box = scroller.getBoundingClientRect();
+      let best = null;
+      let bestVisible = -1;
+      for (const bean of beans) {
+        const r = bean.getBoundingClientRect();
+        const visible = Math.min(r.right, box.right) - Math.max(r.left, box.left);
+        if (visible > bestVisible) {
+          bestVisible = visible;
+          best = bean;
+        }
+      }
+      status.textContent = `Scroll ended. Visible: ${best.dataset.origin}`;
+    }
+
+    if ('onscrollend' in window) {
+      scroller.addEventListener('scrollend', onScrollEnd);
+    } else {
+      // Fallback: debounced scroll dispatches a synthetic scrollend.
+      let timer;
+      scroller.addEventListener('scroll', () => {
+        clearTimeout(timer);
+        timer = setTimeout(onScrollEnd, 100);
+      }, { passive: true });
+    }
+  </script>
