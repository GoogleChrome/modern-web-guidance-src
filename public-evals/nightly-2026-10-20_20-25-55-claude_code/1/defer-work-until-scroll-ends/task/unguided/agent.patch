+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      const beans = Array.from(scroller.querySelectorAll('.bean'));
+      const hasScrollEnd = 'onscrollend' in window;
+      let scrolling = false;
+      let endTimer;
+
+      // Measured only once scrolling stops, never per scroll event.
+      function mostVisibleOrigin() {
+        const view = scroller.getBoundingClientRect();
+        let best = null;
+        let bestVisible = -1;
+        for (const bean of beans) {
+          const r = bean.getBoundingClientRect();
+          const visible = Math.min(r.right, view.right) - Math.max(r.left, view.left);
+          if (visible > bestVisible) {
+            bestVisible = visible;
+            best = bean;
+          }
+        }
+        return best.dataset.origin;
+      }
+
+      function onScrollEnd() {
+        scrolling = false;
+        status.textContent = 'Scroll ended. Visible: ' + mostVisibleOrigin();
+      }
+
+      // Scroll-active path: a flag check, and a single DOM write per scroll gesture.
+      scroller.addEventListener('scroll', function () {
+        if (!scrolling) {
+          scrolling = true;
+          status.textContent = 'Scrolling...';
+        }
+        // Fallback for browsers without the scrollend event.
+        if (!hasScrollEnd) {
+          clearTimeout(endTimer);
+          endTimer = setTimeout(onScrollEnd, 150);
+        }
+      }, { passive: true });
+
+      if (hasScrollEnd) {
+        scroller.addEventListener('scrollend', onScrollEnd);
+      }
+    })();
+  </script>
+
