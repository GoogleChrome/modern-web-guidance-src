+# Third-party service audit
+
+Review this list whenever an integration is added or changed. Any new origin must also be added to the CSP in `src/middleware.ts` and to the privacy policy.
+
+| Service | Origin | Data shared | Loaded | Controls |
+|---|---|---|---|---|
+| Google Fonts | fonts.googleapis.com, fonts.gstatic.com | IP, user agent | Always | CSP-restricted; candidate for self-hosting to remove the dependency |
+| Analytics client | us-central1-web-devrel-apps.cloudfunctions.net | Usage events, IP | Only after opt-in; never with DNT/GPC | `public/consent.js`; `no-referrer`; CSP `script-src`/`connect-src` |
+| Auth API | same host, `/times_cdn/api/{login,register}` | Username, password | On form submit | `credentials: omit`, `no-referrer`, `no-store` |
+| Ad client | same host, `ad-client.js` | n/a | Disabled (commented out in `Layout.astro`) | If re-enabled, gate behind consent like analytics |
+| Teaser image | cinemai-1026410574114.us-central1.run.app | IP | Home page | CSP `img-src`; candidate for self-hosting |
+
+## Open items
+- Subresource Integrity is not applied to the analytics script because it is mutable and served by a third party; pin a versioned URL plus SRI if one becomes available.
+- CSP uses `'unsafe-inline'` for scripts because of Astro island hydration; migrate to Astro's CSP/nonce support when feasible.
diff --git a/public/consent.js b/public/consent.js
new file mode 100644
index 0000000..bc94635
--- /dev/null
+++ b/public/consent.js
@@ -0,0 +1,50 @@
+// Privacy-by-design consent manager: third-party analytics loads only with explicit opt-in.
+(function () {
+  var KEY = 'analytics-consent';
+  var SRC = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+  var optedOut = navigator.doNotTrack === '1' || navigator.globalPrivacyControl === true;
+
+  function read() {
+    try { return localStorage.getItem(KEY); } catch (e) { return null; }
+  }
+  function write(v) {
+    try { localStorage.setItem(KEY, v); } catch (e) { /* storage unavailable: treat as declined */ }
+  }
+  function loadAnalytics() {
+    if (document.querySelector('script[data-analytics]')) return;
+    var s = document.createElement('script');
+    s.src = SRC;
+    s.defer = true;
+    s.referrerPolicy = 'no-referrer';
+    s.crossOrigin = 'anonymous';
+    s.setAttribute('data-analytics', '');
+    document.head.appendChild(s);
+  }
+  function banner() { return document.getElementById('consent-banner'); }
+  function show(open) {
+    var b = banner();
+    if (b) b.hidden = !open;
+  }
+  function decide(accepted) {
+    write(accepted && !optedOut ? 'granted' : 'denied');
+    show(false);
+    if (accepted && !optedOut) loadAnalytics();
+  }
+
+  if (!optedOut && read() === 'granted') loadAnalytics();
+
+  document.addEventListener('astro:page-load', function () {
+    show(!optedOut && read() === null);
+  });
+  document.addEventListener('DOMContentLoaded', function () {
+    show(!optedOut && read() === null);
+  });
+  document.addEventListener('click', function (e) {
+    var t = e.target.closest && e.target.closest('[data-consent-accept],[data-consent-decline],[data-consent-open]');
+    if (!t) return;
+    e.preventDefault();
+    if (t.hasAttribute('data-consent-accept')) decide(true);
+    else if (t.hasAttribute('data-consent-decline')) decide(false);
+    else show(true);
+  });
+})();
