new file mode 100644
index 0000000..9d53efd
--- /dev/null
+++ b/docs/THIRD_PARTIES.md
@@ -0,0 +1,18 @@
+# Third-party register and audit checklist
+
+Review this file (and the CSP in `src/middleware.ts`) before adding or changing any external service, and at least quarterly.
+
+| Service | Origin | Purpose | Data received | Loaded | Safeguards |
+|---|---|---|---|---|---|
+| Analytics client | `us-central1-web-devrel-apps.cloudfunctions.net` | Usage analytics | Page views, browser metadata, IP | Only after opt-in; never with GPC/DNT | Consent gate (`ConsentBanner.astro`), `referrerPolicy=no-referrer`, CSP allowlist. No SRI possible: script is mutable — ask vendor for versioned URL + hash. |
+| Account API (`/api/login`, `/api/register`) | same host | Authentication | Username, password | On form submit | `credentials: omit`, `no-referrer`, no token in web storage, generic error text |
+| Google Fonts | `fonts.googleapis.com`, `fonts.gstatic.com` | Brand typeface | IP, UA | Page load | CSP allowlist. Preferred follow-up: self-host Grenze to remove the transfer. |
+| Ad network (disabled) | — | Ads | — | Commented out in layout | Must be gated behind consent and added to CSP before enabling. |
+
+## Audit checklist
+- [ ] Purpose and legal basis documented; data minimal for that purpose
+- [ ] Data processing agreement in place
+- [ ] Consent gate if non-essential
+- [ ] Origin pinned in CSP (`script-src`, `connect-src`)
+- [ ] Privacy policy updated
+- [ ] SRI / versioned URL where the vendor supports it
diff --git a/src/components/ConsentBanner.astro b/src/components/ConsentBanner.astro
new file mode 100644
index 0000000..1ec5533
--- /dev/null
+++ b/src/components/ConsentBanner.astro
@@ -0,0 +1,74 @@
+---
+const privacyUrl = `${import.meta.env.BASE_URL}legal/privacy`;
+---
+<div
+  id="consent-banner"
+  hidden
+  role="region"
+  aria-label="Privacy preferences"
+  class="fixed bottom-0 inset-x-0 z-[100] bg-gray-900 text-white p-4 text-sm"
+>
+  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row gap-3 sm:items-center justify-between">
+    <p>
+      We only run anonymous usage analytics if you allow it. Nothing is loaded from analytics
+      providers until then. <a href={privacyUrl} class="underline">Privacy Policy</a>
+    </p>
+    <div class="flex gap-2 shrink-0">
+      <button type="button" data-consent="denied" class="px-4 py-2 border border-white rounded-md">Decline</button>
+      <button type="button" data-consent="granted" class="px-4 py-2 bg-white text-gray-900 rounded-md">Allow analytics</button>
+    </div>
+  </div>
+</div>
+
+<script is:inline>
+  (function () {
+    var KEY = 'analytics-consent';
+    var SRC = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+    if (window.__consentInit) return;
+    window.__consentInit = true;
+
+    // Global Privacy Control / Do Not Track are treated as a standing opt-out.
+    var optedOut = navigator.globalPrivacyControl === true || navigator.doNotTrack === '1';
+
+    function load() {
+      if (document.querySelector('script[data-analytics]')) return;
+      var s = document.createElement('script');
+      s.src = SRC;
+      s.defer = true;
+      s.referrerPolicy = 'no-referrer';
+      s.setAttribute('data-analytics', '');
+      document.head.appendChild(s);
+    }
+    function read() {
+      try { return localStorage.getItem(KEY); } catch (e) { return null; }
+    }
+    function write(v) {
+      try { localStorage.setItem(KEY, v); } catch (e) {}
+    }
+    function banner() { return document.getElementById('consent-banner'); }
+
+    window.openPrivacyPreferences = function () {
+      var b = banner();
+      if (b) b.hidden = false;
+    };
+
+    function init() {
+      var b = banner();
+      if (b && !b.dataset.bound) {
+        b.dataset.bound = '1';
+        b.addEventListener('click', function (e) {
+          var t = e.target.closest('[data-consent]');
+          if (!t) return;
+          write(t.dataset.consent);
+          b.hidden = true;
+          if (t.dataset.consent === 'granted' && !optedOut) load();
+        });
+      }
+      var v = read();
+      if (v === 'granted' && !optedOut) load();
+      else if (v === null && !optedOut && b) b.hidden = false;
+    }
+    init();
+    document.addEventListener('astro:page-load', init);
+  })();
+</script>
