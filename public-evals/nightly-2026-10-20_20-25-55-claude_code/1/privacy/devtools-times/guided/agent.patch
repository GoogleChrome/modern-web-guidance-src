 import { defineMiddleware } from 'astro:middleware';
 
+const THIRD_PARTY_CDN = 'https://us-central1-web-devrel-apps.cloudfunctions.net';
+
+// Every external origin the site may contact. Keep in sync with docs/THIRD_PARTIES.md.
+const CSP = [
+  "default-src 'self'",
+  // Astro and the consent gate emit inline scripts; analytics is only injected after opt-in.
+  `script-src 'self' 'unsafe-inline' ${THIRD_PARTY_CDN}`,
