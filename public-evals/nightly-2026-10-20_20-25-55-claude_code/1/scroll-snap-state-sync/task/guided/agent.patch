+  <script>
+    (() => {
+      const panel = document.querySelector('.seasonal-panel');
+      const links = [...document.querySelectorAll('.toc-sidebar a')];
+      const sections = [...panel.querySelectorAll('.drink-section')];
+
+      const setCurrent = (id) => {
+        links.forEach((link) => {
+          if (link.getAttribute('href') === `#${id}`) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      };
+
+      setCurrent(sections[0].id);
+
+      if ('onscrollsnapchange' in window) {
+        panel.addEventListener('scrollsnapchange', (event) => {
+          const section = event.snapTargetBlock?.closest('.drink-section');
+          if (section) setCurrent(section.id);
+        });
+      } else {
+        // Fallback: track whichever section occupies the middle of the panel.
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) setCurrent(entry.target.id);
+          });
+        }, { root: panel, rootMargin: '-50% 0px -50% 0px', threshold: 0 });
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      links.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const target = document.getElementById(link.hash.slice(1));
+          if (!target) return;
+          event.preventDefault();
+          // Scroll only the panel (not the page).
+          const top = target.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop;
+          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
+          panel.scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
+          setCurrent(target.id);
+          history.replaceState(null, '', link.hash);
+        });
+      });
+    })();
+  </script>
+
