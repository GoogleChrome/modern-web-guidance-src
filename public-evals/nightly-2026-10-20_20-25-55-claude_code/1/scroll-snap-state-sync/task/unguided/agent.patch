+  <script>
+    (function () {
+      var panel = document.querySelector('.seasonal-panel');
+      var links = Array.prototype.slice.call(document.querySelectorAll('.toc-sidebar a'));
+      var sections = Array.prototype.slice.call(panel.querySelectorAll('.drink-section'));
+
+      function setActive(id) {
+        links.forEach(function (link) {
+          if (link.getAttribute('href') === '#' + id) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+        sections.forEach(function (section) {
+          if (section.id === id) {
+            section.setAttribute('aria-current', 'true');
+          } else {
+            section.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      // The section whose header sits at the top of the panel is the active one.
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (entry.isIntersecting) setActive(entry.target.id);
+        });
+      }, { root: panel, rootMargin: '0px 0px -60% 0px', threshold: 0 });
+      sections.forEach(function (section) { observer.observe(section); });
+      setActive(sections[0].id);
+
+      links.forEach(function (link) {
+        link.addEventListener('click', function (event) {
+          var target = document.getElementById(link.getAttribute('href').slice(1));
+          if (!target) return;
+          event.preventDefault();
+          var top = target.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop;
+          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          panel.scrollTo({ top: top, behavior: reduce ? 'auto' : 'smooth' });
+          target.focus({ preventScroll: true });
+          history.replaceState(null, '', '#' + target.id);
+        });
+      });
+    })();
+  </script>
+
