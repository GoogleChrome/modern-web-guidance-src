@@ -0,0 +1,230 @@
+/* ==========================================================================
+   The Daily Grind
+   Layer order (lowest → highest priority). Later layers always win over
+   earlier ones regardless of selector specificity.
+   ========================================================================== */
+@layer tokens, reset, base, layout, components, utilities;
+
+/* --------------------------------------------------------------------------
+   Tokens: primitives first, then semantic aliases that components consume.
+   -------------------------------------------------------------------------- */
+@layer tokens {
+  :root {
+    /* Primitives */
+    --color-espresso-900: #3e2723;
+    --color-espresso-700: #4e342e;
+    --color-latte-200: #d7ccc8;
+    --color-amber-400: #ffab40;
+    --color-white: #fff;
+    --color-paper: #fafafa;
+    --color-scrim: rgb(0 0 0 / 0.5);
+    --color-shadow: rgb(0 0 0 / 0.1);
+
+    --font-sans: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
+
+    --space-1: 0.3125rem;
+    --space-2: 0.625rem;
+    --space-3: 0.9375rem;
+    --space-4: 1.25rem;
+    --space-5: 2.5rem;
+
+    --radius-sm: 4px;
+    --radius-md: 5px;
+    --radius-lg: 8px;
+
+    --text-xs: 0.85rem;
+    --text-sm: 0.9rem;
+    --text-xl: 1.5rem;
+    --text-hero: 3rem;
+
+    --width-content: 1100px;
+    --gutter-nav: 5%;
+    --duration-fast: 0.3s;
+    --z-sticky: 1000;
+
+    /* Semantic aliases */
+    --color-text: var(--color-espresso-900);
+    --color-surface: var(--color-white);
+    --color-surface-page: var(--color-paper);
+    --color-brand: var(--color-espresso-700);
+    --color-brand-strong: var(--color-espresso-900);
+    --color-on-brand: var(--color-white);
+    --color-accent: var(--color-amber-400);
+    --color-muted-surface: var(--color-latte-200);
+    --shadow-card: 0 2px 5px var(--color-shadow);
+  }
+}
+
+/* --------------------------------------------------------------------------
+   Reset: zero specificity via :where() so it never fights later layers.
+   -------------------------------------------------------------------------- */
+@layer reset {
+  :where(*, *::before, *::after) {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+  }
+
+  :where(ul[class]) {
+    list-style: none;
+  }
+
+  :where(a) {
+    color: inherit;
+    text-decoration: none;
+  }
+}
+
+/* --------------------------------------------------------------------------
+   Base: element defaults.
+   -------------------------------------------------------------------------- */
+@layer base {
+  body {
+    font-family: var(--font-sans);
+    line-height: 1.6;
+    color: var(--color-text);
+    background-color: var(--color-surface-page);
+  }
+}
+
+/* --------------------------------------------------------------------------
+   Layout: page-level structure.
+   -------------------------------------------------------------------------- */
+@layer layout {
+  .container {
+    max-width: var(--width-content);
+    margin: var(--space-5) auto;
+    padding-inline: var(--space-4);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+    gap: var(--space-4);
+    margin-top: var(--space-4);
+  }
+}
+
+/* --------------------------------------------------------------------------
+   Components: each scoped to its root so styles can't leak outward.
+   -------------------------------------------------------------------------- */
+@layer components {
+  /* Button: standalone, reused in hero and cards */
+  .btn {
+    display: inline-block;
+    background: var(--color-brand);
+    color: var(--color-on-brand);
+    padding: var(--space-2) var(--space-4);
+    border-radius: var(--radius-md);
+    margin-top: var(--space-3);
+    transition: background var(--duration-fast);
+
+    &:hover {
+      background: var(--color-brand-strong);
+    }
+  }
+
+  /* Site navigation */
+  @scope (.site-nav) {
+    :scope {
+      background: var(--color-brand);
+      color: var(--color-on-brand);
+      padding: 1rem var(--gutter-nav);
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      top: 0;
+      z-index: var(--z-sticky);
+    }
+
+    .logo {
+      font-size: var(--text-xl);
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    ul {
+      display: flex;
+      gap: var(--space-4);
+    }
+
+    a {
+      color: var(--color-on-brand);
+      font-size: var(--text-sm);
+      transition: color var(--duration-fast);
+
+      &:hover {
+        color: var(--color-accent);
+      }
+
+      &.logout-link {
+        border: 1px solid var(--color-accent);
+        padding: var(--space-1) 12px;
+        border-radius: var(--radius-sm);
+      }
+    }
+  }
+
+  /* Hero banner */
+  .hero {
+    height: 60vh;
+    background:
+      linear-gradient(var(--color-scrim), var(--color-scrim)),
+      url("https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80")
+        center / cover;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    color: var(--color-on-brand);
+    text-align: center;
+    padding-inline: var(--space-4);
+
+    & h1 {
+      font-size: var(--text-hero);
+      margin-bottom: 1rem;
+    }
+  }
+
+  /* Card */
+  .card {
+    background: var(--color-surface);
+    padding: var(--space-4);
+    border-radius: var(--radius-lg);
+    box-shadow: var(--shadow-card);
+    text-align: center;
+
+    & h3 {
+      margin-bottom: var(--space-2);
+      color: var(--color-brand);
+    }
+  }
+
+  /* Footer */
+  .site-footer {
+    background: var(--color-muted-surface);
+    text-align: center;
+    padding: var(--space-5) var(--space-4);
+    margin-top: var(--space-5);
+
+    & .footer-links {
+      margin-bottom: var(--space-4);
+
+      & a {
+        margin-inline: var(--space-2);
+        color: var(--color-text);
+        font-size: var(--text-xs);
+      }
+    }
+  }
+}
+
+/* --------------------------------------------------------------------------
+   Utilities: single-purpose overrides, highest priority.
+   -------------------------------------------------------------------------- */
+@layer utilities {
+  .text-center {
+    text-align: center;
+  }
+}
