@@ -206,7 +206,44 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    import { onCLS, onINP, onLCP } from 'https://unpkg.com/web-vitals@4?module';
+
+    // Queue metrics and send them together in one request when the page is
+    // hidden or unloaded, which is when CLS/INP/LCP reach their final values.
+    const queue = [];
+
+    function flushQueue() {
+      if (!queue.length) return;
+      const body = JSON.stringify(queue.splice(0));
+      if (!(navigator.sendBeacon && navigator.sendBeacon('/collect', body))) {
+        fetch('/collect', { body, method: 'POST', keepalive: true,
+          headers: { 'Content-Type': 'application/json' } });
+      }
+    }
+
+    function addToQueue(metric) {
+      queue.push({
+        name: metric.name,
+        value: metric.value,
+        rating: metric.rating,
+        delta: metric.delta,
+        id: metric.id,
+        navigationType: metric.navigationType,
+        page: location.pathname,
+      });
+    }
+
+    onCLS(addToQueue);
+    onINP(addToQueue);
+    onLCP(addToQueue);
+
+    addEventListener('visibilitychange', () => {
+      if (document.visibilityState === 'hidden') flushQueue();
+    });
+    addEventListener('pagehide', flushQueue);
+  </script>
 </body>
 
 </html>
