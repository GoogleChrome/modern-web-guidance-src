+  <script>
+    // Lazy media: native `loading="lazy"` where supported, IntersectionObserver otherwise.
+    // Real URLs are held in data-* attributes and applied here, so no fetch starts before this runs.
+    const lazyMedia = document.querySelectorAll('video[loading="lazy"], audio[loading="lazy"][controls]');
+    const supportsLazyMedia = Object.hasOwn(HTMLMediaElement.prototype, 'loading');
+
+    function activate(media) {
+      if (media.dataset.poster) media.poster = media.dataset.poster;
+      if (media.dataset.src) media.src = media.dataset.src;
+      for (const source of media.querySelectorAll('source[data-src]')) source.src = source.dataset.src;
+      media.load();
+    }
+
+    if (supportsLazyMedia) {
+      lazyMedia.forEach(activate);
+    } else {
+      const observer = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          activate(entry.target);
+          observer.unobserve(entry.target);
+        }
+      }, { rootMargin: '200px 0px' });
+      lazyMedia.forEach((media) => observer.observe(media));
+    }
+
+    // Respect reduced motion for the autoplaying hero video
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const heroVideo = document.querySelector('.hero-video');
+    function syncMotion() {
+      if (reducedMotion.matches) heroVideo.pause();
+      else heroVideo.play().catch(() => {});
+    }
+    syncMotion();
+    reducedMotion.addEventListener('change', syncMotion);
+  </script>
