+  <script>
+    // Defer offscreen video/audio (poster, sources, media data) until near the viewport.
+    (function () {
+      var items = document.querySelectorAll('.lazy-media');
+
+      function load(el) {
+        if (el.dataset.poster) {
+          el.poster = el.dataset.poster;
+        }
+        el.querySelectorAll('source[data-src]').forEach(function (source) {
+          source.src = source.dataset.src;
+        });
+        el.preload = 'metadata';
+        el.load();
+      }
+
+      if (!('IntersectionObserver' in window)) {
+        items.forEach(load);
+        return;
+      }
+
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (entry.isIntersecting) {
+            load(entry.target);
+            observer.unobserve(entry.target);
+          }
+        });
+      }, { rootMargin: '300px 0px' });
+
+      items.forEach(function (el) { observer.observe(el); });
+    })();
+  </script>
+
