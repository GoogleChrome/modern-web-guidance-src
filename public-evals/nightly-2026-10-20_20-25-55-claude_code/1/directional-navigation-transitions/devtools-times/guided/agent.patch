+</Layout>
+
+<style>
+    @keyframes top-story-from-right {
+        from { transform: translateX(100%); opacity: 0; }
+    }
+    @keyframes top-story-from-left {
+        from { transform: translateX(-100%); opacity: 0; }
+    }
+    @media (prefers-reduced-motion: no-preference) {
+        .top-story[data-enter="next"] {
+            animation: top-story-from-right 0.35s ease-out;
+        }
+        .top-story[data-enter="prev"] {
+            animation: top-story-from-left 0.35s ease-out;
+        }
+    }
+</style>
+
+<script>
+    document.querySelectorAll<HTMLElement>('[data-top-stories]').forEach((root) => {
+        const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
+        let current = 0;
+
+        const show = (delta: 1 | -1) => {
+            slides[current].hidden = true;
+            slides[current].removeAttribute('data-enter');
+            current = (current + delta + slides.length) % slides.length;
+            const next = slides[current];
+            next.dataset.enter = delta === 1 ? 'next' : 'prev';
+            next.hidden = false;
+        };
+
+        root.querySelector('[data-next]')?.addEventListener('click', () => show(1));
+        root.querySelector('[data-prev]')?.addEventListener('click', () => show(-1));
+    });
+</script>
