+import React, { useState } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+interface Story {
+  href: string;
+  title: string;
+  date: string;
+}
+
+interface Props {
+  stories: Story[];
+}
+
+export default function TopStoriesSlider({ stories }: Props) {
+  const [index, setIndex] = useState(0);
+  const [direction, setDirection] = useState<'next' | 'prev' | null>(null);
+
+  const go = (dir: 'next' | 'prev') => {
+    const step = dir === 'next' ? 1 : -1;
+    setDirection(dir);
+    setIndex((i) => (i + step + stories.length) % stories.length);
+  };
+
+  const story = stories[index];
+  const animation = direction === 'next' ? 'slide-in-next' : direction === 'prev' ? 'slide-in-prev' : '';
+  const buttonClass = 'p-2 rounded-full border border-gray-300 text-gray-700 hover:text-amber-400 hover:border-amber-400 transition-colors';
+
+  return (
+    <div className="flex items-center gap-4" role="region" aria-roledescription="carousel" aria-label="Top stories">
+      <button type="button" onClick={() => go('prev')} className={buttonClass} aria-label="Previous story">
+        <ChevronLeftIcon className="w-5 h-5" />
+      </button>
+      <div className="flex-1 overflow-hidden">
+        <div key={index} className={animation} aria-live="polite">
+          <a href={story.href}>
+            <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{story.title}</h3>
+          </a>
+          <span className="text-xs text-gray-500">{story.date}</span>
+        </div>
+      </div>
+      <span className="text-xs text-gray-500 tabular-nums">{index + 1} / {stories.length}</span>
+      <button type="button" onClick={() => go('next')} className={buttonClass} aria-label="Next story">
+        <ChevronRightIcon className="w-5 h-5" />
+      </button>
+    </div>
+  );
+}
