+      <script>
+        (() => {
+          const root = document.getElementById('seasonal');
+          const viewport = root.querySelector('.carousel-viewport');
+          const cards = [...viewport.children];
+          const controls = root.querySelector('.carousel-controls');
+          const status = root.querySelector('.carousel-status');
+          const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+          let index = 0;
+
+          function show(i) {
+            cards.forEach((card, n) => { card.hidden = n !== i; });
+            status.textContent = `${i + 1} of ${cards.length}`;
+          }
+
+          function go(direction) {
+            const step = direction === 'forward' ? 1 : -1;
+            const next = (index + step + cards.length) % cards.length;
+            const update = () => { index = next; show(next); };
+            if (!document.startViewTransition || reducedMotion.matches) {
+              update();
+              return;
+            }
+            document.startViewTransition({ update, types: [direction] });
+          }
+
+          controls.addEventListener('click', (e) => {
+            const button = e.target.closest('button[data-dir]');
+            if (button) go(button.dataset.dir);
+          });
+
+          root.classList.add('is-enhanced');
+          controls.hidden = false;
+          show(index);
+        })();
+      </script>
