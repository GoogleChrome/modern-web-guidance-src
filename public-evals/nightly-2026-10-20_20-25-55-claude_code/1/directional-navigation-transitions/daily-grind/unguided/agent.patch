+  <script>
+    (function () {
+      var carousel = document.querySelector('.carousel');
+      var cards = carousel.querySelectorAll('.card');
+      var status = carousel.querySelector('.carousel-status');
+      var current = 0;
+
+      function show(index, dir) {
+        current = (index + cards.length) % cards.length;
+        cards.forEach(function (card, i) {
+          card.hidden = i !== current;
+          card.classList.remove('enter-next', 'enter-prev');
+        });
+        if (dir) {
+          // Reflow so the animation restarts even on a repeated direction
+          void cards[current].offsetWidth;
+          cards[current].classList.add(dir > 0 ? 'enter-next' : 'enter-prev');
+        }
+        status.textContent = (current + 1) + ' of ' + cards.length;
+      }
+
+      carousel.querySelectorAll('[data-dir]').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          var dir = Number(btn.dataset.dir);
+          show(current + dir, dir);
+        });
+      });
+
+      show(0, 0);
+    })();
+  </script>
+
