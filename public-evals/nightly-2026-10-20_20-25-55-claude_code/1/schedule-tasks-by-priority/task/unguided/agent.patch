+  <script>
+    (() => {
+      // Lower number = higher priority. `steps` x `stepMs` approximates the CPU cost of the task.
+      const TYPES = {
+        checkout: { label: 'Checkout', priority: 0, steps: 15, stepMs: 4 },
+        menu: { label: 'Menu update', priority: 1, steps: 60, stepMs: 4 },
+        telemetry: { label: 'Telemetry log', priority: 2, steps: 150, stepMs: 4 }
+      };
+      const PRIORITY_NAMES = ['urgent', 'standard', 'background'];
+      const SLICE_MS = 8; // max time on the main thread before yielding
+
+      const $ = (id) => document.getElementById(id);
+      const queueEl = $('ops-queue');
+      const logEl = $('ops-log');
+      const queue = []; // kept sorted by priority, then arrival order
+      let seq = 0;
+      let current = null;
+      let done = 0;
+      let scheduled = false;
+
+      function enqueue(type) {
+        const t = TYPES[type];
+        const task = { id: ++seq, type, ...t, progress: 0 };
+        // insert after the last task with the same or higher priority (stable ordering)
+        let i = queue.length;
+        while (i > 0 && queue[i - 1].priority > task.priority) i--;
+        queue.splice(i, 0, task);
+        log(`Queued #${task.id} ${task.label}`, task.priority);
+        render();
+        schedule();
+      }
+
+      function enqueueBatch() {
+        // deliberately mixed, lowest priority first, to show reordering
+        ['telemetry', 'menu', 'telemetry', 'checkout', 'menu', 'checkout'].forEach(enqueue);
+      }
+
+      // Yield via MessageChannel so we don't suffer setTimeout's clamping, but still let the browser paint/handle input.
+      const channel = new MessageChannel();
+      channel.port1.onmessage = runSlice;
+      function schedule() {
+        if (scheduled) return;
+        scheduled = true;
+        channel.port2.postMessage(null);
+      }
+
+      function busy(ms) {
+        const end = performance.now() + ms;
+        while (performance.now() < end);
+      }
+
+      function runSlice() {
+        scheduled = false;
+        const start = performance.now();
+        let lastRender = start;
+        while (queue.length && performance.now() - start < SLICE_MS) {
+          // Always re-check the head of the queue so newly arrived urgent work preempts lower-priority tasks between steps.
+          const task = queue[0];
+          if (current !== task) {
+            current = task;
+            log(`Started #${task.id} ${task.label}`, task.priority);
+          }
+          busy(task.stepMs);
+          task.progress++;
+          if (task.progress >= task.steps) {
+            queue.shift();
+            current = null;
+            done++;
+            log(`Completed #${task.id} ${task.label}`, task.priority);
+          }
+        }
+        render();
+        if (queue.length) schedule();
+      }
+
+      function log(text, priority) {
+        const li = document.createElement('li');
+        li.className = 'p' + priority;
+        li.textContent = `${new Date().toLocaleTimeString()} – ${text}`;
+        logEl.prepend(li);
+        while (logEl.children.length > 100) logEl.lastChild.remove();
+      }
+
+      function render() {
+        $('ops-queued').textContent = queue.length;
+        $('ops-done').textContent = done;
+        $('ops-running').textContent = queue.length
+          ? `#${queue[0].id} ${queue[0].label}`
+          : 'idle';
+        queueEl.replaceChildren(...(queue.length ? queue.map((t) => {
+          const li = document.createElement('li');
+          li.className = 'p' + t.priority;
+          li.textContent = `#${t.id} ${t.label} (${PRIORITY_NAMES[t.priority]})`;
+          const bar = document.createElement('span');
+          bar.className = 'ops-bar';
+          const fill = document.createElement('i');
+          fill.style.width = (100 * t.progress / t.steps) + '%';
+          bar.append(fill);
+          li.append(bar);
+          return li;
+        }) : [Object.assign(document.createElement('li'), { className: 'empty', textContent: 'Queue is empty' })]));
+      }
+
+      // Responsiveness meter: largest gap between animation frames (high = main thread blocked).
+      let lastFrame = performance.now();
+      let maxGap = 0;
+      (function frame(now) {
+        maxGap = Math.max(maxGap, now - lastFrame);
+        lastFrame = now;
+        $('ops-lag').textContent = Math.round(maxGap);
+        requestAnimationFrame(frame);
+      })(lastFrame);
+      setInterval(() => { maxGap = 0; }, 3000);
+
+      document.querySelectorAll('.ops-btn[data-type]').forEach((b) =>
+        b.addEventListener('click', () => enqueue(b.dataset.type)));
+      $('ops-batch').addEventListener('click', enqueueBatch);
+      $('ops-clear').addEventListener('click', () => logEl.replaceChildren());
+      render();
+    })();
+  </script>
 </body>
 
