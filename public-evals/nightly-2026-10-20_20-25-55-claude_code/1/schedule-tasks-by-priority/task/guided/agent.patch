+  <script>
+    (() => {
+      const PRIORITY = { urgent: 0, standard: 1, background: 2 };
+      const TYPES = {
+        urgent: { label: 'Checkout', units: 120 },
+        standard: { label: 'Menu update', units: 300 },
+        background: { label: 'Telemetry log', units: 600 }
+      };
+      const SLICE_MS = 30; // keep every slice under the 50ms long-task threshold
+      const $ = (id) => document.getElementById(id);
+      const queueEl = $('ops-queue'), doneEl = $('ops-done');
+      const pendingEl = $('ops-pending'), sliceEl = $('ops-slice');
+      const counters = { urgent: 0, standard: 0, background: 0 };
+      const queue = [];
+      let running = false, worst = 0, seq = 0;
+
+      // Busy work standing in for real processing (one unit is ~0.1ms).
+      function doUnit() {
+        let x = 0;
+        for (let i = 0; i < 60000; i++) x += Math.sqrt(i);
+        return x;
+      }
+
+      function yieldToMain() {
+        if ('scheduler' in window && 'yield' in scheduler) return scheduler.yield();
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      function render() {
+        queue.sort((a, b) => PRIORITY[a.type] - PRIORITY[b.type] || a.id - b.id);
+        pendingEl.textContent = queue.length;
+        queueEl.replaceChildren(...(queue.length ? queue.map((t) => {
+          const li = document.createElement('li');
+          const pct = Math.round((1 - t.remaining / t.total) * 100);
+          li.append(`${t.name} (${pct}%)`, tag(t.type));
+          return li;
+        }) : [Object.assign(document.createElement('li'), { className: 'empty', textContent: 'Nothing queued' })]));
+      }
+
+      function tag(type) {
+        const span = document.createElement('span');
+        span.className = `tag ${type}`;
+        span.textContent = type;
+        return span;
+      }
+
+      function complete(t, ms) {
+        doneEl.querySelector('.empty')?.remove();
+        const li = document.createElement('li');
+        li.append(`${t.name} - ${Math.round(ms)} ms`, tag(t.type));
+        doneEl.append(li);
+        doneEl.scrollTop = doneEl.scrollHeight;
+      }
+
+      function enqueue(type) {
+        const { label, units } = TYPES[type];
+        const n = ++counters[type];
+        queue.push({ id: ++seq, type, name: `${label} #${n}`, total: units, remaining: units, start: 0 });
+        render();
+        if (!running) run();
+      }
+
+      // Re-picks the highest-priority task after every slice, so a newly
+      // added urgent task preempts a long-running background one.
+      async function run() {
+        running = true;
+        while (queue.length) {
+          const t = queue[0];
+          if (!t.start) t.start = performance.now();
+          const sliceStart = performance.now();
+          while (t.remaining > 0 && performance.now() - sliceStart < SLICE_MS) {
+            doUnit();
+            t.remaining--;
+          }
+          worst = Math.max(worst, performance.now() - sliceStart);
+          sliceEl.textContent = `${Math.round(worst)} ms`;
+          if (t.remaining <= 0) {
+            queue.splice(queue.indexOf(t), 1);
+            complete(t, performance.now() - t.start);
+          }
+          render();
+          await yieldToMain();
+        }
+        running = false;
+      }
+
+      function batch() {
+        // Deliberately enqueued in mixed order; the queue sorts by priority.
+        ['background', 'standard', 'urgent', 'background', 'urgent', 'standard'].forEach((type) => {
+          const { label, units } = TYPES[type];
+          queue.push({ id: ++seq, type, name: `${label} #${++counters[type]}`, total: units, remaining: units, start: 0 });
+        });
+        render();
+        if (!running) run();
+      }
+
+      document.querySelector('.ops-controls').addEventListener('click', (e) => {
+        const op = e.target.closest('button')?.dataset.op;
+        if (op === 'batch') batch();
+        else if (op) enqueue(op);
+      });
+
+      // Heartbeat showing the main thread keeps painting during long work.
+      let ticks = 0;
+      setInterval(() => { $('ops-ticks').textContent = ++ticks; }, 100);
+    })();
+  </script>
+
