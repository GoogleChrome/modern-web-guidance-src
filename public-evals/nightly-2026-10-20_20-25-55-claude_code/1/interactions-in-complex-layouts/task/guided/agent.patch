+  <script>
+    (() => {
+      const board = document.getElementById('board');
+      const status = document.getElementById('board-status');
+      const columns = [...board.querySelectorAll('.board-column')];
+      let dragged = null;
+      let overColumn = null;
+
+      const updateCount = (col) => {
+        col.querySelector('.count').textContent = col.querySelectorAll(':scope > .card').length;
+      };
+
+      // Only the source and target columns are touched, so work stays O(1) in board size.
+      const moveCard = (card, target) => {
+        const source = card.parentElement;
+        if (source === target) return;
+        target.appendChild(card);
+        updateCount(source);
+        updateCount(target);
+        status.textContent = `${card.querySelector('h3').textContent} moved to ${target.dataset.status}`;
+      };
+
+      const setOver = (col) => {
+        if (col === overColumn) return;
+        overColumn?.classList.remove('drag-over');
+        col?.classList.add('drag-over');
+        overColumn = col;
+      };
+
+      // Delegated listeners: constant listener count regardless of order volume.
+      board.addEventListener('dragstart', (e) => {
+        const card = e.target.closest('.card');
+        if (!card) return;
+        dragged = card;
+        e.dataTransfer.effectAllowed = 'move';
+        e.dataTransfer.setData('text/plain', card.dataset.id);
+        // Defer styling so the drag image is captured unmodified
+        requestAnimationFrame(() => card.classList.add('dragging'));
+      });
+
+      board.addEventListener('dragover', (e) => {
+        if (!dragged) return;
+        e.preventDefault();
+        e.dataTransfer.dropEffect = 'move';
+        setOver(e.target.closest('.board-column'));
+      });
+
+      board.addEventListener('drop', (e) => {
+        const col = e.target.closest('.board-column');
+        if (!dragged || !col) return;
+        e.preventDefault();
+        moveCard(dragged, col);
+      });
+
+      board.addEventListener('dragend', () => {
+        dragged?.classList.remove('dragging');
+        setOver(null);
+        dragged = null;
+      });
+
+      // Keyboard alternative
+      board.addEventListener('keydown', (e) => {
+        const card = e.target.closest('.card');
+        if (!card || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
+        const i = columns.indexOf(card.parentElement) + (e.key === 'ArrowRight' ? 1 : -1);
+        if (!columns[i]) return;
+        e.preventDefault();
+        moveCard(card, columns[i]);
+        card.focus();
+      });
+
+      columns.forEach(updateCount);
+    })();
+  </script>
+
