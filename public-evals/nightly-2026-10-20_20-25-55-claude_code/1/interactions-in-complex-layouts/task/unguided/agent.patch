+  <script>
+    (function () {
+      var board = document.getElementById('order-board');
+      var columns = Array.prototype.slice.call(board.querySelectorAll('.board-column'));
+      var THRESHOLD = 4;
+
+      var drag = null; // { card, id, startX, startY, rects, active, target, raf, x, y }
+
+      function updateCount(col) {
+        var n = col.querySelector('.board-cards').children.length;
+        col.querySelector('.board-count').textContent = n;
+      }
+
+      function setTarget(col) {
+        if (drag.target === col) return;
+        if (drag.target) drag.target.classList.remove('drag-over');
+        drag.target = col;
+        if (col) col.classList.add('drag-over');
+      }
+
+      function columnAt(x, y) {
+        // Uses rects cached at drag start: no layout reads while moving
+        var rects = drag.rects;
+        for (var i = 0; i < rects.length; i++) {
+          var r = rects[i];
+          if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) return columns[i];
+        }
+        return null;
+      }
+
+      function frame() {
+        drag.raf = 0;
+        drag.card.style.transform =
+          'translate3d(' + (drag.x - drag.startX) + 'px,' + (drag.y - drag.startY) + 'px,0)';
+        setTarget(columnAt(drag.x, drag.y));
+      }
+
+      function begin() {
+        drag.active = true;
+        drag.rects = columns.map(function (c) { return c.getBoundingClientRect(); });
+        drag.card.classList.add('dragging');
+        drag.card.setPointerCapture(drag.id);
+      }
+
+      function place(card, col, y) {
+        var list = col.querySelector('.board-cards');
+        var before = null;
+        if (y != null) {
+          var kids = list.children;
+          for (var i = 0; i < kids.length; i++) {
+            if (kids[i] === card) continue;
+            var r = kids[i].getBoundingClientRect();
+            if (y < r.top + r.height / 2) { before = kids[i]; break; }
+          }
+        }
+        var from = card.parentNode.parentNode;
+        list.insertBefore(card, before);
+        updateCount(from);
+        if (from !== col) updateCount(col);
+      }
+
+      function end(e, cancelled) {
+        if (!drag) return;
+        var d = drag;
+        drag = null;
+        if (d.raf) cancelAnimationFrame(d.raf);
+        if (!d.active) return;
+        var card = d.card;
+        var target = cancelled ? null : d.target;
+        if (d.target) d.target.classList.remove('drag-over');
+        card.classList.remove('dragging');
+        card.style.transform = '';
+        if (target) place(card, target, d.y);
+      }
+
+      board.addEventListener('pointerdown', function (e) {
+        var card = e.target.closest('.card');
+        if (!card || drag || e.button > 0) return;
+        drag = {
+          card: card, id: e.pointerId, startX: e.clientX, startY: e.clientY,
+          x: e.clientX, y: e.clientY, active: false, target: null, raf: 0, rects: null
+        };
+      });
+
+      board.addEventListener('pointermove', function (e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        drag.x = e.clientX;
+        drag.y = e.clientY;
+        if (!drag.active) {
+          if (Math.abs(drag.x - drag.startX) + Math.abs(drag.y - drag.startY) < THRESHOLD) return;
+          begin();
+        }
+        if (!drag.raf) drag.raf = requestAnimationFrame(frame);
+      });
+
+      board.addEventListener('pointerup', function (e) {
+        if (drag && e.pointerId === drag.id) end(e, false);
+      });
+      board.addEventListener('pointercancel', function (e) {
+        if (drag && e.pointerId === drag.id) end(e, true);
+      });
+
+      // Keyboard alternative
+      board.addEventListener('keydown', function (e) {
+        var card = e.target.closest && e.target.closest('.card');
+        if (!card || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
+        var idx = columns.indexOf(card.closest('.board-column'));
+        var next = columns[idx + (e.key === 'ArrowRight' ? 1 : -1)];
+        if (!next) return;
+        e.preventDefault();
+        place(card, next, null);
+        card.focus();
+      });
+    })();
+  </script>
