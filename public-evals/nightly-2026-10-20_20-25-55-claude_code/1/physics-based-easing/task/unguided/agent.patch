     }
 
+    /* Interactive hover motion for seasonal favorites */
+    .card.spring,
+    .card.bounce {
+      will-change: transform;
+    }
+
+    /* Spring: overshoots the target scale, then settles (cubic-bezier fallback) */
+    .card.spring {
+      transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1),
+        box-shadow 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
+      transition-timing-function: linear(0, 0.208, 0.439, 0.661, 0.852, 1, 1.103, 1.163, 1.187, 1.183, 1.16, 1.127, 1.09, 1.054, 1.024, 1, 0.984, 0.974, 0.97, 0.971, 0.974, 0.98, 0.986, 0.991, 0.996, 1, 1.003, 1.004, 1.005, 1.005, 1);
+    }
+
+    .card.spring:hover {
+      transform: scale(1.08);
+      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
+    }
+
+    /* Bounce: lifts and bounces like a ball coming to rest (cubic-bezier fallback) */
+    .card.bounce {
+      transition: transform 0.8s cubic-bezier(0.28, 0.84, 0.42, 1.3),
+        box-shadow 0.8s ease-out;
+      transition-timing-function: linear(0, 0.008, 0.034, 0.076, 0.134, 0.21, 0.303, 0.412, 0.538, 0.681, 0.84, 0.992, 0.91, 0.845, 0.797, 0.766, 0.751, 0.753, 0.772, 0.808, 0.861, 0.931, 0.992, 0.958, 0.94, 0.939, 0.955, 0.988, 0.988, 0.985, 1);
+    }
+
+    .card.bounce:hover {
+      transform: translateY(-14px);
+      box-shadow: 0 16px 28px rgba(0, 0, 0, 0.2);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card.spring,
+      .card.bounce {
+        transition: none;
+        will-change: auto;
+      }
+
+      .card.spring:hover,
+      .card.bounce:hover {
+        transform: none;
+      }
+    }
+
