+  <script>
+    let toastCount = 0;
+
+    function showToast(message) {
+      const toast = document.createElement('div');
+      toast.className = 'toast';
+      toast.id = `toast-${++toastCount}`;
+      toast.popover = 'manual';
+      toast.setAttribute('role', 'status');
+
+      const text = document.createElement('span');
+      text.textContent = message;
+
+      const close = document.createElement('button');
+      close.type = 'button';
+      close.className = 'toast-close';
+      close.setAttribute('aria-label', 'Close notification');
+      close.setAttribute('popovertarget', toast.id);
+      close.setAttribute('popovertargetaction', 'hide');
+      close.textContent = '\u00d7';
+
+      toast.append(text, close);
+      document.body.append(toast);
+      toast.showPopover();
+
+      const timer = setTimeout(() => toast.hidePopover(), 3000);
+
+      // Remove from the DOM once the exit transition has finished
+      toast.addEventListener('toggle', async (e) => {
+        if (e.newState !== 'closed') return;
+        clearTimeout(timer);
+        await Promise.allSettled(toast.getAnimations().map((a) => a.finished));
+        toast.remove();
+      });
+    }
+
+    document.addEventListener('click', (e) => {
+      if (e.target.closest('.toast-trigger')) showToast('Added to cart!');
+    });
+  </script>
+
