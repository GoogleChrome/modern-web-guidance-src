+
+    /* Toasts: each is its own top-layer popover. Each one anchors to the
+       previous toast (same anchor-name, nearest preceding in tree order),
+       so they stack upward with no wrapper or JS math. The first toast has
+       no valid anchor and falls back to the viewport corner offset. */
+    .toast {
+      position: fixed;
+      inset: auto;
+      right: 1.5rem;
+      bottom: calc(anchor(top, 2.25rem) - 0.75rem);
+      position-anchor: --toast;
+      anchor-name: --toast;
+      margin: 0;
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      padding: 0.75rem 1rem;
+      border: none;
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
+      pointer-events: auto;
+      opacity: 0;
+      transform: translateX(1.5rem);
+      transition: opacity 0.3s ease, transform 0.3s ease, bottom 0.3s ease,
+        display 0.3s allow-discrete, overlay 0.3s allow-discrete;
+    }
+
+    .toast:popover-open {
+      opacity: 1;
+      transform: none;
+    }
+
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        transform: translateX(1.5rem);
+      }
+    }
+
+    .toast-close {
+      background: none;
+      border: none;
+      color: var(--accent);
+      font-size: 1.25rem;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transition-duration: 0.01s;
+      }
+    }
+
