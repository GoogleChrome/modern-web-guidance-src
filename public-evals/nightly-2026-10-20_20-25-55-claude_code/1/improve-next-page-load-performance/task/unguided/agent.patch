+  <script>
+    // Prefetch internal pages when the user shows intent (hover, focus, touch).
+    // Links are skipped if they have data-no-prefetch or point at a
+    // state-changing URL such as /logout.
+    (function () {
+      var NEVER_PREFETCH = /^\/(logout|signout|log-out|sign-out)(\/|$)/i;
+      var prefetched = new Set();
+
+      function shouldPrefetch(a) {
+        if (!a || !a.href || a.hasAttribute('data-no-prefetch') || a.hasAttribute('download')) return false;
+        if (a.target && a.target !== '_self') return false;
+        var url = new URL(a.href, location.href);
+        if (url.origin !== location.origin) return false;
+        if (NEVER_PREFETCH.test(url.pathname)) return false;
+        if (url.pathname === location.pathname && url.search === location.search) return false;
+        return !prefetched.has(url.href);
+      }
+
+      function prefetch(e) {
+        var a = e.target.closest && e.target.closest('a');
+        if (!shouldPrefetch(a)) return;
+        var href = new URL(a.href, location.href).href;
+        prefetched.add(href);
+        var link = document.createElement('link');
+        link.rel = 'prefetch';
+        link.href = href;
+        link.as = 'document';
+        document.head.appendChild(link);
+      }
+
+      document.addEventListener('mouseover', prefetch, { passive: true });
+      document.addEventListener('focusin', prefetch);
+      document.addEventListener('touchstart', prefetch, { passive: true });
+    })();
+  </script>
+
