     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // GPU ripple distortion for the hero. The hero's visuals (photo, headline,
+    // copy, button) are rasterised into a texture and distorted in a fragment
+    // shader, while the real DOM elements stay in place with transparent text,
+    // so selection, copy and clicks keep working natively.
+    (function () {
+      const hero = document.querySelector('.hero');
+      if (!hero || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+
+      const canvas = document.createElement('canvas');
+      canvas.className = 'hero-gl';
+      canvas.setAttribute('aria-hidden', 'true');
+      hero.prepend(canvas);
+      const gl = canvas.getContext('webgl', { premultipliedAlpha: false, alpha: false });
+      if (!gl) { canvas.remove(); return; }
+
+      const MAX = 8, LIFE = 3.5;
+      const vs = `attribute vec2 p; varying vec2 uv;
+        void main(){ uv = p * .5 + .5; gl_Position = vec4(p, 0., 1.); }`;
+      const fs = `precision highp float;
+        varying vec2 uv; uniform sampler2D tex; uniform vec3 rip[${MAX}];
+        uniform float time, aspect;
+        void main(){
+          vec2 off = vec2(0.); float light = 0.;
+          for (int i = 0; i < ${MAX}; i++) {
+            float t = time - rip[i].z;
+            if (t < 0. || t > ${LIFE.toFixed(1)}) continue;
+            vec2 d = (uv - rip[i].xy) * vec2(aspect, 1.);
+            float r = length(d);
+            float ring = exp(-pow((r - t * .45) * 7., 2.));
+            float w = sin(r * 55. - t * 9.) * ring * (1. - t / ${LIFE.toFixed(1)});
+            off += normalize(d + 1e-5) * w * .012 * vec2(1. / aspect, 1.);
+            light += w;
+          }
+          vec3 c = texture2D(tex, uv + off).rgb + light * .12;
+          gl_FragColor = vec4(c, 1.);
+        }`;
+      const sh = (type, src) => {
+        const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s);
+        return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
+      };
+      const prog = gl.createProgram();
+      const v = sh(gl.VERTEX_SHADER, vs), f = sh(gl.FRAGMENT_SHADER, fs);
+      if (!v || !f) { canvas.remove(); return; }
+      gl.attachShader(prog, v); gl.attachShader(prog, f); gl.linkProgram(prog);
+      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { canvas.remove(); return; }
+      gl.useProgram(prog);
+
+      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
+      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
+      const loc = gl.getAttribLocation(prog, 'p');
+      gl.enableVertexAttribArray(loc);
+      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
+
+      const tex = gl.createTexture();
+      gl.bindTexture(gl.TEXTURE_2D, tex);
+      gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
+      for (const [k, val] of [[gl.TEXTURE_MIN_FILTER, gl.LINEAR], [gl.TEXTURE_MAG_FILTER, gl.LINEAR],
+        [gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE], [gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE]]) {
+        gl.texParameteri(gl.TEXTURE_2D, k, val);
+      }
+      const uRip = gl.getUniformLocation(prog, 'rip');
+      const uTime = gl.getUniformLocation(prog, 'time');
+      const uAspect = gl.getUniformLocation(prog, 'aspect');
+
+      // --- Rasterise hero content to a 2D canvas ---
+      const src = document.createElement('canvas');
+      const ctx = src.getContext('2d');
+      const btn = hero.querySelector('.btn');
+      const rootStyle = getComputedStyle(document.documentElement);
+      const btnColors = {
+        base: getComputedStyle(btn).backgroundColor,
+        hover: rootStyle.getPropertyValue('--text').trim() || '#3e2723'
+      };
+      const bgImg = new Image();
+      bgImg.crossOrigin = 'anonymous';
+      let bgReady = false;
+      bgImg.onload = () => { bgReady = true; dirty = true; kick(); };
+      bgImg.src = (getComputedStyle(hero).backgroundImage.match(/url\(["']?([^"')]+)["']?\)/) || [])[1] || '';
+
+      let w = 0, h = 0, dpr = 1, dirty = true, hovering = false;
+
+      function drawWords(el, rect0, color) {
+        const cs = getComputedStyle(el);
+        ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${parseFloat(cs.fontSize)}px ${cs.fontFamily}`;
+        if ('letterSpacing' in ctx && cs.letterSpacing !== 'normal') ctx.letterSpacing = cs.letterSpacing;
+        ctx.fillStyle = color;
+        ctx.textBaseline = 'middle';
+        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
+        const range = document.createRange();
+        for (let n; (n = walker.nextNode());) {
+          const re = /\S+/g;
+          for (let m; (m = re.exec(n.nodeValue));) {
+            range.setStart(n, m.index);
+            range.setEnd(n, m.index + m[0].length);
+            const r = range.getClientRects()[0];
+            if (r) ctx.fillText(m[0], r.left - rect0.left, r.top - rect0.top + r.height / 2);
+          }
+        }
+      }
+
+      function paint() {
+        const hr = hero.getBoundingClientRect();
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        ctx.clearRect(0, 0, w, h);
+        ctx.fillStyle = '#2a1d19';
+        ctx.fillRect(0, 0, w, h);
+        if (bgReady) {
+          const s = Math.max(w / bgImg.naturalWidth, h / bgImg.naturalHeight);
+          const iw = bgImg.naturalWidth * s, ih = bgImg.naturalHeight * s;
+          ctx.drawImage(bgImg, (w - iw) / 2, (h - ih) / 2, iw, ih);
+        }
+        ctx.fillStyle = 'rgba(0,0,0,.5)';
+        ctx.fillRect(0, 0, w, h);
+
+        const br = btn.getBoundingClientRect();
+        const rad = parseFloat(getComputedStyle(btn).borderTopLeftRadius) || 0;
+        ctx.fillStyle = hovering ? btnColors.hover : btnColors.base;
+        ctx.beginPath();
+        ctx.roundRect(br.left - hr.left, br.top - hr.top, br.width, br.height, rad);
+        ctx.fill();
+
+        drawWords(hero.querySelector('h1'), hr, '#fff');
+        drawWords(hero.querySelector('p'), hr, '#fff');
+        drawWords(btn, hr, '#fff');
+
+        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, src);
+      }
+
+      function resize() {
+        dpr = Math.min(window.devicePixelRatio || 1, 2);
+        w = hero.clientWidth; h = hero.clientHeight;
+        canvas.width = src.width = Math.round(w * dpr);
+        canvas.height = src.height = Math.round(h * dpr);
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        dirty = true; kick();
+      }
+
+      // --- Ripples + render loop ---
+      const ripples = new Float32Array(MAX * 3).fill(-100);
+      let next = 0, raf = 0, last = null;
+      const now = () => performance.now() / 1000;
+
+      function addRipple(x, y) {
+        const r = hero.getBoundingClientRect();
+        ripples.set([(x - r.left) / r.width, 1 - (y - r.top) / r.height, now()], next * 3);
+        next = (next + 1) % MAX;
+        kick();
+      }
+
+      function frame() {
+        raf = 0;
+        const t = now();
+        if (dirty) { paint(); dirty = false; }
+        gl.uniform3fv(uRip, ripples);
+        gl.uniform1f(uTime, t);
+        gl.uniform1f(uAspect, w / h);
+        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
+        let active = hovering; // keep repainting through the button hover fade
+        for (let i = 0; i < MAX; i++) if (t - ripples[i * 3 + 2] < LIFE) active = true;
+        if (active || dirty) raf = requestAnimationFrame(frame);
+      }
+      function kick() { if (!raf) raf = requestAnimationFrame(frame); }
+
+      hero.addEventListener('pointermove', e => {
+        if (last && Math.hypot(e.clientX - last[0], e.clientY - last[1]) < 70) return;
+        last = [e.clientX, e.clientY];
+        addRipple(e.clientX, e.clientY);
+      });
+      hero.addEventListener('pointerdown', e => addRipple(e.clientX, e.clientY));
+      hero.addEventListener('pointerleave', () => { last = null; });
+      btn.addEventListener('pointerenter', () => { hovering = true; dirty = true; kick(); });
+      btn.addEventListener('pointerleave', () => { hovering = false; dirty = true; kick(); });
+      new ResizeObserver(resize).observe(hero);
+      document.fonts && document.fonts.ready.then(() => { dirty = true; kick(); });
+
+      hero.classList.add('gl-active');
+      resize();
+      addRipple(hero.getBoundingClientRect().left + hero.clientWidth / 2,
+        hero.getBoundingClientRect().top + hero.clientHeight / 2);
+    })();
+  </script>
+
 </body>
 
