+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var tempEl = document.getElementById('roast-temp-value');
+      var ctx = canvas.getContext('2d');
+      if (!widget || !ctx) return;
+
+      // Cross-browser rAF with timer fallback
+      var raf = window.requestAnimationFrame || window.webkitRequestAnimationFrame ||
+        function (cb) { return setTimeout(function () { cb(Date.now()); }, 16); };
+      var caf = window.cancelAnimationFrame || window.webkitCancelAnimationFrame || clearTimeout;
+
+      var W = 0, H = 0, dpr = 1;
+      function resize() {
+        dpr = window.devicePixelRatio || 1;
+        W = canvas.clientWidth;
+        H = canvas.clientHeight;
+        canvas.width = W * dpr;
+        canvas.height = H * dpr;
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      }
+      resize();
+      window.addEventListener('resize', resize);
+
+      var temp = 180;     // simulated °C
+      var progress = 0;   // 0 (green) .. 1 (dark)
+      var beans = [];
+      for (var i = 0; i < 40; i++) {
+        beans.push({
+          x: Math.random(), y: Math.random(),
+          r: 10 + Math.random() * 6,
+          a: Math.random() * Math.PI * 2,
+          vx: (Math.random() - 0.5) * 0.0006,
+          vy: (Math.random() - 0.5) * 0.0006,
+          va: (Math.random() - 0.5) * 0.04
+        });
+      }
+
+      function beanColor(p) {
+        // green -> light brown -> dark brown
+        var r = Math.round(120 - 80 * p), g = Math.round(140 - 100 * p), b = Math.round(60 - 40 * p);
+        if (p < 0.5) { r = Math.round(120 + 40 * p * 2); g = Math.round(140 - 40 * p * 2); b = Math.round(60 - 10 * p * 2); }
+        return 'rgb(' + r + ',' + g + ',' + b + ')';
+      }
+
+      function draw() {
+        ctx.clearRect(0, 0, W, H);
+        var color = beanColor(progress);
+        for (var i = 0; i < beans.length; i++) {
+          var bn = beans[i];
+          bn.x += bn.vx; bn.y += bn.vy; bn.a += bn.va;
+          if (bn.x < 0 || bn.x > 1) bn.vx *= -1;
+          if (bn.y < 0 || bn.y > 1) bn.vy *= -1;
+          ctx.save();
+          ctx.translate(bn.x * W, bn.y * H);
+          ctx.rotate(bn.a);
+          ctx.fillStyle = color;
+          ctx.beginPath();
+          ctx.ellipse(0, 0, bn.r * 1.3, bn.r, 0, 0, Math.PI * 2);
+          ctx.fill();
+          ctx.strokeStyle = 'rgba(0,0,0,0.45)';
+          ctx.lineWidth = 1.5;
+          ctx.beginPath();
+          ctx.moveTo(-bn.r * 1.2, 0);
+          ctx.quadraticCurveTo(0, bn.r * 0.5, bn.r * 1.2, 0);
+          ctx.stroke();
+          ctx.restore();
+        }
+      }
+
+      var frameId = null, tempTimer = null;
+
+      function loop() {
+        draw();
+        frameId = raf(loop);
+      }
+
+      function tick() {
+        // heat climbs toward ~230°C with jitter, then resets for a new batch
+        temp += 0.4 + Math.random() * 1.2;
+        if (temp > 230) { temp = 180; }
+        progress = (temp - 180) / 50;
+        tempEl.textContent = temp.toFixed(1);
+      }
+
+      function start() {
+        if (frameId === null) frameId = raf(loop);
+        if (tempTimer === null) tempTimer = setInterval(tick, 500);
+      }
+
+      function stop() {
+        if (frameId !== null) { caf(frameId); frameId = null; }
+        if (tempTimer !== null) { clearInterval(tempTimer); tempTimer = null; }
+      }
+
+      var inView = false;
+      var tabVisible = true;
+      function update() {
+        if (inView && tabVisible) start(); else stop();
+      }
+
+      // Also pause when the tab is hidden
+      document.addEventListener('visibilitychange', function () {
+        tabVisible = !document.hidden;
+        update();
+      });
+
+      if ('IntersectionObserver' in window) {
+        new IntersectionObserver(function (entries) {
+          inView = entries[entries.length - 1].isIntersecting;
+          update();
+        }).observe(widget);
+      } else {
+        // Fallback for older browsers: geometry check on scroll/resize
+        var check = function () {
+          var rect = widget.getBoundingClientRect();
+          var vh = window.innerHeight || document.documentElement.clientHeight;
+          var visible = rect.bottom > 0 && rect.top < vh;
+          if (visible !== inView) { inView = visible; update(); }
+        };
+        window.addEventListener('scroll', check, { passive: true });
+        window.addEventListener('resize', check);
+        window.addEventListener('load', check);
+        check();
+      }
+    })();
+  </script>
+
