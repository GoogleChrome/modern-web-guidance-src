+    /* Roast Selector */
+    .roast-select {
+      position: relative;
+      width: 220px;
+      margin-bottom: 1.2rem;
+      text-align: left;
+    }
+
+    .roast-label {
+      display: block;
+      font-size: 0.8rem;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      margin-bottom: 6px;
+    }
+
+    .roast-toggle {
+      width: 100%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      padding: 10px 14px;
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      cursor: pointer;
+    }
+
+    .roast-toggle:focus-visible {
+      outline: 2px solid white;
+      outline-offset: 2px;
+    }
+
+    /* Arrow */
+    .roast-toggle::after {
+      content: '';
+      width: 8px;
+      height: 8px;
+      border-right: 2px solid var(--accent);
+      border-bottom: 2px solid var(--accent);
+      transform: translateY(-2px) rotate(45deg);
+      transition: transform 0.2s;
+    }
+
+    .roast-toggle[aria-expanded="true"]::after {
+      transform: translateY(2px) rotate(-135deg);
+    }
+
+    .roast-list {
+      display: none;
+      position: absolute;
+      top: calc(100% + 4px);
+      left: 0;
+      right: 0;
+      z-index: 10;
+      list-style: none;
+      background: var(--primary);
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      overflow: hidden;
+    }
+
+    .roast-toggle[aria-expanded="true"]+.roast-list {
+      display: block;
+    }
+
+    .roast-list li {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding: 10px 14px;
+      color: white;
+      cursor: pointer;
+    }
+
+    .roast-list li.active,
+    .roast-list li:hover {
+      background: var(--accent);
+      color: var(--primary);
+    }
+
+    /* Checkmark */
+    .roast-list li::after {
+      content: '';
+      width: 5px;
+      height: 10px;
+      border-right: 2px solid var(--accent);
+      border-bottom: 2px solid var(--accent);
+      transform: rotate(45deg);
+      visibility: hidden;
+    }
+
+    .roast-list li[aria-selected="true"]::after {
+      visibility: visible;
+    }
+
+    .roast-list li.active::after,
+    .roast-list li:hover::after {
+      border-color: var(--primary);
+    }
+
