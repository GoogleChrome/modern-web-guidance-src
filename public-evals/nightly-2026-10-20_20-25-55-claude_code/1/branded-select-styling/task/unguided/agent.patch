+  <script>
+    (function () {
+      var root = document.getElementById('roast-select');
+      var toggle = root.querySelector('.roast-toggle');
+      var list = root.querySelector('.roast-list');
+      var options = Array.prototype.slice.call(list.children);
+      var valueEl = document.getElementById('roast-value');
+      var active = 1;
+
+      function setActive(i) {
+        active = (i + options.length) % options.length;
+        options.forEach(function (o, n) { o.classList.toggle('active', n === active); });
+      }
+      function open() {
+        toggle.setAttribute('aria-expanded', 'true');
+        setActive(options.findIndex(function (o) { return o.getAttribute('aria-selected') === 'true'; }));
+        list.focus();
+      }
+      function close(refocus) {
+        toggle.setAttribute('aria-expanded', 'false');
+        options.forEach(function (o) { o.classList.remove('active'); });
+        if (refocus) toggle.focus();
+      }
+      function choose(i) {
+        options.forEach(function (o, n) { o.setAttribute('aria-selected', n === i ? 'true' : 'false'); });
+        valueEl.textContent = options[i].textContent;
+        root.dataset.value = options[i].dataset.value;
+        root.dispatchEvent(new CustomEvent('roastchange', { detail: root.dataset.value }));
+        close(true);
+      }
+
+      root.dataset.value = 'medium';
+      toggle.addEventListener('click', function () {
+        toggle.getAttribute('aria-expanded') === 'true' ? close() : open();
+      });
+      options.forEach(function (o, i) {
+        o.addEventListener('mouseenter', function () { setActive(i); });
+        o.addEventListener('click', function () { choose(i); });
+      });
+      list.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown') setActive(active + 1);
+        else if (e.key === 'ArrowUp') setActive(active - 1);
+        else if (e.key === 'Home') setActive(0);
+        else if (e.key === 'End') setActive(options.length - 1);
+        else if (e.key === 'Enter' || e.key === ' ') choose(active);
+        else if (e.key === 'Escape') close(true);
+        else if (e.key === 'Tab') close();
+        else return;
+        e.preventDefault();
+      });
+      toggle.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); open(); }
+      });
+      document.addEventListener('click', function (e) {
+        if (!root.contains(e.target)) close();
+      });
+    })();
+  </script>
