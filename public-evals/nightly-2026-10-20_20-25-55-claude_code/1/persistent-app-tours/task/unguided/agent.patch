     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <div id="tour-step" role="dialog" aria-label="Rewards tour">
+    <p>Earn points with every purchase and redeem them for free drinks!</p>
+    <button type="button" class="btn" id="tour-close">Got it</button>
+  </div>
+
+  <script>
+    (function () {
+      var feature = document.getElementById('feature');
+      var step = document.getElementById('tour-step');
+      var open = true;
+
+      function position() {
+        if (!open) return;
+        var r = feature.getBoundingClientRect();
+        var w = step.offsetWidth;
+        var left = r.left + r.width / 2 - w / 2;
+        left = Math.max(8, Math.min(left, window.innerWidth - w - 8));
+        step.style.transform = 'translate(' + left + 'px,' + (r.bottom + 12) + 'px)';
+        step.style.setProperty('--arrow-x', (r.left + r.width / 2 - left) + 'px');
+      }
+
+      function close() {
+        open = false;
+        step.hidden = true;
+        feature.classList.remove('tour-active');
+        window.removeEventListener('resize', position);
+        window.removeEventListener('scroll', position);
+        if (ro) ro.disconnect();
+      }
+
+      // Keep the tour link from navigating while the tour is open
+      feature.addEventListener('click', function (e) {
+        if (open) e.preventDefault();
+      });
+      document.getElementById('tour-close').addEventListener('click', close);
+
+      feature.classList.add('tour-active');
+      window.addEventListener('resize', position);
+      window.addEventListener('scroll', position, { passive: true });
+      var ro = window.ResizeObserver ? new ResizeObserver(position) : null;
+      if (ro) { ro.observe(feature); ro.observe(document.body); }
+      position();
+    })();
+  </script>
+
 </body>
 
 </html>
