diff --git a/src/components/WebMCPTools.tsx b/src/components/WebMCPTools.tsx
new file mode 100644
index 0000000..7cf083a
--- /dev/null
+++ b/src/components/WebMCPTools.tsx
@@ -0,0 +1,91 @@
+import { useWebMCP } from 'use-webmcp-tool';
+
+interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+}
+
+const api = (path: string) => `${import.meta.env.BASE_URL}api/${path}`;
+
+async function getArticles(signal: AbortSignal): Promise<Article[]> {
+  const response = await fetch(api('articles.json'), { signal });
+  return response.json();
+}
+
+async function getReadingList(signal: AbortSignal): Promise<string[]> {
+  const response = await fetch(api('reading-list.json'), { signal });
+  return (await response.json()).readingList;
+}
+
+// The reading list endpoint toggles, so check current state first to keep add/remove idempotent.
+async function setInReadingList(slug: string, wanted: boolean, signal: AbortSignal) {
+  const articles = await getArticles(signal);
+  if (!articles.some((a) => a.slug === slug)) {
+    return { error: `No article with slug "${slug}".`, availableSlugs: articles.map((a) => a.slug) };
+  }
+  let readingList = await getReadingList(signal);
+  if (readingList.includes(slug) !== wanted) {
+    const response = await fetch(api('reading-list.json'), {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ slug }),
+      signal,
+    });
+    readingList = (await response.json()).readingList;
+    // Let mounted bookmark UI refresh itself.
+    window.dispatchEvent(new CustomEvent('reading-list-changed', { detail: { readingList } }));
+  }
+  return { readingList };
+}
+
+const slugSchema = {
+  type: 'object',
+  properties: { slug: { type: 'string', description: 'Slug of the article, as returned by search_articles.' } },
+  required: ['slug'],
+};
+
+export default function WebMCPTools() {
+  useWebMCP({
+    name: 'search_articles',
+    description: 'Searches The DevTools Times articles by keyword in the title or summary. Use when the user wants to find or browse articles.',
+    inputSchema: {
+      type: 'object',
+      properties: { query: { type: 'string', description: 'Words to look for. Leave empty to list all articles.' } },
+    },
+    async execute({ query = '' }: { query?: string }, { signal }) {
+      const term = String(query).toLowerCase();
+      const articles = await getArticles(signal);
+      return articles
+        .filter((a) => a.title.toLowerCase().includes(term) || a.summary.toLowerCase().includes(term))
+        .map((a) => ({ ...a, url: `${import.meta.env.BASE_URL}articles/${a.slug}` }));
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get_reading_list',
+    description: "Returns the articles saved in the user's reading list.",
+    async execute(_args: unknown, { signal }) {
+      const [articles, readingList] = await Promise.all([getArticles(signal), getReadingList(signal)]);
+      return articles.filter((a) => readingList.includes(a.slug));
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'add_to_reading_list',
+    description: "Saves an article to the user's reading list. Does nothing if it is already saved.",
+    inputSchema: slugSchema,
+    execute: ({ slug }: { slug: string }, { signal }) => setInReadingList(slug, true, signal),
+  });
+
+  useWebMCP({
+    name: 'remove_from_reading_list',
+    description: "Removes an article from the user's reading list. Does nothing if it is not saved.",
+    inputSchema: slugSchema,
+    execute: ({ slug }: { slug: string }, { signal }) => setInReadingList(slug, false, signal),
+  });
+
+  return null;
+}
