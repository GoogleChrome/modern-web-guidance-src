diff --git a/passkeys-api.js b/passkeys-api.js
new file mode 100644
index 0000000..720f531
--- /dev/null
+++ b/passkeys-api.js
@@ -0,0 +1,60 @@
+// Demo data layer for the passkey management page.
+// The site has no backend, so credentials live in localStorage. Each function
+// mirrors an endpoint from the passkey-management guide; swap the bodies for
+// fetch() calls to GET /api/credentials, PUT|DELETE /api/credential/:id and
+// PUT /api/user when a real server exists.
+const KEY = 'dailygrind.passkeys';
+const USER_KEY = 'dailygrind.passkeyUser';
+
+const read = () => JSON.parse(localStorage.getItem(KEY) || '[]');
+const write = (list) => localStorage.setItem(KEY, JSON.stringify(list));
+
+export function getUser() {
+  let user = JSON.parse(localStorage.getItem(USER_KEY) || 'null');
+  if (!user) {
+    const id = crypto.getRandomValues(new Uint8Array(16));
+    user = { id: toBase64Url(id), name: 'coffee.lover@example.com', displayName: 'Coffee Lover' };
+    localStorage.setItem(USER_KEY, JSON.stringify(user));
+  }
+  return user;
+}
+
+export async function updateUser({ name, displayName }) {
+  const user = { ...getUser(), name, displayName };
+  localStorage.setItem(USER_KEY, JSON.stringify(user));
+  return user;
+}
+
+export async function listCredentials() {
+  return read().sort((a, b) => b.registeredAt - a.registeredAt);
+}
+
+export async function addCredential(cred) {
+  write([...read(), cred]);
+  return cred;
+}
+
+export async function renameCredential(id, name) {
+  const list = read();
+  const cred = list.find((c) => c.id === id);
+  if (!cred) throw new Error('Credential not found.');
+  cred.name = name;
+  write(list);
+  return cred;
+}
+
+export async function deleteCredential(id) {
+  write(read().filter((c) => c.id !== id));
+}
+
+export function toBase64Url(buffer) {
+  const bytes = new Uint8Array(buffer);
+  let s = '';
+  for (const b of bytes) s += String.fromCharCode(b);
+  return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function fromBase64Url(str) {
+  const b64 = str.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(str.length / 4) * 4, '=');
+  return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
+}
