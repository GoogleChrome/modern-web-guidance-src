+import {
+  getUser, updateUser, listCredentials, addCredential,
+  renameCredential, deleteCredential, toBase64Url, fromBase64Url,
+} from './passkeys-api.js';
+
+const rpId = location.hostname;
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+const AAGUID_REGISTRY =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+
+const $ = (id) => document.getElementById(id);
+const listEl = $('passkey-list');
+const statusEl = $('status');
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+let user = getUser();
+let registry = {};
+let creds = [];
+
+function setStatus(el, msg, isError = false) {
+  el.textContent = msg;
+  el.classList.toggle('error', isError);
+}
+
+// --- Signal API (feature-detected; userId and credential IDs are Base64URL) ---
+
+async function syncAcceptedCredentials(list) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId,
+      userId: user.id,
+      allAcceptedCredentialIds: list.map((c) => c.id),
+    });
+  } catch (e) {
+    console.error('signalAllAcceptedCredentials failed:', e);
+  }
+}
+
+async function syncUserDetails() {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId,
+      userId: user.id,
+      name: user.name,
+      displayName: user.displayName,
+    });
+  } catch (e) {
+    console.error('signalCurrentUserDetails failed:', e);
+  }
+}
+
+// --- Rendering ---
+
+function formatDate(ts) {
+  return dateFormat.format(new Date(ts));
+}
+
+function render() {
+  listEl.replaceChildren();
+  listEl.removeAttribute('aria-busy');
+
+  if (!creds.length) {
+    const p = document.createElement('li');
+    p.className = 'empty';
+    p.textContent = 'No passkeys found. Create one to sign in without a password.';
+    listEl.append(p);
+    return;
+  }
+
+  for (const cred of creds) {
+    const li = document.createElement('li');
+    li.className = 'passkey';
+
+    let icon;
+    if (cred.providerIcon) {
+      icon = document.createElement('img');
+      icon.src = cred.providerIcon;
+      icon.alt = '';
+    } else {
+      icon = document.createElement('span');
+      icon.textContent = '🔑';
+      icon.setAttribute('aria-hidden', 'true');
+    }
+    icon.classList.add('passkey-icon');
+
+    const info = document.createElement('div');
+    info.className = 'passkey-info';
+    const name = document.createElement('div');
+    name.className = 'passkey-name';
+    name.textContent = cred.name;
+    const meta = document.createElement('div');
+    meta.className = 'passkey-meta';
+    meta.textContent = `Created ${formatDate(cred.registeredAt)} · ` +
+      (cred.lastUsedAt ? `Last used ${formatDate(cred.lastUsedAt)}` : 'Never used');
+    info.append(name, meta);
+
+    const actions = document.createElement('div');
+    actions.className = 'passkey-actions';
+    const rename = document.createElement('button');
+    rename.type = 'button';
+    rename.className = 'secondary';
+    rename.textContent = 'Rename';
+    rename.setAttribute('aria-label', `Rename ${cred.name}`);
+    rename.addEventListener('click', () => openRename(cred, rename));
+    const del = document.createElement('button');
+    del.type = 'button';
+    del.className = 'danger';
+    del.textContent = 'Delete';
+    del.setAttribute('aria-label', `Delete ${cred.name}`);
+    del.addEventListener('click', () => openDelete(cred, del));
+    actions.append(rename, del);
+
+    li.append(icon, info, actions);
+    listEl.append(li);
+  }
+}
+
+async function refresh() {
+  creds = await listCredentials();
+  render();
+}
+
+// --- Rename / delete dialogs ---
+
+function wireDialog(dialog) {
+  dialog.querySelector('[data-close]').addEventListener('click', () => dialog.close('cancel'));
+}
+wireDialog($('rename-dialog'));
+wireDialog($('delete-dialog'));
+
+function openRename(cred, trigger) {
+  const dialog = $('rename-dialog');
+  const input = $('rename-form').elements.name;
+  input.value = cred.name;
+  dialog.returnValue = '';
+  dialog.addEventListener('close', async () => {
+    trigger.focus();
+    const newName = input.value.trim();
+    if (dialog.returnValue !== 'save' || !newName || newName === cred.name) return;
+    try {
+      // Nickname is a server-side label only: no Signal API call.
+      await renameCredential(cred.id, newName);
+      await refresh();
+      setStatus(statusEl, 'Passkey renamed.');
+    } catch (e) {
+      setStatus(statusEl, e.message, true);
+    }
+  }, { once: true });
+  dialog.showModal();
+  input.select();
+}
+
+function openDelete(cred, trigger) {
+  const dialog = $('delete-dialog');
+  $('delete-text').textContent =
+    `"${cred.name}" will no longer work for signing in. You may also want to remove it from your password manager.`;
+  dialog.returnValue = '';
+  dialog.addEventListener('close', async () => {
+    if (dialog.returnValue !== 'delete') return trigger.focus();
+    try {
+      await deleteCredential(cred.id);
+      await refresh();
+      await syncAcceptedCredentials(creds);
+      setStatus(statusEl, 'Passkey deleted.');
+    } catch (e) {
+      setStatus(statusEl, e.message, true);
+    }
+  }, { once: true });
+  dialog.showModal();
+}
+
+// --- Account details ---
+
+const profileForm = $('profile');
+profileForm.elements.name.value = user.name;
+profileForm.elements.displayName.value = user.displayName;
+profileForm.addEventListener('submit', async (e) => {
+  e.preventDefault();
+  const name = profileForm.elements.name.value.trim();
+  const displayName = profileForm.elements.displayName.value.trim();
+  try {
+    user = await updateUser({ name, displayName });
+    await syncUserDetails();
+    setStatus($('profile-status'), 'Account details saved.');
+  } catch (err) {
+    setStatus($('profile-status'), err.message, true);
+  }
+});
+
+// --- Create passkey ---
+
+async function passkeysSupported() {
+  if (!window.PublicKeyCredential) return false;
+  try {
+    if (PublicKeyCredential.getClientCapabilities) {
+      const caps = await PublicKeyCredential.getClientCapabilities();
+      if ('userVerifyingPlatformAuthenticator' in caps) return !!caps.userVerifyingPlatformAuthenticator;
+    }
+    return await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+  } catch {
+    return false;
+  }
+}
+
+function aaguidFromAuthData(authData) {
+  // authData: 32B rpIdHash, 1B flags, 4B counter, then 16B AAGUID
+  const hex = [...new Uint8Array(authData, 37, 16)].map((b) => b.toString(16).padStart(2, '0')).join('');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
+
+async function createPasskey() {
+  const btn = $('create');
+  btn.disabled = true;
+  setStatus(statusEl, '');
+  try {
+    // Demo only: a real server must issue the challenge and verify the response.
+    const credential = await navigator.credentials.create({
+      publicKey: {
+        rp: { id: rpId, name: 'The Daily Grind' },
+        user: { id: fromBase64Url(user.id), name: user.name, displayName: user.displayName },
+        challenge: crypto.getRandomValues(new Uint8Array(32)),
+        pubKeyCredParams: [{ type: 'public-key', alg: -7 }, { type: 'public-key', alg: -257 }],
+        excludeCredentials: creds.map((c) => ({ type: 'public-key', id: fromBase64Url(c.id) })),
+        // authenticatorAttachment omitted so security keys can be registered too
+        authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+      },
+    });
+    const aaguid = aaguidFromAuthData(credential.response.getAuthenticatorData());
+    const provider = aaguid === ZERO_AAGUID ? null : registry[aaguid];
+    await addCredential({
+      id: toBase64Url(credential.rawId),
+      aaguid,
+      name: provider?.name || 'Unknown passkey provider',
+      providerIcon: provider?.icon_light,
+      registeredAt: Date.now(),
+      lastUsedAt: null,
+    });
+    await refresh();
+    await syncAcceptedCredentials(creds);
+    setStatus(statusEl, 'Passkey created.');
+  } catch (e) {
+    if (e.name === 'NotAllowedError') setStatus(statusEl, 'Passkey creation was cancelled.');
+    else if (e.name === 'InvalidStateError') setStatus(statusEl, 'A passkey from this device is already registered.');
+    else setStatus(statusEl, 'Could not create a passkey.', true);
+  } finally {
+    btn.disabled = false;
+  }
+}
+
+$('create').addEventListener('click', createPasskey);
+
+// --- Init ---
+
+async function init() {
+  await refresh();
+  // Reconcile the password manager with the server list on every page load.
+  await syncAcceptedCredentials(creds);
+
+  if (await passkeysSupported()) $('create').hidden = false;
+
+  // Provider names/icons are a UX nicety; fetch lazily and re-render once available.
+  try {
+    const res = await fetch(AAGUID_REGISTRY);
+    registry = await res.json();
+    let changed = false;
+    creds = creds.map((c) => {
+      const p = c.aaguid !== ZERO_AAGUID && registry[c.aaguid];
+      if (p && !c.providerIcon) { changed = true; return { ...c, providerIcon: p.icon_light }; }
+      return c;
+    });
+    if (changed) render();
+  } catch { /* offline: fall back to generic icon */ }
+}
+
+init();
