diff --git a/src/pages/api/passkeys.json.ts b/src/pages/api/passkeys.json.ts
new file mode 100644
index 0000000..4170a09
--- /dev/null
+++ b/src/pages/api/passkeys.json.ts
@@ -0,0 +1,65 @@
+import type { APIRoute } from 'astro';
+
+export interface Passkey {
+  id: string;
+  name: string;
+  createdAt: string;
+}
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+
+const load = async (session: App.Locals['session'] | undefined): Promise<Passkey[]> =>
+  (await session?.get('passkeys')) || [];
+
+export const GET: APIRoute = async ({ session }) => {
+  return json({ passkeys: await load(session) });
+};
+
+// Registers a new passkey. `id` is the WebAuthn credential id.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { id, name } = await request.json();
+  if (!id || typeof id !== 'string') {
+    return json({ error: 'Credential id is required' }, 400);
+  }
+  const passkeys = await load(session);
+  if (passkeys.some((p) => p.id === id)) {
+    return json({ error: 'Passkey already registered' }, 409);
+  }
+  passkeys.push({
+    id,
+    name: (typeof name === 'string' && name.trim()) || 'Passkey',
+    createdAt: new Date().toISOString(),
+  });
+  await session?.set('passkeys', passkeys);
+  return json({ passkeys }, 201);
+};
+
+export const PATCH: APIRoute = async ({ request, session }) => {
+  const { id, name } = await request.json();
+  if (!id || typeof name !== 'string' || !name.trim()) {
+    return json({ error: 'Id and name are required' }, 400);
+  }
+  const passkeys = await load(session);
+  const passkey = passkeys.find((p) => p.id === id);
+  if (!passkey) {
+    return json({ error: 'Passkey not found' }, 404);
+  }
+  passkey.name = name.trim().slice(0, 64);
+  await session?.set('passkeys', passkeys);
+  return json({ passkeys });
+};
+
+export const DELETE: APIRoute = async ({ request, session }) => {
+  const { id } = await request.json();
+  const passkeys = await load(session);
+  if (!passkeys.some((p) => p.id === id)) {
+    return json({ error: 'Passkey not found' }, 404);
+  }
+  const remaining = passkeys.filter((p) => p.id !== id);
+  await session?.set('passkeys', remaining);
+  return json({ passkeys: remaining });
+};
