+import type { APIRoute } from 'astro';
+import { getPasskeys, getPasskeyUserId, json } from '../../../utils/passkeys';
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  if (!(await getPasskeyUserId(session))) return json({ error: 'Not signed in.' }, 401);
+
+  const { name } = await request.json().catch(() => ({}));
+  if (typeof name !== 'string' || !name.trim() || name.length > 100) {
+    return json({ error: 'A name of 1-100 characters is required.' }, 400);
+  }
+
+  const passkeys = await getPasskeys(session);
+  const passkey = passkeys.find((p) => p.id === params.id);
+  if (!passkey) return json({ error: 'Credential not found.' }, 404);
+
+  passkey.name = name.trim();
+  await session?.set('passkeys', passkeys);
+  return json(passkey);
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  if (!(await getPasskeyUserId(session))) return json({ error: 'Not signed in.' }, 401);
+
+  const passkeys = await getPasskeys(session);
+  if (!passkeys.some((p) => p.id === params.id)) return json({ error: 'Credential not found.' }, 404);
+
+  await session?.set('passkeys', passkeys.filter((p) => p.id !== params.id));
+  return json({ success: true });
+};
