@@ -0,0 +1,13 @@
+import type { APIRoute } from 'astro';
+import { getPasskeys, getPasskeyUserId, json } from '../../../utils/passkeys';
+
+export const GET: APIRoute = async ({ session, url }) => {
+  const userId = await getPasskeyUserId(session);
+  if (!userId) return json({ error: 'Not signed in.' }, 401);
+
+  return json({
+    rpId: url.hostname,
+    userId,
+    credentials: await getPasskeys(session),
+  });
+};
