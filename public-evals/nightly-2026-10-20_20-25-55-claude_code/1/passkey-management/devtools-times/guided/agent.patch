+import type { AstroSession } from 'astro';
+
+export interface StoredPasskey {
+  id: string; // Base64URL credential ID
+  name: string;
+  aaguid: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export async function getPasskeys(session: AstroSession | undefined): Promise<StoredPasskey[]> {
+  return (await session?.get('passkeys')) || [];
+}
+
+export async function getPasskeyUserId(session: AstroSession | undefined): Promise<string | null> {
+  return (await session?.get('passkeyUserId')) || null;
+}
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
