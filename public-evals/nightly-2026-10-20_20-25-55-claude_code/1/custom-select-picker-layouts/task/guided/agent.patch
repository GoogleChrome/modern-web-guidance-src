+  <script>
+    // The picker is a single 3-column row, so Left/Right move focus between neighbouring options.
+    document.getElementById('roast').addEventListener('keydown', (e) => {
+      if (!e.target.matches('option') || !['ArrowLeft', 'ArrowRight'].includes(e.key)) return;
+      const rtl = getComputedStyle(e.target).direction === 'rtl';
+      const forward = (e.key === 'ArrowRight') !== rtl;
+      const next = forward ? e.target.nextElementSibling : e.target.previousElementSibling;
+      if (next?.matches('option')) {
+        e.preventDefault();
+        next.focus();
+      }
+    });
+  </script>
 
