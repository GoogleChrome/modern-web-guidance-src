+  <script>
+    (function () {
+      var picker = document.getElementById('roast-picker');
+      var select = picker.querySelector('select');
+      var trigger = picker.querySelector('.roast-trigger');
+      var label = picker.querySelector('.roast-label');
+      var options = Array.prototype.slice.call(picker.querySelectorAll('.roast-option'));
+      var active = 0;
+
+      function setOpen(open) {
+        picker.classList.toggle('open', open);
+        trigger.setAttribute('aria-expanded', open);
+      }
+
+      function setActive(i) {
+        active = (i + options.length) % options.length;
+        options.forEach(function (o, n) { o.classList.toggle('active', n === active); });
+      }
+
+      function choose(i) {
+        var value = options[i].dataset.value;
+        select.value = value;
+        select.dispatchEvent(new Event('change', { bubbles: true }));
+      }
+
+      function sync() {
+        options.forEach(function (o) {
+          o.setAttribute('aria-selected', o.dataset.value === select.value);
+        });
+        var i = options.findIndex(function (o) { return o.dataset.value === select.value; });
+        label.textContent = options[i].querySelector('.name').textContent + ' roast';
+        setActive(i);
+      }
+
+      select.addEventListener('change', sync);
+      sync();
+
+      trigger.addEventListener('click', function () {
+        setOpen(!picker.classList.contains('open'));
+      });
+
+      options.forEach(function (o, i) {
+        o.addEventListener('click', function () {
+          choose(i);
+          setOpen(false);
+          trigger.focus();
+        });
+      });
+
+      picker.addEventListener('keydown', function (e) {
+        var open = picker.classList.contains('open');
+        if (e.key === 'Escape' && open) {
+          setOpen(false);
+        } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
+          e.preventDefault();
+          if (!open) setOpen(true); else setActive(active + 1);
+        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
+          e.preventDefault();
+          if (!open) setOpen(true); else setActive(active - 1);
+        } else if (open && (e.key === 'Enter' || e.key === ' ')) {
+          e.preventDefault();
+          choose(active);
+          setOpen(false);
+        }
+      });
+
+      document.addEventListener('click', function (e) {
+        if (!picker.contains(e.target)) setOpen(false);
+      });
+    })();
+  </script>
