+    /* Roast picker */
+    .roast-picker {
+      position: relative;
+      margin-top: 20px;
+      width: 260px;
+      text-align: left;
+    }
+
+    .roast-picker select {
+      position: absolute;
+      opacity: 0;
+      pointer-events: none;
+      width: 1px;
+      height: 1px;
+    }
+
+    .roast-trigger {
+      width: 100%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding: 10px 14px;
+      font: inherit;
+      color: var(--text);
+      background: white;
+      border: 2px solid transparent;
+      border-radius: 5px;
+      cursor: pointer;
+    }
+
+    .roast-trigger:focus-visible,
+    .roast-trigger[aria-expanded="true"] {
+      outline: none;
+      border-color: var(--accent);
+    }
+
+    .roast-menu {
+      display: none;
+      position: absolute;
+      top: calc(100% + 6px);
+      left: 50%;
+      transform: translateX(-50%);
+      width: min(440px, 90vw);
+      grid-template-columns: repeat(3, 1fr);
+      gap: 10px;
+      padding: 10px;
+      margin: 0;
+      list-style: none;
+      background: white;
+      border-radius: 10px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
+      z-index: 10;
+    }
+
+    .roast-picker.open .roast-menu {
+      display: grid;
+    }
+
+    .roast-option {
+      border-radius: 8px;
+      overflow: hidden;
+      cursor: pointer;
+      border: 2px solid transparent;
+      background: var(--light);
+      text-align: center;
+      color: var(--text);
+    }
+
+    .roast-option:hover,
+    .roast-option.active {
+      border-color: var(--accent);
+    }
+
+    .roast-option[aria-selected="true"] {
+      border-color: var(--primary);
+    }
+
+    .roast-option .thumb {
+      display: block;
+      height: 80px;
+      background-color: var(--primary);
+      background-size: cover;
+      background-position: center;
+    }
+
+    .roast-option .name {
+      display: block;
+      font-weight: 600;
+      padding: 6px 4px 0;
+    }
+
+    .roast-option .note {
+      display: block;
+      font-size: 0.75rem;
+      padding: 0 4px 8px;
+      opacity: 0.75;
+    }
