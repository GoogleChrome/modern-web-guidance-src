+import { createServer } from 'node:http';
+import { randomBytes } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import { verifyEmailVerificationToken } from './verify-email.js';
+
+const PORT = process.env.PORT || 11222;
+// Public origin of this site; the browser binds the token to it (the KB-JWT audience).
+const RP_ORIGIN = process.env.RP_ORIGIN || `http://localhost:${PORT}`;
+// Email Verification API origin trial token (https://developer.chrome.com/origintrials).
+const ORIGIN_TRIAL_TOKEN = process.env.ORIGIN_TRIAL_TOKEN || '';
+
+const MODES = {
+  signup: { title: 'Create your account', cta: 'Create account' },
+  signin: { title: 'Sign in', cta: 'Sign in' },
+  recover: { title: 'Recover your account', cta: 'Continue' },
+};
+
+// In-memory session store: sid -> { nonce }. Swap for a real store in production.
+const sessions = new Map();
+
+const escapeHtml = (s) =>
+  String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+
+function getSession(req, res) {
+  const sid = /(?:^|; )sid=([\w-]+)/.exec(req.headers.cookie || '')?.[1];
+  if (sid && sessions.has(sid)) return sessions.get(sid);
+  const newSid = randomBytes(32).toString('base64url');
+  const session = {};
+  sessions.set(newSid, session);
+  const secure = RP_ORIGIN.startsWith('https:') ? '; Secure' : '';
+  res.setHeader('Set-Cookie', `sid=${newSid}; HttpOnly; SameSite=Lax; Path=/${secure}`);
+  return session;
+}
+
+// Atomically read and delete the single-use nonce.
+function consumeNonce(session) {
+  const { nonce } = session;
+  delete session.nonce;
+  return nonce;
+}
+
+async function readForm(req) {
+  let body = '';
+  for await (const chunk of req) {
+    body += chunk;
+    if (body.length > 64 * 1024) throw new Error('Body too large');
+  }
+  return new URLSearchParams(body);
+}
+
+const PAGE_STYLES = `
+  :root { --primary: #4e342e; --secondary: #d7ccc8; --accent: #ffab40; --text: #3e2723; --light: #fafafa; }
+  * { box-sizing: border-box; margin: 0; padding: 0; }
+  body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: var(--text); background: var(--light); }
+  nav { background: var(--primary); color: white; padding: 1rem 5%; }
+  nav a { color: white; text-decoration: none; font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+  main { max-width: 420px; margin: 40px auto; padding: 0 20px; }
+  .card { background: white; padding: 28px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); }
+  h1 { color: var(--primary); margin-bottom: 8px; }
+  .tabs { display: flex; gap: 16px; margin: 12px 0 20px; font-size: 0.9rem; }
+  .tabs a { color: var(--text); }
+  .tabs a[aria-current="page"] { font-weight: bold; color: var(--primary); }
+  label { display: block; font-weight: 600; margin-bottom: 4px; }
+  input[type="email"] { width: 100%; padding: 10px; border: 1px solid var(--secondary); border-radius: 5px; font: inherit; }
+  input[type="email"]:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+  button { margin-top: 16px; width: 100%; background: var(--primary); color: white; padding: 10px 20px; border: 0; border-radius: 5px; font: inherit; cursor: pointer; }
+  button:hover { background: #3e2723; }
+  .notice { padding: 12px; border-radius: 5px; margin-bottom: 16px; }
+  .notice.ok { background: #e8f5e9; }
+  .notice.info { background: #fff3e0; }
+  .hint { font-size: 0.85rem; margin-top: 12px; }
+`;
+
+function renderPage({ mode, nonce, notice }) {
+  const { title, cta } = MODES[mode];
+  const tabs = Object.entries(MODES)
+    .map(([key, m]) => `<a href="/account?mode=${key}"${key === mode ? ' aria-current="page"' : ''}>${m.cta === 'Continue' ? 'Recover' : m.cta === 'Sign in' ? 'Sign in' : 'Sign up'}</a>`)
+    .join('');
+  const trialMeta = ORIGIN_TRIAL_TOKEN
+    ? `<meta http-equiv="origin-trial" content="${escapeHtml(ORIGIN_TRIAL_TOKEN)}">`
+    : '';
+  const noticeHtml = notice ? `<p class="notice ${notice.kind}" role="status">${escapeHtml(notice.text)}</p>` : '';
+  return `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>${escapeHtml(title)} | The Daily Grind</title>
+  ${trialMeta}
+  <style>${PAGE_STYLES}</style>
+</head>
+<body>
+  <nav><a href="/">THE DAILY GRIND</a></nav>
+  <main>
+    <div class="card">
+      <h1>${escapeHtml(title)}</h1>
+      <div class="tabs">${tabs}</div>
+      ${noticeHtml}
+      <form method="POST" action="/api/verify-email">
+        <input type="hidden" name="mode" value="${mode}">
+        <label for="email">Email address</label>
+        <input type="email" id="email" name="email" autocomplete="email" required>
+        <!-- Filled by the browser with an Email Verification Token; empty when unsupported. -->
+        <input type="hidden" name="token" nonce="${nonce}" autocomplete="email-verification-token">
+        <button type="submit">${cta}</button>
+      </form>
+      <p class="hint">We confirm your email with your email provider, so there's no code to copy or link to click when your browser supports it.</p>
+    </div>
+  </main>
+</body>
+</html>`;
+}
+
+function sendHtml(res, status, html) {
+  res.writeHead(status, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' });
+  res.end(html);
+}
+
+// Placeholder: this app has no mailer yet. Wire a real OTP/magic-link sender here.
+async function sendTraditionalVerificationEmail(email) {
+  console.log(`[fallback] would send verification email to ${email}`);
+}
+
+function renderForm(req, res, mode, notice) {
+  const session = getSession(req, res);
+  // Fresh nonce per render, kept server-side only.
+  session.nonce = randomBytes(32).toString('base64url');
+  sendHtml(res, 200, renderPage({ mode, nonce: session.nonce, notice }));
+}
+
+async function handleSubmission(req, res) {
+  const session = getSession(req, res);
+  const form = await readForm(req);
+  const mode = MODES[form.get('mode')] ? form.get('mode') : 'signup';
+  const email = String(form.get('email') || '').trim();
+  const rawToken = String(form.get('token') || '').trim();
+  const expectedNonce = consumeNonce(session);
+
+  if (!/^[^@\s]+@[^@\s]+$/.test(email)) {
+    return renderForm(req, res, mode, { kind: 'info', text: 'Please enter a valid email address.' });
+  }
+
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({ rawToken, submittedEmail: email, expectedNonce, expectedAudience: RP_ORIGIN });
+      // TODO: create the account / start the session / allow password reset for `email`.
+      return renderForm(req, res, mode, { kind: 'ok', text: `Verified ${email} with your email provider. No email needed.` });
+    } catch (err) {
+      console.error('Email verification token check failed:', err);
+    }
+  }
+
+  // Never block the user: fall back to the traditional flow.
+  await sendTraditionalVerificationEmail(email);
+  renderForm(req, res, mode, { kind: 'info', text: `We couldn't verify ${email} automatically, so we'll send a confirmation email instead.` });
+}
+
+createServer(async (req, res) => {
+  try {
+    const url = new URL(req.url, RP_ORIGIN);
+    if (req.method === 'GET' && url.pathname === '/') {
+      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
+      return res.end(await readFile(new URL('./index.html', import.meta.url)));
+    }
+    if (req.method === 'GET' && url.pathname === '/account') {
+      const mode = MODES[url.searchParams.get('mode')] ? url.searchParams.get('mode') : 'signup';
+      return renderForm(req, res, mode);
+    }
+    if (req.method === 'POST' && url.pathname === '/api/verify-email') {
+      return await handleSubmission(req, res);
+    }
+    res.writeHead(404, { 'Content-Type': 'text/plain' });
+    res.end('Not found');
+  } catch (err) {
+    console.error(err);
+    res.writeHead(500, { 'Content-Type': 'text/plain' });
+    res.end('Server error');
+  }
+}).listen(PORT, () => console.log(`Daily Grind running at ${RP_ORIGIN}`));
diff --git a/verify-email.js b/verify-email.js
