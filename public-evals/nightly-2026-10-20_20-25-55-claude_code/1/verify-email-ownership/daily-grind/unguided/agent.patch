+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Sign in | The Daily Grind</title>
+  <style>
+    :root { --primary: #4e342e; --secondary: #d7ccc8; --accent: #ffab40; --text: #3e2723; --light: #fafafa; }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: var(--text); background: var(--light); }
+    nav { background: var(--primary); color: white; padding: 1rem 5%; }
+    nav a { color: white; text-decoration: none; font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+    main { max-width: 420px; margin: 60px auto; padding: 0 20px; }
+    .card { background: white; padding: 28px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0, 0, 0, .1); }
+    h1 { color: var(--primary); margin-bottom: 6px; }
+    .tabs { display: flex; gap: 8px; margin: 16px 0; }
+    .tabs button { flex: 1; padding: 8px; border: 1px solid var(--secondary); background: white; border-radius: 5px; cursor: pointer; color: var(--text); }
+    .tabs button[aria-pressed="true"] { background: var(--primary); color: white; border-color: var(--primary); }
+    label { display: block; font-size: .9rem; margin-bottom: 4px; }
+    input { width: 100%; padding: 10px; border: 1px solid var(--secondary); border-radius: 5px; font-size: 1rem; }
+    .btn { width: 100%; margin-top: 16px; background: var(--primary); color: white; padding: 10px; border: 0; border-radius: 5px; font-size: 1rem; cursor: pointer; }
+    .btn:disabled { opacity: .6; cursor: wait; }
+    .hint { font-size: .85rem; margin-top: 12px; color: #6d4c41; }
+    .error { color: #b71c1c; margin-top: 12px; font-size: .9rem; }
+  </style>
+</head>
+
+<body>
+  <nav><a href="/">THE DAILY GRIND</a></nav>
+  <main>
+    <form class="card" id="form">
+      <h1 id="title">Sign in</h1>
+      <p class="hint" id="blurb"></p>
+      <div class="tabs" role="group" aria-label="Mode">
+        <button type="button" data-mode="signin">Sign in</button>
+        <button type="button" data-mode="signup">Create account</button>
+        <button type="button" data-mode="recover">Recover</button>
+      </div>
+      <label for="email">Email address</label>
+      <input id="email" name="email" type="email" autocomplete="email" required autofocus>
+      <button class="btn" id="go" type="submit">Verify with Google</button>
+      <p class="hint">We confirm you own this address by having you sign in to the Google account that holds it.
+        No code or link is emailed.</p>
+      <p class="error" id="error" role="alert"></p>
+    </form>
+  </main>
+
+  <script>
+    const blurbs = {
+      signin: 'Welcome back.',
+      signup: 'Create your account by verifying your email.',
+      recover: 'No password to reset. Verify your email to get back in.',
+    };
+    const titles = { signin: 'Sign in', signup: 'Create account', recover: 'Recover account' };
+    const $ = (id) => document.getElementById(id);
+    let mode = new URLSearchParams(location.search).get('mode');
+    if (!blurbs[mode]) mode = 'signin';
+
+    function render() {
+      $('title').textContent = titles[mode];
+      $('blurb').textContent = blurbs[mode];
+      document.querySelectorAll('.tabs button').forEach((b) => b.setAttribute('aria-pressed', b.dataset.mode === mode));
+    }
+    document.querySelectorAll('.tabs button').forEach((b) => b.addEventListener('click', () => { mode = b.dataset.mode; render(); }));
+    render();
+
+    const err = new URLSearchParams(location.search).get('error');
+    if (err) $('error').textContent = err;
+
+    $('form').addEventListener('submit', async (e) => {
+      e.preventDefault();
+      $('error').textContent = '';
+      $('go').disabled = true;
+      try {
+        const res = await fetch('/auth/start', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ email: $('email').value, mode }),
+        });
+        const data = await res.json();
+        if (!res.ok) throw new Error(data.error || 'Something went wrong.');
+        location.href = data.url;
+      } catch (ex) {
+        $('error').textContent = ex.message;
+        $('go').disabled = false;
+      }
+    });
+  </script>
+</body>
+
+</html>
