+  <script>
+    const canvas = document.getElementById('canvas');
+    const stage = document.getElementById('cup-stage');
+    const form = document.getElementById('cup-form');
+    const summary = document.getElementById('cup-summary');
+    const ctx = canvas.getContext('2d');
+    const FORM_X = 100;
+    const FORM_Y = 120;
+    const nativeHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
 
+    function updateSummary(confirmed) {
+      const data = new FormData(form);
+      const name = (data.get('name') || '').trim();
+      const syrups = data.getAll('syrup');
+      const text = `${data.get('milk')} milk` + (syrups.length ? `, ${syrups.join(' + ')} syrup` : ', no syrup');
+      summary.textContent = confirmed ? `Added for ${name || 'you'}: ${text}` : '';
+    }
+
+    form.addEventListener('submit', (e) => e.preventDefault());
+    document.getElementById('cup-add').addEventListener('click', () => updateSummary(true));
+    form.addEventListener('input', () => updateSummary(false));
+
+    // Decorative cup, in CSS pixel coordinates (the context is pre-scaled to device pixels)
+    function drawCup() {
+      ctx.reset();
+      ctx.scale(canvas.width / canvas.clientWidth, canvas.height / canvas.clientHeight);
+
+      // Steam
+      ctx.strokeStyle = '#d7ccc8';
+      ctx.lineWidth = 5;
+      ctx.lineCap = 'round';
+      for (const x of [140, 190, 240]) {
+        ctx.beginPath();
+        ctx.moveTo(x, 55);
+        ctx.bezierCurveTo(x - 14, 40, x + 14, 25, x, 8);
+        ctx.stroke();
+      }
+
+      // Handle
+      ctx.strokeStyle = '#4e342e';
+      ctx.lineWidth = 14;
+      ctx.beginPath();
+      ctx.ellipse(335, 210, 45, 60, 0, -Math.PI / 2, Math.PI / 2);
+      ctx.stroke();
+
+      // Body
+      ctx.beginPath();
+      ctx.moveTo(40, 100);
+      ctx.lineTo(360, 100);
+      ctx.lineTo(320, 420);
+      ctx.lineTo(80, 420);
+      ctx.closePath();
+      ctx.fillStyle = '#fafafa';
+      ctx.fill();
+      ctx.lineWidth = 6;
+      ctx.strokeStyle = '#4e342e';
+      ctx.lineJoin = 'round';
+      ctx.stroke();
+
+      // Sleeve band
+      ctx.fillStyle = '#d7ccc8';
+      ctx.fillRect(46, 108, 308, 8);
+
+      // Lid
+      ctx.fillStyle = '#4e342e';
+      ctx.beginPath();
+      ctx.roundRect(28, 78, 344, 26, 8);
+      ctx.fill();
+    }
+
+    function draw() {
+      drawCup();
+      if (nativeHtmlInCanvas) {
+        // Browser keeps hit-testing, a11y bounds and find-in-page aligned with the drawn pixels
+        ctx.drawElementImage(form, FORM_X, FORM_Y, form.offsetWidth, form.offsetHeight);
+      }
+    }
+
+    if (nativeHtmlInCanvas) {
+      canvas.onpaint = draw;
+    } else {
+      // Fallback: the same form, overlaid at the same CSS-pixel position (see .cup-stage > .cup-form)
+      stage.appendChild(form);
+      form.removeAttribute('drawable');
+    }
+
+    // Keep the backing store at device-pixel size so nothing is blurry on HiDPI screens
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+      canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+      if (nativeHtmlInCanvas) canvas.requestPaint();
+      else draw();
+    });
+    const supportsDevicePixelBox = typeof ResizeObserverEntry !== 'undefined' &&
+      'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+    observer.observe(canvas, supportsDevicePixelBox ? { box: 'device-pixel-content-box' } : {});
+  </script>
+
