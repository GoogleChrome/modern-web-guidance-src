+  <script>
+    // Fallback for browsers without sibling-index()/sibling-count()
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const groups = new Map();
+      document.querySelectorAll('.spectrum-card, .fan-card, .circle-orb').forEach(el => {
+        if (!groups.has(el.parentElement)) groups.set(el.parentElement, []);
+        groups.get(el.parentElement).push(el);
+      });
+      const apply = () => groups.forEach((_, parent) => {
+        const items = [...parent.children];
+        items.forEach((item, i) => {
+          item.style.setProperty('--sibling-index', i + 1);
+          item.style.setProperty('--sibling-count', items.length);
+        });
+      });
+      apply();
+      groups.forEach((_, parent) => new MutationObserver(apply).observe(parent, { childList: true }));
+    }
+  </script>
+
