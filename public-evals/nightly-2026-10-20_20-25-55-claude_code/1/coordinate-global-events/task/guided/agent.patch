+  <script type="module">
+    // Temporal is not yet available in every browser; load the polyfill when missing.
+    if (typeof Temporal === 'undefined') {
+      const { Temporal: T } = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = T;
+    }
+
+    const TARGETS = [
+      { label: 'New York', zone: 'America/New_York' },
+      { label: 'London', zone: 'Europe/London' },
+      { label: 'Tokyo', zone: 'Asia/Tokyo' },
+      { label: 'UTC', zone: 'UTC' },
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const hostWarning = document.getElementById('hostWarning');
+
+    const timeFormat = { hour: 'numeric', minute: '2-digit' };
+    const dayFormat = { weekday: 'short', month: 'short', day: 'numeric' };
+
+    // Returns { zdt, warning }. ZonedDateTime is immutable; every step yields a new object.
+    function resolveHost(date, time, zone) {
+      const input = `${date}T${time}[${zone}]`;
+      try {
+        return { zdt: Temporal.ZonedDateTime.from(input, { disambiguation: 'reject' }), warning: '' };
+      } catch (e) {
+        if (!(e instanceof RangeError)) throw e;
+      }
+      const resolved = Temporal.ZonedDateTime.from(input, { disambiguation: 'compatible' });
+      const fmt = (z) => z.toLocaleString('en-US', { ...timeFormat, timeZoneName: 'short' });
+      const wanted = time.slice(0, 5);
+      if (resolved.toPlainTime().toString({ smallestUnit: 'minute' }) !== wanted) {
+        const before = resolved.subtract({ hours: 1 }).toLocaleString('en-US', timeFormat);
+        return {
+          zdt: resolved,
+          warning: `${wanted} does not exist in ${zone} on this date: clocks skip forward at a daylight saving ` +
+            `transition (${before} jumps ahead). We moved the event later to ${fmt(resolved)}.`,
+        };
+      }
+      const later = Temporal.ZonedDateTime.from(input, { disambiguation: 'later' });
+      const earlier = Temporal.ZonedDateTime.from(input, { disambiguation: 'earlier' });
+      return {
+        zdt: resolved,
+        warning: `${wanted} happens twice in ${zone} on this date: clocks fall back at a daylight saving ` +
+          `transition. We used the first occurrence (${fmt(earlier)}); the second would be ${fmt(later)}.`,
+      };
+    }
+
+    function render() {
+      grid.replaceChildren();
+      hostWarning.hidden = true;
+      if (!dateInput.value || !timeInput.value) return;
+
+      const { zdt, warning } = resolveHost(dateInput.value, timeInput.value, hostTzSelect.value);
+      if (warning) {
+        hostWarning.textContent = warning;
+        hostWarning.hidden = false;
+      }
+
+      for (const { label, zone } of TARGETS) {
+        const local = zdt.withTimeZone(zone);
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.dataset.zone = zone;
+        const h = document.createElement('h3');
+        h.textContent = label;
+        const t = document.createElement('p');
+        t.className = 'time';
+        t.textContent = local.toLocaleString('en-US', timeFormat);
+        const d = document.createElement('p');
+        d.className = 'day';
+        d.textContent = local.toLocaleString('en-US', dayFormat);
+        card.append(h, t, d);
+        grid.append(card);
+      }
+    }
+
+    dateInput.value = Temporal.Now.plainDateISO().toString();
+    for (const el of [dateInput, timeInput, hostTzSelect]) {
+      el.addEventListener('input', render);
+      el.addEventListener('change', render);
+    }
+    render();
+  </script>
