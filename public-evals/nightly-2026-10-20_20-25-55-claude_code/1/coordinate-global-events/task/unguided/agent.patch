+  <script>
+    (() => {
+      const TARGETS = [
+        { tz: 'America/New_York', label: 'New York' },
+        { tz: 'Europe/London', label: 'London' },
+        { tz: 'Asia/Tokyo', label: 'Tokyo' },
+        { tz: 'UTC', label: 'UTC' }
+      ];
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const timeFmt = { hour: 'numeric', minute: '2-digit' };
+      const dayFmt = { weekday: 'short', month: 'short', day: 'numeric' };
+
+      // Resolve a wall-clock time in a zone, reporting DST gaps/overlaps.
+      // Temporal objects are immutable: every step below yields a new value.
+      function resolveHost(plain, tz) {
+        const earlier = plain.toZonedDateTime(tz, { disambiguation: 'earlier' });
+        const later = plain.toZonedDateTime(tz, { disambiguation: 'later' });
+        const resolved = plain.toZonedDateTime(tz, { disambiguation: 'compatible' });
+        if (earlier.epochNanoseconds === later.epochNanoseconds) {
+          return { zdt: resolved, warning: null };
+        }
+        const wall = (z) => z.toLocaleString('en-US', { ...timeFmt, timeZoneName: 'short' });
+        if (earlier.toPlainDateTime().equals(plain)) {
+          // Wall time occurs twice (clocks go back).
+          return {
+            zdt: resolved,
+            warning: `${plain.toLocaleString('en-US', timeFmt)} happens twice in ${tz} on this date because clocks go back. ` +
+              `It is ambiguous, so we used the first occurrence (${wall(earlier)}). ` +
+              `The second occurrence would be ${wall(later)}.`
+          };
+        }
+        // Wall time is skipped (clocks go forward).
+        return {
+          zdt: resolved,
+          warning: `${plain.toLocaleString('en-US', timeFmt)} does not exist in ${tz} on this date because clocks jump forward. ` +
+            `We moved it forward to the next valid time (${wall(resolved)}).`
+        };
+      }
+
+      function render() {
+        grid.replaceChildren();
+        hostWarning.hidden = true;
+        hostWarning.textContent = '';
+        if (!dateInput.value || !timeInput.value) return;
+
+        let host;
+        try {
+          const plain = Temporal.PlainDateTime.from(`${dateInput.value}T${timeInput.value}`);
+          host = resolveHost(plain, hostTzSelect.value);
+        } catch (e) {
+          hostWarning.textContent = 'Please enter a valid date and time.';
+          hostWarning.hidden = false;
+          return;
+        }
+
+        if (host.warning) {
+          hostWarning.textContent = host.warning;
+          hostWarning.hidden = false;
+        }
+
+        for (const { tz, label } of TARGETS) {
+          const local = host.zdt.withTimeZone(tz);
+          const card = document.createElement('div');
+          card.className = 'card' + (tz === hostTzSelect.value ? ' host' : '');
+          const h = document.createElement('h3');
+          h.textContent = label;
+          const t = document.createElement('div');
+          t.className = 'time';
+          t.textContent = local.toLocaleString('en-US', timeFmt);
+          const d = document.createElement('div');
+          d.className = 'meta';
+          d.textContent = `${local.toLocaleString('en-US', dayFmt)} · ${tz}`;
+          card.append(h, t, d);
+          grid.append(card);
+        }
+      }
+
+      if (typeof Temporal === 'undefined') {
+        hostWarning.textContent = 'Your browser does not support the Temporal API yet, so the planner is unavailable. Please update your browser.';
+        hostWarning.hidden = false;
+        return;
+      }
+
+      dateInput.value = Temporal.Now.plainDateISO().toString();
+      [dateInput, timeInput, hostTzSelect].forEach((el) => {
+        el.addEventListener('input', render);
+        el.addEventListener('change', render);
+      });
+      render();
+    })();
+  </script>
+
