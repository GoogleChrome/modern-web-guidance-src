+  <script>
+    // Mirror the visual :user-invalid state into aria-invalid for assistive tech
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const syncAriaInvalid = () => {
+      if (newsletterEmail.matches(':user-invalid')) {
+        newsletterEmail.setAttribute('aria-invalid', 'true');
+      } else {
+        newsletterEmail.removeAttribute('aria-invalid');
+      }
+    };
+    newsletterEmail.addEventListener('blur', syncAriaInvalid);
+    newsletterEmail.addEventListener('invalid', syncAriaInvalid);
+    newsletterEmail.addEventListener('input', () => {
+      if (newsletterEmail.hasAttribute('aria-invalid')) syncAriaInvalid();
+    });
+  </script>
+
 </body>
 
