+<script>
+    // Theme selector: "system" removes the override so the browser follows OS preference
+    var themeSelect = document.getElementById('theme-select');
+    var root = document.documentElement;
+    themeSelect.value = root.dataset.theme || 'system';
+    themeSelect.addEventListener('change', function () {
+      var value = themeSelect.value;
+      if (value === 'light' || value === 'dark') {
+        root.dataset.theme = value;
+      } else {
+        delete root.dataset.theme;
+      }
+      try {
+        if (value === 'system') localStorage.removeItem('theme');
+        else localStorage.setItem('theme', value);
+      } catch (e) { }
+    });
+
+    // Late night specials filter
+    var specialSelect = document.getElementById('special-select');
+    specialSelect.addEventListener('change', function () {
+      document.querySelectorAll('.special').forEach(function (el) {
+        el.hidden = specialSelect.value !== 'all' && el.dataset.type !== specialSelect.value;
+      });
+    });
+  </script>
+
