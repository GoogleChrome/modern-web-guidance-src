+  <script>
+    const root = document.documentElement;
+    const themeMeta = document.querySelector('meta[name="color-scheme"]');
+    const themeSelect = document.getElementById('theme-select');
+
+    function applyTheme(choice) {
+      if (choice === 'light' || choice === 'dark') {
+        root.dataset.theme = choice;
+        themeMeta.content = choice;
+      } else {
+        delete root.dataset.theme;
+        themeMeta.content = 'light dark';
+      }
+    }
+
+    function savedTheme() {
+      try { return localStorage.getItem('theme') || 'system'; } catch (e) { return 'system'; }
+    }
+
+    themeSelect.value = savedTheme();
+
+    themeSelect.addEventListener('change', () => {
+      const choice = themeSelect.value;
+      applyTheme(choice);
+      try {
+        if (choice === 'system') localStorage.removeItem('theme');
+        else localStorage.setItem('theme', choice);
+      } catch (e) { }
+    });
+
+    // Keep multiple tabs in sync
+    window.addEventListener('storage', (e) => {
+      if (e.key !== 'theme') return;
+      const choice = savedTheme();
+      themeSelect.value = choice;
+      applyTheme(choice);
+    });
+
+    // Late night specials filter
+    document.getElementById('special-filter').addEventListener('change', (e) => {
+      for (const item of document.querySelectorAll('.special')) {
+        item.hidden = e.target.value !== 'all' && item.dataset.kind !== e.target.value;
+      }
+    });
+  </script>
+
