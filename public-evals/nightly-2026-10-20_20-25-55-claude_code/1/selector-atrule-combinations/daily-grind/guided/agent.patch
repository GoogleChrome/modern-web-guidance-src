@@ -12,6 +12,34 @@
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      --surface: white;
+      --heading: var(--primary);
+
+      /* One combined "is it dark?" flag: OS preference, overridable with .light/.dark on <html> */
+      --color-scheme: light;
+
+      @media (prefers-color-scheme: dark) {
+        --color-scheme: dark;
+      }
+
+      &.light {
+        --color-scheme: light;
+      }
+
+      &.dark {
+        --color-scheme: dark;
+      }
+    }
+
+    /* Dark palette, written once. Light is the default, so browsers without style queries stay light. */
+    @container style(--color-scheme: dark) {
+      body {
+        --secondary: #3e2b27;
+        --text: #efebe9;
+        --light: #1b1210;
+        --surface: #2b1f1c;
+        --heading: var(--accent);
+      }
     }
 
