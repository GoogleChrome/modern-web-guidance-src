     }
+
+    /* Scrollytelling: CSS-only, scroll-driven animations.
+       Each text section in #tracked defines a named view timeline; the
+       shared .story ancestor hoists them (timeline-scope) so the matching
+       sections in #animated, a different DOM branch, can consume them. */
+    .story {
+      margin-top: 60px;
+    }
+
+    .story > h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .story-body {
+      display: grid;
+      grid-template-columns: 1fr 1fr;
+      gap: 40px;
+      timeline-scope: --step-1, --step-2, --step-3;
+    }
+
+    #tracked {
+      grid-column: 1;
+      grid-row: 1;
+    }
+
+    #tracked section {
+      min-height: 80vh;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+    }
+
+    #tracked h3 {
+      color: var(--primary);
+      font-size: 1.6rem;
+      margin-bottom: 10px;
+    }
+
+    #animated {
+      grid-column: 2;
+      grid-row: 1;
+      position: sticky;
+      top: 90px;
+      height: min(70vh, 520px);
+      align-self: start;
+      display: grid;
+    }
+
+    #animated section {
+      grid-area: 1 / 1;
+      position: relative;
+      overflow: hidden;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      background: var(--primary);
+    }
+
+    #animated img {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      display: block;
+    }
+
+    #animated figcaption {
+      position: absolute;
+      left: 0;
+      right: 0;
+      bottom: 0;
+      padding: 40px 20px 16px;
+      color: white;
+      font-weight: bold;
+      background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
+    }
+
+    @media (max-width: 700px) {
+      .story-body {
+        grid-template-columns: 1fr;
+        gap: 0;
+      }
+
+      #tracked,
+      #animated {
+        grid-column: 1;
+      }
+
+      #animated {
+        grid-row: 1;
+        height: 35vh;
+        top: 70px;
+        z-index: 1;
+      }
+
+      #tracked {
+        grid-row: 2;
+      }
+
+      #tracked section {
+        min-height: 60vh;
+      }
+    }
+
+    /* Only hide/animate where scroll-driven animations exist and motion is
+       welcome; elsewhere all panels simply show (stacked in the flow). */
+    @media not all and (prefers-reduced-motion: reduce) {
+      @supports (animation-timeline: view()) {
+        @keyframes reveal {
+          from {
+            opacity: 0;
+            transform: translateY(40px) scale(0.96);
+          }
+
+          to {
+            opacity: 1;
+            transform: none;
+          }
+        }
+
+        #tracked section:nth-child(1) { view-timeline: --step-1 block; }
+        #tracked section:nth-child(2) { view-timeline: --step-2 block; }
+        #tracked section:nth-child(3) { view-timeline: --step-3 block; }
+
+        #animated section {
+          opacity: 0;
+          will-change: opacity, transform;
+          animation: reveal linear both;
+          animation-range: entry 30% entry 100%;
+        }
+
+        #animated section:nth-child(1) { animation-timeline: --step-1; }
+        #animated section:nth-child(2) { animation-timeline: --step-2; }
+        #animated section:nth-child(3) { animation-timeline: --step-3; }
+      }
+    }
+
+    /* No scroll-driven animation support or reduced motion: plain stacked layout */
+    @media (prefers-reduced-motion: reduce) {
+      #animated { position: static; height: auto; gap: 20px; }
+      #animated section { grid-area: auto; height: 260px; }
+    }
+
+    @supports not (animation-timeline: view()) {
+      #animated { position: static; height: auto; gap: 20px; }
+      #animated section { grid-area: auto; height: 260px; }
+    }
   </style>
