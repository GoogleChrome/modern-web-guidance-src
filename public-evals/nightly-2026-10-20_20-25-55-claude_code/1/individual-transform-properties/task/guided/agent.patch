+      text-transform: uppercase;
+      line-height: 1.2;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
+
+      /* Identity values for every individual transform property so the
+         stacking context is the same before and during hover. */
+      translate: 0px 0px;
+      rotate: 0deg;
+      scale: 1;
+
+      /* Separate properties let both animations and the hover transition
+         run together without overriding each other. */
+      animation: badge-spin 6s linear infinite, badge-slide 4s ease-in-out infinite alternate;
+      transition: scale 0.3s ease;
+    }
+
+    .target:hover {
+      scale: 1.2;
+    }
+
+    @keyframes badge-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes badge-slide {
+      from { translate: 0px 0px; }
+      to { translate: -120px 0px; }
+    }
