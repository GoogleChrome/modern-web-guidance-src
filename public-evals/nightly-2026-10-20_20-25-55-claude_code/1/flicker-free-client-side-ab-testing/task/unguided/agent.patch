diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,135 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Launchpad – Ship your ideas faster</title>
+  <meta name="description" content="Launchpad helps teams go from idea to launch in days, not months.">
+
+  <!--
+    Anti-flicker: hide the page until the experiment SDK has applied its variant.
+    This must come before any rendered content. The class is removed when the SDK
+    loads (or fails to load), and a hard timeout guarantees the page is never left blank.
+  -->
+  <style>
+    .exp-pending body { opacity: 0 !important; }
+    body { transition: opacity .15s ease; }
+  </style>
+  <script>
+    (function () {
+      var TIMEOUT_MS = 2000;
+      var root = document.documentElement;
+      root.classList.add('exp-pending');
+
+      var done = false;
+      function reveal() {
+        if (done) return;
+        done = true;
+        root.classList.remove('exp-pending');
+      }
+      // Exposed so the SDK (or a callback configured in it) can reveal earlier/later explicitly.
+      window.__revealExperiment = reveal;
+      setTimeout(reveal, TIMEOUT_MS);
+
+      var s = document.createElement('script');
+      s.src = 'https://cdn.example.com/experiment-sdk.js';
+      s.async = true;
+      // After the SDK runs, wait for the DOM to be parsed so it can have patched it, then paint.
+      s.onload = function () {
+        function afterDom() { requestAnimationFrame(function () { requestAnimationFrame(reveal); }); }
+        if (document.readyState === 'loading') {
+          document.addEventListener('DOMContentLoaded', afterDom);
+        } else {
+          afterDom();
+        }
+      };
+      s.onerror = reveal; // SDK blocked/unreachable: show the original content
+      document.head.appendChild(s);
+    })();
+  </script>
+
+  <style>
+    :root {
+      --bg: #0b1020;
+      --fg: #f5f7ff;
+      --muted: #b4bcd6;
+      --accent: #6c8cff;
+      --accent-hover: #8aa3ff;
+    }
+    * { box-sizing: border-box; }
+    body {
+      margin: 0;
+      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+      color: var(--fg);
+      background: var(--bg);
+      line-height: 1.5;
+    }
+    header {
+      position: absolute;
+      inset: 0 0 auto 0;
+      z-index: 2;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding: 1.25rem 2rem;
+    }
+    .logo { font-weight: 700; font-size: 1.25rem; letter-spacing: .02em; }
+    .hero {
+      position: relative;
+      min-height: 100vh;
+      display: grid;
+      place-items: center;
+      text-align: center;
+      padding: 6rem 1.5rem 4rem;
+      background:
+        linear-gradient(rgba(11,16,32,.65), rgba(11,16,32,.85)),
+        url("https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1920&q=70")
+        center / cover no-repeat;
+    }
+    .hero-inner { max-width: 44rem; }
+    .hero h1 {
+      margin: 0 0 1rem;
+      font-size: clamp(2.25rem, 6vw, 4rem);
+      line-height: 1.1;
+    }
+    .hero p {
+      margin: 0 0 2rem;
+      font-size: clamp(1.05rem, 2.2vw, 1.35rem);
+      color: var(--muted);
+    }
+    .cta {
+      display: inline-block;
+      padding: .9rem 2rem;
+      font-size: 1.1rem;
+      font-weight: 600;
+      color: #fff;
+      background: var(--accent);
+      border-radius: .6rem;
+      text-decoration: none;
+      transition: background .15s ease, transform .15s ease;
+    }
+    .cta:hover, .cta:focus-visible { background: var(--accent-hover); transform: translateY(-1px); }
+    .cta:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
+    footer { padding: 1.5rem; text-align: center; color: var(--muted); font-size: .9rem; }
+  </style>
+</head>
+<body>
+  <header>
+    <span class="logo">Launchpad</span>
+  </header>
+
+  <main>
+    <section class="hero" id="hero">
+      <div class="hero-inner">
+        <h1 id="hero-headline" data-experiment="headline">Ship your ideas faster</h1>
+        <p id="hero-subtext" data-experiment="subtext">
+          Launchpad takes your team from idea to launch in days, not months.
+        </p>
+        <a class="cta" id="cta-button" data-experiment="cta" href="#signup">Get started free</a>
+      </div>
+    </section>
+  </main>
+
+  <footer>&copy; 2026 Launchpad. All rights reserved.</footer>
+</body>
+</html>
