+  <script type="module">
+    const CALENDARS = [
+      { id: 'islamic-umalqura', label: 'Islamic (Umm al-Qura)', dateId: 'islamic-date', eraStyle: 'short' },
+      { id: 'hebrew', label: 'Hebrew', eraStyle: 'short' },
+      { id: 'japanese', label: 'Japanese', eraStyle: 'long' },
+    ];
+
+    const input = document.getElementById('calendar-date');
+    const cards = document.getElementById('calendar-cards');
+    const status = document.getElementById('calendar-status');
+
+    // Progressive enhancement: use native Temporal when present, otherwise load a polyfill.
+    async function ensureTemporal() {
+      if (typeof globalThis.Temporal?.PlainDate === 'function') return true;
+      try {
+        await import('https://cdn.jsdelivr.net/npm/temporal-polyfill@0.3.0/global.esm.js');
+      } catch {
+        return false;
+      }
+      return typeof globalThis.Temporal?.PlainDate === 'function';
+    }
+
+    // Feature-detect calendar support rather than assuming it.
+    function supportsCalendar(id) {
+      if (typeof Intl.supportedValuesOf === 'function') {
+        try {
+          if (Intl.supportedValuesOf('calendar').includes(id)) return true;
+        } catch { /* fall through to probing */ }
+      }
+      try {
+        return new Intl.DateTimeFormat('en', { calendar: id }).resolvedOptions().calendar === id;
+      } catch {
+        return false;
+      }
+    }
+
+    function localeFor(calendar) {
+      const requested = navigator.language || 'en';
+      try {
+        return new Intl.Locale(requested, { calendar }).toString();
+      } catch {
+        return new Intl.Locale('en', { calendar }).toString();
+      }
+    }
+
+    function el(tag, text, className) {
+      const node = document.createElement(tag);
+      if (text !== undefined) node.textContent = text;
+      if (className) node.className = className;
+      return node;
+    }
+
+    function timelineLabel(isoDate) {
+      const cmp = Temporal.PlainDate.compare(isoDate, Temporal.Now.plainDateISO());
+      return cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+    }
+
+    // Month lengths come from the calendar itself, never from hardcoded tables.
+    function monthBreakdown(date) {
+      const months = [];
+      for (let m = 1; m <= date.monthsInYear; m++) {
+        const first = date.with({ month: m, day: 1 }, { overflow: 'reject' });
+        months.push({ code: first.monthCode, days: first.daysInMonth });
+      }
+      return months;
+    }
+
+    function buildCard(cal, isoDate) {
+      const date = isoDate.withCalendar(cal.id);
+      const locale = localeFor(cal.id);
+      const formatted = date.toLocaleString(locale, {
+        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', era: cal.eraStyle,
+      });
+
+      const card = el('article', undefined, 'card calendar-card');
+      card.append(el('h3', cal.label));
+      const dateEl = el('p', formatted, 'cal-date');
+      if (cal.dateId) dateEl.id = cal.dateId;
+      card.append(dateEl);
+
+      // Calendars with eras (Japanese) expose the era year; others use the plain year.
+      const year = date.era !== undefined && date.eraYear !== undefined
+        ? `${date.eraYear} (${date.era})`
+        : String(date.year);
+
+      const facts = el('dl');
+      const addFact = (term, value, className) => {
+        facts.append(el('dt', term), el('dd', value, className));
+      };
+      addFact('Year', year);
+      addFact('Month', String(date.month));
+      addFact('Month code', date.monthCode);
+      addFact('Months in year', String(date.monthsInYear));
+      addFact('Timeline', timelineLabel(isoDate), 'timeline');
+      card.append(facts);
+
+      card.append(el('h4', 'Months in this year'));
+      const list = el('ul', undefined, 'month-list');
+      for (const { code, days } of monthBreakdown(date)) {
+        const item = el('li');
+        item.append(el('span', code), el('span', `${days} days`));
+        list.append(item);
+      }
+      card.append(list);
+      return card;
+    }
+
+    function render() {
+      cards.replaceChildren();
+      status.textContent = '';
+      if (!input.value) {
+        status.textContent = 'Select a date to see it in other calendars.';
+        return;
+      }
+      let isoDate;
+      try {
+        isoDate = Temporal.PlainDate.from(input.value, { overflow: 'reject' });
+      } catch {
+        status.textContent = 'That date is not valid.';
+        return;
+      }
+      const unsupported = [];
+      for (const cal of CALENDARS) {
+        if (!supportsCalendar(cal.id)) {
+          unsupported.push(cal.label);
+          continue;
+        }
+        try {
+          cards.append(buildCard(cal, isoDate));
+        } catch {
+          unsupported.push(cal.label);
+        }
+      }
+      if (unsupported.length) {
+        status.textContent = `Not available in this browser or for this date: ${unsupported.join(', ')}.`;
+      }
+    }
+
+    if (await ensureTemporal()) {
+      input.value = Temporal.Now.plainDateISO().toString();
+      input.addEventListener('input', render);
+      render();
+    } else {
+      input.disabled = true;
+      status.textContent = 'Calendar conversion is unavailable because the date library could not be loaded.';
+    }
+  </script>
 </body>
 
