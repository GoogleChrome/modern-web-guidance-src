     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const CALENDARS = [
+      { id: 'islamic-umalqura', label: 'Islamic (Umm al-Qura)', elementId: 'islamic-date' },
+      { id: 'hebrew', label: 'Hebrew' },
+      { id: 'japanese', label: 'Japanese' },
+    ];
+
+    const input = document.getElementById('calendar-date');
+    const status = document.getElementById('calendar-status');
+    const cards = document.getElementById('calendar-cards');
+
+    // Use native Temporal when available, otherwise load a polyfill on demand.
+    async function getTemporal() {
+      if (typeof Temporal !== 'undefined') return Temporal;
+      const module = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = module.Temporal;
+      return module.Temporal;
+    }
+
+    function isCalendarSupported(id) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(id);
+      } catch {
+        return false;
+      }
+    }
+
+    function el(tag, text, className) {
+      const node = document.createElement(tag);
+      if (text !== undefined) node.textContent = text;
+      if (className) node.className = className;
+      return node;
+    }
+
+    function buildCard(Temporal, cal, isoDate, todayIso) {
+      const card = el('article', undefined, 'card calendar-card');
+      card.append(el('h3', cal.label));
+
+      if (!isCalendarSupported(cal.id)) {
+        card.append(el('p', 'This calendar is not supported by your browser.'));
+        return card;
+      }
+
+      const date = isoDate.withCalendar(cal.id);
+      const today = todayIso.withCalendar(cal.id);
+      const locale = `en-u-ca-${cal.id}`;
+      const formatOptions = { day: 'numeric', month: 'long', year: 'numeric' };
+      if (cal.id === 'japanese') formatOptions.era = 'long';
+
+      const main = el('p', date.toLocaleString(locale, formatOptions), 'date-main');
+      if (cal.elementId) main.id = cal.elementId;
+      card.append(main);
+
+      const cmp = Temporal.PlainDate.compare(date, today);
+      const timeline = cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+
+      const details = el('dl');
+      const rows = [
+        ['Year', date.era ? `${date.year} (${date.era})` : String(date.year)],
+        ['Month', String(date.month)],
+        ['Month code', date.monthCode],
+        ['Months in year', String(date.monthsInYear)],
+      ];
+      for (const [term, value] of rows) {
+        details.append(el('dt', term), el('dd', value));
+      }
+      const timelineItem = el('dd');
+      timelineItem.append(el('span', timeline, 'timeline'));
+      details.append(el('dt', 'Timeline'), timelineItem);
+      card.append(details);
+
+      card.append(el('h4', 'Months this year'));
+      const list = el('ul', undefined, 'month-list');
+      for (let m = 1; m <= date.monthsInYear; m++) {
+        const month = date.with({ month: m, day: 1 });
+        const item = el('li', `${month.monthCode}: ${month.daysInMonth} days`);
+        if (m === date.month) item.className = 'current';
+        list.append(item);
+      }
+      card.append(list);
+      return card;
+    }
+
+    function render(Temporal) {
+      let isoDate;
+      try {
+        isoDate = Temporal.PlainDate.from(input.value);
+      } catch {
+        cards.replaceChildren();
+        status.textContent = 'Please choose a valid date.';
+        return;
+      }
+      status.textContent = '';
+      const todayIso = Temporal.Now.plainDateISO();
+      cards.replaceChildren(...CALENDARS.map((cal) => buildCard(Temporal, cal, isoDate, todayIso)));
+    }
+
+    try {
+      status.textContent = 'Loading…';
+      const Temporal = await getTemporal();
+      status.textContent = '';
+      input.value = Temporal.Now.plainDateISO().toString();
+      input.addEventListener('input', () => render(Temporal));
+      render(Temporal);
+    } catch (e) {
+      console.error('Temporal unavailable:', e);
+      input.disabled = true;
+      status.textContent = 'Calendar conversion is unavailable in this browser.';
+    }
+  </script>
+
 </body>
 
