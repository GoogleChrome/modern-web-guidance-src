+  <script>
+    (() => {
+      const canvas = document.getElementById('gift_canvas');
+      const stage = document.getElementById('card_stage');
+      const card = document.getElementById('export_element');
+      const nameIn = document.getElementById('gc_name');
+      const messageIn = document.getElementById('gc_message');
+      const colorIn = document.getElementById('gc_color');
+      const nameOut = document.getElementById('gc_to_out');
+      const messageOut = document.getElementById('gc_message_out');
+      const exportBtn = document.getElementById('export_btn');
+      const status = document.getElementById('export_status');
+
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+      // --- Card content (textContent only: user input is never parsed as HTML) ---
+      function updateCard() {
+        nameOut.textContent = nameIn.value.trim() || 'a coffee lover';
+        messageOut.textContent = messageIn.value.trim();
+        const hex = colorIn.value;
+        const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
+        const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
+        card.style.setProperty('--card-bg', hex);
+        card.style.setProperty('--card-fg', luminance > 0.6 ? '#2b1b17' : '#ffffff');
+      }
+      [nameIn, messageIn, colorIn].forEach((el) => el.addEventListener('input', updateCard));
+      updateCard();
+
+      // --- Rendering ---
+      let ctx = null;
+
+      if (supportsHtmlInCanvas) {
+        ctx = canvas.getContext('2d');
+
+        // The browser fires `paint` whenever a drawable child's rendering changes.
+        canvas.onpaint = () => {
+          ctx.reset();
+          ctx.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+        };
+
+        // Match the canvas grid to device pixels so the card stays sharp.
+        const observer = new ResizeObserver(([entry]) => {
+          const dpc = entry.devicePixelContentBoxSize;
+          canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * window.devicePixelRatio);
+          canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * window.devicePixelRatio);
+          canvas.requestPaint();
+        });
+        const supportsDevicePixelContentBox =
+          typeof ResizeObserverEntry !== 'undefined' &&
+          'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+        observer.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+      } else {
+        // Fallback: show the card as regular DOM and rasterize it with html2canvas on export.
+        stage.append(card);
+        canvas.hidden = true;
+      }
+
+      // Resolves after the next paint event, so the canvas holds the latest card state.
+      function nextPaint() {
+        return new Promise((resolve) => {
+          canvas.addEventListener('paint', resolve, { once: true });
+          canvas.requestPaint();
+        });
+      }
+
+      let html2canvasPromise = null;
+      function loadHtml2Canvas() {
+        html2canvasPromise ??= new Promise((resolve, reject) => {
+          if (window.html2canvas) return resolve(window.html2canvas);
+          const script = document.createElement('script');
+          script.src = 'https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js';
+          script.crossOrigin = 'anonymous';
+          script.onload = () => resolve(window.html2canvas);
+          script.onerror = () => reject(new Error('Could not load the fallback renderer.'));
+          document.head.append(script);
+        });
+        return html2canvasPromise;
+      }
+
+      async function getExportCanvas() {
+        if (supportsHtmlInCanvas) {
+          await nextPaint();
+          return canvas;
+        }
+        const html2canvas = await loadHtml2Canvas();
+        return html2canvas(card, { backgroundColor: null, scale: window.devicePixelRatio });
+      }
+
+      exportBtn.addEventListener('click', async () => {
+        exportBtn.disabled = true;
+        status.textContent = 'Preparing your card…';
+        try {
+          const source = await getExportCanvas();
+          const blob = await new Promise((resolve) => source.toBlob(resolve, 'image/png'));
+          if (!blob) throw new Error('Image export failed.');
+
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.href = url;
+          link.download = 'daily-grind-gift-card.png';
+          link.click();
+          setTimeout(() => URL.revokeObjectURL(url), 1000);
+          status.textContent = 'Card downloaded!';
+        } catch (err) {
+          status.textContent = err.message || 'Something went wrong exporting the card.';
+        } finally {
+          exportBtn.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
