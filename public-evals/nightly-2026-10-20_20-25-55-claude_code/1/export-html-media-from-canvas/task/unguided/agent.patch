+  <script>
+    (() => {
+      const canvas = document.getElementById('gift_canvas');
+      const card = document.getElementById('export_element');
+      const nameIn = document.getElementById('gc_name');
+      const msgIn = document.getElementById('gc_message');
+      const colorIn = document.getElementById('gc_color');
+      const nameOut = document.getElementById('gc_name_out');
+      const msgOut = document.getElementById('gc_message_out');
+      const exportBtn = document.getElementById('gc_export');
+      const status = document.getElementById('gc_status');
+      const preview = document.getElementById('gc_preview');
+
+      // HTML-in-canvas (WICG): layoutsubtree attribute, paint event, drawElementImage().
+      // Currently behind a flag in Chromium (chrome://flags/#canvas-draw-element).
+      const supportsHtmlInCanvas =
+        'layoutSubtree' in HTMLCanvasElement.prototype &&
+        'onpaint' in canvas &&
+        typeof CanvasRenderingContext2D !== 'undefined' &&
+        'drawElementImage' in CanvasRenderingContext2D.prototype;
+
+      const ctx = canvas.getContext('2d');
+      const CARD_W = 600, CARD_H = 340;
+
+      const contrastColor = (hex) => {
+        const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
+        return (0.299 * r + 0.587 * g + 0.114 * b) > 160 ? '#2b1b17' : '#ffffff';
+      };
+
+      const syncCard = () => {
+        const bg = colorIn.value;
+        card.style.setProperty('--card-bg', bg);
+        card.style.setProperty('--card-fg', contrastColor(bg));
+        msgOut.textContent = msgIn.value.trim() || 'Enjoy a cup on us!';
+        nameOut.textContent = nameIn.value.trim() ? `For ${nameIn.value.trim()}` : '';
+      };
+
+      // ---------- Supported path: draw the live DOM element into the canvas ----------
+      const paintOnce = () => new Promise((resolve) => {
+        canvas.addEventListener('paint', resolve, { once: true });
+        canvas.requestPaint();
+      });
+
+      const resizeBackingStore = () => {
+        const dpr = window.devicePixelRatio || 1;
+        const rect = canvas.getBoundingClientRect();
+        const w = Math.max(1, Math.round(rect.width * dpr));
+        const h = Math.max(1, Math.round(rect.height * dpr));
+        if (canvas.width !== w || canvas.height !== h) {
+          canvas.width = w;
+          canvas.height = h;
+        }
+      };
+
+      const drawCard = () => {
+        const dpr = canvas.width / canvas.getBoundingClientRect().width;
+        ctx.reset();
+        ctx.scale(dpr, dpr);
+        // Throws if the element isn't a laid-out child of the canvas.
+        ctx.drawElementImage(card, 0, 0);
+      };
+
+      // ---------- Fallback path: draw an equivalent design with the 2D API ----------
+      const wrapText = (c, text, maxWidth) => {
+        const lines = [];
+        text.split('\n').forEach((para) => {
+          let line = '';
+          para.split(/\s+/).forEach((word) => {
+            const test = line ? `${line} ${word}` : word;
+            if (line && c.measureText(test).width > maxWidth) {
+              lines.push(line);
+              line = word;
+            } else {
+              line = test;
+            }
+          });
+          lines.push(line);
+        });
+        return lines;
+      };
+
+      const renderFallbackCanvas = () => {
+        const scale = 2;
+        const out = document.createElement('canvas');
+        out.width = CARD_W * scale;
+        out.height = CARD_H * scale;
+        const c = out.getContext('2d');
+        c.scale(scale, scale);
+        const fg = contrastColor(colorIn.value);
+        const pad = 48;
+
+        c.fillStyle = colorIn.value;
+        c.beginPath();
+        c.roundRect(0, 0, CARD_W, CARD_H, 16);
+        c.fill();
+        c.strokeStyle = fg;
+        c.lineWidth = 1.5;
+        c.strokeRect(8, 8, CARD_W - 16, CARD_H - 16);
+
+        c.fillStyle = fg;
+        c.textBaseline = 'top';
+        c.font = '13px "Segoe UI", Tahoma, sans-serif';
+        c.letterSpacing = '3px';
+        c.fillText('THE DAILY GRIND', pad, 36);
+        c.letterSpacing = '0px';
+        c.font = 'italic 30px Georgia, serif';
+        c.fillText('Coffee Gift Card', pad, 58);
+
+        c.font = '18px Georgia, serif';
+        wrapText(c, msgOut.textContent, CARD_W - pad * 2)
+          .slice(0, 5)
+          .forEach((line, i) => c.fillText(line, pad, 125 + i * 26));
+
+        c.font = 'bold 21px Georgia, serif';
+        c.textAlign = 'right';
+        c.fillText(nameOut.textContent, CARD_W - pad, CARD_H - 56);
+        return out;
+      };
+
+      // ---------- Export ----------
+      const download = (blob) => {
+        const url = URL.createObjectURL(blob);
+        const a = document.createElement('a');
+        a.href = url;
+        a.download = 'daily-grind-gift-card.png';
+        document.body.appendChild(a);
+        a.click();
+        a.remove();
+        setTimeout(() => URL.revokeObjectURL(url), 1000);
+      };
+
+      exportBtn.addEventListener('click', async () => {
+        try {
+          let source = canvas;
+          if (supportsHtmlInCanvas) {
+            syncCard();
+            resizeBackingStore();
+            await paintOnce(); // wait for the paint event so the canvas reflects the latest DOM
+          } else {
+            source = renderFallbackCanvas();
+          }
+          source.toBlob((blob) => {
+            if (!blob) {
+              status.textContent = 'Sorry, the image could not be created.';
+              return;
+            }
+            download(blob);
+            status.textContent = 'Your gift card image has been downloaded.';
+          }, 'image/png');
+        } catch (err) {
+          console.error(err);
+          status.textContent = 'Sorry, the image could not be created.';
+        }
+      });
+
+      // ---------- Wiring ----------
+      if (supportsHtmlInCanvas) {
+        canvas.addEventListener('paint', drawCard);
+        new ResizeObserver(() => {
+          resizeBackingStore();
+          canvas.requestPaint();
+        }).observe(canvas);
+        const update = () => { syncCard(); canvas.requestPaint(); };
+        [nameIn, msgIn, colorIn].forEach((el) => el.addEventListener('input', update));
+        syncCard();
+        resizeBackingStore();
+        canvas.requestPaint();
+      } else {
+        // Show the card as plain HTML; export uses the 2D-canvas fallback renderer.
+        preview.classList.add('designer-fallback');
+        preview.appendChild(card);
+        card.style.aspectRatio = `${CARD_W} / ${CARD_H}`;
+        card.style.height = 'auto';
+        card.style.boxShadow = '0 4px 14px rgba(0, 0, 0, 0.25)';
+        const update = () => syncCard();
+        [nameIn, msgIn, colorIn].forEach((el) => el.addEventListener('input', update));
+        syncCard();
+        const note = document.createElement('p');
+        note.className = 'designer-note';
+        note.textContent = 'Your browser doesn’t support HTML-in-canvas yet, so the download is a close re-creation of this card.';
+        document.querySelector('.designer-controls').appendChild(note);
+      }
+    })();
+  </script>
+
 </body>
 
