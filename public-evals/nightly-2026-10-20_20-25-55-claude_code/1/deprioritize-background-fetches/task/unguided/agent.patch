diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,28 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Button</title>
+</head>
+<body>
+<button id="btn">Click me</button>
+<script>
+document.getElementById('btn').addEventListener('click', () => {
+  // Mission-critical: high priority so it isn't delayed by other requests.
+  const data = fetch('/api/data', { priority: 'high' }).then(r => r.json());
+
+  // Analytics: low priority and keepalive so it never competes with the data request.
+  fetch('/api/analytics', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ click: 1 }),
+    priority: 'low',
+    keepalive: true
+  }).catch(() => {});
+
+  data.then(console.log, console.error);
+});
+</script>
+</body>
+</html>
