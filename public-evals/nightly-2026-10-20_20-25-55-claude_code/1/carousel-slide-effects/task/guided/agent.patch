+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
     .footer-links a {
       margin: 0 10px;
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Product carousel */
+    .scroller {
+      --card-width: min(280px, 70vw);
+      display: flex;
+      gap: 1.5rem;
+      list-style: none;
+      overflow-x: auto;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      /* Lets the first and last cards reach the center */
+      padding: 2rem calc(50% - var(--card-width) / 2);
+      scroll-padding-inline: calc(50% - var(--card-width) / 2);
+    }
+
+    .scroller:focus-visible,
+    .product-card a:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 4px;
+    }
+
+    .product-card {
+      flex: 0 0 var(--card-width);
+      scroll-snap-align: center;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
+      overflow: hidden;
+      text-align: center;
+    }
+
+    .product-card img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .product-card .body {
+      padding: 16px 20px 20px;
+    }
+
+    .product-card h3 {
+      color: var(--primary);
+    }
+
+    .product-card .price {
+      font-weight: bold;
+    }
+
+    /* Scroll-driven scaling is a progressive enhancement: unsupported browsers show unscaled cards */
+    @keyframes scale-from-center {
+      0%, 100% {
+        scale: 0.8;
+        opacity: 0.6;
+      }
+
+      50% {
+        scale: 1.05;
+        opacity: 1;
+      }
+    }
+
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      @media (prefers-reduced-motion: no-preference) {
+        .product-card {
+          animation: scale-from-center auto linear both;
+          animation-timeline: view(inline);
+        }
+      }
+    }
   </style>
