@@ -134,8 +134,94 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
+    /* Product Carousel */
+    .scroller {
+      --card-width: min(260px, 70vw);
+      display: flex;
+      gap: 24px;
+      list-style: none;
+      overflow-x: auto;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      /* Padding lets the first and last cards reach the center */
+      padding: 40px calc(50% - var(--card-width) / 2);
+      scroll-padding-inline: calc(50% - var(--card-width) / 2);
+    }
+
+    .scroller:focus-visible,
+    .scroller a:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    .scroller > li {
+      flex: 0 0 var(--card-width);
+      scroll-snap-align: center;
+    }
+
+    .scroller .card {
+      height: 100%;
+      overflow: hidden;
+      padding: 0 0 20px;
+    }
+
+    .scroller .card img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+      margin-bottom: 15px;
+    }
+
+    .scroller .card h3,
+    .scroller .card p,
+    .scroller .card .price {
+      padding: 0 16px;
+    }
+
+    .price {
+      font-weight: bold;
+      margin-top: 8px;
+    }
+
+    /* Scale cards by their position within the scroller (no JS) */
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .scroller > li .card {
+          animation: grow-at-center linear both;
+          animation-timeline: view(inline);
+        }
+
+        @keyframes grow-at-center {
+          0% {
+            transform: scale(0.8);
+            opacity: 0.6;
+          }
+
+          50% {
+            transform: scale(1.1);
+            opacity: 1;
+          }
+
+          100% {
+            transform: scale(0.8);
+            opacity: 0.6;
+          }
+        }
+      }
+    }
+
     footer {
