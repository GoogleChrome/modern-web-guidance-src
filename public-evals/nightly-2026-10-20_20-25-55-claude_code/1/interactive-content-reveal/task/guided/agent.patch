     }
 
+    @property --inner-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      position: relative;
+      padding-bottom: 56px;
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      /* Only the spotlight size transitions; the position follows the pointer directly */
+      transition: --inner-size 0.2s ease-in-out, --outer-size 0.2s ease-in-out;
+    }
+
+    .product-card:hover {
+      --inner-size: 100px;
+      --outer-size: 140px;
+    }
+
+    .spotlight {
+      position: absolute;
+      inset: 0;
+      display: flex;
+      align-items: flex-end;
+      justify-content: center;
+      padding: 16px;
+      border-radius: inherit;
+      background: rgba(255, 171, 64, 0.35);
+      color: var(--primary);
+      font-size: 0.85rem;
+      font-weight: bold;
+      pointer-events: none;
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), black var(--inner-size, 0%), transparent var(--outer-size, 0%));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), black var(--inner-size, 0%), transparent var(--outer-size, 0%));
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
