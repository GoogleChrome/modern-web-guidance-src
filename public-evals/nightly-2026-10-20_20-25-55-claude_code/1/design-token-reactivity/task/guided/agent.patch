+    /* Layout density toggle */
+    :root {
+      --style-queries-supported: check;
+    }
+
+    .density-toggle {
+      display: none;
+      margin: 10px auto 0;
+      background: var(--primary);
+      color: white;
+      border: 0;
+      padding: 8px 16px;
+      border-radius: 5px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .density-toggle[aria-pressed="true"] {
+      background: #3e2723;
+    }
+
+    /* Only reveal the toggle where container style queries are supported */
+    @container style(--style-queries-supported) {
+      .density-toggle {
+        display: block;
+      }
+    }
+
+    #target-container {
+      --layout-density: comfortable;
+    }
+
+    #target-item {
+      --item-padding-comfortable: 20px;
+      --item-padding-spacious: 40px 32px;
+      padding: var(--item-padding-comfortable);
+      transition: padding 0.3s;
+    }
+
+    @container style(--layout-density: spacious) {
+      #target-item {
+        padding: var(--item-padding-spacious);
+      }
+    }
+
