@@ -11,8 +11,10 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      /* Marker used to feature-check CSS style queries (see #toggle-spacious) */
+      --style-query-check: supported;
     }
 
     * {
       box-sizing: border-box;
@@ -119,8 +121,43 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Layout density toggle: hidden unless the browser supports style queries */
+    #toggle-spacious {
+      display: none;
+      margin: 10px auto 0;
+      padding: 8px 16px;
+      border: 1px solid var(--primary);
+      border-radius: 5px;
+      background: white;
+      color: var(--primary);
+      font: inherit;
+      cursor: pointer;
+    }
+
+    @container style(--style-query-check: supported) {
+      .density-controls {
+        text-align: center;
+      }
+
+      #toggle-spacious {
+        display: inline-block;
+      }
+    }
+
+    /* The card reacts to the ancestor's --density without JS touching it */
+    #target-item {
+      padding: 20px;
+      transition: padding 0.3s;
+    }
+
+    @container style(--density: spacious) {
+      #target-item {
+        padding: 48px 32px;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
