diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..0e1ab14
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,41 @@
+import { useEffect, useRef } from 'react';
+
+export interface WebMCPTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations?: { readOnlyHint?: boolean };
+  execute: (input: any) => Promise<{ content: { type: 'text'; text: string }[] }>;
+}
+
+export const textResult = (text: string) => ({ content: [{ type: 'text' as const, text }] });
+
+/**
+ * Registers a WebMCP tool (navigator.modelContext) for as long as the calling
+ * component is mounted. No-op in browsers without WebMCP support.
+ * The latest `execute` is always used, so it may close over component state.
+ */
+export function useWebMCPTool(tool: WebMCPTool) {
+  const executeRef = useRef(tool.execute);
+  executeRef.current = tool.execute;
+
+  useEffect(() => {
+    const modelContext = (navigator as any).modelContext;
+    if (!modelContext?.registerTool) return;
+
+    const { name, description, inputSchema, annotations } = tool;
+    const registration = modelContext.registerTool({
+      name,
+      description,
+      inputSchema,
+      annotations,
+      execute: (input: any) => executeRef.current(input),
+    });
+
+    return () => {
+      if (registration?.unregister) registration.unregister();
+      else modelContext.unregisterTool?.(name);
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [tool.name]);
+}
