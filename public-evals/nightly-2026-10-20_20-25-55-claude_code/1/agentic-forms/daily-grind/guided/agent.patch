+
+  <script>
+    const filterForm = document.getElementById('filter-form');
+    const filterStatus = document.getElementById('filter-status');
+
+    filterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(filterForm);
+      const query = String(data.get('query') ?? '').trim().toLowerCase();
+      const kind = String(data.get('kind') ?? '');
+
+      const visible = [];
+      document.querySelectorAll('.grid .card').forEach((card) => {
+        const matches =
+          card.textContent.toLowerCase().includes(query) &&
+          (!kind || card.dataset.kind === kind);
+        card.hidden = !matches;
+        if (matches) visible.push(card.querySelector('h3').textContent);
+      });
+
+      filterStatus.textContent = visible.length
+        ? `Showing ${visible.length} drink(s).`
+        : 'No drinks match your filter.';
+
+      if (event.agentInvoked) {
+        event.respondWith(Promise.resolve(
+          visible.length
+            ? `Showing ${visible.length} drink(s): ${visible.join(', ')}`
+            : 'No drinks match the filter.'
+        ));
+      }
+    });
+
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterStatus = document.getElementById('newsletter-status');
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!newsletterForm.checkValidity()) {
+        const errors = [...newsletterForm.elements]
+          .filter((el) => el.name && !el.validity.valid)
+          .map((el) => `${el.name} (${el.validationMessage})`);
+        if (event.agentInvoked) {
+          event.respondWith(Promise.resolve('Validation failed: ' + errors.join(', ')));
+        }
+        newsletterForm.reportValidity();
+        return;
+      }
+
+      const name = new FormData(newsletterForm).get('name');
+      const message = `Thanks, ${name}! You're subscribed.`;
+      newsletterStatus.textContent = message;
+      newsletterForm.reset();
+
+      if (event.agentInvoked) event.respondWith(Promise.resolve(message));
+    });
+  </script>
