+  <script type="module">
+    const startDateInput = document.getElementById('startDateInput');
+    const yearsInput = document.getElementById('yearsInput');
+    const monthsInput = document.getElementById('monthsInput');
+    const overflowSelect = document.getElementById('overflowSelect');
+    const resultDate = document.getElementById('resultDate');
+
+    const POLYFILL_URL = 'https://esm.sh/@js-temporal/polyfill@0.5.1';
+
+    // Progressive enhancement: native Temporal first, then the polyfill,
+    // then (if the polyfill can't load) a small built-in calendar fallback.
+    async function loadTemporal() {
+      if (globalThis.Temporal?.PlainDate) return globalThis.Temporal;
+      try {
+        return (await import(POLYFILL_URL)).Temporal;
+      } catch {
+        return null;
+      }
+    }
+
+    const pad = (n, width) => String(n).padStart(width, '0');
+
+    // Fallback: pure integer calendar arithmetic (no Date rollover pitfalls).
+    function addFallback(isoDate, years, months, overflow) {
+      const [y, m, d] = isoDate.split('-').map(Number);
+      const index = y * 12 + (m - 1) + years * 12 + months;
+      const ty = Math.floor(index / 12);
+      const tm = (index % 12) + 1;
+      const daysInMonth = [31, (ty % 4 === 0 && ty % 100 !== 0) || ty % 400 === 0 ? 29 : 28,
+        31, 30, 31, 30, 31, 31, 30, 31, 30, 31][tm - 1];
+      if (ty > 9999) throw new RangeError('The resulting date is out of the supported range.');
+      let day = d;
+      if (d > daysInMonth) {
+        if (overflow === 'reject') {
+          throw new RangeError(`Day ${d} does not exist in ${pad(ty, 4)}-${pad(tm, 2)}.`);
+        }
+        day = daysInMonth;
+      }
+      const date = new Date(Date.UTC(2000, tm - 1, day, 12));
+      date.setUTCFullYear(ty);
+      return date.toLocaleDateString(undefined, { dateStyle: 'full', timeZone: 'UTC' });
+    }
+
+    let Temporal = null;
+    let ready = false;
+
+    function readCount(input, name) {
+      const raw = input.value.trim();
+      if (raw === '') return { value: 0 };
+      if (!/^\d+$/.test(raw)) return { error: `${name} must be a whole number of 0 or more.` };
+      const value = Number(raw);
+      if (!Number.isSafeInteger(value) || value > 100000) return { error: `${name} is too large.` };
+      return { value };
+    }
+
+    function show(text, isError = false) {
+      resultDate.textContent = text;
+      resultDate.classList.toggle('error', isError);
+    }
+
+    function update() {
+      if (!ready) return;
+      const start = startDateInput.value;
+      if (!start) return show('Please choose a start date.', true);
+
+      const years = readCount(yearsInput, 'Years');
+      if (years.error) return show(years.error, true);
+      const months = readCount(monthsInput, 'Months');
+      if (months.error) return show(months.error, true);
+
+      const overflow = overflowSelect.value === 'reject' ? 'reject' : 'constrain';
+
+      try {
+        if (Temporal) {
+          const next = Temporal.PlainDate.from(start).add(
+            { years: years.value, months: months.value },
+            { overflow }
+          );
+          show(next.toLocaleString(undefined, { dateStyle: 'full' }));
+        } else {
+          show(addFallback(start, years.value, months.value, overflow));
+        }
+      } catch (err) {
+        const detail = overflow === 'reject' && err instanceof RangeError
+          ? ' Try the "constrain" option to use the last day of the month instead.'
+          : '';
+        show(`Can't calculate this delivery date: ${err.message}${detail}`, true);
+      }
+    }
+
+    // Default start date: today in the user's local calendar.
+    const now = new Date();
+    startDateInput.value = `${pad(now.getFullYear(), 4)}-${pad(now.getMonth() + 1, 2)}-${pad(now.getDate(), 2)}`;
+
+    for (const el of [startDateInput, yearsInput, monthsInput, overflowSelect]) {
+      el.addEventListener('input', update);
+      el.addEventListener('change', update);
+    }
+
+    Temporal = await loadTemporal();
+    ready = true;
+    update();
+  </script>
