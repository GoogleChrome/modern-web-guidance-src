+  <script type="module">
+    // Temporal is not available in every browser yet: use it natively when present,
+    // otherwise lazy-load the reference polyfill.
+    if (typeof Temporal === 'undefined') {
+      try {
+        const mod = await import('https://esm.sh/@js-temporal/polyfill');
+        globalThis.Temporal = mod.Temporal;
+      } catch {
+        // handled below
+      }
+    }
+
+    const startInput = document.getElementById('startDateInput');
+    const yearsInput = document.getElementById('yearsInput');
+    const monthsInput = document.getElementById('monthsInput');
+    const overflowSelect = document.getElementById('overflowSelect');
+    const result = document.getElementById('resultDate');
+
+    function show(text, isError = false) {
+      result.textContent = text;
+      if (isError) result.dataset.state = 'error';
+      else delete result.dataset.state;
+    }
+
+    function parseCount(input, name) {
+      const raw = input.value.trim();
+      if (raw === '') return 0;
+      const n = Number(raw);
+      if (!Number.isInteger(n) || n < 0) {
+        throw new Error(`${name} must be a whole number, 0 or greater.`);
+      }
+      return n;
+    }
+
+    function update() {
+      if (typeof Temporal === 'undefined') {
+        show('Date calculation is unavailable: the Temporal API could not be loaded.', true);
+        return;
+      }
+      if (!startInput.value) {
+        show('Please choose a start date.', true);
+        return;
+      }
+      try {
+        const start = Temporal.PlainDate.from(startInput.value);
+        const years = parseCount(yearsInput, 'Years');
+        const months = parseCount(monthsInput, 'Months');
+        const next = start.add({ years, months }, { overflow: overflowSelect.value });
+        show(next.toLocaleString(undefined, { dateStyle: 'full' }));
+      } catch (e) {
+        if (e instanceof RangeError) {
+          show(`Can't calculate this delivery: the resulting date doesn't exist in the calendar (or is out of range), and "reject" is selected. Choose "constrain" or adjust the start date.`, true);
+        } else {
+          show(e.message, true);
+        }
+      }
+    }
+
+    if (typeof Temporal !== 'undefined') {
+      startInput.value = Temporal.Now.plainDateISO().toString();
+    }
+    for (const el of [startInput, yearsInput, monthsInput, overflowSelect]) {
+      el.addEventListener('input', update);
+      el.addEventListener('change', update);
+    }
+    update();
+  </script>
+
