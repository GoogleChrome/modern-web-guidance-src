+
+    /* Parallax Section */
+    .parallax {
+      position: relative;
+      height: 80vh;
+      min-height: 420px;
+      overflow: clip;
+      isolation: isolate;
+      background: var(--primary);
+      color: white;
+      display: grid;
+      place-items: center;
+      text-align: center;
+      padding: 0 20px;
+    }
+
+    .parallax-layer {
+      position: absolute;
+      inset: -25% 0;
+      pointer-events: none;
+    }
+
+    .parallax-back {
+      z-index: -3;
+    }
+
+    .parallax-back img {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      filter: brightness(0.5);
+    }
+
+    .parallax-mid {
+      z-index: -2;
+      background:
+        radial-gradient(circle at 20% 40%, rgba(255, 171, 64, 0.35), transparent 22%),
+        radial-gradient(circle at 80% 60%, rgba(215, 204, 200, 0.25), transparent 26%);
+    }
+
+    .parallax-front {
+      z-index: -1;
+    }
+
+    .parallax-front img {
+      position: absolute;
+      width: clamp(120px, 20vw, 260px);
+      aspect-ratio: 1;
+      object-fit: cover;
+      border-radius: 50%;
+      border: 4px solid var(--accent);
+      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
+    }
+
+    .parallax-front img:nth-child(1) {
+      left: 8%;
+      top: 45%;
+    }
+
+    .parallax-front img:nth-child(2) {
+      right: 8%;
+      top: 60%;
+    }
+
+    .parallax-content {
+      max-width: 600px;
+    }
+
+    .parallax-content h2 {
+      font-size: 2.2rem;
+      margin-bottom: 1rem;
+      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
+    }
+
+    /* Decorative depth effect: progressive enhancement, static where unsupported */
+    @keyframes parallax-shift {
+      from {
+        transform: translateY(var(--shift-from));
+      }
+
+      to {
+        transform: translateY(var(--shift-to));
+      }
+    }
+
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      @media (prefers-reduced-motion: no-preference) {
+        .parallax {
+          view-timeline: --parallax block;
+        }
+
+        .parallax-layer {
+          will-change: transform;
+          animation: parallax-shift linear both;
+          animation-timeline: --parallax;
+          animation-range: entry 0% exit 100%;
+        }
+
+        /* Slower layers sit further back; faster layers feel closer */
+        .parallax-back {
+          --shift-from: -8%;
+          --shift-to: 8%;
+        }
+
+        .parallax-mid {
+          --shift-from: -4%;
+          --shift-to: 4%;
+        }
+
+        .parallax-front {
+          --shift-from: 14%;
+          --shift-to: -14%;
+        }
+      }
+    }
+
