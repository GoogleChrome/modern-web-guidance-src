+
+  <script>
+    const ITEMS = [
+      {
+        slug: 'maple-oat-latte',
+        title: 'Maple Oat Latte',
+        image: 'https://images.unsplash.com/photo-1572442388796-11668a67e53d?auto=format&fit=crop&w=1350&q=80',
+        description: [
+          'Creamy oat milk with a hint of Vermont maple syrup.',
+          'Pulled from our house espresso blend and finished with a light dusting of cinnamon, it is the coziest cup on the menu this season.'
+        ]
+      },
+      {
+        slug: 'dark-roast-espresso',
+        title: 'Dark Roast Espresso',
+        image: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=1350&q=80',
+        description: [
+          'Bold, smokey, and perfect for a morning boost.',
+          'Roasted dark in small batches for deep notes of cocoa and toasted caramel, with a thick, lasting crema.'
+        ]
+      },
+      {
+        slug: 'cold-brew',
+        title: 'Cold Brew',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1350&q=80',
+        description: [
+          'Steeped for 18 hours for maximum smoothness.',
+          'Low acidity and naturally sweet, served over ice or topped with a splash of cream.'
+        ]
+      }
+    ];
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const grid = document.getElementById('grid');
+    const hero = document.getElementById('hero');
+    const heroImg = document.getElementById('hero-img');
+    const titleEl = document.getElementById('title');
+    const detailBody = document.getElementById('detail-body');
+
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const HERO_NAME = 'card-hero';
+    const TITLE_NAME = 'card-title';
+
+    let currentSlug = null; // null = list view
+    let listScrollY = 0;
+    let activeTransition = null;
+
+    // ---- Build list ----
+    for (const item of ITEMS) {
+      const a = document.createElement('a');
+      a.className = 'thumbnail';
+      a.href = '#/' + item.slug;
+      a.dataset.slug = item.slug;
+
+      const img = document.createElement('img');
+      img.src = item.image;
+      img.alt = '';
+      img.loading = 'lazy';
+
+      const caption = document.createElement('div');
+      caption.className = 'caption';
+      const h2 = document.createElement('h2');
+      h2.className = 'title';
+      h2.textContent = item.title;
+      caption.append(h2);
+
+      a.append(img, caption);
+      grid.append(a);
+    }
+
+    const thumbFor = slug => grid.querySelector(`.thumbnail[data-slug="${slug}"]`);
+
+    // ---- Transition helpers ----
+    function nameShared(heroLike, titleLike) {
+      heroLike.style.viewTransitionName = HERO_NAME;
+      titleLike.style.viewTransitionName = TITLE_NAME;
+    }
+
+    function clearAllNames() {
+      const els = [hero, titleEl, ...grid.querySelectorAll('.thumbnail, .thumbnail .title')];
+      for (const el of els) {
+        el.style.removeProperty('view-transition-name');
+        if (!el.getAttribute('style')) el.removeAttribute('style');
+      }
+      document.documentElement.classList.remove('vt-forward', 'vt-back');
+    }
+
+    function parseRoute() {
+      const slug = location.hash.replace(/^#\/?/, '');
+      return ITEMS.some(i => i.slug === slug) ? slug : null;
+    }
+
+    function fillDetail(slug) {
+      const item = ITEMS.find(i => i.slug === slug);
+      heroImg.src = item.image;
+      titleEl.textContent = item.title;
+      detailBody.replaceChildren(...item.description.map(text => {
+        const p = document.createElement('p');
+        p.textContent = text;
+        return p;
+      }));
+      document.title = item.title + ' | The Daily Grind';
+    }
+
+    // Swap visible page and move focus to the active heading.
+    function showPage(slug) {
+      if (slug) {
+        fillDetail(slug);
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        window.scrollTo(0, 0);
+        titleEl.focus({ preventScroll: true });
+      } else {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        document.title = 'The Daily Grind | Artisanal Coffee';
+        window.scrollTo(0, listScrollY);
+        listHeading.focus({ preventScroll: true });
+      }
+    }
+
+    function navigate(slug) {
+      if (slug === currentSlug) return;
+      const from = currentSlug;
+      if (from === null) listScrollY = window.scrollY;
+
+      if (activeTransition) {
+        activeTransition.skipTransition();
+        activeTransition = null;
+        clearAllNames();
+      }
+
+      const canAnimate = document.startViewTransition && !reducedMotion.matches;
+      currentSlug = slug;
+
+      if (!canAnimate) {
+        showPage(slug);
+        return;
+      }
+
+      const forward = slug !== null;
+      const thumb = thumbFor(forward ? slug : from);
+      const thumbTitle = thumb.querySelector('.title');
+      const root = document.documentElement;
+      root.classList.add(forward ? 'vt-forward' : 'vt-back');
+
+      // Old state gets the names before the snapshot is taken...
+      if (forward) nameShared(thumb, thumbTitle);
+      else nameShared(hero, titleEl);
+
+      const transition = document.startViewTransition(() => {
+        // ...and they move to the new state's elements once the DOM has changed.
+        clearAllNames();
+        root.classList.add(forward ? 'vt-forward' : 'vt-back');
+        showPage(slug);
+        if (forward) nameShared(hero, titleEl);
+        else nameShared(thumb, thumbTitle);
+      });
+
+      activeTransition = transition;
+      transition.finished.finally(() => {
+        if (activeTransition === transition) {
+          activeTransition = null;
+          clearAllNames();
+        }
+      });
+    }
+
+    window.addEventListener('hashchange', () => navigate(parseRoute()));
+
+    // Initial render (no animation)
+    currentSlug = parseRoute();
+    showPage(currentSlug);
+  </script>
+
