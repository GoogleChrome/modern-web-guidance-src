+  <script>
+    const unsplash = (id) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=1350&q=80`;
+
+    const items = [
+      {
+        id: 'maple-oat-latte',
+        title: 'Maple Oat Latte',
+        image: unsplash('photo-1509042239860-f550ce710b93'),
+        body: 'Creamy oat milk with a hint of Vermont maple syrup, poured over a double shot of our house espresso.'
+      },
+      {
+        id: 'dark-roast-espresso',
+        title: 'Dark Roast Espresso',
+        image: unsplash('photo-1510707577719-ae7c14805e3a'),
+        body: 'Bold, smokey, and perfect for a morning boost. Roasted in small batches and pulled to order.'
+      },
+      {
+        id: 'cold-brew',
+        title: 'Cold Brew',
+        image: unsplash('photo-1461023058943-07fcbe16d735'),
+        body: 'Steeped for 18 hours for maximum smoothness, then served over ice.'
+      }
+    ];
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const detailTitle = document.getElementById('title');
+    const detailHero = document.getElementById('hero');
+    const detailBody = document.getElementById('detail-body');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    // Build the thumbnails. Each one links to a hash route, so the back button and deep links work.
+    const grid = document.getElementById('thumbnails');
+    for (const item of items) {
+      const a = document.createElement('a');
+      a.className = 'thumbnail';
+      a.id = `thumb-${item.id}`;
+      a.href = `#/${item.id}`;
+      a.style.setProperty('--image', `url('${item.image}')`);
+      const h2 = document.createElement('h2');
+      h2.className = 'title';
+      h2.textContent = item.title;
+      a.append(h2);
+      grid.append(a);
+    }
+
+    let currentId = null; // id of the item shown in the detail view, or null for the list
+    let listScroll = 0;
+    let activeTransition = null;
+
+    function routeId() {
+      const id = location.hash.replace(/^#\//, '');
+      return items.some((item) => item.id === id) ? id : null;
+    }
+
+    function showDetail(item) {
+      detailTitle.textContent = item.title;
+      detailHero.style.setProperty('--image', `url('${item.image}')`);
+      detailBody.textContent = item.body;
+      listPage.hidden = true;
+      detailPage.hidden = false;
+      window.scrollTo(0, 0);
+    }
+
+    function showList() {
+      detailPage.hidden = true;
+      listPage.hidden = false;
+      window.scrollTo(0, listScroll);
+    }
+
+    function render() {
+      const nextId = routeId();
+      if (nextId === currentId) return;
+      const prevId = currentId;
+      currentId = nextId;
+
+      // The thumbnail involved in the morph is the one for whichever item is the detail.
+      const thumb = document.getElementById(`thumb-${nextId ?? prevId}`);
+      const focusTarget = () => (nextId ? detailTitle : listHeading);
+
+      if (!prevId) listScroll = window.scrollY;
+
+      const update = () => {
+        if (nextId) showDetail(items.find((item) => item.id === nextId));
+        else showList();
+        // On the way back the thumbnail must carry the shared names in the new state.
+        thumb?.classList.add('selected');
+      };
+
+      const finish = () => {
+        // Remove the temporary transition names, then keep focus from being lost.
+        document.querySelectorAll('.thumbnail.selected').forEach((el) => el.classList.remove('selected'));
+        activeTransition = null;
+        focusTarget().focus({ preventScroll: true });
+      };
+
+      activeTransition?.skipTransition();
+
+      if (!document.startViewTransition || reducedMotion.matches) {
+        update();
+        finish();
+        return;
+      }
+
+      // On the way in the thumbnail must carry the shared names in the old state.
+      thumb?.classList.add('selected');
+      activeTransition = document.startViewTransition(update);
+      const transition = activeTransition;
+      transition.finished.finally(() => {
+        if (activeTransition === transition || activeTransition === null) finish();
+      });
+    }
+
+    addEventListener('hashchange', render);
+    render();
+  </script>
