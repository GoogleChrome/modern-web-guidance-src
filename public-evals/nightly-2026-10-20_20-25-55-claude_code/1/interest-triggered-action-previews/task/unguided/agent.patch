@@ -134,8 +134,50 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Seasonal preview: driven by interestfor (hover/focus) via :interest-source, no JS.
+       Each rule is kept separate so browsers lacking the pseudo-class ignore only that rule. */
+    #seasonal-preview {
+      margin-top: 20px;
+      padding: 20px;
+      border: 2px dashed var(--secondary);
+      border-radius: 8px;
+      background: white;
+      text-align: center;
+      font-size: 1.25rem;
+      font-weight: 600;
+      color: var(--primary);
+      transition: background 0.3s, color 0.3s;
+    }
+
+    #seasonal-preview .preview-drink {
+      display: none;
+    }
+
+    main:has(.btn:interest-source) #seasonal-preview .preview-default {
+      display: none;
+    }
+
+    main:has([data-drink="maple"]:interest-source) #seasonal-preview .preview-maple,
+    main:has([data-drink="espresso"]:interest-source) #seasonal-preview .preview-espresso,
+    main:has([data-drink="cold-brew"]:interest-source) #seasonal-preview .preview-cold-brew {
+      display: inline;
+    }
+
+    main:has([data-drink="maple"]:interest-source) #seasonal-preview {
+      background: #ffe0b2;
+    }
+
+    main:has([data-drink="espresso"]:interest-source) #seasonal-preview {
+      background: var(--primary);
+      color: white;
+    }
+
+    main:has([data-drink="cold-brew"]:interest-source) #seasonal-preview {
+      background: #cfd8dc;
+    }
+
     footer {
