+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const summaryEl = document.getElementById('summary');
+    const journalText = document.getElementById('journal-text');
+
+    function showSummary(message, bullets) {
+      summaryEl.replaceChildren();
+      if (bullets) {
+        const ul = document.createElement('ul');
+        for (const text of bullets) {
+          const li = document.createElement('li');
+          li.textContent = text;
+          ul.appendChild(li);
+        }
+        summaryEl.appendChild(ul);
+      } else {
+        summaryEl.textContent = message;
+      }
+      summaryEl.hidden = false;
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      if (!('Summarizer' in self)) {
+        showSummary("Your browser doesn't support built-in AI summarization.");
+        return;
+      }
+
+      summarizeBtn.disabled = true;
+      let summarizer;
+      try {
+        const availability = await Summarizer.availability();
+        if (availability === 'unavailable') {
+          showSummary('Built-in AI summarization is unavailable on this device.');
+          return;
+        }
+
+        showSummary(availability === 'available' ? 'Summarizing…' : 'Downloading the on-device model…');
+        summarizer = await Summarizer.create({
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              showSummary(`Downloading the on-device model… ${Math.round(e.loaded * 100)}%`);
+            });
+          },
+        });
+
+        showSummary('Summarizing…');
+        const result = await summarizer.summarize(journalText.innerText);
+        const bullets = result.split('\n')
+          .map((line) => line.replace(/^\s*[-*•]\s+/, '').trim())
+          .filter(Boolean);
+        showSummary('', bullets);
+      } catch (err) {
+        console.error(err);
+        showSummary('Sorry, something went wrong while summarizing.');
+      } finally {
+        summarizer?.destroy();
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
