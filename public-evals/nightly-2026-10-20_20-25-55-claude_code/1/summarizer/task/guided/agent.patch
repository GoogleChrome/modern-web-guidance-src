+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const statusEl = document.getElementById('summarize-status');
+    const summaryBox = document.getElementById('summary');
+    const summaryList = document.getElementById('summary-list');
+    const summarizerOptions = {
+      sharedContext: 'A coffee roaster describing how it sources its beans.',
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'medium',
+      expectedInputLanguages: ['en'],
+      expectedContextLanguages: ['en'],
+      outputLanguage: 'en',
+    };
+
+    function renderBullets(text) {
+      const items = text.split('\n')
+        .map((line) => line.replace(/^\s*[-*\u2022]\s*/, '').trim())
+        .filter(Boolean);
+      summaryList.replaceChildren(...items.map((item) => {
+        const li = document.createElement('li');
+        li.textContent = item;
+        return li;
+      }));
+    }
+
+    async function summarize() {
+      summarizeBtn.disabled = true;
+      statusEl.textContent = '';
+      try {
+        const summarizer = await Summarizer.create({
+          ...summarizerOptions,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              statusEl.textContent = `Downloading on-device model: ${Math.round(e.loaded * 100)}%`;
+            });
+          },
+        });
+        statusEl.textContent = 'Summarizing…';
+        summaryBox.hidden = false;
+        let text = '';
+        for await (const chunk of summarizer.summarizeStreaming(
+          document.getElementById('journal-text').innerText)) {
+          text += chunk;
+          renderBullets(text);
+        }
+        statusEl.textContent = '';
+        summarizer.destroy();
+      } catch (err) {
+        console.error(err);
+        summaryBox.hidden = true;
+        statusEl.textContent = 'Sorry, the summary could not be generated.';
+      } finally {
+        summarizeBtn.disabled = false;
+      }
+    }
+
+    (async () => {
+      if (!('Summarizer' in self)) {
+        statusEl.textContent = 'Summaries need on-device AI, which this browser does not support.';
+        return;
+      }
+      const availability = await Summarizer.availability(summarizerOptions);
+      if (availability === 'unavailable') {
+        statusEl.textContent = 'Summaries are not available on this device.';
+        return;
+      }
+      summarizeBtn.hidden = false;
+      summarizeBtn.addEventListener('click', summarize);
+    })();
+  </script>
+
 </body>
 
