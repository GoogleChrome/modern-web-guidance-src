+  <script>
+    (() => {
+      const form = document.getElementById('shipping-form');
+      const messages = {
+        'full-name': 'Please enter your full name using letters only.',
+        address: 'Please enter your street address.',
+        city: 'Please enter your city.',
+        country: 'Please select a country.'
+      };
+
+      const showError = (field) => {
+        const slot = document.getElementById(`${field.id}-error`);
+        if (!slot) return;
+        slot.textContent = field.validity.valid ? '' : (messages[field.id] || field.validationMessage);
+      };
+
+      // Validate on blur, clear errors as soon as the user corrects the field
+      form.addEventListener('focusout', (e) => {
+        if (e.target.willValidate) showError(e.target);
+      });
+      form.addEventListener('input', (e) => {
+        if (e.target.validity.valid) showError(e.target);
+      });
+
+      form.addEventListener('submit', (e) => {
+        if (!form.checkValidity()) {
+          e.preventDefault();
+          form.querySelectorAll(':invalid').forEach(showError);
+          form.querySelector(':invalid').focus();
+          return;
+        }
+        // Prevent double submission once the form is valid
+        form.querySelector('button[type="submit"]').disabled = true;
+      });
+    })();
+  </script>
+
