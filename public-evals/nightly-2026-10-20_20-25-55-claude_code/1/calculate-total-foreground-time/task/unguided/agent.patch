+  <script>
+    // Foreground time tracking: counts only time the page is visible.
+    let foregroundMs = 0;
+    let foregroundSince = document.visibilityState === 'visible' ? performance.now() : null;
+
+    document.addEventListener('visibilitychange', () => {
+      if (document.visibilityState === 'visible') {
+        if (foregroundSince === null) foregroundSince = performance.now();
+      } else if (foregroundSince !== null) {
+        foregroundMs += performance.now() - foregroundSince;
+        foregroundSince = null;
+      }
+    });
+
+    // Returns total time (in milliseconds) the page has spent in the foreground.
+    function getForegroundTime() {
+      return foregroundMs + (foregroundSince !== null ? performance.now() - foregroundSince : 0);
+    }
+  </script>
