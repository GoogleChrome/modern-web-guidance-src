+  <script>
+    (function () {
+      var picker = document.getElementById('roast-picker');
+      var toggle = document.getElementById('roast-toggle');
+      var list = document.getElementById('roast-list');
+      var selectedBox = toggle.querySelector('.roast-selected');
+      var options = Array.prototype.slice.call(list.querySelectorAll('.roast-option'));
+      var activeIndex = -1;
+
+      function setActive(i) {
+        activeIndex = (i + options.length) % options.length;
+        options.forEach(function (o, n) { o.classList.toggle('active', n === activeIndex); });
+        list.setAttribute('aria-activedescendant', options[activeIndex].id);
+      }
+
+      function open() {
+        list.hidden = false;
+        toggle.setAttribute('aria-expanded', 'true');
+        var sel = options.findIndex(function (o) { return o.getAttribute('aria-selected') === 'true'; });
+        setActive(sel < 0 ? 0 : sel);
+        list.focus();
+      }
+
+      function close(refocus) {
+        list.hidden = true;
+        toggle.setAttribute('aria-expanded', 'false');
+        options.forEach(function (o) { o.classList.remove('active'); });
+        if (refocus) toggle.focus();
+      }
+
+      function choose(i) {
+        options.forEach(function (o, n) { o.setAttribute('aria-selected', n === i ? 'true' : 'false'); });
+        selectedBox.innerHTML = options[i].innerHTML;
+        picker.dataset.value = options[i].dataset.value;
+        close(true);
+      }
+
+      toggle.addEventListener('click', function () { list.hidden ? open() : close(); });
+      options.forEach(function (o, i) {
+        o.addEventListener('click', function () { choose(i); });
+      });
+      list.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIndex + 1); }
+        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(activeIndex - 1); }
+        else if (e.key === 'Home') { e.preventDefault(); setActive(0); }
+        else if (e.key === 'End') { e.preventDefault(); setActive(options.length - 1); }
+        else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(activeIndex); }
+        else if (e.key === 'Escape') { close(true); }
+        else if (e.key === 'Tab') { close(); }
+      });
+      document.addEventListener('click', function (e) {
+        if (!picker.contains(e.target)) close();
+      });
+    })();
+  </script>
 </body>
 
