+    /* Roast picker */
+    .roast-picker {
+      margin-top: 1.5rem;
+      width: min(100%, 340px);
+      text-align: left;
+    }
+
+    .roast-picker label {
+      display: block;
+      font-size: 0.85rem;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      margin-bottom: 6px;
+    }
+
+    .roast-select,
+    .roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .roast-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      padding: 10px 12px;
+      background: var(--light);
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 5px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .roast-select:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .roast-select::picker(select) {
+      background: var(--light);
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 6px;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
+      width: anchor-size(width);
+    }
+
+    .roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px;
+      border-radius: 4px;
+      cursor: pointer;
+    }
+
+    .roast-select option::before {
+      display: none;
+    }
+
+    .roast-select option svg {
+      flex: none;
+      color: var(--primary);
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus-visible {
+      background: var(--secondary);
+    }
+
+    .roast-select option:checked {
+      background: var(--primary);
+      color: white;
+    }
+
+    .roast-select option:checked svg {
+      color: var(--accent);
+    }
+
+    .roast-select option:checked .option-title {
+      font-weight: 700;
+    }
+
+    .option-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .option-title {
+      font-weight: 600;
+    }
+
+    .option-desc {
+      font-size: 0.8rem;
+      opacity: 0.8;
+    }
+
+    .roast-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+    }
+
+    .roast-select selectedcontent .option-desc {
+      display: none;
+    }
+
