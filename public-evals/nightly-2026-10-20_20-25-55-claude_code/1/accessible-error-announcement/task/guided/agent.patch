+  <script>
+    // :user-invalid is visual only; mirror it into aria-invalid so screen
+    // readers don't announce an error before the user has interacted.
+    const newsletterForm = document.querySelector('.newsletter');
+
+    const syncAriaInvalid = (el) => {
+      el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+    };
+
+    // Reveal the error once the user leaves the field
+    newsletterForm.addEventListener('blur', (e) => {
+      if (e.target.matches('input')) syncAriaInvalid(e.target);
+    }, true);
+
+    // Clear (or update) the error as the user corrects the value
+    newsletterForm.addEventListener('input', (e) => {
+      if (e.target.hasAttribute('aria-invalid')) syncAriaInvalid(e.target);
+    });
+
+    // A failed submit attempt fires `invalid` (non-bubbling) on the field
+    newsletterForm.addEventListener('invalid', (e) => syncAriaInvalid(e.target), true);
+  </script>
+
 </body>
 
