     </div>
+    <form class="newsletter" id="newsletter-form" action="/newsletter" method="post">
+      <label for="newsletter-email">Join our newsletter</label>
+      <div class="newsletter-row">
+        <input type="email" id="newsletter-email" name="email" placeholder="you@example.com"
+          autocomplete="email" required aria-describedby="newsletter-error">
+        <button type="submit">Subscribe</button>
+      </div>
+      <p class="newsletter-error" id="newsletter-error"></p>
+    </form>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      var input = document.getElementById('newsletter-email');
+      var error = document.getElementById('newsletter-error');
+
+      function isUserInvalid() {
+        try {
+          return input.matches(':user-invalid');
+        } catch (e) {
+          // Browser without :user-invalid support: approximate it.
+          return input.dataset.touched === 'true' && !input.validity.valid;
+        }
+      }
+
+      function message() {
+        var v = input.validity;
+        if (v.valueMissing) return 'Please enter your email address.';
+        if (v.typeMismatch) return 'Please enter a valid email address, like you@example.com.';
+        return input.validationMessage;
+      }
+
+      // Mirror :user-invalid into aria-invalid so nothing is announced
+      // until the user has actually interacted with the field.
+      function sync() {
+        var invalid = isUserInvalid();
+        if (invalid) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+        error.textContent = invalid ? message() : '';
+      }
+
+      input.addEventListener('blur', function () {
+        input.dataset.touched = 'true';
+        sync();
+      });
+      input.addEventListener('input', sync);
+      // Fires on a failed submit attempt, after which :user-invalid applies.
+      // Suppress the native bubble; the inline error replaces it.
+      input.addEventListener('invalid', function (e) {
+        e.preventDefault();
+        input.dataset.touched = 'true';
+        sync();
+      });
+    })();
+  </script>
+
 </body>
 
