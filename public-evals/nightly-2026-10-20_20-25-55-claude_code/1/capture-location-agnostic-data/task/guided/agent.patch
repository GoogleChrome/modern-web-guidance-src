+  <script type="module">
+    // Both values are location-agnostic: a wall-clock time and a calendar date.
+    // They are stored as plain ISO strings ("HH:MM", "YYYY-MM-DD") and handled
+    // with Temporal.PlainTime / PlainDate, never Date, so time zone shifts
+    // (travel, DST) cannot change them.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const STORAGE_KEY = 'dailyGrindPrefs';
+    const form = document.getElementById('prefs-form');
+    const summary = document.getElementById('prefs-summary');
+
+    function render({ pickupTime, coffeeAnniversary }) {
+      const time = Temporal.PlainTime.from(pickupTime);
+      const date = Temporal.PlainDate.from(coffeeAnniversary);
+      summary.textContent =
+        `Reminder every day at ${time.toLocaleString(undefined, { timeStyle: 'short' })}. ` +
+        `Coffee anniversary: ${date.toLocaleString(undefined, { dateStyle: 'long' })}.`;
+    }
+
+    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? 'null');
+    if (saved) {
+      form.elements.pickupTime.value = saved.pickupTime;
+      form.elements.coffeeAnniversary.value = saved.coffeeAnniversary;
+      render(saved);
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const prefs = {
+        pickupTime: Temporal.PlainTime.from(form.elements.pickupTime.value)
+          .toString({ smallestUnit: 'minute' }),
+        coffeeAnniversary: Temporal.PlainDate.from(form.elements.coffeeAnniversary.value).toString(),
+      };
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
+      render(prefs);
+    });
+  </script>
 </body>
 
