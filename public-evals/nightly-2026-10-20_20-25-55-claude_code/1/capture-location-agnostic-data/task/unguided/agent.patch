+  <script>
+    // Both values are floating (location-agnostic) strings: "HH:MM" and "YYYY-MM-DD".
+    // They are never converted through Date/UTC, so travel or time zone changes can't shift them.
+    (function () {
+      var KEY = 'dailyGrindPrefs';
+      var form = document.getElementById('prefs-form');
+      var timeInput = document.getElementById('pickup-time');
+      var dateInput = document.getElementById('coffee-anniversary');
+      var summary = document.getElementById('prefs-summary');
+      var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
+        'August', 'September', 'October', 'November', 'December'];
+
+      function formatTime(value) {
+        var p = value.split(':');
+        var h = parseInt(p[0], 10);
+        return ((h + 11) % 12 + 1) + ':' + p[1] + (h < 12 ? ' AM' : ' PM');
+      }
+
+      function formatDate(value) {
+        var p = value.split('-');
+        return MONTHS[parseInt(p[1], 10) - 1] + ' ' + parseInt(p[2], 10) + ', ' + p[0];
+      }
+
+      function render(prefs) {
+        var parts = [];
+        if (prefs.pickupTime) parts.push('Pickup reminder: ' + formatTime(prefs.pickupTime) + ' every day (local time wherever you are)');
+        if (prefs.coffeeAnniversary) parts.push('Coffee anniversary: ' + formatDate(prefs.coffeeAnniversary));
+        summary.textContent = parts.join(' · ');
+      }
+
+      var saved = {};
+      try { saved = JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) { }
+      timeInput.value = saved.pickupTime || '';
+      dateInput.value = saved.coffeeAnniversary || '';
+      render(saved);
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var prefs = { pickupTime: timeInput.value, coffeeAnniversary: dateInput.value };
+        try { localStorage.setItem(KEY, JSON.stringify(prefs)); } catch (err) { }
+        render(prefs);
+      });
+    })();
+  </script>
+
 </body>
 
