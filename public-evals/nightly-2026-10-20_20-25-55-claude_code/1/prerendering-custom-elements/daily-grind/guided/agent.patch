+  <script type="module">
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['favorited'];
+
+      constructor() {
+        super();
+        if (!this.shadowRoot) {
+          // Fallback: build the root from the same server markup.
+          const tpl = this.querySelector(':scope > template[shadowrootmode]');
+          this.attachShadow({ mode: 'open' });
+          if (tpl) {
+            this.shadowRoot.append(tpl.content);
+            tpl.remove();
+          }
+        }
+        // Hydrate in place: wire behavior to the existing markup, no re-render.
+        this.shadowRoot.querySelector('.fav')?.addEventListener('click', () => {
+          this.toggleAttribute('favorited');
+          this.dispatchEvent(new Event('change', { bubbles: true }));
+        });
+      }
+
+      attributeChangedCallback(name, _old, value) {
+        this.shadowRoot?.querySelector('.fav')
+          ?.setAttribute('aria-pressed', String(value !== null));
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
