index 0000000..8dc7c0e
--- /dev/null
+++ b/components/drink-card.js
@@ -0,0 +1,36 @@
+// <drink-card> is server-rendered with Declarative Shadow DOM, so the markup and
+// its styles exist at first paint. Defining the element only adopts that existing
+// shadow root and attaches behavior; nothing is re-rendered.
+class DrinkCard extends HTMLElement {
+  #button;
+
+  connectedCallback() {
+    const root = this.#adoptShadowRoot();
+    this.#button = root.querySelector('button');
+    this.#button.addEventListener('click', this.#toggle);
+  }
+
+  disconnectedCallback() {
+    this.#button?.removeEventListener('click', this.#toggle);
+  }
+
+  // Browsers with DSD support have already attached the root. For older ones the
+  // <template shadowrootmode> is still a child, so attach it by hand (same DOM,
+  // no re-render, though a flash is possible there).
+  #adoptShadowRoot() {
+    if (this.shadowRoot) return this.shadowRoot;
+    const tpl = this.querySelector(':scope > template[shadowrootmode]');
+    const root = this.attachShadow({ mode: tpl.getAttribute('shadowrootmode') });
+    root.append(tpl.content);
+    tpl.remove();
+    return root;
+  }
+
+  #toggle = () => {
+    const on = this.toggleAttribute('favorited');
+    this.#button.setAttribute('aria-pressed', String(on));
+    this.dispatchEvent(new CustomEvent('favorite-change', { detail: { favorited: on }, bubbles: true }));
+  };
+}
+
+customElements.define('drink-card', DrinkCard);
