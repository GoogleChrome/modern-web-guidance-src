+      </label>
+      <label for="fb-rating">Rating
+        <select id="fb-rating" name="rating">
+          <option>5 - Perfect brew</option>
+          <option>4 - Great</option>
+          <option>3 - Fine</option>
+          <option>2 - Weak</option>
+          <option>1 - Burnt</option>
+        </select>
+      </label>
+      <label for="fb-message">Message
+        <textarea id="fb-message" name="message"></textarea>
+      </label>
+
+      <div class="feedback-move">
+        Move dialog to:
+        <div class="feedback-move-buttons">
+          <button type="button" data-move-to="slot-hero" aria-pressed="false">Hero</button>
+          <button type="button" data-move-to="slot-main" aria-pressed="false">Main</button>
+          <button type="button" data-move-to="slot-footer" aria-pressed="false">Footer</button>
+        </div>
+        <p class="feedback-status" id="feedback-status" role="status"></p>
+      </div>
+
+      <div class="feedback-actions">
+        <button type="button" id="feedback-close">Close</button>
+        <button type="submit">Send</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    (() => {
+      const dialog = document.getElementById('feedback-dialog');
+      const status = document.getElementById('feedback-status');
+      const supportsMoveBefore = typeof Element.prototype.moveBefore === 'function';
+      const STORE_KEY = 'feedback-dialog-slot';
+
+      function updateStatus(slot, mode) {
+        status.textContent = `Currently inside: ${slot.dataset.slotLabel} (${mode})`;
+        dialog.querySelectorAll('[data-move-to]').forEach((b) => {
+          b.setAttribute('aria-pressed', String(b.dataset.moveTo === slot.id));
+        });
+      }
+
+      // Native path: moveBefore keeps the dialog open, in the top layer, with focus,
+      // form state and scroll position intact.
+      function moveNative(target) {
+        target.moveBefore(dialog, null);
+      }
+
+      // Fallback: insertion removes the node, which closes the dialog and drops focus,
+      // so snapshot the state and re-open it after reparenting.
+      function moveFallback(target) {
+        const wasOpen = dialog.open;
+        const wasModal = wasOpen && dialog.matches(':modal');
+        const active = document.activeElement;
+        const focusEl = dialog.contains(active) ? active : null;
+        const selection = focusEl && 'selectionStart' in focusEl
+          ? [focusEl.selectionStart, focusEl.selectionEnd, focusEl.selectionDirection]
+          : null;
+        const scroll = dialog.scrollTop;
+        const values = new FormData(dialog.querySelector('form'));
+
+        target.appendChild(dialog);
+
+        if (wasOpen) {
+          wasModal ? dialog.showModal() : dialog.show();
+        }
+        // Form control values survive reparenting, but re-apply defensively.
+        for (const [name, value] of values) {
+          const field = dialog.querySelector(`[name="${name}"]`);
+          if (field && field.value !== value) field.value = value;
+        }
+        dialog.scrollTop = scroll;
+        if (focusEl) {
+          focusEl.focus({ preventScroll: true });
+          if (selection) {
+            try { focusEl.setSelectionRange(...selection); } catch { /* not a text control */ }
+          }
+        }
+      }
+
+      function moveTo(slotId) {
+        const target = document.getElementById(slotId);
+        if (!target || target === dialog.parentElement) return;
+        let mode = 'moveBefore';
+        if (supportsMoveBefore) {
+          try {
+            moveNative(target);
+          } catch {
+            // e.g. disconnected/cross-document targets; degrade gracefully.
+            mode = 'fallback';
+            moveFallback(target);
+          }
+        } else {
+          mode = 'fallback';
+          moveFallback(target);
+        }
+        sessionStorage.setItem(STORE_KEY, slotId);
+        updateStatus(target, mode);
+      }
+
+      dialog.addEventListener('click', (e) => {
+        const btn = e.target.closest('[data-move-to]');
+        if (btn) moveTo(btn.dataset.moveTo);
+      });
+
+      document.getElementById('feedback-open').addEventListener('click', () => {
+        if (!dialog.open) dialog.showModal();
+      });
+      document.getElementById('feedback-close').addEventListener('click', () => dialog.close());
+      dialog.querySelector('form').addEventListener('submit', () => {
+        dialog.querySelector('form').reset();
+      });
+
+      // Restore last position (dialog is closed here, so a plain move is safe).
+      const saved = document.getElementById(sessionStorage.getItem(STORE_KEY) || '');
+      const initial = saved || document.getElementById('slot-main');
+      initial.appendChild(dialog);
+      updateStatus(initial, 'initial');
+    })();
+  </script>
+
