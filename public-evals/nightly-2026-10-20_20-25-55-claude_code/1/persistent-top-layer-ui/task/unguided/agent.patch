+  <button type="button" class="btn feedback-trigger" id="feedback-open">Feedback</button>
+
+  <dialog class="feedback-dialog" id="feedback-dialog" aria-labelledby="feedback-title">
+    <form method="dialog" id="feedback-form">
+      <h2 id="feedback-title">Tell us how we're doing</h2>
+      <p>This overlay stays open while you move it around the page.</p>
+
+      <label for="fb-name">Name
