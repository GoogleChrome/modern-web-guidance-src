+  <button type="button" class="btn feedback-fab" id="feedback-open">Feedback</button>
+
+  <dialog class="feedback-dialog" id="feedback-dialog" aria-labelledby="feedback-title">
+    <form method="dialog">
+      <h2 id="feedback-title">Send us feedback</h2>
+      <p>How are we brewing so far?</p>
+
+      <label for="feedback-topic">Topic</label>
+      <select id="feedback-topic">
+        <option>General</option>
+        <option>Menu</option>
+        <option>Website</option>
+      </select>
+
+      <label for="feedback-text">Your thoughts</label>
+      <textarea id="feedback-text"></textarea>
+
+      <fieldset>
+        <legend>Move this dialog to</legend>
+        <div class="move-buttons">
+          <button type="button" class="btn secondary" data-move-to="nav">Header</button>
+          <button type="button" class="btn secondary" data-move-to=".hero">Hero</button>
+          <button type="button" class="btn secondary" data-move-to="main">Main</button>
+          <button type="button" class="btn secondary" data-move-to="footer">Footer</button>
+        </div>
+        <p class="move-status" id="move-status" role="status"></p>
+      </fieldset>
+
+      <div class="dialog-actions">
+        <button type="submit" class="btn secondary" value="cancel">Close</button>
+        <button type="submit" class="btn" value="send">Send</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    const dialog = document.getElementById('feedback-dialog');
+    const status = document.getElementById('move-status');
+
+    document.getElementById('feedback-open').addEventListener('click', () => {
+      if (!dialog.open) dialog.showModal();
+      reportParent();
+    });
+
+    function reportParent(note = '') {
+      status.textContent = `Currently inside <${dialog.parentElement.localName}>. ${note}`.trim();
+    }
+
+    // Reparent the open dialog; moveBefore() keeps it open, focused and in the top layer.
+    function moveDialog(newParent) {
+      const button = document.activeElement;
+      const wasOpen = dialog.open;
+
+      if ('moveBefore' in Element.prototype) {
+        newParent.moveBefore(dialog, null);
+        reportParent('(moved with moveBefore, state preserved)');
+        return;
+      }
+
+      // Fallback: a plain move closes the dialog, so re-open it and restore focus.
+      // Field values survive because the same nodes are reused.
+      const scrollTop = dialog.scrollTop;
+      newParent.insertBefore(dialog, null);
+      if (wasOpen && !dialog.open) dialog.showModal();
+      dialog.scrollTop = scrollTop;
+      if (button && dialog.contains(button)) button.focus();
+      reportParent('(moved with fallback: dialog re-opened)');
+    }
+
+    dialog.addEventListener('click', (event) => {
+      const button = event.target.closest('[data-move-to]');
+      if (!button) return;
+      const target = document.querySelector(button.dataset.moveTo);
+      if (target && target !== dialog.parentElement) moveDialog(target);
+    });
+
+    // Persistent: Escape is the only dismissal besides the Close/Send buttons (no backdrop click).
+    dialog.addEventListener('close', () => {
+      if (dialog.returnValue === 'send') document.getElementById('feedback-text').value = '';
+    });
+  </script>
+
