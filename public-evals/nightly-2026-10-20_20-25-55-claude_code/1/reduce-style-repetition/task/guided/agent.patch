@@ -13,8 +13,21 @@
       --text: #3e2723;
       --light: #fafafa;
     }
 
+    /* Reusable gradient: any two colors, overridable angle */
+    @function --gradient(--from <color>, --to <color>, --angle: 135deg) returns <image> {
+      result: linear-gradient(in oklab var(--angle), var(--from), var(--to));
+    }
+
+    /* Single column by default, --cols equal columns from 1000px up */
+    @function --columns(--cols <number>) {
+      result: 1fr;
+      @media (min-width: 1000px) {
+        result: repeat(var(--cols), 1fr);
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
