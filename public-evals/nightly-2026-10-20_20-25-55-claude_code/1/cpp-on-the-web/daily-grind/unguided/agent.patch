+  <script>
+    const canvas = document.getElementById('render');
+    const ctx = canvas.getContext('2d');
+    const status = document.getElementById('status');
+    const button = document.getElementById('rerender');
+    const worker = new Worker('smallpt/worker.js');
+    let started;
+
+    function randomColor() {
+      // Random hue, fairly saturated so walls stay distinct
+      const h = Math.random() * 6, c = 0.8, x = c * (1 - Math.abs(h % 2 - 1)), m = 0.1;
+      const [r, g, b] = [[c, x, 0], [x, c, 0], [0, c, x], [0, x, c], [x, 0, c], [c, 0, x]][Math.floor(h)];
+      return [r + m, g + m, b + m];
+    }
+
+    function run(randomize) {
+      button.disabled = true;
+      status.textContent = 'Rendering…';
+      started = performance.now();
+      let colors = null;
+      if (randomize) {
+        colors = {};
+        // left, right, back, floor, ceiling, plus tint for the mirror and glass spheres
+        for (const i of [0, 1, 2, 4, 5]) colors[i] = randomColor();
+        for (const i of [6, 7]) colors[i] = randomColor().map(v => 0.5 + v * 0.49);
+      }
+      worker.postMessage({ colors });
+    }
+
+    worker.onmessage = (e) => {
+      const { w, h, pixels } = e.data;
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(pixels.buffer), w, h), 0, 0);
+      status.textContent = `Rendered in ${((performance.now() - started) / 1000).toFixed(1)}s`;
+      button.disabled = false;
+    };
+    button.addEventListener('click', () => run(true));
+    run(false);
+  </script>
+
