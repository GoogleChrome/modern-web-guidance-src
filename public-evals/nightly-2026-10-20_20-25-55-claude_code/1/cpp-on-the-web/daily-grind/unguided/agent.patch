new file mode 100644
index 0000000..9f5931a
--- /dev/null
+++ b/smallpt/worker.js
@@ -0,0 +1,15 @@
+importScripts('smallpt.js');
+const W = 512, H = 384, SPP = 64;
+const ready = createSmallpt();
+
+// Sphere indices in the scene: 0 left, 1 right, 2 back, 4 floor, 5 ceiling, 6 mirror, 7 glass
+onmessage = async (e) => {
+  const m = await ready;
+  const colors = e.data.colors; // {index: [r,g,b]} in 0..1, or null for the original scene
+  if (colors) for (const i in colors) m._set_color(+i, ...colors[i]);
+  const ptr = m._malloc(W * H * 4);
+  m._render(W, H, SPP, ptr);
+  const pixels = m.HEAPU8.slice(ptr, ptr + W * H * 4);
+  m._free(ptr);
+  postMessage({ w: W, h: H, pixels }, [pixels.buffer]);
+};
