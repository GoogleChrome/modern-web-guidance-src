+#!/bin/sh
+# Builds smallpt.js + smallpt.wasm into the repo root (requires Emscripten).
+cd "$(dirname "$0")/.." && em++ -O3 smallpt/smallpt.cpp -o smallpt.js \
+  -sEXPORT_ES6 -sENVIRONMENT=worker -sALLOW_MEMORY_GROWTH \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8 -sEXPORTED_FUNCTIONS=_render,_set_color,_width,_height
