diff --git a/public/smallpt/worker.js b/public/smallpt/worker.js
new file mode 100644
index 0000000..609a279
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,13 @@
+// Runs the smallpt WebAssembly module off the main thread.
+importScripts("smallpt.js");
+const ready = createSmallpt();
+
+onmessage = async ({ data: { w, h, spp, colors } }) => {
+  const m = await ready;
+  colors.forEach(([i, r, g, b]) => m._set_color(i, r, g, b));
+  const t0 = performance.now();
+  const ptr = m._render(w, h, spp);
+  const pixels = m.HEAPU8.slice(ptr, ptr + w * h * 4);
+  m._free_buffer(ptr);
+  postMessage({ w, h, pixels, ms: performance.now() - t0 }, [pixels.buffer]);
+};
