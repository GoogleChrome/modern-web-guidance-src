+        </p>
+        <canvas id="smallpt-canvas" width="512" height="384" class="mx-auto w-full max-w-[512px] bg-black border border-gray-300"></canvas>
+        <div class="mt-3">
+            <button id="smallpt-run" type="button" class="px-4 py-2 bg-gray-900 text-white font-bold rounded hover:bg-amber-500 disabled:opacity-50">Render with random colors</button>
+            <span id="smallpt-status" class="ml-3 text-sm text-gray-600"></span>
+        </div>
+    </section>
+
+    <script define:vars={{ workerUrl: `${import.meta.env.BASE_URL}smallpt/worker.js`.replace(/\/+/g, "/") }}>
+        const canvas = document.getElementById("smallpt-canvas");
+        const button = document.getElementById("smallpt-run");
+        const status = document.getElementById("smallpt-status");
+        const ctx = canvas.getContext("2d");
+        const worker = new Worker(workerUrl);
+
+        // Sphere indices in smallpt's scene: 0 left, 1 right, 2 back, 4 bottom, 5 top, 6 mirror, 7 glass.
+        const hsl = (h, s, l) => {
+            const a = s * Math.min(l, 1 - l);
+            const f = (n) => { const k = (n + h / 30) % 12; return l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)); };
+            return [f(0), f(8), f(4)];
+        };
+        const randomColors = () => [0, 1, 2, 4, 5].map((i) => [i, ...hsl(Math.random() * 360, 0.5 + Math.random() * 0.4, 0.3 + Math.random() * 0.25)])
+            .concat([6, 7].map((i) => [i, ...hsl(Math.random() * 360, 0.15 + Math.random() * 0.3, 0.85)]));
+        const defaults = [[0, .75, .25, .25], [1, .25, .25, .75], [2, .75, .75, .75], [4, .75, .75, .75], [5, .75, .75, .75], [6, .999, .999, .999], [7, .999, .999, .999]];
+
+        const run = (colors) => {
+            button.disabled = true;
+            status.textContent = "Rendering…";
+            worker.postMessage({ w: canvas.width, h: canvas.height, spp: 200, colors });
+        };
+        worker.onmessage = ({ data: { w, h, pixels, ms } }) => {
