diff --git a/public/smallpt/worker.js b/public/smallpt/worker.js
new file mode 100644
index 0000000..1aeff40
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,18 @@
+import createModule from "./smallpt.js";
+
+const W = 640, H = 480, SPP = 32;
+const modulePromise = createModule();
+
+// msg.colors: [[sphereIndex, r, g, b], ...]
+self.onmessage = async ({ data }) => {
+  try {
+    const m = await modulePromise;
+    for (const [i, r, g, b] of data.colors) m._set_color(i, r, g, b);
+    const ptr = m._render(W, H, SPP);
+    // Copy out of the wasm heap (it may grow/move) and transfer to the page.
+    const pixels = m.HEAPU8.slice(ptr, ptr + W * H * 4);
+    self.postMessage({ width: W, height: H, pixels }, [pixels.buffer]);
+  } catch (error) {
+    self.postMessage({ error: String(error) });
+  }
+};
