diff --git a/public/smallpt/index.html b/public/smallpt/index.html
new file mode 100644
index 0000000..bb02b68
--- /dev/null
+++ b/public/smallpt/index.html
@@ -0,0 +1,65 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>smallpt in WebAssembly</title>
+  <style>
+    :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
+    body { max-width: 52rem; margin: 2rem auto; padding: 0 1rem; text-align: center; }
+    canvas { width: 100%; height: auto; aspect-ratio: 4 / 3; background: #111; border-radius: .5rem; }
+    button { font: inherit; padding: .6rem 1.2rem; margin: 1rem 0; cursor: pointer; }
+    button:disabled { cursor: progress; }
+    p { margin: 0; }
+  </style>
+</head>
+<body>
+  <h1>smallpt in WebAssembly</h1>
+  <p><a href="http://www.kevinbeason.com/smallpt/">smallpt</a> by Kevin Beason, a 99-line C++ path tracer, compiled with Emscripten and rendered client-side.</p>
+  <canvas id="canvas" width="640" height="480" role="img" aria-label="Path-traced Cornell box scene with a mirror sphere and a glass sphere"></canvas>
+  <div><button id="rerun" type="button" disabled>Render with random colors</button></div>
+  <p id="status" role="status" aria-live="polite"></p>
+
+  <script type="module">
+    const canvas = document.getElementById("canvas");
+    const ctx = canvas.getContext("2d");
+    const button = document.getElementById("rerun");
+    const status = document.getElementById("status");
+    const worker = new Worker("./worker.js", { type: "module" });
+    let started = 0;
+
+    // Sphere indices in smallpt's scene: 0 left wall, 1 right wall, 6 mirror, 7 glass.
+    const rand = (lo, hi) => lo + Math.random() * (hi - lo);
+    const color = (lo, hi) => [rand(lo, hi), rand(lo, hi), rand(lo, hi)];
+    const randomColors = () => [
+      [0, ...color(.1, .85)],
+      [1, ...color(.1, .85)],
+      [6, ...color(.6, .999)],
+      [7, ...color(.6, .999)],
+    ];
+    // The original scene's colors.
+    const originalColors = [
+      [0, .75, .25, .25], [1, .25, .25, .75],
+      [6, .999, .999, .999], [7, .999, .999, .999],
+    ];
+
+    function render(colors) {
+      button.disabled = true;
+      status.textContent = "Rendering…";
+      started = performance.now();
+      worker.postMessage({ colors });
+    }
+
+    worker.onmessage = ({ data }) => {
+      button.disabled = false;
+      if (data.error) { status.textContent = `Error: ${data.error}`; return; }
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), data.width, data.height), 0, 0);
+      status.textContent = `Rendered in ${((performance.now() - started) / 1000).toFixed(1)} s`;
+    };
+    worker.onerror = () => { button.disabled = false; status.textContent = "Worker failed to load."; };
+
+    button.addEventListener("click", () => render(randomColors()));
+    render(originalColors);
+  </script>
+</body>
+</html>
