+  <script type="module">
+    // Load polyfills only in browsers lacking native support. Top-level await
+    // keeps this a single entry module (avoids the Safari multi-importer bug).
+    if (!('popover' in HTMLElement.prototype)) {
+      await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      await import('https://esm.run/invokers-polyfill');
+    }
+
+    // The invokers polyfill doesn't manage ARIA state, so sync aria-expanded.
+    const popover = document.getElementById('rewards-popover');
+    const trigger = document.querySelector('[commandfor="rewards-popover"]');
+    popover.addEventListener('toggle', (e) => {
+      trigger.setAttribute('aria-expanded', e.newState === 'open');
+    });
+  </script>
+
