+    /* Layout with sidebar */
+    .layout {
+      display: grid;
+      grid-template-columns: 240px 1fr;
+      gap: 30px;
+      align-items: start;
+    }
+
+    @media (max-width: 700px) {
+      .layout {
+        grid-template-columns: 1fr;
+      }
+    }
+
+    .sidebar {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .sidebar h3 {
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    /* Coupon button: a plain <button>, so it is fully stylable */
+    .coupon-btn {
+      font: inherit;
+      font-weight: 600;
+      width: 100%;
+      background: var(--accent);
+      color: var(--text);
+      border: 2px solid var(--primary);
+      padding: 10px 20px;
+      border-radius: 5px;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    .coupon-btn:hover:not(:disabled) {
+      background: #ff9100;
+    }
+
+    .coupon-btn:disabled {
+      opacity: 0.6;
+      cursor: default;
+    }
+
+    /* Box styling only applies once revealed: a hidden="until-found" element
+       still renders its border/padding while its content is hidden. */
+    #coupon-panel:not([hidden]) {
+      background: white;
+      border: 2px dashed var(--accent);
+      border-radius: 8px;
+      padding: 20px;
+      margin-bottom: 30px;
+      text-align: center;
+    }
+
+    #coupon-panel .coupon-code {
+      font-size: 1.8rem;
+      font-weight: bold;
+      letter-spacing: 3px;
+      color: var(--primary);
+    }
+
+    /* Wholesale / catering tabs: <details> elements sharing a name are
+       mutually exclusive, and closed content stays find-in-page searchable. */
+    .wholesale-tabs {
+      margin-top: 40px;
+    }
+
+    .wholesale-tab {
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      margin-top: 10px;
+    }
+
+    .wholesale-tab summary {
+      cursor: pointer;
+      padding: 12px 20px;
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .wholesale-tab[open] summary {
+      background: var(--primary);
+      color: white;
+      border-radius: 7px 7px 0 0;
+    }
+
+    .wholesale-tab .tab-body {
+      padding: 20px;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
