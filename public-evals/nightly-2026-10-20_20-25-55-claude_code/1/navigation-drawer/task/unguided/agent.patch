+    /* Drawer: a full-viewport modal <dialog> that is also a horizontal
+       scroll-snap container. Swiping the panel left scrolls it out of view
+       natively; reaching the end closes the dialog. */
+    .drawer {
+      --drawer-width: min(20rem, 85vw);
+      border: 0;
+      padding: 0;
+      margin: 0;
+      width: 100vw;
+      max-width: none;
+      height: 100dvh;
+      max-height: none;
+      background: transparent;
+      color: white;
+      overflow-x: auto;
+      overflow-y: hidden;
+      overscroll-behavior: contain;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      transition: opacity 0.25s;
+    }
+
+    .drawer[open] {
+      display: flex;
+    }
+
+    .drawer::-webkit-scrollbar {
+      display: none;
+    }
+
+    .drawer::backdrop {
+      background: transparent;
+    }
+
+    @starting-style {
+      .drawer[open] {
+        opacity: 0;
+      }
+    }
+
+    .drawer-panel {
+      flex: none;
+      width: var(--drawer-width);
+      height: 100%;
+      overflow-y: auto;
+      background: var(--primary);
+      padding: 1rem 1.5rem 2rem;
+      scroll-snap-align: start;
+      scroll-snap-stop: always;
+      box-shadow: 4px 0 16px rgba(0, 0, 0, 0.4);
+    }
+
+    /* Tapping this area (the "backdrop") closes the drawer. */
+    .drawer-dismiss {
+      flex: none;
+      width: 100vw;
+      height: 100%;
+      background: rgba(0, 0, 0, 0.5);
+      scroll-snap-align: end;
+    }
+
+    .drawer-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      margin-bottom: 1.5rem;
+    }
+
+    .drawer-panel ul {
+      list-style: none;
+      display: flex;
+      flex-direction: column;
+      gap: 0.5rem;
+    }
+
+    .drawer-panel li a {
+      display: block;
+      padding: 0.75rem 0;
+      font-size: 1.1rem;
+    }
+
+    .drawer-panel li a.logout-link {
+      display: inline-block;
+      margin-top: 1rem;
+      padding: 8px 16px;
+    }
+
+    body:has(.drawer[open]) {
+      overflow: hidden;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .drawer {
+        scroll-behavior: smooth;
+      }
+    }
