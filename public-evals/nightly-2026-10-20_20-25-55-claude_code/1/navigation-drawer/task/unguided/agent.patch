+  <script>
+    const drawer = document.getElementById('site-drawer');
+    const maxScroll = () => drawer.scrollWidth - drawer.clientWidth;
+    const isClosedPosition = () => drawer.scrollLeft >= maxScroll() - 1;
+    const hasScrollEnd = 'onscrollend' in window;
+    let fallbackTimer;
+
+    // Scroll the panel out of view, then close; used for every non-swipe dismissal.
+    function dismiss() {
+      if (isClosedPosition()) return drawer.close();
+      drawer.scrollTo({ left: maxScroll() });
+      // With reduced motion the scroll is instant and may not emit scrollend.
+      if (isClosedPosition()) drawer.close();
+    }
+
+    // Escape, the Android back gesture and the close button all fire "cancel".
+    drawer.addEventListener('cancel', (e) => {
+      e.preventDefault();
+      dismiss();
+    });
+
+    // Tapping the dimmed area outside the panel.
+    drawer.addEventListener('click', (e) => {
+      if (e.target === drawer || e.target.classList.contains('drawer-dismiss')) dismiss();
+    });
+
+    // Native swipe: once scrolling settles on the closed snap point, close.
+    const onSettled = () => { if (isClosedPosition()) drawer.close(); };
+    if (hasScrollEnd) {
+      drawer.addEventListener('scrollend', onSettled);
+    } else {
+      drawer.addEventListener('scroll', () => {
+        clearTimeout(fallbackTimer);
+        fallbackTimer = setTimeout(onSettled, 120);
+      });
+    }
+
+    drawer.addEventListener('close', () => { drawer.scrollLeft = 0; });
+  </script>
+
