+  <script>
+    const list = document.getElementById('bean-list');
+    const form = document.getElementById('bean-form');
+    const nameInput = document.getElementById('bean-name');
+    let nextId = list.children.length + 1;
+
+    // Progressive enhancement: fall back to an immediate update without View Transitions
+    function update(change) {
+      if (document.startViewTransition) {
+        document.startViewTransition(change);
+      } else {
+        change();
+      }
+    }
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const name = nameInput.value.trim() || `Custom Bean ${nextId}`;
+      const li = document.createElement('li');
+      li.className = 'item';
+      li.style.viewTransitionName = `bean-${nextId++}`;
+      const label = document.createElement('span');
+      label.textContent = name;
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.textContent = 'Remove';
+      li.append(label, remove);
+      nameInput.value = '';
+      update(() => list.append(li));
+    });
+
+    list.addEventListener('click', (e) => {
+      const item = e.target.closest('.item');
+      if (e.target.matches('button') && item) {
+        update(() => item.remove());
+      }
+    });
+  </script>
