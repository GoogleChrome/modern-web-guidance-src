+  <script>
+    const list = document.getElementById('bean-list');
+    const form = document.getElementById('bean-form');
+    const nameInput = document.getElementById('bean-name');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let nextId = 0;
+
+    // Give every item a unique view-transition-name so the browser can track it
+    function register(item) {
+      item.style.viewTransitionName = `bean-item-${nextId++}`;
+    }
+
+    function update(change) {
+      if (!document.startViewTransition || reducedMotion.matches) {
+        change();
+        return;
+      }
+      document.startViewTransition(change);
+    }
+
+    function createItem(name) {
+      const item = document.createElement('li');
+      item.className = 'item';
+      const label = document.createElement('span');
+      label.textContent = name;
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.setAttribute('aria-label', `Remove ${name}`);
+      remove.innerHTML = '&times;';
+      item.append(label, remove);
+      register(item);
+      return item;
+    }
+
+    list.querySelectorAll('.item').forEach(register);
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const name = nameInput.value.trim() || 'Custom Blend';
+      update(() => list.append(createItem(name)));
+      nameInput.value = '';
+    });
+
+    list.addEventListener('click', (e) => {
+      const item = e.target.closest('.item');
+      if (e.target.closest('button') && item) update(() => item.remove());
+    });
+  </script>
+
