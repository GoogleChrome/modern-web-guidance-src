       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Info tooltip */
+    .card-actions {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 8px;
+    }
+
+    .info-btn {
+      width: 2rem;
+      height: 2rem;
+      margin-top: 15px;
+      border: 1px solid var(--primary);
+      border-radius: 50%;
+      background: white;
+      color: var(--primary);
+      font: bold 1rem/1 inherit;
+      cursor: pointer;
+    }
+
+    .info-btn:hover,
+    .info-btn:focus-visible {
+      background: var(--secondary);
+    }
+
+    #tooltip {
+      /* Frame the popover without UA styles so the inner wrapper owns the visuals */
+      border: 0;
+      background: none;
+      padding: 0;
+      overflow: visible;
+      color: inherit;
+    }
+
+    @supports (anchor-name: --a) {
+      #tooltip {
+        inset: auto;
+        margin: unset;
+        position: fixed;
+        position-area: block-start;
+        position-try-fallbacks: flip-block;
+        container-type: anchored;
+      }
+    }
+
+    .tooltip-content {
+      position: relative;
+      width: max-content;
+      max-width: 16rem;
+      padding: 0.5rem 0.75rem;
+      margin-block-end: 0.5rem; /* room for the arrow above the trigger */
+      background: var(--primary);
+      color: white;
+      font-size: 0.85rem;
+      border-radius: 0.5rem;
+    }
+
+    @supports (container-type: anchored) {
+      .tooltip-content::before {
+        /* Default: tooltip sits above the trigger, arrow points down */
+        content: "";
+        position: absolute;
+        inset-block-end: -0.4rem;
+        inset-inline-start: 50%;
+        translate: -50% 0;
+        border-inline: 0.4rem solid transparent;
+        border-block-start: 0.4rem solid var(--primary);
+      }
+
+      /* Flipped below the trigger: arrow points up, square off the top corners */
+      @container anchored(fallback: flip-block) {
+        .tooltip-content {
+          border-radius: 0 0 0.5rem 0.5rem;
+          margin-block-end: 0;
+          margin-block-start: 0.5rem;
+        }
+
+        .tooltip-content::before {
+          inset-block-end: auto;
+          inset-block-start: -0.4rem;
+          border-block-start: 0;
+          border-block-end: 0.4rem solid var(--primary);
+        }
+      }
+    }
   </style>
