+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbs = Array.from(document.querySelectorAll('.thumbnail'));
+      const hasScrollEnd = 'onscrollend' in window;
+      let lastLeft = gallery.scrollLeft;
+      let fallbackTimer;
+
+      // Fractional position: 1.0 = exactly on item 1, 1.4 = 40% of the way to item 2.
+      function position() {
+        return gallery.scrollLeft / gallery.clientWidth;
+      }
+
+      function clamp(i) {
+        return Math.max(0, Math.min(items.length - 1, i));
+      }
+
+      function setPending(index) {
+        thumbs.forEach((t, i) => t.classList.toggle('pending', i === index));
+      }
+
+      function setActive(index) {
+        thumbs.forEach((t, i) => {
+          t.classList.remove('pending');
+          t.classList.toggle('active', i === index);
+          if (i === index) t.setAttribute('aria-current', 'true');
+          else t.removeAttribute('aria-current');
+        });
+      }
+
+      function onScroll() {
+        const left = gallery.scrollLeft;
+        const pos = position();
+        const movingRight = left > lastLeft;
+        lastLeft = left;
+
+        // Mid-scroll: the item being swiped towards is the next one in the direction of travel.
+        const target = clamp(movingRight ? Math.ceil(pos - 0.001) : Math.floor(pos + 0.001));
+        setPending(target);
+
+        if (!hasScrollEnd) {
+          clearTimeout(fallbackTimer);
+          fallbackTimer = setTimeout(onScrollEnd, 120);
+        }
+      }
+
+      function onScrollEnd() {
+        setActive(clamp(Math.round(position())));
+      }
+
+      gallery.addEventListener('scroll', onScroll, { passive: true });
+      if (hasScrollEnd) gallery.addEventListener('scrollend', onScrollEnd);
+
+      thumbs.forEach((thumb, i) => {
+        thumb.addEventListener('click', () => {
+          items[i].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
+        });
+      });
+
+      setActive(clamp(Math.round(position())));
+    })();
+  </script>
+
