+  <script>
+    (function () {
+      const TOTAL = 1000;
+      const WORK_MS = 2;     // approximate cost of one blend
+      const SLICE_MS = 50;   // max time to hold the main thread before yielding
+
+      const startBtn = document.getElementById('start-btn');
+      const output = document.getElementById('output');
+
+      // Simulates scoring one blend (~2ms of synchronous work).
+      function processBlend(index) {
+        const end = performance.now() + WORK_MS;
+        let score = index;
+        while (performance.now() < end) {
+          score = (score * 31 + 7) % 9973;
+        }
+        return score;
+      }
+
+      function yieldToBrowser() {
+        if (globalThis.scheduler && typeof scheduler.yield === 'function') {
+          return scheduler.yield();
+        }
+        return new Promise(resolve => setTimeout(resolve, 0));
+      }
+
+      async function runSimulation() {
+        startBtn.disabled = true;
+        output.textContent = 'Processing...';
+
+        let sliceStart = performance.now();
+        for (let i = 0; i < TOTAL; i++) {
+          processBlend(i);
+
+          if (performance.now() - sliceStart >= SLICE_MS) {
+            output.textContent = 'Processed ' + (i + 1) + ' of ' + TOTAL + '...';
+            await yieldToBrowser();
+            sliceStart = performance.now();
+          }
+        }
+
+        output.textContent = 'Done! All items processed.';
+        startBtn.disabled = false;
+      }
+
+      startBtn.addEventListener('click', runSimulation);
+    })();
+  </script>
 </body>
 
