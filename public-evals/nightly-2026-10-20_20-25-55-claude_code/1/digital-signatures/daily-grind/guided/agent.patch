+  <script type="module">
+    const CONTEXT = new TextEncoder().encode('daily-grind-receipt-v1');
+    const ML_DSA_PUBLIC_KEY_ALGORITHMS = { 1312: 'ML-DSA-44', 1952: 'ML-DSA-65', 2592: 'ML-DSA-87' };
+
+    const $ = (id) => document.getElementById(id);
+    const enc = new TextEncoder();
+    const toHex = (b) => Array.from(b, (x) => x.toString(16).padStart(2, '0')).join('');
+    const fromHex = (h) => {
+      const clean = h.replace(/\s+/g, '');
+      if (!/^([0-9a-f]{2})*$/i.test(clean)) throw new Error('Not valid hex.');
+      return Uint8Array.from(clean.match(/../g) ?? [], (x) => parseInt(x, 16));
+    };
+
+    const pq = typeof globalThis.SubtleCrypto?.supports === 'function' &&
+      SubtleCrypto.supports('sign', 'ML-DSA-65');
+    $('sig-suite').textContent = pq
+      ? 'Algorithm: ML-DSA-65 (post-quantum)'
+      : 'Algorithm: Ed25519 (classical fallback; this browser lacks ML-DSA)';
+
+    // Classical algorithms ignore `context`, so frame it into the payload instead.
+    const frame = (payload) => {
+      const out = new Uint8Array(1 + CONTEXT.length + payload.length);
+      out[0] = CONTEXT.length;
+      out.set(CONTEXT, 1);
+      out.set(payload, 1 + CONTEXT.length);
+      return out;
+    };
+
+    let privateKey = null;
+
+    const setStatus = (text, state = '') => {
+      const el = $('sig-status');
+      el.textContent = text;
+      if (state) el.dataset.state = state; else delete el.dataset.state;
+    };
+
+    async function generate() {
+      const name = pq ? 'ML-DSA-65' : 'Ed25519';
+      const pair = await crypto.subtle.generateKey(name, false, ['sign', 'verify']);
+      privateKey = pair.privateKey;
+      const pub = new Uint8Array(await crypto.subtle.exportKey(pq ? 'raw-public' : 'raw', pair.publicKey));
+      $('sig-pub').value = toHex(pub);
+      $('sig-value').value = '';
+      $('btn-sign').disabled = false;
+      setStatus(`New ${name} key pair created (${pub.length}-byte public key). The private key is non-extractable.`);
+    }
+
+    async function sign() {
+      const payload = enc.encode($('sig-message').value);
+      const sig = pq
+        ? await crypto.subtle.sign({ name: 'ML-DSA-65', context: CONTEXT }, privateKey, payload)
+        : await crypto.subtle.sign('Ed25519', privateKey, frame(payload));
+      $('sig-value').value = toHex(new Uint8Array(sig));
+      setStatus(`Signed. Signature is ${sig.byteLength} bytes.`);
+    }
+
+    async function verify() {
+      let pubBytes, sigBytes;
+      try {
+        pubBytes = fromHex($('sig-pub').value);
+        sigBytes = fromHex($('sig-value').value);
+      } catch (e) {
+        return setStatus(e.message, 'bad');
+      }
+      if (!pubBytes.length || !sigBytes.length) {
+        return setStatus('Provide a public key and a signature first.', 'bad');
+      }
+      const payload = enc.encode($('sig-message').value);
+      const mlName = ML_DSA_PUBLIC_KEY_ALGORITHMS[pubBytes.length];
+      let ok;
+      try {
+        if (mlName) {
+          const key = await crypto.subtle.importKey('raw-public', pubBytes, mlName, true, ['verify']);
+          ok = await crypto.subtle.verify({ name: mlName, context: CONTEXT }, key, sigBytes, payload);
+        } else {
+          const key = await crypto.subtle.importKey('raw', pubBytes, 'Ed25519', true, ['verify']);
+          ok = await crypto.subtle.verify('Ed25519', key, sigBytes, frame(payload));
+        }
+      } catch {
+        return setStatus('This browser cannot use that public key.', 'bad');
+      }
+      setStatus(
+        ok ? 'Valid: the message is authentic and unmodified.' : 'Invalid: the message or signature was altered, or the key does not match.',
+        ok ? 'ok' : 'bad',
+      );
+    }
+
+    const run = (fn) => () => fn().catch((e) => setStatus(`Error: ${e.message}`, 'bad'));
+    $('btn-keygen').addEventListener('click', run(generate));
+    $('btn-sign').addEventListener('click', run(sign));
+    $('btn-verify').addEventListener('click', run(verify));
+    $('signer').addEventListener('submit', (e) => e.preventDefault());
+  </script>
