+  <script>
+    // Dates use the visitor's local time zone (local-time Date constructor).
+    // Months are zero-indexed: 2 = March.
+    // PROMO_START is a placeholder; set it to the real launch date.
+    (function () {
+      var PROMO_START = new Date(2025, 8, 1, 0, 0, 0); // Sep 1, 2025 00:00 local
+      var PROMO_END = new Date(2026, 2, 1, 0, 0, 0);   // Mar 1, 2026 00:00 local
+
+      var root = document.getElementById('maple-timer');
+      var remainingEl = root.querySelector('.promo-remaining');
+      var elapsedEl = root.querySelector('.promo-elapsed');
+
+      function plural(n, unit) {
+        return n + ' ' + unit + (n === 1 ? '' : 's');
+      }
+
+      function format(ms) {
+        var totalHours = Math.floor(ms / 3600000);
+        return plural(Math.floor(totalHours / 24), 'day') + ', ' +
+               plural(totalHours % 24, 'hour');
+      }
+
+      var now = new Date();
+
+      if (now >= PROMO_END) {
+        remainingEl.textContent = 'This offer has ended.';
+      } else {
+        remainingEl.textContent = format(PROMO_END - now) + ' left';
+      }
+
+      if (now >= PROMO_START) {
+        var since = Math.min(now, PROMO_END) - PROMO_START;
+        elapsedEl.textContent = 'Started ' + format(since) + ' ago';
+      } else {
+        elapsedEl.textContent = 'Starts ' + format(PROMO_START - now) + ' from now';
+      }
+    })();
+  </script>
+
