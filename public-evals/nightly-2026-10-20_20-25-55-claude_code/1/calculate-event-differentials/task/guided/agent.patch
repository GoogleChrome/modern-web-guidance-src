+  <script type="module">
+    // Temporal is not yet in Safari, so load the polyfill when it's missing.
+    if (typeof Temporal === 'undefined') {
+      const { Temporal: T } = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = T;
+    }
+
+    const fmt = (duration) => {
+      const part = (unit, value) =>
+        new Intl.NumberFormat(undefined, { style: 'unit', unit, unitDisplay: 'long' }).format(value);
+      return `${part('day', duration.days)}, ${part('hour', duration.hours)}`;
+    };
+
+    // Dates are midnight (start of day) in the visitor's local time zone.
+    const now = Temporal.Now.zonedDateTimeISO();
+    const atMidnight = (date) =>
+      Temporal.PlainDate.from(date).toZonedDateTime({ timeZone: now.timeZoneId });
+    const opts = { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'floor' };
+
+    for (const el of document.querySelectorAll('.promo-timer')) {
+      const start = atMidnight(el.dataset.start);
+      const end = atMidnight(el.dataset.end);
+      const remaining = el.querySelector('[data-remaining]');
+      const elapsed = el.querySelector('[data-elapsed]');
+
+      if (Temporal.ZonedDateTime.compare(now, end) >= 0) {
+        remaining.textContent = 'This offer has ended.';
+        elapsed.textContent = `Ran for ${fmt(end.since(start, opts))}`;
+      } else if (Temporal.ZonedDateTime.compare(now, start) < 0) {
+        remaining.textContent = `Starts in ${fmt(now.until(start, opts))}`;
+        elapsed.textContent = '';
+      } else {
+        remaining.textContent = `Offer ends in ${fmt(now.until(end, opts))}`;
+        elapsed.textContent = `Started ${fmt(now.since(start, opts))} ago`;
+      }
+    }
+  </script>
+
 </body>
 
