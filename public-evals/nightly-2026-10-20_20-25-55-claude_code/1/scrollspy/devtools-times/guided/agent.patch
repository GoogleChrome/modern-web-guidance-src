diff --git a/src/layouts/LegalLayout.astro b/src/layouts/LegalLayout.astro
index 0baf98a..c4f03a2 100644
--- a/src/layouts/LegalLayout.astro
+++ b/src/layouts/LegalLayout.astro
@@ -3,15 +3,77 @@ import Layout from './Layout.astro';
 
 export interface Props {
 	title: string;
+	sections?: { id: string; label: string }[];
 }
 
-const { title } = Astro.props;
+const { title, sections = [] } = Astro.props;
 ---
 <Layout title={title}>
     <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
         <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 pb-2 border-b-2">{title}</h1>
+        {sections.length > 0 && (
+            <nav id="section-nav" aria-label="On this page" class="section-nav sticky top-0 z-10 bg-white/95 mb-6 py-2 border-b border-gray-200">
+                <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
+                    {sections.map(({ id, label }) => (
+                        <li><a href={`#${id}`} class="inline-block py-1 border-b-2 border-transparent text-gray-600 hover:text-gray-900">{label}</a></li>
+                    ))}
+                </ul>
+            </nav>
+        )}
         <div class="prose max-w-none">
             <slot />
         </div>
     </div>
 </Layout>
+
+<style is:global>
+    .section-nav {
+        scroll-target-group: auto;
+    }
+    /* :is() keeps the rule valid in browsers that don't know :target-current */
+    .section-nav a:is(:target-current, .\:target-current) {
+        color: #111827;
+        font-weight: 700;
+        border-bottom-color: #f59e0b;
+    }
+    html {
+        scroll-padding-top: 4rem;
+    }
+</style>
+
+<script>
+    const links = document.querySelectorAll<HTMLAnchorElement>('#section-nav a');
+
+    if (links.length) {
+        const setCurrent = (current: Element | null | undefined) => {
+            links.forEach((link) => {
+                link.setAttribute('aria-current', String(link === current));
+                if (!CSS.supports('scroll-target-group: auto')) {
+                    link.classList.toggle(':target-current', link === current);
+                }
+            });
+        };
+
+        if (CSS.supports('scroll-target-group: auto')) {
+            const sync = () => setCurrent(document.querySelector('#section-nav a:target-current'));
+            sync();
+            document.addEventListener('scrollend', sync);
+        } else {
+            const byId = new Map(
+                [...links].map((link) => [link.hash.slice(1), link] as const),
+            );
+            const observer = new IntersectionObserver(
+                (entries) => {
+                    for (const entry of entries) {
+                        if (entry.isIntersecting) setCurrent(byId.get(entry.target.id));
+                    }
+                },
+                { rootMargin: '-20% 0px -70% 0px', threshold: 0 },
+            );
+            byId.forEach((_, id) => {
+                const target = document.getElementById(id);
+                if (target) observer.observe(target);
+            });
+        }
+    }
+</script>
