+    /* Switch */
+    .switch-row {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 20px;
+      max-width: 600px;
+      margin: 40px auto 0;
+      padding: 20px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .switch-label {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .switch-desc {
+      font-size: 0.9rem;
+    }
+
+    .switch {
+      flex-shrink: 0;
+      position: relative;
+      width: 52px;
+      height: 32px;
+      border: 2px solid var(--primary);
+      border-radius: 16px;
+      background: white;
+      cursor: pointer;
+      transition: background 0.2s;
+    }
+
+    .switch::before {
+      content: "";
+      position: absolute;
+      top: 4px;
+      left: 4px;
+      width: 20px;
+      height: 20px;
+      border-radius: 50%;
+      background: var(--primary);
+      transition: transform 0.2s, background 0.2s;
+    }
+
+    .switch[aria-checked="true"] {
+      background: var(--primary);
+    }
+
+    .switch[aria-checked="true"]::before {
+      background: white;
+      transform: translateX(20px);
+    }
+
+    .switch:focus-visible {
+      outline: 3px solid var(--text);
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .switch,
+      .switch::before {
+        transition: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .switch {
+        border-color: ButtonText;
+        background: ButtonFace;
+      }
+
+      .switch::before {
+        background: ButtonText;
+      }
+
+      .switch[aria-checked="true"] {
+        background: Highlight;
+      }
+
+      .switch[aria-checked="true"]::before {
+        background: HighlightText;
+      }
+    }
+
