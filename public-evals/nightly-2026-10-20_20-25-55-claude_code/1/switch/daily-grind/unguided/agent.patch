+  <script>
+    const notifySwitch = document.getElementById('notify-switch');
+    const notifyStatus = document.getElementById('notify-status');
+    notifySwitch.addEventListener('click', () => {
+      const on = notifySwitch.getAttribute('aria-checked') !== 'true';
+      notifySwitch.setAttribute('aria-checked', String(on));
+      notifyStatus.textContent = on ? 'Seasonal drop alerts on' : 'Seasonal drop alerts off';
+    });
