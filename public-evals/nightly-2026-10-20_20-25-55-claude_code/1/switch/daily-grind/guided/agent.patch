+
+    /* Switch */
+    .preference {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 12px;
+      margin-top: 30px;
+    }
+
+    .preference label {
+      cursor: pointer;
+    }
+
+    input[type="checkbox"][switch] {
+      accent-color: var(--primary);
+      margin: 0;
+      cursor: pointer;
+    }
+
+    input[type="checkbox"][switch]:focus-visible {
+      outline: 3px solid #ff8c00;
+      outline-offset: 4px;
+    }
+
+    /* Fallback for browsers without native switch support (set via script) */
+    input[type="checkbox"][switch].switch-fallback {
+      appearance: none;
+      position: relative;
+      width: 3rem;
+      height: 1.6rem;
+      border-radius: 1.6rem;
+      background: #757575;
+      transition: background 0.2s;
+    }
+
+    input[type="checkbox"][switch].switch-fallback::before {
+      content: "";
+      position: absolute;
+      top: 0.2rem;
+      left: 0.2rem;
+      width: 1.2rem;
+      height: 1.2rem;
+      border-radius: 50%;
+      background: white;
+      transition: translate 0.2s;
+    }
+
+    input[type="checkbox"][switch].switch-fallback:checked {
+      background: var(--primary);
+    }
+
+    input[type="checkbox"][switch].switch-fallback:checked::before {
+      translate: 1.4rem 0;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      input[type="checkbox"][switch].switch-fallback,
+      input[type="checkbox"][switch].switch-fallback::before {
+        transition: none;
+      }
+    }
   </style>
