+  <script>
+    // Event deadline tracker: state is an immutable Temporal.PlainDate;
+    // updates create a new instance via .add() and never mutate in place.
+    (function () {
+      // Minimal immutable fallback for browsers without Temporal.
+      class FallbackPlainDate {
+        constructor(ms) { this.ms = ms; }
+        static from(iso) { return new FallbackPlainDate(Date.parse(iso + 'T00:00:00Z')); }
+        add({ days = 0, weeks = 0 }) {
+          return new FallbackPlainDate(this.ms + (days + weeks * 7) * 86400000);
+        }
+        toString() { return new Date(this.ms).toISOString().slice(0, 10); }
+      }
+      const PlainDate = (window.Temporal && Temporal.PlainDate) || FallbackPlainDate;
+
+      const valueEl = document.getElementById('temporal-value');
+      const changedEl = document.getElementById('temporal-ref-changed');
+      const countEl = document.getElementById('temporal-render-count');
+      const btn = document.getElementById('extend-temporal-btn');
+
+      let deadline = PlainDate.from('2026-12-01');
+      let renderCount = 0;
+
+      function render() {
+        renderCount += 1;
+        valueEl.textContent = deadline.toString();
+        countEl.textContent = String(renderCount);
+      }
+
+      btn.addEventListener('click', function () {
+        const previous = deadline;
+        deadline = deadline.add({ weeks: 1 });
+        changedEl.textContent = deadline !== previous ? 'Yes' : 'No';
+        render();
+      });
+
+      render();
+    })();
+  </script>
 </body>
 
