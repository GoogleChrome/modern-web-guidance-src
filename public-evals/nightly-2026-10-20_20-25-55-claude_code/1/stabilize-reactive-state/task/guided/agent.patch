+  <script type="module">
+    // Native Temporal isn't in Safari yet; load the polyfill when missing.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const valueEl = document.getElementById('temporal-value');
+    const btn = document.getElementById('extend-temporal-btn');
+    const refChangedEl = document.getElementById('temporal-ref-changed');
+    const renderCountEl = document.getElementById('temporal-render-count');
+
+    // PlainDate: a calendar deadline that must read the same in every time zone.
+    let state = { deadline: Temporal.PlainDate.from('2026-12-01') };
+    let renderCount = 0;
+
+    function render(refChanged) {
+      renderCount++;
+      valueEl.textContent = state.deadline.toLocaleString('en-US', { dateStyle: 'long' });
+      refChangedEl.textContent = refChanged ? 'Yes' : 'No';
+      renderCountEl.textContent = String(renderCount);
+    }
+
+    btn.addEventListener('click', () => {
+      const prev = state;
+      // Temporal objects are immutable: add() returns a new instance, and state is replaced, not mutated.
+      state = { ...state, deadline: state.deadline.add({ days: 7 }) };
+      render(prev !== state);
+    });
+
+    render(false);
+  </script>
+
 </body>
 
