+  <script>
+    (function () {
+      const hoursInput = document.getElementById('hoursInput');
+      const minutesInput = document.getElementById('minutesInput');
+      const humanValue = document.getElementById('humanValue');
+      const locale = navigator.language;
+
+      function formatUnit(value, unit) {
+        return new Intl.NumberFormat(locale, { style: 'unit', unit, unitDisplay: 'long' }).format(value);
+      }
+
+      function format(duration) {
+        if (typeof Intl.DurationFormat !== 'undefined') {
+          return new Intl.DurationFormat(locale, { style: 'long' }).format(duration);
+        }
+        // Fallback: localized per-unit strings, skipping zero parts
+        const parts = [];
+        if (duration.hours) parts.push(formatUnit(duration.hours, 'hour'));
+        if (duration.minutes || !parts.length) parts.push(formatUnit(duration.minutes, 'minute'));
+        return new Intl.ListFormat(locale, { style: 'long', type: 'conjunction' }).format(parts);
+      }
+
+      function update() {
+        const hours = Math.max(0, Math.floor(Number(hoursInput.value)) || 0);
+        const minutes = Math.max(0, Math.floor(Number(minutesInput.value)) || 0);
+        const largestUnit = document.querySelector('input[name="largestUnit"]:checked').value;
+        const duration = Temporal.Duration.from({ hours, minutes }).round({ largestUnit });
+        humanValue.textContent = format(duration);
+      }
+
+      function init() {
+        document.querySelector('.steeping form').addEventListener('input', update);
+        update();
+      }
+
+      if (typeof Temporal === 'undefined') {
+        import('https://esm.sh/@js-temporal/polyfill').then((module) => {
+          globalThis.Temporal = module.Temporal;
+          init();
+        });
+      } else {
+        init();
+      }
+    })();
+  </script>
