+  <script>
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const humanValue = document.getElementById('humanValue');
+    const locale = navigator.language || document.documentElement.lang;
+
+    function formatUnit(value, unit) {
+      return new Intl.NumberFormat(locale, { style: 'unit', unit, unitDisplay: 'long' }).format(value);
+    }
+
+    function formatDuration(totalMinutes, largestUnit) {
+      const parts = [];
+      if (largestUnit === 'hours') {
+        const hours = Math.floor(totalMinutes / 60);
+        const minutes = totalMinutes % 60;
+        if (hours > 0) parts.push(formatUnit(hours, 'hour'));
+        if (minutes > 0) parts.push(formatUnit(minutes, 'minute'));
+      } else if (totalMinutes > 0) {
+        parts.push(formatUnit(totalMinutes, 'minute'));
+      }
+      if (parts.length === 0) parts.push(formatUnit(0, 'minute'));
+      return new Intl.ListFormat(locale, { style: 'long', type: 'unit' }).format(parts);
+    }
+
+    function parseNonNegative(input) {
+      const n = Math.floor(Number(input.value));
+      return Number.isFinite(n) && n > 0 ? n : 0;
+    }
+
+    function update() {
+      const totalMinutes = parseNonNegative(hoursInput) * 60 + parseNonNegative(minutesInput);
+      const largestUnit = document.querySelector('input[name="largestUnit"]:checked').value;
+      humanValue.textContent = formatDuration(totalMinutes, largestUnit);
+    }
+
+    hoursInput.addEventListener('input', update);
+    minutesInput.addEventListener('input', update);
+    document.querySelectorAll('input[name="largestUnit"]').forEach(r => r.addEventListener('change', update));
+    update();
+  </script>
 </body>
 
