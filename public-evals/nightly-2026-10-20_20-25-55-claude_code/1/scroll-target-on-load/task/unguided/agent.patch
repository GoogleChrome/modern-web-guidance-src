+    /* Vertical scroll container */
+    .media-scroll {
+      height: 480px;
+      overflow-y: auto;
+      position: relative; /* makes offsetTop of cards relative to the container */
+      scroll-behavior: auto; /* never animate the initial positioning */
+      display: flex;
+      flex-direction: column;
+      gap: 20px;
+      margin-top: 20px;
+      padding: 20px;
+      background: var(--secondary);
+      border-radius: 8px;
+    }
+
+    .media-card {
+      flex: none;
+      background: white;
+      border-radius: 8px;
+      overflow: hidden;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .media-card img {
+      display: block;
+      width: 100%;
+      height: 200px;
+      object-fit: cover;
+    }
+
+    .media-card-body {
+      padding: 16px 20px;
+    }
+
+    .media-card h3 {
+      color: var(--primary);
+    }
