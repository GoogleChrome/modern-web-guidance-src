--- a/index.html
+++ b/index.html
@@ -151,13 +151,120 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Promo alert: dismissed via a hidden popover toggled by the close button (no JS) */
+    :root {
+      interpolate-size: allow-keywords;
+    }
+
+    #promo-alert {
+      display: grid;
+      grid-template-rows: 1fr;
+      background: var(--accent);
+      color: var(--text);
+      transition: grid-template-rows 0.4s ease, opacity 0.4s ease, visibility 0s;
+    }
+
+    .promo-inner {
+      min-height: 0;
+      overflow: hidden;
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 1rem;
+    }
+
+    .promo-inner p {
+      padding: 0.6rem 0;
+      font-size: 0.9rem;
+    }
+
+    #alert-dismiss {
+      background: none;
+      border: 0;
+      font-size: 1.25rem;
+      line-height: 1;
+      cursor: pointer;
+      color: inherit;
+    }
+
+    #alert-dismissed {
+      position: fixed;
+      inset: auto;
+      width: 0;
+      height: 0;
+      padding: 0;
+      border: 0;
+      overflow: hidden;
+    }
+
+    body:has(#alert-dismissed:popover-open) #promo-alert {
+      grid-template-rows: 0fr;
+      opacity: 0;
+      visibility: hidden;
+      /* keep visible until the collapse finishes, then drop from the a11y tree */
+      transition: grid-template-rows 0.4s ease, opacity 0.4s ease, visibility 0s 0.4s;
+    }
+
+    /* FAQ accordion */
+    .faq {
+      max-width: 700px;
+      margin: 40px auto 0;
+    }
+
+    .faq details {
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    #faq-trigger {
+      cursor: pointer;
+      padding: 16px 20px;
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .faq details::details-content {
+      block-size: 0;
+      overflow: hidden;
+      opacity: 0;
+      transition: block-size 0.4s ease, opacity 0.4s ease, content-visibility 0.4s;
+      transition-behavior: allow-discrete;
+    }
+
+    .faq details[open]::details-content {
+      block-size: auto;
+      opacity: 1;
+    }
+
+    #faq-content {
+      padding: 0 20px 16px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #promo-alert,
+      body:has(#alert-dismissed:popover-open) #promo-alert,
+      .faq details::details-content {
+        transition-duration: 0.01s;
+        transition-delay: 0s;
+      }
+    }
   </style>
 </head>
 
