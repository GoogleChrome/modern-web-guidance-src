+  <script>
+    // Play the exit animation (via .closing), then run the actual close.
+    function animateOut(el, done) {
+      if (el.classList.contains('closing')) return;
+      el.classList.add('closing');
+      el.addEventListener('animationend', function handler(e) {
+        if (e.target !== el) return; // ignore ::backdrop-bubbled/child events
+        el.removeEventListener('animationend', handler);
+        el.classList.remove('closing');
+        done();
+      });
+    }
+
+    const dialog = document.getElementById('logout-dialog');
+    const closeDialog = () => animateOut(dialog, () => dialog.close());
+
+    document.getElementById('open-dialog-btn').addEventListener('click', (e) => {
+      e.preventDefault();
+      dialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+    // Click on the backdrop (the dialog element itself) dismisses
+    dialog.addEventListener('click', (e) => {
+      if (e.target === dialog) closeDialog();
+    });
+    // Escape: animate out instead of closing instantly
+    dialog.addEventListener('cancel', (e) => {
+      e.preventDefault();
+      closeDialog();
+    });
+
+    const overlay = document.getElementById('info-overlay');
+    document.getElementById('foobar').addEventListener('click', () => {
+      overlay.classList.remove('closing');
+      overlay.hidden = false;
+    });
+    document.getElementById('close-info-btn').addEventListener('click', () => {
+      animateOut(overlay, () => { overlay.hidden = true; });
+    });
+  </script>
