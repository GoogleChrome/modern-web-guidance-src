+  <dialog id="logout-dialog" class="modal" aria-labelledby="logout-title" closedby="any">
+    <h2 id="logout-title">Log out?</h2>
+    <p>Are you sure you want to log out of your account?</p>
+    <div class="modal-actions">
+      <button type="button" class="btn secondary" id="close-dialog-btn">Cancel</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <div id="offline-notice" class="notice" popover role="status">
+    <div class="notice-content">
+      <p>online ordering is currently offline</p>
+      <button type="button" class="notice-close" id="close-notice-btn" aria-label="Dismiss">&times;</button>
+    </div>
+  </div>
+
+  <script type="module">
+    if (!('popover' in HTMLElement.prototype)) {
+      import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) return false;
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    function supportsTopLayerExit() {
+      return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+    }
+
+    async function closeTopLayer(element) {
+      if (!supportsTopLayerExit()) {
+        element.setAttribute('data-closing', '');
+        const animations = element.getAnimations({ subtree: true });
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+        if (!element.hasAttribute('data-closing')) return;
+        element.removeAttribute('data-closing');
+      }
+      if (element instanceof HTMLDialogElement) element.close();
+      else element.hidePopover();
+    }
+
+    const dialog = document.getElementById('logout-dialog');
+    document.getElementById('open-dialog-btn').addEventListener('click', (e) => {
+      e.preventDefault();
+      dialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', () => closeTopLayer(dialog));
+    // Route Esc and closedby light dismiss through the animated close path
+    dialog.addEventListener('cancel', (e) => {
+      e.preventDefault();
+      closeTopLayer(dialog);
+    });
+
+    const notice = document.getElementById('offline-notice');
+    document.getElementById('close-notice-btn').addEventListener('click', () => closeTopLayer(notice));
+  </script>
+
