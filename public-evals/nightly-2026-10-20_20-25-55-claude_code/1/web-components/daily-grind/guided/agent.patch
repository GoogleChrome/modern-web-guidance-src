+/* The Daily Grind — reusable UI components. Plain HTML + CSS, no JS required. */
+@layer tokens, base, components;
+
+@layer tokens {
+  :root {
+    --primary: #4e342e;
+    --primary-dark: #3e2723;
+    --secondary: #d7ccc8;
+    --accent: #ffab40;
+    --text: #3e2723;
+    --light: #fafafa;
+    --surface: #fff;
+    --danger: #b3261e;
+    --success: #2e7d32;
+    --radius: 8px;
+    --shadow: 0 2px 5px rgb(0 0 0 / 0.1);
+  }
+}
+
+@layer base {
+  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
+
+  body {
+    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    line-height: 1.6;
+    color: var(--text);
+    background-color: var(--light);
+  }
+
+  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
+}
+
+@layer components {
+  /* ---------- Navbar: <nav class="navbar"> ---------- */
+  .navbar {
+    background: var(--primary);
+    color: white;
+    padding: 1rem 5%;
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.5rem 1rem;
+    justify-content: space-between;
+    align-items: center;
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+  }
+  .navbar .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+  .navbar ul { display: flex; flex-wrap: wrap; gap: 0.5rem 20px; list-style: none; }
+  .navbar a { color: white; text-decoration: none; font-size: 0.9rem; transition: color 0.3s; }
+  .navbar a:hover { color: var(--accent); }
+  .navbar a[aria-current="page"] { color: var(--accent); }
+  .navbar .outline-link { border: 1px solid var(--accent); padding: 5px 12px; border-radius: 4px; }
+
+  /* ---------- Hero: <header class="hero"> ---------- */
+  .hero {
+    min-height: 60vh;
+    background: linear-gradient(rgb(0 0 0 / 0.5), rgb(0 0 0 / 0.5)),
+      var(--hero-image, none) center / cover;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    color: white;
+    text-align: center;
+    padding: 2rem 20px;
+  }
+  .hero h1 { font-size: clamp(2rem, 6vw, 3rem); margin-bottom: 1rem; }
+
+  /* ---------- Layout ---------- */
+  .container { max-width: 1100px; margin: 40px auto; padding: 0 20px; }
+  .section-title { text-align: center; }
+  .stack > * + * { margin-top: 1rem; }
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+    gap: 20px;
+    margin-top: 20px;
+  }
+
+  /* ---------- Button: .btn [.btn-secondary | .btn-outline | .btn-sm] ---------- */
+  .btn {
+    display: inline-block;
+    background: var(--primary);
+    color: white;
+    padding: 10px 20px;
+    border: 1px solid transparent;
+    font: inherit;
+    text-decoration: none;
+    border-radius: 5px;
+    cursor: pointer;
+    transition: background 0.3s, color 0.3s;
+  }
+  .btn:hover { background: var(--primary-dark); }
+  .btn:disabled, .btn[aria-disabled="true"] { opacity: 0.5; cursor: not-allowed; }
+  .btn-secondary { background: var(--accent); color: var(--primary-dark); }
+  .btn-secondary:hover { background: #ff9100; }
+  .btn-outline { background: transparent; color: var(--primary); border-color: var(--primary); }
+  .btn-outline:hover { background: var(--primary); color: white; }
+  .btn-sm { padding: 5px 12px; font-size: 0.85rem; }
+  /* Spacing helper when a button follows text inside a card/hero */
+  :is(.card, .hero) > .btn { margin-top: 15px; }
+
+  /* ---------- Card: .card > (img.card-media)? h3 p .btn ---------- */
+  .card {
+    background: var(--surface);
+    padding: 20px;
+    border-radius: var(--radius);
+    box-shadow: var(--shadow);
+    text-align: center;
+  }
+  .card h3 { margin-bottom: 10px; color: var(--primary); }
+  .card-media {
+    display: block;
+    width: calc(100% + 40px);
+    max-width: none;
+    height: 160px;
+    object-fit: cover;
+    margin: -20px -20px 16px;
+    border-radius: var(--radius) var(--radius) 0 0;
+  }
+
+  /* ---------- Badge: <span class="badge [badge-accent]"> ---------- */
+  .badge {
+    display: inline-block;
+    padding: 2px 10px;
+    border-radius: 999px;
+    background: var(--secondary);
+    color: var(--primary-dark);
+    font-size: 0.75rem;
+    font-weight: 600;
+  }
+  .badge-accent { background: var(--accent); }
+
+  /* ---------- Alert: <div class="alert alert-success" role="status"> ---------- */
+  .alert {
+    padding: 12px 16px;
+    border-radius: var(--radius);
+    border-left: 4px solid var(--primary);
+    background: var(--secondary);
+  }
+  .alert-success { border-color: var(--success); background: #e8f5e9; color: #1b5e20; }
+  .alert-error { border-color: var(--danger); background: #fdecea; color: #7f1d1d; }
+
+  /* ---------- Form: .field > label + input/select/textarea (+ .field-hint) ---------- */
+  .field { display: flex; flex-direction: column; gap: 4px; }
+  .field label { font-weight: 600; font-size: 0.9rem; }
+  .field :is(input, select, textarea) {
+    font: inherit;
+    color: inherit;
+    padding: 10px 12px;
+    background: var(--surface);
+    border: 1px solid #a1887f;
+    border-radius: 5px;
+  }
+  .field :is(input, select, textarea):user-invalid { border-color: var(--danger); }
+  .field-hint { font-size: 0.8rem; opacity: 0.75; }
+
+  /* ---------- Accordion: <details class="accordion"><summary> ---------- */
+  .accordion { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); }
+  .accordion + .accordion { margin-top: 10px; }
+  .accordion summary { padding: 14px 18px; cursor: pointer; font-weight: 600; color: var(--primary); }
+  .accordion > :not(summary) { padding: 0 18px 16px; }
+
+  /* ---------- Modal: <dialog class="modal"> (open with showModal() or commandfor) ---------- */
+  .modal {
+    margin: auto;
+    width: min(90vw, 480px);
+    padding: 24px;
+    border: 0;
+    border-radius: var(--radius);
+    color: var(--text);
+    box-shadow: 0 10px 40px rgb(0 0 0 / 0.3);
+  }
+  .modal::backdrop { background: rgb(0 0 0 / 0.5); }
+
+  /* ---------- Footer: <footer class="site-footer"> ---------- */
+  .site-footer { background: var(--secondary); text-align: center; padding: 40px 20px; margin-top: 40px; }
+  .footer-links { margin-bottom: 20px; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem 1.25rem; }
+  .footer-links a { color: var(--text); text-decoration: none; font-size: 0.85rem; }
+  .footer-links a:hover { text-decoration: underline; }
+}
