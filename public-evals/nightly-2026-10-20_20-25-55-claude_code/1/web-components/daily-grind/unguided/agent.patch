+:root {
+  --primary: #4e342e;
+  --primary-dark: #3e2723;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* { box-sizing: border-box; margin: 0; padding: 0; }
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Button: <a class="btn"> or <button class="btn">; variants: btn-accent, btn-outline */
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  border: 1px solid var(--primary);
+  padding: 10px 20px;
+  font: inherit;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  cursor: pointer;
+  transition: background 0.3s, color 0.3s;
+}
+.btn:hover { background: var(--primary-dark); }
+.btn-accent { background: var(--accent); border-color: var(--accent); color: var(--primary-dark); }
+.btn-accent:hover { background: #ffc470; }
+.btn-outline { background: transparent; color: var(--primary); }
+.btn-outline:hover { background: var(--primary); color: white; }
+
+/* Layout */
+.container { max-width: 1100px; margin: 40px auto; padding: 0 20px; }
+.section-title { text-align: center; }
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+/* Card */
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+.card h3 { margin-bottom: 10px; color: var(--primary); }
+.card img { width: 100%; border-radius: 6px; margin-bottom: 12px; display: block; }
+
+/* Badge */
+.badge {
+  display: inline-block;
+  background: var(--accent);
+  color: var(--primary-dark);
+  font-size: 0.75rem;
+  font-weight: 600;
+  padding: 2px 10px;
+  border-radius: 999px;
+  margin-bottom: 8px;
+}
+
+/* Site nav */
+site-nav {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 10px;
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+site-nav .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; color: white; text-decoration: none; }
+site-nav ul { display: flex; flex-wrap: wrap; list-style: none; }
+site-nav li { margin-left: 20px; }
+site-nav li a { color: white; text-decoration: none; font-size: 0.9rem; transition: color 0.3s; }
+site-nav li a:hover, site-nav li a[aria-current="page"] { color: var(--accent); }
+site-nav li a.nav-cta { border: 1px solid var(--accent); padding: 5px 12px; border-radius: 4px; }
+
+/* Hero */
+hero-banner {
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  height: 60vh;
+  padding: 0 20px;
+  color: white;
+  text-align: center;
+  background-size: cover;
+  background-position: center;
+}
+hero-banner h1 { font-size: 3rem; margin-bottom: 1rem; }
+
+/* Footer */
+site-footer { display: block; background: var(--secondary); text-align: center; padding: 40px 20px; margin-top: 40px; }
+site-footer .footer-links { margin-bottom: 20px; }
+site-footer .footer-links a { margin: 0 10px; color: var(--text); text-decoration: none; font-size: 0.85rem; }
+site-footer .footer-links a:hover { text-decoration: underline; }
diff --git a/components/components.js b/components/components.js
new file mode 100644
index 0000000..009f030
--- /dev/null
+++ b/components/components.js
@@ -0,0 +1,82 @@
+/**
+ * Reusable UI components (light-DOM custom elements, styled by components.css).
+ *
+ *   <site-nav>          links via `links` JSON attr, or defaults below
+ *   <hero-banner>       image="" heading="" ; slotted children become the body
+ *   <product-card>      title="" href="" image="" badge="" cta="" ; children = description
+ *   <site-footer>       links via `links` JSON attr; year auto-filled
+ */
+const esc = (s = '') =>
+  String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+
+const parseLinks = (el, fallback) => {
+  try { return JSON.parse(el.getAttribute('links')) || fallback; } catch { return fallback; }
+};
+
+const NAV_LINKS = [
+  { label: 'Menu', href: '/menu' },
+  { label: 'Locations', href: '/locations' },
+  { label: 'Rewards', href: '/rewards' },
+  { label: 'My Account', href: '/account' },
+  { label: 'Logout', href: '/logout', cta: true },
+];
+
+const FOOTER_LINKS = [
+  { label: 'Our Story', href: '/about' },
+  { label: 'Join the Team', href: '/careers' },
+  { label: 'Contact Us', href: '/contact' },
+  { label: 'Privacy', href: '/privacy-policy' },
+];
+
+class SiteNav extends HTMLElement {
+  connectedCallback() {
+    const brand = esc(this.getAttribute('brand') || 'THE DAILY GRIND');
+    const items = parseLinks(this, NAV_LINKS).map(l => {
+      const current = l.href === location.pathname ? ' aria-current="page"' : '';
+      return `<li><a href="${esc(l.href)}"${l.cta ? ' class="nav-cta"' : ''}${current}>${esc(l.label)}</a></li>`;
+    }).join('');
+    this.innerHTML = `<a class="logo" href="/">${brand}</a><nav aria-label="Main"><ul>${items}</ul></nav>`;
+  }
+}
+
+class HeroBanner extends HTMLElement {
+  connectedCallback() {
+    if (this.dataset.ready) return;
+    this.dataset.ready = '1';
+    const image = this.getAttribute('image');
+    if (image) {
+      this.style.backgroundImage = `linear-gradient(rgba(0,0,0,.5), rgba(0,0,0,.5)), url('${image.replace(/'/g, '%27')}')`;
+    }
+    const heading = this.getAttribute('heading');
+    if (heading) this.insertAdjacentHTML('afterbegin', `<h1>${esc(heading)}</h1>`);
+  }
+}
+
+class ProductCard extends HTMLElement {
+  connectedCallback() {
+    if (this.dataset.ready) return;
+    this.dataset.ready = '1';
+    const g = n => this.getAttribute(n);
+    const body = this.innerHTML;
+    this.innerHTML = `<div class="card">
+      ${g('image') ? `<img src="${esc(g('image'))}" alt="${esc(g('title'))}" loading="lazy">` : ''}
+      ${g('badge') ? `<span class="badge">${esc(g('badge'))}</span>` : ''}
+      <h3>${esc(g('title'))}</h3>
+      <p>${body}</p>
+      ${g('href') ? `<a href="${esc(g('href'))}" class="btn">${esc(g('cta') || 'View Details')}</a>` : ''}
+    </div>`;
+  }
+}
+
+class SiteFooter extends HTMLElement {
+  connectedCallback() {
+    const links = parseLinks(this, FOOTER_LINKS).map(l => `<a href="${esc(l.href)}">${esc(l.label)}</a>`).join(' | ');
+    const owner = esc(this.getAttribute('owner') || 'The Daily Grind Coffee Co.');
+    this.innerHTML = `<div class="footer-links">${links}</div><p>&copy; ${new Date().getFullYear()} ${owner} All rights reserved.</p>`;
+  }
+}
+
+customElements.define('site-nav', SiteNav);
+customElements.define('hero-banner', HeroBanner);
+customElements.define('product-card', ProductCard);
+customElements.define('site-footer', SiteFooter);
