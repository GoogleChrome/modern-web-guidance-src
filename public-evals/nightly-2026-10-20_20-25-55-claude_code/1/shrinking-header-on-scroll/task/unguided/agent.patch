@@ -206,7 +229,34 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers without CSS scroll-driven animations:
+    // set the same --nav-progress variable from the scroll position.
+    (function () {
+      if (window.CSS && CSS.supports && CSS.supports('animation-timeline: scroll()')) return;
+
+      var nav = document.querySelector('nav');
+      var range = 120;
+      var ticking = false;
+
+      function update() {
+        ticking = false;
+        var y = window.pageYOffset || document.documentElement.scrollTop || 0;
+        nav.style.setProperty('--nav-progress', Math.min(Math.max(y / range, 0), 1));
+      }
+
+      function onScroll() {
+        if (ticking) return;
+        ticking = true;
+        (window.requestAnimationFrame || function (f) { setTimeout(f, 16); })(update);
+      }
+
+      window.addEventListener('scroll', onScroll, { passive: true });
+      update();
+    })();
+  </script>
+
 </body>
 
 </html>
