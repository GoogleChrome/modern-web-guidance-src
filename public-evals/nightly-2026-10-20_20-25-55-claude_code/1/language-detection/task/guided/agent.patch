+  <script>
+    const message = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const result = document.getElementById('detect-result');
+    let detector;
+
+    async function init() {
+      if (!('LanguageDetector' in self)) {
+        result.textContent = 'Language detection is not supported in this browser.';
+        return;
+      }
+      const availability = await LanguageDetector.availability();
+      if (availability === 'unavailable') {
+        result.textContent = 'Language detection is unavailable on this device.';
+        return;
+      }
+      detectBtn.disabled = false;
+    }
+
+    detectBtn.addEventListener('click', async () => {
+      const text = message.value.trim();
+      if (!text) {
+        result.textContent = 'Please enter a message first.';
+        return;
+      }
+      detectBtn.disabled = true;
+      try {
+        // Creation must happen in a user gesture in case the model must be downloaded.
+        detector ??= await LanguageDetector.create({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              result.textContent = `Downloading language model: ${Math.round(e.loaded * 100)}%`;
+            });
+          },
+        });
+        const [top] = await detector.detect(text);
+        if (!top || top.detectedLanguage === 'und') {
+          result.textContent = 'Could not determine the language.';
+        } else {
+          const name = new Intl.DisplayNames(['en'], { type: 'language' }).of(top.detectedLanguage);
+          result.textContent = `${name} (${Math.round(top.confidence * 100)}% confident)`;
+        }
+      } catch (err) {
+        result.textContent = `Detection failed: ${err.message}`;
+      } finally {
+        detectBtn.disabled = false;
+      }
+    });
+
+    init();
+  </script>
