+  <script>
+    const messageEl = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const statusEl = document.getElementById('detect-status');
+    const progressEl = document.getElementById('detect-progress');
+    const resultEl = document.getElementById('detect-result');
+
+    let detectorPromise = null;
+
+    function getDetector() {
+      // Cache the in-flight promise so repeated clicks don't start multiple downloads.
+      detectorPromise ??= LanguageDetector.create({
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const pct = Math.round(e.loaded * 100);
+            progressEl.hidden = false;
+            progressEl.value = pct;
+            statusEl.textContent = `Downloading language model… ${pct}%`;
+          });
+        }
+      }).catch((err) => {
+        detectorPromise = null;
+        throw err;
+      });
+      return detectorPromise;
+    }
+
+    detectBtn.addEventListener('click', async () => {
+      resultEl.textContent = '';
+      statusEl.textContent = '';
+      progressEl.hidden = true;
+
+      const text = messageEl.value.trim();
+      if (!text) {
+        statusEl.textContent = 'Please enter a message first.';
+        return;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        statusEl.textContent = 'Language detection is not supported in this browser.';
+        return;
+      }
+
+      detectBtn.disabled = true;
+      try {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          statusEl.textContent = 'Language detection is not available on this device.';
+          return;
+        }
+        if (availability !== 'available') {
+          statusEl.textContent = 'Downloading language model… 0%';
+          progressEl.hidden = false;
+          progressEl.value = 0;
+        }
+
+        const detector = await getDetector();
+        const [top] = await detector.detect(text);
+        progressEl.hidden = true;
+        statusEl.textContent = '';
+
+        if (!top || top.detectedLanguage === 'und') {
+          resultEl.textContent = 'Could not determine the language.';
+          return;
+        }
+
+        const name = new Intl.DisplayNames(['en'], { type: 'language' }).of(top.detectedLanguage);
+        resultEl.textContent = `Language: ${name} (${(top.confidence * 100).toFixed(1)}% confident)`;
+      } catch (err) {
+        progressEl.hidden = true;
+        statusEl.textContent = `Language detection failed: ${err.message}`;
+      } finally {
+        detectBtn.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
