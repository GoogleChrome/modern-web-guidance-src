+    .Stack-viewContent {
+      width: 100%;
+      height: 100%;
+      background-color: var(--light);
+      overflow-y: auto;
+      overscroll-behavior-y: contain;
+      scrollbar-width: none;
+    }
+
+    .Stack-viewContent::-webkit-scrollbar {
+      display: none;
+    }
+
+    @supports (animation-timeline: view()) {
