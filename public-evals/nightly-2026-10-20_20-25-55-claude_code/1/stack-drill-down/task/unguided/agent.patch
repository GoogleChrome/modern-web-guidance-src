+<script>
+(() => {
+  const stack = document.querySelector('.Stack');
+  const rootEl = stack.querySelector('.Stack-view');
+  const PARALLAX = 0.7; // fraction of the swipe distance the covered view is pushed back
+  const DIM = 0.35;
+  const rootTitle = document.title;
+  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+  const items = new Map();
+  rootEl.querySelectorAll('a.item').forEach(a => {
+    const m = /^#\/view\/(\d+)$/.exec(a.getAttribute('href'));
+    if (m) items.set(m[1], a);
+  });
+
+  // views[0] is always the root; depth is the index of the logical top view.
+  const views = [{ el: rootEl, content: rootEl.querySelector('.Stack-viewContent'), id: null, opener: null }];
+  let depth = 0;
+  let animating = false;
+  let pendingPop = false;
+  let pendingFocus = null;
+  let frame = 0;
+  let settleTimer = 0;
+
+  const clean = path => path.filter(id => items.has(id));
+  const parseHash = () => {
+    const m = /^#\/view\/(\d+)$/.exec(location.hash);
+    return m ? clean([m[1]]) : [];
+  };
+
+  function createView(id) {
+    const link = items.get(id);
+    const card = link.closest('.card');
+    const title = card.querySelector('h3').textContent;
+
+    const el = document.createElement('section');
+    el.className = 'Stack-view';
+    el.setAttribute('aria-labelledby', 'view-title-' + id);
+    const content = document.createElement('div');
+    content.className = 'Stack-viewContent';
+
+    const bar = document.createElement('header');
+    bar.className = 'detail-bar';
+    const back = document.createElement('button');
+    back.type = 'button';
+    back.className = 'back';
+    back.textContent = '‹ Back';
+    const h2 = document.createElement('h2');
+    h2.id = 'view-title-' + id;
+    h2.textContent = title;
+    bar.append(back, h2);
+
+    const body = document.createElement('div');
+    body.className = 'detail-body';
+    const img = document.createElement('img');
+    img.src = link.dataset.img;
+    img.alt = title;
+    const lead = document.createElement('p');
+    lead.textContent = card.querySelector('p').textContent;
+    const more = document.createElement('p');
+    more.textContent = link.dataset.detail;
+    body.append(img, lead, more);
+
+    content.append(bar, body);
+    el.append(content);
+    return { el, content, id, opener: link, title, back };
+  }
+
+  // Scroll-linked parallax, dimming and edge shadow. Transforms/filters only touch the content element.
+  function update() {
+    frame = 0;
+    const w = stack.clientWidth;
+    if (!w) return;
+    const pos = stack.scrollLeft / w;
+    views.forEach((v, i) => {
+      const out = Math.min(Math.max(pos - i, 0), 1);
+      const inn = i ? Math.min(Math.max(i - pos, 0), 1) : 0;
+      v.content.style.transform = out > 0 ? `translate3d(${out * w * PARALLAX}px,0,0)` : '';
+      v.content.style.filter = out > 0 ? `brightness(${1 - out * DIM})` : '';
+      v.el.style.boxShadow = inn > 0 ? `-8px 0 32px rgba(0,0,0,${0.4 * inn})` : '';
+    });
+  }
+
+  const requestUpdate = () => { if (!frame) frame = requestAnimationFrame(update); };
+
+  function refreshInert() {
+    views.forEach((v, i) => { v.el.inert = i !== depth; });
+  }
+
+  function trim(toDepth) {
+    while (views.length - 1 > toDepth) views.pop().el.remove();
+  }
+
+  // Runs once scrolling has come to rest.
+  function settle() {
+    clearTimeout(settleTimer);
+    const w = stack.clientWidth;
+    if (!w) return;
+    const idx = Math.round(stack.scrollLeft / w);
+    if (idx < depth) {
+      // The user swiped back; bring history in line, popstate does the rest.
+      if (!animating && !pendingPop) {
+        pendingPop = true;
+        history.go(idx - depth);
+      }
+      return;
+    }
+    if (idx > depth) return;
+    animating = false;
+    trim(depth);
+    refreshInert();
+    update();
+    const top = views[depth];
+    document.title = top.title || rootTitle;
+    if (pendingFocus) {
+      if (pendingFocus.isConnected) pendingFocus.focus({ preventScroll: true });
+      pendingFocus = null;
+    }
+  }
+
+  function scrollToDepth(animate) {
+    const target = depth * stack.clientWidth;
+    if (Math.abs(stack.scrollLeft - target) < 1) return settle();
+    if (animate && !reducedMotion.matches) {
+      animating = true;
+      stack.scrollTo({ left: target, behavior: 'smooth' });
+    } else {
+      stack.scrollTo({ left: target, behavior: 'instant' });
+      update();
+      settle();
+    }
+  }
+
+  function reconcile(path, animate) {
+    path = clean(path);
+    let common = 0;
+    while (common < path.length && common + 1 < views.length && views[common + 1].id === path[common]) common++;
+
+    if (path.length === common) {
+      // Pure pop: keep the departing views until the swipe/animation has finished.
+      if (views.length - 1 > common) {
+        pendingFocus = views[common + 1].opener;
+        depth = common;
+      }
+      scrollToDepth(animate);
+      return;
+    }
+
+    trim(common);
+    path.slice(common).forEach(id => {
+      const v = createView(id);
+      views.push(v);
+      stack.append(v.el);
+    });
+    depth = views.length - 1;
+    pendingFocus = null;
+    refreshInert();
+    update();
+    if (animate) views[depth].back.focus({ preventScroll: true });
+    scrollToDepth(animate);
+  }
+
+  // Make sure the current entry has our state; deep links get the homepage synthesized behind them.
+  function normalise() {
+    const path = parseHash();
+    if (path.length) {
+      history.replaceState({ path: [] }, '', '#/');
+      history.pushState({ path }, '', '#/view/' + path[0]);
+    } else {
+      history.replaceState({ path: [] }, '');
+    }
+    return path;
+  }
+
+  stack.addEventListener('scroll', () => {
+    requestUpdate();
+    clearTimeout(settleTimer);
+    settleTimer = setTimeout(settle, 150);
+  }, { passive: true });
+  stack.addEventListener('scrollend', settle);
+  ['pointerdown', 'wheel', 'keydown'].forEach(t =>
+    stack.addEventListener(t, () => { animating = false; }, { passive: true }));
+  addEventListener('resize', () => scrollToDepth(false));
+
+  rootEl.addEventListener('click', e => {
+    const link = e.target.closest('a.item');
+    if (!link || !items.has(link.getAttribute('href').slice(7))) return;
+    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+    if (link.target && link.target !== '_self') return;
+    e.preventDefault();
+    const id = link.getAttribute('href').slice(7);
+    const path = views.slice(1).map(v => v.id).concat(id);
+    history.pushState({ path }, '', link.getAttribute('href'));
+    reconcile(path, true);
+  });
+
+  stack.addEventListener('click', e => {
+    if (e.target.closest('.back')) history.back();
+  });
+
+  addEventListener('popstate', e => {
+    pendingPop = false;
+    const state = e.state;
+    const path = state && Array.isArray(state.path) ? clean(state.path) : normalise();
+    reconcile(path, true);
+  });
+
+  const initial = history.state && Array.isArray(history.state.path) ? clean(history.state.path) : normalise();
+  reconcile(initial, false);
+})();
+</script>
