+  <script type="module">
+    // Safari lacks native Temporal; the polyfill doesn't install a global itself.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    // Sample trace as returned by the order-tracking backend (out of order,
+    // server-recorded timestamps with nanosecond precision).
+    function fetchSampleTrace() {
+      return [
+        { orderId: 'A-1042', eventType: 'order.ready', ts: '2026-04-01T12:03:41.250000001Z' },
+        { orderId: 'A-1042', eventType: 'order.placed', ts: '2026-04-01T12:00:00.000123456Z' },
+        { orderId: 'A-1042', eventType: 'espresso.pulled', ts: '2026-04-01T12:02:10.500000000Z' },
+        { orderId: 'A-1042', eventType: 'payment.confirmed', ts: '2026-04-01T12:00:00.000987654Z' },
+        { orderId: 'A-1042', eventType: 'order.accepted', ts: '2026-04-01T12:00:00.000120000Z' },
+        { orderId: 'A-1042', eventType: 'milk.steamed', ts: '2026-04-01T12:02:10.500000000Z' },
+        { orderId: 'A-1042', eventType: 'order.picked_up', ts: '2026-04-01T12:05:03.000000000Z' },
+      ];
+    }
+
+    function sequenceEvents(rawEvents) {
+      // Temporal.Instant keeps nanoseconds; new Date() would truncate to ms.
+      return rawEvents
+        .map(evt => ({ ...evt, timestamp: Temporal.Instant.from(evt.ts) }))
+        .sort((a, b) => Temporal.Instant.compare(a.timestamp, b.timestamp));
+    }
+
+    function formatGap(gap) {
+      return gap.toLocaleString(undefined, { style: 'long' });
+    }
+
+    function logTrace(events) {
+      console.group('Order trace (chronological)');
+      events.forEach((evt, i) => {
+        console.log(`${i + 1}. ${evt.timestamp.toString()}  ${evt.orderId}  ${evt.eventType}`);
+      });
+      console.groupEnd();
+
+      console.group('Time between consecutive events');
+      for (let i = 1; i < events.length; i++) {
+        const prev = events[i - 1];
+        const curr = events[i];
+        const gap = curr.timestamp.since(prev.timestamp);
+        const text = curr.timestamp.equals(prev.timestamp) ? 'simultaneous' : formatGap(gap);
+        console.log(`${prev.eventType} → ${curr.eventType}: ${text}`);
+      }
+      console.groupEnd();
+    }
+
+    document.getElementById('load-trace').addEventListener('click', () => {
+      logTrace(sequenceEvents(fetchSampleTrace()));
+    });
+  </script>
