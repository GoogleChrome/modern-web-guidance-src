+}
+/* Cached views from src/scripts/view-cache.ts: keep rendering state, skip layout/paint. */
+#view-cache {
+  position: absolute;
+  inset: 0 auto auto 0;
+  width: 0;
+  height: 0;
+  overflow: hidden;
+}
+.spa-view.inactive {
+  content-visibility: hidden;
+  position: absolute;
+}
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
