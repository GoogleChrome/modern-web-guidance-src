+}
+
+/* Navigation flyouts are popovers (top layer); line them up under the nav bar. */
+.main-nav {
+  anchor-name: --main-nav;
+}
+
+.nav-flyout {
+  position: fixed;
+  inset: auto;
+  margin: 0;
+  padding: 0;
+  border: 0;
+  left: 0;
+  right: 0;
+  width: auto;
+  max-width: none;
+  background: transparent;
+  overflow: visible;
+}
+
+@supports (top: anchor(--main-nav bottom)) {
+  .nav-flyout {
+    top: anchor(--main-nav bottom);
+    left: anchor(--main-nav left);
+    right: anchor(--main-nav right);
+  }
+}
