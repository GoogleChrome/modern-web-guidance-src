+  <script>
+    // Built-in AI (Prompt API) helpers shared by the three sections.
+    const $ = (id) => document.getElementById(id);
+    const LANG = { expectedInputs: [{ type: 'text', languages: ['en'] }], expectedOutputs: [{ type: 'text', languages: ['en'] }] };
+
+    // Returns true if the model can be used (downloading it if needed); otherwise reports why.
+    async function checkModel(statusEl) {
+      if (!('LanguageModel' in self)) {
+        statusEl.textContent = 'Built-in AI is not supported in this browser.';
+        return false;
+      }
+      const availability = await LanguageModel.availability(LANG);
+      if (availability === 'unavailable') {
+        statusEl.textContent = 'The on-device model is unavailable on this device.';
+        return false;
+      }
+      if (availability === 'downloadable' || availability === 'downloading') {
+        statusEl.textContent = 'Preparing the on-device model (first use requires a download)...';
+      }
+      return true;
+    }
+
+    // Creates a session, reporting model download progress and honoring an abort signal.
+    function createSession({ statusEl, progressEl, signal, ...options }) {
+      return LanguageModel.create({
+        ...LANG,
+        ...options,
+        signal,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            progressEl.hidden = e.loaded >= 1;
+            progressEl.value = e.loaded;
+            statusEl.textContent = `Downloading model: ${Math.round(e.loaded * 100)}%`;
+          });
+        },
+      });
+    }
+
+    // Runs fn with the button disabled, always restoring UI state afterwards.
+    async function withBusy(btn, progressEl, statusEl, fn) {
+      btn.disabled = true;
+      try {
+        await fn();
+      } catch (err) {
+        statusEl.textContent = err.name === 'AbortError' ? 'Cancelled.' : `Error: ${err.message}`;
+      } finally {
+        btn.disabled = false;
+        progressEl.hidden = true;
+      }
+    }
+
+    const liveSessions = new Set();
+    function destroySession(session) {
+      if (!session) return;
+      liveSessions.delete(session);
+      session.destroy();
+    }
+    addEventListener('pagehide', () => {
+      barista.abort?.abort();
+      branches.forEach((b) => b.abort?.abort());
+      liveSessions.forEach((s) => s.destroy());
+      liveSessions.clear();
+    });
+
+    // ---------- Ask the Barista ----------
+    const barista = { session: null, abort: null };
+    const BARISTA_PROMPT =
+      'You are a friendly barista at The Daily Grind coffee shop. You only answer questions about two drinks: ' +
+      'the Maple Oat Latte (creamy oat milk with a hint of Vermont maple syrup) and the Cold Brew (steeped for 18 hours for maximum smoothness). ' +
+      'If asked about anything else, politely say you can only help with those two drinks. Keep answers short. ' +
+      'Do not invent prices, allergen guarantees, or facts you were not given.';
+
+    $('ask-the-barista').addEventListener('click', () => {
+      const btn = $('ask-the-barista');
+      const status = $('barista-status');
+      const progress = $('barista-progress');
+      const answer = $('barista-answer');
+      const question = $('barista-question').value.trim();
+      if (!question) { status.textContent = 'Please enter a question.'; return; }
+
+      withBusy(btn, progress, status, async () => {
+        answer.textContent = '';
+        status.textContent = 'Checking model availability...';
+        if (!(await checkModel(status))) return;
+
+        // Cancel any in-flight request and use a fresh signal.
+        barista.abort?.abort();
+        const abort = (barista.abort = new AbortController());
+
+        // Reuse one session so follow-up questions keep context.
+        if (!barista.session) {
+          barista.session = await createSession({
+            statusEl: status, progressEl: progress, signal: abort.signal,
+            initialPrompts: [{ role: 'system', content: BARISTA_PROMPT }],
+          });
+          liveSessions.add(barista.session);
+        }
+
+        status.textContent = 'Thinking...';
+        const stream = barista.session.promptStreaming(question, { signal: abort.signal });
+        for await (const chunk of stream) {
+          answer.textContent += chunk;
+        }
+        const { inputUsage, inputQuota } = barista.session;
+        status.textContent = `Done. Context used: ${inputUsage}/${inputQuota} tokens.`;
+      }).then(() => {
+        // Drop a session that has run out of room so the next question starts clean.
+        const s = barista.session;
+        if (s && s.inputUsage >= s.inputQuota * 0.9) {
+          destroySession(s);
+          barista.session = null;
+        }
+      });
+    });
+
+    // ---------- Customer Feedback Analyzer ----------
+    const SENTIMENT_SCHEMA = {
+      type: 'object',
+      properties: {
+        score: { type: 'number', minimum: -1, maximum: 1 },
+        category: { type: 'string', enum: ['positive', 'neutral', 'negative'] },
+      },
+      required: ['score', 'category'],
+      additionalProperties: false,
+    };
+
+    $('sentiment-btn').addEventListener('click', () => {
+      const btn = $('sentiment-btn');
+      const status = $('sentiment-status');
+      const progress = $('sentiment-progress');
+      const result = $('sentiment-result');
+      const text = $('feedback-text').value.trim();
+      if (!text) { status.textContent = 'Please enter some feedback.'; return; }
+
+      withBusy(btn, progress, status, async () => {
+        result.textContent = '';
+        status.textContent = 'Checking model availability...';
+        if (!(await checkModel(status))) return;
+
+        // Each analysis is independent, so use a throwaway session and always destroy it.
+        const session = await createSession({
+          statusEl: status, progressEl: progress,
+          initialPrompts: [{
+            role: 'system',
+            content: 'You classify coffee shop customer feedback. score is -1 (very negative) to 1 (very positive).',
+          }],
+        });
+        liveSessions.add(session);
+        try {
+          status.textContent = 'Analyzing...';
+          const raw = await session.prompt(`Feedback: ${text}`, { responseConstraint: SENTIMENT_SCHEMA });
+          const parsed = JSON.parse(raw);
+          result.textContent = JSON.stringify({ score: parsed.score, category: parsed.category }, null, 2);
+          status.textContent = 'Done.';
+        } finally {
+          destroySession(session);
+        }
+      });
+    });
+
+    // ---------- Conversation Branching ----------
+    const MAX_BRANCHES = 3;
+    const branches = []; // { id, session, abort, label }
+    let activeBranch = null;
+    let branchCounter = 0;
+
+    function renderBranches() {
+      const list = $('branch-list');
+      list.replaceChildren();
+      for (const b of branches) {
+        const li = document.createElement('li');
+        li.className = b === activeBranch ? 'active' : '';
+        const { inputUsage, inputQuota } = b.session;
+        const label = document.createElement('span');
+        label.textContent = `${b.label}${b === activeBranch ? ' (active)' : ''} - ${inputUsage}/${inputQuota} tokens`;
+        li.append(label);
+        if (b !== activeBranch) {
+          const sel = document.createElement('button');
+          sel.type = 'button';
+          sel.textContent = 'Switch';
+          sel.addEventListener('click', () => { activeBranch = b; renderBranches(); });
+          li.append(sel);
+        }
+        list.append(li);
+      }
+    }
+
+    function addBranch(session, label) {
+      const branch = { id: ++branchCounter, session, abort: null, label };
+      liveSessions.add(session);
+      // Fires when a prompt would overflow the context window and old messages get evicted.
+      session.addEventListener('quotaoverflow', () => {
+        $('branch-status').textContent = `${branch.label}: context window full, oldest messages were dropped.`;
+      });
+      branches.push(branch);
+      activeBranch = branch;
+      return branch;
+    }
+
+    // Destroys the oldest inactive branches beyond the limit to free model memory.
+    function pruneBranches() {
+      while (branches.length > MAX_BRANCHES) {
+        const i = branches.findIndex((b) => b !== activeBranch);
+        const [old] = branches.splice(i, 1);
+        old.abort?.abort();
+        destroySession(old.session);
+      }
+    }
+
+    async function ensureRootBranch(status, progress) {
+      if (branches.length) return true;
+      status.textContent = 'Checking model availability...';
+      if (!(await checkModel(status))) return false;
+      const session = await createSession({
+        statusEl: status, progressEl: progress,
+        initialPrompts: [{ role: 'system', content: 'You are a helpful, concise coffee shop assistant for The Daily Grind.' }],
+      });
+      addBranch(session, 'Branch 1');
+      return true;
+    }
+
+    $('branch-send-btn').addEventListener('click', () => {
+      const btn = $('branch-send-btn');
+      const status = $('branch-status');
+      const progress = $('branch-progress');
+      const output = $('branch-output');
+      const message = $('branch-input').value.trim();
+      if (!message) { status.textContent = 'Please enter a message.'; return; }
+
+      withBusy(btn, progress, status, async () => {
+        output.textContent = '';
+        if (!(await ensureRootBranch(status, progress))) return;
+        const branch = activeBranch;
+        branch.abort?.abort();
+        branch.abort = new AbortController();
+        status.textContent = `Sending to ${branch.label}...`;
+        const stream = branch.session.promptStreaming(message, { signal: branch.abort.signal });
+        for await (const chunk of stream) output.textContent += chunk;
+        status.textContent = 'Done.';
+      }).finally(renderBranches);
+    });
+
+    $('clone-btn').addEventListener('click', () => {
+      const btn = $('clone-btn');
+      const status = $('branch-status');
+      const progress = $('branch-progress');
+
+      withBusy(btn, progress, status, async () => {
+        if (!(await ensureRootBranch(status, progress))) return;
+        const source = activeBranch;
+        // clone() copies the conversation history and parameters of the source session.
+        const copy = await source.session.clone({ signal: source.abort?.signal });
+        addBranch(copy, `Branch ${branchCounter + 1}`);
+        pruneBranches();
+        const { inputUsage, inputQuota } = copy;
+        status.textContent = `Cloned ${source.label}. Context used: ${inputUsage}/${inputQuota} tokens. Keeping ${branches.length}/${MAX_BRANCHES} branches.`;
+      }).finally(renderBranches);
+    });
+  </script>
+
 </body>
 
