+    /* Contact form */
+    .contact-form {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 16px;
+      max-width: 600px;
+      margin: 20px auto 0;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .contact-form label {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 4px;
+      max-width: 100%;
+      width: 100%;
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .contact-form :is(input, textarea, select) {
+      font: inherit;
+      font-weight: normal;
+      color: var(--text);
+      padding: 8px 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 4px;
+      background: var(--light);
+      /* Size to content; fixed sizing in unsupported browsers */
+      field-sizing: content;
+      max-inline-size: 100%;
+    }
+
+    .contact-form input {
+      width: auto;
+      min-inline-size: 15ch;
+      max-inline-size: min(100%, 50ch);
+    }
+
+    .contact-form textarea {
+      height: auto;
+      /* Stable width; only grows vertically */
+      width: 100%;
+      min-block-size: 3lh;
+      max-block-size: 10lh;
+      resize: none;
+    }
+
+    .contact-form select {
+      max-inline-size: min(100%, 50ch);
+    }
+
+    .contact-form :is(input, textarea, select):focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 1px;
+    }
+
+    .contact-form .btn {
+      border: 0;
+      font: inherit;
+      cursor: pointer;
+      margin-top: 0;
+    }
+
