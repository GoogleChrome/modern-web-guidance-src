+    /* Feedback form */
+    .feedback-form {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 6px;
+      max-width: 600px;
+      margin: 20px auto 0;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .feedback-form label {
+      font-weight: 600;
+      margin-top: 10px;
+    }
+
+    .feedback-form label:first-child {
+      margin-top: 0;
+    }
+
+    /* Size controls to their content instead of a fixed width/height */
+    .feedback-form input,
+    .feedback-form textarea,
+    .feedback-form select {
+      field-sizing: content;
+      min-width: 8rem;
+      max-width: 100%;
+      font: inherit;
+      color: var(--text);
+      padding: 8px 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 5px;
+    }
+
+    .feedback-form textarea {
+      min-height: 2.5rem;
+      resize: none;
+    }
+
+    .feedback-form input:focus,
+    .feedback-form textarea:focus,
+    .feedback-form select:focus {
+      outline: 2px solid var(--accent);
+      border-color: var(--accent);
+    }
+
+    .feedback-form .btn {
+      border: none;
+      cursor: pointer;
+      font: inherit;
+    }
+
