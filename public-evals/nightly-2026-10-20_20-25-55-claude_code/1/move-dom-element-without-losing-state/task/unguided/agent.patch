+  <script>
+    (function () {
+      var iframe = document.getElementById('roast-video');
+      var mainSlot = document.getElementById('main-video-slot');
+      var heroSlot = document.getElementById('hero-video-slot');
+      var hero = document.querySelector('.hero');
+      var button = document.getElementById('theater-toggle');
+      var theater = false;
+
+      // Element.moveBefore() (Chrome 133+) moves a node atomically, so the iframe
+      // keeps its browsing context: no reload, playback continues. Elsewhere,
+      // insertBefore/appendChild removes and re-inserts the iframe, which reloads it.
+      var canMoveBefore = typeof Element.prototype.moveBefore === 'function';
+
+      // Fallback state: track the player's time/state via the YouTube iframe API
+      // (postMessage) so we can resume after the forced reload.
+      var lastTime = 0;
+      var playing = false;
+      var origin = 'https://www.youtube.com';
+
+      function post(msg) {
+        if (iframe.contentWindow) iframe.contentWindow.postMessage(JSON.stringify(msg), origin);
+      }
+
+      function handshake() {
+        post({ event: 'listening', id: 1, channel: 'widget' });
+      }
+
+      if (!canMoveBefore) {
+        iframe.addEventListener('load', handshake);
+        window.addEventListener('message', function (e) {
+          if (e.origin !== origin || e.source !== iframe.contentWindow) return;
+          var data;
+          try { data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data; } catch (err) { return; }
+          if (!data) return;
+          var info = data.event === 'infoDelivery' ? data.info : data.event === 'initialDelivery' ? data.info : null;
+          if (!info) return;
+          if (typeof info.currentTime === 'number') lastTime = info.currentTime;
+          if (typeof info.playerState === 'number') playing = info.playerState === 1;
+        });
+      }
+
+      function move(target) {
+        if (canMoveBefore) {
+          target.moveBefore(iframe, null);
+          return;
+        }
+        var resume = lastTime > 1 ? Math.floor(lastTime) : 0;
+        var autoplay = playing;
+        var url = new URL(iframe.src);
+        if (resume) url.searchParams.set('start', resume);
+        if (autoplay) url.searchParams.set('autoplay', '1');
+        iframe.src = url.href;
+        target.appendChild(iframe);
+      }
+
+      button.addEventListener('click', function () {
+        theater = !theater;
+        move(theater ? heroSlot : mainSlot);
+        hero.classList.toggle('theater', theater);
+        button.setAttribute('aria-pressed', String(theater));
+        button.textContent = theater ? 'Exit theater mode' : 'Theater mode';
+        if (theater) hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
+      });
+    })();
+  </script>
