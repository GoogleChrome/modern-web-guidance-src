+  <script>
+    const video = document.getElementById('roast-video');
+    const inlineSlot = document.getElementById('inline-slot');
+    const theaterSlot = document.getElementById('theater-slot');
+    const hero = document.querySelector('.hero');
+    const toggle = document.getElementById('theater-toggle');
+
+    // moveBefore() moves the iframe atomically, so playback isn't reset.
+    // Browsers without it (e.g. Safari) fall back to insertBefore(), which reloads the iframe.
+    function move(node, parent) {
+      if ('moveBefore' in Element.prototype) {
+        parent.moveBefore(node, null);
+      } else {
+        parent.insertBefore(node, null);
+      }
+    }
+
+    toggle.addEventListener('click', () => {
+      const on = toggle.getAttribute('aria-pressed') !== 'true';
+      move(video, on ? theaterSlot : inlineSlot);
+      hero.classList.toggle('theater', on);
+      toggle.setAttribute('aria-pressed', on);
+      toggle.textContent = on ? 'Exit theater mode' : 'Theater mode';
+      if (on) hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
+    });
+  </script>
