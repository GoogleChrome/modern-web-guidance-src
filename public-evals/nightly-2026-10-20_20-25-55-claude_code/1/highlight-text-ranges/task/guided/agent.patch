   </footer>
 
+  <script>
+    const searchInput = document.getElementById('search-input');
+    const searchRoots = document.querySelectorAll('.grid .card h3, .grid .card p');
+
+    function textNodesOf(root) {
+      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+      const nodes = [];
+      for (let n = walker.nextNode(); n; n = walker.nextNode()) nodes.push(n);
+      return nodes;
+    }
+
+    function clearHighlights() {
+      if (CSS.highlights) {
+        CSS.highlights.delete('search-results');
+        return;
+      }
+      // Fallback: unwrap previous <mark> elements and merge text nodes back.
+      document.querySelectorAll('mark.search-hit').forEach(mark => {
+        const parent = mark.parentNode;
+        mark.replaceWith(mark.textContent);
+        parent.normalize();
+      });
+    }
+
+    function highlight(term) {
+      clearHighlights();
+      term = term.trim().toLowerCase();
+      if (!term) return;
+
+      const ranges = [];
+      for (const root of searchRoots) {
+        for (const node of textNodesOf(root)) {
+          const text = node.textContent.toLowerCase();
+          for (let i = text.indexOf(term); i !== -1; i = text.indexOf(term, i + term.length)) {
+            const range = new Range();
+            range.setStart(node, i);
+            range.setEnd(node, i + term.length);
+            ranges.push(range);
+          }
+        }
+      }
+
+      if (CSS.highlights) {
+        if (ranges.length) CSS.highlights.set('search-results', new Highlight(...ranges));
+        return;
+      }
+      // Fallback: wrap ranges in <mark>, last to first so offsets stay valid.
+      for (const range of ranges.reverse()) {
+        const mark = document.createElement('mark');
+        mark.className = 'search-hit';
+        range.surroundContents(mark);
+      }
+    }
+
+    searchInput.addEventListener('input', () => highlight(searchInput.value));
+  </script>
+
 </body>
 
