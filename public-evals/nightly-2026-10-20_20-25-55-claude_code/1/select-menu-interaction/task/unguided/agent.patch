+  <script>
+    // Show errors only after the user interacts with the field or tries to submit.
+    const form = document.querySelector('.order-form');
+    const shop = document.getElementById('shop');
+
+    function validateShop() {
+      const valid = shop.value !== '' && shop.checkValidity();
+      shop.classList.toggle('invalid', !valid);
+      shop.setAttribute('aria-invalid', String(!valid));
+      return valid;
+    }
+
+    shop.addEventListener('blur', validateShop);
+    shop.addEventListener('change', validateShop);
+
+    form.addEventListener('submit', (e) => {
+      if (!validateShop()) {
+        e.preventDefault();
+        shop.focus();
+      }
+    });
+  </script>
