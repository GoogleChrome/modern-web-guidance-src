+  <script>
+    const form = document.getElementById('order-form');
+
+    const syncAriaInvalid = (el) => {
+      if (el.checkValidity()) el.removeAttribute('aria-invalid');
+      else el.setAttribute('aria-invalid', 'true');
+    };
+
+    form.addEventListener('blur', (e) => {
+      if (e.target.matches('select[required]')) syncAriaInvalid(e.target);
+    }, true);
+
+    form.addEventListener('change', (e) => {
+      if (e.target.matches('select[required]')) syncAriaInvalid(e.target);
+    });
+
+    // Runs on invalid submit attempts too, since the browser blocks 'submit'
+    form.addEventListener('invalid', (e) => syncAriaInvalid(e.target), true);
+
+    // Fallback for browsers without :user-invalid
+    if (!CSS.supports('selector(:user-invalid)')) {
+      const select = form.querySelector('select');
+      let interacted = false;
+      const update = () => select.classList.toggle('user-invalid-fallback', !select.checkValidity());
+      select.addEventListener('change', () => { interacted = true; update(); });
+      select.addEventListener('blur', () => { if (interacted) update(); });
+      form.addEventListener('invalid', update, true);
+    }
+  </script>
