@@ -5,28 +5,87 @@ const path = require('node:path');
 const PORT = parseInt(process.env.PORT || '11222', 10);
 const WORK_DIR = __dirname;
 
+// CSP rollout: start in "report-only" (violations are reported to /csp-report
+// but nothing is blocked), then set CSP_MODE=enforce once the logs are clean.
+const CSP_MODE = process.env.CSP_MODE === 'enforce' ? 'enforce' : 'report-only';
+const CSP_HEADER =
+  CSP_MODE === 'enforce' ? 'Content-Security-Policy' : 'Content-Security-Policy-Report-Only';
+const CSP = [
+  "default-src 'none'",
+  "script-src 'none'",
+  "style-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "font-src 'self'",
+  "connect-src 'self'",
+  "form-action 'self'",
+  "base-uri 'none'",
+  "frame-ancestors 'none'",
+  "object-src 'none'",
+  'upgrade-insecure-requests',
+  'report-uri /csp-report',
+].join('; ');
+
+const SECURITY_HEADERS = {
+  [CSP_HEADER]: CSP,
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=()',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Strict-Transport-Security': 'max-age=31536000; includeSubDomains',
+};
+
+// Only these files are served statically (no user-controlled file paths).
+const STATIC_FILES = {
+  '/styles.css': { file: 'styles.css', type: 'text/css; charset=utf-8' },
+};
+
+function send(res, status, headers, body) {
+  res.writeHead(status, { ...SECURITY_HEADERS, 'Cache-Control': 'no-store', ...headers });
+  res.end(body);
+}
+
+function readFile(res, file, type) {
+  fs.readFile(path.join(WORK_DIR, file), (err, data) => {
+    if (err) return send(res, 500, { 'Content-Type': 'text/plain; charset=utf-8' }, 'Server error');
+    send(res, 200, { 'Content-Type': type }, data);
+  });
+}
+
 const server = http.createServer((req, res) => {
-  const parsedUrl = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
-  const pathname = parsedUrl.pathname;
+  const pathname = new URL(req.url, 'http://localhost').pathname;
 
-  if (pathname === '/logout' || pathname === '/logout/') {
-    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
-    res.end('Logged out');
+  if (pathname === '/csp-report' && req.method === 'POST') {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (c) => {
+      size += c.length;
+      if (size > 10_000) return req.destroy();
+      chunks.push(c);
+    });
+    req.on('end', () => {
+      // Log as an escaped JSON string to prevent log injection.
+      console.warn('CSP violation:', JSON.stringify(Buffer.concat(chunks).toString('utf8')));
+      send(res, 204, {});
+    });
     return;
   }
 
-  const filePath = path.join(WORK_DIR, 'index.html');
-  fs.readFile(filePath, (err, data) => {
-    if (err) {
-      res.writeHead(500);
-      res.end('Server error');
-      return;
-    }
-    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
-    res.end(data);
-  });
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    return send(res, 405, { Allow: 'GET, HEAD', 'Content-Type': 'text/plain; charset=utf-8' }, 'Method not allowed');
+  }
+
+  if (pathname === '/logout' || pathname === '/logout/') {
+    return send(res, 200, { 'Content-Type': 'text/html; charset=utf-8' }, 'Logged out');
+  }
+
+  const asset = STATIC_FILES[pathname];
+  if (asset) return readFile(res, asset.file, asset.type);
+
+  readFile(res, 'index.html', 'text/html; charset=utf-8');
 });
 
 server.listen(PORT, () => {
