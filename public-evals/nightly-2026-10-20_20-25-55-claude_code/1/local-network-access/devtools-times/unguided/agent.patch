@@ -0,0 +1,14 @@
+export type LocalAddressSpace = 'local' | 'loopback';
+
+/**
+ * Fetch a resource on the user's local network or loopback interface.
+ * `targetAddressSpace` tells Chrome which Local Network Access permission to
+ * request; the target server must answer CORS (and preflight) requests.
+ */
+export function fetchLocal(
+  url: string,
+  addressSpace: LocalAddressSpace = 'loopback',
+  init: RequestInit = {},
+): Promise<Response> {
+  return fetch(url, { ...init, targetAddressSpace: addressSpace } as RequestInit);
+}
