+  <script>
+    // Example endpoints; replace with the real hub address and companion port.
+    const TARGETS = {
+      'local-network': { url: 'http://192.168.1.100:8080/api/status', space: 'local', label: 'Pickup hub' },
+      'loopback-network': { url: 'http://127.0.0.1:45678/health', space: 'loopback', label: 'Companion app' },
+    };
+
+    async function queryPermission(name) {
+      if (!navigator.permissions?.query) return 'prompt';
+      try {
+        const status = await navigator.permissions.query({ name });
+        status.addEventListener('change', () => updateRemediation(name, status.state));
+        return status.state;
+      } catch {
+        // Unrecognized permission name (browser without LNA): proceed on user gesture.
+        return 'prompt';
+      }
+    }
+
+    function setStatus(name, text) {
+      document.querySelector(`[data-permission-status="${name}"]`).textContent = text;
+    }
+
+    function updateRemediation(name, state) {
+      document.querySelector(`[data-remediation="${name}"]`).hidden = state !== 'denied';
+    }
+
+    async function connect(name) {
+      const { url, space, label } = TARGETS[name];
+      const state = await queryPermission(name);
+      updateRemediation(name, state);
+      if (state === 'denied') {
+        setStatus(name, '');
+        return;
+      }
+      setStatus(name, `Connecting to ${label}…`);
+      try {
+        // targetAddressSpace exempts the http:// request from mixed-content blocking
+        // and triggers the browser's permission prompt on first use.
+        const response = await fetch(new Request(url, { mode: 'cors', targetAddressSpace: space }));
+        if (!response.ok) throw new Error(`HTTP ${response.status}`);
+        setStatus(name, `${label} connected.`);
+      } catch {
+        updateRemediation(name, await queryPermission(name));
+        setStatus(name, `Couldn't reach ${label}. Check that it's running and on the same network.`);
+      }
+    }
+
+    // Requests only start from an explicit click, never on page load.
+    document.querySelectorAll('[data-connect]').forEach((btn) => {
+      btn.addEventListener('click', () => connect(btn.dataset.connect));
+    });
+  </script>
+
