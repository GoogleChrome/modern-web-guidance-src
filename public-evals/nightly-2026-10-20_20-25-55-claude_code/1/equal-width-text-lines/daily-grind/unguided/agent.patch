+  <script>
+    // Size each heading line's font so its text fills the heading width exactly.
+    (function () {
+      var h1 = document.querySelector('.hero h1');
+      var lines = h1.querySelectorAll('.line');
+      function fit() {
+        var width = h1.clientWidth;
+        lines.forEach(function (line) {
+          var text = line.firstElementChild;
+          var probe = 100;
+          line.style.fontSize = probe + 'px';
+          line.style.fontSize = (probe * width / text.getBoundingClientRect().width) + 'px';
+        });
+      }
+      fit();
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
+      window.addEventListener('resize', fit);
+    })();
+  </script>
