+    <section style="margin-top: 60px;">
+      <h2 style="text-align: center; margin-bottom: 20px;">Customize Your Brew</h2>
+      <div class="brew-picker">
+        <div class="brew-picker-header">
+          <label for="strength">Brew strength</label>
+          <output id="strength-output" for="strength">Medium</output>
+        </div>
+        <input type="range" id="strength" class="range" min="1" max="5" step="1" value="3"
+          aria-describedby="strength-scale">
+        <div class="range-scale" id="strength-scale" aria-hidden="true">
+          <span>Mild</span>
+          <span>Bold</span>
+        </div>
+      </div>
+    </section>
   </main>
 
+  <script>
+    (function () {
+      var labels = ['Mild', 'Light', 'Medium', 'Strong', 'Bold'];
+      var range = document.getElementById('strength');
+      var out = document.getElementById('strength-output');
+
+      function update() {
+        var min = +range.min, max = +range.max, val = +range.value;
+        // Keep the fill edge under the thumb's center, not the raw percentage
+        var pct = (val - min) / (max - min);
+        var thumb = 24;
+        range.style.setProperty('--fill', 'calc(' + pct * 100 + '% + ' + (0.5 - pct) * thumb + 'px)');
+        out.textContent = labels[val - 1];
+        // Human-readable value for screen readers instead of "3"
+        range.setAttribute('aria-valuetext', labels[val - 1]);
+      }
+
+      range.addEventListener('input', update);
+      update();
+    })();
+  </script>
+
