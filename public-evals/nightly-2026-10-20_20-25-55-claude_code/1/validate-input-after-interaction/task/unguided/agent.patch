@@ -206,7 +274,47 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const form = document.getElementById('newsletter-form');
+    const email = document.getElementById('newsletter-email');
+    const message = document.getElementById('newsletter-message');
+    let touched = false;
+
+    function validate() {
+      const value = email.value.trim();
+      let error = '';
+      if (!value) error = 'Please enter your email address.';
+      else if (!email.validity.valid) error = 'Please enter a valid email address.';
+      email.setAttribute('aria-invalid', error ? 'true' : 'false');
+      message.className = 'newsletter-message' + (error ? ' error' : '');
+      message.textContent = error;
+      return !error;
+    }
+
+    // Only validate once the user leaves the field, not while typing.
+    email.addEventListener('blur', () => {
+      touched = true;
+      validate();
+    });
+
+    // After the first blur, re-check as they fix it so the error clears right away.
+    email.addEventListener('input', () => {
+      if (touched) validate();
+    });
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      touched = true;
+      if (!validate()) return;
+      // TODO: send to the newsletter backend once an endpoint exists.
+      form.reset();
+      touched = false;
+      email.removeAttribute('aria-invalid');
+      message.className = 'newsletter-message success';
+      message.textContent = 'Thanks for signing up!';
+    });
+  </script>
 </body>
 
 </html>
