+
+  <script>
+    // Keep aria-invalid in sync with :user-invalid (set on blur, cleared while correcting)
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const syncAria = () => newsletterEmail.setAttribute('aria-invalid', newsletterEmail.matches(':user-invalid'));
+    newsletterEmail.addEventListener('blur', syncAria);
+    newsletterEmail.addEventListener('input', () => {
+      if (newsletterEmail.hasAttribute('aria-invalid')) syncAria();
+    });
+  </script>
