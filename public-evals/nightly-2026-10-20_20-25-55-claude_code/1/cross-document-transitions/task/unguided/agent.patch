+  <script>
+    // Seasonal favorites, paged via ?page=N (page 1 is the markup above)
+    const PAGE_SIZE = 3;
+    const ITEMS = [
+      ['Maple Oat Latte', 'Creamy oat milk with a hint of Vermont maple syrup.', '/menu/seasonal'],
+      ['Dark Roast Espresso', 'Bold, smokey, and perfect for a morning boost.', '/menu/espresso'],
+      ['Cold Brew', 'Steeped for 18 hours for maximum smoothness.', '/menu/cold-brew'],
+      ['Pumpkin Spice Latte', 'Roasted pumpkin, warm spices, and steamed milk.', '/menu/pumpkin-spice'],
+      ['Cinnamon Cortado', 'Equal parts espresso and milk with a dusting of cinnamon.', '/menu/cortado'],
+      ['Honey Lavender Latte', 'Floral lavender and local honey over smooth espresso.', '/menu/honey-lavender'],
+      ['Peppermint Mocha', 'Dark chocolate and cool peppermint, topped with cream.', '/menu/peppermint-mocha'],
+      ['Chai Tea Latte', 'Spiced black tea simmered with milk and brown sugar.', '/menu/chai'],
+      ['Nitro Cold Brew', 'Cold brew infused with nitrogen for a creamy cascade.', '/menu/nitro'],
+    ];
+    const LAST_PAGE = Math.ceil(ITEMS.length / PAGE_SIZE);
+
+    const pageOf = (url) => {
+      const n = parseInt(new URL(url).searchParams.get('page'), 10);
+      return Math.min(Math.max(n || 1, 1), LAST_PAGE);
+    };
+
+    function renderPage() {
+      const page = pageOf(location.href);
+      const grid = document.getElementById('favorites-grid');
+      grid.replaceChildren(...ITEMS.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE).map(([title, desc, href]) => {
+        const card = document.createElement('div');
+        card.className = 'card';
+        const h3 = document.createElement('h3');
+        h3.textContent = title;
+        const p = document.createElement('p');
+        p.textContent = desc;
+        const a = document.createElement('a');
+        a.className = 'btn';
+        a.href = href;
+        a.textContent = 'View Details';
+        card.append(h3, p, a);
+        return card;
+      }));
+
+      const prev = document.getElementById('previous');
+      const next = document.getElementById('next');
+      prev.href = `?page=${Math.max(page - 1, 1)}`;
+      next.href = `?page=${Math.min(page + 1, LAST_PAGE)}`;
+      prev.setAttribute('aria-disabled', String(page === 1));
+      next.setAttribute('aria-disabled', String(page === LAST_PAGE));
+    }
+
+    renderPage();
+
+    // Page transitions: only set up when the user doesn't prefer reduced motion
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      window.addEventListener('pagereveal', (event) => {
+        if (!event.viewTransition || !navigation.activation?.from) return;
+
+        const from = pageOf(navigation.activation.from.url);
+        const to = pageOf(navigation.activation.entry.url);
+        if (from === to) return;
+
+        event.viewTransition.types.add(to > from ? 'next' : 'previous');
+      });
+    }
+  </script>
+
