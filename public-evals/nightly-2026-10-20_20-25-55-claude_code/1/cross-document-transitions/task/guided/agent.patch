+  <link rel="expect" href="#main-content" blocking="render">
+  <script blocking="render">
+    // Pick a directional view transition type from the pages being navigated between.
+    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      const pageOf = (url) => Number(new URL(url).searchParams.get('page')) || 1;
+
+      window.addEventListener('pagereveal', (e) => {
+        const activation = window.navigation?.activation;
+        if (!e.viewTransition || !activation?.from) return;
+
+        const from = pageOf(activation.from.url);
+        const to = pageOf(activation.entry.url);
+        if (from === to) return;
+        e.viewTransition.types.add(to > from ? 'next' : 'previous');
+      });
+    }
+  </script>
