+  <script>
+    const statusEl = document.querySelector('[data-testid="auth-status"]');
+    const passkeyButton = document.querySelector('[data-testid="auth-button"]');
+    let autofillAbortController = new AbortController();
+
+    function setStatus(message) {
+      statusEl.textContent = message;
+    }
+
+    async function fetchRequestOptions() {
+      const response = await fetch('/api/login/options', { method: 'POST' });
+      if (!response.ok) throw new Error('Could not start passkey sign-in.');
+      return response.json();
+    }
+
+    // Sends the assertion to the server and reports the outcome.
+    async function verifyCredential(credential, rpId) {
+      const encoded = credential.toJSON();
+      try {
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+        });
+        if (response.ok) {
+          setStatus('Signed in with passkey.');
+          return;
+        }
+        setStatus('Passkey sign-in failed. Please try again.');
+        // Tell the passkey provider to drop credentials the server no longer knows.
+        if (response.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId: encoded.id });
+        }
+      } catch (err) {
+        console.error('Verification request error:', err);
+        setStatus('Could not reach the server. Please try again.');
+      }
+    }
+
+    // Conditional UI: passkeys are offered in the username field's autofill dropdown.
+    async function initializeConditionalAutofill() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) return;
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalGet !== true) return;
+
+      let credential;
+      let optionsJSON;
+      try {
+        optionsJSON = await fetchRequestOptions();
+        credential = await navigator.credentials.get({
+          publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON),
+          signal: autofillAbortController.signal,
+          mediation: 'conditional',
+        });
+      } catch (err) {
+        if (['NotAllowedError', 'AbortError'].includes(err.name)) return;
+        console.error('Unexpected conditional get error:', err);
+        return;
+      }
+      await verifyCredential(credential, optionsJSON.rpId);
+    }
+
+    // Explicit button: prompt for biometrics directly.
+    async function triggerButtonAuthentication() {
+      if (!window.PublicKeyCredential) {
+        setStatus('Passkeys are not supported in this browser.');
+        return;
+      }
+      // Abort the pending conditional request so the two prompts don't collide.
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      let credential;
+      let optionsJSON;
+      try {
+        optionsJSON = await fetchRequestOptions();
+        credential = await navigator.credentials.get({
+          publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON),
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') setStatus('Passkey sign-in was cancelled.');
+        else if (err.name !== 'AbortError') setStatus(err.message || 'Passkey sign-in failed.');
+        // Re-arm autofill suggestions after a cancelled or failed prompt.
+        initializeConditionalAutofill();
+        return;
+      }
+      await verifyCredential(credential, optionsJSON.rpId);
+    }
+
+    passkeyButton.addEventListener('click', triggerButtonAuthentication);
+    window.addEventListener('DOMContentLoaded', initializeConditionalAutofill);
+  </script>
+
 </body>
 
