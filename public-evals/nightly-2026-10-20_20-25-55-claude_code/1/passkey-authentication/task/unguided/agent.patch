+  <script>
+    (function () {
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const authStatus = document.querySelector('[data-testid="auth-status"]');
+      let controller = null;
+
+      const b64urlToBuffer = (s) => {
+        const b64 = s.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(s.length / 4) * 4, '=');
+        return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)).buffer;
+      };
+
+      const bufferToB64url = (buf) =>
+        btoa(String.fromCharCode(...new Uint8Array(buf)))
+          .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+
+      function setStatus(message, isError) {
+        authStatus.textContent = message;
+        authStatus.classList.toggle('error', !!isError);
+      }
+
+      // Fetch a challenge from the server and ask the browser for an assertion.
+      // mediation 'conditional' shows passkeys in the username field's autofill;
+      // otherwise the browser prompts for biometrics directly.
+      async function authenticate(mediation) {
+        if (controller) controller.abort();
+        controller = new AbortController();
+
+        const optionsRes = await fetch('/api/login/options', { method: 'POST' });
+        if (!optionsRes.ok) throw new Error('Could not start sign-in');
+        const options = await optionsRes.json();
+
+        const publicKey = {
+          ...options,
+          challenge: b64urlToBuffer(options.challenge),
+          allowCredentials: (options.allowCredentials || []).map((c) => ({
+            ...c,
+            id: b64urlToBuffer(c.id),
+          })),
+        };
+
+        const request = { publicKey, signal: controller.signal };
+        if (mediation) request.mediation = mediation;
+        const credential = await navigator.credentials.get(request);
+
+        const r = credential.response;
+        const verifyRes = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            id: credential.id,
+            rawId: bufferToB64url(credential.rawId),
+            type: credential.type,
+            response: {
+              clientDataJSON: bufferToB64url(r.clientDataJSON),
+              authenticatorData: bufferToB64url(r.authenticatorData),
+              signature: bufferToB64url(r.signature),
+              userHandle: r.userHandle ? bufferToB64url(r.userHandle) : null,
+            },
+            clientExtensionResults: credential.getClientExtensionResults(),
+          }),
+        });
+        if (!verifyRes.ok) throw new Error('Passkey verification failed');
+        return verifyRes.json().catch(() => ({}));
+      }
+
+      async function run(mediation) {
+        try {
+          const result = await authenticate(mediation);
+          setStatus('Signed in' + (result.username ? ' as ' + result.username : '') + ' with passkey.');
+        } catch (err) {
+          // Aborted requests (e.g. switching from autofill to the button) are expected.
+          if (err.name === 'AbortError') return;
+          if (err.name === 'NotAllowedError') {
+            setStatus('Passkey sign-in was cancelled.', true);
+          } else {
+            setStatus(err.message || 'Passkey sign-in failed.', true);
+          }
+        }
+      }
+
+      authButton.addEventListener('click', () => {
+        setStatus('');
+        run();
+      });
+
+      if (!window.PublicKeyCredential) {
+        setStatus('Passkeys are not supported in this browser.', true);
+        authButton.disabled = true;
+        return;
+      }
+
+      // Start the autofill (conditional UI) request so passkeys are offered on focus.
+      if (PublicKeyCredential.isConditionalMediationAvailable) {
+        PublicKeyCredential.isConditionalMediationAvailable().then((available) => {
+          if (available) run('conditional');
+        });
+      }
+    })();
+  </script>
 </body>
 
