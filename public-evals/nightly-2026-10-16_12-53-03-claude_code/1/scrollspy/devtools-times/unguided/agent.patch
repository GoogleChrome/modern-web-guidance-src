-            <slot />
+    <div class="max-w-5xl mx-auto px-4 py-8 md:py-12 lg:grid lg:grid-cols-[14rem_1fr] lg:gap-10">
+        <aside class="hidden lg:block order-last lg:order-first">
+            <nav id="section-nav" aria-label="On this page" class="sticky top-24 text-sm hidden">
+                <p class="font-semibold text-gray-900 mb-3">On this page</p>
+                <ul id="section-nav-list" class="space-y-2 border-l border-gray-200"></ul>
+            </nav>
+        </aside>
+        <div class="min-w-0">
+            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 pb-2 border-b-2">{title}</h1>
