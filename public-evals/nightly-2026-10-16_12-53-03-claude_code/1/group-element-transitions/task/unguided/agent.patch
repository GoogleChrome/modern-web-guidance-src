+  <script>
+    const list = document.getElementById('bean-list');
+    const form = document.getElementById('bean-form');
+    const input = document.getElementById('bean-name');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let nextId = list.children.length + 1;
+
+    // Run a DOM update inside a view transition when supported and motion is allowed
+    function update(change) {
+      if (!document.startViewTransition || reducedMotion.matches) {
+        change();
+        return;
+      }
+      document.startViewTransition(change);
+    }
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const name = input.value.trim() || `Custom Bean #${nextId}`;
+      const li = document.createElement('li');
+      li.className = 'item item-transition';
+      // Unique identity so the browser can track each item
+      li.style.viewTransitionName = `bean-${nextId++}`;
+      const label = document.createElement('span');
+      label.textContent = name;
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.setAttribute('aria-label', 'Remove');
+      remove.innerHTML = '&times;';
+      li.append(label, remove);
+      input.value = '';
+      update(() => list.appendChild(li));
+    });
+
+    list.addEventListener('click', (e) => {
+      const item = e.target.closest('button') && e.target.closest('.item');
+      if (item) update(() => item.remove());
+    });
+  </script>
 </body>
 
