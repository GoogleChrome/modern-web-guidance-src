+  <script>
+    const list = document.getElementById('bean-list');
+    let nextId = list.children.length + 1;
+
+    function withTransition(update) {
+      if (document.startViewTransition) {
+        document.startViewTransition(update);
+      } else {
+        update();
+      }
+    }
+
+    function createItem(name) {
+      const id = nextId++;
+      const li = document.createElement('li');
+      li.className = 'item';
+      // Unique name so the browser can track each item individually
+      li.style.viewTransitionName = `item-${id}`;
+      const label = document.createElement('span');
+      label.textContent = name;
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.textContent = '\u00d7';
+      remove.setAttribute('aria-label', `Remove ${name}`);
+      li.append(label, remove);
+      return li;
+    }
+
+    document.getElementById('add-item').addEventListener('click', () => {
+      const name = prompt('Name of the coffee bean:');
+      if (!name || !name.trim()) return;
+      withTransition(() => list.append(createItem(name.trim())));
+    });
+
+    list.addEventListener('click', (event) => {
+      const button = event.target.closest('button');
+      if (!button) return;
+      withTransition(() => button.closest('.item').remove());
+    });
+  </script>
 </body>
 
