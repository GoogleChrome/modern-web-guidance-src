+  <script>
+    (function () {
+      var iframe = document.getElementById('roast-video');
+      var slot = document.getElementById('video-slot');
+      var hero = document.querySelector('.hero');
+      var button = document.getElementById('theater-toggle');
+      var theater = false;
+
+      // Fallback state tracking: YouTube reports playback info via postMessage
+      // once we send a "listening" handshake.
+      var ytOrigin = new URL(iframe.src).origin;
+      var last = { time: 0, state: -1 };
+
+      function post(msg) {
+        if (iframe.contentWindow) iframe.contentWindow.postMessage(JSON.stringify(msg), ytOrigin);
+      }
+
+      function listen() {
+        post({ event: 'listening', id: 1, channel: 'widget' });
+      }
+
+      window.addEventListener('message', function (e) {
+        if (e.source !== iframe.contentWindow || e.origin !== ytOrigin) return;
+        var data;
+        try { data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data; } catch (err) { return; }
+        if (!data || data.event !== 'infoDelivery' || !data.info) return;
+        if (typeof data.info.currentTime === 'number') last.time = data.info.currentTime;
+        if (typeof data.info.playerState === 'number') last.state = data.info.playerState;
+      });
+      iframe.addEventListener('load', listen);
+
+      // Element.moveBefore() relocates a node without resetting it, so the
+      // iframe keeps playing and does not reload.
+      var canMoveBefore = typeof Element.prototype.moveBefore === 'function';
+
+      function move(target) {
+        if (canMoveBefore) {
+          target.moveBefore(slot, null);
+          return;
+        }
+        // Older browsers: any reparenting reloads the iframe. Snapshot the
+        // playback position and restore it once the reloaded player is ready.
+        var resume = { time: last.time, playing: last.state === 1 };
+        target.appendChild(slot);
+        if (resume.time <= 0 && !resume.playing) return;
+        iframe.addEventListener('load', function restore() {
+          iframe.removeEventListener('load', restore);
+          // Give the player a moment to initialise after the load event.
+          setTimeout(function () {
+            listen();
+            post({ event: 'command', func: 'seekTo', args: [resume.time, true] });
+            post({ event: 'command', func: resume.playing ? 'playVideo' : 'pauseVideo', args: [] });
+          }, 1000);
+        });
+      }
+
+      button.addEventListener('click', function () {
+        theater = !theater;
+        move(theater ? hero : document.querySelector('.video-section'));
+        hero.classList.toggle('theater', theater);
+        button.setAttribute('aria-pressed', String(theater));
+        button.textContent = theater ? 'Exit Theater Mode' : 'Theater Mode';
+        if (theater) hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
+      });
+    })();
+  </script>
+
