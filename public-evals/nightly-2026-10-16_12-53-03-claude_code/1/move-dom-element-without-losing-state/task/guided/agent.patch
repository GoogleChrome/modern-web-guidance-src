@@ -206,7 +276,44 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+
+  <script>
+    const hero = document.querySelector('.hero');
+    const slot = document.getElementById('video-slot');
+    const video = document.getElementById('roast-video');
+    const toggle = document.getElementById('theater-toggle');
+    const heroVideo = document.createElement('div');
+    heroVideo.className = 'hero-video';
+
+    // moveBefore() moves the node atomically, so the iframe keeps playing.
+    // Browsers without it (e.g. Safari) fall back to insertBefore(), which
+    // reloads the iframe and resets playback.
+    function move(parent) {
+      if ('moveBefore' in Element.prototype) {
+        parent.moveBefore(video, null);
+      } else {
+        parent.insertBefore(video, null);
+      }
+    }
+
+    toggle.addEventListener('click', () => {
+      const on = toggle.getAttribute('aria-pressed') !== 'true';
+      if (on) {
+        hero.append(heroVideo);
+        move(heroVideo);
+        hero.classList.add('theater');
+        hero.scrollIntoView({ behavior: 'smooth' });
+      } else {
+        move(slot);
+        heroVideo.remove();
+        hero.classList.remove('theater');
+      }
+      toggle.setAttribute('aria-pressed', on);
+      toggle.textContent = on ? 'Exit theater mode' : 'Theater mode';
+    });
+  </script>
+
 </body>
 
