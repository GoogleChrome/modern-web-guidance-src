+  <script type="module">
+    // Promotion window, interpreted in the visitor's local time zone.
+    // PROMO_START is a placeholder; set it to the real launch date.
+    const PROMO_START = '2025-12-01T00:00:00';
+    const PROMO_END = '2026-03-01T00:00:00';
+
+    async function getTemporal() {
+      if (typeof Temporal !== 'undefined') return Temporal;
+      // Safari lacks native Temporal; load the reference polyfill.
+      return (await import('https://esm.sh/@js-temporal/polyfill')).Temporal;
+    }
+
+    const plural = (n, unit) => `${n} ${unit}${n === 1 ? '' : 's'}`;
+    const format = (d) => `${plural(d.days, 'day')}, ${plural(d.hours, 'hour')}`;
+
+    async function renderTimer() {
+      const timer = document.getElementById('maple-timer');
+      try {
+        const T = await getTemporal();
+        const now = T.Now.zonedDateTimeISO(); // system time zone
+        const tz = now.timeZoneId;
+        const start = T.PlainDateTime.from(PROMO_START).toZonedDateTime(tz);
+        const end = T.PlainDateTime.from(PROMO_END).toZonedDateTime(tz);
+        const opts = { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'floor' };
+
+        const remaining = T.ZonedDateTime.compare(now, end) < 0;
+        document.getElementById('maple-remaining').textContent = remaining
+          ? `Ends in ${format(now.until(end, opts))}`
+          : 'This offer has ended';
+        document.getElementById('maple-elapsed').textContent =
+          T.ZonedDateTime.compare(now, start) < 0
+            ? 'Starts soon'
+            : `Started ${format(now.since(start, opts))} ago`;
+        timer.hidden = false;
+      } catch {
+        // Leave the timer hidden if Temporal can't be loaded.
+      }
+    }
+
+    renderTimer();
+  </script>
+
 </body>
 
