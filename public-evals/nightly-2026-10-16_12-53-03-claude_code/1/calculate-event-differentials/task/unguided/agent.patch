   </footer>
 
+  <script>
+    (function () {
+      var HOUR = 3600000;
+      var DAY = 24 * HOUR;
+
+      function plural(n, unit) {
+        return n + ' ' + unit + (n === 1 ? '' : 's');
+      }
+
+      function format(ms) {
+        var days = Math.floor(ms / DAY);
+        var hours = Math.floor((ms % DAY) / HOUR);
+        return plural(days, 'day') + ', ' + plural(hours, 'hour');
+      }
+
+      // Computed once on page load (no ticking interval).
+      var timer = document.querySelector('.promo-timer');
+      if (!timer) return;
+
+      var start = new Date(timer.dataset.start).getTime();
+      var end = new Date(timer.dataset.end).getTime();
+      var now = Date.now();
+      var remaining = timer.querySelector('.promo-remaining');
+      var elapsed = timer.querySelector('.promo-elapsed');
+
+      if (isNaN(start) || isNaN(end)) {
+        timer.hidden = true;
+        return;
+      }
+
+      if (now >= end) {
+        remaining.textContent = 'This offer has ended';
+        elapsed.textContent = 'Ran for ' + format(end - start);
+      } else if (now < start) {
+        remaining.textContent = 'Starts in ' + format(start - now);
+        elapsed.textContent = '';
+      } else {
+        remaining.textContent = format(end - now) + ' left';
+        elapsed.textContent = format(now - start) + ' since the offer began';
+      }
+    })();
+  </script>
+
 </body>
 
