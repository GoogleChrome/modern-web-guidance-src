+  <script>
+    const canvas = document.getElementById('canvas');
+    const stage = document.getElementById('cup-stage');
+    const form = document.getElementById('cup-form');
+    const summary = document.getElementById('cup-summary');
+    const ctx = canvas.getContext('2d');
+
+    // Layout in canvas CSS pixels; the form is drawn at CUP_FORM.x/y
+    const CUP_FORM = { x: 60, y: 150 };
+    const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+    function updateSummary() {
+      const name = form.elements.name.value.trim();
+      const milk = form.elements.milk.value;
+      const syrup = form.elements.syrup.value;
+      summary.textContent = `${name ? name + ': ' : ''}${milk} milk latte, ` +
+        (syrup === 'None' ? 'no syrup' : `${syrup} syrup`);
+    }
+
+    function drawCup() {
+      const scale = canvas.width / canvas.clientWidth;
+      ctx.reset();
+      ctx.scale(scale, scale);
+
+      // Handle
+      ctx.strokeStyle = '#4e342e';
+      ctx.lineWidth = 14;
+      ctx.beginPath();
+      ctx.ellipse(272, 230, 38, 56, 0, -Math.PI / 2, Math.PI / 2);
+      ctx.stroke();
+
+      // Body
+      ctx.beginPath();
+      ctx.moveTo(30, 90);
+      ctx.lineTo(290, 90);
+      ctx.lineTo(260, 380);
+      ctx.quadraticCurveTo(255, 405, 230, 405);
+      ctx.lineTo(90, 405);
+      ctx.quadraticCurveTo(65, 405, 60, 380);
+      ctx.closePath();
+      ctx.fillStyle = '#fafafa';
+      ctx.fill();
+      ctx.lineWidth = 6;
+      ctx.stroke();
+
+      // Coffee rim
+      ctx.beginPath();
+      ctx.ellipse(160, 90, 130, 18, 0, 0, Math.PI * 2);
+      ctx.fillStyle = '#6d4c41';
+      ctx.fill();
+      ctx.stroke();
+
+      // Steam
+      ctx.strokeStyle = '#d7ccc8';
+      ctx.lineWidth = 5;
+      ctx.lineCap = 'round';
+      for (const x of [120, 160, 200]) {
+        ctx.beginPath();
+        ctx.moveTo(x, 62);
+        ctx.bezierCurveTo(x - 14, 46, x + 14, 30, x, 12);
+        ctx.stroke();
+      }
+    }
+
+    function resizeCanvas(entry) {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+      // Resizing clears the bitmap
+      if (supportsHtmlInCanvas) canvas.requestPaint();
+      else drawCup();
+    }
+
+    if (supportsHtmlInCanvas) {
+      // Browser aligns the DOM hit-test/a11y bounds with the drawn pixels
+      canvas.onpaint = () => {
+        drawCup();
+        ctx.drawElementImage(form, CUP_FORM.x, CUP_FORM.y);
+      };
+    } else {
+      // Fallback: overlay the live form on top of the canvas via CSS
+      stage.classList.add('overlay');
+      stage.append(form);
+      form.removeAttribute('drawable');
+    }
+
+    form.addEventListener('input', () => {
+      updateSummary();
+      if (supportsHtmlInCanvas) canvas.requestPaint();
+    });
+    form.addEventListener('change', () => {
+      updateSummary();
+      if (supportsHtmlInCanvas) canvas.requestPaint();
+    });
+    updateSummary();
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== 'undefined' &&
+      'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+    new ResizeObserver(([entry]) => resizeCanvas(entry))
+      .observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+  </script>
