+  <script>
+    (function () {
+      const LOGICAL_W = 400;
+      const canvas = document.getElementById('canvas');
+      const ctx = canvas.getContext('2d');
+      const form = document.getElementById('cup-form');
+      const summary = document.getElementById('cup-summary');
+      const COFFEE = { Maple: '#8d5a2b', Vanilla: '#a9774a', Caramel: '#b8782a', No: '#4a2c1d' };
+
+      function draw() {
+        // Backing store = CSS size * devicePixelRatio, so lines stay crisp on HiDPI
+        const rect = canvas.getBoundingClientRect();
+        const dpr = window.devicePixelRatio || 1;
+        const w = Math.max(1, Math.round(rect.width * dpr));
+        const h = Math.max(1, Math.round(rect.height * dpr));
+        if (canvas.width !== w || canvas.height !== h) {
+          canvas.width = w;
+          canvas.height = h;
+        }
+        // Draw in the 400x480 logical space used by the HTML layer
+        const s = w / LOGICAL_W;
+        ctx.setTransform(s, 0, 0, s, 0, 0);
+        ctx.clearRect(0, 0, LOGICAL_W, canvas.height / s);
+
+        // Steam
+        ctx.strokeStyle = 'rgba(78, 52, 46, 0.35)';
+        ctx.lineWidth = 4;
+        ctx.lineCap = 'round';
+        [150, 200, 250].forEach(function (x, i) {
+          ctx.beginPath();
+          ctx.moveTo(x, 52);
+          ctx.bezierCurveTo(x - 14, 38 - i % 2 * 6, x + 14, 24, x, 8);
+          ctx.stroke();
+        });
+
+        // Saucer
+        ctx.fillStyle = '#d7ccc8';
+        ctx.beginPath();
+        ctx.ellipse(190, 428, 180, 36, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.fillStyle = '#bcaaa4';
+        ctx.beginPath();
+        ctx.ellipse(190, 424, 130, 24, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Handle
+        ctx.strokeStyle = '#efebe9';
+        ctx.lineWidth = 22;
+        ctx.beginPath();
+        ctx.moveTo(318, 120);
+        ctx.bezierCurveTo(395, 110, 385, 300, 285, 320);
+        ctx.stroke();
+
+        // Body
+        ctx.fillStyle = '#fff8f0';
+        ctx.strokeStyle = '#4e342e';
+        ctx.lineWidth = 3;
+        ctx.beginPath();
+        ctx.moveTo(40, 60);
+        ctx.lineTo(340, 60);
+        ctx.lineTo(310, 380);
+        ctx.quadraticCurveTo(300, 420, 265, 420);
+        ctx.lineTo(115, 420);
+        ctx.quadraticCurveTo(80, 420, 70, 380);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+
+        // Coffee surface in the rim
+        const syrup = (form.elements.syrup && form.elements.syrup.value) || 'No';
+        ctx.fillStyle = '#fff8f0';
+        ctx.beginPath();
+        ctx.ellipse(190, 60, 150, 20, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.stroke();
+        ctx.fillStyle = COFFEE[syrup];
+        ctx.beginPath();
+        ctx.ellipse(190, 62, 138, 15, 0, 0, Math.PI * 2);
+        ctx.fill();
+      }
+
+      function updateSummary() {
+        const name = form.elements.name.value.trim();
+        const milk = form.elements.milk.value;
+        const syrup = form.elements.syrup.value;
+        const parts = [milk === 'No' ? 'No milk' : milk + ' milk', syrup === 'No' ? 'no syrup' : syrup + ' syrup'];
+        summary.textContent = (name ? name + ': ' : '') + parts.join(', ');
+      }
+
+      form.addEventListener('input', function () { updateSummary(); draw(); });
+      new ResizeObserver(draw).observe(canvas);
+
+      // Redraw when devicePixelRatio changes (zoom, moving between monitors)
+      function watchDpr() {
+        const mq = matchMedia('(resolution: ' + (window.devicePixelRatio || 1) + 'dppx)');
+        mq.addEventListener('change', function () { draw(); watchDpr(); }, { once: true });
+      }
+      watchDpr();
+
+      updateSummary();
+      draw();
+    })();
+  </script>
 </body>
 
