+  <script type="module">
+    const statusEl = document.querySelector('[data-testid="auth-status"]');
+    const button = document.querySelector('[data-testid="auth-button"]');
+    let abortController = new AbortController();
+
+    function setStatus(message, state = '') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    async function ensureWebAuthnJson() {
+      if (!('PublicKeyCredential' in window)) return false;
+      if (!PublicKeyCredential.parseRequestOptionsFromJSON ||
+        !PublicKeyCredential.getClientCapabilities ||
+        !PublicKeyCredential.prototype.toJSON) {
+        await import('https://esm.sh/webauthn-polyfills');
+      }
+      return true;
+    }
+
+    async function fetchOptions() {
+      const res = await fetch('/api/login/options', { method: 'POST' });
+      if (!res.ok) throw new Error('Could not start passkey sign-in.');
+      return PublicKeyCredential.parseRequestOptionsFromJSON(await res.json());
+    }
+
+    async function verify(credential) {
+      const encoded = credential.toJSON();
+      let res;
+      try {
+        res = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded)
+        });
+      } catch {
+        setStatus('Could not reach the server. Please try again.', 'error');
+        return;
+      }
+      if (res.ok) {
+        setStatus('Signed in with passkey.', 'success');
+        return;
+      }
+      setStatus('Passkey sign-in failed. Please try again.', 'error');
+      // Credential unknown to the server: tell the passkey provider to drop it
+      if (res.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+        try {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: location.hostname,
+            credentialId: encoded.id
+          });
+        } catch { /* best-effort sync */ }
+      }
+    }
+
+    async function initConditionalAutofill() {
+      try {
+        if (!(await ensureWebAuthnJson())) return;
+        const { conditionalGet } = await PublicKeyCredential.getClientCapabilities();
+        if (conditionalGet !== true) return;
+        const publicKey = await fetchOptions();
+        const credential = await navigator.credentials.get({
+          publicKey,
+          mediation: 'conditional',
+          signal: abortController.signal
+        });
+        if (credential) await verify(credential);
+      } catch (err) {
+        if (err.name === 'NotAllowedError' || err.name === 'AbortError') return;
+        console.error('Conditional passkey sign-in failed:', err);
+      }
+    }
+
+    async function signInWithButton() {
+      // Cancel pending autofill request so it doesn't collide with the prompt
+      abortController.abort();
+      abortController = new AbortController();
+      let credential;
+      try {
+        if (!(await ensureWebAuthnJson())) {
+          setStatus('Passkeys are not supported in this browser.', 'error');
+          return;
+        }
+        const publicKey = await fetchOptions();
+        credential = await navigator.credentials.get({ publicKey, signal: abortController.signal });
+      } catch (err) {
+        if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') {
+          setStatus(err.message || 'Passkey sign-in failed.', 'error');
+        }
+        initConditionalAutofill(); // re-arm autofill
+        return;
+      }
+      await verify(credential);
+    }
+
+    button.addEventListener('click', signInWithButton);
+    initConditionalAutofill();
+  </script>
+
 </body>
 
