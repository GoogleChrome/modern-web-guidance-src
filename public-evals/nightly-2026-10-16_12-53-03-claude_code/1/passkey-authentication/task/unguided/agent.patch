+  <script>
+    (function () {
+      const statusEl = document.querySelector('[data-testid="auth-status"]');
+      const usernameEl = document.querySelector('[data-testid="username-field"]');
+      const buttonEl = document.querySelector('[data-testid="auth-button"]');
+
+      let controller = null;
+
+      function setStatus(message, isError) {
+        statusEl.textContent = message;
+        statusEl.classList.toggle('error', !!isError);
+      }
+
+      function b64urlToBuffer(value) {
+        const b64 = value.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(value.length / 4) * 4, '=');
+        const bin = atob(b64);
+        const bytes = new Uint8Array(bin.length);
+        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function bufferToB64url(buffer) {
+        const bytes = new Uint8Array(buffer);
+        let bin = '';
+        for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
+        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      async function postJSON(url, body) {
+        const res = await fetch(url, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(body || {})
+        });
+        if (!res.ok) throw new Error('Request failed (' + res.status + ')');
+        return res.json();
+      }
+
+      // Server returns WebAuthn request options as JSON (base64url-encoded binary fields).
+      function toRequestOptions(json) {
+        const opts = Object.assign({}, json.publicKey || json);
+        opts.challenge = b64urlToBuffer(opts.challenge);
+        if (opts.allowCredentials) {
+          opts.allowCredentials = opts.allowCredentials.map(c => Object.assign({}, c, { id: b64urlToBuffer(c.id) }));
+        }
+        return opts;
+      }
+
+      function serializeCredential(cred) {
+        const r = cred.response;
+        return {
+          id: cred.id,
+          rawId: bufferToB64url(cred.rawId),
+          type: cred.type,
+          authenticatorAttachment: cred.authenticatorAttachment || undefined,
+          clientExtensionResults: cred.getClientExtensionResults(),
+          response: {
+            clientDataJSON: bufferToB64url(r.clientDataJSON),
+            authenticatorData: bufferToB64url(r.authenticatorData),
+            signature: bufferToB64url(r.signature),
+            userHandle: r.userHandle ? bufferToB64url(r.userHandle) : null
+          }
+        };
+      }
+
+      async function authenticate(conditional) {
+        // Only one WebAuthn request can be pending; cancel any previous one.
+        if (controller) controller.abort();
+        controller = new AbortController();
+        const signal = controller.signal;
+
+        try {
+          const username = conditional ? undefined : usernameEl.value.trim() || undefined;
+          const optionsJSON = await postJSON('/api/login/options', { username: username });
+          const publicKey = toRequestOptions(optionsJSON);
+
+          const request = { publicKey: publicKey, signal: signal };
+          if (conditional) request.mediation = 'conditional';
+
+          const credential = await navigator.credentials.get(request);
+          if (!credential) return;
+
+          setStatus('Verifying…');
+          const result = await postJSON('/api/login/verify', serializeCredential(credential));
+          setStatus('Signed in successfully' + (result && result.username ? ' as ' + result.username : '') + '.');
+        } catch (err) {
+          if (err && err.name === 'AbortError') return;
+          if (err && err.name === 'NotAllowedError') {
+            if (!conditional) setStatus('Passkey sign-in was cancelled.', true);
+            return;
+          }
+          setStatus('Sign-in failed: ' + (err && err.message ? err.message : 'unknown error'), true);
+        }
+      }
+
+      async function startConditionalUI() {
+        if (!window.PublicKeyCredential ||
+          !PublicKeyCredential.isConditionalMediationAvailable ||
+          !(await PublicKeyCredential.isConditionalMediationAvailable())) {
+          return;
+        }
+        await authenticate(true);
+      }
+
+      buttonEl.addEventListener('click', async function () {
+        if (!window.PublicKeyCredential) {
+          setStatus('Passkeys are not supported in this browser.', true);
+          return;
+        }
+        setStatus('');
+        await authenticate(false);
+        // Resume autofill suggestions if the modal attempt did not sign the user in.
+        if (!statusEl.textContent.startsWith('Signed in')) startConditionalUI();
+      });
+
+      startConditionalUI();
+    })();
+  </script>
+
 </body>
 
