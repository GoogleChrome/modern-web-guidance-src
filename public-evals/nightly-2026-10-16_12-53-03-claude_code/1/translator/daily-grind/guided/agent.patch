+  <script>
+    (() => {
+      const SOURCE = 'en';
+      const select = document.getElementById('lang-select');
+      const status = document.getElementById('translate-status');
+      const originals = new Map(); // text node -> original text
+      const originalTitle = document.title;
+      const RTL = new Set(['ar', 'he']);
+
+      if (!('Translator' in self)) {
+        select.disabled = true;
+        select.title = 'Client-side translation is currently unsupported in this browser';
+        status.textContent = 'Client-side translation is currently unsupported in this browser.';
+        setTimeout(() => (status.textContent = ''), 6000);
+        return;
+      }
+
+      function textNodes() {
+        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
+          acceptNode(n) {
+            if (!n.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
+            const el = n.parentElement;
+            if (!el || el.closest('script, style, [translate="no"]')) return NodeFilter.FILTER_REJECT;
+            return NodeFilter.FILTER_ACCEPT;
+          },
+        });
+        const nodes = [];
+        while (walker.nextNode()) nodes.push(walker.currentNode);
+        return nodes;
+      }
+
+      function setLang(lang) {
+        document.documentElement.lang = lang;
+        document.documentElement.dir = RTL.has(lang) ? 'rtl' : 'ltr';
+      }
+
+      function restore() {
+        for (const [node, text] of originals) node.nodeValue = text;
+        originals.clear();
+        document.title = originalTitle;
+        setLang(SOURCE);
+      }
+
+      let current = 0;
+      select.addEventListener('change', async () => {
+        const token = ++current;
+        const target = select.value;
+        if (target === SOURCE) {
+          restore();
+          status.textContent = '';
+          return;
+        }
+
+        const options = { sourceLanguage: SOURCE, targetLanguage: target };
+        try {
+          const availability = await Translator.availability(options);
+          if (availability === 'unavailable') {
+            status.textContent = 'This language is not available on your device.';
+            select.value = document.documentElement.lang;
+            return;
+          }
+          status.textContent = 'Preparing translation…';
+          const translator = await Translator.create({
+            ...options,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                status.textContent = `Downloading language pack… ${Math.round(e.loaded * 100)}%`;
+              });
+            },
+          });
+
+          status.textContent = 'Translating…';
+          // Always translate from the original English text.
+          if (originals.size) for (const [n, t] of originals) n.nodeValue = t;
+          const nodes = originals.size ? [...originals.keys()] : textNodes();
+          const results = await Promise.all(nodes.map((n) => translator.translate(originals.get(n) ?? n.nodeValue)));
+          if (token !== current) return; // superseded by a newer selection
+          nodes.forEach((n, i) => {
+            if (!originals.has(n)) originals.set(n, n.nodeValue);
+            n.nodeValue = results[i];
+          });
+          document.title = await translator.translate(originalTitle);
+          setLang(target);
+          status.textContent = '';
+          translator.destroy?.();
+        } catch (err) {
+          console.error(err);
+          status.textContent = 'Translation failed. Please try again.';
+          select.value = document.documentElement.lang;
+        }
+      });
+    })();
+  </script>
