+++ b/src/components/TranslateArticleButton.tsx
@@ -0,0 +1,74 @@
+import React, { useState } from 'react';
+import { LANGUAGES, createTranslator, isTranslationSupported } from '../utils/translate';
+
+interface Props {
+    // CSS selector of the element whose text should be translated in place
+    targetSelector: string;
+    sourceLanguage?: string;
+}
+
+const TEXT_SELECTOR = 'h1, h2, h3, h4, p, li, blockquote, figcaption';
+
+export default function TranslateArticleButton({ targetSelector, sourceLanguage = 'en' }: Props) {
+    const [language, setLanguage] = useState('es');
+    const [status, setStatus] = useState('');
+    const [translated, setTranslated] = useState(false);
+    const [originals] = useState(() => new Map<Element, string>());
+
+    if (!isTranslationSupported()) return null;
+
+    const nodes = () => Array.from(document.querySelectorAll(`${targetSelector} :is(${TEXT_SELECTOR}), ${targetSelector}:is(${TEXT_SELECTOR})`));
+
+    const restore = () => {
+        originals.forEach((html, el) => { el.innerHTML = html; el.removeAttribute('lang'); });
+        originals.clear();
+        setTranslated(false);
+    };
+
+    const translate = async () => {
+        if (translated) restore();
+        if (language === sourceLanguage) return;
+        try {
+            setStatus('Preparing translator…');
+            const translator = await createTranslator(sourceLanguage, language, (f) =>
+                setStatus(`Downloading language pack… ${Math.round(f * 100)}%`),
+            );
+            const els = nodes();
+            for (let i = 0; i < els.length; i++) {
+                setStatus(`Translating… ${i + 1}/${els.length}`);
+                const el = els[i];
+                const text = el.textContent?.trim();
+                if (!text) continue;
+                originals.set(el, el.innerHTML);
+                el.textContent = await translator.translate(text);
+                el.setAttribute('lang', language);
+            }
+            setTranslated(true);
+            setStatus('');
+        } catch (e) {
+            restore();
+            setStatus(e instanceof Error ? e.message : 'Translation failed.');
+        }
+    };
+
+    return (
+        <div className="flex flex-wrap items-center gap-2 text-sm">
+            <span className="font-semibold text-gray-800">Translate:</span>
+            <select
+                aria-label="Translate article into"
+                value={language}
+                onChange={(e) => setLanguage(e.target.value)}
+                className="border border-gray-300 rounded px-2 py-1"
+            >
+                {Object.entries(LANGUAGES).filter(([c]) => c !== sourceLanguage).map(([code, name]) => (
+                    <option key={code} value={code}>{name}</option>
+                ))}
+            </select>
+            <button type="button" onClick={translate} className="bg-gray-800 text-white font-semibold py-1 px-3 rounded hover:bg-gray-700">
+                Translate
+            </button>
+            {translated && <button type="button" onClick={restore} className="underline text-gray-600 hover:text-amber-500">Show original</button>}
+            {status && <span className="text-gray-500" role="status">{status}</span>}
+        </div>
+    );
+}
