+import React, { useState } from 'react';
+import { LANGUAGES, createTranslator, detectLanguage, isTranslationSupported } from '../utils/translate';
+
+export default function TranslateTool() {
+    const [text, setText] = useState('');
+    const [source, setSource] = useState('en');
+    const [target, setTarget] = useState('es');
+    const [result, setResult] = useState('');
+    const [status, setStatus] = useState('');
+    const [error, setError] = useState('');
+    const [busy, setBusy] = useState(false);
+
+    const supported = isTranslationSupported();
+
+    const swap = () => {
+        setSource(target);
+        setTarget(source);
+        setText(result);
+        setResult('');
+    };
+
+    const detect = async () => {
+        const lang = await detectLanguage(text);
+        if (lang && lang in LANGUAGES) setSource(lang);
+        else setError('Could not detect the language.');
+    };
+
+    const translate = async () => {
+        setError('');
+        setResult('');
+        setBusy(true);
+        try {
+            if (source === target) {
+                setResult(text);
+                return;
+            }
+            setStatus('Preparing translator…');
+            const translator = await createTranslator(source, target, (f) =>
+                setStatus(`Downloading language pack… ${Math.round(f * 100)}%`),
+            );
+            setStatus('Translating…');
+            setResult(await translator.translate(text));
+        } catch (e) {
+            setError(e instanceof Error ? e.message : 'Translation failed.');
+        } finally {
+            setStatus('');
+            setBusy(false);
+        }
+    };
+
+    if (!supported) {
+        return (
+            <p className="p-4 bg-amber-50 border border-amber-200 rounded text-sm text-gray-700">
+                Your browser doesn't support the Translator API. Try a recent version of Chrome.
+            </p>
+        );
+    }
+
+    const select = (value: string, onChange: (v: string) => void, label: string) => (
+        <select
+            aria-label={label}
+            value={value}
+            onChange={(e) => onChange(e.target.value)}
+            className="border border-gray-300 rounded px-2 py-1 text-sm"
+        >
+            {Object.entries(LANGUAGES).map(([code, name]) => (
+                <option key={code} value={code}>{name}</option>
+            ))}
+        </select>
+    );
+
+    return (
+        <div className="space-y-4">
+            <div className="flex flex-wrap items-center gap-3">
+                {select(source, setSource, 'Source language')}
+                <button type="button" onClick={swap} aria-label="Swap languages" className="px-2 py-1 border border-gray-300 rounded text-sm hover:bg-gray-100">⇄</button>
+                {select(target, setTarget, 'Target language')}
+                <button type="button" onClick={detect} disabled={!text.trim()} className="text-sm underline text-gray-600 hover:text-amber-500 disabled:opacity-50">
+                    Detect language
+                </button>
+            </div>
+            <textarea
+                value={text}
+                onChange={(e) => setText(e.target.value)}
+                rows={6}
+                placeholder="Enter text to translate"
+                className="w-full border border-gray-300 rounded p-3 text-sm"
+            />
+            <button
+                type="button"
+                onClick={translate}
+                disabled={busy || !text.trim()}
+                className="bg-gray-800 text-white text-sm font-semibold py-2 px-4 rounded hover:bg-gray-700 disabled:opacity-50"
+            >
+                Translate
+            </button>
+            {status && <p className="text-sm text-gray-500" role="status">{status}</p>}
+            {error && <p className="text-sm text-red-600" role="alert">{error}</p>}
+            {result && (
+                <div className="border border-gray-200 rounded p-3 bg-gray-50 whitespace-pre-wrap" lang={target}>{result}</div>
+            )}
+        </div>
+    );
+}
