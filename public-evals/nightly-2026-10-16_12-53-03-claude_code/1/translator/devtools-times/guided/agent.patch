@@ -0,0 +1,46 @@
+// Thin wrapper around the browser's on-device Translator and LanguageDetector APIs.
+
+export const LANGUAGES: Record<string, string> = {
+  en: 'English',
+  es: 'Spanish',
+  fr: 'French',
+  de: 'German',
+  it: 'Italian',
+  pt: 'Portuguese',
+  ja: 'Japanese',
+  ko: 'Korean',
+  zh: 'Chinese',
+  ru: 'Russian',
+  ar: 'Arabic',
+  hi: 'Hindi',
+};
+
+export function isTranslationSupported(): boolean {
+  return typeof window !== 'undefined' && 'Translator' in window;
+}
+
+export async function detectLanguage(text: string): Promise<string | null> {
+  if (!('LanguageDetector' in window)) return null;
+  const detector = await (window as any).LanguageDetector.create();
+  const [best] = await detector.detect(text);
+  return best && best.confidence > 0.5 ? best.detectedLanguage : null;
+}
+
+export async function createTranslator(
+  source: string,
+  target: string,
+  onProgress?: (fraction: number) => void,
+) {
+  const T = (window as any).Translator;
+  const availability = await T.availability({ sourceLanguage: source, targetLanguage: target });
+  if (availability === 'unavailable') {
+    throw new Error(`Translating ${LANGUAGES[source] ?? source} to ${LANGUAGES[target] ?? target} is not supported.`);
+  }
+  return T.create({
+    sourceLanguage: source,
+    targetLanguage: target,
+    monitor(m: EventTarget) {
+      m.addEventListener('downloadprogress', (e: any) => onProgress?.(e.loaded));
+    },
+  });
+}
