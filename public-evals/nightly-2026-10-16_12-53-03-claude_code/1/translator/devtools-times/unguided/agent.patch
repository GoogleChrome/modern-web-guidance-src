+import React, { useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+
+const LANGUAGES: Record<string, string> = {
+  en: 'English',
+  es: 'Spanish',
+  fr: 'French',
+  de: 'German',
+  it: 'Italian',
+  pt: 'Portuguese',
+  ja: 'Japanese',
+  zh: 'Chinese',
+};
+
+const SELECTOR = '[data-translate], [data-translate-body] :is(p, h1, h2, h3, h4, li, blockquote)';
+
+export default function ArticleTranslator() {
+  const [language, setLanguage] = useState('en');
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  // Original text per element, so switching back to English is lossless.
+  const originals = useRef(new Map<Element, string>());
+
+  const getElements = () =>
+    Array.from(document.querySelectorAll(SELECTOR)).filter(
+      (el) => !el.querySelector('[data-translate], p, li')
+    );
+
+  const handleChange = async (e: React.ChangeEvent<HTMLSelectElement>) => {
+    const target = e.target.value;
+    setLanguage(target);
+    setError(null);
+    const elements = getElements();
+    elements.forEach((el) => {
+      if (!originals.current.has(el)) originals.current.set(el, el.textContent ?? '');
+    });
+
+    if (target === 'en') {
+      elements.forEach((el) => (el.textContent = originals.current.get(el) ?? ''));
+      document.documentElement.lang = 'en';
+      return;
+    }
+
+    setLoading(true);
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/translate`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ texts: elements.map((el) => originals.current.get(el)), target }),
+      });
+      const data = await response.json();
+      if (!response.ok) throw new Error(data.error ?? 'Translation failed.');
+      elements.forEach((el, i) => (el.textContent = data.translations[i]));
+      document.documentElement.lang = target;
+    } catch (err) {
+      setError(err instanceof Error ? err.message : 'Translation failed.');
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div className="flex items-center gap-2 text-sm">
+      <LanguageIcon className="h-5 w-5 text-gray-500" />
+      <label htmlFor="translate-language" className="sr-only">Translate article</label>
+      <select
+        id="translate-language"
+        value={language}
+        onChange={handleChange}
+        disabled={loading}
+        className="border border-gray-300 rounded px-2 py-1 bg-white"
+      >
+        {Object.entries(LANGUAGES).map(([code, name]) => (
+          <option key={code} value={code}>{name}</option>
+        ))}
+      </select>
+      {loading && <span className="text-gray-500">Translating…</span>}
+      {error && <span role="alert" className="text-red-600">{error}</span>}
+    </div>
+  );
+}
diff --git a/src/pages/api/translate.ts b/src/pages/api/translate.ts
