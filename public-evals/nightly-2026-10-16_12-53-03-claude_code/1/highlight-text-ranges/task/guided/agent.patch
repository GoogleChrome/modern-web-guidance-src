+  <script>
+    const searchInput = document.getElementById('search-input');
+    const cards = document.querySelectorAll('.grid .card');
+
+    function textNodesOf(root) {
+      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+      const nodes = [];
+      for (let n = walker.nextNode(); n; n = walker.nextNode()) nodes.push(n);
+      return nodes;
+    }
+
+    function matchIndexes(text, term) {
+      const haystack = text.toLowerCase();
+      const indexes = [];
+      for (let i = haystack.indexOf(term); i !== -1; i = haystack.indexOf(term, i + term.length)) {
+        indexes.push(i);
+      }
+      return indexes;
+    }
+
+    function clearHighlights() {
+      if (CSS.highlights) {
+        CSS.highlights.delete('search-results');
+        return;
+      }
+      document.querySelectorAll('mark.search-hit').forEach(mark => {
+        const parent = mark.parentNode;
+        mark.replaceWith(mark.textContent);
+        parent.normalize();
+      });
+    }
+
+    function highlight(term) {
+      const ranges = [];
+      for (const card of cards) {
+        for (const node of textNodesOf(card)) {
+          const indexes = matchIndexes(node.textContent, term);
+          if (!indexes.length) continue;
+
+          if (CSS.highlights) {
+            for (const i of indexes) {
+              const range = new Range();
+              range.setStart(node, i);
+              range.setEnd(node, i + term.length);
+              ranges.push(range);
+            }
+          } else {
+            const text = node.textContent;
+            const frag = document.createDocumentFragment();
+            let last = 0;
+            for (const i of indexes) {
+              frag.append(text.slice(last, i));
+              const mark = document.createElement('mark');
+              mark.className = 'search-hit';
+              mark.textContent = text.slice(i, i + term.length);
+              frag.append(mark);
+              last = i + term.length;
+            }
+            frag.append(text.slice(last));
+            node.replaceWith(frag);
+          }
+        }
+      }
+      if (CSS.highlights && ranges.length) {
+        CSS.highlights.set('search-results', new Highlight(...ranges));
+      }
+    }
+
+    searchInput.addEventListener('input', () => {
+      clearHighlights();
+      const term = searchInput.value.trim().toLowerCase();
+      if (term) highlight(term);
+    });
+  </script>
+
 </body>
 
