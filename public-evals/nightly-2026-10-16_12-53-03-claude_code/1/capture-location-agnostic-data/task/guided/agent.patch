+  <script type="module">
+    // Pickup time and anniversary are wall-clock/calendar values, so they are stored as plain
+    // ISO strings ("08:30", "2020-03-14") and handled with Temporal.Plain* types: no time zone
+    // is ever attached, so they never shift when the user travels.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const TIME_KEY = 'pickupTime';
+    const DATE_KEY = 'coffeeAnniversary';
+
+    const timeInput = document.getElementById('pickup-time');
+    const dateInput = document.getElementById('coffee-anniversary');
+    const timeSummary = document.getElementById('pickup-summary');
+    const dateSummary = document.getElementById('anniversary-summary');
+
+    function showTime() {
+      if (!timeInput.value) {
+        timeSummary.textContent = '';
+        return;
+      }
+      const time = Temporal.PlainTime.from(timeInput.value);
+      timeSummary.textContent = `Reminder every day at ${time.toLocaleString(undefined, { timeStyle: 'short' })}, wherever you are.`;
+    }
+
+    function showDate() {
+      if (!dateInput.value) {
+        dateSummary.textContent = '';
+        return;
+      }
+      const date = Temporal.PlainDate.from(dateInput.value);
+      dateSummary.textContent = `Brewing together since ${date.toLocaleString(undefined, { dateStyle: 'long' })}.`;
+    }
+
+    timeInput.value = localStorage.getItem(TIME_KEY) ?? '';
+    dateInput.value = localStorage.getItem(DATE_KEY) ?? '';
+    showTime();
+    showDate();
+
+    timeInput.addEventListener('change', () => {
+      localStorage.setItem(TIME_KEY, timeInput.value);
+      showTime();
+    });
+    dateInput.addEventListener('change', () => {
+      localStorage.setItem(DATE_KEY, dateInput.value);
+      showDate();
+    });
+  </script>
 </body>
 
