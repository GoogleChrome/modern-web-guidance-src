+  <script>
+    // Both values are "floating" (location-agnostic): stored and shown as the
+    // plain strings the user picked ("HH:MM" and "YYYY-MM-DD"). They are never
+    // converted through Date/UTC, so travel or time zone changes can't shift them.
+    (function () {
+      var KEY = 'dailyGrindPrefs';
+      var form = document.getElementById('prefs-form');
+      var time = document.getElementById('pickup-time');
+      var date = document.getElementById('coffee-anniversary');
+      var status = document.getElementById('prefs-status');
+      var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
+        'August', 'September', 'October', 'November', 'December'];
+
+      function describe(p) {
+        var parts = [];
+        if (p.pickupTime) {
+          var hm = p.pickupTime.split(':');
+          var h = +hm[0];
+          parts.push('Pickup reminder: ' + ((h + 11) % 12 + 1) + ':' + hm[1] + ' ' + (h < 12 ? 'AM' : 'PM') + ' (local time, wherever you are)');
+        }
+        if (p.anniversary) {
+          var ymd = p.anniversary.split('-');
+          parts.push('Anniversary: ' + MONTHS[ymd[1] - 1] + ' ' + (+ymd[2]) + ', ' + ymd[0]);
+        }
+        return parts.join(' · ');
+      }
+
+      var saved = {};
+      try { saved = JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) { }
+      time.value = saved.pickupTime || '';
+      date.value = saved.anniversary || '';
+      status.textContent = describe(saved);
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var prefs = { pickupTime: time.value, anniversary: date.value };
+        try { localStorage.setItem(KEY, JSON.stringify(prefs)); } catch (err) { }
+        status.textContent = 'Saved. ' + describe(prefs);
+      });
+    })();
+  </script>
 </body>
 
