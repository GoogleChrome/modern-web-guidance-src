+  <script>
+    (function () {
+      const TARGETS = [
+        { label: 'New York', tz: 'America/New_York' },
+        { label: 'London', tz: 'Europe/London' },
+        { label: 'Tokyo', tz: 'Asia/Tokyo' },
+        { label: 'UTC', tz: 'UTC' }
+      ];
+
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostSelect = document.getElementById('hostTzSelect');
+      const grid = document.getElementById('grid');
+      const warning = document.getElementById('hostWarning');
+
+      const timeFmt = { hour: 'numeric', minute: '2-digit' };
+      const dateFmt = { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' };
+
+      function showWarning(text) {
+        warning.textContent = text;
+        warning.hidden = !text;
+      }
+
+      // Resolve wall-clock time in the host zone, reporting DST gaps/overlaps.
+      // ZonedDateTime is immutable: every step below returns a new object.
+      function resolveHost(plain, tz) {
+        const earlier = plain.toZonedDateTime(tz, { disambiguation: 'earlier' });
+        const later = plain.toZonedDateTime(tz, { disambiguation: 'later' });
+        const resolved = plain.toZonedDateTime(tz, { disambiguation: 'compatible' });
+
+        if (earlier.epochNanoseconds === later.epochNanoseconds) {
+          return { zdt: resolved, warning: '' };
+        }
+
+        const shown = plain.toString({ smallestUnit: 'minute' }).replace('T', ' ');
+        const exists = Temporal.PlainDateTime.compare(earlier.toPlainDateTime(), plain) === 0;
+        if (exists) {
+          // Overlap: clocks fell back, so this wall time happens twice.
+          return {
+            zdt: resolved,
+            warning: `${shown} is ambiguous in ${tz}: clocks go back and this time occurs twice ` +
+              `(${earlier.offset} and ${later.offset}). We used the first occurrence (${resolved.offset}).`
+          };
+        }
+        // Gap: clocks sprang forward, so this wall time never exists.
+        const shiftedTo = resolved.toPlainDateTime().toString({ smallestUnit: 'minute' }).replace('T', ' ');
+        return {
+          zdt: resolved,
+          warning: `${shown} does not exist in ${tz}: clocks skip forward at this moment. ` +
+            `We moved it forward to ${shiftedTo} (${resolved.offset}).`
+        };
+      }
+
+      function render() {
+        if (!dateInput.value || !timeInput.value) {
+          grid.replaceChildren();
+          showWarning('');
+          return;
+        }
+        const hostTz = hostSelect.value;
+        let plain;
+        try {
+          plain = Temporal.PlainDateTime.from(`${dateInput.value}T${timeInput.value}`);
+        } catch (e) {
+          showWarning('Please enter a valid date and time.');
+          grid.replaceChildren();
+          return;
+        }
+
+        const { zdt: host, warning: note } = resolveHost(plain, hostTz);
+        showWarning(note);
+
+        const cards = TARGETS.map(({ label, tz }) => {
+          const local = host.withTimeZone(tz);
+          const card = document.createElement('div');
+          card.className = 'card' + (tz === hostTz ? ' host' : '');
+          card.dataset.tz = tz;
+
+          const h = document.createElement('h3');
+          h.textContent = label;
+          const t = document.createElement('div');
+          t.className = 'time';
+          t.textContent = local.toLocaleString('en-US', timeFmt);
+          const m = document.createElement('div');
+          m.className = 'meta';
+          m.textContent = `${local.toLocaleString('en-US', dateFmt)} · UTC${local.offset}` +
+            (tz === hostTz ? ' · host' : '');
+          card.append(h, t, m);
+          return card;
+        });
+        grid.replaceChildren(...cards);
+      }
+
+      if (typeof Temporal === 'undefined') {
+        showWarning('Your browser does not support the Temporal API yet. Please use a recent version of Chrome, Edge or Firefox.');
+        [dateInput, timeInput, hostSelect].forEach(el => { el.disabled = true; });
+        return;
+      }
+
+      const today = Temporal.Now.plainDateISO();
+      dateInput.value = today.toString();
+      timeInput.value = '09:00';
+      [dateInput, timeInput, hostSelect].forEach(el => {
+        el.addEventListener('input', render);
+        el.addEventListener('change', render);
+      });
+      render();
+    })();
+  </script>
+
