+  <script type="module">
+    // Temporal is not yet in every browser (e.g. Safari), so load a polyfill only when needed.
+    if (typeof Temporal === 'undefined') {
+      ({ Temporal: globalThis.Temporal } = await import('https://esm.sh/@js-temporal/polyfill'));
+    }
+
+    const TARGETS = [
+      { label: 'New York', zone: 'America/New_York' },
+      { label: 'London', zone: 'Europe/London' },
+      { label: 'Tokyo', zone: 'Asia/Tokyo' },
+      { label: 'UTC', zone: 'UTC' }
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const hostWarning = document.getElementById('hostWarning');
+    const grid = document.getElementById('grid');
+
+    const timeFormat = { hour: 'numeric', minute: '2-digit' };
+    const dateFormat = { weekday: 'short', month: 'short', day: 'numeric' };
+
+    // Default to the next occurrence of tomorrow in the host zone
+    dateInput.value = Temporal.Now.plainDateISO(hostTzSelect.value).add({ days: 1 }).toString();
+
+    // Returns { zdt, warning } where zdt is the resolved (immutable) ZonedDateTime.
+    function resolveHostTime(date, time, timeZone) {
+      const plain = Temporal.PlainDateTime.from(`${date}T${time}`);
+      try {
+        // 'reject' throws RangeError when the wall-clock time is skipped or repeated
+        return { zdt: plain.toZonedDateTime(timeZone, { disambiguation: 'reject' }), warning: '' };
+      } catch (e) {
+        if (!(e instanceof RangeError)) throw e;
+      }
+      const earlier = plain.toZonedDateTime(timeZone, { disambiguation: 'earlier' });
+      const later = plain.toZonedDateTime(timeZone, { disambiguation: 'later' });
+      const zdt = plain.toZonedDateTime(timeZone, { disambiguation: 'compatible' });
+      const isOverlap = earlier.toPlainDateTime().equals(plain);
+      const fmt = (z) => `${z.toLocaleString('en-US', timeFormat)} (UTC${z.offset})`;
+      const warning = isOverlap
+        ? `${time} occurs twice in ${timeZone} on ${date} because clocks are set back. ` +
+          `We used the first occurrence, ${fmt(earlier)}; the second would be ${fmt(later)}.`
+        : `${time} does not exist in ${timeZone} on ${date} because clocks spring forward. ` +
+          `We moved it to ${fmt(zdt)}.`;
+      return { zdt, warning };
+    }
+
+    function render() {
+      if (!dateInput.value || !timeInput.value) {
+        hostWarning.hidden = true;
+        grid.replaceChildren();
+        return;
+      }
+      const { zdt, warning } = resolveHostTime(dateInput.value, timeInput.value, hostTzSelect.value);
+      hostWarning.textContent = warning;
+      hostWarning.hidden = !warning;
+
+      grid.replaceChildren(...TARGETS.map(({ label, zone }) => {
+        // withTimeZone returns a new object; zdt is never mutated
+        const local = zdt.withTimeZone(zone);
+        const card = document.createElement('div');
+        card.className = 'tz-card';
+        card.dataset.zone = zone;
+        const parts = [
+          ['h3', '', label],
+          ['p', 'tz-time', local.toLocaleString('en-US', timeFormat)],
+          ['p', 'tz-date', local.toLocaleString('en-US', dateFormat)],
+          ['p', 'tz-zone', `${zone} (UTC${local.offset})`]
+        ];
+        for (const [tag, cls, text] of parts) {
+          const el = document.createElement(tag);
+          if (cls) el.className = cls;
+          el.textContent = text;
+          card.append(el);
+        }
+        return card;
+      }));
+    }
+
+    for (const el of [dateInput, timeInput, hostTzSelect]) el.addEventListener('input', render);
+    render();
+  </script>
+
