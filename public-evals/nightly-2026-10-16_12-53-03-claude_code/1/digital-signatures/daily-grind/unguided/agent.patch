+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Order Signing &amp; Verification | The Daily Grind</title>
+  <style>
+    :root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+      --ok: #2e7d32;
+      --bad: #c62828;
+    }
+
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background: var(--light);
+    }
+
+    nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+    }
+
+    nav a { color: white; text-decoration: none; font-size: 0.9rem; }
+    nav a:hover { color: var(--accent); }
+    .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+
+    main { max-width: 900px; margin: 30px auto; padding: 0 20px; }
+    h1 { color: var(--primary); margin-bottom: 6px; }
+    .lead { margin-bottom: 20px; }
+
+    .card {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      margin-bottom: 20px;
+    }
+
+    .card h2 { font-size: 1.15rem; color: var(--primary); margin-bottom: 10px; }
+
+    label { display: block; font-size: 0.85rem; font-weight: 600; margin: 12px 0 4px; }
+
+    textarea, select, input[type=file] {
+      width: 100%;
+      padding: 8px;
+      border: 1px solid var(--secondary);
+      border-radius: 4px;
+      font: inherit;
+    }
+
+    textarea { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.8rem; min-height: 90px; resize: vertical; }
+
+    .row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; align-items: center; }
+
+    button {
+      background: var(--primary);
+      color: white;
+      border: 0;
+      padding: 9px 18px;
+      border-radius: 5px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    button:hover { background: #3e2723; }
+    button.secondary { background: var(--secondary); color: var(--text); }
+    button:focus-visible, textarea:focus-visible, select:focus-visible { outline: 3px solid var(--accent); outline-offset: 1px; }
+
+    .tabs { display: flex; gap: 6px; margin-bottom: 12px; }
+    .tabs button { background: var(--secondary); color: var(--text); }
+    .tabs button[aria-selected=true] { background: var(--primary); color: white; }
+
+    .badge { display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 0.75rem; background: var(--secondary); }
+    .badge.pq { background: var(--accent); }
+
+    .result { margin-top: 12px; padding: 10px 12px; border-radius: 4px; font-weight: 600; }
+    .result.ok { background: #e8f5e9; color: var(--ok); }
+    .result.bad { background: #ffebee; color: var(--bad); }
+    .result.info { background: #f3ece9; }
+    .hidden { display: none; }
+    .muted { font-size: 0.85rem; opacity: 0.8; }
+    pre { white-space: pre-wrap; word-break: break-all; font-size: 0.8rem; margin-top: 8px; }
+  </style>
+</head>
+
+<body>
+  <nav>
+    <div class="logo">THE DAILY GRIND</div>
+    <a href="/">&larr; Back to home</a>
+  </nav>
+
+  <main>
+    <h1>Sign &amp; Verify</h1>
+    <p class="lead">Prove that a message, order token or file came from you and was not altered. Everything runs in your browser; private keys never leave this page.</p>
+
+    <section class="card" aria-labelledby="keys-h">
+      <h2 id="keys-h">1. Key pair</h2>
+      <label for="alg">Algorithm</label>
+      <select id="alg"></select>
+      <p class="muted" id="alg-note"></p>
+      <div class="row">
+        <button id="gen">Generate new key pair</button>
+        <button id="dl-priv" class="secondary" disabled>Download private key</button>
+        <button id="dl-pub" class="secondary" disabled>Download public key</button>
+      </div>
+      <div id="key-status" class="result info hidden" role="status"></div>
+      <label for="priv">Private key (JSON, used for signing)</label>
+      <textarea id="priv" spellcheck="false" placeholder="Generate a key pair, or paste a private key here"></textarea>
+      <label for="pub">Public key (JSON, share this for verification)</label>
+      <textarea id="pub" spellcheck="false" placeholder="Generate a key pair, or paste a public key here"></textarea>
+    </section>
+
+    <section class="card" aria-labelledby="what-h">
+      <h2 id="what-h">2. What to sign</h2>
+      <div class="tabs" role="tablist">
+        <button role="tab" id="tab-message" aria-selected="true" data-mode="message">Message</button>
+        <button role="tab" id="tab-token" aria-selected="false" data-mode="token">Token</button>
+        <button role="tab" id="tab-file" aria-selected="false" data-mode="file">File</button>
+      </div>
+
+      <div id="mode-message">
+        <label for="msg">Message</label>
+        <textarea id="msg">Order #1042: 2x Maple Oat Latte, 1x Cold Brew</textarea>
+      </div>
+      <div id="mode-token" class="hidden">
+        <label for="claims">Claims (JSON payload)</label>
+        <textarea id="claims"></textarea>
+        <p class="muted">Produces a compact <code>header.payload.signature</code> token. <code>exp</code> and <code>nbf</code> (Unix seconds) are enforced on verification.</p>
+      </div>
+      <div id="mode-file" class="hidden">
+        <label for="file">File</label>
+        <input type="file" id="file">
+        <p class="muted">The file's bytes are signed directly; nothing is uploaded.</p>
+      </div>
+
+      <div class="row"><button id="do-sign">Sign</button></div>
+      <label for="sig">Signature / token</label>
+      <textarea id="sig" spellcheck="false" placeholder="Output appears here. Paste one here to verify."></textarea>
+      <div class="row">
+        <button id="do-verify">Verify with public key</button>
+        <button id="tamper" class="secondary">Tamper (flip a character) to test</button>
+      </div>
+      <div id="result" class="result hidden" role="status" aria-live="polite"></div>
+      <pre id="detail"></pre>
+    </section>
+  </main>
+
+  <script type="module">
+    import * as S from './signer.js';
+
+    const $ = (id) => document.getElementById(id);
+    let mode = 'message';
+    let algs = [];
+
+    $('claims').value = JSON.stringify({
+      sub: 'customer-1042',
+      order: 'Maple Oat Latte',
+      iat: Math.floor(Date.now() / 1000),
+      exp: Math.floor(Date.now() / 1000) + 3600,
+    }, null, 2);
+
+    function show(el, text, cls) {
+      el.textContent = text;
+      el.className = `result ${cls}`;
+    }
+
+    function setMode(m) {
+      mode = m;
+      for (const name of ['message', 'token', 'file']) {
+        $(`mode-${name}`).classList.toggle('hidden', name !== m);
+        $(`tab-${name}`).setAttribute('aria-selected', String(name === m));
+      }
+      $('tamper').classList.toggle('hidden', m === 'file');
+    }
+    document.querySelectorAll('.tabs button').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode)));
+
+    function updateNote() {
+      const a = algs.find((x) => x.id === $('alg').value);
+      $('alg-note').textContent = a?.pq
+        ? 'Post-quantum: designed to resist attacks from large quantum computers. Signatures are about 3.3 KB.'
+        : 'Classical: fast and compact, but breakable by a sufficiently large quantum computer.';
+    }
+
+    (async () => {
+      algs = await S.listAlgorithms();
+      $('alg').innerHTML = algs.map((a) => `<option value="${a.id}">${a.label}</option>`).join('');
+      if (!algs.some((a) => a.pq)) $('alg-note').textContent = 'Post-quantum ML-DSA is unavailable (no native support and the library could not be loaded).';
+      else updateNote();
+    })();
+    $('alg').addEventListener('change', updateNote);
+
+    function download(name, text) {
+      const a = document.createElement('a');
+      a.href = URL.createObjectURL(new Blob([text], { type: 'application/json' }));
+      a.download = name;
+      a.click();
+      URL.revokeObjectURL(a.href);
+    }
+
+    const keyDoc = (alg, key) => JSON.stringify({ alg, key }, null, 2);
+
+    // Parse a pasted key; its embedded algorithm wins over the dropdown.
+    function parseKey(text, what) {
+      let doc;
+      try { doc = JSON.parse(text); } catch { throw new Error(`${what} key is not valid JSON`); }
+      if (!doc.alg || !doc.key) throw new Error(`${what} key must look like {"alg": ..., "key": ...}`);
+      return doc;
+    }
+
+    $('gen').addEventListener('click', async () => {
+      try {
+        const kp = await S.generateKeyPair($('alg').value);
+        $('priv').value = keyDoc(kp.alg, kp.privateKey);
+        $('pub').value = keyDoc(kp.alg, kp.publicKey);
+        $('dl-priv').disabled = $('dl-pub').disabled = false;
+        show($('key-status'), `Generated ${kp.alg} key. Public key fingerprint: ${await S.fingerprint(kp.publicKey)}`, 'info');
+      } catch (e) {
+        show($('key-status'), e.message, 'bad');
+      }
+    });
+    $('dl-priv').addEventListener('click', () => download('private-key.json', $('priv').value));
+    $('dl-pub').addEventListener('click', () => download('public-key.json', $('pub').value));
+
+    async function input() {
+      if (mode === 'message') return $('msg').value;
+      if (mode === 'file') {
+        const f = $('file').files[0];
+        if (!f) throw new Error('Choose a file first');
+        return new Uint8Array(await f.arrayBuffer());
+      }
+      return JSON.parse($('claims').value);
+    }
+
+    $('do-sign').addEventListener('click', async () => {
+      try {
+        const k = parseKey($('priv').value, 'Private');
+        const data = await input();
+        $('sig').value = mode === 'token'
+          ? await S.signToken(k.alg, k.key, data)
+          : await S.sign(k.alg, k.key, data);
+        show($('result'), 'Signed.', 'info');
+        $('detail').textContent = mode === 'file' ? `SHA-256 of file: ${await S.sha256Hex(data)}` : '';
+      } catch (e) {
+        show($('result'), `Could not sign: ${e.message}`, 'bad');
+      }
+    });
+
+    $('do-verify').addEventListener('click', async () => {
+      try {
+        const k = parseKey($('pub').value, 'Public');
+        const sig = $('sig').value.trim();
+        $('detail').textContent = '';
+        if (mode === 'token') {
+          const r = await S.verifyToken(k.alg, k.key, sig);
+          show($('result'), r.valid ? 'Valid: token is authentic and current.' : `Invalid: ${r.reason}`, r.valid ? 'ok' : 'bad');
+          if (r.payload) $('detail').textContent = `Header: ${JSON.stringify(r.header)}\nPayload (untrusted unless valid): ${JSON.stringify(r.payload)}`;
+          return;
+        }
+        const ok = await S.verify(k.alg, k.key, sig, await input());
+        show($('result'), ok ? 'Valid: the signature matches this content and key.' : 'Invalid: signature does not match.', ok ? 'ok' : 'bad');
+      } catch (e) {
+        show($('result'), `Could not verify: ${e.message}`, 'bad');
+      }
+    });
+
+    // Alter the message (or token payload part) so the user can watch verification fail.
+    $('tamper').addEventListener('click', () => {
+      if (mode === 'message') {
+        $('msg').value += ' ';
+      } else {
+        const t = $('sig').value.trim().split('.');
+        if (t.length !== 3) return show($('result'), 'Sign a token first.', 'info');
+        t[1] = t[1].slice(0, -2) + (t[1].slice(-2) === 'AA' ? 'BB' : 'AA');
+        $('sig').value = t.join('.');
+      }
+      show($('result'), 'Content altered. Click Verify to see it rejected.', 'info');
+    });
+  </script>
+</body>
+
+</html>
