+// Browser-side signing and verification.
+// Classical: ECDSA P-256, Ed25519 (WebCrypto). Post-quantum: ML-DSA-65 (FIPS 204),
+// using WebCrypto when the browser supports it, else @noble/post-quantum loaded on demand.
+
+const enc = new TextEncoder();
+const dec = new TextDecoder();
+
+export const b64u = {
+  encode(buf) {
+    const bytes = new Uint8Array(buf);
+    let s = '';
+    for (const b of bytes) s += String.fromCharCode(b);
+    return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  },
+  decode(str) {
+    const s = str.replace(/-/g, '+').replace(/_/g, '/');
+    const bin = atob(s + '='.repeat((4 - (s.length % 4)) % 4));
+    return Uint8Array.from(bin, (c) => c.charCodeAt(0));
+  },
+};
+
+const NOBLE_URL = 'https://esm.sh/@noble/post-quantum@0.5.2/ml-dsa';
+let noblePromise;
+const loadNoble = () => (noblePromise ??= import(NOBLE_URL));
+
+async function nativeSupported(algo, usages = ['sign', 'verify']) {
+  try {
+    await crypto.subtle.generateKey(algo, true, usages);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+// Provider for algorithms implemented by WebCrypto. `jwsAlg` is the JOSE name.
+function webCryptoProvider({ id, label, jwsAlg, pq, keyAlgo, signAlgo }) {
+  return {
+    id, label, jwsAlg, pq, impl: 'webcrypto',
+    available: () => nativeSupported(keyAlgo),
+    async generate() {
+      const pair = await crypto.subtle.generateKey(keyAlgo, true, ['sign', 'verify']);
+      return {
+        publicKey: await crypto.subtle.exportKey('jwk', pair.publicKey),
+        privateKey: await crypto.subtle.exportKey('jwk', pair.privateKey),
+      };
+    },
+    async sign(privateKey, data) {
+      const key = await crypto.subtle.importKey('jwk', privateKey, keyAlgo, false, ['sign']);
+      return new Uint8Array(await crypto.subtle.sign(signAlgo, key, data));
+    },
+    async verify(publicKey, sig, data) {
+      const key = await crypto.subtle.importKey('jwk', publicKey, keyAlgo, false, ['verify']);
+      return crypto.subtle.verify(signAlgo, key, sig, data);
+    },
+  };
+}
+
+const mldsaNative = webCryptoProvider({
+  id: 'ML-DSA-65', label: 'ML-DSA-65 (post-quantum, native)', jwsAlg: 'ML-DSA-65', pq: true,
+  keyAlgo: { name: 'ML-DSA-65' }, signAlgo: { name: 'ML-DSA-65' },
+});
+
+// Fallback ML-DSA-65 via JS library. Keys are raw bytes, base64url encoded.
+const mldsaLibrary = {
+  id: 'ML-DSA-65', label: 'ML-DSA-65 (post-quantum, JS library)', jwsAlg: 'ML-DSA-65', pq: true,
+  impl: 'noble',
+  available: async () => {
+    try { await loadNoble(); return true; } catch { return false; }
+  },
+  async generate() {
+    const { ml_dsa65 } = await loadNoble();
+    const { publicKey, secretKey } = ml_dsa65.keygen();
+    return { publicKey: { raw: b64u.encode(publicKey) }, privateKey: { raw: b64u.encode(secretKey) } };
+  },
+  async sign(privateKey, data) {
+    const { ml_dsa65 } = await loadNoble();
+    return ml_dsa65.sign(data, b64u.decode(privateKey.raw));
+  },
+  async verify(publicKey, sig, data) {
+    const { ml_dsa65 } = await loadNoble();
+    return ml_dsa65.verify(sig, data, b64u.decode(publicKey.raw));
+  },
+};
+
+const PROVIDERS = [
+  webCryptoProvider({
+    id: 'ECDSA-P256', label: 'ECDSA P-256 / SHA-256 (classical)', jwsAlg: 'ES256', pq: false,
+    keyAlgo: { name: 'ECDSA', namedCurve: 'P-256' }, signAlgo: { name: 'ECDSA', hash: 'SHA-256' },
+  }),
+  webCryptoProvider({
+    id: 'Ed25519', label: 'Ed25519 (classical)', jwsAlg: 'EdDSA', pq: false,
+    keyAlgo: { name: 'Ed25519' }, signAlgo: { name: 'Ed25519' },
+  }),
+  mldsaNative,
+  mldsaLibrary,
+];
+
+/** Providers usable in this browser; the native ML-DSA wins over the library fallback. */
+export async function listAlgorithms() {
+  const out = [];
+  for (const p of PROVIDERS) {
+    if (out.some((o) => o.id === p.id)) continue;
+    if (await p.available()) out.push(p);
+  }
+  return out;
+}
+
+const providerFor = async (id) => {
+  const p = (await listAlgorithms()).find((x) => x.id === id);
+  if (!p) throw new Error(`Algorithm ${id} is not supported in this browser`);
+  return p;
+};
+
+const toBytes = (data) => (typeof data === 'string' ? enc.encode(data) : new Uint8Array(data));
+
+/** Generate a key pair; returns serializable { alg, publicKey, privateKey }. */
+export async function generateKeyPair(algId) {
+  const p = await providerFor(algId);
+  return { alg: p.id, ...(await p.generate()) };
+}
+
+/** Sign a string or bytes. Returns base64url signature. */
+export async function sign(algId, privateKey, data) {
+  const p = await providerFor(algId);
+  return b64u.encode(await p.sign(privateKey, toBytes(data)));
+}
+
+/** Verify a base64url signature. Returns false on mismatch or malformed input. */
+export async function verify(algId, publicKey, signature, data) {
+  const p = await providerFor(algId);
+  try {
+    return await p.verify(publicKey, b64u.decode(signature), toBytes(data));
+  } catch {
+    return false;
+  }
+}
+
+/** SHA-256 hex digest, used to fingerprint keys and files. */
+export async function sha256Hex(data) {
+  const d = await crypto.subtle.digest('SHA-256', toBytes(data));
+  return [...new Uint8Array(d)].map((b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+/** Stable fingerprint of a public key (canonical JSON, keys sorted). */
+export async function fingerprint(publicKey) {
+  const canon = JSON.stringify(Object.fromEntries(Object.entries(publicKey).sort()));
+  return (await sha256Hex(canon)).slice(0, 32).match(/.{4}/g).join(':');
+}
+
+// ---- Compact signed tokens (JWS-style: header.payload.signature) ----
+
+/** Create a signed token. Signature covers the ASCII "header.payload" string. */
+export async function signToken(algId, privateKey, payload, extraHeader = {}) {
+  const p = await providerFor(algId);
+  const header = { alg: p.jwsAlg, typ: 'JWT', ...extraHeader };
+  const input = `${b64u.encode(enc.encode(JSON.stringify(header)))}.${b64u.encode(enc.encode(JSON.stringify(payload)))}`;
+  return `${input}.${b64u.encode(await p.sign(privateKey, enc.encode(input)))}`;
+}
+
+/**
+ * Verify a token and check `exp`/`nbf`. The algorithm is taken from the caller
+ * (algId), never trusted from the token header, to prevent algorithm confusion.
+ * Returns { valid, reason?, header?, payload? }.
+ */
+export async function verifyToken(algId, publicKey, token) {
+  const parts = token.trim().split('.');
+  if (parts.length !== 3) return { valid: false, reason: 'Token must have three dot-separated parts' };
+  const p = await providerFor(algId);
+  let header, payload;
+  try {
+    header = JSON.parse(dec.decode(b64u.decode(parts[0])));
+    payload = JSON.parse(dec.decode(b64u.decode(parts[1])));
+  } catch {
+    return { valid: false, reason: 'Header or payload is not valid base64url JSON' };
+  }
+  if (header.alg !== p.jwsAlg) {
+    return { valid: false, reason: `Header alg "${header.alg}" does not match expected "${p.jwsAlg}"`, header, payload };
+  }
+  let ok = false;
+  try {
+    ok = await p.verify(publicKey, b64u.decode(parts[2]), enc.encode(`${parts[0]}.${parts[1]}`));
+  } catch { /* malformed signature */ }
+  if (!ok) return { valid: false, reason: 'Signature does not match', header, payload };
+  const now = Math.floor(Date.now() / 1000);
+  if (typeof payload.exp === 'number' && now >= payload.exp) return { valid: false, reason: 'Token expired', header, payload };
+  if (typeof payload.nbf === 'number' && now < payload.nbf) return { valid: false, reason: 'Token not yet valid', header, payload };
+  return { valid: true, header, payload };
+}
