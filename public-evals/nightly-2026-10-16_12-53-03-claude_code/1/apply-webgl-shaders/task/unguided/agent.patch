+  <script>
+    (() => {
+      const hero = document.querySelector('.hero');
+      const canvas = hero.querySelector('.hero-gl');
+      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+      const gl = canvas.getContext('webgl', { premultipliedAlpha: true, alpha: true });
+      if (!gl) return;
+
+      const MAX = 8;
+      const vs = `attribute vec2 a; varying vec2 uv;
+        void main(){ uv = a * .5 + .5; gl_Position = vec4(a, 0., 1.); }`;
+      const fs = `precision highp float;
+        varying vec2 uv;
+        uniform sampler2D tex;
+        uniform vec2 res;          // CSS px
+        uniform float time;
+        uniform vec3 rip[${MAX}];  // x, y (CSS px, top-left origin), start time
+        void main(){
+          vec2 p = vec2(uv.x, 1. - uv.y) * res;
+          vec2 off = vec2(0.);
+          // ambient swell
+          off += vec2(sin(p.y * .045 + time * 1.6), cos(p.x * .035 + time * 1.3)) * .8;
+          for (int i = 0; i < ${MAX}; i++) {
+            float age = time - rip[i].z;
+            if (rip[i].z < 0. || age > 3.5) continue;
+            vec2 d = p - rip[i].xy;
+            float r = length(d);
+            float front = age * 260.;
+            float ring = exp(-pow((r - front) / 70., 2.));
+            float w = sin((r - front) * .14) * ring * exp(-age * 1.1);
+            off += normalize(d + 1e-4) * w * 9.;
+          }
+          vec2 q = (p - off) / res;
+          gl_FragColor = texture2D(tex, vec2(q.x, 1. - q.y));
+        }`;
+
+      const sh = (type, src) => {
+        const s = gl.createShader(type);
+        gl.shaderSource(s, src);
+        gl.compileShader(s);
+        return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
+      };
+      const v = sh(gl.VERTEX_SHADER, vs), f = sh(gl.FRAGMENT_SHADER, fs);
+      if (!v || !f) return;
+      const prog = gl.createProgram();
+      gl.attachShader(prog, v);
+      gl.attachShader(prog, f);
+      gl.linkProgram(prog);
+      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
+      gl.useProgram(prog);
+
+      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
+      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
+      const loc = gl.getAttribLocation(prog, 'a');
+      gl.enableVertexAttribArray(loc);
+      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
+
+      const tex = gl.createTexture();
+      gl.bindTexture(gl.TEXTURE_2D, tex);
+      for (const [k, val] of [[gl.TEXTURE_MIN_FILTER, gl.LINEAR], [gl.TEXTURE_MAG_FILTER, gl.LINEAR],
+        [gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE], [gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE]]) {
+        gl.texParameteri(gl.TEXTURE_2D, k, val);
+      }
+      gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, true);
+      gl.enable(gl.BLEND);
+      gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
+
+      const uRes = gl.getUniformLocation(prog, 'res');
+      const uTime = gl.getUniformLocation(prog, 'time');
+      const uRip = gl.getUniformLocation(prog, 'rip');
+
+      // 2D canvas used to rasterise the DOM text/button into the texture
+      const src = document.createElement('canvas');
+      const ctx = src.getContext('2d');
+      const targets = [...hero.querySelectorAll('[data-ripple]')];
+      let W = 0, H = 0, dpr = 1;
+
+      function drawTarget(el, box) {
+        const cs = getComputedStyle(el);
+        const x0 = el.getBoundingClientRect();
+        if (el.classList.contains('btn')) {
+          // the DOM background is transparent, so mirror the .btn / .btn:hover colours
+          ctx.fillStyle = el.matches(':hover') ? '#3e2723' : cs.getPropertyValue('--primary').trim();
+          const r = parseFloat(cs.borderTopLeftRadius) || 0;
+          ctx.beginPath();
+          ctx.roundRect(x0.left - box.left, x0.top - box.top, x0.width, x0.height, r);
+          ctx.fill();
+        }
+        ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
+        ctx.letterSpacing = cs.letterSpacing === 'normal' ? '0px' : cs.letterSpacing;
+        ctx.textBaseline = 'middle';
+        ctx.fillStyle = '#fff';
+        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
+        const range = document.createRange();
+        for (let n; (n = walker.nextNode());) {
+          for (const m of n.textContent.matchAll(/\S+/g)) {
+            range.setStart(n, m.index);
+            range.setEnd(n, m.index + m[0].length);
+            const rc = range.getClientRects()[0];
+            if (rc) ctx.fillText(m[0], rc.left - box.left, rc.top - box.top + rc.height / 2);
+          }
+        }
+      }
+
+      let dirty = true;
+      function rebuild() {
+        const box = hero.getBoundingClientRect();
+        W = box.width; H = box.height;
+        dpr = Math.min(devicePixelRatio || 1, 2);
+        canvas.width = src.width = Math.round(W * dpr);
+        canvas.height = src.height = Math.round(H * dpr);
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        ctx.clearRect(0, 0, W, H);
+        targets.forEach(el => drawTarget(el, box));
+        gl.bindTexture(gl.TEXTURE_2D, tex);
+        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, src);
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.uniform2f(uRes, W, H);
+        dirty = false;
+      }
+
+      // Ripple state
+      const ripples = new Float32Array(MAX * 3).fill(-1);
+      let next = 0, lastSpawn = 0, lastX = 0, lastY = 0;
+      const now = () => performance.now() / 1000;
+      function spawn(x, y) {
+        ripples.set([x, y, now()], next * 3);
+        next = (next + 1) % MAX;
+      }
+      const local = e => {
+        const b = hero.getBoundingClientRect();
+        return [e.clientX - b.left, e.clientY - b.top];
+      };
+      hero.addEventListener('pointermove', e => {
+        const [x, y] = local(e), t = now();
+        if (t - lastSpawn > 0.12 && Math.hypot(x - lastX, y - lastY) > 30) {
+          spawn(x, y);
+          lastSpawn = t; lastX = x; lastY = y;
+        }
+      });
+      hero.addEventListener('pointerdown', e => spawn(...local(e)));
+
+      // Keep the button's hover colour in sync with the texture
+      targets.forEach(el => {
+        ['pointerenter', 'pointerleave'].forEach(ev =>
+          el.addEventListener(ev, () => { dirty = true; }));
+      });
+
+      let visible = true, raf = 0, ready = false;
+      function frame() {
+        raf = 0;
+        if (!visible) return;
+        if (dirty) rebuild();
+        gl.clear(gl.COLOR_BUFFER_BIT);
+        gl.uniform1f(uTime, now());
+        gl.uniform3fv(uRip, ripples);
+        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
+        raf = requestAnimationFrame(frame);
+      }
+      const kick = () => { if (!raf && ready) raf = requestAnimationFrame(frame); };
+
+      new IntersectionObserver(([e]) => { visible = e.isIntersecting; kick(); }).observe(hero);
+      new ResizeObserver(() => { dirty = true; kick(); }).observe(hero);
+      gl.canvas.addEventListener('webglcontextlost', e => {
+        e.preventDefault();
+        hero.classList.remove('gl-active');
+      });
+
+      document.fonts.ready.then(() => {
+        ready = true;
+        rebuild();
+        hero.classList.add('gl-active'); // hide DOM glyphs only once the GL copy exists
+        kick();
+      });
+    })();
+  </script>
+
