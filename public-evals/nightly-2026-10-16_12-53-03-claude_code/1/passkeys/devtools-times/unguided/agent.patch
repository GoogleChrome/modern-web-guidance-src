@@ -0,0 +1,37 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { checkOrigin, currentUser, json, relyingParty } from '../../../../server/auth';
+import { listPasskeys } from '../../../../server/store';
+
+/**
+ * purpose "signin": discoverable credentials (no username needed).
+ * purpose "reauth": limited to the signed-in user's own passkeys.
+ */
+export const POST: APIRoute = async (ctx) => {
+  const bad = checkOrigin(ctx);
+  if (bad) return bad;
+  const { session, url, request } = ctx;
+  const body = await request.json().catch(() => ({}));
+  const purpose = body.purpose === 'reauth' ? 'reauth' : 'signin';
+
+  let allowCredentials;
+  if (purpose === 'reauth') {
+    const user = await currentUser(session);
+    if (!user) return json({ error: 'Not signed in.' }, 401);
+    const keys = listPasskeys(user.id);
+    if (!keys.length) return json({ error: 'No passkeys on this account.' }, 400);
+    allowCredentials = keys.map((p) => ({ id: p.id, transports: p.transports as any }));
+  }
+
+  const options = await generateAuthenticationOptions({
+    rpID: relyingParty(url).rpID,
+    allowCredentials,
+    userVerification: 'preferred',
+  });
+  session?.set('passkeyChallenge', {
+    purpose,
+    challenge: options.challenge,
+    expires: Date.now() + 5 * 60 * 1000,
+  });
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/authenticate/verify.ts b/src/pages/api/passkeys/authenticate/verify.ts
new file mode 100644
index 0000000..c7325d1
--- /dev/null
+++ b/src/pages/api/passkeys/authenticate/verify.ts
@@ -0,0 +1,63 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { checkOrigin, currentUser, json, markReauthenticated, relyingParty, signIn } from '../../../../server/auth';
+import { getPasskey, getUser, updatePasskey } from '../../../../server/store';
+
+export const POST: APIRoute = async (ctx) => {
+  const bad = checkOrigin(ctx);
+  if (bad) return bad;
+  const { session, url, request } = ctx;
+  const { rpID, origin } = relyingParty(url);
+
+  const pending = await session?.get('passkeyChallenge');
+  session?.delete('passkeyChallenge');
+  if (!pending || (pending.purpose !== 'signin' && pending.purpose !== 'reauth') || pending.expires < Date.now()) {
+    return json({ error: 'Request expired. Please try again.' }, 400);
+  }
+
+  const body = await request.json().catch(() => ({}));
+  const response = body.credential;
+  const passkey = typeof response?.id === 'string' ? getPasskey(response.id) : undefined;
+  const fail = () => json({ error: 'Passkey sign-in failed.' }, 401);
+  if (!passkey) return fail();
+
+  if (pending.purpose === 'reauth') {
+    const user = await currentUser(session);
+    if (!user || user.id !== passkey.userId) return fail();
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: false,
+      credential: {
+        id: passkey.id,
+        publicKey: Buffer.from(passkey.publicKey, 'base64url'),
+        counter: passkey.counter,
+        transports: passkey.transports as any,
+      },
+    });
+  } catch {
+    return fail();
+  }
+  if (!verification.verified) return fail();
+
+  updatePasskey(passkey.id, {
+    counter: verification.authenticationInfo.newCounter,
+    backedUp: verification.authenticationInfo.credentialBackedUp,
+    lastUsedAt: Date.now(),
+  });
+
+  if (pending.purpose === 'reauth') {
+    await markReauthenticated(session);
+    return json({ verified: true });
+  }
+  const user = getUser(passkey.userId);
+  if (!user) return fail();
+  await signIn(session, user);
+  return json({ verified: true });
+};
diff --git a/src/pages/api/passkeys/index.ts b/src/pages/api/passkeys/index.ts
new file mode 100644
index 0000000..7649e18
--- /dev/null
+++ b/src/pages/api/passkeys/index.ts
@@ -0,0 +1,53 @@
+import type { APIRoute } from 'astro';
+import { checkOrigin, currentUser, hasRecentAuth, json, reauthRequired } from '../../../server/auth';
+import { deletePasskey, getPasskey, listPasskeys, updatePasskey } from '../../../server/store';
+
+const view = (p: ReturnType<typeof listPasskeys>[number]) => ({
+  id: p.id,
+  name: p.name,
+  deviceType: p.deviceType,
+  backedUp: p.backedUp,
+  createdAt: p.createdAt,
+  lastUsedAt: p.lastUsedAt,
+});
+
+export const GET: APIRoute = async ({ session }) => {
+  const user = await currentUser(session);
+  if (!user) return json({ error: 'Not signed in.' }, 401);
+  return json({
+    user: { username: user.username, source: user.source },
+    recentlyAuthenticated: await hasRecentAuth(session),
+    passkeys: listPasskeys(user.id).map(view),
+  });
+};
+
+/** Rename a passkey. */
+export const PATCH: APIRoute = async (ctx) => {
+  const bad = checkOrigin(ctx);
+  if (bad) return bad;
+  const user = await currentUser(ctx.session);
+  if (!user) return json({ error: 'Not signed in.' }, 401);
+  const { id, name } = await ctx.request.json().catch(() => ({}));
+  const passkey = typeof id === 'string' ? getPasskey(id) : undefined;
+  const trimmed = String(name ?? '').trim().slice(0, 60);
+  if (!passkey || passkey.userId !== user.id) return json({ error: 'Passkey not found.' }, 404);
+  if (!trimmed) return json({ error: 'Name is required.' }, 400);
+  updatePasskey(id, { name: trimmed });
+  return json({ ok: true });
+};
+
+/** Delete a passkey (needs a recent authentication). */
+export const DELETE: APIRoute = async (ctx) => {
+  const bad = checkOrigin(ctx);
+  if (bad) return bad;
+  const user = await currentUser(ctx.session);
+  if (!user) return json({ error: 'Not signed in.' }, 401);
+  if (!(await hasRecentAuth(ctx.session))) return reauthRequired();
+  const { id } = await ctx.request.json().catch(() => ({}));
+  // A passkey-only account must keep at least one passkey, or it is locked out.
+  if (user.source === 'passkey' && listPasskeys(user.id).length <= 1) {
+    return json({ error: 'You cannot remove the last passkey of a passkey-only account.' }, 400);
+  }
+  if (typeof id !== 'string' || !deletePasskey(user.id, id)) return json({ error: 'Passkey not found.' }, 404);
+  return json({ ok: true });
+};
diff --git a/src/pages/api/passkeys/register/options.ts b/src/pages/api/passkeys/register/options.ts
new file mode 100644
index 0000000..4fe2cb0
--- /dev/null
+++ b/src/pages/api/passkeys/register/options.ts
@@ -0,0 +1,58 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { randomBytes } from 'node:crypto';
+import { checkOrigin, currentUser, hasRecentAuth, json, reauthRequired, relyingParty } from '../../../../server/auth';
+import { findUser, listPasskeys } from '../../../../server/store';
+
+const USERNAME_RE = /^[A-Za-z0-9._-]{3,32}$/;
+
+/**
+ * Starts passkey registration. Signed-in users add a passkey to their account
+ * (needs a recent authentication); anonymous visitors create a new passkey-only account.
+ */
+export const POST: APIRoute = async (ctx) => {
+  const bad = checkOrigin(ctx);
+  if (bad) return bad;
+  const { session, url, request } = ctx;
+  const { rpID, rpName } = relyingParty(url);
+
+  const user = await currentUser(session);
+  let userId: string;
+  let username: string;
+  let exclude: { id: string; transports?: any[] }[] = [];
+
+  if (user) {
+    if (!(await hasRecentAuth(session))) return reauthRequired();
+    userId = user.id;
+    username = user.username;
+    exclude = listPasskeys(user.id).map((p) => ({ id: p.id, transports: p.transports as any }));
+  } else {
+    const body = await request.json().catch(() => ({}));
+    username = String(body.username ?? '').trim();
+    if (!USERNAME_RE.test(username)) {
+      return json({ error: 'Username must be 3-32 characters: letters, numbers, ".", "_" or "-".' }, 400);
+    }
+    if (findUser('passkey', username)) return json({ error: 'That username is already taken.' }, 409);
+    userId = randomBytes(32).toString('base64url');
+  }
+
+  const options = await generateRegistrationOptions({
+    rpID,
+    rpName,
+    userName: username,
+    userID: Buffer.from(userId, 'base64url'),
+    attestationType: 'none',
+    excludeCredentials: exclude,
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+  });
+
+  session?.set('passkeyChallenge', {
+    purpose: 'register',
+    challenge: options.challenge,
+    userId,
+    username,
+    existingUser: !!user,
+    expires: Date.now() + 5 * 60 * 1000,
+  });
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/register/verify.ts b/src/pages/api/passkeys/register/verify.ts
new file mode 100644
index 0000000..5d84b72
--- /dev/null
+++ b/src/pages/api/passkeys/register/verify.ts
@@ -0,0 +1,67 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { checkOrigin, currentUser, hasRecentAuth, json, reauthRequired, relyingParty, signIn } from '../../../../server/auth';
+import { addPasskey, createUser, findUser, getPasskey, listPasskeys } from '../../../../server/store';
+
+export const POST: APIRoute = async (ctx) => {
+  const bad = checkOrigin(ctx);
+  if (bad) return bad;
+  const { session, url, request } = ctx;
+  const { rpID, origin } = relyingParty(url);
+
+  const pending = await session?.get('passkeyChallenge');
+  session?.delete('passkeyChallenge');
+  if (!pending || pending.purpose !== 'register' || pending.expires < Date.now()) {
+    return json({ error: 'Registration expired. Please try again.' }, 400);
+  }
+
+  let user = await currentUser(session);
+  if (pending.existingUser) {
+    if (!user || user.id !== pending.userId) return json({ error: 'Session changed. Please try again.' }, 400);
+    if (!(await hasRecentAuth(session))) return reauthRequired();
+  } else if (user) {
+    return json({ error: 'Session changed. Please try again.' }, 400);
+  }
+
+  const body = await request.json().catch(() => ({}));
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body.credential,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: false,
+    });
+  } catch (e) {
+    return json({ error: `Could not verify passkey: ${(e as Error).message}` }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Could not verify passkey.' }, 400);
+
+  const { credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  if (getPasskey(credential.id)) return json({ error: 'This passkey is already registered.' }, 409);
+
+  let isNew = false;
+  if (!user) {
+    if (findUser('passkey', pending.username)) return json({ error: 'That username is already taken.' }, 409);
+    user = createUser('passkey', pending.username);
+    isNew = true;
+  }
+
+  const name = String(body.name ?? '').trim().slice(0, 60) || `Passkey ${listPasskeys(user.id).length + 1}`;
+  addPasskey({
+    id: credential.id,
+    userId: user.id,
+    publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    counter: credential.counter,
+    transports: credential.transports,
+    deviceType: credentialDeviceType,
+    backedUp: credentialBackedUp,
+    name,
+    createdAt: Date.now(),
+    lastUsedAt: null,
+  });
+
+  if (isNew) await signIn(session, user);
+  return json({ verified: true, newAccount: isNew });
+};
diff --git a/src/server/auth.ts b/src/server/auth.ts
new file mode 100644
index 0000000..452a620
--- /dev/null
+++ b/src/server/auth.ts
@@ -0,0 +1,60 @@
+import type { APIContext } from 'astro';
+import { getUser, type User } from './store';
+
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const REMOTE_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+type Ctx = Pick<APIContext, 'request' | 'session' | 'url'>;
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+/** WebAuthn relying party settings, overridable for deployments behind a proxy. */
+export function relyingParty(url: URL) {
+  return {
+    rpID: process.env.PASSKEY_RP_ID ?? url.hostname,
+    origin: process.env.PASSKEY_ORIGIN ?? url.origin,
+    rpName: 'The DevTools Times',
+  };
+}
+
+/** astro `security.checkOrigin` is disabled, so state-changing routes check it themselves. */
+export function checkOrigin({ request, url }: Ctx): Response | null {
+  const origin = request.headers.get('origin');
+  if (origin !== relyingParty(url).origin) return json({ error: 'Invalid origin' }, 403);
+  return null;
+}
+
+export async function currentUser(session: Ctx['session']): Promise<User | undefined> {
+  const id = await session?.get('userId');
+  return id ? getUser(id) : undefined;
+}
+
+/** Marks the session as authenticated now. Regenerates the session ID to prevent fixation. */
+export async function signIn(session: Ctx['session'], user: User) {
+  if (!session) throw new Error('Sessions are not available');
+  await session.regenerate();
+  session.set('userId', user.id);
+  session.set('authAt', Date.now());
+}
+
+export async function markReauthenticated(session: Ctx['session']) {
+  session?.set('authAt', Date.now());
+}
+
+export async function hasRecentAuth(session: Ctx['session']) {
+  const at = await session?.get('authAt');
+  return typeof at === 'number' && Date.now() - at < REAUTH_WINDOW_MS;
+}
+
+export const reauthRequired = () => json({ error: 'Please confirm it is you.', code: 'reauth_required' }, 403);
+
+export async function remotePasswordLogin(username: string, password: string) {
+  const res = await fetch(`${REMOTE_API}/login`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await res.json().catch(() => ({}));
+  return { ok: res.ok, error: data.error as string | undefined };
+}
diff --git a/src/server/store.ts b/src/server/store.ts
new file mode 100644
index 0000000..7f548e5
--- /dev/null
+++ b/src/server/store.ts
@@ -0,0 +1,103 @@
+import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+/**
+ * Minimal JSON-file store for local accounts and their passkeys.
+ * Password accounts live on the remote service; a local record is only created
+ * so that passkeys can be attached to them after a successful password sign-in.
+ */
+export type UserSource = 'passkey' | 'password';
+
+export interface User {
+  id: string; // random base64url, used as the WebAuthn user handle
+  username: string;
+  source: UserSource;
+  createdAt: number;
+}
+
+export interface Passkey {
+  id: string; // credential ID, base64url
+  userId: string;
+  publicKey: string; // base64url COSE key
+  counter: number;
+  transports?: string[];
+  deviceType: string;
+  backedUp: boolean;
+  name: string;
+  createdAt: number;
+  lastUsedAt: number | null;
+}
+
+interface Data {
+  users: User[];
+  passkeys: Passkey[];
+}
+
+const file = resolve(process.env.PASSKEY_STORE_PATH ?? 'data/passkeys.json');
+let data: Data | null = null;
+
+function load(): Data {
+  if (!data) {
+    data = existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : { users: [], passkeys: [] };
+  }
+  return data!;
+}
+
+function save() {
+  mkdirSync(dirname(file), { recursive: true });
+  const tmp = `${file}.${process.pid}.tmp`;
+  writeFileSync(tmp, JSON.stringify(data, null, 2), { mode: 0o600 });
+  renameSync(tmp, file);
+}
+
+const norm = (u: string) => u.trim().toLowerCase();
+
+export function findUser(source: UserSource, username: string): User | undefined {
+  return load().users.find((u) => u.source === source && norm(u.username) === norm(username));
+}
+
+export function getUser(id: string): User | undefined {
+  return load().users.find((u) => u.id === id);
+}
+
+export function createUser(source: UserSource, username: string): User {
+  const user: User = {
+    id: randomBytes(32).toString('base64url'),
+    username: username.trim(),
+    source,
+    createdAt: Date.now(),
+  };
+  load().users.push(user);
+  save();
+  return user;
+}
+
+export function listPasskeys(userId: string): Passkey[] {
+  return load().passkeys.filter((p) => p.userId === userId);
+}
+
+export function getPasskey(id: string): Passkey | undefined {
+  return load().passkeys.find((p) => p.id === id);
+}
+
+export function addPasskey(passkey: Passkey) {
+  load().passkeys.push(passkey);
+  save();
+}
+
+export function updatePasskey(id: string, patch: Partial<Pick<Passkey, 'name' | 'counter' | 'lastUsedAt' | 'backedUp'>>) {
+  const p = getPasskey(id);
+  if (!p) return;
+  Object.assign(p, patch);
+  save();
+}
+
+export function deletePasskey(userId: string, id: string): boolean {
+  const d = load();
+  const before = d.passkeys.length;
+  d.passkeys = d.passkeys.filter((p) => !(p.id === id && p.userId === userId));
+  if (d.passkeys.length === before) return false;
+  save();
+  return true;
+}
