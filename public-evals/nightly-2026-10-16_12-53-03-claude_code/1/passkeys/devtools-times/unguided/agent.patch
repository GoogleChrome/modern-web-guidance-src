diff --git a/src/components/passkeyClient.ts b/src/components/passkeyClient.ts
new file mode 100644
index 0000000..0fa2b03
--- /dev/null
+++ b/src/components/passkeyClient.ts
@@ -0,0 +1,51 @@
+import { startAuthentication, startRegistration, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+
+export const passkeysSupported = () => browserSupportsWebAuthn();
+
+export class ApiError extends Error {
+  constructor(message: string, public status: number, public code?: string) {
+    super(message);
+  }
+}
+
+export async function api<T = any>(path: string, method = 'POST', body?: unknown): Promise<T> {
+  const res = await fetch(`${import.meta.env.BASE_URL}api/${path}`, {
+    method,
+    headers: { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) throw new ApiError(data.error || 'Request failed', res.status, data.code);
+  return data;
+}
+
+function friendly(e: unknown): Error {
+  const err = e as Error;
+  if (err.name === 'NotAllowedError' || err.name === 'AbortError') return new Error('Passkey request was cancelled.');
+  if (err.name === 'InvalidStateError') return new Error('This passkey is already registered on this device.');
+  return err;
+}
+
+/** Registers a passkey: a new account when `username` is given, otherwise adds to the signed-in account. */
+export async function registerPasskey(opts: { username?: string; name?: string }) {
+  const options = await api('passkeys/register/options', 'POST', { username: opts.username });
+  let credential;
+  try {
+    credential = await startRegistration({ optionsJSON: options });
+  } catch (e) {
+    throw friendly(e);
+  }
+  return api('passkeys/register/verify', 'POST', { credential, name: opts.name });
+}
+
+/** Signs in (or reauthenticates) with a passkey. */
+export async function authenticateWithPasskey(purpose: 'signin' | 'reauth', opts: { auto?: boolean; signal?: AbortSignal } = {}) {
+  const options = await api('passkeys/authenticate/options', 'POST', { purpose });
+  let credential;
+  try {
+    credential = await startAuthentication({ optionsJSON: options, useBrowserAutofill: opts.auto });
+  } catch (e) {
+    throw friendly(e);
+  }
+  return api('passkeys/authenticate/verify', 'POST', { credential });
+}
