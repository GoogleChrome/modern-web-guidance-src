--- /dev/null
+++ b/src/pages/api/auth/reauth.ts
@@ -0,0 +1,18 @@
+import type { APIRoute } from 'astro';
+import { checkOrigin, currentUser, json, markReauthenticated, remotePasswordLogin } from '../../../server/auth';
+
+/** Reauthenticate a password account by re-entering its password. */
+export const POST: APIRoute = async (ctx) => {
+  const bad = checkOrigin(ctx);
+  if (bad) return bad;
+  const user = await currentUser(ctx.session);
+  if (!user) return json({ error: 'Not signed in.' }, 401);
+  if (user.source !== 'password') return json({ error: 'Use a passkey to confirm.' }, 400);
+  const { password } = await ctx.request.json().catch(() => ({}));
+  if (typeof password !== 'string' || !password) return json({ error: 'Password is required.' }, 400);
+  const result = await remotePasswordLogin(user.username, password).catch(() => null);
+  if (!result) return json({ error: 'Login service unavailable.' }, 502);
+  if (!result.ok) return json({ error: 'Incorrect password.' }, 401);
+  await markReauthenticated(ctx.session);
+  return json({ ok: true });
+};
