diff --git a/src/pages/api/auth/login.ts b/src/pages/api/auth/login.ts
new file mode 100644
index 0000000..a27f4e4
--- /dev/null
+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,22 @@
+import type { APIRoute } from 'astro';
+import { checkOrigin, json, remotePasswordLogin, signIn } from '../../../server/auth';
+import { createUser, findUser } from '../../../server/store';
+
+/** Password sign-in against the remote service, establishing a local session. */
+export const POST: APIRoute = async (ctx) => {
+  const bad = checkOrigin(ctx);
+  if (bad) return bad;
+  const { username, password } = await ctx.request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {
+    return json({ error: 'Username and password are required.' }, 400);
+  }
+  const result = await remotePasswordLogin(username, password).catch(() => null);
+  if (!result) return json({ error: 'Login service unavailable.' }, 502);
+  if (!result.ok) return json({ error: result.error ?? 'Unknown error' }, 401);
+
+  // Password and passkey accounts are separate namespaces, so a passkey-only
+  // account can never be reached with someone else's password login.
+  const user = findUser('password', username) ?? createUser('password', username);
+  await signIn(ctx.session, user);
+  return json({ ok: true });
+};
