diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..7dbfcd9
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,229 @@
+import React, { useEffect, useState } from 'react';
+import { ApiError, api, authenticateWithPasskey, passkeysSupported, registerPasskey } from './passkeyClient';
+
+interface PasskeyInfo {
+  id: string;
+  name: string;
+  deviceType: string;
+  backedUp: boolean;
+  createdAt: number;
+  lastUsedAt: number | null;
+}
+
+interface Account {
+  user: { username: string; source: 'passkey' | 'password' };
+  passkeys: PasskeyInfo[];
+}
+
+const fmt = (t: number | null) => (t ? new Date(t).toLocaleDateString() : 'Never');
+const btn = 'py-2 px-3 rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900';
+const primary = `${btn} text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75`;
+const secondary = `${btn} border border-gray-300 text-gray-900 hover:bg-gray-50`;
+
+export default function PasskeyManager() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [supported, setSupported] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [editing, setEditing] = useState<{ id: string; name: string } | null>(null);
+  // Action waiting for the user to confirm their identity.
+  const [reauth, setReauth] = useState<{ retry: () => Promise<void> } | null>(null);
+  const [password, setPassword] = useState('');
+
+  const refresh = async () => {
+    try {
+      setAccount(await api<Account>('passkeys', 'GET'));
+    } catch (e) {
+      if (e instanceof ApiError && e.status === 401) {
+        window.location.href = `${import.meta.env.BASE_URL}signin`;
+      } else {
+        setError((e as Error).message);
+      }
+    }
+  };
+
+  useEffect(() => {
+    setSupported(passkeysSupported());
+    refresh();
+  }, []);
+
+  /** Runs a sensitive action, asking the user to reauthenticate first if the server requires it. */
+  const sensitive = async (action: () => Promise<void>) => {
+    setError(null);
+    setNotice(null);
+    setBusy(true);
+    try {
+      await action();
+    } catch (e) {
+      if (e instanceof ApiError && e.code === 'reauth_required') {
+        setReauth({ retry: () => sensitive(action) });
+      } else {
+        setError((e as Error).message);
+      }
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const addPasskey = () =>
+    sensitive(async () => {
+      await registerPasskey({});
+      setNotice('Passkey added.');
+      await refresh();
+    });
+
+  const remove = (p: PasskeyInfo) => {
+    if (!window.confirm(`Remove "${p.name}"? You will no longer be able to sign in with it.`)) return;
+    sensitive(async () => {
+      await api('passkeys', 'DELETE', { id: p.id });
+      setNotice('Passkey removed.');
+      await refresh();
+    });
+  };
+
+  const rename = async () => {
+    if (!editing) return;
+    setError(null);
+    try {
+      await api('passkeys', 'PATCH', editing);
+      setEditing(null);
+      await refresh();
+    } catch (e) {
+      setError((e as Error).message);
+    }
+  };
+
+  const confirmWithPasskey = async () => {
+    const pending = reauth;
+    setError(null);
+    setBusy(true);
+    try {
+      await authenticateWithPasskey('reauth');
+      setReauth(null);
+      setBusy(false);
+      await pending?.retry();
+    } catch (e) {
+      setError((e as Error).message);
+      setBusy(false);
+    }
+  };
+
+  const confirmWithPassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const pending = reauth;
+    setError(null);
+    setBusy(true);
+    try {
+      await api('auth/reauth', 'POST', { password });
+      setPassword('');
+      setReauth(null);
+      setBusy(false);
+      await pending?.retry();
+    } catch (err) {
+      setError((err as Error).message);
+      setBusy(false);
+    }
+  };
+
+  const signOut = async () => {
+    await api('auth/logout');
+    window.location.href = import.meta.env.BASE_URL;
+  };
+
+  if (!account) {
+    return <p className="text-center text-gray-600">{error ?? 'Loading…'}</p>;
+  }
+
+  const canConfirmWithPasskey = account.passkeys.length > 0 && supported;
+  const canConfirmWithPassword = account.user.source === 'password';
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <div className="flex items-center justify-between mb-6">
+        <div>
+          <h2 className="text-2xl font-bold text-gray-800">Your account</h2>
+          <p className="text-sm text-gray-600">Signed in as {account.user.username}</p>
+        </div>
+        <button onClick={signOut} className={secondary}>Sign out</button>
+      </div>
+
+      {error && <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">{error}</div>}
+      {notice && <div className="mb-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">{notice}</div>}
+
+      {reauth && (
+        <div className="mb-6 p-4 border border-amber-300 bg-amber-50 rounded-lg" role="dialog" aria-label="Confirm it is you">
+          <h3 className="font-semibold text-gray-800 mb-1">Confirm it is you</h3>
+          <p className="text-sm text-gray-600 mb-3">For your security, please verify your identity to continue.</p>
+          <div className="space-y-3">
+            {canConfirmWithPasskey && (
+              <button onClick={confirmWithPasskey} disabled={busy} className={primary}>Use a passkey</button>
+            )}
+            {canConfirmWithPassword && (
+              <form onSubmit={confirmWithPassword} className="flex gap-2">
+                <label htmlFor="reauth-password" className="sr-only">Password</label>
+                <input
+                  id="reauth-password"
+                  type="password"
+                  autoComplete="current-password"
+                  value={password}
+                  onChange={(e) => setPassword(e.target.value)}
+                  required
+                  placeholder="Password"
+                  className="flex-1 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                />
+                <button type="submit" disabled={busy} className={primary}>Confirm</button>
+              </form>
+            )}
+            <button onClick={() => setReauth(null)} className={secondary}>Cancel</button>
+          </div>
+        </div>
+      )}
+
+      <div className="flex items-center justify-between mb-3">
+        <h3 className="text-lg font-semibold text-gray-800">Passkeys</h3>
+        {supported && <button onClick={addPasskey} disabled={busy} className={primary}>Add a passkey</button>}
+      </div>
+      {!supported && <p className="text-sm text-gray-600 mb-3">This browser does not support passkeys.</p>}
+
+      {account.passkeys.length === 0 ? (
+        <p className="text-sm text-gray-600">You have no passkeys yet. Add one to sign in without a password.</p>
+      ) : (
+        <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md">
+          {account.passkeys.map((p) => (
+            <li key={p.id} className="p-3 flex items-center justify-between gap-3">
+              {editing?.id === p.id ? (
+                <form onSubmit={(e) => { e.preventDefault(); rename(); }} className="flex flex-1 gap-2">
+                  <label htmlFor="passkey-name" className="sr-only">Passkey name</label>
+                  <input
+                    id="passkey-name"
+                    autoFocus
+                    value={editing.name}
+                    maxLength={60}
+                    onChange={(e) => setEditing({ id: p.id, name: e.target.value })}
+                    className="flex-1 px-3 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                  />
+                  <button type="submit" className={primary}>Save</button>
+                  <button type="button" onClick={() => setEditing(null)} className={secondary}>Cancel</button>
+                </form>
+              ) : (
+                <>
+                  <div>
+                    <p className="font-medium text-gray-800">{p.name}</p>
+                    <p className="text-xs text-gray-500">
+                      {p.backedUp ? 'Synced passkey' : 'Device-bound passkey'} · Added {fmt(p.createdAt)} · Last used {fmt(p.lastUsedAt)}
+                    </p>
+                  </div>
+                  <div className="flex gap-2">
+                    <button onClick={() => setEditing({ id: p.id, name: p.name })} className={secondary}>Rename</button>
+                    <button onClick={() => remove(p)} disabled={busy} className={secondary}>Remove</button>
+                  </div>
+                </>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
