+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { currentUser, json, rp, saveChallenge } from '../../../../lib/passkeys';
+
+export const prerender = false;
+
+/**
+ * body: { purpose: 'signin' | 'reauth' }
+ * signin uses discoverable credentials (no username needed);
+ * reauth is limited to the signed-in user's passkeys and requires user verification.
+ */
+export const POST: APIRoute = async (ctx) => {
+  const body = await ctx.request.json().catch(() => ({}));
+  const purpose = body.purpose === 'reauth' ? 'reauth' : 'signin';
+  const { rpID } = rp(ctx);
+
+  let allowCredentials;
+  if (purpose === 'reauth') {
+    const user = await currentUser(ctx);
+    if (!user) return json({ error: 'Not signed in.' }, 401);
+    allowCredentials = user.passkeys.map((p) => ({ id: p.id, transports: p.transports }));
+  }
+
+  const options = await generateAuthenticationOptions({
+    rpID,
+    allowCredentials,
+    userVerification: purpose === 'reauth' ? 'required' : 'preferred',
+  });
+  await saveChallenge(ctx, { purpose, challenge: options.challenge });
+  return json(options);
+};
