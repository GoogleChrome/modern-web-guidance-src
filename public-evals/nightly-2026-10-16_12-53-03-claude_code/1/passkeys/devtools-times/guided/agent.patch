@@ -0,0 +1,77 @@
+import React, { useEffect, useState } from 'react';
+import { describeError, passkeysSupported, signInWithPasskey } from '../lib/passkeyClient';
+
+const baseUrl = import.meta.env.BASE_URL;
+
+/** "Sign in with a passkey" button. Also enables passkey autofill on the username field. */
+export default function PasskeySignIn() {
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [supported, setSupported] = useState(false);
+
+  const finish = () => {
+    window.location.href = `${baseUrl}account`;
+  };
+
+  useEffect(() => {
+    setSupported(passkeysSupported());
+  }, []);
+
+  // Conditional UI: lets the browser offer passkeys in the username field's autofill.
+  useEffect(() => {
+    let cancelled = false;
+    (async () => {
+      if (!passkeysSupported()) return;
+      if (!(await PublicKeyCredential.isConditionalMediationAvailable?.())) return;
+      try {
+        await signInWithPasskey({ useBrowserAutofill: true });
+        if (!cancelled) finish();
+      } catch {
+        /* superseded by the button or dismissed */
+      }
+    })();
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  const handleClick = async () => {
+    setError(null);
+    setLoading(true);
+    try {
+      await signInWithPasskey();
+      finish();
+    } catch (e) {
+      setError(describeError(e));
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  if (!supported) return null;
+
+  return (
+    <div className="mb-6">
+      {error && (
+        <div className="mb-3 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+      <button
+        type="button"
+        onClick={handleClick}
+        disabled={loading}
+        className={`w-full py-2 px-4 border border-gray-900 rounded-md text-sm font-medium text-gray-900 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+          loading ? 'opacity-75 cursor-not-allowed' : ''
+        }`}
+      >
+        {loading ? 'Waiting for passkey…' : 'Sign in with a passkey'}
+      </button>
+      <div className="flex items-center my-5 text-xs text-gray-500" aria-hidden="true">
+        <span className="flex-1 border-t border-gray-200" />
+        <span className="px-3">or use your password</span>
+        <span className="flex-1 border-t border-gray-200" />
+      </div>
+    </div>
+  );
+}
