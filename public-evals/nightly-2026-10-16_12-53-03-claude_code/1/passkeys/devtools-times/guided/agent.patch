--- /dev/null
+++ b/src/pages/api/passkeys/[id].ts
@@ -0,0 +1,38 @@
+import type { APIRoute } from 'astro';
+import { currentUser, hasRecentAuth, json, reauthRequired, withDb } from '../../../lib/passkeys';
+
+export const prerender = false;
+
+/** Rename a passkey. */
+export const PATCH: APIRoute = async (ctx) => {
+  const user = await currentUser(ctx);
+  if (!user) return json({ error: 'Not signed in.' }, 401);
+  const body = await ctx.request.json().catch(() => ({}));
+  const name = typeof body.name === 'string' ? body.name.trim().slice(0, 60) : '';
+  if (!name) return json({ error: 'Name is required.' }, 400);
+
+  const ok = await withDb((db) => {
+    const p = db.users.find((u) => u.id === user.id)?.passkeys.find((k) => k.id === ctx.params.id);
+    if (p) p.name = name;
+    return !!p;
+  });
+  return ok ? json({ name }) : json({ error: 'Passkey not found.' }, 404);
+};
+
+/** Remove a passkey. Requires recent authentication; the last passkey cannot be removed. */
+export const DELETE: APIRoute = async (ctx) => {
+  const user = await currentUser(ctx);
+  if (!user) return json({ error: 'Not signed in.' }, 401);
+  if (!(await hasRecentAuth(ctx))) return reauthRequired();
+
+  const result = await withDb((db) => {
+    const u = db.users.find((x) => x.id === user.id);
+    if (!u?.passkeys.some((k) => k.id === ctx.params.id)) return 'missing' as const;
+    if (u.passkeys.length <= 1) return 'last' as const;
+    u.passkeys = u.passkeys.filter((k) => k.id !== ctx.params.id);
+    return 'ok' as const;
+  });
+  if (result === 'missing') return json({ error: 'Passkey not found.' }, 404);
+  if (result === 'last') return json({ error: 'You cannot remove your only passkey, or you would be locked out.' }, 409);
+  return json({ removed: true });
+};
