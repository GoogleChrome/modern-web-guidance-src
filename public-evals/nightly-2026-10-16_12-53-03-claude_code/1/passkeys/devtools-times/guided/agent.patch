@@ -0,0 +1,59 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import {
+  currentUser, findUserByCredentialId, json, markReauthenticated, rp, startSession, takeChallenge, withDb,
+} from '../../../../lib/passkeys';
+
+export const prerender = false;
+
+export const POST: APIRoute = async (ctx) => {
+  const state = await takeChallenge(ctx, ['signin', 'reauth']);
+  if (!state) return json({ error: 'Request expired. Please try again.' }, 400);
+
+  const body = await ctx.request.json().catch(() => null);
+  const response = body?.response;
+  if (!response?.id) return json({ error: 'Invalid request.' }, 400);
+
+  const user = await findUserByCredentialId(response.id);
+  const passkey = user?.passkeys.find((p) => p.id === response.id);
+  if (!user || !passkey) return json({ error: 'Passkey not recognized.' }, 401);
+
+  if (state.purpose === 'reauth') {
+    const me = await currentUser(ctx);
+    if (!me || me.id !== user.id) return json({ error: 'That passkey belongs to a different account.' }, 403);
+  }
+
+  const { origin, rpID } = rp(ctx);
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: state.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: state.purpose === 'reauth',
+      credential: {
+        id: passkey.id,
+        publicKey: Buffer.from(passkey.publicKey, 'base64url'),
+        counter: passkey.counter,
+        transports: passkey.transports,
+      },
+    });
+  } catch (e: any) {
+    return json({ error: `Could not verify passkey: ${e.message}` }, 401);
+  }
+  if (!verification.verified) return json({ error: 'Passkey verification failed.' }, 401);
+
+  await withDb((db) => {
+    const p = db.users.find((u) => u.id === user.id)?.passkeys.find((k) => k.id === passkey.id);
+    if (p) {
+      p.counter = verification.authenticationInfo.newCounter;
+      p.backedUp = verification.authenticationInfo.credentialBackedUp;
+      p.lastUsedAt = Date.now();
+    }
+  });
+
+  if (state.purpose === 'reauth') markReauthenticated(ctx);
+  else await startSession(ctx, user.id);
+  return json({ verified: true, username: user.username });
+};
