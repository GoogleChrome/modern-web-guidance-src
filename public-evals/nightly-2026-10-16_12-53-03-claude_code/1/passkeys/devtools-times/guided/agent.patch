diff --git a/src/lib/passkeyClient.ts b/src/lib/passkeyClient.ts
new file mode 100644
index 0000000..d891d3c
--- /dev/null
+++ b/src/lib/passkeyClient.ts
@@ -0,0 +1,67 @@
+import { startAuthentication, startRegistration, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+
+const api = (path: string) => `${import.meta.env.BASE_URL}api/passkeys${path}`;
+
+export class ApiError extends Error {
+  constructor(message: string, public status: number, public code?: string) {
+    super(message);
+  }
+}
+
+export async function call<T = any>(path: string, method = 'GET', body?: unknown): Promise<T> {
+  const res = await fetch(api(path), {
+    method,
+    headers: body ? { 'Content-Type': 'application/json' } : undefined,
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) throw new ApiError(data.message || data.error || 'Request failed', res.status, data.error);
+  return data;
+}
+
+export const passkeysSupported = () => typeof window !== 'undefined' && browserSupportsWebAuthn();
+
+/** Turns WebAuthn browser errors into friendly messages. Returns null if the user just cancelled. */
+export function describeError(e: unknown): string | null {
+  if (e instanceof ApiError) return e.message;
+  const err = e as Error;
+  if (err?.name === 'NotAllowedError' || err?.name === 'AbortError') return null;
+  if (err?.name === 'InvalidStateError') return 'This passkey is already registered on this device.';
+  return err?.message || 'Something went wrong. Please try again.';
+}
+
+/** Create a passkey; creates the account first when signed out (username required). */
+export async function registerPasskey(opts: { username?: string; name?: string } = {}) {
+  const options = await call('/register/options', 'POST', { username: opts.username });
+  const response = await startRegistration({ optionsJSON: options });
+  return call('/register/verify', 'POST', { response, name: opts.name });
+}
+
+export async function signInWithPasskey(opts: { useBrowserAutofill?: boolean; signal?: AbortSignal } = {}) {
+  const options = await call('/authenticate/options', 'POST', { purpose: 'signin' });
+  const response = await startAuthentication({ optionsJSON: options, useBrowserAutofill: opts.useBrowserAutofill });
+  return call('/authenticate/verify', 'POST', { response });
+}
+
+export async function reauthenticate() {
+  const options = await call('/authenticate/options', 'POST', { purpose: 'reauth' });
+  const response = await startAuthentication({ optionsJSON: options });
+  return call('/authenticate/verify', 'POST', { response });
+}
+
+/** Run a sensitive request; if the server asks for reauthentication, prompt for a passkey and retry once. */
+export async function withReauth<T>(fn: () => Promise<T>): Promise<T> {
+  try {
+    return await fn();
+  } catch (e) {
+    if (e instanceof ApiError && e.code === 'reauth_required') {
+      await reauthenticate();
+      return fn();
+    }
+    throw e;
+  }
+}
+
+export async function signOut() {
+  await call('/signout', 'POST', {});
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..993eadf
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,146 @@
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { randomBytes } from 'node:crypto';
+import type { APIContext } from 'astro';
+import type { AuthenticatorTransportFuture } from '@simplewebauthn/server';
+
+export const RP_NAME = 'The DevTools Times';
+/** How long a successful sign-in or reauthentication counts as "recent". */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export interface PasskeyRecord {
+  id: string; // base64url credential ID
+  publicKey: string; // base64url COSE public key
+  counter: number;
+  transports?: AuthenticatorTransportFuture[];
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  name: string;
+  createdAt: number;
+  lastUsedAt: number | null;
+}
+
+export interface UserRecord {
+  id: string; // base64url random user handle
+  username: string;
+  createdAt: number;
+  passkeys: PasskeyRecord[];
+}
+
+interface Db {
+  users: UserRecord[];
+}
+
+// ---- Storage (JSON file, serialized writes) ----
+
+const DB_PATH = process.env.PASSKEY_DB ?? path.join(process.cwd(), 'data', 'passkeys.json');
+let queue: Promise<unknown> = Promise.resolve();
+
+async function read(): Promise<Db> {
+  try {
+    return JSON.parse(await fs.readFile(DB_PATH, 'utf8'));
+  } catch (e: any) {
+    if (e.code === 'ENOENT') return { users: [] };
+    throw e;
+  }
+}
+
+/** Run a read-modify-write transaction; writes are serialized and atomic. */
+export function withDb<T>(fn: (db: Db) => T | Promise<T>): Promise<T> {
+  const run = queue.then(async () => {
+    const db = await read();
+    const result = await fn(db);
+    await fs.mkdir(path.dirname(DB_PATH), { recursive: true });
+    const tmp = `${DB_PATH}.${process.pid}.tmp`;
+    await fs.writeFile(tmp, JSON.stringify(db, null, 2));
+    await fs.rename(tmp, DB_PATH);
+    return result;
+  });
+  queue = run.catch(() => {});
+  return run;
+}
+
+export async function findUserById(id: string) {
+  return (await read()).users.find((u) => u.id === id) ?? null;
+}
+
+export async function findUserByUsername(username: string) {
+  const n = normalizeUsername(username);
+  return (await read()).users.find((u) => u.username.toLowerCase() === n) ?? null;
+}
+
+export async function findUserByCredentialId(credId: string) {
+  return (await read()).users.find((u) => u.passkeys.some((p) => p.id === credId)) ?? null;
+}
+
+export function normalizeUsername(s: unknown) {
+  return typeof s === 'string' ? s.trim().toLowerCase() : '';
+}
+
+export const USERNAME_RE = /^[a-z0-9._-]{3,32}$/i;
+
+export function newUserId() {
+  return randomBytes(32).toString('base64url');
+}
+
+// ---- Relying party ----
+
+export function rp(ctx: APIContext) {
+  const origin = process.env.PASSKEY_ORIGIN ?? ctx.url.origin;
+  return { origin, rpID: process.env.PASSKEY_RP_ID ?? new URL(origin).hostname };
+}
+
+// ---- Session state ----
+
+export type ChallengeState =
+  | { purpose: 'register'; challenge: string; expires: number; userId: string; username: string; isNew: boolean }
+  | { purpose: 'signin' | 'reauth'; challenge: string; expires: number };
+
+export async function saveChallenge(ctx: APIContext, state: Omit<ChallengeState, 'expires'>) {
+  ctx.session?.set('passkeyChallenge', { ...state, expires: Date.now() + CHALLENGE_TTL_MS });
+}
+
+/** Challenges are single-use: reading one removes it. */
+export async function takeChallenge<P extends ChallengeState['purpose']>(
+  ctx: APIContext,
+  purposes: P[],
+): Promise<Extract<ChallengeState, { purpose: P }> | null> {
+  const state = (await ctx.session?.get('passkeyChallenge')) as ChallengeState | undefined;
+  ctx.session?.delete('passkeyChallenge');
+  if (!state || state.expires < Date.now() || !purposes.includes(state.purpose as P)) return null;
+  return state as any;
+}
+
+export async function currentUser(ctx: APIContext) {
+  const id = await ctx.session?.get('userId');
+  return id ? findUserById(id) : null;
+}
+
+export async function startSession(ctx: APIContext, userId: string) {
+  await ctx.session?.regenerate();
+  ctx.session?.set('userId', userId);
+  ctx.session?.set('authenticatedAt', Date.now());
+}
+
+export function markReauthenticated(ctx: APIContext) {
+  ctx.session?.set('authenticatedAt', Date.now());
+}
+
+export async function hasRecentAuth(ctx: APIContext) {
+  const at = (await ctx.session?.get('authenticatedAt')) as number | undefined;
+  return !!at && Date.now() - at < REAUTH_WINDOW_MS;
+}
+
+// ---- Responses ----
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+}
+
+export const reauthRequired = () => json({ error: 'reauth_required', message: 'Please confirm it is you with your passkey.' }, 403);
+
+export function publicPasskey(p: PasskeyRecord) {
+  const { publicKey, counter, ...rest } = p;
+  return rest;
+}
