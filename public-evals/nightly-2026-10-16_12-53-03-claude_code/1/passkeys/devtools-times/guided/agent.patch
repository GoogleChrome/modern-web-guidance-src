@@ -0,0 +1,74 @@
+import React, { useEffect, useState } from 'react';
+import { describeError, passkeysSupported, registerPasskey } from '../lib/passkeyClient';
+
+const baseUrl = import.meta.env.BASE_URL;
+
+/** Create an account protected by a passkey instead of a password. */
+export default function PasskeySignUp() {
+  const [username, setUsername] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [supported, setSupported] = useState(false);
+
+  useEffect(() => {
+    setSupported(passkeysSupported());
+  }, []);
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setLoading(true);
+    try {
+      await registerPasskey({ username });
+      window.location.href = `${baseUrl}account`;
+    } catch (err) {
+      setError(describeError(err));
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  if (!supported) return null;
+
+  return (
+    <form onSubmit={handleSubmit} className="mb-6 space-y-3">
+      <p className="text-sm text-gray-600">Skip the password: sign up with a passkey using your fingerprint, face or screen lock.</p>
+      {error && (
+        <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+      <div>
+        <label htmlFor="passkey-username" className="block text-sm font-medium text-gray-700 mb-1">
+          Username
+        </label>
+        <input
+          type="text"
+          id="passkey-username"
+          value={username}
+          onChange={(e) => setUsername(e.target.value)}
+          required
+          minLength={3}
+          maxLength={32}
+          pattern="[A-Za-z0-9._\-]+"
+          autoComplete="username webauthn"
+          className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+        />
+      </div>
+      <button
+        type="submit"
+        disabled={loading}
+        className={`w-full py-2 px-4 border border-gray-900 rounded-md text-sm font-medium text-gray-900 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+          loading ? 'opacity-75 cursor-not-allowed' : ''
+        }`}
+      >
+        {loading ? 'Creating passkey…' : 'Sign up with a passkey'}
+      </button>
+      <div className="flex items-center pt-2 text-xs text-gray-500" aria-hidden="true">
+        <span className="flex-1 border-t border-gray-200" />
+        <span className="px-3">or use a password</span>
+        <span className="flex-1 border-t border-gray-200" />
+      </div>
+    </form>
+  );
+}
