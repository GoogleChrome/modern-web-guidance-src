diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..b06772b
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,143 @@
+import React, { useEffect, useState } from 'react';
+import { call, describeError, passkeysSupported, reauthenticate, registerPasskey, signOut, withReauth } from '../lib/passkeyClient';
+
+const baseUrl = import.meta.env.BASE_URL;
+
+interface Passkey {
+  id: string;
+  name: string;
+  deviceType: string;
+  backedUp: boolean;
+  createdAt: number;
+  lastUsedAt: number | null;
+}
+
+const fmt = (t: number) => new Date(t).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+const btn = 'text-xs font-semibold py-1.5 px-3 rounded border border-gray-300 text-gray-800 hover:bg-gray-50 disabled:opacity-60';
+
+export default function PasskeyManager({ username }: { username: string }) {
+  const [passkeys, setPasskeys] = useState<Passkey[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [editing, setEditing] = useState<string | null>(null);
+  const [draft, setDraft] = useState('');
+  const [supported, setSupported] = useState(true);
+
+  const load = async () => setPasskeys((await call('')).passkeys);
+
+  useEffect(() => {
+    setSupported(passkeysSupported());
+    load().catch((e) => setError(describeError(e)));
+  }, []);
+
+  const run = async (fn: () => Promise<unknown>, success?: string) => {
+    setError(null);
+    setNotice(null);
+    setBusy(true);
+    try {
+      await fn();
+      await load();
+      if (success) setNotice(success);
+    } catch (e) {
+      setError(describeError(e));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const add = () => run(() => withReauth(() => registerPasskey()), 'Passkey added.');
+  const remove = (p: Passkey) => {
+    if (!window.confirm(`Remove “${p.name}”? You will no longer be able to sign in with it.`)) return;
+    return run(() => withReauth(() => call(`/${encodeURIComponent(p.id)}`, 'DELETE')), 'Passkey removed.');
+  };
+  const rename = (p: Passkey) =>
+    run(async () => {
+      await call(`/${encodeURIComponent(p.id)}`, 'PATCH', { name: draft });
+      setEditing(null);
+    }, 'Passkey renamed.');
+  const confirm = () => run(() => reauthenticate(), 'Identity confirmed. Sensitive changes are unlocked for 5 minutes.');
+  const leave = async () => {
+    await signOut();
+    window.location.href = `${baseUrl}signin`;
+  };
+
+  return (
+    <div className="max-w-xl mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <div className="flex items-center justify-between mb-6">
+        <div>
+          <h2 className="text-2xl font-bold text-gray-800">Account</h2>
+          <p className="text-sm text-gray-600">Signed in as <strong>{username}</strong></p>
+        </div>
+        <button type="button" onClick={leave} className={btn}>Sign out</button>
+      </div>
+
+      <h3 className="text-lg font-semibold text-gray-800 mb-1">Passkeys</h3>
+      <p className="text-sm text-gray-600 mb-4">
+        Passkeys let you sign in with your fingerprint, face, or screen lock. Adding or removing one asks you to confirm with a passkey first.
+      </p>
+
+      {error && <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">{error}</div>}
+      {notice && <div className="mb-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">{notice}</div>}
+
+      {passkeys === null ? (
+        <p className="text-sm text-gray-500">Loading…</p>
+      ) : (
+        <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md mb-4">
+          {passkeys.map((p) => (
+            <li key={p.id} className="p-3 flex items-center justify-between gap-3">
+              {editing === p.id ? (
+                <form
+                  className="flex flex-1 gap-2"
+                  onSubmit={(e) => {
+                    e.preventDefault();
+                    rename(p);
+                  }}
+                >
+                  <input
+                    autoFocus
+                    aria-label="Passkey name"
+                    value={draft}
+                    maxLength={60}
+                    required
+                    onChange={(e) => setDraft(e.target.value)}
+                    className="flex-1 px-2 py-1 text-sm border border-gray-300 rounded-md"
+                  />
+                  <button type="submit" disabled={busy} className={btn}>Save</button>
+                  <button type="button" onClick={() => setEditing(null)} className={btn}>Cancel</button>
+                </form>
+              ) : (
+                <>
+                  <div className="min-w-0">
+                    <p className="text-sm font-medium text-gray-900 truncate">{p.name}</p>
+                    <p className="text-xs text-gray-500">
+                      {p.backedUp ? 'Synced' : 'This device only'} · Added {fmt(p.createdAt)} ·{' '}
+                      {p.lastUsedAt ? `Last used ${fmt(p.lastUsedAt)}` : 'Never used'}
+                    </p>
+                  </div>
+                  <div className="flex gap-2 shrink-0">
+                    <button type="button" disabled={busy} className={btn} onClick={() => { setEditing(p.id); setDraft(p.name); }}>Rename</button>
+                    <button type="button" disabled={busy || passkeys.length < 2} title={passkeys.length < 2 ? 'Add another passkey before removing your only one' : undefined} className={btn} onClick={() => remove(p)}>Remove</button>
+                  </div>
+                </>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+
+      <div className="flex flex-wrap gap-2">
+        <button
+          type="button"
+          onClick={add}
+          disabled={busy || !supported}
+          className="py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-60"
+        >
+          Add a passkey
+        </button>
+        <button type="button" onClick={confirm} disabled={busy || !supported} className={btn}>Confirm it’s me</button>
+      </div>
+      {!supported && <p className="mt-3 text-sm text-gray-500">This browser does not support passkeys.</p>}
+    </div>
+  );
+}
