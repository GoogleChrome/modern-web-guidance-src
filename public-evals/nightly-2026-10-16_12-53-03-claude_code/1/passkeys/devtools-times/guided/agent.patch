@@ -0,0 +1,45 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import {
+  RP_NAME, USERNAME_RE, currentUser, findUserByUsername, hasRecentAuth, json, newUserId,
+  normalizeUsername, reauthRequired, rp, saveChallenge,
+} from '../../../../lib/passkeys';
+
+export const prerender = false;
+
+/**
+ * Signed out: starts account creation with a first passkey (body: { username }).
+ * Signed in: starts adding another passkey; requires recent authentication.
+ */
+export const POST: APIRoute = async (ctx) => {
+  const body = await ctx.request.json().catch(() => ({}));
+  const existing = await currentUser(ctx);
+  let userId: string, username: string, excluded: { id: string; transports?: any }[] = [];
+
+  if (existing) {
+    if (!(await hasRecentAuth(ctx))) return reauthRequired();
+    ({ id: userId, username } = existing);
+    excluded = existing.passkeys;
+  } else {
+    username = normalizeUsername(body.username);
+    if (!USERNAME_RE.test(username)) {
+      return json({ error: 'Username must be 3–32 characters: letters, numbers, dots, dashes or underscores.' }, 400);
+    }
+    if (await findUserByUsername(username)) return json({ error: 'That username is already taken.' }, 409);
+    userId = newUserId();
+  }
+
+  const { rpID } = rp(ctx);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userID: Buffer.from(userId, 'base64url'),
+    userName: username,
+    attestationType: 'none',
+    excludeCredentials: excluded.map((p) => ({ id: p.id, transports: p.transports })),
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+  });
+
+  await saveChallenge(ctx, { purpose: 'register', challenge: options.challenge, userId, username, isNew: !existing });
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/register/verify.ts b/src/pages/api/passkeys/register/verify.ts
new file mode 100644
index 0000000..d896e46
--- /dev/null
+++ b/src/pages/api/passkeys/register/verify.ts
@@ -0,0 +1,69 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import {
+  currentUser, findUserByCredentialId, hasRecentAuth, json, reauthRequired, rp, startSession,
+  takeChallenge, withDb, type PasskeyRecord,
+} from '../../../../lib/passkeys';
+
+export const prerender = false;
+
+export const POST: APIRoute = async (ctx) => {
+  const state = await takeChallenge(ctx, ['register']);
+  if (!state) return json({ error: 'Registration expired. Please try again.' }, 400);
+
+  const existing = await currentUser(ctx);
+  if (state.isNew ? !!existing : existing?.id !== state.userId) return json({ error: 'Session changed. Please try again.' }, 400);
+  if (existing && !(await hasRecentAuth(ctx))) return reauthRequired();
+
+  const body = await ctx.request.json().catch(() => null);
+  if (!body?.response) return json({ error: 'Invalid request.' }, 400);
+
+  const { origin, rpID } = rp(ctx);
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body.response,
+      expectedChallenge: state.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+    });
+  } catch (e: any) {
+    return json({ error: `Could not verify passkey: ${e.message}` }, 400);
+  }
+  if (!verification.verified || !verification.registrationInfo) return json({ error: 'Passkey verification failed.' }, 400);
+
+  const { credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  if (await findUserByCredentialId(credential.id)) return json({ error: 'This passkey is already registered.' }, 409);
+
+  const name = (typeof body.name === 'string' && body.name.trim().slice(0, 60)) || defaultName(credentialDeviceType, credentialBackedUp);
+  const record: PasskeyRecord = {
+    id: credential.id,
+    publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    counter: credential.counter,
+    transports: credential.transports,
+    deviceType: credentialDeviceType,
+    backedUp: credentialBackedUp,
+    name,
+    createdAt: Date.now(),
+    lastUsedAt: null,
+  };
+
+  const result = await withDb((db) => {
+    if (state.isNew) {
+      if (db.users.some((u) => u.username.toLowerCase() === state.username)) return 'taken' as const;
+      db.users.push({ id: state.userId, username: state.username, createdAt: Date.now(), passkeys: [record] });
+    } else {
+      db.users.find((u) => u.id === state.userId)?.passkeys.push(record);
+    }
+    return 'ok' as const;
+  });
+  if (result === 'taken') return json({ error: 'That username is already taken.' }, 409);
+
+  if (state.isNew) await startSession(ctx, state.userId);
+  return json({ verified: true, name });
+};
+
+function defaultName(type: string, backedUp: boolean) {
+  const date = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
+  return `${type === 'multiDevice' || backedUp ? 'Synced passkey' : 'Device passkey'} · ${date}`;
+}
