+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <link rel="stylesheet" href="/site.css">
+  <link rel="stylesheet" href="/base.css">
+</head>
+<body>
+  <nav>
+    <a href="/" class="logo" style="color:white;text-decoration:none">THE DAILY GRIND</a>
+    <ul id="auth-nav"></ul>
+  </nav>
+  <main class="auth-box" style="max-width:640px">
+    <h1 id="hello">My Account</h1>
+    <p class="muted" id="email"></p>
+    <h2 style="margin-top:24px">Passkeys</h2>
+    <p class="muted">Passkeys let you sign in with your fingerprint, face, or screen lock. Add more than one so you never get locked out. Removing a passkey or adding a new one asks you to confirm with a passkey first.</p>
+    <ul class="pk-list" id="list"></ul>
+    <button class="btn" id="add">Add a passkey</button>
+    <div id="msg" class="msg" role="alert"></div>
+    <h2 style="margin-top:32px">Danger zone</h2>
+    <button class="btn danger" id="delete-account">Delete account</button>
+  </main>
+  <script type="module">
+    import { initNav } from '/nav.js';
+    import { api, addPasskey, withReauth, passkeysSupported } from '/passkeys.js';
+    const msg = document.getElementById('msg');
+    const show = (text, kind = 'error') => { msg.textContent = text; msg.className = 'msg ' + kind; };
+    const fmt = (t) => (t ? new Date(t).toLocaleDateString(undefined, { dateStyle: 'medium' }) : 'never');
+
+    const user = await initNav();
+    if (!user) location.href = '/login?next=/account';
+    document.getElementById('hello').textContent = `Hi, ${user.displayName}`;
+    document.getElementById('email').textContent = user.username;
+    if (!passkeysSupported()) document.getElementById('add').disabled = true;
+
+    function render(passkeys) {
+      const list = document.getElementById('list');
+      list.replaceChildren(...passkeys.map((p) => {
+        const li = document.createElement('li');
+        const info = document.createElement('div');
+        const name = document.createElement('strong');
+        name.textContent = p.name;
+        const meta = document.createElement('div');
+        meta.className = 'muted';
+        meta.textContent = `Added ${fmt(p.createdAt)} · Last used ${fmt(p.lastUsedAt)}${p.backedUp ? ' · Synced' : ''}`;
+        info.append(name, meta);
+        const actions = document.createElement('div');
+        actions.className = 'pk-actions';
+        const rename = document.createElement('button');
+        rename.className = 'btn secondary'; rename.textContent = 'Rename';
+        rename.onclick = () => attempt(async () => {
+          const n = prompt('Passkey name', p.name);
+          if (n === null) return;
+          render((await api('PATCH', '/api/passkeys', { id: p.id, name: n })).passkeys);
+        });
+        const del = document.createElement('button');
+        del.className = 'btn danger'; del.textContent = 'Remove';
+        del.onclick = () => attempt(async () => {
+          if (!confirm(`Remove “${p.name}”? You won’t be able to sign in with it anymore.`)) return;
+          render((await withReauth(() => api('DELETE', '/api/passkeys', { id: p.id }))).passkeys);
+          show('Passkey removed.', 'ok');
+        });
+        actions.append(rename, del);
+        li.append(info, actions);
+        return li;
+      }));
+    }
+    async function attempt(fn) {
+      msg.className = 'msg';
+      try { await fn(); } catch (e) { if (e.status === 401) location.href = '/login?next=/account'; else show(e.message); }
+    }
+
+    render((await api('GET', '/api/passkeys')).passkeys);
+    document.getElementById('add').onclick = () => attempt(async () => {
+      render((await withReauth(addPasskey)).passkeys);
+      show('Passkey added.', 'ok');
+    });
+    document.getElementById('delete-account').onclick = () => attempt(async () => {
+      if (!confirm('Permanently delete your account and all passkeys?')) return;
+      await withReauth(() => api('DELETE', '/api/account'));
+      location.href = '/';
+    });
+  </script>
+</body>
+</html>
