+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Sign in | The Daily Grind</title>
+  <link rel="stylesheet" href="/site.css">
+  <link rel="stylesheet" href="/base.css">
+</head>
+<body>
+  <nav>
+    <a href="/" class="logo" style="color:white;text-decoration:none">THE DAILY GRIND</a>
+    <ul id="auth-nav"></ul>
+  </nav>
+  <main class="auth-box">
+    <h1>Sign in</h1>
+    <p class="muted">No passwords here. Use a passkey saved on your device, password manager, or security key.</p>
+    <button class="btn" id="signin" style="width:100%">Sign in with a passkey</button>
+    <div class="divider">— or create an account —</div>
+    <form id="register">
+      <label>Email <input type="email" name="username" autocomplete="username webauthn" required></label>
+      <label>Name <input type="text" name="displayName" autocomplete="name" maxlength="64"></label>
+      <button class="btn secondary" type="submit" style="width:100%">Create account with a passkey</button>
+    </form>
+    <div id="msg" class="msg" role="alert"></div>
+    <p class="muted" id="unsupported" hidden>This browser doesn’t support passkeys.</p>
+  </main>
+  <script type="module">
+    import { initNav } from '/nav.js';
+    import { signIn, registerAccount, passkeysSupported } from '/passkeys.js';
+    const msg = document.getElementById('msg');
+    const show = (text, kind = 'error') => { msg.textContent = text; msg.className = 'msg ' + kind; };
+    const next = () => new URLSearchParams(location.search).get('next');
+    // Only allow same-site relative redirects.
+    const go = () => { const n = next(); location.href = n && /^\/(?!\/)/.test(n) ? n : '/account'; };
+
+    initNav().then((u) => { if (u) go(); });
+    if (!passkeysSupported()) {
+      document.getElementById('unsupported').hidden = false;
+      document.querySelectorAll('button').forEach((b) => (b.disabled = true));
+    }
+
+    async function run(btn, fn) {
+      btn.disabled = true; msg.className = 'msg';
+      try { await fn(); go(); }
+      catch (e) { if (!e.cancelled) show(e.message); else show(e.message); btn.disabled = false; }
+    }
+    document.getElementById('signin').onclick = (e) => run(e.target, signIn);
+    document.getElementById('register').onsubmit = (e) => {
+      e.preventDefault();
+      const f = new FormData(e.target);
+      run(e.target.querySelector('button'), () => registerAccount(f.get('username'), f.get('displayName')));
+    };
+  </script>
+</body>
+</html>
