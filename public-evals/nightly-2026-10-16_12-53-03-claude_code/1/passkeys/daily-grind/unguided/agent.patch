+import { api, logout } from './passkeys.js';
+
+// Swaps the nav's account/logout links based on session state. Returns the current user (or null).
+export async function initNav() {
+  const slot = document.getElementById('auth-nav');
+  const { user } = await api('GET', '/api/me').catch(() => ({ user: null }));
+  if (user) {
+    slot.innerHTML = '<li><a href="/account">My Account</a></li><li><button type="button" class="logout-link nav-btn" id="logout">Logout</button></li>';
+    document.getElementById('logout').onclick = async () => { await logout(); location.href = '/'; };
+  } else {
+    slot.innerHTML = '<li><a href="/login" class="logout-link">Sign in</a></li>';
+  }
+  return user;
+}
