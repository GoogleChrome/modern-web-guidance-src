+// Static file server + passkey (WebAuthn) API. Data is persisted to data.json.
+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from '@simplewebauthn/server';
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT || 11222);
+const RP_NAME = 'The Daily Grind';
+// RP ID / origin are derived from the request host unless pinned via env.
+const RP_ID_ENV = process.env.RP_ID;
+const ORIGIN_ENV = process.env.ORIGIN;
+const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const SESSION_TTL_MS = 7 * 24 * 60 * 60 * 1000;
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+const DB_FILE = path.join(ROOT, 'data.json');
+
+// ---- storage ----
+// db.users[id] = { id, username, displayName, passkeys: [{ id, publicKey(b64url), counter, transports, name, createdAt, lastUsedAt, deviceType, backedUp }] }
+let db = { users: {} };
+try { db = JSON.parse(fs.readFileSync(DB_FILE, 'utf8')); } catch {}
+const save = () => fs.writeFileSync(DB_FILE, JSON.stringify(db, null, 2));
+const b64u = (buf) => Buffer.from(buf).toString('base64url');
+const fromB64u = (s) => new Uint8Array(Buffer.from(s, 'base64url'));
+const findByUsername = (name) =>
+  Object.values(db.users).find((u) => u.username.toLowerCase() === name.toLowerCase());
+const findByCredential = (id) => {
+  for (const u of Object.values(db.users)) {
+    const pk = u.passkeys.find((p) => p.id === id);
+    if (pk) return { user: u, passkey: pk };
+  }
+};
+
+// ---- sessions (in-memory) ----
+const sessions = new Map(); // sid -> { userId, reauthAt, challenge, challengeKind, challengeExp, pending, expires }
+function getSession(req, res, create = false) {
+  const cookies = Object.fromEntries(
+    (req.headers.cookie || '').split(/;\s*/).filter(Boolean).map((c) => {
+      const i = c.indexOf('=');
+      return [c.slice(0, i), c.slice(i + 1)];
+    }),
+  );
+  let sid = cookies.sid;
+  let s = sid && sessions.get(sid);
+  if (s && s.expires < Date.now()) { sessions.delete(sid); s = null; }
+  if (!s && create) {
+    sid = crypto.randomBytes(32).toString('base64url');
+    s = { expires: Date.now() + SESSION_TTL_MS };
+    sessions.set(sid, s);
+    const secure = isSecure(req) ? '; Secure' : '';
+    res.setHeader('Set-Cookie', `sid=${sid}; HttpOnly; SameSite=Lax; Path=/; Max-Age=${SESSION_TTL_MS / 1000}${secure}`);
+  }
+  if (s) s.sid = sid;
+  return s;
+}
+const isSecure = (req) => req.headers['x-forwarded-proto'] === 'https';
+function destroySession(req, res) {
+  const s = getSession(req, res);
+  if (s) sessions.delete(s.sid);
+  res.setHeader('Set-Cookie', 'sid=; HttpOnly; SameSite=Lax; Path=/; Max-Age=0');
+}
+// Rotate the session id on privilege change to prevent fixation.
+function rotateSession(req, res, s) {
+  sessions.delete(s.sid);
+  const sid = crypto.randomBytes(32).toString('base64url');
+  const fresh = { expires: Date.now() + SESSION_TTL_MS };
+  sessions.set(sid, fresh);
+  fresh.sid = sid;
+  const secure = isSecure(req) ? '; Secure' : '';
+  res.setHeader('Set-Cookie', `sid=${sid}; HttpOnly; SameSite=Lax; Path=/; Max-Age=${SESSION_TTL_MS / 1000}${secure}`);
+  return fresh;
+}
+
+// ---- helpers ----
+class HttpError extends Error {
+  constructor(status, message, code) { super(message); this.status = status; this.code = code; }
+}
+const send = (res, status, body) => {
+  res.writeHead(status, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' });
+  res.end(JSON.stringify(body));
+};
+async function readJson(req) {
+  let size = 0;
+  const chunks = [];
+  for await (const c of req) {
+    size += c.length;
+    if (size > 100_000) throw new HttpError(413, 'Request too large');
+    chunks.push(c);
+  }
+  if (!chunks.length) return {};
+  try { return JSON.parse(Buffer.concat(chunks).toString('utf8')); }
+  catch { throw new HttpError(400, 'Invalid JSON'); }
+}
+function rp(req) {
+  const host = req.headers.host || `localhost:${PORT}`;
+  const proto = isSecure(req) ? 'https' : 'http';
+  return {
+    rpID: RP_ID_ENV || host.replace(/:\d+$/, ''),
+    origin: ORIGIN_ENV || `${proto}://${host}`,
+  };
+}
+function setChallenge(s, kind, challenge, extra = {}) {
+  Object.assign(s, { challenge, challengeKind: kind, challengeExp: Date.now() + CHALLENGE_TTL_MS, ...extra });
+}
+// Challenges are single-use: consumed whether or not verification succeeds.
+function takeChallenge(s, kind) {
+  const ok = s.challenge && s.challengeKind === kind && s.challengeExp > Date.now();
+  const c = ok ? s.challenge : null;
+  const pending = s.pending;
+  delete s.challenge; delete s.challengeKind; delete s.challengeExp; delete s.pending;
+  if (!c) throw new HttpError(400, 'Challenge expired. Please try again.');
+  return { challenge: c, pending };
+}
+function requireUser(req, res) {
+  const s = getSession(req, res);
+  const user = s?.userId && db.users[s.userId];
+  if (!user) throw new HttpError(401, 'Not signed in');
+  return { s, user };
+}
+function requireRecentAuth(s) {
+  if (!s.reauthAt || Date.now() - s.reauthAt > REAUTH_WINDOW_MS)
+    throw new HttpError(403, 'Please confirm it’s you with your passkey.', 'reauth_required');
+}
+const publicPasskey = (p) => ({
+  id: p.id, name: p.name, createdAt: p.createdAt, lastUsedAt: p.lastUsedAt,
+  deviceType: p.deviceType, backedUp: p.backedUp,
+});
+const defaultName = (transports = [], deviceType) =>
+  transports.includes('internal') ? 'This device' : deviceType === 'multiDevice' ? 'Synced passkey' : 'Security key';
+
+function startSession(req, res, user, authedNow = true) {
+  let s = getSession(req, res, true);
+  s = rotateSession(req, res, s);
+  s.userId = user.id;
+  if (authedNow) s.reauthAt = Date.now();
+  return s;
+}
+
+// ---- rate limiting (per IP, simple fixed window on /api/*) ----
+const hits = new Map();
+function rateLimit(req) {
+  const ip = req.socket.remoteAddress;
+  const now = Date.now();
+  const h = hits.get(ip);
+  if (!h || h.reset < now) hits.set(ip, { count: 1, reset: now + 60_000 });
+  else if (++h.count > 60) throw new HttpError(429, 'Too many requests. Try again shortly.');
+}
+
+// ---- routes ----
+const routes = {};
+const route = (method, p, fn) => { routes[`${method} ${p}`] = fn; };
+
+route('GET', '/api/me', async (req, res) => {
+  const s = getSession(req, res);
+  const user = s?.userId && db.users[s.userId];
+  if (!user) return send(res, 200, { user: null });
+  send(res, 200, {
+    user: { username: user.username, displayName: user.displayName },
+    recentlyAuthenticated: !!s.reauthAt && Date.now() - s.reauthAt <= REAUTH_WINDOW_MS,
+  });
+});
+
+// Registration: create a new account with a first passkey.
+route('POST', '/api/register/options', async (req, res) => {
+  const { username, displayName } = await readJson(req);
+  const name = String(username || '').trim();
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(name) || name.length > 254)
+    throw new HttpError(400, 'Enter a valid email address.');
+  if (findByUsername(name)) throw new HttpError(409, 'An account with that email already exists. Try signing in.');
+  const { rpID } = rp(req);
+  const userID = crypto.randomBytes(32);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME, rpID, userName: name,
+    userDisplayName: String(displayName || '').trim().slice(0, 64) || name,
+    userID,
+    attestationType: 'none', supportedAlgorithmIDs: [-7, -257, -8],
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+  });
+  const s = getSession(req, res, true);
+  setChallenge(s, 'register', options.challenge, {
+    pending: { userId: b64u(userID), username: name, displayName: String(displayName || '').trim().slice(0, 64) || name },
+  });
+  send(res, 200, options);
+});
+
+route('POST', '/api/register/verify', async (req, res) => {
+  const body = await readJson(req);
+  const s = getSession(req, res);
+  if (!s) throw new HttpError(400, 'Session expired. Please try again.');
+  const { challenge, pending } = takeChallenge(s, 'register');
+  if (!pending) throw new HttpError(400, 'Invalid registration state');
+  if (findByUsername(pending.username)) throw new HttpError(409, 'An account with that email already exists.');
+  const { rpID, origin } = rp(req);
+  const v = await verifyRegistrationResponse({
+    response: body, expectedChallenge: challenge, expectedOrigin: origin, expectedRPID: rpID,
+  }).catch(() => { throw new HttpError(400, 'Passkey registration could not be verified.'); });
+  if (!v.verified) throw new HttpError(400, 'Passkey registration could not be verified.');
+  const { credential, credentialDeviceType, credentialBackedUp } = v.registrationInfo;
+  if (findByCredential(credential.id)) throw new HttpError(409, 'That passkey is already registered.');
+  const user = {
+    id: pending.userId, username: pending.username, displayName: pending.displayName,
+    passkeys: [{
+      id: credential.id, publicKey: b64u(credential.publicKey), counter: credential.counter,
+      transports: credential.transports || [], name: defaultName(credential.transports, credentialDeviceType),
+      createdAt: Date.now(), lastUsedAt: null, deviceType: credentialDeviceType, backedUp: credentialBackedUp,
+    }],
+  };
+  db.users[user.id] = user;
+  save();
+  startSession(req, res, user);
+  send(res, 200, { user: { username: user.username, displayName: user.displayName } });
+});
+
+// Authentication: usernameless (discoverable credentials) sign-in.
+route('POST', '/api/login/options', async (req, res) => {
+  const { rpID } = rp(req);
+  const options = await generateAuthenticationOptions({ rpID, userVerification: 'preferred' });
+  const s = getSession(req, res, true);
+  setChallenge(s, 'login', options.challenge);
+  send(res, 200, options);
+});
+
+async function verifyAssertion(req, res, kind, expectedUserId) {
+  const body = await readJson(req);
+  const s = getSession(req, res);
+  if (!s) throw new HttpError(400, 'Session expired. Please try again.');
+  const { challenge } = takeChallenge(s, kind);
+  const found = findByCredential(body?.id);
+  if (!found || (expectedUserId && found.user.id !== expectedUserId))
+    throw new HttpError(401, 'Passkey not recognized.');
+  const { rpID, origin } = rp(req);
+  const { user, passkey } = found;
+  const v = await verifyAuthenticationResponse({
+    response: body, expectedChallenge: challenge, expectedOrigin: origin, expectedRPID: rpID,
+    credential: { id: passkey.id, publicKey: fromB64u(passkey.publicKey), counter: passkey.counter, transports: passkey.transports },
+  }).catch(() => { throw new HttpError(401, 'Passkey verification failed.'); });
+  if (!v.verified) throw new HttpError(401, 'Passkey verification failed.');
+  passkey.counter = v.authenticationInfo.newCounter;
+  passkey.backedUp = v.authenticationInfo.credentialBackedUp;
+  passkey.lastUsedAt = Date.now();
+  save();
+  return { user, s };
+}
+
+route('POST', '/api/login/verify', async (req, res) => {
+  const { user } = await verifyAssertion(req, res, 'login');
+  startSession(req, res, user);
+  send(res, 200, { user: { username: user.username, displayName: user.displayName } });
+});
+
+route('POST', '/api/logout', async (req, res) => {
+  destroySession(req, res);
+  send(res, 200, { ok: true });
+});
+
+// Reauthentication: prove presence of one of the signed-in user's passkeys.
+route('POST', '/api/reauth/options', async (req, res) => {
+  const { s, user } = requireUser(req, res);
+  const { rpID } = rp(req);
+  const options = await generateAuthenticationOptions({
+    rpID, userVerification: 'required',
+    allowCredentials: user.passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+  });
+  setChallenge(s, 'reauth', options.challenge);
+  send(res, 200, options);
+});
+
+route('POST', '/api/reauth/verify', async (req, res) => {
+  const { s, user } = requireUser(req, res);
+  const out = await verifyAssertion(req, res, 'reauth', user.id);
+  out.s.reauthAt = Date.now();
+  send(res, 200, { ok: true });
+});
+
+// Management
+route('GET', '/api/passkeys', async (req, res) => {
+  const { user } = requireUser(req, res);
+  send(res, 200, { passkeys: user.passkeys.map(publicPasskey) });
+});
+
+route('POST', '/api/passkeys/options', async (req, res) => {
+  const { s, user } = requireUser(req, res);
+  requireRecentAuth(s);
+  const { rpID } = rp(req);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME, rpID, userName: user.username, userDisplayName: user.displayName,
+    userID: fromB64u(user.id), attestationType: 'none', supportedAlgorithmIDs: [-7, -257, -8],
+    excludeCredentials: user.passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+  });
+  setChallenge(s, 'add', options.challenge);
+  send(res, 200, options);
+});
+
+route('POST', '/api/passkeys/verify', async (req, res) => {
+  const body = await readJson(req);
+  const { s, user } = requireUser(req, res);
+  const { challenge } = takeChallenge(s, 'add');
+  requireRecentAuth(s);
+  const { rpID, origin } = rp(req);
+  const v = await verifyRegistrationResponse({
+    response: body, expectedChallenge: challenge, expectedOrigin: origin, expectedRPID: rpID,
+  }).catch(() => { throw new HttpError(400, 'Passkey registration could not be verified.'); });
+  if (!v.verified) throw new HttpError(400, 'Passkey registration could not be verified.');
+  const { credential, credentialDeviceType, credentialBackedUp } = v.registrationInfo;
+  if (findByCredential(credential.id)) throw new HttpError(409, 'That passkey is already registered.');
+  user.passkeys.push({
+    id: credential.id, publicKey: b64u(credential.publicKey), counter: credential.counter,
+    transports: credential.transports || [], name: defaultName(credential.transports, credentialDeviceType),
+    createdAt: Date.now(), lastUsedAt: null, deviceType: credentialDeviceType, backedUp: credentialBackedUp,
+  });
+  save();
+  send(res, 200, { passkeys: user.passkeys.map(publicPasskey) });
+});
+
+route('PATCH', '/api/passkeys', async (req, res) => {
+  const { user } = requireUser(req, res);
+  const { id, name } = await readJson(req);
+  const pk = user.passkeys.find((p) => p.id === id);
+  const clean = String(name || '').trim().slice(0, 40);
+  if (!pk) throw new HttpError(404, 'Passkey not found');
+  if (!clean) throw new HttpError(400, 'Name cannot be empty.');
+  pk.name = clean;
+  save();
+  send(res, 200, { passkeys: user.passkeys.map(publicPasskey) });
+});
+
+route('DELETE', '/api/passkeys', async (req, res) => {
+  const { s, user } = requireUser(req, res);
+  requireRecentAuth(s);
+  const { id } = await readJson(req);
+  const i = user.passkeys.findIndex((p) => p.id === id);
+  if (i < 0) throw new HttpError(404, 'Passkey not found');
+  if (user.passkeys.length === 1)
+    throw new HttpError(400, 'You can’t remove your only passkey. Add another first, or delete your account.');
+  user.passkeys.splice(i, 1);
+  save();
+  send(res, 200, { passkeys: user.passkeys.map(publicPasskey) });
+});
+
+route('DELETE', '/api/account', async (req, res) => {
+  const { s, user } = requireUser(req, res);
+  requireRecentAuth(s);
+  delete db.users[user.id];
+  save();
+  for (const [sid, sess] of sessions) if (sess.userId === user.id) sessions.delete(sid);
+  destroySession(req, res);
+  send(res, 200, { ok: true });
+});
+
+// ---- static ----
+const PAGES = { '/': 'index.html', '/login': 'login.html', '/account': 'account.html' };
+const TYPES = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript', '.css': 'text/css', '.svg': 'image/svg+xml' };
+const PUBLIC_FILES = new Set(['nav.js', 'index.html', 'login.html', 'account.html', 'passkeys.js', 'site.css', 'base.css']);
+
+function serveStatic(req, res, pathname) {
+  const file = PAGES[pathname] || pathname.replace(/^\//, '');
+  if (!PUBLIC_FILES.has(file)) {
+    res.writeHead(404, { 'Content-Type': 'text/plain' });
+    return res.end('Not found');
+  }
+  fs.readFile(path.join(ROOT, file), (err, data) => {
+    if (err) { res.writeHead(404); return res.end('Not found'); }
+    res.writeHead(200, { 'Content-Type': TYPES[path.extname(file)] || 'application/octet-stream' });
+    res.end(data);
+  });
+}
+
+http.createServer(async (req, res) => {
+  const { pathname } = new URL(req.url, 'http://x');
+  try {
+    if (pathname.startsWith('/api/')) {
+      const fn = routes[`${req.method} ${pathname}`];
+      if (!fn) throw new HttpError(404, 'Not found');
+      rateLimit(req);
+      // CSRF defense for state-changing requests: require same-origin.
+      if (req.method !== 'GET') {
+        const origin = req.headers.origin;
+        if (!origin || new URL(origin).host !== req.headers.host) throw new HttpError(403, 'Cross-origin request blocked');
+      }
+      return await fn(req, res);
+    }
+    if (req.method !== 'GET' && req.method !== 'HEAD') { res.writeHead(405); return res.end(); }
+    serveStatic(req, res, pathname);
+  } catch (e) {
+    if (!(e instanceof HttpError)) console.error(e);
+    const status = e instanceof HttpError ? e.status : 500;
+    send(res, status, { error: e instanceof HttpError ? e.message : 'Something went wrong', code: e.code });
+  }
+}).listen(PORT, () => console.log(`The Daily Grind running on http://localhost:${PORT}`));
