--- /dev/null
+++ b/public/login.js
@@ -0,0 +1,104 @@
+import {
+  api,
+  ApiError,
+  getMe,
+  passkeyCapabilities,
+  signalUnknownCredential,
+  showMessage,
+} from "/common.js";
+
+const form = document.getElementById("auth-form");
+const message = document.getElementById("message");
+const title = document.getElementById("title");
+const submit = document.getElementById("submit");
+const toggle = document.getElementById("toggle");
+const displayNameField = document.getElementById("display-name-field");
+const passwordInput = document.getElementById("password");
+const passkeySection = document.getElementById("passkey-section");
+const passkeyBtn = document.getElementById("passkey-btn");
+
+const { rpId, user } = await getMe();
+if (user) location.replace("/account");
+
+let signingUp = false;
+let autofillAbort = new AbortController();
+
+toggle.addEventListener("click", () => {
+  signingUp = !signingUp;
+  title.textContent = signingUp ? "Create an account" : "Sign in";
+  submit.textContent = signingUp ? "Create account" : "Sign in";
+  toggle.textContent = signingUp ? "I already have an account" : "Create an account";
+  displayNameField.hidden = !signingUp;
+  passwordInput.autocomplete = signingUp ? "new-password" : "current-password";
+  showMessage(message, "");
+});
+
+form.addEventListener("submit", async (event) => {
+  event.preventDefault();
+  const data = Object.fromEntries(new FormData(form));
+  try {
+    await api("POST", signingUp ? "/api/signup" : "/api/login", data);
+    location.href = "/account";
+  } catch (err) {
+    showMessage(message, err.message, "error");
+  }
+});
+
+// Verify the assertion; the server answers 404 when it doesn't know the credential.
+async function finishPasskeySignIn(credential) {
+  const encoded = credential.toJSON();
+  try {
+    await api("POST", "/api/passkey/login/verify", encoded);
+    location.href = "/account";
+  } catch (err) {
+    showMessage(message, err.message, "error");
+    if (err instanceof ApiError && err.status === 404) {
+      await signalUnknownCredential(rpId, encoded.id);
+    }
+    startConditionalAutofill();
+  }
+}
+
+async function startConditionalAutofill() {
+  autofillAbort.abort();
+  autofillAbort = new AbortController();
+  const options = await api("POST", "/api/passkey/login/options");
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+  let credential;
+  try {
+    credential = await navigator.credentials.get({
+      publicKey,
+      signal: autofillAbort.signal,
+      mediation: "conditional",
+    });
+  } catch (err) {
+    if (!["NotAllowedError", "AbortError"].includes(err.name)) console.error(err);
+    return;
+  }
+  await finishPasskeySignIn(credential);
+}
+
+passkeyBtn.addEventListener("click", async () => {
+  autofillAbort.abort();
+  autofillAbort = new AbortController();
+  showMessage(message, "");
+  let credential;
+  try {
+    const options = await api("POST", "/api/passkey/login/options");
+    credential = await navigator.credentials.get({
+      publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(options),
+      signal: autofillAbort.signal,
+    });
+  } catch (err) {
+    if (err.name !== "NotAllowedError" && err.name !== "AbortError") {
+      showMessage(message, err.message, "error");
+    }
+    startConditionalAutofill();
+    return;
+  }
+  await finishPasskeySignIn(credential);
+});
+
+const caps = await passkeyCapabilities();
+passkeySection.hidden = !caps.available && !caps.conditional;
+if (caps.conditional) startConditionalAutofill();
