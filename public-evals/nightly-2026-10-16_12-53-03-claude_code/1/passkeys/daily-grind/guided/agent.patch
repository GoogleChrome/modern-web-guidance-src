@@ -0,0 +1,574 @@
+import http from "node:http";
+import crypto from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from "@simplewebauthn/server";
+
+const PORT = Number(process.env.PORT || 11222);
+const RP_ID = process.env.RP_ID || "localhost";
+const RP_NAME = "The Daily Grind";
+const ORIGIN = process.env.ORIGIN || `http://localhost:${PORT}`;
+const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const SESSION_TTL_MS = 7 * 24 * 60 * 60 * 1000;
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+const AAGUID_REGISTRY_URL =
+  "https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json";
+const ZERO_AAGUID = "00000000-0000-0000-0000-000000000000";
+
+const root = path.dirname(fileURLToPath(import.meta.url));
+const publicDir = path.join(root, "public");
+const dbFile = process.env.DB_FILE || path.join(root, "data.json");
+
+// ---------- Storage (JSON file) ----------
+
+const db = fs.existsSync(dbFile)
+  ? JSON.parse(fs.readFileSync(dbFile, "utf8"))
+  : { users: [], credentials: [] };
+
+function save() {
+  const tmp = `${dbFile}.tmp`;
+  fs.writeFileSync(tmp, JSON.stringify(db, null, 2), { mode: 0o600 });
+  fs.renameSync(tmp, dbFile);
+}
+
+const findUserById = (id) => db.users.find((u) => u.id === id);
+const findUserByName = (name) =>
+  db.users.find((u) => u.username.toLowerCase() === name.toLowerCase());
+const findCredential = (id) => db.credentials.find((c) => c.id === id);
+const userCredentials = (userId) =>
+  db.credentials.filter((c) => c.passkeyUserId === userId);
+
+// ---------- Passwords ----------
+
+function hashPassword(password) {
+  const salt = crypto.randomBytes(16);
+  const hash = crypto.scryptSync(password, salt, 64);
+  return `${salt.toString("base64")}:${hash.toString("base64")}`;
+}
+
+function checkPassword(password, stored) {
+  const [salt, hash] = stored.split(":").map((s) => Buffer.from(s, "base64"));
+  const candidate = crypto.scryptSync(password, salt, hash.length);
+  return crypto.timingSafeEqual(candidate, hash);
+}
+
+// A throwaway hash so unknown usernames cost the same as wrong passwords.
+const DUMMY_HASH = hashPassword("dummy-password");
+
+// ---------- Sessions ----------
+
+const sessions = new Map();
+
+function newSession() {
+  const sid = crypto.randomBytes(32).toString("base64url");
+  const session = { userId: null, reauthAt: 0, challenge: null, createdAt: Date.now() };
+  sessions.set(sid, session);
+  return { sid, session };
+}
+
+function parseCookies(req) {
+  const out = {};
+  for (const part of (req.headers.cookie || "").split(";")) {
+    const i = part.indexOf("=");
+    if (i > 0) out[part.slice(0, i).trim()] = part.slice(i + 1).trim();
+  }
+  return out;
+}
+
+function getSession(req, res) {
+  const sid = parseCookies(req).sid;
+  let session = sid && sessions.get(sid);
+  if (session && Date.now() - session.createdAt > SESSION_TTL_MS) {
+    sessions.delete(sid);
+    session = null;
+  }
+  if (session) return { sid, session };
+  const created = newSession();
+  setSessionCookie(req, res, created.sid);
+  return created;
+}
+
+function setSessionCookie(req, res, sid) {
+  const secure = ORIGIN.startsWith("https:") ? "; Secure" : "";
+  res.setHeader(
+    "Set-Cookie",
+    `sid=${sid}; HttpOnly; SameSite=Lax; Path=/; Max-Age=${SESSION_TTL_MS / 1000}${secure}`,
+  );
+}
+
+// Issue a fresh session id on privilege change to prevent fixation.
+function signIn(req, res, ctx, user) {
+  sessions.delete(ctx.sid);
+  const { sid, session } = newSession();
+  session.userId = user.id;
+  session.reauthAt = Date.now();
+  setSessionCookie(req, res, sid);
+  ctx.sid = sid;
+  ctx.session = session;
+}
+
+function takeChallenge(session, kind) {
+  const c = session.challenge;
+  session.challenge = null;
+  if (!c || c.kind !== kind || Date.now() - c.createdAt > CHALLENGE_TTL_MS) return null;
+  return c;
+}
+
+// ---------- Helpers ----------
+
+class HttpError extends Error {
+  constructor(status, message, code) {
+    super(message);
+    this.status = status;
+    this.code = code;
+  }
+}
+
+async function readJson(req) {
+  if (!(req.headers["content-type"] || "").startsWith("application/json")) {
+    throw new HttpError(415, "Expected application/json");
+  }
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > 100_000) throw new HttpError(413, "Body too large");
+    chunks.push(chunk);
+  }
+  try {
+    return JSON.parse(Buffer.concat(chunks).toString("utf8") || "{}");
+  } catch {
+    throw new HttpError(400, "Invalid JSON");
+  }
+}
+
+function sendJson(res, status, body) {
+  res.writeHead(status, { "Content-Type": "application/json", "Cache-Control": "no-store" });
+  res.end(JSON.stringify(body));
+}
+
+const str = (v, max) => (typeof v === "string" ? v.trim().slice(0, max) : "");
+
+// Simple in-memory throttle for password attempts.
+const attempts = new Map();
+function throttle(key) {
+  const now = Date.now();
+  const rec = (attempts.get(key) || []).filter((t) => now - t < 15 * 60 * 1000);
+  if (rec.length >= 10) throw new HttpError(429, "Too many attempts. Try again later.");
+  rec.push(now);
+  attempts.set(key, rec);
+}
+
+// ---------- AAGUID registry (UX hint only) ----------
+
+const FALLBACK_PROVIDERS = {
+  "fbfc3007-154e-4ecc-8c0b-6e020557d7bd": "iCloud Keychain",
+  "ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4": "Google Password Manager",
+  "adce0002-35bc-c60a-648b-0b25f1f05503": "Chrome on Mac",
+  "08987058-cadc-4b81-b6e1-30de50dcbe96": "Windows Hello",
+  "bada5566-a7aa-401f-bd96-45619a55120d": "1Password",
+  "d548826e-79b4-db40-a3d8-11116f7e8349": "Bitwarden",
+  "531126d6-e717-415c-9320-3d9aa6981239": "Dashlane",
+};
+let registry = null;
+let registryLoading = null;
+
+function loadRegistry() {
+  registryLoading ??= fetch(AAGUID_REGISTRY_URL, { signal: AbortSignal.timeout(8000) })
+    .then((r) => (r.ok ? r.json() : null))
+    .then((json) => {
+      registry = json;
+    })
+    .catch(() => {});
+  return registryLoading;
+}
+loadRegistry();
+
+function providerFor(aaguid, userAgent) {
+  if (aaguid === ZERO_AAGUID) {
+    return { name: deviceName(userAgent) || "Unknown passkey provider", icon: undefined };
+  }
+  const entry = registry?.[aaguid];
+  return {
+    name: entry?.name || FALLBACK_PROVIDERS[aaguid] || "Unknown passkey provider",
+    icon: entry?.icon_light,
+  };
+}
+
+function deviceName(ua = "") {
+  if (/iPhone|iPad/.test(ua)) return "iOS device";
+  if (/Android/.test(ua)) return "Android device";
+  if (/Macintosh/.test(ua)) return "Mac";
+  if (/Windows/.test(ua)) return "Windows PC";
+  if (/Linux/.test(ua)) return "Linux device";
+  return "";
+}
+
+const publicCredential = (c) => ({
+  id: c.id,
+  name: c.name,
+  providerIcon: c.providerIcon,
+  aaguid: c.aaguid,
+  credentialDeviceType: c.credentialDeviceType,
+  credentialBackedUp: c.credentialBackedUp,
+  registeredAt: c.registeredAt,
+  lastUsedAt: c.lastUsedAt,
+});
+
+const publicUser = (u) => ({
+  id: u.id,
+  username: u.username,
+  displayName: u.displayName,
+  webauthnUserId: u.webauthnUserId,
+});
+
+// ---------- API routes ----------
+
+function requireUser(ctx) {
+  const user = ctx.session.userId && findUserById(ctx.session.userId);
+  if (!user) throw new HttpError(401, "Not signed in");
+  return user;
+}
+
+function requireRecentAuth(ctx) {
+  if (Date.now() - ctx.session.reauthAt > REAUTH_WINDOW_MS) {
+    throw new HttpError(403, "Please confirm your identity first.", "reauth_required");
+  }
+}
+
+const decodeKey = (b64) => new Uint8Array(Buffer.from(b64, "base64url"));
+
+const routes = {
+  "GET /api/me": (req, res, ctx) => {
+    const user = ctx.session.userId && findUserById(ctx.session.userId);
+    return { rpId: RP_ID, user: user ? publicUser(user) : null };
+  },
+
+  "POST /api/signup": async (req, res, ctx) => {
+    const body = await readJson(req);
+    const username = str(body.username, 40);
+    const displayName = str(body.displayName, 60) || username;
+    const password = typeof body.password === "string" ? body.password : "";
+    if (!/^[\w.@+-]{3,40}$/.test(username)) throw new HttpError(400, "Username must be 3-40 letters, numbers or . _ @ + -");
+    if (password.length < 8) throw new HttpError(400, "Password must be at least 8 characters.");
+    if (findUserByName(username)) throw new HttpError(409, "That username is taken.");
+    const user = {
+      id: crypto.randomUUID(),
+      username,
+      displayName,
+      pwHash: hashPassword(password),
+      // Random handle sent to authenticators; never contains personal data.
+      webauthnUserId: crypto.randomBytes(32).toString("base64url"),
+    };
+    db.users.push(user);
+    save();
+    signIn(req, res, ctx, user);
+    return { user: publicUser(user) };
+  },
+
+  "POST /api/login": async (req, res, ctx) => {
+    const body = await readJson(req);
+    const username = str(body.username, 40);
+    const password = typeof body.password === "string" ? body.password : "";
+    throttle(`login:${username.toLowerCase()}`);
+    const user = findUserByName(username);
+    const ok = checkPassword(password, user ? user.pwHash : DUMMY_HASH);
+    if (!user || !ok) throw new HttpError(401, "Incorrect username or password.");
+    signIn(req, res, ctx, user);
+    return { user: publicUser(user) };
+  },
+
+  "POST /api/logout": (req, res, ctx) => {
+    sessions.delete(ctx.sid);
+    return { success: true };
+  },
+
+  // ----- Passkey authentication (discoverable, no username needed) -----
+
+  "POST /api/passkey/login/options": async (req, res, ctx) => {
+    const options = await generateAuthenticationOptions({
+      rpID: RP_ID,
+      allowCredentials: [],
+      userVerification: "preferred",
+    });
+    ctx.session.challenge = {
+      kind: "login",
+      value: options.challenge,
+      userVerification: "preferred",
+      createdAt: Date.now(),
+    };
+    return options;
+  },
+
+  "POST /api/passkey/login/verify": async (req, res, ctx) => {
+    const response = await readJson(req);
+    const expected = takeChallenge(ctx.session, "login");
+    if (!expected) throw new HttpError(400, "Sign-in expired. Please try again.");
+    const cred = findCredential(response.id);
+    if (!cred) throw new HttpError(404, "Passkey not recognized.");
+    const user = findUserById(cred.passkeyUserId);
+    const info = await verifyAssertion(response, expected, cred);
+    recordUse(cred, info);
+    signIn(req, res, ctx, user);
+    return { user: publicUser(user) };
+  },
+
+  // ----- Registration -----
+
+  "POST /api/passkey/register/options": async (req, res, ctx) => {
+    const user = requireUser(ctx);
+    requireRecentAuth(ctx);
+    const body = await readJson(req);
+    const promotion = body.promotion === true;
+    const options = await generateRegistrationOptions({
+      rpName: RP_NAME,
+      rpID: RP_ID,
+      userName: user.username,
+      userDisplayName: user.displayName,
+      userID: decodeKey(user.webauthnUserId),
+      attestationType: "none",
+      supportedAlgorithmIDs: [-7, -257],
+      excludeCredentials: userCredentials(user.id).map((c) => ({
+        id: c.id,
+        transports: c.transports,
+      })),
+      authenticatorSelection: {
+        residentKey: "required",
+        requireResidentKey: true,
+        userVerification: "preferred",
+        // Management flow omits attachment so security keys can be added too.
+        ...(promotion && { authenticatorAttachment: "platform" }),
+      },
+    });
+    ctx.session.challenge = { kind: "register", value: options.challenge, createdAt: Date.now() };
+    return options;
+  },
+
+  "POST /api/passkey/register/verify": async (req, res, ctx) => {
+    const user = requireUser(ctx);
+    requireRecentAuth(ctx);
+    const response = await readJson(req);
+    const expected = takeChallenge(ctx.session, "register");
+    if (!expected) throw new HttpError(400, "Registration expired. Please try again.");
+    let result;
+    try {
+      result = await verifyRegistrationResponse({
+        response,
+        expectedChallenge: expected.value,
+        expectedOrigin: ORIGIN,
+        expectedRPID: RP_ID,
+        requireUserVerification: false, // options asked for "preferred"
+      });
+    } catch (err) {
+      throw new HttpError(400, `Could not verify passkey: ${err.message}`);
+    }
+    if (!result.verified) throw new HttpError(400, "Could not verify passkey.");
+    const { credential, aaguid, credentialDeviceType, credentialBackedUp } = result.registrationInfo;
+    if (findCredential(credential.id)) throw new HttpError(409, "That passkey is already registered.");
+    await loadRegistry();
+    const provider = providerFor(aaguid, req.headers["user-agent"]);
+    const stored = {
+      id: credential.id,
+      passkeyUserId: user.id,
+      credentialPublicKey: Buffer.from(credential.publicKey).toString("base64url"),
+      credentialType: "public-key",
+      credentialDeviceType,
+      credentialBackedUp,
+      aaguid,
+      providerIcon: provider.icon,
+      name: provider.name,
+      transports: credential.transports || response.response?.transports || [],
+      registeredAt: Date.now(),
+      counter: credential.counter,
+    };
+    db.credentials.push(stored);
+    save();
+    return { credential: publicCredential(stored) };
+  },
+
+  // ----- Reauthentication -----
+
+  "POST /api/reauth/options": async (req, res, ctx) => {
+    const user = requireUser(ctx);
+    const creds = userCredentials(user.id);
+    if (!creds.length) throw new HttpError(400, "No passkeys registered.");
+    const options = await generateAuthenticationOptions({
+      rpID: RP_ID,
+      // Constrained to the signed-in user's credentials only.
+      allowCredentials: creds.map((c) => ({ id: c.id, transports: c.transports })),
+      userVerification: "preferred",
+    });
+    ctx.session.challenge = {
+      kind: "reauth",
+      value: options.challenge,
+      userVerification: "preferred",
+      createdAt: Date.now(),
+    };
+    return options;
+  },
+
+  "POST /api/reauth/verify": async (req, res, ctx) => {
+    const user = requireUser(ctx);
+    const response = await readJson(req);
+    const expected = takeChallenge(ctx.session, "reauth");
+    if (!expected) throw new HttpError(400, "Verification expired. Please try again.");
+    const cred = findCredential(response.id);
+    if (!cred) throw new HttpError(404, "Passkey not recognized.");
+    if (cred.passkeyUserId !== user.id) throw new HttpError(403, "That passkey belongs to a different account.");
+    const info = await verifyAssertion(response, expected, cred);
+    recordUse(cred, info);
+    ctx.session.reauthAt = Date.now();
+    return { success: true };
+  },
+
+  "POST /api/reauth/password": async (req, res, ctx) => {
+    const user = requireUser(ctx);
+    const body = await readJson(req);
+    throttle(`reauth:${user.id}`);
+    if (!checkPassword(typeof body.password === "string" ? body.password : "", user.pwHash)) {
+      throw new HttpError(401, "Incorrect password.");
+    }
+    ctx.session.reauthAt = Date.now();
+    return { success: true };
+  },
+
+  // ----- Management -----
+
+  "GET /api/credentials": (req, res, ctx) => {
+    const user = requireUser(ctx);
+    return userCredentials(user.id).map(publicCredential);
+  },
+
+  "PUT /api/user": async (req, res, ctx) => {
+    const user = requireUser(ctx);
+    const body = await readJson(req);
+    const displayName = str(body.displayName, 60);
+    if (!displayName) throw new HttpError(400, "Display name is required.");
+    user.displayName = displayName;
+    save();
+    return publicUser(user);
+  },
+
+  "PUT /api/password": async (req, res, ctx) => {
+    const user = requireUser(ctx);
+    requireRecentAuth(ctx);
+    const body = await readJson(req);
+    if (typeof body.password !== "string" || body.password.length < 8) {
+      throw new HttpError(400, "Password must be at least 8 characters.");
+    }
+    user.pwHash = hashPassword(body.password);
+    save();
+    return { success: true };
+  },
+};
+
+async function verifyAssertion(response, expected, cred) {
+  let result;
+  try {
+    result = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: expected.value,
+      expectedOrigin: ORIGIN,
+      expectedRPID: RP_ID,
+      requireUserVerification: expected.userVerification === "required",
+      credential: {
+        id: cred.id,
+        publicKey: decodeKey(cred.credentialPublicKey),
+        counter: cred.counter,
+        transports: cred.transports,
+      },
+    });
+  } catch (err) {
+    throw new HttpError(400, `Could not verify passkey: ${err.message}`);
+  }
+  if (!result.verified) throw new HttpError(401, "Could not verify passkey.");
+  return result.authenticationInfo;
+}
+
+function recordUse(cred, info) {
+  cred.counter = info.newCounter;
+  cred.credentialBackedUp = info.credentialBackedUp;
+  cred.lastUsedAt = Date.now();
+  save();
+}
+
+const credentialRoute = /^\/api\/credential\/([\w-]+)$/;
+
+async function handleCredentialRoute(req, res, ctx, id) {
+  const user = requireUser(ctx);
+  const cred = findCredential(id);
+  if (!cred || cred.passkeyUserId !== user.id) throw new HttpError(404, "Credential not found.");
+  if (req.method === "PUT") {
+    const name = str((await readJson(req)).name, 60);
+    if (!name) throw new HttpError(400, "Name is required.");
+    cred.name = name;
+    save();
+    return publicCredential(cred);
+  }
+  if (req.method === "DELETE") {
+    requireRecentAuth(ctx);
+    db.credentials = db.credentials.filter((c) => c.id !== id);
+    save();
+    return { success: true };
+  }
+  throw new HttpError(405, "Method not allowed");
+}
+
+// ---------- Static files & pages ----------
+
+const pages = { "/": "index.html", "/login": "login.html", "/account": "account.html" };
+const mime = {
+  ".html": "text/html; charset=utf-8",
+  ".css": "text/css; charset=utf-8",
+  ".js": "text/javascript; charset=utf-8",
+};
+
+function serveStatic(res, urlPath) {
+  const file = pages[urlPath] || urlPath.slice(1);
+  const full = path.join(publicDir, file);
+  const type = mime[path.extname(full)];
+  if (!type || !full.startsWith(publicDir + path.sep) || !fs.existsSync(full)) {
+    res.writeHead(404, { "Content-Type": "text/plain" });
+    return res.end("Not found");
+  }
+  res.writeHead(200, { "Content-Type": type, "X-Content-Type-Options": "nosniff" });
+  fs.createReadStream(full).pipe(res);
+}
+
+const server = http.createServer(async (req, res) => {
+  const { pathname } = new URL(req.url, ORIGIN);
+  try {
+    if (pathname.startsWith("/api/")) {
+      const ctx = getSession(req, res);
+      const cm = pathname.match(credentialRoute);
+      const handler = cm
+        ? () => handleCredentialRoute(req, res, ctx, cm[1])
+        : routes[`${req.method} ${pathname}`] &&
+          (() => routes[`${req.method} ${pathname}`](req, res, ctx));
+      if (!handler) throw new HttpError(404, "Not found");
+      return sendJson(res, 200, await handler());
+    }
+    if (req.method === "GET" && pathname === "/logout") {
+      sessions.delete(parseCookies(req).sid);
+      res.writeHead(302, { Location: "/" });
+      return res.end();
+    }
+    if (req.method !== "GET") throw new HttpError(405, "Method not allowed");
+    serveStatic(res, pathname);
+  } catch (err) {
+    if (!(err instanceof HttpError)) console.error(err);
+    const status = err instanceof HttpError ? err.status : 500;
+    sendJson(res, status, {
+      error: err instanceof HttpError ? err.message : "Internal server error",
+      code: err.code,
+    });
+  }
+});
+
+server.listen(PORT, () => console.log(`The Daily Grind running at ${ORIGIN}`));
