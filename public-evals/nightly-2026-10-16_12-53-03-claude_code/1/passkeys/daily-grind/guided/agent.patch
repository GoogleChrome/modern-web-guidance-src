+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css">
+</head>
+
+<body>
+  <nav>
+    <a class="logo" href="/" style="text-decoration: none">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/">Home</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li id="auth-item"><a href="/login" class="logout-link">Sign in</a></li>
+    </ul>
+  </nav>
+
+  <main class="container">
+    <p id="message" class="message" role="status"></p>
+
+    <section class="panel wide">
+      <h2>Profile</h2>
+      <form id="profile-form">
+        <div class="field">
+          <label for="profile-name">Display name</label>
+          <input id="profile-name" name="displayName" autocomplete="name" required>
+        </div>
+        <p>Signed in as <strong id="username"></strong></p>
+        <div class="actions">
+          <button class="btn" type="submit">Save</button>
+        </div>
+      </form>
+    </section>
+
+    <section class="panel wide" aria-labelledby="passkeys-heading">
+      <h2 id="passkeys-heading">Passkeys</h2>
+      <p>Passkeys let you sign in with your fingerprint, face or screen lock instead of a password.</p>
+      <ul id="passkey-list" class="passkey-list"></ul>
+      <p id="passkey-empty" hidden>No passkeys found.</p>
+      <div class="actions">
+        <button class="btn" type="button" id="create-passkey" hidden>Create a passkey</button>
+      </div>
+      <p id="passkey-unsupported" hidden>This browser or device doesn't support passkeys.</p>
+    </section>
+
+    <section class="panel wide">
+      <h2>Change password</h2>
+      <form id="password-form">
+        <div class="field">
+          <label for="new-password">New password</label>
+          <input id="new-password" type="password" autocomplete="new-password" minlength="8" required>
+        </div>
+        <div class="actions">
+          <button class="btn" type="submit">Update password</button>
+        </div>
+      </form>
+    </section>
+  </main>
+
+  <dialog id="reauth-dialog" aria-labelledby="reauth-title">
+    <h2 id="reauth-title">Confirm it's you</h2>
+    <p>For your security, please verify your identity to continue.</p>
+    <p id="reauth-message" class="message" role="status"></p>
+    <button class="btn" type="button" id="reauth-passkey" hidden>Verify with passkey</button>
+    <form id="reauth-password-form">
+      <div class="field">
+        <label for="reauth-password">Password</label>
+        <input id="reauth-password" type="password" autocomplete="current-password" required>
+      </div>
+      <div class="actions">
+        <button class="btn" type="submit">Verify with password</button>
+        <button class="btn secondary" type="button" id="reauth-cancel">Cancel</button>
+      </div>
+    </form>
+  </dialog>
+
+  <dialog id="rename-dialog" aria-labelledby="rename-title">
+    <h2 id="rename-title">Rename passkey</h2>
+    <form id="rename-form" method="dialog">
+      <div class="field">
+        <label for="rename-input">Name</label>
+        <input id="rename-input" maxlength="60" required>
+      </div>
+      <div class="actions">
+        <button class="btn" type="submit" value="save">Save</button>
+        <button class="btn secondary" type="submit" value="cancel" formnovalidate>Cancel</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script type="module" src="/nav.js"></script>
+  <script type="module" src="/account.js"></script>
+</body>
+
+</html>
diff --git a/public/account.js b/public/account.js
new file mode 100644
index 0000000..01fb25c
--- /dev/null
+++ b/public/account.js
@@ -0,0 +1,250 @@
+import {
+  api,
+  ApiError,
+  getMe,
+  passkeyCapabilities,
+  signalAllAcceptedCredentials,
+  signalCurrentUserDetails,
+  signalUnknownCredential,
+  showMessage,
+} from "/common.js";
+
+const $ = (id) => document.getElementById(id);
+const message = $("message");
+
+const { rpId, user: initialUser } = await getMe();
+if (!initialUser) location.replace("/login");
+let user = initialUser;
+let credentials = [];
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: "medium" });
+const formatDate = (ts) => dateFormat.format(new Date(ts));
+
+// ---------- Reauthentication ----------
+
+const reauthDialog = $("reauth-dialog");
+const reauthMessage = $("reauth-message");
+
+// Runs an action; if the server demands a recent sign-in, reauthenticate and retry once.
+async function withReauth(action) {
+  try {
+    return await action();
+  } catch (err) {
+    if (!(err instanceof ApiError) || err.code !== "reauth_required") throw err;
+    if (!(await reauthenticate())) throw new ApiError(0, "Verification cancelled.", "cancelled");
+    return action();
+  }
+}
+
+function reauthenticate() {
+  $("reauth-passkey").hidden = credentials.length === 0 || !window.PublicKeyCredential;
+  $("reauth-password").value = "";
+  showMessage(reauthMessage, "");
+  reauthDialog.showModal();
+  return new Promise((resolve) => {
+    reauthDialog.addEventListener("close", () => resolve(reauthDialog.returnValue === "ok"), {
+      once: true,
+    });
+    reauthDialog.returnValue = "";
+  });
+}
+
+$("reauth-cancel").addEventListener("click", () => reauthDialog.close("cancel"));
+
+$("reauth-password-form").addEventListener("submit", async (event) => {
+  event.preventDefault();
+  try {
+    await api("POST", "/api/reauth/password", { password: $("reauth-password").value });
+    reauthDialog.close("ok");
+  } catch (err) {
+    showMessage(reauthMessage, err.message, "error");
+  }
+});
+
+$("reauth-passkey").addEventListener("click", async () => {
+  let credential;
+  try {
+    const options = await api("POST", "/api/reauth/options");
+    credential = await navigator.credentials.get({
+      publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(options),
+    });
+  } catch (err) {
+    if (err.name !== "NotAllowedError" && err.name !== "AbortError") {
+      showMessage(reauthMessage, err.message, "error");
+    }
+    return;
+  }
+  const encoded = credential.toJSON();
+  try {
+    await api("POST", "/api/reauth/verify", encoded);
+    reauthDialog.close("ok");
+  } catch (err) {
+    showMessage(reauthMessage, err.message, "error");
+    // Signed-in user: only signal when the server has no record of this credential.
+    if (err.status === 404) await signalUnknownCredential(rpId, encoded.id);
+  }
+});
+
+// ---------- Profile ----------
+
+$("username").textContent = user.username;
+$("profile-name").value = user.displayName;
+
+$("profile-form").addEventListener("submit", async (event) => {
+  event.preventDefault();
+  try {
+    user = await api("PUT", "/api/user", { displayName: $("profile-name").value });
+    await signalCurrentUserDetails(rpId, user);
+    showMessage(message, "Profile updated.");
+  } catch (err) {
+    showMessage(message, err.message, "error");
+  }
+});
+
+$("password-form").addEventListener("submit", async (event) => {
+  event.preventDefault();
+  try {
+    await withReauth(() => api("PUT", "/api/password", { password: $("new-password").value }));
+    $("new-password").value = "";
+    showMessage(message, "Password updated.");
+  } catch (err) {
+    if (err.code !== "cancelled") showMessage(message, err.message, "error");
+  }
+});
+
+// ---------- Passkey management ----------
+
+const list = $("passkey-list");
+
+function render() {
+  $("passkey-empty").hidden = credentials.length > 0;
+  list.replaceChildren(
+    ...credentials.map((cred) => {
+      const li = document.createElement("li");
+      li.className = "passkey-item";
+
+      let icon;
+      if (cred.providerIcon) {
+        icon = document.createElement("img");
+        icon.src = cred.providerIcon;
+        icon.alt = "";
+      } else {
+        icon = document.createElement("span");
+        icon.className = "icon-fallback";
+        icon.textContent = "🔑";
+        icon.setAttribute("aria-hidden", "true");
+      }
+
+      const meta = document.createElement("div");
+      meta.className = "meta";
+      const name = document.createElement("strong");
+      name.textContent = cred.name;
+      const created = document.createElement("small");
+      created.textContent = `Created ${formatDate(cred.registeredAt)}`;
+      const used = document.createElement("small");
+      used.textContent = cred.lastUsedAt
+        ? `Last used ${formatDate(cred.lastUsedAt)}`
+        : "Never used";
+      meta.append(name, created, used);
+
+      const actions = document.createElement("div");
+      actions.className = "actions";
+      const rename = document.createElement("button");
+      rename.type = "button";
+      rename.className = "btn secondary";
+      rename.textContent = "Rename";
+      rename.setAttribute("aria-label", `Rename passkey ${cred.name}`);
+      rename.addEventListener("click", () => renamePasskey(cred));
+      const del = document.createElement("button");
+      del.type = "button";
+      del.className = "btn danger";
+      del.textContent = "Delete";
+      del.setAttribute("aria-label", `Delete passkey ${cred.name}`);
+      del.addEventListener("click", () => deletePasskey(cred));
+      actions.append(rename, del);
+
+      li.append(icon, meta, actions);
+      return li;
+    }),
+  );
+}
+
+async function loadCredentials() {
+  credentials = await api("GET", "/api/credentials");
+  render();
+}
+
+async function renamePasskey(cred) {
+  const dialog = $("rename-dialog");
+  const input = $("rename-input");
+  input.value = cred.name;
+  dialog.returnValue = "";
+  dialog.showModal();
+  input.select();
+  await new Promise((resolve) => dialog.addEventListener("close", resolve, { once: true }));
+  if (dialog.returnValue !== "save") return;
+  try {
+    // A nickname is a server-side label only; no Signal API call needed.
+    await api("PUT", `/api/credential/${encodeURIComponent(cred.id)}`, { name: input.value });
+    await loadCredentials();
+  } catch (err) {
+    showMessage(message, err.message, "error");
+  }
+}
+
+async function deletePasskey(cred) {
+  if (!confirm(`Delete the passkey "${cred.name}"? You won't be able to use it to sign in again.`)) return;
+  try {
+    await withReauth(() => api("DELETE", `/api/credential/${encodeURIComponent(cred.id)}`));
+    await loadCredentials();
+    await signalAllAcceptedCredentials(rpId, user.webauthnUserId, credentials.map((c) => c.id));
+    showMessage(message, "Passkey deleted.");
+  } catch (err) {
+    if (err.code !== "cancelled") showMessage(message, err.message, "error");
+  }
+}
+
+async function createPasskey() {
+  let credential;
+  try {
+    // Reauth before prompting so the creation ceremony isn't interrupted.
+    const options = await withReauth(() =>
+      api("POST", "/api/passkey/register/options", { promotion: false }),
+    );
+    credential = await navigator.credentials.create({
+      publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(options),
+    });
+  } catch (err) {
+    if (err.code === "cancelled" || err.name === "NotAllowedError" || err.name === "AbortError") return;
+    if (err.name === "InvalidStateError") {
+      showMessage(message, "A passkey from this provider already exists for your account.", "error");
+    } else if (err.name === "SecurityError") {
+      showMessage(message, "Passkeys can't be used on this origin (HTTPS and a matching domain are required).", "error");
+    } else {
+      showMessage(message, err.message, "error");
+    }
+    return;
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    await api("POST", "/api/passkey/register/verify", encoded);
+  } catch (err) {
+    showMessage(message, err.message, "error");
+    // The provider saved a credential the server rejected; tell it to drop it.
+    await signalUnknownCredential(rpId, encoded.id);
+    return;
+  }
+  await loadCredentials();
+  await signalAllAcceptedCredentials(rpId, user.webauthnUserId, credentials.map((c) => c.id));
+  showMessage(message, "Passkey created.");
+}
+
+$("create-passkey").addEventListener("click", createPasskey);
+
+const caps = await passkeyCapabilities();
+$("create-passkey").hidden = !caps.available && !caps.conditional;
+$("passkey-unsupported").hidden = !$("create-passkey").hidden;
+
+await loadCredentials();
+await signalAllAcceptedCredentials(rpId, user.webauthnUserId, credentials.map((c) => c.id));
diff --git a/public/common.js b/public/common.js
new file mode 100644
index 0000000..889e469
--- /dev/null
+++ b/public/common.js
@@ -0,0 +1,83 @@
+// Shared client helpers: API access, WebAuthn feature detection, signal API wrappers.
+
+if (
+  window.PublicKeyCredential &&
+  (!PublicKeyCredential.parseCreationOptionsFromJSON ||
+    !PublicKeyCredential.parseRequestOptionsFromJSON ||
+    !PublicKeyCredential.getClientCapabilities ||
+    !PublicKeyCredential.prototype.toJSON)
+) {
+  await import("https://unpkg.com/webauthn-polyfills");
+}
+
+export class ApiError extends Error {
+  constructor(status, message, code) {
+    super(message);
+    this.status = status;
+    this.code = code;
+  }
+}
+
+export async function api(method, url, body) {
+  const res = await fetch(url, {
+    method,
+    headers: body === undefined ? {} : { "Content-Type": "application/json" },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) throw new ApiError(res.status, data.error || "Something went wrong.", data.code);
+  return data;
+}
+
+export const getMe = () => api("GET", "/api/me");
+
+export async function passkeyCapabilities() {
+  if (!window.PublicKeyCredential) return { available: false, conditional: false };
+  const caps = await PublicKeyCredential.getClientCapabilities();
+  return {
+    available: Boolean(caps.passkeyPlatformAuthenticator || caps.userVerifyingPlatformAuthenticator),
+    conditional: caps.conditionalGet === true,
+  };
+}
+
+// Signal API calls are progressive enhancement; failures must never break the UI.
+export async function signalUnknownCredential(rpId, credentialId) {
+  if (!window.PublicKeyCredential?.signalUnknownCredential) return;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+  } catch (e) {
+    console.warn("signalUnknownCredential failed", e);
+  }
+}
+
+export async function signalAllAcceptedCredentials(rpId, userId, credentialIds) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId,
+      userId,
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (e) {
+    console.warn("signalAllAcceptedCredentials failed", e);
+  }
+}
+
+export async function signalCurrentUserDetails(rpId, user) {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId,
+      userId: user.webauthnUserId,
+      name: user.username,
+      displayName: user.displayName,
+    });
+  } catch (e) {
+    console.warn("signalCurrentUserDetails failed", e);
+  }
+}
+
+export function showMessage(el, text, kind = "info") {
+  el.textContent = text;
+  el.dataset.kind = kind;
+}
