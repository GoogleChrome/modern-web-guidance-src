+  <script>
+    const PAGES = [
+      [
+        ['Maple Oat Latte', 'Creamy oat milk with a hint of Vermont maple syrup.', '/menu/seasonal'],
+        ['Dark Roast Espresso', 'Bold, smokey, and perfect for a morning boost.', '/menu/espresso'],
+        ['Cold Brew', 'Steeped for 18 hours for maximum smoothness.', '/menu/cold-brew']
+      ],
+      [
+        ['Pumpkin Spice Latte', 'Roasted pumpkin, warm spices, and steamed milk.', '/menu/pumpkin-spice'],
+        ['Honey Cinnamon Cortado', 'Smooth espresso balanced with local honey.', '/menu/cortado'],
+        ['Chai Tea Latte', 'House-brewed chai with a velvety milk finish.', '/menu/chai']
+      ],
+      [
+        ['Caramel Macchiato', 'Vanilla, steamed milk, espresso, and caramel drizzle.', '/menu/macchiato'],
+        ['Peppermint Mocha', 'Dark chocolate and cool peppermint, topped with cream.', '/menu/peppermint-mocha'],
+        ['Nitro Cold Brew', 'Cold brew infused with nitrogen for a creamy pour.', '/menu/nitro']
+      ]
+    ];
+
+    const pageOf = (url) => {
+      const n = parseInt(new URL(url).searchParams.get('page'), 10);
+      return n >= 1 && n <= PAGES.length ? n : 1;
+    };
+
+    // Render the current page of items and wire up pagination links.
+    const page = pageOf(location.href);
+    const grid = document.querySelector('.grid');
+    grid.replaceChildren(...PAGES[page - 1].map(([title, text, href]) => {
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = '<h3></h3><p></p><a class="btn">View Details</a>';
+      card.querySelector('h3').textContent = title;
+      card.querySelector('p').textContent = text;
+      card.querySelector('a').href = href;
+      return card;
+    }));
+
+    const setLink = (id, target) => {
+      const link = document.getElementById(id);
+      if (target >= 1 && target <= PAGES.length) {
+        link.href = '?page=' + target;
+        link.removeAttribute('aria-disabled');
+      } else {
+        link.removeAttribute('href');
+        link.setAttribute('aria-disabled', 'true');
+      }
+    };
+    setLink('previous', page - 1);
+    setLink('next', page + 1);
+
+    // Pick a directional view transition type for cross-document navigations.
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      window.addEventListener('pagereveal', (e) => {
+        if (!e.viewTransition || !window.navigation?.activation?.from) return;
+        const { from, entry } = window.navigation.activation;
+        const fromUrl = new URL(from.url);
+        const toUrl = new URL(entry.url);
+        if (fromUrl.pathname !== toUrl.pathname) return;
+        const delta = pageOf(toUrl) - pageOf(fromUrl);
+        if (delta !== 0) {
+          e.viewTransition.types.add(delta > 0 ? 'next' : 'previous');
+        }
+      });
+    }
+  </script>
