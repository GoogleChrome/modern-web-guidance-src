     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const ITEMS = [
+      ['Maple Oat Latte', 'Creamy oat milk with a hint of Vermont maple syrup.', '/menu/seasonal'],
+      ['Dark Roast Espresso', 'Bold, smokey, and perfect for a morning boost.', '/menu/espresso'],
+      ['Cold Brew', 'Steeped for 18 hours for maximum smoothness.', '/menu/cold-brew'],
+      ['Pumpkin Spice Latte', 'Roasted pumpkin, cinnamon, and nutmeg over espresso.', '/menu/pumpkin-spice'],
+      ['Cinnamon Cortado', 'Equal parts espresso and steamed milk with warm spice.', '/menu/cinnamon-cortado'],
+      ['Honey Lavender Latte', 'Floral lavender and local honey with silky milk.', '/menu/honey-lavender'],
+      ['Peppermint Mocha', 'Dark chocolate and cool peppermint, topped with cream.', '/menu/peppermint-mocha'],
+      ['Chai Cold Foam', 'Spiced chai cold foam floating on iced cold brew.', '/menu/chai-cold-foam'],
+      ['Caramel Macchiato', 'Vanilla, steamed milk, espresso, and a caramel drizzle.', '/menu/caramel-macchiato'],
+    ];
+    const PAGE_SIZE = 3;
+    const LAST_PAGE = Math.ceil(ITEMS.length / PAGE_SIZE);
+
+    function pageOf(url) {
+      const n = parseInt(new URL(url).searchParams.get('page'), 10);
+      return Math.min(Math.max(n || 1, 1), LAST_PAGE);
+    }
+
+    const page = pageOf(location.href);
+
+    const grid = document.querySelector('.grid');
+    grid.replaceChildren(...ITEMS.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE).map(([title, desc, href]) => {
+      const card = document.createElement('div');
+      card.className = 'card';
+      const h3 = document.createElement('h3');
+      h3.textContent = title;
+      const p = document.createElement('p');
+      p.textContent = desc;
+      const a = document.createElement('a');
+      a.href = href;
+      a.className = 'btn';
+      a.textContent = 'View Details';
+      card.append(h3, p, a);
+      return card;
+    }));
+
+    function setLink(id, target) {
+      const link = document.getElementById(id);
+      if (target < 1 || target > LAST_PAGE) {
+        link.removeAttribute('href');
+        link.setAttribute('aria-disabled', 'true');
+      } else {
+        link.href = '?page=' + target;
+        link.removeAttribute('aria-disabled');
+      }
+    }
+    setLink('previous', page - 1);
+    setLink('next', page + 1);
+
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      window.addEventListener('pagereveal', (event) => {
+        if (!event.viewTransition || !window.navigation?.activation?.from) return;
+
+        const from = pageOf(navigation.activation.from.url);
+        const to = pageOf(navigation.activation.entry.url);
+        if (from === to) return;
+
+        event.viewTransition.types.add(to > from ? 'next' : 'previous');
+      });
+    }
+  </script>
