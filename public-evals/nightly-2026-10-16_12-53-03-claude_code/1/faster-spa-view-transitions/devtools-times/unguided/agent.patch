index 0000000..55e1490
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,64 @@
+import { swapFunctions } from "astro:transitions/client";
+
+// Keeps the <body> of recently visited pages alive (detached) so returning to
+// them re-attaches the existing DOM, including hydrated React islands, rather
+// than discarding it and building it again from the fetched HTML.
+
+const MAX_ENTRIES = 10;
+const MAX_AGE_MS = 5 * 60 * 1000;
+const UNCACHEABLE = /\/(signin|signup|api)(\/|$)/;
+
+interface Entry {
+  body: HTMLElement;
+  storedAt: number;
+}
+
+const cache = new Map<string, Entry>();
+
+const keyOf = (url: URL) => url.pathname + url.search;
+
+function store(url: URL, body: HTMLElement) {
+  const key = keyOf(url);
+  if (UNCACHEABLE.test(url.pathname)) return;
+  cache.delete(key); // re-insert so Map order stays least-recently-used first
+  cache.set(key, { body, storedAt: Date.now() });
+  while (cache.size > MAX_ENTRIES) {
+    cache.delete(cache.keys().next().value!);
+  }
+}
+
+function take(url: URL): HTMLElement | undefined {
+  const key = keyOf(url);
+  const entry = cache.get(key);
+  if (!entry) return;
+  // The node becomes live again; it is re-stored when the user leaves it.
+  cache.delete(key);
+  if (Date.now() - entry.storedAt > MAX_AGE_MS) return;
+  return entry.body;
+}
+
+document.addEventListener("astro:before-swap", (event) => {
+  const { to, newDocument } = event;
+  // `location` still points at the page being left while the swap runs.
+  const leaving = new URL(location.href);
+  const leavingBody = document.body;
+  const cachedBody = take(to);
+
+  if (!UNCACHEABLE.test(leaving.pathname)) {
+    store(leaving, leavingBody);
+  }
+
+  if (!cachedBody) {
+    // Fresh render: the default swap would drop the old body, we keep it.
+    return;
+  }
+
+  event.swap = () => {
+    swapFunctions.deselectScripts(newDocument);
+    swapFunctions.swapRootAttributes(newDocument);
+    swapFunctions.swapHeadElements(newDocument);
+    const restoreFocus = swapFunctions.saveFocus();
+    swapFunctions.swapBodyElement(cachedBody, document.body);
+    restoreFocus();
+  };
+});
