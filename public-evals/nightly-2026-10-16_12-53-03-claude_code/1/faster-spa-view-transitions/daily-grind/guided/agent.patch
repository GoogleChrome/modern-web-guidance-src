+<script>
+    const MAX_CACHED_VIEWS = 5;
+    const PAGES = {
+      '/menu': ['Menu', 'Espresso, pour-overs, cold brew and fresh pastries, all made to order.'],
+      '/locations': ['Locations', 'Find a Daily Grind near you. Open 6am to 8pm daily.'],
+      '/rewards': ['Rewards', 'Earn a star for every cup and redeem them for free drinks.'],
+      '/account': ['My Account', 'Manage your orders, payment methods and preferences.']
+    };
+
+    const viewsEl = document.getElementById('views');
+    // Map insertion order doubles as LRU order (oldest first).
+    const cache = new Map([['/', document.getElementById('view-home')]]);
+    let current = '/';
+
+    function buildView(path) {
+      const [title, body] = PAGES[path];
+      const view = document.createElement('div');
+      view.className = 'spa-view inactive';
+      view.dataset.route = path;
+      view.tabIndex = -1;
+      view.innerHTML = `<main class="container"><h2></h2><p></p></main>`;
+      view.querySelector('h2').textContent = title;
+      view.querySelector('p').textContent = body;
+      viewsEl.append(view);
+      return view;
+    }
+
+    function showView(path) {
+      path = path in PAGES ? path : '/';
+      let view = cache.get(path);
+      if (view) cache.delete(path);
+      else view = buildView(path);
+      cache.set(path, view); // mark most recently used
+
+      for (const v of cache.values()) {
+        const active = v === view;
+        v.classList.toggle('inactive', !active);
+        v.setAttribute('aria-hidden', String(!active));
+      }
+
+      // Evict least recently used views beyond the cap (never the active one)
+      for (const [key, v] of cache) {
+        if (cache.size <= MAX_CACHED_VIEWS) break;
+        if (v === view) continue;
+        v.remove();
+        cache.delete(key);
+      }
+
+      current = path;
+      document.title = (PAGES[path] ? PAGES[path][0] + ' | ' : '') + 'The Daily Grind | Artisanal Coffee';
+      view.focus({ preventScroll: true });
+      window.scrollTo(0, 0);
+    }
+
+    document.addEventListener('click', (e) => {
+      const a = e.target.closest('a[href]');
+      if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+      const url = new URL(a.href);
+      if (url.origin !== location.origin) return;
+      const path = url.pathname;
+      if (path !== '/' && !(path in PAGES)) return;
+      e.preventDefault();
+      if (path === current) return;
+      history.pushState(null, '', path);
+      showView(path);
+    });
+
+    document.querySelector('.logo').addEventListener('click', () => {
+      if (current === '/') return;
+      history.pushState(null, '', '/');
+      showView('/');
+    });
+
+    addEventListener('popstate', () => showView(location.pathname));
+    showView(location.pathname);
+  </script>
