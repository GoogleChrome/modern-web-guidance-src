+</Layout>
+
+<style is:global>
+    .top-story.slide-from-right { animation: top-story-from-right 300ms ease-out; }
+    .top-story.slide-from-left { animation: top-story-from-left 300ms ease-out; }
+
+    @keyframes top-story-from-right {
+        from { transform: translateX(100%); opacity: 0; }
+        to { transform: translateX(0); opacity: 1; }
+    }
+    @keyframes top-story-from-left {
+        from { transform: translateX(-100%); opacity: 0; }
+        to { transform: translateX(0); opacity: 1; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        .top-story.slide-from-right,
+        .top-story.slide-from-left { animation: none; }
+    }
+</style>
+
+<script>
+    const slider = document.querySelector<HTMLElement>('[data-top-stories]');
+    if (slider) {
+        const slides = Array.from(slider.querySelectorAll<HTMLElement>('[data-slide]'));
+        let current = 0;
+
+        const show = (direction: 1 | -1) => {
+            const next = (current + direction + slides.length) % slides.length;
+            if (next === current) return;
+            slides[current].hidden = true;
+            slides[current].classList.remove('slide-from-left', 'slide-from-right');
+            const incoming = slides[next];
+            incoming.classList.remove('slide-from-left', 'slide-from-right');
+            incoming.hidden = false;
+            // Force reflow so the animation restarts when revisiting a slide.
+            void incoming.offsetWidth;
+            incoming.classList.add(direction === 1 ? 'slide-from-right' : 'slide-from-left');
+            current = next;
+        };
+
+        slider.querySelector('[data-next]')?.addEventListener('click', () => show(1));
+        slider.querySelector('[data-prev]')?.addEventListener('click', () => show(-1));
+    }
+</script>
