+
+  <script>
+    (() => {
+      const cards = [...document.querySelectorAll('#seasonal-stage .card')];
+      const status = document.getElementById('seasonal-status');
+      let current = 0;
+
+      function show(index) {
+        cards.forEach((card, i) => { card.hidden = i !== index; });
+        status.textContent = `${index + 1} / ${cards.length}`;
+      }
+
+      function go(step) {
+        const next = (current + step + cards.length) % cards.length;
+        const update = () => { current = next; show(next); };
+
+        if (!document.startViewTransition) {
+          update();
+          return;
+        }
+        document.startViewTransition({
+          update,
+          types: [step > 0 ? 'forward' : 'backward']
+        });
+      }
+
+      document.getElementById('seasonal-next').addEventListener('click', () => go(1));
+      document.getElementById('seasonal-prev').addEventListener('click', () => go(-1));
+      document.getElementById('seasonal-controls').hidden = false;
+      show(current);
+    })();
+  </script>
 </body>
 
