+
+  <script>
+    (function () {
+      var carousel = document.querySelector('.carousel');
+      var cards = carousel.querySelectorAll('.card');
+      var current = 0;
+
+      function show(index, direction) {
+        cards[current].hidden = true;
+        cards[current].classList.remove('enter-next', 'enter-prev');
+        current = (index + cards.length) % cards.length;
+        cards[current].hidden = false;
+        cards[current].classList.add(direction > 0 ? 'enter-next' : 'enter-prev');
+      }
+
+      document.getElementById('seasonal-next').addEventListener('click', function () {
+        show(current + 1, 1);
+      });
+      document.getElementById('seasonal-prev').addEventListener('click', function () {
+        show(current - 1, -1);
+      });
+    })();
+  </script>
