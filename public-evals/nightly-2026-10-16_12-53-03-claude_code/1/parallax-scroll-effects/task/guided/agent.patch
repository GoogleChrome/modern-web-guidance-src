+    /* Parallax depth section (CSS scroll-driven animations; decorative, so no JS fallback) */
+    .depth {
+      position: relative;
+      height: 80vh;
+      min-height: 480px;
+      overflow: clip;
+      background: var(--primary);
+      color: white;
+      isolation: isolate;
+    }
+
+    .depth-layer {
+      position: absolute;
+      inset: 0;
+    }
+
+    .depth-layer img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    .depth-back {
+      inset: -20% 0;
+      z-index: 0;
+    }
+
+    .depth-back::after {
+      content: "";
+      position: absolute;
+      inset: 0;
+      background: rgba(30, 15, 10, 0.55);
+    }
+
+    .depth-mid {
+      inset: -30% auto -30% 8%;
+      width: min(34vw, 380px);
+      z-index: 1;
+      display: flex;
+      align-items: center;
+    }
+
+    .depth-mid img {
+      height: auto;
+      aspect-ratio: 3 / 4;
+      border-radius: 12px;
+      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
+    }
+
+    .depth-front {
+      z-index: 2;
+      display: flex;
+      align-items: center;
+      justify-content: flex-end;
+      padding: 0 8%;
+    }
+
+    .depth-copy {
+      max-width: 440px;
+      padding: 28px;
+      border-radius: 8px;
+      background: rgba(62, 39, 35, 0.92);
+    }
+
+    .depth-copy h2 {
+      margin-bottom: 10px;
+    }
+
+    @keyframes depth-shift {
+      from { transform: translateY(var(--shift)); }
+      to { transform: translateY(calc(var(--shift) * -1)); }
+    }
+
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      @media (prefers-reduced-motion: no-preference) {
+        .depth {
+          view-timeline: --depth block;
+        }
+
+        .depth-layer {
+          animation: depth-shift linear both;
+          animation-timeline: --depth;
+          animation-range: cover;
+          will-change: transform;
+        }
+
+        .depth-back { --shift: -8%; }
+        .depth-mid { --shift: 25%; }
+        .depth-front { --shift: 6%; }
+      }
+    }
+
+    @media (max-width: 700px) {
+      .depth-mid { display: none; }
+      .depth-front { justify-content: center; }
+    }
