+
+    #accordion-toggle {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      inline-size: 100%;
+      padding-block: 0.9rem;
+      padding-inline: 1.25rem;
+      background: var(--primary);
+      color: white;
+      border: 0;
+      border-radius: 8px;
+      font: inherit;
+      font-size: 1.1rem;
+      font-weight: bold;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    #accordion-toggle:hover {
+      background: #3e2723;
+    }
+
+    #accordion-toggle::after {
+      content: '+';
+      font-size: 1.4rem;
+      line-height: 1;
+    }
+
+    #accordion-toggle[aria-expanded="true"]::after {
+      content: '\2212';
+    }
+
+    .accordion-content {
+      block-size: 0;
+      overflow: hidden;
+      visibility: hidden;
+      background: white;
+      border-radius: 0 0 8px 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      transition: block-size 0.4s ease, visibility 0.4s;
+    }
+
+    .accordion-content.expanded {
+      visibility: visible;
+      /* Natural height plus 2rem of breathing room */
+      block-size: calc(100% + 2rem);
+    }
+
+    @supports (block-size: calc-size(auto, size)) {
+      .accordion-content.expanded {
+        block-size: calc-size(auto, size + 2rem);
+      }
+    }
+
+    .accordion-content > div {
+      padding-block: 1rem;
+      padding-inline: 1.25rem;
+    }
+
+    .accordion-content p + p {
+      margin-block-start: 0.75rem;
+    }
+
+    /*
+     * Note: directly transitioning between different intrinsic keyword sizes
+     * (e.g. auto, min-content, max-content, fit-content) is not supported,
+     * because they are not interpolable values. Opting in with
+     * interpolate-size (below) lets `auto` and other keywords animate to and
+     * from lengths; calc-size() is used where we need arithmetic on them.
+     */
+    :root {
+      /* Enable smooth transitions to/from height: auto site-wide */
+      interpolate-size: allow-keywords;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      :root {
+        interpolate-size: numeric-only;
+      }
+
+      .accordion-content {
+        transition: none;
+      }
+
+      #accordion-toggle {
+        transition: none;
+      }
+    }
