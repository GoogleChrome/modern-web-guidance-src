+  <script>
+    // Interaction and soft-navigation paint timing (Chromium 151+).
+    // Progressive enhancement: skipped where the entry types are unsupported.
+    (() => {
+      const types = typeof PerformanceObserver === 'undefined' ? [] : PerformanceObserver.supportedEntryTypes || [];
+      const hasICP = types.includes('interaction-contentful-paint');
+      const hasSoftNav = types.includes('soft-navigation');
+
+      // Time from user interaction to each contentful paint it caused.
+      if (hasICP) {
+        new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            // entry.duration = presentationTime - startTime (interaction start).
+            console.log('[interaction paint]', entry.interactionId, Math.round(entry.duration) + 'ms');
+          }
+        }).observe({ type: 'interaction-contentful-paint', buffered: true });
+      }
+
+      // FCP and LCP for each soft navigation, reported when the next one
+      // starts or the page is hidden.
+      if (hasICP && hasSoftNav) {
+        let activeSoftNav = null;
+        let activeLcpEntry = null;
+
+        const finalize = () => {
+          if (!activeSoftNav) return;
+          console.log('[soft navigation]', {
+            url: activeSoftNav.name,
+            fcp: Math.round(activeSoftNav.duration),
+            lcp: activeLcpEntry ? Math.round(activeLcpEntry.duration) : null,
+          });
+          activeSoftNav = null;
+          activeLcpEntry = null;
+        };
+
+        new PerformanceObserver((list) => {
+          for (const softNav of list.getEntries()) {
+            finalize();
+            activeSoftNav = softNav;
+            // Include paints that happened before the URL changed.
+            activeLcpEntry = softNav.getLargestInteractionContentfulPaint();
+          }
+        }).observe({ type: 'soft-navigation', buffered: true });
+
+        new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            // Match by interactionId, not navigationId.
+            if (activeSoftNav && entry.interactionId === activeSoftNav.interactionId) {
+              activeLcpEntry = entry;
+            }
+          }
+        }).observe({ type: 'interaction-contentful-paint', buffered: true });
+
+        document.addEventListener('visibilitychange', () => {
+          if (document.visibilityState === 'hidden') finalize();
+        });
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
