+  <script>
+    (function () {
+      var range = document.getElementById('strength');
+      var out = document.getElementById('strength-out');
+      var labels = ['Mild', 'Light', 'Medium', 'Strong', 'Bold'];
+
+      function update() {
+        var min = +range.min, max = +range.max, val = +range.value;
+        var pct = (val - min) / (max - min);
+        var thumb = parseFloat(getComputedStyle(range).getPropertyValue('--thumb')) || 24;
+        // Fill ends at the thumb centre, which is inset by half a thumb at each end
+        range.style.setProperty('--fill', 'calc(' + pct * 100 + '% + ' + (0.5 - pct) * thumb + 'px)');
+        var text = labels[val - min] || val;
+        out.textContent = text;
+        range.setAttribute('aria-valuetext', text);
+      }
+
+      range.addEventListener('input', update);
+      update();
+    })();
+  </script>
 </body>
 
