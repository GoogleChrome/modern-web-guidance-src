+  <script>
+    const logoutDialog = document.getElementById('logout-dialog');
+
+    document.querySelector('.test-dialog-trigger').addEventListener('click', (e) => {
+      e.preventDefault();
+      logoutDialog.showModal();
+    });
+
+    document.getElementById('logout-cancel').addEventListener('click', () => logoutDialog.close());
+
+    // Padding lives on the inner wrapper, so a click whose target is the
+    // dialog itself landed on the backdrop.
+    logoutDialog.addEventListener('click', (e) => {
+      if (e.target === logoutDialog) logoutDialog.close();
+    });
