+++ b/smallpt/worker.js
@@ -0,0 +1,14 @@
+import createModule from './smallpt.js';
+
+const ready = createModule();
+
+self.onmessage = async ({ data: { width, height, spp, colors } }) => {
+  const m = await ready;
+  const cptr = m._malloc(colors.length * 4);
+  m.HEAPF32.set(colors, cptr / 4);
+  const start = performance.now();
+  const ptr = m._render(width, height, spp, cptr);
+  m._free(cptr);
+  const pixels = m.HEAPU8.slice(ptr, ptr + width * height * 4);
+  self.postMessage({ pixels, width, height, ms: performance.now() - start }, [pixels.buffer]);
+};
