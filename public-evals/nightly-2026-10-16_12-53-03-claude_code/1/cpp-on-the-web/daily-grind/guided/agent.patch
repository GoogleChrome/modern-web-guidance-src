+  <script type="module">
+    const WIDTH = 512, HEIGHT = 384, SPP = 64;
+    const canvas = document.getElementById('render');
+    const status = document.getElementById('status');
+    const button = document.getElementById('rerender');
+    const ctx = canvas.getContext('2d');
+    const worker = new Worker('smallpt/worker.js', { type: 'module' });
+
+    // hsl -> rgb triple in 0..1
+    function hsl(h, s, l) {
+      const a = s * Math.min(l, 1 - l);
+      const f = n => { const k = (n + h / 30) % 12; return l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)); };
+      return [f(0), f(8), f(4)];
+    }
+
+    // Left, Rght, Back, Botm, Top, Mirr, Glas
+    function randomColors() {
+      const hue = () => Math.random() * 360;
+      const wall = () => hsl(hue(), 0.55, 0.5);
+      const tint = () => hsl(hue(), 0.5, 0.85);
+      return new Float32Array([wall(), wall(), wall(), wall(), wall(), tint(), tint()].flat());
+    }
+
+    // The scene's original colors
+    const original = new Float32Array([
+      .75, .25, .25, .25, .25, .75, .75, .75, .75, .75, .75, .75, .75, .75, .75, .999, .999, .999, .999, .999, .999,
+    ]);
+
+    function render(colors) {
+      button.disabled = true;
+      status.textContent = 'Rendering…';
+      worker.postMessage({ width: WIDTH, height: HEIGHT, spp: SPP, colors });
+    }
+
+    worker.onmessage = ({ data: { pixels, width, height, ms } }) => {
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(pixels.buffer), width, height), 0, 0);
+      status.textContent = `Rendered ${width}×${height} at ${SPP} samples/pixel in ${(ms / 1000).toFixed(1)}s.`;
+      button.disabled = false;
+    };
+    worker.onerror = () => { status.textContent = 'Rendering failed.'; };
+
+    button.addEventListener('click', () => render(randomColors()));
+    render(original);
+  </script>
