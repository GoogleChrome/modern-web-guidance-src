diff --git a/public/smallpt/worker.js b/public/smallpt/worker.js
new file mode 100644
index 0000000..a18d08c
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,24 @@
+import createSmallpt from './smallpt.js';
+
+const W = 512, H = 384, SPP = 80;
+const modulePromise = createSmallpt();
+
+// Scene indices of the spheres whose colors can be randomized.
+const COLOR_SLOTS = { left: 0, right: 1, mirror: 6, glass: 7 };
+
+self.onmessage = async ({ data: { colors } }) => {
+  const m = await modulePromise;
+  for (const [name, i] of Object.entries(COLOR_SLOTS)) {
+    if (colors?.[name]) m._set_color(i, ...colors[name]);
+  }
+  const ptr = m._init(W, H, SPP);
+  for (let y = 0; y < H; y++) {
+    m._render_row(y, ptr);
+    if (y % 24 === 23 || y === H - 1) {
+      const pixels = m.HEAPU8.slice(ptr, ptr + W * H * 4);
+      self.postMessage({ width: W, height: H, pixels, progress: (y + 1) / H }, [pixels.buffer]);
+    }
+  }
+  m._free(ptr);
+  self.postMessage({ done: true });
+};
