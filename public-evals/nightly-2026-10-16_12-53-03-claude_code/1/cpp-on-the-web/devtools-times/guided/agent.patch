new file mode 100644
index 0000000..3522b17
--- /dev/null
+++ b/public/smallpt/index.html
@@ -0,0 +1,62 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>smallpt in WebAssembly</title>
+  <style>
+    body { font-family: system-ui, sans-serif; max-width: 48rem; margin: 2rem auto; padding: 0 1rem; text-align: center; }
+    canvas { width: 100%; height: auto; background: #111; border-radius: .5rem; }
+    button { font: inherit; padding: .6rem 1.2rem; margin-top: 1rem; cursor: pointer; }
+    #status { color: #555; min-height: 1.5em; }
+  </style>
+</head>
+<body>
+  <h1>smallpt in WebAssembly</h1>
+  <p><a href="http://www.kevinbeason.com/smallpt/">smallpt</a> by Kevin Beason, compiled with Emscripten and rendered client-side in a Web Worker.</p>
+  <canvas id="canvas" width="512" height="384"></canvas>
+  <p id="status" role="status"></p>
+  <button id="rerun" type="button" disabled>Re-render with random colors</button>
+
+  <script type="module">
+    const canvas = document.getElementById('canvas');
+    const ctx = canvas.getContext('2d');
+    const status = document.getElementById('status');
+    const button = document.getElementById('rerun');
+    let worker;
+
+    // Random saturated color as linear RGB components in [0,1].
+    const randomColor = () => {
+      const h = Math.random(), s = 0.6 + Math.random() * 0.4, v = 0.5 + Math.random() * 0.4;
+      const f = (n) => { const k = (n + h * 6) % 6; return v - v * s * Math.max(0, Math.min(k, 4 - k, 1)); };
+      return [f(5), f(3), f(1)];
+    };
+
+    function run(randomize) {
+      worker?.terminate();
+      worker = new Worker('./worker.js', { type: 'module' });
+      button.disabled = true;
+      const start = performance.now();
+      worker.onmessage = ({ data }) => {
+        if (data.done) {
+          status.textContent = `Done in ${((performance.now() - start) / 1000).toFixed(1)}s`;
+          button.disabled = false;
+          return;
+        }
+        const { width, height, pixels, progress } = data;
+        ctx.putImageData(new ImageData(new Uint8ClampedArray(pixels.buffer), width, height), 0, 0);
+        status.textContent = `Rendering… ${Math.round(progress * 100)}%`;
+      };
+      worker.onerror = () => { status.textContent = 'Render failed.'; button.disabled = false; };
+      status.textContent = 'Rendering…';
+      const colors = randomize
+        ? { left: randomColor(), right: randomColor(), mirror: randomColor(), glass: randomColor() }
+        : null;
+      worker.postMessage({ colors });
+    }
+
+    button.addEventListener('click', () => run(true));
+    run(false);
+  </script>
+</body>
+</html>
