+#!/bin/sh
+# Rebuild public/smallpt/smallpt.{js,wasm} (requires Emscripten).
+cd "$(dirname "$0")/.." && em++ -O3 wasm/smallpt.cpp -o public/smallpt/smallpt.js \
+  -sEXPORT_ES6 -sENVIRONMENT=worker -sALLOW_MEMORY_GROWTH -sMODULARIZE -sEXPORT_NAME=createSmallpt \
+  -sEXPORTED_FUNCTIONS=_init,_render_row,_set_color,_malloc,_free -sEXPORTED_RUNTIME_METHODS=HEAPU8
