diff --git a/public/smallpt/index.html b/public/smallpt/index.html
new file mode 100644
index 0000000..92559fe
--- /dev/null
+++ b/public/smallpt/index.html
@@ -0,0 +1,55 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>smallpt in WebAssembly</title>
+  <style>
+    body { font-family: system-ui, sans-serif; background: #111; color: #eee; text-align: center; margin: 2rem; }
+    canvas { max-width: 100%; height: auto; background: #000; border-radius: 6px; }
+    button { font-size: 1rem; padding: .6rem 1.2rem; margin: 1rem; border: 0; border-radius: 6px; background: #4f8cff; color: #fff; cursor: pointer; }
+    button:disabled { opacity: .5; cursor: progress; }
+    a { color: #8ab4ff; }
+  </style>
+</head>
+<body>
+  <h1>smallpt in WebAssembly</h1>
+  <p><a href="http://www.kevinbeason.com/smallpt/">smallpt</a> by Kevin Beason, a 99-line C++ path tracer, rendering client-side.</p>
+  <canvas id="out" width="512" height="384"></canvas>
+  <div><button id="btn" disabled>Render with random colors</button></div>
+  <p id="status"></p>
+  <script>
+    const W = 512, H = 384, SPP = 100;
+    const canvas = document.getElementById("out");
+    const ctx = canvas.getContext("2d");
+    const btn = document.getElementById("btn");
+    const status = document.getElementById("status");
+    const worker = new Worker("worker.js");
+
+    // Original scene: left red, right blue, back/floor gray, mirror/glass white.
+    const original = [[.75,.25,.25],[.25,.25,.75],[.75,.75,.75],[.75,.75,.75],[.999,.999,.999],[.999,.999,.999]];
+    const randomColor = () => {
+      // Random hue, fairly saturated, mid-bright so walls still reflect light.
+      const h = Math.random() * 6, c = .7, x = c * (1 - Math.abs(h % 2 - 1)), m = .2;
+      const [r, g, b] = [[c,x,0],[x,c,0],[0,c,x],[0,x,c],[x,0,c],[c,0,x]][Math.floor(h)];
+      return [r + m, g + m, b + m];
+    };
+
+    let t0;
+    function run(colors) {
+      btn.disabled = true;
+      status.textContent = "Rendering…";
+      t0 = performance.now();
+      worker.postMessage({ w: W, h: H, spp: SPP, colors });
+    }
+    worker.onmessage = (e) => {
+      const { w, h, pixels } = e.data;
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(pixels.buffer), w, h), 0, 0);
+      status.textContent = `Rendered ${w}×${h} at ${SPP} spp in ${((performance.now() - t0) / 1000).toFixed(1)}s`;
+      btn.disabled = false;
+    };
+    btn.onclick = () => run(Array.from({ length: 6 }, randomColor));
+    run(original);
+  </script>
+</body>
+</html>
