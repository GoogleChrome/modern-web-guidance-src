+  <script>
+    // The picker is a single row, so map Left/Right onto the options' linear order.
+    document.getElementById('roast').addEventListener('keydown', (e) => {
+      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
+      const select = e.currentTarget;
+      if (!select.matches(':open')) return;
+      const options = [...select.options];
+      const current = options.indexOf(document.activeElement);
+      const next = options[current + (e.key === 'ArrowRight' ? 1 : -1)];
+      if (next) {
+        e.preventDefault();
+        next.focus();
+      }
+    });
+  </script>
