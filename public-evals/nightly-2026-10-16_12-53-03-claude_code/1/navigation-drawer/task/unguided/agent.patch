+  <script>
+    const drawer = document.getElementById('drawer');
+    const spacer = document.getElementById('drawer-spacer');
+    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const behavior = () => (reduceMotion.matches ? 'instant' : 'smooth');
+    const maxScroll = () => drawer.scrollWidth - drawer.clientWidth;
+
+    function openDrawer() {
+      drawer.showModal();
+      // Start with the panel offscreen, then scroll it into view.
+      drawer.scrollTo({ left: 0, behavior: 'instant' });
+      drawer.scrollTo({ left: maxScroll(), behavior: behavior() });
+    }
+
+    function closeDrawer() {
+      if (reduceMotion.matches || drawer.scrollLeft <= 1) drawer.close();
+      else drawer.scrollTo({ left: 0, behavior: 'smooth' });
+    }
+
+    // A swipe (or animated close) that settles on the spacer closes the dialog.
+    let settle;
+    const settled = () => { if (drawer.open && drawer.scrollLeft <= 1) drawer.close(); };
+    if ('onscrollend' in window) {
+      drawer.addEventListener('scrollend', settled);
+    } else {
+      drawer.addEventListener('scroll', () => { clearTimeout(settle); settle = setTimeout(settled, 100); });
+    }
+
+    document.getElementById('menu-btn').addEventListener('click', openDrawer);
+    document.getElementById('drawer-close').addEventListener('click', closeDrawer);
+    // Backdrop: the transparent spacer (or the dialog itself) is the tap target.
+    drawer.addEventListener('click', (e) => { if (e.target === drawer || e.target === spacer) closeDrawer(); });
+    // Escape / platform back gesture: animate out instead of vanishing.
+    drawer.addEventListener('cancel', (e) => { e.preventDefault(); closeDrawer(); });
+  </script>
