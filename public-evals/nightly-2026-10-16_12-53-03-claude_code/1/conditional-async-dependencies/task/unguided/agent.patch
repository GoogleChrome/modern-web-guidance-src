+  <script>
+    (function () {
+      var pop = document.getElementById('rewards-popover');
+      var btn = document.querySelector('[popovertarget="rewards-popover"]');
+
+      // Polyfill is only fetched (async, non-blocking) when the browser lacks the Popover API.
+      if (!HTMLElement.prototype.hasOwnProperty('popover')) {
+        var css = document.createElement('link');
+        css.rel = 'stylesheet';
+        css.href = 'https://cdn.jsdelivr.net/npm/@oddbird/popover-polyfill@0.5.2/dist/popover.css';
+        document.head.appendChild(css);
+        var js = document.createElement('script');
+        js.type = 'module';
+        js.async = true;
+        js.src = 'https://cdn.jsdelivr.net/npm/@oddbird/popover-polyfill@0.5.2/dist/popover.min.js';
+        document.head.appendChild(js);
+      }
+
+      pop.addEventListener('toggle', function (e) {
+        btn.setAttribute('aria-expanded', e.newState === 'open');
+      });
+    })();
+  </script>
