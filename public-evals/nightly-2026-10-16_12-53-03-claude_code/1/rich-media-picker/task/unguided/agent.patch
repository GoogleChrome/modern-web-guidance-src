+    /* Roast picker */
+    .roast-picker {
+      position: relative;
+      width: min(100%, 340px);
+      margin-top: 1.5rem;
+      text-align: left;
+    }
+
+    .roast-label {
+      display: block;
+      font-size: 0.8rem;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      margin-bottom: 6px;
+    }
+
+    .roast-toggle {
+      width: 100%;
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px 14px;
+      background: white;
+      color: var(--text);
+      border: 2px solid transparent;
+      border-radius: 8px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .roast-toggle:focus-visible,
+    .roast-option:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .roast-toggle .chevron {
+      margin-left: auto;
+      transition: transform 0.2s;
+    }
+
+    .roast-toggle[aria-expanded="true"] .chevron {
+      transform: rotate(180deg);
+    }
+
+    .roast-list {
+      position: absolute;
+      top: 100%;
+      left: 0;
+      right: 0;
+      margin-top: 4px;
+      list-style: none;
+      background: white;
+      color: var(--text);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
+      overflow: hidden;
+      z-index: 10;
+    }
+
+    .roast-list[hidden] {
+      display: none;
+    }
+
+    .roast-option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px 14px;
+      cursor: pointer;
+    }
+
+    .roast-option:hover,
+    .roast-option.active {
+      background: var(--secondary);
+    }
+
+    .roast-option[aria-selected="true"] .roast-title::after {
+      content: " \2713";
+      color: var(--accent);
+    }
+
+    .roast-icon {
+      flex: none;
+      width: 32px;
+      height: 32px;
+      color: var(--primary);
+    }
+
+    .roast-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .roast-title {
+      font-weight: 600;
+    }
+
+    .roast-desc {
+      font-size: 0.8rem;
+      opacity: 0.75;
+    }
+
