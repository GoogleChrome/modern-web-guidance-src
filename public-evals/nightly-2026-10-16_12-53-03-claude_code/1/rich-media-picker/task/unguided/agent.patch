+  <script>
+    (function () {
+      var toggle = document.getElementById('roast-toggle');
+      var list = document.getElementById('roast-list');
+      var current = toggle.querySelector('.roast-current');
+      var orderBtn = document.getElementById('order-btn');
+      var options = Array.prototype.slice.call(list.querySelectorAll('.roast-option'));
+      var selected = 2; // dark roast default
+      var active = selected;
+
+      function setActive(i) {
+        active = (i + options.length) % options.length;
+        options.forEach(function (o, n) { o.classList.toggle('active', n === active); });
+        list.setAttribute('aria-activedescendant', options[active].id);
+      }
+
+      function select(i) {
+        selected = i;
+        var opt = options[i];
+        options.forEach(function (o, n) { o.setAttribute('aria-selected', String(n === i)); });
+        // Show icon + title in the toggle
+        current.innerHTML = '';
+        current.appendChild(opt.querySelector('.roast-icon').cloneNode(true));
+        var title = document.createElement('span');
+        title.className = 'roast-title';
+        title.textContent = opt.querySelector('.roast-title').textContent;
+        current.appendChild(title);
+        orderBtn.href = '/order-online?roast=' + encodeURIComponent(opt.dataset.value);
+      }
+
+      function open() {
+        list.hidden = false;
+        toggle.setAttribute('aria-expanded', 'true');
+        setActive(selected);
+        list.focus();
+      }
+
+      function close(refocus) {
+        list.hidden = true;
+        toggle.setAttribute('aria-expanded', 'false');
+        if (refocus) toggle.focus();
+      }
+
+      toggle.addEventListener('click', function () { list.hidden ? open() : close(); });
+
+      options.forEach(function (o, n) {
+        o.addEventListener('click', function () { select(n); close(true); });
+        o.addEventListener('mousemove', function () { setActive(n); });
+      });
+
+      list.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
+        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
+        else if (e.key === 'Home') { e.preventDefault(); setActive(0); }
+        else if (e.key === 'End') { e.preventDefault(); setActive(options.length - 1); }
+        else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(active); close(true); }
+        else if (e.key === 'Escape') { e.preventDefault(); close(true); }
+        else if (e.key === 'Tab') { close(); }
+      });
+
+      document.addEventListener('click', function (e) {
+        if (!list.hidden && !e.target.closest('.roast-picker')) close();
+      });
+
+      select(selected);
+    })();
+  </script>
