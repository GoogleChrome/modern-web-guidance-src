@@ -0,0 +1,26 @@
+import type { APIRoute } from 'astro';
+import { normalizePhone, verifyCode } from '../../../utils/phone-verification';
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+
+const MESSAGES = {
+  invalid: 'That code is incorrect. Check the message and try again.',
+  expired: 'That code has expired. Request a new one.',
+  too_many_attempts: 'Too many incorrect attempts. Request a new code.',
+};
+
+export const POST: APIRoute = async ({ request }) => {
+  const body = await request.json().catch(() => ({}));
+  const phone = normalizePhone(body.phone);
+  const code = typeof body.code === 'string' ? body.code.trim() : '';
+  if (!phone || !/^\d{6}$/.test(code)) {
+    return json({ error: 'Enter the 6-digit code.' }, 400);
+  }
+  const result = verifyCode(phone, code);
+  if (result !== 'ok') return json({ error: MESSAGES[result] }, 400);
+  return json({ verified: true });
+};
