+++ b/src/utils/phone-verification.ts
@@ -0,0 +1,75 @@
+import { createHash, randomInt, timingSafeEqual } from 'node:crypto';
+
+const CODE_TTL_MS = 5 * 60 * 1000;
+const RESEND_COOLDOWN_MS = 30 * 1000;
+const MAX_ATTEMPTS = 5;
+
+interface Challenge {
+  codeHash: Buffer;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+}
+
+// In-memory store; swap for a shared store when running more than one instance.
+const challenges = new Map<string, Challenge>();
+
+const hash = (phone: string, code: string) =>
+  createHash('sha256').update(`${phone}:${code}`).digest();
+
+/** Normalizes to E.164-ish form (+15551234567). Returns null when invalid. */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const cleaned = input.replace(/[\s().-]/g, '');
+  return /^\+[1-9]\d{7,14}$/.test(cleaned) ? cleaned : null;
+}
+
+/**
+ * Builds an SMS body with the origin-bound suffix the WebOTP API requires
+ * (`@host #code`), so browsers can extract the code automatically.
+ */
+export function buildMessage(code: string, host: string) {
+  return `Your DevTools Times verification code is ${code}\n\n@${host} #${code}`;
+}
+
+async function deliverSms(phone: string, body: string) {
+  // Plug an SMS provider (Twilio, etc.) in here.
+  console.log(`[sms] to ${phone}: ${body.replace(/\n/g, ' ')}`);
+}
+
+export async function sendCode(phone: string, host: string) {
+  const now = Date.now();
+  const existing = challenges.get(phone);
+  if (existing && now - existing.sentAt < RESEND_COOLDOWN_MS) {
+    return {
+      ok: false as const,
+      retryAfter: Math.ceil((RESEND_COOLDOWN_MS - (now - existing.sentAt)) / 1000),
+    };
+  }
+  const code = String(randomInt(0, 1_000_000)).padStart(6, '0');
+  challenges.set(phone, {
+    codeHash: hash(phone, code),
+    expiresAt: now + CODE_TTL_MS,
+    sentAt: now,
+    attempts: 0,
+  });
+  await deliverSms(phone, buildMessage(code, host));
+  return { ok: true as const };
+}
+
+export function verifyCode(phone: string, code: string) {
+  const challenge = challenges.get(phone);
+  if (!challenge || Date.now() > challenge.expiresAt) {
+    challenges.delete(phone);
+    return 'expired' as const;
+  }
+  if (challenge.attempts >= MAX_ATTEMPTS) {
+    challenges.delete(phone);
+    return 'too_many_attempts' as const;
+  }
+  challenge.attempts++;
+  const candidate = hash(phone, code);
+  if (!timingSafeEqual(candidate, challenge.codeHash)) return 'invalid' as const;
+  challenges.delete(phone);
+  return 'ok' as const;
+}
