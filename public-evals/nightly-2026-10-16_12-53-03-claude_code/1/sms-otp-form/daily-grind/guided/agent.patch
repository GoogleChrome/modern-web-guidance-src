+  <script>
+    const phoneForm = document.getElementById('phone-form');
+    const phoneInput = document.getElementById('phone-input');
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const resendBtn = document.getElementById('resend-btn');
+    const statusEl = document.getElementById('verify-status');
+
+    function setStatus(message, type = '') {
+      statusEl.textContent = message;
+      statusEl.className = 'verify-status ' + type;
+    }
+
+    // Posts to the backend. The server must send an SMS whose last line is
+    // "@<this-domain> #<code>" so WebOTP and Safari autofill can bind the code to this origin.
+    async function post(url, data) {
+      const res = await fetch(url, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(data),
+      });
+      if (!res.ok) throw new Error('Request failed');
+      return res.json().catch(() => ({}));
+    }
+
+    let otpAbortController = null;
+
+    function stopSmsOtpListener() {
+      otpAbortController?.abort();
+      otpAbortController = null;
+    }
+
+    async function startSmsOtpListener() {
+      if (!('OTPCredential' in window)) return;
+
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+
+      try {
+        const otp = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: ac.signal });
+        if (!otp) return;
+        otpInput.value = otp.code;
+        otpForm.requestSubmit();
+      } catch (err) {
+        if (err?.name !== 'AbortError') console.error('WebOTP error:', err);
+      }
+    }
+
+    async function sendCode(isResend) {
+      setStatus('Sending code…');
+      try {
+        await post(phoneForm.action, { phone: phoneInput.value.trim() });
+      } catch {
+        setStatus('We couldn’t send a code. Check the number and try again.', 'error');
+        return;
+      }
+      document.getElementById('otp-phone').textContent = phoneInput.value.trim();
+      phoneForm.hidden = true;
+      otpForm.hidden = false;
+      otpInput.value = '';
+      otpInput.focus();
+      setStatus(isResend ? 'A new code was sent.' : 'Code sent.');
+      startSmsOtpListener();
+    }
+
+    phoneForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      sendCode(false);
+    });
+
+    resendBtn.addEventListener('click', async () => {
+      stopSmsOtpListener();
+      resendBtn.disabled = true;
+      await sendCode(true);
+      resendBtn.disabled = false;
+    });
+
+    otpForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      stopSmsOtpListener();
+      setStatus('Verifying…');
+      try {
+        await post(otpForm.action, { phone: phoneInput.value.trim(), otp: otpInput.value });
+        otpForm.hidden = true;
+        setStatus('Your phone number is verified.', 'success');
+      } catch {
+        setStatus('That code didn’t work. Check it and try again, or resend a new one.', 'error');
+        otpInput.select();
+        startSmsOtpListener();
+      }
+    });
+  </script>
