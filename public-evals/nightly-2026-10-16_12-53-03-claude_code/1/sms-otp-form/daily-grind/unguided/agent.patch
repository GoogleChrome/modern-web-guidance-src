+  <script>
+    (() => {
+      // Backend endpoints: POST {phone} -> send SMS; POST {phone, code} -> verify.
+      // The SMS body should end with "@<your-domain> #<code>" so WebOTP can extract it.
+      const API = { send: '/api/verify/send', check: '/api/verify/check' };
+      const RESEND_SECONDS = 30;
+
+      const $ = (id) => document.getElementById(id);
+      const phoneForm = $('phone-form'), codeForm = $('code-form');
+      const phone = $('phone'), code = $('code');
+      const phoneError = $('phone-error'), codeError = $('code-error');
+      const status = $('verify-status');
+      const sendBtn = $('send-btn'), verifyBtn = $('verify-btn'), resendBtn = $('resend-btn');
+
+      let abortOtp = null, timer = null, currentPhone = '';
+
+      const normalize = (v) => {
+        const s = v.trim();
+        const digits = s.replace(/\D/g, '');
+        return (s.startsWith('+') ? '+' : '') + digits;
+      };
+      const isValidPhone = (v) => /^\+?[1-9]\d{7,14}$/.test(v);
+
+      function setError(input, el, msg) {
+        el.textContent = msg;
+        if (msg) input.setAttribute('aria-invalid', 'true');
+        else input.removeAttribute('aria-invalid');
+        if (msg) input.focus();
+      }
+
+      async function post(url, body) {
+        const res = await fetch(url, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(body),
+        });
+        let data = {};
+        try { data = await res.json(); } catch (_) { /* non-JSON body */ }
+        if (!res.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
+        return data;
+      }
+
+      function startCountdown() {
+        let left = RESEND_SECONDS;
+        clearInterval(timer);
+        resendBtn.disabled = true;
+        const tick = () => {
+          resendBtn.textContent = left > 0 ? `Resend code (${left}s)` : 'Resend code';
+          if (left-- <= 0) { clearInterval(timer); resendBtn.disabled = false; }
+        };
+        tick();
+        timer = setInterval(tick, 1000);
+      }
+
+      // Automatic extraction: WebOTP API (Chrome/Android). Other browsers use
+      // autocomplete="one-time-code" (iOS Safari suggests the code on the keyboard).
+      async function listenForOtp() {
+        if (!('OTPCredential' in window)) return;
+        abortOtp?.abort();
+        abortOtp = new AbortController();
+        try {
+          const cred = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: abortOtp.signal });
+          if (cred?.code) {
+            code.value = cred.code.replace(/\D/g, '').slice(0, 6);
+            status.textContent = 'Code detected from your text message.';
+            codeForm.requestSubmit();
+          }
+        } catch (_) { /* aborted or dismissed; manual entry still works */ }
+      }
+
+      async function sendCode(isResend) {
+        setError(phone, phoneError, '');
+        status.textContent = isResend ? 'Sending a new code…' : 'Sending code…';
+        sendBtn.disabled = true;
+        resendBtn.disabled = true;
+        try {
+          await post(API.send, { phone: currentPhone });
+          $('sent-to').textContent = currentPhone;
+          phoneForm.hidden = true;
+          codeForm.hidden = false;
+          code.value = '';
+          status.textContent = 'Code sent. Check your text messages.';
+          code.focus();
+          startCountdown();
+          listenForOtp();
+        } catch (err) {
+          status.textContent = '';
+          if (codeForm.hidden) setError(phone, phoneError, err.message);
+          else { setError(code, codeError, err.message); resendBtn.disabled = false; }
+        } finally {
+          sendBtn.disabled = false;
+        }
+      }
+
+      phoneForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const value = normalize(phone.value);
+        if (!isValidPhone(value)) {
+          setError(phone, phoneError, 'Enter a valid phone number including country code, e.g. +15551234567.');
+          return;
+        }
+        currentPhone = value;
+        sendCode(false);
+      });
+
+      resendBtn.addEventListener('click', () => { setError(code, codeError, ''); sendCode(true); });
+
+      $('change-btn').addEventListener('click', () => {
+        abortOtp?.abort();
+        clearInterval(timer);
+        codeForm.hidden = true;
+        phoneForm.hidden = false;
+        setError(code, codeError, '');
+        status.textContent = '';
+        phone.focus();
+      });
+
+      // Keep digits only (handles pasted "123 456" or "123-456").
+      code.addEventListener('input', () => {
+        code.value = code.value.replace(/\D/g, '').slice(0, 6);
+        if (code.value.length) setError(code, codeError, '');
+      });
+
+      codeForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        if (!/^\d{6}$/.test(code.value)) {
+          setError(code, codeError, 'Enter the 6-digit code from your text message.');
+          return;
+        }
+        verifyBtn.disabled = true;
+        status.textContent = 'Verifying…';
+        try {
+          await post(API.check, { phone: currentPhone, code: code.value });
+          abortOtp?.abort();
+          clearInterval(timer);
+          codeForm.hidden = true;
+          status.innerHTML = '';
+          const ok = document.createElement('span');
+          ok.className = 'success';
+          ok.textContent = `✓ ${currentPhone} is verified.`;
+          status.appendChild(ok);
+        } catch (err) {
+          status.textContent = '';
+          setError(code, codeError, err.message);
+        } finally {
+          verifyBtn.disabled = false;
+        }
+      });
+    })();
+  </script>
 </body>
 
