+  <script>
+    const postJSON = (url, body) => fetch(url, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      credentials: 'same-origin',
+      body: JSON.stringify(body)
+    });
+
+    // Silently register a passkey after a successful password sign-in. Never shows UI.
+    async function promotePasskey() {
+      let credential;
+      try {
+        if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) return;
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalCreate !== true) return;
+
+        const optionsResponse = await postJSON('/api/register/options', { conditional: true });
+        if (!optionsResponse.ok) return;
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsResponse.json());
+
+        credential = await navigator.credentials.create({ publicKey, mediation: 'conditional' });
+        if (!credential) return;
+
+        const encoded = credential.toJSON();
+        let verified = false;
+        try {
+          verified = (await postJSON('/api/register/verify', encoded)).ok;
+        } catch { /* network failure: treat as unverified */ }
+
+        // Tell the passkey provider to drop a credential the server did not accept.
+        if (!verified && PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp?.id ?? location.hostname,
+            credentialId: encoded.id
+          });
+        }
+      } catch {
+        // InvalidStateError, NotAllowedError, AbortError, etc.: promotion is best-effort.
+      }
+    }
+
+    document.getElementById('signin-form').addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const form = event.currentTarget;
+      try {
+        const response = await postJSON('/api/signin', {
+          email: form.elements.email.value,
+          password: form.elements.password.value
+        });
+        if (!response.ok) return;
+      } catch {
+        return;
+      }
+      promotePasskey(); // intentionally not awaited: runs in the background
+    });
+  </script>
