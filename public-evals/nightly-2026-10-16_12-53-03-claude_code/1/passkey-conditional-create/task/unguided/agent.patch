+  <script>
+    const b64urlToBuffer = (value) => {
+      const b64 = value.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(value.length / 4) * 4, '=');
+      return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)).buffer;
+    };
+
+    const postJSON = (url, body) => fetch(url, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      credentials: 'same-origin',
+      body: JSON.stringify(body || {})
+    });
+
+    const toCreationOptions = (json) => {
+      if (window.PublicKeyCredential && PublicKeyCredential.parseCreationOptionsFromJSON) {
+        return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+      }
+      return {
+        ...json,
+        challenge: b64urlToBuffer(json.challenge),
+        user: { ...json.user, id: b64urlToBuffer(json.user.id) },
+        excludeCredentials: (json.excludeCredentials || []).map((c) => ({ ...c, id: b64urlToBuffer(c.id) }))
+      };
+    };
+
+    // Silently promote a password sign-in to a passkey. Never surfaces UI or errors.
+    async function promotePasskey() {
+      try {
+        if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) return;
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!capabilities || !capabilities.conditionalCreate) return;
+
+        const optionsRes = await postJSON('/api/register/options');
+        if (!optionsRes.ok) return;
+        const publicKey = toCreationOptions(await optionsRes.json());
+
+        const credential = await navigator.credentials.create({ publicKey, mediation: 'conditional' });
+        if (!credential) return;
+
+        await postJSON('/api/register/verify', credential.toJSON());
+      } catch (e) {
+        // Intentionally silent: background registration must never disturb the user.
+      }
+    }
+
+    document.getElementById('signin-form').addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const form = event.currentTarget;
+      try {
+        const res = await postJSON('/api/signin', {
+          username: form.elements.username.value,
+          password: form.elements.password.value
+        });
+        if (!res.ok) return;
+      } catch (e) {
+        return;
+      }
+      promotePasskey();
+    });
+  </script>
+
