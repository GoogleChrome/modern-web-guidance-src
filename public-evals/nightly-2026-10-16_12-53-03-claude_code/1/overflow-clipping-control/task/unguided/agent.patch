+    /* Showcase Section */
+    .showcase {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 40px;
+      margin-bottom: 60px;
+    }
+
+    /* Children are clipped at the content box, following the inner curve of the rounded border */
+    .nested-curve-parent {
+      padding: 28px;
+      border: 4px solid var(--primary);
+      border-radius: 32px;
+      background: white;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: clip;
+      overflow-clip-margin: content-box;
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      height: 220px;
+      object-fit: cover;
+    }
+
+    .nested-curve-parent h3 {
+      margin: 16px 0 8px;
+      color: var(--primary);
+    }
+
+    .nested-curve-footer {
+      margin-top: 16px;
+      padding: 12px 16px;
+      background: var(--secondary);
+      font-size: 0.9rem;
+    }
+
+    /* Overflowing text is clipped, but only 15px beyond the box so the button glow survives */
+    .safety-zone-parent {
+      padding: 28px;
+      border-radius: 16px;
+      background: var(--primary);
+      color: white;
+      text-align: center;
+      overflow: clip;
+      overflow-clip-margin: 15px;
+    }
+
+    .safety-zone-parent h3 {
+      margin-bottom: 8px;
+      color: var(--accent);
+    }
+
+    .glow-btn {
+      margin-top: 20px;
+      padding: 14px 32px;
+      border: none;
+      border-radius: 999px;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 1rem;
+      font-weight: bold;
+      cursor: pointer;
+      box-shadow: 0 0 20px 8px rgba(255, 171, 64, 0.7),
+        0 0 40px 12px rgba(255, 171, 64, 0.4);
+    }
+
     footer {
