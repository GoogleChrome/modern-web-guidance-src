+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var tempEl = document.getElementById('roast-temp-value');
+      var ctx = canvas.getContext('2d');
+      var beans = [];
+      var temp = 20;
+      var rafId = null;
+      var intervalId = null;
+      var inView = false;
+      var pageVisible = !document.hidden;
+      var width = 0;
+      var height = 0;
+
+      function resize() {
+        var dpr = window.devicePixelRatio || 1;
+        width = canvas.clientWidth;
+        height = canvas.clientHeight;
+        canvas.width = Math.round(width * dpr);
+        canvas.height = Math.round(height * dpr);
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      }
+
+      function makeBeans() {
+        beans = [];
+        for (var i = 0; i < 40; i++) {
+          beans.push({
+            x: Math.random() * width,
+            y: height * 0.4 + Math.random() * height * 0.5,
+            vx: (Math.random() - 0.5) * 1.5,
+            vy: (Math.random() - 0.5) * 1.5,
+            r: 12 + Math.random() * 6,
+            angle: Math.random() * Math.PI * 2,
+            spin: (Math.random() - 0.5) * 0.08
+          });
+        }
+      }
+
+      // Bean colour shifts from green to dark brown as temperature rises
+      function beanColor() {
+        var t = Math.min(Math.max((temp - 20) / 220, 0), 1);
+        var r = Math.round(120 - 80 * t);
+        var g = Math.round(150 - 110 * t);
+        var b = Math.round(70 - 50 * t);
+        return 'rgb(' + r + ',' + g + ',' + b + ')';
+      }
+
+      function draw() {
+        ctx.clearRect(0, 0, width, height);
+        var color = beanColor();
+        for (var i = 0; i < beans.length; i++) {
+          var b = beans[i];
+          b.x += b.vx;
+          b.y += b.vy;
+          b.angle += b.spin;
+          if (b.x < b.r || b.x > width - b.r) b.vx *= -1;
+          if (b.y < height * 0.3 || b.y > height - b.r) b.vy *= -1;
+
+          ctx.save();
+          ctx.translate(b.x, b.y);
+          ctx.rotate(b.angle);
+          ctx.fillStyle = color;
+          ctx.beginPath();
+          ctx.ellipse(0, 0, b.r, b.r * 0.65, 0, 0, Math.PI * 2);
+          ctx.fill();
+          ctx.strokeStyle = 'rgba(0, 0, 0, 0.45)';
+          ctx.lineWidth = 2;
+          ctx.beginPath();
+          ctx.moveTo(-b.r * 0.8, 0);
+          ctx.quadraticCurveTo(0, b.r * 0.3, b.r * 0.8, 0);
+          ctx.stroke();
+          ctx.restore();
+        }
+      }
+
+      function frame() {
+        draw();
+        rafId = requestAnimationFrame(frame);
+      }
+
+      function tick() {
+        // Rises quickly, then slows and holds near 240C with slight jitter
+        temp += (240 - temp) * 0.02 + (Math.random() - 0.5) * 0.6;
+        tempEl.textContent = temp.toFixed(1);
+      }
+
+      function start() {
+        if (rafId === null) rafId = requestAnimationFrame(frame);
+        if (intervalId === null) intervalId = setInterval(tick, 500);
+      }
+
+      function stop() {
+        if (rafId !== null) {
+          cancelAnimationFrame(rafId);
+          rafId = null;
+        }
+        if (intervalId !== null) {
+          clearInterval(intervalId);
+          intervalId = null;
+        }
+      }
+
+      function update() {
+        if (inView && pageVisible) start();
+        else stop();
+      }
+
+      function setInView(value) {
+        inView = value;
+        update();
+      }
+
+      // Also pause when the tab is hidden
+      document.addEventListener('visibilitychange', function () {
+        pageVisible = !document.hidden;
+        update();
+      });
+
+      window.addEventListener('resize', function () {
+        resize();
+        if (rafId === null && inView) draw();
+      });
+
+      resize();
+      makeBeans();
+      draw();
+
+      if ('IntersectionObserver' in window) {
+        new IntersectionObserver(function (entries) {
+          setInView(entries[entries.length - 1].isIntersecting);
+        }).observe(widget);
+      } else {
+        // Fallback for older browsers: check geometry on scroll/resize
+        var checkQueued = false;
+        var check = function () {
+          checkQueued = false;
+          var rect = widget.getBoundingClientRect();
+          var vh = window.innerHeight || document.documentElement.clientHeight;
+          setInView(rect.bottom > 0 && rect.top < vh);
+        };
+        var queueCheck = function () {
+          if (checkQueued) return;
+          checkQueued = true;
+          (window.requestAnimationFrame || window.setTimeout)(check, 16);
+        };
+        window.addEventListener('scroll', queueCheck, { passive: true });
+        window.addEventListener('resize', queueCheck);
+        check();
+      }
+    })();
+  </script>
+
 </body>
 
