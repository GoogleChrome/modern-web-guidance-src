diff --git a/index.html b/index.html
index 66c9173..ad5c46e 100644
--- a/index.html
+++ b/index.html
@@ -207,6 +207,69 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // WebMCP: expose the page's client-side functionality as tools for AI agents.
+    // Tools are derived from the DOM so they stay in sync with the markup.
+    if ('modelContext' in document) {
+      const controller = new AbortController();
+      const { signal } = controller;
+      addEventListener('pagehide', () => controller.abort());
+
+      const pageLinks = () =>
+        [...document.querySelectorAll('nav a, .hero a, footer a')]
+          .filter((a) => !a.matches('.logout-link'))
+          .map((a) => ({ label: a.textContent.trim(), path: a.getAttribute('href') }));
+
+      const seasonalItems = () =>
+        [...document.querySelectorAll('.card')].map((card) => ({
+          name: card.querySelector('h3').textContent.trim(),
+          description: card.querySelector('p').textContent.trim(),
+          path: card.querySelector('a').getAttribute('href'),
+        }));
+
+      document.modelContext.registerTool({
+        name: 'list-seasonal-favorites',
+        description: 'Lists the seasonal drinks featured on the page. Use when the user asks what the coffee shop offers or recommends.',
+        inputSchema: { type: 'object', properties: {} },
+        execute: () => seasonalItems(),
+        annotations: { readOnlyHint: true },
+      }, { signal });
+
+      document.modelContext.registerTool({
+        name: 'list-site-pages',
+        description: 'Lists the pages of the Daily Grind site that can be visited. Use to find where to go before navigating.',
+        inputSchema: { type: 'object', properties: {} },
+        execute: () => pageLinks(),
+        annotations: { readOnlyHint: true },
+      }, { signal });
+
+      document.modelContext.registerTool({
+        name: 'navigate-to-page',
+        description: 'Opens a page of the Daily Grind site in this tab, such as the menu, locations, rewards or online ordering.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            path: {
+              type: 'string',
+              enum: [...new Set([...pageLinks(), ...seasonalItems()].map((l) => l.path))],
+              description: 'Site path of the page to open.',
+            },
+          },
+          required: ['path'],
+        },
+        execute({ path } = {}) {
+          const known = [...pageLinks(), ...seasonalItems()].map((l) => l.path);
+          if (typeof path !== 'string' || !known.includes(path)) {
+            return { error: `Unknown page "${path}".`, availablePaths: known };
+          }
+          location.href = path;
+          return { navigatingTo: path };
+        },
+        annotations: { readOnlyHint: false },
+      }, { signal });
+    }
+  </script>
+
 </body>
 
 </html>
