+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const STORAGE_KEY = 'daily-grind-passkeys';
+    // Demo data until a backend is wired up.
+    const seed = [
+      { id: 'pk1', name: 'MacBook Touch ID', created: '2026-01-14', lastUsed: '2026-10-15' },
+      { id: 'pk2', name: 'iPhone Face ID', created: '2026-03-02', lastUsed: '2026-10-10' },
+      { id: 'pk3', name: 'YubiKey 5C', created: '2026-06-21', lastUsed: null }
+    ];
+
+    let passkeys;
+    try {
+      passkeys = JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? seed;
+    } catch {
+      passkeys = seed;
+    }
+    let activeId = null;
+
+    const list = document.getElementById('passkey-list');
+    const renameDialog = document.getElementById('rename-dialog');
+    const renameInput = document.getElementById('rename-input');
+    const deleteDialog = document.getElementById('delete-dialog');
+    const fmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+    const date = (d) => fmt.format(new Date(d + 'T00:00:00'));
+
+    function save() {
+      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(passkeys)); } catch {}
+    }
+
+    function render() {
+      list.replaceChildren();
+      if (!passkeys.length) {
+        const li = document.createElement('li');
+        li.className = 'passkey-empty';
+        li.textContent = 'No passkeys registered.';
+        list.append(li);
+        return;
+      }
+      for (const pk of passkeys) {
+        const li = document.createElement('li');
+        li.className = 'passkey';
+        li.innerHTML = `
+          <div>
+            <div class="passkey-name"></div>
+            <div class="passkey-meta">Added ${date(pk.created)} · ${pk.lastUsed ? 'Last used ' + date(pk.lastUsed) : 'Never used'}</div>
+          </div>
+          <div class="passkey-actions">
+            <button type="button" class="btn secondary" data-action="rename" commandfor="rename-dialog" command="show-modal">Rename</button>
+            <button type="button" class="btn secondary" data-action="delete" commandfor="delete-dialog" command="show-modal">Remove</button>
+          </div>`;
+        const name = li.querySelector('.passkey-name');
+        name.textContent = pk.name;
+        for (const b of li.querySelectorAll('button')) {
+          b.dataset.id = pk.id;
+          b.setAttribute('aria-label', `${b.textContent} ${pk.name}`);
+        }
+        list.append(li);
+      }
+    }
+
+    list.addEventListener('click', (e) => {
+      const btn = e.target.closest('button[data-action]');
+      if (!btn) return;
+      activeId = btn.dataset.id;
+      const pk = passkeys.find((p) => p.id === activeId);
+      if (btn.dataset.action === 'rename') {
+        renameInput.value = pk.name;
+      } else {
+        document.getElementById('delete-text').textContent =
+          `"${pk.name}" will no longer be able to sign in to your account. This can't be undone.`;
+      }
+    });
+
+    renameDialog.addEventListener('command', (e) => {
+      if (e.command === 'show-modal') renameInput.select();
+    });
+
+    document.getElementById('rename-form').addEventListener('submit', () => {
+      const pk = passkeys.find((p) => p.id === activeId);
+      const name = renameInput.value.trim();
+      if (pk && name) {
+        pk.name = name;
+        save();
+        render();
+      }
+    });
+
+    document.getElementById('delete-confirm').addEventListener('click', () => {
+      passkeys = passkeys.filter((p) => p.id !== activeId);
+      save();
+      render();
+      document.getElementById('passkeys-heading').focus();
+    });
+
+    document.getElementById('passkeys-heading').tabIndex = -1;
+    render();
+  </script>
 </body>
 
