diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..efb5eee
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,204 @@
+import React, { useEffect, useState } from 'react';
+import type { Passkey } from '../pages/api/passkeys/index';
+
+const API = `${import.meta.env.BASE_URL}api/passkeys`;
+
+const formatDate = (iso: string | null) =>
+  iso ? new Date(iso).toLocaleDateString(undefined, { dateStyle: 'medium' }) : 'Never';
+
+const toBase64Url = (buffer: ArrayBuffer) =>
+  btoa(String.fromCharCode(...new Uint8Array(buffer)))
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '');
+
+export default function PasskeyManager() {
+  const [passkeys, setPasskeys] = useState<Passkey[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editName, setEditName] = useState('');
+
+  useEffect(() => {
+    fetch(API)
+      .then((r) => r.json())
+      .then((data) => setPasskeys(data.passkeys))
+      .catch(() => setError('Could not load your passkeys.'))
+      .finally(() => setLoading(false));
+  }, []);
+
+  const request = async (url: string, init: RequestInit) => {
+    setError(null);
+    setBusy(true);
+    try {
+      const response = await fetch(url, {
+        ...init,
+        headers: { 'Content-Type': 'application/json' },
+      });
+      const data = await response.json();
+      if (!response.ok) throw new Error(data.error || 'Request failed');
+      if (data.passkeys) setPasskeys(data.passkeys);
+      return true;
+    } catch (err) {
+      setError(err instanceof Error ? err.message : 'Something went wrong.');
+      return false;
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const addPasskey = async () => {
+    setError(null);
+    if (!window.PublicKeyCredential) {
+      setError('This browser does not support passkeys.');
+      return;
+    }
+    try {
+      const credential = (await navigator.credentials.create({
+        publicKey: {
+          challenge: crypto.getRandomValues(new Uint8Array(32)),
+          rp: { name: 'The DevTools Times', id: location.hostname },
+          user: {
+            id: crypto.getRandomValues(new Uint8Array(16)),
+            name: 'reader',
+            displayName: 'Reader',
+          },
+          pubKeyCredParams: [
+            { type: 'public-key', alg: -7 },
+            { type: 'public-key', alg: -257 },
+          ],
+          authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+          excludeCredentials: passkeys.map((p) => ({
+            type: 'public-key' as const,
+            id: Uint8Array.from(atob(p.id.replace(/-/g, '+').replace(/_/g, '/')), (c) =>
+              c.charCodeAt(0),
+            ),
+          })),
+        },
+      })) as PublicKeyCredential | null;
+      if (!credential) return;
+      await request(API, {
+        method: 'POST',
+        body: JSON.stringify({ id: toBase64Url(credential.rawId) }),
+      });
+      // POST returns the full list too, but refresh to keep a single source of truth.
+      const data = await (await fetch(API)).json();
+      setPasskeys(data.passkeys);
+    } catch (err) {
+      if (err instanceof DOMException && err.name === 'NotAllowedError') return; // cancelled
+      setError('Could not create a passkey on this device.');
+    }
+  };
+
+  const saveName = async (id: string) => {
+    if (!editName.trim()) return;
+    const ok = await request(`${API}/${encodeURIComponent(id)}`, {
+      method: 'PATCH',
+      body: JSON.stringify({ name: editName }),
+    });
+    if (ok) setEditingId(null);
+  };
+
+  const remove = (p: Passkey) => {
+    if (!window.confirm(`Remove "${p.name}"? You won't be able to sign in with it anymore.`)) return;
+    request(`${API}/${encodeURIComponent(p.id)}`, { method: 'DELETE' });
+  };
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <div className="flex items-start justify-between gap-4 mb-2">
+        <h2 className="text-2xl font-bold text-gray-800">Passkeys</h2>
+        <button
+          type="button"
+          onClick={addPasskey}
+          disabled={busy}
+          className="py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-75"
+        >
+          Add passkey
+        </button>
+      </div>
+      <p className="text-sm text-gray-600 mb-6">
+        Passkeys let you sign in with your fingerprint, face, or device PIN instead of a password.
+      </p>
+
+      {error && (
+        <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+
+      {loading ? (
+        <p className="text-sm text-gray-500">Loading…</p>
+      ) : passkeys.length === 0 ? (
+        <p className="text-sm text-gray-500 border border-dashed border-gray-300 rounded-md p-6 text-center">
+          You haven't registered any passkeys yet.
+        </p>
+      ) : (
+        <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md">
+          {passkeys.map((p) => (
+            <li key={p.id} className="p-4 flex items-center justify-between gap-4">
+              {editingId === p.id ? (
+                <form
+                  className="flex flex-1 gap-2"
+                  onSubmit={(e) => {
+                    e.preventDefault();
+                    saveName(p.id);
+                  }}
+                >
+                  <input
+                    autoFocus
+                    aria-label="Passkey name"
+                    value={editName}
+                    maxLength={64}
+                    onChange={(e) => setEditName(e.target.value)}
+                    className="flex-1 px-3 py-1 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                  />
+                  <button type="submit" disabled={busy} className="text-sm font-medium text-gray-900">
+                    Save
+                  </button>
+                  <button
+                    type="button"
+                    onClick={() => setEditingId(null)}
+                    className="text-sm text-gray-600"
+                  >
+                    Cancel
+                  </button>
+                </form>
+              ) : (
+                <>
+                  <div className="min-w-0">
+                    <p className="font-medium text-gray-800 truncate">{p.name}</p>
+                    <p className="text-xs text-gray-500">
+                      Added {formatDate(p.createdAt)} · Last used {formatDate(p.lastUsedAt)}
+                    </p>
+                  </div>
+                  <div className="flex gap-4 shrink-0 text-sm">
+                    <button
+                      type="button"
+                      onClick={() => {
+                        setEditingId(p.id);
+                        setEditName(p.name);
+                      }}
+                      className="text-gray-700 hover:underline"
+                    >
+                      Rename
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => remove(p)}
+                      disabled={busy}
+                      className="text-red-700 hover:underline"
+                    >
+                      Remove
+                    </button>
+                  </div>
+                </>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
