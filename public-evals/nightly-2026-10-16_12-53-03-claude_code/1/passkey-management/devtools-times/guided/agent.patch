--- /dev/null
+++ b/src/pages/api/passkeys/index.ts
@@ -0,0 +1,43 @@
+import type { APIRoute } from 'astro';
+
+export interface Passkey {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+
+export const GET: APIRoute = async ({ session }) => {
+  const passkeys: Passkey[] = (await session?.get('passkeys')) || [];
+  return json({ passkeys });
+};
+
+// Registers a passkey from a freshly created WebAuthn credential.
+// Note: the attestation is not cryptographically verified here.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { id, name } = await request.json();
+  if (!id || typeof id !== 'string') {
+    return json({ error: 'Credential id is required' }, 400);
+  }
+
+  const passkeys: Passkey[] = (await session?.get('passkeys')) || [];
+  if (passkeys.some((p) => p.id === id)) {
+    return json({ error: 'This passkey is already registered' }, 409);
+  }
+
+  const passkey: Passkey = {
+    id,
+    name: (typeof name === 'string' && name.trim()) || `Passkey ${passkeys.length + 1}`,
+    createdAt: new Date().toISOString(),
+    lastUsedAt: null,
+  };
+  passkeys.push(passkey);
+  await session?.set('passkeys', passkeys);
+  return json({ passkey, passkeys }, 201);
+};
