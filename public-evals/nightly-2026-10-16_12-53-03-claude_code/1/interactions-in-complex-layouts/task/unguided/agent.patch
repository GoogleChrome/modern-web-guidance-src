+  <script>
+    (() => {
+      const board = document.querySelector('.board');
+      const columns = Array.from(board.querySelectorAll('.board-column'));
+      const DRAG_THRESHOLD = 4;
+
+      // Column counts: coalesced into one rAF write, using cached DOM refs
+      const counters = new Map(columns.map(c => [c, c.querySelector('.column-count')]));
+      let countQueued = false;
+      function updateCounts() {
+        if (countQueued) return;
+        countQueued = true;
+        requestAnimationFrame(() => {
+          countQueued = false;
+          for (const [col, el] of counters) {
+            // children includes the header, so subtract it
+            el.textContent = col.childElementCount - 1;
+          }
+        });
+      }
+
+      let drag = null;
+
+      // Layout is read once per drag (not per pointermove); moves use transform only.
+      function measure() {
+        drag.rects = columns.map(c => c.getBoundingClientRect());
+        drag.dirty = false;
+      }
+
+      function columnAt(x, y) {
+        for (let i = 0; i < columns.length; i++) {
+          const r = drag.rects[i];
+          if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) return columns[i];
+        }
+        return null;
+      }
+
+      function setTarget(col) {
+        if (col === drag.target) return;
+        if (drag.target) drag.target.classList.remove('drop-target');
+        if (col) col.classList.add('drop-target');
+        drag.target = col;
+      }
+
+      function render() {
+        drag.raf = 0;
+        drag.ghost.style.transform = `translate3d(${drag.x - drag.offX}px, ${drag.y - drag.offY}px, 0)`;
+        setTarget(columnAt(drag.x, drag.y));
+      }
+
+      function schedule() {
+        if (!drag.raf) drag.raf = requestAnimationFrame(render);
+      }
+
+      function startDrag() {
+        const card = drag.card;
+        const rect = card.getBoundingClientRect();
+        const ghost = document.createElement('div');
+        ghost.className = 'card-ghost';
+        ghost.style.width = rect.width + 'px';
+        ghost.innerHTML = card.innerHTML;
+        drag.offX = drag.startX - rect.left;
+        drag.offY = drag.startY - rect.top;
+        document.body.appendChild(ghost);
+        drag.ghost = ghost;
+        drag.active = true;
+        card.classList.add('dragging');
+        document.body.classList.add('is-dragging');
+        measure();
+        window.addEventListener('scroll', onScroll, { passive: true, capture: true });
+      }
+
+      function onScroll() {
+        if (drag) drag.dirty = true;
+      }
+
+      function insertionPoint(col, y) {
+        // One layout read at drop time to find where the card belongs
+        const cards = col.children;
+        for (let i = 1; i < cards.length; i++) {
+          const c = cards[i];
+          if (c === drag.card) continue;
+          const r = c.getBoundingClientRect();
+          if (y < r.top + r.height / 2) return c;
+        }
+        return null;
+      }
+
+      function endDrag(commit) {
+        const d = drag;
+        drag = null;
+        window.removeEventListener('pointermove', onMove);
+        window.removeEventListener('pointerup', onUp);
+        window.removeEventListener('pointercancel', onCancel);
+        if (d.raf) cancelAnimationFrame(d.raf);
+        if (!d.active) return;
+        window.removeEventListener('scroll', onScroll, { capture: true });
+        const target = commit ? d.target : null;
+        if (target) {
+          drag = d; // insertionPoint reads drag.card
+          const before = insertionPoint(target, d.y);
+          drag = null;
+          target.insertBefore(d.card, before);
+          updateCounts();
+        }
+        if (d.target) d.target.classList.remove('drop-target');
+        d.card.classList.remove('dragging');
+        d.ghost.remove();
+        document.body.classList.remove('is-dragging');
+      }
+
+      function onMove(e) {
+        if (!drag || e.pointerId !== drag.pointerId) return;
+        drag.x = e.clientX;
+        drag.y = e.clientY;
+        if (!drag.active) {
+          if (Math.abs(drag.x - drag.startX) + Math.abs(drag.y - drag.startY) < DRAG_THRESHOLD) return;
+          startDrag();
+        }
+        if (drag.dirty) measure();
+        schedule();
+      }
+
+      function onUp(e) {
+        if (drag && e.pointerId === drag.pointerId) endDrag(true);
+      }
+
+      function onCancel(e) {
+        if (drag && e.pointerId === drag.pointerId) endDrag(false);
+      }
+
+      // Single delegated listener: cost doesn't grow with the number of cards
+      board.addEventListener('pointerdown', e => {
+        if (drag || e.button !== 0) return;
+        const card = e.target.closest('.card');
+        if (!card || !board.contains(card)) return;
+        drag = {
+          card, pointerId: e.pointerId,
+          startX: e.clientX, startY: e.clientY, x: e.clientX, y: e.clientY,
+          active: false, target: null, raf: 0, dirty: false
+        };
+        window.addEventListener('pointermove', onMove);
+        window.addEventListener('pointerup', onUp);
+        window.addEventListener('pointercancel', onCancel);
+      });
+
+      // Keyboard alternative: Arrow Left/Right moves the focused card between columns
+      board.addEventListener('keydown', e => {
+        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
+        const card = e.target.closest('.card');
+        if (!card) return;
+        const i = columns.indexOf(card.parentElement) + (e.key === 'ArrowRight' ? 1 : -1);
+        if (i < 0 || i >= columns.length) return;
+        e.preventDefault();
+        columns[i].appendChild(card);
+        card.focus();
+        updateCounts();
+      });
+
+      updateCounts();
+    })();
+  </script>
+
