+    /* Options dropdown */
+    #trigger-btn {
+      anchor-name: --options-trigger;
+      background: transparent;
+      color: white;
+      font: inherit;
+      font-size: 0.9rem;
+      border: 1px solid var(--secondary);
+      padding: 5px 12px;
+      border-radius: 4px;
+      cursor: pointer;
+      transition: color 0.3s, border-color 0.3s;
+    }
+
+    #trigger-btn:hover,
+    #trigger-btn[aria-expanded="true"] {
+      color: var(--accent);
+      border-color: var(--accent);
+    }
+
+    /* Rendered in the top layer via the Popover API, so no z-index or overflow clipping */
+    #action-panel {
+      position: fixed;
+      position-anchor: --options-trigger;
+      inset: auto;
+      margin: 0;
+      /* Directly below the trigger, left edges aligned */
+      top: anchor(bottom);
+      left: anchor(left);
+      /* Flip vertically/horizontally when colliding with the viewport */
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      min-width: 200px;
+      max-width: calc(100vw - 16px);
+      padding: 6px;
+      background: white;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
+    }
+
+    #action-panel:popover-open {
+      display: flex;
+      flex-direction: column;
+    }
+
+    #action-panel button {
+      background: none;
+      border: 0;
+      font: inherit;
+      font-size: 0.9rem;
+      color: inherit;
+      text-align: left;
+      padding: 8px 12px;
+      border-radius: 4px;
+      cursor: pointer;
+    }
+
+    #action-panel button:hover,
+    #action-panel button:focus-visible {
+      background: var(--secondary);
+    }
+
