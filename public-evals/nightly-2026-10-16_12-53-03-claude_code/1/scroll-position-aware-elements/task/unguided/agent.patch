diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -151,13 +151,76 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Scroll container */
+    .scroller {
+      position: relative;
+      height: 100vh;
+      overflow-y: auto;
+    }
+
+    /* Zero-cost scroll detection: observed by IntersectionObserver */
+    .scroller-sentinel {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 1px;
+      height: 200px;
+      pointer-events: none;
+      visibility: hidden;
+    }
+
+    /* Back to top: sticks to the viewport corner of the scroller while taking no layout space */
+    .back-to-top {
+      position: sticky;
+      bottom: 1.5rem;
+      display: block;
+      width: 3rem;
+      height: 3rem;
+      margin: -3rem 1.5rem 0 auto;
+      border: 0;
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--primary);
+      font-size: 1.4rem;
+      line-height: 1;
+      cursor: pointer;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
+      z-index: 1001;
+      opacity: 0;
+      transform: translateY(1rem);
+      /* visibility removes the hidden button from the tab order and a11y tree */
+      visibility: hidden;
+      transition: opacity 0.3s, transform 0.3s, visibility 0s linear 0.3s;
+    }
+
+    .back-to-top.is-visible {
+      opacity: 1;
+      transform: none;
+      visibility: visible;
+      transition-delay: 0s;
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .back-to-top {
+        transition: none;
+      }
+    }
   </style>
 </head>
 
 <body>
 
+  <div class="scroller" id="scroller">
+  <div class="scroller-sentinel"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +269,28 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button type="button" class="back-to-top" aria-label="Back to top">&uarr;</button>
+  </div>
+
+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var button = scroller.querySelector('.back-to-top');
+      var sentinel = scroller.querySelector('.scroller-sentinel');
+
+      // Show the button once the sentinel at the top of the container scrolls out of view.
+      new IntersectionObserver(function (entries) {
+        button.classList.toggle('is-visible', !entries[0].isIntersecting);
+      }, { root: scroller }).observe(sentinel);
+
+      button.addEventListener('click', function () {
+        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+        scroller.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
