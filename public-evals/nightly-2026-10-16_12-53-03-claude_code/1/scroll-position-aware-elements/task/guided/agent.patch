diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -151,13 +151,100 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Scroll container */
+    .scroller {
+      height: 100dvh;
+      overflow-y: auto;
+      position: relative;
+      /* Lets descendants query this element's scroll position */
+      container-type: scroll-state;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .scroller {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .scroll-sentinel {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 1px;
+      height: 1px;
+      pointer-events: none;
+    }
+
+    /* Back to top: hidden (and removed from tab order via visibility) until scrolled */
+    .back-to-top {
+      position: sticky;
+      bottom: 20px;
+      display: block;
+      width: 3rem;
+      height: 3rem;
+      /* Overlay the end of the content instead of adding height */
+      margin: -3rem 20px 20px auto;
+      border: 0;
+      border-radius: 50%;
+      background: var(--primary);
+      color: white;
+      font-size: 1.4rem;
+      line-height: 1;
+      cursor: pointer;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
+      z-index: 1001;
+      visibility: hidden;
+      opacity: 0;
+      translate: 0 20px;
+      transition:
+        visibility 0.3s,
+        opacity 0.3s ease,
+        translate 0.3s ease,
+        background 0.3s;
+    }
+
+    .back-to-top:hover,
+    .back-to-top:focus-visible {
+      background: #3e2723;
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .back-to-top {
+        transition: none;
+      }
+    }
+
+    /* Scrolled away from the top */
+    @container scroll-state(scrollable: top) {
+      .back-to-top {
+        visibility: visible;
+        opacity: 1;
+        translate: 0 0;
+      }
+    }
+
+    /* IntersectionObserver fallback (class set by script) */
+    .scroller.scrolled .back-to-top {
+      visibility: visible;
+      opacity: 1;
+      translate: 0 0;
+    }
   </style>
 </head>
 
 <body>
 
+  <div class="scroller">
+    <div class="scroll-sentinel" aria-hidden="true"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +293,25 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+    <button type="button" class="back-to-top" aria-label="Back to top">&uarr;</button>
+  </div>
+
+  <script>
+    const scroller = document.querySelector('.scroller');
+
+    document.querySelector('.back-to-top').addEventListener('click', () => {
+      scroller.scrollTo({ top: 0 });
+    });
+
+    // Fallback for browsers without container scroll-state queries
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      new IntersectionObserver(([entry]) => {
+        scroller.classList.toggle('scrolled', !entry.isIntersecting);
+      }, { root: scroller }).observe(document.querySelector('.scroll-sentinel'));
+    }
+  </script>
+
 </body>
 
 </html>
