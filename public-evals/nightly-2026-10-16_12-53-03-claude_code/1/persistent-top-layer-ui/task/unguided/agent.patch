+  <button type="button" class="btn feedback-launch" id="feedback-launch">Feedback</button>
+
+  <dialog class="feedback-dialog" id="feedback-dialog" aria-labelledby="feedback-title">
+    <h2 id="feedback-title">Tell us how we're doing</h2>
+    <p class="feedback-location">Currently inside: <strong id="feedback-location">body</strong></p>
+    <label for="feedback-text">Your feedback</label>
+    <textarea id="feedback-text" placeholder="Type here, then move me around&hellip;"></textarea>
+    <div class="feedback-moves" role="group" aria-label="Move this dialog">
+      <button type="button" class="btn secondary" data-move="#hero">Move to hero</button>
+      <button type="button" class="btn secondary" data-move="#seasonal-grid">Move to menu grid</button>
+      <button type="button" class="btn secondary" data-move="#site-footer">Move to footer</button>
+      <button type="button" class="btn secondary" data-move="body">Move to body</button>
+    </div>
+    <div class="feedback-actions">
+      <button type="button" class="btn" id="feedback-close">Close</button>
+    </div>
+    <p class="feedback-status" id="feedback-status" role="status" aria-live="polite"></p>
+  </dialog>
+
+  <script>
+    (() => {
+      const dialog = document.getElementById('feedback-dialog');
+      const launch = document.getElementById('feedback-launch');
+      const locationLabel = document.getElementById('feedback-location');
+      const status = document.getElementById('feedback-status');
+      const supportsMoveBefore = typeof Element.prototype.moveBefore === 'function';
+
+      const describe = (el) => el.id ? `#${el.id}` : el.tagName.toLowerCase();
+
+      // Relocate the open dialog. moveBefore() keeps the dialog open, in the
+      // top layer, and keeps focus/selection; otherwise we emulate that.
+      function relocate(target) {
+        if (dialog.parentNode === target && !dialog.nextSibling) return 'noop';
+
+        if (supportsMoveBefore) {
+          try {
+            target.moveBefore(dialog, null);
+            return 'moveBefore';
+          } catch (err) {
+            // e.g. target not connected / hierarchy error: use the fallback.
+          }
+        }
+
+        // Fallback: insertion resets the dialog, so capture and restore state.
+        const wasModal = dialog.matches(':modal');
+        const wasOpen = dialog.open;
+        const active = document.activeElement;
+        const focusInside = dialog.contains(active) ? active : null;
+        const selection = focusInside && 'selectionStart' in focusInside
+          ? [focusInside.selectionStart, focusInside.selectionEnd, focusInside.selectionDirection]
+          : null;
+        const scrolls = [dialog, ...dialog.querySelectorAll('*')]
+          .filter((el) => el.scrollTop || el.scrollLeft)
+          .map((el) => [el, el.scrollTop, el.scrollLeft]);
+
+        target.append(dialog); // removes then inserts; dialog is closed afterwards
+        if (dialog.open) dialog.close();
+
+        if (wasOpen) {
+          if (wasModal) dialog.showModal(); else dialog.show();
+        }
+        if (focusInside && dialog.contains(focusInside)) {
+          focusInside.focus({ preventScroll: true });
+          if (selection) focusInside.setSelectionRange(...selection);
+        }
+        for (const [el, top, left] of scrolls) {
+          el.scrollTop = top;
+          el.scrollLeft = left;
+        }
+        return 'fallback';
+      }
+
+      dialog.addEventListener('click', (event) => {
+        const btn = event.target.closest('[data-move]');
+        if (!btn) return;
+        const target = document.querySelector(btn.dataset.move);
+        if (!target) return;
+        const method = relocate(target);
+        locationLabel.textContent = describe(target);
+        status.textContent = method === 'noop'
+          ? 'Already there.'
+          : `Moved with ${method === 'moveBefore' ? 'moveBefore()' : 'fallback re-open'}.`;
+        btn.focus({ preventScroll: true });
+      });
+
+      launch.addEventListener('click', () => {
+        if (!dialog.open) dialog.showModal();
+      });
+      document.getElementById('feedback-close').addEventListener('click', () => dialog.close());
+
+      // Open by default so the overlay is persistent across the page.
+      dialog.showModal();
+    })();
+  </script>
+
