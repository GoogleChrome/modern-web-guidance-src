+  <button type="button" class="btn feedback-fab" id="feedback-open">Feedback</button>
+
+  <dialog id="feedback-dialog" class="feedback-dialog" aria-labelledby="feedback-title">
+    <h2 id="feedback-title">Send us feedback</h2>
+    <p>How is your visit going?</p>
+    <form method="dialog">
+      <label>
+        Your thoughts
+        <textarea name="message"></textarea>
+      </label>
+      <p class="feedback-location">Move this dialog to:</p>
+      <div class="feedback-actions">
+        <button type="button" data-move-to="site-nav">Nav</button>
+        <button type="button" data-move-to="site-hero">Hero</button>
+        <button type="button" data-move-to="site-main">Main</button>
+        <button type="button" data-move-to="site-footer">Footer</button>
+      </div>
+      <div class="feedback-actions">
+        <button type="submit" class="primary">Send</button>
+        <button type="submit" formnovalidate>Close</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    const dialog = document.getElementById('feedback-dialog');
+
+    document.getElementById('feedback-open').addEventListener('click', () => {
+      if (!dialog.open) dialog.showModal();
+    });
+
+    function moveDialog(target) {
+      if (dialog.parentElement === target) return;
+
+      // moveBefore() reparents atomically, so the modal stays open and focused.
+      if ('moveBefore' in Element.prototype) {
+        target.moveBefore(dialog, null);
+        return;
+      }
+
+      // Fallback: a plain move closes the dialog, so re-open it and restore state.
+      const wasOpen = dialog.open;
+      const focused = document.activeElement;
+      const selection = focused instanceof HTMLTextAreaElement
+        ? [focused.selectionStart, focused.selectionEnd]
+        : null;
+      const scrollTop = dialog.scrollTop;
+
+      target.append(dialog);
+      if (!wasOpen) return;
+
+      if (!dialog.open) dialog.showModal();
+      dialog.scrollTop = scrollTop;
+      if (focused && dialog.contains(focused)) {
+        focused.focus({ preventScroll: true });
+        if (selection) focused.setSelectionRange(...selection);
+      }
+    }
+
+    dialog.addEventListener('click', (event) => {
+      const button = event.target.closest('[data-move-to]');
+      if (!button) return;
+      moveDialog(document.getElementById(button.dataset.moveTo));
+      button.focus({ preventScroll: true });
+    });
+  </script>
+
