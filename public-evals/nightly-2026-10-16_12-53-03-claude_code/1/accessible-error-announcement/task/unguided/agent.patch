+  <script>
+    // Keep aria-invalid in sync with :user-invalid, so an untouched required
+    // field isn't announced as an error just because it's empty and focused.
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var status = document.getElementById('newsletter-status');
+
+      function syncAriaInvalid() {
+        var invalid;
+        try {
+          invalid = input.matches(':user-invalid');
+        } catch (e) {
+          // Browser without :user-invalid support: only flag after interaction.
+          invalid = input.dataset.touched === 'true' && !input.validity.valid;
+        }
+        input.setAttribute('aria-invalid', invalid ? 'true' : 'false');
+      }
+
+      input.setAttribute('aria-invalid', 'false');
+      input.addEventListener('blur', function () {
+        input.dataset.touched = 'true';
+        syncAriaInvalid();
+      });
+      input.addEventListener('input', syncAriaInvalid);
+      // Fired when a submit attempt fails validation; :user-invalid applies after.
+      input.addEventListener('invalid', function () {
+        input.dataset.touched = 'true';
+        requestAnimationFrame(syncAriaInvalid);
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        status.textContent = 'Thanks for subscribing!';
+        form.reset();
+        delete input.dataset.touched;
+        syncAriaInvalid();
+      });
+    })();
+  </script>
 </body>
 
