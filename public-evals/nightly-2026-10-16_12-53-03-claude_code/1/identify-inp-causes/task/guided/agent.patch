diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,35 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    // Attribution build includes INP subparts and Long Animation Frame data.
+    import { onINP } from 'https://unpkg.com/web-vitals@5/dist/web-vitals.attribution.js?module';
+
+    onINP((metric) => {
+      const { attribution } = metric;
+      const script = attribution.longestScript?.entry;
+      navigator.sendBeacon('/analytics', JSON.stringify({
+        name: 'INP',
+        value: metric.value,
+        rating: metric.rating,
+        // INP subparts: where the time went.
+        inputDelay: attribution.inputDelay,
+        processingDuration: attribution.processingDuration,
+        presentationDelay: attribution.presentationDelay,
+        interactionTarget: attribution.interactionTarget,
+        interactionType: attribution.interactionType,
+        // Longest script during the interaction (Long Animation Frames; Chromium only).
+        invokerType: script?.invokerType,
+        sourceURL: script?.sourceURL,
+        sourceFunctionName: script?.sourceFunctionName,
+        sourceCharPosition: script?.sourceCharPosition,
+        subpart: attribution.longestScript?.subpart,
+        intersectingDuration: attribution.longestScript?.intersectingDuration
+      }));
+    }, { reportAllChanges: false });
+  </script>
+
 </body>
 
 </html>
