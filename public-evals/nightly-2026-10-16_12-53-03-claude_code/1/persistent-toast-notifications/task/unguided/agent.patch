+    /* Toasts: popover="manual" puts each one in the top layer (no z-index needed).
+       Vertical offset comes from each toast's position among its .toast siblings. */
+    .toast {
+      --i: 1;
+      position: fixed;
+      inset: auto 1.5rem calc(1.5rem + (var(--i) - 1) * 4.5rem) auto;
+      margin: 0;
+      width: min(320px, calc(100vw - 3rem));
+      height: 3.5rem;
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 12px;
+      padding: 0 12px 0 16px;
+      border: none;
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
+      overflow: visible;
+      opacity: 1;
+      translate: 0 0;
+      transition: opacity 0.3s ease, translate 0.3s ease, bottom 0.3s ease;
+    }
+
+    @starting-style {
+      .toast {
+        opacity: 0;
+        translate: 100% 0;
+      }
+    }
+
+    .toast.leaving {
+      opacity: 0;
+      translate: 120% 0;
+    }
+
+    .toast-close {
+      background: none;
+      border: none;
+      color: inherit;
+      font-size: 1.4rem;
+      line-height: 1;
