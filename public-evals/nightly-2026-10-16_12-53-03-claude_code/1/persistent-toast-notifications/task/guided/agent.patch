+    /* Toasts: popover="manual" elements live in the top layer (no z-index needed).
+       Each toast anchors to the previous one (same anchor-name resolves to the
+       closest preceding toast) so the stack offsets itself in pure CSS. */
+    .toast {
+      --toast-gap: 0.75rem;
+      --toast-edge: 1.5rem;
+      anchor-name: --toast;
+      position: fixed;
+      inset: auto;
+      right: var(--toast-edge);
+      bottom: calc(anchor(--toast top, calc(var(--toast-edge) - var(--toast-gap))) + var(--toast-gap));
+      margin: 0;
+      display: flex;
+      align-items: center;
+      gap: 1rem;
+      padding: 0.75rem 0.75rem 0.75rem 1.25rem;
+      border: none;
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
+      overflow: visible;
+
+      opacity: 0;
+      translate: 0 1rem;
+      transition:
+        opacity 0.3s ease,
+        translate 0.3s ease,
+        bottom 0.3s ease,
+        display 0.3s allow-discrete,
+        overlay 0.3s allow-discrete;
+    }
+
+    .toast:popover-open {
+      opacity: 1;
+      translate: 0 0;
+    }
+
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        translate: 0 1rem;
+      }
+    }
+
+    .toast-close {
+      background: transparent;
+      border: none;
+      color: inherit;
+      font-size: 1.25rem;
+      line-height: 1;
+      padding: 0.25rem 0.5rem;
+      border-radius: 4px;
+      cursor: pointer;
+    }
+
+    .toast-close:hover {
+      background: rgba(255, 255, 255, 0.2);
+    }
+
+    @supports not (anchor-name: --toast) {
+      .toast {
+        bottom: var(--toast-edge);
+      }
+
+      .toast ~ .toast {
+        margin-bottom: 4rem;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transition-duration: 0.01s;
+        translate: 0 0;
+      }
+    }
