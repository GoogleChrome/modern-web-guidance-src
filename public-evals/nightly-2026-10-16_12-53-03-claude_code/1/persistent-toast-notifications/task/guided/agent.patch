+  <script type="module">
+    if (!("popover" in HTMLElement.prototype)) {
+      import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    const TOAST_DURATION = 3000;
+    let toastCount = 0;
+
+    function showToast(message) {
+      const toast = document.createElement("div");
+      toast.className = "toast";
+      toast.id = `toast-${++toastCount}`;
+      toast.setAttribute("popover", "manual");
+      toast.setAttribute("role", "status");
+
+      const text = document.createElement("span");
+      text.textContent = message;
+
+      const close = document.createElement("button");
+      close.type = "button";
+      close.className = "toast-close";
+      close.setAttribute("aria-label", "Close notification");
+      close.setAttribute("popovertarget", toast.id);
+      close.setAttribute("popovertargetaction", "hide");
+      close.textContent = "\u00d7";
+
+      toast.append(text, close);
+      document.body.append(toast);
+      toast.showPopover();
+
+      const timer = setTimeout(() => toast.hidePopover(), TOAST_DURATION);
+
+      // Remove from the DOM once the exit transition has finished.
+      toast.addEventListener("toggle", (e) => {
+        if (e.newState !== "closed") return;
+        clearTimeout(timer);
+        toast.addEventListener("transitionend", (te) => {
+          if (te.target === toast && te.propertyName === "opacity") toast.remove();
+        });
+      });
+    }
+
+    document.querySelectorAll(".toast-trigger").forEach((btn) =>
+      btn.addEventListener("click", () => showToast("Added to cart!"))
+    );
+  </script>
