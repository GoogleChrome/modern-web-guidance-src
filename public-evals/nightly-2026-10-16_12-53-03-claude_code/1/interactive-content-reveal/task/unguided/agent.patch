@@ -134,8 +134,53 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Spotlight reveal */
+    @property --mouse-x { syntax: '<length-percentage>'; inherits: true; initial-value: 50%; }
+    @property --mouse-y { syntax: '<length-percentage>'; inherits: true; initial-value: 50%; }
+    @property --inner-size { syntax: '<length>'; inherits: true; initial-value: 0px; }
+    @property --outer-size { syntax: '<length>'; inherits: true; initial-value: 0px; }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      overflow: hidden;
+      padding-bottom: 44px;
+      transition: --inner-size 0.35s ease, --outer-size 0.35s ease;
+    }
+
+    .product-card:hover {
+      --inner-size: 90px;
+      --outer-size: 140px;
+    }
+
+    .spotlight {
+      position: absolute;
+      inset: 0;
+      z-index: 1;
+      pointer-events: none;
+      display: flex;
+      align-items: flex-end;
+      justify-content: center;
+      padding: 12px;
+      background: rgba(255, 171, 64, 0.3);
+      color: var(--primary);
+      font-size: 0.8rem;
+      font-weight: 600;
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), #000 var(--inner-size), transparent var(--outer-size));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), #000 var(--inner-size), transparent var(--outer-size));
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
     footer {
       background: var(--secondary);
