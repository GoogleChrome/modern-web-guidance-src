diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -119,8 +119,64 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    @property --inner-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      position: relative;
+      overflow: hidden;
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      /* Only the sizes transition; the pointer position must track instantly */
+      transition: --inner-size 0.3s ease-in-out, --outer-size 0.3s ease-in-out;
+    }
+
+    .product-card:hover {
+      --inner-size: 90px;
+      --outer-size: 130px;
+    }
+
+    .card-reveal {
+      position: absolute;
+      inset: 0;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      padding: 20px;
+      background: var(--accent);
+      color: var(--primary);
+      font-weight: 700;
+      pointer-events: none;
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), black var(--inner-size, 0px), transparent var(--outer-size, 0px));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), black var(--inner-size, 0px), transparent var(--outer-size, 0px));
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+    }
+
+    .card-reveal span {
+      font-size: 0.75rem;
+      text-transform: uppercase;
+      letter-spacing: 0.08em;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
