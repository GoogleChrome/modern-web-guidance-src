+    /* Decorative coffee-splash block. Absolutely positioned and non-interactive,
+       so it never affects hero layout. Fill is pure CSS (no external assets), and
+       border-radius gives an organic blob if the SVG clip-path fails to apply. */
+    .shaped-element {
+      position: absolute;
+      right: -4%;
+      bottom: -12%;
+      width: clamp(180px, 34vw, 460px);
+      aspect-ratio: 1;
+      z-index: 0;
+      pointer-events: none;
+      opacity: 0.55;
+      background:
+        radial-gradient(circle at 30% 30%, var(--accent), transparent 55%),
+        linear-gradient(135deg, #8d6e63, var(--primary));
+      border-radius: 63% 37% 54% 46% / 55% 48% 52% 45%;
+      clip-path: url(#coffee-splash);
+    }
+
+    .shape-defs {
+      position: absolute;
+      width: 0;
+      height: 0;
+    }
