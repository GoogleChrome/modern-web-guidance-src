+    /* App shell: a full-screen horizontal snap stack of views */
+    html,
+    body {
+      height: 100%;
+      overflow: hidden;
+      overscroll-behavior: none;
+    }
+
+    .Stack {
+      /* dvh tracks the dynamic viewport so the mobile address bar
+         showing/hiding never clips or leaks content */
+      height: 100dvh;
+      display: grid;
+      grid-auto-flow: column;
+      grid-auto-columns: 100%;
+      grid-template-rows: 100%;
+      overflow-x: auto;
+      overflow-y: hidden;
+      scroll-snap-type: x mandatory;
+      overscroll-behavior-x: none;
+      scrollbar-width: none;
+    }
+
+    .Stack::-webkit-scrollbar,
+    .Stack-viewContent::-webkit-scrollbar {
+      display: none;
+    }
+
+    /* `auto` scroll behavior in JS defers to this, so reduced motion
+       automatically gets instant transitions */
+    @media (prefers-reduced-motion: no-preference) {
+      .Stack {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .Stack-view {
+      min-width: 0;
+      scroll-snap-align: start;
+      scroll-snap-stop: always;
+    }
+
+    /* Visual transforms live on the inner element only; transforming the
