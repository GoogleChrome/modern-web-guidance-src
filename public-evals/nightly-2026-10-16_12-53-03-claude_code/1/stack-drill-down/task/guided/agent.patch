+  <script>
+    const ITEMS = {
+      1: {
+        title: 'Maple Oat Latte',
+        body: ['Creamy oat milk with a hint of Vermont maple syrup, poured over a double shot of our house espresso.',
+          'Available through the autumn season only.']
+      },
+      2: {
+        title: 'Dark Roast Espresso',
+        body: ['Bold, smokey, and perfect for a morning boost. Roasted in small batches and pulled fresh to order.',
+          'Notes of dark chocolate, toasted walnut, and a long caramel finish.']
+      },
+      3: {
+        title: 'Cold Brew',
+        body: ['Steeped for 18 hours for maximum smoothness, then served over ice with no bitterness.',
+          'Add a splash of oat milk or enjoy it black.']
+      }
+    };
 
+    const stack = document.querySelector('.Stack');
+    const rootTemplate = document.getElementById('root-template');
+
+    let rootView = null;
+    // Link to refocus when the user returns to a view
+    const returnFocus = new WeakMap();
+    // depth -> {urlPath, view}; history can't tell us about non-current entries
+    const entriesByDepth = new Map();
+    let currentDepth = 0;
+
+    // Routes are hash based: '#/' (or no hash) is root, '#/view/:id' drills in.
+    function resolveUrl(urlPath) {
+      const match = /^\/view\/(\d+)$/.exec(urlPath);
+      return match ? ITEMS[match[1]] ?? null : null;
+    }
+
+    function getCurrentUrlPath() {
+      return location.hash.slice(1) || '/';
+    }
+
+    function urlForPath(urlPath) {
+      return location.pathname + location.search + '#' + urlPath;
+    }
+
+    function createRootView() {
+      const view = document.createElement('div');
+      view.className = 'Stack-view';
+      const content = document.createElement('div');
+      content.className = 'Stack-viewContent';
+      content.append(rootTemplate.content.cloneNode(true));
+      view.append(content);
+      return view;
+    }
+
+    function createDrillDownView(item) {
+      const view = document.createElement('div');
+      view.className = 'Stack-view';
+      view.innerHTML = `
+        <div class="Stack-viewContent">
+          <header class="detail-header">
+            <button type="button" class="back">&lsaquo; Back</button>
+            <h2></h2>
+          </header>
+          <div class="detail-hero" style="background-image: linear-gradient(rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.35)), url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80')"></div>
+          <main class="detail-body"></main>
+        </div>
+      `;
+      view.querySelector('h2').textContent = item.title;
+      view.querySelector('main').append(...item.body.map((text) => {
+        const p = document.createElement('p');
+        p.textContent = text;
+        return p;
+      }));
+      return view;
+    }
+
+    function drillDown(urlPath) {
+      const routeData = resolveUrl(urlPath);
+      if (!routeData) return;
+
+      const newDepth = currentDepth + 1;
+      history.pushState({depth: newDepth}, '', urlForPath(urlPath));
+
+      // pushState drops forward entries; mirror that
+      for (const d of entriesByDepth.keys()) {
+        if (d >= newDepth) entriesByDepth.delete(d);
+      }
+      currentDepth = newDepth;
+
+      const newView = createDrillDownView(routeData);
+      stack.appendChild(newView);
+      entriesByDepth.set(newDepth, {urlPath, view: newView});
+
+      // 'auto' defers to CSS scroll-behavior (smooth unless reduced motion)
+      stack.scrollBy({left: stack.clientWidth, behavior: 'auto'});
+    }
+
+    stack.addEventListener('click', (e) => {
+      if (e.target.closest('.back')) {
+        goBack();
+        return;
+      }
+
+      const link = e.target.closest('a.item');
+      if (!link || !stack.contains(link)) return;
+      // Leave modified and non-primary clicks to the browser (new tab etc.)
+      if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
+
+      const url = new URL(link.href);
+      if (url.origin !== location.origin || url.pathname !== location.pathname) return;
+      const urlPath = url.hash.slice(1);
+      const parentView = link.closest('.Stack-view');
+      if (!resolveUrl(urlPath) || !parentView) return;
+
+      e.preventDefault();
+      returnFocus.set(parentView, link);
+      drillDown(urlPath);
+    });
+
+    function goBack() {
+      // A deep-linked first entry has nothing behind it in the app, so
+      // history.back() would leave; synthesize the root instead.
+      const atDeepLinkRoot = currentDepth === 0
+        && entriesByDepth.get(0)?.view !== rootView;
+      if (atDeepLinkRoot) {
+        synthesizeRootEntry();
+      } else {
+        history.back();
+      }
+    }
+
+    function synthesizeRootEntry() {
+      const newDepth = currentDepth + 1;
+      history.pushState({depth: newDepth}, '', urlForPath('/'));
+
+      if (!rootView) {
+        rootView = createRootView();
+        stack.prepend(rootView);
+        // Keep the user looking at the deep-linked view until we scroll
+        stack.scrollTo({left: stack.scrollLeft + stack.clientWidth, behavior: 'instant'});
+      }
+      entriesByDepth.set(newDepth, {urlPath: '/', view: rootView});
+
+      updateFromHistoryState(history.state);
+    }
+
+    window.addEventListener('popstate', (event) => {
+      updateFromHistoryState(event.state);
+    });
+
+    function updateFromHistoryState(state, behaviorOverride) {
+      const newDepth = state?.depth ?? 0;
+      const urlPath = getCurrentUrlPath();
+
+      const entry = entriesByDepth.get(newDepth) ?? {view: null};
+      if (entry.urlPath !== urlPath) {
+        entry.urlPath = urlPath;
+        entry.view = urlPath === '/' ? rootView : null;
+      }
+      entriesByDepth.set(newDepth, entry);
+
+      // Rebuild views pruned earlier by swiping back past them
+      for (let d = 0; d <= newDepth; d++) {
+        const e = entriesByDepth.get(d);
+        if (!e || e.view) continue;
+        const routeData = resolveUrl(e.urlPath);
+        if (!routeData) continue;
+        const rebuilt = createDrillDownView(routeData);
+        stack.appendChild(rebuilt);
+        e.view = rebuilt;
+      }
+
+      currentDepth = newDepth;
+
+      const targetView = entriesByDepth.get(newDepth)?.view;
+      if (!targetView) return;
+
+      const toIdx = [...stack.children].indexOf(targetView);
+      const fromIdx = Math.round(stack.scrollLeft / stack.clientWidth);
+      if (fromIdx === toIdx) return;
+
+      // Instant for forward and multi-step jumps (skips intermediate snaps,
+      // avoids animating spurious forward navs); 'auto' for single-step back
+      const forward = toIdx > fromIdx;
+      const multiStep = Math.abs(toIdx - fromIdx) > 1;
+      const behavior = behaviorOverride ?? (forward || multiStep ? 'instant' : 'auto');
+      stack.scrollTo({left: toIdx * stack.clientWidth, behavior});
+    }
+
+    function onActiveViewChanged(currentView) {
+      let seenCurrent = false;
+      for (const view of [...stack.children]) {
+        if (seenCurrent) {
+          // Swiped past: free the memory, keep the URL in entriesByDepth
+          for (const e of entriesByDepth.values()) {
+            if (e.view === view) e.view = null;
+          }
+          view.remove();
+        } else {
+          view.toggleAttribute('inert', view !== currentView);
+          if (view === currentView) seenCurrent = true;
+        }
+      }
+
+      // A swipe changed the view without history; reconcile it
+      let currentViewDepth;
+      for (const [d, e] of entriesByDepth) {
+        if (e.view === currentView) currentViewDepth = d;
+      }
+      if (currentViewDepth !== undefined && currentViewDepth !== currentDepth) {
+        history.go(currentViewDepth - currentDepth);
+      }
+
+      // preventScroll: focusing must not fight the snap container
+      const stored = returnFocus.get(currentView);
+      if (stored) {
+        stored.focus({preventScroll: true});
+        returnFocus.delete(currentView);
+      } else if (currentView !== rootView) {
+        currentView.querySelector('.back')?.focus({preventScroll: true});
+      }
+    }
+
+    stack.addEventListener('scrollsnapchange', (event) => {
+      onActiveViewChanged(event.snapTargetInline);
+    });
+
+    // Fallback for browsers without scroll snap events
+    if (!('onscrollsnapchange' in HTMLElement.prototype)) {
+      const viewObserver = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          if (entry.intersectionRatio === 1) onActiveViewChanged(entry.target);
+        }
+      }, {root: stack, threshold: 1});
+
+      new MutationObserver((mutations) => {
+        for (const m of mutations) {
+          for (const node of m.addedNodes) {
+            if (node.classList?.contains('Stack-view')) viewObserver.observe(node);
+          }
+          for (const node of m.removedNodes) {
+            if (node.classList?.contains('Stack-view')) viewObserver.unobserve(node);
+          }
+        }
+      }).observe(stack, {childList: true});
+    }
+
+    // Fallback parallax for browsers without scroll-driven animations
+    if (!CSS.supports('animation-timeline: view()')) {
+      stack.addEventListener('scroll', () => {
+        const viewWidth = stack.clientWidth;
+        for (const view of stack.children) {
+          const progress = Math.min(1, Math.max(0, (stack.scrollLeft - view.offsetLeft) / viewWidth));
+          const content = view.firstElementChild;
+          content.style.transform = `translateX(${progress * 75}%)`;
+          content.style.filter = `brightness(${1 - progress * 0.2})`;
+        }
+      });
+    }
+
+    // Init (supports deep links such as #/view/1)
+    const initialUrlPath = getCurrentUrlPath();
+    const initialRouteData = resolveUrl(initialUrlPath);
+    let initialView;
+    if (initialRouteData) {
+      initialView = createDrillDownView(initialRouteData);
+    } else {
+      rootView = createRootView();
+      initialView = rootView;
+    }
+    stack.appendChild(initialView);
+    entriesByDepth.set(0, {urlPath: initialRouteData ? initialUrlPath : '/', view: initialView});
+    history.replaceState({depth: 0}, '');
+    updateFromHistoryState(history.state, 'instant');
+    onActiveViewChanged(initialView);
+  </script>
+
