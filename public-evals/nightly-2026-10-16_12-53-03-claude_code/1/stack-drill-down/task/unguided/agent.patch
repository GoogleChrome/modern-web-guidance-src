+        }
+        var trail = [null, id];
+        history.replaceState({ trail: [null] }, '', homeUrl);
+        history.pushState({ trail: trail }, '', '#/view/' + id);
+        return trail;
+      }
+
+      addEventListener('popstate', function () {
+        sync(normalize(), true);
+      });
+
+      var initial = normalize();
+      current = [null];
+      sync(initial, false);
+    })();
+  </script>
