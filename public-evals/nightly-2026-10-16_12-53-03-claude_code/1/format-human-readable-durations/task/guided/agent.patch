+  <script type="module">
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const humanValue = document.getElementById('humanValue');
+    const locale = navigator.language;
+
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    function formatDuration(duration) {
+      if (typeof Intl.DurationFormat !== 'undefined' && duration.sign !== 0) {
+        return new Intl.DurationFormat(locale, { style: 'long' }).format(duration);
+      }
+      const unit = (value, unit) =>
+        new Intl.NumberFormat(locale, { style: 'unit', unit, unitDisplay: 'long' }).format(value);
+      const parts = [];
+      if (duration.hours) parts.push(unit(duration.hours, 'hour'));
+      if (duration.minutes || !parts.length) parts.push(unit(duration.minutes, 'minute'));
+      return new Intl.ListFormat(locale, { style: 'long', type: 'unit' }).format(parts);
+    }
+
+    function update() {
+      const hours = Math.max(0, Math.trunc(Number(hoursInput.value)) || 0);
+      const minutes = Math.max(0, Math.trunc(Number(minutesInput.value)) || 0);
+      const largestUnit = document.querySelector('input[name="largestUnit"]:checked').value;
+      const duration = Temporal.Duration.from({ hours, minutes }).round({ largestUnit });
+      humanValue.textContent = formatDuration(duration);
+    }
+
+    for (const el of document.querySelectorAll('#hoursInput, #minutesInput, input[name="largestUnit"]')) {
+      el.addEventListener('input', update);
+    }
+    update();
+  </script>
+
