@@ -134,8 +134,65 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Featured promo badge
+       Spin, slide and hover-scale each drive their own individual transform
+       property (rotate / translate / scale), so they compose instead of
+       overriding one another. Hovering never touches the animated properties. */
+    .seasonal {
+      position: relative;
+    }
+
+    .target {
+      position: absolute;
+      top: -10px;
+      left: 0;
+      z-index: 10;
+      isolation: isolate;
+      width: 90px;
+      height: 90px;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--primary);
+      border: 3px dashed var(--primary);
+      font-size: 0.75rem;
+      font-weight: bold;
+      text-align: center;
+      line-height: 1.2;
+      text-transform: uppercase;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
+      cursor: pointer;
+      scale: 1;
+      transition: scale 0.3s ease;
+      animation:
+        target-spin 6s linear infinite,
+        target-slide 4s ease-in-out infinite alternate;
+    }
+
+    .target:hover {
+      scale: 1.25;
+    }
+
+    @keyframes target-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes target-slide {
+      from { translate: 0 0; }
+      to { translate: 120px 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .target {
+        animation: none;
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
