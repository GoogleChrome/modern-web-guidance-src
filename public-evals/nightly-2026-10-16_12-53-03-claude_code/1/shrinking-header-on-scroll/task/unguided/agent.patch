diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,10 +11,32 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      /* Nav collapse progress: 0 = top of page, 1 = fully condensed.
+         Driven by scroll-driven animation, or by JS in older browsers. */
+      --p: 0;
     }
 
+    @property --p {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    @keyframes nav-collapse {
+      from { --p: 0; }
+      to { --p: 1; }
+    }
+
+    @supports (animation-timeline: scroll()) {
+      :root {
+        animation: nav-collapse linear both;
+        animation-timeline: scroll(root block);
+        animation-range: 0 120px;
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
@@ -30,9 +52,10 @@
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
-      padding: 1rem 5%;
+      padding: calc(1rem - 0.5rem * var(--p)) 5%;
+      box-shadow: 0 2px calc(10px * var(--p)) rgba(0, 0, 0, calc(0.3 * var(--p)));
       display: flex;
       justify-content: space-between;
       align-items: center;
       position: sticky;
@@ -40,9 +63,9 @@
       z-index: 1000;
     }
 
     .logo {
-      font-size: 1.5rem;
+      font-size: calc(1.5rem - 0.35rem * var(--p));
       font-weight: bold;
       letter-spacing: 1px;
     }
 
@@ -57,9 +80,9 @@
 
     nav a {
       color: white;
       text-decoration: none;
-      font-size: 0.9rem;
+      font-size: calc(0.9rem - 0.05rem * var(--p));
       transition: color 0.3s;
     }
 
     nav a:hover {
@@ -206,7 +229,26 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers without scroll-driven animations: mirror the
+    // same 0-120px scroll range into the --p custom property.
+    if (!(window.CSS && CSS.supports && CSS.supports('animation-timeline', 'scroll()'))) {
+      var root = document.documentElement, ticking = false, RANGE = 120;
+      var update = function () {
+        var y = window.pageYOffset || root.scrollTop || 0;
+        root.style.setProperty('--p', Math.min(Math.max(y / RANGE, 0), 1).toFixed(3));
+        ticking = false;
+      };
+      var onScroll = function () {
+        if (ticking) return;
+        ticking = true;
+        (window.requestAnimationFrame || function (f) { setTimeout(f, 16); })(update);
+      };
+      window.addEventListener('scroll', onScroll, { passive: true });
+      update();
+    }
+  </script>
 </body>
 
 </html>
