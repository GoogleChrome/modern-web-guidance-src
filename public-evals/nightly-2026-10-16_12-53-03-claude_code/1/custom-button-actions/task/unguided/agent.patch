+  <script>
+    // Custom invoker commands (must start with "--") fire a "command" event on the target.
+    const actionTarget = document.getElementById('action-target');
+    const toggles = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded'
+    };
+
+    actionTarget.addEventListener('command', (event) => {
+      if (event.command in toggles) {
+        actionTarget.classList.toggle(toggles[event.command]);
+      } else if (event.command === '--reset') {
+        actionTarget.classList.remove(...Object.values(toggles));
+      }
+    });
+  </script>
