+  <script>
+    (() => {
+      const $ = (id) => document.getElementById(id);
+      const LANG = { expectedInputs: [{ type: 'text', languages: ['en'] }], expectedOutputs: [{ type: 'text', languages: ['en'] }] };
+      const MAX_BRANCHES = 3;
+
+      const BARISTA_PROMPT = 'You are a friendly barista at The Daily Grind. You only answer questions about two menu items: ' +
+        'the Maple Oat Latte (creamy oat milk with a hint of Vermont maple syrup) and the Cold Brew (steeped for 18 hours for maximum smoothness). ' +
+        'If asked about anything else, politely say you can only help with those two drinks. Never invent prices or allergen guarantees; suggest asking staff when unsure.';
+
+      // Check availability and create a session, reporting download progress.
+      async function createSession({ signal, progressEl, statusEl, initialPrompts }) {
+        if (!('LanguageModel' in self)) {
+          throw new Error('The built-in AI (Prompt API) is not supported in this browser.');
+        }
+        const availability = await LanguageModel.availability(LANG);
+        if (availability === 'unavailable') {
+          throw new Error('The on-device model is unavailable on this device.');
+        }
+        if (availability !== 'available') statusEl.textContent = 'Downloading on-device model…';
+        try {
+          return await LanguageModel.create({
+            ...LANG,
+            signal,
+            initialPrompts,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                progressEl.hidden = false;
+                progressEl.value = e.loaded;
+                statusEl.textContent = `Downloading on-device model… ${Math.round(e.loaded * 100)}%`;
+              });
+            }
+          });
+        } finally {
+          progressEl.hidden = true;
+        }
+      }
+
+      const usageText = (s) => `${s.inputUsage} / ${s.inputQuota} tokens used`;
+
+      // ---- Ask the Barista (streaming, reused session) ----
+      let baristaSession = null;
+      let baristaAbort = null;
+
+      $('ask-the-barista').addEventListener('click', async () => {
+        const btn = $('ask-the-barista');
+        const status = $('barista-status');
+        const answer = $('barista-answer');
+        const question = $('barista-question').value.trim();
+        if (!question) { status.textContent = 'Please type a question first.'; return; }
+
+        baristaAbort?.abort();
+        const controller = baristaAbort = new AbortController();
+        btn.disabled = true;
+        answer.textContent = '';
+        status.textContent = 'Checking model availability…';
+        try {
+          baristaSession ??= await createSession({
+            signal: controller.signal,
+            progressEl: $('barista-progress'),
+            statusEl: status,
+            initialPrompts: [{ role: 'system', content: BARISTA_PROMPT }]
+          });
+          status.textContent = 'Thinking…';
+          const stream = baristaSession.promptStreaming(question, { signal: controller.signal });
+          for await (const chunk of stream) {
+            answer.textContent += chunk;
+          }
+          status.textContent = usageText(baristaSession);
+        } catch (err) {
+          if (err.name === 'AbortError') return;
+          status.textContent = `Error: ${err.message}`;
+        } finally {
+          if (baristaAbort === controller) btn.disabled = false;
+        }
+      });
+
+      // ---- Sentiment analyzer (structured output) ----
+      const SENTIMENT_SCHEMA = {
+        type: 'object',
+        properties: {
+          score: { type: 'number', minimum: -1, maximum: 1 },
+          category: { type: 'string', enum: ['positive', 'neutral', 'negative'] }
+        },
+        required: ['score', 'category'],
+        additionalProperties: false
+      };
+
+      $('sentiment-btn').addEventListener('click', async () => {
+        const btn = $('sentiment-btn');
+        const status = $('sentiment-status');
+        const out = $('sentiment-result');
+        const text = $('feedback-text').value.trim();
+        if (!text) { status.textContent = 'Please enter some feedback first.'; return; }
+
+        btn.disabled = true;
+        out.textContent = '';
+        status.textContent = 'Checking model availability…';
+        let session;
+        try {
+          // Each analysis is independent, so use a short-lived session and destroy it afterwards.
+          session = await createSession({
+            progressEl: $('sentiment-progress'),
+            statusEl: status,
+            initialPrompts: [{ role: 'system', content: 'Classify the sentiment of customer feedback for a coffee shop. Score ranges from -1 (very negative) to 1 (very positive).' }]
+          });
+          status.textContent = 'Analyzing…';
+          const raw = await session.prompt(text, { responseConstraint: SENTIMENT_SCHEMA });
+          out.textContent = JSON.stringify(JSON.parse(raw), null, 2);
+          status.textContent = 'Done.';
+        } catch (err) {
+          status.textContent = `Error: ${err.message}`;
+        } finally {
+          session?.destroy();
+          btn.disabled = false;
+        }
+      });
+
+      // ---- Conversation branching (clone + context tracking + cleanup) ----
+      const branches = []; // { id, session }; last entry is the active session
+      let branchCounter = 0;
+
+      function renderBranches() {
+        const list = $('branch-list');
+        list.replaceChildren(...branches.map((b, i) => {
+          const li = document.createElement('li');
+          li.textContent = `Branch ${b.id}${i === branches.length - 1 ? ' (active)' : ''}: ${usageText(b.session)}`;
+          return li;
+        }));
+      }
+
+      function trimBranches() {
+        while (branches.length > MAX_BRANCHES) branches.shift().session.destroy();
+      }
+
+      function track(branch) {
+        // Fires when older context is evicted to make room for new input.
+        branch.session.addEventListener('quotaoverflow', () => {
+          $('clone-status').textContent = `Branch ${branch.id} exceeded its context window; oldest messages were dropped.`;
+          renderBranches();
+        });
+      }
+
+      $('clone-btn').addEventListener('click', async () => {
+        const btn = $('clone-btn');
+        const status = $('clone-status');
+        btn.disabled = true;
+        status.textContent = 'Checking model availability…';
+        try {
+          if (!branches.length) {
+            const root = { id: ++branchCounter, session: await createSession({
+              progressEl: $('barista-progress'),
+              statusEl: status,
+              initialPrompts: [{ role: 'system', content: BARISTA_PROMPT }]
+            }) };
+            track(root);
+            branches.push(root);
+          }
+          const active = branches[branches.length - 1];
+          const clone = { id: ++branchCounter, session: await active.session.clone() };
+          track(clone);
+          branches.push(clone);
+          trimBranches();
+          status.textContent = `Cloned into branch ${clone.id}. Keeping the latest ${MAX_BRANCHES} branches.`;
+          renderBranches();
+        } catch (err) {
+          status.textContent = `Error: ${err.message}`;
+        } finally {
+          btn.disabled = false;
+        }
+      });
+
+      // Release on-device model resources when the page is going away.
+      addEventListener('pagehide', () => {
+        baristaAbort?.abort();
+        baristaSession?.destroy();
+        branches.splice(0).forEach((b) => b.session.destroy());
+      });
+    })();
+  </script>
+
