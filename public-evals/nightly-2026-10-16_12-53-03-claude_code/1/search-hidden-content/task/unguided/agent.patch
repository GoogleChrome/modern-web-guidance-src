+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .sidebar h3 {
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    /* Reveal coupon button (plain <button> so it is fully themeable) */
+    .reveal-coupon-btn {
+      appearance: none;
+      border: 2px solid var(--accent);
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      font-weight: 600;
+      padding: 10px 20px;
+      border-radius: 5px;
+      cursor: pointer;
+      transition: background 0.3s, color 0.3s;
+    }
+
+    .reveal-coupon-btn:hover:not(:disabled),
+    .reveal-coupon-btn:focus-visible {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .reveal-coupon-btn:disabled {
+      opacity: 0.6;
+      cursor: default;
+    }
+
+    /* Note: no `display` set here, it would override hidden="until-found" */
+    #coupon-panel {
+      margin-bottom: 30px;
+      padding: 20px;
+      border: 2px dashed var(--accent);
+      border-radius: 8px;
+      background: white;
+      text-align: center;
+    }
+
+    .coupon-code {
+      font-size: 1.8rem;
+      font-weight: bold;
+      letter-spacing: 3px;
+      color: var(--primary);
+    }
+
+    /* Wholesale / catering tabs: exclusive <details> group */
+    .wholesale-tabs {
+      margin-top: 40px;
+    }
+
+    .wholesale-tab {
+      border: 1px solid var(--secondary);
+      background: white;
+    }
+
+    .wholesale-tab + .wholesale-tab {
+      border-top: 0;
+    }
+
+    .wholesale-tab summary {
+      cursor: pointer;
+      padding: 12px 20px;
+      font-weight: 600;
+      color: var(--primary);
+      background: var(--secondary);
+    }
+
+    .wholesale-tab[open] summary {
+      background: var(--primary);
+      color: white;
+    }
+
+    .wholesale-tab .tab-body {
+      padding: 20px;
+    }
+
