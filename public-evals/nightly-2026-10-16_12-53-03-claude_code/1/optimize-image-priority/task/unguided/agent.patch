diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,57 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Product</title>
+<link rel="preload" as="image" href="hero-lcp.jpg" fetchpriority="high">
+<style>
+  body { margin: 0; font-family: system-ui, sans-serif; }
+  nav { padding: 1rem; }
+  #mega-menu { display: none; }
+  #mega-menu.open { display: block; }
+  .hero { display: block; width: 100%; height: auto; }
+  #gallery-alt { display: none; }
+  #gallery-alt.open { display: block; }
+  .gallery img { max-width: 100%; height: auto; }
+  .spacer { height: 200vh; }
+  footer { padding: 2rem; }
+</style>
+</head>
+<body>
+<nav>
+  <button id="menu-toggle" aria-expanded="false" aria-controls="mega-menu">Menu</button>
+  <div id="mega-menu">
+    <img src="mega-menu-promo.jpg" alt="Promo" width="400" height="200" loading="lazy">
+  </div>
+</nav>
+
+<main>
+  <img class="hero" src="hero-lcp.jpg" alt="Product hero" width="1600" height="900" fetchpriority="high" decoding="async">
+  <h1>Product</h1>
+
+  <section class="gallery">
+    <img src="hero-lcp.jpg" alt="Product view 1" width="800" height="600">
+    <img id="gallery-alt" src="gallery-alt.jpg" alt="Product view 2" width="800" height="600" loading="lazy">
+    <button id="gallery-toggle" aria-expanded="false" aria-controls="gallery-alt">Next image</button>
+  </section>
+</main>
+
+<div class="spacer"></div>
+
+<footer>
+  <img src="footer-logo.png" alt="Logo" width="120" height="40" loading="lazy">
+</footer>
+
+<script>
+  function bind(btn, el) {
+    btn.addEventListener('click', function () {
+      var open = el.classList.toggle('open');
+      btn.setAttribute('aria-expanded', open);
+    });
+  }
+  bind(document.getElementById('menu-toggle'), document.getElementById('mega-menu'));
+  bind(document.getElementById('gallery-toggle'), document.getElementById('gallery-alt'));
+</script>
+</body>
+</html>
