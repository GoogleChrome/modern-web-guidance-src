+  <script>
+    // Summarizes the journal using the browser's built-in Summarizer API (on-device).
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const summaryEl = document.getElementById('journal-summary');
+    const journalText = document.getElementById('journal-text');
+
+    function showMessage(msg) {
+      summaryEl.hidden = false;
+      summaryEl.textContent = msg;
+    }
+
+    function showBullets(markdown) {
+      const items = markdown.split('\n')
+        .map(line => line.replace(/^\s*[-*•]\s+/, '').trim())
+        .filter(Boolean);
+      const ul = document.createElement('ul');
+      for (const item of items) {
+        const li = document.createElement('li');
+        li.textContent = item;
+        ul.appendChild(li);
+      }
+      summaryEl.replaceChildren(ul);
+      summaryEl.hidden = false;
+    }
+
+    if (!('Summarizer' in self)) {
+      summarizeBtn.disabled = true;
+      summarizeBtn.title = "Your browser doesn't support built-in AI summarization.";
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      summarizeBtn.disabled = true;
+      let summarizer;
+      try {
+        const availability = await Summarizer.availability();
+        if (availability === 'unavailable') {
+          showMessage('Built-in AI summarization is not available on this device.');
+          return;
+        }
+        showMessage(availability === 'available' ? 'Summarizing…' : 'Downloading the on-device AI model…');
+        summarizer = await Summarizer.create({
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          monitor(m) {
+            m.addEventListener('downloadprogress', e => {
+              showMessage(`Downloading the on-device AI model… ${Math.round(e.loaded * 100)}%`);
+            });
+          },
+        });
+        showMessage('Summarizing…');
+        showBullets(await summarizer.summarize(journalText.innerText));
+      } catch (err) {
+        console.error(err);
+        showMessage('Sorry, we couldn’t summarize the journal right now.');
+      } finally {
+        summarizer?.destroy();
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
+
