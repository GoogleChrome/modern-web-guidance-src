+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const statusEl = document.getElementById('summarize-status');
+    const summaryList = document.getElementById('summary-list');
+
+    const summarizerOptions = {
+      sharedContext: 'A coffee roaster describing how it sources green coffee beans.',
+      type: 'key-points',
+      format: 'markdown',
+      length: 'medium',
+      expectedInputLanguages: ['en'],
+      expectedContextLanguages: ['en'],
+      outputLanguage: 'en',
+    };
+
+    function renderBullets(markdown) {
+      summaryList.replaceChildren();
+      for (const line of markdown.split('\n')) {
+        const match = line.match(/^\s*[-*•]\s+(.*\S)/);
+        if (!match) continue;
+        const li = document.createElement('li');
+        li.textContent = match[1].replace(/\*\*|__/g, '');
+        summaryList.append(li);
+      }
+    }
+
+    if (!('Summarizer' in self)) {
+      summarizeBtn.disabled = true;
+      statusEl.textContent = 'Local summarization is currently unsupported in this browser.';
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      summarizeBtn.disabled = true;
+      summaryList.replaceChildren();
+      try {
+        const availability = await Summarizer.availability(summarizerOptions);
+        if (availability === 'unavailable') {
+          statusEl.textContent = 'Local summarization is unavailable on this device.';
+          return;
+        }
+        statusEl.textContent = availability === 'available' ? 'Summarizing…' : 'Downloading AI model…';
+        const summarizer = await Summarizer.create({
+          ...summarizerOptions,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              statusEl.textContent = `Downloading AI model… ${Math.round(e.loaded * 100)}%`;
+            });
+          },
+        });
+        statusEl.textContent = 'Summarizing…';
+        const text = document.getElementById('journal-text').innerText;
+        renderBullets(await summarizer.summarize(text));
+        summarizer.destroy();
+        statusEl.textContent = '';
+      } catch (err) {
+        console.error(err);
+        statusEl.textContent = 'Sorry, we couldn\'t summarize the text.';
+      } finally {
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
