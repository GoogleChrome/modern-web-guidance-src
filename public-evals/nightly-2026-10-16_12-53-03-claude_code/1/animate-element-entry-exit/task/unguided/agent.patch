+    .promo-controls button:hover {
+      background: #3e2723;
+    }
+
+    #domContainer {
+      display: flex;
+      flex-direction: column;
+      margin-top: 20px;
+    }
+
+    #domContainer .card {
+      max-height: 300px;
+      margin-bottom: 20px;
+      overflow: hidden;
+      opacity: 1;
+      transform: scale(1);
+      transition: opacity 0.3s ease, transform 0.3s ease, max-height 0.3s ease,
+        padding 0.3s ease, margin 0.3s ease, visibility 0.3s;
+    }
+
+    /* Applied on add (before first frame) and on removal */
+    #domContainer .card.is-entering,
+    #domContainer .card.is-leaving,
+    #domContainer .card[hidden] {
+      opacity: 0;
+      transform: scale(0.85);
+      max-height: 0;
+      padding-top: 0;
+      padding-bottom: 0;
+      margin-bottom: 0;
+      pointer-events: none;
+    }
+
+    /* Keep the hidden attribute animatable instead of snapping to display:none */
+    #domContainer .card[hidden] {
+      display: block;
+      visibility: hidden;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #domContainer .card {
+        transition-duration: 0.01s;
+      }
+    }
+
