@@ -114,8 +114,47 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Layout density toggle: only shown where container style queries work */
+    :root {
+      --style-queries-supported: check;
+    }
+
+    .density-toggle {
+      display: none;
+    }
+
+    @container style(--style-queries-supported) {
+      .density-toggle {
+        display: block;
+        margin: 15px auto 0;
+        padding: 8px 16px;
+        border: 1px solid var(--primary);
+        border-radius: 5px;
+        background: white;
+        color: var(--primary);
+        font: inherit;
+        cursor: pointer;
+      }
+
+      .density-toggle[aria-pressed="true"] {
+        background: var(--primary);
+        color: white;
+      }
+    }
+
+    #target-container {
+      --density: comfortable;
+    }
+
+    /* The card reacts to its ancestor's custom property; no JS styles it directly */
+    @container style(--density: spacious) {
+      #target-item {
+        padding: 40px;
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
