+    /* Layout density toggle: hidden unless the browser supports style queries */
+    :root {
+      --style-queries-supported: yes;
+    }
+
+    #toggle-spacious {
+      display: none;
+      margin: 10px auto 0;
+      background: var(--primary);
+      color: white;
+      border: none;
+      border-radius: 5px;
+      padding: 8px 16px;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+    }
+
+    @container style(--style-queries-supported: yes) {
+      #toggle-spacious {
+        display: block;
+      }
+    }
+
+    /* The container holds the density; JS only sets --density on it */
+    #target-container {
+      --density: compact;
+    }
+
+    #target-item {
+      transition: padding 0.3s;
+    }
+
+    @container style(--density: spacious) {
+      #target-item {
+        padding: 48px 36px;
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
