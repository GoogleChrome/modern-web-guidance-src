+  <script>
+    // Fallback for browsers without sibling-index()/sibling-count(): sets the same values per item.
+    if (!CSS.supports('order', 'sibling-index()')) {
+      document.querySelectorAll('.grid, .fan-container, .circle-container').forEach(group => {
+        [...group.children].forEach((el, i) => {
+          el.style.setProperty('--i', i + 1);
+          el.style.setProperty('--n', group.children.length);
+        });
+      });
+    }
