+    }
+
+    /* Sentinels for the IntersectionObserver fallback */
+    .sentinel-top,
+    .sentinel-bottom {
+      height: 0;
+      width: 0;
+      visibility: hidden;
+    }
+
+    /* Top: only when scrolled down. Bottom: only when more content below. */
+    @container scroll-state(scrollable: top) {
