diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,36 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Scroll-driven reveal: scale from 50% to 100% entering the viewport and back on exit.
+       Progressive enhancement: only for browsers with scroll timelines and users who
+       haven't requested reduced motion. Content stays visible and in layout either way. */
+    @keyframes card-reveal {
+      0% {
+        transform: scale(0.5);
+      }
+
+      40%,
+      60% {
+        transform: scale(1);
+      }
+
+      100% {
+        transform: scale(0.5);
+      }
+    }
+
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .card {
+          animation: card-reveal linear both;
+          animation-timeline: view();
+          animation-range: cover 0% cover 100%;
+        }
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
