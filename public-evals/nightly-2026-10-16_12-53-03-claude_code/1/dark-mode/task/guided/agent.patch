+  <script>
+    const themeSelect = document.getElementById('theme-select');
+    const schemeMeta = document.querySelector('meta[name="color-scheme"]');
+
+    function storedTheme() {
+      try {
+        return localStorage.getItem('color-scheme');
+      } catch (e) {
+        return null;
+      }
+    }
+
+    // Reflect a theme ("system", "light" or "dark") on the root via the meta, which the CSS maps to color-scheme
+    function applyTheme(theme) {
+      schemeMeta.content = theme === 'light' || theme === 'dark' ? theme : 'light dark';
+      themeSelect.value = schemeMeta.content === 'light dark' ? 'system' : schemeMeta.content;
+    }
+
+    themeSelect.addEventListener('change', () => {
+      const theme = themeSelect.value;
+      try {
+        if (theme === 'system') localStorage.removeItem('color-scheme');
+        else localStorage.setItem('color-scheme', theme);
+      } catch (e) { }
+      applyTheme(theme);
+    });
+
+    // Keep other tabs in sync
+    window.addEventListener('storage', (e) => {
+      if (e.key === 'color-scheme' || e.key === null) applyTheme(storedTheme());
+    });
+
+    applyTheme(storedTheme());
+
+    // Late night specials
+    const specialSelect = document.getElementById('special-select');
+    const specialDetails = document.querySelectorAll('.special-detail');
+    specialSelect.addEventListener('change', () => {
+      specialDetails.forEach((d) => { d.hidden = d.dataset.special !== specialSelect.value; });
+      document.getElementById('special-details').scrollTop = 0;
+    });
+  </script>
+
