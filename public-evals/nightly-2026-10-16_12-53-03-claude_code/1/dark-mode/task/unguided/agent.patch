+  <script>
+    // Theme selector: "system" removes the override so the browser follows OS preference.
+    (function () {
+      var root = document.documentElement;
+      var select = document.getElementById('theme-select');
+      var saved = 'system';
+      try { saved = localStorage.getItem('theme') || 'system'; } catch (e) {}
+      if (saved !== 'light' && saved !== 'dark') saved = 'system';
+      select.value = saved;
+
+      select.addEventListener('change', function () {
+        var value = select.value;
+        if (value === 'light' || value === 'dark') {
+          root.dataset.theme = value;
+        } else {
+          delete root.dataset.theme;
+        }
+        try {
+          if (value === 'system') localStorage.removeItem('theme');
+          else localStorage.setItem('theme', value);
+        } catch (e) {}
+      });
+    })();
+
+    // Late night specials filter
+    (function () {
+      var filter = document.getElementById('special-filter');
+      var items = document.querySelectorAll('.special');
+      filter.addEventListener('change', function () {
+        items.forEach(function (el) {
+          el.hidden = filter.value !== 'all' && el.dataset.type !== filter.value;
+        });
+      });
+    })();
+  </script>
+
