+  <script>
+    (() => {
+      const PRIORITY = { urgent: 0, standard: 1, background: 2 };
+      const SPECS = {
+        urgent: { label: 'Checkout', units: 400 },
+        standard: { label: 'Menu update', units: 900 },
+        background: { label: 'Telemetry log', units: 1500 }
+      };
+      const SLICE_MS = 50; // longer than this counts as a long task
+      const list = document.getElementById('ops-list');
+      const log = document.getElementById('ops-log');
+      const summary = document.getElementById('ops-summary');
+
+      const queue = [];
+      let running = false;
+      let nextId = 1;
+      let completed = 0;
+
+      const yieldToMain = () =>
+        'scheduler' in window && 'yield' in window.scheduler
+          ? scheduler.yield()
+          : new Promise(resolve => setTimeout(resolve, 0));
+
+      function addLog(text) {
+        const line = document.createElement('div');
+        line.textContent = `${new Date().toLocaleTimeString()}  ${text}`;
+        log.prepend(line);
+        while (log.children.length > 50) log.lastChild.remove();
+      }
+
+      function updateSummary() {
+        summary.textContent = queue.length
+          ? `${queue.length} queued, ${completed} done`
+          : `Idle, ${completed} done`;
+      }
+
+      function enqueue(priority) {
+        const spec = SPECS[priority];
+        const task = { id: nextId++, priority, name: spec.label, units: spec.units, done: 0 };
+
+        const li = document.createElement('li');
+        const badge = document.createElement('span');
+        badge.className = 'ops-badge';
+        badge.dataset.priority = priority;
+        badge.textContent = priority;
+        task.bar = document.createElement('progress');
+        task.bar.max = task.units;
+        task.bar.value = 0;
+        task.bar.setAttribute('aria-label', `${task.name} #${task.id} progress`);
+        task.state = document.createElement('span');
+        task.state.className = 'ops-state';
+        task.state.textContent = 'Queued';
+        li.append(badge, task.bar, task.state);
+        list.prepend(li);
+
+        queue.push(task);
+        addLog(`#${task.id} ${task.name} queued (${priority})`);
+        updateSummary();
+        run();
+        return task;
+      }
+
+      // Highest priority first; FIFO within a priority
+      function takeNext() {
+        let best = 0;
+        for (let i = 1; i < queue.length; i++) {
+          if (PRIORITY[queue[i].priority] < PRIORITY[queue[best].priority]) best = i;
+        }
+        return queue[best];
+      }
+
+      function burn() {
+        // Simulated CPU-heavy unit of work
+        let x = 0;
+        for (let i = 0; i < 20000; i++) x += Math.sqrt(i);
+        return x;
+      }
+
+      async function run() {
+        if (running) return;
+        running = true;
+        while (queue.length) {
+          // Re-picked after every slice, so urgent work preempts lower priorities
+          const task = takeNext();
+          if (task.done === 0) {
+            task.state.textContent = 'Running';
+            addLog(`#${task.id} ${task.name} started`);
+          }
+          const deadline = performance.now() + SLICE_MS;
+          while (task.done < task.units && performance.now() < deadline) {
+            burn();
+            task.done++;
+          }
+          task.bar.value = task.done;
+          if (task.done >= task.units) {
+            queue.splice(queue.indexOf(task), 1);
+            task.state.textContent = 'Done';
+            completed++;
+            addLog(`#${task.id} ${task.name} finished`);
+          }
+          updateSummary();
+          await yieldToMain();
+        }
+        running = false;
+      }
+
+      document.querySelector('.ops-controls').addEventListener('click', event => {
+        const op = event.target.closest('button')?.dataset.op;
+        if (!op) return;
+        if (op === 'batch') {
+          // Submitted in mixed order; the queue executes them by priority
+          ['background', 'standard', 'urgent', 'background', 'urgent', 'standard'].forEach(enqueue);
+        } else {
+          enqueue(op);
+        }
+      });
+    })();
+  </script>
