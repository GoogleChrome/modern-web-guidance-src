+  <script>
+    (function () {
+      // Lower number = higher priority.
+      var TYPES = {
+        checkout:  { label: 'Urgent checkout',   priority: 0, work: 120 },
+        menu:      { label: 'Standard menu update', priority: 1, work: 400 },
+        telemetry: { label: 'Background telemetry', priority: 2, work: 900 }
+      };
+      var SLICE_MS = 8;      // max time a task may hold the main thread
+      var seq = 0;
+      var queue = [];
+      var running = false;
+      var current = null;
+      var maxStall = 0;
+      var lastFrame = performance.now();
+
+      var queueEl = document.getElementById('ops-queue');
+      var doneEl = document.getElementById('ops-done');
+      var statusEl = document.getElementById('ops-status');
+      var stallEl = document.getElementById('ops-stall');
+
+      // Measure how long the main thread was blocked between frames.
+      (function watch(now) {
+        var gap = now - lastFrame;
+        lastFrame = now;
+        if (running && gap > maxStall) {
+          maxStall = gap;
+          stallEl.textContent = Math.round(gap) + ' ms';
+        }
+        requestAnimationFrame(watch);
+      })(lastFrame);
+
+      function enqueue(type) {
+        var t = TYPES[type];
+        queue.push({
+          id: ++seq, label: t.label, priority: t.priority,
+          total: t.work, done: 0, acc: 0, cpu: 0
+        });
+        render();
+        if (!running) {
+          running = true;
+          schedule();
+        }
+      }
+
+      // Pick highest priority; FIFO within the same priority.
+      function pickNext() {
+        var best = -1;
+        for (var i = 0; i < queue.length; i++) {
+          if (best < 0 || queue[i].priority < queue[best].priority) best = i;
+        }
+        return best < 0 ? null : queue.splice(best, 1)[0];
+      }
+
+      function schedule() {
+        setTimeout(tick, 0);
+      }
+
+      // One slice of work. Priority is re-evaluated every slice, so an urgent
+      // task arriving mid-run preempts a long background task.
+      function tick() {
+        var top = null;
+        for (var i = 0; i < queue.length; i++) {
+          if (!top || queue[i].priority < top.priority) top = queue[i];
+        }
+        if (current && top && top.priority < current.priority) {
+          queue.push(current);
+          current = null;
+        }
+        if (!current) {
+          current = pickNext();
+          if (!current) {
+            running = false;
+            render();
+            return;
+          }
+        }
+
+        var start = performance.now();
+        while (current.done < current.total && performance.now() - start < SLICE_MS) {
+          burn();
+          current.done++;
+        }
+        current.cpu += performance.now() - start;
+
+        if (current.done >= current.total) {
+          finish(current);
+          current = null;
+        }
+        render();
+        schedule(); // yield to the browser (input, paint) between slices
+      }
+
+      // Simulated CPU-bound work unit.
+      function burn() {
+        var x = 0;
+        for (var i = 0; i < 20000; i++) x += Math.sqrt(i);
+        return x;
+      }
+
+      function finish(task) {
+        var li = document.createElement('li');
+        li.className = 'p-' + task.priority;
+        li.innerHTML = '<strong></strong><span class="meta"></span>';
+        li.firstChild.textContent = '#' + task.id + ' ' + task.label;
+        li.lastChild.textContent = 'completed, ' + Math.round(task.cpu) + ' ms CPU';
+        doneEl.appendChild(li);
+        doneEl.scrollTop = doneEl.scrollHeight;
+      }
+
+      function item(task, active) {
+        var li = document.createElement('li');
+        li.className = 'p-' + task.priority;
+        var name = document.createElement('strong');
+        name.textContent = '#' + task.id + ' ' + task.label;
+        li.appendChild(name);
+        if (active) {
+          var bar = document.createElement('div');
+          bar.className = 'ops-bar';
+          var fill = document.createElement('div');
+          fill.style.width = (100 * task.done / task.total) + '%';
+          bar.appendChild(fill);
+          li.appendChild(bar);
+        }
+        return li;
+      }
+
+      function render() {
+        queueEl.textContent = '';
+        if (current) queueEl.appendChild(item(current, true));
+        queue.slice().sort(function (a, b) {
+          return a.priority - b.priority || a.id - b.id;
+        }).forEach(function (t) { queueEl.appendChild(item(t, false)); });
+        if (!queueEl.children.length) {
+          var empty = document.createElement('li');
+          empty.className = 'ops-empty';
+          empty.textContent = 'Queue is empty';
+          queueEl.appendChild(empty);
+        }
+        statusEl.textContent = current
+          ? 'Running: ' + current.label + ' (' + queue.length + ' waiting)'
+          : (queue.length ? 'Starting...' : 'Idle');
+      }
+
+      document.querySelector('.ops-controls').addEventListener('click', function (e) {
+        var type = e.target.getAttribute && e.target.getAttribute('data-task');
+        if (!type) return;
+        if (type === 'clear') {
+          doneEl.textContent = '';
+          maxStall = 0;
+          stallEl.textContent = '0 ms';
+        } else if (type === 'batch') {
+          // Deliberately enqueued in "wrong" order; the scheduler sorts it out.
+          ['telemetry', 'menu', 'telemetry', 'checkout', 'menu', 'checkout']
+            .forEach(enqueue);
+        } else {
+          enqueue(type);
+        }
+      });
+
+      render();
+    })();
+  </script>
+
 </body>
 
