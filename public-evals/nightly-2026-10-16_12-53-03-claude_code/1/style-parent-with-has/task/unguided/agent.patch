+    /* Contact Form */
+    .contact-form {
+      max-width: 600px;
+      margin: 40px auto 0;
+      padding: 0 20px;
+    }
+
+    .contact-form h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .field {
+      background: white;
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      padding: 10px 14px;
+      margin-bottom: 16px;
+    }
+
+    .field label {
+      display: block;
+      font-size: 0.85rem;
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .field input,
+    .field textarea {
+      width: 100%;
+      border: none;
+      outline: none;
+      font: inherit;
+      color: var(--text);
+      background: transparent;
+    }
+
+    .field textarea {
+      min-height: 120px;
+      resize: vertical;
+    }
+
+    .field:focus-within {
+      border-color: var(--accent);
+    }
+
+    /* :user-invalid only matches after the user has interacted with the input */
+    .field:has(:user-invalid) {
+      border-color: #d32f2f;
+    }
+
+    .contact-form button {
+      border: none;
+      cursor: pointer;
+      font: inherit;
+    }
+
     .footer-links {
       margin-bottom: 20px;
     }
 
