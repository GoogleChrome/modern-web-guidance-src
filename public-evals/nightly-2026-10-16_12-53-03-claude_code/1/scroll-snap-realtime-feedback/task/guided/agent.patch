+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.thumbnail')];
+
+    const setPending = (index) => {
+      thumbnails.forEach((thumb) => thumb.classList.remove('pending'));
+      thumbnails[index]?.classList.add('pending');
+    };
+
+    const setActive = (index) => {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumb) => {
+        thumb.classList.remove('pending', 'active');
+        thumb.removeAttribute('aria-current');
+      });
+      thumbnails[index].classList.add('active');
+      thumbnails[index].setAttribute('aria-current', 'true');
+    };
+
+    // Closest item to the scrollport center (items snap to center).
+    const findClosestItemIndex = () => {
+      const center = gallery.scrollLeft + gallery.clientWidth / 2;
+      let closest = 0;
+      let min = Infinity;
+      items.forEach((item, i) => {
+        const distance = Math.abs(center - (item.offsetLeft + item.offsetWidth / 2));
+        if (distance < min) {
+          min = distance;
+          closest = i;
+        }
+      });
+      return closest;
+    };
+
+    thumbnails.forEach((thumb, i) => {
+      thumb.addEventListener('click', () => {
+        items[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
+      });
+    });
+
+    if ('onscrollsnapchanging' in Element.prototype) {
+      gallery.addEventListener('scrollsnapchanging', (e) => {
+        setPending(items.indexOf(e.snapTargetInline));
+      });
+      gallery.addEventListener('scrollsnapchange', (e) => {
+        setActive(items.indexOf(e.snapTargetInline));
+      });
+    } else {
+      let rafId = null;
+      let settleTimeout;
+      gallery.addEventListener('scroll', () => {
+        if (!rafId) {
+          rafId = requestAnimationFrame(() => {
+            rafId = null;
+            setPending(findClosestItemIndex());
+          });
+        }
+        clearTimeout(settleTimeout);
+        settleTimeout = setTimeout(() => setActive(findClosestItemIndex()), 100);
+      }, { passive: true });
+      gallery.addEventListener('scrollend', () => {
+        clearTimeout(settleTimeout);
+        setActive(findClosestItemIndex());
+      });
+    }
+
+    // Sync initial state (e.g. restored scroll position).
+    if (document.readyState === 'complete') {
+      setActive(findClosestItemIndex());
+    } else {
+      window.addEventListener('load', () => setActive(findClosestItemIndex()), { once: true });
+    }
+  </script>
+
