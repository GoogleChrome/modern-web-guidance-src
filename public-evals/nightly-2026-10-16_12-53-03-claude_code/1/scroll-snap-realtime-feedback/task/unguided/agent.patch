+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbs = Array.from(document.querySelectorAll('.thumbnail'));
+      let settleTimer;
+
+      // Index of the item whose center is closest to the viewport center.
+      function nearestIndex() {
+        const mid = gallery.scrollLeft + gallery.clientWidth / 2;
+        let best = 0;
+        let bestDist = Infinity;
+        items.forEach((item, i) => {
+          const dist = Math.abs(item.offsetLeft + item.offsetWidth / 2 - mid);
+          if (dist < bestDist) {
+            bestDist = dist;
+            best = i;
+          }
+        });
+        return best;
+      }
+
+      function setPending(index) {
+        thumbs.forEach((t, i) => {
+          t.classList.toggle('pending', i === index && !t.classList.contains('active'));
+        });
+      }
+
+      function settle() {
+        clearTimeout(settleTimer);
+        const index = nearestIndex();
+        thumbs.forEach((t, i) => {
+          t.classList.remove('pending');
+          t.classList.toggle('active', i === index);
+          if (i === index) {
+            t.setAttribute('aria-current', 'true');
+          } else {
+            t.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      // Chrome fires this with the item the browser will snap to, mid-scroll.
+      gallery.addEventListener('scrollsnapchanging', (e) => {
+        const target = e.snapTargetInline;
+        if (target) setPending(items.indexOf(target));
+      });
+
+      // Fallback: predict the target from the current scroll position.
+      gallery.addEventListener('scroll', () => {
+        if (!('onscrollsnapchanging' in window)) setPending(nearestIndex());
+        // Debounced settle for browsers without scrollend.
+        if (!('onscrollend' in window)) {
+          clearTimeout(settleTimer);
+          settleTimer = setTimeout(settle, 120);
+        }
+      }, { passive: true });
+
+      gallery.addEventListener('scrollend', settle);
+
+      thumbs.forEach((thumb, i) => {
+        thumb.addEventListener('click', () => {
+          items[i].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
+        });
+      });
+    })();
+  </script>
