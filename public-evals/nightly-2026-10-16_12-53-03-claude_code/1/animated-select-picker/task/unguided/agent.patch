       font-size: 3rem;
       margin-bottom: 1rem;
     }
 
+    .hero p {
+      margin-bottom: 1.25rem;
+    }
+
+    /* Store picker */
+    .store-select {
+      font: inherit;
+      font-size: 1rem;
+      min-width: 240px;
+      padding: 10px 14px;
+      color: var(--text);
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 5px;
+      cursor: pointer;
+    }
+
+    .store-select:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Customizable select: lets us style and animate the native picker */
+    @supports (appearance: base-select) {
+
+      .store-select,
+      .store-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .store-select {
+        display: inline-flex;
+        justify-content: space-between;
+        align-items: center;
+        gap: 12px;
+        text-align: left;
+      }
+
+      .store-select::picker-icon {
+        content: '▾';
+        color: var(--primary);
+        transition: rotate 0.3s ease;
+      }
+
+      .store-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .store-select::picker(select) {
+        margin-top: 4px;
+        padding: 4px;
+        border: 1px solid var(--secondary);
+        border-radius: 5px;
+        background: white;
+        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
+        opacity: 0;
+        transform: translateY(-6px);
+        transition: opacity 0.25s ease, transform 0.25s ease,
+          display 0.25s allow-discrete, overlay 0.25s allow-discrete;
+      }
+
+      .store-select:open::picker(select) {
+        opacity: 1;
+        transform: translateY(0);
+      }
+
+      @starting-style {
+        .store-select:open::picker(select) {
+          opacity: 0;
+          transform: translateY(-6px);
+        }
+      }
+
+      .store-select option {
+        padding: 8px 12px;
+        border-radius: 3px;
+        transition: background 0.2s;
+      }
+
+      .store-select option:hover,
+      .store-select option:focus-visible {
+        background: var(--secondary);
+      }
+
+      .store-select option:checked {
+        font-weight: bold;
+      }
+
+      .store-select option::checkmark {
+        color: var(--accent);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .store-select::picker-icon,
+      .store-select::picker(select) {
+        transition: none;
+      }
+    }
+
