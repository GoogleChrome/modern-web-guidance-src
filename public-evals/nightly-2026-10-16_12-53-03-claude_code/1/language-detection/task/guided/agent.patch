+  <script>
+    const form = document.getElementById('feedback-form');
+    const message = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const status = document.getElementById('detect-status');
+    let detector;
+
+    async function checkSupport() {
+      if (!('LanguageDetector' in self)) {
+        return 'Language detection is not supported in this browser.';
+      }
+      const availability = await LanguageDetector.availability();
+      if (availability === 'unavailable') {
+        return 'Language detection is unavailable on this device.';
+      }
+      return null;
+    }
+
+    checkSupport().then((problem) => {
+      if (problem) {
+        detectBtn.disabled = true;
+        status.textContent = problem;
+      }
+    });
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const text = message.value.trim();
+      if (!text) {
+        status.textContent = 'Please enter a message first.';
+        return;
+      }
+
+      detectBtn.disabled = true;
+      try {
+        // create() must run from a user gesture in case the model needs downloading.
+        detector ??= await LanguageDetector.create({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              status.textContent = `Downloading language model: ${Math.round(e.loaded * 100)}%`;
+            });
+          },
+        });
+        status.textContent = 'Detecting...';
+        const [top] = await detector.detect(text);
+        if (!top || top.detectedLanguage === 'und') {
+          status.textContent = 'Could not determine the language.';
+          return;
+        }
+        const name = new Intl.DisplayNames(['en'], { type: 'language' }).of(top.detectedLanguage);
+        status.textContent = `Language: ${name} (${Math.round(top.confidence * 100)}% confident)`;
+      } catch (err) {
+        status.textContent = `Detection failed: ${err.message}`;
+      } finally {
+        detectBtn.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
