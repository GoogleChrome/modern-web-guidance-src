+  <script>
+    (function () {
+      var list = document.querySelector('.SwipeableList');
+      var emptyMsg = document.querySelector('.cart-empty');
+      var THRESHOLD = 0.4; // fraction of item width that triggers removal
+
+      function removeItem(item) {
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          item.remove();
+          if (!list.querySelector('.SwipeableList-item')) {
+            emptyMsg.style.display = 'block';
+          }
+        }
+        // Pin the current height so it can transition to 0
+        item.style.height = item.offsetHeight + 'px';
+        item.offsetHeight; // force reflow
+        item.classList.add('is-removing');
+        item.addEventListener('transitionend', function (e) {
+          if (e.propertyName === 'height') finish();
+        });
+        setTimeout(finish, 500); // fallback
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(function (item) {
+        var track = item.querySelector('.SwipeableList-track');
+        var startX = 0;
+        var dx = 0;
+        var active = false;
+
+        track.addEventListener('pointerdown', function (e) {
+          if (item.classList.contains('is-removing')) return;
+          active = true;
+          startX = e.clientX;
+          dx = 0;
+          track.classList.add('is-dragging');
+          track.setPointerCapture(e.pointerId);
+        });
+
+        track.addEventListener('pointermove', function (e) {
+          if (!active) return;
+          dx = Math.min(0, e.clientX - startX); // left swipes only
+          track.style.transform = 'translateX(' + dx + 'px)';
+          item.classList.toggle('is-armed', -dx > item.offsetWidth * THRESHOLD);
+        });
+
+        function end() {
+          if (!active) return;
+          active = false;
+          track.classList.remove('is-dragging');
+          if (-dx > item.offsetWidth * THRESHOLD) {
+            track.style.transform = 'translateX(-100%)';
+            removeItem(item);
+          } else {
+            track.style.transform = '';
+            item.classList.remove('is-armed');
+          }
+        }
+
+        track.addEventListener('pointerup', end);
+        track.addEventListener('pointercancel', end);
+      });
+    })();
+  </script>
+
