+++ b/src/utils/localNetwork.ts
@@ -0,0 +1,31 @@
+export type LocalNetworkPermission = 'local-network' | 'loopback-network';
+
+/**
+ * Returns the Local Network Access permission state. Browsers without support
+ * report 'prompt' so the request can still run from a user gesture.
+ * Never query the legacy 'local-network-access' name: it crashes older Chrome.
+ */
+export async function queryLocalNetworkPermission(
+  name: LocalNetworkPermission,
+): Promise<PermissionState> {
+  if (!navigator.permissions?.query) return 'prompt';
+  try {
+    const status = await navigator.permissions.query({ name: name as PermissionName });
+    return status.state;
+  } catch {
+    return 'prompt';
+  }
+}
+
+/**
+ * Fetches a resource on the local network or loopback interface. Call from a
+ * user gesture unless the permission is already 'granted'. `targetAddressSpace`
+ * exempts http:// targets from mixed content blocking once permission is granted.
+ */
+export function fetchLocal(
+  url: string,
+  space: 'local' | 'loopback',
+  init: RequestInit = {},
+): Promise<Response> {
+  return fetch(new Request(url, { mode: 'cors', ...init, targetAddressSpace: space } as RequestInit));
+}
