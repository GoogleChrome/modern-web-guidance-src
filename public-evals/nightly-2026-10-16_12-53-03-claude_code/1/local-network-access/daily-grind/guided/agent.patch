+  <script type="module">
+    async function checkNetworkPermission(name) {
+      if (!navigator.permissions?.query) return 'prompt';
+      try {
+        const status = await navigator.permissions.query({ name });
+        status.addEventListener('change', () => updatePermissionUI(name, status.state));
+        updatePermissionUI(name, status.state);
+        return status.state;
+      } catch {
+        // Unrecognized permission name: proceed on user gesture
+        updatePermissionUI(name, 'prompt');
+        return 'prompt';
+      }
+    }
+
+    function updatePermissionUI(name, state) {
+      const badge = document.querySelector(`[data-permission-status="${name}"]`);
+      const remediation = document.querySelector(`[data-remediation="${name}"]`);
+      if (badge) badge.textContent = state;
+      if (remediation) remediation.hidden = state !== 'denied';
+    }
+
+    // Placeholder endpoints; replace with real kiosk / companion app addresses.
+    const LOCAL_URL = 'http://192.168.1.100:8080/api/status';
+    const LOOPBACK_URL = 'http://127.0.0.1:45678/health';
+
+    async function fetchJson(url, targetAddressSpace) {
+      const response = await fetch(new Request(url, { mode: 'cors', targetAddressSpace }));
+      if (!response.ok) throw new Error(`HTTP ${response.status}`);
+      return response.json();
+    }
+
+    checkNetworkPermission('local-network');
+    checkNetworkPermission('loopback-network');
+
+    // Requests are only made from a user gesture so the browser can show its prompt.
+    document.getElementById('connect-local').addEventListener('click', async () => {
+      const result = document.getElementById('local-result');
+      result.textContent = 'Connecting…';
+      const [kiosk, companion] = await Promise.allSettled([
+        fetchJson(LOCAL_URL, 'local'),
+        fetchJson(LOOPBACK_URL, 'loopback'),
+      ]);
+      result.textContent =
+        `Kiosk: ${kiosk.status === 'fulfilled' ? 'connected' : 'unavailable'}. ` +
+        `Companion app: ${companion.status === 'fulfilled' ? 'connected' : 'unavailable'}.` +
+        (kiosk.status === 'rejected' || companion.status === 'rejected'
+          ? ' Check that the device is on, on the same network, and allowed in browser permissions.'
+          : '');
+    });
+  </script>
