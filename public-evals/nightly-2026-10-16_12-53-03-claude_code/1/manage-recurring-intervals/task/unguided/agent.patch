+  <script type="module">
+    const startInput = document.getElementById('startDateInput');
+    const yearsInput = document.getElementById('yearsInput');
+    const monthsInput = document.getElementById('monthsInput');
+    const overflowSelect = document.getElementById('overflowSelect');
+    const resultEl = document.getElementById('resultDate');
+
+    const POLYFILL_URL = 'https://cdn.jsdelivr.net/npm/@js-temporal/polyfill@0.5.1/+esm';
+
+    // Progressive enhancement: native Temporal -> polyfill -> manual calendar math.
+    let Temporal = globalThis.Temporal ?? null;
+
+    const pad = (n, len = 2) => String(n).padStart(len, '0');
+    const daysInMonth = (year, month) => new Date(Date.UTC(year, month, 0)).getUTCDate();
+
+    // Exact calendar addition of years + months with an overflow strategy.
+    // Returns { year, month, day }; throws RangeError when "reject" hits a missing day.
+    function addManual({ year, month, day }, years, months, overflow) {
+      const total = year * 12 + (month - 1) + years * 12 + months;
+      const y = Math.floor(total / 12);
+      const m = (total % 12) + 1;
+      const max = daysInMonth(y, m);
+      if (day > max) {
+        if (overflow === 'reject') {
+          throw new RangeError(`${pad(y, 4)}-${pad(m)} has only ${max} days, so day ${day} does not exist.`);
+        }
+        day = max;
+      }
+      return { year: y, month: m, day };
+    }
+
+    function calculate(startValue, years, months, overflow) {
+      if (Temporal) {
+        const sum = Temporal.PlainDate.from(startValue).add({ years, months }, { overflow });
+        return { iso: sum.toString(), year: sum.year, month: sum.month, day: sum.day };
+      }
+      const [year, month, day] = startValue.split('-').map(Number);
+      const r = addManual({ year, month, day }, years, months, overflow);
+      return { iso: `${pad(r.year, 4)}-${pad(r.month)}-${pad(r.day)}`, ...r };
+    }
+
+    function format({ year, month, day }) {
+      // Noon UTC avoids any timezone date shift; format in UTC for the same reason.
+      const d = new Date(Date.UTC(2000, month - 1, day, 12));
+      d.setUTCFullYear(year);
+      return d.toLocaleDateString(undefined, {
+        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
+      });
+    }
+
+    function parseCount(input, label) {
+      const raw = input.value.trim();
+      if (raw === '') return { value: 0 };
+      const n = Number(raw);
+      const max = Number(input.max);
+      if (!Number.isInteger(n) || n < 0) return { error: `${label} must be a whole number of 0 or more.` };
+      if (n > max) return { error: `${label} must be ${max} or fewer.` };
+      return { value: n };
+    }
+
+    function showError(message) {
+      resultEl.classList.add('error');
+      resultEl.textContent = message;
+    }
+
+    function update() {
+      resultEl.classList.remove('error');
+
+      if (!startInput.value || startInput.validity.badInput) {
+        return showError('Please choose a valid start date.');
+      }
+      const years = parseCount(yearsInput, 'Years');
+      if (years.error) return showError(years.error);
+      const months = parseCount(monthsInput, 'Months');
+      if (months.error) return showError(months.error);
+
+      try {
+        const result = calculate(startInput.value, years.value, months.value, overflowSelect.value);
+        resultEl.textContent = format(result);
+      } catch (err) {
+        showError(err instanceof RangeError
+          ? `Can't calculate delivery date: ${err.message}`
+          : 'Something went wrong calculating the delivery date.');
+      }
+    }
+
+    // Default start date to today (local).
+    const now = new Date();
+    startInput.value = `${pad(now.getFullYear(), 4)}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
+
+    for (const el of [startInput, yearsInput, monthsInput, overflowSelect]) {
+      el.addEventListener('input', update);
+      el.addEventListener('change', update);
+    }
+    update();
+
+    // Load the polyfill only when native Temporal is missing; fall back silently on failure.
+    if (!Temporal) {
+      import(POLYFILL_URL)
+        .then((mod) => {
+          Temporal = mod.Temporal;
+          update();
+        })
+        .catch(() => { /* manual calculation stays in use */ });
+    }
+  </script>
 </body>
 
