+  <script type="module">
+    const $ = (id) => document.getElementById(id);
+    const startInput = $('startDateInput');
+    const yearsInput = $('yearsInput');
+    const monthsInput = $('monthsInput');
+    const overflowSelect = $('overflowSelect');
+    const result = $('resultDate');
+
+    function show(text, isError = false) {
+      result.textContent = text;
+      result.dataset.state = isError ? 'error' : 'ok';
+    }
+
+    // Feature-detect native Temporal; fall back to the polyfill only when missing.
+    async function ensureTemporal() {
+      if (typeof globalThis.Temporal !== 'undefined') return;
+      const mod = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    function parseCount(input, label) {
+      const raw = input.value.trim();
+      if (raw === '') return 0;
+      if (!/^\d+$/.test(raw)) throw new RangeError(`${label} must be a whole number, 0 or greater.`);
+      return Number(raw);
+    }
+
+    function update() {
+      try {
+        if (!startInput.value) throw new RangeError('Please choose a start date.');
+        const start = Temporal.PlainDate.from(startInput.value);
+        const years = parseCount(yearsInput, 'Years');
+        const months = parseCount(monthsInput, 'Months');
+        const overflow = overflowSelect.value === 'reject' ? 'reject' : 'constrain';
+        const next = start.add({ years, months }, { overflow });
+        show(next.toLocaleString(undefined, { dateStyle: 'full' }));
+      } catch (e) {
+        const msg = e instanceof RangeError && /whole number|start date/.test(e.message)
+          ? e.message
+          : e instanceof RangeError
+            ? 'That date doesn\u2019t exist in the target month. Choose "constrain" to use the last day of the month instead.'
+            : 'Unable to calculate the delivery date.';
+        show(msg, true);
+      }
+    }
+
+    for (const el of [startInput, yearsInput, monthsInput, overflowSelect]) {
+      el.addEventListener('input', update);
+      el.addEventListener('change', update);
+    }
+
+    try {
+      await ensureTemporal();
+      update();
+    } catch {
+      show('Date calculations are unavailable in this browser right now.', true);
+    }
+  </script>
