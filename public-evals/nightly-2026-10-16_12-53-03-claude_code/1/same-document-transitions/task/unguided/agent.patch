+  <script>
+    const ITEMS = [
+      {
+        slug: 'maple-oat-latte',
+        title: 'Maple Oat Latte',
+        summary: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup, poured over two shots of our house espresso.',
+        notes: 'Notes of toasted maple, oat cream and caramel. Served hot or iced.',
+        image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=1350&q=80'
+      },
+      {
+        slug: 'dark-roast-espresso',
+        title: 'Dark Roast Espresso',
+        summary: 'Bold, smokey, and perfect for a morning boost.',
+        description: 'Bold, smokey, and perfect for a morning boost. Pulled from our darkest small-batch roast.',
+        notes: 'Notes of dark chocolate, cedar and a lingering smoky finish.',
+        image: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=1350&q=80'
+      },
+      {
+        slug: 'cold-brew',
+        title: 'Cold Brew',
+        summary: 'Steeped for 18 hours for maximum smoothness.',
+        description: 'Steeped for 18 hours for maximum smoothness, then served over ice.',
+        notes: 'Notes of cocoa, brown sugar and a naturally low-acid, silky body.',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1350&q=80'
+      }
+    ];
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const grid = document.getElementById('grid');
+    const listHeading = document.getElementById('list-heading');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let currentSlug = null; // slug of the detail being shown, or null for the list
+    let listScrollY = 0;
+
+    // Build the list
+    ITEMS.forEach(item => {
+      const a = document.createElement('a');
+      a.className = 'thumbnail';
+      a.href = '#/' + item.slug;
+      a.dataset.slug = item.slug;
+      a.style.backgroundImage = `url('${item.image}')`;
+      a.innerHTML = '<h2 class="title"></h2>';
+      a.querySelector('.title').textContent = item.title;
+      a.setAttribute('aria-label', `${item.title}: ${item.summary}`);
+      grid.appendChild(a);
+    });
+
+    function slugFromHash() {
+      const m = location.hash.match(/^#\/([\w-]+)/);
+      return m && ITEMS.some(i => i.slug === m[1]) ? m[1] : null;
+    }
+
+    function thumbFor(slug) {
+      return grid.querySelector(`.thumbnail[data-slug="${slug}"]`);
+    }
+
+    // Morph names are only applied while a transition is running
+    function setMorph(heroEl, titleEl) {
+      heroEl.style.viewTransitionName = 'morph-hero';
+      titleEl.style.viewTransitionName = 'morph-title';
+    }
+
+    function clearMorph(...els) {
+      els.forEach(el => el && el.style.removeProperty('view-transition-name'));
+    }
+
+    function showList() {
+      detailPage.hidden = true;
+      listPage.hidden = false;
+      window.scrollTo(0, listScrollY);
+      document.title = 'The Daily Grind | Artisanal Coffee';
+    }
+
+    function showDetail(item) {
+      hero.style.backgroundImage = `url('${item.image}')`;
+      title.textContent = item.title;
+      document.getElementById('detail-description').textContent = item.description;
+      document.getElementById('detail-notes').textContent = item.notes;
+      listPage.hidden = true;
+      detailPage.hidden = false;
+      window.scrollTo(0, 0);
+      document.title = item.title + ' | The Daily Grind';
+    }
+
+    function render(slug) {
+      if (slug) {
+        showDetail(ITEMS.find(i => i.slug === slug));
+      } else {
+        showList();
+      }
+    }
+
+    function focusHeading(slug) {
+      (slug ? title : listHeading).focus({ preventScroll: true });
+    }
+
+    function navigate(slug) {
+      const from = currentSlug;
+      if (slug === from) return;
+      if (!from) listScrollY = window.scrollY;
+      currentSlug = slug;
+
+      const canAnimate = document.startViewTransition && !reducedMotion.matches;
+      if (!canAnimate) {
+        render(slug);
+        focusHeading(slug);
+        return;
+      }
+
+      // Outgoing side gets its morph names before the old snapshot is captured
+      const outThumb = from ? null : thumbFor(slug);
+      const backThumb = slug ? null : thumbFor(from);
+      const sourceThumb = outThumb || backThumb;
+      if (outThumb) {
+        setMorph(outThumb, outThumb.querySelector('.title'));
+      } else {
+        setMorph(hero, title);
+      }
+
+      const transition = document.startViewTransition(() => {
+        // Swap names to the incoming side before the new snapshot is captured
+        if (outThumb) {
+          clearMorph(outThumb, outThumb.querySelector('.title'));
+          render(slug);
+          setMorph(hero, title);
+        } else {
+          clearMorph(hero, title);
+          render(slug);
+          setMorph(backThumb, backThumb.querySelector('.title'));
+        }
+        focusHeading(slug);
+      });
+
+      const cleanup = () => {
+        clearMorph(hero, title, sourceThumb, sourceThumb && sourceThumb.querySelector('.title'));
+      };
+      transition.finished.then(cleanup, cleanup);
+    }
+
+    window.addEventListener('hashchange', () => navigate(slugFromHash()));
+
+    // Initial route (no animation)
+    currentSlug = slugFromHash();
+    render(currentSlug);
+    if (currentSlug) focusHeading(currentSlug);
+  </script>
+
