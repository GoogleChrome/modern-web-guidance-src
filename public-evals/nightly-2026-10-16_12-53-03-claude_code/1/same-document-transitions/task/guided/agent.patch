+
+    /* Shared element transitions. Names are applied only while a transition runs
+       (.selected is added/removed by JS) so the list never has duplicate names. */
+    #detail-page #hero,
+    .thumbnail.selected {
+      view-transition-name: hero;
+    }
+
+    #detail-page #title,
+    .thumbnail.selected .title {
+      view-transition-name: title;
+    }
+
+    /* Snapshots fill the morphing group and are cropped, not stretched,
+       when the aspect ratio of the two states differs. */
+    ::view-transition-old(hero),
+    ::view-transition-new(hero) {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      object-position: center;
+    }
+
+    /* Text keeps its own aspect ratio while the group resizes. */
+    ::view-transition-old(title),
+    ::view-transition-new(title) {
+      width: 100%;
+      height: 100%;
+      object-fit: contain;
+      object-position: left bottom;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+
+      nav a,
+      .btn {
+        transition: none;
+      }
+    }
