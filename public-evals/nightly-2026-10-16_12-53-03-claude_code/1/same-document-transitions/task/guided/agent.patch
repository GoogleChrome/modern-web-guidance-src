+  <script>
+    const items = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1600&q=80',
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=1600&q=80',
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1600&q=80',
+      },
+    };
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const heroEl = document.getElementById('hero');
+    const titleEl = document.getElementById('title');
+    const descriptionEl = document.getElementById('detail-description');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    let currentId = null; // id of the item shown in the detail view, or null for the list
+    let activeTransition = null;
+    let listScrollY = 0;
+
+    const idFromHash = () => {
+      const id = location.hash.replace(/^#\//, '');
+      return id in items ? id : null;
+    };
+
+    const thumbnailFor = (id) => listPage.querySelector(`.thumbnail[data-id="${id}"]`);
+
+    function renderView(id) {
+      currentId = id;
+      if (id) {
+        const item = items[id];
+        titleEl.textContent = item.title;
+        descriptionEl.textContent = item.description;
+        heroEl.style.setProperty('--image', `url('${item.image}')`);
+        document.title = `${item.title} | The Daily Grind`;
+      } else {
+        document.title = 'The Daily Grind | Artisanal Coffee';
+      }
+      listPage.hidden = Boolean(id);
+      detailPage.hidden = !id;
+    }
+
+    function clearTransitionState() {
+      listPage.querySelectorAll('.thumbnail.selected').forEach((el) => el.classList.remove('selected'));
+    }
+
+    // Swaps views, morphing the shared elements when possible, then moves focus
+    // to the new view's heading and removes the temporary transition state.
+    // `fromId` / `toId` identify which thumbnail takes part in the morph.
+    function show(toId) {
+      const fromId = currentId;
+      if (fromId === toId) return;
+      activeTransition?.skipTransition();
+
+      const morphId = toId ?? fromId;
+      const entering = Boolean(toId);
+
+      const update = () => {
+        if (entering) {
+          listScrollY = window.scrollY;
+        }
+        renderView(toId);
+        if (!entering) {
+          // The thumbnail needs its transition names in the new state.
+          thumbnailFor(morphId)?.classList.add('selected');
+        }
+        window.scrollTo(0, entering ? 0 : listScrollY);
+      };
+
+      const finish = () => {
+        if (entering) {
+          titleEl.focus({ preventScroll: true });
+        } else {
+          listHeading.focus({ preventScroll: true });
+        }
+        clearTransitionState();
+        activeTransition = null;
+      };
+
+      if (!document.startViewTransition || reducedMotion.matches) {
+        update();
+        finish();
+        return;
+      }
+
+      // The thumbnail needs its transition names in the old state.
+      if (entering) thumbnailFor(morphId)?.classList.add('selected');
+
+      activeTransition = document.startViewTransition(update);
+      // Clean up and restore focus whether the transition completes or is skipped.
+      const transition = activeTransition;
+      transition.finished.finally(() => {
+        // A newer transition owns focus and cleanup if it replaced this one.
+        if (activeTransition === transition) finish();
+      });
+    }
+
+    listPage.addEventListener('click', (e) => {
+      const thumbnail = e.target.closest('.thumbnail');
+      if (!thumbnail || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
+      e.preventDefault();
+      history.pushState({ id: thumbnail.dataset.id }, '', `#/${thumbnail.dataset.id}`);
+      show(thumbnail.dataset.id);
+    });
+
+    document.getElementById('back').addEventListener('click', () => {
+      // Use history so the browser back button stays consistent with the in-page one.
+      if (history.state?.id) history.back();
+      else {
+        history.replaceState(null, '', location.pathname + location.search);
+        show(null);
+      }
+    });
+
+    window.addEventListener('popstate', () => show(idFromHash()));
+
+    // Deep link support (no transition on initial load).
+    renderView(idFromHash());
+  </script>
+
