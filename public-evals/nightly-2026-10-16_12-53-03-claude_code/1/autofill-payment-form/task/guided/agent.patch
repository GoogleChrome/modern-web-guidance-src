+    /* Payment Form */
+    .payment {
+      margin-top: 60px;
+    }
+
+    .payment-form {
+      max-width: 480px;
+      margin: 20px auto 0;
+      background: white;
+      padding: 24px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      display: grid;
+      grid-template-columns: 1fr 1fr;
+      gap: 16px;
+    }
+
+    .field {
+      display: flex;
+      flex-direction: column;
+      grid-column: 1 / -1;
+    }
+
+    .field.half {
+      grid-column: auto;
+    }
+
+    .field label {
+      font-weight: 600;
+      margin-bottom: 4px;
+    }
+
+    .field .hint {
+      font-size: 0.8rem;
+      opacity: 0.75;
+      margin-bottom: 4px;
+    }
+
+    .field input {
+      font: inherit;
+      padding: 10px 12px;
+      border: 1px solid var(--secondary);
+      border-radius: 5px;
+    }
+
+    .field input:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 1px;
+    }
+
+    .field input:user-invalid {
+      border-color: #c62828;
+    }
+
+    .payment-form button.btn {
+      grid-column: 1 / -1;
+      border: none;
+      cursor: pointer;
+      font: inherit;
+      margin-top: 0;
+    }
+
