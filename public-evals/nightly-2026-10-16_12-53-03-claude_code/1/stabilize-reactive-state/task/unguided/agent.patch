+  <script>
+    // Deadline state is a Temporal.PlainDate, which is immutable: add() returns a new instance.
+    // Fall back to a frozen minimal equivalent where Temporal isn't available yet.
+    const PlainDate = (globalThis.Temporal && Temporal.PlainDate) || class {
+      constructor(y, m, d) {
+        this.d = new Date(Date.UTC(y, m - 1, d));
+        Object.freeze(this);
+      }
+      static from(s) {
+        const [y, m, d] = s.split('-').map(Number);
+        return new this(y, m, d);
+      }
+      add({ days }) {
+        const n = new Date(this.d);
+        n.setUTCDate(n.getUTCDate() + days);
+        return new this.constructor(n.getUTCFullYear(), n.getUTCMonth() + 1, n.getUTCDate());
+      }
+      toString() {
+        return this.d.toISOString().slice(0, 10);
+      }
+    };
+
+    let deadline = PlainDate.from('2026-11-01');
+    let renderCount = 0;
+
+    function render(refChanged) {
+      renderCount += 1;
+      document.getElementById('temporal-value').textContent = deadline.toString();
+      document.getElementById('temporal-ref-changed').textContent = refChanged ? 'Yes' : 'No';
+      document.getElementById('temporal-render-count').textContent = renderCount;
+    }
+
+    document.getElementById('extend-temporal-btn').addEventListener('click', () => {
+      const previous = deadline;
+      deadline = deadline.add({ days: 7 });
+      render(deadline !== previous);
+    });
+
+    render(false);
+  </script>
 </body>
 
