+  <script type="module">
+    if (typeof Temporal === "undefined") {
+      try {
+        const module = await import("https://esm.sh/@js-temporal/polyfill");
+        globalThis.Temporal = module.Temporal;
+      } catch (e) {
+        console.error("Failed to load Temporal polyfill:", e);
+      }
+    }
+
+    if (typeof Temporal !== "undefined") {
+      const valueEl = document.getElementById("temporal-value");
+      const changedEl = document.getElementById("temporal-ref-changed");
+      const countEl = document.getElementById("temporal-render-count");
+      const extendBtn = document.getElementById("extend-temporal-btn");
+
+      let state = { deadline: Temporal.Now.plainDateISO().add({ days: 7 }) };
+      let renderCount = 0;
+
+      function render(refChanged) {
+        renderCount++;
+        valueEl.textContent = state.deadline.toString();
+        changedEl.textContent = refChanged ? "Yes" : "No";
+        countEl.textContent = renderCount;
+      }
+
+      extendBtn.addEventListener("click", () => {
+        const prev = state.deadline;
+        // add() returns a new instance; the old one is never mutated
+        state = { deadline: prev.add({ days: 1 }) };
+        render(state.deadline !== prev);
+      });
+
+      render(false);
+    }
+  </script>
 </body>
 
