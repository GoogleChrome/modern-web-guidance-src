+  <script>
+    (function () {
+      // Uses the HTML-in-Canvas API: <canvas layoutsubtree>, ctx.drawElementImage(), the canvas
+      // "paint" event and canvas.requestPaint().
+      const CARD_W = 600;
+      const CARD_H = 360;
+
+      const canvas = document.getElementById('card_canvas');
+      const card = document.getElementById('export_element');
+      const nameInput = document.getElementById('card_name');
+      const messageInput = document.getElementById('card_message');
+      const colorInput = document.getElementById('card_color');
+      const exportButton = document.getElementById('export_button');
+      const status = document.getElementById('designer_status');
+      const ctx = canvas.getContext('2d');
+
+      const supported = 'layoutSubtree' in canvas &&
+        typeof ctx.drawElementImage === 'function' &&
+        typeof canvas.requestPaint === 'function';
+
+      if (!supported) {
+        exportButton.disabled = true;
+        status.textContent = 'Card export needs a browser with HTML-in-Canvas support (e.g. a recent Chromium with it enabled).';
+      }
+
+      function syncCard() {
+        document.getElementById('gc_name').textContent = nameInput.value.trim() || 'a coffee lover';
+        document.getElementById('gc_message').textContent = messageInput.value;
+        card.style.background = colorInput.value;
+        if (supported) canvas.requestPaint();
+      }
+
+      function draw() {
+        const dpr = window.devicePixelRatio || 1;
+        // Resizing the backing store clears it; always size for the export at >= 2x for crispness.
+        const scale = Math.max(2, Math.ceil(dpr));
+        if (canvas.width !== CARD_W * scale) {
+          canvas.width = CARD_W * scale;
+          canvas.height = CARD_H * scale;
+        }
+        ctx.reset();
+        ctx.scale(scale, scale);
+        const transform = ctx.drawElementImage(card, 0, 0);
+        // Keep the DOM element's hit-testing/accessibility position aligned with what was drawn.
+        if (transform) card.style.transform = transform.toString();
+      }
+
+      if (supported) {
+        canvas.addEventListener('paint', draw);
+        // Redraw after web fonts load, since text metrics may change.
+        document.fonts.ready.then(() => canvas.requestPaint());
+        new ResizeObserver(() => canvas.requestPaint()).observe(canvas);
+      }
+
+      // Resolves after the next paint event, i.e. once the canvas reflects the current DOM.
+      function nextPaint() {
+        return new Promise((resolve) => {
+          canvas.addEventListener('paint', () => resolve(), { once: true });
+          canvas.requestPaint();
+        });
+      }
+
+      exportButton.addEventListener('click', async () => {
+        if (!supported) return;
+        exportButton.disabled = true;
+        try {
+          await document.fonts.ready;
+          await nextPaint();
+          const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
+          if (!blob) throw new Error('toBlob returned null');
+          const url = URL.createObjectURL(blob);
+          const a = document.createElement('a');
+          a.href = url;
+          a.download = 'daily-grind-gift-card.png';
+          document.body.appendChild(a);
+          a.click();
+          a.remove();
+          setTimeout(() => URL.revokeObjectURL(url), 1000);
+          status.textContent = 'Card downloaded.';
+        } catch (err) {
+          status.textContent = 'Sorry, the card could not be exported.';
+        } finally {
+          exportButton.disabled = false;
+        }
+      });
+
+      [nameInput, messageInput, colorInput].forEach((el) => el.addEventListener('input', syncCard));
+      syncCard();
+    })();
+  </script>
