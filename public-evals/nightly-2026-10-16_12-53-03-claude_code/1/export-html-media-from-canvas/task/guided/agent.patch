+  <script>
+    (() => {
+      const canvas = document.getElementById('card_canvas');
+      const card = document.getElementById('export_element');
+      const stage = document.getElementById('card_stage');
+      const status = document.getElementById('export_status');
+      const nameInput = document.getElementById('name_input');
+      const messageInput = document.getElementById('message_input');
+      const colorInput = document.getElementById('color_input');
+      const exportButton = document.getElementById('export_button');
+
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+      // Keep text readable on any chosen background.
+      function contrastColor(hex) {
+        const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
+        return (r * 299 + g * 587 + b * 114) / 1000 > 150 ? '#2b1b17' : '#ffffff';
+      }
+
+      function updateCard() {
+        card.style.background = colorInput.value;
+        card.style.color = contrastColor(colorInput.value);
+        document.getElementById('card_name').textContent = nameInput.value.trim() || 'For you';
+        document.getElementById('card_message').textContent = messageInput.value;
+        if (supportsHtmlInCanvas) canvas.requestPaint();
+      }
+
+      function canvasToBlob(target) {
+        return new Promise((resolve, reject) =>
+          target.toBlob((blob) => (blob ? resolve(blob) : reject(new Error('Export failed'))), 'image/png'));
+      }
+
+      function download(blob) {
+        const url = URL.createObjectURL(blob);
+        const link = document.createElement('a');
+        link.download = 'daily-grind-gift-card.png';
+        link.href = url;
+        link.click();
+        URL.revokeObjectURL(url);
+      }
+
+      let exportCanvas = canvas;
+
+      if (supportsHtmlInCanvas) {
+        const ctx = canvas.getContext('2d');
+
+        // Draw only inside onpaint, so the snapshot is up to date.
+        canvas.onpaint = () => {
+          ctx.reset();
+          const scale = canvas.width / canvas.clientWidth;
+          ctx.scale(scale, scale);
+          ctx.drawElementImage(card, 0, 0);
+        };
+
+        // Match the canvas grid to device pixels for a crisp export.
+        const observer = new ResizeObserver(([entry]) => {
+          const dpc = entry.devicePixelContentBoxSize;
+          canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+          canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+          canvas.requestPaint();
+        });
+        const supportsDevicePixelBox =
+          typeof ResizeObserverEntry !== 'undefined' &&
+          'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+        observer.observe(canvas, supportsDevicePixelBox ? { box: 'device-pixel-content-box' } : {});
+
+        exportButton.addEventListener('click', async () => {
+          try {
+            // Wait for a fresh paint so the export includes the latest edits.
+            await new Promise((resolve) => {
+              canvas.addEventListener('paint', resolve, { once: true });
+              canvas.requestPaint();
+            });
+            download(await canvasToBlob(canvas));
+            status.textContent = 'Card downloaded.';
+          } catch (err) {
+            status.textContent = 'Sorry, the export failed. Please try again.';
+          }
+        });
+      } else {
+        // Fallback: show the card as regular HTML and rasterize it with html2canvas on demand.
+        stage.insertBefore(card, canvas);
+        canvas.hidden = true;
+        card.removeAttribute('drawable');
+        card.style.width = '480px';
+        card.style.maxWidth = '100%';
+        card.style.boxShadow = '0 4px 14px rgba(0, 0, 0, 0.2)';
+
+        let loader;
+        const loadHtml2Canvas = () => (loader ||= new Promise((resolve, reject) => {
+          const script = document.createElement('script');
+          script.src = 'https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js';
+          script.onload = () => resolve(window.html2canvas);
+          script.onerror = () => { loader = null; reject(new Error('Could not load html2canvas')); };
+          document.head.appendChild(script);
+        }));
+
+        exportButton.addEventListener('click', async () => {
+          status.textContent = 'Preparing image…';
+          try {
+            const html2canvas = await loadHtml2Canvas();
+            exportCanvas = await html2canvas(card, { scale: devicePixelRatio, backgroundColor: null });
+            download(await canvasToBlob(exportCanvas));
+            status.textContent = 'Card downloaded.';
+          } catch (err) {
+            status.textContent = 'Sorry, image export is not available in this browser.';
+          }
+        });
+      }
+
+      [nameInput, messageInput, colorInput].forEach((el) => el.addEventListener('input', updateCard));
+      updateCard();
+    })();
+  </script>
+
