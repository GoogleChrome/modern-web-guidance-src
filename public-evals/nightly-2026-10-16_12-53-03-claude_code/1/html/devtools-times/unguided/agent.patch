diff --git a/src/components/ModalDialog.tsx b/src/components/ModalDialog.tsx
new file mode 100644
index 0000000..4e4040a
--- /dev/null
+++ b/src/components/ModalDialog.tsx
@@ -0,0 +1,50 @@
+import React, { useEffect, useLayoutEffect, useRef } from 'react';
+
+interface Props {
+  open: boolean;
+  onClose: () => void;
+  label: string;
+  children: React.ReactNode;
+}
+
+/**
+ * Wraps the native <dialog> element. The browser provides the top layer,
+ * inert background, focus trapping, Escape handling and focus restoration
+ * to the previously focused element when the dialog closes.
+ */
+export default function ModalDialog({ open, onClose, label, children }: Props) {
+  const ref = useRef<HTMLDialogElement>(null);
+
+  // Layout effect so the dialog is shown before child effects move focus (e.g. to an input)
+  useLayoutEffect(() => {
+    const dialog = ref.current;
+    if (!dialog) return;
+    if (open && !dialog.open) {
+      dialog.showModal();
+    } else if (!open && dialog.open) {
+      dialog.close();
+    }
+  }, [open]);
+
+  // Keep state in sync when the browser closes the dialog itself (Escape key)
+  useEffect(() => {
+    const dialog = ref.current;
+    if (!dialog) return;
+    dialog.addEventListener('close', onClose);
+    return () => dialog.removeEventListener('close', onClose);
+  }, [onClose]);
+
+  return (
+    <dialog
+      ref={ref}
+      aria-label={label}
+      // Clicks on the backdrop target the dialog element itself
+      onClick={e => {
+        if (e.target === e.currentTarget) onClose();
+      }}
+      className="m-auto mt-[15vh] p-0 bg-transparent w-[calc(100%-2rem)] max-w-2xl overflow-visible backdrop:bg-white/30 backdrop:backdrop-blur-sm"
+    >
+      {open && children}
+    </dialog>
+  );
+}
