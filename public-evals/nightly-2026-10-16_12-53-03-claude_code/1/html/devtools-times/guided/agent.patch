+}
+
+/* Header section flyouts: native popovers tethered below the section nav. */
+.bottom-nav {
+  anchor-name: --bottom-nav;
+}
+
+.flyout-menu {
+  /* Popovers sit in the top layer, so reset UA centering/borders */
+  margin: 0;
+  padding: 0;
+  border: 0;
+  inset: auto;
+  width: 100%;
+  max-width: 72rem;
+  color: inherit;
+}
+
+@supports (anchor-name: --a) {
+  .flyout-menu {
+    position-anchor: --bottom-nav;
+    top: anchor(bottom);
+    left: anchor(center);
+    translate: -50% 0;
+  }
+}
