     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingForm = document.getElementById('mailing-list-form');
+    const mailingEmail = mailingForm.elements.email;
+
+    // Mirror the :user-invalid visual state to assistive tech
+    const syncAria = () => {
+      mailingEmail.setAttribute('aria-invalid', mailingEmail.matches(':user-invalid') ? 'true' : 'false');
+    };
+
+    mailingEmail.addEventListener('blur', syncAria);
+    mailingEmail.addEventListener('input', () => {
+      if (mailingEmail.hasAttribute('aria-invalid')) syncAria();
+    });
+    mailingForm.addEventListener('invalid', syncAria, true);
+  </script>
+
 </body>
 
