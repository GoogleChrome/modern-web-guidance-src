+
+  <script type="module">
+    // Temporal is not available in every browser (e.g. Safari); load a polyfill when missing.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const drinks = ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew'];
+    const events = [];
+    const logEl = document.getElementById('telemetry-log');
+
+    function recordEvent(eventType, nodeId) {
+      return { nodeId, eventType, timestamp: Temporal.Now.instant() };
+    }
+
+    function sequenceEvents(list) {
+      return [...list].sort((a, b) => Temporal.Instant.compare(a.timestamp, b.timestamp));
+    }
+
+    function render() {
+      const sorted = sequenceEvents(events);
+      const lines = sorted.map((ev, i) => {
+        const delta = i === 0
+          ? 'first order'
+          : `+${ev.timestamp.since(sorted[i - 1].timestamp).total('nanoseconds')} ns`;
+        return `#${i + 1} ${ev.eventType} [${ev.nodeId}] ${ev.timestamp.toString({ fractionalSecondDigits: 9 })}  ${delta}`;
+      });
+      logEl.textContent = lines.join('\n');
+      logEl.scrollTop = logEl.scrollHeight;
+      if (sorted.length > 1) {
+        const last = sorted.length - 1;
+        console.log(`Delay between order ${last} and order ${last + 1}: ${sorted[last].timestamp.since(sorted[last - 1].timestamp).total('nanoseconds')}ns`);
+      }
+    }
+
+    document.getElementById('order-btn').addEventListener('click', () => {
+      const drink = drinks[events.length % drinks.length];
+      events.push(recordEvent(drink, `barista-${(events.length % 3) + 1}`));
+      render();
+    });
+  </script>
+
 </body>
 
