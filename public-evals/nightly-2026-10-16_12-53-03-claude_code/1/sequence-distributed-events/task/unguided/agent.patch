+  <script src="telemetry.js"></script>
+  <script>
+    const DRINKS = ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew'];
+    const body = document.getElementById('trace-body');
+
+    function render() {
+      body.replaceChildren(...Telemetry.sequence().map((s) => {
+        const tr = document.createElement('tr');
+        [s.id, s.name, `${s.ts}`, Telemetry.fmtDelta(s.deltaNs)].forEach((v, i) => {
+          const td = document.createElement('td');
+          if (i >= 2) td.className = 'num';
+          td.textContent = v;
+          tr.appendChild(td);
+        });
+        return tr;
+      }));
+    }
+
+    document.getElementById('order-btn').addEventListener('click', () => {
+      const name = DRINKS[Math.floor(Math.random() * DRINKS.length)];
+      Telemetry.log(Telemetry.record(name));
+      render();
+    });
+
+    document.getElementById('reset-btn').addEventListener('click', () => {
+      Telemetry.reset();
+      render();
+    });
+  </script>
