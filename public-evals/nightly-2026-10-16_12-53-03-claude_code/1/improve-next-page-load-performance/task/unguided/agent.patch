+  <script>
+    // Prefetch same-origin pages when the user shows intent (hover, focus, touch).
+    // Never prefetch state-changing links: opt out with data-no-prefetch, or via the path denylist.
+    (function () {
+      var NEVER_PREFETCH = [/^\/logout\b/i, /^\/log-out\b/i, /^\/signout\b/i];
+      var seen = {};
+
+      function shouldPrefetch(a) {
+        if (!a || !a.href || a.hasAttribute('data-no-prefetch') || a.hasAttribute('download')) return false;
+        if (a.target && a.target !== '_self') return false;
+        if (a.origin !== location.origin) return false;
+        if (a.pathname === location.pathname && a.search === location.search) return false;
+        return !NEVER_PREFETCH.some(function (re) { return re.test(a.pathname); });
+      }
+
+      function prefetch(e) {
+        var a = e.target.closest && e.target.closest('a');
+        if (!shouldPrefetch(a) || seen[a.href]) return;
+        var conn = navigator.connection;
+        if (conn && (conn.saveData || /2g/.test(conn.effectiveType))) return;
+        seen[a.href] = true;
+        var link = document.createElement('link');
+        link.rel = 'prefetch';
+        link.href = a.href;
+        link.as = 'document';
+        document.head.appendChild(link);
+      }
+
+      ['mouseover', 'focusin', 'touchstart'].forEach(function (type) {
+        document.addEventListener(type, prefetch, { passive: true });
+      });
+    })();
+  </script>
