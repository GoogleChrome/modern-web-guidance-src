+  <script type="module">
+    import { loadOrCreateRecipientKeys, sealMessage, openMessage, toBase64 } from './envelope.js';
+
+    const form = document.getElementById('note-form');
+    const suiteEl = document.getElementById('note-suite');
+    const envelopeEl = document.getElementById('note-envelope');
+    const openBtn = document.getElementById('note-open');
+    const plainEl = document.getElementById('note-plain');
+    let envelope;
+    let recipient;
+
+    form.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      plainEl.hidden = true;
+      try {
+        // Demo: the "shop" key pair lives in this browser's IndexedDB; in production,
+        // senders would fetch the shop's public key from the server instead.
+        recipient ??= await loadOrCreateRecipientKeys();
+        envelope = await sealMessage(recipient.publicKeyBytes, form.note.value);
+        suiteEl.textContent = `Encrypted with ${recipient.suite}.`;
+        envelopeEl.textContent = `capsule: ${toBase64(envelope.capsule).slice(0, 48)}…\niv: ${toBase64(envelope.iv)}\nciphertext: ${toBase64(envelope.ciphertext)}`;
+        envelopeEl.style.whiteSpace = 'pre-wrap';
+        envelopeEl.hidden = openBtn.hidden = false;
+        form.note.value = '';
+      } catch (err) {
+        suiteEl.textContent = `Encryption is unavailable in this browser (${err.name}).`;
+      }
+    });
+
+    openBtn.addEventListener('click', async () => {
+      try {
+        plainEl.textContent = await openMessage(recipient.keyPair.privateKey, envelope);
+      } catch (err) {
+        plainEl.textContent = `Decryption failed (${err.name}).`;
+      }
+      plainEl.hidden = false;
+    });
+  </script>
