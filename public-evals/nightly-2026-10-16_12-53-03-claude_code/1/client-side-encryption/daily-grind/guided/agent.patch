+// Envelope encryption: KEM / key agreement -> AEAD, via WebCrypto.
+// Preferred suite: hybrid ML-KEM-768 + X25519 with ChaCha20-Poly1305.
+// Fallback suite: ephemeral X25519 + HKDF + AES-GCM.
+
+const KEM_PUBLIC_KEY_ALGORITHMS = {
+  1184: 'ML-KEM-768',
+  1216: 'MLKEM768-X25519',
+  1568: 'ML-KEM-1024',
+};
+
+const PROTOCOL = 'daily-grind-envelope-v1';
+const INFO = new TextEncoder().encode(PROTOCOL);
+
+export function supportsPostQuantumEnvelope() {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('encapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305')
+  );
+}
+
+export async function generateRecipientKeys() {
+  if (supportsPostQuantumEnvelope()) {
+    const keyPair = await crypto.subtle.generateKey('MLKEM768-X25519', false, [
+      'encapsulateKey',
+      'decapsulateKey',
+    ]);
+    const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey('raw-public', keyPair.publicKey));
+    return { suite: 'MLKEM768-X25519+ChaCha20-Poly1305', keyPair, publicKeyBytes };
+  }
+
+  const keyPair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey('raw', keyPair.publicKey));
+  return { suite: 'X25519+HKDF+AES-GCM', keyPair, publicKeyBytes };
+}
+
+async function deriveFallbackAesKey(privateKey, peerPublicKey) {
+  const sharedSecret = await crypto.subtle.deriveBits({ name: 'X25519', public: peerPublicKey }, privateKey, 256);
+  const hkdfKey = await crypto.subtle.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey(
+    { name: 'HKDF', hash: 'SHA-256', salt: new Uint8Array(32), info: INFO },
+    hkdfKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt'],
+  );
+}
+
+async function encapsulate(publicKeyBytes) {
+  const kemName = KEM_PUBLIC_KEY_ALGORITHMS[publicKeyBytes.byteLength];
+
+  if (kemName) {
+    const pubKey = await crypto.subtle.importKey('raw-public', publicKeyBytes, kemName, true, ['encapsulateKey']);
+    const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+      kemName,
+      pubKey,
+      'ChaCha20-Poly1305',
+      false,
+      ['encrypt', 'decrypt'],
+    );
+    return { sharedKey, capsule: new Uint8Array(ciphertext) };
+  }
+
+  const pubKey = await crypto.subtle.importKey('raw', publicKeyBytes, 'X25519', true, []);
+  const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  const capsule = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+  const sharedKey = await deriveFallbackAesKey(ephemeral.privateKey, pubKey);
+  return { sharedKey, capsule };
+}
+
+async function decapsulate(privateKey, capsule) {
+  if (privateKey.algorithm.name !== 'X25519') {
+    return crypto.subtle.decapsulateKey(
+      privateKey.algorithm.name,
+      privateKey,
+      capsule,
+      'ChaCha20-Poly1305',
+      false,
+      ['encrypt', 'decrypt'],
+    );
+  }
+  const ephemeralPubKey = await crypto.subtle.importKey('raw', capsule, 'X25519', true, []);
+  return deriveFallbackAesKey(privateKey, ephemeralPubKey);
+}
+
+/** Encrypts text to a recipient public key. Returns { capsule, iv, ciphertext } as Uint8Arrays. */
+export async function sealMessage(recipientPublicKeyBytes, plaintext, aad = PROTOCOL) {
+  const { sharedKey, capsule } = await encapsulate(recipientPublicKeyBytes);
+  // The key is one-time (fresh per encapsulation), and the IV is random per message.
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const buf = await crypto.subtle.encrypt(
+    { name: sharedKey.algorithm.name, iv, additionalData: new TextEncoder().encode(aad) },
+    sharedKey,
+    new TextEncoder().encode(plaintext),
+  );
+  return { capsule, iv, ciphertext: new Uint8Array(buf) };
+}
+
+/** Decrypts and authenticates an envelope; rejects with OperationError if tampered. */
+export async function openMessage(recipientPrivateKey, { capsule, iv, ciphertext }, aad = PROTOCOL) {
+  const key = await decapsulate(recipientPrivateKey, capsule);
+  const buf = await crypto.subtle.decrypt(
+    { name: key.algorithm.name, iv, additionalData: new TextEncoder().encode(aad) },
+    key,
+    ciphertext,
+  );
+  return new TextDecoder().decode(buf);
+}
+
+// Persist the non-extractable key pair in IndexedDB (private key bytes never exposed).
+const DB_NAME = 'daily-grind-keys';
+const STORE = 'keys';
+const RECORD = 'recipient';
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB_NAME, 1);
+    req.onupgradeneeded = () => req.result.createObjectStore(STORE);
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+function idb(db, mode, fn) {
+  return new Promise((resolve, reject) => {
+    const req = fn(db.transaction(STORE, mode).objectStore(STORE));
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+export async function loadOrCreateRecipientKeys() {
+  const db = await openDb();
+  const stored = await idb(db, 'readonly', (s) => s.get(RECORD));
+  if (stored) return stored;
+  const keys = await generateRecipientKeys();
+  await idb(db, 'readwrite', (s) => s.put(keys, RECORD));
+  return keys;
+}
+
+export const toBase64 = (bytes) => btoa(String.fromCharCode(...bytes));
