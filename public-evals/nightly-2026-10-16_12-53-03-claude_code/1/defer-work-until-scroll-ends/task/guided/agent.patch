+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    let scrolling = false;
+
+    // Scroll handler only flips a flag and writes the DOM once per scroll gesture.
+    scroller.addEventListener('scroll', () => {
+      if (scrolling) return;
+      scrolling = true;
+      status.textContent = 'Scrolling...';
+    }, { passive: true });
+
+    // Layout reads happen once, after scrolling rests.
+    function onScrollEnd() {
+      scrolling = false;
+      const box = scroller.getBoundingClientRect();
+      let best = null;
+      let bestVisible = -1;
+      for (const card of scroller.children) {
+        const r = card.getBoundingClientRect();
+        const visible = Math.min(r.right, box.right) - Math.max(r.left, box.left);
+        if (visible > bestVisible) {
+          bestVisible = visible;
+          best = card;
+        }
+      }
+      status.textContent = `Scroll ended. Visible: ${best.dataset.origin}`;
+    }
+
+    if ('onscrollend' in window) {
+      scroller.addEventListener('scrollend', onScrollEnd);
+    } else {
+      let timer;
+      scroller.addEventListener('scroll', () => {
+        clearTimeout(timer);
+        timer = setTimeout(onScrollEnd, 100);
+      }, { passive: true });
+    }
+  </script>
+
