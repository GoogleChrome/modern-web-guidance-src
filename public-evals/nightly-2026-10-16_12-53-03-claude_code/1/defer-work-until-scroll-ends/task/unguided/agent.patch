+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var status = document.getElementById('status');
+      var cards = scroller.querySelectorAll('.bean-card');
+      var scrolling = false;
+      var endTimer = 0;
+      var hasScrollEnd = 'onscrollend' in window;
+
+      // Most visible = card with the largest horizontal overlap with the scroller viewport.
+      function mostVisibleOrigin() {
+        var box = scroller.getBoundingClientRect();
+        var best = null;
+        var bestOverlap = -1;
+        for (var i = 0; i < cards.length; i++) {
+          var r = cards[i].getBoundingClientRect();
+          var overlap = Math.min(r.right, box.right) - Math.max(r.left, box.left);
+          if (overlap > bestOverlap) {
+            bestOverlap = overlap;
+            best = cards[i];
+          }
+        }
+        return best.dataset.origin;
+      }
+
+      function onScrollEnd() {
+        scrolling = false;
+        status.textContent = 'Scroll ended. Visible: ' + mostVisibleOrigin();
+      }
+
+      // Lightweight: no layout reads while scrolling; the DOM is written only once per scroll gesture.
+      scroller.addEventListener('scroll', function () {
+        if (!scrolling) {
+          scrolling = true;
+          status.textContent = 'Scrolling...';
+        }
+        if (!hasScrollEnd) {
+          clearTimeout(endTimer);
+          endTimer = setTimeout(onScrollEnd, 150);
+        }
+      }, { passive: true });
+
+      if (hasScrollEnd) {
+        scroller.addEventListener('scrollend', onScrollEnd);
+      }
+    })();
+  </script>
