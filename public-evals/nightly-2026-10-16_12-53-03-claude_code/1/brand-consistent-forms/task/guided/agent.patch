+  <script>
+    const form = document.getElementById('subscribe-form');
+    const roast = document.getElementById('roast');
+    const roastOutput = document.getElementById('roast-output');
+    const progress = document.getElementById('setup-progress');
+    const progressText = document.getElementById('progress-text');
+    const status = document.getElementById('form-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+    let roastTouched = false;
+
+    function updateRoast() {
+      const name = roastNames[roast.value - 1];
+      roastOutput.textContent = name;
+      roast.setAttribute('aria-valuetext', name);
+      roast.style.setProperty('--fill', ((roast.value - roast.min) / (roast.max - roast.min)) * 100 + '%');
+    }
+
+    function updateProgress() {
+      const done = [form.elements.frequency.value !== '', roastTouched].filter(Boolean).length;
+      const percent = done * 50;
+      progress.value = percent;
+      progressText.textContent = percent === 100
+        ? '100% complete. You\'re ready to subscribe!'
+        : percent + '% complete. ' + (form.elements.frequency.value === ''
+          ? 'Choose a delivery frequency' + (roastTouched ? '.' : ' and roast level.')
+          : 'Adjust your roast level.');
+    }
+
+    roast.addEventListener('input', () => {
+      roastTouched = true;
+      updateRoast();
+      updateProgress();
+    });
+    form.addEventListener('change', updateProgress);
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (!roastTouched) {
+        roastTouched = true;
+        updateProgress();
+      }
+      status.textContent = 'Thanks! Your ' + form.elements.frequency.value + ' ' +
+        roastNames[roast.value - 1].toLowerCase() + ' roast subscription is set up' +
+        (form.elements['email-optin'].checked ? ", and we'll keep you posted by email." : '.');
+    });
+
+    updateRoast();
+    updateProgress();
+  </script>
 </body>
 
