+  <script>
+    (function () {
+      var form = document.getElementById('subscription-form');
+      var roast = document.getElementById('roast-level');
+      var roastOut = document.getElementById('roast-output');
+      var bar = document.getElementById('setup-progress');
+      var text = document.getElementById('progress-text');
+      var names = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      var roastTouched = false;
+
+      function update() {
+        roastOut.textContent = names[roast.value - 1];
+        roast.setAttribute('aria-valuetext', names[roast.value - 1]);
+        var done = 0;
+        if (form.elements.frequency.value) done++;
+        if (roastTouched) done++;
+        if (form.elements.email_optin.checked) done++;
+        bar.value = done;
+        bar.textContent = done + ' of 3 steps';
+        text.textContent = done === 3 ? 'All set! Ready to subscribe.' : done + ' of 3 steps complete';
+      }
+
+      roast.addEventListener('input', function () { roastTouched = true; update(); });
+      form.addEventListener('change', update);
+      update();
+    })();
+  </script>
+
