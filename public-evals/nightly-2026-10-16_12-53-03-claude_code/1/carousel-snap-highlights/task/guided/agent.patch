     .btn:hover {
       background: #3e2723;
     }
 
+    /* Seasonal Favorites carousel */
+    .carousel {
+      display: flex;
+      gap: 20px;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      /* Vertical room so the scaled-up card and its shadow aren't clipped */
+      padding: 40px calc(50% - 140px);
+      margin-top: 20px;
+    }
+
+    .carousel-item {
+      flex: 0 0 280px;
+      scroll-snap-align: center;
+      container-type: scroll-state;
+    }
+
+    .carousel .card {
+      height: 100%;
+      background: #e0e0e0;
+      box-shadow: none;
+      transition:
+        scale 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
+        background-color 0.4s,
+        color 0.4s,
+        box-shadow 0.4s;
+    }
+
+    .carousel .card h3 {
+      color: inherit;
+    }
+
+    /* Highlight only for users who haven't requested reduced motion */
+    @media (prefers-reduced-motion: no-preference) {
+      @container scroll-state(snapped: x) {
+        .carousel .card {
+          background: #007bff;
+          color: white;
+          scale: 1.15;
+          box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
+        }
+      }
+
+      /* JS fallback for browsers without scroll-state queries */
+      .carousel-item.is-snapped .card {
+        background: #007bff;
+        color: white;
+        scale: 1.15;
+        box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .carousel .card {
+        transition: none !important;
+        scale: 1 !important;
+      }
+    }
+
