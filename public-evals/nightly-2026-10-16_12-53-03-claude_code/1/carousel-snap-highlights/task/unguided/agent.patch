+  <script>
+    // Mark the card nearest the carousel's center as snapped.
+    document.querySelectorAll('.carousel').forEach(carousel => {
+      const cards = carousel.querySelectorAll('.card');
+      const update = () => {
+        const mid = carousel.getBoundingClientRect().left + carousel.clientWidth / 2;
+        let best = null, bestDist = Infinity;
+        cards.forEach(card => {
+          const r = card.parentElement.getBoundingClientRect();
+          const dist = Math.abs(r.left + r.width / 2 - mid);
+          if (dist < bestDist) { best = card; bestDist = dist; }
+        });
+        cards.forEach(card => card.classList.toggle('is-snapped', card === best));
+      };
+      let frame;
+      carousel.addEventListener('scroll', () => {
+        cancelAnimationFrame(frame);
+        frame = requestAnimationFrame(update);
+      }, { passive: true });
+      window.addEventListener('resize', update);
+      update();
+    });
+  </script>
