+    /* Smooth transitions to/from intrinsic sizes (Chrome/Edge; others jump instantly) */
+    :root {
+      interpolate-size: allow-keywords;
+    }
+
+    /* Promo alert */
+    #promo-alert {
+      background: var(--accent);
+      color: var(--text);
+      block-size: auto;
+      overflow: hidden;
+      transition: block-size 0.4s ease-in-out, opacity 0.4s ease-in-out,
+        visibility 0s 0.4s;
+    }
+
+    #promo-alert .promo-inner {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 1rem;
+      padding: 0.6rem 5%;
+      font-size: 0.9rem;
+    }
+
+    #alert-dismiss {
+      appearance: none;
+      flex: none;
+      inline-size: 1.75rem;
+      block-size: 1.75rem;
+      margin: 0;
+      border-radius: 50%;
+      cursor: pointer;
+      display: grid;
+      place-items: center;
+    }
+
+    #alert-dismiss::before {
+      content: "\00d7";
+      font-size: 1.4rem;
+      line-height: 1;
+    }
+
+    #alert-dismiss:hover {
+      background: rgba(0, 0, 0, 0.12);
+    }
+
+    #alert-dismiss:focus-visible {
+      outline: 2px solid var(--primary);
+    }
+
+    /* Dismissed: collapse to zero height, then hide from the accessibility tree */
+    #promo-alert:has(#alert-dismiss:checked) {
+      block-size: 0;
+      opacity: 0;
+      visibility: hidden;
+      pointer-events: none;
+    }
+
+    /* FAQ accordion */
+    .faq {
+      max-width: 700px;
+      margin: 60px auto 0;
+    }
+
+    .faq h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .faq details {
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    #faq-trigger {
+      cursor: pointer;
+      padding: 16px 20px;
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    #faq-trigger:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+      border-radius: 8px;
+    }
+
+    .faq details::details-content {
+      block-size: 0;
+      overflow: hidden;
+      transition: block-size 0.4s ease, content-visibility 0.4s allow-discrete;
+    }
+
+    .faq details[open]::details-content {
+      block-size: auto;
+    }
+
+    #faq-content {
+      padding: 0 20px 16px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      #promo-alert,
+      .faq details::details-content {
+        transition: none;
+      }
+    }
   </style>
