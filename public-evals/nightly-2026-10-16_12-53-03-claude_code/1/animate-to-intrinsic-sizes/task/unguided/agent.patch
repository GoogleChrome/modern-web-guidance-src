     .btn:hover {
       background: #3e2723;
     }
 
+    /* Promo alert: dismissed via a checkbox, collapsed by animating grid rows */
+    #promo-alert {
+      display: grid;
+      grid-template-rows: 1fr;
+      background: var(--accent);
+      color: var(--text);
+      transition: grid-template-rows 0.4s ease, opacity 0.3s ease;
+    }
+
+    #promo-alert:has(#alert-dismiss:checked) {
+      grid-template-rows: 0fr;
+      opacity: 0;
+    }
+
+    .promo-inner {
+      min-height: 0;
+      overflow: hidden;
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 1rem;
+      padding: 0 5%;
+      text-align: center;
+      font-size: 0.9rem;
+    }
+
+    .promo-inner p {
+      padding: 0.6rem 0;
+    }
+
+    #alert-dismiss {
+      appearance: none;
+      flex: none;
+      width: 1.75rem;
+      height: 1.75rem;
+      border-radius: 50%;
+      cursor: pointer;
+      display: grid;
+      place-items: center;
+      background: transparent;
+    }
+
+    #alert-dismiss::before {
+      content: "\00d7";
+      font-size: 1.5rem;
+      line-height: 1;
+    }
+
+    #alert-dismiss:hover {
+      background: rgba(0, 0, 0, 0.12);
+    }
+
+    #alert-dismiss:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    /* FAQ accordion: native <details>, animated with ::details-content */
+    :root {
+      interpolate-size: allow-keywords;
+    }
+
+    .faq {
+      max-width: 700px;
+      margin: 40px auto 0;
+    }
+
+    .faq h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .faq details {
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    #faq-trigger {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding: 16px 20px;
+      font-weight: 600;
+      color: var(--primary);
+      cursor: pointer;
+      list-style: none;
+    }
+
+    #faq-trigger::-webkit-details-marker {
+      display: none;
+    }
+
+    #faq-trigger::after {
+      content: "+";
+      font-size: 1.5rem;
+      line-height: 1;
+      transition: transform 0.35s ease;
+    }
+
+    details[open] #faq-trigger::after {
+      transform: rotate(135deg);
+    }
+
+    .faq details::details-content {
+      block-size: 0;
+      overflow: hidden;
+      transition: block-size 0.35s ease, content-visibility 0.35s allow-discrete;
+    }
+
+    .faq details[open]::details-content {
+      block-size: auto;
+    }
+
+    #faq-content {
+      padding: 0 20px 16px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      #promo-alert,
+      #faq-trigger::after,
+      .faq details::details-content {
+        transition: none;
+      }
+    }
+
     footer {
