@@ -206,7 +291,123 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const CALENDARS = [
+      { id: 'islamic-umalqura', name: 'Islamic (Umm al-Qura)', domId: 'islamic-date' },
+      { id: 'hebrew', name: 'Hebrew' },
+      { id: 'japanese', name: 'Japanese', era: true },
+    ];
+
+    const input = document.getElementById('calendar-date');
+    const status = document.getElementById('calendar-status');
+    const cards = document.getElementById('calendar-cards');
+
+    // Use native Temporal when present, otherwise load the polyfill on demand.
+    async function getTemporal() {
+      if (typeof Temporal !== 'undefined') return Temporal;
+      const module = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = module.Temporal;
+      return module.Temporal;
+    }
+
+    function isCalendarSupported(id) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(id);
+      } catch {
+        return false;
+      }
+    }
+
+    function el(tag, text, className) {
+      const node = document.createElement(tag);
+      if (text !== undefined) node.textContent = text;
+      if (className) node.className = className;
+      return node;
+    }
+
+    function buildCard(Temporal, iso, today, cal) {
+      const date = iso.withCalendar(cal.id);
+      const card = el('div', undefined, 'card calendar-card');
+      card.append(el('h3', cal.name));
+
+      const formatOptions = { day: 'numeric', month: 'long', year: 'numeric' };
+      if (cal.era) formatOptions.era = 'long';
+      const formatted = el('p', date.toLocaleString(`en-u-ca-${cal.id}`, formatOptions), 'formatted-date');
+      if (cal.domId) formatted.id = cal.domId;
+      card.append(formatted);
+
+      // Compare in the same calendar rather than field by field.
+      const order = Temporal.PlainDate.compare(date, today.withCalendar(cal.id));
+      const timeline = el('span', order < 0 ? 'Past' : order > 0 ? 'Future' : 'Today', 'timeline');
+
+      const facts = el('dl');
+      const addFact = (label, value) => {
+        const dd = el('dd');
+        dd.append(value);
+        facts.append(el('dt', label), dd);
+      };
+      addFact('Year', cal.era ? `${date.eraYear} (${date.era}), year ${date.year}` : String(date.year));
+      addFact('Month', `${date.month} (${date.monthCode})`);
+      addFact('Months in year', String(date.monthsInYear));
+      addFact('Timeline', timeline);
+      card.append(facts);
+
+      const table = el('table');
+      const head = table.createTHead().insertRow();
+      for (const label of ['#', 'Code', 'Days']) head.append(el('th', label));
+      const body = table.createTBody();
+      for (let m = 1; m <= date.monthsInYear; m++) {
+        const month = date.with({ month: m, day: 1 });
+        const row = body.insertRow();
+        if (m === date.month) row.className = 'current';
+        row.insertCell().textContent = m;
+        row.insertCell().textContent = month.monthCode;
+        row.insertCell().textContent = month.daysInMonth;
+      }
+      const details = el('details');
+      details.append(el('summary', 'Month breakdown'), table);
+      details.open = true;
+      card.append(details);
+      return card;
+    }
+
+    async function render() {
+      cards.replaceChildren();
+      status.textContent = '';
+      let Temporal;
+      try {
+        Temporal = await getTemporal();
+      } catch {
+        status.textContent = 'Calendar conversion is not available in this browser.';
+        return;
+      }
+      if (!input.value) {
+        status.textContent = 'Choose a date to convert.';
+        return;
+      }
+      const iso = Temporal.PlainDate.from(input.value);
+      const today = Temporal.Now.plainDateISO();
+      const unsupported = [];
+      for (const cal of CALENDARS) {
+        if (!isCalendarSupported(cal.id)) {
+          unsupported.push(cal.name);
+          continue;
+        }
+        cards.append(buildCard(Temporal, iso, today, cal));
+      }
+      if (unsupported.length) {
+        status.textContent = `Not supported by this browser: ${unsupported.join(', ')}.`;
+      }
+    }
+
+    input.addEventListener('input', render);
+    getTemporal().then((Temporal) => {
+      input.value = Temporal.Now.plainDateISO().toString();
+      render();
+    }).catch(render);
+  </script>
+
 </body>
 
