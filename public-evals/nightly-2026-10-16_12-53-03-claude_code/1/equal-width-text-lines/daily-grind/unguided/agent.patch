+  <script>
+    // Size each heading line so its text exactly fills the heading's width.
+    (function () {
+      var title = document.getElementById('hero-title');
+      var lines = title.querySelectorAll('.line');
+
+      function fit() {
+        var width = title.clientWidth;
+        lines.forEach(function (line) {
+          var text = line.firstElementChild;
+          line.style.fontSize = '100px';
+          var natural = text.getBoundingClientRect().width;
+          line.style.fontSize = (100 * width / natural) + 'px';
+        });
+      }
+
+      fit();
+      window.addEventListener('resize', fit);
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
+    })();
+  </script>
