+    <section aria-labelledby="prefs-heading" style="margin-top: 40px;">
+      <h2 id="prefs-heading" style="text-align: center;">Preferences</h2>
+      <div class="switch-row">
+        <div>
+          <div id="seasonal-label" class="switch-label">Seasonal drink alerts</div>
+          <div id="seasonal-desc" class="switch-desc">Email me when new seasonal favorites arrive.</div>
+        </div>
+        <button type="button" id="seasonal-switch" class="switch" role="switch" aria-checked="false"
+          aria-labelledby="seasonal-label" aria-describedby="seasonal-desc"></button>
+      </div>
+      <p id="seasonal-status" class="visually-hidden" role="status"></p>
