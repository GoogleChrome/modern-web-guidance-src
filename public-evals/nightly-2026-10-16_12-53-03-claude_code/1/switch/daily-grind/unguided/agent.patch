   </main>
 
+  <script>
+    (function () {
+      var sw = document.getElementById('seasonal-switch');
+      var status = document.getElementById('seasonal-status');
+      var key = 'seasonal-alerts';
+
+      function set(on, announce) {
+        sw.setAttribute('aria-checked', String(on));
+        try { localStorage.setItem(key, on ? '1' : '0'); } catch (e) { }
+        if (announce) status.textContent = 'Seasonal drink alerts ' + (on ? 'on' : 'off');
+      }
+
+      try { set(localStorage.getItem(key) === '1', false); } catch (e) { }
+
+      // <button> natively handles Space and Enter by firing click
+      sw.addEventListener('click', function () {
+        set(sw.getAttribute('aria-checked') !== 'true', true);
+      });
+    })();
+  </script>
+
