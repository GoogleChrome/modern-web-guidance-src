+    /* Switch */
+    .switch-row {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 20px;
+      max-width: 600px;
+      margin: 20px auto 0;
+      padding: 20px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .switch-label {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .switch-desc {
+      font-size: 0.9rem;
+    }
+
+    .switch {
+      flex-shrink: 0;
+      position: relative;
+      width: 52px;
+      height: 32px;
+      border: 2px solid var(--primary);
+      border-radius: 16px;
+      background: white;
+      cursor: pointer;
+      transition: background 0.2s;
+    }
+
+    .switch::after {
+      content: "";
+      position: absolute;
+      top: 3px;
+      left: 3px;
+      width: 22px;
+      height: 22px;
+      border-radius: 50%;
+      background: var(--primary);
+      transition: transform 0.2s, background 0.2s;
+    }
+
+    .switch[aria-checked="true"] {
+      background: var(--primary);
+    }
+
+    .switch[aria-checked="true"]::after {
+      transform: translateX(20px);
+      background: white;
+    }
+
+    .switch:focus-visible {
+      outline: 3px solid var(--text);
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .switch,
+      .switch::after {
+        transition: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .switch {
+        border-color: ButtonText;
+      }
+
+      .switch::after {
+        background: ButtonText;
+        forced-color-adjust: none;
+      }
+
+      .switch[aria-checked="true"] {
+        background: Highlight;
+      }
+
+      .switch[aria-checked="true"]::after {
+        background: HighlightText;
+      }
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
