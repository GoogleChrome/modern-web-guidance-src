+    /* Roast selector */
+    .roast-picker {
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      margin-top: 1.5rem;
+      font-weight: 600;
+    }
+
+    .roast-select,
+    .roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .roast-select {
+      min-width: 11rem;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 0.5rem;
+      background-color: var(--primary);
+      color: white;
+      border: 2px solid var(--accent);
+      border-radius: 6px;
+      padding: 0.5rem 0.9rem;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .roast-select:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .roast-select::picker-icon {
+      color: var(--accent);
+      transition: rotate 0.2s;
+    }
+
+    .roast-select:open::picker-icon {
+      rotate: 180deg;
+    }
+
+    .roast-select::picker(select) {
+      background-color: var(--primary);
+      border: 2px solid var(--accent);
+      border-radius: 6px;
+      padding: 0.25rem;
+      margin-top: 4px;
+    }
+
+    .roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 0.5rem;
+      padding: 0.5rem 0.75rem;
+      border-radius: 4px;
+      background-color: var(--primary);
+      color: white;
+      cursor: pointer;
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus-visible {
+      background-color: var(--accent);
+      color: var(--primary);
+    }
+
+    .roast-select option::checkmark {
+      color: var(--accent);
+    }
+
+    .roast-select option:hover::checkmark,
+    .roast-select option:focus-visible::checkmark {
+      color: var(--primary);
+    }
+
