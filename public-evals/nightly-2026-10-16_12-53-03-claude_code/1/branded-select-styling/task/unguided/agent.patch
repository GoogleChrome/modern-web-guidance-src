+  <script>
+    (function () {
+      const trigger = document.getElementById('roast-trigger');
+      const list = document.getElementById('roast-list');
+      const valueEl = document.getElementById('roast-value');
+      const options = Array.from(list.querySelectorAll('[role="option"]'));
+      let active = options.findIndex(o => o.getAttribute('aria-selected') === 'true');
+
+      function setActive(i) {
+        active = (i + options.length) % options.length;
+        options.forEach((o, n) => o.classList.toggle('active', n === active));
+        list.setAttribute('aria-activedescendant', options[active].id);
+      }
+
+      function open() {
+        list.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        setActive(options.findIndex(o => o.getAttribute('aria-selected') === 'true'));
+        list.focus();
+      }
+
+      function close(refocus) {
+        list.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        if (refocus) trigger.focus();
+      }
+
+      function select(i) {
+        options.forEach((o, n) => o.setAttribute('aria-selected', String(n === i)));
+        valueEl.textContent = options[i].textContent;
+        document.body.dataset.roast = options[i].dataset.value;
+        document.dispatchEvent(new CustomEvent('roastchange', { detail: options[i].dataset.value }));
+        close(true);
+      }
+
+      options.forEach((o, i) => {
+        o.id = 'roast-option-' + o.dataset.value;
+        o.addEventListener('click', () => select(i));
+        o.addEventListener('mousemove', () => setActive(i));
+      });
+
+      trigger.addEventListener('click', () => (list.hidden ? open() : close(true)));
+
+      list.addEventListener('keydown', e => {
+        const keys = {
+          ArrowDown: () => setActive(active + 1),
+          ArrowUp: () => setActive(active - 1),
+          Home: () => setActive(0),
+          End: () => setActive(options.length - 1),
+          Enter: () => select(active),
+          ' ': () => select(active),
+          Escape: () => close(true),
+          Tab: () => close(false)
+        };
+        if (keys[e.key]) {
+          if (e.key !== 'Tab') e.preventDefault();
+          keys[e.key]();
+        }
+      });
+
+      document.addEventListener('click', e => {
+        if (!list.hidden && !e.target.closest('.roast-dropdown')) close(false);
+      });
+    })();
+  </script>
 </body>
 
