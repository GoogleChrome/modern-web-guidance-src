+  <script>
+    // Interest is triggered declaratively via the interestfor attribute; this single
+    // delegated listener only reflects the interest state into the preview box.
+    (() => {
+      const preview = document.getElementById('seasonal-preview');
+      const idle = preview.textContent;
+      document.addEventListener('interest', (e) => {
+        const { drink, color } = e.target.dataset;
+        if (!drink) return;
+        preview.textContent = drink;
+        preview.style.setProperty('--drink-color', color);
+        preview.setAttribute('data-active', '');
+      }, true);
+      document.addEventListener('loseinterest', (e) => {
+        if (!e.target.dataset.drink) return;
+        preview.textContent = idle;
+        preview.removeAttribute('data-active');
+      }, true);
+    })();
+  </script>
+
