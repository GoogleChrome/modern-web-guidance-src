+  <script>
+    // Each form navigates client-side and reports the outcome to an invoking agent.
+    const destinations = { 'navigate-form': 'page', 'drink-form': 'drink', 'logout-form': null };
+
+    for (const [id, field] of Object.entries(destinations)) {
+      document.getElementById(id).addEventListener('submit', (event) => {
+        event.preventDefault();
+        const path = field ? new FormData(event.target).get(field) : '/logout';
+        if (event.agentInvoked) {
+          event.respondWith(Promise.resolve(`Navigating to ${path}`));
+        }
+        location.assign(path);
+      });
+    }
+  </script>
