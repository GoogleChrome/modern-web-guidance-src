diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..37c07fa
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,56 @@
+import { useEffect, useRef } from 'react';
+
+export interface WebMcpTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations?: { readOnlyHint?: boolean };
+  execute: (input: any) => Promise<string>;
+}
+
+interface ModelContext {
+  registerTool: (tool: unknown) => unknown;
+  unregisterTool?: (name: string) => void;
+}
+
+export const textResult = (text: string) => ({ content: [{ type: 'text', text }] });
+
+/**
+ * Exposes a tool to in-browser AI agents via WebMCP (navigator.modelContext)
+ * for as long as the calling component is mounted. No-op where unsupported.
+ * The latest `execute` is always used, so it may close over component state.
+ */
+export function useWebMcpTool(tool: WebMcpTool) {
+  const executeRef = useRef(tool.execute);
+  executeRef.current = tool.execute;
+
+  useEffect(() => {
+    const modelContext = (navigator as unknown as { modelContext?: ModelContext }).modelContext;
+    if (!modelContext?.registerTool) return;
+
+    const controller = new AbortController();
+    try {
+      modelContext.registerTool({
+        name: tool.name,
+        description: tool.description,
+        inputSchema: tool.inputSchema,
+        annotations: tool.annotations,
+        execute: async (input: unknown) => {
+          try {
+            return textResult(await executeRef.current(input));
+          } catch (err) {
+            return { ...textResult(`Error: ${err instanceof Error ? err.message : String(err)}`), isError: true };
+          }
+        },
+      }, { signal: controller.signal });
+    } catch (err) {
+      console.error(`Failed to register WebMCP tool ${tool.name}:`, err);
+      return;
+    }
+
+    return () => {
+      controller.abort();
+      modelContext.unregisterTool?.(tool.name);
+    };
+  }, [tool.name]);
+}
