diff --git a/src/components/ConsentBanner.astro b/src/components/ConsentBanner.astro
new file mode 100644
index 0000000..6700a7e
--- /dev/null
+++ b/src/components/ConsentBanner.astro
@@ -0,0 +1,56 @@
+---
+// Analytics is a third-party script, so it is off by default and only loaded after
+// an explicit opt-in. Browsers sending Do Not Track / Global Privacy Control are
+// treated as opted out and never see the prompt.
+---
+
+<div
+  id="consent-banner"
+  transition:persist
+  hidden
+  role="region"
+  aria-label="Privacy choices"
+  class="fixed bottom-0 inset-x-0 z-50 bg-gray-900 text-white p-4 text-sm"
+>
+  <div class="max-w-6xl mx-auto flex flex-wrap items-center gap-4 justify-between">
+    <p class="max-w-3xl">
+      We'd like to use a third-party analytics service to understand how the site is used.
+      It is off unless you agree. See our <a class="underline" href={`${import.meta.env.BASE_URL}legal/privacy`}>privacy policy</a>.
+    </p>
+    <div class="flex gap-2">
+      <button type="button" data-consent="denied" class="px-4 py-2 border border-white rounded-md">Decline</button>
+      <button type="button" data-consent="granted" class="px-4 py-2 bg-white text-gray-900 rounded-md">Accept</button>
+    </div>
+  </div>
+</div>
+
+<script>
+  const KEY = 'analytics-consent';
+  const SRC =
+    'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+  const banner = document.getElementById('consent-banner');
+  const optedOut =
+    (navigator as any).globalPrivacyControl === true || navigator.doNotTrack === '1';
+
+  const load = () => {
+    if (document.querySelector(`script[src="${SRC}"]`)) return;
+    const s = document.createElement('script');
+    s.src = SRC;
+    s.defer = true;
+    s.referrerPolicy = 'origin';
+    document.head.append(s);
+  };
+
+  const stored = optedOut ? 'denied' : localStorage.getItem(KEY);
+  if (stored === 'granted') load();
+  else if (!stored && banner) banner.hidden = false;
+
+  banner?.addEventListener('click', (e) => {
+    const choice = (e.target as HTMLElement).closest<HTMLElement>('[data-consent]')?.dataset
+      .consent;
+    if (!choice) return;
+    localStorage.setItem(KEY, choice);
+    banner.hidden = true;
+    if (choice === 'granted') load();
+  });
+</script>
