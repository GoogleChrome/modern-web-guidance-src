@@ -134,8 +134,95 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Product carousel */
+    .carousel-section {
+      --card-width: min(280px, 70vw);
+      margin-top: 60px;
+    }
+
+    .carousel-section h2 {
+      text-align: center;
+    }
+
+    .scroller {
+      display: flex;
+      gap: 24px;
+      list-style: none;
+      overflow-x: auto;
+      /* Let the first and last cards reach the center */
+      padding: 40px calc(50% - var(--card-width) / 2);
+      scroll-snap-type: x mandatory;
+      scroll-padding-inline: calc(50% - var(--card-width) / 2);
+      overscroll-behavior-x: contain;
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    .product-card {
+      flex: 0 0 var(--card-width);
+      scroll-snap-align: center;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
+      overflow: hidden;
+      text-align: center;
+    }
+
+    .product-card img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .product-card .body {
+      padding: 16px 20px 20px;
+    }
+
+    .product-card h3 {
+      color: var(--primary);
+    }
+
+    .product-card .price {
+      font-weight: bold;
+      margin-top: 4px;
+    }
+
+    .product-card .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Scale cards up toward the center of the scroller and down as they leave.
+       Purely decorative, so unsupported browsers simply show unscaled cards. */
+    @keyframes center-scale {
+      0% {
+        scale: 0.75;
+      }
+
+      50% {
+        scale: 1;
+      }
+
+      100% {
+        scale: 0.75;
+      }
+    }
+
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      @media (prefers-reduced-motion: no-preference) {
+        .product-card {
+          animation: center-scale auto linear both;
+          animation-timeline: view(inline);
+        }
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
