+    /* Product carousel */
+    .carousel-heading {
+      text-align: center;
+      margin-top: 60px;
+    }
+
+    .scroller {
+      --card-width: min(280px, 70vw);
+      display: flex;
+      gap: 24px;
+      list-style: none;
+      overflow-x: auto;
+      /* Pad so the first and last cards can reach the center */
+      padding: 40px calc(50% - var(--card-width) / 2);
+      scroll-snap-type: x mandatory;
+      scroll-padding-inline: calc(50% - var(--card-width) / 2);
+      overscroll-behavior-x: contain;
+    }
+
+    .scroller:focus-visible,
+    .product-card a:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .product-card {
+      flex: 0 0 var(--card-width);
+      scroll-snap-align: center;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
+      overflow: hidden;
+      text-align: center;
+    }
+
+    .product-card img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .product-card .body {
+      padding: 16px 20px 20px;
+    }
+
+    .product-card h3 {
+      color: var(--primary);
+    }
+
+    .product-card .price {
+      font-weight: bold;
+      margin-top: 4px;
+    }
+
+    /* Scale cards based on their position within the scroller (no JS) */
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .product-card {
+          animation: card-focus linear both;
+          animation-timeline: view(inline);
+        }
+      }
+    }
+
+    @keyframes card-focus {
+      0%, 100% {
+        transform: scale(0.8);
+        opacity: 0.7;
+      }
+
+      50% {
+        transform: scale(1.1);
+        opacity: 1;
+      }
+    }
   </style>
