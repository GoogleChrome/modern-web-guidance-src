+  <script>
+    (() => {
+      const panel = document.querySelector('.seasonal-panel');
+      const links = [...document.querySelectorAll('.toc-sidebar a')];
+      const sections = [...panel.querySelectorAll('.drink-section')];
+
+      const setActive = (id) => {
+        links.forEach((link) => {
+          const active = link.getAttribute('href') === `#${id}`;
+          link.classList.toggle('is-active', active);
+          if (active) link.setAttribute('aria-current', 'true');
+          else link.removeAttribute('aria-current');
+        });
+      };
+
+      setActive(sections[0].id);
+
+      if ('onscrollsnapchange' in HTMLElement.prototype) {
+        panel.addEventListener('scrollsnapchange', (event) => {
+          const section = event.snapTargetBlock?.closest('.drink-section');
+          if (section) setActive(section.id);
+        });
+      } else {
+        // Fallback: track the section crossing the top of the panel.
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) setActive(entry.target.id);
+          });
+        }, { root: panel, rootMargin: '0px 0px -60% 0px', threshold: 0 });
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      links.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          event.preventDefault();
+          const target = document.getElementById(link.getAttribute('href').slice(1));
+          const top = target.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop;
+          // Smooth scrolling comes from CSS scroll-behavior (disabled for reduced motion).
+          panel.scrollTo({ top });
+          setActive(target.id);
+        });
+      });
+    })();
+  </script>
+
