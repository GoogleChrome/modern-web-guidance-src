+  <script>
+    (function () {
+      var panel = document.querySelector('.seasonal-panel');
+      var links = Array.prototype.slice.call(document.querySelectorAll('.toc-sidebar a'));
+      var sections = links.map(function (l) {
+        return document.getElementById(l.getAttribute('href').slice(1));
+      });
+      if (!panel || !links.length) return;
+
+      function setActive(index) {
+        links.forEach(function (link, i) {
+          if (i === index) link.setAttribute('aria-current', 'true');
+          else link.removeAttribute('aria-current');
+        });
+      }
+
+      // Active section = the one whose top is closest to the panel's top edge.
+      function update() {
+        var top = panel.getBoundingClientRect().top;
+        var best = 0, bestDist = Infinity;
+        sections.forEach(function (sec, i) {
+          var dist = Math.abs(sec.getBoundingClientRect().top - top);
+          if (dist < bestDist) { best = i; bestDist = dist; }
+        });
+        setActive(best);
+      }
+
+      var ticking = false;
+      panel.addEventListener('scroll', function () {
+        if (ticking) return;
+        ticking = true;
+        requestAnimationFrame(function () { ticking = false; update(); });
+      }, { passive: true });
+
+      links.forEach(function (link, i) {
+        link.addEventListener('click', function (e) {
+          e.preventDefault();
+          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          panel.scrollTo({
+            top: sections[i].offsetTop,
+            behavior: reduce ? 'auto' : 'smooth'
+          });
+          setActive(i);
+        });
+      });
+
+      update();
+    })();
+  </script>
+
