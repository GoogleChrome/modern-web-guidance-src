+  </div>
+
+  <script>
+    (function () {
+      var backdrop = document.getElementById('logout-backdrop');
+      var openBtn = document.getElementById('open-dialog-btn');
+      var closeBtn = document.getElementById('close-dialog-btn');
+      var overlay = document.getElementById('info-overlay');
+      var foobar = document.getElementById('foobar');
+      var overlayClose = document.getElementById('info-overlay-close');
+
+      function setOpen(el, open) {
+        el.classList.toggle('is-open', open);
+        el.setAttribute('aria-hidden', String(!open));
+      }
+
+      openBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        setOpen(backdrop, true);
+        closeBtn.focus();
+      });
+
+      function closeModal() {
+        setOpen(backdrop, false);
+        openBtn.focus();
+      }
+
+      closeBtn.addEventListener('click', closeModal);
+      backdrop.addEventListener('click', function (e) {
+        if (e.target === backdrop) closeModal();
+      });
+
+      foobar.addEventListener('click', function () {
+        setOpen(overlay, true);
+      });
+      overlayClose.addEventListener('click', function () {
+        setOpen(overlay, false);
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key !== 'Escape') return;
+        if (backdrop.classList.contains('is-open')) closeModal();
+        else setOpen(overlay, false);
+      });
+    })();
+  </script>
+
