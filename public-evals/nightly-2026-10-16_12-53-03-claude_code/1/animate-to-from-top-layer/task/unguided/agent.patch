+  <div class="modal-backdrop" id="logout-backdrop" aria-hidden="true">
+    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="logout-title">
+      <button type="button" class="modal-close" id="close-dialog-btn" aria-label="Close">&times;</button>
+      <h2 id="logout-title">Log out?</h2>
