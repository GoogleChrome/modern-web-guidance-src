@@ -0,0 +1,239 @@
+/*
+ * The Daily Grind
+ *
+ * Architecture:
+ *   1. @layer order declares the cascade up front; later layers win
+ *      regardless of selector specificity or source order.
+ *   2. Design tokens live in `tokens` (primitives -> semantic aliases).
+ *   3. `reset` and `base` use :where() so they carry zero specificity.
+ *   4. `layout` holds reusable structural primitives.
+ *   5. `components` are scoped with @scope so selectors stay short and
+ *      cannot leak outside their root.
+ */
+@layer tokens, reset, base, layout, components, utilities;
+
+/* ---------- Tokens ---------- */
+@layer tokens {
+  :root {
+    /* Primitives */
+    --color-espresso-900: #3e2723;
+    --color-espresso-700: #4e342e;
+    --color-latte-200: #d7ccc8;
+    --color-amber-400: #ffab40;
+    --color-snow-50: #fafafa;
+    --color-white: #fff;
+    --color-black: #000;
+
+    /* Semantic colors */
+    --color-primary: var(--color-espresso-700);
+    --color-primary-strong: var(--color-espresso-900);
+    --color-secondary: var(--color-latte-200);
+    --color-accent: var(--color-amber-400);
+    --color-text: var(--color-espresso-900);
+    --color-text-inverse: var(--color-white);
+    --color-surface: var(--color-white);
+    --color-background: var(--color-snow-50);
+    --color-overlay: rgb(0 0 0 / 0.5);
+    --color-shadow: rgb(0 0 0 / 0.1);
+
+    /* Typography */
+    --font-sans: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
+    --text-xs: 0.85rem;
+    --text-sm: 0.9rem;
+    --text-xl: 1.5rem;
+    --text-hero: 3rem;
+    --leading-normal: 1.6;
+    --tracking-wide: 1px;
+
+    /* Spacing */
+    --space-1: 0.3125rem;
+    --space-2: 0.625rem;
+    --space-3: 0.9375rem;
+    --space-4: 1.25rem;
+    --space-5: 2.5rem;
+    --space-gutter: 5%;
+
+    /* Shape, elevation, motion, layering */
+    --radius-sm: 4px;
+    --radius-md: 5px;
+    --radius-lg: 8px;
+    --shadow-card: 0 2px 5px var(--color-shadow);
+    --duration-base: 0.3s;
+    --z-nav: 1000;
+
+    /* Layout */
+    --container-max: 1100px;
+    --card-min: 250px;
+    --hero-height: 60vh;
+  }
+}
+
+/* ---------- Reset ---------- */
+@layer reset {
+  :where(*, *::before, *::after) {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+  }
+
+  :where(ul, ol) {
+    list-style: none;
+  }
+
+  :where(a) {
+    color: inherit;
+    text-decoration: none;
+  }
+}
+
+/* ---------- Base (element defaults) ---------- */
+@layer base {
+  :where(body) {
+    font-family: var(--font-sans);
+    line-height: var(--leading-normal);
+    color: var(--color-text);
+    background-color: var(--color-background);
+  }
+}
+
+/* ---------- Layout primitives ---------- */
+@layer layout {
+  .container {
+    max-inline-size: var(--container-max);
+    margin-block: var(--space-5);
+    margin-inline: auto;
+    padding-inline: var(--space-4);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(var(--card-min), 1fr));
+    gap: var(--space-4);
+    margin-block-start: var(--space-4);
+  }
+}
+
+/* ---------- Components ---------- */
+@layer components {
+  /* Button: standalone, reusable anywhere */
+  .btn {
+    display: inline-block;
+    background: var(--color-primary);
+    color: var(--color-text-inverse);
+    padding: var(--space-2) var(--space-4);
+    border-radius: var(--radius-md);
+    margin-block-start: var(--space-3);
+    transition: background var(--duration-base);
+
+    &:hover {
+      background: var(--color-primary-strong);
+    }
+  }
+
+  @scope (.site-nav) {
+    :scope {
+      background: var(--color-primary);
+      color: var(--color-text-inverse);
+      padding: var(--space-3) var(--space-gutter);
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      inset-block-start: 0;
+      z-index: var(--z-nav);
+    }
+
+    .logo {
+      font-size: var(--text-xl);
+      font-weight: bold;
+      letter-spacing: var(--tracking-wide);
+    }
+
+    ul {
+      display: flex;
+    }
+
+    li {
+      margin-inline-start: var(--space-4);
+    }
+
+    a {
+      font-size: var(--text-sm);
+      transition: color var(--duration-base);
+
+      &:hover {
+        color: var(--color-accent);
+      }
+    }
+
+    .logout-link {
+      border: 1px solid var(--color-accent);
+      padding: var(--space-1) 12px;
+      border-radius: var(--radius-sm);
+    }
+  }
+
+  @scope (.hero) {
+    :scope {
+      block-size: var(--hero-height);
+      background:
+        linear-gradient(var(--color-overlay), var(--color-overlay)),
+        url("https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80");
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: var(--color-text-inverse);
+      text-align: center;
+      padding-inline: var(--space-4);
+    }
+
+    h1 {
+      font-size: var(--text-hero);
+      margin-block-end: var(--space-3);
+    }
+  }
+
+  /* Cards: scope stops at nested cards' own content boundaries */
+  @scope (.card) {
+    :scope {
+      background: var(--color-surface);
+      padding: var(--space-4);
+      border-radius: var(--radius-lg);
+      box-shadow: var(--shadow-card);
+      text-align: center;
+    }
+
+    h3 {
+      margin-block-end: var(--space-2);
+      color: var(--color-primary);
+    }
+  }
+
+  @scope (.site-footer) {
+    :scope {
+      background: var(--color-secondary);
+      text-align: center;
+      padding: var(--space-5) var(--space-4);
+      margin-block-start: var(--space-5);
+    }
+
+    .footer-links {
+      margin-block-end: var(--space-4);
+
+      a {
+        margin-inline: var(--space-2);
+        font-size: var(--text-xs);
+      }
+    }
+  }
+}
+
+/* ---------- Utilities (highest priority, single purpose) ---------- */
+@layer utilities {
+  .text-center {
+    text-align: center;
+  }
+}
