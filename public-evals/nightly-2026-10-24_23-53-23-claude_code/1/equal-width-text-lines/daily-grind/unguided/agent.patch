+<script>
+    // Size each heading line's font so its text width equals the heading width.
+    function fitHeroLines() {
+      document.querySelectorAll('.hero h1').forEach(h1 => {
+        const target = h1.clientWidth;
+        h1.querySelectorAll('.line').forEach(line => {
+          line.style.fontSize = '100px';
+          const probe = document.createElement('span');
+          probe.style.display = 'inline-block';
+          probe.append(...line.childNodes);
+          line.append(probe);
+          const w = probe.getBoundingClientRect().width;
+          line.append(...probe.childNodes);
+          probe.remove();
+          line.style.fontSize = (100 * target / w) + 'px';
+        });
+      });
+    }
+    fitHeroLines();
+    window.addEventListener('resize', fitHeroLines);
+    if (document.fonts) document.fonts.ready.then(fitHeroLines);
+  </script>
+
