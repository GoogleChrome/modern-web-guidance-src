+    /* Vertical media scroller */
+    .media-scroll {
+      position: relative; /* makes child offsetTop relative to the scroller */
+      height: 480px;
+      max-width: 440px;
+      margin: 20px auto 0;
+      overflow-y: auto;
+      scroll-behavior: auto; /* never animate the initial positioning */
+      scroll-snap-type: y mandatory;
+      display: flex;
+      flex-direction: column;
+      gap: 20px;
+      padding: 20px;
+      background: var(--secondary);
+      border-radius: 8px;
+    }
+
+    .media-card {
+      flex: 0 0 auto;
+      scroll-snap-align: start;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: hidden;
+    }
+
+    .media-card img {
+      display: block;
+      width: 400px;
+      max-width: 100%;
+      height: 240px;
+      object-fit: cover;
+    }
+
+    .media-card .media-body {
+      padding: 15px 20px;
+    }
