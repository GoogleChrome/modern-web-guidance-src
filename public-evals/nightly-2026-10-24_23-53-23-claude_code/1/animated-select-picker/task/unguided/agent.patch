+    /* Store picker */
+    .store-select {
+      margin-top: 1.5rem;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 6px;
+    }
+
+    .store-select label {
+      font-size: 0.85rem;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+    }
+
+    .store-select select {
+      min-width: 260px;
+      padding: 10px 14px;
+      font: inherit;
+      color: var(--text);
+      background: white;
+      border: 2px solid var(--accent);
+      border-radius: 6px;
+      cursor: pointer;
+    }
+
+    /* Customizable select: lets us style and animate the native picker */
+    @supports (appearance: base-select) {
+
+      .store-select select,
+      .store-select select::picker(select) {
+        appearance: base-select;
+      }
+
+      .store-select select {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 12px;
+        text-align: left;
+      }
+
+      .store-select select::picker-icon {
+        content: '';
+        width: 8px;
+        height: 8px;
+        border-right: 2px solid var(--primary);
+        border-bottom: 2px solid var(--primary);
+        transform: translateY(-2px) rotate(45deg);
+        transition: transform 0.3s ease;
+      }
+
+      .store-select select:open::picker-icon {
+        transform: translateY(2px) rotate(-135deg);
+      }
+
+      .store-select select::picker(select) {
+        margin-top: 6px;
+        padding: 4px;
+        border: 2px solid var(--accent);
+        border-radius: 6px;
+        background: white;
+        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+        opacity: 0;
+        transform: translateY(-8px);
+        transition: opacity 0.25s ease, transform 0.25s ease,
+          overlay 0.25s allow-discrete, display 0.25s allow-discrete;
+      }
+
+      .store-select select:open::picker(select) {
+        opacity: 1;
+        transform: translateY(0);
+      }
+
+      @starting-style {
+        .store-select select:open::picker(select) {
+          opacity: 0;
+          transform: translateY(-8px);
+        }
+      }
+
+      .store-select option {
+        padding: 8px 12px;
+        border-radius: 4px;
+        text-align: left;
+        transition: background 0.2s;
+      }
+
+      .store-select option:hover,
+      .store-select option:focus {
+        background: var(--secondary);
+      }
+
+      .store-select option::checkmark {
+        color: var(--accent);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .store-select select::picker-icon,
+      .store-select select::picker(select) {
+        transition-duration: 0.01s;
+      }
+    }
+
