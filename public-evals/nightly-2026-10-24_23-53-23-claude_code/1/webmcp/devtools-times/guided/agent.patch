diff --git a/src/utils/readingList.ts b/src/utils/readingList.ts
new file mode 100644
index 0000000..c7c9398
--- /dev/null
+++ b/src/utils/readingList.ts
@@ -0,0 +1,26 @@
+export const READING_LIST_CHANGED = 'reading-list-changed';
+
+const endpoint = () => `${import.meta.env.BASE_URL}api/reading-list.json`;
+
+export async function fetchReadingList(signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(endpoint(), { signal });
+  const data = await response.json();
+  return data.readingList;
+}
+
+// The API toggles a slug; this makes add/remove idempotent.
+export async function setInReadingList(slug: string, present: boolean, signal?: AbortSignal): Promise<string[]> {
+  const current = await fetchReadingList(signal);
+  if (current.includes(slug) === present) {
+    return current;
+  }
+  const response = await fetch(endpoint(), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+    signal,
+  });
+  const data = await response.json();
+  window.dispatchEvent(new CustomEvent(READING_LIST_CHANGED, { detail: data.readingList }));
+  return data.readingList;
+}
