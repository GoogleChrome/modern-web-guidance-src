@@ -0,0 +1,94 @@
+import { useWebMCP } from 'use-webmcp-tool';
+
+interface RelatedArticle {
+  slug: string;
+  title: string;
+}
+
+interface Props {
+  slug: string;
+  title: string;
+  related: RelatedArticle[];
+}
+
+const WORDS_PER_MINUTE = 200;
+
+const articleBody = () => document.querySelector<HTMLElement>('article .prose')?.innerText.trim() ?? '';
+const countWords = (text: string) => (text.match(/\S+/g) ?? []).length;
+
+// Client-side utilities that work on the article currently on screen.
+export default function ArticleWebMCP({ slug, title, related }: Props) {
+  const base = import.meta.env.BASE_URL;
+
+  useWebMCP({
+    name: 'get-article-text',
+    description: 'Returns the full body text of the article currently open. Use to read or summarize it.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    execute: () => {
+      const text = articleBody();
+      return text ? { slug, title, text } : { error: 'Article body not found on this page.' };
+    },
+  });
+
+  useWebMCP({
+    name: 'get-article-reading-time',
+    description: 'Estimates how long the article currently open takes to read.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    execute: () => {
+      const words = countWords(articleBody());
+      return { words, minutes: Math.max(1, Math.ceil(words / WORDS_PER_MINUTE)) };
+    },
+  });
+
+  useWebMCP({
+    name: 'get-article-details',
+    description: 'Returns the headline, author, date, category and summary of the article currently open.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    execute: () => {
+      const text = (selector: string) => document.querySelector(`article ${selector}`)?.textContent?.trim() ?? null;
+      return {
+        slug,
+        title,
+        category: text('a[href*="category/"]'),
+        summary: text('h1 + p'),
+        byline: text('.border-b.pb-5'),
+      };
+    },
+  });
+
+  useWebMCP({
+    name: 'get-related-articles',
+    description: 'Lists articles related to the one currently open.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    execute: () => ({
+      articles: related.map(r => ({ ...r, url: `${base}articles/${r.slug}` })),
+    }),
+  });
+
+  useWebMCP<{ phrase: string }>({
+    name: 'find-in-article',
+    description: 'Finds passages in the article currently open that mention a phrase, with surrounding context.',
+    inputSchema: {
+      type: 'object',
+      properties: { phrase: { type: 'string', description: 'Text to look for, case-insensitive.' } },
+      required: ['phrase'],
+    },
+    annotations: { readOnlyHint: true },
+    execute: ({ phrase }) => {
+      if (typeof phrase !== 'string' || !phrase.trim()) {
+        return { error: 'Provide a non-empty phrase to look for.' };
+      }
+      const needle = phrase.trim().toLowerCase();
+      const matches = articleBody()
+        .split(/\n+/)
+        .filter(paragraph => paragraph.toLowerCase().includes(needle));
+      return { phrase, count: matches.length, passages: matches };
+    },
+  });
+
+  return null;
+}
