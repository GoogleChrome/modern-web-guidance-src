--- a/index.html
+++ b/index.html
@@ -207,6 +207,114 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // WebMCP: expose site functionality as tools to AI agents (https://webmachinelearning.github.io/webmcp/)
+    (function () {
+      if (!('modelContext' in navigator) || typeof navigator.modelContext.registerTool !== 'function') return;
+
+      const text = (value) => ({
+        content: [{ type: 'text', text: typeof value === 'string' ? value : JSON.stringify(value) }]
+      });
+      const error = (message) => ({ ...text(message), isError: true });
+
+      const PAGES = {
+        menu: '/menu',
+        locations: '/locations',
+        rewards: '/rewards',
+        account: '/account',
+        'order-online': '/order-online',
+        about: '/about',
+        careers: '/careers',
+        contact: '/contact',
+        'privacy-policy': '/privacy-policy'
+      };
+
+      // Read the seasonal favorites straight from the page so tools never drift from the UI.
+      function getDrinks() {
+        return Array.from(document.querySelectorAll('.grid .card')).map((card) => {
+          const link = card.querySelector('a');
+          const href = link ? link.getAttribute('href') : null;
+          return {
+            id: href ? href.split('/').pop() : null,
+            name: card.querySelector('h3')?.textContent.trim(),
+            description: card.querySelector('p')?.textContent.trim(),
+            url: href
+          };
+        });
+      }
+
+      const tools = [
+        {
+          name: 'list_seasonal_favorites',
+          description: 'List the seasonal favorite drinks featured on The Daily Grind home page, with id, name, description and detail page URL.',
+          inputSchema: { type: 'object', properties: {} },
+          annotations: { readOnlyHint: true },
+          execute: async () => text(getDrinks())
+        },
+        {
+          name: 'view_drink_details',
+          description: 'Open the detail page for a seasonal favorite drink. Use list_seasonal_favorites to find valid ids.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              id: { type: 'string', description: 'Drink id, e.g. "seasonal", "espresso" or "cold-brew".' }
+            },
+            required: ['id']
+          },
+          execute: async ({ id }) => {
+            const drink = getDrinks().find((d) => d.id === id);
+            if (!drink) return error('Unknown drink id: ' + id);
+            window.location.href = drink.url;
+            return text('Navigating to details for ' + drink.name + ' (' + drink.url + ').');
+          }
+        },
+        {
+          name: 'navigate_to_page',
+          description: 'Navigate to a page of The Daily Grind website.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              page: { type: 'string', enum: Object.keys(PAGES), description: 'Destination page.' }
+            },
+            required: ['page']
+          },
+          execute: async ({ page }) => {
+            if (!PAGES[page]) return error('Unknown page: ' + page);
+            window.location.href = PAGES[page];
+            return text('Navigating to ' + PAGES[page] + '.');
+          }
+        },
+        {
+          name: 'start_order',
+          description: 'Start an online order by going to the order page (same as the "Order Now" button).',
+          inputSchema: { type: 'object', properties: {} },
+          execute: async () => {
+            window.location.href = '/order-online';
+            return text('Navigating to /order-online.');
+          }
+        },
+        {
+          name: 'log_out',
+          description: 'Log the current user out of their account. Confirm with the user before calling.',
+          inputSchema: { type: 'object', properties: {} },
+          annotations: { destructiveHint: true },
+          execute: async () => {
+            window.location.href = '/logout';
+            return text('Logging out.');
+          }
+        }
+      ];
+
+      for (const tool of tools) {
+        try {
+          navigator.modelContext.registerTool(tool);
+        } catch (e) {
+          console.warn('WebMCP: failed to register ' + tool.name, e);
+        }
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
