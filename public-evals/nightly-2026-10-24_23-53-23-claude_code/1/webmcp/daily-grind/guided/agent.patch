diff --git a/index.html b/index.html
index 66c9173..72ea2a7 100644
--- a/index.html
+++ b/index.html
@@ -207,6 +207,82 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // WebMCP: expose page functionality to AI agents (no-op where unsupported).
+    if ('modelContext' in document) {
+      const controller = new AbortController();
+      const { signal } = controller;
+      addEventListener('pagehide', () => controller.abort(), { once: true });
+
+      const PAGES = {
+        menu: '/menu',
+        locations: '/locations',
+        rewards: '/rewards',
+        account: '/account',
+        order_online: '/order-online',
+        our_story: '/about',
+        careers: '/careers',
+        contact: '/contact',
+        privacy_policy: '/privacy-policy',
+      };
+
+      const seasonalItems = () =>
+        [...document.querySelectorAll('.card')].map((card) => ({
+          name: card.querySelector('h3').textContent.trim(),
+          description: card.querySelector('p').textContent.trim(),
+          url: new URL(card.querySelector('a').getAttribute('href'), location.href).href,
+        }));
+
+      document.modelContext.registerTool({
+        name: 'list-seasonal-favorites',
+        description: 'Lists the seasonal favorite drinks featured on the home page. Use when the user asks what is on offer or wants a recommendation.',
+        inputSchema: { type: 'object', properties: {} },
+        execute: () => ({ items: seasonalItems() }),
+        annotations: { readOnlyHint: true },
+      }, { signal });
+
+      document.modelContext.registerTool({
+        name: 'view-drink-details',
+        description: 'Opens the details page for a seasonal favorite drink.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: { type: 'string', description: 'Name of the drink, as returned by list-seasonal-favorites.' },
+          },
+          required: ['name'],
+        },
+        execute({ name } = {}) {
+          const items = seasonalItems();
+          const item = typeof name === 'string' &&
+            items.find((i) => i.name.toLowerCase() === name.trim().toLowerCase());
+          if (!item) {
+            return { error: `Drink "${name}" not found.`, availableDrinks: items.map((i) => i.name) };
+          }
+          location.href = item.url;
+          return { navigatingTo: item.url };
+        },
+      }, { signal });
+
+      document.modelContext.registerTool({
+        name: 'navigate-to-page',
+        description: 'Navigates the browser to a section of The Daily Grind site.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            page: { type: 'string', enum: Object.keys(PAGES), description: 'Destination page.' },
+          },
+          required: ['page'],
+        },
+        execute({ page } = {}) {
+          if (!Object.hasOwn(PAGES, page)) {
+            return { error: `Unknown page "${page}".`, availablePages: Object.keys(PAGES) };
+          }
+          location.href = PAGES[page];
+          return { navigatingTo: PAGES[page] };
+        },
+      }, { signal });
+    }
+  </script>
 </body>
 
 </html>
