diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,64 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // WebMCP: expose menu item lookup to AI assistants. Menu data is read from the cards on the page.
+    let toolController = null;
+
+    function getMenuItems() {
+      return [...document.querySelectorAll('.grid .card')].map((card) => ({
+        name: card.querySelector('h3').textContent.trim(),
+        description: card.querySelector('p').textContent.trim(),
+        detailsUrl: new URL(card.querySelector('a').getAttribute('href'), location.href).href,
+      }));
+    }
+
+    function registerMenuTools() {
+      if (!('modelContext' in document) || toolController) return;
+      toolController = new AbortController();
+
+      document.modelContext.registerTool({
+        name: 'get_menu_item_details',
+        description: 'Looks up a Daily Grind menu item and returns its description and details page link. Use when the user asks about a drink on the menu.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              description: 'Name of the menu item to look up. Matching ignores letter case.',
+            },
+          },
+          required: ['name'],
+        },
+        execute({ name } = {}) {
+          const items = getMenuItems();
+          const query = typeof name === 'string' ? name.trim().toLowerCase() : '';
+          const item = items.find((entry) => entry.name.toLowerCase() === query);
+          if (!item) {
+            return {
+              error: `Menu item "${name}" not found.`,
+              availableItems: items.map((entry) => entry.name),
+            };
+          }
+          return item;
+        },
+        annotations: { readOnlyHint: true },
+      }, { signal: toolController.signal });
+    }
+
+    function unregisterMenuTools() {
+      toolController?.abort();
+      toolController = null;
+    }
+
+    registerMenuTools();
+    // Unregister when leaving the page; re-register if restored from the back/forward cache.
+    addEventListener('pagehide', unregisterMenuTools);
+    addEventListener('pageshow', (event) => {
+      if (event.persisted) registerMenuTools();
+    });
+  </script>
 </body>
 
 </html>
