+  <script>
+    // Defer poster, source, and media data downloads until the player nears the viewport.
+    (function () {
+      var items = document.querySelectorAll('.lazy-media');
+
+      function load(el) {
+        if (el.dataset.poster) el.poster = el.dataset.poster;
+        el.querySelectorAll('source[data-src]').forEach(function (src) {
+          src.src = src.dataset.src;
+          src.removeAttribute('data-src');
+        });
+        el.preload = 'metadata';
+        el.load();
+      }
+
+      if (!('IntersectionObserver' in window)) {
+        items.forEach(load);
+        return;
+      }
+
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (!entry.isIntersecting) return;
+          observer.unobserve(entry.target);
+          load(entry.target);
+        });
+      }, { rootMargin: '300px 0px' });
+
+      items.forEach(function (el) { observer.observe(el); });
+    })();
+  </script>
