+  <script>
+    // The pickup time and anniversary are location-agnostic: they are stored as the plain
+    // strings the inputs produce ("HH:MM", "YYYY-MM-DD") and never converted to a Date or
+    // instant, so travelling across time zones cannot shift them.
+    (async () => {
+      const STORAGE_KEY = 'ritual';
+      const form = document.getElementById('ritual-form');
+      const summary = document.getElementById('ritual-summary');
+
+      if (typeof Temporal === 'undefined') {
+        try {
+          const module = await import('https://esm.sh/temporal-polyfill');
+          globalThis.Temporal = module.Temporal;
+        } catch {
+          // Display falls back to the raw stored strings below.
+        }
+      }
+
+      function render({ pickupTime, coffeeAnniversary }) {
+        if (!pickupTime || !coffeeAnniversary) return;
+        let time = pickupTime;
+        let date = coffeeAnniversary;
+        if (typeof Temporal !== 'undefined') {
+          time = Temporal.PlainTime.from(pickupTime).toLocaleString(undefined, { timeStyle: 'short' });
+          date = Temporal.PlainDate.from(coffeeAnniversary).toLocaleString(undefined, { dateStyle: 'long' });
+        }
+        summary.textContent = `Pickup reminder at ${time} daily. Coffee anniversary: ${date}.`;
+      }
+
+      let saved = {};
+      try {
+        saved = JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? {};
+      } catch {
+        // Ignore unavailable or corrupt storage.
+      }
+      if (saved.pickupTime) form.elements.pickupTime.value = saved.pickupTime;
+      if (saved.coffeeAnniversary) form.elements.coffeeAnniversary.value = saved.coffeeAnniversary;
+      render(saved);
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const values = {
+          pickupTime: form.elements.pickupTime.value,
+          coffeeAnniversary: form.elements.coffeeAnniversary.value,
+        };
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(values));
+        } catch {
+          // Storage unavailable; still show the confirmation.
+        }
+        render(values);
+      });
+    })();
+  </script>
 </body>
 
