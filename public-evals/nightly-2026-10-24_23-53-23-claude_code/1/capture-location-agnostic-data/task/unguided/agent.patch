+  <script>
+    // The pickup time ("HH:MM") and anniversary ("YYYY-MM-DD") are floating,
+    // location-agnostic values. They are stored and restored as the exact strings
+    // the user picked and never converted through Date, so time zone changes
+    // (travel, DST) cannot shift them.
+    (function () {
+      var KEY = 'dailyGrindPrefs';
+      var form = document.getElementById('prefs-form');
+      var time = document.getElementById('pickup-time');
+      var date = document.getElementById('coffee-anniversary');
+      var status = document.getElementById('prefs-status');
+
+      try {
+        var saved = JSON.parse(localStorage.getItem(KEY) || '{}');
+        if (saved.pickupTime) time.value = saved.pickupTime;
+        if (saved.coffeeAnniversary) date.value = saved.coffeeAnniversary;
+      } catch (e) { }
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        try {
+          localStorage.setItem(KEY, JSON.stringify({
+            pickupTime: time.value,
+            coffeeAnniversary: date.value
+          }));
+          status.textContent = 'Saved: pickup at ' + time.value + ' daily, anniversary ' + date.value + '.';
+        } catch (err) {
+          status.textContent = 'Could not save your settings.';
+        }
+      });
+    })();
+  </script>
+
