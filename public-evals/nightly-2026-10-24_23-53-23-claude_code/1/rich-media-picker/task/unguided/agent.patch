+    /* Roast dropdown */
+    .roast-picker {
+      position: relative;
+      width: min(100%, 340px);
+      margin-top: 1rem;
+      text-align: left;
+    }
+
+    .roast-toggle {
+      width: 100%;
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      background: white;
+      color: var(--text);
+      border: 2px solid transparent;
+      border-radius: 8px;
+      padding: 10px 14px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .roast-toggle:focus-visible,
+    .roast-option:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .roast-toggle .chevron {
+      margin-left: auto;
+      transition: transform 0.2s;
+    }
+
+    .roast-toggle[aria-expanded="true"] .chevron {
+      transform: rotate(180deg);
+    }
+
+    .roast-menu {
+      position: absolute;
+      bottom: calc(100% + 6px);
+      left: 0;
+      right: 0;
+      list-style: none;
+      background: white;
+      color: var(--text);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
+      padding: 6px;
+      z-index: 10;
+    }
+
+    .roast-menu[hidden] {
+      display: none;
+    }
+
+    .roast-option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 8px 10px;
+      border-radius: 6px;
+      cursor: pointer;
+    }
+
+    .roast-option:hover,
+    .roast-option.active {
+      background: var(--secondary);
+    }
+
