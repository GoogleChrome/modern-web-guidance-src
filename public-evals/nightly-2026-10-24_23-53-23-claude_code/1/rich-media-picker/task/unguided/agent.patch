+  <script>
+    (function () {
+      var picker = document.getElementById('roast-picker');
+      var toggle = document.getElementById('roast-toggle');
+      var menu = document.getElementById('roast-menu');
+      var orderBtn = document.getElementById('order-btn');
+      var options = Array.prototype.slice.call(menu.querySelectorAll('[role="option"]'));
+      var active = -1;
+
+      function setActive(i) {
+        active = (i + options.length) % options.length;
+        options.forEach(function (o, n) { o.classList.toggle('active', n === active); });
+        menu.setAttribute('aria-activedescendant', options[active].id);
+      }
+
+      function open() {
+        menu.hidden = false;
+        toggle.setAttribute('aria-expanded', 'true');
+        var sel = options.findIndex(function (o) { return o.getAttribute('aria-selected') === 'true'; });
+        setActive(sel < 0 ? 0 : sel);
+        menu.focus();
+      }
+
+      function close(refocus) {
+        menu.hidden = true;
+        toggle.setAttribute('aria-expanded', 'false');
+        if (refocus) toggle.focus();
+      }
+
+      function select(i) {
+        options.forEach(function (o, n) { o.setAttribute('aria-selected', n === i ? 'true' : 'false'); });
+        var opt = options[i];
+        // Mirror the chosen option's icon, title and description in the toggle button
+        var icon = opt.querySelector('svg').cloneNode(true);
+        var current = toggle.querySelector('.roast-icon');
+        if (current) current.remove();
+        toggle.insertBefore(icon, toggle.firstChild);
+        toggle.querySelector('.roast-title').textContent = opt.querySelector('.roast-title').textContent;
+        toggle.querySelector('.roast-desc').textContent = opt.querySelector('.roast-desc').textContent;
+        orderBtn.href = '/order-online?roast=' + encodeURIComponent(opt.dataset.value);
+        close(true);
+      }
+
+      toggle.addEventListener('click', function () { menu.hidden ? open() : close(false); });
+      options.forEach(function (o, i) {
+        o.addEventListener('click', function () { select(i); });
+        o.addEventListener('mousemove', function () { if (active !== i) setActive(i); });
+      });
+      menu.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
+        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
+        else if (e.key === 'Home') { e.preventDefault(); setActive(0); }
+        else if (e.key === 'End') { e.preventDefault(); setActive(options.length - 1); }
+        else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(active); }
+        else if (e.key === 'Escape') { e.preventDefault(); close(true); }
+        else if (e.key === 'Tab') { close(false); }
+      });
+      toggle.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); if (menu.hidden) open(); }
+      });
+      document.addEventListener('click', function (e) { if (!picker.contains(e.target)) close(false); });
+    })();
+  </script>
