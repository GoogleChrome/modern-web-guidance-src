+    /* Roast picker (customizable select) */
+    .roast-picker {
+      width: min(100%, 340px);
+      margin-top: 1.5rem;
+      text-align: left;
+    }
+
+    .roast-picker label {
+      display: block;
+      font-size: 0.85rem;
+      font-weight: 600;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      margin-bottom: 6px;
+    }
+
+    .roast-select,
+    .roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .roast-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      padding: 10px 14px;
+      background: var(--light);
+      color: var(--text);
+      border: 2px solid var(--accent);
+      border-radius: 8px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .roast-select::picker(select) {
+      background: var(--light);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 6px;
+      margin-top: 4px;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
+      width: anchor-size(width);
+    }
+
+    .roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px;
+      border-radius: 6px;
+      cursor: pointer;
+    }
+
+    .roast-select option::checkmark,
+    .roast-select option::before {
+      display: none;
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus-visible {
+      background: var(--secondary);
+    }
+
+    .roast-select option:checked {
+      background: var(--primary);
+      color: white;
+    }
+
+    .roast-select option:checked .option-title {
+      font-weight: 700;
+    }
+
+    .roast-select svg {
+      flex: none;
+      width: 28px;
+      height: 28px;
+    }
+
+    .option-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .option-desc {
+      font-size: 0.8rem;
+      opacity: 0.75;
+    }
+
+    .roast-select selectedcontent .option-desc {
+      display: none;
+    }
+
