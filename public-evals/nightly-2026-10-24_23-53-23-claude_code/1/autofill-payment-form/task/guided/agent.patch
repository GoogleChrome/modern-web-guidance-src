+      display: block;
+      font-weight: 600;
+      margin-bottom: 4px;
+    }
+
+    .field .hint {
+      display: block;
+      font-size: 0.85rem;
+      opacity: 0.75;
+      margin-bottom: 4px;
+    }
+
+    .field input {
+      width: 100%;
+      padding: 10px 12px;
