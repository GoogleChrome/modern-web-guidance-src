+    /* Seasonal carousel */
+    .carousel {
+      --item-width: min(80%, 300px);
+      display: flex;
+      gap: 20px;
+      margin-top: 20px;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      /* Room for the scaled card and its shadow, which overflow-x would otherwise clip */
+      padding-block: 40px;
+      /* Let the first and last items reach the center */
+      padding-inline: calc((100% - var(--item-width)) / 2);
+    }
+
+    .carousel-item {
+      flex: 0 0 var(--item-width);
+      scroll-snap-align: center;
+      container-type: scroll-state;
+    }
+
+    .carousel .card {
+      height: 100%;
+      background: #e0e0e0;
+      transition:
+        scale 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
+        background-color 0.4s,
+        color 0.4s,
+        box-shadow 0.4s;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @container scroll-state(snapped: x) {
+        .carousel .card {
+          background: #007bff;
+          color: white;
+          scale: 1.15;
+          box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
+        }
+      }
+
+      /* Fallback for browsers without scroll-state queries (set by script) */
+      .carousel-item.is-snapped .card {
+        background: #007bff;
+        color: white;
+        scale: 1.15;
+        box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .carousel .card {
+        transition: none !important;
+        scale: 1 !important;
+      }
+    }
+
+    .carousel .card h3 {
+      color: inherit;
+    }
+
