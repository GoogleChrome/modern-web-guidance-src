diff --git a/src/utils/slugify.ts b/src/utils/slugify.ts
new file mode 100644
index 0000000..467cd43
--- /dev/null
+++ b/src/utils/slugify.ts
@@ -0,0 +1,2 @@
+export const slugify = (text: string) =>
+    text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
