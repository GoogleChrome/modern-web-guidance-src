diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..5f749ed
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,69 @@
+---
+import { slugify } from '../utils/slugify';
+
+export interface Props {
+    sections: string[];
+}
+
+const { sections } = Astro.props;
+---
+<nav id="section-nav" aria-label="Page sections" class="sticky top-0 z-20 bg-white border-b border-gray-300">
+    <ul class="flex justify-center space-x-6 px-4 h-10 items-center text-sm font-semibold overflow-x-auto">
+        {sections.map(title => (
+            <li>
+                <a
+                    href={`#${slugify(title)}`}
+                    data-section={slugify(title)}
+                    class="block py-2 whitespace-nowrap border-b-2 border-transparent text-gray-700 hover:text-gray-900 aria-[current=true]:text-amber-400 aria-[current=true]:border-amber-400"
+                >
+                    {title}
+                </a>
+            </li>
+        ))}
+    </ul>
+</nav>
+
+<script>
+    function initSectionNav() {
+        const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('#section-nav a[data-section]'));
+        const sections = links
+            .map(link => document.getElementById(link.dataset.section!))
+            .filter((el): el is HTMLElement => el !== null);
+        if (!sections.length) return;
+
+        let ticking = false;
+        const update = () => {
+            ticking = false;
+            // The active section is the last one whose top has passed 1/3 of the viewport.
+            const threshold = window.innerHeight / 3;
+            let current: HTMLElement | null = null;
+            for (const section of sections) {
+                if (section.getBoundingClientRect().top <= threshold) current = section;
+            }
+            // Pinned to the bottom of the page: the last section can never reach the threshold.
+            if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
+                current = sections[sections.length - 1];
+            }
+            for (const link of links) {
+                if (current && link.dataset.section === current.id) link.setAttribute('aria-current', 'true');
+                else link.removeAttribute('aria-current');
+            }
+        };
+        const onScroll = () => {
+            if (!ticking) {
+                ticking = true;
+                requestAnimationFrame(update);
+            }
+        };
+
+        window.addEventListener('scroll', onScroll, { passive: true });
+        window.addEventListener('resize', onScroll);
+        document.addEventListener('astro:before-swap', () => {
+            window.removeEventListener('scroll', onScroll);
+            window.removeEventListener('resize', onScroll);
+        }, { once: true });
+        update();
+    }
+
+    document.addEventListener('astro:page-load', initSectionNav);
+</script>
