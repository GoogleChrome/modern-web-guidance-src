+      position: sticky;
+      top: 0;
+      z-index: 1000;
+    }
+
+    .back {
+      background: none;
+      border: 1px solid var(--accent);
+      color: white;
+      font: inherit;
+      font-size: 0.9rem;
+      padding: 5px 12px;
+      border-radius: 4px;
+      cursor: pointer;
+    }
+
+    .back:hover { color: var(--accent); }
+
+    .detail-hero {
