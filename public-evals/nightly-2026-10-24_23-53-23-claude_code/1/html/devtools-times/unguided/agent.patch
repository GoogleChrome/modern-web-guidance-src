diff --git a/src/components/ModalDialog.tsx b/src/components/ModalDialog.tsx
new file mode 100644
index 0000000..ae4b310
--- /dev/null
+++ b/src/components/ModalDialog.tsx
@@ -0,0 +1,56 @@
+import React, { useEffect, useRef } from 'react';
+
+interface Props {
+  label: string;
+  onClose: () => void;
+  children: React.ReactNode;
+}
+
+// Native <dialog> shown modally: the browser provides the top layer, inert
+// background, Escape handling and focus containment.
+export default function ModalDialog({ label, onClose, children }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const onCloseRef = useRef(onClose);
+  onCloseRef.current = onClose;
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+
+    const previouslyFocused = document.activeElement as HTMLElement | null;
+    if (!dialog.open) dialog.showModal();
+    dialog.querySelector<HTMLElement>('[data-autofocus]')?.focus();
+
+    return () => {
+      if (dialog.open) dialog.close();
+      previouslyFocused?.focus?.();
+    };
+  }, []);
+
+  return (
+    <dialog
+      ref={dialogRef}
+      aria-label={label}
+      onClose={() => onCloseRef.current()}
+      onClick={e => {
+        // Clicks on the backdrop target the dialog element itself.
+        if (e.target === dialogRef.current) dialogRef.current?.close();
+      }}
+      className="mx-auto mt-[15vh] mb-auto w-full max-w-2xl bg-transparent p-4 overflow-visible backdrop:bg-white/30 backdrop:backdrop-blur-sm"
+    >
+      <div className="bg-white shadow-xl w-full relative">
+        <button
+          type="button"
+          aria-label="Close"
+          onClick={() => dialogRef.current?.close()}
+          className="absolute -top-2 -right-2 bg-white rounded-full p-1 shadow-md text-gray-500 hover:text-amber-400 hover:scale-110 transition-transform z-10"
+        >
+          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+            <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
+          </svg>
+        </button>
+        {children}
+      </div>
+    </dialog>
+  );
+}
