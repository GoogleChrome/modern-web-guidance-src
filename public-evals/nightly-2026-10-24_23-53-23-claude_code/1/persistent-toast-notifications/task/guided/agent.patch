+    /* Toasts: each is its own top-layer popover, stacked with CSS only */
+    .toast {
+      --toast-height: 3.25rem;
+      --toast-gap: 0.75rem;
+      --toast-offset: 0;
+      position: fixed;
+      inset: auto;
+      right: 1.25rem;
+      bottom: calc(1.25rem + var(--toast-offset) * (var(--toast-height) + var(--toast-gap)));
+      margin: 0;
+      height: var(--toast-height);
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      padding: 0 0.75rem 0 1rem;
+      border: 0;
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
+
+      /* Exit state */
+      opacity: 0;
+      translate: 2rem 0;
+      transition-property: opacity, translate, bottom, display, overlay;
+      transition-duration: 0.3s;
+      transition-timing-function: ease-out;
+      transition-behavior: allow-discrete;
+
+      /* Newest toast sits at the bottom; older ones are pushed up */
+      @supports (top: calc(sibling-index() * 1px)) {
+        --toast-offset: calc(sibling-count() - sibling-index());
+      }
+
+      @supports not (top: calc(sibling-index() * 1px)) {
+        &:nth-last-child(2) { --toast-offset: 1; }
+        &:nth-last-child(3) { --toast-offset: 2; }
+        &:nth-last-child(4) { --toast-offset: 3; }
+        &:nth-last-child(5) { --toast-offset: 4; }
+        &:nth-last-child(n + 6) { --toast-offset: 5; }
+      }
+    }
+
+    .toast:popover-open:not([data-closing]) {
+      opacity: 1;
+      translate: 0 0;
+
+      @starting-style {
+        opacity: 0;
+        translate: 2rem 0;
+      }
+    }
+
+    .toast-close {
+      display: grid;
+      place-items: center;
+      width: 1.75rem;
+      height: 1.75rem;
+      border: 0;
+      border-radius: 50%;
+      background: transparent;
+      color: inherit;
+      font: inherit;
+      font-size: 1.25rem;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    .toast-close:hover,
+    .toast-close:focus-visible {
+      background: rgba(255, 255, 255, 0.2);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        translate: 0 0;
+        transition-duration: 0.1s;
+      }
+
+      .toast:popover-open:not([data-closing]) {
+        @starting-style {
+          translate: 0 0;
+        }
+      }
+    }
