+
+    /* Toasts: manual popovers live in the top layer (no z-index needed).
+       Each is offset by its distance from the end of <body>, so the newest
+       sits at the bottom and older ones are pushed up, purely in CSS. */
+    .toast {
+      --toast-height: 3rem;
+      --toast-gap: 0.75rem;
+      position: fixed;
+      inset: auto 1.5rem
+        calc(1.5rem + (sibling-count() - sibling-index()) * (var(--toast-height) + var(--toast-gap)))
+        auto;
+      margin: 0;
+      height: var(--toast-height);
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      padding: 0 0.75rem 0 1rem;
+      border: none;
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
+      overflow: visible;
+      transition: bottom 0.3s ease;
+      animation: toast-in 0.35s ease-out;
+    }
+
+    .toast.leaving {
+      animation: toast-out 0.3s ease-in forwards;
+    }
+
+    .toast-close {
+      background: none;
+      border: none;
+      color: inherit;
+      font-size: 1.25rem;
+      line-height: 1;
+      cursor: pointer;
+      opacity: 0.7;
+    }
+
+    .toast-close:hover,
+    .toast-close:focus-visible {
+      opacity: 1;
+      color: var(--accent);
+    }
+
+    @keyframes toast-in {
+      from { opacity: 0; transform: translateX(100%); }
+      to { opacity: 1; transform: translateX(0); }
+    }
+
+    @keyframes toast-out {
+      from { opacity: 1; transform: translateX(0); }
+      to { opacity: 0; transform: translateX(100%); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast { transition: none; animation-duration: 0.01s; }
+      .toast.leaving { animation-duration: 0.01s; }
+    }
   </style>
