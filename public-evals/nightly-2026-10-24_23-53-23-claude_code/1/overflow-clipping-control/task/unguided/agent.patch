+    /* Showcase Section */
+    .showcase {
+      max-width: 1100px;
+      margin: 40px auto 0;
+      padding: 0 20px;
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 30px;
+    }
+
+    /* Clips children at the content box edge, following its (inner) curve */
+    .nested-curve-parent {
+      background: white;
+      border: 6px solid var(--primary);
+      padding: 24px;
+      border-radius: 40px;
+      overflow: clip;
+      overflow-clip-margin: content-box;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      height: 200px;
+      object-fit: cover;
+    }
+
+    .nested-curve-parent .card-footer {
+      background: var(--secondary);
+      padding: 12px 16px;
+      font-size: 0.9rem;
+    }
+
+    /* Clips overflowing text, but leaves a 15px zone for the button's glow */
+    .safety-zone-parent {
+      background: var(--primary);
+      color: white;
+      padding: 40px 30px;
+      border-radius: 12px;
+      text-align: center;
+      overflow: clip;
+      overflow-clip-margin: 15px;
+    }
+
+    .safety-zone-parent h3 {
+      margin-bottom: 10px;
+      color: var(--accent);
+    }
+
+    .glow-btn {
+      display: inline-block;
+      margin-top: 20px;
+      padding: 12px 28px;
+      border: none;
+      border-radius: 6px;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 1rem;
+      font-weight: bold;
+      cursor: pointer;
+      box-shadow: 0 0 15px 4px rgba(255, 171, 64, 0.8),
+        0 0 30px 8px rgba(255, 171, 64, 0.4);
+    }
+
