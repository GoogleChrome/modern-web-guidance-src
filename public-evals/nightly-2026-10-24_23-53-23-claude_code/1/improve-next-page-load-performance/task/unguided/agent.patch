+  <script>
+    // Prefetch internal pages when the user shows intent (hover, focus, touch).
+    // Opt a link out with the data-no-prefetch attribute. State-changing URLs
+    // such as /logout are also blocked by path as a safety net.
+    (function () {
+      var NEVER = /^\/(logout|signout|log-out|sign-out)(\/|$)/i;
+      var done = {};
+      var conn = navigator.connection;
+      if (conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || ''))) return;
+
+      function prefetch(e) {
+        var a = e.target.closest && e.target.closest('a[href]');
+        if (!a || a.hasAttribute('data-no-prefetch') || a.closest('[data-no-prefetch]')) return;
+        if (a.origin !== location.origin || a.hasAttribute('download')) return;
+        if (a.target && a.target !== '_self') return;
+        if (NEVER.test(a.pathname)) return;
+        var url = a.origin + a.pathname + a.search;
+        if (url === location.origin + location.pathname + location.search || done[url]) return;
+        done[url] = true;
+        var link = document.createElement('link');
+        link.rel = 'prefetch';
+        link.href = url;
+        link.as = 'document';
+        document.head.appendChild(link);
+      }
+
+      ['mouseover', 'focusin', 'touchstart'].forEach(function (type) {
+        document.addEventListener(type, prefetch, { passive: true });
+      });
+    })();
+  </script>
