     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      var input = document.getElementById('search-input');
+      var targets = document.querySelectorAll('.grid .card h3, .grid .card p');
+
+      function clearHighlights() {
+        document.querySelectorAll('mark.search-highlight').forEach(function (mark) {
+          mark.replaceWith(document.createTextNode(mark.textContent));
+        });
+        targets.forEach(function (el) { el.normalize(); });
+      }
+
+      function highlight(el, query) {
+        var text = el.textContent;
+        var lower = text.toLowerCase();
+        var q = query.toLowerCase();
+        var frag = document.createDocumentFragment();
+        var pos = 0;
+        var idx;
+        while ((idx = lower.indexOf(q, pos)) !== -1) {
+          if (idx > pos) frag.appendChild(document.createTextNode(text.slice(pos, idx)));
+          var mark = document.createElement('mark');
+          mark.className = 'search-highlight';
+          mark.textContent = text.slice(idx, idx + q.length);
+          frag.appendChild(mark);
+          pos = idx + q.length;
+        }
+        if (pos === 0) return;
+        if (pos < text.length) frag.appendChild(document.createTextNode(text.slice(pos)));
+        el.textContent = '';
+        el.appendChild(frag);
+      }
+
+      input.addEventListener('input', function () {
+        clearHighlights();
+        var query = input.value.trim();
+        if (!query) return;
+        targets.forEach(function (el) { highlight(el, query); });
+      });
+    })();
+  </script>
+
 </body>
 
