+  <script>
+    (() => {
+      const input = document.getElementById('search-input');
+      const grid = document.querySelector('.grid');
+
+      function textNodes() {
+        const walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT);
+        const nodes = [];
+        for (let n = walker.nextNode(); n; n = walker.nextNode()) nodes.push(n);
+        return nodes;
+      }
+
+      function clearHighlights() {
+        if (window.CSS && CSS.highlights) {
+          CSS.highlights.clear();
+          return;
+        }
+        // Fallback: unwrap previous <mark> elements and merge text nodes back together
+        grid.querySelectorAll('mark.search-match').forEach((mark) => mark.replaceWith(mark.textContent));
+        grid.normalize();
+      }
+
+      function highlight(term) {
+        const useApi = window.CSS && CSS.highlights;
+        const ranges = [];
+        for (const node of textNodes()) {
+          const text = node.textContent.toLowerCase();
+          const matches = [];
+          for (let pos = text.indexOf(term); pos !== -1; pos = text.indexOf(term, pos + term.length)) {
+            matches.push(pos);
+          }
+          if (!matches.length) continue;
+
+          if (useApi) {
+            for (const pos of matches) {
+              const range = new Range();
+              range.setStart(node, pos);
+              range.setEnd(node, pos + term.length);
+              ranges.push(range);
+            }
+          } else {
+            const original = node.textContent;
+            const frag = document.createDocumentFragment();
+            let last = 0;
+            for (const pos of matches) {
+              frag.append(original.slice(last, pos));
+              const mark = document.createElement('mark');
+              mark.className = 'search-match';
+              mark.textContent = original.slice(pos, pos + term.length);
+              frag.append(mark);
+              last = pos + term.length;
+            }
+            frag.append(original.slice(last));
+            node.replaceWith(frag);
+          }
+        }
+        if (useApi && ranges.length) CSS.highlights.set('search-results', new Highlight(...ranges));
+      }
+
+      input.addEventListener('input', () => {
+        clearHighlights();
+        const term = input.value.trim().toLowerCase();
+        if (term) highlight(term);
+      });
+    })();
+  </script>
+
 </body>
 
