diff --git a/src/middleware.ts b/src/middleware.ts
index 1684cf6..f31be51 100644
--- a/src/middleware.ts
+++ b/src/middleware.ts
@@ -9,5 +9,37 @@ export const onRequest = defineMiddleware(async (context, next) => {
       await context.session.set('readingList', []);
     }
   }
-  return next();
+  const response = await next();
+
+  // Security and privacy headers
+  response.headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
+  response.headers.set('X-Content-Type-Options', 'nosniff');
+  response.headers.set('X-Frame-Options', 'DENY');
+  response.headers.set(
+    'Permissions-Policy',
+    'camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=(), payment=()'
+  );
+  response.headers.set('Cross-Origin-Opener-Policy', 'same-origin');
+  response.headers.set(
+    'Content-Security-Policy',
+    [
+      "default-src 'self'",
+      "script-src 'self' 'unsafe-inline'",
+      "style-src 'self' 'unsafe-inline'",
+      "img-src 'self' data: https:",
+      "font-src 'self'",
+      // Only the first-party origin and the auth service used by the sign-in/up forms.
+      "connect-src 'self' https://us-central1-web-devrel-apps.cloudfunctions.net",
+      "object-src 'none'",
+      "base-uri 'self'",
+      "form-action 'self'",
+      "frame-ancestors 'none'",
+    ].join('; ')
+  );
+  // Auth pages must not be cached by shared caches or the browser
+  const path = context.url.pathname;
+  if (/\/sign(in|up)\/?$/.test(path)) {
+    response.headers.set('Cache-Control', 'no-store');
+  }
+  return response;
 });
