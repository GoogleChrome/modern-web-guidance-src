+  <script type="module">
+    const CONTEXTS = { receipt: 'daily-grind/receipt/v1', voucher: 'daily-grind/voucher/v1' };
+    const ML_DSA = { 1312: 'ML-DSA-44', 1952: 'ML-DSA-65', 2592: 'ML-DSA-87' };
+    const enc = new TextEncoder();
+    const $ = (id) => document.getElementById(id);
+
+    const toB64 = (b) => btoa(String.fromCharCode(...new Uint8Array(b)));
+    const fromB64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
+    const toHex = (b) => [...new Uint8Array(b)].map((x) => x.toString(16).padStart(2, '0')).join('');
+    const fingerprint = async (pub) => toHex(await crypto.subtle.digest('SHA-256', pub)).slice(0, 32);
+
+    const pqSupported = () =>
+      typeof globalThis.SubtleCrypto?.supports === 'function' && SubtleCrypto.supports('sign', 'ML-DSA-65');
+
+    // Classical algorithms ignore `context`, so prefix it to the payload instead.
+    function frame(payload, context) {
+      const out = new Uint8Array(1 + context.length + payload.length);
+      out[0] = context.length;
+      out.set(context, 1);
+      out.set(payload, 1 + context.length);
+      return out;
+    }
+
+    // Persist the key pair (non-extractable private key) in IndexedDB so the shop key survives reloads.
+    const db = () => new Promise((res, rej) => {
+      const r = indexedDB.open('daily-grind-signing', 1);
+      r.onupgradeneeded = () => r.result.createObjectStore('keys');
+      r.onsuccess = () => res(r.result);
+      r.onerror = () => rej(r.error);
+    });
+    const idb = async (mode, fn) => {
+      const d = await db();
+      return new Promise((res, rej) => {
+        const req = fn(d.transaction('keys', mode).objectStore('keys'));
+        req.onsuccess = () => res(req.result);
+        req.onerror = () => rej(req.error);
+      });
+    };
+
+    async function loadSigner() {
+      let rec;
+      try { rec = await idb('readonly', (s) => s.get('signer')); } catch {}
+      if (!rec) {
+        const suite = pqSupported() ? 'ML-DSA-65' : 'Ed25519';
+        const keyPair = await crypto.subtle.generateKey(suite, false, ['sign', 'verify']);
+        const publicKey = new Uint8Array(
+          await crypto.subtle.exportKey(suite === 'Ed25519' ? 'raw' : 'raw-public', keyPair.publicKey));
+        rec = { suite, keyPair, publicKey };
+        try { await idb('readwrite', (s) => s.put(rec, 'signer')); } catch {}
+      }
+      return rec;
+    }
+
+    async function sign(signer, type, payloadText) {
+      const payload = enc.encode(payloadText);
+      const context = enc.encode(CONTEXTS[type]);
+      const sig = signer.suite === 'Ed25519'
+        ? await crypto.subtle.sign('Ed25519', signer.keyPair.privateKey, frame(payload, context))
+        : await crypto.subtle.sign({ name: signer.suite, context }, signer.keyPair.privateKey, payload);
+      return {
+        v: 1, type, suite: signer.suite, payload: payloadText,
+        publicKey: toB64(signer.publicKey), signature: toB64(sig),
+      };
+    }
+
+    async function verify(doc) {
+      const context = enc.encode(CONTEXTS[doc.type] ?? '');
+      if (!(doc.type in CONTEXTS)) throw new Error('Unknown document type');
+      const pub = fromB64(doc.publicKey);
+      const sig = fromB64(doc.signature);
+      const payload = enc.encode(doc.payload);
+      const mlName = ML_DSA[pub.length];
+      if (mlName) {
+        const key = await crypto.subtle.importKey('raw-public', pub, mlName, true, ['verify']);
+        return crypto.subtle.verify({ name: mlName, context }, key, sig, payload);
+      }
+      const key = await crypto.subtle.importKey('raw', pub, 'Ed25519', true, ['verify']);
+      return crypto.subtle.verify('Ed25519', key, sig, frame(payload, context));
+    }
+
+    const keyInfo = $('key-info');
+    let signer;
+    try {
+      signer = await loadSigner();
+      keyInfo.textContent =
+        `Signing with ${signer.suite}${signer.suite === 'Ed25519' ? ' (classical)' : ' (quantum-resistant)'} · key fingerprint ${await fingerprint(signer.publicKey)}`;
+    } catch (e) {
+      keyInfo.textContent = 'Digital signing is not supported in this browser.';
+      document.querySelectorAll('.signing button').forEach((b) => (b.disabled = true));
+    }
+
+    $('sign-form').addEventListener('submit', async (e) => {
+      e.preventDefault();
+      if (!signer) return;
+      const f = new FormData(e.target);
+      const payload = JSON.stringify({
+        id: crypto.randomUUID(),
+        type: f.get('type'),
+        subject: f.get('subject'),
+        amount: Number(f.get('amount')).toFixed(2),
+        currency: 'USD',
+        issuedAt: new Date().toISOString(),
+      });
+      $('signed-output').value = JSON.stringify(await sign(signer, f.get('type'), payload), null, 2);
+    });
+
+    $('copy-btn').addEventListener('click', () => {
+      $('verify-input').value = $('signed-output').value;
+    });
+
+    $('verify-form').addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const out = $('verify-status');
+      const show = (cls, text) => { out.className = 'status ' + cls; out.textContent = text; };
+      try {
+        const doc = JSON.parse($('verify-input').value);
+        if (await verify(doc)) {
+          const p = JSON.parse(doc.payload);
+          const fp = await fingerprint(fromB64(doc.publicKey));
+          const mine = signer && fp === await fingerprint(signer.publicKey);
+          show('ok', `✔ Authentic and unaltered: ${p.type} for "${p.subject}", $${p.amount} ${p.currency}, issued ${p.issuedAt}. ` +
+            `Signed by key ${fp} (${doc.suite})${mine ? ' — this is The Daily Grind key shown above.' : ' — NOT the key shown above; do not trust it.'}`);
+        } else {
+          show('bad', '✘ Invalid signature: this document was altered or not signed by the stated key.');
+        }
+      } catch {
+        show('bad', '✘ Could not read or verify this document.');
+      }
+    });
+  </script>
