+  <div id="tour-step" popover="manual" role="dialog" aria-labelledby="tour-title">
+    <h2 id="tour-title">Earn points</h2>
+    <p>Earn points with every purchase and redeem them for free drinks.</p>
+    <button type="button" class="btn" popovertarget="tour-step" popovertargetaction="hide">Got it</button>
+  </div>
+
+  <script type="module">
+    // Polyfill anchor positioning where unsupported
+    if (!CSS.supports('anchor-name: --foo')) {
+      await import('https://unpkg.com/@oddbird/css-anchor-positioning');
+    }
+    // Polyfill popover where unsupported
+    if (!('popover' in HTMLElement.prototype)) {
+      await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+
+    const tourStep = document.getElementById('tour-step');
+    tourStep.showPopover();
+    tourStep.querySelector('button').focus();
+
+    // Keep the tour visible instead of navigating away
+    document.getElementById('feature').addEventListener('click', (e) => e.preventDefault());
+  </script>
