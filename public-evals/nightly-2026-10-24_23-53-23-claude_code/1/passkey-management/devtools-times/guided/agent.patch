+import type { APIRoute } from 'astro';
+import { cleanName, getUser, json } from '../../utils/passkeys';
+
+export const PUT: APIRoute = async ({ request, session }) => {
+  const user = await getUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  const body = await request.json().catch(() => ({}));
+  const name = cleanName(body.name);
+  const displayName = cleanName(body.displayName);
+  if (!name || !displayName) return json({ error: 'Name and display name are required' }, 400);
+
+  const updated = { ...user, name, displayName };
+  await session?.set('accountUser', updated);
+  return json(updated);
+};
diff --git a/src/utils/passkeys.ts b/src/utils/passkeys.ts
new file mode 100644
index 0000000..a41fe1c
--- /dev/null
+++ b/src/utils/passkeys.ts
@@ -0,0 +1,32 @@
+import type { AstroSession } from 'astro';
+
+export interface StoredPasskeyCredential {
+  /** Base64URL credential ID */
+  id: string;
+  name: string;
+  aaguid?: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export interface AccountUser {
+  /** Base64URL user handle, as used when the passkeys were registered */
+  id: string;
+  name: string;
+  displayName: string;
+}
+
+export const MAX_NAME_LENGTH = 64;
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+export const getUser = async (session?: AstroSession) =>
+  (await session?.get('accountUser')) as AccountUser | undefined;
+
+export const getCredentials = async (session?: AstroSession) =>
+  ((await session?.get('passkeys')) ?? []) as StoredPasskeyCredential[];
+
+export const cleanName = (value: unknown) =>
+  typeof value === 'string' ? value.trim().slice(0, MAX_NAME_LENGTH) : '';
