@@ -0,0 +1,19 @@
+import type { APIRoute } from 'astro';
+import { cleanName, json, type AccountUser } from '../../utils/passkeys';
+
+// Records the reader who just signed in so account settings can be shown.
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await request.json().catch(() => ({}));
+  const name = cleanName(body.username);
+  if (!name || typeof body.userId !== 'string' || !body.userId) {
+    return json({ error: 'Username and user ID are required' }, 400);
+  }
+  const existing = (await session?.get('accountUser')) as AccountUser | undefined;
+  const user: AccountUser = {
+    id: body.userId,
+    name,
+    displayName: existing?.id === body.userId ? existing.displayName : name,
+  };
+  await session?.set('accountUser', user);
+  return json(user);
+};
