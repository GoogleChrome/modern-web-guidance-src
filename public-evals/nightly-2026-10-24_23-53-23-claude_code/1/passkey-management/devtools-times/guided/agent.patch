--- /dev/null
+++ b/src/pages/api/credential/[id].ts
@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import { cleanName, getCredentials, getUser, json } from '../../../utils/passkeys';
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  if (!(await getUser(session))) return json({ error: 'Not signed in' }, 401);
+  const body = await request.json().catch(() => ({}));
+  const name = cleanName(body.name);
+  if (!name) return json({ error: 'Name is required' }, 400);
+
+  const credentials = await getCredentials(session);
+  const credential = credentials.find((c) => c.id === params.id);
+  if (!credential) return json({ error: 'Credential not found.' }, 404);
+
+  credential.name = name;
+  await session?.set('passkeys', credentials);
+  return json(credential);
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  if (!(await getUser(session))) return json({ error: 'Not signed in' }, 401);
+  const credentials = await getCredentials(session);
+  if (!credentials.some((c) => c.id === params.id)) {
+    return json({ error: 'Credential not found.' }, 404);
+  }
+  await session?.set('passkeys', credentials.filter((c) => c.id !== params.id));
+  return json({ success: true });
+};
