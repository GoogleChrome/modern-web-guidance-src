diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..77dd895
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,209 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import type { AccountUser, StoredPasskeyCredential } from '../utils/passkeys';
+
+const api = (path: string) => `${import.meta.env.BASE_URL}api/${path}`;
+const jsonInit = (method: string, body: unknown): RequestInit => ({
+  method,
+  headers: { 'Content-Type': 'application/json' },
+  body: JSON.stringify(body),
+});
+const formatDate = (ms?: number) =>
+  ms ? new Date(ms).toLocaleDateString(undefined, { dateStyle: 'medium' }) : null;
+
+// Tell the browser's authenticator which passkeys the server still accepts.
+async function syncAcceptedCredentials(user: AccountUser, credentials: StoredPasskeyCredential[]) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: location.hostname,
+      userId: user.id,
+      allAcceptedCredentialIds: credentials.map((c) => c.id),
+    });
+  } catch (e) {
+    console.error('signalAllAcceptedCredentials failed:', e);
+  }
+}
+
+async function syncUserDetails(user: AccountUser) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalCurrentUserDetails) return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId: location.hostname,
+      userId: user.id,
+      name: user.name,
+      displayName: user.displayName,
+    });
+  } catch (e) {
+    console.error('signalCurrentUserDetails failed:', e);
+  }
+}
+
+const inputClass =
+  'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500';
+const buttonClass =
+  'py-1.5 px-3 rounded-md text-sm font-medium border border-gray-300 text-gray-800 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 disabled:opacity-50';
+
+export default function PasskeyManager() {
+  const [user, setUser] = useState<AccountUser | null>(null);
+  const [credentials, setCredentials] = useState<StoredPasskeyCredential[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [status, setStatus] = useState<string | null>(null);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editName, setEditName] = useState('');
+  const [profile, setProfile] = useState({ name: '', displayName: '' });
+  const [busy, setBusy] = useState(false);
+
+  const load = useCallback(async () => {
+    const res = await fetch(api('credentials'));
+    if (!res.ok) throw new Error('Could not load your passkeys.');
+    return (await res.json()) as { user: AccountUser; credentials: StoredPasskeyCredential[] };
+  }, []);
+
+  useEffect(() => {
+    load()
+      .then(async (data) => {
+        setUser(data.user);
+        setProfile({ name: data.user.name, displayName: data.user.displayName });
+        setCredentials(data.credentials);
+        await syncAcceptedCredentials(data.user, data.credentials);
+      })
+      .catch((e) => setError(e.message));
+  }, [load]);
+
+  const run = async (action: () => Promise<void>) => {
+    setError(null);
+    setStatus(null);
+    setBusy(true);
+    try {
+      await action();
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'Something went wrong.');
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const saveRename = (id: string) =>
+    run(async () => {
+      const res = await fetch(api(`credential/${encodeURIComponent(id)}`), jsonInit('PUT', { name: editName }));
+      if (!res.ok) throw new Error('Could not rename the passkey.');
+      // Nicknames are a server-side label only; nothing to signal.
+      setCredentials((await load()).credentials);
+      setEditingId(null);
+      setStatus('Passkey renamed.');
+    });
+
+  const remove = (credential: StoredPasskeyCredential) => {
+    if (!user || !confirm(`Remove "${credential.name}"? You won't be able to sign in with it anymore.`)) return;
+    return run(async () => {
+      const res = await fetch(api(`credential/${encodeURIComponent(credential.id)}`), { method: 'DELETE' });
+      if (!res.ok) throw new Error('Could not remove the passkey.');
+      const remaining = (await load()).credentials;
+      setCredentials(remaining);
+      setStatus('Passkey removed.');
+      await syncAcceptedCredentials(user, remaining);
+    });
+  };
+
+  const saveProfile = (e: React.FormEvent) => {
+    e.preventDefault();
+    return run(async () => {
+      const res = await fetch(api('user'), jsonInit('PUT', profile));
+      if (!res.ok) throw new Error('Could not update your account details.');
+      const updated = (await res.json()) as AccountUser;
+      setUser(updated);
+      setStatus('Account details updated.');
+      await syncUserDetails(updated);
+    });
+  };
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-8">
+      <h1 className="text-2xl font-bold text-gray-800">Account settings</h1>
+
+      <div aria-live="polite">
+        {error && <p className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">{error}</p>}
+        {status && <p className="p-3 text-sm text-green-700 bg-green-100 rounded-lg">{status}</p>}
+      </div>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm" aria-labelledby="profile-heading">
+        <h2 id="profile-heading" className="text-lg font-semibold text-gray-800 mb-1">Account details</h2>
+        <p className="text-sm text-gray-600 mb-4">
+          Shown by your password manager next to your passkeys. Changes are shared with it automatically.
+        </p>
+        <form onSubmit={saveProfile} className="space-y-4">
+          <div>
+            <label htmlFor="acct-name" className="block text-sm font-medium text-gray-700 mb-1">Username</label>
+            <input id="acct-name" className={inputClass} required maxLength={64} autoComplete="username"
+              value={profile.name} onChange={(e) => setProfile({ ...profile, name: e.target.value })} />
+          </div>
+          <div>
+            <label htmlFor="acct-display" className="block text-sm font-medium text-gray-700 mb-1">Display name</label>
+            <input id="acct-display" className={inputClass} required maxLength={64} autoComplete="name"
+              value={profile.displayName} onChange={(e) => setProfile({ ...profile, displayName: e.target.value })} />
+          </div>
+          <button type="submit" disabled={busy || !user}
+            className="py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-50">
+            Save details
+          </button>
+        </form>
+      </section>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm" aria-labelledby="passkeys-heading">
+        <h2 id="passkeys-heading" className="text-lg font-semibold text-gray-800 mb-4">Passkeys</h2>
+        {credentials === null ? (
+          !error && <p className="text-sm text-gray-600">Loading passkeys…</p>
+        ) : credentials.length === 0 ? (
+          <p className="text-sm text-gray-600">No passkeys found.</p>
+        ) : (
+          <ul className="divide-y divide-gray-200">
+            {credentials.map((c) => (
+              <li key={c.id} className="py-4 flex items-start gap-3">
+                {c.providerIcon ? (
+                  <img src={c.providerIcon} alt="" width={32} height={32} className="mt-0.5 shrink-0" />
+                ) : (
+                  <span className="mt-0.5 size-8 shrink-0 rounded bg-gray-100" aria-hidden="true" />
+                )}
+                <div className="min-w-0 flex-1">
+                  {editingId === c.id ? (
+                    <form
+                      onSubmit={(e) => { e.preventDefault(); saveRename(c.id); }}
+                      className="flex flex-wrap gap-2"
+                    >
+                      <label htmlFor={`rename-${c.id}`} className="sr-only">Passkey name</label>
+                      <input id={`rename-${c.id}`} className={`${inputClass} flex-1`} required maxLength={64}
+                        autoFocus value={editName} onChange={(e) => setEditName(e.target.value)} />
+                      <button type="submit" disabled={busy} className={buttonClass}>Save</button>
+                      <button type="button" onClick={() => setEditingId(null)} className={buttonClass}>Cancel</button>
+                    </form>
+                  ) : (
+                    <>
+                      <p className="font-medium text-gray-900 truncate">{c.name}</p>
+                      <p className="text-xs text-gray-600">
+                        Created {formatDate(c.registeredAt)}
+                        {c.lastUsedAt ? ` · Last used ${formatDate(c.lastUsedAt)}` : ''}
+                      </p>
+                    </>
+                  )}
+                </div>
+                {editingId !== c.id && (
+                  <div className="flex gap-2 shrink-0">
+                    <button type="button" className={buttonClass} disabled={busy}
+                      aria-label={`Rename ${c.name}`}
+                      onClick={() => { setEditingId(c.id); setEditName(c.name); }}>
+                      Rename
+                    </button>
+                    <button type="button" className={`${buttonClass} text-red-700`} disabled={busy}
+                      aria-label={`Delete ${c.name}`} onClick={() => remove(c)}>
+                      Delete
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+    </div>
+  );
+}
