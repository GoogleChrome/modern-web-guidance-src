+  <script>
+    (function () {
+      var hero = document.querySelector('.hero');
+      var mainSlot = document.getElementById('main-video-slot');
+      var heroSlot = document.getElementById('hero-video-slot');
+      var iframe = document.getElementById('roast-video');
+      var button = document.getElementById('theater-toggle');
+      var theater = false;
+
+      // Last known playback info, reported by the YouTube player via postMessage.
+      // Only needed for the fallback path, where moving the iframe reloads it.
+      var state = { time: 0, playing: false };
+
+      window.addEventListener('message', function (e) {
+        if (e.source !== iframe.contentWindow) return;
+        var data;
+        try { data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data; } catch (_) { return; }
+        if (!data || data.event !== 'infoDelivery' || !data.info) return;
+        if (typeof data.info.currentTime === 'number') state.time = data.info.currentTime;
+        if (typeof data.info.playerState === 'number') state.playing = data.info.playerState === 1;
+      });
+
+      // Ask the player to start streaming state updates (required with enablejsapi=1)
+      function listen() {
+        iframe.contentWindow.postMessage(JSON.stringify({ event: 'listening', id: 1 }), '*');
+      }
+      iframe.addEventListener('load', listen);
+
+      function reparent(target) {
+        // Node.moveBefore() (Chrome 133+) moves a node atomically without
+        // reloading the iframe or resetting its state.
+        if (typeof target.moveBefore === 'function') {
+          target.moveBefore(iframe, null);
+          return;
+        }
+
+        // Fallback: appendChild unloads and reloads the iframe. Restore position
+        // and play state by reloading with start/autoplay parameters.
+        var resumeAt = Math.floor(state.time);
+        var wasPlaying = state.playing;
+        target.appendChild(iframe);
+        var url = new URL(iframe.src);
+        url.searchParams.set('start', resumeAt);
+        url.searchParams.set('autoplay', wasPlaying ? '1' : '0');
+        iframe.src = url.toString();
+      }
+
+      button.addEventListener('click', function () {
+        theater = !theater;
+        hero.classList.toggle('theater', theater);
+        reparent(theater ? heroSlot : mainSlot);
+        button.setAttribute('aria-pressed', String(theater));
+        button.textContent = theater ? 'Exit theater mode' : 'Theater mode';
+        if (theater) hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
+      });
+    })();
+  </script>
