+  <script>
+    const iframe = document.getElementById('roast-video');
+    const home = document.getElementById('video-home');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const toggle = document.getElementById('theater-toggle');
+
+    // moveBefore() moves the node atomically, so the iframe keeps playing.
+    // Browsers without it (or if it throws) fall back to insertBefore(),
+    // which reloads the iframe and resets playback.
+    function moveIframe(parent) {
+      if ('moveBefore' in Element.prototype) {
+        try {
+          parent.moveBefore(iframe, null);
+          return;
+        } catch (e) { /* fall through */ }
+      }
+      parent.insertBefore(iframe, null);
+    }
+
+    toggle.addEventListener('click', () => {
+      const entering = toggle.getAttribute('aria-pressed') === 'false';
+      moveIframe(entering ? heroSlot : home);
+      toggle.setAttribute('aria-pressed', String(entering));
+      toggle.textContent = entering ? 'Exit theater mode' : 'Theater mode';
+      if (entering) heroSlot.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+    });
+  </script>
+
