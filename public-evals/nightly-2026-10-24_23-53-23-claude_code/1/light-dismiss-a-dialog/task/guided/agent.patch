+  <dialog id="logout-dialog" class="logout-dialog" closedby="any" aria-labelledby="logout-title">
+    <h2 id="logout-title">Are you sure?</h2>
+    <div class="actions">
+      <a href="/logout" class="btn">Yes, log out</a>
+      <button type="button" class="btn" id="logout-cancel">Cancel</button>
+    </div>
+  </dialog>
+
+  <script>
+    const logoutDialog = document.getElementById('logout-dialog');
+
+    document.querySelector('.test-dialog-trigger').addEventListener('click', () => logoutDialog.showModal());
+    document.getElementById('logout-cancel').addEventListener('click', () => logoutDialog.close());
+
+    // Fallback for browsers without closedby support: close on backdrop click
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      logoutDialog.addEventListener('click', (event) => {
+        if (event.target !== logoutDialog) return;
+        const rect = logoutDialog.getBoundingClientRect();
+        const inside = rect.top <= event.clientY && event.clientY <= rect.bottom &&
+          rect.left <= event.clientX && event.clientX <= rect.right;
+        if (!inside) logoutDialog.close();
+      });
+    }
+  </script>
