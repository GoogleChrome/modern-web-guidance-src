+  <script type="module">
+    const DB_NAME = 'daily-grind-notes';
+    const KEY_ID = 'courier-key';
+    const encoder = new TextEncoder();
+
+    const form = document.getElementById('notes-form');
+    const noteEl = document.getElementById('note-text');
+    const statusEl = document.getElementById('notes-status');
+    const envelopeEl = document.getElementById('notes-envelope');
+    const decryptBtn = document.getElementById('decrypt-btn');
+
+    let keys = null;
+    let envelope = null;
+
+    const toB64 = (bytes) => btoa(String.fromCharCode(...bytes));
+
+    function supportsPostQuantum() {
+      return typeof globalThis.SubtleCrypto?.supports === 'function' &&
+        SubtleCrypto.supports('encapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305');
+    }
+
+    function openDb() {
+      return new Promise((resolve, reject) => {
+        const req = indexedDB.open(DB_NAME, 1);
+        req.onupgradeneeded = () => req.result.createObjectStore('keys');
+        req.onsuccess = () => resolve(req.result);
+        req.onerror = () => reject(req.error);
+      });
+    }
+
+    async function dbRequest(mode, fn) {
+      const db = await openDb();
+      return new Promise((resolve, reject) => {
+        const req = fn(db.transaction('keys', mode).objectStore('keys'));
+        req.onsuccess = () => resolve(req.result);
+        req.onerror = () => reject(req.error);
+      });
+    }
+
+    // Non-extractable key pairs are persisted via structured clone; private bytes never leave the browser.
+    async function loadKeys() {
+      const stored = await dbRequest('readonly', (s) => s.get(KEY_ID)).catch(() => null);
+      if (stored) return stored;
+
+      let record;
+      if (supportsPostQuantum()) {
+        const keyPair = await crypto.subtle.generateKey('MLKEM768-X25519', false, ['encapsulateKey', 'decapsulateKey']);
+        record = { suite: 'MLKEM768-X25519+ChaCha20-Poly1305', keyPair };
+      } else {
+        const keyPair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+        record = { suite: 'X25519+HKDF+AES-GCM', keyPair };
+      }
+      await dbRequest('readwrite', (s) => s.put(record, KEY_ID)).catch(() => {});
+      return record;
+    }
+
+    async function deriveFallbackKey(privateKey, peerPublicKey, info) {
+      const bits = await crypto.subtle.deriveBits({ name: 'X25519', public: peerPublicKey }, privateKey, 256);
+      const hkdfKey = await crypto.subtle.importKey('raw', bits, 'HKDF', false, ['deriveKey']);
+      return crypto.subtle.deriveKey(
+        { name: 'HKDF', hash: 'SHA-256', salt: new Uint8Array(32), info },
+        hkdfKey,
+        { name: 'AES-GCM', length: 256 },
+        false,
+        ['encrypt', 'decrypt'],
+      );
+    }
+
+    // Returns the AEAD key plus the capsule the recipient needs to recover it.
+    async function establishSenderKey({ suite, keyPair }) {
+      const info = encoder.encode(suite);
+      if (suite.startsWith('MLKEM768-X25519')) {
+        const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+          'MLKEM768-X25519', keyPair.publicKey, 'ChaCha20-Poly1305', false, ['encrypt', 'decrypt']);
+        return { key: sharedKey, capsule: new Uint8Array(ciphertext) };
+      }
+      const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+      const capsule = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+      const key = await deriveFallbackKey(ephemeral.privateKey, keyPair.publicKey, info);
+      return { key, capsule };
+    }
+
+    async function recoverKey({ suite, keyPair }, capsule) {
+      if (suite.startsWith('MLKEM768-X25519')) {
+        return crypto.subtle.decapsulateKey(
+          'MLKEM768-X25519', keyPair.privateKey, capsule, 'ChaCha20-Poly1305', false, ['encrypt', 'decrypt']);
+      }
+      const ephemeralPublic = await crypto.subtle.importKey('raw', capsule, 'X25519', true, []);
+      return deriveFallbackKey(keyPair.privateKey, ephemeralPublic, encoder.encode(suite));
+    }
+
+    // Suite and version are authenticated but unencrypted metadata.
+    const aadFor = (suite) => encoder.encode(`daily-grind-delivery-note-v1|${suite}`);
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      statusEl.textContent = 'Encrypting…';
+      decryptBtn.hidden = true;
+      try {
+        keys ??= await loadKeys();
+        const { key, capsule } = await establishSenderKey(keys);
+        const iv = crypto.getRandomValues(new Uint8Array(12));
+        const ciphertext = new Uint8Array(await crypto.subtle.encrypt(
+          { name: key.algorithm.name, iv, additionalData: aadFor(keys.suite) },
+          key,
+          encoder.encode(noteEl.value),
+        ));
+        envelope = { suite: keys.suite, capsule, iv, ciphertext };
+        envelopeEl.textContent = JSON.stringify({
+          suite: keys.suite,
+          capsule: toB64(capsule),
+          iv: toB64(iv),
+          ciphertext: toB64(ciphertext),
+        }, null, 2);
+        envelopeEl.hidden = false;
+        decryptBtn.hidden = false;
+        noteEl.value = '';
+        statusEl.textContent = keys.suite.startsWith('MLKEM')
+          ? 'Note encrypted with hybrid post-quantum protection (ML-KEM-768 + X25519, ChaCha20-Poly1305).'
+          : 'Note encrypted (X25519 + HKDF + AES-GCM). This browser lacks post-quantum support.';
+      } catch (err) {
+        console.error(err);
+        statusEl.textContent = 'Encryption failed in this browser. Your note was not sent.';
+      }
+    });
+
+    decryptBtn.addEventListener('click', async () => {
+      try {
+        const key = await recoverKey(keys, envelope.capsule);
+        const plain = await crypto.subtle.decrypt(
+          { name: key.algorithm.name, iv: envelope.iv, additionalData: aadFor(envelope.suite) },
+          key,
+          envelope.ciphertext,
+        );
+        statusEl.textContent = `Decrypted and authenticated: "${new TextDecoder().decode(plain)}"`;
+      } catch (err) {
+        console.error(err);
+        statusEl.textContent = 'Decryption failed: the note could not be authenticated.';
+      }
+    });
+  </script>
