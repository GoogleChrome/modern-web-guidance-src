diff --git a/tools/decrypt-note.mjs b/tools/decrypt-note.mjs
new file mode 100644
index 0000000..7f67283
--- /dev/null
+++ b/tools/decrypt-note.mjs
@@ -0,0 +1,31 @@
+// Usage: node tools/decrypt-note.mjs <note.json> [private-key.json]
+import { readFile } from 'node:fs/promises';
+
+const [notePath, keyPath = '.secrets/delivery-notes-private.json'] = process.argv.slice(2);
+const s = crypto.subtle;
+const unb64 = (str) => new Uint8Array(Buffer.from(str, 'base64'));
+const enc = new TextEncoder();
+
+const note = JSON.parse(await readFile(notePath, 'utf8'));
+const priv = JSON.parse(await readFile(keyPath, 'utf8'));
+if (note.v !== 1 || note.keyId !== priv.keyId) throw new Error('Note was not encrypted to this key');
+
+const xPriv = await s.importKey('jwk', priv.x25519, 'X25519', false, ['deriveBits']);
+const epk = await s.importKey('raw', unb64(note.epk), 'X25519', false, []);
+const parts = [new Uint8Array(await s.deriveBits({ name: 'X25519', public: epk }, xPriv, 256))];
+if (note.suite.includes('MLKEM768')) {
+  const pqPriv = await s.importKey('raw-seed', unb64(priv.mlkem768Seed), 'ML-KEM-768', false, ['decapsulateBits']);
+  parts.push(new Uint8Array(await s.decapsulateBits('ML-KEM-768', pqPriv, unb64(note.kemCt))));
+}
+
+const header = JSON.stringify({ v: note.v, suite: note.suite, keyId: note.keyId, epk: note.epk, kemCt: note.kemCt ?? null });
+const ikm = new Uint8Array(parts.reduce((n, p) => n + p.length, 0));
+let off = 0;
+for (const p of parts) { ikm.set(p, off); off += p.length; }
+const info = new Uint8Array([...enc.encode('daily-grind/delivery-notes/v1|'), ...new Uint8Array(await s.digest('SHA-256', enc.encode(header)))]);
+const base = await s.importKey('raw', ikm, 'HKDF', false, ['deriveKey']);
+const key = await s.deriveKey(
+  { name: 'HKDF', hash: 'SHA-256', salt: new Uint8Array(32), info: info },
+  base, { name: 'AES-GCM', length: 256 }, false, ['decrypt']);
+const pt = await s.decrypt({ name: 'AES-GCM', iv: unb64(note.iv), additionalData: enc.encode(header) }, key, unb64(note.ciphertext));
+console.log(new TextDecoder().decode(pt));
diff --git a/tools/keygen.mjs b/tools/keygen.mjs
new file mode 100644
index 0000000..a8c64ff
--- /dev/null
+++ b/tools/keygen.mjs
@@ -0,0 +1,23 @@
+// Generates the store's delivery-notes keypair (X25519 + ML-KEM-768).
+// Public half -> delivery-notes-key.json (served with the site).
+// Private half -> .secrets/delivery-notes-private.json (gitignored; keep offline).
+import { mkdir, writeFile } from 'node:fs/promises';
+
+const s = crypto.subtle;
+const b64 = (buf) => Buffer.from(buf).toString('base64');
+
+const x = await s.generateKey('X25519', true, ['deriveBits']);
+const pq = await s.generateKey('ML-KEM-768', true, ['encapsulateBits', 'decapsulateBits']);
+
+const xPub = await s.exportKey('raw', x.publicKey);
+const pqPub = await s.exportKey('raw-public', pq.publicKey);
+const keyId = b64(new Uint8Array(await s.digest('SHA-256', Buffer.concat([Buffer.from(xPub), Buffer.from(pqPub)]))).slice(0, 8));
+
+await writeFile('delivery-notes-key.json', JSON.stringify({ v: 1, keyId, x25519: b64(xPub), mlkem768: b64(pqPub) }, null, 2) + '\n');
+await mkdir('.secrets', { recursive: true });
+await writeFile('.secrets/delivery-notes-private.json', JSON.stringify({
+  v: 1, keyId,
+  x25519: await s.exportKey('jwk', x.privateKey),
+  mlkem768Seed: b64(await s.exportKey('raw-seed', pq.privateKey)),
+}, null, 2) + '\n', { mode: 0o600 });
+console.log('keyId', keyId);
