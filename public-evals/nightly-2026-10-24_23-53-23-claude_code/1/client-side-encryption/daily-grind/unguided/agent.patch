+// Client-side encrypted delivery notes.
+// Key establishment: X25519 ECDH (ephemeral) + ML-KEM-768 encapsulation, combined via HKDF-SHA256 (hybrid).
+// Payload: AES-256-GCM with the KEM transcript bound in as AAD and in the HKDF info.
+// Browsers without ML-KEM in WebCrypto can only use X25519 if the customer explicitly allows it.
+const SUITE_HYBRID = 'X25519+MLKEM768/HKDF-SHA256/AES-256-GCM';
+const SUITE_CLASSICAL = 'X25519/HKDF-SHA256/AES-256-GCM';
+const enc = new TextEncoder();
+const subtle = crypto.subtle;
+
+const b64 = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf)));
+const unb64 = (str) => Uint8Array.from(atob(str), (c) => c.charCodeAt(0));
+
+async function supportsMlKem() {
+  try {
+    await subtle.generateKey('ML-KEM-768', false, ['encapsulateBits', 'decapsulateBits']);
+    return typeof subtle.encapsulateBits === 'function';
+  } catch {
+    return false;
+  }
+}
+
+async function supportsX25519() {
+  try {
+    await subtle.generateKey('X25519', false, ['deriveBits']);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+async function encryptNote(plaintext, recipient, { allowClassical }) {
+  const pq = await supportsMlKem();
+  if (!(await supportsX25519())) throw new Error('This browser does not support X25519 encryption.');
+  if (!pq && !allowClassical) throw new Error('This browser lacks post-quantum support. Tick the box to allow classical-only protection.');
+
+  const eph = await subtle.generateKey('X25519', false, ['deriveBits']);
+  const epkRaw = await subtle.exportKey('raw', eph.publicKey);
+  const rcptX = await subtle.importKey('raw', unb64(recipient.x25519), 'X25519', false, []);
+  const secrets = [new Uint8Array(await subtle.deriveBits({ name: 'X25519', public: rcptX }, eph.privateKey, 256))];
+
+  let kemCt = null;
+  if (pq) {
+    const rcptPq = await subtle.importKey('raw-public', unb64(recipient.mlkem768), 'ML-KEM-768', false, ['encapsulateBits']);
+    const { sharedKey, ciphertext } = await subtle.encapsulateBits('ML-KEM-768', rcptPq);
+    secrets.push(new Uint8Array(sharedKey));
+    kemCt = b64(ciphertext);
+  }
+
+  const header = JSON.stringify({ v: 1, suite: pq ? SUITE_HYBRID : SUITE_CLASSICAL, keyId: recipient.keyId, epk: b64(epkRaw), kemCt });
+  const ikm = new Uint8Array(secrets.reduce((n, s) => n + s.length, 0));
+  let off = 0;
+  for (const s of secrets) { ikm.set(s, off); off += s.length; }
+
+  const info = new Uint8Array([...enc.encode('daily-grind/delivery-notes/v1|'), ...new Uint8Array(await subtle.digest('SHA-256', enc.encode(header)))]);
+const base = await subtle.importKey('raw', ikm, 'HKDF', false, ['deriveKey']);
+  const key = await subtle.deriveKey(
+    { name: 'HKDF', hash: 'SHA-256', salt: new Uint8Array(32), info: info },
+    base, { name: 'AES-GCM', length: 256 }, false, ['encrypt']);
+  ikm.fill(0);
+
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const ct = await subtle.encrypt({ name: 'AES-GCM', iv, additionalData: enc.encode(header) }, key, enc.encode(plaintext));
+  return { ...JSON.parse(header), iv: b64(iv), ciphertext: b64(ct) };
+}
+
+const form = document.getElementById('dn-form');
+if (form) {
+  const status = document.getElementById('dn-status');
+  const out = document.getElementById('dn-output');
+  const result = document.getElementById('dn-result');
+  const download = document.getElementById('dn-download');
+  const classical = document.getElementById('dn-classical');
+  let recipient;
+  let blobUrl;
+
+  const keyReady = fetch('delivery-notes-key.json')
+    .then((r) => { if (!r.ok) throw new Error(r.status); return r.json(); })
+    .then((k) => { recipient = k; });
+  Promise.all([keyReady, supportsMlKem()]).then(([, pq]) => {
+    status.textContent = pq
+      ? 'Hybrid post-quantum protection (X25519 + ML-KEM-768) is active.'
+      : 'Your browser has no ML-KEM support; only classical X25519 protection is available.';
+    classical.parentElement.hidden = pq;
+  }).catch(() => { status.textContent = 'Could not load the store encryption key; notes are unavailable.'; });
+
+  form.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    const note = form.elements.note.value.trim();
+    if (!note || !recipient) return;
+    try {
+      const envelope = await encryptNote(note, recipient, { allowClassical: classical.checked });
+      const json = JSON.stringify(envelope, null, 2);
+      out.value = json;
+      if (blobUrl) URL.revokeObjectURL(blobUrl);
+      blobUrl = URL.createObjectURL(new Blob([json], { type: 'application/json' }));
+      download.href = blobUrl;
+      result.hidden = false;
+      form.elements.note.value = '';
+    } catch (err) {
+      status.textContent = err.message;
+    }
+  });
+
+  document.getElementById('dn-copy').addEventListener('click', () => navigator.clipboard?.writeText(out.value));
+}
