diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -151,13 +151,122 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Scroll container */
+    body {
+      overflow: hidden;
+    }
+
+    .scroller {
+      position: relative;
+      height: 100dvh;
+      overflow-y: auto;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .scroller {
+        scroll-behavior: smooth;
+      }
+    }
+
+    /* Sentinel covering the first 200px of the scroller; used by the fallback */
+    .scroller-top {
+      position: absolute;
+      inset: 0 0 auto 0;
+      height: 200px;
+      pointer-events: none;
+    }
+
+    /* Back to top: zero net height, sticks to the bottom of the scrollport */
+    .back-to-top {
+      position: sticky;
+      bottom: 1.5rem;
+      display: block;
+      width: 3rem;
+      height: 3rem;
+      margin: -3rem 1.5rem 0 auto;
+      border: 0;
+      border-radius: 50%;
+      background: var(--primary);
+      color: white;
+      font-size: 1.5rem;
+      line-height: 1;
+      cursor: pointer;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
+      z-index: 900;
+      /* visibility:hidden also removes it from the tab order and a11y tree */
+      visibility: hidden;
+      opacity: 0;
+    }
+
+    .back-to-top:hover {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @keyframes back-to-top-reveal {
+      from {
+        visibility: hidden;
+        opacity: 0;
+      }
+
+      to {
+        visibility: visible;
+        opacity: 1;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @keyframes back-to-top-reveal {
+        from {
+          visibility: hidden;
+          opacity: 0;
+          translate: 0 1rem;
+        }
+
+        to {
+          visibility: visible;
+          opacity: 1;
+          translate: 0 0;
+        }
+      }
+    }
+
+    /* Native: driven by the scroller's scroll position, no JS */
+    @supports ((animation-timeline: scroll()) and (animation-range: 0 100px)) {
+      .back-to-top {
+        animation: back-to-top-reveal linear both;
+        animation-timeline: scroll(nearest block);
+        animation-range: 0 200px;
+      }
+    }
+
+    /* Fallback: class toggled by an IntersectionObserver */
+    @supports not ((animation-timeline: scroll()) and (animation-range: 0 100px)) {
+      .back-to-top {
+        transition: opacity 0.3s, translate 0.3s, visibility 0.3s;
+      }
+
+      .back-to-top.is-visible {
+        visibility: visible;
+        opacity: 1;
+      }
+    }
   </style>
 </head>
 
 <body>
 
+  <div class="scroller" id="scroller">
+    <div class="scroller-top" aria-hidden="true"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +315,27 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+    <button type="button" class="back-to-top" aria-label="Back to top">&uarr;</button>
+  </div>
+
+  <script>
+    const scroller = document.querySelector('.scroller');
+    const backToTop = scroller.querySelector('.back-to-top');
+
+    backToTop.addEventListener('click', () => {
+      scroller.scrollTo({ top: 0 });
+      scroller.querySelector('nav a').focus({ preventScroll: true });
+    });
+
+    // Browsers without scroll-driven animations: toggle via IntersectionObserver
+    if (!CSS.supports('(animation-timeline: scroll()) and (animation-range: 0 100px)')) {
+      new IntersectionObserver(([entry]) => {
+        backToTop.classList.toggle('is-visible', !entry.isIntersecting);
+      }, { root: scroller }).observe(scroller.querySelector('.scroller-top'));
+    }
+  </script>
+
 </body>
 
 </html>
