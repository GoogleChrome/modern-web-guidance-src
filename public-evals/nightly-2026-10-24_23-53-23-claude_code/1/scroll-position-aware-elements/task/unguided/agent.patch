+  <button type="button" class="back-to-top" aria-label="Back to top">
+    <span aria-hidden="true">&uarr;</span>
+  </button>
+  </div>
+
+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var button = scroller.querySelector('.back-to-top');
+      var sentinel = scroller.querySelector('.scroller-top-sentinel');
+
+      // Observe a sentinel at the top of the container instead of listening to scroll events
+      new IntersectionObserver(function (entries) {
+        button.classList.toggle('is-visible', !entries[entries.length - 1].isIntersecting);
+      }, { root: scroller }).observe(sentinel);
+
+      button.addEventListener('click', function () {
+        scroller.scrollTo({ top: 0 });
+        // Move focus to the top so keyboard users don't lose their place when the button hides
+        var first = scroller.querySelector('nav a');
+        if (first) first.focus({ preventScroll: true });
+      });
+    })();
+  </script>
+
