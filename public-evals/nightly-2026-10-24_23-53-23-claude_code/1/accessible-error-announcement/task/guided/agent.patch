+
+  <script>
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const email = document.getElementById('newsletter-email');
+      const status = document.getElementById('newsletter-status');
+
+      // aria-invalid mirrors the visual :user-invalid state, so screen readers
+      // announce the error only when the visual message is shown.
+      const syncAria = () => {
+        email.setAttribute('aria-invalid', email.matches(':user-invalid') ? 'true' : 'false');
+      };
+
+      email.addEventListener('blur', syncAria);
+      email.addEventListener('input', () => {
+        status.textContent = '';
+        if (email.checkValidity()) {
+          // Clear immediately once valid
+          email.setAttribute('aria-invalid', 'false');
+        } else if (email.hasAttribute('aria-invalid')) {
+          syncAria();
+        }
+      });
+      // A failed submit attempt counts as interaction and shows the error
+      email.addEventListener('invalid', () => email.setAttribute('aria-invalid', 'true'));
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        status.textContent = 'Thanks for subscribing!';
+        form.reset();
+        email.removeAttribute('aria-invalid');
+      });
+    })();
+  </script>
 </body>
 
 </html>
