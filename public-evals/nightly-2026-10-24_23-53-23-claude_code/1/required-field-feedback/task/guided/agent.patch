+  <script>
+    // Mirror the visual :user-invalid state to assistive tech
+    const mailingForm = document.getElementById('mailing-list-form');
+    const mailingEmail = document.getElementById('mailing-email');
+
+    const syncAriaInvalid = () => {
+      if (mailingEmail.matches(':user-invalid')) {
+        mailingEmail.setAttribute('aria-invalid', 'true');
+      } else {
+        mailingEmail.removeAttribute('aria-invalid');
+      }
+    };
+
+    mailingEmail.addEventListener('blur', syncAriaInvalid);
+    mailingEmail.addEventListener('input', () => {
+      if (mailingEmail.hasAttribute('aria-invalid')) syncAriaInvalid();
+    });
+    mailingForm.addEventListener('invalid', syncAriaInvalid, true);
+  </script>
+
 </body>
 
