+  <script>
+    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      const pageOf = (url) => Number(new URL(url).searchParams.get('page')) || 1;
+
+      window.addEventListener('pagereveal', (event) => {
+        const activation = window.navigation && navigation.activation;
+        if (!event.viewTransition || !activation || !activation.from) return;
+
+        const from = pageOf(activation.from.url);
+        const to = pageOf(activation.entry.url);
+        if (to > from) {
+          event.viewTransition.types.add('next');
+        } else if (to < from) {
+          event.viewTransition.types.add('previous');
+        }
+      });
+    }
+  </script>
