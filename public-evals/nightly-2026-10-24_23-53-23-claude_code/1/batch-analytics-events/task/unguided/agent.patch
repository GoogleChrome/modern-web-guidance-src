@@ -206,7 +206,66 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      var ENDPOINT = '/api/analytics';
+      var DEBOUNCE_MS = 1000;
+      var MAX_BATCH = 20;
+      var queue = [];
+      var timer = null;
+
+      function flush() {
+        clearTimeout(timer);
+        timer = null;
+        if (!queue.length) return;
+        var body = JSON.stringify({ events: queue.splice(0) });
+        try {
+          if (navigator.sendBeacon &&
+              navigator.sendBeacon(ENDPOINT, new Blob([body], { type: 'application/json' }))) {
+            return;
+          }
+          fetch(ENDPOINT, {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: body,
+            keepalive: true
+          }).catch(function () {});
+        } catch (e) { /* analytics must never break the page */ }
+      }
+
+      function track(type, data) {
+        queue.push({
+          type: type,
+          data: data || {},
+          path: location.pathname,
+          ts: Date.now()
+        });
+        if (queue.length >= MAX_BATCH) return flush();
+        clearTimeout(timer);
+        timer = setTimeout(flush, DEBOUNCE_MS);
+      }
+
+      track('page_view', { referrer: document.referrer, title: document.title });
+
+      document.addEventListener('click', function (e) {
+        var el = e.target.closest && e.target.closest('a, button');
+        if (!el) return;
+        track('click', {
+          tag: el.tagName.toLowerCase(),
+          text: (el.textContent || '').trim().slice(0, 80),
+          href: el.getAttribute('href') || undefined,
+          cls: el.className || undefined
+        });
+      }, true);
+
+      // Flush pending events when the user leaves or navigates away
+      document.addEventListener('visibilitychange', function () {
+        if (document.visibilityState === 'hidden') flush();
+      });
+      window.addEventListener('pagehide', flush);
+    })();
+  </script>
 </body>
 
 </html>
