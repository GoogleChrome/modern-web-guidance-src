+  <script>
+    const form = document.getElementById('feedback-form');
+    const messageInput = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const statusEl = document.getElementById('detect-status');
+    const progressEl = document.getElementById('detect-progress');
+
+    let detector;
+
+    async function checkSupport() {
+      if (!('LanguageDetector' in self)) {
+        return 'Language detection is not supported in this browser.';
+      }
+      const availability = await LanguageDetector.availability();
+      if (availability === 'unavailable') {
+        return 'Language detection is not available on this device.';
+      }
+      return null;
+    }
+
+    checkSupport().then((problem) => {
+      if (problem) {
+        detectBtn.disabled = true;
+        statusEl.textContent = problem;
+      }
+    });
+
+    async function getDetector() {
+      if (detector) return detector;
+      // Creating the detector must happen in a user gesture in case a download is needed.
+      detector = await LanguageDetector.create({
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const percent = Math.round(e.loaded * 100);
+            progressEl.hidden = false;
+            progressEl.value = percent;
+            statusEl.textContent = `Downloading language model: ${percent}%`;
+          });
+        },
+      });
+      return detector;
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      detectBtn.disabled = true;
+      statusEl.textContent = 'Detecting…';
+      try {
+        const results = await (await getDetector()).detect(messageInput.value);
+        const [top] = results;
+        if (!top || top.detectedLanguage === 'und') {
+          statusEl.textContent = 'Could not determine the language.';
+        } else {
+          const name = new Intl.DisplayNames(['en'], { type: 'language' })
+            .of(top.detectedLanguage);
+          const confidence = (top.confidence * 100).toFixed(1);
+          statusEl.textContent = `Detected language: ${name} (${confidence}% confident)`;
+        }
+      } catch (err) {
+        statusEl.textContent = `Detection failed: ${err.message}`;
+      } finally {
+        progressEl.hidden = true;
+        detectBtn.disabled = false;
+      }
+    });
+  </script>
 </body>
 
