     </section>
   </main>
 
   <footer>
+    <form class="newsletter" id="newsletter" novalidate>
+      <h3>Join our newsletter</h3>
+      <div class="newsletter-row">
+        <input type="email" id="newsletter-email" name="email" placeholder="you@example.com"
+          aria-label="Email address" aria-describedby="newsletter-msg" autocomplete="email" required>
