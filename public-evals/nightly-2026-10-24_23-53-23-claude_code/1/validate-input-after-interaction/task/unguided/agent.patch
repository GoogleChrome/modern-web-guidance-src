@@ -206,7 +269,48 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      var form = document.getElementById('newsletter');
+      var input = document.getElementById('newsletter-email');
+      var msg = document.getElementById('newsletter-msg');
+      var touched = false;
+
+      function validate() {
+        var value = input.value.trim();
+        var error = '';
+        if (!value) error = 'Please enter your email address.';
+        else if (!input.validity.valid) error = 'Please enter a valid email address.';
+        input.setAttribute('aria-invalid', error ? 'true' : 'false');
+        msg.textContent = error;
+        msg.className = 'newsletter-msg' + (error ? ' error' : '');
+        return !error;
+      }
+
+      // Validate only once the user leaves the field; after that, re-check
+      // while typing so the error clears as soon as the email is fixed.
+      input.addEventListener('blur', function () {
+        touched = true;
+        validate();
+      });
+      input.addEventListener('input', function () {
+        if (touched) validate();
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        touched = true;
+        if (!validate()) return;
+        // TODO: send to newsletter backend
+        form.reset();
+        touched = false;
+        input.removeAttribute('aria-invalid');
+        msg.textContent = 'Thanks for subscribing!';
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
