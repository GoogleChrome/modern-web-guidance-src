+
+  <script>
+    // Keep aria-invalid in sync with :user-invalid (set on blur/submit, cleared while correcting)
+    const emailInput = document.getElementById('newsletter-email');
+    const syncAria = () => emailInput.setAttribute('aria-invalid', emailInput.matches(':user-invalid'));
+    emailInput.addEventListener('blur', syncAria);
+    emailInput.addEventListener('invalid', syncAria);
+    emailInput.addEventListener('input', () => {
+      if (emailInput.hasAttribute('aria-invalid')) syncAria();
+    });
+  </script>
