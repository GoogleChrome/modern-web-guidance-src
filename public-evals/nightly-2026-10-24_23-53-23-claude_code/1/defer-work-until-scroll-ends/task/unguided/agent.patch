+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var status = document.getElementById('status');
+      var beans = scroller.querySelectorAll('.bean');
+      var scrolling = false;
+      var timer = null;
+      var hasScrollEnd = 'onscrollend' in window;
+
+      // Only layout reads happen here, once per scroll gesture.
+      function mostVisibleOrigin() {
+        var box = scroller.getBoundingClientRect();
+        var best = null;
+        var bestVisible = -1;
+        for (var i = 0; i < beans.length; i++) {
+          var r = beans[i].getBoundingClientRect();
+          var visible = Math.min(r.right, box.right) - Math.max(r.left, box.left);
+          if (visible > bestVisible) {
+            bestVisible = visible;
+            best = beans[i];
+          }
+        }
+        return best.dataset.origin;
+      }
+
+      function onScrollEnd() {
+        scrolling = false;
+        status.textContent = 'Scroll ended. Visible: ' + mostVisibleOrigin();
+      }
+
+      // Per-event work is a flag check (DOM is written only on the first event),
+      // plus a debounce timer for browsers without the scrollend event.
+      scroller.addEventListener('scroll', function () {
+        if (!scrolling) {
+          scrolling = true;
+          status.textContent = 'Scrolling...';
+        }
+        if (!hasScrollEnd) {
+          clearTimeout(timer);
+          timer = setTimeout(onScrollEnd, 150);
+        }
+      }, { passive: true });
+
+      if (hasScrollEnd) {
+        scroller.addEventListener('scrollend', onScrollEnd);
+      }
+    })();
+  </script>
