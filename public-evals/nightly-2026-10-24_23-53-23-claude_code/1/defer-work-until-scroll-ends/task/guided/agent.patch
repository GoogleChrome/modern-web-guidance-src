+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const cards = scroller.querySelectorAll('.bean-card');
+    let scrolling = false;
+    let timer;
+
+    function mostVisibleOrigin() {
+      const box = scroller.getBoundingClientRect();
+      let best = null;
+      let bestWidth = -1;
+      for (const card of cards) {
+        const r = card.getBoundingClientRect();
+        const visible = Math.min(r.right, box.right) - Math.max(r.left, box.left);
+        if (visible > bestWidth) {
+          bestWidth = visible;
+          best = card;
+        }
+      }
+      return best.dataset.origin;
+    }
+
+    function onScrollEnd() {
+      scrolling = false;
+      status.textContent = `Scroll ended. Visible: ${mostVisibleOrigin()}`;
+    }
+
+    // Scroll handler only touches the DOM on the first event of a scroll gesture.
+    scroller.addEventListener('scroll', () => {
+      if (!scrolling) {
+        scrolling = true;
+        status.textContent = 'Scrolling...';
+      }
+      // Fallback for browsers without scrollend (Safari)
+      if (!supportsScrollEnd) {
+        clearTimeout(timer);
+        timer = setTimeout(onScrollEnd, 150);
+      }
+    }, { passive: true });
+
+    const supportsScrollEnd = 'onscrollend' in window;
+    if (supportsScrollEnd) scroller.addEventListener('scrollend', onScrollEnd);
+  </script>
+
