+    /* Roast Selector */
+    .roast-selector {
+      position: relative;
+      margin-bottom: 1.5rem;
+      text-align: left;
+    }
+
+    .roast-label {
+      display: block;
+      font-size: 0.8rem;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      margin-bottom: 6px;
+      text-align: center;
+    }
+
+    .roast-trigger {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 16px;
+      min-width: 220px;
+      padding: 10px 14px;
+      font: inherit;
+      color: white;
+      background: var(--primary);
+      border: 1px solid var(--accent);
+      border-radius: 5px;
+      cursor: pointer;
+    }
+
+    .roast-trigger:hover,
+    .roast-trigger:focus-visible {
+      outline: none;
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.4);
+    }
+
+    .roast-arrow {
+      width: 12px;
+      height: 12px;
+      fill: none;
+      stroke: var(--accent);
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      transition: transform 0.2s;
+    }
+
+    .roast-trigger[aria-expanded="true"] .roast-arrow {
+      transform: rotate(180deg);
+    }
+
+    .roast-list {
+      position: absolute;
+      top: calc(100% + 4px);
+      left: 0;
+      right: 0;
+      z-index: 10;
+      list-style: none;
+      background: var(--primary);
+      border: 1px solid var(--accent);
+      border-radius: 5px;
+      overflow: hidden;
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
+    }
+
+    .roast-list[hidden] {
+      display: none;
+    }
+
+    .roast-option {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      padding: 10px 14px;
+      color: white;
+      cursor: pointer;
+    }
+
+    .roast-option:hover,
+    .roast-option.active {
+      background: var(--accent);
+      color: var(--primary);
+    }
+
+    .roast-check {
+      width: 14px;
+      height: 14px;
+      fill: none;
+      stroke: var(--accent);
+      stroke-width: 3;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      visibility: hidden;
+    }
+
+    .roast-option[aria-selected="true"] .roast-check {
+      visibility: visible;
+    }
+
+    /* Keep the checkmark visible against the orange highlight */
+    .roast-option:hover .roast-check,
+    .roast-option.active .roast-check {
+      stroke: var(--primary);
+    }
+
