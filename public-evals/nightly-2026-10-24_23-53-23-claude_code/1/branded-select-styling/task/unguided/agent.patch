+  <script>
+    (function () {
+      var trigger = document.getElementById('roast-trigger');
+      var list = document.getElementById('roast-list');
+      var value = document.getElementById('roast-value');
+      var options = Array.prototype.slice.call(list.querySelectorAll('[role="option"]'));
+      var active = 1;
+
+      function setActive(i) {
+        active = (i + options.length) % options.length;
+        options.forEach(function (o, n) { o.classList.toggle('active', n === active); });
+        list.setAttribute('aria-activedescendant', options[active].id);
+      }
+
+      function open() {
+        list.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        setActive(options.findIndex(function (o) { return o.getAttribute('aria-selected') === 'true'; }));
+        list.focus();
+      }
+
+      function close(refocus) {
+        list.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        options.forEach(function (o) { o.classList.remove('active'); });
+        if (refocus) trigger.focus();
+      }
+
+      function select(i) {
+        options.forEach(function (o, n) { o.setAttribute('aria-selected', n === i ? 'true' : 'false'); });
+        value.textContent = options[i].firstChild.textContent.trim();
+        document.documentElement.dataset.roast = options[i].dataset.value;
+        close(true);
+      }
+
+      trigger.addEventListener('click', function () { list.hidden ? open() : close(false); });
+      options.forEach(function (o, n) { o.addEventListener('click', function () { select(n); }); });
+
+      list.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
+        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
+        else if (e.key === 'Home') { e.preventDefault(); setActive(0); }
+        else if (e.key === 'End') { e.preventDefault(); setActive(options.length - 1); }
+        else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(active); }
+        else if (e.key === 'Escape') { close(true); }
+        else if (e.key === 'Tab') { close(false); }
+      });
+
+      document.addEventListener('click', function (e) {
+        if (!e.target.closest('.roast-selector')) close(false);
+      });
+    })();
+  </script>
