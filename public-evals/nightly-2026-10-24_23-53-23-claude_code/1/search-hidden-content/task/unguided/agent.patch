+<script>
+    const couponPanel = document.getElementById('coupon-panel');
+    const couponBtn = document.getElementById('reveal-coupon');
+
+    function revealCoupon() {
+      couponPanel.hidden = false;
+      couponBtn.disabled = true;
+      couponBtn.textContent = 'Coupon Revealed';
+    }
+
+    couponBtn.addEventListener('click', () => {
+      revealCoupon();
+      couponPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+    });
+    // Find-in-page can also open the panel; keep the button state in sync
+    couponPanel.addEventListener('beforematch', revealCoupon);
+  </script>
