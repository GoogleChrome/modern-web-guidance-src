+  <script>
+    const couponPanel = document.getElementById('coupon-panel');
+    const couponBtn = document.getElementById('reveal-coupon');
+
+    function markCouponRevealed() {
+      couponBtn.disabled = true;
+      couponBtn.textContent = 'Coupon revealed';
+    }
+
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      // No hidden="until-found" support: the button is the only way to reveal, so keep the panel hidden
+      couponPanel.setAttribute('hidden', '');
+    }
+
+    couponBtn.addEventListener('click', () => {
+      couponPanel.removeAttribute('hidden');
+      markCouponRevealed();
+      couponPanel.scrollIntoView({ block: 'nearest' });
+    });
+
+    // Find-in-page revealed the panel: keep the button in sync
+    couponPanel.addEventListener('beforematch', markCouponRevealed);
+  </script>
+
