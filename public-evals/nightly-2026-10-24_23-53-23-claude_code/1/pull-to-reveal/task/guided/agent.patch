diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -26,10 +26,49 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    /* Pull-to-reveal: search bar sits above the nav, scrolled out of view on load.
+       Proximity (not mandatory) so the rest of the page remains freely scrollable. */
+    html {
+      scroll-snap-type: y proximity;
+    }
+
+    .search-bar {
+      background: var(--secondary);
+      padding: 1rem 5%;
+      scroll-snap-align: start;
+    }
+
+    .search-bar form {
+      display: flex;
+      gap: 10px;
+      max-width: 600px;
+      margin: 0 auto;
+    }
+
+    .search-bar input {
+      flex: 1;
+      padding: 10px 14px;
+      border: 1px solid var(--primary);
+      border-radius: 4px;
+      font: inherit;
+    }
+
+    .search-bar button {
+      background: var(--primary);
+      color: white;
+      border: 0;
+      border-radius: 4px;
+      padding: 10px 20px;
+      font: inherit;
+      cursor: pointer;
+    }
+
     /* Navigation */
     nav {
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
       background: var(--primary);
       color: white;
       padding: 1rem 5%;
       display: flex;
