+  <script>
+    const drawer = document.getElementById('drawer');
+    const maxScroll = () => drawer.scrollWidth - drawer.clientWidth;
+
+    document.querySelector('.menu-btn').addEventListener('click', () => {
+      drawer.showModal();
+      drawer.scrollLeft = 0;
+    });
+    drawer.querySelector('.drawer-close').addEventListener('click', () => drawer.close());
+
+    // Tapping the transparent area beside the panel closes the drawer
+    // (covers browsers without closedby support).
+    drawer.addEventListener('click', (e) => {
+      if (e.target === drawer || e.target.hasAttribute('data-close')) drawer.close();
+    });
+
+    // Swiping the panel off-screen snaps to the end of the scroller: close.
+    drawer.addEventListener('scrollend', () => {
+      if (drawer.open && drawer.scrollLeft >= maxScroll() - 1) drawer.close();
+    });
+  </script>
+
