+    /* Drawer: the dialog is a horizontal scroll-snap container holding the
+       panel and a transparent spacer. Swiping the panel away scrolls to the
+       spacer, which closes the dialog. Escape, the back gesture and
+       light-dismiss are handled natively by <dialog>. */
+    .drawer {
+      position: fixed;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      max-width: none;
+      max-height: none;
+      margin: 0;
+      padding: 0;
+      border: 0;
+      background: rgba(0, 0, 0, 0.5);
+      color: white;
+      display: none;
+      overflow-x: auto;
+      overflow-y: hidden;
+      overscroll-behavior: contain;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+    }
+
