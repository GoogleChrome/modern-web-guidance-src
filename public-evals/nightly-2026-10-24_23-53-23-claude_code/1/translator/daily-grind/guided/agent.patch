+<script>
+    // On-device translation via the built-in Translator API (Chrome/Edge desktop).
+    const select = document.getElementById('lang-select');
+    const status = document.getElementById('lang-status');
+    const items = [...document.querySelectorAll('[data-translate]')];
+    const originals = items.map((el) => el.textContent);
+    const SOURCE = 'en';
+    const RTL = new Set(['ar', 'he']);
+    const translators = new Map();
+
+    if (!('Translator' in self)) {
+      status.textContent = 'Client-side translation is currently unsupported in this browser.';
+    } else {
+      select.disabled = false;
+    }
+
+    function restore() {
+      items.forEach((el, i) => {
+        el.textContent = originals[i];
+        el.removeAttribute('lang');
+        el.removeAttribute('dir');
+      });
+    }
+
+    async function getTranslator(target) {
+      if (translators.has(target)) return translators.get(target);
+      const options = { sourceLanguage: SOURCE, targetLanguage: target };
+      const availability = await Translator.availability(options);
+      if (availability === 'unavailable') return null;
+      const translator = await Translator.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            status.textContent = `Downloading language pack… ${Math.round(e.loaded * 100)}%`;
+          });
+        },
+      });
+      translators.set(target, translator);
+      return translator;
+    }
+
+    let requestId = 0;
+    select.addEventListener('change', async () => {
+      const target = select.value;
+      const id = ++requestId;
+      if (target === SOURCE) {
+        restore();
+        status.textContent = '';
+        return;
+      }
+      select.setAttribute('aria-busy', 'true');
+      status.textContent = 'Translating…';
+      try {
+        const translator = await getTranslator(target);
+        if (!translator) {
+          status.textContent = 'This language is not available for on-device translation.';
+          return;
+        }
+        const results = await Promise.all(originals.map((text) => translator.translate(text)));
+        if (id !== requestId) return; // a newer selection superseded this one
+        items.forEach((el, i) => {
+          el.textContent = results[i];
+          el.lang = target;
+          el.dir = RTL.has(target) ? 'rtl' : 'ltr';
+        });
+        status.textContent = '';
+      } catch (err) {
+        console.warn(err);
+        if (id === requestId) status.textContent = 'Sorry, translation failed. Please try again.';
+      } finally {
+        if (id === requestId) select.removeAttribute('aria-busy');
+      }
+    });
+  </script>
