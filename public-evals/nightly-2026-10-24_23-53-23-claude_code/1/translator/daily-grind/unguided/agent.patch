+<script>
+    // On-device translation via the browser's built-in Translator API.
+    // Text never leaves the device; language models are downloaded by the browser on first use.
+    (() => {
+      const picker = document.getElementById('lang-picker');
+      const select = document.getElementById('lang-select');
+      const status = document.getElementById('lang-status');
+      if (!('Translator' in self)) return; // unsupported browser: keep the selector hidden
+      picker.hidden = false;
+
+      const SOURCE = 'en';
+      const nodes = [...document.querySelectorAll('[data-translate]')];
+      const originals = nodes.map(n => n.textContent);
+      const translators = {};
+      let requestId = 0;
+
+      async function getTranslator(target) {
+        if (!translators[target]) {
+          translators[target] = Translator.create({
+            sourceLanguage: SOURCE,
+            targetLanguage: target,
+            monitor(m) {
+              m.addEventListener('downloadprogress', e => {
+                status.textContent = `Downloading ${Math.round(e.loaded * 100)}%`;
+              });
+            }
+          }).catch(err => { delete translators[target]; throw err; });
+        }
+        return translators[target];
+      }
+
+      function restore() {
+        nodes.forEach((n, i) => { n.textContent = originals[i]; });
+        document.documentElement.lang = SOURCE;
+      }
+
+      select.addEventListener('change', async () => {
+        const target = select.value;
+        const id = ++requestId;
+        if (target === SOURCE) { restore(); status.textContent = ''; return; }
+
+        status.textContent = 'Translating…';
+        try {
+          const availability = await Translator.availability({ sourceLanguage: SOURCE, targetLanguage: target });
+          if (availability === 'unavailable') throw new Error('unsupported pair');
+          const translator = await getTranslator(target);
+          const results = await Promise.all(originals.map(t => translator.translate(t)));
+          if (id !== requestId) return; // a newer selection superseded this one
+          nodes.forEach((n, i) => { n.textContent = results[i]; });
+          document.documentElement.lang = target;
+          status.textContent = '';
+        } catch (err) {
+          if (id !== requestId) return;
+          console.error('Translation failed:', err);
+          select.value = SOURCE;
+          restore();
+          status.textContent = 'Unavailable';
+        }
+      });
+    })();
+  </script>
+
