diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..559e883
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,145 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+
+const SOURCE_LANGUAGE = 'en';
+const LANGUAGES: Record<string, string> = {
+  ar: 'Arabic', zh: 'Chinese', nl: 'Dutch', fr: 'French', de: 'German', hi: 'Hindi',
+  it: 'Italian', ja: 'Japanese', ko: 'Korean', pl: 'Polish', pt: 'Portuguese',
+  ru: 'Russian', es: 'Spanish', sv: 'Swedish', tr: 'Turkish', uk: 'Ukrainian',
+};
+
+// Elements marked data-translate are translated as a whole; elements marked
+// data-translate-block have their text content translated. Text nodes are
+// translated individually so inline markup (links, emphasis) survives.
+const TARGET_SELECTOR = '[data-translate], [data-translate-block]';
+
+type Status = 'idle' | 'downloading' | 'translating' | 'done' | 'error';
+
+export default function TranslateControl() {
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [target, setTarget] = useState('es');
+  const [status, setStatus] = useState<Status>('idle');
+  const [progress, setProgress] = useState(0);
+  const [message, setMessage] = useState('');
+  const originals = useRef(new Map<Text, string>());
+  const runId = useRef(0);
+
+  useEffect(() => {
+    setSupported('Translator' in self);
+    return () => { runId.current++; };
+  }, []);
+
+  const collectTextNodes = () => {
+    const nodes: Text[] = [];
+    document.querySelectorAll(TARGET_SELECTOR).forEach((root) => {
+      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+      for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+        if (n.nodeValue?.trim()) nodes.push(n as Text);
+      }
+    });
+    return nodes;
+  };
+
+  const restore = () => {
+    runId.current++;
+    originals.current.forEach((text, node) => { node.nodeValue = text; });
+    originals.current.clear();
+    document.querySelectorAll(TARGET_SELECTOR).forEach((el) => el.removeAttribute('lang'));
+    setStatus('idle');
+    setMessage('');
+  };
+
+  const translate = async () => {
+    const id = ++runId.current;
+    const options = { sourceLanguage: SOURCE_LANGUAGE, targetLanguage: target };
+    setMessage('');
+    try {
+      const availability = await Translator.availability(options);
+      if (availability === 'unavailable') {
+        setStatus('error');
+        setMessage('This language pair is not available on your device.');
+        return;
+      }
+      setProgress(0);
+      setStatus(availability === 'available' ? 'translating' : 'downloading');
+      // Called from the click handler, so the user gesture covers model downloads.
+      const translator = await Translator.create({
+        ...options,
+        monitor(m: EventTarget) {
+          m.addEventListener('downloadprogress', (e) => setProgress((e as ProgressEvent).loaded));
+        },
+      });
+      if (id !== runId.current) return;
+      setStatus('translating');
+
+      // Restore any earlier translation first so we always translate from the original.
+      originals.current.forEach((text, node) => { node.nodeValue = text; });
+      originals.current.clear();
+
+      for (const node of collectTextNodes()) {
+        const original = node.nodeValue ?? '';
+        const translated = await translator.translate(original.trim());
+        if (id !== runId.current) return;
+        originals.current.set(node, original);
+        const lead = original.match(/^\s*/)?.[0] ?? '';
+        const trail = original.match(/\s*$/)?.[0] ?? '';
+        node.nodeValue = lead + translated + trail;
+      }
+      document.querySelectorAll(TARGET_SELECTOR).forEach((el) => el.setAttribute('lang', target));
+      translator.destroy?.();
+      setStatus('done');
+    } catch (err) {
+      if (id !== runId.current) return;
+      console.error(err);
+      setStatus('error');
+      setMessage('Translation failed. Please try again.');
+    }
+  };
+
+  const busy = status === 'downloading' || status === 'translating';
+
+  if (supported === null) return null;
+
+  return (
+    <div className="flex flex-wrap items-center gap-2 px-4 py-2 text-sm text-gray-700 border-b border-gray-200 bg-gray-50">
+      <LanguageIcon className="w-5 h-5 text-gray-500" aria-hidden="true" />
+      <label htmlFor="translate-language" className="font-semibold">Translate this page</label>
+      <select
+        id="translate-language"
+        value={target}
+        disabled={!supported || busy}
+        onChange={(e) => setTarget(e.target.value)}
+        className="border border-gray-300 rounded px-2 py-1 bg-white disabled:opacity-50"
+      >
+        {Object.entries(LANGUAGES).map(([code, name]) => (
+          <option key={code} value={code}>{name}</option>
+        ))}
+      </select>
+      <button
+        type="button"
+        onClick={translate}
+        disabled={!supported || busy}
+        className="px-3 py-1 rounded bg-amber-800 text-white hover:bg-amber-700 disabled:opacity-50"
+      >
+        Translate
+      </button>
+      {status === 'done' && (
+        <button type="button" onClick={restore} className="underline text-amber-800 hover:text-amber-600">
+          Show original
+        </button>
+      )}
+      {status === 'downloading' && (
+        <span className="flex items-center gap-2">
+          Downloading language pack…
+          <progress value={progress} max={1} className="w-24" aria-label="Language pack download progress" />
+        </span>
+      )}
+      <span role="status" aria-live="polite">
+        {!supported && 'On-device translation is not supported in this browser.'}
+        {status === 'translating' && 'Translating…'}
+        {status === 'done' && 'Translated on your device.'}
+        {message}
+      </span>
+    </div>
+  );
+}
