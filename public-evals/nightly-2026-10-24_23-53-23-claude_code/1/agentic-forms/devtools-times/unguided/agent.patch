diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..b30ba09
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,50 @@
+import { useEffect, useRef } from 'react';
+
+export interface WebMCPTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  execute: (input: any) => Promise<unknown> | unknown;
+}
+
+/** Wraps a plain value in the content format WebMCP tools return. */
+export const toolResult = (value: unknown) => ({
+  content: [{ type: 'text', text: typeof value === 'string' ? value : JSON.stringify(value) }],
+});
+
+/**
+ * Registers a tool with the browser's WebMCP API (navigator.modelContext) while
+ * the calling component is mounted. No-op where the API is unavailable.
+ */
+export function useWebMCPTool(tool: WebMCPTool) {
+  // Always call the latest closure without re-registering on every render.
+  const executeRef = useRef(tool.execute);
+  executeRef.current = tool.execute;
+
+  useEffect(() => {
+    const modelContext = (navigator as any).modelContext;
+    if (!modelContext?.registerTool) return;
+
+    const controller = new AbortController();
+    try {
+      modelContext.registerTool(
+        {
+          name: tool.name,
+          description: tool.description,
+          inputSchema: tool.inputSchema,
+          execute: async (input: unknown) => toolResult(await executeRef.current(input)),
+        },
+        { signal: controller.signal },
+      );
+    } catch (err) {
+      console.error(`Failed to register WebMCP tool "${tool.name}":`, err);
+    }
+
+    return () => {
+      controller.abort();
+      try {
+        modelContext.unregisterTool?.(tool.name);
+      } catch {}
+    };
+  }, [tool.name]);
+}
