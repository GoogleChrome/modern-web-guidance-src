+  <script>
+    (function () {
+      var board = document.getElementById('board');
+      var columns = Array.prototype.slice.call(board.querySelectorAll('.board-column'));
+      var THRESHOLD = 4;
+      var drag = null;
+      var rafId = 0;
+
+      function updateCounts() {
+        for (var i = 0; i < columns.length; i++) {
+          var c = columns[i];
+          var n = String(c.querySelector('.board-cards').childElementCount);
+          var el = c.querySelector('.board-count');
+          if (el.textContent !== n) el.textContent = n;
+        }
+      }
+
+      function measure() {
+        drag.rects = columns.map(function (c) { return c.getBoundingClientRect(); });
+        drag.stale = false;
+      }
+
+      function columnAt(x, y) {
+        for (var i = 0; i < drag.rects.length; i++) {
+          var r = drag.rects[i];
+          if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) return columns[i];
+        }
+        return null;
+      }
+
+      function setTarget(col) {
+        if (drag.target === col) return;
+        if (drag.target) drag.target.classList.remove('drop-target');
+        if (col) col.classList.add('drop-target');
+        drag.target = col;
+      }
+
+      // One compositor-only write per frame; no layout reads except after scroll/resize.
+      function frame() {
+        rafId = 0;
+        if (!drag || !drag.active) return;
+        if (drag.stale) measure();
+        drag.ghost.style.transform =
+          'translate3d(' + (drag.x - drag.offX) + 'px,' + (drag.y - drag.offY) + 'px,0)';
+        setTarget(columnAt(drag.x, drag.y));
+      }
+
+      function schedule() {
+        if (!rafId) rafId = requestAnimationFrame(frame);
+      }
+
+      function markStale() { if (drag) { drag.stale = true; schedule(); } }
+
+      function startDrag() {
+        var card = drag.card;
+        var r = card.getBoundingClientRect();
+        var ghost = card.cloneNode(true);
+        ghost.removeAttribute('tabindex');
+        ghost.classList.add('drag-ghost');
+        ghost.style.width = r.width + 'px';
+        drag.offX = drag.startX - r.left;
+        drag.offY = drag.startY - r.top;
+        document.body.appendChild(ghost);
+        drag.ghost = ghost;
+        drag.active = true;
+        card.classList.add('dragging');
+        measure();
+        window.addEventListener('scroll', markStale, true);
+        window.addEventListener('resize', markStale);
+      }
+
+      function endDrag(drop) {
+        var d = drag;
+        drag = null;
+        if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
+        window.removeEventListener('scroll', markStale, true);
+        window.removeEventListener('resize', markStale);
+        if (d.card.hasPointerCapture && d.card.hasPointerCapture(d.id)) {
+          d.card.releasePointerCapture(d.id);
+        }
+        if (!d.active) return;
+        d.ghost.remove();
+        d.card.classList.remove('dragging');
+        if (d.target) d.target.classList.remove('drop-target');
+        if (drop && d.target) {
+          var list = d.target.querySelector('.board-cards');
+          if (d.card.parentNode !== list) {
+            list.appendChild(d.card);
+            updateCounts();
+          }
+        }
+      }
+
+      board.addEventListener('pointerdown', function (e) {
+        if (drag || e.button !== 0) return;
+        var card = e.target.closest('.card');
+        if (!card) return;
+        drag = {
+          card: card, id: e.pointerId, startX: e.clientX, startY: e.clientY,
+          x: e.clientX, y: e.clientY, active: false, target: null, stale: false
+        };
+        card.setPointerCapture(e.pointerId);
+      });
+
+      board.addEventListener('pointermove', function (e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        drag.x = e.clientX;
+        drag.y = e.clientY;
+        if (!drag.active) {
+          if (Math.abs(drag.x - drag.startX) + Math.abs(drag.y - drag.startY) < THRESHOLD) return;
+          startDrag();
+        }
+        schedule();
+      });
+
+      board.addEventListener('pointerup', function (e) {
+        if (drag && e.pointerId === drag.id) endDrag(true);
+      });
+      board.addEventListener('pointercancel', function (e) {
+        if (drag && e.pointerId === drag.id) endDrag(false);
+      });
+
+      // Keyboard alternative: ← / → moves the focused card between columns.
+      board.addEventListener('keydown', function (e) {
+        var card = e.target.closest && e.target.closest('.card');
+        if (!card || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
+        var col = card.closest('.board-column');
+        var next = columns[columns.indexOf(col) + (e.key === 'ArrowRight' ? 1 : -1)];
+        if (!next) return;
+        e.preventDefault();
+        next.querySelector('.board-cards').appendChild(card);
+        card.focus();
+        updateCounts();
+      });
+
+      updateCounts();
+    })();
+  </script>
+
