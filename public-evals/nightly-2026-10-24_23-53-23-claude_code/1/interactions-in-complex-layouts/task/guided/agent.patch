+  <script>
+    (() => {
+      const board = document.getElementById('board');
+      const columns = [...board.querySelectorAll('.board-column')];
+      const lists = columns.map((c) => c.querySelector('.column-cards'));
+      const counts = columns.map((c) => c.querySelector('.count'));
+      const THRESHOLD = 4;
+      let drag = null;
+
+      function updateCounts() {
+        columns.forEach((c, i) => { counts[i].textContent = lists[i].childElementCount; });
+      }
+
+      // Insert before the first card whose midpoint is below y; rects read once, on drop only.
+      function place(card, list, y) {
+        let ref = null;
+        if (y !== undefined) {
+          for (const el of list.children) {
+            if (el === card) continue;
+            const r = el.getBoundingClientRect();
+            if (y < r.top + r.height / 2) { ref = el; break; }
+          }
+        }
+        list.insertBefore(card, ref);
+        updateCounts();
+      }
+
+      board.addEventListener('pointerdown', (e) => {
+        const card = e.target.closest('.card');
+        if (!card || e.button !== 0) return;
+        const rect = card.getBoundingClientRect();
+        drag = {
+          card, id: e.pointerId, started: false,
+          sx: e.clientX, sy: e.clientY,
+          ox: e.clientX - rect.left, oy: e.clientY - rect.top,
+          width: rect.width,
+          // Column geometry cached once so pointermove never reads layout
+          rects: columns.map((c) => c.getBoundingClientRect()),
+          target: -1, x: e.clientX, y: e.clientY, raf: 0, ghost: null,
+        };
+        card.setPointerCapture(e.pointerId);
+      });
+
+      function frame() {
+        const d = drag;
+        if (!d) return;
+        d.raf = 0;
+        d.ghost.style.transform = `translate3d(${d.x - d.ox}px, ${d.y - d.oy}px, 0)`;
+        const t = d.rects.findIndex((r) => d.x >= r.left && d.x <= r.right && d.y >= r.top && d.y <= r.bottom);
+        if (t !== d.target) {
+          if (d.target >= 0) columns[d.target].classList.remove('drop-target');
+          if (t >= 0) columns[t].classList.add('drop-target');
+          d.target = t;
+        }
+      }
+
+      board.addEventListener('pointermove', (e) => {
+        const d = drag;
+        if (!d || e.pointerId !== d.id) return;
+        if (!d.started) {
+          if (Math.hypot(e.clientX - d.sx, e.clientY - d.sy) < THRESHOLD) return;
+          d.started = true;
+          const ghost = d.card.cloneNode(true);
+          ghost.classList.add('drag-ghost');
+          ghost.removeAttribute('tabindex');
+          ghost.style.width = `${d.width}px`;
+          document.body.appendChild(ghost);
+          d.ghost = ghost;
+          d.card.classList.add('dragging');
+        }
+        d.x = e.clientX;
+        d.y = e.clientY;
+        if (!d.raf) d.raf = requestAnimationFrame(frame);
+      });
+
+      function end(e, cancelled) {
+        const d = drag;
+        if (!d || e.pointerId !== d.id) return;
+        drag = null;
+        cancelAnimationFrame(d.raf);
+        if (!d.started) return;
+        d.ghost.remove();
+        d.card.classList.remove('dragging');
+        if (d.target >= 0) columns[d.target].classList.remove('drop-target');
+        if (!cancelled && d.target >= 0) place(d.card, lists[d.target], e.clientY);
+      }
+
+      board.addEventListener('pointerup', (e) => end(e, false));
+      board.addEventListener('pointercancel', (e) => end(e, true));
+
+      // Keyboard alternative
+      board.addEventListener('keydown', (e) => {
+        const card = e.target.closest('.card');
+        if (!card || e.target !== card) return;
+        const i = lists.indexOf(card.parentElement);
+        const j = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : -1;
+        if (j < 0 || j >= lists.length) return;
+        e.preventDefault();
+        place(card, lists[j]);
+        card.focus();
+      });
+
+      updateCounts();
+    })();
+  </script>
