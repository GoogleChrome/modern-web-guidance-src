+    /* Product Carousel */
+    .scroller {
+      --card-width: min(280px, 70vw);
+      display: flex;
+      gap: 24px;
+      list-style: none;
+      overflow-x: auto;
+      padding: 40px calc(50% - var(--card-width) / 2);
+      scroll-snap-type: x mandatory;
+      scroll-padding-inline: calc(50% - var(--card-width) / 2);
+      overscroll-behavior-x: contain;
+    }
+
+    .scroller:focus-visible,
+    .scroller .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .scroller > li {
+      flex: 0 0 var(--card-width);
+      scroll-snap-align: center;
+    }
+
+    .product-card {
+      height: 100%;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
+      overflow: hidden;
+      text-align: center;
+    }
+
+    .product-card img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .product-card .body {
+      padding: 16px 20px 20px;
+    }
+
+    .product-card h3 {
+      color: var(--primary);
+    }
+
+    .product-card .price {
+      font-weight: bold;
+      margin-top: 4px;
+    }
+
+    @keyframes carousel-focus {
+      0%,
+      100% {
+        transform: scale(0.8);
+        opacity: 0.6;
+      }
+
+      50% {
+        transform: scale(1);
+        opacity: 1;
+      }
+    }
+
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .scroller > li {
+          animation: carousel-focus linear both;
+          animation-timeline: view(inline);
+        }
+      }
+    }
+
     footer {
