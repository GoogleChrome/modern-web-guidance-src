+  <script>
+    // Example endpoints; replace with your companion app / device addresses.
+    const TARGETS = {
+      'loopback-network': { url: 'http://127.0.0.1:45678/health', space: 'loopback' },
+      'local-network': { url: 'http://192.168.1.100:8080/api/status', space: 'local' },
+    };
+
+    function updatePermissionUI(name, state) {
+      const badge = document.querySelector(`[data-permission-status="${name}"]`);
+      const remediation = document.querySelector(`[data-remediation="${name}"]`);
+      if (badge) badge.textContent = state;
+      if (remediation) remediation.hidden = state !== 'denied';
+    }
+
+    // Never query the legacy 'local-network-access' name; unsupported browsers fall back to 'prompt'.
+    async function checkNetworkPermission(name) {
+      let state = 'prompt';
+      try {
+        const status = await navigator.permissions.query({ name });
+        state = status.state;
+        status.addEventListener('change', () => updatePermissionUI(name, status.state));
+      } catch {
+        // Unrecognized permission name: proceed on user gesture.
+      }
+      updatePermissionUI(name, state);
+      return state;
+    }
+
+    async function connect(name) {
+      const result = document.getElementById('local-device-result');
+      const { url, space } = TARGETS[name];
+      if (await checkNetworkPermission(name) === 'denied') {
+        result.textContent = '';
+        return;
+      }
+      result.textContent = 'Connecting…';
+      try {
+        const response = await fetch(new Request(url, {
+          mode: 'cors',
+          targetAddressSpace: space,
+        }));
+        if (!response.ok) throw new Error(`HTTP ${response.status}`);
+        result.textContent = 'Connected!';
+      } catch {
+        result.textContent = 'Could not connect. Check that the device is on, on the same network, and allowed in your browser permissions.';
+      }
+      checkNetworkPermission(name);
+    }
+
+    document.getElementById('connect-loopback').addEventListener('click', () => connect('loopback-network'));
+    document.getElementById('connect-local').addEventListener('click', () => connect('local-network'));
+    Object.keys(TARGETS).forEach(checkNetworkPermission);
+  </script>
+
