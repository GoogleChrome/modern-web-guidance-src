+  <script>
+    // Local Network Access: fetch a resource on loopback or the user's LAN.
+    // `targetAddressSpace` tells Chrome which address space is targeted so it can
+    // show the local network permission prompt to the user.
+    // Usage: localFetch('http://localhost:3000/api/status', 'loopback')
+    //        localFetch('http://192.168.1.20/info', 'local')
+    window.localFetch = function (url, space = 'local', options = {}) {
+      return fetch(url, { ...options, targetAddressSpace: space });
+    };
+  </script>
