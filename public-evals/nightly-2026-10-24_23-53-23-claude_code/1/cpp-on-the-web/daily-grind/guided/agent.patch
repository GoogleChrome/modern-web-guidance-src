+#!/bin/sh
+# Compiles smallpt/smallpt.cpp to smallpt/smallpt.js + smallpt.wasm (requires Emscripten)
+cd "$(dirname "$0")/smallpt" || exit 1
+em++ smallpt.cpp -O3 -o smallpt.js \
+  -sEXPORT_ES6 -sENVIRONMENT=web,worker -sALLOW_MEMORY_GROWTH \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8,HEAPF64 -sEXPORTED_FUNCTIONS=_init,_render_row,_malloc,_free
