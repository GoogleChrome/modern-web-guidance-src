+  <script type="module">
+    const W = 512, H = 384, SPP = 64;
+    const canvas = document.getElementById('trace');
+    const ctx = canvas.getContext('2d');
+    const btn = document.getElementById('trace-btn');
+    const status = document.getElementById('trace-status');
+    const worker = new Worker('smallpt/worker.js', { type: 'module' });
+    let started = 0;
+
+    // Original smallpt colors: left wall, right wall, mirror ball, glass ball
+    const defaults = [.75, .25, .25, .25, .25, .75, .999, .999, .999, .999, .999, .999];
+
+    // Random saturated color via HSL -> RGB (components in 0..1)
+    function randomColor() {
+      const h = Math.random() * 6, s = 0.5 + Math.random() * 0.5, l = 0.35 + Math.random() * 0.3;
+      const c = (1 - Math.abs(2 * l - 1)) * s, x = c * (1 - Math.abs(h % 2 - 1)), m = l - c / 2;
+      const [r, g, b] = [[c, x, 0], [x, c, 0], [0, c, x], [0, x, c], [x, 0, c], [c, 0, x]][Math.floor(h)];
+      return [r + m, g + m, b + m];
+    }
+
+    function render(colors) {
+      btn.disabled = true;
+      started = performance.now();
+      status.textContent = 'Rendering…';
+      worker.postMessage({ w: W, h: H, spp: SPP, seed: (Math.random() * 2 ** 32) >>> 0, colors });
+    }
+
+    worker.onmessage = ({ data: { top, rows, pixels, done } }) => {
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(pixels.buffer), W, rows), 0, top);
+      if (done) {
+        status.textContent = `Done in ${((performance.now() - started) / 1000).toFixed(1)}s (${SPP} samples per pixel)`;
+        btn.disabled = false;
+      }
+    };
+    worker.onerror = () => {
+      status.textContent = 'Could not run the WebAssembly renderer.';
+      btn.disabled = false;
+    };
+
+    btn.addEventListener('click', () => render(Array.from({ length: 4 }, randomColor).flat()));
+    render(defaults);
+  </script>
+
