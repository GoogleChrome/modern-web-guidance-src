--- /dev/null
+++ b/smallpt/worker.js
@@ -0,0 +1,24 @@
+import createModule from './smallpt.js';
+
+const modulePromise = createModule();
+
+// message: { w, h, spp, seed, colors: number[12] }
+self.onmessage = async ({ data: { w, h, spp, seed, colors } }) => {
+  const m = await modulePromise;
+  const colorPtr = m._malloc(colors.length * 8);
+  m.HEAPF64.set(colors, colorPtr / 8);
+  const pixelPtr = m._init(w, h, spp, seed, colorPtr);
+  m._free(colorPtr);
+
+  // Render in bands so the page can show progress; each band is copied out.
+  const band = 8;
+  for (let y = 0; y < h; y += band) {
+    const y1 = Math.min(y + band, h);
+    for (let r = y; r < y1; r++) m._render_row(r);
+    // Rows are stored top-first: scene row r lands at image row h-1-r.
+    const top = h - y1;
+    const rows = y1 - y;
+    const slice = m.HEAPU8.slice(pixelPtr + top * w * 4, pixelPtr + (top + rows) * w * 4);
+    self.postMessage({ top, rows, pixels: slice, done: y1 >= h }, [slice.buffer]);
+  }
+};
