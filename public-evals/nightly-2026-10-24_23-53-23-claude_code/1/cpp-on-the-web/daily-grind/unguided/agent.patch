+
+  <script>
+    (() => {
+      const W = 256, H = 192, SAMPS = 25;
+      // Sphere indices in smallpt's scene: 0 left, 1 right, 2 back, 3 front (black), 4 floor, 5 ceiling, 6 mirror, 7 glass, 8 light
+      const COLORED = [0, 1, 2, 4, 5, 6, 7];
+      const canvas = document.getElementById('tracer-canvas');
+      const btn = document.getElementById('tracer-btn');
+      const status = document.getElementById('tracer-status');
+      const ctx = canvas.getContext('2d');
+      const worker = new Worker('smallpt/worker.js');
+      let t0 = 0;
+
+      function hslToRgb(h, s, l) {
+        const f = n => {
+          const k = (n + h * 12) % 12;
+          return l - s * Math.min(l, 1 - l) * Math.max(-1, Math.min(k - 3, 9 - k, 1));
+        };
+        return [f(0), f(8), f(4)];
+      }
+
+      function randomColors(randomize) {
+        // Default smallpt palette on first render
+        const base = {0: [.75, .25, .25], 1: [.25, .25, .75], 2: [.75, .75, .75], 4: [.75, .75, .75],
+                      5: [.75, .75, .75], 6: [.999, .999, .999], 7: [.999, .999, .999]};
+        const colors = [];
+        for (const i of COLORED) {
+          colors[i] = randomize ? hslToRgb(Math.random(), 0.45 + Math.random() * 0.4, 0.4 + Math.random() * 0.25) : base[i];
+        }
+        return COLORED.map(i => [i, ...colors[i]]);
+      }
+
+      function run(randomize) {
+        btn.disabled = true;
+        status.textContent = 'Rendering\u2026';
+        t0 = performance.now();
+        worker.postMessage({ w: W, h: H, samps: SAMPS, seed: (Math.random() * 2 ** 32) >>> 0, colors: randomColors(randomize) });
+      }
+
+      worker.onmessage = (e) => {
+        const { w, h, buf } = e.data;
+        ctx.putImageData(new ImageData(new Uint8ClampedArray(buf), w, h), 0, 0);
+        status.textContent = `Rendered ${w}\u00d7${h} at ${SAMPS * 4} samples/pixel in ${((performance.now() - t0) / 1000).toFixed(1)}s`;
+        btn.disabled = false;
+      };
+      worker.onerror = () => { status.textContent = 'Failed to load the WebAssembly renderer.'; };
+
+      btn.addEventListener('click', () => run(true));
+      run(false);
+    })();
+  </script>
