+++ b/smallpt/worker.js
@@ -0,0 +1,10 @@
+importScripts('smallpt.js');
+const ready = createSmallpt();
+onmessage = async (e) => {
+  const { w, h, samps, seed, colors } = e.data;
+  const m = await ready;
+  colors.forEach(([i, r, g, b]) => m._setColor(i, r, g, b));
+  const ptr = m._render(w, h, samps, seed);
+  const out = new Uint8ClampedArray(m.HEAPU8.buffer, ptr, w * h * 4).slice();
+  postMessage({ w, h, buf: out.buffer }, [out.buffer]);
+};
