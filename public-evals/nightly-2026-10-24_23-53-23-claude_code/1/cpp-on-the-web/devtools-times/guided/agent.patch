@@ -0,0 +1,67 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>smallpt in WebAssembly</title>
+  <style>
+    :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
+    body { max-width: 40rem; margin: 2rem auto; padding: 0 1rem; text-align: center; }
+    canvas { width: 100%; height: auto; aspect-ratio: 4 / 3; background: #111; border-radius: .5rem; }
+    button { font: inherit; padding: .6rem 1.2rem; margin-top: 1rem; cursor: pointer; }
+    progress { width: 100%; margin-top: .5rem; }
+  </style>
+</head>
+<body>
+  <h1>smallpt in WebAssembly</h1>
+  <p><a href="http://www.kevinbeason.com/smallpt/">smallpt</a>, Kevin Beason's 99-line C++ path tracer, compiled with Emscripten and rendered in your browser (512×384, 100 samples per pixel).</p>
+  <canvas id="canvas" width="512" height="384" role="img" aria-label="Path-traced Cornell box with a mirror ball and a glass ball"></canvas>
+  <progress id="progress" max="1" value="0"></progress>
+  <p id="status" role="status" aria-live="polite">Loading…</p>
+  <button id="rerun" type="button" disabled>Re-render with random colors</button>
+
+  <script type="module">
+    const canvas = document.getElementById('canvas');
+    const ctx = canvas.getContext('2d');
+    const button = document.getElementById('rerun');
+    const progress = document.getElementById('progress');
+    const status = document.getElementById('status');
+    const worker = new Worker('./worker.js', { type: 'module' });
+
+    // Original smallpt colors: left, right, back, floor, ceiling, mirror, glass.
+    const original = [.75,.25,.25, .25,.25,.75, .75,.75,.75, .75,.75,.75, .75,.75,.75, .999,.999,.999, .999,.999,.999];
+    const randomColor = () => {
+      // Random hue, kept fairly saturated and bright enough to light the room.
+      const h = Math.random() * 6, c = .55 + Math.random() * .35, m = .1 + Math.random() * .15;
+      const x = c * (1 - Math.abs(h % 2 - 1));
+      const [r, g, b] = [[c,x,0],[x,c,0],[0,c,x],[0,x,c],[x,0,c],[c,0,x]][Math.floor(h)];
+      return [r + m, g + m, b + m].map(v => Math.min(v, .95));
+    };
+
+    let runId = 0, startTime = 0;
+    function render(colors) {
+      button.disabled = true;
+      progress.value = 0;
+      status.textContent = 'Rendering…';
+      startTime = performance.now();
+      worker.postMessage({ id: ++runId, colors });
+    }
+
+    worker.onmessage = ({ data }) => {
+      if (data.id !== runId) return;
+      if (data.done) {
+        status.textContent = `Rendered in ${((performance.now() - startTime) / 1000).toFixed(1)}s.`;
+        button.disabled = false;
+        return;
+      }
+      const rows = data.pixels.length / (canvas.width * 4);
+      ctx.putImageData(new ImageData(data.pixels, canvas.width, rows), 0, data.y);
+      progress.value = data.progress;
+    };
+    worker.onerror = () => { status.textContent = 'Failed to load the WebAssembly renderer.'; };
+
+    button.addEventListener('click', () => render(Array.from({ length: 7 }, randomColor).flat()));
+    render(original);
+  </script>
+</body>
+</html>
