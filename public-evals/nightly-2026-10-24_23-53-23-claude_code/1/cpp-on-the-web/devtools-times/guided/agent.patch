+#!/bin/sh
+# Builds smallpt to WebAssembly (requires Emscripten). Usage: sh wasm/build.sh
+set -e
+cd "$(dirname "$0")/.."
+em++ -O3 -flto wasm/smallpt.cpp -o public/smallpt/smallpt.js \
+  -sEXPORT_ES6 -sENVIRONMENT=worker -sALLOW_MEMORY_GROWTH -sMODULARIZE -sEXPORT_NAME=createSmallpt \
+  -sEXPORTED_FUNCTIONS=_set_colors,_init,_render_rows \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8,HEAPF64 -sNO_DISABLE_EXCEPTION_CATCHING=0 -fno-exceptions
