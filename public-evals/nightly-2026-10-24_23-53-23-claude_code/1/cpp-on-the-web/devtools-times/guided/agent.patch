new file mode 100644
index 0000000..e954cde
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,22 @@
+import createSmallpt from './smallpt.js';
+
+const W = 512, H = 384, SPP = 100, BAND = 8;
+const modulePromise = createSmallpt();
+
+self.onmessage = async ({ data: { id, colors } }) => {
+  const m = await modulePromise;
+  // Pass the scene colors (7 rgb triples) into wasm memory.
+  const buf = m._malloc(colors.length * 8);
+  m.HEAPF64.set(colors, buf / 8);
+  m._set_colors(buf);
+  m._free(buf);
+
+  const ptr = m._init(W, H, SPP);
+  for (let y = 0; y < H; y += BAND) {
+    m._render_rows(y, Math.min(y + BAND, H));
+    // Copy, as the wasm heap may be detached if memory grows.
+    const pixels = m.HEAPU8.slice(ptr + y * W * 4, ptr + Math.min(y + BAND, H) * W * 4);
+    self.postMessage({ id, y, pixels, progress: Math.min(y + BAND, H) / H }, [pixels.buffer]);
+  }
+  self.postMessage({ id, done: true });
+};
