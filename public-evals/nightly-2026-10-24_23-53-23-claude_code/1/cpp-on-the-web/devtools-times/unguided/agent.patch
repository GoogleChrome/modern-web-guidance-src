diff --git a/public/smallpt/worker.js b/public/smallpt/worker.js
new file mode 100644
index 0000000..a9382cc
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,19 @@
+// Runs the smallpt WebAssembly path tracer off the main thread.
+importScripts('smallpt.js');
+
+const ready = createSmallpt();
+
+onmessage = async (e) => {
+  const { w, h, spp, colors } = e.data;
+  const m = await ready;
+  if (colors) {
+    const ptr = m._malloc(colors.length * 8);
+    m.HEAPF64.set(colors, ptr / 8);
+    m._set_colors(ptr);
+    m._free(ptr);
+  }
+  const start = performance.now();
+  const out = m._render(w, h, spp);
+  const rgba = m.HEAPU8.slice(out, out + w * h * 4);
+  postMessage({ w, h, rgba, ms: performance.now() - start }, [rgba.buffer]);
+};
diff --git a/src/components/SmallptDemo.astro b/src/components/SmallptDemo.astro
new file mode 100644
index 0000000..148d5a3
--- /dev/null
+++ b/src/components/SmallptDemo.astro
@@ -0,0 +1,67 @@
+---
+const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
+---
+
+<section class="max-w-6xl mx-auto p-4 md:p-6" id="smallpt-demo" data-worker={`${base}smallpt/worker.js`}>
+    <h2 class="text-2xl font-bold text-gray-900 mb-1">Path Tracing, Live</h2>
+    <p class="text-sm text-gray-600 mb-4">
+        Rendered in your browser by <a class="underline" href="http://www.kevinbeason.com/smallpt/">smallpt</a>,
+        a 99-line C++ path tracer, compiled to WebAssembly.
+    </p>
+    <canvas id="smallpt-canvas" width="512" height="384" class="w-full max-w-2xl bg-black border border-gray-300"></canvas>
+    <div class="mt-3 flex items-center gap-4">
+        <button id="smallpt-rerun" type="button" class="px-4 py-2 bg-gray-900 text-white font-semibold hover:bg-amber-500 disabled:opacity-50">
+            Render with random colors
+        </button>
+        <span id="smallpt-status" class="text-sm text-gray-500" role="status"></span>
+    </div>
+</section>
+
+<script>
+    const root = document.getElementById('smallpt-demo')!;
+    const canvas = document.getElementById('smallpt-canvas') as HTMLCanvasElement;
+    const button = document.getElementById('smallpt-rerun') as HTMLButtonElement;
+    const status = document.getElementById('smallpt-status')!;
+    const ctx = canvas.getContext('2d')!;
+    const worker = new Worker(root.dataset.worker!);
+    const SPP = 100;
+
+    // Original scene colors: left wall, right wall, back wall, mirror, glass.
+    const DEFAULT_COLORS = [.75, .25, .25, .25, .25, .75, .75, .75, .75, .999, .999, .999, .999, .999, .999];
+
+    function randomColors() {
+        const colors: number[] = [];
+        for (let i = 0; i < 5; i++) {
+            // Saturated random hue; mirror and glass get only a light tint.
+            const hue = Math.random() * 360;
+            const [s, l] = i < 3 ? [0.7, 0.45] : [0.5, 0.9];
+            const a = s * Math.min(l, 1 - l);
+            const f = (n: number) => {
+                const k = (n + hue / 30) % 12;
+                return l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1));
+            };
+            colors.push(f(0), f(8), f(4));
+        }
+        return colors;
+    }
+
+    function run(colors: number[]) {
+        button.disabled = true;
+        status.textContent = `Rendering at ${SPP} samples per pixel…`;
+        worker.postMessage({ w: canvas.width, h: canvas.height, spp: SPP, colors });
+    }
+
+    worker.onmessage = (e) => {
+        const { w, h, rgba, ms } = e.data;
+        ctx.putImageData(new ImageData(new Uint8ClampedArray(rgba.buffer), w, h), 0, 0);
+        status.textContent = `Rendered in ${(ms / 1000).toFixed(1)}s`;
+        button.disabled = false;
+    };
+    worker.onerror = () => {
+        status.textContent = 'Rendering failed.';
+        button.disabled = false;
+    };
+
+    button.addEventListener('click', () => run(randomColors()));
+    run(DEFAULT_COLORS);
+</script>
