+#!/bin/sh
+# Compiles smallpt.cpp to public/smallpt/smallpt.{js,wasm}. Requires emcc.
+cd "$(dirname "$0")" && em++ -O3 smallpt.cpp -o ../public/smallpt/smallpt.js \
+  -sMODULARIZE=1 -sEXPORT_NAME=createSmallpt -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH=1 -sEXPORTED_RUNTIME_METHODS=HEAPU8,HEAPF64 \
+  -sEXPORTED_FUNCTIONS=_set_colors,_render,_malloc,_free
