+  <script type="module">
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const TARGETS = [
+      { label: 'New York', zone: 'America/New_York' },
+      { label: 'London', zone: 'Europe/London' },
+      { label: 'Tokyo', zone: 'Asia/Tokyo' },
+      { label: 'UTC', zone: 'UTC' },
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const hostWarning = document.getElementById('hostWarning');
+
+    const timeFormat = { hour: 'numeric', minute: '2-digit' };
+    const dayFormat = { weekday: 'short', month: 'short', day: 'numeric' };
+
+    function update() {
+      if (!dateInput.value || !timeInput.value) {
+        grid.replaceChildren();
+        hostWarning.hidden = true;
+        return;
+      }
+      const zone = hostTzSelect.value;
+      const wall = Temporal.PlainDateTime.from(`${dateInput.value}T${timeInput.value}`);
+
+      // 'compatible' resolves gaps/overlaps; the result is immutable and only ever derived from.
+      const host = wall.toZonedDateTime(zone, { disambiguation: 'compatible' });
+
+      const earlier = wall.toZonedDateTime(zone, { disambiguation: 'earlier' });
+      const later = wall.toZonedDateTime(zone, { disambiguation: 'later' });
+      if (earlier.epochNanoseconds === later.epochNanoseconds) {
+        hostWarning.hidden = true;
+      } else {
+        const fmt = (z) => z.toLocaleString('en-US', { ...timeFormat, timeZoneName: 'short' });
+        const requested = wall.toLocaleString('en-US', timeFormat);
+        const isGap = !earlier.toPlainDateTime().equals(wall);
+        hostWarning.textContent = isGap
+          ? `Heads up: ${requested} does not exist in ${zone} on this date because clocks jump forward. `
+            + `We resolved it to ${fmt(host)}.`
+          : `Heads up: ${requested} happens twice in ${zone} on this date because clocks are turned back. `
+            + `We used the first occurrence (${fmt(earlier)}); the second would be ${fmt(later)}.`;
+        hostWarning.hidden = false;
+      }
+
+      grid.replaceChildren(...TARGETS.map(({ label, zone: tz }) => {
+        const local = host.withTimeZone(tz); // returns a new object; host is unchanged
+        const card = document.createElement('div');
+        card.className = 'card';
+        const h = document.createElement('h3');
+        h.textContent = label;
+        const t = document.createElement('p');
+        t.className = 'time';
+        t.textContent = local.toLocaleString('en-US', timeFormat);
+        const d = document.createElement('p');
+        d.className = 'day';
+        d.textContent = local.toLocaleString('en-US', dayFormat);
+        card.append(h, t, d);
+        return card;
+      }));
+    }
+
+    dateInput.value = Temporal.Now.plainDateISO().toString();
+    for (const el of [dateInput, timeInput, hostTzSelect]) {
+      el.addEventListener('input', update);
+      el.addEventListener('change', update);
+    }
+    update();
+  </script>
