+  <script type="module">
+    // Temporal is native in modern browsers; load the polyfill only where it is missing.
+    if (!globalThis.Temporal) {
+      const { Temporal } = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = Temporal;
+    }
+
+    const TARGETS = [
+      { label: 'New York', tz: 'America/New_York' },
+      { label: 'London', tz: 'Europe/London' },
+      { label: 'Tokyo', tz: 'Asia/Tokyo' },
+      { label: 'UTC', tz: 'UTC' }
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const hostWarning = document.getElementById('hostWarning');
+
+    dateInput.value = Temporal.Now.plainDateISO().toString();
+
+    const fmtTime = { hour: 'numeric', minute: '2-digit' };
+    const fmtDate = { weekday: 'short', month: 'short', day: 'numeric' };
+
+    // Returns the resolved ZonedDateTime plus a conflict description (or null).
+    // ZonedDateTime is immutable, so every step below produces a new object.
+    function resolveHost(wall, tz) {
+      try {
+        return { zdt: wall.toZonedDateTime(tz, { disambiguation: 'reject' }), conflict: null };
+      } catch (e) {
+        if (!(e instanceof RangeError)) throw e;
+      }
+      const earlier = wall.toZonedDateTime(tz, { disambiguation: 'earlier' });
+      const later = wall.toZonedDateTime(tz, { disambiguation: 'later' });
+      // Overlap: both readings keep the typed wall-clock time. Gap: neither does.
+      const isOverlap = Temporal.PlainDateTime.compare(earlier.toPlainDateTime(), wall) === 0;
+      const zdt = wall.toZonedDateTime(tz, { disambiguation: 'compatible' });
+      const clock = (z) => `${z.toLocaleString('en-US', fmtTime)} (${z.offset})`;
+      const typed = wall.toLocaleString('en-US', fmtTime);
+      if (isOverlap) {
+        return {
+          zdt,
+          conflict: `${typed} happens twice in ${tz} on this date because clocks are turned back. ` +
+            `It could mean ${clock(earlier)} or ${clock(later)}. We used the first occurrence, ${clock(zdt)}.`
+        };
+      }
+      return {
+        zdt,
+        conflict: `${typed} does not exist in ${tz} on this date because clocks skip forward. ` +
+          `We moved it to the next valid time, ${clock(zdt)}.`
+      };
+    }
+
+    function render() {
+      grid.replaceChildren();
+      hostWarning.hidden = true;
+      hostWarning.textContent = '';
+      if (!dateInput.value || !timeInput.value) return;
+
+      const wall = Temporal.PlainDateTime.from(`${dateInput.value}T${timeInput.value}`);
+      const { zdt: host, conflict } = resolveHost(wall, hostTzSelect.value);
+
+      if (conflict) {
+        hostWarning.textContent = conflict;
+        hostWarning.hidden = false;
+      }
+
+      for (const { label, tz } of TARGETS) {
+        const local = host.withTimeZone(tz);
+        const card = document.createElement('div');
+        card.className = 'tz-card';
+        card.dataset.tz = tz;
+        const h = document.createElement('h3');
+        h.textContent = label;
+        const t = document.createElement('div');
+        t.className = 'tz-time';
+        t.textContent = local.toLocaleString('en-US', fmtTime);
+        const m = document.createElement('div');
+        m.className = 'tz-meta';
+        m.textContent = `${local.toLocaleString('en-US', fmtDate)} · ${local.toLocaleString('en-US', { timeZoneName: 'short' }).split(' ').pop()}`;
+        card.append(h, t, m);
+        grid.append(card);
+      }
+    }
+
+    [dateInput, timeInput, hostTzSelect].forEach((el) => el.addEventListener('input', render));
+    hostTzSelect.addEventListener('change', render);
+    render();
+  </script>
+
