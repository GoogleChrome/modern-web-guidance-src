+  <script>
+    const strength = document.querySelector('#strength');
+    const strengthOut = document.querySelector('#strength-out');
+    const strengthLabels = ['Mild', 'Light', 'Medium', 'Strong', 'Extra bold'];
+
+    function syncSliderValue() {
+      strength.style.setProperty('--attr-min', strength.min || 0);
+      strength.style.setProperty('--attr-max', strength.max || 100);
+      strength.style.setProperty('--control-value', strength.value);
+      const text = strengthLabels[strength.value - 1];
+      strengthOut.textContent = text;
+      strength.setAttribute('aria-valuetext', text);
+    }
+
+    syncSliderValue();
+    strength.addEventListener('input', syncSliderValue);
+  </script>
+
