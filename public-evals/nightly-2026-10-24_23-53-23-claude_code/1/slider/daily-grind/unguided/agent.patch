+    /* Range slider */
+    .brew-picker {
+      max-width: 520px;
+      margin: 40px auto 0;
+      background: white;
+      padding: 24px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .brew-picker label {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      font-weight: 600;
+      color: var(--primary);
+      margin-bottom: 12px;
+    }
+
+    .brew-picker output {
+      color: var(--text);
+      font-weight: 400;
+    }
+
+    .range {
+      --track-h: 8px;
+      --thumb: 24px;
+      --fill-color: var(--accent);
+      --track-color: var(--secondary);
+      --pct: 50%;
+      -webkit-appearance: none;
+      appearance: none;
+      width: 100%;
+      height: var(--thumb);
+      background: transparent;
+      cursor: pointer;
+      outline: none;
+    }
+
+    /* Track */
+    .range::-webkit-slider-runnable-track {
+      height: var(--track-h);
+      border-radius: var(--track-h);
+      background: linear-gradient(var(--fill-color), var(--fill-color)) 0 / var(--pct) 100% no-repeat,
+        var(--track-color);
+    }
+
+    .range::-moz-range-track {
+      height: var(--track-h);
+      border-radius: var(--track-h);
+      background: var(--track-color);
+    }
+
+    /* Fill (Firefox has a native pseudo-element; WebKit uses --pct above) */
+    .range::-moz-range-progress {
+      height: var(--track-h);
+      border-radius: var(--track-h);
+      background: var(--fill-color);
+    }
+
+    /* Thumb */
+    .range::-webkit-slider-thumb {
+      -webkit-appearance: none;
+      appearance: none;
+      width: var(--thumb);
+      height: var(--thumb);
+      margin-top: calc((var(--track-h) - var(--thumb)) / 2);
+      border-radius: 50%;
+      background: var(--primary);
+      border: 3px solid white;
+      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
+      transition: transform 0.15s, box-shadow 0.15s;
+    }
+
+    .range::-moz-range-thumb {
+      box-sizing: border-box;
+      width: var(--thumb);
+      height: var(--thumb);
+      border-radius: 50%;
+      background: var(--primary);
+      border: 3px solid white;
+      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
+      transition: transform 0.15s, box-shadow 0.15s;
+    }
+
+    /* Hover / active */
+    .range:hover::-webkit-slider-thumb {
+      transform: scale(1.1);
+    }
+
+    .range:hover::-moz-range-thumb {
+      transform: scale(1.1);
+    }
+
+    .range:active::-webkit-slider-thumb {
+      transform: scale(1.2);
+    }
+
+    .range:active::-moz-range-thumb {
+      transform: scale(1.2);
+    }
+
+    /* Focus (keyboard only) */
+    .range:focus-visible::-webkit-slider-thumb {
+      box-shadow: 0 0 0 3px var(--light), 0 0 0 6px var(--primary);
+    }
+
+    .range:focus-visible::-moz-range-thumb {
+      box-shadow: 0 0 0 3px var(--light), 0 0 0 6px var(--primary);
+    }
+
+    /* Disabled */
+    .range:disabled {
+      cursor: not-allowed;
+      opacity: 0.5;
+    }
+
+    /* Forced colors / high contrast */
+    @media (forced-colors: active) {
+      .range::-webkit-slider-thumb {
+        background: ButtonText;
+        border-color: Canvas;
+      }
+
+      .range::-moz-range-thumb {
+        background: ButtonText;
+        border-color: Canvas;
+      }
+
+      .range:focus-visible::-webkit-slider-thumb {
+        box-shadow: 0 0 0 3px Highlight;
+      }
+
+      .range:focus-visible::-moz-range-thumb {
+        box-shadow: 0 0 0 3px Highlight;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .range::-webkit-slider-thumb,
+      .range::-moz-range-thumb {
+        transition: none;
+      }
+    }
+
