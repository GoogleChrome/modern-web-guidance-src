+    <section class="brew-picker">
+      <label for="strength">Brew strength <output id="strength-out" for="strength">Medium</output></label>
+      <input class="range" type="range" id="strength" name="strength" min="1" max="5" step="1" value="3"
+        aria-valuetext="Medium">
+    </section>
   </main>
 
+  <script>
+    (function () {
+      var names = ['Mild', 'Light', 'Medium', 'Bold', 'Extra bold'];
+      var input = document.getElementById('strength');
+      var out = document.getElementById('strength-out');
+
+      function update() {
+        var pct = (input.value - input.min) / (input.max - input.min) * 100;
+        var name = names[input.value - 1];
+        input.style.setProperty('--pct', pct + '%');
+        input.setAttribute('aria-valuetext', name);
+        out.textContent = name;
+      }
+
+      input.addEventListener('input', update);
+      update();
+    })();
+  </script>
