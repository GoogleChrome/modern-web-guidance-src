+  <script>
+    (function () {
+      var dialog = document.getElementById('details-dialog');
+      if (!dialog || typeof dialog.showModal !== 'function') return; // links still work as plain navigation
+
+      var title = document.getElementById('details-title');
+      var body = document.getElementById('details-body');
+      var link = document.getElementById('details-link');
+
+      document.querySelectorAll('.card a[data-details]').forEach(function (trigger) {
+        trigger.addEventListener('click', function (event) {
+          // Let modified clicks (new tab, etc.) behave normally
+          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
+          event.preventDefault();
+          title.textContent = trigger.parentElement.querySelector('h3').textContent;
+          body.textContent = trigger.dataset.details;
+          link.href = trigger.getAttribute('href');
+          dialog.showModal(); // Escape and the mobile back gesture close it natively
+        });
+      });
+
+      document.getElementById('details-close').addEventListener('click', function () {
+        dialog.close();
+      });
+
+      // Clicking the backdrop dismisses too
+      dialog.addEventListener('click', function (event) {
+        if (event.target === dialog) dialog.close();
+      });
+    })();
