+  <script>
+    (function () {
+      var form = document.getElementById('signup-form');
+      var tokenInput = document.getElementById('signup-token');
+      var button = document.getElementById('signup-submit');
+      var msg = document.getElementById('signup-msg');
+
+      function show(text, kind) {
+        msg.textContent = text;
+        msg.className = 'signup-msg' + (kind ? ' ' + kind : '');
+      }
+
+      // A fresh single-use nonce is bound to the browser's verification token.
+      function loadNonce() {
+        button.disabled = true;
+        tokenInput.value = '';
+        return fetch('/api/rewards/nonce', { credentials: 'same-origin' })
+          .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
+          .then(function (d) {
+            tokenInput.setAttribute('nonce', d.nonce);
+            tokenInput.dataset.nonce = d.nonce;
+            button.disabled = false;
+          })
+          .catch(function () { show('Sign-up is unavailable right now. Please reload and try again.', 'error'); });
+      }
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var name = form.elements.name.value.trim();
+        var email = form.elements.email.value.trim();
+        if (!name || !email) { show('Please enter your name and email address.', 'error'); return; }
+
+        // The browser fills the hidden token field before this handler runs.
+        var token = tokenInput.value;
+        if (!token) {
+          show('Your browser could not verify this email address. Make sure you are signed in to that email account in this browser and pick it from the email suggestions. Email verification requires a supporting browser.', 'error');
+          return;
+        }
+
+        button.disabled = true;
+        show('Verifying…');
+        fetch(form.action, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'content-type': 'application/json' },
+          body: JSON.stringify({ name: name, email: email, token: token })
+        })
+          .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
+          .then(function (res) {
+            if (res.ok) {
+              form.reset();
+              show('Welcome, ' + res.d.name + '! Your email is verified and your rewards account is ready.', 'ok');
+              button.disabled = true;
+              return;
+            }
+            show(res.d.error || 'Something went wrong.', 'error');
+            return loadNonce();
+          })
+          .catch(function () { show('Network error. Please try again.', 'error'); return loadNonce(); });
+      });
+
+      loadNonce();
+    })();
+  </script>
