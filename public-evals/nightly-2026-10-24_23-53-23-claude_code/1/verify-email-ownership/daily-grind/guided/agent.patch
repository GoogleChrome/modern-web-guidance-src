diff --git a/server/index.js b/server/index.js
new file mode 100644
index 0000000..ec7f8a3
--- /dev/null
+++ b/server/index.js
@@ -0,0 +1,201 @@
+import { createServer } from 'node:http';
+import { randomBytes, scrypt, timingSafeEqual } from 'node:crypto';
+import { readFile, writeFile, mkdir } from 'node:fs/promises';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { promisify } from 'node:util';
+import { verifyEmailVerificationToken } from './verify-evt.js';
+
+const scryptAsync = promisify(scrypt);
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
+const PORT = Number(process.env.PORT || 11222);
+// Public origin of this site; EVTs are bound to it (KB-JWT `aud`).
+const RP_ORIGIN = process.env.PUBLIC_ORIGIN || `http://localhost:${PORT}`;
+// Chrome Origin Trial token for the Email Verification API (optional).
+const ORIGIN_TRIAL_TOKEN = process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL_TOKEN || '';
+const ACCOUNTS_FILE = join(ROOT, 'data', 'accounts.json');
+const SESSION_COOKIE = 'dg_sid';
+const NONCE_TTL_MS = 10 * 60 * 1000;
+const MAX_BODY = 16 * 1024;
+
+// Server-side session state: sid -> { nonce, expires }. Nonces are single-use.
+const sessions = new Map();
+
+// ---- Accounts (JSON file; swap for a real database) ----
+let accounts = null;
+async function loadAccounts() {
+  if (accounts) return accounts;
+  try {
+    accounts = JSON.parse(await readFile(ACCOUNTS_FILE, 'utf8'));
+  } catch {
+    accounts = {};
+  }
+  return accounts;
+}
+async function saveAccounts() {
+  await mkdir(dirname(ACCOUNTS_FILE), { recursive: true });
+  await writeFile(ACCOUNTS_FILE, JSON.stringify(accounts, null, 2), { mode: 0o600 });
+}
+async function hashPassword(password) {
+  const salt = randomBytes(16);
+  const key = await scryptAsync(password, salt, 64);
+  return `${salt.toString('base64')}:${key.toString('base64')}`;
+}
+
+// Placeholder: wire to a real mailer. Only used when the browser could not verify ownership.
+async function sendTraditionalVerificationEmail(email) {
+  const code = String(randomBytes(4).readUInt32BE() % 1_000_000).padStart(6, '0');
+  console.log(`[email stub] would send verification code to ${email} (${code.length} digits)`);
+}
+
+// ---- Helpers ----
+function parseCookies(header = '') {
+  return Object.fromEntries(
+    header.split(';').map((c) => c.trim().split(/=(.*)/s).slice(0, 2)).filter(([k]) => k),
+  );
+}
+
+function getSession(req, res) {
+  let sid = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+  if (!sid || !/^[\w-]{20,}$/.test(sid)) {
+    sid = randomBytes(32).toString('base64url');
+    const secure = RP_ORIGIN.startsWith('https:') ? '; Secure' : '';
+    res.setHeader('Set-Cookie', `${SESSION_COOKIE}=${sid}; HttpOnly; SameSite=Lax; Path=/${secure}`);
+  }
+  return sid;
+}
+
+function issueNonce(sid) {
+  const nonce = randomBytes(32).toString('base64url');
+  sessions.set(sid, { nonce, expires: Date.now() + NONCE_TTL_MS });
+  return nonce;
+}
+
+// Atomically read and delete the single-use nonce.
+function consumeNonce(sid) {
+  const entry = sessions.get(sid);
+  sessions.delete(sid);
+  return entry && entry.expires > Date.now() ? entry.nonce : null;
+}
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [sid, e] of sessions) if (e.expires <= now) sessions.delete(sid);
+}, 60_000).unref();
+
+async function readBody(req) {
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > MAX_BODY) throw Object.assign(new Error('Body too large'), { status: 413 });
+    chunks.push(chunk);
+  }
+  const raw = Buffer.concat(chunks).toString('utf8');
+  const type = req.headers['content-type'] || '';
+  if (type.includes('application/json')) return JSON.parse(raw || '{}');
+  return Object.fromEntries(new URLSearchParams(raw));
+}
+
+function sendJson(res, status, body) {
+  res.writeHead(status, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' });
+  res.end(JSON.stringify(body));
+}
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+// ---- Routes ----
+async function renderHome(req, res) {
+  const sid = getSession(req, res);
+  const nonce = issueNonce(sid);
+  const html = (await readFile(join(ROOT, 'index.html'), 'utf8')).replaceAll('__EVP_NONCE__', nonce);
+  const headers = { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' };
+  if (ORIGIN_TRIAL_TOKEN) headers['Origin-Trial'] = ORIGIN_TRIAL_TOKEN;
+  res.writeHead(200, headers);
+  res.end(html);
+}
+
+async function handleSignup(req, res) {
+  // Reject cross-site form posts outright.
+  const origin = req.headers.origin;
+  if (origin && origin !== RP_ORIGIN) return sendJson(res, 403, { error: 'Forbidden origin.' });
+
+  const sid = getSession(req, res);
+  // Always consume the nonce up front so a captured token cannot be replayed.
+  const expectedNonce = consumeNonce(sid);
+  const nextNonce = issueNonce(sid);
+
+  let body;
+  try {
+    body = await readBody(req);
+  } catch (err) {
+    return sendJson(res, err.status || 400, { error: 'Invalid request.', nonce: nextNonce });
+  }
+
+  const name = String(body.name || '').trim();
+  const email = String(body.email || '').trim();
+  const password = String(body.password || '');
+  const rawToken = String(body.token || '').trim();
+
+  if (!name || name.length > 100) return sendJson(res, 400, { error: 'Please enter your name.', nonce: nextNonce });
+  if (!EMAIL_RE.test(email) || email.length > 254) {
+    return sendJson(res, 400, { error: 'Please enter a valid email address.', nonce: nextNonce });
+  }
+  if (password.length < 8 || password.length > 200) {
+    return sendJson(res, 400, { error: 'Password must be at least 8 characters.', nonce: nextNonce });
+  }
+
+  let verified = false;
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail: email,
+        expectedNonce,
+        expectedAudience: RP_ORIGIN,
+      });
+      verified = true;
+    } catch (err) {
+      console.error('Email verification token check failed:', err.message);
+    }
+  }
+
+  const store = await loadAccounts();
+  const key = email.toLowerCase();
+  const existing = store[key];
+
+  if (verified) {
+    // Ownership is proven, so it is safe to be specific.
+    if (existing?.status === 'active') {
+      return sendJson(res, 409, { error: 'An account with this email already exists. Try signing in.', nonce: nextNonce });
+    }
+    // Overwrites any unverified squatter record for this address.
+    store[key] = { name, email, passwordHash: await hashPassword(password), status: 'active', createdAt: Date.now(), verifiedBy: 'email-verification-api' };
+    await saveAccounts();
+    return sendJson(res, 201, { status: 'verified', message: `Welcome to Daily Grind Rewards, ${name}! Your email was verified automatically.`, nonce: nextNonce });
+  }
+
+  // Fallback: classic email verification. Respond identically whether or not the
+  // address is registered, so the form can't be used to enumerate accounts.
+  if (!existing) {
+    store[key] = { name, email, passwordHash: await hashPassword(password), status: 'pending', createdAt: Date.now() };
+    await saveAccounts();
+  }
+  await sendTraditionalVerificationEmail(email);
+  return sendJson(res, 202, { status: 'pending', message: 'Almost there! We sent a verification email. Follow its instructions to activate your account.', nonce: nextNonce });
+}
+
+const server = createServer(async (req, res) => {
+  try {
+    const { pathname } = new URL(req.url, RP_ORIGIN);
+    if (req.method === 'GET' && (pathname === '/' || pathname === '/index.html')) return await renderHome(req, res);
+    if (req.method === 'POST' && pathname === '/api/verify-email') return await handleSignup(req, res);
+    res.writeHead(404, { 'Content-Type': 'text/plain' });
+    res.end('Not found');
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) sendJson(res, 500, { error: 'Something went wrong.' });
+  }
+});
+
+server.listen(PORT, () => console.log(`Daily Grind listening on ${RP_ORIGIN}`));
diff --git a/server/verify-evt.js b/server/verify-evt.js
new file mode 100644
index 0000000..5a6c165
--- /dev/null
+++ b/server/verify-evt.js
@@ -0,0 +1,125 @@
+import { createHash } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { createRemoteJWKSet, importJWK, jwtVerify } from 'jose';
+
+// IETF draft-hardt-email-verification-02 specifies 'Ed25519' and 'ES256'.
+// TODO: Remove 'EdDSA' once live issuers finish transitioning to 'Ed25519'.
+const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+
+const hasher = (data, alg) =>
+  createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+async function fetchJson(url) {
+  const res = await fetch(url, {
+    redirect: 'error',
+    signal: AbortSignal.timeout(5000),
+    headers: { accept: 'application/json' },
+  });
+  if (!res.ok) throw new Error(`Issuer metadata request failed (${res.status}).`);
+  return res.json();
+}
+
+/**
+ * Verifies an Email Verification Token (EVT + KB-JWT SD-JWT presentation).
+ * Throws if any step fails; resolves on success.
+ */
+export async function verifyEmailVerificationToken({
+  rawToken,
+  submittedEmail,
+  expectedNonce,
+  expectedAudience,
+}) {
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evtPayload = decoded.jwt.payload;
+  const iss = evtPayload.iss;
+
+  if (!expectedNonce || !decoded.kbJwt || typeof iss !== 'string' || evtPayload.email_verified !== true) {
+    throw new Error('Missing nonce, KB-JWT, issuer, or email_verified !== true.');
+  }
+  if (evtPayload.email?.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+
+  // The issuer must be a bare https origin before we make any request to it.
+  const issUrl = new URL(iss);
+  if (issUrl.protocol !== 'https:' || issUrl.origin !== iss) {
+    throw new Error('Issuer must be a bare https origin.');
+  }
+
+  // DNS delegation: the email's domain must name this exact issuer.
+  const domain = submittedEmail.split('@').pop();
+  const txtRecords = (await dns.resolveTxt(`_email-verification.${domain}`)).map((r) => r.join(''));
+  if (!txtRecords.some((txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss)) {
+    throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+  }
+
+  const metadata = await fetchJson(new URL('/.well-known/email-verification', iss));
+  if (metadata.issuer !== iss || !metadata.jwks_uri?.startsWith('https://')) {
+    throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+  }
+  const issuerJwks = createRemoteJWKSet(new URL(metadata.jwks_uri));
+
+  const evtOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // Some issuers omit `kid`; trial-verify each matching key.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {}
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = evtPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header.alg;
+      if (
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+}
