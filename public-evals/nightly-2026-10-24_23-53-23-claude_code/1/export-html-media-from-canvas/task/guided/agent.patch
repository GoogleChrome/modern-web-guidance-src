+  <script>
+    (() => {
+      const canvas = document.getElementById('card_canvas');
+      const card = document.getElementById('export_element');
+      const nameInput = document.getElementById('card_name');
+      const messageInput = document.getElementById('card_message');
+      const colorInput = document.getElementById('card_color');
+      const exportButton = document.getElementById('export_button');
+      const status = document.getElementById('export_status');
+
+      // Pick a readable text color for the chosen background.
+      function updateCard() {
+        const hex = colorInput.value;
+        const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
+        const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
+        card.style.setProperty('--card-bg', hex);
+        card.style.setProperty('--card-fg', luminance > 0.6 ? '#3e2723' : '#ffffff');
+        document.getElementById('gc_to').textContent = nameInput.value ? `For ${nameInput.value}` : '';
+        document.getElementById('gc_message').textContent = messageInput.value;
+        if (supported) canvas.requestPaint();
+      }
+
+      const supported = 'content' in HTMLCanvasElement.prototype;
+      [nameInput, messageInput, colorInput].forEach((el) => el.addEventListener('input', updateCard));
+
+      if (!supported) {
+        // Children of a canvas are not rendered in browsers without HTML-in-Canvas,
+        // so show the card as plain HTML and disable export.
+        card.removeAttribute('drawable');
+        canvas.replaceWith(card);
+        exportButton.disabled = true;
+        status.textContent = 'Image export needs a browser with HTML-in-Canvas support (Chrome 157+).';
+        updateCard();
+        return;
+      }
+
+      const ctx = canvas.getContext('2d');
+
+      canvas.onpaint = () => {
+        ctx.reset();
+        ctx.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+      };
+
+      // Keep the canvas grid in device pixels so the export is sharp.
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        canvas.requestPaint();
+      });
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+
+      // Wait for the next paint event so the export reflects the latest edits.
+      const nextPaint = () => new Promise((resolve) => {
+        canvas.addEventListener('paint', resolve, { once: true });
+        canvas.requestPaint();
+      });
+
+      exportButton.addEventListener('click', async () => {
+        await nextPaint();
+        canvas.toBlob((blob) => {
+          if (!blob) {
+            status.textContent = 'Could not export the card. Please try again.';
+            return;
+          }
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.href = url;
+          link.download = 'daily-grind-gift-card.png';
+          link.click();
+          URL.revokeObjectURL(url);
+          status.textContent = 'Card downloaded.';
+        }, 'image/png');
+      });
+
+      updateCard();
+    })();
+  </script>
