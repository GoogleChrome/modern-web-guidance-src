+  <script>
+    (() => {
+      const W = 600, H = 360;
+      const canvas = document.getElementById('card_canvas');
+      const card = document.getElementById('export_element');
+      const ctx = canvas.getContext('2d');
+      const nameInput = document.getElementById('card_name');
+      const msgInput = document.getElementById('card_message');
+      const colorInput = document.getElementById('card_color');
+      const status = document.getElementById('export_status');
+
+      // Feature detection for the HTML-in-canvas API (layoutsubtree + drawElementImage + paint event)
+      const supported = !!ctx
+        && typeof ctx.drawElementImage === 'function'
+        && 'layoutsubtree' in canvas
+        && 'onpaint' in canvas
+        && typeof canvas.requestPaint === 'function';
+
+      function updateCardContent() {
+        document.getElementById('gc_message').textContent = msgInput.value;
+        document.getElementById('gc_name').textContent = nameInput.value ? 'For ' + nameInput.value : '';
+        card.style.backgroundColor = colorInput.value;
+      }
+
+      // --- Native path: render the real HTML element into the canvas ---
+      function paintNative() {
+        ctx.reset();
+        const transform = ctx.drawElementImage(card, 0, 0);
+        // Keep the DOM element's position in sync with what was drawn (hit testing, a11y)
+        if (transform) card.style.transform = transform.toString();
+      }
+
+      let paintWaiters = [];
+      function requestPaintAndWait() {
+        return new Promise(resolve => {
+          paintWaiters.push(resolve);
+          canvas.requestPaint();
+        });
+      }
+
+      // --- Fallback path: approximate the card with 2D canvas drawing ---
+      function wrapLines(text, maxWidth) {
+        const lines = [];
+        for (const para of text.split('\n')) {
+          let line = '';
+          for (const word of para.split(/\s+/).filter(Boolean)) {
+            const test = line ? line + ' ' + word : word;
+            if (line && ctx.measureText(test).width > maxWidth) { lines.push(line); line = word; }
+            else line = test;
+          }
+          lines.push(line);
+        }
+        return lines;
+      }
+
+      function paintFallback() {
+        const g = ctx;
+        g.clearRect(0, 0, W, H);
+        g.beginPath();
+        g.roundRect(0, 0, W, H, 16);
+        g.fillStyle = colorInput.value;
+        g.fill();
+        g.textBaseline = 'top';
+        g.fillStyle = '#fff';
+        g.font = 'bold 20.8px "Segoe UI", Tahoma, sans-serif';
+        g.letterSpacing = '3px';
+        g.fillText('THE DAILY GRIND', 40, 36);
+        g.font = '12px "Segoe UI", Tahoma, sans-serif';
+        g.letterSpacing = '2px';
+        g.fillStyle = '#ffab40';
+        g.fillText('GIFT CARD', 40, 62);
+        g.letterSpacing = '0px';
+        g.fillStyle = '#fff';
+        g.font = 'italic 25.6px "Segoe UI", Tahoma, sans-serif';
+        const lines = wrapLines(msgInput.value, W - 80).slice(0, 5);
+        lines.forEach((l, i) => g.fillText(l, 40, 120 + i * 35));
+        if (nameInput.value) {
+          g.fillStyle = '#ffab40';
+          g.font = '600 17.6px "Segoe UI", Tahoma, sans-serif';
+          g.fillText('For ' + nameInput.value, 40, H - 36 - 22);
+        }
+      }
+
+      function render() {
+        updateCardContent();
+        if (supported) canvas.requestPaint(); else paintFallback();
+      }
+
+      if (supported) {
+        canvas.addEventListener('paint', () => {
+          paintNative();
+          const waiters = paintWaiters; paintWaiters = [];
+          waiters.forEach(r => r());
+        });
+      } else {
+        // Canvas children aren't rendered without layoutsubtree, so nothing to move; just draw via 2D API.
+        card.hidden = true;
+      }
+
+      [nameInput, msgInput, colorInput].forEach(el => el.addEventListener('input', render));
+      render();
+
+      document.getElementById('export_button').addEventListener('click', async () => {
+        try {
+          updateCardContent();
+          if (supported) {
+            await (document.fonts ? document.fonts.ready : Promise.resolve());
+            await requestPaintAndWait(); // make sure the canvas reflects the latest DOM state
+          } else {
+            paintFallback();
+          }
+          const blob = await new Promise(res => canvas.toBlob(res, 'image/png'));
+          if (!blob) throw new Error('Canvas export failed');
+          const url = URL.createObjectURL(blob);
+          const a = document.createElement('a');
+          a.href = url;
+          a.download = 'daily-grind-gift-card.png';
+          document.body.appendChild(a);
+          a.click();
+          a.remove();
+          setTimeout(() => URL.revokeObjectURL(url), 1000);
+          status.textContent = supported ? 'Card downloaded.' : 'Card downloaded (simplified rendering: your browser lacks HTML-in-canvas support).';
+        } catch (err) {
+          status.textContent = 'Sorry, the card could not be exported.';
+          console.error(err);
+        }
+      });
+    })();
+  </script>
+
 </body>
 
