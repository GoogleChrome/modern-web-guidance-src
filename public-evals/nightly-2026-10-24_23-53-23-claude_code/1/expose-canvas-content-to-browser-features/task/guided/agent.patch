+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const form = document.getElementById('cup-form');
+      const summary = document.getElementById('cup-summary');
+      const ctx = canvas.getContext('2d');
+      const CSS_W = 320;
+      const CSS_H = 420;
+      // Where the form is drawn, in CSS pixels (keep in sync with the CSS)
+      const CUP_FORM = { x: 50, y: 100 };
+      const native = 'content' in HTMLCanvasElement.prototype;
+
+      if (!native) {
+        // No HTML-in-canvas: show the form on top of the canvas at the same coordinates
+        canvas.after(form);
+        form.removeAttribute('drawable');
+      }
+
+      function updateSummary() {
+        const data = new FormData(form);
+        const name = (data.get('name') || '').trim();
+        const syrups = data.getAll('syrup');
+        summary.textContent = `${name ? name + '’s' : 'Your'} order: ${data.get('milk')} milk` +
+          (syrups.length ? ' with ' + syrups.join(' & ') + ' syrup' : '');
+      }
+
+      function drawCup() {
+        const s = canvas.width / CSS_W;
+        ctx.reset();
+        ctx.scale(s, s);
+
+        // Saucer
+        ctx.fillStyle = '#d7ccc8';
+        ctx.beginPath();
+        ctx.ellipse(150, 392, 140, 18, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Handle
+        ctx.strokeStyle = '#4e342e';
+        ctx.lineWidth = 16;
+        ctx.beginPath();
+        ctx.moveTo(250, 120);
+        ctx.bezierCurveTo(310, 110, 310, 250, 235, 270);
+        ctx.stroke();
+
+        // Body
+        ctx.fillStyle = '#4e342e';
+        ctx.beginPath();
+        ctx.moveTo(20, 60);
+        ctx.lineTo(260, 60);
+        ctx.lineTo(240, 340);
+        ctx.quadraticCurveTo(236, 392, 190, 392);
+        ctx.lineTo(90, 392);
+        ctx.quadraticCurveTo(44, 392, 40, 340);
+        ctx.closePath();
+        ctx.fill();
+
+        // Coffee surface and rim
+        ctx.fillStyle = '#795548';
+        ctx.beginPath();
+        ctx.ellipse(140, 60, 120, 14, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Label panel behind the form
+        ctx.fillStyle = '#fffaf3';
+        ctx.beginPath();
+        ctx.roundRect(CUP_FORM.x - 6, CUP_FORM.y - 6, 192, 262, 10);
+        ctx.fill();
+
+        if (native) ctx.drawElementImage(form, CUP_FORM.x, CUP_FORM.y);
+      }
+
+      // Match the backing store to device pixels so nothing is blurry
+      const observer = new ResizeObserver(([entry]) => {
+        const box = entry.devicePixelContentBoxSize;
+        canvas.width = box ? box[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        canvas.height = box ? box[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        native ? canvas.requestPaint() : drawCup();
+      });
+      const hasDevicePixelBox = typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, hasDevicePixelBox ? { box: 'device-pixel-content-box' } : {});
+
+      if (native) canvas.onpaint = drawCup;
+
+      form.addEventListener('input', updateSummary);
+      updateSummary();
+    })();
+  </script>
