@@ -0,0 +1,80 @@
+import { buttonCSS, tokensCSS, focusCSS, sheet } from './shared.js';
+
+const styles = sheet(`
+  :host {
+    ${tokensCSS}
+    display: block;
+    font-family: inherit;
+  }
+  article {
+    height: 100%;
+    background: var(--card-bg, white);
+    padding: 20px;
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    text-align: center;
+  }
+  h3 {
+    margin: 0 0 10px;
+    color: var(--_primary);
+  }
+  ::slotted(p) { margin: 0; }
+  a {
+    ${buttonCSS}
+  }
+  a:hover { --_btn-bg: var(--_text); }
+  a:focus-visible { ${focusCSS} }
+`);
+
+/**
+ * <coffee-card heading="Cold Brew" href="/menu/cold-brew" cta="View Details">
+ *   <p>Description (default slot).</p>
+ * </coffee-card>
+ *
+ * The description stays in light DOM so it renders and is indexable
+ * even before the element upgrades.
+ */
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['heading', 'href', 'cta'];
+
+  #title; #link;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [styles];
+    root.innerHTML = `
+      <article part="card">
+        <h3 part="heading"></h3>
+        <slot></slot>
+        <a part="link"></a>
+      </article>`;
+    this.#title = root.querySelector('h3');
+    this.#link = root.querySelector('a');
+  }
+
+  get heading() { return this.getAttribute('heading') ?? ''; }
+  set heading(v) { this.setAttribute('heading', v); }
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(v) { this.setAttribute('href', v); }
+  get cta() { return this.getAttribute('cta') ?? 'View Details'; }
+  set cta(v) { this.setAttribute('cta', v); }
+
+  connectedCallback() { this.#render(); }
+
+  attributeChangedCallback(_name, oldVal, newVal) {
+    if (oldVal !== newVal) this.#render();
+  }
+
+  #render() {
+    this.#title.textContent = this.heading;
+    this.#link.textContent = this.cta;
+    if (this.href) this.#link.href = this.href;
+    else this.#link.removeAttribute('href');
+    // Visible text is a prefix of the accessible name (WCAG 2.5.3), and makes
+    // repeated "View Details" links distinguishable.
+    this.#link.setAttribute('aria-label', `${this.cta}: ${this.heading}`);
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
