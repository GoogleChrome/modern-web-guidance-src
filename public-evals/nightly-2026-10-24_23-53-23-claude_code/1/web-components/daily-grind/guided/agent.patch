+// Shared building blocks for the Daily Grind components.
+
+export const buttonCSS = `
+  background: var(--_btn-bg);
+  color: var(--_btn-fg);
+  display: inline-block;
+  padding: 10px 20px;
+  margin-top: 15px;
+  border-radius: 5px;
+  text-decoration: none;
+  transition: background 0.3s;
+`;
+
+// Theme tokens read from the page's custom properties (set on :root), with fallbacks.
+export const tokensCSS = `
+  --_primary: var(--primary, #4e342e);
+  --_secondary: var(--secondary, #d7ccc8);
+  --_accent: var(--accent, #ffab40);
+  --_text: var(--text, #3e2723);
+  --_btn-bg: var(--_primary);
+  --_btn-fg: white;
+`;
+
+export const focusCSS = `
+  outline: 3px solid var(--_accent);
+  outline-offset: 2px;
+`;
+
+export function sheet(css) {
+  const s = new CSSStyleSheet();
+  s.replaceSync(css);
+  return s;
+}
