@@ -0,0 +1,60 @@
+import { buttonCSS, tokensCSS, focusCSS, sheet } from './shared.js';
+
+const styles = sheet(`
+  :host {
+    ${tokensCSS}
+    display: block;
+    font-family: inherit;
+  }
+  header {
+    min-height: 60vh;
+    background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+      var(--_image, none) center / cover;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    color: white;
+    text-align: center;
+    padding: 0 20px;
+  }
+  ::slotted(h1) { font-size: 3rem; margin: 0 0 1rem; }
+  ::slotted(p) { margin: 0; }
+  ::slotted(a) { ${buttonCSS} }
+  ::slotted(a:hover) { --_btn-bg: var(--_text); }
+  ::slotted(a:focus-visible) { ${focusCSS} }
+`);
+
+/**
+ * <hero-banner image="https://...">
+ *   <h1>Title</h1><p>Tagline</p><a href="/order-online">Order Now</a>
+ * </hero-banner>
+ */
+export class HeroBanner extends HTMLElement {
+  static observedAttributes = ['image'];
+
+  #header;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [styles];
+    root.innerHTML = `<header part="hero"><slot></slot></header>`;
+    this.#header = root.querySelector('header');
+  }
+
+  get image() { return this.getAttribute('image') ?? ''; }
+  set image(v) { this.setAttribute('image', v); }
+
+  connectedCallback() { this.#render(); }
+  attributeChangedCallback(_n, o, v) { if (o !== v) this.#render(); }
+
+  #render() {
+    // Escape quotes/parens so the attribute can't break out of url("...").
+    const url = this.image.replace(/["\\\n]/g, encodeURIComponent);
+    if (url) this.#header.style.setProperty('--_image', `url("${url}")`);
+    else this.#header.style.removeProperty('--_image');
+  }
+}
+
+customElements.define('hero-banner', HeroBanner);
