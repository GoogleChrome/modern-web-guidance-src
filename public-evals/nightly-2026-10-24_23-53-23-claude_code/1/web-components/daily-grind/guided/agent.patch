+import { tokensCSS, focusCSS, sheet } from './shared.js';
+
+const styles = sheet(`
+  :host {
+    ${tokensCSS}
+    display: block;
+    margin-top: 40px;
+    background: var(--_secondary);
+    text-align: center;
+    padding: 40px 20px;
+    font-family: inherit;
+  }
+  nav { margin-bottom: 20px; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.25rem; }
+  ::slotted(a) { color: var(--_text); text-decoration: none; font-size: 0.85rem; }
+  ::slotted(a:hover) { text-decoration: underline; }
+  ::slotted(a:focus-visible) { ${focusCSS} }
+  p { margin: 0; }
+`);
+
+/**
+ * <site-footer label="Footer">
+ *   <a href="/about">Our Story</a> ...
+ *   <span slot="legal">&copy; 2026 ...</span>
+ * </site-footer>
+ */
+export class SiteFooter extends HTMLElement {
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [styles];
+    root.innerHTML = `
+      <nav aria-label="Footer"><slot></slot></nav>
+      <p><slot name="legal"></slot></p>`;
+  }
+}
+
+customElements.define('site-footer', SiteFooter);
diff --git a/components/site-nav.js b/components/site-nav.js
new file mode 100644
index 0000000..16ef786
--- /dev/null
+++ b/components/site-nav.js
@@ -0,0 +1,129 @@
+import { tokensCSS, focusCSS, sheet } from './shared.js';
+
+const styles = sheet(`
+  :host {
+    ${tokensCSS}
+    display: block;
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+    background: var(--_primary);
+    color: white;
+    font-family: inherit;
+  }
+  .bar {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: 0.5rem;
+    padding: 1rem 5%;
+  }
+  .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+  .links { display: flex; align-items: center; gap: 20px; }
+  ::slotted(a) {
+    color: white;
+    text-decoration: none;
+    font-size: 0.9rem;
+    transition: color 0.3s;
+  }
+  ::slotted(a:hover) { color: var(--_accent); }
+  ::slotted(a[data-variant="outline"]) {
+    border: 1px solid var(--_accent);
+    padding: 5px 12px;
+    border-radius: 4px;
+  }
+  ::slotted(a:focus-visible) { ${focusCSS} }
+  button {
+    display: none;
+    font: inherit;
+    color: inherit;
+    background: none;
+    border: 1px solid var(--_accent);
+    border-radius: 4px;
+    padding: 5px 12px;
+    cursor: pointer;
+  }
+  button:focus-visible { ${focusCSS} }
+
+  @media (max-width: 40rem) {
+    button { display: block; }
+    .links {
+      display: none;
+      flex-basis: 100%;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 12px;
+    }
+    :host(:state(open)) .links { display: flex; }
+  }
+`);
+
+/**
+ * <site-nav label="Main">
+ *   <span slot="logo">THE DAILY GRIND</span>
+ *   <a href="/menu">Menu</a> ...
+ *   <a href="/logout" data-variant="outline">Logout</a>
+ * </site-nav>
+ *
+ * Links are plain light-DOM anchors. On narrow screens they collapse behind a
+ * disclosure button; Escape closes the menu and returns focus to the button.
+ */
+export class SiteNav extends HTMLElement {
+  static observedAttributes = ['label'];
+
+  #internals; #button; #nav; #mq = matchMedia('(max-width: 40rem)');
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [styles];
+    root.innerHTML = `
+      <div class="bar">
+        <div class="logo" part="logo"><slot name="logo"></slot></div>
+        <button type="button" aria-expanded="false" aria-controls="links">Menu</button>
+        <nav class="links" id="links" part="links"><slot></slot></nav>
+      </div>`;
+    this.#button = root.querySelector('button');
+    this.#nav = root.querySelector('nav');
+    this.#button.addEventListener('click', () => this.open = !this.open);
+  }
+
+  get open() { return this.#internals.states.has('open'); }
+  set open(on) {
+    on = !!on;
+    if (on) this.#internals.states.add('open');
+    else this.#internals.states.delete('open');
+    this.#button.setAttribute('aria-expanded', String(on));
+  }
+
+  connectedCallback() {
+    this.#syncLabel();
+    this.addEventListener('keydown', this.#onKeydown);
+    this.#mq.addEventListener('change', this.#onResize);
+  }
+
+  disconnectedCallback() {
+    this.removeEventListener('keydown', this.#onKeydown);
+    this.#mq.removeEventListener('change', this.#onResize);
+  }
+
+  attributeChangedCallback() { this.#syncLabel(); }
+
+  #syncLabel() {
+    this.#nav.setAttribute('aria-label', this.getAttribute('label') ?? 'Main');
+  }
+
+  #onKeydown = (e) => {
+    if (e.key === 'Escape' && this.open) {
+      this.open = false;
+      this.#button.focus();
+    }
+  };
+
+  // Reset when returning to the wide layout so the menu doesn't reopen stale.
+  #onResize = (e) => { if (!e.matches) this.open = false; };
+}
+
+customElements.define('site-nav', SiteNav);
