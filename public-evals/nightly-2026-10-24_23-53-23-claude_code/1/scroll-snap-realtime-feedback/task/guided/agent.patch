+  <script>
+    (() => {
+      const gallery = document.getElementById('gallery');
+      const items = [...gallery.querySelectorAll('.gallery-item')];
+      const thumbnails = [...document.querySelectorAll('.thumbnail')];
+
+      const setPending = (index) => {
+        if (!thumbnails[index]) return;
+        thumbnails.forEach((t) => t.classList.remove('pending'));
+        thumbnails[index].classList.add('pending');
+      };
+
+      // Settled state: drop 'pending', mark the selected thumbnail active.
+      const setActive = (index) => {
+        if (!thumbnails[index]) return;
+        thumbnails.forEach((t) => {
+          t.classList.remove('pending', 'active');
+          t.removeAttribute('aria-current');
+        });
+        thumbnails[index].classList.add('active');
+        thumbnails[index].setAttribute('aria-current', 'true');
+      };
+
+      // Geometric lookup (items are center-snapped; gallery is the offsetParent).
+      const closestIndex = () => {
+        const center = gallery.scrollLeft + gallery.clientWidth / 2;
+        let best = 0;
+        let min = Infinity;
+        items.forEach((item, i) => {
+          const d = Math.abs(center - (item.offsetLeft + item.offsetWidth / 2));
+          if (d < min) { min = d; best = i; }
+        });
+        return best;
+      };
+
+      thumbnails.forEach((thumb, i) => {
+        thumb.addEventListener('click', () => {
+          items[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
+        });
+      });
+
+      if ('onscrollsnapchanging' in Element.prototype) {
+        gallery.addEventListener('scrollsnapchanging', (e) => {
+          setPending(items.indexOf(e.snapTargetInline));
+        });
+        gallery.addEventListener('scrollsnapchange', (e) => {
+          setActive(items.indexOf(e.snapTargetInline));
+        });
+      } else {
+        let rafId = null;
+        let timeout;
+        const settle = () => {
+          clearTimeout(timeout);
+          setActive(closestIndex());
+        };
+        gallery.addEventListener('scroll', () => {
+          if (!rafId) {
+            rafId = requestAnimationFrame(() => {
+              rafId = null;
+              setPending(closestIndex());
+            });
+          }
+          // Debounce for browsers without scrollend
+          clearTimeout(timeout);
+          timeout = setTimeout(settle, 100);
+        }, { passive: true });
+        gallery.addEventListener('scrollend', settle);
+      }
+
+      // Sync with the initial (possibly restored) scroll position.
+      const init = () => setActive(closestIndex());
+      if (document.readyState === 'complete') init();
+      else window.addEventListener('load', init, { once: true });
+    })();
+  </script>
+
