+  <script>
+    (function () {
+      var gallery = document.getElementById('gallery');
+      var items = Array.prototype.slice.call(gallery.querySelectorAll('.gallery-item'));
+      var thumbs = Array.prototype.slice.call(document.querySelectorAll('.thumbnail'));
+      var activeIndex = 0;
+
+      // Index of the item whose center is closest to the gallery's center,
+      // i.e. the one the scroll-snap will settle on.
+      function targetIndex() {
+        var center = gallery.scrollLeft + gallery.clientWidth / 2;
+        var best = 0;
+        var bestDist = Infinity;
+        items.forEach(function (item, i) {
+          var dist = Math.abs(item.offsetLeft + item.offsetWidth / 2 - center);
+          if (dist < bestDist) { bestDist = dist; best = i; }
+        });
+        return best;
+      }
+
+      function setPending(index) {
+        thumbs.forEach(function (t, i) {
+          t.classList.toggle('pending', i === index && i !== activeIndex);
+        });
+      }
+
+      function setActive(index) {
+        activeIndex = index;
+        thumbs.forEach(function (t, i) {
+          t.classList.remove('pending');
+          t.classList.toggle('active', i === index);
+          if (i === index) t.setAttribute('aria-current', 'true');
+          else t.removeAttribute('aria-current');
+        });
+      }
+
+      var settleTimer;
+      var hasScrollEnd = 'onscrollend' in window;
+
+      gallery.addEventListener('scroll', function () {
+        setPending(targetIndex());
+        if (!hasScrollEnd) {
+          clearTimeout(settleTimer);
+          settleTimer = setTimeout(onScrollEnd, 120);
+        }
+      }, { passive: true });
+
+      function onScrollEnd() { setActive(targetIndex()); }
+      if (hasScrollEnd) gallery.addEventListener('scrollend', onScrollEnd);
+
+      thumbs.forEach(function (t, i) {
+        t.addEventListener('click', function () {
+          items[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
+        });
+      });
+
+      setActive(0);
+    })();
+  </script>
+
