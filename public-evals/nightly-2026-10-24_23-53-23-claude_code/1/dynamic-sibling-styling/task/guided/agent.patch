+  <script>
+    // Fallback for browsers without sibling-index()/sibling-count()
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      document.querySelectorAll('.spectrum-card, .fan-card, .circle-orb').forEach((el) => {
+        const group = [...el.parentElement.children].filter((c) => c.className === el.className);
+        el.style.setProperty('--sibling-index', group.indexOf(el) + 1);
+        el.style.setProperty('--sibling-count', group.length);
+      });
+    }
+  </script>
