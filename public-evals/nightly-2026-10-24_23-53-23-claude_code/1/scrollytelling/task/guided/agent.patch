+      gap: 40px;
+    }
+
+    #tracked section {
+      min-height: 70vh;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+    }
+
+    #tracked h3 {
+      color: var(--primary);
+      font-size: 1.6rem;
+      margin-bottom: 10px;
+    }
+
+    #animated section {
+      background: var(--primary);
+      color: white;
+      border-radius: 8px;
+      padding: 40px 30px;
+      margin-bottom: 20px;
+      text-align: center;
+    }
+
+    #animated .step {
+      display: block;
+      font-size: 4rem;
+      font-weight: bold;
+      color: var(--accent);
+    }
+
+    @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+      #tracked section:nth-child(1) { view-timeline: --tl-1 block; }
+      #tracked section:nth-child(2) { view-timeline: --tl-2 block; }
+      #tracked section:nth-child(3) { view-timeline: --tl-3 block; }
+
+      #animated {
+        position: sticky;
+        top: 90px;
+        align-self: start;
+        display: grid;
+        height: 50vh;
+      }
+
+      #animated section {
+        grid-area: 1 / 1;
+        margin: 0;
+        display: flex;
+        flex-direction: column;
+        justify-content: center;
+        will-change: transform, opacity;
+        animation: story-in auto linear both, story-out auto linear forwards;
+        animation-range: entry 25% cover 50%, exit 50% exit 75%;
+      }
+
+      #animated section:nth-child(1) { animation-timeline: --tl-1; }
+      #animated section:nth-child(2) { animation-timeline: --tl-2; }
+      #animated section:nth-child(3) { animation-timeline: --tl-3; }
+
+      @keyframes story-in {
+        from { opacity: 0; transform: scale(0.85) translateY(40px); }
+        to { opacity: 1; transform: none; }
+      }
+
+      @keyframes story-out {
+        to { opacity: 0; transform: translateY(-40px); }
+      }
+
+      @media (prefers-reduced-motion: reduce) {
+        #animated {
+          position: static;
+          height: auto;
+          display: block;
+        }
+
+        #animated section {
+          animation: none;
+          margin-bottom: 20px;
+        }
+      }
+    }
