+    }
+
+    #animated section:nth-child(1) { background-image: linear-gradient(transparent 50%, rgba(0, 0, 0, .6)), url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=800&q=70'); }
+    #animated section:nth-child(2) { background-image: linear-gradient(transparent 50%, rgba(0, 0, 0, .6)), url('https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=800&q=70'); }
+    #animated section:nth-child(3) { background-image: linear-gradient(transparent 50%, rgba(0, 0, 0, .6)), url('https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=800&q=70'); }
+    #animated section:nth-child(4) { background-image: linear-gradient(transparent 50%, rgba(0, 0, 0, .6)), url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=800&q=70'); }
+
+    @keyframes reveal {
+      0%, 30% { opacity: 0; transform: translateY(40px) scale(0.96); }
+      45%, 55% { opacity: 1; transform: none; }
+      70%, 100% { opacity: 0; transform: translateY(-40px) scale(0.96); }
+    }
+
+    @supports (animation-timeline: view()) {
+      #animated section {
+        opacity: 0;
+        animation: reveal linear both;
+        animation-range: cover;
+        will-change: opacity, transform;
+      }
+
+      #animated section:nth-child(1) { animation-timeline: --step-1; }
+      #animated section:nth-child(2) { animation-timeline: --step-2; }
+      #animated section:nth-child(3) { animation-timeline: --step-3; }
+      #animated section:nth-child(4) { animation-timeline: --step-4; }
+    }
+
+    /* No scroll-driven animation support or reduced motion: plain stacked layout */
+    @media (prefers-reduced-motion: reduce) {
+      #animated section { animation: none !important; }
+    }
+
+    @supports not (animation-timeline: view()) {
+      #animated { position: static; height: auto; max-height: none; gap: 20px; }
+      #animated section { grid-area: auto; min-height: 220px; }
+    }
+
+    @media (max-width: 720px) {
