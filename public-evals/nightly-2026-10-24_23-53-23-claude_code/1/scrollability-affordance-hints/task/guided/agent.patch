+    /* Customer Reviews */
+    .reviews-scroller {
+      height: 360px;
+      overflow-y: auto;
+      position: relative;
+      margin-top: 20px;
+      border-radius: 8px;
+      /* Establish as a scroll-state query container */
+      container-type: scroll-state;
+    }
+
+    .reviews-list {
+      list-style: none;
+      display: grid;
+      gap: 16px;
+      padding: 4px;
+    }
+
+    .review {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .review-stars {
+      color: var(--accent);
+      letter-spacing: 2px;
+    }
+
+    .review blockquote {
+      margin: 6px 0;
+    }
+
+    .review cite {
+      font-size: 0.85rem;
+      font-style: normal;
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    /* Overlays take no layout space and never intercept clicks */
+    .indicator-top,
+    .indicator-bottom {
+      position: sticky;
+      left: 0;
+      right: 0;
+      height: 40px;
+      opacity: 0;
+      transition: opacity 0.2s;
+      pointer-events: none;
+    }
+
+    .indicator-top {
+      top: 0;
+      margin-bottom: -40px;
+      background: linear-gradient(to bottom, var(--light), transparent);
+    }
+
+    .indicator-bottom {
+      bottom: 0;
+      margin-top: -40px;
+      background: linear-gradient(to top, var(--light), transparent);
+    }
+
+    .sentinel-top,
+    .sentinel-bottom {
+      height: 1px;
+      visibility: hidden;
+    }
+
+    .sentinel-top {
+      margin-bottom: -1px;
+    }
+
+    .sentinel-bottom {
+      margin-top: -1px;
+    }
+
+    /* Top: only once scrolled down. Bottom: only while more content below */
+    @container scroll-state(scrollable: top) {
+      .indicator-top {
+        opacity: 1;
+      }
+    }
+
+    @container scroll-state(scrollable: bottom) {
+      .indicator-bottom {
+        opacity: 1;
+      }
+    }
+
+    /* Fallback classes (set by IntersectionObserver where scroll-state is unsupported) */
+    .reviews-scroller.scrolled-down .indicator-top,
+    .reviews-scroller.can-scroll-down .indicator-bottom {
+      opacity: 1;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .indicator-top,
+      .indicator-bottom {
+        transition: none;
+      }
+    }
+
