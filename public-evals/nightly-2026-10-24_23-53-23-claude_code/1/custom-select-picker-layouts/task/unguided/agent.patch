+
+  <script>
+    (function () {
+      var picker = document.querySelector('.roast-picker');
+      var select = picker.querySelector('select');
+      var trigger = picker.querySelector('.roast-trigger');
+      var label = picker.querySelector('.roast-label');
+      var menu = picker.querySelector('.roast-menu');
+      var options = Array.prototype.slice.call(menu.querySelectorAll('.roast-option'));
+
+      function sync() {
+        options.forEach(function (o) {
+          o.setAttribute('aria-selected', String(o.dataset.value === select.value));
+        });
+        label.textContent = select.options[select.selectedIndex].text + ' roast';
+      }
+
+      function setOpen(open, focusIdx) {
+        menu.hidden = !open;
+        trigger.setAttribute('aria-expanded', String(open));
+        if (open) {
+          var i = focusIdx != null ? focusIdx : select.selectedIndex;
+          options[i].focus();
+        }
+      }
+
+      function choose(opt) {
+        select.value = opt.dataset.value;
+        select.dispatchEvent(new Event('change', { bubbles: true }));
+        sync();
+        setOpen(false);
+        trigger.focus();
+      }
+
+      trigger.addEventListener('click', function () { setOpen(menu.hidden); });
+      trigger.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); setOpen(true); }
+      });
+      options.forEach(function (o, i) {
+        o.addEventListener('click', function () { choose(o); });
+        o.addEventListener('keydown', function (e) {
+          var n = options.length;
+          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); options[(i + 1) % n].focus(); }
+          else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); options[(i + n - 1) % n].focus(); }
+          else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(o); }
+          else if (e.key === 'Escape') { setOpen(false); trigger.focus(); }
+          else if (e.key === 'Tab') { setOpen(false); }
+        });
+      });
+      document.addEventListener('click', function (e) {
+        if (!picker.contains(e.target)) setOpen(false);
+      });
+      sync();
+    })();
+  </script>
