   </footer>
 
+
+  <script type="module">
+    // Nanosecond UTC timestamps as emitted by backend services, out of order.
+    const batch = [
+      { service: 'kitchen-display', event: 'drink.ready', ts: '2026-10-25T08:15:03.412907331Z' },
+      { service: 'order-api', event: 'order.placed', ts: '2026-10-25T08:15:03.402118004Z' },
+      { service: 'payments', event: 'payment.captured', ts: '2026-10-25T08:15:03.402655920Z' },
+      { service: 'barista-app', event: 'brew.started', ts: '2026-10-25T08:15:03.409300117Z' },
+      { service: 'order-api', event: 'order.confirmed', ts: '2026-10-25T08:15:03.402655921Z' },
+      { service: 'inventory', event: 'beans.reserved', ts: '2026-10-25T08:15:03.404021688Z' },
+    ];
+
+    const button = document.getElementById('load-events');
+    const status = document.getElementById('timeline-status');
+    const list = document.getElementById('timeline-list');
+
+    // Temporal is not available in Safari yet; load the polyfill on demand.
+    async function ensureTemporal() {
+      if (typeof Temporal !== 'undefined') return;
+      const module = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    function formatGap(gap) {
+      // Keep the Duration structured; never collapse to a Number of nanoseconds.
+      return gap.toLocaleString('en-US', { style: 'narrow' });
+    }
+
+    function render(events) {
+      list.replaceChildren(...events.map((evt, i) => {
+        const li = document.createElement('li');
+        const name = document.createElement('span');
+        name.className = 'event-name';
+        name.textContent = evt.event;
+        const meta = document.createElement('span');
+        meta.className = 'event-meta';
+        const time = document.createElement('time');
+        time.dateTime = evt.timestamp.toString();
+        time.textContent = evt.timestamp.toString();
+        meta.append(`${evt.service} · `, time);
+        li.append(name, meta);
+        if (i > 0) {
+          const gap = document.createElement('span');
+          gap.className = 'event-gap';
+          const prev = events[i - 1];
+          gap.textContent = evt.timestamp.equals(prev.timestamp)
+            ? '+ 0 (simultaneous with previous event)'
+            : `+ ${formatGap(evt.timestamp.since(prev.timestamp))} since ${prev.event}`;
+          li.append(gap);
+        }
+        return li;
+      }));
+    }
+
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      status.textContent = 'Loading events…';
+      try {
+        await ensureTemporal();
+        // Instant.from keeps full nanosecond precision (Date would truncate to ms).
+        const parsed = batch.map((e) => ({ ...e, timestamp: Temporal.Instant.from(e.ts) }));
+        const sorted = parsed.toSorted((a, b) => Temporal.Instant.compare(a.timestamp, b.timestamp));
+        render(sorted);
+        const total = sorted.at(-1).timestamp.since(sorted[0].timestamp);
+        status.textContent = `${sorted.length} events sequenced. Total span: ${formatGap(total)}.`;
+      } catch (err) {
+        status.textContent = 'Could not load order events.';
+        console.error(err);
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
 </body>
 
