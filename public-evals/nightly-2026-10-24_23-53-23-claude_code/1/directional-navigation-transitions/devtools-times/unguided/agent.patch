diff --git a/src/components/TopStoriesSlider.astro b/src/components/TopStoriesSlider.astro
new file mode 100644
index 0000000..ab09d84
--- /dev/null
+++ b/src/components/TopStoriesSlider.astro
@@ -0,0 +1,81 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+export interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+<div class="bg-white border-b border-gray-300">
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+        <top-stories-slider class="flex items-center gap-3" aria-roledescription="carousel" aria-label="Top stories">
+            <button type="button" data-prev aria-label="Previous story" class="shrink-0 px-3 py-1 text-sm font-semibold border border-gray-300 rounded hover:text-amber-400 cursor-pointer">
+                Previous
+            </button>
+            <div class="flex-1 overflow-hidden" aria-live="polite">
+                {articles.map((article, index) => (
+                    <div class="top-story" data-slide hidden={index !== 0} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${articles.length}`}>
+                        <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                            <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                        </a>
+                        <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                    </div>
+                ))}
+            </div>
+            <button type="button" data-next aria-label="Next story" class="shrink-0 px-3 py-1 text-sm font-semibold border border-gray-300 rounded hover:text-amber-400 cursor-pointer">
+                Next
+            </button>
+        </top-stories-slider>
+    </div>
+</div>
+
+<style>
+    .top-story.from-right {
+        animation: top-story-from-right 300ms ease-out;
+    }
+    .top-story.from-left {
+        animation: top-story-from-left 300ms ease-out;
+    }
+    @keyframes top-story-from-right {
+        from { transform: translateX(100%); opacity: 0; }
+        to { transform: translateX(0); opacity: 1; }
+    }
+    @keyframes top-story-from-left {
+        from { transform: translateX(-100%); opacity: 0; }
+        to { transform: translateX(0); opacity: 1; }
+    }
+    @media (prefers-reduced-motion: reduce) {
+        .top-story.from-right,
+        .top-story.from-left {
+            animation: none;
+        }
+    }
+</style>
+
+<script>
+    class TopStoriesSlider extends HTMLElement {
+        connectedCallback() {
+            const slides = Array.from(this.querySelectorAll<HTMLElement>('[data-slide]'));
+            let current = 0;
+
+            const show = (delta: number) => {
+                const next = (current + delta + slides.length) % slides.length;
+                if (next === current) return;
+                slides[current].hidden = true;
+                slides[current].classList.remove('from-left', 'from-right');
+                const incoming = slides[next];
+                incoming.hidden = false;
+                incoming.classList.add(delta > 0 ? 'from-right' : 'from-left');
+                current = next;
+            };
+
+            this.querySelector('[data-next]')?.addEventListener('click', () => show(1));
+            this.querySelector('[data-prev]')?.addEventListener('click', () => show(-1));
+        }
+    }
+
+    if (!customElements.get('top-stories-slider')) {
+        customElements.define('top-stories-slider', TopStoriesSlider);
+    }
+</script>
