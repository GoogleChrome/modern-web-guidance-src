+</Layout>
+<style is:global>
+    .top-stories-viewport { view-transition-name: top-stories; }
+
+    @keyframes top-stories-to-left { to { transform: translateX(-100%); } }
+    @keyframes top-stories-from-right { from { transform: translateX(100%); } }
+    @keyframes top-stories-to-right { to { transform: translateX(100%); } }
+    @keyframes top-stories-from-left { from { transform: translateX(-100%); } }
+
+    ::view-transition-group(top-stories) {
+        overflow: clip;
+        animation-duration: 0.35s;
+    }
+    ::view-transition-old(top-stories),
+    ::view-transition-new(top-stories) {
+        animation-duration: 0.35s;
+        animation-timing-function: ease-in-out;
+        animation-fill-mode: both;
+    }
+    html:active-view-transition-type(forward)::view-transition-old(top-stories) { animation-name: top-stories-to-left; }
+    html:active-view-transition-type(forward)::view-transition-new(top-stories) { animation-name: top-stories-from-right; }
+    html:active-view-transition-type(backward)::view-transition-old(top-stories) { animation-name: top-stories-to-right; }
+    html:active-view-transition-type(backward)::view-transition-new(top-stories) { animation-name: top-stories-from-left; }
+
+    @media (prefers-reduced-motion: reduce) {
+        ::view-transition-group(top-stories),
+        ::view-transition-old(top-stories),
+        ::view-transition-new(top-stories) {
+            animation: none !important;
+        }
+    }
+</style>
+
+<script>
+    const slider = document.querySelector<HTMLElement>('[data-top-stories]');
+    if (slider) {
+        const slides = Array.from(slider.querySelectorAll<HTMLElement>('[data-slide]'));
+        let current = 0;
+
+        function go(direction: 'forward' | 'backward') {
+            const step = direction === 'forward' ? 1 : -1;
+            const next = (current + step + slides.length) % slides.length;
+            const update = () => {
+                slides[current].hidden = true;
+                slides[next].hidden = false;
+                current = next;
+            };
+            if (!document.startViewTransition) {
+                update();
+                return;
+            }
+            document.startViewTransition({ update, types: [direction] });
+        }
+
+        slider.querySelector('[data-prev]')?.addEventListener('click', () => go('backward'));
+        slider.querySelector('[data-next]')?.addEventListener('click', () => go('forward'));
+    }
+</script>
