+<script>
+    (function () {
+      var root = document.querySelector('.carousel');
+      var cards = root.querySelectorAll('.card');
+      var status = root.querySelector('.carousel-status');
+      var index = 0;
+
+      function show(next, dir) {
+        index = (next + cards.length) % cards.length;
+        cards.forEach(function (card, i) {
+          card.hidden = i !== index;
+          card.classList.remove('enter-next', 'enter-prev');
+        });
+        if (dir) cards[index].classList.add(dir > 0 ? 'enter-next' : 'enter-prev');
+        status.textContent = (index + 1) + ' of ' + cards.length;
+      }
+
+      root.querySelectorAll('[data-dir]').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          var dir = Number(btn.dataset.dir);
+          show(index + dir, dir);
+        });
+      });
+
+      show(0, 0);
+    })();
+  </script>
+
 </body>
 
