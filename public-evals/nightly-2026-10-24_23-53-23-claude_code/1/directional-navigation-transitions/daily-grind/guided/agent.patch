+  <script>
+    const slides = [...document.querySelectorAll('.carousel-viewport .card')];
+    let current = 0;
+
+    function show(delta) {
+      const next = (current + delta + slides.length) % slides.length;
+      const update = () => {
+        slides[current].hidden = true;
+        slides[next].hidden = false;
+        current = next;
+      };
+      if (!document.startViewTransition) {
+        update();
+        return;
+      }
+      document.startViewTransition({
+        update,
+        types: [delta > 0 ? 'forward' : 'backward']
+      });
+    }
+
+    document.getElementById('carousel-next').addEventListener('click', () => show(1));
+    document.getElementById('carousel-prev').addEventListener('click', () => show(-1));
+  </script>
+
