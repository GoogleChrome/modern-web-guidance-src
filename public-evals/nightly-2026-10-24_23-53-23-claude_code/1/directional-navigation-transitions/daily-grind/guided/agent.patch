+
+    ::view-transition-group(carousel) {
+      animation-duration: 0.35s;
+      animation-timing-function: ease-in-out;
+      overflow: clip;
+    }
+
+    ::view-transition-old(carousel),
+    ::view-transition-new(carousel) {
+      animation-duration: 0.35s;
+      animation-timing-function: ease-in-out;
+      animation-fill-mode: both;
+    }
+
+    @keyframes slide-to-left { to { transform: translateX(-100%); } }
+    @keyframes slide-from-right { from { transform: translateX(100%); } }
+    @keyframes slide-to-right { to { transform: translateX(100%); } }
+    @keyframes slide-from-left { from { transform: translateX(-100%); } }
+
+    html:active-view-transition-type(forward)::view-transition-old(carousel) {
+      animation-name: slide-to-left;
+    }
+    html:active-view-transition-type(forward)::view-transition-new(carousel) {
+      animation-name: slide-from-right;
+    }
+    html:active-view-transition-type(backward)::view-transition-old(carousel) {
+      animation-name: slide-to-right;
+    }
+    html:active-view-transition-type(backward)::view-transition-new(carousel) {
+      animation-name: slide-from-left;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(carousel),
+      ::view-transition-old(carousel),
+      ::view-transition-new(carousel) {
+        animation: none !important;
+      }
+    }
