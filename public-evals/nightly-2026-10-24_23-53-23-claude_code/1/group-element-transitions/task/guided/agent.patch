+
+    /* Shared transition logic for every bean card */
+    ::view-transition-group(.bean) {
+      animation-duration: 0.45s;
+      animation-timing-function: ease-in-out;
+    }
+
+    ::view-transition-new(.bean):only-child {
+      animation-name: bean-in;
+    }
+
+    ::view-transition-old(.bean):only-child {
