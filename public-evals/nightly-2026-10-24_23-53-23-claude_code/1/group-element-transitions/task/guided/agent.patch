+  <script>
+    const BEANS = [
+      { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', origin: 'Floral, citrus, light roast' },
+      { id: 'colombia', name: 'Colombia Supremo', origin: 'Caramel, nutty, medium roast' },
+      { id: 'sumatra', name: 'Sumatra Mandheling', origin: 'Earthy, bold, dark roast' },
+      { id: 'kenya', name: 'Kenya AA', origin: 'Berry, bright, medium roast' },
+      { id: 'brazil', name: 'Brazil Santos', origin: 'Chocolate, low acidity, medium roast' },
+      { id: 'guatemala', name: 'Guatemala Antigua', origin: 'Cocoa, spice, medium-dark roast' },
+    ];
+
+    const selected = ['colombia', 'ethiopia'];
+    const picker = document.getElementById('bean-picker');
+    const grid = document.getElementById('bean-grid');
+    const empty = document.getElementById('bean-empty');
+    const status = document.getElementById('bean-status');
+    const beanById = (id) => BEANS.find((b) => b.id === id);
+
+    function render() {
+      picker.replaceChildren(...BEANS.map((bean) => {
+        const btn = document.createElement('button');
+        btn.type = 'button';
+        btn.className = 'bean-option';
+        btn.dataset.add = bean.id;
+        btn.disabled = selected.includes(bean.id);
+        btn.textContent = `+ ${bean.name}`;
+        return btn;
+      }));
+
+      grid.replaceChildren(...selected.map((id) => {
+        const bean = beanById(id);
+        const li = document.createElement('li');
+        li.className = 'card bean-card';
+        // Unique name per element; the shared look lives in view-transition-class.
+        li.style.viewTransitionName = `bean-${id}`;
+        li.innerHTML = '<h3></h3><p class="origin"></p><button type="button">Remove</button>';
+        li.querySelector('h3').textContent = bean.name;
+        li.querySelector('.origin').textContent = bean.origin;
+        const remove = li.querySelector('button');
+        remove.dataset.remove = id;
+        remove.setAttribute('aria-label', `Remove ${bean.name}`);
+        return li;
+      }));
+
+      empty.hidden = selected.length > 0;
+    }
+
+    // Wrap the DOM update so all cards animate together with shared logic.
+    function update(change, message) {
+      const apply = () => {
+        change();
+        render();
+        status.textContent = message;
+      };
+      if (document.startViewTransition) {
+        document.startViewTransition(apply);
+      } else {
+        apply();
+      }
+    }
+
+    picker.addEventListener('click', (e) => {
+      const id = e.target.closest('[data-add]')?.dataset.add;
+      if (!id || selected.includes(id)) return;
+      update(() => selected.push(id), `${beanById(id).name} added.`);
+    });
+
+    grid.addEventListener('click', (e) => {
+      const id = e.target.closest('[data-remove]')?.dataset.remove;
+      if (!id) return;
+      update(() => selected.splice(selected.indexOf(id), 1), `${beanById(id).name} removed.`);
+    });
+
+    render();
+  </script>
 </body>
 
