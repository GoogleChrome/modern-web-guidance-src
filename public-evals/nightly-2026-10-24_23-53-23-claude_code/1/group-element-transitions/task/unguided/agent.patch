+
+  <script>
+    const beans = [
+      { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', note: 'Floral, citrus, light roast' },
+      { id: 'colombia', name: 'Colombia Huila', note: 'Caramel, red apple, medium roast' },
+      { id: 'sumatra', name: 'Sumatra Mandheling', note: 'Earthy, cocoa, dark roast' },
+      { id: 'guatemala', name: 'Guatemala Antigua', note: 'Chocolate, spice, medium roast' },
+      { id: 'kenya', name: 'Kenya AA', note: 'Blackcurrant, bright, light roast' },
+      { id: 'brazil', name: 'Brazil Santos', note: 'Nutty, low acidity, medium-dark roast' }
+    ];
+    const selected = new Set();
+    const lists = {
+      available: document.getElementById('bean-available'),
+      selected: document.getElementById('bean-selected')
+    };
+    const count = document.getElementById('bean-count');
+
+    // Build each bean element once; rendering only moves them between lists,
+    // which lets the view transition track each one by its unique name.
+    const items = new Map(beans.map(bean => {
+      const li = document.createElement('li');
+      li.className = 'bean-item';
+      li.style.viewTransitionName = 'bean-' + bean.id;
+      li.innerHTML = '<span><strong></strong><small></small></span><button type="button" class="bean-toggle"></button>';
+      li.querySelector('strong').textContent = bean.name;
+      li.querySelector('small').textContent = bean.note;
+      li.querySelector('button').dataset.id = bean.id;
+      return [bean.id, li];
+    }));
+
+    function render() {
+      for (const bean of beans) {
+        const li = items.get(bean.id);
+        const isSelected = selected.has(bean.id);
+        const btn = li.querySelector('button');
+        li.classList.toggle('selected', isSelected);
+        btn.textContent = isSelected ? '\u2212' : '+';
+        btn.setAttribute('aria-label', (isSelected ? 'Remove ' : 'Add ') + bean.name);
+        lists[isSelected ? 'selected' : 'available'].append(li);
+      }
+      count.textContent = selected.size;
+    }
+
+    // All items animate together through one transition with shared logic.
+    function update(change) {
+      if (!document.startViewTransition) {
+        change();
+        return;
+      }
+      document.startViewTransition(change);
+    }
+
+    document.querySelector('.bean-panels').addEventListener('click', event => {
+      const btn = event.target.closest('.bean-toggle');
+      if (!btn) return;
+      const id = btn.dataset.id;
+      update(() => {
+        selected.has(id) ? selected.delete(id) : selected.add(id);
+        render();
+      });
+      // Keep keyboard focus on the moved button
+      btn.focus();
+    });
+
+    render();
+  </script>
+
