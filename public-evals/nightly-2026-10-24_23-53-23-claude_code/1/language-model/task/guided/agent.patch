+  <script>
+    (() => {
+      const $ = (id) => document.getElementById(id);
+      const MAX_BRANCHES = 3;
+      const BARISTA_PROMPT =
+        'You are a friendly barista at The Daily Grind. Only answer questions about the Maple Oat Latte ' +
+        '(creamy oat milk with a hint of Vermont maple syrup) or the Cold Brew (steeped for 18 hours for maximum smoothness). ' +
+        'If asked about anything else, politely say you can only help with those two drinks. Keep answers brief.';
+
+      const supported = 'LanguageModel' in self;
+      // Pre-warmed base sessions hold only system instructions; work happens on clones.
+      const bases = {};
+      const pending = {};
+      const controllers = {};
+
+      // Shared availability check + creation with download progress.
+      async function createSession(options, statusEl, progressEl) {
+        if (!supported) throw new Error('The built-in AI (Prompt API) is not supported in this browser.');
+        const availability = await LanguageModel.availability();
+        if (availability === 'unavailable') throw new Error('The built-in AI model is unavailable on this device.');
+        statusEl.textContent = availability === 'available' ? 'Preparing model…' : 'Downloading model…';
+        try {
+          return await LanguageModel.create({
+            ...options,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                if (progressEl) {
+                  progressEl.hidden = false;
+                  progressEl.value = e.loaded;
+                }
+                statusEl.textContent = `Downloading model… ${Math.round(e.loaded * 100)}%`;
+              });
+            },
+          });
+        } finally {
+          if (progressEl) progressEl.hidden = true;
+        }
+      }
+
+      function getBase(key, options, statusEl, progressEl) {
+        pending[key] ??= createSession(options, statusEl, progressEl).then((s) => (bases[key] = s)).catch((err) => {
+          delete pending[key];
+          throw err;
+        });
+        return pending[key];
+      }
+
+      const errorMessage = (err) => (err.name === 'AbortError' ? 'Stopped.' : err.message || String(err));
+
+      // ---- Ask the Barista (streaming) ----
+      const askBtn = $('ask-the-barista');
+      const stopBtn = $('barista-stop');
+      const baristaOpts = { initialPrompts: [{ role: 'system', content: BARISTA_PROMPT }] };
+
+      askBtn.addEventListener('click', async () => {
+        const question = $('barista-question').value.trim();
+        const answer = $('barista-answer');
+        const status = $('barista-status');
+        if (!question) {
+          status.textContent = 'Please type a question first.';
+          return;
+        }
+        askBtn.disabled = true;
+        stopBtn.hidden = false;
+        answer.textContent = '';
+        controllers.barista = new AbortController();
+        let session;
+        try {
+          const base = await getBase('barista', baristaOpts, status, $('barista-progress'));
+          session = await base.clone();
+          status.textContent = 'Thinking…';
+          const stream = session.promptStreaming(question, { signal: controllers.barista.signal });
+          for await (const chunk of stream) {
+            answer.append(chunk); // text node only: model output is untrusted
+            status.textContent = 'Answering…';
+          }
+          status.textContent = '';
+        } catch (err) {
+          status.textContent = errorMessage(err);
+        } finally {
+          session?.destroy();
+          askBtn.disabled = false;
+          stopBtn.hidden = true;
+        }
+      });
+      stopBtn.addEventListener('click', () => controllers.barista?.abort());
+
+      // Warm the model once the user shows interest.
+      $('barista-question').addEventListener('focus', () => {
+        if (supported) getBase('barista', baristaOpts, $('barista-status'), $('barista-progress')).then(() => {
+          $('barista-status').textContent = '';
+        }, () => {});
+      }, { once: true });
+
+      // ---- Feedback analyzer (structured output) ----
+      const sentimentSchema = {
+        type: 'object',
+        properties: {
+          score: { type: 'number', minimum: -1, maximum: 1 },
+          category: { type: 'string', enum: ['positive', 'neutral', 'negative'] },
+        },
+        required: ['score', 'category'],
+      };
+      const sentimentOpts = {
+        initialPrompts: [{
+          role: 'system',
+          content: 'Classify customer feedback for a coffee shop. score ranges from -1 (very negative) to 1 (very positive).',
+        }],
+      };
+
+      $('sentiment-btn').addEventListener('click', async () => {
+        const btn = $('sentiment-btn');
+        const status = $('sentiment-status');
+        const output = $('sentiment-output');
+        const text = $('feedback-text').value.trim();
+        if (!text) {
+          status.textContent = 'Please enter some feedback.';
+          return;
+        }
+        btn.disabled = true;
+        output.textContent = '';
+        let session;
+        try {
+          const base = await getBase('sentiment', sentimentOpts, status);
+          session = await base.clone();
+          status.textContent = 'Analyzing…';
+          const result = await session.prompt(`Feedback: ${text}`, { responseConstraint: sentimentSchema });
+          const data = JSON.parse(result);
+          output.textContent = JSON.stringify({ score: data.score, category: data.category }, null, 2);
+          status.textContent = '';
+        } catch (err) {
+          status.textContent = errorMessage(err);
+        } finally {
+          session?.destroy();
+          btn.disabled = false;
+        }
+      });
+
+      // ---- Conversation branching ----
+      const branches = [];
+      let active = null;
+      let branchCount = 0;
+      const branchStatus = $('branch-status');
+
+      function renderBranches() {
+        const list = $('branch-list');
+        list.replaceChildren(...branches.map((b) => {
+          const li = document.createElement('li');
+          li.setAttribute('aria-current', String(b === active));
+          const used = b.session.contextUsage;
+          const total = b.session.contextWindow;
+          li.textContent = `${b.name}${b === active ? ' (active)' : ''}: ${used}/${total} tokens (${Math.round((used / total) * 100)}%)`;
+          return li;
+        }));
+      }
+
+      function addBranch(session) {
+        const branch = { name: `Branch ${++branchCount}`, session };
+        session.addEventListener('contextoverflow', () => {
+          branchStatus.textContent = `${branch.name} overflowed its context window; oldest messages were dropped.`;
+        });
+        branches.push(branch);
+        active = branch;
+        // Keep only the newest branches; destroy the rest to free device memory.
+        while (branches.length > MAX_BRANCHES) {
+          const old = branches.shift();
+          old.session.destroy();
+        }
+        renderBranches();
+      }
+
+      async function ensureActive() {
+        if (active) return;
+        addBranch(await createSession(baristaOpts, branchStatus));
+      }
+
+      $('branch-send').addEventListener('click', async () => {
+        const input = $('branch-input');
+        const answer = $('branch-answer');
+        const message = input.value.trim();
+        if (!message) return;
+        const sendBtn = $('branch-send');
+        const cloneBtn = $('clone-btn');
+        sendBtn.disabled = cloneBtn.disabled = true;
+        answer.textContent = '';
+        try {
+          await ensureActive();
+          const branch = active;
+          const measured = await branch.session.measureContextUsage?.(message);
+          if (measured !== undefined) {
+            branchStatus.textContent = `This message uses ~${measured} tokens.`;
+          }
+          for await (const chunk of branch.session.promptStreaming(message)) {
+            answer.append(chunk);
+          }
+          input.value = '';
+          branchStatus.textContent = '';
+          renderBranches();
+        } catch (err) {
+          branchStatus.textContent = errorMessage(err);
+        } finally {
+          sendBtn.disabled = cloneBtn.disabled = false;
+        }
+      });
+
+      $('clone-btn').addEventListener('click', async () => {
+        const btn = $('clone-btn');
+        btn.disabled = true;
+        try {
+          await ensureActive();
+          const clone = await active.session.clone();
+          const parent = active.name;
+          addBranch(clone);
+          branchStatus.textContent = `Cloned ${parent} into ${active.name}. Keeping the newest ${MAX_BRANCHES} branches.`;
+        } catch (err) {
+          branchStatus.textContent = errorMessage(err);
+        } finally {
+          btn.disabled = false;
+        }
+      });
+
+      // ---- Cleanup ----
+      addEventListener('pagehide', () => {
+        Object.values(controllers).forEach((c) => c.abort());
+        Object.values(bases).forEach((s) => s.destroy());
+        branches.splice(0).forEach((b) => b.session.destroy());
+      });
+    })();
+  </script>
+
 </body>
 
