+  <script>
+    (function () {
+      var form = document.getElementById('subscribe-form');
+      var progress = document.getElementById('setup-progress');
+      var progressText = document.getElementById('progress-text');
+      var roast = document.getElementById('roast-level');
+      var roastOutput = document.getElementById('roast-output');
+      var status = document.getElementById('subscribe-status');
+      var roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      var roastTouched = false;
+
+      function update() {
+        roastOutput.textContent = roastNames[roast.value - 1];
+        var done = [
+          form.querySelector('input[name="frequency"]:checked') !== null,
+          roastTouched,
+          form.elements.email_optin.checked
+        ].filter(Boolean).length;
+        var pct = Math.round(done / 3 * 100);
+        progress.value = pct;
+        progress.setAttribute('aria-valuetext', pct + '% complete');
+        progressText.textContent = pct + '%';
+      }
+
+      roast.addEventListener('input', function () { roastTouched = true; });
+      form.addEventListener('input', update);
+      form.addEventListener('change', update);
+      form.addEventListener('submit', function (e) {
+        if (!form.querySelector('input[name="frequency"]:checked')) {
+          e.preventDefault();
+          status.textContent = 'Please choose a delivery frequency.';
+        }
+      });
+      update();
+    })();
+  </script>
+
