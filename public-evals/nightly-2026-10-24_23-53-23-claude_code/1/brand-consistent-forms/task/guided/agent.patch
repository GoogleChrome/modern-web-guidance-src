+  <script>
+    (() => {
+      const form = document.getElementById('subscribe-form');
+      const roast = document.getElementById('roast');
+      const roastOutput = document.getElementById('roast-output');
+      const progress = document.getElementById('setup-progress');
+      const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      const done = { frequency: false, roast: false, email: false };
+
+      function syncRoast() {
+        const name = roastNames[roast.value - 1];
+        roastOutput.value = name;
+        roast.setAttribute('aria-valuetext', name);
+        roast.style.setProperty('--progress', ((roast.value - roast.min) / (roast.max - roast.min)) * 100 + '%');
+      }
+
+      function syncProgress() {
+        const steps = Object.values(done).filter(Boolean).length;
+        progress.value = steps;
+        progress.textContent = steps + ' of 3 steps';
+      }
+
+      form.addEventListener('change', (e) => {
+        if (e.target.name === 'frequency') done.frequency = true;
+        if (e.target.name === 'email_optin') done.email = true;
+        syncProgress();
+      });
+      roast.addEventListener('input', () => {
+        done.roast = true;
+        syncRoast();
+        syncProgress();
+      });
+
+      syncRoast();
+    })();
+  </script>
 </body>
 
