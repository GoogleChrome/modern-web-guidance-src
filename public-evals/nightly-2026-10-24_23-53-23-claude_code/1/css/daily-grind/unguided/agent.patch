diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..78f77e9
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,247 @@
+/*
+ * The Daily Grind
+ *
+ * Architecture:
+ *   1. @layer order  – reset < tokens < base < layout < components < utilities
+ *   2. Tokens        – primitive palette -> semantic roles -> component tokens
+ *   3. Scoping       – components use @scope so selectors stay low-specificity
+ *                      and can't leak outside their root
+ */
+
+@layer reset, tokens, base, layout, components, utilities;
+
+/* ---------------------------------------------------------------- Reset */
+@layer reset {
+  *,
+  *::before,
+  *::after {
+    box-sizing: border-box;
+  }
+
+  * {
+    margin: 0;
+  }
+
+  :where(ul, ol) {
+    padding: 0;
+    list-style: none;
+  }
+
+  :where(img, svg, video) {
+    display: block;
+    max-inline-size: 100%;
+  }
+}
+
+/* --------------------------------------------------------------- Tokens */
+@layer tokens {
+  :root {
+    /* Primitives */
+    --coffee-900: #3e2723;
+    --coffee-700: #4e342e;
+    --latte-200: #d7ccc8;
+    --amber-400: #ffab40;
+    --white: #fff;
+    --off-white: #fafafa;
+    --black: #000;
+
+    /* Semantic roles */
+    --color-primary: var(--coffee-700);
+    --color-primary-strong: var(--coffee-900);
+    --color-secondary: var(--latte-200);
+    --color-accent: var(--amber-400);
+    --color-text: var(--coffee-900);
+    --color-text-inverse: var(--white);
+    --color-surface: var(--white);
+    --color-background: var(--off-white);
+    --color-overlay: oklch(from var(--black) l c h / 0.5);
+    --color-shadow: oklch(from var(--black) l c h / 0.1);
+
+    /* Typography */
+    --font-body: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
+    --text-sm: 0.85rem;
+    --text-base: 0.9rem;
+    --text-md: 1rem;
+    --text-lg: 1.5rem;
+    --text-hero: clamp(2rem, 1.2rem + 4vw, 3rem);
+    --leading: 1.6;
+
+    /* Spacing scale */
+    --space-1: 0.25rem;
+    --space-2: 0.5rem;
+    --space-3: 0.75rem;
+    --space-4: 1rem;
+    --space-5: 1.25rem;
+    --space-6: 2.5rem;
+
+    /* Shape & elevation */
+    --radius-sm: 4px;
+    --radius-md: 5px;
+    --radius-lg: 8px;
+    --shadow-card: 0 2px 5px var(--color-shadow);
+
+    /* Layout */
+    --content-width: 1100px;
+    --gutter: 5%;
+    --z-nav: 1000;
+
+    /* Motion */
+    --transition: 0.3s;
+  }
+}
+
+/* ----------------------------------------------------------------- Base */
+@layer base {
+  body {
+    font-family: var(--font-body);
+    line-height: var(--leading);
+    color: var(--color-text);
+    background-color: var(--color-background);
+  }
+
+  a {
+    color: inherit;
+    text-decoration: none;
+  }
+}
+
+/* --------------------------------------------------------------- Layout */
+@layer layout {
+  .container {
+    max-inline-size: var(--content-width);
+    margin-block: var(--space-6);
+    margin-inline: auto;
+    padding-inline: var(--space-5);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+    gap: var(--space-5);
+    margin-block-start: var(--space-5);
+  }
+}
+
+/* ----------------------------------------------------------- Components */
+@layer components {
+  /* Shared button; also used inside the hero and cards */
+  .btn {
+    --btn-bg: var(--color-primary);
+
+    display: inline-block;
+    background: var(--btn-bg);
+    color: var(--color-text-inverse);
+    padding: 10px 20px;
+    border-radius: var(--radius-md);
+    margin-block-start: 15px;
+    transition: background var(--transition);
+
+    &:hover {
+      --btn-bg: var(--color-primary-strong);
+    }
+  }
+
+  @scope (.site-nav) {
+    :scope {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      inset-block-start: 0;
+      z-index: var(--z-nav);
+      background: var(--color-primary);
+      color: var(--color-text-inverse);
+      padding: var(--space-4) var(--gutter);
+    }
+
+    .logo {
+      font-size: var(--text-lg);
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    ul {
+      display: flex;
+      gap: 20px;
+      align-items: center;
+    }
+
+    a {
+      font-size: var(--text-base);
+      transition: color var(--transition);
+
+      &:hover {
+        color: var(--color-accent);
+      }
+
+      &[href="/logout"] {
+        border: 1px solid var(--color-accent);
+        padding: 5px 12px;
+        border-radius: var(--radius-sm);
+      }
+    }
+  }
+
+  @scope (.hero) {
+    :scope {
+      block-size: 60vh;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      padding-inline: var(--space-5);
+      text-align: center;
+      color: var(--color-text-inverse);
+      background:
+        linear-gradient(var(--color-overlay), var(--color-overlay)),
+        url("https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80")
+          center / cover;
+    }
+
+    h1 {
+      font-size: var(--text-hero);
+      margin-block-end: var(--space-4);
+    }
+  }
+
+  @scope (.card) {
+    :scope {
+      background: var(--color-surface);
+      padding: var(--space-5);
+      border-radius: var(--radius-lg);
+      box-shadow: var(--shadow-card);
+      text-align: center;
+    }
+
+    h3 {
+      margin-block-end: 10px;
+      color: var(--color-primary);
+    }
+  }
+
+  @scope (.site-footer) {
+    :scope {
+      background: var(--color-secondary);
+      text-align: center;
+      padding: var(--space-6) var(--space-5);
+      margin-block-start: var(--space-6);
+    }
+
+    nav {
+      margin-block-end: var(--space-5);
+    }
+
+    a {
+      margin-inline: 10px;
+      font-size: var(--text-sm);
+      color: var(--color-text);
+    }
+  }
+}
+
+/* ------------------------------------------------------------ Utilities */
+@layer utilities {
+  .text-center {
+    text-align: center;
+  }
+}
