index 0000000..0785ed5
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,214 @@
+@layer reset, tokens, base, layout, components;
+
+/* Reset: targeted element types only, no universal selector */
+@layer reset {
+  :where(body, header, nav, main, section, footer, div, ul, li, a, h1, h2, h3, p) {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+  }
+
+  :where(ul) {
+    list-style: none;
+  }
+
+  :where(a) {
+    color: inherit;
+    text-decoration: none;
+  }
+}
+
+/* Design tokens: tier 1 literal -> tier 2 semantic -> tier 3 UI */
+@layer tokens {
+  :root {
+    /* Tier 1: literal values */
+    --brown-900: #3e2723;
+    --brown-700: #4e342e;
+    --brown-100: #d7ccc8;
+    --amber-400: #ffab40;
+    --white: #fff;
+    --gray-50: #fafafa;
+    --black-50: rgb(0 0 0 / 0.5);
+    --black-10: rgb(0 0 0 / 0.1);
+
+    --font-sans: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+
+    --space-xs: 0.3125rem;
+    --space-s: 0.625rem;
+    --space-m: 1.25rem;
+    --space-l: 2.5rem;
+
+    --radius-s: 4px;
+    --radius-m: 5px;
+    --radius-l: 8px;
+
+    --duration-base: 0.3s;
+
+    /* Tier 2: semantic */
+    --color-primary: var(--brown-700);
+    --color-primary-strong: var(--brown-900);
+    --color-secondary: var(--brown-100);
+    --color-accent: var(--amber-400);
+    --color-text: var(--brown-900);
+    --color-text-inverse: var(--white);
+    --color-surface: var(--white);
+    --color-background: var(--gray-50);
+    --color-overlay: var(--black-50);
+
+    /* Tier 3: general UI */
+    --ui-shadow: 0 2px 5px var(--black-10);
+    --ui-content-width: 1100px;
+    --ui-gutter: var(--space-m);
+    --ui-hero-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  }
+}
+
+@layer base {
+  body {
+    font-family: var(--font-sans);
+    line-height: 1.6;
+    color: var(--color-text);
+    background-color: var(--color-background);
+  }
+
+  :where(a) {
+    transition: color var(--duration-base);
+  }
+
+  :where(a):focus-visible {
+    outline: 2px solid var(--color-accent);
+    outline-offset: 2px;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    :where(a, .btn) {
+      transition: none;
+    }
+  }
+}
+
+@layer layout {
+  .container {
+    max-inline-size: var(--ui-content-width);
+    margin-block: var(--space-l);
+    margin-inline: auto;
+    padding-inline: var(--ui-gutter);
+  }
+
+  .section-title {
+    text-align: center;
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+    gap: var(--space-m);
+    margin-block-start: var(--space-m);
+  }
+}
+
+@layer components {
+  .site-nav {
+    background: var(--color-primary);
+    color: var(--color-text-inverse);
+    padding-block: 1rem;
+    padding-inline: 5%;
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    position: sticky;
+    inset-block-start: 0;
+    z-index: 1000;
+
+    .logo {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    ul {
+      display: flex;
+      gap: var(--space-m);
+    }
+
+    a {
+      font-size: 0.9rem;
+
+      &:where(:hover) {
+        color: var(--color-accent);
+      }
+    }
+
+    .logout-link {
+      border: 1px solid var(--color-accent);
+      padding-block: var(--space-xs);
+      padding-inline: 12px;
+      border-radius: var(--radius-s);
+    }
+  }
+
+  .hero {
+    block-size: 60vh;
+    background:
+      linear-gradient(var(--color-overlay), var(--color-overlay)),
+      var(--ui-hero-image) center / cover;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    color: var(--color-text-inverse);
+    text-align: center;
+    padding-inline: var(--ui-gutter);
+
+    h1 {
+      font-size: 3rem;
+      margin-block-end: 1rem;
+    }
+  }
+
+  .card {
+    background: var(--color-surface);
+    padding: var(--space-m);
+    border-radius: var(--radius-l);
+    box-shadow: var(--ui-shadow);
+    text-align: center;
+
+    h3 {
+      margin-block-end: var(--space-s);
+      color: var(--color-primary);
+    }
+  }
+
+  .btn {
+    --btn-bg: var(--color-primary);
+
+    display: inline-block;
+    background: var(--btn-bg);
+    color: var(--color-text-inverse);
+    padding-block: var(--space-s);
+    padding-inline: var(--space-m);
+    border-radius: var(--radius-m);
+    margin-block-start: 15px;
+    transition: background var(--duration-base);
+
+    &:hover {
+      --btn-bg: var(--color-primary-strong);
+    }
+  }
+
+  .site-footer {
+    background: var(--color-secondary);
+    text-align: center;
+    padding: var(--space-l) var(--space-m);
+    margin-block-start: var(--space-l);
+
+    .footer-links {
+      margin-block-end: var(--space-m);
+
+      a {
+        margin-inline: var(--space-s);
+        font-size: 0.85rem;
+      }
+    }
+  }
+}
