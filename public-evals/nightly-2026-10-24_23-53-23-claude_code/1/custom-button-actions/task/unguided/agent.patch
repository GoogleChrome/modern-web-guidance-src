+
+    <section>
+      <h2 style="text-align: center;">Play With the Cup</h2>
+      <div class="actions">
+        <button type="button" commandfor="action-target" command="--spin">Spin</button>
+        <button type="button" commandfor="action-target" command="--grow">Grow</button>
+        <button type="button" commandfor="action-target" command="--round">Make Round</button>
+        <button type="button" commandfor="action-target" command="--reset">Reset All</button>
+      </div>
+      <div id="action-target">&#9749;</div>
+    </section>
   </main>
 
+  <script>
+    const target = document.getElementById('action-target');
+    const toggles = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded'
+    };
+
+    target.addEventListener('command', (event) => {
+      if (event.command in toggles) {
+        target.classList.toggle(toggles[event.command]);
+      } else if (event.command === '--reset') {
+        target.classList.remove(...Object.values(toggles));
+      }
+    });
+  </script>
