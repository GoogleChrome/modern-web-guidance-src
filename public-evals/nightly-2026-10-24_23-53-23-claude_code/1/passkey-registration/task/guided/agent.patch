   </footer>
 
+  <script>
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const statusEl = document.getElementById('passkey-status');
+
+    function setStatus(message) {
+      statusEl.textContent = message;
+    }
+
+    async function postJSON(url, body) {
+      return fetch(url, {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(body),
+      });
+    }
+
+    // Gate the UI on passkey support
+    async function initPasskeyButton() {
+      try {
+        if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+          throw new Error('unsupported');
+        }
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!capabilities.passkeyPlatformAuthenticator || !capabilities.conditionalGet) {
+          throw new Error('unsupported');
+        }
+        registerButton.disabled = false;
+      } catch {
+        registerButton.disabled = true;
+        setStatus('Passkeys are not available on this device.');
+      }
+    }
+
+    async function registerPasskey() {
+      registerButton.disabled = true;
+      setStatus('');
+
+      let creationOptionsJSON;
+      try {
+        const optionsResponse = await postJSON('/api/register/options', { promotion: true });
+        if (!optionsResponse.ok) throw new Error('options request failed');
+        creationOptionsJSON = await optionsResponse.json();
+      } catch (err) {
+        console.error('Failed to fetch passkey options:', err);
+        setStatus('Could not start passkey creation. Please try again.');
+        registerButton.disabled = false;
+        return;
+      }
+
+      let credential;
+      try {
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+        credential = await navigator.credentials.create({ publicKey });
+      } catch (err) {
+        if (err.name === 'InvalidStateError') {
+          setStatus('A passkey already exists for this account.');
+        } else if (err.name === 'SecurityError') {
+          console.error('RP ID mismatch or insecure context:', err);
+          setStatus('Passkeys cannot be created in this context.');
+        } else if (err.name === 'NotAllowedError') {
+          setStatus('Passkey creation was cancelled.');
+        } else if (err.name === 'AbortError') {
+          setStatus('Passkey creation was aborted.');
+        } else {
+          console.error('Passkey creation failed:', err);
+          setStatus('Passkey creation failed. Please try again.');
+        }
+        registerButton.disabled = false;
+        return;
+      }
+
+      const encodedResponse = credential.toJSON();
+      let verified = false;
+      try {
+        const verifyResponse = await postJSON('/api/register/verify', encodedResponse);
+        verified = verifyResponse.ok;
+      } catch (err) {
+        console.error('Passkey verification network failure:', err);
+      }
+
+      if (verified) {
+        setStatus('Passkey created successfully!');
+        return;
+      }
+
+      // Tell the passkey provider to remove the orphaned credential
+      if (PublicKeyCredential.signalUnknownCredential) {
+        try {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: creationOptionsJSON.rp.id,
+            credentialId: encodedResponse.id,
+          });
+        } catch (err) {
+          console.error('signalUnknownCredential failed:', err);
+        }
+      }
+      setStatus('Passkey registration could not be verified. Please try again.');
+      registerButton.disabled = false;
+    }
+
+    registerButton.addEventListener('click', registerPasskey);
+    initPasskeyButton();
+  </script>
 </body>
 
