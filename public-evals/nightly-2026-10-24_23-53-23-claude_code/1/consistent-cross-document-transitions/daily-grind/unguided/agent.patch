+  <!-- Synchronous (render-blocking) script: runs after the styles above are applied
+       and before the first paint, so the transition only starts from a stable state. -->
+  <script>
+    document.documentElement.classList.add('js');
+    window.addEventListener('pagereveal', async (e) => {
+      if (!e.viewTransition) return;
+      // Skip the animation if the user opted out of motion.
+      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        e.viewTransition.skipTransition();
+        return;
+      }
+      // Don't let a slow font/stylesheet race the transition: wait for fonts to settle.
+      try { await document.fonts.ready; } catch (_) {}
+    });
