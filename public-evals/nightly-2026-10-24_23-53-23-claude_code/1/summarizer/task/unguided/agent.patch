+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const summaryEl = document.getElementById('summary');
+    const journalText = document.getElementById('journal-text');
+
+    function showStatus(message) {
+      summaryEl.hidden = false;
+      summaryEl.replaceChildren();
+      const p = document.createElement('p');
+      p.className = 'summary-status';
+      p.textContent = message;
+      summaryEl.append(p);
+    }
+
+    // Render markdown-style bullets ("* point" / "- point") as a <ul>, using textContent only.
+    function renderBullets(markdown) {
+      const points = markdown
+        .split('\n')
+        .map(line => line.replace(/^\s*[-*•]\s+/, '').trim())
+        .filter(Boolean);
+      const ul = document.createElement('ul');
+      for (const point of points) {
+        const li = document.createElement('li');
+        li.textContent = point;
+        ul.append(li);
+      }
+      summaryEl.replaceChildren(ul);
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      if (!('Summarizer' in self)) {
+        showStatus("Your browser doesn't support built-in AI summarization. Try a recent version of Chrome on desktop.");
+        return;
+      }
+
+      summarizeBtn.disabled = true;
+      try {
+        const availability = await Summarizer.availability();
+        if (availability === 'unavailable') {
+          showStatus("Built-in AI summarization isn't available on this device.");
+          return;
+        }
+
+        showStatus(availability === 'available' ? 'Summarizing…' : 'Downloading the on-device AI model…');
+        const summarizer = await Summarizer.create({
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          sharedContext: 'A coffee roaster describing how it sources its beans.',
+          monitor(m) {
+            m.addEventListener('downloadprogress', e => {
+              showStatus(`Downloading the on-device AI model… ${Math.round(e.loaded * 100)}%`);
+            });
+          },
+        });
+
+        showStatus('Summarizing…');
+        const result = await summarizer.summarize(journalText.innerText);
+        summarizer.destroy();
+        renderBullets(result);
+      } catch (err) {
+        console.error(err);
+        showStatus('Sorry, something went wrong while summarizing.');
+      } finally {
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
