+  <script>
+    (() => {
+      const btn = document.getElementById('summarize-btn');
+      const status = document.getElementById('summarize-status');
+      const list = document.getElementById('summary-list');
+      const source = document.getElementById('journal-text');
+      const options = {
+        sharedContext: 'A coffee roaster describing how it sources green coffee beans.',
+        type: 'key-points',
+        format: 'markdown',
+        length: 'medium',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+      };
+
+      if (!('Summarizer' in self)) {
+        status.textContent = 'Summarizing is unavailable: this browser has no built-in AI summarizer.';
+        return;
+      }
+
+      let summarizer;
+
+      async function init() {
+        const availability = await Summarizer.availability(options);
+        if (availability === 'unavailable') {
+          status.textContent = 'Summarizing is unavailable on this device.';
+          return;
+        }
+        btn.hidden = false;
+        if (availability !== 'available') {
+          status.textContent = 'The first summary will download a small on-device AI model.';
+        }
+      }
+
+      function render(markdown) {
+        list.replaceChildren();
+        for (const line of markdown.split('\n')) {
+          const text = line.replace(/^\s*[-*•]\s+/, '').replace(/\*\*|__/g, '').trim();
+          if (!text) continue;
+          const li = document.createElement('li');
+          li.textContent = text;
+          list.append(li);
+        }
+        list.hidden = !list.children.length;
+      }
+
+      btn.addEventListener('click', async () => {
+        btn.disabled = true;
+        list.hidden = true;
+        try {
+          // create() needs the click's user activation if the model must be downloaded
+          summarizer ??= await Summarizer.create({
+            ...options,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                status.textContent = `Downloading AI model… ${Math.round((e.loaded / e.total) * 100)}%`;
+              });
+            },
+          });
+          status.textContent = 'Summarizing…';
+          render(await summarizer.summarize(source.innerText));
+          status.textContent = '';
+        } catch (err) {
+          console.error(err);
+          status.textContent = 'Sorry, the summary could not be generated.';
+        } finally {
+          btn.disabled = false;
+        }
+      });
+
+      init().catch((err) => {
+        console.error(err);
+        status.textContent = 'Summarizing is unavailable on this device.';
+      });
+    })();
+  </script>
