+  <script>
+    (function () {
+      const PRIORITIES = { URGENT: 0, STANDARD: 1, BACKGROUND: 2 };
+      const KINDS = {
+        checkout: { label: 'Checkout order', priority: PRIORITIES.URGENT, steps: 20 },
+        menu: { label: 'Menu update', priority: PRIORITIES.STANDARD, steps: 60 },
+        telemetry: { label: 'Telemetry flush', priority: PRIORITIES.BACKGROUND, steps: 120 }
+      };
+      const SLICE_MS = 8;      // max time spent on the main thread before yielding
+      const STEP_WORK = 40000; // busy-loop iterations per step (simulated CPU work)
+
+      const queue = [];        // pending/running tasks, kept sorted by priority then arrival
+      const counters = { checkout: 0, menu: 0, telemetry: 0 };
+      let nextId = 0;
+      let completed = 0;
+      let running = false;
+
+      const $ = (id) => document.getElementById(id);
+      const lanes = [$('ops-lane-0'), $('ops-lane-1'), $('ops-lane-2')];
+      const logEl = $('ops-log');
+
+      function log(msg) {
+        const li = document.createElement('li');
+        li.textContent = new Date().toLocaleTimeString() + '  ' + msg;
+        logEl.prepend(li);
+        while (logEl.children.length > 100) logEl.lastChild.remove();
+      }
+
+      function enqueue(kind) {
+        const def = KINDS[kind];
+        const n = ++counters[kind];
+        const el = document.createElement('li');
+        el.className = 'ops-task';
+        el.dataset.priority = def.priority;
+        el.innerHTML = '<span></span><div class="ops-bar"><span></span></div>';
+        const task = {
+          id: ++nextId,
+          name: def.label + ' #' + n,
+          priority: def.priority,
+          steps: def.steps,
+          done: 0,
+          el,
+          bar: el.querySelector('.ops-bar > span'),
+          text: el.firstElementChild
+        };
+        task.text.textContent = task.name + ' – queued';
+        lanes[task.priority].append(el);
+
+        // Insert after the last task with the same or higher priority (stable ordering)
+        let i = queue.length;
+        while (i > 0 && queue[i - 1].priority > task.priority) i--;
+        queue.splice(i, 0, task);
+        log('Queued ' + task.name);
+      }
+
+      function burn() {
+        let x = 0;
+        for (let i = 0; i < STEP_WORK; i++) x += Math.sqrt(i);
+        return x;
+      }
+
+      // Yield to the event loop so input and rendering can happen
+      function yieldToMain() {
+        if (window.scheduler && scheduler.yield) return scheduler.yield();
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      function setState() {
+        $('ops-spinner').classList.toggle('active', running);
+        $('ops-state').textContent = running
+          ? 'Processing – ' + queue.length + ' pending'
+          : 'Idle';
+        $('ops-count').textContent = completed;
+      }
+
+      async function pump() {
+        if (running) return;
+        running = true;
+        setState();
+        while (queue.length) {
+          const sliceEnd = performance.now() + SLICE_MS;
+          // Always re-read the head: a newly queued urgent task preempts between slices
+          const task = queue[0];
+          if (task.done === 0) {
+            task.text.textContent = task.name + ' – running';
+            log('Started ' + task.name);
+          }
+          while (task.done < task.steps && performance.now() < sliceEnd) {
+            burn();
+            task.done++;
+          }
+          task.bar.style.width = (task.done / task.steps * 100) + '%';
+          if (task.done >= task.steps) {
+            queue.shift();
+            completed++;
+            task.el.classList.add('done');
+            task.text.textContent = task.name + ' – done';
+            log('Finished ' + task.name);
+            setState();
+          }
+          await yieldToMain();
+        }
+        running = false;
+        setState();
+      }
+
+      // Shows how long the main thread was blocked at worst; stays small when slicing works
+      let lastFrame = performance.now();
+      let maxGap = 0;
+      function heartbeat(now) {
+        if (running) maxGap = Math.max(maxGap, now - lastFrame);
+        else if (maxGap) { $('ops-heartbeat').textContent = Math.round(maxGap) + ' ms'; maxGap = 0; }
+        lastFrame = now;
+        requestAnimationFrame(heartbeat);
+      }
+      requestAnimationFrame(heartbeat);
+
+      document.querySelector('.ops-controls').addEventListener('click', (e) => {
+        const btn = e.target.closest('button');
+        if (!btn) return;
+        const kind = btn.dataset.kind;
+        if (kind === 'clear') {
+          lanes.forEach((lane) => lane.querySelectorAll('.done').forEach((el) => el.remove()));
+          return;
+        }
+        if (kind === 'batch') {
+          // Deliberately submitted out of order; the queue sorts by priority
+          ['telemetry', 'menu', 'telemetry', 'checkout', 'menu', 'checkout'].forEach(enqueue);
+        } else {
+          enqueue(kind);
+        }
+        pump();
+      });
+    })();
+  </script>
