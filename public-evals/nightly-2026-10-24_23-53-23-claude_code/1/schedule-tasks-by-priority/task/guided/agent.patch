+  <script>
+    (() => {
+      // Lower number = higher priority.
+      const TASK_TYPES = {
+        urgent: { label: 'Urgent checkout', rank: 0, units: 60 },
+        standard: { label: 'Menu update', rank: 1, units: 200 },
+        background: { label: 'Telemetry logging', rank: 2, units: 400 }
+      };
+      const BUDGET_MS = 50; // longer than this counts as a long task
+      const UNIT_COST_MS = 1; // simulated blocking work per unit
+
+      const $ = (id) => document.getElementById(id);
+      const queueEl = $('ops-queue');
+      const logEl = $('ops-log');
+      const pendingEl = $('ops-pending');
+      const completedEl = $('ops-completed');
+
+      const pending = [];
+      let completed = 0;
+      let nextId = 1;
+      let running = false;
+
+      // Heartbeat proves the main thread is still free to run timers.
+      let ticks = 0;
+      setInterval(() => { $('ops-ticks').textContent = ++ticks; }, 100);
+
+      function yieldToMain() {
+        if ('scheduler' in window && 'yield' in window.scheduler) {
+          return scheduler.yield();
+        }
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      function busyWork(ms) {
+        const end = performance.now() + ms;
+        while (performance.now() < end);
+      }
+
+      // Highest priority first, then first-in-first-out.
+      function pickNext() {
+        let best = null;
+        for (const task of pending) {
+          if (!best || task.rank < best.rank) best = task;
+        }
+        return best;
+      }
+
+      function enqueue(type) {
+        const def = TASK_TYPES[type];
+        pending.push({ id: nextId++, type, rank: def.rank, label: def.label, total: def.units, done: 0 });
+        renderQueue();
+      }
+
+      function renderQueue() {
+        pendingEl.textContent = pending.length;
+        queueEl.replaceChildren();
+        if (!pending.length) {
+          queueEl.innerHTML = '<li>Queue is empty.</li>';
+          return;
+        }
+        const ordered = [...pending].sort((a, b) => a.rank - b.rank || a.id - b.id);
+        for (const task of ordered) {
+          const li = document.createElement('li');
+          const tag = document.createElement('span');
+          tag.className = `tag ${task.type}`;
+          tag.textContent = task.type;
+          const progress = document.createElement('progress');
+          progress.max = task.total;
+          progress.value = task.done;
+          progress.setAttribute('aria-label', `${task.label} #${task.id} progress`);
+          li.append(tag, `${task.label} #${task.id}`, progress);
+          queueEl.append(li);
+        }
+      }
+
+      function logDone(task) {
+        if (!completed) logEl.replaceChildren();
+        completedEl.textContent = ++completed;
+        const li = document.createElement('li');
+        const tag = document.createElement('span');
+        tag.className = `tag ${task.type}`;
+        tag.textContent = task.type;
+        li.append(tag, `${task.label} #${task.id} finished`);
+        logEl.prepend(li);
+      }
+
+      async function run() {
+        if (running) return;
+        running = true;
+        let deadline = performance.now() + BUDGET_MS;
+        let task;
+        // Re-pick after every unit so newly added urgent work preempts running work.
+        while ((task = pickNext())) {
+          busyWork(UNIT_COST_MS);
+          task.done++;
+          if (task.done >= task.total) {
+            pending.splice(pending.indexOf(task), 1);
+            logDone(task);
+          }
+          if (performance.now() >= deadline) {
+            renderQueue();
+            await yieldToMain();
+            deadline = performance.now() + BUDGET_MS;
+          }
+        }
+        renderQueue();
+        running = false;
+      }
+
+      document.querySelector('.ops-controls').addEventListener('click', (event) => {
+        const button = event.target.closest('button[data-task]');
+        if (!button) return;
+        const type = button.dataset.task;
+        if (type === 'batch') {
+          // Deliberately enqueued out of order; the scheduler sorts by priority.
+          ['background', 'standard', 'urgent', 'background', 'urgent', 'standard'].forEach(enqueue);
+        } else {
+          enqueue(type);
+        }
+        run();
+      });
+    })();
+  </script>
+
 </body>
 
