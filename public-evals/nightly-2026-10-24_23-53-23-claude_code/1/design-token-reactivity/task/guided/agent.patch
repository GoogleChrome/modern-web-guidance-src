+    /* Layout density toggle: only shown where container style queries work */
+    :root {
+      --style-queries-supported: check;
+    }
+
+    #toggle-spacious {
+      display: none;
+      margin: 10px auto 0;
+      padding: 8px 16px;
+      border: 1px solid var(--primary);
+      border-radius: 5px;
+      background: white;
+      color: var(--primary);
+      font: inherit;
+      cursor: pointer;
+    }
+
+    #toggle-spacious[aria-pressed="true"] {
+      background: var(--primary);
+      color: white;
+    }
+
+    @container style(--style-queries-supported) {
+      #toggle-spacious {
+        display: block;
+      }
+    }
+
+    #target-item {
+      transition: padding 0.3s;
+    }
+
+    /* The card reacts to its ancestor's --density without JS styling it */
+    @container style(--density: spacious) {
+      #target-item {
+        padding: 44px 32px;
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
