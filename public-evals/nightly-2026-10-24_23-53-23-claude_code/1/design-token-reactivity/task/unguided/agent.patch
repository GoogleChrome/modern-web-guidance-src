+    /* Layout density: set on #target-container by JS, inherited by descendants */
+    :root {
+      --density: compact;
+    }
+
+    #target-item {
+      transition: padding 0.3s;
+    }
+
+    /* Toggle is hidden unless the browser supports style queries */
+    #toggle-spacious {
+      display: none;
+      margin: 10px auto 0;
+      padding: 8px 16px;
+      border: 1px solid var(--primary);
+      border-radius: 5px;
+      background: white;
+      color: var(--primary);
+      font: inherit;
+      cursor: pointer;
+    }
+
+    @container style(--density: compact) {
+      #toggle-spacious {
+        display: block;
+      }
+    }
+
+    @container style(--density: spacious) {
+      #target-item {
+        padding: 40px;
+      }
+    }
