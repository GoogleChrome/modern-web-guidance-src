       margin-bottom: 10px;
       color: var(--primary);
     }
 
+
+    /* Spotlight reveal for product cards */
+    @property --inner-size { syntax: '<length>'; inherits: true; initial-value: 0px; }
+    @property --outer-size { syntax: '<length>'; inherits: true; initial-value: 0px; }
+    @property --mouse-x { syntax: '<length>'; inherits: true; initial-value: 50%; }
+    @property --mouse-y { syntax: '<length>'; inherits: true; initial-value: 50%; }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      overflow: hidden;
+      transition: --inner-size 0.4s ease, --outer-size 0.4s ease;
+    }
+
+    .product-card:hover {
+      --inner-size: 70px;
+      --outer-size: 130px;
+    }
+
+    .product-card .spotlight {
+      position: absolute;
+      inset: 0;
+      z-index: 1;
+      pointer-events: none;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      gap: 8px;
+      padding: 20px;
+      background: var(--primary);
+      color: white;
+      font-size: 0.9rem;
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), #000 var(--inner-size), transparent var(--outer-size));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y), #000 var(--inner-size), transparent var(--outer-size));
+    }
+
+    .product-card .spotlight strong {
+      text-transform: uppercase;
+      letter-spacing: 0.08em;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
