+  <script>
+    const ITEMS = [
+      {
+        slug: 'maple-oat-latte',
+        title: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        img: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80'
+      },
+      {
+        slug: 'dark-roast-espresso',
+        title: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        img: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=1350&q=80'
+      },
+      {
+        slug: 'cold-brew',
+        title: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1350&q=80'
+      }
+    ];
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const hero = document.getElementById('hero');
+    const detailTitle = document.getElementById('title');
+    const grid = document.getElementById('grid');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    // Build the thumbnails
+    ITEMS.forEach(item => {
+      const a = document.createElement('a');
+      a.className = 'thumbnail';
+      a.href = '#/item/' + item.slug;
+      a.dataset.slug = item.slug;
+      a.style.setProperty('--img', `url('${item.img}')`);
+      const h2 = document.createElement('h2');
+      h2.className = 'title';
+      h2.textContent = item.title;
+      a.append(h2);
+      grid.append(a);
+    });
+
+    const thumbFor = slug => grid.querySelector(`.thumbnail[data-slug="${slug}"]`);
+
+    // view-transition-name is only set on the elements taking part in a transition
+    function nameElements(box, text) {
+      box.style.viewTransitionName = 'card-hero';
+      text.style.viewTransitionName = 'card-title';
+    }
+
+    function clearNames() {
+      document.querySelectorAll('[style*="view-transition-name"]').forEach(el => {
+        el.style.removeProperty('view-transition-name');
+      });
+    }
+
+    function parseRoute() {
+      const m = location.hash.match(/^#\/item\/([\w-]+)$/);
+      const item = m && ITEMS.find(i => i.slug === m[1]);
+      return item ? { item } : { item: null };
+    }
+
+    let current = { item: null };
+    let listScroll = 0;
+
+    function showList() {
+      detailPage.hidden = true;
+      listPage.hidden = false;
+      window.scrollTo(0, listScroll);
+    }
+
+    function showDetail(item) {
+      if (!current.item) listScroll = window.scrollY;
+      detailTitle.textContent = item.title;
+      detailPage.querySelector('.description').textContent = item.description;
+      hero.style.setProperty('--img', `url('${item.img}')`);
+      listPage.hidden = true;
+      detailPage.hidden = false;
+      window.scrollTo(0, 0);
+    }
+
+    function focusHeading(item) {
+      (item ? detailTitle : listHeading).focus({ preventScroll: true });
+    }
+
+    function render() {
+      const next = parseRoute();
+      const prev = current;
+      if (next.item === prev.item) return;
+
+      const apply = () => {
+        clearNames();
+        if (next.item) {
+          showDetail(next.item);
+          nameElements(hero, detailTitle);
+        } else {
+          showList();
+          const thumb = prev.item && thumbFor(prev.item.slug);
+          if (thumb) nameElements(thumb, thumb.querySelector('.title'));
+        }
+        current = next;
+      };
+
+      // Only morph between list and a visible thumbnail
+      const sourceThumb = next.item && thumbFor(next.item.slug);
+      const animate = document.startViewTransition && !reducedMotion.matches &&
+        (next.item ? sourceThumb : prev.item);
+
+      if (!animate) {
+        apply();
+        clearNames();
+        focusHeading(next.item);
+        return;
+      }
+
+      if (next.item) {
+        nameElements(sourceThumb, sourceThumb.querySelector('.title'));
+      } else {
+        nameElements(hero, detailTitle);
+      }
+
+      const transition = document.startViewTransition(apply);
+      transition.updateCallbackDone.then(() => focusHeading(next.item));
+      transition.finished.finally(clearNames);
+    }
+
+    window.addEventListener('hashchange', render);
+    render();
+  </script>
+
 </body>
 
