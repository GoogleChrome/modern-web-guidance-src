+  <script>
+    const items = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        image: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80'
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        image: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=1350&q=80'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=1350&q=80'
+      }
+    };
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const description = document.getElementById('description');
+    const listHeading = document.getElementById('list-heading');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    document.querySelectorAll('.thumbnail').forEach((thumb) => {
+      thumb.style.setProperty('--image', `url("${items[thumb.dataset.id].image}")`);
+    });
+
+    // Synchronous DOM update for the given item id (or null for the list view)
+    function render(id) {
+      const item = items[id];
+      if (item) {
+        hero.style.setProperty('--image', `url("${item.image}")`);
+        hero.setAttribute('aria-label', item.title);
+        title.textContent = item.title;
+        description.textContent = item.description;
+        document.title = `${item.title} | The Daily Grind`;
+      } else {
+        document.title = 'The Daily Grind | Artisanal Coffee';
+      }
+      listPage.hidden = !!item;
+      detailPage.hidden = !item;
+    }
+
+    function focusHeading(id) {
+      (items[id] ? title : listHeading).focus({ preventScroll: false });
+    }
+
+    function clearTransitionState() {
+      document.querySelectorAll('.thumbnail.selected').forEach((el) => el.classList.remove('selected'));
+    }
+
+    // Moves between views, morphing the thumbnail and its title when supported
+    function show(id, thumb) {
+      const target = thumb || document.querySelector(`.thumbnail[data-id="${id || currentId}"]`);
+      const animate = document.startViewTransition && !reducedMotion.matches;
+
+      if (!animate) {
+        render(id);
+        window.scrollTo(0, 0);
+        focusHeading(id);
+        currentId = id;
+        return;
+      }
+
+      // The thumbnail must carry the shared names in both the old and new states
+      target?.classList.add('selected');
+      const transition = document.startViewTransition(() => {
+        render(id);
+        window.scrollTo(0, 0);
+        // Scrolling the list back to the thumbnail keeps the morph target on screen
+        if (!id) target?.scrollIntoView({ block: 'center' });
+      });
+      currentId = id;
+      transition.finished.finally(() => {
+        clearTransitionState();
+        focusHeading(id);
+      });
+    }
+
+    let currentId = null;
+
+    function route() {
+      const id = location.hash.slice(1);
+      return items[id] ? id : null;
+    }
+
+    document.querySelector('.grid').addEventListener('click', (e) => {
+      const thumb = e.target.closest('.thumbnail');
+      if (!thumb || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
+      e.preventDefault();
+      history.pushState(null, '', `#${thumb.dataset.id}`);
+      show(thumb.dataset.id, thumb);
+    });
+
+    document.getElementById('back').addEventListener('click', (e) => {
+      e.preventDefault();
+      history.pushState(null, '', location.pathname + location.search);
+      show(null);
+    });
+
+    // Browser back/forward
+    window.addEventListener('popstate', () => {
+      const id = route();
+      if (id !== currentId) show(id);
+    });
+
+    // Initial state (deep link) without animation
+    currentId = route();
+    render(currentId);
+  </script>
+
 </body>
 
