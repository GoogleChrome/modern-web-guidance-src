@@ -119,8 +119,44 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Seasonal cards restyle themselves when their "Make it iced" checkbox is checked */
+    .seasonal-card {
+      --card-bg: white;
+      --card-text: var(--text);
+      --card-heading: var(--primary);
+      --card-border: transparent;
+
+      background: var(--card-bg);
+      color: var(--card-text);
+      border: 2px solid var(--card-border);
+      transition: background-color 0.3s, color 0.3s, border-color 0.3s;
+    }
+
+    .seasonal-card h3 {
+      color: var(--card-heading);
+    }
+
+    .seasonal-card:has(.iced-toggle:checked) {
+      --card-bg: #e3f2fd;
+      --card-text: #0d3b66;
+      --card-heading: #0d47a1;
+      --card-border: #64b5f6;
+    }
+
+    .iced-option {
+      display: inline-flex;
+      align-items: center;
+      gap: 8px;
+      margin-bottom: 12px;
+      cursor: pointer;
+    }
+
+    .iced-option input {
+      accent-color: #1e88e5;
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
