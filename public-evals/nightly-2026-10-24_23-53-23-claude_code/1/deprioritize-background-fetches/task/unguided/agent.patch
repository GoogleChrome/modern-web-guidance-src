diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,34 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Fetch</title>
+</head>
+<body>
+<button id="btn">Load</button>
+<pre id="out"></pre>
+<script>
+document.getElementById('btn').addEventListener('click', async () => {
+  // Critical request goes first and is marked high priority.
+  const data = fetch('/api/data', { priority: 'high' }).then(r => r.json());
+
+  // Analytics is non-critical: low priority so it doesn't compete for bandwidth,
+  // keepalive so it survives navigation. Failures are ignored.
+  fetch('/api/analytics', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ click: 1 }),
+    priority: 'low',
+    keepalive: true
+  }).catch(() => {});
+
+  try {
+    document.getElementById('out').textContent = JSON.stringify(await data, null, 2);
+  } catch (e) {
+    document.getElementById('out').textContent = 'Error: ' + e.message;
+  }
+});
+</script>
+</body>
+</html>
