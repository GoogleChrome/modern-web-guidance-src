+  <script type="module">
+    // Native Temporal where available; otherwise load the polyfill on demand.
+    if (typeof Temporal === 'undefined') {
+      try {
+        const mod = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = mod.Temporal;
+      } catch {
+        // handled below via status message
+      }
+    }
+
+    const CALENDARS = [
+      { id: 'islamic-umalqura', title: 'Islamic (Umm al-Qura)', formattedId: 'islamic-date' },
+      { id: 'hebrew', title: 'Hebrew' },
+      { id: 'japanese', title: 'Japanese' },
+    ];
+
+    const input = document.getElementById('calendar-date-input');
+    const results = document.getElementById('calendar-results');
+    const status = document.getElementById('calendar-status');
+
+    function isCalendarSupported(id) {
+      try {
+        if (Intl.supportedValuesOf('calendar').includes(id)) return true;
+      } catch {
+        // supportedValuesOf unavailable; probe with DateTimeFormat below
+      }
+      try {
+        return new Intl.DateTimeFormat('en-u-ca-' + id).resolvedOptions().calendar === id;
+      } catch {
+        return false;
+      }
+    }
+
+    function makeEl(tag, text, className) {
+      const el = document.createElement(tag);
+      if (text !== undefined) el.textContent = text;
+      if (className) el.className = className;
+      return el;
+    }
+
+    function localeFor(calendarId) {
+      const base = navigator.language || 'en';
+      try {
+        return new Intl.Locale(base, { calendar: calendarId }).toString();
+      } catch {
+        return 'en-u-ca-' + calendarId;
+      }
+    }
+
+    function timelineLabel(isoDate, calendarId) {
+      const today = Temporal.Now.plainDateISO().withCalendar(calendarId);
+      const cmp = Temporal.PlainDate.compare(isoDate.withCalendar(calendarId), today);
+      return cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+    }
+
+    function renderCard(cal, isoDate) {
+      const card = makeEl('div', undefined, 'card calendar-card');
+      card.append(makeEl('h3', cal.title));
+
+      if (!isCalendarSupported(cal.id)) {
+        card.append(makeEl('p', 'This calendar is not supported by your browser.'));
+        return card;
+      }
+
+      try {
+        const date = isoDate.withCalendar(cal.id);
+        const formatted = date.toLocaleString(localeFor(cal.id), {
+          weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', era: 'long',
+        });
+        const formattedEl = makeEl('p', formatted, 'formatted-date');
+        if (cal.formattedId) formattedEl.id = cal.formattedId;
+        card.append(formattedEl);
+
+        const yearText = date.era
+          ? `${date.eraYear} (${date.era}; year ${date.year})`
+          : String(date.year);
+        const details = makeEl('dl');
+        const rows = [
+          ['Year', yearText],
+          ['Month', String(date.month)],
+          ['Month code', date.monthCode],
+          ['Months in year', String(date.monthsInYear)],
+          ['Timeline', timelineLabel(isoDate, cal.id)],
+        ];
+        for (const [k, v] of rows) {
+          details.append(makeEl('dt', k), makeEl('dd', v));
+        }
+        card.append(details);
+
+        card.append(makeEl('h4', 'Months'));
+        const list = makeEl('ul');
+        for (let m = 1; m <= date.monthsInYear; m++) {
+          const first = date.with({ month: m, day: 1 });
+          const li = makeEl('li', `${first.monthCode}: ${first.daysInMonth} days`);
+          if (m === date.month) li.className = 'current-month';
+          list.append(li);
+        }
+        card.append(list);
+      } catch {
+        card.append(makeEl('p', 'This date is outside the supported range for this calendar.'));
+      }
+      return card;
+    }
+
+    function update() {
+      results.replaceChildren();
+      status.textContent = '';
+      if (typeof Temporal === 'undefined') {
+        status.textContent = 'Calendar conversion is unavailable in this browser.';
+        return;
+      }
+      if (!input.value) {
+        status.textContent = 'Please choose a valid date.';
+        return;
+      }
+      let isoDate;
+      try {
+        isoDate = Temporal.PlainDate.from(input.value);
+      } catch {
+        status.textContent = 'Please choose a valid date.';
+        return;
+      }
+      results.append(...CALENDARS.map((cal) => renderCard(cal, isoDate)));
+    }
+
+    input.addEventListener('input', update);
+    if (typeof Temporal !== 'undefined') {
+      input.value = Temporal.Now.plainDateISO().toString();
+    }
+    update();
+  </script>
 </body>
 
 </html>
