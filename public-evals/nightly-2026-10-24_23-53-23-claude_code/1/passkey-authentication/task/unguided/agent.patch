+  <script>
+    (() => {
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const statusEl = document.querySelector('[data-testid="auth-status"]');
+      let abortController = null;
+
+      const setStatus = (msg, isError = false) => {
+        statusEl.textContent = msg;
+        statusEl.classList.toggle('error', isError);
+      };
+
+      const b64urlToBuffer = (str) => {
+        const b64 = str.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(str.length / 4) * 4, '=');
+        return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)).buffer;
+      };
+
+      const bufferToB64url = (buf) => {
+        let bin = '';
+        new Uint8Array(buf).forEach((b) => { bin += String.fromCharCode(b); });
+        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      };
+
+      const fetchOptions = async (username) => {
+        const res = await fetch('/api/login/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(username ? { username } : {}),
+        });
+        if (!res.ok) throw new Error('Could not start sign-in');
+        const options = await res.json();
+        options.challenge = b64urlToBuffer(options.challenge);
+        (options.allowCredentials || []).forEach((c) => { c.id = b64urlToBuffer(c.id); });
+        return options;
+      };
+
+      const serialize = (cred) => ({
+        id: cred.id,
+        rawId: bufferToB64url(cred.rawId),
+        type: cred.type,
+        authenticatorAttachment: cred.authenticatorAttachment,
+        clientExtensionResults: cred.getClientExtensionResults(),
+        response: {
+          clientDataJSON: bufferToB64url(cred.response.clientDataJSON),
+          authenticatorData: bufferToB64url(cred.response.authenticatorData),
+          signature: bufferToB64url(cred.response.signature),
+          userHandle: cred.response.userHandle ? bufferToB64url(cred.response.userHandle) : null,
+        },
+      });
+
+      const verify = async (cred) => {
+        const res = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(serialize(cred)),
+        });
+        if (!res.ok) throw new Error('Passkey verification failed');
+        return res.json().catch(() => ({}));
+      };
+
+      // mediation 'conditional' => autofill UI; otherwise a modal biometric prompt.
+      const authenticate = async (mediation) => {
+        if (abortController) abortController.abort();
+        abortController = new AbortController();
+        const options = await fetchOptions(mediation === 'conditional' ? '' : usernameField.value.trim());
+        const cred = await navigator.credentials.get({
+          publicKey: options,
+          mediation,
+          signal: abortController.signal,
+        });
+        return verify(cred);
+      };
+
+      const onSuccess = (result) => {
+        const name = result && (result.username || result.user);
+        setStatus(name ? `Signed in as ${name}` : 'Signed in successfully');
+      };
+
+      const onError = (err) => {
+        if (err.name === 'AbortError') return;
+        setStatus(err.name === 'NotAllowedError' ? 'Sign-in was cancelled.' : err.message, true);
+      };
+
+      authButton.addEventListener('click', async () => {
+        if (!window.PublicKeyCredential) {
+          setStatus('Passkeys are not supported in this browser.', true);
+          return;
+        }
+        setStatus('Waiting for passkey…');
+        try {
+          onSuccess(await authenticate('optional'));
+        } catch (err) {
+          onError(err);
+        }
+      });
+
+      const startAutofill = async () => {
+        if (!window.PublicKeyCredential || !PublicKeyCredential.isConditionalMediationAvailable) return;
+        if (!(await PublicKeyCredential.isConditionalMediationAvailable())) return;
+        try {
+          onSuccess(await authenticate('conditional'));
+        } catch (err) {
+          onError(err);
+        }
+      };
+
+      startAutofill();
+    })();
+  </script>
+
 </body>
 
