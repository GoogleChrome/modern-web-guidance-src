+  <script>
+    const dialog = document.getElementById('logout-dialog');
+
+    function closeDialog() {
+      if (!dialog.open || dialog.classList.contains('closing')) return;
+      dialog.classList.add('closing');
+      dialog.addEventListener('animationend', () => {
+        dialog.classList.remove('closing');
+        dialog.close();
+      }, { once: true });
+    }
+
+    document.getElementById('open-dialog-btn').addEventListener('click', (e) => {
+      e.preventDefault();
+      dialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+    // Animate Escape and backdrop clicks instead of closing instantly
+    dialog.addEventListener('cancel', (e) => {
+      e.preventDefault();
+      closeDialog();
+    });
+    dialog.addEventListener('click', (e) => {
+      if (e.target === dialog) closeDialog();
+    });
+
+    const overlay = document.getElementById('info-overlay');
+    document.getElementById('foobar').addEventListener('click', () => {
+      overlay.classList.toggle('visible');
+    });
+    overlay.querySelector('.overlay-close').addEventListener('click', () => {
+      overlay.classList.remove('visible');
+    });
+    document.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape') overlay.classList.remove('visible');
+    });
+  </script>
 </body>
 
