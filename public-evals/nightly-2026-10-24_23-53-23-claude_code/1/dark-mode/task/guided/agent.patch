+  <script>
+    const root = document.documentElement;
+    const themeMeta = document.querySelector('meta[name="color-scheme"]');
+    const themeSelect = document.getElementById('theme-select');
+
+    function applyTheme(theme) {
+      if (theme === 'light' || theme === 'dark') {
+        root.dataset.theme = theme;
+        themeMeta.content = theme;
+      } else {
+        delete root.dataset.theme;
+        themeMeta.content = 'light dark';
+      }
+    }
+
+    function storedTheme() {
+      try {
+        return localStorage.getItem('theme') || 'system';
+      } catch (e) {
+        return 'system';
+      }
+    }
+
+    themeSelect.value = root.dataset.theme || 'system';
+    applyTheme(themeSelect.value);
+
+    themeSelect.addEventListener('change', () => {
+      applyTheme(themeSelect.value);
+      try {
+        if (themeSelect.value === 'system') localStorage.removeItem('theme');
+        else localStorage.setItem('theme', themeSelect.value);
+      } catch (e) { }
+    });
+
+    // Keep other tabs in sync
+    window.addEventListener('storage', (e) => {
+      if (e.key !== 'theme') return;
+      themeSelect.value = storedTheme();
+      applyTheme(themeSelect.value);
+    });
+
+    // Late night specials filter
+    const specialFilter = document.getElementById('special-filter');
+    specialFilter.addEventListener('change', () => {
+      document.querySelectorAll('.special').forEach((item) => {
+        item.hidden = specialFilter.value !== 'all' && item.dataset.kind !== specialFilter.value;
+      });
+    });
+  </script>
+
 </body>
 
