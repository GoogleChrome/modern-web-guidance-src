+  <script>
+    class DrinkCard extends HTMLElement {
+      constructor() {
+        super();
+        if (!this.shadowRoot) {
+          // No declarative shadow DOM support: attach from the same inert template.
+          const tpl = this.querySelector(':scope > template[shadowrootmode]');
+          this.attachShadow({ mode: 'open' }).append(tpl.content);
+          tpl.remove();
+        }
+        // Hydrate in place: wire behavior onto the server-rendered markup, no re-render.
+        const button = this.shadowRoot.getElementById('add');
+        let count = 0;
+        button.addEventListener('click', () => {
+          count++;
+          button.textContent = `Added (${count})`;
+        });
+      }
+    }
+    customElements.define('drink-card', DrinkCard);
+  </script>
