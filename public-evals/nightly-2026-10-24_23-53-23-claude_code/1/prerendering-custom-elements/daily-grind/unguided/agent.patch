@@ -0,0 +1,55 @@
+// <drink-card> is server-rendered with Declarative Shadow DOM (styles + markup
+// are in the HTML), so it paints fully styled before this script loads.
+// On upgrade we adopt the existing shadow root and only attach behavior.
+const STYLES = `
+  :host { display: block; }
+  .card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,.1); text-align: center; position: relative; height: 100%; }
+  h3 { margin-bottom: 10px; color: var(--primary); }
+  .btn { display: inline-block; background: var(--primary); color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; margin-top: 15px; transition: background .3s; }
+  .btn:hover { background: #3e2723; }
+  .fav { position: absolute; top: 10px; right: 12px; background: none; border: 0; cursor: pointer; font-size: 1.4rem; line-height: 1; color: #bbb; }
+  .fav[aria-pressed="true"] { color: var(--accent); }
+`;
+
+export function renderDrinkCard({ name, description, href, favorited }) {
+  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
+  return `<style>${STYLES}</style>
+<div class="card">
+  <button class="fav" type="button" aria-pressed="${favorited}" aria-label="Favorite ${esc(name)}">${favorited ? '★' : '☆'}</button>
+  <h3>${esc(name)}</h3>
+  <p>${esc(description)}</p>
+  <a href="${esc(href)}" class="btn">View Details</a>
+</div>`;
+}
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['favorited'];
+
+  connectedCallback() {
+    if (this.hydrated) return;
+    this.hydrated = true;
+    // Declarative shadow root already attached by the parser -> reuse it.
+    // Only client-created elements (no SSR) need to render.
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' }).innerHTML = renderDrinkCard({
+        name: this.getAttribute('name') ?? '',
+        description: this.getAttribute('description') ?? '',
+        href: this.getAttribute('href') ?? '#',
+        favorited: this.hasAttribute('favorited'),
+      });
+    }
+    this.shadowRoot.querySelector('.fav').addEventListener('click', () => {
+      this.toggleAttribute('favorited');
+    });
+  }
+
+  attributeChangedCallback() {
+    const btn = this.shadowRoot?.querySelector('.fav');
+    if (!btn) return;
+    const on = this.hasAttribute('favorited');
+    btn.setAttribute('aria-pressed', on);
+    btn.textContent = on ? '★' : '☆';
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
