+  <script>
+    (() => {
+      const $ = (id) => document.getElementById(id);
+      const phoneForm = $('phone-form'), otpForm = $('otp-form');
+      const phone = $('phone'), otp = $('otp');
+      const status = $('status');
+      const RESEND_SECONDS = 30;
+      let e164 = '', abortOtp = null, timer = null;
+
+      // Replace these two with real calls to your SMS backend.
+      // The SMS body should end with the origin-bound line so WebOTP and
+      // iOS/Android can extract the code:
+      //   "Your Daily Grind code is 123456.\n\n@" + location.host + " #123456"
+      async function requestCode(number) {
+        const res = await fetch('/api/verify/start', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ phone: number })
+        });
+        if (!res.ok) throw new Error('Could not send the code. Please try again.');
+      }
+      async function checkCode(number, code) {
+        const res = await fetch('/api/verify/check', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ phone: number, code })
+        });
+        if (!res.ok) throw new Error('That code is incorrect or expired.');
+      }
+
+      function normalizePhone(raw) {
+        const t = raw.trim();
+        const digits = t.replace(/\D/g, '');
+        if (t.startsWith('+')) return digits.length >= 8 && digits.length <= 15 ? '+' + digits : null;
+        if (digits.length === 10) return '+1' + digits;
+        if (digits.length === 11 && digits[0] === '1') return '+' + digits;
+        return null;
+      }
+
+      function setError(input, el, msg) {
+        el.textContent = msg;
+        if (msg) input.setAttribute('aria-invalid', 'true');
+        else input.removeAttribute('aria-invalid');
+      }
+
+      function setStatus(msg, ok) {
+        status.textContent = msg;
+        status.classList.toggle('success', !!ok);
+      }
+
+      function startCooldown() {
+        const btn = $('resend-btn');
+        let left = RESEND_SECONDS;
+        clearInterval(timer);
+        btn.disabled = true;
+        const tick = () => {
+          btn.textContent = left > 0 ? `Resend code (${left}s)` : 'Resend code';
+          if (left-- <= 0) { clearInterval(timer); btn.disabled = false; }
+        };
+        tick();
+        timer = setInterval(tick, 1000);
+      }
+
+      // Auto-extract the code from an incoming SMS (Chromium WebOTP API).
+      function listenForSms() {
+        if (!('OTPCredential' in window)) return;
+        if (abortOtp) abortOtp.abort();
+        abortOtp = new AbortController();
+        navigator.credentials.get({ otp: { transport: ['sms'] }, signal: abortOtp.signal })
+          .then((cred) => {
+            if (!cred) return;
+            otp.value = cred.code.replace(/\D/g, '').slice(0, 6);
+            otpForm.requestSubmit();
+          })
+          .catch(() => { /* aborted or dismissed: manual entry still works */ });
+      }
+
+      async function send() {
+        const btn = $('send-btn');
+        btn.disabled = true;
+        setStatus('Sending code…');
+        try {
+          await requestCode(e164);
+          phoneForm.hidden = true;
+          otpForm.hidden = false;
+          $('sent-to').textContent = phone.value.trim();
+          otp.value = '';
+          setError(otp, $('otp-error'), '');
+          setStatus('Code sent. Check your text messages.');
+          otp.focus();
+          startCooldown();
+          listenForSms();
+        } catch (err) {
+          setStatus('');
+          setError(phone, $('phone-error'), err.message);
+          phone.focus();
+        } finally {
+          btn.disabled = false;
+        }
+      }
+
+      phoneForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        e164 = normalizePhone(phone.value);
+        if (!e164) {
+          setError(phone, $('phone-error'), 'Enter a valid phone number, e.g. (555) 123-4567.');
+          phone.focus();
+          return;
+        }
+        setError(phone, $('phone-error'), '');
+        send();
+      });
+
+      otp.addEventListener('input', () => {
+        otp.value = otp.value.replace(/\D/g, '').slice(0, 6);
+        if (otp.value.length) setError(otp, $('otp-error'), '');
+      });
+
+      otpForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        if (!/^\d{6}$/.test(otp.value)) {
+          setError(otp, $('otp-error'), 'Enter the 6-digit code from your text message.');
+          otp.focus();
+          return;
+        }
+        const btn = $('verify-btn');
+        btn.disabled = true;
+        setStatus('Verifying…');
+        try {
+          await checkCode(e164, otp.value);
+          if (abortOtp) abortOtp.abort();
+          clearInterval(timer);
+          otpForm.hidden = true;
+          setStatus('Phone number verified. Thank you!', true);
+        } catch (err) {
+          setStatus('');
+          setError(otp, $('otp-error'), err.message);
+          otp.select();
+        } finally {
+          btn.disabled = false;
+        }
+      });
+
+      $('resend-btn').addEventListener('click', send);
+      $('change-btn').addEventListener('click', () => {
+        if (abortOtp) abortOtp.abort();
+        clearInterval(timer);
+        otpForm.hidden = true;
+        phoneForm.hidden = false;
+        setStatus('');
+        phone.focus();
+      });
+    })();
+  </script>
