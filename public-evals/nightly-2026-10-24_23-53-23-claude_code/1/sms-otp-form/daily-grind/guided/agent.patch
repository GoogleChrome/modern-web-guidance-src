+
+  <script>
+    const phoneForm = document.getElementById('phone-form');
+    const phoneInput = document.getElementById('phone-input');
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const statusEl = document.getElementById('verify-status');
+    const sendBtn = document.getElementById('send-btn');
+    const verifyBtn = document.getElementById('verify-btn');
+
+    function setStatus(msg, type = '') {
+      statusEl.textContent = msg;
+      statusEl.className = 'verify-status ' + type;
+    }
+
+    async function post(url, data) {
+      const res = await fetch(url, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(data),
+      });
+      if (!res.ok) throw new Error('Request failed');
+      return res;
+    }
+
+    // WebOTP: auto-fill and submit the code from an origin-bound SMS ("@host #code")
+    let otpAbortController = null;
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      if (!('OTPCredential' in window)) return;
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+      try {
+        const otp = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: ac.signal });
+        if (!otp) return;
+        otpInput.value = otp.code;
+        otpForm.requestSubmit();
+      } catch (err) {
+        if (err && err.name === 'AbortError') return;
+        console.error('WebOTP error:', err);
+      }
+    }
+
+    async function sendCode() {
+      sendBtn.disabled = true;
+      setStatus('Sending code…');
+      try {
+        await post(phoneForm.action, { phone: phoneInput.value.trim() });
+        document.getElementById('sent-to').textContent = phoneInput.value.trim();
+        phoneForm.hidden = true;
+        otpForm.hidden = false;
+        otpInput.value = '';
+        otpInput.focus();
+        setStatus('Code sent. It should arrive in a few seconds.');
+        startSmsOtpListener();
+      } catch {
+        setStatus('We couldn’t send a code. Check the number and try again.', 'error');
+        phoneInput.focus();
+      } finally {
+        sendBtn.disabled = false;
+      }
+    }
+
+    phoneForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      sendCode();
+    });
+
+    otpForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      stopSmsOtpListener();
+      verifyBtn.disabled = true;
+      setStatus('Verifying…');
+      try {
+        await post(otpForm.action, { phone: phoneInput.value.trim(), otp: otpInput.value });
+        otpForm.hidden = true;
+        setStatus('Phone number verified. Thank you!', 'success');
+      } catch {
+        setStatus('That code didn’t work. Check it and try again, or resend a new code.', 'error');
+        otpInput.select();
+        startSmsOtpListener();
+      } finally {
+        verifyBtn.disabled = false;
+      }
+    });
+
+    document.getElementById('resend-btn').addEventListener('click', () => {
+      stopSmsOtpListener();
+      post(phoneForm.action, { phone: phoneInput.value.trim() })
+        .then(() => { setStatus('A new code was sent.'); otpInput.value = ''; otpInput.focus(); startSmsOtpListener(); })
+        .catch(() => setStatus('We couldn’t resend the code. Try again shortly.', 'error'));
+    });
+
+    document.getElementById('change-btn').addEventListener('click', () => {
+      stopSmsOtpListener();
+      otpForm.hidden = true;
+      phoneForm.hidden = false;
+      setStatus('');
+      phoneInput.focus();
+    });
+
+    window.addEventListener('pagehide', stopSmsOtpListener);
+  </script>
 </body>
 
