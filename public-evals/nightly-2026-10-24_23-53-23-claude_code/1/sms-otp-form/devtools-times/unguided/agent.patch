index 0000000..94ee0a7
--- /dev/null
+++ b/src/lib/phone-verification.ts
@@ -0,0 +1,80 @@
+import { createHash, createHmac, randomInt, timingSafeEqual } from 'node:crypto';
+
+const CODE_TTL_MS = 5 * 60 * 1000;
+const RESEND_COOLDOWN_MS = 30 * 1000;
+const MAX_ATTEMPTS = 5;
+const TOKEN_TTL_MS = 15 * 60 * 1000;
+
+// In-memory store: fine for a single instance; use a shared store when scaling out.
+const pending = new Map<string, { hash: string; expires: number; attempts: number; sentAt: number }>();
+
+const secret = process.env.PHONE_VERIFY_SECRET || (process.env.NODE_ENV === 'production' ? '' : 'dev-secret');
+
+const hashCode = (phone: string, code: string) =>
+  createHash('sha256').update(`${phone}:${code}`).digest('hex');
+
+const sign = (payload: string) => createHmac('sha256', secret).update(payload).digest('hex');
+
+/** Normalizes to E.164. Returns null if invalid. */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const cleaned = input.replace(/[\s().-]/g, '');
+  return /^\+[1-9]\d{7,14}$/.test(cleaned) ? cleaned : null;
+}
+
+export async function sendCode(phone: string, origin: string) {
+  const existing = pending.get(phone);
+  const now = Date.now();
+  if (existing && now - existing.sentAt < RESEND_COOLDOWN_MS) {
+    return { ok: false as const, retryAfter: Math.ceil((RESEND_COOLDOWN_MS - (now - existing.sentAt)) / 1000) };
+  }
+  const code = String(randomInt(0, 1_000_000)).padStart(6, '0');
+  // The trailing "@domain #code" line enables automatic extraction via the WebOTP API.
+  const host = new URL(origin).host;
+  const body = `${code} is your The DevTools Times verification code.\n\n@${host} #${code}`;
+  await deliverSms(phone, body);
+  pending.set(phone, { hash: hashCode(phone, code), expires: now + CODE_TTL_MS, attempts: 0, sentAt: now });
+  return { ok: true as const };
+}
+
+export function checkCode(phone: string, code: string) {
+  const entry = pending.get(phone);
+  if (!entry || entry.expires < Date.now()) {
+    pending.delete(phone);
+    return { ok: false as const, error: 'expired' };
+  }
+  if (++entry.attempts > MAX_ATTEMPTS) {
+    pending.delete(phone);
+    return { ok: false as const, error: 'too_many_attempts' };
+  }
+  const a = Buffer.from(entry.hash);
+  const b = Buffer.from(hashCode(phone, code));
+  if (!timingSafeEqual(a, b)) return { ok: false as const, error: 'invalid' };
+  pending.delete(phone);
+  const payload = `${phone}.${Date.now() + TOKEN_TTL_MS}`;
+  return { ok: true as const, token: `${payload}.${sign(payload)}` };
+}
+
+export function verifyToken(token: string, phone: string) {
+  const [p, exp, sig] = token.split('.');
+  const payload = `${p}.${exp}`;
+  return p === phone && Number(exp) > Date.now() && !!sig && sig === sign(payload);
+}
+
+async function deliverSms(to: string, body: string) {
+  const { TWILIO_ACCOUNT_SID: sid, TWILIO_AUTH_TOKEN: token, TWILIO_FROM: from } = process.env;
+  if (!sid || !token || !from) {
+    if (process.env.NODE_ENV === 'production') throw new Error('SMS provider not configured');
+    console.log(`[sms:dev] to ${to}: ${body}`);
+    return;
+  }
+  const res = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${sid}/Messages.json`, {
+    method: 'POST',
+    headers: {
+      Authorization: `Basic ${Buffer.from(`${sid}:${token}`).toString('base64')}`,
+      'Content-Type': 'application/x-www-form-urlencoded',
+    },
+    body: new URLSearchParams({ To: to, From: from, Body: body }),
+  });
+  if (!res.ok) throw new Error(`SMS delivery failed (${res.status})`);
+}
diff --git a/src/pages/api/phone/send.ts b/src/pages/api/phone/send.ts
new file mode 100644
index 0000000..e1e2123
--- /dev/null
+++ b/src/pages/api/phone/send.ts
@@ -0,0 +1,18 @@
+import type { APIRoute } from 'astro';
+import { normalizePhone, sendCode } from '../../../lib/phone-verification';
+
+const json = (data: unknown, status = 200) =>
+  new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });
+
+export const POST: APIRoute = async ({ request, url }) => {
+  const { phone } = await request.json().catch(() => ({}));
+  const normalized = normalizePhone(phone);
+  if (!normalized) return json({ error: 'Enter a valid phone number including country code, e.g. +14155550123.' }, 400);
+  try {
+    const result = await sendCode(normalized, url.origin);
+    if (!result.ok) return json({ error: `Please wait ${result.retryAfter}s before requesting another code.`, retryAfter: result.retryAfter }, 429);
+    return json({ ok: true });
+  } catch {
+    return json({ error: 'We could not send the code. Please try again later.' }, 502);
+  }
+};
