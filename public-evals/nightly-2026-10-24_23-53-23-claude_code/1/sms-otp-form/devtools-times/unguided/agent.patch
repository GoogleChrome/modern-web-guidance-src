@@ -0,0 +1,22 @@
+import type { APIRoute } from 'astro';
+import { checkCode, normalizePhone } from '../../../lib/phone-verification';
+
+const json = (data: unknown, status = 200) =>
+  new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json' } });
+
+const messages: Record<string, string> = {
+  invalid: 'That code is incorrect. Check the message and try again.',
+  expired: 'That code has expired. Request a new one.',
+  too_many_attempts: 'Too many incorrect attempts. Request a new code.',
+};
+
+export const POST: APIRoute = async ({ request }) => {
+  const { phone, code } = await request.json().catch(() => ({}));
+  const normalized = normalizePhone(phone);
+  if (!normalized || typeof code !== 'string' || !/^\d{6}$/.test(code)) {
+    return json({ error: messages.invalid }, 400);
+  }
+  const result = checkCode(normalized, code);
+  if (!result.ok) return json({ error: messages[result.error], code: result.error }, 400);
+  return json({ ok: true, token: result.token });
+};
