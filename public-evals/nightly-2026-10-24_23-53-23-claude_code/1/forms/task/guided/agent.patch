+  <script>
+    (() => {
+      const form = document.getElementById('rewards-form');
+      const steps = [...form.querySelectorAll('[data-step]')];
+      const labels = [...form.querySelectorAll('[data-step-label]')];
+      const back = document.getElementById('back');
+      const next = document.getElementById('next');
+      const submit = document.getElementById('submit');
+      const status = document.getElementById('step-status');
+      const formStatus = document.getElementById('form-status');
+      const summary = document.getElementById('summary');
+      const nextText = ['Next: Preferences', 'Next: Review', ''];
+      let current = 0;
+
+      document.documentElement.classList.add('js');
+
+      const errorFor = (field) => document.getElementById(`${field.id}-error`);
+
+      function validateField(field) {
+        const message = field.validity.valid ? '' : friendlyMessage(field);
+        const box = errorFor(field);
+        if (box) box.textContent = message;
+        if (message) field.setAttribute('aria-invalid', 'true');
+        else field.removeAttribute('aria-invalid');
+        return !message;
+      }
+
+      function friendlyMessage(field) {
+        const v = field.validity;
+        const label = (form.querySelector(`label[for="${field.id}"]`)?.firstChild?.textContent || 'This field').replace(/\s*\*$/, '').trim();
+        if (v.valueMissing) return field.type === 'checkbox' ? 'Please tick the box to continue.' : `${label} is required.`;
+        if (v.typeMismatch) return 'Enter a valid email address, like you@example.com.';
+        if (v.tooShort) return `Use at least ${field.minLength} characters (you have ${field.value.length}).`;
+        if (v.patternMismatch) return 'Enter a valid phone number, for example +1 555 123 4567.';
+        return field.validationMessage;
+      }
+
+      function validateStep(index) {
+        const fields = [...steps[index].querySelectorAll('input, select')].filter((f) => f.willValidate);
+        const invalid = fields.filter((f) => !validateField(f));
+        if (invalid.length) {
+          formStatus.textContent = `Please fix ${invalid.length} ${invalid.length === 1 ? 'field' : 'fields'} before continuing.`;
+          invalid[0].focus();
+          return false;
+        }
+        formStatus.textContent = '';
+        return true;
+      }
+
+      function render() {
+        steps.forEach((step, i) => { step.hidden = i !== current; });
+        labels.forEach((li, i) => {
+          if (i === current) li.setAttribute('aria-current', 'step');
+          else li.removeAttribute('aria-current');
+          li.classList.toggle('done', i < current);
+        });
+        back.hidden = current === 0;
+        next.hidden = current === steps.length - 1;
+        submit.hidden = current !== steps.length - 1;
+        next.textContent = nextText[current];
+        status.textContent = `Step ${current + 1} of ${steps.length}`;
+        if (current === steps.length - 1) buildSummary();
+      }
+
+      function go(index) {
+        current = index;
+        render();
+        const heading = steps[current].querySelector('h3');
+        heading.focus();
+        heading.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
+      }
+
+      function buildSummary() {
+        const data = new FormData(form);
+        const storeText = form.store.selectedOptions[0]?.textContent;
+        const drinkText = form.drink.selectedOptions[0]?.value ? form.drink.selectedOptions[0].textContent : '';
+        const rows = [
+          ['Name', data.get('name')],
+          ['Email', data.get('email')],
+          ['Password', '•'.repeat(8) + ' (hidden)'],
+          ['Home store', storeText],
+          ['Favorite drink', drinkText],
+          ['Mobile number', data.get('phone')],
+          ['Birthday', data.get('bday')],
+          ['Offers by email', data.get('offers') ? 'Yes' : 'No'],
+        ];
+        summary.replaceChildren();
+        for (const [term, value] of rows) {
+          const row = document.createElement('div');
+          const dt = document.createElement('dt');
+          const dd = document.createElement('dd');
+          dt.textContent = term;
+          dd.textContent = value || 'Not provided';
+          row.append(dt, dd);
+          summary.append(row);
+        }
+      }
+
+      next.addEventListener('click', () => {
+        if (validateStep(current)) go(current + 1);
+      });
+      back.addEventListener('click', () => go(current - 1));
+
+      // Enter in a text field advances the step instead of submitting early.
+      form.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter' && e.target.matches('input:not([type="checkbox"])') && current < steps.length - 1) {
+          e.preventDefault();
+          next.click();
+        }
+      });
+
+      // Validate a field once the user leaves it; clear errors as soon as they are fixed.
+      form.addEventListener('focusout', (e) => {
+        if (e.target.matches('input, select') && e.target.willValidate && (e.target.value || e.target.dataset.touched)) {
+          e.target.dataset.touched = '1';
+          validateField(e.target);
+        }
+      });
+      form.addEventListener('input', (e) => {
+        if (e.target.dataset.touched || e.target.getAttribute('aria-invalid')) validateField(e.target);
+      });
+
+      const toggle = form.querySelector('.toggle-pw');
+      toggle.addEventListener('click', () => {
+        const show = form.password.type === 'password';
+        form.password.type = show ? 'text' : 'password';
+        toggle.setAttribute('aria-pressed', String(show));
+        toggle.firstChild.textContent = show ? 'Hide' : 'Show';
+      });
+
+      form.addEventListener('submit', (e) => {
+        // Re-check every step so a skipped or tampered step can't slip through.
+        for (let i = 0; i < steps.length; i++) {
+          if (!validateStep(i)) {
+            e.preventDefault();
+            if (i !== current) { current = i; render(); steps[i].querySelector('input, select').focus(); }
+            return;
+          }
+        }
+        if (form.bday.value && form.bday.valueAsDate > new Date()) {
+          e.preventDefault();
+          current = 1; render();
+          document.getElementById('bday-error').textContent = 'Birthday can’t be in the future.';
+          form.bday.setAttribute('aria-invalid', 'true');
+          form.bday.focus();
+          return;
+        }
+        submit.disabled = true; // prevent double submission
+        submit.textContent = 'Creating account…';
+      });
+
+      // Restore the button if the page is restored from the back/forward cache.
+      addEventListener('pageshow', () => { submit.disabled = false; submit.textContent = 'Create rewards account'; });
+
+      render();
+    })();
+  </script>
+
