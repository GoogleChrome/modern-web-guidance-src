+  <script>
+    (function () {
+      var root = document.documentElement;
+      root.classList.add('js');
+
+      var form = document.getElementById('rewards-form');
+      var steps = Array.prototype.slice.call(form.querySelectorAll('.step'));
+      var crumbs = Array.prototype.slice.call(document.querySelectorAll('#progress li'));
+      var backBtn = document.getElementById('back');
+      var nextBtn = document.getElementById('next');
+      var submitBtn = document.getElementById('submit');
+      var summary = document.getElementById('error-summary');
+      var status = document.getElementById('form-status');
+      var current = 0;
+
+      var drinkSelect = document.getElementById('drink');
+
+      function esc(id) { return document.getElementById(id); }
+
+      /* ---------- validation ---------- */
+      var rules = {
+        'first-name': function (v) { return v.trim() ? '' : 'Enter your first name.'; },
+        'last-name': function (v) { return v.trim() ? '' : 'Enter your last name.'; },
+        'email': function (v) {
+          if (!v.trim()) return 'Enter your email address.';
+          return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()) ? '' : 'Enter a valid email address, like name@example.com.';
+        },
+        'password': function (v) {
+          if (!v) return 'Create a password.';
+          return v.length >= 12 ? '' : 'Password must be at least 12 characters (you have ' + v.length + ').';
+        },
+        'phone': function (v) {
+          if (!v.trim()) return '';
+          var digits = v.replace(/\D/g, '');
+          return /^[\d\s().+-]+$/.test(v) && digits.length >= 7 && digits.length <= 15 ? '' : 'Enter a valid phone number, or leave it blank.';
+        },
+        'birthday': function (v) {
+          if (!v) return '';
+          var d = new Date(v + 'T00:00:00');
+          if (isNaN(d) || d > new Date() || d.getFullYear() < 1900) return 'Enter a valid date in the past.';
+          return '';
+        },
+        'postal': function (v) {
+          if (!v.trim()) return '';
+          return /^[A-Za-z0-9 -]{3,10}$/.test(v.trim()) ? '' : 'Enter a valid ZIP or postal code.';
+        },
+        'terms': function () { return esc('terms').checked ? '' : 'You must accept the terms to join.'; }
+      };
+
+      function setError(id, msg) {
+        var input = esc(id);
+        var out = esc(id + '-err');
+        out.textContent = msg;
+        if (msg) input.setAttribute('aria-invalid', 'true');
+        else input.removeAttribute('aria-invalid');
+      }
+
+      function label(id) {
+        var l = form.querySelector('label[for="' + id + '"]');
+        return l ? l.firstChild.textContent.trim() : id;
+      }
+
+      function validateStep(index) {
+        var problems = [];
+        steps[index].querySelectorAll('input, select').forEach(function (el) {
+          if (!rules[el.id]) return;
+          var msg = rules[el.id](el.value);
+          setError(el.id, msg);
+          if (msg) problems.push({ id: el.id, msg: msg });
+        });
+        renderSummary(problems);
+        if (problems.length) esc(problems[0].id).focus();
+        return problems.length === 0;
+      }
+
+      function renderSummary(problems) {
+        summary.textContent = '';
+        if (!problems.length) { summary.hidden = true; return; }
+        var p = document.createElement('p');
+        p.textContent = 'Please fix ' + problems.length + (problems.length === 1 ? ' problem:' : ' problems:');
+        var ul = document.createElement('ul');
+        problems.forEach(function (pr) {
+          var li = document.createElement('li');
+          var a = document.createElement('a');
+          a.href = '#' + pr.id;
+          a.textContent = pr.msg;
+          a.addEventListener('click', function (e) { e.preventDefault(); esc(pr.id).focus(); });
+          li.appendChild(a);
+          ul.appendChild(li);
+        });
+        summary.appendChild(p);
+        summary.appendChild(ul);
+        summary.hidden = false;
+      }
+
+      // Validate on blur once touched, and clear errors as the user fixes them
+      Object.keys(rules).forEach(function (id) {
+        var el = esc(id);
+        el.addEventListener('blur', function () {
+          if (el.value || el.getAttribute('aria-invalid')) setError(id, rules[id](el.value));
+        });
+        el.addEventListener('input', function () {
+          if (el.getAttribute('aria-invalid')) setError(id, rules[id](el.value));
+        });
+      });
+
+      /* ---------- step navigation ---------- */
+      function show(index, moveFocus) {
+        current = index;
+        steps.forEach(function (s, i) { s.hidden = i !== index; });
+        crumbs.forEach(function (c, i) {
+          if (i === index) c.setAttribute('aria-current', 'step');
+          else c.removeAttribute('aria-current');
+          c.classList.toggle('done', i < index);
+        });
+        backBtn.hidden = index === 0;
+        nextBtn.hidden = index === steps.length - 1;
+        submitBtn.hidden = index !== steps.length - 1;
+        summary.hidden = true;
+        if (index === steps.length - 1) renderReview();
+        if (moveFocus) {
+          var legend = steps[index].querySelector('legend');
+          legend.setAttribute('tabindex', '-1');
+          legend.focus();
+        }
+      }
+
+      function renderReview() {
+        var dl = esc('review');
+        dl.textContent = '';
+        var items = [
+          ['Name', esc('first-name').value.trim() + ' ' + esc('last-name').value.trim()],
+          ['Email', esc('email').value.trim()],
+          ['Password', '\u2022'.repeat(Math.min(esc('password').value.length, 12))],
+          ['Mobile phone', esc('phone').value.trim()],
+          ['Birthday', esc('birthday').value],
+          ['Favorite drink', drinkSelect.value ? drinkSelect.options[drinkSelect.selectedIndex].text : ''],
+          ['ZIP / postal code', esc('postal').value.trim()]
+        ];
+        items.forEach(function (it) {
+          var dt = document.createElement('dt');
+          var dd = document.createElement('dd');
+          dt.textContent = it[0];
+          dd.textContent = it[1] || 'Not provided';
+          dl.appendChild(dt);
+          dl.appendChild(dd);
+        });
+      }
+
+      nextBtn.addEventListener('click', function () {
+        if (validateStep(current)) show(current + 1, true);
+      });
+      backBtn.addEventListener('click', function () { show(current - 1, true); });
+
+      // Enter on steps 1-2 advances rather than submitting early
+      form.addEventListener('keydown', function (e) {
+        if (e.key === 'Enter' && current < steps.length - 1 && e.target.tagName === 'INPUT') {
+          e.preventDefault();
+          nextBtn.click();
+        }
+      });
+
+      esc('toggle-pw').addEventListener('click', function () {
+        var pw = esc('password');
+        var showing = pw.type === 'text';
+        pw.type = showing ? 'password' : 'text';
+        this.textContent = showing ? 'Show' : 'Hide';
+        this.setAttribute('aria-pressed', String(!showing));
+      });
+
+      /* ---------- submission ---------- */
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        // Revalidate every step; jump back to the first one with problems
+        for (var i = 0; i < steps.length; i++) {
+          if (!validateStep(i)) { show(i, false); validateStep(i); return; }
+        }
+        if (esc('website').value) { return; } // honeypot tripped: silently drop
+
+        var data = new FormData(form);
+        data.delete('website');
+        submitBtn.disabled = true;
+        submitBtn.textContent = 'Joining\u2026';
+        status.textContent = '';
+
+        var controller = new AbortController();
+        var timer = setTimeout(function () { controller.abort(); }, 15000);
+
+        fetch(form.action, {
+          method: 'POST',
+          body: data,
+          credentials: 'same-origin',
+          headers: { 'Accept': 'application/json', 'X-Requested-With': 'fetch' },
+          signal: controller.signal
+        }).then(function (res) {
+          if (!res.ok) throw new Error('HTTP ' + res.status);
+          form.reset();
+          esc('password').type = 'password';
+          form.hidden = true;
+          document.getElementById('progress').hidden = true;
+          var done = document.createElement('div');
+          done.setAttribute('tabindex', '-1');
+          done.innerHTML = '<h3>Welcome to Daily Grind Rewards!</h3><p>Check your email to confirm your address and claim your free first drink.</p>';
+          form.parentNode.appendChild(done);
+          done.focus();
+        }).catch(function () {
+          status.textContent = 'We couldn\u2019t complete your registration. Please check your connection and try again.';
+          submitBtn.disabled = false;
+          submitBtn.textContent = 'Join Rewards';
+        }).then(function () { clearTimeout(timer); });
+      });
+
+      show(0, false);
+    })();
+  </script>
+
 </body>
 
