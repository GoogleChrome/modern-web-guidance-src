+  <script>
+    // GPU ripple distortion for the hero content using HTML-in-Canvas.
+    // Without support (or with reduced motion) the plain HTML stays as is.
+    (() => {
+      if (!('content' in HTMLCanvasElement.prototype)) return;
+      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+
+      const hero = document.querySelector('.hero');
+      const content = document.getElementById('hero-content');
+      const canvas = document.createElement('canvas');
+      const gl = canvas.getContext('webgl2');
+      if (!gl) return;
+
+      const MAX_RIPPLES = 8;
+      const VERT = `#version 300 es
+        out vec2 vUv;
+        void main() {
+          vec2 p = vec2(float(gl_VertexID & 1), float(gl_VertexID >> 1));
+          vUv = vec2(p.x, 1.0 - p.y); // v = 0 at the top, like the element texture
+          gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+        }`;
+      const FRAG = `#version 300 es
+        precision highp float;
+        in vec2 vUv;
+        out vec4 outColor;
+        uniform sampler2D uTex;
+        uniform vec2 uSize;
+        uniform float uTime;
+        uniform vec3 uRipples[${MAX_RIPPLES}]; // xy = origin (uv), z = start time
+        void main() {
+          vec2 aspect = vec2(uSize.x / uSize.y, 1.0);
+          vec2 offset = vec2(0.0);
+          for (int i = 0; i < ${MAX_RIPPLES}; i++) {
+            float age = uTime - uRipples[i].z;
+            if (uRipples[i].z < 0.0 || age < 0.0 || age > 3.0) continue;
+            vec2 delta = (vUv - uRipples[i].xy) * aspect;
+            float d = length(delta);
+            float ring = d - age * 0.35;
+            float envelope = exp(-ring * ring * 90.0) * exp(-age * 1.1);
+            offset += normalize(delta + 1e-5) * sin(ring * 60.0) * envelope * 0.012;
+          }
+          // Gentle ambient wave so the hero feels alive at rest.
+          offset += 0.0008 * vec2(sin(vUv.y * 22.0 + uTime * 1.3), cos(vUv.x * 14.0 + uTime));
+          outColor = texture(uTex, vUv + offset / aspect);
+        }`;
+
+      function compile(type, src) {
+        const sh = gl.createShader(type);
+        gl.shaderSource(sh, src);
+        gl.compileShader(sh);
+        if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(sh));
+        return sh;
+      }
+      const program = gl.createProgram();
+      try {
+        gl.attachShader(program, compile(gl.VERTEX_SHADER, VERT));
+        gl.attachShader(program, compile(gl.FRAGMENT_SHADER, FRAG));
+        gl.linkProgram(program);
+        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(program));
+      } catch (err) {
+        console.error('Hero shader failed, keeping plain HTML:', err);
+        return;
+      }
+      gl.useProgram(program);
+      const loc = (n) => gl.getUniformLocation(program, n);
+      const uSize = loc('uSize'), uTime = loc('uTime'), uRipples = loc('uRipples');
+      gl.uniform1i(loc('uTex'), 0);
+
+      const texture = gl.createTexture();
+      const textureState = { width: 0, height: 0 };
+
+      function getElementImageSize(element) {
+        let image;
+        try {
+          image = canvas.captureElementImage(element);
+        } catch (err) {
+          canvas.requestPaint(); // No paint record yet: retry on the next paint event.
+          return null;
+        }
+        const width = Math.ceil(image.width);
+        const height = Math.ceil(image.height);
+        image.close();
+        return width > 0 && height > 0 ? { width, height } : null;
+      }
+
+      function uploadContent() {
+        const size = getElementImageSize(content);
+        if (!size) return false;
+        gl.bindTexture(gl.TEXTURE_2D, texture);
+        if (textureState.width !== size.width || textureState.height !== size.height) {
+          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, size.width, size.height, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+          textureState.width = size.width;
+          textureState.height = size.height;
+        }
+        gl.texElementSubImage2D(gl.TEXTURE_2D, 0, 0, 0, content, size);
+        return true;
+      }
+
+      // The content fills the canvas, so the model quad maps 1:1 onto it
+      // (identity MVP) and the real DOM stays aligned with the drawn pixels.
+      function syncGeometry() {
+        const w = content.offsetWidth, h = content.offsetHeight;
+        const toGLModel = new DOMMatrix().scale(1 / w, -1 / h, 1 / h).translate(-w / 2, -h / 2);
+        const viewport = new DOMMatrix()
+          .translate(canvas.clientWidth / 2, canvas.clientHeight / 2)
+          .scale(canvas.clientWidth / 2, -canvas.clientHeight / 2, canvas.clientHeight / 2);
+        // Model space spans -0.5..0.5; scale by 2 to reach clip space.
+        const mvp = new DOMMatrix().scale(2, 2, 1);
+        canvas.updateElementGeometry(content, {
+          canvasTransform: viewport.multiply(mvp).multiply(toGLModel),
+        });
+      }
+
+      // Ripples ring buffer
+      const ripples = new Float32Array(MAX_RIPPLES * 3).fill(-1);
+      let next = 0;
+      const t0 = performance.now();
+      const now = () => (performance.now() - t0) / 1000;
+      function addRipple(x, y) {
+        const r = canvas.getBoundingClientRect();
+        ripples.set([(x - r.left) / r.width, (y - r.top) / r.height, now()], next * 3);
+        next = (next + 1) % MAX_RIPPLES;
+      }
+      let lastMove = 0;
+      hero.addEventListener('pointermove', (e) => {
+        if (e.timeStamp - lastMove < 120) return;
+        lastMove = e.timeStamp;
+        addRipple(e.clientX, e.clientY);
+      });
+      hero.addEventListener('pointerdown', (e) => addRipple(e.clientX, e.clientY));
+
+      let ready = false;
+      canvas.onpaint = (event) => {
+        try {
+          if (!ready || (event.changedElements && event.changedElements.length > 0)) {
+            ready = uploadContent();
+          }
+        } catch (err) {
+          console.error('texElementSubImage2D copy failed:', err);
+        }
+        if (!ready) return;
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.clearColor(0, 0, 0, 0);
+        gl.clear(gl.COLOR_BUFFER_BIT);
+        gl.uniform2f(uSize, canvas.width, canvas.height);
+        gl.uniform1f(uTime, now());
+        gl.uniform3fv(uRipples, ripples);
+        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
+        syncGeometry();
+      };
+
+      new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+      }).observe(canvas, 'devicePixelContentBoxSize' in ResizeObserverEntry.prototype
+        ? { box: 'device-pixel-content-box' } : {});
+
+      // Upgrade: move the real content into the canvas and start animating.
+      canvas.className = 'hero-canvas';
+      canvas.setAttribute('content', 'drawable');
+      content.setAttribute('drawable', '');
+      canvas.append(content);
+      hero.prepend(canvas);
+
+      (function loop() {
+        canvas.requestPaint();
+        requestAnimationFrame(loop);
+      })();
+    })();
+  </script>
+
 </body>
 
