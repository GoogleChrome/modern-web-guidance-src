+  <script>
+    (function () {
+      const hero = document.querySelector('.hero');
+      const canvas = hero.querySelector('.hero-gl');
+      const gl = canvas.getContext('webgl', { premultipliedAlpha: false, antialias: false });
+      if (!gl) return;
+
+      const IMG_URL = 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80';
+      const MAX_RIPPLES = 8;
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
+      const btn = hero.querySelector('.btn');
+      const textEls = [hero.querySelector('h1'), hero.querySelector('p'), btn];
+
+      // ---- GL setup ----
+      const vs = `attribute vec2 p; varying vec2 uv;
+        void main(){ uv = p * 0.5 + 0.5; gl_Position = vec4(p, 0.0, 1.0); }`;
+      const fs = `precision mediump float;
+        varying vec2 uv;
+        uniform sampler2D tex;
+        uniform float time;
+        uniform float aspect;
+        uniform float amp;
+        uniform vec3 ripples[${MAX_RIPPLES}]; // xy = origin (uv), z = start time (<0 unused)
+        void main(){
+          vec2 offset = vec2(0.0);
+          float light = 0.0;
+          // gentle ambient swell
+          offset += amp * 0.0015 * vec2(sin(uv.y * 18.0 + time * 1.3), cos(uv.x * 14.0 + time * 1.1));
+          for (int i = 0; i < ${MAX_RIPPLES}; i++) {
+            vec3 r = ripples[i];
+            if (r.z < 0.0) continue;
+            float t = time - r.z;
+            vec2 d = (uv - r.xy) * vec2(aspect, 1.0);
+            float dist = length(d);
+            float front = t * 0.45;
+            float env = exp(-pow((dist - front) * 5.0, 2.0)) * exp(-t * 0.9);
+            float w = sin((dist - front) * 45.0) * env;
+            offset += normalize(d + 1e-5) * w * 0.012 * vec2(1.0 / aspect, 1.0);
+            light += w * 0.08;
+          }
+          vec4 c = texture2D(tex, clamp(uv + offset, 0.0, 1.0));
+          gl_FragColor = vec4(c.rgb + light, 1.0);
+        }`;
+      function shader(type, src) {
+        const sh = gl.createShader(type);
+        gl.shaderSource(sh, src);
+        gl.compileShader(sh);
+        if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(sh));
+        return sh;
+      }
+      let prog;
+      try {
+        prog = gl.createProgram();
+        gl.attachShader(prog, shader(gl.VERTEX_SHADER, vs));
+        gl.attachShader(prog, shader(gl.FRAGMENT_SHADER, fs));
+        gl.linkProgram(prog);
+        if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error('link failed');
+      } catch (e) { return; }
+      gl.useProgram(prog);
+
+      const buf = gl.createBuffer();
+      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
+      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
+      const loc = gl.getAttribLocation(prog, 'p');
+      gl.enableVertexAttribArray(loc);
+      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
+
+      const u = n => gl.getUniformLocation(prog, n);
+      const uTime = u('time'), uAspect = u('aspect'), uAmp = u('amp'), uRipples = u('ripples');
+
+      const tex = gl.createTexture();
+      gl.bindTexture(gl.TEXTURE_2D, tex);
+      gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+
+      // ---- Paint the hero (background + text + button) into a 2D canvas used as the texture ----
+      const paint = document.createElement('canvas');
+      const ctx = paint.getContext('2d');
+      let img = null;
+      let btnHover = false;
+
+      function roundRect(x, y, w, h, r) {
+        ctx.beginPath();
+        ctx.moveTo(x + r, y);
+        ctx.arcTo(x + w, y, x + w, y + h, r);
+        ctx.arcTo(x + w, y + h, x, y + h, r);
+        ctx.arcTo(x, y + h, x, y, r);
+        ctx.arcTo(x, y, x + w, y, r);
+        ctx.closePath();
+      }
+
+      // Draw each wrapped line of an element's text at its real DOM position.
+      function drawText(el, origin) {
+        const cs = getComputedStyle(el);
+        ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
+        ctx.letterSpacing = cs.letterSpacing === 'normal' ? '0px' : cs.letterSpacing;
+        ctx.fillStyle = '#fff';
+        ctx.textBaseline = 'alphabetic';
+        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
+        const range = document.createRange();
+        let node;
+        while ((node = walker.nextNode())) {
+          const text = node.textContent;
+          let line = '', lineStart = 0, lineRect = null;
+          const flush = () => {
+            if (!line.trim() || !lineRect) return;
+            const fm = ctx.measureText(line);
+            const baseline = lineRect.top - origin.top +
+              (lineRect.height + fm.fontBoundingBoxAscent - fm.fontBoundingBoxDescent) / 2;
+            ctx.fillText(line.trimEnd(), lineRect.left - origin.left, baseline);
+          };
+          for (let i = 0; i < text.length; i++) {
+            range.setStart(node, i);
+            range.setEnd(node, i + 1);
+            const r = range.getClientRects()[0];
+            if (!r) { line += text[i]; continue; }
+            if (lineRect && Math.abs(r.top - lineRect.top) > r.height / 2) {
+              flush(); line = ''; lineRect = null;
+            }
+            if (!lineRect) lineRect = r;
+            line += text[i];
+          }
+          flush();
+        }
+      }
+
+      function paintHero() {
+        const dpr = Math.min(window.devicePixelRatio || 1, 2);
+        const rect = hero.getBoundingClientRect();
+        const w = Math.max(1, Math.round(rect.width * dpr));
+        const h = Math.max(1, Math.round(rect.height * dpr));
+        if (paint.width !== w || paint.height !== h) { paint.width = w; paint.height = h; }
+        if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        ctx.clearRect(0, 0, rect.width, rect.height);
+
+        // background-size: cover; background-position: center
+        const s = Math.max(rect.width / img.width, rect.height / img.height);
+        const iw = img.width * s, ih = img.height * s;
+        ctx.drawImage(img, (rect.width - iw) / 2, (rect.height - ih) / 2, iw, ih);
+        ctx.fillStyle = 'rgba(0,0,0,0.5)';
+        ctx.fillRect(0, 0, rect.width, rect.height);
+
+        const bs = getComputedStyle(btn);
+        const br = btn.getBoundingClientRect();
+        ctx.fillStyle = btnHover ? '#3e2723' : getComputedStyle(document.documentElement).getPropertyValue('--primary').trim();
+        roundRect(br.left - rect.left, br.top - rect.top, br.width, br.height, parseFloat(bs.borderTopLeftRadius) || 0);
+        ctx.fill();
+
+        textEls.forEach(el => drawText(el, rect));
+
+        gl.bindTexture(gl.TEXTURE_2D, tex);
+        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, paint);
+        gl.viewport(0, 0, w, h);
+        gl.uniform1f(uAspect, w / h);
+      }
+
+      // ---- Ripples ----
+      const ripples = new Float32Array(MAX_RIPPLES * 3).fill(-1);
+      let next = 0;
+      const t0 = performance.now();
+      const now = () => (performance.now() - t0) / 1000;
+      let lastMove = 0;
+
+      function addRipple(e) {
+        const rect = hero.getBoundingClientRect();
+        const i = next++ % MAX_RIPPLES;
+        ripples[i * 3] = (e.clientX - rect.left) / rect.width;
+        ripples[i * 3 + 1] = 1 - (e.clientY - rect.top) / rect.height;
+        ripples[i * 3 + 2] = now();
+        wake();
+      }
+      hero.addEventListener('pointerdown', addRipple);
+      hero.addEventListener('pointermove', e => {
+        const t = now();
+        if (t - lastMove < 0.12) return;
+        lastMove = t;
+        addRipple(e);
+      });
+      btn.addEventListener('pointerenter', () => { btnHover = true; paintHero(); });
+      btn.addEventListener('pointerleave', () => { btnHover = false; paintHero(); });
+
+      // ---- Render loop (idles when nothing is animating) ----
+      let raf = 0, visible = true;
+      function frame() {
+        raf = 0;
+        const t = now();
+        let active = false;
+        for (let i = 0; i < MAX_RIPPLES; i++) {
+          if (ripples[i * 3 + 2] >= 0 && t - ripples[i * 3 + 2] > 5) ripples[i * 3 + 2] = -1;
+          else if (ripples[i * 3 + 2] >= 0) active = true;
+        }
+        gl.uniform1f(uTime, t);
+        gl.uniform1f(uAmp, reduceMotion ? 0 : 1);
+        gl.uniform3fv(uRipples, ripples);
+        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
+        if (visible && (active || !reduceMotion)) raf = requestAnimationFrame(frame);
+      }
+      function wake() { if (!raf && visible) raf = requestAnimationFrame(frame); }
+
+      new IntersectionObserver(([en]) => { visible = en.isIntersecting; wake(); }).observe(hero);
+
+      let resizeTimer;
+      function relayout() {
+        clearTimeout(resizeTimer);
+        resizeTimer = setTimeout(() => { paintHero(); wake(); }, 100);
+      }
+      new ResizeObserver(relayout).observe(hero);
+
+      // ---- Boot: only take over the DOM visuals once the texture is ready ----
+      const image = new Image();
+      image.crossOrigin = 'anonymous';
+      image.onload = async () => {
+        img = image;
+        if (document.fonts && document.fonts.ready) await document.fonts.ready;
+        paintHero();
+        hero.classList.add('gl-on');
+        wake();
+      };
+      image.onerror = () => { /* keep plain CSS hero */ };
+      image.src = IMG_URL;
+    })();
+  </script>
+
