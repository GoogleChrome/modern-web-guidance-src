+    /* WebGL ripple layer: the canvas paints the hero visuals, the real DOM
+       text/button stay on top (transparent) so they remain selectable and clickable. */
+    .hero {
+      position: relative;
+      overflow: hidden;
+    }
+
+    .hero-gl {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      z-index: 0;
+      pointer-events: none;
+    }
+
+    .hero>*:not(.hero-gl) {
+      position: relative;
+      z-index: 1;
+    }
+
+    .hero.gl-on {
+      background: none;
+    }
+
+    .hero.gl-on h1,
+    .hero.gl-on p,
+    .hero.gl-on .btn {
+      color: transparent;
+    }
+
+    .hero.gl-on .btn,
+    .hero.gl-on .btn:hover {
+      background: transparent;
+    }
+
+    .hero.gl-on ::selection {
+      background: rgba(255, 171, 64, 0.55);
+      color: transparent;
+    }
