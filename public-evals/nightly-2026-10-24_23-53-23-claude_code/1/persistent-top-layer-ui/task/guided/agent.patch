     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button type="button" class="btn feedback-launcher" id="feedback-open">Feedback</button>
+
+  <dialog class="feedback-dialog" id="feedback-dialog" aria-labelledby="feedback-title">
+    <h2 id="feedback-title">Send us feedback</h2>
+    <p>Currently inside: <span id="dialog-location" aria-live="polite">body</span></p>
+    <label>
+      Your thoughts
+      <textarea name="message" placeholder="Tell us about your visit..."></textarea>
+    </label>
+    <fieldset>
+      <legend>Move this dialog to</legend>
+      <div class="actions">
+        <button type="button" data-move-to="nav">Nav</button>
+        <button type="button" data-move-to=".hero">Hero</button>
+        <button type="button" data-move-to="main">Main</button>
+        <button type="button" data-move-to="footer">Footer</button>
+      </div>
+    </fieldset>
+    <button type="button" class="close" id="feedback-close">Close</button>
+  </dialog>
+
+  <script>
+    const dialog = document.getElementById('feedback-dialog');
+    const locationLabel = document.getElementById('dialog-location');
+
+    document.getElementById('feedback-open').addEventListener('click', () => dialog.showModal());
+    document.getElementById('feedback-close').addEventListener('click', () => dialog.close());
+
+    function moveDialog(target) {
+      const active = document.activeElement;
+      const focusInDialog = dialog.contains(active) ? active : null;
+
+      if ('moveBefore' in Element.prototype) {
+        // Atomic move: the dialog stays open and keeps focus.
+        target.moveBefore(dialog, null);
+      } else {
+        // Fallback: a plain reparent closes the dialog, so re-open it
+        // and restore the user's place manually.
+        const wasOpen = dialog.open;
+        const scroll = dialog.querySelector('textarea').scrollTop;
+        const textarea = dialog.querySelector('textarea');
+        const selection = [textarea.selectionStart, textarea.selectionEnd];
+        target.append(dialog);
+        if (wasOpen) {
+          dialog.showModal();
+          textarea.scrollTop = scroll;
+          if (focusInDialog) {
+            focusInDialog.focus({ preventScroll: true });
+            if (focusInDialog === textarea) textarea.setSelectionRange(...selection);
+          }
+        }
+      }
+      locationLabel.textContent = target.localName + (target.className ? '.' + target.className : '');
+    }
+
+    dialog.addEventListener('click', (event) => {
+      const button = event.target.closest('[data-move-to]');
+      if (!button) return;
+      moveDialog(document.querySelector(button.dataset.moveTo));
+      // Clicking a button in Safari/Firefox may not focus it; keep focus on it.
+      button.focus({ preventScroll: true });
+    });
+  </script>
+
 </body>
 
