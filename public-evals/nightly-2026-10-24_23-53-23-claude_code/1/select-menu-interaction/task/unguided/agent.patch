+  <script>
+    (function () {
+      var form = document.getElementById('order-form');
+      var shop = document.getElementById('shop');
+      var error = document.getElementById('shop-error');
+      var touched = false;
+
+      // Errors only show once the user has interacted or tried to submit.
+      function validate() {
+        var invalid = !shop.value;
+        var show = invalid && touched;
+        error.hidden = !show;
+        shop.setAttribute('aria-invalid', show ? 'true' : 'false');
+        return !invalid;
+      }
+
+      shop.addEventListener('blur', function () { touched = true; validate(); });
+      shop.addEventListener('change', function () { touched = true; validate(); });
+
+      form.addEventListener('submit', function (e) {
+        touched = true;
+        if (!validate()) {
+          e.preventDefault();
+          shop.focus();
+        }
+      });
+    })();
+  </script>
