+  <script>
+    (() => {
+      const panel = document.querySelector('.seasonal-panel');
+      const links = [...document.querySelectorAll('.toc-sidebar a')];
+      const sections = [...panel.querySelectorAll('.drink-section')];
+
+      const setCurrent = (id) => {
+        links.forEach((link) => {
+          if (link.getAttribute('href') === '#' + id) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      };
+
+      // Smoothly scroll only the panel (not the page) to the clicked section
+      links.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const target = document.getElementById(link.getAttribute('href').slice(1));
+          if (!target) return;
+          event.preventDefault();
+          panel.scrollTo({ top: target.offsetTop });
+          setCurrent(target.id);
+          history.replaceState(null, '', link.getAttribute('href'));
+        });
+      });
+
+      if ('onscrollsnapchange' in HTMLElement.prototype) {
+        panel.addEventListener('scrollsnapchange', (event) => {
+          const section = event.snapTargetBlock?.closest('.drink-section');
+          if (section) setCurrent(section.id);
+        });
+      } else {
+        // Fallback: highlight the section whose top is nearest the panel's top
+        const update = () => {
+          const top = panel.scrollTop;
+          const current = sections.reduce((best, s) =>
+            Math.abs(s.offsetTop - top) < Math.abs(best.offsetTop - top) ? s : best);
+          setCurrent(current.id);
+        };
+        panel.addEventListener('scroll', update, { passive: true });
+      }
+    })();
+  </script>
