+  <script>
+    (function () {
+      var panel = document.querySelector('.seasonal-panel');
+      var links = Array.prototype.slice.call(document.querySelectorAll('.toc-sidebar a'));
+      var sections = Array.prototype.slice.call(panel.querySelectorAll('.drink-section'));
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      function setActive(id) {
+        links.forEach(function (link) {
+          if (link.getAttribute('href') === '#' + id) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+        sections.forEach(function (section) {
+          if (section.id === id) {
+            section.setAttribute('aria-current', 'true');
+          } else {
+            section.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (entry.isIntersecting) setActive(entry.target.id);
+        });
+      }, { root: panel, threshold: 0.6 });
+      sections.forEach(function (section) { observer.observe(section); });
+      setActive(sections[0].id);
+
+      links.forEach(function (link) {
+        link.addEventListener('click', function (event) {
+          var target = document.getElementById(link.getAttribute('href').slice(1));
+          if (!target) return;
+          event.preventDefault();
+          panel.scrollTo({
+            top: target.offsetTop - panel.offsetTop,
+            behavior: reduceMotion.matches ? 'auto' : 'smooth'
+          });
+          history.replaceState(null, '', '#' + target.id);
+        });
+      });
+    })();
+  </script>
+
