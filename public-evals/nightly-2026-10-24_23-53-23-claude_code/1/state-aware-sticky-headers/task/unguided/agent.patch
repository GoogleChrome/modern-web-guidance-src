+  <script>
+    // Toggle .is-stuck on sticky headers once they pin beneath the nav
+    (function () {
+      var headers = document.querySelectorAll('.sticky-header');
+      var navHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-height')) || 0;
+
+      function update() {
+        headers.forEach(function (h) {
+          // Stuck once its container's top has scrolled up to the nav's bottom edge
+          h.classList.toggle('is-stuck', h.parentElement.getBoundingClientRect().top <= navHeight);
+        });
+      }
+
+      window.addEventListener('scroll', update, { passive: true });
+      window.addEventListener('resize', update);
+      update();
+    })();
+  </script>
