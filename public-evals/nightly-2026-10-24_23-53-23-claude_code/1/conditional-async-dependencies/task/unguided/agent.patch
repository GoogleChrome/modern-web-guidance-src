+  <script type="module">
+    // Load the Popover API polyfill only where unsupported. Top-level await
+    // in a module delays the code below, so no cross-script orchestration is needed.
+    if (!HTMLElement.prototype.hasOwnProperty('popover')) {
+      await import('https://cdn.jsdelivr.net/npm/@oddbird/popover-polyfill@0.5/dist/popover.min.js');
+    }
+
+    // Dependent code: runs only after the polyfill (if needed) has loaded.
+    const rewards = document.getElementById('rewards-popover');
+    rewards.addEventListener('toggle', (e) => {
+      document.querySelector('[popovertarget="rewards-popover"]')
+        .setAttribute('aria-expanded', e.newState === 'open');
+    });
+  </script>
