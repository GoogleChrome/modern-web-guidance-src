+  <script>
+    (function () {
+      var THRESHOLD = 0.4; // fraction of item width that triggers removal
+      var list = document.querySelector('.SwipeableList');
+      var empty = document.querySelector('.cart-empty');
+
+      function collapse(item) {
+        item.style.height = item.offsetHeight + 'px';
+        item.offsetHeight; // force reflow so the height transition starts from here
+        item.classList.add('is-removing');
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          item.remove();
+          empty.hidden = list.children.length > 0;
+        }
+        item.addEventListener('transitionend', function (e) {
+          if (e.propertyName === 'height') finish();
+        });
+        setTimeout(finish, 600); // fallback if transitionend never fires
+      }
+
+      function setup(item) {
+        var track = item.querySelector('.SwipeableList-track');
+        var startX = 0, startY = 0, dx = 0, pointerId = null, dragging = false;
+
+        track.addEventListener('pointerdown', function (e) {
+          if (pointerId !== null || (e.pointerType === 'mouse' && e.button !== 0)) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          dx = 0;
+          dragging = false;
+        });
+
+        track.addEventListener('pointermove', function (e) {
+          if (e.pointerId !== pointerId) return;
+          var mx = e.clientX - startX;
+          if (!dragging) {
+            if (Math.abs(mx) < 6 || Math.abs(mx) < Math.abs(e.clientY - startY)) return;
+            dragging = true;
+            track.setPointerCapture(pointerId);
+            track.classList.add('is-dragging');
+            item.classList.add('is-swiping');
+          }
+          dx = mx;
+          track.style.transform = 'translateX(' + dx + 'px)';
+          item.classList.toggle('is-armed', Math.abs(dx) > item.offsetWidth * THRESHOLD);
+        });
+
+        function end(e) {
+          if (e.pointerId !== pointerId) return;
+          pointerId = null;
+          if (!dragging) return;
+          dragging = false;
+          track.classList.remove('is-dragging');
+          if (e.type !== 'pointercancel' && Math.abs(dx) > item.offsetWidth * THRESHOLD) {
+            track.style.transform = 'translateX(' + (dx < 0 ? '-100%' : '100%') + ')';
+            collapse(item);
+          } else {
+            track.style.transform = '';
+            item.classList.remove('is-swiping', 'is-armed');
+          }
+        }
+        track.addEventListener('pointerup', end);
+        track.addEventListener('pointercancel', end);
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(setup);
+    })();
+  </script>
