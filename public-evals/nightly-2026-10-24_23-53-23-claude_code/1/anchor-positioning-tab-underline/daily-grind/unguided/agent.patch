+  <script>
+    (function () {
+      var list = document.querySelector('nav ul');
+      var indicator = list.querySelector('.nav-indicator');
+      var links = Array.prototype.slice.call(list.querySelectorAll('a[data-nav]'));
+      var current = null;
+
+      function moveTo(link) {
+        var l = link.getBoundingClientRect();
+        var u = list.getBoundingClientRect();
+        indicator.style.width = l.width + 'px';
+        indicator.style.transform = 'translateX(' + (l.left - u.left) + 'px)';
+        indicator.style.opacity = '1';
+      }
+
+      function select(link) {
+        links.forEach(function (a) {
+          a.classList.toggle('active', a === link);
+          if (a === link) a.setAttribute('aria-current', 'page');
+          else a.removeAttribute('aria-current');
+        });
+        current = link;
+        moveTo(link);
+      }
+
+      links.forEach(function (a) {
+        a.addEventListener('click', function (e) {
+          e.preventDefault(); // keep the page loaded so the slide is visible
+          select(a);
+        });
+      });
+
+      window.addEventListener('resize', function () {
+        if (current) {
+          indicator.style.transition = 'none';
+          moveTo(current);
+          indicator.offsetWidth; // flush so the next move animates again
+          indicator.style.transition = '';
+        }
+      });
+
+      // Initial selection from the current path, if it matches a nav item.
+      var initial = links.filter(function (a) {
+        return a.getAttribute('href') === location.pathname;
+      })[0];
+      if (initial) {
+        indicator.style.transition = 'none';
+        select(initial);
+        indicator.offsetWidth;
+        indicator.style.transition = '';
+      }
+    })();
+  </script>
+
 </body>
 
