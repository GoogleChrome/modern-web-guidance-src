     nav ul {
       display: flex;
       list-style: none;
+      position: relative;
+    }
+
+    /* Active indicator: tethered to the active item, slides between items */
+    nav ul::before {
+      content: '';
+      position: absolute;
+      position-anchor: --active;
+      inset-block-start: calc(anchor(bottom) + 0.1lh);
+      inset-inline-start: anchor(left);
+      inset-inline-end: anchor(right);
+      block-size: 0.15lh;
+      background: var(--accent);
+      border-radius: 2px;
+
+      @media (prefers-reduced-motion: no-preference) {
+        transition: inset 0.3s ease;
+      }
+    }
+
+    nav ul li.active {
+      anchor-name: --active;
+    }
+
+    @supports not (position-anchor: auto) {
+      nav ul::before {
+        display: none;
+      }
+
+      nav ul li.active a {
+        border-bottom: 0.15lh solid var(--accent);
+      }
     }
 
