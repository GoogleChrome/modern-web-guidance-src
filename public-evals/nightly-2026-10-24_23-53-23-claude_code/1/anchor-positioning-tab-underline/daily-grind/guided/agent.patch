+  <script>
+    // Move the active indicator when a nav item is selected
+    const navItems = document.querySelectorAll('nav ul li:not(:has(.logout-link))');
+    navItems.forEach((li) => {
+      li.addEventListener('click', (e) => {
+        e.preventDefault();
+        navItems.forEach((item) => {
+          item.classList.toggle('active', item === li);
+          const a = item.querySelector('a');
+          if (item === li) a.setAttribute('aria-current', 'page');
+          else a.removeAttribute('aria-current');
+        });
+      });
+    });
+  </script>
