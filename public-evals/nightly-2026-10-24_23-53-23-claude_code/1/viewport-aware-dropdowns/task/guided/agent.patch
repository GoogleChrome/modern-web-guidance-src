+    /* Options dropdown */
+    #trigger-btn {
+      anchor-name: --options-trigger;
+      background: transparent;
+      color: white;
+      font: inherit;
+      font-size: 0.9rem;
+      border: 1px solid var(--secondary);
+      padding: 5px 12px;
+      border-radius: 4px;
+      cursor: pointer;
+      transition: color 0.3s, border-color 0.3s;
+    }
+
+    #trigger-btn:hover,
+    #trigger-btn:focus-visible {
+      color: var(--accent);
+      border-color: var(--accent);
+    }
+
+    #action-panel {
+      position-anchor: --options-trigger;
+      margin: 0;
+      inset: auto;
+      /* Below the trigger, aligned to its left (inline-start) edge */
+      position-area: block-end span-inline-end;
+      /* Flip vertically, horizontally, or both on viewport collision */
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      min-width: 12rem;
+      padding: 0.5rem;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+      color: var(--text);
+      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
+    }
+
+    #action-panel:is(:popover-open, .\:popover-open) {
+      display: flex;
+      flex-direction: column;
+      gap: 2px;
+    }
+
+    /* Browsers without position-area: fall back to anchor() insets (used by the polyfill) */
+    @supports not (position-area: block-end) {
+      #action-panel {
+        top: anchor(bottom);
+        left: anchor(left);
+      }
+    }
+
+    .action-item {
+      font: inherit;
+      font-size: 0.9rem;
+      text-align: left;
+      background: none;
+      color: inherit;
+      border: 0;
+      padding: 8px 12px;
+      border-radius: 4px;
+      cursor: pointer;
+    }
+
+    .action-item:hover,
+    .action-item:focus-visible {
+      background: var(--secondary);
+    }
+
