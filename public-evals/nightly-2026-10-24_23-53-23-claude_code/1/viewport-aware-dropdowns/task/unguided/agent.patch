+  <script>
+    (function () {
+      var trigger = document.getElementById('trigger-btn');
+      var panel = document.getElementById('action-panel');
+
+      // Keep aria-expanded in sync and close after an action is chosen
+      panel.addEventListener('toggle', function (e) {
+        trigger.setAttribute('aria-expanded', String(e.newState === 'open'));
+      });
+      panel.addEventListener('click', function (e) {
+        if (e.target.closest('button')) panel.hidePopover();
+      });
+
+      // Fallback for browsers without CSS anchor positioning: place below the
+      // trigger, left-aligned, flipping when it would leave the viewport.
+      if (!CSS.supports('anchor-name', '--a')) {
+        var place = function () {
+          var t = trigger.getBoundingClientRect();
+          var p = panel.getBoundingClientRect();
+          var vw = document.documentElement.clientWidth;
+          var vh = document.documentElement.clientHeight;
+          var top = t.bottom + 4;
+          if (top + p.height > vh && t.top - 4 - p.height >= 0) top = t.top - 4 - p.height;
+          var left = t.left;
+          if (left + p.width > vw && t.right - p.width >= 0) left = t.right - p.width;
+          panel.style.inset = 'auto';
+          panel.style.margin = '0';
+          panel.style.top = Math.max(0, top) + 'px';
+          panel.style.left = Math.max(0, left) + 'px';
+        };
+        panel.addEventListener('toggle', function (e) {
+          if (e.newState === 'open') place();
+        });
+        window.addEventListener('resize', function () {
+          if (panel.matches(':popover-open')) place();
+        });
+      }
+    })();
+  </script>
