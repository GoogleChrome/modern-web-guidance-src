@@ -0,0 +1,311 @@
+import type { APIRoute } from 'astro';
+import {
+  generateAuthenticationOptions,
+  generateRegistrationOptions,
+  verifyAuthenticationResponse,
+  verifyRegistrationResponse,
+} from '@simplewebauthn/server';
+import {
+  createUser,
+  describeAuthenticator,
+  findPasskey,
+  findUserByUsername,
+  persist,
+  type StoredPasskey,
+  type StoredUser,
+} from '../../../lib/auth-store';
+import {
+  currentUser,
+  json,
+  publicUser,
+  recentlyReauthenticated,
+  rpConfig,
+  signIn,
+} from '../../../lib/http';
+
+type Ceremony = {
+  type: 'signup' | 'register' | 'login' | 'reauth';
+  challenge: string;
+  userVerification: 'preferred' | 'required';
+  conditional?: boolean;
+  username?: string;
+};
+
+const CEREMONY_TTL_MS = 5 * 60 * 1000;
+const USERNAME_PATTERN = /^[\w.@+-]{3,40}$/;
+
+const readBody = (request: Request) => request.json().catch(() => ({}));
+
+const toStoredPasskey = (p: StoredPasskey) => ({
+  id: p.id,
+  name: p.name,
+  providerIcon: p.providerIcon,
+  credentialDeviceType: p.credentialDeviceType,
+  credentialBackedUp: p.credentialBackedUp,
+  registeredAt: p.registeredAt,
+  lastUsedAt: p.lastUsedAt,
+});
+
+export const GET: APIRoute = async ({ params, session }) => {
+  if (params.path) return json({ error: 'Not found' }, 404);
+  const user = await currentUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  return json({ user: publicUser(user), passkeys: user.passkeys.map(toStoredPasskey) });
+};
+
+export const POST: APIRoute = async ({ params, request, session, url }) => {
+  const { rpID, origin, rpName } = rpConfig(url);
+  const body = await readBody(request);
+  const action = params.path;
+
+  const begin = async (ceremony: Omit<Ceremony, 'challenge'> & { challenge: string }) => {
+    await session?.set('webauthn', { ...ceremony, issuedAt: Date.now() });
+  };
+
+  // Single-use: consumed whether or not verification succeeds.
+  const consume = async (type: Ceremony['type']): Promise<Ceremony | undefined> => {
+    const stored = await session?.get('webauthn');
+    session?.delete('webauthn');
+    if (!stored || stored.type !== type || Date.now() - stored.issuedAt > CEREMONY_TTL_MS) return undefined;
+    return stored;
+  };
+
+  const savePasskey = async (
+    user: StoredUser,
+    info: Awaited<ReturnType<typeof verifyRegistrationResponse>>['registrationInfo'] & {},
+    response: { response: { transports?: string[] } },
+  ) => {
+    const provider = await describeAuthenticator(info.aaguid, request.headers.get('user-agent') || '');
+    const passkey: StoredPasskey = {
+      id: info.credential.id,
+      passkeyUserId: user.id,
+      publicKey: Buffer.from(info.credential.publicKey).toString('base64url'),
+      counter: info.credential.counter,
+      transports: response.response.transports ?? info.credential.transports ?? [],
+      credentialDeviceType: info.credentialDeviceType,
+      credentialBackedUp: info.credentialBackedUp,
+      aaguid: info.aaguid,
+      name: provider.name,
+      providerIcon: provider.providerIcon,
+      registeredAt: Date.now(),
+    };
+    user.passkeys.push(passkey);
+    persist();
+    return passkey;
+  };
+
+  const verifyAssertion = async (ceremony: Ceremony, assertion: any) => {
+    const found = assertion?.id ? findPasskey(assertion.id) : undefined;
+    if (!found) return { status: 404 as const };
+    const { user, passkey } = found;
+    try {
+      const result = await verifyAuthenticationResponse({
+        response: assertion,
+        expectedChallenge: ceremony.challenge,
+        expectedOrigin: origin,
+        expectedRPID: rpID,
+        requireUserVerification: ceremony.userVerification === 'required',
+        credential: {
+          id: passkey.id,
+          publicKey: Buffer.from(passkey.publicKey, 'base64url'),
+          counter: passkey.counter,
+          transports: passkey.transports as any,
+        },
+      });
+      if (!result.verified) return { status: 401 as const };
+      passkey.counter = result.authenticationInfo.newCounter;
+      passkey.credentialBackedUp = result.authenticationInfo.credentialBackedUp;
+      passkey.lastUsedAt = Date.now();
+      persist();
+      return { status: 200 as const, user };
+    } catch (e) {
+      console.error('Assertion verification failed:', e);
+      return { status: 401 as const };
+    }
+  };
+
+  switch (action) {
+    // ---- Sign up with a passkey (no password) ----
+    case 'signup/options': {
+      const username = typeof body.username === 'string' ? body.username.trim() : '';
+      if (!USERNAME_PATTERN.test(username)) {
+        return json({ error: 'Username must be 3–40 characters (letters, numbers, . _ @ + -)' }, 400);
+      }
+      if (findUserByUsername(username)) return json({ error: 'Username is already taken' }, 409);
+      const options = await generateRegistrationOptions({
+        rpName,
+        rpID,
+        userName: username,
+        userDisplayName: username,
+        attestationType: 'none',
+        authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'preferred' },
+        supportedAlgorithmIDs: [-7, -257],
+      });
+      await begin({ type: 'signup', challenge: options.challenge, userVerification: 'preferred', username });
+      // The user handle is generated here but only becomes an account on verification.
+      await session?.set('signupUserId', options.user.id);
+      return json(options);
+    }
+
+    case 'signup/verify': {
+      const ceremony = await consume('signup');
+      const userId = await session?.get('signupUserId');
+      session?.delete('signupUserId');
+      if (!ceremony?.username || !userId) return json({ error: 'Registration expired. Please try again.' }, 400);
+      if (findUserByUsername(ceremony.username)) return json({ error: 'Username is already taken' }, 409);
+      try {
+        const result = await verifyRegistrationResponse({
+          response: body,
+          expectedChallenge: ceremony.challenge,
+          expectedOrigin: origin,
+          expectedRPID: rpID,
+          requireUserVerification: false,
+        });
+        if (!result.verified) return json({ error: 'Could not verify passkey' }, 400);
+        // Reuse the user handle the authenticator stored in the passkey.
+        const user = createUser(ceremony.username, false, userId);
+        await savePasskey(user, result.registrationInfo, body);
+        await signIn(session, user);
+        return json({ user: publicUser(user) });
+      } catch (e) {
+        console.error('Signup verification failed:', e);
+        return json({ error: 'Could not verify passkey' }, 400);
+      }
+    }
+
+    // ---- Register a passkey for the signed-in user ----
+    case 'register/options': {
+      const user = await currentUser(session);
+      if (!user) return json({ error: 'Not signed in' }, 401);
+      const promotion = body.promotion === true || body.conditional === true;
+      const options = await generateRegistrationOptions({
+        rpName,
+        rpID,
+        userName: user.username,
+        userDisplayName: user.displayName,
+        userID: Buffer.from(user.id, 'base64url'),
+        attestationType: 'none',
+        excludeCredentials: user.passkeys.map((p) => ({ id: p.id, transports: p.transports as any })),
+        authenticatorSelection: {
+          residentKey: 'required',
+          requireResidentKey: true,
+          userVerification: 'preferred',
+          ...(promotion && { authenticatorAttachment: 'platform' as const }),
+        },
+        supportedAlgorithmIDs: [-7, -257],
+      });
+      await begin({
+        type: 'register',
+        challenge: options.challenge,
+        userVerification: 'preferred',
+        conditional: body.conditional === true,
+      });
+      return json(options);
+    }
+
+    case 'register/verify': {
+      const user = await currentUser(session);
+      const ceremony = await consume('register');
+      if (!user) return json({ error: 'Not signed in' }, 401);
+      if (!ceremony) return json({ error: 'Registration expired. Please try again.' }, 400);
+      try {
+        const result = await verifyRegistrationResponse({
+          response: body,
+          expectedChallenge: ceremony.challenge,
+          expectedOrigin: origin,
+          expectedRPID: rpID,
+          requireUserVerification: false,
+          // Presence is only relaxed for silent conditional-create.
+          requireUserPresence: !ceremony.conditional,
+        });
+        if (!result.verified) return json({ error: 'Could not verify passkey' }, 400);
+        if (findPasskey(result.registrationInfo.credential.id)) {
+          return json({ error: 'This passkey is already registered' }, 409);
+        }
+        const passkey = await savePasskey(user, result.registrationInfo, body);
+        return json({ passkey: toStoredPasskey(passkey), passkeys: user.passkeys.map(toStoredPasskey) });
+      } catch (e) {
+        console.error('Registration verification failed:', e);
+        return json({ error: 'Could not verify passkey' }, 400);
+      }
+    }
+
+    // ---- Primary sign-in ----
+    case 'login/options': {
+      const options = await generateAuthenticationOptions({ rpID, allowCredentials: [], userVerification: 'preferred' });
+      await begin({ type: 'login', challenge: options.challenge, userVerification: 'preferred' });
+      return json(options);
+    }
+
+    case 'login/verify': {
+      const ceremony = await consume('login');
+      if (!ceremony) return json({ error: 'Sign-in expired. Please try again.' }, 400);
+      const result = await verifyAssertion(ceremony, body);
+      if (result.status === 404) return json({ error: 'Passkey not recognized' }, 404);
+      if (result.status !== 200) return json({ error: 'Passkey verification failed' }, 401);
+      await signIn(session, result.user);
+      return json({ user: publicUser(result.user) });
+    }
+
+    // ---- Reauthentication for sensitive actions ----
+    case 'reauth/options': {
+      const user = await currentUser(session);
+      if (!user) return json({ error: 'Not signed in' }, 401);
+      if (!user.passkeys.length) return json({ error: 'No passkeys registered' }, 400);
+      const options = await generateAuthenticationOptions({
+        rpID,
+        userVerification: 'preferred',
+        allowCredentials: user.passkeys.map((p) => ({ id: p.id, transports: p.transports as any })),
+      });
+      await begin({ type: 'reauth', challenge: options.challenge, userVerification: 'preferred' });
+      return json(options);
+    }
+
+    case 'reauth/verify': {
+      const user = await currentUser(session);
+      const ceremony = await consume('reauth');
+      if (!user) return json({ error: 'Not signed in' }, 401);
+      if (!ceremony) return json({ error: 'Verification expired. Please try again.' }, 400);
+      const result = await verifyAssertion(ceremony, body);
+      if (result.status === 404) return json({ error: 'Passkey not recognized' }, 404);
+      if (result.status !== 200) return json({ error: 'Passkey verification failed' }, 401);
+      if (result.user.id !== user.id) return json({ error: 'Passkey belongs to a different account' }, 403);
+      await session?.set('reauthAt', Date.now());
+      return json({ success: true });
+    }
+
+    default:
+      return json({ error: 'Not found' }, 404);
+  }
+};
+
+const credentialRoute: APIRoute = async ({ params, request, session }) => {
+  const match = /^credential\/([\w-]+)$/.exec(params.path ?? '');
+  if (!match) return json({ error: 'Not found' }, 404);
+  const user = await currentUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  const passkey = user.passkeys.find((p) => p.id === match[1]);
+  if (!passkey) return json({ error: 'Credential not found.' }, 404);
+
+  if (request.method === 'PUT') {
+    const { name } = await readBody(request);
+    if (typeof name !== 'string' || !name.trim() || name.length > 60) {
+      return json({ error: 'Name must be 1–60 characters' }, 400);
+    }
+    passkey.name = name.trim();
+    persist();
+    return json({ passkey: toStoredPasskey(passkey) });
+  }
+
+  // DELETE is sensitive: require a recent reauthentication.
+  if (!(await recentlyReauthenticated(session))) return json({ error: 'reauth_required' }, 403);
+  if (!user.hasPassword && user.passkeys.length === 1) {
+    return json({ error: 'You cannot remove the only way to sign in to this account.' }, 409);
+  }
+  user.passkeys = user.passkeys.filter((p) => p.id !== passkey.id);
+  persist();
+  return json({ passkeys: user.passkeys.map(toStoredPasskey) });
+};
+
+export const PUT = credentialRoute;
+export const DELETE = credentialRoute;
