index 0000000..04e1840
--- /dev/null
+++ b/src/pages/api/auth/[...path].ts
@@ -0,0 +1,82 @@
+import type { APIRoute } from 'astro';
+import { createUser, findUserByUsername, persist } from '../../../lib/auth-store';
+import {
+  backendPost,
+  currentUser,
+  json,
+  publicUser,
+  recentlyReauthenticated,
+  signIn,
+} from '../../../lib/http';
+
+const readBody = (request: Request) => request.json().catch(() => ({}));
+
+export const GET: APIRoute = async ({ params, session }) => {
+  if (params.path !== 'me') return json({ error: 'Not found' }, 404);
+  const user = await currentUser(session);
+  return json({ user: user ? publicUser(user) : null, reauthenticated: await recentlyReauthenticated(session) });
+};
+
+export const POST: APIRoute = async ({ params, request, session }) => {
+  const body = await readBody(request);
+
+  switch (params.path) {
+    case 'login': {
+      const { username, password } = body;
+      if (typeof username !== 'string' || typeof password !== 'string') {
+        return json({ error: 'Username and password are required' }, 400);
+      }
+      const { ok, data } = await backendPost('login', { username, password });
+      if (!ok) return json({ error: data.error || 'Unknown error' }, 401);
+      const user = findUserByUsername(username) ?? createUser(username, true);
+      if (!user.hasPassword) {
+        user.hasPassword = true;
+        persist();
+      }
+      await signIn(session, user);
+      return json({ user: publicUser(user) });
+    }
+
+    case 'register': {
+      const { username, password } = body;
+      if (typeof username !== 'string' || typeof password !== 'string') {
+        return json({ error: 'Username and password are required' }, 400);
+      }
+      const { ok, data } = await backendPost('register', { username, password });
+      if (!ok) return json({ error: data.error || 'Unknown error' }, 400);
+      if (!findUserByUsername(username)) createUser(username, true);
+      return json({ success: true });
+    }
+
+    case 'logout': {
+      session?.destroy();
+      return json({ success: true });
+    }
+
+    case 'reauth-password': {
+      const user = await currentUser(session);
+      if (!user) return json({ error: 'Not signed in' }, 401);
+      if (typeof body.password !== 'string') return json({ error: 'Password is required' }, 400);
+      const { ok } = await backendPost('login', { username: user.username, password: body.password });
+      if (!ok) return json({ error: 'Incorrect password' }, 401);
+      await session?.set('reauthAt', Date.now());
+      return json({ success: true });
+    }
+
+    default:
+      return json({ error: 'Not found' }, 404);
+  }
+};
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  if (params.path !== 'user') return json({ error: 'Not found' }, 404);
+  const user = await currentUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+  const { displayName } = await readBody(request);
+  if (typeof displayName !== 'string' || !displayName.trim() || displayName.length > 80) {
+    return json({ error: 'Display name must be 1–80 characters' }, 400);
+  }
+  user.displayName = displayName.trim();
+  persist();
+  return json({ user: publicUser(user) });
+};
