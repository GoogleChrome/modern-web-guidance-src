diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..1407bb7
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,337 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import {
+  api,
+  passkeysSupported,
+  reauthenticateWithPasskey,
+  registerPasskey,
+  signalAcceptedCredentials,
+  signalUserDetails,
+  type AccountUser,
+  type PasskeyInfo,
+} from '../lib/passkey-client';
+
+const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
+
+const formatDate = (epoch?: number) =>
+  epoch ? new Date(epoch).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : null;
+
+const buttonClass =
+  'py-1.5 px-3 border border-gray-300 rounded-md text-sm font-medium text-gray-900 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 disabled:opacity-75';
+const primaryButtonClass =
+  'py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75';
+
+export default function AccountSettings() {
+  const [user, setUser] = useState<AccountUser | null>(null);
+  const [passkeys, setPasskeys] = useState<PasskeyInfo[]>([]);
+  const [loaded, setLoaded] = useState(false);
+  const [canCreate, setCanCreate] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [renamingId, setRenamingId] = useState<string | null>(null);
+  const [renameValue, setRenameValue] = useState('');
+  const [displayName, setDisplayName] = useState('');
+  const [reauthPassword, setReauthPassword] = useState('');
+  const [reauthError, setReauthError] = useState<string | null>(null);
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const pendingAction = useRef<(() => Promise<void>) | null>(null);
+
+  const load = useCallback(async () => {
+    const { ok, data } = await api('passkeys');
+    setLoaded(true);
+    if (!ok) return;
+    setUser(data.user);
+    setDisplayName(data.user.displayName);
+    setPasskeys(data.passkeys);
+    // Keep the user's password manager in sync with the server on every load.
+    signalAcceptedCredentials(data.user.id, data.passkeys);
+    signalUserDetails(data.user);
+  }, []);
+
+  useEffect(() => {
+    load();
+    passkeysSupported().then(setCanCreate);
+  }, [load]);
+
+  const updatePasskeys = (next: PasskeyInfo[]) => {
+    setPasskeys(next);
+    setUser((u) => (u ? { ...u, passkeyCount: next.length } : u));
+  };
+
+  const handleCreate = async () => {
+    setError(null);
+    setNotice(null);
+    setBusy(true);
+    // Management flow: no authenticatorAttachment, so security keys are allowed too.
+    const result = await registerPasskey({ promotion: false });
+    setBusy(false);
+    if (result.ok) {
+      const next = (result.data as { passkeys: PasskeyInfo[] }).passkeys;
+      updatePasskeys(next);
+      setNotice('Passkey created.');
+    } else if (!result.cancelled) setError(result.error);
+  };
+
+  const handleRename = async (id: string) => {
+    setError(null);
+    const { ok, data } = await api(`passkeys/credential/${id}`, { method: 'PUT', body: { name: renameValue } });
+    if (!ok) return setError(data.error || 'Could not rename passkey');
+    setPasskeys((list) => list.map((p) => (p.id === id ? { ...p, name: data.passkey.name } : p)));
+    setRenamingId(null);
+  };
+
+  const handleDisplayName = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setNotice(null);
+    const { ok, data } = await api('auth/user', { method: 'PUT', body: { displayName } });
+    if (!ok) return setError(data.error || 'Could not update account');
+    setUser(data.user);
+    setNotice('Account updated.');
+    await signalUserDetails(data.user);
+  };
+
+  const performDelete = async (id: string) => {
+    const { ok, status, data } = await api(`passkeys/credential/${id}`, { method: 'DELETE' });
+    if (status === 403 && data.error === 'reauth_required') {
+      // Sensitive action: verify identity, then retry.
+      pendingAction.current = () => performDelete(id);
+      setReauthError(null);
+      setReauthPassword('');
+      dialogRef.current?.showModal();
+      return;
+    }
+    if (!ok) return setError(data.error || 'Could not delete passkey');
+    updatePasskeys(data.passkeys);
+    setNotice('Passkey deleted.');
+    if (user) await signalAcceptedCredentials(user.id, data.passkeys);
+  };
+
+  const handleDelete = (p: PasskeyInfo) => {
+    if (!window.confirm(`Delete the passkey "${p.name}"? You won't be able to use it to sign in again.`)) return;
+    setError(null);
+    setNotice(null);
+    return performDelete(p.id);
+  };
+
+  const finishReauth = async () => {
+    dialogRef.current?.close();
+    const action = pendingAction.current;
+    pendingAction.current = null;
+    await action?.();
+  };
+
+  const reauthWithPasskey = async () => {
+    setReauthError(null);
+    const result = await reauthenticateWithPasskey();
+    if (result.ok) await finishReauth();
+    else if (!result.cancelled) setReauthError(result.error);
+  };
+
+  const reauthWithPassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setReauthError(null);
+    const { ok, data } = await api('auth/reauth-password', { body: { password: reauthPassword } });
+    if (ok) await finishReauth();
+    else setReauthError(data.error || 'Could not verify password');
+  };
+
+  const handleSignOut = async () => {
+    await api('auth/logout', { body: {} });
+    window.location.assign(`${baseUrl}signin`);
+  };
+
+  if (!loaded) return <p className="text-center text-gray-600 mt-10">Loading…</p>;
+
+  if (!user) {
+    return (
+      <div className="max-w-md mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm text-center">
+        <h2 className="text-2xl font-bold mb-3 text-gray-800">Account settings</h2>
+        <p className="text-sm text-gray-600 mb-4">Sign in to manage your account and passkeys.</p>
+        <a href={`${baseUrl}signin`} className={`${primaryButtonClass} inline-block`}>
+          Sign in
+        </a>
+      </div>
+    );
+  }
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-6">
+      <div className="flex items-center justify-between">
+        <h2 className="text-2xl font-bold text-gray-800">Account settings</h2>
+        <button type="button" onClick={handleSignOut} className={buttonClass}>
+          Sign out
+        </button>
+      </div>
+
+      <div aria-live="polite">
+        {error && (
+          <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+        {notice && <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg">{notice}</div>}
+      </div>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h3 className="text-lg font-semibold text-gray-800 mb-4">Profile</h3>
+        <form onSubmit={handleDisplayName} className="space-y-4">
+          <div>
+            <span className="block text-sm font-medium text-gray-700 mb-1">Username</span>
+            <p className="text-sm text-gray-900">{user.username}</p>
+          </div>
+          <div>
+            <label htmlFor="displayName" className="block text-sm font-medium text-gray-700 mb-1">
+              Display name
+            </label>
+            <input
+              id="displayName"
+              type="text"
+              value={displayName}
+              maxLength={80}
+              required
+              onChange={(e) => setDisplayName(e.target.value)}
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+          </div>
+          <button type="submit" className={primaryButtonClass}>
+            Save
+          </button>
+        </form>
+      </section>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex items-start justify-between gap-4 mb-4">
+          <div>
+            <h3 className="text-lg font-semibold text-gray-800">Passkeys</h3>
+            <p className="text-sm text-gray-600">
+              Passkeys let you sign in with your fingerprint, face, or screen lock instead of a password.
+            </p>
+          </div>
+          {canCreate && (
+            <button type="button" onClick={handleCreate} disabled={busy} className={`${primaryButtonClass} shrink-0`}>
+              Create a passkey
+            </button>
+          )}
+        </div>
+
+        {!canCreate && (
+          <p className="text-sm text-gray-600 mb-4">This browser or device doesn't support creating passkeys.</p>
+        )}
+
+        {passkeys.length === 0 ? (
+          <p className="text-sm text-gray-600">No passkeys found.</p>
+        ) : (
+          <ul className="divide-y divide-gray-200">
+            {passkeys.map((p) => (
+              <li key={p.id} className="py-4 flex flex-wrap items-center gap-4">
+                {p.providerIcon ? (
+                  <img src={p.providerIcon} alt="" width={32} height={32} className="rounded" />
+                ) : (
+                  <span className="w-8 h-8 rounded bg-gray-200" aria-hidden="true" />
+                )}
+                <div className="flex-1 min-w-48">
+                  {renamingId === p.id ? (
+                    <form
+                      onSubmit={(e) => {
+                        e.preventDefault();
+                        handleRename(p.id);
+                      }}
+                      className="flex gap-2"
+                    >
+                      <label className="sr-only" htmlFor={`rename-${p.id}`}>
+                        Passkey name
+                      </label>
+                      <input
+                        id={`rename-${p.id}`}
+                        value={renameValue}
+                        maxLength={60}
+                        required
+                        autoFocus
+                        onChange={(e) => setRenameValue(e.target.value)}
+                        className="flex-1 px-2 py-1 border border-gray-300 rounded-md"
+                      />
+                      <button type="submit" className={buttonClass}>
+                        Save
+                      </button>
+                      <button type="button" onClick={() => setRenamingId(null)} className={buttonClass}>
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <>
+                      <p className="text-sm font-medium text-gray-900">{p.name}</p>
+                      <p className="text-xs text-gray-500">
+                        Created {formatDate(p.registeredAt)}
+                        {p.lastUsedAt ? ` · Last used ${formatDate(p.lastUsedAt)}` : ' · Never used'}
+                      </p>
+                    </>
+                  )}
+                </div>
+                {renamingId !== p.id && (
+                  <div className="flex gap-2">
+                    <button
+                      type="button"
+                      className={buttonClass}
+                      onClick={() => {
+                        setRenamingId(p.id);
+                        setRenameValue(p.name);
+                      }}
+                    >
+                      Rename<span className="sr-only"> {p.name}</span>
+                    </button>
+                    <button type="button" className={buttonClass} onClick={() => handleDelete(p)}>
+                      Delete<span className="sr-only"> {p.name}</span>
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      <dialog
+        ref={dialogRef}
+        closedby="any"
+        onClose={() => (pendingAction.current = null)}
+        className="m-auto p-6 w-full max-w-sm rounded-lg shadow-lg backdrop:bg-black/40"
+      >
+        <h3 className="text-lg font-semibold text-gray-800 mb-1">Confirm it's you</h3>
+        <p className="text-sm text-gray-600 mb-4">Please verify your identity to continue.</p>
+        {reauthError && (
+          <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {reauthError}
+          </div>
+        )}
+        {passkeys.length > 0 && (
+          <button type="button" onClick={reauthWithPasskey} className={`${primaryButtonClass} w-full mb-4`}>
+            Verify with a passkey
+          </button>
+        )}
+        {user.hasPassword && (
+          <form onSubmit={reauthWithPassword} className="space-y-3">
+            <label htmlFor="reauth-password" className="block text-sm font-medium text-gray-700">
+              Password
+            </label>
+            <input
+              id="reauth-password"
+              type="password"
+              autoComplete="current-password"
+              value={reauthPassword}
+              required
+              onChange={(e) => setReauthPassword(e.target.value)}
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+            <button type="submit" className={`${buttonClass} w-full`}>
+              Verify with password
+            </button>
+          </form>
+        )}
+        <button type="button" onClick={() => dialogRef.current?.close()} className="mt-4 text-sm underline text-gray-600">
+          Cancel
+        </button>
+      </dialog>
+    </div>
+  );
+}
