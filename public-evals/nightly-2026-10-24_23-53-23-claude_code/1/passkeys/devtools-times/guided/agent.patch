diff --git a/src/lib/auth-store.ts b/src/lib/auth-store.ts
new file mode 100644
index 0000000..d17ffa1
--- /dev/null
+++ b/src/lib/auth-store.ts
@@ -0,0 +1,112 @@
+import { mkdirSync, existsSync, readFileSync, writeFileSync, renameSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+export interface StoredPasskey {
+  id: string; // Base64URL credential ID
+  passkeyUserId: string;
+  publicKey: string; // Base64URL public key
+  counter: number;
+  transports: string[];
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  name: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export interface StoredUser {
+  id: string; // Base64URL user handle
+  username: string;
+  displayName: string;
+  hasPassword: boolean;
+  passkeys: StoredPasskey[];
+}
+
+const FILE = resolve(process.env.AUTH_STORE_PATH || 'data/auth-store.json');
+
+let users: Record<string, StoredUser> | null = null;
+
+function load() {
+  if (users) return users;
+  users = existsSync(FILE) ? JSON.parse(readFileSync(FILE, 'utf8')) : {};
+  return users!;
+}
+
+function save() {
+  mkdirSync(dirname(FILE), { recursive: true });
+  const tmp = `${FILE}.tmp`;
+  writeFileSync(tmp, JSON.stringify(users));
+  renameSync(tmp, FILE);
+}
+
+export const normalizeUsername = (username: string) => username.trim();
+
+export function findUserById(id: string) {
+  return load()[id];
+}
+
+export function findUserByUsername(username: string) {
+  const name = normalizeUsername(username).toLowerCase();
+  return Object.values(load()).find((u) => u.username.toLowerCase() === name);
+}
+
+export function findPasskey(credentialId: string) {
+  for (const user of Object.values(load())) {
+    const passkey = user.passkeys.find((p) => p.id === credentialId);
+    if (passkey) return { user, passkey };
+  }
+  return undefined;
+}
+
+export function createUser(username: string, hasPassword: boolean, id = randomBytes(32).toString('base64url')): StoredUser {
+  const user: StoredUser = {
+    id,
+    username: normalizeUsername(username),
+    displayName: normalizeUsername(username),
+    hasPassword,
+    passkeys: [],
+  };
+  load()[user.id] = user;
+  save();
+  return user;
+}
+
+/** Persists any in-place mutation of a user returned from this store. */
+export function persist() {
+  save();
+}
+
+// AAGUID registry, used only as a UX hint for naming passkeys.
+const AAGUID_REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+let registry: Promise<Record<string, { name: string; icon_light?: string }>> | null = null;
+
+export async function describeAuthenticator(aaguid: string, userAgent: string) {
+  if (aaguid !== ZERO_AAGUID) {
+    registry ??= fetch(AAGUID_REGISTRY_URL, { signal: AbortSignal.timeout(5000) })
+      .then((r) => r.json())
+      .catch(() => {
+        registry = null;
+        return {};
+      });
+    const provider = (await registry)[aaguid];
+    if (provider) return { name: provider.name, providerIcon: provider.icon_light };
+  }
+  const device = /iPhone|iPad/.test(userAgent)
+    ? 'iOS device'
+    : /Android/.test(userAgent)
+      ? 'Android device'
+      : /Mac OS/.test(userAgent)
+        ? 'Mac'
+        : /Windows/.test(userAgent)
+          ? 'Windows PC'
+          : /Linux/.test(userAgent)
+            ? 'Linux device'
+            : 'Unknown passkey provider';
+  return { name: device, providerIcon: undefined };
+}
