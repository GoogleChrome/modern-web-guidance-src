@@ -0,0 +1,52 @@
+import type { APIContext } from 'astro';
+import { findUserById, type StoredUser } from './auth-store';
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+export const BACKEND = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export function rpConfig(url: URL) {
+  return {
+    rpID: process.env.PASSKEY_RP_ID || url.hostname,
+    origin: process.env.PASSKEY_ORIGIN || url.origin,
+    rpName: 'The DevTools Times',
+  };
+}
+
+export async function currentUser(session: APIContext['session']): Promise<StoredUser | undefined> {
+  const id = await session?.get('userId');
+  return id ? findUserById(id) : undefined;
+}
+
+export async function recentlyReauthenticated(session: APIContext['session']) {
+  const at = await session?.get('reauthAt');
+  return typeof at === 'number' && Date.now() - at < REAUTH_WINDOW_MS;
+}
+
+export const publicUser = (user: StoredUser) => ({
+  id: user.id,
+  username: user.username,
+  displayName: user.displayName,
+  hasPassword: user.hasPassword,
+  passkeyCount: user.passkeys.length,
+});
+
+export async function signIn(session: APIContext['session'], user: StoredUser) {
+  // Regenerate the session on privilege change to prevent fixation.
+  await session?.regenerate();
+  await session?.set('userId', user.id);
+  await session?.set('reauthAt', Date.now());
+}
+
+export async function backendPost(path: string, body: unknown) {
+  const response = await fetch(`${BACKEND}/${path}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body),
+  });
+  const data = await response.json().catch(() => ({}));
+  return { ok: response.ok, data };
+}
diff --git a/src/lib/passkey-client.ts b/src/lib/passkey-client.ts
new file mode 100644
index 0000000..edf95d1
--- /dev/null
+++ b/src/lib/passkey-client.ts
@@ -0,0 +1,223 @@
+// Browser-side passkey helpers. Call only from client effects/handlers (never during SSR).
+
+const API = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}api`;
+
+export interface PasskeyInfo {
+  id: string;
+  name: string;
+  providerIcon?: string;
+  credentialDeviceType: string;
+  credentialBackedUp: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export interface AccountUser {
+  id: string;
+  username: string;
+  displayName: string;
+  hasPassword: boolean;
+  passkeyCount: number;
+}
+
+export const rpId = () => window.location.hostname;
+
+export async function api(path: string, init?: { method?: string; body?: unknown }) {
+  const response = await fetch(`${API}/${path}`, {
+    method: init?.method ?? (init?.body !== undefined ? 'POST' : 'GET'),
+    headers: { 'Content-Type': 'application/json' },
+    body: init?.body !== undefined ? JSON.stringify(init.body) : undefined,
+  });
+  const data = await response.json().catch(() => ({}));
+  return { response, ok: response.ok, status: response.status, data };
+}
+
+async function ensureWebAuthnJson() {
+  if (
+    !PublicKeyCredential.parseCreationOptionsFromJSON ||
+    !PublicKeyCredential.parseRequestOptionsFromJSON ||
+    !PublicKeyCredential.getClientCapabilities ||
+    !('toJSON' in PublicKeyCredential.prototype)
+  ) {
+    await import('webauthn-polyfills');
+  }
+}
+
+export async function getCapabilities() {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return {} as Record<string, boolean>;
+  await ensureWebAuthnJson();
+  return (await PublicKeyCredential.getClientCapabilities()) as Record<string, boolean>;
+}
+
+/** True when this browser can create and use (autofill) passkeys. */
+export async function passkeysSupported() {
+  const caps = await getCapabilities();
+  return Boolean(caps.passkeyPlatformAuthenticator && caps.conditionalGet);
+}
+
+export type PasskeyResult<T = unknown> = { ok: true; data: T } | { ok: false; cancelled?: boolean; error: string; status?: number };
+
+const cancelled = (): PasskeyResult => ({ ok: false, cancelled: true, error: '' });
+
+function describeError(err: any): PasskeyResult {
+  switch (err?.name) {
+    case 'NotAllowedError':
+    case 'AbortError':
+      return cancelled();
+    case 'InvalidStateError':
+      return { ok: false, error: 'A passkey already exists for this account on this device.' };
+    case 'SecurityError':
+      return { ok: false, error: 'Passkeys are unavailable on this site (secure origin or domain mismatch).' };
+    default:
+      console.error('WebAuthn error:', err);
+      return { ok: false, error: 'Something went wrong with your passkey. Please try again.' };
+  }
+}
+
+async function signalUnknown(credentialId: string) {
+  if (!PublicKeyCredential.signalUnknownCredential) return;
+  try {
+    await (PublicKeyCredential as any).signalUnknownCredential({ rpId: rpId(), credentialId });
+  } catch (e) {
+    console.error('signalUnknownCredential failed:', e);
+  }
+}
+
+/** Creates a passkey and sends the attestation to `verifyPath`. */
+async function createAndVerify(
+  optionsPath: string,
+  optionsBody: unknown,
+  verifyPath: string,
+  mediation?: 'conditional',
+): Promise<PasskeyResult<any>> {
+  await ensureWebAuthnJson();
+  const options = await api(optionsPath, { body: optionsBody });
+  if (!options.ok) return { ok: false, error: options.data.error || 'Could not start passkey registration', status: options.status };
+
+  let credential: PublicKeyCredential;
+  try {
+    const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options.data);
+    credential = (await navigator.credentials.create({ publicKey, ...(mediation && { mediation }) } as any)) as PublicKeyCredential;
+    if (!credential) return cancelled();
+  } catch (err) {
+    return describeError(err);
+  }
+
+  const encoded = credential.toJSON() as { id: string };
+  try {
+    const verified = await api(verifyPath, { body: encoded });
+    if (!verified.ok) {
+      // The provider now holds a credential the server rejected.
+      await signalUnknown(encoded.id);
+      return { ok: false, error: verified.data.error || 'Could not save passkey', status: verified.status };
+    }
+    return { ok: true, data: verified.data };
+  } catch (err) {
+    await signalUnknown(encoded.id);
+    return { ok: false, error: 'Network error while saving your passkey.' };
+  }
+}
+
+export const registerPasskey = (opts: { promotion?: boolean } = {}) =>
+  createAndVerify('passkeys/register/options', { promotion: opts.promotion === true }, 'passkeys/register/verify');
+
+export const signUpWithPasskey = (username: string) =>
+  createAndVerify('passkeys/signup/options', { username }, 'passkeys/signup/verify');
+
+/** Silently adds a passkey after a successful password sign-in. Never surfaces errors. */
+export async function conditionalCreatePasskey(autofillAbort?: AbortController) {
+  try {
+    const caps = await getCapabilities();
+    if (!caps.conditionalCreate) return null;
+    autofillAbort?.abort();
+    const result = await createAndVerify(
+      'passkeys/register/options',
+      { conditional: true },
+      'passkeys/register/verify',
+      'conditional',
+    );
+    return result.ok ? result.data : null;
+  } catch {
+    return null;
+  }
+}
+
+async function getAssertion(
+  optionsPath: string,
+  verifyPath: string,
+  opts: { signal?: AbortSignal; conditional?: boolean },
+): Promise<PasskeyResult<any>> {
+  await ensureWebAuthnJson();
+  const options = await api(optionsPath, { body: {} });
+  if (!options.ok) return { ok: false, error: options.data.error || 'Could not start passkey sign-in', status: options.status };
+
+  let credential: PublicKeyCredential;
+  try {
+    const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options.data);
+    credential = (await navigator.credentials.get({
+      publicKey,
+      signal: opts.signal,
+      ...(opts.conditional && { mediation: 'conditional' }),
+    } as any)) as PublicKeyCredential;
+    if (!credential) return cancelled();
+  } catch (err) {
+    return describeError(err);
+  }
+
+  const encoded = credential.toJSON() as { id: string };
+  try {
+    const verified = await api(verifyPath, { body: encoded });
+    if (!verified.ok) {
+      if (verified.status === 404) await signalUnknown(encoded.id);
+      return { ok: false, error: verified.data.error || 'Passkey verification failed', status: verified.status };
+    }
+    return { ok: true, data: verified.data };
+  } catch {
+    return { ok: false, error: 'Network error while verifying your passkey.' };
+  }
+}
+
+export const signInWithPasskey = (signal?: AbortSignal) =>
+  getAssertion('passkeys/login/options', 'passkeys/login/verify', { signal });
+
+/** Registers browser-autofill passkey sign-in; resolves when the user picks a passkey (or aborts). */
+export async function startPasskeyAutofill(signal: AbortSignal) {
+  const caps = await getCapabilities();
+  if (!caps.conditionalGet) return null;
+  return getAssertion('passkeys/login/options', 'passkeys/login/verify', {
+    signal,
+    conditional: true,
+  });
+}
+
+export const reauthenticateWithPasskey = () =>
+  getAssertion('passkeys/reauth/options', 'passkeys/reauth/verify');
+
+// ---- Signal API sync (progressive enhancement) ----
+
+export async function signalAcceptedCredentials(userId: string, passkeys: PasskeyInfo[]) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  try {
+    await (PublicKeyCredential as any).signalAllAcceptedCredentials({
+      rpId: rpId(),
+      userId,
+      allAcceptedCredentialIds: passkeys.map((p) => p.id),
+    });
+  } catch (e) {
+    console.error('signalAllAcceptedCredentials failed:', e);
+  }
+}
+
+export async function signalUserDetails(user: AccountUser) {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  try {
+    await (PublicKeyCredential as any).signalCurrentUserDetails({
+      rpId: rpId(),
+      userId: user.id,
+      name: user.username,
+      displayName: user.displayName,
+    });
+  } catch (e) {
+    console.error('signalCurrentUserDetails failed:', e);
+  }
+}
