diff --git a/src/lib/passkeyClient.ts b/src/lib/passkeyClient.ts
new file mode 100644
index 0000000..75fe5a4
--- /dev/null
+++ b/src/lib/passkeyClient.ts
@@ -0,0 +1,49 @@
+import { startAuthentication, startRegistration, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+
+const API = `${import.meta.env.BASE_URL}api`;
+
+export const passkeysSupported = () => browserSupportsWebAuthn();
+
+export async function post<T = any>(path: string, body: unknown = {}, method = 'POST'): Promise<T> {
+  const res = await fetch(`${API}/${path}`, {
+    method,
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body),
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) throw Object.assign(new Error(data.error || 'Request failed'), { reauth: !!data.reauth });
+  return data;
+}
+
+export async function get<T = any>(path: string): Promise<T> {
+  const res = await fetch(`${API}/${path}`);
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) throw new Error(data.error || 'Request failed');
+  return data;
+}
+
+/** Turns WebAuthn browser errors into something readable; returns null if the user just cancelled. */
+export function passkeyErrorMessage(err: unknown): string | null {
+  const e = err as Error;
+  if (e?.name === 'NotAllowedError' || e?.name === 'AbortError') return null;
+  if (e?.name === 'InvalidStateError') return 'This device already has a passkey for your account.';
+  return e?.message || 'Something went wrong with your passkey.';
+}
+
+export async function signInWithPasskey(purpose: 'signin' | 'reauth' = 'signin') {
+  const options = await post('passkeys/auth-options', { purpose });
+  const response = await startAuthentication({ optionsJSON: options });
+  return post<{ username: string }>('passkeys/auth-verify', { response });
+}
+
+export async function addPasskey(name?: string) {
+  const options = await post('passkeys/register-options');
+  const response = await startRegistration({ optionsJSON: options });
+  return post('passkeys/register-verify', { response, name });
+}
+
+export async function signUpWithPasskey(username: string) {
+  const options = await post('passkeys/signup-options', { username });
+  const response = await startRegistration({ optionsJSON: options });
+  return post<{ username: string }>('passkeys/signup-verify', { response });
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..536770c
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,110 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import type { AstroSession } from 'astro';
+
+export const RP_NAME = 'The DevTools Times';
+/** How long after a successful (re)authentication sensitive actions are allowed. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+export const REMOTE_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export interface StoredPasskey {
+  id: string; // base64url credential ID
+  publicKey: string; // base64url
+  counter: number;
+  transports?: string[];
+  name: string;
+  deviceType: string;
+  backedUp: boolean;
+  createdAt: number;
+  lastUsedAt?: number;
+}
+
+export interface StoredUser {
+  username: string;
+  /** base64url WebAuthn user handle */
+  handle: string;
+  passkeys: StoredPasskey[];
+  /** Account was created with a passkey only (no known password). */
+  passkeyOnly?: boolean;
+}
+
+const FILE = path.join(process.cwd(), 'data', 'passkeys.json');
+
+function load(): Record<string, StoredUser> {
+  try {
+    return JSON.parse(fs.readFileSync(FILE, 'utf8'));
+  } catch {
+    return {};
+  }
+}
+
+function save(users: Record<string, StoredUser>) {
+  fs.mkdirSync(path.dirname(FILE), { recursive: true });
+  fs.writeFileSync(FILE, JSON.stringify(users, null, 2));
+}
+
+const key = (username: string) => username.trim().toLowerCase();
+
+export function getUser(username: string): StoredUser | undefined {
+  return load()[key(username)];
+}
+
+export function getUserByHandle(handle: string): StoredUser | undefined {
+  return Object.values(load()).find((u) => u.handle === handle);
+}
+
+/** Gets the user record, creating it (with a fresh user handle) if needed. */
+export function ensureUser(username: string): StoredUser {
+  const users = load();
+  const k = key(username);
+  if (!users[k]) {
+    users[k] = {
+      username: username.trim(),
+      handle: crypto.randomBytes(32).toString('base64url'),
+      passkeys: [],
+    };
+    save(users);
+  }
+  return users[k];
+}
+
+export function updateUser(username: string, fn: (u: StoredUser) => void): StoredUser | undefined {
+  const users = load();
+  const u = users[key(username)];
+  if (!u) return undefined;
+  fn(u);
+  save(users);
+  return u;
+}
+
+export function publicPasskey(p: StoredPasskey) {
+  const { id, name, deviceType, backedUp, createdAt, lastUsedAt } = p;
+  return { id, name, deviceType, backedUp, createdAt, lastUsedAt };
+}
+
+export function rpInfo(request: Request) {
+  const url = new URL(request.url);
+  return { rpID: url.hostname, origin: url.origin };
+}
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+export async function currentUsername(session: AstroSession | undefined): Promise<string | undefined> {
+  return (await session?.get('user')) as string | undefined;
+}
+
+export async function markAuthenticated(session: AstroSession | undefined, username: string) {
+  await session?.set('user', username);
+  await session?.set('authAt', Date.now());
+}
+
+export async function hasRecentAuth(session: AstroSession | undefined): Promise<boolean> {
+  const at = (await session?.get('authAt')) as number | undefined;
+  return !!at && Date.now() - at < REAUTH_WINDOW_MS;
+}
