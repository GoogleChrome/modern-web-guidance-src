@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { currentUsername, getUser, json, rpInfo } from '../../../lib/passkeys';
+
+// Starts a passkey ceremony. purpose "signin" is usernameless (discoverable credentials);
+// purpose "reauth" is limited to the signed-in user's passkeys.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { purpose } = await request.json();
+  let allowCredentials;
+  if (purpose === 'reauth') {
+    const username = await currentUsername(session);
+    if (!username) return json({ error: 'Not signed in' }, 401);
+    const user = getUser(username);
+    if (!user?.passkeys.length) return json({ error: 'No passkeys on this account' }, 400);
+    allowCredentials = user.passkeys.map((p) => ({ id: p.id, transports: p.transports as any }));
+  } else if (purpose !== 'signin') {
+    return json({ error: 'Invalid purpose' }, 400);
+  }
+
+  const options = await generateAuthenticationOptions({
+    rpID: rpInfo(request).rpID,
+    userVerification: 'preferred',
+    allowCredentials,
+  });
+  await session?.set('authChallenge', { challenge: options.challenge, purpose });
+  return json(options);
+};
