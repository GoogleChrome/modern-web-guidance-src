@@ -0,0 +1,43 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { currentUsername, hasRecentAuth, json, publicPasskey, rpInfo, updateUser } from '../../../lib/passkeys';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const username = await currentUsername(session);
+  if (!username) return json({ error: 'Not signed in' }, 401);
+  if (!(await hasRecentAuth(session))) return json({ error: 'Reauthentication required', reauth: true }, 403);
+
+  const { response, name } = await request.json();
+  const expectedChallenge = (await session?.get('regChallenge')) as string | undefined;
+  if (!expectedChallenge) return json({ error: 'No registration in progress' }, 400);
+  await session?.delete('regChallenge');
+
+  const { rpID, origin } = rpInfo(request);
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+    });
+  } catch (e) {
+    return json({ error: (e as Error).message }, 400);
+  }
+  if (!verification.verified || !verification.registrationInfo) return json({ error: 'Verification failed' }, 400);
+
+  const { credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  const user = updateUser(username, (u) => {
+    u.passkeys.push({
+      id: credential.id,
+      publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+      counter: credential.counter,
+      transports: credential.transports,
+      name: String(name || '').trim().slice(0, 60) || `Passkey ${u.passkeys.length + 1}`,
+      deviceType: credentialDeviceType,
+      backedUp: credentialBackedUp,
+      createdAt: Date.now(),
+    });
+  });
+  return json({ passkeys: user!.passkeys.map(publicPasskey) });
+};
diff --git a/src/pages/api/passkeys/signup-options.ts b/src/pages/api/passkeys/signup-options.ts
