@@ -0,0 +1,24 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { RP_NAME, getUser, json, rpInfo } from '../../../lib/passkeys';
+import crypto from 'node:crypto';
+
+// Starts creating a brand-new, passkey-only account.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username } = await request.json();
+  const name = String(username || '').trim();
+  if (!name) return json({ error: 'Username is required' }, 400);
+  if (getUser(name)) return json({ error: 'Username is already taken' }, 409);
+
+  const handle = crypto.randomBytes(32);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: rpInfo(request).rpID,
+    userName: name,
+    userID: handle,
+    attestationType: 'none',
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+  });
+  await session?.set('signup', { username: name, handle: handle.toString('base64url'), challenge: options.challenge });
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/signup-verify.ts b/src/pages/api/passkeys/signup-verify.ts
new file mode 100644
index 0000000..f050e4b
--- /dev/null
+++ b/src/pages/api/passkeys/signup-verify.ts
@@ -0,0 +1,60 @@
+import type { APIRoute } from 'astro';
+import crypto from 'node:crypto';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { REMOTE_API, ensureUser, getUser, json, markAuthenticated, rpInfo, updateUser } from '../../../lib/passkeys';
+
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const { response } = await request.json();
+  const pending = (await session?.get('signup')) as
+    | { username: string; handle: string; challenge: string }
+    | undefined;
+  if (!pending) return json({ error: 'No sign-up in progress' }, 400);
+  await session?.delete('signup');
+
+  const { rpID, origin } = rpInfo(request);
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+    });
+  } catch (e) {
+    return json({ error: (e as Error).message }, 400);
+  }
+  if (!verification.verified || !verification.registrationInfo) return json({ error: 'Verification failed' }, 400);
+  if (getUser(pending.username)) return json({ error: 'Username is already taken' }, 409);
+
+  // Reserve the username with the backend (random, unknown password) so it can't be claimed
+  // by a password sign-up later, and so we learn if it already exists there.
+  const reserve = await fetch(`${REMOTE_API}/register`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username: pending.username, password: `${crypto.randomBytes(24).toString('base64url')}1` }),
+  });
+  if (!reserve.ok) {
+    const data = await reserve.json().catch(() => ({}));
+    return json({ error: `Could not create account: ${data.error || 'Unknown error'}` }, 409);
+  }
+
+  const { credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  ensureUser(pending.username);
+  updateUser(pending.username, (u) => {
+    u.handle = pending.handle;
+    u.passkeyOnly = true;
+    u.passkeys.push({
+      id: credential.id,
+      publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+      counter: credential.counter,
+      transports: credential.transports,
+      name: 'Passkey 1',
+      deviceType: credentialDeviceType,
+      backedUp: credentialBackedUp,
+      createdAt: Date.now(),
+    });
+  });
+  await markAuthenticated(session, pending.username);
+  return json({ username: pending.username });
+};
