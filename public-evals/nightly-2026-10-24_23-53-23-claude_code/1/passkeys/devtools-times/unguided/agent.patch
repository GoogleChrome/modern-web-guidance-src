index 0000000..08ad967
--- /dev/null
+++ b/src/pages/api/passkeys/index.ts
@@ -0,0 +1,43 @@
+import type { APIRoute } from 'astro';
+import { currentUsername, getUser, hasRecentAuth, json, publicPasskey, updateUser } from '../../../lib/passkeys';
+
+export const GET: APIRoute = async ({ session }) => {
+  const username = await currentUsername(session);
+  if (!username) return json({ error: 'Not signed in' }, 401);
+  const user = getUser(username);
+  return json({
+    username,
+    passkeyOnly: !!user?.passkeyOnly,
+    passkeys: (user?.passkeys ?? []).map(publicPasskey),
+  });
+};
+
+// Rename a passkey.
+export const PATCH: APIRoute = async ({ request, session }) => {
+  const username = await currentUsername(session);
+  if (!username) return json({ error: 'Not signed in' }, 401);
+  const { id, name } = await request.json();
+  const clean = String(name || '').trim().slice(0, 60);
+  if (!clean) return json({ error: 'Name is required' }, 400);
+  const user = updateUser(username, (u) => {
+    const p = u.passkeys.find((x) => x.id === id);
+    if (p) p.name = clean;
+  });
+  return json({ passkeys: (user?.passkeys ?? []).map(publicPasskey) });
+};
+
+// Remove a passkey. Requires recent authentication.
+export const DELETE: APIRoute = async ({ request, session }) => {
+  const username = await currentUsername(session);
+  if (!username) return json({ error: 'Not signed in' }, 401);
+  if (!(await hasRecentAuth(session))) return json({ error: 'Reauthentication required', reauth: true }, 403);
+  const { id } = await request.json();
+  const existing = getUser(username);
+  if (existing?.passkeyOnly && existing.passkeys.length <= 1) {
+    return json({ error: 'This is your only way to sign in. Add another passkey first.' }, 400);
+  }
+  const user = updateUser(username, (u) => {
+    u.passkeys = u.passkeys.filter((x) => x.id !== id);
+  });
+  return json({ passkeys: (user?.passkeys ?? []).map(publicPasskey) });
+};
