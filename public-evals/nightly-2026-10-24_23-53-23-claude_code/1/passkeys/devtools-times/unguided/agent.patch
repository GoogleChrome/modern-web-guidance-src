+import type { APIRoute } from 'astro';
+import { REMOTE_API, json, markAuthenticated } from '../../../lib/passkeys';
+
+// Proxies the password login to the backend and records the signed-in user in the session.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json();
+  if (!username || !password) return json({ error: 'Username and password are required' }, 400);
+  const res = await fetch(`${REMOTE_API}/login`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) return json(data, res.status);
+  await markAuthenticated(session, username);
+  return json({ ...data, username });
+};
