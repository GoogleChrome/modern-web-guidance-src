index 0000000..bc86dde
--- /dev/null
+++ b/src/pages/api/passkeys/auth-verify.ts
@@ -0,0 +1,47 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { currentUsername, getUserByHandle, json, markAuthenticated, rpInfo, updateUser } from '../../../lib/passkeys';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const { response } = await request.json();
+  const pending = (await session?.get('authChallenge')) as { challenge: string; purpose: string } | undefined;
+  if (!pending) return json({ error: 'No authentication in progress' }, 400);
+  await session?.delete('authChallenge');
+
+  const userHandle: string | undefined = response?.response?.userHandle;
+  const user = userHandle ? getUserByHandle(userHandle) : undefined;
+  const passkey = user?.passkeys.find((p) => p.id === response?.id);
+  if (!user || !passkey) return json({ error: 'Passkey not recognized' }, 401);
+
+  if (pending.purpose === 'reauth' && user.username.toLowerCase() !== (await currentUsername(session))?.toLowerCase()) {
+    return json({ error: 'Passkey belongs to a different account' }, 403);
+  }
+
+  const { rpID, origin } = rpInfo(request);
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      credential: {
+        id: passkey.id,
+        publicKey: Buffer.from(passkey.publicKey, 'base64url'),
+        counter: passkey.counter,
+        transports: passkey.transports as any,
+      },
+    });
+  } catch (e) {
+    return json({ error: (e as Error).message }, 401);
+  }
+  if (!verification.verified) return json({ error: 'Verification failed' }, 401);
+
+  updateUser(user.username, (u) => {
+    const p = u.passkeys.find((x) => x.id === passkey.id)!;
+    p.counter = verification.authenticationInfo.newCounter;
+    p.lastUsedAt = Date.now();
+  });
+  await markAuthenticated(session, user.username);
+  return json({ username: user.username });
+};
diff --git a/src/pages/api/passkeys/index.ts b/src/pages/api/passkeys/index.ts
