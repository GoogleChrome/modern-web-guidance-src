diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..322a2ae
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,273 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import {
+  addPasskey,
+  get,
+  passkeyErrorMessage,
+  passkeysSupported,
+  post,
+  signInWithPasskey,
+} from '../lib/passkeyClient';
+
+interface Passkey {
+  id: string;
+  name: string;
+  deviceType: string;
+  backedUp: boolean;
+  createdAt: number;
+  lastUsedAt?: number;
+}
+
+type Pending = { type: 'add' } | { type: 'delete'; id: string } | null;
+
+const fmt = (t?: number) => (t ? new Date(t).toLocaleDateString('en-US', { dateStyle: 'medium' }) : 'Never');
+const base = import.meta.env.BASE_URL;
+
+export default function AccountSettings() {
+  const [loaded, setLoaded] = useState(false);
+  const [username, setUsername] = useState<string | null>(null);
+  const [passkeyOnly, setPasskeyOnly] = useState(false);
+  const [passkeys, setPasskeys] = useState<Passkey[]>([]);
+  const [supported, setSupported] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [newName, setNewName] = useState('');
+  const [editing, setEditing] = useState<{ id: string; name: string } | null>(null);
+  // Reauthentication prompt: shown when a sensitive action needs a fresh sign-in.
+  const [pending, setPending] = useState<Pending>(null);
+  const [password, setPassword] = useState('');
+
+  const refresh = useCallback(async () => {
+    try {
+      const data = await get('passkeys');
+      setUsername(data.username);
+      setPasskeyOnly(data.passkeyOnly);
+      setPasskeys(data.passkeys);
+    } catch {
+      setUsername(null);
+    } finally {
+      setLoaded(true);
+    }
+  }, []);
+
+  useEffect(() => {
+    setSupported(passkeysSupported());
+    refresh();
+  }, [refresh]);
+
+  const run = async (fn: () => Promise<void>) => {
+    setError(null);
+    setNotice(null);
+    setBusy(true);
+    try {
+      await fn();
+    } catch (err: any) {
+      const msg = err?.reauth ? null : passkeyErrorMessage(err);
+      if (msg) setError(msg);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const doAdd = () =>
+    run(async () => {
+      try {
+        const res = await addPasskey(newName);
+        setPasskeys(res.passkeys);
+        setNewName('');
+        setNotice('Passkey added.');
+      } catch (err: any) {
+        if (err.reauth) setPending({ type: 'add' });
+        else throw err;
+      }
+    });
+
+  const doDelete = (id: string) =>
+    run(async () => {
+      try {
+        const res = await post('passkeys', { id }, 'DELETE');
+        setPasskeys(res.passkeys);
+        setNotice('Passkey removed.');
+      } catch (err: any) {
+        if (err.reauth) setPending({ type: 'delete', id });
+        else throw err;
+      }
+    });
+
+  const doRename = () =>
+    run(async () => {
+      if (!editing) return;
+      const res = await post('passkeys', editing, 'PATCH');
+      setPasskeys(res.passkeys);
+      setEditing(null);
+    });
+
+  const resume = (p: Pending) => {
+    setPending(null);
+    setPassword('');
+    if (p?.type === 'add') doAdd();
+    if (p?.type === 'delete') doDelete(p.id);
+  };
+
+  const reauthWithPasskey = () =>
+    run(async () => {
+      await signInWithPasskey('reauth');
+      resume(pending);
+    });
+
+  const reauthWithPassword = (e: React.FormEvent) => {
+    e.preventDefault();
+    run(async () => {
+      await post('auth/reauth', { password });
+      resume(pending);
+    });
+  };
+
+  const signOut = () =>
+    run(async () => {
+      await post('auth/logout');
+      setUsername(null);
+      setPasskeys([]);
+    });
+
+  if (!loaded) return <p className="text-center text-gray-500 mt-10">Loading…</p>;
+
+  if (!username) {
+    return (
+      <div className="max-w-md mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm text-center">
+        <h2 className="text-2xl font-bold mb-2 text-gray-800">Account settings</h2>
+        <p className="text-sm text-gray-600 mb-4">Sign in to manage your account and passkeys.</p>
+        <a
+          href={`${base}signin`}
+          className="inline-block py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800"
+        >
+          Sign in
+        </a>
+      </div>
+    );
+  }
+
+  const btn =
+    'py-2 px-4 rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75';
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <div className="flex items-center justify-between mb-6">
+        <div>
+          <h2 className="text-2xl font-bold text-gray-800">Account settings</h2>
+          <p className="text-sm text-gray-600">Signed in as <strong>{username}</strong></p>
+        </div>
+        <button onClick={signOut} disabled={busy} className={`${btn} border border-gray-300 text-gray-900 bg-white hover:bg-gray-50`}>
+          Sign out
+        </button>
+      </div>
+
+      {error && <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">{error}</div>}
+      {notice && <div className="mb-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">{notice}</div>}
+
+      {pending && (
+        <div className="mb-6 p-4 border border-amber-300 bg-amber-50 rounded-lg" role="dialog" aria-label="Confirm it's you">
+          <h3 className="font-semibold text-gray-800 mb-1">Confirm it's you</h3>
+          <p className="text-sm text-gray-600 mb-3">
+            For your security, please verify your identity to {pending.type === 'add' ? 'add a passkey' : 'remove this passkey'}.
+          </p>
+          <div className="flex flex-col gap-3">
+            {supported && passkeys.length > 0 && (
+              <button onClick={reauthWithPasskey} disabled={busy} className={`${btn} text-white bg-gray-900 hover:bg-gray-800`}>
+                Verify with a passkey
+              </button>
+            )}
+            {!passkeyOnly && (
+              <form onSubmit={reauthWithPassword} className="flex gap-2">
+                <label htmlFor="reauth-password" className="sr-only">Password</label>
+                <input
+                  id="reauth-password"
+                  type="password"
+                  required
+                  autoComplete="current-password"
+                  placeholder="Password"
+                  value={password}
+                  onChange={(e) => setPassword(e.target.value)}
+                  className="flex-1 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                />
+                <button type="submit" disabled={busy} className={`${btn} text-white bg-gray-900 hover:bg-gray-800`}>
+                  Verify
+                </button>
+              </form>
+            )}
+            <button onClick={() => { setPending(null); setPassword(''); }} className="text-sm text-gray-600 underline self-start">
+              Cancel
+            </button>
+          </div>
+        </div>
+      )}
+
+      <section aria-labelledby="passkeys-heading">
+        <h3 id="passkeys-heading" className="text-lg font-semibold text-gray-800 mb-1">Passkeys</h3>
+        <p className="text-sm text-gray-600 mb-4">
+          Passkeys let you sign in with your fingerprint, face, or device screen lock instead of a password.
+        </p>
+
+        {passkeys.length === 0 ? (
+          <p className="text-sm text-gray-500 mb-4">You haven't added any passkeys yet.</p>
+        ) : (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md mb-4">
+            {passkeys.map((p) => (
+              <li key={p.id} className="p-3 flex items-center justify-between gap-3">
+                <div className="min-w-0">
+                  {editing?.id === p.id ? (
+                    <form onSubmit={(e) => { e.preventDefault(); doRename(); }} className="flex gap-2">
+                      <input
+                        aria-label="Passkey name"
+                        autoFocus
+                        required
+                        maxLength={60}
+                        value={editing.name}
+                        onChange={(e) => setEditing({ id: p.id, name: e.target.value })}
+                        className="px-2 py-1 border border-gray-300 rounded-md text-sm"
+                      />
+                      <button type="submit" disabled={busy} className="text-sm underline">Save</button>
+                      <button type="button" onClick={() => setEditing(null)} className="text-sm text-gray-600 underline">Cancel</button>
+                    </form>
+                  ) : (
+                    <p className="font-medium text-gray-800 truncate">{p.name}</p>
+                  )}
+                  <p className="text-xs text-gray-500">
+                    Added {fmt(p.createdAt)} · Last used {fmt(p.lastUsedAt)} ·{' '}
+                    {p.backedUp ? 'Synced passkey' : 'Device-bound passkey'}
+                  </p>
+                </div>
+                {editing?.id !== p.id && (
+                  <div className="flex gap-3 text-sm shrink-0">
+                    <button onClick={() => setEditing({ id: p.id, name: p.name })} className="underline">Rename</button>
+                    <button onClick={() => doDelete(p.id)} disabled={busy} className="text-red-700 underline">Remove</button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+
+        {supported ? (
+          <form onSubmit={(e) => { e.preventDefault(); doAdd(); }} className="flex gap-2">
+            <label htmlFor="passkey-name" className="sr-only">Passkey name</label>
+            <input
+              id="passkey-name"
+              type="text"
+              maxLength={60}
+              placeholder="Name (e.g. Work laptop)"
+              value={newName}
+              onChange={(e) => setNewName(e.target.value)}
+              className="flex-1 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+            <button type="submit" disabled={busy} className={`${btn} text-white bg-gray-900 hover:bg-gray-800`}>
+              Add a passkey
+            </button>
+          </form>
+        ) : (
+          <p className="text-sm text-gray-500">Your browser doesn't support passkeys.</p>
+        )}
+      </section>
+    </div>
+  );
+}
