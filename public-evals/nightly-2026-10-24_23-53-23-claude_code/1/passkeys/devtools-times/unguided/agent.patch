@@ -0,0 +1,23 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { RP_NAME, currentUsername, ensureUser, hasRecentAuth, json, rpInfo } from '../../../lib/passkeys';
+
+// Starts adding a passkey to the signed-in account. Requires recent authentication.
+export const POST: APIRoute = async ({ request, session }) => {
+  const username = await currentUsername(session);
+  if (!username) return json({ error: 'Not signed in' }, 401);
+  if (!(await hasRecentAuth(session))) return json({ error: 'Reauthentication required', reauth: true }, 403);
+
+  const user = ensureUser(username);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: rpInfo(request).rpID,
+    userName: user.username,
+    userID: Buffer.from(user.handle, 'base64url'),
+    attestationType: 'none',
+    excludeCredentials: user.passkeys.map((p) => ({ id: p.id, transports: p.transports as any })),
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+  });
+  await session?.set('regChallenge', options.challenge);
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/register-verify.ts b/src/pages/api/passkeys/register-verify.ts
