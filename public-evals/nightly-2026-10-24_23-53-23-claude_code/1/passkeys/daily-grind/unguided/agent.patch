+
+function sendJson(res, status, data) {
+  res.writeHead(status, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' });
+  res.end(JSON.stringify(data));
+}
+
+async function handleApi(req, res, pathname) {
+  const match = matchRoute(req.method, pathname);
+  if (!match) throw new HttpError(404, 'Not found');
+  if (req.method !== 'GET') {
+    // CSRF defence in depth on top of SameSite=Lax cookies.
+    const origin = req.headers.origin;
+    if (origin && origin !== rpInfo(req).origin) throw new HttpError(403, 'Bad origin');
+    if (!(req.headers['content-type'] || '').startsWith('application/json')) throw new HttpError(415, 'JSON required');
+  }
+  const body = req.method === 'GET' ? {} : await readBody(req);
+  sendJson(res, 200, match.handler(req, res, body, match.params));
+}
+
+// ---- Static pages ----
+const PAGES = {
+  '/': ['index.html', 'text/html; charset=utf-8'],
+  '/login': ['public/login.html', 'text/html; charset=utf-8'],
+  '/account': ['public/account.html', 'text/html; charset=utf-8'],
+  '/passkeys.js': ['public/passkeys.js', 'text/javascript; charset=utf-8'],
+  '/auth.css': ['public/auth.css', 'text/css; charset=utf-8'],
+};
+
+const server = http.createServer(async (req, res) => {
+  const { pathname } = new URL(req.url, 'http://localhost');
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('X-Frame-Options', 'DENY');
+  res.setHeader('Referrer-Policy', 'same-origin');
