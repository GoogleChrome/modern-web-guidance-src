+    startSession(req, res, user);
+    return { ok: true, user: { username: user.username, displayName: user.displayName } };
+  },
+
+  // --- Sign in (usernameless, discoverable credentials) ---
+  'POST /api/login/options': (req) => ({
+    challenge: newChallenge('login'),
+    rpId: rpInfo(req).rpId,
+    allowCredentials: [],
+    userVerification: 'required',
+    timeout: 120000,
+  }),
+  'POST /api/login/verify': (req, res, body) => {
+    const { challenge } = takeChallenge(body, 'login');
