+    return creationOptions(req, user, challenge);
+  },
+  'POST /api/register/verify': (req, res, body) => {
+    const { challenge, entry } = takeChallenge(body, 'register');
+    const user = entry.pending;
+    if (db.users[user.username.toLowerCase()]) throw new HttpError(409, 'That username is taken');
+    const { origin, rpId } = rpInfo(req);
+    const cred = verifyRegistrationSafe({ response: body, challenge, origin, rpId });
