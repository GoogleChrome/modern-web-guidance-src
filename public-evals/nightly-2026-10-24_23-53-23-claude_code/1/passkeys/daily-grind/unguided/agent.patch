+'use strict';
+// Minimal WebAuthn (passkey) verification using only node:crypto.
+// Supports "none" attestation and ES256 / RS256 / EdDSA credentials.
+const crypto = require('node:crypto');
+
+const b64u = {
+  encode: (buf) => Buffer.from(buf).toString('base64url'),
+  decode: (str) => Buffer.from(String(str), 'base64url'),
+};
+const sha256 = (data) => crypto.createHash('sha256').update(data).digest();
+
+// ---- Minimal CBOR decoder (definite lengths only) ----
+function cborDecode(buf, offset = 0) {
+  const major = buf[offset] >> 5;
+  const info = buf[offset] & 0x1f;
+  let pos = offset + 1;
+  let arg = info;
+  if (info === 24) { arg = buf[pos]; pos += 1; }
+  else if (info === 25) { arg = buf.readUInt16BE(pos); pos += 2; }
+  else if (info === 26) { arg = buf.readUInt32BE(pos); pos += 4; }
+  else if (info === 27) { arg = Number(buf.readBigUInt64BE(pos)); pos += 8; }
+  else if (info > 27) throw new Error('Unsupported CBOR encoding');
+
+  switch (major) {
+    case 0: return [arg, pos];
+    case 1: return [-1 - arg, pos];
+    case 2: return [buf.subarray(pos, pos + arg), pos + arg];
+    case 3: return [buf.toString('utf8', pos, pos + arg), pos + arg];
+    case 4: {
+      const arr = [];
+      for (let i = 0; i < arg; i++) { const [v, p] = cborDecode(buf, pos); arr.push(v); pos = p; }
+      return [arr, pos];
+    }
+    case 5: {
+      const map = new Map();
+      for (let i = 0; i < arg; i++) {
+        const [k, p1] = cborDecode(buf, pos);
+        const [v, p2] = cborDecode(buf, p1);
+        map.set(k, v); pos = p2;
+      }
+      return [map, pos];
+    }
+    case 7:
+      if (info === 20) return [false, pos];
+      if (info === 21) return [true, pos];
+      if (info === 22) return [null, pos];
+      throw new Error('Unsupported CBOR simple value');
+    default: throw new Error('Unsupported CBOR type');
+  }
+}
+
+function parseAuthData(authData) {
+  if (authData.length < 37) throw new Error('authData too short');
+  const flags = authData[32];
+  const out = {
+    rpIdHash: authData.subarray(0, 32),
+    userPresent: !!(flags & 0x01),
+    userVerified: !!(flags & 0x04),
+    backupEligible: !!(flags & 0x08),
+    backedUp: !!(flags & 0x10),
+    counter: authData.readUInt32BE(33),
+  };
