+}
+function defaultPasskeyName(user) { return `Passkey ${user.credentials.length + 1}`; }
+
+// ---- API routes ----
+// Each handler returns a JSON-serialisable value.
+const routes = {
+  'GET /api/me': (req) => {
+    const s = getSession(req);
+    if (!s) return { user: null };
+    return {
+      user: { username: s.user.username, displayName: s.user.displayName },
+      recentlyAuthenticated: Date.now() - s.session.reauthAt <= REAUTH_WINDOW_MS,
+    };
+  },
+
+  // --- Registration of a new account ---
+  'POST /api/register/options': (req, res, body) => {
+    const username = typeof body.username === 'string' ? body.username.trim() : '';
+    if (!/^[A-Za-z0-9._-]{3,32}$/.test(username)) throw new HttpError(400, 'Username must be 3–32 letters, numbers, dots, dashes or underscores');
