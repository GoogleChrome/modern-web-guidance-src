+    session.reauthAt = Date.now();
+    return { ok: true };
+  },
+
+  // --- Passkey management ---
+  'GET /api/passkeys': (req) => ({ passkeys: requireSession(req).user.credentials.map(publicCredential) }),
+  'POST /api/passkeys/options': (req) => {
+    const { token, user } = requireRecentAuth(req);
+    if (user.credentials.length >= MAX_PASSKEYS) throw new HttpError(400, 'Passkey limit reached');
+    return creationOptions(req, user, newChallenge('add', { token }));
+  },
+  'POST /api/passkeys/verify': (req, res, body) => {
+    const { token, user } = requireRecentAuth(req);
+    const { challenge, entry } = takeChallenge(body, 'add');
+    if (entry.token !== token) throw new HttpError(400, 'Challenge expired or invalid');
