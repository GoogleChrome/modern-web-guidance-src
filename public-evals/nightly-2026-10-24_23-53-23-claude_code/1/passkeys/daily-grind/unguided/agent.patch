+    user.credentials.push(record);
+    save();
+    return { ok: true, passkey: publicCredential(record) };
+  },
+  'PATCH /api/passkeys/:id': (req, res, body, params) => {
+    const { user } = requireSession(req);
+    const credential = user.credentials.find((c) => c.id === params.id);
+    if (!credential) throw new HttpError(404, 'Passkey not found');
+    credential.name = cleanName(body.name, credential.name);
+    save();
+    return { ok: true, passkey: publicCredential(credential) };
+  },
+  'DELETE /api/passkeys/:id': (req, res, body, params) => {
+    const { user } = requireRecentAuth(req);
+    const i = user.credentials.findIndex((c) => c.id === params.id);
+    if (i < 0) throw new HttpError(404, 'Passkey not found');
+    if (user.credentials.length === 1) throw new HttpError(400, 'You can’t remove your only passkey');
+    user.credentials.splice(i, 1);
+    save();
+    return { ok: true };
+  },
+};
+
+function verifyRegistrationSafe(args) {
+  try { return verifyRegistration(args); } catch (e) { throw new HttpError(400, `Passkey verification failed: ${e.message}`); }
+}
+function applyAssertion(req, body, challenge, { user, credential }) {
+  const { origin, rpId } = rpInfo(req);
+  let result;
+  try { result = verifyAssertion({ response: body, challenge, origin, rpId, credential }); }
+  catch (e) { throw new HttpError(401, `Passkey verification failed: ${e.message}`); }
+  credential.counter = result.counter;
+  credential.backedUp = result.backedUp;
+  credential.lastUsedAt = Date.now();
+  save();
+}
+
+function matchRoute(method, pathname) {
+  for (const key of Object.keys(routes)) {
+    const [m, pattern] = key.split(' ');
+    if (m !== method) continue;
+    const pp = pattern.split('/');
+    const ap = pathname.split('/');
+    if (pp.length !== ap.length) continue;
+    const params = {};
+    let ok = true;
+    pp.forEach((seg, i) => {
+      if (seg.startsWith(':')) params[seg.slice(1)] = decodeURIComponent(ap[i]);
+      else if (seg !== ap[i]) ok = false;
+    });
+    if (ok) return { handler: routes[key], params };
+  }
+  return null;
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (c) => {
+      size += c.length;
+      if (size > 64 * 1024) { reject(new HttpError(413, 'Body too large')); req.destroy(); return; }
+      chunks.push(c);
+    });
+    req.on('end', () => {
+      if (!chunks.length) return resolve({});
+      try {
+        const v = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+        resolve(v && typeof v === 'object' ? v : {});
+      } catch { reject(new HttpError(400, 'Invalid JSON')); }
+    });
+    req.on('error', reject);
+  });
