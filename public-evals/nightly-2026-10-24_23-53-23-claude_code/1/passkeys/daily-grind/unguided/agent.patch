+
+function checkAuthData(a, rpId) {
+  if (!a.rpIdHash.equals(sha256(rpId))) throw new Error('RP ID mismatch');
+  if (!a.userPresent) throw new Error('User presence required');
+  if (!a.userVerified) throw new Error('User verification required');
