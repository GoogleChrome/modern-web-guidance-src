+    }
+
+    #domContainer .card.card-enter,
+    #domContainer .card.card-leave,
+    #domContainer .card[hidden] {
+      opacity: 0;
+      transform: scale(0.85);
+    }
+
+    /* Keep [hidden] cards rendered so the fade/scale can animate */
+    #domContainer .card[hidden] {
+      display: block;
+      visibility: hidden;
+      pointer-events: none;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #domContainer .card {
+        transition-duration: 0.01s;
+      }
+    }
