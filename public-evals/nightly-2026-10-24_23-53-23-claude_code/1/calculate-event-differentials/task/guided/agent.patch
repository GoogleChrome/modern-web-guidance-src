   </footer>
 
+  <script type="module">
+    // Temporal is not yet supported in Safari; load a polyfill when missing.
+    if (typeof Temporal === 'undefined') {
+      const { Temporal: T } = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = T;
+    }
+
+    const timer = document.querySelector('.promo-timer');
+    const tz = Temporal.Now.timeZoneId();
+    const toZoned = (value) => Temporal.PlainDateTime.from(value).toZonedDateTime(tz);
+    const start = toZoned(timer.dataset.start);
+    const end = toZoned(timer.dataset.end);
+    const now = Temporal.Now.zonedDateTimeISO(tz);
+    const units = { largestUnit: 'day', smallestUnit: 'hour' };
+    const fmt = (duration) => duration.toLocaleString(undefined, { style: 'long' });
+
+    const remaining = now.until(end, units);
+    timer.querySelector('[data-remaining]').textContent =
+      remaining.sign > 0 ? `${fmt(remaining)} left` : 'This offer has ended';
+
+    const elapsedEnd = Temporal.ZonedDateTime.compare(now, end) > 0 ? end : now;
+    const elapsed = elapsedEnd.since(start, units);
+    timer.querySelector('[data-elapsed]').textContent =
+      elapsed.sign > 0
+        ? `${fmt(elapsed)} ${remaining.sign > 0 ? 'since the promotion began' : 'was the promotion length'}`
+        : 'Promotion starts soon';
+  </script>
 </body>
 
