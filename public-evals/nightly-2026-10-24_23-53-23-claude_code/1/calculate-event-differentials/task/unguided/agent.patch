+  <script>
+    // Calculates once on page load (no ticking interval), in the visitor's local time zone.
+    (function () {
+      var timer = document.getElementById('maple-timer');
+      var start = new Date(timer.dataset.start);
+      var end = new Date(timer.dataset.end);
+      var now = new Date();
+
+      function plural(n, word) {
+        return n + ' ' + word + (n === 1 ? '' : 's');
+      }
+
+      function span(ms) {
+        var hours = Math.floor(ms / 36e5);
+        return plural(Math.floor(hours / 24), 'day') + ', ' + plural(hours % 24, 'hour');
+      }
+
+      var remaining = document.getElementById('maple-remaining');
+      var elapsed = document.getElementById('maple-elapsed');
+
+      if (now < start) {
+        remaining.textContent = 'Starts in ' + span(start - now);
+        elapsed.textContent = 'Offer ends ' + end.toLocaleDateString(undefined, { dateStyle: 'long' });
+      } else if (now < end) {
+        remaining.textContent = span(end - now) + ' left';
+        elapsed.textContent = span(now - start) + ' since the offer started';
+      } else {
+        remaining.textContent = 'This offer has ended';
+        elapsed.textContent = 'It ran for ' + span(end - start);
+      }
+    })();
+  </script>
