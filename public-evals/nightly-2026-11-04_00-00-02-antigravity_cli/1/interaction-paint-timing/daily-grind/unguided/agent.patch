+      if (orderBtn) {
+        orderBtn.addEventListener('click', function (event) {
+          event.preventDefault();
+          const startTime = getInputTimestamp(event);
+          const targetView = orderBtn.getAttribute('data-view') || 'order-online';
+
+          measureInteractionPaint({
+            category: 'order-now',
+            label: 'Hero CTA: Order Now',
+            view: targetView,
+            startTime: startTime
+          }, function () {
+            applyViewDOMUpdates(targetView);
+          });
+
+          measureInteractionPaint({
+            category: 'view-switch',
+            label: 'View Switch: Order Online',
+            view: targetView,
+            startTime: startTime
+          });
+        });
+      }
+
+      // 3. "Seasonal Favorites" Cards Click + Client-Side View Switch
+      const seasonalGrid = document.getElementById('seasonal-favorites-grid');
+      if (seasonalGrid) {
+        seasonalGrid.addEventListener('click', function (event) {
+          const card = event.target.closest('.card');
+          if (!card) return;
+
+          event.preventDefault();
+          const startTime = getInputTimestamp(event);
+          const itemName = card.getAttribute('data-item') || (card.querySelector('h3') ? card.querySelector('h3').textContent.trim() : 'Seasonal Card');
+          const targetView = card.getAttribute('data-view') || 'menu-seasonal';
+
+          measureInteractionPaint({
+            category: 'seasonal-card',
+            label: 'Seasonal Card: ' + itemName,
+            view: targetView,
+            startTime: startTime
+          }, function () {
+            applyViewDOMUpdates(targetView, card);
+          });
+
+          measureInteractionPaint({
+            category: 'view-switch',
+            label: 'View Switch: ' + itemName,
+            view: targetView,
+            startTime: startTime
+          });
+        });
+      }
+
+      // 4. Dedicated Client-Side View Switch Controls & Popstate
+      document.querySelectorAll('[data-switch-view]').forEach(function (btn) {
+        btn.addEventListener('click', function (event) {
+          const startTime = getInputTimestamp(event);
+          const targetView = btn.getAttribute('data-switch-view') || 'home';
+          switchView(targetView, {
+            startTime: startTime,
+            label: 'Direct View Switch: ' + targetView
+          });
+        });
+      });
+
+      const resetViewBtn = document.getElementById('reset-view-btn');
+      if (resetViewBtn) {
+        resetViewBtn.addEventListener('click', function (event) {
+          const startTime = getInputTimestamp(event);
+          switchView('home', {
+            startTime: startTime,
+            label: 'Reset View: Home'
+          });
+        });
+      }
+
+      window.addEventListener('popstate', function (event) {
+        const startTime = performance.now();
+        const targetView = (event.state && event.state.view) || (window.location.hash ? window.location.hash.slice(1) : 'home');
+        switchView(targetView, {
+          startTime: startTime,
+          label: 'History View Switch: ' + targetView
+        });
+      });
+
+      const clearBtn = document.getElementById('clear-perf-btn');
+      if (clearBtn) {
+        clearBtn.addEventListener('click', function () {
+          entries.length = 0;
+          if (performance.clearMarks) performance.clearMarks();
+          if (performance.clearMeasures) performance.clearMeasures();
+          updateSummaryStats();
+          const tbody = document.getElementById('perf-log-tbody');
+          if (tbody) {
+            tbody.innerHTML =
+              '<tr id="perf-empty-row">' +
+              '<td colspan="7" style="text-align: center; color: #795548;">' +
+              'Click the navigation bar, "Order Now" button, "Seasonal Favorites" cards, or view switch controls to record paint timings.' +
+              '</td></tr>';
+          }
+        });
+      }
+
+      // Expose performance monitoring API globally for programmatic inspection
+      window.DailyGrindPerfMonitor = {
+        entries: entries,
+        getEntries: function () { return entries.slice(); },
+        getEntriesByCategory: function (category) {
+          return entries.filter(function (e) { return e.category === category; });
+        },
+        measureInteractionPaint: measureInteractionPaint,
+        switchView: switchView
+      };
+    })();
+  </script>
+
 </body>
 
 </html>
