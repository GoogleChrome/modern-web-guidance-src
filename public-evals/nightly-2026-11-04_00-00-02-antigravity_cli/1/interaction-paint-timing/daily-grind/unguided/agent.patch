+
+      function updateSummaryStats() {
+        const categories = [
+          { key: 'navigation', latestId: 'stat-nav-latest', metaId: 'stat-nav-meta', unit: 'interactions' },
+          { key: 'order-now', latestId: 'stat-order-latest', metaId: 'stat-order-meta', unit: 'interactions' },
+          { key: 'seasonal-card', latestId: 'stat-seasonal-latest', metaId: 'stat-seasonal-meta', unit: 'interactions' },
+          { key: 'view-switch', latestId: 'stat-view-latest', metaId: 'stat-view-meta', unit: 'transitions' }
+        ];
+
+        categories.forEach(function (cat) {
+          const matching = entries.filter(function (e) { return e.category === cat.key; });
+          const latestEl = document.getElementById(cat.latestId);
+          const metaEl = document.getElementById(cat.metaId);
+          if (!latestEl || !metaEl) return;
+
+          if (matching.length === 0) {
+            latestEl.textContent = '—';
+            metaEl.textContent = '0 ' + cat.unit + ' (avg: —)';
+          } else {
+            const latest = matching[matching.length - 1];
+            const sum = matching.reduce(function (acc, item) { return acc + item.paintDuration; }, 0);
+            const avg = sum / matching.length;
+            latestEl.textContent = formatMs(latest.paintDuration);
+            metaEl.textContent = matching.length + ' ' + cat.unit + ' (avg: ' + formatMs(avg) + ')';
+          }
+        });
+      }
+
+      function appendLogRow(entry) {
