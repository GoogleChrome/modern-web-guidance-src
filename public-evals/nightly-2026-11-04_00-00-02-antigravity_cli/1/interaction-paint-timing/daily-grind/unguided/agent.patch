+      function measureInteractionPaint(options, domMutationFn) {
+        const startTime = typeof options.startTime === 'number' ? options.startTime : performance.now();
+        const markPrefix = 'dg-' + options.category + '-' + (entries.length + 1);
+
+        if (performance.mark) {
