+      function afterNextPaint(callback) {
+        requestAnimationFrame(function () {
+          requestAnimationFrame(function () {
+            const paintEndTime = performance.now();
+            callback(paintEndTime);
+          });
+        });
+      }
+
+      function getInputTimestamp(event) {
+        if (event && typeof event.timeStamp === 'number' && event.timeStamp > 0 && event.timeStamp <= performance.now()) {
+          return event.timeStamp;
+        }
