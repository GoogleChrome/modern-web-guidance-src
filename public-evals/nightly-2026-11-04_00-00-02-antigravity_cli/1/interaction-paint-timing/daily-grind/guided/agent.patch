+  <script type="module">
+    const perfLogEl = document.getElementById('perf-log');
+    const perfStatusEl = document.getElementById('perf-status');
+    const detailOutlet = document.getElementById('interaction-detail-outlet');
+    const routeOutlet = document.getElementById('route-view-outlet');
+
+    // Expose telemetry store for programmatic inspection
+    const perfTelemetry = {
+      interactionPaints: [],
+      softNavigations: [],
+      hardLCP: null,
+      events: [],
+    };
+    window.__dailyGrindPerf = perfTelemetry;
+
+    function appendLog(message, detailObj) {
+      if (perfLogEl && perfLogEl.firstElementChild?.textContent?.startsWith('Waiting for')) {
+        perfLogEl.innerHTML = '';
+      }
+      if (perfLogEl) {
+        const li = document.createElement('li');
+        li.textContent = message;
+        perfLogEl.prepend(li);
+      }
+      window.dispatchEvent(new CustomEvent('dailygrind:perf', { detail: detailObj }));
+    }
+
+    /**
+     * Observes contentful paints caused by user interactions (nav clicks, Order Now,
+     * Seasonal Favorites cards) and invokes a callback whenever an interaction
+     * produces a larger contentful paint.
+     *
+     * @param {(entry: PerformanceEntry) => void} onInteractionPaint
+     */
+    export function observeInteractionPaints(onInteractionPaint) {
+      // Feature-detect support before calling observe() so unsupported browsers
+      // do not throw or log console warnings.
+      if (
+        typeof PerformanceObserver === 'undefined' ||
+        !PerformanceObserver.supportedEntryTypes?.includes('interaction-contentful-paint')
+      ) {
+        return null;
+      }
+
+      const observer = new PerformanceObserver((list) => {
+        for (const entry of list.getEntries()) {
+          // entry.duration is already calculated as (entry.presentationTime - entry.startTime),
+          // giving the total time from the user interaction to this contentful paint.
+          onInteractionPaint(entry);
+        }
+      });
+
+      // MANDATORY: Pass buffered: true to capture interaction paints that occurred
+      // before this observer was registered.
+      observer.observe({ type: 'interaction-contentful-paint', buffered: true });
+      return observer;
+    }
+
+    /**
+     * Tracks FCP and LCP for each client-side soft navigation (view switch) and reports
+     * finalized route metrics when the user navigates to a new route or hides the page.
+     *
+     * @param {(report: {
+     *   url: string,
+     *   navigationId: number,
+     *   interactionId: number,
+     *   fcpDuration: number,
+     *   lcpDuration: number | null,
+     *   lcpElement: Element | null,
+     *   lcpSize: number | null
+     * }) => void} onSoftNavReport
+     */
+    export function trackSoftNavigationLCP(onSoftNavReport) {
+      const supported =
+        typeof PerformanceObserver !== 'undefined' &&
+        PerformanceObserver.supportedEntryTypes?.includes('soft-navigation') &&
+        PerformanceObserver.supportedEntryTypes?.includes('interaction-contentful-paint');
+
+      if (!supported) {
+        return null;
+      }
+
+      let activeSoftNav = null;
+      let activeLcpEntry = null;
+
+      function finalizeCurrentSoftNav() {
+        if (!activeSoftNav) return;
+
+        onSoftNavReport({
+          // activeSoftNav.name holds the destination URL of the soft navigation.
+          url: activeSoftNav.name,
+          navigationId: activeSoftNav.navigationId,
+          interactionId: activeSoftNav.interactionId,
+          // activeSoftNav.duration is (activeSoftNav.presentationTime - activeSoftNav.startTime),
+          // which represents First Contentful Paint (FCP) relative to interaction start.
+          fcpDuration: activeSoftNav.duration,
+          // activeLcpEntry.duration is (activeLcpEntry.presentationTime - activeSoftNav.startTime),
+          // representing the soft navigation's LCP duration relative to interaction start.
+          lcpDuration: activeLcpEntry ? activeLcpEntry.duration : null,
+          lcpElement: activeLcpEntry?.largestContentfulPaint?.element ?? null,
+          lcpSize: activeLcpEntry?.largestContentfulPaint?.size ?? null,
+        });
+
+        activeSoftNav = null;
+        activeLcpEntry = null;
+      }
+
+      const softNavObserver = new PerformanceObserver((list) => {
+        for (const softNavEntry of list.getEntries()) {
+          // Finalize the previous route's metrics before resetting state for the new route.
+          finalizeCurrentSoftNav();
+
+          activeSoftNav = softNavEntry;
+          // MANDATORY: Seed the LCP candidate with getLargestInteractionContentfulPaint()
+          // to capture any attributed contentful paints that occurred before the URL updated.
+          activeLcpEntry = softNavEntry.getLargestInteractionContentfulPaint();
+        }
+      });
+
+      const icpObserver = new PerformanceObserver((list) => {
+        for (const icpEntry of list.getEntries()) {
+          // MANDATORY: Match by interactionId (not navigationId) so only paints caused
+          // by the soft navigation's initiating interaction update the route's LCP.
+          if (activeSoftNav && icpEntry.interactionId === activeSoftNav.interactionId) {
+            activeLcpEntry = icpEntry;
+          }
+        }
+      });
+
+      softNavObserver.observe({ type: 'soft-navigation', buffered: true });
+      icpObserver.observe({ type: 'interaction-contentful-paint', buffered: true });
+
+      // Finalize the active route's LCP when the page is backgrounded or unloaded.
+      document.addEventListener('visibilitychange', () => {
+        if (document.visibilityState === 'hidden') {
+          finalizeCurrentSoftNav();
+        }
+      });
+
+      return { softNavObserver, icpObserver, finalizeCurrentSoftNav };
+    }
+
+    /**
+     * Keep standard hard-navigation observers active across all browsers as a
+     * baseline fallback when InteractionContentfulPaint or PerformanceSoftNavigation
+     * are unavailable.
+     */
+    function observeStandardBaselineMetrics() {
+      if (typeof PerformanceObserver === 'undefined') return;
+
+      if (PerformanceObserver.supportedEntryTypes?.includes('largest-contentful-paint')) {
+        const lcpObserver = new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            perfTelemetry.hardLCP = entry;
+          }
+        });
+        lcpObserver.observe({ type: 'largest-contentful-paint', buffered: true });
+      }
+
+      if (PerformanceObserver.supportedEntryTypes?.includes('event')) {
+        const eventObserver = new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            if (entry.interactionId) {
+              perfTelemetry.events.push({
+                name: entry.name,
+                interactionId: entry.interactionId,
+                duration: entry.duration,
+                startTime: entry.startTime,
+                 presentationTime: entry.presentationTime ?? (entry.startTime + entry.duration),
+                target: entry.target?.tagName ?? null,
+              });
+            }
+          }
+        });
+        eventObserver.observe({ type: 'event', buffered: true });
+      }
+    }
+
+    // Initialize observers
+    let lastInteractionLabel = 'User Interaction';
+
+    const icpObs = observeInteractionPaints((entry) => {
+      const lcpInfo = entry.largestContentfulPaint;
+      const record = {
+        type: 'interaction-contentful-paint',
+        label: lastInteractionLabel,
+        interactionId: entry.interactionId,
+        startTime: entry.startTime,
+        paintTime: entry.paintTime,
+        presentationTime: entry.presentationTime,
+        duration: entry.duration,
+        element: lcpInfo?.element ?? null,
+        size: lcpInfo?.size ?? null,
+      };
+      perfTelemetry.interactionPaints.push(record);
+      appendLog(
+        `[ICP] ${record.label}: ${entry.duration.toFixed(1)}ms (id: ${entry.interactionId})`,
+        record
+      );
+    });
+
+    const softNavObs = trackSoftNavigationLCP((report) => {
+      const record = {
+        type: 'soft-navigation',
+        ...report,
+      };
+      perfTelemetry.softNavigations.push(record);
+      const lcpText = report.lcpDuration != null ? `${report.lcpDuration.toFixed(1)}ms` : 'N/A';
+      appendLog(
+        `[SoftNav] ${report.url} — FCP: ${report.fcpDuration.toFixed(1)}ms, LCP: ${lcpText}`,
+        record
+      );
+    });
+
+    observeStandardBaselineMetrics();
+
+    if (perfStatusEl) {
+      perfStatusEl.textContent = icpObs && softNavObs ? 'ICP + SoftNav Active' : 'Baseline Fallback';
+    }
+
+    // View definitions for client-side navigation & interaction visual updates
+    const VIEWS = {
+      '/menu': {
+        title: 'Full Artisanal Menu',
+        description: 'Explore our single-origin pour-overs, signature espresso drinks, and house-baked pastries crafted fresh every morning.',
+      },
+      '/locations': {
+        title: 'Our Coffeehouses',
+        description: 'Visit our flagship roastery in Downtown, our cozy neighborhood cafe in Westside, or our sunny garden patio in North Hills.',
+      },
+      '/rewards': {
+        title: 'Daily Grind Rewards',
+        description: 'Earn 2 Beans for every $1 spent. Redeem Beans for complimentary handcrafted beverages, whole-bean bags, and exclusive tastings.',
+      },
+      '/account': {
+        title: 'My Account Dashboard',
+        description: 'Manage your recurring coffee subscriptions, saved payment methods, favorite drink customizations, and order history.',
+      },
+      '/logout': {
+        title: 'Signed Out',
+        description: 'You have been safely signed out of your Daily Grind account. Come back soon for your next cup!',
+      },
+      '/order-online': {
+        title: 'Order Online for Pickup or Delivery',
+        description: 'Select your nearest Daily Grind location, customize your roast and milk preferences, and skip the line with express pickup.',
+      },
+      '/menu/seasonal': {
+        title: 'Maple Oat Latte — Seasonal Favorite',
+        description: 'Rich double-shot espresso combined with velvety steamed oat milk, pure grade-A Vermont maple syrup, and a dash of cinnamon.',
+      },
+      '/menu/espresso': {
+        title: 'Dark Roast Espresso — Roaster Choice',
+        description: 'Full-bodied Latin American & Sumatran blend roasted dark for intense notes of bittersweet cocoa, cedar, and caramelized sugar.',
+      },
+      '/menu/cold-brew': {
+        title: '18-Hour Cold Brew — House Classic',
+        description: 'Coarse-ground Ethiopian and Colombian beans steeped in cold filtered water for 18 hours for an ultra-smooth, low-acid finish.',
+      },
+    };
+
+    function renderClientView(path, label) {
+      lastInteractionLabel = label;
+      const viewData = VIEWS[path] || {
+        title: 'The Daily Grind',
+        description: 'Ethically sourced, locally roasted, delivered to your cup.',
+      };
+
+      // Update DOM with new contentful elements and update URL for client-side view switch
+      if (path.startsWith('/menu/') || path === '/order-online') {
+        detailOutlet.innerHTML = `
+          <div class="detail-banner" data-view-path="${path}">
+            <h3>${viewData.title}</h3>
+            <p>${viewData.description}</p>
+          </div>
+        `;
+      } else {
+        detailOutlet.innerHTML = '';
+      }
+
+      routeOutlet.innerHTML = `
+        <article class="view-panel" data-route-view="${path}">
+          <h2>${viewData.title}</h2>
+          <p>${viewData.description}</p>
+        </article>
+      `;
+
+      if (window.location.pathname !== path) {
+        history.pushState({ path, label }, viewData.title, path);
+      }
+    }
+
+    // Handle clicks on Navigation bar links
+    document.querySelectorAll('nav a').forEach((link) => {
+      link.addEventListener('click', (event) => {
+        event.preventDefault();
+        const path = link.getAttribute('href') || '/';
+        const label = `Nav: ${link.textContent.trim()}`;
+        renderClientView(path, label);
+      });
+    });
+
+    // Handle clicks on "Order Now" button
+    const orderNowBtn = document.getElementById('order-now-btn');
+    if (orderNowBtn) {
+      orderNowBtn.addEventListener('click', (event) => {
+        event.preventDefault();
+        const path = orderNowBtn.getAttribute('href') || '/order-online';
+        renderClientView(path, 'Button: Order Now');
+      });
+    }
+
+    // Handle clicks on "Seasonal Favorites" cards (both card container and its button)
+    document.querySelectorAll('.card[data-favorite-card]').forEach((card) => {
+      card.addEventListener('click', (event) => {
+        event.preventDefault();
+        const cardLink = card.querySelector('a.btn');
+        const path = cardLink ? cardLink.getAttribute('href') : '/menu/seasonal';
+        const title = card.querySelector('h3')?.textContent?.trim() || 'Seasonal Favorite';
+        renderClientView(path, `Card: ${title}`);
+      });
+    });
+
+    // Support browser back/forward navigation
+    window.addEventListener('popstate', () => {
+      const path = window.location.pathname;
+      renderClientView(path, `View Switch: ${path}`);
+    });
+  </script>
 </body>
 
