+  <script type="module">
+    const ORIGINS = [
+      { name: 'Ethiopian Yirgacheffe', baseAcidity: 85, baseBody: 45, baseSweetness: 80, notes: 'Bergamot, Jasmine, Peach' },
+      { name: 'Colombian Supremo', baseAcidity: 65, baseBody: 70, baseSweetness: 75, notes: 'Caramel, Red Apple, Hazelnut' },
+      { name: 'Sumatra Mandheling', baseAcidity: 30, baseBody: 95, baseSweetness: 55, notes: 'Dark Chocolate, Cedar, Earthy Spice' },
+      { name: 'Guatemalan Antigua', baseAcidity: 70, baseBody: 75, baseSweetness: 70, notes: 'Cocoa, Orange Zest, Brown Sugar' },
+      { name: 'Brazil Cerrado', baseAcidity: 40, baseBody: 80, baseSweetness: 85, notes: 'Roasted Almond, Milk Chocolate, Molasses' },
+      { name: 'Kenyan AA', baseAcidity: 90, baseBody: 65, baseSweetness: 65, notes: 'Blackcurrant, Grapefruit, Winey' }
+    ];
+
+    const BREW_METHODS = ['Espresso Extraction', 'Pour-Over V60', 'Cold Immersion', 'French Press', 'AeroPress Micro-Lot'];
+
+    const batchSizeSelect = document.getElementById('batch-size');
+    const roastTargetInput = document.getElementById('roast-target');
+    const acidityTargetInput = document.getElementById('acidity-target');
+    const bodyTargetInput = document.getElementById('body-target');
+    const roastValSpan = document.getElementById('roast-target-val');
+    const acidityValSpan = document.getElementById('acidity-target-val');
+    const bodyValSpan = document.getElementById('body-target-val');
+
+    const runBtn = document.getElementById('run-simulation-btn');
+    const cancelBtn = document.getElementById('cancel-simulation-btn');
+    const tastingBtn = document.getElementById('tasting-note-btn');
+    const tastingCounterSpan = document.getElementById('tasting-counter');
+
+    const statusSpan = document.getElementById('simulation-status');
+    const percentageSpan = document.getElementById('simulation-percentage');
+    const progressBar = document.getElementById('simulation-progress');
+
+    const statProcessed = document.getElementById('stat-processed');
+    const statYields = document.getElementById('stat-yields');
+    const statElapsed = document.getElementById('stat-elapsed');
+    const statBestScore = document.getElementById('stat-best-score');
+    const blendResultsContainer = document.getElementById('blend-results');
+
+    let tastingCount = 0;
+    let isCancelled = false;
+
+    tastingBtn.addEventListener('click', () => {
+      tastingCount++;
+      tastingCounterSpan.textContent = String(tastingCount);
+    });
+
+    function updateRangeLabels() {
+      const r = Number(roastTargetInput.value);
+      const rLabel = r < 40 ? 'Light' : r < 70 ? 'Medium-Dark' : 'Dark';
+      roastValSpan.textContent = `${rLabel} (${r}%)`;
+
+      const a = Number(acidityTargetInput.value);
+      const aLabel = a < 40 ? 'Smooth' : a < 70 ? 'Balanced' : 'Bright';
+      acidityValSpan.textContent = `${aLabel} (${a}%)`;
+
+      const b = Number(bodyTargetInput.value);
+      const bLabel = b < 40 ? 'Delicate' : b < 70 ? 'Velvety' : 'Rich';
+      bodyValSpan.textContent = `${bLabel} (${b}%)`;
+    }
+
+    roastTargetInput.addEventListener('input', updateRangeLabels);
+    acidityTargetInput.addEventListener('input', updateRangeLabels);
+    bodyTargetInput.addEventListener('input', updateRangeLabels);
+
+    async function yieldToMain() {
+      if ('scheduler' in window && 'yield' in window.scheduler) {
+        await window.scheduler.yield();
+      } else {
+        await new Promise(resolve => setTimeout(resolve, 0));
+      }
+    }
+
+    function generateRecipeBatch(count) {
+      const recipes = [];
+      for (let i = 0; i < count; i++) {
+        const primary = ORIGINS[i % ORIGINS.length];
+        const secondary = ORIGINS[(i * 7 + 3) % ORIGINS.length];
+        const ratioPrimary = 40 + ((i * 13) % 51); // 40% to 90%
+        const ratioSecondary = 100 - ratioPrimary;
+        const roastIntensity = 15 + ((i * 17) % 81); // 15 to 95
+        const brewTempC = 88 + (i % 9); // 88C to 96C
+        const brewMethod = BREW_METHODS[i % BREW_METHODS.length];
+
+        recipes.push({
+          id: i + 1,
+          name: `Lot #${1000 + i}: ${primary.name.split(' ')[0]} & ${secondary.name.split(' ')[0]}`,
+          composition: `${ratioPrimary}% ${primary.name} / ${ratioSecondary}% ${secondary.name}`,
+          brewMethod,
+          brewTempC,
+          roastIntensity,
+          primary,
+          secondary,
+          ratioPrimary: ratioPrimary / 100,
+          ratioSecondary: ratioSecondary / 100,
+          notes: `${primary.notes.split(', ')[0]}, ${secondary.notes.split(', ')[1] || secondary.notes}`
+        });
+      }
+      return recipes;
+    }
+
+    function simulateFlavorProfile(recipe, targets) {
+      // Perform multi-step extraction kinetics & Maillard reaction simulation per blend
+      let extractionYield = 0;
+      let volatileRetention = 1;
+      for (let step = 1; step <= 180; step++) {
+        const thermalFactor = Math.sin((recipe.brewTempC * step) / 180) * Math.cos(recipe.roastIntensity / 100);
+        extractionYield += Math.abs(thermalFactor) * 0.12;
+        volatileRetention = (volatileRetention * 0.992) + Math.abs(Math.sin(step * 0.05)) * 0.008;
+      }
+
+      const rawAcidity =
+        (recipe.primary.baseAcidity * recipe.ratioPrimary + recipe.secondary.baseAcidity * recipe.ratioSecondary) *
+        (1 - (recipe.roastIntensity - 50) * 0.004) *
+        (0.85 + volatileRetention * 0.15);
+
+      const rawBody =
+        (recipe.primary.baseBody * recipe.ratioPrimary + recipe.secondary.baseBody * recipe.ratioSecondary) *
+        (1 + (recipe.roastIntensity - 50) * 0.003) +
+        (extractionYield % 12);
+
+      const simulatedAcidity = Math.max(10, Math.min(100, Math.round(rawAcidity)));
+      const simulatedBody = Math.max(10, Math.min(100, Math.round(rawBody)));
+      const simulatedRoast = recipe.roastIntensity;
+
+      const roastDiff = Math.abs(simulatedRoast - targets.roast);
+      const acidityDiff = Math.abs(simulatedAcidity - targets.acidity);
+      const bodyDiff = Math.abs(simulatedBody - targets.body);
+
+      const matchScore = Math.max(0, +(100 - (roastDiff * 0.35 + acidityDiff * 0.35 + bodyDiff * 0.3)).toFixed(1));
+
+      return {
+        ...recipe,
+        simulatedRoast,
+        simulatedAcidity,
+        simulatedBody,
+        matchScore
+      };
+    }
+
+    function renderTopBlends(topBlends) {
+      blendResultsContainer.replaceChildren();
+      for (const blend of topBlends) {
+        const card = document.createElement('article');
+        card.className = 'blend-card';
+        card.innerHTML = `
+          <div class="blend-card-header">
+            <strong>${blend.name}</strong>
+            <span class="blend-score">${blend.matchScore}% Match</span>
+          </div>
+          <p style="font-size: 0.85rem; margin-bottom: 6px;">${blend.composition}</p>
+          <p style="font-size: 0.8rem; color: #6d4c41; margin-bottom: 10px;">
+            Method: ${blend.brewMethod} (${blend.brewTempC}&deg;C) &bull; Notes: ${blend.notes}
+          </p>
+          <div class="flavor-meter">
+            <div class="flavor-meter-label"><span>Roast Profile</span><span>${blend.simulatedRoast}%</span></div>
+            <div class="flavor-bar-bg"><div class="flavor-bar-fill" style="width: ${blend.simulatedRoast}%"></div></div>
+          </div>
+          <div class="flavor-meter">
+            <div class="flavor-meter-label"><span>Acidity</span><span>${blend.simulatedAcidity}%</span></div>
+            <div class="flavor-bar-bg"><div class="flavor-bar-fill" style="width: ${blend.simulatedAcidity}%"></div></div>
+          </div>
+          <div class="flavor-meter">
+            <div class="flavor-meter-label"><span>Body &amp; Sweetness</span><span>${blend.simulatedBody}%</span></div>
+            <div class="flavor-bar-bg"><div class="flavor-bar-fill" style="width: ${blend.simulatedBody}%"></div></div>
+          </div>
+        `;
+        blendResultsContainer.appendChild(card);
+      }
+    }
+
+    async function processRecipeBatch(recipes, targets) {
+      const startTime = performance.now();
+      let deadline = performance.now() + 50;
+      let yieldCount = 0;
+      let processedCount = 0;
+      const topBlends = [];
+
+      for (const recipe of recipes) {
+        if (isCancelled) {
+          break;
+        }
+
+        const result = simulateFlavorProfile(recipe, targets);
+        processedCount++;
+
+        if (topBlends.length < 6 || result.matchScore > topBlends[topBlends.length - 1].matchScore) {
+          topBlends.push(result);
+          topBlends.sort((a, b) => b.matchScore - a.matchScore);
+          if (topBlends.length > 6) {
+            topBlends.pop();
+          }
+        }
+
+        // Yield to the main thread periodically when the 50ms budget is exceeded
+        if (performance.now() >= deadline) {
+          const pct = Math.round((processedCount / recipes.length) * 100);
+          progressBar.value = pct;
+          percentageSpan.textContent = `${pct}%`;
+          statProcessed.textContent = processedCount.toLocaleString();
+          statYields.textContent = String(yieldCount + 1);
+          statElapsed.textContent = `${Math.round(performance.now() - startTime)} ms`;
+          if (topBlends.length > 0) {
+            statBestScore.textContent = `${topBlends[0].matchScore}%`;
+          }
+
+          await yieldToMain();
+          yieldCount++;
+          deadline = performance.now() + 50;
+        }
+      }
+
+      const totalElapsed = Math.round(performance.now() - startTime);
+      const finalPct = Math.round((processedCount / recipes.length) * 100);
+      progressBar.value = finalPct;
+      percentageSpan.textContent = `${finalPct}%`;
+      statProcessed.textContent = processedCount.toLocaleString();
+      statYields.textContent = String(yieldCount);
+      statElapsed.textContent = `${totalElapsed} ms`;
+      if (topBlends.length > 0) {
+        statBestScore.textContent = `${topBlends[0].matchScore}%`;
+        renderTopBlends(topBlends);
+      }
+
+      statusSpan.textContent = isCancelled
+        ? `Simulation stopped after ${processedCount.toLocaleString()} recipes.`
+        : `Completed ${processedCount.toLocaleString()} recipe simulations across ${yieldCount} main-thread yields.`;
+    }
+
+    runBtn.addEventListener('click', async () => {
+      isCancelled = false;
+      runBtn.disabled = true;
+      cancelBtn.disabled = false;
+
+      const batchSize = Number(batchSizeSelect.value);
+      const targets = {
+        roast: Number(roastTargetInput.value),
+        acidity: Number(acidityTargetInput.value),
+        body: Number(bodyTargetInput.value)
+      };
+
+      statusSpan.textContent = `Simulating ${batchSize.toLocaleString()} coffee blends...`;
+      progressBar.value = 0;
+      percentageSpan.textContent = '0%';
+
+      const recipes = generateRecipeBatch(batchSize);
+      await processRecipeBatch(recipes, targets);
+
+      runBtn.disabled = false;
+      cancelBtn.disabled = true;
+    });
+
+    cancelBtn.addEventListener('click', () => {
+      isCancelled = true;
+      cancelBtn.disabled = true;
+    });
+
+    // Run an initial default batch on load so top blends are immediately visible
+    runBtn.click();
+  </script>
