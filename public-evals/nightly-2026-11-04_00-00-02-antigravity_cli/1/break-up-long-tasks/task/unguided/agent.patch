+        const rawBitterness = (primaryOrigin.bitterness * w1 + secondaryOrigin.bitterness * w2 + tertiaryOrigin.bitterness * w3) * brewMod.bitterness * roastMod.bitterness;
+        const rawAroma = (primaryOrigin.aroma * w1 + secondaryOrigin.aroma * w2 + tertiaryOrigin.aroma * w3) * brewMod.aroma * roastMod.aroma;
+
+        const acidity = clamp10(rawAcidity + (extractionEfficiency % 0.6) - 0.3);
+        const body = clamp10(rawBody + (maillardFactor % 0.7) - 0.35);
+        const sweetness = clamp10(rawSweetness + (volatileRetention % 0.8) - 0.3);
+        const bitterness = clamp10(rawBitterness + ((extractionEfficiency + maillardFactor) % 0.6) - 0.3);
+        const aroma = clamp10(rawAroma + (volatileRetention % 0.6) - 0.2);
+
+        // Calculate harmony score (0 - 100) rewarding sweetness, aroma, balanced acidity/body, and controlled bitterness
+        const bitternessPenalty = Math.abs(bitterness - 5.2) * 1.4;
+        const roastBonus = (roastFilter === 'all' || primaryOrigin.roastAffinity === roastFilter) ? 3.2 : 0.8;
+        const harmonyScore = Math.min(
+          99.8,
+          Math.max(
+            55.0,
+            acidity * 2.1 + body * 2.2 + sweetness * 2.8 + aroma * 2.5 - bitternessPenalty + roastBonus
+          )
+        );
+
+        return {
+          id: index + 1,
+          name: `Blend #${String(index + 1).padStart(4, '0')}: ${primaryOrigin.name.split(' ')[0]} / ${secondaryOrigin.name.split(' ')[0]}`,
+          composition: `${r1}% ${primaryOrigin.name}, ${r2}% ${secondaryOrigin.name}, ${r3}% ${tertiaryOrigin.name}`,
+          notes: `${primaryOrigin.notes.split(',')[0]}, ${secondaryOrigin.notes.split(',')[1].trim()}`,
+          brewLabel: brewMod.label,
+          acidity,
+          body,
+          sweetness,
+          bitterness,
+          aroma,
+          harmonyScore
+        };
+      }
+
+      function updateProgressUI(processed, total, yieldsCount, avgChunkDuration, sums, topBlends) {
+        const pct = total > 0 ? Math.round((processed / total) * 100) : 0;
+        progressPercent.textContent = `${pct}% (${processed.toLocaleString()} / ${total.toLocaleString()})`;
+        progressBar.style.width = `${pct}%`;
+        statProcessed.textContent = processed.toLocaleString();
+        statYields.textContent = yieldsCount.toLocaleString();
+        statChunkMs.textContent = `${avgChunkDuration.toFixed(1)} ms`;
+
+        if (processed > 0) {
+          const avgAcidity = sums.acidity / processed;
+          const avgBody = sums.body / processed;
+          const avgSweetness = sums.sweetness / processed;
+          const avgBitterness = sums.bitterness / processed;
+          const avgAroma = sums.aroma / processed;
+          const avgHarmony = sums.harmony / processed;
+
+          metricElements.acidity.val.textContent = `${avgAcidity.toFixed(1)} / 10`;
+          metricElements.acidity.bar.style.width = `${avgAcidity * 10}%`;
+
+          metricElements.body.val.textContent = `${avgBody.toFixed(1)} / 10`;
+          metricElements.body.bar.style.width = `${avgBody * 10}%`;
+
+          metricElements.sweetness.val.textContent = `${avgSweetness.toFixed(1)} / 10`;
+          metricElements.sweetness.bar.style.width = `${avgSweetness * 10}%`;
+
+          metricElements.bitterness.val.textContent = `${avgBitterness.toFixed(1)} / 10`;
+          metricElements.bitterness.bar.style.width = `${avgBitterness * 10}%`;
+
+          metricElements.aroma.val.textContent = `${avgAroma.toFixed(1)} / 10`;
+          metricElements.aroma.bar.style.width = `${avgAroma * 10}%`;
+
+          topHarmonyBadge.textContent = `Avg Harmony: ${avgHarmony.toFixed(1)} pts`;
+        }
+
+        if (topBlends.length > 0) {
+          qualifiedBlendsCount.textContent = `Top ${topBlends.length} of ${processed.toLocaleString()} analyzed`;
+          topBlendsList.innerHTML = topBlends
+            .map(
+              (b) => `
+              <div class="blend-item">
+                <div>
+                  <div class="blend-item-title">${b.name}</div>
+                  <div class="blend-item-meta">${b.composition}</div>
+                  <div class="blend-item-meta">Tasting Notes: <strong>${b.notes}</strong> &bull; ${b.brewLabel}</div>
+                </div>
+                <span class="blend-score-badge">${b.harmonyScore.toFixed(1)} pts</span>
+              </div>
+            `
+            )
+            .join('');
+        }
+      }
+
+      /**
+       * Processes a large batch of coffee recipe blends in time-sliced chunks,
+       * yielding to the main thread whenever the slice budget is reached so the page
+       * remains responsive throughout execution.
+       */
+      async function runBatchSimulation() {
+        const runId = ++activeRunId;
+        isRunning = true;
+
+        const totalBlends = Number(batchSizeInput.value) || 2500;
+        const roastFilter = roastLevelSelect.value;
+        const brewMethod = brewMethodSelect.value;
+        const maxSliceMs = Number(timeSliceInput.value) || 12;
+
+        runSimBtn.disabled = true;
+        cancelSimBtn.disabled = false;
+        statusLabel.textContent = `Simulating ${totalBlends.toLocaleString()} recipe blends in non-blocking chunks...`;
+        threadStatusText.textContent = `Yielding every ~${maxSliceMs}ms slice`;
+
+        const sums = { acidity: 0, body: 0, sweetness: 0, bitterness: 0, aroma: 0, harmony: 0 };
+        const topBlends = [];
+        let processed = 0;
+        let yieldsCount = 0;
+        let totalChunkTimeMs = 0;
+        let chunkCount = 0;
+
+        const startTimestamp = performance.now();
+        let sliceStart = performance.now();
+        let itemsInCurrentSlice = 0;
+
+        while (processed < totalBlends) {
+          if (runId !== activeRunId) {
+            return; // Cancelled or superseded
+          }
+
+          const result = simulateSingleRecipeBlend(processed, roastFilter, brewMethod);
+          processed++;
+          itemsInCurrentSlice++;
+
+          sums.acidity += result.acidity;
+          sums.body += result.body;
+          sums.sweetness += result.sweetness;
+          sums.bitterness += result.bitterness;
+          sums.aroma += result.aroma;
+          sums.harmony += result.harmonyScore;
+
+          if (topBlends.length < 6 || result.harmonyScore > topBlends[topBlends.length - 1].harmonyScore) {
+            topBlends.push(result);
+            topBlends.sort((a, b) => b.harmonyScore - a.harmonyScore);
+            if (topBlends.length > 6) {
+              topBlends.pop();
+            }
+          }
+
+          const now = performance.now();
+          const sliceElapsed = now - sliceStart;
+
+          // Break up long tasks well before the 50ms Long Task threshold (or every 150 items max)
+          if (sliceElapsed >= maxSliceMs || itemsInCurrentSlice >= 150 || processed === totalBlends) {
+            totalChunkTimeMs += sliceElapsed;
+            chunkCount++;
+            const avgChunk = totalChunkTimeMs / chunkCount;
+
+            updateProgressUI(processed, totalBlends, yieldsCount, avgChunk, sums, topBlends);
+
+            if (processed < totalBlends) {
+              yieldsCount++;
+              await yieldToMain();
+              sliceStart = performance.now();
+              itemsInCurrentSlice = 0;
+            }
+          }
+        }
+
+        if (runId !== activeRunId) {
+          return;
+        }
+
+        const totalElapsedSec = ((performance.now() - startTimestamp) / 1000).toFixed(2);
+        isRunning = false;
+        runSimBtn.disabled = false;
+        cancelSimBtn.disabled = true;
+        statusLabel.textContent = `Completed ${totalBlends.toLocaleString()} recipe simulations in ${totalElapsedSec}s (${yieldsCount} main-thread yields)`;
+        threadStatusText.textContent = 'Main Thread Responsive (Idle)';
+      }
+
+      function cancelSimulation() {
+        if (!isRunning) return;
+        activeRunId++;
+        isRunning = false;
+        runSimBtn.disabled = false;
+        cancelSimBtn.disabled = true;
+        statusLabel.textContent = 'Simulation paused / cancelled by user.';
+        threadStatusText.textContent = 'Main Thread Responsive (Cancelled)';
+      }
+
+      // Event Listeners
+      batchSizeInput.addEventListener('input', () => {
+        const val = Number(batchSizeInput.value);
+        batchSizeLabel.textContent = `${val.toLocaleString()} blends`;
+        if (!isRunning) {
+          progressPercent.textContent = `0% (0 / ${val.toLocaleString()})`;
+        }
+      });
+
+      timeSliceInput.addEventListener('input', () => {
+        timeSliceLabel.textContent = `${timeSliceInput.value} ms / chunk`;
+      });
+
+      runSimBtn.addEventListener('click', () => {
+        runBatchSimulation();
+      });
+
+      cancelSimBtn.addEventListener('click', () => {
+        cancelSimulation();
+      });
+
+      presetStressBtn.addEventListener('click', () => {
+        batchSizeInput.value = '5000';
+        batchSizeLabel.textContent = '5,000 blends';
+        runBatchSimulation();
+      });
+
+      pingBtn.addEventListener('click', () => {
+        pingCount++;
+        pingCounterEl.textContent = String(pingCount);
+      });
+
+      // Run an initial batch automatically on load so results are immediately visible and interactive
+      window.addEventListener('DOMContentLoaded', () => {
+        runBatchSimulation();
+      });
+    })();
+  </script>
 </body>
 
 </html>
