+  <script>
+    const form = document.getElementById('subscription-form');
+    const roastSlider = document.getElementById('roast-level');
+    const roastOutput = document.getElementById('roast-level-output');
+    const emailCheckbox = document.getElementById('email-updates');
+    const progressEl = document.getElementById('setup-progress');
+    const progressText = document.getElementById('setup-progress-text');
+
+    function getRoastName(val) {
+      const num = Number(val);
+      if (num < 34) return `Light Roast (${num}%)`;
+      if (num < 67) return `Medium Roast (${num}%)`;
+      return `Dark Roast (${num}%)`;
+    }
+
+    function updateProgress() {
+      let completedSteps = 0;
+      const totalSteps = 3;
+
+      const selectedFreq = form.querySelector('input[name="delivery_frequency"]:checked');
+      if (selectedFreq) completedSteps += 1;
+      if (roastSlider.value !== '') completedSteps += 1;
+      if (emailCheckbox.checked) completedSteps += 1;
+
+      const pct = Math.round((completedSteps / totalSteps) * 100);
+      progressEl.value = pct;
+      progressEl.textContent = `${pct}%`;
+      progressText.textContent = `${pct}%`;
+    }
+
+    roastSlider.addEventListener('input', (e) => {
+      const val = e.target.value;
+      roastOutput.textContent = getRoastName(val);
+      if (!CSS.supports('accent-color', '#4e342e')) {
+        e.target.style.setProperty('--progress', `${val}%`);
+      }
+      updateProgress();
+    });
+
+    form.addEventListener('change', updateProgress);
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      progressEl.value = 100;
+      progressEl.textContent = '100%';
+      progressText.textContent = '100% — Subscription Saved!';
+    });
+  </script>
