+  <script>
+    (function () {
+      const form = document.getElementById('coffee-subscription-form');
+      const progressBar = document.getElementById('subscription-progress');
+      const progressText = document.getElementById('progress-value-text');
+      const roastSlider = document.getElementById('roast-preference');
+      const roastLabel = document.getElementById('roast-level-label');
+      const emailCheckbox = document.getElementById('receive-emails');
+      const statusMsg = document.getElementById('subscription-status');
+
+      const roastNames = {
+        1: 'Light Roast (1/5)',
+        2: 'Medium-Light Roast (2/5)',
+        3: 'Medium Roast (3/5)',
+        4: 'Medium-Dark Roast (4/5)',
+        5: 'Dark Roast (5/5)'
+      };
+
+      function updateFormState() {
+        const selectedFrequency = form.querySelector('input[name="deliveryFrequency"]:checked');
+        const roastVal = roastSlider.value;
+        roastLabel.textContent = roastNames[roastVal] || 'Medium Roast (3/5)';
+
+        let completedSteps = 0;
+        if (selectedFrequency) completedSteps += 1;
+        if (roastVal) completedSteps += 1;
+        if (emailCheckbox.checked) completedSteps += 1;
+
+        const percentage = Math.round((completedSteps / 3) * 100);
+        progressBar.value = percentage;
+        progressBar.textContent = percentage + '%';
+        progressText.textContent = percentage + '%';
+      }
+
+      form.addEventListener('input', updateFormState);
+      form.addEventListener('change', updateFormState);
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        progressBar.value = 100;
+        progressBar.textContent = '100%';
+        progressText.textContent = '100%';
+        statusMsg.textContent = 'Your personalized coffee subscription preferences have been saved!';
+      });
+    })();
+  </script>
