+  <script>
+    (function () {
+      const CANDIDATE_SELECTOR = [
+        'a[href]',
+        'button:not(:disabled)',
+        'input:not(:disabled):not([type="hidden"])',
+        'select:not(:disabled)',
+        'textarea:not(:disabled)',
+        '[tabindex]'
+      ].join(', ');
+
+      const DIRECTION_KEYS = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight']);
+      const SUBPIXEL_TOLERANCE = 1;
+      const FALLBACK_PERPENDICULAR_WEIGHT = 2;
+
+      function getVisibleCandidates(container) {
+        return Array.from(container.querySelectorAll(CANDIDATE_SELECTOR)).filter((el) => {
+          if (el.disabled || el.hidden || el.closest('[hidden], [inert]')) {
+            return false;
+          }
+          if (typeof el.checkVisibility === 'function' && !el.checkVisibility()) {
+            return false;
+          }
+          return true;
+        });
+      }
+
+      function updateRovingTabindex(candidates, activeElement) {
+        if (candidates.length === 0) return;
+        const targetActive = activeElement && candidates.includes(activeElement)
+          ? activeElement
+          : candidates.find((el) => el.getAttribute('tabindex') === '0') || candidates[0];
+
+        for (const candidate of candidates) {
+          const desired = candidate === targetActive ? '0' : '-1';
+          if (candidate.getAttribute('tabindex') !== desired) {
+            candidate.setAttribute('tabindex', desired);
+          }
+        }
+      }
+
+      function findSpatialCandidate(currentElement, candidates, key) {
+        const currentRect = currentElement.getBoundingClientRect();
+        const isHorizontal = key === 'ArrowLeft' || key === 'ArrowRight';
+        const currentPerpCenter = isHorizontal
+          ? (currentRect.top + currentRect.bottom) / 2
+          : (currentRect.left + currentRect.right) / 2;
+
+        const alignedCandidates = [];
+        const fallbackCandidates = [];
+
+        for (const candidate of candidates) {
+          if (candidate === currentElement) continue;
+
+          const rect = candidate.getBoundingClientRect();
+          if (rect.width === 0 && rect.height === 0) continue;
+
+          let inDirection = false;
+          let gap = 0;
+
+          if (key === 'ArrowRight') {
+            inDirection = rect.left >= currentRect.right - SUBPIXEL_TOLERANCE;
+            gap = Math.max(0, rect.left - currentRect.right);
+          } else if (key === 'ArrowLeft') {
+            inDirection = rect.right <= currentRect.left + SUBPIXEL_TOLERANCE;
+            gap = Math.max(0, currentRect.left - rect.right);
+          } else if (key === 'ArrowDown') {
+            inDirection = rect.top >= currentRect.bottom - SUBPIXEL_TOLERANCE;
+            gap = Math.max(0, rect.top - currentRect.bottom);
+          } else if (key === 'ArrowUp') {
+            inDirection = rect.bottom <= currentRect.top + SUBPIXEL_TOLERANCE;
+            gap = Math.max(0, currentRect.top - rect.bottom);
+          }
+
+          if (!inDirection) continue;
+
+          const overlapsPerpendicular = isHorizontal
+            ? Math.min(currentRect.bottom, rect.bottom) > Math.max(currentRect.top, rect.top)
+            : Math.min(currentRect.right, rect.right) > Math.max(currentRect.left, rect.left);
+
+          const candidatePerpCenter = isHorizontal
+            ? (rect.top + rect.bottom) / 2
+            : (rect.left + rect.right) / 2;
+          const perpendicularCentreOffset = Math.abs(candidatePerpCenter - currentPerpCenter);
+
+          const entry = {
+            element: candidate,
+            gap,
+            perpendicularCentreOffset,
+            fallbackScore: gap + FALLBACK_PERPENDICULAR_WEIGHT * perpendicularCentreOffset
+          };
+
+          if (overlapsPerpendicular) {
+            alignedCandidates.push(entry);
+          } else {
+            fallbackCandidates.push(entry);
+          }
+        }
+
+        if (alignedCandidates.length > 0) {
+          alignedCandidates.sort((a, b) => {
+            if (Math.abs(a.gap - b.gap) > SUBPIXEL_TOLERANCE) {
+              return a.gap - b.gap;
+            }
+            return a.perpendicularCentreOffset - b.perpendicularCentreOffset;
+          });
+          return alignedCandidates[0].element;
+        }
+
+        if (fallbackCandidates.length > 0) {
+          fallbackCandidates.sort((a, b) => a.fallbackScore - b.fallbackScore);
+          return fallbackCandidates[0].element;
+        }
+
+        return null;
+      }
+
+      function initSpatialContainer(container) {
+        updateRovingTabindex(getVisibleCandidates(container));
+
+        container.addEventListener('focusin', (e) => {
+          const target = e.composedPath()[0] || e.target;
+          if (!(target instanceof Element)) return;
+          const candidates = getVisibleCandidates(container);
+          if (candidates.includes(target)) {
+            updateRovingTabindex(candidates, target);
+          }
+        });
+
+        container.addEventListener('keydown', (e) => {
+          if (e.defaultPrevented) return;
+          if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+          if (!DIRECTION_KEYS.has(e.key)) return;
+
+          const target = e.composedPath()[0] || e.target;
+          if (!(target instanceof Element)) return;
+
+          if (target.matches(':read-write, select, input[type="range"], [role="slider"]')) {
+            return;
+          }
+
+          const candidates = getVisibleCandidates(container);
+          if (!candidates.includes(target)) return;
+
+          const nextCandidate = findSpatialCandidate(target, candidates, e.key);
+          if (!nextCandidate) {
+            return;
+          }
+
+          e.preventDefault();
+          updateRovingTabindex(candidates, nextCandidate);
+          nextCandidate.focus();
+          nextCandidate.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        });
+
+        const observer = new MutationObserver(() => {
+          updateRovingTabindex(getVisibleCandidates(container));
+        });
+        observer.observe(container, {
+          childList: true,
+          subtree: true,
+          attributes: true,
+          attributeFilter: ['hidden', 'inert', 'disabled', 'style', 'class']
+        });
+      }
+
+      const gridContainer = document.querySelector('.grid');
+      if (gridContainer) {
+        initSpatialContainer(gridContainer);
+      }
+
+      const layoutButtons = document.querySelectorAll('.layout-btn[data-layout-mode]');
+      layoutButtons.forEach((button) => {
+        button.addEventListener('click', () => {
+          const mode = button.getAttribute('data-layout-mode');
+          if (!gridContainer || !mode) return;
+          gridContainer.setAttribute('data-layout', mode);
+          layoutButtons.forEach((btn) => {
+            btn.setAttribute('aria-pressed', String(btn === button));
+          });
+        });
+      });
+    })();
+  </script>
 </body>
 
