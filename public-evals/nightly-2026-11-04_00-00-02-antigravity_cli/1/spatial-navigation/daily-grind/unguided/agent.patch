+  <script>
+    (function () {
+      const grid = document.querySelector('.grid');
+      if (!grid) return;
+
+      const announcer = document.getElementById('grid-announcer');
+      const layoutButtons = document.querySelectorAll('[data-set-layout]');
+
+      function getCards() {
+        return Array.from(grid.querySelectorAll('.card')).filter((card) => {
+          const style = window.getComputedStyle(card);
+          return style.display !== 'none' && style.visibility !== 'hidden';
+        });
+      }
+
+      /**
+       * Groups cards into 2D visual rows based on their live bounding rectangles.
+       * Works across responsive multi-column grids, compact grids, single-column lists,
+       * and RTL/LTR directions.
+       */
+      function getVisualMatrix(cards) {
+        const items = cards.map((card, domIndex) => {
+          const rect = card.getBoundingClientRect();
+          return {
+            card,
+            domIndex,
+            rect,
+            centerX: rect.left + rect.width / 2,
+            centerY: rect.top + rect.height / 2,
+          };
+        });
+
+        // Sort top-to-bottom, then left-to-right
+        const sorted = [...items].sort((a, b) => {
+          const rowThreshold = Math.min(a.rect.height, b.rect.height) * 0.4 || 15;
+          if (Math.abs(a.rect.top - b.rect.top) > rowThreshold) {
+            return a.rect.top - b.rect.top;
+          }
+          return a.rect.left - b.rect.left;
+        });
+
+        const rows = [];
+        sorted.forEach((item) => {
+          if (rows.length === 0) {
+            rows.push([item]);
+            return;
+          }
+          const currentRow = rows[rows.length - 1];
+          const firstInRow = currentRow[0];
+          const rowThreshold = Math.min(firstInRow.rect.height, item.rect.height) * 0.4 || 15;
+          if (Math.abs(item.rect.top - firstInRow.rect.top) <= rowThreshold) {
+            currentRow.push(item);
+          } else {
+            rows.push([item]);
+          }
+        });
+
+        // Ensure each row is sorted horizontally left-to-right
+        rows.forEach((row) => row.sort((a, b) => a.rect.left - b.rect.left));
+        return rows;
+      }
+
+      /**
+       * Finds the target card in the given arrow direction using visual geometry
+       * and 2D row/column structure.
+       */
+      function findSpatialTarget(currentCard, key) {
+        const cards = getCards();
+        if (cards.length === 0) return null;
+
+        const currentIndex = cards.indexOf(currentCard);
+        if (currentIndex === -1) return cards[0];
+
+        if (key === 'Home') return cards[0];
+        if (key === 'End') return cards[cards.length - 1];
+
+        const rows = getVisualMatrix(cards);
+        let currentRowIdx = -1;
+        let currentColIdx = -1;
+        let currentItem = null;
+
+        for (let r = 0; r < rows.length; r++) {
+          const c = rows[r].findIndex((item) => item.card === currentCard);
+          if (c !== -1) {
+            currentRowIdx = r;
+            currentColIdx = c;
+            currentItem = rows[r][c];
+            break;
+          }
+        }
+
+        if (!currentItem) return null;
+
+        const isRTL = window.getComputedStyle(grid).direction === 'rtl';
+        const horizontalStep =
+          key === 'ArrowRight' ? (isRTL ? -1 : 1) : key === 'ArrowLeft' ? (isRTL ? 1 : -1) : 0;
+
+        if (horizontalStep !== 0) {
+          const currentRow = rows[currentRowIdx];
+          const nextColIdx = currentColIdx + horizontalStep;
+          if (nextColIdx >= 0 && nextColIdx < currentRow.length) {
+            return currentRow[nextColIdx].card;
+          }
+          // In single-column list mode, allow Left/Right to also move to previous/next item
+          if (rows.every((r) => r.length === 1)) {
+            const nextRowIdx = currentRowIdx + horizontalStep;
+            if (nextRowIdx >= 0 && nextRowIdx < rows.length) {
+              return rows[nextRowIdx][0].card;
+            }
+          }
+          return null;
+        }
+
+        const verticalStep = key === 'ArrowDown' ? 1 : key === 'ArrowUp' ? -1 : 0;
+        if (verticalStep !== 0) {
+          const targetRowIdx = currentRowIdx + verticalStep;
+          if (targetRowIdx < 0 || targetRowIdx >= rows.length) {
+            return null;
+          }
+          const targetRow = rows[targetRowIdx];
+          // Pick the card in the target row whose horizontal center is closest to the current card's center
+          let bestMatch = targetRow[0];
+          let bestDist = Math.abs(bestMatch.centerX - currentItem.centerX);
+          for (let i = 1; i < targetRow.length; i++) {
+            const dist = Math.abs(targetRow[i].centerX - currentItem.centerX);
+            if (dist < bestDist) {
+              bestDist = dist;
+              bestMatch = targetRow[i];
+            }
+          }
+          return bestMatch.card;
+        }
+
+        return null;
+      }
+
+      /**
+       * Updates roving tabindex across cards and optionally focuses the active card.
+       */
+      function setActiveCard(targetCard, focusTarget = true) {
+        const cards = getCards();
+        if (!targetCard || !cards.includes(targetCard)) return;
+
+        const wasFocusedInsideLink =
+          document.activeElement &&
+          document.activeElement.tagName === 'A' &&
+          document.activeElement.closest('.card');
+
+        cards.forEach((card) => {
+          const isTarget = card === targetCard;
+          card.setAttribute('tabindex', isTarget ? '0' : '-1');
+          const link = card.querySelector('a, button');
+          if (link) {
+            link.setAttribute('tabindex', '-1');
+          }
+        });
+
+        if (focusTarget) {
+          if (wasFocusedInsideLink) {
+            const targetLink = targetCard.querySelector('a, button');
+            if (targetLink) {
+              targetLink.setAttribute('tabindex', '0');
+              targetLink.focus();
+            } else {
+              targetCard.focus();
+            }
+          } else {
+            targetCard.focus();
+          }
+        }
+      }
+
+      // Keyboard navigation handler
+      grid.addEventListener('keydown', (event) => {
+        const currentCard = event.target.closest('.card');
+        if (!currentCard || !grid.contains(currentCard)) return;
+
+        const navKeys = ['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp', 'Home', 'End'];
+        if (navKeys.includes(event.key)) {
+          event.preventDefault();
+          const nextCard = findSpatialTarget(currentCard, event.key);
+          if (nextCard && nextCard !== currentCard) {
+            setActiveCard(nextCard, true);
+          }
+          return;
+        }
+
+        // Enter or Space on the card container triggers its primary action link
+        if ((event.key === 'Enter' || event.key === ' ') && event.target === currentCard) {
+          const primaryAction = currentCard.querySelector('a, button');
+          if (primaryAction) {
+            event.preventDefault();
+            primaryAction.click();
+          }
+        }
+      });
+
+      // Keep roving tabindex synced when user clicks or focuses a card
+      grid.addEventListener('focusin', (event) => {
+        const card = event.target.closest('.card');
+        if (card && grid.contains(card)) {
+          setActiveCard(card, false);
+        }
+      });
+
+      // Layout mode switching
+      layoutButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const mode = btn.getAttribute('data-set-layout');
+          if (!mode) return;
+
+          grid.setAttribute('data-layout', mode);
+          grid.classList.remove('layout-grid', 'layout-compact', 'layout-list');
+          grid.classList.add(`layout-${mode}`);
+
+          layoutButtons.forEach((b) => {
+            b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
+          });
+
+          if (announcer) {
+            announcer.textContent = `Switched to ${mode} layout`;
+          }
+        });
+      });
+
+      // Ensure initial roving tabindex state is valid
+      const initialCards = getCards();
+      if (initialCards.length > 0) {
+        const currentActive =
+          initialCards.find((c) => c.getAttribute('tabindex') === '0') || initialCards[0];
+        setActiveCard(currentActive, false);
+      }
+    })();
+  </script>
 </body>
 
