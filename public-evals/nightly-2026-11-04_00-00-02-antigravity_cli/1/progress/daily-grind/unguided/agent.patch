+  <script>
+    function setProgressState(state, value) {
+      const track = document.getElementById('primary-progress-track');
+      const fill = document.getElementById('primary-progress-fill');
+      const nativeProgress = document.getElementById('primary-native-progress');
+      const valueBadge = document.getElementById('primary-progress-value');
+      const statusText = document.getElementById('primary-progress-status');
+      const stateIndicator = document.getElementById('primary-state-indicator');
+      const stepReady = document.getElementById('step-ready');
+
+      const btnDet = document.getElementById('btn-determinate');
+      const btnInd = document.getElementById('btn-indeterminate');
+      const btnComp = document.getElementById('btn-complete');
+
+      btnDet.classList.remove('active');
+      btnInd.classList.remove('active');
+      btnComp.classList.remove('active');
+
+      if (state === 'indeterminate') {
+        btnInd.classList.add('active');
+        track.classList.remove('determinate');
+        track.classList.add('indeterminate');
+        track.setAttribute('data-state', 'indeterminate');
+        track.removeAttribute('aria-valuenow');
+        track.setAttribute('aria-busy', 'true');
+        fill.classList.add('indeterminate');
+        nativeProgress.removeAttribute('value');
+        valueBadge.textContent = 'Syncing Rewards...';
+        valueBadge.classList.add('badge-accent');
+        statusText.textContent = 'Verifying order rewards and updating live barista progress...';
+        stateIndicator.textContent = 'State: Indeterminate';
+        stepReady.classList.remove('completed');
+      } else {
+        const pct = typeof value === 'number' ? value : 75;
+        if (pct === 100) {
+          btnComp.classList.add('active');
+        } else {
+          btnDet.classList.add('active');
+        }
+        track.classList.remove('indeterminate');
+        track.classList.add('determinate');
+        track.setAttribute('data-state', 'determinate');
+        track.setAttribute('aria-valuenow', String(pct));
+        track.removeAttribute('aria-busy');
+        fill.classList.remove('indeterminate');
+        fill.style.width = pct + '%';
+        nativeProgress.setAttribute('value', String(pct));
+        valueBadge.textContent = pct + '% (' + pct + ' / 100 Beans)';
+        valueBadge.classList.remove('badge-accent');
+        statusText.textContent = pct === 100
+          ? 'Reward unlocked! Your complimentary artisanal drink is ready to redeem.'
+          : (100 - pct) + ' more beans until your next complimentary artisanal beverage!';
+        stateIndicator.textContent = 'State: Determinate';
+        if (pct === 100) {
+          stepReady.classList.add('completed');
+        } else {
+          stepReady.classList.remove('completed');
+        }
+      }
+    }
+  </script>
