+  <script>
+    const orderProgress = document.getElementById('order-progress');
+    const orderStage = document.getElementById('order-progress-stage');
+    const orderStatusLive = document.getElementById('order-status-live');
+    const stateButtons = document.querySelectorAll('.progress-controls button[data-state]');
+
+    stateButtons.forEach((button) => {
+      button.addEventListener('click', () => {
+        stateButtons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn === button)));
+        const state = button.dataset.state;
+
+        if (state === 'indeterminate') {
+          orderProgress.removeAttribute('value');
+          orderStage.textContent = 'Syncing with café...';
+          orderStatusLive.textContent = 'Waiting for barista confirmation before estimated completion time is available.';
+        } else {
+          const val = Number(button.dataset.value);
+          orderProgress.value = val;
+          if (val >= 100) {
+            orderStage.textContent = '100% Complete';
+            orderStatusLive.textContent = 'Order complete! Your Maple Oat Latte is ready for pickup at the counter.';
+          } else {
+            orderStage.textContent = `${val}% Complete`;
+            orderStatusLive.textContent = `Order in progress (${val}%): Barista is steaming oat milk and pulling espresso shots.`;
+          }
+        }
+      });
+    });
+  </script>
