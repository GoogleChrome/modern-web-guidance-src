+  <script>
+    const searchInput = document.getElementById("search-input");
+    const menuGrid = document.getElementById("menu-grid");
+
+    // Collect and cache all text nodes in the menu cards using TreeWalker
+    const allTextNodes = [];
+    for (const card of menuGrid.querySelectorAll(".card")) {
+      const treeWalker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+      let currentNode = treeWalker.nextNode();
+      while (currentNode) {
+        if (currentNode.textContent.trim().length > 0) {
+          allTextNodes.push(currentNode);
+        }
+        currentNode = treeWalker.nextNode();
+      }
+    }
+
+    function clearFallbackMarks() {
+      const marks = menuGrid.querySelectorAll("mark.search-highlight");
+      for (const mark of marks) {
+        const parent = mark.parentNode;
+        parent.replaceChild(document.createTextNode(mark.textContent), mark);
+        parent.normalize();
+      }
+    }
+
+    function highlightMatches(query) {
+      const term = query.trim().toLowerCase();
+
+      if (CSS.highlights) {
+        CSS.highlights.clear();
+        if (!term) return;
+
+        const matchingRanges = [];
+        for (const textNode of allTextNodes) {
+          const text = textNode.textContent.toLowerCase();
+          let startPos = 0;
+          while (startPos < text.length) {
+            const index = text.indexOf(term, startPos);
+            if (index === -1) break;
+            const range = new Range();
+            range.setStart(textNode, index);
+            range.setEnd(textNode, index + term.length);
+            matchingRanges.push(range);
+            startPos = index + term.length;
+          }
+        }
+
+        if (matchingRanges.length > 0) {
+          const searchHighlight = new Highlight(...matchingRanges);
+          CSS.highlights.set("search-results", searchHighlight);
+        }
+      } else {
+        clearFallbackMarks();
+        if (!term) return;
+
+        for (const card of menuGrid.querySelectorAll(".card")) {
+          const walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+          const nodes = [];
+          for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+            if (n.textContent.trim().length > 0) nodes.push(n);
+          }
+
+          for (const textNode of nodes) {
+            const text = textNode.textContent;
+            let pos = text.toLowerCase().indexOf(term);
+            if (pos === -1) continue;
+
+            const frag = document.createDocumentFragment();
+            let last = 0;
+            while (pos !== -1) {
+              frag.append(text.slice(last, pos));
+              const mark = document.createElement("mark");
+              mark.className = "search-highlight";
+              mark.textContent = text.slice(pos, pos + term.length);
+              frag.append(mark);
+              last = pos + term.length;
+              pos = text.toLowerCase().indexOf(term, last);
+            }
+            frag.append(text.slice(last));
+            textNode.replaceWith(frag);
+          }
+        }
+      }
+    }
+
+    searchInput.addEventListener("input", (e) => {
+      highlightMatches(e.target.value);
+    });
+  </script>
