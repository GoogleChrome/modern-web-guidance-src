   </footer>
 
+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorMsg = document.getElementById('newsletter-error');
+      const successMsg = document.getElementById('newsletter-success');
+      let touched = false;
+
+      function isValidEmail(value) {
+        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim()) && emailInput.checkValidity();
+      }
+
+      function validateOnBlur() {
+        const val = emailInput.value.trim();
+        if (!val && !touched) return false;
+        const valid = val.length > 0 && isValidEmail(val);
+        emailInput.classList.toggle('is-invalid', !valid);
+        emailInput.setAttribute('aria-invalid', String(!valid));
+        errorMsg.classList.toggle('visible', !valid);
+        return valid;
+      }
+
+      emailInput.addEventListener('input', function () {
+        touched = true;
+        successMsg.classList.remove('visible');
+        // Never show error state while actively typing; clear existing error once valid or while typing
+        emailInput.classList.remove('is-invalid');
+        emailInput.removeAttribute('aria-invalid');
+        errorMsg.classList.remove('visible');
+      });
+
+      emailInput.addEventListener('blur', function () {
+        if (touched || emailInput.value.trim().length > 0) {
+          touched = true;
+          validateOnBlur();
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        touched = true;
+        if (validateOnBlur()) {
+          successMsg.classList.add('visible');
+          emailInput.value = '';
+          touched = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
