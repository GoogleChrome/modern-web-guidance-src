+  <script>
+    (function () {
+      const canvas = document.getElementById('canvas');
+      const ctx = canvas.getContext('2d');
+      const controlsEl = document.getElementById('customizer-controls');
+      const cupLabelEl = document.getElementById('cup-label');
+
+      const nameInput = document.getElementById('cup-name');
+      const milkSelect = document.getElementById('milk-select');
+      const syrupSelect = document.getElementById('syrup-select');
+
+      const labelName = document.getElementById('label-name');
+      const labelMilk = document.getElementById('label-milk');
+      const labelSyrup = document.getElementById('label-syrup');
+
+      const summaryName = document.getElementById('summary-name');
+      const summaryMilk = document.getElementById('summary-milk');
+      const summarySyrup = document.getElementById('summary-syrup');
+
+      const milkColors = {
+        'Oat Milk': '#f3e5d0',
+        'Whole Milk': '#fffdf9',
+        'Almond Milk': '#efe0c9',
+        'Coconut Milk': '#faf6f0',
+        'Soy Milk': '#f5ead6'
+      };
+
+      const syrupColors = {
+        'Vermont Maple': '#c66919',
+        'Vanilla Bean': '#e6c27a',
+        'Salted Caramel': '#d4822a',
+        'Toasted Hazelnut': '#8d5524',
+        'No Syrup': '#6d4c41'
+      };
+
+      function syncOrderText() {
+        const currentName = (nameInput.value || '').trim() || 'Guest';
+        const currentMilk = milkSelect.value;
+        const currentSyrup = syrupSelect.value;
+
+        labelName.textContent = currentName;
+        labelMilk.textContent = 'Milk: ' + currentMilk;
+        labelSyrup.textContent = 'Syrup: ' + currentSyrup;
+
+        summaryName.textContent = currentName;
+        summaryMilk.textContent = currentMilk;
+        summarySyrup.textContent = currentSyrup;
+      }
+
+      function drawCoffeeScene(width, height) {
+        const currentName = (nameInput.value || '').trim() || 'Guest';
+        const currentMilk = milkSelect.value;
+        const currentSyrup = syrupSelect.value;
+        const milkTint = milkColors[currentMilk] || '#f3e5d0';
+        const syrupTint = syrupColors[currentSyrup] || '#c66919';
+
+        // Warm cafe backdrop
+        const bgGrad = ctx.createLinearGradient(0, 0, width, height);
+        bgGrad.addColorStop(0, '#fff8f2');
+        bgGrad.addColorStop(1, '#efe5dc');
+        ctx.fillStyle = bgGrad;
+        ctx.fillRect(0, 0, width, height);
+
+        // Wooden cafe tabletop counter at the bottom
+        ctx.fillStyle = '#d7ccc8';
+        ctx.fillRect(0, height - 64, width, 64);
+        ctx.strokeStyle = '#bcaaa4';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(0, height - 64);
+        ctx.lineTo(width, height - 64);
+        ctx.stroke();
+
+        // Center of the coffee cup on the right side of the canvas
+        const cupCenterX = Math.min(width - 210, Math.max(540, width * 0.72));
+        const cupTopY = 125;
+        const cupBottomY = 395;
+        const topHalfW = 104;
+        const bottomHalfW = 72;
+
+        // Drop shadow on counter
+        ctx.save();
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.16)';
+        ctx.beginPath();
+        ctx.ellipse(cupCenterX, cupBottomY + 8, bottomHalfW + 18, 14, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.restore();
+
+        // Rising steam wisps
+        ctx.save();
+        ctx.strokeStyle = 'rgba(141, 110, 99, 0.35)';
+        ctx.lineWidth = 3;
+        ctx.lineCap = 'round';
+        [-30, 0, 30].forEach((offsetX, idx) => {
+          ctx.beginPath();
+          const startX = cupCenterX + offsetX;
+          const startY = cupTopY - 28;
+          ctx.moveTo(startX, startY);
+          ctx.bezierCurveTo(
+            startX - 12 + idx * 4, startY - 22,
+            startX + 14 - idx * 3, startY - 44,
+            startX - 4, startY - 66
+          );
+          ctx.stroke();
+        });
+        ctx.restore();
+
+        // Cup body (tapered artisanal cup)
+        ctx.save();
+        const cupGrad = ctx.createLinearGradient(cupCenterX - topHalfW, cupTopY, cupCenterX + topHalfW, cupTopY);
+        cupGrad.addColorStop(0, '#fdfbf7');
+        cupGrad.addColorStop(0.6, '#f5efe6');
+        cupGrad.addColorStop(1, '#e0d4c8');
+        ctx.fillStyle = cupGrad;
+        ctx.strokeStyle = '#4e342e';
+        ctx.lineWidth = 3;
+
+        ctx.beginPath();
+        ctx.moveTo(cupCenterX - topHalfW, cupTopY);
+        ctx.lineTo(cupCenterX - bottomHalfW, cupBottomY);
+        ctx.quadraticCurveTo(cupCenterX, cupBottomY + 18, cupCenterX + bottomHalfW, cupBottomY);
+        ctx.lineTo(cupCenterX + topHalfW, cupTopY);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+        ctx.restore();
+
+        // Kraft cardboard sleeve background area on the cup
+        const sleeveTopY = 205;
+        const sleeveBottomY = 320;
+        const t1 = (sleeveTopY - cupTopY) / (cupBottomY - cupTopY);
+        const t2 = (sleeveBottomY - cupTopY) / (cupBottomY - cupTopY);
+        const sleeveTopHalfW = topHalfW - (topHalfW - bottomHalfW) * t1;
+        const sleeveBottomHalfW = topHalfW - (topHalfW - bottomHalfW) * t2;
+
+        ctx.save();
+        const sleeveGrad = ctx.createLinearGradient(cupCenterX - sleeveTopHalfW, sleeveTopY, cupCenterX + sleeveTopHalfW, sleeveTopY);
+        sleeveGrad.addColorStop(0, '#c8b29b');
+        sleeveGrad.addColorStop(0.5, '#d7ccc8');
+        sleeveGrad.addColorStop(1, '#b09982');
+        ctx.fillStyle = sleeveGrad;
+        ctx.strokeStyle = '#5d4037';
+        ctx.lineWidth = 2.5;
+
+        ctx.beginPath();
+        ctx.moveTo(cupCenterX - sleeveTopHalfW, sleeveTopY);
+        ctx.lineTo(cupCenterX - sleeveBottomHalfW, sleeveBottomY);
+        ctx.quadraticCurveTo(cupCenterX, sleeveBottomY + 10, cupCenterX + sleeveBottomHalfW, sleeveBottomY);
+        ctx.lineTo(cupCenterX + sleeveTopHalfW, sleeveTopY);
+        ctx.quadraticCurveTo(cupCenterX, sleeveTopY + 8, cupCenterX - sleeveTopHalfW, sleeveTopY);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+        ctx.restore();
+
+        // Coffee rim and milk foam / syrup swirl at top of cup
+        ctx.save();
+        ctx.fillStyle = '#4e342e';
+        ctx.beginPath();
+        ctx.ellipse(cupCenterX, cupTopY, topHalfW + 6, 22, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Milk foam surface inside the rim
+        ctx.fillStyle = milkTint;
+        ctx.beginPath();
+        ctx.ellipse(cupCenterX, cupTopY, topHalfW - 4, 16, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Syrup swirl ring inside the foam
+        if (currentSyrup !== 'No Syrup') {
+          ctx.strokeStyle = syrupTint;
+          ctx.lineWidth = 3;
+          ctx.beginPath();
+          ctx.ellipse(cupCenterX, cupTopY, (topHalfW - 28) * 0.7, 9, 0, 0.2, Math.PI * 1.85);
+          ctx.stroke();
+
+          ctx.beginPath();
+          ctx.ellipse(cupCenterX, cupTopY, (topHalfW - 55) * 0.5, 5, 0, Math.PI * 0.4, Math.PI * 2.1);
+          ctx.stroke();
+        }
+        ctx.restore();
+
+        // Syrup flavor badge below cup
+        ctx.save();
+        ctx.fillStyle = syrupTint;
+        ctx.beginPath();
+        ctx.arc(cupCenterX - 68, cupBottomY + 34, 6, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.fillStyle = '#3e2723';
+        ctx.font = '600 13px "Segoe UI", Tahoma, sans-serif';
+        ctx.textAlign = 'center';
+        ctx.fillText(currentName + "'s " + currentMilk + ' (' + currentSyrup + ')', cupCenterX + 6, cupBottomY + 38);
+        ctx.restore();
+
+        return {
+          formX: 44,
+          formY: 42,
+          labelX: Math.round(cupCenterX - cupLabelEl.offsetWidth / 2),
+          labelY: Math.round(sleeveTopY + 12)
+        };
+      }
+
+      function syncElementTransform(element, x, y, drawResult) {
+        if (drawResult && typeof drawResult.toString === 'function') {
+          element.style.transform = drawResult.toString();
+        } else if (typeof canvas.getElementTransform === 'function') {
+          const matrix = canvas.getElementTransform(element, new DOMMatrix().translate(x, y));
+          if (matrix) {
+            element.style.transform = matrix.toString();
+          }
+        } else {
+          element.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
+        }
+      }
+
+      function paintCanvas() {
+        syncOrderText();
+
+        const dpr = window.devicePixelRatio || 1;
+        const cssWidth = canvas.clientWidth || 860;
+        const cssHeight = canvas.clientHeight || 460;
+
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.setTransform(1, 0, 0, 1, 0, 0);
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        }
+
+        // Scale context by devicePixelRatio for crisp high-DPI rendering
+        ctx.scale(dpr, dpr);
+
+        const positions = drawCoffeeScene(cssWidth, cssHeight);
+
+        // Render live HTML controls and cup label inside the canvas via HTML-in-Canvas API
+        if (typeof ctx.drawElementImage === 'function') {
+          const controlsTransform = ctx.drawElementImage(controlsEl, positions.formX, positions.formY);
+          syncElementTransform(controlsEl, positions.formX, positions.formY, controlsTransform);
+
+          const labelTransform = ctx.drawElementImage(cupLabelEl, positions.labelX, positions.labelY);
+          syncElementTransform(cupLabelEl, positions.labelX, positions.labelY, labelTransform);
+        } else {
+          // Fallback text rendering on cup sleeve when HTML-in-Canvas flag is not enabled
+          syncElementTransform(controlsEl, positions.formX, positions.formY, null);
+          syncElementTransform(cupLabelEl, positions.labelX, positions.labelY, null);
+
+          ctx.save();
+          ctx.fillStyle = '#3e2723';
+          ctx.textAlign = 'center';
+          ctx.font = 'bold 17px "Segoe UI", Tahoma, sans-serif';
+          ctx.fillText(labelName.textContent, positions.labelX + cupLabelEl.offsetWidth / 2, positions.labelY + 28);
+          ctx.font = '600 12px "Segoe UI", Tahoma, sans-serif';
+          ctx.fillStyle = '#4e342e';
+          ctx.fillText(labelMilk.textContent, positions.labelX + cupLabelEl.offsetWidth / 2, positions.labelY + 48);
+          ctx.fillText(labelSyrup.textContent, positions.labelX + cupLabelEl.offsetWidth / 2, positions.labelY + 66);
+          ctx.restore();
+        }
+      }
+
+      // Hook into HTML-in-Canvas native paint lifecycle
+      canvas.onpaint = paintCanvas;
+
+      function triggerRepaint() {
+        syncOrderText();
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          paintCanvas();
+        }
+      }
+
+      nameInput.addEventListener('input', triggerRepaint);
+      milkSelect.addEventListener('change', triggerRepaint);
+      syrupSelect.addEventListener('change', triggerRepaint);
+
+      // ResizeObserver for crisp high-DPI canvas scaling
+      const resizeObserver = new ResizeObserver((entries) => {
+        for (const entry of entries) {
+          const dpr = window.devicePixelRatio || 1;
+          if (entry.devicePixelContentBoxSize && entry.devicePixelContentBoxSize.length > 0) {
+            canvas.width = entry.devicePixelContentBoxSize[0].inlineSize;
+            canvas.height = entry.devicePixelContentBoxSize[0].blockSize;
+          } else {
+            canvas.width = Math.round(entry.contentRect.width * dpr);
+            canvas.height = Math.round(entry.contentRect.height * dpr);
+          }
+          triggerRepaint();
+        }
+      });
+
+      try {
+        resizeObserver.observe(canvas, { box: 'device-pixel-content-box' });
+      } catch (e) {
+        resizeObserver.observe(canvas);
+      }
+
+      // Initial render
+      triggerRepaint();
+    })();
+  </script>
+
 </body>
 
