+  <script>
+    const canvas = document.getElementById("canvas");
+    const ctx = canvas.getContext("2d");
+    const uiElement = document.getElementById("cup-customizer-ui");
+    const wrapper = document.getElementById("canvas-wrapper");
+
+    const nameInput = document.getElementById("cup-name");
+    const milkSelect = document.getElementById("cup-milk");
+    const syrupSelect = document.getElementById("cup-syrup");
+    const summaryEl = document.getElementById("cup-summary");
+
+    const supportsHtmlInCanvas = "content" in HTMLCanvasElement.prototype;
+
+    if (!supportsHtmlInCanvas) {
+      // Fallback: place the interactive HTML controls on top of the canvas using CSS
+      wrapper.classList.add("fallback-overlay");
+      wrapper.appendChild(uiElement);
+    }
+
+    const milkColors = {
+      "Oat Milk": "#e6d2b5",
+      "Whole Milk": "#f7f1e5",
+      "Almond Milk": "#dfcab0",
+      "Coconut Milk": "#f2efe9"
+    };
+
+    const syrupColors = {
+      "Vermont Maple": "#c67127",
+      "Vanilla Bean": "#f3d692",
+      "Salted Caramel": "#d4882a",
+      "Hazelnut": "#8d5524",
+      "No Syrup": "transparent"
+    };
+
+    function updateOrderSummary() {
+      const cupName = (nameInput.value || "Guest").trim();
+      const milk = milkSelect.value;
+      const syrup = syrupSelect.value;
+      summaryEl.textContent = "";
+      summaryEl.append("Order for ");
+      const strong = document.createElement("strong");
+      strong.textContent = cupName;
+      summaryEl.append(strong, `: ${milk} + ${syrup}`);
+
+      if (supportsHtmlInCanvas && typeof canvas.requestPaint === "function") {
+        canvas.requestPaint();
+      } else {
+        drawScene();
+      }
+    }
+
+    nameInput.addEventListener("input", updateOrderSummary);
+    milkSelect.addEventListener("change", updateOrderSummary);
+    syrupSelect.addEventListener("change", updateOrderSummary);
+
+    function drawCoffeeCup(ctx, scaleX, scaleY) {
+      ctx.save();
+      ctx.scale(scaleX, scaleY);
+
+      // Soft background card area for cup preview
+      ctx.fillStyle = "#fff8f3";
+      ctx.fillRect(0, 0, 680, 360);
+
+      // Subtle saucer / shadow under cup
+      ctx.fillStyle = "rgba(78, 52, 46, 0.1)";
+      ctx.beginPath();
+      ctx.ellipse(175, 315, 78, 12, 0, 0, Math.PI * 2);
+      ctx.fill();
+
+      // Steam wisps
+      ctx.strokeStyle = "rgba(141, 110, 99, 0.35)";
+      ctx.lineWidth = 3;
+      ctx.lineCap = "round";
+      [145, 175, 205].forEach((x, idx) => {
+        ctx.beginPath();
+        ctx.moveTo(x, 62);
+        ctx.bezierCurveTo(x - 10, 46, x + 12, 34, x - 2, 18 + idx * 3);
+        ctx.stroke();
+      });
+
+      // Cup body trapezoid
+      ctx.beginPath();
+      ctx.moveTo(105, 95);
+      ctx.lineTo(245, 95);
+      ctx.lineTo(222, 305);
+      ctx.lineTo(128, 305);
+      ctx.closePath();
+      ctx.fillStyle = milkColors[milkSelect.value] || "#f5ebe6";
+      ctx.fill();
+      ctx.lineWidth = 3;
+      ctx.strokeStyle = "#4e342e";
+      ctx.stroke();
+
+      // Syrup drizzle accent band at the top of the drink inside the cup
+      const syrupColor = syrupColors[syrupSelect.value];
+      if (syrupColor && syrupColor !== "transparent") {
+        ctx.fillStyle = syrupColor;
+        ctx.beginPath();
+        ctx.moveTo(108, 112);
+        ctx.lineTo(242, 112);
+        ctx.lineTo(239, 128);
+        ctx.lineTo(111, 128);
+        ctx.closePath();
+        ctx.fill();
+      }
+
+      // Cardboard Kraft Sleeve
+      ctx.beginPath();
+      ctx.moveTo(114, 155);
+      ctx.lineTo(236, 155);
+      ctx.lineTo(228, 240);
+      ctx.lineTo(122, 240);
+      ctx.closePath();
+      ctx.fillStyle = "#c89f76";
+      ctx.fill();
+      ctx.strokeStyle = "#4e342e";
+      ctx.lineWidth = 2.5;
+      ctx.stroke();
+
+      // Text written on the sleeve
+      ctx.fillStyle = "#3e2723";
+      ctx.textAlign = "center";
+      ctx.font = "bold 16px 'Segoe UI', sans-serif";
+      const displayName = (nameInput.value || "Guest").trim().slice(0, 14);
+      ctx.fillText(displayName, 175, 186);
+
+      ctx.font = "11px 'Segoe UI', sans-serif";
+      ctx.fillText(milkSelect.value, 175, 206);
+      ctx.fillText(syrupSelect.value, 175, 224);
+
+      // Coffee Cup Lid
+      ctx.fillStyle = "#4e342e";
+      ctx.beginPath();
+      ctx.roundRect(96, 78, 158, 18, 6);
+      ctx.fill();
+
+      ctx.fillStyle = "#6d4c41";
+      ctx.beginPath();
+      ctx.roundRect(108, 66, 134, 14, [6, 6, 0, 0]);
+      ctx.fill();
+
+      ctx.restore();
+    }
+
+    function drawScene() {
+      if (typeof ctx.reset === "function") {
+        ctx.reset();
+      } else {
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+      }
+
+      const cssWidth = canvas.clientWidth || 680;
+      const cssHeight = canvas.clientHeight || 360;
+      const scaleX = canvas.width / cssWidth;
+      const scaleY = canvas.height / cssHeight;
+
+      drawCoffeeCup(ctx, scaleX, scaleY);
+
+      if (supportsHtmlInCanvas && typeof ctx.drawElementImage === "function") {
+        const uiX = Math.round(360 * scaleX);
+        const uiY = Math.round(32 * scaleY);
+        ctx.drawElementImage(uiElement, uiX, uiY);
+      }
+    }
+
+    canvas.onpaint = () => {
+      drawScene();
+    };
+
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+
+      if (supportsHtmlInCanvas && typeof canvas.requestPaint === "function") {
+        canvas.requestPaint();
+      } else {
+        drawScene();
+      }
+    });
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== "undefined" &&
+      "devicePixelContentBoxSize" in ResizeObserverEntry.prototype;
+    const options = supportsDevicePixelContentBox
+      ? { box: "device-pixel-content-box" }
+      : {};
+    observer.observe(canvas, options);
+  </script>
+
