+  <script>
+    (function () {
+      const form = document.getElementById('order-form');
+      const shopSelect = document.getElementById('local-shop');
+      const shopGroup = document.getElementById('shop-form-group');
+      const errorMsg = document.getElementById('local-shop-error');
+      const successMsg = document.getElementById('order-success');
+      const ERROR_TEXT = 'Please select a local shop to continue with your order.';
+
+      let hasInteracted = false;
+
+      function hideSuccess() {
+        successMsg.textContent = '';
+        successMsg.hidden = true;
+        successMsg.classList.remove('visible');
+      }
+
+      function validateShopSelect() {
+        const isValid = shopSelect.value.trim() !== '';
+
+        if (!hasInteracted) {
+          return isValid;
+        }
+
+        if (!isValid) {
+          shopSelect.classList.add('is-invalid');
+          shopSelect.classList.remove('is-valid');
+          shopSelect.setAttribute('aria-invalid', 'true');
+          shopGroup.classList.add('has-error');
+          errorMsg.textContent = ERROR_TEXT;
+          errorMsg.hidden = false;
+          errorMsg.classList.add('visible');
+          hideSuccess();
+        } else {
+          shopSelect.classList.remove('is-invalid');
+          shopSelect.classList.add('is-valid');
+          shopSelect.setAttribute('aria-invalid', 'false');
+          shopGroup.classList.remove('has-error');
+          errorMsg.textContent = '';
+          errorMsg.hidden = true;
+          errorMsg.classList.remove('visible');
+        }
+
+        return isValid;
+      }
+
+      shopSelect.addEventListener('change', function () {
+        hasInteracted = true;
+        hideSuccess();
+        validateShopSelect();
+      });
+
+      shopSelect.addEventListener('blur', function () {
+        hasInteracted = true;
+        validateShopSelect();
+      });
+
+      shopSelect.addEventListener('invalid', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        validateShopSelect();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        const isValid = validateShopSelect();
+
+        if (!isValid) {
+          shopSelect.focus();
+          return;
+        }
+
+        const selectedOption = shopSelect.options[shopSelect.selectedIndex];
+        successMsg.textContent = 'Starting your order at ' + selectedOption.text + '.';
+        successMsg.hidden = false;
+        successMsg.classList.add('visible');
+      });
+    })();
+  </script>
+
 </body>
 
