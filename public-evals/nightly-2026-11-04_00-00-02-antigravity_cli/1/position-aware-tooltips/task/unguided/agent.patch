+    }
+
+    #tooltip::before,
+    #tooltip::after {
+      content: "▼";
+      position: absolute;
+      top: 100%;
+      bottom: auto;
+      left: 50%;
+      transform: translateX(-50%);
+      width: 0;
+      height: 0;
+      font-size: 0;
+      line-height: 0;
+      margin-top: 0;
+      margin-bottom: -6px;
+      border-radius: 0 0 2px 2px;
+      border: 6px solid transparent;
+      border-top-color: var(--primary);
+      border-bottom-color: transparent;
+    }
+
+    @container anchored(fallback: flip-block) {
+      #tooltip {
+        margin: 10px 0 0 0;
+        margin-top: 10px;
+        margin-bottom: 0;
+        border-radius: 0 10px 10px 10px;
+      }
+
+      #tooltip::before,
+      #tooltip::after {
+        content: "▲";
