+  <script type="module">
+    // Out-of-order coffee order events recorded by distributed backend services
+    // with nanosecond-precision ISO 8601 UTC timestamps, including sub-millisecond
+    // events within the same millisecond that would collide under legacy Date parsing.
+    const rawOrderEvents = [
+      {
+        orderId: 'ORD-8842',
+        service: 'roastery-queue-3',
+        eventType: 'barista.ticket.dispatched',
+        item: 'Maple Oat Latte (Large)',
+        ts: '2026-11-04T08:15:23.004918275Z',
+      },
+      {
+        orderId: 'ORD-8842',
+        service: 'edge-gateway-1',
+        eventType: 'order.request.received',
+        item: 'Maple Oat Latte (Large)',
+        ts: '2026-11-04T08:15:23.000104210Z',
+      },
+      {
+        orderId: 'ORD-8842',
+        service: 'inventory-svc-2',
+        eventType: 'inventory.beans.reserved',
+        item: 'Maple Oat Latte (Large)',
+        ts: '2026-11-04T08:15:23.000489012Z',
+      },
+      {
+        orderId: 'ORD-8842',
+        service: 'auth-token-svc',
+        eventType: 'session.token.verified',
+        item: 'Maple Oat Latte (Large)',
+        ts: '2026-11-04T08:15:23.000104895Z',
+      },
+      {
+        orderId: 'ORD-8842',
+        service: 'loyalty-ledger-1',
+        eventType: 'rewards.points.accrued',
+        item: 'Maple Oat Latte (Large)',
+        ts: '2026-11-04T08:15:23.004210500Z',
+      },
+      {
+        orderId: 'ORD-8842',
+        service: 'payment-ledger-4',
+        eventType: 'payment.ledger.committed',
+        item: 'Maple Oat Latte (Large)',
+        ts: '2026-11-04T08:15:23.001820400Z',
+      },
+      {
+        orderId: 'ORD-8842',
+        service: 'payment-gateway-2',
+        eventType: 'payment.intent.authorized',
+        item: 'Maple Oat Latte (Large)',
+        ts: '2026-11-04T08:15:23.001820115Z',
+      },
+    ];
+
+    async function ensureTemporal() {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+    }
+
+    // 1. Parse recorded timestamps as Temporal.Instant (never `new Date(ts)`,
+    // which drops everything below the millisecond).
+    function parseEvents(rawBatch) {
+      return rawBatch.map((evt, index) => ({
+        ...evt,
+        ingestionOrder: index + 1,
+        timestamp: Temporal.Instant.from(evt.ts),
+      }));
+    }
+
+    // 2. Sort chronologically with the static Temporal.Instant.compare() method
+    function sequenceEvents(items) {
+      return [...items].sort((a, b) =>
+        Temporal.Instant.compare(a.timestamp, b.timestamp)
+      );
+    }
+
+    // 3. Calculate intervals between consecutive events using .since()
+    function analyzeTrace(sortedEvents) {
+      return sortedEvents.map((curr, index) => {
+        if (index === 0) {
+          return {
+            ...curr,
+            intervalDuration: null,
+            formattedInterval: '0ns (trace start)',
+            isoInterval: 'PT0S',
+            sameTimestampAsPrev: false,
+          };
+        }
+
+        const prev = sortedEvents[index - 1];
+        const sameTimestampAsPrev = curr.timestamp.equals(prev.timestamp);
+        const gap = curr.timestamp.since(prev.timestamp);
+
+        return {
+          ...curr,
+          intervalDuration: gap,
+          formattedInterval: `+${gap.toLocaleString('en-US', { style: 'narrow' })}`,
+          isoInterval: gap.toString(),
+          sameTimestampAsPrev,
+        };
+      });
+    }
+
+    function renderEventsBatch() {
+      const parsed = parseEvents(rawOrderEvents);
+      const sorted = sequenceEvents(parsed);
+      const analyzed = analyzeTrace(sorted);
+
+      const firstInstant = analyzed[0].timestamp;
+      const lastInstant = analyzed[analyzed.length - 1].timestamp;
+      const totalSpan = lastInstant.since(firstInstant);
+
+      const summaryEl = document.getElementById('telemetry-summary');
+      summaryEl.hidden = false;
+      summaryEl.replaceChildren();
+
+      const stats = [
+        { label: 'Events Sorted', value: `${analyzed.length} distributed events` },
+        { label: 'Order ID', value: analyzed[0].orderId },
+        {
+          label: 'Total End-to-End Span',
+          value: totalSpan.toLocaleString('en-US', { style: 'narrow' }),
+        },
+        {
+          label: 'Earliest UTC Instant',
+          value: firstInstant.toString(),
+        },
+      ];
+
+      for (const stat of stats) {
+        const statDiv = document.createElement('div');
+        statDiv.className = 'summary-stat';
+        const strong = document.createElement('strong');
+        strong.textContent = stat.value;
+        const span = document.createElement('span');
+        span.textContent = stat.label;
+        statDiv.append(span, strong);
+        summaryEl.appendChild(statDiv);
+      }
+
+      const outputEl = document.getElementById('events-output');
+      outputEl.replaceChildren();
+
+      const wrapper = document.createElement('div');
+      wrapper.className = 'table-wrapper';
+
+      const table = document.createElement('table');
+      table.className = 'events-table';
+
+      const thead = document.createElement('thead');
+      const headerRow = document.createElement('tr');
+      const headers = [
+        'Seq #',
+        'Batch Ingest #',
+        'Backend Service',
+        'Order Event',
+        'Nanosecond UTC Timestamp',
+        'Interval Since Previous',
+      ];
+
+      for (const text of headers) {
+        const th = document.createElement('th');
+        th.scope = 'col';
+        th.textContent = text;
+        headerRow.appendChild(th);
+      }
+      thead.appendChild(headerRow);
+
+      const tbody = document.createElement('tbody');
+      analyzed.forEach((evt, idx) => {
+        const tr = document.createElement('tr');
+
+        const seqTd = document.createElement('td');
+        seqTd.textContent = String(idx + 1);
+
+        const ingestTd = document.createElement('td');
+        ingestTd.textContent = `#${evt.ingestionOrder}`;
+
+        const serviceTd = document.createElement('td');
+        const badge = document.createElement('span');
+        badge.className = 'badge mono';
+        badge.textContent = evt.service;
+        serviceTd.appendChild(badge);
+
+        const eventTd = document.createElement('td');
+        eventTd.className = 'mono';
+        eventTd.textContent = evt.eventType;
+
+        const tsTd = document.createElement('td');
+        tsTd.className = 'mono';
+        const timeEl = document.createElement('time');
+        timeEl.dateTime = evt.timestamp.toString();
+        timeEl.textContent = evt.timestamp.toString();
+        tsTd.appendChild(timeEl);
+
+        const intervalTd = document.createElement('td');
+        const pill = document.createElement('span');
+        pill.className = 'interval-pill mono';
+        pill.title = `ISO 8601 Duration: ${evt.isoInterval}`;
+        pill.textContent = evt.formattedInterval;
+        intervalTd.appendChild(pill);
+
+        tr.append(seqTd, ingestTd, serviceTd, eventTd, tsTd, intervalTd);
+        tbody.appendChild(tr);
+      });
+
+      table.append(thead, tbody);
+      wrapper.appendChild(table);
+      outputEl.appendChild(wrapper);
+    }
+
+    (async () => {
+      await ensureTemporal();
+      const loadBtn = document.getElementById('load-order-events-btn');
+      loadBtn.addEventListener('click', () => {
+        renderEventsBatch();
+      });
+    })();
+  </script>
 </body>
 
