+
+      /**
+       * Determines the appropriate Fetch targetAddressSpace ('local' or 'loopback')
+       * according to the Local Network Access (LNA) specification.
+       */
+      function resolveTargetAddressSpace(urlString, fallbackSpace) {
+        try {
+          const parsed = new URL(urlString);
+          const host = parsed.hostname.toLowerCase();
+          if (
+            host === '127.0.0.1' ||
+            host === 'localhost' ||
+            host === '[::1]' ||
+            host === '::1' ||
+            host.startsWith('127.')
+          ) {
+            return 'loopback';
+          }
+          if (
+            host.startsWith('192.168.') ||
+            host.startsWith('10.') ||
+            host.endsWith('.local') ||
+            /^172\.(1[6-9]|2\d|3[0-1])\./.test(host)
+          ) {
+            return 'local';
+          }
+        } catch (_err) {
+          // Fall back to the provided address space if URL parsing fails
+        }
+        return fallbackSpace;
+      }
+
+      function updatePermissionBadge(dotEl, stateEl, helpEl, state) {
+        if (!dotEl || !stateEl) return;
+        dotEl.className = 'status-dot ' + (state === 'granted' || state === 'prompt' || state === 'denied' ? state : '');
+        stateEl.textContent = state;
+        if (helpEl) {
+          if (state === 'denied') {
+            helpEl.classList.add('visible');
+          } else {
+            helpEl.classList.remove('visible');
+          }
+        }
+      }
+
+      async function querySinglePermission(permissionName, fallbackName) {
+        if (!navigator.permissions || typeof navigator.permissions.query !== 'function') {
+          return { state: 'unsupported', statusObj: null };
+        }
+        try {
+          const statusObj = await navigator.permissions.query({ name: permissionName });
+          return { state: statusObj.state, statusObj };
+        } catch (_primaryErr) {
+          if (fallbackName) {
+            try {
+              const fallbackObj = await navigator.permissions.query({ name: fallbackName });
+              return { state: fallbackObj.state, statusObj: fallbackObj };
+            } catch (_fallbackErr) {
+              return { state: 'prompt', statusObj: null };
+            }
+          }
+          return { state: 'prompt', statusObj: null };
+        }
+      }
+
+      async function checkLocalNetworkPermissions() {
