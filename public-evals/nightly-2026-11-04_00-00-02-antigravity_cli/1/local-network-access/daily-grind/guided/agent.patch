+  <script type="module">
+    /**
+     * Updates the permission badge and remediation alert box for a given LNA permission.
+     * @param {'local-network' | 'loopback-network'} permissionName
+     * @param {PermissionState} state
+     */
+    function updatePermissionUI(permissionName, state) {
+      const statusBadge = document.querySelector(`[data-permission-status="${permissionName}"]`);
+      const remediationBox = document.querySelector(`[data-remediation="${permissionName}"]`);
+      if (statusBadge) {
+        statusBadge.textContent = state;
+        statusBadge.dataset.state = state;
+      }
+      if (remediationBox) {
+        remediationBox.hidden = state !== 'denied';
+      }
+    }
+
+    /**
+     * Cross-browser permission check for the granular LNA permissions ('local-network' | 'loopback-network').
+     * Never queries the legacy 'local-network-access' name, which crashes older Chrome renderer processes.
+     * @param {'local-network' | 'loopback-network'} permissionName
+     * @returns {Promise<PermissionState>}
+     */
+    async function checkNetworkPermission(permissionName) {
+      if (!navigator.permissions?.query) {
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+      try {
+        const status = await navigator.permissions.query({ name: permissionName });
+        status.addEventListener('change', () => {
+          updatePermissionUI(permissionName, status.state);
+        });
+        updatePermissionUI(permissionName, status.state);
+        return status.state;
+      } catch {
+        // Unrecognized permission name in browsers without LNA support; proceed on user gesture
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+    }
+
+    /**
+     * Connects to the shop Wi-Fi coffee brewer over HTTP using targetAddressSpace: 'local'.
+     * @param {string} deviceUrl
+     */
+    async function fetchLocalBrewerStatus(deviceUrl = 'http://192.168.1.100:8080/api/status') {
+      const request = new Request(deviceUrl, {
+        method: 'GET',
+        mode: 'cors',
+        targetAddressSpace: 'local',
+      });
+
+      const response = await fetch(request);
+      if (!response.ok) {
+        throw new Error(`Brewer responded with HTTP ${response.status}`);
+      }
+      return response.json();
+    }
+
+    /**
+     * Connects to the companion desktop brewing helper over HTTP using targetAddressSpace: 'loopback'.
+     * @param {string} daemonUrl
+     */
+    async function fetchLoopbackHelper(daemonUrl = 'http://127.0.0.1:45678/health') {
+      const request = new Request(daemonUrl, {
+        method: 'GET',
+        mode: 'cors',
+        targetAddressSpace: 'loopback',
+      });
+
+      const response = await fetch(request);
+      if (!response.ok) {
+        throw new Error(`Desktop helper responded with HTTP ${response.status}`);
+      }
+      return response.json();
+    }
+
+    /**
+     * Opens a real-time WebSocket connection to a local or loopback endpoint.
+     * Passes only subprotocol string(s) as the second argument (never an options object).
+     * @param {string} wsUrl
+     */
+    function openEquipmentWebSocket(wsUrl) {
+      return new WebSocket(wsUrl, ['v1.telemetry']);
+    }
+
+    const lanUrlInput = document.getElementById('lan-brewer-url');
+    const lanWsInput = document.getElementById('lan-brewer-ws');
+    const lanOutput = document.getElementById('lan-status-output');
+    const lanRemediation = document.querySelector('[data-remediation="local-network"]');
+
+    const loopbackUrlInput = document.getElementById('loopback-helper-url');
+    const loopbackWsInput = document.getElementById('loopback-helper-ws');
+    const loopbackOutput = document.getElementById('loopback-status-output');
+    const loopbackRemediation = document.querySelector('[data-remediation="loopback-network"]');
+
+    let activeLanSocket = null;
+    let activeLoopbackSocket = null;
+
+    async function connectToLanBrewer() {
+      const url = lanUrlInput.value.trim();
+      lanOutput.textContent = `Connecting to shop Wi-Fi brewer at ${url} (targetAddressSpace: 'local')...`;
+      try {
+        const data = await fetchLocalBrewerStatus(url);
+        lanOutput.textContent = `Connected to Wi-Fi Brewer:\n${JSON.stringify(data, null, 2)}`;
+        await checkNetworkPermission('local-network');
+      } catch (err) {
+        lanOutput.textContent = `Connection failed (${err.name}: ${err.message}). Verify the brewer is online at ${url} and Local network permission is allowed.`;
+        if (lanRemediation) {
+          lanRemediation.hidden = false;
+        }
+      }
+    }
+
+    async function connectToLoopbackHelper() {
+      const url = loopbackUrlInput.value.trim();
+      loopbackOutput.textContent = `Connecting to desktop brewing helper at ${url} (targetAddressSpace: 'loopback')...`;
+      try {
+        const data = await fetchLoopbackHelper(url);
+        loopbackOutput.textContent = `Connected to Desktop Helper:\n${JSON.stringify(data, null, 2)}`;
+        await checkNetworkPermission('loopback-network');
+      } catch (err) {
+        loopbackOutput.textContent = `Connection failed (${err.name}: ${err.message}). Verify the companion helper is running on ${url} and Loopback network permission is allowed.`;
+        if (loopbackRemediation) {
+          loopbackRemediation.hidden = false;
+        }
+      }
+    }
+
+    function streamLanTelemetry() {
+      const wsUrl = lanWsInput.value.trim();
+      if (activeLanSocket) {
+        activeLanSocket.close();
+      }
+      lanOutput.textContent = `Opening WebSocket telemetry stream to ${wsUrl}...`;
+      try {
+        const socket = openEquipmentWebSocket(wsUrl);
+        activeLanSocket = socket;
+        socket.addEventListener('open', () => {
+          lanOutput.textContent = `Live telemetry connected (${wsUrl}). Waiting for brew updates...`;
+        });
+        socket.addEventListener('message', (event) => {
+          lanOutput.textContent = `Telemetry update:\n${event.data}`;
+        });
+        socket.addEventListener('error', () => {
+          lanOutput.textContent = `WebSocket error connecting to ${wsUrl}. Ensure the brewer is reachable on the local LAN and Local network permission is granted.`;
+          if (lanRemediation) {
+            lanRemediation.hidden = false;
+          }
+        });
+      } catch (err) {
+        lanOutput.textContent = `WebSocket initialization error: ${err.message}`;
+      }
+    }
+
+    function streamLoopbackEvents() {
+      const wsUrl = loopbackWsInput.value.trim();
+      if (activeLoopbackSocket) {
+        activeLoopbackSocket.close();
+      }
+      loopbackOutput.textContent = `Opening WebSocket scale stream to ${wsUrl}...`;
+      try {
+        const socket = openEquipmentWebSocket(wsUrl);
+        activeLoopbackSocket = socket;
+        socket.addEventListener('open', () => {
+          loopbackOutput.textContent = `Companion scale stream connected (${wsUrl}).`;
+        });
+        socket.addEventListener('message', (event) => {
+          loopbackOutput.textContent = `Scale event:\n${event.data}`;
+        });
+        socket.addEventListener('error', () => {
+          loopbackOutput.textContent = `WebSocket error connecting to ${wsUrl}. Ensure the companion desktop helper is running on 127.0.0.1 and Loopback network permission is granted.`;
+          if (loopbackRemediation) {
+            loopbackRemediation.hidden = false;
+          }
+        });
+      } catch (err) {
+        loopbackOutput.textContent = `WebSocket initialization error: ${err.message}`;
+      }
+    }
+
+    // Bind explicit user gesture buttons
+    document.getElementById('btn-connect-lan').addEventListener('click', connectToLanBrewer);
+    document.getElementById('btn-stream-lan').addEventListener('click', streamLanTelemetry);
+    document.getElementById('btn-connect-loopback').addEventListener('click', connectToLoopbackHelper);
+    document.getElementById('btn-stream-loopback').addEventListener('click', streamLoopbackEvents);
+
+    // Pre-check granular permissions on load; only auto-connect if permission is already 'granted'
+    async function initEquipmentConnections() {
+      const [lanState, loopbackState] = await Promise.all([
+        checkNetworkPermission('local-network'),
+        checkNetworkPermission('loopback-network'),
+      ]);
+
+      if (lanState === 'granted') {
+        connectToLanBrewer();
+      }
+      if (loopbackState === 'granted') {
+        connectToLoopbackHelper();
+      }
+    }
+
+    initEquipmentConnections();
+  </script>
 </body>
 
