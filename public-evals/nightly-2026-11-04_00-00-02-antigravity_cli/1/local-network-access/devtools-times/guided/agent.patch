+          type="button"
+          onClick={() => setIsOpen((prev) => !prev)}
+          className="inline-flex items-center space-x-1.5 bg-slate-900 hover:bg-slate-800 text-amber-300 border border-slate-700 text-xs font-semibold py-1.5 px-2.5 rounded cursor-pointer"
+          aria-expanded={isOpen}
+        >
+          <span className="h-2 w-2 rounded-full bg-amber-400" />
+          <span>Dev Diagnostics (LAN / CLI)</span>
+        </button>
+        {isOpen && (
+          <div
+            className="fixed inset-0 bg-black/40 backdrop-blur-xs z-[99999] flex justify-center items-start p-4 pt-[10vh]"
+            onClick={() => setIsOpen(false)}
+          >
+            <div className="w-full max-w-4xl" onClick={(e) => e.stopPropagation()}>
+              {renderPanelContent()}
+            </div>
+          </div>
+        )}
+      </>
+    );
+  }
+
+  return <section className="my-4">{renderPanelContent()}</section>;
+}
