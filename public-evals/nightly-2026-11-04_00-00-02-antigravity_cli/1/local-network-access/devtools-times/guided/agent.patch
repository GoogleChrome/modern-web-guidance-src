+  const handleLoopbackWebSocketStream = (wsUrl: string) => {
+    setLoopbackCli((prev) => ({ ...prev, wsStatus: 'connecting', errorMessage: null }));
+    try {
+      const socket = openLocalWebSocket(wsUrl);
+      socket.addEventListener('open', () => {
