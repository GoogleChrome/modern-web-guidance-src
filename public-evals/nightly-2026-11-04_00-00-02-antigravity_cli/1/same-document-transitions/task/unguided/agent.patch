+  <script>
+    (function () {
+      const ITEMS = {
+        'maple-oat-latte': {
+          id: 'maple-oat-latte',
+          title: 'Maple Oat Latte',
+          lead: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          description:
+            'Our signature double-shot espresso is paired with velvety steamed oat milk and pure Grade A Vermont maple syrup, finished with a light dusting of cinnamon.',
+          roast: 'Roast: Medium',
+          notes: 'Notes: Maple, Toasted Oat, Cinnamon',
+          price: '$5.75',
+          image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=1200&q=80'
+        },
+        'dark-roast-espresso': {
+          id: 'dark-roast-espresso',
+          title: 'Dark Roast Espresso',
+          lead: 'Bold, smokey, and perfect for a morning boost.',
+          description:
+            'Crafted from single-origin Sumatra and Colombian beans roasted to a deep, rich finish. Expect full-bodied intensity with dark chocolate undertones and a velvety crema.',
+          roast: 'Roast: Dark',
+          notes: 'Notes: Dark Cocoa, Cedar, Molasses',
+          price: '$3.75',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1200&q=80'
+        },
+        'cold-brew': {
+          id: 'cold-brew',
+          title: 'Cold Brew',
+          lead: 'Steeped for 18 hours for maximum smoothness.',
+          description:
+            'Coarse-ground Ethiopian and Guatemalan beans cold-steeped in filtered water for 18 hours, yielding a naturally sweet, low-acid coffee served over crystal-clear ice.',
+          roast: 'Roast: Medium-Dark',
+          notes: 'Notes: Caramel, Sweet Citrus, Hazelnut',
+          price: '$4.95',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1200&q=80'
+        }
+      };
+
+      const listPage = document.getElementById('list-page');
+      const listHeading = document.getElementById('list-heading');
+      const detailPage = document.getElementById('detail-page');
+      const heroEl = document.getElementById('hero');
+      const heroImg = document.getElementById('hero-img');
+      const titleEl = document.getElementById('title');
+      const detailLead = document.getElementById('detail-lead');
+      const detailDescription = document.getElementById('detail-description');
+      const detailRoast = document.getElementById('detail-roast');
+      const detailNotes = document.getElementById('detail-notes');
+      const detailPrice = document.getElementById('detail-price');
+      const backButton = document.getElementById('back-button');
+      const navMenu = document.getElementById('nav-menu');
+      const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+
+      let activeThumbnail = thumbnails[0];
+
+      function prefersReducedMotion() {
+        return (
+          typeof window.matchMedia === 'function' &&
+          window.matchMedia('(prefers-reduced-motion: reduce)').matches
+        );
+      }
+
+      function applyHeroTransitionProps(element) {
+        if (!element) return;
+        element.classList.add('is-transitioning-hero');
+        element.style.viewTransitionName = 'hero';
+      }
+
+      function applyTitleTransitionProps(element) {
+        if (!element) return;
+        element.classList.add('is-transitioning-title');
+        element.style.viewTransitionName = 'title';
+      }
+
+      function clearTransitionProps(element) {
+        if (!element) return;
+        element.classList.remove('is-transitioning-hero', 'is-transitioning-title');
+        element.style.removeProperty('view-transition-name');
+        if (element.getAttribute('style') === '') {
+          element.removeAttribute('style');
+        }
+      }
+
+      function clearAllTransitionProps() {
+        thumbnails.forEach((thumb) => {
+          clearTransitionProps(thumb);
+          clearTransitionProps(thumb.querySelector('.title'));
+        });
+      }
+
+      function populateDetail(item) {
+        titleEl.textContent = item.title;
+        heroEl.style.backgroundImage = `url('${item.image}')`;
+        if (heroImg) {
+          heroImg.src = item.image;
+          heroImg.alt = item.title;
+        }
+        detailLead.textContent = item.lead;
+        detailDescription.textContent = item.description;
+        detailRoast.textContent = item.roast;
+        detailNotes.textContent = item.notes;
+        detailPrice.textContent = item.price;
+      }
+
+      function showDetailView(thumbnail) {
+        if (!thumbnail) return;
+        activeThumbnail = thumbnail;
+        const itemId = thumbnail.getAttribute('data-id');
+        const item = ITEMS[itemId] || {
+          id: itemId,
+          title: (thumbnail.querySelector('.title') && thumbnail.querySelector('.title').textContent) || '',
+          lead: (thumbnail.querySelector('p') && thumbnail.querySelector('p').textContent) || '',
+          description: '',
+          roast: '',
+          notes: '',
+          price: '',
+          image: ''
+        };
+        const thumbTitle = thumbnail.querySelector('.title');
+
+        const updateDOM = () => {
+          populateDetail(item);
+          listPage.hidden = true;
+          detailPage.hidden = false;
+          titleEl.focus();
+        };
+
+        if (!document.startViewTransition || prefersReducedMotion()) {
+          clearAllTransitionProps();
+          updateDOM();
+          return;
+        }
+
+        clearAllTransitionProps();
+        applyHeroTransitionProps(thumbnail);
+        applyTitleTransitionProps(thumbTitle);
+
+        const transition = document.startViewTransition(() => {
+          updateDOM();
+        });
+
+        transition.finished.finally(() => {
+          clearAllTransitionProps();
+          if (!detailPage.hidden) {
+            titleEl.focus();
+          }
+        });
+      }
+
+      function showListView() {
+        const targetThumbnail = activeThumbnail || thumbnails[0];
+        const thumbTitle = targetThumbnail ? targetThumbnail.querySelector('.title') : null;
+
+        const updateDOM = () => {
+          detailPage.hidden = true;
+          listPage.hidden = false;
+          listHeading.focus();
+        };
+
+        if (!document.startViewTransition || prefersReducedMotion()) {
+          clearAllTransitionProps();
+          updateDOM();
+          return;
+        }
+
+        clearAllTransitionProps();
+        applyHeroTransitionProps(targetThumbnail);
+        applyTitleTransitionProps(thumbTitle);
+
+        const transition = document.startViewTransition(() => {
+          updateDOM();
+        });
+
+        transition.finished.finally(() => {
+          clearAllTransitionProps();
+          if (!listPage.hidden) {
+            listHeading.focus();
+          }
+        });
+      }
+
+      thumbnails.forEach((thumbnail) => {
+        thumbnail.addEventListener('click', (event) => {
+          event.preventDefault();
+          showDetailView(thumbnail);
+        });
+
+        thumbnail.addEventListener('keydown', (event) => {
+          if (event.key === 'Enter' || event.key === ' ') {
+            event.preventDefault();
+            showDetailView(thumbnail);
+          }
+        });
+      });
+
+      backButton.addEventListener('click', (event) => {
+        event.preventDefault();
+        showListView();
+      });
+
+      if (navMenu) {
+        navMenu.addEventListener('click', (event) => {
+          if (!detailPage.hidden) {
+            event.preventDefault();
+            showListView();
+          }
+        });
+      }
+    })();
+  </script>
 </body>
 
 </html>
