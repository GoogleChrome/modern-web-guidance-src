+  <script>
+    (function () {
+      const LEFT_REVEAL_WIDTH = 84;   // Swiping right reveals left action tray
+      const RIGHT_REVEAL_WIDTH = 156; // Swiping left reveals right action tray
+      const SNAP_THRESHOLD = 40;
+
+      const cards = Array.from(document.querySelectorAll('.grid .card'));
+      const toastEl = document.getElementById('toast-status');
+      let toastTimer = null;
+
+      function showToast(message) {
+        if (!toastEl) return;
+        toastEl.textContent = message;
+        toastEl.classList.add('is-visible');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => {
+          toastEl.classList.remove('is-visible');
+        }, 2800);
+      }
+
+      function setCardOffset(card, offset) {
+        const surface = card.querySelector('.card-surface');
+        card.dataset.offset = String(offset);
+        surface.style.transform = offset ? `translate3d(${offset}px, 0, 0)` : '';
+
+        card.classList.toggle('is-open-left', offset < 0);
+        card.classList.toggle('is-open-right', offset > 0);
+
+        const rightBtns = card.querySelectorAll('.card-actions-right .action-btn');
+        const leftBtns = card.querySelectorAll('.card-actions-left .action-btn');
+
+        rightBtns.forEach((btn) => {
+          const revealed = offset < 0;
+          btn.tabIndex = revealed ? 0 : -1;
+          btn.setAttribute('aria-hidden', revealed ? 'false' : 'true');
+        });
+
+        leftBtns.forEach((btn) => {
+          const revealed = offset > 0;
+          btn.tabIndex = revealed ? 0 : -1;
+          btn.setAttribute('aria-hidden', revealed ? 'false' : 'true');
+        });
+      }
+
+      function closeOtherCards(activeCard) {
+        cards.forEach((card) => {
+          if (card !== activeCard) {
+            setCardOffset(card, 0);
+          }
+        });
+      }
+
+      cards.forEach((card) => {
+        const surface = card.querySelector('.card-surface');
+        const drinkName = card.dataset.drink || 'Drink';
+        setCardOffset(card, 0);
+
+        let isPointerDown = false;
+        let isSwiping = false;
+        let suppressNextClick = false;
+        let startX = 0;
+        let startY = 0;
+        let baseOffset = 0;
+        let currentOffset = 0;
+        let activePointerId = null;
+
+        function clampOffset(rawOffset) {
+          if (rawOffset < -RIGHT_REVEAL_WIDTH) {
+            const extra = rawOffset + RIGHT_REVEAL_WIDTH;
+            return -RIGHT_REVEAL_WIDTH + extra * 0.2;
+          }
+          if (rawOffset > LEFT_REVEAL_WIDTH) {
+            const extra = rawOffset - LEFT_REVEAL_WIDTH;
+            return LEFT_REVEAL_WIDTH + extra * 0.2;
+          }
+          return rawOffset;
+        }
+
+        function finishGesture() {
+          if (!isPointerDown) return;
+          isPointerDown = false;
+          card.classList.remove('is-dragging');
+
+          if (!isSwiping) return;
+          isSwiping = false;
+
+          // Snap only to revealed or closed state; never auto-execute an action on swipe
+          let targetOffset = 0;
+          if (currentOffset <= -SNAP_THRESHOLD) {
+            targetOffset = -RIGHT_REVEAL_WIDTH;
+          } else if (currentOffset >= SNAP_THRESHOLD) {
+            targetOffset = LEFT_REVEAL_WIDTH;
+          }
+
+          if (targetOffset !== 0) {
+            closeOtherCards(card);
+          }
+          setCardOffset(card, targetOffset);
+        }
+
+        surface.addEventListener('pointerdown', (e) => {
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          isPointerDown = true;
+          isSwiping = false;
+          startX = e.clientX;
+          startY = e.clientY;
+          baseOffset = parseFloat(card.dataset.offset || '0');
+          currentOffset = baseOffset;
+          activePointerId = e.pointerId;
+        });
+
+        surface.addEventListener('pointermove', (e) => {
+          if (!isPointerDown || e.pointerId !== activePointerId) return;
+
+          const dx = e.clientX - startX;
+          const dy = e.clientY - startY;
+
+          if (!isSwiping) {
+            if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
+            if (Math.abs(dy) > Math.abs(dx)) {
+              isPointerDown = false;
+              return;
+            }
+            isSwiping = true;
+            suppressNextClick = true;
+            card.classList.add('is-dragging');
+            closeOtherCards(card);
+            if (surface.setPointerCapture) {
+              try {
+                surface.setPointerCapture(e.pointerId);
+              } catch (_) {}
+            }
+          }
+
+          currentOffset = clampOffset(baseOffset + dx);
+          surface.style.transform = `translate3d(${currentOffset}px, 0, 0)`;
+        });
+
+        surface.addEventListener('pointerup', finishGesture);
+        surface.addEventListener('pointercancel', finishGesture);
+
+        // Fallback touch events for environments without PointerEvents
+        if (!window.PointerEvent) {
+          surface.addEventListener('touchstart', (e) => {
+            if (e.touches.length !== 1) return;
+            isPointerDown = true;
+            isSwiping = false;
+            startX = e.touches[0].clientX;
+            startY = e.touches[0].clientY;
+            baseOffset = parseFloat(card.dataset.offset || '0');
+            currentOffset = baseOffset;
+          }, { passive: true });
+
+          surface.addEventListener('touchmove', (e) => {
+            if (!isPointerDown || e.touches.length !== 1) return;
+            const dx = e.touches[0].clientX - startX;
+            const dy = e.touches[0].clientY - startY;
+
+            if (!isSwiping) {
+              if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
+              if (Math.abs(dy) > Math.abs(dx)) {
+                isPointerDown = false;
+                return;
+              }
+              isSwiping = true;
+              suppressNextClick = true;
+              card.classList.add('is-dragging');
+              closeOtherCards(card);
+            }
+
+            currentOffset = clampOffset(baseOffset + dx);
+            surface.style.transform = `translate3d(${currentOffset}px, 0, 0)`;
+          }, { passive: true });
+
+          surface.addEventListener('touchend', finishGesture);
+          surface.addEventListener('touchcancel', finishGesture);
+        }
+
+        // Prevent accidental link click right after a horizontal drag gesture
+        // Or close an open card when tapping its surface
+        surface.addEventListener('click', (e) => {
+          if (suppressNextClick) {
+            e.preventDefault();
+            e.stopPropagation();
+            suppressNextClick = false;
+            return;
+          }
+
+          const offset = parseFloat(card.dataset.offset || '0');
+          if (offset !== 0 && !e.target.closest('a')) {
+            setCardOffset(card, 0);
+          }
+        }, true);
+
+        // Keyboard support for revealing/hiding contextual actions without executing them
+        surface.addEventListener('keydown', (e) => {
+          const offset = parseFloat(card.dataset.offset || '0');
+          if (e.key === 'ArrowLeft') {
+            e.preventDefault();
+            closeOtherCards(card);
+            setCardOffset(card, offset > 0 ? 0 : -RIGHT_REVEAL_WIDTH);
+          } else if (e.key === 'ArrowRight') {
+            e.preventDefault();
+            closeOtherCards(card);
+            setCardOffset(card, offset < 0 ? 0 : LEFT_REVEAL_WIDTH);
+          } else if (e.key === 'Escape' && offset !== 0) {
+            e.preventDefault();
+            setCardOffset(card, 0);
+          }
+        });
+
+        // Explicit button click handlers for contextual actions
+        card.querySelectorAll('.action-btn').forEach((btn) => {
+          btn.addEventListener('click', () => {
+            const action = btn.dataset.action;
+            if (action === 'order') {
+              showToast(`Added ${drinkName} to your order.`);
+              setCardOffset(card, 0);
+            } else if (action === 'customize') {
+              showToast(`Customizing ${drinkName}...`);
+              setCardOffset(card, 0);
+            } else if (action === 'favorite') {
+              const isFav = btn.classList.toggle('is-favorited');
+              btn.setAttribute('aria-pressed', isFav ? 'true' : 'false');
+              const labelSpan = btn.querySelector('span');
+              if (labelSpan) {
+                labelSpan.textContent = isFav ? 'Saved' : 'Favorite';
+              }
+              showToast(
+                isFav
+                  ? `Saved ${drinkName} to your favorites.`
+                  : `Removed ${drinkName} from your favorites.`
+              );
+              setCardOffset(card, 0);
+            }
+          });
+        });
+      });
+
+      // Close open swipe trays when clicking outside cards
+      document.addEventListener('click', (e) => {
+        if (!e.target.closest('.grid .card')) {
+          closeOtherCards(null);
+        }
+      });
+    })();
+  </script>
