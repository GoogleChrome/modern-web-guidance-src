+    .SwipeReveal {
+      display: grid;
+      grid-template-columns: 100% max-content;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      overscroll-behavior: auto;
+      overscroll-behavior: chain;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+      background: white;
+      padding: 20px;
+    }
+
+    .SwipeReveal-content:focus-visible {
+      outline: auto;
+      outline-offset: -2px;
+    }
+
+    .SwipeReveal-panel {
+      scroll-snap-align: end;
+      display: flex;
+
+      &:first-child {
+        scroll-snap-align: start;
+      }
+    }
+
+    .SwipeReveal-panel button {
+      border: none;
+      padding: 0 16px;
+      font: inherit;
+      font-size: 0.9rem;
+      font-weight: 600;
+      color: white;
+      background: var(--primary);
+      cursor: pointer;
+      white-space: nowrap;
+      transition: filter 0.2s;
+    }
+
+    .SwipeReveal-panel button:nth-child(even) {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .SwipeReveal-panel button:hover {
+      filter: brightness(1.1);
+    }
+
+    .SwipeReveal-panel button:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: -2px;
+    }
+
