+        const nextEmail = profileEmail.value.trim().toLowerCase();
+        const nextPhone = profilePhone.value.trim();
+        const nextDrink = profileDrink.value;
+
+        if (!nextName || !nextEmail) {
+          showStatus('Display name and email address cannot be empty.', 'error');
+          return;
+        }
+
+        const sensitiveChanged =
+          nextEmail !== (customer.email || '').toLowerCase() ||
+          nextPhone !== (customer.phone || '');
+
+        const commitSave = () => {
+          const customers = loadCustomers();
+          const emailConflict = customers.some(
+            (c) => c.id !== customer.id && c.email.toLowerCase() === nextEmail
+          );
+          if (emailConflict) {
+            showStatus('Another customer account is already using that email address.', 'error');
+            return;
+          }
+
+          const target = customers.find((c) => c.id === customer.id);
+          if (!target) return;
+
+          target.displayName = nextName;
+          target.email = nextEmail;
+          target.phone = nextPhone;
+          target.favoriteDrink = nextDrink;
+          saveCustomers(customers);
+          renderAccountUI();
+          showStatus('Customer profile and preferences updated.', 'success');
+        };
+
+        if (forceReauthFirst || (sensitiveChanged && !isReauthenticated())) {
+          promptReauthentication(
+            'Updating your account email or phone number requires passkey reauthentication.',
+            commitSave
+          );
+          return;
+        }
+
+        commitSave();
+      }
+
+      profileForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        applyProfileChanges(false);
+      });
+
+      btnReauthAndSave.addEventListener('click', () => {
+        applyProfileChanges(true);
+      });
+
+      // Saved Passkey Management: Add, Rename, Remove
+      addPasskeyForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const customer = getCurrentCustomer();
+        if (!customer) return;
+
+        const label =
+          newPasskeyLabel.value.trim() ||
+          `Passkey #${(customer.passkeys ? customer.passkeys.length : 0) + 1}`;
+
+        const enrollNewPasskey = async () => {
+          try {
+            const latestCustomers = loadCustomers();
+            const target = latestCustomers.find((c) => c.id === customer.id);
+            if (!target) return;
+
+            const createdPasskey = await createWebAuthnPasskey(target, label);
+            target.passkeys = target.passkeys || [];
+            target.passkeys.push(createdPasskey);
+            saveCustomers(latestCustomers);
+
+            newPasskeyLabel.value = '';
+            renderAccountUI();
+            showStatus(`Added new passkey "${createdPasskey.label}" to your account.`, 'success');
+          } catch (err) {
+            showStatus(err.message || 'Could not add new passkey.', 'error');
+          }
+        };
+
+        if (!isReauthenticated()) {
+          promptReauthentication(
+            'Please verify your existing passkey before registering a new passkey to your account.',
+            enrollNewPasskey
+          );
+          return;
+        }
+
+        await enrollNewPasskey();
+      });
+
+      function handleRenamePasskey(credentialId) {
+        const customer = getCurrentCustomer();
+        if (!customer) return;
+        const customers = loadCustomers();
+        const target = customers.find((c) => c.id === customer.id);
+        if (!target) return;
+        const pk = (target.passkeys || []).find((item) => item.credentialId === credentialId);
+        if (!pk) return;
+
+        const nextLabel = window.prompt('Enter a new nickname for this passkey:', pk.label);
+        if (nextLabel && nextLabel.trim()) {
+          pk.label = nextLabel.trim();
+          saveCustomers(customers);
+          renderAccountUI();
+          showStatus(`Renamed passkey to "${pk.label}".`, 'info');
+        }
+      }
+
+      function handleDeletePasskey(credentialId) {
+        const customer = getCurrentCustomer();
+        if (!customer) return;
+
+        if ((customer.passkeys || []).length <= 1) {
+          showStatus(
+            'You must keep at least one active passkey on your passwordless Daily Grind account.',
+            'error'
+          );
+          return;
+        }
+
+        const executeRemove = () => {
+          const customers = loadCustomers();
+          const target = customers.find((c) => c.id === customer.id);
+          if (!target) return;
+          const removed = (target.passkeys || []).find((item) => item.credentialId === credentialId);
+          target.passkeys = (target.passkeys || []).filter((item) => item.credentialId !== credentialId);
+          saveCustomers(customers);
+          renderAccountUI();
+          showStatus(
+            `Removed passkey "${removed ? removed.label : credentialId.slice(0, 8)}" from your account.`,
+            'info'
+          );
+        };
+
+        promptReauthentication(
+          'Removing a saved passkey requires step-up reauthentication with a passkey.',
+          executeRemove
+        );
+      }
+
+      // Sign Out
+      function handleSignOut(e) {
+        if (e) e.preventDefault();
+        if (!getCurrentCustomer()) {
+          document.getElementById('account').scrollIntoView({ behavior: 'smooth' });
+          return;
+        }
+        saveSession(null);
+        renderAccountUI();
+        showStatus('You have been signed out of your Daily Grind account.', 'info');
+      }
+
+      btnSignout.addEventListener('click', handleSignOut);
+      navLogoutLink.addEventListener('click', handleSignOut);
+
+      // Initialize
+      seedDefaultCustomerIfEmpty();
+      detectWebAuthnCapabilities();
+      renderAccountUI();
+    })();
+  </script>
+
 </body>
 
