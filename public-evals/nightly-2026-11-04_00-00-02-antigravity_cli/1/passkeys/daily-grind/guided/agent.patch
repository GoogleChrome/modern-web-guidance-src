+              rpId,
+              userId: localStore.user.id,
+              name: updatedName,
+              displayName: updatedDisplayName,
+            });
+          } catch (e) {
+            console.error('SignalCurrentUserDetails sync failure:', e);
+          }
+        }
+        showBanner('Profile details updated and synchronized with your passkey provider.', 'success');
+      }
+    }
+
+    // =========================================================================
+    // 5. Passkey Reauthentication (Step-Up Verification)
+    // =========================================================================
+    let reauthAbortController = new AbortController();
+
+    async function triggerButtonReauth() {
+      // Abort any background suggestion flows to avoid passkey prompt collisions
+      autofillAbortController.abort();
+      reauthAbortController.abort();
+      reauthAbortController = new AbortController();
+
+      const optionsJSON = await reauthOptionsFetch();
+      const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+      let credential;
+      try {
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: reauthAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          showBanner('Reauthentication cancelled.', 'info');
+        }
+        return;
+      }
+
+      if (!credential) return;
+
+      const encodedCredential = credential.toJSON();
+      try {
+        const verifyResponse = await reauthVerifyFetch(encodedCredential);
+        const reauthResult = document.getElementById('reauth-result');
+        if (verifyResponse.ok) {
+          if (reauthResult) {
+            reauthResult.textContent = 'Identity verified! You can now manage rewards and payment methods.';
+          }
+          showBanner('Step-up passkey reauthentication succeeded.', 'success');
+        } else if (verifyResponse.status === 404) {
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: optionsJSON.rpId || rpId,
+              credentialId: encodedCredential.id,
+            });
+          }
+          showBanner('Passkey no longer recognized for this account.', 'error');
+        } else {
+          showBanner('Reauthentication failed.', 'error');
+        }
+      } catch (err) {
+        console.error('Reauthentication verification error:', err);
+        showBanner('Could not verify reauthentication with the server.', 'error');
+      }
+    }
+
+    // =========================================================================
+    // Event Listeners & Initialization
+    // =========================================================================
+    window.addEventListener('DOMContentLoaded', async () => {
+      await gatePasskeyCapabilitiesOnLoad();
+      await loadManagementPanel();
+      await initializeConditionalAutofill();
+
+      // Explicit "Sign in with passkey" button
+      const passkeySigninBtn = document.getElementById('passkey-signin-btn');
+      if (passkeySigninBtn) {
+        passkeySigninBtn.addEventListener('click', () => {
+          triggerButtonAuthentication();
+        });
+      }
+
+      // Standard password sign-in form -> triggers Conditional Create on success
+      const signinForm = document.getElementById('signin-form');
+      if (signinForm) {
+        signinForm.addEventListener('submit', async (e) => {
+          e.preventDefault();
+          const usernameInput = document.getElementById('signin-username');
+          const username = usernameInput?.value?.trim() || localStore.user.name;
+          try {
+            await fetch('/api/login/password', {
+              method: 'POST',
+              headers: { 'Content-Type': 'application/json' },
+              body: JSON.stringify({
+                username,
+                password: document.getElementById('signin-password')?.value || '',
+              }),
+            });
+          } catch {
+            // Ignore network error on static server
+          }
+          handleSignInSuccess(username);
+          await triggerConditionalCreate(autofillAbortController);
+        });
+      }
+
+      // Customer Registration with Passkey form
+      const registerForm = document.getElementById('register-form');
+      if (registerForm) {
+        registerForm.addEventListener('submit', async (e) => {
+          e.preventDefault();
+          const username = document.getElementById('register-username')?.value?.trim() || localStore.user.name;
+          const displayName =
+            document.getElementById('register-display-name')?.value?.trim() || localStore.user.displayName;
+          await registerPasskey({ isPromotion: false, username, displayName });
+        });
+      }
+
+      // Management "+ Create Passkey" button
+      const createPasskeyBtn = document.getElementById('create-passkey-btn');
+      if (createPasskeyBtn) {
+        createPasskeyBtn.addEventListener('click', () => {
+          registerPasskey({ isPromotion: false });
+        });
+      }
+
+      // Rename passkey form submission
+      const renameForm = document.getElementById('rename-passkey-form');
+      if (renameForm) {
+        renameForm.addEventListener('submit', async (e) => {
+          e.preventDefault();
+          const id = document.getElementById('rename-credential-id')?.value;
+          const newName = document.getElementById('rename-credential-name')?.value?.trim();
+          if (id && newName) {
+            await performCredentialRename(id, newName);
+            renameForm.style.display = 'none';
+          }
+        });
+      }
+
+      const cancelRenameBtn = document.getElementById('cancel-rename-btn');
+      if (cancelRenameBtn && renameForm) {
+        cancelRenameBtn.addEventListener('click', () => {
+          renameForm.style.display = 'none';
+        });
+      }
+
+      // Profile update form -> triggers signalCurrentUserDetails
+      const profileForm = document.getElementById('profile-form');
+      if (profileForm) {
+        profileForm.addEventListener('submit', async (e) => {
+          e.preventDefault();
+          const updatedName = document.getElementById('profile-username')?.value?.trim() || localStore.user.name;
+          const updatedDisplayName =
+            document.getElementById('profile-display-name')?.value?.trim() || localStore.user.displayName;
+          await performUserRename(updatedName, updatedDisplayName);
+        });
+      }
+
+      // Step-up Reauthentication button
+      const reauthBtn = document.getElementById('reauth-btn');
+      if (reauthBtn) {
+        reauthBtn.addEventListener('click', () => {
+          triggerButtonReauth();
+        });
+      }
+    });
+  </script>
+
 </body>
 
 </html>
