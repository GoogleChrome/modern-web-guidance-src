diff --git a/src/components/HeaderAuthStatus.tsx b/src/components/HeaderAuthStatus.tsx
new file mode 100644
index 0000000..c1f9d7d
--- /dev/null
+++ b/src/components/HeaderAuthStatus.tsx
@@ -0,0 +1,114 @@
+import React, { useEffect, useState } from 'react';
+import {
+  getCurrentUser,
+  signOutCurrentUser,
+  type UserAccount,
+} from '../utils/passkeys';
+
+export default function HeaderAuthStatus() {
+  const [user, setUser] = useState<UserAccount | null>(null);
+  const [mounted, setMounted] = useState(false);
+
+  const baseUrl = import.meta.env.BASE_URL;
+
+  useEffect(() => {
+    setMounted(true);
+    setUser(getCurrentUser());
+
+    const handleAuthChange = () => {
+      setUser(getCurrentUser());
+    };
+
+    window.addEventListener('devtools-times-auth-change', handleAuthChange);
+    window.addEventListener('storage', handleAuthChange);
+    return () => {
+      window.removeEventListener('devtools-times-auth-change', handleAuthChange);
+      window.removeEventListener('storage', handleAuthChange);
+    };
+  }, []);
+
+  const handleSignOut = async () => {
+    signOutCurrentUser();
+    try {
+      await fetch(`${baseUrl}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ action: 'signout' }),
+      });
+    } catch {
+      // Ignore network errors
+    }
+    setUser(null);
+  };
+
+  if (mounted && user) {
+    return (
+      <div className="flex items-center space-x-2 sm:space-x-3">
+        <a
+          href={`${baseUrl}account`}
+          data-skip-tracking="true"
+          className="flex items-center space-x-1.5 text-xs font-semibold text-gray-800 bg-gray-100 hover:bg-gray-200 border border-gray-300 py-1.5 px-3 rounded transition-colors"
+          title="Account Settings & Passkeys"
+        >
+          <svg
+            className="w-4 h-4 text-gray-700"
+            fill="none"
+            stroke="currentColor"
+            viewBox="0 0 24 24"
+          >
+            <path
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              strokeWidth={2}
+              d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+            />
+          </svg>
+          <span>{user.displayName || user.username}</span>
+          <span className="hidden sm:inline-block bg-gray-900 text-white text-[10px] px-1.5 py-0.5 rounded-full">
+            {user.passkeys.length} {user.passkeys.length === 1 ? 'passkey' : 'passkeys'}
+          </span>
+        </a>
+        <a
+          href={`${baseUrl}account`}
+          data-skip-tracking="true"
+          className="bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded whitespace-nowrap hover:bg-gray-700"
+        >
+          Account Settings
+        </a>
+        <button
+          type="button"
+          onClick={handleSignOut}
+          className="bg-gray-200 text-gray-700 text-xs font-semibold py-2 px-2.5 rounded hover:bg-gray-300 cursor-pointer"
+        >
+          Sign out
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex items-center space-x-2 sm:space-x-3">
+      <a
+        href={`${baseUrl}account`}
+        data-skip-tracking="true"
+        className="text-gray-700 hover:text-gray-900 text-xs font-semibold py-2 px-2.5 rounded border border-gray-300 hover:bg-gray-100 whitespace-nowrap"
+      >
+        Account Settings
+      </a>
+      <a
+        href={`${baseUrl}signup`}
+        data-skip-tracking="true"
+        className="bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded whitespace-nowrap hover:bg-gray-700"
+      >
+        Sign up
+      </a>
+      <a
+        href={`${baseUrl}signin`}
+        data-skip-tracking="true"
+        className="bg-gray-500 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-400 whitespace-nowrap"
+      >
+        Sign in
+      </a>
+    </div>
+  );
+}
diff --git a/src/components/ReauthModal.tsx b/src/components/ReauthModal.tsx
new file mode 100644
index 0000000..d892b56
--- /dev/null
+++ b/src/components/ReauthModal.tsx
@@ -0,0 +1,269 @@
+import React, { useState } from 'react';
+import {
+  authenticateWithWebAuthnPasskey,
+  loadAuthState,
+  markUserReauthenticated,
+  type UserAccount,
+} from '../utils/passkeys';
+
+interface ReauthModalProps {
+  user: UserAccount;
+  actionDescription: string;
+  onSuccess: (updatedUser: UserAccount) => void;
+  onCancel: () => void;
+}
+
+export default function ReauthModal({
+  user,
+  actionDescription,
+  onSuccess,
+  onCancel,
+}: ReauthModalProps) {
+  const [method, setMethod] = useState<'passkey' | 'password'>(
+    user.passkeys.length > 0 ? 'passkey' : 'password'
+  );
+  const [selectedPasskeyId, setSelectedPasskeyId] = useState<string>(
+    user.passkeys[0]?.id || 'any'
+  );
+  const [password, setPassword] = useState('');
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const baseUrl = import.meta.env.BASE_URL;
+
+  const completeReauth = async () => {
+    const updated = markUserReauthenticated(user.id);
+    if (updated) {
+      try {
+        await fetch(`${baseUrl}api/passkeys.json`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ action: 'reauthenticate', user: updated }),
+        });
+      } catch {
+        // Ignore network error
+      }
+      onSuccess(updated);
+    }
+  };
+
+  const handlePasskeyReauth = async () => {
+    setError(null);
+    setLoading(true);
+    try {
+      const allowCredentialIds =
+        selectedPasskeyId === 'any'
+          ? user.passkeys.map((pk) => ({ id: pk.id, transports: pk.transports }))
+          : user.passkeys
+              .filter((pk) => pk.id === selectedPasskeyId)
+              .map((pk) => ({ id: pk.id, transports: pk.transports }));
+
+      const result = await authenticateWithWebAuthnPasskey({
+        allowCredentialIds,
+      });
+
+      // Update passkey lastUsedAt if matched
+      const state = loadAuthState();
+      const targetUser = state.users[user.id];
+      if (targetUser) {
+        const matched = targetUser.passkeys.find((pk) => pk.id === result.credentialId);
+        if (matched) {
+          matched.lastUsedAt = new Date().toISOString();
+        }
+      }
+      await completeReauth();
+    } catch (err: any) {
+      if (err?.name === 'NotAllowedError') {
+        setError(
+          'Passkey verification was cancelled or timed out. Try again or use a virtual authenticator in Chrome DevTools WebAuthn tab.'
+        );
+      } else {
+        setError(err?.message || 'Passkey verification failed.');
+      }
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const handlePasswordReauth = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setLoading(true);
+    try {
+      if (!password.trim()) {
+        setError('Please enter your password to verify your identity.');
+        setLoading(false);
+        return;
+      }
+      if (user.passwordHash && password !== user.passwordHash) {
+        setError('Incorrect password. (Hint: for demo user alex.rivera, use "devtools123")');
+        setLoading(false);
+        return;
+      }
+      await completeReauth();
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div
+      className="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 flex items-center justify-center p-4"
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="reauth-modal-title"
+    >
+      <div className="bg-white border border-gray-200 rounded-lg shadow-xl max-w-md w-full p-6">
+        <div className="flex items-start justify-between mb-4">
+          <div className="flex items-center space-x-2.5">
+            <div className="p-2 bg-amber-100 text-amber-800 rounded-full">
+              <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  strokeWidth={2}
+                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
+                />
+              </svg>
+            </div>
+            <div>
+              <h3 id="reauth-modal-title" className="text-lg font-bold text-gray-900">
+                Verify Your Identity
+              </h3>
+              <p className="text-xs text-gray-500">Reauthentication required</p>
+            </div>
+          </div>
+          <button
+            type="button"
+            onClick={onCancel}
+            className="text-gray-400 hover:text-gray-600 p-1 cursor-pointer"
+            aria-label="Close modal"
+          >
+            <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
+            </svg>
+          </button>
+        </div>
+
+        <p className="text-sm text-gray-700 mb-4">
+          To continue with <span className="font-semibold text-gray-900">{actionDescription}</span>, please confirm your identity as{' '}
+          <span className="font-semibold">{user.username}</span>.
+        </p>
+
+        {error && (
+          <div className="mb-4 p-3 text-xs text-red-700 bg-red-50 border border-red-200 rounded-md" role="alert">
+            {error}
+          </div>
+        )}
+
+        <div className="flex border-b border-gray-200 mb-4 text-xs font-semibold">
+          <button
+            type="button"
+            onClick={() => {
+              setMethod('passkey');
+              setError(null);
+            }}
+            className={`py-2 px-4 border-b-2 cursor-pointer ${
+              method === 'passkey'
+                ? 'border-gray-900 text-gray-900'
+                : 'border-transparent text-gray-500 hover:text-gray-700'
+            }`}
+          >
+            Passkey
+          </button>
+          <button
+            type="button"
+            onClick={() => {
+              setMethod('password');
+              setError(null);
+            }}
+            className={`py-2 px-4 border-b-2 cursor-pointer ${
+              method === 'password'
+                ? 'border-gray-900 text-gray-900'
+                : 'border-transparent text-gray-500 hover:text-gray-700'
+            }`}
+          >
+            Password
+          </button>
+        </div>
+
+        {method === 'passkey' ? (
+          <div className="space-y-4">
+            {user.passkeys.length > 0 && (
+              <div>
+                <label htmlFor="reauth-passkey-select" className="block text-xs font-medium text-gray-700 mb-1">
+                  Credential to verify with
+                </label>
+                <select
+                  id="reauth-passkey-select"
+                  value={selectedPasskeyId}
+                  onChange={(e) => setSelectedPasskeyId(e.target.value)}
+                  className="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+                >
+                  <option value="any">Any registered passkey ({user.passkeys.length})</option>
+                  {user.passkeys.map((pk) => (
+                    <option key={pk.id} value={pk.id}>
+                      {pk.name} ({pk.deviceType === 'multiDevice' ? 'Synced' : 'Hardware Key'})
+                    </option>
+                  ))}
+                </select>
+              </div>
+            )}
+
+            <button
+              type="button"
+              onClick={handlePasskeyReauth}
+              disabled={loading}
+              className="w-full flex items-center justify-center space-x-2 py-2.5 px-4 bg-gray-900 hover:bg-gray-800 text-white text-sm font-medium rounded-md shadow-xs cursor-pointer disabled:opacity-60"
+            >
+              <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  strokeWidth={2}
+                  d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+                />
+              </svg>
+              <span>{loading ? 'Verifying with passkey...' : 'Verify with Passkey'}</span>
+            </button>
+          </div>
+        ) : (
+          <form onSubmit={handlePasswordReauth} className="space-y-4">
+            <div>
+              <label htmlFor="reauth-password" className="block text-xs font-medium text-gray-700 mb-1">
+                Current Password
+              </label>
+              <input
+                id="reauth-password"
+                type="password"
+                autoComplete="current-password"
+                value={password}
+                onChange={(e) => setPassword(e.target.value)}
+                required
+                placeholder="Enter your password"
