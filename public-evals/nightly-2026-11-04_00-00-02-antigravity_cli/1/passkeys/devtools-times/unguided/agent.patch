+  const baseUrl = import.meta.env.BASE_URL;
+
+  const refreshState = () => {
+    const state = loadAuthState();
+    const userList = Object.values(state.users);
+    setAllUsers(userList);
+
+    let active = state.currentUserId ? state.users[state.currentUserId] : null;
+    if (!active && userList.length > 0) {
+      active = userList[0];
