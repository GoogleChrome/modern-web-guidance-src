+    refreshState();
+    getWebAuthnSupport().then(setSupport);
+
+    const handleStorage = () => refreshState();
+    window.addEventListener('devtools-times-auth-change', handleStorage);
+    return () => window.removeEventListener('devtools-times-auth-change', handleStorage);
