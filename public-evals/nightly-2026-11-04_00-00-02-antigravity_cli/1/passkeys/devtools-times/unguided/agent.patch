+                onChange={(e) => setNewPasskeyName(e.target.value)}
+                placeholder="e.g. iCloud Keychain or YubiKey"
+                className="w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+              />
+            </div>
+
+            <div>
+              <label htmlFor="new-passkey-attachment" className="block text-xs font-medium text-gray-700 mb-1">
+                Authenticator Attachment
+              </label>
+              <select
+                id="new-passkey-attachment"
+                value={attachmentType}
+                onChange={(e) =>
+                  setAttachmentType(e.target.value as 'platform' | 'cross-platform' | 'any')
+                }
+                className="w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+              >
+                <option value="platform">This Device (Platform Authenticator)</option>
+                <option value="cross-platform">Security Key or Another Device (Cross-Platform)</option>
+                <option value="any">Any Authenticator</option>
+              </select>
+            </div>
+
+            <div className="flex items-end">
+              <button
+                type="button"
+                onClick={handleAddPasskey}
+                disabled={creatingPasskey || !support.isSupported}
+                className="w-full flex items-center justify-center space-x-2 py-2 px-4 bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold rounded-md shadow-xs cursor-pointer disabled:opacity-60"
+              >
+                <svg className="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+                  <path
+                    strokeLinecap="round"
+                    strokeLinejoin="round"
+                    strokeWidth={2}
+                    d="M12 4v16m8-8H4"
+                  />
+                </svg>
+                <span>{creatingPasskey ? 'Registering...' : 'Create Passkey'}</span>
+              </button>
+            </div>
+          </div>
+        </div>
+      </section>
+
+      {/* Profile & Password Settings (Protected by Reauthentication) */}
+      <div className="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
+        <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-xs">
+          <h2 className="text-base font-bold text-gray-900 mb-1">Profile & Passkey Display Info</h2>
+          <p className="text-xs text-gray-500 mb-4">
+            Changes sync with your browser's passkey manager via WebAuthn Signal API.
+          </p>
+          <form onSubmit={handleUpdateProfile} className="space-y-4">
+            <div>
+              <label htmlFor="account-username" className="block text-xs font-medium text-gray-700 mb-1">
+                Username
+              </label>
+              <input
+                id="account-username"
+                type="text"
+                value={user.username}
+                disabled
+                className="w-full px-3 py-2 text-sm bg-gray-100 border border-gray-200 rounded-md text-gray-600"
+              />
+            </div>
+            <div>
+              <label htmlFor="account-display-name" className="block text-xs font-medium text-gray-700 mb-1">
+                Display Name
+              </label>
+              <input
+                id="account-display-name"
+                type="text"
+                value={displayNameInput}
+                onChange={(e) => setDisplayNameInput(e.target.value)}
+                className="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+              />
+            </div>
+            <div>
+              <label htmlFor="account-email" className="block text-xs font-medium text-gray-700 mb-1">
+                Email Address
+              </label>
+              <input
+                id="account-email"
+                type="email"
+                value={emailInput}
+                onChange={(e) => setEmailInput(e.target.value)}
+                className="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+              />
+            </div>
+            <button
+              type="submit"
+              className="py-2 px-4 bg-gray-900 hover:bg-gray-800 text-white text-xs font-semibold rounded-md cursor-pointer"
+            >
+              Save Profile Changes
+            </button>
+          </form>
+        </section>
+
+        <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-xs">
+          <h2 className="text-base font-bold text-gray-900 mb-1">Password & Fallback Security</h2>
+          <p className="text-xs text-gray-500 mb-4">
+            Updating your fallback password requires verifying your identity with a passkey or current password.
+          </p>
+          <form onSubmit={handleChangePassword} className="space-y-4">
+            <div>
+              <label htmlFor="new-account-password" className="block text-xs font-medium text-gray-700 mb-1">
+                New Password
+              </label>
+              <input
+                id="new-account-password"
+                type="password"
+                autoComplete="new-password"
+                value={newPassword}
+                onChange={(e) => setNewPassword(e.target.value)}
+                placeholder="At least 8 characters"
+                className="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+              />
+            </div>
+
+            <div className="p-3 bg-gray-50 rounded-md border border-gray-200 text-xs text-gray-600 space-y-1">
+              <div className="flex justify-between">
+                <span>WebAuthn Supported:</span>
+                <span className="font-semibold text-gray-900">{support.isSupported ? 'Yes' : 'No'}</span>
+              </div>
+              <div className="flex justify-between">
+                <span>Platform Authenticator Available:</span>
+                <span className="font-semibold text-gray-900">
+                  {support.isPlatformAvailable ? 'Available' : 'Not detected'}
+                </span>
+              </div>
+              <div className="flex justify-between">
+                <span>Conditional UI (Autofill):</span>
+                <span className="font-semibold text-gray-900">
+                  {support.isConditionalMediationAvailable ? 'Supported' : 'Not detected'}
+                </span>
+              </div>
+            </div>
+
+            <button
+              type="submit"
+              className="py-2 px-4 bg-gray-900 hover:bg-gray-800 text-white text-xs font-semibold rounded-md cursor-pointer"
+            >
+              Update Password (Requires Reauth)
+            </button>
+          </form>
+        </section>
+      </div>
+
+      {/* Reauthentication Modal */}
+      {reauthRequest && (
+        <ReauthModal
+          user={user}
+          actionDescription={reauthRequest.actionDescription}
+          onSuccess={reauthRequest.onVerified}
+          onCancel={() => setReauthRequest(null)}
+        />
+      )}
+    </div>
+  );
+}
