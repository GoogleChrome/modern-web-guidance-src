+import type { APIRoute } from 'astro';
+
+function generateChallengeBase64Url(): string {
+  const bytes = new Uint8Array(32);
+  if (typeof crypto !== 'undefined' && crypto.getRandomValues) {
+    crypto.getRandomValues(bytes);
+  } else {
+    for (let i = 0; i < 32; i++) {
+      bytes[i] = Math.floor(Math.random() * 256);
+    }
+  }
+  return Buffer.from(bytes).toString('base64url');
+}
+
+export const GET: APIRoute = async ({ session }) => {
+  const user = (await session?.get('authUser')) || null;
+  const challenge = generateChallengeBase64Url();
+  await session?.set('webauthnChallenge', challenge);
+
+  return new Response(
+    JSON.stringify({
+      user,
+      challenge,
+      rp: {
+        name: 'The DevTools Times',
+      },
+    }),
+    {
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { action, user, passkey, credentialId } = body;
+
+    if (action === 'challenge') {
+      const challenge = generateChallengeBase64Url();
+      await session?.set('webauthnChallenge', challenge);
+      return new Response(JSON.stringify({ challenge }), {
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    if (action === 'session-sync' || action === 'register' || action === 'authenticate' || action === 'reauthenticate') {
+      if (user) {
+        await session?.set('authUser', user);
+      }
+      return new Response(
+        JSON.stringify({
+          ok: true,
+          action,
+          user: user || (await session?.get('authUser')) || null,
+          passkey: passkey || null,
+          credentialId: credentialId || null,
+          verifiedAt: new Date().toISOString(),
+        }),
+        {
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    if (action === 'signout') {
+      await session?.set('authUser', null);
+      return new Response(JSON.stringify({ ok: true, user: null }), {
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    return new Response(JSON.stringify({ ok: true }), {
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err) {
+    return new Response(
+      JSON.stringify({ error: 'Invalid request payload' }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
