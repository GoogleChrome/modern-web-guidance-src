+}
+
+export interface UserAccount {
+  id: string;
+  username: string;
+  email: string;
+  displayName: string;
+  hasPassword: boolean;
+  passwordHash?: string;
+  createdAt: string;
+  lastAuthAt: string;
+  lastReauthAt: string | null;
+  passkeys: StoredPasskey[];
+}
+
+export interface AuthState {
+  currentUserId: string | null;
+  users: Record<string, UserAccount>;
+}
+
+const STORAGE_KEY = 'devtools_times_auth_v1';
+
+// Helper for Base64URL encoding/decoding
+export function bufferToBase64url(buffer: ArrayBuffer): string {
+  const bytes = new Uint8Array(buffer);
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary)
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '');
+}
+
+export function base64urlToBuffer(base64url: string): ArrayBuffer {
+  const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+  const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+  const rawData = atob(base64);
+  const outputArray = new Uint8Array(rawData.length);
+  for (let i = 0; i < rawData.length; ++i) {
+    outputArray[i] = rawData.charCodeAt(i);
+  }
+  return outputArray.buffer;
+}
+
+export function generateRandomChallenge(length = 32): Uint8Array {
+  const challenge = new Uint8Array(length);
+  if (typeof window !== 'undefined' && window.crypto?.getRandomValues) {
+    window.crypto.getRandomValues(challenge);
+  } else {
+    for (let i = 0; i < length; i++) {
+      challenge[i] = Math.floor(Math.random() * 256);
+    }
+  }
+  return challenge;
+}
+
+export function stringToUint8Array(str: string): Uint8Array {
+  return new TextEncoder().encode(str);
+}
+
+export function detectDeviceLabel(): string {
+  if (typeof navigator === 'undefined') return 'Passkey';
+  const ua = navigator.userAgent;
+  if (/Macintosh|Mac OS X/i.test(ua)) {
+    if (/Chrome/i.test(ua)) return 'iCloud Keychain / Chrome on macOS';
+    if (/Safari/i.test(ua)) return 'iCloud Keychain on macOS';
+    return 'macOS Passkey';
+  }
+  if (/iPhone|iPad|iPod/i.test(ua)) return 'iCloud Keychain on iOS';
+  if (/Android/i.test(ua)) return 'Google Password Manager on Android';
+  if (/Windows/i.test(ua)) return 'Windows Hello / Chrome Profile';
+  if (/Linux/i.test(ua)) return 'Chrome Passkey on Linux';
+  return 'Platform Passkey';
+}
+
+const DEFAULT_DEMO_USER: UserAccount = {
+  id: 'usr_demo_editor',
+  username: 'alex.rivera',
+  email: 'alex.rivera@devtoolstimes.com',
+  displayName: 'Alex Rivera',
+  hasPassword: true,
+  passwordHash: 'devtools123',
+  createdAt: '2026-02-14T09:30:00.000Z',
+  lastAuthAt: new Date().toISOString(),
+  lastReauthAt: null,
+  passkeys: [
+    {
+      id: 'dGVzdC1tYWNib29rLXByby1wYXNza2V5LWlkLTAwMQ',
+      name: 'iCloud Keychain (MacBook Pro)',
+      createdAt: '2026-03-10T14:22:00.000Z',
+      lastUsedAt: '2026-11-02T18:40:00.000Z',
+      transports: ['internal', 'hybrid'],
+      deviceType: 'multiDevice',
+      backedUp: true,
+      aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+    },
+    {
+      id: 'dGVzdC15dWJpa2V5LTVjLW5mYy1wYXNza2V5LWlkLTAwMg',
+      name: 'YubiKey 5C NFC',
+      createdAt: '2026-06-01T11:05:00.000Z',
+      lastUsedAt: null,
+      transports: ['usb', 'nfc'],
+      deviceType: 'singleDevice',
+      backedUp: false,
+      aaguid: '2fc0579f-8113-47ea-b116-bb5a8db9202a',
+    },
+  ],
+};
+
+export function loadAuthState(): AuthState {
+  if (typeof window === 'undefined') {
+    return { currentUserId: null, users: { [DEFAULT_DEMO_USER.id]: DEFAULT_DEMO_USER } };
+  }
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    if (!raw) {
+      const initial: AuthState = {
+        currentUserId: null,
+        users: { [DEFAULT_DEMO_USER.id]: DEFAULT_DEMO_USER },
+      };
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(initial));
+      return initial;
+    }
+    const parsed = JSON.parse(raw) as AuthState;
+    if (!parsed.users) {
+      parsed.users = { [DEFAULT_DEMO_USER.id]: DEFAULT_DEMO_USER };
+    }
+    return parsed;
+  } catch {
+    return { currentUserId: null, users: { [DEFAULT_DEMO_USER.id]: DEFAULT_DEMO_USER } };
+  }
+}
+
+export function saveAuthState(state: AuthState): void {
+  if (typeof window === 'undefined') return;
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
+    window.dispatchEvent(new CustomEvent('devtools-times-auth-change', { detail: state }));
+  } catch (e) {
+    console.error('Failed to save auth state:', e);
+  }
+}
+
+export function getCurrentUser(): UserAccount | null {
+  const state = loadAuthState();
+  if (!state.currentUserId) return null;
+  return state.users[state.currentUserId] || null;
+}
+
+export function findUserByIdentifier(identifier: string): UserAccount | null {
+  const normalized = identifier.trim().toLowerCase();
+  if (!normalized) return null;
+  const state = loadAuthState();
+  for (const user of Object.values(state.users)) {
+    if (
+      user.username.toLowerCase() === normalized ||
+      user.email.toLowerCase() === normalized
+    ) {
+      return user;
+    }
+  }
+  return null;
+}
+
+export function findUserByCredentialId(credentialId: string): { user: UserAccount; passkey: StoredPasskey } | null {
+  const state = loadAuthState();
+  for (const user of Object.values(state.users)) {
+    const found = user.passkeys.find((pk) => pk.id === credentialId);
+    if (found) {
+      return { user, passkey: found };
+    }
+  }
+  return null;
+}
+
+export function getAllKnownCredentials(): { id: string; transports: AuthenticatorTransport[]; userId: string }[] {
+  const state = loadAuthState();
+  const list: { id: string; transports: AuthenticatorTransport[]; userId: string }[] = [];
+  for (const user of Object.values(state.users)) {
+    for (const pk of user.passkeys) {
+      list.push({
+        id: pk.id,
+        transports: pk.transports,
+        userId: user.id,
+      });
+    }
+  }
+  return list;
+}
+
+export interface WebAuthnSupportInfo {
+  isSupported: boolean;
+  isPlatformAvailable: boolean;
+  isConditionalMediationAvailable: boolean;
+}
+
+export async function getWebAuthnSupport(): Promise<WebAuthnSupportInfo> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) {
+    return {
+      isSupported: false,
+      isPlatformAvailable: false,
+      isConditionalMediationAvailable: false,
+    };
+  }
+
+  let isPlatformAvailable = false;
+  let isConditionalMediationAvailable = false;
+
+  try {
+    if (typeof PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
+      isPlatformAvailable = await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+    }
+  } catch {
+    isPlatformAvailable = false;
+  }
+
+  try {
+    if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+      isConditionalMediationAvailable = await PublicKeyCredential.isConditionalMediationAvailable();
+    }
+  } catch {
+    isConditionalMediationAvailable = false;
+  }
+
+  return {
+    isSupported: true,
+    isPlatformAvailable,
+    isConditionalMediationAvailable,
+  };
+}
+
+export interface CreatePasskeyOptions {
+  username: string;
+  displayName?: string;
+  userId?: string;
+  authenticatorAttachment?: AuthenticatorAttachment;
+  excludeCredentialIds?: string[];
+  passkeyName?: string;
+}
+
+export async function registerWebAuthnPasskey(options: CreatePasskeyOptions): Promise<StoredPasskey> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential || !navigator.credentials) {
+    throw new Error('WebAuthn is not supported in this browser environment.');
+  }
+
+  const rpId = window.location.hostname || 'localhost';
+  const challenge = generateRandomChallenge(32);
+  const userIdStr = options.userId || `usr_${Date.now()}`;
+  const userIdBuffer = stringToUint8Array(userIdStr);
+
+  const excludeCredentials: PublicKeyCredentialDescriptor[] = (options.excludeCredentialIds || []).map((id) => {
+    try {
+      return {
+        id: base64urlToBuffer(id),
+        type: 'public-key' as const,
+      };
+    } catch {
+      return {
+        id: stringToUint8Array(id).buffer as ArrayBuffer,
+        type: 'public-key' as const,
+      };
+    }
+  });
+
+  const publicKeyOptions: PublicKeyCredentialCreationOptions = {
+    challenge: challenge.buffer as ArrayBuffer,
+    rp: {
+      name: 'The DevTools Times',
+      id: rpId,
+    },
+    user: {
+      id: userIdBuffer.buffer as ArrayBuffer,
+      name: options.username,
+      displayName: options.displayName || options.username,
+    },
+    pubKeyCredParams: [
+      { alg: -7, type: 'public-key' },   // ES256
+      { alg: -257, type: 'public-key' }, // RS256
+    ],
+    timeout: 60000,
+    attestation: 'none',
+    excludeCredentials,
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'required',
+      ...(options.authenticatorAttachment ? { authenticatorAttachment: options.authenticatorAttachment } : {}),
+    },
+  };
+
+  const credential = (await navigator.credentials.create({
+    publicKey: publicKeyOptions,
+  })) as PublicKeyCredential | null;
+
+  if (!credential) {
+    throw new Error('Passkey creation was cancelled or returned no credential.');
+  }
+
+  const response = credential.response as AuthenticatorAttestationResponse;
+  const transports: AuthenticatorTransport[] =
+    typeof response.getTransports === 'function'
+      ? (response.getTransports() as AuthenticatorTransport[])
+      : ['internal', 'hybrid'];
+
+  const credentialId = credential.id || bufferToBase64url(credential.rawId);
+  const isCrossPlatform = options.authenticatorAttachment === 'cross-platform' || transports.includes('usb') || transports.includes('nfc');
+
+  return {
+    id: credentialId,
+    name: options.passkeyName?.trim() || (isCrossPlatform ? 'Security Key' : detectDeviceLabel()),
+    createdAt: new Date().toISOString(),
+    lastUsedAt: new Date().toISOString(),
+    transports: transports.length > 0 ? transports : ['internal'],
+    deviceType: isCrossPlatform ? 'singleDevice' : 'multiDevice',
+    backedUp: !isCrossPlatform,
+    userAgent: navigator.userAgent,
+  };
+}
+
+export interface AuthenticatePasskeyOptions {
+  allowCredentialIds?: { id: string; transports?: AuthenticatorTransport[] }[];
+  mediation?: CredentialMediationRequirement;
+  signal?: AbortSignal;
+}
+
+export async function authenticateWithWebAuthnPasskey(
+  options: AuthenticatePasskeyOptions = {}
+): Promise<{ credentialId: string; userHandle: string | null }> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential || !navigator.credentials) {
+    throw new Error('WebAuthn is not supported in this browser environment.');
+  }
+
+  const rpId = window.location.hostname || 'localhost';
+  const challenge = generateRandomChallenge(32);
+
+  const allowCredentials: PublicKeyCredentialDescriptor[] = (options.allowCredentialIds || []).map((item) => {
+    try {
+      return {
+        id: base64urlToBuffer(item.id),
+        type: 'public-key' as const,
+        transports: item.transports,
+      };
+    } catch {
+      return {
+        id: stringToUint8Array(item.id).buffer as ArrayBuffer,
+        type: 'public-key' as const,
+        transports: item.transports,
+      };
+    }
+  });
+
+  const publicKey: PublicKeyCredentialRequestOptions = {
+    challenge: challenge.buffer as ArrayBuffer,
+    rpId,
+    timeout: 60000,
+    userVerification: 'required',
+    ...(allowCredentials.length > 0 ? { allowCredentials } : {}),
+  };
+
+  const credential = (await navigator.credentials.get({
+    publicKey,
+    mediation: options.mediation,
+    signal: options.signal,
+  })) as PublicKeyCredential | null;
+
+  if (!credential) {
+    throw new Error('Passkey authentication was cancelled or failed.');
+  }
+
+  const assertionResponse = credential.response as AuthenticatorAssertionResponse;
+  let userHandle: string | null = null;
+  if (assertionResponse.userHandle) {
+    try {
+      userHandle = new TextDecoder().decode(assertionResponse.userHandle);
+    } catch {
+      userHandle = bufferToBase64url(assertionResponse.userHandle);
+    }
+  }
+
+  return {
+    credentialId: credential.id || bufferToBase64url(credential.rawId),
+    userHandle,
+  };
+}
+
+export function isReauthValid(user: UserAccount | null, maxAgeMs = 5 * 60 * 1000): boolean {
+  if (!user || !user.lastReauthAt) return false;
+  const elapsed = Date.now() - new Date(user.lastReauthAt).getTime();
+  return elapsed >= 0 && elapsed < maxAgeMs;
+}
+
+export function markUserReauthenticated(userId: string): UserAccount | null {
+  const state = loadAuthState();
+  const user = state.users[userId];
+  if (!user) return null;
+  const now = new Date().toISOString();
+  user.lastReauthAt = now;
+  user.lastAuthAt = now;
+  saveAuthState(state);
+  return user;
+}
+
+export function signOutCurrentUser(): void {
+  const state = loadAuthState();
+  state.currentUserId = null;
+  saveAuthState(state);
+}
+
+// Signal API helpers (PublicKeyCredential.signalUnknownCredential / signalAllAcceptedCredentials / signalCurrentUserDetails)
+export async function syncSignalAllAcceptedCredentials(user: UserAccount): Promise<void> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return;
+  const pkc = PublicKeyCredential as unknown as {
+    signalAllAcceptedCredentials?: (opts: {
+      rpId: string;
+      userId: string;
+      allAcceptedCredentialIds: string[];
+    }) => Promise<void>;
+  };
+  if (typeof pkc.signalAllAcceptedCredentials === 'function') {
+    try {
+      await pkc.signalAllAcceptedCredentials({
+        rpId: window.location.hostname || 'localhost',
+        userId: bufferToBase64url(stringToUint8Array(user.id).buffer as ArrayBuffer),
+        allAcceptedCredentialIds: user.passkeys.map((pk) => pk.id),
+      });
+    } catch {
+      // Ignore if browser doesn't support or rejects
+    }
+  }
+}
+
+export async function syncSignalCurrentUserDetails(user: UserAccount): Promise<void> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return;
+  const pkc = PublicKeyCredential as unknown as {
+    signalCurrentUserDetails?: (opts: {
+      rpId: string;
+      userId: string;
+      name: string;
+      displayName: string;
+    }) => Promise<void>;
+  };
+  if (typeof pkc.signalCurrentUserDetails === 'function') {
+    try {
+      await pkc.signalCurrentUserDetails({
+        rpId: window.location.hostname || 'localhost',
+        userId: bufferToBase64url(stringToUint8Array(user.id).buffer as ArrayBuffer),
+        name: user.username,
+        displayName: user.displayName,
+      });
+    } catch {
+      // Ignore if browser doesn't support or rejects
+    }
+  }
+}
