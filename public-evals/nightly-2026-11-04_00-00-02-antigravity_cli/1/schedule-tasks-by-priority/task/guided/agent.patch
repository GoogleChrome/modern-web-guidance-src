+  <script>
+    // Feature detect the Prioritized Task Scheduling API and load polyfill if needed
+    if (!('scheduler' in window && 'postTask' in window.scheduler)) {
+      const script = document.createElement('script');
+      script.src = 'https://unpkg.com/scheduler-polyfill';
+      script.onload = () => {
+        initOperationsSimulator();
+      };
+      script.onerror = () => {
+        initOperationsSimulator();
+      };
+      document.head.appendChild(script);
+    } else {
+      initOperationsSimulator();
+    }
+
+    function initOperationsSimulator() {
+      const logContainer = document.getElementById('ops-queue-log');
+      const emptyMessage = document.getElementById('ops-log-empty');
+      const queuedEl = document.getElementById('metric-queued');
+      const completedEl = document.getElementById('metric-completed');
+      const yieldsEl = document.getElementById('metric-yields');
+
+      let taskCounter = 0;
+      let executionOrder = 0;
+      let queuedCount = 0;
+      let completedCount = 0;
+      let yieldCount = 0;
+
+      function updateMetrics() {
+        queuedEl.textContent = String(queuedCount);
+        completedEl.textContent = String(completedCount);
+        yieldsEl.textContent = String(yieldCount);
+      }
+
+      // Break up long synchronous work using a 50ms deadline and scheduler.yield()
+      async function processTaskItems(items, onProgress) {
+        let deadline = performance.now() + 50; // 50ms budget
+
+        for (let i = 0; i < items.length; i++) {
+          // Simulate unit of computation for the store operation
+          const item = items[i];
+          let checksum = 0;
+          for (let j = 0; j < item.iterations; j++) {
+            checksum = (checksum + Math.imul(j, 31)) | 0;
+          }
+
+          if (performance.now() >= deadline) {
+            yieldCount++;
+            updateMetrics();
+            if (onProgress) {
+              onProgress(Math.round(((i + 1) / items.length) * 100));
+            }
+            if ('scheduler' in window && 'yield' in window.scheduler) {
+              await scheduler.yield();
+            } else {
+              await new Promise(resolve => setTimeout(resolve, 0));
+            }
+            deadline = performance.now() + 50;
+          }
+        }
+      }
+
+      function createLogRow(taskId, label, priority) {
+        if (emptyMessage && emptyMessage.parentNode === logContainer) {
+          emptyMessage.remove();
+        }
+        const row = document.createElement('div');
+        row.className = 'ops-log-item';
+        row.dataset.taskId = String(taskId);
+
+        const left = document.createElement('div');
+        const badge = document.createElement('span');
+        badge.className = `priority-badge priority-${priority}`;
+        badge.textContent = priority;
+
+        const title = document.createElement('span');
+        title.style.marginLeft = '10px';
+        title.textContent = `#${taskId} ${label}`;
+
+        left.appendChild(badge);
+        left.appendChild(title);
+
+        const status = document.createElement('span');
+        status.className = 'task-state state-queued';
+        status.textContent = 'Queued';
+
+        row.appendChild(left);
+        row.appendChild(status);
+        logContainer.prepend(row);
+
+        return { row, status };
+      }
+
+      function scheduleOperation(label, priority, itemCount = 120) {
+        const taskId = ++taskCounter;
+        queuedCount++;
+        updateMetrics();
+
+        const { status } = createLogRow(taskId, label, priority);
+        const items = Array.from({ length: itemCount }, (_, idx) => ({
+          id: idx,
+          iterations: 45000
+        }));
+
+        const runTask = async () => {
+          const orderNum = ++executionOrder;
+          const startTime = performance.now();
+          status.className = 'task-state state-running';
+          status.textContent = `Running (Order #${orderNum})...`;
+
+          await processTaskItems(items, (pct) => {
+            status.textContent = `Running (Order #${orderNum} - ${pct}%)...`;
+          });
+
+          const elapsed = Math.round(performance.now() - startTime);
+          queuedCount = Math.max(0, queuedCount - 1);
+          completedCount++;
+          updateMetrics();
+
+          status.className = 'task-state state-completed';
+          status.textContent = `Completed #${orderNum} (${elapsed}ms)`;
+        };
+
+        if ('scheduler' in window && 'postTask' in window.scheduler) {
+          return scheduler.postTask(runTask, { priority });
+        }
+        return new Promise((resolve) => {
+          setTimeout(() => resolve(runTask()), 0);
+        });
+      }
+
+      document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+        scheduleOperation('Urgent Checkout Validation & Payment', 'user-blocking', 90);
+      });
+
+      document.getElementById('btn-menu-update').addEventListener('click', () => {
+        scheduleOperation('Standard Seasonal Menu Sync', 'user-visible', 110);
+      });
+
+      document.getElementById('btn-telemetry-log').addEventListener('click', () => {
+        scheduleOperation('Background Telemetry & Analytics Flush', 'background', 140);
+      });
+
+      document.getElementById('btn-batch-tasks').addEventListener('click', () => {
+        // Queue tasks in reverse/mixed order to demonstrate priority scheduling:
+        // user-blocking runs first, followed by user-visible, and finally background.
+        scheduleOperation('Batch: Background Telemetry Flush #1', 'background', 100);
+        scheduleOperation('Batch: Standard Menu Price Update #1', 'user-visible', 100);
+        scheduleOperation('Batch: Urgent POS Express Checkout #1', 'user-blocking', 90);
+        scheduleOperation('Batch: Background Bean Inventory Sync #2', 'background', 100);
+        scheduleOperation('Batch: Standard Menu Availability Refresh #2', 'user-visible', 100);
+        scheduleOperation('Batch: Urgent Mobile Order Checkout #2', 'user-blocking', 90);
+      });
+
+      document.getElementById('btn-clear-queue').addEventListener('click', () => {
+        logContainer.innerHTML = '';
+        if (emptyMessage) {
+          logContainer.appendChild(emptyMessage);
+        }
+        executionOrder = 0;
+        completedCount = 0;
+        yieldCount = 0;
+        updateMetrics();
+      });
+    }
+  </script>
