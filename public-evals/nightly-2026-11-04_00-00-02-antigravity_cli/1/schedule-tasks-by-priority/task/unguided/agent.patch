+  <script>
+    (function () {
+      const PRIORITY_WEIGHTS = {
+        'user-blocking': 0,
+        'user-visible': 1,
+        'background': 2
+      };
+
+      const TASK_CONFIGS = {
+        'user-blocking': {
+          name: 'Urgent Checkout Task',
+          priority: 'user-blocking',
+          chunks: 3,
+          chunkDurationMs: 6,
+          description: 'POS payment authorization & receipt dispatch'
+        },
+        'user-visible': {
+          name: 'Standard Menu Update',
+          priority: 'user-visible',
+          chunks: 4,
+          chunkDurationMs: 7,
+          description: 'Sync seasonal drink availability & pricing'
+        },
+        'background': {
+          name: 'Background Telemetry Logging',
+          priority: 'background',
+          chunks: 5,
+          chunkDurationMs: 6,
+          description: 'Flush anonymized store metrics & inventory logs'
+        }
+      };
+
+      const logList = document.getElementById('ops-log');
+      const statusEl = document.getElementById('ops-status');
+      const queuedEl = document.getElementById('stat-queued');
+      const completedEl = document.getElementById('stat-completed');
+      const yieldsEl = document.getElementById('stat-yields');
+      const apiBadgeEl = document.getElementById('scheduler-api-badge');
+      const uiPingBtn = document.getElementById('btn-ui-ping');
+      const uiPingCountEl = document.getElementById('ui-ping-count');
+
+      let nextTaskId = 1;
+      let executionSequence = 0;
+      let pendingCount = 0;
+      let completedCount = 0;
+      let totalYields = 0;
+      let uiPingCount = 0;
+
+      function hasNativePostTask() {
+        return (
+          typeof window !== 'undefined' &&
+          'scheduler' in window &&
+          window.scheduler &&
+          typeof window.scheduler.postTask === 'function'
+        );
+      }
+
+      function hasNativeYield() {
+        return (
+          typeof window !== 'undefined' &&
+          'scheduler' in window &&
+          window.scheduler &&
+          typeof window.scheduler.yield === 'function'
+        );
+      }
+
+      if (apiBadgeEl) {
+        apiBadgeEl.textContent = hasNativePostTask()
+          ? 'API: scheduler.postTask + scheduler.yield'
+          : 'API: Priority Queue Fallback + Yielding';
+      }
+
+      if (uiPingBtn) {
+        uiPingBtn.addEventListener('click', () => {
+          uiPingCount += 1;
+          uiPingCountEl.textContent = String(uiPingCount);
+        });
+      }
+
+      function updateStats() {
+        queuedEl.textContent = String(pendingCount);
+        completedEl.textContent = String(completedCount);
+        yieldsEl.textContent = String(totalYields);
+        statusEl.textContent = pendingCount > 0 ? `Processing (${pendingCount} active)` : 'Idle';
+      }
+
+      /**
+       * Yield control back to the main thread so input events and rendering frames
+       * are never blocked during multi-chunk operations.
+       */
+      async function yieldToMain() {
+        totalYields += 1;
+        updateStats();
+        if (hasNativeYield()) {
+          return window.scheduler.yield();
+        }
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      /**
+       * Perform a bounded work slice (< 10ms) to simulate CPU work without blocking UI frames.
+       */
+      function performWorkChunk(durationMs) {
+        const start = performance.now();
+        let checksum = 0;
+        while (performance.now() - start < durationMs) {
+          checksum = (checksum + Math.imul(checksum ^ 31, 17)) | 0;
+        }
+        return checksum;
+      }
+
+      function removeEmptyState() {
+        const emptyItem = document.getElementById('ops-log-empty');
+        if (emptyItem) {
+          emptyItem.remove();
+        }
+      }
+
+      function createLogElement(task) {
+        removeEmptyState();
+        const li = document.createElement('li');
+        li.className = 'ops-log-item';
+        li.id = `task-item-${task.id}`;
+        li.dataset.taskId = String(task.id);
+        li.dataset.priority = task.priority;
+        li.dataset.status = 'running';
+
+        li.innerHTML = `
+          <div class="task-info">
+            <span class="task-order" data-role="order">#${task.execOrder}</span>
+            <span class="badge-priority badge-${task.priority}" data-role="priority">${task.priority}</span>
+            <strong class="task-name" data-role="name">${task.name}</strong>
+            <span style="color: #8d6e63; font-size: 0.8rem;">(${task.description})</span>
+          </div>
+          <div class="task-meta">
+            <div class="task-progress-wrap" aria-label="Task chunk progress">
+              <div class="task-progress-bar" data-role="progress" style="width: 0%;"></div>
+            </div>
+            <span data-role="chunks">0/${task.chunks} chunks</span>
+            <span class="status-pill status-running" data-role="status">Running</span>
+          </div>
+        `;
+        logList.appendChild(li);
+        return li;
+      }
+
+      // Fallback priority queue when scheduler.postTask is unavailable
+      const fallbackQueue = [];
+      let fallbackDraining = false;
+
+      function scheduleWithPriority(callback, priority) {
+        if (hasNativePostTask()) {
+          return window.scheduler.postTask(callback, { priority });
+        }
+        return new Promise((resolve, reject) => {
+          fallbackQueue.push({
+            callback,
+            priority,
+            weight: PRIORITY_WEIGHTS[priority] ?? 1,
+            enqueuedAt: performance.now(),
+            resolve,
+            reject
+          });
+          fallbackQueue.sort((a, b) => a.weight - b.weight || a.enqueuedAt - b.enqueuedAt);
+          if (!fallbackDraining) {
+            fallbackDraining = true;
+            setTimeout(drainFallbackQueue, 0);
+          }
+        });
+      }
+
+      async function drainFallbackQueue() {
+        while (fallbackQueue.length > 0) {
+          const next = fallbackQueue.shift();
+          try {
+            const result = await next.callback();
+            next.resolve(result);
+          } catch (err) {
+            next.reject(err);
+          }
+        }
+        fallbackDraining = false;
+      }
+
+      function enqueueOperation(priorityKey, customLabel) {
+        const config = TASK_CONFIGS[priorityKey] || TASK_CONFIGS['user-visible'];
+        const taskId = nextTaskId++;
+        const task = {
+          id: taskId,
+          name: customLabel || `${config.name} #${taskId}`,
+          priority: config.priority,
+          chunks: config.chunks,
+          chunkDurationMs: config.chunkDurationMs,
+          description: config.description,
+          execOrder: 0
+        };
+
+        pendingCount += 1;
+        updateStats();
+
+        return scheduleWithPriority(async () => {
+          const startedAt = performance.now();
+          executionSequence += 1;
+          task.execOrder = executionSequence;
+
+          const row = createLogElement(task);
+          const progressBar = row.querySelector('[data-role="progress"]');
+          const chunksLabel = row.querySelector('[data-role="chunks"]');
+          const statusLabel = row.querySelector('[data-role="status"]');
+
+          for (let i = 1; i <= task.chunks; i++) {
+            performWorkChunk(task.chunkDurationMs);
+            const pct = Math.round((i / task.chunks) * 100);
+            if (progressBar) progressBar.style.width = `${pct}%`;
+            if (chunksLabel) chunksLabel.textContent = `${i}/${task.chunks} chunks`;
+
+            if (i < task.chunks) {
+              await yieldToMain();
+            }
+          }
+
+          const elapsedMs = Math.max(1, Math.round(performance.now() - startedAt));
+          row.dataset.status = 'completed';
+          if (statusLabel) {
+            statusLabel.className = 'status-pill status-completed';
+            statusLabel.textContent = `Completed (${elapsedMs}ms)`;
+          }
+
+          pendingCount = Math.max(0, pendingCount - 1);
+          completedCount += 1;
+          updateStats();
+          return task;
+        }, task.priority);
+      }
+
+      function runMixedBatch() {
+        // Enqueue mixed tasks in reverse/non-priority order (background -> user-visible -> user-blocking)
+        // so that the prioritized scheduler reorders and executes them in strict priority order:
+        // 1. user-blocking (Urgent Checkout)
+        // 2. user-visible (Standard Menu Update)
+        // 3. background (Background Telemetry)
+        const batchTasks = [
+          { priority: 'background', label: 'Background Telemetry Logging (Batch)' },
+          { priority: 'user-visible', label: 'Standard Menu Update (Batch)' },
+          { priority: 'user-blocking', label: 'Urgent Checkout Task (Batch)' },
+          { priority: 'background', label: 'Background Telemetry Sync (Batch)' },
+          { priority: 'user-visible', label: 'Standard Menu Price Refresh (Batch)' },
+          { priority: 'user-blocking', label: 'Urgent VIP Express Checkout (Batch)' }
+        ];
+
+        return Promise.all(
+          batchTasks.map((item) => enqueueOperation(item.priority, item.label))
+        );
+      }
+
+      function clearQueueLog() {
+        executionSequence = 0;
+        completedCount = 0;
+        totalYields = 0;
+        logList.innerHTML =
+          '<li id="ops-log-empty" class="ops-log-empty">No operations executed yet. Trigger a task or run a mixed batch above.</li>';
+        updateStats();
+      }
+
+      document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+        enqueueOperation('user-blocking');
+      });
+
+      document.getElementById('btn-menu-update').addEventListener('click', () => {
+        enqueueOperation('user-visible');
+      });
+
+      document.getElementById('btn-telemetry-log').addEventListener('click', () => {
+        enqueueOperation('background');
+      });
+
+      document.getElementById('btn-batch-mixed').addEventListener('click', () => {
+        runMixedBatch();
+      });
+
+      document.getElementById('btn-clear-queue').addEventListener('click', () => {
+        clearQueueLog();
+      });
+    })();
+  </script>
+
 </body>
 
