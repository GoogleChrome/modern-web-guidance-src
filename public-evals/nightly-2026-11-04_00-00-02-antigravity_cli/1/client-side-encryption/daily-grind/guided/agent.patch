+            const exportFormat = isKem ? 'raw-public' : 'raw';
+            const publicKeyBytes = new Uint8Array(
+              await crypto.subtle.exportKey(exportFormat, publicKey),
+            );
+            const suite = isKem
+              ? `${algoName}+ChaCha20-Poly1305`
+              : `${algoName}+HKDF+AES-GCM`;
+            return {
+              suite,
+              keyPair: { privateKey: storedKeyPair.privateKey, publicKey },
+              publicKeyBytes,
+              persisted: true,
+              restoredFromIndexedDB: true,
+            };
+          }
+        }
+      }
+      return generateRecipientKeys(preferredKem);
+    }
+
+    async function deriveFallbackAesKey(privateKey, peerPublicKey, infoBytes = new Uint8Array(0)) {
+      const algoName = privateKey.algorithm.name;
+      const sharedSecret = await crypto.subtle.deriveBits(
+        { name: algoName, public: peerPublicKey },
+        privateKey,
+        256,
+      );
+      const hkdfKey = await crypto.subtle.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+      return crypto.subtle.deriveKey(
+        {
+          name: 'HKDF',
+          hash: 'SHA-256',
+          salt: new Uint8Array(32),
+          info: infoBytes,
+        },
+        hkdfKey,
+        { name: 'AES-GCM', length: 256 },
+        false,
+        ['encrypt', 'decrypt'],
+      );
+    }
+
+    /**
+     * Sender: Imports recipient public key ('raw-public' for KEM or 'raw' for X25519/ECDH)
+     * and encapsulates a one-time shared AEAD key and capsule bytes.
+     */
+    export async function encapsulateEnvelopeKey(
+      recipientPublicKeyOrBytes,
+      infoBytes = new Uint8Array(0),
+    ) {
+      const pubKey =
+        recipientPublicKeyOrBytes instanceof CryptoKey
+          ? recipientPublicKeyOrBytes
+          : await (() => {
+              const bytes =
+                recipientPublicKeyOrBytes instanceof Uint8Array
+                  ? recipientPublicKeyOrBytes
+                  : new Uint8Array(recipientPublicKeyOrBytes);
+              const kemName = KEM_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+              if (kemName) {
+                return crypto.subtle.importKey('raw-public', bytes, kemName, true, ['encapsulateKey']);
+              }
+              if (bytes.byteLength === 65) {
+                return crypto.subtle.importKey(
+                  'raw',
+                  bytes,
+                  { name: 'ECDH', namedCurve: 'P-256' },
+                  true,
+                  [],
+                );
+              }
+              return crypto.subtle.importKey('raw', bytes, 'X25519', true, []);
+            })();
+
+      if (pubKey.algorithm.name !== 'X25519' && pubKey.algorithm.name !== 'ECDH') {
+        const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+          pubKey.algorithm.name,
+          pubKey,
+          'ChaCha20-Poly1305',
+          false,
+          ['encrypt', 'decrypt'],
+        );
+        return { sharedKey, capsuleBytes: new Uint8Array(ciphertext) };
+      }
+
+      // Classical fallback: generate ephemeral key pair and send ephemeral public key as capsule
+      const ephemeralAlgo =
+        pubKey.algorithm.name === 'ECDH'
+          ? { name: 'ECDH', namedCurve: 'P-256' }
+          : 'X25519';
+      const ephemeral = await crypto.subtle.generateKey(ephemeralAlgo, false, ['deriveBits']);
+      const capsuleBytes = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+      const sharedKey = await deriveFallbackAesKey(ephemeral.privateKey, pubKey, infoBytes);
+      return { sharedKey, capsuleBytes };
+    }
+
+    /**
+     * Recipient: Decapsulates the capsule bytes using the recipient's private key
+     * to recover the shared AEAD key.
+     */
+    export async function decapsulateEnvelopeKey(
+      recipientPrivateKey,
+      capsuleBytes,
+      infoBytes = new Uint8Array(0),
+    ) {
+      if (
+        recipientPrivateKey.algorithm.name !== 'X25519' &&
+        recipientPrivateKey.algorithm.name !== 'ECDH'
+      ) {
+        return crypto.subtle.decapsulateKey(
+          recipientPrivateKey.algorithm.name,
+          recipientPrivateKey,
+          capsuleBytes,
+          'ChaCha20-Poly1305',
+          false,
+          ['encrypt', 'decrypt'],
+        );
+      }
+
+      const importAlgo =
+        recipientPrivateKey.algorithm.name === 'ECDH'
+          ? { name: 'ECDH', namedCurve: 'P-256' }
+          : 'X25519';
+      const ephemeralPubKey = await crypto.subtle.importKey('raw', capsuleBytes, importAlgo, true, []);
+      return deriveFallbackAesKey(recipientPrivateKey, ephemeralPubKey, infoBytes);
+    }
+
+    /**
+     * Encrypts UTF-8 text with an AEAD CryptoKey ('ChaCha20-Poly1305' or 'AES-GCM')
+     * using a fresh 12-byte (96-bit) IV and Associated Data (additionalData).
+     */
+    export async function encryptMessage(key, plaintext, additionalData = new Uint8Array(0)) {
+      const iv = crypto.getRandomValues(new Uint8Array(12));
+      const encoded = new TextEncoder().encode(plaintext);
+
+      const ciphertextBuffer = await crypto.subtle.encrypt(
+        {
+          name: key.algorithm.name,
+          iv,
+          additionalData,
+        },
+        key,
+        encoded,
+      );
+
+      return { iv, ciphertext: new Uint8Array(ciphertextBuffer) };
+    }
+
+    /**
+     * Decrypts and authenticates an AEAD payload. Throws OperationError if tampered.
+     */
+    export async function decryptMessage(key, iv, ciphertext, additionalData = new Uint8Array(0)) {
+      const plaintextBuffer = await crypto.subtle.decrypt(
+        {
+          name: key.algorithm.name,
+          iv,
+          additionalData,
+        },
+        key,
+        ciphertext,
+      );
+
+      return new TextDecoder().decode(plaintextBuffer);
+    }
+
+    // --- UI State & Wiring ---
+    const form = document.getElementById('delivery-notes-form');
+    const rotateKeysBtn = document.getElementById('rotate-keys-btn');
+    const encryptSubmitBtn = document.getElementById('encrypt-submit-btn');
+    const decryptVerifyBtn = document.getElementById('decrypt-verify-btn');
+    const tamperTestBtn = document.getElementById('tamper-test-btn');
+
+    const activeSuiteBadge = document.getElementById('active-suite-badge');
+    const keyStorageStatus = document.getElementById('key-storage-status');
+    const feedbackBanner = document.getElementById('crypto-feedback-banner');
+
+    const metaSuite = document.getElementById('meta-suite');
+    const metaPubkeySize = document.getElementById('meta-pubkey-size');
+    const metaCapsuleSize = document.getElementById('meta-capsule-size');
+    const metaIv = document.getElementById('meta-iv');
+    const metaAad = document.getElementById('meta-aad');
+    const envelopeJsonPreview = document.getElementById('envelope-json-preview');
+
+    const decryptedResultBox = document.getElementById('decrypted-result-box');
+    const decryptedOrderRef = document.getElementById('decrypted-order-ref');
+    const decryptedRecipient = document.getElementById('decrypted-recipient');
+    const decryptedAccessCode = document.getElementById('decrypted-access-code');
+    const decryptedAddress = document.getElementById('decrypted-address');
+    const decryptedInstructions = document.getElementById('decrypted-instructions');
+
+    const envelopeProtocolInfo = new TextEncoder().encode('daily-grind-delivery-note-v1');
+
+    let currentRecipientState = null;
+    let latestEncryptedEnvelope = null;
+
+    function getSelectedKemAlgorithm() {
+      const selected = form.querySelector('input[name="kem_algorithm"]:checked');
+      return selected ? selected.value : 'MLKEM768-X25519';
+    }
+
+    function setBanner(message, type = 'success') {
+      feedbackBanner.hidden = false;
+      feedbackBanner.className = `status-banner ${type}`;
+      feedbackBanner.textContent = message;
+    }
+
+    function updateRecipientStatusUI(state) {
+      activeSuiteBadge.textContent = state.suite;
+      keyStorageStatus.textContent = state.persisted
+        ? state.restoredFromIndexedDB
+          ? 'Courier key pair restored from IndexedDB (extractable: false)'
+          : 'Courier key pair persisted in IndexedDB (extractable: false)'
+        : 'In-memory session key pair (extractable: false)';
+      metaSuite.textContent = state.suite;
+      metaPubkeySize.textContent = `${state.publicKeyBytes.byteLength} bytes`;
+    }
+
+    async function initializeKeys(forceRotate = false) {
+      const selectedKem = getSelectedKemAlgorithm();
+      currentRecipientState = forceRotate
+        ? await generateRecipientKeys(selectedKem)
+        : await loadOrInitializeRecipientKeys(selectedKem);
+      updateRecipientStatusUI(currentRecipientState);
+    }
+
+    // Form Validation: validate on blur, clear errors on input
+    const validatedFields = [
+      {
+        input: document.getElementById('customer-name'),
+        errorEl: document.getElementById('customer-name-error'),
+        getMessage(el) {
+          if (el.validity.valueMissing) return 'Please enter the recipient full name.';
+          return '';
+        },
+      },
+      {
+        input: document.getElementById('order-reference'),
+        errorEl: document.getElementById('order-reference-error'),
+        getMessage(el) {
+          if (el.validity.valueMissing) return 'Please enter an order reference ID.';
+          if (el.validity.patternMismatch) {
+            return 'Order reference must be 4–40 characters (letters, numbers, hyphens, or underscores).';
+          }
+          return '';
+        },
+      },
+      {
+        input: document.getElementById('delivery-address'),
+        errorEl: document.getElementById('delivery-address-error'),
+        getMessage(el) {
+          if (el.validity.valueMissing) return 'Please enter the delivery street address.';
+          return '';
+        },
+      },
+      {
+        input: document.getElementById('delivery-instructions'),
+        errorEl: document.getElementById('delivery-instructions-error'),
+        getMessage(el) {
+          if (el.validity.valueMissing) return 'Please enter delivery drop-off instructions.';
+          if (el.validity.tooShort) return 'Delivery instructions must be at least 5 characters.';
+          return '';
+        },
+      },
+    ];
+
+    function validateField({ input, errorEl, getMessage }) {
+      input.setCustomValidity('');
+      const msg = getMessage(input);
+      if (msg) {
+        input.setCustomValidity(msg);
+        input.setAttribute('aria-invalid', 'true');
+        errorEl.textContent = msg;
+        return false;
+      }
+      input.removeAttribute('aria-invalid');
+      errorEl.textContent = '';
+      return true;
+    }
+
+    for (const field of validatedFields) {
+      field.input.addEventListener('blur', () => {
+        validateField(field);
+      });
+      field.input.addEventListener('input', () => {
+        field.input.setCustomValidity('');
+        field.input.removeAttribute('aria-invalid');
+        field.errorEl.textContent = '';
+      });
+    }
+
+    form.querySelectorAll('input[name="kem_algorithm"]').forEach((radio) => {
+      radio.addEventListener('change', async () => {
+        await initializeKeys(true);
+        setBanner(
+          `Switched courier recipient key pair to ${currentRecipientState.suite}.`,
+          'success',
+        );
+      });
+    });
+
+    rotateKeysBtn.addEventListener('click', async () => {
+      rotateKeysBtn.disabled = true;
+      try {
+        await initializeKeys(true);
+        latestEncryptedEnvelope = null;
+        decryptVerifyBtn.disabled = true;
+        tamperTestBtn.disabled = true;
+        decryptedResultBox.hidden = true;
+        setBanner(
+          `Generated fresh courier key pair (${currentRecipientState.suite}) and persisted in IndexedDB.`,
+          'success',
+        );
+      } finally {
+        rotateKeysBtn.disabled = false;
+      }
+    });
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+
+      let firstInvalid = null;
+      for (const field of validatedFields) {
+        const valid = validateField(field);
+        if (!valid && !firstInvalid) {
+          firstInvalid = field.input;
+        }
+      }
+      if (firstInvalid) {
+        firstInvalid.focus();
+        setBanner('Please correct the highlighted fields before encrypting.', 'error');
+        return;
+      }
+
+      // Disable submit button after a valid submission is clicked to prevent double-posts
+      encryptSubmitBtn.disabled = true;
+
+      try {
+        if (!currentRecipientState) {
+          await initializeKeys(false);
+        }
+
+        const formData = new FormData(form);
+        const orderRef = String(formData.get('order_reference') || '').trim();
+        const payloadObject = {
+          customerName: String(formData.get('customer_name') || '').trim(),
+          accessCode: String(formData.get('access_code') || '').trim(),
+          deliveryAddress: String(formData.get('delivery_address') || '').trim(),
+          deliveryInstructions: String(formData.get('delivery_instructions') || '').trim(),
+          createdAt: new Date().toISOString(),
+        };
+
+        const plaintextJson = JSON.stringify(payloadObject);
+        const additionalData = new TextEncoder().encode(`order:${orderRef}`);
+
+        // Step 3: Encapsulate a fresh one-time shared key using the recipient's exported public key bytes
+        const { sharedKey, capsuleBytes } = await encapsulateEnvelopeKey(
+          currentRecipientState.publicKeyBytes,
+          envelopeProtocolInfo,
+        );
+
+        // Step 4: Encrypt the payload with AEAD using a fresh 12-byte IV and associated data
+        const { iv, ciphertext } = await encryptMessage(
+          sharedKey,
+          plaintextJson,
+          additionalData,
+        );
+
+        latestEncryptedEnvelope = {
+          suite: currentRecipientState.suite,
+          orderReference: orderRef,
+          capsuleBytes: new Uint8Array(capsuleBytes),
+          iv: new Uint8Array(iv),
+          ciphertext: new Uint8Array(ciphertext),
+          additionalData: new Uint8Array(additionalData),
+        };
+
+        metaSuite.textContent = latestEncryptedEnvelope.suite;
+        metaPubkeySize.textContent = `${currentRecipientState.publicKeyBytes.byteLength} bytes`;
+        metaCapsuleSize.textContent = `${capsuleBytes.byteLength} bytes`;
+        metaIv.textContent = bytesToBase64(iv);
+        metaAad.textContent = `order:${orderRef}`;
+
+        const wireEnvelope = {
+          version: 'envelope-v1',
+          suite: latestEncryptedEnvelope.suite,
+          aad: `order:${orderRef}`,
+          capsule: bytesToBase64(capsuleBytes),
+          iv: bytesToBase64(iv),
+          ciphertext: bytesToBase64(ciphertext),
+        };
+        envelopeJsonPreview.textContent = JSON.stringify(wireEnvelope, null, 2);
+
+        decryptVerifyBtn.disabled = false;
+        tamperTestBtn.disabled = false;
+        decryptedResultBox.hidden = true;
+
+        setBanner(
+          `Encrypted delivery note with ${latestEncryptedEnvelope.suite} (fresh 12-byte IV & AAD bound).`,
+          'success',
+        );
+      } catch (err) {
+        setBanner(`Encryption error: ${err?.message || String(err)}`, 'error');
+      } finally {
+        encryptSubmitBtn.disabled = false;
+      }
+    });
+
+    decryptVerifyBtn.addEventListener('click', async () => {
+      if (!latestEncryptedEnvelope || !currentRecipientState) return;
+      try {
+        const recipientSharedKey = await decapsulateEnvelopeKey(
+          currentRecipientState.keyPair.privateKey,
+          latestEncryptedEnvelope.capsuleBytes,
+          envelopeProtocolInfo,
+        );
+
+        const decryptedJson = await decryptMessage(
+          recipientSharedKey,
+          latestEncryptedEnvelope.iv,
+          latestEncryptedEnvelope.ciphertext,
+          latestEncryptedEnvelope.additionalData,
+        );
+
+        const parsed = JSON.parse(decryptedJson);
+        decryptedOrderRef.textContent = latestEncryptedEnvelope.orderReference;
+        decryptedRecipient.textContent = parsed.customerName;
+        decryptedAccessCode.textContent = parsed.accessCode || 'None provided';
+        decryptedAddress.textContent = parsed.deliveryAddress;
+        decryptedInstructions.textContent = parsed.deliveryInstructions;
+        decryptedResultBox.hidden = false;
+
+        setBanner(
+          'Decapsulated shared key and authenticated AEAD ciphertext + associated data.',
+          'success',
+        );
+      } catch (err) {
+        decryptedResultBox.hidden = true;
+        setBanner(
+          `AEAD Authentication Failed (${err?.name || 'OperationError'}): Tampered ciphertext, capsule, or associated data rejected!`,
+          'error',
+        );
+      }
+    });
+
+    tamperTestBtn.addEventListener('click', async () => {
+      if (!latestEncryptedEnvelope || !currentRecipientState) return;
+      // Flip one bit in the ciphertext to demonstrate AEAD authentication tag rejection
+      latestEncryptedEnvelope.ciphertext[0] ^= 0xff;
+      const wireEnvelope = {
+        version: 'envelope-v1',
+        suite: latestEncryptedEnvelope.suite,
+        aad: `order:${latestEncryptedEnvelope.orderReference}`,
+        capsule: bytesToBase64(latestEncryptedEnvelope.capsuleBytes),
+        iv: bytesToBase64(latestEncryptedEnvelope.iv),
+        ciphertext: bytesToBase64(latestEncryptedEnvelope.ciphertext),
+        tampered: true,
+      };
+      envelopeJsonPreview.textContent = JSON.stringify(wireEnvelope, null, 2);
+      decryptedVerifyClick();
+    });
+
+    function decryptedVerifyClick() {
+      decryptVerifyBtn.click();
+    }
+
+    // Initialize recipient keys on page load
+    initializeKeys(false);
+  </script>
 </body>
 
 </html>
