+        if (mode === 'rsa-oaep') {
+          rsaSecret = crypto.getRandomValues(new Uint8Array(32));
+          const encBuf = await crypto.subtle.encrypt(
+            { name: 'RSA-OAEP' },
+            courier.rsaKeyPair.publicKey,
+            rsaSecret
+          );
+          rsaCiphertext = new Uint8Array(encBuf);
+        }
+
+        // Combine Input Keying Material (IKM)
+        let ikm;
+        if (mode === 'hybrid-pq') {
+          // Hybrid combiner: IKM = ss_classical (32B) || ss_pq (32B) = 64B (512 bits)
+          ikm = concatBytes(classicalSecret, pqSecret);
+        } else if (mode === 'pq-mlkem768') {
+          ikm = pqSecret;
+        } else if (mode === 'classical-ecdh') {
+          ikm = classicalSecret;
+        } else {
+          ikm = rsaSecret;
+        }
+
+        // Verify recipient decapsulation / key agreement produces the exact same IKM
+        const recipientIkm = await decapsulateSharedSecret({
+          mode,
+          ephemeralPublicKeyB64: ephemeralPublicKeyRaw ? bytesToBase64(ephemeralPublicKeyRaw) : null,
+          pqCiphertextB64: pqCiphertext ? bytesToBase64(pqCiphertext) : null,
+          rsaCiphertextB64: rsaCiphertext ? bytesToBase64(rsaCiphertext) : null
+        });
+
+        const secretsMatch = constantTimeEqual(ikm, recipientIkm);
+        const secretFingerprint = await shortFingerprint(ikm);
+
+        const handshake = {
+          mode,
+          suiteName: suite.name,
+          hkdfInfo: suite.hkdfInfo,
+          ikm,
+          ephemeralPublicKeyRaw,
+          pqCiphertext,
+          rsaCiphertext,
+          secretFingerprint,
+          secretsMatch,
+          establishedAt: new Date().toISOString()
+        };
+
+        state.activeHandshake = handshake;
+        updateHandshakeTelemetryUI(handshake);
+        return handshake;
+      }
+
+      // Courier / Recipient side: Recover Shared Secret (IKM) from Encapsulation / Ephemeral Public Key
+      async function decapsulateSharedSecret(encapsulationData) {
+        const courier = state.courierKeys;
+        const mode = encapsulationData.mode;
+
+        let classicalSecret = null;
+        let pqSecret = null;
+        let rsaSecret = null;
+
+        if (mode === 'hybrid-pq' || mode === 'classical-ecdh') {
+          const epkBytes = base64ToBytes(encapsulationData.ephemeralPublicKeyB64);
+          const epkCryptoKey = await crypto.subtle.importKey(
+            'raw',
+            epkBytes,
+            { name: 'ECDH', namedCurve: 'P-256' },
+            false,
+            []
+          );
+          const bits = await crypto.subtle.deriveBits(
+            { name: 'ECDH', public: epkCryptoKey },
+            courier.ecdhKeyPair.privateKey,
+            256
+          );
+          classicalSecret = new Uint8Array(bits);
+        }
+
+        if (mode === 'hybrid-pq' || mode === 'pq-mlkem768') {
+          const pqCtBytes = base64ToBytes(encapsulationData.pqCiphertextB64);
+          pqSecret = await mlKem768Decapsulate(pqCtBytes, courier.pqKeyPair.secretKey);
+        }
+
+        if (mode === 'rsa-oaep') {
+          const rsaCtBytes = base64ToBytes(encapsulationData.rsaCiphertextB64);
+          const decBuf = await crypto.subtle.decrypt(
+            { name: 'RSA-OAEP' },
+            courier.rsaKeyPair.privateKey,
+            rsaCtBytes
+          );
+          rsaSecret = new Uint8Array(decBuf);
+        }
+
+        if (mode === 'hybrid-pq') {
+          return concatBytes(classicalSecret, pqSecret);
+        } else if (mode === 'pq-mlkem768') {
+          return pqSecret;
+        } else if (mode === 'classical-ecdh') {
+          return classicalSecret;
+        } else {
+          return rsaSecret;
+        }
+      }
+
+      // Derive 256-bit AES-GCM Key from Shared Secret (IKM) via HKDF-SHA-256
+      async function deriveAesGcmKeyFromSecret(ikmBytes, saltBytes, infoStr) {
+        const hkdfBaseKey = await crypto.subtle.importKey(
+          'raw',
+          ikmBytes,
+          'HKDF',
+          false,
+          ['deriveKey']
+        );
+        return await crypto.subtle.deriveKey(
+          {
+            name: 'HKDF',
+            hash: 'SHA-256',
+            salt: saltBytes,
+            info: textEncoder.encode(infoStr)
+          },
+          hkdfBaseKey,
+          { name: 'AES-GCM', length: 256 },
+          false,
+          ['encrypt', 'decrypt']
+        );
+      }
+
+      // Encrypt Sensitive Customer Delivery Note with AES-256-GCM (AEAD)
+      async function encryptDeliveryNote({ plaintext, orderId, dropoffType, aadContext, policy, mode }) {
+        // Perform fresh per-note encapsulation / key agreement handshake
+        const handshake = await establishSharedSecret(mode || state.selectedMode);
+        const suite = SUITE_DEFINITIONS[handshake.mode];
+
+        const hkdfSalt = crypto.getRandomValues(new Uint8Array(16)); // 128-bit HKDF salt
+        const iv = crypto.getRandomValues(new Uint8Array(12));       // 96-bit AES-GCM nonce
+        const timestamp = new Date().toISOString();
+
+        // Construct canonical Additional Authenticated Data (AAD)
+        const aadObject = {
+          v: 1,
+          suite: handshake.mode,
+          orderId: orderId.trim(),
+          dropoffType,
+          policy,
+          context: aadContext.trim(),
+          courierKeyId: state.courierKeys.keyId,
+          timestamp
+        };
+        const aadString = JSON.stringify(aadObject);
+        const aadBytes = textEncoder.encode(aadString);
+
+        // Derive 256-bit AES-GCM Content Encryption Key via HKDF-SHA-256
+        const aesGcmKey = await deriveAesGcmKeyFromSecret(handshake.ikm, hkdfSalt, suite.hkdfInfo);
+
+        // Encrypt plaintext with AES-256-GCM and 128-bit authentication tag
+        const plaintextBytes = textEncoder.encode(plaintext);
+        const sealedBuffer = await crypto.subtle.encrypt(
+          {
+            name: 'AES-GCM',
+            iv,
+            additionalData: aadBytes,
+            tagLength: 128
+          },
+          aesGcmKey,
+          plaintextBytes
+        );
+
+        const sealedBytes = new Uint8Array(sealedBuffer);
+        // WebCrypto AES-GCM appends the 16-byte (128-bit) authentication tag at the end of ciphertext
+        const rawCiphertext = sealedBytes.subarray(0, sealedBytes.length - 16);
+        const authTag = sealedBytes.subarray(sealedBytes.length - 16);
+
+        const envelope = {
+          id: 'note_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
+          version: 'DG-E2EE-1.0',
+          algorithm: {
+            keyEstablishment: handshake.mode,
+            suiteName: suite.name,
+            kdf: 'HKDF-SHA-256',
+            hkdfInfo: suite.hkdfInfo,
+            aead: 'AES-256-GCM',
+            tagLengthBits: 128,
+            ivLengthBits: 96
+          },
+          recipient: {
+            courierKeyId: state.courierKeys.keyId
+          },
+          encapsulation: {
+            mode: handshake.mode,
+            ephemeralPublicKeyB64: handshake.ephemeralPublicKeyRaw
+              ? bytesToBase64(handshake.ephemeralPublicKeyRaw)
+              : null,
+            pqCiphertextB64: handshake.pqCiphertext
+              ? bytesToBase64(handshake.pqCiphertext)
+              : null,
+            pqCiphertextBytes: handshake.pqCiphertext ? handshake.pqCiphertext.byteLength : 0,
+            rsaCiphertextB64: handshake.rsaCiphertext
+              ? bytesToBase64(handshake.rsaCiphertext)
+              : null,
+            sharedSecretFingerprint: handshake.secretFingerprint
+          },
+          aead: {
+            hkdfSaltB64: bytesToBase64(hkdfSalt),
+            ivB64: bytesToBase64(iv),
+            ivHex: bytesToHex(iv),
+            ciphertextB64: bytesToBase64(rawCiphertext),
+            authTagB64: bytesToBase64(authTag),
+            authTagHex: bytesToHex(authTag),
+            aadString,
+            aadB64: bytesToBase64(aadBytes)
+          },
+          metadata: {
+            orderId: aadObject.orderId,
+            dropoffType,
+            policy,
+            createdAt: timestamp
+          }
+        };
+
+        return envelope;
+      }
+
+      // Decrypt & Authenticate Encrypted Delivery Note Envelope
+      async function decryptDeliveryNoteEnvelope(envelope, options = {}) {
+        // 1. Recover shared secret via Key Decapsulation / Key Agreement
+        const ikm = await decapsulateSharedSecret(envelope.encapsulation);
+
+        // 2. Derive AES-256-GCM key via HKDF-SHA-256
+        const hkdfSalt = base64ToBytes(envelope.aead.hkdfSaltB64);
+        const aesGcmKey = await deriveAesGcmKeyFromSecret(
+          ikm,
+          hkdfSalt,
+          envelope.algorithm.hkdfInfo
+        );
+
+        // 3. Reconstruct sealed payload (ciphertext || 16-byte GCM authentication tag)
+        const rawCiphertext = base64ToBytes(envelope.aead.ciphertextB64);
+        const authTag = base64ToBytes(envelope.aead.authTagB64);
+        const iv = base64ToBytes(envelope.aead.ivB64);
+        const aadBytes = textEncoder.encode(envelope.aead.aadString);
+
+        const sealedBytes = concatBytes(rawCiphertext, authTag);
+
+        if (options.simulateTamper) {
+          // Flip 1 bit in the ciphertext to demonstrate AES-GCM authentication tag rejection
+          sealedBytes[0] ^= 0x01;
+        }
+
+        const decryptedBuffer = await crypto.subtle.decrypt(
+          {
+            name: 'AES-GCM',
+            iv,
+            additionalData: aadBytes,
+            tagLength: 128
+          },
+          aesGcmKey,
+          sealedBytes
+        );
+
+        return {
+          plaintext: textDecoder.decode(decryptedBuffer),
+          sharedSecretFingerprint: await shortFingerprint(ikm),
+          aadParsed: JSON.parse(envelope.aead.aadString)
+        };
+      }
