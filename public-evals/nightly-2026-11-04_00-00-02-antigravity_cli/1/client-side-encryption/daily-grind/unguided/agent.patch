+          mode: 'hybrid-pq'
+        });
+        state.notes = [initialEnvelope];
+        saveNotesToStorage();
+        updateEnvelopeInspectorUI(initialEnvelope);
+        renderEncryptedNotesList();
+
+        // Expose API for programmatic inspection/testing if needed
+        window.DailyGrindCrypto = {
+          state,
+          generateCourierRecipientKeys,
+          establishSharedSecret,
+          decapsulateSharedSecret,
+          encryptDeliveryNote,
+          decryptDeliveryNoteEnvelope,
+          mlKem768KeyGen,
+          mlKem768Encapsulate,
+          mlKem768Decapsulate
+        };
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initEncryptedDeliveryNotes);
+      } else {
+        initEncryptedDeliveryNotes();
+      }
+    })();
+  </script>
