+              dropoffType: dropoffSelect.value,
+              aadContext: aadInput.value || 'daily-grind-delivery',
+              policy: policySelect.value,
+              mode: state.selectedMode
+            });
+
+            state.notes.unshift(envelope);
+            saveNotesToStorage();
+            updateEnvelopeInspectorUI(envelope);
+            renderEncryptedNotesList();
+
+            showToast(
+              'Delivery note encrypted in-browser with ' +
+                envelope.algorithm.suiteName +
+                ' + AES-256-GCM (128-bit auth tag).',
+              'success'
+            );
+          } catch (err) {
+            showToast('Encryption error: ' + err.message, 'error');
+          }
+        });
+
+        // Generate initial courier recipient keys & establish initial Hybrid PQ shared secret
+        await generateCourierRecipientKeys();
+        await establishSharedSecret(state.selectedMode);
+
+        // Encrypt initial default note so the inspector and vault are populated and verifiable immediately
+        const initialEnvelope = await encryptDeliveryNote({
+          plaintext: document.getElementById('delivery-note-input').value,
+          orderId: document.getElementById('note-order-id').value,
+          dropoffType: document.getElementById('note-dropoff-type').value,
