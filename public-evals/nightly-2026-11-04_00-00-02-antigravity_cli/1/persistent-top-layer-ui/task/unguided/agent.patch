+  <script>
+    (function () {
+      const dialog = document.getElementById('feedback-dialog');
+      const moveBtn = document.getElementById('move-feedback-btn');
+      const closeBtn = document.getElementById('close-feedback-btn');
+      const openBtn = document.getElementById('open-feedback-btn');
+      const form = document.getElementById('feedback-form');
+      const commentInput = document.getElementById('feedback-comment');
+      const dockIndicator = document.getElementById('feedback-dock-indicator');
+      const statusBar = document.getElementById('feedback-relocation-status');
+
+      const dockSlots = Array.from(document.querySelectorAll('.feedback-dock-slot'));
+
+      function openFeedbackModal() {
+        if (!dialog.open) {
+          if (typeof dialog.showModal === 'function') {
+            dialog.showModal();
+          } else if (typeof dialog.show === 'function') {
+            dialog.show();
+          } else {
+            dialog.setAttribute('open', '');
+          }
+        }
+        openBtn.hidden = true;
+        if (!dialog.contains(document.activeElement) && commentInput) {
+          commentInput.focus({ preventScroll: true });
+        }
+      }
+
+      // Open the persistent feedback modal immediately on load
+      openFeedbackModal();
+
+      // Keep focus on active form fields inside the dialog when clicking the Move button
+      moveBtn.addEventListener('mousedown', function (event) {
+        const active = document.activeElement;
+        if (
+          active &&
+          dialog.contains(active) &&
+          active !== dialog &&
+          active !== moveBtn &&
+          (active.tagName === 'TEXTAREA' || active.tagName === 'INPUT' || active.tagName === 'SELECT')
+        ) {
+          event.preventDefault();
+        }
+      });
+
+      function relocateFeedbackModal() {
+        // Ensure the dialog is open before relocating
+        if (!dialog.open) {
+          openFeedbackModal();
+        }
+
+        const currentParent = dialog.parentElement;
+        const currentIndex = dockSlots.indexOf(currentParent);
+        const nextSlot = dockSlots[(currentIndex + 1) % dockSlots.length] || document.body;
+
+        // Capture current modal and focus state prior to reparenting
+        const wasOpen = dialog.open;
+        let wasModal = false;
+        try {
+          wasModal = dialog.matches(':modal');
+        } catch (_) {
+          wasModal = wasOpen;
+        }
+
+        const activeEl = document.activeElement;
+        const elementToKeepFocused =
+          activeEl && dialog.contains(activeEl) && activeEl !== dialog
+            ? activeEl
+            : commentInput || moveBtn;
+
+        if (!activeEl || !dialog.contains(activeEl) || activeEl === dialog) {
+          elementToKeepFocused.focus({ preventScroll: true });
+        }
+
+        let selStart = null;
+        let selEnd = null;
+        let selDir = null;
+        if (elementToKeepFocused && 'selectionStart' in elementToKeepFocused) {
+          try {
+            selStart = elementToKeepFocused.selectionStart;
+            selEnd = elementToKeepFocused.selectionEnd;
+            selDir = elementToKeepFocused.selectionDirection;
+          } catch (_) {}
+        }
+
+        let usedNativeMoveBefore = false;
+        if (typeof nextSlot.moveBefore === 'function') {
+          try {
+            nextSlot.moveBefore(dialog, null);
+            usedNativeMoveBefore = true;
+          } catch (_) {
+            usedNativeMoveBefore = false;
+          }
+        }
+
+        if (!usedNativeMoveBefore) {
+          // Fallback for browsers without native moveBefore support
+          nextSlot.insertBefore(dialog, null);
+        }
+
+        // Fallback restoration: if the browser closed the dialog or dropped modal state on DOM move
+        let isStillModal = false;
+        try {
+          isStillModal = dialog.matches(':modal');
+        } catch (_) {
+          isStillModal = dialog.open;
+        }
+
+        if (wasOpen && (!dialog.open || (wasModal && !isStillModal))) {
+          if (dialog.open) {
+            dialog.close();
+          }
+          if (wasModal && typeof dialog.showModal === 'function') {
+            dialog.showModal();
+          } else if (typeof dialog.show === 'function') {
+            dialog.show();
+          } else {
+            dialog.setAttribute('open', '');
+          }
+        }
+
+        // Ensure focus and text selection remain active inside the reparented modal
+        if (elementToKeepFocused && document.activeElement !== elementToKeepFocused) {
+          try {
+            elementToKeepFocused.focus({ preventScroll: true });
+            if (
+              selStart !== null &&
+              selEnd !== null &&
+              typeof elementToKeepFocused.setSelectionRange === 'function'
+            ) {
+              elementToKeepFocused.setSelectionRange(selStart, selEnd, selDir || 'none');
+            }
+          } catch (_) {}
+        }
+
+        if (dockIndicator) {
+          dockIndicator.textContent = 'DOM Host: #' + nextSlot.id;
+        }
+        if (statusBar) {
+          const methodLabel = usedNativeMoveBefore
+            ? 'Relocated via native moveBefore()'
+            : 'Relocated via fallback (re-opened & focus restored)';
+          statusBar.textContent = methodLabel + ' -> #' + nextSlot.id;
+        }
+      }
+
+      moveBtn.addEventListener('click', relocateFeedbackModal);
+
+      closeBtn.addEventListener('click', function () {
+        dialog.close();
+        openBtn.hidden = false;
+      });
+
+      dialog.addEventListener('close', function () {
+        openBtn.hidden = false;
+      });
+
+      openBtn.addEventListener('click', function () {
+        openFeedbackModal();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        if (statusBar) {
+          statusBar.textContent = 'Thank you! Your feedback has been saved.';
+        }
+      });
+    })();
+  </script>
+
