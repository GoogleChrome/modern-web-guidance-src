+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill').catch(() => {});
+    }
+
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const openFeedbackBtn = document.getElementById('open-feedback-btn');
+    const moveDialogBtn = document.getElementById('move-dialog-btn');
+    const currentParentName = document.getElementById('current-parent-name');
+    const hostContainers = [
+      document.getElementById('feedback-host-main'),
+      document.getElementById('feedback-host-footer'),
+    ];
+
+    // Fallback click handler for browsers where commandForElement isn't natively supported yet
+    openFeedbackBtn.addEventListener('click', () => {
+      if (!('commandForElement' in HTMLButtonElement.prototype) && !feedbackDialog.open) {
+        feedbackDialog.showModal();
+      }
+    });
+
+    function relocateOpenDialog(targetParent, popoverOrDialog) {
+      // Check if moveBefore is supported on Element.prototype
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(popoverOrDialog, null);
+      } else {
+        // Fallback: traditional move (will close <dialog> and popover elements)
+        const wasOpen =
+          popoverOrDialog.hasAttribute('open') ||
+          (typeof popoverOrDialog.matches === 'function' && popoverOrDialog.matches(':popover-open'));
+        const previousFocus = document.activeElement;
+
+        targetParent.insertBefore(popoverOrDialog, null);
+
+        // Manually restore state in unsupported browsers
+        if (wasOpen && typeof popoverOrDialog.showModal === 'function') {
+          popoverOrDialog.showModal();
+        } else if (wasOpen && typeof popoverOrDialog.showPopover === 'function') {
+          popoverOrDialog.showPopover();
+        }
+
+        if (previousFocus && popoverOrDialog.contains(previousFocus) && typeof previousFocus.focus === 'function') {
+          previousFocus.focus();
+        }
+      }
+    }
+
+    moveDialogBtn.addEventListener('click', () => {
+      const currentParent = feedbackDialog.parentElement;
+      const nextParent =
+        hostContainers.find((container) => container && container !== currentParent) || hostContainers[0];
+
+      if (!nextParent) return;
+
+      relocateOpenDialog(nextParent, feedbackDialog);
+      currentParentName.textContent = `#${nextParent.id}`;
+    });
+
+    feedbackDialog.addEventListener('close', () => {
+      const action = feedbackDialog.returnValue;
+      feedbackDialog.returnValue = '';
+      if (action === 'submit') {
+        document.getElementById('feedback-form').reset();
+      }
+    });
+  </script>
