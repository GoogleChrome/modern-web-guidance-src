+    /* Options Dropdown (Top-Layer Popover & CSS Anchor Positioning) */
+    #trigger-btn {
+      anchor-name: --trigger-btn;
+      background: transparent;
+      color: white;
+      border: 1px solid rgba(255, 255, 255, 0.35);
+      padding: 5px 12px;
+      border-radius: 4px;
+      font-family: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      display: inline-flex;
+      align-items: center;
+      gap: 6px;
+      transition: color 0.3s, border-color 0.3s, background-color 0.3s;
+    }
+
+    #trigger-btn:hover,
+    #trigger-btn:focus-visible {
+      color: var(--accent);
+      border-color: var(--accent);
+      outline: none;
+    }
+
+    #action-panel {
+      position: fixed;
+      position-anchor: --trigger-btn;
+      inset: auto;
+      margin: 0;
+      top: anchor(bottom);
+      left: anchor(left);
+      position-try-options: flip-block, flip-inline, flip-block flip-inline;
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      min-width: 190px;
+      background: white;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 6px;
+      box-shadow: 0 8px 24px rgba(62, 39, 35, 0.18);
+    }
+
+    #action-panel:popover-open {
+      display: flex;
+      flex-direction: column;
+      gap: 2px;
+    }
+
+    .action-btn {
+      width: 100%;
+      background: transparent;
+      border: none;
+      border-radius: 6px;
+      padding: 9px 12px;
+      text-align: left;
+      font-family: inherit;
+      font-size: 0.9rem;
+      color: var(--text);
+      cursor: pointer;
+      transition: background-color 0.2s, color 0.2s;
+    }
+
+    .action-btn:hover,
+    .action-btn:focus-visible {
+      background-color: var(--secondary);
+      color: var(--primary);
+      outline: none;
+    }
+
