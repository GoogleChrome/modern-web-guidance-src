+  <script type="module">
+    try {
+      await import('https://esm.sh/webauthn-polyfills');
+    } catch {
+      // Fallback gracefully when offline or if native WebAuthn methods are already present
+    }
+
+    const loginAbortController = new AbortController();
+
+    const togglePasswordBtn = document.getElementById('toggle-password');
+    const passwordInput = document.getElementById('current-password');
+    if (togglePasswordBtn && passwordInput) {
+      togglePasswordBtn.addEventListener('click', () => {
+        const isShowing = passwordInput.type === 'text';
+        passwordInput.type = isShowing ? 'password' : 'text';
+        togglePasswordBtn.setAttribute('aria-pressed', String(!isShowing));
+        togglePasswordBtn.setAttribute('aria-label', isShowing ? 'Show password' : 'Hide password');
+        togglePasswordBtn.textContent = isShowing ? 'Show' : 'Hide';
+      });
+    }
+
+    async function triggerConditionalCreate(abortController) {
+      if (typeof window.PublicKeyCredential === 'undefined' || typeof PublicKeyCredential.getClientCapabilities !== 'function') {
+        return;
+      }
+
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalCreate !== true) {
+        return;
+      }
+
+      // 1. Abort any active autofill conditional-get controllers to clear the WebAuthn pipeline
+      if (abortController) {
+        abortController.abort();
+      }
+
+      // 2. Fetch creation options signaling the backend that this is a conditional request
+      let creationOptionsJSON;
+      try {
+        const optionsRes = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ conditional: true })
+        });
+        if (!optionsRes.ok) {
+          return;
+        }
+        creationOptionsJSON = await optionsRes.json();
+      } catch (err) {
+        return;
+      }
+
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+      const rpId = publicKey?.rp?.id || creationOptionsJSON?.rp?.id || window.location.hostname;
+
+      let credential;
+      try {
+        // 3. Invoke silent credentials creation prompt
+        credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional'
+        });
+      } catch (e) {
+        // 4. Silently swallow common WebAuthn browser exceptions
+        if (['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e.name)) {
+          return;
+        }
+        console.error('Unexpected conditional create error:', e);
+        return;
+      }
+
+      if (!credential) {
+        return;
+      }
+
+      // 5. Server verification step using dedicated Try/Catch block
+      const encodedResponse = typeof credential.toJSON === 'function' ? credential.toJSON() : credential;
+      try {
+        const response = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encodedResponse)
+        });
+        if (!response.ok) {
+          // 6. If the server verification fails, clean up using Signal API
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId,
+              credentialId: encodedResponse.id
+            });
+          }
+        }
+      } catch (serverErr) {
+        console.error('Verification network failure:', serverErr);
+        if (PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId,
+            credentialId: encodedResponse.id
+          });
+        }
+      }
+    }
+
+    const signinForm = document.getElementById('signin-form');
+    if (signinForm) {
+      signinForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const formData = new FormData(signinForm);
+        const payload = Object.fromEntries(formData.entries());
+
+        try {
+          const loginRes = await fetch(signinForm.action || '/api/login', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(payload)
+          });
+          if (!loginRes.ok && loginRes.status !== 404 && loginRes.status !== 405) {
+            return;
+          }
+        } catch (err) {
+          // Proceed to conditional passkey creation if no /api/login endpoint is mocked
+        }
+
+        await triggerConditionalCreate(loginAbortController);
+      });
+    }
+  </script>
