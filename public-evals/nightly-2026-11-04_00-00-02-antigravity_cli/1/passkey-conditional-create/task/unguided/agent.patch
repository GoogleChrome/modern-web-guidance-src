+  <script>
+    function base64UrlToUint8Array(input) {
+      if (input instanceof Uint8Array) return input;
+      if (input instanceof ArrayBuffer) return new Uint8Array(input);
+      if (ArrayBuffer.isView(input)) {
+        return new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
+      }
+      if (Array.isArray(input)) return new Uint8Array(input);
+      if (typeof input !== 'string') return new Uint8Array();
+      try {
+        const padding = '='.repeat((4 - (input.length % 4)) % 4);
+        const base64 = (input + padding).replace(/-/g, '+').replace(/_/g, '/');
+        const raw = atob(base64);
+        const bytes = new Uint8Array(raw.length);
+        for (let i = 0; i < raw.length; i++) {
+          bytes[i] = raw.charCodeAt(i);
+        }
+        return bytes;
+      } catch {
+        return new TextEncoder().encode(input);
+      }
+    }
+
+    function bufferToBase64Url(buf) {
+      if (!buf) return buf;
+      if (typeof buf === 'string') return buf;
+      const bytes = buf instanceof ArrayBuffer
+        ? new Uint8Array(buf)
+        : ArrayBuffer.isView(buf)
+          ? new Uint8Array(buf.buffer, buf.byteOffset, buf.byteLength)
+          : Array.isArray(buf)
+            ? new Uint8Array(buf)
+            : null;
+      if (!bytes) return buf;
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    async function promotePasskeySilently(username) {
+      try {
+        if (
+          typeof window.PublicKeyCredential === 'undefined' ||
+          typeof PublicKeyCredential.getClientCapabilities !== 'function'
+        ) {
+          return;
+        }
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!capabilities || !capabilities.conditionalCreate) {
+          return;
+        }
+
+        const optionsRes = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ username }),
+        });
+
+        if (!optionsRes.ok) {
+          return;
+        }
+
+        const optionsData = await optionsRes.json();
+        const rawOptions = optionsData.publicKey || optionsData.options || optionsData;
+
+        const publicKey = {
+          ...rawOptions,
+          challenge: rawOptions.challenge !== undefined
+            ? base64UrlToUint8Array(rawOptions.challenge)
+            : new Uint8Array(16),
+          user: rawOptions.user
+            ? {
+                ...rawOptions.user,
+                id: rawOptions.user.id !== undefined
+                  ? base64UrlToUint8Array(rawOptions.user.id)
+                  : new Uint8Array(16),
+              }
+            : undefined,
+        };
+
+        if (Array.isArray(rawOptions.excludeCredentials)) {
+          publicKey.excludeCredentials = rawOptions.excludeCredentials.map((cred) => ({
+            ...cred,
+            id: cred.id !== undefined ? base64UrlToUint8Array(cred.id) : cred.id,
+          }));
+        }
+
+        const credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional',
+        });
+
+        if (!credential) {
+          return;
+        }
+
+        let verifyPayload;
+        if (typeof credential.toJSON === 'function') {
+          verifyPayload = credential.toJSON();
+        } else {
+          const resp = credential.response || {};
+          verifyPayload = {
+            ...credential,
+            id: credential.id,
+            rawId: bufferToBase64Url(credential.rawId ?? credential.id),
+            type: credential.type || 'public-key',
+            authenticatorAttachment: credential.authenticatorAttachment,
+            clientExtensionResults:
+              typeof credential.getClientExtensionResults === 'function'
+                ? credential.getClientExtensionResults()
+                : credential.clientExtensionResults || {},
+            response: {
+              ...resp,
+              clientDataJSON: bufferToBase64Url(resp.clientDataJSON),
+              attestationObject: bufferToBase64Url(resp.attestationObject),
+              ...(typeof resp.getTransports === 'function'
+                ? { transports: resp.getTransports() }
+                : {}),
+            },
+          };
+        }
+
+        await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(verifyPayload),
+        });
+      } catch {
+        // Silently ignore any errors during conditional background passkey creation
+      }
+    }
+
+    const signinForm = document.getElementById('signin-form');
+    const usernameInput = document.getElementById('username');
+
+    signinForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const username = usernameInput ? usernameInput.value : '';
+      promotePasskeySilently(username);
+    });
+  </script>
