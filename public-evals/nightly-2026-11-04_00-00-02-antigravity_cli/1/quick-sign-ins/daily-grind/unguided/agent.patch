+  <!-- In-page Sign-In Modal -->
+  <div id="auth-modal-overlay" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title">
+    <div class="auth-modal">
+      <button type="button" id="auth-modal-close" class="modal-close" aria-label="Close sign in dialog">&times;</button>
+      <h2 id="auth-modal-title">Sign In to The Daily Grind</h2>
+      <p id="auth-modal-subtitle" class="subtitle">Use a saved passkey or password to continue without leaving this page.</p>
+
+      <button type="button" id="modal-webauthn-btn" class="passkey-btn">
+        <span>🔑 Sign in with Saved Passkey or Browser Login</span>
+      </button>
+
+      <div class="divider">or autofill saved credentials</div>
+
+      <form id="inline-signin-form" action="#signin" method="post">
+        <div class="form-group">
+          <label for="signin-username">Email or Username</label>
+          <input
+            type="text"
+            id="signin-username"
+            name="username"
+            autocomplete="username webauthn"
+            placeholder="you@example.com"
+            required
+          />
+        </div>
+        <div class="form-group">
+          <label for="signin-password">Password</label>
+          <input
+            type="password"
+            id="signin-password"
+            name="password"
+            autocomplete="current-password webauthn"
+            placeholder="••••••••"
+          />
+        </div>
+        <button type="submit" class="form-submit">Continue</button>
+      </form>
+
+      <div id="auth-status" class="auth-status hidden" role="status" aria-live="polite"></div>
+    </div>
+  </div>
+
+  <div id="toast" class="toast hidden" role="status" aria-live="polite"></div>
+
+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_user';
+      let currentUser = null;
+      let pendingAction = null;
+      let conditionalAbortController = null;
+
+      const navSigninItem = document.getElementById('nav-signin-item');
+      const navSigninLink = document.getElementById('nav-signin-link');
+      const navUserItem = document.getElementById('nav-user-item');
+      const navUserBadge = document.getElementById('nav-user-badge');
+      const navLogoutItem = document.getElementById('nav-logout-item');
+      const logoutLink = document.getElementById('logout-link');
+
+      const authBanner = document.getElementById('auth-banner');
+      const bannerPasskeyBtn = document.getElementById('banner-passkey-btn');
+      const bannerModalBtn = document.getElementById('banner-modal-btn');
+
+      const modalOverlay = document.getElementById('auth-modal-overlay');
+      const modalClose = document.getElementById('auth-modal-close');
+      const modalSubtitle = document.getElementById('auth-modal-subtitle');
+      const modalWebauthnBtn = document.getElementById('modal-webauthn-btn');
+      const signinForm = document.getElementById('inline-signin-form');
+      const usernameInput = document.getElementById('signin-username');
+      const passwordInput = document.getElementById('signin-password');
+      const authStatus = document.getElementById('auth-status');
+      const toastEl = document.getElementById('toast');
+
+      function showToast(message) {
+        toastEl.textContent = message;
+        toastEl.classList.remove('hidden');
+        clearTimeout(showToast._timer);
+        showToast._timer = setTimeout(() => {
+          toastEl.classList.add('hidden');
+        }, 4000);
+      }
+
+      function setStatus(message, type) {
+        if (!message) {
+          authStatus.classList.add('hidden');
+          authStatus.textContent = '';
+          return;
+        }
+        authStatus.textContent = message;
+        authStatus.className = 'auth-status ' + (type || 'info');
+      }
+
+      function createChallenge() {
+        const buffer = new Uint8Array(32);
+        if (window.crypto && window.crypto.getRandomValues) {
+          window.crypto.getRandomValues(buffer);
+        }
+        return buffer;
+      }
+
+      function buildCredentialRequestOptions(mediation) {
+        const options = {
+          password: true,
+          publicKey: {
+            challenge: createChallenge(),
+            timeout: 60000,
+            userVerification: 'preferred',
+            allowCredentials: []
+          }
+        };
+        if (mediation) {
+          options.mediation = mediation;
+        }
+        return options;
+      }
+
+      function updateUIForAuthState() {
+        if (currentUser) {
+          navSigninItem.classList.add('hidden');
+          navUserItem.classList.remove('hidden');
+          navLogoutItem.classList.remove('hidden');
+          navUserBadge.textContent = '☕ ' + currentUser.name;
+          authBanner.classList.add('hidden');
+          modalOverlay.classList.add('hidden');
+        } else {
+          navSigninItem.classList.remove('hidden');
+          navUserItem.classList.add('hidden');
+          navLogoutItem.classList.add('hidden');
+          navUserBadge.textContent = '';
+          authBanner.classList.remove('hidden');
+        }
+      }
+
+      function completeSignIn(userInfo, methodLabel) {
+        currentUser = {
+          id: userInfo.id || 'returning-customer',
+          name: userInfo.name || userInfo.id || 'Returning Customer',
+          method: methodLabel || 'Saved Credential'
+        };
+        try {
+          sessionStorage.setItem(STORAGE_KEY, JSON.stringify(currentUser));
+        } catch (e) {
+          // Ignore storage errors
+        }
+
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+          conditionalAbortController = null;
+        }
+
+        setStatus('Signed in as ' + currentUser.name + '!', 'success');
+        updateUIForAuthState();
+
+        const destination = pendingAction;
+        pendingAction = null;
+
+        if (destination) {
+          showToast('Signed in as ' + currentUser.name + '! Opening ' + destination.label + '...');
+        } else {
+          showToast('Welcome back, ' + currentUser.name + '! Signed in via ' + currentUser.method + '.');
+        }
+      }
+
+      async function requestBrowserCredentials(mediationMode, triggerModalOnFallback) {
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          if (triggerModalOnFallback) {
+            openSignInModal();
+            setStatus('Enter or autofill your saved credentials below.', 'info');
+          }
+          return null;
+        }
+
+        try {
+          if (conditionalAbortController) {
+            conditionalAbortController.abort();
+            conditionalAbortController = null;
+          }
+
+          const options = buildCredentialRequestOptions(mediationMode);
+          if (mediationMode === 'conditional') {
+            conditionalAbortController = new AbortController();
+            options.signal = conditionalAbortController.signal;
+          }
+
+          const credential = await navigator.credentials.get(options);
+          if (credential) {
+            if (mediationMode === 'conditional') {
+              conditionalAbortController = null;
+            }
+            const displayName = credential.name || credential.id || 'Returning Member';
+            const method = credential.type === 'public-key' ? 'Passkey' : 'Saved Password';
+            completeSignIn({ id: credential.id, name: displayName }, method);
+            return credential;
+          }
+        } catch (err) {
+          if (err && err.name === 'AbortError') {
+            return null;
+          }
+          // If publicKey + password combined isn't supported in a single call by the browser,
+          // fall back to publicKey-only credential request.
+          if (mediationMode !== 'conditional') {
+            try {
+              const fallbackCred = await navigator.credentials.get({
+                publicKey: {
+                  challenge: createChallenge(),
+                  timeout: 60000,
+                  userVerification: 'preferred'
+                },
+                mediation: mediationMode || 'optional'
+              });
+              if (fallbackCred) {
+                completeSignIn({ id: fallbackCred.id, name: 'Passkey Member' }, 'Passkey');
+                return fallbackCred;
+              }
+            } catch (_) {
+              // Ignore fallback error and allow inline modal form fallback
+            }
+          }
+
+          if (triggerModalOnFallback) {
+            openSignInModal(pendingAction);
+            setStatus('Select a saved passkey/password from autofill or sign in below.', 'info');
+          }
+        }
+        return null;
+      }
+
+      function startConditionalMediation() {
+        if (
+          !currentUser &&
+          window.PublicKeyCredential &&
+          typeof PublicKeyCredential.isConditionalMediationAvailable === 'function'
+        ) {
+          PublicKeyCredential.isConditionalMediationAvailable()
+            .then((available) => {
+              if (available && !currentUser) {
+                requestBrowserCredentials('conditional', false);
+              }
+            })
+            .catch(() => {});
+        }
+      }
+
+      function openSignInModal(actionContext, skipConditional) {
+        if (actionContext) {
+          pendingAction = actionContext;
+          modalSubtitle.textContent =
+            'Sign in right here to access ' + actionContext.label + ' without leaving your browsing flow.';
+        } else {
+          modalSubtitle.textContent =
+            'Use a saved passkey or password to continue without leaving this page.';
+        }
+        setStatus('', 'info');
+        modalOverlay.classList.remove('hidden');
+        usernameInput.focus();
+
+        if (!skipConditional) {
+          startConditionalMediation();
+        }
+      }
+
+      function closeSignInModal() {
+        modalOverlay.classList.add('hidden');
+        pendingAction = null;
+      }
+
+      // Intercept auth-protected links ("Rewards", "My Account", "Order Now") so users stay on the page
+      document.querySelectorAll('[data-requires-auth]').forEach((link) => {
+        link.addEventListener('click', async (event) => {
+          event.preventDefault();
+          const label = link.getAttribute('data-requires-auth') || link.textContent.trim();
+          const href = link.getAttribute('href');
+
+          if (currentUser) {
+            showToast('Accessing ' + label + ' as ' + currentUser.name + '.');
+            return;
+          }
+
+          pendingAction = { label, href };
+          openSignInModal(pendingAction, true);
+          const cred = await requestBrowserCredentials('optional', false);
+          if (!cred && !currentUser) {
+            startConditionalMediation();
+          }
+        });
+      });
+
+      navSigninLink.addEventListener('click', async (event) => {
+        event.preventDefault();
+        openSignInModal(null, true);
+        const cred = await requestBrowserCredentials('optional', false);
+        if (!cred && !currentUser) {
+          startConditionalMediation();
+        }
+      });
+
+      bannerPasskeyBtn.addEventListener('click', async () => {
+        const cred = await requestBrowserCredentials('optional', true);
+        if (!cred && !currentUser) {
+          startConditionalMediation();
+        }
+      });
+
+      bannerModalBtn.addEventListener('click', () => {
+        openSignInModal();
+      });
+
+      modalWebauthnBtn.addEventListener('click', async () => {
+        setStatus('Requesting saved passkey or password from your browser...', 'info');
+        const cred = await requestBrowserCredentials('optional', false);
+        if (!cred && !currentUser) {
+          setStatus('No browser passkey selected. You can also use autofill in the fields below.', 'info');
+        }
+      });
+
+      modalClose.addEventListener('click', closeSignInModal);
+      modalOverlay.addEventListener('click', (event) => {
+        if (event.target === modalOverlay) {
+          closeSignInModal();
+        }
+      });
+
+      signinForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const username = usernameInput.value.trim();
+        const password = passwordInput.value;
+        if (!username) {
+          setStatus('Please enter or autofill your username or email.', 'error');
+          return;
+        }
+
+        // Store in browser Credential Management API if PasswordCredential is supported
+        if (window.PasswordCredential && password && navigator.credentials && navigator.credentials.store) {
+          try {
+            const pwCred = new PasswordCredential({
+              id: username,
+              password: password,
+              name: username
+            });
+            await navigator.credentials.store(pwCred);
+          } catch (_) {
+            // Ignore credential storage errors
+          }
+        }
+
+        completeSignIn({ id: username, name: username }, 'Saved Password');
+        signinForm.reset();
+      });
+
+      logoutLink.addEventListener('click', async (event) => {
+        event.preventDefault();
+        currentUser = null;
+        try {
+          sessionStorage.removeItem(STORAGE_KEY);
+        } catch (e) {}
+
+        if (navigator.credentials && typeof navigator.credentials.preventSilentAccess === 'function') {
+          try {
+            await navigator.credentials.preventSilentAccess();
+          } catch (_) {}
+        }
+
+        updateUIForAuthState();
+        showToast('You have been signed out.');
+      });
+
+      // On initial page load: restore session or attempt non-intrusive silent/ambient credential check
+      function initAuthOnBrowse() {
+        try {
+          const saved = sessionStorage.getItem(STORAGE_KEY);
+          if (saved) {
+            currentUser = JSON.parse(saved);
+            updateUIForAuthState();
+            return;
+          }
+        } catch (e) {}
+
+        updateUIForAuthState();
+
+        // Check for silent / ambient credentials for returning customers browsing the site
+        if (navigator.credentials && typeof navigator.credentials.get === 'function') {
+          requestBrowserCredentials('silent', false);
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initAuthOnBrowse);
+      } else {
+        initAuthOnBrowse();
+      }
+    })();
+  </script>
+
 </body>
 
