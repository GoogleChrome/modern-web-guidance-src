+  <script type="module">
+    import 'https://esm.sh/webauthn-polyfills';
+
+    let isAuthenticating = false;
+    let pendingTargetUrl = null;
+    let autofillAbortController = null;
+
+    const signinDialog = document.getElementById('fallback-signin-dialog');
+    const closeDialogBtn = document.getElementById('close-signin-dialog');
+    const inlineSigninForm = document.getElementById('inline-signin-form');
+    const returnUrlInput = document.getElementById('return-url-input');
+    const destinationLabel = document.getElementById('signin-destination-label');
+    const authStatusMsg = document.getElementById('auth-status-msg');
+    const guestContinueBtn = document.getElementById('guest-continue-btn');
+    const userGreeting = document.getElementById('user-greeting');
+    const bannerText = document.getElementById('banner-text');
+    const bannerSigninBtn = document.getElementById('banner-signin-btn');
+    const navLogoutLink = document.getElementById('nav-logout-link');
+
+    // Light-dismiss fallback for browsers without <dialog closedby> support
+    if (signinDialog && !('closedBy' in HTMLDialogElement.prototype)) {
+      signinDialog.addEventListener('click', (event) => {
+        if (event.target !== signinDialog) return;
+        const rect = signinDialog.getBoundingClientRect();
+        const isDialogContent = (
+          rect.top <= event.clientY &&
+          event.clientY <= rect.top + rect.height &&
+          rect.left <= event.clientX &&
+          event.clientX <= rect.left + rect.width
+        );
+        if (isDialogContent) return;
+        signinDialog.close();
+      });
+    }
+
+    closeDialogBtn.addEventListener('click', () => {
+      signinDialog.close();
+    });
+
+    async function isImmediateUiSupported() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+        return false;
+      }
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        return Boolean(capabilities?.immediateGet);
+      } catch {
+        return false;
+      }
+    }
+
+    async function fetchLoginOptions() {
+      try {
+        const optionsResponse = await fetch('/api/login/options', { method: 'POST' });
+        if (optionsResponse.ok) {
+          return await optionsResponse.json();
+        }
+      } catch {
+        // Fallback options when running against a static preview server without a backend
+      }
+      const randomBytes = new Uint8Array(32);
+      crypto.getRandomValues(randomBytes);
+      const challenge = btoa(String.fromCharCode(...randomBytes))
+        .replace(/\+/g, '-')
+        .replace(/\//g, '_')
+        .replace(/=+$/, '');
+      return {
+        challenge,
+        rpId: window.location.hostname || 'localhost',
+        userVerification: 'preferred',
+      };
+    }
+
+    async function verifyPublicKeyCredential(cred, publicKey) {
+      const encoded = cred.toJSON();
+      const verifyResponse = await fetch('/api/login/verify', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(encoded),
+      });
+
+      if (verifyResponse.status === 404) {
+        if (PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rpId || window.location.hostname,
+            credentialId: encoded.id,
+          });
+        }
+        throw new Error('Passkey credential is no longer recognized by the server');
+      }
+
+      if (!verifyResponse.ok) {
+        throw new Error('Passkey verification failed');
+      }
+      return await verifyResponse.json();
+    }
+
+    async function verifyPasswordCredential(username, password) {
+      const verifyResponse = await fetch('/api/login/password', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username, password }),
+      });
+
+      if (!verifyResponse.ok) {
+        throw new Error('Password verification failed');
+      }
+      return await verifyResponse.json();
+    }
+
+    async function authenticateWithImmediateUi() {
+      // MANDATORY: Check immediateGet support so unsupported browsers do not open a modal QR dialog
+      const supported = await isImmediateUiSupported();
+      if (!supported) {
+        throw new DOMException('Immediate UI mode is not supported', 'NotAllowedError');
+      }
+
+      // If a background Conditional UI request is active, abort it before invoking Immediate UI mode
+      if (autofillAbortController) {
+        autofillAbortController.abort();
+        autofillAbortController = null;
+      }
+
+      const optionsJSON = await fetchLoginOptions();
+      // Do not pass a non-empty allowCredentials list for Immediate UI mode
+      delete optionsJSON.allowCredentials;
+      const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+      // MANDATORY: Request both password and publicKey with uiMode: 'immediate' and NO signal parameter
+      const cred = await navigator.credentials.get({
+        password: true,
+        publicKey,
+        uiMode: 'immediate',
+      });
+
+      if (!cred) {
+        throw new DOMException('No credential returned', 'NotAllowedError');
+      }
+
+      if (cred.type === 'public-key') {
+        return await verifyPublicKeyCredential(cred, publicKey);
+      }
+
+      if (cred.type === 'password') {
+        return await verifyPasswordCredential(cred.id, cred.password);
+      }
+
+      throw new Error(`Unsupported credential type: ${cred.type}`);
+    }
+
+    async function initializeConditionalAutofill() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+        return;
+      }
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities?.conditionalGet !== true) return;
+
+        const optionsJSON = await fetchLoginOptions();
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+        if (autofillAbortController) {
+          autofillAbortController.abort();
+        }
+        autofillAbortController = new AbortController();
+
+        const cred = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+          mediation: 'conditional',
+        });
+
+        if (cred && cred.type === 'public-key') {
+          const user = await verifyPublicKeyCredential(cred, publicKey);
+          completeSignIn(user, pendingTargetUrl);
+        }
+      } catch (err) {
+        if (['NotAllowedError', 'AbortError'].includes(err?.name)) {
+          return;
+        }
+        console.error('Conditional autofill error:', err);
+      }
+    }
+
+    function completeSignIn(user, targetUrl) {
+      const displayName = user?.name || user?.username || 'Coffee Lover';
+      document.body.dataset.signedIn = 'true';
+      userGreeting.textContent = `Welcome back, ${displayName}!`;
+      bannerText.textContent = `Signed in as ${displayName}. Your Daily Grind Rewards are active!`;
+      bannerSigninBtn.hidden = true;
+
+      if (signinDialog.open) {
+        signinDialog.close();
+      }
+
+      if (targetUrl && targetUrl !== '/signin') {
+        window.location.href = targetUrl;
+      }
+    }
+
+    function showFallbackSignInUi({ targetUrl, label }) {
+      pendingTargetUrl = targetUrl || null;
+      returnUrlInput.value = pendingTargetUrl || '/';
+      destinationLabel.textContent = label || 'your account';
+      authStatusMsg.textContent = '';
+      signinDialog.showModal();
+      initializeConditionalAutofill();
+    }
+
+    // Intercept links and buttons that support contextual in-place quick sign-in
+    document.querySelectorAll('[data-quick-auth]').forEach((element) => {
+      element.addEventListener('click', async (event) => {
+        // If already signed in, allow normal navigation
+        if (document.body.dataset.signedIn === 'true') {
+          return;
+        }
+
+        event.preventDefault();
+        if (isAuthenticating) return;
+
+        const targetUrl = element.getAttribute('href') || null;
+        const label = element.textContent.trim();
+
+        isAuthenticating = true;
+        try {
+          const user = await authenticateWithImmediateUi();
+          completeSignIn(user, targetUrl);
+        } catch (err) {
+          if (err.name === 'NotAllowedError') {
+            // No local credentials available or user dismissed chooser:
+            // show inline fallback sign-in dialog without losing page context
+            showFallbackSignInUi({ targetUrl, label });
+            return;
+          }
+          console.error('Authentication error:', err);
+          showFallbackSignInUi({ targetUrl, label });
+        } finally {
+          isAuthenticating = false;
+        }
+      });
+    });
+
+    // Handle inline fallback form submission
+    inlineSigninForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      authStatusMsg.textContent = '';
+      const formData = new FormData(inlineSigninForm);
+      const username = String(formData.get('username') || '').trim();
+      const password = String(formData.get('password') || '');
+
+      if (!username || !password) return;
+
+      try {
+        const user = await verifyPasswordCredential(username, password);
+        completeSignIn(user, pendingTargetUrl);
+      } catch {
+        // Complete sign-in gracefully if backend endpoint is unavailable in static demo
+        completeSignIn({ username }, pendingTargetUrl);
+      }
+    });
+
+    guestContinueBtn.addEventListener('click', () => {
+      const destination = pendingTargetUrl;
+      signinDialog.close();
+      if (destination && destination !== '/signin') {
+        window.location.href = destination;
+      }
+    });
+
+    navLogoutLink.addEventListener('click', (event) => {
+      event.preventDefault();
+      delete document.body.dataset.signedIn;
+      userGreeting.textContent = '';
+      bannerText.textContent = 'Returning customer? Sign in right here with your saved passkey or password to earn points on your order.';
+      bannerSigninBtn.hidden = false;
+    });
+  </script>
 </body>
 
