+          'Coarse-ground single-origin beans steeped in filtered cold water for 18 hours, producing a naturally sweet, low-acid coffee served over crystal-clear ice.',
+        roast: 'Medium Roast',
+        notes: 'Caramel, Smooth Berry',
+        caffeine: '200 mg',
+        href: '/menu/cold-brew',
+        image:
+          'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=900&q=80',
+      },
+    };
+
+    // 1. Animation & Transition Event Tracking via event.animation
+    const supportsAnimationEventObject =
+      typeof AnimationEvent !== 'undefined' &&
+      'animation' in AnimationEvent.prototype;
+    const supportsTransitionEventObject =
+      typeof TransitionEvent !== 'undefined' &&
+      'animation' in TransitionEvent.prototype;
+
+    function resolveEventAnimation(event) {
+      if (
+        (event.type.startsWith('animation') && supportsAnimationEventObject) ||
+        (event.type.startsWith('transition') && supportsTransitionEventObject) ||
+        'animation' in event
+      ) {
+        return event.animation;
+      }
+
+      if (!event.target || typeof event.target.getAnimations !== 'function') {
+        return null;
+      }
+
+      return (
+        event.target.getAnimations().find((anim) => {
+          if (event.type.startsWith('animation')) {
+            return anim.animationName === event.animationName;
+          }
+          return anim.transitionProperty === event.propertyName;
+        }) || null
+      );
+    }
+
+    function updateLastAnimationState(event) {
+      const animation = resolveEventAnimation(event);
+      const name =
+        animation?.animationName ||
+        animation?.transitionProperty ||
+        event.animationName ||
+        event.propertyName ||
+        'animation';
+      const playState = animation?.playState || event.type;
+      const pseudo = animation?.effect?.pseudoElement || '';
+
+      document.body.setAttribute(
+        'data-last-animation-state',
+        `${event.type}:${name}${pseudo}:${playState}`
+      );
+    }
+
+    const ANIMATION_AND_TRANSITION_EVENTS = [
+      'animationstart',
+      'animationiteration',
+      'animationend',
+      'animationcancel',
+      'transitionrun',
+      'transitionstart',
+      'transitionend',
+      'transitioncancel',
+    ];
+
+    for (const eventName of ANIMATION_AND_TRANSITION_EVENTS) {
+      document.addEventListener(eventName, updateLastAnimationState, true);
+    }
+
+    // 2. Daily-Roast Banner Pause / Resume Control
+    const roastTrack = document.getElementById('daily-roast-track');
+    const roastToggleBtn = document.getElementById('roast-banner-toggle');
+    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function setBannerPaused(paused) {
+      if (!roastTrack || !roastToggleBtn) return;
+
+      roastTrack.setAttribute('data-paused', paused ? 'true' : 'false');
+      roastToggleBtn.setAttribute('aria-pressed', paused ? 'true' : 'false');
+      roastToggleBtn.textContent = paused ? 'Resume' : 'Pause';
+      roastToggleBtn.setAttribute(
+        'aria-label',
+        paused
+          ? 'Resume daily roast banner animation'
+          : 'Pause daily roast banner animation'
+      );
+
+      for (const anim of roastTrack.getAnimations()) {
+        if (paused) {
+          anim.pause();
+        } else {
+          anim.play();
+        }
+      }
+
+      document.body.setAttribute(
+        'data-last-animation-state',
+        `daily-roast-marquee:${paused ? 'paused' : 'running'}`
+      );
+    }
+
+    if (reducedMotionQuery.matches) {
+      setBannerPaused(true);
+    }
+
+    reducedMotionQuery.addEventListener('change', (e) => {
+      setBannerPaused(e.matches);
+    });
+
+    roastToggleBtn?.addEventListener('click', () => {
+      const isCurrentlyPaused = roastTrack?.getAttribute('data-paused') === 'true';
+      setBannerPaused(!isCurrentlyPaused);
+    });
+
+    // 3. Top-Layer Animated Drink-Details Dialog
+    const dialog = document.getElementById('drink-details-dialog');
+    const dialogTitle = document.getElementById('drink-dialog-title');
+    const dialogBadge = document.getElementById('drink-dialog-badge');
+    const dialogDesc = document.getElementById('drink-dialog-description');
+    const dialogRoast = document.getElementById('drink-dialog-roast');
+    const dialogNotes = document.getElementById('drink-dialog-notes');
+    const dialogCaffeine = document.getElementById('drink-dialog-caffeine');
+    const dialogLink = document.getElementById('drink-dialog-link');
+    const dialogImage = document.getElementById('drink-dialog-image');
+    const dialogCloseBtn = document.getElementById('drink-dialog-close');
+
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return false;
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    function supportsTopLayerExit() {
+      return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+    }
+
+    async function closeTopLayer(element) {
+      if (!element || !element.open) return;
+
+      if (!supportsTopLayerExit()) {
+        element.setAttribute('data-closing', '');
+        const animations = element.getAnimations({ subtree: true });
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+        if (!element.hasAttribute('data-closing')) return;
+        element.removeAttribute('data-closing');
+      }
+
+      element.close();
+    }
+
+    function openDrinkDetails(drinkKey) {
+      const details = DRINK_DETAILS[drinkKey];
+      if (!details || !dialog) return;
+
+      dialog.removeAttribute('data-closing');
+      dialogTitle.textContent = details.title;
+      dialogBadge.textContent = details.badge;
+      dialogDesc.textContent = details.description;
+      dialogRoast.textContent = details.roast;
+      dialogNotes.textContent = details.notes;
+      dialogCaffeine.textContent = details.caffeine;
+      dialogLink.setAttribute('href', details.href);
+      dialogImage.setAttribute('src', details.image);
+      dialogImage.setAttribute('alt', details.title);
+
+      if (!dialog.open) {
+        dialog.showModal();
+      }
+    }
+
+    for (const button of document.querySelectorAll('.view-details-btn')) {
+      button.addEventListener('click', () => {
+        openDrinkDetails(button.dataset.drink);
+      });
+    }
+
+    dialogCloseBtn?.addEventListener('click', () => {
+      closeTopLayer(dialog);
+    });
+
+    dialog?.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeTopLayer(dialog);
+    });
+
+    // Fallback for browsers without <dialog closedby="any"> support
+    if (typeof HTMLDialogElement !== 'undefined' && !('closedBy' in HTMLDialogElement.prototype)) {
+      const isOutsideDialog = (e, dlg) => {
+        const r = dlg.getBoundingClientRect();
+        return (
+          e.clientX < r.left ||
+          e.clientX > r.right ||
+          e.clientY < r.top ||
+          e.clientY > r.bottom
+        );
+      };
+
+      let pressedOutside = false;
+      dialog?.addEventListener('pointerdown', (e) => {
+        pressedOutside = isOutsideDialog(e, dialog);
+      });
+      dialog?.addEventListener('pointerup', (e) => {
+        if (pressedOutside && isOutsideDialog(e, dialog)) {
+          closeTopLayer(dialog);
+        }
+      });
+    }
+  </script>
 </body>
 
 </html>
