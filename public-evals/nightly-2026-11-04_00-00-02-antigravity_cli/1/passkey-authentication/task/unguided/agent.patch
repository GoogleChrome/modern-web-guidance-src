+  <script>
+    (function () {
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const authStatus = document.querySelector('[data-testid="auth-status"]');
+      let conditionalAbortController = null;
+
+      function bufferToBase64Url(buffer) {
+        if (!buffer) return null;
+        const bytes = new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary)
+          .replace(/\+/g, '-')
+          .replace(/\//g, '_')
+          .replace(/=+$/g, '');
+      }
+
+      function serializeCredential(credential) {
+        if (credential && typeof credential.toJSON === 'function') {
+          return credential.toJSON();
+        }
+        const response = credential.response || {};
+        return {
+          id: credential.id,
+          rawId: bufferToBase64Url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment || null,
+          clientExtensionResults:
+            typeof credential.getClientExtensionResults === 'function'
+              ? credential.getClientExtensionResults()
+              : {},
+          response: {
+            clientDataJSON: bufferToBase64Url(response.clientDataJSON),
+            authenticatorData: bufferToBase64Url(response.authenticatorData),
+            signature: bufferToBase64Url(response.signature),
+            userHandle: response.userHandle ? bufferToBase64Url(response.userHandle) : null
+          }
+        };
+      }
+
+      function getPublicKeyOptions() {
+        const challenge = new Uint8Array(32);
+        if (window.crypto && window.crypto.getRandomValues) {
+          window.crypto.getRandomValues(challenge);
+        }
+        return {
+          challenge: challenge,
+          rpId: window.location.hostname || 'localhost',
+          timeout: 60000,
+          userVerification: 'preferred'
+        };
+      }
+
+      async function verifyCredential(credential) {
+        if (!credential) return;
+        const payload = serializeCredential(credential);
+        const res = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json'
+          },
+          body: JSON.stringify(payload)
+        });
+
+        let data = {};
+        try {
+          data = await res.json();
+        } catch (err) {
+          // Ignore non-JSON response body
+        }
+
+        if (res.ok) {
+          authStatus.textContent = data.message || data.status || 'Authenticated successfully!';
+        } else {
+          authStatus.textContent = data.error || data.message || 'Authentication failed';
+        }
+      }
+
+      async function startConditionalAuthentication() {
+        if (
+          typeof window.PublicKeyCredential === 'undefined' ||
+          !navigator.credentials ||
+          !navigator.credentials.get
+        ) {
+          return;
+        }
+
+        try {
+          if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+            const available = await PublicKeyCredential.isConditionalMediationAvailable();
+            if (!available) return;
+          }
+
+          if (conditionalAbortController) {
+            conditionalAbortController.abort();
+          }
+          conditionalAbortController = new AbortController();
+
+          const credential = await navigator.credentials.get({
+            mediation: 'conditional',
+            publicKey: getPublicKeyOptions(),
+            signal: conditionalAbortController.signal
+          });
+
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          if (err && err.name === 'AbortError') {
+            return;
+          }
+        }
+      }
+
+      async function startModalAuthentication() {
+        if (!navigator.credentials || !navigator.credentials.get) {
+          authStatus.textContent = 'WebAuthn is not supported in this browser.';
+          return;
+        }
+
+        try {
+          if (conditionalAbortController) {
+            conditionalAbortController.abort();
+            conditionalAbortController = null;
+          }
+
+          const publicKey = getPublicKeyOptions();
+          publicKey.userVerification = 'required';
+
+          const credential = await navigator.credentials.get({
+            publicKey: publicKey
+          });
+
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          authStatus.textContent = (err && err.message) ? err.message : 'Authentication cancelled or failed.';
+        }
+      }
+
+      if (authButton) {
+        authButton.addEventListener('click', startModalAuthentication);
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', startConditionalAuthentication);
+      } else {
+        startConditionalAuthentication();
+      }
+    })();
+  </script>
+
 </body>
 
