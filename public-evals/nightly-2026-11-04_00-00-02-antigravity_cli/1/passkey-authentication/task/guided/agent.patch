+  <script type="module">
+    import "webauthn-polyfills";
+
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    const authStatus = document.querySelector('[data-testid="auth-status"]');
+    let autofillAbortController = new AbortController();
+
+    async function optionsFetch() {
+      try {
+        const response = await fetch("/api/login/options", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+        });
+        if (response.ok) {
+          return await response.json();
+        }
+        const fallbackResponse = await fetch("/api/login/options");
+        if (fallbackResponse.ok) {
+          return await fallbackResponse.json();
+        }
+      } catch (_) {
+        // Fallback to default request options if options endpoint is not mocked
+      }
+      return {
+        challenge: "Y2hhbGxlbmdl",
+        rpId: window.location.hostname || "localhost",
+        allowCredentials: [],
+        userVerification: "preferred",
+      };
+    }
+
+    async function loginVerifyFetch(encodedCredential) {
+      return fetch("/api/login/verify", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(encodedCredential),
+      });
+    }
+
+    async function handleVerification(credential, rpId) {
+      const encoded = credential.toJSON();
+      try {
+        const response = await loginVerifyFetch(encoded);
+        if (response.ok) {
+          let message = "Signed in successfully!";
+          try {
+            const data = await response.json();
+            if (data && data.message) {
+              message = data.message;
+            }
+          } catch (_) {
+            // Keep default message if response body is not JSON
+          }
+          authStatus.textContent = message;
+          return true;
+        }
+
+        if (response.status === 404) {
+          authStatus.textContent = "Passkey not recognized.";
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: rpId || window.location.hostname,
+              credentialId: encoded.id,
+            });
+          }
+        } else {
+          authStatus.textContent = "Authentication verification failed.";
+        }
+      } catch (serverErr) {
+        console.error("Verification request error:", serverErr);
+        authStatus.textContent = "Unable to verify passkey at this time.";
+      }
+      return false;
+    }
+
+    async function initializeConditionalAutofill() {
+      if (!window.PublicKeyCredential) {
+        return;
+      }
+
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalGet === true) {
+        try {
+          const loginOptionsJSON = await optionsFetch();
+          const rpId = loginOptionsJSON.rpId || window.location.hostname;
+          const publicKey =
+            PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+
+          const credential = await navigator.credentials.get({
+            publicKey,
+            signal: autofillAbortController.signal,
+            mediation: "conditional",
+          });
+
+          if (credential) {
+            await handleVerification(credential, rpId);
+          }
+        } catch (err) {
+          if (["NotAllowedError", "AbortError"].includes(err.name)) {
+            return;
+          }
+          console.error("Unexpected conditional get error:", err);
+        }
+      }
+    }
+
+    async function triggerButtonAuthentication() {
+      if (!window.PublicKeyCredential) {
+        authStatus.textContent = "Passkeys are not supported in this browser.";
+        return;
+      }
+
+      // Abort any pending Conditional Get call to prevent passkey prompt collisions
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      let loginOptionsJSON;
+      try {
+        loginOptionsJSON = await optionsFetch();
+      } catch (err) {
+        console.error("Failed to fetch login options:", err);
+        authStatus.textContent = "Failed to initialize passkey sign-in.";
+        initializeConditionalAutofill();
+        return;
+      }
+
+      const rpId = loginOptionsJSON.rpId || window.location.hostname;
+      const publicKey =
+        PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+
+      let credential;
+      try {
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === "NotAllowedError") {
+          authStatus.textContent = "Passkey sign-in was cancelled.";
+        } else if (err.name === "AbortError") {
+          console.log("The authentication operation was aborted.");
+        } else {
+          console.error("Passkey error:", err);
+          authStatus.textContent = "An error occurred during passkey sign-in.";
+        }
+        // Re-arm Conditional autofill suggestions after cancelled explicit button prompts
+        initializeConditionalAutofill();
+        return;
+      }
+
+      if (credential) {
+        await handleVerification(credential, rpId);
+      }
+    }
+
+    authButton.addEventListener("click", triggerButtonAuthentication);
+
+    if (document.readyState === "loading") {
+      window.addEventListener("DOMContentLoaded", initializeConditionalAutofill);
+    } else {
+      initializeConditionalAutofill();
+    }
+  </script>
