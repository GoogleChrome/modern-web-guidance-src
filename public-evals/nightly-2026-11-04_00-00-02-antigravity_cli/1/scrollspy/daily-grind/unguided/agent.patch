+  <script>
+    (function () {
+      const nav = document.querySelector('nav');
+      const navLinks = Array.from(document.querySelectorAll('nav ul a[href^="#"]'));
+      const sections = navLinks
+        .map((link) => {
+          const id = link.getAttribute('href').slice(1);
+          return document.getElementById(id);
+        })
+        .filter(Boolean);
+
+      function setActiveSection(activeId) {
+        navLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === '#' + activeId;
+          link.classList.toggle('active', isMatch);
+          if (link.parentElement && link.parentElement.tagName === 'LI') {
+            link.parentElement.classList.toggle('active', isMatch);
+          }
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function updateActiveNav() {
+        if (!sections.length) return;
+
+        const navHeight = nav ? nav.offsetHeight : 60;
+        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
+
+        const scrollBottom = window.scrollY + viewportHeight;
+        const docHeight = document.documentElement.scrollHeight;
+        if (docHeight - scrollBottom <= 10) {
+          const lastSection = sections[sections.length - 1];
+          const lastRect = lastSection.getBoundingClientRect();
+          if (lastRect.top < viewportHeight && lastRect.bottom > navHeight) {
+            setActiveSection(lastSection.id);
+            return;
+          }
+        }
+
+        const triggerLine = navHeight + Math.min(120, (viewportHeight - navHeight) * 0.25);
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          if (rect.top <= triggerLine && rect.bottom > triggerLine) {
+            setActiveSection(section.id);
+            return;
+          }
+        }
+
+        let bestSectionId = sections[0].id;
+        let maxVisibleHeight = -1;
+
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          const visibleTop = Math.max(rect.top, navHeight);
+          const visibleBottom = Math.min(rect.bottom, viewportHeight);
+          const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+          if (visibleHeight > maxVisibleHeight) {
+            maxVisibleHeight = visibleHeight;
+            bestSectionId = section.id;
+          }
+        }
+
+        setActiveSection(bestSectionId);
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          () => {
+            updateActiveNav();
+          },
+          {
+            threshold: [0, 0.1, 0.25, 0.5, 0.75, 1]
+          }
+        );
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      navLinks.forEach((link) => {
+        link.addEventListener('click', () => {
+          const targetId = link.getAttribute('href').slice(1);
+          setActiveSection(targetId);
+          requestAnimationFrame(updateActiveNav);
+        });
+      });
+
+      window.addEventListener('scroll', updateActiveNav, { passive: true });
+      window.addEventListener('resize', updateActiveNav);
+      window.addEventListener('hashchange', updateActiveNav);
+      document.addEventListener('DOMContentLoaded', updateActiveNav);
+      updateActiveNav();
+    })();
+  </script>
+
 </body>
 
