diff --git a/src/components/SectionNav.tsx b/src/components/SectionNav.tsx
new file mode 100644
index 0000000..88103b8
--- /dev/null
+++ b/src/components/SectionNav.tsx
@@ -0,0 +1,320 @@
+import React, { useEffect, useState, useCallback, useRef } from 'react';
+
+export interface PageSection {
+  id: string;
+  title: string;
+  category?: string;
+}
+
+interface SectionNavProps {
+  initialSections?: PageSection[];
+  activeSectionId: string | null;
+  sections: PageSection[];
+  onSelectSection: (id: string) => void;
+}
+
+function slugify(text: string): string {
+  return text
+    .toLowerCase()
+    .trim()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/(^-|-$)/g, '');
+}
+
+/**
+ * Discovers navigable sections in the current page DOM.
+ * Looks for elements with `data-section-title`, `<section id="...">` with headings,
+ * and prose headings (`h2`, `h3`) inside `<main>`.
+ */
+export function discoverPageSections(): { sections: PageSection[]; elements: HTMLElement[] } {
+  if (typeof document === 'undefined') {
+    return { sections: [], elements: [] };
+  }
+
+  const discovered: { section: PageSection; element: HTMLElement }[] = [];
+  const seenIds = new Set<string>();
+  const seenElements = new Set<HTMLElement>();
+
+  const registerElement = (el: HTMLElement, title: string, category?: string) => {
+    const cleanTitle = title.trim();
+    if (!cleanTitle || seenElements.has(el)) return;
+
+    let id = el.id || slugify(cleanTitle);
+    if (!id) return;
+
+    if (seenIds.has(id)) {
+      let counter = 2;
+      while (seenIds.has(`${id}-${counter}`)) {
+        counter++;
+      }
+      id = `${id}-${counter}`;
+    }
+
+    if (!el.id) {
+      el.id = id;
+    }
+
+    seenIds.add(id);
+    seenElements.add(el);
+    discovered.push({
+      section: {
+        id,
+        title: cleanTitle,
+        category: category || el.getAttribute('data-section-category') || undefined,
+      },
+      element: el,
+    });
+  };
+
+  // 1. Explicit [data-section-title] elements inside main (or document)
+  const explicitEls = document.querySelectorAll<HTMLElement>('main [data-section-title], [data-section-title]');
+  explicitEls.forEach((el) => {
+    const title = el.getAttribute('data-section-title');
+    if (title) {
+      registerElement(el, title);
+    }
+  });
+
+  // 2. Headings inside article/legal prose content (h2, h3)
+  const proseHeadings = document.querySelectorAll<HTMLElement>('main .prose h2, main .prose h3');
+  proseHeadings.forEach((heading) => {
+    // Skip if this heading is the direct title of an already registered section
+    const parentSection = heading.closest<HTMLElement>('[data-section-title]');
+    if (parentSection && parentSection !== heading && parentSection.getAttribute('data-section-title') === heading.textContent?.trim()) {
+      return;
+    }
+    registerElement(heading, heading.textContent || '');
+  });
+
+  // 3. Fallback: any <section> inside <main> that has an <h2> or id
+  if (discovered.length === 0) {
+    const mainSections = document.querySelectorAll<HTMLElement>('main section');
+    mainSections.forEach((sec) => {
+      const heading = sec.querySelector('h1, h2, h3');
+      const title = sec.getAttribute('aria-label') || heading?.textContent || '';
+      if (title.trim()) {
+        registerElement(sec, title);
+      }
+    });
+  }
+
+  // Sort in DOM order
+  discovered.sort((a, b) => {
+    if (a.element === b.element) return 0;
+    const pos = a.element.compareDocumentPosition(b.element);
+    return pos & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;
+  });
+
+  return {
+    sections: discovered.map((d) => d.section),
+    elements: discovered.map((d) => d.element),
+  };
+}
+
+/**
+ * Hook that discovers sections on the page and tracks which section is currently visible
+ * using both IntersectionObserver and scroll position geometry.
+ */
+export function useActiveSection(initialSections: PageSection[] = []) {
+  const [sections, setSections] = useState<PageSection[]>(initialSections);
+  const [activeSectionId, setActiveSectionId] = useState<string | null>(
+    initialSections.length > 0 ? initialSections[0].id : null
+  );
+  const manualLockRef = useRef<number>(0);
+
+  const computeVisibleSection = useCallback((elements: HTMLElement[]) => {
+    if (elements.length === 0 || typeof window === 'undefined') return;
+
+    // Respect brief lock after clicking a nav item so smooth scrolling doesn't flicker
+    if (Date.now() < manualLockRef.current) return;
+
+    const stickyHeader = document.querySelector('header');
+    const headerOffset = stickyHeader ? stickyHeader.getBoundingClientRect().height : 120;
+    const readingLine = Math.max(headerOffset + 40, 140);
+    const viewportHeight = window.innerHeight;
+
+    // Check if scrolled to the very bottom of the page
+    const isAtBottom =
+      window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 24;
+    if (isAtBottom && window.scrollY > 50) {
+      for (let i = elements.length - 1; i >= 0; i--) {
+        const rect = elements[i].getBoundingClientRect();
+        if (rect.top < viewportHeight && rect.bottom > headerOffset) {
+          setActiveSectionId(elements[i].id);
+          return;
+        }
+      }
+    }
+
+    // Find the last section whose top has crossed the reading line
+    let candidate: HTMLElement | null = null;
+    for (const el of elements) {
+      const rect = el.getBoundingClientRect();
+      if (rect.top <= readingLine) {
+        candidate = el;
+      } else {
+        break;
+      }
+    }
+
+    // If no section has crossed the reading line yet (e.g. at top of page), pick the first visible section
+    if (!candidate) {
+      candidate =
+        elements.find((el) => {
+          const rect = el.getBoundingClientRect();
+          return rect.bottom > 0 && rect.top < viewportHeight;
+        }) || elements[0];
+    }
+
+    if (candidate && candidate.id) {
+      setActiveSectionId(candidate.id);
+    }
+  }, []);
+
+  const selectSection = useCallback((id: string) => {
+    setActiveSectionId(id);
+    manualLockRef.current = Date.now() + 650;
+
+    if (typeof document !== 'undefined') {
+      const target = document.getElementById(id);
+      if (target) {
+        const stickyHeader = document.querySelector('header');
+        const headerOffset = stickyHeader ? stickyHeader.getBoundingClientRect().height + 16 : 120;
+        const top = target.getBoundingClientRect().top + window.scrollY - headerOffset;
+
+        window.scrollTo({
+          top: Math.max(0, top),
+          behavior: 'smooth',
+        });
+
+        if (window.history?.replaceState) {
+          window.history.replaceState(null, '', `#${id}`);
+        }
+      }
+    }
+  }, []);
+
+  useEffect(() => {
+    let observer: IntersectionObserver | null = null;
+    let currentElements: HTMLElement[] = [];
+
+    const setup = () => {
+      if (observer) {
+        observer.disconnect();
+      }
+
+      const { sections: domSections, elements } = discoverPageSections();
+      currentElements = elements;
+
+      if (domSections.length > 0) {
+        setSections(domSections);
+      }
+
+      if (elements.length === 0) return;
+
+      // Check initial URL hash if present
+      const hash = window.location.hash.replace(/^#/, '');
+      if (hash && domSections.some((s) => s.id === hash)) {
+        setActiveSectionId(hash);
+      } else {
+        computeVisibleSection(elements);
+      }
+
+      observer = new IntersectionObserver(
+        () => {
+          computeVisibleSection(currentElements);
+        },
+        {
+          root: null,
+          rootMargin: '-10% 0px -25% 0px',
+          threshold: [0, 0.1, 0.25, 0.5, 0.75, 1],
+        }
+      );
+
+      elements.forEach((el) => observer?.observe(el));
+    };
+
+    const handleScroll = () => {
+      computeVisibleSection(currentElements);
+    };
+
+    setup();
+
+    window.addEventListener('scroll', handleScroll, { passive: true });
+    window.addEventListener('resize', handleScroll, { passive: true });
+    document.addEventListener('astro:page-load', setup);
+
+    return () => {
+      if (observer) {
+        observer.disconnect();
+      }
+      window.removeEventListener('scroll', handleScroll);
+      window.removeEventListener('resize', handleScroll);
+      document.removeEventListener('astro:page-load', setup);
+    };
+  }, [computeVisibleSection]);
+
+  return {
+    sections,
+    activeSectionId,
+    selectSection,
+  };
+}
+
+const SectionNav: React.FC<SectionNavProps> = ({
+  sections,
+  activeSectionId,
+  onSelectSection,
+}) => {
+  if (!sections || sections.length === 0) {
+    return null;
+  }
+
+  return (
+    <div className="bg-gray-50 border-b border-gray-200">
+      <nav
+        aria-label="Page sections"
+        data-testid="section-nav"
+        className="container mx-auto px-4 flex items-center justify-center space-x-2 sm:space-x-6 h-9 overflow-x-auto text-xs sm:text-sm"
+      >
+        <span className="text-[11px] font-semibold uppercase tracking-wider text-gray-400 whitespace-nowrap hidden sm:inline">
+          On this page:
+        </span>
+        <ul className="flex items-center space-x-1 sm:space-x-3 h-full">
+          {sections.map((section) => {
+            const isActive = activeSectionId === section.id;
+            return (
+              <li key={section.id} className="h-full flex items-center">
+                <a
+                  href={`#${section.id}`}
+                  data-section-link={section.id}
+                  data-active={isActive ? 'true' : 'false'}
+                  aria-current={isActive ? 'location' : undefined}
+                  onClick={(e) => {
+                    e.preventDefault();
+                    onSelectSection(section.id);
+                  }}
+                  className={`h-full flex items-center px-2.5 border-b-2 transition-colors whitespace-nowrap ${
+                    isActive
+                      ? 'active border-amber-500 text-amber-600 font-bold bg-amber-50/70'
+                      : 'border-transparent text-gray-600 font-medium hover:text-gray-900 hover:border-gray-300'
+                  }`}
+                >
+                  <span
+                    className={`w-1.5 h-1.5 rounded-full mr-1.5 transition-opacity ${
+                      isActive ? 'bg-amber-500 opacity-100' : 'bg-transparent opacity-0'
+                    }`}
+                    aria-hidden="true"
+                  />
+                  {section.title}
+                </a>
+              </li>
+            );
+          })}
+        </ul>
+      </nav>
+    </div>
+  );
+};
+
+export default SectionNav;
