+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Our Story | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css" blocking="render">
+  <style blocking="render">
+    @view-transition {
+      navigation: auto;
+    }
+
+    :root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+    }
+
+    [data-theme="dark"] {
+      --primary: #3e2723;
+      --secondary: #4e342e;
+      --accent: #ffab40;
+      --text: #f5f5f5;
+      --light: #1e1411;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+    }
+
+    /* Navigation */
+    nav {
+      view-transition-name: site-nav;
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+    }
+
+    .logo {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    .logo a {
+      color: white;
+      text-decoration: none;
+      font-size: inherit;
+    }
+
+    nav ul {
+      display: flex;
+      list-style: none;
+    }
+
+    nav ul li {
+      margin-left: 20px;
+    }
+
+    nav a {
+      color: white;
+      text-decoration: none;
+      font-size: 0.9rem;
+      transition: color 0.3s;
+    }
+
+    nav a:hover,
+    nav a[aria-current="page"] {
+      color: var(--accent);
+    }
+
+    .logout-link {
+      border: 1px solid var(--accent);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+
+    /* Hero Section */
+    .hero {
+      view-transition-name: hero-banner;
+      height: 60vh;
+      background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+        url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: white;
+      text-align: center;
+      padding: 0 20px;
+    }
+
+    .hero h1 {
+      font-size: 3rem;
+      margin-bottom: 1rem;
+    }
+
+    /* Content Sections */
+    .container {
+      view-transition-name: main-section;
+      max-width: 1100px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+      gap: 20px;
+      margin-top: 20px;
+    }
+
+    .card {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    .card h3 {
+      margin-bottom: 10px;
+      color: var(--primary);
+    }
+
+    .price {
+      display: block;
+      font-weight: bold;
+      color: var(--primary);
+      margin-top: 10px;
+      font-size: 1.1rem;
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    footer {
+      background: var(--secondary);
+      text-align: center;
+      padding: 40px 20px;
+      margin-top: 40px;
+    }
+
+    .footer-links {
+      margin-bottom: 20px;
+    }
+
+    .footer-links a {
+      margin: 0 10px;
+      color: var(--text);
+      text-decoration: none;
+      font-size: 0.85rem;
+    }
+  </style>
+  <script src="/theme.js" blocking="render"></script>
+  <script blocking="render">
+    document.documentElement.dataset.theme = document.documentElement.dataset.theme || 'light';
+    document.documentElement.dataset.layout = 'ready';
+  </script>
+  <link rel="expect" href="#hero" blocking="render">
+  <link rel="expect" href="#seasonal-favorites" blocking="render">
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo"><a href="/">THE DAILY GRIND</a></div>
+    <ul>
+      <li><a href="/">Home</a></li>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header id="hero" class="hero">
+    <h1>Our Craft &amp; Story</h1>
+    <p>Direct-trade partnerships with sustainable farms since 2016.</p>
+    <a href="/menu" class="btn">Explore Our Menu</a>
+  </header>
+
+  <main class="container">
+    <section id="seasonal-favorites">
+      <h2 style="text-align: center;">Seasonal Favorites</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Ethically Sourced</h3>
+          <p>100% direct-trade Arabica beans from family-owned micro-lots.</p>
+          <a href="/menu" class="btn">See Roasts</a>
+        </div>
+        <div class="card">
+          <h3>Locally Roasted</h3>
+          <p>Roasted fresh every morning at our Downtown Roastery.</p>
+          <a href="/locations" class="btn">Visit Us</a>
+        </div>
+        <div class="card">
+          <h3>Zero-Waste Packaging</h3>
+          <p>Compostable cups and reusable glass jar exchanges.</p>
+          <a href="/rewards" class="btn">Earn Rewards</a>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
