+(function initThemeAndLayout() {
+  try {
+    var root = document.documentElement;
+    var savedTheme = null;
+    try {
+      savedTheme = window.localStorage ? window.localStorage.getItem('daily-grind-theme') : null;
+    } catch (_) {}
+    var theme = savedTheme || 'light';
+    root.setAttribute('data-theme', theme);
+    root.setAttribute('data-layout', 'ready');
+  } catch (_) {}
+})();
