     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Register service worker for PWA installation and origin migration support
+    if ('serviceWorker' in navigator) {
+      window.addEventListener('load', () => {
+        navigator.serviceWorker.register('/sw.js').catch(() => {});
+      });
+    }
+
+    // Preserve and transfer client-side user configuration across origins
+    (function migrateUserConfiguration() {
+      const CONFIG_KEY = 'daily_grind_user_config';
+      const ALLOWED_ORIGINS = [
+        'https://old.dailygrind.com',
+        'https://app.dailygrind.com'
+      ];
+
+      // 1. Import configuration passed via URL migration payload if present
+      const params = new URLSearchParams(window.location.search);
+      const encodedConfig = params.get('migrated_config');
+      if (encodedConfig) {
+        try {
+          const parsed = JSON.parse(atob(encodedConfig));
+          if (parsed && typeof parsed === 'object') {
+            const existing = JSON.parse(localStorage.getItem(CONFIG_KEY) || '{}');
+            localStorage.setItem(CONFIG_KEY, JSON.stringify({ ...existing, ...parsed }));
+          }
+          params.delete('migrated_config');
+          const cleanUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '') + window.location.hash;
+          window.history.replaceState({}, document.title, cleanUrl);
+        } catch (err) {
+          console.warn('Failed to import migrated user configuration:', err);
+        }
+      }
+
+      // 2. Listen for cross-origin configuration sync messages
+      window.addEventListener('message', (event) => {
+        if (!ALLOWED_ORIGINS.includes(event.origin) && event.origin !== window.location.origin) {
+          return;
+        }
+        if (event.data && event.data.type === 'REQUEST_USER_CONFIG') {
+          const config = JSON.parse(localStorage.getItem(CONFIG_KEY) || '{}');
+          event.source.postMessage({ type: 'USER_CONFIG_PAYLOAD', config }, event.origin);
+        } else if (event.data && event.data.type === 'USER_CONFIG_PAYLOAD' && event.data.config) {
+          const existing = JSON.parse(localStorage.getItem(CONFIG_KEY) || '{}');
+          localStorage.setItem(CONFIG_KEY, JSON.stringify({ ...existing, ...event.data.config }));
+        }
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
