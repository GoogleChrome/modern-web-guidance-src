+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_user_config';
+      const NEW_ORIGIN = 'https://new-app.dailygrind.example.com';
+      const OLD_ORIGIN = 'https://old-app.dailygrind.example.com';
+
+      // Import migrated configuration if present in URL hash or cross-origin message
+      const params = new URLSearchParams(window.location.hash.slice(1));
+      const migratedConfig = params.get('migrated_config');
+      if (migratedConfig) {
+        try {
+          const parsed = JSON.parse(atob(migratedConfig));
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(parsed));
+          history.replaceState(null, '', window.location.pathname + window.location.search);
+        } catch (err) {
+          console.error('Failed to restore migrated configuration:', err);
+        }
+      }
+
+      window.addEventListener('message', (event) => {
+        if (event.origin === OLD_ORIGIN && event.data && event.data.type === 'MIGRATE_USER_CONFIG') {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(event.data.payload));
+        }
+      });
+
+      // Attach current user config to the manual migration fallback link
+      const migrateLink = document.getElementById('migrate-origin-link');
+      if (migrateLink) {
+        migrateLink.addEventListener('click', () => {
+          const rawConfig = localStorage.getItem(STORAGE_KEY);
+          if (rawConfig) {
+            const encoded = btoa(rawConfig);
+            migrateLink.href = `${NEW_ORIGIN}/#migrated_config=${encodeURIComponent(encoded)}`;
+          }
+        });
+      }
+
+      // Allow dismissing the manual reinstallation fallback prompt
+      const banner = document.getElementById('origin-migration-banner');
+      const dismissBtn = document.getElementById('dismiss-migration-banner');
+      if (banner && dismissBtn) {
+        if (window.location.origin === NEW_ORIGIN || sessionStorage.getItem('migration_banner_dismissed') === '1') {
+          banner.hidden = true;
+        }
+        dismissBtn.addEventListener('click', () => {
+          banner.hidden = true;
+          sessionStorage.setItem('migration_banner_dismissed', '1');
+        });
+      }
+    })();
+  </script>
 </body>
 
