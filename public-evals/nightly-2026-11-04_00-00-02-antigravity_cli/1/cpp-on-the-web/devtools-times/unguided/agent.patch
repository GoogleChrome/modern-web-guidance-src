index 0000000..9647f5e
--- /dev/null
+++ b/src/components/SmallptPathTracer.tsx
@@ -0,0 +1,249 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SphereColorInfo {
+  index: number;
+  name: string;
+  rgb: [number, number, number];
+}
+
+const SPHERE_LABELS: { index: number; name: string }[] = [
+  { index: 0, name: 'Left Wall' },
+  { index: 1, name: 'Right Wall' },
+  { index: 2, name: 'Back Wall' },
+  { index: 4, name: 'Floor' },
+  { index: 5, name: 'Ceiling' },
+  { index: 6, name: 'Mirror Sphere' },
+  { index: 7, name: 'Glass Sphere' },
+];
+
+const WIDTH = 320;
+const HEIGHT = 240;
+const SAMPLES_PER_SUBPIXEL = 2; // 2x2 subpixels * 2 = 8 spp per pass
+
+export default function SmallptPathTracer() {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const wasmModuleRef = useRef<any>(null);
+  const renderJobIdRef = useRef<number>(0);
+
+  const [isLoadingWasm, setIsLoadingWasm] = useState<boolean>(true);
+  const [isRendering, setIsRendering] = useState<boolean>(false);
+  const [progress, setProgress] = useState<number>(0);
+  const [renderTimeMs, setRenderTimeMs] = useState<number | null>(null);
+  const [sphereColors, setSphereColors] = useState<SphereColorInfo[]>([]);
+  const [errorMsg, setErrorMsg] = useState<string | null>(null);
+
+  const readCurrentSphereColors = useCallback((mod: any) => {
+    const list: SphereColorInfo[] = SPHERE_LABELS.map(({ index, name }) => {
+      const r = Math.round(mod._get_sphere_color_channel(index, 0) * 255);
+      const g = Math.round(mod._get_sphere_color_channel(index, 1) * 255);
+      const b = Math.round(mod._get_sphere_color_channel(index, 2) * 255);
+      return { index, name, rgb: [r, g, b] };
+    });
+    setSphereColors(list);
+  }, []);
+
+  const runPathTracer = useCallback(
+    async (randomize: boolean) => {
+      const mod = wasmModuleRef.current;
+      const canvas = canvasRef.current;
+      if (!mod || !canvas) return;
+
+      const jobId = ++renderJobIdRef.current;
+      setIsRendering(true);
+      setProgress(0);
+
+      if (randomize) {
+        const seed = Math.floor(Math.random() * 0xffffffff) >>> 0;
+        mod._randomize_sphere_colors(seed);
+      }
+      readCurrentSphereColors(mod);
+
+      const ctx = canvas.getContext('2d');
+      if (!ctx) return;
+
+      const startTime = performance.now();
+      mod._init_render(WIDTH, HEIGHT);
+
+      const chunkHeight = 20;
+      for (let y = 0; y < HEIGHT; y += chunkHeight) {
+        if (renderJobIdRef.current !== jobId) return;
+
+        const endY = Math.min(y + chunkHeight, HEIGHT);
+        const ptr = mod._render_rows(WIDTH, HEIGHT, y, endY, SAMPLES_PER_SUBPIXEL, 1);
+
+        const pixels = new Uint8ClampedArray(
+          mod.HEAPU8.buffer,
+          ptr,
+          WIDTH * HEIGHT * 4
+        );
+        const imageData = new ImageData(
+          new Uint8ClampedArray(pixels),
+          WIDTH,
+          HEIGHT
+        );
+        ctx.putImageData(imageData, 0, 0);
+        setProgress(Math.round((endY / HEIGHT) * 100));
+
+        // Yield to keep the browser UI responsive and show scanline progress
+        await new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      if (renderJobIdRef.current === jobId) {
+        setRenderTimeMs(Math.round(performance.now() - startTime));
+        setIsRendering(false);
+      }
+    },
+    [readCurrentSphereColors]
+  );
+
+  useEffect(() => {
+    let cancelled = false;
+
+    async function loadWasm() {
+      try {
+        const baseUrl = import.meta.env.BASE_URL || '/';
+        const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+        const jsUrl = `${normalizedBase}smallpt.js`;
+        const wasmUrl = `${normalizedBase}smallpt.wasm`;
+
+        const modFactory = await import(/* @vite-ignore */ jsUrl);
+        const createModule = modFactory.default || modFactory;
+        const mod = await createModule({
+          locateFile: (path: string) => {
+            if (path.endsWith('.wasm')) return wasmUrl;
+            return path;
+          },
+        });
+
+        if (cancelled) return;
+        wasmModuleRef.current = mod;
+        setIsLoadingWasm(false);
+        runPathTracer(false);
+      } catch (err: any) {
+        if (!cancelled) {
+          console.error('Failed to initialize smallpt WebAssembly module:', err);
+          setErrorMsg(err?.message || 'Failed to load WebAssembly module');
+          setIsLoadingWasm(false);
+        }
+      }
+    }
+
+    loadWasm();
+    return () => {
+      cancelled = true;
+      renderJobIdRef.current++;
+    };
+  }, [runPathTracer]);
+
+  return (
+    <section
+      id="smallpt-wasm-section"
+      className="my-6 bg-white border border-gray-300 rounded-lg shadow-sm p-6"
+    >
+      <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-gray-200 pb-4 mb-6">
+        <div>
+          <span className="text-xs font-bold uppercase tracking-wider text-amber-700 bg-amber-100 px-2.5 py-1 rounded">
+            Interactive WebAssembly Demo
+          </span>
+          <h2 className="text-2xl font-bold text-gray-900 mt-2">
+            smallpt C++ Path Tracer (WebAssembly)
+          </h2>
+          <p className="text-sm text-gray-600 mt-1">
+            Kevin Beason&apos;s 99-line Monte Carlo global illumination path tracer compiled from C++ to WebAssembly and running client-side in your browser.
+          </p>
+        </div>
+
+        <div className="flex flex-wrap items-center gap-3">
+          <button
+            id="randomize-spheres-btn"
+            type="button"
+            onClick={() => runPathTracer(true)}
+            disabled={isLoadingWasm}
+            className="bg-gray-900 hover:bg-amber-600 disabled:bg-gray-400 text-white font-semibold text-sm px-4 py-2.5 rounded shadow-sm transition-colors cursor-pointer"
+          >
+            {isRendering ? 'Re-rendering...' : 'Run Again with Randomized Sphere Colors'}
+          </button>
+          <button
+            id="reset-spheres-btn"
+            type="button"
+            onClick={() => {
+              if (wasmModuleRef.current) {
+                wasmModuleRef.current._reset_sphere_colors();
+                runPathTracer(false);
+              }
+            }}
+            disabled={isLoadingWasm}
+            className="bg-gray-100 hover:bg-gray-200 disabled:opacity-50 text-gray-800 font-medium text-sm px-3 py-2.5 rounded border border-gray-300 transition-colors cursor-pointer"
+          >
+            Reset Default Colors
+          </button>
+        </div>
+      </div>
+
+      {errorMsg && (
+        <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4 text-sm">
+          {errorMsg}
+        </div>
+      )}
+
+      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
+        <div className="lg:col-span-2 flex flex-col items-center bg-gray-950 rounded-lg p-4 relative overflow-hidden">
+          <canvas
+            id="smallpt-canvas"
+            ref={canvasRef}
+            width={WIDTH}
+            height={HEIGHT}
+            className="w-full max-w-[640px] aspect-[4/3] rounded border border-gray-800 bg-black"
+            style={{ imageRendering: 'auto' }}
+          />
+          <div className="w-full max-w-[640px] mt-3 flex justify-between items-center text-xs text-gray-300 font-mono">
+            <span>
+              Resolution: {WIDTH}&times;{HEIGHT} ({SAMPLES_PER_SUBPIXEL * 4} spp)
+            </span>
+            <span>
+              {isLoadingWasm
+                ? 'Loading smallpt.wasm...'
+                : isRendering
+                ? `Tracing rays... ${progress}%`
+                : renderTimeMs !== null
+                ? `Completed in ${renderTimeMs} ms`
+                : 'Ready'}
+            </span>
+          </div>
+        </div>
+
+        <div className="bg-gray-50 border border-gray-200 rounded-lg p-4">
+          <h3 className="text-sm font-bold text-gray-900 uppercase tracking-wide mb-3">
+            Scene Sphere Colors
+          </h3>
+          <div className="space-y-2.5">
+            {sphereColors.map((sphere) => {
+              const [r, g, b] = sphere.rgb;
+              const hex = `#${r.toString(16).padStart(2, '0')}${g
+                .toString(16)
+                .padStart(2, '0')}${b.toString(16).padStart(2, '0')}`;
+              return (
+                <div
+                  key={sphere.index}
+                  className="flex items-center justify-between text-xs bg-white px-3 py-2 rounded border border-gray-200"
+                >
+                  <div className="flex items-center gap-2.5">
+                    <span
+                      className="w-4 h-4 rounded-full border border-gray-300 inline-block shrink-0"
+                      style={{ backgroundColor: `rgb(${r}, ${g}, ${b})` }}
+                    />
+                    <span className="font-medium text-gray-800">{sphere.name}</span>
+                  </div>
+                  <span className="font-mono text-gray-500">{hex}</span>
+                </div>
+              );
+            })}
+          </div>
+          <p className="text-xs text-gray-500 mt-4 leading-relaxed">
+            In <code>smallpt</code>, the entire Cornell box scene (walls, floor, ceiling, mirror sphere, and glass sphere) is represented using spheres of varying radii.
+          </p>
+        </div>
+      </div>
+    </section>
+  );
+}
