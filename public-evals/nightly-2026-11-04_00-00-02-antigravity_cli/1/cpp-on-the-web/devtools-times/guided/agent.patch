index 0000000..b5eed72
--- /dev/null
+++ b/src/wasm/smallpt.cpp
@@ -0,0 +1,237 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008 (http://www.kevinbeason.com/smallpt/)
+// Compiled to WebAssembly with explicit light sampling for interactive browser rendering
+// and configurable sphere color randomization.
+
+#ifndef _XOPEN_SOURCE
+#define _XOPEN_SOURCE 700
+#endif
+
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <emscripten/emscripten.h>
+
+struct Vec {
+  double x, y, z;
+  constexpr Vec(double x_ = 0, double y_ = 0, double z_ = 0) : x(x_), y(y_), z(z_) {}
+  Vec operator+(const Vec& b) const { return Vec(x + b.x, y + b.y, z + b.z); }
+  Vec operator-(const Vec& b) const { return Vec(x - b.x, y - b.y, z - b.z); }
+  Vec operator*(double b) const { return Vec(x * b, y * b, z * b); }
+  Vec mult(const Vec& b) const { return Vec(x * b.x, y * b.y, z * b.z); }
+  Vec& norm() { return *this = *this * (1.0 / std::sqrt(x * x + y * y + z * z)); }
+  double dot(const Vec& b) const { return x * b.x + y * b.y + z * b.z; }
+  Vec operator%(const Vec& b) const {
+    return Vec(y * b.z - z * b.y, z * b.x - x * b.z, x * b.y - y * b.x);
+  }
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(const Vec& o_, const Vec& d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+  double rad;
+  Vec p, e, c;
+  Refl_t refl;
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_)
+      : rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray& r) const {
+    Vec op = p - r.o;
+    double t;
+    double eps = 1e-4;
+    double b = op.dot(r.d);
+    double det = b * b - op.dot(op) + rad * rad;
+    if (det < 0) return 0;
+    det = std::sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+static inline double clamp(double x) {
+  return x < 0 ? 0 : (x > 1 ? 1 : x);
+}
+
+static inline uint8_t toInt(double x) {
+  return static_cast<uint8_t>(std::pow(clamp(x), 1.0 / 2.2) * 255.0 + 0.5);
+}
+
+static inline bool intersect(const Sphere* spheres, int n, const Ray& r, double& t, int& id) {
+  double inf = t = 1e20;
+  for (int i = n - 1; i >= 0; --i) {
+    double d = spheres[i].intersect(r);
+    if (d != 0 && d < t) {
+      t = d;
+      id = i;
+    }
+  }
+  return t < inf;
+}
+
+static Vec radiance(
+    const Sphere* spheres,
+    int n,
+    const Ray& r,
+    int depth,
+    unsigned short* Xi,
+    int E = 1) {
+  double t;
+  int id = 0;
+  if (!intersect(spheres, n, r, t, id)) return Vec();
+  const Sphere& obj = spheres[id];
+  Vec x = r.o + r.d * t;
+  Vec nrm = (x - obj.p).norm();
+  Vec nl = nrm.dot(r.d) < 0 ? nrm : nrm * -1;
+  Vec f = obj.c;
+  double p = (f.x > f.y && f.x > f.z) ? f.x : (f.y > f.z ? f.y : f.z);
+  if (++depth > 5 || !p) {
+    if (depth < 24 && erand48(Xi) < p) {
+      f = f * (1.0 / p);
+    } else {
+      return obj.e * E;
+    }
+  }
+  if (obj.refl == DIFF) {
+    double r1 = 2.0 * M_PI * erand48(Xi);
+    double r2 = erand48(Xi);
+    double r2s = std::sqrt(r2);
+    Vec w = nl;
+    Vec u = ((std::fabs(w.x) > 0.1 ? Vec(0, 1, 0) : Vec(1, 0, 0)) % w).norm();
+    Vec v = w % u;
+    Vec d = (u * std::cos(r1) * r2s + v * std::sin(r1) * r2s + w * std::sqrt(1.0 - r2)).norm();
+
+    // Explicit light sampling (Kevin Beason's smallpt explicit.cpp variant)
+    Vec e;
+    for (int i = 0; i < n; ++i) {
+      const Sphere& s = spheres[i];
+      if (s.e.x <= 0 && s.e.y <= 0 && s.e.z <= 0) continue;
+      Vec sw = s.p - x;
+      Vec su = ((std::fabs(sw.x) > 0.1 ? Vec(0, 1, 0) : Vec(1, 0, 0)) % sw).norm();
+      Vec sv = sw % su;
+      double cos_a_max = std::sqrt(1.0 - s.rad * s.rad / (x - s.p).dot(x - s.p));
+      double eps1 = erand48(Xi);
+      double eps2 = erand48(Xi);
+      double cos_a = 1.0 - eps1 + eps1 * cos_a_max;
+      double sin_a = std::sqrt(1.0 - cos_a * cos_a);
+      double phi = 2.0 * M_PI * eps2;
+      Vec l = (su * std::cos(phi) * sin_a + sv * std::sin(phi) * sin_a + sw * cos_a).norm();
+      if (intersect(spheres, n, Ray(x, l), t, id) && id == i) {
+        double omega = 2.0 * M_PI * (1.0 - cos_a_max);
+        e = e + f.mult(s.e * l.dot(nl) * omega) * M_1_PI;
+      }
+    }
+
+    return obj.e * E + e + f.mult(radiance(spheres, n, Ray(x, d), depth, Xi, 0));
+  } else if (obj.refl == SPEC) {
+    return obj.e + f.mult(radiance(spheres, n, Ray(x, r.d - nrm * 2.0 * nrm.dot(r.d)), depth, Xi, 1));
+  }
+  Ray reflRay(x, r.d - nrm * 2.0 * nrm.dot(r.d));
+  bool into = nrm.dot(nl) > 0;
+  double nc = 1.0;
+  double nt = 1.5;
+  double nnt = into ? nc / nt : nt / nc;
+  double ddn = r.d.dot(nl);
+  double cos2t = 1.0 - nnt * nnt * (1.0 - ddn * ddn);
+  if (cos2t < 0) {
+    return obj.e + f.mult(radiance(spheres, n, reflRay, depth, Xi, 1));
+  }
+  Vec tdir = (r.d * nnt - nrm * ((into ? 1.0 : -1.0) * (ddn * nnt + std::sqrt(cos2t)))).norm();
+  double a = nt - nc;
+  double b = nt + nc;
+  double R0 = (a * a) / (b * b);
+  double c = 1.0 - (into ? -ddn : tdir.dot(nrm));
+  double Re = R0 + (1.0 - R0) * c * c * c * c * c;
+  double Tr = 1.0 - Re;
+  double P = 0.25 + 0.5 * Re;
+  double RP = Re / P;
+  double TP = Tr / (1.0 - P);
+  return obj.e + f.mult(depth > 2
+      ? (erand48(Xi) < P
+          ? radiance(spheres, n, reflRay, depth, Xi, 1) * RP
+          : radiance(spheres, n, Ray(x, tdir), depth, Xi, 1) * TP)
+      : radiance(spheres, n, reflRay, depth, Xi, 1) * Re +
+        radiance(spheres, n, Ray(x, tdir), depth, Xi, 1) * Tr);
+}
+
+static Vec random_color(unsigned short* Xi, double min_val, double max_val) {
+  double span = max_val - min_val;
+  return Vec(
+      min_val + span * erand48(Xi),
+      min_val + span * erand48(Xi),
+      min_val + span * erand48(Xi));
+}
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+void render_frame(uint8_t* out_rgba, int w, int h, int samps, uint32_t color_seed) {
+  // Classic smallpt Cornell Box spheres (http://www.kevinbeason.com/smallpt/)
+  // Note: With explicit light sampling, the small area light Sphere(1.5, Vec(50,81.6-16.5,81.6), Vec(4,4,4)*100, ...)
+  // or the classic ceiling light produces clean illumination in just a few samples per pixel.
+  Sphere spheres[9] = {
+    Sphere(1e5, Vec(1e5 + 1, 40.8, 81.6), Vec(), Vec(0.75, 0.25, 0.25), DIFF),   // Left
+    Sphere(1e5, Vec(-1e5 + 99, 40.8, 81.6), Vec(), Vec(0.25, 0.25, 0.75), DIFF), // Right
+    Sphere(1e5, Vec(50, 40.8, 1e5), Vec(), Vec(0.75, 0.75, 0.75), DIFF),         // Back
+    Sphere(1e5, Vec(50, 40.8, -1e5 + 170), Vec(), Vec(), DIFF),                  // Front
+    Sphere(1e5, Vec(50, 1e5, 81.6), Vec(), Vec(0.75, 0.75, 0.75), DIFF),         // Bottom
+    Sphere(1e5, Vec(50, -1e5 + 81.6, 81.6), Vec(), Vec(0.75, 0.75, 0.75), DIFF), // Top
+    Sphere(16.5, Vec(27, 16.5, 47), Vec(), Vec(1, 1, 1) * 0.999, SPEC),          // Mirror
+    Sphere(16.5, Vec(73, 16.5, 78), Vec(), Vec(1, 1, 1) * 0.999, REFR),          // Glass
+    Sphere(1.5, Vec(50, 81.6 - 16.5, 81.6), Vec(4, 4, 4) * 100, Vec(), DIFF)     // Light
+  };
+
+  if (color_seed != 0) {
+    unsigned short seed_xi[3] = {
+      static_cast<unsigned short>((color_seed & 0xFFFFu) ^ 0x330Eu),
+      static_cast<unsigned short>(((color_seed >> 16) & 0xFFFFu) ^ 0xABCDu),
+      static_cast<unsigned short>((color_seed * 2654435761u) & 0xFFFFu)
+    };
+    spheres[0].c = random_color(seed_xi, 0.15, 0.90);
+    spheres[1].c = random_color(seed_xi, 0.15, 0.90);
+    spheres[2].c = random_color(seed_xi, 0.20, 0.85);
+    spheres[4].c = random_color(seed_xi, 0.20, 0.85);
+    spheres[5].c = random_color(seed_xi, 0.20, 0.85);
+    spheres[6].c = random_color(seed_xi, 0.25, 0.999);
+    spheres[7].c = random_color(seed_xi, 0.25, 0.999);
+  }
+
+  int spp = samps > 0 ? samps : 1;
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+  Vec cx = Vec(w * 0.5135 / h);
+  Vec cy = (cx % cam.d).norm() * 0.5135;
+
+  for (int y = 0; y < h; ++y) {
+    unsigned short Xi[3] = {
+      static_cast<unsigned short>(color_seed & 0xFFFFu),
+      static_cast<unsigned short>((color_seed >> 16) & 0xFFFFu),
+      static_cast<unsigned short>(y * y * y)
+    };
+    for (int x = 0; x < w; ++x) {
+      Vec pixel_col;
+      for (int sy = 0; sy < 2; ++sy) {
+        for (int sx = 0; sx < 2; ++sx) {
+          Vec r;
+          for (int s = 0; s < spp; ++s) {
+            double r1 = 2.0 * erand48(Xi);
+            double dx = r1 < 1.0 ? std::sqrt(r1) - 1.0 : 1.0 - std::sqrt(2.0 - r1);
+            double r2 = 2.0 * erand48(Xi);
+            double dy = r2 < 1.0 ? std::sqrt(r2) - 1.0 : 1.0 - std::sqrt(2.0 - r2);
+            Vec d = cx * (((sx + 0.5 + dx) / 2.0 + x) / w - 0.5) +
+                    cy * (((sy + 0.5 + dy) / 2.0 + (h - y - 1)) / h - 0.5) + cam.d;
+            r = r + radiance(spheres, 9, Ray(cam.o + d * 140.0, d.norm()), 0, Xi) * (1.0 / spp);
+          }
+          pixel_col = pixel_col + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * 0.25;
+        }
+      }
+      int idx = (y * w + x) * 4;
+      out_rgba[idx + 0] = toInt(pixel_col.x);
+      out_rgba[idx + 1] = toInt(pixel_col.y);
+      out_rgba[idx + 2] = toInt(pixel_col.z);
+      out_rgba[idx + 3] = 255;
+    }
+  }
+}
+
+}
