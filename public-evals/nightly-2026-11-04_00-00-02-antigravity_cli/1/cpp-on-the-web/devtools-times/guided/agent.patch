+import initSmallpt, { type SmallptModule } from '../wasm/smallpt.js';
+
+export interface RenderRequest {
+  width: number;
+  height: number;
+  samples: number;
+  colorSeed: number;
+}
+
+export interface RenderResponse {
+  pixels: Uint8ClampedArray;
+  width: number;
+  height: number;
+  samples: number;
+  colorSeed: number;
+  elapsedMs: number;
+}
+
+let wasmModulePromise: Promise<SmallptModule> | null = null;
+
+function getWasmModule(): Promise<SmallptModule> {
+  if (!wasmModulePromise) {
+    wasmModulePromise = initSmallpt();
+  }
+  return wasmModulePromise;
+}
+
+self.addEventListener('message', async (event: MessageEvent<RenderRequest>) => {
+  const { width, height, samples, colorSeed } = event.data;
+  const wasm = await getWasmModule();
+  const byteLength = width * height * 4;
+  const ptr = wasm._malloc(byteLength);
+
+  try {
+    const startTime = performance.now();
+    wasm._render_frame(ptr, width, height, samples, colorSeed >>> 0);
+    const elapsedMs = Math.round(performance.now() - startTime);
+
+    const pixels = new Uint8ClampedArray(
+      wasm.HEAPU8.buffer,
+      ptr,
+      byteLength,
+    ).slice();
+
+    const response: RenderResponse = {
+      pixels,
+      width,
+      height,
+      samples,
+      colorSeed,
+      elapsedMs,
+    };
+
+    self.postMessage(response, [pixels.buffer]);
+  } finally {
+    wasm._free(ptr);
+  }
+});
