diff --git a/src/components/SmallptPathTracer.tsx b/src/components/SmallptPathTracer.tsx
new file mode 100644
index 0000000..6d3055c
--- /dev/null
+++ b/src/components/SmallptPathTracer.tsx
@@ -0,0 +1,111 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import type { RenderRequest, RenderResponse } from '../workers/smallpt.worker';
+
+const DEFAULT_WIDTH = 320;
+const DEFAULT_HEIGHT = 240;
+const DEFAULT_SAMPLES = 2;
+
+export default function SmallptPathTracer() {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const [isRendering, setIsRendering] = useState<boolean>(true);
+  const [elapsedMs, setElapsedMs] = useState<number | null>(null);
+  const [colorSeed, setColorSeed] = useState<number>(0);
+
+  const triggerRender = useCallback((seed: number) => {
+    if (!workerRef.current) return;
+    setIsRendering(true);
+    setColorSeed(seed);
+    const request: RenderRequest = {
+      width: DEFAULT_WIDTH,
+      height: DEFAULT_HEIGHT,
+      samples: DEFAULT_SAMPLES,
+      colorSeed: seed,
+    };
+    workerRef.current.postMessage(request);
+  }, []);
+
+  useEffect(() => {
+    const worker = new Worker(
+      new URL('../workers/smallpt.worker.ts', import.meta.url),
+      { type: 'module' },
+    );
+    workerRef.current = worker;
+
+    worker.addEventListener('message', (event: MessageEvent<RenderResponse>) => {
+      const { pixels, width, height, elapsedMs: renderTime } = event.data;
+      const canvas = canvasRef.current;
+      if (canvas) {
+        const ctx = canvas.getContext('2d');
+        if (ctx) {
+          const imageData = new ImageData(new Uint8ClampedArray(pixels), width, height);
+          ctx.putImageData(imageData, 0, 0);
+        }
+      }
+      setElapsedMs(renderTime);
+      setIsRendering(false);
+    });
+
+    triggerRender(0);
+
+    return () => {
+      worker.terminate();
+      workerRef.current = null;
+    };
+  }, [triggerRender]);
+
+  const handleRandomizeColors = () => {
+    const nextSeed = (Math.floor(Math.random() * 0xfffffffe) + 1) >>> 0;
+    triggerRender(nextSeed);
+  };
+
+  return (
+    <section
+      aria-labelledby="smallpt-heading"
+      className="my-6 rounded-lg border border-gray-300 bg-gray-50 p-6 shadow-sm"
+    >
+      <div className="flex flex-col md:flex-row items-center justify-between gap-6">
+        <div className="flex-1 space-y-3 text-left">
+          <div className="inline-block rounded bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900">
+            Interactive WebAssembly Demo
+          </div>
+          <h2 id="smallpt-heading" className="text-2xl font-bold text-gray-900">
+            smallpt C++ Global Illumination Path Tracer
+          </h2>
+          <p className="text-sm text-gray-700">
+            Rendered client-side in the browser using Kevin Beason&apos;s{' '}
+            <code className="rounded bg-gray-200 px-1 py-0.5 text-xs">smallpt</code> C++ Monte Carlo
+            path tracer compiled to WebAssembly with Emscripten and executed off the main thread in a
+            Web Worker.
+          </p>
+          <div className="flex flex-wrap items-center gap-4 pt-2">
+            <button
+              type="button"
+              onClick={handleRandomizeColors}
+              disabled={isRendering}
+              className="inline-flex items-center justify-center rounded-md bg-gray-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:cursor-not-allowed disabled:opacity-60 cursor-pointer transition-colors"
+            >
+              {isRendering ? 'Rendering Path Traced Scene...' : 'Randomize Sphere Colors'}
+            </button>
+            <span className="text-xs text-gray-600" aria-live="polite">
+              {isRendering
+                ? 'Tracing rays in WebAssembly worker...'
+                : elapsedMs !== null
+                  ? `Rendered ${DEFAULT_WIDTH}×${DEFAULT_HEIGHT} (${DEFAULT_SAMPLES * 4} spp) in ${elapsedMs} ms${colorSeed ? ` · Seed #${colorSeed.toString(16).toUpperCase()}` : ' · Classic Cornell Box'}`
+                  : ''}
+            </span>
+          </div>
+        </div>
+
+        <div className="relative flex-shrink-0 overflow-hidden rounded-md border border-gray-300 bg-black shadow">
+          <canvas
+            ref={canvasRef}
+            width={DEFAULT_WIDTH}
+            height={DEFAULT_HEIGHT}
+            className="block h-auto w-full max-w-[320px]"
+          />
+        </div>
+      </div>
+    </section>
+  );
+}
