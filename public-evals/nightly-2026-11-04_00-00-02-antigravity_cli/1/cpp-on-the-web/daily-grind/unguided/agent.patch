+  <script src="smallpt.js"></script>
+  <script>
+    const SPHERE_LABELS = [
+      { index: 0, name: 'Left Wall' },
+      { index: 1, name: 'Right Wall' },
+      { index: 2, name: 'Back Wall' },
+      { index: 4, name: 'Floor' },
+      { index: 6, name: 'Mirror Sphere' },
+      { index: 7, name: 'Glass Sphere' }
+    ];
+
+    const canvas = document.getElementById('render-canvas');
+    const ctx = canvas.getContext('2d');
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const resetBtn = document.getElementById('reset-btn');
+    const resolutionSelect = document.getElementById('resolution-select');
+    const samplesSelect = document.getElementById('samples-select');
+    const statusBadge = document.getElementById('status-badge');
+    const sampleCounter = document.getElementById('sample-counter');
+    const progressBar = document.getElementById('progress-bar');
+    const swatchesContainer = document.getElementById('swatches-container');
+    const elapsedTimeEl = document.getElementById('elapsed-time');
+    const seedDisplayEl = document.getElementById('seed-display');
+
+    let wasmModule = null;
+    let renderJobId = 0;
+    let currentSeed = 1337;
+
+    function toCssRgb(r, g, b) {
+      const to255 = (v) => Math.min(255, Math.max(0, Math.round(Math.pow(Math.max(0, Math.min(1, v)), 1 / 2.2) * 255)));
+      return `rgb(${to255(r)}, ${to255(g)}, ${to255(b)})`;
+    }
+
+    function updateSwatches() {
+      if (!wasmModule) return;
+      swatchesContainer.innerHTML = '';
+      for (const item of SPHERE_LABELS) {
+        const r = wasmModule._get_sphere_color_r(item.index);
+        const g = wasmModule._get_sphere_color_g(item.index);
+        const b = wasmModule._get_sphere_color_b(item.index);
+        const div = document.createElement('div');
+        div.className = 'swatch-item';
+        const box = document.createElement('span');
+        box.className = 'swatch-color';
+        box.style.backgroundColor = toCssRgb(r, g, b);
+        const label = document.createElement('span');
+        label.textContent = item.name;
+        div.appendChild(box);
+        div.appendChild(label);
+        swatchesContainer.appendChild(div);
+      }
+    }
+
+    function parseResolution() {
+      const [w, h] = resolutionSelect.value.split('x').map(Number);
+      return { w, h };
+    }
+
+    function startProgressiveRender({ randomize = false, resetDefault = false } = {}) {
+      if (!wasmModule) return;
+      renderJobId++;
+      const activeJob = renderJobId;
+
+      const { w, h } = parseResolution();
+      const targetSpp = parseInt(samplesSelect.value, 10) || 16;
+
+      if (canvas.width !== w || canvas.height !== h) {
+        canvas.width = w;
+        canvas.height = h;
+      }
+
+      if (resetDefault) {
+        currentSeed = 1337;
+        wasmModule._reset_default_colors();
+        seedDisplayEl.textContent = 'Default';
+      } else if (randomize) {
+        currentSeed = Math.floor(Math.random() * 0x7fffffff) + 1;
+        wasmModule._randomize_sphere_colors(currentSeed);
+        seedDisplayEl.textContent = '#' + currentSeed.toString(16).toUpperCase();
+      }
+
+      updateSwatches();
+      wasmModule._init_renderer(w, h, currentSeed);
+
+      const startTime = performance.now();
+      statusBadge.textContent = 'Path Tracing (WASM)...';
+      statusBadge.classList.remove('done');
+      progressBar.style.width = '0%';
+      sampleCounter.textContent = `0 / ${targetSpp} SPP`;
+
+      function renderNextPass() {
+        if (activeJob !== renderJobId) return;
+
+        // Each pass computes 4 samples per pixel (2x2 subpixels)
+        const ptr = wasmModule._step_render(1);
+        const currentSpp = wasmModule._get_total_samples();
+
+        if (ptr) {
+          const byteLength = w * h * 4;
+          const pixels = new Uint8ClampedArray(wasmModule.HEAPU8.buffer, ptr, byteLength);
+          const imageData = new ImageData(new Uint8ClampedArray(pixels), w, h);
+          ctx.putImageData(imageData, 0, 0);
+        }
+
+        const elapsedSec = ((performance.now() - startTime) / 1000).toFixed(2);
+        elapsedTimeEl.textContent = `${elapsedSec} s`;
+
+        const pct = Math.min(100, Math.round((currentSpp / targetSpp) * 100));
+        progressBar.style.width = `${pct}%`;
+        sampleCounter.textContent = `${currentSpp} / ${targetSpp} SPP`;
+
+        if (currentSpp < targetSpp) {
+          requestAnimationFrame(renderNextPass);
+        } else {
+          statusBadge.textContent = 'Render Complete';
+          statusBadge.classList.add('done');
+        }
+      }
+
+      requestAnimationFrame(renderNextPass);
+    }
+
+    randomizeBtn.addEventListener('click', () => {
+      startProgressiveRender({ randomize: true });
+    });
+
+    resetBtn.addEventListener('click', () => {
+      startProgressiveRender({ resetDefault: true });
+    });
+
+    resolutionSelect.addEventListener('change', () => {
+      startProgressiveRender();
+    });
+
+    samplesSelect.addEventListener('change', () => {
+      startProgressiveRender();
+    });
 
+    createSmallptModule().then((mod) => {
+      wasmModule = mod;
+      startProgressiveRender({ resetDefault: true });
+    }).catch((err) => {
+      console.error('Failed to initialize smallpt WebAssembly module:', err);
+      statusBadge.textContent = 'WASM Load Error';
+    });
+  </script>
