+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+// Persistent accumulation buffer for progressive rendering
+static Vec *accum_buffer = NULL;
+static uint8_t *rgba_buffer = NULL;
+static int current_w = 0;
+static int current_h = 0;
+static int total_samples = 0;
+static unsigned int rng_seed = 0;
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+void reset_default_colors() {
+  spheres[0].c = Vec(.75, .25, .25); // Left wall
+  spheres[1].c = Vec(.25, .25, .75); // Right wall
+  spheres[2].c = Vec(.75, .75, .75); // Back wall
+  spheres[3].c = Vec(0, 0, 0);       // Front wall
+  spheres[4].c = Vec(.75, .75, .75); // Bottom wall
+  spheres[5].c = Vec(.75, .75, .75); // Top wall
+  spheres[6].c = Vec(1, 1, 1) * .999; // Mirror sphere
+  spheres[7].c = Vec(1, 1, 1) * .999; // Glass sphere
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int index, double r, double g, double b) {
+  if (index >= 0 && index < 9) {
+    spheres[index].c = Vec(r, g, b);
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_r(int index) {
+  return (index >= 0 && index < 9) ? spheres[index].c.x : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_g(int index) {
+  return (index >= 0 && index < 9) ? spheres[index].c.y : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_b(int index) {
+  return (index >= 0 && index < 9) ? spheres[index].c.z : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors(unsigned int seed) {
+  unsigned short Xi[3] = {
+    (unsigned short)(seed & 0xFFFF),
+    (unsigned short)((seed >> 16) & 0xFFFF),
+    (unsigned short)((seed * 31337) & 0xFFFF)
+  };
+  // Randomize Left wall, Right wall, Back wall, Bottom wall, Top wall, Mirror sphere, Glass sphere
+  // Keep Front wall black (index 3) and Light source (index 8) bright so the scene remains well-lit
+  int indices_to_color[] = {0, 1, 2, 4, 5, 6, 7};
+  for (int idx = 0; idx < 7; idx++) {
+    int i = indices_to_color[idx];
+    if (i == 6 || i == 7) {
+      // For the two main foreground spheres (Mirror & Glass), give vivid, high-albedo colors
+      double r = 0.35 + 0.649 * erand48(Xi);
+      double g = 0.35 + 0.649 * erand48(Xi);
+      double b = 0.35 + 0.649 * erand48(Xi);
+      spheres[i].c = Vec(r, g, b);
+    } else if (i == 0 || i == 1 || i == 2) {
+      // Colored walls (Left, Right, Back)
+      double r = 0.15 + 0.75 * erand48(Xi);
+      double g = 0.15 + 0.75 * erand48(Xi);
+      double b = 0.15 + 0.75 * erand48(Xi);
+      spheres[i].c = Vec(r, g, b);
+    } else {
+      // Floor & Ceiling: subtle tinted neutrals so light bounces nicely
+      double r = 0.55 + 0.35 * erand48(Xi);
+      double g = 0.55 + 0.35 * erand48(Xi);
+      double b = 0.55 + 0.35 * erand48(Xi);
+      spheres[i].c = Vec(r, g, b);
+    }
+  }
+  rng_seed = seed;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void init_renderer(int w, int h, unsigned int seed) {
+  if (w != current_w || h != current_h || !accum_buffer || !rgba_buffer) {
+    if (accum_buffer) free(accum_buffer);
+    if (rgba_buffer) free(rgba_buffer);
+    current_w = w;
+    current_h = h;
+    accum_buffer = (Vec*)malloc(sizeof(Vec) * w * h);
+    rgba_buffer = (uint8_t*)malloc(sizeof(uint8_t) * w * h * 4);
+  }
+  for (int i = 0; i < w * h; i++) {
+    accum_buffer[i] = Vec(0, 0, 0);
+  }
+  total_samples = 0;
+  rng_seed = seed;
+}
+
+// Render `samps` samples per pixel ( divided across 2x2 subpixels, or 1 pass of 2x2 subpixels per step )
+// Each call to step_render(passes) adds `passes * 4` total samples per pixel (since 2x2 subpixels).
+EMSCRIPTEN_KEEPALIVE
+uint8_t* step_render(int passes) {
+  if (!accum_buffer || !rgba_buffer || current_w <= 0 || current_h <= 0) return NULL;
+  int w = current_w;
+  int h = current_h;
+  if (passes < 1) passes = 1;
+
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+
+  int pass_offset = total_samples / 4;
+
+  for (int y=0; y<h; y++){                       // Loop over image rows
+    unsigned short Xi[3] = {
+      (unsigned short)(y ^ (rng_seed & 0xFFFF)),
+      (unsigned short)((y * y * (pass_offset + 1)) ^ ((rng_seed >> 16) & 0xFFFF)),
+      (unsigned short)((pass_offset * 92821 + y * 1337) & 0xFFFF)
+    };
+    for (unsigned short x=0; x<w; x++)   // Loop cols
+      for (int sy=0, i=(h-y-1)*w+x; sy<2; sy++)     // 2x2 subpixel rows
+        for (int sx=0; sx<2; sx++, r=Vec()){        // 2x2 subpixel cols
+          for (int s=0; s<passes; s++){
+            double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+            double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+            Vec d = cx*( ( (sx+.5 + dx)/2 + x)/w - .5) +
+                    cy*( ( (sy+.5 + dy)/2 + y)/h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*(1./passes);
+          } // Camera rays are pushed ^^^^^ forward to start in interior
+          accum_buffer[i] = accum_buffer[i] + Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25*passes;
+        }
+  }
+
+  total_samples += passes * 4;
+  double inv_passes = 1.0 / (total_samples / 4.0);
+
+  for (int i = 0; i < w * h; i++) {
+    rgba_buffer[i * 4 + 0] = toInt(accum_buffer[i].x * inv_passes);
+    rgba_buffer[i * 4 + 1] = toInt(accum_buffer[i].y * inv_passes);
+    rgba_buffer[i * 4 + 2] = toInt(accum_buffer[i].z * inv_passes);
+    rgba_buffer[i * 4 + 3] = 255;
+  }
+
+  return rgba_buffer;
+}
+
+// One-shot render function for convenience
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render_smallpt(int w, int h, int samps, unsigned int seed, int randomize) {
+  if (randomize) {
+    randomize_sphere_colors(seed);
+  }
+  init_renderer(w, h, seed);
+  int passes = samps / 4;
+  if (passes < 1) passes = 1;
+  return step_render(passes);
+}
+
+EMSCRIPTEN_KEEPALIVE
+int get_total_samples() {
+  return total_samples;
+}
