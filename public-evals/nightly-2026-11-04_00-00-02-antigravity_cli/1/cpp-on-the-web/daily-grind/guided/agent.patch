+  <script type="module">
+    const canvas = document.getElementById('render-canvas');
+    const ctx = canvas.getContext('2d');
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const resetBtn = document.getElementById('reset-btn');
+    const samplesSelect = document.getElementById('samples-select');
+    const statusText = document.getElementById('status-text');
+    const swatchesContainer = document.getElementById('palette-swatches');
+
+    const worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });
+
+    const DEFAULT_COLORS = [
+      { index: 0, label: 'Left Wall', r: 0.75, g: 0.25, b: 0.25 },
+      { index: 1, label: 'Right Wall', r: 0.25, g: 0.25, b: 0.75 },
+      { index: 2, label: 'Back Wall', r: 0.75, g: 0.75, b: 0.75 },
+      { index: 4, label: 'Floor', r: 0.75, g: 0.75, b: 0.75 },
+      { index: 5, label: 'Ceiling', r: 0.75, g: 0.75, b: 0.75 },
+      { index: 6, label: 'Mirror Sphere', r: 0.999, g: 0.999, b: 0.999 },
+      { index: 7, label: 'Glass Sphere', r: 0.999, g: 0.999, b: 0.999 },
+    ];
+
+    let activePalette = DEFAULT_COLORS;
+
+    function updateSwatches(palette) {
+      swatchesContainer.replaceChildren();
+      for (const item of palette) {
+        const swatch = document.createElement('span');
+        swatch.className = 'swatch';
+        const r = Math.round(Math.pow(item.r, 1 / 2.2) * 255);
+        const g = Math.round(Math.pow(item.g, 1 / 2.2) * 255);
+        const b = Math.round(Math.pow(item.b, 1 / 2.2) * 255);
+        swatch.style.backgroundColor = `rgb(${r}, ${g}, ${b})`;
+        swatch.title = `${item.label}: (${item.r.toFixed(2)}, ${item.g.toFixed(2)}, ${item.b.toFixed(2)})`;
+        swatchesContainer.appendChild(swatch);
+      }
+    }
+
+    function generateRandomPalette() {
+      return DEFAULT_COLORS.map((sphere) => {
+        const isObject = sphere.index >= 6;
+        const min = isObject ? 0.45 : 0.15;
+        const range = isObject ? 0.549 : 0.75;
+        return {
+          ...sphere,
+          r: min + Math.random() * range,
+          g: min + Math.random() * range,
+          b: min + Math.random() * range,
+        };
+      });
+    }
+
+    function triggerRender(palette) {
+      activePalette = palette;
+      updateSwatches(activePalette);
+      const samples = Number.parseInt(samplesSelect.value, 10) || 4;
+      randomizeBtn.disabled = true;
+      resetBtn.disabled = true;
+      statusText.textContent = `Rendering ${canvas.width}×${canvas.height} (${samples * 4} total spp) in WebAssembly...`;
+
+      worker.postMessage({
+        type: 'render',
+        width: canvas.width,
+        height: canvas.height,
+        samples,
+        colors: activePalette.map(({ index, r, g, b }) => ({ index, r, g, b })),
+      });
+    }
+
+    worker.addEventListener('message', (event) => {
+      const { type, pixels, width, height, samples, elapsedMs, message } = event.data;
+      randomizeBtn.disabled = false;
+      resetBtn.disabled = false;
+
+      if (type === 'rendered') {
+        const imageData = new ImageData(pixels, width, height);
+        ctx.putImageData(imageData, 0, 0);
+        statusText.textContent = `Rendered ${width}×${height} at ${samples * 4} spp in ${elapsedMs} ms`;
+      } else if (type === 'error') {
+        statusText.textContent = `Render error: ${message}`;
+      }
+    });
+
+    randomizeBtn.addEventListener('click', () => {
+      triggerRender(generateRandomPalette());
+    });
+
+    resetBtn.addEventListener('click', () => {
+      triggerRender(DEFAULT_COLORS);
+    });
+
+    samplesSelect.addEventListener('change', () => {
+      triggerRender(activePalette);
+    });
 
+    // Run initial render on page load
+    triggerRender(DEFAULT_COLORS);
+  </script>
 </body>
 
