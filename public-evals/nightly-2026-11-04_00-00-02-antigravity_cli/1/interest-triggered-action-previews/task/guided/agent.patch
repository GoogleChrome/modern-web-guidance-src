+  <script type="module">
+    const seasonalPreview = document.getElementById("seasonal-preview");
+    const defaultPreviewText = "Select a drink to preview";
+
+    seasonalPreview.addEventListener("interest", (event) => {
+      const effect =
+        event.source?.dataset.effect ||
+        event.source?.closest(".card")?.querySelector("h3")?.textContent?.trim();
+      if (effect) {
+        event.target.dataset.preview = effect;
+        event.target.textContent = effect;
+      }
+    });
+
+    seasonalPreview.addEventListener("loseinterest", (event) => {
+      delete event.target.dataset.preview;
+      event.target.textContent = defaultPreviewText;
+    });
+
+    if (!HTMLButtonElement.prototype.hasOwnProperty("interestForElement")) {
