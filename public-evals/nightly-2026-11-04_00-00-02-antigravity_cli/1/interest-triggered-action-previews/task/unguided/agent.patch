+  <script>
+    const seasonalPreview = document.getElementById('seasonal-preview');
+
+    seasonalPreview.addEventListener('interest', (event) => {
+      const source = event.source;
+      const drinkName =
+        source?.dataset?.drink ||
+        source?.closest('.card')?.querySelector('h3')?.textContent?.trim();
+      if (drinkName) {
+        seasonalPreview.textContent = drinkName;
+      }
+      seasonalPreview.classList.add('has-interest');
+    });
+
+    seasonalPreview.addEventListener('loseinterest', () => {
+      seasonalPreview.textContent = 'Select a drink to preview';
+      seasonalPreview.classList.remove('has-interest');
+    });
