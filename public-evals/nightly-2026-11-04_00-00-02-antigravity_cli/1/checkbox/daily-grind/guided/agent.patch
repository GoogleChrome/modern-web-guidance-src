+    /* Customization Checkboxes */
+    .customizations {
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      padding: 0.75rem 1rem;
+      margin-block: 1rem;
+      text-align: start;
+      background-color: var(--light);
+    }
+
+    .customizations legend {
+      font-size: 0.85rem;
+      font-weight: 700;
+      color: var(--primary);
+      padding-inline: 0.4rem;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+    }
+
+    .checkbox-group {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .checkbox-label {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.65rem;
+      min-block-size: 44px;
+      font-size: 0.95rem;
+      color: var(--text);
+      cursor: pointer;
+      user-select: none;
+
+      @media (pointer: coarse) {
+        min-block-size: 48px;
+      }
+    }
+
+    .checkbox-custom {
+      --checkbox-size: 1.25em;
+      --checkbox-icon-size: 0.75em;
+
+      appearance: none;
+      display: inline-grid;
+      place-content: center;
+      inline-size: var(--checkbox-size);
+      aspect-ratio: 1;
+      margin: 0;
+      border: 2px solid var(--primary);
+      border-radius: 4px;
+      background-color: white;
+      color: var(--primary);
+      font-size: 1rem;
+      cursor: pointer;
+      flex-shrink: 0;
+
+      @media (prefers-reduced-motion: no-preference) {
+        transition: background-color 150ms ease, border-color 150ms ease;
+      }
+
+      &::before {
+        content: "";
+        inline-size: var(--checkbox-icon-size);
+        aspect-ratio: 1;
+        background-color: currentColor;
+        mask: var(--checkbox-icon) no-repeat center / contain;
+        scale: 0;
+
+        @media (prefers-reduced-motion: no-preference) {
+          transition: scale 150ms ease;
+        }
+
+        @media (forced-colors: active) {
+          background-color: CanvasText;
+        }
+      }
+
+      &:hover:not(:disabled) {
+        border-color: var(--accent);
+      }
+
+      &:checked {
+        --checkbox-icon: var(--icon-check);
+        background-color: var(--primary);
+        border-color: var(--primary);
+        color: var(--accent);
+      }
+
+      &:indeterminate {
+        --checkbox-icon: var(--icon-dash);
+        background-color: var(--primary);
+        border-color: var(--primary);
+        color: var(--accent);
+      }
+
+      &:is(:checked, :indeterminate)::before {
+        scale: 1;
+      }
+
+      &:focus-visible {
+        outline: 2px solid var(--primary);
+        outline-offset: 2px;
+      }
+
+      &:disabled {
+        cursor: not-allowed;
+        opacity: 0.5;
+      }
+    }
+
+    .checkbox-label:has(.checkbox-custom:disabled) {
+      cursor: not-allowed;
+      opacity: 0.6;
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
