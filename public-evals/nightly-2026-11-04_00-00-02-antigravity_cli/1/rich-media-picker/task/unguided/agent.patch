+      transition: border-color 0.2s, background-color 0.2s;
+      text-align: left;
+    }
+
+    .roast-select:hover,
+    .roast-select:focus-visible {
+      background: #ffffff;
+      border-color: var(--primary);
+      outline: none;
+    }
+
+    .roast-select > button {
+      display: flex;
+      align-items: center;
+      width: 100%;
+      background: transparent;
+      border: none;
+      padding: 0;
+      font: inherit;
+      color: inherit;
+      cursor: pointer;
+      text-align: left;
+    }
+
+    .roast-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      width: 100%;
+    }
+
+    .roast-select::picker(select) {
+      background: #ffffff;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
+      padding: 6px;
+      margin-top: 6px;
+    }
+
+    .roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px 12px;
+      border-radius: 6px;
+      cursor: pointer;
+      transition: background-color 0.15s;
+      text-align: left;
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus {
+      background-color: #f5ebe6;
+    }
+
+    .roast-select option:checked {
+      background-color: var(--secondary);
+    }
+
+    .roast-icon {
+      flex-shrink: 0;
+      width: 24px;
+      height: 24px;
+      color: var(--primary);
+    }
+
+    .option-content {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .option-title {
+      font-weight: 700;
+      font-size: 0.95rem;
+      color: var(--primary);
+    }
+
+    .option-desc {
+      font-size: 0.8rem;
+      color: #6d4c41;
+    }
