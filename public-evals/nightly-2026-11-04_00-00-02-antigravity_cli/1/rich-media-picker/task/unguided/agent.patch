+      appearance: base-select;
+    }
+
+    .roast-select {
+      width: 100%;
+      background: rgba(255, 255, 255, 0.95);
+      color: var(--text);
+      border: 2px solid var(--accent);
+      border-radius: 8px;
+      padding: 10px 14px;
+      font-family: inherit;
+      font-size: 1rem;
+      cursor: pointer;
