+            this.#internals.states.add('checked');
+          } else {
+            this.#internals.states.delete('favorited');
+            this.#internals.states.delete('checked');
+          }
+        }
+
+        if (isDisabled) {
+          if (this.tabIndex >= 0) this.removeAttribute('tabindex');
+        } else if (!this.hasAttribute('tabindex')) {
+          this.tabIndex = 0;
+        }
+      }
+    }
