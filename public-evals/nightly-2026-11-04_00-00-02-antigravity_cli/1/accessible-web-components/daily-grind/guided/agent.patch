+    class FavoriteToggle extends HTMLElement {
+      static observedAttributes = ['checked', 'favorited', 'disabled', 'label'];
+
+      #internals;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+        if ('role' in this.#internals) {
+          this.#internals.role = 'switch';
+          this.#internals.ariaChecked = 'false';
+        } else {
+          if (!this.hasAttribute('role')) this.setAttribute('role', 'switch');
+          this.setAttribute('aria-checked', 'false');
+        }
+
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [favoriteSheet];
+        this.shadowRoot.append(favoriteTemplate.content.cloneNode(true));
+
+        this.addEventListener('click', this.#onClick);
+        this.addEventListener('keydown', this.#onKeyDown);
+      }
+
+      connectedCallback() {
+        if (!this.hasAttribute('tabindex') && !this.disabled) {
+          this.tabIndex = 0;
+        }
+        this.#syncState();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        if (name === 'checked' || name === 'favorited') {
+          const isOn = newVal !== null;
+          if (this.hasAttribute('checked') !== isOn) {
+            this.toggleAttribute('checked', isOn);
+          }
+          if (this.hasAttribute('favorited') !== isOn) {
+            this.toggleAttribute('favorited', isOn);
+          }
+        }
+        this.#syncState();
+      }
+
+      get checked() {
+        return this.hasAttribute('checked') || this.hasAttribute('favorited');
+      }
+
+      set checked(on) {
+        const isOn = Boolean(on);
+        this.toggleAttribute('checked', isOn);
+        this.toggleAttribute('favorited', isOn);
+      }
+
+      get favorited() {
+        return this.checked;
+      }
+
+      set favorited(on) {
+        this.checked = on;
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+
+      set disabled(on) {
+        this.toggleAttribute('disabled', Boolean(on));
+      }
+
+      get label() {
+        return this.getAttribute('label') ?? '';
+      }
+
+      set label(v) {
+        v ? this.setAttribute('label', String(v)) : this.removeAttribute('label');
+      }
+
+      toggle(force) {
+        if (this.disabled) return this.checked;
+        const next = typeof force === 'boolean' ? force : !this.checked;
+        this.checked = next;
+        this.dispatchEvent(
+          new CustomEvent('change', {
+            bubbles: true,
+            composed: true,
+            detail: {
+              checked: next,
+              favorited: next,
+              drink: this.getAttribute('drink') ?? '',
+            },
+          })
+        );
+        return next;
+      }
+
+      #onClick = () => {
+        this.toggle();
+      };
+
+      #onKeyDown = (e) => {
+        if (this.disabled) return;
+        if (e.key === ' ' || e.key === 'Enter') {
+          e.preventDefault();
+          this.toggle();
+        }
+      };
+
+      #syncState() {
+        const isChecked = this.checked;
+        const isDisabled = this.disabled;
+        const labelText = this.label;
+
+        if ('role' in this.#internals) {
+          this.#internals.ariaChecked = String(isChecked);
