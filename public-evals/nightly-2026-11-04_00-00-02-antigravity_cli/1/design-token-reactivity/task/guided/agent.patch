+  <script>
+    const toggleBtn = document.getElementById('toggle-spacious');
+    const targetContainer = document.getElementById('target-container');
+
+    if (toggleBtn && targetContainer) {
+      toggleBtn.addEventListener('click', () => {
+        const currentDensity = getComputedStyle(targetContainer).getPropertyValue('--density').trim();
+        const isSpacious = currentDensity === 'spacious';
+        targetContainer.style.setProperty('--density', isSpacious ? 'compact' : 'spacious');
+        toggleBtn.setAttribute('aria-pressed', String(!isSpacious));
+      });
+    }
+  </script>
