+  <script>
+    document.querySelectorAll('.order-form').forEach((form) => {
+      const btn = form.querySelector('.add-to-order-btn');
+      const feedback = form.querySelector('.order-feedback');
+      const drinkName = form.dataset.drink;
+
+      form.addEventListener('change', () => {
+        btn.classList.remove('added');
+        btn.textContent = 'Add to Order';
+        feedback.textContent = '';
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const selected = form.querySelector('input[type="radio"]:checked');
+        const size = selected ? selected.value : 'medium';
+        const sizeLabel = size.charAt(0).toUpperCase() + size.slice(1);
+
+        btn.classList.add('added');
+        btn.textContent = `Added (${sizeLabel})`;
+        feedback.textContent = `${sizeLabel} ${drinkName} added to your order!`;
+      });
+    });
+  </script>
