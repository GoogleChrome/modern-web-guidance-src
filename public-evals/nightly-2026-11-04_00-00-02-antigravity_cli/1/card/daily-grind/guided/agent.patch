+  <script>
+    // Handle "Add to Order" form submissions directly from each card
+    document.querySelectorAll('.order-form').forEach((form) => {
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const formData = new FormData(form);
+        const drink = formData.get('drink');
+        const size = formData.get('size');
+        const status = form.querySelector('.order-status');
+        if (status && drink && size) {
+          const sizeLabel = String(size).charAt(0).toUpperCase() + String(size).slice(1);
+          status.textContent = `Added ${sizeLabel} ${drink} to your order!`;
+        }
+      });
+    });
+
+    // Fallback for browsers that do not support the :has() selector
+    if (!CSS.supports('selector(:has(*))')) {
+      document.querySelectorAll('.card').forEach((card) => {
+        if (card.querySelector('img')) {
+          card.classList.add('has-image');
+        }
+        const radios = card.querySelectorAll('input[type="radio"]');
+        const syncRadioState = () => {
+          let anyChecked = false;
+          radios.forEach((radio) => {
+            const label = radio.closest('.size-option');
+            if (label) {
+              label.classList.toggle('is-checked', radio.checked);
+            }
+            if (radio.checked) {
+              anyChecked = true;
+            }
+          });
+          card.classList.toggle('is-selected', anyChecked);
+        };
+        radios.forEach((radio) => radio.addEventListener('change', syncRadioState));
+        syncRadioState();
+      });
+    }
+  </script>
+
