+
+      const beanGrid = document.getElementById('bean-grid');
+      const beanSelect = document.getElementById('bean-select');
+      const addBeanBtn = document.getElementById('add-bean-btn');
+      const beanCountEl = document.getElementById('bean-count');
+      let customRoastCounter = 1;
+
+      function runWithViewTransition(mutationCallback) {
+        if (typeof document.startViewTransition === 'function') {
+          return document.startViewTransition(() => {
+            mutationCallback();
+          });
+        }
+        mutationCallback();
+      }
+
+      function createBeanCardElement(bean, uniqueId) {
+        const cardId = uniqueId || bean.id;
+        const article = document.createElement('article');
+        article.className = 'bean-card';
+        article.setAttribute('role', 'listitem');
+        article.dataset.beanId = cardId;
+        article.style.viewTransitionName = 'bean-' + cardId;
+
+        article.innerHTML = `
+          <img class="bean-card-image" src="${bean.image}" alt="${bean.name} coffee beans">
+          <div class="bean-card-body">
+            <div class="bean-meta">
+              <span class="bean-roast">${bean.roast}</span>
+              <span class="bean-origin">${bean.origin}</span>
+            </div>
+            <h3>${bean.name}</h3>
+            <p class="bean-notes">${bean.notes}</p>
+            <div class="bean-card-footer">
+              <span class="bean-price">${bean.price}</span>
+              <button type="button" class="btn-remove-bean" aria-label="Remove ${bean.name}">Remove</button>
+            </div>
+          </div>
+        `;
+        return article;
+      }
+
+      function syncCountAndEmptyState() {
+        const cards = beanGrid.querySelectorAll('.bean-card');
+        const count = cards.length;
+        beanCountEl.textContent = count === 1 ? '1 Bean Selected' : `${count} Beans Selected`;
+
+        const existingEmpty = beanGrid.querySelector('.bean-empty-state');
+        if (count === 0 && !existingEmpty) {
+          const emptyDiv = document.createElement('div');
+          emptyDiv.className = 'bean-empty-state';
+          emptyDiv.textContent = 'No coffee beans selected yet. Choose a variety above and click "+ Add Bean" to start building your lineup.';
+          beanGrid.appendChild(emptyDiv);
+        } else if (count > 0 && existingEmpty) {
+          existingEmpty.remove();
+        }
+      }
+
+      function syncSelectOptions() {
+        const activeIds = new Set(
+          Array.from(beanGrid.querySelectorAll('.bean-card')).map((el) => el.dataset.beanId)
+        );
+        const previousValue = beanSelect.value;
+        beanSelect.innerHTML = '';
+
+        Object.values(beanCatalog).forEach((bean) => {
+          if (!activeIds.has(bean.id)) {
+            const option = document.createElement('option');
+            option.value = bean.id;
+            option.textContent = bean.optionLabel;
+            beanSelect.appendChild(option);
+          }
+        });
+
+        if (beanSelect.options.length === 0) {
+          const fallbackOption = document.createElement('option');
+          fallbackOption.value = 'roaster-micro-lot';
+          fallbackOption.textContent = 'Roaster Micro-Lot Reserve (Small Batch Selection)';
+          beanSelect.appendChild(fallbackOption);
+        } else if (
+          previousValue &&
+          Array.from(beanSelect.options).some((opt) => opt.value === previousValue)
+        ) {
+          beanSelect.value = previousValue;
+        }
+      }
+
+      addBeanBtn.addEventListener('click', () => {
+        const selectedKey = beanSelect.value;
+        let beanData = beanCatalog[selectedKey];
+        let uniqueId = selectedKey;
+
+        const alreadyExists = beanGrid.querySelector(`.bean-card[data-bean-id="${uniqueId}"]`);
+        if (!beanData || alreadyExists) {
+          const reserveIndex = customRoastCounter++;
+          uniqueId = `reserve-lot-${reserveIndex}`;
+          beanData = {
+            id: uniqueId,
+            name: `Roaster Micro-Lot #${reserveIndex}`,
+            roast: 'Medium Roast',
+            origin: 'Single Estate',
+            notes: 'Limited harvest micro-lot featuring toasted pecan, stone fruit, and cocoa nibs.',
+            price: '$21.00 / 12 oz',
+            image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80'
