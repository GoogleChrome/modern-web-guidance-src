+        }
+
+        const newCard = createBeanCardElement(beanData, uniqueId);
+
+        runWithViewTransition(() => {
+          const emptyEl = beanGrid.querySelector('.bean-empty-state');
+          if (emptyEl) {
+            emptyEl.remove();
+          }
+          beanGrid.appendChild(newCard);
+          syncCountAndEmptyState();
+          syncSelectOptions();
+        });
+      });
+
+      beanGrid.addEventListener('click', (event) => {
+        const removeBtn = event.target.closest('.btn-remove-bean');
+        if (!removeBtn) return;
+
+        const card = removeBtn.closest('.bean-card');
+        if (!card) return;
+
+        runWithViewTransition(() => {
+          card.remove();
+          syncCountAndEmptyState();
+          syncSelectOptions();
+        });
+      });
+    })();
