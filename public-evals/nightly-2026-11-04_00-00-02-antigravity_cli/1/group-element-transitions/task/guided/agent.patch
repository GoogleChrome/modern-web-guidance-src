       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      /* Disable the root transition because we are only transitioning specific elements. */
+      view-transition-name: none;
     }
 
+    ::view-transition {
+      /* Non-transitioned elements below the view transitions remain interactive */
+      pointer-events: none;
+    }
+
+    /* Group Element Transitions for Coffee Beans */
+    .bean-item {
+      view-transition-class: bean-item;
+    }
+
+    ::view-transition-group(.bean-item) {
+      animation-duration: 0.4s;
+      animation-timing-function: ease-in-out;
+    }
+
+    ::view-transition-new(.bean-item):only-child {
+      animation-name: bean-slide-in;
+      animation-duration: 0.4s;
+      animation-timing-function: ease-out;
+    }
+
+    ::view-transition-old(.bean-item):only-child {
+      animation-name: bean-slide-out;
+      animation-duration: 0.4s;
+      animation-timing-function: ease-in;
+    }
+
+    @keyframes bean-slide-in {
+      from {
+        opacity: 0;
+        translate: 0 24px;
+        scale: 0.92;
+      }
+    }
+
+    @keyframes bean-slide-out {
+      to {
+        opacity: 0;
+        translate: 0 -24px;
+        scale: 0.92;
+      }
+    }
+
+    /* Handle accessibility by respecting motion preferences */
+    @media (prefers-reduced-motion: reduce) {
+      /* Disable all group transitions, including the default `root` group. */
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
