+  <script>
+    const BEAN_CATALOG = [
+      {
+        id: 'ethiopian-yirgacheffe',
+        name: 'Ethiopian Yirgacheffe',
+        origin: 'Ethiopia',
+        roast: 'Light Roast',
+        notes: 'Bright floral jasmine aroma with vibrant bergamot and lemon zest notes.',
+        image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'colombian-supremo',
+        name: 'Colombian Supremo',
+        origin: 'Colombia',
+        roast: 'Medium Roast',
+        notes: 'Velvety body with rich caramel sweetness, toasted walnut, and a clean citrus finish.',
+        image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'sumatra-mandheling',
+        name: 'Sumatra Mandheling',
+        origin: 'Indonesia',
+        roast: 'Dark Roast',
+        notes: 'Full-bodied and earthy with deep dark chocolate, cedar spice, and low acidity.',
+        image: 'https://images.unsplash.com/photo-1611854779393-1b2da9d400fe?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'guatemala-antigua',
+        name: 'Guatemala Antigua',
+        origin: 'Guatemala',
+        roast: 'Medium Roast',
+        notes: 'Complex cocoa undertones balanced by brown spice and subtle green apple.',
+        image: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'kenya-aa',
+        name: 'Kenya AA Nyeri',
+        origin: 'Kenya',
+        roast: 'Medium-Light',
+        notes: 'Juicy blackcurrant and grapefruit acidity with a sweet, wine-like finish.',
+        image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'brazil-cerrado',
+        name: 'Brazil Cerrado',
+        origin: 'Brazil',
+        roast: 'Medium-Dark',
+        notes: 'Smooth hazelnut and milk chocolate profile, ideal for espresso blends.',
+        image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+      }
+    ];
+
+    const selectedBeanIds = [
+      'ethiopian-yirgacheffe',
+      'colombian-supremo',
+      'sumatra-mandheling'
+    ];
+
+    const beanListEl = document.getElementById('bean-selection-list');
+    const beanPickerEl = document.getElementById('bean-picker');
+    const addBeanBtn = document.getElementById('add-bean-btn');
+
+    function renderBeanControls() {
+      const availableBeans = BEAN_CATALOG.filter(
+        (bean) => !selectedBeanIds.includes(bean.id)
+      );
+
+      beanPickerEl.innerHTML = '';
+
+      if (availableBeans.length === 0) {
+        const option = document.createElement('option');
+        option.value = '';
+        option.textContent = 'All beans added to your flight';
+        beanPickerEl.appendChild(option);
+        beanPickerEl.disabled = true;
+        addBeanBtn.disabled = true;
+      } else {
+        beanPickerEl.disabled = false;
+        addBeanBtn.disabled = false;
+        for (const bean of availableBeans) {
+          const option = document.createElement('option');
+          option.value = bean.id;
+          option.textContent = `${bean.name} (${bean.roast})`;
+          beanPickerEl.appendChild(option);
+        }
+      }
+    }
+
+    function renderSelectedBeans() {
+      beanListEl.innerHTML = '';
+
+      if (selectedBeanIds.length === 0) {
+        const emptyEl = document.createElement('li');
+        emptyEl.className = 'bean-empty';
+        emptyEl.textContent = 'Your coffee bean flight is empty. Select a bean above to add it!';
+        beanListEl.appendChild(emptyEl);
+        return;
+      }
+
+      for (const id of selectedBeanIds) {
+        const bean = BEAN_CATALOG.find((b) => b.id === id);
+        if (!bean) continue;
+
+        const li = document.createElement('li');
+        li.className = 'bean-item';
+        // Mandatory: Each element must have a unique view-transition-name
+        li.style.viewTransitionName = `bean-${bean.id}`;
+
+        li.innerHTML = `
+          <img src="${bean.image}" alt="${bean.name} coffee beans" loading="lazy">
+          <div class="bean-item-body">
+            <div class="bean-item-meta">
+              <span>${bean.origin}</span>
+              <span class="bean-roast-badge">${bean.roast}</span>
+            </div>
+            <h3>${bean.name}</h3>
+            <p>${bean.notes}</p>
+            <button type="button" class="btn-remove" data-remove-id="${bean.id}" aria-label="Remove ${bean.name}">
+              Remove
+            </button>
+          </div>
+        `;
+        beanListEl.appendChild(li);
+      }
+    }
+
+    function updateBeanSelection(mutateState) {
+      const applyUpdate = () => {
+        mutateState();
+        renderBeanControls();
+        renderSelectedBeans();
+      };
+
+      if (document.startViewTransition) {
+        document.startViewTransition(() => applyUpdate());
+      } else {
+        // Fallback: Perform the update without animation
+        applyUpdate();
+      }
+    }
+
+    addBeanBtn.addEventListener('click', () => {
+      const chosenId = beanPickerEl.value;
+      if (!chosenId || selectedBeanIds.includes(chosenId)) return;
+
+      updateBeanSelection(() => {
+        selectedBeanIds.push(chosenId);
+      });
+    });
+
+    beanListEl.addEventListener('click', (event) => {
+      const removeBtn = event.target.closest('[data-remove-id]');
+      if (!removeBtn) return;
+
+      const idToRemove = removeBtn.getAttribute('data-remove-id');
+      updateBeanSelection(() => {
+        const index = selectedBeanIds.indexOf(idToRemove);
+        if (index !== -1) {
+          selectedBeanIds.splice(index, 1);
+        }
+      });
+    });
+
+    // Initial render
+    renderBeanControls();
+    renderSelectedBeans();
+  </script>
 </body>
 
