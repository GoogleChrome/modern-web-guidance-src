+        { name: 'Vanilla Bean Cappuccino', desc: 'Rich espresso topped with airy vanilla foam.' }
+      ];
+      const CUSTOMERS = ['Sam', 'Jordan', 'Taylor', 'Morgan', 'Casey', 'Riley', 'Quinn', 'Avery'];
+
+      function createOrderCardElement(orderId, name, desc, badgeText, customer, status) {
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.draggable = true;
+        card.dataset.orderId = String(orderId);
+        card.dataset.status = status;
+
+        card.innerHTML =
+          '<div class="card-top">' +
+            '<span>#' + orderId + '</span>' +
+            '<span class="badge">' + badgeText + '</span>' +
+          '</div>' +
+          '<h3></h3>' +
+          '<p></p>' +
+          '<div class="card-meta">' +
+            '<span></span>' +
+            '<span>' + (STATUS_LABELS[status] || 'Queued') + '</span>' +
+          '</div>';
+
+        card.querySelector('h3').textContent = name;
+        card.querySelector('p').textContent = desc;
+        card.querySelector('.card-meta span').textContent = 'For: ' + customer;
+        return card;
+      }
+
+      const addOrderBtn = document.getElementById('add-order-btn');
+      const bulkOrderBtn = document.getElementById('bulk-order-btn');
+      const nameInput = document.getElementById('new-order-name');
+      const sizeSelect = document.getElementById('new-order-size');
+      const queuedColumn = document.getElementById('queued');
+
+      if (addOrderBtn) {
+        addOrderBtn.addEventListener('click', function () {
+          const customName = nameInput.value.trim();
+          const preset = DRINK_MENU[nextOrderId % DRINK_MENU.length];
+          const drinkName = customName || preset.name;
+          const desc = customName ? 'Custom barista hand-crafted beverage.' : preset.desc;
+          const size = sizeSelect ? sizeSelect.value : '16oz';
+          const customer = CUSTOMERS[nextOrderId % CUSTOMERS.length];
+
+          const card = createOrderCardElement(nextOrderId++, drinkName, desc, size, customer, 'queued');
+          queuedColumn.appendChild(card);
+          nameInput.value = '';
+          updateColumnCounts();
+        });
+      }
+
+      if (bulkOrderBtn) {
+        bulkOrderBtn.addEventListener('click', function () {
+          // Batch insert 50 cards using DocumentFragment in a single rAF to prevent layout reflows
+          requestAnimationFrame(function () {
+            const fragment = document.createDocumentFragment();
+            for (let i = 0; i < 50; i++) {
+              const preset = DRINK_MENU[nextOrderId % DRINK_MENU.length];
+              const customer = CUSTOMERS[nextOrderId % CUSTOMERS.length];
+              const card = createOrderCardElement(
+                nextOrderId++,
+                preset.name,
+                preset.desc,
+                '16oz Rush',
+                customer,
+                'queued'
+              );
+              fragment.appendChild(card);
+            }
+            queuedColumn.appendChild(fragment);
+            updateColumnCounts();
+          });
+        });
+      }
+    })();
+  </script>
 </body>
 
