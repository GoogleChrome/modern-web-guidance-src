+  <script>
+    const board = document.getElementById('order-board');
+    const statusRegion = document.getElementById('board-status');
+    let draggedCardId = null;
+
+    function updateColumnCounts() {
+      const columns = board.querySelectorAll('.board-column');
+      for (const col of columns) {
+        const countBadge = col.querySelector('.column-count');
+        if (countBadge) {
+          countBadge.textContent = String(col.querySelectorAll('.card').length);
+        }
+      }
+    }
+
+    function moveItemToColumn(itemId, columnId) {
+      const item = document.getElementById(itemId);
+      const column = document.getElementById(columnId);
+      if (!item || !column) return;
+
+      // Preserve element state with atomic moveBefore when available,
+      // while CSS containment on .board-column isolates layout recalculation.
+      if ('moveBefore' in Element.prototype) {
+        column.moveBefore(item, null);
+      } else {
+        column.appendChild(item);
+      }
+
+      updateColumnCounts();
+
+      const drinkTitle = item.querySelector('h3')?.textContent ?? 'Order';
+      const columnTitle = column.querySelector('.column-header h3')?.textContent ?? columnId;
+      if (statusRegion) {
+        statusRegion.textContent = `Moved ${drinkTitle} to ${columnTitle}.`;
+      }
+    }
+
+    board.addEventListener('dragstart', (event) => {
+      const card = event.target.closest('.card');
+      if (!card) return;
+      draggedCardId = card.id;
+      card.classList.add('dragging');
+      if (event.dataTransfer) {
+        event.dataTransfer.effectAllowed = 'move';
+        event.dataTransfer.setData('text/plain', card.id);
+      }
+    });
+
+    board.addEventListener('dragend', (event) => {
+      const card = event.target.closest('.card');
+      if (card) {
+        card.classList.remove('dragging');
+      }
+      draggedCardId = null;
+      for (const col of board.querySelectorAll('.board-column.drag-over')) {
+        col.classList.remove('drag-over');
+      }
+    });
+
+    for (const column of board.querySelectorAll('.board-column')) {
+      column.addEventListener('dragover', (event) => {
+        event.preventDefault();
+        if (event.dataTransfer) {
+          event.dataTransfer.dropEffect = 'move';
+        }
+        if (!column.classList.contains('drag-over')) {
+          column.classList.add('drag-over');
+        }
+      });
+
+      column.addEventListener('dragleave', (event) => {
+        if (!column.contains(event.relatedTarget)) {
+          column.classList.remove('drag-over');
+        }
+      });
+
+      column.addEventListener('drop', (event) => {
+        event.preventDefault();
+        column.classList.remove('drag-over');
+        const itemId = event.dataTransfer?.getData('text/plain') || draggedCardId;
+        if (itemId) {
+          moveItemToColumn(itemId, column.id);
+        }
+      });
+    }
+  </script>
