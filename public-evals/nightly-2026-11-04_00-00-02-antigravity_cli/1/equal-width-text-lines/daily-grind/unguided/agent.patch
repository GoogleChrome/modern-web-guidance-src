+  <script>
+    (function () {
+      function fitHeroLockup() {
+        const lockup = document.querySelector('.hero h1');
+        if (!lockup) return;
+        const lines = lockup.querySelectorAll('.hero-line');
+        if (!lines.length) return;
+
+        const targetWidth = lockup.getBoundingClientRect().width;
+        if (targetWidth <= 0) return;
+
+        lines.forEach((line) => {
+          let fontSize = 100;
+          line.style.fontSize = fontSize + 'px';
+
+          for (let i = 0; i < 6; i++) {
+            const currentWidth = line.getBoundingClientRect().width;
+            if (currentWidth <= 0) break;
+            fontSize = fontSize * (targetWidth / currentWidth);
+            line.style.fontSize = fontSize.toFixed(4) + 'px';
+            if (Math.abs(currentWidth - targetWidth) < 0.05) break;
+          }
+        });
+      }
+
+      fitHeroLockup();
+      window.addEventListener('resize', fitHeroLockup);
+      window.addEventListener('DOMContentLoaded', fitHeroLockup);
+      window.addEventListener('load', fitHeroLockup);
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(fitHeroLockup);
+      }
+      if (typeof ResizeObserver !== 'undefined') {
+        const lockup = document.querySelector('.hero h1');
+        if (lockup) {
+          new ResizeObserver(fitHeroLockup).observe(lockup);
+        }
+      }
+    })();
+  </script>
