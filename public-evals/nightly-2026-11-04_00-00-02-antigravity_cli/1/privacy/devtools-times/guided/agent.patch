@@ -0,0 +1,21 @@
+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ session }) => {
+  if (session) {
+    session.destroy();
+  }
+
+  return new Response(
+    JSON.stringify({
+      message: 'Session terminated and site data cleared.',
+    }),
+    {
+      status: 200,
+      headers: {
+        'Content-Type': 'application/json',
+        'Clear-Site-Data': '"*"',
+        'Cache-Control': 'no-store, max-age=0',
+      },
+    }
+  );
+};
