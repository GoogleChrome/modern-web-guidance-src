+          script.src = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+          script.defer = true;
+          script.crossOrigin = 'anonymous';
+          script.referrerPolicy = 'no-referrer';
+          document.head.appendChild(script);
+        }
+
+        function initPrivacyUI() {
+          var banner = document.getElementById('privacy-consent-banner');
+          var analyticsCheckbox = document.getElementById('consent-analytics');
+          var adsCheckbox = document.getElementById('consent-ads');
+          var rejectBtn = document.getElementById('privacy-reject-all');
+          var saveBtn = document.getElementById('privacy-save-preferences');
+
+          if (!banner) return;
+
+          var stored = getStoredConsent();
+          var dntOrGpc = isPrivacySignalEnabled();
+
+          if (!stored) {
+            if (dntOrGpc) {
+              // Automatically honor DNT/GPC with strict opt-out default
+              var gpcConsent = { essential: true, analytics: false, ads: false, updatedAt: new Date().toISOString() };
+              try {
+                localStorage.setItem(STORAGE_KEY, JSON.stringify(gpcConsent));
+              } catch (e) {}
+            } else {
+              banner.classList.remove('hidden');
+            }
+          } else {
+            if (analyticsCheckbox) analyticsCheckbox.checked = Boolean(stored.analytics && !dntOrGpc);
+            if (adsCheckbox) adsCheckbox.checked = Boolean(stored.ads && !dntOrGpc);
+            loadAnalyticsIfConsented(stored);
+          }
+
+          function savePreferences(analyticsOptIn, adsOptIn) {
+            var updated = {
+              essential: true,
+              analytics: Boolean(analyticsOptIn && !isPrivacySignalEnabled()),
+              ads: Boolean(adsOptIn && !isPrivacySignalEnabled()),
+              updatedAt: new Date().toISOString(),
+            };
+            try {
+              localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
+            } catch (e) {}
+            if (analyticsCheckbox) analyticsCheckbox.checked = updated.analytics;
+            if (adsCheckbox) adsCheckbox.checked = updated.ads;
+            banner.classList.add('hidden');
+            window.dispatchEvent(new CustomEvent('privacy-consent-updated', { detail: updated }));
+            loadAnalyticsIfConsented(updated);
+          }
+
+          if (rejectBtn) {
+            rejectBtn.onclick = function () {
+              savePreferences(false, false);
+            };
+          }
+
+          if (saveBtn) {
+            saveBtn.onclick = function () {
+              savePreferences(
+                analyticsCheckbox ? analyticsCheckbox.checked : false,
+                adsCheckbox ? adsCheckbox.checked : false
+              );
+            };
+          }
+
+          var manageTriggers = document.querySelectorAll('[data-open-privacy-preferences]');
+          manageTriggers.forEach(function (el) {
+            el.addEventListener('click', function (e) {
+              e.preventDefault();
+              var current = getStoredConsent();
+              if (analyticsCheckbox) analyticsCheckbox.checked = Boolean(current && current.analytics);
+              if (adsCheckbox) adsCheckbox.checked = Boolean(current && current.ads);
+              banner.classList.remove('hidden');
+            });
+          });
+        }
+
+        if (document.readyState === 'loading') {
+          document.addEventListener('DOMContentLoaded', initPrivacyUI);
+        } else {
+          initPrivacyUI();
+        }
+        document.addEventListener('astro:page-load', initPrivacyUI);
+      })();
+    </script>
   </body>
 </html>
