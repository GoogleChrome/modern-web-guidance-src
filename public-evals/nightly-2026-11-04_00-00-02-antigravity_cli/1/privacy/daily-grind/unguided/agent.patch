+            var windowInput = document.getElementById('pickup-window');
+
+            var rawAlias = aliasInput ? aliasInput.value : '';
+            var cleanAlias = redactPIIInString(sanitizeText(rawAlias, 24));
+            if (!cleanAlias) {
+              showStatusMessage('order-status-msg', 'Please enter a valid pickup alias or initials (1-24 characters).', 'badge-warn');
+              return;
+            }
+
+            var ticket = {
+              pickupAlias: cleanAlias,
+              drink: sanitizeText(drinkInput ? drinkInput.value : 'Maple Oat Latte', 40),
+              pickupWindow: sanitizeText(windowInput ? windowInput.value : '10-15 mins', 20),
+              ticketCode: 'DG-' + Math.floor(1000 + Math.random() * 9000)
+            };
+
+            SecureStorage.setItem('active_order', ticket, DEFAULT_TTL_MS, 'express-pickup-order');
+            orderForm.reset();
+            showStatusMessage(
+              'order-status-msg',
+              'Order queued under alias "' + ticket.pickupAlias + '" (Ticket ' + ticket.ticketCode + '). Stored in ephemeral session storage with a 15-minute TTL.',
+              'badge-success'
+            );
+          });
+        }
+
+        // Coarse-Location Store Lookup Form (3-digit ZIP prefix only)
+        var locationForm = document.getElementById('location-lookup-form');
+        if (locationForm) {
+          locationForm.addEventListener('submit', function (e) {
+            e.preventDefault();
+            var zipInput = document.getElementById('zip-prefix');
+            var prefix = sanitizeText(zipInput ? zipInput.value : '', 3).replace(/[^0-9]/g, '');
+            if (prefix.length !== 3) {
+              showStatusMessage('location-results', 'Please enter a 3-digit postal prefix (e.g., 100, 606, 941, 981).', 'badge-warn');
+              return;
+            }
+            var match = ROASTERY_DIRECTORY[prefix] ||
+              ('Regional Partner Roastery serving prefix ' + prefix + 'xx — Local bean delivery & counter pickup available.');
+            showStatusMessage('location-results', 'Closest Location: ' + match + ' (Evaluated locally; zero location data stored or transmitted).', 'badge-success');
+          });
+        }
+
+        // Privacy-First Rewards Form (Strict Opt-In & Email Masking)
+        var rewardsForm = document.getElementById('rewards-form');
+        if (rewardsForm) {
+          rewardsForm.addEventListener('submit', function (e) {
+            e.preventDefault();
+            var emailInput = document.getElementById('rewards-email');
+            var termsConsent = document.getElementById('rewards-terms-consent');
+            var digestConsent = document.getElementById('seasonal-digest-optin');
+
+            if (!termsConsent || !termsConsent.checked) {
+              showStatusMessage('rewards-status-msg', 'Explicit opt-in consent is required before storing a loyalty token.', 'badge-warn');
+              return;
+            }
+
+            var rawEmail = emailInput ? emailInput.value : '';
+            if (!rawEmail || rawEmail.indexOf('@') === -1) {
+              showStatusMessage('rewards-status-msg', 'Please enter a valid email address.', 'badge-warn');
+              return;
+            }
+
+            var masked = maskEmail(rawEmail);
+            var digestAllowed = Boolean(digestConsent && digestConsent.checked && !auditState.gpcOrDntActive);
+
+            SecureStorage.setItem('loyalty_member', {
+              maskedContact: masked,
+              seasonalDigestOptIn: digestAllowed
+            }, DEFAULT_TTL_MS, 'opt-in-loyalty-session');
+
+            rewardsForm.reset();
+            detectPrivacySignals();
+            showStatusMessage(
+              'rewards-status-msg',
+              'Rewards token active for masked identity ' + masked + ' (Seasonal digest: ' + (digestAllowed ? 'Opted In' : 'Off') + ').',
+              'badge-success'
+            );
+          });
+        }
+
+        // Privacy Preferences Form
+        var prefsForm = document.getElementById('privacy-preferences-form');
+        if (prefsForm) {
+          prefsForm.addEventListener('submit', function (e) {
+            e.preventDefault();
+            var allowExternalMedia = Boolean(document.getElementById('pref-external-media') && document.getElementById('pref-external-media').checked);
+            var rememberUi = Boolean(document.getElementById('pref-remember-ui') && document.getElementById('pref-remember-ui').checked);
+            var allowDiag = Boolean(document.getElementById('pref-diagnostics') && document.getElementById('pref-diagnostics').checked && !auditState.gpcOrDntActive);
+
+            enforceHeroMediaPolicy(allowExternalMedia);
+
+            if (rememberUi) {
+              SecureStorage.setItem('privacy_prefs', {
+                externalMedia: allowExternalMedia,
+                diagnostics: allowDiag
+              }, DEFAULT_TTL_MS, 'user-privacy-preferences');
+            } else {
+              window.sessionStorage.removeItem(STORAGE_PREFIX + 'privacy_prefs');
+            }
+
+            runThirdPartyAudit();
+            showStatusMessage('prefs-status-msg', 'Privacy preferences updated and enforced.', 'badge-success');
+          });
+        }
+
+        // Secure POST Logout Form
+        var logoutForm = document.getElementById('logout-form');
+        if (logoutForm) {
+          logoutForm.addEventListener('submit', function (e) {
+            e.preventDefault();
+            SecureStorage.clearAllUserData();
+            enforceHeroMediaPolicy(false);
+            runThirdPartyAudit();
+            showStatusMessage('dsar-status-msg', 'Logged out via secure POST handler. All session storage, local storage, caches, and cookies have been purged.', 'badge-success');
+          });
+        }
+
+        // DSAR Controls: Refresh Inspector, Export JSON, Purge All Data
+        var inspectBtn = document.getElementById('inspect-storage-btn');
+        if (inspectBtn) {
+          inspectBtn.addEventListener('click', function () {
+            updateStorageInspectorUI();
+            showStatusMessage('dsar-status-msg', 'Storage inspector refreshed.', 'badge-success');
+          });
+        }
+
+        var exportBtn = document.getElementById('export-data-btn');
+        if (exportBtn) {
+          exportBtn.addEventListener('click', function () {
+            var payload = {
+              exportedAt: new Date().toISOString(),
+              service: 'The Daily Grind Coffee Co.',
+              privacySignalsHonored: auditState.gpcOrDntActive,
+              ephemeralStorage: SecureStorage.getSanitizedSnapshot()
+            };
+            var blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
+            var url = URL.createObjectURL(blob);
+            var a = document.createElement('a');
+            a.href = url;
+            a.download = 'daily-grind-data-export.json';
+            document.body.appendChild(a);
+            a.click();
+            document.body.removeChild(a);
+            setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
+            showStatusMessage('dsar-status-msg', 'Portable JSON data export generated.', 'badge-success');
+          });
+        }
+
+        var purgeBtn = document.getElementById('purge-data-btn');
+        if (purgeBtn) {
+          purgeBtn.addEventListener('click', function () {
+            SecureStorage.clearAllUserData();
+            enforceHeroMediaPolicy(false);
+            runThirdPartyAudit();
+            showStatusMessage('dsar-status-msg', 'All client-side storage, cookies, and caches permanently purged.', 'badge-success');
+          });
+        }
+
+        var auditBtn = document.getElementById('run-audit-btn');
+        if (auditBtn) {
+          auditBtn.addEventListener('click', function () {
+            runThirdPartyAudit();
+          });
+        }
+      }
+
+      /* ==========================================================================
+       * 10. INITIALIZATION & AUTOMATIC IDLE / TTL CLEANUP
+       * ========================================================================== */
+      var idleTimer = null;
+      function resetIdleTimer() {
+        if (idleTimer) clearTimeout(idleTimer);
+        idleTimer = setTimeout(function () {
+          SecureStorage.clearAllUserData();
+        }, IDLE_TIMEOUT_MS);
+      }
+
+      function init() {
+        sanitizeCurrentUrl();
+        detectPrivacySignals();
+        regenerateCsrfToken();
+        SecureStorage.purgeExpired();
+
+        // Allow Hero stock image by default per CSP allowlist & no-referrer mitigation, while enabling user opt-out toggle
+        enforceHeroMediaPolicy(true);
+
+        initRuntimeDomGuard();
+        bindEvents();
+        runThirdPartyAudit();
+        updateStorageInspectorUI();
+
+        // Periodic TTL cleanup every 15 seconds
+        setInterval(function () {
+          SecureStorage.purgeExpired();
+        }, 15000);
+
+        // Reset session inactivity timer on user interaction
+        ['click', 'keydown', 'submit'].forEach(function (evt) {
+          document.addEventListener(evt, resetIdleTimer, { passive: true });
+        });
+        resetIdleTimer();
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
 </body>
 
 </html>
