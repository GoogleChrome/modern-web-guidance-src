+  <script>
+    const progress = document.getElementById("loyalty-progress");
+    const progressValueText = document.getElementById("loyalty-progress-value");
+    const progressStatusText = document.getElementById("loyalty-progress-status");
+    const pointsText = document.getElementById("loyalty-points-text");
+    const addStampBtn = document.getElementById("add-stamp-btn");
+
+    if (!CSS.supports("width: attr(value type(<number>))")) {
+      progress.style.setProperty("--value", progress.getAttribute("value"));
+      const observer = new MutationObserver(() => {
+        progress.style.setProperty("--value", progress.getAttribute("value"));
+      });
+      observer.observe(progress, {
+        attributes: true,
+        attributeFilter: ["value"],
+      });
+    }
+
+    addStampBtn.addEventListener("click", () => {
+      const current = Number(progress.getAttribute("value")) || 0;
+      const next = current >= 100 ? 10 : Math.min(100, current + 10);
+      const drinks = next / 10;
+      const remaining = 10 - drinks;
+
+      progress.setAttribute("value", String(next));
+      progressValueText.textContent = `${drinks} / 10`;
+      progressStatusText.textContent = remaining === 0
+        ? "100% • Reward Ready!"
+        : `${next}% • ${remaining} drink${remaining === 1 ? "" : "s"} left`;
+      pointsText.textContent = `${next} / 100 Bean Points`;
+      addStampBtn.textContent = next === 100
+        ? "Redeem & Start New Card"
+        : "Log Drink Purchase (+10 pts)";
+    });
+  </script>
