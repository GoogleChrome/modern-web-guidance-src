+  <script>
+    (function checkInitialBackgroundState() {
+      const perfEntries =
+        typeof performance !== 'undefined' &&
+        typeof performance.getEntriesByType === 'function'
+          ? performance.getEntriesByType('visibility-state')
+          : [];
+
+      const initialEntry = perfEntries.length > 0 ? perfEntries[0] : null;
+      const usedFallback = !initialEntry;
+
+      const backgrounded = Boolean(
+        initialEntry
+          ? initialEntry.name === 'hidden'
+          : typeof document !== 'undefined' &&
+              (document.visibilityState === 'hidden' || document.hidden === true)
+      );
+
+      const timestamp = Date.now();
+      const note = usedFallback
+        ? 'Fallback check (document.visibilityState / document.hidden) used; older fallback checks are unreliable for async scripts because tab visibility may change before the async script executes.'
+        : 'Checked via visibility-state PerformanceEntry; note that older fallback checks (document.visibilityState / document.hidden) are unreliable for async scripts because tab visibility may change before the async script executes.';
+
+      const visibilityLog = {
+        backgrounded,
+        timestamp,
+        startTime: initialEntry ? initialEntry.startTime : performance.now(),
+        method: usedFallback ? 'document.visibilityState-fallback' : 'visibility-state-entry',
+        note
+      };
+
+      console.log(visibilityLog);
+    })();
+  </script>
+
