+  <script>
+    const signupForm = document.getElementById('signup-form');
+    const togglePasswordBtn = document.getElementById('toggle-password');
+    const passwordInput = document.getElementById('new-password');
+    const submitBtn = document.getElementById('signup-submit');
+
+    togglePasswordBtn.addEventListener('click', () => {
+      const isPassword = passwordInput.type === 'password';
+      passwordInput.type = isPassword ? 'text' : 'password';
+      togglePasswordBtn.textContent = isPassword ? 'Hide password' : 'Show password';
+      togglePasswordBtn.setAttribute('aria-pressed', String(isPassword));
+      togglePasswordBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
+    });
+
+    const fields = [
+      {
+        input: document.getElementById('full-name'),
+        errorEl: document.getElementById('full-name-error'),
+        getMessage(input) {
+          if (input.validity.valueMissing) return 'Please enter your full name.';
+          if (input.validity.patternMismatch) return 'Please enter a valid name.';
+          return input.validationMessage;
+        }
+      },
+      {
+        input: document.getElementById('email'),
+        errorEl: document.getElementById('email-error'),
+        getMessage(input) {
+          if (input.validity.valueMissing) return 'Please enter your email address.';
+          if (input.validity.typeMismatch) return 'Please enter a valid email address.';
+          return input.validationMessage;
+        }
+      },
+      {
+        input: passwordInput,
+        errorEl: document.getElementById('password-error'),
+        getMessage(input) {
+          if (input.validity.valueMissing) return 'Please enter a password.';
+          if (input.validity.tooShort) return 'Password must be at least 8 characters.';
+          return input.validationMessage;
+        }
+      }
+    ];
+
+    fields.forEach(({ input, errorEl, getMessage }) => {
+      input.addEventListener('blur', () => {
+        if (!input.validity.valid) {
+          errorEl.textContent = getMessage(input);
+        }
+      });
+
+      input.addEventListener('input', () => {
+        input.setCustomValidity('');
+        errorEl.textContent = '';
+      });
+    });
+
+    signupForm.addEventListener('submit', (e) => {
+      if (!signupForm.checkValidity()) {
+        e.preventDefault();
+        let firstInvalid = null;
+        fields.forEach(({ input, errorEl, getMessage }) => {
+          if (!input.validity.valid) {
+            errorEl.textContent = getMessage(input);
+            if (!firstInvalid) firstInvalid = input;
+          }
+        });
+        if (firstInvalid) firstInvalid.focus();
+        return;
+      }
+      submitBtn.disabled = true;
+    });
+  </script>
+
 </body>
 
