+  <script>
+    (function () {
+      const form = document.getElementById('signup-form');
+      const successBox = document.getElementById('signup-success');
+      const welcomeName = document.getElementById('welcome-name');
+
+      if (!form) return;
+
+      function setFieldError(inputEl, errorEl, hasError) {
+        if (hasError) {
+          inputEl.classList.add('input-error');
+          if (errorEl) errorEl.classList.add('visible');
+        } else {
+          inputEl.classList.remove('input-error');
+          if (errorEl) errorEl.classList.remove('visible');
+        }
+      }
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+
+        const firstName = document.getElementById('firstName');
+        const lastName = document.getElementById('lastName');
+        const email = document.getElementById('email');
+        const password = document.getElementById('password');
+        const confirmPassword = document.getElementById('confirmPassword');
+        const terms = document.getElementById('terms');
+
+        const isFirstValid = firstName.value.trim().length > 0;
+        const isLastValid = lastName.value.trim().length > 0;
+        const isEmailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
+        const isPasswordValid = password.value.length >= 8;
+        const isConfirmValid = confirmPassword.value === password.value && confirmPassword.value.length > 0;
+        const isTermsValid = terms.checked;
+
+        setFieldError(firstName, document.getElementById('firstName-error'), !isFirstValid);
+        setFieldError(lastName, document.getElementById('lastName-error'), !isLastValid);
+        setFieldError(email, document.getElementById('email-error'), !isEmailValid);
+        setFieldError(password, document.getElementById('password-error'), !isPasswordValid);
+        setFieldError(confirmPassword, document.getElementById('confirmPassword-error'), !isConfirmValid);
+        setFieldError(terms, document.getElementById('terms-error'), !isTermsValid);
+
+        if (isFirstValid && isLastValid && isEmailValid && isPasswordValid && isConfirmValid && isTermsValid) {
+          welcomeName.textContent = firstName.value.trim();
+          form.style.display = 'none';
+          document.querySelector('.signup-form-header').style.display = 'none';
+          successBox.classList.add('visible');
+        }
+      });
+    })();
+  </script>
+
 </body>
 
