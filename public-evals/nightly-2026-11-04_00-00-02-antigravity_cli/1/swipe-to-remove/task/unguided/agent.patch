+  <script>
+    (function () {
+      const list = document.querySelector('.SwipeableList');
+      const emptyMsg = document.getElementById('cart-empty');
+      if (!list) return;
+
+      const items = list.querySelectorAll('.SwipeableList-item');
+
+      items.forEach((item) => {
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        if (!track || !content) return;
+
+        let startX = 0;
+        let currentX = 0;
+        let isDragging = false;
+        let isRemoved = false;
+
+        const getThreshold = () => Math.min(120, (item.offsetWidth || 300) * 0.3);
+
+        const updateVisuals = (deltaX) => {
+          content.style.transform = `translateX(${deltaX}px)`;
+          const threshold = getThreshold();
+          if (Math.abs(deltaX) >= threshold) {
+            track.classList.add('is-active');
+            item.classList.add('is-active');
+            track.style.backgroundColor = '#d32f2f';
+          } else {
+            track.classList.remove('is-active');
+            item.classList.remove('is-active');
+            track.style.backgroundColor = Math.abs(deltaX) > 0 ? '#ef9a9a' : '';
+          }
+        };
+
+        const startDrag = (clientX) => {
+          if (isRemoved) return;
+          isDragging = true;
+          startX = clientX;
+          currentX = 0;
+          content.style.transition = 'none';
+          item.style.maxHeight = `${item.offsetHeight}px`;
+        };
+
+        const moveDrag = (clientX) => {
+          if (!isDragging || isRemoved) return;
+          currentX = clientX - startX;
+          updateVisuals(currentX);
+        };
+
+        const endDrag = () => {
+          if (!isDragging || isRemoved) return;
+          isDragging = false;
+          const threshold = getThreshold();
+
+          if (Math.abs(currentX) >= threshold) {
+            isRemoved = true;
+            const direction = currentX >= 0 ? 1 : -1;
+            const width = item.offsetWidth || 400;
+
+            track.classList.add('is-active');
+            item.classList.add('is-active');
+            track.style.backgroundColor = '#d32f2f';
+
+            content.style.transition = 'transform 0.25s ease-out';
+            content.style.transform = `translateX(${direction * width}px)`;
+
+            item.style.height = `${item.offsetHeight}px`;
+            item.style.maxHeight = `${item.offsetHeight}px`;
+            // Force reflow for smooth height collapse
+            void item.offsetHeight;
+
+            item.classList.add('is-removing');
+            item.style.transition = 'height 0.35s ease 0.15s, max-height 0.35s ease 0.15s, margin 0.35s ease 0.15s, padding 0.35s ease 0.15s, opacity 0.3s ease 0.1s';
+            item.style.height = '0px';
+            item.style.maxHeight = '0px';
+            item.style.marginBottom = '0px';
+            item.style.paddingTop = '0px';
+            item.style.paddingBottom = '0px';
+            item.style.opacity = '0';
+
+            setTimeout(() => {
+              item.remove();
+              if (list.querySelectorAll('.SwipeableList-item').length === 0 && emptyMsg) {
+                emptyMsg.style.display = 'block';
+              }
+            }, 520);
+          } else {
+            content.style.transition = 'transform 0.25s ease-out';
+            content.style.transform = 'translateX(0px)';
+            track.classList.remove('is-active');
+            item.classList.remove('is-active');
+            track.style.backgroundColor = '';
+          }
+        };
+
+        // Pointer events
+        content.addEventListener('pointerdown', (e) => {
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          startDrag(e.clientX);
+          if (content.setPointerCapture && e.pointerId !== undefined) {
+            try {
+              content.setPointerCapture(e.pointerId);
+            } catch (_) {}
+          }
+        });
+
+        content.addEventListener('pointermove', (e) => {
+          if (!isDragging) return;
+          moveDrag(e.clientX);
+        });
+
+        content.addEventListener('pointerup', endDrag);
+        content.addEventListener('pointercancel', endDrag);
+
+        // Mouse events fallback
+        content.addEventListener('mousedown', (e) => {
+          if (isDragging || e.button !== 0) return;
+          startDrag(e.clientX);
+        });
+
+        window.addEventListener('mousemove', (e) => {
+          if (!isDragging) return;
+          moveDrag(e.clientX);
+        });
+
+        window.addEventListener('mouseup', () => {
+          if (!isDragging) return;
+          endDrag();
+        });
+
+        // Touch events fallback
+        content.addEventListener('touchstart', (e) => {
+          if (isDragging || !e.touches || !e.touches[0]) return;
+          startDrag(e.touches[0].clientX);
+        }, { passive: true });
+
+        content.addEventListener('touchmove', (e) => {
+          if (!isDragging || !e.touches || !e.touches[0]) return;
+          moveDrag(e.touches[0].clientX);
+        }, { passive: true });
+
+        content.addEventListener('touchend', () => {
+          if (!isDragging) return;
+          endDrag();
+        });
+
+        content.addEventListener('touchcancel', () => {
+          if (!isDragging) return;
+          endDrag();
+        });
+      });
+    })();
+  </script>
 </body>
 
