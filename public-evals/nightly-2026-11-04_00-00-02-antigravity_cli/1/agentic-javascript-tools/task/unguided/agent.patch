diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,191 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const defaultMenuItems = [
+        {
+          name: "Maple Oat Latte",
+          description: "Creamy oat milk with a hint of Vermont maple syrup.",
+          category: "Seasonal",
+          url: "/menu/seasonal",
+          price: "$5.50"
+        },
+        {
+          name: "Dark Roast Espresso",
+          description: "Bold, smokey, and perfect for a morning boost.",
+          category: "Espresso",
+          url: "/menu/espresso",
+          price: "$3.75"
+        },
+        {
+          name: "Cold Brew",
+          description: "Steeped for 18 hours for maximum smoothness.",
+          category: "Cold Brew",
+          url: "/menu/cold-brew",
+          price: "$4.50"
+        }
+      ];
+
+      function getMenuItems() {
+        const cards = Array.from(document.querySelectorAll(".card"));
+        if (cards.length > 0) {
+          return cards.map((card) => {
+            const titleEl = card.querySelector("h3");
+            const descEl = card.querySelector("p");
+            const linkEl = card.querySelector("a");
+            const name = titleEl ? titleEl.textContent.trim() : "";
+            const fallback = defaultMenuItems.find(
+              (item) => item.name.toLowerCase() === name.toLowerCase()
+            );
+            return {
+              name,
+              description: descEl
+                ? descEl.textContent.trim()
+                : fallback
+                  ? fallback.description
+                  : "",
+              url: linkEl
+                ? linkEl.getAttribute("href")
+                : fallback
+                  ? fallback.url
+                  : "",
+              category: fallback ? fallback.category : "Coffee",
+              price: fallback ? fallback.price : undefined
+            };
+          });
+        }
+        return defaultMenuItems;
+      }
+
+      function findMenuItemByName(queryName) {
+        if (!queryName || typeof queryName !== "string") {
+          return null;
+        }
+        const normalizedQuery = queryName.trim().toLowerCase();
+        const items = getMenuItems();
+        return (
+          items.find((item) => item.name.toLowerCase() === normalizedQuery) ||
+          items.find(
+            (item) =>
+              item.name.toLowerCase().includes(normalizedQuery) ||
+              normalizedQuery.includes(item.name.toLowerCase())
+          ) ||
+          null
+        );
+      }
+
+      const toolName = "get_menu_item_details";
+      const abortController = new AbortController();
+
+      const menuLookupTool = {
+        name: toolName,
+        description:
+          "Look up details for a menu item (such as Maple Oat Latte, Dark Roast Espresso, or Cold Brew) by its name.",
+        inputSchema: {
+          type: "object",
+          properties: {
+            name: {
+              type: "string",
+              description:
+                "The name of the menu item to look up (e.g., 'Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew')."
+            }
+          },
+          required: ["name"]
+        },
+        execute: async (input = {}) => {
+          const rawName =
+            input.name || input.itemName || input.item || input.query || "";
+          const foundItem = findMenuItemByName(rawName);
+
+          if (!foundItem) {
+            const availableNames = getMenuItems()
+              .map((i) => i.name)
+              .join(", ");
+            const errorMessage = `Menu item "${rawName}" not found. Available items: ${availableNames}.`;
+            return {
+              isError: true,
+              error: errorMessage,
+              content: [
+                {
+                  type: "text",
+                  text: errorMessage
+                }
+              ]
+            };
+          }
+
+          const detailsText = `${foundItem.name}: ${foundItem.description}${
+            foundItem.price ? ` (Price: ${foundItem.price})` : ""
+          }${foundItem.url ? ` - Details URL: ${foundItem.url}` : ""}`;
+
+          return {
+            ...foundItem,
+            item: foundItem,
+            content: [
+              {
+                type: "text",
+                text: JSON.stringify(foundItem)
+              },
+              {
+                type: "text",
+                text: detailsText
+              }
+            ]
+          };
+        }
+      };
+
+      function registerMenuTool() {
+        if (typeof navigator !== "undefined" && navigator.modelContext) {
+          if (typeof navigator.modelContext.registerTool === "function") {
+            navigator.modelContext.registerTool(menuLookupTool, {
+              signal: abortController.signal
+            });
+          } else if (
+            typeof navigator.modelContext.provideContext === "function"
+          ) {
+            navigator.modelContext.provideContext({
+              tools: [menuLookupTool]
+            });
+          }
+        }
+      }
+
+      let isCleanedUp = false;
+      function cleanupMenuTool() {
+        if (isCleanedUp) return;
+        isCleanedUp = true;
+
+        abortController.abort();
+
+        if (typeof navigator !== "undefined" && navigator.modelContext) {
+          if (typeof navigator.modelContext.unregisterTool === "function") {
+            try {
+              navigator.modelContext.unregisterTool(toolName);
+            } catch (e) {
+              // Ignore errors if already unregistered via AbortSignal
+            }
+          }
+          if (typeof navigator.modelContext.clearContext === "function") {
+            try {
+              navigator.modelContext.clearContext();
+            } catch (e) {
+              // Ignore errors if clearContext is unsupported
+            }
+          }
+        }
+      }
+
+      registerMenuTool();
+
+      window.addEventListener("unload", cleanupMenuTool);
+      window.addEventListener("beforeunload", cleanupMenuTool);
+      window.addEventListener("pagehide", cleanupMenuTool);
+    })();
+  </script>
+
 </body>
 
 </html>
