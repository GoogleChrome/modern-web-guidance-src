+  <script>
+    (function () {
+      const sidebar = document.querySelector('.toc-sidebar');
+      const panel = document.querySelector('.seasonal-panel');
+      if (!sidebar || !panel) return;
+
+      const tocLinks = Array.from(sidebar.querySelectorAll('a[href^="#"]'));
+      const sections = Array.from(panel.querySelectorAll('.drink-section'));
+      if (!tocLinks.length || !sections.length) return;
+
+      let programmaticScroll = null;
+      let programmaticTimer = null;
+
+      function clearProgrammaticScroll() {
+        programmaticScroll = null;
+        if (programmaticTimer) {
+          clearTimeout(programmaticTimer);
+          programmaticTimer = null;
+        }
+      }
+
+      function setActiveSection(activeId) {
+        if (!activeId) return;
+
+        tocLinks.forEach((link) => {
+          const linkTargetId = link.getAttribute('href').slice(1);
+          const isMatch = linkTargetId === activeId;
+          link.classList.toggle('active', isMatch);
+          if (link.parentElement && link.parentElement.tagName === 'LI') {
+            link.parentElement.classList.toggle('active', isMatch);
+          }
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        sections.forEach((section) => {
+          const isMatch = section.id === activeId;
+          section.classList.toggle('active', isMatch);
+        });
+      }
+
+      function getClosestSectionId() {
+        const currentScrollTop = panel.scrollTop;
+        let closestId = sections[0].id;
+        let minDistance = Infinity;
+
+        sections.forEach((section) => {
+          const header = section.querySelector('header') || section;
+          const snapTop = section.offsetTop;
+          const distance = Math.abs(snapTop - currentScrollTop);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestId = section.id || header.id;
+          }
+        });
+
+        return closestId;
+      }
+
+      function handleScroll() {
+        if (programmaticScroll) {
+          const current = panel.scrollTop;
+          const minBound = Math.min(programmaticScroll.startTop, programmaticScroll.targetTop) - 4;
+          const maxBound = Math.max(programmaticScroll.startTop, programmaticScroll.targetTop) + 4;
+
+          if (Math.abs(current - programmaticScroll.targetTop) <= 4) {
+            setActiveSection(programmaticScroll.targetId);
+            clearProgrammaticScroll();
+            return;
+          }
+
+          if (current >= minBound && current <= maxBound) {
+            return;
+          }
+
+          clearProgrammaticScroll();
+        }
+
+        const activeId = getClosestSectionId();
+        setActiveSection(activeId);
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            if (programmaticScroll) return;
+            let bestEntry = null;
+            entries.forEach((entry) => {
+              if (entry.isIntersecting) {
+                if (!bestEntry || entry.intersectionRatio > bestEntry.intersectionRatio) {
+                  bestEntry = entry;
+                }
+              }
+            });
+            if (bestEntry && bestEntry.intersectionRatio >= 0.55) {
+              setActiveSection(bestEntry.target.id);
+            }
+          },
+          {
+            root: panel,
+            threshold: [0.55, 0.75, 0.95]
+          }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      panel.addEventListener('scroll', handleScroll, { passive: true });
+      panel.addEventListener('scrollend', () => {
+        clearProgrammaticScroll();
+        setActiveSection(getClosestSectionId());
+      });
+
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          event.preventDefault();
+          const targetId = link.getAttribute('href').slice(1);
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          const targetHeader = targetSection.querySelector('header') || targetSection;
+          const targetTop = targetHeader.offsetTop;
+
+          clearProgrammaticScroll();
+          setActiveSection(targetId);
+
+          programmaticScroll = {
+            targetId,
+            startTop: panel.scrollTop,
+            targetTop
+          };
+
+          programmaticTimer = setTimeout(() => {
+            clearProgrammaticScroll();
+            setActiveSection(getClosestSectionId());
+          }, 600);
+
+          panel.scrollTo({
+            top: targetTop,
+            behavior: 'smooth'
+          });
+
+          if (history.replaceState) {
+            history.replaceState(null, '', '#' + targetId);
+          }
+        });
+      });
+
+      setActiveSection(getClosestSectionId());
+    })();
+  </script>
+
