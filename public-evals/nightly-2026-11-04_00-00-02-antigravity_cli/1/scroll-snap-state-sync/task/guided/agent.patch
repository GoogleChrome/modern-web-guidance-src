+  <script>
+    (() => {
+      const panel = document.querySelector('.seasonal-panel');
+      const tocLinks = document.querySelectorAll('.toc-sidebar a');
+      const sections = document.querySelectorAll('.drink-section');
+      const headers = document.querySelectorAll('.drink-section header');
+
+      if (!panel || !tocLinks.length || !sections.length) return;
+
+      const setActiveDrink = (id) => {
+        if (!id) return;
+        tocLinks.forEach((link) => {
+          const isActive = link.getAttribute('href') === `#${id}`;
+          link.classList.toggle('active', isActive);
+          link.classList.toggle('target-current', isActive);
+          if (isActive) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      };
+
+      // Smoothly scroll the panel to the target drink section on TOC link click
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const href = link.getAttribute('href');
+          if (!href || !href.startsWith('#')) return;
+          const targetId = href.slice(1);
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          event.preventDefault();
+          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          const targetHeader = targetSection.querySelector('header, h3') || targetSection;
+
+          // Scroll the seasonal-panel container smoothly to the target section header
+          targetHeader.scrollIntoView({
+            behavior: prefersReducedMotion ? 'auto' : 'smooth',
+            block: 'start',
+          });
+
+          setActiveDrink(targetId);
+
+          // Move focus to the section heading for keyboard navigation operability
+          const focusHeading = targetSection.querySelector('h3[tabindex="-1"]');
+          if (focusHeading) {
+            focusHeading.focus({ preventScroll: true });
+          }
+        });
+      });
+
+      // 1. Native scrollsnapchange listener for browsers supporting Scroll Snap Events
+      if ('onscrollsnapchange' in HTMLElement.prototype) {
+        panel.addEventListener('scrollsnapchange', (event) => {
+          const snappedEl = event.snapTargetBlock;
+          if (!snappedEl) return;
+          const section = snappedEl.closest('.drink-section');
+          if (section && section.id) {
+            setActiveDrink(section.id);
+          }
+        });
+      } else {
+        // 2. Fallback: IntersectionObserver to detect which drink-section header is at the top of the panel
+        const observer = new IntersectionObserver(
+          () => {
+            const panelRect = panel.getBoundingClientRect();
+            const topEntry = [...headers].reduce((currentTop, header) => {
+              const { bottom } = header.getBoundingClientRect();
+              if (bottom < panelRect.top) return currentTop;
+              if (!currentTop) return header;
+              return bottom < currentTop.getBoundingClientRect().bottom
+                ? header
+                : currentTop;
+            }, undefined);
+
+            if (topEntry) {
+              const section = topEntry.closest('.drink-section');
+              if (section && section.id) {
+                setActiveDrink(section.id);
+              }
+            }
+          },
+          { root: panel, threshold: [0, 0.5, 0.9] }
+        );
+
+        headers.forEach((header) => observer.observe(header));
+      }
+
+      // Sync aria-current on scrollend if CSS scroll-target-group is supported
+      if (typeof CSS !== 'undefined' && CSS.supports('scroll-target-group: auto')) {
+        panel.addEventListener('scrollend', () => {
+          const currentLink = document.querySelector('.toc-sidebar a:target-current');
+          if (currentLink) {
+            const href = currentLink.getAttribute('href');
+            if (href && href.startsWith('#')) {
+              setActiveDrink(href.slice(1));
+            }
+          }
+        });
+      }
+    })();
+  </script>
