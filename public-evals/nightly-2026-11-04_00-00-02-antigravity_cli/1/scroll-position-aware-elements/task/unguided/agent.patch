+      font-weight: 600;
+      text-decoration: none;
+      cursor: pointer;
+      box-shadow: 0 6px 16px rgba(62, 39, 35, 0.3);
+
+      /* Start out hidden at the top of the container without breaking Tab navigation */
+      opacity: 0;
+      visibility: hidden;
+      transform: translateY(2rem);
+      translate: 0 2rem;
+      pointer-events: none;
+
+      transition:
+        opacity 0.3s ease,
+        transform 0.3s ease,
+        translate 0.3s ease,
+        visibility 0.3s allow-discrete,
+        background-color 0.3s ease,
+        box-shadow 0.3s ease;
+      transition-behavior: allow-discrete;
+    }
+
+    .back-to-top:hover,
+    .back-to-top:focus-visible {
+      background-color: var(--text);
+      box-shadow: 0 8px 20px rgba(62, 39, 35, 0.45);
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .back-to-top svg {
+      width: 1.1rem;
+      height: 1.1rem;
+      fill: none;
+      stroke: currentColor;
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+    }
+
+    @container scroll-state(scrollable: top) {
+      .back-to-top {
+        opacity: 1;
+        visibility: visible;
+        transform: translateY(0);
+        translate: 0 0;
+        pointer-events: auto;
+      }
+    }
