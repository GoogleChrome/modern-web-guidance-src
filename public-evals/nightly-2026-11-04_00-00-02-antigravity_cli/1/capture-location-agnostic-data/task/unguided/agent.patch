+  <script>
+    (function () {
+      const REMINDER_STORAGE_KEY = 'dailyGrind_pickupReminderTime';
+      const ANNIVERSARY_STORAGE_KEY = 'dailyGrind_coffeeAnniversaryDate';
+
+      const MONTH_NAMES = [
+        'January', 'February', 'March', 'April', 'May', 'June',
+        'July', 'August', 'September', 'October', 'November', 'December'
+      ];
+
+      const reminderInput = document.getElementById('pickup-reminder-time');
+      const anniversaryInput = document.getElementById('coffee-anniversary-date');
+      const reminderDisplay = document.getElementById('pickup-reminder-display');
+      const anniversaryDisplay = document.getElementById('coffee-anniversary-display');
+      const form = document.getElementById('coffee-preferences-form');
+
+      /**
+       * Normalizes a wall-clock time string (HH:MM) in a location-agnostic manner
+       * using Temporal.PlainTime when available or direct string parsing without Date/timezone conversion.
+       */
+      function normalizePlainTime(rawValue) {
+        if (!rawValue || typeof rawValue !== 'string') return '';
+        const trimmed = rawValue.trim();
+        if (!trimmed) return '';
+
+        if (typeof Temporal !== 'undefined' && Temporal.PlainTime) {
+          try {
+            const plainTime = Temporal.PlainTime.from(trimmed);
+            const hh = String(plainTime.hour).padStart(2, '0');
+            const mm = String(plainTime.minute).padStart(2, '0');
+            return hh + ':' + mm;
+          } catch (_) {
+            return '';
+          }
+        }
+
+        const match = /^(\d{2}):(\d{2})(?::\d{2}(?:\.\d+)?)?$/.exec(trimmed);
+        if (!match) return '';
+        const hour = Number(match[1]);
+        const minute = Number(match[2]);
+        if (hour < 0 || hour > 23 || minute < 0 || minute > 59) return '';
+        return String(hour).padStart(2, '0') + ':' + String(minute).padStart(2, '0');
+      }
+
+      /**
+       * Normalizes a calendar date string (YYYY-MM-DD) in a location-agnostic manner
+       * using Temporal.PlainDate when available or direct string parsing without Date/timezone conversion.
+       */
+      function normalizePlainDate(rawValue) {
+        if (!rawValue || typeof rawValue !== 'string') return '';
+        const trimmed = rawValue.trim();
+        if (!trimmed) return '';
+
+        if (typeof Temporal !== 'undefined' && Temporal.PlainDate) {
+          try {
+            const plainDate = Temporal.PlainDate.from(trimmed);
+            return plainDate.toString();
+          } catch (_) {
+            return '';
+          }
+        }
+
+        const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(trimmed);
+        if (!match) return '';
+        const year = Number(match[1]);
+        const month = Number(match[2]);
+        const day = Number(match[3]);
+        if (month < 1 || month > 12 || day < 1 || day > 31) return '';
+        return (
+          String(year).padStart(4, '0') +
+          '-' +
+          String(month).padStart(2, '0') +
+          '-' +
+          String(day).padStart(2, '0')
+        );
+      }
+
+      function formatPlainTimeForDisplay(plainTimeStr) {
+        const normalized = normalizePlainTime(plainTimeStr);
+        if (!normalized) return 'Not set';
+        const parts = normalized.split(':');
+        const hour24 = Number(parts[0]);
+        const minute = parts[1];
+        const period = hour24 >= 12 ? 'PM' : 'AM';
+        const hour12 = hour24 % 12 === 0 ? 12 : hour24 % 12;
+        return normalized + ' (' + hour12 + ':' + minute + ' ' + period + ')';
+      }
+
+      function formatPlainDateForDisplay(plainDateStr) {
+        const normalized = normalizePlainDate(plainDateStr);
+        if (!normalized) return 'Not set';
+        const parts = normalized.split('-');
+        const year = Number(parts[0]);
+        const monthIndex = Number(parts[1]) - 1;
+        const day = Number(parts[2]);
+        const monthName = MONTH_NAMES[monthIndex] || parts[1];
+        return normalized + ' (' + monthName + ' ' + day + ', ' + year + ')';
+      }
+
+      function updateAndPersistPreferences() {
+        const plainTime = normalizePlainTime(reminderInput.value);
+        const plainDate = normalizePlainDate(anniversaryInput.value);
+
+        reminderDisplay.textContent = formatPlainTimeForDisplay(plainTime);
+        reminderDisplay.dataset.value = plainTime;
+
+        anniversaryDisplay.textContent = formatPlainDateForDisplay(plainDate);
+        anniversaryDisplay.dataset.value = plainDate;
+
+        try {
+          if (plainTime) {
+            localStorage.setItem(REMINDER_STORAGE_KEY, plainTime);
+          } else {
+            localStorage.removeItem(REMINDER_STORAGE_KEY);
+          }
+
+          if (plainDate) {
+            localStorage.setItem(ANNIVERSARY_STORAGE_KEY, plainDate);
+          } else {
+            localStorage.removeItem(ANNIVERSARY_STORAGE_KEY);
+          }
+        } catch (_) {
+          // Ignore storage quota or access errors in restricted environments
+        }
+      }
+
+      function loadSavedPreferences() {
+        try {
+          const savedTime = normalizePlainTime(localStorage.getItem(REMINDER_STORAGE_KEY) || '');
+          const savedDate = normalizePlainDate(localStorage.getItem(ANNIVERSARY_STORAGE_KEY) || '');
+
+          if (savedTime) {
+            reminderInput.value = savedTime;
+          }
+          if (savedDate) {
+            anniversaryInput.value = savedDate;
+          }
+
+          reminderDisplay.textContent = formatPlainTimeForDisplay(reminderInput.value);
+          reminderDisplay.dataset.value = normalizePlainTime(reminderInput.value);
+
+          anniversaryDisplay.textContent = formatPlainDateForDisplay(anniversaryInput.value);
+          anniversaryDisplay.dataset.value = normalizePlainDate(anniversaryInput.value);
+        } catch (_) {
+          // Ignore storage read errors
+        }
+      }
+
+      reminderInput.addEventListener('input', updateAndPersistPreferences);
+      reminderInput.addEventListener('change', updateAndPersistPreferences);
+      anniversaryInput.addEventListener('input', updateAndPersistPreferences);
+      anniversaryInput.addEventListener('change', updateAndPersistPreferences);
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        updateAndPersistPreferences();
+      });
+
+      loadSavedPreferences();
+    })();
+  </script>
 </body>
 
