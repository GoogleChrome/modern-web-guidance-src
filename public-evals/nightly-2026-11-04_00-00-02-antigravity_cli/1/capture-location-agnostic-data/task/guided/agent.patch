+  <script>
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+
+      const STORAGE_KEYS = {
+        time: 'dailyGrind_pickupReminderTime',
+        date: 'dailyGrind_coffeeAnniversaryDate',
+      };
+
+      const form = document.getElementById('coffee-preferences-form');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const displayTime = document.getElementById('display-pickup-time');
+      const displayDate = document.getElementById('display-anniversary-date');
+      const displayMonthDay = document.getElementById('display-anniversary-monthday');
+      const displayCombined = document.getElementById('display-combined-datetime');
+      const statusToast = document.getElementById('preferences-status');
+
+      const savedTimeStr = localStorage.getItem(STORAGE_KEYS.time);
+      const savedDateStr = localStorage.getItem(STORAGE_KEYS.date);
+
+      if (savedTimeStr) timeInput.value = savedTimeStr;
+      if (savedDateStr) dateInput.value = savedDateStr;
+
+      function updateScheduleDisplay(showSavedMessage = false) {
+        if (!timeInput.value || !dateInput.value) return;
+
+        // Parse wall-clock time and calendar date using location-agnostic Temporal Plain types
+        const reminderTime = Temporal.PlainTime.from(timeInput.value);
+        const anniversaryDate = Temporal.PlainDate.from(dateInput.value);
+
+        // Extract recurring annual month-day with explicit ISO 8601 calendar
+        const recurringAnniversary = Temporal.PlainMonthDay.from({
+          month: anniversaryDate.month,
+          day: anniversaryDate.day,
+          calendar: 'iso8601',
+        });
+
+        // Combine calendar date and wall-clock time without binding to any time zone
+        const localAppointment = anniversaryDate.toPlainDateTime(reminderTime);
+
+        // Compare against today's calendar date to check if today is the anniversary
+        const today = Temporal.Now.plainDateISO();
+        const isAnniversaryToday = recurringAnniversary.equals(today.toPlainMonthDay());
+        const nextOccurrence = recurringAnniversary.toPlainDate({ year: today.year });
+
+        displayTime.textContent = `${reminderTime.toLocaleString([], { hour: '2-digit', minute: '2-digit' })} (${reminderTime.toString().slice(0, 5)} wall-clock)`;
+        displayDate.textContent = `${anniversaryDate.toLocaleString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })} (${anniversaryDate.toString()})`;
+        displayMonthDay.textContent = isAnniversaryToday
+          ? `Happy Coffee Anniversary Today! (${recurringAnniversary.toString()})`
+          : `Annual Milestone: ${recurringAnniversary.toString()} (This year: ${nextOccurrence.toString()})`;
+        displayCombined.textContent = localAppointment.toString();
+
+        localStorage.setItem(STORAGE_KEYS.time, reminderTime.toString().slice(0, 5));
+        localStorage.setItem(STORAGE_KEYS.date, anniversaryDate.toString());
+
+        if (showSavedMessage) {
+          statusToast.textContent = 'Preferences saved! Locked to your exact calendar date and wall-clock time across all time zones.';
+        }
+      }
+
+      timeInput.addEventListener('input', () => {
+        timeInput.setCustomValidity('');
+        statusToast.textContent = '';
+      });
+
+      dateInput.addEventListener('input', () => {
+        dateInput.setCustomValidity('');
+        statusToast.textContent = '';
+      });
+
+      timeInput.addEventListener('blur', () => updateScheduleDisplay(false));
+      dateInput.addEventListener('blur', () => updateScheduleDisplay(false));
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        updateScheduleDisplay(true);
+      });
+
+      updateScheduleDisplay(false);
+    })();
+  </script>
