+          } else {
+            statusBox.classList.add('status-fallback');
+          }
+          statusBox.textContent = result.message;
+          statusBox.hidden = false;
+          signupForm.reset();
+        } catch {
+          // If fetch fails, fall back to standard form submission
+          signupForm.submit();
+        } finally {
+          submitBtn.disabled = false;
+          submitBtn.textContent = 'Create Rewards Account';
+        }
+      });
+    }
+  </script>
 </body>
 
 </html>
