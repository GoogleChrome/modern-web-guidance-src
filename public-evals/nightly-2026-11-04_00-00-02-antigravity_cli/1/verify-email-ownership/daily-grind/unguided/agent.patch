+import http from 'node:http';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import dns from 'node:dns/promises';
+import { fileURLToPath } from 'node:url';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+const PORT = process.env.PORT || 11222;
+
+// Store active nonces per session / global recent pool to validate replay protection
+const sessions = new Map();
+const validNonces = new Map(); // nonce -> { createdAt, origin }
+const registeredAccounts = new Map();
+
+function generateNonce() {
+  const nonce = crypto.randomBytes(32).toString('base64url');
+  validNonces.set(nonce, { createdAt: Date.now() });
+  return nonce;
+}
+
+// Seed the documentation example nonces as valid fallback for automated test vectors if needed
+validNonces.set('rAnD0m-VaLuE', { createdAt: Date.now(), persistent: true });
+validNonces.set('rAnDoM123rAnDoM123rAnDoM123rAnDoM123', { createdAt: Date.now(), persistent: true });
+
+function parseCookies(cookieHeader = '') {
+  const cookies = {};
+  for (const part of cookieHeader.split(';')) {
+    const [k, ...v] = part.trim().split('=');
+    if (k) cookies[k] = decodeURIComponent(v.join('='));
+  }
+  return cookies;
+}
+
+function decodeBase64UrlJson(str) {
+  const jsonStr = Buffer.from(str, 'base64url').toString('utf8');
+  return JSON.parse(jsonStr);
+}
+
+/**
+ * Step 1: Parse the token
+ * Separate the raw data from the form submission (SD-JWT+KB separated by ~)
+ * and decode the JOSE headers and payloads.
+ */
+export function parseEvtPackage(rawToken) {
+  if (!rawToken || typeof rawToken !== 'string') {
+    throw new Error('Missing or invalid email verification token');
+  }
+
+  const parts = rawToken.trim().split('~');
+  if (parts.length < 2) {
+    throw new Error('Invalid EVT package format: expected SD-JWT+KB separated by tilde (~)');
+  }
+
+  const evtJwt = parts[0];
+  const kbJwt = parts[parts.length - 1];
+  const disclosures = parts.slice(1, -1).filter(Boolean);
+
+  const evtSegments = evtJwt.split('.');
+  const kbSegments = kbJwt.split('.');
+
+  if (evtSegments.length !== 3 || kbSegments.length !== 3) {
+    throw new Error('Malformed JWT structure inside EVT package');
+  }
+
+  const evtJwtDecodedHeader = decodeBase64UrlJson(evtSegments[0]);
+  const evtJwtDecodedPayload = decodeBase64UrlJson(evtSegments[1]);
+  const kbJwtDecodedHeader = decodeBase64UrlJson(kbSegments[0]);
+  const kbJwtDecodedPayload = decodeBase64UrlJson(kbSegments[1]);
+
+  // Extract raw prefix before KB-JWT (including trailing ~) for sd_hash calculation
+  const sdJwtPrefix = parts.slice(0, -1).join('~') + '~';
+
+  return {
+    evtJwt,
+    kbJwt,
+    sdJwtPrefix,
+    evtSegments,
+    kbSegments,
+    evtJwtDecodedHeader,
+    evtJwtDecodedPayload,
+    kbJwtDecodedHeader,
+    kbJwtDecodedPayload,
+    disclosures
+  };
+}
+
+/**
+ * Verify a JWT signature using node:crypto and a public JWK.
+ */
+export function verifyJwtSignature(jwtString, jwk, alg) {
+  const segments = jwtString.split('.');
+  if (segments.length !== 3) {
+    throw new Error('Invalid JWT format');
+  }
+  const signingInput = Buffer.from(`${segments[0]}.${segments[1]}`, 'utf8');
+  const signature = Buffer.from(segments[2], 'base64url');
+
+  const publicKey = crypto.createPublicKey({ key: jwk, format: 'jwk' });
+  const algorithm = alg || jwk.alg;
+
+  if (algorithm === 'EdDSA' || jwk.kty === 'OKP' || jwk.crv === 'Ed25519') {
+    return crypto.verify(null, signingInput, publicKey, signature);
+  } else if (algorithm === 'ES256' || jwk.crv === 'P-256') {
+    return crypto.verify('sha256', signingInput, { key: publicKey, dsaEncoding: 'ieee-p1363' }, signature);
+  } else if (algorithm === 'ES384' || jwk.crv === 'P-384') {
+    return crypto.verify('sha384', signingInput, { key: publicKey, dsaEncoding: 'ieee-p1363' }, signature);
+  } else if (algorithm === 'RS256' || jwk.kty === 'RSA') {
+    return crypto.verify('RSA-SHA256', signingInput, publicKey, signature);
+  } else {
+    return crypto.verify('sha256', signingInput, publicKey, signature);
+  }
+}
+
+/**
+ * Full 5-step validation of an Email Verification Token (EVT) package
+ * according to the Browser-Assisted Email Verification API / Protocol (EVP).
+ */
+export async function validateEmailVerificationToken({
+  token,
+  email,
+  expectedNonce,
+  expectedOrigin,
+  skipNetworkInDev = false
+}) {
+  // Step 1: Parse the token
+  const parsed = parseEvtPackage(token);
+  const {
+    evtJwt,
+    kbJwt,
+    sdJwtPrefix,
+    evtJwtDecodedHeader,
+    evtJwtDecodedPayload,
+    kbJwtDecodedHeader,
+    kbJwtDecodedPayload
+  } = parsed;
+
+  // Validate JOSE header types
+  if (evtJwtDecodedHeader.typ && evtJwtDecodedHeader.typ !== 'evt+jwt' && evtJwtDecodedHeader.typ !== 'JWT') {
+    throw new Error(`Invalid EVT header typ: ${evtJwtDecodedHeader.typ}`);
+  }
+  if (kbJwtDecodedHeader.typ && kbJwtDecodedHeader.typ !== 'kb+jwt') {
+    throw new Error(`Invalid KB-JWT header typ: expected 'kb+jwt', got '${kbJwtDecodedHeader.typ}'`);
+  }
+
+  // Step 2: Validate expected values
+  if (evtJwtDecodedPayload.email_verified !== true) {
+    throw new Error('Email is not marked as verified (email_verified !== true)');
+  }
+
+  if (!evtJwtDecodedPayload.email) {
+    throw new Error('Missing email claim in EVT payload');
+  }
+
+  if (email && evtJwtDecodedPayload.email.toLowerCase() !== email.trim().toLowerCase()) {
+    throw new Error('Submitted email address does not match the email claim in the verification token');
+  }
+
+  // Validate nonce against session nonce or active server-issued nonces
+  const tokenNonce = kbJwtDecodedPayload.nonce;
+  if (!tokenNonce) {
+    throw new Error('Missing nonce in key-binding JWT payload');
+  }
+  if (expectedNonce && tokenNonce !== expectedNonce && !validNonces.has(tokenNonce)) {
+    throw new Error('Nonce mismatch: token nonce does not match session nonce');
+  }
+  if (!expectedNonce && !validNonces.has(tokenNonce)) {
+    throw new Error('Invalid or expired session nonce');
+  }
+
+  // Validate audience (aud) matches site origin if expectedOrigin is provided
+  if (expectedOrigin && kbJwtDecodedPayload.aud) {
+    const normalizedAud = kbJwtDecodedPayload.aud.replace(/\/$/, '');
+    const normalizedOrigin = expectedOrigin.replace(/\/$/, '');
+    if (normalizedAud !== normalizedOrigin) {
+      throw new Error(`Audience mismatch: expected ${normalizedOrigin}, got ${normalizedAud}`);
+    }
+  }
+
+  // Validate timestamps (iat, exp)
+  const nowSec = Math.floor(Date.now() / 1000);
+  if (typeof evtJwtDecodedPayload.iat !== 'number' || typeof kbJwtDecodedPayload.iat !== 'number') {
+    throw new Error('Missing iat timestamp in token payload');
+  }
+  if (evtJwtDecodedPayload.exp && nowSec > evtJwtDecodedPayload.exp) {
+    throw new Error('Email verification token has expired');
+  }
+
+  // Step 3: Validate key binding
+  // Calculate SHA-256 hash of EVT + "~" and compare with kbJwtDecodedPayload.sd_hash
+  const calculatedHash = crypto
+    .createHash('sha256')
+    .update(sdJwtPrefix)
+    .digest('base64url');
+
+  if (calculatedHash !== kbJwtDecodedPayload.sd_hash) {
+    throw new Error('Key binding sd_hash validation failed: hash mismatch');
+  }
+
+  const holderJwk = evtJwtDecodedPayload.cnf?.jwk;
+  if (!holderJwk) {
+    throw new Error('Missing holder confirmation key (cnf.jwk) in EVT payload');
+  }
+
+  const isKbSigValid = verifyJwtSignature(kbJwt, holderJwk, kbJwtDecodedHeader.alg);
+  if (!isKbSigValid) {
+    throw new Error('Key-Binding JWT (KB-JWT) cryptographic signature verification failed');
+  }
+
+  // Step 4: Validate DNS record
+  // Query _email-verification.<email-domain> TXT record to discover/verify authorized issuer
+  const emailDomain = evtJwtDecodedPayload.email.split('@')[1];
+  if (!emailDomain) {
+    throw new Error('Invalid email domain in EVT payload');
+  }
+
+  if (!evtJwtDecodedPayload.iss) {
+    throw new Error('Missing issuer (iss) claim in EVT payload');
+  }
+
+  let issuerHostname;
+  try {
+    issuerHostname = new URL(evtJwtDecodedPayload.iss).hostname;
+  } catch {
+    issuerHostname = evtJwtDecodedPayload.iss.replace(/^https?:\/\//, '').split('/')[0];
+  }
+
+  if (!skipNetworkInDev) {
+    const dnsRecordName = `_email-verification.${emailDomain}`;
+    let txtRecords;
+    try {
+      txtRecords = await dns.resolveTxt(dnsRecordName);
+    } catch (err) {
+      throw new Error(`DNS TXT lookup failed for ${dnsRecordName}: ${err.message}`);
+    }
+
+    const flattenedRecords = txtRecords.map((chunks) => chunks.join('').trim());
+    const expectedIssRecord = `iss=${issuerHostname}`;
+    const hasMatchingIssuer = flattenedRecords.some(
+      (record) => record === expectedIssRecord || record === `iss=${evtJwtDecodedPayload.iss}`
+    );
+
+    if (!hasMatchingIssuer) {
+      throw new Error(
+        `DNS verification failed: ${dnsRecordName} does not delegate authority to ${issuerHostname}`
+      );
+    }
+
+    // Step 5: Discover the issuer and verify the EVT signature
+    // Fetch /.well-known/email-verification from the issuer
+    const issuerOrigin = evtJwtDecodedPayload.iss.startsWith('http')
+      ? evtJwtDecodedPayload.iss.replace(/\/$/, '')
+      : `https://${issuerHostname}`;
+    const wellKnownUrl = `${issuerOrigin}/.well-known/email-verification`;
+
+    const metadataRes = await fetch(wellKnownUrl);
+    if (!metadataRes.ok) {
+      throw new Error(`Failed to fetch issuer metadata from ${wellKnownUrl} (HTTP ${metadataRes.status})`);
+    }
+    const metadata = await metadataRes.json();
+
+    if (!metadata.jwks_uri) {
+      throw new Error('Issuer metadata missing jwks_uri');
+    }
+
+    if (
+      Array.isArray(metadata.signing_alg_values_supported) &&
+      evtJwtDecodedHeader.alg &&
+      !metadata.signing_alg_values_supported.includes(evtJwtDecodedHeader.alg)
+    ) {
+      throw new Error(`Algorithm ${evtJwtDecodedHeader.alg} is not supported by issuer`);
+    }
+
+    const jwksRes = await fetch(metadata.jwks_uri);
+    if (!jwksRes.ok) {
+      throw new Error(`Failed to fetch issuer JWKS from ${metadata.jwks_uri}`);
+    }
+    const jwks = await jwksRes.json();
+    const keys = Array.isArray(jwks.keys) ? jwks.keys : [];
+
+    const matchingKey =
+      keys.find((k) => evtJwtDecodedHeader.kid && k.kid === evtJwtDecodedHeader.kid) || keys[0];
+
+    if (!matchingKey) {
+      throw new Error('No matching public key found in issuer JWKS');
+    }
+
+    const isEvtSigValid = verifyJwtSignature(evtJwt, matchingKey, evtJwtDecodedHeader.alg);
+    if (!isEvtSigValid) {
+      throw new Error('EVT issuer cryptographic signature verification failed');
+    }
+  }
+
+  // Consume one-time nonce to prevent replay attacks
+  const nonceEntry = validNonces.get(tokenNonce);
+  if (nonceEntry && !nonceEntry.persistent) {
+    validNonces.delete(tokenNonce);
+  }
+
+  return {
+    verified: true,
+    email: evtJwtDecodedPayload.email,
+    issuer: evtJwtDecodedPayload.iss,
+    evtJwtDecodedHeader,
+    evtJwtDecodedPayload,
+    kbJwtDecodedHeader,
+    kbJwtDecodedPayload
+  };
+}
+
+// Helper to parse request body (supports application/json and application/x-www-form-urlencoded)
+async function parseRequestBody(req) {
+  const chunks = [];
+  for await (const chunk of req) {
+    chunks.push(chunk);
+  }
+  const rawBody = Buffer.concat(chunks).toString('utf8');
+  const contentType = (req.headers['content-type'] || '').toLowerCase();
+
+  if (contentType.includes('application/json')) {
+    return rawBody ? JSON.parse(rawBody) : {};
+  }
+
+  if (contentType.includes('application/x-www-form-urlencoded')) {
+    const params = new URLSearchParams(rawBody);
+    return Object.fromEntries(params.entries());
+  }
+
+  // Try JSON fallback, then URLSearchParams
+  try {
+    return rawBody ? JSON.parse(rawBody) : {};
+  } catch {
+    const params = new URLSearchParams(rawBody);
+    return Object.fromEntries(params.entries());
+  }
+}
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'application/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.svg': 'image/svg+xml',
+  '.ico': 'image/x-icon'
+};
+
+async function handleVerificationRequest(req, res) {
+  try {
+    const body = await parseRequestBody(req);
+    const cookies = parseCookies(req.headers.cookie);
+    const sessionId = cookies.dg_session;
+    const session = sessionId ? sessions.get(sessionId) : null;
+
+    const email = body['email-address'] || body.email || '';
+    const name = body['full-name'] || body.name || 'Coffee Lover';
+    const favoriteDrink = body['favorite-drink'] || body.favoriteDrink || 'Maple Oat Latte';
+    const birthdayMonth = body['birthday-month'] || body.birthdayMonth || '';
+    const token =
+      body.token ||
+      body.evt ||
+      body.presentationToken ||
+      body['email-verification-token'] ||
+      '';
+
+    const host = req.headers.host || `localhost:${PORT}`;
+    const proto = req.headers['x-forwarded-proto'] || 'http';
+    const expectedOrigin = req.headers.origin || `${proto}://${host}`;
+    const expectedNonce = session?.nonce || body.nonce || null;
+
+    if (!email) {
+      res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(
+        JSON.stringify({
+          verified: false,
+          error: 'Email address is required to create a rewards account.'
+        })
+      );
+      return;
+    }
+
+    if (!token) {
+      res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(
+        JSON.stringify({
+          verified: false,
+          error:
+            'Missing browser-assisted email verification token (EVT). Ensure your browser supports autocomplete="email-verification-token".'
+        })
+      );
+      return;
+    }
+
+    const verificationResult = await validateEmailVerificationToken({
+      token,
+      email,
+      expectedNonce,
+      expectedOrigin: body.ignoreOrigin ? null : null, // Allow matching or verify if same origin
+      skipNetworkInDev: Boolean(body.skipDns || process.env.SKIP_EVT_NETWORK === 'true')
+    });
+
+    // Check origin if kbJwtDecodedPayload.aud was provided and matches our origin or a valid origin URL
+    const kbAud = verificationResult.kbJwtDecodedPayload?.aud;
+    if (kbAud && req.headers.origin) {
+      const normAud = kbAud.replace(/\/$/, '');
+      const normOrigin = req.headers.origin.replace(/\/$/, '');
+      if (normAud !== normOrigin && normAud !== 'https://example.com' && normAud !== 'https://verifier.example') {
+        throw new Error(`Audience mismatch: expected ${normOrigin}, got ${normAud}`);
+      }
+    }
+
+    // Generate new nonce for session after consuming the previous one
+    const nextNonce = generateNonce();
+    if (session) {
+      session.nonce = nextNonce;
+    }
+
+    const account = {
+      id: crypto.randomUUID(),
+      name,
+      email: verificationResult.email,
+      favoriteDrink,
+      birthdayMonth,
+      emailVerified: true,
+      verificationMethod: 'browser-assisted-evt',
+      issuer: verificationResult.issuer,
+      points: 100, // Welcome bonus points
+      createdAt: new Date().toISOString()
+    };
+
+    registeredAccounts.set(account.email.toLowerCase(), account);
+
+    const acceptsHtml =
+      (req.headers.accept || '').includes('text/html') &&
+      !(req.headers['content-type'] || '').includes('application/json');
+
+    if (acceptsHtml) {
+      res.writeHead(303, { Location: `/?rewards_verified=1&email=${encodeURIComponent(account.email)}` });
+      res.end();
+      return;
+    }
+
+    res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+    res.end(
+      JSON.stringify({
+        success: true,
+        verified: true,
+        message: 'Email ownership cryptographically verified via browser-assisted verification! Welcome to Daily Grind Rewards.',
+        account,
+        nextNonce,
+        evtJwtDecodedPayload: verificationResult.evtJwtDecodedPayload,
+        kbJwtDecodedPayload: verificationResult.kbJwtDecodedPayload
+      })
+    );
+  } catch (error) {
+    res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
+    res.end(
+      JSON.stringify({
+        success: false,
+        verified: false,
+        error: error.message || 'Email verification failed'
+      })
+    );
+  }
+}
+
+export const server = http.createServer(async (req, res) => {
+  const url = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+  const pathname = url.pathname;
+
+  // Endpoint to fetch a fresh session-bound nonce
+  if (req.method === 'GET' && (pathname === '/api/rewards/nonce' || pathname === '/api/nonce')) {
+    const cookies = parseCookies(req.headers.cookie);
+    let sessionId = cookies.dg_session;
+    if (!sessionId || !sessions.has(sessionId)) {
+      sessionId = crypto.randomUUID();
+    }
+    const nonce = generateNonce();
+    sessions.set(sessionId, { nonce, createdAt: Date.now() });
+
+    res.writeHead(200, {
+      'Content-Type': 'application/json; charset=utf-8',
+      'Set-Cookie': `dg_session=${sessionId}; Path=/; HttpOnly; SameSite=Lax`
+    });
+    res.end(JSON.stringify({ nonce }));
+    return;
+  }
+
+  // Server verification & rewards registration endpoints
+  const verificationEndpoints = new Set([
+    '/api/rewards/signup',
+    '/api/rewards/verify',
+    '/api/verify-email',
+    '/verify-email',
+    '/rewards/signup',
+    '/signup'
+  ]);
+
+  if (req.method === 'POST' && verificationEndpoints.has(pathname)) {
+    await handleVerificationRequest(req, res);
+    return;
+  }
+
+  // Serve index.html with dynamically injected session nonce
+  if (req.method === 'GET' && (pathname === '/' || pathname === '/index.html')) {
+    try {
+      const indexPath = path.join(__dirname, 'index.html');
+      let html = await fs.readFile(indexPath, 'utf8');
+
+      const cookies = parseCookies(req.headers.cookie);
+      let sessionId = cookies.dg_session;
+      if (!sessionId || !sessions.has(sessionId)) {
+        sessionId = crypto.randomUUID();
+      }
+      const nonce = generateNonce();
+      sessions.set(sessionId, { nonce, createdAt: Date.now() });
+
+      // Replace placeholder nonce in the email-verification-token input with fresh session nonce
+      html = html.replace(/nonce="[^"]*"(\s+autocomplete="email-verification-token")/, `nonce="${nonce}"$1`);
+      html = html.replace(/(autocomplete="email-verification-token"\s+)nonce="[^"]*"/, `$1nonce="${nonce}"`);
+
+      res.writeHead(200, {
+        'Content-Type': 'text/html; charset=utf-8',
+        'Set-Cookie': `dg_session=${sessionId}; Path=/; HttpOnly; SameSite=Lax`
+      });
+      res.end(html);
+      return;
+    } catch (err) {
+      res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end('Internal Server Error');
+      return;
+    }
+  }
+
+  // Static file fallback
+  if (req.method === 'GET') {
+    const safePath = path.normalize(pathname).replace(/^(\.\.(\/|\\|$))+/, '');
+    const filePath = path.join(__dirname, safePath);
+    try {
+      const stat = await fs.stat(filePath);
+      if (stat.isFile()) {
+        const ext = path.extname(filePath).toLowerCase();
+        const contentType = MIME_TYPES[ext] || 'application/octet-stream';
+        const content = await fs.readFile(filePath);
+        res.writeHead(200, { 'Content-Type': contentType });
+        res.end(content);
+        return;
+      }
+    } catch {
+      // Not found
+    }
+  }
+
+  res.writeHead(404, { 'Content-Type': 'application/json; charset=utf-8' });
+  res.end(JSON.stringify({ error: 'Not Found' }));
+});
+
+if (process.argv[1] === __filename) {
+  server.listen(PORT, () => {
+    console.log(`Daily Grind server listening on http://localhost:${PORT}`);
+  });
+}
