+  <script>
+    document.addEventListener("DOMContentLoaded", () => {
+      const roastPicker = document.getElementById("roast-picker");
+      if (!roastPicker) return;
+
+      // Enable Left/Right arrow spatial navigation across the 3-column grid
+      roastPicker.addEventListener("keydown", (event) => {
+        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
+        const options = Array.from(roastPicker.querySelectorAll("option"));
+        const activeOption = document.activeElement?.tagName === "OPTION"
+          ? document.activeElement
+          : roastPicker.selectedOptions[0];
+        if (!activeOption) return;
+
+        const currentRect = activeOption.getBoundingClientRect();
+        if (currentRect.width === 0 && currentRect.height === 0) return;
+
+        const direction = event.key === "ArrowRight" ? 1 : -1;
+        let bestCandidate = null;
+        let bestDistance = Infinity;
+
+        for (const opt of options) {
+          if (opt === activeOption) continue;
+          const rect = opt.getBoundingClientRect();
+          const dx = (rect.left + rect.width / 2) - (currentRect.left + currentRect.width / 2);
+          if (direction * dx > 4) {
+            const dy = (rect.top + rect.height / 2) - (currentRect.top + currentRect.height / 2);
+            const dist = Math.hypot(dx, dy);
+            if (dist < bestDistance) {
+              bestDistance = dist;
+              bestCandidate = opt;
+            }
+          }
+        }
+
+        if (bestCandidate) {
+          event.preventDefault();
+          bestCandidate.focus();
+          roastPicker.value = bestCandidate.value;
+        }
+      });
+    });
+  </script>
