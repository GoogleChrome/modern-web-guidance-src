+  <script type="module">
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      :host {
+        display: block;
+        --_card-bg: var(--card-bg, #ffffff);
+        --_card-primary: var(--primary, #4e342e);
+        --_card-accent: var(--accent, #ffab40);
+        --_card-text: var(--text, #3e2723);
+      }
+
+      *,
+      *::before,
+      *::after {
+        box-sizing: border-box;
+      }
+
+      .card {
+        position: relative;
+        display: flex;
+        flex-direction: column;
+        align-items: center;
+        height: 100%;
+        background: var(--_card-bg);
+        color: var(--_card-text);
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+      }
+
+      .badge {
+        display: none;
+        background: var(--_card-accent);
+        color: var(--_card-text);
+        font-size: 0.75rem;
+        font-weight: 700;
+        text-transform: uppercase;
+        letter-spacing: 0.05em;
+        padding: 2px 10px;
+        border-radius: 999px;
+        margin-bottom: 8px;
+      }
+
+      :host(:state(has-badge)) .badge,
+      :host([limited]) .badge {
+        display: inline-block;
+      }
+
+      ::slotted([slot="badge"]) {
+        margin: 0;
+      }
+
+      ::slotted([slot="title"]) {
+        margin: 0 0 10px;
+        color: var(--_card-primary);
+      }
+
+      ::slotted(p),
+      ::slotted([slot="description"]) {
+        margin: 0;
+      }
+
+      ::slotted([slot="action"]) {
+        display: inline-block;
+        background: var(--_card-primary);
+        color: #ffffff;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+        transition: background 0.3s;
+      }
+
+      ::slotted([slot="action"]:hover) {
+        background: var(--_card-text);
+      }
+    `);
+
+    const template = document.createElement('template');
+    template.innerHTML = `
+      <article class="card" part="card">
+        <div class="badge" part="badge">
+          <slot name="badge">Limited</slot>
+        </div>
+        <slot name="title"></slot>
+        <slot name="description"></slot>
+        <slot></slot>
+        <slot name="action"></slot>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['limited'];
+      #internals;
+      #badgeSlot;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [sheet];
+        this.shadowRoot.append(template.content.cloneNode(true));
+
+        this.#badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+        this.#badgeSlot.addEventListener('slotchange', () => {
+          this.#syncBadgeState();
+        });
+      }
+
+      connectedCallback() {
+        this.#syncBadgeState();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal) {
+          this.#syncBadgeState();
+        }
+      }
+
+      get limited() {
+        return this.hasAttribute('limited');
+      }
+
+      set limited(on) {
+        this.toggleAttribute('limited', !!on);
+      }
+
+      #syncBadgeState() {
+        const hasBadge =
+          this.limited || this.#badgeSlot.assignedElements().length > 0;
+        if (hasBadge) {
+          this.#internals.states.add('has-badge');
+        } else {
+          this.#internals.states.delete('has-badge');
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
 </body>
 
