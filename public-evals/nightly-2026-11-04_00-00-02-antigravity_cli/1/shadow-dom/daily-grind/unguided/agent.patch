+  <template id="drink-card-template">
+    <style>
+      :host {
+        display: block;
+      }
+
+      *,
+      *::before,
+      *::after {
+        box-sizing: border-box;
+        margin: 0;
+        padding: 0;
+      }
+
+      .card {
+        position: relative;
+        background: white;
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+        color: var(--text, #3e2723);
+        height: 100%;
+        display: flex;
+        flex-direction: column;
+        justify-content: space-between;
+        align-items: center;
+      }
+
+      .badge {
+        display: none;
+        position: absolute;
+        top: 12px;
+        right: 12px;
+        background: var(--accent, #ffab40);
+        color: var(--text, #3e2723);
+        font-size: 0.75rem;
+        font-weight: bold;
+        text-transform: uppercase;
+        letter-spacing: 0.5px;
+        padding: 3px 8px;
+        border-radius: 12px;
+      }
+
+      .badge[data-visible="true"],
+      :host([limited]:not([limited="false"])) .badge,
+      :host([badge]:not([badge=""]):not([badge="false"])) .badge {
+        display: inline-block;
+      }
+
+      .card h3 {
+        margin-bottom: 10px;
+        color: var(--primary, #4e342e);
+      }
+
+      .card p {
+        flex-grow: 1;
+      }
+
+      .btn,
+      ::slotted([slot="action"]) {
+        display: inline-block;
+        background: var(--primary, #4e342e);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+        transition: background 0.3s;
+      }
+
+      .btn:hover,
+      ::slotted([slot="action"]:hover) {
+        background: #3e2723;
+      }
+    </style>
+    <article class="card" part="card">
+      <span class="badge" part="badge"><slot name="badge">Limited</slot></span>
+      <h3 part="title"><slot name="title"></slot></h3>
+      <p part="description"><slot name="description"></slot></p>
+      <div class="action-wrapper" part="action">
+        <slot name="action">
+          <a class="btn" href="#">View Details</a>
+        </slot>
+      </div>
+    </article>
+  </template>
+
+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['title', 'description', 'href', 'link', 'action-url', 'action-text', 'action-label', 'limited', 'badge'];
+      }
+
+      constructor() {
+        super();
+        const shadow = this.attachShadow({ mode: 'open' });
+        const template = document.getElementById('drink-card-template');
+        shadow.appendChild(template.content.cloneNode(true));
+        const badgeSlot = shadow.querySelector('slot[name="badge"]');
+        if (badgeSlot) {
+          badgeSlot.addEventListener('slotchange', () => this._syncBadgeVisibility());
+        }
+      }
+
+      connectedCallback() {
+        this._syncAttributes();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue) return;
+        this._syncAttributes(name);
+      }
+
+      get limited() {
+        return this.hasAttribute('limited') && this.getAttribute('limited') !== 'false';
+      }
+
+      set limited(val) {
+        if (val) {
+          this.setAttribute('limited', '');
+        } else {
+          this.removeAttribute('limited');
+        }
+      }
+
+      _syncBadgeVisibility() {
+        if (!this.shadowRoot) return;
+        const badgeEl = this.shadowRoot.querySelector('.badge');
+        const badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+        if (!badgeEl || !badgeSlot) return;
+
+        const assignedNodes = badgeSlot.assignedNodes({ flatten: false });
+        const hasSlottedBadge = assignedNodes.some(
+          node => node.nodeType === Node.ELEMENT_NODE || (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '')
+        );
+        const hasAttrBadge =
+          (this.hasAttribute('limited') && this.getAttribute('limited') !== 'false') ||
+          (this.hasAttribute('badge') && this.getAttribute('badge') !== '' && this.getAttribute('badge') !== 'false');
+
+        badgeEl.setAttribute('data-visible', String(hasSlottedBadge || hasAttrBadge));
+      }
+
+      _syncAttributes(changedAttr) {
+        if (!this.shadowRoot) return;
+
+        const titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+        const descSlot = this.shadowRoot.querySelector('slot[name="description"]');
+        const badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+        const fallbackLink = this.shadowRoot.querySelector('slot[name="action"] a.btn');
+
+        const titleAttr = this.getAttribute('title');
+        if (titleSlot && titleAttr !== null) {
+          titleSlot.textContent = titleAttr;
+          const slottedTitle = this.querySelector('[slot="title"]');
+          if (slottedTitle && changedAttr === 'title') {
+            slottedTitle.textContent = titleAttr;
+          }
+        }
+
+        const descAttr = this.getAttribute('description');
+        if (descSlot && descAttr !== null) {
+          descSlot.textContent = descAttr;
+          const slottedDesc = this.querySelector('[slot="description"]');
+          if (slottedDesc && changedAttr === 'description') {
+            slottedDesc.textContent = descAttr;
+          }
+        }
+
+        const badgeAttr = this.getAttribute('badge');
+        const limitedAttr = this.getAttribute('limited');
+        if (badgeSlot) {
+          if (badgeAttr && badgeAttr !== 'true' && badgeAttr !== 'false') {
+            badgeSlot.textContent = badgeAttr;
+          } else if (limitedAttr && limitedAttr !== '' && limitedAttr !== 'true' && limitedAttr !== 'false') {
+            badgeSlot.textContent = limitedAttr;
+          } else {
+            badgeSlot.textContent = 'Limited';
+          }
+        }
+
+        this._syncBadgeVisibility();
+
+        if (fallbackLink) {
+          const href = this.getAttribute('href') || this.getAttribute('link') || this.getAttribute('action-url') || '#';
+          const label = this.getAttribute('action-text') || this.getAttribute('action-label') || 'View Details';
+          fallbackLink.setAttribute('href', href);
+          fallbackLink.textContent = label;
+
+          const slottedAction = this.querySelector('[slot="action"]');
+          if (slottedAction && slottedAction.tagName === 'A') {
+            if (changedAttr === 'href' || changedAttr === 'link' || changedAttr === 'action-url') {
+              slottedAction.setAttribute('href', href);
+            }
+            if (changedAttr === 'action-text' || changedAttr === 'action-label') {
+              slottedAction.textContent = label;
+            }
+          }
+        }
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
+
 </body>
 
