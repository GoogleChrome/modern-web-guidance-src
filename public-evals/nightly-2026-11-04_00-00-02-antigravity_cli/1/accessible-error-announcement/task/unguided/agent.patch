+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorEl = document.getElementById('newsletter-error');
+      const successEl = document.getElementById('newsletter-success');
+
+      if (!form || !emailInput || !errorEl) return;
+
+      const DEFAULT_ERROR_MESSAGE = 'Please enter a valid email address.';
+      let hasInteracted = false;
+
+      function isEmailValid() {
+        const value = emailInput.value.trim();
+        if (!value) return false;
+        return emailInput.validity.valid;
+      }
+
+      function getErrorMessage() {
+        const value = emailInput.value.trim();
+        if (!value || emailInput.validity.valueMissing) {
+          return 'Please enter your email address.';
+        }
+        return DEFAULT_ERROR_MESSAGE;
+      }
+
+      function syncErrorState(showError) {
+        if (showError) {
+          const message = getErrorMessage();
+          emailInput.classList.add('is-invalid');
+          emailInput.setAttribute('aria-invalid', 'true');
+          emailInput.setAttribute('aria-describedby', 'newsletter-error');
+          emailInput.setAttribute('aria-errormessage', 'newsletter-error');
+          errorEl.textContent = message;
+          errorEl.hidden = false;
+          errorEl.classList.add('visible');
+        } else {
+          emailInput.classList.remove('is-invalid');
+          emailInput.setAttribute('aria-invalid', 'false');
+          emailInput.removeAttribute('aria-describedby');
+          emailInput.removeAttribute('aria-errormessage');
+          errorEl.textContent = '';
+          errorEl.hidden = true;
+          errorEl.classList.remove('visible');
+        }
+      }
+
+      function checkPostInteractionState() {
+        let matchesUserInvalid = false;
+        try {
+          matchesUserInvalid = emailInput.matches(':user-invalid');
+        } catch (e) {
+          matchesUserInvalid = false;
+        }
+
+        const valid = isEmailValid();
+        if (valid) {
+          syncErrorState(false);
+        } else if (hasInteracted || matchesUserInvalid) {
+          syncErrorState(true);
+        } else {
+          syncErrorState(false);
+        }
+      }
+
+      emailInput.addEventListener('blur', function () {
+        hasInteracted = true;
+        checkPostInteractionState();
+      });
+
+      emailInput.addEventListener('input', function () {
+        if (successEl && !successEl.hidden) {
+          successEl.textContent = '';
+          successEl.hidden = true;
+          successEl.classList.remove('visible');
+        }
+        if ( isEmailValid() ) {
+          syncErrorState(false);
+        } else if (hasInteracted) {
+          syncErrorState(true);
+        } else {
+          checkPostInteractionState();
+        }
+      });
+
+      emailInput.addEventListener('change', function () {
+        hasInteracted = true;
+        checkPostInteractionState();
+      });
+
+      emailInput.addEventListener('invalid', function (e) {
+        e.preventDefault();
+        hasInteracted = true;
+        syncErrorState(true);
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        hasInteracted = true;
+
+        if (!isEmailValid()) {
+          syncErrorState(true);
+          emailInput.focus();
+          return;
+        }
+
+        syncErrorState(false);
+        if (successEl) {
+          successEl.textContent = 'Thank you for subscribing to The Daily Grind newsletter!';
+          successEl.hidden = false;
+          successEl.classList.add('visible');
+        }
+        form.reset();
+        hasInteracted = false;
+      });
+    })();
+  </script>
+
 </body>
 
