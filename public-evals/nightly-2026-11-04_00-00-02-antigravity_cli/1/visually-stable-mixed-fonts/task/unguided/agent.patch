diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,164 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Modern CSS Typography &amp; Theme Normalization</title>
+  <style>
+    :root {
+      --bg-page: #f8fafc;
+      --bg-card: #ffffff;
+      --text-primary: #0f172a;
+      --text-secondary: #475569;
+      --border-light: #e2e8f0;
+      --code-bg: #f1f5f9;
+      --code-text: #0284c7;
+
+      --theme-bg: #1e293b;
+      --theme-text: #f8fafc;
+      --theme-muted: #94a3b8;
+      --theme-accent: #38bdf8;
+      --theme-code-bg: #0f172a;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+      background-color: var(--bg-page);
+      color: var(--text-primary);
+      line-height: 1.6;
+      padding: 3rem 1.5rem;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 2.5rem;
+    }
+
+    main {
+      width: 100%;
+      max-width: 48rem;
+      display: flex;
+      flex-direction: column;
+      gap: 2rem;
+    }
+
+    header h1 {
+      font-size: 1.875rem;
+      font-weight: 700;
+      letter-spacing: -0.025em;
+      margin-bottom: 0.5rem;
+    }
+
+    header p {
+      color: var(--text-secondary);
+      font-size: 1rem;
+    }
+
+    .section-card {
+      background-color: var(--bg-card);
+      border: 1px solid var(--border-light);
+      border-radius: 0.75rem;
+      padding: 1.75rem;
+      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
+    }
+
+    .section-label {
+      font-size: 0.75rem;
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 0.05em;
+      color: var(--text-secondary);
+      margin-bottom: 0.75rem;
+    }
+
+    /* Automatically normalize visual x-height across mixed fonts */
+    #mixed-fonts-container {
+      font-family: "Helvetica Neue", Arial, system-ui, sans-serif;
+      font-size: 1.125rem;
+      line-height: 1.75;
+      color: var(--text-primary);
+      font-size-adjust: from-font;
+    }
+
+    #mixed-fonts-container code {
+      font-family: "Courier New", Courier, "Liberation Mono", monospace;
+      background-color: var(--code-bg);
+      color: var(--code-text);
+      padding: 0.15em 0.4em;
+      border-radius: 0.375rem;
+      border: 1px solid var(--border-light);
+    }
+
+    /* Independent theme container with specific numeric aspect-ratio override */
+    #independent-theme-container {
+      font-family: Georgia, "Times New Roman", Times, serif;
+      font-size: 1.125rem;
+      line-height: 1.7;
+      font-size-adjust: 0.5;
+      aspect-ratio: 16 / 9;
+      background-color: var(--theme-bg);
+      color: var(--theme-text);
+      padding: 2rem;
+      border-radius: 0.75rem;
+      border: 1px solid #334155;
+      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.25);
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      gap: 1rem;
+    }
+
+    #independent-theme-container h2 {
+      font-size: 1.375rem;
+      font-weight: 600;
+      color: var(--theme-accent);
+    }
+
+    #independent-theme-container p {
+      color: var(--theme-text);
+    }
+
+    #independent-theme-container code {
+      font-family: "Courier New", Courier, monospace;
+      background-color: var(--theme-code-bg);
+      color: var(--theme-accent);
+      padding: 0.15em 0.4em;
+      border-radius: 0.375rem;
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <header>
+      <h1>Font Size Adjustment &amp; Independent Theme Container</h1>
+      <p>Demonstrating optical font normalization with modern CSS properties.</p>
+    </header>
+
+    <section class="section-card">
+      <div class="section-label">Automatic Mixed-Font Normalization</div>
+      <p id="mixed-fonts-container">
+        When combining prose in a proportional typeface with inline code snippets like
+        <code>font-size-adjust: from-font</code> and <code>const scale = 1.0</code>,
+        different font families often exhibit mismatched lowercase x-heights. Applying
+        automatic metric normalization ensures that inline elements such as
+        <code>&lt;code&gt;</code> harmonize visually with the surrounding body copy.
+      </p>
+    </section>
+
+    <div id="independent-theme-container">
+      <div class="section-label" style="color: var(--theme-muted); margin-bottom: 0;">Independent Theme Override</div>
+      <h2>Locked Visual Proportions</h2>
+      <p>
+        This standalone themed container enforces an explicit numeric aspect value override
+        (<code>font-size-adjust: 0.5</code>) alongside locked container proportions so its
+        typography and layout remain visually consistent across fallback fonts.
+      </p>
+    </div>
+  </main>
+</body>
+</html>
