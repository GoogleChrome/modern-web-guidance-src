+  <script>
+    (function () {
+      const theaterBtn = document.getElementById('theater-mode-btn');
+      const iframe = document.getElementById('roasting-video');
+      const heroSection = document.querySelector('.hero');
+      const originalContainer = document.getElementById('video-container');
+
+      let isTheaterMode = false;
+
+      function reparentNode(targetParent, node) {
+        // Use the state-preserving DOM moveBefore API when supported so the
+        // iframe does not reload or lose playback state when reparented.
+        if (typeof targetParent.moveBefore === 'function') {
+          targetParent.moveBefore(node, null);
+        } else {
+          // Fallback for older browsers without Element.prototype.moveBefore
+          targetParent.appendChild(node);
+        }
+      }
+
+      theaterBtn.addEventListener('click', function () {
+        isTheaterMode = !isTheaterMode;
+        const destination = isTheaterMode ? heroSection : originalContainer;
+
+        reparentNode(destination, iframe);
+
+        heroSection.classList.toggle('theater-active', isTheaterMode);
+        theaterBtn.setAttribute('aria-pressed', String(isTheaterMode));
+        theaterBtn.textContent = isTheaterMode ? 'Exit Theater Mode' : 'Theater Mode';
+      });
+    })();
+  </script>
