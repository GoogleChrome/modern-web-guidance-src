+    <section class="video-section" id="roasting-section">
+      <h2>The Art of Coffee Roasting</h2>
+      <p>Go behind the scenes and watch how we roast our small-batch beans to perfection.</p>
+      <div class="video-controls">
+        <button id="theater-mode-btn" class="btn" type="button" aria-pressed="false">Theater Mode</button>
