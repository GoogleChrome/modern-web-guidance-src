+  <script>
+    const revealCouponBtn = document.getElementById('reveal-coupon-btn');
+    const couponPanel = document.getElementById('coupon-panel');
+
+    function handleCouponRevealed() {
+      couponPanel.removeAttribute('hidden');
+      revealCouponBtn.setAttribute('aria-expanded', 'true');
+      revealCouponBtn.disabled = true;
+      revealCouponBtn.textContent = 'Coupon Revealed';
+    }
+
+    revealCouponBtn.addEventListener('click', () => {
+      handleCouponRevealed();
+    });
+
+    couponPanel.addEventListener('beforematch', () => {
+      handleCouponRevealed();
+    });
+
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      document.querySelectorAll('[hidden="until-found"]').forEach((el) => {
+        el.removeAttribute('hidden');
+        document.querySelectorAll(`[aria-controls="${el.id}"]`).forEach((ctrl) => {
+          ctrl.setAttribute('aria-expanded', 'true');
+          if (ctrl === revealCouponBtn) {
+            ctrl.disabled = true;
+            ctrl.textContent = 'Coupon Revealed';
+          }
+        });
+      });
+    }
