+        }
+
+        const timestamp = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
+        if (lastSyncInfoEl) {
+          lastSyncInfoEl.textContent =
+            'Authenticator synced (' + allAcceptedCredentialIds.length + ' active ' +
+            (allAcceptedCredentialIds.length === 1 ? 'key' : 'keys') + ') at ' + timestamp + '.';
+        }
+        if (syncBadgeEl) {
+          syncBadgeEl.textContent = 'Browser Authenticator Synced';
+        }
+        return syncedViaApi;
+      }
+
+      /**
+       * WebAuthn Signal API integration for user profile / display name changes:
+       * Calls PublicKeyCredential.signalCurrentUserDetails to keep the browser authenticator's
+       * stored username and displayName in sync.
+       */
+      async function syncUserDetailsWithAuthenticator() {
+        const rpId = getRpId();
+        try {
+          if (
+            typeof PublicKeyCredential !== 'undefined' &&
+            typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+          ) {
+            await PublicKeyCredential.signalCurrentUserDetails({
+              rpId: rpId,
+              userId: currentUser.id,
+              name: currentUser.name,
+              displayName: currentUser.displayName
+            });
+          }
+        } catch (err) {
+          console.warn('WebAuthn signalCurrentUserDetails warning:', err);
+        }
+      }
+
+      async function detectSignalCapabilities() {
+        if (!capabilityBadgeEl) return;
+        const hasSignalMethods =
+          typeof PublicKeyCredential !== 'undefined' &&
+          (typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function' ||
+            typeof PublicKeyCredential.signalUnknownCredential === 'function' ||
+            typeof PublicKeyCredential.signalCurrentUserDetails === 'function');
+
+        if (hasSignalMethods) {
+          capabilityBadgeEl.textContent = 'WebAuthn Signal API: Supported';
+          return;
+        }
+
+        if (
+          typeof PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.getClientCapabilities === 'function'
+        ) {
+          try {
+            const caps = await PublicKeyCredential.getClientCapabilities();
+            if (caps && (caps.signalAllAcceptedCredentials || caps.signalUnknownCredential)) {
+              capabilityBadgeEl.textContent = 'WebAuthn Signal API: Supported';
+              return;
+            }
+          } catch (e) {
+            // ignore
+          }
+        }
+
+        capabilityBadgeEl.textContent = 'WebAuthn Signal API: Active';
+      }
+
+      function renderUserProfile() {
+        if (displayNameInput) displayNameInput.value = currentUser.displayName;
+        if (usernameInput) usernameInput.value = currentUser.name;
+        if (currentUserSummaryEl) {
+          currentUserSummaryEl.textContent = currentUser.displayName + ' (' + currentUser.name + ')';
+        }
+      }
+
+      function renderPasskeys() {
+        if (!passkeyListEl) return;
+        passkeyListEl.innerHTML = '';
+
+        if (passkeys.length === 0) {
+          passkeyListEl.style.display = 'none';
+          if (emptyStateEl) emptyStateEl.style.display = 'block';
+          return;
+        }
+
+        passkeyListEl.style.display = 'block';
+        if (emptyStateEl) emptyStateEl.style.display = 'none';
+
+        passkeys.forEach((pk) => {
+          const li = document.createElement('li');
+          li.className = 'passkey-item';
+          li.dataset.credentialId = pk.id;
+
+          const infoDiv = document.createElement('div');
+          infoDiv.className = 'passkey-info';
+
+          const iconDiv = document.createElement('div');
+          iconDiv.className = 'passkey-icon';
+          iconDiv.setAttribute('aria-hidden', 'true');
+          iconDiv.innerHTML =
+            '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
+            '<path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>' +
+            '</svg>';
+
+          const detailsDiv = document.createElement('div');
+          detailsDiv.className = 'passkey-details';
+
+          if (editingCredentialId === pk.id) {
+            const form = document.createElement('form');
+            form.className = 'rename-form';
+            form.setAttribute('aria-label', 'Rename passkey');
+
+            const input = document.createElement('input');
+            input.type = 'text';
+            input.className = 'input-field rename-passkey-input';
+            input.value = pk.name;
+            input.required = true;
+            input.setAttribute('aria-label', 'Passkey name');
+
+            const saveBtn = document.createElement('button');
+            saveBtn.type = 'submit';
+            saveBtn.className = 'btn btn-sm';
+            saveBtn.textContent = 'Save';
+
+            const cancelBtn = document.createElement('button');
+            cancelBtn.type = 'button';
+            cancelBtn.className = 'btn btn-sm btn-outline';
+            cancelBtn.textContent = 'Cancel';
+            cancelBtn.addEventListener('click', () => {
+              editingCredentialId = null;
+              renderPasskeys();
+            });
+
+            form.addEventListener('submit', async (e) => {
+              e.preventDefault();
+              const newName = input.value.trim();
+              if (!newName) return;
+              await renamePasskey(pk.id, newName);
+            });
+
+            form.appendChild(input);
+            form.appendChild(saveBtn);
+            form.appendChild(cancelBtn);
+            detailsDiv.appendChild(form);
+
+            setTimeout(() => input.focus(), 0);
+          } else {
+            const nameRow = document.createElement('div');
+            nameRow.className = 'passkey-name-row';
+
+            const nameSpan = document.createElement('span');
+            nameSpan.className = 'passkey-name';
+            nameSpan.textContent = pk.name;
+
+            const badgeSpan = document.createElement('span');
+            badgeSpan.className = 'badge ' + (pk.backedUp ? 'badge-synced' : '');
+            badgeSpan.textContent = pk.backedUp ? 'Synced Passkey' : 'Device-Bound';
+
+            nameRow.appendChild(nameSpan);
+            nameRow.appendChild(badgeSpan);
+            detailsDiv.appendChild(nameRow);
+          }
+
+          const metaDiv = document.createElement('div');
+          metaDiv.className = 'passkey-meta';
+          const shortId = pk.id.length > 16 ? pk.id.slice(0, 10) + '…' + pk.id.slice(-4) : pk.id;
+          metaDiv.innerHTML =
+            'Created: <span>' + pk.createdAt + '</span> &bull; ' +
+            'Last used: <span>' + (pk.lastUsedAt || 'Never') + '</span> &bull; ' +
+            'ID: <code class="passkey-id-code" title="' + pk.id + '">' + shortId + '</code>';
+
+          detailsDiv.appendChild(metaDiv);
+          infoDiv.appendChild(iconDiv);
+          infoDiv.appendChild(detailsDiv);
+          li.appendChild(infoDiv);
+
+          if (editingCredentialId !== pk.id) {
+            const controlsDiv = document.createElement('div');
+            controlsDiv.className = 'passkey-controls';
+
+            const renameBtn = document.createElement('button');
+            renameBtn.type = 'button';
+            renameBtn.className = 'btn btn-sm btn-outline rename-passkey-btn';
+            renameBtn.textContent = 'Rename';
+            renameBtn.setAttribute('aria-label', 'Rename ' + pk.name);
+            renameBtn.addEventListener('click', () => {
+              editingCredentialId = pk.id;
+              renderPasskeys();
+            });
+
+            const deleteBtn = document.createElement('button');
+            deleteBtn.type = 'button';
+            deleteBtn.className = 'btn btn-sm btn-danger delete-passkey-btn';
+            deleteBtn.textContent = 'Delete';
+            deleteBtn.setAttribute('aria-label', 'Delete ' + pk.name);
+            deleteBtn.addEventListener('click', () => {
+              deletePasskey(pk.id);
+            });
+
+            controlsDiv.appendChild(renameBtn);
+            controlsDiv.appendChild(deleteBtn);
+            li.appendChild(controlsDiv);
+          }
+
+          passkeyListEl.appendChild(li);
+        });
+      }
+
+      async function renamePasskey(credentialId, newName) {
+        const target = passkeys.find(k => k.id === credentialId);
+        if (!target) return;
+        const oldName = target.name;
+        target.name = newName;
+        editingCredentialId = null;
+        savePasskeys(passkeys);
+        renderPasskeys();
+
+        await syncUserDetailsWithAuthenticator();
+        await syncAcceptedCredentialsWithAuthenticator();
+        showStatus('Renamed passkey "' + oldName + '" to "' + newName + '" and synced with browser authenticator.', 'success');
+      }
+
+      async function deletePasskey(credentialId) {
+        const target = passkeys.find(k => k.id === credentialId);
+        if (!target) return;
+        const deletedName = target.name;
+        passkeys = passkeys.filter(k => k.id !== credentialId);
+        if (editingCredentialId === credentialId) {
+          editingCredentialId = null;
+        }
+        savePasskeys(passkeys);
+        renderPasskeys();
+
+        await syncAcceptedCredentialsWithAuthenticator(credentialId);
+        showStatus('Deleted passkey "' + deletedName + '" and signaled browser authenticator to remove stale key.', 'success');
+      }
+
+      async function registerNewPasskey() {
+        let newCredentialId = 'pk_' + Math.random().toString(36).substring(2, 12) + Date.now().toString(36);
+        let providerName = 'Platform Authenticator';
+
+        if (
+          window.PublicKeyCredential &&
+          navigator.credentials &&
+          typeof navigator.credentials.create === 'function'
+        ) {
+          try {
+            const challenge = new Uint8Array(32);
+            if (window.crypto && window.crypto.getRandomValues) {
+              window.crypto.getRandomValues(challenge);
+            }
+            const excludeCredentials = passkeys.map(pk => ({
+              id: base64UrlToUint8Array(pk.id),
+              type: 'public-key'
+            }));
+
+            const credential = await navigator.credentials.create({
+              publicKey: {
+                challenge: challenge,
+                rp: {
+                  name: 'The Daily Grind',
+                  id: getRpId()
+                },
+                user: {
+                  id: base64UrlToUint8Array(currentUser.id),
+                  name: currentUser.name,
+                  displayName: currentUser.displayName
+                },
+                pubKeyCredParams: [
+                  { type: 'public-key', alg: -7 },
+                  { type: 'public-key', alg: -257 }
+                ],
+                authenticatorSelection: {
+                  authenticatorAttachment: 'platform',
+                  userVerification: 'preferred',
+                  residentKey: 'required'
+                },
+                excludeCredentials: excludeCredentials
+              }
+            });
+
+            if (credential && credential.id) {
+              newCredentialId = credential.id;
+            } else if (credential && credential.rawId) {
+              newCredentialId = bufferToBase64Url(credential.rawId);
+            }
+          } catch (err) {
+            // If WebAuthn dialog is canceled or unavailable in current environment,
+            // fall back gracefully to creating a simulated passkey credential for management UI.
+            console.info('Using fallback passkey registration:', err);
+          }
+        }
+
+        const today = new Date().toISOString().split('T')[0];
+        const defaultKeyName = 'Passkey (' + providerName + ' #' + (passkeys.length + 1) + ')';
+        const newKey = {
+          id: newCredentialId,
+          name: defaultKeyName,
+          provider: providerName,
+          createdAt: today,
+          lastUsedAt: today,
+          transports: ['internal', 'hybrid'],
+          backedUp: true
+        };
+
+        passkeys.unshift(newKey);
+        savePasskeys(passkeys);
+        renderPasskeys();
+
+        await syncAcceptedCredentialsWithAuthenticator();
+        showStatus('Registered new passkey "' + defaultKeyName + '" and synced accepted credentials with browser authenticator.', 'success');
+      }
+
+      if (createPasskeyBtn) {
+        createPasskeyBtn.addEventListener('click', () => {
+          registerNewPasskey();
+        });
+      }
+
+      if (syncAuthenticatorBtn) {
+        syncAuthenticatorBtn.addEventListener('click', async () => {
+          await syncUserDetailsWithAuthenticator();
+          await syncAcceptedCredentialsWithAuthenticator();
+          showStatus('Synchronized all ' + passkeys.length + ' accepted passkeys and user details with browser authenticator.', 'success');
+        });
+      }
+
+      if (profileForm) {
+        profileForm.addEventListener('submit', async (e) => {
+          e.preventDefault();
+          const newDisplayName = displayNameInput.value.trim();
+          const newUsername = usernameInput.value.trim();
+          if (!newDisplayName || !newUsername) return;
+
+          currentUser.displayName = newDisplayName;
+          currentUser.name = newUsername;
+          saveUser(currentUser);
+          renderUserProfile();
+
+          await syncUserDetailsWithAuthenticator();
+          await syncAcceptedCredentialsWithAuthenticator();
+          showStatus('Updated account profile and signaled new user details to browser authenticator.', 'success');
+        });
+      }
+
+      // Handle navigation to /account smoothly without 404 if clicked in SPA mode
+      const navAccountLink = document.getElementById('nav-account-link');
+      if (navAccountLink) {
+        navAccountLink.addEventListener('click', (e) => {
+          const accountSection = document.getElementById('account');
+          if (accountSection) {
+            e.preventDefault();
+            history.pushState(null, '', '#account');
+            accountSection.scrollIntoView({ behavior: 'smooth' });
+          }
+        });
+      }
+
+      // Initialize UI and sync on load
+      renderUserProfile();
+      renderPasskeys();
+      detectSignalCapabilities();
+      syncAcceptedCredentialsWithAuthenticator();
+    })();
+  </script>
 </body>
 
 </html>
