+
+      /**
+       * WebAuthn Signal API integration:
+       * Synchronizes the list of all accepted credentials with the browser's authenticator
+       * via PublicKeyCredential.signalAllAcceptedCredentials, and optionally notifies
+       * PublicKeyCredential.signalUnknownCredential when a specific credential was removed.
+       */
+      async function syncAcceptedCredentialsWithAuthenticator(deletedCredentialId) {
+        const rpId = getRpId();
+        const allAcceptedCredentialIds = passkeys.map(pk => pk.id);
+        let syncedViaApi = false;
+
+        try {
+          if (typeof PublicKeyCredential !== 'undefined') {
+            if (
+              deletedCredentialId &&
+              typeof PublicKeyCredential.signalUnknownCredential === 'function'
+            ) {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: rpId,
+                credentialId: deletedCredentialId
+              });
+              syncedViaApi = true;
+            }
+
+            if (typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function') {
+              await PublicKeyCredential.signalAllAcceptedCredentials({
