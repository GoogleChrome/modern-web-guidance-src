+          }
+        }
+
+        const today = new Date().toISOString().split('T')[0];
+        const defaultKeyName = 'Passkey (' + providerName + ' #' + (passkeys.length + 1) + ')';
+        const newKey = {
+          id: newCredentialId,
+          name: defaultKeyName,
+          provider: providerName,
+          createdAt: today,
+          lastUsedAt: today,
+          transports: ['internal', 'hybrid'],
+          backedUp: true
+        };
+
+        passkeys.unshift(newKey);
+        savePasskeys(passkeys);
+        renderPasskeys();
+
+        await syncAcceptedCredentialsWithAuthenticator();
+        showStatus('Registered new passkey "' + defaultKeyName + '" and synced accepted credentials with browser authenticator.', 'success');
+      }
+
+      if (createPasskeyBtn) {
+        createPasskeyBtn.addEventListener('click', () => {
+          registerNewPasskey();
+        });
+      }
+
+      if (syncAuthenticatorBtn) {
