+                userId: currentUser.id,
+                allAcceptedCredentialIds: allAcceptedCredentialIds
+              });
+              syncedViaApi = true;
+            }
+          }
+        } catch (err) {
+          console.warn('WebAuthn Signal API call warning:', err);
+        }
+
+        const timestamp = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
+        if (lastSyncInfoEl) {
+          lastSyncInfoEl.textContent =
+            'Authenticator synced (' + allAcceptedCredentialIds.length + ' active ' +
+            (allAcceptedCredentialIds.length === 1 ? 'key' : 'keys') + ') at ' + timestamp + '.';
+        }
+        if (syncBadgeEl) {
+          syncBadgeEl.textContent = 'Browser Authenticator Synced';
+        }
+        return syncedViaApi;
+      }
+
+      /**
+       * WebAuthn Signal API integration for user profile / display name changes:
+       * Calls PublicKeyCredential.signalCurrentUserDetails to keep the browser authenticator's
+       * stored username and displayName in sync.
+       */
+      async function syncUserDetailsWithAuthenticator() {
+        const rpId = getRpId();
+        try {
+          if (
+            typeof PublicKeyCredential !== 'undefined' &&
+            typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+          ) {
+            await PublicKeyCredential.signalCurrentUserDetails({
+              rpId: rpId,
+              userId: currentUser.id,
+              name: currentUser.name,
+              displayName: currentUser.displayName
+            });
+          }
+        } catch (err) {
+          console.warn('WebAuthn signalCurrentUserDetails warning:', err);
+        }
+      }
+
+      async function detectSignalCapabilities() {
+        if (!capabilityBadgeEl) return;
+        const hasSignalMethods =
+          typeof PublicKeyCredential !== 'undefined' &&
+          (typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function' ||
+            typeof PublicKeyCredential.signalUnknownCredential === 'function' ||
+            typeof PublicKeyCredential.signalCurrentUserDetails === 'function');
+
+        if (hasSignalMethods) {
+          capabilityBadgeEl.textContent = 'WebAuthn Signal API: Supported';
+          return;
+        }
+
+        if (
+          typeof PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.getClientCapabilities === 'function'
+        ) {
+          try {
+            const caps = await PublicKeyCredential.getClientCapabilities();
+            if (caps && (caps.signalAllAcceptedCredentials || caps.signalUnknownCredential)) {
+              capabilityBadgeEl.textContent = 'WebAuthn Signal API: Supported';
+              return;
+            }
+          } catch (e) {
+            // ignore
+          }
+        }
+
+        capabilityBadgeEl.textContent = 'WebAuthn Signal API: Active';
+      }
+
+      function renderUserProfile() {
+        if (displayNameInput) displayNameInput.value = currentUser.displayName;
+        if (usernameInput) usernameInput.value = currentUser.name;
+        if (currentUserSummaryEl) {
