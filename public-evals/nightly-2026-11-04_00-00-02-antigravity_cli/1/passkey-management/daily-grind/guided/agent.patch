+import aaguids from './aaguids.json' with { type: 'json' };
+
+const STORAGE_KEY_CREDENTIALS = 'dailyGrind_passkeyCredentials';
+const STORAGE_KEY_USER = 'dailyGrind_userProfile';
+
+// Base64URL-encoded User ID string for the signed-in customer
+export const DEFAULT_USER = {
+  id: 'M2YPl-KGnA8',
+  name: 'maya.lin@dailygrind.coffee',
+  displayName: 'Maya Lin',
+};
+
+const DEFAULT_CREDENTIALS = [
+  {
+    id: 'cred_gpm_9a8b7c6d5e4f3a2b1c',
+    passkeyUserId: 'M2YPl-KGnA8',
+    credentialPublicKey: 'pQECAyYgASFYIJV8x9qL2mK5nB7vC1xZ3wE6rT8yU0iO4pA2sD6fG8hJIlggK1lM3nO5pQ7rS9tU1vW3xY5zA7bC9dE1fG3hI5jK7lM',
+    credentialType: 'public-key',
+    credentialDeviceType: 'multiDevice',
+    credentialBackedUp: true,
+    aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+    providerIcon: aaguids['ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4']?.icon_light,
+    name: aaguids['ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4']?.name || 'Google Password Manager',
+    transports: ['internal', 'hybrid'],
+    registeredAt: 1759564800000,
+    lastUsedAt: 1793692800000,
+    counter: 14,
+  },
+  {
+    id: 'cred_icloud_1f2e3d4c5b6a798877',
+    passkeyUserId: 'M2YPl-KGnA8',
+    credentialPublicKey: 'pQECAyYgASFYIHW9z8xY7vU6tS5rQ4pO3nM2lK1jI0hG9fE8dC7bA6zYIlggM9nB8vC7xZ6lK5jH4gF3dS2aP1oI0uY9tR8eW7qA6sD',
+    credentialType: 'public-key',
+    credentialDeviceType: 'multiDevice',
+    credentialBackedUp: true,
+    aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+    providerIcon: aaguids['fbfc3007-154e-4ecc-8c0b-6e020557d7bd']?.icon_light,
+    name: aaguids['fbfc3007-154e-4ecc-8c0b-6e020557d7bd']?.name || 'Apple Passwords',
+    transports: ['internal', 'hybrid'],
+    registeredAt: 1762848000000,
+    lastUsedAt: 1793174400000,
+    counter: 6,
+  },
+  {
+    id: 'cred_1p_5a4b3c2d1e0f9a8b7c',
+    passkeyUserId: 'M2YPl-KGnA8',
+    credentialPublicKey: 'pQECAyYgASFYIKL3mN5oP7qR9sT1uV3wX5yZ7aB9cD1eF3gH5iJ7kL9mIlggP2oI4uY6tR8eW0qA2sD4fG6hJ8kL0zX2cV4bN6mM8nB',
+    credentialType: 'public-key',
+    credentialDeviceType: 'multiDevice',
+    credentialBackedUp: true,
+    aaguid: 'bada5566-a7aa-401f-bd96-45619a55120d',
+    providerIcon: aaguids['bada5566-a7aa-401f-bd96-45619a55120d']?.icon_light,
+    name: 'Work Laptop (1Password)',
+    transports: ['internal', 'hybrid'],
+    registeredAt: 1775030400000,
+    lastUsedAt: undefined,
+    counter: 0,
+  },
+];
+
+function getStoredUser() {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY_USER);
+    if (raw) {
+      return JSON.parse(raw);
+    }
+  } catch (e) {
+    console.warn('Failed to read user profile from localStorage:', e);
+  }
+  localStorage.setItem(STORAGE_KEY_USER, JSON.stringify(DEFAULT_USER));
+  return { ...DEFAULT_USER };
+}
+
+function saveStoredUser(user) {
+  try {
+    localStorage.setItem(STORAGE_KEY_USER, JSON.stringify(user));
+  } catch (e) {
+    console.warn('Failed to save user profile to localStorage:', e);
+  }
+  return user;
+}
+
+function getStoredCredentials() {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY_CREDENTIALS);
+    if (raw) {
+      return JSON.parse(raw);
+    }
+  } catch (e) {
+    console.warn('Failed to read credentials from localStorage:', e);
+  }
+  localStorage.setItem(STORAGE_KEY_CREDENTIALS, JSON.stringify(DEFAULT_CREDENTIALS));
+  return [...DEFAULT_CREDENTIALS];
+}
+
+function saveStoredCredentials(list) {
+  try {
+    localStorage.setItem(STORAGE_KEY_CREDENTIALS, JSON.stringify(list));
+  } catch (e) {
+    console.warn('Failed to save credentials to localStorage:', e);
+  }
+  return list;
+}
+
+function jsonResponse(data, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+export function lookupAaguidMetadata(aaguid) {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      name: 'Unknown passkey provider',
+      providerIcon: undefined,
+    };
+  }
+  const provider = aaguids[aaguid];
+  return {
+    name: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+  };
+}
+
+export async function userFetch() {
+  try {
+    const res = await fetch('/api/user', {
+      headers: { Accept: 'application/json' },
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fallback to local state when running on static file server
+  }
+  return jsonResponse(getStoredUser());
+}
+
+export async function updateUserFetch({ name, displayName }) {
+  try {
+    const res = await fetch('/api/user', {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ name, displayName }),
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fallback to local state
+  }
+  const current = getStoredUser();
+  const updated = saveStoredUser({
+    ...current,
+    name: name ? name.trim() : current.name,
+    displayName: displayName ? displayName.trim() : current.displayName,
+  });
+  return jsonResponse(updated);
+}
+
+export async function listFetch() {
+  try {
+    const res = await fetch('/api/credentials', {
+      headers: { Accept: 'application/json' },
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fallback to local state
+  }
+  return jsonResponse(getStoredCredentials());
+}
+
+export async function renameCredentialFetch(credentialId, { name }) {
+  try {
+    const res = await fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ name }),
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fallback to local state
+  }
+  const list = getStoredCredentials();
+  const cred = list.find((c) => c.id === credentialId);
+  if (!cred) {
+    return jsonResponse({ error: 'Credential not found.' }, 404);
+  }
+  cred.name = name;
+  saveStoredCredentials(list);
+  return jsonResponse(cred);
+}
+
+export async function deleteFetch(credentialId) {
+  try {
+    const res = await fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+      method: 'DELETE',
+      headers: { Accept: 'application/json' },
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fallback to local state
+  }
+  const list = getStoredCredentials();
+  const idx = list.findIndex((c) => c.id === credentialId);
+  if (idx === -1) {
+    return jsonResponse({ error: 'Credential not found.' }, 404);
+  }
+  list.splice(idx, 1);
+  saveStoredCredentials(list);
+  return jsonResponse({ success: true });
+}
+
+function generateBase64UrlChallenge() {
+  const bytes = new Uint8Array(32);
+  crypto.getRandomValues(bytes);
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export async function optionsFetch({ promotion = false } = {}) {
+  try {
+    const res = await fetch('/api/register/options', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ promotion }),
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return await res.json();
+    }
+  } catch {
+    // Fallback to local options generation
+  }
+  const user = getStoredUser();
+  const existingCredentials = getStoredCredentials();
+  const rpId = window.location.hostname || 'localhost';
+
+  return {
+    challenge: generateBase64UrlChallenge(),
+    rp: {
+      id: rpId,
+      name: 'The Daily Grind',
+    },
+    user: {
+      id: user.id,
+      name: user.name,
+      displayName: user.displayName,
+    },
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -7 },
+      { type: 'public-key', alg: -257 },
+    ],
+    excludeCredentials: existingCredentials.map((cred) => ({
+      type: 'public-key',
+      id: cred.id,
+      transports: cred.transports || ['internal', 'hybrid'],
+    })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      ...(promotion && { authenticatorAttachment: 'platform' }),
+    },
+  };
+}
+
+export async function registerVerifyFetch(encodedResponse) {
+  try {
+    const res = await fetch('/api/register/verify', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify(encodedResponse),
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fallback to local registration persistence
+  }
+  const user = getStoredUser();
+  const list = getStoredCredentials();
+  const aaguid = encodedResponse.aaguid || 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4';
+  const meta = lookupAaguidMetadata(aaguid);
+  const newCred = {
+    id: encodedResponse.id,
+    passkeyUserId: user.id,
+    credentialPublicKey: encodedResponse.response?.publicKey || 'pQECAyYgASFYIFallbackPublicKey',
+    credentialType: 'public-key',
+    credentialDeviceType: encodedResponse.authenticatorAttachment === 'cross-platform' ? 'singleDevice' : 'multiDevice',
+    credentialBackedUp: true,
+    aaguid,
+    providerIcon: meta.providerIcon,
+    name: meta.name,
+    transports: encodedResponse.response?.transports || ['internal', 'hybrid'],
+    registeredAt: Date.now(),
+    lastUsedAt: Date.now(),
+    counter: 0,
+  };
+  list.unshift(newCred);
+  saveStoredCredentials(list);
+  return jsonResponse(newCred);
+}
