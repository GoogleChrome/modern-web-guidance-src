+++ b/passkey-management.js
@@ -0,0 +1,490 @@
+import aaguids from './aaguids.json' with { type: 'json' };
+import {
+  DEFAULT_USER,
+  userFetch,
+  updateUserFetch,
+  listFetch,
+  renameCredentialFetch,
+  deleteFetch,
+  optionsFetch,
+  registerVerifyFetch,
+} from './api.js';
+
+// Polyfill fallback for WebAuthn JSON parsing and getClientCapabilities
+async function ensureWebAuthnPolyfill() {
+  if (
+    typeof window !== 'undefined' &&
+    window.PublicKeyCredential &&
+    (!PublicKeyCredential.parseRequestOptionsFromJSON ||
+      !PublicKeyCredential.parseCreationOptionsFromJSON ||
+      !PublicKeyCredential.getClientCapabilities)
+  ) {
+    try {
+      await import('https://unpkg.com/webauthn-polyfills');
+    } catch (err) {
+      console.warn('Could not load webauthn-polyfills from CDN:', err);
+    }
+  }
+}
+
+const rpId = window.location.hostname || 'localhost';
+let currentUser = { ...DEFAULT_USER };
+
+const DEFAULT_PASSKEY_SVG_DATA_URI =
+  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234e342e' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4'/%3E%3C/svg%3E";
+
+function resolveProviderDetails(cred) {
+  const { aaguid } = cred;
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      name: cred.name || 'Unknown passkey provider',
+      providerName: 'Unknown passkey provider',
+      providerIcon: cred.providerIcon || DEFAULT_PASSKEY_SVG_DATA_URI,
+    };
+  }
+  const provider = aaguids[aaguid];
+  const providerName = provider?.name || 'Unknown passkey provider';
+  return {
+    name: cred.name || providerName,
+    providerName,
+    providerIcon: cred.providerIcon || provider?.icon_light || DEFAULT_PASSKEY_SVG_DATA_URI,
+  };
+}
+
+function formatEpochDate(epochMs) {
+  if (!epochMs) return 'Never used';
+  try {
+    return new Intl.DateTimeFormat('en-US', {
+      year: 'numeric',
+      month: 'short',
+      day: 'numeric',
+    }).format(new Date(epochMs));
+  } catch {
+    return new Date(epochMs).toLocaleDateString();
+  }
+}
+
+function showStatusMessage(message, type = 'success') {
+  const banners = document.querySelectorAll('[data-passkey-status]');
+  banners.forEach((banner) => {
+    banner.textContent = message;
+    banner.className = `passkey-status-banner is-visible is-${type}`;
+  });
+}
+
+// Signal API: Synchronize all accepted credentials with the browser authenticator / password manager
+export async function syncAcceptedCredentials(currentCredentialsList) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  try {
+    const credentialIds = currentCredentialsList.map((c) => c.id); // Array of Base64URL credential ID strings
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId,
+      userId: currentUser.id, // Base64URL-encoded User ID string
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (e) {
+    console.error('SignalAllAcceptedCredentials sync failure:', e);
+  }
+}
+
+// Delete a passkey and synchronize remaining accepted credentials via signalAllAcceptedCredentials
+export async function performDelete(credentialId) {
+  const response = await deleteFetch(credentialId);
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    const updatedList = await updatedResponse.json();
+
+    renderUI(updatedList);
+    // Sync remaining accepted credentials after deletion
+    await syncAcceptedCredentials(updatedList);
+    showStatusMessage(
+      'Passkey removed from your Daily Grind account and synchronized with your authenticator.',
+      'success'
+    );
+  } else {
+    showStatusMessage('Could not delete passkey. Please try again.', 'error');
+  }
+}
+
+// Renaming a passkey's nickname updates the server record only (does NOT invoke signalCurrentUserDetails)
+export async function performCredentialRename(credentialId, newCredentialName) {
+  const trimmedName = newCredentialName ? newCredentialName.trim() : '';
+  if (!trimmedName) {
+    showStatusMessage('Please enter a non-empty name for your passkey.', 'error');
+    return;
+  }
+  const response = await renameCredentialFetch(credentialId, { name: trimmedName });
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    renderUI(await updatedResponse.json());
+    showStatusMessage(`Passkey renamed to "${trimmedName}".`, 'success');
+  } else {
+    showStatusMessage('Could not rename passkey. Please try again.', 'error');
+  }
+}
+
+// Renaming the user's account username or displayName triggers PublicKeyCredential.signalCurrentUserDetails
+export async function performUserRename(targetRpId, userId, updatedName, updatedDisplayName) {
+  const response = await updateUserFetch({ name: updatedName, displayName: updatedDisplayName });
+  if (response.ok) {
+    const updatedUser = await response.json();
+    currentUser = updatedUser;
+    renderUserProfileUI(currentUser);
+
+    if (window.PublicKeyCredential && PublicKeyCredential.signalCurrentUserDetails) {
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails({
+          rpId: targetRpId,
+          userId, // Base64URL-encoded user ID
+          name: updatedUser.name,
+          displayName: updatedUser.displayName,
+        });
+      } catch (e) {
+        console.error('SignalCurrentUserDetails sync failure:', e);
+      }
+    }
+    showStatusMessage(
+      'Account profile updated and synchronized with your passkey authenticator.',
+      'success'
+    );
+  } else {
+    showStatusMessage('Could not update account details. Please try again.', 'error');
+  }
+}
+
+// Register a new passkey from the management panel (supports platform and security keys by omitting authenticatorAttachment)
+export async function registerPasskey(isPromotion = false) {
+  await ensureWebAuthnPolyfill();
+
+  if (window.PublicKeyCredential && PublicKeyCredential.getClientCapabilities) {
+    try {
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (!capabilities.passkeyPlatformAuthenticator || !capabilities.conditionalGet) {
+        showStandardPasswordFallbackUI();
+        return;
+      }
+    } catch (e) {
+      console.warn('Error checking client capabilities:', e);
+    }
+  } else if (!window.PublicKeyCredential) {
+    showStandardPasswordFallbackUI();
+    return;
+  }
+
+  const creationOptionsJSON = await optionsFetch({ promotion: isPromotion });
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON
+    ? PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON)
+    : creationOptionsJSON;
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    if (err.name === 'InvalidStateError') {
+      console.log('A passkey already exists for this account.');
+      showStatusMessage('A passkey already exists on this authenticator for your account.', 'error');
+    } else if (err.name === 'SecurityError') {
+      console.error('Configuration RP ID or Secure Context error.');
+      showStatusMessage('Configuration RP ID or Secure Context error.', 'error');
+    } else if (err.name === 'NotAllowedError') {
+      console.log('User cancelled the passkey dialog.');
+      showStatusMessage('Passkey creation was cancelled.', 'info');
+    } else if (err.name === 'AbortError') {
+      console.log('The creation operation has been aborted.');
+    }
+    return;
+  }
+
+  if (!credential) return;
+
+  // Server Verification phase (Segregated Try/Catch for signalUnknownCredential)
+  const encodedResponse = credential.toJSON ? credential.toJSON() : { id: credential.id };
+  try {
+    const response = await registerVerifyFetch(encodedResponse);
+    if (!response.ok) {
+      if (window.PublicKeyCredential && PublicKeyCredential.signalUnknownCredential) {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId,
+          credentialId: encodedResponse.id,
+        });
+      }
+      showStatusMessage('Server verification failed for the new passkey.', 'error');
+      return;
+    }
+    const updatedResponse = await listFetch();
+    const updatedList = await updatedResponse.json();
+    renderUI(updatedList);
+    await syncAcceptedCredentials(updatedList);
+    showStatusMessage('New passkey registered and synced with your account.', 'success');
+  } catch (serverErr) {
+    console.error('Server verification network failure:', serverErr);
+    if (window.PublicKeyCredential && PublicKeyCredential.signalUnknownCredential) {
+      await PublicKeyCredential.signalUnknownCredential({
+        rpId,
+        credentialId: encodedResponse.id,
+      });
+    }
+    showStatusMessage('Network error during passkey verification.', 'error');
+  }
+}
+
+function showStandardPasswordFallbackUI() {
+  const createButtons = document.querySelectorAll('[data-create-passkey-btn]');
+  createButtons.forEach((btn) => {
+    btn.hidden = true;
+    btn.disabled = true;
+  });
+  const fallbackNotices = document.querySelectorAll('[data-passkey-unsupported-fallback]');
+  fallbackNotices.forEach((notice) => {
+    notice.hidden = false;
+  });
+}
+
+async function gateCreatePasskeyButtons() {
+  await ensureWebAuthnPolyfill();
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    showStandardPasswordFallbackUI();
+    return;
+  }
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    if (!capabilities.passkeyPlatformAuthenticator || !capabilities.conditionalGet) {
+      showStandardPasswordFallbackUI();
+    } else {
+      const createButtons = document.querySelectorAll('[data-create-passkey-btn]');
+      createButtons.forEach((btn) => {
+        btn.hidden = false;
+        btn.disabled = false;
+      });
+      const fallbackNotices = document.querySelectorAll('[data-passkey-unsupported-fallback]');
+      fallbackNotices.forEach((notice) => {
+        notice.hidden = true;
+      });
+    }
+  } catch {
+    showStandardPasswordFallbackUI();
+  }
+}
+
+function renderUserProfileUI(user) {
+  document.querySelectorAll('[data-user-name-input]').forEach((input) => {
+    input.value = user.name || '';
+  });
+  document.querySelectorAll('[data-user-display-name-input]').forEach((input) => {
+    input.value = user.displayName || '';
+  });
+  document.querySelectorAll('[data-user-display-name-label]').forEach((el) => {
+    el.textContent = user.displayName || '';
+  });
+  document.querySelectorAll('[data-user-name-label]').forEach((el) => {
+    el.textContent = user.name || '';
+  });
+}
+
+export function renderUI(credentialsList) {
+  const containers = document.querySelectorAll('[data-passkey-list]');
+  const countBadges = document.querySelectorAll('[data-passkey-count]');
+
+  countBadges.forEach((badge) => {
+    badge.textContent = `${credentialsList.length} ${
+      credentialsList.length === 1 ? 'passkey' : 'passkeys'
+    }`;
+  });
+
+  containers.forEach((container) => {
+    container.innerHTML = '';
+
+    if (!credentialsList || credentialsList.length === 0) {
+      const emptyEl = document.createElement('div');
+      emptyEl.className = 'passkey-empty-state';
+      emptyEl.innerHTML = `
+        <div class="passkey-empty-icon" aria-hidden="true">🔑</div>
+        <h4>No passkeys found</h4>
+        <p>You don't have any registered passkeys on your Daily Grind account yet. Create a passkey for faster, phishing-resistant sign-ins.</p>
+      `;
+      container.appendChild(emptyEl);
+      return;
+    }
+
+    credentialsList.forEach((cred) => {
+      const { name, providerName, providerIcon } = resolveProviderDetails(cred);
+      const registeredDateStr = formatEpochDate(cred.registeredAt);
+      const lastUsedDateStr = cred.lastUsedAt
+        ? formatEpochDate(cred.lastUsedAt)
+        : 'Never used';
+
+      const row = document.createElement('div');
+      row.className = 'passkey-row';
+      row.dataset.credentialId = cred.id;
+
+      const deviceBadge =
+        cred.credentialDeviceType === 'multiDevice' ? 'Synced across devices' : 'Device-bound key';
+
+      row.innerHTML = `
+        <div class="passkey-row-main">
+          <div class="passkey-provider-icon-wrap">
+            <img
+              src="${providerIcon}"
+              alt="${providerName} icon"
+              class="passkey-provider-icon"
+              width="36"
+              height="36"
+            />
+          </div>
+          <div class="passkey-info">
+            <div class="passkey-title-line">
+              <strong class="passkey-name" data-credential-name>${escapeHtml(name)}</strong>
+              <span class="passkey-badge">${escapeHtml(deviceBadge)}</span>
+              ${
+                name !== providerName
+                  ? `<span class="passkey-provider-sub">via ${escapeHtml(providerName)}</span>`
+                  : ''
+              }
+            </div>
+            <div class="passkey-meta">
+              <span class="passkey-meta-item">
+                <strong>Registered:</strong>
+                <time datetime="${new Date(cred.registeredAt).toISOString()}">${escapeHtml(
+                  registeredDateStr
+                )}</time>
+              </span>
+              <span class="passkey-meta-sep" aria-hidden="true">•</span>
+              <span class="passkey-meta-item">
+                <strong>Last used:</strong>
+                ${
+                  cred.lastUsedAt
+                    ? `<time datetime="${new Date(cred.lastUsedAt).toISOString()}">${escapeHtml(
+                        lastUsedDateStr
+                      )}</time>`
+                    : `<span>Never used</span>`
+                }
+              </span>
+            </div>
+            <form class="passkey-rename-form" data-rename-form hidden>
+              <label class="sr-only" for="rename-input-${escapeHtml(cred.id)}">Passkey nickname</label>
+              <input
+                id="rename-input-${escapeHtml(cred.id)}"
+                type="text"
+                class="passkey-rename-input"
+                value="${escapeHtml(name)}"
+                maxlength="64"
+                required
+              />
+              <button type="submit" class="btn-passkey btn-passkey-save">Save</button>
+              <button type="button" class="btn-passkey btn-passkey-cancel" data-rename-cancel>Cancel</button>
+            </form>
+          </div>
+        </div>
+        <div class="passkey-actions">
+          <button
+            type="button"
+            class="btn-passkey btn-passkey-rename"
+            data-rename-trigger
+            aria-label="Rename passkey ${escapeHtml(name)}"
+          >
+            Rename
+          </button>
+          <button
+            type="button"
+            class="btn-passkey btn-passkey-delete"
+            data-delete-trigger
+            aria-label="Delete passkey ${escapeHtml(name)}"
+          >
+            Delete
+          </button>
+        </div>
+      `;
+
+      const renameTrigger = row.querySelector('[data-rename-trigger]');
+      const deleteTrigger = row.querySelector('[data-delete-trigger]');
+      const renameForm = row.querySelector('[data-rename-form]');
+      const renameInput = row.querySelector('.passkey-rename-input');
+      const renameCancel = row.querySelector('[data-rename-cancel]');
+
+      renameTrigger.addEventListener('click', () => {
+        renameForm.hidden = false;
+        renameTrigger.hidden = true;
+        renameInput.value = name;
+        renameInput.focus();
+        renameInput.select();
+      });
+
+      renameCancel.addEventListener('click', () => {
+        renameForm.hidden = true;
+        renameTrigger.hidden = false;
+        renameTrigger.focus();
+      });
+
+      renameForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const nextName = renameInput.value.trim();
+        if (nextName) {
+          await performCredentialRename(cred.id, nextName);
+        }
+      });
+
+      deleteTrigger.addEventListener('click', async () => {
+        await performDelete(cred.id);
+      });
+
+      container.appendChild(row);
+    });
+  });
+}
+
+function escapeHtml(str) {
+  return String(str)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;');
+}
+
+function bindStaticHandlers() {
+  document.querySelectorAll('[data-user-profile-form]').forEach((form) => {
+    form.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const nameInput = form.querySelector('[data-user-name-input]');
+      const displayNameInput = form.querySelector('[data-user-display-name-input]');
+      const updatedName = nameInput ? nameInput.value.trim() : currentUser.name;
+      const updatedDisplayName = displayNameInput
+        ? displayNameInput.value.trim()
+        : currentUser.displayName;
+
+      if (!updatedName || !updatedDisplayName) {
+        showStatusMessage('Username and display name are required.', 'error');
+        return;
+      }
+      await performUserRename(rpId, currentUser.id, updatedName, updatedDisplayName);
+    });
+  });
+
+  document.querySelectorAll('[data-create-passkey-btn]').forEach((btn) => {
+    btn.addEventListener('click', async () => {
+      await registerPasskey(false);
+    });
+  });
+}
+
+export async function loadManagementPanel() {
+  await gateCreatePasskeyButtons();
+  bindStaticHandlers();
+
+  const userRes = await userFetch();
+  currentUser = await userRes.json();
+  renderUserProfileUI(currentUser);
+
+  const response = await listFetch();
+  const list = await response.json();
+
+  renderUI(list);
+  // Sync accepted credentials on initial load
+  await syncAcceptedCredentials(list);
+}
+
+if (document.readyState === 'loading') {
+  window.addEventListener('DOMContentLoaded', loadManagementPanel);
+} else {
+  loadManagementPanel();
+}
