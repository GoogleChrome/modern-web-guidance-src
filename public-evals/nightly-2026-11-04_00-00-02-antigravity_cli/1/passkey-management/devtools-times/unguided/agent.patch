+          <form
+            onSubmit={handleRegisterPasskey}
+            className="mt-4 p-4 bg-gray-50 border border-gray-200 rounded-md flex flex-col sm:flex-row items-stretch sm:items-end gap-3"
+          >
+            <div className="flex-grow">
+              <label htmlFor="new-passkey-name" className="block text-xs font-semibold text-gray-700 mb-1">
+                New Passkey Display Name
+              </label>
+              <input
+                id="new-passkey-name"
+                type="text"
+                placeholder="e.g., Home iPad Air, Work Laptop (Chrome)"
+                value={newPasskeyName}
+                onChange={(e) => setNewPasskeyName(e.target.value)}
+                required
+                className="w-full px-3 py-2 bg-white border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+              />
+            </div>
+            <div className="flex space-x-2">
+              <button
+                type="submit"
+                className="px-4 py-2 bg-gray-900 text-white text-xs font-semibold rounded-md hover:bg-gray-800 whitespace-nowrap"
+              >
+                Register Passkey
+              </button>
+              <button
+                type="button"
+                onClick={() => {
+                  setIsAddingPasskey(false);
+                  setNewPasskeyName('');
+                }}
+                className="px-3 py-2 border border-gray-300 text-gray-700 text-xs font-semibold rounded-md bg-white hover:bg-gray-50"
+              >
+                Cancel
+              </button>
+            </div>
+          </form>
+        )}
+
+        {/* Registered Passkeys List */}
+        <div className="mt-6">
+          {passkeys.length === 0 ? (
+            <div className="text-center py-10 border border-dashed border-gray-300 rounded-lg">
+              <KeyIcon className="w-10 h-10 mx-auto text-gray-400 mb-2" />
+              <p className="text-sm font-semibold text-gray-700">No passkeys registered</p>
+              <p className="text-xs text-gray-500 mt-1">
+                All passkeys have been removed and your browser authenticator has been notified.
+              </p>
+            </div>
+          ) : (
+            <ul className="divide-y divide-gray-200" data-testid="passkeys-list">
+              {passkeys.map((passkey) => {
+                const isEditing = editingPasskeyId === passkey.id;
+                const isMobile = passkey.deviceType.toLowerCase().includes('synced') ||
+                  passkey.displayName.toLowerCase().includes('pixel') ||
+                  passkey.displayName.toLowerCase().includes('phone');
+
+                return (
+                  <li
+                    key={passkey.id}
+                    data-testid={`passkey-item-${passkey.id}`}
+                    className="py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
+                  >
+                    <div className="flex items-start space-x-3 flex-grow">
+                      <div className="p-2 bg-gray-100 rounded-lg text-gray-700 mt-0.5">
+                        {isMobile ? (
+                          <DevicePhoneMobileIcon className="w-6 h-6" />
+                        ) : (
+                          <ComputerDesktopIcon className="w-6 h-6" />
+                        )}
+                      </div>
+
+                      <div className="flex-grow">
+                        {isEditing ? (
+                          <div className="flex flex-wrap items-center gap-2">
+                            <label htmlFor={`edit-passkey-${passkey.id}`} className="sr-only">
+                              Passkey Display Name
+                            </label>
+                            <input
+                              id={`edit-passkey-${passkey.id}`}
