+              title="Synchronize passkeys with browser authenticator"
+            >
+              <ArrowPathIcon className="w-4 h-4 mr-1.5" />
+              Sync Authenticator
+            </button>
+            <button
+              type="button"
+              onClick={() => setIsAddingPasskey((prev) => !prev)}
+              className="inline-flex items-center px-3 py-2 bg-gray-900 text-white rounded-md text-xs font-semibold hover:bg-gray-800"
+            >
+              <PlusIcon className="w-4 h-4 mr-1.5" />
