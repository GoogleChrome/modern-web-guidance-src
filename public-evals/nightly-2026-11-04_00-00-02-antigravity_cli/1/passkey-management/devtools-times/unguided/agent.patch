+                          aria-label={`Remove passkey ${passkey.displayName}`}
+                        >
+                          <TrashIcon className="w-4 h-4 mr-1" />
+                          Remove
+                        </button>
+                      </div>
+                    )}
+                  </li>
+                );
+              })}
+            </ul>
+          )}
+        </div>
+      </section>
+
+      {/* Browser Authenticator Sync Status & Activity Log */}
+      <section aria-labelledby="sync-status-heading" className="bg-gray-50 border border-gray-200 rounded-lg p-6">
+        <div className="flex items-start space-x-3">
+          <ShieldCheckIcon className="w-6 h-6 text-gray-700 flex-shrink-0 mt-0.5" />
+          <div className="flex-grow">
+            <h3 id="sync-status-heading" className="text-sm font-bold text-gray-900">
+              Browser Authenticator Synchronization (WebAuthn Signal API)
+            </h3>
+            <p className="text-xs text-gray-600 mt-1">
+              Changes to your passkeys and display name are automatically signaled to your browser&apos;s credential manager so deleted keys and outdated names don&apos;t appear during sign-in.
+            </p>
+
+            <div className="mt-3 flex flex-wrap gap-2">
+              <span className="inline-flex items-center px-2.5 py-1 rounded text-xs font-mono bg-white border border-gray-200 text-gray-700">
+                signalAllAcceptedCredentials:{' '}
+                <strong className="ml-1">
+                  {signalCapabilities.signalAllAcceptedCredentials ? 'Supported' : 'Fallback'}
+                </strong>
+              </span>
+              <span className="inline-flex items-center px-2.5 py-1 rounded text-xs font-mono bg-white border border-gray-200 text-gray-700">
+                signalCurrentUserDetails:{' '}
+                <strong className="ml-1">
+                  {signalCapabilities.signalCurrentUserDetails ? 'Supported' : 'Fallback'}
+                </strong>
+              </span>
+              <span className="inline-flex items-center px-2.5 py-1 rounded text-xs font-mono bg-white border border-gray-200 text-gray-700">
+                signalUnknownCredential:{' '}
+                <strong className="ml-1">
+                  {signalCapabilities.signalUnknownCredential ? 'Supported' : 'Fallback'}
+                </strong>
+              </span>
+            </div>
+
+            {syncLogs.length > 0 && (
+              <div className="mt-4">
+                <h4 className="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2">
+                  Recent Authenticator Sync Events
+                </h4>
+                <ul className="space-y-1.5 text-xs">
+                  {syncLogs.map((log, index) => (
+                    <li
+                      key={`${log.timestamp}-${index}`}
+                      className="flex items-center justify-between bg-white px-3 py-2 rounded border border-gray-200"
+                    >
+                      <div>
+                        <code className="font-mono font-semibold text-gray-900 mr-2">
+                          PublicKeyCredential.{log.method}()
+                        </code>
+                        <span className="text-gray-600">{log.message}</span>
+                      </div>
+                      <span className="text-gray-400 font-mono ml-2 whitespace-nowrap">{log.timestamp}</span>
+                    </li>
+                  ))}
+                </ul>
+              </div>
+            )}
+          </div>
+        </div>
+      </section>
+    </div>
+  );
+}
