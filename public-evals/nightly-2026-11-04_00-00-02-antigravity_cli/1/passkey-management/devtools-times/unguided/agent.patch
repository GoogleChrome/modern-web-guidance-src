+    displayName: 'MacBook Pro (Chrome Profile)',
+    deviceType: 'Platform Authenticator (Touch ID)',
+    createdAt: '2026-06-15',
+    lastUsedAt: '2026-11-04',
+    backedUp: true,
+  },
+  {
+    id: 'pk-2',
+    credentialId: 'k9LmN2pQrS4tUvWxYz0123456789AbCdEf',
+    displayName: 'Pixel 9 Pro (Google Password Manager)',
+    deviceType: 'Synced Passkey',
+    createdAt: '2026-08-22',
+    lastUsedAt: '2026-10-29',
+    backedUp: true,
+  },
+  {
+    id: 'pk-3',
