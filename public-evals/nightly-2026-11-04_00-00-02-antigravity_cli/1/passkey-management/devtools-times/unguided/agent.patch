+export interface ReaderAccount {
+  userId: string; // base64url-encoded user handle
+  username: string;
+  displayName: string;
+  email: string;
+  subscriptionTier: string;
+}
+
+export interface SyncResult {
+  synced: boolean;
+  method: 'signalAllAcceptedCredentials' | 'signalUnknownCredential' | 'signalCurrentUserDetails';
+  message: string;
+  timestamp: string;
+}
