diff --git a/src/pages/api/passkeys.json.ts b/src/pages/api/passkeys.json.ts
new file mode 100644
index 0000000..227ff8b
--- /dev/null
+++ b/src/pages/api/passkeys.json.ts
@@ -0,0 +1,108 @@
+import type { APIRoute } from 'astro';
+import {
+  DEFAULT_PASSKEYS,
+  DEFAULT_READER_ACCOUNT,
+  type PasskeyCredential,
+  type ReaderAccount,
+} from '../../utils/passkeys';
+
+export const GET: APIRoute = async ({ session }) => {
+  const account: ReaderAccount = (await session?.get('account')) || DEFAULT_READER_ACCOUNT;
+  const passkeys: PasskeyCredential[] = (await session?.get('passkeys')) || DEFAULT_PASSKEYS;
+
+  return new Response(JSON.stringify({ account, passkeys }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await request.json();
+  let account: ReaderAccount = (await session?.get('account')) || { ...DEFAULT_READER_ACCOUNT };
+  let passkeys: PasskeyCredential[] = (await session?.get('passkeys')) || [...DEFAULT_PASSKEYS];
+
+  const { action } = body;
+
+  if (action === 'add' && body.passkey) {
+    passkeys = [body.passkey, ...passkeys];
+    await session?.set('passkeys', passkeys);
+  } else if (action === 'updatePasskey') {
+    const { credentialId, id, displayName } = body;
+    passkeys = passkeys.map((pk) =>
+      pk.credentialId === credentialId || pk.id === id
+        ? { ...pk, displayName: displayName.trim() }
+        : pk
+    );
+    await session?.set('passkeys', passkeys);
+  } else if (action === 'updateAccount') {
+    const { displayName, username } = body;
+    account = {
+      ...account,
+      displayName: displayName !== undefined ? displayName.trim() : account.displayName,
+      username: username !== undefined ? username.trim() : account.username,
+    };
+    await session?.set('account', account);
+  } else if (action === 'remove') {
+    const { credentialId, id } = body;
+    passkeys = passkeys.filter(
+      (pk) => pk.credentialId !== credentialId && pk.id !== id
+    );
+    await session?.set('passkeys', passkeys);
+  } else if (action === 'reset') {
+    account = { ...DEFAULT_READER_ACCOUNT };
+    passkeys = [...DEFAULT_PASSKEYS];
+    await session?.set('account', account);
+    await session?.set('passkeys', passkeys);
+  }
+
+  return new Response(JSON.stringify({ account, passkeys }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const PATCH: APIRoute = async ({ request, session }) => {
+  const body = await request.json();
+  let account: ReaderAccount = (await session?.get('account')) || { ...DEFAULT_READER_ACCOUNT };
+  let passkeys: PasskeyCredential[] = (await session?.get('passkeys')) || [...DEFAULT_PASSKEYS];
+
+  if (body.credentialId || body.id) {
+    passkeys = passkeys.map((pk) =>
+      pk.credentialId === body.credentialId || pk.id === body.id
+        ? { ...pk, displayName: (body.displayName || pk.displayName).trim() }
+        : pk
+    );
+    await session?.set('passkeys', passkeys);
+  }
+
+  if (body.userDisplayName !== undefined || body.username !== undefined || (!body.credentialId && !body.id && body.displayName !== undefined)) {
+    account = {
+      ...account,
+      displayName: (body.userDisplayName ?? body.displayName ?? account.displayName).trim(),
+      username: (body.username ?? account.username).trim(),
+    };
+    await session?.set('account', account);
+  }
+
+  return new Response(JSON.stringify({ account, passkeys }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const DELETE: APIRoute = async ({ request, session }) => {
+  const body = await request.json();
+  let passkeys: PasskeyCredential[] = (await session?.get('passkeys')) || [...DEFAULT_PASSKEYS];
+  const { credentialId, id } = body;
+
+  passkeys = passkeys.filter(
+    (pk) => pk.credentialId !== credentialId && pk.id !== id
+  );
+  await session?.set('passkeys', passkeys);
+
+  const account: ReaderAccount = (await session?.get('account')) || DEFAULT_READER_ACCOUNT;
+  return new Response(JSON.stringify({ account, passkeys }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
