+import React, { useState, useEffect } from 'react';
+import {
+  KeyIcon,
+  PencilSquareIcon,
+  TrashIcon,
+  PlusIcon,
+  ArrowPathIcon,
+  CheckCircleIcon,
+  ShieldCheckIcon,
+  UserCircleIcon,
+  DevicePhoneMobileIcon,
+  ComputerDesktopIcon,
+} from '@heroicons/react/24/outline';
+import {
+  DEFAULT_PASSKEYS,
+  DEFAULT_READER_ACCOUNT,
+  getRpId,
+  syncAllAcceptedCredentials,
+  syncCurrentUserDetails,
+  syncUnknownCredential,
+  toBase64Url,
+  type PasskeyCredential,
+  type ReaderAccount,
+  type SyncResult,
+} from '../utils/passkeys';
+
+interface Props {
+  initialAccount?: ReaderAccount;
+  initialPasskeys?: PasskeyCredential[];
+}
+
+export default function AccountSettings({
+  initialAccount = DEFAULT_READER_ACCOUNT,
+  initialPasskeys = DEFAULT_PASSKEYS,
+}: Props) {
+  const [isSignedIn, setIsSignedIn] = useState(true);
+  const [account, setAccount] = useState<ReaderAccount>(initialAccount);
+  const [passkeys, setPasskeys] = useState<PasskeyCredential[]>(initialPasskeys);
+
+  // Account display name editing state
+  const [accountDisplayNameInput, setAccountDisplayNameInput] = useState(initialAccount.displayName);
+  const [accountUsernameInput, setAccountUsernameInput] = useState(initialAccount.username);
+  const [isEditingAccount, setIsEditingAccount] = useState(false);
+
+  // Per-passkey display name editing state
+  const [editingPasskeyId, setEditingPasskeyId] = useState<string | null>(null);
+  const [editingPasskeyName, setEditingPasskeyName] = useState('');
+
+  // New passkey creation state
+  const [newPasskeyName, setNewPasskeyName] = useState('');
+  const [isAddingPasskey, setIsAddingPasskey] = useState(false);
+
+  // Feedback & Authenticator Sync status
+  const [statusMessage, setStatusMessage] = useState<string | null>(null);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [syncLogs, setSyncLogs] = useState<SyncResult[]>([]);
+  const [signalCapabilities, setSignalCapabilities] = useState<{
+    signalAllAcceptedCredentials: boolean;
+    signalCurrentUserDetails: boolean;
+    signalUnknownCredential: boolean;
+  }>({
+    signalAllAcceptedCredentials: false,
+    signalCurrentUserDetails: false,
+    signalUnknownCredential: false,
+  });
+
+  const recordSyncResult = (result: SyncResult) => {
+    setSyncLogs((prev) => [result, ...prev.slice(0, 9)]);
+  };
+
+  // Detect WebAuthn Signal API support and fetch latest session state on mount
+  useEffect(() => {
+    if (typeof window !== 'undefined' && 'PublicKeyCredential' in window) {
+      setSignalCapabilities({
+        signalAllAcceptedCredentials: typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function',
+        signalCurrentUserDetails: typeof PublicKeyCredential.signalCurrentUserDetails === 'function',
+        signalUnknownCredential: typeof PublicKeyCredential.signalUnknownCredential === 'function',
+      });
+    }
+
+    const loadPasskeysAndSync = async () => {
+      try {
+        const storedUser = localStorage.getItem('devtools_times_user');
+        let currentAccount = initialAccount;
+        if (storedUser) {
+          try {
+            const parsed = JSON.parse(storedUser);
+            if (parsed.username) {
+              currentAccount = {
+                ...currentAccount,
+                username: parsed.username,
+                displayName: parsed.displayName || parsed.username,
+              };
+            }
+          } catch {
+            // Ignore malformed localStorage entry
+          }
+        }
+
+        const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`);
+        if (response.ok) {
+          const data = await response.json();
+          if (data.account) {
+            currentAccount = storedUser ? { ...data.account, ...currentAccount } : data.account;
+            setAccount(currentAccount);
+            setAccountDisplayNameInput(currentAccount.displayName);
+            setAccountUsernameInput(currentAccount.username);
+          }
+          if (Array.isArray(data.passkeys)) {
+            setPasskeys(data.passkeys);
+            // Synchronize browser authenticator with accepted credentials on load
+            const syncRes = await syncAllAcceptedCredentials(
+              currentAccount.userId,
+              data.passkeys.map((pk: PasskeyCredential) => pk.credentialId)
+            );
+            recordSyncResult(syncRes);
+          }
+        }
+      } catch {
+        // Fallback to initial state and still sync authenticator
+        const syncRes = await syncAllAcceptedCredentials(
+          account.userId,
+          passkeys.map((pk) => pk.credentialId)
+        );
+        recordSyncResult(syncRes);
+      }
+    };
+
+    loadPasskeysAndSync();
+  }, []);
+
+  /**
+   * Update a passkey's display name and synchronize with the browser authenticator
+   */
+  const handleUpdatePasskeyDisplayName = async (passkey: PasskeyCredential) => {
+    const trimmedName = editingPasskeyName.trim();
+    if (!trimmedName) {
+      setErrorMessage('Display name cannot be empty.');
+      return;
+    }
+
+    setErrorMessage(null);
+    const updatedPasskeys = passkeys.map((pk) =>
+      pk.id === passkey.id ? { ...pk, displayName: trimmedName } : pk
+    );
+    setPasskeys(updatedPasskeys);
+    setEditingPasskeyId(null);
+    setEditingPasskeyName('');
+
+    try {
+      await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          id: passkey.id,
+          credentialId: passkey.credentialId,
+          displayName: trimmedName,
+        }),
+      });
+    } catch {
+      // Continue with client-side authenticator sync even if offline
+    }
+
+    // Signal updated display name details to the browser authenticator
+    const rpId = getRpId();
+    if (
+      typeof window !== 'undefined' &&
+      'PublicKeyCredential' in window &&
+      typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+    ) {
+      await PublicKeyCredential.signalCurrentUserDetails({
+        rpId,
+        userId: account.userId,
+        name: account.username,
+        displayName: trimmedName,
+      });
+    }
+
+    const syncRes = await syncCurrentUserDetails(account.userId, account.username, trimmedName, rpId);
+    recordSyncResult(syncRes);
+    setStatusMessage(`Updated passkey display name to "${trimmedName}" and synced with browser authenticator.`);
+  };
+
+  /**
+   * Update the reader's account display name / username and synchronize with the browser authenticator
+   */
+  const handleUpdateAccountDetails = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmedDisplayName = accountDisplayNameInput.trim();
+    const trimmedUsername = accountUsernameInput.trim();
+
+    if (!trimmedDisplayName || !trimmedUsername) {
+      setErrorMessage('Display name and username cannot be empty.');
+      return;
+    }
+
+    setErrorMessage(null);
+    const updatedAccount: ReaderAccount = {
+      ...account,
+      displayName: trimmedDisplayName,
+      username: trimmedUsername,
+    };
+    setAccount(updatedAccount);
+    setIsEditingAccount(false);
+
+    try {
+      localStorage.setItem('devtools_times_user', JSON.stringify(updatedAccount));
+      await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          userDisplayName: trimmedDisplayName,
+          username: trimmedUsername,
+        }),
+      });
+    } catch {
+      // Continue with client-side authenticator sync
+    }
+
+    const rpId = getRpId();
+    if (
+      typeof window !== 'undefined' &&
+      'PublicKeyCredential' in window &&
+      typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+    ) {
+      await PublicKeyCredential.signalCurrentUserDetails({
+        rpId,
+        userId: updatedAccount.userId,
+        name: updatedAccount.username,
+        displayName: updatedAccount.displayName,
+      });
+    }
+
+    const syncRes = await syncCurrentUserDetails(
+      updatedAccount.userId,
+      updatedAccount.username,
+      updatedAccount.displayName,
+      rpId
+    );
+    recordSyncResult(syncRes);
+    setStatusMessage(`Updated account display name to "${trimmedDisplayName}" and synced with browser authenticator.`);
+  };
+
+  /**
+   * Remove a passkey and synchronize removal with the browser authenticator using
+   * PublicKeyCredential.signalUnknownCredential and PublicKeyCredential.signalAllAcceptedCredentials
+   */
+  const handleRemovePasskey = async (passkeyToRemove: PasskeyCredential) => {
+    setErrorMessage(null);
+    const remainingPasskeys = passkeys.filter(
+      (pk) => pk.credentialId !== passkeyToRemove.credentialId && pk.id !== passkeyToRemove.id
+    );
+    setPasskeys(remainingPasskeys);
+
+    try {
+      await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'DELETE',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          id: passkeyToRemove.id,
+          credentialId: passkeyToRemove.credentialId,
+        }),
+      });
+    } catch {
+      // Continue with client-side authenticator sync
+    }
+
+    const rpId = getRpId();
+    const remainingCredentialIds = remainingPasskeys.map((pk) => pk.credentialId);
+
+    // 1. Signal the removed credential as unknown to the authenticator
+    if (
+      typeof window !== 'undefined' &&
+      'PublicKeyCredential' in window &&
+      typeof PublicKeyCredential.signalUnknownCredential === 'function'
+    ) {
+      await PublicKeyCredential.signalUnknownCredential({
+        rpId,
+        credentialId: passkeyToRemove.credentialId,
+      });
+    }
+    const unknownRes = await syncUnknownCredential(passkeyToRemove.credentialId, rpId);
+    recordSyncResult(unknownRes);
+
+    // 2. Signal the updated list of all accepted credentials for this user
+    if (
+      typeof window !== 'undefined' &&
+      'PublicKeyCredential' in window &&
+      typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+    ) {
+      await PublicKeyCredential.signalAllAcceptedCredentials({
+        rpId,
+        userId: account.userId,
+        allAcceptedCredentialIds: remainingCredentialIds,
+      });
+    }
+    const acceptedRes = await syncAllAcceptedCredentials(account.userId, remainingCredentialIds, rpId);
+    recordSyncResult(acceptedRes);
+
+    setStatusMessage(
+      `Removed passkey "${passkeyToRemove.displayName}" and synchronized browser authenticator.`
+    );
+  };
+
+  /**
+   * Register a new passkey and synchronize accepted credentials with the browser authenticator
+   */
+  const handleRegisterPasskey = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setErrorMessage(null);
+    const label = newPasskeyName.trim() || `Reader Passkey (${new Date().toLocaleDateString()})`;
+
+    let credentialId = '';
+    try {
+      if (
+        typeof window !== 'undefined' &&
+        window.PublicKeyCredential &&
+        navigator.credentials &&
+        typeof navigator.credentials.create === 'function'
+      ) {
+        const challenge = crypto.getRandomValues(new Uint8Array(32));
+        const userIdBytes = new TextEncoder().encode(account.userId);
+        const credential = (await navigator.credentials.create({
+          publicKey: {
+            challenge,
+            rp: {
+              name: 'The DevTools Times',
+              id: getRpId(),
+            },
+            user: {
+              id: userIdBytes,
+              name: account.username,
+              displayName: account.displayName,
+            },
+            pubKeyCredParams: [
+              { type: 'public-key', alg: -7 }, // ES256
+              { type: 'public-key', alg: -257 }, // RS256
+            ],
+            authenticatorSelection: {
+              residentKey: 'required',
+              userVerification: 'preferred',
+            },
+            excludeCredentials: passkeys.map((pk) => ({
+              type: 'public-key' as const,
+              id: new TextEncoder().encode(pk.credentialId),
+            })),
+          },
+        })) as PublicKeyCredential | null;
+
+        if (credential?.rawId) {
+          credentialId = toBase64Url(new Uint8Array(credential.rawId));
+        } else if (credential?.id) {
+          credentialId = credential.id;
+        }
+      }
+    } catch {
+      // Fallback to generating a realistic base64url credential ID when WebAuthn UI is cancelled or unavailable
+    }
+
+    if (!credentialId) {
+      const randomBytes = crypto.getRandomValues(new Uint8Array(24));
+      credentialId = toBase64Url(randomBytes);
+    }
+
+    const today = new Date().toISOString().split('T')[0];
+    const newPasskey: PasskeyCredential = {
+      id: `pk-${Date.now()}`,
+      credentialId,
+      displayName: label,
+      deviceType: 'Platform Authenticator',
+      createdAt: today,
+      lastUsedAt: today,
+      backedUp: true,
+    };
+
+    const updatedPasskeys = [newPasskey, ...passkeys];
+    setPasskeys(updatedPasskeys);
+    setNewPasskeyName('');
+    setIsAddingPasskey(false);
+
+    try {
+      await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ action: 'add', passkey: newPasskey }),
+      });
+    } catch {
+      // Continue with client-side sync
+    }
+
+    const syncRes = await syncAllAcceptedCredentials(
+      account.userId,
+      updatedPasskeys.map((pk) => pk.credentialId)
+    );
+    recordSyncResult(syncRes);
+    setStatusMessage(`Registered new passkey "${label}" and synchronized browser authenticator.`);
+  };
+
+  /**
+   * Manually trigger a full authenticator synchronization
+   */
+  const handleManualSync = async () => {
+    setErrorMessage(null);
+    const rpId = getRpId();
+    const userRes = await syncCurrentUserDetails(
+      account.userId,
+      account.username,
+      account.displayName,
+      rpId
+    );
+    recordSyncResult(userRes);
+
+    const credsRes = await syncAllAcceptedCredentials(
+      account.userId,
+      passkeys.map((pk) => pk.credentialId),
+      rpId
+    );
+    recordSyncResult(credsRes);
+
+    setStatusMessage('Synchronized current user details and all accepted passkeys with browser authenticator.');
+  };
+
+  if (!isSignedIn) {
+    return (
+      <div className="max-w-3xl mx-auto my-10 p-8 bg-white border border-gray-200 rounded-lg shadow-sm text-center">
+        <UserCircleIcon className="w-12 h-12 mx-auto text-gray-400 mb-3" />
+        <h2 className="text-2xl font-bold text-gray-900 mb-2">Sign in to manage your account</h2>
+        <p className="text-sm text-gray-600 mb-6">
+          You need to be signed in to view and manage your registered passkeys.
+        </p>
+        <div className="flex justify-center space-x-3">
+          <button
+            type="button"
+            onClick={() => setIsSignedIn(true)}
+            className="px-4 py-2 bg-gray-900 text-white text-sm font-semibold rounded hover:bg-gray-800"
+          >
+            Continue as {account.displayName}
+          </button>
+          <a
+            href={`${import.meta.env.BASE_URL}signin`}
+            className="px-4 py-2 border border-gray-300 text-gray-700 text-sm font-semibold rounded hover:bg-gray-50"
+          >
+            Go to Sign In Page
+          </a>
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div className="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
+      {/* Page Header */}
+      <div className="border-b border-gray-300 pb-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+        <div>
+          <p className="text-xs font-bold uppercase tracking-wider text-gray-500">Subscriber Account</p>
+          <h1 className="text-3xl font-bold text-gray-900 mt-1">Account Settings</h1>
+          <p className="text-sm text-gray-600 mt-1">
+            Manage your reader profile, registered passkeys, and browser authenticator synchronization.
+          </p>
+        </div>
+        <div className="flex items-center space-x-3">
+          <span className="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
+            <span className="w-2 h-2 rounded-full bg-green-600 mr-1.5"></span>
+            Signed in as {account.displayName}
+          </span>
+          <button
+            type="button"
+            onClick={() => setIsSignedIn(false)}
+            className="text-xs font-semibold text-gray-500 hover:text-gray-800 underline"
+          >
+            Sign out
+          </button>
+        </div>
+      </div>
+
+      {/* Status & Error Alerts */}
+      {statusMessage && (
+        <div
+          role="status"
+          className="p-4 rounded-lg bg-green-50 border border-green-200 flex items-start justify-between text-sm text-green-800"
+        >
+          <div className="flex items-center space-x-2">
+            <CheckCircleIcon className="w-5 h-5 text-green-600 flex-shrink-0" />
+            <span>{statusMessage}</span>
+          </div>
+          <button
+            type="button"
+            onClick={() => setStatusMessage(null)}
+            className="text-xs text-green-700 hover:underline ml-4"
+          >
+            Dismiss
+          </button>
+        </div>
+      )}
+
+      {errorMessage && (
+        <div
+          role="alert"
+          className="p-4 rounded-lg bg-red-50 border border-red-200 flex items-center justify-between text-sm text-red-800"
+        >
+          <span>{errorMessage}</span>
+          <button
+            type="button"
+            onClick={() => setErrorMessage(null)}
+            className="text-xs text-red-700 hover:underline ml-4"
+          >
+            Dismiss
+          </button>
+        </div>
+      )}
+
+      {/* Reader Profile & Display Name Section */}
+      <section aria-labelledby="profile-heading" className="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
+        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-gray-200 gap-3">
+          <div className="flex items-center space-x-3">
+            <UserCircleIcon className="w-7 h-7 text-gray-700" />
+            <div>
+              <h2 id="profile-heading" className="text-lg font-bold text-gray-900">
+                Reader Profile &amp; Passkey Identity
+              </h2>
+              <p className="text-xs text-gray-500">
+                Updating your display name or username automatically syncs with your browser authenticator via{' '}
+                <code className="bg-gray-100 px-1 py-0.5 rounded text-gray-800">
+                  PublicKeyCredential.signalCurrentUserDetails()
+                </code>
+                .
+              </p>
+            </div>
+          </div>
+          {!isEditingAccount && (
+            <button
+              type="button"
+              onClick={() => {
+                setAccountDisplayNameInput(account.displayName);
+                setAccountUsernameInput(account.username);
+                setIsEditingAccount(true);
+              }}
+              className="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-md text-xs font-semibold text-gray-700 bg-white hover:bg-gray-50"
+            >
+              <PencilSquareIcon className="w-4 h-4 mr-1.5" />
+              Edit Display Name
+            </button>
+          )}
+        </div>
+
+        {isEditingAccount ? (
+          <form onSubmit={handleUpdateAccountDetails} className="mt-4 space-y-4">
+            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
+              <div>
+                <label htmlFor="account-display-name" className="block text-xs font-semibold text-gray-700 mb-1">
+                  Display Name
+                </label>
+                <input
+                  id="account-display-name"
+                  type="text"
+                  value={accountDisplayNameInput}
+                  onChange={(e) => setAccountDisplayNameInput(e.target.value)}
+                  required
+                  className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+                />
+              </div>
+              <div>
+                <label htmlFor="account-username" className="block text-xs font-semibold text-gray-700 mb-1">
+                  Username / Account Email
+                </label>
+                <input
+                  id="account-username"
+                  type="text"
+                  value={accountUsernameInput}
+                  onChange={(e) => setAccountUsernameInput(e.target.value)}
+                  required
+                  className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+                />
+              </div>
+            </div>
+            <div className="flex items-center space-x-3">
+              <button
+                type="submit"
+                className="px-4 py-2 bg-gray-900 text-white text-xs font-semibold rounded-md hover:bg-gray-800"
+              >
+                Save &amp; Sync Authenticator
+              </button>
+              <button
+                type="button"
+                onClick={() => setIsEditingAccount(false)}
+                className="px-4 py-2 border border-gray-300 text-gray-700 text-xs font-semibold rounded-md hover:bg-gray-50"
+              >
+                Cancel
+              </button>
+            </div>
+          </form>
+        ) : (
+          <dl className="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
+            <div>
+              <dt className="text-xs font-semibold text-gray-500 uppercase">Display Name</dt>
+              <dd className="mt-1 font-medium text-gray-900">{account.displayName}</dd>
+            </div>
+            <div>
+              <dt className="text-xs font-semibold text-gray-500 uppercase">Username</dt>
+              <dd className="mt-1 font-medium text-gray-900">{account.username}</dd>
+            </div>
+            <div>
+              <dt className="text-xs font-semibold text-gray-500 uppercase">Subscription</dt>
+              <dd className="mt-1 font-medium text-gray-900">{account.subscriptionTier}</dd>
+            </div>
+          </dl>
+        )}
+      </section>
+
+      {/* Passkey Management Section */}
+      <section aria-labelledby="passkeys-heading" className="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
+        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-gray-200 gap-4">
+          <div className="flex items-start space-x-3">
+            <KeyIcon className="w-7 h-7 text-gray-900 flex-shrink-0 mt-0.5" />
+            <div>
+              <h2 id="passkeys-heading" className="text-xl font-bold text-gray-900">
+                Passkey Management
+              </h2>
+              <p className="text-xs text-gray-600 mt-0.5">
+                View your registered passkeys, update their display names, or remove keys you no longer use while keeping your browser authenticator in sync.
+              </p>
+            </div>
+          </div>
+
+          <div className="flex items-center space-x-2">
+            <button
+              type="button"
+              onClick={handleManualSync}
