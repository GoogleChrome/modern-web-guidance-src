+  <script type="module">
+    // Load polyfills for Out-of-Order HTML Streaming and HTML Setters when not natively supported
+    async function ensureStreamingPolyfills() {
+      const tasks = [];
+      if (!('for' in HTMLTemplateElement.prototype)) {
+        tasks.push(import('template-for-polyfill').catch(() => null));
+      }
+      if (!('streamHTML' in Element.prototype) || !('setHTMLUnsafe' in Element.prototype)) {
+        tasks.push(import('html-setters-polyfill').catch(() => null));
+      }
+      if (tasks.length > 0) {
+        await Promise.all(tasks);
+      }
+    }
+
+    let domPurifyPromise;
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('dompurify').then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    // Strict allowlist for untrusted customer-submitted reviews
+    const REVIEW_ELEMENTS = ['p', 'b', 'i', 'strong', 'em', 'span', 'div'];
+    const REVIEW_ATTRIBUTES = ['class'];
+
+    /**
+     * Safely sanitizes and sets untrusted customer review HTML using the native
+     * Sanitizer API (`Element.prototype.setHTML`), falling back to DOMPurify.
+     */
+    export async function safeSetReviewHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        const sanitizer =
+          typeof Sanitizer !== 'undefined'
+            ? new Sanitizer({ elements: REVIEW_ELEMENTS, attributes: REVIEW_ATTRIBUTES })
+            : { elements: REVIEW_ELEMENTS, attributes: REVIEW_ATTRIBUTES };
+        el.setHTML(html, { sanitizer });
+      } else {
+        const DOMPurify = await loadDOMPurify();
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...REVIEW_ELEMENTS, '#text'],
+          ALLOWED_ATTR: REVIEW_ATTRIBUTES,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+    }
+
+    /**
+     * Safely parses untrusted HTML into a Document for live previewing without
+     * serializing back to innerHTML (avoiding mutation XSS).
+     */
+    export async function updateReviewPreview(previewEl, rawHTML) {
+      if ('parseHTML' in Document) {
+        const doc = Document.parseHTML(rawHTML, {
+          sanitizer: { elements: REVIEW_ELEMENTS, attributes: REVIEW_ATTRIBUTES }
+        });
+        previewEl.replaceChildren(...doc.body.childNodes);
+      } else {
+        await safeSetReviewHTML(previewEl, rawHTML);
+      }
+    }
+
+    const FALLBACK_REFRESHED_MENU_HTML = `
+      <div class="card" data-card-id="spiced-chai-latte">
+        <div>
+          <img
+            class="card-img"
+            src="https://images.unsplash.com/photo-1572442388796-11668a67e53d?auto=format&fit=crop&w=600&q=80"
+            alt="Spiced Chai Oat Latte"
+            loading="lazy"
+          >
+          <h3>Spiced Chai Oat Latte</h3>
+          <p>House-steeped masala chai blended with velvety steamed oat milk.</p>
+        </div>
+        <a href="/menu/chai" class="btn">View Details</a>
+      </div>
+      <div class="card" data-card-id="honey-cinnamon-cortado">
+        <div>
+          <img
+            class="card-img"
+            src="https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80"
+            alt="Honey Cinnamon Cortado"
+            loading="lazy"
+          >
+          <h3>Honey Cinnamon Cortado</h3>
+          <p>Equal parts rich espresso and warm milk kissed with wildflower honey.</p>
+        </div>
+        <a href="/menu/cortado" class="btn">View Details</a>
+      </div>
+      <div class="card" data-card-id="nitro-vanilla-cold-brew">
+        <div>
+          <img
+            class="card-img"
+            src="https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80"
+            alt="Nitro Vanilla Cold Brew"
+            loading="lazy"
+          >
+          <h3>Nitro Vanilla Cold Brew</h3>
+          <p>Cascading nitrogen-infused cold brew with Madagascar vanilla bean.</p>
+        </div>
+        <a href="/menu/nitro" class="btn">View Details</a>
+      </div>
+    `;
+
+    /**
+     * Streams fresh seasonal menu HTML from the server directly into #seasonal-grid
+     * using imperative HTML streaming (`streamHTML()`), preserving focus if active.
+     */
+    export async function refreshSeasonalCards(endpoint = '/api/menu/seasonal') {
+      const grid = document.getElementById('seasonal-grid');
+      if (!grid) return;
+
+      // Preserve focus across out-of-order/streamed replacement
+      const activeEl = document.activeElement;
+      const hadFocusInsideGrid = activeEl && grid.contains(activeEl);
+      const activeCardId = activeEl?.closest('[data-card-id]')?.getAttribute('data-card-id');
+
+      try {
+        const response = await fetch(endpoint);
+        if (!response.ok) {
+          throw new Error(`Menu fetch returned ${response.status}`);
+        }
+
+        if ('streamHTML' in grid) {
+          if ('textStream' in response && typeof response.textStream === 'function') {
+            await response.textStream().pipeTo(grid.streamHTML());
+          } else if (response.body) {
+            await response.body
+              .pipeThrough(new TextDecoderStream())
+              .pipeTo(grid.streamHTML());
+          }
+        } else if ('setHTML' in grid) {
+          const html = await response.text();
+          grid.setHTML(html);
+        } else {
+          const html = await response.text();
+          const DOMPurify = await loadDOMPurify();
+          grid.innerHTML = DOMPurify.sanitize(html);
+        }
+      } catch {
+        // Fallback stream when running against a static file server without /api/menu/seasonal
+        if ('streamHTML' in grid) {
+          const stream = new ReadableStream({
+            start(controller) {
+              controller.enqueue(FALLBACK_REFRESHED_MENU_HTML);
+              controller.close();
+            }
+          });
+          await stream.pipeTo(grid.streamHTML());
+        } else if ('setHTML' in grid) {
+          grid.setHTML(FALLBACK_REFRESHED_MENU_HTML);
+        } else {
+          const DOMPurify = await loadDOMPurify();
+          grid.innerHTML = DOMPurify.sanitize(FALLBACK_REFRESHED_MENU_HTML);
+        }
+      }
+
+      if (hadFocusInsideGrid) {
+        const target =
+          (activeCardId && grid.querySelector(`[data-card-id="${activeCardId}"] a, [data-card-id="${activeCardId}"] button`)) ||
+          grid.querySelector('a, button');
+        target?.focus();
+      }
+    }
+
+    // Trusted first-party CMS promo block containing an embedded widget script
+    const TRUSTED_CMS_PROMO_HTML = `
+      <div>
+        <span class="promo-badge">CMS LIVE OFFER</span>
+        <h3>Double Bean Rewards Week</h3>
+        <p>Order any Seasonal Favorite before Friday and earn 2x loyalty beans.</p>
+        <div id="cms-promo-widget" data-reward-multiplier="2" style="margin-top: 12px; font-weight: bold; color: var(--accent);">
+          Initializing reward widget...
+        </div>
+        <script>
+          (() => {
+            const widget = document.getElementById('cms-promo-widget');
+            if (widget) {
+              const multiplier = widget.getAttribute('data-reward-multiplier') || '2';
+              widget.textContent = 'Active Perk: ' + multiplier + 'x Bonus Beans applied at checkout!';
+            }
+          })();
+        <\/script>
+      </div>
+    `;
+
+    /**
+     * Renders or streams the trusted CMS promo block with `{ runScripts: true }`
+     * so its embedded widget script executes upon insertion.
+     */
+    export async function renderCmsPromoBlock(cmsHTML = TRUSTED_CMS_PROMO_HTML, endpoint = null) {
+      const promoContainer = document.getElementById('cms-promo-container');
+      if (!promoContainer) return;
+
+      if (endpoint) {
+        try {
+          const response = await fetch(endpoint);
+          if (response.ok && 'streamHTMLUnsafe' in promoContainer) {
+            if ('textStream' in response && typeof response.textStream === 'function') {
+              await response.textStream().pipeTo(promoContainer.streamHTMLUnsafe({ runScripts: true }));
+              return;
+            } else if (response.body) {
+              await response.body
+                .pipeThrough(new TextDecoderStream())
+                .pipeTo(promoContainer.streamHTMLUnsafe({ runScripts: true }));
+              return;
+            }
+          }
+        } catch {
+          // Fall through to static trusted CMS HTML
+        }
+      }
+
+      if ('setHTMLUnsafe' in promoContainer) {
+        promoContainer.setHTMLUnsafe(cmsHTML, { runScripts: true });
+      }
+    }
+
+    // Initialize interactive handlers
+    await ensureStreamingPolyfills();
+    await renderCmsPromoBlock();
+
+    const refreshBtn = document.getElementById('refresh-menu-btn');
+    refreshBtn?.addEventListener('click', () => {
+      refreshSeasonalCards('/api/menu/seasonal');
+    });
+
+    // Also listen for custom 'menu-change' events dispatched when the server menu changes
+    window.addEventListener('menu-change', (event) => {
+      const endpoint = event.detail?.endpoint || '/api/menu/seasonal';
+      refreshSeasonalCards(endpoint);
+    });
+
+    // Customer review live preview and submission using Sanitizer API
+    const reviewForm = document.getElementById('review-form');
+    const reviewInput = document.getElementById('review-input');
+    const reviewPreview = document.getElementById('review-preview');
+    const reviewsList = document.getElementById('reviews-list');
+
+    reviewInput?.addEventListener('input', () => {
+      updateReviewPreview(reviewPreview, reviewInput.value);
+    });
+
+    reviewForm?.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const rawReview = reviewInput?.value.trim();
+      if (!rawReview || !reviewsList) return;
+
+      const reviewItem = document.createElement('div');
+      reviewItem.className = 'review-item';
+      await safeSetReviewHTML(reviewItem, `<p>${rawReview}</p>`);
+      reviewsList.appendChild(reviewItem);
+
+      reviewInput.value = '';
+      reviewPreview.replaceChildren();
+    });
+  </script>
