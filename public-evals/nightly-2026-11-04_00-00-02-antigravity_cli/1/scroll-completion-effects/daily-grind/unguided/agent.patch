+  <script>
+    (function () {
+      let activeCleanup = null;
+
+      function waitForScrollEnd(targetElement, callback) {
+        if (activeCleanup) {
+          activeCleanup();
+          activeCleanup = null;
+        }
+
+        let finished = false;
+        let debounceTimer = null;
+        let maxWaitTimer = null;
+
+        function complete() {
+          if (finished) return;
+          finished = true;
+          cleanup();
+          callback();
+        }
+
+        function onScroll() {
+          clearTimeout(debounceTimer);
+          debounceTimer = setTimeout(complete, 120);
+        }
+
+        function onScrollEnd() {
+          complete();
+        }
+
+        function cleanup() {
+          window.removeEventListener('scroll', onScroll, { passive: true });
+          window.removeEventListener('scrollend', onScrollEnd);
+          clearTimeout(debounceTimer);
+          clearTimeout(maxWaitTimer);
+          if (activeCleanup === cleanup) {
+            activeCleanup = null;
+          }
+        }
+
+        activeCleanup = cleanup;
+
+        window.addEventListener('scroll', onScroll, { passive: true });
+        window.addEventListener('scrollend', onScrollEnd, { once: true });
+
+        // Handle case where page is already at target scroll position (no scroll events fired)
+        debounceTimer = setTimeout(complete, 150);
+        // Fallback safety timeout
+        maxWaitTimer = setTimeout(complete, 1500);
+      }
+
+      function activateTarget(target, link) {
+        document.querySelectorAll('.scroll-target-active').forEach((el) => {
+          el.classList.remove('scroll-target-active');
+        });
+        document.querySelectorAll('nav a.active').forEach((el) => {
+          el.classList.remove('active');
+        });
+
+        if (link && link.closest('nav')) {
+          link.classList.add('active');
+        }
+
+        if (!target.hasAttribute('tabindex')) {
+          target.setAttribute('tabindex', '-1');
+        }
+
+        // Force reflow so animation restarts if clicking the same link twice
+        void target.offsetWidth;
+        target.classList.add('scroll-target-active');
+        target.focus({ preventScroll: true });
+      }
+
+      document.querySelectorAll('a[href^="#"]').forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const hash = link.getAttribute('href');
+          if (!hash || hash === '#') return;
+
+          const target = document.querySelector(hash);
+          if (!target) return;
+
+          event.preventDefault();
+          history.pushState(null, '', hash);
+
+          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
+
+          waitForScrollEnd(target, () => {
+            activateTarget(target, link);
+          });
+        });
+      });
+    })();
+  </script>
