+          }
+
+          htmlTextarea.value = currentVal.slice(0, start) + replacement + currentVal.slice(end);
+          htmlTextarea.focus();
+        });
+      });
+
+      reviewForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const rawHtml = htmlTextarea.value.trim();
+        if (!rawHtml) {
+          noticeEl.textContent = 'Please enter your review feedback before submitting.';
+          noticeEl.classList.add('visible');
+          return;
+        }
+
+        const authorName = nameInput.value.trim() || 'Coffee Enthusiast';
+        const selectedDrink = drinkSelect.value || 'Maple Oat Latte';
+        const selectedRating = Number(ratingSelect.value) || 5;
+
+        const probe = document.createElement('div');
+        setSanitizedReviewHTML(probe, rawHtml);
+
+        reviews.unshift({
+          id: Date.now(),
+          author: authorName,
+          drink: selectedDrink,
+          rating: selectedRating,
+          html: rawHtml
+        });
+
+        if (activeFilter !== 'all' && activeFilter !== selectedDrink) {
+          activeFilter = 'all';
+          filterTabs.forEach((t) => {
+            t.classList.toggle('active', t.getAttribute('data-filter-drink') === 'all');
+          });
+        }
+
+        renderReviews();
+
+        noticeEl.textContent = `Your review for ${selectedDrink} was sanitized and published safely.`;
+        noticeEl.classList.add('visible');
+
+        nameInput.value = '';
+        htmlTextarea.value = '';
+      });
+
+      renderReviews();
+    })();
+  </script>
+
 </body>
 
