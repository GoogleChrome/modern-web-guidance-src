+  <script type="module">
+    const ALLOWED_ELEMENTS = ['p', 'b', 'i', 'strong', 'em', 'u', 'br', 'ul', 'ol', 'li', 'blockquote', 'code'];
+    const ALLOWED_ATTRIBUTES = ['class'];
+
+    let domPurifyPromise;
+
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.2.4/+esm').then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        el.setHTML(html, {
+          sanitizer: {
+            elements: ALLOWED_ELEMENTS,
+            attributes: ALLOWED_ATTRIBUTES
+          }
+        });
+      } else {
+        const DOMPurify = await loadDOMPurify();
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+          ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+    }
+
+    async function safePreviewHTML(previewEl, rawHTML) {
+      if (!rawHTML.trim()) {
+        previewEl.textContent = '';
+        const placeholder = document.createElement('em');
+        placeholder.textContent = 'Start typing above to preview your formatted feedback...';
+        previewEl.appendChild(placeholder);
+        return;
+      }
+
+      if ('parseHTML' in Document) {
+        const doc = Document.parseHTML(rawHTML, {
+          sanitizer: {
+            elements: ALLOWED_ELEMENTS,
+            attributes: ALLOWED_ATTRIBUTES
+          }
+        });
+        previewEl.replaceChildren(...doc.body.childNodes);
+      } else {
+        await safeSetHTML(previewEl, rawHTML);
+      }
+    }
+
+    const initialReviews = [
+      {
+        author: 'Maya Lin',
+        drink: 'Maple Oat Latte',
+        html: '<p>The <strong>Maple Oat Latte</strong> has the <em>perfect</em> balance of rich espresso and real Vermont maple sweetness!</p>'
+      },
+      {
+        author: 'Marcus Vance',
+        drink: 'Dark Roast Espresso',
+        html: '<p>Bold and velvety crema.<blockquote>My go-to morning fuel before work.</blockquote></p>'
+      },
+      {
+        author: 'Elena Rostova',
+        drink: 'Cold Brew',
+        html: '<p>Incredibly smooth <b>18-hour</b> steep with zero bitterness. Highly recommend!</p>'
+      }
+    ];
+
+    const reviewsList = document.getElementById('reviews-list');
+    const reviewForm = document.getElementById('review-form');
+    const reviewerNameInput = document.getElementById('reviewer-name');
+    const reviewContentInput = document.getElementById('review-content');
+    const reviewLivePreview = document.getElementById('review-live-preview');
+    const reviewStatus = document.getElementById('review-status');
+
+    async function renderReviewCard({ author, drink, html }, prepend = false) {
+      const article = document.createElement('article');
+      article.className = 'review-item';
+
+      const header = document.createElement('div');
+      header.className = 'review-header';
+
+      const authorSpan = document.createElement('span');
+      authorSpan.className = 'review-author';
+      authorSpan.textContent = author;
+
+      const drinkBadge = document.createElement('span');
+      drinkBadge.className = 'review-drink-badge';
+      drinkBadge.textContent = drink;
+
+      header.append(authorSpan, drinkBadge);
+
+      const body = document.createElement('div');
+      body.className = 'review-body';
+      await safeSetHTML(body, html);
+
+      article.append(header, body);
+
+      if (prepend && reviewsList.firstChild) {
+        reviewsList.prepend(article);
+      } else {
+        reviewsList.appendChild(article);
+      }
+    }
+
+    for (const review of initialReviews) {
+      renderReviewCard(review);
+    }
+
+    reviewContentInput.addEventListener('input', () => {
+      reviewContentInput.setCustomValidity('');
+      safePreviewHTML(reviewLivePreview, reviewContentInput.value);
+    });
+
+    reviewerNameInput.addEventListener('input', () => {
+      reviewerNameInput.setCustomValidity('');
+    });
+
+    reviewForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const formData = new FormData(reviewForm);
+      const author = String(formData.get('reviewer_name') || '').trim();
+      const drink = String(formData.get('drink') || 'Maple Oat Latte');
+      const html = String(formData.get('review_content') || '');
+
+      if (!author || !html.trim()) return;
+
+      await renderReviewCard({ author, drink, html }, true);
+      reviewForm.reset();
+      await safePreviewHTML(reviewLivePreview, '');
+      reviewStatus.textContent = `Thank you, ${author}! Your review for ${drink} has been posted.`;
+    });
+  </script>
 </body>
 
