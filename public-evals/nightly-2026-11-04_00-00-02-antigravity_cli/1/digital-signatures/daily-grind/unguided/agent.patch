+  // Build full Merkle tree of 2^MERKLE_HEIGHT WOTS+ leaves and return root + layers
+  async function buildSlhMerkleTree(skSeed, pubSeed) {
+    const numLeaves = 1 << MERKLE_HEIGHT;
+    const leaves = new Array(numLeaves);
+    for (let i = 0; i < numLeaves; i++) {
+      leaves[i] = await computeWotsLeafPublicKey(skSeed, pubSeed, i);
+    }
