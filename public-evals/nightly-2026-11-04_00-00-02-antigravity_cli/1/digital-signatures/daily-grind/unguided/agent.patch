+            verifierJsonInput.value = JSON.stringify(doc, null, 2);
+            await runVerificationFromInputs();
+          }
+        } catch (_err) {
+          // Ignore if JSON is currently invalid
+        }
+      });
+
+      restoreValidBtn.addEventListener('click', async () => {
+        if (!pristineSignedBackup) return;
+        verifierJsonInput.value = JSON.stringify(pristineSignedBackup, null, 2);
+        await runVerificationFromInputs();
+      });
+
+      // Initialize on page load with default signed gift voucher & order receipt
+      async function bootstrapStudio() {
+        renderReceiptLineItems();
+        await initOrRotateKeyPair(suiteSelect.value);
+
+        // Pre-populate a signed Gift Voucher and a signed Order Receipt so the ledger and verifier work immediately
+        const initialVoucher = buildVoucherPayload();
+        await signAndDisplayPayload(initialVoucher);
+
+        const initialReceipt = buildReceiptPayload();
+        await signAndDisplayPayload(initialReceipt);
+      }
+
+      bootstrapStudio();
+    })();
+  </script>
