+  // Advance a WOTS+ chain from startStep for `steps` iterations
+  async function wotsChain(pubSeed, leafIdx, chainIdx, startNode, startStep, steps) {
+    let node = startNode;
+    for (let s = startStep; s < startStep + steps; s++) {
+      node = await thash(pubSeed, 0x01, leafIdx, chainIdx, s, node);
+    }
+    return node;
+  }
+
+  // Derive secret key seed for a specific leaf & chain from skSeed and skPrf
+  async function deriveWotsChainSecret(skSeed, pubSeed, leafIdx, chainIdx) {
+    return thash(pubSeed, 0x00, leafIdx, chainIdx, 0, skSeed);
+  }
+
+  // Compute WOTS+ public key (32-byte L-tree compressed leaf) for leafIdx
+  async function computeWotsLeafPublicKey(skSeed, pubSeed, leafIdx) {
+    const pkElements = new Array(WOTS_LEN);
+    for (let c = 0; c < WOTS_LEN; c++) {
+      const skC = await deriveWotsChainSecret(skSeed, pubSeed, leafIdx, c);
+      pkElements[c] = await wotsChain(pubSeed, leafIdx, c, skC, 0, WOTS_W - 1);
+    }
+    return thash(pubSeed, 0x02, leafIdx, 0, 0, concatBytes(...pkElements));
+  }
