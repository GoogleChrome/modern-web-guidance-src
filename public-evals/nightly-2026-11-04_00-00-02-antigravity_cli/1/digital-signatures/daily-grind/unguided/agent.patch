+  // Tweakable hash function F(pubSeed, adrs, msg) = SHA-256(pubSeed || adrs || msg)
+  async function thash(pubSeed, layerByte, leafIdx, chainIdx, stepIdx, inputBytes) {
+    const adrs = new Uint8Array([
+      layerByte & 0xff,
+      (leafIdx >>> 8) & 0xff,
+      leafIdx & 0xff,
+      chainIdx & 0xff,
+      stepIdx & 0xff
+    ]);
+    return sha256Bytes(concatBytes(pubSeed, adrs, inputBytes));
+  }
+
+  // Convert 32-byte digest into 67 base-16 digits (64 message nibbles + 3 checksum nibbles)
+  function wotsMessageToDigits(msgHash32) {
+    const digits = new Uint8Array(WOTS_LEN);
+    let csum = 0;
+    for (let i = 0; i < 32; i++) {
+      const hi = (msgHash32[i] >>> 4) & 0x0f;
+      const lo = msgHash32[i] & 0x0f;
+      digits[2 * i] = hi;
+      digits[2 * i + 1] = lo;
+      csum += (WOTS_W - 1 - hi) + (WOTS_W - 1 - lo);
+    }
+    // Encode checksum in 3 base-16 digits
+    digits[64] = (csum >>> 8) & 0x0f;
+    digits[65] = (csum >>> 4) & 0x0f;
+    digits[66] = csum & 0x0f;
+    return digits;
+  }
