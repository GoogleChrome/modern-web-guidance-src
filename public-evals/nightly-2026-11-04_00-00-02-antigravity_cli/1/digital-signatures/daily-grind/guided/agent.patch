+  receipt: 'daily-grind-order-receipt-v1',
+  voucher: 'daily-grind-gift-voucher-v1',
+};
+
+export function supportsPostQuantumSignatures(algorithm = 'ML-DSA-65') {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('sign', algorithm)
+  );
+}
+
+export async function generateSigningKeyPair(preferredAlgorithm = 'ML-DSA-65') {
+  if (
+    preferredAlgorithm.startsWith('ML-DSA') &&
+    supportsPostQuantumSignatures(preferredAlgorithm)
+  ) {
+    const keyPair = await crypto.subtle.generateKey(
+      preferredAlgorithm,
+      false,
+      ['sign', 'verify'],
+    );
+    const publicKey =
+      typeof crypto.subtle.getPublicKey === 'function'
+        ? await crypto.subtle.getPublicKey(keyPair.privateKey, ['verify'])
+        : keyPair.publicKey;
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', publicKey),
+    );
+    return {
+      suite: preferredAlgorithm,
+      keyFormat: 'raw-public',
+      isPostQuantum: true,
+      keyPair,
+      publicKey,
+      publicKeyBytes,
+    };
+  }
+
+  // Classical fallback: Ed25519
+  const keyPair = await crypto.subtle.generateKey(
+    'Ed25519',
+    false,
+    ['sign', 'verify'],
+  );
+  const publicKey =
+    typeof crypto.subtle.getPublicKey === 'function'
+      ? await crypto.subtle.getPublicKey(keyPair.privateKey, ['verify'])
+      : keyPair.publicKey;
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw', publicKey),
+  );
+  return {
+    suite: 'Ed25519',
+    keyFormat: 'raw',
+    isPostQuantum: false,
+    keyPair,
+    publicKey,
+    publicKeyBytes,
+  };
+}
+
+export function frameFallbackInput(payloadBytes, contextBytes) {
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException(
+      'Context must not exceed 255 bytes',
+      'OperationError',
+    );
+  }
+  const framed = new Uint8Array(
+    1 + contextBytes.byteLength + payloadBytes.byteLength,
+  );
+  framed[0] = contextBytes.byteLength;
+  framed.set(contextBytes, 1);
+  framed.set(payloadBytes, 1 + contextBytes.byteLength);
+  return framed;
+}
+
+function toBytes(input) {
+  if (typeof input === 'string') {
+    return new TextEncoder().encode(input);
+  }
+  if (input instanceof Uint8Array) {
+    return input;
+  }
+  if (input instanceof ArrayBuffer || ArrayBuffer.isView(input)) {
+    return new Uint8Array(input);
+  }
+  return new Uint8Array(0);
+}
+
+export async function signPayload(
+  privateKey,
+  payloadInput,
+  contextInput = new Uint8Array(0),
+) {
+  const payloadBytes = toBytes(payloadInput);
+  const contextBytes = toBytes(contextInput);
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException(
+      'Context must not exceed 255 bytes',
+      'OperationError',
+    );
+  }
+
+  if (privateKey.algorithm.name.startsWith('ML-DSA')) {
+    const sig = await crypto.subtle.sign(
+      { name: privateKey.algorithm.name, context: contextBytes },
+      privateKey,
+      payloadBytes,
+    );
+    return new Uint8Array(sig);
+  }
+
+  const framed = frameFallbackInput(payloadBytes, contextBytes);
+  const sig = await crypto.subtle.sign('Ed25519', privateKey, framed);
+  return new Uint8Array(sig);
+}
+
+export async function importVerifierPublicKey(publicKeyOrBytes) {
+  if (publicKeyOrBytes instanceof CryptoKey) {
+    return publicKeyOrBytes;
+  }
+  const bytes = toBytes(publicKeyOrBytes);
+  const mlDsaName = ML_DSA_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+  if (mlDsaName) {
+    return crypto.subtle.importKey(
+      'raw-public',
+      bytes,
+      mlDsaName,
+      true,
+      ['verify'],
+    );
+  }
+  return crypto.subtle.importKey('raw', bytes, 'Ed25519', true, ['verify']);
+}
+
+export async function verifyPayload(
+  publicKeyOrBytes,
+  signatureInput,
+  payloadInput,
+  contextInput = new Uint8Array(0),
+) {
+  const payloadBytes = toBytes(payloadInput);
+  const contextBytes = toBytes(contextInput);
+  const signatureBytes = toBytes(signatureInput);
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException(
+      'Context must not exceed 255 bytes',
+      'OperationError',
+    );
+  }
+
+  const publicKey = await importVerifierPublicKey(publicKeyOrBytes);
+
+  if (publicKey.algorithm.name.startsWith('ML-DSA')) {
+    return crypto.subtle.verify(
+      { name: publicKey.algorithm.name, context: contextBytes },
+      publicKey,
+      signatureBytes,
+      payloadBytes,
+    );
+  }
+
+  const framed = frameFallbackInput(payloadBytes, contextBytes);
+  return crypto.subtle.verify('Ed25519', publicKey, signatureBytes, framed);
+}
+
+export function bytesToHex(bytes) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  if (typeof u8.toHex === 'function') {
+    return u8.toHex();
+  }
+  let hex = '';
+  for (let i = 0; i < u8.length; i += 1) {
+    hex += u8[i].toString(16).padStart(2, '0');
+  }
+  return hex;
+}
+
+export function hexToBytes(hexString) {
+  const clean = String(hexString).trim().replace(/\s+/g, '');
+  if (clean.length % 2 !== 0 || !/^[0-9a-fA-F]*$/.test(clean)) {
+    throw new SyntaxError('Invalid hexadecimal string');
+  }
+  if (typeof Uint8Array.fromHex === 'function') {
+    return Uint8Array.fromHex(clean);
+  }
+  const out = new Uint8Array(clean.length / 2);
+  for (let i = 0; i < clean.length; i += 2) {
+    out[i / 2] = parseInt(clean.slice(i, i + 2), 16);
+  }
+  return out;
+}
