+    .payment-section h2 {
+      color: var(--primary);
+      margin-block-end: 1.5rem;
+      text-align: center;
+    }
+
+    .payment-fieldset {
+      border: 0;
+      padding: 0;
+      margin: 0;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      clip-path: inset(50%);
+      overflow: hidden;
+      width: 1px;
+      height: 1px;
+      margin: -1px;
+      padding: 0;
+      border: 0;
+      white-space: nowrap;
+    }
+
+    .form-group {
+      display: flex;
+      flex-direction: column;
+      margin-block-end: 1.5rem;
+    }
+
+    .form-group label {
+      font-weight: 600;
+      color: var(--text);
+      margin-block-end: 0.25rem;
+    }
+
+    .hint {
+      font-size: 0.875rem;
+      color: #5d4037;
+      margin-block-end: 0.375rem;
+    }
+
+    .form-group input {
+      width: 100%;
+      font-size: 1rem;
+      line-height: 1.5;
+      padding: 0.75rem;
+      min-height: 48px;
+      border: 1px solid #8d6e63;
+      border-radius: 5px;
+      color: var(--text);
+      background-color: #fff;
+    }
+
+    @media (pointer: coarse) {
+      .form-group input {
+        min-height: 52px;
+      }
+    }
+
+    .form-group input:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 2px;
+      border-color: var(--primary);
+    }
+
+    .form-group input:invalid:user-invalid {
+      border-color: #c62828;
+      background-color: #ffebee;
+    }
+
+    .payment-submit {
+      width: 100%;
+      border: none;
+      font-size: 1rem;
+      font-weight: 600;
+      min-height: 48px;
+      cursor: pointer;
+    }
+
+    .payment-submit:disabled {
+      opacity: 0.6;
+      cursor: not-allowed;
+    }
