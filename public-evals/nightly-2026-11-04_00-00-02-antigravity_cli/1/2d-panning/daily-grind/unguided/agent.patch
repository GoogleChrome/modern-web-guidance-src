+  <script>
+    (function () {
+      const viewport = document.getElementById('cafe-map-viewport');
+      if (!viewport) return;
+
+      // Start centered so users can immediately pan in any horizontal, vertical, or diagonal direction
+      viewport.scrollLeft = 450;
+      viewport.scrollTop = 380;
+
+      let isPanning = false;
+      let startX = 0;
+      let startY = 0;
+      let startScrollLeft = 0;
+      let startScrollTop = 0;
+
+      viewport.addEventListener('pointerdown', function (e) {
+        if (e.pointerType === 'mouse' && e.button !== 0) return;
+        isPanning = true;
+        startX = e.clientX;
+        startY = e.clientY;
+        startScrollLeft = viewport.scrollLeft;
+        startScrollTop = viewport.scrollTop;
+        viewport.classList.add('is-panning');
+        if (viewport.setPointerCapture) {
+          try {
+            viewport.setPointerCapture(e.pointerId);
+          } catch (_) {}
+        }
+      });
+
+      viewport.addEventListener('pointermove', function (e) {
+        if (!isPanning) return;
+        const dx = e.clientX - startX;
+        const dy = e.clientY - startY;
+        // Update both axes simultaneously without locking to a single axis
+        viewport.scrollLeft = startScrollLeft - dx;
+        viewport.scrollTop = startScrollTop - dy;
+      });
+
+      function stopPanning(e) {
+        if (!isPanning) return;
+        isPanning = false;
+        viewport.classList.remove('is-panning');
+        if (e && e.pointerId !== undefined && viewport.releasePointerCapture) {
+          try {
+            viewport.releasePointerCapture(e.pointerId);
+          } catch (_) {}
+        }
+      }
+
+      viewport.addEventListener('pointerup', stopPanning);
+      viewport.addEventListener('pointercancel', stopPanning);
+    })();
+  </script>
