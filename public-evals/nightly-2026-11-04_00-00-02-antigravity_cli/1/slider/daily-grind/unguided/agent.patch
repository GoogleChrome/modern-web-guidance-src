+  <script>
+    (function () {
+      const slider = document.getElementById('brew-strength');
+      const output = document.getElementById('brew-strength-output');
+      const notes = document.getElementById('brew-strength-notes');
+
+      if (!slider) return;
+
+      function getBrewProfile(percent) {
+        if (percent <= 20) {
+          return {
+            label: 'Mild Blonde',
+            description: 'Delicate floral aroma with bright citrus acidity and a silky, tea-like body.'
+          };
+        }
+        if (percent <= 40) {
+          return {
+            label: 'Smooth Light-Medium',
+            description: 'Mellow honey sweetness with hints of toasted almond and stone fruit.'
+          };
+        }
+        if (percent <= 65) {
+          return {
+            label: 'Medium Balance',
+            description: 'Balanced body with toasted caramel sweetness, smooth cocoa undertones, and a clean finish.'
+          };
+        }
+        if (percent <= 85) {
+          return {
+            label: 'Bold Dark Roast',
+            description: 'Rich, full-bodied extraction with dark chocolate depth and warm roasted spice notes.'
+          };
+        }
+        return {
+          label: 'Extra Strong Espresso',
+          description: 'Intense velvety crema, smoky molasses richness, and maximum caffeine kick.'
+        };
+      }
+
+      function updateSliderState() {
+        const min = Number(slider.min) || 0;
+        const max = Number(slider.max) || 100;
+        const val = Number(slider.value);
+        const percent = max > min ? ((val - min) / (max - min)) * 100 : 0;
+        const roundedPercent = Math.round(percent);
+
+        slider.style.setProperty('--fill-percent', `${percent}%`);
+        slider.setAttribute('aria-valuenow', String(val));
+
+        const profile = getBrewProfile(roundedPercent);
+        const valueText = `${roundedPercent}% — ${profile.label}`;
+        slider.setAttribute('aria-valuetext', valueText);
+
+        if (output) {
+          output.textContent = valueText;
+          output.value = valueText;
+        }
+        if (notes) {
+          notes.innerHTML = `<strong>Tasting Profile:</strong> ${profile.description}`;
+        }
+      }
+
+      slider.addEventListener('input', updateSliderState);
+      slider.addEventListener('change', updateSliderState);
+      updateSliderState();
+    })();
+  </script>
