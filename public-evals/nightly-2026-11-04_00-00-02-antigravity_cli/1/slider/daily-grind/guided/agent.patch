+  <script>
+    const brewSlider = document.querySelector('#brew-strength-slider');
+    const brewOutput = document.querySelector('#brew-strength-output');
+
+    const strengthProfiles = {
+      1: { name: 'Light', notes: 'Delicate & Floral' },
+      2: { name: 'Mild', notes: 'Soft & Mellow' },
+      3: { name: 'Medium', notes: 'Balanced & Smooth' },
+      4: { name: 'Bold', notes: 'Rich & Full-Bodied' },
+      5: { name: 'Extra Strong', notes: 'Intense & Robust' },
+    };
+
+    function syncSliderValue() {
+      brewSlider.style.setProperty('--attr-min', brewSlider.min || 0);
+      brewSlider.style.setProperty('--attr-max', brewSlider.max || 100);
+      brewSlider.style.setProperty('--control-value', brewSlider.value);
+
+      const level = Number(brewSlider.value);
+      const profile = strengthProfiles[level] || strengthProfiles[3];
+      brewOutput.textContent = `${profile.name} (${level} / 5 — ${profile.notes})`;
+      brewSlider.setAttribute(
+        'aria-valuetext',
+        `${profile.name} (${level} out of 5 — ${profile.notes})`
+      );
+    }
+
+    syncSliderValue();
+    brewSlider.addEventListener('input', syncSliderValue);
+  </script>
