--- /dev/null
+++ b/src/components/ContextualCallout.tsx
@@ -0,0 +1,142 @@
+import React from 'react';
+import {
+  deriveSemanticContext,
+  extractSemanticHighlights,
+  type EditorialDomainId,
+  type ReadingDepthMode,
+  type SemanticTone,
+} from '../utils/semantic-context';
+
+export interface ContextualCalloutProps {
+  title: string;
+  summary: string;
+  category: string;
+  readingTime?: number;
+  tags?: string[];
+  author?: string;
+  domainOverride?: EditorialDomainId;
+  depthOverride?: ReadingDepthMode;
+  toneOverride?: SemanticTone;
+}
+
+export default function ContextualCallout({
+  title,
+  summary,
+  category,
+  readingTime,
+  tags = [],
+  author,
+  domainOverride,
+  depthOverride,
+  toneOverride,
+}: ContextualCalloutProps) {
+  const context = deriveSemanticContext(
+    { title, summary, category, readingTime, tags, author },
+    'dossier-banner',
+    {
+      domainId: domainOverride,
+      depthMode: depthOverride,
+      toneId: toneOverride,
+    }
+  );
+
+  const highlights = extractSemanticHighlights(title, summary, context);
+
+  // Visual variants based on semantic tone & domain
+  const isUrgent = context.tone.id === 'urgent-crisis';
+  const isAnalytical = context.tone.id === 'analytical-report';
+  const isInvestigation = context.depth.mode === 'deep-investigation';
+
+  return (
+    <aside
+      className={`my-6 rounded-lg overflow-hidden border ${context.domain.surfaceBorder} ${context.domain.surfaceBg} ${context.domain.cardTreatment} transition-all`}
+      data-semantic-callout
+      data-semantic-domain={context.domain.id}
+      data-semantic-depth={context.depth.mode}
+      data-semantic-tone={context.tone.id}
+    >
+      {/* Top Semantic Header Bar */}
+      <div className="px-4 py-2.5 border-b border-gray-200/80 flex flex-wrap items-center justify-between gap-2 bg-white/70">
+        <div className="flex items-center gap-2">
+          <span
+            className={`w-2.5 h-2.5 rounded-full ${
+              isUrgent
+                ? 'bg-red-600 animate-pulse'
+                : isAnalytical
+                ? 'bg-teal-600'
+                : context.domain.barAccent
+            }`}
+          />
+          <span className={`text-xs font-bold uppercase tracking-wider ${context.domain.accentText}`}>
+            {highlights.label}
+          </span>
+          <span className="text-gray-300">|</span>
+          <span className="text-xs text-gray-600 font-medium">{context.domain.label}</span>
+        </div>
+
+        <div className="flex items-center gap-2 text-[11px] font-mono text-gray-500">
+          <span className="px-2 py-0.5 rounded bg-gray-100 border border-gray-200 text-gray-700">
+            {context.depth.label} ({context.depth.readingTime} min)
+          </span>
+          <span className={`px-2 py-0.5 rounded border ${context.tone.badgeStyle} font-sans font-semibold`}>
+            {context.tone.label}
+          </span>
+        </div>
+      </div>
+
+      {/* Main Adaptive Content Area */}
+      <div className="p-4 sm:p-5 grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
+        <div className={highlights.metric ? 'md:col-span-8' : 'md:col-span-12'}>
+          <p className="text-xs uppercase tracking-widest text-gray-500 font-semibold mb-2">
+            {isUrgent
+              ? 'Priority Situational Synthesis'
+              : isInvestigation
+              ? 'Investigative Dossier Overview'
+              : 'Contextual Intelligence Brief'}
+          </p>
+          <ul className="space-y-2">
+            {highlights.points.map((point, idx) => (
+              <li key={idx} className="flex items-start gap-2.5 text-sm text-gray-800 leading-relaxed">
+                <span
+                  className={`mt-1.5 w-1.5 h-1.5 rounded-full flex-shrink-0 ${context.domain.barAccent}`}
+                />
+                <span>{point}</span>
+              </li>
+            ))}
+          </ul>
+
+          {tags.length > 0 && (
+            <div className="mt-3 pt-3 border-t border-gray-200/60 flex flex-wrap items-center gap-1.5">
+              <span className="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mr-1">
+                Semantic Signals:
+              </span>
+              {tags.map((tag) => (
+                <span
+                  key={tag}
+                  className="text-[11px] px-2 py-0.5 rounded-full bg-white border border-gray-200 text-gray-600"
+                >
+                  #{tag}
+                </span>
+              ))}
+            </div>
+          )}
+        </div>
+
+        {highlights.metric && (
+          <div className="md:col-span-4 bg-white rounded-md p-3.5 border border-gray-200/90 shadow-2xs flex flex-col justify-between">
+            <span className="text-[10px] font-bold uppercase tracking-wider text-gray-400">
+              {highlights.metric.name}
+            </span>
+            <div className={`text-xl font-brand font-bold my-1 ${context.domain.accentText}`}>
+              {highlights.metric.value}
+            </div>
+            <div className="flex items-center justify-between text-xs text-gray-500 pt-1.5 border-t border-gray-100">
+              <span>{highlights.metric.delta}</span>
+              <span className="font-mono text-[10px] text-gray-400">~{context.depth.estimatedWords}w</span>
+            </div>
+          </div>
+        )}
+      </div>
+    </aside>
+  );
+}
