--- /dev/null
+++ b/src/components/SemanticContextLens.tsx
@@ -0,0 +1,357 @@
+import React, { useState } from 'react';
+import {
+  DOMAIN_TOKENS,
+  deriveSemanticContext,
+  extractSemanticHighlights,
+  type EditorialDomainId,
+  type ReadingDepthMode,
+  type SemanticTone,
+  type PlacementRole,
+} from '../utils/semantic-context';
+import SemanticBadge from './SemanticBadge';
+import ContextualCallout from './ContextualCallout';
+
+export interface LensArticleSample {
+  id: string;
+  title: string;
+  summary: string;
+  category: string;
+  author: string;
+  readingTime: number;
+  tags?: string[];
+  image: string;
+}
+
+interface SemanticContextLensProps {
+  samples: LensArticleSample[];
+  baseUrl?: string;
+}
+
+export default function SemanticContextLens({ samples, baseUrl = '/' }: SemanticContextLensProps) {
+  const [isExpanded, setIsExpanded] = useState(false);
+  const [selectedSampleIdx, setSelectedSampleIdx] = useState(0);
+  const [domainOverride, setDomainOverride] = useState<EditorialDomainId | 'auto'>('auto');
+  const [depthOverride, setDepthOverride] = useState<ReadingDepthMode | 'auto'>('auto');
+  const [toneOverride, setToneOverride] = useState<SemanticTone | 'auto'>('auto');
+  const [placementOverride, setPlacementOverride] = useState<PlacementRole>('grid-card');
+
+  const activeSample = samples[selectedSampleIdx] || samples[0];
+  if (!activeSample) return null;
+
+  const context = deriveSemanticContext(
+    activeSample,
+    placementOverride,
+    {
+      domainId: domainOverride === 'auto' ? undefined : domainOverride,
+      depthMode: depthOverride === 'auto' ? undefined : depthOverride,
+      toneId: toneOverride === 'auto' ? undefined : toneOverride,
+      placement: placementOverride,
+    }
+  );
+
+  const highlights = extractSemanticHighlights(activeSample.title, activeSample.summary, context);
+
+  return (
+    <section
+      className="my-6 border border-gray-300 rounded-lg bg-slate-50/70 overflow-hidden shadow-xs"
+      data-semantic-context-lens
+    >
+      {/* Compact Header Bar */}
+      <div className="px-4 py-3 bg-white border-b border-gray-200 flex flex-wrap items-center justify-between gap-3">
+        <div className="flex items-center gap-2.5">
+          <span className="inline-flex items-center justify-center w-6 h-6 rounded bg-gray-900 text-amber-400 font-mono text-xs font-bold">
+            Σ
+          </span>
+          <div>
+            <div className="flex items-center gap-2">
+              <h2 className="text-sm font-bold text-gray-900 tracking-tight">
+                Semantic Context Visual Engine
+              </h2>
+              <span className="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-amber-100 text-amber-900 border border-amber-300 font-semibold">
+                Adaptive UI Active
+              </span>
+            </div>
+            <p className="text-xs text-gray-500">
+              Components dynamically adapt typography, surface tokens, density, and callout framing from article semantics.
+            </p>
+          </div>
+        </div>
+
+        <div className="flex items-center gap-3">
+          {/* Domain Legend Pills */}
+          <div className="hidden lg:flex items-center gap-1.5">
+            {Object.values(DOMAIN_TOKENS).map((dom) => (
+              <span
+                key={dom.id}
+                className={`text-[10px] px-2 py-0.5 rounded border ${dom.badgeBg} ${dom.badgeText} ${dom.badgeBorder} font-medium`}
+                title={dom.tagline}
+              >
+                {dom.label.split(' ')[0]}
+              </span>
+            ))}
+          </div>
+
+          <button
+            type="button"
+            onClick={() => setIsExpanded(!isExpanded)}
+            className="text-xs font-semibold px-3 py-1.5 rounded bg-gray-900 text-white hover:bg-gray-800 transition-colors cursor-pointer"
+          >
+            {isExpanded ? 'Hide Context Simulator' : 'Inspect & Simulate Contexts'}
+          </button>
+        </div>
+      </div>
+
+      {/* Expandable Interactive Simulator */}
+      {isExpanded && (
+        <div className="p-4 sm:p-6 bg-slate-50 border-t border-gray-200 space-y-6">
+          {/* Controls Grid */}
+          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 bg-white p-4 rounded-lg border border-gray-200 shadow-2xs">
+            {/* Sample Article Selector */}
+            <div>
+              <label className="block text-[10px] font-bold uppercase tracking-wider text-gray-500 mb-1">
+                1. Source Content Item
+              </label>
+              <select
+                value={selectedSampleIdx}
+                onChange={(e) => {
+                  setSelectedSampleIdx(Number(e.target.value));
+                  setDomainOverride('auto');
+                  setDepthOverride('auto');
+                  setToneOverride('auto');
+                }}
+                className="w-full text-xs border border-gray-300 rounded px-2.5 py-1.5 bg-white text-gray-900 font-medium"
+              >
+                {samples.map((s, i) => (
+                  <option key={s.id} value={i}>
+                    [{s.category}] {s.title.slice(0, 32)}...
+                  </option>
+                ))}
+              </select>
+            </div>
+
+            {/* Domain Context Override */}
+            <div>
+              <label className="block text-[10px] font-bold uppercase tracking-wider text-gray-500 mb-1">
+                2. Editorial Domain
+              </label>
+              <select
+                value={domainOverride}
+                onChange={(e) => setDomainOverride(e.target.value as EditorialDomainId | 'auto')}
+                className="w-full text-xs border border-gray-300 rounded px-2.5 py-1.5 bg-white text-gray-900"
+              >
+                <option value="auto">Auto-Detect ({context.domain.id})</option>
+                <option value="civic-policy">Civic & Policy Dispatch</option>
+                <option value="economy-markets">Markets & Industrial Ledger</option>
+                <option value="science-inquiry">Scientific & Forensic Inquiry</option>
+                <option value="arts-culture">Arts, Stage & Media Critique</option>
+                <option value="lifestyle-vitality">Vitality, Athletics & Urban Life</option>
+              </select>
+            </div>
+
+            {/* Reading Depth Override */}
+            <div>
+              <label className="block text-[10px] font-bold uppercase tracking-wider text-gray-500 mb-1">
+                3. Reading Depth Mode
+              </label>
+              <select
+                value={depthOverride}
+                onChange={(e) => setDepthOverride(e.target.value as ReadingDepthMode | 'auto')}
+                className="w-full text-xs border border-gray-300 rounded px-2.5 py-1.5 bg-white text-gray-900"
+              >
+                <option value="auto">Auto-Detect ({context.depth.mode})</option>
+                <option value="flash-brief">Flash Brief (≤3m · Bulleted)</option>
+                <option value="standard-feature">Standard Feature (4-5m)</option>
+                <option value="deep-investigation">Deep Investigation (6m+ · Dossier)</option>
+              </select>
+            </div>
+
+            {/* Tone / Urgency Override */}
+            <div>
+              <label className="block text-[10px] font-bold uppercase tracking-wider text-gray-500 mb-1">
+                4. Semantic Tone & Urgency
+              </label>
+              <select
+                value={toneOverride}
+                onChange={(e) => setToneOverride(e.target.value as SemanticTone | 'auto')}
+                className="w-full text-xs border border-gray-300 rounded px-2.5 py-1.5 bg-white text-gray-900"
+              >
+                <option value="auto">Auto-Detect ({context.tone.id})</option>
+                <option value="urgent-crisis">Critical Alert / Urgent Crisis</option>
+                <option value="analytical-report">Analytical / Empirical Lens</option>
+                <option value="vibrant-feature">Cultural & Human Feature</option>
+              </select>
+            </div>
+
+            {/* Placement Role */}
+            <div>
+              <label className="block text-[10px] font-bold uppercase tracking-wider text-gray-500 mb-1">
+                5. Placement Hierarchy
+              </label>
+              <select
+                value={placementOverride}
+                onChange={(e) => setPlacementOverride(e.target.value as PlacementRole)}
+                className="w-full text-xs border border-gray-300 rounded px-2.5 py-1.5 bg-white text-gray-900"
+              >
+                <option value="grid-card">Grid Teaser Card</option>
+                <option value="lead-hero">Lead Hero Feature</option>
+                <option value="compact-rail">Compact Rail Item</option>
+              </select>
+            </div>
+          </div>
+
+          {/* Live Preview & Computed Tokens */}
+          <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
+            {/* Left: Adaptive Component Preview */}
+            <div className="lg:col-span-7">
+              <div className="text-[11px] font-mono uppercase tracking-wider text-gray-500 mb-2 flex items-center justify-between">
+                <span>Live Adaptive Component Output</span>
+                <span>Role: {context.placement}</span>
+              </div>
+
+              <div
+                className={`rounded-lg p-5 transition-all ${context.domain.cardTreatment} ${context.tone.borderStyle}`}
+                data-semantic-preview-card
+              >
+                <div className="flex flex-wrap items-center justify-between gap-2 mb-3">
+                  <SemanticBadge
+                    category={activeSample.category}
+                    tags={activeSample.tags}
+                    readingTime={activeSample.readingTime}
+                    title={activeSample.title}
+                    summary={activeSample.summary}
+                    domainOverride={domainOverride === 'auto' ? undefined : domainOverride}
+                    depthOverride={depthOverride === 'auto' ? undefined : depthOverride}
+                    toneOverride={toneOverride === 'auto' ? undefined : toneOverride}
+                    showTone={true}
+                    showDepth={true}
+                  />
+                  <span className="text-xs text-gray-500 font-medium">By {activeSample.author}</span>
+                </div>
+
+                <h3
+                  className={`${
+                    placementOverride === 'lead-hero'
+                      ? 'text-2xl sm:text-3xl'
+                      : placementOverride === 'compact-rail'
+                      ? 'text-base'
+                      : 'text-xl'
+                  } ${context.domain.headingClass} mb-2`}
+                >
+                  <a href={`${baseUrl}articles/${activeSample.id}`} className="hover:underline">
+                    {activeSample.title}
+                  </a>
+                </h3>
+
+                {placementOverride !== 'compact-rail' && (
+                  <p className={`text-gray-700 ${context.depth.densityClass} mb-3`}>
+                    {activeSample.summary}
+                  </p>
+                )}
+
+                {/* Depth-Specific Visual Adaptation */}
+                {context.depth.mode === 'flash-brief' && (
+                  <div className="mt-3 p-3 rounded bg-gray-50 border border-gray-200 text-xs space-y-1">
+                    <div className={`font-bold uppercase tracking-wider ${context.domain.accentText}`}>
+                      Rapid Scan Takeaways
+                    </div>
+                    {highlights.points.slice(0, 2).map((pt, i) => (
+                      <div key={i} className="flex items-start gap-1.5 text-gray-700">
+                        <span className="font-bold">·</span>
+                        <span>{pt}</span>
+                      </div>
+                    ))}
+                  </div>
+                )}
+
+                {context.depth.mode === 'deep-investigation' && highlights.metric && (
+                  <div className="mt-3 p-3 rounded bg-slate-900 text-white text-xs flex items-center justify-between">
+                    <div>
+                      <span className="text-[10px] uppercase tracking-widest text-slate-400 block">
+                        Investigative Dossier Metric
+                      </span>
+                      <span className="font-semibold text-amber-300">{highlights.metric.name}: </span>
+                      <span>{highlights.metric.value}</span>
+                    </div>
+                    <span className="font-mono text-[11px] px-2 py-0.5 rounded bg-slate-800 text-slate-300">
+                      ~{context.depth.estimatedWords} words
+                    </span>
+                  </div>
+                )}
+              </div>
+
+              {/* Contextual Callout Preview */}
+              <ContextualCallout
+                title={activeSample.title}
+                summary={activeSample.summary}
+                category={activeSample.category}
+                readingTime={activeSample.readingTime}
+                tags={activeSample.tags}
+                author={activeSample.author}
+                domainOverride={domainOverride === 'auto' ? undefined : domainOverride}
+                depthOverride={depthOverride === 'auto' ? undefined : depthOverride}
+                toneOverride={toneOverride === 'auto' ? undefined : toneOverride}
+              />
+            </div>
+
+            {/* Right: Computed Semantic Matrix */}
+            <div className="lg:col-span-5 bg-gray-900 text-gray-100 rounded-lg p-4 font-mono text-xs space-y-3">
+              <div className="flex items-center justify-between border-b border-gray-700 pb-2">
+                <span className="text-amber-400 font-bold uppercase tracking-wider">
+                  Resolved Semantic Context
+                </span>
+                <span className="text-[10px] text-gray-400">src/utils/semantic-context.ts</span>
+              </div>
+
+              <div className="space-y-2">
+                <div>
+                  <span className="text-gray-400 block text-[10px]">EDITORIAL DOMAIN:</span>
+                  <span className="text-white font-semibold">{context.domain.label}</span>
+                  <span className="text-gray-400 ml-2">({context.domain.id})</span>
+                </div>
+
+                <div>
+                  <span className="text-gray-400 block text-[10px]">TYPOGRAPHY & SURFACE TOKENS:</span>
+                  <code className="text-emerald-300 text-[11px] block">
+                    heading: &quot;{context.domain.headingClass}&quot;
+                  </code>
+                  <code className="text-emerald-300 text-[11px] block">
+                    card: &quot;{context.domain.cardTreatment}&quot;
+                  </code>
+                </div>
+
+                <div>
+                  <span className="text-gray-400 block text-[10px]">READING DEPTH & DENSITY LOGIC:</span>
+                  <span className="text-sky-300">
+                    {context.depth.label} ({context.depth.readingTime} min / ~{context.depth.estimatedWords}w)
+                  </span>
+                  <span className="block text-[11px] text-gray-300">{context.depth.description}</span>
+                </div>
+
+                <div>
+                  <span className="text-gray-400 block text-[10px]">SEMANTIC TONE & URGENCY:</span>
+                  <span className="text-amber-300">
+                    {context.tone.label} [urgency={context.tone.urgencyLevel}]
+                  </span>
+                </div>
+
+                <div>
+                  <span className="text-gray-400 block text-[10px]">EXTRACTED SIGNALS:</span>
+                  <div className="flex flex-wrap gap-1 mt-1">
+                    {context.signals.map((sig) => (
+                      <span
+                        key={sig}
+                        className="px-1.5 py-0.5 rounded bg-gray-800 text-gray-200 border border-gray-700 text-[10px]"
+                      >
+                        {sig}
+                      </span>
+                    ))}
+                  </div>
+                </div>
+              </div>
+            </div>
+          </div>
+        </div>
+      )}
+    </section>
+  );
+}
