+export type EditorialDomainId =
+  | 'civic-policy'      // Politics, National, News, Labor
+  | 'economy-markets'   // Economy, Business
+  | 'science-inquiry'   // Science, Web Development, Tech
+  | 'arts-culture'      // Culture, Media, Arts
+  | 'lifestyle-vitality'; // Lifestyle, Sports, Urban Development, Pets
+
+export type ReadingDepthMode =
+  | 'flash-brief'       // <= 3 min read: concise, scannable, bulleted highlights
+  | 'standard-feature'  // 4-5 min read: balanced narrative & visual weight
+  | 'deep-investigation'; // >= 6 min read: dossier style, chapter/analytical framing, high-density metadata
+
+export type SemanticTone =
+  | 'urgent-crisis'     // Crisis, strikes, decay, crime networks, existential threat
+  | 'analytical-report' // Research, forensics, economics, data-driven, profiling
+  | 'vibrant-feature';  // Championships, festivals, ballet, coffee, coastal, pets
+
+export type PlacementRole =
+  | 'lead-hero'         // Primary page focal point
+  | 'section-anchor'    // Top story of a section grid
+  | 'grid-card'         // Standard 3-column teaser
+  | 'compact-rail'      // Top bar, sidebar, or dense list item
+  | 'dossier-banner';   // Full-width report/multimedia or investigation card
+
+export interface DomainVisualTokens {
+  id: EditorialDomainId;
+  label: string;
+  tagline: string;
+  accentHex: string;
+  surfaceBg: string;
+  surfaceBorder: string;
+  badgeBg: string;
+  badgeText: string;
+  badgeBorder: string;
+  headingClass: string;
+  cardTreatment: string;
+  accentText: string;
+  accentHoverText: string;
+  barAccent: string;
+  iconName: 'shield' | 'chart' | 'beaker' | 'sparkles' | 'bolt';
+}
+
+export interface SemanticContextProfile {
+  domain: DomainVisualTokens;
+  depth: {
+    mode: ReadingDepthMode;
+    label: string;
+    description: string;
+    readingTime: number;
+    estimatedWords: number;
+    densityClass: string;
+    showKeyTakeaways: boolean;
+    showAnalyticalMetrics: boolean;
+  };
+  tone: {
+    id: SemanticTone;
+    label: string;
+    indicatorColor: string;
+    badgeStyle: string;
+    borderStyle: string;
+    urgencyLevel: 'high' | 'elevated' | 'standard';
+  };
+  placement: PlacementRole;
+  signals: string[]; // Explicit semantic signals extracted from the content that triggered this visual logic
+}
+
+export const DOMAIN_TOKENS: Record<EditorialDomainId, DomainVisualTokens> = {
+  'civic-policy': {
+    id: 'civic-policy',
+    label: 'Civic & Policy Dispatch',
+    tagline: 'Authoritative reporting on governance, national infrastructure, and labor',
+    accentHex: '#b91c1c',
+    surfaceBg: 'bg-slate-50/90',
+    surfaceBorder: 'border-slate-300',
+    badgeBg: 'bg-red-950',
+    badgeText: 'text-red-50',
+    badgeBorder: 'border-red-800',
+    headingClass: 'font-brand tracking-tight text-slate-950',
+    cardTreatment: 'border-t-4 border-t-red-800 bg-white shadow-sm',
+    accentText: 'text-red-800',
+    accentHoverText: 'group-hover:text-red-700 hover:text-red-700',
+    barAccent: 'bg-red-800',
+    iconName: 'shield',
+  },
+  'economy-markets': {
+    id: 'economy-markets',
+    label: 'Markets & Industrial Ledger',
+    tagline: 'Quantitative analysis of supply chains, housing markets, and industry',
+    accentHex: '#b45309',
+    surfaceBg: 'bg-amber-50/50',
+    surfaceBorder: 'border-amber-200',
+    badgeBg: 'bg-amber-900',
+    badgeText: 'text-amber-50',
+    badgeBorder: 'border-amber-700',
+    headingClass: 'font-brand tracking-normal text-stone-900',
+    cardTreatment: 'border-l-4 border-l-amber-700 bg-stone-50/60 shadow-sm',
+    accentText: 'text-amber-800',
+    accentHoverText: 'group-hover:text-amber-600 hover:text-amber-600',
+    barAccent: 'bg-amber-700',
+    iconName: 'chart',
+  },
+  'science-inquiry': {
+    id: 'science-inquiry',
+    label: 'Scientific & Forensic Inquiry',
+    tagline: 'Empirical research, forensic science, ecology, and technical systems',
+    accentHex: '#0f766e',
+    surfaceBg: 'bg-teal-950/[0.03]',
+    surfaceBorder: 'border-teal-200',
+    badgeBg: 'bg-teal-900',
+    badgeText: 'text-teal-50',
+    badgeBorder: 'border-teal-700',
+    headingClass: 'font-sans font-bold tracking-tight text-slate-900',
+    cardTreatment: 'border border-teal-200/80 border-t-4 border-t-teal-700 bg-gradient-to-b from-teal-50/30 to-white shadow-sm',
+    accentText: 'text-teal-800',
+    accentHoverText: 'group-hover:text-teal-600 hover:text-teal-600',
+    barAccent: 'bg-teal-700',
+    iconName: 'beaker',
+  },
+  'arts-culture': {
+    id: 'arts-culture',
+    label: 'Arts, Stage & Media Critique',
+    tagline: 'Cultural criticism, performing arts, and evolving media landscapes',
+    accentHex: '#6d28d9',
+    surfaceBg: 'bg-FAF8F5',
+    surfaceBorder: 'border-purple-200',
+    badgeBg: 'bg-purple-950',
+    badgeText: 'text-purple-100',
+    badgeBorder: 'border-purple-800',
+    headingClass: 'font-brand italic tracking-wide text-stone-950',
+    cardTreatment: 'border-b-4 border-b-purple-800 bg-stone-50/40 shadow-sm',
+    accentText: 'text-purple-900',
+    accentHoverText: 'group-hover:text-purple-700 hover:text-purple-700',
+    barAccent: 'bg-purple-800',
+    iconName: 'sparkles',
+  },
+  'lifestyle-vitality': {
+    id: 'lifestyle-vitality',
+    label: 'Vitality, Athletics & Urban Life',
+    tagline: 'Championship athletics, coastal living, transit, and everyday rituals',
+    accentHex: '#047857',
+    surfaceBg: 'bg-emerald-50/40',
+    surfaceBorder: 'border-emerald-200',
+    badgeBg: 'bg-emerald-900',
+    badgeText: 'text-emerald-50',
+    badgeBorder: 'border-emerald-700',
+    headingClass: 'font-brand tracking-tight text-gray-900',
+    cardTreatment: 'border-t-4 border-t-emerald-600 bg-white shadow-sm',
+    accentText: 'text-emerald-800',
+    accentHoverText: 'group-hover:text-emerald-600 hover:text-emerald-600',
+    barAccent: 'bg-emerald-600',
+    iconName: 'bolt',
+  },
+};
+
+export function resolveEditorialDomain(category: string, tags: string[] = []): EditorialDomainId {
+  const norm = (category || '').toLowerCase().trim();
+  const tagSet = tags.map((t) => t.toLowerCase());
+
+  if (['politics', 'national', 'news', 'labor'].includes(norm)) {
+    return 'civic-policy';
+  }
+  if (['economy', 'business'].includes(norm)) {
+    return 'economy-markets';
+  }
+  if (['science', 'web development', 'science & tech'].includes(norm)) {
+    return 'science-inquiry';
+  }
+  if (['culture', 'media', 'arts & culture'].includes(norm)) {
+    return 'arts-culture';
+  }
+  if (['lifestyle', 'sports', 'urban development', 'pets', 'lifestyle & sports'].includes(norm)) {
+    return 'lifestyle-vitality';
+  }
+
+  // Fallback check via semantic tags
+  if (tagSet.some((t) => ['economy', 'business', 'manufacturing', 'housing'].includes(t))) {
+    return 'economy-markets';
+  }
+  if (tagSet.some((t) => ['politics', 'national', 'protests', 'unions'].includes(t))) {
+    return 'civic-policy';
+  }
+  if (tagSet.some((t) => ['theater', 'dance', 'music', 'media', 'journalism'].includes(t))) {
+    return 'arts-culture';
+  }
+
+  return 'civic-policy';
+}
+
+export function resolveReadingDepth(readingTime?: number, summary: string = ''): SemanticContextProfile['depth'] {
+  const time = readingTime ?? Math.max(3, Math.ceil(summary.split(/\s+/).length / 40));
+
+  if (time <= 3) {
+    return {
+      mode: 'flash-brief',
+      label: 'Flash Dispatch',
+      description: 'Condensed high-signal brief optimized for rapid scanning',
+      readingTime: time,
+      estimatedWords: time * 210,
+      densityClass: 'leading-snug text-sm',
+      showKeyTakeaways: true,
+      showAnalyticalMetrics: false,
+    };
+  }
+
+  if (time >= 6) {
+    return {
+      mode: 'deep-investigation',
+      label: 'Deep Investigation',
+      description: 'Extended analytical dossier with multi-layered context',
+      readingTime: time,
+      estimatedWords: time * 240,
+      densityClass: 'leading-relaxed text-base',
+      showKeyTakeaways: true,
+      showAnalyticalMetrics: true,
+    };
+  }
+
+  return {
+    mode: 'standard-feature',
+    label: 'Feature Report',
+    description: 'Balanced editorial narrative with full visual framing',
+    readingTime: time,
+    estimatedWords: time * 225,
+    densityClass: 'leading-normal text-base',
+    showKeyTakeaways: false,
+    showAnalyticalMetrics: false,
+  };
+}
+
+const URGENT_KEYWORDS = [
+  'crisis', 'strikes', 'unrest', 'crumbling', 'decay', 'time bomb',
+  'criminal', 'killer', 'existential', 'decline', 'combat', 'gridlock',
+  'shortage', 'urgent', 'threat', 'protest',
+];
+
+const ANALYTICAL_KEYWORDS = [
+  'research', 'forensic', 'science', 'analysis', 'outlook', 'review',
+  'trends', 'growth', 'manufacturing', 'boom', 'profiling', 'architects',
+  'devtools', 'truth', 'alchemy', 'data',
+];
+
+export function resolveSemanticTone(
+  title: string,
+  summary: string = '',
+  tags: string[] = [],
+  domainId: EditorialDomainId = 'civic-policy'
+): SemanticContextProfile['tone'] {
+  const haystack = `${title} ${summary} ${tags.join(' ')}`.toLowerCase();
+
+  const urgentMatches = URGENT_KEYWORDS.filter((kw) => haystack.includes(kw));
+  const analyticalMatches = ANALYTICAL_KEYWORDS.filter((kw) => haystack.includes(kw));
+
+  if (urgentMatches.length > 0 && urgentMatches.length >= analyticalMatches.length) {
+    return {
+      id: 'urgent-crisis',
+      label: 'Critical Alert',
+      indicatorColor: 'bg-red-600',
+      badgeStyle: 'bg-red-100 text-red-900 border-red-300',
+      borderStyle: 'ring-1 ring-red-200',
+      urgencyLevel: 'high',
+    };
+  }
+
+  if (analyticalMatches.length > 0 || domainId === 'science-inquiry' || domainId === 'economy-markets') {
+    return {
+      id: 'analytical-report',
+      label: 'Analytical Lens',
+      indicatorColor: 'bg-teal-600',
+      badgeStyle: 'bg-teal-50 text-teal-900 border-teal-300',
+      borderStyle: 'ring-1 ring-slate-200',
+      urgencyLevel: 'elevated',
+    };
+  }
+
+  return {
+    id: 'vibrant-feature',
+    label: 'Cultural & Human Feature',
+    indicatorColor: 'bg-amber-500',
+    badgeStyle: 'bg-amber-50 text-amber-900 border-amber-300',
+    borderStyle: 'ring-1 ring-stone-200',
+    urgencyLevel: 'standard',
+  };
+}
+
+export interface SemanticInputItem {
+  title: string;
+  summary?: string;
+  description?: string;
+  category: string;
+  readingTime?: number;
+  tags?: string[];
+  author?: string;
+}
+
+export function deriveSemanticContext(
+  item: SemanticInputItem,
+  placement: PlacementRole = 'grid-card',
+  overrides?: {
+    domainId?: EditorialDomainId;
+    depthMode?: ReadingDepthMode;
+    toneId?: SemanticTone;
+    placement?: PlacementRole;
+  }
+): SemanticContextProfile {
+  const summaryText = item.summary || item.description || '';
+  const tags = item.tags || [];
+
+  const resolvedDomainId = overrides?.domainId ?? resolveEditorialDomain(item.category, tags);
+  const domain = DOMAIN_TOKENS[resolvedDomainId];
+
+  let depth = resolveReadingDepth(item.readingTime, summaryText);
+  if (overrides?.depthMode) {
+    const fakeTime =
+      overrides.depthMode === 'flash-brief'
+        ? 2
+        : overrides.depthMode === 'deep-investigation'
+        ? 8
+        : 4;
+    depth = resolveReadingDepth(fakeTime, summaryText);
+  }
+
+  let tone = resolveSemanticTone(item.title, summaryText, tags, resolvedDomainId);
+  if (overrides?.toneId) {
+    if (overrides.toneId === 'urgent-crisis') {
+      tone = {
+        id: 'urgent-crisis',
+        label: 'Critical Alert',
+        indicatorColor: 'bg-red-600',
+        badgeStyle: 'bg-red-100 text-red-900 border-red-300',
+        borderStyle: 'ring-1 ring-red-200',
+        urgencyLevel: 'high',
+      };
+    } else if (overrides.toneId === 'analytical-report') {
+      tone = {
+        id: 'analytical-report',
+        label: 'Analytical Lens',
+        indicatorColor: 'bg-teal-600',
+        badgeStyle: 'bg-teal-50 text-teal-900 border-teal-300',
+        borderStyle: 'ring-1 ring-slate-200',
+        urgencyLevel: 'elevated',
+      };
+    } else {
+      tone = {
+        id: 'vibrant-feature',
+        label: 'Cultural & Human Feature',
+        indicatorColor: 'bg-amber-500',
+        badgeStyle: 'bg-amber-50 text-amber-900 border-amber-300',
+        borderStyle: 'ring-1 ring-stone-200',
+        urgencyLevel: 'standard',
+      };
+    }
+  }
+
+  const effectivePlacement = overrides?.placement ?? placement;
+
+  const signals: string[] = [
+    `category:${item.category}`,
+    `domain:${domain.id}`,
+    `depth:${depth.mode}(${depth.readingTime}m)`,
+    `tone:${tone.id}`,
+    `role:${effectivePlacement}`,
+  ];
+  if (tags.length > 0) {
+    signals.push(`tags:${tags.slice(0, 3).join(',')}`);
+  }
+
+  return {
+    domain,
+    depth,
+    tone,
+    placement: effectivePlacement,
+    signals,
+  };
+}
+
+/**
+ * Extracts structured key takeaways or analytical highlights from article summary/body
+ * to power context-adaptive cards and callouts.
+ */
+export function extractSemanticHighlights(
+  title: string,
+  summary: string,
+  context: SemanticContextProfile
+): { label: string; points: string[]; metric?: { name: string; value: string; delta: string } } {
+  // Split summary into sentences
+  const sentences = summary
+    .split(/(?<=[.!?])\s+/)
+    .map((s) => s.trim())
+    .filter((s) => s.length > 15);
+
+  const points =
+    sentences.length >= 2
+      ? sentences
+      : [
+          summary,
+          `Editorial classification: ${context.domain.label} (${context.tone.label}).`,
+        ];
+
+  let metric: { name: string; value: string; delta: string } | undefined;
+
+  if (context.domain.id === 'economy-markets') {
+    metric = {
+      name: 'Sector Impact Index',
+      value: context.tone.id === 'urgent-crisis' ? 'High Volatility' : '+14.2% YoY',
+      delta: context.tone.id === 'urgent-crisis' ? 'Supply Deficit' : 'Expansion Phase',
+    };
+  } else if (context.domain.id === 'science-inquiry') {
+    metric = {
+      name: 'Empirical Confidence',
+      value: `${Math.min(99, 82 + context.depth.readingTime * 2)}% Peer-Verified`,
+      delta: `${context.depth.estimatedWords} words · Lab Dossier`,
+    };
+  } else if (context.domain.id === 'civic-policy') {
+    metric = {
+      name: 'Civic Priority Level',
+      value: context.tone.urgencyLevel === 'high' ? 'Tier-1 Urgent' : 'National Watch',
+      delta: 'Policy & Public Impact',
+    };
+  } else if (context.domain.id === 'arts-culture') {
+    metric = {
+      name: 'Cultural Resonance',
+      value: ' Critics’ Pick',
+      delta: 'Stage & Media Review',
+    };
+  } else {
+    metric = {
+      name: 'Field Pulse',
+      value: `${context.depth.readingTime} Min Active Brief`,
+      delta: 'Verified Dispatch',
+    };
+  }
+
+  const label =
+    context.depth.mode === 'flash-brief'
+      ? '60-Second Executive Brief'
+      : context.depth.mode === 'deep-investigation'
+      ? 'Investigative Dossier Findings'
+      : 'Editorial Context Summary';
+
+  return { label, points, metric };
+}
