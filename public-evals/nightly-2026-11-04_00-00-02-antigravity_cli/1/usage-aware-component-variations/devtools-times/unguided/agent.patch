+++ b/src/components/SemanticBadge.tsx
@@ -0,0 +1,149 @@
+import React from 'react';
+import {
+  DOMAIN_TOKENS,
+  resolveEditorialDomain,
+  resolveReadingDepth,
+  resolveSemanticTone,
+  type EditorialDomainId,
+  type ReadingDepthMode,
+  type SemanticTone,
+} from '../utils/semantic-context';
+
+export interface SemanticBadgeProps {
+  category: string;
+  tags?: string[];
+  readingTime?: number;
+  title?: string;
+  summary?: string;
+  domainOverride?: EditorialDomainId;
+  depthOverride?: ReadingDepthMode;
+  toneOverride?: SemanticTone;
+  showTone?: boolean;
+  showDepth?: boolean;
+  size?: 'xs' | 'sm' | 'md';
+  href?: string;
+}
+
+const DomainIcon: React.FC<{ iconName: string; className?: string }> = ({ iconName, className = 'w-3.5 h-3.5' }) => {
+  switch (iconName) {
+    case 'shield':
+      return (
+        <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+          <path strokeLinecap="round" strokeLinejoin="round" d="M12 3l8 4v5c0 5.25-3.5 9.74-8 11-4.5-1.26-8-5.75-8-11V7l8-4z" />
+        </svg>
+      );
+    case 'chart':
+      return (
+        <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+          <path strokeLinecap="round" strokeLinejoin="round" d="M3 3v18h18M7 16l4-4 4 4 5-6" />
+        </svg>
+      );
+    case 'beaker':
+      return (
+        <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+          <path strokeLinecap="round" strokeLinejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
+        </svg>
+      );
+    case 'sparkles':
+      return (
+        <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+          <path strokeLinecap="round" strokeLinejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
+        </svg>
+      );
+    default:
+      return (
+        <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+          <path strokeLinecap="round" strokeLinejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
+        </svg>
+      );
+  }
+};
+
+export default function SemanticBadge({
+  category,
+  tags = [],
+  readingTime,
+  title = '',
+  summary = '',
+  domainOverride,
+  depthOverride,
+  toneOverride,
+  showTone = true,
+  showDepth = false,
+  size = 'sm',
+  href,
+}: SemanticBadgeProps) {
+  const domainId = domainOverride ?? resolveEditorialDomain(category, tags);
+  const domain = DOMAIN_TOKENS[domainId];
+
+  const depth = resolveReadingDepth(
+    depthOverride === 'flash-brief'
+      ? 2
+      : depthOverride === 'deep-investigation'
+      ? 8
+      : depthOverride === 'standard-feature'
+      ? 4
+      : readingTime,
+    summary
+  );
+
+  const resolvedTone = resolveSemanticTone(title, summary, tags, domainId);
+  const toneId = toneOverride ?? resolvedTone.id;
+  const toneLabel =
+    toneId === 'urgent-crisis'
+      ? 'Critical Alert'
+      : toneId === 'analytical-report'
+      ? 'Analytical Lens'
+      : 'Feature';
+
+  const sizeClasses =
+    size === 'xs'
+      ? 'text-[10px] px-2 py-0.5'
+      : size === 'md'
+      ? 'text-xs px-3 py-1'
+      : 'text-[11px] px-2.5 py-0.5';
+
+  const displayCategory = category.charAt(0).toUpperCase() + category.slice(1);
+
+  const badgeContent = (
+    <span
+      className={`inline-flex items-center gap-1.5 font-semibold uppercase tracking-wider rounded border ${domain.badgeBg} ${domain.badgeText} ${domain.badgeBorder} ${sizeClasses} transition-opacity hover:opacity-90`}
+      data-semantic-domain={domain.id}
+    >
+      <DomainIcon iconName={domain.iconName} className="w-3 h-3 opacity-90" />
+      <span>{displayCategory}</span>
+    </span>
+  );
+
+  return (
+    <div
+      className="inline-flex flex-wrap items-center gap-1.5"
+      data-semantic-badge-group
+      data-domain={domain.id}
+      data-tone={toneId}
+      data-depth={depth.mode}
+    >
+      {href ? <a href={href}>{badgeContent}</a> : badgeContent}
+
+      {showTone && toneId === 'urgent-crisis' && (
+        <span className="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-red-100 text-red-900 border border-red-300">
+          <span className="w-1.5 h-1.5 rounded-full bg-red-600 animate-pulse" />
+          {toneLabel}
+        </span>
+      )}
+
+      {showTone && toneId === 'analytical-report' && (
+        <span className="inline-flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded bg-teal-50 text-teal-900 border border-teal-200">
+          <span className="w-1.5 h-1.5 rounded-full bg-teal-600" />
+          {toneLabel}
+        </span>
+      )}
+
+      {showDepth && (
+        <span className="inline-flex items-center gap-1 text-[10px] font-medium uppercase tracking-wider px-2 py-0.5 rounded bg-gray-100 text-gray-700 border border-gray-200">
+          {depth.label} · {depth.readingTime}m
+        </span>
+      )}
+    </div>
+  );
+}
