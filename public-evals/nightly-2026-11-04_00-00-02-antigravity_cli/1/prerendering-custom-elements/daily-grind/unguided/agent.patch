+  <script type="module">
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['expanded', 'favorited'];
+      }
+
+      constructor() {
+        super();
+        // Hydrate existing Declarative Shadow DOM in place without re-rendering
+        if (!this.shadowRoot) {
+          const template = this.querySelector('template[shadowrootmode]');
+          if (template) {
+            const mode = template.getAttribute('shadowrootmode') || 'open';
+            const root = this.attachShadow({ mode });
+            root.appendChild(template.content.cloneNode(true));
+            template.remove();
+          }
+        }
+
+        this._onDetailsClick = this._onDetailsClick.bind(this);
+        this._onFavoriteClick = this._onFavoriteClick.bind(this);
+      }
+
+      connectedCallback() {
+        if (!this.shadowRoot) return;
+
+        this._detailsBtn = this.shadowRoot.querySelector('[data-action="toggle-details"]');
+        this._detailsPanel = this.shadowRoot.querySelector('.details-panel');
+        this._favBtn = this.shadowRoot.querySelector('[data-action="toggle-favorite"]');
+
+        if (this._detailsBtn) {
+          this._detailsBtn.addEventListener('click', this._onDetailsClick);
+        }
+        if (this._favBtn) {
+          this._favBtn.addEventListener('click', this._onFavoriteClick);
+        }
+
+        this._syncExpandedState();
+        this._syncFavoriteState();
+        this.setAttribute('hydrated', '');
+      }
+
+      disconnectedCallback() {
+        if (this._detailsBtn) {
+          this._detailsBtn.removeEventListener('click', this._onDetailsClick);
+        }
+        if (this._favBtn) {
+          this._favBtn.removeEventListener('click', this._onFavoriteClick);
+        }
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue || !this.shadowRoot) return;
+        if (name === 'expanded') {
+          this._syncExpandedState();
+        } else if (name === 'favorited') {
+          this._syncFavoriteState();
+        }
+      }
+
+      get expanded() {
+        return this.hasAttribute('expanded');
+      }
+
+      set expanded(value) {
+        this.toggleAttribute('expanded', Boolean(value));
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(value) {
+        this.toggleAttribute('favorited', Boolean(value));
+      }
+
+      toggleDetails() {
+        this.expanded = !this.expanded;
+        this.dispatchEvent(new CustomEvent('drink-details-toggle', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            drinkId: this.getAttribute('drink-id'),
+            expanded: this.expanded
+          }
+        }));
+      }
+
+      toggleFavorite() {
+        this.favorited = !this.favorited;
+        this.dispatchEvent(new CustomEvent('drink-favorite-toggle', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            drinkId: this.getAttribute('drink-id'),
+            favorited: this.favorited
+          }
+        }));
+      }
+
+      _onDetailsClick(event) {
+        event.preventDefault();
+        this.toggleDetails();
+      }
+
+      _onFavoriteClick(event) {
+        event.preventDefault();
+        this.toggleFavorite();
+      }
+
+      _syncExpandedState() {
+        const isExpanded = this.expanded;
+        if (this._detailsPanel) {
+          this._detailsPanel.hidden = !isExpanded;
+        }
+        if (this._detailsBtn) {
+          this._detailsBtn.setAttribute('aria-expanded', String(isExpanded));
+          this._detailsBtn.textContent = isExpanded ? 'Hide Details' : 'View Details';
+        }
+      }
+
+      _syncFavoriteState() {
+        const isFavorited = this.favorited;
+        if (this._favBtn) {
+          this._favBtn.setAttribute('aria-pressed', String(isFavorited));
+          const icon = this._favBtn.querySelector('span');
+          if (icon) {
+            icon.innerHTML = isFavorited ? '&#9829;' : '&#9825;';
+          }
+        }
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
+
 </body>
 
