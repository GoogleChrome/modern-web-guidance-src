+  <script>
+    (function () {
+      const form = document.getElementById('coffee-order-form');
+      const drinkSelect = document.getElementById('drink-select');
+      const sweetnessRange = document.getElementById('sweetness-range');
+      const sweetnessOutput = document.getElementById('sweetness-output');
+      const shotsInput = document.getElementById('espresso-shots');
+      const caffeineMeter = document.getElementById('caffeine-meter');
+      const caffeineOutput = document.getElementById('caffeine-output');
+      const totalOutput = document.getElementById('order-total-output');
+      const feedback = document.getElementById('order-feedback');
+
+      function updateOrderSummary() {
+        const pumps = Number(sweetnessRange.value || 0);
+        sweetnessOutput.textContent = pumps === 1 ? '1 pump' : pumps + ' pumps';
+
+        const shots = Math.max(1, Number(shotsInput.value || 1));
+        const caffeineMg = shots * 75;
+        caffeineMeter.value = Math.min(400, caffeineMg);
+        caffeineOutput.textContent = caffeineMg + ' mg';
+
+        const selectedOption = drinkSelect.options[drinkSelect.selectedIndex];
+        const basePrice = Number(selectedOption?.dataset.price || 4.5);
+        const sizeRadio = form.querySelector('input[name="size"]:checked');
+        const sizeUpcharge = Number(sizeRadio?.dataset.upcharge || 0);
+        const extraShotCharge = Math.max(0, shots - 2) * 0.75;
+        const toppingsCount = form.querySelectorAll('input[name="toppings"]:checked').length;
+        const toppingsCharge = toppingsCount * 0.5;
+
+        const total = basePrice + sizeUpcharge + extraShotCharge + toppingsCharge;
+        totalOutput.textContent = '$' + total.toFixed(2);
+      }
+
+      form.addEventListener('input', updateOrderSummary);
+      form.addEventListener('reset', function () {
+        setTimeout(function () {
+          feedback.classList.remove('visible');
+          updateOrderSummary();
+        }, 0);
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        const customerName = document.getElementById('customer-name').value.trim() || 'Guest';
+        const drinkName = drinkSelect.options[drinkSelect.selectedIndex].text.replace(/\s*\(\$[\d.]+\)/, '');
+        const pickupTime = document.getElementById('pickup-time').value;
+        feedback.textContent = 'Order queued for ' + customerName + ': ' + drinkName + ' (' + totalOutput.textContent + ') ready around ' + pickupTime + '.';
+        feedback.classList.add('visible');
+      });
+
+      updateOrderSummary();
+    })();
+  </script>
