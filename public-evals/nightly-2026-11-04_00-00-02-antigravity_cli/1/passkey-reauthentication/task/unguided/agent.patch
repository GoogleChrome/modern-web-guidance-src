+  <script>
+    (function () {
+      function toBuffer(val) {
+        if (val instanceof ArrayBuffer) return val;
+        if (ArrayBuffer.isView(val)) {
+          return val.buffer.slice(val.byteOffset, val.byteOffset + val.byteLength);
+        }
+        if (Array.isArray(val)) return new Uint8Array(val).buffer;
+        if (val && typeof val === 'object' && Array.isArray(val.data)) {
+          return new Uint8Array(val.data).buffer;
+        }
+        if (typeof val === 'string') {
+          const base64 = val.replace(/-/g, '+').replace(/_/g, '/');
+          const pad = base64.length % 4 === 0 ? '' : '='.repeat(4 - (base64.length % 4));
+          try {
+            const binary = atob(base64 + pad);
+            const bytes = new Uint8Array(binary.length);
+            for (let i = 0; i < binary.length; i++) {
+              bytes[i] = binary.charCodeAt(i);
+            }
+            return bytes.buffer;
+          } catch (_) {
+            return new TextEncoder().encode(val).buffer;
+          }
+        }
+        return new Uint8Array(0).buffer;
+      }
+
+      function bufferToBase64url(buf) {
+        if (buf == null) return null;
+        if (typeof buf === 'string') return buf;
+        const bytes = buf instanceof Uint8Array
+          ? buf
+          : ArrayBuffer.isView(buf)
+            ? new Uint8Array(buf.buffer, buf.byteOffset, buf.byteLength)
+            : new Uint8Array(buf);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function buildPublicKeyRequestOptions(data) {
+        const raw = (data && (data.publicKey || data.options)) || data || {};
+        const rawCreds = raw.allowCredentials || raw.credentials || raw.registeredCredentials || [];
+        const allowCredentials = Array.isArray(rawCreds)
+          ? rawCreds.map(function (cred) {
+              if (typeof cred === 'string' || cred instanceof ArrayBuffer || ArrayBuffer.isView(cred)) {
+                return {
+                  type: 'public-key',
+                  id: toBuffer(cred)
+                };
+              }
+              const descriptor = Object.assign({}, cred, {
+                type: cred.type || 'public-key',
+                id: toBuffer(cred.id !== undefined ? cred.id : cred.credentialId)
+              });
+              return descriptor;
+            })
+          : [];
+
+        const publicKey = Object.assign({}, raw, {
+          challenge: toBuffer(raw.challenge),
+          allowCredentials: allowCredentials
+        });
+        delete publicKey.credentials;
+        delete publicKey.registeredCredentials;
+
+        return publicKey;
+      }
+
+      function serializeAssertion(credential) {
+        if (!credential) return {};
+        const resp = credential.response || {};
+        const clientExtensionResults =
+          typeof credential.getClientExtensionResults === 'function'
+            ? credential.getClientExtensionResults()
+            : (credential.clientExtensionResults || {});
+
+        const serialized = {
+          id: credential.id || bufferToBase64url(credential.rawId),
+          rawId: bufferToBase64url(credential.rawId !== undefined ? credential.rawId : credential.id),
+          type: credential.type || 'public-key',
+          clientExtensionResults: clientExtensionResults,
+          response: {
+            clientDataJSON: bufferToBase64url(resp.clientDataJSON),
+            authenticatorData: bufferToBase64url(resp.authenticatorData),
+            signature: bufferToBase64url(resp.signature),
+            userHandle: resp.userHandle != null ? bufferToBase64url(resp.userHandle) : null
+          }
+        };
+
+        if (credential.authenticatorAttachment) {
+          serialized.authenticatorAttachment = credential.authenticatorAttachment;
+        }
+
+        return serialized;
+      }
+
+      const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+      const statusEl = document.getElementById('reauth-status');
+      const sensitiveFieldset = document.getElementById('sensitive-settings');
+
+      if (reauthButton) {
+        reauthButton.addEventListener('click', async function () {
+          try {
+            if (statusEl) statusEl.textContent = 'Verifying identity...';
+
+            const optionsRes = await fetch('/api/reauth/options', {
+              method: 'POST',
+              headers: {
+                'Content-Type': 'application/json'
+              },
+              credentials: 'same-origin'
+            });
+
+            if (!optionsRes.ok) {
+              throw new Error('Failed to fetch re-authentication options');
+            }
+
+            const optionsData = await optionsRes.json();
+            const publicKey = buildPublicKeyRequestOptions(optionsData);
+
+            const credential = await navigator.credentials.get({
+              publicKey: publicKey
+            });
+
+            if (!credential) {
+              throw new Error('No credential returned from authenticator');
+            }
+
+            const verifyPayload = serializeAssertion(credential);
+
+            const verifyRes = await fetch('/api/reauth/verify', {
+              method: 'POST',
+              headers: {
+                'Content-Type': 'application/json'
+              },
+              credentials: 'same-origin',
+              body: JSON.stringify(verifyPayload)
+            });
+
+            if (!verifyRes.ok) {
+              throw new Error('Re-authentication verification failed');
+            }
+
+            let verifyData = null;
+            try {
+              verifyData = await verifyRes.json();
+            } catch (_) {
+              verifyData = { verified: true };
+            }
+
+            if (verifyData && verifyData.verified === false) {
+              throw new Error('Identity verification rejected');
+            }
+
+            if (sensitiveFieldset) {
+              sensitiveFieldset.disabled = false;
+            }
+            if (statusEl) {
+              statusEl.textContent = 'Identity confirmed.';
+            }
+          } catch (err) {
+            if (statusEl) {
+              statusEl.textContent = err && err.message ? err.message : 'Verification failed.';
+            }
+          }
+        });
+      }
+    })();
+  </script>
