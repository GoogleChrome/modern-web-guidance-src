+  <script>
+    const orderNowBtn = document.getElementById('order-now-btn');
+    if (orderNowBtn) {
+      orderNowBtn.addEventListener('click', (event) => {
+        event.preventDefault();
+        if (orderNowBtn.getAttribute('aria-disabled') === 'true') {
+          return;
+        }
+        orderNowBtn.setAttribute('aria-disabled', 'true');
+        orderNowBtn.setAttribute('aria-busy', 'true');
+        const label = orderNowBtn.querySelector('.btn-label');
+        const spinner = orderNowBtn.querySelector('.loading-spinner');
+        if (label) {
+          label.textContent = 'Starting Order...';
+        }
+        if (spinner) {
+          spinner.hidden = false;
+        }
+      });
+    }
+
+    const seasonalSection = document.getElementById('seasonal-favorites');
+    const seasonalLoading = document.getElementById('seasonal-loading');
+    const detailButtons = document.querySelectorAll('.view-details-btn');
+
+    detailButtons.forEach((btn) => {
+      btn.addEventListener('click', (event) => {
+        event.preventDefault();
+        if (btn.getAttribute('aria-disabled') === 'true') {
+          return;
+        }
+
+        const card = btn.closest('.card');
+        const spinner = btn.querySelector('.loading-spinner');
+        const label = btn.querySelector('.btn-label');
+        const details = card ? card.querySelector('.drink-details') : null;
+
+        btn.setAttribute('aria-disabled', 'true');
+        btn.setAttribute('aria-busy', 'true');
+        if (card) {
+          card.setAttribute('aria-busy', 'true');
+        }
+        if (seasonalSection) {
+          seasonalSection.setAttribute('aria-busy', 'true');
+        }
+        if (seasonalLoading) {
+          seasonalLoading.hidden = false;
+        }
+        if (label) {
+          label.textContent = 'Loading Details...';
+        }
+        if (spinner) {
+          spinner.hidden = false;
+        }
+
+        setTimeout(() => {
+          if (details) {
+            details.hidden = false;
+          }
+          if (spinner) {
+            spinner.hidden = true;
+          }
+          if (seasonalLoading) {
+            seasonalLoading.hidden = true;
+          }
+          if (label) {
+            label.textContent = 'Details Loaded';
+          }
+          btn.removeAttribute('aria-busy');
+          if (card) {
+            card.removeAttribute('aria-busy');
+          }
+          if (seasonalSection) {
+            seasonalSection.removeAttribute('aria-busy');
+          }
+        }, 2000);
+      });
+    });
+  </script>
