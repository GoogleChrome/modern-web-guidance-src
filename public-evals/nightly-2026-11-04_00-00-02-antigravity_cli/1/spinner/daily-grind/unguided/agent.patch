+  <script>
+    (function () {
+      const orderNowBtn = document.getElementById('order-now-btn');
+      const seasonalSection = document.getElementById('seasonal-favorites');
+      const seasonalStatus = document.getElementById('seasonal-status');
+      const seasonalStatusText = seasonalStatus ? seasonalStatus.querySelector('.loading-banner-text') : null;
+      const detailButtons = document.querySelectorAll('.drink-details-btn');
+
+      function setButtonBusy(btn, busyText, statusAnnouncement) {
+        if (!btn || btn.getAttribute('aria-busy') === 'true') return;
+        btn.classList.add('is-loading');
+        btn.setAttribute('aria-busy', 'true');
+        btn.setAttribute('aria-disabled', 'true');
+        btn.setAttribute('disabled', '');
+
+        const labelEl = btn.querySelector('.btn-label');
+        if (labelEl && busyText) {
+          labelEl.textContent = busyText;
+        }
+
+        const statusEl = btn.querySelector('.btn-status');
+        if (statusEl && statusAnnouncement) {
+          statusEl.textContent = statusAnnouncement;
+        }
+      }
+
+      function handleKeyActivation(event, callback) {
+        if (event.key === ' ' || event.key === 'Enter') {
+          event.preventDefault();
+          callback(event);
+        }
+      }
+
+      if (orderNowBtn) {
+        const startOrder = function (event) {
+          event.preventDefault();
+          setButtonBusy(orderNowBtn, 'Starting Order...', 'Starting your order, please wait.');
+        };
+        orderNowBtn.addEventListener('click', startOrder);
+        orderNowBtn.addEventListener('keydown', function (event) {
+          handleKeyActivation(event, startOrder);
+        });
+      }
+
+      detailButtons.forEach(function (btn) {
+        const loadDetails = function (event) {
+          event.preventDefault();
+          if (btn.getAttribute('aria-busy') === 'true') return;
+
+          const card = btn.closest('.card');
+          const drinkName = btn.getAttribute('data-drink') || (card && card.querySelector('h3') ? card.querySelector('h3').textContent : 'drink');
+          const announcement = 'Loading details for ' + drinkName + ', please wait.';
+
+          setButtonBusy(btn, 'Loading Details...', announcement);
+
+          if (card) {
+            card.classList.add('is-loading');
+            card.setAttribute('aria-busy', 'true');
+          }
+
+          if (seasonalSection) {
+            seasonalSection.classList.add('is-loading');
+            seasonalSection.setAttribute('aria-busy', 'true');
+          }
+
+          if (seasonalStatus) {
+            if (seasonalStatusText) {
+              seasonalStatusText.textContent = announcement;
+            }
+            seasonalStatus.hidden = false;
+          }
+        };
+
+        btn.addEventListener('click', loadDetails);
+        btn.addEventListener('keydown', function (event) {
+          handleKeyActivation(event, loadDetails);
+        });
+      });
+    })();
+  </script>
