@@ -0,0 +1,488 @@
+/**
+ * <coffee-menu> Web Component
+ * Interactive menu section with category filtering, search, sorting, and ARIA live announcements.
+ */
+export class CoffeeMenu extends HTMLElement {
+  static get observedAttributes() {
+    return ['heading', 'subheading', 'active-filter', 'search-query'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._activeFilter = 'all';
+    this._searchQuery = '';
+    this._sortOrder = 'featured';
+    this._filters = [
+      { id: 'all', label: 'All Coffees' },
+      { id: 'seasonal', label: 'Seasonal' },
+      { id: 'espresso', label: 'Espresso' },
+      { id: 'cold-brew', label: 'Cold Brew' },
+      { id: 'favorites', label: 'Favorites' }
+    ];
+    this._onFavoriteChanged = () => {
+      if (this._activeFilter === 'favorites') {
+        this._applyFilters();
+      }
+    };
+  }
+
+  connectedCallback() {
+    if (this.hasAttribute('active-filter')) {
