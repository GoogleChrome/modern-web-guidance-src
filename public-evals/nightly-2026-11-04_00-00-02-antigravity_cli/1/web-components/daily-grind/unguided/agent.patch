+    emailInput.setAttribute('aria-invalid', 'false');
+    feedbackEl.textContent = `Welcome to Daily Grind Rewards! 100 bonus points have been sent to ${email}.`;
+    feedbackEl.className = 'feedback success';
+    emailInput.value = '';
+
+    this.dispatchEvent(
+      new CustomEvent('rewards-signup', {
+        bubbles: true,
+        composed: true,
+        detail: { email }
+      })
+    );
+  }
+
+  render() {
