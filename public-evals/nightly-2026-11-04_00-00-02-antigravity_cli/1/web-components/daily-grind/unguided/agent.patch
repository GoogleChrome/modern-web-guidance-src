+
+  _handleTabKeydown(event) {
+    const ids = this._tabs.map((t) => t.id);
+    const currentIdx = ids.indexOf(this._activeTab);
+    let nextIdx = -1;
+
+    if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
+      event.preventDefault();
+      nextIdx = (currentIdx + 1) % ids.length;
+    } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
+      event.preventDefault();
+      nextIdx = (currentIdx - 1 + ids.length) % ids.length;
+    } else if (event.key === 'Home') {
+      event.preventDefault();
+      nextIdx = 0;
+    } else if (event.key === 'End') {
+      event.preventDefault();
+      nextIdx = ids.length - 1;
+    }
+
+    if (nextIdx !== -1) {
+      this._selectTab(ids[nextIdx]);
+      const buttons = this.shadowRoot.querySelectorAll('.brew-tab');
+      if (buttons[nextIdx]) {
+        buttons[nextIdx].focus();
+      }
+    }
+  }
+
+  _handleFormSubmit(event) {
+    event.preventDefault();
+    const emailInput = this.shadowRoot.querySelector('#rewards-email');
+    const feedbackEl = this.shadowRoot.querySelector('#rewards-feedback');
+    if (!emailInput || !feedbackEl) return;
+
+    const email = emailInput.value.trim();
+    const isValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
