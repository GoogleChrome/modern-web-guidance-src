+          outline: 3px solid var(--accent, #ffab40);
+          outline-offset: 2px;
+        }
+
+        .card-body {
+          padding: 20px;
+          display: flex;
+          flex-direction: column;
+          flex: 1;
+          text-align: left;
+        }
+
+        .card-header {
+          display: flex;
+          justify-content: space-between;
+          align-items: flex-start;
+          gap: 10px;
+          margin-bottom: 8px;
+        }
+
+        h3 {
+          font-size: 1.25rem;
+          color: var(--primary, #4e342e);
+          line-height: 1.3;
+        }
+
+        .price-tag {
