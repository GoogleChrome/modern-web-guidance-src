+          border-radius: 6px;
+          font-weight: 600;
+          transition: background 0.3s, transform 0.2s;
+          border: 2px solid transparent;
+        }
+
+        .btn:hover {
+          background: #3e2723;
+          transform: translateY(-2px);
+        }
+
+        .btn-outline {
+          background: rgba(255, 255, 255, 0.12);
+          border-color: #ffffff;
+        }
+
+        .btn-outline:hover {
+          background: rgba(255, 255, 255, 0.24);
+        }
+
+        .btn:focus-visible {
+          outline: 3px solid var(--accent, #ffab40);
+          outline-offset: 2px;
+        }
+      </style>
+
+      <header class="hero" part="hero" role="banner">
+        <span class="roast-pill">Freshly Roasted Daily • Direct Trade Beans</span>
+        <h1 part="heading"><slot name="heading">${this.heading}</slot></h1>
+        <p part="subheading"><slot name="subheading">${this.subheading}</slot></p>
+        <div class="hero-actions" part="actions">
+          <a href="${this.ctaHref}" class="btn" part="cta">${this.ctaText}</a>
+          <a href="${this.secondaryHref}" class="btn btn-outline explore-btn">${this.secondaryText}</a>
+        </div>
+      </header>
+    `;
+
+    const exploreBtn = this.shadowRoot.querySelector('.explore-btn');
+    if (exploreBtn) {
+      exploreBtn.addEventListener('click', (e) => {
+        const targetId = this.secondaryHref.replace(/^#/, '');
+        const targetEl = document.getElementById(targetId) || document.querySelector('coffee-menu');
+        if (targetEl && typeof targetEl.scrollIntoView === 'function') {
+          e.preventDefault();
+          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
+        }
+      });
+    }
+  }
+}
+
+if (!customElements.get('dg-hero')) {
+  customElements.define('dg-hero', DgHero);
+}
