+    if (!isValid) {
+      emailInput.setAttribute('aria-invalid', 'true');
+      feedbackEl.textContent = 'Please enter a valid email address to claim your 100 bonus beans.';
+      feedbackEl.className = 'feedback error';
+      emailInput.focus();
+      return;
+    }
