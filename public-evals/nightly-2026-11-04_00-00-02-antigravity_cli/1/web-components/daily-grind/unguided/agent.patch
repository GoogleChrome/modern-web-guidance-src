+              <span class="bag-total-amount">$0.00</span>
+            </div>
+            <a href="/order-online" class="checkout-link">Checkout</a>
+          </div>
+        </div>
+      </nav>
+    `;
+
+    const mobileBtn = this.shadowRoot.querySelector('.mobile-toggle');
+    if (mobileBtn) {
+      mobileBtn.addEventListener('click', () => {
+        this._mobileMenuOpen = !this._mobileMenuOpen;
+        this._updateMobileMenu();
+      });
+    }
+
+    const cartBtn = this.shadowRoot.querySelector('.cart-toggle-btn');
+    if (cartBtn) {
+      cartBtn.addEventListener('click', () => {
+        this._cartDrawerOpen = !this._cartDrawerOpen;
+        this._updateCartDisplay();
+      });
+    }
+
+    const closeBagBtn = this.shadowRoot.querySelector('.close-bag-btn');
+    if (closeBagBtn) {
+      closeBagBtn.addEventListener('click', () => {
+        this._cartDrawerOpen = false;
+        this._updateCartDisplay();
+      });
+    }
+  }
+}
+
+if (!customElements.get('dg-navbar')) {
+  customElements.define('dg-navbar', DgNavbar);
+}
