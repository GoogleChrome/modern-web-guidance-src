+          <div class="dialog-content">
+            <div class="dialog-header">
+              <h2 id="modal-title">${coffee.title}</h2>
+              <span class="modal-price" aria-live="polite">${priceFormatted}</span>
+            </div>
+
+            <p id="modal-desc" class="modal-desc">${coffee.description}</p>
+
+            <div class="specs">
+              <p><strong>Tasting Notes:</strong> ${coffee.notes || 'Balanced & smooth'}</p>
+              <p><strong>Roast & Nutrition:</strong> ${coffee.roast || 'Medium Roast'} • ${coffee.calories || '120 cal'}</p>
+            </div>
+
+            <div class="field-group">
+              <label for="modal-size-select">Cup Size</label>
+              <select id="modal-size-select" class="size-select">
+                <option value="Small" ${this._selectedSize === 'Small' ? 'selected' : ''}>Small (12 oz)</option>
+                <option value="Medium" ${this._selectedSize === 'Medium' ? 'selected' : ''}>Medium (16 oz)</option>
+                <option value="Large" ${this._selectedSize === 'Large' ? 'selected' : ''}>Large (20 oz)</option>
+              </select>
+            </div>
+
+            <div class="field-group">
+              <label for="modal-milk-select">Milk / Preparation</label>
+              <select id="modal-milk-select" class="milk-select">
+                <option value="Oat Milk">Barista Oat Milk</option>
+                <option value="Whole Milk">Organic Whole Milk</option>
+                <option value="Almond Milk">Unsweetened Almond Milk</option>
+                <option value="Black / No Milk">Black / No Milk</option>
+              </select>
+            </div>
+
+            <div class="modal-actions">
+              <button type="button" class="btn btn-primary modal-order-btn">
+                Add to Order (${priceFormatted})
+              </button>
+              <a href="${coffee.href || '/menu'}" class="btn btn-secondary">
+                Full Menu Page
+              </a>
+            </div>
+          </div>
+        </div>
+      </div>
+    `;
+
+    const backdrop = this.shadowRoot.querySelector('.backdrop');
+    if (backdrop) {
+      backdrop.addEventListener('click', (e) => {
+        if (e.target === backdrop) {
+          this.close();
+        }
+      });
+    }
+
+    const closeBtn = this.shadowRoot.querySelector('.close-btn');
+    if (closeBtn) {
+      closeBtn.addEventListener('click', () => this.close());
+    }
+
+    const sizeSelect = this.shadowRoot.querySelector('.size-select');
+    if (sizeSelect) {
+      sizeSelect.addEventListener('change', (e) => {
+        this._selectedSize = e.target.value;
+        const newPrice = `$${this._calculatePrice().toFixed(2)}`;
+        const priceEl = this.shadowRoot.querySelector('.modal-price');
+        const orderBtn = this.shadowRoot.querySelector('.modal-order-btn');
+        if (priceEl) priceEl.textContent = newPrice;
+        if (orderBtn) orderBtn.textContent = `Add to Order (${newPrice})`;
+      });
+    }
+
+    const milkSelect = this.shadowRoot.querySelector('.milk-select');
+    if (milkSelect) {
+      milkSelect.addEventListener('change', (e) => {
+        this._selectedMilk = e.target.value;
+      });
+    }
+
+    const orderBtn = this.shadowRoot.querySelector('.modal-order-btn');
+    if (orderBtn) {
+      orderBtn.addEventListener('click', () => {
+        const numericPrice = this._calculatePrice();
+        this.dispatchEvent(
+          new CustomEvent('coffee-order', {
+            bubbles: true,
+            composed: true,
+            detail: {
+              title: coffee.title,
+              size: this._selectedSize,
+              milk: this._selectedMilk,
+              price: `$${numericPrice.toFixed(2)}`,
+              numericPrice,
+              category: coffee.category || 'seasonal',
+              href: coffee.href || '/menu'
+            }
+          })
+        );
+        this.close();
+      });
+    }
+  }
+}
+
+if (!customElements.get('coffee-modal')) {
+  customElements.define('coffee-modal', CoffeeModal);
+}
