+        h2 {
+          font-size: 1.5rem;
+          color: var(--primary, #4e342e);
+          margin-bottom: 12px;
+        }
+
+        .brew-tabs {
+          display: flex;
+          gap: 8px;
+          margin-bottom: 16px;
+          border-bottom: 2px solid #f0ebe8;
+          padding-bottom: 8px;
+        }
+
+        .brew-tab {
+          background: transparent;
+          border: none;
+          padding: 8px 14px;
+          border-radius: 6px;
+          font-weight: 600;
+          font-size: 0.9rem;
+          color: var(--text, #3e2723);
+          cursor: pointer;
+        }
+
+        .brew-tab.active {
+          background: var(--primary, #4e342e);
+          color: #ffffff;
+        }
+
+        .brew-panel {
+          background: #faf6f4;
+          padding: 16px;
+          border-radius: 8px;
+          border-left: 4px solid var(--accent, #ffab40);
