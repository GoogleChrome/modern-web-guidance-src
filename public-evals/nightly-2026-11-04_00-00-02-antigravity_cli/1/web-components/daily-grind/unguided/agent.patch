+          grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
+          gap: 10px;
+          margin-bottom: 12px;
+          font-size: 0.88rem;
+        }
+
+        .spec-box {
+          background: #ffffff;
+          padding: 8px 10px;
+          border-radius: 6px;
+          border: 1px solid #ece3df;
+        }
+
+        .spec-box strong {
+          display: block;
+          font-size: 0.76rem;
+          text-transform: uppercase;
+          color: #6d4c41;
+        }
+
+        .brew-tip {
+          font-size: 0.92rem;
+          color: var(--text, #3e2723);
+        }
+
+        .rewards-card {
+          background: linear-gradient(135deg, #4e342e 0%, #3e2723 100%);
+          color: #ffffff;
+          padding: 24px;
+          border-radius: 12px;
