+          padding: 4px 10px;
+          border-radius: 999px;
+          box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
+        }
+
+        .favorite-btn {
+          position: absolute;
+          top: 10px;
+          right: 10px;
+          width: 38px;
+          height: 38px;
+          border-radius: 50%;
+          border: none;
+          background: rgba(255, 255, 255, 0.92);
+          color: var(--primary, #4e342e);
+          cursor: pointer;
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          font-size: 1.15rem;
+          box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
+          transition: background 0.2s, transform 0.2s, color 0.2s;
+        }
+
+        .favorite-btn:hover {
+          background: #ffffff;
+          transform: scale(1.08);
