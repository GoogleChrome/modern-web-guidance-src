+
+        <div
+          id="order-bag-drawer"
+          class="bag-drawer"
+          role="region"
+          aria-label="Current Order Bag"
+          hidden
+        >
+          <div class="bag-header">
+            <h3>Your Order Bag</h3>
+            <button type="button" class="close-bag-btn" aria-label="Close order bag">✕</button>
