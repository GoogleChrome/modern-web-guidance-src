+/**
+ * <coffee-rewards> Web Component
+ * Interactive Brew Guide tabs and Daily Grind Rewards signup with accessible form validation.
+ */
+export class CoffeeRewards extends HTMLElement {
+  static get observedAttributes() {
+    return ['heading', 'active-tab'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._activeTab = 'pour-over';
+    this._tabs = [
+      {
+        id: 'pour-over',
+        label: 'Pour Over',
+        ratio: '1:16 Coffee-to-Water',
+        grind: 'Medium-Fine (Sea Salt)',
+        temp: '200°F (93°C) • 3 min brew',
+        tip: 'Bloom freshly ground beans for 30 seconds before pouring in slow concentric circles.'
+      },
+      {
+        id: 'espresso-method',
+        label: 'Espresso Pull',
+        ratio: '1:2 Dose-to-Yield',
+        grind: 'Fine (Powdered Sugar)',
+        temp: '200°F (93°C) • 28 sec extraction',
+        tip: 'Pairs best with our Dark Roast Espresso for a rich, velvety crema and smoky finish.'
+      },
+      {
+        id: 'cold-steep',
+        label: 'Cold Brew Steep',
+        ratio: '1:8 Concentrate Ratio',
+        grind: 'Extra Coarse (Cracked Pepper)',
+        temp: 'Filtered Cold Water • 18 hours',
+        tip: 'Steep slowly at room temperature or refrigerated for ultra-smooth, low-acid sweetness.'
+      }
+    ];
+  }
+
+  connectedCallback() {
+    if (this.hasAttribute('active-tab')) {
+      this._activeTab = this.getAttribute('active-tab') || 'pour-over';
+    }
+    this.render();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue && this.isConnected) {
+      if (name === 'active-tab' && newValue) {
+        this._activeTab = newValue;
+      }
+      this.render();
+    }
+  }
+
+  get heading() {
+    return this.getAttribute('heading') || 'Brewing Guide & Daily Rewards';
+  }
+
+  _selectTab(tabId) {
+    this._activeTab = tabId;
+    this.setAttribute('active-tab', tabId);
+    const tabButtons = this.shadowRoot.querySelectorAll('.brew-tab');
+    const panels = this.shadowRoot.querySelectorAll('.brew-panel');
+
+    tabButtons.forEach((btn) => {
+      const selected = btn.dataset.tab === tabId;
+      btn.setAttribute('aria-selected', String(selected));
+      btn.tabIndex = selected ? 0 : -1;
