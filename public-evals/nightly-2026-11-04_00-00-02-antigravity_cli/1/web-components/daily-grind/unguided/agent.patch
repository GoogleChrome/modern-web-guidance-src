+/**
+ * <coffee-card> Web Component
+ * Reusable, accessible artisanal coffee product card with Shadow DOM encapsulation.
+ */
+export class CoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return [
+      'title',
+      'name',
+      'description',
+      'href',
+      'image',
+      'image-alt',
+      'price',
+      'category',
+      'badge',
+      'roast',
+      'notes',
+      'calories',
+      'cta-text',
+      'favorited'
+    ];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._selectedSize = 'Medium';
+    this._sizeModifiers = {
+      Small: -0.5,
+      Medium: 0,
+      Large: 0.75
+    };
+    this._detailsExpanded = false;
+    this._justAdded = false;
+    this._feedbackTimer = null;
+  }
+
+  connectedCallback() {
+    this.render();
+  }
+
+  disconnectedCallback() {
+    if (this._feedbackTimer) {
+      clearTimeout(this._feedbackTimer);
+    }
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue && this.isConnected) {
+      this.render();
+    }
+  }
+
+  get cardTitle() {
+    return this.getAttribute('title') || this.getAttribute('name') || 'Artisanal Coffee';
+  }
+
+  get description() {
+    return this.getAttribute('description') || '';
+  }
+
+  get href() {
+    return this.getAttribute('href') || '/menu';
+  }
+
+  get image() {
+    return (
+      this.getAttribute('image') ||
+      'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80'
+    );
+  }
+
+  get imageAlt() {
+    return this.getAttribute('image-alt') || `${this.cardTitle} served in a ceramic cup`;
+  }
+
+  get basePrice() {
+    const raw = this.getAttribute('price') || '$4.50';
+    const numeric = parseFloat(String(raw).replace(/[^0-9.]/g, ''));
+    return Number.isFinite(numeric) ? numeric : 4.5;
+  }
+
+  get currentPriceFormatted() {
+    const modifier = this._sizeModifiers[this._selectedSize] || 0;
+    return `$${(this.basePrice + modifier).toFixed(2)}`;
+  }
+
+  get category() {
+    return this.getAttribute('category') || 'seasonal';
+  }
+
+  get badge() {
+    return this.getAttribute('badge') || '';
+  }
+
+  get roast() {
+    return this.getAttribute('roast') || 'Medium Roast';
+  }
+
+  get notes() {
+    return this.getAttribute('notes') || 'Rich, balanced, artisanal finish';
+  }
+
+  get calories() {
+    return this.getAttribute('calories') || '120 cal';
+  }
+
+  get ctaText() {
+    return this.getAttribute('cta-text') || 'View Details';
+  }
+
+  get isFavorited() {
+    return this.hasAttribute('favorited') && this.getAttribute('favorited') !== 'false';
+  }
+
+  set isFavorited(val) {
+    if (val) {
+      this.setAttribute('favorited', '');
+    } else {
+      this.removeAttribute('favorited');
+    }
+  }
+
+  _escapeHtml(str) {
+    return String(str)
+      .replace(/&/g, '&amp;')
+      .replace(/</g, '&lt;')
+      .replace(/>/g, '&gt;')
+      .replace(/"/g, '&quot;')
+      .replace(/'/g, '&#39;');
+  }
+
+  _handleFavoriteToggle() {
+    const nextState = !this.isFavorited;
+    this.isFavorited = nextState;
+    this.dispatchEvent(
+      new CustomEvent('coffee-favorite', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          title: this.cardTitle,
+          category: this.category,
+          favorited: nextState
+        }
+      })
+    );
+  }
+
+  _handleSizeChange(size) {
+    if (!this._sizeModifiers.hasOwnProperty(size)) return;
+    this._selectedSize = size;
+    this._updateInteractiveState();
+    this.dispatchEvent(
+      new CustomEvent('coffee-size-change', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          title: this.cardTitle,
+          size: this._selectedSize,
+          price: this.currentPriceFormatted
+        }
+      })
+    );
+  }
+
+  _handleSizeKeydown(event) {
+    const sizes = Object.keys(this._sizeModifiers);
+    const currentIndex = sizes.indexOf(this._selectedSize);
+    let nextIndex = -1;
+
+    if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
+      event.preventDefault();
+      nextIndex = (currentIndex + 1) % sizes.length;
+    } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
+      event.preventDefault();
+      nextIndex = (currentIndex - 1 + sizes.length) % sizes.length;
+    } else if (event.key === 'Home') {
+      event.preventDefault();
+      nextIndex = 0;
+    } else if (event.key === 'End') {
+      event.preventDefault();
+      nextIndex = sizes.length - 1;
+    }
+
+    if (nextIndex !== -1) {
+      const nextSize = sizes[nextIndex];
+      this._handleSizeChange(nextSize);
+      const radioButtons = this.shadowRoot.querySelectorAll('.size-btn');
+      if (radioButtons[nextIndex]) {
+        radioButtons[nextIndex].focus();
+      }
+    }
+  }
+
+  _handleDetailsToggle() {
+    this._detailsExpanded = !this._detailsExpanded;
+    this._updateInteractiveState();
+  }
+
+  _handleOpenModal(event) {
+    const detailEvent = new CustomEvent('coffee-details', {
+      bubbles: true,
+      composed: true,
+      cancelable: true,
+      detail: {
+        title: this.cardTitle,
+        description: this.description,
+        href: this.href,
+        image: this.image,
+        imageAlt: this.imageAlt,
+        price: this.currentPriceFormatted,
+        basePrice: this.basePrice,
+        size: this._selectedSize,
+        category: this.category,
+        badge: this.badge,
+        roast: this.roast,
+        notes: this.notes,
+        calories: this.calories,
+        triggerElement: event.currentTarget
+      }
+    });
+
+    const notCancelled = this.dispatchEvent(detailEvent);
+    if (!notCancelled) {
+      event.preventDefault();
+    }
+  }
+
+  _handleAddToOrder() {
+    this._justAdded = true;
+    this._updateInteractiveState();
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-order', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          title: this.cardTitle,
+          size: this._selectedSize,
+          price: this.currentPriceFormatted,
+          numericPrice: this.basePrice + (this._sizeModifiers[this._selectedSize] || 0),
+          category: this.category,
+          image: this.image,
+          href: this.href
+        }
+      })
+    );
+
+    if (this._feedbackTimer) {
+      clearTimeout(this._feedbackTimer);
+    }
+    this._feedbackTimer = setTimeout(() => {
+      this._justAdded = false;
+      if (this.isConnected) {
+        this._updateInteractiveState();
+      }
+    }, 1800);
+  }
+
+  _updateInteractiveState() {
+    if (!this.shadowRoot) return;
+
+    const priceEl = this.shadowRoot.querySelector('.price-tag');
+    if (priceEl) {
+      priceEl.textContent = this.currentPriceFormatted;
+    }
+
+    const sizeBtns = this.shadowRoot.querySelectorAll('.size-btn');
+    sizeBtns.forEach((btn) => {
+      const isSelected = btn.dataset.size === this._selectedSize;
+      btn.setAttribute('aria-checked', String(isSelected));
+      btn.tabIndex = isSelected ? 0 : -1;
+      btn.classList.toggle('active', isSelected);
+    });
+
+    const toggleBtn = this.shadowRoot.querySelector('.notes-toggle');
+    const detailsPanel = this.shadowRoot.querySelector('#tasting-panel');
+    if (toggleBtn && detailsPanel) {
+      toggleBtn.setAttribute('aria-expanded', String(this._detailsExpanded));
+      toggleBtn.querySelector('.toggle-label').textContent = this._detailsExpanded
+        ? 'Hide Tasting Notes'
+        : 'Tasting Notes & Info';
+      detailsPanel.hidden = !this._detailsExpanded;
+    }
+
+    const addBtn = this.shadowRoot.querySelector('.add-order-btn');
+    const liveStatus = this.shadowRoot.querySelector('.sr-status');
+    if (addBtn) {
+      addBtn.textContent = this._justAdded ? 'Added to Order!' : 'Add to Order';
+      addBtn.classList.toggle('added', this._justAdded);
+    }
+    if (liveStatus) {
+      liveStatus.textContent = this._justAdded
+        ? `${this._selectedSize} ${this.cardTitle} (${this.currentPriceFormatted}) added to your order.`
+        : '';
+    }
+  }
+
+  render() {
+    const title = this._escapeHtml(this.cardTitle);
+    const description = this._escapeHtml(this.description);
+    const href = this._escapeHtml(this.href);
+    const image = this._escapeHtml(this.image);
+    const imageAlt = this._escapeHtml(this.imageAlt);
+    const badge = this._escapeHtml(this.badge);
+    const roast = this._escapeHtml(this.roast);
+    const notes = this._escapeHtml(this.notes);
+    const calories = this._escapeHtml(this.calories);
+    const ctaText = this._escapeHtml(this.ctaText);
+    const price = this._escapeHtml(this.currentPriceFormatted);
+    const isFav = this.isFavorited;
+
+    this.shadowRoot.innerHTML = `
+      <style>
+        :host {
+          display: block;
