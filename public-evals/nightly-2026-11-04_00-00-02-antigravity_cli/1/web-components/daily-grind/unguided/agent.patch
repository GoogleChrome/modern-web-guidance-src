+          padding-top: 6px;
+        }
+
+        .btn {
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          padding: 10px 14px;
+          border-radius: 6px;
+          font-size: 0.9rem;
+          font-weight: 600;
+          text-decoration: none;
+          cursor: pointer;
+          transition: background 0.25s, color 0.25s, border-color 0.25s;
+          border: 1px solid transparent;
+          flex: 1;
+          text-align: center;
