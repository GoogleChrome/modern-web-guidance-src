+          color: var(--text, #3e2723);
+          height: 100%;
+        }
+
+        :host([hidden]) {
+          display: none !important;
+        }
+
+        * {
+          box-sizing: border-box;
+          margin: 0;
+          padding: 0;
+        }
+
+        .card {
+          background: #ffffff;
+          border-radius: 12px;
+          box-shadow: 0 3px 10px rgba(62, 39, 35, 0.1);
+          overflow: hidden;
+          display: flex;
+          flex-direction: column;
+          height: 100%;
+          transition: transform 0.25s ease, box-shadow 0.25s ease;
+          border: 1px solid rgba(78, 52, 46, 0.08);
+          position: relative;
+        }
+
+        .card:hover,
+        .card:focus-within {
+          transform: translateY(-4px);
+          box-shadow: 0 10px 24px rgba(62, 39, 35, 0.16);
+        }
+
+        @media (prefers-reduced-motion: reduce) {
+          .card {
+            transition: none;
+          }
+          .card:hover,
+          .card:focus-within {
+            transform: none;
+          }
+        }
+
+        .media-wrapper {
+          position: relative;
+          width: 100%;
+          height: 195px;
+          background-color: var(--secondary, #d7ccc8);
+          overflow: hidden;
+        }
+
+        .card-image {
+          width: 100%;
+          height: 100%;
+          object-fit: cover;
+          display: block;
+          transition: transform 0.4s ease;
+        }
+
+        .card:hover .card-image {
+          transform: scale(1.04);
+        }
+
+        @media (prefers-reduced-motion: reduce) {
+          .card-image {
+            transition: none;
+          }
+          .card:hover .card-image {
+            transform: none;
+          }
+        }
+
+        .badge {
+          position: absolute;
+          top: 12px;
+          left: 12px;
+          background: var(--primary, #4e342e);
+          color: #ffffff;
