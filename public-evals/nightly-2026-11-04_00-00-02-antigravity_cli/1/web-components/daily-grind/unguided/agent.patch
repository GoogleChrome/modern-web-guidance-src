+          height: 1px;
+          padding: 0;
+          margin: -1px;
+          overflow: hidden;
+          clip: rect(0, 0, 0, 0);
+          white-space: nowrap;
+          border: 0;
+        }
+      </style>
+
+      <article class="card" part="card" aria-labelledby="card-title">
+        <div class="media-wrapper">
+          <img class="card-image" part="image" src="${image}" alt="${imageAlt}" loading="lazy" />
+          ${badge ? `<span class="badge" part="badge"><slot name="badge">${badge}</slot></span>` : `<slot name="badge"></slot>`}
+          <button
+            type="button"
+            class="favorite-btn"
+            aria-pressed="${String(isFav)}"
+            aria-label="${isFav ? `Remove ${title} from favorites` : `Save ${title} to favorites`}"
+            title="${isFav ? 'Remove from favorites' : 'Save to favorites'}"
+          >
+            <span aria-hidden="true">${isFav ? '♥' : '♡'}</span>
+          </button>
+        </div>
+
+        <div class="card-body">
+          <div class="card-header">
+            <h3 id="card-title" part="title"><slot name="title">${title}</slot></h3>
+            <span class="price-tag" part="price" aria-label="Price ${price}">${price}</span>
+          </div>
+
+          <p class="description" part="description">
+            <slot name="description">${description}</slot>
+          </p>
+
+          <div class="meta-tags" aria-label="Coffee characteristics">
+            <span class="meta-pill">${roast}</span>
+            <span class="meta-pill">${calories}</span>
+          </div>
+
+          <div
+            class="size-selector"
+            role="radiogroup"
+            aria-label="Choose cup size for ${title}"
+          >
+            ${Object.keys(this._sizeModifiers)
+              .map((size) => {
+                const selected = size === this._selectedSize;
+                return `
+                  <button
+                    type="button"
+                    role="radio"
+                    class="size-btn ${selected ? 'active' : ''}"
+                    data-size="${size}"
+                    aria-checked="${String(selected)}"
+                    tabindex="${selected ? '0' : '-1'}"
+                  >
+                    ${size}
+                  </button>
+                `;
+              })
+              .join('')}
+          </div>
+
+          <button
+            type="button"
+            class="notes-toggle"
+            aria-expanded="${String(this._detailsExpanded)}"
+            aria-controls="tasting-panel"
+          >
+            <span class="toggle-label">${this._detailsExpanded ? 'Hide Tasting Notes' : 'Tasting Notes & Info'}</span>
+            <span aria-hidden="true">▾</span>
+          </button>
+
+          <div id="tasting-panel" class="tasting-panel" role="region" aria-label="${title} tasting notes" ${this._detailsExpanded ? '' : 'hidden'}>
+            <p><strong>Notes:</strong> ${notes}</p>
+            <p><strong>Roast Profile:</strong> ${roast} (${calories})</p>
+          </div>
+
+          <slot></slot>
+
+          <div class="actions" part="actions">
+            <button type="button" class="btn btn-primary add-order-btn">
+              ${this._justAdded ? 'Added to Order!' : 'Add to Order'}
+            </button>
+            <a href="${href}" class="btn btn-secondary details-link" part="cta">
+              <slot name="cta">${ctaText}</slot>
+            </a>
+          </div>
+
+          <div class="sr-only sr-status" role="status" aria-live="polite"></div>
+        </div>
+      </article>
+    `;
+
+    const favBtn = this.shadowRoot.querySelector('.favorite-btn');
+    if (favBtn) {
+      favBtn.addEventListener('click', () => this._handleFavoriteToggle());
+    }
+
+    const sizeGroup = this.shadowRoot.querySelector('.size-selector');
+    if (sizeGroup) {
+      sizeGroup.addEventListener('keydown', (e) => this._handleSizeKeydown(e));
+    }
+
+    const sizeBtns = this.shadowRoot.querySelectorAll('.size-btn');
+    sizeBtns.forEach((btn) => {
+      btn.addEventListener('click', () => this._handleSizeChange(btn.dataset.size));
+    });
+
+    const notesToggle = this.shadowRoot.querySelector('.notes-toggle');
+    if (notesToggle) {
+      notesToggle.addEventListener('click', () => this._handleDetailsToggle());
+    }
+
+    const addBtn = this.shadowRoot.querySelector('.add-order-btn');
+    if (addBtn) {
+      addBtn.addEventListener('click', () => this._handleAddToOrder());
+    }
+
+    const detailsLink = this.shadowRoot.querySelector('.details-link');
+    if (detailsLink) {
+      detailsLink.addEventListener('click', (e) => this._handleOpenModal(e));
+    }
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
