+          color: var(--text, #3e2723);
+          margin-top: 48px;
+        }
+
+        * {
+          box-sizing: border-box;
+          margin: 0;
+          padding: 0;
+        }
+
+        .interactive-section {
+          display: grid;
+          grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+          gap: 28px;
+          background: #ffffff;
+          border-radius: 14px;
+          padding: 28px;
