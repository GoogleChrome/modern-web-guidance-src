+export class GrindMenuSection extends HTMLElement {
+  static observedAttributes = ['active-filter'];
+
+  #activeFilter = 'all';
+  #searchQuery = '';
+  #bagItems = 0;
+  #bagTotal = 0;
+
+  constructor() {
+    super();
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.append(menuSectionTemplate.content.cloneNode(true));
+    }
+    this.shadowRoot.adoptedStyleSheets = [menuSectionSheet];
+
+    const filterBtns = this.shadowRoot.querySelectorAll('.filter-btn');
+    filterBtns.forEach((btn) => {
+      btn.addEventListener('click', () => {
+        this.activeFilter = btn.dataset.filter || 'all';
+      });
+    });
+
+    const searchInput = this.shadowRoot.getElementById('search-input');
+    searchInput?.addEventListener('input', (e) => {
+      this.#searchQuery = e.target.value.trim().toLowerCase();
+      this.#applyFilters();
+    });
+
+    const clearBtn = this.shadowRoot.getElementById('clear-bag-btn');
+    clearBtn?.addEventListener('click', () => {
+      this.#bagItems = 0;
+      this.#bagTotal = 0;
+      this.#updateBagStatus();
+    });
+
+    const defaultSlot = this.shadowRoot.querySelector('slot:not([name])');
+    defaultSlot?.addEventListener('slotchange', () => {
+      this.#applyFilters();
+    });
+
+    this.addEventListener('coffee-order', (e) => {
+      this.#bagItems += 1;
+      this.#bagTotal += Number(e.detail?.unitPrice) || 0;
+      this.#updateBagStatus(e.detail?.name);
+    });
+
+    this.addEventListener('coffee-favorite', () => {
+      if (this.#activeFilter === 'favorites') {
+        this.#applyFilters();
+      }
+    });
+  }
+
+  connectedCallback() {
+    if (this.hasAttribute('active-filter')) {
+      this.#activeFilter = this.getAttribute('active-filter') || 'all';
+    }
+    this.#syncFilterButtons();
+    this.#applyFilters();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (name === 'active-filter' && oldVal !== newVal) {
+      this.#activeFilter = newVal || 'all';
+      this.#syncFilterButtons();
+      this.#applyFilters();
+    }
+  }
+
+  get activeFilter() {
+    return this.#activeFilter;
+  }
+  set activeFilter(val) {
+    this.setAttribute('active-filter', val);
+  }
+
+  #syncFilterButtons() {
+    const filterBtns = this.shadowRoot?.querySelectorAll('.filter-btn') ?? [];
+    filterBtns.forEach((btn) => {
+      const matches = btn.dataset.filter === this.#activeFilter;
+      btn.setAttribute('aria-pressed', String(matches));
+    });
+  }
+
+  #updateBagStatus(lastAddedName) {
+    const summaryEl = this.shadowRoot?.getElementById('order-summary-text');
+    const clearBtn = this.shadowRoot?.getElementById('clear-bag-btn');
+    if (summaryEl) {
+      const itemWord = this.#bagItems === 1 ? 'item' : 'items';
+      const prefix = lastAddedName ? `Added ${lastAddedName} · ` : '';
+      summaryEl.textContent = `${prefix}Bag: ${this.#bagItems} ${itemWord} ($${this.#bagTotal.toFixed(2)})`;
+    }
+    if (clearBtn) {
+      clearBtn.hidden = this.#bagItems === 0;
+    }
+  }
+
+  #applyFilters() {
+    const defaultSlot = this.shadowRoot?.querySelector('slot:not([name])');
+    const cards = (defaultSlot?.assignedElements?.() ?? []).filter(
+      (el) => el.tagName.toLowerCase() === 'coffee-card'
+    );
+
+    let visibleCount = 0;
+
+    cards.forEach((card) => {
+      const cat = (card.getAttribute('category') || '').toLowerCase();
+      const isFav = card.hasAttribute('favorited');
+      const textContent = `${card.getAttribute('name') || ''} ${card.getAttribute('roast') || ''} ${card.textContent || ''}`.toLowerCase();
+
+      const matchesCategory =
+        this.#activeFilter === 'all' ||
+        (this.#activeFilter === 'favorites' ? isFav : cat === this.#activeFilter);
+
+      const matchesSearch = !this.#searchQuery || textContent.includes(this.#searchQuery);
+
+      const shouldShow = matchesCategory && matchesSearch;
+      card.hidden = !shouldShow;
+      if (shouldShow) visibleCount += 1;
+    });
+
+    const emptyEl = this.shadowRoot?.getElementById('empty-state');
+    if (emptyEl) {
+      emptyEl.hidden = visibleCount > 0 || cards.length === 0;
+    }
+  }
+}
