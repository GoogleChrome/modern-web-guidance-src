+
+const coffeeCardTemplate = document.createElement('template');
+coffeeCardTemplate.innerHTML = `
+  <article part="card">
+    <div class="media" part="media">
+      <img id="card-img" src="" alt="" loading="lazy" />
+      <div class="badge-row">
+        <span class="badge" id="category-badge" part="badge">Seasonal</span>
+        <button type="button" class="fav-btn" id="fav-btn" part="favorite-button" aria-pressed="false" aria-label="Save to favorites">
+          <svg class="fav-icon" viewBox="0 0 24 24" aria-hidden="true">
+            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
+          </svg>
+        </button>
+      </div>
+    </div>
+
+    <div class="content" part="content">
+      <div class="header-line">
+        <div class="title-wrapper">
+          <slot name="title"><h3 id="fallback-title">Coffee Selection</h3></slot>
+        </div>
+        <span class="price" id="price-display" part="price">$4.50</span>
+      </div>
+
+      <div class="description">
+        <slot><p id="fallback-desc">Freshly roasted artisanal coffee.</p></slot>
+      </div>
+
+      <div class="meta-tags" id="meta-tags" aria-label="Coffee characteristics">
+        <span class="meta-pill" id="roast-pill">Medium Roast</span>
+        <span class="meta-pill" id="caffeine-pill">150mg Caffeine</span>
+      </div>
+
+      <div class="options-bar">
+        <label class="field">
+          <span>Size</span>
+          <select id="size-select" part="size-select" name="size">
+            <option value="small" data-delta="-0.50">Small (8 oz)</option>
+            <option value="medium" data-delta="0" selected>Medium (12 oz)</option>
+            <option value="large" data-delta="0.75">Large (16 oz)</option>
+          </select>
+        </label>
+        <label class="field">
+          <span>Milk</span>
+          <select id="milk-select" part="milk-select" name="milk">
+            <option value="Whole Milk">Whole Milk</option>
+            <option value="Oat Milk">Oat Milk</option>
+            <option value="Almond Milk">Almond Milk</option>
+            <option value="Black / None">Black / None</option>
+          </select>
+        </label>
+      </div>
+
+      <div class="actions" part="actions">
+        <button type="button" class="order-btn" id="order-btn" part="order-button">
+          <span id="order-btn-label">Add to Order</span>
+        </button>
+        <a href="/menu" class="details-link" id="details-link" part="details-link">View Details</a>
+      </div>
+
+      <div class="notes-section">
+        <button type="button" class="notes-toggle" id="notes-toggle" aria-expanded="false" aria-controls="notes-panel">
+          <span id="notes-toggle-text">+ Tasting &amp; Origin Notes</span>
+        </button>
+        <div class="notes-panel" id="notes-panel" role="region" aria-label="Tasting and origin notes" hidden>
+          <slot name="notes">
+            <p id="fallback-notes">Ethically sourced single-origin beans roasted in small batches.</p>
+          </slot>
+        </div>
+      </div>
+    </div>
+  </article>
+`;
+
+const SIZE_DELTAS = {
+  small: -0.5,
+  medium: 0,
+  large: 0.75,
+};
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = [
+    'name',
+    'price',
+    'category',
+    'roast',
+    'caffeine',
+    'image',
+    'href',
+    'notes',
+    'favorited',
+    'default-milk',
+    'disabled',
+  ];
+
+  #internals;
+  #orderCount = 0;
+  #size = 'medium';
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals ? this.attachInternals() : null;
+
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.append(coffeeCardTemplate.content.cloneNode(true));
+    }
+    this.shadowRoot.adoptedStyleSheets = [coffeeCardSheet];
+
+    // Hydrate / wire listeners once on shadow root construction
+    const favBtn = this.shadowRoot.getElementById('fav-btn');
+    const orderBtn = this.shadowRoot.getElementById('order-btn');
+    const sizeSelect = this.shadowRoot.getElementById('size-select');
+    const notesToggle = this.shadowRoot.getElementById('notes-toggle');
+    const titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+
+    favBtn?.addEventListener('click', () => {
+      this.favorited = !this.favorited;
+      this.dispatchEvent(
+        new CustomEvent('coffee-favorite', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            name: this.coffeeTitle,
+            favorited: this.favorited,
+          },
+        })
+      );
+    });
+
+    sizeSelect?.addEventListener('change', (e) => {
+      this.#size = e.target.value;
+      this.#updatePriceDisplay();
+    });
+
+    orderBtn?.addEventListener('click', () => {
+      this.#orderCount += 1;
+      this.#setCustomState('in-cart', true);
+      const milkSelect = this.shadowRoot.getElementById('milk-select');
+      const selectedSize = sizeSelect ? sizeSelect.value : 'medium';
+      const selectedMilk = milkSelect ? milkSelect.value : 'Oat Milk';
+      const computedPrice = this.computedPrice;
+
+      const labelEl = this.shadowRoot.getElementById('order-btn-label');
+      if (labelEl) {
+        labelEl.textContent = `Added (${this.#orderCount})`;
+      }
+
+      this.dispatchEvent(
+        new CustomEvent('coffee-order', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            name: this.coffeeTitle,
+            category: this.category,
+            size: selectedSize,
+            milk: selectedMilk,
+            unitPrice: computedPrice,
+            count: this.#orderCount,
+          },
+        })
+      );
+    });
+
+    notesToggle?.addEventListener('click', () => {
+      const panel = this.shadowRoot.getElementById('notes-panel');
+      if (!panel) return;
+      const isExpanded = notesToggle.getAttribute('aria-expanded') === 'true';
+      const nextState = !isExpanded;
+      notesToggle.setAttribute('aria-expanded', String(nextState));
+      panel.hidden = !nextState;
+      this.#setCustomState('expanded', nextState);
+      const textSpan = this.shadowRoot.getElementById('notes-toggle-text');
+      if (textSpan) {
+        textSpan.textContent = nextState ? '− Hide Tasting Notes' : '+ Tasting & Origin Notes';
+      }
+    });
+
+    titleSlot?.addEventListener('slotchange', () => {
+      this.#syncAccessibilityLabels();
+    });
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal) {
+      this.#render();
+    }
+  }
+
+  get name() {
+    return this.getAttribute('name') ?? '';
+  }
+  set name(val) {
+    val ? this.setAttribute('name', val) : this.removeAttribute('name');
+  }
+
+  get coffeeTitle() {
+    if (this.name) return this.name;
+    const titleSlot = this.shadowRoot?.querySelector('slot[name="title"]');
+    const assigned = titleSlot?.assignedElements?.() ?? [];
+    if (assigned.length > 0) {
+      return assigned[0].textContent.trim();
+    }
+    return 'Coffee Selection';
+  }
+
+  get price() {
+    return Number(this.getAttribute('price')) || 4.5;
+  }
+  set price(val) {
+    this.setAttribute('price', String(val));
+  }
+
+  get computedPrice() {
+    const delta = SIZE_DELTAS[this.#size] ?? 0;
+    return Math.max(0, this.price + delta);
+  }
+
+  get category() {
+    return this.getAttribute('category') ?? 'seasonal';
+  }
+  set category(val) {
+    val ? this.setAttribute('category', val) : this.removeAttribute('category');
+  }
+
+  get roast() {
+    return this.getAttribute('roast') ?? 'Medium Roast';
+  }
+  set roast(val) {
+    val ? this.setAttribute('roast', val) : this.removeAttribute('roast');
+  }
+
+  get caffeine() {
+    return this.getAttribute('caffeine') ?? '150mg Caffeine';
+  }
+  set caffeine(val) {
+    val ? this.setAttribute('caffeine', val) : this.removeAttribute('caffeine');
+  }
+
+  get image() {
+    return (
+      this.getAttribute('image') ??
+      'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=700&q=80'
+    );
+  }
+  set image(val) {
+    val ? this.setAttribute('image', val) : this.removeAttribute('image');
+  }
+
+  get href() {
+    return this.getAttribute('href') ?? '/menu';
+  }
+  set href(val) {
+    val ? this.setAttribute('href', val) : this.removeAttribute('href');
+  }
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+  set favorited(on) {
+    this.toggleAttribute('favorited', Boolean(on));
+  }
+
+  get disabled() {
+    return this.hasAttribute('disabled');
+  }
+  set disabled(on) {
+    this.toggleAttribute('disabled', Boolean(on));
+  }
+
+  #setCustomState(stateName, active) {
+    if (!this.#internals?.states) return;
+    if (active) {
+      this.#internals.states.add(stateName);
+    } else {
+      this.#internals.states.delete(stateName);
+    }
+  }
+
+  #updatePriceDisplay() {
+    const priceEl = this.shadowRoot?.getElementById('price-display');
+    if (priceEl) {
+      priceEl.textContent = `$${this.computedPrice.toFixed(2)}`;
+    }
+  }
+
+  #syncAccessibilityLabels() {
+    const title = this.coffeeTitle;
+    const favBtn = this.shadowRoot?.getElementById('fav-btn');
+    const detailsLink = this.shadowRoot?.getElementById('details-link');
+    const imgEl = this.shadowRoot?.getElementById('card-img');
+
+    if (favBtn) {
+      favBtn.setAttribute(
+        'aria-label',
+        this.favorited ? `Remove ${title} from favorites` : `Save ${title} to favorites`
+      );
+      favBtn.setAttribute('aria-pressed', String(this.favorited));
+    }
+    if (detailsLink) {
+      detailsLink.setAttribute('aria-label', `View details for ${title}`);
+    }
+    if (imgEl) {
+      imgEl.alt = `${title} served in a ceramic cup`;
+    }
+  }
+
+  #render() {
+    if (!this.shadowRoot) return;
+
+    const fallbackTitle = this.shadowRoot.getElementById('fallback-title');
+    if (fallbackTitle && this.name) {
+      fallbackTitle.textContent = this.name;
+    }
+
+    const badgeEl = this.shadowRoot.getElementById('category-badge');
+    if (badgeEl) {
+      badgeEl.textContent = this.category.replace('-', ' ');
+    }
+
+    const roastEl = this.shadowRoot.getElementById('roast-pill');
+    if (roastEl) {
+      roastEl.textContent = this.roast;
+    }
+
+    const caffeineEl = this.shadowRoot.getElementById('caffeine-pill');
+    if (caffeineEl) {
+      caffeineEl.textContent = this.caffeine;
+    }
+
+    const imgEl = this.shadowRoot.getElementById('card-img');
+    if (imgEl && imgEl.getAttribute('src') !== this.image) {
+      imgEl.src = this.image;
+    }
+
+    const detailsLink = this.shadowRoot.getElementById('details-link');
+    if (detailsLink) {
+      detailsLink.href = this.href;
+    }
+
+    const fallbackNotes = this.shadowRoot.getElementById('fallback-notes');
+    if (fallbackNotes && this.hasAttribute('notes')) {
+      fallbackNotes.textContent = this.getAttribute('notes');
+    }
+
+    const defaultMilk = this.getAttribute('default-milk');
+    const milkSelect = this.shadowRoot.getElementById('milk-select');
+    if (defaultMilk && milkSelect && !milkSelect.dataset.userTouched) {
+      milkSelect.value = defaultMilk;
+    }
+
+    this.#setCustomState('favorited', this.favorited);
+    this.#updatePriceDisplay();
+    this.#syncAccessibilityLabels();
+  }
+}
+
+// ============================================================================
+// 2. <grind-menu-section> — Interactive Filterable Menu & Order Summary Tray
+// ============================================================================
+
+const menuSectionSheet = new CSSStyleSheet();
+menuSectionSheet.replaceSync(`
+  :host {
+    display: block;
+    --_primary: var(--primary, #4e342e);
+    --_secondary: var(--secondary, #d7ccc8);
+    --_accent: var(--accent, #ffab40);
+    --_text: var(--text, #3e2723);
+  }
+
+  .section-header {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    text-align: center;
+    gap: 12px;
+    margin-bottom: 24px;
+  }
+
+  ::slotted([slot="heading"]) {
+    margin: 0;
+    color: var(--_primary);
+    font-size: 2rem;
+  }
+
+  .controls-bar {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: 16px;
+    width: 100%;
+    background: #ffffff;
