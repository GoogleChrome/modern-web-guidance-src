+  <script>
+    (function () {
+      const panel = document.getElementById('quick-order-panel');
+      const handle = document.getElementById('quick-order-handle');
+      const toggleBtn = document.getElementById('toggle-panel-btn');
+
+      // Progressive enhancement: attach drag affordances and keyboard accessibility when JS initializes
+      handle.classList.add('drag-handle');
+      handle.tabIndex = 0;
+      handle.setAttribute('aria-label', 'Drag Quick Order Cart panel. Use arrow keys to move.');
+
+      let offsetX = 0;
+      let offsetY = 0;
+      let startX = 0;
+      let startY = 0;
+      let isPositionCustom = false;
+
+      function ensureExplicitPosition() {
+        if (!isPositionCustom) {
+          const rect = panel.getBoundingClientRect();
+          panel.style.left = `${rect.left}px`;
+          panel.style.top = `${rect.top}px`;
+          panel.style.right = 'auto';
+          panel.style.bottom = 'auto';
+          isPositionCustom = true;
+        }
+      }
+
+      function moveTo(left, top) {
+        ensureExplicitPosition();
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+
+        panel.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        panel.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+      }
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0 || event.target.closest('button, input, select, textarea, a')) return;
+
+        ensureExplicitPosition();
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        const dist = Math.hypot(event.clientX - startX, event.clientY - startY);
+        if (dist >= 4 || handle.classList.contains('dragging')) {
+          handle.classList.add('dragging');
+          moveTo(event.clientX - offsetX, event.clientY - offsetY);
+        }
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        handle.classList.remove('dragging');
+      });
+
+      handle.addEventListener('keydown', (event) => {
+        if (event.target !== handle) return;
+        const step = 15;
+        const rect = panel.getBoundingClientRect();
+        let nextLeft = rect.left;
+        let nextTop = rect.top;
+
+        switch (event.key) {
+          case 'ArrowLeft':
+            nextLeft -= step;
+            break;
+          case 'ArrowRight':
+            nextLeft += step;
+            break;
+          case 'ArrowUp':
+            nextTop -= step;
+            break;
+          case 'ArrowDown':
+            nextTop += step;
+            break;
+          default:
+            return;
+        }
+
+        event.preventDefault();
+        moveTo(nextLeft, nextTop);
+      });
+
+      window.addEventListener('resize', () => {
+        if (isPositionCustom) {
+          const rect = panel.getBoundingClientRect();
+          moveTo(rect.left, rect.top);
+        }
+      });
+
+      // Minimize / expand toggle
+      toggleBtn.addEventListener('click', () => {
+        const minimized = panel.classList.toggle('is-minimized');
+        toggleBtn.setAttribute('aria-expanded', String(!minimized));
+        toggleBtn.textContent = minimized ? '+' : '−';
+        if (isPositionCustom) {
+          const rect = panel.getBoundingClientRect();
+          moveTo(rect.left, rect.top);
+        }
+      });
+
+      // Interactive Quick-Order & Coffee Cart state
+      const drinkSelect = document.getElementById('drink-select');
+      const milkSelect = document.getElementById('milk-select');
+      const sizeBtns = Array.from(document.querySelectorAll('.size-btn'));
+      const shotsDec = document.getElementById('shots-dec');
+      const shotsInc = document.getElementById('shots-inc');
+      const shotsVal = document.getElementById('shots-val');
+      const unitPriceEl = document.getElementById('item-unit-price');
+      const addToCartBtn = document.getElementById('add-to-cart-btn');
+      const cartListEl = document.getElementById('cart-items-list');
+      const cartTotalEl = document.getElementById('cart-total-price');
+      const cartBadgeEl = document.getElementById('cart-count-badge');
+      const checkoutBtn = document.getElementById('checkout-btn');
+      const checkoutStatus = document.getElementById('checkout-status');
+
+      let currentSize = 'Medium';
+      let currentSizeUpcharge = 0.75;
+      let extraShots = 0;
+
+      const cart = [
+        {
+          id: 1,
+          drink: 'Maple Oat Latte',
+          size: 'Medium',
+          milk: 'Oat Milk',
+          shots: 0,
+          unitPrice: 5.50,
+          qty: 1
+        }
+      ];
+      let nextId = 2;
+
+      function getCurrentConfiguredPrice() {
+        const selectedOption = drinkSelect.options[drinkSelect.selectedIndex];
+        const basePrice = parseFloat(selectedOption.dataset.price || '4.50');
+        return basePrice + currentSizeUpcharge + extraShots * 0.75;
+      }
+
+      function updateBuilderUI() {
+        const price = getCurrentConfiguredPrice();
+        unitPriceEl.textContent = `$${price.toFixed(2)}`;
+        addToCartBtn.textContent = `+ Add to Coffee Cart ($${price.toFixed(2)})`;
+        shotsVal.textContent = String(extraShots);
+      }
+
+      function renderCart() {
+        cartListEl.innerHTML = '';
+        let totalQty = 0;
+        let totalPrice = 0;
+
+        if (cart.length === 0) {
+          const emptyLi = document.createElement('li');
+          emptyLi.className = 'cart-item';
+          emptyLi.textContent = 'Your coffee cart is empty.';
+          cartListEl.appendChild(emptyLi);
+        } else {
+          cart.forEach((item) => {
+            totalQty += item.qty;
+            totalPrice += item.unitPrice * item.qty;
+
+            const li = document.createElement('li');
+            li.className = 'cart-item';
+
+            const info = document.createElement('div');
+            info.className = 'cart-item-info';
+
+            const name = document.createElement('div');
+            name.className = 'cart-item-name';
+            name.textContent = `${item.qty}x ${item.drink}`;
+
+            const meta = document.createElement('div');
+            meta.className = 'cart-item-meta';
+            const shotsText = item.shots > 0 ? `, +${item.shots} shot${item.shots > 1 ? 's' : ''}` : '';
+            meta.textContent = `${item.size}, ${item.milk}${shotsText} • $${(item.unitPrice * item.qty).toFixed(2)}`;
+
+            info.appendChild(name);
+            info.appendChild(meta);
+
+            const actions = document.createElement('div');
+            actions.className = 'cart-item-actions';
+
+            const decBtn = document.createElement('button');
+            decBtn.type = 'button';
+            decBtn.className = 'qty-mini-btn';
+            decBtn.textContent = '−';
+            decBtn.setAttribute('aria-label', `Decrease quantity of ${item.drink}`);
+            decBtn.addEventListener('click', () => {
+              item.qty -= 1;
+              if (item.qty <= 0) {
+                const idx = cart.findIndex((c) => c.id === item.id);
+                if (idx !== -1) cart.splice(idx, 1);
+              }
+              renderCart();
+            });
+
+            const incBtn = document.createElement('button');
+            incBtn.type = 'button';
+            incBtn.className = 'qty-mini-btn';
+            incBtn.textContent = '+';
+            incBtn.setAttribute('aria-label', `Increase quantity of ${item.drink}`);
+            incBtn.addEventListener('click', () => {
+              item.qty += 1;
+              renderCart();
+            });
+
+            actions.appendChild(decBtn);
+            actions.appendChild(incBtn);
+
+            li.appendChild(info);
+            li.appendChild(actions);
+            cartListEl.appendChild(li);
+          });
+        }
+
+        cartBadgeEl.textContent = String(totalQty);
+        cartTotalEl.textContent = `$${totalPrice.toFixed(2)}`;
+        if (isPositionCustom) {
+          const rect = panel.getBoundingClientRect();
+          moveTo(rect.left, rect.top);
+        }
+      }
+
+      drinkSelect.addEventListener('change', updateBuilderUI);
+
+      sizeBtns.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          sizeBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
+          btn.setAttribute('aria-pressed', 'true');
+          currentSize = btn.dataset.size || 'Medium';
+          currentSizeUpcharge = parseFloat(btn.dataset.upcharge || '0');
+          updateBuilderUI();
+        });
+      });
+
+      shotsDec.addEventListener('click', () => {
+        if (extraShots > 0) {
+          extraShots -= 1;
+          updateBuilderUI();
+        }
+      });
+
+      shotsInc.addEventListener('click', () => {
+        if (extraShots < 5) {
+          extraShots += 1;
+          updateBuilderUI();
+        }
+      });
+
+      function addDrinkToCart(drinkName, size, milk, shots, unitPrice) {
+        const existing = cart.find(
+          (item) =>
+            item.drink === drinkName &&
+            item.size === size &&
+            item.milk === milk &&
+            item.shots === shots
+        );
+        if (existing) {
+          existing.qty += 1;
+        } else {
+          cart.push({
+            id: nextId++,
+            drink: drinkName,
+            size,
+            milk,
+            shots,
+            unitPrice,
+            qty: 1
+          });
+        }
+        checkoutStatus.textContent = '';
+        renderCart();
+      }
+
+      addToCartBtn.addEventListener('click', () => {
+        addDrinkToCart(
+          drinkSelect.value,
+          currentSize,
+          milkSelect.value,
+          extraShots,
+          getCurrentConfiguredPrice()
+        );
+      });
+
+      document.querySelectorAll('.quick-add-card-btn').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const drinkName = btn.dataset.drink;
+          if (!drinkName) return;
