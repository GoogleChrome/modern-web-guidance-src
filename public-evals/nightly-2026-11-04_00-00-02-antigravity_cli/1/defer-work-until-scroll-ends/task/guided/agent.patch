+  <script>
+    const scroller = document.querySelector('#scroller');
+    const statusEl = document.querySelector('#status');
+    const originCards = Array.from(scroller.querySelectorAll('.origin-card'));
+    let isScrolling = false;
+
+    function findMostVisibleOrigin() {
+      const scrollerRect = scroller.getBoundingClientRect();
+      let bestOrigin = '';
+      let maxVisibleArea = -1;
+
+      for (const card of originCards) {
+        const cardRect = card.getBoundingClientRect();
+        const visibleTop = Math.max(scrollerRect.top, cardRect.top);
+        const visibleBottom = Math.min(scrollerRect.bottom, cardRect.bottom);
+        const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+        const visibleLeft = Math.max(scrollerRect.left, cardRect.left);
+        const visibleRight = Math.min(scrollerRect.right, cardRect.right);
+        const visibleWidth = Math.max(0, visibleRight - visibleLeft);
+        const visibleArea = visibleHeight * visibleWidth;
+
+        if (visibleArea > maxVisibleArea) {
+          maxVisibleArea = visibleArea;
+          bestOrigin = card.dataset.origin || card.querySelector('h3').textContent.trim();
+        }
+      }
+
+      return bestOrigin;
+    }
+
+    function initializeScroller() {
+      scroller.addEventListener('scroll', () => {
+        if (!isScrolling) {
+          isScrolling = true;
+          statusEl.textContent = 'Scrolling...';
+        }
+      }, { passive: true });
+
+      scroller.addEventListener('scrollend', () => {
+        isScrolling = false;
+        const visibleOrigin = findMostVisibleOrigin();
+        statusEl.textContent = `Scroll ended. Visible: ${visibleOrigin}`;
+      });
+    }
+
+    if ('onscrollend' in window) {
+      initializeScroller();
+    } else {
+      initializeScroller();
+      scroller.addEventListener('scroll', () => {
+        clearTimeout(window.scrollendtimer);
+        window.scrollendtimer = setTimeout(() => {
+          scroller.dispatchEvent(new CustomEvent('scrollend'));
+        }, 100);
+      }, { passive: true });
+    }
+  </script>
+
