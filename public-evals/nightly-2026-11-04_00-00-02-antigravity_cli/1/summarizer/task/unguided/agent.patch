+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const summaryBox = document.getElementById('journal-summary');
+    const summaryContent = document.getElementById('summary-content');
+    const journalTextEl = document.getElementById('journal-text');
+
+    function renderBulletsFromMarkdown(rawText) {
+      const lines = rawText
+        .split(/\r?\n/)
+        .map((line) => line.trim())
+        .filter(Boolean);
+
+      const ul = document.createElement('ul');
+      for (const line of lines) {
+        const cleaned = line.replace(/^([-*•]|\d+\.)\s+/, '').trim();
+        if (!cleaned) continue;
+        const li = document.createElement('li');
+        // Render basic **bold** markdown safely
+        const parts = cleaned.split(/(\*\*[^*]+\*\*)/g);
+        for (const part of parts) {
+          if (part.startsWith('**') && part.endsWith('**') && part.length > 4) {
+            const strong = document.createElement('strong');
+            strong.textContent = part.slice(2, -2);
+            li.appendChild(strong);
+          } else {
+            li.appendChild(document.createTextNode(part));
+          }
+        }
+        ul.appendChild(li);
+      }
+
+      summaryContent.innerHTML = '';
+      if (ul.children.length > 0) {
+        summaryContent.appendChild(ul);
+      } else {
+        const p = document.createElement('p');
+        p.textContent = rawText;
+        summaryContent.appendChild(p);
+      }
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      summaryBox.classList.add('visible');
+      summarizeBtn.disabled = true;
+      const originalBtnText = summarizeBtn.textContent;
+      summarizeBtn.textContent = 'Summarizing...';
+      summaryContent.innerHTML = '<p class="summary-status">Preparing browser AI summarizer...</p>';
+
+      try {
+        const sourceText = journalTextEl.innerText.trim();
+        const options = {
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          sharedContext: "An article from a coffee roaster's journal explaining their ethical bean sourcing, processing, and quality grading process.",
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const pct = Math.round((e.loaded || 0) * 100);
+              summaryContent.innerHTML = `<p class="summary-status">Downloading on-device AI model (${pct}%)...</p>`;
+            });
+          }
+        };
+
+        let summaryResult = '';
+
+        if ('Summarizer' in self) {
+          const availability = await Summarizer.availability();
+          if (availability === 'unavailable') {
+            throw new Error('The Summarizer API is unavailable on this device or browser.');
+          }
+          const summarizer = await Summarizer.create(options);
+          summaryContent.innerHTML = '<p class="summary-status">Generating key points...</p>';
+          summaryResult = await summarizer.summarize(sourceText, {
+            context: 'Summarize the coffee bean sourcing and roasting process into concise bullet points.'
+          });
+          if (typeof summarizer.destroy === 'function') {
+            summarizer.destroy();
+          }
+        } else if (self.ai && self.ai.summarizer) {
+          const capabilities = await self.ai.summarizer.capabilities();
+          if (capabilities && capabilities.available === 'no') {
+            throw new Error('The Summarizer API is unavailable on this device or browser.');
+          }
+          const summarizer = await self.ai.summarizer.create(options);
+          summaryContent.innerHTML = '<p class="summary-status">Generating key points...</p>';
+          summaryResult = await summarizer.summarize(sourceText);
+          if (typeof summarizer.destroy === 'function') {
+            summarizer.destroy();
+          }
+        } else {
+          throw new Error('Your browser does not support the built-in Summarizer AI API.');
+        }
+
+        renderBulletsFromMarkdown(summaryResult);
+        summarizeBtn.textContent = 'Summarize Again';
+      } catch (err) {
+        summaryContent.innerHTML = '';
+        const errorMsg = document.createElement('p');
+        errorMsg.className = 'summary-status';
+        errorMsg.textContent = err.message || 'Unable to generate summary with browser AI.';
+        summaryContent.appendChild(errorMsg);
+        summarizeBtn.textContent = originalBtnText;
+      } finally {
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
