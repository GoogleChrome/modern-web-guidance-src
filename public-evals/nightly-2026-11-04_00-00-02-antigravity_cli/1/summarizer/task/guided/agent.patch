+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const statusEl = document.getElementById('journal-status');
+    const summaryContainer = document.getElementById('journal-summary');
+    const summaryList = document.getElementById('journal-summary-list');
+    const journalArticle = document.getElementById('journal-article');
+
+    const summarizerOptions = {
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      sharedContext: 'An artisanal coffee roastery journal entry explaining their ethical bean sourcing and processing practices.'
+    };
+
+    function showStatus(message) {
+      statusEl.textContent = message;
+      statusEl.hidden = !message;
+    }
+
+    function renderSummaryBullets(summaryText) {
+      summaryList.replaceChildren();
+      const lines = summaryText
+        .split(/\r?\n/)
+        .map((line) => line.replace(/^[\s\-*•]+|\d+\.\s+/g, '').trim())
+        .filter(Boolean);
+
+      for (const line of lines) {
+        const li = document.createElement('li');
+        li.textContent = line;
+        summaryList.appendChild(li);
+      }
+
+      summaryContainer.hidden = lines.length === 0;
+    }
+
+    async function checkSummarizerSupport() {
+      if (!('Summarizer' in self)) {
+        summarizeBtn.disabled = true;
+        showStatus('Local AI summarization is currently unsupported in this browser.');
+        return;
+      }
+
+      try {
+        const availability = await Summarizer.availability(summarizerOptions);
+        if (availability === 'unavailable') {
+          summarizeBtn.disabled = true;
+          showStatus('Local AI summarization is unavailable on this device.');
+        }
+      } catch (err) {
+        summarizeBtn.disabled = true;
+        showStatus('Unable to verify local AI summarization support.');
+      }
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      if (!('Summarizer' in self)) {
+        summarizeBtn.disabled = true;
+        showStatus('Local AI summarization is currently unsupported in this browser.');
+        return;
+      }
+
+      summarizeBtn.disabled = true;
+      showStatus('Checking AI model availability...');
+
+      try {
+        const availability = await Summarizer.availability(summarizerOptions);
+        if (availability === 'unavailable') {
+          showStatus('Local AI summarization is unavailable on this device.');
+          return;
+        }
+
+        const summarizer = await Summarizer.create({
+          ...summarizerOptions,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              if (e.total) {
+                const percent = Math.round((e.loaded / e.total) * 100);
+                showStatus(`Downloading on-device AI model: ${percent}%`);
+              } else {
+                showStatus('Downloading on-device AI model...');
+              }
+            });
+          }
+        });
+
+        showStatus('Summarizing journal entry...');
+        const summary = await summarizer.summarize(journalArticle.innerText, {
+          context: 'Summarize the coffee bean sourcing process into a few concise bullet points for customers.'
+        });
+
+        renderSummaryBullets(summary);
+        showStatus('');
+        summarizeBtn.textContent = 'Summarize Again';
+        summarizeBtn.disabled = false;
+      } catch (error) {
+        showStatus(`Could not generate summary: ${error.message || 'Unknown error'}`);
+        summarizeBtn.disabled = false;
+      }
+    });
+
+    checkSummarizerSupport();
+  </script>
+
