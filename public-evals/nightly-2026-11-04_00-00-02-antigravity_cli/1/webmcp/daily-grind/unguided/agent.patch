+  <script>
+    (function () {
+      const SEASONAL_FAVORITES_MENU = [
+        {
+          id: 'maple-oat-latte',
+          name: 'Maple Oat Latte',
+          category: 'seasonal',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          price: 5.50,
+          calories: 210,
+          caffeineMg: 150,
+          sizes: ['Small', 'Medium', 'Large'],
+          defaultMilk: 'Oat',
+          availableMilks: ['Oat', 'Whole', 'Almond', 'Soy'],
+          tags: ['seasonal', 'sweet', 'oat-milk', 'vegan-friendly', 'hot-or-iced'],
+          inStock: true
+        },
+        {
+          id: 'dark-roast-espresso',
+          name: 'Dark Roast Espresso',
+          category: 'espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          price: 3.75,
+          calories: 15,
+          caffeineMg: 185,
+          sizes: ['Small', 'Medium', 'Large'],
+          defaultMilk: 'None',
+          availableMilks: ['None', 'Oat', 'Whole', 'Almond'],
+          tags: ['espresso', 'bold', 'smokey', 'dark-roast', 'hot'],
+          inStock: true
+        },
+        {
+          id: 'cold-brew',
+          name: 'Cold Brew',
+          category: 'cold-brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          price: 4.75,
+          calories: 10,
+          caffeineMg: 200,
+          sizes: ['Small', 'Medium', 'Large'],
+          defaultMilk: 'None',
+          availableMilks: ['None', 'Oat', 'Whole', 'Almond', 'Sweet Cream'],
+          tags: ['cold-brew', 'iced', 'smooth', 'high-caffeine'],
+          inStock: true
+        }
+      ];
+
+      const orders = [];
+
+      function findDrink(identifier) {
+        if (!identifier) return null;
+        const norm = String(identifier).trim().toLowerCase();
+        return (
+          SEASONAL_FAVORITES_MENU.find(
+            (item) =>
+              item.id.toLowerCase() === norm ||
+              item.name.toLowerCase() === norm ||
+              item.category.toLowerCase() === norm
+          ) ||
+          SEASONAL_FAVORITES_MENU.find(
+            (item) =>
+              item.name.toLowerCase().includes(norm) ||
+              item.id.toLowerCase().includes(norm) ||
+              item.description.toLowerCase().includes(norm)
+          ) ||
+          null
+        );
+      }
+
+      function querySeasonalMenu(params = {}) {
+        const query = params.query || params.search || params.drink || params.name || '';
+        const category = params.category || '';
+        const maxPrice = typeof params.maxPrice === 'number' ? params.maxPrice : null;
+
+        let results = SEASONAL_FAVORITES_MENU.slice();
+
+        if (query) {
+          const q = String(query).toLowerCase().trim();
+          results = results.filter(
+            (item) =>
+              item.name.toLowerCase().includes(q) ||
+              item.id.toLowerCase().includes(q) ||
+              item.description.toLowerCase().includes(q) ||
+              item.tags.some((t) => t.toLowerCase().includes(q))
+          );
+        }
+
+        if (category) {
+          const c = String(category).toLowerCase().trim();
+          results = results.filter(
+            (item) =>
+              item.category.toLowerCase().includes(c) ||
+              item.tags.some((t) => t.toLowerCase().includes(c))
+          );
+        }
+
+        if (maxPrice !== null) {
+          results = results.filter((item) => item.price <= maxPrice);
+        }
+
+        return {
+          section: 'Seasonal Favorites',
+          count: results.length,
+          items: results
+        };
+      }
+
+      function highlightDrinkCard(drinkIdentifier) {
+        const matched = findDrink(drinkIdentifier);
+        const cards = document.querySelectorAll('#menu-grid .card');
+        cards.forEach((card) => {
+          if (matched && card.getAttribute('data-drink-id') === matched.id) {
+            card.classList.add('highlighted');
+          } else {
+            card.classList.remove('highlighted');
+          }
+        });
+        return matched;
+      }
+
+      function showDrinkDetails(drinkIdentifier) {
+        const matched = highlightDrinkCard(drinkIdentifier) || SEASONAL_FAVORITES_MENU[0];
+        const panel = document.getElementById('drink-details-panel');
+        if (panel && matched) {
+          panel.innerHTML =
+            '<strong>' + matched.name + '</strong> ($' + matched.price.toFixed(2) + ') &mdash; ' +
+            matched.description + '<br>' +
+            '<small>Calories: ' + matched.calories + ' kcal | Caffeine: ' + matched.caffeineMg + 'mg | ' +
+            'Available Sizes: ' + matched.sizes.join(', ') + ' | Milks: ' + matched.availableMilks.join(', ') + '</small>';
+          panel.classList.add('active');
+        }
+        return {
+          success: Boolean(matched),
+          drink: matched
+        };
+      }
+
+      function renderOrdersUI(latestOrder, statusMessage) {
+        const countEl = document.getElementById('cart-count');
+        const totalEl = document.getElementById('order-total');
+        const listEl = document.getElementById('cart-items');
+        const bannerEl = document.getElementById('order-status-banner');
+
+        const totalQty = orders.reduce((sum, o) => sum + o.quantity, 0);
+        const totalPrice = orders.reduce((sum, o) => sum + o.totalPrice, 0);
+
+        if (countEl) countEl.textContent = String(totalQty);
+        if (totalEl) totalEl.textContent = '$' + totalPrice.toFixed(2);
+
+        if (listEl) {
+          listEl.innerHTML = '';
+          if (orders.length === 0) {
+            const emptyLi = document.createElement('li');
+            emptyLi.className = 'cart-item';
+            emptyLi.textContent = 'No drinks ordered yet.';
+            listEl.appendChild(emptyLi);
+          } else {
+            orders.forEach((o) => {
+              const li = document.createElement('li');
+              li.className = 'cart-item';
+              const milkText = o.milk && o.milk !== 'None' ? ' (' + o.milk + ' milk)' : '';
+              const customerText = o.customerName ? ' for ' + o.customerName : '';
+              li.innerHTML =
+                '<span><strong>' + o.quantity + 'x ' + o.size + ' ' + o.drink + '</strong>' +
+                milkText + customerText + '</span>' +
+                '<span>$' + o.totalPrice.toFixed(2) + '</span>';
+              listEl.appendChild(li);
+            });
+          }
+        }
+
+        if (bannerEl && statusMessage) {
+          bannerEl.textContent = statusMessage;
+          bannerEl.classList.add('active');
+        }
+      }
+
+      function orderDrink(params = {}) {
+        const drinkInput = params.drink || params.drinkName || params.name || params.id || 'Maple Oat Latte';
+        const matched = findDrink(drinkInput) || SEASONAL_FAVORITES_MENU[0];
+        const size = params.size || 'Medium';
+        const milk = params.milk || matched.defaultMilk || 'None';
+        const quantity = Math.max(1, parseInt(params.quantity || 1, 10) || 1);
+        const customerName = params.customerName || params.customer || params.notes || '';
+
+        const sizeUpcharge = String(size).toLowerCase() === 'large' ? 0.75 : 0;
+        const unitPrice = matched.price + sizeUpcharge;
+        const totalPrice = Number((unitPrice * quantity).toFixed(2));
+
+        const orderRecord = {
+          orderId: 'DG-' + (1000 + orders.length + 1),
+          drinkId: matched.id,
+          drink: matched.name,
+          size: size,
+          milk: milk,
+          quantity: quantity,
+          unitPrice: unitPrice,
+          totalPrice: totalPrice,
+          customerName: customerName,
+          status: 'confirmed',
+          timestamp: new Date().toISOString()
+        };
+
+        orders.push(orderRecord);
+
+        // Sync form inputs and visual card state
+        const drinkSelect = document.getElementById('order-drink');
+        const sizeSelect = document.getElementById('order-size');
+        const milkSelect = document.getElementById('order-milk');
+        const qtyInput = document.getElementById('order-quantity');
+        const custInput = document.getElementById('order-customer');
+
+        if (drinkSelect) drinkSelect.value = matched.name;
+        if (sizeSelect && ['Small', 'Medium', 'Large'].includes(size)) sizeSelect.value = size;
+        if (milkSelect && ['Oat', 'Whole', 'Almond', 'None'].includes(milk)) milkSelect.value = milk;
+        if (qtyInput) qtyInput.value = String(quantity);
+        if (custInput && customerName) custInput.value = customerName;
+
+        highlightDrinkCard(matched.id);
+        showDrinkDetails(matched.id);
+
+        const message =
+          'Order ' + orderRecord.orderId + ' confirmed: ' +
+          quantity + 'x ' + size + ' ' + matched.name +
+          (milk && milk !== 'None' ? ' with ' + milk + ' milk' : '') +
+          ' ($' + totalPrice.toFixed(2) + ').';
+
+        renderOrdersUI(orderRecord, message);
+
+        return {
+          success: true,
+          message: message,
+          order: orderRecord,
+          cartTotalItems: orders.reduce((s, o) => s + o.quantity, 0),
+          cartTotalPrice: Number(orders.reduce((s, o) => s + o.totalPrice, 0).toFixed(2))
+        };
+      }
+
+      function updatePageUI(params = {}) {
+        const action = params.action || 'highlight';
+        const drink = params.drink || params.drinkName || params.target || '';
+        const filterQuery = params.filter || params.query || '';
+        const bannerMessage = params.message || params.statusMessage || '';
+
+        let matched = null;
+        if (drink) {
+          matched = showDrinkDetails(drink).drink;
+        }
+
+        if (filterQuery !== undefined && params.action === 'filter') {
+          const q = String(filterQuery).toLowerCase().trim();
+          const cards = document.querySelectorAll('#menu-grid .card');
+          cards.forEach((card) => {
+            const id = card.getAttribute('data-drink-id') || '';
+            const item = findDrink(id);
+            const isMatch =
+              !q ||
+              (item &&
+                (item.name.toLowerCase().includes(q) ||
+                  item.description.toLowerCase().includes(q) ||
+                  item.tags.some((t) => t.toLowerCase().includes(q))));
+            card.style.display = isMatch ? '' : 'none';
+          });
+        } else if (action === 'reset') {
+          const cards = document.querySelectorAll('#menu-grid .card');
+          cards.forEach((card) => {
+            card.style.display = '';
+            card.classList.remove('highlighted');
+          });
+          const panel = document.getElementById('drink-details-panel');
+          if (panel) panel.classList.remove('active');
+        }
+
+        if (bannerMessage) {
+          const bannerEl = document.getElementById('order-status-banner');
+          if (bannerEl) {
+            bannerEl.textContent = bannerMessage;
+            bannerEl.classList.add('active');
+          }
+        }
+
+        return {
+          success: true,
+          action: action,
+          highlightedDrink: matched ? matched.name : null,
+          message: bannerMessage || (matched ? 'Updated UI for ' + matched.name : 'UI updated successfully')
+        };
+      }
+
+      // Bind form submit event
+      const orderForm = document.getElementById('drink-order-form');
+      if (orderForm) {
+        orderForm.addEventListener('submit', function (e) {
+          e.preventDefault();
+          const formData = new FormData(orderForm);
+          orderDrink({
+            drink: formData.get('drink'),
+            size: formData.get('size'),
+            milk: formData.get('milk'),
+            quantity: Number(formData.get('quantity') || 1),
+            customerName: formData.get('customerName') || ''
+          });
+        });
+      }
+
+      // Format response payload compatible with WebMCP / MCP tool responses as well as direct inspection
+      function formatToolResponse(data) {
