+
+      const clientTools = [
+        {
+          name: 'get_seasonal_favorites_menu',
+          description: 'Query the "Seasonal Favorites" coffee menu on The Daily Grind homepage, including drink names, descriptions, prices, sizes, milk options, and dietary tags.',
+          inputSchema: {
+            type: 'object',
