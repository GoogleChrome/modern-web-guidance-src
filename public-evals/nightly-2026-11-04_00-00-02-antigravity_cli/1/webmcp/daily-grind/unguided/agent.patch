+              },
+              size: {
+                type: 'string',
+                enum: ['Small', 'Medium', 'Large'],
+                description: 'Drink size (Small, Medium, or Large).'
+              },
+              milk: {
+                type: 'string',
+                description: 'Milk preference (e.g., "Oat", "Whole", "Almond", "None").'
+              },
+              quantity: {
+                type: 'number',
+                description: 'Number of drinks to order (default: 1).'
+              },
+              customerName: {
+                type: 'string',
+                description: 'Optional customer name or order notes.'
+              }
+            },
+            required: ['drink']
+          },
+          execute: async (params = {}) => formatToolResponse(orderDrink(params))
+        },
