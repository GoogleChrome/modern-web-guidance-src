+  <script type="module">
+    const SEASONAL_MENU = [
+      {
+        id: "maple-oat-latte",
+        name: "Maple Oat Latte",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        tastingNotes: "Warm amber maple, toasted oats, and velvety espresso crema.",
+        basePrice: 5.75,
+        calories: 190,
+        caffeineMg: 150,
+        dairyFreeDefault: true,
+        defaultMilk: "oat",
+        availableSizes: ["small", "medium", "large"],
+        url: "/menu/seasonal",
+      },
+      {
+        id: "dark-roast-espresso",
+        name: "Dark Roast Espresso",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        tastingNotes: "Dark cocoa, roasted cedar, and a rich caramelized finish.",
+        basePrice: 3.75,
+        calories: 15,
+        caffeineMg: 185,
+        dairyFreeDefault: true,
+        defaultMilk: "none",
+        availableSizes: ["small", "medium", "large"],
+        url: "/menu/espresso",
+      },
+      {
+        id: "cold-brew",
+        name: "Cold Brew",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        tastingNotes: "Sweet molasses, smooth chocolate, and low-acidity cold extraction.",
+        basePrice: 4.75,
+        calories: 10,
+        caffeineMg: 205,
+        dairyFreeDefault: true,
+        defaultMilk: "none",
+        availableSizes: ["small", "medium", "large"],
+        url: "/menu/cold-brew",
+      },
+    ];
+
+    const DRINK_NAMES = SEASONAL_MENU.map((item) => item.name);
+    const DRINK_SIZES = ["small", "medium", "large"];
+    const MILK_OPTIONS = ["oat", "whole", "almond", "none"];
+    const SIZE_UPCHARGE = { small: -0.5, medium: 0, large: 0.75 };
+
+    const orderState = {
+      items: [],
+      confirmed: false,
+      highlightedDrinkId: null,
+    };
+
+    const statusBanner = document.getElementById("agent-status-banner");
+    const statusText = document.getElementById("agent-status-text");
+    const spotlightContent = document.getElementById("spotlight-content");
+    const orderItemsList = document.getElementById("order-items-list");
+    const orderTotalDisplay = document.getElementById("order-total-display");
+    const confirmationBox = document.getElementById("order-confirmation-box");
+    const confirmationStatus = document.getElementById("order-confirmation-status");
+    const filterForm = document.getElementById("menu-filter-form");
+    const orderForm = document.getElementById("drink-order-form");
+
+    function showStatusBanner(message) {
+      if (!statusBanner || !statusText) return;
+      statusText.textContent = message;
+      statusBanner.hidden = false;
+    }
+
+    function findMenuItem(drinkName) {
+      if (typeof drinkName !== "string" || !drinkName.trim()) return null;
+      const normalized = drinkName.trim().toLowerCase();
+      return (
+        SEASONAL_MENU.find(
+          (item) =>
+            item.name.toLowerCase() === normalized ||
+            item.id.toLowerCase() === normalized
+        ) || null
+      );
+    }
+
+    function applyMenuFilter({ query = "", dietary = "all" } = {}) {
+      const normalizedQuery = typeof query === "string" ? query.trim().toLowerCase() : "";
+      const matchedItems = SEASONAL_MENU.filter((item) => {
+        const matchesQuery =
+          !normalizedQuery ||
+          item.name.toLowerCase().includes(normalizedQuery) ||
+          item.description.toLowerCase().includes(normalizedQuery) ||
+          item.tastingNotes.toLowerCase().includes(normalizedQuery);
+        const matchesDietary =
+          dietary !== "dairy-free" || item.dairyFreeDefault === true;
+        return matchesQuery && matchesDietary;
+      });
+
+      const matchedIds = new Set(matchedItems.map((item) => item.id));
+      document.querySelectorAll("#seasonal-grid .card").forEach((card) => {
+        const id = card.getAttribute("data-drink-id");
+        card.hidden = !matchedIds.has(id);
+      });
+
+      const queryInput = document.getElementById("filter-query");
+      const dietarySelect = document.getElementById("filter-dietary");
+      if (queryInput && queryInput.value !== query) queryInput.value = query;
+      if (dietarySelect && dietarySelect.value !== dietary) dietarySelect.value = dietary;
+
+      showStatusBanner(
+        `Showing ${matchedItems.length} of ${SEASONAL_MENU.length} Seasonal Favorites.`
+      );
+
+      return matchedItems;
+    }
+
+    function highlightDrinkOnPage(item) {
+      orderState.highlightedDrinkId = item.id;
+      document.querySelectorAll("#seasonal-grid .card").forEach((card) => {
+        const isMatch = card.getAttribute("data-drink-id") === item.id;
+        card.classList.toggle("is-highlighted", isMatch);
+        if (isMatch) {
+          card.hidden = false;
+        }
+      });
+
+      if (spotlightContent) {
+        spotlightContent.innerHTML = `
+          <strong>${item.name}</strong> ($${item.basePrice.toFixed(2)})<br>
+          <span>${item.description}</span><br>
+          <em>Tasting Notes:</em> ${item.tastingNotes}<br>
+          <small>Nutrition: ${item.calories} calories &bull; ${item.caffeineMg}mg caffeine &bull; Default milk: ${item.defaultMilk}</small>
+        `;
+      }
+
+      const drinkSelect = document.getElementById("order-drink");
+      if (drinkSelect) {
+        drinkSelect.value = item.name;
+      }
+
+      showStatusBanner(`Highlighted "${item.name}" in Seasonal Favorites.`);
+    }
+
+    function renderOrderSummary() {
+      if (!orderItemsList || !orderTotalDisplay || !confirmationBox) return;
+
+      orderItemsList.innerHTML = "";
+      if (orderState.items.length === 0) {
+        const emptyLi = document.createElement("li");
+        emptyLi.id = "empty-order-msg";
+        emptyLi.textContent = "No drinks staged yet.";
+        orderItemsList.appendChild(emptyLi);
+        orderTotalDisplay.textContent = "Total: $0.00";
+        confirmationBox.hidden = true;
+      } else {
+        let total = 0;
+        orderState.items.forEach((entry) => {
+          total += entry.lineTotal;
+          const li = document.createElement("li");
+          const labelSpan = document.createElement("span");
+          labelSpan.textContent = `${entry.quantity}x ${entry.drinkName} (${entry.size}, ${entry.milk} milk)`;
+          const priceSpan = document.createElement("strong");
+          priceSpan.textContent = `$${entry.lineTotal.toFixed(2)}`;
+          li.append(labelSpan, priceSpan);
+          orderItemsList.appendChild(li);
+        });
+        orderTotalDisplay.textContent = `Total: $${total.toFixed(2)}`;
+        confirmationBox.hidden = false;
+        confirmationStatus.textContent = orderState.confirmed
+          ? "Order confirmed for in-store pickup!"
+          : "Review staged drinks and confirm your order.";
+      }
+
+      // Update per-card quantity badges
+      document.querySelectorAll("#seasonal-grid .card").forEach((card) => {
+        const id = card.getAttribute("data-drink-id");
+        const badge = card.querySelector('[data-role="badge"]');
+        if (!badge) return;
+        const count = orderState.items
+          .filter((entry) => entry.drinkId === id)
+          .reduce((sum, entry) => sum + entry.quantity, 0);
+        if (count > 0) {
+          badge.textContent = `${count} in order`;
+          badge.hidden = false;
+        } else {
+          badge.hidden = true;
+        }
+      });
+    }
+
+    function stageDrinkOrder({
+      drinkName,
+      size = "medium",
+      milk = "oat",
+      quantity = 1,
+    } = {}) {
+      const item = findMenuItem(drinkName);
+      if (!item) {
+        return {
+          error: `Menu item "${drinkName ?? ""}" not found in Seasonal Favorites.`,
+          availableDrinks: DRINK_NAMES,
+        };
+      }
+
+      const normalizedSize = typeof size === "string" ? size.toLowerCase() : "";
+      if (!DRINK_SIZES.includes(normalizedSize)) {
+        return {
+          error: `Unsupported cup size "${size}".`,
+          supportedSizes: DRINK_SIZES,
+        };
+      }
+
+      const normalizedMilk = typeof milk === "string" ? milk.toLowerCase() : "";
+      if (!MILK_OPTIONS.includes(normalizedMilk)) {
+        return {
+          error: `Unsupported milk option "${milk}".`,
+          supportedMilks: MILK_OPTIONS,
+        };
+      }
+
+      const parsedQuantity = Number(quantity);
+      if (!Number.isInteger(parsedQuantity) || parsedQuantity < 1 || parsedQuantity > 10) {
+        return {
+          error: "Quantity must be a whole number of cups between 1 and 10.",
+        };
+      }
+
+      const unitPrice = Number((item.basePrice + SIZE_UPCHARGE[normalizedSize]).toFixed(2));
+      const lineTotal = Number((unitPrice * parsedQuantity).toFixed(2));
+
+      const orderEntry = {
+        orderItemId: `item-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
+        drinkId: item.id,
+        drinkName: item.name,
+        size: normalizedSize,
+        milk: normalizedMilk,
+        quantity: parsedQuantity,
+        unitPrice,
+        lineTotal,
+      };
+
+      orderState.items.push(orderEntry);
+      orderState.confirmed = false;
+
+      highlightDrinkOnPage(item);
+      renderOrderSummary();
+      showStatusBanner(
+        `Staged ${parsedQuantity}x ${normalizedSize} ${item.name} (${normalizedMilk} milk) — $${lineTotal.toFixed(2)}.`
+      );
+
+      const orderTotal = Number(
+        orderState.items.reduce((sum, entry) => sum + entry.lineTotal, 0).toFixed(2)
+      );
+
+      return {
+        status: "staged_for_confirmation",
+        addedItem: orderEntry,
+        orderItemCount: orderState.items.reduce((sum, entry) => sum + entry.quantity, 0),
+        orderTotal,
+      };
+    }
+
+    // Wire up interactive card buttons and confirmation actions
+    document.querySelectorAll('[data-action="details"]').forEach((link) => {
+      link.addEventListener("click", (event) => {
+        event.preventDefault();
+        const item = findMenuItem(link.getAttribute("data-drink"));
+        if (item) highlightDrinkOnPage(item);
+      });
+    });
+
+    document.querySelectorAll('[data-action="quick-order"]').forEach((button) => {
+      button.addEventListener("click", () => {
+        const drinkName = button.getAttribute("data-drink");
+        const item = findMenuItem(drinkName);
+        stageDrinkOrder({
+          drinkName,
+          size: "medium",
+          milk: item ? item.defaultMilk : "oat",
+          quantity: 1,
+        });
+      });
+    });
+
+    document.getElementById("confirm-order-btn")?.addEventListener("click", () => {
+      if (orderState.items.length === 0) return;
+      orderState.confirmed = true;
+      renderOrderSummary();
+      showStatusBanner("Your Seasonal Favorites order is confirmed for pickup!");
+    });
+
+    document.getElementById("clear-order-btn")?.addEventListener("click", () => {
+      orderState.items = [];
+      orderState.confirmed = false;
+      renderOrderSummary();
+      showStatusBanner("Cleared staged drink order.");
+    });
+
+    // Declarative WebMCP form handlers
+    filterForm?.addEventListener("submit", (event) => {
+      event.preventDefault();
+      const formData = new FormData(filterForm);
+      const query = String(formData.get("query") ?? "");
+      const dietary = String(formData.get("dietary") ?? "all");
+      const matched = applyMenuFilter({ query, dietary });
+
+      if (event.agentInvoked && typeof event.respondWith === "function") {
+        event.respondWith(
+          Promise.resolve({
+            matchedCount: matched.length,
+            items: matched,
+          })
+        );
+      }
+    });
+
+    orderForm?.addEventListener("submit", (event) => {
+      event.preventDefault();
+      const formData = new FormData(orderForm);
+      const result = stageDrinkOrder({
+        drinkName: String(formData.get("drinkName") ?? ""),
+        size: String(formData.get("size") ?? "medium"),
+        milk: String(formData.get("milk") ?? "oat"),
+        quantity: Number(formData.get("quantity") ?? 1),
+      });
+
+      if (event.agentInvoked && typeof event.respondWith === "function") {
+        if (result.error) {
+          event.respondWith(Promise.resolve(`Validation failed: ${result.error}`));
+          return;
+        }
+        event.respondWith(Promise.resolve(result));
+      }
+    });
+
+    // WebMCP Lifecycle Events (supporting both document.modelContext in Chrome 156+ and window fallback)
+    const targetFor = (type, listener, options) =>
+      (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+        .addEventListener(type, listener, options);
+
+    targetFor("toolactivated", ({ toolName }) => {
+      showStatusBanner(`Browser AI agent is invoking tool "${toolName}"...`);
+    });
+
+    targetFor("toolcancel", ({ toolName }) => {
+      showStatusBanner(`Browser AI agent cancelled tool "${toolName}".`);
+    });
+
+    // WebMCP Imperative API Registration
+    if ("modelContext" in document) {
+      const toolsController = new AbortController();
+      const { signal } = toolsController;
+
+      window.addEventListener(
+        "pagehide",
+        () => {
+          toolsController.abort();
+        },
+        { once: true }
+      );
+
+      async function registerHomepageTools() {
+        await document.modelContext.registerTool(
+          {
+            name: "get_seasonal_favorites",
+            description:
+              "Queries the Seasonal Favorites coffee menu and returns beverage details, pricing, and nutrition information. Use when the user asks what seasonal drinks are available or searches the menu by flavor or dietary preference.",
+            inputSchema: {
+              type: "object",
+              properties: {
+                query: {
+                  type: "string",
+                  default: "",
+                  description: "Keyword to match against beverage names, descriptions, or tasting notes.",
+                },
+                dairyFreeOnly: {
+                  type: "boolean",
+                  default: false,
+                  description: "Whether to restrict results to beverages that are dairy-free by default.",
+                },
+              },
+            },
+            execute({ query = "", dairyFreeOnly = false } = {}) {
+              if (typeof query !== "string" || typeof dairyFreeOnly !== "boolean") {
+                return {
+                  error: "Provide valid search text and dietary filter criteria.",
+                  availableDrinks: DRINK_NAMES,
+                };
+              }
+
+              const normalizedQuery = query.trim().toLowerCase();
+              const items = SEASONAL_MENU.filter((item) => {
+                const matchesQuery =
+                  !normalizedQuery ||
+                  item.name.toLowerCase().includes(normalizedQuery) ||
+                  item.description.toLowerCase().includes(normalizedQuery) ||
+                  item.tastingNotes.toLowerCase().includes(normalizedQuery);
+                const matchesDietary = !dairyFreeOnly || item.dairyFreeDefault;
+                return matchesQuery && matchesDietary;
+              });
+
+              return {
+                items,
+                totalCount: items.length,
+              };
+            },
+            annotations: {
+              readOnlyHint: true,
+              untrustedContentHint: false,
+            },
+          },
+          { signal }
+        );
+
+        await document.modelContext.registerTool(
+          {
+            name: "highlight_seasonal_drink",
+            description:
+              "Highlights a beverage card in the Seasonal Favorites grid and displays its tasting notes and nutrition breakdown on the page. Use when the user wants to inspect or focus on a specific drink on the homepage.",
+            inputSchema: {
+              type: "object",
+              properties: {
+                drinkName: {
+                  type: "string",
+                  enum: DRINK_NAMES,
+                  description: "Name of the seasonal beverage to highlight on the page.",
+                },
+              },
+              required: ["drinkName"],
+            },
+            execute({ drinkName } = {}) {
+              const item = findMenuItem(drinkName);
+              if (!item) {
+                return {
+                  error: `Menu item "${drinkName ?? ""}" not found.`,
+                  availableItems: DRINK_NAMES,
+                };
+              }
+
+              highlightDrinkOnPage(item);
+              return {
+                highlightedDrink: item,
+                spotlightUpdated: true,
+              };
+            },
+            annotations: {
+              readOnlyHint: false,
+              consequentialHint: false,
+              untrustedContentHint: false,
+            },
+          },
+          { signal }
+        );
+
+        await document.modelContext.registerTool(
+          {
+            name: "order_seasonal_drink",
+            description:
+              "Stages an interactive drink order for a Seasonal Favorites beverage and updates the live order summary on the homepage. Use when the user wants to order a drink or add customized coffee beverages to their pickup order.",
+            inputSchema: {
+              type: "object",
+              properties: {
+                drinkName: {
+                  type: "string",
+                  enum: DRINK_NAMES,
+                  description: "Seasonal beverage to prepare for the customer.",
+                },
+                size: {
+                  type: "string",
+                  enum: DRINK_SIZES,
+                  default: "medium",
+                  description: "Cup volume choice for the drink.",
+                },
+                milk: {
+                  type: "string",
+                  enum: MILK_OPTIONS,
+                  default: "oat",
+                  description: "Milk or plant-based creamer selection.",
+                },
+                quantity: {
+                  type: "number",
+                  minimum: 1,
+                  maximum: 10,
+                  default: 1,
+                  description: "Number of cups to prepare.",
+                },
+              },
+              required: ["drinkName"],
+            },
+            execute({ drinkName, size = "medium", milk = "oat", quantity = 1 } = {}) {
+              return stageDrinkOrder({ drinkName, size, milk, quantity });
+            },
+            annotations: {
+              readOnlyHint: false,
+              consequentialHint: true,
+              untrustedContentHint: false,
+            },
+          },
+          { signal }
+        );
+      }
+
+      registerHomepageTools();
+    }
+  </script>
 </body>
 
 </html>
