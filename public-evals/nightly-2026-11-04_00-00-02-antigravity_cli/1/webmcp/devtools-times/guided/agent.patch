+++ b/src/components/ArticleUtilities.tsx
@@ -0,0 +1,390 @@
+import React, { useState } from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+import type { ArticleSummary } from '../utils/webmcp';
+
+export interface CurrentArticleInfo {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+}
+
+interface Props {
+  article?: CurrentArticleInfo;
+  relatedArticles?: ArticleSummary[];
+}
+
+const SHARE_CHANNELS = ['copy_link', 'email', 'x', 'facebook'] as const;
+type ShareChannel = (typeof SHARE_CHANNELS)[number];
+
+const GET_CURRENT_ARTICLE_SCHEMA = {
+  type: 'object',
+  properties: {},
+} as const;
+
+const CALCULATE_READING_TIME_SCHEMA = {
+  type: 'object',
+  properties: {
+    wordsPerMinute: {
+      type: 'number',
+      default: 200,
+      minimum: 50,
+      maximum: 1000,
+      description: 'Reading pace in words per minute.',
+    },
+  },
+} as const;
+
+const HIGHLIGHT_ARTICLE_SCHEMA = {
+  type: 'object',
+  properties: {
+    phrase: {
+      type: 'string',
+      description: 'Term or phrase to locate within the article text.',
+    },
+  },
+  required: ['phrase'],
+} as const;
+
+const GET_POPULARITY_SCHEMA = {
+  type: 'object',
+  properties: {
+    slug: {
+      type: 'string',
+      description: 'Identifier of the article to inspect, e.g., super-bowl-lx.',
+    },
+  },
+} as const;
+
+const SHARE_ARTICLE_SCHEMA = {
+  type: 'object',
+  properties: {
+    channel: {
+      type: 'string',
+      enum: SHARE_CHANNELS,
+      default: 'copy_link',
+      description: 'Destination channel for sharing the article.',
+    },
+  },
+} as const;
+
+const READ_ONLY_ANNOTATIONS = { readOnlyHint: true } as const;
+const UI_MUTATION_ANNOTATIONS = {
+  readOnlyHint: false,
+  consequentialHint: false,
+  untrustedContentHint: false,
+} as const;
+
+export default function ArticleUtilities({ article, relatedArticles = [] }: Props) {
+  const [estimatedMinutes, setEstimatedMinutes] = useState<number | null>(
+    article?.readingTime ?? null
+  );
+  const [shareFeedback, setShareFeedback] = useState<string | null>(null);
+  const [highlightCount, setHighlightCount] = useState<number | null>(null);
+  const [popularityInfo, setPopularityInfo] = useState<{
+    views: number;
+    trending: boolean;
+  } | null>(null);
+  const [isLoadingPopularity, setIsLoadingPopularity] = useState(false);
+
+  const hasArticle = Boolean(article?.slug);
+
+  useWebMCP<Record<string, never>>({
+    name: 'get_current_article',
+    description:
+      'Extracts the full text, section headings, metadata, and related stories for the article currently open on the page. Use when the user asks questions about the current article or wants a summary of its contents.',
+    inputSchema: GET_CURRENT_ARTICLE_SCHEMA,
+    enabled: hasArticle,
+    execute: () => {
+      if (!article) {
+        return { error: 'No article is currently open on this page.' };
+      }
+
+      const proseContainer = document.querySelector('article .prose');
+      const bodyText = proseContainer?.textContent?.trim() ?? '';
+      const headings = proseContainer
+        ? Array.from(proseContainer.querySelectorAll('h1, h2, h3, h4'))
+            .map((el) => el.textContent?.trim() ?? '')
+            .filter(Boolean)
+        : [];
+      const words = bodyText ? bodyText.split(/\s+/).filter(Boolean).length : 0;
+
+      return {
+        slug: article.slug,
+        title: article.title,
+        summary: article.summary,
+        author: article.author,
+        date: article.date,
+        category: article.category,
+        readingTime: article.readingTime ?? Math.max(1, Math.ceil(words / 200)),
+        wordCount: words,
+        headings,
+        content: bodyText,
+        relatedArticles: relatedArticles.map((rel) => ({
+          slug: rel.slug,
+          title: rel.title,
+          summary: rel.summary,
+          url: `${import.meta.env.BASE_URL}articles/${rel.slug}`,
+        })),
+      };
+    },
+    annotations: READ_ONLY_ANNOTATIONS,
+  });
+
+  useWebMCP<{ wordsPerMinute?: number }>({
+    name: 'calculate_reading_time',
+    description:
+      'Calculates the word count and estimated reading duration for the current article based on reading speed. Use when the user asks how long the article takes to read at their preferred pace.',
+    inputSchema: CALCULATE_READING_TIME_SCHEMA,
+    enabled: hasArticle,
+    execute: (input) => {
+      if (!article) {
+        return { error: 'No article is currently open on this page.' };
+      }
+
+      const { wordsPerMinute = 200 } = input ?? {};
+      if (
+        typeof wordsPerMinute !== 'number' ||
+        !Number.isFinite(wordsPerMinute) ||
+        wordsPerMinute < 50 ||
+        wordsPerMinute > 1000
+      ) {
+        return {
+          error: 'Pass a valid reading speed in words per minute.',
+        };
+      }
+
+      const proseContainer = document.querySelector('article .prose');
+      const bodyText = proseContainer?.textContent?.trim() ?? article.summary;
+      const wordCount = bodyText ? bodyText.split(/\s+/).filter(Boolean).length : 0;
+      const minutes = Math.max(1, Math.ceil(wordCount / wordsPerMinute));
+
+      setEstimatedMinutes(minutes);
+
+      return {
+        slug: article.slug,
+        title: article.title,
+        wordCount,
+        wordsPerMinute,
+        estimatedMinutes: minutes,
+      };
+    },
+    annotations: READ_ONLY_ANNOTATIONS,
+  });
+
+  useWebMCP<{ phrase?: string }>({
+    name: 'highlight_article_matches',
+    description:
+      'Finds and highlights matching passages within the current article body on the page. Use when the user wants to locate specific terms, quotes, or sections inside the article.',
+    inputSchema: HIGHLIGHT_ARTICLE_SCHEMA,
+    enabled: hasArticle,
+    execute: (input) => {
+      if (!article) {
+        return { error: 'No article is currently open on this page.' };
+      }
+
+      const phrase = typeof input?.phrase === 'string' ? input.phrase.trim() : '';
+      if (!phrase) {
+        return { error: 'Pass a non-empty term or phrase to locate in the article.' };
+      }
+
+      const proseContainer = document.querySelector('article .prose');
+      if (!proseContainer) {
+        return { error: 'Article content container is not available.' };
+      }
+
+      const normalized = phrase.toLowerCase();
+      const blocks = Array.from(
+        proseContainer.querySelectorAll<HTMLElement>('p, li, h2, h3, h4, blockquote')
+      );
+      const matchingPassages: string[] = [];
+      let firstMatch: HTMLElement | null = null;
+
+      blocks.forEach((block) => {
+        const text = block.textContent?.trim() ?? '';
+        if (text.toLowerCase().includes(normalized)) {
+          block.classList.add('bg-amber-100', 'ring-2', 'ring-amber-400', 'rounded', 'px-1');
+          matchingPassages.push(text);
+          if (!firstMatch) {
+            firstMatch = block;
+          }
+        } else {
+          block.classList.remove('bg-amber-100', 'ring-2', 'ring-amber-400', 'rounded', 'px-1');
+        }
+      });
+
+      if (firstMatch) {
+        (firstMatch as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'center' });
+      }
+
+      setHighlightCount(matchingPassages.length);
+
+      return {
+        slug: article.slug,
+        phrase,
+        matchCount: matchingPassages.length,
+        matchingPassages,
+      };
+    },
+    annotations: UI_MUTATION_ANNOTATIONS,
+  });
+
+  useWebMCP<{ slug?: string }>({
+    name: 'get_article_popularity',
+    description:
+      'Fetches live view count and trending status metrics for an article. Use when the user asks how popular an article is or whether it is trending.',
+    inputSchema: GET_POPULARITY_SCHEMA,
+    execute: async (input, { signal }) => {
+      const targetSlug =
+        (typeof input?.slug === 'string' ? input.slug.trim() : '') || article?.slug || '';
+      if (!targetSlug) {
+        return { error: 'Pass an article identifier to check popularity.' };
+      }
+
+      setIsLoadingPopularity(true);
+      try {
+        const response = await fetch(
+          `${import.meta.env.BASE_URL}api/article-popularity?id=${encodeURIComponent(targetSlug)}`,
+          { signal }
+        );
+        if (!response.ok) {
+          setIsLoadingPopularity(false);
+          return { error: `Request failed with status ${response.status}` };
+        }
+        const data = await response.json();
+        const result = {
+          slug: targetSlug,
+          views: Number(data.views ?? 0),
+          trending: Boolean(data.trending),
+        };
+        setPopularityInfo({ views: result.views, trending: result.trending });
+        setIsLoadingPopularity(false);
+        return result;
+      } catch (err) {
+        setIsLoadingPopularity(false);
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+    annotations: READ_ONLY_ANNOTATIONS,
+  });
+
+  useWebMCP<{ channel?: ShareChannel }>({
+    name: 'share_article',
+    description:
+      'Generates a shareable link or social share URL for the current article and copies the link when requested. Use when the user wants to share or copy the link to the article.',
+    inputSchema: SHARE_ARTICLE_SCHEMA,
+    enabled: hasArticle,
+    execute: async (input) => {
+      if (!article) {
+        return { error: 'No article is currently open on this page.' };
+      }
+
+      const { channel = 'copy_link' } = input ?? {};
+      if (!SHARE_CHANNELS.includes(channel as ShareChannel)) {
+        return {
+          error: 'Pass a supported sharing channel.',
+          channels: SHARE_CHANNELS,
+        };
+      }
+
+      const articleUrl =
+        typeof window !== 'undefined'
+          ? new URL(`${import.meta.env.BASE_URL}articles/${article.slug}`, window.location.origin)
+              .href
+          : `${import.meta.env.BASE_URL}articles/${article.slug}`;
+
+      let shareUrl = articleUrl;
+      if (channel === 'email') {
+        shareUrl = `mailto:?subject=${encodeURIComponent(article.title)}&body=${encodeURIComponent(
+          `${article.summary}\n\n${articleUrl}`
+        )}`;
+      } else if (channel === 'x') {
+        shareUrl = `https://x.com/intent/tweet?text=${encodeURIComponent(
+          article.title
+        )}&url=${encodeURIComponent(articleUrl)}`;
+      } else if (channel === 'facebook') {
+        shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(
+          articleUrl
+        )}`;
+      } else if (channel === 'copy_link') {
+        if (typeof navigator !== 'undefined' && navigator.clipboard?.writeText) {
+          try {
+            await navigator.clipboard.writeText(articleUrl);
+          } catch {
+            // Ignore clipboard permission errors in non-interactive contexts
+          }
+        }
+      }
+
+      setShareFeedback(channel === 'copy_link' ? 'Link copied!' : `Shared via ${channel}`);
+
+      return {
+        slug: article.slug,
+        title: article.title,
+        channel,
+        shareUrl,
+      };
+    },
+    annotations: READ_ONLY_ANNOTATIONS,
+  });
+
+  if (!hasArticle) {
+    return null;
+  }
+
+  const handleCopyLink = async () => {
+    if (!article) return;
+    const articleUrl = new URL(
+      `${import.meta.env.BASE_URL}articles/${article.slug}`,
+      window.location.origin
+    ).href;
+    if (navigator.clipboard?.writeText) {
+      try {
+        await navigator.clipboard.writeText(articleUrl);
+      } catch {
+        // Ignore clipboard errors
+      }
+    }
+    setShareFeedback('Link copied!');
+  };
+
+  return (
+    <div className="flex flex-wrap items-center gap-3 text-xs text-gray-600">
+      {estimatedMinutes !== null && (
+        <span className="px-2 py-1 bg-gray-100 rounded-md font-medium">
+          {estimatedMinutes} min read
+        </span>
+      )}
+      <button
+        type="button"
+        onClick={handleCopyLink}
+        className="px-2 py-1 bg-gray-100 hover:bg-gray-200 rounded-md font-medium transition-colors"
+      >
+        Copy link
+      </button>
+      {shareFeedback && (
+        <span role="status" aria-live="polite" className="text-amber-700 font-medium">
+          {shareFeedback}
+        </span>
+      )}
+      {highlightCount !== null && (
+        <span role="status" aria-live="polite" className="text-amber-700 font-medium">
+          {highlightCount} {highlightCount === 1 ? 'match' : 'matches'} highlighted
+        </span>
+      )}
+      {isLoadingPopularity && <span className="text-gray-400">Checking popularity…</span>}
+      {popularityInfo && (
+        <span className="px-2 py-1 bg-amber-50 text-amber-800 rounded-md font-medium">
+          {popularityInfo.views.toLocaleString()} views
+          {popularityInfo.trending ? ' • Trending' : ''}
+        </span>
+      )}
+    </div>
+  );
+}
