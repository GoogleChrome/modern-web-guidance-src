@@ -0,0 +1,263 @@
+import React, { useEffect } from 'react';
+import { registerBrowserTool, formatToolResult } from '../utils/webmcp';
+
+interface ArticleMetadata {
+  slug: string;
+  title: string;
+  summary: string;
+  author?: string;
+  category?: string;
+  date?: string;
+  readingTime?: number;
+  tags?: string[];
+  image?: string;
+}
+
+interface Props {
+  article?: ArticleMetadata;
+}
+
+export default function ArticleTools({ article }: Props) {
+  useEffect(() => {
+    const cleanups: Array<() => void> = [];
+
+    // 1. list_articles: Discover and filter articles across The DevTools Times
+    cleanups.push(
+      registerBrowserTool({
+        name: 'list_articles',
+        title: 'List Articles',
+        description:
+          'List published articles across The DevTools Times, optionally filtered by category, author, or tag.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            category: {
+              type: 'string',
+              description: 'Optional category name to filter articles by (case-insensitive).',
+            },
+            tag: {
+              type: 'string',
+              description: 'Optional tag to filter articles by (case-insensitive).',
+            },
+            limit: {
+              type: 'number',
+              description: 'Optional maximum number of articles to return.',
+            },
+          },
+        },
+        annotations: {
+          readOnlyHint: true,
+        },
+        execute: async (input?: { category?: string; tag?: string; limit?: number }) => {
+          const res = await fetch(`${import.meta.env.BASE_URL}api/articles.json`);
+          const allArticles: ArticleMetadata[] = await res.json();
+          let filtered = allArticles;
+
+          if (input?.category) {
+            const cat = input.category.trim().toLowerCase();
+            filtered = filtered.filter(a => (a.category || '').toLowerCase() === cat);
+          }
+
+          if (input?.tag) {
+            const tag = input.tag.trim().toLowerCase();
+            filtered = filtered.filter(a =>
+              Array.isArray(a.tags) && a.tags.some(t => t.toLowerCase().includes(tag))
+            );
+          }
+
+          if (typeof input?.limit === 'number' && input.limit > 0) {
+            filtered = filtered.slice(0, input.limit);
+          }
+
+          return formatToolResult({
+            count: filtered.length,
+            articles: filtered.map(a => ({
+              slug: a.slug,
+              title: a.title,
+              summary: a.summary,
+              author: a.author,
+              category: a.category,
+              readingTime: a.readingTime,
+              url: `${import.meta.env.BASE_URL}articles/${a.slug}`,
+            })),
+          });
+        },
+      })
+    );
+
+    // 2. get_article_details: Extract current article content & metadata or look up an article by slug
+    cleanups.push(
+      registerBrowserTool({
+        name: 'get_article_details',
+        title: 'Get Article Details',
+        description:
+          'Extract the full text content, metadata, word count, and reading time of the currently viewed article, or look up an article by slug.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            slug: {
+              type: 'string',
+              description:
+                'Optional slug of a specific article to look up. If omitted on an article page, returns the full details and body text of the current article.',
+            },
+          },
+        },
+        annotations: {
+          readOnlyHint: true,
+        },
+        execute: async (input?: { slug?: string }) => {
+          const requestedSlug = input?.slug?.trim();
+          const currentSlug = article?.slug;
+
+          // If on the matching article page (or no slug passed while on an article page), extract live DOM + metadata
+          const proseEl = document.querySelector('article .prose');
+          const headlineEl = document.querySelector('article h1');
+
+          if ((!requestedSlug || requestedSlug === currentSlug) && (article || proseEl || headlineEl)) {
+            const bodyText = proseEl ? (proseEl as HTMLElement).innerText.trim() : '';
+            const words = bodyText ? bodyText.split(/\s+/).filter(Boolean).length : 0;
+            const estimatedMinutes = Math.max(1, Math.ceil(words / 200));
+
+            const rlRes = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`);
+            const rlData = await rlRes.json();
+            const readingList: string[] = rlData.readingList || [];
+            const activeSlug = currentSlug || window.location.pathname.split('/').filter(Boolean).pop() || '';
+
+            return formatToolResult({
+              slug: activeSlug,
+              title: article?.title || headlineEl?.textContent?.trim() || document.title,
+              summary: article?.summary || '',
+              author: article?.author || '',
+              category: article?.category || '',
+              date: article?.date || '',
+              readingTimeMinutes: article?.readingTime || estimatedMinutes,
+              wordCount: words,
+              bookmarked: readingList.includes(activeSlug),
+              content: bodyText,
+              url: window.location.href,
+            });
+          }
+
+          // Otherwise look up in articles.json
+          const res = await fetch(`${import.meta.env.BASE_URL}api/articles.json`);
+          const allArticles: ArticleMetadata[] = await res.json();
+          const found = requestedSlug
+            ? allArticles.find(
+                a =>
+                  a.slug.toLowerCase() === requestedSlug.toLowerCase() ||
+                  a.title.toLowerCase().includes(requestedSlug.toLowerCase())
+              )
+            : allArticles[0];
+
+          if (!found) {
+            return formatToolResult(
+              { error: `Article not found for "${requestedSlug || ''}".` },
+              true
+            );
+          }
+
+          return formatToolResult({
+            ...found,
+            url: `${import.meta.env.BASE_URL}articles/${found.slug}`,
+          });
+        },
+      })
+    );
+
+    // 3. toggle_article_bookmark: Toggle bookmark status for the current article or a specified slug
+    cleanups.push(
+      registerBrowserTool({
+        name: 'toggle_article_bookmark',
+        title: 'Toggle Article Bookmark',
+        description:
+          'Bookmark or unbookmark the current article (or a specified article slug) in the reading list.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            slug: {
+              type: 'string',
+              description:
+                'Optional article slug to bookmark/unbookmark. Defaults to the currently viewed article slug.',
+            },
+          },
+        },
+        execute: async (input?: { slug?: string }) => {
+          const targetSlug =
+            input?.slug?.trim() ||
+            article?.slug ||
+            document.querySelector('[data-bookmark-slug]')?.getAttribute('data-bookmark-slug') ||
+            '';
+
+          if (!targetSlug) {
+            return formatToolResult(
+              { error: 'No article slug provided and no active article found on this page.' },
+              true
+            );
+          }
+
+          const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ slug: targetSlug }),
+          });
+          const data = await response.json();
+          const readingList: string[] = data.readingList || [];
+          window.dispatchEvent(
+            new CustomEvent('devtools-times:reading-list-updated', {
+              detail: { readingList },
+            })
+          );
+
+          return formatToolResult({
+            status: 'success',
+            slug: targetSlug,
+            bookmarked: readingList.includes(targetSlug),
+            readingList,
+          });
+        },
+      })
+    );
+
+    // 4. get_article_popularity: Client-side utility to fetch popularity metrics for an article
+    cleanups.push(
+      registerBrowserTool({
+        name: 'get_article_popularity',
+        title: 'Get Article Popularity',
+        description:
+          'Fetch client-side popularity metrics (view count and trending status) for the current article or a specified article ID.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            id: {
+              type: 'string',
+              description:
+                'Optional article slug/ID to query popularity for. Defaults to the current article slug.',
+            },
+          },
+        },
+        annotations: {
+          readOnlyHint: true,
+        },
+        execute: async (input?: { id?: string }) => {
+          const targetId =
+            input?.id?.trim() ||
+            article?.slug ||
+            window.location.pathname.split('/').filter(Boolean).pop() ||
+            'super-bowl-lx';
+
+          const response = await fetch(
+            `${import.meta.env.BASE_URL}api/article-popularity?id=${encodeURIComponent(targetId)}`
+          );
+          const data = await response.json();
+          return formatToolResult(data, !response.ok);
+        },
+      })
+    );
+
+    return () => {
+      cleanups.forEach(fn => fn());
+    };
+  }, [article]);
+
+  return null;
+}
