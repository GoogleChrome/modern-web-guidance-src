index 0000000..22763bd
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,70 @@
+import type { ModelContext, ModelContextTool } from '../global';
+
+export function getModelContext(): ModelContext | undefined {
+  if (typeof window === 'undefined') return undefined;
+  return document.modelContext || navigator.modelContext;
+}
+
+export function formatToolResult(data: any, isError = false) {
+  const text = typeof data === 'string' ? data : JSON.stringify(data, null, 2);
+  return {
+    content: [
+      {
+        type: 'text',
+        text,
+      },
+    ],
+    ...(isError ? { isError: true } : {}),
+  };
+}
+
+const registeredTools = new Map<string, AbortController>();
+
+export function registerBrowserTool(tool: ModelContextTool): () => void {
+  const mc = getModelContext();
+  if (!mc || typeof mc.registerTool !== 'function') {
+    return () => {};
+  }
+
+  // If already registered with an AbortController, clean up previous registration first
+  const existingController = registeredTools.get(tool.name);
+  if (existingController) {
+    existingController.abort();
+    registeredTools.delete(tool.name);
+  }
+  if (typeof mc.unregisterTool === 'function') {
+    try {
+      mc.unregisterTool(tool.name);
+    } catch {
+      // Ignore if tool wasn't previously registered
+    }
+  }
+
+  const controller = new AbortController();
+  registeredTools.set(tool.name, controller);
+
+  try {
+    mc.registerTool(tool, { signal: controller.signal });
+  } catch {
+    try {
+      mc.registerTool(tool);
+    } catch (err) {
+      console.warn(`Failed to register WebMCP tool "${tool.name}":`, err);
+    }
+  }
+
+  return () => {
+    controller.abort();
+    if (registeredTools.get(tool.name) === controller) {
+      registeredTools.delete(tool.name);
+    }
+    const currentMc = getModelContext();
+    if (currentMc && typeof currentMc.unregisterTool === 'function') {
+      try {
+        currentMc.unregisterTool(tool.name);
+      } catch {
+        // Ignore
+      }
+    }
+  };
+}
