+  <script type="module">
+    const CALENDARS = [
+      {
+        id: 'islamic-umalqura',
+        locale: 'en-u-ca-islamic-umalqura',
+        formatOptions: { day: 'numeric', month: 'long', year: 'numeric', era: 'long' }
+      },
+      {
+        id: 'hebrew',
+        locale: 'en-u-ca-hebrew',
+        formatOptions: { day: 'numeric', month: 'long', year: 'numeric', era: 'long' }
+      },
+      {
+        id: 'japanese',
+        locale: 'en-u-ca-japanese',
+        formatOptions: { day: 'numeric', month: 'long', year: 'numeric', era: 'long' }
+      }
+    ];
+
+    function isCalendarSupported(calendarId) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(calendarId);
+      } catch {
+        return false;
+      }
+    }
+
+    function renderCalendars(isoDateString) {
+      let selectedIsoDate;
+      try {
+        selectedIsoDate = isoDateString
+          ? Temporal.PlainDate.from(isoDateString)
+          : Temporal.Now.plainDateISO();
+      } catch {
+        selectedIsoDate = Temporal.Now.plainDateISO();
+      }
+
+      const todayIso = Temporal.Now.plainDateISO();
+
+      for (const config of CALENDARS) {
+        const { id: calendarId, locale, formatOptions } = config;
+        const supported = isCalendarSupported(calendarId);
+
+        const targetDate = supported
+          ? selectedIsoDate.withCalendar(calendarId)
+          : selectedIsoDate;
+
+        const todayInCalendar = supported
+          ? todayIso.withCalendar(calendarId)
+          : todayIso;
+
+        const activeCalendarId = targetDate.calendarId ?? targetDate.calendar?.id ?? (supported ? calendarId : 'iso8601');
+        if (activeCalendarId !== calendarId) {
+          console.warn(`Calendar ${calendarId} not supported; falling back to ISO 8601`);
+        }
+
+        // 1. Formatted localized date (with era names)
+        const localizedDisplay = targetDate.toLocaleString(locale, formatOptions);
+
+        // 2 & 3. Converted year, numeric month, unique stable monthCode, and monthsInYear
+        const { year, month, monthCode, monthsInYear } = targetDate;
+
+        // 4. Calendar-aware timeline comparison against current date
+        const comparison = Temporal.PlainDate.compare(targetDate, todayInCalendar);
+        const relativeTimeline = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+
+        // Update card DOM elements
+        const card = document.querySelector(`[data-calendar="${calendarId}"]`);
+        if (!card) continue;
+
+        const formattedEl = card.querySelector('[data-field="formatted-date"]');
+        if (formattedEl) formattedEl.textContent = localizedDisplay;
+
+        const yearEl = card.querySelector('[data-field="year"]');
+        if (yearEl) yearEl.textContent = String(year);
+
+        const monthEl = card.querySelector('[data-field="month"]');
+        if (monthEl) monthEl.textContent = String(month);
+
+        const monthCodeEl = card.querySelector('[data-field="monthCode"]');
+        if (monthCodeEl) monthCodeEl.textContent = monthCode;
+
+        const monthsInYearEl = card.querySelector('[data-field="monthsInYear"]');
+        if (monthsInYearEl) monthsInYearEl.textContent = String(monthsInYear);
+
+        const timelineEl = card.querySelector('[data-field="timeline"]');
+        if (timelineEl) {
+          timelineEl.textContent = relativeTimeline;
+          timelineEl.className = `timeline-badge timeline-${relativeTimeline}`;
+        }
+
+        // 5. Month breakdown iterating 1..monthsInYear without assuming fixed 12 months or fixed days
+        const breakdownList = card.querySelector('[data-field="breakdown"]');
+        if (breakdownList) {
+          breakdownList.replaceChildren();
+          const firstDayOfYear = targetDate.with({ day: 1 });
+          for (let m = 1; m <= targetDate.monthsInYear; m++) {
+            const monthDate = firstDayOfYear.with({ month: m });
+            const li = document.createElement('li');
+            li.className = 'month-item' + (monthDate.monthCode === targetDate.monthCode ? ' active-month' : '');
+
+            const codeSpan = document.createElement('span');
+            codeSpan.className = 'month-code';
+            codeSpan.textContent = monthDate.monthCode;
+
+            const daysSpan = document.createElement('span');
+            daysSpan.className = 'month-days';
+            daysSpan.textContent = `${monthDate.daysInMonth} days`;
+
+            li.append(codeSpan, daysSpan);
+            breakdownList.appendChild(li);
+          }
+        }
+      }
+    }
+
+    function initializeApp() {
+      const dateInput = document.getElementById('calendar-date-input');
+      if (!dateInput) return;
+
+      const todayIso = Temporal.Now.plainDateISO();
+      if (!dateInput.value) {
+        dateInput.value = todayIso.toString();
+      }
+
+      renderCalendars(dateInput.value);
+
+      dateInput.addEventListener('input', (event) => {
+        if (event.target.value) {
+          renderCalendars(event.target.value);
+        }
+      });
+
+      dateInput.addEventListener('change', (event) => {
+        if (event.target.value) {
+          renderCalendars(event.target.value);
+        }
+      });
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
