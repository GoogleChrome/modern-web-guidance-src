+  <script type="module">
+    if (typeof globalThis.Temporal === 'undefined') {
+      const { Temporal } = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = Temporal;
+    }
+
+    const CALENDARS = [
+      { id: 'islamic-umalqura', cardId: 'card-islamic-umalqura', dateElId: 'islamic-date' },
+      { id: 'hebrew', cardId: 'card-hebrew', dateElId: 'hebrew-date' },
+      { id: 'japanese', cardId: 'card-japanese', dateElId: 'japanese-date' }
+    ];
+
+    const dateInput = document.getElementById('calendar-date-input');
+
+    function getTimelineLabel(selectedIsoDate, currentIsoDate) {
+      const comparison = Temporal.PlainDate.compare(selectedIsoDate, currentIsoDate);
+      if (comparison < 0) return 'Past';
+      if (comparison > 0) return 'Future';
+      return 'Today';
+    }
+
+    function buildMonthBreakdown(convertedDate) {
+      const totalMonths = convertedDate.monthsInYear;
+      const months = [];
+      for (let m = 1; m <= totalMonths; m++) {
+        const monthStart = convertedDate.with({ month: m, day: 1 });
+        months.push({
+          month: monthStart.month,
+          monthCode: monthStart.monthCode,
+          daysInMonth: monthStart.daysInMonth
+        });
+      }
+      return months;
+    }
+
+    function renderCalendars(isoDateString) {
+      if (!isoDateString) return;
+
+      let selectedIsoDate;
+      try {
+        selectedIsoDate = Temporal.PlainDate.from(isoDateString);
+      } catch {
+        return;
+      }
+
+      const todayIsoDate = Temporal.Now.plainDateISO();
+      const timelineLabel = getTimelineLabel(selectedIsoDate, todayIsoDate);
+
+      for (const calConfig of CALENDARS) {
+        const card = document.getElementById(calConfig.cardId);
+        if (!card) continue;
+
+        const convertedDate = selectedIsoDate.withCalendar(calConfig.id);
+
+        const formattedDate = convertedDate.toLocaleString('en-US', {
+          calendar: calConfig.id,
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric',
+          era: 'long'
+        });
+
+        const formattedDateEl = document.getElementById(calConfig.dateElId);
+        if (formattedDateEl) {
+          formattedDateEl.textContent = formattedDate;
+        }
+
+        const timelineEl = card.querySelector('[data-field="timeline"]');
+        if (timelineEl) {
+          timelineEl.textContent = timelineLabel;
+          timelineEl.dataset.timeline = timelineLabel;
+        }
+
+        const yearEl = card.querySelector('[data-field="year"]');
+        if (yearEl) {
+          yearEl.textContent = String(convertedDate.year);
+        }
+
+        const monthEl = card.querySelector('[data-field="month"]');
+        if (monthEl) {
+          monthEl.textContent = String(convertedDate.month);
+        }
+
+        const monthCodeEl = card.querySelector('[data-field="month-code"]');
+        if (monthCodeEl) {
+          monthCodeEl.textContent = convertedDate.monthCode;
+        }
+
+        const monthsInYearEl = card.querySelector('[data-field="months-in-year"]');
+        if (monthsInYearEl) {
+          monthsInYearEl.textContent = String(convertedDate.monthsInYear);
+        }
+
+        const breakdownEl = card.querySelector('[data-field="month-breakdown"]');
+        if (breakdownEl) {
+          const months = buildMonthBreakdown(convertedDate);
+          breakdownEl.innerHTML = '';
+          for (const item of months) {
+            const li = document.createElement('li');
+            li.className = 'month-item' + (item.monthCode === convertedDate.monthCode ? ' active-month' : '');
+            li.dataset.monthCode = item.monthCode;
+            li.dataset.days = String(item.daysInMonth);
+
+            const codeSpan = document.createElement('span');
+            codeSpan.className = 'month-code';
+            codeSpan.textContent = item.monthCode;
+
+            const daysSpan = document.createElement('span');
+            daysSpan.className = 'month-days';
+            daysSpan.textContent = `${item.daysInMonth} days`;
+
+            li.appendChild(codeSpan);
+            li.appendChild(daysSpan);
+            breakdownEl.appendChild(li);
+          }
+        }
+      }
+    }
+
+    const initialIsoDate = Temporal.Now.plainDateISO().toString();
+    dateInput.value = initialIsoDate;
+    renderCalendars(initialIsoDate);
+
+    dateInput.addEventListener('input', (event) => {
+      renderCalendars(event.target.value);
+    });
+
+    dateInput.addEventListener('change', (event) => {
+      renderCalendars(event.target.value);
+    });
+  </script>
 </body>
 
