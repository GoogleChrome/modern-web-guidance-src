+        gl.vertexAttribPointer(1, 3, gl.FLOAT, false, stride, 3 * 4);
+        gl.enableVertexAttribArray(2);
+        gl.vertexAttribPointer(2, 2, gl.FLOAT, false, stride, 6 * 4);
+        gl.bindVertexArray(null);
+        return vao;
+      }
+
+      return {
+        program,
+        boxVAO: createVAO(boxVertices),
+        quadVAO: createVAO(quadVertices),
+        uMvp: gl.getUniformLocation(program, "u_mvp"),
+        uModel: gl.getUniformLocation(program, "u_model"),
+        uUseTexture: gl.getUniformLocation(program, "u_useTexture"),
+        uTexture: gl.getUniformLocation(program, "u_texture"),
+        uBaseColor: gl.getUniformLocation(program, "u_baseColor"),
+      };
+    }
+
+    const scene = gl ? initCoffeeBoxScene(gl) : null;
+    const texture = gl ? gl.createTexture() : null;
+    const textureState = { width: 0, height: 0 };
+
+    function renderSceneFrame(now) {
+      const dt = Math.min(0.05, (now - lastTimestamp) / 1000);
+      lastTimestamp = now;
+      if (isSpinning) {
+        currentAngle += dt * 0.75;
+      }
+
+      if (!gl || !scene) return null;
+
+      gl.viewport(0, 0, canvas.width, canvas.height);
+      gl.enable(gl.DEPTH_TEST);
+      gl.clearColor(0.14, 0.09, 0.07, 1.0);
+      gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+
+      const aspect = (canvas.clientWidth || 1) / (canvas.clientHeight || 1);
+      const proj = mat4Perspective((42 * Math.PI) / 180, aspect, 0.1, 20.0);
+      const view = mat4Translate(0, 0, -3.45);
+
+      // Smoothly oscillate/spin the 3D coffee box so the front form remains visible and clickable as it rotates
+      const rotY = Math.sin(currentAngle) * 0.58;
+      const rotX = Math.cos(currentAngle * 0.7) * 0.14;
+      const boxModel = mat4Multiply(mat4RotateY(rotY), mat4RotateX(rotX));
+      const viewProj = mat4Multiply(proj, view);
+      const boxMVP = mat4Multiply(viewProj, boxModel);
+
+      gl.useProgram(scene.program);
+
+      // 1. Draw the 3D coffee box body
+      const baseColor = roastPalettes[roastSelect.value] || roastPalettes.medium;
+      gl.uniformMatrix4fv(scene.uMvp, false, boxMVP);
+      gl.uniformMatrix4fv(scene.uModel, false, boxModel);
+      gl.uniform1i(scene.uUseTexture, 0);
+      gl.uniform3fv(scene.uBaseColor, baseColor);
+      gl.bindVertexArray(scene.boxVAO);
+      gl.drawArrays(gl.TRIANGLES, 0, 36);
+
+      // 2. Compute the MVP matrix for the unit quad (-0.5..0.5) on the front face of the coffee box
+      const labelOffset = mat4Multiply(
+        mat4Translate(0, 0, 0.402),
+        mat4Scale(1.36, 1.72, 1.0)
+      );
+      const htmlElementModel = mat4Multiply(boxModel, labelOffset);
+      const htmlElementMVP = mat4Multiply(viewProj, htmlElementModel);
+
+      if (textureState.width > 0 && textureState.height > 0) {
+        gl.activeTexture(gl.TEXTURE0);
+        gl.bindTexture(gl.TEXTURE_2D, texture);
+        gl.uniform1i(scene.uTexture, 0);
+        gl.uniform1i(scene.uUseTexture, 1);
+        gl.uniformMatrix4fv(scene.uMvp, false, htmlElementMVP);
+        gl.uniformMatrix4fv(scene.uModel, false, htmlElementModel);
+        gl.bindVertexArray(scene.quadVAO);
+        gl.drawArrays(gl.TRIANGLES, 0, 6);
+      }
+
+      gl.bindVertexArray(null);
+      return htmlElementMVP;
+    }
+
+    // Check if HTML-in-Canvas is supported in the browser
+    if ("content" in HTMLCanvasElement.prototype) {
+      // Use HTML-in-Canvas API
+      canvas.onpaint = (event) => {
+        if (
+          !textureState.width ||
+          (event.changedElements && event.changedElements.length > 0)
+        ) {
+          try {
+            uploadElementWebGL(gl, canvas, texture, uiElement, textureState);
+          } catch (err) {
+            console.error("texElementSubImage2D copy failed:", err);
+          }
+        }
+
+        const htmlElementMVP = renderSceneFrame(performance.now());
+        if (htmlElementMVP) {
+          canvas.updateElementGeometry(uiElement, {
+            canvasTransform: computeCanvasTransform(canvas, uiElement, htmlElementMVP),
+          });
+        }
+      };
+
+      function renderLoop() {
+        canvas.requestPaint();
+        requestAnimationFrame(renderLoop);
+      }
+      requestAnimationFrame(renderLoop);
+    } else {
+      // Fallback strategy: place the interactive HTML content on top of the canvas using CSS
+      canvasStage.classList.add("fallback-overlay");
+      canvasStage.appendChild(uiElement);
+
+      function fallbackRenderLoop(now) {
+        renderSceneFrame(now);
+        requestAnimationFrame(fallbackRenderLoop);
+      }
+      requestAnimationFrame(fallbackRenderLoop);
+    }
+  </script>
+
 </body>
 
