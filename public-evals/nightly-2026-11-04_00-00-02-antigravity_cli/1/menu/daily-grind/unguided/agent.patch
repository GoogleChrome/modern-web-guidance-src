+
+      function renderCardSummary(cardId) {
+        const state = cardCustomizations[cardId];
+        const summaryEl = document.getElementById('summary-' + cardId);
+        if (!state || !summaryEl) return;
+        const parts = [state.size, state.milk];
+        state.addons.forEach(addon => parts.push(addon));
+        summaryEl.textContent = parts.join(' • ');
+      }
+
+      function getDirectMenuItems(menuEl) {
+        if (!menuEl) return [];
+        const items = [];
+        Array.from(menuEl.children).forEach(li => {
+          const item = li.querySelector(':scope > [role="menuitem"], :scope > [role="menuitemradio"], :scope > [role="menuitemcheckbox"]');
+          if (item) items.push(item);
+        });
+        return items;
+      }
