+        const rect = submenu.getBoundingClientRect();
+        if (rect.right > window.innerWidth - 12) {
+          submenu.classList.add('flip-left');
+        }
+      }
+
+      function closeMenuTree(menuEl) {
+        if (!menuEl) return;
+        menuEl.classList.remove('is-open');
+        const nestedMenus = menuEl.querySelectorAll('.menu-popup.is-open, .submenu-popup.is-open');
+        nestedMenus.forEach(m => m.classList.remove('is-open'));
+        const expandedTriggers = menuEl.querySelectorAll('[aria-expanded="true"]');
+        expandedTriggers.forEach(t => t.setAttribute('aria-expanded', 'false'));
+      }
+
+      function closeAllMenus(exceptTriggerOrContainer) {
+        document.querySelectorAll('.menu-trigger[aria-expanded="true"]').forEach(trigger => {
+          const menuId = trigger.getAttribute('aria-controls');
+          const menuEl = menuId ? document.getElementById(menuId) : null;
+          if (
+            exceptTriggerOrContainer &&
+            (trigger === exceptTriggerOrContainer ||
+              (menuEl && menuEl.contains(exceptTriggerOrContainer)))
+          ) {
+            return;
+          }
+          trigger.setAttribute('aria-expanded', 'false');
+          closeMenuTree(menuEl);
+        });
+      }
+
+      function openTriggerMenu(trigger, focusFirstItem = false) {
+        const menuId = trigger.getAttribute('aria-controls');
+        const menuEl = menuId ? document.getElementById(menuId) : null;
+        if (!menuEl) return;
+
+        // If this is a top-level trigger, close other top-level menus
+        if (trigger.classList.contains('menu-trigger')) {
+          closeAllMenus(trigger);
+        } else {
+          // Sibling submenu trigger inside a parent menu
+          const parentMenu = trigger.closest('[role="menu"]');
+          if (parentMenu) {
+            Array.from(parentMenu.children).forEach(li => {
+              const siblingTrigger = li.querySelector(':scope > [aria-haspopup="true"]');
+              if (siblingTrigger && siblingTrigger !== trigger) {
+                siblingTrigger.setAttribute('aria-expanded', 'false');
+                const sibId = siblingTrigger.getAttribute('aria-controls');
+                if (sibId) closeMenuTree(document.getElementById(sibId));
+              }
+            });
+          }
+        }
+
+        trigger.setAttribute('aria-expanded', 'true');
+        menuEl.classList.add('is-open');
+        if (menuEl.classList.contains('submenu-popup')) {
+          adjustSubmenuPosition(menuEl);
+        }
+
+        if (focusFirstItem) {
+          const items = getDirectMenuItems(menuEl);
+          if (items.length > 0) {
+            items[0].focus();
+          }
+        }
+      }
+
+      function toggleTriggerMenu(trigger, focusFirstItem = false) {
+        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
+        if (isExpanded) {
+          const menuId = trigger.getAttribute('aria-controls');
+          trigger.setAttribute('aria-expanded', 'false');
+          if (menuId) closeMenuTree(document.getElementById(menuId));
+        } else {
+          openTriggerMenu(trigger, focusFirstItem);
+        }
+      }
+
+      function handleMenuItemSelection(item) {
+        const role = item.getAttribute('role');
+
+        if (role === 'menuitemradio') {
+          const cardId = item.getAttribute('data-card');
+          const category = item.getAttribute('data-category');
+          const value = item.getAttribute('data-value');
+          const radioGroup = item.getAttribute('data-radio-group');
+
+          if (cardId && category) {
+            const cardRoot = item.closest('.menu-popup');
+            if (cardRoot) {
+              cardRoot.querySelectorAll(`[role="menuitemradio"][data-card="${cardId}"][data-category="${category}"]`).forEach(radio => {
+                radio.setAttribute('aria-checked', 'false');
+                const ind = radio.querySelector('.menu-check-indicator');
+                if (ind) ind.textContent = '';
+              });
+            }
+            item.setAttribute('aria-checked', 'true');
+            const ind = item.querySelector('.menu-check-indicator');
+            if (ind) ind.textContent = '●';
+
+            cardCustomizations[cardId][category] = value;
+            renderCardSummary(cardId);
+            updateStatus(`Updated <strong>${cardCustomizations[cardId].name}</strong> ${category} to <strong>${value}</strong>.`);
+          } else if (radioGroup) {
+            const parentMenu = item.closest('[role="menu"]');
+            if (parentMenu) {
+              parentMenu.querySelectorAll(`[role="menuitemradio"][data-radio-group="${radioGroup}"]`).forEach(radio => {
+                radio.setAttribute('aria-checked', 'false');
+                const ind = radio.querySelector('.menu-check-indicator');
+                if (ind) ind.textContent = '';
+              });
+            }
+            item.setAttribute('aria-checked', 'true');
+            const ind = item.querySelector('.menu-check-indicator');
+            if (ind) ind.textContent = '●';
+            const actionLabel = item.getAttribute('data-action') || item.textContent.trim();
+            updateStatus(`Selected ${actionLabel}.`);
+          }
+          return;
+        }
+
+        if (role === 'menuitemcheckbox') {
+          const isChecked = item.getAttribute('aria-checked') === 'true';
+          const nextChecked = !isChecked;
+          item.setAttribute('aria-checked', String(nextChecked));
+          const ind = item.querySelector('.menu-check-indicator');
+          if (ind) ind.textContent = nextChecked ? '✓' : '';
+
+          const cardId = item.getAttribute('data-card');
+          const value = item.getAttribute('data-value');
+          if (cardId && value && cardCustomizations[cardId]) {
+            if (nextChecked) {
+              cardCustomizations[cardId].addons.add(value);
+            } else {
+              cardCustomizations[cardId].addons.delete(value);
+            }
+            renderCardSummary(cardId);
+            updateStatus(`${nextChecked ? 'Added' : 'Removed'} <strong>${value}</strong> for <strong>${cardCustomizations[cardId].name}</strong>.`);
+          }
+          return;
+        }
+
+        // Standard menuitem action
+        const addToOrderId = item.getAttribute('data-add-to-order');
+        if (addToOrderId && cardCustomizations[addToOrderId]) {
+          orderCount += 1;
+          if (cartCounter) cartCounter.textContent = `Order Items: ${orderCount}`;
+          const state = cardCustomizations[addToOrderId];
+          const summaryEl = document.getElementById('summary-' + addToOrderId);
+          const details = summaryEl ? summaryEl.textContent : '';
+          updateStatus(`Added <strong>${state.name}</strong> (${details}) to your order!`);
+          closeAllMenus();
+          return;
+        }
+
+        const customAction = item.getAttribute('data-action');
+        if (customAction) {
+          updateStatus(`${customAction}`);
+          closeAllMenus();
+        }
+      }
+
+      // Wire up triggers and menu items
+      document.querySelectorAll('[aria-haspopup="true"]').forEach(trigger => {
+        trigger.addEventListener('click', e => {
+          e.preventDefault();
+          e.stopPropagation();
+          toggleTriggerMenu(trigger, false);
+        });
+
+        // Hover support for nested submenu triggers inside an open menu
+        if (!trigger.classList.contains('menu-trigger')) {
+          trigger.parentElement.addEventListener('mouseenter', () => {
+            openTriggerMenu(trigger, false);
+          });
+        }
+      });
+
+      document.querySelectorAll('[role="menuitem"], [role="menuitemradio"], [role="menuitemcheckbox"]').forEach(item => {
+        if (item.getAttribute('aria-haspopup') === 'true') return;
+        item.addEventListener('click', e => {
+          if (item.tagName === 'A' && item.getAttribute('data-action')) {
+            e.preventDefault();
+          }
+          e.stopPropagation();
+          handleMenuItemSelection(item);
+        });
+      });
+
+      // Keyboard Navigation (WAI-ARIA Menu & Menubar Pattern)
+      document.addEventListener('keydown', e => {
+        const active = document.activeElement;
+        if (!active) return;
+
+        const inMenu = active.closest('[role="menu"]');
+        const inMenubar = active.closest('[role="menubar"]');
+
+        if (e.key === 'Escape') {
+          if (inMenu) {
+            e.preventDefault();
+            const parentMenuId = inMenu.id;
+            const trigger = parentMenuId
+              ? document.querySelector(`[aria-controls="${parentMenuId}"]`)
+              : null;
+            if (trigger) {
+              trigger.setAttribute('aria-expanded', 'false');
+              closeMenuTree(inMenu);
+              trigger.focus();
+            } else {
+              closeAllMenus();
+            }
+          } else {
+            closeAllMenus();
+          }
+          return;
+        }
+
+        if (inMenu) {
+          const items = getDirectMenuItems(inMenu);
+          const idx = items.indexOf(active);
+
+          if (e.key === 'ArrowDown') {
+            e.preventDefault();
+            const next = items[(idx + 1) % items.length];
+            if (next) next.focus();
+          } else if (e.key === 'ArrowUp') {
+            e.preventDefault();
+            const prev = items[(idx - 1 + items.length) % items.length];
+            if (prev) prev.focus();
+          } else if (e.key === 'Home') {
+            e.preventDefault();
+            if (items[0]) items[0].focus();
+          } else if (e.key === 'End') {
+            e.preventDefault();
+            if (items[items.length - 1]) items[items.length - 1].focus();
+          } else if (e.key === 'ArrowRight') {
+            if (active.getAttribute('aria-haspopup') === 'true') {
+              e.preventDefault();
+              openTriggerMenu(active, true);
+            }
+          } else if (e.key === 'ArrowLeft') {
+            const parentMenuId = inMenu.id;
+            const parentTrigger = parentMenuId
+              ? document.querySelector(`[aria-controls="${parentMenuId}"]`)
+              : null;
+            if (parentTrigger && !parentTrigger.classList.contains('menu-trigger')) {
+              e.preventDefault();
+              parentTrigger.setAttribute('aria-expanded', 'false');
+              closeMenuTree(inMenu);
+              parentTrigger.focus();
+            }
+          } else if (e.key === 'Enter' || e.key === ' ') {
+            e.preventDefault();
+            if (active.getAttribute('aria-haspopup') === 'true') {
+              openTriggerMenu(active, true);
+            } else {
+              handleMenuItemSelection(active);
+            }
+          }
+          return;
+        }
+
+        if (inMenubar || active.classList.contains('menu-trigger')) {
+          if (e.key === 'ArrowDown' && active.getAttribute('aria-haspopup') === 'true') {
+            e.preventDefault();
+            openTriggerMenu(active, true);
+            return;
+          }
+          if (e.key === 'ArrowUp' && active.getAttribute('aria-haspopup') === 'true') {
+            e.preventDefault();
+            openTriggerMenu(active, false);
+            const menuId = active.getAttribute('aria-controls');
+            const menuEl = menuId ? document.getElementById(menuId) : null;
+            const items = getDirectMenuItems(menuEl);
+            if (items.length > 0) items[items.length - 1].focus();
+            return;
+          }
+          if (inMenubar && (e.key === 'ArrowRight' || e.key === 'ArrowLeft')) {
+            const barItems = getDirectMenuItems(inMenubar);
+            const idx = barItems.indexOf(active);
+            if (idx !== -1) {
+              e.preventDefault();
+              const delta = e.key === 'ArrowRight' ? 1 : -1;
+              const nextItem = barItems[(idx + delta + barItems.length) % barItems.length];
+              if (nextItem) {
+                closeAllMenus();
+                nextItem.focus();
+              }
+            }
+          }
+        }
+      });
+
+      // Close menus when clicking outside
+      document.addEventListener('click', e => {
+        if (!e.target.closest('.menu-popup, .submenu-popup, .menu-trigger')) {
+          closeAllMenus();
+        }
+      });
+    })();
+  </script>
 </body>
 
 </html>
