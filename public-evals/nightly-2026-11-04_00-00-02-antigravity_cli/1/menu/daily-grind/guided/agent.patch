+      // Prevent pointerdown from focusing the trigger and starting a preview mid-click
+      trigger.addEventListener('pointerdown', event => {
+        event.preventDefault();
+        pointerTrigger = trigger;
+      });
+
+      trigger.addEventListener('click', event => {
+        const fromKeyboard = event.detail === 0 && pointerTrigger !== trigger;
+        if (fromKeyboard && !isOpen(menu)) {
+          enterOnOpen.add(menu);
+        }
+        if (!hasNativeInvokers) {
+          event.preventDefault();
+          if (isOpen(menu)) {
+            closeAndRestore(menu, { fromPointer: !fromKeyboard });
+          } else {
+            try {
+              menu.showPopover({ source: trigger });
+            } catch {
+              menu.showPopover();
+            }
+          }
+        }
+        pointerTrigger = null;
+      });
+
+      // Toggle listener manages aria-expanded, fallback coordinates, and entering the menu
+      menu.addEventListener('toggle', event => {
+        const open = event.newState === 'open';
+        trigger.setAttribute('aria-expanded', String(open));
+        if (!open) {
+          enterOnOpen.delete(menu);
+          enterLastOnOpen.delete(menu);
+          return;
+        }
+        positionMenuFallback(menu, trigger);
+        const items = ownItems(menu);
+        if (enterLastOnOpen.has(menu)) {
+          enterLastOnOpen.delete(menu);
+          enterOnOpen.delete(menu);
+          items.at(-1)?.focus({ preventScroll: true });
+        } else if (enterOnOpen.has(menu)) {
+          enterOnOpen.delete(menu);
+          items[0]?.focus({ preventScroll: true });
+        } else if (pointerTrigger === trigger || document.activeElement !== trigger) {
+          trigger.focus({ focusVisible: false, preventScroll: true });
+        }
+      });
+    });
+
+    // 5. Preview on focus & hover for menubar triggers and submenu triggers
+    triggers.forEach(trigger => {
+      const menu = menuFor(trigger);
+      const isMenubarTrigger = menubarTriggers.includes(trigger);
+      const isSubmenuTrigger = Boolean(trigger.closest('[popover]'));
+
+      if (isMenubarTrigger || isSubmenuTrigger) {
+        trigger.addEventListener('focus', event => {
+          if (windowBlurred) return;
+          if (isMenubarTrigger) setMenubarTabStop(trigger);
+          // Ignore focus returning from inside the trigger's own menu
+          if (event.relatedTarget && menu.contains(event.relatedTarget)) return;
+          if (!isOpen(menu)) {
+            try {
+              menu.showPopover({ source: trigger });
+            } catch {
+              menu.showPopover();
+            }
+          }
+        });
+
+        trigger.addEventListener('blur', event => {
+          if (windowBlurred) return;
+          // Hide a previewed menu on blur unless focus moved into it
+          if (event.relatedTarget && menu.contains(event.relatedTarget)) return;
+          if (isOpen(menu)) {
+            menu.hidePopover();
+          }
+        });
+      }
+
+      // Hover switches open top-level menubar menus
+      if (isMenubarTrigger) {
+        trigger.addEventListener('pointerenter', () => {
+          const openSibling = menubarTriggers.find(t => t !== trigger && isOpen(menuFor(t)));
+          if (!openSibling) return;
+          menuFor(openSibling).hidePopover();
+          setMenubarTabStop(trigger);
+          trigger.focus({ focusVisible: false, preventScroll: true });
+        });
+      }
+
+      // Safe triangle on pointerleave of a submenu trigger
+      if (isSubmenuTrigger) {
+        trigger.addEventListener('pointerleave', event => {
+          startBridge(menu, event);
+        });
+      }
+    });
+
+    // 6. Safe triangle implementation for submenus
+    const canHover = matchMedia('(hover: hover)');
+    function startBridge(submenu, event) {
+      if (!canHover.matches || !isOpen(submenu)) return;
+      const rect = submenu.getBoundingClientRect();
+      if (event.clientX >= rect.left && event.clientX <= rect.right) return; // --below: no side edge.
+      const style = submenu.style;
+      style.setProperty('--bridge-edge', `${event.clientX < rect.left ? 0 : rect.width}px`);
+      style.setProperty('--bridge-height', `${rect.height}px`);
+      const update = ({ clientX, clientY, target }) => {
+        if (target !== submenu && submenu.contains(target)) return stop(); // Reached an item.
+        style.setProperty('--bridge-x', `${clientX - rect.left}px`);
+        style.setProperty('--bridge-y', `${clientY - rect.top}px`);
+      };
+      const timer = setTimeout(() => stop(), 300);
+      const stop = () => {
+        clearTimeout(timer);
+        document.removeEventListener('pointermove', update);
+        submenu.removeEventListener('toggle', stop);
+        submenu.removeAttribute('data-bridge');
+      };
+      update(event);
+      submenu.dataset.bridge = '';
+      document.addEventListener('pointermove', update);
+      submenu.addEventListener('toggle', stop, { once: true });
+    }
+
+    // 7. Pointer over an item focuses it without a ring, and sibling item closes open submenu
+    document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+      group.addEventListener('pointermove', event => {
+        const item = event.target.closest('button, a');
+        if (!item || item.closest('[focusgroup]') !== group) return;
+        if (document.activeElement !== item) {
+          // Close any open sibling submenu in the same focusgroup
+          group.querySelectorAll(':scope > button[commandfor]').forEach(subTrigger => {
+            if (subTrigger !== item) {
+              const subMenu = menuFor(subTrigger);
+              if (isOpen(subMenu)) subMenu.hidePopover();
+            }
+          });
+          item.focus({ focusVisible: false, preventScroll: true });
+        }
+      });
+    });
+
+    // 8. Keyboard navigation for menubar, triggers, menus, and submenus
+    document.addEventListener('keydown', event => {
+      const target = document.activeElement;
+      if (!target) return;
+
+      // A. Top-level menubar trigger keys
+      if (menubarTriggers.includes(target)) {
+        const idx = menubarTriggers.indexOf(target);
+        const menu = menuFor(target);
+        if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
+          event.preventDefault();
+          const dir = event.key === 'ArrowRight' ? 1 : -1;
+          const nextTrigger = menubarTriggers[(idx + dir + menubarTriggers.length) % menubarTriggers.length];
+          if (isOpen(menu)) menu.hidePopover();
+          setMenubarTabStop(nextTrigger);
+          nextTrigger.focus();
+          return;
+        }
+        if (event.key === 'ArrowDown' || event.key === 'Home') {
+          event.preventDefault();
+          if (isOpen(menu)) {
+            ownItems(menu)[0]?.focus({ preventScroll: true });
+          } else {
+            enterOnOpen.add(menu);
+            target.click();
+          }
+          return;
+        }
+        if (event.key === 'ArrowUp' || event.key === 'End') {
+          event.preventDefault();
+          if (isOpen(menu)) {
+            ownItems(menu).at(-1)?.focus({ preventScroll: true });
+          } else {
+            enterLastOnOpen.add(menu);
+            target.click();
+          }
+          return;
+        }
+        if (event.key === 'Escape' && isOpen(menu)) {
+          event.preventDefault();
+          menu.hidePopover();
+          return;
+        }
+      }
+
+      // B. Standalone menu trigger keys (Seasonal Favorite cards)
+      if (triggers.includes(target) && !menubarTriggers.includes(target) && !target.closest('[popover]')) {
+        const menu = menuFor(target);
+        if (event.key === 'ArrowDown' || event.key === 'Home') {
+          event.preventDefault();
+          if (isOpen(menu)) {
+            ownItems(menu)[0]?.focus({ preventScroll: true });
+          } else {
+            enterOnOpen.add(menu);
+            target.click();
+          }
+          return;
+        }
+        if (event.key === 'ArrowUp' || event.key === 'End') {
+          event.preventDefault();
+          if (isOpen(menu)) {
+            ownItems(menu).at(-1)?.focus({ preventScroll: true });
+          } else {
+            enterLastOnOpen.add(menu);
+            target.click();
+          }
+          return;
+        }
+        if (event.key === 'Escape' && isOpen(menu)) {
+          event.preventDefault();
+          menu.hidePopover();
+          return;
+        }
+      }
+
+      // C. Inside an open menu popover
+      const currentMenu = target.closest('[popover]');
+      if (!currentMenu) return;
+
+      const parentTrigger = triggerFor(currentMenu);
+      const isSubmenu = Boolean(parentTrigger?.closest('[popover]'));
+      const rootMenu = rootMenuFor(currentMenu);
+      const rootTrigger = triggerFor(rootMenu);
+
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        event.stopPropagation();
+        closeAndRestore(currentMenu, { fromPointer: false });
+        return;
+      }
+
+      if (event.key === 'ArrowLeft') {
+        event.preventDefault();
+        event.stopPropagation();
+        if (isSubmenu) {
+          closeAndRestore(currentMenu, { fromPointer: false });
+        } else if (menubarTriggers.includes(rootTrigger)) {
+          const idx = menubarTriggers.indexOf(rootTrigger);
+          const prevTrigger = menubarTriggers[(idx - 1 + menubarTriggers.length) % menubarTriggers.length];
+          rootMenu.hidePopover();
+          setMenubarTabStop(prevTrigger);
+          prevTrigger.focus();
+        }
+        return;
+      }
+
+      if (event.key === 'ArrowRight') {
+        event.preventDefault();
+        event.stopPropagation();
+        // If on a submenu trigger, open the submenu and focus its first item
+        if (target.hasAttribute('commandfor')) {
+          const subMenu = menuFor(target);
+          if (isOpen(subMenu)) {
+            ownItems(subMenu)[0]?.focus({ preventScroll: true });
+          } else {
+            enterOnOpen.add(subMenu);
+            target.click();
+          }
+          return;
+        }
+        // Otherwise, if inside a menubar hierarchy, close the hierarchy and preview the next top-level menu
+        if (menubarTriggers.includes(rootTrigger)) {
+          const idx = menubarTriggers.indexOf(rootTrigger);
+          const nextTrigger = menubarTriggers[(idx + 1) % menubarTriggers.length];
+          rootMenu.hidePopover();
+          setMenubarTabStop(nextTrigger);
+          nextTrigger.focus();
+        }
+        return;
+      }
+
+      if (event.key === 'Tab') {
+        closeAllMenus();
+      }
+    });
+
+    // 9. Outside focus closes all open menus
+    document.addEventListener('focusin', event => {
+      const target = event.target;
+      if (target.closest('[popover]') || target.closest('button[commandfor]')) return;
+      closeAllMenus();
+    });
+
+    // 10. Command & checkable item activation
+    function activateItem(item, { fromPointer, keepOpen = false }) {
+      const role = item.getAttribute('role');
+      const rootMenu = rootMenuFor(item);
+      const actionLabel = item.dataset.action || item.textContent.trim();
+
+      if (role === 'menuitemcheckbox') {
+        const checked = item.getAttribute('aria-checked') === 'true';
+        item.setAttribute('aria-checked', String(!checked));
+        if (statusBanner) {
+          statusBanner.textContent = `${actionLabel}: ${!checked ? 'Enabled' : 'Disabled'}`;
+        }
+        if (!keepOpen && rootMenu) {
+          setTimeout(() => closeAndRestore(rootMenu, { fromPointer }), 300);
+        }
+        return;
+      }
+
+      if (role === 'menuitemradio') {
+        const group = item.closest('[role="group"]') || item.closest('[focusgroup~="menu"]');
+        group?.querySelectorAll('[role="menuitemradio"]').forEach(radio => {
+          radio.setAttribute('aria-checked', String(radio === item));
+        });
+        if (statusBanner) {
+          statusBanner.textContent = `Selected ${actionLabel}`;
+        }
+        if (rootMenu) {
+          setTimeout(() => closeAndRestore(rootMenu, { fromPointer }), 300);
+        }
+        return;
+      }
+
+      if (statusBanner) {
+        statusBanner.textContent = `${actionLabel}`;
+      }
+      if (rootMenu) {
+        closeAndRestore(rootMenu, { fromPointer });
+      }
+    }
+
+    document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+      // Space on menuitemcheckbox toggles and stays open (APG)
+      group.addEventListener('keydown', event => {
+        if (event.key !== ' ') return;
+        const item = event.target.closest('button[role="menuitemcheckbox"]');
+        if (!item || item.closest('[focusgroup]') !== group) return;
+        event.preventDefault();
+        event.stopPropagation();
+        activateItem(item, { fromPointer: false, keepOpen: true });
+      });
+
+      group.addEventListener('click', event => {
+        const item = event.target.closest('button, a');
+        if (!item || item.closest('[focusgroup]') !== group) return;
+        // Submenu triggers only open/toggle their submenu, never activate a command
+        if (item.hasAttribute('commandfor')) return;
+
+        const fromPointer = event.detail > 0;
+        if (item.tagName === 'A') {
+          event.preventDefault();
+        }
+        activateItem(item, { fromPointer, keepOpen: false });
+      });
+    });
+  </script>
 </body>
 
 </html>
