+  <script>
+    (function () {
+      const scrollContainer = document.getElementById('reviews-scroll');
+      const topIndicator = document.querySelector('.indicator-top');
+      const bottomIndicator = document.querySelector('.indicator-bottom');
+
+      if (!scrollContainer || !topIndicator || !bottomIndicator) return;
+
+      function updateIndicators() {
+        const scrollTop = scrollContainer.scrollTop;
+        const maxScroll = scrollContainer.scrollHeight - scrollContainer.clientHeight;
+
+        const canScrollUp = scrollTop > 0;
+        const canScrollDown = maxScroll > 0 && scrollTop < maxScroll - 1;
+
+        topIndicator.classList.toggle('visible', canScrollUp);
+        bottomIndicator.classList.toggle('visible', canScrollDown);
+      }
+
+      scrollContainer.addEventListener('scroll', updateIndicators, { passive: true });
+      window.addEventListener('resize', updateIndicators);
+      window.addEventListener('load', updateIndicators);
+      updateIndicators();
+    })();
+  </script>
