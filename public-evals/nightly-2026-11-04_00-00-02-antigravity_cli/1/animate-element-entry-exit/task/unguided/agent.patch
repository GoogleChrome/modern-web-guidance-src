+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+
+    const promos = [
+      {
+        title: 'Pastry Pairing Deal',
+        description: 'Add a freshly baked croissant to any large coffee for just $2.'
+      },
+      {
+        title: 'Double Bean Points',
+        description: 'Earn 2x rewards points on all whole-bean coffee bags this weekend.'
+      },
+      {
+        title: 'Afternoon Pick-Me-Up',
+        description: 'Enjoy 50% off all cold brews and iced lattes from 2 PM to 4 PM.'
+      },
+      {
+        title: 'Bring a Mug Discount',
+        description: 'Save $1.00 on any beverage when you bring your own reusable cup.'
+      }
+    ];
+
+    let promoCount = 0;
+
+    addBtn.addEventListener('click', () => {
+      const promo = promos[promoCount % promos.length];
+      promoCount++;
+
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = `
+        <h3>${promo.title}</h3>
+        <p>${promo.description}</p>
+        <a href="/rewards" class="btn">Claim Offer</a>
+      `;
+      domContainer.appendChild(card);
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not(.removing)');
+      const lastCard = cards[cards.length - 1];
+      if (!lastCard) return;
+
+      lastCard.classList.add('removing');
+      let isRemoved = false;
+      const cleanup = () => {
+        if (isRemoved) return;
+        isRemoved = true;
+        lastCard.remove();
+      };
+      lastCard.addEventListener('transitionend', cleanup, { once: true });
+      setTimeout(cleanup, 260);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      toggleCard.toggleAttribute('hidden');
+    });
+  </script>
