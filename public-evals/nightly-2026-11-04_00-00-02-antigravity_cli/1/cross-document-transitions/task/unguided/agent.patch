+  <script>
+    const previousLink = document.getElementById('previous');
+    const nextLink = document.getElementById('next');
+
+    if (previousLink) {
+      previousLink.addEventListener('click', () => {
+        sessionStorage.setItem('transitionType', 'previous');
+      });
+    }
+
+    if (nextLink) {
+      nextLink.addEventListener('click', () => {
+        sessionStorage.setItem('transitionType', 'next');
+      });
+    }
+
+    function determineTransitionType(fromEntry, toEntry) {
+      const stored = sessionStorage.getItem('transitionType');
+      if (stored === 'next' || stored === 'previous') {
+        sessionStorage.removeItem('transitionType');
+        return stored;
+      }
+
+      try {
+        const toUrl = new URL(toEntry?.url || window.location.href, window.location.origin);
+        const dirParam = toUrl.searchParams.get('dir') || toUrl.searchParams.get('transition');
+        if (dirParam === 'next' || dirParam === 'previous') {
+          return dirParam;
+        }
+
+        if (fromEntry?.url) {
+          const fromUrl = new URL(fromEntry.url, window.location.origin);
+          const fromPage = parseInt(fromUrl.searchParams.get('page') || '1', 10);
+          const toPage = parseInt(toUrl.searchParams.get('page') || '1', 10);
+          if (toPage > fromPage) return 'next';
+          if (toPage < fromPage) return 'previous';
+        }
+      } catch (err) {
+        // Ignore URL parsing errors
+      }
+
+      return 'next';
+    }
+
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      window.addEventListener('pageswap', (event) => {
+        if (!event.viewTransition) return;
+        const stored = sessionStorage.getItem('transitionType');
+        if (stored === 'next') {
+          event.viewTransition.types.add('next');
+        } else if (stored === 'previous') {
+          event.viewTransition.types.add('previous');
+        }
+      });
+
+      window.addEventListener('pagereveal', (event) => {
+        if (!event.viewTransition) return;
+        if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
+
+        const fromEntry = window.navigation?.activation?.from;
+        const toEntry = window.navigation?.activation?.entry;
+        const transitionType = determineTransitionType(fromEntry, toEntry);
+
+        if (transitionType === 'next') {
+          event.viewTransition.types.add('next');
+        } else if (transitionType === 'previous') {
+          event.viewTransition.types.add('previous');
+        }
+      });
+    }
+  </script>
