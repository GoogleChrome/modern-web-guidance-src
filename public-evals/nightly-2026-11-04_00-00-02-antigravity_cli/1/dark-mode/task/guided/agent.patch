+  <script>
+    (function () {
+      const themeSelect = document.getElementById('theme-select');
+      const metaColorScheme = document.querySelector('meta[name="color-scheme"]');
+      const root = document.documentElement;
+      const systemDarkQuery = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function updateSystemOptionLabel() {
+        const systemOption = themeSelect.querySelector('option[value="system"]');
+        if (systemOption) {
+          const currentSystem = systemDarkQuery.matches ? 'dark' : 'light';
+          systemOption.textContent = `System Default (Currently ${currentSystem})`;
+        }
+      }
+
+      function applyTheme(choice, persist = true) {
+        if (choice === 'light' || choice === 'dark') {
+          metaColorScheme.content = choice;
+          root.style.colorScheme = choice;
+          root.dataset.theme = choice;
+          if (persist) {
+            try {
+              localStorage.setItem('color-scheme', choice);
+            } catch (e) {}
+          }
+        } else {
+          metaColorScheme.content = 'light dark';
+          root.style.removeProperty('color-scheme');
+          delete root.dataset.theme;
+          if (persist) {
+            try {
+              localStorage.removeItem('color-scheme');
+            } catch (e) {}
+          }
+        }
+        themeSelect.value = (choice === 'light' || choice === 'dark') ? choice : 'system';
+      }
+
+      // Initialize state from storage
+      let initialTheme = 'system';
+      try {
+        const stored = localStorage.getItem('color-scheme');
+        if (stored === 'light' || stored === 'dark') {
+          initialTheme = stored;
+        }
+      } catch (e) {}
+
+      updateSystemOptionLabel();
+      applyTheme(initialTheme, false);
+
+      themeSelect.addEventListener('change', (e) => {
+        applyTheme(e.target.value, true);
+      });
+
+      systemDarkQuery.addEventListener('change', () => {
+        updateSystemOptionLabel();
+      });
+
+      window.addEventListener('storage', (e) => {
+        if (e.key === 'color-scheme') {
+          applyTheme(e.newValue ?? 'system', false);
+        }
+      });
+
+      // Late Night Specials filter select interactivity
+      const categorySelect = document.getElementById('late-night-category');
+      const specialItems = document.querySelectorAll('#late-night-list .special-item');
+      if (categorySelect) {
+        categorySelect.addEventListener('change', (e) => {
+          const cat = e.target.value;
+          specialItems.forEach((item) => {
+            item.hidden = !(cat === 'all' || item.dataset.category === cat);
+          });
+        });
+      }
+    })();
+  </script>
+
