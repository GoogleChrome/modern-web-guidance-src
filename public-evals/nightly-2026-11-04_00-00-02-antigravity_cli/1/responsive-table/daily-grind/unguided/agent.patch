+    /* Nutritional & Pricing Table */
+    .table-container {
+      margin-top: 40px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      padding: 24px;
+    }
+
+    .table-scroll {
+      overflow-x: auto;
+      -webkit-overflow-scrolling: touch;
+      border-radius: 6px;
+    }
+
+    .table-scroll:focus {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition-table {
+      width: 100%;
+      border-collapse: collapse;
+      text-align: left;
+      font-variant-numeric: tabular-nums;
+      min-width: 580px;
+      border: 1px solid var(--secondary);
+    }
+
+    .nutrition-table caption {
+      font-size: 1.25rem;
+      font-weight: bold;
+      color: var(--primary);
+      text-align: left;
+      margin-bottom: 14px;
+      caption-side: top;
+    }
+
+    .nutrition-table caption span {
+      display: block;
+      font-size: 0.9rem;
+      font-weight: normal;
+      color: var(--text);
+      margin-top: 4px;
+    }
+
+    .nutrition-table th,
+    .nutrition-table td {
+      padding: 14px 16px;
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .nutrition-table thead th {
+      background-color: var(--primary);
+      color: white;
+      font-weight: 600;
+      white-space: nowrap;
+    }
+
+    .nutrition-table tbody th[scope="row"] {
+      background-color: #f5f0ee;
+      color: var(--primary);
+      font-weight: 600;
+      position: sticky;
+      left: 0;
+      z-index: 1;
+      border-right: 1px solid var(--secondary);
+      white-space: nowrap;
+    }
+
+    .nutrition-table thead th:first-child {
+      position: sticky;
+      left: 0;
+      z-index: 2;
+      border-right: 1px solid rgba(255, 255, 255, 0.25);
+    }
+
+    .nutrition-table tbody tr:last-child th,
+    .nutrition-table tbody tr:last-child td {
+      border-bottom: none;
+    }
+
+    .nutrition-table tbody tr:nth-child(even) td {
+      background-color: var(--light);
+    }
+
+    .nutrition-table tbody tr:nth-child(odd) td {
+      background-color: white;
+    }
+
+    .nutrition-table tbody tr:hover td {
+      background-color: #f9f4f2;
+    }
+
+    .nutrition-table .num {
+      text-align: right;
+      white-space: nowrap;
+    }
+
+    @media (max-width: 600px) {
+      .table-container {
+        padding: 16px;
+      }
+
+      .nutrition-table th,
+      .nutrition-table td {
+        padding: 10px 12px;
+        font-size: 0.9rem;
+      }
+    }
+
