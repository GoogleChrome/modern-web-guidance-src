+  <script>
+    const cards = Array.from(document.querySelectorAll('#favorites-viewport .card'));
+    const statusEl = document.getElementById('favorites-status');
+    const prevBtn = document.getElementById('prev-favorite');
+    const nextBtn = document.getElementById('next-favorite');
+    let currentIndex = 0;
+
+    function updateFavoriteDOM(newIndex) {
+      cards[currentIndex].hidden = true;
+      currentIndex = newIndex;
+      cards[currentIndex].hidden = false;
+      statusEl.textContent = `${currentIndex + 1} / ${cards.length}`;
+    }
+
+    /**
+     * Navigates to a new view with a directional transition.
+     * @param {Function} updateDOM - Callback to update the DOM state.
+     * @param {string} direction - Either 'forward' or 'backward'.
+     */
+    function navigate(updateDOM, direction) {
+      if (!document.startViewTransition) {
+        updateDOM();
+        return;
+      }
+
+      const transition = document.startViewTransition({
+        update: updateDOM,
+        types: [direction]
+      });
+
+      transition.ready.catch(() => {});
+    }
+
+    nextBtn.addEventListener('click', () => {
+      const nextIndex = (currentIndex + 1) % cards.length;
+      navigate(() => updateFavoriteDOM(nextIndex), 'forward');
+    });
+
+    prevBtn.addEventListener('click', () => {
+      const prevIndex = (currentIndex - 1 + cards.length) % cards.length;
+      navigate(() => updateFavoriteDOM(prevIndex), 'backward');
+    });
+  </script>
