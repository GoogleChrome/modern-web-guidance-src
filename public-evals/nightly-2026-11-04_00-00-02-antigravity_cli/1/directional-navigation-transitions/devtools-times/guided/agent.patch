+    <script>
+        function initTopStoriesSlider() {
+            const scopeEl = document.getElementById('top-stories-slider');
+            const prevBtn = document.getElementById('top-stories-prev');
+            const nextBtn = document.getElementById('top-stories-next');
+            if (!scopeEl || !prevBtn || !nextBtn) return;
+
+            const slides = Array.from(scopeEl.querySelectorAll<HTMLElement>('[data-story-slide]'));
+            if (slides.length === 0) return;
+
+            let currentIndex = slides.findIndex((slide) => !slide.hidden);
+            if (currentIndex === -1) currentIndex = 0;
+
+            const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+            function navigate(nextIndex: number, direction: 'forward' | 'backward') {
+                const updateDOM = () => {
+                    slides[currentIndex].hidden = true;
+                    currentIndex = nextIndex;
+                    slides[currentIndex].hidden = false;
+                };
+
+                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+                    updateDOM();
+                    return;
+                }
+
+                if (supportsScopedTransition) {
+                    const transition = (scopeEl as any).startViewTransition({
+                        update: updateDOM,
+                        types: [direction],
+                    });
+                    transition.ready?.catch(() => {});
+                    return;
+                }
+
+                if (!document.startViewTransition) {
+                    updateDOM();
+                    return;
+                }
+
+                const transition = document.startViewTransition({
+                    update: updateDOM,
+                    types: [direction],
+                });
+                transition.ready?.catch(() => {});
+            }
+
+            prevBtn.addEventListener('click', () => {
+                const nextIndex = (currentIndex - 1 + slides.length) % slides.length;
+                navigate(nextIndex, 'backward');
+            });
+
+            nextBtn.addEventListener('click', () => {
+                const nextIndex = (currentIndex + 1) % slides.length;
+                navigate(nextIndex, 'forward');
+            });
+        }
+
+        document.addEventListener('astro:page-load', initTopStoriesSlider);
+    </script>
