@@ -0,0 +1,237 @@
+/**
+ * Origin and Site Validation Utilities for The Daily Grind
+ *
+ * Uses the Web Platform `Origin` API (`Origin.from()`, `isSameOrigin()`,
+ * `isSameSite()`, `origin.opaque`, and `new Origin()`) with a `new URL()`
+ * fallback for browsers where `Origin` is not yet available.
+ */
+
+export const DEFAULT_TRUSTED_ORDER_URL = 'https://orders.dailygrind.coffee';
+export const DEFAULT_SITE_URL = 'https://www.dailygrind.coffee';
+export const DEFAULT_SITE_DOMAIN = 'dailygrind.coffee';
+
+/**
+ * Extracts a URL string from a string, MessageEvent, globalThis/Window, or link element
+ * for the `new URL()` fallback path.
+ */
+function extractUrlString(candidate) {
+  if (typeof candidate === 'string') return candidate;
+  if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+    return candidate.origin;
+  }
+  if (candidate === globalThis) {
+    return globalThis.location?.href ?? '';
+  }
+  return candidate?.href ?? '';
+}
+
+/**
+ * Extracts an `Origin` instance using `Origin.from()`.
+ * Handles both real browser-dispatched `MessageEvent` objects (which carry an
+ * internal browser origin, preserving distinct opaque origins) and synthetic
+ * `new MessageEvent('message', { origin })` instances created in unit tests
+ * (falling back to `Origin.from(candidate.origin)` when `Origin.from(event)` throws).
+ */
+export function extractOrigin(candidate) {
+  try {
+    return Origin.from(candidate);
+  } catch (err) {
+    if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+      return Origin.from(candidate.origin);
+    }
+    throw err;
+  }
+}
+
+/**
+ * 1. Exact Origin Validation (`isSameOrigin()`)
+ *
+ * Verifies whether a candidate (MessageEvent, URL string, URL object, or anchor element)
+ * matches the trusted origin (defaults to the trusted ordering origin).
+ * Rejects invalid URLs, `"null"` opaque origins, scheme mismatches, port mismatches,
+ * and different subdomains.
+ */
+export function isTrustedSameOrigin(candidate, trustedUrl = DEFAULT_TRUSTED_ORDER_URL) {
+  try {
+    if ('Origin' in globalThis) {
+      const trustedOrigin =
+        trustedUrl instanceof Origin ? trustedUrl : Origin.from(trustedUrl);
+      const candidateOrigin = extractOrigin(candidate);
+      return !candidateOrigin.opaque && candidateOrigin.isSameOrigin(trustedOrigin);
+    }
+    const candidateUrl = new URL(extractUrlString(candidate));
+    const parsedTrusted = new URL(
+      typeof trustedUrl === 'string' ? trustedUrl : extractUrlString(trustedUrl)
+    );
+    return candidateUrl.origin !== 'null' && candidateUrl.origin === parsedTrusted.origin;
+  } catch {
+    return false;
+  }
+}
+
+export const isTrustedOrderingOrigin = isTrustedSameOrigin;
+export const checkSameOriginWithFallback = isTrustedSameOrigin;
+
+/**
+ * 2. Schemeful Same-Site Validation (`isSameSite()`)
+ *
+ * Validates cross-subdomain redirect URLs (e.g. `?returnTo=`) and classifies
+ * internal vs. external links without error-prone `.split('.')` string slicing.
+ * Rejects `http:` scheme downgrades, `data:` / `"null"` opaque origins, and
+ * sibling tenants on shared Public Suffix List domains (`.co.uk`, `.github.io`).
+ */
+export function isAllowedSameSiteUrl(
+  candidate,
+  referenceSiteUrl = DEFAULT_SITE_URL,
+  fallbackSiteDomain = DEFAULT_SITE_DOMAIN
+) {
+  try {
+    if ('Origin' in globalThis) {
+      const appOrigin =
+        referenceSiteUrl instanceof Origin
+          ? referenceSiteUrl
+          : extractOrigin(referenceSiteUrl);
+      const candidateOrigin = extractOrigin(candidate);
+      return !candidateOrigin.opaque && candidateOrigin.isSameSite(appOrigin);
+    }
+    const candidateUrl = new URL(extractUrlString(candidate));
+    const trustedUrl = new URL(
+      typeof referenceSiteUrl === 'string'
+        ? referenceSiteUrl
+        : extractUrlString(referenceSiteUrl)
+    );
+    return (
+      candidateUrl.origin !== 'null' &&
+      candidateUrl.protocol === trustedUrl.protocol &&
+      (candidateUrl.hostname === fallbackSiteDomain ||
+        candidateUrl.hostname.endsWith(`.${fallbackSiteDomain}`))
+    );
+  } catch {
+    return false;
+  }
+}
+
+export const checkSameSiteWithFallback = isAllowedSameSiteUrl;
+
+/**
+ * Validates a redirect URL (e.g. from `?returnTo=` or `?redirect=`) against the
+ * application's site origin, returning a safe fallback path when rejected.
+ */
+export function getValidatedRedirectUrl(
+  candidateUrl,
+  referenceSiteUrl = DEFAULT_SITE_URL,
+  fallbackUrl = '/account'
+) {
+  if (!candidateUrl || typeof candidateUrl !== 'string') {
+    return fallbackUrl;
+  }
+  if (isAllowedSameSiteUrl(candidateUrl, referenceSiteUrl)) {
+    return candidateUrl;
+  }
+  return fallbackUrl;
+}
+
+/**
+ * Classifies and annotates `<a>` elements within a container as same-site or external
+ * using `Origin.from(anchor).isSameSite(...)` instead of string splitting.
+ */
+export function classifySiteLinks(
+  root = typeof document !== 'undefined' ? document : null,
+  referenceSiteUrl = DEFAULT_SITE_URL
+) {
+  if (!root || typeof root.querySelectorAll !== 'function') return [];
+  const anchors = Array.from(root.querySelectorAll('a[href]'));
+  return anchors.map((anchor) => {
+    const sameSite = isAllowedSameSiteUrl(anchor, referenceSiteUrl);
+    anchor.dataset.siteScope = sameSite ? 'same-site' : 'external';
+    if (!sameSite) {
+      anchor.setAttribute('rel', 'noopener noreferrer');
+      anchor.setAttribute('target', '_blank');
+    }
+    return { anchor, href: anchor.href, sameSite };
+  });
+}
+
+/**
+ * 3. Opaque Sandboxed Widget Origin Pinning (`new Origin()`, `Origin.from(event)`, `origin.opaque`)
+ *
+ * Creates a stateful verifier that initializes with a unique opaque sentinel (`new Origin()`)
+ * and pins the opaque `Origin` extracted via `Origin.from(event)` on initialization (`type === 'init'`)
+ * from the expected `<iframe sandbox="allow-scripts">` window.
+ * Subsequent messages from that same sandboxed iframe match the pinned opaque `Origin`,
+ * while messages from any other sandboxed iframe (which also serialize `event.origin` to `"null"`)
+ * are rejected.
+ */
+export function createSandboxedWidgetVerifier(expectedWidgetWindow = null) {
+  let pinnedSandboxOrigin = 'Origin' in globalThis ? new Origin() : null;
+  let isSandboxPinned = false;
+  let trackedWindow = expectedWidgetWindow;
+
+  return {
+    setExpectedWindow(win) {
+      trackedWindow = win;
+    },
+    isPinned() {
+      return isSandboxPinned;
+    },
+    getPinnedOrigin() {
+      return pinnedSandboxOrigin;
+    },
+    reset() {
+      pinnedSandboxOrigin = 'Origin' in globalThis ? new Origin() : null;
+      isSandboxPinned = false;
+    },
+    verifyMessage(event, overrideExpectedWindow = trackedWindow) {
+      try {
+        if ('Origin' in globalThis) {
+          const senderOrigin = Origin.from(event);
+
+          // Pin the opaque origin only once on initialization from the expected sandboxed iframe
+          if (
+            !isSandboxPinned &&
+            senderOrigin.opaque &&
+            event.source === overrideExpectedWindow &&
+            event.data?.type === 'init'
+          ) {
+            pinnedSandboxOrigin = senderOrigin;
+            isSandboxPinned = true;
+          }
+
+          // Subsequent messages from the SAME sandboxed iframe match pinnedSandboxOrigin;
+          // messages from any other sandboxed iframe (also event.origin === "null") return false.
+          return senderOrigin.isSameOrigin(pinnedSandboxOrigin);
+        }
+
+        // Fallback for browsers without the Origin API:
+        // Verify opaque "null" serialization and strict window source identity
+        if (event?.origin !== 'null' || !overrideExpectedWindow) {
+          return false;
+        }
+        if (
+          !isSandboxPinned &&
+          event.source === overrideExpectedWindow &&
+          event.data?.type === 'init'
+        ) {
+          isSandboxPinned = true;
+        }
+        return isSandboxPinned && event.source === overrideExpectedWindow;
+      } catch {
+        return false;
+      }
+    },
+  };
+}
+
+const defaultWidgetVerifier = createSandboxedWidgetVerifier();
+
+/**
+ * Convenience function matching the standard `handleSandboxedWidgetMessage(event, expectedWidgetWindow)`
+ * signature for pinning and verifying messages from a sandboxed iframe widget.
+ */
+export function handleSandboxedWidgetMessage(event, expectedWidgetWindow) {
+  return defaultWidgetVerifier.verifyMessage(event, expectedWidgetWindow);
+}
+
+export function resetSandboxedWidgetPin() {
+  defaultWidgetVerifier.reset();
+}
