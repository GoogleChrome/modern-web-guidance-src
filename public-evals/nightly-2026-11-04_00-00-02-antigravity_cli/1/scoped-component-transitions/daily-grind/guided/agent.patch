+  <script>
+    // Feature detect element-scoped view transitions specifically on Element.prototype
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+    /**
+     * Trigger a transition scoped to a single component subtree (card, list, or grid).
+     * Degrades gracefully by applying the DOM update immediately when unsupported.
+     */
+    function runScopedTransition(scopeEl, updateDOM) {
+      if (!supportsScopedTransition) {
+        updateDOM();
+        return;
+      }
+
+      const transition = scopeEl.startViewTransition(() => {
+        updateDOM();
+      });
+
+      // Catch rejection when rapid interactions skip an active transition on the same scope
+      transition.ready.catch(() => {});
+    }
+
+    /**
+     * Reorder list items by moving existing DOM nodes (required for `view-transition-name: match-element`).
+     * Scoped to `listEl` since only the list order changes, keeping controls outside `listEl` interactive.
+     */
+    function reorderItems(listEl, orderedIds) {
+      const existing = new Map(
+        Array.from(listEl.children, (li) => [li.dataset.id, li])
+      );
+
+      runScopedTransition(listEl, () => {
+        for (const id of orderedIds) {
+          const li = existing.get(id);
+          if (li) listEl.appendChild(li);
+        }
+      });
+    }
+
+    /**
+     * Recalculate and update the card's total price badge.
+     */
+    function updateCardPrice(cardEl) {
+      const basePrice = parseFloat(cardEl.dataset.basePrice || '0');
+      const items = cardEl.querySelectorAll('ul li');
+      let extras = 0;
+      for (const li of items) {
+        extras += parseFloat(li.dataset.cost || '0');
+      }
+      const priceEl = cardEl.querySelector('[data-price-el]');
+      if (priceEl) {
+        priceEl.textContent = `$${(basePrice + extras).toFixed(2)}`;
+      }
+    }
+
+    /**
+     * Remove an item while preserving exit animation, card height transition, and keyboard focus.
+     * Scoped to outer `cardEl` so the card itself transitions its geometry change.
+     */
+    function removeItem(cardEl, itemEl) {
+      const hadFocus = itemEl.contains(document.activeElement);
+      const nextFocusTarget =
+        itemEl.nextElementSibling?.querySelector('button') ??
+        itemEl.previousElementSibling?.querySelector('button') ??
+        cardEl.querySelector('button');
+
+      runScopedTransition(cardEl, () => {
+        itemEl.remove();
+        updateCardPrice(cardEl);
+        if (hadFocus) {
+          nextFocusTarget?.focus();
+        }
+      });
+    }
+
+    const boosterCatalog = [
+      { label: 'Extra Espresso Shot', cost: 1.25 },
+      { label: 'Madagascar Vanilla Bean', cost: 0.75 },
+      { label: 'Salted Caramel Cold Foam', cost: 1.00 },
+      { label: 'Organic Cacao Nibs', cost: 0.50 },
+      { label: 'Cardamom Infusion', cost: 0.65 }
+    ];
+    let boosterCounter = 1;
+
+    /**
+     * Add a customization item scoped to `cardEl` so the card smoothly expands its height.
+     */
+    function addBoosterItem(cardEl) {
+      const listEl = cardEl.querySelector('ul');
+      if (!listEl) return;
+
+      const drinkName = cardEl.dataset.drinkName || 'Drink';
+      const booster = boosterCatalog[(boosterCounter - 1) % boosterCatalog.length];
+      const itemId = `booster-${boosterCounter++}`;
+
+      const li = document.createElement('li');
+      li.dataset.id = itemId;
+      li.dataset.cost = booster.cost.toFixed(2);
+
+      const spanLabel = document.createElement('span');
+      spanLabel.className = 'item-label';
+      spanLabel.textContent = `${booster.label} `;
+
+      const spanCal = document.createElement('span');
+      spanCal.className = 'item-cal';
+      spanCal.textContent = `(+$${booster.cost.toFixed(2)})`;
+      spanLabel.appendChild(spanCal);
+
+      const removeBtn = document.createElement('button');
+      removeBtn.type = 'button';
+      removeBtn.className = 'btn-remove';
+      removeBtn.dataset.action = 'remove';
+      removeBtn.setAttribute('aria-label', `Remove ${booster.label} from ${drinkName}`);
+      removeBtn.textContent = 'Remove';
+
+      li.append(spanLabel, removeBtn);
+
+      runScopedTransition(cardEl, () => {
+        listEl.appendChild(li);
+        updateCardPrice(cardEl);
+      });
+    }
+
+    /**
+     * Toggle tasting notes inside `cardEl` using an element-scoped view transition.
