+        } else {
+          notesEl.setAttribute('hidden', '');
+          buttonEl.setAttribute('aria-expanded', 'false');
+        }
+      });
+    }
+
+    // Event delegation for card-scoped interactions
+    const seasonalGrid = document.getElementById('seasonal-grid');
+
+    seasonalGrid.addEventListener('click', (event) => {
+      const button = event.target.closest('button[data-action]');
+      if (!button) return;
+
+      const cardEl = button.closest('.card');
+      if (!cardEl) return;
+
+      const action = button.dataset.action;
+
+      if (action === 'reorder') {
+        const listEl = cardEl.querySelector('ul');
+        if (!listEl) return;
+        const reversedIds = Array.from(listEl.children, (li) => li.dataset.id).reverse();
+        reorderItems(listEl, reversedIds);
+      } else if (action === 'add') {
+        addBoosterItem(cardEl);
+      } else if (action === 'remove') {
+        const itemEl = button.closest('li');
+        if (itemEl) {
+          removeItem(cardEl, itemEl);
+        }
+      } else if (action === 'notes') {
+        toggleTastingNotes(cardEl, button);
+      }
+    });
+
+    // Outer grid transition: rotates `.card-wrapper` elements while inner `.card` scopes stay isolated
+    document.getElementById('shuffle-cards-btn').addEventListener('click', () => {
+      const wrappers = Array.from(seasonalGrid.children);
+      if (wrappers.length < 2) return;
+
+      runScopedTransition(seasonalGrid, () => {
+        const first = wrappers.shift();
+        seasonalGrid.appendChild(first);
+      });
+    });
+
+    // Trigger concurrent element-scoped transitions across all cards simultaneously
+    document.getElementById('concurrent-demo-btn').addEventListener('click', () => {
+      const cards = seasonalGrid.querySelectorAll('.card');
+      cards.forEach((cardEl) => {
+        const listEl = cardEl.querySelector('ul');
+        if (!listEl) return;
+        const reversedIds = Array.from(listEl.children, (li) => li.dataset.id).reverse();
+        reorderItems(listEl, reversedIds);
+      });
+    });
+  </script>
 </body>
 
