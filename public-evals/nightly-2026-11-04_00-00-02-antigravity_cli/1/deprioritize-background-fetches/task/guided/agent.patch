diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,26 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Fetch Priority Demo</title>
+</head>
+<body>
+  <button id="load-btn" type="button">Load Data</button>
+
+  <script type="module">
+    document.getElementById('load-btn').addEventListener('click', () => {
+      // Use high priority (default) for mission-critical data
+      fetch('/api/data');
+
+      // Explicitly deprioritize background analytics to prevent network contention
+      fetch('/api/analytics', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low'
+      });
+    });
+  </script>
+</body>
+</html>
