+  <script>
+    // Modern Client-Side AI State & Session Management
+    const BARISTA_SYSTEM_PROMPT =
+      'You are a knowledgeable, friendly barista at The Daily Grind Artisanal Coffee. ' +
+      'Answer customer questions specifically about our drinks, especially the Maple Oat Latte ' +
+      '(creamy oat milk, espresso, and pure Vermont maple syrup; 100% plant-based and dairy-free) ' +
+      'and the Cold Brew (ethically sourced beans steeped for 18 hours for maximum smoothness and low acidity).';
+
+    const FEEDBACK_RESPONSE_SCHEMA = {
+      type: 'object',
+      properties: {
+        score: {
+          type: 'number',
+          description: 'Sentiment score from 1 (very negative) to 5 (very positive)'
+        },
+        category: {
+          type: 'string',
+          enum: ['positive', 'neutral', 'negative', 'product_quality', 'service'],
+          description: 'Primary feedback category'
+        }
+      },
+      required: ['score', 'category'],
+      additionalProperties: false
+    };
+
+    let activeSession = null;
+    let activeSessionId = null;
+    let sessionCounter = 0;
+    const sessionRegistry = new Map(); // id -> { id, label, session, createdAt }
+    let currentAbortController = null;
+
+    const askBtn = document.getElementById('ask-the-barista');
+    const questionInput = document.getElementById('barista-question');
+    const baristaAnswer = document.getElementById('barista-answer');
+    const modelStatusEl = document.getElementById('model-status');
+    const contextUsageEl = document.getElementById('context-usage');
+    const progressContainer = document.getElementById('download-progress-container');
+    const progressBar = document.getElementById('download-progress-bar');
+
+    const sentimentBtn = document.getElementById('sentiment-btn');
+    const feedbackInput = document.getElementById('feedback-input');
+    const sentimentOutput = document.getElementById('sentiment-output');
+
+    const cloneBtn = document.getElementById('clone-btn');
+    const cleanupBtn = document.getElementById('cleanup-sessions-btn');
+    const activeSessionInfoEl = document.getElementById('active-session-info');
+    const branchContextStatsEl = document.getElementById('branch-context-stats');
+    const branchListEl = document.getElementById('branch-list');
+
+    // Monitor model download progress using standard monitor callback
+    function createDownloadMonitor(m) {
+      m.addEventListener('downloadprogress', (e) => {
+        const ratio = typeof e.loaded === 'number' ? (e.total ? e.loaded / e.total : e.loaded) : 0;
+        const percent = Math.round(Math.min(1, Math.max(0, ratio)) * 100);
+        progressContainer.style.display = 'block';
+        progressBar.style.width = `${percent}%`;
+        modelStatusEl.textContent = `Downloading model: ${percent}%`;
+        if (percent >= 100) {
+          setTimeout(() => {
+            progressContainer.style.display = 'none';
+          }, 800);
+        }
+      });
+    }
+
+    // Check if the built-in LanguageModel is available before starting
+    async function checkModelAvailability(options = {}) {
+      if (typeof LanguageModel === 'undefined') {
+        modelStatusEl.textContent = 'Model status: Built-in AI API is not supported in this browser.';
+        return 'unavailable';
+      }
+
+      const availability = await LanguageModel.availability(options);
+      modelStatusEl.textContent = `Model status: ${availability}`;
+      return availability;
+    }
+
+    // Track context usage and attach quotaoverflow listeners
+    function updateContextUsageUI(session = activeSession) {
+      if (!session) {
+        contextUsageEl.textContent = 'Context Usage: 0 / 0 tokens';
+        branchContextStatsEl.textContent = 'Usage: 0 / 0 tokens (0%)';
+        activeSessionInfoEl.textContent = 'Active Session: None';
+        renderBranchList();
+        return;
+      }
+
+      const used = session.inputUsage ?? session.tokensSoFar ?? 0;
+      const quota = session.inputQuota ?? session.maxTokens ?? 0;
+      const pct = quota > 0 ? Math.round((used / quota) * 100) : 0;
+
+      contextUsageEl.textContent = `Context Usage: ${used} / ${quota} tokens`;
+      branchContextStatsEl.textContent = `Usage: ${used} / ${quota} tokens (${pct}%)`;
+      activeSessionInfoEl.textContent = `Active Session: ${activeSessionId || 'Primary'}`;
+      renderBranchList();
+    }
+
+    function attachSessionEvents(session, id) {
+      if (typeof session.addEventListener === 'function') {
+        session.addEventListener('quotaoverflow', () => {
+          modelStatusEl.textContent = `Warning: Session ${id} exceeded context quota. Consider cloning or cleaning up sessions.`;
+          updateContextUsageUI(session);
+        });
+      }
+    }
+
+    function registerSession(session, label) {
+      sessionCounter += 1;
+      const id = `session-${sessionCounter}`;
+      attachSessionEvents(session, id);
+      sessionRegistry.set(id, {
+        id,
+        label: label || `Session #${sessionCounter}`,
+        session,
+        createdAt: new Date().toLocaleTimeString()
+      });
+      activeSession = session;
+      activeSessionId = id;
+      updateContextUsageUI(session);
+      return id;
+    }
+
+    function destroySessionById(id) {
+      const entry = sessionRegistry.get(id);
+      if (!entry) return;
+      try {
+        if (typeof entry.session.destroy === 'function') {
+          entry.session.destroy();
+        }
+      } catch (err) {
+        console.warn(`Error destroying session ${id}:`, err);
+      }
+      sessionRegistry.delete(id);
+
+      if (activeSessionId === id) {
+        const remaining = Array.from(sessionRegistry.values());
+        if (remaining.length > 0) {
+          const next = remaining[remaining.length - 1];
+          activeSession = next.session;
+          activeSessionId = next.id;
+        } else {
+          activeSession = null;
+          activeSessionId = null;
+        }
+      }
+      updateContextUsageUI(activeSession);
+    }
+
+    function cleanupUnneededSessions(keepActive = true) {
+      for (const [id, entry] of sessionRegistry.entries()) {
+        if (keepActive && id === activeSessionId) continue;
+        try {
+          if (typeof entry.session.destroy === 'function') {
+            entry.session.destroy();
+          }
+        } catch (err) {
+          console.warn(`Error cleaning up session ${id}:`, err);
+        }
+        sessionRegistry.delete(id);
+      }
+      if (!keepActive) {
+        activeSession = null;
+        activeSessionId = null;
+      }
+      updateContextUsageUI(activeSession);
+    }
+
+    function renderBranchList() {
+      branchListEl.innerHTML = '';
+      if (sessionRegistry.size === 0) {
+        const empty = document.createElement('div');
+        empty.textContent = 'No active sessions.';
+        branchListEl.appendChild(empty);
+        return;
+      }
+
+      for (const [id, entry] of sessionRegistry.entries()) {
+        const used = entry.session.inputUsage ?? entry.session.tokensSoFar ?? 0;
+        const quota = entry.session.inputQuota ?? entry.session.maxTokens ?? 0;
+        const row = document.createElement('div');
+        row.className = 'branch-item';
+
+        const info = document.createElement('span');
+        const isCurrent = id === activeSessionId ? ' (Active)' : '';
+        info.textContent = `${entry.label} [${id}]${isCurrent} — Context: ${used}/${quota} tokens`;
+
+        const actions = document.createElement('div');
+        if (id !== activeSessionId) {
+          const switchBtn = document.createElement('button');
+          switchBtn.className = 'btn btn-secondary';
+          switchBtn.textContent = 'Switch';
+          switchBtn.addEventListener('click', () => {
+            activeSession = entry.session;
+            activeSessionId = id;
+            updateContextUsageUI(activeSession);
+          });
+          actions.appendChild(switchBtn);
+        }
+
+        const destroyBtn = document.createElement('button');
+        destroyBtn.className = 'btn btn-danger';
+        destroyBtn.textContent = 'Destroy';
+        destroyBtn.addEventListener('click', () => {
+          destroySessionById(id);
+        });
+        actions.appendChild(destroyBtn);
+
+        row.appendChild(info);
+        row.appendChild(actions);
+        branchListEl.appendChild(row);
+      }
+    }
+
+    async function ensureBaristaSession() {
+      if (activeSession) {
+        return activeSession;
+      }
+
+      const availability = await checkModelAvailability();
+      if (availability === 'unavailable' || availability === 'no') {
+        throw new Error('Built-in AI model is unavailable on this device.');
+      }
+
+      const session = await LanguageModel.create({
+        initialPrompts: [
+          { role: 'system', content: BARISTA_SYSTEM_PROMPT }
+        ],
+        monitor: createDownloadMonitor
+      });
+
+      registerSession(session, 'Primary Barista Session');
+      modelStatusEl.textContent = 'Model status: available';
+      return session;
+    }
+
+    // 1. Ask the Barista (Streaming Response)
+    askBtn.addEventListener('click', async () => {
+      const question = questionInput.value.trim() || 'Tell me about the Maple Oat Latte and the Cold Brew.';
+      baristaAnswer.textContent = '';
+      askBtn.disabled = true;
+
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+      currentAbortController = new AbortController();
+
+      try {
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable' || availability === 'no') {
+          baristaAnswer.textContent = 'Sorry, the built-in AI model is unavailable on this device.';
+          return;
+        }
+
+        const session = await ensureBaristaSession();
+
+        // Automatically prune unneeded sessions if context usage is nearing quota
+        const used = session.inputUsage ?? 0;
+        const quota = session.inputQuota ?? 0;
+        if (quota > 0 && used / quota > 0.85 && sessionRegistry.size > 1) {
+          cleanupUnneededSessions(true);
+        }
+
+        const stream = session.promptStreaming(question, {
+          signal: currentAbortController.signal
+        });
+
+        for await (const chunk of stream) {
+          baristaAnswer.textContent += chunk;
+        }
+
+        updateContextUsageUI(session);
+      } catch (error) {
+        if (error.name !== 'AbortError') {
+          baristaAnswer.textContent = `Error: ${error.message}`;
+        }
+      } finally {
+        askBtn.disabled = false;
+      }
+    });
+
+    // 2. Customer Feedback Analyzer (Structured JSON output with responseConstraint)
+    sentimentBtn.addEventListener('click', async () => {
+      const feedbackText = feedbackInput.value.trim() || 'The Maple Oat Latte was amazing and the Cold Brew was super smooth!';
+      sentimentOutput.textContent = 'Analyzing feedback...';
+      sentimentBtn.disabled = true;
+
+      let feedbackSession = null;
+      try {
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable' || availability === 'no') {
+          sentimentOutput.textContent = JSON.stringify({
+            error: 'Built-in AI model is unavailable'
+          });
+          return;
+        }
+
+        feedbackSession = await LanguageModel.create({
+          initialPrompts: [
+            {
+              role: 'system',
+              content: 'You are a customer feedback sentiment analyzer for a coffee shop. Respond strictly with JSON matching the requested schema.'
+            }
+          ],
+          monitor: createDownloadMonitor
+        });
+
+        const rawResponse = await feedbackSession.prompt(
+          `Analyze the following customer feedback and return a JSON object with score (1-5) and category:\n\n"${feedbackText}"`,
+          { responseConstraint: FEEDBACK_RESPONSE_SCHEMA }
+        );
+
+        const parsed = JSON.parse(rawResponse);
+        sentimentOutput.textContent = JSON.stringify(parsed, null, 2);
+      } catch (error) {
+        sentimentOutput.textContent = JSON.stringify({
+          error: error.message
+        });
+      } finally {
+        // Clean up dedicated one-off analyzer session immediately to free resources
+        if (feedbackSession && typeof feedbackSession.destroy === 'function') {
+          feedbackSession.destroy();
+        }
+        sentimentBtn.disabled = false;
+      }
+    });
+
+    // 3. Conversation Branching (Cloning active sessions & cleaning up unneeded sessions)
+    cloneBtn.addEventListener('click', async () => {
+      cloneBtn.disabled = true;
+      try {
+        const sessionToClone = await ensureBaristaSession();
+        const clonedSession = await sessionToClone.clone();
+
+        // Keep session footprint bounded by cleaning up older inactive branches before adding more
+        if (sessionRegistry.size >= 3) {
+          cleanupUnneededSessions(true);
+        }
+
+        const newId = registerSession(clonedSession, `Cloned Branch (from ${activeSessionId})`);
+        modelStatusEl.textContent = `Cloned session into ${newId}`;
+      } catch (error) {
+        modelStatusEl.textContent = `Clone failed: ${error.message}`;
+      } finally {
+        cloneBtn.disabled = false;
+      }
+    });
+
+    cleanupBtn.addEventListener('click', () => {
+      cleanupUnneededSessions(true);
+      modelStatusEl.textContent = 'Cleaned up unneeded inactive sessions.';
+    });
+
+    // Clean up all sessions when unloading the page to prevent memory leaks
+    window.addEventListener('pagehide', () => {
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+      cleanupUnneededSessions(false);
+    });
+  </script>
 </body>
 
