+  <script>
+    const VALID_VIEWS = new Set(['menu', 'locations', 'rewards', 'account']);
+
+    function normalizeViewId(rawViewId) {
+      if (!rawViewId) return 'menu';
+      const cleaned = String(rawViewId).replace(/^(\/|#|view-)+/, '').trim().toLowerCase();
+      return VALID_VIEWS.has(cleaned) ? cleaned : 'menu';
+    }
+
+    function switchToView(viewId, { updateHistory = true, moveFocus = true } = {}) {
+      const targetId = normalizeViewId(viewId);
+      const activeView = document.getElementById(targetId);
+      if (!activeView) return;
+
+      // Hide all views while preserving their rendered DOM state in memory via content-visibility: hidden
+      document.querySelectorAll('.spa-view').forEach(view => {
+        view.classList.add('inactive');
+        view.setAttribute('aria-hidden', 'true');
+        view.setAttribute('inert', 'inert');
+      });
+
+      // Show the target view
+      activeView.classList.remove('inactive');
+      activeView.setAttribute('aria-hidden', 'false');
+      activeView.removeAttribute('inert');
+
+      // Update active navigation link styling and aria-current state
+      document.querySelectorAll('nav a[data-view]').forEach(link => {
+        const isCurrent = link.dataset.view === targetId;
+        link.classList.toggle('active', isCurrent);
+        if (isCurrent) {
+          link.setAttribute('aria-current', 'page');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+
+      if (updateHistory) {
+        const targetPath = `/${targetId}`;
+        if (window.location.pathname !== targetPath) {
+          window.history.pushState({ viewId: targetId }, '', targetPath);
+        }
+      }
+
+      if (moveFocus) {
+        // Move focus to the newly revealed view to ensure a logical keyboard tab order
+        activeView.focus({ preventScroll: true });
+      }
+    }
+
+    // Intercept clicks on SPA navigation links
+    document.addEventListener('click', event => {
+      const navLink = event.target.closest('a[data-view]');
+      if (navLink) {
+        event.preventDefault();
+        switchToView(navLink.dataset.view);
+        return;
+      }
+
+      // Interactive state inside Menu view
+      const filterBtn = event.target.closest('.filter-btn[data-category]');
+      if (filterBtn) {
+        const selectedCategory = filterBtn.dataset.category;
+        document.querySelectorAll('.filter-btn[data-category]').forEach(btn => {
+          btn.classList.toggle('active', btn === filterBtn);
+        });
+        filterMenuCards();
+        return;
+      }
+
+      const detailsLink = event.target.closest('a[data-action="toggle-details"]');
+      if (detailsLink) {
+        event.preventDefault();
+        const isExpanded = detailsLink.dataset.expanded === 'true';
+        detailsLink.dataset.expanded = String(!isExpanded);
+        detailsLink.textContent = isExpanded ? 'View Details' : 'Added to Favorites ✓';
+        return;
+      }
+
+      // Interactive state inside Locations view
+      const storeBtn = event.target.closest('.select-store-btn');
+      if (storeBtn) {
+        document.querySelectorAll('.select-store-btn').forEach(btn => {
+          const selected = btn === storeBtn;
+          btn.textContent = selected ? 'Selected Pickup Store ✓' : 'Set as Pickup Store';
+        });
+        return;
+      }
+
+      // Interactive state inside Rewards view
+      const redeemBtn = event.target.closest('.redeem-btn');
+      if (redeemBtn && !redeemBtn.disabled) {
+        redeemBtn.disabled = true;
+        redeemBtn.textContent = 'Reward Claimed ✓';
+      }
+    });
+
+    function filterMenuCards() {
+      const activeBtn = document.querySelector('.filter-btn.active');
+      const category = activeBtn ? activeBtn.dataset.category : 'all';
+      const query = (document.getElementById('menu-search')?.value || '').trim().toLowerCase();
+
+      document.querySelectorAll('#menu-grid .card').forEach(card => {
+        const matchesCategory = category === 'all' || card.dataset.category === category;
+        const matchesQuery = !query || card.textContent.toLowerCase().includes(query);
+        card.hidden = !(matchesCategory && matchesQuery);
+      });
+    }
+
+    document.getElementById('menu-search')?.addEventListener('input', filterMenuCards);
+
+    document.getElementById('location-search')?.addEventListener('input', event => {
+      const query = event.target.value.trim().toLowerCase();
+      document.querySelectorAll('#locations-grid .card').forEach(card => {
+        card.hidden = Boolean(query) && !card.textContent.toLowerCase().includes(query);
+      });
+    });
+
+    document.getElementById('account-preferences-form')?.addEventListener('submit', event => {
+      event.preventDefault();
+      const statusEl = document.getElementById('account-save-status');
+      if (statusEl) {
+        statusEl.textContent = 'Preferences saved for your next order!';
+      }
+    });
+
+    // Sync view state with browser Back/Forward navigation
+    window.addEventListener('popstate', event => {
+      const targetView = event.state?.viewId || normalizeViewId(window.location.pathname || window.location.hash);
+      switchToView(targetView, { updateHistory: false });
+    });
+
+    // Initialize view from current URL path or hash on load without stealing initial focus
+    const initialView = normalizeViewId(window.location.hash || window.location.pathname);
+    switchToView(initialView, { updateHistory: false, moveFocus: false });
+  </script>
+
 </body>
 
 </html>
