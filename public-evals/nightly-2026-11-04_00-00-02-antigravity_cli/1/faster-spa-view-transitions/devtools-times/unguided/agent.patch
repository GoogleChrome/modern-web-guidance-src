-        <main class="bg-white relative">
+        <main class="bg-white relative" data-view-container>
           <slot />
         </main>
       </div>
     </div>
     <Footer />
+    <script>
+      import { swapFunctions } from "astro:transitions/client";
+
+      interface CachedView {
+        main: HTMLElement;
+        title: string;
+      }
+
+      const viewCache = new Map<string, CachedView>();
+      (window as any).__viewCache = viewCache;
+
+      function getCacheKey(url: URL | Location): string {
+        const pathname = url.pathname.replace(/\/+$/, "") || "/";
+        return pathname + url.search;
+      }
+
+      function getMainContainer(
+        root: Document | Element = document
+      ): HTMLElement | null {
+        return (
+          root.querySelector<HTMLElement>("main[data-view-container]") ||
+          root.querySelector<HTMLElement>("main")
+        );
+      }
+
+      function preserveIslands(container: HTMLElement) {
+        container.querySelectorAll("astro-island").forEach((island: any) => {
+          if (island.unmount) {
+            document.removeEventListener("astro:after-swap", island.unmount);
+          }
+          island.unmount = () => {};
+        });
+      }
+
+      function cacheCurrentView(url: URL | Location = window.location) {
+        const currentMain = getMainContainer(document);
+        if (currentMain) {
+          preserveIslands(currentMain);
+          viewCache.set(getCacheKey(url), {
+            main: currentMain,
+            title: document.title,
+          });
+        }
+      }
+
+      cacheCurrentView(window.location);
+
+      document.addEventListener("astro:before-preparation", (event: any) => {
+        cacheCurrentView(event.from || window.location);
+
+        const toKey = getCacheKey(event.to);
+        if (!event.formData && viewCache.has(toKey)) {
+          event.loader = async () => {};
+        }
+      });
+
+      document.addEventListener("astro:before-swap", (event: any) => {
+        const fromKey = getCacheKey(event.from || window.location);
+        const toKey = getCacheKey(event.to);
+
+        event.swap = () => {
+          const currentMain = getMainContainer(document);
+          if (currentMain) {
+            preserveIslands(currentMain);
+            viewCache.set(fromKey, {
+              main: currentMain,
+              title: document.title,
+            });
+          }
+
+          const cached = viewCache.get(toKey);
+          if (cached) {
+            document.title = cached.title;
+            if (currentMain && currentMain !== cached.main) {
+              const restoreFocus = swapFunctions.saveFocus();
+              currentMain.replaceWith(cached.main);
+              preserveIslands(cached.main);
+              restoreFocus();
+            }
+            return;
+          }
+
+          const newDoc: Document = event.newDocument;
+          swapFunctions.deselectScripts(newDoc);
+          swapFunctions.swapRootAttributes(newDoc);
+
+          const existingStyles = Array.from(
+            document.head.querySelectorAll("style, link[rel='stylesheet']")
+          );
+          swapFunctions.swapHeadElements(newDoc);
+          for (const styleEl of existingStyles) {
+            if (!styleEl.isConnected) {
+              document.head.appendChild(styleEl);
+            }
+          }
+
+          const newMain = getMainContainer(newDoc);
+          if (currentMain && newMain) {
+            const restoreFocus = swapFunctions.saveFocus();
+            currentMain.replaceWith(newMain);
+            preserveIslands(newMain);
+            restoreFocus();
+
+            viewCache.set(toKey, {
+              main: newMain,
+              title: document.title,
+            });
+          } else {
+            const restoreFocus = swapFunctions.saveFocus();
+            swapFunctions.swapBodyElement(newDoc.body, document.body);
+            restoreFocus();
+          }
+        };
+      });
+    </script>
