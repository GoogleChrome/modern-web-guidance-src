+    /* Promo Alert */
+    #promo-alert {
+      background: var(--accent);
+      color: var(--text);
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding-inline: 5%;
+      padding-block: 0.75rem;
+      block-size: auto;
+      block-size: calc-size(auto, size);
+      overflow: hidden;
+      transition:
+        block-size 0.4s ease-in-out,
+        padding-block 0.4s ease-in-out,
+        opacity 0.4s ease,
+        display 0.4s;
+      transition-behavior: allow-discrete;
+    }
+
+    #promo-alert:is(.is-dismissed, [hidden], [data-closing]) {
+      block-size: 0;
+      padding-block: 0;
+      opacity: 0;
+      pointer-events: none;
+    }
+
+    #promo-alert[hidden] {
+      display: none;
+    }
+
+    #alert-dismiss {
+      background: transparent;
+      border: 1px solid currentColor;
+      color: inherit;
+      padding: 4px 10px;
+      border-radius: 4px;
+      cursor: pointer;
+      font-weight: 600;
+    }
+
+    /* FAQ Accordion */
+    .faq-section {
+      margin-block-start: 40px;
+    }
+
+    .faq-accordion {
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      margin-block-start: 20px;
+      overflow: hidden;
+    }
+
+    #faq-trigger {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      inline-size: 100%;
+      padding: 16px 20px;
+      background: white;
+      border: none;
+      color: var(--primary);
+      font-size: 1.1rem;
+      font-weight: 600;
+      text-align: start;
+      cursor: pointer;
+    }
+
+    #faq-content {
+      block-size: 0;
+      overflow: hidden;
+      transition:
+        block-size 0.4s ease-out,
+        padding-block 0.4s ease-out;
+      padding-inline: 20px;
+      padding-block: 0;
+    }
+
+    #faq-content.is-expanded,
+    .faq-accordion[open] #faq-content,
+    #faq-trigger[aria-expanded="true"] + #faq-content {
+      block-size: auto;
+      block-size: calc-size(auto, size);
+      padding-block-end: 20px;
+    }
+
+    details.faq-accordion::details-content {
+      block-size: 0;
+      overflow: hidden;
+      transition:
+        block-size 0.4s ease-out,
+        content-visibility 0.4s;
+      transition-behavior: allow-discrete;
+    }
+
+    details.faq-accordion[open]::details-content {
+      block-size: auto;
+      block-size: calc-size(auto, size);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #promo-alert,
+      #faq-content,
+      details.faq-accordion::details-content {
+        transition: none !important;
+      }
+    }
