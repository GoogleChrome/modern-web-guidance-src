+  <script>
+    const syncAria = (el) => {
+      if (!el || typeof el.matches !== 'function') return;
+      el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+    };
+
+    document.addEventListener('blur', (e) => {
+      if (e.target.matches?.('.mailing-list-form input')) {
+        syncAria(e.target);
+      }
+    }, true);
+
+    document.addEventListener('input', (e) => {
+      if (e.target.matches?.('.mailing-list-form input') && e.target.hasAttribute('aria-invalid')) {
+        syncAria(e.target);
+      }
+    });
+  </script>
