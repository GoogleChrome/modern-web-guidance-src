+  <script>
+    (function () {
+      const form = document.getElementById('mailing-list-form');
+      const emailInput = document.getElementById('mailing-list-email');
+      const errorMsg = document.getElementById('mailing-list-error');
+      const successMsg = document.getElementById('mailing-list-success');
+
+      let interacted = false;
+
+      function validateEmailField() {
+        const value = emailInput.value.trim();
+        const isEmpty = value === '';
+        const isInvalidFormat = !isEmpty && !emailInput.validity.valid;
+
+        if (interacted && (isEmpty || isInvalidFormat)) {
+          errorMsg.textContent = isEmpty
+            ? 'Please enter your email address to subscribe.'
+            : 'Please enter a valid email address.';
+          errorMsg.classList.add('visible');
+          emailInput.classList.add('has-error');
+          emailInput.setAttribute('aria-invalid', 'true');
+          return false;
+        } else {
+          errorMsg.classList.remove('visible');
+          emailInput.classList.remove('has-error');
+          emailInput.setAttribute('aria-invalid', 'false');
+          return !isEmpty && !isInvalidFormat;
+        }
+      }
+
+      emailInput.addEventListener('blur', function () {
+        interacted = true;
+        validateEmailField();
+      });
+
+      emailInput.addEventListener('input', function () {
+        successMsg.classList.remove('visible');
+        if (interacted) {
+          validateEmailField();
+        }
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        interacted = true;
+        if (validateEmailField()) {
+          successMsg.classList.add('visible');
+          form.reset();
+          interacted = false;
+        } else {
+          emailInput.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
