+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const statusBox = document.getElementById('newsletter-status');
+
+      function showMessage(message, type) {
+        if (!statusBox) return;
+        statusBox.textContent = message;
+        statusBox.className = 'newsletter-message visible ' + (type === 'success' ? 'success' : 'error');
+      }
+
+      document.addEventListener('securitypolicyviolation', function (event) {
+        const blocked = event.blockedURI || 'an unauthorized destination';
+        showMessage(
+          'Security notice: A request to ' + blocked + ' could not go through because outbound connections are restricted.',
+          'error'
+        );
+      });
+
+      window.addEventListener('unhandledrejection', function (event) {
+        const reason = event && event.reason ? String(event.reason.message || event.reason) : '';
+        if (
+          reason.toLowerCase().includes('failed to fetch') ||
+          reason.toLowerCase().includes('networkerror') ||
+          reason.toLowerCase().includes('content security policy') ||
+          reason.toLowerCase().includes('load failed')
+        ) {
+          showMessage(
+            'Unable to complete the request: the connection was blocked or could not reach the server.',
+            'error'
+          );
+        }
+      });
+
+      if (form) {
+        form.addEventListener('submit', async function (event) {
+          event.preventDefault();
+          const email = emailInput ? emailInput.value.trim() : '';
+          if (!email) {
+            showMessage('Please enter your email address to subscribe.', 'error');
+            return;
+          }
+
+          const endpoint = form.getAttribute('action') || '/newsletter';
+
+          try {
+            const response = await fetch(endpoint, {
+              method: 'POST',
+              headers: {
+                'Content-Type': 'application/json',
+                'Accept': 'application/json'
+              },
+              body: JSON.stringify({ email: email })
+            });
+
+            let data = {};
+            try {
+              data = await response.json();
+            } catch (_) {
+              // Non-JSON response fallback
+            }
+
+            if (!response.ok) {
+              showMessage(
+                data.error || 'Your request could not go through. Please try again later.',
+                'error'
+              );
+              return;
+            }
+
+            showMessage(
+              data.message || 'Thanks for subscribing! Your email has been registered.',
+              'success'
+            );
+            form.reset();
+          } catch (err) {
+            showMessage(
+              'Your request could not go through. Outbound connections to unauthorized servers or unreachable endpoints are blocked.',
+              'error'
+            );
+          }
+        });
+      }
+    })();
+  </script>
