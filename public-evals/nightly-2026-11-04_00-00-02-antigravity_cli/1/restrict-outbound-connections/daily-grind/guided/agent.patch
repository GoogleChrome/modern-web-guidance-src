+  <script nonce="__CSP_NONCE__">
+    const form = document.getElementById('newsletter-form');
+    const emailInput = document.getElementById('newsletter-email');
+    const submitBtn = document.getElementById('newsletter-submit');
+    const statusElement = document.getElementById('newsletter-status');
+
+    function updateStatus(message, state = 'error') {
+      if (!statusElement) return;
+      statusElement.dataset.state = state;
+      statusElement.textContent = message;
+    }
+
+    async function fetchWithPolicyHandling(url, { statusElement: targetStatus = statusElement, ...fetchOptions } = {}) {
+      try {
+        const response = await fetch(url, fetchOptions);
+        const contentType = response.headers.get('content-type') || '';
+        const payload = contentType.includes('application/json')
+          ? await response.json()
+          : await response.text();
+
+        if (!response.ok) {
+          const errorMsg = typeof payload === 'object' && payload?.error
+            ? payload.error
+            : `HTTP ${response.status}`;
+          throw new Error(errorMsg);
+        }
+
+        if (targetStatus) {
+          targetStatus.dataset.state = 'success';
+          targetStatus.textContent = typeof payload === 'object' && payload?.message
+            ? payload.message
+            : `Success: Request to ${url} completed.`;
+        }
+        return { ok: true, body: payload, error: null };
+      } catch (error) {
+        const message = error instanceof Error ? error.message : String(error);
+        if (targetStatus) {
+          targetStatus.dataset.state = 'error';
+          targetStatus.textContent = `Request could not go through: Connection to ${url} was blocked or failed (${message}).`;
+        }
+        return { ok: false, body: null, error };
+      }
+    }
+
+    window.fetchWithPolicyHandling = fetchWithPolicyHandling;
+
+    window.addEventListener('securitypolicyviolation', (event) => {
+      const blockedTarget = event.blockedURI || event.violatedDirective;
+      updateStatus(
+        `Request could not go through: Outbound connection to ${blockedTarget} was blocked by our security policy.`,
+        'error'
+      );
+    });
+
+    emailInput.addEventListener('blur', () => {
+      if (emailInput.value && !emailInput.checkValidity()) {
+        updateStatus('Please enter a valid email address.', 'error');
+      }
+    });
+
+    emailInput.addEventListener('input', () => {
+      emailInput.setCustomValidity('');
+      if (statusElement.dataset.state === 'error') {
+        statusElement.textContent = '';
+        delete statusElement.dataset.state;
+      }
+    });
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+
+      if (!emailInput.checkValidity()) {
+        updateStatus('Please enter a valid email address to subscribe.', 'error');
+        emailInput.focus();
+        return;
+      }
+
+      const email = emailInput.value.trim();
+      const targetUrl = form.getAttribute('action') || '/api/newsletter';
+
+      submitBtn.disabled = true;
+      try {
+        const result = await fetchWithPolicyHandling(targetUrl, {
+          statusElement,
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+            'Accept': 'application/json',
+          },
+          body: JSON.stringify({ email }),
+        });
+
+        if (result.ok) {
+          form.reset();
+        }
+      } finally {
+        submitBtn.disabled = false;
+      }
+    });
+  </script>
