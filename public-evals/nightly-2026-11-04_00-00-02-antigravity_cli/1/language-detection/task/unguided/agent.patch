+  <script>
+    const feedbackTextarea = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const statusEl = document.getElementById('detection-status');
+    const resultEl = document.getElementById('detection-result');
+
+    let detector = null;
+    const languageNames = new Intl.DisplayNames(['en'], { type: 'language' });
+
+    function getLanguageName(code) {
+      if (!code || code === 'und') {
+        return 'Unknown';
+      }
+      try {
+        return languageNames.of(code) || code;
+      } catch {
+        return code;
+      }
+    }
+
+    detectBtn.addEventListener('click', async () => {
+      const text = feedbackTextarea.value.trim();
+      resultEl.textContent = '';
+      statusEl.textContent = '';
+
+      if (!text) {
+        statusEl.textContent = 'Please enter a message to detect its language.';
+        return;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        statusEl.textContent = 'Language Detector API is not supported in this browser.';
+        return;
+      }
+
+      try {
+        detectBtn.disabled = true;
+
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          statusEl.textContent = 'Language detection is unavailable on this device.';
+          return;
+        }
+
+        if (!detector) {
+          if (availability === 'downloadable' || availability === 'downloading') {
+            statusEl.textContent = 'Downloading language detection model: 0%';
+          }
+
+          detector = await LanguageDetector.create({
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const rawProgress = (e.total && e.total > 1) ? (e.loaded / e.total) : e.loaded;
+                const percent = Math.round(rawProgress * 100);
+                statusEl.textContent = `Downloading language detection model: ${percent}%`;
+              });
+            }
+          });
+        }
+
+        statusEl.textContent = '';
+        const results = await detector.detect(text);
+
+        if (results && results.length > 0) {
+          const { detectedLanguage, confidence } = results[0];
+          const languageName = getLanguageName(detectedLanguage);
+          const confidencePercent = (confidence * 100).toFixed(1);
+          resultEl.textContent = `Detected Language: ${languageName} (${detectedLanguage}) — Confidence: ${confidencePercent}%`;
+        } else {
+          resultEl.textContent = 'Could not detect the language.';
+        }
+      } catch (error) {
+        statusEl.textContent = `Error detecting language: ${error.message || error}`;
+      } finally {
+        detectBtn.disabled = false;
+      }
+    });
+  </script>
+
