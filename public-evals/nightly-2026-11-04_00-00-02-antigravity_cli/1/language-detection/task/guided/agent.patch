+  <script>
+    const feedbackTextarea = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const detectStatus = document.getElementById('detect-status');
+    const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+
+    let detectorInstance = null;
+
+    async function initLanguageDetection() {
+      if (!('LanguageDetector' in self)) {
+        detectBtn.disabled = true;
+        detectStatus.textContent = 'Client-side language detection is not supported in this browser.';
+        return;
+      }
+
+      const availability = await LanguageDetector.availability();
+      if (availability === 'unavailable') {
+        detectBtn.disabled = true;
+        detectStatus.textContent = 'Language detection model is unavailable on this device.';
+        return;
+      }
+
+      detectBtn.addEventListener('click', async () => {
+        const text = feedbackTextarea.value.trim();
+        if (!text) {
+          detectStatus.textContent = 'Please enter a message to detect its language.';
+          return;
+        }
+
+        detectBtn.disabled = true;
+        try {
+          if (!detectorInstance) {
+            detectorInstance = await LanguageDetector.create({
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const pct = Math.round(e.loaded * 100);
+                  detectStatus.textContent = `Downloading model: ${pct}%`;
+                });
+              },
+            });
+          }
+
+          const results = await detectorInstance.detect(text);
+          if (results && results.length > 0) {
+            const topResult = results[0];
+            const langName = displayNames.of(topResult.detectedLanguage) || topResult.detectedLanguage;
+            const confidencePct = (topResult.confidence * 100).toFixed(1);
+            detectStatus.textContent = `Detected language: ${langName} (${confidencePct}% confidence)`;
+          } else {
+            detectStatus.textContent = 'Could not determine the language.';
+          }
+        } catch (error) {
+          detectStatus.textContent = `Language detection failed: ${error.message}`;
+        } finally {
+          detectBtn.disabled = false;
+        }
+      });
+    }
+
+    initLanguageDetection();
+  </script>
