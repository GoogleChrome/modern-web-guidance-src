+    /* Hovercard Popover */
+    [popover].hovercard {
+      position-area: block-end span-inline-end;
+      position-try-fallbacks: flip-block, flip-inline;
+      inset: auto;
+      top: anchor(bottom);
+      left: anchor(left);
+      margin: 8px 0 0 0;
+      width: min(320px, 90vw);
+      background: white;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 10px;
+      padding: 16px;
+      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.18);
+      text-align: left;
+      opacity: 0;
+      transform-origin: top;
+    }
+
+    [popover].hovercard:is(:popover-open, .\:popover-open) {
+      opacity: 1;
+      transform: translateY(0) scale(1);
+    }
+
+    @starting-style {
+      [popover].hovercard:is(:popover-open, .\:popover-open) {
+        opacity: 0;
+        transform: translateY(-10px) scale(0.95);
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      [popover].hovercard {
+        transition:
+          opacity,
+          transform,
+          display,
+          overlay;
+        transition-duration: 0.4s;
+        transition-behavior: allow-discrete;
+      }
+    }
+
+    .hovercard img {
+      width: 100%;
+      height: 150px;
+      object-fit: cover;
+      border-radius: 6px;
+      margin-bottom: 12px;
+      display: block;
+    }
+
+    .hovercard-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      margin-bottom: 4px;
+    }
+
+    .hovercard h4 {
+      color: var(--primary);
+      font-size: 1.15rem;
+      margin: 0;
+    }
+
+    .hovercard .price {
+      font-weight: bold;
+      color: var(--primary);
+      font-size: 1rem;
+    }
+
+    .hovercard .byline {
+      font-size: 0.8rem;
+      color: #6d4c41;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      margin-bottom: 8px;
+    }
+
+    .hovercard p {
+      font-size: 0.9rem;
+      margin-bottom: 10px;
+    }
+
+    .hovercard-meta {
+      display: flex;
+      gap: 8px;
+      flex-wrap: wrap;
+      font-size: 0.78rem;
+      border-top: 1px solid var(--secondary);
+      padding-top: 10px;
+    }
+
+    .hovercard-tag {
+      background: var(--light);
+      border: 1px solid var(--secondary);
+      padding: 2px 8px;
+      border-radius: 999px;
+      color: var(--primary);
+    }
