+  <script>
+    (function () {
+      const wrappers = document.querySelectorAll('.hovercard-wrapper');
+
+      wrappers.forEach((wrapper) => {
+        const trigger = wrapper.querySelector('.hovercard-trigger');
+        const card = wrapper.querySelector('.hovercard');
+        if (!trigger || !card) return;
+
+        let hideTimeout = null;
+
+        const showCard = () => {
+          clearTimeout(hideTimeout);
+          wrappers.forEach((other) => {
+            if (other !== wrapper) {
+              const otherCard = other.querySelector('.hovercard');
+              const otherTrigger = other.querySelector('.hovercard-trigger');
+              if (otherCard) otherCard.classList.remove('is-visible');
+              if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
+            }
+          });
+          card.classList.add('is-visible');
+          trigger.setAttribute('aria-expanded', 'true');
+        };
+
+        const hideCard = () => {
+          hideTimeout = setTimeout(() => {
+            card.classList.remove('is-visible');
+            trigger.setAttribute('aria-expanded', 'false');
+          }, 140);
+        };
+
+        wrapper.addEventListener('mouseenter', showCard);
+        wrapper.addEventListener('mouseleave', hideCard);
+        wrapper.addEventListener('focusin', showCard);
+        wrapper.addEventListener('focusout', (e) => {
+          if (!wrapper.contains(e.relatedTarget)) {
+            hideCard();
+          }
+        });
+
+        // Interactive size/pull selector inside each hovercard
+        const sizeButtons = card.querySelectorAll('.hovercard-size-btn');
+        const priceEl = card.querySelector('[data-price]');
+        const calEl = card.querySelector('[data-calories]');
+        const cafEl = card.querySelector('[data-caffeine]');
+
+        sizeButtons.forEach((btn) => {
+          btn.addEventListener('click', (e) => {
+            e.preventDefault();
+            e.stopPropagation();
+            sizeButtons.forEach((b) => b.classList.remove('active'));
+            btn.classList.add('active');
+            if (priceEl && btn.dataset.priceVal) priceEl.textContent = btn.dataset.priceVal;
+            if (calEl && btn.dataset.calVal) calEl.textContent = btn.dataset.calVal;
+            if (cafEl && btn.dataset.cafVal) cafEl.textContent = btn.dataset.cafVal;
+          });
+        });
+
+        // Interactive Quick Add feedback inside each hovercard
+        const quickAddBtn = card.querySelector('.hovercard-quick-add');
+        if (quickAddBtn) {
+          quickAddBtn.addEventListener('click', (e) => {
+            e.preventDefault();
+            e.stopPropagation();
+            const activeSize = card.querySelector('.hovercard-size-btn.active');
+            const sizeLabel = activeSize ? activeSize.dataset.size : '';
+            quickAddBtn.textContent = `Added (${sizeLabel}) ✓`;
+            setTimeout(() => {
+              quickAddBtn.textContent = '+ Quick Add';
+            }, 1600);
+          });
+        }
+      });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape') {
+          wrappers.forEach((wrapper) => {
+            const card = wrapper.querySelector('.hovercard');
+            const trigger = wrapper.querySelector('.hovercard-trigger');
+            if (card) card.classList.remove('is-visible');
+            if (trigger) trigger.setAttribute('aria-expanded', 'false');
+          });
+        }
+      });
+    })();
+  </script>
 </body>
 
