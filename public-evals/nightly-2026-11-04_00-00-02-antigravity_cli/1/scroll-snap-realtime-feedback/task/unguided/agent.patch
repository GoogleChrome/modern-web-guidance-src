+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      if (!gallery) return;
+
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+      let snapChangedDuringScroll = false;
+
+      function setPendingThumbnail(pendingIndex) {
+        thumbnails.forEach((thumb, i) => {
+          thumb.classList.toggle('pending', i === pendingIndex);
+        });
+      }
+
+      function setActiveThumbnail(activeIndex) {
+        thumbnails.forEach((thumb, i) => {
+          thumb.classList.remove('pending');
+          if (i === activeIndex) {
+            thumb.classList.add('active');
+            thumb.setAttribute('aria-current', 'true');
+          } else {
+            thumb.classList.remove('active');
+            thumb.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function getSnappedIndex() {
+        const galleryRect = gallery.getBoundingClientRect();
+        const galleryCenter = galleryRect.left + galleryRect.width / 2;
+        let closestIndex = 0;
+        let minDistance = Infinity;
+
+        items.forEach((item, i) => {
+          const rect = item.getBoundingClientRect();
+          const itemCenter = rect.left + rect.width / 2;
+          const distance = Math.abs(itemCenter - galleryCenter);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestIndex = i;
+          }
+        });
+
+        return closestIndex;
+      }
+
+      gallery.addEventListener('scrollsnapchanging', (event) => {
+        snapChangedDuringScroll = false;
+        const target = event.snapTargetInline || event.snapTargetBlock;
+        const targetItem = target ? target.closest('.gallery-item') : null;
+        const index = items.indexOf(targetItem);
+        if (index !== -1) {
+          setPendingThumbnail(index);
+        }
+      });
+
+      gallery.addEventListener('scrollsnapchange', (event) => {
+        const target = event.snapTargetInline || event.snapTargetBlock;
+        const targetItem = target ? target.closest('.gallery-item') : null;
+        const index = items.indexOf(targetItem);
+        if (index !== -1) {
+          snapChangedDuringScroll = true;
+          setActiveThumbnail(index);
+        }
+      });
+
+      gallery.addEventListener('scrollend', () => {
+        thumbnails.forEach((thumb) => thumb.classList.remove('pending'));
+        if (!snapChangedDuringScroll) {
+          const index = getSnappedIndex();
+          if (index !== -1) {
+            setActiveThumbnail(index);
+          }
+        }
+        snapChangedDuringScroll = false;
+      });
+
+      thumbnails.forEach((thumb, index) => {
+        thumb.addEventListener('click', () => {
+          const targetItem = items[index];
+          if (targetItem) {
+            setPendingThumbnail(index);
+            gallery.scrollTo({
+              left: targetItem.offsetLeft,
+              behavior: 'smooth'
+            });
+          }
+        });
+      });
+    })();
+  </script>
+
