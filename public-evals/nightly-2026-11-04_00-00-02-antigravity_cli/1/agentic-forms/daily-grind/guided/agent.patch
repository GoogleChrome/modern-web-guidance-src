+  <script>
+    const COFFEE_CATALOG = [
+      {
+        name: 'Maple Oat Latte',
+        temperature: 'hot',
+        roast: 'medium',
+        milk: ['oat', 'whole', 'almond', 'coconut'],
+        notes: ['maple', 'creamy', 'sweet', 'oat', 'seasonal', 'smooth'],
+        description: 'Creamy oat milk with a hint of Vermont maple syrup and smooth medium-roast espresso.',
+        price: '$5.50'
+      },
+      {
+        name: 'Dark Roast Espresso',
+        temperature: 'hot',
+        roast: 'dark',
+        milk: ['black', 'whole', 'oat'],
+        notes: ['bold', 'smokey', 'dark chocolate', 'rich', 'intense'],
+        description: 'Bold, smokey, and full-bodied single-origin espresso shot.',
+        price: '$3.75'
+      },
+      {
+        name: '18-Hour Cold Brew',
+        temperature: 'iced',
+        roast: 'medium',
+        milk: ['black', 'oat', 'whole', 'almond', 'coconut'],
+        notes: ['smooth', 'chocolate', 'caramel', 'refreshing', 'cold'],
+        description: 'Steeped for 18 hours for maximum smoothness with subtle cocoa notes.',
+        price: '$4.75'
+      },
+      {
+        name: 'Ethiopian Yirgacheffe Pour-Over',
+        temperature: 'hot',
+        roast: 'light',
+        milk: ['black'],
+        notes: ['citrus', 'floral', 'bright', 'bergamot', 'fruity'],
+        description: 'Delicate hand-poured light roast bursting with jasmine and bergamot citrus.',
+        price: '$5.25'
+      },
+      {
+        name: 'Iced Caramel Cloud Macchiato',
+        temperature: 'iced',
+        roast: 'medium',
+        milk: ['whole', 'oat', 'almond', 'coconut'],
+        notes: ['caramel', 'vanilla', 'sweet', 'creamy', 'iced'],
+        description: 'Chilled espresso layered over frothy milk and finished with artisanal caramel drizzle.',
+        price: '$5.75'
+      },
+      {
+        name: 'Smokey Campfire Mocha',
+        temperature: 'hot',
+        roast: 'dark',
+        milk: ['whole', 'oat', 'coconut'],
+        notes: ['chocolate', 'smokey', 'cocoa', 'rich', 'sweet'],
+        description: 'Dark roast espresso blended with bittersweet ganache and steamed milk.',
+        price: '$5.50'
+      }
+    ];
+
+    const form = document.getElementById('coffee-finder-form');
+    const resultsContainer = document.getElementById('finder-results');
+    const resultsTitle = document.getElementById('results-title');
+    const resultsList = document.getElementById('results-list');
+
+    function validateFinderForm(formData) {
+      const errors = [];
+      const validTemps = ['any', 'hot', 'iced'];
+      const validRoasts = ['any', 'light', 'medium', 'dark'];
+      const validMilks = ['any', 'black', 'oat', 'whole', 'almond', 'coconut'];
+
+      const temperature = formData.get('temperature') || 'any';
+      const roast = formData.get('roast') || 'any';
+      const milk = formData.get('milk') || 'any';
+      const flavorNotes = (formData.get('flavorNotes') || '').trim();
+
+      if (!validTemps.includes(temperature)) {
+        errors.push({ field: 'temperature', message: 'Select any, hot, or iced' });
+      }
+      if (!validRoasts.includes(roast)) {
+        errors.push({ field: 'roast', message: 'Select any, light, medium, or dark' });
+      }
+      if (!validMilks.includes(milk)) {
+        errors.push({ field: 'milk', message: 'Select a valid milk or base option' });
+      }
+      if (flavorNotes.length > 80) {
+        errors.push({ field: 'flavorNotes', message: 'Keep flavor notes under 80 characters' });
+      }
+      return errors;
+    }
+
+    function findMatchingCoffees(formData) {
+      const temperature = formData.get('temperature') || 'any';
+      const roast = formData.get('roast') || 'any';
+      const milk = formData.get('milk') || 'any';
+      const rawNotes = (formData.get('flavorNotes') || '').trim().toLowerCase();
+
+      const matches = COFFEE_CATALOG.filter((item) => {
+        const tempMatch = temperature === 'any' || item.temperature === temperature;
+        const roastMatch = roast === 'any' || item.roast === roast;
+        const milkMatch = milk === 'any' || item.milk.includes(milk);
+        const noteMatch =
+          !rawNotes ||
+          item.name.toLowerCase().includes(rawNotes) ||
+          item.description.toLowerCase().includes(rawNotes) ||
+          item.notes.some((n) => n.includes(rawNotes) || rawNotes.includes(n));
+        return tempMatch && roastMatch && milkMatch && noteMatch;
+      });
+
+      return matches.length > 0 ? matches : COFFEE_CATALOG.slice(0, 2);
+    }
+
+    function renderMatches(matches, hadExactMatch) {
+      resultsList.replaceChildren();
+      resultsTitle.textContent = hadExactMatch
+        ? `Recommended Brews (${matches.length})`
+        : 'No Exact Match — Try Our Top Barista Picks';
+
+      for (const item of matches) {
+        const li = document.createElement('li');
+        li.className = 'result-item';
+
+        const header = document.createElement('strong');
+        header.textContent = `${item.name} — ${item.price} (${item.temperature}, ${item.roast} roast)`;
+
+        const desc = document.createElement('p');
+        desc.textContent = item.description;
+
+        li.append(header, desc);
+        resultsList.appendChild(li);
+      }
+
+      resultsContainer.hidden = false;
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      const formData = new FormData(form);
+      const validationErrors = validateFinderForm(formData);
+
+      if (validationErrors.length > 0) {
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          const errorString =
+            'Validation failed: ' +
+            validationErrors.map((err) => `${err.field} (${err.message})`).join(', ');
+          event.respondWith(Promise.resolve(errorString));
+        }
+        return;
+      }
+
+      const temperature = formData.get('temperature') || 'any';
+      const roast = formData.get('roast') || 'any';
+      const milk = formData.get('milk') || 'any';
+      const rawNotes = (formData.get('flavorNotes') || '').trim().toLowerCase();
+
+      const exactMatches = COFFEE_CATALOG.filter((item) => {
+        const tempMatch = temperature === 'any' || item.temperature === temperature;
+        const roastMatch = roast === 'any' || item.roast === roast;
+        const milkMatch = milk === 'any' || item.milk.includes(milk);
+        const noteMatch =
+          !rawNotes ||
+          item.name.toLowerCase().includes(rawNotes) ||
+          item.description.toLowerCase().includes(rawNotes) ||
+          item.notes.some((n) => n.includes(rawNotes) || rawNotes.includes(n));
+        return tempMatch && roastMatch && milkMatch && noteMatch;
+      });
+
+      const matches = exactMatches.length > 0 ? exactMatches : COFFEE_CATALOG.slice(0, 2);
+      renderMatches(matches, exactMatches.length > 0);
+
+      if (event.agentInvoked && typeof event.respondWith === 'function') {
+        const summary = matches
+          .map((m) => `${m.name} (${m.price}, ${m.temperature}, ${m.roast} roast): ${m.description}`)
+          .join(' | ');
+        const prefix = exactMatches.length > 0
+          ? `Found ${exactMatches.length} matching coffee(s): `
+          : 'No exact match found; returning top barista picks: ';
+        event.respondWith(Promise.resolve(prefix + summary));
+      }
+    });
+
+    // WebMCP Lifecycle Events (document.modelContext in Chrome 156+, fallback to window)
+    const targetFor = (type, listener, options) =>
+      (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+        .addEventListener(type, listener, options);
+
+    targetFor('toolactivated', ({ toolName }) => {
+      console.log(`Tool "${toolName}" started execution.`);
+    });
+
+    targetFor('toolcancel', ({ toolName }) => {
+      console.log(`Tool "${toolName}" execution is cancelled.`);
+    });
+  </script>
 </body>
 
