+  <script>
+    (function () {
+      const form = document.getElementById('coffee-order-form');
+      const resultBox = document.getElementById('order-result');
+      const summaryText = document.getElementById('order-summary-text');
+
+      if (!form) return;
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+
+        const formData = new FormData(form);
+        const orderDetails = {
+          orderId: 'DG-' + Math.floor(1000 + Math.random() * 9000),
+          drink: formData.get('drink') || 'Maple Oat Latte',
+          size: formData.get('size') || 'Medium',
+          temperature: formData.get('temperature') || 'Hot',
+          milk: formData.get('milk') || 'Oat Milk',
+          roast: formData.get('roast') || 'Medium',
+          customerName: formData.get('customerName') || 'Guest',
+          notes: formData.get('notes') || 'None',
+          estimatedReadyMinutes: 5,
+          status: 'confirmed'
+        };
+
+        const milkNote = orderDetails.milk === 'None' ? 'black (no milk)' : 'with ' + orderDetails.milk;
+        const instructionsNote = orderDetails.notes && orderDetails.notes !== 'None'
+          ? ' (' + orderDetails.notes + ')'
+          : '';
+        const message = 'Thanks, ' + orderDetails.customerName + '! Your ' +
+          orderDetails.size + ' ' + orderDetails.temperature + ' ' +
+          orderDetails.drink + ' (' + orderDetails.roast + ' roast, ' + milkNote + ')' +
+          instructionsNote + ' is being prepared. Order #' + orderDetails.orderId +
+          ' will be ready in ~' + orderDetails.estimatedReadyMinutes + ' mins.';
+
+        if (summaryText && resultBox) {
+          summaryText.textContent = message;
+          resultBox.classList.add('visible');
+        }
+
+        if (typeof event.respondWith === 'function') {
+          event.respondWith(
+            Promise.resolve({
+              status: 'success',
+              message: message,
+              order: orderDetails
+            })
+          );
+        }
+      });
+    })();
+  </script>
+
