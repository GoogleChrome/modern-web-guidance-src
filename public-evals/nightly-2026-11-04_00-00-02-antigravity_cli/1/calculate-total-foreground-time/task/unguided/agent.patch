@@ -206,7 +206,53 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      let accumulatedForegroundTime = 0;
+      let foregroundStartTime = document.visibilityState === 'visible' ? performance.now() : null;
+
+      function updateForegroundTime() {
+        if (document.visibilityState === 'visible') {
+          if (foregroundStartTime === null) {
+            foregroundStartTime = performance.now();
+          }
+        } else {
+          if (foregroundStartTime !== null) {
+            accumulatedForegroundTime += performance.now() - foregroundStartTime;
+            foregroundStartTime = null;
+          }
+        }
+      }
+
+      document.addEventListener('visibilitychange', updateForegroundTime);
+
+      window.addEventListener('pagehide', () => {
+        if (foregroundStartTime !== null) {
+          accumulatedForegroundTime += performance.now() - foregroundStartTime;
+          foregroundStartTime = null;
+        }
+      });
+
+      window.addEventListener('pageshow', () => {
+        if (document.visibilityState === 'visible' && foregroundStartTime === null) {
+          foregroundStartTime = performance.now();
+        }
+      });
+
+      function getTotalForegroundTime() {
+        let total = accumulatedForegroundTime;
+        if (document.visibilityState === 'visible' && foregroundStartTime !== null) {
+          total += performance.now() - foregroundStartTime;
+        }
+        return total;
+      }
+
+      window.getTotalForegroundTime = getTotalForegroundTime;
+      window.calculateTotalForegroundTime = getTotalForegroundTime;
+      window.getForegroundTime = getTotalForegroundTime;
+    })();
+  </script>
 </body>
 
 </html>
