+            <a href="#get-started" id="hero-cta-btn" class="btn btn-primary btn-lg" data-experiment-id="hero-cta">
+              Start Building Free
+            </a>
+            <a href="#demo" class="btn btn-secondary btn-lg">
+              Book a Live Demo
+            </a>
+          </div>
+          <p class="hero-footnote">
+            No credit card required · 14-day Pro trial · SOC2 Type II Certified
