+  <title>NextGen Platform — Ship Faster with Confidence</title>
+  <meta name="description" content="Accelerate your workflow with automated deployments, real-time analytics, and seamless team collaboration." />
+
+  <!-- Preconnect to external domains to minimize connection latency -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin />
+  <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
+
+  <!--
+    Non-blocking Anti-Flicker / FOOC Prevention Pattern:
+    1. Apply an `.anti-flicker-hide` class to `<html>` synchronously before first paint.
+    2. Scope opacity hiding strictly to the experiment target elements (rather than blocking
+       the entire page parse with a synchronous script or hiding the whole body), preserving
+       First Contentful Paint (FCP) and Largest Contentful Paint (LCP) on unaffected elements.
+    3. Load the A/B testing SDK asynchronously (`async`) so HTML parsing and image/resource
+       discovery are never render-blocked.
+    4. Reveal the experiment elements immediately once the SDK loads (or errors), with a
+       hard fallback timeout (1500ms) so users are never stuck if the CDN hangs.
+  -->
+  <style>
+    .anti-flicker-hide [data-experiment-target] {
+      opacity: 0 !important;
+      pointer-events: none !important;
+    }
+    [data-experiment-target] {
+      transition: opacity 0.15s ease-in-out;
+    }
+  </style>
+  <script>
+    (function () {
+      var docEl = document.documentElement;
+      docEl.classList.add('anti-flicker-hide');
+
+      var revealed = false;
+      function revealExperimentContent() {
+        if (revealed) return;
+        revealed = true;
+        docEl.classList.remove('anti-flicker-hide');
+      }
+
+      // Expose reveal hook globally in case the SDK invokes a completion callback
+      window.__onExperimentReady = revealExperimentContent;
+
+      // Hard safety timeout so content is guaranteed to render even on slow/failed networks
+      var fallbackTimer = setTimeout(revealExperimentContent, 1500);
+
+      window.__handleExperimentSdkSettled = function () {
+        clearTimeout(fallbackTimer);
+        // Allow microtask/synchronous DOM updates from the SDK to complete before revealing
+        requestAnimationFrame(revealExperimentContent);
+      };
+    })();
+  </script>
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    onload="window.__handleExperimentSdkSettled && window.__handleExperimentSdkSettled()"
+    onerror="window.__handleExperimentSdkSettled && window.__handleExperimentSdkSettled()"
+  ></script>
+
+  <link rel="stylesheet" href="styles.css" />
+</head>
