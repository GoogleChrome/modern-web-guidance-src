+  <script>
+    const canvas = document.getElementById('gift_card_canvas');
+    const ctx = canvas.getContext('2d');
+    const exportElement = document.getElementById('export_element');
+    const recipientInput = document.getElementById('recipient_input');
+    const messageInput = document.getElementById('message_input');
+    const bgColorInput = document.getElementById('bg_color_input');
+    const colorSwatches = document.querySelectorAll('.color-swatch');
+    const cardRecipientText = document.getElementById('card_recipient_text');
+    const cardMessageText = document.getElementById('card_message_text');
+    const exportBtn = document.getElementById('export_btn');
+    const fallbackWarning = document.getElementById('fallback_warning');
+
+    const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+    function drawFallbackCard() {
+      const dpr = window.devicePixelRatio || 1;
+      const width = canvas.width / dpr || 420;
+      const height = canvas.height / dpr || 250;
+      ctx.save();
+      ctx.clearRect(0, 0, canvas.width, canvas.height);
+      ctx.scale(dpr, dpr);
+
+      // Card background
+      ctx.fillStyle = bgColorInput.value || '#4e342e';
+      ctx.beginPath();
+      if (ctx.roundRect) {
+        ctx.roundRect(0, 0, width, height, 12);
+      } else {
+        ctx.rect(0, 0, width, height);
+      }
+      ctx.fill();
+
+      // Subtle inner border
+      ctx.strokeStyle = 'rgba(255, 171, 64, 0.35)';
+      ctx.lineWidth = 2;
+      ctx.stroke();
+
+      // Header text
+      ctx.fillStyle = '#ffab40';
+      ctx.font = 'bold 15px "Segoe UI", Tahoma, sans-serif';
+      ctx.fillText('THE DAILY GRIND', 24, 42);
+
+      ctx.fillStyle = '#ffffff';
+      ctx.font = '600 13px "Segoe UI", Tahoma, sans-serif';
+      ctx.textAlign = 'right';
+      ctx.fillText('$25 GIFT CARD', width - 24, 42);
+      ctx.textAlign = 'left';
+
+      // Divider
+      ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
+      ctx.lineWidth = 1;
+      ctx.beginPath();
+      ctx.moveTo(24, 56);
+      ctx.lineTo(width - 24, 56);
+      ctx.stroke();
+
+      // Message
+      ctx.fillStyle = '#ffffff';
+      ctx.font = '600 18px "Segoe UI", Tahoma, sans-serif';
+      ctx.fillText(cardMessageText.textContent, 24, 130, width - 48);
+
+      // Footer
+      ctx.font = '14px "Segoe UI", Tahoma, sans-serif';
+      ctx.fillText('For: ' + cardRecipientText.textContent, 24, height - 24);
+      ctx.textAlign = 'right';
+      ctx.fillText('ARTISANAL ROASTERS', width - 24, height - 24);
+      ctx.restore();
+    }
+
+    function requestCanvasUpdate() {
+      if (supportsHtmlInCanvas && typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      } else {
+        drawFallbackCard();
+      }
+    }
+
+    if (supportsHtmlInCanvas) {
+      // Render the HTML content to the canvas inside a canvas.onpaint event handler
+      canvas.onpaint = (event) => {
+        ctx.reset();
+        // Draw #export_element at x:0, y:0; 2D drawElementImage syncs geometry automatically
+        ctx.drawElementImage(exportElement, 0, 0);
+      };
+    } else {
+      fallbackWarning.style.display = 'block';
+    }
+
+    // Scale canvas grid to match the device scale factor using ResizeObserver
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+      requestCanvasUpdate();
+    });
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== 'undefined' &&
+      'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+    const options = supportsDevicePixelContentBox
+      ? { box: 'device-pixel-content-box' }
+      : {};
+    observer.observe(canvas, options);
+
+    // Sync user inputs with the drawable HTML card element
+    recipientInput.addEventListener('input', () => {
+      cardRecipientText.textContent = recipientInput.value.trim() || 'Coffee Lover';
+      requestCanvasUpdate();
+    });
+
+    messageInput.addEventListener('input', () => {
+      cardMessageText.textContent = messageInput.value.trim() || 'Enjoy a warm cup on me!';
+      requestCanvasUpdate();
+    });
+
+    function updateCardBackground(color) {
+      exportElement.style.backgroundColor = color;
+      bgColorInput.value = color;
+      colorSwatches.forEach((swatch) => {
+        swatch.classList.toggle('active', swatch.dataset.color.toLowerCase() === color.toLowerCase());
+      });
+      requestCanvasUpdate();
+    }
+
+    bgColorInput.addEventListener('input', (e) => {
+      updateCardBackground(e.target.value);
+    });
+
+    colorSwatches.forEach((swatch) => {
+      swatch.addEventListener('click', () => {
+        updateCardBackground(swatch.dataset.color);
+      });
+    });
+
+    // Export and download the canvas content as a PNG image
+    exportBtn.addEventListener('click', () => {
+      if (!supportsHtmlInCanvas) {
+        drawFallbackCard();
+      }
+      const dataURL = canvas.toDataURL('image/png');
+      const link = document.createElement('a');
+      link.download = 'daily-grind-gift-card.png';
+      link.href = dataURL;
+      link.click();
+    });
+  </script>
+
