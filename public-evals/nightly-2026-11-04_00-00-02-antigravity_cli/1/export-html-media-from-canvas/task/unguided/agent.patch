+  <script>
+    (function () {
+      const canvas = document.getElementById('gift_card_canvas');
+      const ctx = canvas.getContext('2d');
+      const exportElement = document.getElementById('export_element');
+      const recipientInput = document.getElementById('recipient_input');
+      const messageInput = document.getElementById('message_input');
+      const bgColorInput = document.getElementById('bg_color_input');
+      const colorSwatches = document.querySelectorAll('.color-swatch');
+      const cardRecipientText = document.getElementById('card_recipient_text');
+      const cardMessageText = document.getElementById('card_message_text');
+      const exportBtn = document.getElementById('export_btn');
+
+      // Feature detection for HTML-in-Canvas APIs
+      function supportsHtmlInCanvas() {
+        return Boolean(
+          ctx &&
+          (typeof ctx.drawElementImage === 'function' ||
+            typeof ctx.drawElement === 'function' ||
+            'layoutSubtree' in canvas ||
+            canvas.hasAttribute('layoutsubtree'))
+        );
+      }
+
+      // Render #export_element onto the 2D canvas context
+      function renderElementToCanvas() {
+        if (!ctx || !exportElement) return;
+
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        }
+
+        if (typeof ctx.drawElementImage === 'function') {
+          const transform = ctx.drawElementImage(exportElement, 0, 0);
+          if (transform) {
+            exportElement.style.transform = transform.toString();
+          }
+          return;
+        }
+
+        if (typeof ctx.drawElement === 'function') {
+          const transform = ctx.drawElement(exportElement, 0, 0);
+          if (transform) {
+            exportElement.style.transform = transform.toString();
+          }
+          return;
+        }
+
+        // Fallback 2D drawing when experimental HTML-in-Canvas flag is not enabled
+        const bgColor = exportElement.style.backgroundColor || bgColorInput.value || '#4e342e';
+        ctx.fillStyle = bgColor;
+        if (typeof ctx.roundRect === 'function') {
+          ctx.beginPath();
+          ctx.roundRect(0, 0, canvas.width, canvas.height, 14);
+          ctx.fill();
+        } else {
+          ctx.fillRect(0, 0, canvas.width, canvas.height);
+        }
+
+        ctx.fillStyle = '#ffab40';
+        ctx.font = 'bold 17px Segoe UI, sans-serif';
+        ctx.fillText('THE DAILY GRIND', 28, 46);
+
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.2)';
+        ctx.fillRect(canvas.width - 145, 26, 117, 28);
+        ctx.fillStyle = '#ffffff';
+        ctx.font = '600 13px Segoe UI, sans-serif';
+        ctx.fillText('$25 GIFT CARD', canvas.width - 135, 45);
+
+        ctx.font = '600 20px Segoe UI, sans-serif';
+        const message = cardMessageText.textContent || '';
+        ctx.fillText(message.slice(0, 38), 28, 125);
+        if (message.length > 38) {
+          ctx.fillText(message.slice(38, 76), 28, 152);
+        }
+
+        ctx.font = '15px Segoe UI, sans-serif';
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
+        ctx.fillText('For: ' + (cardRecipientText.textContent || ''), 28, 185);
+
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
+        ctx.beginPath();
+        ctx.moveTo(28, 212);
+        ctx.lineTo(canvas.width - 28, 212);
+        ctx.stroke();
+
+        ctx.font = '12px Segoe UI, sans-serif';
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.75)';
+        ctx.fillText('ARTISANAL COFFEE CO.', 28, 232);
+        ctx.fillText('REDEEMABLE AT ANY LOCATION', canvas.width - 215, 232);
+      }
+
+      // Synchronize with the browser paint event lifecycle
+      canvas.onpaint = () => {
+        renderElementToCanvas();
+      };
+      canvas.addEventListener('paint', renderElementToCanvas);
+
+      function requestCanvasPaint() {
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          renderElementToCanvas();
+        }
+      }
+
+      // Keep canvas dimensions crisp on resize if devicePixelContentBoxSize is available
+      if (typeof ResizeObserver !== 'undefined') {
+        const observer = new ResizeObserver((entries) => {
+          for (const entry of entries) {
+            if (entry.devicePixelContentBoxSize && entry.devicePixelContentBoxSize[0]) {
+              const width = entry.devicePixelContentBoxSize[0].inlineSize;
+              const height = entry.devicePixelContentBoxSize[0].blockSize;
+              if (width > 0 && height > 0 && (canvas.width !== width || canvas.height !== height)) {
+                canvas.width = width;
+                canvas.height = height;
+              }
+            }
+          }
+          requestCanvasPaint();
+        });
+        try {
+          observer.observe(canvas, { box: 'device-pixel-content-box' });
+        } catch (e) {
+          observer.observe(canvas);
+        }
+      }
+
+      // Update recipient name
+      recipientInput.addEventListener('input', (e) => {
+        cardRecipientText.textContent = e.target.value || 'Coffee Lover';
+        requestCanvasPaint();
+      });
+
+      // Update custom message
+      messageInput.addEventListener('input', (e) => {
+        cardMessageText.textContent = e.target.value || 'Enjoy a cup on me!';
+        requestCanvasPaint();
+      });
+
+      // Update background color
+      function setCardBackgroundColor(color) {
+        exportElement.style.backgroundColor = color;
+        bgColorInput.value = color;
+        colorSwatches.forEach((swatch) => {
+          swatch.classList.toggle('active', swatch.dataset.color.toLowerCase() === color.toLowerCase());
+        });
+        requestCanvasPaint();
+      }
+
+      bgColorInput.addEventListener('input', (e) => {
+        setCardBackgroundColor(e.target.value);
+      });
+
+      colorSwatches.forEach((swatch) => {
+        swatch.addEventListener('click', () => {
+          setCardBackgroundColor(swatch.dataset.color);
+        });
+      });
+
+      // Export and download the canvas as a PNG image
+      function downloadCanvasImage() {
+        const triggerDownload = (url, revokeAfter) => {
+          const link = document.createElement('a');
+          link.href = url;
+          link.download = 'daily-grind-gift-card.png';
+          document.body.appendChild(link);
+          link.click();
+          document.body.removeChild(link);
+          if (revokeAfter) {
+            setTimeout(() => URL.revokeObjectURL(url), 100);
+          }
+        };
+
+        if (typeof canvas.toBlob === 'function') {
+          canvas.toBlob((blob) => {
+            if (blob) {
+              const url = URL.createObjectURL(blob);
+              triggerDownload(url, true);
+            } else {
+              triggerDownload(canvas.toDataURL('image/png'), false);
+            }
+          }, 'image/png');
+        } else {
+          triggerDownload(canvas.toDataURL('image/png'), false);
+        }
+      }
+
+      exportBtn.addEventListener('click', () => {
+        if (supportsHtmlInCanvas() && typeof canvas.requestPaint === 'function') {
+          let exported = false;
+          const handleExportPaint = () => {
+            if (exported) return;
+            exported = true;
+            renderElementToCanvas();
+            downloadCanvasImage();
+          };
+          canvas.addEventListener('paint', handleExportPaint, { once: true });
+          canvas.requestPaint();
+          // Fallback in case the paint event does not fire synchronously
+          setTimeout(() => {
+            if (!exported) {
+              canvas.removeEventListener('paint', handleExportPaint);
+              handleExportPaint();
+            }
+          }, 100);
+        } else {
+          renderElementToCanvas();
+          downloadCanvasImage();
+        }
+      });
+
+      // Initial render
+      requestCanvasPaint();
+    })();
+  </script>
+
