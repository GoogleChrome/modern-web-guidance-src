     .btn:hover {
       background: #3e2723;
     }
 
+    .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Horizontal Product Carousel */
+    .carousel-section {
+      margin-bottom: 50px;
+    }
+
+    .carousel-header {
+      text-align: center;
+      margin-bottom: 10px;
+    }
+
+    .carousel-subtitle {
+      text-align: center;
+      color: #5d4037;
+      margin-bottom: 20px;
+      font-size: 0.95rem;
+    }
+
+    .scroller {
+      display: flex;
+      gap: 28px;
+      overflow-x: auto;
+      overflow-y: hidden;
+      scroll-snap-type: x mandatory;
+      scroll-behavior: smooth;
+      padding: 40px calc(50% - 140px);
+      margin: 0 -20px;
+      list-style: none;
+      -webkit-overflow-scrolling: touch;
+      scrollbar-width: thin;
+      scrollbar-color: var(--primary) var(--secondary);
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+      border-radius: 8px;
+    }
+
+    .scroller::-webkit-scrollbar {
+      height: 8px;
+    }
+
+    .scroller::-webkit-scrollbar-track {
+      background: var(--secondary);
+      border-radius: 4px;
+    }
+
+    .scroller::-webkit-scrollbar-thumb {
+      background: var(--primary);
+      border-radius: 4px;
+    }
+
+    @keyframes scale-on-scroll {
+      0% {
+        transform: scale(0.8);
+        opacity: 0.75;
+      }
+      50% {
+        transform: scale(1.12);
+        opacity: 1;
+      }
+      100% {
+        transform: scale(0.8);
+        opacity: 0.75;
+      }
+    }
+
+    .scroller .card {
+      flex: 0 0 280px;
+      scroll-snap-align: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      overflow: hidden;
+      padding: 0 0 20px 0;
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
+      transform-origin: center center;
+      animation: scale-on-scroll linear both;
+      animation-timeline: view(inline);
+    }
+
+    .scroller .card img {
+      width: 100%;
+      height: 180px;
+      object-fit: cover;
+      display: block;
+      margin-bottom: 15px;
+    }
+
+    .scroller .card-body {
+      padding: 0 20px;
+      display: flex;
+      flex-direction: column;
+      flex-grow: 1;
+      justify-content: space-between;
+    }
+
+    .scroller .price {
+      display: block;
+      font-size: 1.15rem;
+      font-weight: bold;
+      color: var(--primary);
+      margin-top: 10px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .scroller {
+        scroll-behavior: auto;
+      }
+
+      .scroller .card {
+        animation: none;
+        transform: none;
+        opacity: 1;
+      }
+    }
+
     footer {
