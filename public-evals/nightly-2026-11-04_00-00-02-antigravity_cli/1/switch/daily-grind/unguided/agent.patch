+  <script>
+    (function () {
+      const liveRegion = document.getElementById('switch-live-region');
+
+      function announce(message) {
+        if (!liveRegion) return;
+        liveRegion.textContent = '';
+        window.requestAnimationFrame(() => {
+          liveRegion.textContent = message;
+        });
+      }
+
+      /**
+       * Initializes a WAI-ARIA compliant switch button (`role="switch"`).
+       * Native <button> handles Space and Enter activation automatically.
+       */
+      function initSwitch(switchEl, onToggle, initialChecked = false) {
+        if (!switchEl) return;
+
+        function setChecked(checked, shouldAnnounce = true) {
+          const isChecked = Boolean(checked);
+          switchEl.setAttribute('aria-checked', String(isChecked));
+          onToggle(isChecked, shouldAnnounce);
+        }
+
+        if (initialChecked) {
+          setChecked(true, false);
+        }
+
+        switchEl.addEventListener('click', () => {
+          const current = switchEl.getAttribute('aria-checked') === 'true';
+          setChecked(!current, true);
+        });
+      }
+
+      // 1. Dark Mode Switch
+      const themeSwitch = document.getElementById('theme-switch');
+      let savedTheme = null;
+      try {
+        savedTheme = localStorage.getItem('daily-grind-theme');
+      } catch (e) {
+        // Ignore storage errors in restricted environments
+      }
+      const prefersDark =
+        window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
+      const initialDark = savedTheme ? savedTheme === 'dark' : prefersDark;
+
+      initSwitch(
+        themeSwitch,
+        (isDark, shouldAnnounce) => {
+          if (isDark) {
+            document.documentElement.setAttribute('data-theme', 'dark');
+          } else {
+            document.documentElement.removeAttribute('data-theme');
+          }
+          try {
+            localStorage.setItem('daily-grind-theme', isDark ? 'dark' : 'light');
+          } catch (e) {
+            // Ignore storage errors
+          }
+          if (shouldAnnounce) {
+            announce(`Dark mode ${isDark ? 'enabled' : 'disabled'}.`);
+          }
+        },
+        initialDark
+      );
+
+      // 2. Dairy-Free Filter Switch
+      const dairyFreeSwitch = document.getElementById('dairy-free-switch');
+      const cards = Array.from(document.querySelectorAll('#seasonal-grid .card'));
+
+      initSwitch(
+        dairyFreeSwitch,
+        (onlyDairyFree, shouldAnnounce) => {
+          let visibleCount = 0;
+          cards.forEach((card) => {
+            const isDairyFree = card.getAttribute('data-dairy-free') === 'true';
+            const shouldHide = onlyDairyFree && !isDairyFree;
+            card.hidden = shouldHide;
+            if (!shouldHide) visibleCount++;
+          });
+          if (shouldAnnounce) {
+            announce(
+              onlyDairyFree
+                ? `Dairy-free filter enabled. Showing ${visibleCount} seasonal drinks.`
+                : `Dairy-free filter disabled. Showing all ${visibleCount} seasonal drinks.`
+            );
+          }
+        },
+        false
+      );
+    })();
+  </script>
