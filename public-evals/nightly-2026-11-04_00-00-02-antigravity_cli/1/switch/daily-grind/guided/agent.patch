+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+
+    const notificationsSwitch = document.getElementById('notifications');
+    const notificationsDesc = document.getElementById('notifications-desc');
+
+    notificationsSwitch?.addEventListener('change', (event) => {
+      const isEnabled = event.currentTarget.checked;
+      notificationsDesc.textContent = isEnabled
+        ? 'Pickup notifications are enabled for your upcoming orders.'
+        : 'Receive real-time updates when your freshly brewed order is ready for pickup.';
+    });
+  </script>
