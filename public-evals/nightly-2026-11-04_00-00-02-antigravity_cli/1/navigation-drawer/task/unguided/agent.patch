+  <script>
+    (function () {
+      const menuToggle = document.getElementById('menu-toggle');
+      const drawerClose = document.getElementById('drawer-close');
+      const navDrawer = document.getElementById('nav-drawer');
+      const backdrop = document.getElementById('drawer-backdrop');
+
+      let isOpen = false;
+
+      function openDrawer() {
+        if (isOpen) return;
+        isOpen = true;
+        navDrawer.classList.add('open');
+        backdrop.classList.add('open');
+        navDrawer.setAttribute('aria-hidden', 'false');
+        menuToggle.setAttribute('aria-expanded', 'true');
+        document.body.classList.add('drawer-open');
+        navDrawer.style.transform = '';
+        backdrop.style.opacity = '';
+        drawerClose.focus({ preventScroll: true });
+      }
+
+      function closeDrawer() {
+        if (!isOpen) return;
+        isOpen = false;
+        navDrawer.classList.remove('open', 'swiping');
+        backdrop.classList.remove('open', 'swiping');
+        navDrawer.setAttribute('aria-hidden', 'true');
+        menuToggle.setAttribute('aria-expanded', 'false');
+        document.body.classList.remove('drawer-open');
+        navDrawer.style.transform = '';
+        backdrop.style.opacity = '';
+        menuToggle.focus({ preventScroll: true });
+      }
+
+      menuToggle.addEventListener('click', () => {
+        if (isOpen) {
+          closeDrawer();
+        } else {
+          openDrawer();
+        }
+      });
+
+      drawerClose.addEventListener('click', closeDrawer);
+      backdrop.addEventListener('click', closeDrawer);
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && isOpen) {
+          e.preventDefault();
+          closeDrawer();
+        }
+      });
+
+      // Native touch & pointer swipe-away gesture support
+      let startX = 0;
+      let startY = 0;
+      let currentX = 0;
+      let startTime = 0;
+      let isTracking = false;
+      let isHorizontalSwipe = null;
+
+      function beginGesture(clientX, clientY) {
+        if (!isOpen) return;
+        startX = clientX;
+        startY = clientY;
+        currentX = clientX;
+        startTime = performance.now();
+        isTracking = true;
+        isHorizontalSwipe = null;
+      }
+
+      function moveGesture(clientX, clientY, e) {
+        if (!isTracking || !isOpen) return;
+
+        const deltaX = clientX - startX;
+        const deltaY = clientY - startY;
+
+        if (isHorizontalSwipe === null) {
+          if (Math.abs(deltaX) > 8 || Math.abs(deltaY) > 8) {
+            isHorizontalSwipe = Math.abs(deltaX) >= Math.abs(deltaY);
+            if (isHorizontalSwipe) {
+              navDrawer.classList.add('swiping');
+              backdrop.classList.add('swiping');
+            }
+          }
+        }
+
+        if (!isHorizontalSwipe) return;
+
+        if (e && e.cancelable) {
+          e.preventDefault();
+        }
+
+        currentX = clientX;
+        // Drawer is anchored on the right: swiping right (positive deltaX) pulls it closed
+        const offset = Math.max(0, deltaX);
+        const drawerWidth = navDrawer.offsetWidth || 320;
+        const progress = Math.min(1, offset / drawerWidth);
+
+        navDrawer.style.transform = `translateX(${offset}px)`;
+        backdrop.style.opacity = String(1 - progress);
+      }
+
+      function endGesture() {
+        if (!isTracking) return;
+        isTracking = false;
+
+        if (!isHorizontalSwipe) {
+          navDrawer.classList.remove('swiping');
+          backdrop.classList.remove('swiping');
+          return;
+        }
+
+        const deltaX = currentX - startX;
+        const elapsed = Math.max(1, performance.now() - startTime);
+        const velocity = deltaX / elapsed; // px per ms
+        const drawerWidth = navDrawer.offsetWidth || 320;
+
+        navDrawer.classList.remove('swiping');
+        backdrop.classList.remove('swiping');
+
+        // Close if swiped past 25% of drawer width (or 75px) or flicked right with velocity
+        if (deltaX > Math.min(75, drawerWidth * 0.25) || (deltaX > 20 && velocity > 0.35)) {
+          closeDrawer();
+        } else {
+          // Snap back open
+          navDrawer.style.transform = '';
+          backdrop.style.opacity = '';
+        }
+      }
+
+      // Touch events
+      navDrawer.addEventListener('touchstart', (e) => {
+        if (e.touches.length !== 1) return;
+        beginGesture(e.touches[0].clientX, e.touches[0].clientY);
+      }, { passive: true });
+
+      navDrawer.addEventListener('touchmove', (e) => {
+        if (e.touches.length !== 1) return;
+        moveGesture(e.touches[0].clientX, e.touches[0].clientY, e);
+      }, { passive: false });
+
+      navDrawer.addEventListener('touchend', endGesture);
+      navDrawer.addEventListener('touchcancel', endGesture);
+
+      // Pointer events fallback for non-touch pointers (e.g., mouse drag / pen)
+      navDrawer.addEventListener('pointerdown', (e) => {
+        if (e.pointerType === 'touch') return;
+        if (e.button !== 0) return;
+        beginGesture(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('pointermove', (e) => {
+        if (e.pointerType === 'touch' || !isTracking) return;
+        moveGesture(e.clientX, e.clientY, e);
+      });
+
+      window.addEventListener('pointerup', (e) => {
+        if (e.pointerType === 'touch' || !isTracking) return;
+        endGesture();
+      });
+
+      window.addEventListener('pointercancel', (e) => {
+        if (e.pointerType === 'touch' || !isTracking) return;
+        endGesture();
+      });
+    })();
+  </script>
 </body>
 
