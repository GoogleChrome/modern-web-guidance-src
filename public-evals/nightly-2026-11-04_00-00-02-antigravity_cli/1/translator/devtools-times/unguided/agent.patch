diff --git a/src/utils/onDeviceTranslation.ts b/src/utils/onDeviceTranslation.ts
new file mode 100644
index 0000000..b6505a0
--- /dev/null
+++ b/src/utils/onDeviceTranslation.ts
@@ -0,0 +1,369 @@
+export interface SupportedLanguage {
+  code: string;
+  label: string;
+  nativeLabel: string;
+}
+
+export const SUPPORTED_LANGUAGES: SupportedLanguage[] = [
+  { code: 'en', label: 'English', nativeLabel: 'English' },
+  { code: 'es', label: 'Spanish', nativeLabel: 'Español' },
+  { code: 'fr', label: 'French', nativeLabel: 'Français' },
+  { code: 'de', label: 'German', nativeLabel: 'Deutsch' },
+  { code: 'it', label: 'Italian', nativeLabel: 'Italiano' },
+  { code: 'pt', label: 'Portuguese', nativeLabel: 'Português' },
+  { code: 'ja', label: 'Japanese', nativeLabel: '日本語' },
+  { code: 'zh', label: 'Chinese (Simplified)', nativeLabel: '中文 (简体)' },
+  { code: 'ko', label: 'Korean', nativeLabel: '한국어' },
+  { code: 'hi', label: 'Hindi', nativeLabel: 'हिन्दी' },
+  { code: 'ar', label: 'Arabic', nativeLabel: 'العربية' },
+  { code: 'ru', label: 'Russian', nativeLabel: 'Русский' },
+  { code: 'nl', label: 'Dutch', nativeLabel: 'Nederlands' },
+  { code: 'tr', label: 'Turkish', nativeLabel: 'Türkçe' },
+  { code: 'pl', label: 'Polish', nativeLabel: 'Polski' },
+  { code: 'vi', label: 'Vietnamese', nativeLabel: 'Tiếng Việt' },
+];
+
+export type AvailabilityState = 'available' | 'downloadable' | 'downloading' | 'unavailable';
+
+function normalizeAvailability(raw: string | undefined | null): AvailabilityState {
+  if (!raw) return 'unavailable';
+  const lower = String(raw).toLowerCase();
+  if (lower === 'available' || lower === 'readily') return 'available';
+  if (lower === 'downloadable' || lower === 'after-download') return 'downloadable';
+  if (lower === 'downloading') return 'downloading';
+  return 'unavailable';
+}
+
+export function isOnDeviceTranslatorSupported(): boolean {
+  if (typeof window === 'undefined') return false;
+  return Boolean(
+    'Translator' in self ||
+      (window as any).Translator ||
+      (window as any).ai?.translator ||
+      (window as any).translation?.createTranslator
+  );
+}
+
+export function isLanguageDetectorSupported(): boolean {
+  if (typeof window === 'undefined') return false;
+  return Boolean(
+    'LanguageDetector' in self ||
+      (window as any).LanguageDetector ||
+      (window as any).ai?.languageDetector
+  );
+}
+
+export async function checkTranslationAvailability(
+  sourceLanguage: string,
+  targetLanguage: string
+): Promise<AvailabilityState> {
+  if (sourceLanguage === targetLanguage) {
+    return 'available';
+  }
+  if (typeof window === 'undefined') {
+    return 'unavailable';
+  }
+
+  try {
+    // 1. Standard Chrome Built-in AI Translator API: self.Translator.availability({ sourceLanguage, targetLanguage })
+    const TranslatorAPI = (self as any).Translator || window.Translator;
+    if (TranslatorAPI && typeof TranslatorAPI.availability === 'function') {
+      const status = await TranslatorAPI.availability({ sourceLanguage, targetLanguage });
+      return normalizeAvailability(status);
+    }
+
+    // 2. Older Chrome AI namespace: window.ai.translator
+    if (window.ai?.translator?.capabilities) {
+      const caps = await window.ai.translator.capabilities();
+      if (caps && typeof caps.languagePairAvailable === 'function') {
+        const status = caps.languagePairAvailable(sourceLanguage, targetLanguage);
+        return normalizeAvailability(status);
+      }
+    }
+
+    // 3. Experimental window.translation namespace
+    if (window.translation?.canTranslate) {
+      const status = await window.translation.canTranslate({ sourceLanguage, targetLanguage });
+      return normalizeAvailability(status);
+    }
+  } catch (err) {
+    console.warn('Error checking translation availability:', err);
+  }
+
+  return 'unavailable';
+}
+
+export async function detectSourceLanguage(
+  sampleText: string,
+  fallbackLanguage = 'en'
+): Promise<{ detectedLanguage: string; confidence: number }> {
+  const cleanSample = sampleText.trim().slice(0, 1000);
+  if (!cleanSample || typeof window === 'undefined') {
+    return { detectedLanguage: fallbackLanguage, confidence: 1 };
+  }
+
+  try {
+    const DetectorAPI = (self as any).LanguageDetector || window.LanguageDetector;
+    if (DetectorAPI && typeof DetectorAPI.create === 'function') {
+      if (typeof DetectorAPI.availability === 'function') {
+        const avail = await DetectorAPI.availability();
+        if (normalizeAvailability(avail) === 'unavailable') {
+          return { detectedLanguage: fallbackLanguage, confidence: 0 };
+        }
+      }
+      const detector = await DetectorAPI.create();
+      try {
+        const results = await detector.detect(cleanSample);
+        if (Array.isArray(results) && results.length > 0 && results[0].detectedLanguage) {
+          const code = results[0].detectedLanguage.split('-')[0].toLowerCase();
+          return {
+            detectedLanguage: code,
+            confidence: results[0].confidence ?? 1,
+          };
+        }
+      } finally {
+        if (typeof detector.destroy === 'function') {
+          detector.destroy();
+        }
+      }
+    } else if (window.ai?.languageDetector?.create) {
+      const detector = await window.ai.languageDetector.create();
+      try {
+        const results = await detector.detect(cleanSample);
+        if (Array.isArray(results) && results.length > 0 && results[0].detectedLanguage) {
+          const code = results[0].detectedLanguage.split('-')[0].toLowerCase();
+          return {
+            detectedLanguage: code,
+            confidence: results[0].confidence ?? 1,
+          };
+        }
+      } finally {
+        if (typeof detector.destroy === 'function') {
+          detector.destroy();
+        }
+      }
+    }
+  } catch (err) {
+    console.warn('Language detection failed, falling back to default:', err);
+  }
+
+  return { detectedLanguage: fallbackLanguage, confidence: 1 };
+}
+
+export interface CreateTranslatorCallbacks {
+  onDownloadProgress?: (progressPercent: number) => void;
+  signal?: AbortSignal;
+}
+
+const translatorCache = new Map<string, TranslatorInstance>();
+
+export async function getOrCreateTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  callbacks?: CreateTranslatorCallbacks
+): Promise<TranslatorInstance> {
+  const pairKey = `${sourceLanguage}->${targetLanguage}`;
+  const cached = translatorCache.get(pairKey);
+  if (cached) {
+    return cached;
+  }
+
+  const monitorCallback = callbacks?.onDownloadProgress
+    ? (monitor: TranslatorCreateMonitor) => {
+        monitor.addEventListener('downloadprogress', (e) => {
+          const total = e.total && e.total > 0 ? e.total : 1;
+          const rawFraction = e.total ? e.loaded / total : e.loaded;
+          const pct = Math.max(0, Math.min(100, Math.round(rawFraction * 100)));
+          callbacks.onDownloadProgress?.(pct);
+        });
+      }
+    : undefined;
+
+  const createOptions: TranslatorCreateOptions = {
+    sourceLanguage,
+    targetLanguage,
+    ...(callbacks?.signal ? { signal: callbacks.signal } : {}),
+    ...(monitorCallback ? { monitor: monitorCallback } : {}),
+  };
+
+  const TranslatorAPI = (self as any).Translator || window.Translator;
+  if (TranslatorAPI && typeof TranslatorAPI.create === 'function') {
+    const instance = await TranslatorAPI.create(createOptions);
+    translatorCache.set(pairKey, instance);
+    return instance;
+  }
+
+  if (window.ai?.translator?.create) {
+    const instance = await window.ai.translator.create(createOptions);
+    translatorCache.set(pairKey, instance);
+    return instance;
+  }
+
+  if (window.translation?.createTranslator) {
+    const instance = await window.translation.createTranslator(createOptions);
+    translatorCache.set(pairKey, instance);
+    return instance;
+  }
+
+  throw new Error(
+    'On-device Translator API (window.Translator) is not available in this browser.'
+  );
+}
+
+// Cache original text content for DOM elements so we can always restore or re-translate from original
+const originalElementTextMap = new WeakMap<Element, string>();
+const originalTextNodeMap = new WeakMap<Text, string>();
+
+/**
+ * Collects leaf text nodes inside an element (such as rich markdown prose)
+ * excluding <script>, <style>, <code>, and <pre> tags, so inline links/formatting are preserved.
+ */
+function getTranslatableTextNodes(root: Element): Text[] {
+  const nodes: Text[] = [];
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const parent = node.parentElement;
+      if (!parent) return NodeFilter.FILTER_REJECT;
+      const tag = parent.tagName.toLowerCase();
+      if (tag === 'script' || tag === 'style' || tag === 'noscript' || tag === 'code' || tag === 'pre') {
+        return NodeFilter.FILTER_REJECT;
+      }
+      if (parent.closest('[data-no-translate="true"]')) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      const text = originalTextNodeMap.get(node as Text) ?? node.nodeValue ?? '';
+      if (!text.trim()) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      return NodeFilter.FILTER_ACCEPT;
+    },
+  });
+
+  let current = walker.nextNode();
+  while (current) {
+    const textNode = current as Text;
+    if (!originalTextNodeMap.has(textNode)) {
+      originalTextNodeMap.set(textNode, textNode.nodeValue ?? '');
+    }
+    nodes.push(textNode);
+    current = walker.nextNode();
+  }
+  return nodes;
+}
+
+/**
+ * Translates an element's text nodes while preserving leading/trailing whitespace and child HTML markup.
+ */
+export async function translateElementContent(
+  element: Element,
+  translator: TranslatorInstance,
+  signal?: AbortSignal
+): Promise<void> {
+  const hasChildElements = element.children.length > 0;
+
+  if (!hasChildElements) {
+    if (!originalElementTextMap.has(element)) {
+      originalElementTextMap.set(element, element.textContent ?? '');
+    }
+    const original = originalElementTextMap.get(element) ?? '';
+    const trimmed = original.trim();
+    if (!trimmed) return;
+
+    const translated = await translator.translate(trimmed, signal ? { signal } : undefined);
+    if (signal?.aborted) return;
+    element.textContent = translated;
+    return;
+  }
+
+  // Element has child markup (e.g., prose paragraphs, lists, bold, links)
+  const textNodes = getTranslatableTextNodes(element);
+  for (const textNode of textNodes) {
+    if (signal?.aborted) return;
+    const original = originalTextNodeMap.get(textNode) ?? '';
+    const leadingMatch = original.match(/^\s*/);
+    const trailingMatch = original.match(/\s*$/);
+    const leading = leadingMatch ? leadingMatch[0] : '';
+    const trailing = trailingMatch ? trailingMatch[0] : '';
+    const trimmed = original.trim();
+    if (!trimmed) continue;
+
+    const translated = await translator.translate(trimmed, signal ? { signal } : undefined);
+    if (signal?.aborted) return;
+    textNode.nodeValue = `${leading}${translated}${trailing}`;
+  }
+}
+
+export function restoreElementOriginalContent(element: Element): void {
+  if (originalElementTextMap.has(element)) {
+    element.textContent = originalElementTextMap.get(element) ?? '';
+  }
+  const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
+  let current = walker.nextNode();
+  while (current) {
+    const textNode = current as Text;
+    if (originalTextNodeMap.has(textNode)) {
+      textNode.nodeValue = originalTextNodeMap.get(textNode) ?? '';
+    }
+    current = walker.nextNode();
+  }
+}
+
+export interface PageTranslationProgress {
+  completedUnits: number;
+  totalUnits: number;
+}
+
+/**
+ * Translates all marked translatable regions within a container (or the entire document).
+ */
+export async function translateAllRegions(
+  translator: TranslatorInstance,
+  options?: {
+    root?: ParentNode;
+    signal?: AbortSignal;
+    targetLanguage?: string;
+    onProgress?: (progress: PageTranslationProgress) => void;
+  }
+): Promise<void> {
+  const root = options?.root ?? document;
+  const elements = Array.from(root.querySelectorAll('[data-translatable]'));
+  const totalUnits = elements.length;
+  let completedUnits = 0;
+
+  options?.onProgress?.({ completedUnits, totalUnits });
+
+  for (const el of elements) {
+    if (options?.signal?.aborted) return;
+    await translateElementContent(el, translator, options?.signal);
+    if (options?.targetLanguage && el instanceof HTMLElement) {
+      el.setAttribute('lang', options.targetLanguage);
+      el.setAttribute('data-translated-lang', options.targetLanguage);
+    }
+    completedUnits += 1;
+    options?.onProgress?.({ completedUnits, totalUnits });
+  }
+}
+
+export function restoreAllRegions(root: ParentNode = document, sourceLanguage = 'en'): void {
+  const elements = Array.from(root.querySelectorAll('[data-translatable]'));
+  for (const el of elements) {
+    restoreElementOriginalContent(el);
+    if (el instanceof HTMLElement) {
+      el.setAttribute('lang', sourceLanguage);
+      el.removeAttribute('data-translated-lang');
+    }
+  }
+}
+
+export function getSampleTextForDetection(root: ParentNode = document): string {
+  const headline = root.querySelector('[data-translatable="headline"], [data-translatable="teaser-title"]');
+  const summary = root.querySelector('[data-translatable="summary"], [data-translatable="teaser-summary"]');
+  const parts: string[] = [];
+  if (headline?.textContent) parts.push(headline.textContent.trim());
+  if (summary?.textContent) parts.push(summary.textContent.trim());
+  if (parts.length === 0) {
+    const anyTranslatable = root.querySelector('[data-translatable]');
+    if (anyTranslatable?.textContent) parts.push(anyTranslatable.textContent.trim());
+  }
+  return parts.join('. ');
+}
