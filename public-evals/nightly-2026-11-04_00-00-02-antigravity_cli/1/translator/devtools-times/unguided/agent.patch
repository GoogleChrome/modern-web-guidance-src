+  translateStreaming?(input: string, options?: { signal?: AbortSignal }): ReadableStream<string>;
+  destroy(): void;
+  sourceLanguage: string;
+  targetLanguage: string;
+}
+
+interface TranslatorStatic {
+  availability(options: TranslatorAvailabilityOptions): Promise<'unavailable' | 'downloadable' | 'downloading' | 'available' | 'readily' | 'after-download' | 'no'>;
