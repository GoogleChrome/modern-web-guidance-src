diff --git a/src/components/ArticleTranslationControl.tsx b/src/components/ArticleTranslationControl.tsx
new file mode 100644
index 0000000..7515e19
--- /dev/null
+++ b/src/components/ArticleTranslationControl.tsx
@@ -0,0 +1,570 @@
+import React, { useState, useEffect, useRef, useCallback } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  isOnDeviceTranslatorSupported,
+  isLanguageDetectorSupported,
+  checkTranslationAvailability,
+  detectSourceLanguage,
+  getOrCreateTranslator,
+  translateAllRegions,
+  restoreAllRegions,
+  getSampleTextForDetection,
+  type AvailabilityState,
+} from '../utils/onDeviceTranslation';
+
+interface ArticleTranslationControlProps {
+  /**
+   * Optional CSS selector to scope translation to a specific container (e.g., an individual article or teaser).
+   * If omitted, translates all `[data-translatable]` news articles and teasers on the page.
+   */
+  scopeSelector?: string;
+  /**
+   * Compact mode for header bars or inline toolbars.
+   */
+  compact?: boolean;
+  /**
+   * Default source language code.
+   */
+  defaultSourceLanguage?: string;
+  /**
+   * Default target language code.
+   */
+  defaultTargetLanguage?: string;
+}
+
+const STORAGE_KEY_TARGET_LANG = 'devtools_times_target_lang';
+const STORAGE_KEY_SOURCE_LANG = 'devtools_times_source_lang';
+const TRANSLATION_SYNC_EVENT = 'devtools-times:translation-state';
+
+export default function ArticleTranslationControl({
+  scopeSelector,
+  compact = false,
+  defaultSourceLanguage = 'en',
+  defaultTargetLanguage = 'es',
+}: ArticleTranslationControlProps) {
+  const [sourceLanguage, setSourceLanguage] = useState<string>(defaultSourceLanguage);
+  const [targetLanguage, setTargetLanguage] = useState<string>(defaultTargetLanguage);
+  const [activeTranslatedLang, setActiveTranslatedLang] = useState<string | null>(null);
+  const [apiSupported, setApiSupported] = useState<boolean>(true);
+  const [detectorSupported, setDetectorSupported] = useState<boolean>(false);
+  const [availability, setAvailability] = useState<AvailabilityState>('available');
+  const [status, setStatus] = useState<'idle' | 'detecting' | 'downloading' | 'translating' | 'translated' | 'error'>('idle');
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [translationProgress, setTranslationProgress] = useState<{ completed: number; total: number } | null>(null);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [detectedConfidence, setDetectedConfidence] = useState<number | null>(null);
+
+  const abortControllerRef = useRef<AbortController | null>(null);
+  const containerRef = useRef<HTMLDivElement | null>(null);
+
+  const getRootNode = useCallback((): ParentNode => {
+    if (typeof document === 'undefined') return null as unknown as ParentNode;
+    if (scopeSelector) {
+      const scoped = document.querySelector(scopeSelector);
+      if (scoped) return scoped;
+    }
+    return document;
+  }, [scopeSelector]);
+
+  // Initialize support flags & saved preferences
+  useEffect(() => {
+    const supported = isOnDeviceTranslatorSupported();
+    setApiSupported(supported);
+    setDetectorSupported(isLanguageDetectorSupported());
+
+    try {
+      const savedTarget = localStorage.getItem(STORAGE_KEY_TARGET_LANG);
+      if (savedTarget && SUPPORTED_LANGUAGES.some((l) => l.code === savedTarget)) {
+        setTargetLanguage(savedTarget);
+      }
+      const savedSource = localStorage.getItem(STORAGE_KEY_SOURCE_LANG);
+      if (savedSource && SUPPORTED_LANGUAGES.some((l) => l.code === savedSource)) {
+        setSourceLanguage(savedSource);
+      }
+    } catch {
+      // Ignore storage errors
+    }
+  }, []);
+
+  // Check language pair availability when source or target changes
+  useEffect(() => {
+    let cancelled = false;
+    if (! isOnDeviceTranslatorSupported()) {
+      setAvailability('unavailable');
+      return;
+    }
+    checkTranslationAvailability(sourceLanguage, targetLanguage).then((state) => {
+      if (!cancelled) {
+        setAvailability(state);
+      }
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, [sourceLanguage, targetLanguage]);
+
+  // Synchronize multiple translation controls on the same page
+  useEffect(() => {
+    if (scopeSelector) return;
+
+    const handleSync = (event: Event) => {
+      const custom = event as CustomEvent<{
+        sourceLanguage: string;
+        targetLanguage: string;
+        activeTranslatedLang: string | null;
+        status: typeof status;
+      }>;
+      if (!custom.detail) return;
+      setSourceLanguage(custom.detail.sourceLanguage);
+      setTargetLanguage(custom.detail.targetLanguage);
+      setActiveTranslatedLang(custom.detail.activeTranslatedLang);
+      setStatus(custom.detail.status);
+    };
+
+    window.addEventListener(TRANSLATION_SYNC_EVENT, handleSync);
+    return () => {
+      window.removeEventListener(TRANSLATION_SYNC_EVENT, handleSync);
+    };
+  }, [scopeSelector]);
+
+  const broadcastSync = useCallback(
+    (nextState: {
+      sourceLanguage: string;
+      targetLanguage: string;
+      activeTranslatedLang: string | null;
+      status: typeof status;
+    }) => {
+      if (scopeSelector || typeof window === 'undefined') return;
+      window.dispatchEvent(new CustomEvent(TRANSLATION_SYNC_EVENT, { detail: nextState }));
+    },
+    [scopeSelector]
+  );
+
+  const handleSourceChange = (newSource: string) => {
+    setSourceLanguage(newSource);
+    setErrorMessage(null);
+    setDetectedConfidence(null);
+    try {
+      localStorage.setItem(STORAGE_KEY_SOURCE_LANG, newSource);
+    } catch {
+      // Ignore
+    }
+    if (newSource === targetLanguage) {
+      const alt = SUPPORTED_LANGUAGES.find((l) => l.code !== newSource)?.code ?? 'es';
+      setTargetLanguage(alt);
+    }
+  };
+
+  const handleTargetChange = (newTarget: string) => {
+    setTargetLanguage(newTarget);
+    setErrorMessage(null);
+    try {
+      localStorage.setItem(STORAGE_KEY_TARGET_LANG, newTarget);
+    } catch {
+      // Ignore
+    }
+  };
+
+  const handleSwapLanguages = () => {
+    const prevSource = sourceLanguage;
+    const prevTarget = targetLanguage;
+    setSourceLanguage(prevTarget);
+    setTargetLanguage(prevSource);
+    setErrorMessage(null);
+  };
+
+  const handleDetectLanguage = async () => {
+    setErrorMessage(null);
+    setStatus('detecting');
+    try {
+      const root = getRootNode();
+      const sample = getSampleTextForDetection(root);
+      const { detectedLanguage, confidence } = await detectSourceLanguage(sample, sourceLanguage);
+      const matched = SUPPORTED_LANGUAGES.find((l) => l.code === detectedLanguage);
+      if (matched) {
+        setSourceLanguage(matched.code);
+        setDetectedConfidence(Math.round(confidence * 100));
+        if (matched.code === targetLanguage) {
+          const fallbackTarget = matched.code === 'en' ? 'es' : 'en';
+          setTargetLanguage(fallbackTarget);
+        }
+      }
+      setStatus(activeTranslatedLang ? 'translated' : 'idle');
+    } catch (err: any) {
+      setErrorMessage(err?.message || 'Unable to detect article language.');
+      setStatus('error');
+    }
+  };
+
+  const handleRestoreOriginal = useCallback(() => {
+    if (abortControllerRef.current) {
+      abortControllerRef.current.abort();
+      abortControllerRef.current = null;
+    }
+    const root = getRootNode();
+    restoreAllRegions(root, sourceLanguage);
+    setActiveTranslatedLang(null);
+    setStatus('idle');
+    setDownloadProgress(null);
+    setTranslationProgress(null);
+    setErrorMessage(null);
+    broadcastSync({
+      sourceLanguage,
+      targetLanguage,
+      activeTranslatedLang: null,
+      status: 'idle',
+    });
+  }, [broadcastSync, getRootNode, sourceLanguage, targetLanguage]);
+
+  const handleTranslate = async (overrideTargetLang?: string) => {
+    const effectiveTarget = overrideTargetLang ?? targetLanguage;
+
+    if (sourceLanguage === effectiveTarget) {
+      handleRestoreOriginal();
+      return;
+    }
+
+    if (abortControllerRef.current) {
+      abortControllerRef.current.abort();
+    }
+    const controller = new AbortController();
+    abortControllerRef.current = controller;
+
+    setErrorMessage(null);
+    setDownloadProgress(null);
+    setTranslationProgress(null);
+
+    const root = getRootNode();
+    // Always restore original before translating to a new target language so we translate from clean source text
+    restoreAllRegions(root, sourceLanguage);
+
+    if (!isOnDeviceTranslatorSupported()) {
+      setApiSupported(false);
+      setStatus('error');
+      setErrorMessage(
+        'On-device translation requires a browser with the Built-in AI Translator API (window.Translator) enabled.'
+      );
+      return;
+    }
+
+    try {
+      setStatus('downloading');
+      broadcastSync({
+        sourceLanguage,
+        targetLanguage: effectiveTarget,
+        activeTranslatedLang: null,
+        status: 'downloading',
+      });
+
+      const translator = await getOrCreateTranslator(sourceLanguage, effectiveTarget, {
+        signal: controller.signal,
+        onDownloadProgress: (pct) => {
+          setDownloadProgress(pct);
+        },
+      });
+
+      if (controller.signal.aborted) return;
+
+      setDownloadProgress(null);
+      setStatus('translating');
+      broadcastSync({
+        sourceLanguage,
+        targetLanguage: effectiveTarget,
+        activeTranslatedLang: null,
+        status: 'translating',
+      });
+
+      await translateAllRegions(translator, {
+        root,
+        signal: controller.signal,
+        targetLanguage: effectiveTarget,
+        onProgress: ({ completedUnits, totalUnits }) => {
+          setTranslationProgress({ completed: completedUnits, total: totalUnits });
+        },
+      });
+
+      if (controller.signal.aborted) return;
+
+      setActiveTranslatedLang(effectiveTarget);
+      setStatus('translated');
+      setTranslationProgress(null);
+      setAvailability('available');
+      broadcastSync({
+        sourceLanguage,
+        targetLanguage: effectiveTarget,
+        activeTranslatedLang: effectiveTarget,
+        status: 'translated',
+      });
+    } catch (err: any) {
+      if (controller.signal.aborted || err?.name === 'AbortError') {
+        return;
+      }
+      console.error('On-device article translation failed:', err);
+      setStatus('error');
+      setErrorMessage(
+        err?.message ||
+          'Failed to translate content on-device. Check that the language model is available in your browser.'
+      );
+    }
+  };
+
+  const targetLangObj = SUPPORTED_LANGUAGES.find((l) => l.code === targetLanguage);
+  const activeLangObj = SUPPORTED_LANGUAGES.find((l) => l.code === activeTranslatedLang);
+  const isBusy = status === 'downloading' || status === 'translating' || status === 'detecting';
+
+  return (
+    <div
+      ref={containerRef}
+      data-no-translate="true"
+      data-testid="on-device-translation-control"
+      className={
+        compact
+          ? 'bg-amber-50/70 border border-amber-200/80 rounded-md px-3 py-2 text-xs text-gray-800'
+          : 'bg-gray-50 border border-gray-200 rounded-lg p-3.5 my-4 text-sm text-gray-800 shadow-2xs'
+      }
+      role="region"
+      aria-label="On-device article translation"
+    >
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        {/* Left: Label & On-device badge */}
+        <div className="flex items-center gap-2">
+          <span
+            className="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-100 text-amber-800 flex-shrink-0"
+            aria-hidden="true"
+          >
+            <svg
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={1.8}
+              stroke="currentColor"
+              className="w-4 h-4"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+              />
+            </svg>
+          </span>
+          <div className="flex flex-wrap items-center gap-1.5">
+            <span className="font-semibold text-gray-900">Translate on-device</span>
+            <span
+              className={`inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-medium ${
+                !apiSupported || availability === 'unavailable'
+                  ? 'bg-gray-200 text-gray-700'
+                  : availability === 'downloadable'
+                  ? 'bg-blue-100 text-blue-800'
+                  : 'bg-emerald-100 text-emerald-800'
+              }`}
+              title="Powered by the browser's built-in On-Device Translator API"
+            >
+              {!apiSupported
+                ? 'Browser API Unavailable'
+                : availability === 'downloadable'
+                ? 'Model Downloadable'
+                : availability === 'unavailable'
+                ? 'Pair Unavailable'
+                : 'On-Device AI Ready'}
+            </span>
+            {detectedConfidence !== null && (
+              <span className="text-[11px] text-gray-500">
+                (Detected {sourceLanguage.toUpperCase()} · {detectedConfidence}%)
+              </span>
+            )}
+          </div>
+        </div>
+
+        {/* Right: Language selectors & action buttons */}
+        <div className="flex flex-wrap items-center gap-2">
+          {/* Source Language Selector */}
+          <label className="inline-flex items-center gap-1 text-xs text-gray-600">
+            <span className="sr-only sm:not-sr-only">From</span>
+            <select
+              aria-label="Source language"
+              data-testid="translate-source-language"
+              value={sourceLanguage}
+              disabled={isBusy}
+              onChange={(e) => handleSourceChange(e.target.value)}
+              className="bg-white border border-gray-300 rounded px-2 py-1 text-xs font-medium text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-400 disabled:opacity-50"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`src-${lang.code}`} value={lang.code}>
+                  {lang.label} ({lang.nativeLabel})
+                </option>
+              ))}
+            </select>
+          </label>
+
+          {detectorSupported && (
+            <button
+              type="button"
+              onClick={handleDetectLanguage}
+              disabled={isBusy}
+              title="Auto-detect article language on-device"
+              className="px-2 py-1 text-xs font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-100 transition-colors disabled:opacity-50"
+            >
+              Auto-detect
+            </button>
+          )}
+
+          {/* Swap source and target languages */}
+          <button
+            type="button"
+            onClick={handleSwapLanguages}
+            disabled={isBusy}
+            aria-label="Swap source and target languages"
+            title="Swap languages"
+            className="p-1 text-gray-500 hover:text-amber-600 rounded hover:bg-gray-200/60 transition-colors disabled:opacity-50"
+          >
+            <svg
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={1.8}
+              stroke="currentColor"
+              className="w-4 h-4"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"
+              />
+            </svg>
+          </button>
+
+          {/* Target Language Selector */}
+          <label className="inline-flex items-center gap-1 text-xs text-gray-600">
+            <span className="sr-only sm:not-sr-only">To</span>
+            <select
+              aria-label="Target language"
+              data-testid="translate-target-language"
+              value={targetLanguage}
+              disabled={isBusy}
+              onChange={(e) => handleTargetChange(e.target.value)}
+              className="bg-white border border-gray-300 rounded px-2 py-1 text-xs font-medium text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-400 disabled:opacity-50"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`tgt-${lang.code}`} value={lang.code}>
+                  {lang.label} ({lang.nativeLabel})
+                </option>
+              ))}
+            </select>
+          </label>
+
+          {/* Translate Action Button */}
+          <button
+            type="button"
+            data-testid="translate-action-button"
+            onClick={() => handleTranslate()}
+            disabled={isBusy || sourceLanguage === targetLanguage}
+            className="inline-flex items-center gap-1.5 bg-gray-900 hover:bg-amber-500 hover:text-gray-950 text-white text-xs font-semibold px-3 py-1.5 rounded transition-colors disabled:opacity-50 cursor-pointer disabled:cursor-not-allowed"
+          >
+            {isBusy ? (
+              <>
+                <span className="w-3.5 h-3.5 border-2 border-current border-t-transparent rounded-full animate-spin" />
+                <span>
+                  {status === 'downloading'
+                    ? downloadProgress !== null
+                      ? `Downloading Model (${downloadProgress}%)`
+                      : 'Preparing Model…'
+                    : status === 'detecting'
+                    ? 'Detecting…'
+                    : translationProgress
+                    ? `Translating (${translationProgress.completed}/${translationProgress.total})`
+                    : 'Translating…'}
+                </span>
+              </>
+            ) : (
+              <span>
+                {activeTranslatedLang === targetLanguage
+                  ? 'Re-translate'
+                  : `Translate to ${targetLangObj?.label ?? targetLanguage.toUpperCase()}`}
+              </span>
+            )}
+          </button>
+
+          {/* Restore Original Button */}
+          {(activeTranslatedLang || isBusy) && (
+            <button
+              type="button"
+              data-testid="translate-restore-button"
+              onClick={handleRestoreOriginal}
+              className="inline-flex items-center gap-1 bg-white hover:bg-gray-100 text-gray-700 border border-gray-300 text-xs font-medium px-2.5 py-1.5 rounded transition-colors cursor-pointer"
+            >
+              {isBusy ? 'Cancel' : 'Show Original'}
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Progress / Status feedback bar */}
+      {status === 'downloading' && downloadProgress !== null && (
+        <div className="mt-2.5" aria-live="polite">
+          <div className="flex justify-between text-[11px] text-gray-600 mb-1">
+            <span>Downloading on-device language pack…</span>
+            <span>{downloadProgress}%</span>
+          </div>
+          <div className="w-full bg-gray-200 rounded-full h-1.5 overflow-hidden">
+            <div
+              className="bg-amber-500 h-1.5 transition-all duration-200"
+              style={{ width: `${downloadProgress}%` }}
+            />
+          </div>
+        </div>
+      )}
+
+      {status === 'translating' && translationProgress && translationProgress.total > 0 && (
+        <div className="mt-2.5" aria-live="polite">
+          <div className="flex justify-between text-[11px] text-gray-600 mb-1">
+            <span>Translating articles and teasers on-device…</span>
+            <span>
+              {translationProgress.completed} / {translationProgress.total}
+            </span>
+          </div>
+          <div className="w-full bg-gray-200 rounded-full h-1.5 overflow-hidden">
+            <div
+              className="bg-amber-500 h-1.5 transition-all duration-150"
+              style={{
+                width: `${Math.round(
+                  (translationProgress.completed / Math.max(1, translationProgress.total)) * 100
+                )}%`,
+              }}
+            />
+          </div>
+        </div>
+      )}
+
+      {status === 'translated' && activeLangObj && (
+        <div
+          className="mt-2 flex items-center justify-between text-xs text-emerald-800 bg-emerald-50 border border-emerald-200 rounded px-2.5 py-1"
+          aria-live="polite"
+        >
+          <span>
+            Translated locally in your browser to{' '}
+            <strong>
+              {activeLangObj.label} ({activeLangObj.nativeLabel})
+            </strong>
+            .
+          </span>
+          <button
+            type="button"
+            onClick={handleRestoreOriginal}
+            className="underline font-semibold hover:text-emerald-950 ml-2 cursor-pointer"
+          >
+            Restore original
+          </button>
+        </div>
+      )}
+
+      {errorMessage && (
+        <div
+          className="mt-2 text-xs text-amber-900 bg-amber-100/80 border border-amber-300 rounded px-2.5 py-1.5"
+          role="alert"
+        >
+          {errorMessage}
+        </div>
+      )}
+    </div>
+  );
+}
