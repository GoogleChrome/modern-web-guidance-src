@@ -0,0 +1,442 @@
+import React, { useState, useEffect, useId, useRef } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+
+export interface SupportedLanguage {
+  code: string;
+  name: string;
+}
+
+export const SUPPORTED_LANGUAGES: SupportedLanguage[] = [
+  { code: 'en', name: 'English' },
+  { code: 'ar', name: 'Arabic' },
+  { code: 'bg', name: 'Bulgarian' },
+  { code: 'bn', name: 'Bengali' },
+  { code: 'cs', name: 'Czech' },
+  { code: 'da', name: 'Danish' },
+  { code: 'de', name: 'German' },
+  { code: 'el', name: 'Greek' },
+  { code: 'es', name: 'Spanish' },
+  { code: 'fi', name: 'Finnish' },
+  { code: 'fr', name: 'French' },
+  { code: 'he', name: 'Hebrew' },
+  { code: 'hi', name: 'Hindi' },
+  { code: 'hr', name: 'Croatian' },
+  { code: 'hu', name: 'Hungarian' },
+  { code: 'id', name: 'Indonesian' },
+  { code: 'it', name: 'Italian' },
+  { code: 'ja', name: 'Japanese' },
+  { code: 'kn', name: 'Kannada' },
+  { code: 'ko', name: 'Korean' },
+  { code: 'lt', name: 'Lithuanian' },
+  { code: 'mr', name: 'Marathi' },
+  { code: 'nl', name: 'Dutch' },
+  { code: 'no', name: 'Norwegian' },
+  { code: 'pl', name: 'Polish' },
+  { code: 'pt', name: 'Portuguese' },
+  { code: 'ro', name: 'Romanian' },
+  { code: 'ru', name: 'Russian' },
+  { code: 'sk', name: 'Slovak' },
+  { code: 'sl', name: 'Slovenian' },
+  { code: 'sv', name: 'Swedish' },
+  { code: 'ta', name: 'Tamil' },
+  { code: 'te', name: 'Telugu' },
+  { code: 'th', name: 'Thai' },
+  { code: 'tr', name: 'Turkish' },
+  { code: 'uk', name: 'Ukrainian' },
+  { code: 'vi', name: 'Vietnamese' },
+  { code: 'zh', name: 'Chinese (Simplified)' },
+  { code: 'zh-Hant', name: 'Chinese (Traditional)' },
+];
+
+interface TranslationControlProps {
+  variant?: 'header' | 'inline';
+  containerSelector?: string;
+}
+
+const originalTextMap = new WeakMap<Element, string>();
+
+function collectTranslatableElements(root: ParentNode = document): HTMLElement[] {
+  const marked = Array.from(root.querySelectorAll<HTMLElement>('[data-translatable]'));
+  const proseBlocks = Array.from(
+    root.querySelectorAll<HTMLElement>(
+      '[data-translatable-prose] p, [data-translatable-prose] h1, [data-translatable-prose] h2, [data-translatable-prose] h3, [data-translatable-prose] h4, [data-translatable-prose] h5, [data-translatable-prose] h6, [data-translatable-prose] li, [data-translatable-prose] blockquote, [data-translatable-prose] figcaption'
+    )
+  );
+  const combined = new Set<HTMLElement>([...marked, ...proseBlocks]);
+  return Array.from(combined).filter((el) => {
+    const text = originalTextMap.get(el) ?? el.textContent ?? '';
+    return text.trim().length > 0;
+  });
+}
+
+export default function TranslationControl({
+  variant = 'header',
+  containerSelector,
+}: TranslationControlProps) {
+  const baseId = useId();
+  const sourceSelectId = `${baseId}-source-lang`;
+  const targetSelectId = `${baseId}-target-lang`;
+  const statusId = `${baseId}-translator-status`;
+
+  const [isSupported, setIsSupported] = useState<boolean>(true);
+  const [sourceLanguage, setSourceLanguage] = useState<string>('en');
+  const [targetLanguage, setTargetLanguage] = useState<string>('es');
+  const [availability, setAvailability] = useState<TranslatorAvailability | 'checking'>('checking');
+  const [isTranslating, setIsTranslating] = useState<boolean>(false);
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [translatedCount, setTranslatedCount] = useState<{ done: number; total: number } | null>(null);
+  const [isTranslated, setIsTranslated] = useState<boolean>(false);
+  const [activeTargetLang, setActiveTargetLang] = useState<string | null>(null);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+
+  const abortControllerRef = useRef<AbortController | null>(null);
+
+  // Check if Translator API exists in self/window and check availability for current language pair
+  useEffect(() => {
+    let cancelled = false;
+
+    async function checkSupportAndAvailability() {
+      setErrorMessage(null);
+      if (typeof self === 'undefined' || !('Translator' in self) || !self.Translator) {
+        if (!cancelled) {
+          setIsSupported(false);
+          setAvailability('unavailable');
+        }
+        return;
+      }
+
+      setIsSupported(true);
+
+      if (sourceLanguage === targetLanguage) {
+        if (!cancelled) {
+          setAvailability('unavailable');
+        }
+        return;
+      }
+
+      const options: TranslatorOptions = {
+        sourceLanguage,
+        targetLanguage,
+      };
+
+      try {
+        setAvailability('checking');
+        const status = await self.Translator.availability(options);
+        if (!cancelled) {
+          setAvailability(status);
+        }
+      } catch (err) {
+        if (!cancelled) {
+          setAvailability('unavailable');
+          setErrorMessage(
+            err instanceof Error ? err.message : 'Unable to check language model availability.'
+          );
+        }
+      }
+    }
+
+    checkSupportAndAvailability();
+
+    return () => {
+      cancelled = true;
+    };
+  }, [sourceLanguage, targetLanguage]);
+
+  const getRootNode = (): ParentNode => {
+    if (containerSelector && typeof document !== 'undefined') {
+      return document.querySelector(containerSelector) || document;
+    }
+    return document;
+  };
+
+  const handleRestoreOriginal = () => {
+    if (abortControllerRef.current) {
+      abortControllerRef.current.abort();
+      abortControllerRef.current = null;
+    }
+
+    const root = getRootNode();
+    const elements = collectTranslatableElements(root);
+    for (const el of elements) {
+      const original = originalTextMap.get(el);
+      if (original !== undefined) {
+        el.textContent = original;
+      }
+      el.removeAttribute('lang');
+    }
+
+    if (!containerSelector && typeof document !== 'undefined') {
+      document.documentElement.lang = sourceLanguage || 'en';
+    }
+
+    setIsTranslated(false);
+    setActiveTargetLang(null);
+    setIsTranslating(false);
+    setDownloadProgress(null);
+    setTranslatedCount(null);
+    setErrorMessage(null);
+  };
+
+  const handleTranslate = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setErrorMessage(null);
+
+    if (typeof self === 'undefined' || !('Translator' in self) || !self.Translator) {
+      setIsSupported(false);
+      setAvailability('unavailable');
+      setErrorMessage('Client-side translation is currently unsupported in this browser.');
+      return;
+    }
+
+    if (sourceLanguage === targetLanguage) {
+      setErrorMessage('Please choose different source and target languages.');
+      return;
+    }
+
+    // Identical options object passed to availability() and create()
+    const options: TranslatorOptions = {
+      sourceLanguage,
+      targetLanguage,
+    };
+
+    try {
+      const currentAvailability = await self.Translator.availability(options);
+      setAvailability(currentAvailability);
+
+      if (currentAvailability === 'unavailable') {
+        setErrorMessage(
+          `On-device translation from ${sourceLanguage.toUpperCase()} to ${targetLanguage.toUpperCase()} is unavailable on this device.`
+        );
+        return;
+      }
+
+      if (abortControllerRef.current) {
+        abortControllerRef.current.abort();
+      }
+      const controller = new AbortController();
+      abortControllerRef.current = controller;
+
+      setIsTranslating(true);
+      if (currentAvailability === 'downloadable' || currentAvailability === 'downloading') {
+        setDownloadProgress(0);
+      } else {
+        setDownloadProgress(null);
+      }
+
+      // Create translator inside the user gesture handler (form submit / button click)
+      const translator = await self.Translator.create({
+        ...options,
+        signal: controller.signal,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (event) => {
+            const pct = Math.round(event.loaded * 100);
+            setDownloadProgress(pct);
+          });
+        },
+      });
+
+      setDownloadProgress(null);
+      setAvailability('available');
+
+      const root = getRootNode();
+      const elements = collectTranslatableElements(root);
+      setTranslatedCount({ done: 0, total: elements.length });
+
+      let completed = 0;
+      for (const el of elements) {
+        if (controller.signal.aborted) break;
+
+        if (!originalTextMap.has(el)) {
+          originalTextMap.set(el, el.textContent ?? '');
+        }
+        const sourceText = (originalTextMap.get(el) ?? '').trim();
+        if (!sourceText) {
+          completed += 1;
+          setTranslatedCount({ done: completed, total: elements.length });
+          continue;
+        }
+
+        // Use streaming translation for longer paragraphs (> 160 chars) and standard translate() for headlines/teasers
+        if (sourceText.length > 160 && typeof translator.translateStreaming === 'function') {
+          const stream = translator.translateStreaming(sourceText, { signal: controller.signal });
+          let accumulated = '';
+          el.lang = targetLanguage;
+          for await (const chunk of stream) {
+            if (controller.signal.aborted) break;
+            accumulated += chunk;
+            el.textContent = accumulated;
+          }
+        } else {
+          const translated = await translator.translate(sourceText, { signal: controller.signal });
+          if (!controller.signal.aborted) {
+            el.textContent = translated;
+            el.lang = targetLanguage;
+          }
+        }
+
+        completed += 1;
+        setTranslatedCount({ done: completed, total: elements.length });
+      }
+
+      if (!controller.signal.aborted) {
+        if (!containerSelector && typeof document !== 'undefined') {
+          document.documentElement.lang = targetLanguage;
+        }
+        setIsTranslated(true);
+        setActiveTargetLang(targetLanguage);
+      }
+
+      translator.destroy();
+    } catch (err) {
+      if (err instanceof DOMException && err.name === 'AbortError') {
+        return;
+      }
+      setErrorMessage(
+        err instanceof Error
+          ? err.message
+          : 'Translation failed. Please verify that your browser supports the on-device Translator API.'
+      );
+    } finally {
+      setIsTranslating(false);
+      setDownloadProgress(null);
+    }
+  };
+
+  const isTranslateDisabled =
+    !isSupported ||
+    availability === 'unavailable' ||
+    availability === 'checking' ||
+    sourceLanguage === targetLanguage ||
+    isTranslating;
+
+  const getButtonLabel = () => {
+    if (isTranslating) {
+      if (downloadProgress !== null) {
+        return `Downloading model (${downloadProgress}%)…`;
+      }
+      if (translatedCount) {
+        return `Translating (${translatedCount.done}/${translatedCount.total})…`;
+      }
+      return 'Translating…';
+    }
+    if (availability === 'downloadable' || availability === 'downloading') {
+      return 'Download & Translate';
+    }
+    return variant === 'inline' ? 'Translate Article' : 'Translate Page';
+  };
+
+  return (
+    <div
+      className={
+        variant === 'inline'
+          ? 'bg-gray-50 border border-gray-200 rounded-md p-3 my-4 text-xs text-gray-800'
+          : 'bg-gray-50 border border-gray-200 rounded-md px-3 py-1.5 text-xs text-gray-800'
+      }
+    >
+      <form
+        onSubmit={handleTranslate}
+        aria-describedby={statusId}
+        className="flex flex-wrap items-center gap-2"
+      >
+        <span className="inline-flex items-center font-semibold text-gray-700 mr-1">
+          <LanguageIcon className="w-4 h-4 mr-1 text-amber-700 shrink-0" aria-hidden="true" />
+          <span>On-Device Translate</span>
+        </span>
+
+        <div className="flex items-center gap-1.5">
+          <label htmlFor={sourceSelectId} className="font-medium text-gray-600">
+            From
+          </label>
+          <select
+            id={sourceSelectId}
+            name="sourceLanguage"
+            value={sourceLanguage}
+            onChange={(e) => setSourceLanguage(e.target.value)}
+            disabled={!isSupported || isTranslating}
+            className="bg-white border border-gray-300 rounded px-2 py-1 text-xs text-gray-800 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-amber-700 disabled:bg-gray-100 disabled:text-gray-400"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.name}
+              </option>
+            ))}
+          </select>
+        </div>
+
+        <div className="flex items-center gap-1.5">
+          <label htmlFor={targetSelectId} className="font-medium text-gray-600">
+            To
+          </label>
+          <select
+            id={targetSelectId}
+            name="targetLanguage"
+            value={targetLanguage}
+            onChange={(e) => setTargetLanguage(e.target.value)}
+            disabled={!isSupported || isTranslating}
+            className="bg-white border border-gray-300 rounded px-2 py-1 text-xs text-gray-800 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-amber-700 disabled:bg-gray-100 disabled:text-gray-400"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.name}
+              </option>
+            ))}
+          </select>
+        </div>
+
+        <button
+          type="submit"
+          disabled={isTranslateDisabled}
+          className="bg-gray-900 text-white font-semibold px-3 py-1 rounded hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700 disabled:bg-gray-300 disabled:text-gray-500 disabled:cursor-not-allowed transition-colors cursor-pointer"
+        >
+          {getButtonLabel()}
+        </button>
+
+        {isTranslated && (
+          <button
+            type="button"
+            onClick={handleRestoreOriginal}
+            className="bg-white border border-gray-300 text-gray-700 font-semibold px-2.5 py-1 rounded hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700 transition-colors cursor-pointer"
+          >
+            Restore Original
+          </button>
+        )}
+
+        {downloadProgress !== null && (
+          <div className="flex items-center gap-1.5 ml-1">
+            <progress
+              value={downloadProgress}
+              max={100}
+              aria-label="Language model download progress"
+              className="w-20 h-2 accent-amber-700"
+            />
+            <span className="text-[11px] text-gray-600 font-medium">{downloadProgress}%</span>
+          </div>
+        )}
+
+        <div id={statusId} aria-live="polite" className="text-[11px] text-gray-600">
+          {!isSupported ? (
+            <span className="text-amber-800">
+              Client-side translation is currently unsupported in this browser.
+            </span>
+          ) : errorMessage ? (
+            <span className="text-red-700">{errorMessage}</span>
+          ) : sourceLanguage === targetLanguage ? (
+            <span>Select two different languages to translate.</span>
+          ) : availability === 'unavailable' ? (
+            <span className="text-amber-800">
+              Language pair ({sourceLanguage.toUpperCase()} → {targetLanguage.toUpperCase()}) is unavailable on this device.
+            </span>
+          ) : availability === 'downloadable' ? (
+            <span>Language pack ready to download on click.</span>
+          ) : availability === 'downloading' ? (
+            <span>Downloading language model…</span>
+          ) : isTranslated && activeTargetLang ? (
+            <span className="text-green-800 font-medium">
+              Translated to {SUPPORTED_LANGUAGES.find((l) => l.code === activeTargetLang)?.name || activeTargetLang.toUpperCase()}.
+            </span>
+          ) : null}
+        </div>
+      </form>
+    </div>
+  );
+}
