+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      const languageSelect = document.getElementById('language-select');
+      const translateBtn = document.getElementById('translate-btn');
+      const statusEl = document.getElementById('translation-status');
+      const progressEl = document.getElementById('translation-progress');
+      const translatableElements = Array.from(document.querySelectorAll('[data-translatable]'));
+
+      // Check customizable select support for progressive enhancement
+      if (!CSS.supports('appearance', 'base-select')) {
+        languageSelect.classList.add('native-select-fallback');
+      }
+
+      // Preserve original English copy for lossless restoration and source reference
+      for (const el of translatableElements) {
+        el.dataset.originalText = el.textContent.trim();
+      }
+
+      let currentLanguage = 'en';
+      const rtlLanguages = new Set(['ar', 'he']);
+
+      function setStatus(message, isError = false) {
+        statusEl.textContent = message;
+        if (isError) {
+          statusEl.dataset.state = 'error';
+        } else {
+          delete statusEl.dataset.state;
+        }
+      }
+
+      function applyLanguageDirection(lang) {
+        document.documentElement.lang = lang;
+        document.documentElement.dir = rtlLanguages.has(lang) ? 'rtl' : 'ltr';
+      }
+
+      // Feature detection: Check if the global Translator API is supported
+      if (!('Translator' in self)) {
+        languageSelect.disabled = true;
+        translateBtn.disabled = true;
+        setStatus('Client-side translation is currently unsupported in this browser.', true);
+        return;
+      }
+
+      async function translatePageContent(targetLanguage) {
+        if (targetLanguage === 'en') {
+          for (const el of translatableElements) {
+            el.textContent = el.dataset.originalText;
+          }
+          currentLanguage = 'en';
+          applyLanguageDirection('en');
+          progressEl.hidden = true;
+          setStatus('Showing original English content.');
+          return;
+        }
+
+        const sourceLanguage = currentLanguage === targetLanguage ? 'en' : currentLanguage;
+        const options = {
+          sourceLanguage,
+          targetLanguage,
+        };
+
+        try {
+          translateBtn.disabled = true;
+          setStatus(`Checking on-device model availability for ${targetLanguage.toUpperCase()}...`);
+
+          const availability = await Translator.availability(options);
+
+          if (availability === 'unavailable') {
+            progressEl.hidden = true;
+            setStatus('Translation model is unavailable on this device for the selected language pair.', true);
+            return;
+          }
+
+          if (availability === 'downloadable' || availability === 'downloading') {
+            progressEl.hidden = false;
+            progressEl.value = 0;
+            setStatus(`Downloading on-device ${targetLanguage.toUpperCase()} language model (0%)...`);
+          } else if (availability === 'available') {
+            progressEl.hidden = true;
+            setStatus(`Translating menu descriptions and story text to ${targetLanguage.toUpperCase()}...`);
+          }
+
+          const translator = await Translator.create({
+            ...options,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const percent = Math.round((e.loaded ?? 0) * 100);
+                progressEl.hidden = false;
+                progressEl.value = percent;
+                setStatus(`Downloading language pack: ${percent}%`);
+              });
+            },
+          });
+
+          progressEl.hidden = true;
+          setStatus(`Translating content to ${targetLanguage.toUpperCase()}...`);
+
+          for (const el of translatableElements) {
+            const inputText = sourceLanguage === 'en' ? el.dataset.originalText : el.textContent.trim();
+            const translated = await translator.translate(inputText);
+            el.textContent = translated;
+          }
+
+          currentLanguage = targetLanguage;
+          applyLanguageDirection(targetLanguage);
+          setStatus(`Translated menu and story text to ${targetLanguage.toUpperCase()} on-device.`);
+        } catch (error) {
+          progressEl.hidden = true;
+          if (error && error.name === 'NotAllowedError') {
+            setStatus('Click the "Translate" button to authorize downloading the on-device language model.');
+          } else {
+            setStatus('Unable to complete on-device translation at this time.', true);
+          }
+        } finally {
+          translateBtn.disabled = false;
+        }
+      }
+
+      languageSelect.addEventListener('change', () => {
+        translatePageContent(languageSelect.value);
+      });
+
+      translateBtn.addEventListener('click', () => {
+        translatePageContent(languageSelect.value);
+      });
+    });
+  </script>
