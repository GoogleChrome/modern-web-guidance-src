+    /* Showcase Section */
+    .showcase {
+      margin-bottom: 40px;
+    }
+
+    .showcase-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 30px;
+      margin-top: 20px;
+      align-items: start;
+    }
+
+    .nested-curve-parent {
+      background: white;
+      padding: 20px;
+      border-radius: 24px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      /* Level 1 Fallback: clips child roughly at the padding box */
+      overflow: hidden;
+    }
+
+    .nested-curve-parent img {
+      width: 100%;
+      height: 220px;
+      object-fit: cover;
+      display: block;
+    }
+
+    .nested-curve-footer {
+      background: var(--primary);
+      color: white;
+      padding: 16px;
+      text-align: center;
+    }
+
+    .nested-curve-footer h3 {
+      margin-bottom: 6px;
+      color: var(--accent);
+    }
+
+    @supports (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        /* MANDATORY: overflow: clip is required on non-replaced elements */
+        overflow: clip;
+        /* Automatically curves clipping edge to match inner content-box radius */
+        overflow-clip-margin: content-box;
+      }
+    }
+
+    .safety-zone-parent {
+      background: white;
+      padding: 24px;
+      border-radius: 16px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      /* Level 1 Fallback: clips overflowing content but truncates child shadows */
+      overflow: hidden;
+    }
+
+    .safety-zone-parent h3 {
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    .safety-zone-parent p {
+      margin-bottom: 18px;
+      white-space: nowrap;
+    }
+
+    .glowing-promo-btn {
+      display: block;
+      width: 100%;
+      padding: 12px 20px;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      font-size: 1rem;
+      border: none;
+      border-radius: 8px;
+      cursor: pointer;
+      box-shadow: 0 8px 15px rgba(255, 171, 64, 0.75);
+      transition: transform 0.2s, box-shadow 0.2s;
+    }
+
+    .glowing-promo-btn:hover {
+      transform: translateY(-1px);
+      box-shadow: 0 10px 18px rgba(255, 171, 64, 0.9);
+    }
+
+    @supports (overflow-clip-margin: 15px) {
+      .safety-zone-parent {
+        overflow: clip;
+        /* Establishes a visible safety zone allowing child element shadows to render safely outside */
+        overflow-clip-margin: 15px;
+      }
+    }
+
