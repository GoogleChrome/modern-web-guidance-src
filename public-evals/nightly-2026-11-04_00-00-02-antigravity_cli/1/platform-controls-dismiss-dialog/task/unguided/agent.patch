+          imageAlt: 'Chilled glass of slow-steeped Cold Brew coffee over ice',
+          description: 'Coarsely ground single-origin beans steeped in filtered cold water for 18 hours. Naturally sweet with low acidity and an ultra-smooth, refreshing finish served over crystal ice.',
+          notes: 'Sweet cocoa nibs, roasted hazelnut, crisp caramel',
+          origin: 'Ethiopian Yirgacheffe • Medium-Dark Roast',
+          dietary: 'Unsweetened, Dairy-Free • 15 kcal (16 oz)',
+          orderUrl: '/order-online?item=cold-brew'
+        }
+      };
+
+      const modal = document.getElementById('coffee-details-modal');
+      const titleEl = document.getElementById('modal-coffee-title');
+      const badgeEl = document.getElementById('modal-coffee-badge');
+      const priceEl = document.getElementById('modal-coffee-price');
+      const imageEl = document.getElementById('modal-coffee-image');
+      const descEl = document.getElementById('modal-coffee-description');
+      const notesEl = document.getElementById('modal-coffee-notes');
+      const originEl = document.getElementById('modal-coffee-origin');
+      const dietaryEl = document.getElementById('modal-coffee-dietary');
+      const orderLinkEl = document.getElementById('modal-order-link');
+      const closeBtn = document.getElementById('modal-close-btn');
+      const closeIconBtn = document.getElementById('modal-close-icon-btn');
+      const triggerButtons = document.querySelectorAll('.js-open-details');
+
+      let lastFocusedTrigger = null;
+      let activeCloseWatcher = null;
+      let pushedHistoryState = false;
+      let closingFromHistory = false;
+
+      function populateModal(coffeeKey) {
+        const data = COFFEE_DETAILS[coffeeKey];
+        if (!data) return false;
+        titleEl.textContent = data.title;
+        badgeEl.textContent = data.badge;
+        priceEl.textContent = data.price;
+        imageEl.src = data.image;
+        imageEl.alt = data.imageAlt;
+        descEl.textContent = data.description;
+        notesEl.textContent = data.notes;
+        originEl.textContent = data.origin;
+        dietaryEl.textContent = data.dietary;
+        orderLinkEl.href = data.orderUrl;
+        return true;
+      }
+
+      function cleanupDismissHandlers() {
+        if (activeCloseWatcher) {
+          const watcher = activeCloseWatcher;
+          activeCloseWatcher = null;
+          watcher.onclose = null;
+          watcher.destroy();
+        }
+        if (pushedHistoryState) {
+          pushedHistoryState = false;
+          if (!closingFromHistory && history.state && history.state.coffeeModalOpen) {
+            history.back();
+          }
+        }
+        closingFromHistory = false;
+      }
+
+      function openCoffeeModal(coffeeKey, triggerEl) {
+        if (!populateModal(coffeeKey)) return;
+        lastFocusedTrigger = triggerEl || document.activeElement;
+
+        if (!modal.open) {
+          if (typeof modal.showModal === 'function') {
+            modal.showModal();
+          } else {
+            modal.setAttribute('open', '');
+          }
+        }
+
+        // Set up CloseWatcher if available (handles Escape and mobile back gesture natively in modern browsers),
+        // and also manage History state fallback for mobile back navigation where CloseWatcher isn't integrated.
+        if ('CloseWatcher' in window) {
+          try {
+            activeCloseWatcher = new window.CloseWatcher();
+            activeCloseWatcher.onclose = function () {
+              activeCloseWatcher = null;
+              if (modal.open) {
+                modal.close();
+              }
+            };
+          } catch (e) {
+            activeCloseWatcher = null;
+          }
+        } else {
+          try {
+            history.pushState({ coffeeModalOpen: true, coffeeKey: coffeeKey }, '');
+            pushedHistoryState = true;
+          } catch (e) {
+            pushedHistoryState = false;
+          }
+        }
+
+        closeIconBtn.focus();
+      }
+
+      function closeCoffeeModal() {
+        if (modal.open) {
+          if (typeof modal.close === 'function') {
+            modal.close();
+          } else {
+            modal.removeAttribute('open');
+          }
+        }
+      }
+
+      triggerButtons.forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          const coffeeKey = btn.getAttribute('data-coffee');
+          openCoffeeModal(coffeeKey, btn);
+        });
+      });
+
+      closeBtn.addEventListener('click', closeCoffeeModal);
+      closeIconBtn.addEventListener('click', closeCoffeeModal);
+
+      // Dismiss when clicking the dialog backdrop
+      modal.addEventListener('click', function (event) {
+        if (event.target === modal) {
+          closeCoffeeModal();
+        }
+      });
+
+      modal.addEventListener('close', function () {
+        cleanupDismissHandlers();
+        if (lastFocusedTrigger && typeof lastFocusedTrigger.focus === 'function') {
+          lastFocusedTrigger.focus();
+        }
+      });
+
+      window.addEventListener('popstate', function () {
+        if (modal.open) {
+          closingFromHistory = true;
+          closeCoffeeModal();
+        }
+      });
+    })();
+  </script>
