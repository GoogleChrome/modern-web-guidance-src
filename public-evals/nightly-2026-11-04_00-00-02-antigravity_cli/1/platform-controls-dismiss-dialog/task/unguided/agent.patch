+          origin: 'Central American Blend • Medium Roast',
+          dietary: '100% Plant-Based (Dairy-Free, Vegan) • 190 kcal (12 oz)',
+          orderUrl: '/order-online?item=maple-oat-latte'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          badge: 'Roaster’s Reserve',
+          price: '$3.75',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Rich dark roast espresso shot in a demitasse cup',
+          description: 'Bold, smokey, and full-bodied with a thick golden crema. Small-batch roasted to deep caramelization for an intense morning boost that stands up beautifully on its own.',
+          notes: 'Bittersweet dark chocolate, charred cedar, molasses',
+          origin: 'Sumatra & Colombia • French Dark Roast',
+          dietary: ' Gluten-Free, Vegan • 10 kcal (Double Shot)',
+          orderUrl: '/order-online?item=dark-roast-espresso'
+        },
