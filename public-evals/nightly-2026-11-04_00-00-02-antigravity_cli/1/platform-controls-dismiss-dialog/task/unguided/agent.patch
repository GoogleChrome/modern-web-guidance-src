+  <script>
+    (function () {
+      const COFFEE_DETAILS = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          badge: 'Seasonal Craft',
+          price: '$5.75',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Latte art in a ceramic cup for the Maple Oat Latte',
+          description: 'Creamy barista-grade oat milk steamed with pure Grade-A Vermont maple syrup, poured over our velvety double-shot house espresso and finished with a warm dusting of cinnamon.',
