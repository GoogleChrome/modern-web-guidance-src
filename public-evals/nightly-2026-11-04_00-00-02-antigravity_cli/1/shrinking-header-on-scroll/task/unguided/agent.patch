+  <script>
+    (function () {
+      const nav = document.querySelector('nav');
+      if (!nav) return;
+
+      const scrollRange = 100;
+      const supportsScrollTimeline =
+        typeof window.CSS !== 'undefined' &&
+        typeof window.CSS.supports === 'function' &&
+        window.CSS.supports('animation-timeline', 'scroll()');
+
+      if (!supportsScrollTimeline) {
+        nav.setAttribute('data-scroll-fallback', 'true');
+      }
+
+      let rafId = null;
+
+      function applyScrollState() {
+        const scrollY =
+          window.scrollY ||
+          window.pageYOffset ||
+          document.documentElement.scrollTop ||
+          0;
+        const progress = Math.min(Math.max(scrollY / scrollRange, 0), 1);
+
+        if (scrollY > 20) {
+          nav.classList.add('scrolled');
+        } else {
+          nav.classList.remove('scrolled');
+        }
+
+        if (!supportsScrollTimeline || scrollY > 0) {
+          if (scrollY > 0) {
+            nav.style.setProperty('--scroll-progress', progress.toFixed(4));
+          } else {
+            nav.style.removeProperty('--scroll-progress');
+          }
+        }
+      }
+
+      function onScroll() {
+        applyScrollState();
+        if (rafId === null) {
+          rafId = window.requestAnimationFrame(function () {
+            applyScrollState();
+            rafId = null;
+          });
+        }
+      }
+
+      window.addEventListener('scroll', onScroll, { passive: true });
+      applyScrollState();
+    })();
+  </script>
