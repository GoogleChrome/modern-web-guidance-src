+  <script>
+    function updateMapleOatTimer() {
+      const countdownEl = document.getElementById('maple-countdown');
+      const elapsedEl = document.getElementById('maple-elapsed');
+      if (!countdownEl || !elapsedEl) return;
+
+      let remainingDays = 0;
+      let remainingHours = 0;
+      let isExpired = false;
+      let elapsedDays = 0;
+      let elapsedHours = 0;
+
+      if (typeof Temporal !== 'undefined') {
+        const userTimeZone = Temporal.Now.timeZoneId();
+        const now = Temporal.Now.zonedDateTimeISO(userTimeZone);
+
+        // Offer ends March 1, 2026 at midnight in the user's local time zone
+        const offerEnd = Temporal.PlainDateTime.from('2026-03-01T00:00:00')
+          .toZonedDateTime(userTimeZone);
+
+        // Promotion start in the user's local time zone
+        const promoStart = Temporal.PlainDateTime.from('2026-02-01T00:00:00')
+          .toZonedDateTime(userTimeZone);
+
+        if (Temporal.ZonedDateTime.compare(now, offerEnd) >= 0) {
+          isExpired = true;
+        } else {
+          const remaining = now.until(offerEnd, { largestUnit: 'days' });
+          remainingDays = remaining.days;
+          remainingHours = remaining.hours;
+        }
+
+        if (Temporal.ZonedDateTime.compare(now, promoStart) > 0) {
+          const elapsed = now.since(promoStart, { largestUnit: 'days' });
+          elapsedDays = elapsed.days;
+          elapsedHours = elapsed.hours;
+        }
+      } else {
+        // Fallback for environments without native Temporal support
+        const now = new Date();
+        const offerEnd = new Date(2026, 2, 1, 0, 0, 0, 0);
+        const promoStart = new Date(2026, 1, 1, 0, 0, 0, 0);
+
+        const remainingMs = offerEnd.getTime() - now.getTime();
+        if (remainingMs <= 0) {
+          isExpired = true;
+        } else {
+          const totalRemainingHours = Math.floor(remainingMs / (1000 * 60 * 60));
+          remainingDays = Math.floor(totalRemainingHours / 24);
+          remainingHours = totalRemainingHours % 24;
+        }
+
+        const elapsedMs = Math.max(0, now.getTime() - promoStart.getTime());
+        const totalElapsedHours = Math.floor(elapsedMs / (1000 * 60 * 60));
+        elapsedDays = Math.floor(totalElapsedHours / 24);
+        elapsedHours = totalElapsedHours % 24;
+      }
+
+      if ( typeof Intl !== 'undefined' && typeof Intl.DurationFormat !== 'undefined') {
+        const formatter = new Intl.DurationFormat(undefined, { style: 'long' });
+        const formattedRemaining = formatter.format({ days: remainingDays, hours: remainingHours });
+        const formattedElapsed = formatter.format({ days: elapsedDays, hours: elapsedHours });
+
+        if (isExpired) {
+          countdownEl.innerHTML = `<span id="countdown-days">0</span> days, <span id="countdown-hours">0</span> hours left (Offer ended)`;
+        } else {
+          countdownEl.innerHTML = `<span id="countdown-days">${remainingDays}</span> days, <span id="countdown-hours">${remainingHours}</span> hours left`;
+          countdownEl.setAttribute('title', formattedRemaining);
+        }
+        elapsedEl.innerHTML = `Elapsed since promotion start: <span id="elapsed-days">${elapsedDays}</span> days, <span id="elapsed-hours">${elapsedHours}</span> hours`;
+        elapsedEl.setAttribute('title', formattedElapsed);
+      } else {
+        if (isExpired) {
+          countdownEl.innerHTML = `<span id="countdown-days">0</span> days, <span id="countdown-hours">0</span> hours left (Offer ended)`;
+        } else {
+          countdownEl.innerHTML = `<span id="countdown-days">${remainingDays}</span> days, <span id="countdown-hours">${remainingHours}</span> hours left`;
+        }
+        elapsedEl.innerHTML = `Elapsed since promotion start: <span id="elapsed-days">${elapsedDays}</span> days, <span id="elapsed-hours">${elapsedHours}</span> hours`;
+      }
+    }
+
+    document.addEventListener('DOMContentLoaded', updateMapleOatTimer);
+    window.addEventListener('load', updateMapleOatTimer);
+    updateMapleOatTimer();
+  </script>
+
 </body>
 
