+  <script>
+    function updateMapleOatCountdown() {
+      const remainingEl = document.getElementById('promo-remaining');
+      const elapsedEl = document.getElementById('promo-elapsed');
+      const statusEl = document.getElementById('promo-status');
+      if (!remainingEl || !elapsedEl || !statusEl) return;
+
+      const now = Temporal.Now.zonedDateTimeISO();
+      const userTimeZone = now.timeZoneId;
+
+      const startDateStr = '2026-01-01';
+      const startTimeStr = '00:00:00';
+      const endDateStr = '2026-03-01';
+      const endTimeStr = '00:00:00';
+
+      const promoStart = Temporal.PlainDate.from(startDateStr)
+        .toPlainDateTime(startTimeStr)
+        .toZonedDateTime(userTimeZone);
+      const promoEnd = Temporal.PlainDate.from(endDateStr)
+        .toPlainDateTime(endTimeStr)
+        .toZonedDateTime(userTimeZone);
+
+      const timeElapsed = now.since(promoStart, { largestUnit: 'day', smallestUnit: 'hour' });
+      const timeRemaining = now.until(promoEnd, { largestUnit: 'day', smallestUnit: 'hour' });
+
+      elapsedEl.setAttribute('datetime', timeElapsed.toString());
+      elapsedEl.textContent = timeElapsed.toLocaleString('en-US', { style: 'long' });
+
+      remainingEl.setAttribute('datetime', timeRemaining.toString());
+      remainingEl.textContent = timeRemaining.toLocaleString('en-US', { style: 'long' });
+
+      const isExpired = timeRemaining.sign < 0;
+      const isPastHalfway = Temporal.Duration.compare(timeElapsed, timeRemaining, { relativeTo: now }) > 0;
+
+      if (isExpired) {
+        statusEl.textContent = 'Offer Ended';
+      } else {
+        statusEl.textContent = isPastHalfway ? 'Ending Soon' : 'Seasonal Offer Active';
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', updateMapleOatCountdown, { once: true });
+      } else {
+        updateMapleOatCountdown();
+      }
+    })();
+  </script>
