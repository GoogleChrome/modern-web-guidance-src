diff --git a/src/utils/smsOtp.ts b/src/utils/smsOtp.ts
new file mode 100644
index 0000000..966fe41
--- /dev/null
+++ b/src/utils/smsOtp.ts
@@ -0,0 +1,52 @@
+/**
+ * Extracts only the host domain from a URL or host string, stripping any
+ * scheme (`https://`, `http://`), port (`:8080`), path (`/verify`), or whitespace.
+ */
+export function normalizeOtpDomain(domainOrUrl: string): string {
+  const trimmed = domainOrUrl.trim();
+  if (!trimmed) {
+    return 'localhost';
+  }
+  try {
+    const withProtocol = /^https?:\/\//i.test(trimmed) ? trimmed : `https://${trimmed}`;
+    const parsed = new URL(withProtocol);
+    return parsed.hostname.replace(/\s+/g, '') || 'localhost';
+  } catch {
+    return (
+      trimmed
+        .replace(/^https?:\/\//i, '')
+        .split('/')[0]
+        .split(':')[0]
+        .replace(/\s+/g, '') || 'localhost'
+    );
+  }
+}
+
+/**
+ * Formats an origin-bound SMS OTP message per the WebOTP and Safari
+ * `autocomplete="one-time-code"` specification:
+ * - Starts with a clear human-readable sentence containing the code.
+ * - Places `@<domain> #<otp>` on the very last line with a single space between tokens
+ *   and no trailing text.
+ */
+export function formatOriginBoundSms(
+  domain: string,
+  code: string,
+  embeddedIframeDomain?: string
+): string {
+  const hostDomain = normalizeOtpDomain(domain);
+  const cleanCode = code.replace(/\s+/g, '');
+  const iframeBinding = embeddedIframeDomain
+    ? ` @${normalizeOtpDomain(embeddedIframeDomain)}`
+    : '';
+
+  return `Your verification code is ${cleanCode}.\n\n@${hostDomain} #${cleanCode}${iframeBinding}`;
+}
+
+/**
+ * Generates a 6-digit numeric OTP string, preserving leading zeros (e.g., "012345").
+ */
+export function generateSixDigitOtp(): string {
+  const randomInt = Math.floor(Math.random() * 1000000);
+  return String(randomInt).padStart(6, '0');
+}
