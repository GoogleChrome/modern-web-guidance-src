+              aria-describedby="otp-format-hint"
+              aria-errormessage="otp-error"
+              required
+              className="signup-input w-full border border-gray-300 rounded-md"
+            />
+            <p id="otp-error" className="error-msg" aria-live="polite">
+              <span aria-hidden="true">❌ </span>Please enter the 6-digit numeric verification code.
+            </p>
+          </div>
+        </fieldset>
+
+        <div className="flex flex-col gap-2">
+          <button
+            type="submit"
+            disabled={verifying}
+            data-skip-tracking="true"
+            className={`signup-btn w-full py-2.5 px-4 border border-transparent rounded-md shadow-sm text-base font-medium text-white bg-gray-900 hover:bg-gray-800 ${
+              verifying ? 'opacity-75 cursor-not-allowed' : ''
+            }`}
+          >
+            {verifying ? 'Verifying & creating account...' : 'Verify code and create account'}
+          </button>
+
+          <button
+            type="button"
+            onClick={requestSmsOtp}
+            disabled={sendingOtp || verifying}
+            data-skip-tracking="true"
+            className="signup-btn w-full py-2 px-4 border border-gray-300 rounded-md text-base font-medium text-gray-700 bg-white hover:bg-gray-50"
+          >
+            Resend code
+          </button>
+        </div>
+      </form>
     </div>
   );
 }
diff --git a/src/pages/api/send-otp.ts b/src/pages/api/send-otp.ts
