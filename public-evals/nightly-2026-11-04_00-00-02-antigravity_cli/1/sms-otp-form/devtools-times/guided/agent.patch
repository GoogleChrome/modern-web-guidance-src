--- /dev/null
+++ b/src/pages/api/verify-otp.ts
@@ -0,0 +1,85 @@
+import type { APIRoute } from 'astro';
+
+const OTP_REGEX = /^\d{6}$/;
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    let otp = '';
+    let phone = '';
+
+    const contentType = request.headers.get('content-type') || '';
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      otp = String(body.otp || '').trim();
+      phone = String(body.phone || '').trim();
+    } else {
+      const formData = await request.formData();
+      otp = String(formData.get('otp') || '').trim();
+      phone = String(formData.get('phone') || '').trim();
+    }
+
+    if (!OTP_REGEX.test(otp)) {
+      return new Response(
+        JSON.stringify({
+          error: 'Please enter a valid 6-digit verification code.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const pendingOtp = (await session?.get('pendingOtp')) as
+      | { phone: string; code: string; expiresAt: number }
+      | undefined;
+
+    if (pendingOtp) {
+      if (Date.now() > pendingOtp.expiresAt) {
+        return new Response(
+          JSON.stringify({
+            error: 'Verification code has expired. Please request a new code.',
+          }),
+          {
+            status: 400,
+            headers: { 'Content-Type': 'application/json' },
+          }
+        );
+      }
+
+      if (pendingOtp.code !== otp || (phone && pendingOtp.phone !== phone)) {
+        return new Response(
+          JSON.stringify({
+            error: 'Invalid verification code. Please check the SMS sent to your phone.',
+          }),
+          {
+            status: 400,
+            headers: { 'Content-Type': 'application/json' },
+          }
+        );
+      }
+
+      await session?.set('pendingOtp', undefined);
+    }
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({
+        error: 'Unable to verify code. Please try again.',
+      }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
