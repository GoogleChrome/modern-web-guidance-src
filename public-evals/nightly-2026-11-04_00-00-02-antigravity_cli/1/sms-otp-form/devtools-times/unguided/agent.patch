+const PHONE_REGEX = /^\+?[0-9\s\-().]{7,20}$/;
+const OTP_REGEX = /^\d{6}$/;
+
+export function isValidPhoneNumber(value: string): boolean {
+  const trimmed = value.trim();
+  if (!PHONE_REGEX.test(trimmed)) {
+    return false;
+  }
+  const digits = trimmed.replace(/\D/g, '');
+  return digits.length >= 7 && digits.length <= 15;
+}
+
+export function extractOtpCode(input: string): string {
+  const trimmed = input.trim();
+  // Match origin-bound WebOTP SMS format first (e.g., "@example.com #123456")
+  const hashMatch = trimmed.match(/#(\d{6})\b/);
+  if (hashMatch) {
+    return hashMatch[1];
+  }
+  // Match a standalone 6-digit passcode in an SMS message
+  const sixDigitMatch = trimmed.match(/\b(\d{6})\b/);
+  if (sixDigitMatch) {
+    return sixDigitMatch[1];
+  }
+  // Otherwise keep only numeric characters up to 6 digits
+  return trimmed.replace(/\D/g, '').slice(0, 6);
+}
 
