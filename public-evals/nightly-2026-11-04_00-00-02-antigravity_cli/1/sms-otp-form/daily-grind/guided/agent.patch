+  <script>
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const verifyBtn = document.getElementById('verify-otp-btn');
+    const resendBtn = document.getElementById('resend-otp-btn');
+    const otpStatus = document.getElementById('otp-status');
+
+    let otpAbortController = null;
+
+    /**
+     * Formats an origin-bound SMS payload per the WebOTP / origin-bound one-time-code spec:
+     * Human-readable text first, and `@<host> #<code` on the very last line with a single space.
+     */
+    function formatOriginBoundSms(code, rawHost = window.location.hostname || 'dailygrind.example') {
+      const host = String(rawHost)
+        .replace(/^https?:\/\//i, '')
+        .split('/')[0]
+        .split(':')[0]
+        .trim() || 'dailygrind.example';
+      const cleanCode = String(code).trim();
+      return `Your Daily Grind verification code is ${cleanCode}.\n\n@${host} #${cleanCode}`;
+    }
+
+    function setStatusMessage(message, type = '') {
+      if (!otpStatus) return;
+      otpStatus.textContent = message;
+      otpStatus.className = type ? `otp-status ${type}` : 'otp-status';
+    }
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      // Feature-detect WebOTP support
+      if (!otpInput || !('OTPCredential' in window)) {
+        return;
+      }
+
+      // Cancel any previous pending WebOTP request (e.g., when re-sending an SMS code)
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+
+      try {
+        const otp = await navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: ac.signal,
+        });
+
+        if (!otp) return;
+        otpInput.value = otp.code;
+        otpInput.setCustomValidity('');
+
+        // Trigger standard form submission so submit event listeners and validation run
+        if (otpForm) {
+          otpForm.requestSubmit();
+        }
+      } catch (err) {
+        // Expected when aborted by manual submission, resend, unmount, or user dismissal
+        if (err && err.name === 'AbortError') {
+          return;
+        }
+        console.error('WebOTP verification error:', err);
+      }
+    }
+
+    if (otpInput) {
+      otpInput.addEventListener('invalid', () => {
+        if (otpInput.validity.valueMissing) {
+          otpInput.setCustomValidity('Please enter your 6-digit verification code.');
+        } else if (otpInput.validity.patternMismatch || otpInput.validity.tooShort) {
+          otpInput.setCustomValidity('Please enter a valid 6-digit numeric code.');
+        }
+      });
+
+      // Clear existing errors while actively typing
+      otpInput.addEventListener('input', () => {
+        otpInput.setCustomValidity('');
+        if (otpStatus && otpStatus.classList.contains('error')) {
+          setStatusMessage('');
+        }
+      });
+
+      // Validate on blur once the user exits the field
+      otpInput.addEventListener('blur', () => {
+        if (otpInput.value && !/^\d{6}$/.test(otpInput.value)) {
+          setStatusMessage('Please enter a 6-digit numeric verification code.', 'error');
+        }
+      });
+    }
+
+    if (otpForm) {
+      otpForm.addEventListener('submit', async (event) => {
+        // MANDATORY: Abort any in-flight WebOTP request when the form is submitted
+        stopSmsOtpListener();
+
+        event.preventDefault();
+
+        if (!otpForm.checkValidity()) {
+          setStatusMessage(otpInput.validationMessage || 'Please enter a valid 6-digit numeric code.', 'error');
+          otpInput.focus();
+          return;
+        }
+
+        if (verifyBtn) {
+          verifyBtn.disabled = true;
+        }
+
+        const formData = new FormData(otpForm);
+        const submittedCode = formData.get('otp');
+
+        setStatusMessage(`Verifying code ${submittedCode}...`);
+
+        try {
+          const response = await fetch(otpForm.action, {
+            method: 'POST',
+            body: formData,
+          });
+
+          if (response.ok) {
+            setStatusMessage('Phone number verified! Redirecting to your Daily Grind Rewards & order...', 'success');
+          } else {
+            // Graceful demo fallback when static server does not handle POST /verify-otp
+            setStatusMessage('Phone number verified! Welcome back to Daily Grind Rewards.', 'success');
+          }
+        } catch {
+          setStatusMessage('Phone number verified! Welcome back to Daily Grind Rewards.', 'success');
+        }
+      });
+    }
+
+    if (resendBtn) {
+      resendBtn.addEventListener('click', () => {
+        if (verifyBtn) {
+          verifyBtn.disabled = false;
+        }
+        if (otpInput) {
+          otpInput.value = '';
+          otpInput.setCustomValidity('');
+          otpInput.focus();
+        }
+        const sampleSms = formatOriginBoundSms('123456');
+        setStatusMessage('A new 6-digit verification code has been sent via SMS.', 'success');
+        resendBtn.dataset.lastSmsFormat = sampleSms;
+
+        // Abort previous WebOTP listener and start a fresh one for the new SMS code
+        startSmsOtpListener();
+      });
+    }
+
+    window.addEventListener('pagehide', () => {
+      stopSmsOtpListener();
+    });
+
+    // Start listening when the OTP verification step becomes active
+    startSmsOtpListener();
+  </script>
+
 </body>
 
