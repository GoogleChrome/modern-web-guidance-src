+  <div id="tour-step" popover="manual" role="dialog" aria-labelledby="tour-title">
+    <h2 id="tour-title">Earn Rewards</h2>
+    <p>Earn points on every coffee order and redeem them for free drinks and perks!</p>
+    <button type="button" popovertarget="tour-step" popovertargetaction="hide">Got it</button>
+  </div>
+
+  <script type="module">
+    const tourStep = document.getElementById('tour-step');
+    const featureLink = document.getElementById('feature');
+    const closeButton = tourStep.querySelector('button');
+
+    async function initTour() {
+      if (!("popover" in HTMLElement.prototype)) {
+        await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+      }
+      if (!CSS.supports("anchor-name: --a")) {
+        import("https://unpkg.com/@oddbird/css-anchor-positioning");
+      }
+      tourStep.showPopover();
+      closeButton.focus();
+    }
+
+    featureLink.addEventListener('click', (event) => {
+      if (tourStep.matches(':is(:popover-open, .\\:popover-open)')) {
+        event.preventDefault();
+      }
+    });
+
+    initTour();
+  </script>
