+  <script>
+    const ALLOWED_TAGS = new Set([
+      'div', 'span', 'p', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
+      'a', 'ul', 'ol', 'li', 'strong', 'em', 'b', 'i', 'u',
+      'br', 'hr', 'img', 'section', 'article', 'button', 'small'
+    ]);
+
+    const ALLOWED_ATTRS = new Set([
+      'class', 'id', 'href', 'src', 'alt', 'title', 'role', 'target', 'rel'
+    ]);
+
+    function escapeHtml(value) {
+      return String(value)
+        .replace(/&/g, '&amp;')
+        .replace(/</g, '&lt;')
+        .replace(/>/g, '&gt;')
+        .replace(/"/g, '&quot;')
+        .replace(/'/g, '&#39;');
+    }
+
+    function isSafeUrl(url) {
+      const decoded = String(url)
+        .replace(/&#x([0-9a-f]+);?/gi, (_, hex) => String.fromCharCode(parseInt(hex, 16)))
+        .replace(/&#([0-9]+);?/g, (_, dec) => String.fromCharCode(parseInt(dec, 10)))
+        .replace(/[\u0000-\u0020]+/g, '')
+        .toLowerCase();
+      return !(
+        decoded.startsWith('javascript:') ||
+        decoded.startsWith('vbscript:') ||
+        decoded.startsWith('data:')
+      );
+    }
+
+    function sanitizeHtml(dirtyHtml) {
+      let clean = String(dirtyHtml)
+        .replace(/<!--[\s\S]*?-->/g, '')
+        .replace(/<(script|style|iframe|object|embed|applet|svg|math|form|base|meta|link)\b[^>]*>[\s\S]*?<\/\1>/gi, '')
+        .replace(/<(script|style|iframe|object|embed|applet|svg|math|form|base|meta|link)\b[^>]*\/?>/gi, '');
+
+      return clean.replace(/<\/?([a-zA-Z][a-zA-Z0-9:-]*)(\s[^>]*)?>/g, (match, rawTag, rawAttrs = '') => {
+        const tag = rawTag.toLowerCase();
+        if (!ALLOWED_TAGS.has(tag)) {
+          return '';
+        }
+        if (match.startsWith('</')) {
+          return `</${tag}>`;
+        }
+
+        const safeAttrs = [];
+        const attrRegex = /([a-zA-Z_:][a-zA-Z0-9_.:-]*)\s*(?:=\s*(?:"([^"]*)"|'([^']*)'|([^\s"'=<>`]+)))?/g;
+        let attrMatch;
+        while ((attrMatch = attrRegex.exec(rawAttrs)) !== null) {
+          const attrName = attrMatch[1].toLowerCase();
+          if (attrName.startsWith('on') || !ALLOWED_ATTRS.has(attrName)) {
+            continue;
+          }
+          const attrVal = attrMatch[2] ?? attrMatch[3] ?? attrMatch[4] ?? '';
+          if ((attrName === 'href' || attrName === 'src') && !isSafeUrl(attrVal)) {
+            continue;
+          }
+          safeAttrs.push(`${attrName}="${escapeHtml(attrVal)}"`);
+        }
+
+        const attrString = safeAttrs.length > 0 ? ' ' + safeAttrs.join(' ') : '';
+        return `<${tag}${attrString}>`;
+      });
+    }
+
+    const seasonalFavoritesPolicy = window.trustedTypes
+      ? window.trustedTypes.createPolicy('seasonal-favorites-policy', {
+          createHTML(input) {
+            return sanitizeHtml(input);
+          }
+        })
+      : {
+          createHTML(input) {
+            return sanitizeHtml(input);
+          }
+        };
+
+    const seasonalFavorites = [
+      `<div class="card">
+        <h3>Maple Oat Latte</h3>
+        <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+        <a href="/menu/seasonal" class="btn">View Details</a>
+      </div>`,
+      `<div class="card">
+        <h3>Dark Roast Espresso</h3>
+        <p>Bold, smokey, and perfect for a morning boost.</p>
+        <a href="/menu/espresso" class="btn">View Details</a>
+      </div>`,
+      `<div class="card">
+        <h3>Cold Brew</h3>
+        <p>Steeped for 18 hours for maximum smoothness.</p>
+        <a href="/menu/cold-brew" class="btn">View Details</a>
+      </div>`
+    ];
+
+    function renderSeasonalFavorites(items = seasonalFavorites) {
+      const grid = document.querySelector('.grid');
+      if (!grid) return;
+
+      const cardsHtml = items
+        .map((item) =>
+          typeof item === 'string'
+            ? item
+            : `<div class="card">
+                <h3>${escapeHtml(item.title)}</h3>
+                <p>${escapeHtml(item.description)}</p>
+                <a href="${escapeHtml(item.href || item.link)}" class="btn">${escapeHtml(item.linkText || item.cta || 'View Details')}</a>
+              </div>`
+        )
+        .join('');
+
+      grid.innerHTML = seasonalFavoritesPolicy.createHTML(cardsHtml);
+    }
+
+    renderSeasonalFavorites();
+  </script>
