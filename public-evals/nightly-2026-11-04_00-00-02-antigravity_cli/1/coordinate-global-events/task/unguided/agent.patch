+  <script>
+    (function () {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const TARGET_TIMEZONES = [
+        { name: 'New York', id: 'America/New_York' },
+        { name: 'London', id: 'Europe/London' },
+        { name: 'Tokyo', id: 'Asia/Tokyo' },
+        { name: 'UTC', id: 'UTC' }
+      ];
+
+      function formatTime12Hour(timeLike) {
+        const hour24 = timeLike.hour;
+        const minute = String(timeLike.minute).padStart(2, '0');
+        const period = hour24 >= 12 ? 'PM' : 'AM';
+        const hour12 = hour24 % 12 || 12;
+        return `${hour12}:${minute} ${period}`;
+      }
+
+      function updateSchedule() {
+        const dateValue = dateInput.value;
+        const timeValue = timeInput.value;
+        const hostTz = hostTzSelect.value;
+
+        if (!dateValue || !timeValue || !hostTz) {
+          return;
+        }
+
+        const plainDate = Temporal.PlainDate.from(dateValue);
+        const plainTime = Temporal.PlainTime.from(timeValue);
+        const requestedPlainDateTime = plainDate.toPlainDateTime(plainTime);
+
+        const earlierZdt = requestedPlainDateTime.toZonedDateTime(hostTz, {
+          disambiguation: 'earlier'
+        });
+        const laterZdt = requestedPlainDateTime.toZonedDateTime(hostTz, {
+          disambiguation: 'later'
+        });
+        const resolvedHostZdt = requestedPlainDateTime.toZonedDateTime(hostTz, {
+          disambiguation: 'compatible'
+        });
+
+        let rejectedByStrictCheck = false;
+        try {
+          requestedPlainDateTime.toZonedDateTime(hostTz, {
+            disambiguation: 'reject'
+          });
+        } catch (_err) {
+          rejectedByStrictCheck = true;
+        }
+
+        const hasDstConflict =
+          rejectedByStrictCheck ||
+          earlierZdt.epochNanoseconds !== laterZdt.epochNanoseconds;
+
+        if (hasDstConflict) {
+          const isGap = !resolvedHostZdt
+            .toPlainDateTime()
+            .equals(requestedPlainDateTime);
+          const requestedFormatted = formatTime12Hour(requestedPlainDateTime);
+          const resolvedFormatted = formatTime12Hour(resolvedHostZdt);
+          const earlierFormatted = formatTime12Hour(earlierZdt);
+          const laterFormatted = formatTime12Hour(laterZdt);
+
+          if (isGap) {
+            hostWarning.textContent =
+              `DST Transition Gap Detected: ${requestedFormatted} on ${plainDate.toString()} does not exist in ${hostTz} because clocks spring forward across a Daylight Saving Time gap. ` +
+              `Using compatible disambiguation, this non-existent time was resolved forward to ${resolvedFormatted} (UTC${resolvedHostZdt.offset}) rather than ${earlierFormatted} (UTC${earlierZdt.offset}).`;
+          } else {
+            hostWarning.textContent =
+              `DST Transition Overlap Detected: ${requestedFormatted} on ${plainDate.toString()} is ambiguous in ${hostTz} because clocks fall back and the time occurs twice (first at UTC${earlierZdt.offset}, then again at UTC${laterZdt.offset}). ` +
+              `Using compatible disambiguation, this conflict was resolved to the earlier occurrence at ${resolvedFormatted} (UTC${resolvedHostZdt.offset}).`;
+          }
+          hostWarning.classList.add('visible');
+        } else {
+          hostWarning.textContent = '';
+          hostWarning.classList.remove('visible');
+        }
+
+        grid.innerHTML = '';
+
+        for (const tz of TARGET_TIMEZONES) {
+          // Temporal.ZonedDateTime is immutable; withTimeZone returns a new instance
+          const targetZdt = resolvedHostZdt.withTimeZone(tz.id);
+          const formattedLocalTime = formatTime12Hour(targetZdt);
+          const formattedDate = targetZdt.toPlainDate().toString();
+          const isHost = tz.id === hostTz;
+
+          const card = document.createElement('div');
+          card.className = isHost ? 'card is-host' : 'card';
+          card.setAttribute('data-tz', tz.id);
+
+          const heading = document.createElement('h3');
+          heading.textContent = tz.name;
+          if (isHost) {
+            const badge = document.createElement('span');
+            badge.className = 'host-badge';
+            badge.textContent = 'Host';
+            heading.appendChild(badge);
+          }
+
+          const tzSpan = document.createElement('span');
+          tzSpan.className = 'tz-identifier';
+          tzSpan.textContent = tz.id;
+
+          const timeDiv = document.createElement('div');
+          timeDiv.className = 'local-time';
+          timeDiv.textContent = formattedLocalTime;
+
+          const dateDiv = document.createElement('div');
+          dateDiv.className = 'local-date';
+          dateDiv.textContent = `${formattedDate} (UTC${targetZdt.offset})`;
+
+          card.appendChild(heading);
+          card.appendChild(tzSpan);
+          card.appendChild(timeDiv);
+          card.appendChild(dateDiv);
+          grid.appendChild(card);
+        }
+      }
+
+      dateInput.addEventListener('change', updateSchedule);
+      dateInput.addEventListener('input', updateSchedule);
+      timeInput.addEventListener('change', updateSchedule);
+      timeInput.addEventListener('input', updateSchedule);
+      hostTzSelect.addEventListener('change', updateSchedule);
+      hostTzSelect.addEventListener('input', updateSchedule);
+
+      updateSchedule();
+    })();
+  </script>
 </body>
 
