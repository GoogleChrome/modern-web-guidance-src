+  <script>
+    const TARGET_ZONES = [
+      { label: 'New York', timeZone: 'America/New_York' },
+      { label: 'London', timeZone: 'Europe/London' },
+      { label: 'Tokyo', timeZone: 'Asia/Tokyo' },
+      { label: 'UTC', timeZone: 'UTC' }
+    ];
+
+    function initializeApp() {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      function updateSchedule() {
+        const date = dateInput.value;
+        const time = timeInput.value;
+        const timeZone = hostTzSelect.value;
+
+        if (!date || !time || !timeZone) {
+          return;
+        }
+
+        const inputStr = `${date}T${time}[${timeZone}]`;
+
+        // Detect DST transition gaps or overlaps using disambiguation: 'reject'
+        let hasConflict = false;
+        try {
+          Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'reject' });
+        } catch (e) {
+          if (e instanceof RangeError) {
+            hasConflict = true;
+          }
+        }
+
+        // Resolve time safely using disambiguation: 'compatible' (default)
+        const hostTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'compatible' });
+
+        if (hasConflict) {
+          const resolvedTimeDisplay = hostTime.toLocaleString('en-US', {
+            hour: 'numeric',
+            minute: '2-digit'
+          });
+          const resolvedDateDisplay = hostTime.toLocaleString('en-US', {
+            month: 'short',
+            day: 'numeric',
+            year: 'numeric'
+          });
+          hostWarning.hidden = false;
+          hostWarning.textContent = `Daylight Saving Time Conflict: The selected time (${time}) in ${timeZone} falls within a DST transition gap (skipped spring-forward hour) or overlap (repeated fall-back hour). Using 'compatible' disambiguation, it was automatically resolved to ${resolvedTimeDisplay} on ${resolvedDateDisplay} (${hostTime.offset}).`;
+        } else {
+          hostWarning.hidden = true;
+          hostWarning.textContent = '';
+        }
+
+        // Render cards for each target timezone without mutating the immutable hostTime object
+        grid.replaceChildren(
+          ...TARGET_ZONES.map((target) => {
+            const convertedTime = hostTime.withTimeZone(target.timeZone);
+            const formattedTime = convertedTime.toLocaleString('en-US', {
+              hour: 'numeric',
+              minute: '2-digit'
+            });
+            const formattedDate = convertedTime.toLocaleString('en-US', {
+              weekday: 'short',
+              month: 'short',
+              day: 'numeric',
+              year: 'numeric'
+            });
+
+            const card = document.createElement('div');
+            card.className = 'card tz-card';
+
+            const heading = document.createElement('h3');
+            heading.textContent = target.label;
+
+            const tzId = document.createElement('p');
+            tzId.className = 'tz-id';
+            tzId.textContent = `${target.timeZone} (UTC${convertedTime.offset})`;
+
+            const timeEl = document.createElement('p');
+            timeEl.className = 'tz-time';
+            timeEl.textContent = formattedTime;
+
+            const dateEl = document.createElement('p');
+            dateEl.className = 'tz-date';
+            dateEl.textContent = formattedDate;
+
+            card.append(heading, tzId, timeEl, dateEl);
+            return card;
+          })
+        );
+      }
+
+      dateInput.addEventListener('change', updateSchedule);
+      dateInput.addEventListener('input', updateSchedule);
+      timeInput.addEventListener('change', updateSchedule);
+      timeInput.addEventListener('input', updateSchedule);
+      hostTzSelect.addEventListener('change', updateSchedule);
+
+      updateSchedule();
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
