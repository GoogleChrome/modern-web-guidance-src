+  <script>
+    function base64UrlToBuffer(base64url) {
+      const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+      const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+      const rawData = atob(base64);
+      const outputArray = new Uint8Array(rawData.length);
+      for (let i = 0; i < rawData.length; ++i) {
+        outputArray[i] = rawData.charCodeAt(i);
+      }
+      return outputArray.buffer;
+    }
+
+    function bufferToBase64Url(buffer) {
+      const bytes = new Uint8Array(buffer);
+      let str = '';
+      for (const byte of bytes) {
+        str += String.fromCharCode(byte);
+      }
+      return btoa(str).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function parseCreationOptions(optionsJSON) {
+      if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+        return PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+      }
+      const options = {
+        ...optionsJSON,
+        challenge: base64UrlToBuffer(optionsJSON.challenge),
+        user: {
+          ...optionsJSON.user,
+          id: base64UrlToBuffer(optionsJSON.user.id),
+        },
+      };
+      if (Array.isArray(optionsJSON.excludeCredentials)) {
+        options.excludeCredentials = optionsJSON.excludeCredentials.map((cred) => ({
+          ...cred,
+          id: base64UrlToBuffer(cred.id),
+        }));
+      }
+      return options;
+    }
+
+    function serializeCredential(credential) {
+      if (typeof credential.toJSON === 'function') {
+        return credential.toJSON();
+      }
+      const response = credential.response;
+      const serialized = {
+        id: credential.id,
+        rawId: bufferToBase64Url(credential.rawId),
+        type: credential.type,
+        authenticatorAttachment: credential.authenticatorAttachment || null,
+        clientExtensionResults: credential.getClientExtensionResults ? credential.getClientExtensionResults() : {},
+        response: {
+          clientDataJSON: bufferToBase64Url(response.clientDataJSON),
+          attestationObject: bufferToBase64Url(response.attestationObject),
+        },
+      };
+      if (typeof response.getTransports === 'function') {
+        serialized.response.transports = response.getTransports();
+      }
+      if (typeof response.getAuthenticatorData === 'function') {
+        serialized.response.authenticatorData = bufferToBase64Url(response.getAuthenticatorData());
+      }
+      if (typeof response.getPublicKey === 'function') {
+        const pk = response.getPublicKey();
+        if (pk) {
+          serialized.response.publicKey = bufferToBase64Url(pk);
+        }
+      }
+      if (typeof response.getPublicKeyAlgorithm === 'function') {
+        serialized.response.publicKeyAlgorithm = response.getPublicKeyAlgorithm();
+      }
+      return serialized;
+    }
+
+    async function checkPasskeySupport() {
+      if (!window.PublicKeyCredential) {
+        return false;
+      }
+      if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+        try {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          if (capabilities) {
+            if (capabilities.passkeyPlatformAuthenticator !== undefined) {
+              return Boolean(capabilities.passkeyPlatformAuthenticator);
+            }
+            if (capabilities.userVerifyingPlatformAuthenticator !== undefined) {
+              return Boolean(capabilities.userVerifyingPlatformAuthenticator);
+            }
+          }
+        } catch (err) {
+          console.error('Error checking client capabilities:', err);
+        }
+      }
+      if (typeof PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
+        try {
+          return await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+        } catch (err) {
+          console.error('Error checking platform authenticator availability:', err);
+        }
+      }
+      return false;
+    }
+
+    async function initPasskeyRegistration() {
+      const promoSection = document.getElementById('passkey-promo');
+      const registerButton = document.querySelector('[data-testid="register-button"]');
+      const statusMessage = document.getElementById('passkey-status');
+
+      const isSupported = await checkPasskeySupport();
+      if (isSupported && promoSection) {
+        promoSection.hidden = false;
+      }
+
+      if (!registerButton) return;
+
+      registerButton.addEventListener('click', async () => {
+        registerButton.disabled = true;
+        if (statusMessage) {
+          statusMessage.hidden = true;
+          statusMessage.className = 'status-message';
+          statusMessage.textContent = '';
+        }
+
+        try {
+          const optionsRes = await fetch('/api/register/options', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            credentials: 'same-origin',
+            body: JSON.stringify({ promotion: true }),
+          });
+
+          if (!optionsRes.ok) {
+            throw new Error(`Failed to fetch registration options (${optionsRes.status})`);
+          }
+
+          const optionsJSON = await optionsRes.json();
+          const publicKeyOptions = parseCreationOptions(optionsJSON);
+
+          const credential = await navigator.credentials.create({
+            publicKey: publicKeyOptions,
+          });
+
+          if (!credential) {
+            throw new Error('Passkey creation returned no credential.');
+          }
+
+          const verifyRes = await fetch('/api/register/verify', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            credentials: 'same-origin',
+            body: JSON.stringify(serializeCredential(credential)),
+          });
+
+          if (!verifyRes.ok) {
+            throw new Error(`Failed to verify passkey registration (${verifyRes.status})`);
+          }
+
+          if (statusMessage) {
+            statusMessage.textContent = 'Passkey created and verified successfully!';
+            statusMessage.classList.add('success');
+            statusMessage.hidden = false;
+          }
+        } catch (error) {
+          if (error.name === 'InvalidStateError') {
+            if (statusMessage) {
+              statusMessage.textContent = 'A passkey is already registered for this device.';
+              statusMessage.classList.add('error');
+              statusMessage.hidden = false;
+            }
+          } else if (error.name === 'NotAllowedError') {
+            if (statusMessage) {
+              statusMessage.textContent = 'Passkey creation was cancelled or not allowed.';
+              statusMessage.classList.add('error');
+              statusMessage.hidden = false;
+            }
+          } else {
+            console.error('Passkey registration failed:', error);
+            if (statusMessage) {
+              statusMessage.textContent = 'An error occurred while creating your passkey. Please try again.';
+              statusMessage.classList.add('error');
+              statusMessage.hidden = false;
+            }
+          }
+        } finally {
+          registerButton.disabled = false;
+        }
+      });
+    }
+
+    initPasskeyRegistration();
+  </script>
 </body>
 
