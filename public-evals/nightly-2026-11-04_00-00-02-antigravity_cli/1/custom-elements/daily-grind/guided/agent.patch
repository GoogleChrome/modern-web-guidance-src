+  <script type="module">
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      :host {
+        --_card-bg: var(--card-bg, white);
+        --_card-primary: var(--primary, #4e342e);
+        --_card-accent: var(--accent, #ffab40);
+        --_card-text: var(--text, #3e2723);
+        display: block;
+        container-type: inline-size;
+      }
+
+      :host([disabled]) {
+        opacity: 0.6;
+        pointer-events: none;
+      }
+
+      .card {
+        background: var(--_card-bg);
+        color: var(--_card-text);
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+        display: flex;
+        flex-direction: column;
+        justify-content: space-between;
+        height: 100%;
+        position: relative;
+        border: 2px solid transparent;
+        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
+      }
+
+      :host([featured]) .card,
+      :host([seasonal]) .card {
+        border-color: var(--_card-accent);
+      }
+
+      :host(:state(selected)) .card {
+        box-shadow: 0 4px 12px rgba(78, 52, 46, 0.25);
+      }
+
+      .badge {
+        align-self: center;
+        background: var(--_card-accent);
+        color: var(--_card-text);
+        font-size: 0.75rem;
+        font-weight: 700;
+        text-transform: uppercase;
+        letter-spacing: 0.5px;
+        padding: 2px 10px;
+        border-radius: 999px;
+        margin-bottom: 8px;
+      }
+
+      .badge[hidden] {
+        display: none;
+      }
+
+      h3 {
+        margin: 0 0 10px;
+        color: var(--_card-primary);
+      }
+
+      .description {
+        margin: 0 0 12px;
+      }
+
+      ::slotted(p) {
+        margin: 0;
+      }
+
+      .meta {
+        display: flex;
+        justify-content: center;
+        align-items: center;
+        gap: 12px;
+        font-size: 0.9rem;
+        margin-top: auto;
+        padding-top: 8px;
+      }
+
+      .meta[hidden] {
+        display: none;
+      }
+
+      .price {
+        font-weight: 700;
+        color: var(--_card-primary);
+      }
+
+      .calories {
+        opacity: 0.8;
+        font-size: 0.85rem;
+      }
+
+      .actions {
+        margin-top: 15px;
+      }
+
+      .btn {
+        display: inline-block;
+        background: var(--_card-primary);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        font: inherit;
+        transition: background 0.3s;
+      }
+
+      .btn:hover {
+        background: #3e2723;
+      }
+
+      .btn[aria-disabled="true"] {
+        background: #9e9e9e;
+        pointer-events: none;
+      }
+    `);
+
+    const template = document.createElement('template');
+    template.innerHTML = `
+      <article class="card" part="card">
+        <div>
+          <span class="badge" part="badge" hidden></span>
+          <h3 part="title"></h3>
+          <div class="description" part="description">
+            <slot></slot>
+          </div>
+        </div>
+        <div>
+          <div class="meta" part="meta" hidden>
+            <span class="price" part="price" hidden></span>
+            <span class="calories" part="calories" hidden></span>
+          </div>
+          <div class="actions">
+            <a class="btn" part="cta" href="/menu">View Details</a>
+          </div>
+        </div>
+      </article>
+    `;
+
+    class CoffeeCard extends HTMLElement {
+      static observedAttributes = [
+        'name',
+        'description',
+        'href',
+        'cta-label',
+        'price',
+        'calories',
+        'rating',
+        'seasonal',
+        'featured',
+        'disabled'
+      ];
+
+      #internals;
+      #isConnected = false;
+      #slotEl;
+      #badgeEl;
+      #titleEl;
+      #descriptionEl;
+      #metaEl;
+      #priceEl;
+      #caloriesEl;
+      #ctaEl;
+
+      #onSlotChange = () => {
+        this.#syncDescription();
+      };
+
+      #onCtaClick = (e) => {
+        if (this.disabled) {
+          e.preventDefault();
+          return;
+        }
+        this.#internals?.states?.add('selected');
+        this.dispatchEvent(
+          new CustomEvent('coffee-select', {
+            bubbles: true,
+            composed: true,
+            detail: {
+              name: this.name,
+              href: this.href,
+              price: this.price,
+              calories: this.calories,
+              seasonal: this.seasonal,
+              featured: this.featured
+            }
+          })
+        );
+      };
+
+      constructor() {
+        super();
+        if (typeof this.attachInternals === 'function') {
+          this.#internals = this.attachInternals();
+        }
+        const shadow = this.attachShadow({ mode: 'open' });
+        shadow.adoptedStyleSheets = [sheet];
+        shadow.append(template.content.cloneNode(true));
+
+        this.#slotEl = shadow.querySelector('slot');
+        this.#badgeEl = shadow.querySelector('.badge');
+        this.#titleEl = shadow.querySelector('h3');
+        this.#descriptionEl = shadow.querySelector('.description');
+        this.#metaEl = shadow.querySelector('.meta');
+        this.#priceEl = shadow.querySelector('.price');
+        this.#caloriesEl = shadow.querySelector('.calories');
+        this.#ctaEl = shadow.querySelector('.btn');
+      }
+
+      // String attributes reflected via getter/setter
+      get name() {
+        return this.getAttribute('name') ?? '';
+      }
+      set name(v) {
+        v ? this.setAttribute('name', String(v)) : this.removeAttribute('name');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+      set description(v) {
+        v ? this.setAttribute('description', String(v)) : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '';
+      }
+      set href(v) {
+        v ? this.setAttribute('href', String(v)) : this.removeAttribute('href');
+      }
+
+      get ctaLabel() {
+        return this.getAttribute('cta-label') ?? '';
+      }
+      set ctaLabel(v) {
+        v ? this.setAttribute('cta-label', String(v)) : this.removeAttribute('cta-label');
+      }
+
+      // Numeric attributes: coerce from string on read, serialize on write
+      get price() {
+        return Number(this.getAttribute('price')) || 0;
+      }
+      set price(v) {
+        const num = Number(v);
+        if (v === null || v === undefined || v === '' || Number.isNaN(num)) {
+          this.removeAttribute('price');
+        } else {
+          this.setAttribute('price', String(num));
+        }
+      }
+
+      get calories() {
+        return Number(this.getAttribute('calories')) || 0;
+      }
+      set calories(v) {
+        const num = Number(v);
+        if (v === null || v === undefined || v === '' || Number.isNaN(num)) {
+          this.removeAttribute('calories');
+        } else {
+          this.setAttribute('calories', String(num));
+        }
+      }
+
+      get rating() {
+        return Number(this.getAttribute('rating')) || 0;
+      }
+      set rating(v) {
+        const num = Number(v);
+        if (v === null || v === undefined || v === '' || Number.isNaN(num)) {
+          this.removeAttribute('rating');
+        } else {
+          this.setAttribute('rating', String(num));
+        }
+      }
+
+      // Boolean attributes: present = true, absent = false. Never set to "false".
+      get seasonal() {
+        return this.hasAttribute('seasonal');
+      }
+      set seasonal(on) {
+        this.toggleAttribute('seasonal', !!on);
+      }
+
+      get featured() {
+        return this.hasAttribute('featured');
+      }
+      set featured(on) {
+        this.toggleAttribute('featured', !!on);
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+      set disabled(on) {
+        this.toggleAttribute('disabled', !!on);
+      }
+
+      connectedCallback() {
+        // Guard pre-upgrade properties set on the instance before definition
+        this.#upgradeProperty('name');
+        this.#upgradeProperty('description');
+        this.#upgradeProperty('href');
+        this.#upgradeProperty('ctaLabel');
+        this.#upgradeProperty('price');
+        this.#upgradeProperty('calories');
+        this.#upgradeProperty('rating');
+        this.#upgradeProperty('seasonal');
+        this.#upgradeProperty('featured');
+        this.#upgradeProperty('disabled');
+
+        if (!this.#isConnected) {
+          this.#slotEl.addEventListener('slotchange', this.#onSlotChange);
+          this.#ctaEl.addEventListener('click', this.#onCtaClick);
+          this.#isConnected = true;
+        }
+
+        this.render();
+      }
+
+      disconnectedCallback() {
+        if (this.#isConnected) {
+          this.#slotEl.removeEventListener('slotchange', this.#onSlotChange);
+          this.#ctaEl.removeEventListener('click', this.#onCtaClick);
+          this.#isConnected = false;
+        }
+      }
+
+      connectedMoveCallback() {
+        // Preserve state across Node.moveBefore() relocations without full teardown/re-init
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal && this.#isConnected) {
+          this.render();
+        }
+      }
+
+      #upgradeProperty(prop) {
+        if (Object.prototype.hasOwnProperty.call(this, prop)) {
+          const value = this[prop];
+          delete this[prop];
+          this[prop] = value;
+        }
+      }
+
+      #syncDescription() {
+        const assigned = this.#slotEl.assignedNodes({ flatten: true }).some(
+          (node) => node.nodeType === Node.ELEMENT_NODE || (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '')
+        );
+        if (!assigned) {
+          this.#slotEl.textContent = this.description;
+        }
+      }
+
+      render() {
+        this.#titleEl.textContent = this.name;
+        this.#syncDescription();
+
+        if (this.seasonal || this.featured) {
+          this.#badgeEl.textContent = this.seasonal ? 'Seasonal Favorite' : 'Featured';
+          this.#badgeEl.hidden = false;
+        } else {
+          this.#badgeEl.textContent = '';
+          this.#badgeEl.hidden = true;
+        }
+
+        const hasPrice = this.hasAttribute('price') && this.price > 0;
+        const hasCalories = this.hasAttribute('calories') && this.calories > 0;
+
+        if (hasPrice) {
+          this.#priceEl.textContent = `$${this.price.toFixed(2)}`;
+          this.#priceEl.hidden = false;
+        } else {
+          this.#priceEl.textContent = '';
+          this.#priceEl.hidden = true;
+        }
+
+        if (hasCalories) {
+          this.#caloriesEl.textContent = `${this.calories} cal`;
+          this.#caloriesEl.hidden = false;
+        } else {
+          this.#caloriesEl.textContent = '';
+          this.#caloriesEl.hidden = true;
+        }
+
+        this.#metaEl.hidden = !(hasPrice || hasCalories);
+
+        this.#ctaEl.setAttribute('href', this.href || '/menu');
+        this.#ctaEl.textContent = this.ctaLabel || (this.disabled ? 'Sold Out' : 'View Details');
+
+        if (this.disabled) {
+          this.#ctaEl.setAttribute('aria-disabled', 'true');
+          this.#ctaEl.setAttribute('tabindex', '-1');
+        } else {
+          this.#ctaEl.removeAttribute('aria-disabled');
+          this.#ctaEl.removeAttribute('tabindex');
+        }
+      }
+    }
+
+    if (!customElements.get('coffee-card')) {
+      customElements.define('coffee-card', CoffeeCard);
+    }
+  </script>
 </body>
 
 </html>
