+++ b/coffee-card.js
@@ -0,0 +1,736 @@
+/**
+ * <coffee-card> Autonomous Custom Element
+ *
+ * Implements full custom element lifecycle management and two-way
+ * attribute/property reflection for string, numeric, and boolean attributes.
+ */
+
+const COFFEE_CARD_STRING_ATTRIBUTES = {
+  name: 'name',
+  title: 'title',
+  description: 'description',
+  href: 'href',
+  'cta-text': 'ctaText',
+  roast: 'roast',
+  origin: 'origin',
+  image: 'image',
+  badge: 'badge',
+};
+
+const COFFEE_CARD_NUMERIC_ATTRIBUTES = {
+  price: 'price',
+  calories: 'calories',
+  caffeine: 'caffeine',
+  rating: 'rating',
+  intensity: 'intensity',
+};
+
+const COFFEE_CARD_BOOLEAN_ATTRIBUTES = {
+  featured: 'featured',
+  seasonal: 'seasonal',
+  iced: 'iced',
+  'sold-out': 'soldOut',
+  disabled: 'disabled',
+  organic: 'organic',
+  decaf: 'decaf',
+};
+
+const COFFEE_CARD_TEMPLATE = document.createElement('template');
+COFFEE_CARD_TEMPLATE.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      color: var(--text, #3e2723);
+      line-height: 1.6;
+    }
+
+    :host([hidden]) {
+      display: none !important;
+    }
+
+    .card {
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      overflow: hidden;
+      display: flex;
+      flex-direction: column;
+      height: 100%;
+      border: 2px solid transparent;
+      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
+      position: relative;
+    }
+
+    :host([featured]) .card {
+      border-color: var(--accent, #ffab40);
+      box-shadow: 0 4px 12px rgba(255, 171, 64, 0.25);
+    }
+
+    :host([sold-out]) .card,
+    :host([disabled]) .card {
+      opacity: 0.72;
+      filter: grayscale(0.25);
+    }
+
+    .media {
+      position: relative;
+      width: 100%;
+      height: 180px;
+      background-color: var(--secondary, #d7ccc8);
+      overflow: hidden;
+    }
+
+    .media[hidden] {
+      display: none;
+    }
+
+    .media img {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      display: block;
+      transition: transform 0.3s ease;
+    }
+
+    .card:hover .media img {
+      transform: scale(1.04);
+    }
+
+    .badges {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 6px;
+      justify-content: center;
+      padding: 12px 16px 0;
+    }
+
+    .badges:empty {
+      display: none;
+    }
+
+    .badge {
+      display: inline-block;
+      font-size: 0.72rem;
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      padding: 2px 8px;
+      border-radius: 999px;
+      background: var(--secondary, #d7ccc8);
+      color: var(--primary, #4e342e);
+    }
+
+    .badge--featured {
+      background: var(--accent, #ffab40);
+      color: var(--text, #3e2723);
+    }
+
+    .badge--seasonal {
+      background: #ffe0b2;
+      color: #e65100;
+    }
+
+    .badge--iced {
+      background: #e1f5fe;
+      color: #0277bd;
+    }
+
+    .badge--organic {
+      background: #e8f5e9;
+      color: #2e7d32;
+    }
+
+    .badge--decaf {
+      background: #f3e5f5;
+      color: #6a1b9a;
+    }
+
+    .badge--sold-out {
+      background: #ffebee;
+      color: #c62828;
+    }
+
+    .content {
+      padding: 20px;
+      display: flex;
+      flex-direction: column;
+      flex: 1;
+      justify-content: space-between;
+    }
+
+    .header-row {
+      display: flex;
+      justify-content: center;
+      align-items: baseline;
+      gap: 10px;
+      flex-wrap: wrap;
+      margin-bottom: 8px;
+    }
+
+    h3 {
+      margin: 0;
+      color: var(--primary, #4e342e);
+      font-size: 1.25rem;
+    }
+
+    .price {
+      font-weight: 700;
+      color: var(--primary, #4e342e);
+      font-size: 1.05rem;
+    }
+
+    .price[hidden] {
+      display: none;
+    }
+
+    .description {
+      margin: 0 0 12px;
+      color: var(--text, #3e2723);
+      font-size: 0.95rem;
+    }
+
+    .meta {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      gap: 8px;
+      margin-bottom: 12px;
+      font-size: 0.8rem;
+      color: #5d4037;
+    }
+
+    .meta:empty {
+      display: none;
+    }
+
+    .meta-item {
+      background: #f5f5f5;
+      padding: 2px 8px;
+      border-radius: 4px;
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+      cursor: pointer;
+      align-self: center;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    .btn[aria-disabled="true"] {
+      background: #9e9e9e;
+      cursor: not-allowed;
+      pointer-events: none;
+    }
+  </style>
+  <article class="card" part="card">
+    <div class="media" part="media" hidden>
+      <img part="image" src="" alt="" loading="lazy" />
+    </div>
+    <div class="badges" part="badges"></div>
+    <div class="content" part="content">
+      <div>
+        <div class="header-row">
+          <h3 part="title"></h3>
+          <span class="price" part="price" hidden></span>
+        </div>
+        <p class="description" part="description"></p>
+        <div class="meta" part="meta"></div>
+        <slot></slot>
+      </div>
+      <a class="btn" part="button" href="#">View Details</a>
+    </div>
+  </article>
+`;
+
+class CoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return [
+      ...Object.keys(COFFEE_CARD_STRING_ATTRIBUTES),
+      ...Object.keys(COFFEE_CARD_NUMERIC_ATTRIBUTES),
+      ...Object.keys(COFFEE_CARD_BOOLEAN_ATTRIBUTES),
+    ];
+  }
+
+  constructor() {
+    super();
+    this._isConnected = false;
+    this._handleCtaClick = this._handleCtaClick.bind(this);
+
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(COFFEE_CARD_TEMPLATE.content.cloneNode(true));
+
+    this._elements = {
+      card: this.shadowRoot.querySelector('.card'),
+      media: this.shadowRoot.querySelector('.media'),
+      image: this.shadowRoot.querySelector('.media img'),
+      badges: this.shadowRoot.querySelector('.badges'),
+      title: this.shadowRoot.querySelector('h3'),
+      price: this.shadowRoot.querySelector('.price'),
+      description: this.shadowRoot.querySelector('.description'),
+      meta: this.shadowRoot.querySelector('.meta'),
+      button: this.shadowRoot.querySelector('.btn'),
+    };
+  }
+
+  connectedCallback() {
+    this._isConnected = true;
+    this._upgradeAllProperties();
+
+    if (!this.hasAttribute('role')) {
+      this.setAttribute('role', 'article');
+    }
+
+    this._elements.button.addEventListener('click', this._handleCtaClick);
+    this.render();
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-card:connected', {
+        bubbles: true,
+        composed: true,
+      })
+    );
+  }
+
+  disconnectedCallback() {
+    this._isConnected = false;
+    this._elements.button.removeEventListener('click', this._handleCtaClick);
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-card:disconnected', {
+        bubbles: true,
+        composed: true,
+      })
+    );
+  }
+
+  adoptedCallback(oldDocument, newDocument) {
+    this.render();
+    this.dispatchEvent(
+      new CustomEvent('coffee-card:adopted', {
+        bubbles: true,
+        composed: true,
+        detail: { oldDocument, newDocument },
+      })
+    );
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) {
+      return;
+    }
+
+    this.render();
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-card:attribute-changed', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          attribute: name,
+          oldValue,
+          newValue,
+        },
+      })
+    );
+  }
+
+  _upgradeAllProperties() {
+    const props = new Set([
+      ...Object.keys(COFFEE_CARD_STRING_ATTRIBUTES),
+      ...Object.values(COFFEE_CARD_STRING_ATTRIBUTES),
+      ...Object.keys(COFFEE_CARD_NUMERIC_ATTRIBUTES),
+      ...Object.values(COFFEE_CARD_NUMERIC_ATTRIBUTES),
+      ...Object.keys(COFFEE_CARD_BOOLEAN_ATTRIBUTES),
+      ...Object.values(COFFEE_CARD_BOOLEAN_ATTRIBUTES),
+    ]);
+
+    for (const prop of props) {
+      if (Object.prototype.hasOwnProperty.call(this, prop)) {
+        const value = this[prop];
+        delete this[prop];
+        this[prop] = value;
+      }
+    }
+  }
+
+  _handleCtaClick(event) {
+    if (this.soldOut || this.disabled) {
+      event.preventDefault();
+      event.stopPropagation();
+      return;
+    }
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-card:select', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          name: this.name || this.title,
+          price: this.price,
+          href: this.href,
+          featured: this.featured,
+          seasonal: this.seasonal,
+          iced: this.iced,
+        },
+      })
+    );
+  }
+
+  // --- String Properties ---
+
+  get name() {
+    return this.getAttribute('name') ?? '';
+  }
+
+  set name(value) {
+    this._reflectStringAttribute('name', value);
+  }
+
+  get title() {
+    return this.getAttribute('title') ?? '';
+  }
+
+  set title(value) {
+    this._reflectStringAttribute('title', value);
+  }
+
+  get description() {
+    return this.getAttribute('description') ?? '';
+  }
+
+  set description(value) {
+    this._reflectStringAttribute('description', value);
+  }
+
+  get href() {
+    return this.getAttribute('href') ?? '';
+  }
+
+  set href(value) {
+    this._reflectStringAttribute('href', value);
+  }
+
+  get ctaText() {
+    return this.getAttribute('cta-text') ?? '';
+  }
+
+  set ctaText(value) {
+    this._reflectStringAttribute('cta-text', value);
+  }
+
+  get roast() {
+    return this.getAttribute('roast') ?? '';
+  }
+
+  set roast(value) {
+    this._reflectStringAttribute('roast', value);
+  }
+
+  get origin() {
+    return this.getAttribute('origin') ?? '';
+  }
+
+  set origin(value) {
+    this._reflectStringAttribute('origin', value);
+  }
+
+  get image() {
+    return this.getAttribute('image') ?? '';
+  }
+
+  set image(value) {
+    this._reflectStringAttribute('image', value);
+  }
+
+  get badge() {
+    return this.getAttribute('badge') ?? '';
+  }
+
+  set badge(value) {
+    this._reflectStringAttribute('badge', value);
+  }
+
+  // --- Numeric Properties ---
+
+  get price() {
+    return this._readNumericAttribute('price');
+  }
+
+  set price(value) {
+    this._reflectNumericAttribute('price', value);
+  }
+
+  get calories() {
+    return this._readNumericAttribute('calories');
+  }
+
+  set calories(value) {
+    this._reflectNumericAttribute('calories', value);
+  }
+
+  get caffeine() {
+    return this._readNumericAttribute('caffeine');
+  }
+
+  set caffeine(value) {
+    this._reflectNumericAttribute('caffeine', value);
+  }
+
+  get rating() {
+    return this._readNumericAttribute('rating');
+  }
+
+  set rating(value) {
+    this._reflectNumericAttribute('rating', value);
+  }
+
+  get intensity() {
+    return this._readNumericAttribute('intensity');
+  }
+
+  set intensity(value) {
+    this._reflectNumericAttribute('intensity', value);
+  }
+
+  // --- Boolean Properties ---
+
+  get featured() {
+    return this.hasAttribute('featured');
+  }
+
+  set featured(value) {
+    this._reflectBooleanAttribute('featured', value);
+  }
+
+  get seasonal() {
+    return this.hasAttribute('seasonal');
+  }
+
+  set seasonal(value) {
+    this._reflectBooleanAttribute('seasonal', value);
+  }
+
+  get iced() {
+    return this.hasAttribute('iced');
+  }
+
+  set iced(value) {
+    this._reflectBooleanAttribute('iced', value);
+  }
+
+  get soldOut() {
+    return this.hasAttribute('sold-out');
+  }
+
+  set soldOut(value) {
+    this._reflectBooleanAttribute('sold-out', value);
+  }
+
+  get disabled() {
+    return this.hasAttribute('disabled');
+  }
+
+  set disabled(value) {
+    this._reflectBooleanAttribute('disabled', value);
+  }
+
+  get organic() {
+    return this.hasAttribute('organic');
+  }
+
+  set organic(value) {
+    this._reflectBooleanAttribute('organic', value);
+  }
+
+  get decaf() {
+    return this.hasAttribute('decaf');
+  }
+
+  set decaf(value) {
+    this._reflectBooleanAttribute('decaf', value);
+  }
+
+  // --- Reflection Helpers ---
+
+  _reflectStringAttribute(attrName, value) {
+    if (value === null || value === undefined) {
+      this.removeAttribute(attrName);
+    } else {
+      this.setAttribute(attrName, String(value));
+    }
+  }
+
+  _readNumericAttribute(attrName) {
+    if (!this.hasAttribute(attrName)) {
+      return 0;
+    }
+    const raw = this.getAttribute(attrName);
+    if (raw === null || raw.trim() === '') {
+      return 0;
+    }
+    const num = Number(raw);
+    return Number.isFinite(num) ? num : 0;
+  }
+
+  _reflectNumericAttribute(attrName, value) {
+    if (value === null || value === undefined || value === '') {
+      this.removeAttribute(attrName);
+      return;
+    }
+    const num = Number(value);
+    if (!Number.isFinite(num)) {
+      this.removeAttribute(attrName);
+      return;
+    }
+    this.setAttribute(attrName, String(num));
+  }
+
+  _reflectBooleanAttribute(attrName, value) {
+    if (Boolean(value)) {
+      if (!this.hasAttribute(attrName)) {
+        this.setAttribute(attrName, '');
+      }
+    } else {
+      if (this.hasAttribute(attrName)) {
+        this.removeAttribute(attrName);
+      }
+    }
+  }
+
+  render() {
+    if (!this._elements) {
+      return;
+    }
+
+    const displayName = this.name || this.title || '';
+    this._elements.title.textContent = displayName;
+    this._elements.description.textContent = this.description;
+
+    // Image rendering
+    const imageUrl = this.image;
+    if (imageUrl) {
+      this._elements.media.hidden = false;
+      this._elements.image.src = imageUrl;
+      this._elements.image.alt = displayName || 'Coffee beverage';
+    } else {
+      this._elements.media.hidden = true;
+      this._elements.image.removeAttribute('src');
+      this._elements.image.alt = '';
+    }
+
+    // Price rendering
+    if (this.hasAttribute('price') && this.price > 0) {
+      this._elements.price.hidden = false;
+      this._elements.price.textContent = `$${this.price.toFixed(2)}`;
+    } else {
+      this._elements.price.hidden = true;
+      this._elements.price.textContent = '';
+    }
+
+    // Badges rendering (boolean + custom badge attributes)
+    this._elements.badges.innerHTML = '';
+    const badgesToRender = [];
+    if (this.badge) {
+      badgesToRender.push({ text: this.badge, cls: 'badge' });
+    }
+    if (this.featured) {
+      badgesToRender.push({ text: 'Featured', cls: 'badge badge--featured' });
+    }
+    if (this.seasonal) {
+      badgesToRender.push({ text: 'Seasonal', cls: 'badge badge--seasonal' });
+    }
+    if (this.iced) {
+      badgesToRender.push({ text: 'Iced', cls: 'badge badge--iced' });
+    }
+    if (this.organic) {
+      badgesToRender.push({ text: 'Organic', cls: 'badge badge--organic' });
+    }
+    if (this.decaf) {
+      badgesToRender.push({ text: 'Decaf', cls: 'badge badge--decaf' });
+    }
+    if (this.soldOut) {
+      badgesToRender.push({ text: 'Sold Out', cls: 'badge badge--sold-out' });
+    }
+
+    for (const item of badgesToRender) {
+      const span = document.createElement('span');
+      span.className = item.cls;
+      span.textContent = item.text;
+      this._elements.badges.appendChild(span);
+    }
+
+    // Meta rendering (string & numeric details)
+    this._elements.meta.innerHTML = '';
+    const metaItems = [];
+    if (this.roast) {
+      metaItems.push(`${this.roast} Roast`);
+    }
+    if (this.origin) {
+      metaItems.push(this.origin);
+    }
+    if (this.hasAttribute('calories') && this.calories >= 0) {
+      metaItems.push(`${this.calories} cal`);
+    }
+    if (this.hasAttribute('caffeine') && this.caffeine >= 0) {
+      metaItems.push(`${this.caffeine}mg caffeine`);
+    }
+    if (this.hasAttribute('rating') && this.rating > 0) {
+      metaItems.push(`★ ${this.rating}`);
+    }
+    if (this.hasAttribute('intensity') && this.intensity > 0) {
+      metaItems.push(`Intensity ${this.intensity}/5`);
+    }
+
+    for (const text of metaItems) {
+      const span = document.createElement('span');
+      span.className = 'meta-item';
+      span.textContent = text;
+      this._elements.meta.appendChild(span);
+    }
+
+    // CTA Button rendering
+    const isUnavailable = this.soldOut || this.disabled;
+    const href = this.href || '#';
+    const defaultLabel = this.soldOut ? 'Sold Out' : 'View Details';
+    this._elements.button.textContent = this.ctaText || defaultLabel;
+    this._elements.button.setAttribute('href', href);
+
+    if (isUnavailable) {
+      this._elements.button.setAttribute('aria-disabled', 'true');
+      this._elements.card.setAttribute('aria-disabled', 'true');
+    } else {
+      this._elements.button.removeAttribute('aria-disabled');
+      this._elements.card.removeAttribute('aria-disabled');
+    }
+  }
+}
+
+// Also support hyphenated property access on the prototype for hyphenated attributes
+Object.defineProperties(CoffeeCard.prototype, {
+  'cta-text': Object.getOwnPropertyDescriptor(CoffeeCard.prototype, 'ctaText'),
+  'sold-out': Object.getOwnPropertyDescriptor(CoffeeCard.prototype, 'soldOut'),
+});
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
+
+if (typeof window !== 'undefined') {
+  window.CoffeeCard = CoffeeCard;
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { CoffeeCard };
+}
