+  <script>
+    (function () {
+      const DRINKS = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          price: '$5.50',
+          description: 'Rich double-shot espresso steamed with velvety oat milk and infused with pure Grade-A Vermont maple syrup, topped with a dash of cinnamon.',
+          notes: '<strong>Tasting Notes:</strong> Warm maple, toasted oats, subtle spice | <strong>Calories:</strong> 210 kcal (Medium)',
+          defaultMilk: 'Oat Milk'
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          price: '$3.75',
+          description: 'Full-bodied single-origin beans roasted to a deep mahogany finish for a bold, smokey crema and lingering dark chocolate notes.',
+          notes: '<strong>Tasting Notes:</strong> Dark cocoa, roasted walnut, smokey finish | <strong>Calories:</strong> 15 kcal',
+          defaultMilk: 'None (Black)'
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          price: '$4.75',
+          description: 'Coarse-ground artisan coffee steeped in cold filtered water for 18 hours, delivering a naturally sweet, ultra-smooth flavor with low acidity.',
+          notes: '<strong>Tasting Notes:</strong> Smooth caramel, sweet citrus, chocolate | <strong>Calories:</strong> 10 kcal',
+          defaultMilk: 'None (Black)'
+        }
+      };
+
+      const modal = document.getElementById('drink-modal');
+      const titleEl = document.getElementById('modal-drink-title');
+      const priceEl = document.getElementById('modal-drink-price');
+      const descEl = document.getElementById('modal-drink-desc');
+      const notesEl = document.getElementById('modal-drink-notes');
+      const drinkSelect = document.getElementById('order-drink-select');
+      const sizeSelect = document.getElementById('order-size-select');
+      const milkSelect = document.getElementById('order-milk-select');
+      const quantityInput = document.getElementById('order-quantity-input');
+      const closeXBtn = document.getElementById('modal-close-x');
+      const cancelBtn = document.getElementById('modal-cancel-btn');
+      const orderForm = document.getElementById('drink-order-form');
+      const orderStatus = document.getElementById('order-status');
+
+      let lastTriggerElement = null;
+
+      function renderDrinkDetails(drinkKey) {
+        const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+        titleEl.textContent = drink.name;
+        priceEl.textContent = drink.price;
+        descEl.textContent = drink.description;
+        notesEl.innerHTML = drink.notes;
+        drinkSelect.value = drinkKey in DRINKS ? drinkKey : 'maple-oat-latte';
+        milkSelect.value = drink.defaultMilk;
+      }
+
+      function openModal(drinkKey, triggerEl) {
+        lastTriggerElement = triggerEl || document.activeElement;
+        orderStatus.classList.remove('visible');
+        orderStatus.textContent = '';
+        sizeSelect.value = 'Medium (16oz)';
+        quantityInput.value = '1';
+        renderDrinkDetails(drinkKey);
+
+        if (typeof modal.showModal === 'function') {
+          if (!modal.open) {
+            modal.showModal();
+          }
+        } else {
+          modal.setAttribute('open', '');
+        }
+
+        drinkSelect.focus();
+      }
+
+      function closeModal(returnValue) {
+        if (typeof modal.close === 'function' && modal.open) {
+          modal.close(returnValue);
+        } else {
+          modal.removeAttribute('open');
+          restoreFocus();
+        }
+      }
+
+      function restoreFocus() {
+        if (lastTriggerElement && typeof lastTriggerElement.focus === 'function') {
+          lastTriggerElement.focus();
+        }
+      }
+
+      document.querySelectorAll('[data-open-drink]').forEach((btn) => {
+        btn.addEventListener('click', (event) => {
+          event.preventDefault();
+          const drinkKey = btn.getAttribute('data-open-drink');
+          openModal(drinkKey, btn);
+        });
+      });
+
+      drinkSelect.addEventListener('change', () => {
+        renderDrinkDetails(drinkSelect.value);
+      });
+
+      closeXBtn.addEventListener('click', () => {
+        closeModal('cancel');
+      });
+
+      cancelBtn.addEventListener('click', () => {
+        closeModal('cancel');
+      });
+
+      // Fallback backdrop click dismissal for browsers without native closedby="any" support
+      modal.addEventListener('click', (event) => {
+        if (event.target === modal) {
+          closeModal('backdrop');
+        }
+      });
+
+      // Restore focus to trigger whenever the dialog closes (via Esc, close button, backdrop, or form submission)
+      modal.addEventListener('close', () => {
+        restoreFocus();
+      });
+
+      // Trap Tab focus inside the dialog for browsers that may need explicit cyclic tabbing
+      modal.addEventListener('keydown', (event) => {
+        if (event.key !== 'Tab') return;
+        const focusable = modal.querySelectorAll(
+          'button:not([disabled]), select:not([disabled]), input:not([disabled]), textarea:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])'
+        );
+        if (!focusable.length) return;
+        const first = focusable[0];
+        const last = focusable[focusable.length - 1];
+
+        if (event.shiftKey && document.activeElement === first) {
+          event.preventDefault();
+          last.focus();
+        } else if (!event.shiftKey && document.activeElement === last) {
+          event.preventDefault();
+          first.focus();
+        }
+      });
+
+      orderForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const selectedDrink = DRINKS[drinkSelect.value] || DRINKS['maple-oat-latte'];
+        const qty = quantityInput.value || '1';
+        const size = sizeSelect.value;
+        orderStatus.textContent = `Added ${qty}x ${size} ${selectedDrink.name} to your order!`;
+        orderStatus.classList.add('visible');
+        setTimeout(() => {
+          closeModal('ordered');
+        }, 700);
+      });
+    })();
+  </script>
 </body>
 
