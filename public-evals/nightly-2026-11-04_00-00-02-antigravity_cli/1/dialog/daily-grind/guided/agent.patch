+  <script type="module">
+    // Conditionally load the invokers polyfill only in browsers lacking native support
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill').catch(() => {});
+    }
+
+    const DRINKS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        price: '$5.50',
+        description: 'Velvety steamed oat milk paired with our signature double-shot espresso and pure Grade-A Vermont maple syrup, finished with a dusting of cinnamon.',
+        notes: 'Toasted Pecan, Warm Maple, Smooth Oat',
+        calories: '210 kcal',
+        defaultMilk: 'Oat Milk'
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        price: '$3.75',
+        description: 'Bold, full-bodied espresso slow-roasted in small batches for a rich crema, smokey intensity, and a lingering dark chocolate finish.',
+        notes: 'Dark Cocoa, Roasted Walnut, Smokey Finish',
+        calories: '15 kcal',
+        defaultMilk: 'None'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        price: '$4.75',
+        description: 'Coarse-ground single-origin Colombian beans steeped in cold filtered water for 18 hours, delivering a naturally sweet, ultra-smooth coffee over ice.',
+        notes: 'Caramel, Sweet Citrus, Velvety Smooth',
+        calories: '25 kcal',
+        defaultMilk: 'Oat Milk'
+      }
+    };
+
+    const dialog = document.getElementById('order-dialog');
+    const titleEl = document.getElementById('dialog-title');
+    const priceEl = document.getElementById('dialog-price');
+    const descEl = document.getElementById('dialog-description');
+    const metaEl = document.getElementById('dialog-meta');
+    const drinkSelect = document.getElementById('drink-select');
+    const milkSelect = document.getElementById('milk-select');
+    const quantityInput = document.getElementById('quantity-input');
+    const orderStatus = document.getElementById('order-status');
+
+    function populateDrinkDetails(drinkKey) {
+      const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+      drinkSelect.value = drinkKey in DRINKS ? drinkKey : 'maple-oat-latte';
+      titleEl.textContent = drink.name;
+      priceEl.textContent = drink.price;
+      descEl.textContent = drink.description;
+      metaEl.innerHTML = `<strong>Tasting Notes:</strong> ${drink.notes} &bull; <strong>Calories:</strong> ${drink.calories}`;
+      milkSelect.value = drink.defaultMilk;
+    }
+
+    drinkSelect.addEventListener('change', () => {
+      populateDrinkDetails(drinkSelect.value);
+    });
+
+    // Populate drink details and ensure showModal() opens the dialog
+    document.querySelectorAll('button[commandfor="order-dialog"][command="show-modal"]').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const drinkKey = btn.dataset.drink || 'maple-oat-latte';
+        populateDrinkDetails(drinkKey);
+        quantityInput.value = '1';
+        if (!dialog.open) {
+          dialog.showModal();
+        }
+      });
+    });
+
+    // Listen for close event, read dialog.returnValue, and reset it to '' to prevent stale values
+    dialog.addEventListener('close', () => {
+      if (dialog.returnValue === 'order') {
+        const selectedDrink = DRINKS[drinkSelect.value] || DRINKS['maple-oat-latte'];
+        const sizeEl = dialog.querySelector('input[name="size"]:checked');
+        const size = sizeEl ? sizeEl.value : 'Medium';
+        const quantity = quantityInput.value || '1';
+        orderStatus.textContent = `Added ${quantity}x ${size} ${selectedDrink.name} (${milkSelect.value}) to your order!`;
+      }
+      dialog.returnValue = '';
+    });
+
+    // Fallback for browsers without native closedby="any" support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e, dlg) => {
+        const r = dlg.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      for (const dlg of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = false;
+        dlg.addEventListener('pointerdown', (e) => {
+          pressedOutside = outside(e, dlg);
+        });
+        dlg.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e, dlg)) {
+            dlg.close();
+          }
+        });
+      }
+    }
+  </script>
+
 </body>
 
