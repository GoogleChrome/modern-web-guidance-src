+  <script>
+    (function () {
+      const lazyMediaElements = Array.from(document.querySelectorAll('.lazy-media'));
+
+      function loadDeferredMedia(mediaEl) {
+        if (!mediaEl || mediaEl.dataset.loaded === 'true') {
+          return;
+        }
+        mediaEl.dataset.loaded = 'true';
+
+        if (mediaEl.dataset.poster) {
+          mediaEl.setAttribute('poster', mediaEl.dataset.poster);
+        }
+
+        const sources = mediaEl.querySelectorAll('source[data-src]');
+        sources.forEach(function (sourceEl) {
+          if (sourceEl.dataset.src) {
+            sourceEl.setAttribute('src', sourceEl.dataset.src);
+          }
+        });
+
+        if (mediaEl.dataset.src) {
+          mediaEl.setAttribute('src', mediaEl.dataset.src);
+        }
+
+        mediaEl.setAttribute('preload', mediaEl.dataset.preload || 'metadata');
+        mediaEl.load();
+        mediaEl.classList.add('is-loaded');
+
+        const statusId = mediaEl.id + '-status';
+        const statusEl = document.getElementById(statusId);
+        if (statusEl) {
+          statusEl.textContent = 'Media ready to play.';
+        }
+      }
+
+      if ('IntersectionObserver' in window) {
+        const mediaObserver = new IntersectionObserver(
+          function (entries, observer) {
+            entries.forEach(function (entry) {
+              if (entry.isIntersecting) {
+                loadDeferredMedia(entry.target);
+                observer.unobserve(entry.target);
+              }
+            });
+          },
+          {
+            root: null,
+            rootMargin: '200px 0px',
+            threshold: 0.01
+          }
+        );
+
+        lazyMediaElements.forEach(function (mediaEl) {
+          mediaObserver.observe(mediaEl);
+        });
+      } else {
+        lazyMediaElements.forEach(loadDeferredMedia);
+      }
+
+      lazyMediaElements.forEach(function (mediaEl) {
+        ['focusin', 'mouseenter', 'touchstart', 'click'].forEach(function (eventName) {
+          mediaEl.addEventListener(
+            eventName,
+            function () {
+              loadDeferredMedia(mediaEl);
+            },
+            { once: true, passive: true }
+          );
+        });
+      });
+    })();
+  </script>
+
