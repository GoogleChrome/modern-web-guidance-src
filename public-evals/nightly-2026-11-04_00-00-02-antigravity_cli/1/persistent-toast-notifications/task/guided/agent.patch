+      display: none;
+      align-items: center;
+      gap: 0.75rem;
+      opacity: 0;
+      transform: translateY(1rem);
+      transition-property: opacity, transform, margin-bottom, display, overlay;
+      transition-duration: 0.3s;
+      transition-timing-function: ease-out;
+      transition-behavior: allow-discrete;
+    }
+
+    .toast:is(:popover-open, .\:popover-open):where(:not([data-closing])) {
+      display: flex;
+      opacity: 1;
+      transform: translateY(0);
+
+      @starting-style {
+        opacity: 0;
+        transform: translateY(1rem);
+      }
+    }
+
+    .toast-close {
+      background: transparent;
+      border: none;
+      color: var(--light);
+      font-size: 1.25rem;
+      line-height: 1;
+      cursor: pointer;
+      padding: 0.25rem;
+      border-radius: 4px;
+      transition: color 0.2s;
+    }
+
+    .toast-close:hover {
+      color: var(--accent);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transform: none;
+        transition-duration: 0.1s;
+      }
+
+      .toast:is(:popover-open, .\:popover-open):where(:not([data-closing])) {
+        transform: none;
+
+        @starting-style {
+          transform: none;
+        }
+      }
+    }
