+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const sections = [...panel.querySelectorAll('.drink-section')];
+    const tocLinks = [...document.querySelectorAll('.toc-sidebar a')];
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function updateActiveLink() {
+      const panelTop = panel.getBoundingClientRect().top + panel.clientTop;
+      const activeSection = sections.reduce((closest, section) => {
+        return Math.abs(section.getBoundingClientRect().top - panelTop) <
+          Math.abs(closest.getBoundingClientRect().top - panelTop) ? section : closest;
+      });
+
+      tocLinks.forEach(link => {
+        if (link.hash === `#${activeSection.id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    tocLinks.forEach(link => {
+      link.addEventListener('click', event => {
+        // Preserve the browser's modified-click behavior for real anchor links.
+        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const section = sections.find(section => link.hash === `#${section.id}`);
+        panel.scrollTo({
+          top: panel.scrollTop + section.getBoundingClientRect().top -
+            panel.getBoundingClientRect().top - panel.clientTop,
+          behavior: reducedMotion.matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    let scrollFrame = null;
+    panel.addEventListener('scroll', () => {
+      if (scrollFrame !== null) return;
+      scrollFrame = requestAnimationFrame(() => {
+        updateActiveLink();
+        scrollFrame = null;
+      });
+    }, { passive: true });
+    panel.addEventListener('scrollend', updateActiveLink);
+    window.addEventListener('resize', updateActiveLink);
+    updateActiveLink();
+  </script>
