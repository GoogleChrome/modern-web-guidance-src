+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+    const headings = [...panel.querySelectorAll('.drink-section h3')];
+
+    function setActive(id) {
+      links.forEach(link => {
+        if (link.hash === `#${id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function syncActive() {
+      const snapTop = panel.getBoundingClientRect().top + panel.clientTop
+        + parseFloat(getComputedStyle(panel).scrollPaddingTop);
+      const closest = headings.reduce((nearest, heading) =>
+        Math.abs(heading.getBoundingClientRect().top - snapTop)
+          < Math.abs(nearest.getBoundingClientRect().top - snapTop) ? heading : nearest
+      );
+      setActive(closest.id);
+    }
+
+    links.forEach(link => {
+      link.addEventListener('click', event => {
+        // Preserve modified clicks and native anchor behavior without JavaScript.
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const heading = document.getElementById(link.hash.slice(1));
+        const top = panel.scrollTop + heading.getBoundingClientRect().top
+          - panel.getBoundingClientRect().top - panel.clientTop
+          - parseFloat(getComputedStyle(panel).scrollPaddingTop);
+        panel.scrollTo({ top, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
+      });
+    });
+
+    if ('onscrollsnapchange' in panel) {
+      panel.addEventListener('scrollsnapchange', event => {
+        if (event.snapTargetBlock) setActive(event.snapTargetBlock.id);
+      });
+    } else {
+      const observer = new IntersectionObserver(syncActive, {
+        root: panel,
+        rootMargin: '0px 0px -80% 0px',
+        threshold: [0, 1]
+      });
+      headings.forEach(heading => observer.observe(heading));
+      // Also synchronize after settling, including browsers without scrollend.
+      let settleTimer;
+      panel.addEventListener('scroll', () => {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(syncActive, 120);
+      }, { passive: true });
+    }
+    syncActive();
+  </script>
