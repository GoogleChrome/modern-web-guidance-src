+const $ = (selector) => document.querySelector(selector);
+const host = $('demo-counter');
+// Old engines receive the exact same server template through a small fallback.
+if (!host.shadowRoot) {
+  const template = host.querySelector('template[shadowrootmode]');
+  if (template) host.attachShadow({mode:'open'}).append(template.content);
+}
+const root = host.shadowRoot;
+const serverNodes = [...root.querySelectorAll('*')];
+const initialMarkup = root.innerHTML;
+let hydrated = false;
+let pending = null;
+let toastTimer;
+let generation = 0;
+const examples = {
+  counter: {tag:'demo-counter', title:'Make every click count.', subtitle:'Already rendered. Just add a little life.', initial:0, symbol:'✳'},
+  stepper: {tag:'demo-counter', title:'A little more, or less.', subtitle:'Your next great idea starts with one.', initial:1, symbol:'◇'},
+  toggle: {tag:'demo-counter', title:'A change of state.', subtitle:'Same element. A different possibility.', initial:'Off', symbol:'⏻'}
+};
+class DemoCounter extends HTMLElement {
+  constructor() { super(); }
+  hydrate() {
+    if (this.controller) return;
+    this.controller = new AbortController();
+    const signal = this.controller.signal;
+    const output = this.shadowRoot.getElementById('value');
+    const update = (direction) => {
+      const kind = this.dataset.kind;
+      if (kind === 'toggle') output.value = output.value === 'On' ? 'Off' : 'On';
+      else output.value = String(kind === 'stepper' ? Math.max(1,Number(output.value)+direction) : Number(output.value)+direction);
+      this.dispatchEvent(new CustomEvent('value-change',{detail:{value:output.value},bubbles:true,composed:true}));
+    };
+    this.shadowRoot.getElementById('minus').addEventListener('click',()=>update(-1),{signal});
+    this.shadowRoot.getElementById('plus').addEventListener('click',()=>update(1),{signal});
+  }
+  pause() { this.controller?.abort(); this.controller = null; }
+}
+function toast(message) {
+  $('#toast').textContent = message;
+  $('#toast').classList.add('visible');
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(()=>$('#toast').classList.remove('visible'),2800);
+}
+function renderTimeline(active=false, duration=0) {
+  const entries = [ ['Server HTML received','Markup and styles ready together','0 ms'], ['Shadow DOM attached','Parsed natively by the browser','0 ms'], active ? ['Hydrated in place','Listeners attached. Every node preserved.',`${duration.toFixed(1)} ms`] : ['Waiting for hydration','Your component is already visible','—'] ];
+  $('#events').replaceChildren(...entries.map(([title,description,time],i)=>{
+    const event = document.createElement('div'); event.className = 'event'+(!active&&i===2?' pending':'');
+    const symbol = document.createElement('span'); symbol.className='event-symbol'; symbol.textContent=!active&&i===2?'○':'✓';
+    const body=document.createElement('div'); const strong=document.createElement('strong'); strong.textContent=title; const p=document.createElement('p');p.textContent=description; body.append(strong,p);
+    const stamp=document.createElement('time');stamp.textContent=time; event.append(symbol,body,stamp);return event;
+  }));
+}
+async function hydrate() {
+  if (pending || hydrated) { if(hydrated) toast('Already hydrated. Try the component or reset to run again.'); return; }
+  const run = ++generation;
+  const delay=Number($('#delay').value);
+  $('#hydrate').disabled=true;
+  $('#hydrate').innerHTML='<span class="play-icon">◷</span> '+(delay?'Waiting to hydrate…':'Hydrating…');
+  if(delay) {
+    $('#timeline-state').textContent=`Hydrating after ${delay.toLocaleString()} ms…`;
+    await new Promise(resolve=>{pending={id:setTimeout(resolve,delay),resolve};});
+    pending=null;
+  }
+  if(run!==generation) return;
+  const start=performance.now();
+  if(!customElements.get('demo-counter')) customElements.define('demo-counter',DemoCounter);
+  host.hydrate();
+  const duration=performance.now()-start;
+  const currentNodes=[...root.querySelectorAll('*')];
+  const preserved=serverNodes.filter((node,i)=>currentNodes[i]===node).length;
+  const replaced=serverNodes.length-preserved;
+  hydrated=true;
+  root.getElementById('card-status').textContent='Hydrated. Go ahead, give it a click.';
+  $('#render-status').classList.add('hydrated');
+  $('#render-status').innerHTML='<span></span>Hydrated in place';
+  $('#hydrate').disabled=false;
+  $('#hydrate').innerHTML='<span class="play-icon">✓</span> Component hydrated<span class="key-hint">↵</span>';
+  $('#dom-stat').innerHTML=`${Math.round(preserved/serverNodes.length*100)}<span>%</span>`;
+  $('#shift-stat').textContent=String(replaced);
+  $('#time-stat').innerHTML=`${duration.toFixed(1)}<span> ms</span>`;
+  renderTimeline(true,duration);
+  $('#timeline-state').textContent='Interactive. No nodes replaced.';
+  toast('Hydrated in place. Your original DOM is intact.');
+}
+function reset(notify=true) {
+  generation++;
+  if(pending){clearTimeout(pending.id);pending.resolve();pending=null;}
+  host.pause?.(); hydrated=false;
+  const kind=$('#component').value;
+  root.getElementById('value').value=String(examples[kind].initial);
+  root.getElementById('card-status').textContent='Rendered on the server';
+  $('#render-status').classList.remove('hydrated');
+  $('#render-status').innerHTML='<span></span>Server rendered';
+  $('#hydrate').disabled=false;
+  $('#hydrate').innerHTML='<span class="play-icon">▷</span> Hydrate component<span class="key-hint">↵</span>';
+  $('#time-stat').innerHTML='—<span> ms</span>';
+  $('#dom-stat').innerHTML='100<span>%</span>';$('#shift-stat').textContent='0';
+  renderTimeline();$('#timeline-state').textContent='Ready when you are.';
+  if(notify) toast('Playground reset. The original DOM is still here.');
+}
+const serverCode = `<demo-counter>\n  <template shadowrootmode="open">\n    <style>/* Component styles, shipped with HTML */</style>\n    <div class="counter">\n      <button id="minus" aria-label="Decrease count">−</button>\n      <output id="value">0</output>\n      <button id="plus" aria-label="Increase count">+</button>\n    </div>\n  </template>\n</demo-counter>`;
+const clientCode = `class DemoCounter extends HTMLElement {\n  constructor() {\n    super();\n    // Reuse the shadow tree. Never replace its HTML.\n    const root = this.shadowRoot;\n    const output = root.getElementById('value');\n    root.getElementById('plus').addEventListener('click', () => {\n      output.value = String(Number(output.value) + 1);\n    });\n  }\n}\ncustomElements.define('demo-counter', DemoCounter);`;
+let selectedCode='html';
+function showCode(which) {
+  selectedCode=which;
+  const code=which==='html'?serverCode:clientCode;
+  const escape=(s)=>s.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');
+  $('#code-view').innerHTML=code.split('\n').map((line,i)=>{
+    let content=escape(line);
+    if(which==='html') content=content.replace(/(&lt;\/?)([\w-]+)/g,'$1<span class="syntax-tag">$2</span>').replace(/([\w-]+)=(&quot;|"|')([^"']*)("|')/g,'<span class="syntax-attr">$1</span>=<span class="syntax-string">"$3"</span>');
+    else if(line.trim().startsWith('//')) content=`<span class="syntax-comment">${content}</span>`;
+    return `<span class="code-line"><span class="line-num">${i+1}</span>${content}</span>`;
+  }).join('');
+  for(const type of ['html','js']){const tab=$(`#${type}-tab`);tab.classList.toggle('selected',which===type);tab.setAttribute('aria-selected',String(which===type));tab.tabIndex=which===type?0:-1;}
+  $('#code-view').setAttribute('aria-labelledby',`${which}-tab`);
+  $('#language-label').textContent=which==='html'?'HTML':'JavaScript';
+}
+$('#hydrate').addEventListener('click',hydrate);
+$('#reset').addEventListener('click',()=>reset());
+$('#delay').addEventListener('input',()=>$('#delay-display').textContent=Number($('#delay').value).toLocaleString()+' ms');
+$('#component').addEventListener('change',()=>{
+  reset(false);
+  const kind=$('#component').value;const example=examples[kind];host.dataset.kind=kind;
+  root.querySelector('h3').textContent=example.title;root.querySelector('p').textContent=example.subtitle;root.querySelector('.symbol').textContent=example.symbol;
+  root.getElementById('value').value=String(example.initial);
+  root.getElementById('minus').textContent=kind==='toggle'?'⏻':'−';root.getElementById('plus').textContent=kind==='toggle'?'↔':'+';
+  root.getElementById('minus').setAttribute('aria-label',kind==='toggle'?'Toggle status':'Decrease count');root.getElementById('plus').setAttribute('aria-label',kind==='toggle'?'Toggle status':'Increase count');
+  if($('#auto-hydrate').checked) hydrate();
+});
+try{$('#auto-hydrate').checked=localStorage.getItem('hydrate-auto')==='true';}catch{}
+$('#auto-hydrate').addEventListener('change',()=>{try{localStorage.setItem('hydrate-auto',String($('#auto-hydrate').checked));}catch{}if($('#auto-hydrate').checked)hydrate();else toast('Automatic hydration is off for your next visit.');});
+$('#html-tab').addEventListener('click',()=>showCode('html'));$('#js-tab').addEventListener('click',()=>showCode('js'));
+$('.code-tabs').addEventListener('keydown',event=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(event.key)){event.preventDefault();showCode(selectedCode==='html'?'js':'html');$(`#${selectedCode}-tab`).focus();}});
+$('#copy-code').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(selectedCode==='html'?serverCode:clientCode);toast('Code copied to your clipboard.');}catch{toast('Clipboard unavailable. Select and copy the code below.');$('#code-view').focus();}});
+$('#export').addEventListener('click',()=>{
+  const script = `class DemoCounter extends HTMLElement {constructor(){super();const root=this.shadowRoot;if(!root)return;const output=root.getElementById('value');root.getElementById('minus').addEventListener('click',()=>output.value=Number(output.value)-1);root.getElementById('plus').addEventListener('click',()=>output.value=Number(output.value)+1);}}customElements.define('demo-counter',DemoCounter);`;
+  const html=`<!doctype html>\n<html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hydrate — Counter example</title><style>body{min-height:100vh;display:grid;place-items:center;margin:0;background:#f6f8f1}</style><demo-counter><template shadowrootmode="open">${initialMarkup}</template></demo-counter><script type="module">${script}</script></html>`;
+  const url=URL.createObjectURL(new Blob([html],{type:'text/html'}));const a=document.createElement('a');a.href=url;a.download='hydrate-counter.html';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);toast('Standalone counter example exported.');
+});
+const dialog=$('#docs-dialog');document.querySelectorAll('.docs-trigger').forEach(button=>button.addEventListener('click',()=>dialog.showModal()));$('#how-nav').addEventListener('click',()=>dialog.showModal());$('.dialog-close').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',event=>{if(event.target===dialog){const rect=dialog.getBoundingClientRect();if(event.clientX<rect.left||event.clientX>rect.right||event.clientY<rect.top||event.clientY>rect.bottom)dialog.close();}});
+$('#components-nav').addEventListener('click',()=>{$('#component').focus();$('#component').showPicker?.();});
+$('#snippets-nav').addEventListener('click',()=>{showCode('js');$('#source-panel').scrollIntoView({behavior:'smooth',block:'center'});});
+$('#playground-nav').addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));
+document.addEventListener('keydown',event=>{if((event.metaKey||event.ctrlKey)&&event.key==='k'){event.preventDefault();$('#component').focus();}if(event.key==='Enter'&&event.target===document.body&&!dialog.open)hydrate();});
+showCode('html');
+if($('#auto-hydrate').checked) hydrate();
