+++ b/app.js
@@ -0,0 +1,112 @@
+const card = document.querySelector('profile-card');
+const originalNodes = [...card.querySelectorAll('*')];
+let enabled = true;
+let selectedFile = 'server';
+const sources = {
+  server: `<!-- Rendered on the server. Ready before JavaScript. -->\n<profile-card>\n  <div class="cover"></div>\n  <div class="profile-content">\n    <h2>Alex Morgan</h2>\n    <button class="follow-btn" aria-pressed="false">＋ Follow</button>\n  </div>\n</profile-card>`,
+  client: `class ProfileCard extends HTMLElement {\n  connectedCallback() {\n    // Attach behavior to the existing server-rendered DOM.\n    this.querySelector('button').addEventListener('click', () => {\n      this.toggleFollow();\n    });\n  }\n}\ncustomElements.define('profile-card', ProfileCard);`
+};
+const escapeHTML = value => value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
+function showSource() {
+  document.querySelector('#source').innerHTML = sources[selectedFile].split('\n').map((line, i) => {
+    let html = escapeHTML(line);
+    if (line.trim().startsWith('<!--') || line.trim().startsWith('//')) html = `<span class="comment">${html}</span>`;
+    else html = html.replace(/(&lt;\/?)([\w-]+)/g, '$1<span class="purple">$2</span>').replace(/("[^"]*")/g, '<span class="green">$1</span>');
+    return `<span class="line">${i + 1}</span>${html}`;
+  }).join('\n');
+}
+function showDOM() {
+  const output = `<profile-card${card.hasAttribute('data-hydrated') ? ' data-hydrated="true"' : ''}>\n  <div class="cover">…</div>\n  <div class="profile-content">\n    <img class="profile-avatar" …>\n    <h2>Alex Morgan</h2>\n    <p>Product designer & creative thinker</p>\n    <div class="profile-bottom">\n      <strong>${card.querySelector('[data-followers]').textContent}</strong>\n      <button aria-pressed="${card.querySelector('button').getAttribute('aria-pressed')}">\n        ${card.querySelector('button').textContent}\n      </button>\n    </div>\n  </div>\n</profile-card>`;
+  document.querySelector('#dom').textContent = output;
+  document.querySelector('#dom').style.whiteSpace = 'pre-wrap';
+}
+function notify(message) {
+  document.querySelector('.toast')?.remove();
+  const toast = document.createElement('div');
+  toast.className = 'toast'; toast.role = 'status'; toast.textContent = message;
+  document.body.append(toast); setTimeout(() => toast.remove(), 3200);
+}
+class ProfileCard extends HTMLElement {
+  connectedCallback() { this.hydrate(); }
+  hydrate() {
+    this.controller?.abort();
+    this.controller = new AbortController();
+    this.querySelector('button').addEventListener('click', () => {
+      if (!enabled) { notify('Enable client JavaScript to interact with this card.'); return; }
+      const button = this.querySelector('button');
+      const following = button.getAttribute('aria-pressed') !== 'true';
+      button.setAttribute('aria-pressed', String(following));
+      button.textContent = following ? '✓ Following' : '＋ Follow';
+      this.querySelector('[data-followers]').textContent = following ? '1,249' : '1,248';
+      showDOM();
+    }, { signal: this.controller.signal });
+    this.dataset.hydrated = 'true';
+  }
+  disconnectedCallback() { this.controller?.abort(); }
+}
+const start = performance.now();
+customElements.define('profile-card', ProfileCard);
+function updateState() {
+  document.querySelector('#js-switch').setAttribute('aria-checked', String(enabled));
+  document.querySelector('#state-pill').textContent = enabled ? 'Hydrated' : 'Server-rendered';
+  document.querySelector('#preview-state').textContent = enabled ? 'Live' : 'Static';
+  document.querySelector('#status-title').textContent = enabled ? 'Server-rendered. Client-ready.' : 'HTML first. Beautiful on its own.';
+  document.querySelector('#status-text').textContent = enabled ? 'Your component is styled, visible, and ready to hydrate. No extra rendering needed.' : 'Client behavior is paused. The original server-rendered content and styles stay visible.';
+  document.querySelector('#status-badge').textContent = enabled ? 'SSR → Hydrated' : 'SSR only';
+  document.querySelectorAll('#timeline li').forEach((item, i) => { item.style.opacity = !enabled && i > 1 ? '.3' : '1'; });
+  document.querySelector('#preserved').textContent = originalNodes.every(node => card.contains(node)) ? 'Yes' : 'No';
+  showDOM();
+}
+function runHydration() {
+  enabled = true;
+  const begin = performance.now();
+  card.hydrate();
+  document.querySelector('#hydrated-time').textContent = `${Math.max(.1, performance.now() - begin).toFixed(1)} ms`;
+  updateState();
+  notify('Hydrated in place. Every original DOM node is preserved.');
+}
+document.querySelector('#defined-time').textContent = `${(performance.now() - start).toFixed(1)} ms`;
+document.querySelector('#hydrated-time').textContent = `${(performance.now() - start).toFixed(1)} ms`;
+document.querySelector('#hydrate').addEventListener('click', runHydration);
+document.querySelector('#js-switch').addEventListener('click', () => {
+  enabled = !enabled;
+  if (enabled) card.hydrate(); else card.removeAttribute('data-hydrated');
+  updateState();
+});
+document.querySelector('#reset').addEventListener('click', () => {
+  card.querySelector('button').textContent = '＋ Follow';
+  card.querySelector('button').setAttribute('aria-pressed', 'false');
+  card.querySelector('[data-followers]').textContent = '1,248';
+  enabled = true; card.hydrate(); updateState(); notify('Playground reset. Original markup preserved.');
+});
+document.querySelectorAll('[data-preview]').forEach(button => button.addEventListener('click', () => {
+  document.querySelectorAll('[data-preview]').forEach(tab => tab.classList.toggle('active', tab === button));
+  document.querySelector('#preview').classList.toggle('hidden', button.dataset.preview !== 'preview');
+  document.querySelector('#dom').classList.toggle('hidden', button.dataset.preview !== 'dom');
+  showDOM();
+}));
+document.querySelectorAll('[data-file]').forEach(button => button.addEventListener('click', () => {
+  selectedFile = button.dataset.file;
+  document.querySelectorAll('[data-file]').forEach(tab => tab.classList.toggle('active', tab === button));
+  showSource();
+}));
+document.querySelector('#copy-code').addEventListener('click', async () => {
+  try { await navigator.clipboard.writeText(sources[selectedFile]); notify('Code copied to clipboard.'); }
+  catch { notify('Clipboard unavailable. Select the source code to copy it.'); }
+});
+document.querySelectorAll('[data-action]').forEach(button => button.addEventListener('click', () => {
+  const action = button.dataset.action;
+  if (action === 'console') {
+    selectedFile = 'client'; document.querySelector('[data-file="client"]').click();
+    document.querySelector('.source-panel').scrollIntoView({ behavior: 'smooth', block: 'center' });
+    notify(`profile-card: ${enabled ? 'hydrated' : 'server-rendered'} · DOM preserved: ${originalNodes.every(node => card.contains(node))}`);
+  } else if (action === 'lifecycle') {
+    document.querySelector('#timeline').scrollIntoView({ behavior: 'smooth', block: 'center' });
+    notify('Lifecycle: HTML received → Styles applied → Element defined → Hydrated');
+  } else {
+    document.querySelector('[data-preview="preview"]').click();
+    document.querySelector('#preview').scrollIntoView({ behavior: 'smooth', block: 'center' });
+    notify('profile-card · 1 server-rendered custom element');
+  }
+}));
+showSource(); updateState();
