+  <script>
+    const slides = [...document.querySelectorAll('#seasonal-slides .card')];
+    const position = document.querySelector('#seasonal-position');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let currentIndex = 0;
+    let activeTransition;
+
+    function changeSlide(step) {
+      activeTransition?.skipTransition();
+
+      const update = () => {
+        slides[currentIndex].hidden = true;
+        currentIndex = (currentIndex + step + slides.length) % slides.length;
+        slides[currentIndex].hidden = false;
+        position.textContent = `${currentIndex + 1} of ${slides.length}`;
+      };
+
+      if (reducedMotion.matches || !document.startViewTransition ||
+          !CSS.supports('selector(:active-view-transition-type(forward))')) {
+        update();
+        return;
+      }
+
+      activeTransition = document.startViewTransition({
+        update,
+        types: [step > 0 ? 'forward' : 'backward']
+      });
+    }
+
+    document.querySelector('#seasonal-previous').addEventListener('click', () => changeSlide(-1));
+    document.querySelector('#seasonal-next').addEventListener('click', () => changeSlide(1));
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) activeTransition?.skipTransition();
+    });
+  </script>
 </body>
 
