+  <script>
+    const carousel = document.querySelector('.seasonal-carousel');
+    const items = Array.from(carousel.querySelectorAll('.card'));
+    const position = document.getElementById('seasonal-position');
+    let currentIndex = 0;
+
+    function showItem(direction) {
+      const outgoing = items[currentIndex];
+      outgoing.hidden = true;
+      outgoing.classList.remove('enter-next', 'enter-previous');
+      currentIndex = (currentIndex + direction + items.length) % items.length;
+      const incoming = items[currentIndex];
+      incoming.hidden = false;
+      // Restart the entrance animation even when navigating rapidly.
+      void incoming.offsetWidth;
+      incoming.classList.add(direction > 0 ? 'enter-next' : 'enter-previous');
+      position.textContent = `${currentIndex + 1} of ${items.length}`;
+    }
+
+    document.getElementById('seasonal-next').addEventListener('click', () => showItem(1));
+    document.getElementById('seasonal-previous').addEventListener('click', () => showItem(-1));
+    carousel.querySelector('.carousel-controls').hidden = false;
+  </script>
+
