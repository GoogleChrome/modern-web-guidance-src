diff --git a/src/components/TopStoriesSlider.astro b/src/components/TopStoriesSlider.astro
new file mode 100644
index 0000000..9c80c63
--- /dev/null
+++ b/src/components/TopStoriesSlider.astro
@@ -0,0 +1,94 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+<top-stories-slider class="block bg-white border-b border-gray-300" role="region" aria-label="Top Stories" aria-roledescription="carousel">
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
+            <div class="min-w-0 flex-1 overflow-hidden" aria-live="polite" aria-atomic="true">
+                {articles.map((article, index) => (
+                    <div data-story hidden={index !== 0} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${articles.length}`}>
+                        <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                            <h3 class="font-bold text-gray-900 hover:text-amber-400">{article.data.title}</h3>
+                        </a>
+                        <time class="text-xs text-gray-500" datetime={article.data.date.toISOString()}>{article.data.date.toLocaleDateString()}</time>
+                    </div>
+                ))}
+            </div>
+            <div data-controls hidden class="flex shrink-0 items-center gap-2">
+                <button type="button" data-direction="-1" aria-label="Previous story" class="border border-gray-300 rounded px-3 py-2 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:opacity-50">Previous</button>
+                <button type="button" data-direction="1" aria-label="Next story" class="border border-gray-300 rounded px-3 py-2 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:opacity-50">Next</button>
+            </div>
+        </div>
+    </div>
+</top-stories-slider>
+
+<style>
+    [data-controls][hidden] {
+        display: none;
+    }
+</style>
+
+<script>
+    class TopStoriesSlider extends HTMLElement {
+        private cleanup?: () => void;
+
+        connectedCallback() {
+            const stories = Array.from(this.querySelectorAll<HTMLElement>('[data-story]'));
+            const controls = this.querySelector<HTMLElement>('[data-controls]');
+            const buttons = this.querySelectorAll<HTMLButtonElement>('button[data-direction]');
+            if (!controls || stories.length === 0) return;
+
+            let currentIndex = 0;
+            let animation: Animation | undefined;
+            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+            const stopAnimation = () => animation?.cancel();
+
+            const navigate = (event: Event) => {
+                const button = (event.target as Element).closest<HTMLButtonElement>('button[data-direction]');
+                if (!button) return;
+
+                const direction = Number(button.dataset.direction);
+                stopAnimation();
+                stories[currentIndex].hidden = true;
+                currentIndex = (currentIndex + direction + stories.length) % stories.length;
+                const story = stories[currentIndex];
+                story.hidden = false;
+
+                if (!reducedMotion.matches) {
+                    animation = story.animate(
+                        [
+                            { transform: `translateX(${direction * 100}%)` },
+                            { transform: 'translateX(0)' },
+                        ],
+                        { duration: 300, easing: 'ease-out' },
+                    );
+                }
+            };
+
+            controls.hidden = false;
+            buttons.forEach(button => { button.disabled = stories.length < 2; });
+            controls.addEventListener('click', navigate);
+            reducedMotion.addEventListener('change', stopAnimation);
+            this.cleanup = () => {
+                stopAnimation();
+                controls.removeEventListener('click', navigate);
+                reducedMotion.removeEventListener('change', stopAnimation);
+            };
+        }
+
+        disconnectedCallback() {
+            this.cleanup?.();
+        }
+    }
+
+    if (!customElements.get('top-stories-slider')) {
+        customElements.define('top-stories-slider', TopStoriesSlider);
+    }
+</script>
