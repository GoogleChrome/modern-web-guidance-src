+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+    const headingLines = heroHeading.querySelectorAll('.heading-line');
+
+    // Measure each line at a common size, then fit by changing font size only.
+    function fitHeroHeading() {
+      const availableWidth = heroHeading.getBoundingClientRect().width;
+      if (!availableWidth) return;
+
+      headingLines.forEach((line) => {
+        line.style.fontSize = '100px';
+        const naturalWidth = line.getBoundingClientRect().width;
+        if (naturalWidth) {
+          line.style.fontSize = `${100 * availableWidth / naturalWidth}px`;
+        }
+      });
+    }
+
+    fitHeroHeading();
+    document.fonts.ready.then(fitHeroHeading);
+    let lastHeadingWidth = heroHeading.getBoundingClientRect().width;
+    new ResizeObserver(([entry]) => {
+      const width = entry.contentRect.width;
+      if (width !== lastHeadingWidth) {
+        lastHeadingWidth = width;
+        fitHeroHeading();
+      }
+    }).observe(heroHeading);
+  </script>
