+const icons = {
+  cup: `<svg class="brand-icon" viewBox="0 0 48 50" fill="none" aria-hidden="true"><path d="M8 20h27v11a12 12 0 0 1-12 12h-3A12 12 0 0 1 8 31V20Z" stroke="currentColor" stroke-width="2"/><path d="M35 22h4a6 6 0 0 1 0 12h-4M5 46h34M16 15c-5-5 5-6 0-11m8 11c-5-5 5-6 0-11m8 11c-5-5 5-6 0-11" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>`,
+  user: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2" stroke="currentColor" stroke-width="1.5"/></svg>`
+};
+const products = {
+  maple: {name:'Maple Oat Latte',price:5.50,image:'assets/iced-latte.jpg',alt:'Creamy iced oat latte with ice in a tall glass',badge:'A LITTLE SEASONAL MAGIC',seasonal:true,description:'Velvety oat milk. A touch of real maple. All the cozy feels.',notes:'SMOOTH · SWEET · COZY',ingredients:'Our house espresso, creamy oat milk, and pure maple syrup. Served over ice or steamed to perfection.'},
+  espresso: {name:'Dark Roast Espresso',price:3.50,image:'assets/espresso.jpg',alt:'Rich dark espresso in a ceramic cup',badge:'THE EVERYDAY ESSENTIAL',description:'Rich, bold, and beautifully balanced. Your morning, made.',notes:'BOLD · RICH · CLASSIC',ingredients:'A double shot of our small-batch dark roast, with notes of dark chocolate and toasted nuts. A little cup with a lot of character.'},
+  coldbrew: {name:'Slow-Steeped Cold Brew',price:4.75,image:'assets/cold-brew.jpg',alt:'Cold brew coffee served over ice in a glass',badge:'COOL, CALM & CAFFEINATED',description:'Steeped for 18 hours. Smooth to the last sip. Worth the wait.',notes:'SMOOTH · MELLOW · REFRESHING',ingredients:'Our signature blend, slowly steeped in cool water for 18 hours. Naturally sweet, low in acidity, and poured fresh over ice.'}
+};
+const money = value => `$${value.toFixed(2)}`;
+const brand = `<a href="#" class="brand" aria-label="The Daily Grind home">${icons.cup}<span class="brand-name">the daily grind<small>COFFEE & GOOD COMPANY</small></span></a>`;
+class GrindButton extends HTMLElement {
+  connectedCallback(){const button=document.createElement('button');button.className=`button ${this.getAttribute('variant')||''}`;button.innerHTML=this.innerHTML;button.type='button';if(this.hasAttribute('action'))button.dataset.action=this.getAttribute('action');this.replaceChildren(button);}
+}
+class SiteHeader extends HTMLElement {
+  connectedCallback(){this.innerHTML=`<header class="header-inner page-width">${brand}<nav class="nav-links" aria-label="Main navigation" id="main-nav"><a href="#menu">Our menu</a><button data-action="locations">Locations</button><button data-action="rewards">Rewards</button></nav><div class="account-actions"><button class="account-button" data-action="account">${icons.user} My account</button><grind-button action="order">Order online <span>↗</span></grind-button><button class="mobile-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="main-nav">☰</button></div></header>`;this.querySelector('.mobile-toggle').addEventListener('click',e=>{const open=this.querySelector('nav').classList.toggle('open');e.currentTarget.setAttribute('aria-expanded',String(open));});this.querySelector('nav').addEventListener('click',()=>{this.querySelector('nav').classList.remove('open');this.querySelector('.mobile-toggle').setAttribute('aria-expanded','false');});}
+}
+class CoffeeCard extends HTMLElement {
+  connectedCallback(){const key=this.getAttribute('product'),p=products[key];if(!p)return;this.innerHTML=`<article class="product-card"><div class="product-photo"><img src="${p.image}" alt="${p.alt}" loading="lazy"><span class="product-badge ${p.seasonal?'seasonal':''}">${p.badge}</span></div><div class="product-info"><div class="product-title-row"><h3>${p.name}</h3><span>${money(p.price)}</span></div><p>${p.description}</p><div class="product-bottom"><span>${p.notes}</span><button data-product="${key}" aria-label="View details for ${p.name}">Meet your cup <span>↗</span></button></div></div></article>`;}
+}
+class SiteFooter extends HTMLElement {
+  connectedCallback(){this.innerHTML=`<footer class="footer-inner page-width">${brand}<div class="footer-links"><a href="#our-story">Our story</a><button data-action="careers">Join the team</button><button data-action="contact">Say hello</button><button data-action="privacy">Privacy</button></div><span class="copyright">© 2026 The Daily Grind. Made with a whole lot of love.</span></footer>`;}
+}
+customElements.define('grind-button',GrindButton);
+customElements.define('site-header',SiteHeader);
+customElements.define('coffee-card',CoffeeCard);
+customElements.define('site-footer',SiteFooter);
+const dialog=document.getElementById('app-dialog');
+const content=document.getElementById('dialog-content');
+const basket=[];
+function openDialog(html){content.innerHTML=html;if(!dialog.open)dialog.showModal();}
+function closeDialog(){dialog.close();}
+document.querySelector('.dialog-close').addEventListener('click',closeDialog);
+dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)closeDialog();}});
+let toastTimer;
+function toast(message){const el=document.querySelector('.toast');el.textContent=message;el.classList.add('visible');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('visible'),4000);}
+function productDialog(key){const p=products[key];openDialog(`<img class="dialog-product-image" src="${p.image}" alt="${p.alt}"><div class="eyebrow">${p.badge}</div><h2 id="dialog-title">${p.name}</h2><p>${p.ingredients}</p><label for="drink-style">Make it your way</label><select id="drink-style">${key==='maple'?'<option>Iced</option><option>Hot</option>':key==='espresso'?'<option>Double shot</option><option>Over ice</option>':'<option>Classic black</option><option>With oat milk</option><option>With whole milk</option>'}</select><button class="button" id="add-drink">Add to order · ${money(p.price)} <span>+</span></button>`);document.getElementById('add-drink').onclick=()=>{basket.push({key,style:document.getElementById('drink-style').value});closeDialog();toast(`${p.name} added to your order`);};}
+function orderDialog(){const total=basket.reduce((sum,item)=>sum+products[item.key].price,0);openDialog(`<div class="eyebrow">A LITTLE JOY, READY TO GO</div><h2 id="dialog-title">${basket.length?'Your daily pick-me-up.':'What’s your usual?'}</h2><p>Build your cup lineup. All drinks are prepared fresh.</p>${Object.entries(products).map(([key,p])=>`<div class="order-row"><img src="${p.image}" alt=""><div><h3>${p.name}</h3><small>${money(p.price)}${basket.filter(i=>i.key===key).length?` · ${basket.filter(i=>i.key===key).length} in your order`:''}</small></div><button class="add-small" data-product="${key}" aria-label="Add ${p.name}">+</button></div>`).join('')}${basket.length?`<div class="order-total"><span>${basket.length} drink${basket.length===1?'':'s'}</span><span>${money(total)}</span></div><p>This is a preview order. Online checkout is coming soon.</p><button class="button" id="clear-order">Clear order</button>`:'<p>Choose a drink to customize your cup.</p>'}`);const clear=document.getElementById('clear-order');if(clear)clear.onclick=()=>{basket.length=0;orderDialog();};}
+const actions={
+  order:orderDialog,
+  'full-menu':orderDialog,
+  locations:()=>openDialog(`<div class="eyebrow">MAKE YOURSELF AT HOME</div><h2 id="dialog-title">Your neighborhood spot.</h2><p>Good coffee is even better in good company. Our café locations and opening hours are coming soon.</p><div class="location-box"><h3>Until then, say hello.</h3><p>Have a neighborhood in mind? Email us at <a href="mailto:hello@dailygrind.coffee">hello@dailygrind.coffee</a>.</p></div>`),
+  rewards:()=>{openDialog(`<div class="eyebrow">GOOD COFFEE. GREAT PERKS.</div><h2 id="dialog-title">Your daily ritual,<br>with a little extra.</h2><p>Get the first word on Grind Rewards, seasonal sips, and your first free drink when the program launches.</p><form id="rewards-form"><label for="rewards-email">Your email address</label><input id="rewards-email" type="email" placeholder="you@example.com" autocomplete="email" required><button class="button" type="submit">Join the interest list <span>↗</span></button><p>Your email stays in this browser for this preview.</p></form>`);document.getElementById('rewards-form').onsubmit=e=>{e.preventDefault();const email=document.getElementById('rewards-email').value;try{localStorage.setItem('grind-rewards-email',email);}catch{}openDialog(`<div class="eyebrow">HERE’S TO BETTER DAYS</div><h2 id="dialog-title">You’re on the list.</h2><p>Your interest has been saved on this device. We can’t wait to share what’s brewing.</p><button class="button" data-action="order">Find your favorite <span>↗</span></button>`);};},
+  account:()=>openDialog(`<div class="eyebrow">YOUR LITTLE COFFEE CORNER</div><h2 id="dialog-title">Hello, coffee lover.</h2><p>We’re brewing up accounts so you can save your favorites, collect rewards, and make your morning a little easier.</p><button class="button" data-action="rewards">Get to know Grind Rewards <span>↗</span></button>`),
+  careers:()=>openDialog(`<div class="eyebrow">GOOD PEOPLE. GREAT COFFEE.</div><h2 id="dialog-title">Come brew with us.</h2><p>Love making someone’s day? We’d love to meet you. Share a little about yourself and the kind of role you’re looking for.</p><a class="button" href="mailto:careers@dailygrind.coffee">Say hello to our team <span>↗</span></a>`),
+  contact:()=>openDialog(`<div class="eyebrow">OUR INBOX IS ALWAYS OPEN</div><h2 id="dialog-title">Let’s talk coffee.</h2><p>A question, a little feedback, or just a hello? Drop us a note at <a href="mailto:hello@dailygrind.coffee">hello@dailygrind.coffee</a>.</p><a class="button" href="mailto:hello@dailygrind.coffee">Send a little hello <span>↗</span></a>`),
+  privacy:()=>openDialog(`<h2 id="dialog-title">A little about privacy.</h2><p>This preview doesn’t send your personal information to a server. If you join the rewards interest list, your email is saved only in this browser’s local storage. Order selections are kept for this visit only.</p><p>Fonts are provided by Google Fonts. Product photography is from Unsplash and hosted with this site.</p>`)
+};
+document.addEventListener('click',e=>{const product=e.target.closest('[data-product]');if(product){productDialog(product.dataset.product);return;}const action=e.target.closest('[data-action]');if(action&&actions[action.dataset.action])actions[action.dataset.action]();});
