@@ -0,0 +1,18 @@
+/** A shared native dialog with keyboard dismissal, focus trapping, and backdrop dismissal. */
+export function createModal(dialog, content) {
+  dialog.querySelector('[data-close-modal]').addEventListener('click', () => dialog.close());
+  dialog.addEventListener('click', event => {
+    if (event.target !== dialog) return;
+    const rect = dialog.getBoundingClientRect();
+    if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
+  });
+  return {
+    show(markup) {
+      // Only pass trusted application templates; insert user-provided strings with textContent.
+      content.innerHTML = markup;
+      if (!dialog.open) dialog.showModal();
+      else content.querySelector('input,button,select')?.focus();
+    },
+    close() { dialog.close(); }
+  };
+}
