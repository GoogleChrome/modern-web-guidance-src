+/** Reusable, data-driven product card. Set `product` to render any menu item. */
+export class CoffeeCard extends HTMLElement {
+  set product(product) {
+    this._product = product;
+    this.render();
+  }
+  get product() { return this._product; }
+  render() {
+    const p = this._product;
+    if (!p) return;
+    // Product data is controlled by the application; user input never enters this template.
+    this.innerHTML = `<article class="product-card">
+      <div class="product-photo"><img src="${p.image}" alt="${p.alt}" width="700" height="430" loading="lazy"><span class="badge">${p.badge}</span></div>
+      <div class="product-info"><div class="product-title-row"><h3>${p.name}</h3><span class="price">$${p.price.toFixed(2)}</span></div>
+      <p class="product-description">${p.description}</p>
+      <div class="product-bottom"><span class="product-notes">${p.notes}</span><button type="button" aria-label="View ${p.name} details">View details <span aria-hidden="true">↗</span></button></div></div>
+    </article>`;
+    this.querySelector('button').addEventListener('click', () => {
+      this.dispatchEvent(new CustomEvent('product-select', { detail: p, bubbles: true }));
+    });
+  }
+}
+customElements.define('coffee-card', CoffeeCard);
