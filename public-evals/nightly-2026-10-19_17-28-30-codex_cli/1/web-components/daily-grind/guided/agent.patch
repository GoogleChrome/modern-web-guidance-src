+for (const product of products) {
+  const card = document.createElement('coffee-card');
+  card.product = product;
+  document.querySelector('#favorites').append(card);
+}
+document.addEventListener('product-select', event => showProduct(event.detail));
+document.querySelectorAll('[data-open]').forEach(button => button.addEventListener('click', () => openSection(button.dataset.open)));
+updateAccount();
