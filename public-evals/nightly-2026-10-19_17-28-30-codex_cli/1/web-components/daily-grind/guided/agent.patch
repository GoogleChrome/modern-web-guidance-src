+import './components/coffee-card.js';
+import { createModal } from './components/modal.js';
+
+const photo = (id, width = 800) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=${width}&q=85`;
+export const products = [
+  { id: 'maple', name: 'Maple Oat Latte', price: 5.50, description: 'A little maple sweetness. A whole lot of comfort.', notes: 'Cozy · Creamy · Gently sweet', badge: 'THE SEASON’S SWEETHEART', category: 'Hot coffee', image: photo('photo-1461023058943-07fcbe16d735'), alt: 'Creamy iced oat milk latte in a glass', details: 'Our signature espresso meets velvety oat milk and pure maple syrup. Finished with a touch of cinnamon. A cozy favorite, hot or over ice.' },
+  { id: 'espresso', name: 'Dark Roast Espresso', price: 3.25, description: 'Bold by nature. Smooth to the very last sip.', notes: 'Rich · Chocolatey · Full-bodied', badge: 'THE EVERYDAY CLASSIC', category: 'Hot coffee', image: photo('photo-1510707577719-ae7c14805e3a'), alt: 'Rich espresso in a ceramic cup on a café table', details: 'A carefully pulled double shot of our small-batch house espresso. Expect dark chocolate notes, a full body, and a beautifully smooth finish.' },
+  { id: 'coldbrew', name: 'Slow-Steeped Cold Brew', price: 4.75, description: '18 hours of patience. Pure, smooth refreshment.', notes: 'Smooth · Refreshing · Low acidity', badge: 'COOL, CALM & CAFFEINATED', category: 'Cold coffee', image: photo('photo-1517701604599-bb29b565090c'), alt: 'Cold brew coffee served over ice in a tall glass', details: 'Slow-steeped in cool water for 18 hours for a naturally sweet, low-acidity brew. Served over ice. Add your favorite milk to make it yours.' }
+];
+
+const dialog = document.querySelector('#app-dialog');
+const content = document.querySelector('#dialog-content');
+const { show } = createModal(dialog, content);
+const cart = [];
+let account = null;
+try { account = JSON.parse(localStorage.getItem('daily-grind-account')); } catch { /* Storage can be unavailable in private contexts. */ }
+const money = n => `$${n.toFixed(2)}`;
+let toastTimer;
+function toast(message) {
+  const el = document.querySelector('#toast');
+  clearTimeout(toastTimer);
+  el.textContent = message;
+  el.classList.add('visible');
+  toastTimer = setTimeout(() => el.classList.remove('visible'), 3500);
+}
+function title(text) { return `<h2 id="dialog-title">${text}</h2>`; }
+function updateAccount() { document.querySelector('#account-label').textContent = account ? 'My account' : 'Sign in'; }
+function updateCart() {
+  const el = document.querySelector('#cart-count');
+  el.hidden = cart.length === 0;
+  el.textContent = `(${cart.length})`;
+}
+function showProduct(p) {
+  show(`${title(p.name)}<img class="detail-image" src="${p.image}" alt="${p.alt}"><p>${p.details}</p>
+    <form class="dialog-form" id="product-form"><label>Make it yours<select name="milk"><option>As crafted</option><option>Oat milk</option><option>Whole milk</option><option>Almond milk</option><option>No milk</option></select></label>
+    <label>Serve it<select name="temperature"><option>${p.category === 'Cold coffee' ? 'Iced' : 'Hot'}</option>${p.category !== 'Cold coffee' ? '<option>Iced</option>' : ''}</select></label>
+    <button class="button" type="submit">Add to your order <span>${money(p.price)}</span></button></form>`);
+  document.querySelector('#product-form').addEventListener('submit', event => {
+    event.preventDefault();
+    const data = new FormData(event.currentTarget);
+    cart.push({ ...p, milk: data.get('milk'), temperature: data.get('temperature') });
+    updateCart();
+    showCart();
+    toast(`${p.name} added to your order`);
+  });
+}
+function showMenu(category = 'All coffee') {
+  const visible = products.filter(p => category === 'All coffee' || p.category === category);
+  show(`${title('Find your next favorite.')}<p>Thoughtfully crafted, one cup at a time.</p>
+    <div class="dialog-tabs" aria-label="Filter menu">${['All coffee', 'Hot coffee', 'Cold coffee'].map(c => `<button aria-pressed="${c === category}" data-category="${c}">${c}</button>`).join('')}</div>
+    ${visible.map(p => `<div class="menu-item"><img src="${p.image}" alt="${p.alt}"><div><h3>${p.name}</h3><p>${p.notes}</p></div><button class="button" data-product="${p.id}">${money(p.price)} <span aria-hidden="true">+</span></button></div>`).join('')}
+    ${cart.length ? '<button class="text-button" data-cart>View your order →</button>' : ''}`);
+  content.querySelectorAll('[data-category]').forEach(button => button.addEventListener('click', () => showMenu(button.dataset.category)));
+  content.querySelectorAll('[data-product]').forEach(button => button.addEventListener('click', () => showProduct(products.find(p => p.id === button.dataset.product))));
+  content.querySelector('[data-cart]')?.addEventListener('click', showCart);
+}
+function showCart() {
+  if (!cart.length) { showMenu(); return; }
+  show(`${title('A little cup of happiness.')}<p>Your order, made just for you.</p>
+    ${cart.map((p, i) => `<div class="cart-item"><strong>${p.name}<br><small>${p.temperature} · ${p.milk}</small></strong><span>${money(p.price)}</span><button data-remove="${i}" aria-label="Remove ${p.name}">Remove</button></div>`).join('')}
+    <div class="cart-summary"><span>Subtotal</span><span>${money(cart.reduce((sum, p) => sum + p.price, 0))}</span></div>
+    <p class="helper">This is a sample order. Online checkout is coming soon; no payment is collected.</p><div class="cart-actions"><button class="button button-outline" data-more>Add another cup</button><button class="button" data-location>See pickup location ↗</button></div>`);
+  content.querySelectorAll('[data-remove]').forEach(button => button.addEventListener('click', () => { cart.splice(Number(button.dataset.remove), 1); updateCart(); showCart(); }));
+  content.querySelector('[data-more]').addEventListener('click', () => showMenu());
+  content.querySelector('[data-location]').addEventListener('click', () => openSection('locations'));
+}
+function accountForm(rewards = false) {
+  if (account) {
+    show(`${title(rewards ? 'You’re in good company.' : 'Your little coffee corner.')}<p id="welcome-email"></p><div class="info-box"><h3>${rewards ? 'A fresh start.' : 'Make yourself at home.'}</h3><p>Your profile is saved on this device. Rewards tracking and online checkout are coming soon.</p></div><button class="button button-outline" id="sign-out">Sign out</button>`);
+    content.querySelector('#welcome-email').textContent = `Welcome, ${account.name}. ${account.email}`;
+    content.querySelector('#sign-out').addEventListener('click', () => {
+      account = null;
+      try { localStorage.removeItem('daily-grind-account'); } catch { /* Optional local persistence. */ }
+      updateAccount(); dialog.close(); toast('You’ve been signed out. See you soon!');
+    });
+    return;
+  }
+  show(`${title(rewards ? 'Good coffee has its perks.' : 'Welcome to the good company.')}<p>${rewards ? 'Create a local profile and be ready for our upcoming rewards program.' : 'Save your coffee profile on this device for your next visit.'}</p>
+    <form id="account-form" class="dialog-form"><label>Your name<input name="name" autocomplete="given-name" required maxlength="60" placeholder="First name"></label><label>Email address<input name="email" type="email" autocomplete="email" required placeholder="you@example.com"></label><button class="button" type="submit">${rewards ? 'Join the good company' : 'Save my profile'} <span aria-hidden="true">↗</span></button></form><p class="helper">A local demo profile — no password required. Your information stays in this browser.</p>`);
+  content.querySelector('#account-form').addEventListener('submit', event => {
+    event.preventDefault();
+    const data = new FormData(event.currentTarget);
+    const name = data.get('name').trim();
+    if (!name) { event.currentTarget.elements.name.setCustomValidity('Please enter your name.'); event.currentTarget.elements.name.reportValidity(); return; }
+    account = { name, email: data.get('email').trim() };
+    try { localStorage.setItem('daily-grind-account', JSON.stringify(account)); } catch { /* Profile still works for this session. */ }
+    updateAccount(); accountForm(rewards); toast('Your coffee profile is ready.');
+  });
+  content.querySelector('[name="name"]').addEventListener('input', event => event.target.setCustomValidity(''));
+}
+function openSection(section) {
+  if (section === 'menu') return showMenu();
+  if (section === 'order') return cart.length ? showCart() : showMenu();
+  if (section === 'account' || section === 'rewards') return accountForm(section === 'rewards');
+  if (section === 'locations') {
+    show(`${title('Your new favorite corner.')}<p>Good coffee tastes even better in good company.</p><div class="info-box"><h3>The neighborhood café</h3><p>Our first location is brewing. Address and opening hours will be announced here soon.</p></div><p>Until then, explore the menu and find the cup you’ll try first.</p><button class="button" id="location-menu">Explore our menu ↗</button>`);
+    content.querySelector('#location-menu').addEventListener('click', () => showMenu());
+    return;
+  }
+  if (section === 'story') return show(`${title('A little ritual. A better day.')}<p>The Daily Grind started with a simple idea: great coffee should feel like coming home.</p><p>We choose thoughtfully sourced beans, roast in small batches, and take our time with every cup. From a quiet morning espresso to an afternoon catch-up, we’re here for the moments that make your day.</p><div class="info-box"><h3>Good coffee. Better company.</h3><p>That’s our kind of everyday.</p></div>`);
+  if (section === 'contact') return show(`${title('Let’s talk over coffee.')}<p>Questions about our beans, your next favorite drink, or the café? We’d love to hear from you.</p><div class="info-box"><h3>Come say hello</h3><p>Our contact channels will be announced alongside our first café opening. In the meantime, take a look around and make yourself at home.</p></div>`);
+}
