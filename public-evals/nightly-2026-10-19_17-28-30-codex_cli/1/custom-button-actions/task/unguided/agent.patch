+  <script>
+    const actionTarget = document.getElementById('action-target');
+    const commandClasses = new Map([
+      ['--spin', 'is-spun'],
+      ['--grow', 'is-grown'],
+      ['--round', 'is-rounded'],
+    ]);
+
+    actionTarget.addEventListener('command', (event) => {
+      if (event.command === '--reset') {
+        actionTarget.classList.remove(...commandClasses.values());
+      } else if (commandClasses.has(event.command)) {
+        actionTarget.classList.toggle(commandClasses.get(event.command));
+      } else {
+        return;
+      }
+
+      document.querySelectorAll('button[commandfor="action-target"][aria-pressed]').forEach((button) => {
+        button.setAttribute('aria-pressed', String(actionTarget.classList.contains(commandClasses.get(button.getAttribute('command')))));
+      });
+    });
+  </script>
