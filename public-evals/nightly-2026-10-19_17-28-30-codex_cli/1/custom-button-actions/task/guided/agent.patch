+  <script>
+    const actionTarget = document.getElementById('action-target');
+    const actionClasses = new Map([
+      ['--spin', 'is-spun'],
+      ['--grow', 'is-grown'],
+      ['--round', 'is-rounded'],
+    ]);
+    const actionButtons = document.querySelectorAll('button[commandfor="action-target"]');
+
+    actionTarget.addEventListener('command', (event) => {
+      if (event.command === '--reset') {
+        actionTarget.classList.remove(...actionClasses.values());
+      } else if (actionClasses.has(event.command)) {
+        actionTarget.classList.toggle(actionClasses.get(event.command));
+      } else {
+        return;
+      }
+
+      actionButtons.forEach((button) => {
+        const className = actionClasses.get(button.getAttribute('command'));
+        if (className) {
+          button.setAttribute('aria-pressed', String(actionTarget.classList.contains(className)));
+        }
+      });
+    });
+
+    // Older browsers use the same command handler through a small fallback.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      document.querySelector('.action-controls').addEventListener('click', (event) => {
+        const button = event.target.closest('button[commandfor="action-target"]');
+        if (!button || button.disabled) return;
+        const commandEvent = new Event('command');
+        Object.defineProperties(commandEvent, {
+          command: { value: button.getAttribute('command') },
+          source: { value: button },
+        });
+        actionTarget.dispatchEvent(commandEvent);
+      });
+    }
+  </script>
+
