@@ -106,8 +106,61 @@
       gap: 20px;
       margin-top: 20px;
     }
 
+    .seasonal-promo {
+      display: grid;
+      place-items: center;
+      min-height: 180px;
+      padding: 24px 40px;
+    }
+
+    .target {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      width: 112px;
+      height: 112px;
+      border: 2px dashed var(--primary);
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      text-align: center;
+      font-size: 0.85rem;
+      font-weight: 700;
+      line-height: 1.4;
+      box-shadow: 0 4px 12px rgb(78 52 46 / 15%);
+      /* Identity transforms establish a stable stacking context before hover. */
+      translate: 0;
+      rotate: 0deg;
+      scale: 1;
+      animation: promo-spin 14s linear infinite,
+        promo-slide 3s ease-in-out infinite alternate;
+      transition: scale 0.3s ease;
+    }
+
+    .target:hover {
+      scale: 1.12;
+    }
+
+    @keyframes promo-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -22px 0; }
+      to { translate: 22px 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .target {
+        animation: none;
+        transition: none;
+      }
+    }
+
