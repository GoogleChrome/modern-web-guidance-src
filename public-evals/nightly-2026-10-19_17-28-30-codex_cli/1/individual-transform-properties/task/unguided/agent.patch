+      /* Keep a stacking context before, during, and after hover. */
+      transform: scale(1);
+      transition: transform 0.3s ease;
+      /* Individual properties keep both animations independent of hover. */
+      animation: promo-spin 12s linear infinite,
+        promo-slide 2.5s ease-in-out infinite alternate;
+    }
+
+    .target strong {
+      font-size: 0.75rem;
+      letter-spacing: 0.08em;
+      text-transform: uppercase;
+    }
+
+    .target span {
+      margin-top: 5px;
+      font-size: 1rem;
+      font-weight: 600;
+    }
+
+    .target:hover,
+    .target:focus-visible {
+      transform: scale(1.15);
+    }
+
+    .target:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 5px;
+    }
+
+    @keyframes promo-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -24px 0; }
