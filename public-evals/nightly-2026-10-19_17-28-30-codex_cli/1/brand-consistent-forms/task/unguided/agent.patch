+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-preference');
+    const progress = document.getElementById('setup-progress');
+    const status = document.getElementById('subscription-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      document.getElementById('roast-value').value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      const completed = Number(email.value.trim() !== '' && email.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked')))
+        + Number(roast.validity.valid);
+      const percent = Math.round(completed / 3 * 100);
+      progress.value = completed;
+      progress.textContent = `${percent}%`;
+      document.getElementById('progress-text').textContent = `${completed} of 3 ready · ${percent}%`;
+    }
+
+    form.addEventListener('input', () => {
+      status.textContent = '';
+      updateSetup();
+    });
+    form.addEventListener('change', updateSetup);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!form.reportValidity()) return;
+      const preferences = {
+        email: email.value.trim(),
+        frequency: form.querySelector('input[name="frequency"]:checked').value,
+        roast: Number(roast.value),
+        marketingEmails: document.getElementById('coffee-emails').checked
+      };
+      try {
+        localStorage.setItem('daily-grind-coffee-preferences', JSON.stringify(preferences));
+        status.textContent = 'Your coffee preferences are saved on this device. No subscription has been started.';
+      } catch {
+        status.textContent = 'Your browser could not save these preferences. Please allow local storage and try again.';
+      }
+    });
+
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-coffee-preferences'));
+      if (saved && typeof saved === 'object') {
+        if (typeof saved.email === 'string') email.value = saved.email;
+        const frequency = [...form.querySelectorAll('input[name="frequency"]')]
+          .find((input) => input.value === saved.frequency);
+        if (frequency) frequency.checked = true;
+        if (Number.isInteger(saved.roast) && saved.roast >= 1 && saved.roast <= 5) roast.value = saved.roast;
+        document.getElementById('coffee-emails').checked = saved.marketingEmails === true;
+      }
+    } catch {
+      // The form remains usable if storage is unavailable or contains invalid data.
+    }
+    updateSetup();
+  </script>
