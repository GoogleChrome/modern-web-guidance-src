+            </p>
+            <span className="note-line" />
+          </div>
+          <button className="nav-link help-link" onClick={() => setHelp(true)}>
+            <QuestionMarkCircleIcon />
+            Help & information
+            <ArrowUpRightIcon />
+          </button>
+          <a className="publisher" href={`${base}news`}>
+            A tool by
+            <br />
+            <strong>
+              The DevTools Times <ArrowUpRightIcon />
+            </strong>
+          </a>
+        </div>
+      </aside>
+      <div className="workspace">
+        <header className="workspace-header">
+          <div>
+            <span className="header-breadcrumb">Workspace</span>
+            <span className="breadcrumb-slash">/</span>
+            <span>
+              {view === "translate"
+                ? "Translator"
+                : view === "saved"
+                  ? "Saved translations"
+                  : "History"}
+            </span>
+          </div>
+          <div className="header-right">
+            <span className="status-dot" />
+            <a href={`${base}news`} aria-label="Read The DevTools Times">
+              The DevTools Times
+              <ArrowUpRightIcon />
+            </a>
+            <span className="avatar" title="Local workspace">
+              Y
