+    if (speaking === side) {
+      setSpeaking("");
+      return;
+    }
+    const utterance = new SpeechSynthesisUtterance(value);
+    utterance.lang = lang;
+    utterance.onend = () => setSpeaking("");
+    utterance.onerror = () => {
+      setSpeaking("");
+      setNotice("Audio playback is unavailable for this language.");
+    };
+    setSpeaking(side);
+    window.speechSynthesis.speak(utterance);
+  }
+  function toggleSaved(entry: Entry) {
+    const exists = saved.some(
+      (e) =>
+        e.text === entry.text &&
+        e.source === entry.source &&
+        e.target === entry.target,
+    );
+    const next = exists
+      ? saved.filter(
+          (e) =>
+            !(
+              e.text === entry.text &&
+              e.source === entry.source &&
+              e.target === entry.target
+            ),
+        )
+      : [entry, ...saved].slice(0, 30);
+    setSaved(next);
+    store("lingua-saved", next);
+    setNotice(
+      exists ? "Removed from saved translations." : "Translation saved.",
+    );
+  }
+  const isSaved =
+    result &&
+    saved.some(
+      (e) =>
+        e.text === result.text &&
+        e.source === result.source &&
+        e.target === result.target,
+    );
