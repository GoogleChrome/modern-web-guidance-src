+              <div className="collection-header">
+                <div className="eyebrow">YOUR WORDS, TOGETHER</div>
+                <h1>
+                  {view === "saved"
+                    ? "Words worth keeping."
+                    : "A little look back."}
+                </h1>
+                <p>
+                  {view === "saved"
+                    ? "Your saved translations, ready when you need them."
+                    : "Your last 30 translations, stored on this device."}
+                </p>
+              </div>
+              {currentEntries.length > 0 ? (
+                <>
+                  <div className="collection-toolbar">
+                    <span>{currentEntries.length} translations</span>
+                    <button
+                      onClick={() => {
+                        if (view === "saved") {
+                          setSaved([]);
+                          store("lingua-saved", []);
+                        } else {
+                          setHistory([]);
+                          store("lingua-history", []);
+                        }
+                      }}
+                    >
+                      <TrashIcon />
+                      Clear {view === "saved" ? "saved" : "history"}
+                    </button>
+                  </div>
+                  <div className="entry-list">
+                    {currentEntries.map((entry) => (
+                      <article className="entry-card" key={entry.id}>
+                        <div className="entry-meta">
+                          {languageName(entry.source)}
+                          <ArrowRightIcon />
+                          {languageName(entry.target)}
+                          <span>
+                            {new Date(entry.date).toLocaleDateString()}
+                          </span>
+                        </div>
+                        <div className="entry-texts">
+                          <p dir="auto">{entry.text}</p>
+                          <p dir="auto">{entry.translation}</p>
+                        </div>
+                        <div className="entry-actions">
+                          <button onClick={() => load(entry)}>
+                            Open translation
+                            <ArrowUpRightIcon />
+                          </button>
+                          <button onClick={() => toggleSaved(entry)}>
+                            <BookmarkIcon
+                              className={
+                                saved.some(
+                                  (e) =>
+                                    e.id === entry.id ||
+                                    (e.text === entry.text &&
+                                      e.source === entry.source &&
+                                      e.target === entry.target),
+                                )
+                                  ? "filled-icon"
+                                  : ""
+                              }
+                            />
+                            {view === "saved" ? "Remove" : "Save / unsave"}
+                          </button>
+                        </div>
+                      </article>
+                    ))}
+                  </div>
+                </>
+              ) : (
+                <div className="collection-empty">
+                  <BookmarkIcon />
+                  <h2>
+                    {view === "saved"
+                      ? "Keep your favorite words close."
+                      : "Every conversation starts somewhere."}
+                  </h2>
+                  <p>
+                    {view === "saved"
+                      ? "Use the bookmark button on a translation to save it here."
+                      : "Translate your first words and they’ll appear here."}
+                  </p>
+                  <button
+                    className="translate-button"
+                    onClick={() => setView("translate")}
+                  >
+                    Start translating
+                    <ArrowRightIcon />
+                  </button>
+                </div>
+              )}
+            </section>
+          )}
+          <footer className="workspace-footer">
+            <span>Made for a world that speaks many languages.</span>
+            <span>
+              Lingua © {new Date().getFullYear()}
+              <span className="footer-dot">·</span>
+              <button onClick={() => setHelp(true)}>
+                About Lingua
+                <ArrowUpRightIcon />
+              </button>
+            </span>
+          </footer>
+        </main>
+      </div>
+      {notice && (
+        <div className="toast" role="status">
+          <CheckIcon />
+          {notice}
+          <button
+            onClick={() => setNotice("")}
+            aria-label="Dismiss notification"
+          >
+            <XMarkIcon />
+          </button>
+        </div>
+      )}
+      {help && (
+        <div
+          className="modal-backdrop"
+          onClick={(e) => {
+            if (e.target === e.currentTarget) setHelp(false);
+          }}
+        >
+          <section
+            className="help-modal"
+            ref={helpDialog}
+            role="dialog"
+            aria-modal="true"
+            aria-labelledby="help-title"
+            onKeyDown={(e) => {
+              if (e.key === "Escape") setHelp(false);
+            }}
+          >
+            <button
+              className="icon-button modal-close"
+              autoFocus
+              onClick={() => setHelp(false)}
+              aria-label="Close help"
+            >
+              <XMarkIcon />
+            </button>
+            <span className="example-icon">
+              <LanguageIcon />
+            </span>
+            <h2 id="help-title">A little help from Lingua.</h2>
+            <p>
+              Choose your languages, enter up to 500 characters, and select
+              Translate text. You can also press Ctrl or ⌘ + Enter.
+            </p>
+            <p>
+              Listen to words, copy the result, or bookmark it for later.
+              History and saved translations stay in this browser. Audio voices
+              depend on your device.
+            </p>
+            <p>
+              Text is sent to MyMemory for translation. The free service has
+              daily usage limits. Avoid entering sensitive information.
+            </p>
+            <a
+              href="https://mymemory.translated.net/doc/en/tos.php"
+              target="_blank"
+              rel="noreferrer"
+            >
+              Translation service terms
+              <ArrowUpRightIcon />
+            </a>
+            <button className="translate-button" onClick={() => setHelp(false)}>
+              Got it
+              <CheckIcon />
+            </button>
+          </section>
+        </div>
+      )}
+    </div>
+  );
+}
