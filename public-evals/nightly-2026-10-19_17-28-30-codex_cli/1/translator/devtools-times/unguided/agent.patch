--- /dev/null
+++ b/src/pages/api/translate.ts
@@ -0,0 +1,91 @@
+import type { APIRoute } from "astro";
+import { languages } from "../../lib/languages";
+
+const json = (data: object, status = 200) =>
+  new Response(JSON.stringify(data), {
+    status,
+    headers: {
+      "Content-Type": "application/json",
+      "Cache-Control": "no-store",
+    },
+  });
+
+export const POST: APIRoute = async ({ request }) => {
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: "Please send a valid translation request." }, 400);
+  }
+  const { text, source, target } = body ?? {};
+  if (typeof text !== "string" || !text.trim() || text.length > 500) {
+    return json({ error: "Enter between 1 and 500 characters." }, 400);
+  }
+  if (
+    ![source, target].every((code) => languages.some((l) => l.code === code))
+  ) {
+    return json({ error: "Please choose supported languages." }, 400);
+  }
+  if (source === target) return json({ translation: text });
+
+  // MyMemory accepts at most 500 UTF-8 bytes per segment. Keep words and whitespace.
+  const encoder = new TextEncoder();
+  const segments: string[] = [];
+  let segment = "";
+  for (const token of text.split(/(\s+)/)) {
+    if (encoder.encode(segment + token).length <= 480) {
+      segment += token;
+      continue;
+    }
+    if (segment) {
+      segments.push(segment);
+      segment = "";
+    }
+    for (const char of token) {
+      if (encoder.encode(segment + char).length > 480) {
+        segments.push(segment);
+        segment = "";
+      }
+      segment += char;
+    }
+  }
+  if (segment) segments.push(segment);
+  try {
+    const translated = await Promise.all(
+      segments.map(async (part) => {
+        if (!part.trim()) return part;
+        const url = new URL("https://api.mymemory.translated.net/get");
+        url.searchParams.set("q", part.trim());
+        url.searchParams.set("langpair", `${source}|${target}`);
+        const response = await fetch(url, {
+          signal: AbortSignal.timeout(15000),
+        });
+        if (!response.ok) throw new Error("service");
+        const data = await response.json();
+        if (data.quotaFinished || Number(data.responseStatus) === 429)
+          throw new Error("quota");
+        if (
+          Number(data.responseStatus) !== 200 ||
+          typeof data.responseData?.translatedText !== "string"
+        )
+          throw new Error("service");
+        return (
+          (part.match(/^\s*/)?.[0] || "") +
+          data.responseData.translatedText +
+          (part.match(/\s*$/)?.[0] || "")
+        );
+      }),
+    );
+    return json({ translation: translated.join("") });
+  } catch (error) {
+    return json(
+      {
+        error:
+          error instanceof Error && error.message === "quota"
+            ? "The translation service has reached its daily limit. Please try again later."
+            : "We couldn’t reach the translation service. Please try again.",
+      },
+      503,
+    );
+  }
+};
