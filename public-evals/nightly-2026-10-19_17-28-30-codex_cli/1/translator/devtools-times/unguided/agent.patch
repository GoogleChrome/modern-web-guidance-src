+    label: "English → French",
+    icon: GlobeAltIcon,
+  },
+  {
+    text: "Thank you for making me feel at home.",
+    source: "en",
+    target: "ja",
+    title: "A little connection",
+    label: "English → Japanese",
+    icon: ChatBubbleLeftRightIcon,
+  },
+  {
+    text: "Great ideas can come from anywhere.",
+    source: "en",
+    target: "es",
+    title: "A world of ideas",
+    label: "English → Spanish",
+    icon: SparklesIcon,
+  },
+];
+function readEntries(key: string): Entry[] {
+  try {
+    const data = JSON.parse(localStorage.getItem(key) || "[]");
+    return Array.isArray(data)
+      ? data
+          .filter(
+            (e) =>
+              e &&
+              ["id", "text", "translation", "source", "target", "date"].every(
+                (k) => typeof e[k] === "string",
+              ),
+          )
+          .slice(0, 30)
+      : [];
+  } catch {
+    return [];
+  }
+}
+export default function Translator() {
+  const [view, setView] = useState<View>("translate");
+  const [text, setText] = useState("");
+  const [source, setSource] = useState("en");
+  const [target, setTarget] = useState("fr");
+  const [result, setResult] = useState<Entry | null>(null);
+  const [history, setHistory] = useState<Entry[]>([]);
+  const [saved, setSaved] = useState<Entry[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [help, setHelp] = useState(false);
+  const [speaking, setSpeaking] = useState("");
+  const controller = useRef<AbortController | null>(null);
+  const input = useRef<HTMLTextAreaElement>(null);
+  const helpDialog = useRef<HTMLElement>(null);
+  useEffect(() => {
+    setHistory(readEntries("lingua-history"));
+    setSaved(readEntries("lingua-saved"));
+    return () => {
+      controller.current?.abort();
+      window.speechSynthesis?.cancel();
+    };
+  }, []);
+  useEffect(() => {
+    if (notice) {
+      const timer = setTimeout(() => setNotice(""), 3500);
+      return () => clearTimeout(timer);
+    }
+  }, [notice]);
+  useEffect(() => {
+    if (!help) return;
+    const previousFocus = document.activeElement as HTMLElement | null;
+    function handleKey(event: KeyboardEvent) {
+      if (event.key === "Escape") setHelp(false);
+      if (event.key !== "Tab") return;
+      const controls =
+        helpDialog.current?.querySelectorAll<HTMLElement>("button, a[href]");
+      if (!controls?.length) return;
+      const first = controls[0];
+      const last = controls[controls.length - 1];
+      if (event.shiftKey && document.activeElement === first) {
+        event.preventDefault();
+        last.focus();
+      } else if (!event.shiftKey && document.activeElement === last) {
+        event.preventDefault();
+        first.focus();
+      }
+    }
+    document.addEventListener("keydown", handleKey);
+    return () => {
+      document.removeEventListener("keydown", handleKey);
+      previousFocus?.focus();
+    };
+  }, [help]);
+  function store(key: string, entries: Entry[]) {
+    try {
+      localStorage.setItem(key, JSON.stringify(entries));
+    } catch {
+      setNotice("Your browser could not save this translation.");
+    }
+  }
+  function invalidate() {
+    controller.current?.abort();
+    controller.current = null;
+    setLoading(false);
+    setResult(null);
+    setError("");
+    window.speechSynthesis?.cancel();
+    setSpeaking("");
+  }
+  async function translate() {
+    if (!text.trim() || loading) return;
+    const requestController = new AbortController();
+    controller.current?.abort();
+    controller.current = requestController;
+    setLoading(true);
+    setError("");
+    setResult(null);
+    try {
+      const response = await fetch(`${base}api/translate`, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ text, source, target }),
+        signal: requestController.signal,
+      });
+      const data = await response.json();
+      if (!response.ok)
+        throw new Error(
+          data.error || "Translation is unavailable. Please try again.",
+        );
+      const entry = {
+        id: crypto.randomUUID(),
+        text,
+        translation: data.translation,
+        source,
+        target,
+        date: new Date().toISOString(),
+      };
+      setResult(entry);
+      setHistory((previous) => {
+        const next = [
+          entry,
+          ...previous.filter(
+            (e) =>
+              e.text !== text || e.source !== source || e.target !== target,
+          ),
+        ].slice(0, 30);
+        store("lingua-history", next);
+        return next;
+      });
+    } catch (e) {
+      if (!requestController.signal.aborted)
+        setError(
+          e instanceof Error
+            ? e.message
+            : "Something went wrong. Please try again.",
+        );
+    } finally {
+      if (controller.current === requestController) {
+        setLoading(false);
+        controller.current = null;
+      }
+    }
+  }
