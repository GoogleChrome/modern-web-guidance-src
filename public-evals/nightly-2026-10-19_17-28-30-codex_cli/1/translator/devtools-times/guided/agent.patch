--- /dev/null
+++ b/src/components/Translator.tsx
@@ -0,0 +1,461 @@
+import { useEffect, useId, useRef, useState, type FormEvent } from "react";
+import {
+  ArrowRightIcon,
+  ArrowsRightLeftIcon,
+  CheckIcon,
+  ClipboardDocumentIcon,
+  GlobeAltIcon,
+  LanguageIcon,
+  SpeakerWaveIcon,
+  XMarkIcon,
+  ClockIcon,
+  ArrowUpRightIcon,
+} from "@heroicons/react/24/outline";
+import { languages, languageName, MAX_TEXT_LENGTH } from "../lib/translation";
+import "../styles/translator.css";
+
+type Entry = {
+  text: string;
+  translation: string;
+  source: string;
+  target: string;
+  date: number;
+};
+const storageKey = "devtools-times-translations";
+const examples = [
+  "Hello, how are you?",
+  "The world is full of stories.",
+  "Thank you for your help.",
+];
+
+export default function Translator() {
+  const id = useId();
+  const [text, setText] = useState("");
+  const [source, setSource] = useState("en");
+  const [target, setTarget] = useState("es");
+  const [translation, setTranslation] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [history, setHistory] = useState<Entry[]>([]);
+  const [canSpeak, setCanSpeak] = useState(false);
+  const inputRef = useRef<HTMLTextAreaElement>(null);
+  const requestRef = useRef<AbortController | null>(null);
+
+  useEffect(() => {
+    setCanSpeak("speechSynthesis" in window);
+    try {
+      const saved: unknown = JSON.parse(
+        localStorage.getItem(storageKey) ?? "[]",
+      );
+      if (Array.isArray(saved))
+        setHistory(
+          saved
+            .filter(
+              (item): item is Entry =>
+                item &&
+                typeof item.text === "string" &&
+                item.text.length <= MAX_TEXT_LENGTH &&
+                typeof item.translation === "string" &&
+                languages.some(([code]) => code === item.source) &&
+                languages.some(([code]) => code === item.target) &&
+                typeof item.date === "number",
+            )
+            .slice(0, 3),
+        );
+    } catch {
+      /* Storage may be unavailable in private browsing. */
+    }
+    return () => {
+      requestRef.current?.abort();
+    };
+  }, []);
+
+  function saveHistory(entries: Entry[]) {
+    setHistory(entries);
+    try {
+      localStorage.setItem(storageKey, JSON.stringify(entries));
+    } catch {
+      /* Translation works without storage. */
+    }
+  }
+  function resetResult() {
+    requestRef.current?.abort();
+    requestRef.current = null;
+    setBusy(false);
+    setTranslation("");
+    setError("");
+    setNotice("");
+  }
+  async function translate(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (!text.trim()) {
+      setError("Enter some text to translate.");
+      inputRef.current?.focus();
+      return;
+    }
+    const controller = new AbortController();
+    requestRef.current?.abort();
+    requestRef.current = controller;
+    setBusy(true);
+    setError("");
+    setNotice("");
+    setTranslation("");
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/translate`, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ text, source, target }),
+        signal: controller.signal,
+      });
+      const data = await response.json();
+      if (!response.ok || typeof data.translation !== "string")
+        throw new Error(data.error || "Unable to translate. Please try again.");
+      if (controller.signal.aborted) return;
+      setTranslation(data.translation);
+      saveHistory(
+        [
+          {
+            text,
+            translation: data.translation,
+            source,
+            target,
+            date: Date.now(),
+          },
+          ...history.filter(
+            (item) =>
+              !(
+                item.text === text &&
+                item.source === source &&
+                item.target === target
+              ),
+          ),
+        ].slice(0, 3),
+      );
+    } catch (err) {
+      if (!controller.signal.aborted)
+        setError(
+          err instanceof Error
+            ? err.message
+            : "Please check your connection and try again.",
+        );
+    } finally {
+      if (requestRef.current === controller) {
+        setBusy(false);
+        requestRef.current = null;
+      }
+    }
+  }
+  function speak(value: string, lang: string) {
+    if (!value || !canSpeak) return;
+    speechSynthesis.cancel();
+    const utterance = new SpeechSynthesisUtterance(value);
+    utterance.lang = lang;
+    utterance.onerror = () =>
+      setNotice("Audio is unavailable for this language on your device.");
+    speechSynthesis.speak(utterance);
+  }
+  async function copy() {
+    try {
+      await navigator.clipboard.writeText(translation);
+      setNotice("Translation copied to clipboard.");
+    } catch {
+      setNotice(
+        "Copy is unavailable. You can select and copy the translated text.",
+      );
+    }
+  }
+  function swap() {
+    const previousText = text;
+    const previousTranslation = translation;
+    resetResult();
+    setSource(target);
+    setTarget(source);
+    if (previousTranslation) {
+      setText(previousTranslation.slice(0, MAX_TEXT_LENGTH));
+      setTranslation(previousText);
+    }
+  }
+  return (
+    <section className="translator" aria-labelledby={`${id}-title`}>
+      <div className="tr-heading">
+        <div>
+          <div className="tr-eyebrow">
+            <span /> A WORLD OF WORDS
+          </div>
+          <h1 id={`${id}-title`}>
+            Good stories have <em>no borders.</em>
+          </h1>
+          <p>Find the right words. Connect with the world.</p>
+        </div>
+        <div className="tr-illustration" aria-hidden="true">
+          <span className="tr-script script-one">Aa</span>
+          <GlobeAltIcon />
+          <span className="tr-script script-two">あ</span>
+          <span className="tr-script script-three">Hola</span>
+          <span className="tr-orbit" />
+        </div>
+      </div>
+      <div className="tr-tool-title">
+        <span>
+          <LanguageIcon /> Text translator
+        </span>
+        <span className="tr-language-count">
+          16 languages. Endless possibilities.
+        </span>
+      </div>
+      <form
+        className="tr-card"
+        onSubmit={translate}
+        action={`${import.meta.env.BASE_URL}api/translate`}
+        method="post"
+      >
+        <div className="tr-selectors">
+          <div className="tr-language">
+            <label htmlFor={`${id}-source`}>Translate from</label>
+            <select
+              id={`${id}-source`}
+              name="source"
+              value={source}
+              onChange={(e) => {
+                resetResult();
+                setSource(e.target.value);
+              }}
+            >
+              {languages.map(([code, name]) => (
+                <option key={code} value={code}>
+                  {name}
+                </option>
+              ))}
+            </select>
+          </div>
+          <button
+            className="tr-swap"
+            type="button"
+            onClick={swap}
+            aria-label="Swap languages"
+            title="Swap languages"
+          >
+            <ArrowsRightLeftIcon />
+          </button>
+          <div className="tr-language">
+            <label htmlFor={`${id}-target`}>Translate to</label>
+            <select
+              id={`${id}-target`}
+              name="target"
+              value={target}
+              onChange={(e) => {
+                resetResult();
+                setTarget(e.target.value);
+              }}
+            >
+              {languages.map(([code, name]) => (
+                <option key={code} value={code}>
+                  {name}
+                </option>
+              ))}
+            </select>
+          </div>
+        </div>
+        <div className="tr-panels">
+          <div className="tr-input-panel">
+            <label className="tr-sr-only" htmlFor={`${id}-text`}>
+              Text to translate (required)
+            </label>
+            <textarea
+              ref={inputRef}
+              id={`${id}-text`}
+              name="text"
+              lang={source}
+              dir="auto"
+              value={text}
+              required
+              maxLength={MAX_TEXT_LENGTH}
+              aria-describedby={`${id}-limit ${id}-status`}
+              placeholder="Type or paste your text here…"
+              onChange={(e) => {
+                resetResult();
+                setText(e.target.value);
+              }}
+            />
+            {text && (
+              <button
+                className="tr-clear"
+                type="button"
+                aria-label="Clear text"
+                onClick={() => {
+                  resetResult();
+                  setText("");
+                  inputRef.current?.focus();
+                }}
+              >
+                <XMarkIcon />
+              </button>
+            )}
+            <div className="tr-panel-footer">
+              <button
+                className="tr-icon-button"
+                type="button"
+                aria-label="Listen to source text"
+                title={
+                  canSpeak
+                    ? "Listen to source text"
+                    : "Audio unavailable on this device"
+                }
+                disabled={!text || !canSpeak}
+                onClick={() => speak(text, source)}
+              >
+                <SpeakerWaveIcon />
+              </button>
+              <span id={`${id}-limit`}>
+                {text.length.toLocaleString()} / 1,000
+              </span>
+            </div>
+          </div>
+          <div className="tr-output-panel" aria-busy={busy}>
+            <div
+              className={`tr-output ${translation ? "has-translation" : ""}`}
+              lang={target}
+              dir="auto"
+              aria-live="polite"
+            >
+              {busy ? (
+                <span className="tr-loading">Finding the right words…</span>
+              ) : (
+                translation || (
+                  <>
+                    <span>Translation</span>
+                    <small>Your words, in another language.</small>
+                  </>
+                )
+              )}
+            </div>
+            <div className="tr-panel-footer">
+              <button
+                className="tr-icon-button"
+                type="button"
+                aria-label="Listen to translation"
+                title="Listen to translation"
+                disabled={!translation || !canSpeak}
+                onClick={() => speak(translation, target)}
+              >
+                <SpeakerWaveIcon />
+              </button>
+              <button
+                className="tr-copy"
+                type="button"
+                onClick={copy}
+                disabled={!translation}
+              >
+                {notice.startsWith("Translation copied") ? (
+                  <CheckIcon />
+                ) : (
+                  <ClipboardDocumentIcon />
+                )}{" "}
+                Copy
+              </button>
+            </div>
+          </div>
+        </div>
+        <div className="tr-action-row">
+          <span>
+            <span className="tr-shortcut">↵</span> A little language goes a long
+            way.
+          </span>
+          <button className="tr-submit" type="submit" disabled={busy}>
+            {busy ? "Translating…" : "Translate text"}
+            <ArrowRightIcon />
+          </button>
+        </div>
+      </form>
+      <div
+        id={`${id}-status`}
+        className={`tr-status ${error ? "tr-error" : ""}`}
+        role="status"
+      >
+        {error || notice}
+      </div>
+      <div className="tr-examples">
+        <span>Try a little something</span>
+        {examples.map((example) => (
+          <button
+            type="button"
+            key={example}
+            onClick={() => {
+              resetResult();
+              setText(example);
+              setSource("en");
+              inputRef.current?.focus();
+            }}
+          >
+            {example}
+            <ArrowUpRightIcon />
+          </button>
+        ))}
+      </div>
+      <div className="tr-service-note">
+        <GlobeAltIcon />
+        <span>
+          Powered by MyMemory. Text is sent to the translation service when you
+          translate.
+        </span>
+      </div>
+      <div className="tr-recent-heading">
+        <h2>
+          <ClockIcon /> Recent translations
+        </h2>
+        {history.length > 0 && (
+          <button type="button" onClick={() => saveHistory([])}>
+            Clear history
+          </button>
+        )}
+        <span>Saved on this device</span>
+      </div>
+      {history.length ? (
+        <div className="tr-history">
+          {history.map((item) => (
+            <button
+              type="button"
+              key={item.date}
+              onClick={() => {
+                resetResult();
+                setText(item.text);
+                setSource(item.source);
+                setTarget(item.target);
+                setTranslation(item.translation);
+              }}
+            >
+              <span className="tr-history-pair">
+                {languageName(item.source)} <ArrowRightIcon />{" "}
+                {languageName(item.target)}
+                <ArrowUpRightIcon />
+              </span>
+              <strong dir="auto">{item.text}</strong>
+              <span dir="auto" lang={item.target}>
+                {item.translation}
+              </span>
+            </button>
+          ))}
+        </div>
+      ) : (
+        <div className="tr-empty-history">
+          <span className="tr-empty-icon">
+            <ClockIcon />
+          </span>
+          <div>
+            <strong>A conversation starts with a word.</strong>
+            <p>
+              Your recent translations will appear here. Pick one up anytime.
+            </p>
+          </div>
+          <span className="tr-empty-dash">—</span>
+        </div>
+      )}
+      <div className="tr-bottom-note">
+        <span className="tr-small-line" /> A different language. A shared
+        understanding. <span className="tr-small-line" />
+      </div>
+      <noscript>Please enable JavaScript to use the text translator.</noscript>
+    </section>
+  );
+}
diff --git a/src/lib/translation.test.ts b/src/lib/translation.test.ts
new file mode 100644
index 0000000..09735f8
--- /dev/null
+++ b/src/lib/translation.test.ts
@@ -0,0 +1,99 @@
+import { test, afterEach } from "node:test";
+import assert from "node:assert/strict";
+import { MAX_TEXT_LENGTH, splitTranslationText } from "./translation.ts";
+import { POST } from "../pages/api/translate.ts";
+
+const originalFetch = globalThis.fetch;
+afterEach(() => {
+  globalThis.fetch = originalFetch;
+});
+const request = (body: unknown) =>
+  POST({
+    request: new Request("http://localhost/api/translate", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(body),
+    }),
+  } as Parameters<typeof POST>[0]);
+
+test("chunking respects the provider byte limit without losing Unicode or whitespace", () => {
+  for (const text of [
+    "Hello world. ".repeat(80),
+    "你好世界 🌎 ".repeat(100),
+    "あ".repeat(1000),
+    "  hello\n\nworld  ",
+  ]) {
+    const chunks = splitTranslationText(text);
+    assert.equal(chunks.join(""), text);
+    assert.ok(
+      chunks.every((chunk) => new TextEncoder().encode(chunk).length <= 450),
+    );
+    assert.ok(chunks.every((chunk) => !chunk.includes("\uFFFD")));
+  }
+});
+
+test("rejects invalid input before contacting the provider", async () => {
+  globalThis.fetch = async () => {
+    throw new Error("Must not call provider");
+  };
+  for (const body of [
+    null,
+    { text: "" },
+    { text: "  ", source: "en", target: "es" },
+    { text: "x".repeat(MAX_TEXT_LENGTH + 1), source: "en", target: "es" },
+    { text: "Hello", source: "invalid", target: "es" },
+  ]) {
+    assert.equal((await request(body)).status, 400);
+  }
+});
+
+test("same-language requests return the input without contacting provider", async () => {
+  globalThis.fetch = async () => {
+    throw new Error("Must not call provider");
+  };
+  const response = await request({ text: "Hello", source: "en", target: "en" });
+  assert.equal(response.status, 200);
+  assert.deepEqual(await response.json(), { translation: "Hello" });
+});
+
+test("translates text with the requested language pair and preserves surrounding whitespace", async () => {
+  globalThis.fetch = async (input) => {
+    const url = new URL(String(input));
+    assert.equal(url.hostname, "api.mymemory.translated.net");
+    assert.equal(url.searchParams.get("langpair"), "en|es");
+    assert.equal(url.searchParams.get("q"), "Hello");
+    return Response.json({
+      responseStatus: 200,
+      responseData: { translatedText: "Hola" },
+    });
+  };
+  const response = await request({
+    text: " Hello\n",
+    source: "en",
+    target: "es",
+  });
+  assert.deepEqual(await response.json(), { translation: " Hola\n" });
+  assert.equal(response.headers.get("cache-control"), "no-store");
+});
+
+test("returns actionable quota and network errors", async () => {
+  globalThis.fetch = async () =>
+    Response.json({ responseStatus: 429, quotaFinished: true });
+  assert.equal(
+    (await request({ text: "Hello", source: "en", target: "es" })).status,
+    429,
+  );
+  globalThis.fetch = async () => {
+    throw new Error("offline");
+  };
+  assert.equal(
+    (await request({ text: "Hello", source: "en", target: "es" })).status,
+    503,
+  );
+  globalThis.fetch = async () =>
+    Response.json({ responseStatus: 200, responseData: {} });
+  assert.equal(
+    (await request({ text: "Hello", source: "en", target: "es" })).status,
+    503,
+  );
+});
diff --git a/src/lib/translation.ts b/src/lib/translation.ts
new file mode 100644
index 0000000..02313a1
--- /dev/null
+++ b/src/lib/translation.ts
@@ -0,0 +1,49 @@
+export const languages = [
+  ["en", "English"],
+  ["es", "Spanish"],
+  ["fr", "French"],
+  ["de", "German"],
+  ["it", "Italian"],
+  ["pt", "Portuguese"],
+  ["nl", "Dutch"],
+  ["pl", "Polish"],
+  ["uk", "Ukrainian"],
+  ["ru", "Russian"],
+  ["ar", "Arabic"],
+  ["hi", "Hindi"],
+  ["zh-CN", "Chinese"],
+  ["ja", "Japanese"],
+  ["ko", "Korean"],
+  ["tr", "Turkish"],
+] as const;
+
+export const MAX_TEXT_LENGTH = 1000;
+export const languageName = (code: string) =>
+  languages.find(([id]) => id === code)?.[1] ?? code;
+
+// The provider accepts up to 500 UTF-8 bytes per request. Prefer word boundaries
+// and preserve whitespace; splitting by code point also keeps emoji intact.
+export function splitTranslationText(text: string): string[] {
+  const encoder = new TextEncoder();
+  const chunks: string[] = [];
+  let current = "";
+  for (const word of text.match(/\S+\s*|\s+/gu) ?? []) {
+    if (encoder.encode(current + word).length <= 450) {
+      current += word;
+      continue;
+    }
+    if (current) {
+      chunks.push(current);
+      current = "";
+    }
+    for (const character of word) {
+      if (encoder.encode(current + character).length > 450) {
+        chunks.push(current);
+        current = "";
+      }
+      current += character;
+    }
+  }
+  if (current) chunks.push(current);
+  return chunks;
+}
diff --git a/src/pages/api/translate.ts b/src/pages/api/translate.ts
new file mode 100644
index 0000000..638228b
--- /dev/null
+++ b/src/pages/api/translate.ts
@@ -0,0 +1,87 @@
+import type { APIRoute } from "astro";
+import {
+  languages,
+  MAX_TEXT_LENGTH,
+  splitTranslationText,
+} from "../../lib/translation.ts";
+
+const json = (data: object, status = 200) =>
+  new Response(JSON.stringify(data), {
+    status,
+    headers: {
+      "Content-Type": "application/json",
+      "Cache-Control": "no-store",
+    },
+  });
+
+export const POST: APIRoute = async ({ request }) => {
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: "Please send a valid translation request." }, 400);
+  }
+  const { text, source, target } = body ?? {};
+  if (
+    typeof text !== "string" ||
+    !text.trim() ||
+    text.length > MAX_TEXT_LENGTH
+  ) {
+    return json(
+      { error: `Enter between 1 and ${MAX_TEXT_LENGTH} characters.` },
+      400,
+    );
+  }
+  if (
+    !languages.some(([code]) => code === source) ||
+    !languages.some(([code]) => code === target)
+  ) {
+    return json({ error: "Please choose a supported language." }, 400);
+  }
+  if (source === target) return json({ translation: text });
+  try {
+    const translated: string[] = [];
+    const signal = AbortSignal.timeout(15000);
+    for (const chunk of splitTranslationText(text)) {
+      if (!chunk.trim()) {
+        translated.push(chunk);
+        continue;
+      }
+      const url = new URL("https://api.mymemory.translated.net/get");
+      url.search = new URLSearchParams({
+        q: chunk.trim(),
+        langpair: `${source}|${target}`,
+      }).toString();
+      const response = await fetch(url, { signal });
+      if (!response.ok) throw new Error("provider");
+      const data = await response.json();
+      if (Number(data.responseStatus) === 429 || data.quotaFinished) {
+        return json(
+          {
+            error:
+              "The translation service has reached its daily limit. Please try again later.",
+          },
+          429,
+        );
+      }
+      if (
+        Number(data.responseStatus) !== 200 ||
+        typeof data.responseData?.translatedText !== "string" ||
+        !data.responseData.translatedText.trim()
+      ) {
+        throw new Error("provider");
+      }
+      translated.push(
+        (chunk.match(/^\s*/u)?.[0] ?? "") +
+          data.responseData.translatedText +
+          (chunk.match(/\s*$/u)?.[0] ?? ""),
+      );
+    }
+    return json({ translation: translated.join("") });
+  } catch {
+    return json(
+      { error: "Translation is temporarily unavailable. Please try again." },
+      503,
+    );
+  }
+};
