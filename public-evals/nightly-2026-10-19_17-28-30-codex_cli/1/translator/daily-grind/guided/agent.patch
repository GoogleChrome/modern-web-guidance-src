diff --git a/translation-service.mjs b/translation-service.mjs
new file mode 100644
index 0000000..dac702b
--- /dev/null
+++ b/translation-service.mjs
@@ -0,0 +1,56 @@
+export const languages = {
+  en: 'English', es: 'Spanish', fr: 'French', de: 'German', it: 'Italian',
+  pt: 'Portuguese', ar: 'Arabic', hi: 'Hindi', ja: 'Japanese', 'zh-CN': 'Chinese (Simplified)',
+};
+
+// MyMemory accepts at most 500 UTF-8 bytes per request, not 500 characters.
+export function splitText(text) {
+  const encoder = new TextEncoder();
+  const chunks = [];
+  let remaining = text;
+  while (remaining) {
+    let chunk = '';
+    let bytes = 0;
+    for (const character of remaining) {
+      const size = encoder.encode(character).length;
+      if (bytes + size > 480) break;
+      chunk += character;
+      bytes += size;
+    }
+    if (chunk.length < remaining.length) {
+      const boundary = Math.max(chunk.lastIndexOf(' '), chunk.lastIndexOf('\n'));
+      if (boundary > 0) chunk = chunk.slice(0, boundary + 1);
+    }
+    chunks.push(chunk);
+    remaining = remaining.slice(chunk.length);
+  }
+  return chunks;
+}
+
+export async function translateText(text, source, target, { signal, fetchImpl = fetch } = {}) {
+  if (!text.trim()) throw new Error('Enter some text to translate.');
+  if (text.length > 1000) throw new Error('Please enter 1,000 characters or fewer.');
+  if (!Object.hasOwn(languages, source) || !Object.hasOwn(languages, target)) {
+    throw new Error('Please choose a supported language.');
+  }
+  if (source === target) return text;
+  const translated = [];
+  for (const chunk of splitText(text)) {
+    if (!chunk.trim()) { translated.push(chunk); continue; }
+    const url = new URL('https://api.mymemory.translated.net/get');
+    url.searchParams.set('q', chunk.trim());
+    url.searchParams.set('langpair', `${source}|${target}`);
+    const response = await fetchImpl(url, { signal, referrerPolicy: 'no-referrer' });
+    if (response.status === 429) throw new Error('The translation limit has been reached. Please try again later.');
+    if (!response.ok) throw new Error('The translation service is unavailable. Please try again.');
+    const data = await response.json();
+    if (data.quotaFinished || Number(data.responseStatus) === 429 || Number(data.responseStatus) === 403) {
+      throw new Error('The translation limit has been reached. Please try again later.');
+    }
+    if (Number(data.responseStatus) !== 200 || typeof data.responseData?.translatedText !== 'string' || !data.responseData.translatedText.trim()) {
+      throw new Error('No translation was returned. Please try another language or try again later.');
+    }
+    translated.push(chunk.match(/^\s*/)[0] + data.responseData.translatedText + chunk.match(/\s*$/)[0]);
+  }
+  return translated.join('');
+}
diff --git a/translation-service.test.mjs b/translation-service.test.mjs
new file mode 100644
index 0000000..64550f6
--- /dev/null
+++ b/translation-service.test.mjs
@@ -0,0 +1,68 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { splitText, translateText } from './translation-service.mjs';
+
+const success = (text) => ({ ok: true, json: async () => ({ responseStatus: 200, responseData: { translatedText: text } }) });
+
+test('requests the selected language pair and safely encodes punctuation', async () => {
+  const controller = new AbortController();
+  const result = await translateText('Coffee & tea?', 'en', 'fr', {
+    signal: controller.signal,
+    fetchImpl: async (url, options) => {
+      assert.equal(url.origin, 'https://api.mymemory.translated.net');
+      assert.equal(url.searchParams.get('q'), 'Coffee & tea?');
+      assert.equal(url.searchParams.get('langpair'), 'en|fr');
+      assert.equal(options.signal, controller.signal);
+      return success('Café et thé ?');
+    },
+  });
+  assert.equal(result, 'Café et thé ?');
+});
+
+test('Unicode chunks obey the byte limit and preserve the original input', () => {
+  for (const text of ['你好世界'.repeat(200), '☕️ coffee 😃 '.repeat(100), 'x'.repeat(1000), '\n  hello world '.repeat(80)]) {
+    const chunks = splitText(text);
+    assert.equal(chunks.join(''), text);
+    assert.ok(chunks.every(chunk => new TextEncoder().encode(chunk).length <= 480));
+    assert.ok(chunks.every(chunk => !/[\uD800-\uDBFF]$/.test(chunk)));
+  }
+});
+
+test('translates multiple chunks and preserves surrounding whitespace', async () => {
+  const text = '  coffee '.repeat(100) + '\n';
+  let requests = 0;
+  const result = await translateText(text, 'en', 'es', { fetchImpl: async url => {
+    requests++;
+    return success(url.searchParams.get('q'));
+  } });
+  assert.equal(result, text);
+  assert.ok(requests > 1);
+});
+
+test('same-language translation returns text without a network request', async () => {
+  assert.equal(await translateText('Hello', 'en', 'en', { fetchImpl: () => assert.fail('Unexpected request') }), 'Hello');
+});
+
+test('rejects empty input, excessive text, and unsupported languages', async () => {
+  await assert.rejects(translateText('  ', 'en', 'es'), /Enter some text/);
+  await assert.rejects(translateText('a'.repeat(1001), 'en', 'es'), /1,000/);
+  await assert.rejects(translateText('Hello', 'invalid', 'es'), /supported language/);
+});
+
+test('reports HTTP errors, quotas, and malformed service responses', async () => {
+  for (const response of [
+    { ok: false, status: 429 },
+    { ok: true, json: async () => ({ responseStatus: 403 }) },
+    { ok: true, json: async () => ({ quotaFinished: true }) },
+  ]) {
+    await assert.rejects(translateText('Hello', 'en', 'es', { fetchImpl: async () => response }), /limit/);
+  }
+  await assert.rejects(translateText('Hello', 'en', 'es', { fetchImpl: async () => ({ ok: false, status: 500 }) }), /unavailable/);
+  await assert.rejects(translateText('Hello', 'en', 'es', { fetchImpl: async () => ({ ok: true, json: async () => ({}) }) }), /No translation/);
+});
+
+test('propagates cancellation and network failure for the UI to handle', async () => {
+  const error = new DOMException('Cancelled', 'AbortError');
+  await assert.rejects(translateText('Hello', 'en', 'es', { fetchImpl: async () => { throw error; } }), { name: 'AbortError' });
+  await assert.rejects(translateText('Hello', 'en', 'es', { fetchImpl: async () => { throw new TypeError('Network failure'); } }), /Network failure/);
+});
diff --git a/translator.js b/translator.js
new file mode 100644
index 0000000..a94988c
--- /dev/null
+++ b/translator.js
@@ -0,0 +1,113 @@
+import { languages, translateText } from './translation-service.mjs';
+
+const form = document.querySelector('#translation-form');
+const sourceLanguage = document.querySelector('#source-language');
+const targetLanguage = document.querySelector('#target-language');
+const sourceText = document.querySelector('#source-text');
+const output = document.querySelector('#translated-text');
+const submit = document.querySelector('#translate-button');
+const copy = document.querySelector('#copy-translation');
+const status = document.querySelector('#translation-status');
+const count = document.querySelector('#character-count');
+let request;
+let revision = 0;
+
+for (const [code, name] of Object.entries(languages)) {
+  sourceLanguage.add(new Option(name, code));
+  targetLanguage.add(new Option(name, code));
+}
+sourceLanguage.value = 'en';
+targetLanguage.value = 'es';
+sourceText.lang = 'en';
+output.lang = 'es';
+form.hidden = false;
+
+function message(text, error = false) {
+  status.textContent = text;
+  status.dataset.error = String(error);
+}
+
+function resetResult() {
+  revision++;
+  request?.abort();
+  request = undefined;
+  output.value = '';
+  copy.disabled = true;
+  submit.disabled = false;
+  submit.textContent = 'Translate text';
+  output.setAttribute('aria-busy', 'false');
+  sourceText.setCustomValidity('');
+  count.textContent = `${sourceText.value.length.toLocaleString()} / 1,000 characters`;
+  sourceText.lang = sourceLanguage.value;
+  output.lang = targetLanguage.value;
+  message('');
+}
+
+sourceText.addEventListener('input', resetResult);
+sourceLanguage.addEventListener('change', resetResult);
+targetLanguage.addEventListener('change', resetResult);
+
+document.querySelector('#swap-languages').addEventListener('click', () => {
+  [sourceLanguage.value, targetLanguage.value] = [targetLanguage.value, sourceLanguage.value];
+  if (output.value) sourceText.value = output.value;
+  resetResult();
+});
+
+document.querySelector('#clear-translation').addEventListener('click', () => {
+  sourceText.value = '';
+  resetResult();
+  sourceText.focus();
+});
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (!sourceText.value.trim()) {
+    sourceText.setCustomValidity('Enter some text to translate.');
+    sourceText.reportValidity();
+    return;
+  }
+  resetResult();
+  const currentRevision = revision;
+  const controller = new AbortController();
+  request = controller;
+  const timeout = setTimeout(() => controller.abort(), 30000);
+  submit.disabled = true;
+  submit.textContent = 'Translating…';
+  output.setAttribute('aria-busy', 'true');
+  message('Translating your text…');
+  try {
+    const result = await translateText(sourceText.value, sourceLanguage.value, targetLanguage.value, { signal: controller.signal });
+    if (revision !== currentRevision) return;
+    // Treat the remote response as plain text, never as HTML.
+    output.value = result;
+    copy.disabled = false;
+    message('Translation ready.');
+  } catch (error) {
+    if (revision !== currentRevision) return;
+    message(error.name === 'AbortError'
+      ? 'Translation took too long. Please try again.'
+      : error instanceof TypeError ? 'Could not connect. Check your internet connection and try again.' : error.message, true);
+  } finally {
+    clearTimeout(timeout);
+    if (revision === currentRevision) {
+      request = undefined;
+      submit.disabled = false;
+      submit.textContent = 'Translate text';
+      output.setAttribute('aria-busy', 'false');
+    }
+  }
+});
+
+copy.addEventListener('click', async () => {
+  const currentRevision = revision;
+  try {
+    if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
+    await navigator.clipboard.writeText(output.value);
+    if (revision === currentRevision) message('Translation copied.');
+  } catch {
+    if (revision !== currentRevision) return;
+    output.focus();
+    output.select();
+    message('Copy is unavailable. The translation is selected so you can copy it manually.');
+  }
+});
