+(() => {
+  'use strict';
+
+  const translations = {
+    en: {
+      title: 'The Daily Grind | Artisanal Coffee', language: 'Language',
+      menu: 'Menu', locations: 'Locations', rewards: 'Rewards', account: 'My Account', logout: 'Logout',
+      headline: 'Wake Up Your Senses', tagline: 'Ethically sourced, locally roasted, delivered to your cup.',
+      order: 'Order Now', seasonal: 'Seasonal Favorites', maple: 'Maple Oat Latte',
+      mapleDescription: 'Creamy oat milk with a hint of Vermont maple syrup.', details: 'View Details',
+      espresso: 'Dark Roast Espresso', espressoDescription: 'Bold, smokey, and perfect for a morning boost.',
+      coldBrew: 'Cold Brew', coldBrewDescription: 'Steeped for 18 hours for maximum smoothness.',
+      story: 'Our Story', careers: 'Join the Team', contact: 'Contact Us', privacy: 'Privacy',
+      copyright: '© 2026 The Daily Grind Coffee Co. All rights reserved.', status: 'Language changed to English.'
+    },
+    es: {
+      title: 'The Daily Grind | Café artesanal', language: 'Idioma',
+      menu: 'Menú', locations: 'Locales', rewards: 'Recompensas', account: 'Mi cuenta', logout: 'Cerrar sesión',
+      headline: 'Despierta tus sentidos', tagline: 'De origen ético, tostado localmente y servido en tu taza.',
+      order: 'Pide ahora', seasonal: 'Favoritos de temporada', maple: 'Latte de avena y arce',
+      mapleDescription: 'Cremosa leche de avena con un toque de sirope de arce de Vermont.', details: 'Ver detalles',
+      espresso: 'Espresso de tueste oscuro', espressoDescription: 'Intenso, ahumado y perfecto para empezar el día con energía.',
+      coldBrew: 'Café de extracción en frío', coldBrewDescription: 'Infusionado durante 18 horas para una suavidad máxima.',
+      story: 'Nuestra historia', careers: 'Únete al equipo', contact: 'Contáctanos', privacy: 'Privacidad',
+      copyright: '© 2026 The Daily Grind Coffee Co. Todos los derechos reservados.', status: 'Idioma cambiado a español.'
+    },
+    fr: {
+      title: 'The Daily Grind | Café artisanal', language: 'Langue',
+      menu: 'Carte', locations: 'Nos cafés', rewards: 'Fidélité', account: 'Mon compte', logout: 'Déconnexion',
+      headline: 'Éveillez vos sens', tagline: 'Un café issu de sources éthiques, torréfié localement et servi dans votre tasse.',
+      order: 'Commander', seasonal: 'Les favoris de saison', maple: 'Latte à l’avoine et à l’érable',
+      mapleDescription: 'Du lait d’avoine onctueux avec une touche de sirop d’érable du Vermont.', details: 'Voir les détails',
+      espresso: 'Espresso à torréfaction foncée', espressoDescription: 'Intense et fumé, idéal pour bien commencer la journée.',
+      coldBrew: 'Café infusé à froid', coldBrewDescription: 'Infusé pendant 18 heures pour une douceur incomparable.',
+      story: 'Notre histoire', careers: 'Rejoignez l’équipe', contact: 'Nous contacter', privacy: 'Confidentialité',
+      copyright: '© 2026 The Daily Grind Coffee Co. Tous droits réservés.', status: 'La langue sélectionnée est le français.'
+    },
+    de: {
+      title: 'The Daily Grind | Handwerklich gerösteter Kaffee', language: 'Sprache',
+      menu: 'Speisekarte', locations: 'Standorte', rewards: 'Treueprogramm', account: 'Mein Konto', logout: 'Abmelden',
+      headline: 'Wecke deine Sinne', tagline: 'Ethisch bezogen, lokal geröstet und direkt in deine Tasse.',
+      order: 'Jetzt bestellen', seasonal: 'Saisonale Favoriten', maple: 'Haferlatte mit Ahornsirup',
+      mapleDescription: 'Cremige Hafermilch mit einem Hauch Ahornsirup aus Vermont.', details: 'Details ansehen',
+      espresso: 'Dunkel gerösteter Espresso', espressoDescription: 'Kräftig, rauchig und perfekt für einen schwungvollen Morgen.',
+      coldBrew: 'Kalt gebrühter Kaffee', coldBrewDescription: 'Für maximale Milde 18 Stunden lang kalt aufgebrüht.',
+      story: 'Unsere Geschichte', careers: 'Komm ins Team', contact: 'Kontakt', privacy: 'Datenschutz',
+      copyright: '© 2026 The Daily Grind Coffee Co. Alle Rechte vorbehalten.', status: 'Sprache auf Deutsch geändert.'
+    }
+  };
+
+  const selector = document.getElementById('language');
+  const status = document.getElementById('language-status');
+  const storageKey = 'daily-grind-language';
+  const isSupported = language => Object.hasOwn(translations, language);
+
+  function setLanguage(language, announce = false) {
+    const selected = isSupported(language) ? language : 'en';
+    const messages = translations[selected];
+    document.querySelectorAll('[data-i18n]').forEach(element => {
+      const key = element.dataset.i18n;
+      if (Object.hasOwn(messages, key)) element.textContent = messages[key];
+    });
+    document.documentElement.lang = selected;
+    document.title = messages.title;
+    selector.value = selected;
+    if (announce) status.textContent = messages.status;
+  }
+
+  let savedLanguage;
+  try {
+    savedLanguage = localStorage.getItem(storageKey);
+  } catch {
+    // Translation still works when browser storage is unavailable.
+  }
+  setLanguage(savedLanguage);
+
+  selector.addEventListener('change', () => {
+    setLanguage(selector.value, true);
+    try {
+      localStorage.setItem(storageKey, selector.value);
+    } catch {
+      // Keep the selection for this page even if it cannot be saved.
+    }
+  });
+})();
