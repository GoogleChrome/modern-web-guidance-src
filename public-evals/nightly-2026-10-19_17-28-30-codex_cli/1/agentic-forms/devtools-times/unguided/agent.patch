diff --git a/src/hooks/useAccountForm.ts b/src/hooks/useAccountForm.ts
new file mode 100644
index 0000000..2583777
--- /dev/null
+++ b/src/hooks/useAccountForm.ts
@@ -0,0 +1,71 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import type { FormEvent } from 'react';
+import { isCredentials, submitAccount } from '../lib/account';
+import type { AccountAction, AccountResult } from '../lib/account';
+import { registerAgentTool } from '../lib/agent-tools';
+
+export function useAccountForm(action: AccountAction) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const pending = useRef(false);
+
+  const submit = useCallback(async (input: unknown, signal?: AbortSignal): Promise<AccountResult> => {
+    if (pending.current) {
+      return { success: false, message: 'A submission is already in progress.' };
+    }
+    setError(null);
+    setSuccess(null);
+    if (!isCredentials(input)) {
+      const message = 'Username and password are required.';
+      setError(message);
+      return { success: false, message };
+    }
+    setUsername(input.username);
+    setPassword(input.password);
+    pending.current = true;
+    setLoading(true);
+    try {
+      const result = await submitAccount(action, input, signal);
+      if (result.success) {
+        setSuccess(result.message);
+        if (action === 'register') {
+          setUsername('');
+          setPassword('');
+        }
+      } else {
+        setError(result.message);
+      }
+      return result;
+    } finally {
+      pending.current = false;
+      setLoading(false);
+    }
+  }, [action]);
+
+  useEffect(() => registerAgentTool({
+    name: action === 'login' ? 'sign_in' : 'sign_up',
+    description: action === 'login'
+      ? 'Submit the sign-in form for The DevTools Times using the supplied username and password. Returns success and a status message.'
+      : 'Create a DevTools Times account by submitting the sign-up form. The password should be at least 8 characters and contain a number. Returns success and a status message.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        username: { type: 'string', minLength: 1, description: 'The account username.' },
+        password: { type: 'string', minLength: 1, description: 'The account password.' },
+      },
+      required: ['username', 'password'],
+      additionalProperties: false,
+    },
+    execute: (input, context) => submit(input, context?.signal),
+  }), [action, submit]);
+
+  const handleSubmit = (event: FormEvent) => {
+    event.preventDefault();
+    void submit({ username, password });
+  };
+
+  return { username, setUsername, password, setPassword, error, success, loading, handleSubmit };
+}
diff --git a/src/lib/account.ts b/src/lib/account.ts
new file mode 100644
index 0000000..69d8d16
--- /dev/null
+++ b/src/lib/account.ts
@@ -0,0 +1,56 @@
+export type AccountAction = 'login' | 'register';
+export interface Credentials {
+  username: string;
+  password: string;
+}
+export interface AccountResult {
+  success: boolean;
+  message: string;
+}
+
+export function isCredentials(value: unknown): value is Credentials {
+  if (!value || typeof value !== 'object') return false;
+  const { username, password } = value as Partial<Credentials>;
+  return typeof username === 'string' && username.length > 0 &&
+    typeof password === 'string' && password.length > 0;
+}
+
+// Shared by form submissions and agent tool calls. Never return credentials or tokens.
+export async function submitAccount(
+  action: AccountAction,
+  credentials: Credentials,
+  signal?: AbortSignal,
+): Promise<AccountResult> {
+  if (!isCredentials(credentials)) {
+    return { success: false, message: 'Username and password are required.' };
+  }
+  try {
+    const response = await fetch(
+      `https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`,
+      {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username: credentials.username, password: credentials.password }),
+        signal,
+      },
+    );
+    const data = await response.json();
+    if (!response.ok) {
+      const prefix = action === 'login' ? 'Login failed' : 'Registration failed';
+      return { success: false, message: `${prefix}: ${data?.error || 'Unknown error'}` };
+    }
+    return {
+      success: true,
+      message: action === 'login'
+        ? 'Login successful!'
+        : 'User registered successfully! You can now sign in.',
+    };
+  } catch {
+    return {
+      success: false,
+      message: signal?.aborted
+        ? 'Submission cancelled.'
+        : 'An unexpected error occurred. Please try again later.',
+    };
+  }
+}
diff --git a/src/lib/agent-tools.ts b/src/lib/agent-tools.ts
new file mode 100644
index 0000000..074a4ee
--- /dev/null
+++ b/src/lib/agent-tools.ts
@@ -0,0 +1,34 @@
+export interface AgentTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  execute: (input: unknown, context?: { signal?: AbortSignal }) => Promise<unknown>;
+}
+
+interface ModelContext {
+  registerTool: (tool: AgentTool, options?: { signal: AbortSignal }) => void | Promise<void>;
+  unregisterTool?: (name: string) => void;
+}
+
+// The document API is current; the navigator fallback supports earlier previews.
+export function registerAgentTool(tool: AgentTool): () => void {
+  const current = (document as Document & { modelContext?: ModelContext }).modelContext;
+  const legacy = (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+  const context = current ?? legacy;
+  if (!context?.registerTool) return () => {};
+
+  const controller = new AbortController();
+  try {
+    const registration = context.registerTool(tool, { signal: controller.signal });
+    // A denied or unavailable API must not break the manual form.
+    Promise.resolve(registration).catch(() => {
+      console.warn(`Agent tool registration failed: ${tool.name}`);
+    });
+  } catch {
+    console.warn(`Agent tool registration failed: ${tool.name}`);
+  }
+  return () => {
+    controller.abort();
+    if (!current && context.unregisterTool) context.unregisterTool(tool.name);
+  };
+}
diff --git a/tests/agent-tools.test.ts b/tests/agent-tools.test.ts
new file mode 100644
index 0000000..419a506
--- /dev/null
+++ b/tests/agent-tools.test.ts
@@ -0,0 +1,98 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { submitAccount } from '../src/lib/account.ts';
+import { registerAgentTool } from '../src/lib/agent-tools.ts';
+
+// Supply the browser global before Node's property mock replaces it per test.
+Object.defineProperty(globalThis, 'document', { value: {}, configurable: true });
+Object.defineProperty(globalThis, 'navigator', { value: {}, configurable: true });
+
+const credentials = { username: 'reader', password: 'example123' };
+
+test('account actions send the existing requests and return status without secrets', async (t) => {
+  for (const action of ['login', 'register'] as const) {
+    await t.test(action, async () => {
+      const request = t.mock.method(globalThis, 'fetch', async (url, options) => {
+        assert.ok(String(url).endsWith(`/api/${action}`));
+        assert.equal(options?.method, 'POST');
+        assert.deepEqual(JSON.parse(String(options?.body)), credentials);
+        return new Response(JSON.stringify({ token: 'private-token' }));
+      });
+      const result = await submitAccount(action, credentials);
+      assert.equal(result.success, true);
+      assert.equal(typeof result.message, 'string');
+      assert.ok(!JSON.stringify(result).includes('private-token'));
+      assert.ok(!JSON.stringify(result).includes(credentials.password));
+      assert.equal(request.mock.callCount(), 1);
+      request.mock.restore();
+    });
+  }
+});
+
+test('invalid tool inputs never reach the account API', async (t) => {
+  const request = t.mock.method(globalThis, 'fetch', async () => {
+    throw new Error('Should not fetch');
+  });
+  for (const input of [null, {}, { username: 'reader' }, { username: 123, password: 'x' }, { ...credentials, password: '' }]) {
+    // Exercise runtime input validation rather than TypeScript's compile-time shape.
+    const result = await submitAccount('login', input as typeof credentials);
+    assert.equal(result.success, false);
+  }
+  assert.equal(request.mock.callCount(), 0);
+});
+
+test('backend rejection, malformed response, network failure and cancellation return failure', async (t) => {
+  const request = t.mock.method(globalThis, 'fetch');
+  request.mock.mockImplementation(async () => new Response(JSON.stringify({ error: 'APP_ERR_2001' }), { status: 401 }));
+  assert.deepEqual(await submitAccount('login', credentials), {
+    success: false, message: 'Login failed: APP_ERR_2001',
+  });
+  request.mock.mockImplementation(async () => new Response('not json'));
+  assert.equal((await submitAccount('register', credentials)).success, false);
+  request.mock.mockImplementation(async () => { throw new TypeError('Failed to fetch'); });
+  assert.equal((await submitAccount('login', credentials)).success, false);
+  const controller = new AbortController();
+  controller.abort();
+  request.mock.mockImplementation(async (_url, options) => {
+    assert.equal(options?.signal, controller.signal);
+    options?.signal?.throwIfAborted();
+    throw new Error('Expected abort');
+  });
+  assert.deepEqual(await submitAccount('login', credentials, controller.signal), {
+    success: false, message: 'Submission cancelled.',
+  });
+});
+
+test('WebMCP registration invokes the supplied handler and unregisters with the component lifecycle', async (t) => {
+  const tool = {
+    name: 'test_account', description: 'Test account action', inputSchema: { type: 'object' },
+    execute: async (input: unknown) => ({ success: true, input }),
+  };
+  let signal: AbortSignal | undefined;
+  let registered: typeof tool | undefined;
+  t.mock.property(globalThis, 'document', { modelContext: {
+    registerTool(value: typeof tool, options: { signal: AbortSignal }) {
+      registered = value;
+      signal = options.signal;
+    },
+  } });
+  const cleanup = registerAgentTool(tool);
+  assert.equal(registered, tool);
+  assert.deepEqual(await registered!.execute({ username: 'reader' }), { success: true, input: { username: 'reader' } });
+  assert.equal(signal?.aborted, false);
+  cleanup();
+  assert.equal(signal?.aborted, true);
+});
+
+test('absent WebMCP is a no-op and legacy registrations are removed', (t) => {
+  t.mock.property(globalThis, 'document', {});
+  const tool = { name: 'test_account', description: '', inputSchema: {}, execute: async () => ({}) };
+  assert.doesNotThrow(() => registerAgentTool(tool)());
+  let removed = '';
+  t.mock.property(globalThis, 'navigator', { modelContext: {
+    registerTool() {},
+    unregisterTool(name: string) { removed = name; },
+  } });
+  registerAgentTool(tool)();
+  assert.equal(removed, tool.name);
+});
