diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..df7cfcd
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,12 @@
+// Keep preview WebMCP event types local until they are included in lib.dom.
+type AgentSubmitEvent = Event & {
+  agentInvoked?: boolean;
+  respondWith?: (response: Promise<string>) => void;
+};
+
+export function respondToAgent(event: Event, result: Promise<string>) {
+  const agentEvent = event as AgentSubmitEvent;
+  if (agentEvent.agentInvoked && typeof agentEvent.respondWith === 'function') {
+    agentEvent.respondWith(result);
+  }
+}
