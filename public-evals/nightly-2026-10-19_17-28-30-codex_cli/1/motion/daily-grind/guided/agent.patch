+  <script>
+    // Reveal once per visit, without scroll listeners or hidden fallback content.
+    (() => {
+      const preference = window.matchMedia('(prefers-reduced-motion: no-preference)');
+      const targets = document.querySelectorAll('main h2, .card, footer');
+      const revealed = new WeakSet();
+      const running = new Set();
+      let observer;
+
+      function syncMotion() {
+        observer?.disconnect();
+        for (const animation of running) animation.cancel();
+        running.clear();
+
+        if (!preference.matches || !('IntersectionObserver' in window) ||
+            !('animate' in Element.prototype)) return;
+
+        observer = new IntersectionObserver((entries) => {
+          for (const entry of entries) {
+            if (!entry.isIntersecting) continue;
+            const target = entry.target;
+            observer.unobserve(target);
+            if (revealed.has(target) || !preference.matches) continue;
+            revealed.add(target);
+
+            // Only stagger cards arriving together, keeping the delay bounded.
+            const cardIndex = target.matches('.card')
+              ? [...target.parentElement.children].indexOf(target) : 0;
+            const animation = target.animate([
+              { opacity: 0, translate: '0 18px' },
+              { opacity: 1, translate: '0 0' }
+            ], {
+              duration: 520,
+              delay: Math.min(cardIndex, 3) * 70,
+              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
+              fill: 'backwards'
+            });
+            running.add(animation);
+            animation.onfinish = animation.oncancel = () => running.delete(animation);
+          }
+        }, { threshold: 0.12 });
+
+        for (const target of targets) {
+          if (!revealed.has(target)) observer.observe(target);
+        }
+      }
+
+      preference.addEventListener('change', syncMotion);
+      syncMotion();
+    })();
+  </script>
