+  <script>
+    const paymentForm = document.getElementById('payment-form');
+    const expiryInput = document.getElementById('card-expiry');
+    const paymentStatus = document.getElementById('payment-status');
+
+    function validateExpiry() {
+      expiryInput.setCustomValidity('');
+      if (!expiryInput.value || expiryInput.validity.patternMismatch) return;
+      const [month, year] = expiryInput.value.split('/').map(Number);
+      const now = new Date();
+      const expiry = new Date(2000 + year, month);
+      if (expiry <= now) {
+        expiryInput.setCustomValidity('Enter an expiry date that has not passed.');
+      }
+    }
+
+    expiryInput.addEventListener('blur', validateExpiry);
+    paymentForm.addEventListener('input', () => {
+      expiryInput.setCustomValidity('');
+      paymentStatus.textContent = '';
+    });
+    paymentForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      validateExpiry();
+      if (!paymentForm.reportValidity()) return;
+      paymentForm.reset();
+      paymentStatus.textContent = 'Payment details checked. This demo has not saved your card details or processed a payment.';
+    });
+  </script>
+
 </body>
 
