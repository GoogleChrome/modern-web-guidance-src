@@ -197,8 +252,22 @@
     </section>
   </main>
 
   <footer>
+    <section class="newsletter" aria-labelledby="newsletter-heading">
+      <h2 id="newsletter-heading">Fresh news, brewed for you</h2>
+      <p>Get coffee news and seasonal updates in your inbox.</p>
+      <form id="newsletter-form" novalidate>
+        <label for="newsletter-email">Email address</label>
+        <div class="newsletter-fields">
+          <input id="newsletter-email" name="email" type="email" autocomplete="email"
+            placeholder="you@example.com" required aria-describedby="newsletter-error">
+          <button class="btn" type="submit">Sign up</button>
+        </div>
