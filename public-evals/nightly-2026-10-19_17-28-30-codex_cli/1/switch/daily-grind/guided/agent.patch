+            }
+            // Check descendants
+            const nestedSwitches = node.querySelectorAll
+              ? node.querySelectorAll('input[type="checkbox"][switch]')
+              : [];
+            nestedSwitches.forEach(upgradeSwitch);
+          }
+        });
+      }
+    });
+  });
