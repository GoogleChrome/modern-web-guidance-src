@@ -0,0 +1,85 @@
+const storageKey = 'daily-grind-preferences-v1';
+const form = document.querySelector('#preferences-form');
+const switches = [...form.querySelectorAll('input[switch]')];
+const defaults = Object.fromEntries(switches.map(input => [input.id, input.defaultChecked]));
+const status = document.querySelector('#announcement');
+const saveText = document.querySelector('#save-indicator span');
+let saved;
+try { saved = JSON.parse(localStorage.getItem(storageKey)); } catch { /* Storage can be unavailable in private contexts. */ }
+
+function renderPreferences() {
+  switches.forEach(input => {
+    input.nextElementSibling.textContent = input.checked ? 'On' : 'Off';
+  });
+  document.documentElement.classList.toggle('reduced-motion', document.querySelector('#reduced-motion').checked);
+}
+switches.forEach(input => {
+  if (saved && typeof saved[input.id] === 'boolean') input.checked = saved[input.id];
+  else if (input.id === 'reduced-motion') input.checked = matchMedia('(prefers-reduced-motion: reduce)').matches;
+});
+renderPreferences();
+
+function savePreferences(message) {
+  renderPreferences();
+  try {
+    localStorage.setItem(storageKey, JSON.stringify(Object.fromEntries(switches.map(input => [input.id, input.checked]))));
+    saveText.textContent = 'All changes saved';
+    status.textContent = message;
+  } catch {
+    saveText.textContent = 'Saved for this visit';
+    status.textContent = 'Preferences applied. Browser storage is unavailable, so these changes will only last for this visit.';
+  }
+}
+form.addEventListener('change', () => savePreferences('Preferences saved on this device.'));
+form.addEventListener('submit', event => event.preventDefault());
+document.querySelector('#reset-preferences').addEventListener('click', () => {
+  switches.forEach(input => { input.checked = input.id === 'reduced-motion' ? matchMedia('(prefers-reduced-motion: reduce)').matches : defaults[input.id]; });
+  savePreferences('Default preferences restored and saved.');
+});
+
+// Load the bundled, MIT-licensed fallback only where the native switch is unavailable.
+if (!('switch' in HTMLInputElement.prototype)) {
+  import('./vendor/input-switch-polyfill.js').catch(() => {
+    switches.forEach(input => input.setAttribute('role', 'switch'));
+  });
+}
+
+const viewContent = {
+  profile: ['My profile', '<h2>A familiar face.</h2><p>Your little corner of The Daily Grind.</p><div class="detail-row"><span>Name</span><strong>Jamie Davis</strong></div><div class="detail-row"><span>Member since</span><strong>2024</strong></div><p>Manage how we keep in touch in your preferences.</p>'],
+  orders: ['My orders', '<h2>Your next good cup awaits.</h2><p>You don’t have any orders yet. Pop into your local café to find a new favourite.</p><button class="primary-button" data-info="menu">Explore our menu</button>'],
+  rewards: ['Grind rewards', '<h2>Little sips. Lovely perks.</h2><p>Thanks for making us part of your daily.</p><div class="detail-row"><span>Your points</span><strong>240 points</strong></div><div class="detail-row"><span>Next reward</span><strong>Free coffee at 300 points</strong></div><p>Just 60 more points until your next cup is on us. Ask your barista to add points when you visit.</p>']
+};
+function setView(view) {
+  const isPreferences = view === 'preferences';
+  document.querySelector('#preferences-view').hidden = !isPreferences;
+  const other = document.querySelector('#other-view');
+  other.hidden = isPreferences;
+  if (!isPreferences && viewContent[view]) other.innerHTML = viewContent[view][1];
+  const title = isPreferences ? 'Preferences' : viewContent[view][0];
+  document.querySelector('#breadcrumb-current').textContent = title;
+  document.title = `${title} | The Daily Grind`;
+  document.querySelectorAll('.account-nav button').forEach(button => {
+    if (button.dataset.view === view) button.setAttribute('aria-current', 'page');
+    else button.removeAttribute('aria-current');
+  });
+}
+const info = {
+  menu: ['Find your new favourite.', '<p>Thoughtfully sourced. Freshly made.</p><div class="detail-row"><span>Maple Oat Latte</span><strong>$5.50</strong></div><div class="detail-row"><span>Dark Roast Espresso</span><strong>$3.00</strong></div><div class="detail-row"><span>Slow-Steeped Cold Brew</span><strong>$4.50</strong></div><p>Visit us in café to order. Your barista will make it just how you like it.</p>'],
+  story: ['Good coffee. Better days.', '<p>The Daily Grind began with a simple idea: a good cup of coffee can make an ordinary day feel a little brighter.</p><p>Since 2024, we’ve been bringing people together over ethically sourced beans, locally roasted coffee, and a warm welcome.</p>'],
+  locations: ['Come on in.', '<p>Our café directory is coming soon. In the meantime, stop by your local Daily Grind and say hello. We’ll have a fresh cup waiting.</p>'],
+  help: ['A little help with your daily.', '<p>Questions about your preferences? Your changes save automatically on this device. You can reset them at any time.</p><p>For coffee and reward questions, your local barista is always happy to help.</p>'],
+  privacy: ['Your preferences. Your choice.', '<p>This demo saves your preferences only in this browser, on this device. It doesn’t send your choices to a server or enrol you in email communications.</p><p>You can change any switch or reset to defaults whenever you like. Clearing your browser’s site data also removes your saved preferences.</p>']
+};
+const dialog = document.querySelector('#info-dialog');
+document.addEventListener('click', event => {
+  const viewButton = event.target.closest('[data-view]');
+  if (viewButton) setView(viewButton.dataset.view);
+  const infoButton = event.target.closest('[data-info]');
+  if (infoButton) {
+    const content = info[infoButton.dataset.info];
+    document.querySelector('#dialog-title').textContent = content[0];
+    document.querySelector('#dialog-content').innerHTML = content[1];
+    dialog.showModal();
+  }
+  if (event.target.closest('.dialog-close, .dialog-done')) dialog.close();
+});
