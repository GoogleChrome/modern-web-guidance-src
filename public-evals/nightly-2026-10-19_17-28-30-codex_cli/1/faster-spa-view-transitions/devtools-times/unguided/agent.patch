diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..27e9ffd
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,34 @@
+import { ViewCache } from "../utils/view-cache";
+
+const selector = "[data-view-cache]";
+let host = document.querySelector<HTMLElement>(selector);
+let cache = host ? new ViewCache(host) : undefined;
+const submissions = new WeakSet<AbortSignal>();
+
+document.addEventListener("astro:before-preparation", (event) => {
+  if (event.formData) submissions.add(event.signal);
+});
+
+document.addEventListener("astro:before-swap", (event) => {
+  const incomingHost = event.newDocument.querySelector<HTMLElement>(selector);
+  const incoming = incomingHost?.firstElementChild as HTMLElement | null;
+  if (!incomingHost || !incoming || !host || !cache) return;
+
+  const swap = event.swap;
+  event.swap = () => {
+    // Mutate only once navigation commits. Astro still swaps the head, updates
+    // history, restores scroll, and runs the usual island/script lifecycle.
+    if (submissions.has(event.signal)) cache!.clear();
+    cache!.activate(incoming, submissions.has(event.signal)
+      || event.from.pathname + event.from.search === event.to.pathname + event.to.search);
+    swap();
+  };
+});
+
+document.addEventListener("astro:after-swap", () => {
+  const current = document.querySelector<HTMLElement>(selector);
+  if (current !== host) {
+    host = current;
+    cache = host ? new ViewCache(host) : undefined;
+  }
+});
diff --git a/src/utils/view-cache.ts b/src/utils/view-cache.ts
new file mode 100644
index 0000000..74704da
--- /dev/null
+++ b/src/utils/view-cache.ts
@@ -0,0 +1,59 @@
+/** Keeps the actual view nodes, including hydrated islands, in a persistent host. */
+export class ViewCache {
+  private views = new Map<string, HTMLElement>();
+  private active: HTMLElement;
+  private host: HTMLElement;
+  private limit: number;
+
+  constructor(host: HTMLElement, limit = 5) {
+    if (limit < 1) throw new RangeError("A view cache must hold at least one view");
+    this.host = host;
+    this.limit = limit;
+    this.active = host.firstElementChild as HTMLElement;
+    this.remember(this.active);
+  }
+
+  private remember(view: HTMLElement) {
+    if (view.dataset.viewCacheable === "true") {
+      this.views.set(view.dataset.viewKey!, view);
+    }
+  }
+
+  activate(incoming: HTMLElement, refresh = false) {
+    const key = incoming.dataset.viewKey!;
+    const cached = !refresh && incoming.dataset.viewCacheable === "true"
+      ? this.views.get(key)
+      : undefined;
+    const next = cached || incoming;
+
+    if (this.active !== next) {
+      this.active.hidden = true;
+      this.active.inert = true;
+      // Leaving an account form discards its DOM and any entered credentials.
+      if (this.active.dataset.viewCacheable !== "true") this.active.remove();
+    }
+
+    const previous = this.views.get(key);
+    if (previous && previous !== next) previous.remove();
+    this.views.delete(key);
+    this.remember(next); // Move the active view to the end of the LRU cache.
+    next.hidden = false;
+    next.inert = false;
+    if (next.parentElement !== this.host) this.host.append(next);
+    this.active = next;
+
+    while (this.views.size > this.limit) {
+      const oldest = this.views.keys().next().value!;
+      this.views.get(oldest)!.remove();
+      this.views.delete(oldest);
+    }
+  }
+
+  clear() {
+    for (const view of this.views.values()) {
+      if (view !== this.active) view.remove();
+    }
+    this.views.clear();
+    this.active.dataset.viewCacheable = "false";
+  }
+}
diff --git a/tests/view-cache.test.mjs b/tests/view-cache.test.mjs
new file mode 100644
index 0000000..ec2f1b9
--- /dev/null
+++ b/tests/view-cache.test.mjs
@@ -0,0 +1,92 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { parseHTML } from 'linkedom';
+import { ViewCache } from '../src/utils/view-cache.ts';
+
+function setup(limit = 5) {
+  const { document } = parseHTML('<html><body><div data-view-cache></div></body></html>');
+  const host = document.querySelector('[data-view-cache]');
+  const view = (key, cacheable = true) => {
+    const main = document.createElement('main');
+    main.dataset.viewKey = key;
+    main.dataset.viewCacheable = String(cacheable);
+    main.innerHTML = '<input><button>Click</button>';
+    return main;
+  };
+  const first = view('/');
+  host.append(first);
+  return { host, first, view, cache: new ViewCache(host, limit) };
+}
+
+test('revisiting reuses the exact DOM, input state, and event listeners', () => {
+  const { host, first, view, cache } = setup();
+  const input = first.querySelector('input');
+  input.value = 'preserved';
+  let clicks = 0;
+  first.querySelector('button').addEventListener('click', () => clicks++);
+  const second = view('/article');
+  cache.activate(second);
+  assert.equal(first.isConnected, true);
+  assert.equal(first.hidden, true);
+  assert.equal(first.inert, true);
+  cache.activate(view('/'));
+  assert.equal(host.querySelector('main:not([hidden])'), first);
+  assert.equal(first.querySelector('input'), input);
+  assert.equal(input.value, 'preserved');
+  first.querySelector('button').click();
+  assert.equal(clicks, 1);
+  assert.equal(first.inert, false);
+  assert.equal(second.hidden, true);
+});
+
+test('evicts the least recently used view and keeps the active view', () => {
+  const { host, first, view, cache } = setup(2);
+  const second = view('/two');
+  cache.activate(second);
+  cache.activate(view('/'));
+  cache.activate(view('/three'));
+  assert.equal(second.isConnected, false);
+  assert.equal(first.isConnected, true);
+  assert.equal(host.children.length, 2);
+  const replacement = view('/two');
+  cache.activate(replacement);
+  assert.equal(replacement.hidden, false);
+  assert.equal(first.isConnected, false);
+});
+
+test('query strings identify separate views', () => {
+  const { host, view, cache } = setup();
+  const pageOne = view('/search?q=one');
+  const pageTwo = view('/search?q=two');
+  cache.activate(pageOne);
+  cache.activate(pageTwo);
+  cache.activate(view('/search?q=one'));
+  assert.equal(host.querySelector('main:not([hidden])'), pageOne);
+  assert.equal(pageTwo.hidden, true);
+});
+
+test('uncacheable account forms are discarded on leaving', () => {
+  const { host, view, cache } = setup();
+  const signin = view('/signin', false);
+  cache.activate(signin);
+  signin.querySelector('input').value = 'secret';
+  cache.activate(view('/'));
+  assert.equal(signin.isConnected, false);
+  const fresh = view('/signin', false);
+  cache.activate(fresh);
+  assert.equal(host.querySelector('main:not([hidden])'), fresh);
+  assert.equal(fresh.querySelector('input').value, '');
+});
+
+test('refresh replaces cached content and clearing invalidates all previous views', () => {
+  const { host, first, view, cache } = setup();
+  cache.activate(view('/two'));
+  const refreshed = view('/');
+  cache.activate(refreshed, true);
+  assert.equal(first.isConnected, false);
+  assert.equal(host.querySelector('main:not([hidden])'), refreshed);
+  cache.clear();
+  cache.activate(view('/new'));
+  assert.equal(refreshed.isConnected, false);
+  assert.equal(host.children.length, 1);
+});
