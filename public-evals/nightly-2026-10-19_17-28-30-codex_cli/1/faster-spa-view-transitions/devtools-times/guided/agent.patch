diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..9b672c4
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,67 @@
+import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
+
+const MAX_VIEWS = 5;
+const PERSIST_ATTRIBUTE = "data-astro-transition-persist";
+
+/** Keep the five most recently used route DOM trees, including the active view. */
+export function installViewCache(doc: Document) {
+  let focusAfterSwap = false;
+
+  doc.addEventListener("astro:before-swap", (event) => {
+    const transition = event as TransitionBeforeSwapEvent;
+    const swap = transition.swap;
+
+    // Mutate only once Astro commits the navigation, not during preparation.
+    transition.swap = () => {
+      const host = doc.querySelector<HTMLElement>("[data-view-host]");
+      const nextHost = transition.newDocument.querySelector<HTMLElement>("[data-view-host]");
+      const incoming = nextHost?.querySelector<HTMLElement>("[data-view-key]");
+      if (!host || !nextHost || !incoming) {
+        swap();
+        return;
+      }
+
+      const views = Array.from(host.children) as HTMLElement[];
+      const key = incoming.dataset.viewKey;
+      // A navigation to the current URL should still be able to refresh its data.
+      const sameRoute = transition.from.pathname + transition.from.search === key;
+      const cached = sameRoute ? undefined : views.find((view) => view.dataset.viewKey === key);
+      const active = cached ?? incoming;
+      const retained = views.filter((view) => view !== active && view.dataset.viewKey !== key);
+      // DOM order records recency: oldest first, active last. Omitted views are
+      // removed by Astro's normal swap, including React island cleanup.
+      const keep = [...retained.slice(-(MAX_VIEWS - 1)), active];
+
+      for (const view of views) {
+        if (!keep.includes(view)) view.removeAttribute(PERSIST_ATTRIBUTE);
+      }
+
+      for (const view of keep) {
+        const inactive = view !== active;
+        view.classList.toggle("is-inactive", inactive);
+        view.inert = inactive;
+        view.setAttribute("aria-hidden", String(inactive));
+      }
+
+      // Give Astro a matching placeholder for each retained DOM tree. Its native
+      // persistence transfer preserves islands, listeners and media state while
+      // still handling the new page's head, scripts and browser history.
+      nextHost.replaceChildren(...keep.map((view) => {
+        if (view === incoming) return incoming;
+        const placeholder = transition.newDocument.createElement("div");
+        placeholder.setAttribute(PERSIST_ATTRIBUTE, view.getAttribute(PERSIST_ATTRIBUTE)!);
+        return placeholder;
+      }));
+
+      swap();
+      focusAfterSwap = true;
+    };
+  });
+
+  doc.addEventListener("astro:after-swap", () => {
+    if (!focusAfterSwap) return;
+    focusAfterSwap = false;
+    doc.querySelector<HTMLElement>("[data-view-host] > .spa-view:not(.is-inactive)")
+      ?.focus({ preventScroll: true });
+  });
+}
