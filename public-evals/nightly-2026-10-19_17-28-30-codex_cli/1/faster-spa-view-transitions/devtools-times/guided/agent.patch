+
+/* Retain inactive route layout state without painting or occupying page space. */
+.spa-view.is-inactive {
+  content-visibility: hidden;
+  contain-intrinsic-size: none;
+  position: absolute;
+  inset: 0 0 auto;
+  block-size: 0;
+  overflow: clip;
+  pointer-events: none;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.is-inactive {
+    display: none;
+  }
+}
diff --git a/tests/view-cache.test.mjs b/tests/view-cache.test.mjs
new file mode 100644
index 0000000..85d27f6
--- /dev/null
+++ b/tests/view-cache.test.mjs
@@ -0,0 +1,117 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Window } from 'happy-dom';
+import { installViewCache } from '../src/scripts/view-cache.ts';
+
+const origin = 'https://example.test';
+const persist = 'data-astro-transition-persist';
+
+function markup(key) {
+  return `<main data-view-host><div class="spa-view" tabindex="-1"
+    data-view-key="${key}" ${persist}="view-${encodeURIComponent(key)}">
+    <input value="initial"><button>Open</button></div></main>`;
+}
+
+function setup(key = '/news') {
+  const window = new Window({ url: origin + key });
+  const doc = window.document;
+  doc.body.innerHTML = markup(key);
+  installViewCache(doc);
+  let current = key;
+
+  function navigate(to, html = markup(to)) {
+    const next = new window.DOMParser().parseFromString(html, 'text/html');
+    const incoming = next.querySelector('.spa-view');
+    const event = new window.Event('astro:before-swap');
+    Object.assign(event, {
+      from: new URL(current, origin),
+      to: new URL(to, origin),
+      newDocument: next,
+      swap() {
+        // Emulate Astro's documented transition:persist transfer contract.
+        // History, styles and script loading stay the router's responsibility.
+        for (const view of doc.querySelectorAll(`[${persist}]`)) {
+          const placeholder = next.querySelector(`[${persist}="${view.getAttribute(persist)}"]`);
+          placeholder?.replaceWith(view);
+        }
+        doc.body.replaceWith(next.body);
+      },
+    });
+    doc.dispatchEvent(event);
+    event.swap();
+    current = to;
+    doc.dispatchEvent(new window.Event('astro:after-swap'));
+    return incoming;
+  }
+
+  const active = () => doc.querySelector('.spa-view:not(.is-inactive)');
+  return { window, doc, navigate, active };
+}
+
+test('returning to a route restores the original DOM, form state and listeners', () => {
+  const { doc, navigate, active } = setup();
+  const original = active();
+  original.querySelector('input').value = 'edited';
+  let clicks = 0;
+  original.querySelector('button').addEventListener('click', () => clicks++);
+
+  navigate('/reports');
+  assert.equal(original.isConnected, true);
+  assert.equal(original.classList.contains('is-inactive'), true);
+  assert.equal(original.inert, true);
+  assert.equal(original.getAttribute('aria-hidden'), 'true');
+
+  const discarded = navigate('/news');
+  assert.equal(active(), original);
+  assert.equal(discarded.isConnected, false);
+  assert.equal(original.querySelector('input').value, 'edited');
+  original.querySelector('button').click();
+  assert.equal(clicks, 1);
+  assert.equal(original.inert, false);
+  assert.equal(original.getAttribute('aria-hidden'), 'false');
+  assert.equal(doc.activeElement, original);
+});
+
+test('cache evicts the least recently used view and rebuilds it on its next visit', () => {
+  const { doc, navigate, active } = setup('/a');
+  const oldest = active();
+  navigate('/b');
+  const b = active();
+  navigate('/c');
+  navigate('/d');
+  navigate('/e');
+  navigate('/b'); // Refresh recency of B; A should be evicted next.
+  navigate('/f');
+  assert.equal(doc.querySelectorAll('.spa-view').length, 5);
+  assert.equal(oldest.isConnected, false);
+  assert.equal(b.isConnected, true);
+  assert.equal(doc.querySelectorAll('.spa-view:not(.is-inactive)').length, 1);
+  navigate('/a');
+  assert.notEqual(active(), oldest);
+  assert.equal(doc.querySelectorAll('.spa-view').length, 5);
+});
+
+test('query strings distinguish views; fragments share the same route DOM', () => {
+  const { navigate, active } = setup('/search?q=one');
+  const first = active();
+  navigate('/search?q=two');
+  assert.notEqual(active(), first);
+  navigate('/search?q=one#results', markup('/search?q=one'));
+  assert.equal(active(), first);
+});
+
+test('navigation to the current route refreshes its content', () => {
+  const { doc, navigate, active } = setup();
+  const original = active();
+  const incoming = navigate('/news');
+  assert.equal(active(), incoming);
+  assert.equal(original.isConnected, false);
+  assert.equal(doc.querySelectorAll('.spa-view').length, 1);
+});
+
+test('pages outside the cached layout use the normal swap', () => {
+  const { doc, navigate } = setup();
+  navigate('/other', '<main>Uncached page</main>');
+  assert.equal(doc.body.textContent, 'Uncached page');
+  assert.equal(doc.querySelector('[data-view-host]'), null);
+});
