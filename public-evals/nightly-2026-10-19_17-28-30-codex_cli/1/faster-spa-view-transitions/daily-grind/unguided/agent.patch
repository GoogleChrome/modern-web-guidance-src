+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { pathToFileURL } from 'node:url';
+
+export function createAppServer() {
+  return createServer(async (request, response) => {
+    if (request.method !== 'GET' && request.method !== 'HEAD') {
+      response.writeHead(405, { Allow: 'GET, HEAD' });
+      response.end();
+      return;
+    }
+    try {
+      const path = new URL(request.url, 'http://localhost').pathname;
+      const html = await readFile(new URL('./index.html', import.meta.url));
+      const routes = new Set(['/', ...[...html.toString().matchAll(/data-route="([^"]+)"/g)].map(match => match[1])]);
+      let body;
+      let type;
+      if (routes.has(path)) {
+        body = html;
+        type = 'text/html; charset=utf-8';
+      } else if (path === '/router.js') {
+        body = await readFile(new URL('./router.js', import.meta.url));
+        type = 'text/javascript; charset=utf-8';
+      } else {
+        response.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+        response.end(request.method === 'HEAD' ? undefined : 'Not found');
+        return;
+      }
+      response.writeHead(200, { 'Content-Type': type, 'Content-Length': body.length });
+      response.end(request.method === 'HEAD' ? undefined : body);
+    } catch {
+      response.writeHead(500);
+      response.end();
+    }
+  });
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  const port = Number(process.env.PORT || 11222);
+  createAppServer().listen(port, () => console.log(`The Daily Grind: http://localhost:${port}`));
+}
