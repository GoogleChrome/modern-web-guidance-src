+// Views stay attached to the document so returning to them reuses the same DOM.
+export function createRouter(document, window) {
+  const host = document.querySelector('#views');
+  const home = host.querySelector('[data-view="/"]');
+  const homeTitle = document.title;
+  const templates = new Map(
+    [...document.querySelectorAll('template[data-route]')].map(template => [
+      template.dataset.route, template,
+    ]),
+  );
+  const views = new Map([
+    ['/', { element: home, title: homeTitle, x: 0, y: 0 }],
+  ]);
+  let active = views.get('/');
+
+  function supports(path) {
+    return path === '/' || templates.has(path);
+  }
+
+  function show(url, remember = true) {
+    if (remember) {
+      active.x = window.scrollX;
+      active.y = window.scrollY;
+    }
+
+    let view = views.get(url.pathname);
+    if (!view) {
+      const template = templates.get(url.pathname);
+      const element = document.createElement('div');
+      element.dataset.view = url.pathname;
+      element.hidden = true;
+      element.append(template.content.cloneNode(true));
+      // Reuse the home menu's content when constructing the menu's first visit.
+      element.querySelector('[data-seasonal-menu]')?.append(
+        home.querySelector('.grid').cloneNode(true),
+      );
+      host.append(element);
+      view = { element, title: `${template.dataset.title} | The Daily Grind`, x: 0, y: 0 };
+      views.set(url.pathname, view);
+    }
+
+    active.element.hidden = true;
+    view.element.hidden = false;
+    active = view;
+    document.title = view.title;
+    for (const link of document.querySelectorAll('nav a')) {
+      if (new URL(link.href).pathname === url.pathname) {
+        link.setAttribute('aria-current', 'page');
+      } else {
+        link.removeAttribute('aria-current');
+      }
+    }
+    const heading = view.element.querySelector('h1');
+    if (heading) {
+      heading.setAttribute('tabindex', '-1');
+      heading.focus({ preventScroll: true });
+    }
+    const anchor = url.hash && document.getElementById(decodeURIComponent(url.hash.slice(1)));
+    if (anchor && view.element.contains(anchor)) {
+      anchor.scrollIntoView();
+    } else {
+      window.scrollTo(view.x, view.y);
+    }
+  }
+
+  function onClick(event) {
+    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+    const link = event.target.closest?.('a[href]');
+    if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self') || link.relList.contains('external')) return;
+    const url = new URL(link.href);
+    if (url.origin !== window.location.origin || !supports(url.pathname)) return;
+    // Keep native same-page fragment navigation and its browser history behavior.
+    if (url.pathname === window.location.pathname && url.search === window.location.search && url.hash) return;
+    event.preventDefault();
+    if (url.href === window.location.href) return;
+    window.history.pushState(null, '', url);
+    show(url);
+  }
+
+  function onPopState() {
+    const url = new URL(window.location.href);
+    if (supports(url.pathname)) show(url);
+    else window.location.reload();
+  }
+
+  if ('scrollRestoration' in window.history) window.history.scrollRestoration = 'manual';
+  document.addEventListener('click', onClick);
+  window.addEventListener('popstate', onPopState);
+  const initial = new URL(window.location.href);
+  if (supports(initial.pathname)) show(initial, false);
+}
+
+if (typeof document !== 'undefined') createRouter(document, window);
