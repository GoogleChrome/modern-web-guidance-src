+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createAppServer } from './server.js';
+
+test('SPA routes serve the app on direct requests and assets retain their content type', async t => {
+  const server = createAppServer();
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => new Promise(resolve => server.close(resolve)));
+  const base = `http://127.0.0.1:${server.address().port}`;
+  const home = await fetch(base);
+  const html = await home.text();
+  for (const path of ['/menu', '/menu/seasonal', '/menu/espresso', '/menu/cold-brew?ref=menu']) {
+    const response = await fetch(`${base}${path}`);
+    assert.equal(response.status, 200);
+    assert.equal(await response.text(), html);
+  }
+  const script = await fetch(`${base}/router.js`);
+  assert.equal(script.status, 200);
+  assert.match(script.headers.get('content-type'), /javascript/);
+  assert.match(await script.text(), /export function createRouter/);
+  const head = await fetch(`${base}/menu`, { method: 'HEAD' });
+  assert.equal(head.status, 200);
+  assert.equal(await head.text(), '');
+  assert.equal((await fetch(`${base}/missing`)).status, 404);
+  assert.equal((await fetch(`${base}/server.js`)).status, 404);
+  assert.equal((await fetch(`${base}/menu`, { method: 'POST' })).status, 405);
+});
