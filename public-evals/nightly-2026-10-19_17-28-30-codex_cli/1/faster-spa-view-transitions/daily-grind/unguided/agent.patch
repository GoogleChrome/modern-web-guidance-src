+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { test } from 'node:test';
+import { JSDOM } from 'jsdom';
+import { createRouter } from './router.js';
+
+const html = readFileSync(new URL('./index.html', import.meta.url), 'utf8');
+
+function setup(path = '/') {
+  const dom = new JSDOM(html, { url: `https://coffee.example${path}` });
+  const { window } = dom;
+  const { document } = window;
+  window.scrollTo = (x, y) => {
+    window.scrollX = x;
+    window.scrollY = y;
+  };
+  createRouter(document, window);
+
+  function click(href, options = {}) {
+    const link = [...document.querySelectorAll('a')].find(link =>
+      link.getAttribute('href') === href && !link.closest('[hidden], template'),
+    );
+    assert.ok(link, `Visible link to ${href}`);
+    let intercepted;
+    window.addEventListener('click', event => {
+      intercepted = event.defaultPrevented;
+      event.preventDefault(); // Suppress jsdom's unsupported document navigation.
+    }, { once: true });
+    link.dispatchEvent(new window.MouseEvent('click', { bubbles: true, cancelable: true, button: 0, ...options }));
+    return intercepted;
+  }
+
+  function traverse(direction) {
+    return new Promise(resolve => {
+      window.addEventListener('popstate', resolve, { once: true });
+      window.history[direction]();
+    });
+  }
+
+  return { dom, window, document, click, traverse };
+}
+
+test('return navigation preserves the exact DOM, input state, and listeners', t => {
+  const { dom, document, click } = setup();
+  t.after(() => dom.window.close());
+  const home = document.querySelector('[data-view="/"]');
+  const originalCard = home.querySelector('.card');
+  click('/menu');
+  const menu = document.querySelector('[data-view="/menu"]');
+  const input = document.createElement('input');
+  input.value = 'Oat milk';
+  menu.append(input);
+  let changes = 0;
+  input.addEventListener('change', () => changes++);
+
+  click('/menu/seasonal');
+  assert.equal(menu.hidden, true);
+  assert.equal(menu.isConnected, true);
+  click('/menu');
+  assert.equal(document.querySelector('[data-view="/menu"]'), menu);
+  assert.equal(menu.querySelector('input'), input);
+  assert.equal(input.value, 'Oat milk');
+  input.dispatchEvent(new dom.window.Event('change'));
+  assert.equal(changes, 1);
+  click('/');
+  assert.equal(home.querySelector('.card'), originalCard);
+  assert.equal(home.hidden, false);
+  assert.equal(menu.hidden, true);
+  assert.equal(document.querySelectorAll('[data-view]:not([hidden])').length, 1);
+});
+
+test('Back and Forward restore cached views, title, focus, and scroll', async t => {
+  const { dom, window, document, click, traverse } = setup();
+  t.after(() => window.close());
+  window.scrollTo(0, 240);
+  click('/menu');
+  const menu = document.querySelector('[data-view="/menu"]');
+  assert.equal(window.scrollY, 0);
+  window.scrollTo(0, 120);
+  click('/menu/espresso');
+  await traverse('back');
+  assert.equal(window.location.pathname, '/menu');
+  assert.equal(document.querySelector('[data-view="/menu"]'), menu);
+  assert.equal(window.scrollY, 120);
+  assert.equal(document.title, 'Menu | The Daily Grind');
+  assert.equal(document.activeElement, menu.querySelector('h1'));
+  assert.equal(document.querySelector('nav a[href="/menu"]').getAttribute('aria-current'), 'page');
+  await traverse('back');
+  assert.equal(window.scrollY, 240);
+  await traverse('forward');
+  assert.equal(window.scrollY, 120);
+  assert.equal(menu.hidden, false);
+});
+
+test('deep links initialize the correct view and repeated visits do not duplicate it', t => {
+  const { window, document, click } = setup('/menu/cold-brew');
+  t.after(() => window.close());
+  const coldBrew = document.querySelector('[data-view="/menu/cold-brew"]');
+  assert.equal(coldBrew.hidden, false);
+  assert.equal(document.querySelector('[data-view="/"]').hidden, true);
+  for (let i = 0; i < 3; i++) {
+    click('/menu');
+    click('/menu/cold-brew');
+  }
+  assert.equal(document.querySelectorAll('[data-view="/menu/cold-brew"]').length, 1);
+  assert.equal(document.querySelector('[data-view="/menu/cold-brew"]'), coldBrew);
+});
+
+test('modified clicks, downloads, external links, and unsupported routes keep native behavior', t => {
+  const { window, document, click } = setup();
+  t.after(() => window.close());
+  assert.equal(click('/menu', { ctrlKey: true }), false);
+  assert.equal(click('/menu', { metaKey: true }), false);
+  assert.equal(click('/menu', { button: 1 }), false);
+  assert.equal(click('/locations'), false);
+  assert.equal(click('/logout'), false);
+  const link = document.querySelector('a[href="/menu"]');
+  link.target = '_blank';
+  assert.equal(click('/menu'), false);
+  link.removeAttribute('target');
+  link.setAttribute('download', 'menu');
+  assert.equal(click('/menu'), false);
+  link.removeAttribute('download');
+  link.href = 'https://other.example/menu';
+  assert.equal(click('https://other.example/menu'), false);
+  assert.equal(window.location.pathname, '/');
+});
