+  <script>
+    const routes = new Map([
+      ['/', { title: 'Home' }],
+      ['/menu', { title: 'Our Menu', template: 'menu' }],
+      ['/locations', { title: 'Locations', template: 'locations' }],
+      ['/rewards', { title: 'Rewards', template: 'rewards' }],
+      ['/menu/seasonal', {
+        title: 'Maple Oat Latte', template: 'product',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.'
+      }],
+      ['/menu/espresso', {
+        title: 'Dark Roast Espresso', template: 'product',
+        description: 'Bold, smokey, and perfect for a morning boost.'
+      }],
+      ['/menu/cold-brew', {
+        title: 'Cold Brew', template: 'product',
+        description: 'Steeped for 18 hours for maximum smoothness.'
+      }]
+    ]);
+    const views = document.getElementById('views');
+    // Only these seven fixed routes can create views, so the cache is bounded.
+    const cache = new Map([['/', document.getElementById('home-view')]]);
+    let activePath = '/';
+
+    function getView(path) {
+      if (cache.has(path)) return cache.get(path);
+
+      const route = routes.get(path);
+      const view = document.createElement('section');
+      view.className = 'spa-view';
+      view.tabIndex = -1;
+      view.append(document.getElementById(`${route.template}-template`).content.cloneNode(true));
+      const heading = view.querySelector('h1');
+      if (route.template === 'product') {
+        heading.id = `product-${path.split('/').pop()}-title`;
+        heading.textContent = route.title;
+        view.querySelector('p').textContent = route.description;
+      }
+      view.setAttribute('aria-labelledby', heading.id);
+      views.append(view);
+      cache.set(path, view);
+      return view;
+    }
+
+    function navigate({ initial = false } = {}) {
+      const requestedPath = window.location.hash.slice(1) || '/';
+      const path = routes.has(requestedPath) ? requestedPath : '/';
+      if (!routes.has(requestedPath)) {
+        history.replaceState(null, '', `${location.pathname}${location.search}#/`);
+      }
+      if (!initial && path === activePath) return;
+
+      const nextView = getView(path);
+      // Move focus before making the previous view inert and aria-hidden.
+      nextView.classList.remove('inactive');
+      nextView.inert = false;
+      nextView.removeAttribute('aria-hidden');
+      if (!initial || path !== '/') nextView.focus({ preventScroll: true });
+
+      for (const [cachedPath, view] of cache) {
+        if (cachedPath === path) continue;
+        view.inert = true;
+        view.setAttribute('aria-hidden', 'true');
+        view.classList.add('inactive');
+      }
+      activePath = path;
+      document.title = `${routes.get(path).title} | The Daily Grind`;
+      for (const link of document.querySelectorAll('nav a[href^="#/"]')) {
+        const linkPath = link.hash.slice(1);
+        const current = linkPath === path || (linkPath === '/menu' && path.startsWith('/menu/'));
+        if (current) link.setAttribute('aria-current', 'page');
+        else link.removeAttribute('aria-current');
+      }
+      if (!initial) window.scrollTo(0, 0);
+    }
+
+    // Hash routes also work on static hosts without a server-side SPA rewrite.
+    window.addEventListener('hashchange', () => navigate());
+    navigate({ initial: true });
+  </script>
+
