     .btn:hover {
       background: #3e2723;
     }
 
+    .card-actions {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 10px;
+      margin-top: 15px;
+    }
+
+    .card-actions .btn {
+      margin-top: 0;
+    }
+
+    .info-button {
+      anchor-name: --maple-info;
+      display: inline-grid;
+      place-items: center;
+      width: 32px;
+      height: 32px;
+      border: 1px solid var(--primary);
+      border-radius: 50%;
+      background: transparent;
+      color: var(--primary);
+      font: italic bold 1rem Georgia, serif;
+      cursor: pointer;
+    }
+
+    .info-button:hover {
+      background: var(--secondary);
+    }
+
+    .info-button:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .latte-tooltip {
+      position: fixed;
+      position-anchor: --maple-info;
+      position-area: top;
+      position-try-fallbacks: flip-block;
+      container-type: anchored;
+      container-name: maple-tooltip;
+      inset: auto;
+      width: min(17rem, calc(100vw - 24px));
+      margin: 0;
+      padding: 0;
+      border: 0;
+      overflow: visible;
+      background: transparent;
+      color: white;
+      text-align: left;
+      font-size: 0.875rem;
+    }
+
+    /* Style a child: anchored queries cannot restyle their own container. */
+    .latte-tooltip-content {
+      position: relative;
+      margin: 0 0 12px;
+      padding: 14px 16px;
+      border-radius: 12px 12px 6px 6px;
+      background: var(--primary);
+      box-shadow: 0 4px 14px rgb(0 0 0 / 18%);
+    }
+
+    .latte-tooltip-content::after {
+      content: "";
+      position: absolute;
+      top: 100%;
+      left: 50%;
+      transform: translateX(-50%);
+      border: 7px solid transparent;
+      border-bottom-width: 0;
+      border-top-color: var(--primary);
+    }
+
+    @container maple-tooltip anchored(fallback: flip-block) {
+      .latte-tooltip-content {
+        margin: 12px 0 0;
+        border-radius: 6px 6px 12px 12px;
+      }
+
+      .latte-tooltip-content::after {
+        top: auto;
+        bottom: 100%;
+        border-top: 0;
+        border-bottom: 7px solid var(--primary);
+      }
+    }
+
