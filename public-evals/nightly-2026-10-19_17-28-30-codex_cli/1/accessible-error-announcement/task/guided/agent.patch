+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterStatus = document.getElementById('newsletter-status');
+
+    const syncNewsletterAria = () => {
+      newsletterEmail.setAttribute('aria-invalid', String(newsletterEmail.matches(':user-invalid')));
+    };
+
+    const scheduleNewsletterAria = () => {
+      // Read after the browser has applied the event's native validation state.
+      requestAnimationFrame(syncNewsletterAria);
+    };
+
+    for (const eventName of ['blur', 'input', 'change', 'invalid']) {
+      newsletterEmail.addEventListener(eventName, scheduleNewsletterAria);
+    }
+
+    newsletterEmail.addEventListener('input', () => {
+      newsletterStatus.textContent = '';
+    });
+
+    newsletterForm.addEventListener('reset', () => {
+      newsletterStatus.textContent = '';
+      scheduleNewsletterAria();
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      syncNewsletterAria();
+      // Connect the newsletter provider here when a signup endpoint is available.
+      newsletterStatus.textContent = 'Newsletter signup is currently unavailable. Please try again later.';
+    });
+  </script>
+
 </body>
 
