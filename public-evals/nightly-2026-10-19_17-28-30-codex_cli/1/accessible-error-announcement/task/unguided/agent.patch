+  <script>
+    const newsletterForm = document.querySelector('.newsletter');
+    const newsletterEmail = document.querySelector('#newsletter-email');
+    const newsletterStatus = document.querySelector('.newsletter-status');
+
+    function syncNewsletterValidity() {
+      newsletterEmail.setAttribute('aria-invalid', String(newsletterEmail.matches(':user-invalid')));
+    }
+
+    function scheduleNewsletterValiditySync() {
+      // Read after the browser has updated its user-interaction validation state.
+      requestAnimationFrame(syncNewsletterValidity);
+    }
+
+    for (const event of ['blur', 'input', 'change', 'invalid']) {
+      newsletterEmail.addEventListener(event, scheduleNewsletterValiditySync);
+    }
+
+    newsletterEmail.addEventListener('input', () => {
+      newsletterStatus.textContent = '';
+    });
+
+    newsletterForm.addEventListener('reset', () => {
+      newsletterStatus.textContent = '';
+      scheduleNewsletterValiditySync();
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      syncNewsletterValidity();
+      // Replace this message with a request when a newsletter endpoint is available.
+      newsletterStatus.textContent = 'Newsletter signup is coming soon. Please check back later.';
+    });
+  </script>
+
