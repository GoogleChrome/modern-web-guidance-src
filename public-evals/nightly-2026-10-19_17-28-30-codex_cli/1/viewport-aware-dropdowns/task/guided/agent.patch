+  <script type="module">
+    // Older browsers only: emulate popover invocation and light dismissal.
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@0.6.1/dist/popover.min.js");
+    }
+
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+    const hasAnchors = CSS.supports('position-anchor', '--options-trigger') &&
+      CSS.supports('position-area', 'block-end span-inline-end') &&
+      CSS.supports('position-try-fallbacks', 'flip-block, flip-inline, flip-block flip-inline');
+    let isOpen = false;
+
+    function positionPanel() {
+      if (!isOpen) return;
+      panel.classList.remove('positioned-fallback');
+      const bounds = panel.getBoundingClientRect();
+      const viewport = window.visualViewport;
+      const leftEdge = (viewport?.offsetLeft ?? 0) + 8;
+      const topEdge = (viewport?.offsetTop ?? 0) + 8;
+      const rightEdge = leftEdge + (viewport?.width ?? window.innerWidth) - 16;
+      const bottomEdge = topEdge + (viewport?.height ?? window.innerHeight) - 16;
+
+      if (hasAnchors && bounds.left >= leftEdge && bounds.right <= rightEdge &&
+          bounds.top >= topEdge && bounds.bottom <= bottomEdge) return;
+
+      // Flip independently on each axis, then constrain oversized panels.
+      const anchor = trigger.getBoundingClientRect();
+      const below = Math.max(0, bottomEdge - anchor.bottom);
+      const above = Math.max(0, anchor.top - topEdge);
+      const flipUp = bounds.height > below && above > below;
+      const available = flipUp ? above : below;
+      const height = Math.min(bounds.height, available);
+      const width = Math.min(bounds.width, rightEdge - leftEdge);
+      let left = anchor.left;
+      if (left + width > rightEdge) left = anchor.right - width;
+      left = Math.max(leftEdge, Math.min(left, rightEdge - width));
+      const top = Math.max(topEdge, Math.min(
+        flipUp ? anchor.top - height : anchor.bottom, bottomEdge - height
+      ));
+      panel.style.setProperty('--panel-left', `${left}px`);
+      panel.style.setProperty('--panel-top', `${top}px`);
+      panel.style.setProperty('--panel-height', `${available}px`);
+      panel.classList.add('positioned-fallback');
+    }
+
+    panel.addEventListener('beforetoggle', (event) => {
+      isOpen = event.newState === 'open';
+      if (isOpen) requestAnimationFrame(positionPanel);
+    });
+    window.addEventListener('resize', positionPanel);
+    document.addEventListener('scroll', positionPanel, true);
+    window.visualViewport?.addEventListener('resize', positionPanel);
+    window.visualViewport?.addEventListener('scroll', positionPanel);
+    new ResizeObserver(positionPanel).observe(trigger);
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (!action) return;
+      panel.hidePopover();
+      window.location.assign(action.dataset.href);
+    });
+  </script>
