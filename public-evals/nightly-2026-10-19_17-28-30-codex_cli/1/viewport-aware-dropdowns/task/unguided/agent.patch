+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+
+    function positionPanel() {
+      if (!panel.matches(':popover-open')) return;
+
+      const viewport = window.visualViewport;
+      const padding = 8;
+      const gap = 8;
+      const left = (viewport?.offsetLeft ?? 0) + padding;
+      const top = (viewport?.offsetTop ?? 0) + padding;
+      const right = left + (viewport?.width ?? document.documentElement.clientWidth) - padding * 2;
+      const bottom = top + (viewport?.height ?? window.innerHeight) - padding * 2;
+      const anchor = trigger.getBoundingClientRect();
+
+      panel.style.maxWidth = `${Math.max(0, right - left)}px`;
+      panel.style.maxHeight = `${Math.max(0, bottom - top)}px`;
+      const { width, height } = panel.getBoundingClientRect();
+      const below = Math.max(0, bottom - anchor.bottom - gap);
+      const above = Math.max(0, anchor.top - gap - top);
+      const flipUp = height > below && above > below;
+      const availableHeight = flipUp ? above : below;
+      panel.style.maxHeight = `${Math.min(bottom - top, availableHeight)}px`;
+
+      // Prefer left alignment; flip to right alignment at the viewport edge.
+      let x = anchor.left;
+      if (x + width > right) x = anchor.right - width;
+      x = Math.max(left, Math.min(x, right - width));
+      const actualHeight = panel.getBoundingClientRect().height;
+      let y = flipUp ? anchor.top - gap - actualHeight : anchor.bottom + gap;
+      y = Math.max(top, Math.min(y, bottom - actualHeight));
+      panel.style.left = `${x}px`;
+      panel.style.top = `${y}px`;
+    }
+
+    panel.addEventListener('toggle', () => {
+      trigger.setAttribute('aria-expanded', String(panel.matches(':popover-open')));
+      positionPanel();
+    });
+
+    window.addEventListener('resize', positionPanel);
+    window.addEventListener('scroll', positionPanel, true);
+    window.visualViewport?.addEventListener('resize', positionPanel);
+    window.visualViewport?.addEventListener('scroll', positionPanel);
+    new ResizeObserver(positionPanel).observe(trigger);
+    new ResizeObserver(positionPanel).observe(panel);
+  </script>
