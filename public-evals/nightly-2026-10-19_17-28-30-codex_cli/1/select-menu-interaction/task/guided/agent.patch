+  <script>
+    const shopSelect = document.getElementById('local-shop');
+
+    // Wait for the browser to update its native user-validation state.
+    const syncShopValidation = () => {
+      requestAnimationFrame(() => {
+        shopSelect.setAttribute('aria-invalid', String(shopSelect.matches(':user-invalid')));
+      });
+    };
+
+    for (const event of ['input', 'change', 'blur', 'invalid']) {
+      shopSelect.addEventListener(event, syncShopValidation);
+    }
