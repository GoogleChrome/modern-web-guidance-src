+<dialog id="planner" aria-labelledby="planner-title"><button class="close" aria-label="Close trip planner">×</button><div class="eyebrow">Let's follow your curiosity</div><h2 class="modal-title" id="planner-title">Your elsewhere starts here.</h2><p class="modal-copy">A place, a pace, and a little possibility. Build a first sketch of your next escape.</p><form class="trip-form"><label for="destination">Where are you dreaming of?</label><select id="destination" name="destination"><option>The Italian Dolomites</option><option>The Portuguese coast</option><option>The Scottish Highlands</option></select><label for="pace">What's your kind of day?</label><select id="pace" name="pace"><option value="slow">Slow mornings & scenic detours</option><option value="active">Early starts & outdoor adventures</option><option value="culture">Local flavors & cultural discoveries</option></select><button class="primary" type="submit">Sketch my escape <span class="arrow">↗</span></button></form><div class="itinerary" id="itinerary" aria-live="polite" hidden></div></dialog>
+<script>
+  // SDK integration contract: dispatch `experiment:ready` or call
+  // window.markExperimentReady() only AFTER all initial DOM changes are applied.
+  // A load event alone does not mean asynchronous personalization has finished.
+  (() => {
+    const root = document.documentElement;
+    const original = document.querySelector('[data-experiment]').cloneNode(true);
+    let settled = false;
+    let sdk;
+    const settle = (ready) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(deadline);
+      window.removeEventListener('experiment:ready', readyHandler);
+      if (!ready) {
+        // Discard any partial variant before revealing the default experience.
+        sdk?.remove();
+        document.querySelector('[data-experiment]')?.replaceWith(original);
+      }
+      root.dataset.experimentState = ready ? 'ready' : 'fallback';
+      root.classList.remove('experiment-pending');
+    };
+    const readyHandler = () => settle(true);
+    window.markExperimentReady = readyHandler;
+    window.addEventListener('experiment:ready', readyHandler, { once: true });
+    const deadline = setTimeout(() => settle(false), 2000);
+    sdk = document.createElement('script');
+    sdk.src = 'https://cdn.example.com/experiment-sdk.js';
+    sdk.async = true;
+    sdk.onerror = () => settle(false);
+    document.head.appendChild(sdk);
+  })();
+
+  const planner = document.querySelector('#planner');
+  const itinerary = document.querySelector('#itinerary');
+  document.addEventListener('click', (event) => {
+    const trigger = event.target.closest('[data-plan], [data-destination]');
+    if (!trigger) return;
+    if (trigger.dataset.destination) document.querySelector('#destination').value = trigger.dataset.destination;
+    itinerary.hidden = true;
+    document.querySelector('.trip-form').hidden = false;
+    planner.showModal();
+  });
+  document.querySelector('.close').addEventListener('click', () => planner.close());
+  planner.addEventListener('click', (event) => { if (event.target === planner) { const r = planner.getBoundingClientRect(); if(event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) planner.close(); } });
+  document.querySelector('.trip-form').addEventListener('submit', (event) => {
+    event.preventDefault();
+    const destination = document.querySelector('#destination').value;
+    const pace = document.querySelector('#pace').value;
+    const plans = {
+      'The Italian Dolomites': ['Settle into a mountain village and watch the peaks turn pink at sunset.', 'Follow a meadow trail to a family-run rifugio for lunch.', 'Find a quiet alpine lake, then linger over a local dinner.'],
+      'The Portuguese coast': ['Arrive in a coastal village and take the long way to the beach.', 'Walk a clifftop trail, stopping for a seafood lunch in a fishing harbor.', 'Explore a local market and spend an unhurried afternoon by the water.'],
+      'The Scottish Highlands': ['Make your way through the glens to a cozy village inn.', 'Follow a lochside path and stop for tea in a nearby village.', 'Explore a castle and take a scenic drive through the mountains.']
+    };
+    itinerary.replaceChildren();
+    const title = document.createElement('p'); const strong = document.createElement('strong'); strong.textContent = 'Three days in ' + destination.replace(/^The /, 'the '); title.append(strong); itinerary.append(title);
+    plans[destination].forEach((line,index) => {const p = document.createElement('p'); p.textContent = `Day ${index+1} · ${line}`; itinerary.append(p);});
+    const note = document.createElement('p'); note.textContent = pace === 'active' ? 'Make it yours: add a guided hike or an early-morning trail run.' : pace === 'culture' ? 'Make it yours: add a cooking class or a walk with a local guide.' : 'Make it yours: leave an afternoon open. Sometimes less is more.'; itinerary.append(note);
+    itinerary.hidden = false;
+    document.querySelector('.trip-form').hidden = true;
+  });
