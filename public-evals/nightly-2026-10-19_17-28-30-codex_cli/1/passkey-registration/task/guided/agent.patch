+  <script type="module">
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const registerStatus = document.querySelector('#register-status');
+
+    async function initializePasskeys() {
+      if (!window.isSecureContext || !window.PublicKeyCredential ||
+          typeof navigator.credentials?.create !== 'function') {
+        registerStatus.textContent = 'Passkeys require a supported browser and a secure connection.';
+        return;
+      }
+
+      try {
+        await import('./assets/webauthn-polyfills.js');
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        // Older browsers cannot report passkeyPlatformAuthenticator directly.
+        const platformAvailable = capabilities.passkeyPlatformAuthenticator ??
+          await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+        if (!capabilities.conditionalGet || !platformAvailable) {
+          registerStatus.textContent = 'Passkey creation is unavailable on this device or browser.';
+          return;
+        }
+        registerStatus.textContent = '';
+        registerButton.disabled = false;
+      } catch {
+        registerStatus.textContent = 'Could not check passkey availability. Please reload to try again.';
+      }
+    }
+
+    async function postJSON(url, body) {
+      return fetch(url, {
+        method: 'POST',
+        credentials: 'same-origin',
+        mode: 'same-origin',
+        cache: 'no-store',
+        redirect: 'error',
+        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+        body: JSON.stringify(body),
+      });
+    }
+
+    async function signalUnregisteredCredential(publicKey, credential) {
+      if (typeof PublicKeyCredential.signalUnknownCredential !== 'function') return;
+      try {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId: publicKey.rp.id ?? window.location.hostname,
+          credentialId: credential.id,
+        });
+      } catch {
+        // Password-manager synchronization is optional; preserve the verification error.
+      }
+    }
+
+    registerButton.addEventListener('click', async () => {
+      if (registerButton.disabled) return;
+      registerButton.disabled = true;
+      registerStatus.textContent = 'Preparing your passkey…';
+      let registered = false;
+
+      try {
+        const optionsResponse = await postJSON('/api/register/options', { promotion: true });
+        if (!optionsResponse.ok) {
+          throw new Error('Could not start passkey registration. Please try again.');
+        }
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(
+          await optionsResponse.json(),
+        );
+
+        registerStatus.textContent = 'Follow your device’s instructions to create a passkey.';
+        const credential = await navigator.credentials.create({ publicKey });
+        if (!credential) {
+          registerStatus.textContent = 'No passkey was created. You can try again.';
+          return;
+        }
+        const encodedCredential = credential.toJSON();
+
+        registerStatus.textContent = 'Verifying your passkey…';
+        // Only verification failures trigger password-manager synchronization.
+        try {
+          const verificationResponse = await postJSON('/api/register/verify', encodedCredential);
+          if (!verificationResponse.ok) {
+            throw new Error('Could not verify your passkey. Please try again.');
+          }
+          const result = await verificationResponse.json();
+          if (result.verified !== true) {
+            throw new Error('Could not verify your passkey. Please try again.');
+          }
+        } catch (error) {
+          await signalUnregisteredCredential(publicKey, encodedCredential);
+          throw error;
+        }
+
+        registered = true;
+        registerStatus.textContent = 'Your passkey was registered successfully.';
+      } catch (error) {
+        const messages = {
+          InvalidStateError: 'A passkey already exists for this account on this authenticator.',
+          NotAllowedError: 'Passkey creation was cancelled or timed out. You can try again.',
+          AbortError: 'Passkey creation was interrupted. You can try again.',
+          SecurityError: 'Passkey creation requires a secure connection and a valid site configuration.',
+        };
+        registerStatus.textContent = messages[error.name] ||
+          'Passkey registration failed. Please try again.';
+      } finally {
+        registerButton.disabled = registered;
+      }
+    });
+
+    initializePasskeys();
+  </script>
+
 </body>
 
