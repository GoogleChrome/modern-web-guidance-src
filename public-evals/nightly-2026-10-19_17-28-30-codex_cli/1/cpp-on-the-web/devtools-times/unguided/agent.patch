+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+emcc renderer/smallpt.cpp -O3 --no-entry -s MODULARIZE=1 -s EXPORT_ES6=1 -s ENVIRONMENT=worker,node -s EXPORTED_RUNTIME_METHODS=HEAPU8 -s ALLOW_MEMORY_GROWTH=1 -s STACK_SIZE=1048576 -s EXPORTED_FUNCTIONS='["_initialize","_framebuffer","_render_rows"]' -o public/renderer/smallpt.js
+cp renderer/LICENSE.txt public/renderer/LICENSE.txt
diff --git a/scripts/check-renderer.mjs b/scripts/check-renderer.mjs
new file mode 100644
