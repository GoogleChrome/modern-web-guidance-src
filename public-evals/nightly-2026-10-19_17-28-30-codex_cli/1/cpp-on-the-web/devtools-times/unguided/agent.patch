diff --git a/public/renderer/worker.js b/public/renderer/worker.js
new file mode 100644
index 0000000..fed19d8
--- /dev/null
+++ b/public/renderer/worker.js
@@ -0,0 +1,15 @@
+import createSmallpt from './smallpt.js';
+let engine;
+self.onmessage = async ({ data }) => {
+  try {
+    engine ||= await createSmallpt();
+    const { width, height, samples, seed, colors } = data;
+    engine._initialize(width, height, samples, seed, ...colors);
+    const start = performance.now();
+    for (let row = 0; row < height; row += 4) {
+      engine._render_rows(row, Math.min(4, height-row));
+      const pixels = engine.HEAPU8.slice(engine._framebuffer(), engine._framebuffer()+width*height*4);
+      self.postMessage({ pixels, row: Math.min(row+4,height), height, elapsed: (performance.now()-start)/1000 }, [pixels.buffer]);
+    }
+  } catch (error) { self.postMessage({error: String(error)}); }
+};
