+<script>
+  const canvas = document.querySelector<HTMLCanvasElement>('#render')!;
+  const ctx = canvas.getContext('2d')!;
+  const base = import.meta.env.BASE_URL;
+  const mirror = document.querySelector<HTMLInputElement>('#mirror-color')!;
+  const glass = document.querySelector<HTMLInputElement>('#glass-color')!;
+  const samples = document.querySelector<HTMLInputElement>('#samples')!;
+  const resolution = document.querySelector<HTMLSelectElement>('#resolution')!;
+  const randomize = document.querySelector<HTMLButtonElement>('#randomize')!;
+  const status = document.querySelector<HTMLElement>('#render-status')!;
+  let worker: Worker | undefined;
+  let scene = 1;
+  let ready = false;
+  const spp = [16,64,128,256];
+  const updateColors = () => {
+    document.querySelector('#mirror-hex')!.textContent = mirror.value.toUpperCase();
+    document.querySelector('#glass-hex')!.textContent = glass.value.toUpperCase();
+  };
+  const colorComponents = (hex: string) => [1,3,5].map(i => Math.min(.999, parseInt(hex.slice(i,i+2),16)/255));
+  function render() {
+    worker?.terminate();
+    worker = new Worker(`${base}renderer/worker.js`, {type:'module'});
+    const width = Number(resolution.value), height = width * .75;
+    randomize.disabled = true;
+    status.textContent = 'Tracing light…';
+    document.querySelector('#progress')!.setAttribute('style','width:0%');
+    document.querySelector('#resolution-label')!.textContent = `${width} × ${height}`;
+    document.querySelector('#image-index')!.textContent = `SCENE ${String(scene).padStart(3,'0')}`;
+    worker.onmessage = ({ data }) => {
+      if (data.error) { status.textContent = 'Render failed. Try again.'; randomize.disabled = false; console.error(data.error); return; }
+      if (canvas.width !== width || canvas.height !== height) {canvas.width = width; canvas.height = height;}
+      // Only replace the rows already rendered, preserving the previous image below.
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels),width,height),0,0,0,0,width,data.row);
+      const percent = Math.round(data.row/height*100);
+      document.querySelector('#progress')!.setAttribute('style',`width:${percent}%`);
+      status.textContent = data.row === height ? 'Render complete' : `Tracing light · ${percent}%`;
+      document.querySelector('#render-time')!.textContent = `${spp[Number(samples.value)]} SPP · ${data.elapsed.toFixed(1)} SECONDS`;
+      if (data.row === height) {randomize.disabled = false; ready = true; worker?.terminate(); worker=undefined;}
+    };
+    worker.onerror = () => {status.textContent = 'Renderer unavailable. Click to retry.'; randomize.disabled=false;};
+    worker.postMessage({width,height,samples:spp[Number(samples.value)],seed:Math.floor(Math.random()*2147483647),colors:[...colorComponents(mirror.value),...colorComponents(glass.value)]});
+  }
+  const preview = new Image();
+  samples.addEventListener('input',() => {document.querySelector('#sample-value')!.textContent = `${spp[Number(samples.value)]} spp`;});
+  samples.addEventListener('change',render);
+  resolution.addEventListener('change',render);
+  [mirror,glass].forEach(input => input.addEventListener('input',updateColors));
+  [mirror,glass].forEach(input => input.addEventListener('change',() => {scene++;document.querySelector('#image-note')!.textContent='YOUR OWN LITTLE WORLD';render();}));
+  randomize.addEventListener('click',() => {
+    const randomColor = () => '#' + Array.from(crypto.getRandomValues(new Uint8Array(3)),value => (110+value%146).toString(16).padStart(2,'0')).join('');
+    mirror.value = randomColor(); glass.value = randomColor(); updateColors(); scene++;
+    document.querySelector('#image-note')!.textContent='YOUR OWN LITTLE WORLD'; render();
+  });
+  document.querySelector('#reset')!.addEventListener('click',() => {mirror.value='#ffffff';glass.value='#ffffff';updateColors();scene=1;document.querySelector('#image-note')!.textContent='THE ORIGINAL CORNELL BOX';render();});
+  document.querySelector('#download')!.addEventListener('click',() => {const link=document.createElement('a');link.download=`smallpt-scene-${scene}.png`;link.href=canvas.toDataURL('image/png');link.click();});
+  document.querySelector('#fullscreen')!.addEventListener('click',() => {const viewport=document.querySelector<HTMLElement>('#viewport')!;if(document.fullscreenElement)document.exitFullscreen();else viewport.requestFullscreen?.();});
+  // The first scene is also traced locally; the bundled render gives an immediate preview.
+  preview.onload = () => {if (!worker && !ready) {ctx.drawImage(preview,0,0,640,480);render();}};
+  preview.onerror = () => {if (!worker && !ready) render();};
+  preview.src = `${base}renderer/preview.png`;
+</script>
