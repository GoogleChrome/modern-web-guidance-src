--- /dev/null
+++ b/scripts/check-renderer.mjs
@@ -0,0 +1,16 @@
+import assert from 'node:assert/strict';
+import createSmallpt from '../public/renderer/smallpt.js';
+const engine = await createSmallpt();
+function render(colors) {
+  engine._initialize(48,36,16,42,...colors);
+  engine._render_rows(0,36);
+  return engine.HEAPU8.slice(engine._framebuffer(),engine._framebuffer()+48*36*4);
+}
+const original=render([.999,.999,.999,.999,.999,.999]);
+assert.equal(original.length,48*36*4);
+assert(original.some((v,i)=>i%4!==3 && v>0),'Render must contain light');
+assert(original.every((v,i)=>i%4!==3 || v===255),'All pixels must be opaque');
+const tinted=render([.9,.45,.5,.4,.8,.5]);
+assert.notDeepEqual(original,tinted,'Sphere colors must affect the rendered output');
+assert.deepEqual(render([.999,.999,.999,.999,.999,.999]),original,'Reset must restore the original scene');
+console.log('WASM render passed: framebuffer, color changes, and scene reset.');
