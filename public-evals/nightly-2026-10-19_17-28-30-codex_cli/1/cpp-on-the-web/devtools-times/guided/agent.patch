diff --git a/public/wasm/render-worker.js b/public/wasm/render-worker.js
new file mode 100644
index 0000000..62e96b5
--- /dev/null
+++ b/public/wasm/render-worker.js
@@ -0,0 +1,22 @@
+import createSmallpt from './smallpt.js';
+let modulePromise;
+self.onmessage = async ({ data }) => {
+  try {
+    modulePromise ??= createSmallpt();
+    const engine = await modulePromise;
+    const { width, height, samples, seed, colors } = data;
+    engine._init(width, height, seed);
+    for (const [id, color] of Object.entries(colors)) engine._set_color(Number(id), ...color);
+    const started = performance.now();
+    for (let pass = 0; pass < samples / 4; pass++) {
+      let pointer;
+      for (let row = 0; row < height; row += 8) {
+        pointer = engine._render_rows(row, Math.min(8, height - row));
+      }
+      const pixels = engine.HEAPU8.slice(pointer, pointer + width * height * 4);
+      self.postMessage({ pixels, samples: (pass + 1) * 4, elapsed: performance.now() - started }, [pixels.buffer]);
+    }
+  } catch (error) {
+    self.postMessage({ error: error instanceof Error ? error.message : String(error) });
+  }
+};
