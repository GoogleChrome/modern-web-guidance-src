+const element = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
+const canvas = element<HTMLCanvasElement>('render-canvas');
+const context = canvas.getContext('2d')!;
+const base = document.querySelector<HTMLElement>('[data-base]')!.dataset.base!;
+const state = element('render-state');
+const dot = element('status-dot');
+const download = element<HTMLButtonElement>('download');
+let worker: Worker | undefined;
+let samples = 32;
+let palette = 1;
+let hasFrame = false;
+let colors: Record<string, number[]> = { 0: [.75,.25,.25], 1: [.25,.25,.75], 6: [.999,.999,.999], 7: [.999,.999,.999] };
+const preview = new Image();
+preview.src = `${base}images/smallpt-reference.png`;
+preview.onload = () => { if (!hasFrame) context.drawImage(preview, 0, 0, canvas.width, canvas.height); };
+
+function render() {
+  worker?.terminate();
+  const width = Number(element<HTMLSelectElement>('resolution').value);
+  const height = width * .75;
+  const previous = document.createElement('canvas');
+  previous.width = canvas.width; previous.height = canvas.height;
+  previous.getContext('2d')!.drawImage(canvas, 0, 0);
+  canvas.width = width; canvas.height = height;
+  context.drawImage(previous, 0, 0, width, height);
+  state.textContent = 'Tracing light';
+  dot.classList.add('busy');
+  dot.style.background = '';
+  element('current-samples').textContent = '0';
+  element('elapsed').textContent = '0.0s';
+  element('canvas-size').textContent = `${width} × ${height}`;
+  element('progress').style.width = '0%';
+  download.disabled = true;
+  try {
+    if (!('WebAssembly' in window)) throw new Error('WebAssembly is unavailable in this browser.');
+    worker = new Worker(`${base}wasm/render-worker.js`, { type: 'module' });
+    const fail = (message: string) => {
+      state.textContent = 'Render unavailable'; state.title = message;
+      dot.classList.remove('busy'); dot.style.background = '#d46743';
+      download.disabled = false;
+      console.error(message);
+    };
+    worker.onerror = event => fail(event.message || 'Unable to load the renderer.');
+    worker.onmessage = ({ data }) => {
+      if (data.error) { fail(data.error); return; }
+      hasFrame = true;
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), width, height), 0, 0);
+      element('current-samples').textContent = String(data.samples);
+      element('elapsed').textContent = `${(data.elapsed / 1000).toFixed(1)}s`;
+      element('progress').style.width = `${data.samples / samples * 100}%`;
+      download.disabled = false;
+      if (data.samples >= samples) { state.textContent = 'Render complete'; dot.classList.remove('busy'); }
+    };
+    worker.postMessage({ width, height, samples, seed: crypto.getRandomValues(new Uint32Array(1))[0], colors });
+  } catch (error) {
+    state.textContent = error instanceof Error ? error.message : 'Renderer unavailable';
+    dot.classList.remove('busy'); download.disabled = false;
+  }
+}
+
+// Bright, energy-conserving material tints, with a different hue for each surface.
+function colorFromHue(hue: number, saturation: number, value: number) {
+  return [0, 4, 2].map(offset => {
+    const k = (offset + hue * 6) % 6;
+    return value * (1 - saturation * Math.max(0, Math.min(k, 4 - k, 1)));
+  });
+}
+element('randomize').addEventListener('click', () => {
+  const hue = Math.random();
+  colors = { 0: colorFromHue(hue,.65,.78), 1: colorFromHue((hue+.35)%1,.6,.78), 6: colorFromHue((hue+.12)%1,.3,.98), 7: colorFromHue((hue+.65)%1,.18,.98) };
+  ['left','right','mirror','glass'].forEach((name, index) => {
+    const rgb = colors[[0,1,6,7][index]].map(value => Math.round(value*255));
+    element(`chip-${name}`).style.setProperty('--chip', `rgb(${rgb.join(',')})`);
+  });
+  palette++;
+  element('palette-name').textContent = 'A FRESH PERSPECTIVE';
+  element('palette-number').textContent = `PALETTE ${String(palette).padStart(3,'0')}`;
+  render();
+});
+document.querySelectorAll<HTMLButtonElement>('[data-samples]').forEach(button => {
+  button.addEventListener('click', () => {
+    samples = Number(button.dataset.samples);
+    document.querySelectorAll('[data-samples]').forEach(option => {
+      const selected = option === button;
+      option.classList.toggle('selected', selected); option.setAttribute('aria-pressed', String(selected));
+    });
+    render();
+  });
+});
+element('resolution').addEventListener('change', render);
+download.addEventListener('click', () => {
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const link = document.createElement('a');
+    const url = URL.createObjectURL(blob);
+    link.href = url; link.download = `smallpt-palette-${String(palette).padStart(3,'0')}.png`;
+    link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+window.addEventListener('pagehide', () => worker?.terminate());
+render();
