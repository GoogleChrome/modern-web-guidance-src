new file mode 100644
index 0000000..ea4623a
--- /dev/null
+++ b/scripts/build-wasm.sh
@@ -0,0 +1,11 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+em++ native/smallpt-web.cpp -O3 -flto -fwasm-exceptions -Wno-c++11-narrowing -Wno-dangling-else -Wno-return-type --no-entry \
+  -sEXPORT_ES6=1 -sMODULARIZE=1 -sENVIRONMENT=worker \
+  -sSTRICT=1 -sALLOW_MEMORY_GROWTH=1 -sASSERTIONS=1 -sSTACK_SIZE=1048576 \
+  -sINCOMING_MODULE_JS_API='["wasmBinary"]' \
+  -sEXPORTED_FUNCTIONS='["_init","_set_color","_render_rows"]' \
+  -sEXPORTED_RUNTIME_METHODS='["HEAPU8"]' \
+  -o public/wasm/smallpt.js
+cp native/LICENSE.txt public/wasm/LICENSE.txt
diff --git a/scripts/check-wasm.mjs b/scripts/check-wasm.mjs
new file mode 100644
index 0000000..e784e0b
--- /dev/null
+++ b/scripts/check-wasm.mjs
@@ -0,0 +1,32 @@
+// Exercise the shipped browser-only module in an isolated Worker-like JS context.
+// No browser is launched.
+import fs from 'node:fs';
+import vm from 'node:vm';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+const path = new URL('../public/wasm/smallpt.js', import.meta.url);
+const source = fs.readFileSync(path, 'utf8')
+  .replaceAll('import.meta.url', JSON.stringify(path.href))
+  .replace('export default Module;', 'globalThis.createSmallpt = Module;');
+const context = vm.createContext({ console, URL, WebAssembly, TextDecoder, TextEncoder,
+  setTimeout, clearTimeout, performance, WorkerGlobalScope: function() {},
+  location: { href: path.href } });
+context.self = context;
+vm.runInContext(source, context);
+const engine = await context.createSmallpt({ wasmBinary: fs.readFileSync(new URL('../public/wasm/smallpt.wasm', import.meta.url)) });
+function render(red) {
+  engine._init(64,48,12345);
+  engine._set_color(6,...(red ? [.9,.2,.1] : [.999,.999,.999]));
+  let pointer;
+  for (let pass=0; pass<2; pass++) for (let row=0;row<48;row+=8) pointer=engine._render_rows(row,8);
+  const pixels = engine.HEAPU8.slice(pointer,pointer+64*48*4);
+  assert.equal(pixels.length,64*48*4);
+  assert.ok(pixels.every((value,index) => index%4!==3 || value===255), 'all pixels are opaque');
+  assert.ok(pixels.some((value,index)=> index%4!==3 && value>0 && value<255), 'scene contains shading');
+  return createHash('sha256').update(pixels).digest('hex');
+}
+const original = render(false);
+const tinted = render(true);
+assert.notEqual(original,tinted,'changing sphere colors changes the render');
+assert.equal(render(false),original,'fixed seeds produce repeatable renders');
+console.log('Wasm runtime passed: progressive RGBA output, recoloring, deterministic restart.');
