+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+em++ src/smallpt.cpp -O3 -flto -fno-exceptions -fno-rtti --no-entry \
+  -sSTRICT -sEXPORT_ES6 -sMODULARIZE \
+  -sENVIRONMENT=web,worker -sALLOW_MEMORY_GROWTH \
+  -sASSERTIONS=1 -sFILESYSTEM=0 -sSTACK_SIZE=1048576 \
+  '-sEXPORTED_RUNTIME_METHODS=["HEAPU8"]' \
+  '-sINCOMING_MODULE_JS_API=["wasmBinary"]' \
+  '-sEXPORTED_FUNCTIONS=["_start_render","_render_rows","_get_pixels"]' \
+  -o public/smallpt.mjs
diff --git a/scripts/load-wasm.mjs b/scripts/load-wasm.mjs
new file mode 100644
index 0000000..01af767
--- /dev/null
+++ b/scripts/load-wasm.mjs
@@ -0,0 +1,32 @@
+// Execute the browser ES module in an isolated worker-like realm, without a browser.
+// Requires node --experimental-vm-modules.
+import { readFile } from "node:fs/promises";
+import vm from "node:vm";
+export async function loadWasm() {
+  const url = new URL("../public/smallpt.mjs", import.meta.url);
+  const context = vm.createContext({
+    console,
+    WebAssembly,
+    URL,
+    TextDecoder,
+    TextEncoder,
+    setTimeout,
+    clearTimeout,
+    WorkerGlobalScope: class WorkerGlobalScope {},
+  });
+  const module = new vm.SourceTextModule(await readFile(url, "utf8"), {
+    context,
+    initializeImportMeta(meta) {
+      meta.url = url.href;
+    },
+  });
+  await module.link(() => {
+    throw new Error("Unexpected dependency");
+  });
+  await module.evaluate();
+  return module.namespace.default({
+    wasmBinary: await readFile(
+      new URL("../public/smallpt.wasm", import.meta.url),
+    ),
+  });
+}
diff --git a/scripts/render-preview.mjs b/scripts/render-preview.mjs
new file mode 100644
index 0000000..bd731a8
--- /dev/null
+++ b/scripts/render-preview.mjs
@@ -0,0 +1,70 @@
+// Generate a real smallpt render with the same compiled Wasm used by the browser.
+import { readFile, writeFile } from "node:fs/promises";
+import { deflateSync } from "node:zlib";
+import { loadWasm } from "./load-wasm.mjs";
+const module = await loadWasm();
+const width = 768,
+  height = 576;
+module._start_render(
+  width,
+  height,
+  256,
+  2048,
+  234 / 255,
+  213 / 255,
+  172 / 255,
+  192 / 255,
+  223 / 255,
+  208 / 255,
+);
+const started = Date.now();
+for (let row = 0; row < height; row += 16) {
+  module._render_rows(16);
+  if (row % 128 === 0)
+    console.log(`Preview ${Math.round((row / height) * 100)}%`);
+}
+const pixels = Buffer.from(
+  module.HEAPU8.slice(
+    module._get_pixels(),
+    module._get_pixels() + width * height * 4,
+  ),
+);
+const scanlines = Buffer.alloc((width * 4 + 1) * height);
+for (let y = 0; y < height; y++)
+  pixels.copy(
+    scanlines,
+    y * (width * 4 + 1) + 1,
+    y * width * 4,
+    (y + 1) * width * 4,
+  );
+function crc32(data) {
+  let crc = 0xffffffff;
+  for (const byte of data) {
+    crc ^= byte;
+    for (let i = 0; i < 8; i++) crc = (crc >>> 1) ^ (crc & 1 ? 0xedb88320 : 0);
+  }
+  return (crc ^ 0xffffffff) >>> 0;
+}
+function chunk(type, data) {
+  const body = Buffer.concat([Buffer.from(type), data]);
+  const length = Buffer.alloc(4);
+  length.writeUInt32BE(data.length);
+  const crc = Buffer.alloc(4);
+  crc.writeUInt32BE(crc32(body));
+  return Buffer.concat([length, body, crc]);
+}
+const header = Buffer.alloc(13);
+header.writeUInt32BE(width);
+header.writeUInt32BE(height, 4);
+header[8] = 8;
+header[9] = 6;
+const png = Buffer.concat([
+  Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]),
+  chunk("IHDR", header),
+  chunk("IDAT", deflateSync(scanlines)),
+  chunk("IEND", Buffer.alloc(0)),
+]);
+await writeFile(new URL("../public/preview.png", import.meta.url), png);
+console.log(
+  `Preview written in ${(Date.now() - started) / 1000}s (${png.length} bytes)`,
+);
diff --git a/scripts/test-wasm.mjs b/scripts/test-wasm.mjs
new file mode 100644
index 0000000..df94b86
--- /dev/null
+++ b/scripts/test-wasm.mjs
@@ -0,0 +1,51 @@
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { loadWasm } from "./load-wasm.mjs";
+const renderer = await loadWasm();
+function render(seed, colors) {
+  assert.equal(renderer._start_render(48, 36, 16, seed, ...colors.flat()), 1);
+  assert.equal(renderer._render_rows(10), 10);
+  assert.equal(renderer._render_rows(30), 36);
+  const offset = renderer._get_pixels();
+  return renderer.HEAPU8.slice(offset, offset + 48 * 36 * 4);
+}
+const white = [
+  [0.999, 0.999, 0.999],
+  [0.999, 0.999, 0.999],
+];
+const a = render(42, white);
+assert(
+  a.some((value, i) => i % 4 !== 3 && value > 0),
+  "render must contain visible light",
+);
+assert(
+  a.every((value, i) => i % 4 !== 3 || value === 255),
+  "all pixels must be opaque",
+);
+assert.deepEqual(
+  render(42, white),
+  a,
+  "same scene and seed must reproduce exactly",
+);
+assert.notDeepEqual(render(43, white), a, "new seed must change path samples");
+assert.notDeepEqual(
+  render(42, [
+    [0.9, 0.3, 0.2],
+    [0.2, 0.8, 0.3],
+  ]),
+  a,
+  "sphere color changes must affect output",
+);
+assert.equal(
+  renderer._start_render(0, 0, 16, 1, ...white.flat()),
+  0,
+  "invalid sizes must fail",
+);
+assert.equal(
+  renderer._start_render(48, 36, 0, 1, ...white.flat()),
+  0,
+  "invalid quality must fail",
+);
+console.log(
+  `Wasm checks passed: visible RGBA output, deterministic renders, seed variation, sphere recoloring, incremental rows, and invalid inputs. SHA256 ${createHash("sha256").update(a).digest("hex").slice(0, 16)}`,
+);
diff --git a/scripts/test-worker.mjs b/scripts/test-worker.mjs
new file mode 100644
index 0000000..bed2717
--- /dev/null
+++ b/scripts/test-worker.mjs
@@ -0,0 +1,66 @@
+// Exercise the actual worker and ES module through their HTTP loading path.
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import vm from "node:vm";
+const origin = process.env.TEST_ORIGIN || "http://localhost:11222";
+const frames = [];
+const self = { postMessage: (data) => frames.push(data) };
+const context = vm.createContext({
+  self,
+  console,
+  WebAssembly,
+  URL,
+  TextDecoder,
+  TextEncoder,
+  setTimeout,
+  clearTimeout,
+  performance,
+  fetch,
+  WorkerGlobalScope: class WorkerGlobalScope {},
+});
+const rendererUrl = `${origin}/public/smallpt.mjs`;
+const renderer = new vm.SourceTextModule(
+  await (await fetch(rendererUrl)).text(),
+  {
+    context,
+    initializeImportMeta(meta) {
+      meta.url = rendererUrl;
+    },
+  },
+);
+const worker = new vm.SourceTextModule(
+  await readFile(
+    new URL("../public/render-worker.js", import.meta.url),
+    "utf8",
+  ),
+  { context },
+);
+await worker.link((specifier) => {
+  assert.equal(specifier, "./smallpt.mjs");
+  return renderer;
+});
+await worker.evaluate();
+await self.onmessage({
+  data: {
+    type: "render",
+    id: 1,
+    width: 48,
+    height: 36,
+    samples: 16,
+    seed: 12,
+    colors: [
+      [0.9, 0.8, 0.6],
+      [0.7, 0.9, 0.8],
+    ],
+  },
+});
+assert(frames.length > 0, "worker must publish frames");
+assert(!frames.some((frame) => frame.type === "error"), JSON.stringify(frames));
+const final = frames.at(-1);
+assert.equal(final.row, 36);
+assert.equal(final.pixels.length, 48 * 36 * 4);
+assert.equal(final.id, 1);
+assert(final.elapsed > 0);
+console.log(
+  "Worker integration passed: HTTP module loading, streaming Wasm compilation, and completed pixel transfer.",
+);
