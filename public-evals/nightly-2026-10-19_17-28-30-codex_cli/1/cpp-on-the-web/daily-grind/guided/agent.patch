+const $ = (id) => document.getElementById(id);
+const canvas = $("render-canvas");
+const context = canvas.getContext("2d");
+const defaults = [
+  [234 / 255, 213 / 255, 172 / 255],
+  [192 / 255, 223 / 255, 208 / 255],
+];
+let colors = defaults.map((color) => [...color]);
+let worker;
+let jobId = 0;
+let complete = false;
+let seed = 2048;
+let lastCompleted = null;
+let lastSettings = null;
+
+function toHex(color) {
+  return (
+    "#" +
+    color
+      .map((value) =>
+        Math.round(value * 255)
+          .toString(16)
+          .padStart(2, "0"),
+      )
+      .join("")
+      .toUpperCase()
+  );
+}
+function updatePalette() {
+  colors.forEach((color, i) => {
+    const hex = toHex(color);
+    const name = i === 0 ? "one" : "two";
+    $(`hex-${name}`).textContent = hex;
+    $(`swatch-${name}`).style.background =
+      `radial-gradient(circle at 30% 22%, #ffffff 0%, ${hex} 35%, ${toHex(color.map((c) => c * 0.7))} 75%, ${toHex(color.map((c) => c * 0.4))} 100%)`;
+  });
+}
+function setError(message) {
+  $("render-state").textContent = "RENDER PAUSED";
+  $("render-message").textContent = message;
+  $("footer-dot").style.background = "#d0a46b";
+  $("render").disabled = false;
+  $("randomize").disabled = false;
+}
+function render() {
+  if (!context || !window.Worker || !window.WebAssembly) {
+    setError("WebAssembly and Web Workers are required to render.");
+    return;
+  }
+  // Terminating the previous worker makes rerenders and reset interruptible,
+  // including while the old worker is still loading WebAssembly.
+  worker?.terminate();
+  worker = new Worker(new URL("./public/render-worker.js", import.meta.url), {
+    type: "module",
+  });
+  const id = ++jobId;
+  const width = Number($("resolution").value);
+  const height = (width * 3) / 4;
+  const samples = Number($("samples").value);
+  complete = false;
+  $("download").disabled = true;
+  $("render-state").textContent = "RENDERING";
+  $("render-message").textContent = "Tracing the light…";
+  $("footer-dot").style.background = "";
+  $("render-progress").value = 0;
+  $("stat-samples").textContent = `${samples} spp`;
+  $("stat-size").textContent = `${width} × ${height}`;
+  $("stat-time").textContent = "0.0s";
+  lastSettings = {
+    width,
+    height,
+    samples,
+    colors: colors.map((c) => [...c]),
+    seed,
+  };
+  let firstFrame = true;
+  worker.onmessage = ({ data }) => {
+    if (data.id !== jobId) return;
+    if (data.type === "error") {
+      setError(`Could not render: ${data.message}`);
+      return;
+    }
+    if (data.type !== "frame") return;
+    if (firstFrame) {
+      const previous = document.createElement("canvas");
+      previous.width = canvas.width;
+      previous.height = canvas.height;
+      const hadFrame = canvas.classList.contains("visible");
+      if (hadFrame) previous.getContext("2d").drawImage(canvas, 0, 0);
+      canvas.width = data.width;
+      canvas.height = data.height;
+      context.fillStyle = "#121614";
+      context.fillRect(0, 0, canvas.width, canvas.height);
+      const preview = $("preview");
+      if (hadFrame)
+        context.drawImage(previous, 0, 0, canvas.width, canvas.height);
+      else if (preview.complete && preview.naturalWidth)
+        context.drawImage(preview, 0, 0, canvas.width, canvas.height);
+      firstFrame = false;
+      canvas.classList.add("visible");
+    }
+    // Keep the previous image visible until new scanlines replace it.
+    context.putImageData(
+      new ImageData(
+        new Uint8ClampedArray(data.pixels.buffer),
+        data.width,
+        data.height,
+      ),
+      0,
+      0,
+      0,
+      0,
+      data.width,
+      data.row,
+    );
+    const progress = Math.round((data.row / data.height) * 100);
+    $("render-progress").value = progress;
+    $("render-message").textContent = `Tracing the light · ${progress}%`;
+    $("stat-time").textContent = `${(data.elapsed / 1000).toFixed(1)}s`;
+    if (data.row === data.height) {
+      complete = true;
+      lastCompleted = { ...lastSettings };
+      $("render-state").textContent = "RENDER COMPLETE";
+      $("render-message").textContent = "A little light, fully traced.";
+      $("download").disabled = false;
+      $("preview").hidden = true;
+      worker.terminate();
+      worker = null;
+    }
+  };
+  worker.onerror = () => {
+    setError("Renderer could not load. Press Render scene to retry.");
+    worker?.terminate();
+    worker = null;
+  };
+  worker.postMessage({ type: "render", id, ...lastSettings });
+}
+function randomColor() {
+  // Keep reflectance below 1 so Russian roulette paths terminate naturally.
+  const hue = Math.random() * 360;
+  const saturation = 0.28 + Math.random() * 0.42;
+  const lightness = 0.62 + Math.random() * 0.16;
+  const a = saturation * Math.min(lightness, 1 - lightness);
+  return [0, 8, 4].map((n) => {
+    const k = (n + hue / 30) % 12;
+    return Math.min(
+      0.96,
+      lightness - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)),
+    );
+  });
+}
+$("randomize").addEventListener("click", () => {
+  colors = [randomColor(), randomColor()];
+  seed = crypto.getRandomValues(new Uint32Array(1))[0];
+  updatePalette();
+  render();
+});
+$("render").addEventListener("click", render);
+$("reset").addEventListener("click", () => {
+  colors = defaults.map((color) => [...color]);
+  seed = 2048;
+  $("samples").value = "64";
+  $("resolution").value = "768";
+  $("quality-description").textContent = "Balanced";
+  updatePalette();
+  render();
+});
+$("samples").addEventListener("change", () => {
+  const descriptions = {
+    16: "Quick preview",
+    64: "Balanced",
+    256: "Fine detail",
+    512: "Ultra detail",
+  };
+  $("quality-description").textContent = descriptions[$("samples").value];
+});
+$("download").addEventListener("click", () => {
+  if (!complete || !lastCompleted) return;
+  canvas.toBlob((blob) => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = `smallpt-${lastCompleted.seed}-${lastCompleted.samples}spp.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, "image/png");
+});
+document.addEventListener("keydown", (event) => {
+  if (event.key === "Enter" && event.target === document.body) render();
+});
+updatePalette();
+render();
