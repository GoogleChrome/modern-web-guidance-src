diff --git a/public/render-worker.js b/public/render-worker.js
new file mode 100644
index 0000000..c496d2e
--- /dev/null
+++ b/public/render-worker.js
@@ -0,0 +1,47 @@
+import createSmallpt from "./smallpt.mjs";
+
+let renderer;
+let activeJob = 0;
+const pause = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+self.onmessage = async ({ data }) => {
+  if (data.type !== "render") return;
+  const job = ++activeJob;
+  try {
+    renderer ??= await createSmallpt();
+    if (job !== activeJob) return;
+    const { width, height, samples, seed, colors, id } = data;
+    const valid = renderer._start_render(
+      width,
+      height,
+      samples,
+      seed,
+      ...colors.flat(),
+    );
+    if (!valid)
+      throw new Error("The requested render settings are out of range.");
+    const started = performance.now();
+    let row = 0;
+    let lastUpdate = 0;
+    while (row < height && job === activeJob) {
+      row = renderer._render_rows(2);
+      const elapsed = performance.now() - started;
+      if (elapsed - lastUpdate > 90 || row === height) {
+        const offset = renderer._get_pixels();
+        const pixels = renderer.HEAPU8.slice(
+          offset,
+          offset + width * height * 4,
+        );
+        self.postMessage(
+          { type: "frame", id, width, height, row, elapsed, pixels },
+          [pixels.buffer],
+        );
+        lastUpdate = elapsed;
+      }
+      await pause();
+    }
+  } catch (error) {
+    if (job === activeJob)
+      self.postMessage({ type: "error", id: data.id, message: error.message });
+  }
+};
