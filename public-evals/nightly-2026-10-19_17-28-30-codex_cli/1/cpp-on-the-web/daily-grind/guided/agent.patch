+  }
+  .material-subtitle {
+    font-size: 7px;
+    letter-spacing: 0.3px;
+  }
+  .material-title {
+    font-size: 11px;
+  }
+  .button-caption {
+    margin-bottom: 16px;
+  }
+  .quality-section {
+    padding-top: 16px;
+  }
+  .resolution-label {
+    margin-top: 12px;
+  }
+  .secondary-button {
+    margin-top: 14px;
+  }
+  .download-button {
+    margin-top: 16px;
+    padding-top: 15px;
+  }
+  .local-note {
+    margin-top: 15px;
+  }
+}
