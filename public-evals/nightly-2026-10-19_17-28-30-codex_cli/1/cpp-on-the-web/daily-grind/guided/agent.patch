+}
+progress::-webkit-progress-value {
+  background: #92ae70;
+  transition: width 0.1s;
+}
+progress::-moz-progress-bar {
+  background: #92ae70;
+}
+.settings {
+  padding: 25px 24px 20px;
+  background: #fff;
+  display: flex;
+  flex-direction: column;
+}
+.settings-heading {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+.settings h2 {
+  font-size: 16px;
+  font-weight: 550;
+  letter-spacing: -0.5px;
+  margin: 0;
+}
+.settings-number {
+  font: 8px var(--mono);
+  color: #a2aa9c;
+  letter-spacing: 0.5px;
+}
+.settings-intro {
+  font-size: 10px;
+  color: #94998f;
+  margin: 8px 0 24px;
+}
+.control-section {
+  border-top: 1px solid var(--line);
+  padding-top: 18px;
+}
+.control-heading {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 13px;
+}
+.control-heading h3 {
+  font-size: 11px;
+  font-weight: 550;
+  margin: 0;
+}
+.icon-button {
+  display: grid;
+  place-items: center;
+  border: 0;
+  background: transparent;
+  padding: 2px;
+  color: #8c9683;
+}
+.icon-button:hover {
+  color: var(--green);
+  transform: rotate(-20deg);
+}
+.icon-button .icon {
+  width: 13px;
+  height: 13px;
+}
+.material {
+  display: flex;
+  align-items: center;
+  gap: 11px;
+  margin-bottom: 17px;
+}
+.sphere-swatch {
+  width: 30px;
+  height: 30px;
+  border-radius: 50%;
+  background: radial-gradient(
+    circle at 32% 26%,
+    #fff9e8 0,
+    #ead5ac 27%,
+    #bea777 70%,
+    #736449 100%
+  );
+  box-shadow:
+    inset -2px -3px 4px #00000012,
+    0 2px 3px #0000000a;
+  flex-shrink: 0;
+}
+.sphere-swatch.glass {
+  background: radial-gradient(
+    circle at 33% 25%,
+    #f9fffb 0,
+    #c0dfd0 30%,
+    #95b7a9 65%,
+    #547766 100%
+  );
+  border: 1px solid #adc5b92b;
+}
+.material > div {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+}
+.material-title {
+  font-size: 10px;
+  font-weight: 500;
+}
+.material-subtitle {
+  font: 6px var(--mono);
+  letter-spacing: 0.7px;
+  color: #9b9e92;
+}
+.hex {
+  font: 8px var(--mono);
+  color: #949b8c;
+  margin-left: auto;
+}
+.primary-button,
+.secondary-button {
+  width: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 9px;
+  min-height: 39px;
+  border-radius: 5px;
+  font-size: 10px;
+  font-weight: 500;
+  transition: background 0.15s;
+}
+.primary-button {
+  color: white;
+  background: #496d40;
+  border: 1px solid #496d40;
+  margin-top: 6px;
+  box-shadow: 0 2px 3px #23451c10;
+}
+.primary-button:hover {
+  background: #385a30;
+}
+.primary-button .icon {
+  width: 14px;
+  height: 14px;
+}
+.button-arrow {
+  font-size: 15px;
+  margin-left: auto;
+  color: #c0d3b6;
+}
+.primary-button .icon {
+  margin-right: auto;
+}
+.primary-button {
+  padding: 0 13px;
+}
+.button-caption {
+  text-align: center;
+  font-size: 8px;
+  color: #9ca290;
+  margin: 10px 0 20px;
+}
+.quality-section {
+  padding-top: 19px;
+}
+.mini-label {
+  font: 7px var(--mono);
+  letter-spacing: 1px;
+  color: #9aa18e;
+}
+.field-label {
+  font-size: 9px;
+  color: #7a8372;
+  display: flex;
+  justify-content: space-between;
+  margin: 0 0 8px;
+}
+.field-label > span {
+  font-size: 8px;
+  color: #9fa790;
+}
+.select-wrap {
+  position: relative;
+}
+.select-wrap:after {
+  content: "";
+  position: absolute;
+  right: 13px;
+  top: 13px;
+  width: 5px;
+  height: 5px;
+  border-right: 1px solid #939b8a;
+  border-bottom: 1px solid #939b8a;
+  transform: rotate(45deg);
+  pointer-events: none;
+}
+select {
+  width: 100%;
+  height: 34px;
+  background: #fafbf8;
+  border: 1px solid #e2e6dc;
+  border-radius: 4px;
+  color: #626e58;
+  font-size: 9px;
+  padding: 0 28px 0 10px;
+  appearance: none;
+  cursor: pointer;
+}
+.resolution-label {
+  margin-top: 14px;
+}
+.secondary-button {
+  margin-top: 17px;
+  background: #fff;
+  border: 1px solid #dce1d4;
+  color: #647356;
+  min-height: 34px;
+  font-size: 9px;
+}
+.secondary-button:hover {
+  background: #f3f6ee;
+}
+.secondary-button .icon {
+  width: 11px;
+  height: 11px;
+  fill: #7b8e69;
+  stroke-width: 1.2;
+}
+.key-hint {
+  font-size: 11px;
+  color: #aab29f;
+  margin-left: auto;
+}
+.secondary-button {
+  padding: 0 11px;
+}
+.secondary-button .icon {
+  margin-right: auto;
+}
+.download-button {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  width: 100%;
+  border: 0;
+  border-top: 1px solid var(--line);
+  background: transparent;
+  padding: 18px 2px 0;
+  margin-top: 20px;
+  font-size: 10px;
+  color: #68745f;
+}
+.download-button:hover {
+  color: #2d4d25;
+}
+.download-button .icon {
+  width: 13px;
+  height: 13px;
+}
+.download-button > span {
+  font: 7px var(--mono);
+  padding: 2px 5px;
+  border: 1px solid #e1e5db;
+  border-radius: 3px;
+  margin-left: auto;
+  color: #929c84;
+}
+.download-button .icon {
+  margin-right: auto;
+}
+.local-note {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin: 20px 0 0;
+  color: #9ca491;
+  font-size: 8px;
+  line-height: 1.8;
+}
+.local-note strong {
+  font-weight: 400;
+  color: #7f8b70;
+}
+.local-icon {
+  font-size: 19px;
+  color: #91a17d;
+}
+.under-the-hood {
+  display: flex;
+  align-items: center;
+  gap: 35px;
+  padding: 27px 0 29px;
+  border-bottom: 1px solid var(--line);
+}
+.about-label {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-width: 157px;
+}
+.about-label .icon {
+  width: 24px;
+  height: 24px;
+  color: #869578;
+}
+.about-label > span {
+  font: 8px/1.8 var(--mono);
+  letter-spacing: 1px;
+  color: #7c886f;
+}
+.under-the-hood p {
+  font-size: 10px;
+  line-height: 1.8;
+  color: #76806c;
+  margin: 0;
+}
+.under-the-hood p span {
+  color: #a0a594;
+}
+.tech-badges {
+  margin-left: auto;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.tech-badges > span:not(.tech-plus):not(.open-source) {
+  font: 8px var(--mono);
+  border: 1px solid #dce2d3;
+  background: #f1f4ec;
+  padding: 6px 8px;
+  border-radius: 4px;
+  color: #7c896c;
+}
+.tech-plus {
+  color: #98a48c;
+  font-size: 10px;
+}
+.tech-badges .open-source {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  font-size: 9px;
+  color: #8b967e;
+  margin-left: 13px;
+  white-space: nowrap;
+}
+.open-source .status-dot {
+  width: 4px;
+  height: 4px;
+}
+.site-footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 23px 0 28px;
+  font-size: 9px;
+  color: #99a08f;
+}
+.site-footer a {
+  color: #6f7d62;
+}
+.site-footer > a {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+.site-footer .icon {
+  width: 11px;
+  height: 11px;
+}
+.footer-slash {
+  margin: 0 10px;
+  color: #b9c0b0;
+}
+.noscript {
+  text-align: center;
+  padding: 10px;
+  font-size: 14px;
+}
+@media (min-width: 1500px) {
+  .intro {
+    padding-top: 58px;
+    padding-bottom: 45px;
+  }
+  .viewport img,
+  .viewport canvas {
+    max-height: 590px;
+  }
+}
+@media (max-width: 1375px) {
+  main,
+  .site-footer {
+    margin-left: 48px;
+    margin-right: 48px;
+  }
+  .intro h1 {
+    font-size: 46px;
+  }
+  .viewport {
+    min-height: 410px;
+  }
+  .render-stats {
+    font-size: 7px;
+  }
+  .workspace {
+    grid-template-columns: minmax(0, 1fr) 285px;
+  }
+  .settings {
+    padding: 23px 22px 20px;
+  }
+}
+@media (max-width: 1100px) {
+  .brand-caption,
+  .brand-divider {
+    display: none;
+  }
+  .intro h1 {
+    font-size: 38px;
+    letter-spacing: -1.6px;
+  }
+  .intro h1 span {
+    letter-spacing: -1.7px;
+  }
+  .intro > p {
+    font-size: 10px;
+  }
+  .workspace {
+    grid-template-columns: minmax(0, 1fr) 265px;
+  }
+  .settings {
+    padding: 22px 18px;
+  }
+  .viewport {
+    min-height: 430px;
+  }
+  .scene-version {
+    display: none;
+  }
+  .render-footer {
+    padding: 0 14px;
+  }
+  .render-footer .render-stats {
+    gap: 3px;
+  }
+  .under-the-hood {
+    gap: 18px;
+  }
+  .tech-badges .open-source {
+    display: none;
+  }
+  .about-label {
+    min-width: 135px;
+  }
+}
+@media (max-width: 800px) {
+  .site-header {
+    padding: 0 24px;
+    height: 75px;
+  }
+  main,
+  .site-footer {
+    margin-left: 24px;
+    margin-right: 24px;
+  }
+  .site-header nav {
+    gap: 20px;
+  }
+  .runtime-badge {
+    font-size: 8px;
+    padding: 7px 8px;
+  }
+  .source-link {
+    font-size: 10px;
+  }
+  .intro {
+    padding: 32px 0 28px;
+    align-items: flex-start;
+    flex-direction: column;
+    gap: 16px;
+  }
+  .intro h1 {
+    font-size: 43px;
+  }
+  .intro > p {
+    font-size: 12px;
+    margin: 0;
+  }
+  .desktop-break {
+    display: none;
+  }
+  .intro > p br:first-child {
+    display: none;
+  }
+  .workspace {
+    grid-template-columns: 1fr;
+  }
+  .viewport {
+    min-height: 0;
+    aspect-ratio: 4/3;
+  }
+  .viewport img,
+  .viewport canvas {
+    max-height: none;
+    width: 100%;
+    height: 100%;
+  }
+  .render-toolbar {
+    height: 44px;
+  }
+  .render-footer {
+    height: 40px;
+  }
+  .settings {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 0 30px;
+    padding: 25px;
+  }
+  .settings-heading,
+  .settings-intro {
+    grid-column: 1/-1;
+  }
+  .settings-intro {
+    margin-bottom: 20px;
+  }
+  .quality-section {
+    padding-top: 18px;
+  }
+  .settings .download-button {
+    grid-column: 1;
+    align-self: center;
+    margin-top: 8px;
+    padding-top: 15px;
+  }
+  .local-note {
+    grid-column: 2;
+    margin-top: 10px;
+  }
+  .button-caption {
+    margin-bottom: 0;
+  }
+  .under-the-hood {
+    flex-wrap: wrap;
+    gap: 20px;
+    padding: 24px 0;
+  }
+  .tech-badges {
+    margin-left: 0;
+  }
+  .under-the-hood p {
+    flex: 1;
+  }
+  .site-footer {
+    font-size: 8px;
+  }
+  .brand {
+    font-size: 25px;
+  }
+}
+@media (max-width: 480px) {
+  .site-header {
+    padding: 0 20px;
+  }
+  .source-link {
+    font-size: 0;
+    gap: 0;
+  }
+  .source-link .icon {
+    width: 16px;
+    height: 16px;
+  }
+  .site-header nav {
+    gap: 15px;
+  }
+  .runtime-badge {
+    font-size: 7px;
+  }
+  .brand {
+    gap: 7px;
+    font-size: 24px;
+  }
+  .brand-mark {
+    width: 26px;
+  }
+  main,
+  .site-footer {
+    margin-left: 20px;
+    margin-right: 20px;
+  }
+  .intro h1 {
+    font-size: 35px;
+  }
+  .eyebrow {
+    font-size: 7px;
+    letter-spacing: 1.4px;
+  }
+  .intro > p {
+    font-size: 11px;
+    line-height: 1.8;
+  }
+  .render-toolbar {
+    padding: 0 14px;
+  }
+  .scene-title {
+    font-size: 10px;
+  }
+  .live-label {
+    font-size: 7px;
+  }
+  .render-footer {
+    font-size: 7px;
+    gap: 4px;
+  }
+  .render-stats {
+    font-size: 6px !important;
+  }
+  .stat-divider {
+    margin: 0 2px;
+  }
+  .settings {
+    padding: 22px 18px;
+    gap: 0 18px;
+  }
+  .settings h2 {
+    font-size: 17px;
+  }
+  .material {
+    gap: 6px;
+  }
+  .hex {
+    display: none;
+  }
+  .material-title {
+    font-size: 10px;
+  }
+  .sphere-swatch {
+    width: 27px;
+    height: 27px;
+  }
+  .material-subtitle {
+    font-size: 5px;
+    letter-spacing: 0.3px;
+  }
+  .primary-button {
+    font-size: 8px;
+    padding: 0 8px;
+    gap: 6px;
+  }
+  .button-arrow {
+    font-size: 12px;
+  }
+  .primary-button .icon {
+    width: 12px;
+    height: 12px;
+  }
+  .button-caption {
+    font-size: 7px;
+  }
+  .control-heading h3 {
+    font-size: 10px;
+  }
+  .field-label {
+    font-size: 8px;
+  }
+  .field-label > span {
+    display: none;
+  }
+  .mini-label {
+    font-size: 6px;
+  }
+  .settings-intro {
+    font-size: 10px;
+  }
+  .quality-section select {
+    font-size: 8px;
+    padding-left: 8px;
+  }
+  .quality-section .control-heading {
+    margin-bottom: 16px;
+  }
+  .resolution-label {
+    margin-top: 12px;
+  }
+  .local-note {
+    gap: 7px;
+    font-size: 6px;
+  }
+  .local-icon {
+    font-size: 16px;
+  }
+  .download-button {
+    font-size: 9px;
+  }
+  .under-the-hood {
+    gap: 14px;
+  }
+  .about-label {
+    min-width: 115px;
+    gap: 8px;
+  }
+  .about-label > span {
+    font-size: 7px;
+  }
+  .under-the-hood p {
+    font-size: 8px;
+  }
+  .tech-badges {
+    display: none;
+  }
+  .site-footer {
+    gap: 20px;
+    align-items: flex-start;
+    line-height: 1.7;
+  }
+  .footer-slash {
+    margin: 0 4px;
+  }
+  .site-footer > a {
+    white-space: nowrap;
+  }
+  .viewport-label {
+    font-size: 6px;
+    left: 8px;
+    bottom: 8px;
+  }
+  .canvas-corner {
+    bottom: 8px;
+    right: 8px;
+    font-size: 6px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  * {
+    scroll-behavior: auto !important;
+    transition: none !important;
+  }
+}
