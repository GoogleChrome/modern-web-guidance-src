+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+emcc renderer/smallpt.cpp -O3 --no-entry -s MODULARIZE=1 -s EXPORT_NAME=createSmallpt -s ENVIRONMENT=web,worker,node -s ALLOW_MEMORY_GROWTH=1 -s EXPORTED_RUNTIME_METHODS='["HEAPU8"]' -s EXPORTED_FUNCTIONS='["_setup","_set_colors","_buffer","_render_rows"]' -o renderer/smallpt.js
