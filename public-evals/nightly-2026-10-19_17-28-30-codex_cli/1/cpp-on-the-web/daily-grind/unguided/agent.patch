+const fs = require('node:fs');
+const zlib = require('node:zlib');
+const createSmallpt = require('../renderer/smallpt.js');
+function crc32(bytes) {
+  let crc = -1;
+  for (const b of bytes) { crc ^= b; for (let j=0;j<8;j++) crc=(crc>>>1)^((crc&1)?0xedb88320:0); }
+  return (crc^-1)>>>0;
+}
+function chunk(type, data) {
+  const tag = Buffer.from(type), size = Buffer.alloc(4), crc = Buffer.alloc(4);
+  size.writeUInt32BE(data.length); crc.writeUInt32BE(crc32(Buffer.concat([tag,data])));
+  return Buffer.concat([size,tag,data,crc]);
+}
+(async () => {
+  const engine = await createSmallpt({wasmBinary: fs.readFileSync(require.resolve('../renderer/smallpt.wasm'))});
+  const w=640,h=480;
+  engine._setup(w,h,42);engine._set_colors(.96,.96,.96,.96,.96,.96);
+  for (let pass=0;pass<32;pass++) engine._render_rows(0,h);
+  const p=engine._buffer(), rgba=engine.HEAPU8.slice(p,p+w*h*4);
+  const raw=Buffer.alloc((w*4+1)*h);
+  for(let y=0;y<h;y++) raw.set(rgba.subarray(y*w*4,(y+1)*w*4),y*(w*4+1)+1);
+  const header=Buffer.alloc(13);header.writeUInt32BE(w);header.writeUInt32BE(h,4);header[8]=8;header[9]=6;
+  fs.writeFileSync('renderer/preview.png',Buffer.concat([Buffer.from([137,80,78,71,13,10,26,10]),chunk('IHDR',header),chunk('IDAT',zlib.deflateSync(raw)),chunk('IEND',Buffer.alloc(0))]));
+  console.log('Created preview from compiled WebAssembly: 640 × 480, 128 spp.');
+})().catch(error=>{console.error(error);process.exit(1)});
diff --git a/scripts/smoke-test.cjs b/scripts/smoke-test.cjs
new file mode 100644
index 0000000..e9b68c4
--- /dev/null
+++ b/scripts/smoke-test.cjs
@@ -0,0 +1,26 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const createSmallpt = require('../renderer/smallpt.js');
+(async () => {
+  const engine = await createSmallpt({wasmBinary: fs.readFileSync(require.resolve('../renderer/smallpt.wasm'))});
+  const w = 64, h = 48;
+  function image(colors) {
+    engine._setup(w, h, 42);
+    engine._set_colors(...colors);
+    for (let y = 0; y < h; y += 8) engine._render_rows(y, Math.min(y + 8, h));
+    const p = engine._buffer();
+    return engine.HEAPU8.slice(p, p + w * h * 4);
+  }
+  const white = [.96,.96,.96,.96,.96,.96];
+  const first = image(white);
+  assert.equal(first.length, w*h*4);
+  assert(first.some((v, i) => i % 4 !== 3 && v > 0), 'Image contains light');
+  assert(first.every((v, i) => i % 4 !== 3 || v === 255), 'Image is opaque');
+  const tinted = image([.95,.45,.3,.35,.6,.95]);
+  assert.notDeepEqual(first, tinted, 'Sphere colors change the rendered pixels');
+  assert.deepEqual(first, image(white), 'Reset restores the scene with a fixed seed');
+  engine._render_rows(0, h);
+  const p = engine._buffer();
+  assert.notDeepEqual(first, engine.HEAPU8.slice(p, p+w*h*4), 'Additional passes refine the image');
+  console.log('PASS: WebAssembly renders pixels, applies colors, resets, and accumulates samples.');
+})().catch(error => {console.error(error);process.exit(1);});
