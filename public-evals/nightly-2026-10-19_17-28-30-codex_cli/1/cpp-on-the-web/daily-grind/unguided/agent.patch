new file mode 100644
index 0000000..4511691
--- /dev/null
+++ b/app.js
@@ -0,0 +1,75 @@
+const $ = id => document.getElementById(id);
+const canvas = $('render'), context = canvas.getContext('2d');
+let worker, hasImage = false;
+const original = '#f5f5f5';
+function colors() {
+  return ['mirror-color', 'glass-color'].flatMap(id => {
+    const hex = $(id).value;
+    return [1, 3, 5].map(offset => parseInt(hex.slice(offset, offset + 2), 16) / 255);
+  });
+}
+function swatches() {
+  for (const kind of ['mirror', 'glass']) {
+    const color = $(kind + '-color').value;
+    $(kind + '-swatch').style.background = `radial-gradient(circle at 30% 25%, #ffffffdf, ${color} 24%, #161d15 68%, ${color})`;
+  }
+}
+function render() {
+  worker?.terminate();
+  worker = new Worker(new URL('./renderer/worker.js', import.meta.url));
+  const target = Number($('quality').value);
+  $('status').innerHTML = '<i class="live-dot"></i> Rendering light…';
+  $('sample-count').textContent = `0 / ${target} spp`;
+  $('elapsed').textContent = '0.0 s';
+  $('progress').style.width = '0%';
+  const failed = message => {
+    $('status').textContent = 'Render failed · try again';
+    $('status').title = message;
+    worker.terminate();
+  };
+  worker.onerror = event => failed(event.message);
+  worker.onmessage = ({data}) => {
+    if (data.error) return failed(data.error);
+    context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), canvas.width, canvas.height), 0, 0);
+    hasImage = true;
+    $('download').disabled = false;
+    $('sample-count').textContent = `${data.samples} / ${target} spp`;
+    $('elapsed').textContent = `${(data.elapsed / 1000).toFixed(1)} s`;
+    $('progress').style.width = `${data.samples / target * 100}%`;
+    if (data.done) {
+      $('status').innerHTML = '<i class="live-dot"></i> Render complete';
+      worker.terminate();
+    }
+  };
+  worker.postMessage({width: canvas.width, height: canvas.height, samples: target, seed: crypto.getRandomValues(new Uint32Array(1))[0], colors: colors()});
+}
+function randomColor() {
+  const hue = crypto.getRandomValues(new Uint32Array(1))[0] % 360;
+  // Bright tints preserve enough reflectance for the original path tracer.
+  const channels = [0, 8, 4].map(n => {
+    const k = (n + hue / 30) % 12;
+    return Math.round((.73 - .24 * Math.max(-1, Math.min(k - 3, 9 - k, 1))) * 255);
+  });
+  return '#' + channels.map(n => n.toString(16).padStart(2, '0')).join('');
+}
+$('randomize').onclick = () => {
+  $('mirror-color').value = randomColor(); $('glass-color').value = randomColor();
+  swatches(); render();
+};
+$('reset').onclick = () => {
+  $('mirror-color').value = original; $('glass-color').value = original;
+  $('mirror-swatch').style.background = ''; $('glass-swatch').style.background = '';
+  render();
+};
+for (const id of ['mirror-color', 'glass-color']) $(id).addEventListener('change', () => { swatches(); render(); });
+$('quality').addEventListener('change', render);
+$('download').onclick = () => {
+  if (!hasImage) return;
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const link = document.createElement('a'), url = URL.createObjectURL(blob);
+    link.href = url; link.download = 'smallpt-render.png'; link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  });
+};
+render();
