--- /dev/null
+++ b/renderer/worker.js
@@ -0,0 +1,18 @@
+importScripts('smallpt.js');
+let modulePromise;
+self.onmessage = async ({data}) => {
+  try {
+    modulePromise ||= createSmallpt();
+    const engine = await modulePromise;
+    const {width, height, samples, seed, colors} = data;
+    engine._setup(width, height, seed);
+    engine._set_colors(...colors);
+    const started = performance.now();
+    for (let pass = 0; pass < samples / 4; pass++) {
+      for (let y = 0; y < height; y += 8) engine._render_rows(y, Math.min(y + 8, height));
+      const pointer = engine._buffer();
+      const pixels = engine.HEAPU8.slice(pointer, pointer + width * height * 4);
+      self.postMessage({pixels: pixels.buffer, samples: (pass + 1) * 4, elapsed: performance.now() - started, done: (pass + 1) * 4 === samples}, [pixels.buffer]);
+    }
+  } catch (error) { self.postMessage({error: String(error)}); }
+};
