+      --toast-height: 64px;
+      --toast-gap: 12px;
+      position: fixed;
+      inset: auto 16px 16px auto;
+      /* Toasts are appended last in body. Only other toasts follow them. */
+      bottom: calc(16px + (sibling-count() - sibling-index()) * (var(--toast-height) + var(--toast-gap)));
+      margin: 0;
+      width: min(320px, calc(100vw - 32px));
+      height: var(--toast-height);
+      padding: 12px 16px;
+      border: 1px solid var(--secondary);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(0 0 0 / 18%);
+      align-items: center;
+      justify-content: space-between;
+      gap: 16px;
+      opacity: 0;
+      transform: translateX(24px);
+      transition: opacity 220ms ease, transform 220ms ease, bottom 220ms ease,
+        display 220ms allow-discrete, overlay 220ms allow-discrete;
+    }
+
+    .toast:popover-open {
