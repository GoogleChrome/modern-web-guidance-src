+  <div id="cart-status" class="sr-only" role="status" aria-atomic="true"></div>
+
+  <script>
+    let toastId = 0;
+    const cartStatus = document.getElementById('cart-status');
+
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const toast = document.createElement('div');
+        toast.className = 'toast';
+        toast.id = `cart-toast-${++toastId}`;
+        toast.setAttribute('popover', 'manual');
+        toast.setAttribute('role', 'group');
+        toast.setAttribute('aria-label', 'Cart notification');
+
+        const message = document.createElement('span');
+        message.textContent = 'added to cart!';
+
+        const close = document.createElement('button');
+        close.type = 'button';
+        close.className = 'toast-close';
+        close.setAttribute('aria-label', 'Close notification');
+        close.setAttribute('popovertarget', toast.id);
+        close.setAttribute('popovertargetaction', 'hide');
+        close.textContent = '×';
+
+        toast.append(message, close);
+        // Each toast is its own top-layer element; no layout wrapper is needed.
+        document.body.append(toast);
+        toast.showPopover();
+        cartStatus.replaceChildren(document.createTextNode('added to cart!'));
+
+        const timeout = window.setTimeout(() => toast.hidePopover(), 3000);
+        toast.addEventListener('beforetoggle', (event) => {
+          if (event.newState !== 'closed') return;
+          window.clearTimeout(timeout);
+          // Keep the node alive until its CSS exit transition has finished.
+          window.setTimeout(() => toast.remove(), 240);
+        });
+      });
+    });
+  </script>
+
