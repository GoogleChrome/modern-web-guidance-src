+    /* Each manual popover enters the top layer independently. Toasts are
+       appended last in body, so only newer toasts count toward this offset. */
+    .toast {
+      --toast-height: 4.5rem;
+      position: fixed;
+      inset: auto;
+      right: max(1rem, env(safe-area-inset-right));
+      bottom: calc(max(1rem, env(safe-area-inset-bottom)) +
+        (sibling-count() - sibling-index()) * (var(--toast-height) + 0.75rem));
+      margin: 0;
+      width: min(22rem, calc(100vw - 2rem));
+      height: var(--toast-height);
+      padding: 1rem;
+      border: 1px solid var(--secondary);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(62 39 35 / 20%);
+      opacity: 0;
+      transform: translateX(calc(100% + 2rem));
+      transition:
+        opacity 220ms ease,
+        transform 220ms ease,
+        bottom 220ms ease,
+        display 220ms allow-discrete,
+        overlay 220ms allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 1rem;
+      opacity: 1;
+      transform: translateX(0);
+    }
+
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        transform: translateX(calc(100% + 2rem));
+      }
+    }
+
+    .toast::backdrop {
+      background: transparent;
+      pointer-events: none;
+    }
+
+    .toast-close {
+      flex: none;
+      width: 2rem;
+      height: 2rem;
+      border: 0;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font: inherit;
+      font-size: 1.5rem;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    .toast-close:hover {
+      background: rgb(255 255 255 / 15%);
+    }
+
+    .toast-close:focus-visible,
+    .toast-trigger:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transition-duration: 0.01ms;
+      }
+    }
+
