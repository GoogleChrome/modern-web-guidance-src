+  <script>
+    (() => {
+      const button = document.getElementById('summarize-journal');
+      const status = document.getElementById('journal-status');
+      const story = document.getElementById('journal-story');
+      const summary = document.getElementById('journal-summary');
+      const points = document.getElementById('journal-summary-points');
+      const options = {
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', (event) => {
+            const total = event.total || 1;
+            const percent = Math.min(100, Math.round(event.loaded / total * 100));
+            status.textContent = `Downloading the browser's AI model: ${percent}%. This may take a few minutes.`;
+          });
+        },
+      };
+
+      async function checkAvailability() {
+        if (!window.isSecureContext || !('Summarizer' in window)) {
+          status.textContent = 'On-device summaries are unavailable here. Try a browser with native Summarizer support on HTTPS or localhost.';
+          return;
+        }
+
+        try {
+          const availability = await window.Summarizer.availability(options);
+          if (availability === 'unavailable') {
+            status.textContent = 'Your browser’s AI model is unavailable on this device. You can still read the full journal above.';
+            return;
+          }
+          button.disabled = false;
+          status.textContent = availability === 'available'
+            ? 'Get a few key points with AI running on your device.'
+            : 'The first summary needs a browser AI model download. Select Summarize to begin; the summary is generated on your device.';
+        } catch {
+          status.textContent = 'Could not check your browser’s AI support. Reload the page to try again.';
+        }
+      }
+
+      button.addEventListener('click', async () => {
+        let summarizer;
+        button.disabled = true;
+        button.textContent = 'Summarizing…';
+        summary.setAttribute('aria-busy', 'true');
+        status.textContent = 'Preparing your browser’s AI model…';
+
+        try {
+          // Create directly within the click gesture so model downloads are allowed.
+          summarizer = await window.Summarizer.create(options);
+          status.textContent = 'Reading the journal and gathering the key points…';
+          const result = await summarizer.summarize(story.innerText);
+          const items = result.split(/\n+/)
+            .map((line) => line.replace(/^\s*(?:[-*•‣]|\d+[.)])\s+/, '').trim())
+            .filter(Boolean);
+          if (!items.length) throw new Error('Empty summary');
+
+          points.replaceChildren(...items.map((text) => {
+            const item = document.createElement('li');
+            item.textContent = text;
+            return item;
+          }));
+          summary.hidden = false;
+          status.textContent = 'Your AI-generated summary is ready below. Refer to the full journal for details.';
+        } catch {
+          status.textContent = 'We couldn’t create a summary. Please try again; if a model download is needed, check your connection and browser permissions.';
+        } finally {
+          summarizer?.destroy();
+          summary.setAttribute('aria-busy', 'false');
+          button.disabled = false;
+          button.textContent = 'Summarize';
+        }
+      });
+
+      checkAvailability();
+    })();
+  </script>
+
