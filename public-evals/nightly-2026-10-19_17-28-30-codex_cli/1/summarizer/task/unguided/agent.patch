+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalStatus = document.getElementById('journal-status');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-summary-points');
+
+    summarizeButton.addEventListener('click', async () => {
+      if (!('Summarizer' in window)) {
+        journalStatus.textContent = 'Summarizing isn’t available in this browser. Try a browser with built-in AI Summarizer support, such as desktop Chrome. You can still read the full journal below.';
+        return;
+      }
+
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.setAttribute('aria-busy', 'true');
+      journalStatus.textContent = 'Preparing your browser’s AI. First use may require a model download.';
+      let summarizer;
+
+      try {
+        // Create directly from the click to preserve user activation for model downloads.
+        summarizer = await window.Summarizer.create({
+          type: 'key-points',
+          format: 'plain-text',
+          length: 'short',
+          expectedInputLanguages: ['en'],
+          outputLanguage: 'en',
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              journalStatus.textContent = `Downloading your browser’s AI model… ${Math.round(event.loaded * 100)}%`;
+            });
+          }
+        });
+        journalStatus.textContent = 'Summarizing the sourcing story…';
+        const text = document.getElementById('journal-copy').innerText;
+        const summary = await summarizer.summarize(text);
+        const points = summary.split(/\n+/)
+          .map((point) => point.replace(/^\s*(?:[-*•‣–]\s*|\d+[.)]\s+)/, '').trim())
+          .filter(Boolean);
+        if (!points.length) throw new Error('Empty summary');
+
+        summaryPoints.replaceChildren(...points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        }));
+        summaryPanel.hidden = false;
+        journalStatus.textContent = 'Summary ready. Generated on your device with AI; the full story is below.';
+      } catch (error) {
+        journalStatus.textContent = error.name === 'NotSupportedError'
+          ? 'Your browser’s AI summarizer isn’t available on this device. You can still read the full journal below.'
+          : 'We couldn’t create a summary. Check your connection if the AI model needs downloading, then try again. The full journal is below.';
+      } finally {
+        if (summarizer) summarizer.destroy();
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+        summaryPanel.setAttribute('aria-busy', 'false');
+      }
+    });
+  </script>
+
 </body>
 
