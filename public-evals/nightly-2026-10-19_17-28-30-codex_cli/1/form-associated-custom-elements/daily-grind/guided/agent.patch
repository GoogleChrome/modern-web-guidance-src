+const star = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.8 5.7 6.3.9-4.6 4.5 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z"/></svg>';
+const labels = ['Poor', 'Fair', 'Good', 'Great', 'Excellent'];
+const supported = 'attachInternals' in HTMLElement.prototype && 'ElementInternals' in window && 'setFormValue' in ElementInternals.prototype;
+
+class RatingInput extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['required', 'value'];
+  #internals;
+  #value = '';
+  #disabled = false;
+  #fallback;
+  constructor() {
+    super();
+    if (supported) this.#internals = this.attachInternals();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.innerHTML = `<style>
+      :host{display:block} .stars{display:flex;gap:10px}button{width:58px;height:59px;display:grid;place-items:center;border:1px solid #dce5d5;border-radius:9px;background:#fff;cursor:pointer;color:#a4b19b;box-shadow:0 2px 3px #3a572508;transition:background .15s,border-color .15s,transform .15s}svg{width:28px;height:28px;fill:none;stroke:currentColor;stroke-width:1.35;stroke-linecap:round;stroke-linejoin:round}button.filled{background:#e9f1df;border-color:#c5d8b4;color:#729453}button.filled svg{fill:#92b16f;stroke:#729453}button.selected{border:1.5px solid #729753;box-shadow:0 0 0 3px #ecf2e5}button:hover:not(:disabled){transform:translateY(-2px);background:#eef4e7;border-color:#8fae75}button:focus-visible{outline:2px solid #397d50;outline-offset:4px}button:disabled{opacity:.4;cursor:not-allowed}.stars:has(button:hover:not(:disabled)) button{box-shadow:none}@media(max-width:390px){.stars{gap:7px}button{width:48px;height:52px}svg{width:25px;height:25px}}@media(prefers-reduced-motion:reduce){button{transition:none}}
+    </style><div class="stars" role="radiogroup" aria-label="Experience rating">${labels.map((label, i) => `<button type="button" role="radio" aria-checked="false" aria-label="${i + 1} of 5 stars: ${label}" data-value="${i + 1}" tabindex="${i === 0 ? 0 : -1}">${star}</button>`).join('')}</div>`;
+    root.addEventListener('click', event => {
+      const button = event.target.closest('button');
+      if (button && !this.#disabled) this.#select(button.dataset.value);
+    });
+    root.addEventListener('keydown', event => {
+      if (this.#disabled || event.isComposing) return;
+      const keys = ['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End'];
+      if (!keys.includes(event.key)) return;
+      event.preventDefault();
+      let next = Number(this.value || 1);
+      if (event.key === 'Home') next = 1;
+      else if (event.key === 'End') next = 5;
+      else next = ((next - 1 + (['ArrowRight', 'ArrowDown'].includes(event.key) ? 1 : -1) + 5) % 5) + 1;
+      this.#select(String(next));
+      root.querySelector(`[data-value="${next}"]`).focus();
+    });
+  }
+  connectedCallback() {
+    if (!supported && !this.#fallback) {
+      // Only legacy engines need a native proxy. Modern browsers use FACE.
+      this.#fallback = document.createElement('input');
+      this.#fallback.type = 'text';
+      this.#fallback.className = 'sr-only';
+      this.#fallback.tabIndex = -1;
+      this.#fallback.setAttribute('aria-label', 'Experience rating');
+      this.append(this.#fallback);
+      this.closest('form')?.addEventListener('reset', () => this.formResetCallback());
+      this.#fallback.addEventListener('invalid', () => this.dispatchEvent(new Event('invalid')));
+    }
+    this.value = this.getAttribute('value') || '';
+    this.#sync();
+  }
+  attributeChangedCallback(name) {
+    if (name === 'value') this.value = this.getAttribute('value') || '';
+    else this.#sync();
+  }
+  get value() { return this.#value; }
+  set value(value) {
+    const normalized = String(value ?? '');
+    this.#value = /^[1-5]$/.test(normalized) ? normalized : '';
+    this.#sync();
+  }
+  get form() { return this.#internals?.form || this.closest('form'); }
+  get validity() { return (this.#internals || this.#fallback)?.validity; }
+  get validationMessage() { return (this.#internals || this.#fallback)?.validationMessage || ''; }
+  get willValidate() { return (this.#internals || this.#fallback)?.willValidate || false; }
+  checkValidity() { return (this.#internals || this.#fallback).checkValidity(); }
+  reportValidity() { return (this.#internals || this.#fallback).reportValidity(); }
+  syncName() { this.#sync(); }
+  #select(value) {
+    if (value === this.value) return;
+    this.value = value;
+    this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true, inputType: 'insertReplacementText' }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+  #sync() {
+    if (!this.shadowRoot) return;
+    const buttons = [...this.shadowRoot.querySelectorAll('button')];
+    for (const button of buttons) {
+      const selected = button.dataset.value === this.value;
+      button.classList.toggle('filled', Number(button.dataset.value) <= Number(this.value));
+      button.classList.toggle('selected', selected);
+      button.setAttribute('aria-checked', String(selected));
+      button.disabled = this.#disabled;
+      button.tabIndex = !this.#disabled && (selected || (!this.value && button.dataset.value === '1')) ? 0 : -1;
+    }
+    const missing = this.hasAttribute('required') && !this.value;
+    const group = this.shadowRoot.querySelector('[role=radiogroup]');
+    group.setAttribute('aria-required', String(this.hasAttribute('required')));
+    group.setAttribute('aria-disabled', String(this.#disabled));
+    if (this.#internals) {
+      this.#internals.setFormValue(this.value, this.value);
+      this.#internals.setValidity(missing ? { valueMissing: true } : {}, missing ? 'Please choose a rating.' : '', buttons[0]);
+    }
+    if (this.#fallback) {
+      this.#fallback.name = this.getAttribute('name') || '';
+      this.#fallback.value = this.value;
+      this.#fallback.required = this.hasAttribute('required');
+      this.#fallback.disabled = this.#disabled;
+      this.#fallback.setCustomValidity(missing ? 'Please choose a rating.' : '');
+    }
+  }
+  #lifecycle(name, detail) { this.dispatchEvent(new CustomEvent('lifecycle', { bubbles: true, detail: { name, detail } })); }
+  formAssociatedCallback(form) { this.#lifecycle('formAssociatedCallback', form ? 'Connected to #demo-form' : 'Disconnected from form'); }
+  formResetCallback() { this.value = this.getAttribute('value') || ''; this.#lifecycle('formResetCallback', 'Restored the default value'); }
+  formDisabledCallback(disabled) { this.#disabled = disabled; this.#sync(); this.#lifecycle('formDisabledCallback', `disabled → ${disabled}`); }
+  formStateRestoreCallback(state, mode) { this.value = typeof state === 'string' ? state : ''; this.#lifecycle('formStateRestoreCallback', `value → "${this.value}" · ${mode || 'restore'}`); }
+}
+customElements.define('rating-input', RatingInput);
+
+const $ = selector => document.querySelector(selector);
+const rating = $('#rating');
+const form = $('#demo-form');
+let savedState = null;
+let submittedData = null;
+let eventTotal = 0;
+let toastTimer;
+function toast(message) {
+  const node = $('#toast'); node.textContent = message; node.hidden = false;
+  clearTimeout(toastTimer); toastTimer = setTimeout(() => node.hidden = true, 2800);
+}
+function log(name, detail, invalid = false) {
+  const row = document.createElement('div'); row.className = `event-entry${invalid ? ' invalid' : ''}`;
+  const marker = document.createElement('span'); marker.className = 'event-marker';
+  const info = document.createElement('div'); info.className = 'event-info';
+  const title = document.createElement('div'); title.className = 'event-name'; title.textContent = name;
+  const description = document.createElement('div'); description.className = 'event-detail'; description.textContent = detail;
+  const time = document.createElement('span'); time.className = 'event-time'; time.textContent = new Date().toLocaleTimeString('en-GB', { hour12: false });
+  info.append(title, description); row.append(marker, info, time);
+  $('#event-log').prepend(row);
+  while ($('#event-log').children.length > 40) $('#event-log').lastElementChild.remove();
+  $('#event-count').textContent = String(++eventTotal);
+}
+function clearError() { $('#validation-error').hidden = true; }
+function updateUI() {
+  const disabled = $('#demo-fieldset').disabled;
+  const valid = disabled || !rating.validity || rating.validity.valid;
+  $('#current-value').textContent = JSON.stringify(rating.value);
+  $('#current-name').textContent = JSON.stringify(rating.getAttribute('name') || '');
+  $('#validity-status').textContent = disabled ? 'Control disabled' : rating.value ? 'Valid selection' : rating.hasAttribute('required') ? 'Awaiting selection' : 'Valid · optional';
+  $('#state-dot').classList.toggle('valid', valid && !disabled);
+  $('#rating-description').textContent = disabled ? 'Taking a little break.' : rating.value ? `${labels[Number(rating.value) - 1]} — ${rating.value} out of 5` : 'Pick a star, any star.';
+  $('#required-mark').hidden = !rating.hasAttribute('required');
+}
+rating.addEventListener('input', () => { clearError(); updateUI(); log('input', `value → "${rating.value}"`); });
+rating.addEventListener('change', () => log('change', `Rating committed: ${rating.value} of 5`));
+rating.addEventListener('lifecycle', event => { log(event.detail.name, event.detail.detail); updateUI(); });
+rating.addEventListener('invalid', () => {
+  $('#validation-error').textContent = rating.validationMessage || 'Please choose a rating.';
+  $('#validation-error').hidden = false;
+  log('invalid', 'Required: please choose a rating', true);
+});
+form.addEventListener('submit', event => {
+  event.preventDefault();
+  submittedData = Object.fromEntries(new FormData(form));
+  $('#form-output').textContent = JSON.stringify(submittedData, null, 2);
+  $('#data-badge').textContent = 'Submitted successfully';
+  log('submit', Object.keys(submittedData).length ? 'FormData captured successfully' : 'Empty FormData · control disabled or unnamed');
+  toast('Form submitted. Take a look at your data.');
+});
+form.addEventListener('reset', () => {
+  clearError();
+  submittedData = null;
+  $('#form-output').textContent = '{\n  // Your submitted data will appear here\n}';
+  $('#data-badge').textContent = 'Ready to submit';
+  queueMicrotask(updateUI);
+});
+$('#control-name').addEventListener('input', event => { rating.setAttribute('name', event.target.value); rating.syncName(); updateUI(); });
+$('#required-toggle').addEventListener('change', event => {
+  rating.toggleAttribute('required', event.target.checked); clearError(); updateUI(); log('attributeChanged', `required → ${event.target.checked}`);
+});
+$('#disabled-toggle').addEventListener('change', event => {
+  $('#demo-fieldset').disabled = event.target.checked;
+  if (!supported) rating.formDisabledCallback(event.target.checked);
+  clearError(); updateUI();
+});
+$('#save-state').addEventListener('click', () => {
+  savedState = rating.value;
+  $('#restore-state').disabled = false;
+  $('#saved-state').textContent = `Saved value: ${JSON.stringify(savedState)}`;
+  log('stateSaved', `value → ${JSON.stringify(savedState)}`);
+  toast('State saved. Try another rating, then restore.');
+});
+$('#restore-state').addEventListener('click', () => {
+  if (savedState === null) return;
+  rating.formStateRestoreCallback(savedState, 'restore (demo)');
+  clearError(); updateUI(); toast('Saved rating restored.');
+});
+$('#clear-events').addEventListener('click', () => { $('#event-log').replaceChildren(); eventTotal = 0; $('#event-count').textContent = '0'; });
+const code = `class RatingInput extends HTMLElement {
+  static formAssociated = true;
+  #internals = this.attachInternals();
+
+  set value(value) {
+    this._value = value;
+    this.#internals.setFormValue(value, value);
+    this.#internals.setValidity(
+      this.hasAttribute('required') && !value
+        ? { valueMissing: true } : {},
+      this.hasAttribute('required') && !value
+        ? 'Please choose a rating.' : '',
+      this.shadowRoot.querySelector('button')
+    );
+  }
+
+  formResetCallback() { this.value = ''; }
+  formDisabledCallback(disabled) {
+    this.shadowRoot.querySelectorAll('button')
+      .forEach(button => button.disabled = disabled);
+  }
+  formStateRestoreCallback(state) {
+    this.value = state;
+  }
+}
+customElements.define('rating-input', RatingInput);`;
+$('#implementation-code').textContent = code;
+function switchTab(tab) {
+  const isCode = tab === 'code';
+  for (const button of document.querySelectorAll('[data-tab]')) {
+    const selected = button.dataset.tab === tab;
+    button.setAttribute('aria-selected', String(selected)); button.tabIndex = selected ? 0 : -1;
+  }
+  $('#preview-content').hidden = isCode; $('#code-content').hidden = !isCode;
+  for (const button of document.querySelectorAll('.nav-item[data-view]')) button.classList.toggle('active', button.dataset.view === (isCode ? 'implementation' : 'playground'));
+  $('#breadcrumb-current').textContent = isCode ? 'Implementation' : 'Playground';
+}
+for (const button of document.querySelectorAll('[data-tab]')) {
+  button.addEventListener('click', () => switchTab(button.dataset.tab));
+  button.addEventListener('keydown', event => {
+    if (!['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) return;
+    event.preventDefault(); const tab = event.key === 'Home' ? 'preview' : event.key === 'End' ? 'code' : button.dataset.tab === 'code' ? 'preview' : 'code';
+    switchTab(tab); $(`[data-tab="${tab}"]`).focus();
+  });
+}
+for (const button of document.querySelectorAll('[data-view]')) button.addEventListener('click', () => switchTab(button.dataset.view === 'implementation' ? 'code' : 'preview'));
+document.addEventListener('keydown', event => { if ((event.metaKey || event.ctrlKey) && event.key === '1') { event.preventDefault(); switchTab('preview'); } });
+async function copy(text) {
+  try { await navigator.clipboard.writeText(text); toast('Copied to clipboard.'); }
+  catch { toast('Clipboard unavailable. Select and copy the displayed text.'); }
+}
+$('#copy-code').addEventListener('click', () => copy(code));
+$('#copy-data').addEventListener('click', () => { if (submittedData === null) toast('Submit the form to capture data first.'); else copy(JSON.stringify(submittedData, null, 2)); });
+log('connectedCallback', 'Rating input is ready');
+log('formAssociatedCallback', supported ? 'Connected to #demo-form' : 'Legacy native input fallback active');
+if (!supported) { $('.associated').lastChild.textContent = 'Native fallback'; $('.feature-label').lastChild.textContent = 'Native input fallback'; }
+updateUI();
