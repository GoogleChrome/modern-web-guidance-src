+const logEntries = [];
+function emitLog(name, detail, color = '') {
+  const time = new Date().toLocaleTimeString('en-GB');
+  logEntries.push({ name, detail, color, time });
+  if (logEntries.length > 100) logEntries.shift();
+  renderLog();
+}
+function renderLog() {
+  const list = document.getElementById('event-list');
+  if (!list) return;
+  list.replaceChildren(...logEntries.map(entry => {
