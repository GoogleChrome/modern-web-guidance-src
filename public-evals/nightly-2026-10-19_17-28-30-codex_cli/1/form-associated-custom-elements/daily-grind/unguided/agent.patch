+    box.append(k, ': ', v, index < entries.length - 1 ? ',\n' : '\n');
+  });
+  box.append('}');
+  document.getElementById('entries').textContent = `${entries.length} entries`;
+  document.getElementById('rating-description').textContent = ['', 'Not so great', 'Could be better', 'It was okay', 'Pretty good!', 'Loved it!'][Number(rating.value)] || 'Choose a rating';
+  document.getElementById('missing').textContent = rating.validity.valueMissing;
+  document.getElementById('custom-error').textContent = rating.validity.customError;
+  document.getElementById('valid').textContent = rating.validity.valid;
+  document.getElementById('will-validate').textContent = rating.willValidate;
+  const pill = document.getElementById('valid-pill');
+  pill.textContent = !rating.willValidate ? '− Disabled' : rating.validity.valid ? '✓ Valid' : '! Invalid';
