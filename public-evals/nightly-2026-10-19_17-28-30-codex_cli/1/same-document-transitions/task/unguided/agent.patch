+  <script>
+    const coffees = {
+      'maple-oat-latte': {
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        notes: 'Our signature espresso meets steamed oat milk and the mellow sweetness of maple. A cozy companion for crisp mornings.'
+      },
+      'dark-roast-espresso': {
+        description: 'Bold, smoky, and perfect for a morning boost.',
+        notes: 'A rich dark roast with notes of bittersweet chocolate and toasted nuts, finished with a velvety crema. Enjoy it slowly, one small sip at a time.'
+      },
+      'cold-brew': {
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        notes: 'Slowly brewed in cool water for a rounded, naturally sweet finish. Served over ice for a refreshing pick-me-up any time of day.'
+      }
+    };
+    const listPage = document.querySelector('#list-page');
+    const detailPage = document.querySelector('#detail-page');
+    const hero = document.querySelector('#hero');
+    const title = document.querySelector('#title');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    let current = null;
+    let listScroll = 0;
+    let running = false;
+    let activeTransition;
+    let pending = false;
+
+    function route() {
+      const slug = location.hash.slice(2);
+      return Object.hasOwn(coffees, slug) ? slug : null;
+    }
+
+    function cardFor(slug) {
+      return document.querySelector(`[data-coffee="${slug}"]`);
+    }
+
+    function share(element, heading) {
+      element.style.viewTransitionName = 'seasonal-image';
+      heading.style.viewTransitionName = 'seasonal-title';
+    }
+
+    function cleanup() {
+      document.querySelectorAll('.thumbnail, .thumbnail .title, #hero, #title').forEach(element => {
+        element.style.removeProperty('view-transition-name');
+      });
+      document.documentElement.classList.remove('is-transitioning');
+    }
+
+    function render(next) {
+      if (next) {
+        const card = cardFor(next);
+        title.textContent = card.querySelector('.title').textContent;
+        document.querySelector('#detail-image').src = card.querySelector('img').src;
+        document.querySelector('#description').textContent = coffees[next].description;
+        document.querySelector('#tasting-notes').textContent = coffees[next].notes;
+      }
+      listPage.hidden = Boolean(next);
+      detailPage.hidden = !next;
+      current = next;
+      document.title = next ? `${title.textContent} | The Daily Grind` : 'The Daily Grind | Artisanal Coffee';
+      window.scrollTo({ top: next ? 0 : listScroll, behavior: 'instant' });
+    }
+
+    async function navigate() {
+      pending = true;
+      if (running) {
+        activeTransition?.skipTransition();
+        return;
+      }
+      running = true;
+      try {
+        while (pending) {
+          pending = false;
+          const next = route();
+          if (next === current) continue;
+          if (!current) listScroll = window.scrollY;
+          const selected = cardFor(next || current);
+          const focusHeading = next ? title : document.querySelector('#list-heading');
+          try {
+            if (document.startViewTransition && !reducedMotion.matches) {
+              if (current) share(hero, title);
+              else share(selected, selected.querySelector('.title'));
+              document.documentElement.classList.add('is-transitioning');
+              activeTransition = document.startViewTransition(() => {
+                cleanup();
+                render(next);
+                if (next) share(hero, title);
+                else share(selected, selected.querySelector('.title'));
+                document.documentElement.classList.add('is-transitioning');
+              });
+              await activeTransition.finished;
+            } else {
+              render(next);
+            }
+          } catch (error) {
+            // A failed or interrupted visual transition must never prevent navigation.
+            render(next);
+          } finally {
+            activeTransition = null;
+            cleanup();
+            focusHeading.focus({ preventScroll: true });
+          }
+        }
+      } finally {
+        running = false;
+      }
+    }
+
+    window.addEventListener('hashchange', navigate);
+    reducedMotion.addEventListener('change', event => {
+      if (event.matches) activeTransition?.skipTransition();
+    });
+    // Direct links render immediately; subsequent hash navigation morphs in place.
+    if (route()) {
+      render(route());
+      title.focus({ preventScroll: true });
+    }
+  </script>
