+  <script>
+    const cartList = document.querySelector('.SwipeableList');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+    function removeItem(item, direction = -1) {
+      if (item.classList.contains('is-removing')) return;
+      const name = item.querySelector('h3').textContent;
+      const moveFocus = item.contains(document.activeElement);
+      const nextButton = (item.nextElementSibling || item.previousElementSibling)?.querySelector('button');
+      item.classList.remove('is-dragging');
+      item.classList.add('is-removing');
+      item.querySelector('button').disabled = true;
+      item.style.height = `${item.getBoundingClientRect().height}px`;
+      item.style.setProperty('--swipe-offset', `${direction * item.offsetWidth}px`);
+      setTimeout(() => {
+        item.style.height = '0px';
+        item.style.opacity = '0';
+        setTimeout(() => {
+          item.remove();
+          const items = [...cartList.children];
+          document.querySelector('#cart-count').textContent = `${items.length} item${items.length === 1 ? '' : 's'}`;
+          document.querySelector('#cart-total').textContent = currency.format(items.reduce((sum, row) => sum + Number(row.dataset.price), 0) / 100);
+          document.querySelector('.cart-empty').hidden = items.length > 0;
+          document.querySelector('#cart-status').textContent = `${name} removed from your cart.`;
+          if (moveFocus) {
+            const target = nextButton?.isConnected && !nextButton.disabled ? nextButton : document.querySelector('#cart-title');
+            if (target.id === 'cart-title') target.tabIndex = -1;
+            target.focus();
+          }
+        }, reducedMotion.matches ? 0 : 280);
+      }, reducedMotion.matches ? 0 : 220);
+    }
+
+    cartList.querySelectorAll('.SwipeableList-item').forEach(item => {
+      const content = item.querySelector('.SwipeableList-content');
+      let gesture = null;
+      const reset = () => {
+        gesture = null;
+        item.classList.remove('is-dragging', 'is-ready');
+        item.style.setProperty('--swipe-offset', '0px');
+      };
+      content.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0 || event.target.closest('button') || item.classList.contains('is-removing')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, offset: 0, horizontal: false };
+        content.setPointerCapture(event.pointerId);
+      });
+      content.addEventListener('pointermove', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.horizontal) {
+          if (Math.max(Math.abs(dx), Math.abs(dy)) < 8) return;
+          if (Math.abs(dy) > Math.abs(dx)) { reset(); return; }
+          gesture.horizontal = true;
+          item.classList.add('is-dragging');
+        }
+        gesture.offset = dx;
+        item.style.setProperty('--swipe-offset', `${dx}px`);
+        item.classList.toggle('is-ready', Math.abs(dx) >= Math.min(110, content.offsetWidth * 0.28));
+      });
+      content.addEventListener('pointerup', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const offset = gesture.offset;
+        const shouldRemove = gesture.horizontal && item.classList.contains('is-ready');
+        gesture = null;
+        if (content.hasPointerCapture(event.pointerId)) content.releasePointerCapture(event.pointerId);
+        if (shouldRemove) removeItem(item, Math.sign(offset));
+        else reset();
+      });
+      content.addEventListener('pointercancel', reset);
+      content.addEventListener('lostpointercapture', () => { if (gesture) reset(); });
+      item.querySelector('button').addEventListener('click', () => removeItem(item));
+    });
+  </script>
