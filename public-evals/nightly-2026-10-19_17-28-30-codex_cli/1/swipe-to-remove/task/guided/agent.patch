+  <script>
+    const list = document.querySelector('.SwipeableList');
+    const handles = new WeakMap();
+    const needsScrollWorkaround = !CSS.supports('scroll-initial-target', 'nearest');
+    const trackWidths = new WeakMap();
+    const resizeObserver = needsScrollWorkaround ? new ResizeObserver(entries => {
+      for (const { target } of entries) {
+        // Height changes must not reset a swipe or interrupt a collapsing row.
+        if (trackWidths.get(target) !== target.clientWidth) {
+          trackWidths.set(target, target.clientWidth);
+          target.scrollLeft = target.clientWidth;
+        }
+      }
+    }) : null;
+
+    const viewportObserver = new IntersectionObserver(entries => {
+      for (const entry of entries) {
+        const item = entry.target;
+        if (item.classList.contains('is-removing')) continue;
+        if (entry.isIntersecting) {
+          const handle = handles.get(item) || setupItem(item);
+          handle.observer.observe(handle.content);
+        } else {
+          handles.get(item)?.observer.disconnect();
+        }
+      }
+    });
+
+    function setupItem(item) {
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      item.classList.add('is-initialized');
+      // Center the row before observing so initial positioning cannot remove it.
+      if (needsScrollWorkaround) {
+        track.scrollLeft = track.clientWidth;
+        trackWidths.set(track, track.clientWidth);
+        resizeObserver.observe(track);
+      }
+      const observer = new IntersectionObserver(entries => {
+        if (item.classList.contains('is-removing')) return;
+        const entry = entries.at(-1);
+        if (!entry.rootBounds || !entry.boundingClientRect.width) return;
+        const offset = entry.boundingClientRect.x - entry.rootBounds.x;
+        // Use horizontal displacement so vertical page clipping never commits.
+        const progress = Math.abs(offset) / entry.boundingClientRect.width;
+        item.dataset.swipeDirection = offset > 0 ? 'left' : 'right';
+        item.classList.toggle('is-activating', progress > 0.2);
+        if (progress > 0.8) removeItem(item);
+      }, { root: track, threshold: [0, 0.2, 0.8, 1] });
+      const handle = { observer, content };
+      handles.set(item, handle);
+      return handle;
+    }
+
+    async function removeItem(item) {
+      if (item.classList.contains('is-removing')) return;
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      const height = item.getBoundingClientRect().height;
+      const offset = content.getBoundingClientRect().x - track.getBoundingClientRect().x;
+      const distance = offset > 0 ? track.clientWidth - offset : -track.clientWidth - offset;
+      const focusWasInside = item.contains(document.activeElement);
+      const remaining = [...list.children].filter(row => row !== item && !row.classList.contains('is-removing'));
+      const nextFocus = remaining.find(row => row.compareDocumentPosition(item) & Node.DOCUMENT_POSITION_PRECEDING) || remaining.at(-1);
+      viewportObserver.unobserve(item);
+      handles.get(item)?.observer.disconnect();
+      resizeObserver?.unobserve(track);
+      item.classList.add('is-removing');
+      item.inert = true;
+      if (focusWasInside) {
+        if (nextFocus) nextFocus.querySelector('.cart-remove').focus({ preventScroll: true });
+        else {
+          const title = document.getElementById('cart-title');
+          title.tabIndex = -1;
+          title.focus({ preventScroll: true });
+        }
+      }
+      const duration = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 300;
+      const options = { duration, easing: 'ease', fill: 'forwards' };
+      await Promise.allSettled([
+        item.animate([{ height: `${height}px` }, { height: '0px' }], options).finished,
+        content.animate([{ transform: 'translateX(0)' }, { transform: `translateX(${distance}px)` }], options).finished
+      ]);
+      updateCart(`${item.dataset.name} removed from your cart.`);
+      // Keep the collapsed row until Safari's swipe momentum has settled.
+      if (globalThis.GestureEvent) setTimeout(() => item.remove(), 5000);
+      else item.remove();
+    }
+
+    function updateCart(message) {
+      const items = [...list.children].filter(item => !item.classList.contains('is-removing'));
+      document.getElementById('cart-count').textContent = `${items.length} ${items.length === 1 ? 'item' : 'items'}`;
+      document.getElementById('cart-subtotal').textContent = new Intl.NumberFormat('en-US', {
+        style: 'currency', currency: 'USD'
+      }).format(items.reduce((total, item) => total + Number(item.dataset.price), 0) / 100);
+      document.getElementById('cart-empty').hidden = items.length > 0;
+      document.getElementById('cart-status').textContent = message;
+    }
+
+    list.addEventListener('click', event => {
+      const button = event.target.closest('.cart-remove');
+      if (button) removeItem(button.closest('.SwipeableList-item'));
+    });
+    for (const item of list.children) viewportObserver.observe(item);
+    new MutationObserver(mutations => {
+      for (const mutation of mutations) {
+        for (const node of mutation.addedNodes) {
+          if (node.nodeType === Node.ELEMENT_NODE && node.matches('.SwipeableList-item')) {
+            viewportObserver.observe(node);
+          }
+        }
+      }
+    }).observe(list, { childList: true });
+  </script>
