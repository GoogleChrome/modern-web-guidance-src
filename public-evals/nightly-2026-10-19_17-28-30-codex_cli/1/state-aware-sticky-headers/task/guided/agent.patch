+  <script>
+    const navigation = document.querySelector('nav');
+    const stickyHeaders = document.querySelectorAll('.sticky-container');
+    const needsFallback = !CSS.supports('container-type', 'scroll-state');
+    let stickyObserver;
+
+    if (needsFallback) {
+      stickyHeaders.forEach(container => {
+        const sentinel = document.createElement('div');
+        sentinel.className = 'sticky-sentinel';
+        sentinel.setAttribute('aria-hidden', 'true');
+        container.before(sentinel);
+      });
+    }
+
+    new ResizeObserver(() => {
+      const navHeight = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navHeight}px`);
+      if (!needsFallback) return;
+
+      stickyObserver?.disconnect();
+      stickyObserver = new IntersectionObserver(entries => {
+        entries.forEach(entry => {
+          entry.target.nextElementSibling.classList.toggle(
+            'is-stuck', entry.boundingClientRect.bottom <= navHeight
+          );
+        });
+      }, { root: null, rootMargin: `-${navHeight}px 0px 0px 0px`, threshold: 0 });
+      document.querySelectorAll('.sticky-sentinel').forEach(sentinel => stickyObserver.observe(sentinel));
+    }).observe(navigation);
+  </script>
+
 </body>
 
