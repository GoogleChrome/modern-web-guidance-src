+  <script>
+    const favorites = [
+      [
+        ['Maple Oat Latte', 'Creamy oat milk with a hint of Vermont maple syrup.', '/menu/seasonal'],
+        ['Dark Roast Espresso', 'Bold, smokey, and perfect for a morning boost.', '/menu/espresso'],
+        ['Cold Brew', 'Steeped for 18 hours for maximum smoothness.', '/menu/cold-brew'],
+      ],
+      [
+        ['Pumpkin Spice Latte', 'Warming spices, rich espresso, and silky steamed milk.', '/menu/seasonal'],
+        ['Honey Cinnamon Cappuccino', 'Golden honey and cinnamon beneath a cloud of foam.', '/menu/espresso'],
+        ['Vanilla Cream Cold Brew', 'Our slow-steeped cold brew topped with vanilla cream.', '/menu/cold-brew'],
+      ],
+      [
+        ['Salted Caramel Latte', 'Buttery caramel and espresso with a touch of sea salt.', '/menu/seasonal'],
+        ['Mocha Espresso', 'Dark chocolate meets our signature roasted espresso.', '/menu/espresso'],
+        ['Maple Cold Brew', 'Smooth cold brew sweetened with Vermont maple syrup.', '/menu/cold-brew'],
+      ],
+    ];
+    const requestedPage = Number(new URL(window.location.href).searchParams.get('page') || 1);
+    const page = Number.isInteger(requestedPage)
+      ? Math.min(favorites.length, Math.max(1, requestedPage)) : 1;
+
+    document.querySelectorAll('.grid .card').forEach((card, index) => {
+      const [name, description, href] = favorites[page - 1][index];
+      card.querySelector('h3').textContent = name;
+      card.querySelector('p').textContent = description;
+      card.querySelector('a').href = href;
+    });
+    document.getElementById('page-number').textContent = `Page ${page} of ${favorites.length}`;
+    for (const [id, destination] of [['previous', page - 1], ['next', page + 1]]) {
+      const link = document.getElementById(id);
+      if (destination < 1 || destination > favorites.length) {
+        link.removeAttribute('href');
+        link.setAttribute('aria-disabled', 'true');
+      } else {
+        const url = new URL(window.location.href);
+        url.searchParams.set('page', destination);
+        link.href = url.href;
+        link.removeAttribute('aria-disabled');
+      }
+    }
+  </script>
