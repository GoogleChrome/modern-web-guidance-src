+  <script>
+    // Register early so the incoming page's first reveal receives its type.
+    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      const applyTransitionType = (transition, from, to) => {
+        if (!transition) return;
+        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+          transition.skipTransition();
+          return;
+        }
+        if (!transition.types || !from?.url || !to?.url) return;
+        const source = new URL(from.url);
+        const destination = new URL(to.url);
+        if (source.origin !== destination.origin || source.pathname !== destination.pathname) return;
+        const oldPage = Number(source.searchParams.get('page') || 1);
+        const newPage = Number(destination.searchParams.get('page') || 1);
+        if (newPage > oldPage) transition.types.add('next');
+        if (newPage < oldPage) transition.types.add('previous');
+      };
+
+      window.addEventListener('pageswap', (event) => {
+        applyTransitionType(event.viewTransition, event.activation?.from, event.activation?.entry);
+      });
+      window.addEventListener('pagereveal', (event) => {
+        const activation = window.navigation?.activation;
+        applyTransitionType(event.viewTransition, activation?.from, activation?.entry);
+      });
+    }
+  </script>
   <style>
+    @media (prefers-reduced-motion: no-preference) {
+      @view-transition {
+        navigation: auto;
+      }
+
+      ::view-transition-old(root) {
+        animation: page-out 320ms ease-in-out both;
+      }
+
+      ::view-transition-new(root) {
+        animation: page-in 320ms ease-in-out both;
+      }
+
+      html:active-view-transition-type(next) {
+        --page-exit: -12%;
+        --page-enter: 12%;
+      }
+
+      html:active-view-transition-type(previous) {
+        --page-exit: 12%;
+        --page-enter: -12%;
+      }
+
+      @keyframes page-out {
+        to { opacity: 0; transform: translateX(var(--page-exit, 0%)); }
+      }
+
+      @keyframes page-in {
+        from { opacity: 0; transform: translateX(var(--page-enter, 0%)); }
+      }
+    }
+
