+
+    .contact-form {
+      display: grid;
+      gap: 16px;
+      margin-top: 20px;
+    }
+
+    .contact-field {
+      padding: 16px;
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+    }
+
+    .contact-field label {
+      display: block;
+      margin-bottom: 6px;
+      font-weight: 600;
+    }
+
+    .contact-field input,
+    .contact-field textarea {
+      display: block;
+      width: 100%;
+      padding: 10px;
+      border: 1px solid #a1887f;
+      border-radius: 4px;
+      font: inherit;
+      color: var(--text);
+      background: white;
+    }
+
+    .contact-field textarea {
+      resize: vertical;
+      min-height: 140px;
+    }
+
+    .contact-form :focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    /* Highlight the entire wrapper only once the user has triggered validation. */
+    .contact-field:has(:user-invalid) {
+      border-color: #b3261e;
+    }
+
+    .contact-error {
+      display: none;
+      margin-top: 6px;
+      color: #b3261e;
+      font-size: 0.9rem;
+    }
+
+    .contact-field:has(:user-invalid) .contact-error {
+      display: block;
+    }
+
+    .contact-form .btn {
+      justify-self: start;
+      margin-top: 0;
+      border: 0;
+      font: inherit;
+      cursor: pointer;
+    }
