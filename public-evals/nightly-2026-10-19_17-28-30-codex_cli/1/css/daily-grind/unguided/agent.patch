diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..e6d14bb
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,253 @@
+/* Later layers take precedence; keep all author styles inside a layer. */
+@layer reset, tokens, base, layout, components, utilities;
+
+@layer reset {
+  :where(*, *::before, *::after) {
+    box-sizing: border-box;
+  }
+
+  :where(body, h1, h2, h3, p, ul) {
+    margin: 0;
+    padding: 0;
+  }
+}
+
+@layer tokens {
+  :root {
+    /* Palette and semantic roles are separate so themes can override roles. */
+    --color-brown-900: #3e2723;
+    --color-brown-800: #4e342e;
+    --color-brown-100: #d7ccc8;
+    --color-amber-400: #ffab40;
+    --color-white: #fff;
+    --color-neutral-50: #fafafa;
+
+    --color-brand: var(--color-brown-800);
+    --color-brand-hover: var(--color-brown-900);
+    --color-accent: var(--color-amber-400);
+    --color-text: var(--color-brown-900);
+    --color-on-brand: var(--color-white);
+    --color-page: var(--color-neutral-50);
+    --color-surface: var(--color-white);
+    --color-footer: var(--color-brown-100);
+    --color-focus: var(--color-text);
+    --color-hero-overlay: rgb(0 0 0 / 50%);
+
+    --font-family-body: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-small: 0.85rem;
+    --font-size-nav: 0.9rem;
+    --font-size-body: 1rem;
+    --font-size-logo: 1.5rem;
+    --font-size-hero: 3rem;
+    --font-weight-bold: 700;
+    --line-height-body: 1.6;
+    --letter-spacing-logo: 0.0625rem;
+
+    --space-1: 0.3125rem;
+    --space-2: 0.625rem;
+    --space-3: 0.75rem;
+    --space-4: 0.9375rem;
+    --space-5: 1rem;
+    --space-6: 1.25rem;
+    --space-7: 2.5rem;
+
+    --radius-small: 0.25rem;
+    --radius-button: 0.3125rem;
+    --radius-card: 0.5rem;
+    --border-width: 1px;
+    --shadow-card: 0 2px 5px rgb(0 0 0 / 10%);
+    --duration-interaction: 300ms;
+    --focus-width: 3px;
+    --focus-offset: 4px;
+    --z-navigation: 10;
+
+    --content-max-width: 68.75rem;
+    --page-gutter: var(--space-6);
+    --navigation-gutter: 5%;
+    --product-min-width: 15.625rem;
+    --hero-height: 60vh;
+    --hero-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  }
+}
+
+@layer base {
+  body {
+    font-family: var(--font-family-body);
+    font-size: var(--font-size-body);
+    line-height: var(--line-height-body);
+    color: var(--color-text);
+    background-color: var(--color-page);
+  }
+
+  :where(a) {
+    &:focus-visible {
+      outline: var(--focus-width) solid var(--color-focus);
+      outline-offset: var(--focus-offset);
+    }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    :root {
+      --duration-interaction: 0ms;
+    }
+  }
+}
+
+@layer layout {
+  .container {
+    max-inline-size: var(--content-max-width);
+    margin-block: var(--space-7);
+    margin-inline: auto;
+    padding-inline: var(--page-gutter);
+  }
+
+  .product-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--product-min-width)), 1fr));
+    gap: var(--space-6);
+    margin-block-start: var(--space-6);
+  }
+}
+
+@layer components {
+  /* Scope boundaries prevent component styles leaking into nested components.
+     :where() keeps descendant selectors at zero specificity within each scope. */
+  @scope (.site-nav) to ([data-style-boundary]) {
+    :scope {
+      --color-focus: var(--color-on-brand);
+
+      position: sticky;
+      inset-block-start: 0;
+      z-index: var(--z-navigation);
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      align-items: center;
+      gap: var(--space-5) var(--space-6);
+      padding-block: var(--space-5);
+      padding-inline: var(--navigation-gutter);
+      color: var(--color-on-brand);
+      background: var(--color-brand);
+    }
+
+    :where(.site-nav__logo) {
+      font-size: var(--font-size-logo);
+      font-weight: var(--font-weight-bold);
+      letter-spacing: var(--letter-spacing-logo);
+    }
+
+    :where(ul) {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: var(--space-2) var(--space-6);
+      list-style: none;
+    }
+
+    :where(a) {
+      color: var(--color-on-brand);
+      text-decoration: none;
+      font-size: var(--font-size-nav);
+      transition: color var(--duration-interaction);
+
+      &:hover {
+        color: var(--color-accent);
+      }
+    }
+
+    :where(.site-nav__logout) {
+      display: inline-block;
+      border: var(--border-width) solid var(--color-accent);
+      padding-block: var(--space-1);
+      padding-inline: var(--space-3);
+      border-radius: var(--radius-small);
+    }
+  }
+
+  @scope (.hero) to ([data-style-boundary]) {
+    :scope {
+      --color-focus: var(--color-on-brand);
+
+      min-block-size: var(--hero-height);
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      padding: var(--space-7) var(--page-gutter);
+      color: var(--color-on-brand);
+      text-align: center;
+      background-image: linear-gradient(var(--color-hero-overlay), var(--color-hero-overlay)), var(--hero-image);
+      background-size: cover;
+      background-position: center;
+    }
+
+    :where(h1) {
+      font-size: var(--font-size-hero);
+      margin-block-end: var(--space-5);
+    }
+  }
+
+  @scope (.product-card) to ([data-style-boundary]) {
+    :scope {
+      padding: var(--space-6);
+      border-radius: var(--radius-card);
+      box-shadow: var(--shadow-card);
+      text-align: center;
+      background: var(--color-surface);
+    }
+
+    :where(h3) {
+      margin-block-end: var(--space-2);
+      color: var(--color-brand);
+    }
+  }
+
+  /* Shared controls own their appearance independently of their parent. */
+  .button {
+    --button-background: var(--color-brand);
+
+    display: inline-block;
+    margin-block-start: var(--space-4);
+    padding: var(--space-2) var(--space-6);
+    border-radius: var(--radius-button);
+    color: var(--color-on-brand);
+    background: var(--button-background);
+    text-decoration: none;
+    transition: background-color var(--duration-interaction);
+
+    &:hover {
+      --button-background: var(--color-brand-hover);
+    }
+  }
+
+  @scope (.site-footer) to ([data-style-boundary]) {
+    :scope {
+      margin-block-start: var(--space-7);
+      padding: var(--space-7) var(--page-gutter);
+      background: var(--color-footer);
+      text-align: center;
+    }
+
+    :where(.site-footer__links) {
+      margin-block-end: var(--space-6);
+
+      & a {
+        display: inline-block;
+        margin-inline: var(--space-2);
+        color: var(--color-text);
+        text-decoration: none;
+        font-size: var(--font-size-small);
+
+        &:hover {
+          text-decoration: underline;
+        }
+      }
+    }
+  }
+}
+
+@layer utilities {
+  .text-center {
+    text-align: center;
+  }
+}
