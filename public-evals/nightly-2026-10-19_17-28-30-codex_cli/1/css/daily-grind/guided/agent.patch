diff --git a/styles/README.md b/styles/README.md
new file mode 100644
index 0000000..cbc3e07
--- /dev/null
+++ b/styles/README.md
@@ -0,0 +1,21 @@
+# Styles
+
+`main.css` uses native CSS with no build step. Keep all rules in a named layer;
+unlayered author rules would take priority over every layer here.
+
+The declared cascade order is `tokens → reset → base → layout → components`.
+Tokens define the palette, semantic colors, typography, spacing, and effects.
+Change semantic aliases to update the theme without editing component rules.
+The reset targets only the page's element types with zero-specificity `:where()`.
+Base styles provide inherited document defaults, layout classes arrange content,
+and component classes own their presentation.
+
+Scope component internals with shallow native nesting and direct-child selectors.
+Wrap structural filters in `:where()` so they do not increase specificity. Shared
+components such as `.btn` own their own styles, even inside another component.
+Use `@scope` when a future feature needs proximity-based styling or subtree
+boundaries; the current components only need class and direct-child scoping.
+Use logical properties for spacing and dimensions that follow writing direction.
+Avoid IDs, `!important`, inline styles, and unlayered overrides.
+
+The stylesheet requires browsers with cascade layers and native CSS nesting.
diff --git a/styles/main.css b/styles/main.css
new file mode 100644
index 0000000..fcc13dc
--- /dev/null
+++ b/styles/main.css
@@ -0,0 +1,212 @@
+/* Later layers take precedence without increasing selector specificity. */
+@layer tokens, reset, base, layout, components;
+
+@layer tokens {
+  :root {
+    /* Palette: literal values are kept here; components use semantic aliases. */
+    --color-brown-900: #3e2723;
+    --color-brown-800: #4e342e;
+    --color-brown-200: #d7ccc8;
+    --color-orange-400: #ffab40;
+    --color-gray-50: #fafafa;
+    --color-white: #fff;
+
+    --color-brand: var(--color-brown-800);
+    --color-brand-hover: var(--color-brown-900);
+    --color-accent: var(--color-orange-400);
+    --color-text: var(--color-brown-900);
+    --color-on-brand: var(--color-white);
+    --color-page: var(--color-gray-50);
+    --color-surface: var(--color-white);
+    --color-surface-muted: var(--color-brown-200);
+    --color-overlay: rgb(0 0 0 / 50%);
+
+    --font-body: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-small: 0.85rem;
+    --font-size-nav: 0.9rem;
+    --font-size-logo: 1.5rem;
+    --font-size-hero: 3rem;
+    --font-weight-bold: 700;
+    --line-height-body: 1.6;
+    --letter-spacing-logo: 0.0625rem;
+
+    --space-1: 0.3125rem;
+    --space-2: 0.625rem;
+    --space-3: 0.75rem;
+    --space-4: 0.9375rem;
+    --space-5: 1rem;
+    --space-6: 1.25rem;
+    --space-7: 2.5rem;
+
+    --radius-small: 0.25rem;
+    --radius-button: 0.3125rem;
+    --radius-card: 0.5rem;
+    --border-width: 1px;
+    --shadow-card: 0 2px 5px rgb(0 0 0 / 10%);
+    --duration-interaction: 0.3s;
+    --content-max: 68.75rem;
+    --card-min: 15.625rem;
+    --page-gutter: var(--space-6);
+    --nav-gutter: 5%;
+    --hero-height: 60vh;
+    --layer-sticky: 10;
+  }
+}
+
+@layer reset {
+  /* Reset only the elements this page uses; avoid universal reset leakage. */
+  :where(body, nav, header, main, section, footer, div, ul, li, h1, h2, h3, p, a) {
+    box-sizing: border-box;
+  }
+
+  :where(body, ul, h1, h2, h3, p) {
+    margin: 0;
+    padding: 0;
+  }
+}
+
+@layer base {
+  body {
+    font-family: var(--font-body);
+    line-height: var(--line-height-body);
+    color: var(--color-text);
+    background-color: var(--color-page);
+  }
+}
+
+@layer layout {
+  .container {
+    max-inline-size: var(--content-max);
+    margin-block: var(--space-7);
+    margin-inline: auto;
+    padding-inline: var(--page-gutter);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min)), 1fr));
+    gap: var(--space-6);
+    margin-block-start: var(--space-6);
+  }
+}
+
+@layer components {
+  .site-nav {
+    position: sticky;
+    inset-block-start: 0;
+    z-index: var(--layer-sticky);
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: var(--space-5) var(--space-6);
+    padding-block: var(--space-5);
+    padding-inline: var(--nav-gutter);
+    color: var(--color-on-brand);
+    background: var(--color-brand);
+
+    & > :where(.logo) {
+      font-size: var(--font-size-logo);
+      font-weight: var(--font-weight-bold);
+      letter-spacing: var(--letter-spacing-logo);
+    }
+
+    & > :where(ul) {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: var(--space-6);
+      padding-inline-start: var(--space-6);
+      list-style: none;
+    }
+
+    & > :where(ul) > :where(li) > :where(a) {
+      color: inherit;
+      text-decoration: none;
+      font-size: var(--font-size-nav);
+      transition: color var(--duration-interaction);
+
+      &:where(:hover, :focus-visible) {
+        color: var(--color-accent);
+      }
+
+      &.logout-link {
+        border: var(--border-width) solid var(--color-accent);
+        padding-block: var(--space-1);
+        padding-inline: var(--space-3);
+        border-radius: var(--radius-small);
+      }
+    }
+  }
+
+  .hero {
+    block-size: var(--hero-height);
+    background:
+      linear-gradient(var(--color-overlay), var(--color-overlay)),
+      url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80') center / cover;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    color: var(--color-on-brand);
+    text-align: center;
+    padding-inline: var(--page-gutter);
+
+    & > :where(h1) {
+      font-size: var(--font-size-hero);
+      margin-block-end: var(--space-5);
+    }
+  }
+
+  .section-title {
+    text-align: center;
+  }
+
+  .card {
+    background: var(--color-surface);
+    padding: var(--space-6);
+    border-radius: var(--radius-card);
+    box-shadow: var(--shadow-card);
+    text-align: center;
+
+    & > :where(h3) {
+      margin-block-end: var(--space-2);
+      color: var(--color-brand);
+    }
+  }
+
+  .btn {
+    display: inline-block;
+    background: var(--color-brand);
+    color: var(--color-on-brand);
+    padding-block: var(--space-2);
+    padding-inline: var(--space-6);
+    text-decoration: none;
+    border-radius: var(--radius-button);
+    margin-block-start: var(--space-4);
+    transition: background-color var(--duration-interaction);
+
+    &:where(:hover, :focus-visible) {
+      background-color: var(--color-brand-hover);
+    }
+  }
+
+  .site-footer {
+    background: var(--color-surface-muted);
+    text-align: center;
+    padding-block: var(--space-7);
+    padding-inline: var(--page-gutter);
+    margin-block-start: var(--space-7);
+
+    & > :where(.footer-links) {
+      margin-block-end: var(--space-6);
+
+      & > :where(a) {
+        margin-inline: var(--space-2);
+        color: inherit;
+        text-decoration: none;
+        font-size: var(--font-size-small);
+      }
+    }
+  }
+}
