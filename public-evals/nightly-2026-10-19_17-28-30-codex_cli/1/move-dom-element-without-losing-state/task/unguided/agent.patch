+  <script>
+    (() => {
+      const hero = document.querySelector('.hero');
+      const mainMount = document.getElementById('main-video-mount');
+      const heroMount = document.getElementById('hero-video-mount');
+      const player = document.getElementById('roasting-player');
+      const toggle = document.getElementById('theater-toggle');
+      const locationStatus = document.getElementById('video-location');
+      let theaterMode = false;
+      let usePositionFallback = typeof heroMount.moveBefore !== 'function';
+
+      function positionPlayer() {
+        if (!usePositionFallback) return;
+        const mount = theaterMode ? heroMount : mainMount;
+        const bounds = mount.getBoundingClientRect();
+        const parentBounds = player.parentElement.getBoundingClientRect();
+        // The player stays attached to its current positioned mount.
+        player.style.left = `${bounds.left - parentBounds.left}px`;
+        player.style.top = `${bounds.top - parentBounds.top}px`;
+        player.style.width = `${bounds.width}px`;
+        player.style.height = `${bounds.height}px`;
+      }
+
+      function enablePositionFallback() {
+        usePositionFallback = true;
+        player.classList.add('positioned-fallback');
+        // Keep both mounts rendered: hiding the player's ancestor hides playback.
+        mainMount.hidden = false;
+        heroMount.hidden = false;
+        mainMount.classList.toggle('fallback-inactive', theaterMode);
+        heroMount.classList.toggle('fallback-inactive', !theaterMode);
+        positionPlayer();
+      }
+
+      toggle.addEventListener('click', () => {
+        theaterMode = !theaterMode;
+        hero.classList.toggle('theater-active', theaterMode);
+        heroMount.hidden = !theaterMode;
+        locationStatus.hidden = !theaterMode;
+
+        if (!usePositionFallback) {
+          const destination = theaterMode ? heroMount : mainMount;
+          try {
+            // Atomic move preserves the iframe's browsing context and playback.
+            destination.moveBefore(player, null);
+            mainMount.hidden = theaterMode;
+          } catch (error) {
+            // A partial implementation may expose moveBefore but reject a move.
+            // Leave the player connected; never fall back to appendChild().
+            enablePositionFallback();
+          }
+        } else {
+          enablePositionFallback();
+        }
+
+        toggle.setAttribute('aria-pressed', String(theaterMode));
+        toggle.textContent = theaterMode ? 'Exit theater mode' : 'Theater mode';
+      });
+
+      if (usePositionFallback) enablePositionFallback();
+      window.addEventListener('resize', positionPlayer);
+      window.addEventListener('load', positionPlayer);
+      if (typeof ResizeObserver === 'function') {
+        const observer = new ResizeObserver(positionPlayer);
+        observer.observe(hero);
+        observer.observe(mainMount);
+        observer.observe(heroMount);
+      }
+    })();
+  </script>
