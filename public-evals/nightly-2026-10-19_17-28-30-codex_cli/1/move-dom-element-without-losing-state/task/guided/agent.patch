+  <script>
+    const hero = document.querySelector('.hero');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const videoHome = document.getElementById('video-home');
+    const player = document.getElementById('roasting-video');
+    const toggle = document.getElementById('theater-toggle');
+    const supportsStatefulMove = typeof heroSlot.moveBefore === 'function';
+    let theaterMode = false;
+
+    function positionFallback() {
+      if (supportsStatefulMove || !theaterMode) return;
+      const bounds = heroSlot.getBoundingClientRect();
+      player.style.setProperty('--video-top', `${bounds.top + window.scrollY}px`);
+      player.style.setProperty('--video-left', `${bounds.left + window.scrollX}px`);
+      player.style.setProperty('--video-width', `${bounds.width}px`);
+      heroSlot.style.height = `${player.offsetHeight}px`;
+    }
+
+    toggle.hidden = false;
+    toggle.addEventListener('click', () => {
+      theaterMode = !theaterMode;
+      hero.classList.toggle('is-theater', theaterMode);
+      videoHome.classList.toggle('is-theater', theaterMode);
+      heroSlot.hidden = !theaterMode;
+
+      if (supportsStatefulMove) {
+        // Move the existing subtree atomically; never detach or recreate the iframe.
+        const destination = theaterMode ? heroSlot : videoHome;
+        destination.moveBefore(player, null);
+      } else {
+        // appendChild/insertBefore would reload an iframe, even when reusing its node.
+        // Keep it in its original parent and visually place it in the hero instead.
+        player.classList.toggle('is-positioned', theaterMode);
+      }
+
+      toggle.setAttribute('aria-pressed', String(theaterMode));
+      toggle.textContent = theaterMode ? 'Exit theater mode' : 'Theater mode';
+      positionFallback();
+    });
+
+    if (!supportsStatefulMove) {
+      window.addEventListener('resize', positionFallback);
+      if (typeof ResizeObserver === 'function') {
+        const layoutObserver = new ResizeObserver(positionFallback);
+        layoutObserver.observe(hero);
+        layoutObserver.observe(player);
+      }
+    }
+  </script>
+
