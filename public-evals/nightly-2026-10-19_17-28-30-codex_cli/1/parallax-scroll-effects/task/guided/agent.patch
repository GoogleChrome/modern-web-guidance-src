+      text-underline-offset: 7px;
+    }
+
+    .coffee-story__link:focus-visible {
+      outline: 2px solid #ffe0b2;
+      outline-offset: 6px;
+    }
+
+    @keyframes coffee-parallax {
+      from { transform: translateY(calc(-1 * var(--travel))); }
+      to { transform: translateY(var(--travel)); }
+    }
+
+    /* Keep the shorthand before timeline/range so it cannot reset them. */
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      @media (prefers-reduced-motion: no-preference) {
+        .coffee-story {
+          view-timeline: --coffee-story block;
+        }
+
+        .coffee-story__layer {
+          animation: coffee-parallax linear both;
+          animation-timeline: --coffee-story;
+          animation-range: entry 0% exit 100%;
+        }
+      }
+    }
+
+    @media (max-width: 960px) {
