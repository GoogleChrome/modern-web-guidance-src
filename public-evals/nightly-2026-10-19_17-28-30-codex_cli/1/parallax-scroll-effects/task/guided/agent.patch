+    /* Static composition is the default, including in unsupported browsers. */
+    .coffee-story {
+      position: relative;
+      isolation: isolate;
+      overflow: clip;
+      background: #211a16;
+      color: #fff8ee;
+      min-height: 580px;
+      display: grid;
+      align-items: center;
+      padding: 100px max(24px, calc((100% - 1060px) / 2));
+    }
+
+    .coffee-story__art {
+      position: absolute;
+      inset: 0;
+      z-index: -1;
+      pointer-events: none;
+    }
+
+    .coffee-story__background {
+      --travel: 60px;
+      position: absolute;
+      inset: -70px 0;
+      width: 100%;
+      height: calc(100% + 140px);
+      object-fit: cover;
+      opacity: 0.45;
+    }
+
+    .coffee-story__art::after {
+      content: '';
+      position: absolute;
+      inset: 0;
+      background: linear-gradient(90deg, #211a16 5%, rgba(33, 26, 22, 0.94) 38%, rgba(33, 26, 22, 0.2));
+    }
+
+    .coffee-story__ring {
+      --travel: -40px;
+      position: absolute;
+      z-index: 1;
+      width: 430px;
+      aspect-ratio: 1;
+      border: 1px solid rgba(233, 200, 151, 0.35);
+      border-radius: 50%;
+      right: 7%;
+      top: 12%;
+    }
+
+    .coffee-story__foreground {
+      --travel: -90px;
+      position: absolute;
+      z-index: 2;
+      right: max(40px, calc((100% - 1060px) / 2));
+      top: 21%;
+      width: 310px;
+      height: 360px;
+      object-fit: cover;
+      border-radius: 160px 160px 8px 8px;
+      border: 6px solid #9d8060;
