+      }
+
+      .coffee-story__ring {
+        --travel: -20px;
+        width: 270px;
+        top: auto;
+        bottom: 40px;
+        right: 8%;
+      }
+
+      .coffee-story__art::after {
+        background: linear-gradient(180deg, #211a16 5%, rgba(33, 26, 22, 0.94) 50%, rgba(33, 26, 22, 0.2));
+      }
+    }
