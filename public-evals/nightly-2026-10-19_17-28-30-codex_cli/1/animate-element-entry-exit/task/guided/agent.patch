+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    let promoNumber = 0;
+    let busy = false;
+
+    // Probe actual display transitions: parsing support alone is insufficient.
+    function canTransitionDisplay() {
+      if (!window.CSS?.supports('transition-behavior', 'allow-discrete')) return false;
+      const probe = document.createElement('div');
+      probe.style.cssText = 'position: fixed; visibility: hidden; display: block; transition: display 1s allow-discrete;';
+      document.body.append(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      const supported = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supported;
+    }
+
+    const displayTransitions = canTransitionDisplay();
+
+    async function hideCard(card) {
+      if (card.hidden) return;
+      if (displayTransitions) card.hidden = true;
+      else card.setAttribute('data-closing', '');
+
+      const animations = card.getAnimations();
+      let timeout;
+      await Promise.race([
+        Promise.allSettled(animations.map(animation => animation.finished)),
+        new Promise(resolve => { timeout = setTimeout(resolve, 1000); })
+      ]);
+      clearTimeout(timeout);
+      card.hidden = true;
+      card.removeAttribute('data-closing');
+    }
+
+    function animateEntryFallback(card) {
+      if ('CSSStartingStyleRule' in window) return;
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
+      card.animate([
+        { opacity: 0, transform: reducedMotion ? 'none' : 'scale(0.92)' },
+        { opacity: 1, transform: reducedMotion ? 'none' : 'scale(1)' }
+      ], { duration: reducedMotion ? 100 : 300, easing: 'ease' });
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = `Fresh Brew Break #${++promoNumber}`;
+      const description = document.createElement('p');
+      description.textContent = 'Discover your next favorite cup with our locally roasted coffee.';
+      card.append(heading, description);
+      domContainer.append(card);
+      animateEntryFallback(card);
+      removeBtn.disabled = busy;
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      if (busy) return;
+      const card = domContainer.lastElementChild;
+      if (!card) return;
+      busy = true;
+      removeBtn.disabled = true;
+      toggleBtn.disabled = true;
+      await hideCard(card);
+      card.remove();
+      busy = false;
+      removeBtn.disabled = !domContainer.childElementCount;
+      toggleBtn.disabled = !toggleCard.isConnected;
+    });
+
+    toggleBtn.addEventListener('click', async () => {
+      if (busy) return;
+      busy = true;
+      toggleBtn.disabled = true;
+      removeBtn.disabled = true;
+      if (toggleCard.hidden) {
+        toggleCard.hidden = false;
+        animateEntryFallback(toggleCard);
+      } else {
+        await hideCard(toggleCard);
+      }
+      toggleBtn.setAttribute('aria-expanded', String(!toggleCard.hidden));
+      toggleBtn.textContent = toggleCard.hidden ? 'Show featured promo' : 'Hide featured promo';
+      busy = false;
+      toggleBtn.disabled = false;
+      removeBtn.disabled = !domContainer.childElementCount;
+    });
+  </script>
