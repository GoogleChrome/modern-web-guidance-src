   </footer>
 
+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let promoCount = 0;
+    let controlsBusy = false;
+
+    async function animateCard(card, appearing) {
+      card.getAnimations().forEach(animation => animation.cancel());
+      const frames = [
+        { opacity: 0, transform: 'scale(0.92)' },
+        { opacity: 1, transform: 'scale(1)' }
+      ];
+      const animation = card.animate(appearing ? frames : frames.slice().reverse(), {
+        duration: reducedMotion.matches ? 0 : 280,
+        easing: 'ease-in-out',
+        fill: 'both'
+      });
+      await animation.finished.catch(() => {});
+      animation.cancel();
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      const title = document.createElement('h3');
+      title.textContent = `Coffee Break Special #${++promoCount}`;
+      const description = document.createElement('p');
+      description.textContent = 'Explore our seasonal coffee selection and discover your next favorite cup.';
+      card.append(title, description);
+      domContainer.append(card);
+      if (!controlsBusy) removeBtn.disabled = false;
+      animateCard(card, true);
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const card = domContainer.lastElementChild;
+      if (!card) return;
+      controlsBusy = true;
+      removeBtn.disabled = true;
+      toggleBtn.disabled = true;
+      // Keep the card in the DOM until its exit animation finishes.
+      if (!card.hidden) await animateCard(card, false);
+      card.remove();
+      controlsBusy = false;
+      removeBtn.disabled = !domContainer.childElementCount;
+      toggleBtn.disabled = !toggleCard.isConnected;
+    });
+
+    toggleBtn.addEventListener('click', async () => {
+      controlsBusy = true;
+      toggleBtn.disabled = true;
+      removeBtn.disabled = true;
+      const showing = toggleCard.hidden;
+      if (showing) toggleCard.hidden = false;
+      await animateCard(toggleCard, showing);
+      if (!showing) toggleCard.hidden = true;
+      toggleBtn.setAttribute('aria-expanded', String(showing));
+      toggleBtn.textContent = showing ? 'Hide Featured Promo' : 'Show Featured Promo';
+      controlsBusy = false;
+      toggleBtn.disabled = false;
+      removeBtn.disabled = !domContainer.childElementCount;
+    });
+  </script>
 </body>
 
