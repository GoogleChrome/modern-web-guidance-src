+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const shippingPreview = document.getElementById('shipping-preview');
+
+    shippingForm.addEventListener('input', () => {
+      shippingPreview.textContent = '';
+    });
+
+    shippingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      for (const input of shippingForm.querySelectorAll('input')) {
+        input.value = input.value.trim();
+      }
+      if (!shippingForm.reportValidity()) return;
+
+      const address = new FormData(shippingForm);
+      shippingPreview.textContent = [
+        'Your shipping address preview',
+        `${address.get('firstName')} ${address.get('lastName')}`,
+        address.get('address'),
+        address.get('apartment'),
+        [address.get('city'), address.get('region'), address.get('postalCode')].filter(Boolean).join(', '),
+        address.get('country')
+      ].filter(Boolean).join('\n');
+    });
+  </script>
+
