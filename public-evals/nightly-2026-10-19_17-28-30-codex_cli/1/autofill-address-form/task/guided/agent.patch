+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const shippingPreview = document.getElementById('shipping-preview');
+    const shippingSummary = document.getElementById('shipping-summary');
+
+    shippingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      // Native required-field checks run before this submit handler.
+      const data = new FormData(shippingForm);
+      const fields = ['full_name', 'address_line1', 'address_line2', 'city', 'region', 'postal_code', 'country', 'phone'];
+      shippingSummary.textContent = fields
+        .map((field) => data.get(field).trim())
+        .filter(Boolean)
+        .join('\n');
+      shippingPreview.hidden = false;
+    });
+
+    shippingForm.addEventListener('input', () => {
+      shippingPreview.hidden = true;
+    });
+  </script>
+
