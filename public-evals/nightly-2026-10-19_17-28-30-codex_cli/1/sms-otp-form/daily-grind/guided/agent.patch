@@ -0,0 +1,153 @@
+'use strict';
+// Demo transport only. Replace these two methods with authenticated server calls.
+// The server must generate, expire, rate-limit, and verify codes; never ship real codes to the client.
+const verificationService = {
+  async send(phone) { return { challengeId: crypto.randomUUID(), phone }; },
+  async verify(challengeId, code) { return Boolean(challengeId) && code === '123456'; }
+};
+const phoneForm = document.querySelector('#phone-form');
+const otpForm = document.querySelector('#otp-form');
+const phoneInput = document.querySelector('#phone');
+const otpInput = document.querySelector('#otp');
+const resendButton = document.querySelector('#resend');
+const status = document.querySelector('#live-status');
+let challenge = null;
+let otpController = null;
+let timer = null;
+let resendAt = 0;
+let expiresAt = 0;
+let attempts = 0;
+let busy = false;
+function stopListener() { otpController?.abort(); otpController = null; }
+function setError(input, message) {
+  document.querySelector(`#${input.id}-error`).textContent = message;
+  input.setAttribute('aria-invalid', String(Boolean(message)));
+}
+function updateStep(step) {
+  document.querySelectorAll('.steps li').forEach((item, index) => {
+    item.classList.toggle('current', index === step);
+    item.classList.toggle('complete', index < step);
+    if (index === step) item.setAttribute('aria-current', 'step');
+    else item.removeAttribute('aria-current');
+  });
+}
+function updateCountdown() {
+  const seconds = Math.max(0, Math.ceil((resendAt - Date.now()) / 1000));
+  resendButton.disabled = seconds > 0 || busy;
+  document.querySelector('#countdown').textContent = seconds ? ` in ${seconds}s` : '';
+  if (!seconds) { clearInterval(timer); timer = null; }
+}
+function beginCountdown() {
+  clearInterval(timer);
+  resendAt = Date.now() + 30000;
+  updateCountdown();
+  timer = setInterval(updateCountdown, 1000);
+}
+async function listenForSms() {
+  stopListener();
+  if (!window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+  const controller = new AbortController();
+  otpController = controller;
+  const timeout = setTimeout(() => controller.abort(), 60000);
+  try {
+    const credential = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: controller.signal });
+    if (credential && !controller.signal.aborted && !otpForm.hidden) {
+      otpInput.value = credential.code;
+      otpForm.requestSubmit();
+    }
+  } catch (error) {
+    // Dismissal, timeout, and unsupported policy leave keyboard autofill and manual entry available.
+  } finally {
+    clearTimeout(timeout);
+    if (otpController === controller) otpController = null;
+  }
+}
+async function sendCode(phone) {
+  stopListener();
+  // Start listening before the transport sends an origin-bound SMS.
+  void listenForSms();
+  try {
+    challenge = await verificationService.send(phone);
+    expiresAt = Date.now() + 5 * 60 * 1000;
+    attempts = 0;
+    otpInput.value = '';
+    setError(otpInput, '');
+    beginCountdown();
+  } catch (error) { stopListener(); throw error; }
+}
+phoneForm.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  const digits = phoneInput.value.replace(/\D/g, '');
+  const country = document.querySelector('#country').value.replace('-ca', '');
+  const valid = country === '+1' ? /^[2-9]\d{9}$/.test(digits) : /^\d{6,12}$/.test(digits);
+  if (!valid || (country + digits).length > 16) {
+    setError(phoneInput, 'Enter a valid phone number for your selected country.');
+    phoneInput.focus(); return;
+  }
+  setError(phoneInput, '');
+  busy = true;
+  const button = phoneForm.querySelector('button[type="submit"]');
+  button.disabled = true;
+  try {
+    await sendCode(`${country} ${digits}`);
+    phoneForm.hidden = true; otpForm.hidden = false;
+    updateStep(1);
+    document.querySelector('#step-eyebrow').textContent = 'ONE LITTLE CHECK, THEN COFFEE';
+    document.querySelector('#form-title').textContent = 'Check your messages.';
+    document.querySelector('#form-description').textContent = `In the live experience, we’ll text a code to ${challenge.phone}. Enter the demo code below to continue.`;
+    status.textContent = 'Demo code ready. Use 123456. No SMS has been sent.';
+    otpInput.focus();
+  } catch (error) { setError(phoneInput, 'We couldn’t send a code. Please try again.'); }
+  finally { busy = false; button.disabled = false; updateCountdown(); }
+});
+otpForm.addEventListener('submit', async event => {
+  event.preventDefault(); stopListener();
+  if (busy) return;
+  if (!/^[0-9]{6}$/.test(otpInput.value)) { setError(otpInput, 'Enter all 6 digits from your code.'); otpInput.focus(); return; }
+  if (Date.now() > expiresAt) { setError(otpInput, 'This code has expired. Request a new code below.'); return; }
+  if (attempts >= 5) { setError(otpInput, 'Too many attempts. Request a new code below.'); return; }
+  busy = true;
+  const button = otpForm.querySelector('button[type="submit"]');
+  button.disabled = true;
+  try {
+    attempts++;
+    const verified = await verificationService.verify(challenge?.challengeId, otpInput.value);
+    if (!verified) { setError(otpInput, 'That code doesn’t match. For this demo, use 123456.'); otpInput.focus(); return; }
+    clearInterval(timer); otpForm.hidden = true;
+    document.querySelector('#success-panel').hidden = false;
+    document.querySelector('#step-eyebrow').textContent = 'THERE’S A PLACE FOR YOU HERE';
+    document.querySelector('#form-title').textContent = 'You’re one of the regulars.';
+    document.querySelector('#form-description').textContent = 'Thanks for trying Daily Rewards. This demo is complete — grab a cup and make yourself at home.';
+    updateStep(2); status.textContent = 'Demo phone verification complete.';
+    document.querySelector('#restart').focus();
+  } catch (error) { setError(otpInput, 'Verification couldn’t be completed. Please try again.'); }
+  finally { busy = false; button.disabled = false; }
+});
+resendButton.addEventListener('click', async () => {
+  if (busy || Date.now() < resendAt || !challenge) return;
+  busy = true; resendButton.disabled = true;
+  try { await sendCode(challenge.phone); status.textContent = 'New demo code ready. Use 123456.'; otpInput.focus(); }
+  catch (error) { setError(otpInput, 'We couldn’t resend the code. Please try again.'); }
+  finally { busy = false; updateCountdown(); }
+});
+function reset() {
+  stopListener(); clearInterval(timer); challenge = null;
+  phoneForm.hidden = false; otpForm.hidden = true;
+  document.querySelector('#success-panel').hidden = true;
+  document.querySelector('#step-eyebrow').textContent = 'YOUR NEXT CUP STARTS HERE';
+  document.querySelector('#form-title').textContent = 'Hey there, coffee lover.';
+  document.querySelector('#form-description').textContent = 'A few digits. A whole lot of perks. Let’s get you connected to your Daily Grind account.';
+  updateStep(0); phoneInput.focus();
+}
+document.querySelector('#change-phone').addEventListener('click', reset);
+document.querySelector('#restart').addEventListener('click', reset);
+phoneInput.addEventListener('input', () => setError(phoneInput, ''));
+otpInput.addEventListener('input', () => { otpInput.value = otpInput.value.replace(/\D/g, '').slice(0, 6); setError(otpInput, ''); });
+otpInput.addEventListener('paste', event => {
+  const text = event.clipboardData?.getData('text') || '';
+  const digits = text.replace(/\D/g, '');
+  if (digits.length === 6) { event.preventDefault(); otpInput.value = digits; setError(otpInput, ''); }
+});
+window.addEventListener('pagehide', () => { stopListener(); clearInterval(timer); });
+window.addEventListener('pageshow', () => { if (!otpForm.hidden && challenge) { updateCountdown(); if (resendAt > Date.now()) timer = setInterval(updateCountdown, 1000); void listenForSms(); } });
