diff --git a/tests/signup.test.mjs b/tests/signup.test.mjs
new file mode 100644
index 0000000..95fbbc0
--- /dev/null
+++ b/tests/signup.test.mjs
@@ -0,0 +1,148 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { readdir, readFile } from "node:fs/promises";
+
+// Exercise the actual compiled route, with only the external services mocked.
+const directory = new URL("../dist/server/chunks/", import.meta.url);
+let POST;
+for (const file of await readdir(directory)) {
+  if (!file.startsWith("signup_")) continue;
+  if (
+    !(await readFile(new URL(file, directory), "utf8")).includes(
+      "times_phone_verification",
+    )
+  )
+    continue;
+  POST = (await import(new URL(file, directory))).page().POST;
+}
+assert.ok(POST, "Run pnpm build before these tests.");
+const originalFetch = globalThis.fetch;
+const oldEnv = { ...process.env };
+const values = new Map();
+const input = {
+  action: "send",
+  username: "reader",
+  password: "reading123",
+  phone: "+14155550123",
+};
+const calls = [];
+let approved = true;
+before(() => {
+  process.env.TWILIO_ACCOUNT_SID = "test-account";
+  process.env.TWILIO_AUTH_TOKEN = "test-secret";
+  process.env.TWILIO_VERIFY_SERVICE_SID = "test-service";
+  globalThis.fetch = async (url, options) => {
+    calls.push({ url, options });
+    if (url.endsWith("/Verifications"))
+      return Response.json({ sid: "VEtest", status: "pending" });
+    if (url.endsWith("/VerificationCheck"))
+      return Response.json({ status: approved ? "approved" : "pending" });
+    return Response.json({ registered: true });
+  };
+});
+after(() => {
+  globalThis.fetch = originalFetch;
+  process.env = oldEnv;
+});
+function submit(body, origin = "https://example.com") {
+  const request = new Request("https://example.com/devtools-times/api/signup", {
+    method: "POST",
+    headers: { origin, "Content-Type": "application/json" },
+    body: JSON.stringify(body),
+  });
+  return POST({
+    request,
+    url: new URL(request.url),
+    cookies: {
+      get: (name) =>
+        values.has(name) ? { value: values.get(name) } : undefined,
+      set: (name, value, options) => {
+        assert.equal(options.httpOnly, true);
+        assert.equal(options.secure, true);
+        assert.equal(options.sameSite, "strict");
+        values.set(name, value);
+      },
+      delete: (name) => values.delete(name),
+    },
+  });
+}
+test("rejects cross-origin requests without contacting services", async () => {
+  assert.equal((await submit(input, "https://other.example")).status, 403);
+  assert.equal(calls.length, 0);
+});
+test("fails clearly when SMS service is not configured", async () => {
+  delete process.env.TWILIO_VERIFY_SERVICE_SID;
+  assert.equal((await submit(input)).status, 503);
+  process.env.TWILIO_VERIFY_SERVICE_SID = "test-service";
+});
+test("rejects malformed phone numbers", async () => {
+  assert.equal((await submit({ ...input, phone: "123" })).status, 400);
+  assert.equal(calls.length, 0);
+});
+test("sends SMS and enforces a resend cooldown", async () => {
+  assert.equal((await submit(input)).status, 200);
+  assert.equal(
+    new URLSearchParams(calls[0].options.body).get("Channel"),
+    "sms",
+  );
+  assert.equal((await submit(input)).status, 429);
+});
+test("binds verification to account details and phone number", async () => {
+  const count = calls.length;
+  assert.equal(
+    (
+      await submit({
+        ...input,
+        action: "verify",
+        password: "changed123",
+        code: "123456",
+      })
+    ).status,
+    400,
+  );
+  assert.equal(
+    (
+      await submit({
+        ...input,
+        action: "verify",
+        phone: "+14155550124",
+        code: "123456",
+      })
+    ).status,
+    400,
+  );
+  assert.equal(calls.length, count);
+});
+test("rejects a tampered challenge cookie", async () => {
+  const original = values.get("times_phone_verification");
+  values.set("times_phone_verification", original + "x");
+  assert.equal(
+    (await submit({ ...input, action: "verify", code: "123456" })).status,
+    400,
+  );
+  values.set("times_phone_verification", original);
+});
+test("does not register when the code is invalid", async () => {
+  approved = false;
+  const count = calls.length;
+  assert.equal(
+    (await submit({ ...input, action: "verify", code: "654321" })).status,
+    400,
+  );
+  assert.equal(calls.length, count + 1);
+  assert.ok(calls.at(-1).url.endsWith("/VerificationCheck"));
+});
+test("registers only after provider approval and prevents replay", async () => {
+  approved = true;
+  const result = await submit({ ...input, action: "verify", code: "123456" });
+  assert.equal(result.status, 200);
+  assert.deepEqual(await result.json(), { verified: true, registered: true });
+  assert.ok(calls.at(-1).url.endsWith("/register"));
+  assert.equal(JSON.parse(calls.at(-1).options.body).phone, input.phone);
+  const count = calls.length;
+  assert.equal(
+    (await submit({ ...input, action: "verify", code: "123456" })).status,
+    400,
+  );
+  assert.equal(calls.length, count);
+});
