--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,231 @@
+import type { APIRoute } from "astro";
+import { createHash, createHmac, timingSafeEqual } from "node:crypto";
+
+const cookieName = "times_phone_verification";
+const registrationUrl =
+  "https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register";
+type Challenge = {
+  sid: string;
+  phone: string;
+  account: string;
+  created: number;
+  sent: number;
+};
+const accountDigest = (username: string, password: string) =>
+  createHash("sha256")
+    .update(JSON.stringify([username, password]))
+    .digest("hex");
+function sign(value: string, secret: string) {
+  return createHmac("sha256", secret).update(value).digest("base64url");
+}
+function decode(value: string | undefined, secret: string): Challenge | null {
+  if (!value) return null;
+  try {
+    const [payload, signature] = value.split(".");
+    const expected = Buffer.from(sign(payload, secret));
+    const actual = Buffer.from(signature || "");
+    if (expected.length !== actual.length || !timingSafeEqual(expected, actual))
+      return null;
+    const challenge = JSON.parse(
+      Buffer.from(payload, "base64url").toString(),
+    ) as Challenge;
+    if (
+      typeof challenge.created !== "number" ||
+      Date.now() - challenge.created > 10 * 60 * 1000
+    )
+      return null;
+    return challenge;
+  } catch {
+    return null;
+  }
+}
+const json = (body: object, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: {
+      "Content-Type": "application/json",
+      "Cache-Control": "no-store",
+    },
+  });
+
+export const POST: APIRoute = async ({ request, cookies, url }) => {
+  const origin = request.headers.get("origin");
+  // Astro may normalize an unlisted development hostname to localhost.
+  // The browser's Host header still identifies the actual request origin.
+  const requestOrigin = `${url.protocol}//${request.headers.get("host")}`;
+  if (!origin || (origin !== url.origin && origin !== requestOrigin))
+    return json({ error: "Please submit this form from this website." }, 403);
+  const accountSid = process.env.TWILIO_ACCOUNT_SID;
+  const authToken = process.env.TWILIO_AUTH_TOKEN;
+  const serviceSid = process.env.TWILIO_VERIFY_SERVICE_SID;
+  if (!accountSid || !authToken || !serviceSid) {
+    return json(
+      {
+        error:
+          "Phone verification is temporarily unavailable. Please try again later.",
+      },
+      503,
+    );
+  }
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: "Invalid request." }, 400);
+  }
+  if (!body || typeof body !== "object")
+    return json({ error: "Invalid request." }, 400);
+  const { action, phone, username, password, code } = body;
+  if (action !== "send" && action !== "verify")
+    return json({ error: "Invalid request." }, 400);
+  if (typeof phone !== "string" || !/^\+[1-9]\d{7,14}$/.test(phone))
+    return json(
+      { error: "Enter a valid phone number with its country code." },
+      400,
+    );
+  if (
+    typeof username !== "string" ||
+    !username.trim() ||
+    username.length > 64 ||
+    typeof password !== "string" ||
+    password.length < 8 ||
+    password.length > 256 ||
+    !/\d/.test(password)
+  ) {
+    return json(
+      {
+        error:
+          "Enter a username and a password with at least 8 characters and a number.",
+      },
+      400,
+    );
+  }
+  const account = accountDigest(username, password);
+  const challenge = decode(cookies.get(cookieName)?.value, authToken);
+  const cookieOptions = {
+    httpOnly: true,
+    secure: url.protocol === "https:",
+    sameSite: "strict" as const,
+    path: import.meta.env.BASE_URL,
+    maxAge: 600,
+  };
+  const save = (value: Challenge) => {
+    const payload = Buffer.from(JSON.stringify(value)).toString("base64url");
+    cookies.set(
+      cookieName,
+      `${payload}.${sign(payload, authToken)}`,
+      cookieOptions,
+    );
+  };
+  async function twilio(resource: string, values: Record<string, string>) {
+    return fetch(
+      `https://verify.twilio.com/v2/Services/${serviceSid}/${resource}`,
+      {
+        method: "POST",
+        signal: AbortSignal.timeout(15000),
+        headers: {
+          Authorization: `Basic ${Buffer.from(`${accountSid}:${authToken}`).toString("base64")}`,
+          "Content-Type": "application/x-www-form-urlencoded",
+        },
+        body: new URLSearchParams(values),
+      },
+    );
+  }
+  try {
+    if (action === "send") {
+      if (challenge && Date.now() - challenge.sent < 30000)
+        return json(
+          { error: "Please wait 30 seconds before requesting another code." },
+          429,
+        );
+      const response = await twilio("Verifications", {
+        To: phone,
+        Channel: "sms",
+      });
+      const data = await response.json();
+      if (!response.ok)
+        return json(
+          {
+            error:
+              response.status === 429
+                ? "Too many requests. Please wait before trying again."
+                : "We couldn’t send a text to this number. Check the number and try again.",
+          },
+          response.status === 429 ? 429 : 502,
+        );
+      if (data.status !== "pending" || typeof data.sid !== "string")
+        return json(
+          { error: "Unable to send a verification code. Please try again." },
+          502,
+        );
+      save({
+        sid: data.sid,
+        phone,
+        account,
+        created: Date.now(),
+        sent: Date.now(),
+      });
+      return json({ sent: true });
+    }
+    if (
+      !challenge ||
+      challenge.phone !== phone ||
+      challenge.account !== account
+    )
+      return json(
+        {
+          error:
+            "Your verification session expired or your details changed. Go back and request a new code.",
+        },
+        400,
+      );
+    if (typeof code !== "string" || !/^\d{6}$/.test(code))
+      return json(
+        { error: "Enter the 6-digit code from your text message." },
+        400,
+      );
+    const response = await twilio("VerificationCheck", {
+      VerificationSid: challenge.sid,
+      Code: code,
+    });
+    const verification = await response.json();
+    if (!response.ok || verification.status !== "approved") {
+      return json(
+        {
+          error:
+            response.status === 404
+              ? "This code has expired. Request a new code and try again."
+              : response.status === 429
+                ? "Too many attempts. Please wait and request a new code."
+                : "That code isn’t correct. Check your text message and try again.",
+        },
+        400,
+      );
+    }
+    // Consume the challenge before registration: an approved code cannot be replayed.
+    cookies.delete(cookieName, { path: import.meta.env.BASE_URL });
+    const registered = await fetch(registrationUrl, {
+      method: "POST",
+      signal: AbortSignal.timeout(15000),
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ username, password, phone }),
+    });
+    if (!registered.ok)
+      return json(
+        {
+          error:
+            "We couldn’t create your account. Your username may already be taken. Go back, check your details, and request a new code.",
+        },
+        400,
+      );
+    return json({ verified: true, registered: true });
+  } catch {
+    return json(
+      {
+        error:
+          "We couldn’t connect to the verification service. Please try again.",
+      },
+      502,
+    );
+  }
+};
