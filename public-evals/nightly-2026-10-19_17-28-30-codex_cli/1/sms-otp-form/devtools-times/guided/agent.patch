@@ -0,0 +1,139 @@
+import { createHash, randomBytes, randomInt, timingSafeEqual } from 'node:crypto';
+
+export interface PhoneChallenge {
+  phone: string;
+  salt: string;
+  hash: string;
+  expiresAt: number;
+  attempts: number;
+  verified: boolean;
+}
+
+interface Session {
+  get(key: 'phoneChallenge'): Promise<PhoneChallenge | undefined>;
+  set(key: 'phoneChallenge', value: PhoneChallenge): void;
+  delete(key: 'phoneChallenge'): void;
+}
+
+interface Options {
+  accountSid?: string;
+  authToken?: string;
+  from?: string;
+  fetch?: typeof fetch;
+  now?: () => number;
+}
+
+const digest = (salt: string, code: string) => createHash('sha256').update(`${salt}:${code}`).digest('hex');
+const json = (data: object, status = 200) => Response.json(data, {
+  status, headers: { 'Cache-Control': 'no-store' },
+});
+
+export function normalizePhone(phone: unknown): string | null {
+  if (typeof phone !== 'string' || phone.length > 40) return null;
+  const normalized = phone.replace(/[\s().-]/g, '');
+  return /^\+[1-9]\d{7,14}$/.test(normalized) ? normalized : null;
+}
+
+// Limits also span sessions for the same phone. Deploy behind a shared rate
+// limiter when running multiple server instances (see README).
+const sends = new Map<string, { count: number; last: number; reset: number }>();
+const challenges = new Map<string, PhoneChallenge>();
+const activePhones = new Set<string>();
+
+export async function handleSignup(request: Request, session: Session | undefined, options: Options = {}): Promise<Response> {
+  if (request.headers.get('origin') !== new URL(request.url).origin ||
+      !request.headers.get('content-type')?.startsWith('application/json')) {
+    return json({ error: 'Please submit the form from this website.' }, 403);
+  }
+  if (!session) return json({ error: 'Verification is unavailable. Please try again later.' }, 503);
+  let lockedPhone: string | undefined;
+  try {
+    const body = await request.json().catch(() => null);
+    if (!body || typeof body !== 'object') return json({ error: 'Invalid request.' }, 400);
+    const phone = normalizePhone(body.phone);
+    if (!phone) return json({ error: 'Enter a phone number with its country code, for example +1 202 555 0123.' }, 400);
+    if (activePhones.has(phone)) return json({ error: 'A request is already in progress. Please try again.' }, 409);
+    activePhones.add(phone);
+    lockedPhone = phone;
+    const now = (options.now ?? Date.now)();
+    const send = options.fetch ?? fetch;
+    for (const [key, value] of challenges) if (value.expiresAt <= now) challenges.delete(key);
+
+    if (body.action === 'send') {
+      if (!options.accountSid || !options.authToken || !options.from) {
+        return json({ error: 'SMS verification is not configured yet. Please try again later.' }, 503);
+      }
+      for (const [key, value] of sends) if (value.reset <= now) sends.delete(key);
+      const limit = sends.get(phone);
+      if (limit && (now - limit.last < 60_000 || limit.count >= 5)) {
+        const retryAfter = Math.ceil(((limit.count >= 5 ? limit.reset : limit.last + 60_000) - now) / 1000);
+        return json({ error: `Please wait ${retryAfter} seconds before requesting another code.`, retryAfter }, 429);
+      }
+      if (sends.size >= 10_000 && !limit) return json({ error: 'SMS verification is busy. Please try again later.' }, 503);
+      sends.set(phone, { count: (limit?.count ?? 0) + 1, last: now, reset: limit?.reset ?? now + 3_600_000 });
+      const previous = await session.get('phoneChallenge');
+      if (previous) challenges.delete(previous.salt);
+      session.delete('phoneChallenge');
+      const code = randomInt(0, 1_000_000).toString().padStart(6, '0');
+      const salt = randomBytes(16).toString('hex');
+      const sms = await send(`https://api.twilio.com/2010-04-01/Accounts/${encodeURIComponent(options.accountSid)}/Messages.json`, {
+        method: 'POST',
+        headers: { Authorization: `Basic ${Buffer.from(`${options.accountSid}:${options.authToken}`).toString('base64')}`,
+          'Content-Type': 'application/x-www-form-urlencoded' },
+        body: new URLSearchParams({ To: phone, From: options.from,
+          Body: `Your DevTools Times verification code is ${code}. It expires in 5 minutes.\n\n@${new URL(request.url).hostname} #${code}` }),
+        signal: AbortSignal.timeout(15_000),
+      });
+      if (!sms.ok) return json({ error: 'We could not send your text. Check your number and try again in a minute.' }, 502);
+      const challenge = { phone, salt, hash: digest(salt, code), expiresAt: now + 300_000, attempts: 0, verified: false };
+      challenges.set(salt, challenge);
+      session.set('phoneChallenge', challenge);
+      return json({ message: 'Code sent. Check your text messages.', retryAfter: 60 });
+    }
+
+    const stored = await session.get('phoneChallenge');
+    const challenge = stored && challenges.get(stored.salt);
+    if (!challenge || challenge.phone !== phone || challenge.expiresAt <= now) {
+      session.delete('phoneChallenge');
+      return json({ error: 'Your code has expired. Please request a new code.' }, 400);
+    }
+    if (body.action === 'verify') {
+      if (challenge.attempts >= 5) return json({ error: 'Too many attempts. Please request a new code.' }, 429);
+      if (challenge.verified) return json({ error: 'This code has already been used.' }, 400);
+      challenge.attempts++;
+      const valid = typeof body.code === 'string' && /^\d{6}$/.test(body.code) &&
+        timingSafeEqual(Buffer.from(challenge.hash, 'hex'), Buffer.from(digest(challenge.salt, body.code), 'hex'));
+      session.set('phoneChallenge', { ...challenge, verified: valid });
+      challenge.verified = valid;
+      if (!valid) return json({ error: 'That code is incorrect. Check the text message and try again.' }, 400);
+      return json({ message: 'Phone number verified.' });
+    }
+    if (body.action === 'register') {
+      if (!challenge.verified) return json({ error: 'Verify your phone number before creating your account.' }, 403);
+      if (typeof body.username !== 'string' || !body.username.trim() || body.username.length > 100 ||
+          typeof body.password !== 'string' || body.password.length < 8 || body.password.length > 256 || !/\d/.test(body.password)) {
+        return json({ error: 'Enter a username and a password of at least 8 characters containing a number.' }, 400);
+      }
+      // Consume verification before the upstream mutation; never trust a client-side flag.
+      session.delete('phoneChallenge');
+      challenges.delete(challenge.salt);
+      const registered = await send('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+        method: 'POST', headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username: body.username.trim(), password: body.password, phone }),
+        signal: AbortSignal.timeout(15_000),
+      });
+      if (!registered.ok) {
+        // A definitive rejection can be retried; an ambiguous network failure cannot.
+        session.set('phoneChallenge', challenge);
+        challenges.set(challenge.salt, challenge);
+        return json({ error: 'Registration failed. Try another username or try again later.' }, 400);
+      }
+      return json({ message: 'Your account is ready. You can now sign in.' });
+    }
+    return json({ error: 'Unknown action.' }, 400);
+  } catch {
+    return json({ error: 'We could not complete your request. Please try again.' }, 502);
+  } finally {
+    if (lockedPhone) activePhones.delete(lockedPhone);
+  }
+}
diff --git a/src/utils/smsOtp.ts b/src/utils/smsOtp.ts
new file mode 100644
index 0000000..71e8e46
--- /dev/null
+++ b/src/utils/smsOtp.ts
@@ -0,0 +1,21 @@
+/** WebOTP is an enhancement; manual entry remains available on every failure. */
+export function listenForSmsCode(onCode: (code: string) => void): AbortController | null {
+  if (typeof window === 'undefined' || !window.isSecureContext ||
+      !('OTPCredential' in window) || !navigator.credentials?.get) return null;
+
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), 300_000);
+  controller.signal.addEventListener('abort', () => clearTimeout(timeout), { once: true });
+  try {
+    const options = { otp: { transport: ['sms'] }, signal: controller.signal } as CredentialRequestOptions;
+    void navigator.credentials.get(options).then((credential) => {
+      const code = (credential as (Credential & { code?: string }) | null)?.code;
+      if (!controller.signal.aborted && typeof code === 'string' && /^\d{6}$/.test(code)) onCode(code);
+    }).catch(() => {
+      // Permission denial, timeout, and unsupported policies need no error UI.
+    }).finally(() => clearTimeout(timeout));
+  } catch {
+    controller.abort();
+  }
+  return controller;
+}
diff --git a/tests/signup.test.ts b/tests/signup.test.ts
new file mode 100644
index 0000000..befa169
--- /dev/null
+++ b/tests/signup.test.ts
@@ -0,0 +1,113 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { handleSignup, normalizePhone, type PhoneChallenge } from '../src/server/signup.ts';
+
+let phoneIndex = 1000;
+function setup() {
+  let challenge: PhoneChallenge | undefined;
+  let now = Date.now();
+  let sms = '';
+  let registrationCount = 0;
+  let rejectSms = false;
+  let rejectRegistration = false;
+  const phone = `+1202555${phoneIndex++}`;
+  const session = {
+    async get() { return challenge && structuredClone(challenge); },
+    set(_key: string, value: PhoneChallenge) { challenge = structuredClone(value); },
+    delete() { challenge = undefined; },
+  };
+  const mockFetch: typeof fetch = async (url, init) => {
+    if (String(url).includes('twilio.com')) {
+      sms = new URLSearchParams(init?.body as URLSearchParams).get('Body')!;
+      return new Response('{}', { status: rejectSms ? 400 : 201 });
+    }
+    registrationCount++;
+    const body = JSON.parse(init?.body as string);
+    assert.equal(body.phone, phone);
+    assert.equal(body.username, 'reader');
+    return new Response('{}', { status: rejectRegistration ? 400 : 200 });
+  };
+  const options = { accountSid: 'ACtest', authToken: 'test', from: '+12025550123', fetch: mockFetch, now: () => now };
+  const request = (body: object, origin = 'https://news.example') => new Request('https://news.example/devtools-times/api/signup', {
+    method: 'POST', headers: { Origin: origin, 'Content-Type': 'application/json' }, body: JSON.stringify({ phone, ...body }),
+  });
+  return {
+    run: (body: object, origin?: string) => handleSignup(request(body, origin), session, options),
+    code: () => sms.match(/#(\d{6})$/)![1],
+    sms: () => sms,
+    advance: (ms: number) => { now += ms; },
+    registrations: () => registrationCount,
+    rejectSms: () => { rejectSms = true; },
+    rejectRegistration: (value: boolean) => { rejectRegistration = value; },
+    unconfigured: () => handleSignup(request({ action: 'send' }), session),
+  };
+}
+
+test('normalizes formatted international numbers and rejects missing country codes', () => {
+  assert.equal(normalizePhone('+1 (202) 555-0123'), '+12025550123');
+  for (const invalid of ['2025550123', '+012345678', '+123', '+1202abc0123', {}, null]) assert.equal(normalizePhone(invalid), null);
+});
+
+test('sends origin-bound SMS, verifies and creates an account once', async () => {
+  const app = setup();
+  assert.equal((await app.run({ action: 'send' })).status, 200);
+  assert.match(app.sms(), /\n\n@news\.example #\d{6}$/);
+  assert.equal((await app.run({ action: 'register', username: 'reader', password: 'password1' })).status, 403);
+  assert.equal(app.registrations(), 0);
+  assert.equal((await app.run({ action: 'verify', code: app.code() })).status, 200);
+  assert.equal((await app.run({ action: 'verify', code: app.code() })).status, 400);
+  assert.equal((await app.run({ action: 'register', username: 'reader', password: 'password1' })).status, 200);
+  assert.equal((await app.run({ action: 'register', username: 'reader', password: 'password1' })).status, 400);
+  assert.equal(app.registrations(), 1);
+});
+
+test('bounds incorrect guesses and expires codes', async () => {
+  const app = setup();
+  await app.run({ action: 'send' });
+  for (let attempt = 0; attempt < 5; attempt++) assert.equal((await app.run({ action: 'verify', code: 'bad' })).status, 400);
+  assert.equal((await app.run({ action: 'verify', code: app.code() })).status, 429);
+  app.advance(300_001);
+  assert.equal((await app.run({ action: 'verify', code: app.code() })).status, 400);
+});
+
+test('enforces resend cooldown and invalidates the old challenge', async () => {
+  const app = setup();
+  await app.run({ action: 'send' });
+  const oldCode = app.code();
+  assert.equal((await app.run({ action: 'send' })).status, 429);
+  app.advance(60_001);
+  assert.equal((await app.run({ action: 'send' })).status, 200);
+  // Random codes can coincide; always verify the newly issued challenge.
+  if (oldCode !== app.code()) assert.equal((await app.run({ action: 'verify', code: oldCode })).status, 400);
+  assert.equal((await app.run({ action: 'verify', code: app.code() })).status, 200);
+});
+
+test('rejects cross-origin requests, malformed input, and missing provider configuration', async () => {
+  const app = setup();
+  assert.equal((await app.run({ action: 'send' }, 'https://attacker.example')).status, 403);
+  assert.equal((await app.run({ action: 'send', phone: '123' })).status, 400);
+  assert.equal((await app.unconfigured()).status, 503);
+  assert.equal(app.sms(), '');
+});
+
+test('failed delivery never creates a usable challenge', async () => {
+  const app = setup();
+  app.rejectSms();
+  assert.equal((await app.run({ action: 'send' })).status, 502);
+  assert.equal((await app.run({ action: 'verify', code: app.code() })).status, 400);
+});
+
+test('rejects phone changes and weak passwords; allows retry after upstream rejection', async () => {
+  const app = setup();
+  await app.run({ action: 'send' });
+  assert.equal((await app.run({ action: 'verify', phone: '+12025559999', code: app.code() })).status, 400);
+  // A mismatched number clears the session challenge, requiring a fresh SMS.
+  app.advance(60_001);
+  await app.run({ action: 'send' });
+  await app.run({ action: 'verify', code: app.code() });
+  assert.equal((await app.run({ action: 'register', username: 'reader', password: 'weak' })).status, 400);
+  app.rejectRegistration(true);
+  assert.equal((await app.run({ action: 'register', username: 'reader', password: 'password1' })).status, 400);
+  app.rejectRegistration(false);
+  assert.equal((await app.run({ action: 'register', username: 'reader', password: 'password1' })).status, 200);
+});
diff --git a/tests/smsOtp.test.ts b/tests/smsOtp.test.ts
new file mode 100644
index 0000000..b66cf07
--- /dev/null
+++ b/tests/smsOtp.test.ts
@@ -0,0 +1,66 @@
+import { afterEach, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { listenForSmsCode } from '../src/utils/smsOtp.ts';
+
+const originalWindow = Object.getOwnPropertyDescriptor(globalThis, 'window');
+const originalNavigator = Object.getOwnPropertyDescriptor(globalThis, 'navigator');
+afterEach(() => {
+  for (const [name, descriptor] of [['window', originalWindow], ['navigator', originalNavigator]] as const) {
+    if (descriptor) Object.defineProperty(globalThis, name, descriptor);
+    else Reflect.deleteProperty(globalThis, name);
+  }
+});
+
+function browser(get: (options: CredentialRequestOptions) => Promise<unknown>, secure = true, supported = true) {
+  Object.defineProperty(globalThis, 'window', { configurable: true, value: {
+    isSecureContext: secure, ...(supported ? { OTPCredential: class {} } : {}),
+  } });
+  Object.defineProperty(globalThis, 'navigator', { configurable: true, value: { credentials: { get } } });
+}
+const flush = () => new Promise<void>((resolve) => setImmediate(resolve));
+
+test('unsupported browsers and insecure contexts retain manual entry', () => {
+  const get = () => { assert.fail('WebOTP must not be called'); };
+  browser(get, true, false);
+  assert.equal(listenForSmsCode(() => assert.fail()), null);
+  browser(get, false, true);
+  assert.equal(listenForSmsCode(() => assert.fail()), null);
+});
+
+test('extracts a complete code including leading zeros and requests SMS transport', async () => {
+  browser(async (options) => {
+    assert.deepEqual((options as CredentialRequestOptions & { otp: object }).otp, { transport: ['sms'] });
+    assert.ok(options.signal);
+    return { code: '012345' };
+  });
+  let received = '';
+  listenForSmsCode((code) => { received = code; });
+  await flush();
+  assert.equal(received, '012345');
+});
+
+test('aborting on manual submit, resend, or unmount prevents a late code callback', async () => {
+  let deliver: (value: unknown) => void = () => {};
+  browser(() => new Promise((resolve) => { deliver = resolve; }));
+  const controller = listenForSmsCode(() => assert.fail('An aborted code must not submit'))!;
+  controller.abort();
+  deliver({ code: '123456' });
+  await flush();
+  assert.equal(controller.signal.aborted, true);
+});
+
+test('denied permissions, null credentials, and malformed codes preserve the fallback', async () => {
+  for (const result of [null, { code: '123' }, { code: 'abcdef' }]) {
+    browser(async () => result);
+    listenForSmsCode(() => assert.fail('Invalid credentials must not submit'));
+    await flush();
+  }
+  browser(async () => { throw new Error('NotAllowedError'); });
+  listenForSmsCode(() => assert.fail());
+  await flush();
+});
+
+test('synchronous platform errors do not break the form', () => {
+  browser(() => { throw new Error('SecurityError'); });
+  assert.equal(listenForSmsCode(() => assert.fail())?.signal.aborted, true);
+});
