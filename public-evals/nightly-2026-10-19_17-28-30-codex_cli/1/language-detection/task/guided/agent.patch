+  <script>
+    const feedbackForm = document.querySelector('#feedback-form');
+    const feedbackMessage = document.querySelector('#feedback-message');
+    const detectButton = document.querySelector('#detect-button');
+    const feedbackStatus = document.querySelector('#feedback-status');
+    const modelProgress = document.querySelector('#model-progress');
+    let modelAvailability = 'unavailable';
+
+    async function checkLanguageDetection() {
+      if (!('LanguageDetector' in window)) {
+        feedbackStatus.textContent = 'Built-in language detection is not supported in this browser. Try a supported desktop browser such as Chrome.';
+        return;
+      }
+
+      try {
+        modelAvailability = await LanguageDetector.availability();
+        if (modelAvailability === 'unavailable') {
+          feedbackStatus.textContent = 'Language detection is unavailable on this device or is blocked by browser settings.';
+          return;
+        }
+        detectButton.disabled = false;
+        feedbackStatus.textContent = modelAvailability === 'available'
+          ? 'Ready to detect your message’s language.'
+          : 'Click Detect to download the language model and analyze your message.';
+      } catch (error) {
+        feedbackStatus.textContent = 'Could not check language detection availability. Reload the page to try again.';
+      }
+    }
+
+    feedbackMessage.addEventListener('input', () => {
+      if (!detectButton.disabled) {
+        feedbackStatus.textContent = 'Click Detect to analyze your message.';
+      }
+    });
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (detectButton.disabled) return;
+
+      const message = feedbackMessage.value.trim();
+      if (!message) {
+        feedbackStatus.textContent = 'Please enter a message first.';
+        feedbackMessage.focus();
+        return;
+      }
+
+      detectButton.disabled = true;
+      feedbackMessage.readOnly = true;
+      modelProgress.value = 0;
+      modelProgress.hidden = modelAvailability === 'available';
+      feedbackStatus.textContent = modelProgress.hidden
+        ? 'Detecting language…'
+        : 'Downloading language model: 0%';
+      let detector;
+
+      try {
+        // Create in the submit handler so a model download has user activation.
+        detector = await LanguageDetector.create({
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              const percent = Math.min(100, Math.max(0, Math.round(event.loaded * 100)));
+              modelProgress.hidden = false;
+              modelProgress.value = percent;
+              feedbackStatus.textContent = `Downloading language model: ${percent}%`;
+            });
+          },
+        });
+        modelAvailability = 'available';
+        modelProgress.hidden = true;
+        feedbackStatus.textContent = 'Detecting language…';
+        const results = await detector.detect(message);
+        const bestMatch = results[0];
+
+        if (!bestMatch || bestMatch.detectedLanguage === 'und') {
+          feedbackStatus.textContent = 'Could not identify a language. Try a longer, more detailed message.';
+          return;
+        }
+
+        let languageName = bestMatch.detectedLanguage;
+        try {
+          languageName = new Intl.DisplayNames(['en'], { type: 'language' }).of(languageName) || languageName;
+        } catch (error) {
+          // Keep the language code if a display name cannot be resolved.
+        }
+        const confidence = new Intl.NumberFormat('en', {
+          style: 'percent', maximumFractionDigits: 1,
+        }).format(bestMatch.confidence);
+        feedbackStatus.textContent = `Language: ${languageName} · AI confidence: ${confidence}`;
+      } catch (error) {
+        feedbackStatus.textContent = 'Language detection failed. Check your connection if the model needs downloading, then click Detect to try again.';
+      } finally {
+        detector?.destroy();
+        modelProgress.hidden = true;
+        feedbackMessage.readOnly = false;
+        detectButton.disabled = false;
+      }
+    });
+
+    checkLanguageDetection();
+  </script>
 </body>
 
