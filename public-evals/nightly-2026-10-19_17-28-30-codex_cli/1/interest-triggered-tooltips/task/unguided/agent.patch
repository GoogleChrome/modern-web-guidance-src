+    .details-tooltip span {
+      margin-top: 4px;
+      color: var(--secondary);
+    }
+
+    .details:not(.tooltip-dismissed):hover .details-tooltip,
+    .details:not(.tooltip-dismissed):focus-within .details-tooltip {
+      visibility: visible;
