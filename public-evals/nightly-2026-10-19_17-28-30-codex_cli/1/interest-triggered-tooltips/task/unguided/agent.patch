+  <script>
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') {
+        document.querySelectorAll('.details').forEach((details) => {
+          if (details.matches(':hover') || details.contains(document.activeElement)) {
+            details.classList.add('tooltip-dismissed');
+          }
+        });
+      }
+    });
+
+    document.querySelectorAll('.details').forEach((details) => {
+      details.addEventListener('mouseleave', () => {
+        if (!details.contains(document.activeElement)) {
+          details.classList.remove('tooltip-dismissed');
+        }
+      });
+      details.addEventListener('focusout', (event) => {
+        if (!details.contains(event.relatedTarget) && !details.matches(':hover')) {
+          details.classList.remove('tooltip-dismissed');
+        }
+      });
+    });
+  </script>
