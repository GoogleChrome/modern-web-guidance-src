+import { useEffect, useRef, useState } from 'react';
+
+type IconName = 'shield' | 'key' | 'user' | 'card' | 'bell' | 'bookmark' | 'arrow' | 'chevron' | 'plus' | 'laptop' | 'phone' | 'usb' | 'check' | 'close' | 'help' | 'logout' | 'globe';
+function Icon({ name, size = 20 }: { name: IconName; size?: number }) {
+  const paths: Record<IconName, React.ReactNode> = {
+    shield: <><path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></>,
+    key: <><circle cx="8" cy="8" r="5"/><path d="m11.5 11.5 9 9M16 16l3-3m-1 5 3-3"/></>,
+    user: <><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></>,
+    card: <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/></>,
+    bell: <><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></>,
+    bookmark: <path d="M6 3h12v18l-6-4-6 4V3Z"/>,
+    arrow: <><path d="M19 12H5m5-5-5 5 5 5"/></>,
+    chevron: <path d="m9 5 7 7-7 7"/>,
+    plus: <path d="M12 5v14M5 12h14"/>,
+    laptop: <><rect x="5" y="3" width="14" height="12" rx="1.5"/><path d="m5 15-3 5h20l-3-5M9 20h6"/></>,
+    phone: <><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M10 5h4M11 19h2"/></>,
+    usb: <><rect x="7" y="9" width="10" height="13" rx="4"/><path d="M9 9V2h6v7M12 4v2"/><circle cx="12" cy="15" r="1"/></>,
+    check: <path d="m5 12 4 4L19 6"/>,
+    close: <path d="m6 6 12 12M6 18 18 6"/>,
+    help: <><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 4 2c-1.5 1-1.5 1.5-1.5 2.5M12 17h.01"/></>,
+    logout: <><path d="M9 4H4v16h5M10 12h11m-4-4 4 4-4 4"/></>,
+    globe: <><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></>,
+  };
+  return <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.65" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">{paths[name]}</svg>;
+}
+
+type Passkey = { id: string; name: string; provider: string; type: 'laptop' | 'phone' | 'usb'; created: string; lastUsed: string; current?: boolean };
+const initial: Passkey[] = [
+  { id: 'macbook', name: 'MacBook Pro', provider: 'iCloud Keychain', type: 'laptop', created: 'Oct 12, 2026', lastUsed: 'Just now', current: true },
+  { id: 'iphone', name: 'iPhone 15', provider: 'iCloud Keychain', type: 'phone', created: 'Oct 8, 2026', lastUsed: '2 days ago' },
+  { id: 'yubikey', name: 'YubiKey 5C', provider: 'Security key', type: 'usb', created: 'Sep 24, 2026', lastUsed: 'Oct 10, 2026' },
+];
+const storageKey = 'devtools-times:demo-passkeys:v1';
+const base = import.meta.env.BASE_URL;
+
+export default function PasskeySettings() {
+  const [passkeys, setPasskeys] = useState<Passkey[]>(initial);
+  const [ready, setReady] = useState(false);
+  const [modal, setModal] = useState<{ type: 'add' | 'rename' | 'remove' | 'learn'; key?: Passkey } | null>(null);
+  const [name, setName] = useState('');
+  const [device, setDevice] = useState<'laptop' | 'phone' | 'usb'>('laptop');
+  const [message, setMessage] = useState('');
+  const dialog = useRef<HTMLDialogElement>(null);
+  const [section, setSection] = useState('Security');
+  useEffect(() => {
+    try {
+      const saved = localStorage.getItem(storageKey);
+      if (saved) { const parsed = JSON.parse(saved); if (Array.isArray(parsed) && parsed.every(p => typeof p.id === 'string' && typeof p.name === 'string' && ['laptop', 'phone', 'usb'].includes(p.type) && typeof p.provider === 'string' && typeof p.created === 'string' && typeof p.lastUsed === 'string')) setPasskeys(parsed); }
+    } catch { /* Use the sample collection if storage is unavailable. */ }
+    setReady(true);
+  }, []);
+  useEffect(() => { if (modal) dialog.current?.showModal(); else dialog.current?.close(); }, [modal]);
+  function save(next: Passkey[], notice: string) {
+    try { localStorage.setItem(storageKey, JSON.stringify(next)); setMessage(notice); }
+    catch { setMessage(`${notice} Changes will only last for this visit because browser storage is unavailable.`); }
+    setPasskeys(next); setModal(null);
+  }
+  function open(type: 'add' | 'rename' | 'remove' | 'learn', key?: Passkey) { setName(key?.name || ''); setDevice('laptop'); setModal({ type, key }); }
+  function submit(e: React.FormEvent) {
+    e.preventDefault();
+    if (!name.trim()) return;
+    if (modal?.type === 'rename') save(passkeys.map(p => p.id === modal.key?.id ? { ...p, name: name.trim() } : p), 'Passkey renamed.');
+    if (modal?.type === 'add') save([...passkeys, { id: crypto.randomUUID(), name: name.trim(), type: device, provider: device === 'usb' ? 'Security key' : 'Device passkey', created: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }), lastUsed: 'Not used yet' }], 'Demo passkey added.');
+  }
+  return <div className="account-app">
+    <div className="edition-bar"><span>Independent journalism. Informed perspectives.</span><span>Monday, October 19, 2026</span></div>
+    <header className="account-header"><a href={`${base}news`} className="masthead"><img src={`${base}logo.svg`} alt="The DevTools Times" /></a><div className="header-actions"><a className="back-news" href={`${base}news`}><Icon name="arrow" size={16}/> Back to the news</a><span className="header-divider"/><span className="avatar">JD</span><span className="header-account">My account <span className="down-chevron">⌄</span></span></div></header>
+    <div className="account-shell"><aside className="account-sidebar"><p className="eyebrow">YOUR ACCOUNT</p><div className="sidebar-profile"><span className="avatar large">JD</span><div><strong>Jamie Davis</strong><span>Times subscriber</span></div></div><nav aria-label="Account settings">{([{ name: 'Overview', icon: 'user' }, { name: 'Subscription & billing', icon: 'card' }, { name: 'Security', icon: 'shield' }, { name: 'Notifications', icon: 'bell' }, { name: 'Reading preferences', icon: 'bookmark' }] as { name: string; icon: IconName }[]).map(item => <button key={item.name} className={`side-link ${section === item.name ? 'selected' : ''}`} onClick={() => setSection(item.name)}><Icon name={item.icon}/>{item.name}{section === item.name && <span className="nav-dot"/>}</button>)}</nav><div className="sidebar-bottom"><button onClick={() => open('learn')}><Icon name="help" size={18}/> Help & support <span>↗</span></button><a href={`${base}signin`}><Icon name="logout" size={18}/> Sign out</a></div><div className="subscriber-note"><span className="small-spark">✧</span><p>Good journalism starts<br/>with readers like you.</p><span>Thank you for being here.</span></div></aside>
+    <main className="settings-main"><div className="breadcrumb">Account <Icon name="chevron" size={12}/> {section}{section === 'Security' && <><Icon name="chevron" size={12}/><span>Passkeys</span></>}</div>
+    {section === 'Security' ? <><div className="page-heading"><div><p className="eyebrow green">A SAFER WAY TO SIGN IN</p><h1>Passkeys</h1><p>Less to remember. More peace of mind.</p></div><span className="security-emblem"><Icon name="shield" size={31}/></span></div>
+      <section className="intro-panel"><span className="intro-icon"><Icon name="key" size={27}/></span><div><h2>Your account. A little more secure.</h2><p>Sign in with your fingerprint, face, or device screen lock.<br className="desktop-break"/> Passkeys are a simple, secure alternative to passwords.</p><button className="text-link" onClick={() => open('learn')}>Get to know passkeys <span>↗</span></button></div><div className="key-illustration" aria-hidden="true"><span className="orbit one"/><span className="orbit two"/><div className="illustration-card"><Icon name="key" size={39}/><span><i/><i/><i/><i/></span><b><Icon name="check" size={13}/></b></div><span className="illustration-spark">✧</span></div></section>
+      <section className="passkeys-section" aria-labelledby="registered-heading"><div className="section-heading"><div><h2 id="registered-heading">Your passkeys <span className="count">{passkeys.length}</span></h2><p>Manage the passkeys you use to sign in to The DevTools Times.</p></div><button className="primary-button" onClick={() => open('add')} disabled={!ready}><Icon name="plus" size={17}/> Add a passkey</button></div>
+      {message && <div className="notice" role="status"><Icon name="check" size={17}/>{message}<button onClick={() => setMessage('')} aria-label="Dismiss notification"><Icon name="close" size={16}/></button></div>}
+      <div className="passkey-list">{passkeys.map(p => <article className="passkey-row" key={p.id}><span className={`device-icon ${p.type}`}><Icon name={p.type} size={26}/></span><div className="device-info"><div className="device-title"><h3>{p.name}</h3>{p.current && <span className="current-badge"><span/>This device</span>}</div><p>{p.provider}</p><div className="device-meta"><span>Added {p.created}</span><span className="meta-dot">·</span><span>Last used: <span className={p.current ? 'used-now' : ''}>{p.lastUsed}</span></span></div></div><div className="row-actions"><button onClick={() => open('rename', p)}>Rename</button><span/><button className="remove-action" onClick={() => open('remove', p)}>Remove</button></div></article>)}{!passkeys.length && <div className="empty-state"><Icon name="key" size={32}/><h3>No passkeys yet</h3><p>Add a passkey to get started with a simpler way to sign in.</p><button className="text-link" onClick={() => open('add')}>Add your first passkey →</button></div>}</div><div className="list-footnote"><Icon name="shield" size={15}/><span>Your biometric information stays on your device. It’s never shared with us.</span></div></section>
+      <section className="backup-panel"><span className="backup-icon"><Icon name="globe" size={22}/></span><div><h3>A small step for a smoother sign-in.</h3><p>Add a passkey on another device so you always have a way in.</p></div><button onClick={() => open('add')} aria-label="Add a passkey on another device"><Icon name="arrow" size={20}/></button></section>
+      <div className="questions"><span>Have a question about passkeys?</span><button onClick={() => open('learn')}>We’re here to help <span>↗</span></button></div><p className="demo-label">Preview account · Changes are saved in this browser</p>
+    </> : <div className="other-section"><p className="eyebrow green">YOUR TIMES ACCOUNT</p><h1>{section}</h1><p>{section === 'Overview' ? 'Welcome back, Jamie. Your independent perspective starts here.' : `Your ${section.toLowerCase()} settings will be available when your account is connected.`}</p><div className="other-section-card"><Icon name="shield" size={32}/><h2>Keep your account secure</h2><p>View your registered devices and manage your passkeys.</p><button className="primary-button" onClick={() => setSection('Security')}>Manage passkeys <Icon name="chevron" size={16}/></button></div></div>}
+    </main></div><footer className="account-footer"><span>© 2026 The DevTools Times</span><span><a href={`${base}legal/privacy`}>Privacy policy</a><a href={`${base}legal/terms`}>Terms of service</a><button onClick={() => open('learn')}>Contact us</button></span><span className="footer-tagline">Stay curious. Stay informed.</span></footer>
+    <dialog ref={dialog} onCancel={() => setModal(null)} onClick={e => { if (e.target === e.currentTarget) setModal(null); }}><div className="dialog-content"><button className="dialog-close" aria-label="Close dialog" onClick={() => setModal(null)}><Icon name="close"/></button><span className="modal-icon"><Icon name={modal?.type === 'remove' ? 'shield' : 'key'} size={27}/></span><h2>{modal?.type === 'add' ? 'Add a passkey' : modal?.type === 'rename' ? 'Rename passkey' : modal?.type === 'remove' ? 'Remove this passkey?' : 'A simpler way to sign in'}</h2>
+      {modal?.type === 'learn' ? <><p>Passkeys let you sign in using your fingerprint, face, or device screen lock. Your device keeps the private key and your biometric information safe.</p><div className="learn-details"><h3>Can I use more than one device?</h3><p>Yes. Keep a passkey on another device or a security key as a backup.</p><h3>What happens if I remove a passkey?</h3><p>That passkey can no longer sign in. You can still use another registered passkey or your password.</p></div><p className="modal-demo">This is a preview account. Passkey changes are stored locally; real registration requires a connected authentication service.</p><button className="primary-button full" onClick={() => setModal(null)}>Got it</button></> : modal?.type === 'remove' ? <><p>Remove <strong>{modal.key?.name}</strong> from your passkeys? You’ll need another passkey or your password to sign in on this device.</p>{passkeys.length === 1 && <p className="last-key-warning">This is your last passkey. Make sure you can sign in with your password before removing it.</p>}<div className="dialog-buttons"><button className="secondary-button" onClick={() => setModal(null)}>Keep passkey</button><button className="danger-button" onClick={() => save(passkeys.filter(p => p.id !== modal.key?.id), 'Passkey removed.')}>Remove passkey</button></div></> : <form onSubmit={submit}><p>{modal?.type === 'add' ? 'Give this passkey a name you’ll recognize later.' : 'Choose a name that makes this device easy to recognize.'}</p><label htmlFor="passkey-name">Passkey name</label><input autoFocus id="passkey-name" placeholder="e.g. My MacBook" value={name} onChange={e => setName(e.target.value)} required maxLength={60}/>{modal?.type === 'add' && <><label htmlFor="device-type">Device type</label><select id="device-type" value={device} onChange={e => setDevice(e.target.value as typeof device)}><option value="laptop">Computer</option><option value="phone">Phone or tablet</option><option value="usb">Security key</option></select><p className="modal-demo">Demo mode: this adds a sample device in this browser. No real passkey is registered.</p></>}<div className="dialog-buttons"><button type="button" className="secondary-button" onClick={() => setModal(null)}>Cancel</button><button className="primary-button" type="submit" disabled={!name.trim()}>{modal?.type === 'add' ? 'Add demo passkey' : 'Save changes'}</button></div></form>}
+    </div></dialog>
+  </div>;
+}
