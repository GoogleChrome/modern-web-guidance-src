--- /dev/null
+++ b/src/pages/api/passkeys/register.ts
@@ -0,0 +1,89 @@
+import type { APIRoute } from "astro";
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+} from "@simplewebauthn/server";
+import {
+  getAccount,
+  publicAccount,
+  json,
+  sameOrigin,
+} from "../../../lib/passkeys";
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!sameOrigin(request))
+    return json({ error: "Invalid request origin." }, 403);
+  if (!session) return json({ error: "Session unavailable." }, 503);
+  const account = await getAccount(session);
+  try {
+    const body = await request.json();
+    if (body.action === "options") {
+      const options = await generateRegistrationOptions({
+        rpName: "The DevTools Times · Demo",
+        rpID: url.hostname,
+        userID: new Uint8Array(Buffer.from(account.id, "base64url")),
+        userName: account.name,
+        userDisplayName: account.displayName,
+        excludeCredentials: account.credentials
+          .filter((c) => !c.demo)
+          .map((c) => ({ id: c.id, transports: c.transports })),
+        authenticatorSelection: {
+          residentKey: "required",
+          requireResidentKey: true,
+          userVerification: "required",
+        },
+      });
+      await session.set("passkeyChallenge", {
+        challenge: options.challenge,
+        expiresAt: Date.now() + 300000,
+      });
+      return json(options);
+    }
+    if (body.action !== "verify")
+      return json({ error: "Unknown registration action." }, 400);
+    const challenge = (await session.get("passkeyChallenge")) as
+      { challenge: string; expiresAt: number } | undefined;
+    await session.delete("passkeyChallenge");
+    if (!challenge || challenge.expiresAt < Date.now())
+      return json({ error: "Registration expired. Please try again." }, 400);
+    const result = await verifyRegistrationResponse({
+      response: body.credential,
+      expectedChallenge: challenge.challenge,
+      expectedOrigin: url.origin,
+      expectedRPID: url.hostname,
+      requireUserVerification: true,
+    });
+    if (!result.verified)
+      return json({ error: "Passkey verification failed." }, 400);
+    const info = result.registrationInfo;
+    if (account.credentials.some((c) => c.id === info.credential.id))
+      return json({ error: "This passkey is already registered." }, 409);
+    const providers: Record<string, string> = {
+      "adce0002-35bc-c60a-648b-0b25f1f05503": "iCloud Keychain",
+      "ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4": "Google Password Manager",
+      "bada5566-a7aa-401f-bd96-45619a55120d": "1Password",
+    };
+    const provider = providers[info.aaguid] || "Passkey provider";
+    account.credentials.push({
+      id: info.credential.id,
+      name:
+        typeof body.name === "string" && body.name.trim()
+          ? body.name.trim().slice(0, 60)
+          : "New passkey",
+      provider,
+      kind: info.credentialDeviceType === "singleDevice" ? "key" : "device",
+      registeredAt: Date.now(),
+      aaguid: info.aaguid,
+      publicKey: Buffer.from(info.credential.publicKey).toString("base64url"),
+      counter: info.credential.counter,
+      transports: info.credential.transports,
+      backedUp: info.credentialBackedUp,
+    });
+    await session.set("passkeyAccount", account);
+    return json(publicAccount(account));
+  } catch {
+    return json(
+      { error: "We couldn’t register the passkey. Please try again." },
+      400,
+    );
+  }
+};
