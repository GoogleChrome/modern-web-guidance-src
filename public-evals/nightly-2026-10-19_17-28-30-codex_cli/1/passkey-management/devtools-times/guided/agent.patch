+}
+const date = (time: number) =>
+  new Date(time).toLocaleDateString("en-US", {
+    month: "short",
+    day: "numeric",
+    year: "numeric",
+  });
+const relativeDate = (time?: number) => {
+  if (!time) return "Not used yet";
+  const days = Math.floor((Date.now() - time) / 86400000);
+  return days === 0 ? "Today" : days === 1 ? "Yesterday" : `${days} days ago`;
+};
+const base = import.meta.env.BASE_URL;
+type Mode =
+  | "rename"
+  | "remove"
+  | "add"
+  | "learn"
+  | "help"
+  | "profile"
+  | "subscription"
+  | "saved"
+  | null;
+export default function PasskeySettings() {
+  const [account, setAccount] = useState<PasskeyAccount | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [mode, setMode] = useState<Mode>(null);
+  const [selected, setSelected] = useState<PasskeyRecord | null>(null);
+  const [name, setName] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [supported, setSupported] = useState(false);
+  const [tab, setTab] = useState("Sign-in methods");
+  const dialog = useRef<HTMLDialogElement>(null);
+  const controller = useRef<AbortController | null>(null);
+  async function api(path = "", method = "GET", body?: unknown) {
+    const response = await fetch(`${base}api/passkeys/${path}`, {
+      method,
+      headers: { "Content-Type": "application/json" },
+      ...(body ? { body: JSON.stringify(body) } : {}),
+    });
+    const result = await response.json();
+    if (!response.ok)
+      throw new Error(
+        result.error || "Something went wrong. Please try again.",
+      );
+    return result;
+  }
+  async function sync(current: PasskeyAccount) {
+    if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+    try {
+      await PublicKeyCredential.signalAllAcceptedCredentials({
+        rpId: location.hostname,
+        userId: current.id,
+        allAcceptedCredentialIds: current.credentials
+          .filter((c) => !c.demo)
+          .map((c) => c.id),
+      });
+    } catch {
+      /* Optional password-manager synchronization. */
+    }
+  }
+  async function load() {
+    setLoading(true);
+    setError("");
+    try {
+      const result = await api();
+      setAccount(result);
+      await sync(result);
+    } catch (e) {
+      setError((e as Error).message);
+    } finally {
+      setLoading(false);
+    }
+  }
+  useEffect(() => {
+    void load();
+    async function detect() {
+      if (!window.isSecureContext || !window.PublicKeyCredential) return;
+      await import("webauthn-polyfills");
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        setSupported(Boolean(capabilities.passkeyPlatformAuthenticator));
+      } catch {
+        setSupported(false);
+      }
+    }
+    void detect();
+    return () => controller.current?.abort();
+  }, []);
+  useEffect(() => {
+    if (mode && !dialog.current?.open) dialog.current?.showModal();
+  }, [mode]);
+  useEffect(() => {
+    if (!notice) return;
+    const timer = setTimeout(() => setNotice(""), 6000);
+    return () => clearTimeout(timer);
+  }, [notice]);
+  function open(next: Mode, credential?: PasskeyRecord) {
+    setSelected(credential || null);
+    setName(credential?.name || "");
+    setError("");
+    setMode(next);
+  }
+  function close() {
+    controller.current?.abort();
+    dialog.current?.close();
+    setMode(null);
+    setError("");
+  }
+  async function save(event: FormEvent) {
+    event.preventDefault();
+    setBusy(true);
+    setError("");
+    try {
+      if (mode === "rename" && selected) {
+        const updated = await api("", "PATCH", { id: selected.id, name });
+        setAccount(updated);
+        close();
+        setNotice("Passkey renamed successfully.");
+      } else if (mode === "remove" && selected) {
+        const updated = await api("", "DELETE", { id: selected.id });
+        setAccount(updated);
+        await sync(updated);
+        close();
+        setNotice("Passkey removed from your account.");
+      } else if (mode === "add") {
+        const options = await api("register", "POST", { action: "options" });
+        controller.current = new AbortController();
+        const credential = (await navigator.credentials.create({
+          publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(options),
+          signal: controller.current.signal,
+        })) as PublicKeyCredential | null;
+        if (!credential)
+          throw new Error("No passkey was created. Please try again.");
+        let updated;
+        try {
+          updated = await api("register", "POST", {
+            action: "verify",
+            credential: credential.toJSON(),
+            name: name.trim() || "New passkey",
+          });
+        } catch (e) {
+          if (PublicKeyCredential.signalUnknownCredential) {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: location.hostname,
+                credentialId: credential.id,
+              });
+            } catch {
+              /* Optional sync. */
+            }
+          }
+          throw e;
+        }
+        setAccount(updated);
+        await sync(updated);
+        close();
+        setNotice("Your new passkey is ready.");
+      }
+    } catch (e) {
+      const err = e as Error;
+      setError(
+        err.name === "NotAllowedError"
+          ? "Passkey creation was cancelled or timed out. You can try again."
+          : err.name === "InvalidStateError"
+            ? "This device already has a passkey for this account."
+            : err.name === "AbortError"
+              ? "Passkey creation was cancelled."
+              : err.name === "SecurityError"
+                ? "Passkeys require a secure connection (HTTPS or localhost)."
