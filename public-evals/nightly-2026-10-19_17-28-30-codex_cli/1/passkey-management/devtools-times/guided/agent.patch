+import type { APIRoute } from "astro";
+import {
+  getAccount,
+  json,
+  publicAccount,
+  sameOrigin,
+} from "../../../lib/passkeys";
+export const GET: APIRoute = async ({ session }) => {
+  if (!session) return json({ error: "Session unavailable." }, 503);
+  return json(publicAccount(await getAccount(session)));
+};
+export const PATCH: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request))
+    return json({ error: "Invalid request origin." }, 403);
+  if (!session) return json({ error: "Session unavailable." }, 503);
+  try {
+    const { id, name } = await request.json();
+    if (typeof name !== "string" || !name.trim() || name.trim().length > 60)
+      return json({ error: "Enter a name between 1 and 60 characters." }, 400);
+    const account = await getAccount(session);
+    const credential = account.credentials.find((c) => c.id === id);
+    if (!credential) return json({ error: "Passkey not found." }, 404);
+    credential.name = name.trim();
+    await session.set("passkeyAccount", account);
+    return json(publicAccount(account));
+  } catch {
+    return json({ error: "Unable to rename this passkey." }, 400);
+  }
+};
+export const DELETE: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request))
+    return json({ error: "Invalid request origin." }, 403);
+  if (!session) return json({ error: "Session unavailable." }, 503);
+  try {
+    const { id } = await request.json();
+    const account = await getAccount(session);
+    if (!account.credentials.some((c) => c.id === id))
+      return json({ error: "Passkey not found." }, 404);
+    account.credentials = account.credentials.filter((c) => c.id !== id);
+    await session.set("passkeyAccount", account);
+    return json(publicAccount(account));
+  } catch {
+    return json({ error: "Unable to remove this passkey." }, 400);
+  }
+};
diff --git a/src/pages/api/passkeys/register.ts b/src/pages/api/passkeys/register.ts
