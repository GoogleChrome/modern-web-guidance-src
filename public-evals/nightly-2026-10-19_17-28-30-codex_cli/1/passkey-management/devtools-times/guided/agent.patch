+            </button>
+            <button onClick={() => open("subscription")}>
+              <Icon name="card" />
+              Subscription & billing
+            </button>
+            <button
+              className="selected"
+              aria-current="page"
+              onClick={() => setTab("Sign-in methods")}
+            >
+              <Icon name="shield" />
