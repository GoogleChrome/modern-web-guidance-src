+              <Icon name="chevron" size={14} />
+            </button>
+            <button onClick={() => open("saved")}>
+              <Icon name="bookmark" />
+              Saved articles
+            </button>
+          </nav>
+          <div className="sidebar-support">
+            <div className="support-icon">
+              <Icon name="help" size={22} />
+            </div>
+            <h3>A little help?</h3>
+            <p>Our team is always a click away.</p>
+            <button onClick={() => open("help")}>
+              Visit the help center <Icon name="arrow" size={16} />
+            </button>
+          </div>
+          <div className="sidebar-user">
+            <div className="avatar">AM</div>
+            <div>
+              <strong>{account?.displayName || "Alex Morgan"}</strong>
+              <span>Demo account</span>
+            </div>
+            <button
+              title="Account information"
+              aria-label="Account information"
+              onClick={() => open("profile")}
+            >
+              <Icon name="chevron" size={17} />
+            </button>
+          </div>
+        </aside>
+        <main className="settings-main" id="main-content">
+          <div className="breadcrumb">
+            Your account <Icon name="chevron" size={12} />
+            <span>Security & sign-in</span>
+          </div>
+          <div className="page-heading">
+            <div>
+              <span className="eyebrow">SAFE. SECURE. YOURS.</span>
+              <h1>Security & sign-in</h1>
+              <p>
+                Good stories deserve a secure home. Keep your account protected.
+              </p>
+            </div>
+            <div className="heading-shield">
+              <Icon name="shield" size={27} />
+            </div>
+          </div>
+          <div
+            className="settings-tabs"
+            role="tablist"
+            aria-label="Security settings"
+          >
+            {["Sign-in methods", "Active sessions", "Login activity"].map(
