new file mode 100644
index 0000000..43b2507
--- /dev/null
+++ b/scripts/check-passkeys.mjs
@@ -0,0 +1,97 @@
+import assert from "node:assert/strict";
+
+// Run against a local build: pnpm build && pnpm start
+const origin = process.env.TEST_ORIGIN || "http://localhost:11224";
+const base = `${origin}/devtools-times`;
+let cookie = "";
+async function request(method = "GET", body, requestOrigin = origin) {
+  const response = await fetch(`${base}/api/passkeys/`, {
+    method,
+    headers: {
+      Cookie: cookie,
+      ...(method !== "GET"
+        ? { Origin: requestOrigin, "Content-Type": "application/json" }
+        : {}),
+    },
+    body: body && JSON.stringify(body),
+  });
+  const setCookie = response.headers.get("set-cookie");
+  if (setCookie) cookie = setCookie.split(";")[0];
+  return { status: response.status, data: await response.json() };
+}
+const first = await request();
+assert.equal(first.status, 200);
+assert.equal(first.data.credentials.length, 3);
+const id = first.data.credentials[0].id;
+let result = await request("PATCH", { id, name: "My renamed laptop" });
+assert.equal(result.status, 200);
+assert.equal(result.data.credentials[0].name, "My renamed laptop");
+result = await request();
+assert.equal(result.data.credentials[0].name, "My renamed laptop");
+for (const name of ["   ", "x".repeat(61)]) {
+  assert.equal((await request("PATCH", { id, name })).status, 400);
+}
+assert.equal(
+  (await request("DELETE", { id }, "https://evil.example")).status,
+  403,
+);
+assert.equal((await request("DELETE", { id: "not-owned" })).status, 404);
+const otherSession = await fetch(`${base}/api/passkeys/`);
+const other = await otherSession.json();
+assert.equal(other.credentials.length, 3);
+assert.notEqual(other.id, first.data.id);
+const crossAccount = await fetch(`${base}/api/passkeys/`, {
+  method: "DELETE",
+  headers: {
+    Cookie: otherSession.headers.get("set-cookie").split(";")[0],
+    Origin: origin,
+    "Content-Type": "application/json",
+  },
+  body: JSON.stringify({ id }),
+});
+assert.equal(crossAccount.status, 404);
+result = await request("DELETE", { id });
+assert.equal(result.status, 200);
+assert.equal((await request()).data.credentials.length, 2);
+const registration = await fetch(`${base}/api/passkeys/register`, {
+  method: "POST",
+  headers: {
+    Cookie: cookie,
+    Origin: origin,
+    "Content-Type": "application/json",
+  },
+  body: JSON.stringify({ action: "options" }),
+});
+assert.equal(registration.status, 200);
+const options = await registration.json();
+assert.equal(options.rp.id, new URL(origin).hostname);
+assert.equal(options.authenticatorSelection.residentKey, "required");
+assert.equal(options.authenticatorSelection.userVerification, "required");
+assert.equal(options.authenticatorSelection.authenticatorAttachment, undefined);
+assert.ok(options.challenge);
+assert.equal(
+  options.excludeCredentials.length,
+  0,
+  "Example keys must not be sent to authenticators",
+);
+const invalid = await fetch(`${base}/api/passkeys/register`, {
+  method: "POST",
+  headers: {
+    Cookie: cookie,
+    Origin: origin,
+    "Content-Type": "application/json",
+  },
+  body: JSON.stringify({ action: "verify", credential: {} }),
+});
+assert.equal(invalid.status, 400);
+for (const credential of result.data.credentials)
+  await request("DELETE", { id: credential.id });
+assert.deepEqual((await request()).data.credentials, []);
+for (const path of ["/", "/account/security"]) {
+  const page = await fetch(base + path);
+  assert.equal(page.status, 200);
+  assert.match(await page.text(), /Security &amp; sign-in/);
+}
+console.log(
+  "Passkey checks passed: rendering, session isolation, ownership, validation, rename/delete persistence, empty state, origin checks, registration options, invalid attestation rejection.",
+);
