+++ b/src/lib/passkeys.ts
@@ -0,0 +1,84 @@
+import type { AstroSession } from "astro";
+import { randomBytes } from "node:crypto";
+
+export interface PasskeyRecord {
+  id: string;
+  name: string;
+  provider: string;
+  kind: "device" | "phone" | "key";
+  registeredAt: number;
+  lastUsedAt?: number;
+  demo?: boolean;
+  publicKey?: string;
+  counter?: number;
+  transports?: string[];
+  aaguid?: string;
+  backedUp?: boolean;
+}
+export interface PasskeyAccount {
+  id: string;
+  name: string;
+  displayName: string;
+  credentials: PasskeyRecord[];
+}
+export async function getAccount(
+  session: AstroSession,
+): Promise<PasskeyAccount> {
+  const existing = (await session.get("passkeyAccount")) as
+    PasskeyAccount | undefined;
+  if (existing) return existing;
+  const now = Date.now();
+  const account: PasskeyAccount = {
+    id: randomBytes(32).toString("base64url"),
+    name: "alex.morgan@example.com",
+    displayName: "Alex Morgan",
+    credentials: [
+      {
+        id: randomBytes(24).toString("base64url"),
+        name: "MacBook Pro",
+        provider: "iCloud Keychain",
+        kind: "device",
+        registeredAt: now - 86400000 * 45,
+        lastUsedAt: now - 3600000 * 2,
+        demo: true,
+      },
+      {
+        id: randomBytes(24).toString("base64url"),
+        name: "iPhone 15",
+        provider: "iCloud Keychain",
+        kind: "phone",
+        registeredAt: now - 86400000 * 30,
+        lastUsedAt: now - 86400000 * 2,
+        demo: true,
+      },
+      {
+        id: randomBytes(24).toString("base64url"),
+        name: "YubiKey 5C NFC",
+        provider: "Security key",
+        kind: "key",
+        registeredAt: now - 86400000 * 12,
+        lastUsedAt: now - 86400000 * 5,
+        demo: true,
+      },
+    ],
+  };
+  await session.set("passkeyAccount", account);
+  return account;
+}
+export function publicAccount(account: PasskeyAccount) {
+  return {
+    ...account,
+    credentials: account.credentials.map(
+      ({ publicKey, counter, ...credential }) => credential,
+    ),
+  };
+}
+export function json(data: unknown, status = 200) {
+  return Response.json(data, {
+    status,
+    headers: { "Cache-Control": "no-store" },
+  });
+}
+export function sameOrigin(request: Request) {
+  return request.headers.get("origin") === new URL(request.url).origin;
+}
