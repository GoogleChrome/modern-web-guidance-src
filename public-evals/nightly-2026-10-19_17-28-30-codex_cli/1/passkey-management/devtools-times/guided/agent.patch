+          {tab === "Sign-in methods" ? (
+            <section role="tabpanel" aria-labelledby="tab-Sign-in-methods">
+              <div className="passkey-intro">
+                <div>
+                  <div className="section-kicker">
+                    <Icon name="key" size={18} />
+                    <span>A SMARTER WAY TO SIGN IN</span>
+                  </div>
+                  <h2>Your keys. Your account.</h2>
+                  <p>
+                    Skip the password. Sign in with your fingerprint, face, or
+                    screen lock.
+                    <br className="desktop-break" /> Passkeys are a simple,
+                    secure way to keep your account yours.
+                  </p>
+                </div>
+                <div className="key-art" aria-hidden="true">
+                  <span className="orbit orbit-one" />
+                  <span className="orbit orbit-two" />
+                  <div className="art-key">
+                    <Icon name="key" size={42} />
+                  </div>
+                  <span className="art-spark">✦</span>
+                  <span className="art-check">
+                    <Icon name="check" size={13} />
+                  </span>
+                </div>
+              </div>
+              <div className="passkey-list-heading">
+                <div>
+                  <h3>
+                    Passkeys{" "}
+                    <span className="count">
+                      {account?.credentials.length ?? "–"}
+                    </span>
+                  </h3>
+                  <p>
+                    Manage the devices and security keys you use to sign in.
+                  </p>
+                </div>
+                <button className="primary-button" onClick={() => open("add")}>
