+const storageKey = 'daily-grind.passkeys.v1';
+const initialPasskeys = [
+  { id: 'sample-mac', name: 'MacBook Pro', provider: 'iCloud Keychain', type: 'laptop', registeredAt: '2026-09-12T10:00:00Z', lastUsedAt: '2026-10-19T09:41:00Z', current: true },
+  { id: 'sample-phone', name: 'iPhone 15', provider: 'iCloud Keychain', type: 'phone', registeredAt: '2026-09-12T10:05:00Z', lastUsedAt: '2026-10-18T15:30:00Z' },
+  { id: 'sample-yubikey', name: 'YubiKey 5 NFC', provider: 'Security key', type: 'usb', registeredAt: '2026-09-18T14:00:00Z', lastUsedAt: '2026-10-14T12:00:00Z' },
+];
+let passkeys;
+try {
+  const saved = JSON.parse(localStorage.getItem(storageKey));
+  passkeys = Array.isArray(saved) && saved.every(p => p && typeof p.id === 'string' && typeof p.name === 'string' && ['laptop', 'phone', 'usb'].includes(p.type) && typeof p.provider === 'string' && Number.isFinite(Date.parse(p.registeredAt)) && (!p.lastUsedAt || Number.isFinite(Date.parse(p.lastUsedAt)))) ? saved : structuredClone(initialPasskeys);
+} catch { passkeys = structuredClone(initialPasskeys); }
+const $ = id => document.getElementById(id);
+const icon = name => `<svg aria-hidden="true"><use href="#${name}"/></svg>`;
+const escapeHtml = text => String(text).replace(/[&<>"']/g, char => ({'&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'}[char]));
+const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
+function formatDate(value) { return dateFormat.format(new Date(value)); }
+function lastUsed(value) {
+  if (!value) return 'Not used yet';
+  const date = new Date(value);
+  const today = new Date();
+  const yesterday = new Date(today); yesterday.setDate(today.getDate() - 1);
+  if (date.toDateString() === today.toDateString()) return 'Today';
+  if (date.toDateString() === yesterday.toDateString()) return 'Yesterday';
+  return formatDate(value);
+}
+function render() {
+  $('passkey-count').textContent = passkeys.length;
+  $('passkey-list').innerHTML = passkeys.length ? passkeys.map(p => `<article class="passkey-row"><div class="device-icon">${icon(p.type)}</div><div class="device-info"><div class="device-title"><h3>${escapeHtml(p.name)}</h3>${p.current ? '<span class="current">This device</span>' : ''}</div><div class="device-provider">${escapeHtml(p.provider)}</div><div class="device-meta"><span>Added ${formatDate(p.registeredAt)}</span><span aria-hidden="true">·</span><span>Last used: ${lastUsed(p.lastUsedAt)}</span></div></div><div class="actions"><button class="icon-btn" data-rename="${escapeHtml(p.id)}" aria-label="Rename ${escapeHtml(p.name)}" title="Rename passkey">${icon('edit')}</button><button class="icon-btn delete" data-delete="${escapeHtml(p.id)}" aria-label="Remove ${escapeHtml(p.name)}" title="Remove passkey">${icon('trash')}</button></div></article>`).join('') : `<div class="empty">${icon('key')}<h3>A fresh start for your security.</h3><p>You don’t have any passkeys yet.<br>Add one to make signing in a little simpler.</p></div>`;
+}
+let toastTimeout;
+function toast(message) {
+  $('toast').textContent = message;
+  $('toast').classList.add('show');
+  clearTimeout(toastTimeout);
+  toastTimeout = setTimeout(() => $('toast').classList.remove('show'), 4000);
+}
+function persist(next) {
+  try { localStorage.setItem(storageKey, JSON.stringify(next)); }
+  catch { toast('Your browser couldn’t save the change. Please allow local storage and try again.'); return false; }
+  passkeys = next; render(); return true;
+}
+let selectedId = null;
+function openEditor(id = null) {
+  selectedId = id;
+  const passkey = passkeys.find(p => p.id === id);
+  $('edit-title').textContent = id ? 'Rename passkey' : 'Add a passkey';
+  $('edit-dialog').querySelector('.dialog-description').textContent = id ? 'Give this passkey a name you’ll recognize. This only changes its name in your account.' : 'Add a device to explore how passkey management works.';
+  $('passkey-name').value = passkey?.name || '';
+  $('passkey-name').setCustomValidity('');
+  $('passkey-name').placeholder = 'e.g. My personal laptop';
+  $('device-field').hidden = Boolean(id);
+  $('create-note').hidden = Boolean(id);
+  $('save-passkey').textContent = id ? 'Save changes' : 'Add preview passkey';
+  $('device-type').value = 'laptop';
+  $('edit-dialog').showModal();
+  $('passkey-name').focus();
+}
+$('add-passkey').addEventListener('click', () => openEditor());
+$('passkey-name').addEventListener('input', () => $('passkey-name').setCustomValidity(''));
+$('edit-form').addEventListener('submit', event => {
+  event.preventDefault();
+  const name = $('passkey-name').value.trim();
+  if (!name) { $('passkey-name').setCustomValidity('Please enter a passkey name.'); $('passkey-name').reportValidity(); return; }
+  let next;
+  if (selectedId) next = passkeys.map(p => p.id === selectedId ? {...p, name} : p);
+  else {
+    const type = $('device-type').value;
+    next = [...passkeys, {id: `preview-${crypto.randomUUID()}`, name, type, provider: type === 'usb' ? 'Security key · Preview' : 'Device passkey · Preview', registeredAt: new Date().toISOString(), lastUsedAt: null}];
+  }
+  if (persist(next)) { $('edit-dialog').close(); toast(selectedId ? 'Passkey renamed.' : 'Preview passkey added.'); }
+});
+$('passkey-list').addEventListener('click', event => {
+  const rename = event.target.closest('[data-rename]');
+  if (rename) { openEditor(rename.dataset.rename); return; }
+  const remove = event.target.closest('[data-delete]');
+  if (!remove) return;
+  selectedId = remove.dataset.delete;
+  const passkey = passkeys.find(p => p.id === selectedId);
+  $('delete-description').textContent = `“${passkey.name}” will be removed from this preview account. Removing an account entry doesn’t delete the saved passkey from your device or password manager.`;
+  $('last-key-note').hidden = passkeys.length !== 1;
+  $('delete-dialog').showModal();
+});
+$('confirm-delete').addEventListener('click', () => {
+  if (persist(passkeys.filter(p => p.id !== selectedId))) {
+    $('delete-dialog').close(); toast('Passkey removed.'); $('add-passkey').focus();
+  }
+});
+document.querySelectorAll('[data-close]').forEach(button => button.addEventListener('click', () => button.closest('dialog').close()));
+document.querySelectorAll('dialog').forEach(dialog => dialog.addEventListener('click', event => {
+  if (event.target === dialog) {
+    const bounds = dialog.getBoundingClientRect();
+    if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
+  }
+}));
+function selectTab(name, focus = false) {
+  document.querySelectorAll('[data-tab]').forEach(tab => {
+    const selected = tab.dataset.tab === name;
+    tab.classList.toggle('active', selected); tab.setAttribute('aria-selected', selected); tab.tabIndex = selected ? 0 : -1;
+    $(`${tab.dataset.tab}-panel`).hidden = !selected;
+    if (selected && focus) tab.focus();
+  });
+}
+const tabs = [...document.querySelectorAll('[data-tab]')];
+tabs.forEach((tab, index) => {
+  tab.addEventListener('click', () => selectTab(tab.dataset.tab));
+  tab.addEventListener('keydown', event => {
+    let next;
+    if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
+    if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
+    if (event.key === 'Home') next = 0;
+    if (event.key === 'End') next = tabs.length - 1;
+    if (next !== undefined) { event.preventDefault(); selectTab(tabs[next].dataset.tab, true); }
+  });
+});
+document.querySelectorAll('[data-return]').forEach(button => button.addEventListener('click', () => selectTab('passkeys', true)));
+$('security-nav').addEventListener('click', () => selectTab('passkeys', true));
+$('learn-passkeys').addEventListener('click', () => { $('passkey-explainer').open = true; $('passkey-explainer').scrollIntoView({behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block:'center'}); $('passkey-explainer').querySelector('summary').focus({preventScroll:true}); });
+const info = {
+  profile: ['Personal details', 'Jamie Davis', 'This is a preview account. Passkey changes are saved only in this browser; no real authentication credentials are modified.'],
+  menu: ['A cup for every kind of day', 'Maple Oat Latte — creamy oat milk and a little Vermont maple.', 'Dark Roast Espresso — bold, rich, and freshly pulled.', 'Cold Brew — slow-steeped for 18 hours.'],
+  story: ['Made for your everyday', 'Ethically sourced beans, locally roasted coffee, and a warm welcome. That’s The Daily Grind.'],
+  locations: ['Your neighborhood Daily Grind', 'Our café directory is coming soon. In the meantime, make yourself a cup and stay a while.'],
+  bag: ['Your bag is taking a coffee break', 'Your shopping bag is empty. Explore our menu to find your next favorite.'],
+  orders: ['Your orders', 'You haven’t placed an order in this preview account yet.'],
+  rewards: ['A little more rewarding', 'You have 0 Grind points in this preview. Your next coffee could be the start of something good.'],
+  payment: ['Payment methods', 'There are no payment methods saved to this preview account.'],
+  notifications: ['Notifications', 'You’re all caught up. There are no new notifications.'],
+  signout: ['You’re in a preview', 'There is no active account session to sign out of. Your preview passkeys will remain saved in this browser.'],
+  privacy: ['Your privacy', 'This preview saves sample passkey names and device details in your browser’s local storage. It does not collect biometric information, device PINs, or private keys. Fonts and the coffee photograph are loaded from Google Fonts and Unsplash.'],
+  terms: ['About this preview', 'This is an interactive account settings preview. Sample passkeys are for demonstration and cannot be used to sign in.'],
+  help: ['A little help with passkeys', 'Use the pencil to rename a passkey, or the trash icon to remove it. You’ll be asked to confirm before anything is removed.', 'For more information, open the questions at the bottom of your passkey settings.'],
+};
+document.querySelectorAll('[data-info]').forEach(element => element.addEventListener('click', event => {
+  event.preventDefault();
+  const [title, ...paragraphs] = info[element.dataset.info];
+  $('info-title').textContent = title;
+  $('info-content').replaceChildren(...paragraphs.map(text => { const p = document.createElement('p'); p.textContent = text; return p; }));
+  $('info-dialog').showModal();
+}));
+render();
