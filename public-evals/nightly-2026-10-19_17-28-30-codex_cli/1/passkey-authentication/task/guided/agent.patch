+  <script type="importmap">
+    { "imports": { "webauthn-polyfills": "https://esm.sh/webauthn-polyfills@0.1.7" } }
+  </script>
+  <script type="module">
+    const form = document.querySelector('#signin-form');
+    const button = document.querySelector('[data-testid="auth-button"]');
+    const status = document.querySelector('[data-testid="auth-status"]');
+    let activeRequest;
+    let explicitPending = false;
+    let authenticated = false;
+    let conditionalSupported = false;
+
+    const supported = window.isSecureContext &&
+      Boolean(window.PublicKeyCredential && navigator.credentials?.get);
+
+    const ready = supported ? (async () => {
+      // Load JSON API compatibility only on browsers that need it.
+      if (!PublicKeyCredential.parseRequestOptionsFromJSON ||
+          !PublicKeyCredential.prototype.toJSON ||
+          !PublicKeyCredential.getClientCapabilities) {
+        await import('webauthn-polyfills');
+      }
+      conditionalSupported = PublicKeyCredential.getClientCapabilities
+        ? (await PublicKeyCredential.getClientCapabilities()).conditionalGet === true
+        : Boolean(await PublicKeyCredential.isConditionalMediationAvailable?.());
+    })() : Promise.resolve();
+
+    async function authenticate(conditional) {
+      const controller = new AbortController();
+      activeRequest = controller;
+      try {
+        // The server must issue a fresh session-bound challenge with
+        // allowCredentials: [] and enforce user verification at verification.
+        const optionsResponse = await fetch('/api/login/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          signal: controller.signal,
+        });
+        if (!optionsResponse.ok) throw new Error('Unable to start passkey sign-in. Please try again.');
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await optionsResponse.json());
+        publicKey.userVerification = 'required';
+        if (controller.signal.aborted) return;
+
+        let credential;
+        try {
+          credential = await navigator.credentials.get({
+            publicKey,
+            signal: controller.signal,
+            ...(conditional ? { mediation: 'conditional' } : { mediation: 'required' }),
+          });
+        } catch (error) {
+          if (error.name === 'NotAllowedError') {
+            if (!conditional) status.textContent = 'Sign-in cancelled or timed out. Please try again.';
+            return;
+          }
+          throw error;
+        }
+        if (!credential || controller.signal.aborted) return;
+        button.disabled = true;
+        status.textContent = 'Verifying your passkey…';
+        const encoded = credential.toJSON();
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+          signal: controller.signal,
+        });
+        if (!response.ok) {
+          if (response.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+            // Credential synchronization is optional and must not hide a login error.
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: publicKey.rpId || location.hostname,
+                credentialId: encoded.id,
+              });
+            } catch { /* Unsupported provider or synchronization failure. */ }
+          }
+          throw new Error('Passkey verification failed. Please try again.');
+        }
+        authenticated = true;
+        status.textContent = 'Successfully signed in with your passkey.';
+      } catch (error) {
+        if (controller.signal.aborted || error.name === 'AbortError') return;
+        status.textContent = error instanceof TypeError
+          ? 'Unable to connect. Please try again.'
+          : 'Passkey sign-in failed. Please try again.';
+      } finally {
+        if (activeRequest === controller) {
+          activeRequest = undefined;
+          button.disabled = authenticated;
+        }
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!supported || explicitPending || authenticated || button.disabled) return;
+      explicitPending = true;
+      // Cancel even a pending options fetch before opening the explicit prompt.
+      activeRequest?.abort();
+      button.disabled = true;
+      status.textContent = 'Use your device to verify your passkey.';
+      try {
+        await ready;
+        await authenticate(false);
+      } catch {
+        status.textContent = 'Passkey sign-in could not be initialized. Please reload and try again.';
+      } finally {
+        explicitPending = false;
+        button.disabled = authenticated;
+        if (!authenticated && conditionalSupported) void authenticate(true);
+      }
+    });
+
+    if (!supported) {
+      button.disabled = true;
+      status.textContent = 'Passkeys require a supported browser and HTTPS (or localhost).';
+    } else {
+      ready.then(() => {
+        if (conditionalSupported && !explicitPending && !authenticated) void authenticate(true);
+      }).catch(() => {
+        status.textContent = 'Passkey autofill is unavailable. Try the sign-in button or reload.';
+      });
+    }
+  </script>
 </body>
 
