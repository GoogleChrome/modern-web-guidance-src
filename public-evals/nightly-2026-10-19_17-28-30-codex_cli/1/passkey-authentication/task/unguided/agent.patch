+  <script>
+    (() => {
+      const form = document.getElementById('sign-in-form');
+      const username = document.getElementById('username');
+      const button = form.querySelector('button');
+      const status = document.getElementById('auth-status');
+      let activeRequest;
+      let conditionalAvailable = false;
+      let signedIn = false;
+
+      function decode(value) {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, '=');
+        return Uint8Array.from(atob(padded), character => character.charCodeAt(0));
+      }
+
+      function encode(value) {
+        if (value == null) return null;
+        const bytes = new Uint8Array(value);
+        let binary = '';
+        for (const byte of bytes) binary += String.fromCharCode(byte);
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function serialize(credential) {
+        return {
+          id: credential.id,
+          rawId: encode(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment,
+          response: {
+            clientDataJSON: encode(credential.response.clientDataJSON),
+            authenticatorData: encode(credential.response.authenticatorData),
+            signature: encode(credential.response.signature),
+            userHandle: encode(credential.response.userHandle)
+          },
+          clientExtensionResults: credential.getClientExtensionResults()
+        };
+      }
+
+      async function authenticate(conditional) {
+        if (signedIn) return;
+        // Cancel autofill before opening an explicit authentication prompt.
+        if (activeRequest) activeRequest.abort();
+        const controller = new AbortController();
+        activeRequest = controller;
+        if (!conditional) {
+          button.disabled = true;
+          status.textContent = 'Waiting for your passkey…';
+        }
+
+        try {
+          // The server must issue a fresh, session-bound WebAuthn challenge.
+          const optionsResponse = await fetch('/api/login/options', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(conditional ? {} : { username: username.value.trim() }),
+            signal: controller.signal
+          });
+          if (!optionsResponse.ok) throw new Error('Could not start passkey sign-in. Please try again.');
+          const options = await optionsResponse.json();
+          const publicKey = { ...(options.publicKey || options) };
+          publicKey.challenge = decode(publicKey.challenge);
+          publicKey.allowCredentials = conditional ? [] : (publicKey.allowCredentials || []).map(
+            credential => ({ ...credential, id: decode(credential.id) })
+          );
+          publicKey.userVerification = 'required';
+          controller.signal.throwIfAborted();
+          const credential = await navigator.credentials.get({
+            publicKey,
+            mediation: conditional ? 'conditional' : 'required',
+            signal: controller.signal
+          });
+          controller.signal.throwIfAborted();
+          if (!credential) throw new Error('No passkey was selected. Please try again.');
+          button.disabled = true;
+          status.textContent = 'Verifying your passkey…';
+          const verification = await fetch('/api/login/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(serialize(credential)),
+            signal: controller.signal
+          });
+          if (!verification.ok) throw new Error('Passkey verification failed. Please try again.');
+          controller.signal.throwIfAborted();
+          signedIn = true;
+          status.textContent = 'Successfully signed in with your passkey.';
+        } catch (error) {
+          if (controller.signal.aborted) return;
+          status.textContent = error.name === 'NotAllowedError'
+            ? 'Sign-in was canceled or no passkey was available. Please try again.'
+            : error.name === 'SecurityError'
+              ? 'Passkey sign-in is unavailable for this site. Check that you are using HTTPS.'
+              : 'Unable to sign in with your passkey. Please try again.';
+        } finally {
+          if (activeRequest === controller) {
+            activeRequest = null;
+            button.disabled = signedIn;
+            if (!conditional && !signedIn && conditionalAvailable) void authenticate(true);
+          }
+        }
+      }
+
+      const supported = window.isSecureContext && window.PublicKeyCredential && navigator.credentials;
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        if (supported && !button.disabled) void authenticate(false);
+      });
+
+      if (!supported) {
+        button.disabled = true;
+        status.textContent = 'Passkeys require a supported browser and HTTPS (or localhost).';
+        return;
+      }
+
+      // Start a pending conditional request so focusing the username offers passkeys.
+      if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+        PublicKeyCredential.isConditionalMediationAvailable().then(available => {
+          conditionalAvailable = available;
+          if (available && !activeRequest && !signedIn) void authenticate(true);
+        }).catch(() => { /* Explicit passkey sign-in remains available. */ });
+      }
+      username.addEventListener('focus', () => {
+        if (conditionalAvailable && !activeRequest && !signedIn) void authenticate(true);
+      });
+    })();
+  </script>
 </body>
 
