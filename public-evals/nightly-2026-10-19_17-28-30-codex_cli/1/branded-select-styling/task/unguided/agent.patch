+  <script>
+    const roastSelector = document.querySelector('.roast-selector');
+    const roastTrigger = document.getElementById('roast-trigger');
+    const roastList = document.getElementById('roast-list');
+    const roastOptions = Array.from(roastList.querySelectorAll('[role="option"]'));
+    const roastValue = document.getElementById('roast-value');
+    const roastSelection = document.getElementById('roast-selection');
+
+    function closeRoasts(restoreFocus = false) {
+      roastList.hidden = true;
+      roastTrigger.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) roastTrigger.focus();
+    }
+
+    function openRoasts() {
+      roastList.hidden = false;
+      roastTrigger.setAttribute('aria-expanded', 'true');
+      roastOptions.find(option => option.getAttribute('aria-selected') === 'true').focus();
+    }
+
+    roastTrigger.addEventListener('click', () => {
+      if (roastList.hidden) openRoasts();
+      else closeRoasts();
+    });
+
+    roastTrigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openRoasts();
+      }
+    });
+
+    roastOptions.forEach(option => {
+      option.addEventListener('click', () => {
+        roastOptions.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+        roastValue.value = option.dataset.value;
+        roastSelection.textContent = option.textContent.trim();
+        closeRoasts(true);
+      });
+    });
+
+    roastList.addEventListener('keydown', event => {
+      const index = roastOptions.indexOf(document.activeElement);
+      let nextIndex;
+      if (event.key === 'ArrowDown') nextIndex = (index + 1) % roastOptions.length;
+      if (event.key === 'ArrowUp') nextIndex = (index - 1 + roastOptions.length) % roastOptions.length;
+      if (event.key === 'Home') nextIndex = 0;
+      if (event.key === 'End') nextIndex = roastOptions.length - 1;
+      if (nextIndex !== undefined) {
+        event.preventDefault();
+        roastOptions[nextIndex].focus();
+      } else if (event.key === 'Enter' || event.key === ' ') {
+        event.preventDefault();
+        roastOptions[index]?.click();
+      } else if (event.key === 'Escape') {
+        event.preventDefault();
+        closeRoasts(true);
+      } else if (event.key === 'Tab') {
+        closeRoasts(true);
+      }
+    });
+
+    document.addEventListener('click', event => {
+      if (!roastSelector.contains(event.target)) closeRoasts();
+    });
+
+    roastSelector.addEventListener('focusout', event => {
+      if (!roastSelector.contains(event.relatedTarget)) closeRoasts();
+    });
+  </script>
