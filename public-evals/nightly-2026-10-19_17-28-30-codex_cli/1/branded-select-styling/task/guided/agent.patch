+  <script>
+    // Keep the full brand palette where customizable native selects are unavailable.
+    if (!CSS.supports('appearance', 'base-select')) {
+      const select = document.querySelector('#coffee-roast');
+      const container = select.parentElement;
+      const trigger = document.createElement('button');
+      const list = document.createElement('ul');
+      const options = Array.from(select.options);
+      let activeIndex = select.selectedIndex;
+
+      trigger.type = 'button';
+      trigger.id = 'roast-trigger';
+      trigger.className = 'roast-trigger';
+      trigger.setAttribute('role', 'combobox');
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-controls', 'roast-options');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-trigger');
+      trigger.textContent = options[select.selectedIndex].text;
+      list.id = 'roast-options';
+      list.className = 'roast-options';
+      list.setAttribute('role', 'listbox');
+      list.setAttribute('aria-labelledby', 'roast-label');
+      list.hidden = true;
+
+      function highlight(index) {
+        activeIndex = index;
+        Array.from(list.children).forEach((item, i) => {
+          item.toggleAttribute('data-active', i === index);
+        });
+        trigger.setAttribute('aria-activedescendant', `roast-option-${index}`);
+      }
+
+      function close() {
+        list.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        trigger.removeAttribute('aria-activedescendant');
+      }
+
+      function open() {
+        list.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        highlight(select.selectedIndex);
+      }
+
+      function choose(index) {
+        select.selectedIndex = index;
+        trigger.textContent = options[index].text;
+        Array.from(list.children).forEach((item, i) => {
+          item.setAttribute('aria-selected', String(i === index));
+        });
+        select.dispatchEvent(new Event('change', { bubbles: true }));
+        close();
+      }
+
+      options.forEach((option, index) => {
+        const item = document.createElement('li');
+        item.id = `roast-option-${index}`;
+        item.setAttribute('role', 'option');
+        item.setAttribute('aria-selected', String(option.selected));
+        item.textContent = option.text;
+        item.addEventListener('pointerdown', event => event.preventDefault());
+        item.addEventListener('click', () => choose(index));
+        list.append(item);
+      });
+
+      trigger.addEventListener('click', () => list.hidden ? open() : close());
+      trigger.addEventListener('keydown', event => {
+        const keys = ['ArrowDown', 'ArrowUp', 'Home', 'End', 'Enter', ' ', 'Escape'];
+        if (event.key === 'Tab') {
+          close();
+          return;
+        }
+        const match = options.findIndex(option => option.text.toLowerCase().startsWith(event.key.toLowerCase()));
+        if (!keys.includes(event.key) && match < 0) return;
+        event.preventDefault();
+        if (event.key === 'Escape') return close();
+        if (event.key === 'Enter' || event.key === ' ') {
+          return list.hidden ? open() : choose(activeIndex);
+        }
+        const wasClosed = list.hidden;
+        if (wasClosed) open();
+        if (match >= 0) highlight(match);
+        else if (event.key === 'Home') highlight(0);
+        else if (event.key === 'End') highlight(options.length - 1);
+        else if (!wasClosed) {
+          highlight((activeIndex + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length);
+        }
+      });
+      trigger.addEventListener('blur', close);
+      document.addEventListener('pointerdown', event => {
+        if (!container.contains(event.target)) close();
+      });
+
+      select.hidden = true;
+      container.querySelector('label').htmlFor = trigger.id;
+      container.append(trigger, list);
+    }
+  </script>
