@@ -0,0 +1,29 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {establishSecret, encryptMessage, decryptMessage} from './crypto.js';
+for (const algorithm of ['hybrid', 'pq', 'classical']) {
+  test(`${algorithm}: establish and round-trip authenticated Unicode data`, async () => {
+    const session = await establishSecret(algorithm);
+    const message = 'Private by design. 🔐\nこんにちは';
+    const payload = await encryptMessage(message, session);
+    assert.equal(await decryptMessage(payload, session), message);
+    assert.equal(session.key.extractable, false);
+    const next = JSON.parse(await encryptMessage(message, session));
+    assert.notEqual(JSON.parse(payload).iv, next.iv);
+    const altered = JSON.parse(payload);
+    const raw = Uint8Array.from(atob(altered.ciphertext), c => c.charCodeAt(0)); raw[0] ^= 1;
+    altered.ciphertext = btoa(String.fromCharCode(...raw));
+    await assert.rejects(decryptMessage(JSON.stringify(altered), session), /authenticate/);
+    const otherSession = await establishSecret(algorithm);
+    await assert.rejects(decryptMessage(payload, otherSession), /authenticate/);
+    const changedHeader = JSON.parse(payload); changedHeader.algorithm = 'unsupported';
+    await assert.rejects(decryptMessage(JSON.stringify(changedHeader), session), /authenticate/);
+  });
+}
+test('invalid inputs give actionable failures', async () => {
+  await assert.rejects(establishSecret('invalid'), /supported/);
+  await assert.rejects(encryptMessage(''), /Enter a message/);
+  await assert.rejects(encryptMessage('secret'), /Generate a shared secret/);
+  const session = await establishSecret();
+  await assert.rejects(decryptMessage('not json', session), /authenticate/);
+});
