+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+import { ml_kem768_x25519 } from '@noble/post-quantum/hybrid.js';
+import { x25519 } from '@noble/curves/ed25519.js';
+
+export const algorithms = {
+  hybrid: { name: 'X25519 + ML-KEM-768', type: 'Hybrid', note: 'The best of both worlds. Secure today, ready for tomorrow.' },
+  pq: { name: 'ML-KEM-768', type: 'Post-quantum', note: 'Lattice-based key encapsulation with ML-KEM-768.' },
+  classical: { name: 'X25519', type: 'Classical', note: 'Fast elliptic-curve key agreement for classical protection.' }
+};
+export const toBase64 = bytes => btoa(Array.from(bytes, b => String.fromCharCode(b)).join(''));
+const fromBase64 = text => Uint8Array.from(atob(text), c => c.charCodeAt(0));
+const utf8 = new TextEncoder();
+
+export async function establishSecret(algorithm = 'hybrid') {
+  if (!algorithms[algorithm]) throw new Error('Choose a supported algorithm.');
+  if (!globalThis.crypto?.subtle) throw new Error('Web Crypto requires HTTPS or localhost.');
+  let aliceSecret, bobSecret, publicKey, response, privateKeys = [];
+  try {
+    if (algorithm === 'classical') {
+      const alice = x25519.keygen();
+      const bob = x25519.keygen();
+      privateKeys = [alice.secretKey, bob.secretKey];
+      aliceSecret = x25519.getSharedSecret(alice.secretKey, bob.publicKey);
+      bobSecret = x25519.getSharedSecret(bob.secretKey, alice.publicKey);
+      publicKey = alice.publicKey;
+      response = bob.publicKey;
+    } else {
+      const kem = algorithm === 'hybrid' ? ml_kem768_x25519 : ml_kem768;
+      const keys = kem.keygen();
+      privateKeys = [keys.secretKey];
+      publicKey = keys.publicKey;
+      const result = kem.encapsulate(publicKey);
+      response = result.cipherText;
+      bobSecret = result.sharedSecret;
+      aliceSecret = kem.decapsulate(response, keys.secretKey);
+    }
+    if (aliceSecret.length !== bobSecret.length || aliceSecret.some((byte, i) => byte !== bobSecret[i])) throw new Error('Shared secret verification failed.');
+    const salt = crypto.getRandomValues(new Uint8Array(32));
+    const material = await crypto.subtle.importKey('raw', aliceSecret, 'HKDF', false, ['deriveKey']);
+    const key = await crypto.subtle.deriveKey({name: 'HKDF', hash: 'SHA-256', salt, info: utf8.encode(`enclave/v1/${algorithm}/AES-256-GCM`)}, material, {name: 'AES-GCM', length: 256}, false, ['encrypt', 'decrypt']);
+    const fingerprint = Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', publicKey)).slice(0, 12), byte => byte.toString(16).padStart(2, '0')).join(':');
+    return { id: crypto.randomUUID(), algorithm, key, publicKey: toBase64(publicKey), response: toBase64(response), fingerprint, createdAt: new Date() };
+  } finally {
+    privateKeys.forEach(key => key.fill(0));
+    aliceSecret?.fill(0);
+    bobSecret?.fill(0);
+  }
+}
+
+export async function encryptMessage(message, session) {
+  if (!message) throw new Error('Enter a message to encrypt.');
+  if (!session?.key) throw new Error('Generate a shared secret first, then select it here.');
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const header = { version: 1, session: session.id, algorithm: session.algorithm, cipher: 'AES-256-GCM' };
+  const ciphertext = await crypto.subtle.encrypt({name: 'AES-GCM', iv, additionalData: utf8.encode(JSON.stringify(header)), tagLength: 128}, session.key, utf8.encode(message));
+  return JSON.stringify({...header, iv: toBase64(iv), ciphertext: toBase64(new Uint8Array(ciphertext))}, null, 2);
+}
+
+export async function decryptMessage(payload, session) {
+  if (!session?.key) throw new Error('Select the shared secret used to encrypt this message.');
+  try {
+    const envelope = JSON.parse(payload);
+    const {version, session: id, algorithm, cipher, iv, ciphertext} = envelope;
+    if (version !== 1 || id !== session.id || algorithm !== session.algorithm || cipher !== 'AES-256-GCM') throw new Error();
+    const header = {version, session: id, algorithm, cipher};
+    const plain = await crypto.subtle.decrypt({name: 'AES-GCM', iv: fromBase64(iv), additionalData: utf8.encode(JSON.stringify(header)), tagLength: 128}, session.key, fromBase64(ciphertext));
+    return new TextDecoder('utf-8', {fatal: true}).decode(plain);
+  } catch {
+    throw new Error('Unable to authenticate this message. Check the payload and selected key.');
+  }
+}
