@@ -0,0 +1,23 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {establish, encrypt, decrypt} from './crypto.js';
+for(const mode of ['hybrid','pq','classical']){
+  test(`${mode}: key establishment and authenticated encryption`,async()=>{
+    const session=await establish(mode);
+    const message='A private message 🔐';
+    const payload=await encrypt(session,message);
+    assert.equal(await decrypt(session,payload),message);
+    const other=await encrypt(session,message);
+    assert.notEqual(payload.iv,other.iv);
+    assert.notEqual(payload.ciphertext,other.ciphertext);
+    const bytes=Uint8Array.from(atob(payload.ciphertext),c=>c.charCodeAt(0));bytes[0]^=1;
+    await assert.rejects(decrypt(session,{...payload,ciphertext:btoa(String.fromCharCode(...bytes))}));
+    await assert.rejects(decrypt(session,{...payload,session:'different-session'}));
+    assert.equal(session.key.extractable,false);
+  });
+}
+test('a fresh session cannot decrypt a prior session',async()=>{
+ const a=await establish('hybrid'), b=await establish('hybrid');
+ const payload=await encrypt(a,'secret');
+ await assert.rejects(decrypt(b,payload));
+});
