+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+import { x25519 } from '@noble/curves/ed25519.js';
+const encoder = new TextEncoder();
+const concat = (...arrays) => { const out = new Uint8Array(arrays.reduce((n,a)=>n+a.length,0)); let offset=0; for(const a of arrays){out.set(a,offset);offset+=a.length;} return out; };
+export const base64 = bytes => btoa(String.fromCharCode(...bytes));
+const unbase64 = value => Uint8Array.from(atob(value), c=>c.charCodeAt(0));
+export async function establish(mode) {
+  if(!['hybrid','pq','classical'].includes(mode)) throw Error('Unknown protection mode');
+  const sender=[], recipient=[], senderSecrets=[], recipientSecrets=[], transcript=[];
+  if(mode!=='pq') {
+    const a=x25519.keygen(), b=x25519.keygen();
+    sender.push(a.publicKey);recipient.push(b.publicKey);
+    senderSecrets.push(x25519.getSharedSecret(a.secretKey,b.publicKey));
+    recipientSecrets.push(x25519.getSharedSecret(b.secretKey,a.publicKey));
+    transcript.push(a.publicKey,b.publicKey);
+    a.secretKey.fill(0);b.secretKey.fill(0);
+  }
+  if(mode!=='classical') {
+    const keys=ml_kem768.keygen();
+    const encapsulated=ml_kem768.encapsulate(keys.publicKey);
+    sender.push(encapsulated.cipherText);recipient.push(keys.publicKey);
+    senderSecrets.push(encapsulated.sharedSecret);
+    recipientSecrets.push(ml_kem768.decapsulate(encapsulated.cipherText,keys.secretKey));
+    transcript.push(keys.publicKey,encapsulated.cipherText);
+    keys.secretKey.fill(0);
+  }
+  const salt=await crypto.subtle.digest('SHA-256',concat(...transcript));
+  const derive=async secrets=>{
+    const raw=concat(...secrets);
+    const material=await crypto.subtle.importKey('raw',raw,'HKDF',false,['deriveBits']);
+    raw.fill(0); secrets.forEach(s=>s.fill(0));
+    return new Uint8Array(await crypto.subtle.deriveBits({name:'HKDF',hash:'SHA-256',salt,info:encoder.encode('cipher-local-workspace:v1:'+mode)},material,256));
+  };
+  const a=await derive(senderSecrets), b=await derive(recipientSecrets);
+  if(!a.every((v,i)=>v===b[i])) throw Error('Shared secret verification failed');
+  const key=await crypto.subtle.importKey('raw',a,{name:'AES-GCM'},false,['encrypt','decrypt']);
+  const fingerprint=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',a)).slice(0,16),v=>v.toString(16).padStart(2,'0')).join('');
+  a.fill(0);b.fill(0);
+  return {mode,key,fingerprint,sender:base64(concat(...sender)),recipient:base64(concat(...recipient)),id:crypto.randomUUID()};
+}
+export async function encrypt(session,plaintext) {
+  const iv=crypto.getRandomValues(new Uint8Array(12));
+  const metadata={version:1,session:session.id,algorithm:'AES-256-GCM'};
+  const aad=encoder.encode(JSON.stringify(metadata));
+  const ciphertext=await crypto.subtle.encrypt({name:'AES-GCM',iv,additionalData:aad,tagLength:128},session.key,encoder.encode(plaintext));
+  return {...metadata,iv:base64(iv),ciphertext:base64(new Uint8Array(ciphertext))};
+}
+export async function decrypt(session,payload) {
+  if(payload.version!==1||payload.session!==session.id||payload.algorithm!=='AES-256-GCM') throw Error('This payload does not belong to the active session.');
+  const iv=unbase64(payload.iv);if(iv.length!==12)throw Error('Invalid nonce');
+  const metadata={version:payload.version,session:payload.session,algorithm:payload.algorithm};
+  const plaintext=await crypto.subtle.decrypt({name:'AES-GCM',iv,additionalData:encoder.encode(JSON.stringify(metadata)),tagLength:128},session.key,unbase64(payload.ciphertext));
+  return new TextDecoder().decode(plaintext);
+}
