+  <script type="module">
+    const extendButton = document.getElementById('extend-temporal-btn');
+
+    try {
+      const Temporal = globalThis.Temporal ??
+        (await import('https://esm.sh/@js-temporal/polyfill@0.5.1')).Temporal;
+      const dateValue = document.getElementById('temporal-value');
+      const referenceChanged = document.getElementById('temporal-ref-changed');
+      const renderCount = document.getElementById('temporal-render-count');
+      let state = { deadline: Temporal.Now.plainDateISO().add({ days: 7 }) };
+      let renders = 0;
+
+      function render(changed) {
+        const date = state.deadline.toString();
+        dateValue.textContent = date;
+        dateValue.dateTime = date;
+        referenceChanged.textContent = changed ? 'Yes' : 'No';
+        renderCount.textContent = String(++renders);
+      }
+
+      function setState(nextState) {
+        if (Object.is(state, nextState)) return;
+        const changed = !Object.is(state.deadline, nextState.deadline);
+        state = nextState;
+        render(changed);
+      }
+
+      extendButton.addEventListener('click', () => {
+        setState({ deadline: state.deadline.add({ days: 1 }) });
+      });
+
+      render(false);
+      extendButton.disabled = false;
+    } catch (error) {
+      document.getElementById('temporal-value').textContent = 'Unavailable';
+      const errorMessage = document.getElementById('temporal-error');
+      errorMessage.textContent = 'The deadline tracker could not load. Please reload the page to try again.';
+      errorMessage.hidden = false;
+      console.error('Failed to initialize the deadline tracker:', error);
+    }
+  </script>
+
 </body>
 
