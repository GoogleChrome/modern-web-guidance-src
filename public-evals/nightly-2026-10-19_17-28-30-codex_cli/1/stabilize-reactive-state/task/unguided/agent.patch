+  <script type="module">
+    const dateValue = document.getElementById('temporal-value');
+    const referenceChanged = document.getElementById('temporal-ref-changed');
+    const renderCountValue = document.getElementById('temporal-render-count');
+    const extendButton = document.getElementById('extend-temporal-btn');
+
+    try {
+      const Temporal = globalThis.Temporal ??
+        (await import('https://esm.sh/@js-temporal/polyfill@0.5.1?bundle')).Temporal;
+
+      let deadline = Temporal.Now.plainDateISO().add({ days: 7 });
+      let renderCount = 0;
+
+      function render(changed) {
+        renderCount += 1;
+        dateValue.textContent = deadline.toString();
+        dateValue.dateTime = deadline.toString();
+        referenceChanged.textContent = changed ? 'Yes' : 'No';
+        renderCountValue.textContent = String(renderCount);
+      }
+
+      function setDeadline(nextDeadline) {
+        if (Object.is(deadline, nextDeadline)) return;
+        const previousDeadline = deadline;
+        deadline = nextDeadline;
+        render(!Object.is(previousDeadline, deadline));
+      }
+
+      extendButton.addEventListener('click', () => {
+        // Temporal.add returns a new date, allowing the state update to trigger a render.
+        setDeadline(deadline.add({ days: 1 }));
+      });
+
+      render(false);
+      extendButton.disabled = false;
+    } catch (error) {
+      dateValue.textContent = 'Unavailable';
+      document.getElementById('temporal-status').textContent =
+        'The deadline tracker could not load. Please reload the page to try again.';
+      console.error('Unable to initialize the deadline tracker:', error);
+    }
+  </script>
+
 </body>
 
