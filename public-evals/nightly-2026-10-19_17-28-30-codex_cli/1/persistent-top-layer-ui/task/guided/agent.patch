+  <button type="button" id="feedback-open" class="feedback-launcher" aria-haspopup="dialog" aria-controls="feedback-dialog">Share your thoughts <span aria-hidden="true">↗</span></button>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackOpener = document.getElementById('feedback-open');
+    const feedbackMove = document.getElementById('feedback-move');
+    const feedbackMessage = document.getElementById('feedback-message');
+    const feedbackStatus = document.getElementById('feedback-status');
+    const feedbackStorageKey = 'daily-grind-feedback';
+
+    try {
+      feedbackMessage.value = localStorage.getItem(feedbackStorageKey) || '';
+    } catch {
+      // The in-memory draft still works when browser storage is unavailable.
+    }
+
+    feedbackOpener.addEventListener('click', () => {
+      if (!feedbackDialog.open) feedbackDialog.showModal();
+    });
+    feedbackDialog.querySelector('.feedback-close').addEventListener('click', () => feedbackDialog.close());
+    feedbackDialog.addEventListener('close', () => {
+      // Fallback reparenting can queue a close event before reopening.
+      if (!feedbackDialog.open) feedbackOpener.focus({ preventScroll: true });
+    });
+
+    feedbackMove.addEventListener('click', () => {
+      const moveLeft = feedbackDialog.dataset.side === 'right';
+      const target = document.getElementById(moveLeft ? 'feedback-alternate' : 'feedback-home');
+
+      if (typeof target.moveBefore === 'function') {
+        // Both parents are connected in the same document. This atomic move
+        // preserves top-layer membership, modality, and focus without closing.
+        target.moveBefore(feedbackDialog, null);
+      } else {
+        const wasOpen = feedbackDialog.open;
+        const focused = feedbackDialog.contains(document.activeElement) ? document.activeElement : null;
+        const selection = focused === feedbackMessage
+          ? [feedbackMessage.selectionStart, feedbackMessage.selectionEnd, feedbackMessage.selectionDirection]
+          : null;
+        const scrollTop = feedbackDialog.scrollTop;
+        const messageScrollTop = feedbackMessage.scrollTop;
+        const returnValue = feedbackDialog.returnValue;
+
+        // Explicitly close first: some browsers retain the open attribute on
+        // removal even though the dialog has lost its modal top-layer state.
+        if (wasOpen) feedbackDialog.close();
+        target.insertBefore(feedbackDialog, null);
+        if (wasOpen) feedbackDialog.showModal();
+        feedbackDialog.returnValue = returnValue;
+        focused?.focus({ preventScroll: true });
+        if (selection) feedbackMessage.setSelectionRange(...selection);
+        feedbackDialog.scrollTop = scrollTop;
+        feedbackMessage.scrollTop = messageScrollTop;
+      }
+
+      feedbackDialog.dataset.side = moveLeft ? 'left' : 'right';
+      feedbackMove.textContent = moveLeft ? 'Move to right →' : 'Move to left ←';
+      feedbackStatus.textContent = `Moved to the ${moveLeft ? 'left' : 'right'}. Your feedback stays with you.`;
+    });
+
+    document.getElementById('feedback-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      try {
+        localStorage.setItem(feedbackStorageKey, feedbackMessage.value);
+        feedbackStatus.textContent = 'Feedback saved on this device. You can come back and edit it anytime.';
+      } catch {
+        feedbackStatus.textContent = 'Device storage is unavailable. Your draft stays here while this page is open.';
+      }
+    });
+  </script>
+
