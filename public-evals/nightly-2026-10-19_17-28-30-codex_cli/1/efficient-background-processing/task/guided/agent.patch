+  <script>
+    (() => {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const temperature = document.getElementById('roast-temp-value');
+      const context = canvas.getContext('2d');
+      const beans = Array.from({ length: 36 }, () => ({
+        orbit: Math.random() * Math.PI * 2,
+        radius: 0.25 + Math.random() * 0.65,
+        spin: Math.random() * Math.PI,
+        speed: 0.6 + Math.random() * 0.5
+      }));
+      let frameId = null;
+      let intervalId = null;
+      let running = false;
+      let inView = false;
+      let renderingSkipped = false;
+      let pageActive = true;
+      let lastTime = null;
+      let roastTime = 0;
+
+      function drawBeans() {
+        if (!context) return;
+        const { width, height } = canvas;
+        context.clearRect(0, 0, width, height);
+        context.strokeStyle = '#5b4034';
+        context.lineWidth = 3;
+        context.beginPath();
+        context.ellipse(width / 2, height / 2, width * 0.45, height * 0.43, 0, 0, Math.PI * 2);
+        context.stroke();
+
+        beans.forEach(bean => {
+          const angle = bean.orbit + roastTime * bean.speed;
+          const x = width / 2 + Math.cos(angle) * width * 0.4 * bean.radius;
+          const y = height / 2 + Math.sin(angle) * height * 0.35 * bean.radius;
+          context.save();
+          context.translate(x, y);
+          context.rotate(bean.spin + angle * 1.5);
+          context.fillStyle = '#a86b3f';
+          context.beginPath();
+          context.ellipse(0, 0, 18, 11, 0, 0, Math.PI * 2);
+          context.fill();
+          context.strokeStyle = '#4a291b';
+          context.lineWidth = 2;
+          context.beginPath();
+          context.moveTo(-12, 0);
+          context.bezierCurveTo(-4, -6, 4, 6, 12, 0);
+          context.stroke();
+          context.restore();
+        });
+      }
+
+      function animate(timestamp) {
+        if (!running) return;
+        if (lastTime !== null) roastTime += Math.min((timestamp - lastTime) / 1000, 0.05);
+        lastTime = timestamp;
+        drawBeans();
+        frameId = requestAnimationFrame(animate);
+      }
+
+      function stop() {
+        running = false;
+        if (frameId !== null) cancelAnimationFrame(frameId);
+        if (intervalId !== null) clearInterval(intervalId);
+        frameId = null;
+        intervalId = null;
+        lastTime = null;
+      }
+
+      function syncActivity() {
+        const shouldRun = inView && !renderingSkipped && !document.hidden && pageActive;
+        if (!shouldRun) {
+          stop();
+        } else if (!running) {
+          running = true;
+          if (context) frameId = requestAnimationFrame(animate);
+          intervalId = setInterval(() => {
+            temperature.textContent = (195 + Math.sin(roastTime / 8) * 8 + Math.random() * 2).toFixed(1);
+          }, 1000);
+        }
+      }
+
+      // Listen directly: rendering state events do not reliably bubble.
+      widget.addEventListener('contentvisibilityautostatechange', event => {
+        renderingSkipped = event.skipped;
+        syncActivity();
+      });
+
+      // Rendering may start before the widget enters the viewport. Also observe
+      // intersection so work stops whenever it actually scrolls out of view.
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(entries => {
+          inView = entries[entries.length - 1].isIntersecting;
+          syncActivity();
+        }, { threshold: 0 });
+        observer.observe(widget);
+      } else {
+        // Legacy fallback: coalesce geometry checks without a polling timer.
+        let checkId = null;
+        function checkVisibility() {
+          checkId = null;
+          const rect = widget.getBoundingClientRect();
+          inView = rect.bottom > 0 && rect.top < window.innerHeight &&
+            rect.right > 0 && rect.left < window.innerWidth;
+          syncActivity();
+        }
+        function scheduleCheck() {
+          if (checkId === null) checkId = requestAnimationFrame(checkVisibility);
+        }
+        window.addEventListener('scroll', scheduleCheck, { passive: true, capture: true });
+        window.addEventListener('resize', scheduleCheck, { passive: true });
+        window.addEventListener('pageshow', scheduleCheck);
+        checkVisibility();
+      }
+
+      document.addEventListener('visibilitychange', syncActivity);
+      window.addEventListener('pagehide', () => {
+        pageActive = false;
+        stop();
+      });
+      window.addEventListener('pageshow', () => {
+        pageActive = true;
+        syncActivity();
+      });
+    })();
+  </script>
+
 </body>
 
