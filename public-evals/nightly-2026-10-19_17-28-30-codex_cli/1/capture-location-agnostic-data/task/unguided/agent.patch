+  <script>
+    (() => {
+      const storageKey = 'daily-grind-coffee-preferences';
+      const form = document.getElementById('coffee-preferences');
+      const pickupTime = document.getElementById('pickup-time');
+      const anniversary = document.getElementById('coffee-anniversary');
+      const status = document.getElementById('preferences-status');
+
+      // These are a wall-clock time and a calendar date, never instants in time.
+      // Preserve native input strings end to end; do not use Date, UTC conversion,
+      // valueAsDate, or valueAsNumber, which could shift values across time zones.
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey));
+        if (saved && typeof saved === 'object') {
+          if (typeof saved.pickupTime === 'string' && /^([01]\d|2[0-3]):[0-5]\d$/.test(saved.pickupTime)) {
+            pickupTime.value = saved.pickupTime;
+          }
+          if (typeof saved.coffeeAnniversary === 'string' && /^\d{4,}-\d{2}-\d{2}$/.test(saved.coffeeAnniversary)) {
+            // The native date input also rejects invalid calendar dates.
+            anniversary.value = saved.coffeeAnniversary;
+          }
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can choose them again below.';
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!form.reportValidity()) return;
+
+        try {
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupTime: pickupTime.value,
+            coffeeAnniversary: anniversary.value
+          }));
+          status.textContent = 'Preferences saved. Your selected time and date stay the same wherever you travel.';
+        } catch {
+          status.textContent = 'Preferences could not be saved. Allow storage for this site and try again.';
+        }
+      });
+
+      form.addEventListener('input', () => {
+        status.textContent = 'Unsaved changes. Select Save preferences to keep them.';
+      });
+    })();
+  </script>
+
 </body>
 
