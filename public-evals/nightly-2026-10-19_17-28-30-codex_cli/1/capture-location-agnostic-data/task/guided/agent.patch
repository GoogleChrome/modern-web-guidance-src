+  <script>
+    const preferencesForm = document.getElementById('coffee-preferences-form');
+    const pickupTimeInput = document.getElementById('pickup-reminder-time');
+    const anniversaryInput = document.getElementById('coffee-anniversary-date');
+    const preferencesStatus = document.getElementById('preferences-status');
+    const preferencesKey = 'daily-grind-coffee-preferences';
+    let temporalPromise;
+
+    function getTemporal() {
+      if (globalThis.Temporal?.PlainTime && globalThis.Temporal?.PlainDate) {
+        return Promise.resolve(globalThis.Temporal);
+      }
+      // Load only where native Temporal is unavailable; never fall back to Date.
+      if (!temporalPromise) {
+        temporalPromise = import('https://esm.sh/@js-temporal/polyfill@0.5.1')
+          .then(module => module.Temporal)
+          .catch(error => {
+            temporalPromise = undefined;
+            throw error;
+          });
+      }
+      return temporalPromise;
+    }
+
+    function showSavedPreferences(preferences) {
+      preferencesStatus.textContent = `Saved in this browser. Daily pickup reminder: ${preferences.pickupReminderTime || 'Not set'}. Coffee anniversary: ${preferences.coffeeAnniversaryDate || 'Not set'}.`;
+    }
+
+    try {
+      const saved = localStorage.getItem(preferencesKey);
+      if (saved) {
+        const preferences = JSON.parse(saved);
+        if (typeof preferences?.pickupReminderTime !== 'string' ||
+            typeof preferences?.coffeeAnniversaryDate !== 'string') {
+          throw new Error('Invalid saved preferences');
+        }
+        // Native input values are plain strings: HH:mm and YYYY-MM-DD.
+        pickupTimeInput.value = preferences.pickupReminderTime;
+        anniversaryInput.value = preferences.coffeeAnniversaryDate;
+        if (pickupTimeInput.value !== preferences.pickupReminderTime ||
+            anniversaryInput.value !== preferences.coffeeAnniversaryDate ||
+            !preferencesForm.checkValidity()) {
+          throw new Error('Invalid saved preferences');
+        }
+        showSavedPreferences(preferences);
+      }
+    } catch {
+      preferencesStatus.textContent = 'Saved preferences could not be loaded. Choose your preferences and try saving again.';
+    }
+
+    preferencesForm.addEventListener('submit', async event => {
+      event.preventDefault();
+      if (!preferencesForm.reportValidity()) return;
+
+      // Capture the selections before waiting for a possible polyfill download.
+      const pickupReminderTime = pickupTimeInput.value;
+      const coffeeAnniversaryDate = anniversaryInput.value;
+      const saveButton = preferencesForm.querySelector('button');
+      saveButton.disabled = true;
+      preferencesStatus.textContent = 'Saving preferences…';
+
+      try {
+        const temporal = await getTemporal();
+        // Plain types have no offset or time zone. Persist only their plain values,
+        // never timestamps, UTC strings, or valueAsDate/valueAsNumber conversions.
+        const preferences = {
+          pickupReminderTime: pickupReminderTime
+            ? temporal.PlainTime.from(pickupReminderTime).toString({ smallestUnit: 'minute' })
+            : '',
+          coffeeAnniversaryDate: coffeeAnniversaryDate
+            ? temporal.PlainDate.from(coffeeAnniversaryDate).toString()
+            : ''
+        };
+        localStorage.setItem(preferencesKey, JSON.stringify(preferences));
+        showSavedPreferences(preferences);
+      } catch {
+        preferencesStatus.textContent = 'Preferences could not be saved. Check your connection and browser storage settings, then try again.';
+      } finally {
+        saveButton.disabled = false;
+      }
+    });
+  </script>
+
