+      padding: 40px 20px 100px;
       margin-top: 40px;
     }
 
     .footer-links {
@@ -155,8 +225,10 @@
   </style>
 </head>
 
 <body>
+  <div class="scroller" tabindex="-1" role="region" aria-label="Coffee shop page">
+  <div class="scroll-sentinel" aria-hidden="true"></div>
 
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
@@ -206,7 +278,37 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button class="back-to-top" type="button">
+    <span aria-hidden="true">↑</span> Back to top
+  </button>
+  </div>
+
+  <script>
+    const scroller = document.querySelector('.scroller');
+    const backToTop = scroller.querySelector('.back-to-top');
+
+    // Older browsers observe only the top marker, with no scroll listener.
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const observer = new IntersectionObserver(([entry]) => {
+        scroller.classList.toggle('scrolled', !entry.isIntersecting);
+      }, { root: scroller, threshold: 1 });
+
+      observer.observe(scroller.querySelector('.scroll-sentinel'));
+    }
+
+    backToTop.addEventListener('click', () => {
+      // Move focus before the button disappears so Tab resumes at the top.
+      scroller.focus({ preventScroll: true });
+      scroller.scrollTo({
+        top: 0,
+        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches
+          ? 'instant'
+          : 'smooth',
+      });
+    });
+  </script>
+
 </body>
 
 </html>
