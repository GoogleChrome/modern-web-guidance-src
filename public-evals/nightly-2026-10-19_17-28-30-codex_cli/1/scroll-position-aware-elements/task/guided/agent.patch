diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -26,8 +26,77 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    .scroller {
+      position: relative;
+      height: 100vh;
+      height: 100dvh;
+      overflow-y: auto;
+      container-type: scroll-state;
+      container-name: page-scroll;
+    }
+
+    .scroll-sentinel {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 1px;
+      height: 1px;
+      pointer-events: none;
+    }
+
+    .back-to-top {
+      position: sticky;
+      bottom: 20px;
+      z-index: 1001;
+      display: block;
+      margin: 20px 20px 20px auto;
+      padding: 12px 18px;
+      border: 0;
+      border-radius: 999px;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      cursor: pointer;
+      box-shadow: 0 3px 12px rgb(0 0 0 / 20%);
+      visibility: hidden;
+      opacity: 0;
+      translate: 0 20px;
+      pointer-events: none;
+      transition: visibility 0.3s, opacity 0.3s ease, translate 0.3s ease;
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    @container page-scroll scroll-state(scrollable: top) {
+      .back-to-top {
+        visibility: visible;
+        opacity: 1;
+        translate: 0 0;
+        pointer-events: auto;
+      }
+    }
+
+    @supports not (container-type: scroll-state) {
+      .scroller.scrolled .back-to-top {
+        visibility: visible;
+        opacity: 1;
+        translate: 0 0;
+        pointer-events: auto;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .back-to-top {
+        transition: none;
+        translate: none;
+      }
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
@@ -137,9 +206,10 @@
 
