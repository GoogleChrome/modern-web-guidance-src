+  <script>
+    const beanForm = document.getElementById('bean-form');
+    const beanInput = document.getElementById('bean-name');
+    const beanList = document.getElementById('bean-list');
+    const beanStatus = document.getElementById('bean-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let nextBeanId = 4;
+    let customBeanCount = 0;
+    let activeTransition;
+    let pendingUpdate = Promise.resolve();
+
+    function updateBeans(update) {
+      // Wait only for DOM updates, never for animations, so rapid clicks work.
+      pendingUpdate = pendingUpdate.then(() => {
+        activeTransition?.skipTransition();
+        if (reducedMotion.matches || !document.startViewTransition) {
+          update();
+          return;
+        }
+
+        // Prefer a list-scoped transition; root capture is disabled for the fallback.
+        const scope = typeof beanList.startViewTransition === 'function' ? beanList : document;
+        activeTransition = scope.startViewTransition(update);
+        activeTransition.ready.catch(() => {});
+        return activeTransition.updateCallbackDone;
+      }).catch(console.error);
+    }
+
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) activeTransition?.skipTransition();
+    });
+
+    beanForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const name = beanInput.value.trim() || `Custom Bean ${++customBeanCount}`;
+      beanInput.value = '';
+      const item = document.createElement('li');
+      item.className = 'item';
+      item.style.viewTransitionName = `bean-${nextBeanId++}`;
+      const label = document.createElement('span');
+      label.textContent = name;
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.className = 'remove-bean';
+      remove.textContent = 'Remove';
+      remove.setAttribute('aria-label', `Remove ${name}`);
+      item.append(label, remove);
+
+      updateBeans(() => {
+        beanList.append(item);
+        beanStatus.textContent = `${name} added. ${beanList.children.length} beans selected.`;
+      });
+    });
+
+    beanList.addEventListener('click', (event) => {
+      const remove = event.target.closest('.remove-bean');
+      if (!remove) return;
+      const item = remove.closest('.item');
+      updateBeans(() => {
+        if (!item.isConnected) return;
+        const hadFocus = item.contains(document.activeElement);
+        const focusTarget = item.nextElementSibling?.querySelector('button')
+          || item.previousElementSibling?.querySelector('button')
+          || beanForm.querySelector('button');
+        const name = item.querySelector('span').textContent;
+        item.remove();
+        if (hadFocus) focusTarget.focus({ preventScroll: true });
+        beanStatus.textContent = `${name} removed. ${beanList.children.length} beans selected.`;
+      });
+    });
+  </script>
