+  <script>
+    const beanForm = document.getElementById('bean-form');
+    const beanInput = document.getElementById('bean-name');
+    const beanList = document.getElementById('bean-list');
+    const beanStatus = document.getElementById('bean-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let nextBeanId = 4;
+    let activeTransition;
+
+    function updateBeans(update) {
+      if (reducedMotion.matches || !document.startViewTransition) {
+        update();
+        return;
+      }
+
+      activeTransition = document.startViewTransition(update);
+      // A new interaction can interrupt an animation without losing its update.
+      activeTransition.finished.catch(() => {});
+    }
+
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) activeTransition?.skipTransition();
+    });
+
+    beanForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const name = beanInput.value.trim();
+      if (!name) {
+        beanInput.setCustomValidity('Enter a coffee bean name.');
+        beanInput.reportValidity();
+        return;
+      }
+
+      const item = document.createElement('li');
+      item.className = 'item';
+      item.style.viewTransitionName = `bean-${nextBeanId++}`;
+      const label = document.createElement('span');
+      label.textContent = name;
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.className = 'remove-bean';
+      remove.textContent = 'Remove';
+      remove.setAttribute('aria-label', `Remove ${name}`);
+      item.append(label, remove);
+
+      updateBeans(() => {
+        beanList.append(item);
+        beanStatus.textContent = `${name} added.`;
+      });
+      beanInput.value = '';
+      beanInput.focus();
+    });
+
+    beanInput.addEventListener('input', () => beanInput.setCustomValidity(''));
+
+    beanList.addEventListener('click', (event) => {
+      const button = event.target.closest('.remove-bean');
+      if (!button) return;
+      const item = button.closest('.item');
+      const name = item.querySelector('span').textContent;
+      updateBeans(() => {
+        const focusTarget = item.nextElementSibling?.querySelector('button')
+          || item.previousElementSibling?.querySelector('button') || beanInput;
+        const needsFocus = item.contains(document.activeElement);
+        item.remove();
+        if (needsFocus) focusTarget.focus();
+        beanStatus.textContent = `${name} removed.`;
+      });
+    });
+  </script>
