+  <script>
+    const stage = document.querySelector('.cup-stage');
+    const canvas = document.getElementById('canvas');
+    const form = document.querySelector('.cup-form');
+    const coffeeName = document.getElementById('coffee-name');
+    const milk = document.getElementById('coffee-milk');
+    const syrup = document.getElementById('coffee-syrup');
+    const status = document.getElementById('save-status');
+
+    function updateSummary() {
+      document.getElementById('summary-name').textContent = coffeeName.value.trim() || 'Your daily grind';
+      document.getElementById('summary-milk').textContent = milk.selectedOptions[0].textContent;
+      document.getElementById('summary-syrup').textContent = syrup.selectedOptions[0].textContent;
+      const temperature = form.querySelector('input[name="temperature"]:checked');
+      document.getElementById('summary-temperature').textContent = temperature.closest('label').querySelector('span').textContent;
+      status.textContent = '';
+    }
+
+    function drawCup() {
+      const bounds = stage.getBoundingClientRect();
+      const content = form.getBoundingClientRect();
+      if (!bounds.width || !bounds.height) return;
+      const dpr = window.devicePixelRatio || 1;
+      canvas.width = Math.round(bounds.width * dpr);
+      canvas.height = Math.round(bounds.height * dpr);
+      const ctx = canvas.getContext('2d');
+      if (!ctx) return;
+      // Map the backing store to the exact CSS size, including rounding.
+      ctx.setTransform(canvas.width / bounds.width, 0, 0, canvas.height / bounds.height, 0, 0);
+      const left = content.left - bounds.left - 22;
+      const right = content.right - bounds.left + 22;
+      const top = content.top - bounds.top - 25;
+      const bottom = content.bottom - bounds.top + 30;
+      const middle = (left + right) / 2;
+      const handleY = top + (bottom - top) * 0.45;
+      const handleWidth = Math.min(48, bounds.width - right - 12);
+
+      ctx.fillStyle = 'rgba(78, 52, 46, 0.10)';
+      ctx.beginPath();
+      ctx.ellipse(middle + 12, bottom + 14, (right - left) * 0.56, 12, 0, 0, Math.PI * 2);
+      ctx.fill();
+
+      ctx.strokeStyle = '#b99b83';
+      ctx.lineWidth = 17;
+      ctx.beginPath();
+      ctx.ellipse(right - 3, handleY, handleWidth, 58, 0, -Math.PI / 2, Math.PI / 2);
+      ctx.stroke();
+      ctx.strokeStyle = '#fff9ed';
+      ctx.lineWidth = 11;
+      ctx.stroke();
+
+      const glaze = ctx.createLinearGradient(left, 0, right, 0);
+      glaze.addColorStop(0, '#ead9c3');
+      glaze.addColorStop(0.25, '#fff9ed');
+      glaze.addColorStop(1, '#f1e2cc');
+      ctx.fillStyle = glaze;
+      ctx.strokeStyle = '#b99b83';
+      ctx.lineWidth = 2;
+      ctx.beginPath();
+      ctx.moveTo(left - 6, top);
+      ctx.lineTo(right + 6, top);
+      ctx.lineTo(right, bottom - 22);
+      ctx.quadraticCurveTo(right, bottom, right - 24, bottom);
+      ctx.lineTo(left + 24, bottom);
+      ctx.quadraticCurveTo(left, bottom, left, bottom - 22);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+
+      ctx.beginPath();
+      ctx.ellipse(middle, top, (right - left) / 2 + 6, 16, 0, 0, Math.PI * 2);
+      ctx.fillStyle = '#6c4130';
+      ctx.fill();
+      ctx.strokeStyle = '#d5bda1';
+      ctx.lineWidth = 6;
+      ctx.stroke();
+
+      if (form.elements.temperature.value === 'hot') {
+        ctx.strokeStyle = '#b99b83';
+        ctx.lineWidth = 2;
+        ctx.lineCap = 'round';
+        for (const offset of [-28, 0, 28]) {
+          ctx.beginPath();
+          ctx.moveTo(middle + offset, top - 34);
+          ctx.bezierCurveTo(middle + offset - 14, top - 49, middle + offset + 14, top - 57, middle + offset, top - 72);
+          ctx.stroke();
+        }
+      }
+    }
+
+    form.addEventListener('input', () => { updateSummary(); drawCup(); });
+    form.addEventListener('change', () => { updateSummary(); drawCup(); });
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      try {
+        sessionStorage.setItem('daily-grind-blend', JSON.stringify(Object.fromEntries(new FormData(form))));
+        status.textContent = 'Your blend is saved for this visit. Enjoy your creation!';
+      } catch {
+        status.textContent = 'Your blend is ready, but this browser could not save it.';
+      }
+    });
+    try {
+      const saved = JSON.parse(sessionStorage.getItem('daily-grind-blend'));
+      if (saved && typeof saved === 'object') {
+        if (typeof saved.name === 'string') coffeeName.value = saved.name.slice(0, 60);
+        for (const select of [milk, syrup]) {
+          if ([...select.options].some(option => option.value === saved[select.name])) {
+            select.value = saved[select.name];
+          }
+        }
+        if (saved.temperature === 'hot' || saved.temperature === 'iced') {
+          form.elements.temperature.value = saved.temperature;
+        }
+        updateSummary();
+        status.textContent = 'Your saved blend is ready to customize.';
+      }
+    } catch {
+      // Customization remains available when browser storage is disabled.
+    }
+    new ResizeObserver(drawCup).observe(stage);
+    window.addEventListener('resize', drawCup);
+    // A monitor change can alter pixel density without changing the CSS size.
+    let densityQuery;
+    function watchDensity() {
+      if (densityQuery) densityQuery.removeEventListener('change', watchDensity);
+      densityQuery = window.matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+      densityQuery.addEventListener('change', watchDensity);
+      drawCup();
+    }
+    watchDensity();
+  </script>
+
