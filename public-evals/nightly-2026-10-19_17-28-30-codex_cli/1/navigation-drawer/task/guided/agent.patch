+  <script>
+    const drawer = document.getElementById('navigation-drawer');
+    const openButton = document.getElementById('drawer-open');
+    const closeButton = drawer.querySelector('.drawer-close');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    const page = document.getElementById('page-content');
+    let state = 'closed';
+    let hasEntered = false;
+
+    function finishClose() {
+      if (state === 'closed') return;
+      state = 'closed';
+      drawer.hidePopover();
+      page.inert = false;
+      document.documentElement.classList.remove('drawer-open');
+      openButton.setAttribute('aria-expanded', 'false');
+      openButton.focus({ preventScroll: true });
+    }
+
+    async function openDrawer() {
+      if (state !== 'closed') return;
+      state = 'opening';
+      hasEntered = false;
+      drawer.showPopover();
+      page.inert = true;
+      document.documentElement.classList.add('drawer-open');
+      openButton.setAttribute('aria-expanded', 'true');
+      sheet.focus({ preventScroll: true });
+
+      if (!CSS.supports('scroll-initial-target', 'nearest')) {
+        scroller.scrollTo({ left: scroller.scrollWidth - scroller.clientWidth, behavior: 'instant' });
+      }
+      // Commit the closed position before animating; also covers reopening.
+      await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
+      if (state === 'opening') scroller.scrollTo({ left: 0, behavior: 'auto' });
+    }
+
+    function closeDrawer() {
+      if (state === 'closed') return;
+      state = 'closing';
+      const closedPosition = scroller.scrollWidth - scroller.clientWidth;
+      // Escape can arrive before the opening animation has even started.
+      if (Math.abs(scroller.scrollLeft - closedPosition) < 1) {
+        finishClose();
+      } else {
+        scroller.scrollTo({ left: closedPosition, behavior: 'auto' });
+      }
+    }
+
+    const observer = new IntersectionObserver(entries => {
+      if (state === 'closed') return;
+      const entry = entries.at(-1);
+      if (entry.intersectionRatio > 0) hasEntered = true;
+      // Ignore the initial offscreen position while preparing the entrance.
+      if (!entry.isIntersecting || entry.intersectionRatio === 0) {
+        if (hasEntered || state === 'closing') finishClose();
+      } else if (entry.intersectionRatio === 1 && state === 'opening') {
+        state = 'open';
+      }
+    }, { root: scroller, threshold: [0, 1] });
+    observer.observe(sheet);
+
+    if (!(CSS.supports('animation-timeline: scroll()') && CSS.supports('timeline-scope: --drawer-fade'))) {
+      scroller.addEventListener('scroll', () => {
+        const progress = 1 - scroller.scrollLeft / sheet.offsetWidth;
+        drawer.style.setProperty('--drawer-backdrop', Math.max(0, Math.min(1, progress)));
+      }, { passive: true });
+    }
+
+    openButton.addEventListener('click', openDrawer);
+    closeButton.addEventListener('click', closeDrawer);
+    drawer.addEventListener('click', event => {
+      if (!sheet.contains(event.target)) closeDrawer();
+    });
+    document.addEventListener('keydown', event => {
+      if (state === 'closed') return;
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        closeDrawer();
+      }
+      if (event.key === 'Tab') {
+        const controls = sheet.querySelectorAll('button, a[href]');
+        const first = controls[0];
+        const last = controls[controls.length - 1];
+        if (event.shiftKey && (document.activeElement === first || document.activeElement === sheet)) {
+          event.preventDefault();
+          last.focus({ preventScroll: true });
+        } else if (!event.shiftKey && document.activeElement === last) {
+          event.preventDefault();
+          first.focus({ preventScroll: true });
+        }
+      }
+    });
+  </script>
