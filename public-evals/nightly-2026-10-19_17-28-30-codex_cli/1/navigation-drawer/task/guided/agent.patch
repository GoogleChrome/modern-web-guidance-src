+  <!-- Manual popover prevents light-dismiss from interrupting a native swipe. -->
+  <div id="navigation-drawer" class="drawer" popover="manual">
+    <div class="drawer-scroller">
+      <div class="drawer-sheet" role="dialog" aria-modal="true" aria-labelledby="drawer-title" tabindex="-1">
+        <div class="drawer-heading">
+          <h2 id="drawer-title">The Daily Grind</h2>
+          <button class="drawer-close" type="button" aria-label="Close menu">
+            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
+              <path d="m6 6 12 12M6 18 18 6" />
+            </svg>
