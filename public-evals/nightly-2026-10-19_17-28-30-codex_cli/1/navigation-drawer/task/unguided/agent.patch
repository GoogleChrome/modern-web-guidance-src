+  <script>
+    const menuButton = document.querySelector('.menu-button');
+    const drawer = document.querySelector('#nav-drawer');
+
+    menuButton.addEventListener('click', () => {
+      drawer.showModal();
+      menuButton.setAttribute('aria-expanded', 'true');
+      drawer.scrollTo({ left: drawer.scrollWidth - drawer.clientWidth, behavior: 'instant' });
+    });
+
+    document.querySelector('.drawer-dismiss').addEventListener('click', () => drawer.close());
+
+    // The browser handles the swipe and snaps to either the open or closed position.
+    drawer.addEventListener('scrollend', () => {
+      if (drawer.open && drawer.scrollLeft <= 1) drawer.close();
+    });
+
+    drawer.addEventListener('close', () => {
+      menuButton.setAttribute('aria-expanded', 'false');
+      menuButton.focus({ preventScroll: true });
+    });
+  </script>
