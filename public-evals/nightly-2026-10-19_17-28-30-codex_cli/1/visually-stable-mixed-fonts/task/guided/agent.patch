+    @media (max-width: 580px) { .header-inner { height: 72px; } .header-note { font-size: .625rem; } .toolbar { align-items: flex-start; flex-direction: column; gap: 18px; } .toolbar-controls { justify-content: space-between; width: 100%; } .examples, .explanations, .code-content { grid-template-columns: 1fr; } .examples { gap: 24px; } .preview { min-height: 240px; } .explanations { gap: 8px; } .code-content { gap: 20px; } footer { gap: 20px; align-items: flex-start; } }
+  </style>
+</head>
+<body>
+  <header><div class="shell header-inner"><div class="brand"><span class="brand-mark" aria-hidden="true">f.</span>form & type</div><div class="header-note"><span class="dot"></span>A small exploration of modern CSS</div></div></header>
+  <main class="shell">
+    <section class="hero" aria-labelledby="page-title">
+      <div><div class="eyebrow">The typography playground</div><h1 id="page-title">Different fonts.<br><span>Same visual rhythm.</span></h1><p class="intro">Good typography is a matter of balance. Explore how a little CSS brings mixed fonts into harmony, automatically.</p></div>
+      <div class="specimen" aria-hidden="true"><span>a</span><span class="serif">a</span><span class="mono">a</span><div class="specimen-label">THREE FAMILIES. ONE X-HEIGHT.</div></div>
+    </section>
+    <section aria-label="Interactive font examples">
+      <div class="toolbar">
+        <div class="toolbar-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 7h16M4 17h16M8 4v6m8 4v6"/></svg>Make yourself a little type harmony</div>
+        <div class="toolbar-controls"><label class="size-control" for="font-size">Font size <input id="font-size" type="range" min="18" max="32" value="24"><output id="size-value" for="font-size">24px</output></label><label class="toggle-label"><input class="switch" id="normalize" type="checkbox" checked>Normalize fonts</label></div>
+      </div>
+      <div class="examples">
+        <article class="card">
+          <div class="card-heading"><div class="card-title"><span class="number">01</span><h2>Mixed fonts, in sync</h2></div><span class="badge">from-font</span></div>
+          <div class="preview"><div class="preview-label">Sans serif meets monospace</div><p id="mixed-fonts-container">A little <code>const harmony</code> goes a long way. Different fonts, one consistent <code>x-height</code>.</p></div>
+          <div class="card-footer"><span class="font-label">Font pairing</span><span class="font-name">DM Sans <span aria-hidden="true">↔</span> IBM Plex Mono</span></div>
+        </article>
+        <article class="card">
+          <div class="card-heading"><div class="card-title"><span class="number">02</span><h2>A theme of its own</h2></div><span class="badge" id="ratio-badge">0.5</span></div>
+          <div id="independent-theme-container" class="preview"><div class="preview-label">Independent theme</div><p class="theme-quote">“Details make the difference.<br>Let every letter find its<br><em>own sense of balance.</em>”</p><div class="theme-credit">A different family. The same attention to detail.</div></div>
+          <div class="card-footer"><label class="font-label" for="theme-ratio">X-height ratio</label><select id="theme-ratio"><option value="0.5">0.50 · Balanced</option><option value="0.45">0.45 · Compact</option><option value="0.55">0.55 · Generous</option><option value="0.6">0.60 · Expressive</option></select></div>
+        </article>
+      </div>
+      <div class="explanations"><p><strong>Automatically aligned.</strong> The primary font sets the x-height, and inline code follows its lead. No manual size adjustments.</p><p><strong>Independently balanced.</strong> An explicit ratio gives this theme its own visual proportions, regardless of its surroundings.</p></div>
+    </section>
+    <section class="code-panel" aria-label="CSS for these examples">
+      <div class="code-heading"><div class="code-title"><span aria-hidden="true">{ }</span>The CSS behind the balance</div><button class="copy-button" id="copy-css"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true"><rect x="5" y="5" width="8" height="9" rx="1.5"/><path d="M10 5V2H2v9h3"/></svg><span id="copy-label" aria-live="polite">Copy CSS</span></button></div>
+      <div class="code-content"><pre><span class="comment">/* Let the primary font lead */</span>
+#mixed-fonts-container {
+  <span class="property">font-size-adjust</span>: <span class="value" id="mixed-code-value">from-font</span>;
+}</pre><pre><span class="comment">/* Give a theme its own proportions */</span>
+#independent-theme-container {
+  <span class="property">font-size-adjust</span>: <span class="value" id="theme-code-value">0.5</span>;
+}</pre></div>
+    </section>
+    <div class="support"><span class="dot"></span><span id="support-note">Progressive by nature. Natural font sizing in older browsers.</span></div>
+  </main>
+  <footer class="shell"><span>A little CSS. A lot more harmony.</span><span>Made for the love of type <span aria-hidden="true">↗</span></span></footer>
+  <script>
+    const size = document.querySelector('#font-size');
+    const normalize = document.querySelector('#normalize');
+    const ratio = document.querySelector('#theme-ratio');
+    const theme = document.querySelector('#independent-theme-container');
+    const mixedCode = document.querySelector('#mixed-code-value');
+    const themeCode = document.querySelector('#theme-code-value');
+    function update() {
+      const ratioValue = String(Number(ratio.value));
+      document.documentElement.style.setProperty('--preview-size', `${Number(size.value) / 16}rem`);
+      document.querySelector('#size-value').value = `${size.value}px`;
+      document.body.classList.toggle('no-adjust', !normalize.checked);
+      theme.style.fontSizeAdjust = normalize.checked ? ratioValue : 'none';
+      mixedCode.textContent = normalize.checked ? 'from-font' : 'none';
+      themeCode.textContent = normalize.checked ? ratioValue : 'none';
+      document.querySelector('#ratio-badge').textContent = ratioValue;
+    }
+    size.addEventListener('input', update);
+    normalize.addEventListener('change', update);
+    ratio.addEventListener('change', update);
+    document.querySelector('#copy-css').addEventListener('click', async () => {
+      const css = `#mixed-fonts-container {\n  font-size-adjust: ${mixedCode.textContent};\n}\n\n#independent-theme-container {\n  font-size-adjust: ${themeCode.textContent};\n}`;
+      const label = document.querySelector('#copy-label');
+      try {
+        await navigator.clipboard.writeText(css);
+        label.textContent = 'Copied!';
+      } catch {
+        label.textContent = 'Select CSS to copy';
+        const selection = window.getSelection();
+        const range = document.createRange();
+        range.selectNodeContents(document.querySelector('.code-content'));
+        selection.removeAllRanges();
+        selection.addRange(range);
+      }
+      setTimeout(() => { label.textContent = 'Copy CSS'; }, 2500);
+    });
+    if (!CSS.supports('font-size-adjust', 'from-font')) {
+      document.querySelector('#support-note').textContent = 'Your browser is using fallback font sizing. Try a current browser for automatic normalization.';
+    }
+  </script>
+</body>
+</html>
