+    .comment { color: #919785; } .property { color: #7b775c; } .value { color: #506e44; }
+    .support { display: flex; align-items: center; gap: 7px; font-size: .6875rem; color: #858b7c; margin-top: 18px; }
+    .support .dot { width: 5px; height: 5px; }
+    footer { margin-top: 54px; padding: 23px 0 26px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; font-size: .6875rem; color: #919487; }
+    footer span:last-child { display: flex; align-items: center; gap: 7px; }
+    .no-adjust #mixed-fonts-container, .no-adjust #independent-theme-container { font-size-adjust: none; }
+    @supports not (font-size-adjust: from-font) { #mixed-fonts-container { line-height: 1.85; } #mixed-fonts-container code { font-size: .94em; } }
+    @supports not (font-size-adjust: 0.5) { #independent-theme-container { font-size: calc(var(--preview-size, 1.5rem) * 1.08); line-height: 1.7; } }
