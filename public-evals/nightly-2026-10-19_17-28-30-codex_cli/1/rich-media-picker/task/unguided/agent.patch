+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const listbox = document.getElementById('roast-options');
+    const options = Array.from(listbox.querySelectorAll('[role="option"]'));
+    const value = document.getElementById('roast-value');
+    const order = document.getElementById('hero-order');
+    let selectedIndex = 0;
+    let activeIndex = 0;
+    let search = '';
+    let searchTimer;
+
+    function activate(index) {
+      activeIndex = (index + options.length) % options.length;
+      options.forEach((option, i) => option.classList.toggle('is-active', i === activeIndex));
+      listbox.setAttribute('aria-activedescendant', options[activeIndex].id);
+      options[activeIndex].scrollIntoView({ block: 'nearest' });
+    }
+
+    function openPicker() {
+      listbox.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      activate(selectedIndex);
+      listbox.focus({ preventScroll: true });
+    }
+
+    function closePicker(restoreFocus = false) {
+      listbox.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      search = '';
+      clearTimeout(searchTimer);
+      if (restoreFocus) trigger.focus({ preventScroll: true });
+    }
+
+    function selectOption(index) {
+      selectedIndex = index;
+      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
+      value.replaceChildren(...options[index].querySelector('.roast-content').cloneNode(true).childNodes);
+      order.href = '/order-online?roast=' + encodeURIComponent(options[index].dataset.value);
+      closePicker(true);
+    }
+
+    trigger.addEventListener('click', () => listbox.hidden ? openPicker() : closePicker());
+    trigger.addEventListener('keydown', (event) => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openPicker();
+      }
+    });
+    listbox.addEventListener('click', (event) => {
+      const option = event.target.closest('[role="option"]');
+      if (option) selectOption(options.indexOf(option));
+    });
+    listbox.addEventListener('keydown', (event) => {
+      switch (event.key) {
+        case 'ArrowDown': event.preventDefault(); activate(activeIndex + 1); break;
+        case 'ArrowUp': event.preventDefault(); activate(activeIndex - 1); break;
+        case 'Home': event.preventDefault(); activate(0); break;
+        case 'End': event.preventDefault(); activate(options.length - 1); break;
+        case 'Enter':
+        case ' ': event.preventDefault(); selectOption(activeIndex); break;
+        case 'Escape': event.preventDefault(); closePicker(true); break;
+        case 'Tab': closePicker(true); break;
+        default:
+          if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
+            event.preventDefault();
+            search += event.key.toLowerCase();
+            clearTimeout(searchTimer);
+            searchTimer = setTimeout(() => { search = ''; }, 600);
+            const match = options.findIndex(option => option.querySelector('.roast-title').textContent.toLowerCase().startsWith(search));
+            if (match !== -1) activate(match);
+          }
+      }
+    });
+    document.addEventListener('click', (event) => {
+      if (!picker.contains(event.target)) closePicker();
+    });
+    picker.addEventListener('focusout', (event) => {
+      if (!picker.contains(event.relatedTarget)) closePicker();
+    });
+  </script>
+
