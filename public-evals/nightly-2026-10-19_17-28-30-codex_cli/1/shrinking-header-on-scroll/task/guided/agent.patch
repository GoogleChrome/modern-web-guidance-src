+  <script>
+    (function () {
+      // Use the same support check as CSS, including partial implementations.
+      var supportsScrollAnimation = window.CSS &&
+        typeof window.CSS.supports === 'function' &&
+        window.CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+
+      if (supportsScrollAnimation) return;
+
+      var nav = document.querySelector('nav');
+      var framePending = false;
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      function updateNav() {
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = reducedMotion.matches ? 1 : Math.max(0, Math.min(1, scrollTop / 160));
+        nav.style.setProperty('--nav-progress', progress);
+        framePending = false;
+      }
+
+      function scheduleUpdate() {
+        if (framePending) return;
+        framePending = true;
+        window.requestAnimationFrame(updateNav);
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('pageshow', scheduleUpdate);
+      updateNav();
+    }());
+  </script>
+
