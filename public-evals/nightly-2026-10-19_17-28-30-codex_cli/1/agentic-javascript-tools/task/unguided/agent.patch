diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,73 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      // Support both the current WebMCP API and its earlier navigator location.
+      const modelContext = document.modelContext ?? navigator.modelContext;
+      if (!modelContext?.registerTool) return;
+
+      const toolName = 'get_menu_item';
+      const normalizeName = (name) => name.trim().replace(/\s+/g, ' ').toLowerCase();
+      let registration;
+
+      const tool = {
+        name: toolName,
+        description: 'Look up a Daily Grind menu item by name. Returns its name, description, and details URL from the current menu. Use for questions about Maple Oat Latte, Dark Roast Espresso, or Cold Brew. If no item matches, returns an error and the available item names.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              minLength: 1,
+              description: 'The full menu item name, for example "Maple Oat Latte", "Dark Roast Espresso", or "Cold Brew". Matching ignores capitalization and extra whitespace.'
+            }
+          },
+          required: ['name'],
+          additionalProperties: false
+        },
+        annotations: { readOnlyHint: true },
+        execute: async ({ name } = {}) => {
+          if (typeof name !== 'string' || !name.trim()) {
+            return { error: 'Provide a non-empty menu item name.' };
+          }
+
+          const items = Array.from(document.querySelectorAll('main .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href
+          }));
+          return items.find((item) => normalizeName(item.name) === normalizeName(name))
+            ?? { error: `No menu item found for "${name}".`, availableItems: items.map((item) => item.name) };
+        }
+      };
+
+      async function registerTool() {
+        if (registration) return;
+        const controller = new AbortController();
+        registration = controller;
+        try {
+          await modelContext.registerTool(tool, { signal: controller.signal });
+        } catch (error) {
+          if (registration === controller) registration = undefined;
+          if (!controller.signal.aborted) console.warn('Could not register menu lookup tool.', error);
+        }
+      }
+
+      function cleanup() {
+        if (!registration) return;
+        registration.abort();
+        // Earlier implementations expose explicit removal instead of AbortSignal cleanup.
+        modelContext.unregisterTool?.(toolName);
+        registration = undefined;
+      }
+
+      window.addEventListener('pagehide', cleanup);
+      window.addEventListener('pageshow', registerTool);
+      registerTool();
+    })();
+  </script>
 </body>
 
 </html>
