+    .edition { position: absolute; top: 20px; left: 20px; font-size: 9px; letter-spacing: 1.6px; text-transform: uppercase; pointer-events: none; }
+    .image-index { position: absolute; right: 20px; bottom: 20px; color: #6e7565; font-size: 10px; letter-spacing: 1px; }
