+    .specs dt { font-size: 11px; }
+    .specs dd { margin: 7px 0 0; color: var(--muted); font-size: 10px; }
+    footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 25px; min-height: 140px; padding-block: 36px; border-top: 1px solid var(--line); }
