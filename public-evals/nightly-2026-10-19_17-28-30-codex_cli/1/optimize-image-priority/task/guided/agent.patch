+        <span><i aria-hidden="true">↗</i> Made for everyday living</span>
+        <span><i aria-hidden="true">✳</i> Less, but considered</span>
+      </div>
+      <section class="approach" id="approach" aria-labelledby="approach-title">
+        <p class="section-label">01 / Our approach</p>
+        <div class="approach-copy">
+          <h2 id="approach-title">Good design leaves<br>room for living.</h2>
+          <p>We believe the things you surround yourself with should make the everyday feel a little better. Quiet shapes. Useful details. Nothing more than you need.</p>
+          <dl class="specs">
+            <div><dt>Simple by nature</dt><dd>A form that feels at home</dd></div>
+            <div><dt>A warmer welcome</dt><dd>Light with a softer touch</dd></div>
+          </dl>
+        </div>
+      </section>
+    </main>
+    <footer>
+      <a href="#top" aria-label="Forma home"><img src="footer-logo.png" alt="forma." width="190" height="64" loading="lazy"></a>
+      <p>© 2026 Forma. A little more considered.</p>
+      <a href="#top">Back to top ↑</a>
+    </footer>
+  </div>
+  <script>
+    const viewButtons = document.querySelectorAll('[data-view]');
+    viewButtons.forEach(button => {
+      button.addEventListener('click', () => {
+        const detail = button.dataset.view === 'detail';
+        document.getElementById('gallery-front').hidden = detail;
+        document.getElementById('gallery-detail').hidden = !detail;
+        document.querySelector('.image-index').textContent = detail ? '02 / 02' : '01 / 02';
+        viewButtons.forEach(view => view.setAttribute('aria-pressed', String(view === button)));
+      });
+    });
+    const menu = document.querySelector('.menu');
+    menu.querySelector('a').addEventListener('click', () => { menu.open = false; });
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && menu.open) {
+        menu.open = false;
+        menu.querySelector('summary').focus();
+      }
+    });
+    document.addEventListener('click', event => {
+      if (!menu.contains(event.target)) menu.open = false;
+    });
+  </script>
+</body>
+</html>
