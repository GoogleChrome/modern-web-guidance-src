+    h2 { max-width: 500px; margin: 0 0 24px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(32px, 3.4vw, 48px); line-height: 1.15; letter-spacing: -1.5px; font-weight: 400; }
+    .approach-copy > p { max-width: 360px; font-size: 13px; color: var(--muted); line-height: 1.9; }
+    .specs { display: flex; flex-wrap: wrap; gap: 30px; margin-top: 35px; }
