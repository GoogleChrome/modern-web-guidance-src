+            <img id="gallery-front" src="hero-lcp.jpg" alt="Everyday Lamp in a soft chalk finish" width="1200" height="1200" fetchpriority="high" loading="eager">
+            <img id="gallery-detail" src="gallery-alt.jpg" alt="Close-up of the Everyday Lamp's finish and curved shade" width="1200" height="1200" fetchpriority="low" loading="lazy" hidden>
+            <span class="edition">The everyday collection — No. 01</span>
+            <span class="image-index" aria-hidden="true">01 / 02</span>
+          </div>
+          <figcaption class="gallery-caption">
+            <div>
+              <h2 class="product-name">The Everyday Lamp</h2>
+              <p class="product-finish">Chalk / A softer kind of light</p>
+            </div>
+            <div class="gallery-controls" role="group" aria-label="Choose product view">
