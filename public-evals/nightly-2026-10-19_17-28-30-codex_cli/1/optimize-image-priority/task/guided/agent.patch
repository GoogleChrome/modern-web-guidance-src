+    .menu summary::after { content: '+'; font-size: 17px; font-weight: 400; }
+    .menu[open] summary::after { content: '−'; }
+    .menu-panel { position: absolute; z-index: 3; top: 88px; right: 0; width: min(420px, 100%); padding: 24px; border: 1px solid var(--line); background: var(--paper); box-shadow: 0 16px 30px #292d270a; }
