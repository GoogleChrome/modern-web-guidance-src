+    .view-button[aria-pressed="true"] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
+    .quiet-strip { display: flex; justify-content: space-between; padding-block: 23px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--muted); font-size: 10px; letter-spacing: .4px; }
+    .quiet-strip span { display: flex; gap: 10px; align-items: center; }
+    .quiet-strip i { font-size: 13px; font-style: normal; color: #878e7a; }
