+  </style>
+</head>
+<body id="top">
+  <a class="skip" href="#main">Skip to content</a>
+  <div class="wrap">
+    <header>
+      <a class="wordmark" href="#top" aria-label="Forma home">forma.</a>
+      <nav aria-label="Main navigation">
+        <details class="menu">
+          <summary>Collection</summary>
+          <div class="menu-panel">
+            <img src="mega-menu-promo.jpg" alt="Discover the Forma lighting collection" width="600" height="300" fetchpriority="low" loading="lazy">
+            <a href="#product">The Everyday Lamp <span aria-hidden="true">↗</span></a>
+          </div>
+        </details>
+        <a href="#approach">Our approach</a>
+      </nav>
+      <span class="header-note">Considered objects. Everyday living.</span>
+    </header>
+    <main id="main">
+      <section class="hero" aria-labelledby="hero-title">
+        <div class="hero-copy">
+          <p class="eyebrow">Introducing the everyday lamp</p>
+          <h1 id="hero-title">A little light.<br><em>A lot of calm.</em></h1>
+          <p class="intro">Soft light. Simple form. A thoughtful little addition to the spaces you call your own.</p>
+          <a class="cta" href="#approach">Meet your everyday <span aria-hidden="true">↗</span></a>
+          <span class="product-note">Made to fit in. Designed to stay.</span>
+        </div>
+        <figure class="gallery" id="product" aria-label="Everyday Lamp product gallery">
