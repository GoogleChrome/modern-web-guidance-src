diff --git a/src/components/PasskeySettings.tsx b/src/components/PasskeySettings.tsx
new file mode 100644
index 0000000..f24b7a7
--- /dev/null
+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,394 @@
+import { useEffect, useState } from "react";
+import providers from "../lib/passkey-providers.json";
+function provider(aaguid: string): { name: string; icon?: string } | undefined {
+  if (aaguid === "00000000-0000-0000-0000-000000000000") return undefined;
+  return (providers as Record<string, { name: string; icon?: string }>)[aaguid];
+}
+import {
+  api,
+  authenticate,
+  base,
+  capabilities,
+  message,
+  register,
+  syncKeys,
+} from "../lib/passkeys";
+interface Key {
+  id: string;
+  name: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+  backedUp: boolean;
+  aaguid: string;
+}
+interface Account {
+  rpID: string;
+  user: {
+    id: string;
+    username: string;
+    displayName: string;
+    hasPassword: boolean;
+  };
+  passkeys: Key[];
+}
+export default function PasskeySettings() {
+  const [data, setData] = useState<Account | null>(null);
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [supported, setSupported] = useState(false);
+  const [password, setPassword] = useState("");
+  const [editing, setEditing] = useState<string | null>(null);
+  const [label, setLabel] = useState("");
+  const [deleting, setDeleting] = useState<string | null>(null);
+  const [username, setUsername] = useState("");
+  const [displayName, setDisplayName] = useState("");
+  async function load() {
+    const next: Account = await api("passkeys");
+    setData(next);
+    await syncKeys(next);
+    return next;
+  }
+  useEffect(() => {
+    capabilities().then((c) => setSupported(!!c?.passkeyPlatformAuthenticator));
+    load()
+      .then((next) => {
+        setUsername(next.user.username);
+        setDisplayName(next.user.displayName);
+      })
+      .catch((e) => setError(message(e)));
+  }, []);
+  async function run(work: () => Promise<void>, success: string) {
+    setBusy(true);
+    setError("");
+    setNotice("");
+    try {
+      await work();
+      setNotice(success);
+    } catch (e) {
+      setError(message(e));
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function verify() {
+    if (data?.passkeys.length && supported) await authenticate("reauth");
+    else if (data?.user.hasPassword && password) {
+      await api("password/reauth", { password });
+      setPassword("");
+    } else
+      throw new Error("Enter your password below to verify your identity.");
+  }
+  const button =
+    "rounded-md border border-gray-300 px-4 py-2 text-sm font-medium hover:bg-gray-50 disabled:opacity-50";
+  return (
+    <section className="max-w-2xl mx-auto px-4 py-12 space-y-8">
+      <div>
+        <h1 className="text-3xl font-bold">Account security</h1>
+        <p className="mt-2 text-gray-600">
+          Manage how you sign in to The DevTools Times.
+        </p>
+      </div>
+      {error && (
+        <p role="alert" className="rounded bg-red-50 p-3 text-red-800">
+          {error}{" "}
+          {!data && (
+            <a className="underline" href={`${base}signin`}>
+              Sign in
+            </a>
+          )}
+        </p>
+      )}
+      {notice && (
+        <p role="status" className="rounded bg-green-50 p-3 text-green-800">
+          {notice}
+        </p>
+      )}
+      {data && (
+        <>
+          <div className="border rounded-lg p-5 space-y-4">
+            <h2 className="text-xl font-semibold">Verify your identity</h2>
+            <p className="text-sm text-gray-600">
+              Account changes require a fresh identity check. Your device may
+              ask for your fingerprint, face, or PIN.
+            </p>
+            {data.user.hasPassword && (
+              <label className="block text-sm">
+                Password alternative
+                <input
+                  type="password"
+                  autoComplete="current-password"
+                  value={password}
+                  maxLength={256}
+                  onChange={(e) => setPassword(e.target.value)}
+                  className="block w-full border rounded-md p-2 mt-1"
+                />
+              </label>
+            )}
+            <div className="flex flex-wrap gap-2">
+              {supported && !!data.passkeys.length && (
+                <button
+                  className={button}
+                  disabled={busy}
+                  onClick={() =>
+                    void run(() => authenticate("reauth"), "Identity verified.")
+                  }
+                >
+                  Verify with a passkey
+                </button>
+              )}
+              {data.user.hasPassword && (
+                <button
+                  className={button}
+                  disabled={busy || !password}
+                  onClick={() =>
+                    void run(async () => {
+                      await api("password/reauth", { password });
+                      setPassword("");
+                    }, "Identity verified.")
+                  }
+                >
+                  Verify with password
+                </button>
+              )}
+            </div>
+          </div>
+          <div className="space-y-4">
+            <div>
+              <h2 className="text-xl font-semibold">Your passkeys</h2>
+              <p className="text-sm text-gray-600 mt-1">
+                Use a fingerprint, face, screen lock, or security key. Your
+                biometric data stays on your device.
+              </p>
+            </div>
+            {!data.passkeys.length && (
+              <p className="border rounded-lg p-5 text-gray-600">
+                You haven’t created a passkey yet. Add one for faster sign-in.
+              </p>
+            )}
+            <ul className="space-y-3">
+              {data.passkeys.map((key) => (
+                <li key={key.id} className="border rounded-lg p-5 space-y-3">
+                  <div className="flex gap-3">
+                    <span aria-hidden="true" className="text-2xl">
+                      {provider(key.aaguid)?.icon ? (
+                        <img
+                          src={provider(key.aaguid)!.icon}
+                          alt=""
+                          width={28}
+                          height={28}
+                        />
+                      ) : (
+                        "⚿"
+                      )}
+                    </span>
+                    <div>
+                      <h3 className="font-semibold">{key.name}</h3>
+                      <p className="text-xs text-gray-600">
+                        {key.backedUp
+                          ? "Synced passkey"
+                          : "Device or security key"}{" "}
+                        ·{" "}
+                        {provider(key.aaguid)?.name ||
+                          "Provider not identified"}
+                      </p>
+                      <p className="text-xs text-gray-600 mt-1">
+                        Created{" "}
+                        {new Date(key.registeredAt).toLocaleDateString()} ·{" "}
+                        {key.lastUsedAt
+                          ? `Last used ${new Date(key.lastUsedAt).toLocaleString()}`
+                          : "Not used to sign in yet"}
+                      </p>
+                    </div>
+                  </div>
+                  {editing === key.id ? (
+                    <form
+                      className="flex flex-wrap gap-2"
+                      onSubmit={(e) => {
+                        e.preventDefault();
+                        void run(async () => {
+                          await verify();
+                          await api("passkeys/rename", {
+                            id: key.id,
+                            name: label,
+                          });
+                          setEditing(null);
+                          await load();
+                        }, "Passkey renamed.");
+                      }}
+                    >
+                      <input
+                        aria-label="Passkey name"
+                        required
+                        maxLength={80}
+                        value={label}
+                        onChange={(e) => setLabel(e.target.value)}
+                        className="border rounded p-2"
+                      />
+                      <button className={button} disabled={busy}>
+                        Save name
+                      </button>
+                      <button
+                        type="button"
+                        className={button}
+                        onClick={() => setEditing(null)}
+                      >
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <div className="flex gap-2">
+                      <button
+                        disabled={busy}
+                        className={button}
+                        onClick={() => {
+                          setEditing(key.id);
+                          setLabel(key.name);
+                        }}
+                      >
+                        Rename
+                      </button>
+                      <button
+                        disabled={
+                          busy ||
+                          (!data.user.hasPassword && data.passkeys.length === 1)
+                        }
+                        className={button}
+                        onClick={() => setDeleting(key.id)}
+                      >
+                        Remove
+                      </button>
+                    </div>
+                  )}
+                  {deleting === key.id && (
+                    <div className="bg-red-50 p-3 rounded">
+                      <p className="text-sm mb-3">
+                        Remove “{key.name}”? It will no longer work for sign-in.
+                        You may also need to remove it from your password
+                        manager.
+                      </p>
+                      <div className="flex gap-2">
+                        <button
+                          className={button}
+                          disabled={busy}
+                          onClick={() =>
+                            void run(async () => {
+                              await verify();
+                              await api("passkeys/delete", { id: key.id });
+                              setDeleting(null);
+                              await load();
+                            }, "Passkey removed.")
+                          }
+                        >
+                          Confirm removal
+                        </button>
+                        <button
+                          className={button}
+                          disabled={busy}
+                          onClick={() => setDeleting(null)}
+                        >
+                          Cancel
+                        </button>
+                      </div>
+                    </div>
+                  )}
+                </li>
+              ))}
+            </ul>
+            {!data.user.hasPassword && data.passkeys.length === 1 && (
+              <p className="text-xs text-gray-600">
+                Add another passkey before removing your only sign-in method.
+              </p>
+            )}
+            {supported ? (
+              <button
+                className="rounded-md bg-gray-900 px-4 py-3 text-white font-medium disabled:opacity-50"
+                disabled={busy}
+                onClick={() =>
+                  void run(async () => {
+                    await verify();
+                    await register();
+                    await load();
+                  }, "Passkey created.")
+                }
+              >
+                Create a passkey
+              </button>
+            ) : (
+              <p className="text-sm text-gray-600">
+                To create or use a passkey, open this account in a supported
+                browser over HTTPS.
+              </p>
+            )}
+          </div>
+          <form
+            className="border rounded-lg p-5 space-y-4"
+            onSubmit={(e) => {
+              e.preventDefault();
+              void run(async () => {
+                await verify();
+                await api("profile", { username, displayName });
+                const next = await load();
+                try {
+                  if (
+                    window.PublicKeyCredential &&
+                    typeof PublicKeyCredential.signalCurrentUserDetails ===
+                      "function"
+                  )
+                    await PublicKeyCredential.signalCurrentUserDetails({
+                      rpId: next.rpID,
+                      userId: next.user.id,
+                      name: next.user.username,
+                      displayName: next.user.displayName,
+                    });
+                } catch {
+                  /* Optional synchronization. */
+                }
+              }, "Account details updated.");
+            }}
+          >
+            <h2 className="text-xl font-semibold">Account details</h2>
+            <label className="block text-sm">
+              Username
+              <input
+                className="block w-full border rounded p-2 mt-1"
+                required
+                minLength={3}
+                maxLength={100}
+                autoComplete="username"
+                value={username}
+                onChange={(e) => setUsername(e.target.value)}
+              />
+            </label>
+            <label className="block text-sm">
+              Display name
+              <input
+                className="block w-full border rounded p-2 mt-1"
+                required
+                maxLength={100}
+                autoComplete="name"
+                value={displayName}
+                onChange={(e) => setDisplayName(e.target.value)}
+              />
+            </label>
+            <button className={button} disabled={busy}>
+              Save account details
+            </button>
+          </form>
+          <button
+            className={button}
+            disabled={busy}
+            onClick={() =>
+              void run(async () => {
+                await api("logout", {});
+                window.location.assign(`${base}signin`);
+              }, "Signed out.")
+            }
+          >
+            Sign out
+          </button>
+        </>
+      )}
+    </section>
+  );
+}
