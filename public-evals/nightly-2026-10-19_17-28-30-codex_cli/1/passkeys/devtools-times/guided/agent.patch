diff --git a/src/components/AuthForm.tsx b/src/components/AuthForm.tsx
new file mode 100644
index 0000000..420be0a
--- /dev/null
+++ b/src/components/AuthForm.tsx
@@ -0,0 +1,172 @@
+import { useEffect, useRef, useState } from "react";
+import {
+  api,
+  authenticate,
+  base,
+  capabilities,
+  message,
+  register,
+} from "../lib/passkeys";
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [supported, setSupported] = useState(false);
+  const abort = useRef<AbortController | null>(null);
+  const active = useRef(false);
+  const success = () => window.location.assign(`${base}account`);
+  async function autofill() {
+    const controller = new AbortController();
+    abort.current = controller;
+    try {
+      const caps = await capabilities();
+      if (controller.signal.aborted || !caps?.conditionalGet || signup) return;
+      await authenticate("authenticate", controller.signal, true);
+      success();
+    } catch (e) {
+      if (
+        !controller.signal.aborted &&
+        !(
+          e instanceof DOMException &&
+          ["NotAllowedError", "AbortError"].includes(e.name)
+        )
+      )
+        setError(message(e));
+    }
+  }
+  useEffect(() => {
+    active.current = true;
+    capabilities().then((caps) => {
+      if (active.current)
+        setSupported(signup ? !!caps?.passkeyPlatformAuthenticator : !!caps);
+    });
+    if (!signup) void autofill();
+    return () => {
+      active.current = false;
+      abort.current?.abort();
+    };
+  }, []);
+  async function submit(passkey: boolean) {
+    abort.current?.abort();
+    setBusy(true);
+    setError("");
+    try {
+      if (passkey) {
+        if (signup) await register(username);
+        else await authenticate();
+      } else
+        await api(`password/${signup ? "register" : "login"}`, {
+          username,
+          password,
+        });
+      success();
+    } catch (e) {
+      setError(message(e));
+      setBusy(false);
+      if (active.current && !signup) void autofill();
+    }
+  }
+  return (
+    <div className="max-w-md mx-auto mt-6 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <h1 className="text-2xl font-bold mb-2 text-center">
+        {signup ? "Create your account" : "Welcome back"}
+      </h1>
+      <p className="text-sm text-gray-600 text-center mb-6">
+        {signup
+          ? "Choose a passkey or a password to get started."
+          : "Sign in with your passkey or password."}
+      </p>
+      {error && (
+        <p role="alert" className="mb-4 p-3 bg-red-50 text-red-800 rounded">
+          {error}
+        </p>
+      )}
+      <form
+        className="space-y-4"
+        onSubmit={(e) => {
+          e.preventDefault();
+          void submit(false);
+        }}
+      >
+        <div>
+          <label htmlFor="username" className="block text-sm font-medium mb-1">
+            Username
+          </label>
+          <input
+            id="username"
+            name="username"
+            autoComplete={signup ? "username" : "username webauthn"}
+            required
+            minLength={3}
+            maxLength={100}
+            value={username}
+            onChange={(e) => setUsername(e.target.value)}
+            className="w-full border border-gray-300 rounded-md px-3 py-2"
+          />
+        </div>
+        {supported && (
+          <button
+            type="button"
+            disabled={busy || (signup && !username.trim())}
+            onClick={() => void submit(true)}
+            className="w-full rounded-md bg-gray-900 text-white py-3 px-4 font-medium disabled:opacity-50"
+          >
+            {busy
+              ? "Please wait…"
+              : signup
+                ? "Create account with a passkey"
+                : "Sign in with a passkey"}
+          </button>
+        )}
+        {!supported && (
+          <p className="text-xs text-gray-600">
+            Passkeys are unavailable in this browser or context. You can
+            continue with a password.
+          </p>
+        )}
+        <p className="text-xs text-center text-gray-500">
+          {supported ? "Or continue with a password" : "Password sign-in"}
+        </p>
+        <div>
+          <label htmlFor="password" className="block text-sm font-medium mb-1">
+            Password
+          </label>
+          <input
+            id="password"
+            name="password"
+            type="password"
+            autoComplete={signup ? "new-password" : "current-password"}
+            required
+            minLength={signup ? 8 : 1}
+            maxLength={256}
+            value={password}
+            onChange={(e) => setPassword(e.target.value)}
+            className="w-full border border-gray-300 rounded-md px-3 py-2"
+          />
+          {signup && (
+            <p className="text-xs text-gray-500 mt-1">
+              At least 8 characters and a number.
+            </p>
+          )}
+        </div>
+        <button
+          disabled={busy}
+          className="w-full border border-gray-300 rounded-md py-2 px-4 font-medium disabled:opacity-50"
+        >
+          {signup ? "Create account with a password" : "Sign in with password"}
+        </button>
+      </form>
+      <p className="mt-5 text-sm text-center">
+        <a
+          className="underline"
+          href={`${base}${signup ? "signin" : "signup"}`}
+        >
+          {signup
+            ? "Already have an account? Sign in"
+            : "New here? Create an account"}
+        </a>
+      </p>
+    </div>
+  );
+}
