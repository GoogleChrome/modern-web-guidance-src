index 0000000..cb264bb
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,112 @@
+import "webauthn-polyfills";
+export const base = import.meta.env.BASE_URL;
+export class ApiError extends Error {
+  constructor(
+    message: string,
+    public status: number,
+  ) {
+    super(message);
+  }
+}
+export async function api(
+  action: string,
+  body?: unknown,
+  signal?: AbortSignal,
+) {
+  const response = await fetch(`${base}api/auth/${action}`, {
+    method: body === undefined ? "GET" : "POST",
+    credentials: "same-origin",
+    headers: body === undefined ? {} : { "Content-Type": "application/json" },
+    body: body === undefined ? undefined : JSON.stringify(body),
+    signal,
+  });
+  const data = await response.json();
+  if (!response.ok)
+    throw new ApiError(data.error || "Request failed.", response.status);
+  return data;
+}
+export async function capabilities() {
+  if (!window.isSecureContext || !window.PublicKeyCredential) return null;
+  try {
+    return await PublicKeyCredential.getClientCapabilities();
+  } catch {
+    return null;
+  }
+}
+async function unknown(rpId: string, credentialId: string) {
+  try {
+    if (PublicKeyCredential.signalUnknownCredential)
+      await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+  } catch {
+    /* Optional password manager synchronization. */
+  }
+}
+export async function register(username?: string) {
+  const options = await api("register/options", { username });
+  const credential = (await navigator.credentials.create({
+    publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(options),
+  })) as PublicKeyCredential | null;
+  if (!credential) throw new Error("No passkey was created.");
+  try {
+    await api("register/verify", credential.toJSON());
+  } catch (error) {
+    await unknown(options.rp.id, credential.id);
+    throw error;
+  }
+}
+export async function authenticate(
+  purpose: "authenticate" | "reauth" = "authenticate",
+  signal?: AbortSignal,
+  conditional = false,
+) {
+  const options = await api(`${purpose}/options`, {}, signal);
+  const credential = (await navigator.credentials.get({
+    publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(options),
+    signal,
+    ...(conditional ? { mediation: "conditional" as const } : {}),
+  })) as PublicKeyCredential | null;
+  if (!credential) throw new Error("No passkey was selected.");
+  try {
+    await api(`${purpose}/verify`, credential.toJSON(), signal);
+  } catch (error) {
+    if (
+      purpose === "authenticate" &&
+      error instanceof ApiError &&
+      error.status === 404
+    )
+      await unknown(options.rpId, credential.id);
+    throw error;
+  }
+}
+export function message(error: unknown): string {
+  if (error instanceof DOMException) {
+    if (error.name === "NotAllowedError" || error.name === "AbortError")
+      return "Passkey request cancelled or timed out. You can try again.";
+    if (error.name === "InvalidStateError")
+      return "A passkey already exists in this password manager. Try another device or security key.";
+    if (error.name === "SecurityError")
+      return "Passkeys require HTTPS and a matching application domain.";
+  }
+  return error instanceof Error
+    ? error.message
+    : "Something went wrong. Please try again.";
+}
+export async function syncKeys(data: {
+  rpID: string;
+  user: { id: string };
+  passkeys: { id: string }[];
+}) {
+  try {
+    if (
+      window.PublicKeyCredential &&
+      typeof PublicKeyCredential.signalAllAcceptedCredentials === "function"
+    )
+      await PublicKeyCredential.signalAllAcceptedCredentials({
+        rpId: data.rpID,
+        userId: data.user.id,
+        allAcceptedCredentialIds: data.passkeys.map((key) => key.id),
+      });
+  } catch {
+    /* Progressive enhancement. */
+  }
+}
