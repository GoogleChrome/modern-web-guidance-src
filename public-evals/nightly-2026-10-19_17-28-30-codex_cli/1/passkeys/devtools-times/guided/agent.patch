--- /dev/null
+++ b/src/pages/api/auth/[...action].ts
@@ -0,0 +1,433 @@
+import type { APIContext, APIRoute } from "astro";
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from "@simplewebauthn/server";
+import {
+  db,
+  token,
+  userById,
+  userByName,
+  passkeys,
+  keyById,
+  hashPassword,
+  checkPassword,
+  saveKey,
+  type Session,
+  type User,
+  type Passkey,
+} from "../../../server/store";
+
+class HttpError extends Error {
+  constructor(
+    public status: number,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+function fail(status: number, message: string): never {
+  throw new HttpError(status, message);
+}
+const json = (data: unknown, status = 200) =>
+  new Response(JSON.stringify(data), {
+    status,
+    headers: {
+      "Content-Type": "application/json",
+      "Cache-Control": "no-store",
+    },
+  });
+export const ALL: APIRoute = async (ctx: APIContext) => {
+  try {
+    const { request, cookies, params } = ctx;
+    const origin =
+      process.env.AUTH_ORIGIN ||
+      (import.meta.env.DEV
+        ? ctx.url.origin
+        : "https://astro-news-pytrpecapa-uc.a.run.app");
+    const rpID = new URL(origin).hostname;
+    if (request.method !== "GET" && request.headers.get("origin") !== origin)
+      fail(403, "Request origin is not allowed.");
+    const cookieName = "times_auth";
+    const cookieOptions = {
+      path: import.meta.env.BASE_URL,
+      httpOnly: true,
+      secure: origin.startsWith("https:"),
+      sameSite: "lax" as const,
+      maxAge: 60 * 60 * 24 * 7,
+    };
+    let session = db
+      .prepare("SELECT * FROM sessions WHERE id=? AND expires>?")
+      .get(cookies.get(cookieName)?.value || "", Date.now()) as unknown as
+      Session | undefined;
+    const action = params.action;
+    if (!session) {
+      session = {
+        id: token(),
+        userId: null,
+        expires: Date.now() + 7 * 86400000,
+        verifiedAt: 0,
+      };
+      db.prepare("INSERT INTO sessions(id, expires) VALUES (?,?)").run(
+        session.id,
+        session.expires,
+      );
+      cookies.set(cookieName, session.id, cookieOptions);
+    }
+    const s = session;
+    let user = s.userId ? userById(s.userId) : undefined;
+    const requireUser = (): User =>
+      user || fail(401, "Please sign in to continue.");
+    const requireRecent = () => {
+      requireUser();
+      if (s.verifiedAt < Date.now() - 5 * 60000)
+        fail(403, "Verify your identity before making this change.");
+    };
+    const establish = (id: string) => {
+      db.prepare("DELETE FROM sessions WHERE id=?").run(s.id);
+      const next = token();
+      db.prepare(
+        "INSERT INTO sessions(id,userId,expires,verifiedAt) VALUES (?,?,?,?)",
+      ).run(next, id, Date.now() + 7 * 86400000, Date.now());
+      cookies.set(cookieName, next, cookieOptions);
+    };
+    if (request.method === "GET" && action === "session")
+      return json({
+        user: user
+          ? {
+              id: user.id,
+              username: user.username,
+              displayName: user.displayName,
+              hasPassword: !!user.password,
+            }
+          : null,
+        rpID,
+      });
+    if (request.method === "GET" && action === "passkeys") {
+      const u = requireUser();
+      return json({
+        user: {
+          id: u.id,
+          username: u.username,
+          displayName: u.displayName,
+          hasPassword: !!u.password,
+        },
+        rpID,
+        passkeys: passkeys(u.id).map(({ publicKey, counter, ...safe }) => safe),
+      });
+    }
+    if (request.method !== "POST") fail(405, "Method not allowed.");
+    // Bound request work and password guessing per browser session; use an edge/IP limiter in deployment as well.
+    const bucket = `${s.id}:${action}`;
+    db.prepare("DELETE FROM limits WHERE expires<?").run(Date.now());
+    db.prepare("DELETE FROM sessions WHERE expires<?").run(Date.now());
+    const ipBucket = `ip:${ctx.clientAddress}:${action}`;
+    db.prepare(
+      "INSERT INTO limits VALUES (?,1,?) ON CONFLICT(key) DO UPDATE SET count=count+1",
+    ).run(ipBucket, Date.now() + 60000);
+    if (
+      (db.prepare("SELECT count FROM limits WHERE key=?").get(ipBucket)!
+        .count as number) > 60
+    )
+      fail(429, "Too many attempts. Please wait a minute.");
+    db.prepare(
+      "INSERT INTO limits VALUES (?,1,?) ON CONFLICT(key) DO UPDATE SET count=count+1",
+    ).run(bucket, Date.now() + 60000);
+    if (
+      (db.prepare("SELECT count FROM limits WHERE key=?").get(bucket)!
+        .count as number) > 30
+    )
+      fail(429, "Too many attempts. Please wait a minute.");
+    if (Number(request.headers.get("content-length") || 0) > 65536)
+      fail(413, "Request too large.");
+    const text = await request.text();
+    if (text.length > 65536) fail(413, "Request too large.");
+    const body = JSON.parse(text || "{}");
+    const name = () => {
+      const n =
+        typeof body.username === "string"
+          ? body.username.trim().toLowerCase()
+          : "";
+      if (!/^[a-z0-9_.@+-]{3,100}$/.test(n))
+        fail(
+          400,
+          "Use a username of 3–100 letters, numbers, or . _ @ + - characters.",
+        );
+      return n;
+    };
+    if (action === "logout") {
+      db.prepare("DELETE FROM sessions WHERE id=?").run(s.id);
+      cookies.delete(cookieName, { path: cookieOptions.path });
+      return json({ ok: true });
+    }
+    if (
+      action === "password/register" ||
+      action === "password/login" ||
+      action === "password/reauth"
+    ) {
+      if (typeof body.password !== "string" || body.password.length > 256)
+        fail(400, "Enter a valid password.");
+      if (action === "password/register") {
+        const username = name();
+        if (body.password.length < 8 || !/\d/.test(body.password))
+          fail(400, "Password must have at least 8 characters and a number.");
+        if (userByName(username!)) fail(409, "That username is unavailable.");
+        const id = token();
+        db.prepare("INSERT INTO users VALUES (?,?,?,?)").run(
+          id,
+          username,
+          username,
+          hashPassword(body.password),
+        );
+        establish(id);
+      } else {
+        const target =
+          action === "password/reauth" ? requireUser() : userByName(name());
+        if (
+          !checkPassword(body.password, target?.password || null) ||
+          !target?.password
+        )
+          fail(401, "The username or password is incorrect.");
+        if (action === "password/reauth")
+          db.prepare("UPDATE sessions SET verifiedAt=? WHERE id=?").run(
+            Date.now(),
+            s.id,
+          );
+        else establish(target.id);
+      }
+      return json({ ok: true });
+    }
+    if (
+      action === "register/options" ||
+      action === "authenticate/options" ||
+      action === "reauth/options"
+    ) {
+      db.prepare("DELETE FROM challenges WHERE expires<?").run(Date.now());
+      const purpose = action.split("/")[0];
+      let id: string | null = null,
+        username: string | null = null;
+      let options;
+      const uv = purpose === "reauth" ? "required" : "preferred";
+      if (purpose === "register") {
+        if (user) {
+          requireRecent();
+          id = user.id;
+          username = user.username;
+        } else {
+          username = name();
+          if (userByName(username!)) fail(409, "That username is unavailable.");
+          id = token();
+        }
+        options = await generateRegistrationOptions({
+          rpName: "The DevTools Times",
+          rpID,
+          userID: Buffer.from(id!, "base64url"),
+          userName: username!,
+          attestationType: "none",
+          excludeCredentials: user
+            ? passkeys(user.id).map((k) => ({
+                id: k.id,
+                transports: k.transports,
+              }))
+            : [],
+          authenticatorSelection: {
+            residentKey: "required",
+            requireResidentKey: true,
+            userVerification: uv,
+          },
+        });
+      } else {
+        const keys = purpose === "reauth" ? passkeys(requireUser().id) : [];
+        if (purpose === "reauth" && !keys.length)
+          fail(
+            400,
+            "No passkeys registered. Verify with your password instead.",
+          );
+        id = purpose === "reauth" ? user!.id : null;
+        options = await generateAuthenticationOptions({
+          rpID,
+          allowCredentials: keys.map((k) => ({
+            id: k.id,
+            transports: k.transports,
+          })),
+          userVerification: uv,
+        });
+      }
+      db.prepare("INSERT INTO challenges VALUES (?,?,?,?,?,?,?)").run(
+        options.challenge,
+        s.id,
+        purpose,
+        id,
+        username,
+        Date.now() + 300000,
+        uv,
+      );
+      return json(options);
+    }
+    if (
+      action === "register/verify" ||
+      action === "authenticate/verify" ||
+      action === "reauth/verify"
+    ) {
+      const purpose = action.split("/")[0];
+      let client;
+      try {
+        client = JSON.parse(
+          Buffer.from(body.response.clientDataJSON, "base64url").toString(),
+        );
+      } catch {
+        fail(400, "Invalid credential response.");
+      }
+      const challenge = db
+        .prepare(
+          "DELETE FROM challenges WHERE challenge=? AND sessionId=? AND purpose=? RETURNING *",
+        )
+        .get(client.challenge, s.id, purpose);
+      if (!challenge || (challenge.expires as number) < Date.now())
+        fail(400, "This request expired. Please try again.");
+      if (purpose === "register") {
+        if (user) {
+          requireRecent();
+          if (challenge.userId !== user.id) fail(403, "Account mismatch.");
+        }
+        const result = await verifyRegistrationResponse({
+          response: body,
+          expectedChallenge: challenge.challenge as string,
+          expectedOrigin: origin,
+          expectedRPID: rpID,
+          requireUserVerification: challenge.uv === "required",
+        });
+        if (!result.verified || !result.registrationInfo)
+          fail(400, "Passkey could not be verified.");
+        const { credential, aaguid, credentialDeviceType, credentialBackedUp } =
+          result.registrationInfo;
+        const key: Passkey = {
+          id: credential.id,
+          userId: challenge.userId as string,
+          publicKey: Buffer.from(credential.publicKey).toString("base64url"),
+          counter: credential.counter,
+          transports: (credential.transports || []) as AuthenticatorTransport[],
+          aaguid,
+          deviceType: credentialDeviceType,
+          backedUp: credentialBackedUp,
+          registeredAt: Date.now(),
+          name: "My passkey",
+        };
+        db.exec("BEGIN IMMEDIATE");
+        try {
+          if (!user)
+            db.prepare("INSERT INTO users VALUES (?,?,?,NULL)").run(
+              key.userId,
+              challenge.username as string,
+              challenge.username as string,
+            );
+          db.prepare("INSERT INTO passkeys VALUES (?,?,?)").run(
+            key.id,
+            key.userId,
+            JSON.stringify(key),
+          );
+          db.exec("COMMIT");
+        } catch (e) {
+          db.exec("ROLLBACK");
+          throw e;
+        }
+        if (!user) establish(key.userId);
+      } else {
+        const key = keyById(body.id);
+        if (!key) fail(404, "Passkey not found. Use another sign-in method.");
+        if (
+          purpose === "reauth" &&
+          (key.userId !== requireUser().id || challenge.userId !== user!.id)
+        )
+          fail(403, "This passkey belongs to a different account.");
+        if (body.response.userHandle && body.response.userHandle !== key.userId)
+          fail(403, "Account mismatch.");
+        const result = await verifyAuthenticationResponse({
+          response: body,
+          expectedChallenge: challenge.challenge as string,
+          expectedOrigin: origin,
+          expectedRPID: rpID,
+          credential: {
+            id: key.id,
+            publicKey: Buffer.from(key.publicKey, "base64url"),
+            counter: key.counter,
+            transports: key.transports,
+          },
+          requireUserVerification: challenge.uv === "required",
+        });
+        if (!result.verified) fail(401, "Passkey verification failed.");
+        // Compare-and-swap prevents concurrent assertions from rolling the signature counter back.
+        const previous = JSON.stringify(key);
+        key.counter = result.authenticationInfo.newCounter;
+        key.lastUsedAt = Date.now();
+        key.backedUp = result.authenticationInfo.credentialBackedUp;
+        if (
+          !db
+            .prepare("UPDATE passkeys SET data=? WHERE id=? AND data=?")
+            .run(JSON.stringify(key), key.id, previous).changes
+        )
+          fail(409, "Passkey changed. Please try again.");
+        if (purpose === "reauth")
+          db.prepare("UPDATE sessions SET verifiedAt=? WHERE id=?").run(
+            Date.now(),
+            s.id,
+          );
+        else establish(key.userId);
+      }
+      return json({ ok: true });
+    }
+    if (action === "passkeys/rename" || action === "passkeys/delete") {
+      const u = requireUser();
+      requireRecent();
+      const key = keyById(body.id);
+      if (!key || key.userId !== u.id) fail(404, "Passkey not found.");
+      if (action.endsWith("rename")) {
+        if (
+          typeof body.name !== "string" ||
+          !body.name.trim() ||
+          body.name.length > 80
+        )
+          fail(400, "Use a passkey name of 1–80 characters.");
+        key.name = body.name.trim();
+        saveKey(key);
+      } else {
+        if (!u.password && passkeys(u.id).length <= 1)
+          fail(
+            409,
+            "Add another passkey before removing your last sign-in method.",
+          );
+        db.prepare("DELETE FROM passkeys WHERE id=?").run(key.id);
+      }
+      return json({ ok: true });
+    }
+    if (action === "profile") {
+      requireRecent();
+      const username = name();
+      if (
+        typeof body.displayName !== "string" ||
+        !body.displayName.trim() ||
+        body.displayName.length > 100
+      )
+        fail(400, "Enter a display name of 1–100 characters.");
+      if (userByName(username)?.id && userByName(username)!.id !== user!.id)
+        fail(409, "That username is unavailable.");
+      db.prepare("UPDATE users SET username=?,displayName=? WHERE id=?").run(
+        username,
+        body.displayName.trim(),
+        user!.id,
+      );
+      return json({ ok: true });
+    }
+    fail(404, "Endpoint not found.");
+  } catch (error) {
+    if (error instanceof HttpError)
+      return json({ error: error.message }, error.status);
+    console.error("Authentication request failed:", error);
+    return json(
+      { error: "The request could not be verified. Please try again." },
+      400,
+    );
+  }
+};
diff --git a/src/server/store.ts b/src/server/store.ts
new file mode 100644
index 0000000..c0515d8
--- /dev/null
+++ b/src/server/store.ts
@@ -0,0 +1,74 @@
+import { DatabaseSync } from "node:sqlite";
+import { mkdirSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { randomBytes, scryptSync, timingSafeEqual } from "node:crypto";
+
+const path = resolve(process.env.AUTH_DB_PATH || "./data/auth.sqlite");
+mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
+export const db = new DatabaseSync(path);
+db.exec(`PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;
+CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, username TEXT UNIQUE NOT NULL, displayName TEXT NOT NULL, password TEXT);
+CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, userId TEXT NOT NULL REFERENCES users(id), data TEXT NOT NULL);
+CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, userId TEXT REFERENCES users(id), expires INTEGER NOT NULL, verifiedAt INTEGER NOT NULL DEFAULT 0);
+CREATE TABLE IF NOT EXISTS challenges (challenge TEXT PRIMARY KEY, sessionId TEXT NOT NULL REFERENCES sessions(id) ON DELETE CASCADE, purpose TEXT NOT NULL, userId TEXT, username TEXT, expires INTEGER NOT NULL, uv TEXT NOT NULL);
+CREATE TABLE IF NOT EXISTS limits (key TEXT PRIMARY KEY, count INTEGER NOT NULL, expires INTEGER NOT NULL);`);
+export const token = () => randomBytes(32).toString("base64url");
+export interface User {
+  id: string;
+  username: string;
+  displayName: string;
+  password: string | null;
+}
+export interface Session {
+  id: string;
+  userId: string | null;
+  expires: number;
+  verifiedAt: number;
+}
+export interface Passkey {
+  id: string;
+  userId: string;
+  publicKey: string;
+  counter: number;
+  transports: AuthenticatorTransport[];
+  name: string;
+  aaguid: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+  deviceType: string;
+  backedUp: boolean;
+}
+export const userById = (id: string) =>
+  db.prepare("SELECT * FROM users WHERE id=?").get(id) as unknown as
+    User | undefined;
+export const userByName = (name: string) =>
+  db.prepare("SELECT * FROM users WHERE username=?").get(name) as unknown as
+    User | undefined;
+export const passkeys = (id: string): Passkey[] =>
+  db
+    .prepare("SELECT data FROM passkeys WHERE userId=?")
+    .all(id)
+    .map((row) => JSON.parse(row.data as string));
+export const keyById = (id: string): Passkey | undefined => {
+  const row = db.prepare("SELECT data FROM passkeys WHERE id=?").get(id);
+  return row ? JSON.parse(row.data as string) : undefined;
+};
+export function hashPassword(password: string) {
+  const salt = token();
+  return `${salt}:${scryptSync(password, salt, 64).toString("hex")}`;
+}
+export function checkPassword(password: string, hash: string | null) {
+  const [salt, expected] = (
+    hash || `${"0".repeat(43)}:${"0".repeat(128)}`
+  ).split(":");
+  return timingSafeEqual(
+    scryptSync(password, salt, 64),
+    Buffer.from(expected, "hex"),
+  );
+}
+export function saveKey(key: Passkey) {
+  db.prepare("UPDATE passkeys SET data=? WHERE id=?").run(
+    JSON.stringify(key),
+    key.id,
+  );
+}
diff --git a/tests/auth.test.mjs b/tests/auth.test.mjs
new file mode 100644
index 0000000..d8932c9
--- /dev/null
+++ b/tests/auth.test.mjs
@@ -0,0 +1,392 @@
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  createHash,
+  generateKeyPairSync,
+  randomBytes,
+  sign,
+} from "node:crypto";
+import { DatabaseSync } from "node:sqlite";
+import { isoCBOR } from "@simplewebauthn/server/helpers";
+const dir = mkdtempSync(join(tmpdir(), "times-auth-"));
+const origin = "http://localhost:14327";
+const path = join(dir, "auth.sqlite");
+let server;
+let db;
+let logs = "";
+function client() {
+  let cookie = "";
+  return {
+    async call(action, body, customOrigin = origin) {
+      const response = await fetch(
+        `${origin}/devtools-times/api/auth/${action}`,
+        {
+          method: body === undefined ? "GET" : "POST",
+          headers: {
+            cookie,
+            origin: customOrigin,
+            "Content-Type": "application/json",
+          },
+          body: body === undefined ? undefined : JSON.stringify(body),
+        },
+      );
+      const set = response.headers
+        .getSetCookie()
+        .find((value) => value.startsWith("times_auth="));
+      if (set) cookie = set.split(";")[0];
+      return { status: response.status, data: await response.json(), cookie };
+    },
+  };
+}
+function virtualKey() {
+  const id = randomBytes(32).toString("base64url");
+  const { privateKey, publicKey } = generateKeyPairSync("ec", {
+    namedCurve: "prime256v1",
+  });
+  const jwk = publicKey.export({ format: "jwk" });
+  const hash = (x) => createHash("sha256").update(x).digest();
+  const clientData = (options, type, override = {}) =>
+    Buffer.from(
+      JSON.stringify({
+        type,
+        challenge: options.challenge,
+        origin,
+        ...override,
+      }),
+    );
+  const rpHash = hash("localhost");
+  return {
+    id,
+    registration(options, override) {
+      const clientDataJSON = clientData(options, "webauthn.create", override);
+      const cose = isoCBOR.encode(
+        new Map([
+          [1, 2],
+          [3, -7],
+          [-1, 1],
+          [-2, Buffer.from(jwk.x, "base64url")],
+          [-3, Buffer.from(jwk.y, "base64url")],
+        ]),
+      );
+      const size = Buffer.alloc(2);
+      size.writeUInt16BE(Buffer.from(id, "base64url").length);
+      const authData = Buffer.concat([
+        rpHash,
+        Buffer.from([0x45]),
+        Buffer.alloc(4),
+        Buffer.alloc(16),
+        size,
+        Buffer.from(id, "base64url"),
+        cose,
+      ]);
+      const attestationObject = isoCBOR.encode(
+        new Map([
+          ["fmt", "none"],
+          ["attStmt", new Map()],
+          ["authData", authData],
+        ]),
+      );
+      return {
+        id,
+        rawId: id,
+        type: "public-key",
+        response: {
+          clientDataJSON: clientDataJSON.toString("base64url"),
+          attestationObject:
+            Buffer.from(attestationObject).toString("base64url"),
+          transports: ["internal"],
+        },
+        clientExtensionResults: {},
+      };
+    },
+    assertion(options, userHandle, count = 1, uv = true, override) {
+      const clientDataJSON = clientData(options, "webauthn.get", override);
+      const counter = Buffer.alloc(4);
+      counter.writeUInt32BE(count);
+      const authData = Buffer.concat([
+        rpHash,
+        Buffer.from([uv ? 5 : 1]),
+        counter,
+      ]);
+      const signature = sign(
+        "sha256",
+        Buffer.concat([authData, hash(clientDataJSON)]),
+        privateKey,
+      );
+      return {
+        id,
+        rawId: id,
+        type: "public-key",
+        response: {
+          clientDataJSON: clientDataJSON.toString("base64url"),
+          authenticatorData: authData.toString("base64url"),
+          signature: signature.toString("base64url"),
+          userHandle,
+        },
+        clientExtensionResults: {},
+      };
+    },
+  };
+}
+before(async () => {
+  server = spawn(process.execPath, ["dist/server/entry.mjs"], {
+    env: {
+      ...process.env,
+      AUTH_ORIGIN: origin,
+      AUTH_DB_PATH: path,
+      HOST: "127.0.0.1",
+      PORT: "14327",
+    },
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+  server.stdout.on("data", (d) => (logs += d));
+  server.stderr.on("data", (d) => (logs += d));
+  for (let i = 0; i < 100; i++) {
+    try {
+      await fetch(`${origin}/devtools-times/api/auth/session`);
+      db = new DatabaseSync(path);
+      return;
+    } catch {
+      await new Promise((resolve) => setTimeout(resolve, 100));
+    }
+  }
+  throw new Error(logs);
+});
+after(() => {
+  if (process.env.DEBUG_AUTH_TESTS) console.log(logs);
+  db?.close();
+  server?.kill();
+  rmSync(dir, { recursive: true, force: true });
+});
+test("passkey lifecycle, replay protection, ownership, step-up and lockout prevention", async () => {
+  const alice = client(),
+    bob = client(),
+    anonymous = client();
+  assert.equal((await anonymous.call("passkeys")).status, 401);
+  assert.equal(
+    (await anonymous.call("authenticate/options", {}, "https://evil.example"))
+      .status,
+    403,
+  );
+  const key = virtualKey();
+  const creation = await alice.call("register/options", { username: "alice" });
+  assert.equal(creation.status, 200);
+  assert.equal(creation.data.authenticatorSelection.residentKey, "required");
+  const registration = key.registration(creation.data);
+  assert.equal(
+    (await bob.call("register/verify", registration)).status,
+    400,
+    "challenge is session bound",
+  );
+  assert.equal((await alice.call("register/verify", registration)).status, 200);
+  assert.equal(
+    (await alice.call("register/verify", registration)).status,
+    400,
+    "registration replay rejected",
+  );
+  const account = (await alice.call("passkeys")).data;
+  assert.equal(account.passkeys.length, 1);
+  assert.equal(account.passkeys[0].publicKey, undefined);
+  assert.equal(
+    (await alice.call("passkeys/delete", { id: key.id })).status,
+    409,
+    "cannot delete last sign-in method",
+  );
+  const beforeLogin = (await anonymous.call("session")).cookie;
+  const options = (await anonymous.call("authenticate/options", {})).data;
+  assert.deepEqual(options.allowCredentials, []);
+  const assertion = key.assertion(options, account.user.id);
+  const signedIn = await anonymous.call("authenticate/verify", assertion);
+  assert.equal(signedIn.status, 200);
+  assert.notEqual(signedIn.cookie, beforeLogin, "session rotated");
+  assert.equal(
+    (await anonymous.call("authenticate/verify", assertion)).status,
+    400,
+  );
+  const tamperOptions = (await anonymous.call("authenticate/options", {})).data;
+  const tampered = key.assertion(tamperOptions, account.user.id, 2);
+  const signatureBytes = Buffer.from(tampered.response.signature, "base64url");
+  signatureBytes[signatureBytes.length - 1] ^= 1;
+  tampered.response.signature = signatureBytes.toString("base64url");
+  assert.equal(
+    (await anonymous.call("authenticate/verify", tampered)).status,
+    401,
+    "invalid signature rejected",
+  );
+  const login2 = (await anonymous.call("authenticate/options", {})).data;
+  assert.equal(
+    (
+      await anonymous.call(
+        "authenticate/verify",
+        key.assertion(login2, account.user.id, 1),
+      )
+    ).status,
+    400,
+    "counter replay rejected",
+  );
+  await bob.call("password/register", {
+    username: "bob",
+    password: "Password123",
+  });
+  assert.equal(
+    (await bob.call("passkeys/rename", { id: key.id, name: "Stolen" })).status,
+    404,
+  );
+  const bobKey = virtualKey();
+  const bobCreate = (await bob.call("register/options", {})).data;
+  assert.equal(
+    (await bob.call("register/verify", bobKey.registration(bobCreate))).status,
+    200,
+  );
+  const stepUp = (await bob.call("reauth/options", {})).data;
+  assert.deepEqual(
+    stepUp.allowCredentials.map((c) => c.id),
+    [bobKey.id],
+  );
+  assert.equal(stepUp.userVerification, "required");
+  assert.equal(
+    (await bob.call("reauth/verify", key.assertion(stepUp, account.user.id, 2)))
+      .status,
+    403,
+  );
+  const bobData = (await bob.call("passkeys")).data;
+  const noUV = (await bob.call("reauth/options", {})).data;
+  assert.equal(
+    (
+      await bob.call(
+        "reauth/verify",
+        bobKey.assertion(noUV, bobData.user.id, 1, false),
+      )
+    ).status,
+    400,
+  );
+  const proper = (await bob.call("reauth/options", {})).data;
+  assert.equal(
+    (await bob.call("reauth/verify", bobKey.assertion(proper, bobData.user.id)))
+      .status,
+    200,
+  );
+  db.prepare("UPDATE sessions SET verifiedAt=0 WHERE userId=?").run(
+    account.user.id,
+  );
+  assert.equal(
+    (await alice.call("passkeys/rename", { id: key.id, name: "Laptop" }))
+      .status,
+    403,
+  );
+  const reauth = (await alice.call("reauth/options", {})).data;
+  assert.equal(
+    (
+      await alice.call(
+        "reauth/verify",
+        key.assertion(reauth, account.user.id, 2),
+      )
+    ).status,
+    200,
+  );
+  assert.equal(
+    (await alice.call("passkeys/rename", { id: key.id, name: "Laptop" }))
+      .status,
+    200,
+  );
+  assert.equal(
+    (
+      await alice.call("profile", {
+        username: "alice-new",
+        displayName: "Alice",
+      })
+    ).status,
+    200,
+  );
+  const secondKey = virtualKey();
+  const second = (await alice.call("register/options", {})).data;
+  assert.deepEqual(
+    second.excludeCredentials.map((c) => c.id),
+    [key.id],
+  );
+  assert.equal(
+    (await alice.call("register/verify", secondKey.registration(second)))
+      .status,
+    200,
+  );
+  assert.equal(
+    (await alice.call("passkeys/delete", { id: key.id })).status,
+    200,
+  );
+  assert.equal((await alice.call("logout", {})).status, 200);
+  assert.equal((await alice.call("passkeys")).status, 401);
+  const old = (await alice.call("authenticate/options", {})).data;
+  assert.equal(
+    (
+      await alice.call(
+        "authenticate/verify",
+        key.assertion(old, account.user.id, 3),
+      )
+    ).status,
+    404,
+  );
+});
+test("expiry, origin verification, unknown credentials, and password session fallback", async () => {
+  const c = client();
+  const key = virtualKey();
+  const options = (await c.call("register/options", { username: "expired" }))
+    .data;
+  db.prepare("UPDATE challenges SET expires=0 WHERE challenge=?").run(
+    options.challenge,
+  );
+  assert.equal(
+    (await c.call("register/verify", key.registration(options))).status,
+    400,
+  );
+  const forged = (await c.call("register/options", { username: "forged" }))
+    .data;
+  assert.equal(
+    (
+      await c.call(
+        "register/verify",
+        key.registration(forged, { origin: "https://evil.example" }),
+      )
+    ).status,
+    400,
+  );
+  assert.equal(
+    (
+      await c.call("password/register", {
+        username: "password-user",
+        password: "Password123",
+      })
+    ).status,
+    200,
+  );
+  await c.call("logout", {});
+  assert.equal(
+    (
+      await c.call("password/login", {
+        username: "password-user",
+        password: "wrong",
+      })
+    ).status,
+    401,
+  );
+  assert.equal(
+    (
+      await c.call("password/login", {
+        username: "password-user",
+        password: "Password123",
+      })
+    ).status,
+    200,
+  );
+  assert.equal(
+    (await c.call("password/reauth", { password: "wrong" })).status,
+    401,
+  );
+  assert.equal(
+    (await c.call("password/reauth", { password: "Password123" })).status,
+    200,
+  );
+});
