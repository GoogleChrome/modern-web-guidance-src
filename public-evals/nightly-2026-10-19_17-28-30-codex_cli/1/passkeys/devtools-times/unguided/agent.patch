+import { useEffect, useState } from "react";
+import {
+  FingerPrintIcon,
+  ShieldCheckIcon,
+  KeyIcon,
+  PlusIcon,
+  ArrowUpRightIcon,
+  CheckIcon,
+  ComputerDesktopIcon,
+  LockClosedIcon,
+  XMarkIcon,
+  ArrowRightIcon,
+} from "@heroicons/react/24/outline";
+import {
+  authRequest,
+  authenticatePasskey,
+  registerPasskey,
+  friendlyError,
+  supportsPasskeys,
+  base,
