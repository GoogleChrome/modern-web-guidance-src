@@ -0,0 +1,55 @@
+import {
+  browserSupportsWebAuthn,
+  startRegistration,
+  startAuthentication,
+} from "@simplewebauthn/browser";
+export const base = import.meta.env.BASE_URL;
+export async function authRequest(action: string, body?: unknown) {
+  const response = await fetch(
+    `${base}api/auth/${action}`,
+    body === undefined
+      ? { cache: "no-store" }
+      : {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify(body),
+        },
+  );
+  const data = await response.json();
+  if (!response.ok)
+    throw new Error(data.error || "Something went wrong. Please try again.");
+  return data;
+}
+export function supportsPasskeys() {
+  return window.isSecureContext && browserSupportsWebAuthn();
+}
+export function friendlyError(error: unknown) {
+  if (
+    error instanceof Error &&
+    (error.name === "NotAllowedError" || error.name === "AbortError")
+  )
+    return "The passkey request was canceled or timed out. You can try again.";
+  if (error instanceof Error && error.name === "InvalidStateError")
+    return "This device already has a passkey for your account. Try another device or security key.";
+  return error instanceof Error
+    ? error.message
+    : "Something went wrong. Please try again.";
+}
+export async function registerPasskey(username?: string) {
+  const optionsJSON = await authRequest(
+    "passkeys/register/options",
+    username ? { signup: true, username } : {},
+  );
+  const credential = await startRegistration({ optionsJSON });
+  await authRequest("passkeys/register/verify", { credential });
+}
+export async function authenticatePasskey(reauthenticate = false) {
+  const optionsJSON = await authRequest("passkeys/authenticate/options", {
+    reauthenticate,
+  });
+  const credential = await startAuthentication({ optionsJSON });
+  await authRequest("passkeys/authenticate/verify", {
+    credential,
+    reauthenticate,
+  });
+}
diff --git a/src/lib/server/auth.ts b/src/lib/server/auth.ts
new file mode 100644
index 0000000..1037acc
--- /dev/null
+++ b/src/lib/server/auth.ts
@@ -0,0 +1,199 @@
+import { DatabaseSync } from "node:sqlite";
+import { mkdirSync } from "node:fs";
+import { dirname } from "node:path";
+import {
+  randomBytes,
+  randomUUID,
+  createHash,
+  scryptSync,
+  timingSafeEqual,
+} from "node:crypto";
+import type { APIContext } from "astro";
+
+const path = process.env.AUTH_DB_PATH || "./data/auth.sqlite";
+mkdirSync(dirname(path), { recursive: true });
+export const db = new DatabaseSync(path);
+db.exec(`PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;
+CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, username TEXT UNIQUE NOT NULL, password TEXT);
+CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id), public_key TEXT NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL, name TEXT NOT NULL, created INTEGER NOT NULL, last_used INTEGER, backed_up INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, user_id TEXT REFERENCES users(id), expires INTEGER NOT NULL, verified INTEGER NOT NULL DEFAULT 0);
+CREATE TABLE IF NOT EXISTS challenges (session_id TEXT PRIMARY KEY REFERENCES sessions(id) ON DELETE CASCADE, value TEXT NOT NULL, purpose TEXT NOT NULL, user_id TEXT, username TEXT, expires INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS attempts (key TEXT PRIMARY KEY, count INTEGER NOT NULL, expires INTEGER NOT NULL);`);
+export type User = { id: string; username: string; password: string | null };
+export type Session = {
+  id: string;
+  user_id: string | null;
+  expires: number;
+  verified: number;
+};
+export type Passkey = {
+  id: string;
+  user_id: string;
+  public_key: string;
+  counter: number;
+  transports: string;
+  name: string;
+  created: number;
+  last_used: number | null;
+  backed_up: number;
+};
+export class AuthError extends Error {
+  constructor(
+    message: string,
+    public status = 400,
+  ) {
+    super(message);
+  }
+}
+export const hashToken = (value: string) =>
+  createHash("sha256").update(value).digest("hex");
+export const userById = (id: string) =>
+  db.prepare("SELECT * FROM users WHERE id=?").get(id) as User | undefined;
+export const userByName = (name: string) =>
+  db.prepare("SELECT * FROM users WHERE username=?").get(name) as
+    | User
+    | undefined;
+export const keysFor = (id: string) =>
+  db
+    .prepare("SELECT * FROM passkeys WHERE user_id=? ORDER BY created DESC")
+    .all(id) as Passkey[];
+export function username(value: unknown) {
+  if (
+    typeof value !== "string" ||
+    !/^[a-zA-Z0-9_.@+-]{3,80}$/.test(value.trim())
+  )
+    throw new AuthError(
+      "Use a username with 3–80 letters, numbers, or . _ @ + - characters.",
+    );
+  return value.trim().toLowerCase();
+}
+export function passwordHash(value: unknown) {
+  if (
+    typeof value !== "string" ||
+    value.length < 8 ||
+    value.length > 256 ||
+    !/\d/.test(value)
+  )
+    throw new AuthError(
+      "Use a password with 8–256 characters and at least one number.",
+    );
+  const salt = randomBytes(16).toString("hex");
+  return salt + ":" + scryptSync(value, salt, 64).toString("hex");
+}
+const dummyHash = passwordHash("dummy-password-123");
+export function passwordMatches(
+  value: unknown,
+  hash: string | null | undefined,
+) {
+  if (typeof value !== "string" || value.length > 256) return false;
+  const [salt, key] = (hash || dummyHash).split(":");
+  return (
+    timingSafeEqual(scryptSync(value, salt, 64), Buffer.from(key, "hex")) &&
+    !!hash
+  );
+}
+export function getSession(
+  ctx: Pick<APIContext, "cookies">,
+): Session | undefined {
+  const token = ctx.cookies.get("times_auth")?.value;
+  return token
+    ? (db
+        .prepare("SELECT * FROM sessions WHERE id=? AND expires>?")
+        .get(hashToken(token), Date.now()) as Session | undefined)
+    : undefined;
+}
+export function newSession(
+  ctx: APIContext,
+  userId: string | null,
+  verified = false,
+) {
+  const old = getSession(ctx);
+  if (old) db.prepare("DELETE FROM sessions WHERE id=?").run(old.id);
+  const token = randomBytes(32).toString("base64url");
+  const id = hashToken(token);
+  const expires = Date.now() + 7 * 86400000;
+  db.prepare("INSERT INTO sessions VALUES (?,?,?,?)").run(
+    id,
+    userId,
+    expires,
+    verified ? Date.now() : 0,
+  );
+  ctx.cookies.set("times_auth", token, {
+    httpOnly: true,
+    secure:
+      new URL(process.env.AUTH_ORIGIN || ctx.url.origin).protocol === "https:",
+    sameSite: "lax",
+    path: import.meta.env.BASE_URL,
+    maxAge: 7 * 86400,
+  });
+  return { id, user_id: userId, expires, verified: verified ? Date.now() : 0 };
+}
+export function requireUser(ctx: APIContext) {
+  const session = getSession(ctx);
+  const user = session?.user_id ? userById(session.user_id) : undefined;
+  if (!user || !session)
+    throw new AuthError("Please sign in to continue.", 401);
+  return { session, user };
+}
+export function requireRecent(session: Session) {
+  if (Date.now() - session.verified > 5 * 60000)
+    throw new AuthError("Verify your identity to continue.", 403);
+}
+export function config(ctx: Pick<APIContext, "url">) {
+  const origin = process.env.AUTH_ORIGIN || ctx.url.origin;
+  const rpID = new URL(origin).hostname;
+  if (
+    new URL(origin).protocol !== "https:" &&
+    !["localhost", "127.0.0.1", "[::1]"].includes(rpID)
+  )
+    throw new AuthError("Passkeys require a secure HTTPS connection.");
+  return { origin, rpID };
+}
+export function saveChallenge(
+  session: Session,
+  value: string,
+  purpose: string,
+  userId?: string,
+  name?: string,
+) {
+  db.prepare("INSERT OR REPLACE INTO challenges VALUES (?,?,?,?,?,?)").run(
+    session.id,
+    value,
+    purpose,
+    userId || null,
+    name || null,
+    Date.now() + 300000,
+  );
+}
+export function consumeChallenge(session: Session, purpose: string) {
+  const row = db
+    .prepare("DELETE FROM challenges WHERE session_id=? RETURNING *")
+    .get(session.id) as
+    | {
+        value: string;
+        purpose: string;
+        user_id: string | null;
+        username: string | null;
+        expires: number;
+      }
+    | undefined;
+  if (!row || row.purpose !== purpose || row.expires < Date.now())
+    throw new AuthError("This request expired. Please try again.");
+  return row;
+}
+export function rateLimit(key: string) {
+  const now = Date.now();
+  db.prepare("DELETE FROM sessions WHERE expires<?").run(now);
+  db.prepare("DELETE FROM attempts WHERE expires<?").run(now);
+  const row = db
+    .prepare(
+      "INSERT INTO attempts VALUES (?,1,?) ON CONFLICT(key) DO UPDATE SET count=count+1 RETURNING count",
+    )
+    .get(key, now + 600000) as { count: number };
+  if (row.count > 40)
+    throw new AuthError(
+      "Too many attempts. Please try again in 10 minutes.",
+      429,
+    );
+}
+export { randomUUID };
