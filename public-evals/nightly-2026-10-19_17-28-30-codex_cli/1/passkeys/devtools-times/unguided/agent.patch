diff --git a/tests/auth.test.mjs b/tests/auth.test.mjs
new file mode 100644
index 0000000..ac8d9b6
--- /dev/null
+++ b/tests/auth.test.mjs
@@ -0,0 +1,375 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { DatabaseSync } from "node:sqlite";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  createHash,
+  generateKeyPairSync,
+  randomBytes,
+  sign,
+} from "node:crypto";
+import { isoCBOR } from "@simplewebauthn/server/helpers";
+
+const directory = mkdtempSync(join(tmpdir(), "times-auth-"));
+const port = 19000 + Math.floor(Math.random() * 1000);
+const origin = `http://localhost:${port}`;
+const base = `${origin}/devtools-times/`;
+const server = spawn(process.execPath, ["dist/server/entry.mjs"], {
+  env: {
+    ...process.env,
+    HOST: "127.0.0.1",
+    PORT: String(port),
+    AUTH_DB_PATH: join(directory, "auth.sqlite"),
+    AUTH_ORIGIN: origin,
+  },
+  stdio: "pipe",
+});
+let output = "";
+server.stderr.on("data", (data) => (output += data));
+server.stdout.on("data", (data) => (output += data));
+const hash = (value) => createHash("sha256").update(value).digest();
+const b64 = (value) => Buffer.from(value).toString("base64url");
+function client() {
+  let cookie = "";
+  return async (action, body, customOrigin = origin) => {
+    const response = await fetch(`${base}api/auth/${action}`, {
+      method: body === undefined ? "GET" : "POST",
+      headers: {
+        cookie,
+        origin: customOrigin,
+        "content-type": "application/json",
+      },
+      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+    });
+    const setCookie = response.headers
+      .getSetCookie()
+      .find((value) => value.startsWith("times_auth="));
+    if (setCookie) cookie = setCookie.split(";")[0];
+    return { status: response.status, data: await response.json() };
+  };
+}
+function authenticator() {
+  const { privateKey, publicKey } = generateKeyPairSync("ec", {
+    namedCurve: "prime256v1",
+  });
+  const jwk = publicKey.export({ format: "jwk" });
+  const id = randomBytes(32);
+  let handle;
+  function clientData(type, challenge, requestOrigin = origin) {
+    return Buffer.from(
+      JSON.stringify({
+        type,
+        challenge,
+        origin: requestOrigin,
+        crossOrigin: false,
+      }),
+    );
+  }
+  return {
+    id: b64(id),
+    register(options) {
+      handle = options.user.id;
+      const cose = isoCBOR.encode(
+        new Map([
+          [1, 2],
+          [3, -7],
+          [-1, 1],
+          [-2, Buffer.from(jwk.x, "base64url")],
+          [-3, Buffer.from(jwk.y, "base64url")],
+        ]),
+      );
+      const length = Buffer.alloc(2);
+      length.writeUInt16BE(id.length);
+      const authData = Buffer.concat([
+        hash("localhost"),
+        Buffer.from([0x45]),
+        Buffer.alloc(4),
+        Buffer.alloc(16),
+        length,
+        id,
+        cose,
+      ]);
+      const attestation = isoCBOR.encode(
+        new Map([
+          ["fmt", "none"],
+          ["attStmt", new Map()],
+          ["authData", authData],
+        ]),
+      );
+      return {
+        id: b64(id),
+        rawId: b64(id),
+        type: "public-key",
+        clientExtensionResults: {},
+        response: {
+          clientDataJSON: b64(clientData("webauthn.create", options.challenge)),
+          attestationObject: b64(attestation),
+          transports: ["internal"],
+        },
+      };
+    },
+    authenticate(options, counter = 1, requestOrigin = origin, flags = 5) {
+      const count = Buffer.alloc(4);
+      count.writeUInt32BE(counter);
+      const authData = Buffer.concat([
+        hash("localhost"),
+        Buffer.from([flags]),
+        count,
+      ]);
+      const data = clientData("webauthn.get", options.challenge, requestOrigin);
+      return {
+        id: b64(id),
+        rawId: b64(id),
+        type: "public-key",
+        clientExtensionResults: {},
+        response: {
+          clientDataJSON: b64(data),
+          authenticatorData: b64(authData),
+          signature: b64(
+            sign("sha256", Buffer.concat([authData, hash(data)]), privateKey),
+          ),
+          userHandle: handle,
+        },
+      };
+    },
+  };
+}
+
+test("passkey account lifecycle and security boundaries", async (t) => {
+  t.after(() => {
+    server.kill();
+    rmSync(directory, { recursive: true, force: true });
+  });
+  let ready = false;
+  for (let i = 0; i < 100; i++) {
+    try {
+      const response = await fetch(`${base}api/auth/session`);
+      if (response.ok) {
+        ready = true;
+        break;
+      }
+    } catch {}
+    await new Promise((resolve) => setTimeout(resolve, 100));
+  }
+  assert.ok(ready, output);
+  const fixture = new DatabaseSync(join(directory, "auth.sqlite"));
+  t.after(() => fixture.close());
+  const owner = client(),
+    stranger = client();
+  const first = authenticator(),
+    second = authenticator();
+  assert.equal(
+    (
+      await owner(
+        "passkeys/register/options",
+        { signup: true, username: "reader" },
+        "https://attacker.test",
+      )
+    ).status,
+    403,
+  );
+  const registration = await owner("passkeys/register/options", {
+    signup: true,
+    username: "reader",
+  });
+  assert.equal(registration.status, 200);
+  const credential = first.register(registration.data);
+  assert.equal(
+    (await stranger("passkeys/register/verify", { credential })).status,
+    401,
+  );
+  assert.equal(
+    (await owner("passkeys/register/verify", { credential })).status,
+    200,
+  );
+  assert.equal(
+    (await owner("passkeys/register/verify", { credential })).status,
+    400,
+    "registration challenge cannot be reused",
+  );
+  let account = (await owner("session")).data;
+  assert.equal(account.user.username, "reader");
+  assert.equal(account.passkeys.length, 1);
+  assert.equal(
+    (await owner("passkeys/delete", { id: first.id })).status,
+    400,
+    "last passkey cannot be removed without fallback",
+  );
+  assert.equal(
+    (await owner("passkeys/rename", { id: first.id, name: "My laptop" }))
+      .status,
+    200,
+  );
+  const extra = await owner("passkeys/register/options", {});
+  assert.equal(
+    (
+      await owner("passkeys/register/verify", {
+        credential: second.register(extra.data),
+      })
+    ).status,
+    200,
+  );
+  assert.equal((await owner("logout", {})).status, 200);
+  assert.equal((await owner("session")).data.user, null);
+  const login = await owner("passkeys/authenticate/options", {});
+  const assertion = first.authenticate(login.data);
+  assert.equal(
+    (await owner("passkeys/authenticate/verify", { credential: assertion }))
+      .status,
+    200,
+  );
+  assert.equal(
+    (await owner("passkeys/authenticate/verify", { credential: assertion }))
+      .status,
+    400,
+    "assertion cannot be replayed",
+  );
+  const reauth = await owner("passkeys/authenticate/options", {
+    reauthenticate: true,
+  });
+  assert.equal(
+    (
+      await owner("passkeys/authenticate/verify", {
+        credential: first.authenticate(reauth.data, 2),
+        reauthenticate: true,
+      })
+    ).status,
+    200,
+  );
+  const staleCounter = await owner("passkeys/authenticate/options", {
+    reauthenticate: true,
+  });
+  assert.equal(
+    (
+      await owner("passkeys/authenticate/verify", {
+        credential: first.authenticate(staleCounter.data, 2),
+        reauthenticate: true,
+      })
+    ).status,
+    400,
+    "a non-increasing signature counter is rejected",
+  );
+  const forged = await owner("passkeys/authenticate/options", {
+    reauthenticate: true,
+  });
+  const invalidSignature = first.authenticate(forged.data, 3);
+  invalidSignature.response.signature = b64(randomBytes(64));
+  assert.equal(
+    (
+      await owner("passkeys/authenticate/verify", {
+        credential: invalidSignature,
+        reauthenticate: true,
+      })
+    ).status,
+    400,
+    "invalid signatures are rejected",
+  );
+  const malicious = await owner("passkeys/authenticate/options", {
+    reauthenticate: true,
+  });
+  assert.equal(
+    (
+      await owner("passkeys/authenticate/verify", {
+        credential: first.authenticate(
+          malicious.data,
+          3,
+          "https://attacker.test",
+        ),
+        reauthenticate: true,
+      })
+    ).status,
+    400,
+    "signed wrong-origin assertions are rejected",
+  );
+  const noUV = await owner("passkeys/authenticate/options", {
+    reauthenticate: true,
+  });
+  assert.equal(
+    (
+      await owner("passkeys/authenticate/verify", {
+        credential: first.authenticate(noUV.data, 3, origin, 1),
+        reauthenticate: true,
+      })
+    ).status,
+    400,
+    "user verification is required",
+  );
+  assert.equal(
+    (
+      await stranger("register", {
+        username: "another",
+        password: "Password123",
+      })
+    ).status,
+    200,
+  );
+  assert.equal(
+    (await stranger("passkeys/rename", { id: first.id, name: "Stolen" }))
+      .status,
+    404,
+  );
+  const foreign = await stranger("passkeys/authenticate/options", {
+    reauthenticate: true,
+  });
+  assert.equal(
+    foreign.status,
+    400,
+    "password-only user cannot reauthenticate using another account’s key",
+  );
+  assert.equal(
+    (await stranger("password/reauthenticate", { password: "wrong" })).status,
+    401,
+  );
+  assert.equal(
+    (await stranger("password/reauthenticate", { password: "Password123" }))
+      .status,
+    200,
+  );
+  assert.equal((await owner("passkeys/delete", { id: second.id })).status, 200);
+  account = (await owner("session")).data;
+  assert.equal(account.passkeys[0].name, "My laptop");
+  assert.ok(account.passkeys[0].lastUsed);
+  await owner("logout", {});
+  const removed = await owner("passkeys/authenticate/options", {});
+  assert.equal(
+    (
+      await owner("passkeys/authenticate/verify", {
+        credential: second.authenticate(removed.data),
+      })
+    ).status,
+    401,
+    "removed passkeys cannot authenticate",
+  );
+  fixture.prepare("DELETE FROM attempts").run();
+  fixture
+    .prepare(
+      "UPDATE sessions SET verified=0 WHERE user_id=(SELECT id FROM users WHERE username=?)",
+    )
+    .run("another");
+  assert.equal(
+    (await stranger("passkeys/register/options", {})).status,
+    403,
+    "expired identity verification blocks enrollment",
+  );
+  assert.equal(
+    (await stranger("password/reauthenticate", { password: "Password123" }))
+      .status,
+    200,
+  );
+  assert.equal((await stranger("passkeys/register/options", {})).status, 200);
+  fixture.prepare("UPDATE challenges SET expires=0").run();
+  assert.equal(
+    (await stranger("passkeys/register/verify", { credential: {} })).status,
+    400,
+    "expired challenges are rejected",
+  );
+  assert.equal((await stranger("logout", {})).status, 200);
+  assert.equal(
+    (await stranger("login", { username: "another", password: "Password123" }))
+      .status,
+    200,
+  );
+});
