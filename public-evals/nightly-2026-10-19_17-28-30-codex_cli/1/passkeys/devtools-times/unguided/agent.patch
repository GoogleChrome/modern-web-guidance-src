+
+type Key = {
+  id: string;
+  name: string;
+  created: number;
+  lastUsed: number | null;
+  backedUp: boolean;
+};
+type Account = {
+  user: { username: string; hasPassword: boolean };
+  recent: boolean;
+  passkeys: Key[];
+};
+export default function AccountSecurity() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [supported, setSupported] = useState(false);
+  const [modal, setModal] = useState<"verify" | "rename" | "delete" | null>(
+    null,
+  );
+  const [selected, setSelected] = useState<Key | null>(null);
+  const [name, setName] = useState("");
+  const [password, setPassword] = useState("");
+  const [pending, setPending] = useState<(() => Promise<void>) | null>(null);
+  async function load() {
+    const data = await authRequest("session");
+    if (!data.user) {
+      window.location.assign(`${base}signin`);
+      return;
+    }
+    setAccount(data);
+    return data as Account;
+  }
+  useEffect(() => {
+    setSupported(supportsPasskeys());
+    void load().catch((e) => setError(friendlyError(e)));
+  }, []);
+  useEffect(() => {
+    if (!modal) return;
+    const previous = document.activeElement as HTMLElement | null;
+    const dialog = document.querySelector<HTMLElement>('[role="dialog"]');
+    dialog
+      ?.querySelector<HTMLElement>("input, button:not(.modal-close)")
+      ?.focus();
+    const handler = (e: KeyboardEvent) => {
+      if (e.key === "Escape" && !dialog?.querySelector("button:disabled"))
+        setModal(null);
+      if (e.key !== "Tab") return;
+      const elements = dialog?.querySelectorAll<HTMLElement>(
+        "button:not(:disabled), input:not(:disabled)",
+      );
+      if (!elements?.length) {
+        e.preventDefault();
+        return;
+      }
+      const first = elements[0],
+        last = elements[elements.length - 1];
+      if (e.shiftKey && document.activeElement === first) {
+        e.preventDefault();
+        last.focus();
+      } else if (!e.shiftKey && document.activeElement === last) {
+        e.preventDefault();
+        first.focus();
+      }
+    };
+    document.addEventListener("keydown", handler);
+    return () => {
+      document.removeEventListener("keydown", handler);
+      previous?.focus();
+    };
+  }, [modal]);
+  async function run(fn: () => Promise<void>) {
+    setError("");
+    setNotice("");
+    setBusy(true);
+    try {
+      await fn();
+    } catch (e) {
+      setError(friendlyError(e));
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function withVerification(fn: () => Promise<void>) {
+    const data = await load();
+    if (!data?.recent) {
+      setPending(() => fn);
+      setPassword("");
+      setModal("verify");
+    } else await fn();
+  }
+  async function add() {
+    await registerPasskey();
+    await load();
+    setNotice(
+      "Your passkey is ready. You can use it the next time you sign in.",
+    );
+  }
+  async function verify(method: "passkey" | "password") {
+    if (method === "passkey") await authenticatePasskey(true);
+    else await authRequest("password/reauthenticate", { password });
+    setPassword("");
+    setModal(null);
+    await load();
+    if (pending) {
+      const fn = pending;
+      setPending(null);
+      await fn();
+    } else
+      setNotice("Identity verified. You can now make changes to your account.");
+  }
+  const date = (timestamp: number) =>
+    new Date(timestamp).toLocaleDateString("en-US", {
+      month: "short",
+      day: "numeric",
+      year: "numeric",
+    });
+  return (
+    <div className="account-shell">
+      <div className="account-breadcrumb">
+        <a href={base}>Home</a>
+        <span>/</span>
+        <span>Your account</span>
+        <span>/</span>
+        <strong>Security</strong>
+      </div>
+      <div className="account-heading">
+        <div>
+          <span className="security-eyebrow">YOUR ACCOUNT</span>
+          <h1>A little peace of mind.</h1>
+          <p>Manage how you sign in and keep your account secure.</p>
+        </div>
+        <div className="account-badge">
+          <ShieldCheckIcon width={16} /> Account security
+        </div>
+      </div>
+      <div className="account-layout">
+        <aside className="account-sidebar">
+          <p>ACCOUNT SETTINGS</p>
+          <a
+            className="active"
+            href={`${base}account/security`}
+            aria-current="page"
+          >
+            <ShieldCheckIcon width={18} />
+            Sign-in & security
+            <ArrowRightIcon width={15} />
+          </a>
+          <div className="sidebar-account">
+            <div className="account-avatar">
+              {account?.user.username.slice(0, 1).toUpperCase() || "…"}
+            </div>
+            <div>
+              <strong>{account?.user.username || "Your account"}</strong>
+              <span>DevTools Times reader</span>
+            </div>
+          </div>
+          <button
+            disabled={busy}
+            onClick={() =>
+              void run(async () => {
+                await authRequest("logout", {});
+                window.location.assign(base);
+              })
+            }
+          >
+            Sign out <ArrowUpRightIcon width={14} />
+          </button>
+        </aside>
+        <div className="account-main">
+          {error && (
+            <div className="security-message error" role="alert">
+              {error}
+            </div>
+          )}
+          {notice && (
+            <div className="security-message success" role="status">
+              <CheckIcon width={18} />
+              {notice}
+            </div>
+          )}
+          <section className="passkey-hero">
+            <div className="hero-copy">
+              <span className="hero-label">
+                <span /> A SMARTER WAY TO SIGN IN
+              </span>
+              <h2>
+                Less to remember.
+                <br />
+                More peace of mind.
+              </h2>
+              <p>
+                Meet passkeys. A simpler, safer way to sign in with your
+                fingerprint, face, or device screen lock.
+              </p>
+              <div className="hero-pills">
+                <span>
+                  <CheckIcon width={13} /> No passwords
+                </span>
+                <span>
+                  <CheckIcon width={13} /> Built-in protection
+                </span>
+              </div>
+            </div>
+            <div className="fingerprint-art" aria-hidden="true">
+              <div className="fingerprint-ring">
+                <FingerPrintIcon strokeWidth={1} />
+                <span>
+                  <CheckIcon width={18} strokeWidth={3} />
+                </span>
+              </div>
+              <div className="art-caption">
+                <LockClosedIcon width={11} /> MADE FOR YOUR EYES ONLY
+              </div>
+            </div>
+          </section>
+          <section className="security-card">
+            <div className="security-card-heading">
+              <div className="card-title">
+                <div className="card-icon">
+                  <KeyIcon width={22} />
+                </div>
+                <div>
+                  <h2>
+                    Your passkeys{" "}
+                    <span className="count">
+                      {account?.passkeys.length ?? 0}
+                    </span>
+                  </h2>
+                  <p>A secure sign-in, without the password.</p>
+                </div>
+              </div>
+              <button
+                className="security-primary small"
+                disabled={busy || !supported || !account}
+                onClick={() => void run(() => withVerification(add))}
+              >
+                <PlusIcon width={16} /> Add a passkey
+              </button>
+            </div>
+            {!account ? (
+              <div className="passkey-empty" role="status">
+                Loading your account…
+              </div>
+            ) : !account.passkeys.length ? (
+              <div className="passkey-empty">
+                <div className="empty-icon">
+                  <FingerPrintIcon width={33} strokeWidth={1.3} />
+                </div>
+                <h3>Your next sign-in can be simpler.</h3>
+                <p>
+                  Add your first passkey to sign in with a glance or a touch.
+                  <br />
+                  Your biometric data stays on your device.
+                </p>
+                <button
+                  className="text-action"
+                  disabled={busy || !supported}
+                  onClick={() => void run(() => withVerification(add))}
+                >
+                  Create your first passkey <ArrowRightIcon width={16} />
+                </button>
+              </div>
+            ) : (
+              <div className="passkey-list">
+                {account.passkeys.map((key) => (
+                  <div className="passkey-row" key={key.id}>
+                    <div className="device-icon">
+                      <ComputerDesktopIcon width={23} />
+                    </div>
+                    <div className="passkey-details">
+                      <h3>
+                        {key.name}
+                        <span>
+                          <CheckIcon width={11} /> Ready to use
+                        </span>
+                      </h3>
+                      <p>
+                        Added {date(key.created)} ·{" "}
+                        {key.lastUsed
+                          ? `Last used ${date(key.lastUsed)}`
+                          : "Not used yet"}
+                      </p>
+                      <p>
+                        {key.backedUp
+                          ? "Backed up by your passkey provider"
+                          : "Stored on your device or security key"}
+                      </p>
+                    </div>
+                    <div className="key-actions">
+                      <button
+                        disabled={busy}
+                        onClick={() => {
+                          setSelected(key);
+                          setName(key.name);
+                          setError("");
+                          setModal("rename");
+                        }}
+                      >
+                        Rename
+                      </button>
+                      <button
+                        className="remove"
+                        disabled={
+                          busy ||
+                          (!account.user.hasPassword &&
+                            account.passkeys.length === 1)
+                        }
+                        onClick={() => {
+                          setSelected(key);
+                          setError("");
+                          setModal("delete");
+                        }}
+                      >
+                        Remove
+                      </button>
+                    </div>
+                  </div>
+                ))}
+              </div>
+            )}
+            <div className="card-footnote">
+              <LockClosedIcon width={14} />
+              <span>
+                {!supported
+                  ? "Passkeys require a supported browser and HTTPS (or localhost)."
+                  : account && !account.user.hasPassword
+                    ? "Keep at least one passkey on your account so you can always sign in."
+                    : "You can still use your password. Add more than one passkey for extra flexibility."}
+              </span>
+            </div>
+          </section>
+          <div className="security-benefits">
+            <div>
+              <ShieldCheckIcon width={22} />
+              <h3>Security comes standard</h3>
+              <p>
+                Passkeys help protect you from phishing and stolen passwords.
+              </p>
+            </div>
+            <div>
+              <FingerPrintIcon width={22} />
+              <h3>Uniquely yours</h3>
+              <p>
+                Your fingerprint or face unlocks your passkey. It’s never shared
+                with us.
+              </p>
+            </div>
+            <div>
+              <ComputerDesktopIcon width={22} />
+              <h3>At home on your devices</h3>
+              <p>
+                Use your phone, computer, or a physical security key to sign in.
+              </p>
+            </div>
+          </div>
+          <section className="security-card verify-card">
+            <div className="card-title">
+              <div className="card-icon">
+                <ShieldCheckIcon width={22} />
+              </div>
+              <div>
+                <h2>Identity verification</h2>
+                <p>An extra check for changes that matter.</p>
+              </div>
+            </div>
+            <p>
+              Before you change your sign-in methods, we may ask you to verify
+              it’s really you.
+            </p>
+            <button
+              className="security-secondary compact"
+              disabled={busy || !account}
+              onClick={() => {
+                setPending(null);
+                setPassword("");
+                setError("");
+                setModal("verify");
+              }}
+            >
+              Verify your identity <ArrowRightIcon width={15} />
+            </button>
+          </section>
+          <p className="security-bottom">
+            <LockClosedIcon width={13} /> Good journalism. A secure account. One
+            less thing to worry about.
+          </p>
+        </div>
+      </div>
+      {modal && (
+        <div className="security-modal-backdrop">
+          <div
+            className="security-modal"
+            role="dialog"
+            aria-modal="true"
+            aria-labelledby="dialog-title"
+          >
+            <button
+              className="modal-close"
+              aria-label="Close dialog"
+              disabled={busy}
+              onClick={() => setModal(null)}
+            >
+              <XMarkIcon width={21} />
+            </button>
+            <div className="auth-symbol">
+              <ShieldCheckIcon width={27} />
+            </div>
+            <h2 id="dialog-title">
+              {modal === "verify"
+                ? "Let’s make sure it’s you."
+                : modal === "rename"
+                  ? "Name this passkey"
+                  : "Remove this passkey?"}
+            </h2>
+            {error && (
+              <div className="security-message error" role="alert">
+                {error}
+              </div>
+            )}
+            {modal === "verify" ? (
+              <>
+                <p>
+                  Verify your identity to manage your sign-in methods.
+                  Verification lasts for five minutes.
+                </p>
+                {!!account?.passkeys.length && (
+                  <button
+                    autoFocus
+                    className="security-primary"
+                    disabled={busy || !supported}
+                    onClick={() => void run(() => verify("passkey"))}
+                  >
+                    <FingerPrintIcon width={19} />
+                    {busy ? "Verifying…" : "Verify with a passkey"}
+                  </button>
+                )}
+                {account?.user.hasPassword && (
+                  <form
+                    onSubmit={(e) => {
+                      e.preventDefault();
+                      void run(() => verify("password"));
+                    }}
+                  >
+                    <label htmlFor="verify-password">
+                      {account.passkeys.length
+                        ? "Or use your password"
+                        : "Your password"}
+                    </label>
+                    <input
+                      id="verify-password"
+                      type="password"
+                      autoComplete="current-password"
+                      autoFocus={!account.passkeys.length}
+                      value={password}
+                      onChange={(e) => setPassword(e.target.value)}
+                      required
+                      maxLength={256}
+                    />
+                    <button className="security-secondary" disabled={busy}>
+                      Verify with password
+                    </button>
+                  </form>
+                )}
+              </>
+            ) : modal === "rename" ? (
+              <form
+                onSubmit={(e) => {
+                  e.preventDefault();
+                  void run(async () => {
+                    setModal(null);
+                    await withVerification(async () => {
+                      await authRequest("passkeys/rename", {
+                        id: selected!.id,
+                        name,
+                      });
+                      await load();
+                      setNotice("Passkey renamed.");
+                    });
+                  });
+                }}
+              >
+                <p>Choose a name that helps you recognize this device.</p>
+                <label htmlFor="passkey-name">Passkey name</label>
+                <input
+                  autoFocus
+                  id="passkey-name"
+                  value={name}
+                  onChange={(e) => setName(e.target.value)}
+                  required
+                  maxLength={60}
+                />
+                <button className="security-primary" disabled={busy}>
+                  Save name
+                </button>
+              </form>
+            ) : (
+              <>
+                <p>
+                  You’ll no longer be able to sign in with “{selected?.name}”.
+                  You can add it again at any time.
+                </p>
+                <button
+                  autoFocus
+                  className="security-danger"
+                  disabled={busy}
+                  onClick={() =>
+                    void run(async () => {
+                      setModal(null);
+                      await withVerification(async () => {
+                        await authRequest("passkeys/delete", {
+                          id: selected!.id,
+                        });
+                        await load();
+                        setNotice("Passkey removed from your account.");
+                      });
+                    })
+                  }
+                >
+                  Remove passkey
+                </button>
+                <button
+                  className="security-secondary"
+                  disabled={busy}
+                  onClick={() => setModal(null)}
+                >
+                  Keep passkey
+                </button>
+              </>
+            )}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
