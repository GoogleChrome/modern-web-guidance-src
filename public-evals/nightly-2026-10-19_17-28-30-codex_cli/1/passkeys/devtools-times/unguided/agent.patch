diff --git a/src/pages/api/auth/[...action].ts b/src/pages/api/auth/[...action].ts
new file mode 100644
index 0000000..e1e5bbc
--- /dev/null
+++ b/src/pages/api/auth/[...action].ts
@@ -0,0 +1,325 @@
+import type { APIRoute } from "astro";
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from "@simplewebauthn/server";
+import {
+  AuthError,
+  db,
+  username,
+  passwordHash,
+  passwordMatches,
+  getSession,
+  newSession,
+  requireUser,
+  requireRecent,
+  config,
+  saveChallenge,
+  consumeChallenge,
+  keysFor,
+  userByName,
+  userById,
+  randomUUID,
+  rateLimit,
+  type Passkey,
+} from "../../../lib/server/auth";
+
+const json = (data: unknown, status = 200) =>
+  new Response(JSON.stringify(data), {
+    status,
+    headers: {
+      "Content-Type": "application/json",
+      "Cache-Control": "no-store",
+    },
+  });
+export const ALL: APIRoute = async (ctx) => {
+  try {
+    const action = ctx.params.action;
+    if (ctx.request.method === "GET" && action === "session") {
+      const session = getSession(ctx);
+      const user = session?.user_id ? userById(session.user_id) : undefined;
+      return json(
+        user
+          ? {
+              user: { username: user.username, hasPassword: !!user.password },
+              recent: Date.now() - session!.verified < 300000,
+              passkeys: keysFor(user.id).map(
+                ({ id, name, created, last_used, backed_up }) => ({
+                  id,
+                  name,
+                  created,
+                  lastUsed: last_used,
+                  backedUp: !!backed_up,
+                }),
+              ),
+            }
+          : { user: null },
+      );
+    }
+    if (ctx.request.method !== "POST")
+      return json({ error: "Method not allowed." }, 405);
+    const { origin, rpID } = config(ctx);
+    if (
+      ctx.request.headers.get("origin") !== origin ||
+      ctx.request.headers.get("content-type")?.split(";")[0] !==
+        "application/json"
+    )
+      throw new AuthError("Invalid request origin.", 403);
+    if (Number(ctx.request.headers.get("content-length")) > 65536)
+      throw new AuthError("Request too large.", 413);
+    rateLimit(ctx.clientAddress);
+    const raw = await ctx.request.text();
+    if (raw.length > 65536) throw new AuthError("Request too large.", 413);
+    const body = JSON.parse(raw);
+    if (!body || typeof body !== "object" || Array.isArray(body))
+      throw new AuthError("Invalid request.");
+    if (action === "register" || action === "login") {
+      const name = username(body.username);
+      const existing = userByName(name);
+      if (action === "register") {
+        const hash = passwordHash(body.password);
+        if (existing) throw new AuthError("This username is unavailable.", 409);
+        const id = randomUUID();
+        db.prepare("INSERT INTO users VALUES (?,?,?)").run(id, name, hash);
+        newSession(ctx, id, true);
+      } else {
+        if (!passwordMatches(body.password, existing?.password))
+          throw new AuthError("Incorrect username or password.", 401);
+        newSession(ctx, existing!.id, true);
+      }
+      return json({ ok: true });
+    }
+    if (action === "logout") {
+      const session = getSession(ctx);
+      if (session)
+        db.prepare("DELETE FROM sessions WHERE id=?").run(session.id);
+      ctx.cookies.delete("times_auth", { path: import.meta.env.BASE_URL });
+      return json({ ok: true });
+    }
+    if (action === "password/reauthenticate") {
+      const { user, session } = requireUser(ctx);
+      if (!passwordMatches(body.password, user.password))
+        throw new AuthError("Incorrect password.", 401);
+      db.prepare("UPDATE sessions SET verified=? WHERE id=?").run(
+        Date.now(),
+        session.id,
+      );
+      return json({ ok: true });
+    }
+    if (action === "passkeys/register/options") {
+      let session = getSession(ctx);
+      let userId: string, name: string;
+      if (body.signup) {
+        if (session?.user_id)
+          throw new AuthError("Sign out before creating another account.");
+        name = username(body.username);
+        if (userByName(name))
+          throw new AuthError("This username is unavailable.", 409);
+        userId = randomUUID();
+      } else {
+        const auth = requireUser(ctx);
+        requireRecent(auth.session);
+        session = auth.session;
+        userId = auth.user.id;
+        name = auth.user.username;
+      }
+      session ||= newSession(ctx, null);
+      const options = await generateRegistrationOptions({
+        rpName: "The DevTools Times",
+        rpID,
+        userID: new TextEncoder().encode(userId),
+        userName: name,
+        userDisplayName: name,
+        attestationType: "none",
+        supportedAlgorithmIDs: [-7, -257],
+        excludeCredentials: keysFor(userId).map((k) => ({
+          id: k.id,
+          transports: JSON.parse(k.transports),
+        })),
+        authenticatorSelection: {
+          residentKey: "required",
+          userVerification: "required",
+        },
+      });
+      saveChallenge(session, options.challenge, "register", userId, name);
+      return json(options);
+    }
+    if (action === "passkeys/register/verify") {
+      const session = getSession(ctx);
+      if (!session)
+        throw new AuthError("Please start registration again.", 401);
+      const challenge = consumeChallenge(session, "register");
+      if (session.user_id) {
+        requireRecent(session);
+        if (session.user_id !== challenge.user_id)
+          throw new AuthError("Invalid account.", 403);
+      }
+      const result = await verifyRegistrationResponse({
+        response: body.credential,
+        expectedChallenge: challenge.value,
+        expectedOrigin: origin,
+        expectedRPID: rpID,
+        requireUserVerification: true,
+        supportedAlgorithmIDs: [-7, -257],
+      });
+      if (!result.verified)
+        throw new AuthError("Could not verify this passkey.");
+      const { credential, credentialBackedUp } = result.registrationInfo;
+      db.exec("BEGIN IMMEDIATE");
+      try {
+        if (!session.user_id) {
+          if (userByName(challenge.username!))
+            throw new AuthError("This username is unavailable.", 409);
+          db.prepare("INSERT INTO users VALUES (?,?,NULL)").run(
+            challenge.user_id,
+            challenge.username,
+          );
+        }
+        db.prepare("INSERT INTO passkeys VALUES (?,?,?,?,?,?,?,NULL,?)").run(
+          credential.id,
+          challenge.user_id,
+          Buffer.from(credential.publicKey).toString("base64url"),
+          credential.counter,
+          JSON.stringify(credential.transports || []),
+          "My passkey",
+          Date.now(),
+          Number(credentialBackedUp),
+        );
+        db.exec("COMMIT");
+      } catch (error) {
+        db.exec("ROLLBACK");
+        throw error;
+      }
+      if (!session.user_id) newSession(ctx, challenge.user_id, true);
+      return json({ ok: true });
+    }
+    if (action === "passkeys/authenticate/options") {
+      const reauth = body.reauthenticate === true;
+      const auth = reauth ? requireUser(ctx) : null;
+      const session = auth?.session || getSession(ctx) || newSession(ctx, null);
+      const keys = auth ? keysFor(auth.user.id) : [];
+      if (auth && !keys.length)
+        throw new AuthError(
+          "No passkeys are available. Verify with your password.",
+        );
+      const options = await generateAuthenticationOptions({
+        rpID,
+        userVerification: "required",
+        ...(auth
+          ? {
+              allowCredentials: keys.map((k) => ({
+                id: k.id,
+                transports: JSON.parse(k.transports),
+              })),
+            }
+          : {}),
+      });
+      saveChallenge(
+        session,
+        options.challenge,
+        reauth ? "reauthenticate" : "authenticate",
+        auth?.user.id,
+      );
+      return json(options);
+    }
+    if (action === "passkeys/authenticate/verify") {
+      const session = getSession(ctx);
+      if (!session) throw new AuthError("Please start sign-in again.", 401);
+      const reauth = body.reauthenticate === true;
+      const challenge = consumeChallenge(
+        session,
+        reauth ? "reauthenticate" : "authenticate",
+      );
+      const key = db
+        .prepare("SELECT * FROM passkeys WHERE id=?")
+        .get(body.credential?.id || "") as Passkey | undefined;
+      if (
+        !key ||
+        (reauth &&
+          (key.user_id !== session.user_id ||
+            key.user_id !== challenge.user_id))
+      )
+        throw new AuthError("Could not verify this passkey.", 401);
+      if (
+        body.credential.response?.userHandle &&
+        body.credential.response.userHandle !==
+          Buffer.from(key.user_id).toString("base64url")
+      )
+        throw new AuthError("Invalid account.", 401);
+      const result = await verifyAuthenticationResponse({
+        response: body.credential,
+        expectedChallenge: challenge.value,
+        expectedOrigin: origin,
+        expectedRPID: rpID,
+        credential: {
+          id: key.id,
+          publicKey: Buffer.from(key.public_key, "base64url"),
+          counter: key.counter,
+          transports: JSON.parse(key.transports),
+        },
+        requireUserVerification: true,
+      });
+      if (!result.verified)
+        throw new AuthError("Could not verify this passkey.", 401);
+      const updated = db
+        .prepare(
+          "UPDATE passkeys SET counter=?, last_used=?, backed_up=? WHERE id=? AND counter=?",
+        )
+        .run(
+          result.authenticationInfo.newCounter,
+          Date.now(),
+          Number(result.authenticationInfo.credentialBackedUp),
+          key.id,
+          key.counter,
+        );
+      if (!updated.changes)
+        throw new AuthError("Passkey changed. Please try again.");
+      if (reauth)
+        db.prepare("UPDATE sessions SET verified=? WHERE id=?").run(
+          Date.now(),
+          session.id,
+        );
+      else newSession(ctx, key.user_id, true);
+      return json({ ok: true });
+    }
+    if (action === "passkeys/rename" || action === "passkeys/delete") {
+      const { user, session } = requireUser(ctx);
+      requireRecent(session);
+      const key = keysFor(user.id).find((k) => k.id === body.id);
+      if (!key) throw new AuthError("Passkey not found.", 404);
+      if (action.endsWith("delete")) {
+        if (!user.password && keysFor(user.id).length <= 1)
+          throw new AuthError(
+            "Add another passkey before removing your only sign-in method.",
+          );
+        db.prepare("DELETE FROM passkeys WHERE id=? AND user_id=?").run(
+          key.id,
+          user.id,
+        );
+      } else {
+        if (
+          typeof body.name !== "string" ||
+          !body.name.trim() ||
+          body.name.trim().length > 60
+        )
+          throw new AuthError("Use a passkey name with 1–60 characters.");
+        db.prepare("UPDATE passkeys SET name=? WHERE id=? AND user_id=?").run(
+          body.name.trim(),
+          key.id,
+          user.id,
+        );
+      }
+      return json({ ok: true });
+    }
+    return json({ error: "Not found." }, 404);
+  } catch (error) {
+    if (error instanceof AuthError)
+      return json({ error: error.message }, error.status);
+    return json(
+      { error: "Unable to complete this request. Please try again." },
+      400,
+    );
+  }
+};
