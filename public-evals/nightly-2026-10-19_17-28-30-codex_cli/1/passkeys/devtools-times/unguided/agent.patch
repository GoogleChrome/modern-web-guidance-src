@@ -0,0 +1,138 @@
+import { useEffect, useState } from "react";
+import {
+  FingerPrintIcon,
+  ArrowRightIcon,
+  LockClosedIcon,
+} from "@heroicons/react/24/outline";
+import {
+  authenticatePasskey,
+  registerPasskey,
+  authRequest,
+  friendlyError,
+  supportsPasskeys,
+  base,
+} from "../lib/auth-client";
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState("");
+  const [busy, setBusy] = useState("");
+  const [supported, setSupported] = useState(false);
+  useEffect(() => setSupported(supportsPasskeys()), []);
+  async function submit(method: "password" | "passkey") {
+    setError("");
+    setBusy(method);
+    try {
+      if (method === "passkey") {
+        if (signup) {
+          if (!username.trim())
+            throw new Error("Enter a username to create your account.");
+          await registerPasskey(username);
+        } else await authenticatePasskey();
+      } else
+        await authRequest(signup ? "register" : "login", {
+          username,
+          password,
+        });
+      window.location.assign(`${base}account/security`);
+    } catch (e) {
+      setError(friendlyError(e));
+    } finally {
+      setBusy("");
+    }
+  }
+  return (
+    <div className="auth-panel">
+      <div className="auth-symbol">
+        <FingerPrintIcon width={30} />
+      </div>
+      <span className="security-eyebrow">YOUR DEVTOOLS TIMES ACCOUNT</span>
+      <h1>{signup ? "A better way to stay informed." : "Welcome back."}</h1>
+      <p className="auth-intro">
+        {signup
+          ? "Create your account and make room for a new perspective."
+          : "Your next perspective is waiting. Sign in to continue."}
+      </p>
+      {error && (
+        <div className="security-message error" role="alert">
+          {error}
+        </div>
+      )}
+      <form
+        onSubmit={(e) => {
+          e.preventDefault();
+          void submit("password");
+        }}
+      >
+        <label htmlFor="username">Username</label>
+        <input
+          id="username"
+          autoComplete="username webauthn"
+          value={username}
+          onChange={(e) => setUsername(e.target.value)}
+          required
+          minLength={3}
+          maxLength={80}
+          placeholder="Your username"
+        />
+        <button
+          type="button"
+          className="security-primary"
+          disabled={!!busy || !supported}
+          onClick={() => void submit("passkey")}
+        >
+          <FingerPrintIcon width={20} />
+          {busy === "passkey"
+            ? "Waiting for your device…"
+            : signup
+              ? "Create account with a passkey"
+              : "Sign in with a passkey"}
+          <ArrowRightIcon width={17} />
+        </button>
+        <p className="auth-passkey-hint">
+          {supported
+            ? "Use your fingerprint, face, screen lock, or security key."
+            : "Passkeys need a supported browser and a secure connection."}
+        </p>
+        <div className="auth-divider">
+          <span>or continue with a password</span>
+        </div>
+        <label htmlFor="password">Password</label>
+        <input
+          id="password"
+          type="password"
+          autoComplete={signup ? "new-password" : "current-password"}
+          value={password}
+          onChange={(e) => setPassword(e.target.value)}
+          required
+          minLength={signup ? 8 : undefined}
+          maxLength={256}
+          placeholder={signup ? "Create a password" : "Your password"}
+        />
+        {signup && (
+          <p className="auth-passkey-hint">
+            At least 8 characters, including a number.
+          </p>
+        )}
+        <button type="submit" className="security-secondary" disabled={!!busy}>
+          {busy === "password"
+            ? "Please wait…"
+            : signup
+              ? "Create account with password"
+              : "Sign in with password"}
+        </button>
+      </form>
+      <p className="auth-switch">
+        {signup ? "Already a reader?" : "New to The DevTools Times?"}{" "}
+        <a href={`${base}${signup ? "signin" : "signup"}`}>
+          {signup ? "Sign in" : "Create an account"}{" "}
+          <span aria-hidden="true">↗</span>
+        </a>
+      </p>
+      <div className="auth-secure">
+        <LockClosedIcon width={13} /> Your account, securely in your hands.
+      </div>
+    </div>
+  );
+}
