+import { startRegistration, startAuthentication, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+const $ = selector => document.querySelector(selector);
+const icon = name => `<svg aria-hidden="true"><use href="#i-${name}"/></svg>`;
+const escape = value => String(value).replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
+let state = { csrf: '', user: null, passkeys: [], activity: [] };
+let noticeTimer;
+function notice(message, error = false) {
+  clearTimeout(noticeTimer);
+  $('#toast').textContent = message;
+  $('#toast').classList.toggle('error', error);
+  $('#toast').hidden = false;
+  noticeTimer = setTimeout(() => { $('#toast').hidden = true; }, 5500);
+}
+async function api(path, body, method = 'POST') {
+  const response = await fetch(`/api${path}`, { method, headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': state.csrf }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
+  const result = await response.json();
+  if (!response.ok) throw Object.assign(new Error(result.error || 'Something went wrong. Please try again.'), { code: result.code, status: response.status });
+  if (result.csrf) state.csrf = result.csrf;
+  return result;
+}
+const formatDate = value => value ? new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(value)) : 'Not used yet';
+async function refresh() {
+  state = await api('/session', undefined, 'GET');
+  $('#profile-name').textContent = state.user?.name || 'Your daily space';
+  $('#avatar').firstChild.textContent = state.user ? state.user.name.split(/\s+/).map(s => s[0]).slice(0, 2).join('').toUpperCase() : 'DG';
+  $('#sidebar-auth span').textContent = state.user ? 'Sign out' : 'Sign in to your account';
+  $('#account-nav span').textContent = state.user ? state.user.name.split(' ')[0] : 'My account';
+  $('#account-email').innerHTML = state.user ? `${escape(state.user.email)}<br>Your account updates arrive here.` : 'One place for your account updates.<br>Sign in to view your email address.';
+  $('#change-password').innerHTML = `${state.user ? 'Change password' : 'Manage password'} ${icon('arrow')}`;
+  $('#password-status').textContent = state.user ? 'PASSWORD SET' : 'FALLBACK SIGN-IN';
+  if (state.passkeys.length) {
+    $('#passkey-list').innerHTML = state.passkeys.map(key => `<div class="passkey-row"><span class="icon-box">${icon(key.device_type === 'multiDevice' ? 'key' : 'device')}</span><div><h3>${escape(key.name)}</h3><p>${key.backed_up ? 'Synced passkey' : 'Device passkey'} · Added ${formatDate(key.created)}</p><p>Last used: ${formatDate(key.last_used)}</p></div><div class="row-actions"><button class="icon-button" data-rename="${escape(key.id)}" aria-label="Rename ${escape(key.name)}">${icon('edit')}</button><button class="icon-button" data-remove="${escape(key.id)}" aria-label="Remove ${escape(key.name)}">${icon('trash')}</button></div></div>`).join('');
+    document.querySelectorAll('[data-rename]').forEach(btn => btn.onclick = () => renamePasskey(btn.dataset.rename));
+    document.querySelectorAll('[data-remove]').forEach(btn => btn.onclick = () => removePasskey(btn.dataset.remove));
+  } else {
+    $('#passkey-list').innerHTML = `<div class="empty-state"><span class="empty-icon">${icon('device')}<span>${icon('plus')}</span></span><div><h3>A safer sign-in is one step away</h3><p>Add a passkey to sign in with your fingerprint, face, or device PIN.</p></div></div>`;
+  }
+  $('#activity-list').innerHTML = state.activity.length ? state.activity.map(item => `<div class="activity-row"><span class="icon-box">${icon('clock')}</span><div><h3>${escape(item.title)}</h3><p>${escape(new Date(item.created).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }))}</p></div></div>`).join('') : `<div class="no-activity">${state.user ? 'Your account activity will appear here as you use your account.' : 'Sign in to see your recent account activity.'}</div>`;
+}
+function showModal(html) {
+  $('#modal-content').innerHTML = html;
+  $('#modal').setAttribute('aria-labelledby', 'modal-title');
+  if (!$('#modal').open) $('#modal').showModal();
+}
+const closeModal = () => $('#modal').close();
+$('#close-modal').onclick = closeModal;
+$('#modal').addEventListener('click', event => { if (event.target === $('#modal')) { const box = $('#modal').getBoundingClientRect(); if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) closeModal(); } });
+const modalHead = (symbol, title, description) => `<div class="modal-symbol">${icon(symbol)}</div><h2 id="modal-title">${title}</h2>${description ? `<p>${description}</p>` : ''}`;
+const errorSlot = '<div class="form-error" id="form-error" role="alert"></div>';
+function friendlyError(error) {
+  if (error.name === 'NotAllowedError' || error.code === 'ERROR_PASSTHROUGH_SEE_CAUSE_PROPERTY' || error.code === 'ERROR_CEREMONY_ABORTED') return 'The passkey request was cancelled or timed out. You can try again whenever you’re ready.';
+  if (error.name === 'InvalidStateError') return 'This device already has a passkey for your account. Try another device or sign in with your existing passkey.';
+  if (error.name === 'SecurityError') return 'Passkeys need a secure connection. Use HTTPS, or localhost for development.';
+  return error.message || 'Something went wrong. Please try again.';
+}
+function bindForm(handler) {
+  $('#modal-form').onsubmit = async event => {
+    event.preventDefault();
+    const button = event.submitter;
+    button.disabled = true;
+    const oldText = button.innerHTML;
+    button.textContent = 'One moment…';
+    $('#form-error').textContent = '';
