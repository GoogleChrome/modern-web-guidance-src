+  const fresh = (req, _res, next) => Date.now() - req.session.verified < 5 * 60000 ? next() : next(fail('Please verify your identity to continue.', 403, 'REAUTH_REQUIRED'));
+  const limits = new Map();
+  const rateLimit = (req, _res, next) => {
+    const now = Date.now();
+    for (const [key, item] of limits) if (item.until < now) limits.delete(key);
+    const key = req.ip;
+    const item = limits.get(key) || { count: 0, until: now + 15 * 60000 };
+    limits.set(key, item);
+    if (++item.count > 60) return next(fail('Too many attempts. Please try again in 15 minutes.', 429));
+    next();
+  };
+  const record = (id, title) => db.prepare('INSERT INTO activity (user_id, title, created) VALUES (?, ?, ?)').run(id, title, new Date().toISOString());
+  function login(req, res, id) {
+    db.prepare('DELETE FROM sessions WHERE id = ?').run(req.session.id);
+    const cookie = token();
+    const session = { id: hash(cookie), csrf: token(), user_id: id, verified: Date.now(), expires: Date.now() + 7 * 86400000 };
+    db.prepare('INSERT INTO sessions (id, csrf, user_id, verified, expires) VALUES (?, ?, ?, ?, ?)').run(session.id, session.csrf, id, session.verified, session.expires);
+    res.cookie('dg_session', cookie, { httpOnly: true, sameSite: 'lax', secure: req.rp.origin.startsWith('https:'), path: '/', maxAge: 7 * 86400000 });
+    res.json({ ok: true, csrf: session.csrf });
+  }
+  function setChallenge(req, challenge, type) {
+    db.prepare('UPDATE sessions SET challenge = ? WHERE id = ?').run(JSON.stringify({ challenge, type, expires: Date.now() + 300000 }), req.session.id);
+  }
+  function consumeChallenge(req, type) {
+    const current = db.prepare('SELECT challenge FROM sessions WHERE id = ?').get(req.session.id);
+    db.prepare('UPDATE sessions SET challenge = NULL WHERE id = ?').run(req.session.id);
+    const value = JSON.parse(current?.challenge || 'null');
+    if (!value || value.type !== type || value.expires < Date.now()) throw fail('This request has expired. Please try again.');
+    return value.challenge;
+  }
+  app.get('/api/session', (req, res) => {
+    const user = req.session.user_id && db.prepare('SELECT id, name, email FROM users WHERE id = ?').get(req.session.user_id);
+    const passkeys = user ? db.prepare('SELECT id, name, device_type, backed_up, created, last_used FROM passkeys WHERE user_id = ? ORDER BY created').all(user.id) : [];
+    const activity = user ? db.prepare('SELECT title, created FROM activity WHERE user_id = ? ORDER BY id DESC LIMIT 15').all(user.id) : [];
+    res.json({ user: user || null, csrf: req.session.csrf, passkeys, activity, verifiedAt: req.session.verified });
+  });
+  app.post('/api/register', rateLimit, (req, res) => {
+    const { name, email, password } = req.body;
+    if (typeof name !== 'string' || !name.trim() || name.length > 80 || typeof email !== 'string' || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || email.length > 254 || typeof password !== 'string' || password.length < 12 || password.length > 128) throw fail('Enter your name, a valid email, and a password of 12–128 characters.');
+    const id = randomUUID();
+    try { db.prepare('INSERT INTO users VALUES (?, ?, ?, ?)').run(id, email.trim().toLowerCase(), name.trim(), passwordHash(password)); }
+    catch (error) { if (error.code === 'ERR_SQLITE_ERROR' && error.message.includes('UNIQUE')) throw fail('An account already exists with this email. Please sign in.'); throw error; }
+    record(id, 'Account created');
+    login(req, res, id);
+  });
+  app.post('/api/login', rateLimit, (req, res) => {
+    const { email, password } = req.body;
+    if (typeof email !== 'string' || typeof password !== 'string' || password.length > 128) throw fail('Enter your email and password.');
+    const user = db.prepare('SELECT * FROM users WHERE email = ?').get(email.trim().toLowerCase());
+    const valid = checkPassword(password, user?.password || passwordHash('unused-account-placeholder'));
+    if (!user || !valid) throw fail('The email or password is incorrect.', 401);
+    record(user.id, 'Signed in with password');
+    login(req, res, user.id);
+  });
+  app.post('/api/logout', (req, res) => {
+    db.prepare('DELETE FROM sessions WHERE id = ?').run(req.session.id);
+    res.clearCookie('dg_session', { path: '/' });
+    res.json({ ok: true });
+  });
+  app.post('/api/reauth/password', signedIn, rateLimit, (req, res) => {
+    const user = db.prepare('SELECT password FROM users WHERE id = ?').get(req.session.user_id);
+    if (typeof req.body.password !== 'string' || req.body.password.length > 128 || !checkPassword(req.body.password, user.password)) throw fail('That password is incorrect.', 401);
+    db.prepare('UPDATE sessions SET verified = ? WHERE id = ?').run(Date.now(), req.session.id);
+    res.json({ ok: true });
+  });
+  app.post('/api/passkeys/register/options', signedIn, fresh, rateLimit, async (req, res) => {
+    const user = db.prepare('SELECT * FROM users WHERE id = ?').get(req.session.user_id);
+    const keys = db.prepare('SELECT id, transports FROM passkeys WHERE user_id = ?').all(user.id);
+    const options = await generateRegistrationOptions({ rpName: 'The Daily Grind', rpID: req.rp.id, userID: Buffer.from(user.id), userName: user.email, userDisplayName: user.name, attestationType: 'none', excludeCredentials: keys.map(k => ({ id: k.id, transports: JSON.parse(k.transports) })), authenticatorSelection: { residentKey: 'required', userVerification: 'required' } });
+    setChallenge(req, options.challenge, 'register');
+    res.json(options);
+  });
+  app.post('/api/passkeys/register/verify', signedIn, fresh, async (req, res) => {
+    const challenge = consumeChallenge(req, 'register');
+    const result = await verifyRegistrationResponse({ response: req.body.credential, expectedChallenge: challenge, expectedOrigin: req.rp.origin, expectedRPID: req.rp.id, requireUserVerification: true });
+    if (!result.verified) throw fail('We couldn’t verify this passkey. Please try again.');
+    const { credential, credentialDeviceType, credentialBackedUp } = result.registrationInfo;
+    const name = typeof req.body.name === 'string' ? req.body.name.trim().slice(0, 60) : 'My passkey';
+    db.prepare('INSERT INTO passkeys VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, NULL)').run(credential.id, req.session.user_id, name || 'My passkey', Buffer.from(credential.publicKey), credential.counter, JSON.stringify(credential.transports || []), credentialDeviceType, Number(credentialBackedUp), new Date().toISOString());
+    record(req.session.user_id, 'Passkey added');
+    res.json({ ok: true });
+  });
+  app.post('/api/passkeys/auth/options', rateLimit, async (req, res) => {
+    const reauth = req.body.reauth === true;
+    if (reauth && !req.session.user_id) throw fail('Sign in to continue.', 401);
+    const keys = reauth ? db.prepare('SELECT id, transports FROM passkeys WHERE user_id = ?').all(req.session.user_id) : [];
+    if (reauth && !keys.length) throw fail('Use your password to verify your identity.');
+    const options = await generateAuthenticationOptions({ rpID: req.rp.id, userVerification: 'required', allowCredentials: keys.map(k => ({ id: k.id, transports: JSON.parse(k.transports) })) });
+    setChallenge(req, options.challenge, reauth ? 'reauth' : 'login');
+    res.json(options);
+  });
+  app.post('/api/passkeys/auth/verify', rateLimit, async (req, res) => {
+    const reauth = req.body.reauth === true;
+    const challenge = consumeChallenge(req, reauth ? 'reauth' : 'login');
+    const key = db.prepare('SELECT * FROM passkeys WHERE id = ?').get(req.body.credential?.id || '');
+    if (!key || (reauth && key.user_id !== req.session.user_id)) throw fail('This passkey doesn’t belong to this account.', 401);
+    const handle = req.body.credential?.response?.userHandle;
+    if (handle && Buffer.from(handle, 'base64url').toString() !== key.user_id) throw fail('Unable to verify this account.', 401);
+    const result = await verifyAuthenticationResponse({ response: req.body.credential, expectedChallenge: challenge, expectedOrigin: req.rp.origin, expectedRPID: req.rp.id, requireUserVerification: true, credential: { id: key.id, publicKey: new Uint8Array(key.public_key), counter: key.counter, transports: JSON.parse(key.transports) } });
+    if (!result.verified) throw fail('We couldn’t verify your passkey.', 401);
+    db.prepare('UPDATE passkeys SET counter = ?, last_used = ?, backed_up = ? WHERE id = ?').run(result.authenticationInfo.newCounter, new Date().toISOString(), Number(result.authenticationInfo.credentialBackedUp), key.id);
+    record(key.user_id, reauth ? 'Identity verified with passkey' : 'Signed in with passkey');
+    if (reauth) { db.prepare('UPDATE sessions SET verified = ? WHERE id = ?').run(Date.now(), req.session.id); res.json({ ok: true }); }
+    else login(req, res, key.user_id);
+  });
+  app.patch('/api/passkeys/:id', signedIn, fresh, (req, res) => {
+    const name = req.body.name;
+    if (typeof name !== 'string' || !name.trim() || name.length > 60) throw fail('Choose a name between 1 and 60 characters.');
+    const result = db.prepare('UPDATE passkeys SET name = ? WHERE id = ? AND user_id = ?').run(name.trim(), req.params.id, req.session.user_id);
+    if (!result.changes) throw fail('Passkey not found.', 404);
+    record(req.session.user_id, 'Passkey renamed');
+    res.json({ ok: true });
+  });
+  app.delete('/api/passkeys/:id', signedIn, fresh, (req, res) => {
+    const result = db.prepare('DELETE FROM passkeys WHERE id = ? AND user_id = ?').run(req.params.id, req.session.user_id);
+    if (!result.changes) throw fail('Passkey not found.', 404);
+    record(req.session.user_id, 'Passkey removed');
+    res.json({ ok: true });
+  });
+  app.post('/api/password', signedIn, fresh, (req, res) => {
+    const { password } = req.body;
+    if (typeof password !== 'string' || password.length < 12 || password.length > 128) throw fail('Choose a password of 12–128 characters.');
+    db.prepare('UPDATE users SET password = ? WHERE id = ?').run(passwordHash(password), req.session.user_id);
+    db.prepare('DELETE FROM sessions WHERE user_id = ? AND id != ?').run(req.session.user_id, req.session.id);
+    record(req.session.user_id, 'Password changed');
+    res.json({ ok: true });
+  });
+  app.use('/api', (_req, _res, next) => next(fail('This action is not available.', 404)));
+  app.use(express.static(`${ROOT}public`));
+  app.get('/', (_req, res) => res.sendFile(`${ROOT}index.html`));
+  app.use((error, _req, res, _next) => {
+    const status = error.status || 400;
+    if (status >= 500) console.error(error);
+    res.status(status).json({ error: status >= 500 ? 'Something went wrong. Please try again.' : error.message, code: error.code });
+  });
+  return { app, db };
+}
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  await build({ entryPoints: [`${ROOT}client.js`], outfile: `${ROOT}public/app.js`, bundle: true, minify: true, format: 'esm' });
+  const { app } = createApp();
+  app.listen(process.env.PORT || 11222, '0.0.0.0', () => console.log('The Daily Grind is ready.'));
+}
diff --git a/test/auth.test.js b/test/auth.test.js
new file mode 100644
index 0000000..05bd5ce
--- /dev/null
+++ b/test/auth.test.js
@@ -0,0 +1,154 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { generateKeyPairSync, randomBytes, createHash, sign } from 'node:crypto';
+import { encodeCBOR } from '@levischuck/tiny-cbor';
+import { createApp } from '../server.js';
+const ORIGIN = 'http://localhost:11222';
+const digest = value => createHash('sha256').update(value).digest();
+const b64 = value => Buffer.from(value).toString('base64url');
+async function setup(t) {
+  const { app, db } = createApp({ database: ':memory:', origin: ORIGIN });
+  const server = app.listen(0, '127.0.0.1');
+  await new Promise(resolve => server.once('listening', resolve));
+  t.after(() => { server.close(); db.close(); });
+  const base = `http://127.0.0.1:${server.address().port}`;
+  function client() {
+    let cookie = '', csrf = '';
+    return {
+      async request(path, body, method = 'POST', headers = {}) {
+        const response = await fetch(`${base}/api${path}`, { method, headers: { Cookie: cookie, 'Content-Type': 'application/json', 'X-CSRF-Token': csrf, Origin: ORIGIN, ...headers }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
+        const newCookie = response.headers.get('set-cookie');
+        if (newCookie) cookie = newCookie.split(';')[0];
+        const data = await response.json();
+        if (data.csrf) csrf = data.csrf;
+        return { status: response.status, data };
+      },
+      async session() { return this.request('/session', undefined, 'GET'); },
+      async register(email = 'alex@example.com') {
+        await this.session();
+        const result = await this.request('/register', { name: 'Alex Morgan', email, password: 'a unique secure password' });
+        assert.equal(result.status, 200, JSON.stringify(result.data));
+      },
+    };
+  }
+  return { client, db, base };
+}
+function authenticator() {
+  const { privateKey, publicKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = publicKey.export({ format: 'jwk' });
+  const id = randomBytes(32);
+  const cose = encodeCBOR(new Map([[1, 2], [3, -7], [-1, 1], [-2, new Uint8Array(Buffer.from(jwk.x, 'base64url'))], [-3, new Uint8Array(Buffer.from(jwk.y, 'base64url'))]]));
+  function clientData(type, challenge, origin = ORIGIN) { return Buffer.from(JSON.stringify({ type, challenge, origin, crossOrigin: false })); }
+  return {
+    id: b64(id),
+    registration(options, { origin = ORIGIN, verified = true } = {}) {
+      const length = Buffer.alloc(2); length.writeUInt16BE(id.length);
+      const authData = Buffer.concat([digest('localhost'), Buffer.from([verified ? 0x45 : 0x41]), Buffer.alloc(4), Buffer.alloc(16), length, id, Buffer.from(cose)]);
+      const attestation = encodeCBOR(new Map([['fmt', 'none'], ['attStmt', new Map()], ['authData', new Uint8Array(authData)]]));
+      return { id: b64(id), rawId: b64(id), type: 'public-key', response: { clientDataJSON: b64(clientData('webauthn.create', options.challenge, origin)), attestationObject: b64(attestation), transports: ['internal'] }, clientExtensionResults: { credProps: { rk: true } }, authenticatorAttachment: 'platform' };
+    },
+    assertion(options, counter = 1, { origin = ORIGIN, verified = true } = {}) {
+      const count = Buffer.alloc(4); count.writeUInt32BE(counter);
+      const authData = Buffer.concat([digest('localhost'), Buffer.from([verified ? 0x05 : 0x01]), count]);
+      const data = clientData('webauthn.get', options.challenge, origin);
+      const signature = sign('sha256', Buffer.concat([authData, digest(data)]), privateKey);
+      return { id: b64(id), rawId: b64(id), type: 'public-key', response: { clientDataJSON: b64(data), authenticatorData: b64(authData), signature: b64(signature), userHandle: null }, clientExtensionResults: {}, authenticatorAttachment: 'platform' };
+    },
+  };
+}
+async function addKey(client, key) {
+  const options = await client.request('/passkeys/register/options', {});
+  assert.equal(options.status, 200, JSON.stringify(options.data));
+  assert.equal(options.data.authenticatorSelection.userVerification, 'required');
+  const result = await client.request('/passkeys/register/verify', { credential: key.registration(options.data), name: 'Personal laptop' });
+  assert.equal(result.status, 200, JSON.stringify(result.data));
+}
+
+test('accounts enforce CSRF, validate passwords, and isolate private data', async t => {
+  const { client } = await setup(t);
+  const a = client();
+  await a.session();
+  assert.equal((await a.request('/register', { name: 'A', email: 'a@example.com', password: 'short' })).status, 400);
+  assert.equal((await a.request('/register', {}, 'POST', { 'X-CSRF-Token': 'wrong' })).status, 403);
+  assert.equal((await a.request('/register', {}, 'POST', { Origin: 'https://evil.example' })).status, 403);
+  await a.register();
+  assert.equal((await a.session()).data.user.email, 'alex@example.com');
+  const b = client(); await b.session();
+  assert.equal((await b.request('/passkeys/register/options', {})).status, 401);
+  assert.equal((await b.request('/login', { email: 'alex@example.com', password: 'incorrect' })).status, 401);
+  assert.equal((await b.request('/login', { email: 'alex@example.com', password: 'a unique secure password' })).status, 200);
+  assert.equal((await b.request('/password', { password: 'brand new unique password' })).status, 200);
+  assert.equal((await a.session()).data.user, null, 'password change revokes other sessions');
+  assert.equal((await a.request('/login', { email: 'alex@example.com', password: 'a unique secure password' })).status, 401);
+  assert.equal((await a.request('/login', { email: 'alex@example.com', password: 'brand new unique password' })).status, 200);
+});
+
+test('real signed passkey registration, login, reauthentication, rename and removal', async t => {
+  const { client, db } = await setup(t);
+  const a = client(); await a.register();
+  const key = authenticator(); await addKey(a, key);
+  let session = (await a.session()).data;
+  assert.equal(session.passkeys.length, 1);
+  assert.equal(session.passkeys[0].name, 'Personal laptop');
+  assert.equal(session.passkeys[0].public_key, undefined, 'private account responses omit credential material');
+  await a.request('/logout', {}); await a.session();
+  const options = (await a.request('/passkeys/auth/options', {})).data;
+  assert.deepEqual(options.allowCredentials, []);
+  const assertion = key.assertion(options);
+  assert.equal((await a.request('/passkeys/auth/verify', { credential: assertion })).status, 200);
+  assert.equal((await a.session()).data.user.email, 'alex@example.com');
+  assert.equal((await a.request('/passkeys/auth/verify', { credential: assertion })).status, 400, 'a challenge can only be used once');
+  db.prepare('UPDATE sessions SET verified = 0').run();
+  const stale = await a.request(`/passkeys/${key.id}`, { name: 'Renamed' }, 'PATCH');
+  assert.equal(stale.status, 403); assert.equal(stale.data.code, 'REAUTH_REQUIRED');
+  const verifyOptions = (await a.request('/passkeys/auth/options', { reauth: true })).data;
+  assert.equal(verifyOptions.allowCredentials[0].id, key.id);
+  assert.equal((await a.request('/passkeys/auth/verify', { credential: key.assertion(verifyOptions, 2), reauth: true })).status, 200);
+  assert.equal((await a.request(`/passkeys/${key.id}`, { name: 'Renamed' }, 'PATCH')).status, 200);
+  assert.equal((await a.session()).data.passkeys[0].name, 'Renamed');
+  const other = client(); await other.register('other@example.com');
+  assert.equal((await other.request(`/passkeys/${key.id}`, {}, 'DELETE')).status, 404);
+  assert.equal((await a.request(`/passkeys/${key.id}`, {}, 'DELETE')).status, 200);
+  session = (await a.session()).data;
+  assert.equal(session.passkeys.length, 0);
+  assert.ok(session.activity.some(item => item.title === 'Identity verified with passkey'));
+  await a.request('/logout', {}); await a.session();
+  const removedOptions = (await a.request('/passkeys/auth/options', {})).data;
+  assert.equal((await a.request('/passkeys/auth/verify', { credential: key.assertion(removedOptions, 3) })).status, 401);
+});
+
+test('passkeys reject wrong origins, missing user verification, expired challenges, and bad signatures', async t => {
+  const { client, db } = await setup(t);
+  const a = client(); await a.register();
+  const key = authenticator();
+  let options = (await a.request('/passkeys/register/options', {})).data;
+  assert.equal((await a.request('/passkeys/register/verify', { credential: key.registration(options, { origin: 'https://evil.example' }) })).status, 400);
+  options = (await a.request('/passkeys/register/options', {})).data;
+  assert.equal((await a.request('/passkeys/register/verify', { credential: key.registration(options, { verified: false }) })).status, 400);
+  await addKey(a, key);
+  options = (await a.request('/passkeys/auth/options', {})).data;
+  const badSignature = key.assertion(options);
+  badSignature.response.signature = b64(randomBytes(72));
+  assert.equal((await a.request('/passkeys/auth/verify', { credential: badSignature })).status, 400);
+  options = (await a.request('/passkeys/auth/options', {})).data;
+  assert.equal((await a.request('/passkeys/auth/verify', { credential: key.assertion(options, 1, { verified: false }) })).status, 400);
+  options = (await a.request('/passkeys/auth/options', {})).data;
+  db.prepare("UPDATE sessions SET challenge = json_set(challenge, '$.expires', 1) WHERE challenge IS NOT NULL").run();
+  assert.equal((await a.request('/passkeys/auth/verify', { credential: key.assertion(options) })).status, 400);
+  db.prepare('UPDATE sessions SET verified = 0').run();
+  assert.equal((await a.request('/password', { password: 'a totally new password' })).data.code, 'REAUTH_REQUIRED');
+  assert.equal((await a.request('/reauth/password', { password: 'wrong' })).status, 401);
+  assert.equal((await a.request('/reauth/password', { password: 'a unique secure password' })).status, 200);
+  assert.equal((await a.request('/password', { password: 'a totally new password' })).status, 200);
+});
+
+test('public application assets are served without exposing source files or the database', async t => {
+  const { base } = await setup(t);
+  const page = await fetch(base);
+  assert.equal(page.status, 200);
+  assert.match(await page.text(), /Security &amp;|Security & sign-in/);
+  assert.equal((await fetch(`${base}/styles.css`)).status, 200);
+  assert.equal((await fetch(`${base}/app.js`)).status, 200);
+  assert.equal((await fetch(`${base}/server.js`)).status, 404);
+  assert.equal((await fetch(`${base}/data/accounts.sqlite`)).status, 404);
+});
