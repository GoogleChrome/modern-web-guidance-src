+  };
+}
+function supportsPasskeys() {
+  if (!window.isSecureContext || !browserSupportsWebAuthn()) throw new Error('This browser can’t use passkeys here. Use a supported browser over HTTPS, or sign in with your password.');
+}
+function auth(mode = 'login', after) {
+  const signup = mode === 'register';
+  showModal(`${modalHead(signup ? 'coffee' : 'user', signup ? 'Make yourself at home.' : 'Good to see you again.', signup ? 'Create your Daily Grind account. Then add a passkey for an easier way in.' : 'Your coffee ritual is waiting. Sign in to your account.')}<form id="modal-form">${signup ? '<label for="name">Your name</label><input id="name" name="name" autocomplete="name" placeholder="Alex Morgan" required maxlength="80">' : ''}<label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="username webauthn" placeholder="you@example.com" required maxlength="254"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="${signup ? 'new-password' : 'current-password'}" ${signup ? 'minlength="12"' : ''} maxlength="128" required>${signup ? '<span class="field-hint">At least 12 characters. This is your backup way to sign in.</span>' : ''}${errorSlot}<button class="primary-btn" type="submit">${signup ? 'Create account' : 'Sign in'} ${icon('arrow')}</button></form>${!signup ? `<div class="divider">or keep it simple</div><button class="secondary-btn" id="passkey-login">${icon('fingerprint')}Sign in with a passkey</button>` : ''}<div class="modal-switch">${signup ? 'Already part of the daily ritual?' : 'New to The Daily Grind?'}<button id="switch-auth">${signup ? 'Sign in' : 'Create an account'}</button></div>`);
+  bindForm(async data => {
+    await api(signup ? '/register' : '/login', Object.fromEntries(data));
+    await refresh(); closeModal();
+    if (after) await after(); else notice(signup ? 'Your account is ready. Make yourself at home.' : 'Welcome back. You’re signed in.');
+  });
+  $('#switch-auth').onclick = () => auth(signup ? 'login' : 'register', after);
+  if (!signup) $('#passkey-login').onclick = async event => {
+    const button = event.currentTarget; button.disabled = true;
+    try {
+      supportsPasskeys();
+      const optionsJSON = await api('/passkeys/auth/options', {});
+      const credential = await startAuthentication({ optionsJSON });
+      await api('/passkeys/auth/verify', { credential });
+      await refresh(); closeModal();
+      if (after) await after(); else notice('Welcome back. Signed in with your passkey.');
+    } catch (error) { if ($('#form-error')) $('#form-error').textContent = friendlyError(error); }
+    finally { button.disabled = false; }
+  };
+}
+function requireAccount(action, mode = 'login') {
+  if (!state.csrf) { notice('The server is connecting. Please try again in a moment.', true); return; }
+  if (!state.user) auth(mode, action); else action();
+}
+async function withFresh(action) {
+  try { await action(); }
+  catch (error) {
+    if (error.code === 'REAUTH_REQUIRED') reauthenticate(action);
+    else throw error;
+  }
+}
+function reauthenticate(after = () => notice('Identity confirmed. Your account is protected.')) {
+  showModal(`${modalHead('shield', 'A quick check, just for you.', 'Confirm it’s really you before making a sensitive change.')}<form id="modal-form"><label for="verify-password">Your password</label><input id="verify-password" name="password" type="password" autocomplete="current-password" required maxlength="128">${errorSlot}<button class="primary-btn" type="submit">Confirm identity ${icon('arrow')}</button></form>${state.passkeys.length ? `<div class="divider">or</div><button class="secondary-btn" id="verify-passkey">${icon('fingerprint')}Verify with a passkey</button>` : ''}`);
+  bindForm(async data => { await api('/reauth/password', Object.fromEntries(data)); closeModal(); await after(); });
+  if ($('#verify-passkey')) $('#verify-passkey').onclick = async event => {
+    const button = event.currentTarget; button.disabled = true;
+    try {
+      supportsPasskeys();
+      const optionsJSON = await api('/passkeys/auth/options', { reauth: true });
+      const credential = await startAuthentication({ optionsJSON });
+      await api('/passkeys/auth/verify', { credential, reauth: true });
+      closeModal(); await after();
+    } catch (error) { if ($('#form-error')) $('#form-error').textContent = friendlyError(error); else notice(friendlyError(error), true); }
+    finally { button.disabled = false; }
+  };
+}
+function addPasskey() {
+  showModal(`${modalHead('fingerprint', 'An easier way in.', 'Give your passkey a name you’ll recognize. Your device will guide you through the rest.')}<form id="modal-form"><label for="passkey-name">Passkey name</label><input id="passkey-name" name="name" placeholder="e.g. My phone or personal laptop" maxlength="60" required value="My ${/Mobi|Android/i.test(navigator.userAgent) ? 'phone' : 'computer'}"><span class="field-hint">Use a fingerprint, your face, a device PIN, or a security key.</span>${errorSlot}<button class="primary-btn" type="submit">${icon('plus')}Create passkey</button></form>`);
+  bindForm(async data => {
+    supportsPasskeys();
+    await withFresh(async () => {
+      const optionsJSON = await api('/passkeys/register/options', {});
+      const credential = await startRegistration({ optionsJSON });
+      await api('/passkeys/register/verify', { credential, name: data.get('name') });
+      await refresh(); closeModal(); notice('Passkey added. Your next sign-in just got easier.');
+    });
+  });
+}
+function renamePasskey(id) {
+  const key = state.passkeys.find(k => k.id === id);
+  showModal(`${modalHead('edit', 'A name that feels familiar.', 'Choose a name to help you recognize this passkey.')}<form id="modal-form"><label for="passkey-name">Passkey name</label><input id="passkey-name" name="name" value="${escape(key.name)}" maxlength="60" required>${errorSlot}<button class="primary-btn" type="submit">Save name</button></form>`);
+  bindForm(async data => withFresh(async () => { await api(`/passkeys/${encodeURIComponent(id)}`, { name: data.get('name') }, 'PATCH'); await refresh(); closeModal(); notice('Passkey name updated.'); }));
+}
+function removePasskey(id) {
+  const key = state.passkeys.find(k => k.id === id);
+  showModal(`${modalHead('key', 'Remove this passkey?', `You won’t be able to use “${escape(key.name)}” to sign in to The Daily Grind anymore. You can still use ${state.passkeys.length > 1 ? 'your other passkeys or ' : ''}your password.`)}<p>Removing it here doesn’t delete it from your device’s password manager.</p><form id="modal-form">${errorSlot}<button class="primary-btn danger-btn" type="submit">Remove passkey</button></form><button class="secondary-btn" id="cancel-remove">Keep passkey</button>`);
+  $('#cancel-remove').onclick = closeModal;
+  bindForm(async () => withFresh(async () => { await api(`/passkeys/${encodeURIComponent(id)}`, {}, 'DELETE'); await refresh(); closeModal(); notice('Passkey removed from your account.'); }));
+}
+function changePassword() {
+  showModal(`${modalHead('lock', 'Keep your backup secure.', 'Choose a unique password you haven’t used elsewhere. Other signed-in sessions will be signed out.')}<form id="modal-form"><label for="new-password">New password</label><input id="new-password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required><span class="field-hint">Use 12–128 characters.</span><label for="confirm-password">Confirm new password</label><input id="confirm-password" name="confirm" type="password" autocomplete="new-password" required>${errorSlot}<button class="primary-btn" type="submit">Update password</button></form>`);
+  bindForm(async data => {
+    if (data.get('password') !== data.get('confirm')) throw new Error('The passwords don’t match. Please try again.');
+    await withFresh(async () => { await api('/password', { password: data.get('password') }); await refresh(); closeModal(); notice('Your password has been updated.'); });
+  });
+}
+function accountDetails() {
+  showModal(`${modalHead('user', 'Your daily space.', 'The details that make your account yours.')}<div class="account-detail"><small>YOUR NAME</small><p>${escape(state.user.name)}</p><small>ACCOUNT EMAIL</small><p>${escape(state.user.email)}</p><small>SIGN-IN METHODS</small><p>Password${state.passkeys.length ? ` and ${state.passkeys.length} passkey${state.passkeys.length > 1 ? 's' : ''}` : ''}</p></div><button class="primary-btn" id="details-done">All good ${icon('check')}</button><button class="secondary-btn" id="details-signout">${icon('logout')}Sign out of this device</button>`);
+  $('#details-done').onclick = closeModal;
+  $('#details-signout').onclick = () => $('#sidebar-auth').click();
+}
+const infos = {
+  passkeys: ['fingerprint', 'Your way in. Only simpler.', '<p>A passkey uses your device’s fingerprint sensor, face recognition, or PIN to securely sign you in.</p><ul><li>No password to remember or type.</li><li>Designed to protect against phishing.</li><li>Your biometric data stays on your device.</li><li>Synced passkeys may work across your devices through your password manager.</li></ul><p>Keep your password as a backup. You can add more than one passkey, rename them, or remove them here.</p>'],
+  menu: ['coffee', 'Find your next favorite.', '<p>A little inspiration for your next café visit.</p><div class="menu-item"><div>Maple oat latte<small>Espresso, creamy oat milk & maple syrup</small></div><span>Seasonal</span></div><div class="menu-item"><div>Dark roast espresso<small>A bold, beautifully balanced daily ritual</small></div><span>Classic</span></div><div class="menu-item"><div>Slow-steeped cold brew<small>18 hours of patience. A seriously smooth finish.</small></div><span>On ice</span></div><p>Visit your local café for current prices and availability.</p>'],
+  story: ['coffee', 'Good coffee. Good days.', '<p>The Daily Grind is built around a simple idea: the everyday deserves a little care.</p><p>Ethically sourced beans, thoughtful roasting, and a warm welcome. From your first sip to your daily ritual, we’re here to make a little happiness.</p>'],
+  locations: ['coffee', 'Your next coffee stop.', '<p>Our café directory is brewing. Ask at your local Daily Grind for opening hours, seasonal specials, and pickup options.</p>'],
+  rewards: ['gift', 'Make your daily ritual count.', '<p>Good coffee deserves good company. Ask your local café about Grind rewards and how to make the most of every visit.</p>'],
+  help: ['help', 'A little help goes a long way.', '<p><strong>Having trouble with a passkey?</strong><br>Check that you’re using the device or password manager where you saved it. You can also use “Sign in” and enter your email and password.</p><p><strong>Changed devices?</strong><br>Your synced passkey may be in your password manager. Otherwise, sign in with your password and add a new one.</p><p>For help with your coffee or an order, speak to the team at your local café.</p>'],
+  privacy: ['shield', 'A little care for your privacy.', '<p>Your account stores your name, email, a securely hashed password, and your account security activity. Passkeys store only public credential information on our server.</p><p>Your face and fingerprint data stay with your device. We never receive them. A secure session cookie keeps you signed in.</p><p>You can remove a registered passkey from this account at any time.</p>'],
+  terms: ['info', 'A few things to know.', '<p>Keep your account details accurate and your sign-in methods secure. Only register passkeys on devices you trust.</p><p>Menu availability, prices, and café opening hours vary by location. Speak with your local team for current details.</p>'],
+  orders: ['bag', 'Your next good thing.', '<p>Your coffee orders will have a home here. There are no online orders to show in this account yet.</p><p>For now, stop by your local café for your daily favorite.</p>'],
+  favorites: ['heart', 'Room for your favorites.', '<p>Every daily ritual starts with a favorite. Browse our menu to find your next one.</p>'],
+};
+function info(key) {
+  const [symbol, title, body] = infos[key] || infos.help;
+  showModal(`${modalHead(symbol, title, '')}${body}<button class="primary-btn" id="info-done">${key === 'passkeys' ? 'Add my first passkey' : 'Sounds good'} ${icon('arrow')}</button>`);
+  $('#info-done').onclick = key === 'passkeys' ? () => requireAccount(addPasskey, 'register') : closeModal;
+}
+$('#add-passkey').onclick = () => requireAccount(addPasskey, 'register');
+$('#account-nav').onclick = () => requireAccount(accountDetails);
+$('#change-password').onclick = () => requireAccount(changePassword);
+$('#email-details').onclick = () => requireAccount(accountDetails);
+$('#learn-passkeys').onclick = () => info('passkeys');
+$('#test-reauth').onclick = () => requireAccount(() => reauthenticate());
+$('#sidebar-auth').onclick = () => {
+  if (!state.user) { auth(); return; }
+  showModal(`${modalHead('logout', 'Until your next cup.', 'Ready to sign out of this device? Your account and passkeys will be here when you return.')}<form id="modal-form">${errorSlot}<button class="primary-btn" type="submit">Sign out</button></form>`);
+  bindForm(async () => { await api('/logout', {}); await refresh(); closeModal(); notice('You’re signed out. See you soon.'); });
+};
+for (const button of document.querySelectorAll('[data-info]')) button.onclick = () => info(button.dataset.info);
+for (const button of document.querySelectorAll('[data-section]')) button.onclick = () => {
+  const section = button.dataset.section;
+  if (section === 'security') { $('#methods-tab').click(); return; }
+  if (section === 'overview') requireAccount(accountDetails); else info(section);
+};
+function selectTab(activity) {
+  $('#methods-panel').hidden = activity; $('#activity-panel').hidden = !activity;
+  $('#methods-tab').classList.toggle('active', !activity); $('#activity-tab').classList.toggle('active', activity);
+  $('#methods-tab').setAttribute('aria-selected', String(!activity)); $('#activity-tab').setAttribute('aria-selected', String(activity));
+  $('#methods-tab').tabIndex = activity ? -1 : 0; $('#activity-tab').tabIndex = activity ? 0 : -1;
+}
+$('#methods-tab').onclick = () => selectTab(false);
+$('#activity-tab').onclick = () => selectTab(true);
+$('.tabs').onkeydown = event => {
+  if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) {
+    event.preventDefault(); const activity = event.key === 'End' || (event.key !== 'Home' && $('#activity-panel').hidden);
+    selectTab(activity); $(activity ? '#activity-tab' : '#methods-tab').focus();
+  }
+};
+selectTab(false);
+refresh().catch(() => notice('We couldn’t connect to your account. Please refresh to try again.', true));
