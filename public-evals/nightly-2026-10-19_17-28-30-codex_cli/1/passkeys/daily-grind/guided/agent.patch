+}
diff --git a/src/account.js b/src/account.js
new file mode 100644
index 0000000..e8da01d
--- /dev/null
+++ b/src/account.js
@@ -0,0 +1,196 @@
+import 'webauthn-polyfills';
+
+const $ = id => document.getElementById(id);
+let state = { user: null, passkeys: [] };
+let supported = false;
+let capabilities = {};
+let busy = false;
+let controller = new AbortController();
+let generation = 0;
+const keySVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="8" r="4.5"/><path d="m11.3 11.3 9 9m-3-3 3-3m-6 0 3-3"/></svg>';
+
+async function api(path, body, method = 'POST') {
+  const response = await fetch(`/api/${path}`, {
+    method, credentials: 'same-origin', cache: 'no-store',
+    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'DailyGrind' },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+  });
+  let data;
+  try { data = await response.json(); } catch { throw new Error('The service is unavailable. Please try again.'); }
+  if (!response.ok) {
+    if (response.status === 401) { state = { ...state, user: null, passkeys: [] }; render(); }
+    throw Object.assign(new Error(data.error || 'Could not complete this request.'), { status: response.status });
+  }
+  return data;
+}
+function notice(message, error = false) {
+  $('status').textContent = message;
+  $('status').dataset.error = String(error);
+  $('status').hidden = !message;
+}
+function friendly(error) {
+  const messages = {
+    NotAllowedError: 'The passkey request was cancelled or timed out. You can try again.',
+    AbortError: 'The passkey request was cancelled. You can try again.',
+    InvalidStateError: 'A passkey for this account is already saved here. Try another device or security key.',
+    SecurityError: 'Passkeys require HTTPS (or localhost) and a correctly configured site domain.',
+    NotSupportedError: 'This device cannot create this passkey. Try a compatible device or security key.',
+  };
+  return messages[error.name] || error.message || 'Something went wrong. Please try again.';
+}
+function stopPrompt() { generation++; controller.abort(); controller = new AbortController(); }
+function setBusy(value) {
+  busy = value;
+  document.querySelectorAll('#account button').forEach(button => { button.disabled = value || (button.hasAttribute('data-passkey') && !supported); });
+  $('account').setAttribute('aria-busy', String(value));
+}
+async function run(action) {
+  if (busy) return;
+  stopPrompt();
+  setBusy(true);
+  notice('');
+  try { await action(); } catch (error) { notice(friendly(error), true); }
+  finally { setBusy(false); if (!state.user) void autofill(); }
+}
+async function signal(method, args) {
+  if (!window.PublicKeyCredential?.[method]) return;
+  try { await PublicKeyCredential[method](args); } catch { /* Optional password-manager sync must never block account actions. */ }
+}
+function syncAccepted() {
+  if (state.user) return signal('signalAllAcceptedCredentials', { rpId: state.rpId, userId: state.user.id, allAcceptedCredentialIds: state.passkeys.map(key => key.id) });
+}
+function accepted(data) { state = data; render(); void syncAccepted(); }
+function date(value) { return value ? new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(value) : 'Not used yet'; }
+function render() {
+  $('guest-panel').hidden = Boolean(state.user);
+  $('member-panel').hidden = !state.user;
+  $('account-nav').textContent = state.user ? 'My account' : 'Sign in';
+  $('passkey-list').replaceChildren();
+  if (!state.user) return;
+  $('member-name').textContent = `Hello, ${state.user.displayName}.`;
+  $('member-username').textContent = `@${state.user.username}`;
+  if (!state.passkeys.length) {
+    const empty = document.createElement('p'); empty.textContent = 'No passkeys found. Add a passkey to secure your account.'; $('passkey-list').append(empty);
+  }
+  for (const key of state.passkeys) {
+    const row = document.createElement('div'); row.className = 'passkey-row';
+    const icon = document.createElement('div'); icon.className = 'row-icon'; icon.innerHTML = keySVG;
+    if (key.providerIcon) { const image = document.createElement('img'); image.src = key.providerIcon; image.alt = ''; image.width = 20; image.height = 20; icon.replaceChildren(image); }
+    const details = document.createElement('div'); details.className = 'passkey-details';
+    const name = document.createElement('strong'); name.textContent = key.name;
+    const metadata = document.createElement('p'); metadata.textContent = `${key.provider || 'Unknown passkey provider'}${key.backedUp ? ' · Backed up' : ''} · Added ${date(key.registeredAt)}`;
+    const lastUsed = document.createElement('p'); lastUsed.textContent = `Last used: ${date(key.lastUsedAt)}`;
+    details.append(name, metadata, lastUsed);
+    const actions = document.createElement('div'); actions.className = 'row-actions';
+    const rename = document.createElement('button'); rename.type = 'button'; rename.className = 'text-button'; rename.textContent = 'Rename'; rename.setAttribute('aria-label', `Rename ${key.name}`); rename.onclick = () => renameKey(key);
+    const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'text-button danger'; remove.textContent = 'Remove'; remove.setAttribute('aria-label', `Remove ${key.name}`); remove.onclick = () => deleteKey(key);
+    actions.append(rename, remove); row.append(icon, details, actions); $('passkey-list').append(row);
+  }
+}
+async function authentication({ reauth = false, purpose, conditional = false } = {}) {
+  const version = generation;
+  const packet = await api(reauth ? 'reauth/options' : 'auth/options', reauth ? { purpose } : {});
+  if (version !== generation) return;
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(packet.options);
+  const credential = await navigator.credentials.get({ publicKey, signal: controller.signal, ...(conditional ? { mediation: 'conditional' } : {}) });
+  if (!credential || version !== generation) return;
+  const encoded = credential.toJSON();
+  try {
+    const data = await api(reauth ? 'reauth/verify' : 'auth/verify', { ceremonyId: packet.ceremonyId, credential: encoded });
+    if (!reauth) { accepted(data); notice('Welcome back. You’re signed in securely.'); }
+    return data;
+  } catch (error) {
+    // Only an explicit unknown-credential response while signed out may prune a saved login.
+    if (!reauth && !state.user && error.status === 404) await signal('signalUnknownCredential', { rpId: packet.options.rpId, credentialId: encoded.id });
+    throw error;
+  }
+}
+async function registration() {
+  if (!supported) throw new Error('Passkeys are unavailable in this browser or connection.');
+  const existing = Boolean(state.user);
+  if (existing) await authentication({ reauth: true, purpose: 'add-passkey' });
+  const packet = await api('register/options', existing ? {} : { username: $('new-username').value, displayName: $('display-name').value });
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(packet.options);
+  const credential = await navigator.credentials.create({ publicKey, signal: controller.signal });
+  if (!credential) throw new Error('No passkey was created. Please try again.');
+  const encoded = credential.toJSON();
+  try {
+    accepted(await api('register/verify', { ceremonyId: packet.ceremonyId, credential: encoded }));
+    notice(existing ? 'Your new passkey is ready. You can rename it below.' : 'You’re all set. Your account and first passkey are ready.');
+  } catch (error) {
+    // A network failure is ambiguous: the server may have saved the credential. Never prune on a network/5xx error.
+    if (error.status && error.status < 500 && error.status !== 409) await signal('signalUnknownCredential', { rpId: packet.options.rp.id, credentialId: encoded.id });
+    throw error;
+  }
+}
+async function autofill() {
+  if (!supported || state.user || busy || !capabilities.conditionalGet || $('signin-form').hidden) return;
+  try { await authentication({ conditional: true }); }
+  catch (error) { if (!['NotAllowedError', 'AbortError'].includes(error.name)) notice(friendly(error), true); }
+}
+function tab(register) {
+  stopPrompt();
+  $('signin-form').hidden = register; $('register-form').hidden = !register;
+  $('signin-tab').setAttribute('aria-pressed', String(!register)); $('register-tab').setAttribute('aria-pressed', String(register));
+  notice('');
+  if (!register) void autofill();
+}
+let dialogAction;
+function openDialog({ title, description, value, confirm = 'Save', action }) {
+  stopPrompt();
+  $('dialog-title').textContent = title; $('dialog-description').textContent = description;
+  $('dialog-field').hidden = value === undefined; $('dialog-input').required = value !== undefined; $('dialog-input').value = value || '';
+  $('dialog-confirm').textContent = confirm; $('dialog-error').hidden = true; dialogAction = action;
+  $('action-dialog').showModal();
+}
+function renameKey(key) {
+  openDialog({ title: 'Rename your passkey', description: 'Choose a name that helps you recognize this passkey.', value: key.name, action: async value => {
+    accepted(await api(`passkeys/${encodeURIComponent(key.id)}`, { name: value }, 'PATCH')); notice('Passkey renamed.');
+  } });
+}
+function deleteKey(key) {
+  if (state.passkeys.length <= 1) { notice('Add another passkey before removing your last one. This keeps you from being locked out.', true); return; }
+  openDialog({ title: 'Remove this passkey?', description: `“${key.name}” will no longer sign you in. We’ll verify your identity before removing it. Your other sessions will be signed out.`, confirm: 'Verify & remove', action: async () => {
+    await authentication({ reauth: true, purpose: `delete-passkey:${key.id}` });
+    accepted(await api(`passkeys/${encodeURIComponent(key.id)}`, undefined, 'DELETE'));
+    await syncAccepted(); notice('Passkey removed.');
+  } });
+}
+$('action-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  setBusy(true); $('dialog-confirm').disabled = true; $('dialog-cancel').disabled = true;
+  try { await dialogAction($('dialog-input').value.trim()); $('action-dialog').close(); }
+  catch (error) { $('dialog-error').textContent = friendly(error); $('dialog-error').hidden = false; }
+  finally { setBusy(false); $('dialog-confirm').disabled = false; $('dialog-cancel').disabled = false; }
+});
+$('dialog-cancel').onclick = () => $('action-dialog').close();
+$('action-dialog').addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+$('action-dialog').addEventListener('close', () => { if (!state.user) void autofill(); });
+$('signin-tab').onclick = () => tab(false);
+$('register-tab').onclick = () => tab(true);
+$('signin-form').onsubmit = event => { event.preventDefault(); void run(() => authentication()); };
+$('register-form').onsubmit = event => { event.preventDefault(); void run(registration); };
+$('add-passkey').onclick = () => run(registration);
+$('verify-identity').onclick = () => run(async () => { await authentication({ reauth: true, purpose: 'update-profile' }); notice('Identity verified. Sensitive changes will still ask you to confirm when needed.'); });
+$('signout').onclick = () => run(async () => { await api('logout', {}); accepted(await api('session', undefined, 'GET')); tab(false); notice('You’re signed out. See you for your next cup.'); });
+$('edit-profile').onclick = () => openDialog({ title: 'A name that feels like you', description: 'Verify your identity to update your account name.', value: state.user.displayName, action: async value => {
+  await authentication({ reauth: true, purpose: 'update-profile' });
+  accepted(await api('profile', { displayName: value }, 'PATCH'));
+  await signal('signalCurrentUserDetails', { rpId: state.rpId, userId: state.user.id, name: state.user.username, displayName: state.user.displayName });
+  notice('Your account name has been updated.');
+} });
+async function initialize() {
+  setBusy(true);
+  try {
+    if (window.isSecureContext && window.PublicKeyCredential && navigator.credentials) {
+      capabilities = await PublicKeyCredential.getClientCapabilities();
+      supported = true; // External security keys remain available even without a local platform authenticator.
+    }
+    $('support-note').hidden = supported;
+    accepted(await api('session', undefined, 'GET'));
+  } catch (error) { notice(friendly(error), true); }
+  finally { setBusy(false); void autofill(); }
+  if (location.pathname === '/account') $('account').scrollIntoView();
+}
+void initialize();
diff --git a/test/client.test.js b/test/client.test.js
new file mode 100644
index 0000000..ed28905
--- /dev/null
+++ b/test/client.test.js
@@ -0,0 +1,101 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { JSDOM } from 'jsdom';
+
+const html = readFileSync('index.html', 'utf8');
+const script = readFileSync('public/account.js', 'utf8');
+const member = { user: { id: 'dXNlcg', username: 'coffee.fan', displayName: 'Coffee Fan' }, rpId: 'coffee.test', passkeys: [{ id: 'a2V5', name: 'My passkey', registeredAt: Date.now(), lastUsedAt: null }] };
+async function until(check) {
+  for (let i = 0; i < 100; i++) { if (check()) return; await new Promise(resolve => setImmediate(resolve)); }
+  assert.fail('Client did not reach the expected state');
+}
+async function setup(t, { available = true, initial = null, get, create, handler } = {}) {
+  const dom = new JSDOM(html, { url: 'https://coffee.test', runScripts: 'outside-only', pretendToBeVisual: true });
+  t.after(() => dom.window.close());
+  const w = dom.window;
+  Object.defineProperty(w, 'isSecureContext', { value: true });
+  const calls = [];
+  const signalCalls = [];
+  if (available) {
+    w.PublicKeyCredential = class {
+      static async getClientCapabilities() { return { conditionalGet: false, passkeyPlatformAuthenticator: true }; }
+      static parseRequestOptionsFromJSON(options) { return options; }
+      static parseCreationOptionsFromJSON(options) { return options; }
+      static async signalAllAcceptedCredentials(args) { signalCalls.push(['accepted', args]); }
+      static async signalCurrentUserDetails(args) { signalCalls.push(['profile', args]); }
+      static async signalUnknownCredential(args) { signalCalls.push(['unknown', args]); }
+    };
+  }
+  Object.defineProperty(w.navigator, 'credentials', { value: { get: get || (async () => ({ toJSON: () => ({ id: 'a2V5' }) })), create: create || (async () => ({ toJSON: () => ({ id: 'a2V5' }) })) } });
+  w.HTMLDialogElement.prototype.showModal = function () { this.setAttribute('open', ''); };
+  w.HTMLDialogElement.prototype.close = function () { this.removeAttribute('open'); this.dispatchEvent(new w.Event('close')); };
+  w.fetch = async (url, options) => {
+    const path = url.replace('/api/', '');
+    const body = options.body ? JSON.parse(options.body) : undefined;
+    calls.push([path, body, options.method]);
+    let status = 200;
+    let data;
+    if (handler) {
+      const result = handler(path, body);
+      if (result) { data = result.data; status = result.status || 200; }
+    }
+    if (!data) {
+      if (path === 'session') data = initial || { user: null, passkeys: [], rpId: 'coffee.test' };
+      else if (path.endsWith('/options')) data = { ceremonyId: 'challenge-id', options: { rpId: 'coffee.test', rp: { id: 'coffee.test' } } };
+      else if (path === 'reauth/verify') data = { verified: true };
+      else data = member;
+    }
+    return { ok: status < 400, status, json: async () => data };
+  };
+  w.eval(script);
+  await until(() => w.document.getElementById('account').getAttribute('aria-busy') === 'false');
+  return { w, $: id => w.document.getElementById(id), calls, signalCalls, submit: id => w.document.getElementById(id).dispatchEvent(new w.Event('submit', { bubbles: true, cancelable: true })) };
+}
+
+test('unsupported clients get an explanation and disabled passkey actions', async t => {
+  const { $ } = await setup(t, { available: false });
+  assert.equal($('support-note').hidden, false);
+  assert.equal($('signin-form').querySelector('button').disabled, true);
+});
+
+test('registration submits native credential JSON and renders the real account response', async t => {
+  const { $, calls, submit, signalCalls } = await setup(t);
+  $('register-tab').click();
+  $('new-username').value = 'coffee.fan'; $('display-name').value = 'Coffee Fan';
+  submit('register-form');
+  await until(() => !$('member-panel').hidden);
+  assert.equal($('guest-panel').hidden, true);
+  assert.equal($('member-name').textContent, 'Hello, Coffee Fan.');
+  assert.deepEqual(calls.find(c => c[0] === 'register/options')[1], { username: 'coffee.fan', displayName: 'Coffee Fan' });
+  assert.equal(calls.find(c => c[0] === 'register/verify')[1].credential.id, 'a2V5');
+  assert.ok(signalCalls.some(c => c[0] === 'accepted'));
+});
+
+test('cancellation does not sign in, exposes an actionable message, and enables retry', async t => {
+  const { $, submit, calls } = await setup(t, { get: async () => { throw Object.assign(new Error('cancelled'), { name: 'NotAllowedError' }); } });
+  submit('signin-form');
+  await until(() => $('status').textContent.includes('cancelled'));
+  assert.equal($('member-panel').hidden, true);
+  assert.equal($('signin-form').querySelector('button').disabled, false);
+  assert.equal(calls.some(c => c[0] === 'auth/verify'), false);
+});
+
+test('profile changes reauthenticate first and synchronize account details after saving', async t => {
+  const updated = { ...member, user: { ...member.user, displayName: 'Alex' } };
+  const { $, submit, calls, signalCalls } = await setup(t, { initial: member, handler: path => path === 'profile' ? { data: updated } : null });
+  $('edit-profile').click(); $('dialog-input').value = 'Alex'; submit('action-form');
+  await until(() => $('member-name').textContent === 'Hello, Alex.');
+  await until(() => signalCalls.some(c => c[0] === 'profile'));
+  assert.deepEqual(calls.filter(c => c[0] !== 'session').map(c => c[0]), ['reauth/options', 'reauth/verify', 'profile']);
+  assert.equal(calls.find(c => c[0] === 'reauth/options')[1].purpose, 'update-profile');
+  assert.equal(signalCalls.find(c => c[0] === 'profile')[1].displayName, 'Alex');
+});
+
+test('unknown signed-out credentials trigger optional password-manager synchronization', async t => {
+  const { $, submit, signalCalls } = await setup(t, { handler: path => path === 'auth/verify' ? { status: 404, data: { error: 'No longer registered.' } } : null });
+  submit('signin-form');
+  await until(() => !$('status').hidden);
+  assert.equal(signalCalls.find(c => c[0] === 'unknown')[1].credentialId, 'a2V5');
+  assert.equal($('member-panel').hidden, true);
+});
diff --git a/test/passkeys.test.js b/test/passkeys.test.js
new file mode 100644
index 0000000..3da3695
--- /dev/null
+++ b/test/passkeys.test.js
@@ -0,0 +1,192 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import request from 'supertest';
+import { randomBytes, generateKeyPairSync, createHash, sign } from 'node:crypto';
+import { encodeCBOR } from '@levischuck/tiny-cbor';
+import { createApp } from '../server.js';
+
+const origin = 'http://localhost:11222';
+const b64 = value => Buffer.from(value).toString('base64url');
+const sha = value => createHash('sha256').update(value).digest();
+function authenticator() {
+  const pair = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = pair.publicKey.export({ format: 'jwk' });
+  const id = b64(randomBytes(32));
+  const cose = encodeCBOR(new Map([[1, 2], [3, -7], [-1, 1], [-2, new Uint8Array(Buffer.from(jwk.x, 'base64url'))], [-3, new Uint8Array(Buffer.from(jwk.y, 'base64url'))]]));
+  let counter = 0;
+  let userId;
+  return {
+    id,
+    registration(options, overrides = {}) {
+      userId = options.user.id;
+      const client = Buffer.from(JSON.stringify({ type: 'webauthn.create', challenge: options.challenge, origin, ...overrides }));
+      const length = Buffer.alloc(2); length.writeUInt16BE(32);
+      const authData = Buffer.concat([sha(options.rp.id), Buffer.from([0x45]), Buffer.alloc(4), Buffer.alloc(16), length, Buffer.from(id, 'base64url'), Buffer.from(cose)]);
+      return { id, rawId: id, type: 'public-key', clientExtensionResults: {}, response: { clientDataJSON: b64(client), attestationObject: b64(encodeCBOR(new Map([['fmt', 'none'], ['attStmt', new Map()], ['authData', new Uint8Array(authData)]]))), transports: ['internal'] } };
+    },
+    assertion(options, { origin: assertionOrigin = origin, challenge = options.challenge, uv = true, corrupt = false } = {}) {
+      const client = Buffer.from(JSON.stringify({ type: 'webauthn.get', challenge, origin: assertionOrigin }));
+      const count = Buffer.alloc(4); count.writeUInt32BE(++counter);
+      const authData = Buffer.concat([sha(options.rpId), Buffer.from([uv ? 5 : 1]), count]);
+      const signature = sign('sha256', Buffer.concat([authData, sha(client)]), pair.privateKey);
+      if (corrupt) signature[signature.length - 1] ^= 1;
+      return { id, rawId: id, type: 'public-key', clientExtensionResults: {}, response: { clientDataJSON: b64(client), authenticatorData: b64(authData), signature: b64(signature), userHandle: userId } };
+    },
+  };
+}
+function setup(t) {
+  const { app, db } = createApp({ database: ':memory:', origin });
+  t.after(() => db.close());
+  const agent = request.agent(app);
+  return { app, db, agent };
+}
+function call(agent, path, body = {}, method = 'post') { return agent[method](`/api/${path}`).set('Origin', origin).set('X-Requested-With', 'DailyGrind').send(body); }
+async function register(agent, username = 'coffee.fan', key = authenticator()) {
+  const options = await call(agent, 'register/options', { username, displayName: 'Coffee Fan' }).expect(200);
+  const data = await call(agent, 'register/verify', { ceremonyId: options.body.ceremonyId, credential: key.registration(options.body.options) }).expect(200);
+  return { key, data: data.body };
+}
+async function reauth(agent, key, purpose) {
+  const packet = (await call(agent, 'reauth/options', { purpose }).expect(200)).body;
+  return call(agent, 'reauth/verify', { ceremonyId: packet.ceremonyId, credential: key.assertion(packet.options) }).expect(200);
+}
+
+test('real registration and discoverable sign-in persist metadata and rotate the session', async t => {
+  const { agent, db } = setup(t);
+  const { key, data } = await register(agent);
+  assert.equal(data.user.username, 'coffee.fan');
+  assert.equal(data.passkeys.length, 1);
+  assert.equal(data.passkeys[0].publicKey, undefined);
+  assert.equal(data.passkeys[0].lastUsedAt, null);
+  assert.equal(db.prepare('SELECT count(*) AS n FROM users').get().n, 1);
+  await call(agent, 'logout').expect(200);
+  const options = (await call(agent, 'auth/options').expect(200)).body;
+  assert.deepEqual(options.options.allowCredentials, []);
+  const verified = await call(agent, 'auth/verify', { ceremonyId: options.ceremonyId, credential: key.assertion(options.options) }).expect(200);
+  assert.equal(verified.body.user.id, data.user.id);
+  assert.ok(verified.body.passkeys[0].lastUsedAt);
+  assert.match(verified.headers['set-cookie'][0], /HttpOnly/);
+  assert.match(verified.headers['set-cookie'][0], /SameSite=Strict/);
+  assert.equal(db.prepare('SELECT counter FROM passkeys').get().counter, 1);
+});
+
+test('registration challenges are single use and bad origins create no account', async t => {
+  const { agent, db } = setup(t);
+  const key = authenticator();
+  const packet = (await call(agent, 'register/options', { username: 'bad.origin', displayName: 'A' }).expect(200)).body;
+  const body = { ceremonyId: packet.ceremonyId, credential: key.registration(packet.options, { origin: 'https://evil.example' }) };
+  await call(agent, 'register/verify', body).expect(400);
+  await call(agent, 'register/verify', body).expect(400);
+  assert.equal(db.prepare('SELECT count(*) AS n FROM users').get().n, 0);
+});
+
+test('challenge expiry, session binding, signature, origin and user verification are enforced', async t => {
+  const { agent, app, db } = setup(t);
+  const { key } = await register(agent);
+  await call(agent, 'logout');
+  for (const alteration of [{ corrupt: true }, { uv: false }, { origin: 'https://evil.example' }, { challenge: 'wrong' }]) {
+    const packet = (await call(agent, 'auth/options')).body;
+    await call(agent, 'auth/verify', { ceremonyId: packet.ceremonyId, credential: key.assertion(packet.options, alteration) }).expect(400);
+  }
+  const packet = (await call(agent, 'auth/options')).body;
+  const body = { ceremonyId: packet.ceremonyId, credential: key.assertion(packet.options) };
+  await call(request.agent(app), 'auth/verify', body).expect(400);
+  db.prepare('UPDATE ceremonies SET expires = 0').run();
+  await call(agent, 'auth/verify', body).expect(400);
+});
+
+test('successful authentication cannot be replayed', async t => {
+  const { agent } = setup(t);
+  const { key } = await register(agent);
+  await call(agent, 'logout');
+  const packet = (await call(agent, 'auth/options')).body;
+  const body = { ceremonyId: packet.ceremonyId, credential: key.assertion(packet.options) };
+  await call(agent, 'auth/verify', body).expect(200);
+  await call(agent, 'auth/verify', body).expect(400);
+});
+
+test('passkey management requires ownership, fresh scoped verification and preserves the last passkey', async t => {
+  const { agent, app } = setup(t);
+  const { key } = await register(agent);
+  await call(agent, 'register/options').expect(403);
+  await call(agent, `passkeys/${key.id}`, {}, 'delete').expect(409);
+  await reauth(agent, key, 'add-passkey');
+  const second = authenticator();
+  const options = (await call(agent, 'register/options').expect(200)).body;
+  assert.equal(options.options.authenticatorSelection.residentKey, 'required');
+  assert.equal(options.options.authenticatorSelection.authenticatorAttachment, undefined);
+  assert.equal(options.options.excludeCredentials[0].id, key.id);
+  await call(agent, 'register/options').expect(403); // grant consumed
+  await call(agent, 'register/verify', { ceremonyId: options.ceremonyId, credential: second.registration(options.options) }).expect(200);
+  const renamed = await call(agent, `passkeys/${second.id}`, { name: 'Backup security key' }, 'patch').expect(200);
+  assert.ok(renamed.body.passkeys.some(k => k.name === 'Backup security key'));
+  const other = request.agent(app); await register(other, 'other.person');
+  await call(other, `passkeys/${second.id}`, { name: 'Stolen' }, 'patch').expect(404);
+  await call(other, `passkeys/${second.id}`, {}, 'delete').expect(404);
+  await call(agent, `passkeys/${second.id}`, {}, 'delete').expect(403);
+  await reauth(agent, key, 'update-profile');
+  await call(agent, `passkeys/${second.id}`, {}, 'delete').expect(403);
+  await reauth(agent, key, `delete-passkey:${second.id}`);
+  const deleted = await call(agent, `passkeys/${second.id}`, {}, 'delete').expect(200);
+  assert.equal(deleted.body.passkeys.length, 1);
+  await call(agent, `passkeys/${key.id}`, {}, 'delete').expect(409);
+});
+
+test('reauthentication only accepts the active account and never switches accounts', async t => {
+  const { agent, app } = setup(t);
+  const first = await register(agent);
+  const other = request.agent(app); const second = await register(other, 'another.fan');
+  const options = (await call(agent, 'reauth/options', { purpose: 'update-profile' }).expect(200)).body;
+  assert.deepEqual(options.options.allowCredentials.map(c => c.id), [first.key.id]);
+  await call(agent, 'reauth/verify', { ceremonyId: options.ceremonyId, credential: second.key.assertion(options.options) }).expect(403);
+  assert.equal((await agent.get('/api/session')).body.user.id, first.data.user.id);
+});
+
+test('profile updates require a fresh one-use grant, validate input and persist', async t => {
+  const { agent, db } = setup(t);
+  const { key } = await register(agent);
+  await call(agent, 'profile', { displayName: 'New Name' }, 'patch').expect(403);
+  await reauth(agent, key, 'update-profile');
+  db.prepare('UPDATE sessions SET grantExpires = 0').run();
+  await call(agent, 'profile', { displayName: 'New Name' }, 'patch').expect(403);
+  await reauth(agent, key, 'update-profile');
+  const updated = await call(agent, 'profile', { displayName: 'New Name' }, 'patch').expect(200);
+  assert.equal(updated.body.user.displayName, 'New Name');
+  await call(agent, 'profile', { displayName: 'Again' }, 'patch').expect(403);
+  assert.equal((await agent.get('/api/session')).body.user.displayName, 'New Name');
+});
+
+test('CSRF, unauthorized access, validation and unknown credentials return appropriate errors', async t => {
+  const { agent } = setup(t);
+  await agent.post('/api/register/options').send({}).expect(403);
+  await agent.post('/api/logout').set('Origin', 'https://evil.example').set('X-Requested-With', 'DailyGrind').expect(403);
+  await call(agent, 'reauth/options', { purpose: 'update-profile' }).expect(401);
+  await call(agent, 'register/options', { username: 'xx', displayName: 'X' }).expect(400);
+  const options = (await call(agent, 'auth/options')).body;
+  await call(agent, 'auth/verify', { ceremonyId: options.ceremonyId, credential: { id: 'unknown' } }).expect(404);
+});
+
+test('accounts and public keys survive an application restart', async t => {
+  const { mkdtempSync, rmSync } = await import('node:fs');
+  const { tmpdir } = await import('node:os');
+  const directory = mkdtempSync(`${tmpdir()}/daily-grind-test-`);
+  t.after(() => rmSync(directory, { recursive: true, force: true }));
+  const database = `${directory}/test.sqlite`;
+  let server = createApp({ database, origin });
+  const first = await register(request.agent(server.app));
+  server.db.close();
+  server = createApp({ database, origin });
+  t.after(() => server.db.close());
+  const agent = request.agent(server.app);
+  const options = (await call(agent, 'auth/options')).body;
+  const result = await call(agent, 'auth/verify', { ceremonyId: options.ceremonyId, credential: first.key.assertion(options.options) }).expect(200);
+  assert.equal(result.body.user.id, first.data.user.id);
+});
+
+test('the account page and bundled client are served without exposing source or database files', async t => {
+  const { agent } = setup(t);
+  await agent.get('/account').expect('Content-Type', /html/).expect(200);
+  await agent.get('/account.js').expect('Content-Type', /javascript/).expect(200);
+  await agent.get('/server.js').expect(404);
+  await agent.get('/data/daily-grind.sqlite').expect(404);
+});
