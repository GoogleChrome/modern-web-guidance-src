+    CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, userId TEXT REFERENCES users(id), publicKey BLOB NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL, name TEXT NOT NULL, aaguid TEXT, deviceType TEXT, backedUp INTEGER, registeredAt INTEGER NOT NULL, lastUsedAt INTEGER);
