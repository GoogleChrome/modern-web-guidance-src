diff --git a/site.js b/site.js
new file mode 100644
index 0000000..2bbd421
--- /dev/null
+++ b/site.js
@@ -0,0 +1,45 @@
+const dialog = document.querySelector('#product-dialog');
+
+// Keep the original navigation links when native modal dialogs are unavailable.
+if (dialog && typeof dialog.showModal === 'function') {
+  const title = dialog.querySelector('#product-title');
+  const description = dialog.querySelector('#product-description');
+  const productPage = dialog.querySelector('#product-page');
+  let invoker;
+
+  for (const link of document.querySelectorAll('[data-product-details]')) {
+    const card = link.closest('article');
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = link.className;
+    button.append(...link.cloneNode(true).childNodes);
+    button.setAttribute('aria-haspopup', 'dialog');
+    button.setAttribute('aria-controls', dialog.id);
+    button.addEventListener('click', () => {
+      title.textContent = card.querySelector('h3').textContent;
+      description.textContent = card.querySelector('p').textContent;
+      productPage.href = link.href;
+      invoker = button;
+      dialog.showModal();
+    });
+    link.replaceWith(button);
+  }
+
+  // Native dialogs contain focus and handle Escape. Restore the exact invoker
+  // explicitly so every dismissal path returns to the selected product.
+  dialog.addEventListener('close', () => {
+    if (invoker?.isConnected) invoker.focus();
+  });
+
+  // Safari versions without closedby still need backdrop light dismissal.
+  if (!('closedBy' in HTMLDialogElement.prototype)) {
+    dialog.addEventListener('click', (event) => {
+      if (event.target !== dialog) return;
+      const { top, right, bottom, left } = dialog.getBoundingClientRect();
+      if (event.clientX < left || event.clientX > right ||
+          event.clientY < top || event.clientY > bottom) {
+        dialog.close();
+      }
+    });
+  }
+}
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..c8ec5fa
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,272 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+.site-header {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1;
+  flex-wrap: wrap;
+  gap: 1rem;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+  flex-wrap: wrap;
+  gap: 0.5rem 1.25rem;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+  display: inline-block;
+  padding-block: 0.5rem;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  position: relative;
+  isolation: isolate;
+  min-height: 60vh;
+  background: var(--primary);
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 2rem 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  height: 100%;
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  border: 0;
+  font: inherit;
+  cursor: pointer;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  display: inline-block;
+  padding-block: 0.5rem;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+/* Keyboard navigation follows document order. */
+:focus-visible {
+  outline: 3px solid #b65d00;
+  outline-offset: 4px;
+}
+
+.site-header :focus-visible,
+.hero :focus-visible {
+  outline-color: var(--accent);
+}
+
+.skip-link {
+  position: fixed;
+  top: 1rem;
+  left: 1rem;
+  z-index: 2;
+  padding: 0.75rem 1rem;
+  background: white;
+  color: var(--text);
+  transform: translateY(calc(-100% - 2rem));
+}
+
+.skip-link:focus {
+  transform: translateY(0);
+}
+
+.site-header .logo {
+  color: white;
+  text-decoration: none;
+}
+
+.hero-image,
+.hero::after {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  z-index: -1;
+}
+
+.hero-image {
+  object-fit: cover;
+}
+
+.hero::after {
+  content: "";
+  background: rgb(0 0 0 / 50%);
+}
+
+.section-heading {
+  text-align: center;
+}
+
+.grid,
+.footer-links ul {
+  list-style: none;
+}
+
+.footer-links ul {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 0.5rem 1rem;
+}
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+  border: 0;
+}
+
+.product-dialog {
+  margin: auto;
+  width: min(32rem, calc(100% - 2rem));
+  max-height: calc(100% - 2rem);
+  overflow: auto;
+  padding: 2rem;
+  border: 0;
+  border-radius: 8px;
+  color: var(--text);
+  background: white;
+}
+
+.product-dialog::backdrop {
+  background: rgb(0 0 0 / 60%);
+}
+
+.product-dialog h2 {
+  margin-bottom: 1rem;
+}
+
+.dialog-actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 1rem;
+}
+
+@media (max-width: 600px) {
+  .site-header {
+    position: static;
+  }
+
+  .hero h1 {
+    font-size: 2.25rem;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    transition: none !important;
+  }
+}
