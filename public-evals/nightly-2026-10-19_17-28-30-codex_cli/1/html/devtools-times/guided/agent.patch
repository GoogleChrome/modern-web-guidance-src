diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..da6358d
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,38 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  title: string;
+  children: ReactNode;
+  onClose: () => void;
+}
+
+export default function Modal({ id, title, children, onClose }: Props) {
+  const ref = useRef<HTMLDialogElement>(null);
+  useEffect(() => {
+    const dialog = ref.current!;
+    const opener = document.activeElement;
+    dialog.showModal();
+    dialog.querySelector<HTMLElement>('[data-initial-focus]')?.focus();
+    return () => {
+      dialog.close();
+      if (opener instanceof HTMLElement && opener.isConnected) opener.focus();
+    };
+  }, []);
+
+  return (
+    <dialog ref={ref} className="modal" aria-labelledby={`${id}-title`} closedby="any" onClose={onClose}
+      onClick={event => {
+        // Light-dismiss fallback for browsers without closedby support.
+        if (event.target !== event.currentTarget) return;
+        const bounds = event.currentTarget.getBoundingClientRect();
+        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) event.currentTarget.close();
+      }}>
+      <div className="flex items-center justify-between gap-4 border-b border-gray-200 p-4">
+        <h2 id={`${id}-title`} className="text-lg font-semibold">{title}</h2>
+        <form method="dialog"><button type="submit" aria-label={`Close ${title}`} className="p-2">✕</button></form>
+      </div>
+      {children}
+    </dialog>
+  );
+}
