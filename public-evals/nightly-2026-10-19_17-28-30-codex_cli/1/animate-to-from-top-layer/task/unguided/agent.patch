+  <dialog id="logout-dialog" class="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" id="close-dialog-btn" class="close-button" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" id="cancel-logout-btn" class="btn btn-secondary" autofocus>Cancel</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <aside id="ordering-notice" class="notice" aria-labelledby="notice-title" hidden>
+    <button type="button" id="dismiss-notice-btn" class="close-button" aria-label="Dismiss ordering notice">&times;</button>
+    <h2 id="notice-title">Online ordering update</h2>
+    <p role="status" id="notice-message"></p>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const notice = document.getElementById('ordering-notice');
+    const noticeMessage = document.getElementById('notice-message');
+
+    // Keep each surface mounted until its CSS exit animation finishes.
+    function animateClose(surface, finish) {
+      if (surface.classList.contains('is-closing')) return;
+      surface.classList.add('is-closing');
+      function onAnimationEnd(event) {
+        if (event.target !== surface || event.animationName !== 'surface-exit') return;
+        surface.removeEventListener('animationend', onAnimationEnd);
+        finish();
+        surface.classList.remove('is-closing');
+      }
+      surface.addEventListener('animationend', onAnimationEnd);
+    }
+
+    function closeLogoutDialog() {
+      animateClose(logoutDialog, () => logoutDialog.close());
+    }
+
+    logoutLink.addEventListener('click', (event) => {
+      event.preventDefault();
+      if (!logoutDialog.open) logoutDialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeLogoutDialog);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeLogoutDialog);
+    logoutDialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeLogoutDialog();
+    });
+    logoutDialog.addEventListener('click', (event) => {
+      const bounds = logoutDialog.getBoundingClientRect();
+      if (event.target === logoutDialog &&
+          (event.clientX < bounds.left || event.clientX > bounds.right ||
+           event.clientY < bounds.top || event.clientY > bounds.bottom)) {
+        closeLogoutDialog();
+      }
+    });
+
+    orderButton.addEventListener('click', () => {
+      if (notice.classList.contains('is-closing')) return;
+      notice.hidden = false;
+      noticeMessage.textContent = 'online ordering is currently offline';
+      orderButton.setAttribute('aria-expanded', 'true');
+    });
+
+    function dismissNotice() {
+      if (notice.hidden) return;
+      animateClose(notice, () => {
+        const restoreFocus = notice.contains(document.activeElement);
+        notice.hidden = true;
+        noticeMessage.textContent = '';
+        orderButton.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) orderButton.focus();
+      });
+    }
+    document.getElementById('dismiss-notice-btn').addEventListener('click', dismissNotice);
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && !logoutDialog.open) dismissNotice();
+    });
+  </script>
