+  <dialog id="logout-dialog" class="overlay" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" id="close-dialog-btn" class="overlay-close" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" id="cancel-logout-btn" class="btn btn-secondary" autofocus>Cancel</button>
+      <button type="button" id="confirm-logout-btn" class="btn">Yes, log out</button>
+    </div>
+  </dialog>
+
+  <aside id="ordering-notice" class="overlay" popover="manual" aria-labelledby="ordering-title">
+    <button type="button" id="close-notice-btn" class="overlay-close" aria-label="Dismiss ordering notice">&times;</button>
+    <h2 id="ordering-title">Ordering update</h2>
+    <p role="status">online ordering is currently offline</p>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const dialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const notice = document.getElementById('ordering-notice');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+
+    // Keep the notice usable without the Popover API.
+    if (!supportsPopover) notice.hidden = true;
+
+    function reveal(element, show) {
+      if (element.hasAttribute('data-closing')) return;
+      show();
+      // Establish the initial CSS state for browsers without @starting-style.
+      getComputedStyle(element).opacity;
+      element.setAttribute('data-visible', '');
+    }
+
+    async function dismiss(element, hide) {
+      if (!element.hasAttribute('data-visible') || element.hasAttribute('data-closing')) return;
+      element.setAttribute('data-closing', '');
+      // Keep the top layer and backdrop alive until CSS exit transitions finish,
+      // including in browsers without discrete display/overlay transitions.
+      const animations = element.getAnimations({ subtree: true });
+      await Promise.race([
+        Promise.allSettled(animations.map(animation => animation.finished)),
+        new Promise(resolve => setTimeout(resolve, 350))
+      ]);
+      hide();
+      element.removeAttribute('data-visible');
+      element.removeAttribute('data-closing');
+    }
+
+    const closeDialog = () => dismiss(dialog, () => dialog.close());
+    const closeNotice = () => dismiss(notice, () => {
+      const hadFocus = notice.contains(document.activeElement);
+      if (supportsPopover) notice.hidePopover();
+      else notice.hidden = true;
+      orderButton.setAttribute('aria-expanded', 'false');
+      if (hadFocus) orderButton.focus();
+    });
+
+    logoutLink.addEventListener('click', event => {
+      event.preventDefault();
+      closeNotice();
+      if (!dialog.open) reveal(dialog, () => dialog.showModal());
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeDialog);
+    dialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeDialog();
+    });
+    document.getElementById('confirm-logout-btn').addEventListener('click', async () => {
+      if (dialog.hasAttribute('data-closing')) return;
+      await closeDialog();
+      window.location.assign(logoutLink.href);
+    });
+
+    orderButton.addEventListener('click', () => {
+      if (notice.hasAttribute('data-visible')) {
+        closeNotice();
+      } else {
+        reveal(notice, () => {
+          if (supportsPopover) notice.showPopover();
+          else notice.hidden = false;
+        });
+        orderButton.setAttribute('aria-expanded', 'true');
+      }
+    });
+    document.getElementById('close-notice-btn').addEventListener('click', closeNotice);
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && notice.hasAttribute('data-visible')) closeNotice();
+    });
+    document.addEventListener('click', event => {
+      if (!notice.contains(event.target) && !orderButton.contains(event.target)) closeNotice();
+    });
+  </script>
+
