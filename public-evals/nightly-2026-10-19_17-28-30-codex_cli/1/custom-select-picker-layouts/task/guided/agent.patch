+  <script>
+    // Preserve the three-column picker in browsers without customizable selects.
+    if (!CSS.supports('appearance', 'base-select')) {
+      const select = document.querySelector('#roast');
+      const label = document.querySelector('label[for="roast"]');
+      const picker = document.createElement('details');
+      picker.className = 'roast-fallback';
+      const trigger = document.createElement('summary');
+      trigger.id = 'roast';
+      label.id = 'roast-label';
+      label.removeAttribute('for');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-value');
+      const value = document.createElement('span');
+      value.id = 'roast-value';
+      const title = option => option.value[0].toUpperCase() + option.value.slice(1);
+      value.textContent = title(select.selectedOptions[0]);
+      trigger.append(value);
+      const options = document.createElement('div');
+      options.className = 'roast-options';
+      options.setAttribute('role', 'radiogroup');
+      options.setAttribute('aria-labelledby', 'roast-label');
+      for (const option of select.options) {
+        const card = document.createElement('label');
+        card.className = 'roast-card';
+        const input = document.createElement('input');
+        input.type = 'radio';
+        input.name = select.name;
+        input.value = option.value;
+        input.checked = option.selected;
+        const photo = document.createElement('img');
+        photo.className = 'roast-photo';
+        photo.src = option.dataset.photo;
+        photo.alt = '';
+        const name = document.createElement('strong');
+        name.textContent = title(option);
+        const notes = document.createElement('span');
+        notes.className = 'roast-notes';
+        notes.textContent = option.dataset.notes;
+        input.addEventListener('change', () => {
+          value.textContent = title(option);
+          picker.open = false;
+          trigger.focus();
+        });
+        card.append(input, photo, name, notes);
+        options.append(card);
+      }
+      picker.append(trigger, options);
+      select.replaceWith(picker);
+      document.addEventListener('click', event => {
+        if (!picker.contains(event.target)) picker.open = false;
+      });
+      picker.addEventListener('keydown', event => {
+        if (event.key === 'Escape') {
+          picker.open = false;
+          trigger.focus();
+        }
+      });
+    }
+  </script>
