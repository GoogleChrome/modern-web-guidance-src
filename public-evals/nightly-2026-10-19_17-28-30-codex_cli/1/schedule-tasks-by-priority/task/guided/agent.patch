+  <script>
+    (() => {
+      const definitions = {
+        checkout: { label: 'Checkout', priority: 'user-blocking', rank: 0, work: 180 },
+        menu: { label: 'Menu update', priority: 'user-visible', rank: 1, work: 360 },
+        telemetry: { label: 'Telemetry logging', priority: 'background', rank: 2, work: 600 }
+      };
+      const tasks = [];
+      const taskList = document.getElementById('queue-tasks');
+      const log = document.getElementById('activity-log');
+      const status = document.getElementById('queue-status');
+      let sequence = 0;
+      let completed = 0;
+      let draining = false;
+
+      // Local scheduling polyfill: preserve priority and FIFO ordering without
+      // requiring a network dependency in browsers without scheduler.postTask.
+      const fallbackQueue = [];
+      let fallbackScheduled = false;
+      function fallbackPostTask(callback, { priority }) {
+        return new Promise((resolve, reject) => {
+          fallbackQueue.push({ callback, priority, resolve, reject });
+          if (!fallbackScheduled) {
+            fallbackScheduled = true;
+            setTimeout(flushFallback, 0);
+          }
+        });
+      }
+      function flushFallback() {
+        const ranks = { 'user-blocking': 0, 'user-visible': 1, background: 2 };
+        fallbackQueue.sort((a, b) => ranks[a.priority] - ranks[b.priority]);
+        const task = fallbackQueue.shift();
+        try { task.resolve(task.callback()); } catch (error) { task.reject(error); }
+        fallbackScheduled = fallbackQueue.length > 0;
+        if (fallbackScheduled) setTimeout(flushFallback, 0);
+      }
+      const postTask = typeof window.scheduler?.postTask === 'function'
+        ? window.scheduler.postTask.bind(window.scheduler) : fallbackPostTask;
+      const yieldToBrowser = () => typeof window.scheduler?.yield === 'function'
+        ? window.scheduler.yield() : new Promise(resolve => setTimeout(resolve, 0));
+
+      function record(message) {
+        const item = document.createElement('li');
+        item.textContent = message;
+        log.append(item);
+        if (log.children.length > 30) log.firstElementChild.remove();
+        log.scrollTop = log.scrollHeight;
+      }
+
+      function render() {
+        document.getElementById('queue-counts').textContent = `${tasks.length} pending · ${completed} completed`;
+        document.getElementById('queue-empty').hidden = tasks.length > 0;
+        for (const task of tasks) {
+          task.state.textContent = `${task.started ? 'Paused' : 'Queued'} · ${task.priority}`;
+          task.progress.value = task.done;
+          taskList.append(task.row);
+        }
+        if (tasks.length) tasks[0].state.textContent = `Running · ${tasks[0].priority}`;
+      }
+
+      function enqueue(types) {
+        for (const type of types) {
+          const task = { ...definitions[type], id: ++sequence, done: 0, started: false };
+          task.row = document.createElement('li');
+          task.row.className = 'queue-task';
+          const label = document.createElement('div');
+          label.className = 'task-label';
+          const name = document.createElement('strong');
+          name.textContent = `${task.label} #${task.id}`;
+          task.state = document.createElement('span');
+          task.progress = document.createElement('progress');
+          task.progress.max = task.work;
+          task.progress.value = 0;
+          task.progress.setAttribute('aria-label', `${task.label} #${task.id} progress`);
+          label.append(name, task.state);
+          task.row.append(label, task.progress);
+          tasks.push(task);
+        }
+        tasks.sort((a, b) => a.rank - b.rank || a.id - b.id);
+        status.textContent = `${types.length === 1 ? 'Task' : 'Mixed batch'} added. ${tasks.length} tasks pending.`;
+        render();
+        void drain();
+      }
+
+      async function drain() {
+        if (draining) return;
+        draining = true;
+        try {
+          while (tasks.length) {
+            const task = tasks[0];
+            await postTask(() => {
+              // Recheck after scheduling: an urgent task may have arrived.
+              if (tasks[0] !== task) return;
+              if (!task.started) {
+                task.started = true;
+                record(`Started ${task.label} #${task.id} · ${task.priority}`);
+              }
+              // Simulate CPU work with an 8ms budget, well below a long task.
+              const start = performance.now();
+              const budget = Math.min(8, task.work - task.done);
+              while (performance.now() - start < budget) { /* simulated processing */ }
+              task.done += budget;
+              if (task.done >= task.work) {
+                tasks.shift();
+                task.row.remove();
+                completed++;
+                record(`Completed ${task.label} #${task.id}`);
+                status.textContent = `${task.label} #${task.id} complete. ${tasks.length} tasks remaining.`;
+              }
+              render();
+            }, { priority: task.priority });
+            // Yield between chunks so input, paints and urgent work can run.
+            await yieldToBrowser();
+          }
+          status.textContent = `Queue clear. ${completed} tasks completed. Ready for the next rush.`;
+        } catch (error) {
+          status.textContent = 'Processing paused. Add a task to retry the queue.';
+          console.error('Operations queue failed:', error);
+        } finally {
+          draining = false;
+        }
+      }
+
+      document.querySelectorAll('[data-operation]').forEach(button => {
+        button.addEventListener('click', () => enqueue([button.dataset.operation]));
+      });
+      document.getElementById('run-batch').addEventListener('click', () => {
+        enqueue(['telemetry', 'menu', 'checkout']);
+      });
+    })();
+  </script>
 </body>
 
