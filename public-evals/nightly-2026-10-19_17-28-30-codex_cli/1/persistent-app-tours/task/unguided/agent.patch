+  <aside id="tour-step" aria-labelledby="tour-title">
+    <h2 id="tour-title">Your coffee comes with perks</h2>
+    <p id="tour-message">Earn points with every order and turn your daily coffee into delicious rewards.</p>
+    <button type="button" class="btn" id="close-tour">Got it</button>
+  </aside>
+
+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTour = document.getElementById('close-tour');
+    let trackingFrame;
+
+    // Track the actual link on every frame, including scroll, resize and layout shifts.
+    function positionTour() {
+      if (tourStep.hidden) return;
+      const link = rewardsLink.getBoundingClientRect();
+      const width = tourStep.getBoundingClientRect().width;
+      const center = link.left + link.width / 2;
+      const left = Math.max(16, Math.min(center - width / 2, document.documentElement.clientWidth - width - 16));
+      tourStep.style.left = `${left}px`;
+      tourStep.style.top = `${link.bottom + 18}px`;
+      tourStep.style.setProperty('--arrow-left', `${Math.max(14, Math.min(width - 14, center - left))}px`);
+      trackingFrame = requestAnimationFrame(positionTour);
+    }
+
+    rewardsLink.addEventListener('click', (event) => {
+      if (!tourStep.hidden) event.preventDefault();
+    });
+    rewardsLink.addEventListener('auxclick', (event) => {
+      if (!tourStep.hidden) event.preventDefault();
+    });
+    closeTour.addEventListener('click', () => {
+      tourStep.hidden = true;
+      rewardsLink.setAttribute('aria-expanded', 'false');
+      rewardsLink.removeAttribute('aria-describedby');
+      cancelAnimationFrame(trackingFrame);
+      rewardsLink.focus({ preventScroll: true });
+    });
+
+    positionTour();
+  </script>
+
