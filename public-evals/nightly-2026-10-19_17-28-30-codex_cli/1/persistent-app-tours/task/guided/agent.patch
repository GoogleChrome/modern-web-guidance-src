+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTourButton = tourStep.querySelector('button');
+    const hasPopover = 'popover' in HTMLElement.prototype;
+    const hasAnchors = CSS.supports('anchor-name: --rewards') && CSS.supports('top: anchor(bottom)');
+    let tourOpen = true;
+    let trackingFrame;
+
+    // Keep the fallback tethered even when layout shifts without a scroll or resize.
+    function trackRewards() {
+      const target = rewardsLink.getBoundingClientRect();
+      const left = Math.max(12, Math.min(target.right - tourStep.offsetWidth,
+        document.documentElement.clientWidth - tourStep.offsetWidth - 12));
+      Object.assign(tourStep.style, {
+        top: `${target.bottom + 14}px`, left: `${left}px`, right: 'auto', margin: '0'
+      });
+      trackingFrame = requestAnimationFrame(trackRewards);
+    }
+
+    for (const eventName of ['click', 'auxclick']) {
+      rewardsLink.addEventListener(eventName, (event) => {
+        if (tourOpen) event.preventDefault();
+      });
+    }
+
+    closeTourButton.addEventListener('click', () => {
+      tourOpen = false;
+      cancelAnimationFrame(trackingFrame);
+      if (hasPopover) tourStep.hidePopover();
+      tourStep.hidden = true;
+      rewardsLink.focus({ preventScroll: true });
+    });
+
+    tourStep.hidden = false;
+    if (hasPopover) tourStep.showPopover();
+    if (!hasAnchors) trackRewards();
+    closeTourButton.focus({ preventScroll: true });
+  </script>
 </body>
 
