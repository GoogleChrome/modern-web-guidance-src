+import { ml_dsa65 } from '@noble/post-quantum/ml-dsa.js';
+export const encode = (text) => new TextEncoder().encode(text);
+export function toBase64(bytes) { return btoa(Array.from(new Uint8Array(bytes), b => String.fromCharCode(b)).join('')); }
+export function fromBase64(text) { return Uint8Array.from(atob(text.trim().replace(/\s/g, '')), c => c.charCodeAt(0)); }
+const params = (suite) => suite === 'ECDSA' ? { name: 'ECDSA', hash: 'SHA-256' } : suite;
+export async function generateKey(name, algorithm) {
+  if (!['Ed25519','ECDSA','ML-DSA-65'].includes(algorithm)) throw new Error('Unsupported algorithm.');
+  if (algorithm === 'ML-DSA-65') {
+    const pair = ml_dsa65.keygen();
+    return {name, algorithm, privateKey:pair.secretKey, publicBytes:pair.publicKey};
+  }
+  const pair = await crypto.subtle.generateKey(algorithm === 'ECDSA' ? {name:'ECDSA',namedCurve:'P-256'} : 'Ed25519', false, ['sign','verify']);
+  return {name,algorithm,privateKey:pair.privateKey,publicKey:pair.publicKey,publicBytes:new Uint8Array(await crypto.subtle.exportKey('raw',pair.publicKey))};
+}
+export async function importPublic(data) {
+  if (!data || typeof data.name !== 'string' || !data.name.trim() || !['Ed25519','ECDSA','ML-DSA-65'].includes(data.algorithm) || typeof data.publicKey !== 'string') throw new Error('Invalid Signet public key.');
+  const key = {name:data.name.slice(0,50),algorithm:data.algorithm,publicBytes:fromBase64(data.publicKey)};
+  const size = {'Ed25519':32,'ECDSA':65,'ML-DSA-65':1952}[key.algorithm];
+  if(key.publicBytes.length !== size) throw new Error('Public key size does not match the algorithm.');
+  if(key.algorithm !== 'ML-DSA-65') key.publicKey = await crypto.subtle.importKey('raw',key.publicBytes,key.algorithm === 'ECDSA' ? {name:'ECDSA',namedCurve:'P-256'} : 'Ed25519',true,['verify']);
+  return key;
+}
+export function exportPublic(key) {return {format:'signet-public-v1',name:key.name,algorithm:key.algorithm,publicKey:toBase64(key.publicBytes)};}
+export async function sign(key,bytes) {
+  if(!key.privateKey) throw new Error('This is a public key. Select a signing key with a private key.');
+  return key.algorithm === 'ML-DSA-65' ? ml_dsa65.sign(bytes,key.privateKey) : new Uint8Array(await crypto.subtle.sign(params(key.algorithm),key.privateKey,bytes));
+}
+export async function verify(key,signature,bytes) {
+  return key.algorithm === 'ML-DSA-65' ? ml_dsa65.verify(signature,bytes,key.publicBytes) : crypto.subtle.verify(params(key.algorithm),key.publicKey,signature,bytes);
+}
+export async function fingerprint(key) {const hash = new Uint8Array(await crypto.subtle.digest('SHA-256',key.publicBytes));return [...hash.slice(0,12)].map(x=>x.toString(16).padStart(2,'0')).join('').match(/.{4}/g).join(' ');}
