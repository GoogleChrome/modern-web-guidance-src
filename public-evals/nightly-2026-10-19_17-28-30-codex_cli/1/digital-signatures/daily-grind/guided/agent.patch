+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {generateKey,sign,verify,importPublic,exportPublic,encode,toBase64,fromBase64} from './crypto.js';
+for (const suite of ['Ed25519','ECDSA','ML-DSA-65']) test(`${suite}: verify original; reject changed bytes, other key and changed signature`,async()=>{
+ const key=await generateKey('Test key',suite);const bytes=encode('A little proof. A lot of trust.');const sig=await sign(key,bytes);const publicKey=await importPublic(exportPublic(key));
+ assert.equal(await verify(publicKey,fromBase64(toBase64(sig)),bytes),true);
+ assert.equal(await verify(publicKey,sig,encode('A little proof. A lot of trust!')),false);
+ const other=await generateKey('Other',suite);assert.equal(await verify(other,sig,bytes),false);
+ const tampered=sig.slice();tampered[10]^=1;assert.equal(await verify(publicKey,tampered,bytes),false);
+ await assert.rejects(()=>sign(publicKey,bytes));
+ if(suite!=='ML-DSA-65')assert.equal(key.privateKey.extractable,false);
+ const file=new Uint8Array([0,255,128,0,13,10]);assert.equal(await verify(publicKey,await sign(key,file),file),true);
+});
+test('Malformed and unsupported public keys are rejected',async()=>{await assert.rejects(()=>importPublic({name:'bad',algorithm:'RSA',publicKey:'AA=='}));await assert.rejects(()=>importPublic({name:'bad',algorithm:'Ed25519',publicKey:'AA=='}));});
