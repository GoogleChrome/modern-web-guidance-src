index 0000000..d12922f
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,136 @@
+---
+interface Props {
+    sections: { id: string; label: string }[];
+}
+
+const { sections } = Astro.props;
+---
+
+<nav class="section-nav" aria-label="On this page" data-section-nav>
+    <span class="section-nav-label" aria-hidden="true">On this page</span>
+    {sections.map(({ id, label }) => <a href={`#${id}`}>{label}</a>)}
+</nav>
+
+<style>
+    .section-nav {
+        position: sticky;
+        top: 0;
+        z-index: 20;
+        display: flex;
+        align-items: stretch;
+        gap: clamp(1rem, 3vw, 2rem);
+        overflow-x: auto;
+        padding-inline: 1.5rem;
+        border-bottom: 1px solid #d1d5db;
+        background: white;
+        scroll-target-group: auto;
+    }
+
+    .section-nav-label,
+    a {
+        flex-shrink: 0;
+        padding-block: 1rem;
+        font-size: 0.875rem;
+        line-height: 1.25rem;
+        white-space: nowrap;
+    }
+
+    .section-nav-label { color: #6b7280; }
+
+    a {
+        border-bottom: 3px solid transparent;
+        color: #4b5563;
+        font-weight: 600;
+        text-decoration: none;
+    }
+
+    a:hover { color: #111827; }
+
+    a:focus-visible {
+        outline: 2px solid #92400e;
+        outline-offset: -5px;
+    }
+
+    a:is(:target-current, .is-current) {
+        border-bottom-color: #b45309;
+        color: #92400e;
+    }
+
+    @media (max-width: 480px) {
+        .section-nav { padding-inline: 1rem; }
+        .section-nav-label { display: none; }
+    }
+</style>
+
+<style is:global>
+    :is(#top-stories, #top-news, #world, #politics) {
+        scroll-margin-top: 4.5rem;
+    }
+</style>
+
+<script>
+    function initializeSectionNav() {
+        const nav = document.querySelector<HTMLElement>('[data-section-nav]');
+        if (!nav) return;
+
+        const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
+        const targets = links.map(link => document.getElementById(link.hash.slice(1)));
+        const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+            CSS.supports('selector(:target-current)');
+        let frame = 0;
+
+        function updateCurrent() {
+            frame = 0;
+            let current = nativeTracking
+                ? links.find(link => link.matches(':target-current'))
+                : undefined;
+
+            if (!nativeTracking) {
+                // Keep the preceding section selected through gaps between sections.
+                const activationLine = nav!.getBoundingClientRect().height + 24;
+                current = links[0];
+                targets.forEach((target, index) => {
+                    if (target && target.getBoundingClientRect().top <= activationLine) {
+                        current = links[index];
+                    }
+                });
+                // Short final sections may never reach the activation line.
+                if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
+                    current = links.at(-1);
+                }
+            }
+
+            links.forEach(link => {
+                const active = link === current;
+                link.classList.toggle('is-current', !nativeTracking && active);
+                if (active) link.setAttribute('aria-current', 'location');
+                else link.removeAttribute('aria-current');
+            });
+        }
+
+        function scheduleUpdate() {
+            if (!frame) frame = requestAnimationFrame(updateCurrent);
+        }
+
+        // IntersectionObserver also catches content shifts caused by loaded images.
+        const observer = !nativeTracking ? new IntersectionObserver(scheduleUpdate, {
+            rootMargin: '-72px 0px -50% 0px',
+            threshold: 0,
+        }) : null;
+        targets.forEach(target => { if (target) observer?.observe(target); });
+        window.addEventListener('scroll', scheduleUpdate, { passive: true });
+        window.addEventListener('resize', scheduleUpdate);
+        document.addEventListener('scrollend', scheduleUpdate);
+        scheduleUpdate();
+
+        document.addEventListener('astro:before-swap', () => {
+            observer?.disconnect();
+            cancelAnimationFrame(frame);
+            window.removeEventListener('scroll', scheduleUpdate);
+            window.removeEventListener('resize', scheduleUpdate);
+            document.removeEventListener('scrollend', scheduleUpdate);
+        }, { once: true });
+    }
+
+    document.addEventListener('astro:page-load', initializeSectionNav);
+</script>
