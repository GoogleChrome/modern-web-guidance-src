+  <script type="module">
+    const nav = document.querySelector('nav');
+    const links = [...nav.querySelectorAll('a[href^="#"]')];
+    const sections = links.map(link => document.getElementById(link.hash.slice(1)));
+    const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(:target-current)');
+    let pendingFrame = null;
+
+    function updateCurrentSection() {
+      pendingFrame = null;
+      let currentLink;
+
+      if (nativeTracking) {
+        currentLink = nav.querySelector('a:target-current');
+      } else {
+        const readingLine = nav.getBoundingClientRect().bottom + 1;
+        let currentIndex = 0;
+        sections.forEach((section, index) => {
+          if (section.getBoundingClientRect().top <= readingLine) currentIndex = index;
+        });
+        // Short final sections may never reach the sticky navigation.
+        if (window.scrollY > 0 &&
+            window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
+          currentIndex = sections.length - 1;
+        }
+        currentLink = links[currentIndex];
+      }
+
+      links.forEach(link => {
+        if (link === currentLink) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    function scheduleUpdate() {
+      if (pendingFrame === null) pendingFrame = requestAnimationFrame(updateCurrentSection);
+    }
+
+    // Account for wrapped navigation and changes in text size when following anchors.
+    const navObserver = new ResizeObserver(() => {
+      document.documentElement.style.setProperty('--nav-height', `${nav.offsetHeight}px`);
+      scheduleUpdate();
+    });
+    navObserver.observe(nav);
+
+    if (!nativeTracking) {
+      const sectionObserver = new IntersectionObserver(scheduleUpdate);
+      sections.forEach(section => sectionObserver.observe(section));
+    }
+
+    document.addEventListener('scroll', scheduleUpdate, { passive: true });
+    document.addEventListener('scrollend', scheduleUpdate);
+    window.addEventListener('resize', scheduleUpdate);
+    window.addEventListener('hashchange', scheduleUpdate);
+    window.addEventListener('pageshow', scheduleUpdate);
+    scheduleUpdate();
+  </script>
+
 </body>
 
