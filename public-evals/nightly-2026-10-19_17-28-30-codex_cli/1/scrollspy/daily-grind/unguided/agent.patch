+  <script>
+    const navigation = document.querySelector('nav');
+    const sectionLinks = [...navigation.querySelectorAll('a[href^="#"]')]
+      .map(link => ({ link, section: document.getElementById(link.hash.slice(1)) }))
+      .filter(({ section }) => section);
+    let updatePending = false;
+
+    function updateCurrentSection() {
+      updatePending = false;
+      const navBottom = navigation.getBoundingClientRect().bottom;
+      let currentLink = null;
+      let largestVisibleHeight = 0;
+
+      for (const { link, section } of sectionLinks) {
+        const bounds = section.getBoundingClientRect();
+        const visibleHeight = Math.min(bounds.bottom, window.innerHeight)
+          - Math.max(bounds.top, navBottom);
+        if (visibleHeight > largestVisibleHeight) {
+          largestVisibleHeight = visibleHeight;
+          currentLink = link;
+        }
+      }
+
+      for (const { link } of sectionLinks) {
+        if (link === currentLink) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      }
+    }
+
+    function scheduleUpdate() {
+      if (updatePending) return;
+      updatePending = true;
+      requestAnimationFrame(updateCurrentSection);
+    }
+
+    new ResizeObserver(() => {
+      document.documentElement.style.setProperty('--nav-height', `${navigation.offsetHeight}px`);
+      scheduleUpdate();
+    }).observe(navigation);
+    window.addEventListener('scroll', scheduleUpdate, { passive: true });
+    window.addEventListener('resize', scheduleUpdate);
+    window.addEventListener('pageshow', scheduleUpdate);
+    updateCurrentSection();
+  </script>
+
 </body>
 
