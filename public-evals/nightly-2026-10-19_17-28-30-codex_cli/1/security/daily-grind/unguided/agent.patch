+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const { createServer } = require('../server');
+
+async function start(t, options = {}) {
+  const server = createServer({ cspMode: 'report-only', onViolation: () => {}, ...options });
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => new Promise((resolve) => server.close(resolve)));
+  return (path = '/', { method = 'GET', headers = {}, body } = {}) => new Promise((resolve, reject) => {
+    const req = http.request({ host: '127.0.0.1', port: server.address().port, path, method, headers }, (res) => {
+      let text = '';
+      res.setEncoding('utf8');
+      res.on('data', (chunk) => { text += chunk; });
+      res.on('end', () => resolve({ status: res.statusCode, headers: res.headers, text }));
+    });
+    req.on('error', reject);
+    req.end(body);
+  });
+}
+
+function checkHeaders(response) {
+  assert.equal(response.headers['x-content-type-options'], 'nosniff');
+  assert.equal(response.headers['x-frame-options'], 'DENY');
+  assert.equal(response.headers['referrer-policy'], 'no-referrer');
+  assert.equal(response.headers['cache-control'], 'no-store');
+  assert.match(response.headers['permissions-policy'], /camera=\(\)/);
+  assert.match(response.headers['content-security-policy'], /frame-ancestors 'none'/);
+}
+
+test('report-only rollout keeps baseline protections on pages, assets and errors', async (t) => {
+  const request = await start(t);
+  for (const path of ['/', '/menu', '/account', '/logout', '/styles.css', '/missing']) {
+    const response = await request(path);
+    checkHeaders(response);
+    assert.match(response.headers['content-security-policy-report-only'], /default-src 'none'/);
+    assert.equal(response.headers['strict-transport-security'], undefined);
+  }
+  const home = await request();
+  assert.match(home.text, /href="\/styles.css"/);
+  assert.doesNotMatch(home.text, /<style\b|\sstyle=|<script\b|\son\w+=/i);
+  const css = await request('/styles.css');
+  assert.match(css.headers['content-type'], /^text\/css/);
+  const urls = [...css.text.matchAll(/url\(['"]?([^'"\)]+)/g)].map((match) => new URL(match[1]));
+  assert.ok(urls.length > 0);
+  for (const url of urls) {
+    assert.equal(url.origin, 'https://images.unsplash.com');
+    assert.ok(home.headers['content-security-policy-report-only'].includes(url.origin));
+  }
+});
+
+test('enforcement enables the candidate policy without unsafe exceptions', async (t) => {
+  const request = await start(t, { cspMode: 'enforce' });
+  const response = await request();
+  const policy = response.headers['content-security-policy'];
+  assert.match(policy, /script-src 'none'/);
+  assert.match(policy, /style-src 'self'/);
+  assert.match(policy, /report-uri \/csp-report/);
+  assert.doesNotMatch(policy, /unsafe-inline|unsafe-eval|\*/);
+  assert.equal(response.headers['content-security-policy-report-only'], undefined);
+});
+
+test('HSTS requires explicit configuration and supports max-age=0 rollback', async (t) => {
+  for (const age of ['300', '0']) {
+    const request = await start(t, { hstsMaxAge: age });
+    assert.equal((await request()).headers['strict-transport-security'], `max-age=${age}`);
+  }
+  const request = await start(t);
+  assert.equal((await request('/', { headers: { 'X-Forwarded-Proto': 'https' } })).headers['strict-transport-security'], undefined);
+  for (const cspMode of ['off', 'enforced', '']) assert.throws(() => createServer({ cspMode }));
+  for (const hstsMaxAge of ['-1', 'abc', '63072001', '']) assert.throws(() => createServer({ hstsMaxAge }));
+});
+
+test('routes and methods are restricted; malformed requests cannot crash the server', async (t) => {
+  const request = await start(t);
+  for (const path of ['/server.js', '/package.json', '/.env', '/../../etc/passwd', '/unknown']) {
+    assert.equal((await request(path)).status, 404);
+  }
+  for (const path of ['//evil.example/', '/\\evil.example/', 'http://evil.example/']) {
+    const response = await request(path);
+    assert.equal(response.status, 400);
+    checkHeaders(response);
+  }
+  assert.equal((await request('/', { headers: { Host: '[malformed' } })).status, 200);
+  const post = await request('/', { method: 'POST', body: 'anything' });
+  assert.equal(post.status, 405);
+  assert.equal(post.headers.allow, 'GET, HEAD');
+  const head = await request('/', { method: 'HEAD' });
+  assert.equal(head.status, 200);
+  assert.equal(head.text, '');
+  assert.equal((await request()).status, 200);
+});
+
+test('CSP reporting validates, bounds, rate limits and sanitizes untrusted reports', async (t) => {
+  const logged = [];
+  const request = await start(t, { onViolation: (directive) => logged.push(directive) });
+  const report = (body, type = 'application/csp-report') => request('/csp-report', {
+    method: 'POST', headers: { 'Content-Type': type }, body,
+  });
+  assert.equal((await request('/csp-report')).status, 405);
+  assert.equal((await report('{}', 'text/plain')).status, 415);
+  assert.equal((await report('{')).status, 400);
+  assert.equal((await report('null')).status, 400);
+  assert.equal((await report('{}')).status, 400);
+  assert.equal((await report('x'.repeat(16385))).status, 413);
+  assert.equal((await report(JSON.stringify({ 'csp-report': {
+    'effective-directive': 'script-src-elem', 'document-uri': 'https://example.com/?secret=123',
+    'script-sample': 'private data',
+  } }))).status, 204);
+  assert.equal((await report(JSON.stringify([{ type: 'csp-violation', body: { effectiveDirective: 'style-src-elem' } }]), 'application/reports+json')).status, 204);
+  assert.equal((await report(JSON.stringify({ 'csp-report': { 'effective-directive': 'bad\nlog injection' } }))).status, 204);
+  assert.deepEqual(logged, ['script-src-elem', 'style-src-elem']);
+  let response;
+  for (let i = 0; i < 60; i++) response = await report('{}');
+  assert.equal(response.status, 429);
+  assert.equal(response.headers['retry-after'], '60');
+  checkHeaders(response);
+  assert.equal((await request()).status, 200);
+});
