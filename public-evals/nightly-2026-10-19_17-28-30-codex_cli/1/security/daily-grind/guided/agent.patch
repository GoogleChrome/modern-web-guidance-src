diff --git a/test/security.test.js b/test/security.test.js
new file mode 100644
index 0000000..589a489
--- /dev/null
+++ b/test/security.test.js
@@ -0,0 +1,158 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const fs = require('node:fs');
+const { createServer, configuration } = require('../server');
+
+async function start(t, env = {}, logger = () => {}) {
+  const server = createServer({ env, logger });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => new Promise(resolve => server.close(resolve)));
+  return (path = '/', options = {}) => new Promise((resolve, reject) => {
+    const req = http.request({ hostname: '127.0.0.1', port: server.address().port, path, ...options }, res => {
+      const chunks = [];
+      res.on('data', chunk => chunks.push(chunk));
+      res.on('end', () => resolve({ status: res.statusCode, headers: res.headers, body: Buffer.concat(chunks).toString() }));
+    });
+    req.on('error', reject);
+    req.end(options.body);
+  });
+}
+
+const postReport = data => ({ method: 'POST', headers: { 'content-type': 'application/reports+json' }, body: JSON.stringify(data) });
+const report = { type: 'csp-violation', body: { effectiveDirective: 'script-src-elem', disposition: 'enforce' } };
+
+test('enforces restrictive policies and serves compatible HTML/CSS on all existing pages', async t => {
+  const request = await start(t);
+  for (const path of ['/', '/menu', '/locations', '/rewards', '/account', '/order-online', '/menu/seasonal', '/menu/espresso', '/menu/cold-brew', '/about', '/careers', '/contact', '/privacy-policy']) {
+    const res = await request(path);
+    assert.equal(res.status, 200);
+    const csp = res.headers['content-security-policy'];
+    for (const directive of ["default-src 'none'", "script-src 'none' 'report-sample'", "style-src 'self'", "style-src-attr 'none'", "img-src 'self' https://images.unsplash.com", "frame-ancestors 'self'", "require-trusted-types-for 'script'", "trusted-types 'none'", 'report-to default', 'report-uri /security-reports']) assert.ok(csp.includes(directive), directive);
+    assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval/);
+    assert.doesNotMatch(res.body, /<script\b|<style\b|\sstyle=|\son\w+=/i);
+    assert.match(res.body, /href="\/styles.css"/);
+    assert.match(res.body, /action="\/logout" method="post"/);
+    assert.equal(res.headers['x-content-type-options'], 'nosniff');
+    assert.equal(res.headers['x-frame-options'], 'SAMEORIGIN');
+    assert.equal(res.headers['cross-origin-opener-policy'], 'same-origin-allow-popups');
+    assert.equal(res.headers['cross-origin-resource-policy'], 'same-origin');
+    assert.equal(res.headers['referrer-policy'], 'strict-origin-when-cross-origin');
+    assert.match(res.headers['permissions-policy'], /camera=\(\)/);
+    assert.equal(res.headers['strict-transport-security'], undefined);
+    assert.equal(res.headers['cross-origin-embedder-policy'], undefined);
+    assert.equal(res.headers['access-control-allow-origin'], undefined);
+  }
+  const css = await request('/styles.css');
+  assert.equal(css.status, 200);
+  assert.match(css.headers['content-type'], /^text\/css/);
+  assert.match(css.body, /https:\/\/images\.unsplash\.com\//);
+  assert.equal(css.body, fs.readFileSync('styles.css', 'utf8'));
+  assert.equal((await request('/', { method: 'HEAD' })).body, '');
+});
+
+test('report-only mode retains baseline protection, endpoint, and COOP telemetry', async t => {
+  const request = await start(t, { SECURITY_POLICY_MODE: 'report-only' });
+  const res = await request();
+  assert.match(res.headers['content-security-policy-report-only'], /require-trusted-types-for/);
+  assert.match(res.headers['content-security-policy'], /frame-ancestors/);
+  assert.doesNotMatch(res.headers['content-security-policy'], /script-src/);
+  assert.equal(res.headers['cross-origin-opener-policy'], undefined);
+  assert.match(res.headers['cross-origin-opener-policy-report-only'], /report-to="default"/);
+  assert.equal(res.headers['reporting-endpoints'], 'default="http://localhost:11222/security-reports"');
+});
+
+test('HTTPS config starts with short HSTS and ignores attacker-supplied forwarding headers', async t => {
+  const request = await start(t, { NODE_ENV: 'production', PUBLIC_ORIGIN: 'https://coffee.example' });
+  const res = await request('/', { headers: { Host: 'evil.example', 'X-Forwarded-Proto': 'http' } });
+  assert.equal(res.headers['strict-transport-security'], 'max-age=300');
+  assert.equal(res.headers['reporting-endpoints'], 'default="https://coffee.example/security-reports"');
+  const local = await start(t);
+  assert.equal((await local('/', { headers: { 'X-Forwarded-Proto': 'https' } })).headers['strict-transport-security'], undefined);
+});
+
+test('invalid deployment configuration fails closed', () => {
+  for (const env of [
+    { SECURITY_POLICY_MODE: 'disabled' }, { PORT: '12bad' }, { PORT: '-1' },
+    { HSTS_MAX_AGE: '-1' }, { HSTS_MAX_AGE: 'Infinity' },
+    { PUBLIC_ORIGIN: 'https://user:pass@example.com' }, { PUBLIC_ORIGIN: 'https://example.com/path' },
+    { PUBLIC_ORIGIN: 'https://example.com?token=secret' }, { PUBLIC_ORIGIN: 'file:///' },
+    { NODE_ENV: 'production' }, { NODE_ENV: 'production', PUBLIC_ORIGIN: 'http://example.com' },
+  ]) assert.throws(() => configuration(env), JSON.stringify(env));
+});
+
+test('Fetch Metadata blocks cross-site and sibling-site subresources while preserving navigation and legacy GETs', async t => {
+  const request = await start(t);
+  for (const site of ['cross-site', 'same-site']) {
+    const blocked = await request('/styles.css', { headers: { 'Sec-Fetch-Site': site, 'Sec-Fetch-Mode': 'no-cors', 'Sec-Fetch-Dest': 'style' } });
+    assert.equal(blocked.status, 403);
+    assert.match(blocked.headers.vary, /Sec-Fetch-Site/);
+    assert.match(blocked.headers.vary, /Sec-Fetch-Mode/);
+    assert.match(blocked.headers.vary, /Sec-Fetch-Dest/);
+    assert.equal((await request('/', { headers: { 'Sec-Fetch-Site': site, 'Sec-Fetch-Mode': 'navigate', 'Sec-Fetch-Dest': 'document' } })).status, 200);
+  }
+  assert.equal((await request()).status, 200);
+  assert.equal((await request('/styles.css', { headers: { 'Sec-Fetch-Site': 'same-origin' } })).status, 200);
+});
+
+test('logout requires a same-origin POST and GET/HEAD are side-effect free', async t => {
+  const request = await start(t, { PUBLIC_ORIGIN: 'https://coffee.example' });
+  for (const path of ['/logout', '/logout/']) {
+    for (const method of ['GET', 'HEAD']) {
+      const res = await request(path, { method });
+      assert.equal(res.status, 200);
+      assert.equal(res.headers['clear-site-data'], undefined);
+    }
+    for (const origin of [undefined, 'https://evil.example', 'null', 'https://coffee.example.evil.example']) {
+      const res = await request(path, { method: 'POST', headers: origin ? { Origin: origin } : {} });
+      assert.equal(res.status, 403);
+      assert.equal(res.headers['clear-site-data'], undefined);
+    }
+    const res = await request(path, { method: 'POST', headers: { Origin: 'https://coffee.example' } });
+    assert.equal(res.status, 200);
+    assert.equal(res.headers['clear-site-data'], '"cookies", "storage", "cache"');
+    assert.equal(res.headers['cache-control'], 'no-store');
+    assert.equal((await request(path, { method: 'POST', headers: { Origin: 'https://coffee.example', 'Sec-Fetch-Site': 'cross-site' } })).status, 403);
+  }
+});
+
+test('report ingestion accepts modern/legacy formats without logging sensitive data', async t => {
+  const logs = [];
+  const request = await start(t, {}, message => logs.push(message));
+  const modern = { ...report, url: 'https://user:secret@example.com/private?token=secret', user_agent: 'secret', body: { ...report.body, sample: 'secret', sourceFile: '/secret', blockedURL: 'https://secret.example' } };
+  assert.equal((await request('/security-reports', postReport([modern]))).status, 204);
+  const legacy = { 'csp-report': { 'effective-directive': 'img-src', disposition: 'report', 'document-uri': '/?token=secret', 'script-sample': 'secret' } };
+  assert.equal((await request('/security-reports', { ...postReport(legacy), headers: { 'content-type': 'application/csp-report', 'Sec-Fetch-Site': 'cross-site' } })).status, 204);
+  assert.equal(logs.length, 2);
+  assert.doesNotMatch(logs.join(''), /secret|token|example\.com|user_agent|sourceFile|sample/);
+  assert.deepEqual(JSON.parse(logs[0]).reports[0], { type: 'csp-violation', directive: 'script-src-elem', disposition: 'enforce' });
+});
+
+test('report endpoint rejects malformed, oversized, and excessive input', async t => {
+  const request = await start(t);
+  assert.equal((await request('/security-reports')).status, 405);
+  assert.equal((await request('/security-reports', { method: 'POST', body: '{}' })).status, 415);
+  assert.equal((await request('/security-reports', { ...postReport({}), body: '{' })).status, 400);
+  for (const body of [null, {}, [], new Array(21).fill(report), { type: 'csp-violation', body: null }]) {
+    assert.equal((await request('/security-reports', postReport(body))).status, 400);
+  }
+  assert.equal((await request('/security-reports', { ...postReport({}), body: 'x'.repeat(17000) })).status, 413);
+  const limited = await start(t);
+  for (let i = 0; i < 60; i++) assert.equal((await limited('/security-reports', postReport([report]))).status, 204);
+  const res = await limited('/security-reports', postReport([report]));
+  assert.equal(res.status, 429);
+  assert.equal(res.headers['retry-after'], '60');
+});
+
+test('routing exposes only public assets and returns hardened errors', async t => {
+  const request = await start(t);
+  for (const path of ['/server.js', '/package.json', '/.git/config', '/%2e%2e/server.js', '/missing']) {
+    const res = await request(path);
+    assert.equal(res.status, 404);
+    assert.ok(res.headers['content-security-policy']);
+    assert.doesNotMatch(res.body, /require\(|node:http/);
+  }
+  assert.equal((await request('//evil.example/')).status, 400);
+  assert.equal((await request('/menu', { method: 'POST' })).status, 405);
+  assert.equal((await request('/logout', { method: 'DELETE' })).status, 405);
+});
