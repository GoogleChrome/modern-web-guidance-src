+  <script>
+    const coffeeDialog = document.getElementById('coffee-dialog');
+    const coffeeTitle = document.getElementById('coffee-dialog-title');
+    const coffeeDescription = document.getElementById('coffee-dialog-description');
+
+    document.querySelectorAll('[data-coffee-details]').forEach((button) => {
+      button.addEventListener('click', () => {
+        const card = button.closest('.card');
+        coffeeTitle.textContent = card.querySelector('h3').textContent;
+        coffeeDescription.textContent = card.querySelector('p').textContent;
+        // Native modal dialogs contain focus, restore it on close, and handle Escape.
+        coffeeDialog.showModal();
+      });
+    });
+
+    document.getElementById('coffee-dialog-close').addEventListener('click', () => {
+      coffeeDialog.close();
+    });
+
+    coffeeDialog.addEventListener('click', (event) => {
+      if (event.target !== coffeeDialog) return;
+      const bounds = coffeeDialog.getBoundingClientRect();
+      if (event.clientX < bounds.left || event.clientX > bounds.right ||
+          event.clientY < bounds.top || event.clientY > bounds.bottom) {
+        coffeeDialog.close();
+      }
+    });
+  </script>
