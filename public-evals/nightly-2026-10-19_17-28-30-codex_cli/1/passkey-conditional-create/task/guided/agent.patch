+  <script>
+    const signinForm = document.querySelector('#signin-form');
+    const signinButton = document.querySelector('[data-testid="signin-button"]');
+    const signinStatus = document.querySelector('#signin-status');
+
+    async function promotePasskey() {
+      // This is a best-effort enhancement of an already authenticated session.
+      // Never fall back to an interactive creation ceremony.
+      try {
+        if (!window.isSecureContext || !window.PublicKeyCredential ||
+            typeof PublicKeyCredential.getClientCapabilities !== 'function' ||
+            typeof navigator.credentials?.create !== 'function') return;
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalCreate !== true) return;
+
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON !== 'function' ||
+            typeof PublicKeyCredential.prototype.toJSON !== 'function') {
+          await import('./webauthn-polyfills.js');
+        }
+
+        // The server must bind this challenge to the authenticated user, include
+        // existing IDs in excludeCredentials, and track the conditional ceremony.
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ conditional: true })
+        });
+        if (!optionsResponse.ok) return;
+
+        const options = await optionsResponse.json();
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+        const credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional'
+        });
+        if (!credential) return;
+
+        const encodedCredential = credential.toJSON();
+        const verificationResponse = await fetch('/api/register/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encodedCredential)
+        });
+        // Only the server may relax user-presence checks for its recorded
+        // conditional ceremony. Never trust a client flag to bypass verification.
+        const verification = verificationResponse.ok ? await verificationResponse.json() : null;
+        if (!verificationResponse.ok || verification?.verified !== true) {
+          if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rp.id || window.location.hostname,
+              credentialId: encodedCredential.id
+            });
+          }
+        }
+      } catch {
+        // Unsupported providers, declined creation, and registration failures
+        // must never interrupt sign-in or produce passkey prompts or error UI.
+      }
+    }
+
+    signinForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (signinButton.disabled) return;
+      signinButton.disabled = true;
+      signinStatus.textContent = 'Signing in…';
+
+      try {
+        const response = await fetch(signinForm.action, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            username: signinForm.elements.username.value,
+            password: signinForm.elements.password.value
+          })
+        });
+        // /api/login must return { authenticated: true } only after all required
+        // factors succeed and the authenticated session cookie has been set.
+        if (!response.ok) throw new Error('Sign-in failed');
+        const result = await response.json();
+        if (result.authenticated !== true) throw new Error('Sign-in incomplete');
+
+        signinForm.reset();
+        signinForm.hidden = true;
+        signinStatus.textContent = 'You’re signed in. Welcome back!';
+        void promotePasskey();
+      } catch {
+        signinStatus.textContent = 'Unable to sign in. Check your details and try again.';
+      } finally {
+        signinButton.disabled = false;
+      }
+    });
+  </script>
