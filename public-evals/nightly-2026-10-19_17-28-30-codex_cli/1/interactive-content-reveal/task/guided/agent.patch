       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    .product-card {
+      position: relative;
+      isolation: isolate;
+      overflow: hidden;
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      transition: --inner-size 0.25s ease, --outer-size 0.25s ease;
+    }
+
+    /* Keep all original content above the decorative spotlight. */
+    .product-card > :not(.reveal-layer) {
+      position: relative;
+      z-index: 1;
+    }
+
+    .reveal-layer {
+      display: none;
+      position: absolute;
+      inset: 0;
+      z-index: 0;
+      border-radius: inherit;
+      pointer-events: none;
+      background:
+        repeating-linear-gradient(135deg, transparent 0 12px, rgb(255 171 64 / 12%) 12px 13px),
+        radial-gradient(circle, rgb(255 171 64 / 30%), rgb(215 204 200 / 20%));
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), black var(--inner-size, 0px), transparent var(--outer-size, 0px));
+      mask-image: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), black var(--inner-size, 0px), transparent var(--outer-size, 0px));
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+    }
+
+    @supports (mask-image: radial-gradient(circle, black, transparent)) or (-webkit-mask-image: radial-gradient(circle, black, transparent)) {
+      .reveal-layer {
+        display: block;
+      }
+    }
+
+    @media (hover: hover) {
+      .product-card:hover {
+        --inner-size: 80px;
+        --outer-size: 150px;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
