+  <script>
+    const rewardsButton = document.querySelector('.rewards-toggle');
+    const rewardsPopover = document.getElementById('rewards-popover');
+
+    if (typeof HTMLElement.prototype.showPopover === 'function') {
+      rewardsPopover.addEventListener('toggle', (event) => {
+        rewardsButton.setAttribute('aria-expanded', String(event.newState === 'open'));
+      });
+    } else {
+      // Fetch the fallback only on first use in browsers without native popovers.
+      let fallbackPromise;
+      rewardsButton.addEventListener('click', async () => {
+        try {
+          fallbackPromise ??= import('./rewards-popover-fallback.js').then(({ setupRewardsPopover }) =>
+            setupRewardsPopover(rewardsPopover, rewardsButton));
+          const toggle = await fallbackPromise;
+          toggle();
+        } catch (error) {
+          fallbackPromise = undefined;
+          console.error('Unable to load the rewards popover. Please try again.', error);
+        }
+      });
+    }
+  </script>
