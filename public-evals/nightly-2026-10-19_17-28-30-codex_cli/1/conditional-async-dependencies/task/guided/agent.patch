+  <script type="module">
+    const rewardsButton = document.getElementById('rewards-toggle');
+    const rewardsPopover = document.getElementById('rewards-popover');
+
+    // Synchronize explicit ARIA state, including when a polyfill handles controls.
+    rewardsPopover.addEventListener('toggle', (event) => {
+      rewardsButton.setAttribute('aria-expanded', String(event.newState === 'open'));
+    });
+
+    async function loadRewardsDependencies() {
+      // The invoker polyfill depends on working popover methods. Await them first.
+      if (!('popover' in HTMLElement.prototype)) {
+        await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+      }
+      if (!('commandForElement' in HTMLButtonElement.prototype)) {
+        await import('https://esm.run/invokers-polyfill');
+      }
+    }
+
+    // Module scripts defer automatically; native browsers fetch no dependencies.
+    loadRewardsDependencies().catch((error) => {
+      console.error('Unable to load rewards controls:', error);
+      const rewardsLink = document.createElement('a');
+      rewardsLink.href = '/rewards';
+      rewardsLink.textContent = 'Rewards';
+      rewardsButton.replaceWith(rewardsLink);
+    });
+  </script>
