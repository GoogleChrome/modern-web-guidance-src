+
+    .faq-item {
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+    }
+
+    #faq-trigger {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 20px;
+      padding: 20px;
+      cursor: pointer;
+      font-weight: 600;
+    }
+
+    #faq-trigger::after {
+      content: '+';
+      font-size: 1.5rem;
+      line-height: 1;
+      transition: transform 400ms ease;
+    }
+
+    .faq-item[open] #faq-trigger::after {
+      transform: rotate(45deg);
+    }
+
+    #faq-trigger::-webkit-details-marker,
+    #alert-dismiss::-webkit-details-marker {
+      display: none;
+    }
+
+    #faq-trigger:focus-visible,
+    #alert-dismiss:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: -4px;
+    }
+
+    #faq-content {
+      block-size: 0;
+      overflow: hidden;
+      transition: block-size 400ms ease;
+    }
+
+    .faq-item[open] #faq-content {
+      block-size: auto;
+    }
+
+    .faq-answer {
+      padding: 0 20px 20px;
+    }
+
+    /* Keep native content rendered until the closing animation finishes.
+       Unsupported browsers retain working, instant native disclosures. */
+    .faq-item::details-content,
+    #promo-alert::details-content {
+      transition: content-visibility 400ms allow-discrete;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #promo-alert,
+      #faq-content,
+      #faq-trigger::after,
+      .faq-item::details-content,
+      #promo-alert::details-content {
+        transition: none;
+      }
+    }
   </style>
