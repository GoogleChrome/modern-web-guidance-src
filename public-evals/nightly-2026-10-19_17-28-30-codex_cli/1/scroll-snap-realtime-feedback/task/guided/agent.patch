+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.cafe-gallery .thumbnail')];
+    let frame = null;
+    let scrollTimeout;
+
+    function setPending(index) {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.toggle('pending', i === index);
+      });
+    }
+
+    function setActive(index) {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', i === index);
+        if (i === index) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+    }
+
+    function closestItemIndex() {
+      const center = gallery.scrollLeft + gallery.clientWidth / 2;
+      return items.reduce((closest, item, index) => {
+        const distance = Math.abs(item.offsetLeft + item.offsetWidth / 2 - center);
+        const closestDistance = Math.abs(items[closest].offsetLeft + items[closest].offsetWidth / 2 - center);
+        return distance < closestDistance ? index : closest;
+      }, 0);
+    }
+
+    function settle() {
+      clearTimeout(scrollTimeout);
+      cancelAnimationFrame(frame);
+      frame = null;
+      setActive(closestItemIndex());
+    }
+
+    // Native events expose the browser's predicted and selected inline snap targets.
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      setPending(items.indexOf(event.snapTargetInline));
+    });
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      setActive(items.indexOf(event.snapTargetInline));
+    });
+
+    const nativePending = 'onscrollsnapchanging' in gallery;
+    const nativeScrollEnd = 'onscrollend' in gallery;
+    gallery.addEventListener('scroll', () => {
+      // Approximate the pending target once per frame when snap events are unavailable.
+      if (!nativePending && frame === null) {
+        frame = requestAnimationFrame(() => {
+          frame = null;
+          setPending(closestItemIndex());
+        });
+      }
+      if (!nativeScrollEnd) {
+        clearTimeout(scrollTimeout);
+        scrollTimeout = setTimeout(settle, 180);
+      }
+    }, { passive: true });
+    // Also clears pending when a gesture returns to the already active slide.
+    gallery.addEventListener('scrollend', settle);
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        const left = items[index].offsetLeft + items[index].offsetWidth / 2 - gallery.clientWidth / 2;
+        if (Math.abs(gallery.scrollLeft - left) < 1) {
+          settle();
+          return;
+        }
+        gallery.scrollTo({
+          left,
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    // Account for restored scroll positions, including back/forward navigation.
+    window.addEventListener('pageshow', settle);
+    window.addEventListener('load', settle, { once: true });
+    setActive(closestItemIndex());
+  </script>
+
