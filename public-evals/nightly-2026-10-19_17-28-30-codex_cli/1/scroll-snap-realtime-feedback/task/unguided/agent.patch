+  <script>
+    const gallery = document.getElementById('gallery');
+    const galleryItems = Array.from(gallery.querySelectorAll('.gallery-item'));
+    const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+    const hasSnapChanging = 'onscrollsnapchanging' in gallery;
+    const hasScrollEnd = 'onscrollend' in gallery;
+    let scrollTimer;
+
+    function nearestItem() {
+      const galleryLeft = gallery.getBoundingClientRect().left + gallery.clientLeft;
+      return galleryItems.reduce((nearest, item) =>
+        Math.abs(item.getBoundingClientRect().left - galleryLeft) <
+        Math.abs(nearest.getBoundingClientRect().left - galleryLeft) ? item : nearest
+      );
+    }
+
+    function markPending(item) {
+      thumbnails.forEach((thumbnail, index) => {
+        thumbnail.classList.toggle('pending', galleryItems[index] === item);
+      });
+    }
+
+    function selectItem(item) {
+      thumbnails.forEach((thumbnail, index) => {
+        const selected = galleryItems[index] === item;
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', selected);
+        if (selected) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+    }
+
+    // Snap events expose the browser's predicted destination during a gesture.
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      if (event.snapTargetInline) markPending(event.snapTargetInline);
+    });
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      if (event.snapTargetInline) selectItem(event.snapTargetInline);
+    });
+    gallery.addEventListener('scroll', () => {
+      if (!hasSnapChanging) markPending(nearestItem());
+      if (!hasScrollEnd) {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(() => selectItem(nearestItem()), 180);
+      }
+    }, { passive: true });
+    gallery.addEventListener('scrollend', () => selectItem(nearestItem()));
+
+    function goToItem(index) {
+      const item = galleryItems[index];
+      const distance = item.getBoundingClientRect().left -
+        gallery.getBoundingClientRect().left - gallery.clientLeft;
+      if (Math.abs(distance) < 1) {
+        selectItem(item);
+        return;
+      }
+      markPending(item);
+      gallery.scrollBy({
+        left: distance,
+        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+      });
+    }
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => goToItem(index));
+    });
+    gallery.addEventListener('keydown', (event) => {
+      const current = galleryItems.indexOf(nearestItem());
+      let next;
+      if (event.key === 'ArrowRight') next = Math.min(current + 1, galleryItems.length - 1);
+      else if (event.key === 'ArrowLeft') next = Math.max(current - 1, 0);
+      else if (event.key === 'Home') next = 0;
+      else if (event.key === 'End') next = galleryItems.length - 1;
+      else return;
+      event.preventDefault();
+      goToItem(next);
+    });
+  </script>
