+  <script>
+    const startButton = document.getElementById('start-btn');
+    const output = document.getElementById('output');
+    const yieldToBrowser = () => new Promise(resolve => setTimeout(resolve, 0));
+
+    startButton.addEventListener('click', async () => {
+      if (startButton.disabled) return;
+
+      startButton.disabled = true;
+      output.textContent = 'Processing...';
+      // Let the initial status render before starting the CPU work.
+      await yieldToBrowser();
+
+      const totalItems = 1000;
+      let sliceStart = performance.now();
+
+      for (let processed = 1; processed <= totalItems; processed++) {
+        // Simulate approximately 2ms of flavor profile work per blend.
+        const itemStart = performance.now();
+        while (performance.now() - itemStart < 2) {
+          // Stand-in for the recipe calculation.
+        }
+
+        if (performance.now() - sliceStart >= 50 || processed === totalItems) {
+          output.textContent = `Processed ${processed} of ${totalItems}...`;
+          // A new task lets the browser handle input and render between slices.
+          await yieldToBrowser();
+          sliceStart = performance.now();
+        }
+      }
+
+      output.textContent = 'Done! All items processed.';
+      startButton.disabled = false;
+    });
+  </script>
