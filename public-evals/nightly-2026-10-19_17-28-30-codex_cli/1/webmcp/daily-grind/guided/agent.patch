diff --git a/test/webmcp.test.js b/test/webmcp.test.js
new file mode 100644
index 0000000..e1ad2cd
--- /dev/null
+++ b/test/webmcp.test.js
@@ -0,0 +1,117 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import test from 'node:test';
+import { parseHTML } from 'linkedom';
+import { createDailyGrindTools, registerDailyGrindTools } from '../webmcp.js';
+
+const html = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+
+function fixture() {
+  const { document } = parseHTML(html);
+  const visits = [];
+  document.location = {
+    href: 'https://daily-grind.example/',
+    origin: 'https://daily-grind.example',
+    assign: (url) => visits.push(url),
+  };
+  const tools = Object.fromEntries(createDailyGrindTools(document).map((tool) => [tool.name, tool]));
+  return { document, tools, visits };
+}
+
+test('homepage loads the module and tools read the real product markup', () => {
+  const { document, tools } = fixture();
+  assert.ok(document.querySelector('script[type="module"][src="/app.js"]'));
+  const { items } = tools.list_seasonal_favorites.execute();
+  assert.deepEqual(items.map((item) => item.name), ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew']);
+  assert.equal(items[0].url, '/menu/seasonal');
+  document.querySelector('[data-product] h3').textContent = 'New Favorite';
+  assert.equal(tools.list_seasonal_favorites.execute().items[0].name, 'New Favorite');
+});
+
+test('favorites search matches names and descriptions without case sensitivity', () => {
+  const { tools } = fixture();
+  assert.equal(tools.list_seasonal_favorites.execute({ query: '  OAT  ' }).items[0].page, 'seasonal');
+  assert.equal(tools.list_seasonal_favorites.execute({ query: '18 HOURS' }).items[0].page, 'cold-brew');
+  assert.deepEqual(tools.list_seasonal_favorites.execute({ query: 'unavailable drink' }), { items: [] });
+});
+
+test('navigation opens each advertised destination and omits logout', () => {
+  const { tools, visits } = fixture();
+  const { pages } = tools.list_site_pages.execute();
+  assert.equal(pages.length, 12);
+  assert.ok(!pages.some((page) => page.url === '/logout'));
+  assert.deepEqual(tools.navigate_to_page.inputSchema.properties.page.enum, pages.map(({ page }) => page));
+  assert.equal(pages.find(({ page }) => page === 'seasonal').title, 'Maple Oat Latte');
+  for (const destination of pages) {
+    const result = tools.navigate_to_page.execute({ page: destination.page });
+    assert.equal(result.url, `https://daily-grind.example${destination.url}`);
+    assert.equal(visits.at(-1), result.url);
+  }
+});
+
+test('invalid inputs produce actionable errors with no navigation', () => {
+  const { tools, visits } = fixture();
+  for (const input of [null, [], 'menu', 42, { unexpected: true }]) {
+    for (const tool of Object.values(tools)) assert.equal(typeof tool.execute(input).error, 'string');
+  }
+  for (const query of [null, 12, {}, []]) {
+    assert.ok(tools.list_seasonal_favorites.execute({ query }).error);
+  }
+  for (const page of [undefined, null, 12, 'logout', '/logout', 'https://elsewhere.example', '__proto__']) {
+    assert.ok(tools.navigate_to_page.execute({ page }).error);
+  }
+  assert.deepEqual(visits, []);
+});
+
+test('navigation rejects external or executable links even if the markup changes', () => {
+  const { document, tools, visits } = fixture();
+  const link = document.querySelector('[data-page="menu"]');
+  for (const href of ['https://external.example/', '//external.example/', 'javascript:alert(1)', 'data:text/html,hello']) {
+    link.setAttribute('href', href);
+    assert.ok(tools.navigate_to_page.execute({ page: 'menu' }).error);
+  }
+  assert.deepEqual(visits, []);
+});
+
+test('navigation failure returns a readable error', () => {
+  const { document, tools } = fixture();
+  document.location.assign = () => { throw new Error('Navigation denied'); };
+  assert.match(tools.navigate_to_page.execute({ page: 'menu' }).error, /could not open/);
+});
+
+test('unsupported browsers skip registration and preserve ordinary links', async () => {
+  const { document } = fixture();
+  assert.deepEqual(await registerDailyGrindTools(document), { supported: false });
+  assert.equal(document.querySelector('.logout-link').getAttribute('href'), '/logout');
+  assert.equal(document.querySelector('[data-page="menu"]').getAttribute('href'), '/menu');
+});
+
+test('registers through document.modelContext with lifecycle signals and safety annotations', async () => {
+  const { document } = fixture();
+  const registered = [];
+  document.modelContext = {
+    async registerTool(tool, options) { registered.push({ tool, options }); },
+  };
+  const result = await registerDailyGrindTools(document);
+  assert.equal(result.supported, true);
+  assert.equal(registered.length, 3);
+  assert.deepEqual(registered.map(({ tool }) => tool.annotations.readOnlyHint), [true, true, false]);
+  assert.equal(registered[0].tool.execute({ query: 'maple' }).items.length, 1);
+  assert.ok(registered.every(({ options }) => !options.signal.aborted));
+  result.dispose();
+  assert.ok(registered.every(({ options }) => options.signal.aborted));
+});
+
+test('failed registration aborts all partial registrations', async () => {
+  const { document } = fixture();
+  const signals = [];
+  document.modelContext = {
+    async registerTool(tool, { signal }) {
+      signals.push(signal);
+      if (signals.length === 2) throw new Error('Registration denied');
+    },
+  };
+  await assert.rejects(registerDailyGrindTools(document), /Registration denied/);
+  assert.equal(signals.length, 2);
+  assert.ok(signals.every((signal) => signal.aborted));
+});
diff --git a/webmcp.js b/webmcp.js
new file mode 100644
index 0000000..cc26aca
--- /dev/null
+++ b/webmcp.js
@@ -0,0 +1,99 @@
+const objectSchema = (properties = {}, required = []) => ({
+  type: 'object',
+  properties,
+  required,
+  additionalProperties: false,
+});
+
+function validInput(input, keys) {
+  return input !== null && typeof input === 'object' && !Array.isArray(input)
+    && Object.keys(input).every((key) => keys.includes(key));
+}
+
+// Read from the same markup people use so tool results track the visible page.
+export function createDailyGrindTools(document) {
+  const pages = () => Array.from(document.querySelectorAll('a[data-page]'), (link) => ({
+    page: link.dataset.page,
+    title: link.closest('[data-product]')?.querySelector('h3').textContent.trim()
+      ?? link.textContent.trim(),
+    url: link.getAttribute('href'),
+  }));
+
+  return [
+    {
+      name: 'list_seasonal_favorites',
+      description: 'Read the seasonal coffee favorites shown on the Daily Grind homepage. Use to discover drinks or find a drink by name or description.',
+      inputSchema: objectSchema({
+        query: { type: 'string', default: '', description: 'Text to match in drink names and descriptions.' },
+      }),
+      annotations: { readOnlyHint: true },
+      execute(input = {}) {
+        if (!validInput(input, ['query']) || (input.query !== undefined && typeof input.query !== 'string')) {
+          return { error: 'Provide an object with an optional query string.' };
+        }
+        const query = (input.query ?? '').trim().toLowerCase();
+        const items = Array.from(document.querySelectorAll('[data-product]'), (card) => ({
+          name: card.querySelector('h3').textContent.trim(),
+          description: card.querySelector('p').textContent.trim(),
+          page: card.querySelector('a[data-page]').dataset.page,
+          url: card.querySelector('a[data-page]').getAttribute('href'),
+        })).filter((item) => `${item.name} ${item.description}`.toLowerCase().includes(query));
+        return { items };
+      },
+    },
+    {
+      name: 'list_site_pages',
+      description: 'List the Daily Grind destinations available to open, including the menu, locations, rewards, account, ordering, and drink details.',
+      inputSchema: objectSchema(),
+      annotations: { readOnlyHint: true },
+      execute(input = {}) {
+        if (!validInput(input, [])) return { error: 'Provide an empty object.' };
+        return { pages: pages() };
+      },
+    },
+    {
+      name: 'navigate_to_page',
+      description: 'Open a Daily Grind destination in the current tab, leaving the current page. Opening the ordering page does not place an order.',
+      inputSchema: objectSchema({
+        page: { type: 'string', enum: pages().map(({ page }) => page), description: 'The destination identifier from list_site_pages or list_seasonal_favorites.' },
+      }, ['page']),
+      annotations: { readOnlyHint: false, consequentialHint: false },
+      execute(input = {}) {
+        if (!validInput(input, ['page']) || typeof input.page !== 'string') {
+          return { error: 'Provide a page identifier from list_site_pages.' };
+        }
+        const destination = pages().find(({ page }) => page === input.page);
+        if (!destination) return { error: 'Unknown page.', availablePages: pages().map(({ page }) => page) };
+
+        // Only explicit, same-origin destinations can be opened; logout is not a destination.
+        const url = new URL(destination.url, document.location.href);
+        if (url.origin !== document.location.origin || !['http:', 'https:'].includes(url.protocol)) {
+          return { error: 'The destination must be a same-origin web page.' };
+        }
+        try {
+          document.location.assign(url.href);
+          return { page: destination.page, url: url.href };
+        } catch {
+          return { error: 'The browser could not open this destination.' };
+        }
+      },
+    },
+  ];
+}
+
+export async function registerDailyGrindTools(document) {
+  const context = document.modelContext;
+  if (typeof context?.registerTool !== 'function') return { supported: false };
+
+  const controller = new AbortController();
+  try {
+    for (const tool of createDailyGrindTools(document)) {
+      await context.registerTool(tool, { signal: controller.signal });
+    }
+  } catch (error) {
+    // A failed registration must not leave a partially exposed tool set.
+    controller.abort();
+    throw error;
+  }
+  return { supported: true, dispose: () => controller.abort() };
+}
