+import { registerTools } from './webmcp.mjs';
+
+// A page restored from the back/forward cache retains its existing registrations.
+registerTools(document, navigator, window.location).catch(error => {
+  console.warn('Daily Grind WebMCP tools could not be registered.', error);
+});
diff --git a/webmcp.mjs b/webmcp.mjs
new file mode 100644
index 0000000..40e2260
--- /dev/null
+++ b/webmcp.mjs
@@ -0,0 +1,106 @@
+// Read the same content and links that are available to people on the page.
+export function createTools(document, location) {
+  const links = () => [...document.querySelectorAll('a[data-agent-destination]')];
+  const destinations = links().map(link => link.dataset.agentDestination);
+  const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+
+  function validate(input, allowed = []) {
+    if (!input || typeof input !== 'object' || Array.isArray(input) ||
+        Object.keys(input).some(key => !allowed.includes(key))) {
+      throw new TypeError('Provide an object containing only the documented parameters.');
+    }
+  }
+
+  return [
+    {
+      name: 'get_seasonal_favorites',
+      description: 'Read the seasonal coffee favorites displayed on this page, including names, descriptions, and detail destinations.',
+      inputSchema: emptySchema,
+      annotations: { readOnlyHint: true },
+      execute(input = {}) {
+        validate(input);
+        return {
+          favorites: [...document.querySelectorAll('#seasonal-favorites .card')].map(card => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            destination: card.querySelector('a').dataset.agentDestination,
+            url: card.querySelector('a').getAttribute('href'),
+          })),
+        };
+      },
+    },
+    {
+      name: 'list_destinations',
+      description: 'List the available Daily Grind page destinations and URLs that open_destination can follow.',
+      inputSchema: emptySchema,
+      annotations: { readOnlyHint: true },
+      execute(input = {}) {
+        validate(input);
+        return {
+          destinations: links().map(link => ({
+            destination: link.dataset.agentDestination,
+            label: link.closest('.card')?.querySelector('h3')?.textContent.trim() || link.textContent.trim(),
+            url: link.getAttribute('href'),
+          })),
+        };
+      },
+    },
+    {
+      name: 'open_destination',
+      description: 'Navigate this browser tab to an existing Daily Grind link. The order-online destination opens the ordering page; it does not place an order.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          destination: {
+            type: 'string',
+            enum: destinations,
+            description: 'The destination identifier returned by list_destinations or get_seasonal_favorites.',
+          },
+        },
+        required: ['destination'],
+        additionalProperties: false,
+      },
+      annotations: { readOnlyHint: false },
+      execute(input) {
+        validate(input, ['destination']);
+        const link = links().find(link => link.dataset.agentDestination === input.destination);
+        if (typeof input.destination !== 'string' || !destinations.includes(input.destination) || !link) {
+          throw new TypeError(`Unknown destination. Choose one of: ${destinations.join(', ')}.`);
+        }
+        const url = new URL(link.getAttribute('href'), location.href);
+        if (url.origin !== location.origin || !['http:', 'https:'].includes(url.protocol)) {
+          throw new TypeError('The destination must be a same-origin HTTP(S) page.');
+        }
+        location.assign(url.href);
+        return { destination: input.destination, url: url.href, status: 'navigation_started' };
+      },
+    },
+  ];
+}
+
+export async function registerTools(document, navigator, location) {
+  const context = typeof document.modelContext?.registerTool === 'function'
+    ? document.modelContext
+    : navigator.modelContext;
+  if (typeof context?.registerTool !== 'function') return null;
+
+  const controller = new AbortController();
+  const registered = [];
+  const cleanup = () => {
+    controller.abort();
+    // Older implementations use unregisterTool rather than registration signals.
+    if (typeof context.unregisterTool === 'function') {
+      for (const name of registered.splice(0)) context.unregisterTool(name);
+    }
+  };
+  try {
+    for (const tool of createTools(document, location)) {
+      await context.registerTool(tool, { signal: controller.signal });
+      registered.push(tool.name);
+    }
+    return cleanup;
+  } catch (error) {
+    cleanup();
+    throw error;
+  }
+}
