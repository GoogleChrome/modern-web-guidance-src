diff --git a/test/webmcp.test.mjs b/test/webmcp.test.mjs
new file mode 100644
index 0000000..63938b4
--- /dev/null
+++ b/test/webmcp.test.mjs
@@ -0,0 +1,125 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { createTools, registerTools } from '../webmcp.mjs';
+
+const html = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+
+function fixture() {
+  // Minimal DOM boundary populated from the shipped HTML, without a browser.
+  const links = [...html.matchAll(/<a\b([^>]*)>([^<]*)<\/a>/g)]
+    .filter(([, attributes]) => attributes.includes('data-agent-destination='))
+    .map(([, attributes, label]) => ({
+      dataset: { agentDestination: attributes.match(/data-agent-destination="([^"]+)"/)[1] },
+      href: attributes.match(/href="([^"]+)"/)[1],
+      textContent: label,
+      getAttribute() { return this.href; },
+      closest() { return this.card; },
+    }));
+  const cards = [...html.matchAll(/<div class="card">([\s\S]*?)<\/div>/g)].map(([, body]) => {
+    const link = links.find(link => link.href === body.match(/href="([^"]+)"/)[1]);
+    const card = {
+      querySelector(selector) {
+        if (selector === 'a') return link;
+        return { textContent: body.match(new RegExp(`<${selector}>(.*?)</${selector}>`))[1] };
+      },
+    };
+    link.card = card;
+    return card;
+  });
+  const document = {
+    querySelectorAll(selector) {
+      if (selector === 'a[data-agent-destination]') return links;
+      if (selector === '#seasonal-favorites .card') return cards;
+      throw new Error(`Unexpected selector: ${selector}`);
+    },
+  };
+  const visited = [];
+  const location = {
+    href: 'https://coffee.example/', origin: 'https://coffee.example',
+    assign(url) { visited.push(url); },
+  };
+  return { document, location, visited, links };
+}
+
+test('exposes the actual seasonal cards and existing destinations', () => {
+  const { document, location } = fixture();
+  const [favorites, destinations, navigate] = createTools(document, location);
+  const result = favorites.execute({});
+  assert.equal(result.favorites.length, 3);
+  assert.equal(result.favorites[0].name, 'Maple Oat Latte');
+  assert.match(result.favorites[0].description, /Vermont maple syrup/);
+  const listed = destinations.execute().destinations;
+  assert.equal(listed.length, 12);
+  assert.equal(listed.find(item => item.destination === 'cold-brew').label, 'Cold Brew');
+  assert.deepEqual(navigate.inputSchema.properties.destination.enum, listed.map(item => item.destination));
+  assert.ok(!listed.some(item => item.url === '/logout'));
+});
+
+test('navigation follows existing links and validates input before changing location', () => {
+  const { document, location, visited, links } = fixture();
+  const tools = createTools(document, location);
+  const navigate = tools[2];
+  assert.equal(navigate.execute({ destination: 'order-online' }).status, 'navigation_started');
+  assert.deepEqual(visited, ['https://coffee.example/order-online']);
+  for (const input of [undefined, null, [], {}, { destination: '/logout' },
+    { destination: 'https://evil.example' }, { destination: 'menu', extra: true }]) {
+    assert.throws(() => navigate.execute(input), TypeError);
+  }
+  links[0].href = 'https://evil.example/';
+  assert.throws(() => navigate.execute({ destination: 'menu' }), /same-origin/);
+  assert.equal(visited.length, 1);
+  assert.throws(() => tools[0].execute({ extra: true }), TypeError);
+  assert.throws(() => tools[1].execute(null), TypeError);
+});
+
+test('unsupported browsers are a no-op', async () => {
+  const { document, location } = fixture();
+  assert.equal(await registerTools(document, {}, location), null);
+});
+
+test('prefers document API, registers callable tools, and supports signal cleanup', async () => {
+  const { document, location } = fixture();
+  const registered = [];
+  document.modelContext = {
+    async registerTool(tool, options) { registered.push({ tool, options }); },
+  };
+  const cleanup = await registerTools(document, {
+    modelContext: { registerTool() { assert.fail('legacy API should not be used'); } },
+  }, location);
+  assert.equal(registered.length, 3);
+  assert.equal(registered[0].tool.execute().favorites.length, 3);
+  assert.equal(registered[0].options.signal.aborted, false);
+  cleanup();
+  assert.ok(registered.every(entry => entry.options.signal.aborted));
+});
+
+test('supports legacy navigator registration and unregisters only its own tools', async () => {
+  const { document, location } = fixture();
+  const removed = [];
+  const navigator = { modelContext: {
+    registerTool() {},
+    unregisterTool(name) { removed.push(name); },
+  } };
+  const cleanup = await registerTools(document, navigator, location);
+  cleanup();
+  cleanup();
+  assert.deepEqual(removed, ['get_seasonal_favorites', 'list_destinations', 'open_destination']);
+});
+
+test('a registration failure rolls back partial registration', async () => {
+  const { document, location } = fixture();
+  let signal;
+  let calls = 0;
+  const removed = [];
+  document.modelContext = {
+    async registerTool(tool, options) {
+      signal = options.signal;
+      if (++calls === 2) throw new Error('Registration denied');
+    },
+    unregisterTool(name) { removed.push(name); },
+  };
+  await assert.rejects(registerTools(document, {}, location), /Registration denied/);
+  assert.equal(signal.aborted, true);
+  assert.deepEqual(removed, ['get_seasonal_favorites']);
+});
