diff --git a/src/lib/news-client.ts b/src/lib/news-client.ts
new file mode 100644
index 0000000..3a42317
--- /dev/null
+++ b/src/lib/news-client.ts
@@ -0,0 +1,44 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+const baseUrl = (import.meta.env?.BASE_URL ?? '/');
+export const READING_LIST_CHANGED = 'news:reading-list-changed';
+
+async function request<T>(path: string, options: RequestInit = {}): Promise<T> {
+  const response = await fetch(`${baseUrl}api/${path}`, options);
+  if (!response.ok) throw new Error(`Request failed (${response.status}). Please retry.`);
+  return response.json();
+}
+
+export function getArticles(signal?: AbortSignal): Promise<Article[]> {
+  return request('articles.json', { signal });
+}
+
+export function searchArticles(articles: Article[], query: string): Article[] {
+  const term = query.trim().toLowerCase();
+  return articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  );
+}
+
+export async function getReadingList(signal?: AbortSignal): Promise<string[]> {
+  const data = await request<{ readingList: string[] }>('reading-list.json', { signal });
+  return data.readingList;
+}
+
+export async function setBookmark(slug: string, bookmarked: boolean, signal?: AbortSignal): Promise<string[]> {
+  const data = await request<{ readingList: string[] }>('reading-list.json', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug, bookmarked }),
+    signal,
+  });
+  signal?.throwIfAborted();
+  // Synchronous notification lets React consumers commit before a tool completes.
+  window.dispatchEvent(new CustomEvent(READING_LIST_CHANGED, { detail: data.readingList }));
+  return data.readingList;
+}
diff --git a/src/lib/webmcp.ts b/src/lib/webmcp.ts
new file mode 100644
index 0000000..61e0757
--- /dev/null
+++ b/src/lib/webmcp.ts
@@ -0,0 +1,127 @@
+import { getArticles, getReadingList, setBookmark, searchArticles } from './news-client';
+
+// The browser describes schemas to agents but does not validate execution inputs.
+function objectInput(input: unknown): Record<string, unknown> {
+  if (!input || typeof input !== 'object' || Array.isArray(input)) {
+    throw new Error('Provide an object matching the tool input schema.');
+  }
+  return input as Record<string, unknown>;
+}
+
+function onlyKeys(input: Record<string, unknown>, keys: string[]) {
+  if (Object.keys(input).some(key => !keys.includes(key))) {
+    throw new Error(`Supported parameters: ${keys.join(', ') || 'none'}.`);
+  }
+}
+
+async function safely(signal: AbortSignal, action: () => Promise<unknown>) {
+  try {
+    signal.throwIfAborted();
+    return await action();
+  } catch (error) {
+    if (signal.aborted) throw error;
+    return { error: error instanceof Error ? error.message : 'The action failed. Please retry.' };
+  }
+}
+
+export function createNewsTools(): WebMCP.ModelContextTool[] {
+  return [
+    {
+      name: 'search_articles',
+      description: 'Search news article titles and summaries. Returns matching articles and links for reading them.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          query: { type: 'string', description: 'Words to find in article titles or summaries.', minLength: 1, maxLength: 200 },
+          limit: { type: 'integer', description: 'Maximum number of articles to return.', minimum: 1, maximum: 50, default: 10 },
+        },
+        required: ['query'],
+        additionalProperties: false,
+      },
+      execute(input, { signal }) {
+        return safely(signal, async () => {
+          const args = objectInput(input);
+          onlyKeys(args, ['query', 'limit']);
+          const limit = args.limit ?? 10;
+          if (typeof args.query !== 'string' || !args.query.trim() || args.query.length > 200) {
+            return { error: 'Provide a non-empty query of at most 200 characters.' };
+          }
+          if (typeof limit !== 'number' || !Number.isInteger(limit) || limit < 1 || limit > 50) {
+            return { error: 'Provide an integer limit between 1 and 50.' };
+          }
+          const matches = searchArticles(await getArticles(signal), args.query);
+          return {
+            total: matches.length,
+            articles: matches.slice(0, limit).map(article => ({
+              ...article,
+              url: `${(import.meta.env?.BASE_URL ?? '/')}articles/${encodeURIComponent(article.slug)}`,
+            })),
+          };
+        });
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'get_reading_list',
+      description: 'Get the current session’s saved news articles.',
+      inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+      execute(input, { signal }) {
+        return safely(signal, async () => {
+          onlyKeys(objectInput(input), []);
+          const [articles, slugs] = await Promise.all([getArticles(signal), getReadingList(signal)]);
+          return { articles: articles.filter(article => slugs.includes(article.slug)) };
+        });
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'set_article_bookmark',
+      description: 'Save an article to the current session’s reading list or remove it. Repeating the same request preserves the desired state.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          slug: { type: 'string', description: 'Article identifier returned by article search.', minLength: 1 },
+          bookmarked: { type: 'boolean', description: 'Whether the article should be saved in the reading list.' },
+        },
+        required: ['slug', 'bookmarked'],
+        additionalProperties: false,
+      },
+      execute(input, { signal }) {
+        return safely(signal, async () => {
+          const args = objectInput(input);
+          onlyKeys(args, ['slug', 'bookmarked']);
+          if (typeof args.slug !== 'string' || !args.slug.trim() || typeof args.bookmarked !== 'boolean') {
+            return { error: 'Provide an article slug and a boolean bookmarked value.' };
+          }
+          const articles = await getArticles(signal);
+          if (!articles.some(article => article.slug === args.slug)) return { error: 'Article not found. Search for an article first.' };
+          const readingList = await setBookmark(args.slug, args.bookmarked, signal);
+          return { slug: args.slug, bookmarked: readingList.includes(args.slug), readingList };
+        });
+      },
+      annotations: { readOnlyHint: false },
+    },
+  ];
+}
+
+export async function registerNewsTools(signal: AbortSignal): Promise<void> {
+  const context = document.modelContext;
+  if (!window.isSecureContext || !context?.registerTool) return;
+
+  try {
+    for (const tool of createNewsTools()) {
+      signal.throwIfAborted();
+      // Combine execution and registration lifetimes to cancel requests on navigation.
+      const execute = tool.execute;
+      await context.registerTool({
+        ...tool,
+        execute: (input, options) => execute(input, {
+          ...options,
+          signal: AbortSignal.any([signal, options.signal]),
+        }),
+      }, { signal });
+    }
+  } catch (error) {
+    if (!signal.aborted) throw error;
+  }
+}
