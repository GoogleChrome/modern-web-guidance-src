@@ -0,0 +1,110 @@
+import assert from 'node:assert/strict';
+import { afterEach, test } from 'node:test';
+import { createNewsTools, registerNewsTools } from '../src/lib/webmcp';
+
+const originalFetch = globalThis.fetch;
+afterEach(() => {
+  globalThis.fetch = originalFetch;
+  Reflect.deleteProperty(globalThis, 'window');
+  Reflect.deleteProperty(globalThis, 'document');
+});
+
+const articles = [
+  { slug: 'coffee', title: 'Coffee Alchemy', summary: 'A morning ritual' },
+  { slug: 'ballet', title: 'Swan Lake', summary: 'Modern ballet' },
+];
+const options = () => ({ signal: new AbortController().signal });
+const tool = (name: string) => createNewsTools().find(tool => tool.name === name)!;
+
+function mockAPI() {
+  let readingList: string[] = [];
+  let writes = 0;
+  const events: string[][] = [];
+  Object.defineProperty(globalThis, 'window', { configurable: true, value: {
+    isSecureContext: true,
+    dispatchEvent: (event: CustomEvent<string[]>) => { events.push(event.detail); return true; },
+  } });
+  globalThis.fetch = async (url, init) => {
+    init?.signal?.throwIfAborted();
+    if (String(url).endsWith('articles.json')) return Response.json(articles);
+    if (init?.method === 'POST') {
+      writes++;
+      const { slug, bookmarked } = JSON.parse(String(init.body));
+      readingList = readingList.filter(item => item !== slug);
+      if (bookmarked) readingList.push(slug);
+    }
+    return Response.json({ readingList });
+  };
+  return { events, get writes() { return writes; } };
+}
+
+test('search matches summaries without case sensitivity and applies the default limit', async () => {
+  mockAPI();
+  const result = await tool('search_articles').execute({ query: '  BALLET ' }, options());
+  assert.deepEqual(result, { total: 1, articles: [{ ...articles[1], url: '/articles/ballet' }] });
+});
+
+test('invalid inputs return useful errors without making requests', async () => {
+  globalThis.fetch = async () => { throw new Error('Unexpected request'); };
+  for (const input of [{ query: '' }, { query: 'coffee', limit: 1.5 }, { query: 'coffee', extra: true }]) {
+    assert.ok('error' in (await tool('search_articles').execute(input, options()) as object));
+  }
+  assert.ok('error' in (await tool('set_article_bookmark').execute({ slug: 'coffee', bookmarked: 'true' }, options()) as object));
+});
+
+test('saving, retrying and removing bookmarks returns session state and notifies the UI', async () => {
+  const api = mockAPI();
+  const bookmark = tool('set_article_bookmark');
+  await bookmark.execute({ slug: 'coffee', bookmarked: true }, options());
+  await bookmark.execute({ slug: 'coffee', bookmarked: true }, options());
+  assert.deepEqual(await tool('get_reading_list').execute({}, options()), { articles: [articles[0]] });
+  await bookmark.execute({ slug: 'coffee', bookmarked: false }, options());
+  assert.deepEqual(await tool('get_reading_list').execute({}, options()), { articles: [] });
+  assert.deepEqual(api.events, [['coffee'], ['coffee'], []]);
+  assert.equal(api.writes, 3);
+  const missing = await bookmark.execute({ slug: 'missing', bookmarked: true }, options());
+  assert.ok('error' in (missing as object));
+  assert.equal(api.writes, 3);
+});
+
+test('HTTP and network failures are readable and cancellations reject', async () => {
+  globalThis.fetch = async () => new Response('', { status: 503 });
+  assert.match((await tool('search_articles').execute({ query: 'coffee' }, options()) as { error: string }).error, /503/);
+  globalThis.fetch = async () => { throw new Error('Network unavailable'); };
+  assert.deepEqual(await tool('get_reading_list').execute({}, options()), { error: 'Network unavailable' });
+  const controller = new AbortController();
+  controller.abort();
+  await assert.rejects(() => Promise.resolve(tool('search_articles').execute({ query: 'coffee' }, { signal: controller.signal })), { name: 'AbortError' });
+});
+
+test('unsupported browsers do not register tools', async () => {
+  Object.defineProperty(globalThis, 'document', { configurable: true, value: {} });
+  Object.defineProperty(globalThis, 'window', { configurable: true, value: { isSecureContext: true } });
+  await registerNewsTools(new AbortController().signal);
+});
+
+test('registration cleanup removes tools and cancels in-flight requests', async () => {
+  const registered = new Map<string, WebMCP.ModelContextTool>();
+  Object.defineProperty(globalThis, 'window', { configurable: true, value: { isSecureContext: true } });
+  Object.defineProperty(globalThis, 'document', { configurable: true, value: { modelContext: {
+    registerTool: async (definition: WebMCP.ModelContextTool, { signal }: { signal: AbortSignal }) => {
+      assert.equal(registered.has(definition.name), false);
+      registered.set(definition.name, definition);
+      signal.addEventListener('abort', () => registered.delete(definition.name), { once: true });
+    },
+  } } });
+  globalThis.fetch = async (_url, init) => new Promise((_resolve, reject) => {
+    init!.signal!.addEventListener('abort', () => reject(init!.signal!.reason), { once: true });
+  });
+  const controller = new AbortController();
+  await registerNewsTools(controller.signal);
+  assert.equal(registered.size, 3);
+  const pending = registered.get('search_articles')!.execute({ query: 'coffee' }, options());
+  controller.abort();
+  await assert.rejects(() => Promise.resolve(pending), { name: 'AbortError' });
+  assert.equal(registered.size, 0);
+  const next = new AbortController();
+  await registerNewsTools(next.signal);
+  assert.equal(registered.size, 3);
+  next.abort();
+});
