diff --git a/src/components/WebMCP.astro b/src/components/WebMCP.astro
new file mode 100644
index 0000000..52a7ac2
--- /dev/null
+++ b/src/components/WebMCP.astro
@@ -0,0 +1,25 @@
+<script>
+  import { registerNewsTools } from '../lib/webmcp';
+
+  let controller: AbortController | undefined;
+  function cleanup() {
+    controller?.abort();
+    controller = undefined;
+  }
+  function register() {
+    cleanup();
+    const next = new AbortController();
+    controller = next;
+    void registerNewsTools(next.signal).catch(error => {
+      next.abort();
+      console.warn('News tools could not be registered.', error);
+    });
+  }
+
+  document.addEventListener('astro:before-swap', cleanup);
+  document.addEventListener('astro:page-load', register);
+  window.addEventListener('pagehide', cleanup);
+  window.addEventListener('pageshow', event => {
+    if (event.persisted) register();
+  });
+</script>
