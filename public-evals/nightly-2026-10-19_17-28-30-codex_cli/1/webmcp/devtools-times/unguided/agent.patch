diff --git a/tests/webmcp.test.ts b/tests/webmcp.test.ts
new file mode 100644
index 0000000..c5cc583
--- /dev/null
+++ b/tests/webmcp.test.ts
@@ -0,0 +1,83 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createNewsTools, registerNewsTools } from '../src/lib/webmcp.ts';
+import { READING_LIST_CHANGED } from '../src/lib/news-client.ts';
+
+const articles = [
+  { slug: 'science', title: 'New Science', summary: 'Research today' },
+  { slug: 'cycling', title: 'City Cycling', summary: 'Science of safe streets' },
+];
+
+test('news tools share session actions, validate input and synchronize updates', async () => {
+  const originalFetch = globalThis.fetch;
+  const originalWindow = globalThis.window;
+  const events = new EventTarget();
+  Object.assign(globalThis, { window: events });
+  let list: string[] = [];
+  let requests = 0;
+  let updates = 0;
+  let opened = '';
+  let lastSignal: AbortSignal | undefined;
+  events.addEventListener(READING_LIST_CHANGED, () => updates++);
+  globalThis.fetch = async (url, options) => {
+    requests++;
+    lastSignal = options?.signal as AbortSignal;
+    assert.equal(options?.credentials, 'same-origin');
+    if (url === '/devtools-times/api/articles.json') return Response.json(articles);
+    assert.equal(url, '/devtools-times/api/reading-list.json');
+    if (options?.method === 'POST') {
+      const { slug, saved } = JSON.parse(options.body as string);
+      list = saved ? [...new Set([...list, slug])] : list.filter(item => item !== slug);
+    }
+    return Response.json({ readingList: list });
+  };
+  try {
+    const tools = createNewsTools('/devtools-times/', async url => { opened = url; });
+    const call = (name: string, input = {}, signal?: AbortSignal) => tools.find(t => t.name === name)!.execute(input, { signal });
+    const controller = new AbortController();
+    const result = await call('search_articles', { query: ' SCIENCE ', limit: 1 }, controller.signal) as any;
+    assert.equal(result.total, 2);
+    assert.equal(result.articles.length, 1);
+    assert.equal(result.articles[0].url, '/devtools-times/articles/science');
+    assert.equal(lastSignal, controller.signal);
+    await call('set_article_saved', { slug: 'science', saved: true });
+    await call('set_article_saved', { slug: 'science', saved: true });
+    assert.deepEqual(list, ['science']);
+    assert.equal(updates, 2);
+    assert.equal(((await call('get_reading_list')) as any).articles[0].slug, 'science');
+    await call('set_article_saved', { slug: 'science', saved: false });
+    assert.deepEqual(list, []);
+    await call('open_article', { slug: 'cycling' });
+    assert.equal(opened, '/devtools-times/articles/cycling');
+    await assert.rejects(call('open_article', { slug: 'https://example.com' }), /not found/);
+    const beforeInvalid = requests;
+    await assert.rejects(call('search_articles', { query: '' }), /query/);
+    await assert.rejects(call('search_articles', { query: 'news', limit: 51 }), /limit/);
+    await assert.rejects(call('set_article_saved', { slug: 'science', saved: 'true' }), /boolean/);
+    assert.equal(requests, beforeInvalid);
+    globalThis.fetch = async () => new Response('', { status: 503 });
+    await assert.rejects(call('search_articles', { query: 'science' }), /503/);
+    globalThis.fetch = async () => { throw new DOMException('Cancelled', 'AbortError'); };
+    await assert.rejects(call('get_reading_list'), { name: 'AbortError' });
+  } finally {
+    globalThis.fetch = originalFetch;
+    Object.assign(globalThis, { window: originalWindow });
+  }
+});
+
+test('registration is optional and uses abort-owned document lifetime', async () => {
+  const tools = createNewsTools('/', async () => {});
+  const controller = new AbortController();
+  await registerNewsTools(undefined, tools, controller.signal);
+  const registered = new Map();
+  await registerNewsTools({ async registerTool(tool, options) {
+    registered.set(tool.name, tool);
+    options!.signal.addEventListener('abort', () => registered.delete(tool.name));
+  } }, tools, controller.signal);
+  assert.equal(registered.size, 4);
+  controller.abort();
+  assert.equal(registered.size, 0);
+  let calls = 0;
+  await registerNewsTools({ registerTool() { calls++; } }, tools, controller.signal);
+  assert.equal(calls, 0);
+});
