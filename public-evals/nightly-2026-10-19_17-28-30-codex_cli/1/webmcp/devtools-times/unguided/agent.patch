diff --git a/src/lib/news-client.ts b/src/lib/news-client.ts
new file mode 100644
index 0000000..188fbce
--- /dev/null
+++ b/src/lib/news-client.ts
@@ -0,0 +1,39 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export const READING_LIST_CHANGED = 'news:reading-list-changed';
+
+// Both the UI and agent tools use these actions and the same session cookie.
+export function createNewsClient(baseUrl: string) {
+  const base = `${baseUrl.replace(/\/$/, '')}/`;
+  async function request(path: string, options: RequestInit = {}) {
+    const response = await fetch(`${base}api/${path}`, { credentials: 'same-origin', ...options });
+    if (!response.ok) throw new Error(`News request failed (${response.status}). Please try again.`);
+    return response.json();
+  }
+  const getArticles = (signal?: AbortSignal): Promise<Article[]> => request('articles.json', { signal });
+  const getReadingList = async (signal?: AbortSignal): Promise<string[]> =>
+    (await request('reading-list.json', { signal })).readingList;
+  async function updateReadingList(slug: string, saved?: boolean, signal?: AbortSignal): Promise<string[]> {
+    const { readingList } = await request('reading-list.json', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ slug, ...(saved === undefined ? {} : { saved }) }),
+      signal,
+    });
+    window.dispatchEvent(new CustomEvent(READING_LIST_CHANGED, { detail: readingList }));
+    return readingList;
+  }
+  return { getArticles, getReadingList, updateReadingList,
+    articleUrl: (slug: string) => `${base}articles/${encodeURIComponent(slug)}` };
+}
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)) : [];
+}
diff --git a/src/lib/webmcp.ts b/src/lib/webmcp.ts
new file mode 100644
index 0000000..9cea577
--- /dev/null
+++ b/src/lib/webmcp.ts
@@ -0,0 +1,98 @@
+import { createNewsClient, searchArticles } from './news-client.ts';
+
+type Tool = {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations: { readOnlyHint: boolean; untrustedContentHint?: boolean };
+  execute: (input: Record<string, unknown>, options?: { signal?: AbortSignal }) => Promise<unknown>;
+};
+export interface ModelContext {
+  registerTool(tool: Tool, options?: { signal: AbortSignal }): void | Promise<void>;
+}
+
+const schema = (properties: Record<string, unknown>, required: string[] = []) => ({
+  type: 'object', properties, required, additionalProperties: false,
+});
+const slugSchema = { type: 'string', minLength: 1, maxLength: 200, description: 'Exact article slug returned by search_articles.' };
+function text(input: Record<string, unknown>, key: string, max: number) {
+  const value = input[key];
+  if (typeof value !== 'string' || !value.trim() || value.length > max) {
+    throw new Error(`${key} must be a non-empty string of at most ${max} characters.`);
+  }
+  return value.trim();
+}
+
+export function createNewsTools(baseUrl: string, openArticle: (url: string) => Promise<unknown>): Tool[] {
+  const news = createNewsClient(baseUrl);
+  async function findArticle(input: Record<string, unknown>, signal?: AbortSignal) {
+    const slug = text(input, 'slug', 200);
+    const article = (await news.getArticles(signal)).find(article => article.slug === slug);
+    if (!article) throw new Error('Article not found. Use search_articles to find a valid slug.');
+    return article;
+  }
+  return [
+    {
+      name: 'search_articles',
+      description: 'Search news article titles and summaries. Returns matching articles and URLs without changing the page.',
+      inputSchema: schema({ query: { type: 'string', minLength: 1, maxLength: 200 }, limit: { type: 'integer', minimum: 1, maximum: 50, default: 10 } }, ['query']),
+      annotations: { readOnlyHint: true, untrustedContentHint: true },
+      async execute(input, { signal } = {}) {
+        const query = text(input, 'query', 200);
+        const limit = input.limit ?? 10;
+        if (!Number.isInteger(limit) || (limit as number) < 1 || (limit as number) > 50) throw new Error('limit must be an integer from 1 to 50.');
+        const matches = searchArticles(await news.getArticles(signal), query);
+        return { total: matches.length, articles: matches.slice(0, limit as number).map(article => ({ ...article, url: news.articleUrl(article.slug) })) };
+      },
+    },
+    {
+      name: 'get_reading_list',
+      description: 'Get the articles saved in the current user session reading list.',
+      inputSchema: schema({}),
+      annotations: { readOnlyHint: true, untrustedContentHint: true },
+      async execute(_input, { signal } = {}) {
+        const [articles, slugs] = await Promise.all([news.getArticles(signal), news.getReadingList(signal)]);
+        return { articles: articles.filter(article => slugs.includes(article.slug)).map(article => ({ ...article, url: news.articleUrl(article.slug) })) };
+      },
+    },
+    {
+      name: 'set_article_saved',
+      description: 'Save an article to, or remove it from, the current session reading list. Repeating the same request preserves the requested state. Updates visible bookmarks.',
+      inputSchema: schema({ slug: slugSchema, saved: { type: 'boolean' } }, ['slug', 'saved']),
+      annotations: { readOnlyHint: false },
+      async execute(input, { signal } = {}) {
+        if (typeof input.saved !== 'boolean') throw new Error('saved must be a boolean.');
+        const article = await findArticle(input, signal);
+        const readingList = await news.updateReadingList(article.slug, input.saved, signal);
+        return { slug: article.slug, saved: readingList.includes(article.slug), readingList };
+      },
+    },
+    {
+      name: 'open_article',
+      description: 'Navigate this tab to an article using its exact slug from search_articles or get_reading_list.',
+      inputSchema: schema({ slug: slugSchema }, ['slug']),
+      annotations: { readOnlyHint: false },
+      async execute(input, { signal } = {}) {
+        const article = await findArticle(input, signal);
+        signal?.throwIfAborted();
+        const url = news.articleUrl(article.slug);
+        await openArticle(url);
+        return { slug: article.slug, url };
+      },
+    },
+  ];
+}
+
+// One registration for the document lifetime, including Astro client navigation.
+// AbortSignal also allows cleanup during development hot reloads.
+export async function registerNewsTools(context: ModelContext | undefined, tools: Tool[], signal: AbortSignal) {
+  if (typeof context?.registerTool !== 'function') return;
+  for (const tool of tools) {
+    if (signal.aborted) return;
+    try {
+      await context.registerTool(tool, { signal });
+    } catch (error) {
+      if (!signal.aborted) console.warn(`Unable to register WebMCP tool ${tool.name}`, error);
+    }
+  }
+}
