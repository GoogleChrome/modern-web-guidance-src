+  <script>
+    function getDaysUntilCardExpires(today = new Date()) {
+      // The card remains valid through December 2027 and expires on January 1.
+      const expirationDay = Date.UTC(2028, 0, 1);
+      // Compare calendar dates in UTC so leap days count and DST cannot skew a day.
+      const currentDay = Date.UTC(today.getFullYear(), today.getMonth(), today.getDate());
+      return Math.max(0, (expirationDay - currentDay) / 86400000);
+    }
+
+    const daysRemaining = getDaysUntilCardExpires();
+    document.getElementById('card-expiration').textContent = daysRemaining > 0
+      ? `Your credit card expires in ${daysRemaining} day${daysRemaining === 1 ? '' : 's'} (December 2027).`
+      : 'Your credit card expired in December 2027.';
+  </script>
