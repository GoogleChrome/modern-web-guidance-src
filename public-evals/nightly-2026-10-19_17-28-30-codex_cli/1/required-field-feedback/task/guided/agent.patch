@@ -206,7 +280,41 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingListForm = document.getElementById('mailing-list-form');
+    const emailInput = document.getElementById('mailing-list-email');
+    const emailErrorText = document.getElementById('mailing-list-error-text');
+    const signupStatus = document.getElementById('mailing-list-status');
+
+    function syncEmailError() {
+      const invalid = !emailInput.validity.valid;
+      emailErrorText.textContent = emailInput.validity.valueMissing
+        ? 'Please enter your email address.'
+        : 'Please enter a valid email address.';
+      if (invalid) {
+        emailInput.setAttribute('aria-invalid', 'true');
+      } else {
+        emailInput.removeAttribute('aria-invalid');
+      }
+    }
+
+    emailInput.addEventListener('blur', syncEmailError);
+    emailInput.addEventListener('input', () => {
+      signupStatus.textContent = '';
+      if (emailInput.hasAttribute('aria-invalid')) syncEmailError();
+    });
+    emailInput.addEventListener('invalid', (event) => {
+      event.preventDefault();
+      syncEmailError();
+      emailInput.focus();
+    });
+    mailingListForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      signupStatus.textContent = 'Online signup is not connected yet. Please contact us to join.';
+    });
+  </script>
+
 </body>
 
 </html>
