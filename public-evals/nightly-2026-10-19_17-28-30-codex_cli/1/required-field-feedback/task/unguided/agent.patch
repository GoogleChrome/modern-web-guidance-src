@@ -206,7 +278,54 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingForm = document.getElementById('mailing-list');
+    const emailInput = document.getElementById('mailing-email');
+    const emailError = document.getElementById('mailing-email-error');
+    const signupStatus = document.getElementById('mailing-status');
+    let emailTouched = false;
+
+    function updateEmailError() {
+      let message = '';
+      if (emailTouched) {
+        if (!emailInput.value.trim()) {
+          message = 'Please enter your email address.';
+        } else if (!emailInput.validity.valid) {
+          message = 'Please enter a valid email address.';
+        }
+      }
+      emailError.textContent = message;
+      emailError.hidden = !message;
+      if (message) {
+        emailInput.setAttribute('aria-invalid', 'true');
+      } else {
+        emailInput.removeAttribute('aria-invalid');
+      }
+    }
+
+    emailInput.addEventListener('blur', () => {
+      emailTouched = true;
+      updateEmailError();
+    });
+
+    emailInput.addEventListener('input', () => {
+      signupStatus.textContent = '';
+      updateEmailError();
+    });
+
+    mailingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      updateEmailError();
+      if (!emailInput.value.trim() || !emailInput.validity.valid) {
+        emailInput.focus();
+        return;
+      }
+      // Replace this message with a request to the mailing-list provider when configured.
+      signupStatus.textContent = 'Online signup is coming soon. Please contact us to join our mailing list.';
+    });
+  </script>
+
 </body>
 
 </html>
