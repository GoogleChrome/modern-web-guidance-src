+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const origins = [...scroller.querySelectorAll('[data-origin]')];
+    const supportsScrollEnd = 'onscrollend' in scroller;
+    let scrolling = false;
+    let scrollTimer;
+
+    function finishScrolling() {
+      if (!scrolling) return;
+      scrolling = false;
+
+      // Read geometry only once scrolling has settled.
+      const viewport = scroller.getBoundingClientRect();
+      let mostVisible = origins[0];
+      let largestArea = -1;
+
+      for (const origin of origins) {
+        const bounds = origin.getBoundingClientRect();
+        const width = Math.max(0, Math.min(bounds.right, viewport.right) - Math.max(bounds.left, viewport.left));
+        const height = Math.max(0, Math.min(bounds.bottom, viewport.bottom) - Math.max(bounds.top, viewport.top));
+        const visibleArea = width * height;
+
+        if (visibleArea > largestArea) {
+          largestArea = visibleArea;
+          mostVisible = origin;
+        }
+      }
+
+      status.textContent = `Scroll ended. Visible: ${mostVisible.dataset.origin}`;
+    }
+
+    scroller.addEventListener('scroll', () => {
+      // A single DOM write per gesture; no layout reads in this hot path.
+      if (!scrolling) {
+        scrolling = true;
+        status.textContent = 'Scrolling…';
+      }
+
+      if (!supportsScrollEnd) {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(finishScrolling, 150);
+      }
+    }, { passive: true });
+
+    if (supportsScrollEnd) {
+      scroller.addEventListener('scrollend', finishScrolling);
+    }
+  </script>
