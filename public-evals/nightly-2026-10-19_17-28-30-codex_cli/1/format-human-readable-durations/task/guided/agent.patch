+  <script type="module">
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const humanValue = document.getElementById('humanValue');
+    const calculator = document.querySelector('.steeping-calculator');
+    const locale = navigator.languages?.length ? navigator.languages : navigator.language;
+    const formatter = typeof Intl.DurationFormat === 'function'
+      ? new Intl.DurationFormat(locale, { style: 'long', minutesDisplay: 'always' })
+      : null;
+    const listFormatter = new Intl.ListFormat(locale, { style: 'long', type: 'conjunction' });
+    const unitFormatters = Object.fromEntries(['hours', 'minutes'].map(unit => [
+      unit, new Intl.NumberFormat(locale, {
+        style: 'unit', unit: unit.slice(0, -1), unitDisplay: 'long'
+      })
+    ]));
+    let durationAPI = globalThis.Temporal;
+
+    function updateDuration() {
+      const inputs = [hoursInput, minutesInput];
+      const [hours, minutes] = inputs.map(input => input.value === '' ? 0 : input.valueAsNumber);
+      const totalMinutes = hours * 60 + minutes;
+
+      if (inputs.some(input => !input.validity.valid)
+          || !Number.isSafeInteger(hours) || !Number.isSafeInteger(minutes)
+          || hours < 0 || minutes < 0 || !Number.isSafeInteger(totalMinutes)
+          || totalMinutes > Math.floor(Number.MAX_SAFE_INTEGER / 60)) {
+        humanValue.textContent = 'Enter a valid, non-negative whole number of hours and minutes.';
+        return;
+      }
+
+      const largestUnit = calculator.querySelector('input[name="largestUnit"]:checked').value;
+      const balanced = durationAPI
+        ? durationAPI.Duration.from({ hours, minutes }).round({ largestUnit })
+        : { hours: largestUnit === 'hours' ? Math.floor(totalMinutes / 60) : 0,
+            minutes: largestUnit === 'hours' ? totalMinutes % 60 : totalMinutes };
+
+      humanValue.textContent = formatter
+        ? formatter.format(balanced)
+        : listFormatter.format([
+            ...(balanced.hours ? [unitFormatters.hours.format(balanced.hours)] : []),
+            unitFormatters.minutes.format(balanced.minutes)
+          ]);
+    }
+
+    calculator.addEventListener('input', updateDuration);
+    calculator.addEventListener('change', updateDuration);
+    updateDuration();
+
+    if (!durationAPI) {
+      import('https://esm.sh/@js-temporal/polyfill@0.5.1')
+        .then(({ Temporal }) => {
+          durationAPI = Temporal;
+          updateDuration();
+        })
+        .catch(() => {
+          // Keep the calculator usable offline with the arithmetic fallback.
+        });
+    }
+  </script>
+
 </body>
 
