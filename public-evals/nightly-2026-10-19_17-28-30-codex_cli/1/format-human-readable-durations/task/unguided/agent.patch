+  <script>
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const humanValue = document.getElementById('humanValue');
+    const unitOptions = document.querySelectorAll('input[name="largestUnit"]');
+    const locale = navigator.languages?.length ? navigator.languages : navigator.language;
+    const hourFormatter = new Intl.NumberFormat(locale, { style: 'unit', unit: 'hour', unitDisplay: 'long' });
+    const minuteFormatter = new Intl.NumberFormat(locale, { style: 'unit', unit: 'minute', unitDisplay: 'long' });
+    const listFormatter = new Intl.ListFormat(locale, { style: 'long', type: 'conjunction' });
+
+    function updateDuration() {
+      const inputs = [hoursInput, minutesInput];
+      const values = inputs.map(input => input.value === '' ? 0 : input.valueAsNumber);
+      const valid = inputs.map((input, index) => {
+        const isValid = input.validity.valid && Number.isSafeInteger(values[index]) && values[index] >= 0;
+        input.setAttribute('aria-invalid', String(!isValid));
+        return isValid;
+      }).every(Boolean);
+      const totalMinutes = values[0] * 60 + values[1];
+
+      if (!valid || !Number.isSafeInteger(totalMinutes)) {
+        humanValue.textContent = 'Enter non-negative whole numbers within a smaller range.';
+        return;
+      }
+
+      const largestUnit = document.querySelector('input[name="largestUnit"]:checked').value;
+      const hours = Math.floor(totalMinutes / 60);
+      const minutes = totalMinutes % 60;
+      const parts = [];
+
+      if (largestUnit === 'minutes') {
+        humanValue.textContent = minuteFormatter.format(totalMinutes);
+        return;
+      }
+
+      if (hours > 0) parts.push(hourFormatter.format(hours));
+      if (minutes > 0 || hours === 0) parts.push(minuteFormatter.format(minutes));
+      humanValue.textContent = listFormatter.format(parts);
+    }
+
+    hoursInput.addEventListener('input', updateDuration);
+    minutesInput.addEventListener('input', updateDuration);
+    unitOptions.forEach(option => option.addEventListener('change', updateDuration));
+    updateDuration();
+  </script>
+
