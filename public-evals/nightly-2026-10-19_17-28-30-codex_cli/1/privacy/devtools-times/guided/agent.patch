+++ b/scripts/privacy.test.mjs
@@ -0,0 +1,129 @@
+import assert from 'node:assert/strict';
+import { before, after, test } from 'node:test';
+import { spawn } from 'node:child_process';
+import { createServer } from 'node:net';
+import { once } from 'node:events';
+import { createHash } from 'node:crypto';
+
+let server, origin, base, output = '';
+before(async () => {
+  const reservation = createServer().listen(0, '127.0.0.1');
+  await once(reservation, 'listening');
+  const port = reservation.address().port;
+  await new Promise(resolve => reservation.close(resolve));
+  origin = `http://127.0.0.1:${port}`;
+  base = `${origin}/devtools-times/`;
+  server = spawn(process.execPath, ['dist/server/entry.mjs'], {
+    env: { ...process.env, HOST: '127.0.0.1', PORT: String(port) },
+    stdio: ['ignore', 'pipe', 'pipe'],
+  });
+  server.stdout.on('data', chunk => { output += chunk; });
+  server.stderr.on('data', chunk => { output += chunk; });
+  for (let i = 0; i < 100; i++) {
+    try { await fetch(base); return; } catch { await new Promise(resolve => setTimeout(resolve, 50)); }
+  }
+  throw new Error(`Server failed to start: ${output}`);
+});
+after(() => server?.kill());
+const api = (options) => fetch(`${base}api/reading-list.json`, options);
+const mutation = (body, headers = {}, method = 'POST') => api({
+  method,
+  headers: { origin, 'content-type': 'application/json', ...headers },
+  body: method === 'DELETE' ? undefined : body,
+});
+
+function headersArePrivate(response) {
+  assert.equal(response.headers.get('cache-control'), 'private, no-store');
+  assert.equal(response.headers.get('referrer-policy'), 'no-referrer');
+  assert.equal(response.headers.get('x-content-type-options'), 'nosniff');
+  assert.equal(response.headers.get('x-frame-options'), 'DENY');
+  assert.match(response.headers.get('permissions-policy'), /camera=\(\).*microphone=\(\).*geolocation=\(\)/);
+  assert.match(response.headers.get('content-security-policy'), /frame-ancestors 'none'/);
+}
+
+test('anonymous browsing and list reads do not create cookies', async () => {
+  for (const path of ['', 'legal/privacy', 'signin', 'signup', 'api/reading-list.json', 'not-a-page']) {
+    const response = await fetch(base + path);
+    assert.equal(response.headers.get('set-cookie'), null, path);
+    headersArePrivate(response);
+  }
+});
+
+test('only valid bounded JSON can update the reading list', async () => {
+  for (const body of ['{', 'null', '{}', '{"slug":12}', '{"slug":"not-an-article"}', '{"slug":"../test"}']) {
+    const response = await mutation(body);
+    assert.equal(response.status, 400, body);
+    assert.equal(response.headers.get('set-cookie'), null);
+  }
+  assert.equal((await mutation('x'.repeat(1100))).status, 413);
+  assert.equal((await mutation('{}', { 'content-type': 'text/plain' })).status, 415);
+});
+
+test('cross-site reads and mutations are rejected before session access', async () => {
+  for (const headers of [{ origin: 'https://attacker.example' }, { origin: 'null' }, { 'sec-fetch-site': 'cross-site' }, { 'sec-fetch-site': 'same-site' }]) {
+    const response = await mutation('{"slug":"silent-architects"}', headers);
+    assert.equal(response.status, 403);
+    assert.equal(response.headers.get('set-cookie'), null);
+    headersArePrivate(response);
+  }
+  assert.equal((await api({ method: 'DELETE' })).status, 403);
+  assert.equal((await api({ headers: { 'sec-fetch-site': 'cross-site' } })).status, 403);
+});
+
+test('saved IDs are isolated, exported, removed, and erased server-side', async () => {
+  const saved = await mutation('{"slug":"silent-architects"}');
+  assert.equal(saved.status, 200);
+  assert.deepEqual(await saved.json(), { readingList: ['silent-architects'] });
+  const setCookie = saved.headers.get('set-cookie');
+  assert.match(setCookie, /__Host-reading-session=/);
+  for (const flag of [/HttpOnly/i, /Secure/i, /SameSite=Lax/i, /Max-Age=86400/i, /Path=\//i]) assert.match(setCookie, flag);
+  const cookie = setCookie.split(';')[0];
+  assert.deepEqual(await (await api()).json(), { readingList: [] });
+  assert.deepEqual(await (await api({ headers: { cookie } })).json(), { readingList: ['silent-architects'] });
+  const removed = await mutation('{"slug":"silent-architects"}', { cookie });
+  assert.deepEqual(await removed.json(), { readingList: [] });
+  assert.match(removed.headers.get('set-cookie'), /Expires=Thu, 01 Jan 1970/i);
+  // Replaying the old cookie must not recover deleted data.
+  assert.deepEqual(await (await api({ headers: { cookie } })).json(), { readingList: [] });
+  const savedAgain = await mutation('{"slug":"coffee-alchemy"}');
+  const cookieAgain = savedAgain.headers.get('set-cookie').split(';')[0];
+  const erased = await mutation('', { cookie: cookieAgain }, 'DELETE');
+  assert.equal(erased.status, 200);
+  assert.deepEqual(await (await api({ headers: { cookie: cookieAgain } })).json(), { readingList: [] });
+});
+
+test('rendered pages use local resources and authorize framework inline scripts with hashes', async () => {
+  const articles = await (await fetch(`${base}api/articles.json`)).json();
+  for (const path of ['', 'legal/privacy', 'signin', 'signup', ...articles.map(a => `articles/${a.slug}`)]) {
+    const response = await fetch(base + path);
+    assert.equal(response.status, 200, path);
+    const html = await response.text();
+    headersArePrivate(response);
+    const csp = response.headers.get('content-security-policy');
+    assert.match(csp, /script-src 'self' 'sha256-/);
+    assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval/);
+    for (const [, attributes, body] of html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script>/g)) {
+      if (/src=|type="application\/(?:ld\+)?json"/.test(attributes)) continue;
+      const hash = createHash('sha256').update(body).digest('base64');
+      assert.ok(csp.includes(`'sha256-${hash}'`), `${path}: inline script missing hash`);
+    }
+    for (const [, url] of html.matchAll(/(?:src|srcset)="([^"]+)"/g)) {
+      assert.ok(!/^(?:https?:)?\/\//.test(url), `${path}: external resource ${url}`);
+    }
+    assert.doesNotMatch(html, /rel="(?:preconnect|dns-prefetch)"|<input[^>]+type="password"/);
+  }
+});
+
+test('ephemeral store actually erases expired data without a read', async (t) => {
+  const { default: createStore } = await import('../src/server/session-store.ts');
+  t.mock.timers.enable({ apis: ['setTimeout'] });
+  const store = createStore();
+  await store.setItem('expires', { readingList: ['silent-architects'] });
+  t.mock.timers.tick(86399 * 1000);
+  assert.notEqual(await store.getItem('expires'), null);
+  t.mock.timers.tick(1000);
+  assert.equal(await store.getItem('expires'), null);
+  await store.setItem('delete', 'private');
+  await store.removeItem('delete');
+  assert.equal(await store.getItem('delete'), null);
+});
