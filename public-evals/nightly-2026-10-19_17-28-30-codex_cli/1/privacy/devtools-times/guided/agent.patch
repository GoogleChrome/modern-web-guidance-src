diff --git a/scripts/audit-privacy.mjs b/scripts/audit-privacy.mjs
new file mode 100644
index 0000000..5618d2a
--- /dev/null
+++ b/scripts/audit-privacy.mjs
@@ -0,0 +1,19 @@
+import { readdir, readFile } from 'node:fs/promises';
+import assert from 'node:assert/strict';
+
+async function scan(dir) {
+  for (const entry of await readdir(dir, { withFileTypes: true })) {
+    const path = `${dir}/${entry.name}`;
+    if (entry.isDirectory()) { await scan(path); continue; }
+    if (!/\.(astro|tsx?|css|md)$/.test(path)) continue;
+    const source = await readFile(path, 'utf8');
+    // All external URLs in runtime source need review. Static hyperlinks and
+    // SVG namespaces are not automatic resource requests and are exempt.
+    const withoutLinks = source.replace(/<a\b[^>]*>/g, '').replace(/xmlns="http:\/\/www.w3.org\/2000\/svg"/g, '');
+    assert.doesNotMatch(withoutLinks, /(?:https?:)?\/\/[\w.-]+\.[a-z]{2,}/i, `${path}: review external resource`);
+    assert.doesNotMatch(source, /document\.cookie\s*=|localStorage|sessionStorage|navigator\.(?:userAgent|sendBeacon)|window\.adNetwork/, `${path}: review browser data access`);
+    if (path.endsWith('.md')) assert.doesNotMatch(source, /<script\b/i, `${path}: editorial content must not run scripts`);
+  }
+}
+await scan('src');
+console.log('Privacy source audit passed: no unreviewed external resources or browser data collectors.');
