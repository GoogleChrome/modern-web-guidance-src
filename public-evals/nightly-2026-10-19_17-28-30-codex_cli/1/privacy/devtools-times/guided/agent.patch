diff --git a/src/server/session-store.ts b/src/server/session-store.ts
new file mode 100644
index 0000000..158a7fc
--- /dev/null
+++ b/src/server/session-store.ts
@@ -0,0 +1,24 @@
+import type { SessionDriver } from 'astro';
+
+// Ephemeral single-process storage: no reading preferences are written to disk.
+// Deploy a shared store with enforced expiry before running multiple replicas.
+export default function createSessionStore(): SessionDriver {
+  const entries = new Map<string, { value: unknown; timer: ReturnType<typeof setTimeout> }>();
+  const remove = (key: string) => {
+    const entry = entries.get(key);
+    if (entry) clearTimeout(entry.timer);
+    entries.delete(key);
+  };
+  return {
+    async getItem(key) { return entries.get(key)?.value ?? null; },
+    async removeItem(key) { remove(key); },
+    async setItem(key, value) {
+      remove(key);
+      // Bound memory use; oldest sessions may expire earlier under heavy load.
+      if (entries.size >= 10000) remove(entries.keys().next().value!);
+      const timer = setTimeout(() => remove(key), 86400 * 1000);
+      timer.unref();
+      entries.set(key, { value, timer });
+    },
+  };
+}
