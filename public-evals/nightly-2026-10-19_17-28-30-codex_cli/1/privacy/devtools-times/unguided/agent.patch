+import { useState } from 'react';
+
+export default function PrivacyControls() {
+  const [message, setMessage] = useState('');
+  const [busy, setBusy] = useState(false);
+  async function clearData() {
+    setBusy(true);
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+        method: 'DELETE', credentials: 'same-origin', cache: 'no-store',
+      });
+      if (!response.ok) throw new Error();
+      setMessage('Your saved reading list and its session cookie have been deleted.');
+    } catch {
+      setMessage('Your data could not be deleted. Please try again.');
+    } finally { setBusy(false); }
+  }
+  return <div className="my-6 rounded-lg border border-gray-200 p-5">
+    <h2 className="text-xl font-bold mb-3">Your data, your control</h2>
+    <p className="mb-4">Delete all articles saved in this browser’s reading list and end its session.</p>
+    <button type="button" disabled={busy} onClick={clearData} className="bg-gray-900 text-white rounded px-4 py-2 disabled:opacity-50">
+      {busy ? 'Deleting…' : 'Delete my reading list'}
+    </button>
+    <p role="status" className="mt-3">{message}</p>
+  </div>;
+}
