diff --git a/scripts/purge-sessions.mjs b/scripts/purge-sessions.mjs
new file mode 100644
index 0000000..614e26a
--- /dev/null
+++ b/scripts/purge-sessions.mjs
@@ -0,0 +1,25 @@
+import { mkdir, chmod, readdir, stat, unlink } from 'node:fs/promises';
+import { resolve, join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+// This must match the explicit filesystem session driver in astro.config.mjs.
+export async function purgeExpiredSessions() {
+  const directory = resolve('.astro/sessions');
+  await mkdir(directory, { recursive: true, mode: 0o700 });
+  await chmod(directory, 0o700);
+  const cutoff = Date.now() - 24 * 60 * 60 * 1000;
+  const entries = await readdir(directory, { withFileTypes: true });
+  for (const entry of entries) {
+    if (!entry.isFile()) continue;
+    const path = join(directory, entry.name);
+    try {
+      if ((await stat(path)).mtimeMs < cutoff) await unlink(path);
+    } catch (error) {
+      if (error.code !== 'ENOENT') throw error;
+    }
+  }
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
+  await purgeExpiredSessions();
+}
diff --git a/scripts/security.test.mjs b/scripts/security.test.mjs
new file mode 100644
index 0000000..dbb6138
--- /dev/null
+++ b/scripts/security.test.mjs
@@ -0,0 +1,138 @@
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { mkdir, writeFile, utimes, access, stat, unlink } from 'node:fs/promises';
+import { setTimeout } from 'node:timers/promises';
+
+const origin = 'http://localhost:14327';
+const base = `${origin}/devtools-times/`;
+let server;
+let logs = '';
+const api = (path, options) => fetch(`${base}api/${path}`, options);
+const mutate = (body, extra = {}) => ({
+  method: 'POST', headers: { origin, 'content-type': 'application/json', ...extra }, body,
+});
+
+before(async () => {
+  await mkdir('.astro/sessions', { recursive: true });
+  await writeFile('.astro/sessions/retention-test-expired', 'expired');
+  const old = new Date(Date.now() - 25 * 60 * 60 * 1000);
+  await utimes('.astro/sessions/retention-test-expired', old, old);
+  await writeFile('.astro/sessions/retention-test-current', 'current');
+  server = spawn(process.execPath, ['dist/server/entry.mjs'], {
+    env: { ...process.env, HOST: '127.0.0.1', PORT: '14327', NODE_ENV: 'production' },
+    stdio: ['ignore', 'pipe', 'pipe'],
+  });
+  server.stdout.on('data', chunk => { logs += chunk; });
+  server.stderr.on('data', chunk => { logs += chunk; });
+  for (let i = 0; i < 100; i++) {
+    try { await fetch(base); return; } catch { await setTimeout(100); }
+  }
+  throw new Error(`Server did not start: ${logs}`);
+});
+after(async () => {
+  server?.kill();
+  await unlink('.astro/sessions/retention-test-current').catch(() => {});
+});
+
+test('expired files are purged and current files remain in private storage', async () => {
+  await assert.rejects(access('.astro/sessions/retention-test-expired'));
+  await access('.astro/sessions/retention-test-current');
+  assert.equal((await stat('.astro/sessions')).mode & 0o777, 0o700);
+});
+
+test('pages load without tracking, credential collection, or unsolicited sessions', async () => {
+  for (const path of ['', 'legal/privacy', 'signin', 'signup', 'articles/silent-architects']) {
+    const response = await fetch(`${base}${path}`);
+    assert.equal(response.status, 200, `${path}: ${logs}`);
+    assert.equal(response.headers.get('set-cookie'), null);
+    assert.equal(response.headers.get('cache-control'), 'private, no-store');
+    const html = await response.text();
+    assert.doesNotMatch(html, /fonts\.google|analytics-client|ad-client|cloudfunctions\.net|document\.cookie|type="password"/);
+    for (const match of html.matchAll(/<(?:img|script)\b[^>]*\bsrc="([^"]+)"/g)) {
+      assert.ok(match[1].startsWith('/') || match[1].startsWith('data:'), match[1]);
+    }
+    if (path === 'legal/privacy') assert.match(html, /Delete my reading list/);
+  }
+});
+
+test('security policy permits only own scripts and fresh nonces', async () => {
+  const first = await fetch(base);
+  const second = await fetch(base);
+  const csp = first.headers.get('content-security-policy');
+  assert.match(csp, /script-src 'self' 'nonce-/);
+  assert.match(csp, /connect-src 'self'/);
+  assert.match(csp, /frame-ancestors 'none'/);
+  assert.match(csp, /object-src 'none'/);
+  assert.match(csp, /form-action 'self'/);
+  assert.match(csp, /script-src-attr 'none'/);
+  assert.notEqual(csp, second.headers.get('content-security-policy'));
+  const nonce = csp.match(/'nonce-([^']+)'/)[1];
+  const html = await first.text();
+  const scripts = [...html.matchAll(/<script\b([^>]*)>/g)];
+  assert.ok(scripts.length > 0);
+  for (const script of scripts) assert.ok(script[1].includes(`nonce="${nonce}"`));
+  assert.equal(first.headers.get('x-content-type-options'), 'nosniff');
+  assert.equal(first.headers.get('x-frame-options'), 'DENY');
+  assert.equal(first.headers.get('referrer-policy'), 'no-referrer');
+  assert.match(first.headers.get('permissions-policy'), /geolocation=\(\)/);
+});
+
+test('rejects cross-site changes, malformed and oversized data without creating sessions', async () => {
+  for (const options of [
+    { ...mutate('{"slug":"silent-architects"}'), headers: { 'content-type': 'application/json' } },
+    mutate('{"slug":"silent-architects"}', { origin: 'https://attacker.example' }),
+    mutate('{"slug":"silent-architects"}', { 'sec-fetch-site': 'cross-site' }),
+  ]) {
+    const response = await api('reading-list.json', options);
+    assert.equal(response.status, 403);
+    assert.equal(response.headers.get('set-cookie'), null);
+  }
+  for (const [body, expected] of [
+    ['null', 400], ['{', 400], ['[]', 400], ['{"slug":{}}', 400],
+    ['{"slug":"unknown-article"}', 400],
+    ['{"slug":"silent-architects","email":"unnecessary"}', 400],
+    ['x'.repeat(2048), 413],
+  ]) {
+    const response = await api('reading-list.json', mutate(body));
+    assert.equal(response.status, expected, body.slice(0, 60));
+    assert.equal(response.headers.get('set-cookie'), null);
+    assert.equal(response.headers.get('cache-control'), 'private, no-store');
+  }
+  const wrongType = await api('reading-list.json', mutate('{}', { 'content-type': 'text/plain' }));
+  assert.equal(wrongType.status, 415);
+});
+
+test('reading lists are isolated, bounded to identifiers, and deletable', async () => {
+  const empty = await api('reading-list.json');
+  assert.deepEqual(await empty.json(), { readingList: [] });
+  assert.equal(empty.headers.get('set-cookie'), null);
+  const saved = await api('reading-list.json', mutate('{"slug":"silent-architects"}'));
+  assert.equal(saved.status, 200);
+  assert.deepEqual(await saved.json(), { readingList: ['silent-architects'] });
+  const setCookie = saved.headers.get('set-cookie');
+  assert.match(setCookie, /HttpOnly/i);
+  assert.match(setCookie, /Secure/i);
+  assert.match(setCookie, /SameSite=Strict/i);
+  assert.match(setCookie, /Path=\/devtools-times\//i);
+  assert.match(setCookie, /Max-Age=86400/i);
+  assert.doesNotMatch(setCookie, /silent-architects/);
+  const cookie = setCookie.split(';')[0];
+  const read = await api('reading-list.json', { headers: { cookie } });
+  assert.deepEqual(await read.json(), { readingList: ['silent-architects'] });
+  const otherVisitor = await api('reading-list.json');
+  assert.deepEqual(await otherVisitor.json(), { readingList: [] });
+  const deniedDelete = await api('reading-list.json', { method: 'DELETE', headers: { cookie, origin: 'https://attacker.example' } });
+  assert.equal(deniedDelete.status, 403);
+  const deleted = await api('reading-list.json', { method: 'DELETE', headers: { cookie, origin } });
+  assert.equal(deleted.status, 200);
+  assert.match(deleted.headers.get('set-cookie'), /Max-Age=0|Expires=Thu, 01 Jan 1970/i);
+  const replay = await api('reading-list.json', { headers: { cookie } });
+  assert.deepEqual(await replay.json(), { readingList: [] });
+
+  const newList = await api('reading-list.json', mutate('{"slug":"silent-architects"}'));
+  const newCookie = newList.headers.get('set-cookie').split(';')[0];
+  const removed = await api('reading-list.json', mutate('{"slug":"silent-architects"}', { cookie: newCookie }));
+  assert.deepEqual(await removed.json(), { readingList: [] });
+  assert.match(removed.headers.get('set-cookie'), /Max-Age=0|Expires=Thu, 01 Jan 1970/i);
+});
