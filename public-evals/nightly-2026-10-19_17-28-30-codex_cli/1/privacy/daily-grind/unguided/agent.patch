@@ -0,0 +1,56 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { resolve } from 'node:path';
+
+const publicRoot = new URL('./public/', import.meta.url);
+// Explicit public routes prevent repository files and arbitrary paths being served.
+const routes = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/privacy-policy', ['privacy-policy.html', 'text/html; charset=utf-8']],
+  ['/privacy-policy/', ['privacy-policy.html', 'text/html; charset=utf-8']],
+  ['/assets/styles.css', ['assets/styles.css', 'text/css; charset=utf-8']],
+  ['/assets/coffee.jpg', ['assets/coffee.jpg', 'image/jpeg']],
+]);
+
+export function createAppServer({ production = process.env.NODE_ENV === 'production' } = {}) {
+  const server = createServer(async (request, response) => {
+    response.setHeader('Content-Security-Policy', "default-src 'none'; style-src 'self'; img-src 'self'; script-src 'none'; connect-src 'none'; font-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'");
+    response.setHeader('Referrer-Policy', 'no-referrer');
+    response.setHeader('X-Content-Type-Options', 'nosniff');
+    response.setHeader('X-Frame-Options', 'DENY');
+    response.setHeader('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()');
+    response.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
+    response.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+    response.setHeader('Cache-Control', 'no-store');
+    if (production) response.setHeader('Strict-Transport-Security', 'max-age=31536000');
+
+    const send = (status, body, type = 'text/plain; charset=utf-8') => {
+      response.writeHead(status, { 'Content-Type': type });
+      response.end(request.method === 'HEAD' ? undefined : body);
+    };
+    if (request.method !== 'GET' && request.method !== 'HEAD') {
+      response.setHeader('Allow', 'GET, HEAD');
+      request.resume();
+      return send(405, 'Method not allowed');
+    }
+    // Ignore query strings; never log, reflect, or persist request data.
+    const route = routes.get((request.url ?? '').split('?')[0]);
+    if (!route) return send(404, 'Page not found');
+    try {
+      const content = await readFile(new URL(route[0], publicRoot));
+      send(200, content, route[1]);
+    } catch {
+      send(500, 'Unable to load page');
+    }
+  });
+  server.requestTimeout = 10_000;
+  server.headersTimeout = 10_000;
+  server.keepAliveTimeout = 5_000;
+  server.maxHeadersCount = 50;
+  return server;
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  createAppServer().listen(Number(process.env.PORT ?? 11222), '0.0.0.0');
+}
diff --git a/test/privacy.test.js b/test/privacy.test.js
new file mode 100644
index 0000000..6d25a82
--- /dev/null
+++ b/test/privacy.test.js
@@ -0,0 +1,81 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile, readdir } from 'node:fs/promises';
+import { once } from 'node:events';
+import { createAppServer } from '../server.js';
+
+async function withServer(production, run) {
+  const server = createAppServer({ production });
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  try {
+    await run(`http://127.0.0.1:${server.address().port}`);
+  } finally {
+    await new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+  }
+}
+
+test('all public resources load with privacy headers and no cookies', async () => {
+  await withServer(true, async base => {
+    for (const path of ['/', '/privacy-policy', '/privacy-policy/', '/assets/styles.css', '/assets/coffee.jpg']) {
+      const response = await fetch(base + path);
+      assert.equal(response.status, 200, path);
+      const headers = response.headers;
+      assert.equal(headers.get('set-cookie'), null);
+      assert.equal(headers.get('cache-control'), 'no-store');
+      assert.equal(headers.get('referrer-policy'), 'no-referrer');
+      assert.equal(headers.get('x-content-type-options'), 'nosniff');
+      assert.equal(headers.get('x-frame-options'), 'DENY');
+      assert.equal(headers.get('cross-origin-resource-policy'), 'same-origin');
+      assert.equal(headers.get('cross-origin-opener-policy'), 'same-origin');
+      assert.match(headers.get('permissions-policy'), /geolocation=\(\)/);
+      assert.equal(headers.get('strict-transport-security'), 'max-age=31536000');
+      for (const rule of ["script-src 'none'", "connect-src 'none'", "form-action 'none'", "frame-ancestors 'none'", "base-uri 'none'", "default-src 'none'"]) {
+        assert.ok(headers.get('content-security-policy').includes(rule), rule);
+      }
+      assert.ok((await response.arrayBuffer()).byteLength > 0);
+    }
+  });
+});
+
+test('private files and traversal attempts are inaccessible; errors do not reflect input', async () => {
+  await withServer(false, async base => {
+    for (const path of ['/package.json', '/server.js', '/.git/config', '/test/privacy.test.js', '/assets/%2e%2e%2f%2e%2e%2fpackage.json', '/missing?email=private@example.com']) {
+      const response = await fetch(base + path);
+      assert.equal(response.status, 404, path);
+      assert.equal(await response.text(), 'Page not found');
+      assert.equal(response.headers.get('referrer-policy'), 'no-referrer');
+      assert.equal(response.headers.get('strict-transport-security'), null);
+    }
+  });
+});
+
+test('submissions are refused, query values are discarded, HEAD returns no body', async () => {
+  await withServer(false, async base => {
+    const rejected = await fetch(base + '/', { method: 'POST', body: 'email=private@example.com' });
+    assert.equal(rejected.status, 405);
+    assert.equal(rejected.headers.get('allow'), 'GET, HEAD');
+    assert.equal(await rejected.text(), 'Method not allowed');
+    const ordinary = await fetch(base + '/');
+    const query = await fetch(base + '/?email=private@example.com');
+    assert.equal(await query.text(), await ordinary.text());
+    const head = await fetch(base + '/', { method: 'HEAD' });
+    assert.equal(head.status, 200);
+    assert.equal(await head.text(), '');
+  });
+});
+
+test('third-party audit: no runtime dependencies or external browser resources', async () => {
+  const pkg = JSON.parse(await readFile(new URL('../package.json', import.meta.url)));
+  assert.equal(Object.keys(pkg.dependencies ?? {}).length, 0);
+  assert.equal(Object.keys(pkg.devDependencies ?? {}).length, 0);
+  const root = new URL('../public/', import.meta.url);
+  const files = await readdir(root, { recursive: true });
+  for (const file of files.filter(file => /\.(html|css|js)$/.test(file))) {
+    const content = await readFile(new URL(file, root), 'utf8');
+    assert.doesNotMatch(content, /(?:src|href|action)\s*=\s*["']\s*(?:https?:)?\/\//i, file);
+    assert.doesNotMatch(content, /@import|url\(\s*["']?\s*(?:https?:)?\/\//i, file);
+    assert.doesNotMatch(content, /<script\b|<iframe\b|<form\b|<style\b|\sstyle\s*=|\son\w+\s*=/i, file);
+    assert.doesNotMatch(content, /localStorage|sessionStorage|document\.cookie|sendBeacon|indexedDB/, file);
+  }
+});
