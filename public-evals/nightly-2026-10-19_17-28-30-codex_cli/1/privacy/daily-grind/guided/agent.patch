new file mode 100644
index 0000000..db6a27e
--- /dev/null
+++ b/scripts/audit-privacy.mjs
@@ -0,0 +1,47 @@
+import assert from 'node:assert/strict';
+import { readFile, readdir } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { publicFiles } from '../server.mjs';
+
+export function auditSource(source, file) {
+  const violations = [];
+  const reject = (pattern, reason) => { if (pattern.test(source)) violations.push(`${file}: ${reason}`); };
+  reject(/<(?:script|iframe|object|embed|input|textarea|select)\b/i, 'Executable embeds or data collection require a privacy review');
+  reject(/\b(?:style|on\w+)\s*=/i, 'Inline styles and handlers violate the security policy');
+  reject(/<(?:style|base)\b/i, 'Inline CSS and base URL overrides are prohibited');
+  reject(/\b(?:localStorage|sessionStorage|indexedDB|sendBeacon|document\.cookie|navigator\.userAgent)\b/i, 'Browser storage, telemetry, and fingerprinting require review');
+  reject(/@import\b|@font-face\b/i, 'Imported styles and fonts require review');
+  reject(/(?:https?:)?\/\//i, 'External URLs require review; serve resources locally');
+  reject(/(?:data|javascript|blob):/i, 'Embedded resource schemes are prohibited');
+  return violations;
+}
+
+export async function auditPrivacy() {
+  const files = new Set([...publicFiles.values()].map(([file]) => file));
+  files.add('cleared.html');
+  // Include unregistered HTML/CSS/JS so additions cannot silently evade review.
+  async function discover(directory) {
+    for (const entry of await readdir(new URL(directory, new URL('../', import.meta.url)), { withFileTypes: true })) {
+      if (['node_modules', '.git', 'test', 'scripts'].includes(entry.name)) continue;
+      const path = `${directory}${entry.name}`;
+      if (entry.isDirectory()) await discover(`${path}/`);
+      else if (/\.(?:html|css|js)$/.test(path)) files.add(path);
+    }
+  }
+  await discover('');
+  const violations = [];
+  for (const file of files) {
+    if (!/\.(?:html|css|js)$/.test(file)) continue;
+    violations.push(...auditSource(await readFile(new URL(`../${file}`, import.meta.url), 'utf8'), file));
+  }
+  const pkg = JSON.parse(await readFile(new URL('../package.json', import.meta.url), 'utf8'));
+  assert.equal(Object.keys({ ...pkg.dependencies, ...pkg.devDependencies, ...pkg.optionalDependencies }).length, 0,
+    'New dependencies require a supply-chain and privacy review');
+  assert.deepEqual(violations, [], 'Privacy audit failed');
+  return files.size;
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  const count = await auditPrivacy();
+  console.log(`Privacy source audit passed (${count} files; zero external dependencies).`);
+}
