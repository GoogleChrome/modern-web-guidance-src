@@ -0,0 +1,86 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+
+// Explicit public files: never expose source, configuration, or directory listings.
+export const publicFiles = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/privacy-policy', ['privacy-policy.html', 'text/html; charset=utf-8']],
+  ['/logout', ['logout.html', 'text/html; charset=utf-8']],
+  ['/assets/styles.css', ['assets/styles.css', 'text/css; charset=utf-8']],
+  ['/assets/coffee.jpg', ['assets/coffee.jpg', 'image/jpeg']],
+]);
+
+export const securityHeaders = {
+  'Content-Security-Policy': [
+    "default-src 'none'", "script-src 'none'", "style-src 'self'",
+    "img-src 'self'", "connect-src 'none'", "object-src 'none'",
+    "base-uri 'none'", "frame-ancestors 'none'", "form-action 'self'",
+    "require-trusted-types-for 'script'", "trusted-types 'none'",
+  ].join('; '),
+  'Referrer-Policy': 'no-referrer',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), accelerometer=(), gyroscope=(), magnetometer=(), payment=(), usb=(), browsing-topics=()',
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Strict-Transport-Security': 'max-age=300',
+  'Cache-Control': 'no-store',
+  'Vary': 'Sec-Fetch-Site, Sec-Fetch-Mode, Sec-Fetch-Dest',
+};
+
+export function createAppServer() {
+  return createServer({ maxHeaderSize: 16384, requestTimeout: 10000, headersTimeout: 10000 }, async (req, res) => {
+    for (const [name, value] of Object.entries(securityHeaders)) res.setHeader(name, value);
+    const send = (status, message) => {
+      res.writeHead(status, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end(req.method === 'HEAD' ? undefined : message);
+    };
+    // Do not log, persist, or reflect request URLs, headers, addresses, or bodies.
+    try {
+      const path = new URL(req.url, 'http://localhost').pathname;
+      const site = req.headers['sec-fetch-site'];
+      if (site && !['same-origin', 'none'].includes(site)) {
+        const navigation = ['GET', 'HEAD'].includes(req.method)
+          && req.headers['sec-fetch-mode'] === 'navigate'
+          && req.headers['sec-fetch-dest'] === 'document';
+        if (!navigation) return send(403, 'Forbidden');
+      }
+      if (path === '/logout' && req.method === 'POST') {
+        // Origin validation covers browsers without Fetch Metadata support.
+        const origin = req.headers.origin;
+        if (origin) {
+          let valid = false;
+          try { valid = new URL(origin).host === req.headers.host && /^https?:$/.test(new URL(origin).protocol); } catch {}
+          if (!valid) return send(403, 'Forbidden');
+        } else if (site !== 'same-origin') {
+          return send(403, 'Forbidden');
+        }
+        const body = await readFile(new URL('cleared.html', import.meta.url));
+        res.writeHead(200, {
+          'Content-Type': 'text/html; charset=utf-8',
+          'Clear-Site-Data': '"cookies", "storage", "cache"',
+        });
+        return res.end(body);
+      }
+      if (!['GET', 'HEAD'].includes(req.method)) {
+        res.setHeader('Allow', path === '/logout' ? 'GET, HEAD, POST' : 'GET, HEAD');
+        return send(405, 'Method not allowed');
+      }
+      const resource = publicFiles.get(path);
+      if (!resource) return send(404, 'Not found');
+      const [file, type] = resource;
+      const body = await readFile(new URL(file, import.meta.url));
+      res.writeHead(200, { 'Content-Type': type, 'Content-Length': body.length });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    } catch {
+      send(500, 'Unable to serve this request');
+    }
+  });
+}
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  const server = createAppServer();
+  server.listen(Number(process.env.PORT || 11222), process.env.HOST || '0.0.0.0');
+}
diff --git a/test/privacy.test.mjs b/test/privacy.test.mjs
new file mode 100644
index 0000000..8ed2904
--- /dev/null
+++ b/test/privacy.test.mjs
@@ -0,0 +1,112 @@
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { request } from 'node:http';
+import { createAppServer, publicFiles } from '../server.mjs';
+import { auditPrivacy, auditSource } from '../scripts/audit-privacy.mjs';
+
+const server = createAppServer();
+let base;
+before(async () => {
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+after(() => new Promise(resolve => server.close(resolve)));
+
+test('every public response has enforceable security headers and no cookies', async () => {
+  for (const path of [...publicFiles.keys(), '/not-found']) {
+    const response = await fetch(base + path);
+    assert.equal(response.status, path === '/not-found' ? 404 : 200);
+    const csp = response.headers.get('content-security-policy');
+    for (const directive of ["default-src 'none'", "script-src 'none'", "style-src 'self'", "img-src 'self'", "connect-src 'none'", "frame-ancestors 'none'", "form-action 'self'", "require-trusted-types-for 'script'"]) {
+      assert.ok(csp.includes(directive), directive);
+    }
+    assert.ok(!csp.includes('unsafe-inline'));
+    assert.equal(response.headers.get('referrer-policy'), 'no-referrer');
+    assert.equal(response.headers.get('x-content-type-options'), 'nosniff');
+    assert.equal(response.headers.get('x-frame-options'), 'DENY');
+    assert.equal(response.headers.get('cross-origin-resource-policy'), 'same-origin');
+    assert.equal(response.headers.get('cross-origin-opener-policy'), 'same-origin-allow-popups');
+    assert.match(response.headers.get('permissions-policy'), /camera=\(\), microphone=\(\), geolocation=\(\)/);
+    assert.equal(response.headers.get('strict-transport-security'), 'max-age=300');
+    assert.equal(response.headers.get('cache-control'), 'no-store');
+    assert.equal(response.headers.get('set-cookie'), null);
+    await response.arrayBuffer();
+  }
+});
+
+test('local assets have correct types and the hero is a real JPEG', async () => {
+  const css = await fetch(base + '/assets/styles.css');
+  assert.match(css.headers.get('content-type'), /^text\/css/);
+  assert.match(await css.text(), /url\('\/assets\/coffee.jpg'\)/);
+  const image = await fetch(base + '/assets/coffee.jpg');
+  assert.equal(image.headers.get('content-type'), 'image/jpeg');
+  assert.deepEqual([...new Uint8Array(await image.arrayBuffer()).slice(0, 3)], [255, 216, 255]);
+});
+
+test('only explicit public files are served', async () => {
+  for (const path of ['/server.mjs', '/package.json', '/.git/config', '/assets/../package.json', '/%2e%2e/package.json', '/assets/', '/cleared.html']) {
+    const response = await fetch(base + path);
+    assert.equal(response.status, 404, path);
+    await response.text();
+  }
+});
+
+test('HEAD sends headers without a body; query secrets are never reflected', async () => {
+  const head = await fetch(base + '/', { method: 'HEAD' });
+  assert.equal(head.status, 200);
+  assert.equal(await head.text(), '');
+  const response = await fetch(base + '/?email=private@example.com');
+  assert.ok(!(await response.text()).includes('private@example.com'));
+});
+
+test('logout GET is a confirmation and POST requests browser data removal', async () => {
+  const confirmation = await fetch(base + '/logout');
+  assert.equal(confirmation.headers.get('clear-site-data'), null);
+  assert.match(await confirmation.text(), /method="post"/);
+  const response = await fetch(base + '/logout', { method: 'POST', headers: { origin: base } });
+  assert.equal(response.status, 200);
+  assert.equal(response.headers.get('clear-site-data'), '"cookies", "storage", "cache"');
+  assert.equal(response.headers.get('cache-control'), 'no-store');
+  assert.match(await response.text(), /Site data clearing requested/);
+});
+
+test('cross-origin and unverified logout submissions cannot clear data', async () => {
+  for (const headers of [{ origin: 'https://attacker.example' }, { origin: 'null' }, {}, { origin: base, 'sec-fetch-site': 'cross-site' }]) {
+    const response = await fetch(base + '/logout', { method: 'POST', headers });
+    assert.equal(response.status, 403);
+    assert.equal(response.headers.get('clear-site-data'), null);
+    await response.text();
+  }
+});
+
+test('cross-site assets are blocked while external navigation works', async () => {
+  const blocked = await fetch(base + '/assets/coffee.jpg', { headers: { 'sec-fetch-site': 'cross-site' } });
+  assert.equal(blocked.status, 403);
+  await blocked.text();
+  // fetch replaces Sec-Fetch-Mode with cors; use HTTP directly to model navigation.
+  const status = await new Promise((resolve, reject) => {
+    const req = request(base + '/', { headers: { 'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'document' } }, response => {
+      response.resume();
+      response.on('end', () => resolve(response.statusCode));
+    });
+    req.on('error', reject);
+    req.end();
+  });
+  assert.equal(status, 200);
+});
+
+test('unexpected write methods are rejected', async () => {
+  const response = await fetch(base + '/', { method: 'POST', body: 'personal information' });
+  assert.equal(response.status, 405);
+  assert.equal(response.headers.get('allow'), 'GET, HEAD');
+  assert.ok(!(await response.text()).includes('personal information'));
+});
+
+test('privacy source and dependency inventory passes', auditPrivacy);
+
+test('audit detects common third-party and collection regressions', () => {
+  for (const source of ['<script src="/tracker.js"></script>', '<img src="https://tracking.example/pixel">', '@import "theme.css";', '<input name="email">', 'localStorage.setItem("id", value)', '<div onclick="track()">', 'url(//tracking.example/a)', '<iframe src="/embed">']) {
+    assert.ok(auditSource(source, 'fixture.html').length > 0, source);
+  }
+  assert.deepEqual(auditSource('<link rel="stylesheet" href="/assets/styles.css">', 'fixture.html'), []);
+});
