+  <script>
+    const form = document.getElementById('preferences-form');
+    const status = document.getElementById('preferences-status');
+    const fields = [form.elements.name, form.elements.drink, form.elements.notes];
+    const storageKey = 'daily-grind-coffee-preferences';
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved && typeof saved === 'object') {
+        fields.forEach(field => {
+          if (typeof saved[field.name] === 'string') field.value = saved[field.name];
+        });
+        if (!form.elements.drink.value) form.elements.drink.selectedIndex = 0;
+      }
+    } catch { /* The form remains usable when device storage is unavailable. */ }
+
+    let resizeFields = () => {};
+    if (!CSS.supports('field-sizing', 'content')) {
+      const canvas = document.createElement('canvas');
+      const context = canvas.getContext('2d');
+      resizeFields = () => {
+        fields.forEach(field => {
+          if (field.tagName === 'TEXTAREA') {
+            field.style.height = 'auto';
+            field.style.height = `${field.scrollHeight + 2}px`;
+          } else if (context) {
+            const style = getComputedStyle(field);
+            context.font = style.font;
+            const value = field.tagName === 'SELECT'
+              ? field.selectedOptions[0].textContent
+              : field.value || field.placeholder;
+            const padding = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
+            field.style.width = `${Math.ceil(context.measureText(value).width + padding + 4)}px`;
+          }
+        });
+      };
+      form.addEventListener('input', resizeFields);
+      form.addEventListener('change', resizeFields);
+      window.addEventListener('resize', resizeFields);
+      document.fonts.ready.then(resizeFields);
+      resizeFields();
+    }
+
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      try {
+        localStorage.setItem(storageKey, JSON.stringify(Object.fromEntries(new FormData(form))));
+        status.textContent = 'Your preferences are saved on this device. Here’s to your next good cup.';
+      } catch {
+        status.textContent = 'Device storage is unavailable. Your preferences will stay here until you leave this page.';
+      }
+    });
+
+    form.addEventListener('input', () => {
+      status.textContent = 'You have unsaved changes.';
+    });
+
+    form.addEventListener('reset', () => {
+      try {
+        localStorage.removeItem(storageKey);
+        status.textContent = 'A fresh start. Your saved preferences have been cleared.';
+      } catch {
+        status.textContent = 'Form cleared. Device storage is unavailable, so saved preferences could not be removed.';
+      }
+      requestAnimationFrame(resizeFields);
+    });
+  </script>
