+  <script>
+    const form = document.querySelector('#usual-form');
+    const controls = [...form.querySelectorAll('.content-control')];
+    const status = document.querySelector('#form-status');
+    const canvas = document.createElement('canvas');
+    const context = canvas.getContext('2d');
+
+    function fitControl(control) {
+      const style = getComputedStyle(control);
+      context.font = style.font;
+      const value = control.tagName === 'SELECT'
+        ? control.selectedOptions[0].text
+        : control.value || control.placeholder || ' ';
+      const textWidth = Math.max(...value.split('\n').map(line => context.measureText(line).width));
+      const horizontalSpace = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight)
+        + parseFloat(style.borderLeftWidth) + parseFloat(style.borderRightWidth);
+      control.style.width = `${Math.ceil(textWidth + horizontalSpace + 3)}px`;
+      if (control.tagName === 'TEXTAREA') {
+        control.style.height = 'auto';
+        control.style.height = `${control.scrollHeight + parseFloat(style.borderTopWidth) + parseFloat(style.borderBottomWidth)}px`;
+      }
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-usual'));
+      if (saved && typeof saved === 'object') {
+        controls.forEach(control => {
+          if (typeof saved[control.name] === 'string' &&
+            (control.tagName !== 'SELECT' || [...control.options].some(option => option.value === saved[control.name]))) {
+            control.value = saved[control.name];
+          }
+        });
+      }
+    } catch { /* The form remains usable when browser storage is unavailable. */ }
+
+    const fitAll = () => controls.forEach(fitControl);
+    controls.forEach(control => {
+      control.addEventListener('input', () => { fitControl(control); status.textContent = ''; });
+      control.addEventListener('change', () => fitControl(control));
+    });
+    new ResizeObserver(fitAll).observe(form);
+    document.fonts.ready.then(fitAll);
+    fitAll();
+
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      try {
+        localStorage.setItem('daily-grind-usual', JSON.stringify(Object.fromEntries(new FormData(form))));
+        status.textContent = 'Your usual is saved. See you for the next cup!';
+      } catch {
+        status.textContent = 'Your browser could not save your usual. Please allow local storage and try again.';
+      }
+    });
+  </script>
