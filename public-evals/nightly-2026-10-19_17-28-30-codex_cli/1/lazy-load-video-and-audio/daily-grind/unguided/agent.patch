diff --git a/tests/media.test.cjs b/tests/media.test.cjs
new file mode 100644
index 0000000..fe2365c
--- /dev/null
+++ b/tests/media.test.cjs
@@ -0,0 +1,90 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+const script = readFileSync('media.js', 'utf8');
+
+function setup({ observer = true, reduced = false, saveData = false } = {}) {
+  function player(top, autoplay = false) {
+    const source = { dataset: { src: 'https://example.com/media' } };
+    return {
+      dataset: { poster: 'https://example.com/poster.jpg' }, source,
+      preload: 'none', loads: 0, plays: 0,
+      querySelectorAll: () => [source], hasAttribute: () => autoplay,
+      load() { this.loads++; }, play() { this.plays++; return Promise.resolve(); },
+      getBoundingClientRect: () => ({ top, bottom: top + 300 }),
+    };
+  }
+  const players = [player(0, true), player(2000), player(3000)];
+  const listeners = {};
+  let callback, options;
+  const unobserved = [];
+  const window = {
+    innerHeight: 800, matchMedia: () => ({ matches: reduced }),
+    addEventListener: (event, fn) => { listeners[event] = fn; },
+    removeEventListener: event => { delete listeners[event]; },
+  };
+  if (observer) window.IntersectionObserver = class {
+    constructor(cb, opts) { callback = cb; options = opts; }
+    observe() {} unobserve(target) { unobserved.push(target); }
+  };
+  runInNewContext(script, {
+    window, navigator: { connection: { saveData } },
+    IntersectionObserver: window.IntersectionObserver,
+    document: { querySelectorAll: () => players, querySelector: () => null },
+  });
+  return { players, callback, options, unobserved, listeners };
+}
+
+test('HTML exposes no eager media or poster URLs to the browser', () => {
+  const html = readFileSync('index.html', 'utf8');
+  const tags = html.match(/<(?:video|audio|source)\b[^>]*>/g);
+  assert.equal(tags.filter(tag => /^<(?:video|audio)\b/.test(tag)).length, 3);
+  for (const tag of tags) {
+    assert.doesNotMatch(tag, /\s(?:src|poster|autoplay)=?/);
+    if (/^<(?:video|audio)\b/.test(tag)) assert.match(tag, /preload="none"/);
+  }
+  assert.doesNotMatch(html, /url\(|rel="preload"/);
+});
+
+test('only intersecting players receive posters, sources, and metadata preload', () => {
+  const { players, callback, options, unobserved } = setup();
+  assert.equal(options.rootMargin, '200px 0px');
+  for (const p of players) { assert.equal(p.source.src, undefined); assert.equal(p.poster, undefined); assert.equal(p.loads, 0); }
+  callback([{ target: players[1], isIntersecting: false }]);
+  assert.equal(players[1].loads, 0);
+  callback([{ target: players[1], isIntersecting: true }]);
+  assert.equal(players[1].poster, players[1].dataset.poster);
+  assert.equal(players[1].source.src, players[1].source.dataset.src);
+  assert.equal(players[1].preload, 'metadata');
+  assert.equal(players[1].loads, 1);
+  assert.equal(players[1].plays, 0);
+  assert.equal(players[2].loads, 0);
+  assert.deepEqual(unobserved, [players[1]]);
+  callback([{ target: players[1], isIntersecting: true }]);
+  assert.equal(players[1].loads, 1);
+});
+
+test('hero autoplay honors reduced motion and data saving', () => {
+  for (const config of [{}, { reduced: true }, { saveData: true }]) {
+    const { players, callback } = setup(config);
+    callback([{ target: players[0], isIntersecting: true }]);
+    assert.equal(players[0].plays, config.reduced || config.saveData ? 0 : 1);
+  }
+});
+
+test('fallback also defers offscreen players until they approach', () => {
+  const { players, listeners } = setup({ observer: false });
+  assert.equal(players[0].loads, 1);
+  assert.equal(players[1].loads, 0);
+  assert.equal(players[2].loads, 0);
+  players[1].getBoundingClientRect = () => ({ top: 950, bottom: 1250 });
+  listeners.scroll();
+  assert.equal(players[1].loads, 1);
+  assert.equal(players[2].loads, 0);
+  players[2].getBoundingClientRect = () => ({ top: 500, bottom: 800 });
+  listeners.resize();
+  assert.equal(players[2].loads, 1);
+  assert.equal(listeners.scroll, undefined);
+  assert.equal(listeners.resize, undefined);
+});
