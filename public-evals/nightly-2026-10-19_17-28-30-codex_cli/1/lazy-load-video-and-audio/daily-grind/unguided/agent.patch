diff --git a/media.js b/media.js
new file mode 100644
index 0000000..0496656
--- /dev/null
+++ b/media.js
@@ -0,0 +1,65 @@
+(() => {
+  const players = [...document.querySelectorAll('[data-lazy-media]')];
+  const hero = document.querySelector('#hero-video');
+  const toggle = document.querySelector('.hero-toggle');
+  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+  const saveData = navigator.connection?.saveData;
+
+  function activate(player) {
+    if (player.dataset.loaded) return;
+    player.dataset.loaded = 'true';
+    // data-* keeps both the preload scanner and media element from fetching early.
+    if (player.dataset.poster) player.poster = player.dataset.poster;
+    player.querySelectorAll('source[data-src]').forEach(source => {
+      source.src = source.dataset.src;
+    });
+    player.preload = 'metadata';
+    player.load();
+    if (player.hasAttribute('data-autoplay') && !reduceMotion && !saveData) {
+      player.play().catch(() => { /* The play button remains available if autoplay is blocked. */ });
+    }
+  }
+
+  if ('IntersectionObserver' in window) {
+    const observer = new IntersectionObserver(entries => {
+      entries.forEach(entry => {
+        if (!entry.isIntersecting) return;
+        activate(entry.target);
+        observer.unobserve(entry.target);
+      });
+    }, { rootMargin: '200px 0px', threshold: 0 });
+    players.forEach(player => observer.observe(player));
+  } else {
+    // Preserve deferral in older browsers instead of eagerly loading every player.
+    const pending = new Set(players);
+    function checkViewport() {
+      pending.forEach(player => {
+        const rect = player.getBoundingClientRect();
+        if (rect.top <= window.innerHeight + 200 && rect.bottom >= -200) {
+          activate(player);
+          pending.delete(player);
+        }
+      });
+      if (!pending.size) {
+        window.removeEventListener('scroll', checkViewport);
+        window.removeEventListener('resize', checkViewport);
+      }
+    }
+    window.addEventListener('scroll', checkViewport, { passive: true });
+    window.addEventListener('resize', checkViewport);
+    checkViewport();
+  }
+
+  if (hero && toggle) {
+    hero.addEventListener('play', () => { toggle.textContent = 'Pause background video'; });
+    hero.addEventListener('pause', () => { toggle.textContent = 'Play background video'; });
+    toggle.addEventListener('click', () => {
+      if (hero.paused) {
+        activate(hero);
+        hero.play().catch(() => { toggle.textContent = 'Try playing again'; });
+      } else {
+        hero.pause();
+      }
+    });
+  }
+})();
