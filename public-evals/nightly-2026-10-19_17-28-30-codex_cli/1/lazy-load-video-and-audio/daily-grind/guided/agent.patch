diff --git a/media-loading.js b/media-loading.js
new file mode 100644
index 0000000..afab778
--- /dev/null
+++ b/media-loading.js
@@ -0,0 +1,71 @@
+(() => {
+  const players = document.querySelectorAll('video[loading="lazy"], audio[loading="lazy"][controls]');
+
+  function attachResources(player) {
+    if (player.dataset.poster) {
+      player.setAttribute('poster', player.dataset.poster);
+      delete player.dataset.poster;
+    }
+    if (player.dataset.preload) {
+      player.preload = player.dataset.preload;
+      delete player.dataset.preload;
+    }
+    if (player.dataset.src) {
+      player.setAttribute('src', player.dataset.src);
+      delete player.dataset.src;
+    }
+    for (const source of player.querySelectorAll('source[data-src]')) {
+      source.setAttribute('src', source.dataset.src);
+      delete source.dataset.src;
+    }
+  }
+
+  // Native lazy loading defers posters and metadata as well as the media itself.
+  if (Object.hasOwn(HTMLMediaElement.prototype, 'loading')) {
+    players.forEach(attachResources);
+    return;
+  }
+
+  function activate(player) {
+    attachResources(player);
+    player.load();
+  }
+
+  if ('IntersectionObserver' in window) {
+    const observer = new IntersectionObserver((entries) => {
+      for (const entry of entries) {
+        if (!entry.isIntersecting) continue;
+        activate(entry.target);
+        observer.unobserve(entry.target);
+      }
+    }, { rootMargin: '200px 0px', threshold: 0 });
+    players.forEach((player) => observer.observe(player));
+    return;
+  }
+
+  // Older browsers still defer resources, using the same 200px approach distance.
+  const pending = new Set(players);
+  let scheduled = false;
+  function checkPlayers() {
+    scheduled = false;
+    for (const player of pending) {
+      const rect = player.getBoundingClientRect();
+      if (rect.bottom >= -200 && rect.top <= window.innerHeight + 200) {
+        activate(player);
+        pending.delete(player);
+      }
+    }
+    if (!pending.size) {
+      window.removeEventListener('scroll', scheduleCheck);
+      window.removeEventListener('resize', scheduleCheck);
+    }
+  }
+  function scheduleCheck() {
+    if (scheduled) return;
+    scheduled = true;
+    requestAnimationFrame(checkPlayers);
+  }
+  window.addEventListener('scroll', scheduleCheck, { passive: true });
+  window.addEventListener('resize', scheduleCheck);
+  checkPlayers();
+})();
