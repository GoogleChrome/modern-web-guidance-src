diff --git a/tests/media-loading.test.cjs b/tests/media-loading.test.cjs
new file mode 100644
index 0000000..67bfbfc
--- /dev/null
+++ b/tests/media-loading.test.cjs
@@ -0,0 +1,103 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+const script = readFileSync('media-loading.js', 'utf8');
+
+function player(audio = false) {
+  const source = { dataset: { src: 'roast.mp4' }, setAttribute(k, v) { this[k] = v; } };
+  return {
+    dataset: audio ? { src: 'podcast.mp3', preload: 'metadata' } : { poster: 'roast.jpg', preload: 'metadata' },
+    preload: 'none', loads: 0, top: 2000,
+    setAttribute(k, v) { this[k] = v; },
+    querySelectorAll() { return audio ? [] : [source]; },
+    getBoundingClientRect() { return { top: this.top, bottom: this.top + 100 }; },
+    load() { this.loads++; }, source,
+  };
+}
+
+function setup({ native = false, observer = true } = {}) {
+  const players = [player(), player(true)];
+  const events = {};
+  const state = { players, events };
+  function HTMLMediaElement() {}
+  if (native) HTMLMediaElement.prototype.loading = '';
+  class Observer {
+    constructor(callback, options) { state.callback = callback; state.options = options; state.watched = new Set(); }
+    observe(p) { state.watched.add(p); }
+    unobserve(p) { state.watched.delete(p); }
+  }
+  const window = {
+    innerHeight: 800,
+    addEventListener(name, fn) { events[name] = fn; },
+    removeEventListener(name) { delete events[name]; },
+  };
+  if (observer) window.IntersectionObserver = Observer;
+  runInNewContext(script, {
+    document: { querySelectorAll: () => players }, window, HTMLMediaElement,
+    IntersectionObserver: Observer, requestAnimationFrame: (fn) => fn(),
+  });
+  return state;
+}
+
+test('fallback withholds poster, sources, and metadata until intersection, then unobserves', () => {
+  const state = setup();
+  assert.equal(state.options.rootMargin, '200px 0px');
+  for (const p of state.players) {
+    assert.equal(p.src, undefined);
+    assert.equal(p.poster, undefined);
+    assert.equal(p.source.src, undefined);
+    assert.equal(p.preload, 'none');
+    assert.equal(p.loads, 0);
+  }
+  const [video, audio] = state.players;
+  state.callback([{ target: video, isIntersecting: false }]);
+  assert.equal(video.loads, 0);
+  state.callback([{ target: video, isIntersecting: true }]);
+  assert.equal(video.poster, 'roast.jpg');
+  assert.equal(video.source.src, 'roast.mp4');
+  assert.equal(video.preload, 'metadata');
+  assert.equal(video.loads, 1);
+  assert.equal(state.watched.has(video), false);
+  assert.equal(audio.src, undefined);
+  state.callback([{ target: audio, isIntersecting: true }]);
+  assert.equal(audio.src, 'podcast.mp3');
+  assert.equal(audio.loads, 1);
+});
+
+test('native path restores attributes without forcing load()', () => {
+  const { players } = setup({ native: true });
+  assert.equal(players[0].poster, 'roast.jpg');
+  assert.equal(players[0].source.src, 'roast.mp4');
+  assert.equal(players[1].src, 'podcast.mp3');
+  assert.ok(players.every(p => p.preload === 'metadata' && p.loads === 0));
+});
+
+test('no IntersectionObserver: loads near viewport and removes listeners after completion', () => {
+  const { players, events } = setup({ observer: false });
+  assert.ok(players.every(p => p.loads === 0));
+  players[0].top = 999;
+  events.scroll();
+  assert.equal(players[0].loads, 1);
+  assert.equal(players[1].loads, 0);
+  players[1].top = 800;
+  events.resize();
+  assert.equal(players[1].loads, 1);
+  assert.equal(events.scroll, undefined);
+  assert.equal(events.resize, undefined);
+});
+
+test('initial HTML exposes no fetchable URLs on lazy media or their sources', () => {
+  const html = readFileSync('index.html', 'utf8');
+  const media = [...html.matchAll(/<(video|audio)\b[\s\S]*?<\/\1>/g)].map(m => m[0]);
+  assert.equal(media.length, 3);
+  assert.ok(!media[0].includes('loading="lazy"'));
+  assert.match(media[0], /poster="media\/coffee-pour.jpg"/);
+  for (const markup of media.slice(1)) {
+    assert.match(markup, /loading="lazy"/);
+    assert.match(markup, /preload="none"/);
+    assert.match(markup, /\bcontrols\b/);
+    assert.doesNotMatch(markup, /\s(?:src|poster)="/);
+  }
+  assert.match(media[1], /width="1280" height="720"/);
+});
