index 0000000..0c3f844
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,134 @@
+import { createServer } from 'node:http';
+import { randomBytes } from 'node:crypto';
+import { readFile, mkdir, appendFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { join } from 'node:path';
+
+const root = fileURLToPath(new URL('.', import.meta.url));
+const dataDirectory = process.env.DATA_DIR || join(root, 'data');
+const assets = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+  ['/newsletter.js', ['newsletter.js', 'text/javascript; charset=utf-8']],
+]);
+
+// Read to the end without retaining oversized payloads, so a 413 can be sent.
+async function readBody(request, limit) {
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of request) {
+    size += chunk.length;
+    if (size <= limit) chunks.push(chunk);
+  }
+  if (size > limit) throw Object.assign(new Error('Payload too large'), { status: 413 });
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+function reply(request, response, code, message) {
+  const json = request.headers.accept?.includes('application/json');
+  response.writeHead(code, {
+    'Content-Type': json ? 'application/json; charset=utf-8' : 'text/html; charset=utf-8',
+  });
+  // Messages are fixed application strings, never submitted customer content.
+  response.end(json ? JSON.stringify({ message }) : `<!doctype html>
+<html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width">
+<title>Daily Grind newsletter</title><link rel="stylesheet" href="/styles.css">
+<main class="container"><h1>Daily Grind newsletter</h1><p>${message}</p>
+<a class="btn" href="/">Back to Daily Grind</a></main></html>`);
+}
+
+const server = createServer(async (request, response) => {
+  const nonce = randomBytes(18).toString('base64');
+  // Apply to every response, including scripts, to cover any future workers.
+  // Redirects and WebRTC stay blocked by default. No wildcard host permissions.
+  response.setHeader('Connection-Allowlist', '(response-origin "https://images.unsplash.com"); report-to=security');
+  response.setHeader('Content-Security-Policy', [
+    "default-src 'none'",
+    `script-src 'nonce-${nonce}' 'strict-dynamic'`,
+    "style-src 'self'",
+    "img-src 'self' https://images.unsplash.com",
+    "connect-src 'self'",
+    "form-action 'self'",
+    "worker-src 'none'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'none'",
+    "require-trusted-types-for 'script'",
+    'report-to security',
+  ].join('; '));
+  response.setHeader('Reporting-Endpoints', 'security="/api/security-reports"');
+  response.setHeader('X-Content-Type-Options', 'nosniff');
+  response.setHeader('X-Frame-Options', 'DENY');
+  response.setHeader('Referrer-Policy', 'no-referrer');
+  response.setHeader('X-DNS-Prefetch-Control', 'off');
+  response.setHeader('Cache-Control', 'no-store');
+
+  try {
+    const pathname = new URL(request.url, 'http://localhost').pathname;
+    if (pathname === '/api/newsletter' || pathname === '/api/security-reports') {
+      if (request.method !== 'POST') {
+        response.setHeader('Allow', 'POST');
+        return reply(request, response, 405, 'Please submit the newsletter form using POST.');
+      }
+      // Refuse cross-origin writes. PUBLIC_ORIGIN supports HTTPS reverse proxies.
+      const origin = request.headers.origin;
+      const expectedOrigin = process.env.PUBLIC_ORIGIN;
+      let allowedOrigin = !origin;
+      if (origin) {
+        try {
+          const parsed = new URL(origin);
+          allowedOrigin = expectedOrigin ? parsed.origin === new URL(expectedOrigin).origin
+            : ['http:', 'https:'].includes(parsed.protocol) && parsed.host === request.headers.host;
+        } catch { allowedOrigin = false; }
+      }
+      if (!allowedOrigin || ['cross-site', 'same-site'].includes(request.headers['sec-fetch-site'])) {
+        return reply(request, response, 403, 'Please sign up from the Daily Grind homepage.');
+      }
+      if (pathname === '/api/security-reports') {
+        // Consume reports without storing URLs, query strings, or personal data.
+        await readBody(request, 32768);
+        response.writeHead(204);
+        return response.end();
+      }
+      const type = request.headers['content-type']?.split(';')[0].trim();
+      if (!['application/json', 'application/x-www-form-urlencoded'].includes(type)) {
+        return reply(request, response, 415, 'Please submit a valid newsletter form.');
+      }
+      const body = await readBody(request, 4096);
+      let fields;
+      try {
+        fields = type === 'application/json' ? JSON.parse(body) : Object.fromEntries(new URLSearchParams(body));
+      } catch {
+        return reply(request, response, 400, 'Please submit a valid email address.');
+      }
+      const email = typeof fields?.email === 'string' ? fields.email.trim() : '';
+      if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+        return reply(request, response, 400, 'Please enter a valid email address and try again.');
+      }
+      await mkdir(dataDirectory, { recursive: true, mode: 0o700 });
+      await appendFile(join(dataDirectory, 'newsletter.jsonl'),
+        JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n', { mode: 0o600 });
+      return reply(request, response, 201, 'Thanks for subscribing! You’re on the list.');
+    }
+
+    const asset = assets.get(pathname);
+    if (!asset) return reply(request, response, 404, 'This page could not be found.');
+    if (!['GET', 'HEAD'].includes(request.method)) {
+      response.setHeader('Allow', 'GET, HEAD');
+      return reply(request, response, 405, 'This page only accepts GET and HEAD requests.');
+    }
+    let content = await readFile(join(root, asset[0]), 'utf8');
+    if (asset[0] === 'index.html') content = content.replace('{{SCRIPT_NONCE}}', nonce);
+    response.writeHead(200, { 'Content-Type': asset[1] });
+    response.end(request.method === 'HEAD' ? undefined : content);
+  } catch (error) {
+    reply(request, response, error.status === 413 ? 413 : 500,
+      error.status === 413 ? 'That request was too large. Please try again.'
+        : 'We couldn’t save your signup. Please try again later.');
+  }
+});
+
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(Number(process.env.PORT || 11222), '0.0.0.0');
