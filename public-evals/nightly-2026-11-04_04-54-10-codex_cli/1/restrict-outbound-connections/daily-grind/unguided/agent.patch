diff --git a/newsletter.js b/newsletter.js
new file mode 100644
index 0000000..c76d77f
--- /dev/null
+++ b/newsletter.js
@@ -0,0 +1,38 @@
+const form = document.querySelector('#newsletter-form');
+const status = document.querySelector('#newsletter-status');
+const button = form.querySelector('button');
+
+function showMessage(message, state) {
+  status.textContent = message;
+  status.dataset.state = state;
+}
+
+document.addEventListener('securitypolicyviolation', (event) => {
+  if (event.effectiveDirective === 'connect-src') {
+    showMessage('A request was blocked by our security policy. Please try again or contact us if this continues.', 'error');
+  }
+});
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (button.disabled || !form.reportValidity()) return;
+  button.disabled = true;
+  showMessage('Signing you up…', 'pending');
+  try {
+    const response = await fetch('/api/newsletter', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      credentials: 'same-origin',
+      redirect: 'error',
+      signal: AbortSignal.timeout(10000),
+      body: JSON.stringify({ email: form.elements.email.value.trim() }),
+    });
+    if (!response.ok) throw new Error('Signup failed');
+    showMessage('You’re on the list! Thanks for joining The Daily Grind.', 'success');
+    form.reset();
+  } catch {
+    showMessage('We couldn’t complete your signup. Please check your connection and try again.', 'error');
+  } finally {
+    button.disabled = false;
+  }
+});
