+  <script type="module">
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@0.6.0/dist/popover.min.js");
+    }
+
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+
+    // Native popovers provide light dismiss, Escape, and normal Tab navigation.
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (!action) return;
+      panel.hidePopover();
+      window.location.assign(action.dataset.href);
+    });
+
+    const hasAnchorPositioning = CSS.supports('position-area: block-end span-inline-end')
+      && CSS.supports('position-try-fallbacks: flip-block');
+
+    {
+      // Bound tall panels before native positioning tries the available sides.
+      const positionPanel = () => {
+        if (!panel.matches(':is(:popover-open, .\\:popover-open)')) return;
+        const anchor = trigger.getBoundingClientRect();
+        const viewport = window.visualViewport;
+        const leftEdge = (viewport?.offsetLeft ?? 0) + 8;
+        const topEdge = (viewport?.offsetTop ?? 0) + 8;
+        const rightEdge = leftEdge + (viewport?.width ?? window.innerWidth) - 16;
+        const bottomEdge = topEdge + (viewport?.height ?? window.innerHeight) - 16;
+
+        Object.assign(panel.style, {
+          maxWidth: `${Math.max(0, rightEdge - leftEdge)}px`,
+          maxHeight: `${Math.max(0, bottomEdge - topEdge)}px`,
+        });
+        const height = panel.getBoundingClientRect().height;
+        const below = Math.max(0, bottomEdge - anchor.bottom);
+        const above = Math.max(0, anchor.top - topEdge);
+        const flipUp = height > below && above > below;
+        panel.style.maxHeight = `${flipUp ? above : below}px`;
+        if (hasAnchorPositioning) return;
+
+        // Keep the popover; replace only unsupported anchor positioning.
+        Object.assign(panel.style, { positionArea: 'none', inset: 'auto', margin: '0' });
+        const size = panel.getBoundingClientRect();
+        const preferredLeft = anchor.left + size.width > rightEdge
+          ? anchor.right - size.width : anchor.left;
+        panel.style.left = `${Math.max(leftEdge, Math.min(preferredLeft, rightEdge - size.width))}px`;
+        panel.style.top = `${Math.max(topEdge, Math.min(
+          flipUp ? anchor.top - size.height : anchor.bottom,
+          bottomEdge - size.height,
+        ))}px`;
+      };
+
+      panel.addEventListener('toggle', positionPanel);
+      window.addEventListener('resize', positionPanel);
+      window.addEventListener('scroll', positionPanel, true);
+      window.visualViewport?.addEventListener('resize', positionPanel);
+      window.visualViewport?.addEventListener('scroll', positionPanel);
+      new ResizeObserver(positionPanel).observe(trigger);
+    }
+  </script>
