+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+
+    function positionPanel() {
+      if (!panel.matches(':popover-open')) return;
+
+      const viewport = window.visualViewport;
+      const padding = 8;
+      const leftEdge = (viewport?.offsetLeft ?? 0) + padding;
+      const topEdge = (viewport?.offsetTop ?? 0) + padding;
+      const rightEdge = leftEdge + (viewport?.width ?? window.innerWidth) - padding * 2;
+      const bottomEdge = topEdge + (viewport?.height ?? window.innerHeight) - padding * 2;
+      const anchor = trigger.getBoundingClientRect();
+
+      panel.style.maxWidth = `${Math.max(0, rightEdge - leftEdge)}px`;
+      // Measure the full content so resizing can restore the preferred placement.
+      const borderHeight = panel.offsetHeight - panel.clientHeight;
+      const contentHeight = panel.scrollHeight + borderHeight;
+      const below = Math.max(0, bottomEdge - Math.max(topEdge, anchor.bottom));
+      const above = Math.max(0, Math.min(bottomEdge, anchor.top) - topEdge);
+      const flipUp = contentHeight > below && above > below;
+      panel.style.maxHeight = `${flipUp ? above : below}px`;
+
+      const { width, height } = panel.getBoundingClientRect();
+      // Prefer the trigger's left edge, then its right edge, then clamp to view.
+      const preferredLeft = anchor.left + width <= rightEdge
+        ? anchor.left : anchor.right - width;
+      const left = Math.max(leftEdge, Math.min(preferredLeft, rightEdge - width));
+      const preferredTop = flipUp ? anchor.top - height : anchor.bottom;
+      const top = Math.max(topEdge, Math.min(preferredTop, bottomEdge - height));
+      panel.style.left = `${left}px`;
+      panel.style.top = `${top}px`;
+    }
+
+    const observer = new ResizeObserver(positionPanel);
+    panel.addEventListener('toggle', () => {
+      const open = panel.matches(':popover-open');
+      trigger.setAttribute('aria-expanded', String(open));
+      if (open) {
+        positionPanel();
+        observer.observe(trigger);
+        observer.observe(panel);
+      } else {
+        observer.disconnect();
+      }
+    });
+
+    window.addEventListener('resize', positionPanel);
+    document.addEventListener('scroll', positionPanel, true);
+    window.visualViewport?.addEventListener('resize', positionPanel);
+    window.visualViewport?.addEventListener('scroll', positionPanel);
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (action) {
+        panel.hidePopover();
+        window.location.assign(action.dataset.href);
+      }
+    });
+  </script>
