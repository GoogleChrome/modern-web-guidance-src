+  const input = get<HTMLInputElement>(`color-${id}`);
+  input.value = value;
+  get(`hex-${id}`).textContent = value.toUpperCase();
+  const row = input.closest('.color-row')!;
+  (row.querySelector('.color-indicator') as HTMLElement).style.background = value;
+}
+function stopClock() { clearInterval(clock); }
+function render() {
+  clearTimeout(changeTimer);
+  worker?.terminate();
+  stopClock();
+  const width = Number(resolution.value), height = width * 3 / 4;
+  status.textContent = 'Rendering';
+  count.textContent = `0 / ${samples} spp`;
+  get('dimensions').textContent = `${width} × ${height}`;
+  get('engine-label').textContent = 'WebAssembly active';
+  get('render-dot').style.background = '#88a77b';
+  progress.style.width = '0%';
+  started = performance.now();
+  clock = setInterval(() => { time.textContent = `${((performance.now() - started) / 1000).toFixed(1)}s`; }, 100);
+  const fail = () => {
+    stopClock();
+    status.textContent = 'Render unavailable';
+    get('engine-label').textContent = 'Could not load WebAssembly';
+    get('render-dot').style.background = '#be6d55';
+    get('randomize').title = 'Click to retry rendering with a new palette';
+    worker?.terminate();
+  };
+  try {
+    worker = new Worker(`${import.meta.env.BASE_URL}wasm/render-worker.js`);
+    worker.onerror = fail;
+    worker.onmessage = ({ data }) => {
+      if (data.type === 'error') { console.error('smallpt:', data.message); fail(); return; }
+      if (data.type === 'progress') progress.style.width = `${data.progress * 100}%`;
+      if (data.type === 'frame') {
+        if (canvas.width !== data.width || canvas.height !== data.height) {
+          canvas.width = data.width; canvas.height = data.height;
+        }
+        ctx.putImageData(new ImageData(new Uint8ClampedArray(data.buffer), data.width, data.height), 0, 0);
+        canvas.classList.add('ready');
+        hasFrame = true;
+        count.textContent = `${data.samples} / ${samples} spp`;
+        if (data.done) {
+          stopClock();
+          time.textContent = `${data.elapsed.toFixed(1)}s`;
+          status.textContent = 'Render complete';
+          progress.style.width = '100%';
+          worker?.terminate();
+        }
+      }
+    };
+    const seed = crypto.getRandomValues(new Uint32Array(1))[0];
