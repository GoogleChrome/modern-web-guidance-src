+const get = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
+const canvas = get<HTMLCanvasElement>('render-canvas');
+const ctx = canvas.getContext('2d')!;
+const preview = get<HTMLImageElement>('preview');
+const status = get('render-status');
+const count = get('sample-count');
+const time = get('render-time');
+const progress = get('progress');
+const resolution = get<HTMLSelectElement>('resolution');
+const originals: Record<number, string> = { 0: '#bf4040', 1: '#4040bf', 6: '#ffffff', 7: '#ffffff' };
+let samples = 64;
+let worker: Worker | undefined;
+let hasFrame = false;
+let started = 0;
+let clock: ReturnType<typeof setInterval>;
+let changeTimer: ReturnType<typeof setTimeout>;
+
+function colorData() {
+  return Object.fromEntries(Object.keys(originals).map((key) => {
+    const hex = get<HTMLInputElement>(`color-${key}`).value;
+    return [key, [1, 3, 5].map((offset) => Math.min(.999, parseInt(hex.slice(offset, offset + 2), 16) / 255))];
+  }));
