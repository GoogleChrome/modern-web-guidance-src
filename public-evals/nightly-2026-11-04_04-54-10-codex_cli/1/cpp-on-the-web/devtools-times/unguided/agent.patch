new file mode 100644
index 0000000..1fd0fa8
--- /dev/null
+++ b/public/wasm/render-worker.js
@@ -0,0 +1,24 @@
+/* smallpt runs entirely in this worker; no rendering service is used. */
+importScripts('./smallpt.js');
+let engine;
+self.onmessage = async ({ data }) => {
+  try {
+    engine ||= await createSmallpt({ locateFile: (name) => new URL(name, self.location.href).href });
+    const { width, height, samples, seed, colors } = data;
+    engine._init(width, height, seed);
+    for (const [id, color] of Object.entries(colors)) engine._set_color(Number(id), ...color);
+    const passes = samples / 4;
+    const start = performance.now();
+    for (let pass = 0; pass < passes; pass++) {
+      for (let row = 0; row < height; row += 8) {
+        engine._render_rows(row, Math.min(8, height - row));
+        self.postMessage({ type: 'progress', progress: (pass + Math.min(row + 8, height) / height) / passes, samples: pass * 4 });
+      }
+      const buffer = engine.HEAPU8.slice(engine._get_pixels(), engine._get_pixels() + width * height * 4);
+      engine._next_pass();
+      self.postMessage({ type: 'frame', buffer, width, height, samples: (pass + 1) * 4, elapsed: (performance.now() - start) / 1000, done: pass + 1 === passes }, [buffer.buffer]);
+    }
+  } catch (error) {
+    self.postMessage({ type: 'error', message: String(error) });
+  }
+};
