+  } catch (error) { console.error(error); fail(); }
+}
+function randomHex(bright = false) {
+  const values = crypto.getRandomValues(new Uint8Array(3));
+  return '#' + Array.from(values, (value) => Math.round(bright ? 180 + value / 255 * 75 : 55 + value / 255 * 155).toString(16).padStart(2, '0')).join('');
+}
+get('randomize').addEventListener('click', () => {
+  for (const id of Object.keys(originals)) updateColor(id, randomHex(Number(id) >= 6));
+  render();
+});
+get('reset').addEventListener('click', () => {
+  for (const [id, color] of Object.entries(originals)) updateColor(id, color);
+  render();
+});
+for (const id of Object.keys(originals)) {
+  const input = get<HTMLInputElement>(`color-${id}`);
+  input.addEventListener('input', () => {
