+++ b/src/scripts/render-lab.ts
@@ -0,0 +1,144 @@
+const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
+const canvas = byId<HTMLCanvasElement>('render');
+const context = canvas.getContext('2d');
+const root = byId<HTMLElement>('playground');
+const base = root.dataset.base!;
+const samples = byId<HTMLSelectElement>('samples');
+const resolution = byId<HTMLSelectElement>('resolution');
+const state = byId<HTMLElement>('render-state');
+const download = byId<HTMLButtonElement>('download');
+const progress = byId<HTMLElement>('progress-bar');
+const elapsed = byId<HTMLElement>('elapsed');
+const initialColors: Record<string, number[]> = {
+  0: [.75, .25, .25], 1: [.25, .25, .75], 6: [.999, .999, .999], 7: [.999, .999, .999],
+};
+let colors = structuredClone(initialColors);
+let worker: Worker | undefined;
+let timer: ReturnType<typeof setInterval> | undefined;
+let started = 0;
+let version = 0;
+
+function colorHex(color: number[]) {
+  return '#' + color.map((c) => Math.round(c * 255).toString(16).padStart(2, '0')).join('').toUpperCase();
+}
+function updateColors() {
+  for (const [name, id] of [['mirror', '6'], ['glass', '7']]) {
+    const hex = colorHex(colors[id]);
+    byId(`${name}-hex`).textContent = hex === '#FFFFFF' ? '#FFFFFF' : hex;
+    byId(`${name}-swatch`).style.background = `radial-gradient(circle at 30% 25%, #fff 0%, ${hex} 45%, #67715d 100%)`;
+  }
+  byId('wall-left').style.background = colorHex(colors[0]);
+  byId('wall-right').style.background = colorHex(colors[1]);
+}
+function fail(message: string) {
+  worker?.terminate();
+  worker = undefined;
+  clearInterval(timer);
+  state.textContent = 'Render failed — click Randomize to retry';
+  state.classList.add('error');
+  state.title = message;
+  byId('viewport-label').textContent = 'RENDER UNAVAILABLE';
+  byId('state-dot').style.background = '#bd4928';
+}
+function startRender() {
+  if (!context) { fail('Canvas 2D is unavailable in this browser.'); return; }
+  const currentVersion = ++version;
+  worker?.terminate();
+  clearInterval(timer);
+  state.classList.remove('error');
+  state.removeAttribute('title');
+  const width = Number(resolution.value);
+  const height = width * 3 / 4;
+  // Keep the previous output visible while new scanlines arrive.
+  const previous = document.createElement('canvas');
+  previous.width = canvas.width;
+  previous.height = canvas.height;
+  previous.getContext('2d')?.drawImage(canvas, 0, 0);
+  canvas.width = width;
+  canvas.height = height;
+  context.drawImage(previous, 0, 0, width, height);
+  byId('resolution-metric').textContent = `${width} × ${height}`;
+  byId('samples-metric').textContent = `${samples.value} samples / pixel`;
+  byId('viewport-label').textContent = 'SMALLPT / LIVE OUTPUT';
+  state.textContent = 'Rendering · 0%';
+  byId('state-dot').style.background = '#d65a35';
+  download.disabled = true;
+  progress.style.width = '0%';
+  started = performance.now();
+  elapsed.textContent = '0.0s';
+  timer = setInterval(() => { elapsed.textContent = `${((performance.now() - started) / 1000).toFixed(1)}s`; }, 100);
+  try {
+    worker = new Worker(`${base}wasm/render-worker.js`, { type: 'module' });
+    worker.onerror = (event) => { if (currentVersion === version) fail(event.message); };
+    worker.onmessage = ({ data }) => {
+      if (currentVersion !== version) return;
+      if (data.type === 'rows') {
+        canvas.classList.add('active');
+        context.putImageData(new ImageData(data.pixels, data.width, data.count), 0, data.y);
+        const percent = Math.round((data.y + data.count) / data.height * 100);
+        progress.style.width = `${percent}%`;
+        state.textContent = `Rendering · ${percent}%`;
+      } else if (data.type === 'done') {
+        clearInterval(timer);
+        elapsed.textContent = `${((performance.now() - started) / 1000).toFixed(1)}s`;
+        state.textContent = 'Render complete';
+        byId('state-dot').style.background = '#79966b';
+        download.disabled = false;
+        byId('reference').hidden = true;
+        worker?.terminate();
+        worker = undefined;
+      } else if (data.type === 'error') fail(data.message);
+    };
+    const randomSeed = crypto.getRandomValues(new Uint32Array(1))[0];
+    worker.postMessage({ width, height, samples: Number(samples.value), colors, seed: randomSeed });
+  } catch (error) { fail(String(error)); }
+}
+byId('randomize').addEventListener('click', () => {
+  const values = crypto.getRandomValues(new Uint32Array(12));
+  let i = 0;
+  const random = () => values[i++] / 4294967295;
+  // Saturated wall accents and gentle mirror/glass tints retain light throughput.
+  for (const id of ['0', '1']) colors[id] = [0, 0, 0].map(() => .18 + random() * .62);
+  for (const id of ['6', '7']) colors[id] = [0, 0, 0].map(() => .66 + random() * .339);
+  updateColors();
+  startRender();
+});
+byId('reset').addEventListener('click', () => { colors = structuredClone(initialColors); updateColors(); startRender(); });
+samples.addEventListener('change', startRender);
+resolution.addEventListener('change', startRender);
+download.addEventListener('click', () => {
+  canvas.toBlob((blob) => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = `smallpt-${canvas.width}x${canvas.height}-${Date.now()}.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+const viewport = byId('viewport');
+const fullscreenButton = byId('fullscreen');
+fullscreenButton.addEventListener('click', async () => {
+  try {
+    if (document.fullscreenElement) await document.exitFullscreen();
+    else if (viewport.requestFullscreen) await viewport.requestFullscreen();
+    else {
+      const expanded = viewport.classList.toggle('expanded');
+      fullscreenButton.setAttribute('aria-label', expanded ? 'Close expanded render' : 'Expand render');
+      // Keep an accessible close control inside the fullscreen fallback.
+      if (expanded) {
+        const close = document.createElement('button');
+        close.id = 'close-expanded'; close.textContent = 'Close ×';
+        close.style.cssText = 'position:absolute;right:20px;top:15px;padding:8px 14px;border:0;border-radius:4px;z-index:2';
+        close.onclick = () => { viewport.classList.remove('expanded'); close.remove(); fullscreenButton.focus(); };
+        viewport.append(close); close.focus();
+      }
+    }
+  } catch { state.textContent = 'Full screen unavailable'; }
+});
+document.addEventListener('keydown', (event) => {
+  if (event.key === 'Escape') { viewport.classList.remove('expanded'); byId('close-expanded')?.remove(); }
+});
+window.addEventListener('pagehide', () => { worker?.terminate(); clearInterval(timer); });
+startRender();
