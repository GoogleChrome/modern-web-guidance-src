+  width=w; height=h;
+  free(pixels);
+  pixels=static_cast<unsigned char*>(malloc(w*h*4));
+  memset(pixels,255,w*h*4);
+  spheres[0].c=Vec(.68,.67,.64);
+  spheres[1].c=Vec(.58,.62,.66);
+  return pixels;
+}
+void material(int sphere, double r, double g, double b, int type) {
+  if (sphere<0 || sphere>1 || type<0 || type>2) return;
+  spheres[6+sphere].c=Vec(r,g,b);
+  spheres[6+sphere].refl=static_cast<Refl_t>(type);
+}
+void render_rows(int start, int count, int samples, int seed) {
+  Ray cam(Vec(50,52,295.6),Vec(0,-.042612,-1).norm());
+  Vec cx(width*.5135/height),cy=(cx%cam.d).norm()*.5135;
+  int samps=samples/4;
+  for(int y=start;y<start+count && y<height;y++) {
+    unsigned short Xi[3]={static_cast<unsigned short>(seed),static_cast<unsigned short>(seed>>16),static_cast<unsigned short>(y*y*y+1)};
+    for(int x=0;x<width;x++) {
+      Vec color;
+      for(int sy=0;sy<2;sy++) for(int sx=0;sx<2;sx++) {
+        Vec r;
+        for(int s=0;s<samps;s++) {
+          double r1=2*erand48(Xi),dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+          double r2=2*erand48(Xi),dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+          Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+          r=r+radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*(1./samps);
+        }
+        color=color+Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+      }
+      int i=((height-y-1)*width+x)*4;
+      pixels[i]=toInt(color.x);pixels[i+1]=toInt(color.y);pixels[i+2]=toInt(color.z);pixels[i+3]=255;
+    }
+  }
+}
+}
