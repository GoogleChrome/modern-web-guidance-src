diff --git a/renderer.worker.js b/renderer.worker.js
new file mode 100644
index 0000000..6547409
--- /dev/null
+++ b/renderer.worker.js
@@ -0,0 +1,20 @@
+import createSmallpt from './assets/smallpt.mjs';
+let engine;
+self.onmessage = async ({ data }) => {
+  try {
+    engine ??= await createSmallpt();
+    const { width, height, samples, seed, materials } = data;
+    const ptr = engine._setup(width, height);
+    materials.forEach((m, i) => engine._material(i, ...m.color, m.type));
+    for (let row = 0; row < height; row += 4) {
+      engine._render_rows(row, Math.min(4, height - row), samples, seed);
+      const start = (height - Math.min(row + 4, height)) * width * 4;
+      const end = (height - row) * width * 4;
+      const pixels = engine.HEAPU8.slice(ptr + start, ptr + end);
+      self.postMessage({ pixels, y: height - Math.min(row + 4, height), width, rows: Math.min(4, height - row), progress: Math.min(row + 4, height) / height }, [pixels.buffer]);
+      await new Promise(resolve => setTimeout(resolve, 0));
+    }
+  } catch (error) {
+    self.postMessage({ error: error.message || String(error) });
+  }
+};
diff --git a/scripts/build-preview.mjs b/scripts/build-preview.mjs
