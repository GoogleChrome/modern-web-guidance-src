+const $ = id => document.getElementById(id);
+const canvas = $('render');
+const ctx = canvas.getContext('2d');
+let worker, renderVersion = 0, seed = 42, ready = false;
+const defaults = ['#b83111', '#f0d6a8'];
+const colors = [...defaults];
+const status = $('render-status');
+const preview = new Image();
+preview.onload = () => {
+  if (!ready) {
+    ctx.drawImage(preview, 0, 0, canvas.width, canvas.height);
+    status.textContent = 'Preview ready · Make it yours';
+  }
+};
+preview.onerror = () => { if (!ready) render(); };
+preview.src = './assets/preview.png';
+function rgb(hex) { return hex.match(/[a-f\d]{2}/gi).map(x => Math.min(.99, parseInt(x, 16) / 255)); }
+function updateMaterials() {
+  colors.forEach((color, i) => {
+    const suffix = i ? 'two' : 'one';
+    $('color-' + suffix).value = color;
+    $('hex-' + suffix).textContent = color.toUpperCase();
+    $('sphere-' + suffix).style.background = 'radial-gradient(circle at 30% 25%, #ffffffaa, ' + color + ' 48%, #332c25 100%)';
+  });
+}
+function render() {
+  const version = ++renderVersion;
+  worker?.terminate();
+  const width = Number($('resolution').value), height = width * .75;
+  const samples = Number($('samples').value);
+  // Retain the previous output while the new image is traced.
+  const previous = document.createElement('canvas');
+  previous.width = canvas.width; previous.height = canvas.height;
+  previous.getContext('2d').drawImage(canvas, 0, 0);
+  canvas.width = width; canvas.height = height;
+  ctx.drawImage(previous, 0, 0, width, height);
+  $('resolution-readout').textContent = width + ' × ' + height;
+  $('sample-count').textContent = samples;
+  $('seed-readout').textContent = 'SEED ' + String(seed).padStart(4, '0');
+  $('progress').style.width = '0%';
+  status.textContent = 'Preparing renderer…';
+  const start = performance.now();
+  let received = false;
+  try {
+    worker = new Worker(new URL('./renderer.worker.js', import.meta.url), { type: 'module' });
+    const fail = message => {
+      if (version !== renderVersion) return;
+      status.textContent = 'Render failed · ' + message;
+      worker?.terminate();
+    };
+    worker.onerror = event => fail(event.message || 'WebAssembly could not load');
+    worker.onmessage = ({ data }) => {
+      if (version !== renderVersion) return;
+      if (data.error) return fail(data.error);
+      if (!received) { ctx.fillStyle = '#36382f'; ctx.fillRect(0, 0, width, height); received = true; }
+      ready = true;
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), width, data.rows), 0, data.y);
+      const percent = Math.round(data.progress * 100);
+      $('progress').style.width = percent + '%';
+      status.textContent = data.progress === 1 ? 'Render complete · ' + ((performance.now() - start) / 1000).toFixed(1) + 's' : 'Tracing light · ' + percent + '%';
+      if (data.progress === 1) worker.terminate();
+    };
+    worker.postMessage({ width, height, samples, seed, materials: colors.map((color, i) => ({ color: rgb(color), type: Number($(i ? 'material-two' : 'material-one').value) })) });
+  } catch (error) {
+    status.textContent = 'Renderer unavailable · ' + error.message;
+  }
+}
+$('randomize').addEventListener('click', () => {
+  const entropy = crypto.getRandomValues(new Uint32Array(3));
+  seed = entropy[0] % 1000000;
+  for (let i = 0; i < 2; i++) {
+    // Moderate reflectance keeps roulette paths bounded, with vibrant colors.
+    const hue = entropy[i + 1] % 360;
+    const saturation = 55 + (entropy[i + 1] % 25), lightness = i ? 72 : 46;
+    const a = saturation * Math.min(lightness / 100, 1 - lightness / 100) / 100;
+    const channel = n => {
+      const k = (n + hue / 30) % 12;
+      return Math.round(255 * (lightness / 100 - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)))).toString(16).padStart(2, '0');
+    };
+    colors[i] = '#' + channel(0) + channel(8) + channel(4);
+  }
+  updateMaterials(); render();
+});
+$('reset').addEventListener('click', () => {
+  seed = 42; colors.splice(0, 2, ...defaults);
+  $('material-one').value = '0'; $('material-two').value = '2';
+  $('samples').value = '64'; $('resolution').value = '720';
+  updateMaterials(); render();
+});
+['one', 'two'].forEach((suffix, i) => {
+  $('color-' + suffix).addEventListener('change', event => { colors[i] = event.target.value; updateMaterials(); render(); });
+  $('material-' + suffix).addEventListener('change', render);
+});
+['samples', 'resolution'].forEach(id => $(id).addEventListener('change', render));
+$('download').addEventListener('click', () => {
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob), a = document.createElement('a');
+    a.href = url; a.download = 'smallpt-' + seed + '.png'; a.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+updateMaterials();
+// A precomputed Wasm render is displayed immediately; begin a local render after
+// the preview has loaded, preserving it until the first computed rows arrive.
+preview.addEventListener('load', () => setTimeout(render, 900), { once: true });
