new file mode 100644
index 0000000..dcb0b17
--- /dev/null
+++ b/app.js
@@ -0,0 +1,97 @@
+const $ = id => document.getElementById(id);
+const canvas = $('canvas');
+const ctx = canvas.getContext('2d');
+let worker, started, timer, rendering = false, hasPixels = false;
+let sourceLoaded = false;
+const colorInputs = [...document.querySelectorAll('input[type="color"]')];
+function updateTime() { if (rendering) $('time-stat').textContent = ((performance.now() - started) / 1000).toFixed(1) + 's'; }
+function render() {
+  worker?.terminate();
+  clearInterval(timer);
+  const width = Number($('resolution').value), height = width * 3 / 4;
+  const samples = Number($('samples').value);
+  // Retain the last output underneath the new scanlines while the image resolves.
+  const previous = document.createElement('canvas');
+  previous.width = canvas.width; previous.height = canvas.height;
+  previous.getContext('2d').drawImage(canvas, 0, 0);
+  canvas.width = width; canvas.height = height;
+  if (hasPixels) ctx.drawImage(previous, 0, 0, width, height);
+  $('size-stat').textContent = `${width} × ${height}`;
+  $('spp-stat').textContent = samples;
+  $('status').textContent = 'Rendering · 0%';
+  $('render-toast').hidden = false;
+  $('render-toast').style.display = 'flex';
+  $('toast-text').textContent = 'Tracing light…';
+  $('progress').style.width = '0%';
+  started = performance.now(); rendering = true;
+  timer = setInterval(updateTime, 100);
+  const colors = Object.fromEntries(colorInputs.map(input => [input.dataset.index, [1, 3, 5].map(i => parseInt(input.value.slice(i, i + 2), 16) / 255)]));
+  try {
+    worker = new Worker('public/render-worker.js');
+    worker.onerror = event => fail(event.message);
+    worker.onmessage = ({ data }) => {
+      if (data.error) { fail(data.error); return; }
+      ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), width, data.rows - data.row), 0, data.row);
+      canvas.style.opacity = '1'; hasPixels = true;
+      const percentage = Math.round(data.rows / height * 100);
+      $('progress').style.width = `${percentage}%`;
+      $('status').textContent = `Rendering · ${percentage}%`;
+      if (data.rows === height) {
+        updateTime(); rendering = false; clearInterval(timer);
+        $('status').textContent = 'Render complete';
+        $('toast-text').textContent = 'Render complete';
+        $('render-toast').style.display = 'none';
+        worker.terminate();
+      }
+    };
+    worker.postMessage({ width, height, samples, seed: crypto.getRandomValues(new Uint32Array(1))[0], colors });
+  } catch (error) { fail(error.message); }
+}
+function fail(message) {
+  rendering = false; clearInterval(timer); worker?.terminate();
+  $('status').textContent = 'Render unavailable · try again';
+  $('toast-text').textContent = 'Could not load WebAssembly';
+  console.error('smallpt:', message);
+}
+$('randomize').addEventListener('click', () => {
+  colorInputs.forEach(input => {
+    // Bright, varied reflectances keep the room illuminated and the materials readable.
+    const hue = Math.random() * 360, saturation = .35 + Math.random() * .4, lightness = .5 + Math.random() * .18;
+    const a = saturation * Math.min(lightness, 1 - lightness);
+    const channel = n => { const k = (n + hue / 30) % 12; return Math.round(255 * (lightness - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)))).toString(16).padStart(2, '0'); };
+    input.value = '#' + channel(0) + channel(8) + channel(4);
+  });
+  showTab(false); render();
+});
+$('rerender').addEventListener('click', () => { showTab(false); render(); });
+colorInputs.forEach(input => input.addEventListener('change', () => { showTab(false); render(); }));
+$('download').addEventListener('click', async () => {
+  const output = document.createElement('canvas');
+  output.width = canvas.width; output.height = canvas.height;
+  const context = output.getContext('2d');
+  if (hasPixels) context.drawImage(canvas, 0, 0);
+  else { try { await $('preview').decode(); context.drawImage($('preview'), 0, 0, output.width, output.height); } catch { return; } }
+  output.toBlob(blob => {
+    if (!blob) return;
+    const link = document.createElement('a');
+    link.href = URL.createObjectURL(blob); link.download = 'smallpt-render.png'; link.click();
+    setTimeout(() => URL.revokeObjectURL(link.href), 1000);
+  }, 'image/png');
+});
+async function showTab(source) {
+  $('viewport').style.display = source ? 'none' : 'flex';
+  $('source-view').hidden = !source;
+  for (const [id, active] of [['source-tab', source], ['render-tab', !source]]) {
+    $(id).classList.toggle('active', active); $(id).setAttribute('aria-selected', String(active));
+  }
+  if (source && !sourceLoaded) {
+    try {
+      const response = await fetch('public/smallpt.cpp');
+      if (!response.ok) throw new Error('Source unavailable');
+      $('source-code').textContent = await response.text(); sourceLoaded = true;
+    } catch { $('source-code').textContent = 'Could not load the source. Select this tab to try again.'; }
+  }
+}
+$('source-tab').addEventListener('click', () => showTab(true));
+$('render-tab').addEventListener('click', () => showTab(false));
+render();
