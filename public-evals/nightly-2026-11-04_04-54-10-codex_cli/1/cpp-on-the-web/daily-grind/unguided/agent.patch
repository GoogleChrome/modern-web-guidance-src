new file mode 100644
index 0000000..718b127
--- /dev/null
+++ b/public/render-worker.js
@@ -0,0 +1,23 @@
+importScripts('smallpt.js');
+let modulePromise = createSmallpt();
+self.onmessage = async ({ data }) => {
+  try {
+    const module = await modulePromise;
+    const { width, height, samples, seed, colors } = data;
+    for (const [index, color] of Object.entries(colors)) {
+      module._set_color(Number(index), ...color);
+    }
+    module._init_render(width, height, samples, seed);
+    const start = performance.now();
+    let rows = 0;
+    while (rows < height) {
+      const previous = rows;
+      rows = module._render_rows(4);
+      const offset = module._get_pixels() + previous * width * 4;
+      const pixels = module.HEAPU8.slice(offset, offset + (rows - previous) * width * 4);
+      self.postMessage({ pixels, row: previous, rows, elapsed: performance.now() - start }, [pixels.buffer]);
+    }
+  } catch (error) {
+    self.postMessage({ error: error.message || String(error) });
+  }
+};
