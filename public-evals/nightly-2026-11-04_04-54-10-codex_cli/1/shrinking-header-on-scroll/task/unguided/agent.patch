+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      var space = document.querySelector('.nav-space');
+      var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
+      var nativeScrollAnimation = window.CSS && window.CSS.supports &&
+        window.CSS.supports('animation-timeline', 'scroll(root block)') &&
+        window.CSS.supports('animation-range', '0px 160px');
+
+      if (nativeScrollAnimation) return;
+
+      // Older browsers get the same continuous interpolation, once per frame.
+      var framePending = false;
+      var expandedHeight;
+      var compactHeight;
+      var requestFrame = window.requestAnimationFrame || function (callback) {
+        return window.setTimeout(callback, 16);
+      };
+
+      function update() {
+        framePending = false;
+        if (reducedMotion && reducedMotion.matches) {
+          nav.style.height = '';
+          return;
+        }
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.max(0, Math.min(scrollTop / 160, 1));
+        nav.style.height = (expandedHeight - (expandedHeight - compactHeight) * progress) + 'px';
+      }
+
+      function measure() {
+        nav.style.height = '';
+        expandedHeight = space.offsetHeight;
+        // Both layouts shrink by 1.25rem; read rem size to honor text zoom.
+        compactHeight = expandedHeight - 1.25 * parseFloat(window.getComputedStyle(document.documentElement).fontSize);
+        update();
+      }
+
+      window.addEventListener('scroll', function () {
+        if (!framePending) {
+          framePending = true;
+          requestFrame.call(window, update);
+        }
+      }, false);
+      window.addEventListener('resize', measure, false);
+      window.addEventListener('pageshow', measure, false);
+      if (reducedMotion) {
+        if (reducedMotion.addEventListener) reducedMotion.addEventListener('change', measure);
+        else if (reducedMotion.addListener) reducedMotion.addListener(measure);
+      }
+      measure();
+    }());
+  </script>
