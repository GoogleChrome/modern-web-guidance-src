+  <script>
+    // Match the native animation in browsers without full scroll-timeline support.
+    if (!(window.CSS && CSS.supports && CSS.supports(
+      '(animation-timeline: scroll()) and (animation-range: 0% 100%)'
+    ))) {
+      var navigation = document.querySelector('nav');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var pendingFrame = false;
+      var expandedHeight;
+      var compactHeight;
+
+      function updateNavigation() {
+        pendingFrame = false;
+        if (reducedMotion.matches) {
+          navigation.style.removeProperty('height');
+          return;
+        }
+        var progress = Math.min(1, Math.max(0, window.pageYOffset / 160));
+        navigation.style.height =
+          (expandedHeight + (compactHeight - expandedHeight) * progress) + 'px';
+      }
+
+      function scheduleNavigation() {
+        if (!pendingFrame) {
+          pendingFrame = true;
+          window.requestAnimationFrame(updateNavigation);
+        }
+      }
+
+      function measureNavigation() {
+        var styles = window.getComputedStyle(document.documentElement);
+        expandedHeight = parseFloat(styles.getPropertyValue('--nav-height'));
+        compactHeight = parseFloat(styles.getPropertyValue('--nav-compact-height'));
+        scheduleNavigation();
+      }
+
+      window.addEventListener('scroll', scheduleNavigation, { passive: true });
+      window.addEventListener('resize', measureNavigation);
+      window.addEventListener('pageshow', scheduleNavigation);
+      // addListener also covers older Safari versions without addEventListener here.
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', scheduleNavigation);
+      } else {
+        reducedMotion.addListener(scheduleNavigation);
+      }
+      measureNavigation();
+    }
+  </script>
