diff --git a/translation.js b/translation.js
new file mode 100644
index 0000000..42f9f4f
--- /dev/null
+++ b/translation.js
@@ -0,0 +1,104 @@
+(() => {
+  const language = document.getElementById('language');
+  const button = document.getElementById('translate');
+  const status = document.getElementById('translation-status');
+  const paragraphs = [...document.querySelectorAll('[data-translate]')];
+  // Always translate the original copy, never an earlier machine translation.
+  const originals = paragraphs.map((paragraph) => paragraph.textContent);
+  const cache = new Map([['en', originals]]);
+  let displayedLanguage = 'en';
+  let selectionVersion = 0;
+  let readyOptions = null;
+
+  if (!window.isSecureContext || !('Translator' in window)) {
+    status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop browser over HTTPS. You can still read our menu and story in English.';
+    return;
+  }
+
+  language.disabled = false;
+  status.textContent = 'Choose a language to translate our menu descriptions and story.';
+
+  language.addEventListener('change', async () => {
+    const version = ++selectionVersion;
+    const targetLanguage = language.value;
+    readyOptions = null;
+    button.disabled = true;
+    button.textContent = targetLanguage === 'en' ? 'Show English' : 'Translate';
+
+    if (targetLanguage === displayedLanguage) {
+      status.textContent = 'This language is already displayed.';
+      return;
+    }
+    if (cache.has(targetLanguage)) {
+      button.disabled = false;
+      status.textContent = 'Ready to switch languages.';
+      return;
+    }
+
+    status.textContent = 'Checking on-device translation availability…';
+    const options = { sourceLanguage: 'en', targetLanguage };
+    try {
+      const availability = await window.Translator.availability(options);
+      if (version !== selectionVersion) return;
+      if (availability === 'unavailable') {
+        status.textContent = 'This language is unavailable on your device. Please choose another language.';
+        return;
+      }
+      readyOptions = options;
+      button.disabled = false;
+      status.textContent = availability === 'available'
+        ? 'Ready to translate on your device.'
+        : 'Click Translate to download the language pack and translate on your device.';
+    } catch {
+      if (version !== selectionVersion) return;
+      status.textContent = 'Could not check translation availability. Choose a language again to retry.';
+    }
+  });
+
+  button.addEventListener('click', async () => {
+    const targetLanguage = language.value;
+    const languageName = language.selectedOptions[0].textContent;
+    let translator;
+    button.disabled = true;
+    language.disabled = true;
+    try {
+      let translations = cache.get(targetLanguage);
+      if (!translations) {
+        status.textContent = 'Preparing on-device translation…';
+        // Availability was checked on selection so create() runs directly in
+        // this click's user activation, including when a download is needed.
+        translator = await window.Translator.create({
+          ...readyOptions,
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              status.textContent = `Downloading language pack: ${Math.round(event.loaded * 100)}%`;
+            });
+          },
+        });
+        translations = [];
+        for (const [index, original] of originals.entries()) {
+          status.textContent = `Translating on your device: ${index + 1} of ${originals.length}…`;
+          translations.push(await translator.translate(original));
+        }
+        cache.set(targetLanguage, translations);
+      }
+
+      // Commit together so a failed translation leaves the existing copy intact.
+      paragraphs.forEach((paragraph, index) => {
+        paragraph.textContent = translations[index];
+        paragraph.lang = targetLanguage;
+        paragraph.dir = targetLanguage === 'ar' ? 'rtl' : 'ltr';
+      });
+      displayedLanguage = targetLanguage;
+      status.textContent = targetLanguage === 'en'
+        ? 'Original English restored.'
+        : `Menu descriptions and story are now in ${languageName}. Translated on your device; machine translations may contain mistakes.`;
+    } catch {
+      status.textContent = 'Translation could not finish. Your current text has been kept. Check your connection if a language pack is needed, then click Translate to retry.';
+      button.disabled = false;
+    } finally {
+      translator?.destroy();
+      language.disabled = false;
+    }
+  });
+})();
