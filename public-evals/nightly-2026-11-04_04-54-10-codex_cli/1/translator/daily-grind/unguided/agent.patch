+const languageSelect = document.getElementById('language');
+const status = document.getElementById('translation-status');
+const textElements = Array.from(document.querySelectorAll('[data-i18n]'));
+// Keep the source copy as the English dictionary so it remains readable without JS.
+const formattedKeys = new Set(['heroTitle', 'photoLabel', 'storyHeading']);
+translations.en = Object.fromEntries(textElements.map(element => [
+  element.dataset.i18n, formattedKeys.has(element.dataset.i18n) ? element.innerHTML : element.textContent
+]));
+translations.en.status = 'The menu and story are now displayed in English.';
+const preferenceKey = 'daily-grind-language';
+
+function setLanguage(language, announce = false) {
+  if (!Object.hasOwn(translations, language)) language = 'en';
+  const dictionary = translations[language];
+  for (const element of textElements) {
+    const key = element.dataset.i18n;
+    // Only these headings contain trusted, bundled formatting; all other copy is plain text.
+    if (formattedKeys.has(key)) {
+      element.innerHTML = dictionary[key] ?? translations.en[key];
+    } else {
+      element.textContent = dictionary[key] ?? translations.en[key];
+    }
+  }
+  document.documentElement.lang = language;
+  languageSelect.value = language;
+  if (announce) status.textContent = dictionary.status;
+}
