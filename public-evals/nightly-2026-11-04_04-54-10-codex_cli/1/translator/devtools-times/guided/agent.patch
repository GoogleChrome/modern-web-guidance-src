@@ -0,0 +1,37 @@
+---
+const languages = [
+  ['en', 'English (original)'], ['ar', 'العربية'], ['zh', '中文'],
+  ['nl', 'Nederlands'], ['fr', 'Français'], ['de', 'Deutsch'],
+  ['hi', 'हिन्दी'], ['it', 'Italiano'], ['ja', '日本語'],
+  ['ko', '한국어'], ['pl', 'Polski'], ['pt', 'Português'],
+  ['ru', 'Русский'], ['es', 'Español'], ['tr', 'Türkçe'], ['uk', 'Українська'],
+];
+---
+
+<article-translation class="block border-b border-gray-200 bg-stone-50 px-4 py-3 sm:px-6" aria-label="Article translation">
+  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
+    <div class="flex items-center gap-3">
+      <svg class="h-5 w-5 text-amber-800 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
+        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m4 0c-1 6-5 10-10 12m2-9c2 4 5 7 9 9m0 4 4-11 4 11m-6.5-4h5" />
+      </svg>
+      <div>
+        <p class="text-sm font-semibold text-gray-900">Read in your language</p>
+        <p class="text-xs text-gray-500">Articles &amp; headlines. Translated on your device.</p>
+      </div>
+    </div>
+    <div class="flex flex-wrap items-center gap-2">
+      <label for="translation-language" class="sr-only">Translate articles into</label>
+      <select id="translation-language" class="rounded border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus-visible:outline-2 focus-visible:outline-amber-800" disabled>
+        {languages.map(([code, label]) => <option value={code} selected={code === 'es'}>{label}</option>)}
+      </select>
+      <button data-translate type="button" disabled class="rounded bg-gray-800 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-700 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-800">Translate</button>
+      <button data-restore type="button" hidden class="text-sm text-gray-600 underline underline-offset-4 hover:text-gray-900 focus-visible:outline-2 focus-visible:outline-amber-800">Show original</button>
+    </div>
+  </div>
+  <p data-status role="status" aria-live="polite" aria-atomic="true" class="mt-2 text-xs text-gray-600">Checking on-device translation support…</p>
+  <noscript><p class="mt-2 text-xs text-gray-600">Enable JavaScript to use on-device translation.</p></noscript>
+</article-translation>
+
+<script>
+  import '../scripts/article-translation';
+</script>
