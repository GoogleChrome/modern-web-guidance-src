diff --git a/src/scripts/article-translation.ts b/src/scripts/article-translation.ts
new file mode 100644
index 0000000..8c9baf5
--- /dev/null
+++ b/src/scripts/article-translation.ts
@@ -0,0 +1,214 @@
+type Availability = 'available' | 'downloadable' | 'downloading' | 'unavailable';
+type LanguagePair = { sourceLanguage: string; targetLanguage: string };
+type TranslationSession = {
+  translate(text: string, options: { signal: AbortSignal }): Promise<string>;
+  destroy(): void;
+};
+type TranslatorAPI = {
+  availability(options: LanguagePair): Promise<Availability>;
+  create(options: LanguagePair & {
+    signal: AbortSignal;
+    monitor(monitor: { addEventListener(type: 'downloadprogress', callback: (event: { loaded: number }) => void): void }): void;
+  }): Promise<TranslationSession>;
+};
+
+class ArticleTranslation extends HTMLElement {
+  private lifecycle = new AbortController();
+  private job?: AbortController;
+  private session?: TranslationSession;
+  private originals = new Map<Text, string>();
+  private roots: HTMLElement[] = [];
+  private selectedPair?: LanguagePair;
+  private checkVersion = 0;
+  private currentLanguage = 'en';
+  private api?: TranslatorAPI;
+  private select!: HTMLSelectElement;
+  private translateButton!: HTMLButtonElement;
+  private restoreButton!: HTMLButtonElement;
+  private status!: HTMLElement;
+
+  connectedCallback() {
+    this.lifecycle = new AbortController();
+    this.select = this.querySelector('select')!;
+    this.translateButton = this.querySelector('[data-translate]')!;
+    this.restoreButton = this.querySelector('[data-restore]')!;
+    this.status = this.querySelector('[data-status]')!;
+    this.api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+    const options = { signal: this.lifecycle.signal };
+    this.select.addEventListener('change', () => void this.checkAvailability(), options);
+    this.translateButton.addEventListener('click', () => void this.translateArticles(), options);
+    this.restoreButton.addEventListener('click', () => this.restore(), options);
+    document.addEventListener('astro:before-swap', () => this.cancel(), options);
+
+    // The control is in the header; wait until the page's article DOM exists.
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', () => this.initialize(), { ...options, once: true });
+    } else {
+      this.initialize();
+    }
+  }
+
+  private initialize() {
+    this.roots = [...document.querySelectorAll<HTMLElement>('[data-article-translate]')];
+    if (!this.roots.length) {
+      this.hidden = true;
+      return;
+    }
+    if (!this.api) {
+      this.message('On-device translation is unavailable in this browser. Try a supported desktop Chrome or Edge browser.');
+      return;
+    }
+    this.select.disabled = false;
+    void this.checkAvailability();
+  }
+
+  private message(text: string) {
+    this.status.textContent = text;
+  }
+
+  private async checkAvailability() {
+    const version = ++this.checkVersion;
+    this.selectedPair = undefined;
+    this.translateButton.disabled = true;
+    if (this.select.value === 'en') {
+      this.translateButton.disabled = false;
+      this.message('Show the original English articles.');
+      return;
+    }
+    const pair = { sourceLanguage: 'en', targetLanguage: this.select.value };
+    this.message('Checking language availability…');
+    try {
+      const availability = await this.api!.availability(pair);
+      if (version !== this.checkVersion || !this.isConnected) return;
+      if (availability === 'unavailable') {
+        this.message('This language is unavailable on your device. Choose another language.');
+        return;
+      }
+      this.selectedPair = pair;
+      this.translateButton.disabled = false;
+      this.message(availability === 'available'
+        ? 'Ready to translate on your device. Article text stays in your browser.'
+        : 'First use downloads a language pack. Select Translate to continue; article text stays on your device.');
+    } catch {
+      if (version === this.checkVersion && this.isConnected) {
+        this.message('Could not check translation support. Select a language to try again.');
+      }
+    }
+  }
+
+  private captureOriginals() {
+    if (this.originals.size) return;
+    for (const root of this.roots) {
+      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+        acceptNode(node) {
+          const parent = node.parentElement;
+          return node.textContent?.trim() && !parent?.closest('script, style, pre, code, [translate="no"]')
+            ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+        },
+      });
+      while (walker.nextNode()) {
+        const node = walker.currentNode as Text;
+        this.originals.set(node, node.data);
+      }
+    }
+  }
+
+  private async translateArticles() {
+    if (this.select.value === 'en') {
+      this.restore();
+      return;
+    }
+    const pair = this.selectedPair;
+    if (!pair || !this.api || this.job) return;
+    this.captureOriginals();
+    const job = new AbortController();
+    this.job = job;
+    this.select.disabled = true;
+    this.translateButton.disabled = true;
+    this.translateButton.textContent = 'Translating…';
+    this.setAttribute('aria-busy', 'true');
+    this.message('Preparing on-device translation…');
+    try {
+      // Availability is checked before this click so create retains user activation.
+      const session = await this.api.create({
+        ...pair,
+        signal: job.signal,
+        monitor: (monitor) => monitor.addEventListener('downloadprogress', (event) => {
+          if (!job.signal.aborted) this.message(`Downloading language pack… ${Math.round(event.loaded * 100)}%`);
+        }),
+      });
+      if (job.signal.aborted) {
+        session.destroy();
+        return;
+      }
+      this.session = session;
+      const results = new Map<Text, string>();
+      const cache = new Map<string, string>();
+      for (const [node, original] of this.originals) {
+        job.signal.throwIfAborted();
+        const text = original.trim();
+        let translated = cache.get(text);
+        if (translated === undefined) {
+          translated = await session.translate(text, { signal: job.signal });
+          cache.set(text, translated);
+        }
+        // Keep the original whitespace and DOM, including links and inline markup.
+        results.set(node, original.replace(/\S[\s\S]*\S|\S/, () => translated!));
+        this.message(`Translating articles… ${Math.round(results.size / this.originals.size * 100)}%`);
+      }
+      job.signal.throwIfAborted();
+      for (const [node, text] of results) node.data = text;
+      this.currentLanguage = pair.targetLanguage;
+      this.setContentLanguage(this.currentLanguage);
+      this.restoreButton.hidden = false;
+      const language = this.select.selectedOptions[0].textContent;
+      this.message(`Articles translated into ${language} on your device. Machine translations may contain errors.`);
+    } catch (error) {
+      if (!job.signal.aborted) {
+        this.message(error instanceof DOMException && error.name === 'NotAllowedError'
+          ? 'Translation could not start. Select Translate again to allow the language-pack download.'
+          : 'Translation could not finish. The displayed articles are unchanged. Select Translate to retry.');
+      }
+    } finally {
+      this.session?.destroy();
+      this.session = undefined;
+      if (this.job === job) this.job = undefined;
+      this.select.disabled = false;
+      this.translateButton.disabled = false;
+      this.translateButton.textContent = 'Translate';
+      this.removeAttribute('aria-busy');
+    }
+  }
+
+  private setContentLanguage(language: string) {
+    for (const root of this.roots) {
+      root.lang = language;
+      root.dir = language === 'ar' ? 'rtl' : 'ltr';
+    }
+  }
+
+  private restore() {
+    this.cancel();
+    for (const [node, original] of this.originals) node.data = original;
+    this.currentLanguage = 'en';
+    this.setContentLanguage('en');
+    this.restoreButton.hidden = true;
+    this.message('Showing the original English articles.');
+  }
+
+  private cancel() {
+    this.job?.abort();
+    this.session?.destroy();
+    this.session = undefined;
+  }
+
+  disconnectedCallback() {
+    this.checkVersion++;
+    this.cancel();
+    this.lifecycle.abort();
+  }
+}
+
+if (!customElements.get('article-translation')) {
+  customElements.define('article-translation', ArticleTranslation);
+}
