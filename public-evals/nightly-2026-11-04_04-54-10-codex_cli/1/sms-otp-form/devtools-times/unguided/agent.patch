diff --git a/tests/signup-verification.test.mjs b/tests/signup-verification.test.mjs
new file mode 100644
index 0000000..450c6b1
--- /dev/null
+++ b/tests/signup-verification.test.mjs
@@ -0,0 +1,104 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  callVerify,
+  createProof,
+  rateLimit,
+  validPhone,
+  validateProof,
+} from "../src/lib/signup-verification.ts";
+
+test("phone validation requires international E.164 format", () => {
+  assert.equal(validPhone("+14155552671"), true);
+  assert.equal(validPhone("+447700900123"), true);
+  for (const phone of [
+    "4155552671",
+    "+0123456789",
+    "+1 4155552671",
+    "+123",
+    "+1234567890123456",
+    null,
+    123,
+  ]) {
+    assert.equal(validPhone(phone), false);
+  }
+});
+
+test("verification proof is signed, phone-bound, and expires after ten minutes", () => {
+  const now = 1_000_000;
+  const phone = "+14155552671";
+  const proof = createProof(phone, "test-secret", now);
+  assert.equal(validateProof(proof, phone, "test-secret", now), true);
+  assert.equal(validateProof(proof, "+14155552672", "test-secret", now), false);
+  assert.equal(validateProof(proof, phone, "wrong-secret", now), false);
+  assert.equal(
+    validateProof(proof, phone, "test-secret", now + 600_000),
+    false,
+  );
+  const [payload, signature] = proof.split(".");
+  const tampered = Buffer.from(
+    JSON.stringify({ phone: "+14155552672", expires: now + 600_000 }),
+  ).toString("base64url");
+  assert.equal(
+    validateProof(
+      `${tampered}.${signature}`,
+      "+14155552672",
+      "test-secret",
+      now,
+    ),
+    false,
+  );
+  assert.equal(
+    validateProof(`${payload}.bad`, phone, "test-secret", now),
+    false,
+  );
+  assert.equal(
+    validateProof(`${proof}.extra`, phone, "test-secret", now),
+    false,
+  );
+  assert.equal(validateProof(undefined, phone, "test-secret", now), false);
+});
+
+test("resend limits block consecutive requests and reset after the window", () => {
+  const now = Date.now();
+  assert.equal(rateLimit("test:resend", 1, 30_000, now), 0);
+  assert.equal(rateLimit("test:resend", 1, 30_000, now + 1000), 29);
+  assert.equal(rateLimit("test:another-phone", 1, 30_000, now + 1000), 0);
+  assert.equal(rateLimit("test:resend", 1, 30_000, now + 30_000), 0);
+});
+
+test("SMS requests use the Verify service and preserve provider failure status", async (t) => {
+  const calls = [];
+  t.mock.method(globalThis, "fetch", async (url, options) => {
+    calls.push({ url, options });
+    return new Response(JSON.stringify({ status: "pending" }), { status: 200 });
+  });
+  const config = {
+    account: "test-account",
+    token: "test-token",
+    service: "test-service",
+  };
+  const result = await callVerify(
+    "Verifications",
+    { To: "+14155552671", Channel: "sms" },
+    config,
+  );
+  assert.equal(result.ok, true);
+  assert.equal(
+    calls[0].url,
+    "https://verify.twilio.com/v2/Services/test-service/Verifications",
+  );
+  assert.equal(calls[0].options.method, "POST");
+  assert.equal(calls[0].options.body.get("To"), "+14155552671");
+  assert.equal(calls[0].options.body.get("Channel"), "sms");
+  globalThis.fetch.mock.mockImplementation(
+    async () => new Response(JSON.stringify({ code: 20404 }), { status: 404 }),
+  );
+  const expired = await callVerify(
+    "VerificationCheck",
+    { To: "+14155552671", Code: "123456" },
+    config,
+  );
+  assert.equal(expired.ok, false);
+  assert.equal(expired.status, 404);
+});
