diff --git a/src/lib/signup-verification.ts b/src/lib/signup-verification.ts
new file mode 100644
index 0000000..45a28cb
--- /dev/null
+++ b/src/lib/signup-verification.ts
@@ -0,0 +1,90 @@
+import { createHmac, timingSafeEqual } from "node:crypto";
+
+export const validPhone = (phone: unknown): phone is string =>
+  typeof phone === "string" && /^\+[1-9]\d{7,14}$/.test(phone);
+
+export function getSmsConfig() {
+  const account = process.env.TWILIO_ACCOUNT_SID;
+  const token = process.env.TWILIO_AUTH_TOKEN;
+  const service = process.env.TWILIO_VERIFY_SERVICE_SID;
+  if (!account || !token || !service) return null;
+  return { account, token, service };
+}
+
+export function createProof(phone: string, secret: string, now = Date.now()) {
+  const payload = Buffer.from(
+    JSON.stringify({ phone, expires: now + 600_000 }),
+  ).toString("base64url");
+  return `${payload}.${createHmac("sha256", secret).update(payload).digest("base64url")}`;
+}
+
+export function validateProof(
+  value: string | undefined,
+  phone: string,
+  secret: string,
+  now = Date.now(),
+) {
+  if (!value) return false;
+  const [payload, signature, extra] = value.split(".");
+  if (!payload || !signature || extra) return false;
+  const expected = createHmac("sha256", secret).update(payload).digest();
+  const supplied = Buffer.from(signature, "base64url");
+  if (
+    expected.length !== supplied.length ||
+    !timingSafeEqual(expected, supplied)
+  )
+    return false;
+  try {
+    const data = JSON.parse(Buffer.from(payload, "base64url").toString());
+    return (
+      data.phone === phone &&
+      typeof data.expires === "number" &&
+      data.expires > now
+    );
+  } catch {
+    return false;
+  }
+}
+
+export async function callVerify(
+  resource: "Verifications" | "VerificationCheck",
+  fields: Record<string, string>,
+  config: NonNullable<ReturnType<typeof getSmsConfig>>,
+) {
+  const response = await fetch(
+    `https://verify.twilio.com/v2/Services/${encodeURIComponent(config.service)}/${resource}`,
+    {
+      method: "POST",
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${config.account}:${config.token}`).toString("base64")}`,
+        "Content-Type": "application/x-www-form-urlencoded",
+      },
+      body: new URLSearchParams(fields),
+      signal: AbortSignal.timeout(15_000),
+    },
+  );
+  const data = await response.json();
+  return { ok: response.ok, status: response.status, data };
+}
+
+// Best-effort per-instance limits complement Twilio Verify's service rate limits.
+// Configure provider rate limits for deployments with multiple server instances.
+const attempts = new Map<string, { count: number; until: number }>();
+export function rateLimit(
+  key: string,
+  limit: number,
+  windowMs: number,
+  now = Date.now(),
+) {
+  for (const [entry, value] of attempts)
+    if (value.until <= now) attempts.delete(entry);
+  const current = attempts.get(key);
+  if (current && current.count >= limit)
+    return Math.max(1, Math.ceil((current.until - now) / 1000));
+  if (current) current.count += 1;
+  else {
+    if (attempts.size >= 10_000) return 60;
+    attempts.set(key, { count: 1, until: now + windowMs });
+  }
+  return 0;
+}
diff --git a/src/pages/api/signup.ts b/src/pages/api/signup.ts
new file mode 100644
index 0000000..066059b
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,197 @@
+import type { APIRoute } from "astro";
+import {
+  callVerify,
+  createProof,
+  getSmsConfig,
+  rateLimit,
+  validateProof,
+  validPhone,
+} from "../../lib/signup-verification";
+
+const cookieName = "signup_phone_verification";
+const cookiePath = import.meta.env.BASE_URL;
+const json = (body: object, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: {
+      "Content-Type": "application/json",
+      "Cache-Control": "no-store",
+    },
+  });
+
+export const POST: APIRoute = async ({
+  request,
+  cookies,
+  url,
+  clientAddress,
+}) => {
+  const origin = request.headers.get("origin");
+  if (origin && origin !== url.origin)
+    return json({ error: "Please submit this form from our website." }, 403);
+  if (!request.headers.get("content-type")?.startsWith("application/json"))
+    return json({ error: "Expected a JSON request." }, 415);
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: "Invalid request." }, 400);
+  }
+  if (
+    !body ||
+    !["send", "verify", "register"].includes(body.action) ||
+    !validPhone(body.phone)
+  )
+    return json(
+      { error: "Enter a valid phone number with its country code." },
+      400,
+    );
+  const config = getSmsConfig();
+  if (!config)
+    return json(
+      {
+        error:
+          "Phone verification is temporarily unavailable. Please try again later.",
+      },
+      503,
+    );
+  const { action, phone } = body;
+  const ipWait = rateLimit(`ip:${clientAddress}`, 30, 600_000);
+  if (ipWait)
+    return json(
+      {
+        error: "Too many attempts. Please wait before trying again.",
+        retryAfter: ipWait,
+      },
+      429,
+    );
+  try {
+    if (action === "send") {
+      const wait = rateLimit(`send:${phone}`, 1, 30_000);
+      if (wait)
+        return json(
+          {
+            error: "Please wait before requesting another code.",
+            retryAfter: wait,
+          },
+          429,
+        );
+      const hourlyWait = rateLimit(`hour:${phone}`, 5, 3_600_000);
+      if (hourlyWait)
+        return json(
+          {
+            error: "You’ve requested several codes. Please try again later.",
+            retryAfter: hourlyWait,
+          },
+          429,
+        );
+      const result = await callVerify(
+        "Verifications",
+        { To: phone, Channel: "sms" },
+        config,
+      );
+      if (!result.ok)
+        return json(
+          {
+            error:
+              result.status === 429
+                ? "Too many code requests. Please wait and try again."
+                : "We couldn’t send a text to that number. Check your number and try again.",
+            retryAfter: 30,
+          },
+          result.status === 429 ? 429 : 400,
+        );
+      cookies.delete(cookieName, { path: cookiePath });
+      return json({ sent: true });
+    }
+    if (action === "verify") {
+      if (typeof body.code !== "string" || !/^\d{6}$/.test(body.code))
+        return json(
+          { error: "Enter the 6-digit code from your text message." },
+          400,
+        );
+      const wait = rateLimit(`check:${phone}`, 10, 600_000);
+      if (wait)
+        return json(
+          {
+            error: "Too many attempts. Please request a new code later.",
+            retryAfter: wait,
+          },
+          429,
+        );
+      const result = await callVerify(
+        "VerificationCheck",
+        { To: phone, Code: body.code },
+        config,
+      );
+      if (!result.ok || result.data.status !== "approved")
+        return json(
+          {
+            error:
+              result.status === 404
+                ? "This code has expired. Request a new code to continue."
+                : "That code couldn’t be verified. Check it or request a new one.",
+          },
+          400,
+        );
+      cookies.set(cookieName, createProof(phone, config.token), {
+        path: cookiePath,
+        httpOnly: true,
+        sameSite: "strict",
+        secure: url.protocol === "https:",
+        maxAge: 600,
+      });
+      return json({ verified: true });
+    }
+    if (!validateProof(cookies.get(cookieName)?.value, phone, config.token))
+      return json(
+        {
+          error:
+            "Your verification has expired. Request a new code to continue.",
+        },
+        401,
+      );
+    if (
+      typeof body.username !== "string" ||
+      !body.username.trim() ||
+      body.username.length > 80 ||
+      typeof body.password !== "string" ||
+      body.password.length < 8 ||
+      !/\d/.test(body.password)
+    )
+      return json(
+        {
+          error:
+            "Use a username and a password with at least 8 characters and a number.",
+        },
+        400,
+      );
+    const response = await fetch(
+      "https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register",
+      {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          username: body.username.trim(),
+          password: body.password,
+          phone,
+        }),
+        signal: AbortSignal.timeout(15_000),
+      },
+    );
+    if (!response.ok)
+      return json(
+        {
+          error:
+            "Your account couldn’t be created. Try again, or go back and choose another username.",
+        },
+        400,
+      );
+    cookies.delete(cookieName, { path: cookiePath });
+    return json({ registered: true });
+  } catch {
+    return json(
+      { error: "We couldn’t connect right now. Please try again in a moment." },
+      502,
+    );
+  }
+};
