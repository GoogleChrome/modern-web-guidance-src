--- /dev/null
+++ b/src/pages/api/signup/complete.ts
@@ -0,0 +1,40 @@
+import type { APIRoute } from 'astro';
+import { json, sameOrigin, validPassword, verifyRequest } from '../../../server/signup';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Invalid request origin or content type.' }, 403);
+  if (!session) return json({ error: 'Verification is unavailable. Please try again later.' }, 503);
+  try {
+    const body = await request.json();
+    if (typeof body.username !== 'string' || typeof body.password !== 'string' || !validPassword(body.password) || typeof body.code !== 'string' || !/^[0-9]{6}$/.test(body.code)) {
+      return json({ error: 'Enter a valid password and the six-digit verification code.' }, 400);
+    }
+    const challenge = await session.get('phoneChallenge');
+    if (!challenge || challenge.username !== body.username.trim() || challenge.expiresAt <= Date.now() || (!challenge.approved && challenge.attempts >= 5)) {
+      return json({ error: 'Your verification has expired or has too many attempts. Request another code.' }, 400);
+    }
+    if (!challenge.approved) {
+      challenge.attempts += 1;
+      await session.set('phoneChallenge', challenge);
+      const response = await verifyRequest('VerificationCheck', { VerificationSid: challenge.sid, Code: body.code });
+      const data = await response.json();
+      if (!response.ok || data.status !== 'approved') {
+        return json({ error: 'The code is incorrect or expired. Try again or request another code.' }, 400);
+      }
+      // Keep proof server-side so a failed registration can be retried without reusing a consumed OTP.
+      challenge.approved = true;
+      await session.set('phoneChallenge', challenge);
+    }
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: challenge.username, password: body.password, phone: challenge.phone }),
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok) return json({ error: 'Registration failed. Your username may be unavailable. Try again or edit your account details.' }, 400);
+    await session.delete('phoneChallenge');
+    return json({ success: true });
+  } catch {
+    return json({ error: 'Unable to finish sign-up. Please try again.' }, 503);
+  }
+};
