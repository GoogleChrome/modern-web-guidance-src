@@ -0,0 +1,29 @@
+import type { APIRoute } from 'astro';
+import { json, normalizePhone, sameOrigin, validPhone, verifyRequest } from '../../../server/signup';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Invalid request origin or content type.' }, 403);
+  if (!session) return json({ error: 'Verification is unavailable. Please try again later.' }, 503);
+  try {
+    const body = await request.json();
+    if (typeof body.phone !== 'string' || typeof body.username !== 'string') return json({ error: 'Enter your username and phone number.' }, 400);
+    const phone = normalizePhone(body.phone);
+    const username = body.username.trim();
+    if (!validPhone(phone) || !username || username.length > 100) return json({ error: 'Enter a username and an international phone number beginning with + and your country code.' }, 400);
+    const lastSent = await session.get('signupLastSent') || 0;
+    const retryAfter = Math.ceil((lastSent + 30000 - Date.now()) / 1000);
+    if (retryAfter > 0) return json({ error: `Wait ${retryAfter} seconds before requesting another code.`, retryAfter }, 429);
+    await session.set('signupLastSent', Date.now());
+    // Invalidate earlier challenges even when sending the replacement fails.
+    await session.delete('phoneChallenge');
+    const response = await verifyRequest('Verifications', { To: phone, Channel: 'sms' });
+    const data = await response.json();
+    if (!response.ok || data.status !== 'pending' || typeof data.sid !== 'string') {
+      return json({ error: response.status === 429 ? 'Too many codes requested. Please wait before trying again.' : 'We could not send a code. Check your number and try again.' }, response.status === 429 ? 429 : 502);
+    }
+    await session.set('phoneChallenge', { username, phone, sid: data.sid, expiresAt: Date.now() + 600000, attempts: 0 });
+    return json({ phone, retryAfter: 30 });
+  } catch {
+    return json({ error: 'SMS verification is unavailable. Please try again later.' }, 503);
+  }
+};
diff --git a/src/server/signup.ts b/src/server/signup.ts
new file mode 100644
index 0000000..2916638
--- /dev/null
+++ b/src/server/signup.ts
@@ -0,0 +1,40 @@
+import { Buffer } from 'node:buffer';
+
+export interface PhoneChallenge {
+  username: string;
+  phone: string;
+  sid: string;
+  expiresAt: number;
+  attempts: number;
+  approved?: boolean;
+}
+
+export const normalizePhone = (phone: string) => phone.replace(/[\s().-]/g, '');
+export const validPhone = (phone: string) => /^\+[1-9][0-9]{7,14}$/.test(phone);
+export const validPassword = (password: string) => password.length >= 8 && password.length <= 128 && /[0-9]/.test(password);
+export const json = (body: object, status = 200) => new Response(JSON.stringify(body), {
+  status,
+  headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+
+export function sameOrigin(request: Request) {
+  return request.headers.get('origin') === new URL(request.url).origin &&
+    request.headers.get('content-type')?.split(';')[0] === 'application/json';
+}
+
+export async function verifyRequest(path: string, values: Record<string, string>) {
+  const { TWILIO_API_KEY, TWILIO_API_SECRET, TWILIO_VERIFY_SERVICE_SID, TWILIO_VERIFY_TEMPLATE_SID } = process.env;
+  if (!TWILIO_API_KEY || !TWILIO_API_SECRET || !TWILIO_VERIFY_SERVICE_SID || !TWILIO_VERIFY_TEMPLATE_SID) {
+    throw new Error('SMS verification is not configured. Please try again later.');
+  }
+  if (path === 'Verifications') values.TemplateSid = TWILIO_VERIFY_TEMPLATE_SID;
+  return fetch(`https://verify.twilio.com/v2/Services/${encodeURIComponent(TWILIO_VERIFY_SERVICE_SID)}/${path}`, {
+    method: 'POST',
+    headers: {
+      Authorization: `Basic ${Buffer.from(`${TWILIO_API_KEY}:${TWILIO_API_SECRET}`).toString('base64')}`,
+      'Content-Type': 'application/x-www-form-urlencoded',
+    },
+    body: new URLSearchParams(values),
+    signal: AbortSignal.timeout(15000),
+  });
+}
