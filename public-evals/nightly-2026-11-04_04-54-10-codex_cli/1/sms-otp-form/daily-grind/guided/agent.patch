+(() => {
+  'use strict';
+  const $ = (id) => document.getElementById(id);
+  // No backend is included in this static site. Configure this meta tag to use a real service.
+  const apiBase = document.querySelector('meta[name="sms-auth-api"]')?.content.replace(/\/$/, '');
+  const isPreview = !apiBase;
+  const phoneForm = $('phone-form');
+  const otpForm = $('otp-form');
+  const phone = $('phone');
+  const otp = $('otp');
+  const status = $('form-status');
+  let intent = 'rewards';
+  let phoneNumber = '';
+  let challengeId = null;
+  let smsController = null;
+  let requestController = null;
+  let cooldownTimer = null;
+  let cooldownUntil = 0;
+  let busy = false;
+  let step = 'phone';
+  let previewExpiresAt = 0;
+
+  $('preview-note').hidden = !isPreview;
+
+  function stopSmsListener() {
+    smsController?.abort();
+    smsController = null;
+  }
+
+  async function listenForSms() {
+    stopSmsListener();
+    if (isPreview || !window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+    const controller = new AbortController();
+    smsController = controller;
+    const timeout = setTimeout(() => controller.abort(), 120000);
+    try {
+      const credential = await navigator.credentials.get({
+        otp: { transport: ['sms'] }, signal: controller.signal,
+      });
+      if (controller.signal.aborted || step !== 'code' || !credential?.code) return;
+      otp.value = credential.code;
+      clearError(otp);
+      if (!busy) otpForm.requestSubmit();
+    } catch {
+      // Permission denial, timeout, and unsupported environments retain manual entry and native autofill.
+    } finally {
+      clearTimeout(timeout);
+      if (smsController === controller) smsController = null;
+    }
+  }
+
+  function clearError(input) {
+    input.removeAttribute('aria-invalid');
+    input.setCustomValidity('');
+    $(input.id + '-error').textContent = '';
+  }
+
+  function showError(input, message) {
+    input.setAttribute('aria-invalid', 'true');
+    $(input.id + '-error').textContent = message;
+    input.focus();
+  }
+
+  for (const input of [phone, otp]) {
+    input.addEventListener('input', () => clearError(input));
+    input.addEventListener('invalid', () => {
+      const message = input === phone ? 'Enter your mobile number, including the country code.' : 'Enter the complete 6-digit code from your text message.';
+      input.setCustomValidity(message);
+      input.setAttribute('aria-invalid', 'true');
+      $(input.id + '-error').textContent = message;
+    });
+  }
+
+  function setStep(next) {
+    step = next;
+    phoneForm.hidden = next !== 'phone';
+    otpForm.hidden = next !== 'code';
+    $('complete').hidden = next !== 'complete';
+    $('phone-step').toggleAttribute('aria-current', next === 'phone');
+    $('code-step').toggleAttribute('aria-current', next === 'code');
+    if (next === 'phone') $('phone-step').setAttribute('aria-current', 'step');
+    if (next === 'code') $('code-step').setAttribute('aria-current', 'step');
+  }
+
+  function updateCooldown() {
+    const seconds = Math.max(0, Math.ceil((cooldownUntil - Date.now()) / 1000));
+    $('resend-button').disabled = seconds > 0 || busy;
+    $('resend-button').textContent = seconds ? `Resend in ${seconds}s` : 'Resend code';
+    if (!seconds) { clearInterval(cooldownTimer); cooldownTimer = null; }
+  }
+
+  function beginCooldown() {
+    clearInterval(cooldownTimer);
+    cooldownUntil = Date.now() + 30000;
+    updateCooldown();
+    cooldownTimer = setInterval(updateCooldown, 1000);
+  }
+
+  function setBusy(value) {
+    busy = value;
+    $('send-button').disabled = value;
+    $('verify-button').disabled = value;
+    $('change-number').disabled = value;
+    document.querySelectorAll('input[name="intent"]').forEach((input) => { input.disabled = value; });
+    phoneForm.setAttribute('aria-busy', String(value));
+    otpForm.setAttribute('aria-busy', String(value));
+    updateCooldown();
+  }
+
+  async function post(endpoint, payload) {
+    requestController?.abort();
+    const controller = new AbortController();
+    requestController = controller;
+    const timeout = setTimeout(() => controller.abort(), 15000);
+    try {
+      const response = await fetch(`${apiBase}/${endpoint}`, {
+        method: 'POST', credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+        body: JSON.stringify(payload), signal: controller.signal,
+      });
+      // A static host may return HTML for unknown paths; never treat that as authenticated.
+      const data = await response.json();
+      if (!response.ok) throw new Error(response.status === 429
+        ? 'Too many attempts. Please wait a few minutes and try again.'
+        : endpoint === 'verify' ? 'That code is incorrect or expired. Try again or request a new code.'
+        : 'We couldn’t send your code. Check your number and try again.');
+      return data;
+    } catch (error) {
+      if (error.name === 'AbortError') throw new Error('The request timed out. Please try again.');
+      if (error instanceof TypeError || error instanceof SyntaxError) throw new Error('We couldn’t connect. Please try again in a moment.');
+      throw error;
+    } finally {
+      clearTimeout(timeout);
+      if (requestController === controller) requestController = null;
+    }
+  }
+
+  async function sendCode() {
+    if (busy) return;
+    stopSmsListener();
+    setBusy(true);
+    clearError(otp);
+    otp.value = '';
+    status.textContent = 'Requesting your code…';
+    challengeId = null;
+    $('phone-display').textContent = phoneNumber;
+    setStep('code');
+    // Register before requesting delivery so a fast incoming SMS is not missed.
+    void listenForSms();
+    try {
+      if (isPreview) {
+        previewExpiresAt = Date.now() + 300000;
+        status.textContent = 'Preview only: no text was sent. Enter 123456 to try the flow. This preview code expires in 5 minutes.';
+      } else {
+        const data = await post('send', { phone: phoneNumber, intent });
+        if (typeof data.challengeId !== 'string' || !data.challengeId) throw new Error('We couldn’t start verification. Please try again.');
+        challengeId = data.challengeId;
+        status.textContent = 'Your code is on its way. Check your text messages.';
+      }
+      beginCooldown();
+      otp.focus();
+    } catch (error) {
+      stopSmsListener();
+      setStep('phone');
+      status.textContent = '';
+      showError(phone, error.message);
+    } finally {
+      setBusy(false);
+      if (step === 'code' && otp.value && otp.checkValidity()) otpForm.requestSubmit();
+    }
+  }
+
+  phoneForm.addEventListener('submit', (event) => {
+    event.preventDefault();
+    if (busy) return;
+    const normalized = phone.value.replace(/[\s().-]/g, '');
+    if (!/^\+[1-9][0-9]{7,14}$/.test(normalized)) {
+      showError(phone, 'Include your country code, for example +1 555 123 4567.');
+      return;
+    }
+    phoneNumber = normalized;
+    void sendCode();
+  });
+
+  otpForm.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    stopSmsListener();
+    if (busy) return;
+    clearError(otp);
+    if (!/^[0-9]{6}$/.test(otp.value)) { showError(otp, 'Enter all 6 digits from your text message.'); return; }
+    setBusy(true);
+    status.textContent = 'Checking your code…';
+    try {
+      if (isPreview) {
+        if (Date.now() > previewExpiresAt) throw new Error('This preview code has expired. Request a new code.');
+        if (otp.value !== '123456') throw new Error('That code doesn’t match. Use 123456 for this preview.');
+        setStep('complete');
+        $('complete-title').textContent = 'A little taste of what’s next.';
+        $('complete-message').textContent = `You’ve completed the ${intent === 'order' ? 'online order' : 'Rewards sign-in'} preview. Connect an SMS authentication service to verify real numbers and continue securely.`;
+        status.textContent = 'Preview complete. No account has been signed in.';
+        $('complete').focus();
+      } else {
+        const data = await post('verify', { phone: phoneNumber, code: otp.value, challengeId, intent });
+        if (data.verified !== true) throw new Error('We couldn’t verify this code. Please try again.');
+        window.location.assign(intent === 'order' ? '/order-online' : '/rewards');
+      }
+      otp.value = '';
+    } catch (error) {
+      status.textContent = '';
+      showError(otp, error.message);
+    } finally { setBusy(false); }
+  });
+
+  function reset() {
+    if (busy) return;
+    stopSmsListener();
+    clearInterval(cooldownTimer);
+    cooldownUntil = 0;
+    challengeId = null;
+    previewExpiresAt = 0;
+    otp.value = '';
+    clearError(phone);
+    clearError(otp);
+    status.textContent = '';
+    setStep('phone');
+    updateCooldown();
+    phone.focus();
+  }
+
+  function chooseIntent(value) {
+    if (busy || intent === value) return;
+    intent = value;
+    document.querySelectorAll('input[name="intent"]').forEach((radio) => { radio.checked = radio.value === value; });
+    if (step !== 'phone') reset();
+  }
+
+  document.querySelectorAll('input[name="intent"]').forEach((radio) => radio.addEventListener('change', () => chooseIntent(radio.value)));
+  document.querySelectorAll('[data-intent]').forEach((link) => link.addEventListener('click', () => { chooseIntent(link.dataset.intent); if (!busy) phone.focus({ preventScroll: true }); }));
+  $('resend-button').addEventListener('click', () => { if (Date.now() >= cooldownUntil) void sendCode(); });
+  $('change-number').addEventListener('click', reset);
+  $('restart').addEventListener('click', reset);
+  window.addEventListener('pagehide', () => { stopSmsListener(); requestController?.abort(); clearInterval(cooldownTimer); });
+  window.addEventListener('pageshow', (event) => { if (event.persisted && step === 'code') { updateCooldown(); if (cooldownUntil > Date.now()) cooldownTimer = setInterval(updateCooldown, 1000); void listenForSms(); } });
+})();
