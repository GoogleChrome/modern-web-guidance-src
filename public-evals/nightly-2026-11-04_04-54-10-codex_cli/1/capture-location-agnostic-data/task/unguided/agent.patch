+  <script>
+    (() => {
+      const storageKey = 'daily-grind.coffee-preferences';
+      const form = document.getElementById('coffee-preferences');
+      const reminder = document.getElementById('pickup-reminder-time');
+      const anniversary = document.getElementById('coffee-anniversary');
+      const status = document.getElementById('preferences-status');
+
+      // These are floating wall-clock/calendar values, not instants in time.
+      // Keep native input strings (HH:mm and YYYY-MM-DD) throughout storage
+      // and restoration; Date/UTC conversions would shift them during travel.
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey));
+        if (saved && typeof saved === 'object') {
+          if (typeof saved.pickupReminderTime === 'string') {
+            reminder.value = saved.pickupReminderTime;
+          }
+          if (typeof saved.coffeeAnniversary === 'string') {
+            anniversary.value = saved.coffeeAnniversary;
+          }
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can select them again below.';
+      }
+
+      form.addEventListener('input', () => {
+        status.textContent = 'You have unsaved changes.';
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        try {
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupReminderTime: reminder.value,
+            coffeeAnniversary: anniversary.value
+          }));
+          status.textContent = 'Preferences saved. Your time and date will stay the same wherever you travel.';
+        } catch {
+          status.textContent = 'Preferences could not be saved. Allow browser storage and try again.';
+        }
+      });
+    })();
+  </script>
+
