+  <script>
+    (() => {
+      const storageKey = 'daily-grind-coffee-preferences';
+      const form = document.getElementById('coffee-preferences-form');
+      const pickupTime = document.getElementById('pickup-reminder-time');
+      const anniversaryDate = document.getElementById('coffee-anniversary-date');
+      const status = document.getElementById('preferences-status');
+
+      // Native input values are plain HH:mm and YYYY-MM-DD strings, not instants.
+      // Preserve them directly: Date, valueAsDate, and UTC conversions cause drift.
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey));
+        if (saved && typeof saved === 'object') {
+          if (typeof saved.pickupReminderTime === 'string') {
+            pickupTime.value = saved.pickupReminderTime;
+          }
+          if (typeof saved.coffeeAnniversaryDate === 'string') {
+            anniversaryDate.value = saved.coffeeAnniversaryDate;
+          }
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can choose them again.';
+      }
+
+      document.getElementById('save-preferences').disabled = false;
+      form.addEventListener('input', () => {
+        status.textContent = 'You have unsaved changes.';
+      });
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        try {
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupReminderTime: pickupTime.value,
+            coffeeAnniversaryDate: anniversaryDate.value,
+          }));
+          status.textContent = 'Coffee preferences saved in this browser.';
+        } catch {
+          status.textContent = 'Preferences could not be saved. Please allow browser storage and try again.';
+        }
+      });
+    })();
+  </script>
+
