diff --git a/src/components/PasskeySettings.tsx b/src/components/PasskeySettings.tsx
new file mode 100644
index 0000000..f24f2b5
--- /dev/null
+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,173 @@
+import { useEffect, useRef, useState } from 'react';
+import { KeyIcon, ShieldCheckIcon, PencilSquareIcon, TrashIcon, PlusIcon } from '@heroicons/react/24/outline';
+import providers from '../lib/passkey-providers.json';
+
+type Passkey = { id: string; name: string; aaguid: string; registeredAt: number; lastUsedAt: number | null; backedUp: number };
+type KeyList = { passkeys: Passkey[]; userId: string; rpId: string };
+type SignalCredential = typeof PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+};
+const button = 'inline-flex items-center justify-center gap-2 rounded-md border px-3 py-2 text-sm font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed';
+const secondary = `${button} border-gray-300 bg-white hover:bg-gray-50`;
+
+async function request(path: string, method = 'GET', body?: unknown) {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/account/${path}`, {
+    method, headers: body ? { 'Content-Type': 'application/json' } : undefined,
+    body: body ? JSON.stringify(body) : undefined, cache: 'no-store',
+  });
+  if (response.status === 401) {
+    window.location.assign(`${import.meta.env.BASE_URL}signin`);
+    throw new Error('Your session expired. Please sign in again.');
+  }
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
+  return data;
+}
+
+function date(value: number | null) {
+  return value ? new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(value) : 'Not used yet';
+}
+
+export default function PasskeySettings() {
+  const [data, setData] = useState<KeyList | null>(null);
+  const [error, setError] = useState('');
+  const [status, setStatus] = useState('');
+  const [syncNotice, setSyncNotice] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [canCreate, setCanCreate] = useState(false);
+  const [editing, setEditing] = useState<string | null>(null);
+  const [name, setName] = useState('');
+  const [removing, setRemoving] = useState<Passkey | null>(null);
+  const dialog = useRef<HTMLDialogElement>(null);
+  const heading = useRef<HTMLHeadingElement>(null);
+  const actions = useRef(new Map<string, HTMLButtonElement>());
+
+  async function sync(list: KeyList) {
+    const api = window.PublicKeyCredential as SignalCredential | undefined;
+    if (!api?.signalAllAcceptedCredentials) {
+      setSyncNotice('Your browser can’t update your password manager automatically. After removing a passkey here, remove its saved copy in your password manager too.');
+      return;
+    }
+    try {
+      await api.signalAllAcceptedCredentials({ rpId: list.rpId, userId: list.userId,
+        allAcceptedCredentialIds: list.passkeys.map(key => key.id) });
+      setSyncNotice('');
+    } catch {
+      setSyncNotice('Your changes are saved. Your password manager could not be updated; remove any deleted passkeys there manually.');
+    }
+  }
+
+  async function load() {
+    setError('');
+    try {
+      const list: KeyList = await request('passkeys');
+      setData(list);
+      await sync(list);
+    } catch (err) { setError(err instanceof Error ? err.message : 'Unable to load passkeys.'); }
+  }
+
+  useEffect(() => {
+    void load();
+    void (async () => {
+      if (!window.isSecureContext || !window.PublicKeyCredential) return;
+      await import('webauthn-polyfills');
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      setCanCreate(Boolean(capabilities.passkeyPlatformAuthenticator && capabilities.conditionalGet));
+    })().catch(() => setCanCreate(false));
+  }, []);
+
+  useEffect(() => {
+    if (removing) dialog.current?.showModal();
+    else dialog.current?.close();
+  }, [removing]);
+
+  async function rename(event: React.FormEvent, key: Passkey) {
+    event.preventDefault();
+    if (!name.trim()) return;
+    setBusy(true); setError(''); setStatus('');
+    try {
+      const list: KeyList = await request('passkeys', 'PATCH', { id: key.id, name: name.trim() });
+      setData(list); setEditing(null); setStatus('Passkey name updated.');
+      // A nickname is an application label, not the WebAuthn user's display name.
+      requestAnimationFrame(() => actions.current.get(key.id)?.focus());
+    } catch (err) { setError(err instanceof Error ? err.message : 'Unable to rename passkey.'); }
+    finally { setBusy(false); }
+  }
+
+  async function remove() {
+    if (!removing) return;
+    setBusy(true); setError(''); setStatus('');
+    try {
+      const list: KeyList = await request('passkeys', 'DELETE', { id: removing.id });
+      setData(list); setRemoving(null); setStatus('Passkey removed. You can still sign in with your password.');
+      await sync(list);
+      heading.current?.focus();
+    } catch (err) {
+      setRemoving(null);
+      setError(err instanceof Error ? err.message : 'Unable to remove passkey.');
+    } finally { setBusy(false); }
+  }
+
+  async function create() {
+    setBusy(true); setError(''); setStatus('');
+    try {
+      const options = await request('register-passkey', 'POST', {});
+      const credential = await navigator.credentials.create({ publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(options) }) as PublicKeyCredential | null;
+      if (!credential) return;
+      try {
+        await request('register-passkey', 'POST', { credential: credential.toJSON() });
+      } catch (err) {
+        // A lost response may follow a committed registration. Only sync a freshly
+        // fetched authoritative list; never declare that credential unknown here.
+        await load();
+        throw err;
+      }
+      await load(); setStatus('Passkey created. Give it a name you’ll recognize.');
+    } catch (err) {
+      const message = err instanceof DOMException && ['NotAllowedError', 'AbortError'].includes(err.name)
+        ? 'Passkey creation was canceled. You can try again whenever you’re ready.'
+        : err instanceof DOMException && err.name === 'InvalidStateError'
+          ? 'This authenticator already has a passkey for your account.'
+          : err instanceof Error ? err.message : 'Unable to create a passkey.';
+      setError(message);
+    } finally { setBusy(false); }
+  }
+
+  return <section aria-labelledby="passkeys-heading">
+    <div className="flex flex-wrap items-start justify-between gap-4 mb-5">
+      <div><h2 id="passkeys-heading" ref={heading} tabIndex={-1} className="font-brand text-3xl">Passkeys</h2>
+        <p className="mt-2 text-sm text-gray-600 max-w-lg leading-6">Keep track of the passkeys connected to your account. Rename them so they’re easy to recognize, or remove one you no longer use.</p></div>
+      {canCreate && <button className={`${button} bg-gray-900 text-white border-gray-900 hover:bg-gray-700`} disabled={busy || !data} onClick={create}><PlusIcon className="h-4 w-4" aria-hidden="true" />Create passkey</button>}
+    </div>
+    {error && <div role="alert" className="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800 mb-4">{error} {!data && <button className="underline ml-2" onClick={load}>Try again</button>}</div>}
+    <p role="status" className="text-sm text-green-800 mb-3">{status}</p>
+    {!data && !error && <p role="status" className="py-10 text-center text-sm text-gray-500">Loading your passkeys…</p>}
+    {data && <div className="overflow-hidden rounded-lg border border-gray-200">
+      <div className="flex items-center justify-between border-b border-gray-200 bg-gray-50 px-5 py-3 text-xs font-semibold uppercase tracking-wider text-gray-500"><span>Registered passkeys</span><span>{data.passkeys.length} {data.passkeys.length === 1 ? 'passkey' : 'passkeys'}</span></div>
+      {data.passkeys.length === 0 ? <div className="py-12 px-6 text-center"><KeyIcon className="h-9 w-9 text-gray-400 mx-auto mb-4" aria-hidden="true" /><h3 className="font-semibold">No passkeys yet</h3><p className="text-sm text-gray-500 mt-2">Your registered passkeys will appear here.</p><p className="text-sm text-gray-500 mt-1">{canCreate ? 'Create your first passkey to get started.' : 'You can continue signing in with your password.'}</p></div>
+        : <ul className="divide-y divide-gray-200">{data.passkeys.map(key => {
+          const provider = key.aaguid !== '00000000-0000-0000-0000-000000000000'
+            ? (providers as Record<string, { name: string; icon_light?: string }>)[key.aaguid] : undefined;
+          return <li key={key.id} className="p-5 sm:p-6 flex items-start gap-4">
+            <div className="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-gray-50">{provider?.icon_light ? <img src={provider.icon_light} className="h-6 w-6" alt="" /> : <KeyIcon className="h-5 w-5 text-gray-600" aria-hidden="true" />}</div>
+            <div className="min-w-0 flex-1">
+              {editing === key.id ? <form onSubmit={event => rename(event, key)} className="flex flex-wrap gap-2">
+                <label className="sr-only" htmlFor={`name-${key.id}`}>Passkey display name</label><input id={`name-${key.id}`} autoFocus required maxLength={64} value={name} onChange={event => setName(event.target.value)} className="min-w-0 w-full sm:w-auto flex-1 border border-gray-400 rounded-md px-3 py-2 text-sm" />
+                <button className={`${button} bg-gray-900 text-white`} disabled={busy || !name.trim()}>Save</button><button type="button" className={secondary} disabled={busy} onClick={() => { setEditing(null); requestAnimationFrame(() => actions.current.get(key.id)?.focus()); }}>Cancel</button>
+              </form> : <div className="flex flex-wrap items-center justify-between gap-3"><h3 className="font-semibold break-all">{key.name}</h3><div className="flex gap-2">
+                <button ref={element => { if (element) actions.current.set(key.id, element); else actions.current.delete(key.id); }} className={secondary} disabled={busy} aria-label={`Rename ${key.name}`} onClick={() => { setEditing(key.id); setName(key.name); }}><PencilSquareIcon className="h-4 w-4" aria-hidden="true" />Rename</button>
+                <button className={`${button} border-transparent text-gray-500 hover:text-red-700 hover:bg-red-50`} disabled={busy} aria-label={`Remove ${key.name}`} onClick={() => setRemoving(key)}><TrashIcon className="h-4 w-4" aria-hidden="true" /><span className="sr-only sm:not-sr-only">Remove</span></button></div></div>}
+              <p className="mt-1 text-xs text-gray-500">{provider?.name || 'Unknown passkey provider'}{key.backedUp ? ' · Synced passkey' : ''}</p>
+              <div className="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-gray-500"><span>Created {date(key.registeredAt)}</span><span>Last used: {date(key.lastUsedAt)}</span></div>
+            </div>
+          </li>;
+        })}</ul>}
+    </div>}
+    <div className="mt-6 flex items-start gap-3 text-sm text-gray-600 leading-6"><ShieldCheckIcon className="h-5 w-5 shrink-0 mt-0.5" aria-hidden="true" /><p>Passkeys are stored securely in your password manager or security key. Your fingerprint, face, and device PIN are never shared with us.</p></div>
+    {syncNotice && <p className="mt-4 rounded-md bg-amber-50 border border-amber-200 p-4 text-xs text-amber-900 leading-5">{syncNotice}</p>}
+    <dialog ref={dialog} aria-labelledby="remove-title" onCancel={event => { if (busy) event.preventDefault(); else setRemoving(null); }} onClose={() => setRemoving(null)} className="m-auto w-[calc(100%_-_2rem)] max-w-md rounded-xl p-6 shadow-xl backdrop:bg-gray-900/40">
+      <h2 id="remove-title" className="font-brand text-2xl">Remove this passkey?</h2><p className="mt-3 text-sm text-gray-600 leading-6">You’ll no longer be able to use <strong>{removing?.name}</strong> for this account. Your password and any other passkeys will still work.</p>
+      <div className="mt-6 flex justify-end gap-3"><button autoFocus className={secondary} disabled={busy} onClick={() => setRemoving(null)}>Keep passkey</button><button className={`${button} border-red-700 bg-red-700 text-white hover:bg-red-800`} disabled={busy} onClick={remove}>{busy ? 'Removing…' : 'Remove passkey'}</button></div>
+    </dialog>
+  </section>;
+}
