diff --git a/src/pages/api/account/login.ts b/src/pages/api/account/login.ts
new file mode 100644
index 0000000..ab8c926
--- /dev/null
+++ b/src/pages/api/account/login.ts
@@ -0,0 +1,26 @@
+import type { APIRoute } from 'astro';
+import { accountForVerifiedUsername } from '../../../lib/server/accounts';
+import { json, sameOrigin } from '../../../lib/server/account-http';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Invalid request origin.' }, 403);
+  if (!session) return json({ error: 'Sign-in is currently unavailable.' }, 503);
+  try {
+    const { username, password } = await request.json();
+    if (typeof username !== 'string' || typeof password !== 'string' || !username.trim() || username.length > 200) {
+      return json({ error: 'Enter your username and password.' }, 400);
+    }
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }), signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok) return json({ error: 'Sign-in failed. Check your username and password.' }, 401);
+    // Only establish a local identity after the existing identity service verifies it.
+    const account = accountForVerifiedUsername(username);
+    await session.regenerate();
+    await session.set('account', account);
+    return json({ success: true });
+  } catch {
+    return json({ error: 'Unable to sign in right now. Please try again.' }, 503);
+  }
+};
diff --git a/src/pages/api/account/passkeys.ts b/src/pages/api/account/passkeys.ts
new file mode 100644
index 0000000..fe5091e
--- /dev/null
+++ b/src/pages/api/account/passkeys.ts
@@ -0,0 +1,26 @@
+import type { APIRoute } from 'astro';
+import { listPasskeys, renamePasskey, removePasskey } from '../../../lib/server/accounts';
+import { json, sameOrigin, signedIn, relyingParty } from '../../../lib/server/account-http';
+
+export const ALL: APIRoute = async (context) => {
+  const account = await signedIn(context);
+  if (!account) return json({ error: 'Please sign in to manage your passkeys.' }, 401);
+  const { request } = context;
+  try {
+    if (request.method !== 'GET') {
+      if (!['PATCH', 'DELETE'].includes(request.method)) return json({ error: 'Method not allowed.' }, 405);
+      if (!sameOrigin(request)) return json({ error: 'Invalid request origin.' }, 403);
+      const { id, name } = await request.json();
+      if (typeof id !== 'string' || !/^[A-Za-z0-9_-]+$/.test(id)) return json({ error: 'Invalid passkey.' }, 400);
+      if (request.method === 'PATCH' && (typeof name !== 'string' || !name.trim() || name.trim().length > 64)) {
+        return json({ error: 'Use a name between 1 and 64 characters.' }, 400);
+      }
+      const changed = request.method === 'PATCH'
+        ? renamePasskey(account.id, id, name.trim()) : removePasskey(account.id, id);
+      if (!changed) return json({ error: 'This passkey no longer exists. Refresh your list.' }, 404);
+    }
+    return json({ passkeys: listPasskeys(account.id), userId: account.id, rpId: relyingParty(request).rpId });
+  } catch {
+    return json({ error: 'Unable to update your passkeys. Please try again.' }, 500);
+  }
+};
