+++ b/src/lib/server/account-http.ts
@@ -0,0 +1,18 @@
+import type { APIContext } from 'astro';
+
+export const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+
+export function sameOrigin(request: Request) {
+  return request.headers.get('Origin') === new URL(request.url).origin;
+}
+
+export async function signedIn(context: APIContext) {
+  return await context.session?.get('account') as { id: string; username: string } | undefined;
+}
+
+export function relyingParty(request: Request) {
+  const origin = process.env.WEBAUTHN_ORIGIN || new URL(request.url).origin;
+  return { origin, rpId: new URL(origin).hostname };
+}
diff --git a/src/lib/server/accounts.ts b/src/lib/server/accounts.ts
new file mode 100644
index 0000000..5f25ce4
--- /dev/null
+++ b/src/lib/server/accounts.ts
@@ -0,0 +1,55 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+// Keep this file on a persistent volume in production. SQLite coordinates writes
+// across processes; credentials never live in a reader's cookie or localStorage.
+let connection: DatabaseSync;
+function database() {
+  if (!connection) {
+    const path = resolve(process.env.ACCOUNT_DATABASE_PATH || 'data/accounts.sqlite');
+    mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
+    connection = new DatabaseSync(path);
+    connection.exec(`PRAGMA journal_mode=WAL; PRAGMA busy_timeout=5000;
+      CREATE TABLE IF NOT EXISTS accounts (id TEXT PRIMARY KEY, username TEXT UNIQUE NOT NULL);
+      CREATE TABLE IF NOT EXISTS passkeys (
+        id TEXT PRIMARY KEY, account_id TEXT NOT NULL, name TEXT NOT NULL,
+        public_key TEXT NOT NULL, counter INTEGER NOT NULL, aaguid TEXT NOT NULL,
+        transports TEXT NOT NULL, backed_up INTEGER NOT NULL,
+        registered_at INTEGER NOT NULL, last_used_at INTEGER
+      );`);
+  }
+  return connection;
+}
+
+export function accountForVerifiedUsername(username: string) {
+  const db = database();
+  db.prepare('INSERT OR IGNORE INTO accounts (id, username) VALUES (?, ?)')
+    .run(randomBytes(32).toString('base64url'), username);
+  return db.prepare('SELECT id, username FROM accounts WHERE username = ?').get(username) as { id: string; username: string };
+}
+
+export function listPasskeys(accountId: string) {
+  return database().prepare(`SELECT id, name, aaguid, backed_up AS backedUp,
+    registered_at AS registeredAt, last_used_at AS lastUsedAt
+    FROM passkeys WHERE account_id = ? ORDER BY registered_at DESC`).all(accountId);
+}
+
+export function renamePasskey(accountId: string, id: string, name: string) {
+  return database().prepare('UPDATE passkeys SET name = ? WHERE account_id = ? AND id = ?').run(name, accountId, id).changes > 0;
+}
+
+export function removePasskey(accountId: string, id: string) {
+  return database().prepare('DELETE FROM passkeys WHERE account_id = ? AND id = ?').run(accountId, id).changes > 0;
+}
+
+export function savePasskey(accountId: string, credential: {
+  id: string; publicKey: Uint8Array; counter: number; transports?: string[];
+}, aaguid: string, backedUp: boolean) {
+  database().prepare(`INSERT INTO passkeys
+    (id, account_id, name, public_key, counter, aaguid, transports, backed_up, registered_at)
+    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`).run(credential.id, accountId, 'My passkey',
+      Buffer.from(credential.publicKey).toString('base64url'), credential.counter,
+      aaguid, JSON.stringify(credential.transports || []), Number(backedUp), Date.now());
+}
