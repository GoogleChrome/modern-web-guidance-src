+++ b/src/pages/api/account/register-passkey.ts
@@ -0,0 +1,38 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions, verifyRegistrationResponse } from '@simplewebauthn/server';
+import { listPasskeys, savePasskey } from '../../../lib/server/accounts';
+import { json, sameOrigin, signedIn, relyingParty } from '../../../lib/server/account-http';
+
+export const POST: APIRoute = async (context) => {
+  const account = await signedIn(context);
+  if (!account) return json({ error: 'Please sign in to create a passkey.' }, 401);
+  if (!sameOrigin(context.request)) return json({ error: 'Invalid request origin.' }, 403);
+  const { origin, rpId } = relyingParty(context.request);
+  try {
+    const { credential } = await context.request.json();
+    if (!credential) {
+      const options = await generateRegistrationOptions({
+        rpName: 'The DevTools Times', rpID: rpId,
+        userName: account.username, userID: new Uint8Array(Buffer.from(account.id, 'base64url')),
+        excludeCredentials: listPasskeys(account.id).map(key => ({ id: String(key.id) })),
+        authenticatorSelection: { residentKey: 'required', userVerification: 'required' },
+        attestationType: 'none',
+      });
+      await context.session!.set('passkeyChallenge', { value: options.challenge, expires: Date.now() + 300000 });
+      return json(options);
+    }
+    const challenge = await context.session!.get('passkeyChallenge') as { value: string; expires: number } | undefined;
+    await context.session!.delete('passkeyChallenge');
+    if (!challenge || challenge.expires < Date.now()) return json({ error: 'The request expired. Please start again.' }, 400);
+    const result = await verifyRegistrationResponse({
+      response: credential, expectedChallenge: challenge.value,
+      expectedOrigin: origin, expectedRPID: rpId, requireUserVerification: true,
+    });
