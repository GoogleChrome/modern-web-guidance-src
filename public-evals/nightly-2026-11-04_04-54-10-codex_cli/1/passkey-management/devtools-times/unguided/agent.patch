+}
+.passkey-dialog::backdrop {
+  background: #202c2559;
+  backdrop-filter: blur(3px);
+}
+.passkey-dialog form {
+  padding: 32px;
+  position: relative;
+}
+.dialog-close {
+  position: absolute;
+  right: 16px;
+  top: 16px;
+  border: 0;
+  background: none;
+  color: #8d9282;
+  padding: 4px;
